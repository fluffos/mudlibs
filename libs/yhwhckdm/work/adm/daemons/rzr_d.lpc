int rzr_id = 0;
int max_npcs = 10;

void debug_msg(string msg) {
  CHANNEL_D->do_channel(this_object(), "rzr", msg);
}

void announce_msg(string msg) {
  CHANNEL_D->do_channel(this_object(), "rzr", msg);
}

string generate_name() {
  return surname[random(sizeof(surname))] + firstname[random(sizeof(firstname))];
}

varargs int random_place(object ob) {
  int j;

  if (!ob) {
    return 0;
  }

  for (j = 0; j < 3 && ob; j++) {
    if (NPC_D->place_npc(ob)) {
      break;
    }
  }

  if (3 <= j) {
    return 0;
  }

  if (!ob) {
    return 0;
  }

  ob->set_temp("last_random_place", time());

  return 1;
}

int get_max_npcs() {
  return max_npcs;
}

int set_max_npcs(int count) {
  max_npcs = count;
  return 1;
}

int get_next_rzr_id() {
  int i;

  for (i = 0; i < max_npcs * 2; i++, rzr_id++) {
    if (max_npcs * 2 < rzr_id) {
      rzr_id = 1;
    }

    if (!find_living("rzr" + rzr_id)) {
      break;
    }
  }

  //CHANNEL_D->do_channel(this_object(), "rzr", "rzr " + rzr_id );
  rzr_id++;

  return rzr_id - 1;
}

void init_rzr() {
  if (!objectp(find_object(MANMADE_NPC)) &&
    catch(load_object(MANMADE_NPC))) {
    return;
  }
}

void start_general_rzr(int interval) {
  remove_call_out("generate_npc");
  call_out("generate_npc", interval, this_object());
}

void start_continue_load(int interval, mixed *rzr_files, int index, int max_id, int count) {
  remove_call_out("continue_load_rzr");
  call_out("continue_load_rzr", interval, rzr_files, index, max_id, count);
}

void continue_load_rzr(mixed *rzr_files, int index, int max_id, int count) {
  int temp = 0;
  object rzr;

  if (!rzr_files || 0 == sizeof(rzr_files)) {
    start_general_rzr(5);
    return;
  }

  if (count >= max_npcs) {
    for (temp = count; temp < sizeof(rzr_files); temp++) {
#ifdef DB_SAVE
      if (DATABASE_D->db_query_rzr(rzr_files[temp][RZR_DB_INDEX], "name")) {
        DATABASE_D->db_remove_rzr(rzr_files[temp][RZR_DB_INDEX]);
      }
#else
      if (file_exists(DATA_DIR "rzr/" + rzr_files[temp])) {
        rm(DATA_DIR "rzr/" + rzr_files[temp]);
      }
#endif
    }
  }

  if (index >= sizeof(rzr_files) || count >= max_npcs) {
    start_general_rzr(5);
    return;
  }

  // must use the one defined for this class, can not use local variable
#ifdef DB_SAVE
  if (0 == (temp = rzr_files[index][RZR_DB_INDEX]))
#else
    if (sscanf(rzr_files[index], "rzr%d.o", temp) != 1)
#endif
      {
        start_continue_load(3, rzr_files, index + 1, max_id, count);
        return;
      }

  // check if the rzr is already in system
  if (find_living("rzr" + temp)) {
    start_continue_load(3, rzr_files, index + 1, max_id, count);
    return;  // don't load rzr if it is already in the system
  }

  rzr = new(MANMADE_NPC);  // this call will increase rzr_id by 1

  if (!rzr) {
    start_continue_load(3, rzr_files, index + 1, max_id, count);
    return;
  }

  rzr->set("id", "rzr" + temp);
  rzr->set("rzr_id", temp);
  rzr->set("db_id", temp);
  rzr->restore();
  rzr->set("id", "rzr" + temp);
  rzr->set_name(rzr->query("name"), ({ rzr->query("id"), "rzr" }));
  rzr->set_living_name(rzr->query("id"));
  rzr->setup();

  if (!random_place(rzr)) {
    if (rzr) {
      rzr->disappear();
    }

    //分配地址失败，则继续重建该rzr
    start_continue_load(3, rzr_files, index, max_id, count);
    return;
  }

  //分配地址失败，则继续重建该rzr
  if (!rzr) {
    start_continue_load(3, rzr_files, index, max_id, count);
    return;
  }

  tell_room(environment(rzr), rzr->query("name") + "(" + rzr->query("id")
    + ") 忽然出现在一阵烟雾中。\n");
  announce_msg(rzr->query("name") + "(" + rzr->query("id")
    + ") 重生在[" + environment(rzr)->query("short") + "]");

  rzr->save();

  count++;
  if (temp > max_id) {
    max_id = temp;
  }

  rzr_id = max_id + 1;
  start_continue_load(3, rzr_files, index + 1, max_id, count);
}

void kill_all_npcs() {
  object *rzrs;
  object rzr;
  int i, count;
  object env;

  announce_msg("因为人造人作恶多端, 大天地决定将系统中的所有人造人即时彻底处死");

  rzrs = children(MANMADE_NPC);
  if (rzrs && arrayp(rzrs)) {
    count = sizeof(rzrs);
  } else {
    count = 0;
  }

  for (i = 0; i < count; i++) {
    rzr = rzrs[i];
    if (!rzr) {
      continue;
    }

    env = environment(rzr);
    if (env) {
      tell_room(env, "只见天上一道闪电不偏不倚地击中 " + rzr->query("name") + "(" + rzr->query("id")
        + ") ，将之化为一堆灰烬。\n");
    }

    rzr->die();
  }

  rzr_id = 0;
}

void destroy_all_npcs() {
  object *rzrs;
  object rzr;
  int i, count;
  object env;

  remove_call_out("generate_npc");

  announce_msg("因为人造人作恶多端, 大天地决定将系统中的所有人造人即时处死");

  rzrs = children(MANMADE_NPC);
  if (rzrs && arrayp(rzrs)) {
    count = sizeof(rzrs);
  } else {
    count = 0;
  }

  for (i = 0; i < count; i++) {
    rzr = rzrs[i];
    if (!rzr) {
      continue;
    }

    env = environment(rzr);
    if (env) {
      tell_room(env, "只见天上一道闪电不偏不倚地击中 " + rzr->query("name") + "(" + rzr->query("id")
        + ") ，将之化为一堆灰烬。\n");
    }

    rzr->disappear();
  }

  rzr_id = 0;

  remove_call_out("load_rzrs");
  call_out("load_rzrs", 5);

  remove_call_out("shuffle_rzrs");
  call_out("shuffle_rzrs", 60);
}

void load_rzrs() {
#ifdef DB_SAVE
  mixed *rzr_files = DATABASE_D->db_query_all_rzr();
#else
  string *rzr_files = get_dir(DATA_DIR "rzr/*.o");
#endif

  if (!rzr_files || 0 == sizeof(rzr_files)) {
    start_general_rzr(5);
    return;
  }

  start_continue_load(3, rzr_files, 0, 0, 0);
}

int generate_npc(object ob) {
  int i, count, real_count, temp = 0;
  object *rzrs;
#ifdef DB_SAVE
  mixed *rzr_files;
#else
  string *rzr_files;
#endif

  rzrs = children(MANMADE_NPC);

  if (rzrs && arrayp(rzrs)) {
    count = sizeof(rzrs);
    real_count = 0;
  } else {
    count = 0;
    real_count = 0;
  }

  for (i = 0; i < count; i++) {
    if (rzrs[i] && environment(rzrs[i])) {
      real_count++;
      rzrs[i]->enable_heart_beat();
    }
  }

#ifdef DB_SAVE
  rzr_files = DATABASE_D->db_query_all_rzr();
#else
  rzr_files = get_dir(DATA_DIR "rzr/*.o");
#endif

  if (real_count < max_npcs) {
    object rzr;

    if (rzr_files && arrayp(rzr_files)) {
      count = sizeof(rzr_files);
    } else {
      count = 0;
    }

    for (i = 0; i < count; i++) {
#ifdef DB_SAVE
      temp = rzr_files[i][RZR_DB_INDEX];
      if (!find_living("rzr" + temp) && DATABASE_D->db_query_rzr(temp, "name"))
#else
        if (1 == sscanf(rzr_files[i], "rzr%d.o", temp)
          && !find_living("rzr" + temp) && file_exists(DATA_DIR "rzr/" + rzr_files[i]))
#endif
          {
            rzr = new(MANMADE_NPC);  // this call will increase rzr_id by 1
            if (rzr) {
              rzr->set("id", "rzr" + temp);
              rzr->set("rzr_id", temp);
              rzr->set("db_id", temp);
              rzr->restore();
              rzr->set("id", "rzr" + temp);
              rzr->set_name(rzr->query("name"), ({ rzr->query("id"), "rzr" }));
              rzr->set_living_name(rzr->query("id"));
              rzr->setup();
              break;
            }
          }
    }

    if (!rzr) {
      temp = 0;
      rzr = new(MANMADE_NPC);
      if (rzr) {
        rzr->set("id", "rzr" + rzr->query("rzr_id"));
        rzr->set("db_id", rzr->query("rzr_id"));
        rzr->set_name(rzr->query("name"), ({ rzr->query("id"), "rzr" }));
        rzr->set_living_name(rzr->query("id"));
        rzr->setup();
      }
    }

    if (rzr) {
      if (!random_place(rzr)) {
        if (rzr) {
          rzr->disappear();
        }
      } else {
        if (rzr) {
          tell_room(environment(rzr), rzr->query("name") + "(" + rzr->query("id")
            + ") 忽然出现在一阵烟雾中。\n");
          announce_msg(rzr->query("name") + "(" + rzr->query("id")
            + ") " + (temp ? "重生" : "降生") + "在[" + environment(rzr)->query("short") + "]");

          rzr->save();
        }
      }
    }
  }

  if (rzr_files && arrayp(rzr_files) && 0 < sizeof(rzr_files)) {
    count = random(sizeof(rzr_files));

#ifdef DB_SAVE
    i = rzr_files[count][RZR_DB_INDEX];
    if (!find_living("rzr" + i) && DATABASE_D->db_query_rzr(i, "name")) {
      DATABASE_D->db_remove_rzr(i);
    }
#else
    if (sscanf(rzr_files[count], "rzr%d.o", i) == 1) {
      if (!find_living("rzr" + i) && file_exists(DATA_DIR "rzr/" + rzr_files[count])) {
        rm(DATA_DIR "rzr/" + rzr_files[count]);
      }
    }
#endif
  }

  start_general_rzr(5);

  return 1;
}

void shuffle_rzrs() {
  int i, count, index;
  object *rzrs;

  rzrs = children(MANMADE_NPC);
  if (rzrs && arrayp(rzrs)) {
    count = sizeof(rzrs);
  } else {
    count = 0;
  }

  for (i = 0; i < count && i < 10; i++) {
    index = random(count);

    if (!rzrs[index] || "rzr0" == rzrs[index]->query("id")) {
      continue;
    }

    if (random_place(rzrs[index]) && rzrs[index]) {
      tell_room(environment(rzrs[index]), rzrs[index]->query("name") + "(" + rzrs[index]->query("id")
        + ") 忽然出现在一阵烟雾中。\n");
      announce_msg(rzrs[index]->query("name") + "(" + rzrs[index]->query("id")
        + ") 活动到[" + environment(rzrs[index])->query("short") + "]");
    }
  }

  remove_call_out("shuffle_rzrs");
  call_out("shuffle_rzrs", 900, this_object());
}

int get_all_npcs() {
  object *rzrs;

  rzrs = children(MANMADE_NPC);
  return sizeof(rzrs);
}

void create() {
  seteuid(ROOT_UID);

  set("channel_id", "人造人系统精灵");

  set_max_npcs(30);

  CHANNEL_D->do_channel(this_object(), "rzr", "人造人系统已经启动。");

  //destruct(new(MANMADE_NPC));
  destroy_all_npcs();
}

void remove(string id) {
  destroy_all_npcs();
}

void remove_rzr(object who) {
#ifndef DB_SAVE
  string my_file;
#endif

  if (!who) {
    return;
  }

#ifdef DB_SAVE
  if (DATABASE_D->db_query_rzr(who->query("db_id"), "name")) {
    DATABASE_D->db_remove_rzr(who->query("db_id"));
  }
#else
  my_file = who->query_save_file() + __SAVE_EXTENSION__;
  if (file_exists(my_file)) {
    rm(my_file);
  }
#endif
}
