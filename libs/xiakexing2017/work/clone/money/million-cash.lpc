// million.c

inherit MONEY;

void create() {
  set_name("一百两金票", ({ "million-cash", "million-cash_money", "cash" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "million-cash");
    set("long", "一张面额值一百两黄金的金票。\n");
    set("unit", "叠");
    set("base_value", 100000000);
    set("base_unit", "张");
    set("base_weight", 3);
  }
  set_amount(1);
}
