// xianglong 降龙大法
// by king 97.05

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me,int amount);

int perform(object me)
{
	int skill,count;
  
  if (userp(me) && (me->query("family/family_name") != "丐帮"))
	  	return notify_fail("你不是丐帮弟子，无法施展「降龙大法」。\n");
	if( (int)me->query_temp("xianglong") ) 
		return notify_fail("你已经在运功中了。\n");
	if( !me->is_fighting() )
		return notify_fail("降龙大法只能在战斗中使用。\n");
	if( (int)me->query("neili") < 300  ) 
		return notify_fail("你的内力不够。\n");

	skill = (int)me->query_skill("xianglong-zhang",1);
count=skill/30;
if(count>50) count=50;
	me->add("neili", -100);

	message_vision( HIR "$N深吸一口气，运起降龙大法，结果越战越勇！\n" NOR, me);

	me->set_temp("xianglong", 1);
	me->add_temp("str", count);
	me->start_call_out( (: call_other,  __FILE__, "remove_effect", me,count :), skill/2);

	return 1;
}

void remove_effect(object me,int amount)
{
	if ( (int)me->query_temp("xianglong") ) {
	me->add_temp("str", - amount );
	me->delete_temp("xianglong");
	tell_object(me, CYN"你的降龙大法运行完毕，将内力收回丹田。\n"NOR);}
}
