#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int count;

  if (userp(me) && !wizardp(me) && (me->query("family/family_name") != "侠客岛"))
    return notify_fail("你不是侠客岛弟子，无法领会「十步杀一人」。\n");

  if (!me->is_fighting())
    return notify_fail("「十步杀一人」只能在战斗中使用。\n");
  me->clean_up_enemy();
  ob = me->select_opponent();
  if (environment(me) != environment(ob))
    return notify_fail("「十步杀一人」只能在战斗中使用。\n");

  weapon = me->query_temp("weapon");
  if (!objectp(weapon) || weapon->query("skill_type") != "sword")
    return notify_fail("你手中无剑，如何使得太玄剑法绝技？\n");

  if ((int)me->query_dex() < 30)
    return notify_fail("你的身法不够, 目前还不能使用这项绝技! \n");

  if ((int)me->query_skill("taixuan-gong", 1) < 100)
    return notify_fail("你的太玄功修为不够, 不能使用「十步杀一人」绝技 !\n");

  if ((int)me->query_skill("taixuan-jianfa", 1) < 100)
    return notify_fail("你的太玄剑法修为不够, 不能使用这一绝技 !\n");

  if ((int)me->query_skill("dodge") < 100)
    return notify_fail("你的轻功修为不够, 不能使用「十步杀一人」！\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的真气不够！\n");

  message_vision(HIR "\n$N大吼一声「" + HIW "十步杀一人，千里不留行" HIR + "」，向$n展开旋风般的攻击！\n" NOR, me, ob);

  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  me->add("neili", -300);
  me->start_busy(2);

  return 1;
}
