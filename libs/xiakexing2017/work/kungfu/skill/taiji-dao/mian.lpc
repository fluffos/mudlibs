// mian.c 太极刀法「绵」字诀

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  string msg;
  int i, attack_time;
  if ((string)me->query("family/family_name") != "明教" && (string)me->query("family/family_name") != "武当派")
    return notify_fail("你不是明教或武当弟子，无法施展太极刀法「绵」字诀。\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「绵」字诀只能对战斗中的对手使用。\n");
  if (environment(me) != environment(target))
    return notify_fail("「绵」字诀只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query_skill(
    "jiuyang-shengong",
    1
  ) < 40 && (int)me->query_skill("taiji-shengong", 1) < 40)
    return notify_fail("你的内功修为不够，使用不了「绵」字诀。\n");
  if ((int)me->query_skill("taiji-dao", 1) < 40)
    return notify_fail("你的太极刀法不够娴熟，不会使用「绵」字诀。\n");
  if ((int)me->query("neili") < 100)
    return notify_fail("你的真气不足！\n");

  msg = HIY "$N使出太极刀法「绵」字诀，招式陡然变快。\n" NOR;
  message_vision(msg, me, target);
  if (random(me->query("combat_exp")) * 100 > (int)target->query("combat_exp") / 20000) {
    attack_time = random((int)me->query_skill("taiji-dao", 1) / 25);
    if (attack_time < 1)
      attack_time = 1;
    if (attack_time > 13) attack_time = 13;

    msg = MAG " 结果$p被$P攻了个措手不及！\n" NOR;
    for (i = 0; i < attack_time + 2; i++)
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
    message_vision(msg, me, target);
    me->start_busy(1 + random(2));
    me->add("neili", -100);
  } else {
    msg = "可是$p看破了$P的企图，并没有上当。\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(2);
  }

  return 1;
}
