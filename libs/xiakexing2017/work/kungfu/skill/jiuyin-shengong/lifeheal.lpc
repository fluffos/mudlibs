// lifeheal.c

#include <ansi.h>

int exert(object me, object target) {
  // if ( !wizardp(me))
  //	return notify_fail("你无权进行气的治疗！\n");

  if (!target)
    return notify_fail("你要用真气为谁疗伤？\n");

  if (me->is_fighting() || target->is_fighting())
    return notify_fail("战斗中无法运功疗伤！\n");

  if ((int)me->query("max_neili") < 300)
    return notify_fail("你的内力修为不够。\n");

  if ((int)me->query("neili") < 150)
    return notify_fail("你的真气不够。\n");

  message_vision(
    "$N" + HIM "坐了下来运起内功，将手掌贴在" NOR + "$n" + HIM "背心，缓缓地将真气输入" NOR + "$n" + HIM "体内....\n\n"
    "过了不久，" NOR + "$N" + HIM "额头上冒出豆大的汗珠，" NOR + "$n" + HIM "吐出一口瘀血，脸色看起来红润多了。\n" NOR,
    me, target);

  target->receive_curing("qi", 30 + (int)me->query_skill("force") / 3);
  target->add("qi", 30 + (int)me->query_skill("force") / 3);
  if ((int)target->query("qi") > (int)target->query("eff_qi"))
    target->set("qi", (int)target->query("eff_qi"));

  me->add("neili", -10);
  me->set("jiali", 0);

  return 1;
}
