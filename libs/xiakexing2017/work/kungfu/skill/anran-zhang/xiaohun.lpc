// anran.c 黯然神伤
// Last Modified by winder on Mar. 10 2000

#include <ansi.h>
inherit F_SSERVER;
#define PNAME "「"+BBLU"黯然神伤"NOR +"」"

int perform(object me, object target) {
  int damage, amount;
  string msg;
  int flag;
  string fskill, sskill, bskill, pfname;

  sskill = explode(__FILE__, "/")[<2];
  pfname = explode(__FILE__, "/")[<1][0..<3];

  if ((me->query("family/family_name") != "古墓派"))
    return notify_fail("你不是古墓派弟子，无法领会「黯然神伤」。\n");
  if (!objectp(target)) { flag = 1; target = offensive_target(me); }

  if (!target || !target->is_character() || target == me ||
    !me->is_fighting(target) ||
    !living(target) || target->query_temp("noliving") || environment(me) != environment(target))
    return notify_fail(PNAME "只能对战斗中的对手使用。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用" PNAME "！\n");

  fskill = "nutao-shengong";
  bskill = "anran-zhang";
  //	fskill = me->query_skill_mapped("force");
  if (me->query_temp("murong/xingyi")) {
    sskill = "douzhuan-xingyi";
    fskill = "shenyuan-gong";
    bskill = "parry";
  }
  if ((int)me->query_skill(fskill, 1) < 150)
    return notify_fail("你的" + to_chinese(fskill) + "火候不够，使不出" + PNAME + "。\n");
  if ((int)me->query_skill(sskill, 1) < 150)
    return notify_fail("你的" + to_chinese(sskill) + "不够熟练，不会使用" + PNAME + "。\n");
  if ((int)me->query("neili") < 1500)
    return notify_fail("你的内力不够。\n");
  amount = (me->query_skill("anran-zhang", 1) + me->query_skill("nutao-shengong", 1)) / 10;
  msg = HIB "$N" HIB "紧闭双目，潸然泪下，神情恍惚，鹄立风中，蓦地往前直仆，掌风带起刺骨寒气，如急风骤雨般向$n" HIB "奔袭而至！ \n" NOR;
  message_vision(msg, me, target);
  me->add_temp("apply/damage", amount);
  me->add_temp("apply/attack", amount * 2);
  me->add_temp("apply/dodge", amount * 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  me->add_temp("apply/damage", -amount);
  me->add_temp("apply/attack", -amount * 2);
  me->add_temp("apply/dodge", -amount * 2);
  damage = (int)me->query_skill(bskill, 1) * 4;
  damage = damage + random(damage) + random(me->query("jiali"));
  if (random((int)me->query_skill("anran-zhang", 1)) * 4 > (int)target->query_skill("dodge")) {
    me->start_busy(1 + random(2));
    target->start_busy(1);
    target->add("qi", -damage * 3);
    target->add("eff_qi", -damage * 2);
    if (target->query("eff_qi") < 0)
      target->set("eff_qi", 0);
    me->add("neili", -100);
    msg = RED "$n" RED "无处可躲，被$N" RED "一掌击在胸口上，一口鲜血狂喷而出！\n" NOR;
  } else {
    me->start_busy(2);
    msg = HIG "$n" HIG "大骇之下，急退数丈，才从掌风中逃身而出，只觉脸上被掌风刮得生疼。\n" NOR;
    me->add("neili", -100);
  }
  message_vision(msg, me, target);
  return 1;
}
string name() { return replace_string(replace_string(PNAME, "「", ""), "」", ""); }

int help(object me) {
  write(WHT "\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + WHT "：" NOR "\n");
  write(@HELP

	使用功效：
		损伤对方气血
		迟滞对方出手

	出手要求：
		玉女心法150级
		黯然销魂掌150级
		内力1500
HELP
  );
  return 1;
}
