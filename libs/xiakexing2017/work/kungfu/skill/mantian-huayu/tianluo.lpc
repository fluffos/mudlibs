// tianluo.c 天罗地网

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int count;

  if ((me->query("family/family_name") != "古墓派"))
    return notify_fail("你不是古墓派弟子，无法施展「天罗地网」。\n");
  if (!me->is_fighting())
    return notify_fail("「天罗地网」只能在战斗中使用。\n");
  me->clean_up_enemy();
  ob = me->select_opponent();
  if (environment(me) != environment(ob))
    return notify_fail("「天罗地网」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "throwing")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_dex() < 30)
    return notify_fail("你的身法不够, 目前还不能使用这项绝技! \n");

  if ((int)me->query_skill("yunv-xinfa", 1) < 100)
    return notify_fail("你的玉女心经的修为不够, 不能使用这一绝技 !\n");

  if ((int)me->query_skill("throwing") < 100)
    return notify_fail("你的暗器使用修为不够， 还使用不了「天罗地网」! \n");

  if ((int)me->query("neili") < 300)
    return notify_fail("你的真气不够！\n");


  msg = HIG "$N使出漫天花雨的绝技「天罗地网」，暗器遮天蔽地般射出！\n" NOR;
  message_vision(msg, me);

  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  me->add("neili", -100);
  me->start_busy(1 + random(2));

  return 1;
}
