// bafang.c  打狗棒法 [横扫八方]

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
	object weapon, ob;
    string msg, string1;
    int count;
 
  if ( (me->query("family/family_name") != "丐帮"))
	  	return notify_fail("你不是丐帮弟子，无法施展「横扫八方」。\n");
  if( !me->is_fighting() )
	    return notify_fail("「横扫八方」只能在战斗中使用。\n");
me->clean_up_enemy();
	ob = me->select_opponent();
if(environment(me)!=environment(ob))
return notify_fail("「横扫八方」只能在战斗中使用。\n");
	if (!objectp(weapon = me->query_temp("weapon"))
		|| (string)weapon->query("skill_type") != "club")
			return notify_fail("你使用的武器不对。\n");

	if((int)me->query_dex() < 30)
		return notify_fail("你的身法不够, 目前还不能使用这项绝技! \n");

	if((int)me->query_skill("huntian-qigong",1) < 100)
		return notify_fail("你的混天气功的修为不够, 不能使用这一绝技 !\n");
	
	if((int)me->query_skill("dagou-bangfa",1) < 120)
		return notify_fail("你的打狗棒法修为不够， 使用不了「横扫八方」! \n");

	if((int)me->query_skill("dodge") < 120)
		return notify_fail("你的轻功修为不够, 不能使用「横扫八方」！\n");
 
	if((int)me->query_skill("club") < 120)
		return notify_fail("你的棍法修为不够， 目前不能使用「横扫八方」! \n");

    if( (int)me->query("neili") < 500 )
		return notify_fail("你的真气不够！\n");


    msg = YEL "$N使出打狗棒法的绝技「横扫八方」，顿时四面八方都处在$N的棍影笼罩之下！\n" NOR;
    message_vision(msg, me);

	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

	me->add("neili", -100);
	me->start_busy(1);

    return 1;
}