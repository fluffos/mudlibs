// wbdy.c  修罗刀法 [无边地狱]

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
	object weapon, ob;
    string msg, string1;
    int count;
 
  if ( (me->query("family/family_name") != "少林派"))
	  	return notify_fail("你不是少林派弟子，无法施展「无边地狱」。\n");
  if( !me->is_fighting() )
	    return notify_fail("「无边地狱」只能在战斗中使用。\n");
me->clean_up_enemy();
	ob = me->select_opponent();
	if(environment(me)!=environment(ob))
	return notify_fail("「无边地狱」只能在战斗中使用。\n");	
	if (!objectp(weapon = me->query_temp("weapon"))
		|| (string)weapon->query("skill_type") != "blade")
			return notify_fail("你使用的武器不对。\n");

	if((int)me->query_dex() < 30)
		return notify_fail("你的身法不够, 目前还不能使用这项绝技! \n");

	if((int)me->query_skill("hunyuan-yiqi",1) < 100)
		return notify_fail("你的混元一气功的修为不够, 不能使用这一绝技 !\n");

	if((int)me->query_skill("dodge") < 135)
		return notify_fail("你的轻功修为不够, 不能使用无边地狱！\n");
 
	if((int)me->query_skill("blade") < 135)
		return notify_fail("你的基本刀法修为不够， 目前不能使用「无边地狱」! \n");

    if( (int)me->query("neili") < 500 )
		return notify_fail("你的真气不够！\n");


    msg = HIG "$N使出修罗刀法的绝技「无边地狱」，身法陡然加快！\n" NOR;
    message_vision(msg, me);

	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

	me->add("neili", -100);
	me->start_busy(1+random(2));

    return 1;
}
