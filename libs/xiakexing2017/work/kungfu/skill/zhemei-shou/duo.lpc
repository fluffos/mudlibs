// duo.c 空手入白刃

#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  string msg;
  object weapon, weapon2, target;
  int fskill, skill, dp, damage;

  me->clean_up_enemy();
  target = me->select_opponent();

  if ((me->query("family/family_name") != "灵鹫宫"))
    return notify_fail("你不是灵鹫宫弟子，无法施展「空手入白刃」的秘技。\n");
  if ((int)me->query_temp("duo"))
    return notify_fail("你已经在夺敌人的兵刃了。\n");
  fskill = me->query_skill("bahuang-gong", 1);
  skill = me->query_skill("zhemei-shou", 1);

  if (!(me->is_fighting()))
    return notify_fail("空手入白刃只能对战斗中的对手使用。\n");
  if (environment(me) != environment(target))
    return notify_fail("空手入白刃只能对战斗中的对手使用。\n");
  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("你必须空手。\n");

  if (!objectp(weapon2 = target->query_temp("weapon")))
    return notify_fail("对方没有兵刃，你不用担心。\n");
  if (fskill < 100)
    return notify_fail("你的八荒六合功修为不够。\n");
  if (skill < 100)
    return notify_fail("你的天山折梅手等级不够, 不能空手入白刃！\n");

  if (me->query("neili") < 50)
    return notify_fail("你的内力不够，无法空手入白刃！\n");

  msg = CYN "$N凝神闭息，打算施展空手入白刃的绝技. \n";
  message_vision(msg, me);

  dp = target->query("combat_exp") / 7000;
  if (dp < 1)
    dp = 1;
  if (random(skill * 5) > dp) {
    if (userp(me))
      me->add("neili", -10);
    msg = "$N使出空手入白刃的绝招, $n顿时觉得眼前一花，手腕一麻，手中兵刃脱手而出！\n" NOR;
    //	target->start_busy(2);
    weapon2->move(me);
    me->start_busy(1 + random(2));
  } else {
    msg = "可是$n看破了$N的企图，立刻采取守势，使$N没能夺下兵刃。\n" NOR;
    me->start_busy(2);
  }
  message_vision(msg, me, target);

  return 1;
}
