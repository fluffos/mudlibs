// taixuan-zhang.c 太玄掌

#include <ansi.h>
inherit SKILL;
string type() { return "martial"; }
string martialtype() { return "skill"; }

mapping *action = ({
  ([ "skill_name": "闲过信陵饮",
    "action": "$N一招「闲过信陵饮」，双手一举，一股劲气澎湃汹涌而去，逼得$n踉踉后退",
    "lvl": 0
  ]),
  ([ "skill_name": "五岳倒为轻",
    "action": "$N一式「五岳倒为轻」，右手伸出，在$n臂膀上迅速无比的一按，$n一跤跌了出去",
    "lvl": 11
  ]),
  ([ "skill_name": "纵死侠骨香",
    "action": "$N猱身而上，使出「纵死侠骨香」，双掌猛地拍向$n",
    "lvl": 22
  ]),
  ([ "skill_name": "飒沓如流星",
    "action": "$N一招「飒沓如流星」，猛地击向$n的下巴",
    "lvl": 33
  ]),
  ([ "skill_name": "千秋二壮士",
    "action": "$N右手一招「千秋二壮士」，直捣$n的$l",
    "lvl": 44
  ]),
  ([ "skill_name": "将炙啖朱亥",
    "action": "$N一招「将炙啖朱亥」，轰向$n的$l",
    "lvl": 55
  ]),
  ([ "skill_name": "持觞劝侯嬴",
    "action": "$N一式「持觞劝侯嬴」，掌势如虹，绕着$n漂移不定",
    "lvl": 66
  ]),
  ([ "skill_name": "意气素霓生",
    "action": "$N一招「意气素霓生」，铺天盖地袭向$n全身各处大穴",
    "lvl": 77
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练太玄掌必须空手。\n");
  if ((int)me->query_skill("taixuan-gong", 1) < 10)
    return notify_fail("你的太玄功火候不够，不能练太玄掌。\n");
  if ((int)me->query("max_neili") < 30)
    return notify_fail("你的内力太弱，无法练太玄掌。\n");
  return 1;
}
int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("你必须空手才能练习。\n");
  if ((int)me->query("qi") < 45)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够练太玄掌。\n");
  me->receive_damage("qi", 40);
  me->add("neili", -25);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}
mapping query_action(object me, object weapon) {
  /* d_e=dodge_effect p_e=parry_effect f_e=force_effect m_e=damage_effect */
  int d_e1 = -40;
  int d_e2 = -15;
  int p_e1 = 5;
  int p_e2 = 30;
  int f_e1 = 180;
  int f_e2 = 290;
  int i, lvl, seq, ttl = sizeof(action);

  lvl = (int)me->query_skill("taixuan-zhang", 1);
  for (i = ttl; i > 0; i--)
    if (lvl > action[i - 1]["lvl"]) {
      seq = i; /* 获得招数序号上限 */ break;
    }
  seq = random(seq); /* 选择出手招数序号 */ return ([
    "action": action[seq]["action"],
    "dodge": d_e1 + (d_e2 - d_e1) * seq / ttl,
    "parry": p_e1 + (p_e2 - p_e1) * seq / ttl,
    "force": f_e1 + (f_e2 - f_e1) * seq / ttl,
    "damage_type": random(2) ? "内伤" : "瘀伤",
  ]);
}
int learn_bonus() { return 15; }
int practice_bonus() { return 15; }
int success() { return 10; }
int power_point(object me) { return 1.0; }

string perform_action_file(string action) {
  return __DIR__ "taixuan-zhang/" + action;
}
int help(object me) {
  write(HIC "\n太玄掌：" NOR "\n");
  write(@HELP

    太玄掌源自侠客岛洞壁。

HELP
  );
  return 1;
}
