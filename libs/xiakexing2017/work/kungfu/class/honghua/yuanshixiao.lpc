// yuanshixiao.c
#include <ansi.h>
inherit NPC;
string ask_me();
void do_kill(object ob);

void create() {
  set_name("袁士霄", ({ "yuan shixiao", "yuan", "shixiao" }));
  set("gender", "男性");
  set("title", HIR "红花会" + HIC "太上长老" NOR);
  set("nickname", HIG "天池怪侠" NOR);
  set("age", 50);
  set("long",
    "他是红花会总舵主陈家洛的授业恩师。\n"
  );
  set("attitude", "heroism");
  set("str", 26);
  set("int", 25);
  set("con", 28);
  set("dex", 26);
  set("shen", 150000);

  set("qi", 5000);
  set("max_qi", 5000);
  set("jing", 1200);
  set("max_jing", 1200);
  set("jingli", 1000);
  set("max_jingli", 1000);
  set("neili", 5000);
  set("max_neili", 5000);
  set("jiali", 100);
  set("combat_exp", 1800000);
  set("score", 50000);
  set("food", 500);
  set("water", 500);
  set_skill("force", 400);
  set_skill("honghua-shengong", 400);
  set_skill("dodge", 380);
  set_skill("shenxing-baibian", 380);
  set_skill("parry", 390);
  set_skill("cuff", 400);
  set_skill("baihua-cuoquan", 400);
  set_skill("blade", 380);
  set_skill("paoding-daofa", 380);
  map_skill("force", "honghua-shengong");
  map_skill("cuff", "baihua-cuoquan");
  map_skill("dodge", "shenxing-baibian");
  map_skill("parry", "paoding-daofa");
  map_skill("blade", "paoding-daofa");
  prepare_skill("cuff", "baihua-cuoquan");

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "blade.yangshen" :),
    (: exert_function, "recover" :),
  }));
  setup();
  create_family("红花会", 1, "长老");
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("/d/city/obj/cloth")->wear();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 0) {
    command("say 老夫不收江湖败类。");
    return;
  }
  if ((string)ob->query("family/family_name") != "红花会") {
    command("say 这位" + RANK_D->query_respect(ob) +
      "既非红花会弟子，恕老夫无法收你为徒。");
    return;
  }
  if ((int)ob->query_skill("honghua-shengong", 1) < 50) {
    command("say 入我红花会，修习内功是首要的。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "是否还应该多多钻研红花会的内功心法？");
    return;
  }
  command("say 好吧！老夫就收下你了。");
  command("recruit " + ob->query("id"));
}
