//zhangwuji.c

#include <ansi.h>

inherit F_MASTER;
inherit F_UNIQUE;
inherit NPC;

void greeting(object me, object ob);
void create() {
  seteuid(getuid());
  set_name("张无忌", ({ "zhang wuji", "zhang", "wuji" }));
  set("nickname", HIC "号令天下" NOR);
  set("long", "明教教主张无忌，统领天下十万教众，豪气干云，叱咤千秋，\n"
    + "「九阳神功」、「乾坤大挪移」独步天下，是江湖中不世出的\n"
    + "少年英雄。\n");
  set("title", HIY "武林至尊" NOR);
  set("gender", "男性");
  set("age", 20);
  set("shen_type", 1);
  set("attitude", "friendly");
  set("party/party_name", HIG "明教" NOR);
  set("party/rank", HIW "教主" NOR);
  set("level", 10);
  set("str", 50);
  set("int", 30);
  set("con", 50);
  set("dex", 30);
  set("food", 1000);
  set("water", 1000);
  set("qi", 800000);
  set("max_qi", 800000);
  set("jing", 800000);
  set("max_jing", 800000);
  set("jingli", 200000);
  set("max_jingli", 100000);
  set("neili", 720000);
  set("max_neili", 360000);
  set("jiali", 400);

  set("combat_exp", 50000000);
  set("score", 455000);

  set_skill("force", 600);
  set_skill("cuff", 500);
  set_skill("dodge", 450);
  set_skill("literate", 80);
  set_skill("parry", 500);
  set_skill("sword", 500);
  set_skill("blade", 500);
  set_skill("unarmed", 500);
  set_skill("taiji-quan", 500);
  set_skill("taiji-jian", 500);
  set_skill("jiuyang-shengong", 600);
  set_skill("taiji-dao", 500);
  set_skill("qishang-quan", 500);
  set_skill("qiankun-danuoyi", 500);
  map_skill("force", "jiuyang-shengong");
  map_skill("sword", "taiji-jian");
  map_skill("unarmed", "taiji-quan");
  map_skill("dodge", "qiankun-danuoyi");
  map_skill("cuff", "qishang-quan");
  map_skill("blade", "taiji-dao");
  map_skill("parry", "qiankun-danuoyi");
  prepare_skill("cuff", "qishang-quan");
  create_family("明教", 1, "教主");

  set("chat_chance", 10);
  set("chat_msg", ({
    "张无忌愤然说道：“大丈夫当以国为家, 捐躯沙场, 抗元大业未成, 同辈仍需努力!”\n",
    "张无忌叹道：“人生失一知己, 生亦何欢, 死亦何忧, 敏儿, 你在哪里?”\n",
    "张无忌道：“我教兄弟听了: 生于乱世, 当克己为公, 行侠仗义, 荡寇驱魔!”\n",
  }));

  set("inquiry", ([
    "明教": "明教不是魔教！\n",
    "金毛狮王": "狮王是在下的义父。\n",
    "谢逊": "你找在下义父有什么事么？\n",
  ]));
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "blade.mian" :),
    //		(: perform_action, "parry.nuoyi" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/d/mingjiao/obj/tulongdao")->wield();
  carry_object("/d/mingjiao/obj/shengyi")->wear();
  add_money("gold", 70);
}

void init() {
  object me, ob;
  me = this_object();
  ob = this_player();
  ::init();

  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, me, ob);
  }
}

void greeting(object me, object ob) {
  if (environment(ob) != environment(me)) return;
  if (ob->query("party") && ob->query("party")["party_name"] == HIG "明教" NOR) {
    message_vision(
      "$n对$N躬身行礼，说道：“" + ob->query("party")["rank"] + ob->query("name") + "，参见" + me->query("title") + "！”\n",
      me,
      ob
    );
  } else {
    message_vision(
      "$n对$N躬身行礼，说道：“" + ob->query("title") + ob->query("name") + "，参见" + me->query("title") + "！”\n",
      me,
      ob
    );
  }
  if (ob->query("family") && ob->query("family")["family_name"] == "明教")
    return;
  if ((int)ob->query("shen") < -50000) {
    message_vision("\n$N对著$n大喝一声：“邪魔歪道竟敢混入我明教光明顶，看招！”\n", me, ob);
    me->fight_ob(ob);
  } else if ((int)ob->query("shen") < -5000)
    command("say 魔从心起，于武学不利，其道必诛，劝君放下屠刀，立地成佛。");
  else if ((int)ob->query("shen") < 0)
    command("say 这位朋友，人行江湖，言行当正，切务走进邪魔歪道。");
  else if ((int)ob->query("shen") < 5000)
    command("say 光明正道任人走，劝君多加保重。");
  else if ((int)ob->query("shen") < 50000)
    command("say 大侠劫富济贫，无忌佩服。");
  else
    command("say 大侠为国为民，真乃侠之大者。");

  return;
}

void attempt_apprentice(object ob) {
  mapping party;
  if ((int)ob->query_int() < 28) {
    command("say 你的悟性太低了，不适合学习我的功夫。");
    return 0;
  }
  if ((string)ob->query("gender") != "男性") {
    command("say 你阳气不足，习我功夫恐将走火入魔。");
    return 0;
  }
  if ((int)ob->query("shen") < 0) {
    command("say 你应当多作些行侠仗义的事，以修身心。");
    return 0;
  }
  command("say 好，我就收下你这位好兄弟。");
  command("say 再接再厉！");
  command("recruit " + ob->query("id"));
  party = allocate_mapping(5);
  party["party_name"] = HIG "明教" NOR;
  party["rank"] = HIY "至尊门" NOR + "教众";
  party["level"] = 8;
  party["tasks"] = 0;
  party["enter_time"] = time();
  ob->set("party", party);
  ob->delete("shenlongjiao");
  ob->set("mjlevel", 8);
  return;
}

int accept_fight(object ob) {
  if (((int)ob->query("combat_exp") < 30000) && ((int)ob->query("shen") > 0)) {
    message_vision("武林中人最忌争强斗狠，你不是我的对手，回去吧。\n", ob);
    return 0;
  }
  message_vision("张无忌一拱手说道：这位" + RANK_D->query_respect(ob) +
    "，在下领教了。\n", ob);
  return 1;
}
