// renying.c

inherit NPC;
string inquiry_linghuchong();

void create() {

  set_name("任盈盈", ({ "ren yingying", "ren", "yingying" }));
  set("gender", "女性");
  set("age", 20);
  set("long", "她身材丰腴，体态优雅，虽看上去不好接近，但无论怎样都不失为一可人的妙人。\n");
  set("shen_type", 1);
  set("combat_exp", 500000);
  set("str", 16);
  set("dex", 27);
  set("con", 17);
  set("int", 18);
  set("attitude", "friendly");
  set("neili", 500);
  set("max_neili", 300);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("force", 100);
  set("chat_chance", 60);
  set("chat_msg", ({
    "不知令狐冲他怎样了,是否又和他的小师妹在一起......\n",
    "你若能帮我捎封信给他，就太谢谢你了.............\n",
    "也不知蓝凤凰见没见到他，可真急死我了.......\n",
  }));

  create_family("日月神教", 3, "弟子 圣姑");
  set("inquiry", ([
    "令狐冲": (: inquiry_linghuchong :),
  ]));
  set_temp("letter", 1);
  setup();
  carry_object("/d/heimuya/npc/obj/jin")->wear();
  carry_object("/d/heimuya/npc/obj/letter");
}

string inquiry_linghuchong() {
  object me = this_player();
  object obn;

  message_vision("去年上华山一去就再无音讯,他不会忘记我吧......\n"
    , me);
  if (query_temp("letter") == 0) {
    message_vision("任盈盈又说道：这位" + RANK_D->query_respect(me) + "，我已经派
       蓝凤凰去寻找了，也不知道怎么样了。\n", me);
    return "";
  }
  message_vision("任盈盈又说道：这位" + RANK_D->query_respect(me) + "，
我这里有封信, \n你要是找到冲哥，就把信交给他，他会明白的。\n", me);
  obn = new("/d/heimuya/npc/obj/letter");
  obn->move(me);
  set_temp("letter", 0);

  return ("这封信烦你交给令狐冲。\n");
}
int accept_object(object who, object ob) {
  if (!who || environment(who) != environment())
    return 0;
  if (!objectp(ob))
    return 0;
  if (!present(ob, who))
    return notify_fail("你没有这件东西。\n");

  if ((string)ob->query("name") != "白虎堂令牌")
    return notify_fail("任盈盈不需要这件东西。\n");
  say("任盈盈接过白虎堂令牌，勃然大怒!\n");
  destruct(ob);
  kill_ob(who);
  return 1;
}
