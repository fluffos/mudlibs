// daliwan.c 大力丸

inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("大力丸", ({ "dali wan", "wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long", "这是一包武林人士梦寐以求的大力丸。\n");
    set("value", 100000);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");
  if ((int)this_player()->query("max_neili") < 100)
    return notify_fail("依你现在的内力修为，吃下去恐怕会撑死你。\n");
  else if ((int)this_player()->query("neili") >= (int)this_player()->query("max_neili") * 5)
    return notify_fail("还吃？不怕撑死啊！\n");
  else {
    this_player()->add("neili", 500);
    this_player()->add("jingli", 500);
    message_vision("$N吃下一包大力丸，感觉全身充满了力量。\n", this_player());
    destruct(this_object());
    return 1;
  }
}
