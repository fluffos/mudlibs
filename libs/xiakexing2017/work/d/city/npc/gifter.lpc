#include <ansi.h>
inherit NPC;
int ask_me();
void create() {
  set_name("金小庸", ({ "jin xiaoyong", "jin", "xiaoyong" }));
  set("title", HIM "礼物使者" NOR);
  set("gender", "男性");
  set("long", "他专门负责给新玩家发送礼物。\n");
  set("age", 18);
  set("int", 30);
  set("qi", 200);
  set("max_qi", 200);
  set("jing", 200);
  set("max_jing", 200);
  set("shen_type", 1);
  set("combat_exp", 800);
  set("attitude", "friendly");

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_skill("parry", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  set_temp("apply/damage", 10);


  set("inquiry", ([
    "新手礼物": (: ask_me :),
  ]));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

int ask_me() {
  object ob;
  ob = this_player();

  if (ob->query("newgift")) {
    command("?" + ob->query("id"));
    command("say 你不是已经领过礼物了吗？\n");
    return 1;
  }
  ob->add("combat_exp", 120000);
  ob->add("potential", 50000);
  ob->set("newgift", 1);
  command("say 恭喜你领到了新手礼物。\n");
  return 1;
}
