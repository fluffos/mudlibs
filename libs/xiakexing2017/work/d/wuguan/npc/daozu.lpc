#include <ansi.h>
inherit NPC;

void create() {
  set_name("血刀老祖", ({ "xuedao laozu", "laozu" }));
  set("title", RED "武馆囚犯" NOR);
  set("long", "他是个凶残的老家伙，被连城武馆馆主狄云抓到这里。\n他浑身血迹斑斑，看来被人虐待得够呛。\n");
  set("gender", "男性");
  set("age", 24);
  set("combat_exp", 1300000);
  set("str", 28);
  set("int", 25);
  set("dex", 23);
  set("con", 25);
  set("per", 15);
  set("shen", -300000);
  set("neili", 3500);
  set("max_neili", 3500);
  set("jiali", 100);
  set("jingli", 800);
  set("max_qi", 4000);
  set("qi", 4000);
  set("food", 500);
  set("water", 500);
  set("max_jingli", 800);
  set_skill("force", 300);
  set_skill("unarmed", 300);
  set_skill("dodge", 350);
  set_skill("yanfly", 350);
  set_skill("parry", 350);
  set_skill("blade", 350);
  set_skill("xue-dao", 350);
  map_skill("parry", "xue-dao");
  map_skill("blade", "xue-dao");
  map_skill("dodge", "yanfly");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "blade.shendao" :),
  }));
  create_family("连城武馆", 2, "囚犯");
  setup();
  carry_object("/d/city/obj/gangdao")->wield();
  carry_object("/d/city/obj/cloth")->wear();
}
void attempt_apprentice(object ob) {
  if ((string)ob->query("family/family_name") != "连城武馆") {
    command("say “唉！老夫只敢收本馆弟子。”");
    return;
  }
  if (ob->query_skill("xue-dao", 1) < 150) {
    command("say “你的刀法还未练到家吧。”");
    return;
  }
  command("say “好吧，我就收你为徒弟了！”");
  command("recruit " + ob->query("id"));
}
