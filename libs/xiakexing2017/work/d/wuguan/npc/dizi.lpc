inherit NPC;

void create()
{
	set_name("武馆弟子", ({ "wuguan dizi", "dizi" }));
	set("gender", "男性");
	set("title","门徒");
	set("age", 23);
	set("long", "他是连城武馆一名普通的弟子。\n");
	
	set("combat_exp", 10000);
	set("shen_type", 1);
	set("attitude", "peaceful");
	set("jing",150);
	set("max_jing",150);
	set("qi",380);
	set("max_qi",380);
	set_skill("unarmed", 49);
	set_skill("dodge", 49);
	set_skill("parry",49);

	setup();
	create_family("连城武馆",5,"弟子");
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver", 30);
	add_money("gold", 1);
}
void attempt_apprentice(object ob)
{command("shake");}