// xiannvjian.c
#include <ansi.h>
#include <weapon.h>
inherit SWORD;

void create()
{
	set_name(HIR"仙"HIG"女"HIM"剑"NOR, ({ "xiannv jian", "jian","sword" }));
	set_weight(1000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是仙女剑。\n");
		set("value", 5000);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
		set("female_only", 1);
	}
	init_sword(380);
	setup();
}
