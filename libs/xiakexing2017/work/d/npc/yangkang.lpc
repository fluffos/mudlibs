// yangkang.c 杨康

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("杨康", ({"yang kang", "yang", "kang"}));
	set("title", HIR"小王爷"NOR);
	set("gender", "男性");
	set("age", 31);
	set("long", 
		"他英俊潇洒，却是个认贼作父的卑鄙小人。\n");
	set("attitude", "peaceful");
	set("shen",-10000);
	set("str", 25);
	set("int", 25);
	set("con", 26);
	set("dex", 23);
  set("food",300);
  set("water",300);
	set("chat_chance", 1);
	set("chat_msg", ({
		"杨康叹道：“不知道念慈她现在可好………”\n",
	}));

	set("inquiry", ([
		"穆念慈" : "好久没看到她了。\n",
	]));

	set("jing", 300);
	set("max_jing", 300);
	set("jingli", 150);
	set("max_jingli", 150);
	set("qi", 600);
	set("max_qi", 600);
	set("neili", 450);
	set("max_neili", 450);
	set("jiali",10);
	
	set("combat_exp", 80000);
	set("score", 1000);
	 
	set_skill("force", 50);		// 基本内功
	set_skill("literate",50);       //读书写字
	set_skill("claw", 60);		// 基本爪法
	set_skill("jiuyin-baiguzhao", 60);	// 九阴白骨爪
	set_skill("dodge", 60);		// 基本躲闪
	set_skill("parry", 60);			// 基本招架
	
	map_skill("claw", "jiuyin-baiguzhao");
	map_skill("parry", "jiuyin-baiguzhao");
	prepare_skill("claw", "jiuyin-baiguzhao");
	setup();
	create_family("全真教",3,"弟子");
	carry_object("/d/city2/obj/diaopi")->wear();
}

void attempt_apprentice(object ob)
{
     command("say 在下哪有什么资格收徒弟？\n");
}
