// m_cloth.c
#include <ansi.h>
#include <armor.h>
inherit M_ARMOR;

int chuilian(object cloth);
int do_si(object cloth);


string query_autoload() { return 1 + ""; }  //autoload cloth

void init() {
  add_action("do_chuilian", "chuilian");
  add_action("do_si", "si");
}


void create() {
  object me;
  string c_name, c_id, c_or;
  int c_lv;
  me = this_player();
  //读入数据
  c_name = me->query("cloth/name");
  c_id = me->query("cloth/id");
  c_or = me->query("cloth/or");
  c_lv = me->query("cloth/lv");
  set_name(c_name, ({ c_id }));
  set("unit", "件");
  set("no_get", 1);
  set("no_drop", 1);
  set("no_give", "此衣不能送人。\n");
  set_desc(c_lv, c_or, c_name);
  switch (c_or) {
    case "千年神木":
      set_weight(500);
      set("material", "iron");
      break;
    case "海底金母":
      set_weight(1000);
      set("material", "steel");
      break;
    case "寒丝羽竹":
      set_weight(30);
      set("material", "bamboo");
      break;
    default:
  }
  set("wear_msg", "$N往怀中一摸，掏出了一件" + c_name + "。\n");
  set("unwear_msg", "$N手中" + c_name + "一抖，眨眼间已然不见影踪。\n");
  set("armor_prop/armor", c_lv * 10);
  set("armor_prop/dodge", c_lv * 2);
  setup();
}



int do_chuilian(object cloth) {
  object me;
  int c_zhi, c_level;
  string c_or;
  me = this_player();
  if (!cloth)
    return notify_fail("你要锤炼什么?\n");

  if ((int)me->query("max_neili") < 10)
    return notify_fail("你的内力不够，无法锤炼宝衣！\n");

  if ((int)me->query("qi") < 150)
    return notify_fail("你的气不够，无法锤炼宝衣！\n");

  if ((int)me->query("eff_qi") < 30)
    return notify_fail("你现在的体力太弱，无法锤炼宝衣！\n");

  if ((int)me->query("eff_jing") < 10)
    return notify_fail("你现在的精力无法集中，不能锤炼宝衣！\n");

  if (((int)me->query("potential") - (int)me->query("learned_points")) < 2)
    return notify_fail("你的潜能不够，无法锤炼宝衣！\n");
  if ((int)me->query("cloth/lv") > 119)
    return notify_fail("你的宝衣很难提升了。\n");
  message_vision(HIR "$N手指衣领，一股内力丝丝的传了进去。\n" NOR, me);

  me->add("max_neili", -10);
  me->set("neili", (int)me->query("max_neili"));
  me->add("qi", -150);
  me->add("eff_qi", -30);
  me->add("eff_jing", -10);
  me->add("learned_points", 2);

  c_zhi = (int)me->query("cloth/value");
  c_zhi++;
  me->set("cloth/value", c_zhi);
  c_or = (string)me->query("cloth/or");
  c_level = (int)me->query("cloth/lv");
  if (c_zhi >= ((c_level + 1) * (c_level + 1))) {
    if (c_level < 120)
      c_level++;
    me->set("cloth/lv", c_level);
    message_vision(HIY "宝衣忽的一亮，一道金光隐入$N的衣体，不见了！\n" NOR, me);
    message_vision(HIG "$N的宝衣的等级提高了！\n" NOR, me);
    cloth = this_object();
    if (cloth->query("equipped"))
      cloth->unequip();
    reload_object(cloth);
    me->set("cloth/value", 0);
    return 1;
  }
  message_vision(RED "$N的衣气提升了!\n" NOR, me);
  return 1;
}


int do_si(object cloth) {
  string c_name;
  object me, ob;
  me = this_player();
  c_name = me->query("cloth/name");
  if (!cloth)
    return notify_fail("你要撕毁什么?\n");
  message_vision(HIR "你大喝一声，一掌擎衣领，一掌猛力击下。结果轰隆一声巨响"
    +c_name + "撕为两截!\n" NOR, me);
  me->set("cloth/make", 0);
  destruct(this_object());
  me->delete("cloth");

  me->save();

  return 1;
}
