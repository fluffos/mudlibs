// npc: shiyi.c
// Jay 3/26/96
#include <ansi.h>
inherit NPC;


void create() {
  set_name("侍衣", ({ "shiyi" }));
  set("nickname", MAG "衣" NOR);
  set("gender", "女性");
  set("age", 20);
  set("long",
    "她头上包着天青色纱巾，一领天青色布袍，没有一丝褶皱。\n");
  set("str", 25);
  set("dex", 20);
  set("con", 17);
  set("int", 30);
  set("shen_type", 0);
  set("max_neli", 500);
  set("jiali", 50);

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("force", 150);
  set_skill("sword", 150);
  set_skill("parry", 90);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/damage", 50);

  set("combat_exp", 250000);
  set("score", 0);

  set("attitude", "peaceful");

  set("inquiry", ([
    "造衣": "师傅命我帮助别人造衣，但到现在也不见一个人影。谁要造衣呢？\n",
    "原料": "造衣只能用寒丝羽竹。\n",
  ]));

  setup();

  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_zhu", "zhu");
}


int accept_object(object who, object ob) {
  if (!(who->query_temp("cloth"))) {
    message_vision(HIC "师傅没有同意为你造衣，您请回吧！\n" NOR, who);
    return 1;
  }
  who->delete_temp("cloth");
  who->set_temp("m_cloth", 1);
  switch ((string)ob->query("name")) {
    case "寒丝羽竹":
      break;
    default:
      message("vision", "这是什么！师傅说只有寒丝羽竹才能打造衣服！", who);
      return 0;
  }
  message("vision", "侍衣低头检视了一下手中的" + (string)ob->query("name") +
    "点了点头说：\n", who);
  message("vision", "。。。好我们现在就开始造衣！\n", who);
  write("请这位" + RANK_D->query_respect(who) + "给衣起名字吧！(zhu 衣服的名字 英文代号)\n可以给衣服名加颜色，例如zhu $HIY$金缕衣 jinlv cloth\n");
  return 1;

}

int do_zhu(string arg) {
  string o_name, id, c_name;
  object obj, cloth, make_time;   //生成的衣服句柄
  object me;
  string c_id;
  me = this_player();
  c_id = me->query("cloth/id");
  if (!(me->query_temp("m_cloth")))
    return notify_fail("什么?\n");
  me->delete_temp("m_cloth");
  me->delete_temp("get_orc");
  me->delete_temp("or");

  if ((me->query("cloth/make"))) {
    if (objectp(obj = present(c_id, me))) {
      say("侍衣脸色一沉：您的衣服不就在您手边么？还来干什么！\n");
      return 1;
    } else {
      say("侍衣想了想，道：就再给你复制一件吧。\n");
      cloth = new("/d/npc/m_weapon/weapon/m_cloth", 1);  //生成新衣
      cloth->move(this_player());
      return 1;
    }
  }
  if (!arg)
    return notify_fail("侍衣认真的说：想好衣服的名称及代号后再对我说。\n");

  sscanf(arg, "%s %s", c_name, id);
  if (!c_name || !id)
    return notify_fail("什么?(使用zhu 衣服的名字 英文代号)\n");
  c_name = replace_string(c_name, "$BLK$", BLK);
  c_name = replace_string(c_name, "$RED$", RED);
  c_name = replace_string(c_name, "$GRN$", GRN);
  c_name = replace_string(c_name, "$YEL$", YEL);
  c_name = replace_string(c_name, "$BLU$", BLU);
  c_name = replace_string(c_name, "$MAG$", MAG);
  c_name = replace_string(c_name, "$CYN$", CYN);
  c_name = replace_string(c_name, "$WHT$", WHT);
  c_name = replace_string(c_name, "$HIR$", HIR);
  c_name = replace_string(c_name, "$HIG$", HIG);
  c_name = replace_string(c_name, "$HIY$", HIY);
  c_name = replace_string(c_name, "$HIB$", HIB);
  c_name = replace_string(c_name, "$HIM$", HIM);
  c_name = replace_string(c_name, "$HIC$", HIC);
  c_name = replace_string(c_name, "$HIW$", HIW);
  c_name = replace_string(c_name, "$NOR$", NOR);

  c_name = c_name + NOR;
  o_name = "寒丝羽竹";
  make_time = NATURE_D->game_time();
  message_vision(me->name() + "沉吟了一会，对侍衣巧声说了几句话。侍衣点了点头。说：好吧！\n", me);
  message_vision("\n侍衣回过身，拿出一把寒气逼人的匕首，交到了$N的手中，自己拿出寒丝羽竹说：开始吧！\n", me);
  message_vision(HIB "$N双手紧紧握住匕首，用尽全身的力气向竹杆削去！\n" NOR, me);
  message_vision(RED "只听得嗤的一声轻响，匕首一滑竟刺到了$N的手上！\n" NOR, me);
  message_vision(YEL "$N只觉得手背的伤口一热，随着鲜血的流出，浑身的血液似乎都沸腾了起来！\n" NOR, me);
  message_vision(HIM "一身精血胶合着汩汩的内气，源源不断的向侍衣手中的寒丝羽竹涌去\n" NOR, me);
  if ((me->query("qi")) < (me->query("max_qi")) || (me->query("jing")) < (me->query("max_jing")) || (me->query("neili")) < (me->query("max_neili"))) {
    message_vision(HIR "突然$N觉得伤口一阵巨痛，气血一阵翻涌，一口真气接不上来。。。。 \n" NOR, me);
    me->set("neili", 0);
    me->unconcious();
    return 1;
  }
  message_vision(HIR "只听咯的一声轻响，一件宝衣从炉中倏然跃起。化作一道青电猛的向$N的前身罩来！！\n" NOR, me);
  say("侍衣见状大叫：宝衣初成，人血以祭！！闪开！\n");
  message_vision("$N只觉得眼前一花，一条青影迅捷无比的挡在了$N的身前。\n", me);
  message_vision(HIR "宝衣罩顶，侍衣惨嚎一声，鲜血溅得$N满脸都是！\n" NOR, me);
  message_vision(RED "侍衣脚下一个不稳，倒在了地上。侍衣已经奄奄一息了。\n" NOR, me);
  this_object()->set("max_qi", 10);
  message_vision("宝衣又飞了起来，飞到半空，扑的一声落回到地上。\n一室的劲气化于无形，一切又归于沉寂。\n", me);

  me->set("qi", 0);
  me->set("jing", 0);
  me->set("neili", 0);

  me->set("cloth/make", 1);  //衣服制造后防止再造的标志		
  me->set("cloth/name", c_name);  //衣服的名称
  me->set("cloth/id", id);  //衣服的代号
  me->set("cloth/lv", 1);     //衣服等级
  me->set("cloth/or", o_name);  //记录制造原料
  me->set("cloth/value", 0);        //记录武器升级已有的点数	
  me->set("cloth/type", "衣");
  me->set("cloth/time", make_time);

  cloth = new("/d/npc/m_weapon/weapon/m_cloth", 1);
  cloth->move(this_player());
  message_vision("侍衣摸起地上，带着斑斑血迹的宝衣，说：\n宝衣。。已。。成。。，侍衣的任务。。。也就完成了。。。。\n", me);
  say("侍衣艰难的说：宝衣。。您。。收好，我该走了。。。\n");
  message_vision("侍衣说完，倏的便不见了。\n", me);
  this_object()->die();
  return 1;
}
