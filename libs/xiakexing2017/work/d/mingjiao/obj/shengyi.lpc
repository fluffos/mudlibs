// shengyi.c 至尊衣
#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIR "至尊衣" NOR, ({ "zhizun cloth", "cloth" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1000);
    set("armor_prop/dodge", 80);
  }
  setup();
}
