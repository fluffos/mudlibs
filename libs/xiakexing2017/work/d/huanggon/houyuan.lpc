inherit ROOM;

void create() {
  set("short", "清和殿后院");
  set("long", @LONG
这里是清和殿后院。院里种着些青菜。墙角有一口水井（well）。
站在水井边往下看，只觉深不见底，井壁上满是滑溜溜的青苔。一个
轱辘吊着一根长绳，绳端系着一个木桶。东边是一条走廊，通往清和
殿。
LONG
  );
  set("item_desc", ([
    "well": "一口水井。宫里经常有人来此跳井。\n",
  ]));
  set("outdoors", "huanggon");
  set("resource/water", 1);
  set("exits", ([
    "east": "/d/huanggon/zoulang1",
  ]));

  setup();
}
void init() {
  add_action("do_jump", "tiao");
  add_action("do_jump", "jump");
}
int do_jump(string arg) {
  object me;
  me = this_player();
  if (!arg || (arg != "well") && (arg != "down"))
    return notify_fail("你要往那儿跳？\n");
  message_vision("\n$N深吸一口气，向井底猛地一跳。\n", me);
  message_vision("只听噗通一声。$N爽极了。\n", me);
  me->move("/d/huanggon/inwell");
  return 1;
}
