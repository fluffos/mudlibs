// zhangzz.c 张召重

#include <ansi.h>

inherit NPC;

void create() {
  set_name("张召重", ({ "zhang zhaozhong", "zhang", "zhaozhong" }));
  set("title", "大内侍卫统领");
  set("gender", "男性");
  set("age", 42);
  set("long",
    "他是皇宫大内侍卫统领，武艺高强。\n");
  set("attitude", "heroism");
  set("shen", -10000);
  set("str", 26);
  set("int", 28);
  set("con", 26);
  set("dex", 27);
  set("food", 1000);
  set("water", 1000);

  set("jing", 2000);
  set("max_jing", 2000);
  set("jingli", 1000);
  set("max_jingli", 1000);
  set("qi", 3500);
  set("max_qi", 3500);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 200);

  set("combat_exp", 600000);
  set("score", 20000);

  set_skill("force", 150);  // 基本内功
  set_skill("taiji-shengong", 150);  // 太极神功
  set_skill("literate", 50);       //读书写字
  set_skill("unarmed", 160);  // 基本拳脚
  set_skill("taiji-quan", 160);  // 太极拳
  set_skill("sword", 160);        //基本剑法
  set_skill("taiji-jian", 160);    //太极剑
  set_skill("dodge", 160);  // 基本躲闪
  set_skill("tiyunzong", 160);  // 梯云纵
  set_skill("parry", 160);   // 基本招架

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("sword", "taiji-jian");
  map_skill("parry", "taiji-jian");
  map_skill("unarmed", "taiji-quan");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.lian" :),
    (: exert_function, "recover" :),
  }));
  setup();
  create_family("武当派", 23, "弟子");
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}

void attempt_apprentice(object ob) {
  command("say 本统领一心保护皇上，哪有闲暇教徒弟？\n");
}
