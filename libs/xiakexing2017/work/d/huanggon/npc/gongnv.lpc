// gongnv.c

inherit NPC;

void create() {
  set_name("宫女", ({ "gongnv" }));
  set("gender", "女性");
  set("age", 17);
  set("long",
    "这是一位宫女，长得十分标致。\n");
  set_temp("apply/defense", 5);
  set("combat_exp", 300);
  //        set("shen", 100);
  set("shen_type", 1);
  set("str", 16);
  set("dex", 16);
  set("con", 16);
  set("int", 16);
  set("qi", 200);
  set("max_qi", 200);
  set_skill("unarmed", 10);
  set_skill("dodge", 10);
  set_skill("parry", 10);
  set("attitude", "friendly");
  setup();
  carry_object("/d/huanggon/obj/qipao")->wear();
  add_money("coin", 200);
}
