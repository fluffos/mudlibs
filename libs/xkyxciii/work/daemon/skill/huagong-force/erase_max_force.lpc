// erase_max_force.c

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target)
{
        int skill, force, diff=0;
        string msg;

        if(target == me) 
                return notify_fail("你只能化解别人的真元。\n");

        if(!target->is_character() || !living(target) )
                return notify_fail("从" + target->query("name") + "上不能化解真元。\n");

        if(!target->is_fighting(me) )
                return notify_fail(target->name() + "没有和你交手，你无法化解他的真元！\n");

        if(me->query_temp("weapon") )  diff += 15;
        if(target->query_temp("weapon") )  diff += 15;
        if(me->query_skill("force") < target->query_skill("force") )  diff += 20;

        force = (int) target->query("max_force") / 100;
        if(force < 1)   force = 1;
        diff += force * 10;
        if(me->query("kee") < force * 20 )
                return notify_fail("你的气不够，不能再化解真元了。\n");

        me->receive_damage("kee", force*20);
        me->start_busy(4);

        skill = me->query_skill("huagong-force", 1);

        msg = CYN "$N催动体内化功大法真气，顿时一股强大的吸力传向$n体内。\n" NOR;


        if(random(skill) > diff) {
                msg += RED"$n只觉得被$N牢牢吸住，体内真气竟源源不断地泄向体外......\n"NOR;
                target->add("max_force", -force);
                // me->add("max_force", force * 2 / 3);

                message_vision(msg, me, target);
                return 1;
        }

        if( 2*(int)me->query("max_force") < target->query("max_force") ) {
                msg += RED"$N突然只觉不能控制内息，体内真气竟源源不断地泄向体外......\n"NOR;
                me->add("max_force", -(int)me->query("max_force") / 100 - 1 );
                // target->add("max_force", (int)me->query("max_force") / 150);

                message_vision(msg, me, target);
                return 1;
        }

        msg += CYN"$N因为化功大法修练不够成熟而失败了。\n"NOR;

        message_vision(msg, me, target);

        return 1;
}

