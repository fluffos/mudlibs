// dugu-sword.c - 独孤九剑

inherit SKILL;
/*
独孤九剑：                                                                      
总决式：种种变化，用以体演总决                                                  
破剑式：用以破解各门各派的剑法                                                  
破刀式：用以破解单刀、双刀、柳叶刀、鬼头刀、大砍刀、                            
        斩马刀                                                                  
破枪式：破解长枪、大戟、蛇矛、齐眉棍、狼牙棒、白蜡杆、                          
        禅杖、方便铲等长兵器                                                    
破鞭式：钢鞭、铁锏、点穴橛、拐子、蛾眉刺、匕首、板斧、                          
        铁牌、八角锥、铁椎等短兵器                                              
破索式：长索、软鞭、三节棍、链子枪、铁链、渔网、飞锥流星                        
破掌式：长拳短打、擒拿点穴、鹰爪虎爪、铁沙神掌诸般拳脚                          
        功夫尽数包括在内                                                        
破箭式：破解种种暗器                                                            
破气式：专为对付身具上乘内功而用                                                
*/
mapping *action = ({
([      "action" : "$N一式「破剑式」，剑锋平指，剑势如风，手中$w直刺$n的$l",
        "force"         : 180,
        "dodge"         : 15,
        "parry"         : 30,
        "damage"        : 30,
        "lvl"           : 0,
        "skill_name"    : "破剑式",
        "damage_type"   : "刺伤"
]),
([      "action" : "$N一式「破刀式」，$w划出一个大弧，平平地向$n的$l挥去",
        "force"         : 200,
        "dodge"         : 20,
        "parry"         : 40,
        "damage"        : 40,
        "lvl"           : 10,
        "skill_name"    : "破刀式",
        "damage_type"   : "刺伤"
]),
([      "action" : "$N向前跃上一步，左手剑诀，右手$w使出一式「破掌式」直刺$n的$l",
        "force"         : 220,
        "dodge"         : 25,
        "parry"         : 50,
        "damage"        : 50,
        "lvl"           : 20,
        "skill_name"    : "破掌式",
        "damage_type"   : "刺伤"
]),
([      "action" : "$N右手虚抱成圆，一式「破枪式」，中宫直进，$w猛地刺向$n的$l",
        "force"         : 240,
        "dodge"         : 30,
        "parry"         : 60,
        "damage"        : 60,
        "lvl"           : 30,
        "skill_name"    : "破枪式",
        "damage_type"   : "刺伤"
]),
([      "action" : "$N一式「破索式」，$w从上至下猛劈，剑锋直出，挟爆裂之声骤然斩向$n的$l",
        "force"         : 260,
        "dodge"         : 35,
        "parry"         : 70,
        "damage"        : 80,
        "lvl"           : 40,
        "skill_name"    : "破索式",
        "damage_type"   : "刺伤"
]),
([      "action" : "$N运气施出「破鞭式」，$w剑尖逼出一道青芒，闪电般破空射向$n的$l",
        "force"         : 280,
        "dodge"         : 40,
        "parry"         : 80,
        "damage"        : 100,
        "lvl"           : 50,
        "skill_name"    : "破鞭式",
        "damage_type"   : "刺伤"
]),
([      "action" : "$N拔步挺腰，一式「破气式」，手中$w沉滞无比，缓缓挥剑撞向$n的$l",
        "force"         : 300,
        "dodge"         : 45,
        "parry"         : 90,
        "damage"        : 120,
        "lvl"           : 60,
        "skill_name"    : "破气式",
        "damage_type"   : "刺伤"
]),
([      "action" : "$N双腿半屈半蹲，一式「破箭式」，$w划出无数圆圈，狂风骤起，笼罩天地",
        "force"         : 350,
        "dodge"         : 50,
        "parry"         : 100,
        "damage"        : 140,
        "lvl"           : 70,
        "skill_name"    : "破箭式",
        "damage_type"   : "刺伤"
]),
([      "action" : "$N一式「总诀式」，$w虚虚一指，天地为之变色",
        "force"         : 400,
        "dodge"         : 55,
        "parry"         : 110,
        "damage"        : 160,
        "lvl"           : 80,
        "skill_name"    : "总诀式",
        "damage_type"   : "刺伤"
]),
([      "action" : "$N一式「总诀式」，$w随手一指，无招无式，天地为之变色",
        "force"         : 500,
        "dodge"         : 60,
        "parry"         : 120,
        "damage"        : 180,
        "lvl"           : 100,
        "skill_name"    : "总诀式",
        "damage_type"   : "刺伤"
]),
});

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
        object ob;

        if ((int)me->query("max_force") < 200)
                return notify_fail("你的内力不够。\n");
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练独孤九剑。\n");
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"]) return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("dugu-sword",1);
        for(i = sizeof(action); i > 0; i--)
                if(level >= action[i-1]["lvl"]) return action[random(i)];
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("kee") < 50)
                return notify_fail("你的体力不够练独孤九剑。\n");
        me->receive_damage("kee", 35);
        write("你按著所学练了一遍独孤九剑。\n");
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"dugu-sword/" + action;
}

int enable_factor() { return 230; }

int learn_factor(int n) { 
   if (n<100) return 110;
   else return 80;
 }
int learn_bonus()  { return 1; }

int study_factor() { return 100; }
int study_bonus()  { return 1; }

int practice_factor() { return 90; }
int practice_bonus()  { return 1; }
