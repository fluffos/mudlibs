// huashan-steps.c - 华山身法

inherit SKILL;

string *dodge_msg = ({
  "$n身随意转，一招「巨鹏亮翅」轻轻巧巧地躲过了$N的攻击。\n",
  "$n一招「旭日东升」，身形飘忽，轻轻一纵，飘到了几丈之外。\n",
  "$n一招「幻眼云烟」，从$N的身边很快地跃了过去。\n",
  "却见$n双足一点，一招「旱地拔葱」，腾空而起。\n",
  "可是$n使出一招「飞鸟投林」，象只大鸟般飞了出去。\n",
  "只见$n身子一长，一招「金燕横空」轻轻闪到一旁。\n",
  "只见$n一招「流星赶月」，悄悄地绕到了$N的身后！\n",
  "只见$n一个转身，一招「云雾萦绕」，身子轻轻飘了开去。\n",
});

int valid_enable(string usage) { return (usage == "dodge" || usage == "move"); }

int valid_learn(object me) {
  int level;

  if ((int)me->query("max_force") < 80)
    return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
  if ((int)me->query_skill("force") < 10)
    return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
  level = me->query_skill("huashan-steps");
  if (level * level * level / 10 > me->query("SEN"))
    return notify_fail("修练华山身法，要除暴安良，行侠仗义。你好象做得不够呀！\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  int i;

  i = (int)me->query_skill("huashan-steps");
  if ((int)me->query("kee") < 30)
    return notify_fail("你的气太少了，无法继续练习华山身法。\n");
  me->receive_damage("kee", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "huashan-steps/" + action;
}

int enable_factor() { return 100; }

int learn_factor(int n) {
  if (n < 100) return 120;
  else return 100;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 3; }

int practice_factor() { return 110; }
int practice_bonus() { return 1; }
