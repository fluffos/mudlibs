int valid_enable(string usage) { return (usage == "unarmed") || (usage == "parry"); }

int valid_learn(object me) {
  int level;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练般若掌法必须空手。\n");
  if ((int)me->query_skill("buddhism") < (int)me->query_skill("banruo-zhang") / 2)
    return notify_fail("佛门每种绝技都要有慈悲佛法为之化解，你好象学得不够呀！\n");
  level = me->query_skill("banruo-zhang");
  if (level * level * level / 10 > me->query("SEN"))
    return notify_fail("修练般若掌法，要除暴安良，行侠仗义。你好象做得不够呀！\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"]) return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("banruo-zhang", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"]) return action[random(i)];
}

int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练般若掌法必须空手。\n");
  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练般若掌法。\n");
  me->receive_damage("kee", 35);
  write("你按著所学练了一遍般若掌法。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "banruo-zhang/" + action;
}

int enable_factor() { return 100; }

int learn_factor(int n) {
  if (n < 100) return 120;
  else return 100;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 3; }

int practice_factor() { return 110; }
int practice_bonus() { return 1; }
