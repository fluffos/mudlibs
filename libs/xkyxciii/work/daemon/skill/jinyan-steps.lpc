// jinyan-steps.c - 金雁神功

inherit SKILL;

string *dodge_msg = ({
  "只$n身子一长，一招「雁徊朝阳」，轻轻闪到一旁。\n",
  "$n一招「金雁横空」，向一旁飘然纵出，轻轻着地。\n",
  "$n身影微动，一招「开阳薄雾」，身子轻轻飘了开去。\n",
  "$n一招「天玑离枢」，轻轻巧巧地避了开去。\n",
  "只见$n身影一晃，一式「天璇乱步」，早已避在数尺之外。\n",
  "$n使出「倒转天权」，身影滴溜溜地一转，飘忽若神。\n",
  "$n足下一点，一招「逐影天枢」腾空而起，避了开去。\n",
  "但是$n一招「瑶光音迟」使出，早已绕到$N身後。\n",
});

int valid_enable(string usage) { return (usage == "dodge" || usage == "move"); }

int valid_learn(object me) {
  int level;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
  if ((int)me->query_skill("force") < 10)
    return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
  level = me->query_skill("jinyan-steps");
  if (level * level * level / 10 > me->query("SEN"))
    return notify_fail("修练金雁神功，要除暴安良，行侠仗义。你好象做得不够呀！\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  int i;

  i = (int)me->query_skill("jinyan-steps");
  if ((int)me->query("kee") < 35)
    return notify_fail("你的气太少了，无法继续练习金雁神功。\n");
  me->receive_damage("kee", 35);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "jinyan-steps/" + action;
}

int enable_factor() { return 100; }

int learn_factor(int n) {
  if (n < 100) return 110;
  else return 90;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 2; }

int practice_factor() { return 100; }
int practice_bonus() { return 1; }
