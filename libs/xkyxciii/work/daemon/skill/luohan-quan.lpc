// luohan-quan.c - 罗汉神拳

inherit SKILL;
/*
罗汉拳：右穿花手、拗步拉弓、单凤朝阳、二郎担山、双圈手、偏花七星、挟山超海、
        苦海回头、盘肘、翻身劈击
少林拳：黄鹦落架
普通招式：双贯耳
  */
mapping *action = ({
  ([ "action": "$N连续上步，一式「黄莺落架」，左右手分靠，变拳为掌，击向$n的$l",
    "force": 50,
    "dodge": -10,
    "parry": -10,
    "damage": 5,
    "lvl": 0,
    "skill_name": "黄莺落架",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左脚虚踏，全身右转，一招「丹凤朝阳」，右掌猛地插向$n的$l",
    "force": 80,
    "dodge": -5,
    "parry": -5,
    "damage": 10,
    "lvl": 10,
    "skill_name": "丹凤朝阳",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双手大开大阖，宽打高举，使一招「洛钟东应」，双拳向$n的$l打去",
    "force": 100,
    "dodge": 1,
    "parry": 1,
    "damage": 20,
    "lvl": 20,
    "skill_name": "洛钟东应",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌圈花扬起，屈肘当胸，虎口朝上，一招「偏花七星」打向$n的$l",
    "force": 120,
    "dodge": 10,
    "parry": 10,
    "damage": 30,
    "lvl": 30,
    "skill_name": "偏花七星",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一招「苦海回头」，上身前探，双手划了个半圈，击向$n的$l",
    "force": 140,
    "dodge": 20,
    "parry": 20,
    "damage": 40,
    "lvl": 40,
    "skill_name": "苦海回头",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双掌划弧，一记「挟山超海」，掌出如电，一下子切到$n的手上",
    "force": 160,
    "dodge": 30,
    "parry": 30,
    "damage": 50,
    "lvl": 50,
    "skill_name": "挟山超海",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N施出「慑服外道」，双拳拳出如风，同时打向$n头，胸，腹三处要害",
    "force": 180,
    "dodge": 40,
    "parry": 40,
    "damage": 60,
    "lvl": 60,
    "skill_name": "慑服外道",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式「摘星换斗」，劲气弥漫，双掌如轮，一环环向$n的$l斫去",
    "force": 200,
    "dodge": 50,
    "parry": 50,
    "damage": 70,
    "lvl": 70,
    "skill_name": "摘星换斗",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N两掌上下护胸，一式「翻江搅海」，骤然化为满天掌雨，攻向$n",
    "force": 220,
    "dodge": 60,
    "parry": 60,
    "damage": 80,
    "lvl": 80,
    "skill_name": "翻江搅海",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左脚内扣，右腿曲坐，一式「三入地狱」，双手齐齐按向$n的胸口",
    "force": 240,
    "dodge": 70,
    "parry": 70,
    "damage": 100,
    "lvl": 100,
    "skill_name": "三入地狱",
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return (usage == "unarmed") || (usage == "parry"); }

int valid_learn(object me) {
  int level;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练罗汉神拳必须空手。\n");
  if ((int)me->query_skill("buddhism") < (int)me->query_skill("luohan-quan") / 2)
    return notify_fail("佛门每种绝技都要有慈悲佛法为之化解，你好象学得不够呀！\n");
  level = me->query_skill("luohan-quan");
  if (level * level * level / 10 > me->query("SEN"))
    return notify_fail("修练罗汉神拳，要除暴安良，行侠仗义。你好象做得不够呀！\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"]) return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("luohan-quan", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"]) return action[random(i)];
}

int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练罗汉神拳必须空手。\n");
  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练罗汉神拳。\n");
  me->receive_damage("kee", 35);
  write("你按著所学练了一遍罗汉神拳。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "luohan-quan/" + action;
}

int enable_factor() { return 100; }

int learn_factor(int n) {
  if (n < 100) return 120;
  else return 100;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 3; }

int practice_factor() { return 110; }
int practice_bonus() { return 1; }
