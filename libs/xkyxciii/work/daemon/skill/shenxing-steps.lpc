// shenxing-steps.c - 神行百变

inherit SKILL;

string *dodge_msg = ({
  "只见$n一招「巨鹏亮翅」，身体向上笔直地纵起丈余，轻轻松松地闪过。\n",
  "可是$n一招「风送紫霞」，向后飘出数丈之远，避开了$N的凌厉攻势。\n",
  "但是$n一招「燕徊朝阳」，身体突然向后飘然跃出，轻轻着地。\n",
  "但见$n使出「却别苍松」，向左上方跃出丈余，巧妙地避开了$N的攻势。\n",
  "$n使出「旭日初升」，身体向上腾空而起，避了开去。。\n",
  "$n使出「晚月朗星」，化作天上流星，一刹那消失$N的眼里。\n",
  "$n使出「幻眼云湮」，$N的眼睛一花，$n迅速飘向一旁，轻轻巧巧地避了开去。\n",
  "$n使出「苍龙盘岭」，身体化作一条飞龙， 转眼间转到了$N的身后。\n",
});

int valid_enable(string usage) { return (usage == "dodge" || usage == "move"); }

int valid_learn(object me) {
  int level;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
  if ((int)me->query_skill("force") < 10)
    return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
  level = me->query_skill("shenxing-steps");
  if (level * level * level / 10 > me->query("SEN"))
    return notify_fail("修练神行百变，要除暴安良，行侠仗义。你好象做得不够呀！\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  int i;

  i = (int)me->query_skill("shenxing-steps");
  if ((int)me->query("kee") < 35)
    return notify_fail("你的气太少了，无法继续练习神行百变。\n");
  me->receive_damage("kee", 35);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "shenxing-steps/" + action;
}

int enable_factor() { return 200; }

int learn_factor(int n) {
  if (n < 100) return 100;
  else return 80;
}
int learn_bonus() { return 1; }

int study_factor() { return 100; }
int study_bonus() { return 1; }

int practice_factor() { return 90; }
int practice_bonus() { return 1; }
