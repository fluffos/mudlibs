// hunyuan-force.c - 混元神功

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me) 
{ 
        int level;

        if( (int)me->query_skill("force") < 10 )
                return notify_fail("你的基本内功火候不够，无法研习高深的内功。\n");
        if( (int)me->query_skill("buddhism") < (int)me->query_skill("hunyuan-force") / 2 )
                return notify_fail("佛门每种绝技都要有慈悲佛法为之化解，你好象学得不够呀！\n");
        level = me->query_skill("hunyuan-force");
        if ( level * level * level / 10 > me->query("SEN"))
                return notify_fail("修练混元神功，要除暴安良，行侠仗义。你好象做得不够呀！\n");
        return 1; 
}

int practice_skill(object me)
{
        return notify_fail("混元神功只能学习（learn），或是从运用（exert）中增加熟练度。\n");
}

string exert_function_file(string func)
{
        return __DIR__"hunyuan-force/" + func;
}
 
int enable_factor() { return 150; }

int learn_factor(int n) { 
    if (n<100) return 120; 
    else return 100;
}
int learn_bonus()  { return 1; }

int study_factor() { return 110; }
int study_bonus()  { return 2; }

