// piaomiao-steps.c - 飘渺身法

inherit SKILL;

string *dodge_msg = ({
        "只见$n施展飘渺身法，身随意转，早已飘到$N身后。\n",
        "$n施展飘渺身法，身影有如疾电流窜，令$N的攻势全数落空。\n",
        "只见$n施展飘渺身法，轻轻巧巧地避了开去。\n",
        "可是$n施展飘渺身法，身子轻轻飘了开去。\n",
        "$n身形往上一拔，施展飘渺身法，一个转折落在数尺之外。\n",
        "只见$n身影滴溜溜地一转，体迅飞鸟，飘忽若神。\n",
        "$N只感眼前一花，$n已幻化成无数化身四散飞射。\n"
        "$n身影突如陀螺急转，形成猛烈的气劲漩涡，坚密如墙，$N根本无从入手。\n",
});

int valid_enable(string usage) { return (usage=="dodge" || usage=="move") ; }

int valid_learn(object me)
{
        int level;

        if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力修为不够，无法研习高深的步法。\n");
        if( (int)me->query_skill("force") < 10 )
                return notify_fail("你的内功火候不够，无法研习高深的步法。\n");
        level = me->query_skill("piaomiao-steps");
        if ( - level * level * level / 10 < me->query("SEN"))
                return notify_fail("修练飘渺身法，要心狠手辣，奸恶歹毒。你好象做得不够呀！\n");
        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        int i;

        i = (int)me->query_skill("piaomiao-steps");
        if( (int)me->query("kee") < 35 )
                return notify_fail("你的气太少了，无法继续练习飘渺身法。\n");
        me->receive_damage("kee", 35);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"piaomiao-steps/" + action;
}

int enable_factor() { return 100; }

int learn_factor(int n) { 
   if (n<100) return 110;
   else return 90;
 }
int learn_bonus()  { return 1; }

int study_factor() { return 100; }
int study_bonus()  { return 2; }

int practice_factor() { return 100; }
int practice_bonus()  { return 1; }
