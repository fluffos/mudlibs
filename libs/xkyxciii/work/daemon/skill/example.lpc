/* ----------------------------------------------------------------------------
                Micro: 以下程序段，除非特殊需要，否则不要修改
---------------------------------------------------------------------------- */

// 返回技能的英文名
string this_skill_id()
{
        string s;
        sscanf(__FILE__, __DIR__"%s.lpc", s);
        return s;
}

// 返回技能的中文名
string this_skill_name()
{
        return to_chinese( this_skill_id() );
}

// Learn 的处理
int valid_learn(object me)
{
        object weapon;
        string name;
        int level;

        name = this_skill_name();        

        if ( me->query("max_force") < MAX_FORCE )
                return notify_fail( sprintf( "凭你现在的内功根基还不能练“%s”。\n", name ) );

        if( WEAPON_TYPE == "unarmed" ) {        // Learn 时必须空手
                if ( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                        return notify_fail( sprintf( "练“%s”必须空手。\n", name ) );
        }
        else {                                  // Learn 时必须使用相应武器
                if ( !objectp( weapon = me->query_temp("weapon") )
                ||      weapon->query("skill_type") != WEAPON_TYPE )
                        return notify_fail( sprintf( 
                                "你使用的武器不对，你应该装备“%s”。\n", to_chinese(WEAPON_TYPE) ) );
        }

        level = me->query_skill( this_skill_id(), 1 );

        if( BUDDHISM_REQU > 0 )                 // 对佛法的需求
                if( (int)me->query_skill( "buddhism", 1 ) < level / BUDDHISM_REQU )
                        return notify_fail( sprintf( 
                                "修练“%s”要有慈悲佛法为之化解，你好象学得不够呀！\n", name ) );

        if( SEN_REQU > 0 ) {                    // 对正气的需求
                if ( level * level * level / SEN_REQU > me->query("SEN") )
                        return notify_fail( sprintf( 
                                "修练“%s”要除暴安良，行侠仗义。你好象做得不够呀！\n", name ) );
        }
        if( SEN_REQU < 0 ) {
                if ( level * level * level / SEN_REQU < me->query("SEN"))
                        return notify_fail( sprintf( 
                                "修练“%s”要心狠手辣，奸恶歹毒。你好象做得不够呀！\n", name ) );
        }

        return 1;
}

int query_practice_kee()
{
        return PRACTICE_KEE;
}

// Practice 的处理
int practice_skill(object me)
{
        object weapon;
        string name;

        name = this_skill_name();        

        if ( me->query("max_force") < MAX_FORCE )
                return notify_fail( sprintf( "凭你现在的内功根基还不能练“%s”。\n", name ) );

        if( WEAPON_TYPE == "unarmed" ) {        // Practice 时必须空手
                if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                        return notify_fail( sprintf( "练“%s”必须空手。\n", name ) );
        }
        else {                                  // Practice 时必须使用相应武器
                if (!objectp(weapon = me->query_temp("weapon"))
                ||      (string)weapon->query("skill_type") != WEAPON_TYPE)
                        return notify_fail( sprintf( "你使用的武器不对，你应该装备“%s”。\n", to_chinese(WEAPON_TYPE) ) );
        }

        printf( "你按照所学开始练习“%s”。\n", name );

        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, r, level;

        level = (int) me->query_skill( this_skill_id(), 1 );
        i = sizeof(actions) - 1;
        while( i >= 0 ) {
                if( level >= actions[i]["level"] ) break;
                i --;
        }
        if( i < 0 ) i = 0;
        r = random(i);
        action["action"] = actions[r]["action"];
        action["damage_type"] = actions[r]["damage"];

        i = sizeof(skill_names) - 1;
        while( i >= 0 ) {
                if( level >= skill_names[i]["level"] ) break;
                i --;
        }
        if( i < 0 ) i = 0;
        r = random(i);        
        action["action"] = replace_string( action["action"], 
                "$Z", sprintf( "“%s”", skill_names[r]["name"] ) );

        i = sizeof(damages) - 1;
        while( i >= 0 ) {
                if( level >= damages[i]["level"] ) break;
                i --;
        }
        if( i < 0 ) i = 0;
        action["force"] = damages[i]["force"];
        action["dodge"] = damages[i]["dodge"];
        action["parry"] = damages[i]["parry"];
        action["damage"] = damages[i]["damage"];
        action["post_action"] = damages[i]["post_action"];

        return action;
}

// 返回技能的 Perform 控制文件名
string perform_action_file(string action)
{
        return sprintf( "%s%s/%s", __DIR__, this_skill_id(), action );
}
