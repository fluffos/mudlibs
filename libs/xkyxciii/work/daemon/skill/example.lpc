inherit SKILL;

#define WEAPON_TYPE     "sword"         // 武功的类型
                                        // 取值范围：unarmed或者各类武器如sword、blade....
#define BUDDHISM_REQU   0               // 学习武功所需要的佛法。取值通常为 0, 1 或者 2
                                        // 0 表示不需佛法；1 表示需高深佛法；2 表示需要佛法
#define SEN_REQU        0               // 学习武功所需要的正气。取值通常为 -20, -10, 0 或者 10, 20
                                        // 0 表示不需正气；|10|表示需大量正气；|20|表示需小量正气
#define MAX_FORCE       100             // 学习武功所需要的最大内力
#define PRACTICE_KEE    30              // 每次Practice武功所使用的气的数量

int valid_enable(string usage) {
        return ( (usage == "sword") || (usage == "parry") );
}

int enable_factor() { return 100; }     // Enable系数（单位为％）

int learn_factor() { return 100; }      // Learn    的难度系数（单位为％）

int study_factor() { return 100; }      // Study    的难度系数（单位为％）

int practice_factor() { return 100; }   // Practice 的难度系数（单位为％）

mapping *actions = ({                   // 某级武功相应能发出的攻击描述。其中使用的特殊符号有：
                                        // $N：自已；$n：敌人；$l：攻击部位；$w：武器；$Z：招式
                                        // 伤害类型有：划伤、割伤、刺伤、瘀伤、抓伤、反弹伤....
([      "action" : "$N向前跃上一步，左手剑诀，右手$w使出$Z直刺$n的$l。",
        "damage" : "刺伤",
        "level"  : 0,
]),
([      "action" : "$N拔步挺腰，一招$Z，手中$w沉滞无比，缓缓撞向$n的$l。",
        "damage" : "割伤",
        "level"  : 0,
]),
([      "action" : "$N运气施出$Z，$w剑尖逼出一道青芒，闪电般破空射向$n的$l！",
        "damage" : "刺伤",
        "level"  : 50,
]),
});

