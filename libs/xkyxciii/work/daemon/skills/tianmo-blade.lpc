([      "action":               "$N使出如意天魔连环八式中的收手式“万魔归宗”，手中的$w迅捷无比地砍向$n的$l",
        "dodge"         : 80,
        "parry"         : 60,
        "damage"        : 180,
        "lvl"           : 100,
