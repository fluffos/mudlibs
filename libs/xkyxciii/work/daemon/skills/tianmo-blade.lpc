([	"action":		"$N的双脚点地，刀背贴身，一招“万刃天魔”全身转出一团刀光滚向$n",
        "dodge"         : 50,
        "parry"         : 50,
        "damage"        : 60,
        "lvl"           : 70,
	"force":		200,
