// 蛤蟆掌
// seasong 1999

#include <ansi.h>
inherit SSERVER;

int exert(object me, object target)
{ 
  int sp, dp, damage;
  if ( target == me )   target = offensive_target(me);
  if( (int)me->query_skill("hama-force",1) < 100 )
    return notify_fail("你的蛤蟆功功力不够，不能发出蛤蟆掌！n"); 
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［蛤蟆掌］只能对战斗中的对手使用。\n");

 if( (int)me->query("force",1) < 800 )
  return notify_fail("你的内力不够，不能使用蛤蟆掌。\n");
message_vision(
WHT"\n$N突然蹲下身来，喉咙中“咕”的一声，猛地一纵身，两掌一齐击出！\n\n" NOR,me, target );
 if ( living(target) )
 {
  if( !target->is_killing(me) )
   target->kill_ob(me);
 }
 sp = me->query_skill("dodge") + me->query_skill("force");
 dp = target->query_skill("dodge");
       if((int)target->is_busy()) sp = sp * 2;
       dp = dp * (int)target->query("sen") / (int)target->query("max_sen");
       me->add("force",-600);
 if (( random(sp) > random(dp)  ) || !living(target) )
 {   if( ( random( me->query_skill("force")+ target->query_skill("force"))
 > target->query_skill("force") /2 )  && target->query("force") > 500)
    { message_vision(
HIR"$n一声惨叫，“咯拉”声响中，肋骨断了数根，整个人倒飞出去，跌落尘埃。\n\n" NOR,me, target );
              damage = (int)me->query_skill("force") / 3;
              target->receive_damage("kee", 10 * damage + 5 * random(damage) );
              target->receive_wound("kee", 5 * damage + 4 * random(damage) );
                me->start_busy(random(4));
                target->start_busy(random(3));
                COMBAT_D->report_status(target);
    }else {
   message_vision(HIW"\n$n大喝一声，也击出一掌，两股巨力一撞，顿时一声巨响，四周飞沙走石！\n"NOR,me,target); 
     target->add("force",-300);target->start_busy(3);  }  

} else message_vision(HIY"$n不敢硬接，连忙闪开，劲风从身旁掠过，脸被刮得阵阵生疼。\n" NOR, me, target);
 
   me->start_busy(5); 
return 1;
}
                                                                    
