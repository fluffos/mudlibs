// red_frog.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	me->receive_wound("kee", 20);
	me->receive_damage("sen", 20);
	me->apply_condition("red_frog", duration - 1);
	tell_object(me, HIG "你中的"NOR+RED"莽牯朱蛤"NOR+HIG"毒发作了！\n" NOR );
	me->add("poison", 1);

	if( duration < 1 ) return 0;
	return 1;
}
