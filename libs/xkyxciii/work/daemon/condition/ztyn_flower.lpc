// ztyn_flower.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	me->receive_wound("gin", 15);
	me->receive_damage("sen", 15);
	if(me->query("force")>=50)	me->add("force",-50);
	else	me->set("force",0);

	me->apply_condition("ztyn_flower", duration - 1);
	tell_object(me, HIG "你中的紫檀幽兰花毒发作了！\n" NOR );
	me->add("poison", 1);

	if( duration < 1 ) return 0;
	return 1;
}
