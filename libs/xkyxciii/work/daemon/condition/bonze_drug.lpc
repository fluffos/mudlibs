// bonze_drug.c

#include <condition.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
	if( ((int)me->query("force")+100) < ((int)me->query("max_force"))*2 ) {
		me->add("force", 100);
		tell_object(me, WHT "由于服用了菩提子，你的内力有所恢复！\n" NOR );
	}
	else	{
		me->add("max_force",1);
		me->set("force",(int)me->query("max_force"));
		tell_object(me, WHT "由于服用了菩提子，你的内力提高了！\n" NOR );
	}

	me->apply_condition("bonze_drug", duration - 1);
	if( !duration ) return 0;

	return CND_CONTINUE;
}
