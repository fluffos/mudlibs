// three_smile_poison.c

int update_condition(object me, int duration)
{
        me->receive_wound("kee", 20);
        me->receive_damage("sen", 20);

        me->apply_condition("three_smile_poison", duration - 1);
        me->add("poison", 1);

        if( (duration%2) == 0) 
                message_vision("$N突然邪恶的一笑，笑容充满了说不出的诡异！\n", me);

        if( duration < 1 ) {
                tell_object(me, "你中的三笑逍遥散毒彻底发做了！\n");
                call_out("die", 1, me);

                return 0;
        }

        return 1;
}

void die(object me)
{
        me->die();
}