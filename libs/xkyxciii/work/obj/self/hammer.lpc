// hammer.c 独门铁锤

#include <weapon.h>
#include <ansi.h>

inherit HAMMER;

void set_up();

void create()
{
        set_name("我的铁锤", ({ "my hammer", "hammer" }));
	set( "no_get", 1 );
	set( "no_put", 1 );
	set( "no_drop", 1 );
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一件独门兵器。\n");
                set("unit", "柄");
                set("value", 0);
                set("material", "myself");
        }
        init_hammer(1);
        setup();
		set_up();
}

void set_up()
{
        object me;
	me = this_player();

        if(!me) return ;
        // Micro: 99-02-11 如果物品在人物身上，当然获取他的参数了。
        // 这个做法是防止别人 look 时产生的 bug, 但最好的解决方法是不用 set_up()
        if( environment(this_object()) )
                if( environment(this_object())->is_character() )
                        me = environment(this_object());

	if( stringp(me->query("weapon/name")) )  
		set("name", me->query("weapon/name"));
	if( stringp(me->query("weapon/wield_msg")) )
		set("wield_msg", me->query("weapon/wield_msg") );
        else    delete("wield_msg");
	if( stringp(me->query("weapon/unwield_msg")) )
		set("unwield_msg", me->query("weapon/unwield_msg") );
        else    delete("unwield_msg");
	if( me->query("weapon/damage") )  
		set("weapon_prop/damage", me->query("weapon/damage"));
	set( "long", me->name() + "的「" + this_object()->name() + "」。\n" );
}

void dest() { destruct(this_object()); }

void owner_is_killed() { call_out("dest",1); }