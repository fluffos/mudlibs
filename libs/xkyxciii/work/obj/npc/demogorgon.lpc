// demongorgon.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name(HIW "侠客神使" NOR, ({ "super god", "god" }));
  set("long",
    "这位就是侠客英雄传的代言人--侠客神使!\n");

  set("age", 7006);
  set("pursuer", 1);

  set("max_gin", 10000);
  set("max_kee", 10000);
  set("max_sen", 10000);

  set("max_atman", 9999);
  set("atman", 9999);
  set("max_force", 10000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 5000);

  set("per", 30);

  set("combat_exp", 40000000);

  set_skill("unarmed", 500);
  set_skill("parry", 500);
  set_skill("dodge", 500);

  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/armor", 100);
  set_temp("apply/damage", 100);

  setup();

}

void start_shutdown() {
  if (geteuid(previous_object()) != ROOT_UID) return;

  message("system",
    HIW "《侠客英雄传-欢乐天地》将在三分钟后重新启动（ＲＥＢＯＯＴ）。\n\n" NOR,
    users());
  call_out("countdown", 60, 3);
}

private void countdown(int min) {
  min--;
  if (min) {
    message("system",
      HIR "\t\t《侠客英雄传-欢乐天地》在" + chinese_number(min) + "分钟后重新启动（ＲＥＢＯＯＴ）！\n\n",
      users());
    call_out("countdown", 60, min);
  } else {
    message("system",
      HIW "《侠客英雄传-欢乐天地》重新启动（ＲＥＢＯＯＴ）．．．\n",
      users());
    call_out("do_shutdown", 1);
  }
}

private void do_shutdown() {
  shutdown(0);
}

void unconcious() {
  return;
}
void die() {
  return;
}
