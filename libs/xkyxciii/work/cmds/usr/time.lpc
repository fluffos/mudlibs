// time.c

#include <localtime.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  mixed *t;
  t = localtime(time());
  write("现在是公历" + chinese_number(t[LT_MON] + 1) + "月" + chinese_number(t[LT_MDAY])
    + "日" + chinese_number(t[LT_HOUR]) + "时" + chinese_number(t[LT_MIN])
    + "分" + chinese_number(t[LT_SEC]) + "秒（"
    +sprintf("%d-%d-%d %d:%d:%d", t[LT_YEAR], t[LT_MON] + 1, t[LT_MDAY],
      t[LT_HOUR], t[LT_MIN], t[LT_SEC])
    + "）。\n");
  write("      游戏" + NATURE_D->game_time() + "。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：time          显示现在的时辰

HELP
  );

  return 1;
}
