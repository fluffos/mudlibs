// title.c
// 更新于 1999-02-26

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str) {
  object ob;

  seteuid(getuid(me));

  if (!str)
    ob = me;
  else if (wizardp(me)) {
    ob = present(str, environment(me));
    if (!ob) ob = find_player(str);
    if (!ob) ob = find_living(str);
    if (!ob) return notify_fail("你要察看谁的头衔？\n");
  } else
    return notify_fail("只有巫师能察看别人的头衔。\n");

  write((ob == me ? "\n你" : "\n" + ob->name()) + "目前的头衔是：\n\n");
  printf(BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(ob), ob->short(1));
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: title or title <id>
 
显示你或者目标目前的阶级和头衔。
 
HELP
  );
}
