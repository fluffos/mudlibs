// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string file;

	seteuid(geteuid(me));
    	if (!arg) return help(me);
	file = resolve_path(me->query("cwd"), arg);
	if( file_size(file)<0 ) return notify_fail("没有这个档案。\n");
	tail(file);

        file = resolve_path(me->query("cwd"), file);
        if( !sscanf(file, "%*s.lpc") ) file += ".lpc"; 
        log_file( "wiz_log/CHECK_FILE", sprintf("%s(%s) check %s at (%s)\n", me->query("name"), me->query("id"), file, ctime(time()) ));

	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : tail <文件名>

直接读取某文件最末尾的几行。
HELP
    	);

    	return 1;
}
