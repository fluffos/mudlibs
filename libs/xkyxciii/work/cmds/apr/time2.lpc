// time2.c (新的系统查询指令)

inherit F_CLEAN_UP;
#include <ansi.h>
// This command is also called by LOGIN_D, so we don't want it use 
// arguments.
int main()
{
	int t, d, h, m, s;
	string time;

	t = uptime();
	s = t % 60;		t /= 60;
	m = t % 60;		t /= 60;
	h = t % 24;		t /= 24;
	d = t;

	if(d) time = chinese_number(d) + "天";
	else time = "";

	if(h) time += chinese_number(h) + "小时";
	if(m) time += chinese_number(m) + "分";
	time += chinese_number(s) + "秒 \n";

	write( "\n"+MUD_NAME+"已经运行了" + time );
	write( "系统已经运行了" + (uptime()) + "秒\n\n" );
	write( "现在是" + NATURE_D->game_time() + "。\n" );
	write( "系统当前用以运算的时间：" + (time()) + "\n\n" );
	write( "系统当前时间：" + ctime(time()) + "\n" );
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : time2
 
这个指令告诉你这个MUD的时间系统的相关信息。
 
HELP
    );
    return 1;
}
