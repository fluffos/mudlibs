// sleep.c

inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string arg)
{
        object *list, env;
        int i, flag;

        if( arg && arg != "" ) return 0;

        if( me->query_temp("sleeping") ) return notify_fail("你现在正躺着呢。\n");

        env = environment(me);
        if( env->query("restrict_action") ) 
                return notify_fail("这里不能做这件事情。\n");

        if( me->is_fighting() ) return notify_fail("你现在正在战斗。\n");

        flag = 0;
        list = all_inventory(me);
        i = sizeof(list);  
        while ( i-- ) 
                if ((string)list[i]->query("id") == "sleepbag") flag = 1;

        if(environment(me)->query("valid_sleep") )
                message_vision("$N往下一躺，不一会儿就进入了梦乡。\n",me);
        else {
                if( flag == 1 ) {
                        if( me->query("combat_exp") < 15000 ) {
                                message_vision("$N展开一只睡袋，钻了进去，不一会儿就进入了梦香。\n", me);
                        }
                        else {
                                tell_object(me, "唉....真没用！你现在还需要睡袋吗？\n");
                                return 0;
                        }
                }
                else {
                        // 注释的原因：与emote-sleep冲突。
                        // tell_object(me, "这里不是你睡觉的地方！\n");
                        // return 0;
                        return notify_fail("这里不是你睡觉的地方！\n");
                }
        }

        me->sleep();
        return 1;
}

int help()
{
        write(@HELP
指令格式：sleep

这条命令可以使你很快恢复体力。
HELP
        );
        return 1;
}