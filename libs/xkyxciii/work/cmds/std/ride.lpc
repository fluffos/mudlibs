// ride.c

#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
        object ob, *inv;
        int i, flag, total;

        if( me->query_temp("sleeping") ) return notify_fail("你现在正躺着呢。\n");

        if( !arg ) return help( me );

        if( !objectp(ob = present(arg, me)) )
                return notify_fail("你身上没有这样东西。\n");

        if( !mapp( ob->query("horse_prop")) )
                return notify_fail("你不能骑这样东西。\n");

        if( ob->query("equipped") )
                return notify_fail("你已经骑着坐骑了。\n");

        inv = all_inventory(me);

        total = sizeof(inv);

        for( i = 0; i < total; i++ )
                if( mapp( inv[i]->query("horse_prop")) && inv[i]->query("equipped") )
                        return notify_fail("你已经骑着坐骑了。\n");

        ob->set("equipped", "horse");
        me->set_temp("horse/horse", ob->name());        // 临时记录骑马的名字，用于Go、Look命令

        if( stringp(ob->query("ride_msg")) ) message_vision(convert_color(ob->query("ride_msg")), me, ob);
        else message_vision( YEL "$N骑上一" + sprintf("%s", ob->query("unit")) 
                + "「$n" YEL "」。\n" NOR , me, ob);

        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：ride <坐骑名称>
 
骑马。
 
HELP
        );

        return 1;
}
