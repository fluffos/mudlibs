// run.c

#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
        object *inv, ob;
        string move_path, msg;
        int i, flag, total;

        if( !arg ) return help(me);

        if( me->query_temp("sleeping") ) return notify_fail("你现在正躺着呢。\n");

        if( me->is_fighting() ) return notify_fail("你现在正在战斗！\n");

        if( me->is_busy() ) return notify_fail("你现在正忙着呢。\n");

        if(!environment(me)->query("outdoors") ) return notify_fail("在房间里不能乱跑！\n");

        if(present("mi han", me) ) return notify_fail("你身上带着密函！\n");

        switch(arg) {
                case "center":
                        move_path = "/d/center/guangchang";
                        break;
                case "beijing":
                        move_path = "/d/beijing2/square";
                        break;
                case "yangzhou":
                        move_path = "/d/yangzhou/main";
                        break;
                case "quanzhou":
                        move_path = "/d/quanzhou/main";
                        break;
                case "taishan":
                        move_path = "/d/taishan/main-12-n1";
                        break;
                case "wudang":
                        move_path = "/d/wudangshan/wd-gc1";
                        break;
/*                case "shaolin":
                        move_path = "/d/songshan/main-15";
                        break;
                  case "huashan":
                        move_path = "/d/huashan/main-26";
                        break;
*/
                case "emei":
                        move_path = "/d/emeishan/main-24";
                        break;
                case "wuliang":
                        move_path = "/d/wuliangshan/main-01";
                        break;
                case "dali":
                        move_path = "/d/dali/roade1";
                        break;
                case "heimu":
                        move_path = "/d/heimuya/hmy-hmyx";
                        break;
                case "zhongnan":
                        move_path = "/d/zhongnanshan/main-01";
                        break;
                case "lingjiu":
                        move_path = "/d/lingjiugong/main-20";
                        break;
/*
                case "kunlun":
                        move_path = "/d/kunlunshan/main-17";
                        break;
*/
                case "guangming":
                        move_path = "/d/guangmingding/main-17";
                        break;
                default:
                        return notify_fail("你想到什么地方？\n");
        }

        inv = all_inventory(me);

        total = sizeof(inv);

        for( i = 0, flag = 0; i < total; i ++ ) {
                if( mapp( inv[i]->query("horse_prop")) && inv[i]->query("equipped") ) {
                        flag = 1;
                        break;
                }
        }
        if( !flag ) return notify_fail("你没有坐骑！\n");
        ob = inv[i];    

        if(ob->query("horse_prop/life") <= 0) return notify_fail("你的坐骑已经累得不能动了！\n");

        if( stringp(msg = me->query("env/msg_mgo")) )
                message_vision( msg + "\n", me);
        else
                message_vision("$N骑着「" + ob->name() + NOR "」匆匆忙忙地离开了。\n", me);

        me->move(move_path);

        if( stringp(msg = me->query("env/msg_mcome")) )
                message_vision(msg + "\n", me);
        else
                message_vision("只见你眼前一亮，$N骑着「" + ob->name() + NOR "」出现在大家的眼前。\n", me);

        me->receive_damage("sen", 10);

        ob->set("horse_prop/life", ob->query("horse_prop/life") - 1);   
/*
        if(ob->query("horse_prop/life") <= 0) {
                message_vision(WHT "$N的「" + ob->name() + WHT "」由于劳累过度，终于死掉了。\n" NOR, me);
                inv = all_inventory(ob);
                total = sizeof(inv);
                for( i = 0; i < total; i ++ ) inv[i]->move(me);
                destruct(ob);
                return 1;
        }
*/
        if(ob->query("horse_prop/life") <= 5) {
                tell_object(me, WHT "你的「" + ob->name() + WHT"」已经很劳累了。\n" NOR);
        }

        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : run <地点>

利用坐骑到达某个地点。目前可以利用坐骑去的地方有：
center  : 侠客城        beijing : 北  京        yangzhou: 扬  州
quanzhou: 泉  州        dali    : 大  理        wudang  : 武当山
huashan : 华  山        taishan : 泰  山        zhongnan: 终南山
emei    : 峨眉山        wuliang : 无量山        lingjiu : 灵鹫宫
heimu   : 黑木崖       guangming: 光明顶        
HELP
        );

        return 1;
}
 
