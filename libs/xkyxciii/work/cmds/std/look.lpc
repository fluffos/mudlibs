int look_room(object me, object env);
int look_item(object me, object obj);
int look_living(object me, object obj);
int look_room_item(object me, string arg);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object obj;
  int result;

  if (me->query_temp("sleeping")) return notify_fail("你现在正躺着呢。\n");

  if (!arg) result = look_room(me, environment(me));
  else if ((obj = present(arg, me)) || (obj = present(arg, environment(me)))) {
    if (obj->is_character()) result = look_living(me, obj);
    else result = look_item(me, obj);
  } else result = look_room_item(me, arg);

  return result;
}

int look_room(object me, object env) {
  int i;
  object *inv;
  mapping exits;
  string str, *dirs;

  mixed *mLocal;
  int t, iSize, iLight;

  if (!env) {
    write("你的四周灰蒙蒙地一片，什麽也没有。\n");
    return 1;
  }

  str = sprintf("%s - %s%s%s%s",
    (me->query_temp("skip_long")) ? "" : env->query("short"),
    wizardp(me) ? file_name(env) : "",
    (me->query_temp("skip_long")) ? "" : "\n",
    (me->query_temp("skip_long")) ? "" : env->query("long"),
    env->query("outdoors") ? NATURE_D->outdoor_room_description(env) : "");
  me->delete_temp("skip_long");   //skip_long is set in /feature/move.c

  if (mapp(exits = env->query("exits"))) {
    dirs = keys(exits);
    for (i = 0; i < sizeof(dirs); i++)
      if ((int)env->query_door(dirs[i], "status") & DOOR_CLOSED)
        dirs[i] = 0;
    dirs -= ({ 0 });
    if (sizeof(dirs) == 0)
      str += "    这里没有任何明显的出路。\n";
    else if (sizeof(dirs) == 1)
      str += "    这里唯一的出口是 " + BOLD + dirs[0] + NOR + "。\n";
    else
      str += sprintf("    这里明显的出口是 " + BOLD + "%s" + NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
        implode(dirs[0..sizeof(dirs) - 2], "、"), dirs[sizeof(dirs) - 1]);
  }
  // str += env->door_description();

  // Micro : 加入晚上和夜间之判断

  mLocal = localtime(time() * 60);
  t = mLocal[2] * 60 + mLocal[1];
  if ((t < 240 || t > 1260) && env->query("outdoors")) {

    // 判断自己身上有无点燃的东西
    iLight = 0;
    inv = all_inventory(me);
    for (i = 0, iSize = sizeof(inv); i < iSize; i++) {
      if (iLight || inv[i]->query("light")) {
        iLight = 1;
        break;
      }
    }

    // 判断身边地上有无点燃的东西
    inv = all_inventory(env);
    for (i = 0, iSize = sizeof(inv); i < iSize; i++) {
      if (iLight || inv[i]->query("light")) {
        iLight = 1;
        break;
      }
    }

    // 晚上且无点燃的东西，将户外之景色设为深蓝
    if (!iLight) {
      str = BLU + str;
      str = replace_string(str, NOR, NOR BLU);
    }
  }

  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (inv[i]->query("no_shown")) continue;  // key 加于 1998.3.19
    if (!me->visible(inv[i])) continue;
    str += "  " + inv[i]->short() + "\n";
  }

  // Micro: 99-02-08 太费资源
  // write( convert_color(str) );
  write(str);
  return 1;
}

int look_item(object me, object obj) {
  mixed *inv;
  string prep;

  // Micro: 99-02-08 太费资源
  // write( convert_color( obj->long() ) );
  write(obj->long());

  inv = all_inventory(obj);
  if (!obj->is_closed() && sizeof(inv)) {
    switch ((string)obj->query("prep")) {
      case "on":
        prep = "上";
        break;
      case "under":
        prep = "下";
        break;
      case "behind":
        prep = "后";
        break;
      case "inside":
        prep = "里";
        break;
      default:
        prep = "里";
        break;
    }
    inv = map_array(inv, "inventory_look", this_object());
    message("vision", sprintf("%s面有：\n  %s\n", prep,
      implode(inv, "\n  ")), me);
  }

  return 1;
}

int look_living(object me, object obj) {
  mixed *inv;
  mapping my_fam, fam;
  object weapon;
  string lookgender;
  string str, limb_status, pro, skill_type;
  int attack_points, dodge_points, parry_points;
  int skills, per, i, j, total;

  if (me != obj)
    message("vision", me->name() + "正盯着你看，不知道打些什么主意。\n", obj);

  str = obj->long();
  // add by chance, 面具也要改变性别。并且把所有的 query("gender") 变成了  lookgender
  if (!stringp(lookgender = obj->query_temp("apply/gender")))
    lookgender = obj->query("gender");

  pro = (obj == me) ? gender_self(lookgender) : gender_pronoun(lookgender);

#echo 3
  if ((string)obj->query("race") == "人类"
    && intp(obj->query_age()))
    // str += sprintf("%s看起来约%s多岁。\n", pro, CHINESE_D->chinese_number(obj->query_age() / 10 * 10));
    str += sprintf(
      "%s是%s的子民，看起来约%s多岁。\n",
      pro,
      obj->query("national"),
      CHINESE_D->chinese_number(obj->query_age() / 10 * 10)
    );
  per = (obj->query_per() - 11);
  if (per < 0) per = 0;
  if (per >= sizeof(male_per)) per = sizeof(male_per) - 1;
  if (lookgender == "男性" && per >= 0)
    str += sprintf("%s生得%s\n", pro, male_per[per]);
  if (lookgender == "女性" && per >= 0)
    str += sprintf("%s生得%s\n", pro, female_per[per]);

  if (wizardp(me) || !userp(obj) || obj == me) {         // 除巫师外只能看到自己或者NPC的武功等级
    if (objectp(weapon = obj->query_temp("weapon")))
      skill_type = weapon->query("skill_type");
    else
      skill_type = "unarmed";
    attack_points = COMBAT_D->skill_power(obj, skill_type, SKILL_USAGE_ATTACK);
    parry_points = COMBAT_D->skill_power(obj, skill_type, SKILL_USAGE_DEFENSE);
    dodge_points = COMBAT_D->skill_power(obj, "dodge", SKILL_USAGE_DEFENSE);
    skills = pow(attack_points + 1.0, 1.0 / 4) * sizeof(tough_level_desc) / 26.5;      // pow( 500000, 1.0 / 4 ); 
    if (skills < 0) skills = 0;
    if (skills >= sizeof(tough_level_desc)) skills = sizeof(tough_level_desc) - 1;
    str += sprintf("%s武功看起来好象%s。\n", pro, tough_level_desc[skills]);
  }

  // If we both has family, check if we have any relations.
  if (obj != me
    && mapp(fam = obj->query("family"))
    && mapp(my_fam = me->query("family"))
    && fam["family_name"] == my_fam["family_name"]) {

    if (fam["generation"] == my_fam["generation"]) {
      if ((string)obj->query("gender") == "男性")
        str += sprintf(pro + "是你的%s%s。\n",
          my_fam["master_id"] == fam["master_id"] ? "" : "同门",
          my_fam["enter_time"] > fam["enter_time"] ? "师兄" : "师弟");
      else
        str += sprintf(pro + "是你的%s%s。\n",
          my_fam["master_id"] == fam["master_id"] ? "" : "同门",
          my_fam["enter_time"] > fam["enter_time"] ? "师姐" : "师妹");
    } else if (fam["generation"] < my_fam["generation"]) {
      if (my_fam["master_id"] == obj->query("id"))
        str += pro + "是你的师父。\n";
      else if (my_fam["generation"] - fam["generation"] > 1)
        str += pro + "是你的同门长辈。\n";
      else if (fam["enter_time"] < my_fam["enter_time"])
        str += pro + "是你的师伯。\n";
      else
        str += pro + "是你的师叔。\n";
    } else {
      if (fam["generation"] - my_fam["generation"] > 1)
        str += pro + "是你的同门晚辈。\n";
      else if (fam["master_id"] == me->query("id"))
        str += pro + "是你的弟子。\n";
      else
        str += pro + "是你的师侄。\n";
    }
  }

  if (obj->query("max_kee"))
    str += pro + COMBAT_D->eff_status_msg((int)obj->query("eff_kee") * 100 / (int)obj->query("max_kee")) + "\n";

  message("vision", str, me);

  inv = all_inventory(obj);
  if (total = sizeof(inv)) {
    if (!obj->is_corpse()) {
      if (sizeof(obj->query_temp("armor"))) {
        message("vision", pro + "身上装备着：", me);
        for (i = 0, j = 0; i < total; i++) {
          if (mapp(inv[i]->query("armor_prop"))
            && !mapp(inv[i]->query("weapon_prop"))
            && inv[i]->query("equipped")) {
            if (j >= 2) { j = 0; printf("\n              "); }
            j++;
            printf(((inv[i]->query_amount()) ?
              CHINESE_D->chinese_number(inv[i]->query_amount())
              +inv[i]->query("base_unit") : "")
              +inv[i]->name()
              + " (" + inv[i]->query("id") + ") ；");
          }
        }
        printf("\n");
      } else message("vision", pro + "身上赤裸裸的，什么也没有穿。\n", me);
      if (obj->query_temp("weapon")) {
        message("vision", pro + "手里装备着：", me);
        for (i = 0; i < total; i++)
          if (mapp(inv[i]->query("weapon_prop")) && inv[i]->query("equipped"))
            printf(((inv[i]->query_amount()) ?
              CHINESE_D->chinese_number(inv[i]->query_amount())
              +inv[i]->query("base_unit") : "")
              +inv[i]->name()
              + " (" + inv[i]->query("id") + ") ；");
        printf("\n");
      }
      if (mapp(obj->query_temp("horse"))) {
        message("vision", pro + "正  骑  着：", me);
        for (i = 0; i < total; i++)
          if (mapp(inv[i]->query("horse_prop")) && inv[i]->query("equipped"))
            printf("一" + inv[i]->query("unit") + inv[i]->name()
              + " (" + inv[i]->query("id") + ") ；\n");
      }
    } else {
      inv = map_array(inv, "inventory_look", this_object(), obj->is_corpse() ? 0 : 1);
      inv -= ({ 0 });
      if (sizeof(inv)) {
        str = sprintf(obj->is_corpse() ? "%s的遗物有：\n%s\n" : "%s身上带着：\n%s\n",
          pro, implode(inv, "\n"));
        message("vision", str, me);
      }
    }
  }

  if (obj != me
    && living(obj)
    && random((int)obj->query("bellicosity") / 10) > (int)me->query("per")) {
    write(obj->name() + "突然转过头来瞪你一眼。\n");
    COMBAT_D->auto_fight(obj, me, "berserk");
  }

  return 1;
}

string inventory_look(object obj, int flag) {
  string str;

  str = obj->short();
  if (obj->query("equipped"))
    str = HIC "  □" NOR + str;
  else if (!flag)
    str = "    " + str;
  else
    return 0;

  return str;
}

int look_room_item(object me, string arg) {
  object env;
  mapping item, exits;

  if (!objectp(env = environment(me)))
    return notify_fail("这里只有灰蒙蒙地一片，什麽也没有。\n");

  if (mapp(item = env->query("item_desc")) && !undefinedp(item[arg])) {
    if (stringp(item[arg]))
      write(item[arg]);
    // write( convert_color( item[arg] ) );
    else if (functionp(item[arg]))
      write((string)(* item[arg])(me));
    // write( convert_color( (string)(*item[arg])(me) ) );

    return 1;
  }
  if (mapp(exits = env->query("exits")) && !undefinedp(exits[arg])) {
    if (objectp(env = find_object(exits[arg])))
      look_room(me, env);
    else {
      call_other(exits[arg], "???");
      look_room(me, find_object(exits[arg]));
    }
    return 1;
  }
  return notify_fail("你要看什麽？\n");
}

int help(object me) {
  write(@HELP
指令格式: look [<物品>|<生物>|<方向>]
 
这个指令让你查看你所在的环境、某件物品、生物、或是方向。
 
HELP
  );
  return 1;
}
