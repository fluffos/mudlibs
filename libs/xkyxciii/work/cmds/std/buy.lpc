inherit F_CLEAN_UP;

int main(object me, string arg) {
  string item, targ;
  object ob, owner, g, s, c;
  int price, afford, num = 1, total;

  if (me->query_temp("sleeping")) return notify_fail("你现在正躺着呢。\n");

  if (!arg || sscanf(arg, "%s from %s", item, targ) != 2) {
    if (arg) {
      item = arg;
      targ = "waiter";
    } else
      return notify_fail("指令格式：buy [数量] <某物> [from <某人>]\n");
  }

  if (sscanf(item, "%d %s", num, item) == 2) {
    if (num < 1) return notify_fail("一次买东西的个数最少应为1。\n");
    if (num > 10) return notify_fail("你买这么多东西做什么？\n");
  } else num = 1;

  if (!objectp(owner = present(targ, environment(me))))
    return notify_fail("你要跟谁买东西？\n");

  if (sizeof(all_inventory(me)) >= 50)
    return notify_fail("你身上的东西已经超过五十个啦。\n");

  if (userp(owner)) {
    message_vision("$N想向$n购买「" + item + "」。\n", me, owner);
    return 1;
  }
  reset_eval_cost();

  //        notify_fail("对方好像不愿意跟你交易。\n");
  notify_fail("对方好像没有你所要的东西。\n");
  if ((price = owner->buy_object(me, item)) < 1) return 0;

  if (MONEY_D->can_afford(me, num * price)) {
    MONEY_D->player_pay(me, num * price);
    for (total = 0; total < num; total++) owner->compelete_trade(me, item);
    return 1;
  } else
    return notify_fail("你的钱不够。\n");
}

int help(object me) {
  write(@HELP
指令格式: buy <something> from <someone>

这一指令让你可以从某些人身上买到物品。
HELP
  );
  return 1;
}
