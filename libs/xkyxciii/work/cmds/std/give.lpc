// give.c

#include <move.h>

inherit F_CLEAN_UP;

int can_give(object me, object obj, object who);
int do_give(object me, object obj, object who);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string target, item;
  object obj, who, *inv, obj2;
  int i, amount;

  if (me->query_temp("sleeping")) return notify_fail("你现在正躺着呢。\n");

  if (!arg) return notify_fail("你要给谁什麽东西？\n");

  if (sscanf(arg, "%s to %s", item, target) == 2
    || sscanf(arg, "%s %s", target, item) == 2);
  else return notify_fail("你要给谁什麽东西？\n");

  if (!objectp(who = present(target, environment(me))) || !living(who))
    return notify_fail("这里没有这个人。\n");
  if (me == who) return notify_fail("自己给自己东西？不嫌累吗？\n");

  if (query_ip_name(me) == query_ip_name(who) && !wizardp(me))
    return notify_fail("请多看一看游戏规则！下不为例！\n");

  if (sscanf(item, "%d %s", amount, item) == 2) {
    if (!objectp(obj = present(item, me)))
      return notify_fail("你身上没有这样东西。\n");
    if (obj->query("no_drop"))
      return notify_fail("这样东西不能随便给人。\n");
    if (!obj->query_amount())
      return notify_fail(obj->name() + "不能被分开给人。\n");
    if (amount < 1)
      return notify_fail("东西的数量至少是一个。\n");
    if (amount > obj->query_amount())
      return notify_fail("你没有那麽多的" + obj->name() + "。\n");
    else if (amount == (int)obj->query_amount()) {
      if (!can_give(me, obj, who)) return 0;
      return do_give(me, obj, who);
    } else {
      obj->set_amount((int)obj->query_amount() - amount);
      obj2 = new(base_name(obj));
      obj2->set_amount(amount);
      if (!can_give(me, obj2, who)) {
        obj->set_amount(obj->query_amount() + obj2->query_amount());
        destruct(obj2);
        return 0;
      }
      if (obj->query_amount() <= 0) destruct(obj);
      return do_give(me, obj2, who);
    }
  }

  if (arg == "all") {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      if (!can_give(me, inv[i], who)) continue;
      do_give(me, inv[i], who);
    }
    write("Ok.\n");
    return 1;
  }

  if (!objectp(obj = present(item, me)))
    return notify_fail("你身上没有这样东西。\n");

  if (!can_give(me, obj, who)) return 0;
  return do_give(me, obj, who);
}

int do_give(object me, object obj, object who) {
  if (obj->query("no_transfer")) {
    obj->set("no_get", 1);
    obj->set("no_put", 1);
    obj->set("no_drop", 1);
  }


  if (userp(me) && userp(who) && obj->query("money_id") && obj->value() >= 10000) {
    log_file("GIVE_LOG", sprintf("%s %s（%s）在%s给%s（%s）一%s（%d）%s。\n",
      ctime(time()), me->query("name"), me->query("id"),
      (stringp(environment(me)->query("short"))) ?
      environment(me)->query("short") : environment(me)->query("name"),
      who->query("name"), who->query("id"),
      obj->query("unit"), obj->query_amount(), obj->name()));
  }


  if (!userp(who)) {
    message_vision("$N拿出" + obj->short() + "给$n。\n", me, who);
    destruct(obj);
    return 1;
  } else if (obj->move(who)) {
    tell_object(me, sprintf("你给%s一%s%s。\n",
      who->name(), obj->query("unit"), obj->name()));
    message("vision", sprintf("%s给你一%s%s。\n", me->name(),
      obj->query("unit"), obj->name()), who);
    message("vision", sprintf("%s给%s一%s%s。\n", me->name(), who->name(),
      obj->query("unit"), obj->name()), environment(me), ({ me, who }));
    return 1;
  } else return 0;
}

int can_give(object me, object obj, object who) {

  // 不能将玩家给npc
  if (userp(obj) && !userp(who)) return notify_fail("你不能给他这样东西！\n");

  if (sizeof(all_inventory(obj)) >= MAX_CARRY)
    return notify_fail(obj->name() + "身上的东西已经太多啦。\n");

  if (obj->query("no_drop"))
    return notify_fail("这样东西不能随便给人。\n");
  /*
        if( present( "banker", environment(me) ) && stringp(obj->query("money_id")) ) 
                return notify_fail("旁边的人正睁大眼睛盯着你手中的钱！\n");
*/
  if (!interactive(who) && !who->accept_quest_object(me, obj))
    if (!interactive(who) && !who->accept_object(me, obj))
      return notify_fail("你只能把东西送给其他玩家操纵的人物。\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：give <物品名称> to <某人>
      或：give <某人> <物品名称>
 
这个指令可以让你将某样物品给别人, 当然, 首先你要拥有这样物品.
 
HELP
  );

  return 1;
}
