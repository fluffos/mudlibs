#include <skill.h>

inherit F_CLEAN_UP;

int help(object me);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object ob, env;
  mapping skill;
  string skill_name;
  int n, cost, inc, skl, times, study_factor, study_bonus;

  if (me->query_temp("sleeping")) return notify_fail("你现在正躺着呢。\n");

  env = environment(me);
  if (env->query("restrict_action"))
    return notify_fail("这里不能做这件事情。\n");

  if (me->is_busy()) return notify_fail("你正忙着呢！\n");

  if (me->is_fighting()) return notify_fail("你无法在战斗中专心下来研读新知！\n");

  if (!arg) return help(me);

  if (sscanf(arg, "%d %s", times, arg) == 2) {
    if (times < 1) return notify_fail("最少要读一次。\n");
  } else times = 1;

  if (times > 100) return notify_fail("你读那么多次干什么？\n");

  if (!objectp(ob = present(arg, me))) return notify_fail("你要读什麽？\n");

  if (!mapp(skill = ob->query("skill")))
    return notify_fail("你无法从这样东西学到任何东西。\n");

  if (!me->query_skill("literate", 1))
    return notify_fail("你是个文盲，先学学读书识字(literate)吧。\n");

  message("vision", me->name() + "正专心地研读" + ob->name() + "。\n", environment(me), me);

  skill_name = skill["name"];
  if (skill["mapp_skill"] && me->query_skill_mapped(skill["name"]))
    skill_name = me->query_skill_mapped(skill["name"]);

  skl = me->query_skill(skill_name, 1);
  if (skill["name"] == "literate") skl = 0;

  //        n = 20 - (int)(skl / 10);
  if (((int)me->query("combat_exp") < skill["exp_required"])
    //
    //        ||      ((int)me->query("combat_exp") < (skl * skl * skl / ( (n <= 0) ? 1 : ( n >= 10 ) ? 10 : n )  
    //                * ( (int)SKILL_D(skill["name"])->enable_factor() >= 100 ? (int)SKILL_D(skill["name"])->enable_factor() : 100 )
    //                / 100) ) ) {

    // 限制到 10 - 150 要 exp : 2000 - 6750000
    || (skl * skl * skl) * (int)SKILL_D(skill["name"])->enable_factor() / 100 >
    (int)me->query("combat_exp")) {

    write("你的实战经验不足，再怎麽读也没用。\n");
    return 1;
  }

  notify_fail("以你目前的能力，还没有办法学这个技能。\n");
  if (!SKILL_D(skill_name)->valid_learn(me) && skill_name != "pixie-jian") return 0;

  cost = skill["sen_cost"] + skill["sen_cost"] * (skill["difficulty"] - (int)me->query_int()) / 20;
  if (cost < 1) cost = 1;
  cost *= times;
  if ((int)me->query("sen") < cost) {
    write("以你现在的水平，读不了那么多次。\n");
    return 1;
  }

  if (me->query_skill(skill_name, 1) > skill["max_skill"]) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }

  me->receive_damage("sen", cost);
  /*
        inc =   ( (int)me->query("int") - (int)( me->query_skill("literate", 1) / 10 ) ) / 5
                + (int)me->query("combat_exp") / 10000 
                + (int)( me->query_skill("literate", 1) / 10 ) ;
        if(!(study_bonus = SKILL_D(skill_name)->study_bonus()) ) inc += study_bonus;
*/
  inc = (int)me->query("combat_exp") / 10000;
  if (inc > 10) inc = 10;
  inc = inc + (int)me->query_int() + (int)(me->query_skill("literate", 1) / 10);
  n = SKILL_D(skill_name)->study_bonus();
  if (n == 0) n = 100;
  inc = inc * 100 / n / 10;    //         inc *= 100 / n;

  if (inc < 1) inc = 1;

  //      if(environment(me)->query("valid_exercise") || present("jingang zhao", me) ) inc += inc;

  inc *= times;
  if (!(study_factor = SKILL_D(skill_name)->study_factor()))
    study_factor = 100;
  inc = inc * study_factor / 100;

  if (!me->query_skill(skill_name, 1))
    me->set_skill(skill_name, 0);
  me->improve_skill(skill_name, inc);
  write("你研读有关" + to_chinese(skill_name) + "的技巧，似乎有点心得。\n");
  /*
        me->add_temp("studying_book", times);
        if((int)me->query_temp("studying_book") >= 10) {
                me->start_busy(1);
                me->add_temp("studying_book", -10);
        }
*/
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：study [次数] <物品名称>

这个指令使你可以从秘笈或其他物品自学某些技巧，但前提是：你不能是个『文盲』。

参考命令：learn。
HELP
  );

  return 1;
}
