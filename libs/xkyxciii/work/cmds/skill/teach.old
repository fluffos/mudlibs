// teach.c
// 修改：大鱼（Chance）----cn_chance@163.net

#include <skill.h>

inherit F_CLEAN_UP;


int help(object me);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
        object ob, *list , couple_ob, env;
        string skill, student, master;
        string target, cardname;
        int master_skill, student_skill;
        int i;

        if( me->query_temp("sleeping") ) return notify_fail("你现在正躺着呢。\n");

        env = environment(me);
        if( env->query("restrict_action") ) 
                return notify_fail("这里不能做这件事情。\n");

        if( me->is_fighting() ) return notify_fail("临阵磨枪？来不及啦。\n");
        if (!arg || arg=="")    return help(me);

        if(!arg || sscanf(arg, "%s to %s", skill, student)!=2 ) return help(me);

        if( !(ob = present(student, environment(me))) || !userp(ob))
                return notify_fail("你要教谁武功？\n");

        if( !living(ob) ) return notify_fail("嗯....你得先把" + ob->name() + "弄醒再说。\n");

        if( ob == me ) return notify_fail("你想向自己请教？\n");

        if( me->query("faction/name") != ob->query("faction/name") )
                 return notify_fail ("看清楚一点，他是你的兄弟吗？\n");
        if(me->query("faction/generation")>5) 
                 return notify_fail ("只有帮中长老以上职务的才能教其他兄弟武功。\n"); 
        if(me->query("faction/generation") > ob->query("faction/generation"))
                 return notify_fail ("对方的职位比你还要高。\n");

        if( !master_skill = me->query_skill(skill, 1) )
                return notify_fail ("你会这种武功吗？\n");
        student_skill = ob->query_skill(skill, 1);
        if(student_skill>=master_skill) 
                return notify_fail ("对方的武功似乎不比你差。\n");
        if( (int)ob->query("learned_points") >= (int)ob->query("potential") )
                return notify_fail ("对方的潜能已经发挥到极限了，没有办法再成长了。\n");
        if((master_skill * master_skill * master_skill) * (int)SKILL_D(skill)->enable_factor() / 150  >
                        (int)me->query("combat_exp") ) 
                return notify_fail ("你的实战经验不足以指点这种武功。\n");
        if((student_skill * student_skill * student_skill) * (int)SKILL_D(skill)->enable_factor() / 150  >
                        (int)ob->query("combat_exp") ) 
               {
                tell_object(ob,"由于你的实战经验不足，你对"+me->name()+"的指教一点都没有领会到。\n");
                return notify_fail ("由于对方的实战经验不足，他对你的指教一点都没有领会到。\n");
               }



        message_vision("$N向$n指点了有关「"+to_chinese(skill)+"」的疑问。\n", me,ob,) ;
        if (master_skill<=2)
            me->delete_skill(skill);
        else  
            me->set_skill(skill,master_skill-2);
        ob->set_skill(skill,student_skill+1);
        i=(master_skill * master_skill * master_skill) * 
             (int)SKILL_D(skill)->enable_factor() / 150 -
          (master_skill-1) * (master_skill-1) * (master_skill-1) * 
             (int)SKILL_D(skill)->enable_factor() / 150 ;
        if(i<10000) i=10000;
        me->add("combat_exp",-i);
        i=student_skill*student_skill/15+1;
        if (i<1) i=1;
        ob->add("learned_points",i);       
        return 1;
}


int help(object me)
{
        write(@HELP
指令格式：teach <技能> to <某人>

当帮中的下属为本帮立下功劳时，帮中辈分高的长辈可以用 teach 教会
他一种武功作为奖励。当然，你在这项技能上的造诣必须比对方高，而对方
也必需要有足够的经验才能学会这种武功。

由于是一种奖励手段，所以把学习的过程略去了。就是说学武功的对象一下
子就可以学会这种武功，不用慢慢的等升级。但是，教武功的人，经验和
武功都会减少。所以要慎用。

HELP
        );

        return 1;
}
 
