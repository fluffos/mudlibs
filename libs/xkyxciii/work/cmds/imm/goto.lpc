// goto.c

inherit F_CLEAN_UP;

int main(object me, string arg, string file, string str)
{
	int goto_inventory = 0;
        object obj, ob, where_me, where_ob;
        string msg, ll_me, ll_ob;

        where_me = environment(me);
        ll_me = (string)file_name(where_me);

	if( !arg ) return notify_fail("你要去哪里？\n");

	if( sscanf(arg, "-i %s", arg) ) goto_inventory = 1;

	if( !arg ) return notify_fail("你要去哪里？\n");

	obj = find_player(arg);
	if(!obj) obj = find_living(arg);
	if(!obj || !me->visible(obj)) {
		arg = resolve_path(me->query("cwd"), arg);
		if( !sscanf(arg, "%*s.lpc") ) arg += ".lpc";
		if( !(obj = find_object(arg)) ) {
			if( file_size(arg)>=0 )
				return me->move(arg);
			return notify_fail("没有这个玩家、生物、或地方。\n");
		}
	}

	if(!goto_inventory && environment(obj))
		obj = environment(obj);
		ll_ob = (string)file_name(obj);
	if( !obj ) return notify_fail("这个物件没有环境可以 goto。\n");

    if( stringp(msg = me->query("env/msg_mout")) )
        message_vision(msg+"\n", me);
	else
		message_vision("你眼前一花，$N的身影已经不见了。\n", me);

	me->move(obj);

	if( stringp(msg = me->query("env/msg_min")) )
        message_vision(msg+"\n", me);
	else
		message_vision("你眼前一花，$N的身影出现在面前。\n", me);

                log_file( "wiz_log/GOTO_LOG", sprintf("(%s)\n%s 由 (%s) goto (%s)\n", ctime(time()), me->query("id"), ll_me, ll_ob ));
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : goto [-i] <目标>
 
传送到指定的目标。目标可以是一个生物体或者房间的文件名。
如果目标是生物体，你会被移到跟那个人同样的环境。
如果有加上 -i 参数且目标是生物体，则你会被移到该生物体的身上。
 
HELP
    );
    return 1;
}

