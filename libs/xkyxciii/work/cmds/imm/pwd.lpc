// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if( !arg ) {
		write("Cwd: " + (string)me->query("cwd") +  "\n");
		write("Cwf: " + (string)me->query("cwf") +  "\n");
		return 1;
	}
}

int help(object me)
{
	write(@HELP
指令格式：pwd

显示当前的工作目录（cwd）及工作文件（cwf）。 
update 不加参数时便会更新你的 cwf。
 
HELP
    	);

    	return 1;
}
