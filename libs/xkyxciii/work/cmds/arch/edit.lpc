#include "/doc/help.h"

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string file)
{
	if( !file ) return help(me);

	if( in_edit(me) ) return notify_fail("你已经在使用编辑器了。\n");

	seteuid(geteuid(me));
	ed(resolve_path(me->query("cwd"), file));

        file = resolve_path(me->query("cwd"), file);
        if( !sscanf(file, "%*s.lpc") ) file += ".lpc"; 
        log_file( "wiz_log/FILES_LOG",
		sprintf("%s(%s) edit %s at (%s)\n",
		me->query("name"), me->query("id"), file, ctime(time()) ));

	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：edit <文件名>, edit here

编辑文件。

HELP
    	);

	return 1;
}
