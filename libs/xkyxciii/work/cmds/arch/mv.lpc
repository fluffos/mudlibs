inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
        string src, dst;
 
        seteuid(geteuid(me));
        if (!arg || sscanf(arg, "%s %s", src, dst)!=2 ) return help(me);
 
        src = resolve_path(me->query("cwd"), src);
        dst = resolve_path(me->query("cwd"), dst);
 
        if( !rename(src, dst) ) {
		log_file( "wiz_log/FILES_LOG",
			sprintf("%s(%s) move (%s) to (%s) at (%s)\n",
			me->query("name"), me->query("id"), src, dst, ctime(time()) ));
                write("搬移操作成功。\n");
	}
        else
                write("你没有足够的读写权利。\n");

        return 1;
}
 
int help(object me)
{
  	write(@HELP
指令格式 : mv <原文件名> <目标文件名>
 
文件／子目录搬移。

HELP
    	);

    	return 1;
}
 
