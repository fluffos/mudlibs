// rehash.c
// 修改：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.6

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  if (!arg) return help(me);

  if (arg[strlen(arg) - 1] != '/') arg += "/";
  if (file_size(arg) != -2) return notify_fail("找不到指定的目录！\n");

  write("更新指令表：" + arg + "\n");
  COMMAND_D->rehash(arg);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：rehash <目录名称>

更新系统内部的指令表，如果你新增或删除了某个目录下的指令，必须用
该指令更新该目录。

HELP
  );

  return 1;
}
