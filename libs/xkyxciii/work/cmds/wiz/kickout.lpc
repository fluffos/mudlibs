#include "/doc/help.h"
#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_DBASE;

int help(object me);

int main(object me, string arg) {
  string name, q_name, q_id, q_ip;
  object obj;

  if (!arg) return help(me);

  seteuid(ROOT_UID);

  obj = find_player(arg);
  if (!obj || !userp(obj)) return notify_fail("没有这个玩家。\n");
  name = obj->short(1);
  q_name = obj->name();
  q_id = obj->query("id");
  q_ip = query_ip_name(obj);

  if (me == obj) return notify_fail("你想强迫自己离线吗？不如用quit吧。\n");

  if (wiz_level(me) < wiz_level(obj))  //  || wiz_level(me) == wiz_level(obj) )
    return notify_fail("你的等级不够，不能对" + q_name + "下手。\n");

  tell_room(environment(obj), MUD_NAME + "突然出现在你面前。\n"
    +MUD_NAME + "说道：“" + q_name + "！连我也看不惯你了，滚吧！”\n"
    +MUD_NAME + "说罢将" + q_name + "踢出了系统。\n");
  catch(destruct(obj));

  if (obj) return notify_fail("你无法让这个玩家离线。\n");
  else {
    set("name", MUD_NAME);
    set("id", "smile");
    CHANNEL_D->do_channel(this_object(), "rumor", q_name + "被踢出了" + MUD_NAME + "。");
    CHANNEL_D->do_channel(this_object(), "sys", me->query("name") + "("
      +me->query("id") + ")将" + q_name + "(" + q_id + ")踢出了系统。");
    log_file("wiz_log/PLAYER_LOG",
      sprintf("%s(%s) kickout %s(%s) on %s at %s.\n\n", me->name(),
        me->query("id"), q_name, q_id, q_ip, ctime(time())));
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：kickout <玩家名>

强迫恶意的玩家离开游戏。

HELP
  );

  return 1;
}
