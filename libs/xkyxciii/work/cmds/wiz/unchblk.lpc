#include <globals.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
        object ob;
        string who, ch_name;
        
        if (!arg)  return help(object me);
                
        if (sscanf(arg, "%s %s", who, ch_name) != 2)
        {
                ch_name = "";
                if (sscanf(arg, "%s", who) != 1)  return help(object me);
        }

        if (who == "rumor")
        {
                CHANNEL_D->set_block(who, 0);
                CHANNEL_D->do_channel(me, "sys", "谣言频道被打开了。\n");
                return 1;
        }
        
        if (who == "chat")
        {
                CHANNEL_D->set_block(who, 0);
                CHANNEL_D->do_channel(me, "sys", "聊天频道被打开了。\n");
                return 1;
        }
        
        ob = LOGIN_D->find_body(who);
        if (!ob) return notify_fail("现在没有这个人。\n");
        
        if (ch_name == "" || ch_name == " " || ch_name == "all")
        {               
                if ((int)ob->query("chblk_on")) ob->delete("chblk_on");
                if ((int)ob->query("chblk_rumor")) ob->delete("chblk_rumor");
                if ((int)ob->query("chblk_chat")) ob->delete("chblk_chat");
                tell_object(me, (string)ob->query("name") + "的频道被打开了。\n");
        } else if (ch_name == "rumor")  
        {
                if ((int)ob->query("chblk_on"))
                {
                        ob->delete("chblk_on");
                        ob->set("chblk_chat", 1);
                }
                
                if ((int)ob->query("chblk_rumor")) ob->delete("chblk_rumor");
                tell_object(me, (string)ob->query("name") + "的谣言频道被打开了。\n");
        } else if (ch_name == "chat")
        {
                if ((int)ob->query("chblk_on"))
                {
                        ob->delete("chblk_on");
                        ob->set("chblk_rumor", 1);
                }
                if ((int)ob->query("chblk_chat")) ob->delete("chblk_chat");
                tell_object(me, (string)ob->query("name") + "的聊天频道被打开了。\n");
        } else 
                return help(object me);
        
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：unchblk <某人>                显示某人当前的频道状态
          unchblk <某人> <频道名>       打开某人的某个频道
          unchblk <频道名>              打开全体人员的某个频道
          
<频道名>：可以是rumor、chat或者all。

HELP
        );
        
        return 1;
}
