#include <ansi.h>
#include <dbase.h>

mapping skills;
mapping learned;
mapping skill_map;

mapping query_skills() { return mapp(skills) ? skills : ([]); }       // 传回物件的所有技能
mapping query_learned() { return mapp(learned) ? learned : ([]); }     // 传回所有技能的学习点数

// 设定技能。传入技能名称及等级，若技能的 mapping 不存在则新建立一个，
// 否则直接设入技能名称及等级。
void set_skill(string skill, int val) {
  if (!find_object(SKILL_D(skill))
    && file_size(SKILL_D(skill) + ".lpc") < 0)
    error("F_SKILL: No such skill (" + skill + ")\n");

  if (!mapp(skills)) skills = ([ skill: val ]);
  else skills[skill] = val;
}

// 删除某项技能. 连带的也会删除该项技能的学习点数
int delete_skill(string skill) {
  if (mapp(skills)) {
    map_delete(skills, skill);
    if (mapp(learned)) {
      map_delete(learned, skill);
      return undefinedp(learned[skill]);
    }
    return undefinedp(skills[skill]);
  }
  return 0;
}

// 把某项技能致能, 若第二个参数没有传入, 则取消该项致能
// This function 'map' a skill <skill> to another skill <mapped_to>.
// If 2nd argument not given, cancel the mapped skill <skill>.
varargs void map_skill(string skill, string mapped_to) {
  if (!mapped_to && mapp(skill_map)) {
    map_delete(skill_map, skill);
    return;
  }

  if (!find_object(SKILL_D(skill))
    && file_size(SKILL_D(skill) + ".lpc") < 0)
    error("F_SKILL: No such skill (" + skill + ")\n");

  if (!mapp(skills) || undefinedp(skills[mapped_to]))
    return;

  if (!mapp(skill_map)) skill_map = ([ skill: mapped_to ]);
  else skill_map[skill] = mapped_to;
}

// 传回某项技能种类所致能的技能名称
string query_skill_mapped(string skill) {
  if (mapp(skill_map) && !undefinedp(skill_map[skill]))
    return skill_map[skill];
  return 0;
}

// 传回技能的等级
varargs int query_skill(string skill, int raw) {
  if (!raw) {
    int s, level, my_true_skill;
    s = query_temp("apply/" + skill);
    if (mapp(skills)) {

      // 判断经验是否足够，以下把 skills[skill] 换为 my_true_skill
      my_true_skill = COMBAT_D->true_skill(this_object(), skill);

      // s += my_true_skill / 2;                 // 注意，这里原是除以二
      s += my_true_skill;             // 我们把基本的东西当成 enable 1.0
      if (mapp(skill_map)) {
        if (skill_map[skill])
          level = (int)(SKILL_D(skill_map[skill])->enable_factor());
        else
          level = 100;

        // 判断经验是否足够，以下把 skills[skill_map[skill]] 换为 my_true_skill
        my_true_skill = COMBAT_D->true_skill(this_object(), skill_map[skill]);

        s += my_true_skill * level / 100;
      }
    }
    return s;
  }
  if (mapp(skills) && !undefinedp(skills[skill])) return skills[skill];

  return 0;
}

// 传回技能致能的列表
mapping query_skill_map() {
  return mapp(skill_map) ? skill_map : ([]);
}

// 人物死後会呼叫这个函数以计算死亡时所造成的技能损失
int skill_death_penalty() {
  string *sk;
  int i, j, n;

  if (wizardp(this_object()) || !mapp(skills)) return 0;

  sk = keys(skills);
  for (n = 0; n < sizeof(sk) / 10 + 1; n++) {

    for (i = 0, j = 0; i < sizeof(sk); i++)
      if (skills[sk[i]] > skills[sk[j]]) j = i;

    if (!mapp(learned)) {
      skills[sk[j]]--;
      if (skills[sk[j]] < 0) map_delete(skills, sk[j]);
    } else {
      if ((int)learned[sk[j]] > (skills[sk[j]] + 1) * (skills[sk[j]] + 1) / 2)
        map_delete(learned, sk[j]);
      else {
        skills[sk[j]]--;
        if (skills[sk[j]] < 0) map_delete(skills, sk[j]);
      }
    }

    /*
        if( !mapp(learned) )
                for(i = 0; i<sizeof(sk); i++) {
                        skills[sk[i]]--;
                        if( skills[sk[i]]<0 ) map_delete(skills, sk[i]);
                }
        else
                for(i = 0; i<sizeof(sk); i++) {
                        if( (int)learned[sk[i]] > (skills[sk[i]]+1) * (skills[sk[i]]+1) / 2 )
                                map_delete(learned, sk[i]);
                        else {
                                skills[sk[i]]--;
                                if( skills[sk[i]]<0 ) map_delete(skills, sk[i]);
                        }
                }
*/
  }

  skill_map = 0;
  return 1;
}

varargs int query_skill_eff_lvl(string skill) {
  int level;
  if (mapp(skills)) {
    level = (int)(SKILL_D(skill)->effective_level());
    // for baisc skills where effecitive_level() undefined
    if (level == 0) level = 5;
    return skills[skill] * level / 10;
  }
  return 0;
}

// 增加传入技能的学习点数, 并判定是否有进步以增加等级
varargs void improve_skill(string skill, int amount, int weak_mode) {
  int spi;

  if (!find_object(SKILL_D(skill))
    && file_size(SKILL_D(skill) + ".lpc") < 0)
    error("F_SKILL: No such skill (" + skill + ")\n");

  if (!weak_mode || !userp(this_object())) {
    if (!mapp(skills)) skills = ([]);
    // if( undefinedp(skills[skill]) ) skills[skill] = 0;
  }

  // Give learning penalty to those learning too much skills.
  spi = this_object()->query_spi();       // spi = query("spi");
  if (sizeof(learned) > spi)
    amount /= sizeof(learned) - spi;

  if (!amount) amount = 1;

  if (!mapp(learned)) learned = ([ skill: amount ]);
  else (int)learned[skill] += amount;

  if ((!weak_mode || !userp(this_object()))
    && learned[skill] > (skills[skill] + 1) * (skills[skill] + 1)) {
    skills[skill]++;
    learned[skill] = 0;
    tell_object(this_object(), HIC "你的「" + CHINESE_D->to_chinese(skill) + "」进步了！\n" NOR);
    SKILL_D(skill)->skill_improved(this_object());
  }
}

// 减少传入技能的学习点数, 并判定是否有退步以减少等级
varargs void decrease_skill(string skill, int amount, int weak_mode) {
  int spi;
  if (!find_object(SKILL_D(skill))
    && file_size(SKILL_D(skill) + ".lpc") < 0)
    error("F_SKILL: No such skill (" + skill + ")\n");

  if (!weak_mode || !userp(this_object())) {
    if (!mapp(skills)) skills = ([]);
  }
  if (weak_mode) {
    if (mapp(learned)) {
      if (((int)learned[skill] - amount) > 0) (int)learned[skill] -= amount;
      else learned[skill] = 0;
    }
  } else {
    skills[skill] = skills[skill] - 1;
    learned[skill] = 0;
    if (skills[skill] <= 0) skills[skill] = 0;
    tell_object(this_object(), HIC "你的「" + CHINESE_D->to_chinese(skill) + "」退步了！\n" NOR);
    SKILL_D(skill)->skill_decreased(this_object());
  }
}
