// 开始编辑程式。
int edit(function callback)
{
	write("结束离开用'.'、'^w'或者'^x'，取消输入用'^q'。\n");
	write("─────────────────────────────\n");
	input_to("input_line", "", callback);
	return 1;
}

// 由编辑程式呼叫此函数，将使用者所输入的文字或指令作适当的回应，当使用者结
// 述输入时，传入的函数 callback 将会被执行。
void input_line(string line, string text, function callback)
{
	if( line == "." || line == "^w" || line == "^x" ) {
		(*callback)(text);
		return;
	} else if( line == "^q" ) {
		write("输入取消。\n");
		return;
	} else if( line == "^e" ) {
	} else
		text += line + "\n";
	input_to("input_line", text, callback);
}
