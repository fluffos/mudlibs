#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "玉兰堂");
  set("long", @LONG

    这里是侠客园林的玉兰堂。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "yl-xfh",
    "northeast": __DIR__ "yl-xz",
    "northwest": __DIR__ "yl-yixt",
  ]));

  setup();

  replace_program(ROOM);

}
