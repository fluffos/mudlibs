#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "庄  门");
  set("long", @LONG

    这里是英雄山庄的庄门。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": "/d/center/shanzhuang",
    "east": __DIR__ "sz-szg",
    "south": __DIR__ "sz-wsy",
    "west": __DIR__ "sz-syx",
  ]));

  setup();


}
