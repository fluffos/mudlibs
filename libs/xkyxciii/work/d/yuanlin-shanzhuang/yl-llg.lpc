#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "玲珑馆");
  set("long", @LONG

    这里是侠客园林的玲珑馆。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "northeast": __DIR__ "yl-htcw",
    "west": __DIR__ "yl-sft",
    "southwest": __DIR__ "yl-jst",
    "southeast": __DIR__ "yl-tyx",
  ]));

  setup();


}
