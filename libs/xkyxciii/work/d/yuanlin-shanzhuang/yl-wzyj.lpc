#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "梧竹幽居");
 	set("long", @LONG
								
    这里是侠客园林的梧竹幽居。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"northwest" : __DIR__"yl-dst",
		"south"     : __DIR__"yl-yht",
	]));

	setup();

	replace_program(ROOM);

}

