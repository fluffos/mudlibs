#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "倚玉轩");
 	set("long", @LONG

    这里是侠客园林的倚玉轩。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"southwest" : __DIR__"yl-xfh",
		"southeast" : __DIR__"yl-yxt",
		"northwest" : __DIR__"yl-hfsmt",
	]));

	setup();

	replace_program(ROOM);

}

