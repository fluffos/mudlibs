#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "九曲桥");
 	set("long", @LONG

    这里是侠客园林的九曲桥。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"northwest" : __DIR__"yl-jsl",
		"southeast" : __DIR__"yl-hfsmt",
	]));

	setup();

	replace_program(ROOM);

}

