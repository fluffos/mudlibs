#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "芳渚临流");
  set("long", @LONG

    这里是英雄山庄的芳渚临流。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "sz-slyz",
    "west": __DIR__ "sz-cflz",
    "south": __DIR__ "sz-fyj",
  ]));

  setup();

  replace_program(ROOM);

}
