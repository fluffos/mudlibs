#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "小桥流水");
 	set("long", @LONG
								
    这里是侠客园林的小桥流水。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"      : "/d/center/yuanlin",
		"east"       : __DIR__"yl-hbxl2",
		"west"       : __DIR__"yl-hbxl1",
		"southwest"  : __DIR__"yl-jsl",
	]));

	setup();

	replace_program(ROOM);

}

