#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "如意洲");
 	set("long", @LONG

    这里是英雄山庄的如意洲。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"      : __DIR__"sz-yyl",
		"northwest"  : __DIR__"sz-slyz",
		"east"       : __DIR__"sz-qht",
	]));

	setup();

	replace_program(ROOM);

}

