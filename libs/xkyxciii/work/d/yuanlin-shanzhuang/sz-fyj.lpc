#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "芳园居");
 	set("long", @LONG

    这里是英雄山庄的芳园居。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"     : __DIR__"sz-fzll",
		"south"	    : __DIR__"sz-hbxd",
		"east"      : __DIR__"sz-ryh1",
	]));

	setup();

	replace_program(ROOM);

}

