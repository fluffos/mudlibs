#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "小飞虹");
 	set("long", @LONG

    这里是侠客园林的小飞虹。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"west"      : __DIR__"yl-ylt",
		"south"     : __DIR__"yl-dzt",
		"southeast" : __DIR__"yl-sft",
		"northeast" : __DIR__"yl-yyx",
	]));

	setup();

	replace_program(ROOM);

}

