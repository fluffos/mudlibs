#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "莺啭乔木");
  set("long", @LONG

    这里是英雄山庄的莺啭乔木。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "sz-wsy",
    "east": __DIR__ "sz-ptcy",
    "southwest": __DIR__ "sz-slyz",
    "west": "/d/player/bibi",
  ]));

  setup();

  replace_program(ROOM);

}
