#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "湖边小道");
 	set("long", @LONG

    这里是英雄山庄的湖边小道。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"     : __DIR__"sz-fyj",
		"south"	    : __DIR__"sz-whsf",
	]));

	setup();

	replace_program(ROOM);

}

