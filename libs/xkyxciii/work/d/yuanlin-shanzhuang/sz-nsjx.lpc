#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "南山积雪");
 	set("long", @LONG

    这里是英雄山庄的南山积雪。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"northwest" : __DIR__"sz-syx",
		"south"	    : __DIR__"sz-wjg",
	]));

	setup();

	replace_program(ROOM);

}

