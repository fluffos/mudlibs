#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "浮翠阁");
  set("long", @LONG

    这里是侠客园林的浮翠阁。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "yl-dyl",
    "southwest": __DIR__ "yl-pjy",
    "southeast": __DIR__ "yl-lt",
  ]));

  setup();

  replace_program(ROOM);

}
