#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "海堂春坞");
 	set("long", @LONG

    这里是侠客园林的海堂春坞。
LONG
	);

	set("outdoors", "center");

 	set("exits", ([
		"north"     : __DIR__"yl-yht",
		"west"      : __DIR__"yl-yxt",
		"southwest" : __DIR__"yl-llg",
	]));

	setup();

	replace_program(ROOM);

}

