#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "得真亭");
  set("long", @LONG

    这里是侠客园林的得真亭。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "yl-xfh",
    "south": __DIR__ "yl-zqyy",
  ]));

  set("objects", ([
    __DIR__ "npc/huang-shang": 1,
  ]));

  setup();

  replace_program(ROOM);

}
