#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "文津阁");
  set("long", @LONG

    这里是英雄山庄的文津阁。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "north": __DIR__ "sz-nsjx",
    "south": __DIR__ "sz-slyz",
  ]));

  setup();

  replace_program(ROOM);

}
