#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "白石路");
        set("long", @LONG
                                                                
    这里是千金楼的白石路。
LONG
        );

        set("outdoors", "qianjinlou");

        set("exits", ([
                "south"  : __DIR__"main-03s2",
                "north"  : __DIR__"main-03",
                "east"   : __DIR__"main-03se1",
        ]));

        setup();

        replace_program(ROOM);
}