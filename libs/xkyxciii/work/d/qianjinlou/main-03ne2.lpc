#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "湖  边");
        set("long", @LONG
                                                                
    这里是千金楼的湖边。
LONG
        );

        set("outdoors", "qianjinlou");

        set("exits", ([
                "west"   : __DIR__"main-03ne1",
                "east"   : __DIR__"main-03ne3",
                "south"  : __DIR__"main-04",
        ]));

        setup();

        replace_program(ROOM);
}