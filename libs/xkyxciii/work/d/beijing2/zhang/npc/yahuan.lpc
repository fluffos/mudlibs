// yahuan.c

inherit NPC;

void create()
{
	set_name("丫环", ({ "ya huan","ya","huan" }) );
	set("gender", "女性" );
	set("age", 18);
	set("long", "一个小丫环，正忙着侍候老爷和少奶。\n");
	set("combat_exp", 250);
	set_skill("dodge",20);
	set_skill("unarmed",20);
	set_skill("parry",20);

	set("attitude", "friendly");
	setup();
	carry_object("/d/beijing2/zhang/obj/yacloth")->wear();

}
