// wife2.c

inherit NPC;

void create() {
  set_name("张王氏", ({ "zhang" }));
  set("gender", "女性");
  set("age", 33);
  set("long", "张康文的老婆,正在照顾她的儿子.她看着儿子,脸上露出关切的表情.\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set("per", 30);

  setup();
  add_money("coin", 10000);
  carry_object("/obj/cloth/green-silk")->wear();

}
