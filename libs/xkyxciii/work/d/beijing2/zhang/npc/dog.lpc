// dog.c

inherit NPC;

#include <net/dns.h>
#include <ansi.h>

void create()
{
	set_name("狼狗", ({ "dog" }) );
	set("race", "野兽");
	set("age", 4);
	set("long", "一只德国的名种狼狗,是张百万花了许多钱从法兰西买回来的。\n");
	
	set("str", 24);
	set("cor", 26);

	set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

	set("chat_chance", 5);
	set("chat_msg", ({
		(: "random_move" :),
		 }) );
		
	set_temp("apply/attack", 60);
	set_temp("apply/damage", 20);
        set_temp("apply/armor", 80);
        set_temp("apply/defense",80);
	
	set("verbs", ({ "bite", "claw" }) );
	

	setup();
}
void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}


void greeting(object ob)
{
	object ob2;
	if( !ob || !present(ob, environment(this_object())) ) return;
	if( ob->query("gender")=="男性"  
           && ( ! objectp(ob2=present("jiading cloth",ob) )
             || ! ob2->query("equipped"))) 
              {  message_vision("狼狗对着$N大喝一声:贼!往哪里走?\n",ob);
		 command("kill "+ob->query("id"));
		 return;
	      }
	if( ob->query("gender")=="女性"  
           && ( ! objectp(ob2=present("yahuan cloth",ob) )
             ||  ! ob2->query("equipped")) )
              {  message_vision("狼狗对着$N大喝一声:贼!往哪里走?\n",ob);
		 command("kill "+ob->query("id"));
		 return;
	      }
}



