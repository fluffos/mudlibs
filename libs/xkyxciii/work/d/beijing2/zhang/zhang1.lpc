// zhang1.c--张百万

inherit NPC;

string ask_me();

void increase_skill(object ob);

void create()
{
	set_name("张百万", ({ "zhang baiwan","zhang" }) );
	set("gender", "男性" );
	set("title","庄主");
	set("age", 60);
	set("str", 25);
	set("cor", 26);
	set("cps", 29);
	set("int", 25);
	set("per", 25);
	set("long", @LONG
京师最大的财主.家财百万.
按说大财主应该乐呵呵地，他却愁眉苦脸，象是遇到了什么难事。
LONG
);
	set("trouble_solved",0);
	set("inquiry", ([
		"难事" : (: ask_me :), 
		"帮助" : (: ask_me :), 
		"帮忙" : (: ask_me :),
]));
	set("attitude", "heroism");
	set("chat_chance_combat", 15);
	set("chat_msg_combat", ({
		"高员外叹道：你还是快走吧，我今天没心情和你打斗！\n",
	}) );

	set("combat_exp", 20000);
	 set("SEN",100);
	set("score", 5000);

	set_skill("unarmed", 70);
	set_skill("force", 70);
	set_skill("dodge", 70);
	set_skill("parry", 70);
	 set_skill("sword",60);
	 set_skill("taiji-sword",40);

	 map_skill("sword","taiji-sword");

	 setup();
	 carry_object("/obj/cloth")->wear();
	 carry_object("/obj/weapon/sword")->wield();
}

int ask_me()
{
	object ob,obj;
	object player,ob2;
	string err;
	player=this_player();
	ob=this_object();
	if( player->query("gender")=="男性"  
	   && (! objectp(ob2=present("jiading cloth",player) )
	     || ! ob2->query("equipped")) )
	      {  message_vision("张百万大喊:有贼啊!来人啊!快来抓贼!\n");
		 err=catch(obj=new("/d/beijing2/zhang/npc/huyuan.lpc"));
		 obj->move(environment(ob));
		 return 1;
	       }
	if( player->query("gender")=="女性"  
	   && (! objectp(ob2=present("yahuan cloth",player) )
	     || ! ob2->query("equipped")) )
	      {  message_vision("张百万大喊:有贼啊!来人啊!快来抓贼!\n");
		 err=catch(obj=new("/d/beijing2/zhang/npc/huyuan.lpc"));
		 obj->move(environment(ob));
		 return 1;
	       }

	if( ob->query("trouble_solved") ) 
	      {  command("say 多谢这位"+RANK_D->query_respect(player)+"，"
			+RANK_D->query_self(ob)+"的麻烦已经解决了。" );
		 return 1;
	      }

	if(! player->query("save_zhang") )
	     {   
		command("say 多谢这位"+RANK_D->query_respect(player)+"，"
			+RANK_D->query_self(ob)+"怎敢再劳烦您呢.");
		return 1;
	     }
	player->set_temp("query_zhang",1);
	command("say 这位"+RANK_D->query_respect(player)
	+ "不象是下人,您是...?");
	return 1;
}

void relay_say(object ob, string msg)
{
	string who, phrase;
	if(! ob->query_temp("query_zhang") ) return;
	if(msg!=ob->query("name") ) return;
	command("say "+"哦,原来是鼎鼎大名的"+ob->query("name") );
	command("say "+"实不相瞒,"+RANK_D->query_self(this_object())+
	   "的小孙子得了重病,平一指大夫说只有天山雪莲才能救他的命了.");
	command("sigh "+ ob->query("id") );
	ob->delete_temp("query_zhang");
	ob->set_temp("ask_zhang",1);
}

int accept_object(object who, object ob)
{
int i;
	if( (ob->query("id")!="white_dust" 
	    && ! who->query_temp("ask_herbalist") ) 
	    || ( ob->query("name")!="张杨氏" && 
	       ! who->query_temp("ask_zhang1") )
		 ) return 0;
	if(ob->query("id")=="white_dust" )
	{
	    tell_object(who,"接着你把这包药粉是从二少奶房间找到的和杨掌柜的判断告诉张老爷.\n");
	    command("sigh");
	    tell_object(who,"张老爷接着告诉你:正所谓家丑不能外扬,"+RANK_D->query_respect(who)+"你能不能\n"+
	    "帮老夫一个忙,就事把那小贱人抓来交给我处理呢?\n");
	    who->dele_temp("ask_herbalist");
	    who->set_temp("ask_zhang1");
	    return 1;
	}
	if(ob->query("name")=="张杨氏")
	{
	    command("say "+"多谢这位"+RANK_D->query_respect(who)  );
            i = (int)ob->query("combat_exp") / 10;
            if(i>100000) i = 100000;
	    who->add("combat_exp", i);
	    who->add("potential",50); 
	    who->add("SEN",1000);
	    who->set("give_zhang",1);
	    who->delete_temp("ask_zhang1");
	    increase_skill(who);
	    tell_object(who,GRN"由于你的出色表现，你的侠义精神、战斗经验和武功都得到了提高。\n"NOR);
	    return 1;
	}

}
