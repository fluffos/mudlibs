// hall.c

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "大厅");
	set("long", @LONG

这是张家的大厅.
    装饰的雍容华贵而不落俗套.显示出主人是一个有文化的读书人.

LONG
	);
	set("exits", ([
		 "south"          : __DIR__"zoulang1",
		 "north"          : __DIR__"zoulang2"
		 ]) );

	set("objects", ([
		__DIR__"npc/zhang1" : 1,
		__DIR__"npc/jiading" :1, 
		__DIR__"npc/yahuan"  :1  ]) );


	setup();
	replace_program(ROOM); 
}


