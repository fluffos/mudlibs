// student.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("学生", ({ "student","xue sheng"  }) );
        set("gender", "男性" );
        set("age", 22);
        set("long", "一脸稚气，正聚精会神的看着屏幕。\n");
        set("str", 20);
        set("int", 25);
        set("combat_exp", 1500);
        set("attitude", "friendly");
        set_skill("unarmed", 30);
        set_skill("parry", 30);
        set_skill("dodge", 30);

        set("SEN",1000);
        setup();
        carry_object("/obj/cloth/cloth")->wear();
       
}

void init()
{	
	object ob;

	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 2, ob);
	}
}

void greeting(object ob)
{
	if( this_object()->query_temp("unconcious") || !ob 
                 || environment(ob) != environment() ) return;
	say( "看见有人进来。学生们同时按了一下键盘右上方某个键。然后装做很忙的样子，\n" );
        say( "打开书本查找起资料来。\n");
}
