// curio_shop.c- 古玩店 

inherit ROOM;
string look_sign(object me);

void create()
{
        set("short", "古玩店");
        set("long", @LONG
这是全国最大的古玩连锁店，他们的老板，据说身家超过比尔.盖子，达到
一亿两黄金的天文数字。
LONG
        );
        set("item_desc", ([
                "sign": (: look_sign :),
        ]) );

        set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"nw_road4",
	]));
        set("no_clean_up", 0);
//        set("outdoors", "beijing");
        set("objects", ([ /* sizeof() == 1 */
		__DIR__"npc/curio_seller" : 1,  //老板一名
                ]));
        setup();
        replace_program(ROOM);
}
string look_sign(object me)
{
        return (@LONG
价值连城
LONG);
}
