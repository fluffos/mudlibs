// tailor_shop.c - 裁缝店

#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "裁缝店");
  set("long", @LONG

    这里是北京城有名的裁缝店。据说这里的老裁缝的手艺一流，朝中个大臣的官服，
便服，都是找他做的。
LONG
  );

  set("item_desc", ([
    "sign": @TEXT
这里是裁缝店，目前我们提供的服务有：
[36m
name        设定独门穿着的名称。
wear_msg    设定独门穿着装备信息。
remove_msg  设定独门穿着卸装信息。
make	    制造独门穿着。
[2;37;0m
TEXT
  ]));

  set("exits", ([
    "west": __DIR__ "nw_road1",
  ]));

  set("objects", ([
    __DIR__ "npc/tailor": 1,
  ]));

  setup();

  replace_program(ROOM);
}
