// rouge_seller.c 胭脂店老板

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("赛西施", ({ "seller","sai xishi", "boss" }));
	set("title", "胭脂店老板娘");

	set("per",30);
        set("str", 20);
	set("gender", "女性");
	set("age", 35);
	set("long",
		"虽然年过三十，但是她保养的很好，皮肤还很白，很嫩。\n"
		"所以还能迷倒许多京城的公子哥儿。\n");
	set("combat_exp", 1000);
	set("attitude", "friendly");
	
        set("vendor_goods", ([
		__DIR__"obj/xiuhua" : 1,
		__DIR__"obj/flower_shoe" :1,
                __DIR__"obj/pink_cloth": 1,
                __DIR__"obj/goldring":1,
                __DIR__"obj/necklace":1,
        ]) );



	setup();
   carry_object(__DIR__"obj/flower_shoe")->wear();
}

void init()
{
        object ob;

        ::init();
		if( this_object()->query_temp("unconcious") ) return;
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}


void greeting(object ob)
{
	if (!ob || environment(ob) != environment())
		return;
	switch(random(2)) {
	case 0 :
		say("老板娘笑眯眯地说道：人客来坐。\n");
		break;
	case 1 :
		say("老板娘说道：可嘴的，你要买什？\n");
		break;
	}


}
