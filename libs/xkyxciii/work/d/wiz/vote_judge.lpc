#include <ansi.h>
#include <localtime.h>
inherit NPC;

string diagnose();
void heal_who(object who);

void create()
{
	set_name("公证人", ({ "vote judge", "judge" }) );
	set("long", @LONG
他是一位一身正气的年轻人，处事绝对公平。
LONG
	);

	set("title","巫师代理");
	set("nickname","公证人");

	set("rank_info/respect", "公证人");
	set("attitude", "friendly");
	set("gender", "男性" );
	set("age", 21);

	set("str", 50);		// 膂力
	set("cps", 30);		// 定力
	set("cor", 30);		// 胆识
	set("per", 30);		// 容貌
	set("int", 50);		// 悟性
	set("con", 50);		// 根骨
	set("spi", 30);		// 灵性
	set("kar", 30);		// 福缘

	set("max_atman", 0);		set("atman", 0);
	set("max_force", 2000);		set("force", 4000);	set("force_factor", 200);
	set("max_mana", 0);		set("mana", 0);

	set("combat_exp", 5000000);
	// set("SEN",10000000);

	set_skill("force",    200);	set_skill("bahuang-force", 200);
	set_skill("sword",    200);	set_skill("ruyixiaoyao-sword", 200);
	set_skill("unarmed",  200);	set_skill("tianxian-zhang", 200);
	set_skill("parry",    200);
	set_skill("move",     200);	set_skill("feixian-steps", 200);
	set_skill("dodge",    200);
	set_skill("literate", 250);
	set_skill("magic",    200);	set_skill("essencemagic", 200);
	set_skill("buddhism", 250);

	map_skill("force", 	"bahuang-force");
	map_skill("sword", 	"ruyixiaoyao-sword");
	map_skill("unarmed", 	"tianxian-zhang");
	map_skill("parry", 	"ruyixiaoyao-sword");
	map_skill("move", 	"feixian-steps");
	map_skill("dodge", 	"feixian-steps");
	map_skill("magic", 	"essencemagic");

        set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
		(: perform_action :),
                (: exert_function, "recover" :),
	}) );

	setup();

	carry_object("/obj/misc/cloth")->wear();
	carry_object("/obj/weapon/longsword")->wield();
}


int accept_object(object who, object ob)
{
	return notify_fail("他是公证人，不会接受人家的东西的。\n");
}

