#include <room.h>

inherit WIZ_ROOM;

string look_sign();

void create() {
  set("short", "机关部");
  set("long", @LONG

    这里是神仙楼的机关部。
LONG
  );

  set("restrict_fly_room", 1);

  set("exits", ([
    "north": __DIR__ "wizard_room",
  ]));

  setup();

  replace_program(ROOM);
}
