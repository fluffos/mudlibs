inherit WIZ_ROOM;

void create()
{
        set("short", "神仙大厅");
        set("long", @LONG

    这里是神仙楼的神仙大厅。旁边挂着一张地图(map)。
LONG
        );

        // This enables players to save this room as their startroom.

        set("valid_startroom", 1);
        set("restrict_fly_room", 1);

        set("exits", ([
                "down"          : "/d/center/chat_room",
                "east"          : __DIR__"wizard_e",
                "southeast"     : __DIR__"wizard_se",
                "south"         : __DIR__"wizard_s",
                "southwest"     : __DIR__"wizard_sw",
                "west"          : __DIR__"wizard_w",
                "northwest"     : __DIR__"wizard_nw",
                "north"         : __DIR__"wizard_n",
                "northeast"     : __DIR__"wizard_ne",
                "up"            : __DIR__"admin_room",
        ]));

        set("item_desc", ([
                "map": @TEXT
这里是神仙楼，这里的地图如下：
[36m
              场景部
     武功部     │     文档部
           ＼        ／

    内核部—  大  厅  —行政部

           ／        ＼
     任务部     │     创意部
              机关部
[2;37;0m
TEXT
        ]) );

        setup();

        // To "load" the board, don't ever "clone" a bulletin board.
        call_other( "/obj/board/wiz_b", "???" );

        replace_program(ROOM);

}
