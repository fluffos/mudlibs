inherit WIZ_ROOM;

void create() {
  set("short", "会客大厅");
  set("long", @LONG

    这里是神仙楼的会客大厅。
LONG
  );

  set("restrict_fly_room", 1);

  set("exits", ([
    "up": "/d/center/chat_room",
    "east": "/d/center/roadn1",
    "south": "/d/center/roadw1",
  ]));

  set("objects", ([
    "/obj/npc/xun-bu": 3,
    __DIR__ "npc/shenxian-shizhe": 1,
  ]));

  setup();

  // To "load" the board, don't ever "clone" a bulletin board.
  call_other("/obj/board/towiz_b", "???");
}
