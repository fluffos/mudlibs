#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "百花园");
  set("long", @LONG
                                                                
    这里是神仙山庄的百花园。
LONG
  );

  set("outdoors", "taishan");

  set("exits", ([
    "east": __DIR__ "sx-bhy1",
    // "south" : "/d/taishan/main-13-n2",

    "southdown": "/d/taishan/main-01",

    "west": __DIR__ "sx-bhy3",
    "north": __DIR__ "sx-bhy1",
  ]));

  setup();


}
