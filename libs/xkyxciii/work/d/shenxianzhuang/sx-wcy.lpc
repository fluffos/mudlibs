#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "万春园");
 	set("long", @LONG
								
    这里是神仙山庄的万春园。
LONG
	);

	set("outdoors", "taishan");

 	set("exits", ([
		"east"   : __DIR__"sx-sgsc",
		"south"  : __DIR__"sx-jzd",
		"west"   : __DIR__"sx-xfxs",
		"north"  : __DIR__"sx-nh",
	]));

	setup();

	replace_program(ROOM);

}

