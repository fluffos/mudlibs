
#include <ansi.h>

inherit NPC;

void create()
{
        set_name("虾兵", ({ "xia" }));

        set("long", @LONG
这是一个虾兵。
LONG
        );

        set("race", "野兽");
        set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );
        set("age", 3);

        set("str", 30);         // 膂力         
        set("cor", 30);         // 胆识         

        set("combat_exp", 1000000);

        set_temp("apply/attack", 200);
        set_temp("apply/armor", 200);
        set_temp("apply/damage", 200);
        set_temp("apply/dodge", 200);

        setup();
}
