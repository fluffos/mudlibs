inherit CHAT_ROOM;

void create()
{
        set("short", "聊天广场");
        set("long", @LONG

    这里是侠客城聊天广场。在这里，时间被神仙的法力冻结了。任何人
就算在这里呆上一千年，人间也只是过了一天。
LONG
        );

        // set("outdoors", "center");

        set("exits", ([
                "up"   : "/d/wizard/wizard_room",
                "down" : "/d/wizard/guest_room",
                "1"    : __DIR__"chat_room_1",
                "2"    : __DIR__"chat_room_2",
                "3"    : __DIR__"chat_room_3",
                "4"    : __DIR__"chat_room_4",
                "5"    : __DIR__"chat_room_5",
                "6"    : __DIR__"chat_room_6",
                "7"    : __DIR__"chat_room_7",
                "8"    : __DIR__"chat_room_8",
                "9"    : __DIR__"chat_room_9",
                "0"    : __DIR__"chat_room_0",
        ]) );                   

        set("objects", ([
                __DIR__"npc/drooler" : 1,
        ]));

        ::create();

        // replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
        if( dir == "up" && !wizardp(me) )
                return notify_fail("那里只有神仙才能进去。\n");
        return ::valid_leave(me, dir);
}
