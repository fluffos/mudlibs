#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "华清池");
  set("long", @LONG

    这里是侠客城的华清池澡堂。
LONG
  );

  set("exits", ([
    "east": __DIR__ "roadn3",
    "west": __DIR__ "baihuayuan",
    "north": __DIR__ "yizhan",
  ]));

  set("objects", ([
    __DIR__ "npc/laoban-zt": 1,
    __DIR__ "npc/xiaoshitong": 1,
    __DIR__ "npc/xiaoshinu": 1,
    __DIR__ "npc/luonu": 2,
    __DIR__ "npc/luonan": 2,
  ]));

  setup();

  replace_program(ROOM);
}
