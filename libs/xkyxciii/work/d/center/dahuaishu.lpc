#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        set("short", "大槐树园");
        set("long", @LONG

    这里是侠客城大槐树园。这棵大槐树已经有上千年的年龄了，树干上
留下的皱纹和从树枝上垂下的须根就是以往岁月的见证。从董郎和许仙时
起，不知它见证了多少有情人结为良缘。在大槐树旁边，有一块留情石，
上面刻满了字迹（zi）。
LONG
        );

        set("item_desc", ([
                "zi": (: look_sign :),
        ]) );

        set("outdoors", "center");

        set("exits", ([
                "east"  : __DIR__"posthouse",
                "south" : __DIR__"baihuayuan",
                "west"  : __DIR__"hongniangzhuang",
        ]) );                   

        set("objects", ([
                __DIR__"npc/youngman": 1,
                __DIR__"npc/younglady": 1,
        ]) );

        setup();

        // replace_program(ROOM);
}

string look_sign(object me)
{
        string tempstr;
        tempstr = "你留意到留情石上其中的一行字是：\n";
        if( me->query("marry") ) 
                return tempstr + me->query("marry") + "和" + me->query("id") 
                        + "恩恩爱爱....天长地久，海枯石烂，永不分离！\n";
        else 
                return tempstr + "独身万岁！自由万岁！\n";
}

