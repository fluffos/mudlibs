inherit ROOM;

void create() {
  set("short", "南大街");
  set("long", @LONG

    你走在侠客城南大街上，踩着坚实的青石板地面。东边是一家花店。
西边是一座的酒楼，挂着“太白遗风”的招帘，门额上悬挂一方横匾，“
醉仙楼”三字擦得闪闪发亮，乃是苏学士的手笔。阵阵酒肉香酒香让你垂
涎欲滴。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "huadian",
    "south": __DIR__ "roads4",
    "west": __DIR__ "drinkery",
    "north": __DIR__ "roads2",
  ]));

  set("objects", ([
    __DIR__ "npc/scavenger": 1 ])
  );

  setup();

}
