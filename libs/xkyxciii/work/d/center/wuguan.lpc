#include <room.h>

inherit ROOM;

void create() {
  set("short", "武  馆");
  set("long", @LONG

    这里是侠客城的武馆。里面的一个架子（shelf ）上，各式武器都依
照种类、长短、依次放在一起，并且擦拭得一尘不染。
LONG
  );

  set("exits", ([
    "south": __DIR__ "xiaoxihu",
    "west": __DIR__ "biwuchang",
    "north": __DIR__ "yaodian",
  ]));

  set("objects", ([
    __DIR__ "npc/mawude": 1,
    __DIR__ "npc/jiaotou": 1,
    __DIR__ "npc/wuguan-dizi": 2,
    "/obj/weapon/bamboo_sword": 2,
    "/obj/weapon/wood_blade": 2, ]));

  setup();

}
