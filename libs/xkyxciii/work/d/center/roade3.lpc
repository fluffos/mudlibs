inherit ROOM;

void create() {
  set("short", "东大街");
  set("long", @LONG

    你走在东大街上，踩着坚实的青石板地面。南边是一家工作室。北边是
一个集市。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "roade4",
    "south": __DIR__ "gongzuoshi",
    "west": __DIR__ "roade2",
    "north": __DIR__ "jishi",
  ]));

  set("objects", ([
    __DIR__ "npc/drunk": 1 ])
  );

  setup();

}
