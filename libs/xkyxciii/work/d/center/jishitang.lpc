#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "济世堂");
  set("long", @LONG

    这里是侠客城济世堂。这是由城里一些大侠自发组织起来的一个慈善
性机构。济世堂常常在门口散发一些包子或者稀粥给饿着肚子的穷人。有
时候，还为一些没有钱的人们看病。
LONG
  );

  set("exits", ([
    "east": __DIR__ "bamboo_hurst",
    "west": __DIR__ "roads4",
    "north": __DIR__ "huadian",
  ]));

  setup();

}
