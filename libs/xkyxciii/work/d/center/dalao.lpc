#include <room.h>

inherit ROOM;

void create()
{
        set("short", "侠客城大牢");
	set("long", @LONG

    这里是侠客城大牢，专门用来关押罪行严重的犯人。这是一间约两丈见方的
大屋，除了铁门上面尺许的方洞有点光透进来之外，四周黑漆漆的一片。你觉得
四壁隐隐地发出闪光，原来四周墙壁均是由钢铁所铸，墙上还连着几根纯刚铁链
子，链子末端是精铁的铐镣。地上铺着厚厚的稻草，角落上放着个木桶，桶里传
出的一阵阵恶臭令人闻之欲呕。四周连牢里常见的老鼠都找不到！
LONG
        );

	set("no_fight", 1);
	set("no_magic",1);

        setup();

	replace_program(ROOM);
}

