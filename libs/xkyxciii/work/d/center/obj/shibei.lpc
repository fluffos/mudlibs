#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIC "天外神碑" NOR, ({ "shi bei", "bei" }));
  set_weight(1000000);
  set_max_encumbrance(1000000);
  set("no_get", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", @LONG
这是一块表面非常平整的石碑，里面似乎有些字迹。你忍不住想把小水池
里的泉水泼到石碑上面（quest ），来看看石碑上面写的是什么。如果仔
细端详，你可以发现，石碑背后有一个洞（hole）。
LONG
    );
    set("value", 1);
  };
}

int is_container() { return 1; }
