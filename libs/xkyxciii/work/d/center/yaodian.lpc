#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "回春堂");
	set("long", @LONG

    这里是侠客城回春堂。回春堂几百个小抽屉里密密麻麻堆的都是药材。
大老远就能闻到从这里散发出来的一股浓厚的药香。药店老板坐在茶几旁，
独自喝茶，看都不看你一眼。一名小伙计站在柜台后招呼着顾客。
LONG
	);

	set("exits", ([
                "south"	: __DIR__"wuguan",
                "west"	: __DIR__"taolunshi",
                "north"	: __DIR__"roadw3",
        ]) );			


        set("objects", ([
                __DIR__"npc/saihuatuo": 1,
	]) );

	setup();

	replace_program(ROOM);
}
