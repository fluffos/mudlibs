#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
	set("short", "太极观");
	set("long", @LONG

    这是侠客城太极观。殿中奉的是道家三清祖师的泥塑神像，殿内香烟
缭绕，十分庄严肃穆。道观的院子当中放有一尊六尺多高的错金香鼎，相
传当年香火旺盛时，每日只须道童晨起焚香撮火，并不用人力，稍过片刻
山门便自行开启，待昏夜时，向鼎中注水，山门便自行关闭。人们以讹传
讹，深信这太极观道士掌着九天符录，这些庙务全由神差来办，因此这鼎
上错金连最贪财的人也不敢动它分毫。附近好施乐善的人家每月凑了一些
钱财或五谷杂粮，让无家可归的乞丐可以来这里领取一份食物，聊以充饥。
LONG
	);

	set("exits", ([
                "east"  : __DIR__"kaochang",
                "south" : __DIR__"zhaiyuan",
                "north" : __DIR__"xiaosonglin",
        ]) );			

        set("objects", ([
                __DIR__"npc/taoism": 1,
                __DIR__"npc/jinxiangke": 1,
                __DIR__"npc/beggar": 1,
		"/obj/food/bread" : 2,
	]) );

	setup();

	replace_program(ROOM);
}
