// dudajin.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("都大锦", ({ "du dajin", "du", "waiter" }) );
        set("long", "他就是都大锦。\n");

        set("rank_info/respect", "师傅");
        set("attitude", "friendly");
        set("gender", "男性" );
        set("age", 30);

        set("combat_exp", 10);
        set("SEN",10);

        set("vendor_goods", ([
                "/obj/book/force_book_b"    : 3,
                "/obj/book/move_book_b"     : 3,
                "/obj/book/dodge_book_b"    : 3,
                "/obj/book/unarmed_book_b"  : 3,
                "/obj/book/parry_book_b"    : 3,
                "/obj/book/sword_book_b"    : 3,
                "/obj/book/blade_book_b"    : 3,
                "/obj/book/qimen_book_b"    : 3,
                "/obj/book/magic_book_b"    : 3,
                "/obj/book/spells_book_b"   : 3,
        ]) );

        setup();
}

void init()
{       
        object ob;

        ::init();
		if( this_object()->query_temp("unconcious") ) return;
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(1) ) {
                case 0:
                        say( "都大锦笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，想买书吗？\n");
                        break;
        }
}
