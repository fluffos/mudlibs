// gongzi.c - 富家公子
// Designed by Carlis

#include <ansi.h>

inherit NPC;

#define SET_SKILL       40                      // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         -500                    // 定义正气的值

void create()
{
        int n;

        set_name("富家公子", ({ "fujia gongzi", "gongzi", "fujia" }) );

        set("long", @LONG
这是一个出生在富裕家庭的花花公子，平时欺善怕恶，
还常常敢在光天化日之下调戏良家妇女。
LONG
        );

        set("attitude", "friendly");
        set("gender", "男性" );
        set("age", 24);

        set("per", 10);                         // 容貌

        set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * ( 10 + random( 10 ) ) / 10);
        set("SEN", SET_SEN);

        set("env/wimpy", 30);                   //

        n = SET_SKILL + random(10) - 5;         set_skill("unarmed", (n <= 0) ? 1 : n);
        n = SET_SKILL + random(10) - 5;         set_skill("parry",   (n <= 0) ? 1 : n);
        n = SET_SKILL + random(10) - 5;         set_skill("dodge",   (n <= 0) ? 1 : n);
        set_skill("literate", 120);

        set("chat_chance_combat", 25);
        set("chat_msg_combat", ({
                "富家公子喝道：哼，老子的事情你也敢管，找死！\n",
                "富家公子喝道：多管闲事，你活得不耐烦了吧！\n",
        }) );

        setup();

        carry_object("/obj/cloth/baolan-duanshan")->wear();     // 装备

        add_money("gold", 3);                          // 金钱
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        say( this_object()->query("name") + "色迷迷地说道：姑娘，你长的这般好，"
                + "在这里拉二胡太浪费了，倒不如跟我回家去拉吧！\n");
        say( "二胡姑娘喊道：不要！....不要！......救命呀！......\n");
}

int accept_kill(object ob)
{
        object me,player;
        me = this_object();
        player = this_player();
        if ( me->is_fighting() )
                return notify_fail("已经有人正在帮助二胡姑娘！\n");
        me->kill_ob( player );
        player->kill_ob( me );
}

void afterdie_func(object killer)
{
        object me;
        int m, n, i;

        me = this_object();
        message_vision( "$N打败了富家公子，帮助了可怜的二胡姑娘。\n", killer);
        message_vision( "由于$N的侠义表现，$N得到了奖励。\n", killer);

        i = killer->query("combat_exp") / 50000;
        if( i > 100 ) i = 100;
        m = random(10) + i / 10 + 1;
        n = random(100) + i + 1;
        killer->add("potential", m);
        killer->add("combat_exp", n);
        tell_object(killer, sprintf("你的潜能增加了%s点！\n", chinese_number(m)));
        tell_object(killer, sprintf("你的经验增加了%s点！\n", chinese_number(n)));
}
