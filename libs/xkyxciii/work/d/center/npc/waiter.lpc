// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.6

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

#define SET_SKILL       0                       // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         50                      // 定义正气的值

void create()
{
        int n;

        set_name("店小二", ({ "waiter" }) );

        set("long", @LONG
这位店小二正笑咪咪地忙著，还不时拿起挂在脖子上的抹布擦脸。
LONG
        );

        set("rank_info/respect", "小二哥");
        set("attitude", "friendly");
        set("gender", "男性" );
        set("age", 22);

        // set("str", 30);                      // 膂力         
        // set("cps", 30);                      // 定力
        // set("cor", 30);                      // 胆识         
        set("per", 26);                         // 容貌
        // set("con", 30);                      // 根骨

        set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * ( 10 + random( 10 ) ) / 10);
        set("SEN", SET_SEN);

        set("env/wimpy", 30);                   //

        n = SET_SKILL + random(10) - 5;         set_skill("unarmed", (n <= 0) ? 1 : n); 
        n = SET_SKILL + random(10) - 5;         set_skill("parry",   (n <= 0) ? 1 : n);
        n = SET_SKILL + random(10) - 5;         set_skill("dodge",   (n <= 0) ? 1 : n);

        set("inquiry", ([
                "住店" : "这里是附近最好的客栈，一晚只要十两银子。\n",
        ]) );

        set("vendor_goods", ([
                "/obj/food/leg"      : 20,
                "/obj/food/wineskin" : 10,
                "/obj/misc/torch"    : 10,
        ]) );

        setup();
        
        carry_object("/obj/cloth/cloth")->wear();       // 装备

        add_money("silver", 10);                        // 金钱
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say( this_object()->query("name") + "笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，进来喝杯茶，歇歇腿吧。\n");
                        break;
                case 1:
                        say( this_object()->query("name") + "用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
                                + "，请进请进。\n");
                        break;
                case 2:
                        say( this_object()->query("name") + "说道：这位" + RANK_D->query_respect(ob)
                                + "，进来喝几盅小店的红酒吧，这几天才从窖子里开封的哟。\n");
                        break;
        }
}

int accept_object(object who, object ob)
{
        
        object dan;
        if( ob->value() >= 1000 ) {
                message_vision("小二点头哈腰，对$N说道：你位客官楼上请！\n",who);
                who->set_temp("give_sleep_money",1);
                } 
        else   {
                command("say 就这点儿钱就想住店？快给我滚开，穷光蛋！");
                return 0;
        }
        return 1;
}
int clean_up()
{
	::clean_up();
        set("vendor_goods", ([
                "/obj/food/leg"      : 20,
                "/obj/food/wineskin" : 10,
        ]) );
}
