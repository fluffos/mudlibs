#include <room.h>

inherit ROOM;

void create() {
  set("short", "黑松林");
  set("long", @LONG

    这里是侠客城的黑松林。
LONG
  );

  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "feilaifeng",
    "north": __DIR__ "gongyuan",
  ]));

  set("objects", ([
    __DIR__ "npc/liumangtou": 1,
    __DIR__ "npc/liumang": 1,
  ]));

  setup();

  replace_program(ROOM);
}
