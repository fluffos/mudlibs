#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "香茗居");
  set("long", @LONG

    这里是侠客城香茗居。你一走进来，就闻到一股茶香沁入心脾，精神
为之一爽。几张八仙桌一字排开，坐满了客人，或高声谈笑，或交头接耳。
你要想打听江湖掌故和谣言，这里是个好去处。
LONG
  );

  set("exits", ([
    "east": __DIR__ "xiaohuayuan",
    "west": __DIR__ "roadn3",
    "north": __DIR__ "chemadian",
    "up": __DIR__ "cardsroom-1",
  ]));

  set("objects", ([
    __DIR__ "npc/waiter-cg": 1,
    __DIR__ "npc/biantai-kuangmo": 1,
    __DIR__ "npc/fighter-a": 1
  ]));

  setup();

}
