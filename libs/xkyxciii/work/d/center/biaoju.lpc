#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "龙门镖局");
  set("long", @LONG

    这里是侠客城龙门镖局。一座结构宏伟的建筑前，左右石坛上各插着
一根两丈多高的旗杆，杆上青旗飘扬。右首旗子用金线绣着一头张牙舞爪
的狮子。左首旗子上写着“龙门镖局”四个黑字，银钩铁划，刚劲非凡。
门口处排着两条长凳，几名镖师正坐着把守。
LONG
  );

  set("exits", ([
    "east": __DIR__ "roadn2",
  ]));

  set("objects", ([
    __DIR__ "npc/dudajin": 1,
  ]));

  setup();

}
