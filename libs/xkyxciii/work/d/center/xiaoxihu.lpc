#include <room.h>

inherit ROOM;

void create()
{
	set("short", "小西湖");
	set("long", @LONG

    这里是侠客城小西湖。
LONG
	);

        set("outdoors", "center");

	set("exits", ([
                "east"	: __DIR__"xilou",
                "south"	: __DIR__"feilaifeng",
                "west"	: __DIR__"gongyuan",
                "north"	: __DIR__"wuguan",
        ]) );			

        set("objects", ([
                __DIR__"npc/selang": 1,
                __DIR__"npc/nuselang": 1,
	]) );

	setup();

	replace_program(ROOM);
}
