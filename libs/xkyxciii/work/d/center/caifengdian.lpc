#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "裁缝店");
  set("long", @LONG

    这里是侠客城的裁缝店。旁边放著一块牌子(sign)。
LONG
  );

  set("item_desc", ([
    "sign": @TEXT
这里是裁缝店，目前我们提供的服务有：
[36m
name        设定独门穿着的名称。
wear_msg    设定独门穿着装备信息。
remove_msg  设定独门穿着卸装信息。
make	    制造独门穿着。
[2;37;0m
TEXT
  ]));

  set("exits", ([
    "east": __DIR__ "buzhuang",
    "west": __DIR__ "feilaifeng",
    "north": __DIR__ "xilou",
  ]));

  set("objects", ([
    __DIR__ "npc/caifeng": 1,
  ]));

  setup();

}
