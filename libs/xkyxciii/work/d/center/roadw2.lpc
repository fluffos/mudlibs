inherit ROOM;

void create() {
  set("short", "西大街");
  set("long", @LONG

    你走在西大街上，踩着坚实的青石板地面。南边是侠客园林，北边是
官府大院。
LONG);
  set("outdoors", "center");

  set("exits", ([
    "east": __DIR__ "roadw1",
    "south": __DIR__ "yuanlin",
    "west": __DIR__ "roadw3",
    "north": __DIR__ "guanfu",
  ]));

  setup();

}
