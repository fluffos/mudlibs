#include <room.h>

inherit ROOM;

void create() {
  set("short", "比武场休息室");
  set("long", @LONG

    这里是比武场的第二间休息室。
LONG
  );

  // set("outdoors", "center");
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  set("no_steal", 1);

  set("exits", ([
    "west": __DIR__ "biwuchang_fight_room",
  ]));

  setup();

}
