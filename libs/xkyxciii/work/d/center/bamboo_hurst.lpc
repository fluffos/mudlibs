// bamboo_hurst.c - 青竹林
// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.7

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "青竹林");
        set("long", @LONG

    这里是侠客城的一片青竹林。前方的竹子似乎显得很密。
LONG
        );

        set("outdoors", "center");

        set("exits", ([
                "east"  : __DIR__"chaodufachang",
                "west"  : __DIR__"jishitang",
                "north" : __DIR__"zhuqipu",
        ]) );                   

        set("objects", ([
                "/d/gaibang/npc/li-sheng": 1,
                "/d/gaibang/npc/disciple": 2,
        ]) );

        set("item_desc", ([
                "bamboo": "这里的竹子很密，但你似乎可以推开（push）它们。\n",
                "竹子":   "这里的竹子很密，但你似乎可以推开（push）它们。\n"
        ]) );

        setup();
}

void init()
{
        add_action("do_push", "push");
}

int do_push(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要推开什么？\n");
                return 1;
        }
        if( arg == "bamboo" || arg == "竹子" )
        {
                me = this_player();
                message_vision("$N推开前方的竹子，发现了一条向里的窄路。\n", me);
                if( !query("exits/enter") ) {
                        set("exits/enter", "/d/gaibang/bamboo_hurst_1");
                        call_out("close_path", 5);
                }
                return 1;
        }
        else
        {
                write("你不可以推开" + arg + "。\n");
                return 1;
        }
}

void close_path()
{
        if( !query("exits/enter") ) return;
        message("vision",
                "一阵风吹过，竹子晃了晃，又掩盖了向南的路。\n",
                this_object() );
        delete("exits/enter");
}

