#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "华清池");
  set("long", @LONG

    这里是侠客城的华清池澡堂。
LONG
  );

  set("exits", ([
    "east": __DIR__ "roadn3",
    "west": __DIR__ "baihuayuan",
    "north": __DIR__ "posthouse",
    "enter": __DIR__ "bathhouse_m",
  ]));

  set("objects", ([
    __DIR__ "npc/laoban-zt": 1,      // bellcaptain 领班
  ]));

  setup();

}
