#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "后花园");
  set("long", @LONG
								
    这里是黑木崖的后花园。
LONG
  );

  set("outdoors", "kunlunshan");

  set("exits", ([
    "north": __DIR__ "hmy-xsw1",
    "south": __DIR__ "hmy-hdd",
    "west": __DIR__ "hmy-xsw2",
    "east": __DIR__ "hmy-xsw3",
  ]));

  setup();

  replace_program(ROOM);

}
