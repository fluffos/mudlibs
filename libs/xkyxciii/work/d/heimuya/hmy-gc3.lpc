#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广  场");
  set("long", @LONG
								
    这里是黑木崖的广场。
LONG
  );

  set("outdoors", "kunlunshan");

  set("exits", ([
    "south": __DIR__ "hmy-gc2",
    "north": __DIR__ "hmy-cdd",
    "west": __DIR__ "hmy-gc3-qlt",
    "east": __DIR__ "hmy-gc3-bht",
  ]));

  setup();


}
