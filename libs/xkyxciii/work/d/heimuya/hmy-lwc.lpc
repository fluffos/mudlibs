#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "练武场");
  set("long", @LONG
								
    这里是日月神教的练武场。
LONG
  );

  set("outdoors", "kunlunshan");

  set("exits", ([
    "south": __DIR__ "hmy-zongtan",
    "north": __DIR__ "hmy-houting",
    "west": __DIR__ "hmy-lgf",
    "east": __DIR__ "hmy-xxs",
  ]));

  setup();

  replace_program(ROOM);

}
