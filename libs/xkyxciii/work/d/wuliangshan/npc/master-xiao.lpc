
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("逍遥子", ({ "xiaoyao zi", "master" }));

        set("long",@LONG
他是逍遥派的开山祖师。
LONG
        );

        create_family("逍遥派", 1, "开山祖师");
        set("rank_info/respect", "祖师");
        set("gender", "男性" );
        set("age", 40);

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 8000000);
        // set("SEN",10000000);

        set_skill("force",    120);     set_skill("beiming-force", 120);
        set_skill("sword",    180);     set_skill("xiaoyao-sword", 180);
        set_skill("unarmed",  150);     set_skill("liuyang-zhang", 150);
        set_skill("parry",    150);
        set_skill("move",     150);     set_skill("lingbo-steps", 150);
        set_skill("dodge",    150);
        set_skill("literate", 150);

        map_skill("force",      "beiming-force");
        map_skill("sword",      "xiaoyao-sword");
        map_skill("unarmed",    "liuyang-zhang");
        map_skill("parry",      "liuyang-zhang");
        map_skill("move",       "lingbo-steps");
        map_skill("dodge",      "lingbo-steps");
/*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
        setup();

        carry_object("/obj/misc/cloth")->wear();
}

void attempt_apprentice(object ob)
{

        if( ((string)ob->query("gender") != "男性")) {
                command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，本门只收男徒。");
                return;
        } 
        if( ((int)ob->query("int") < 20)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

void init()
{
        add_action("give_quest", "quest");
}
