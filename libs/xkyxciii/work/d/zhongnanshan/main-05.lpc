#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "青鸾桥");
  set("long", @LONG
                                                                
    这里是终南山上的青鸾桥。
LONG
  );

  set("outdoors", "zhongnanshan");

  set("exits", ([
    "north": __DIR__ "main-06",
    "south": __DIR__ "main-04",
  ]));

  setup();

  replace_program(ROOM);

}
