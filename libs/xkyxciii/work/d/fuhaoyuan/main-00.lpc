#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "富豪大院");
  set("long", @LONG

    这里是侠客城富豪的大院。一个很大的院子，打扫得一尘不染。迎面
就是一个假山水池，池中摆着一些奇形怪状的石头，据说这些都是当年花
石纲的遗石。院子四周装点着青青翠竹，错落有致。
LONG
  );

  set("exits", ([
    "east": "/d/center/furen",
    "west": __DIR__ "main-01",
    "south": __DIR__ "main-00s",
    "north": __DIR__ "main-00n",
  ]));

  set("outdoors", "center");

  setup();

  replace_program(ROOM);
}
