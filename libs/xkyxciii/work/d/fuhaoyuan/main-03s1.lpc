#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "花  园");
  set("long", @LONG

    这里是侠客城富豪的花园。
LONG
  );

  set("exits", ([
    "north": __DIR__ "main-03",
    "south": __DIR__ "main-03s2",
  ]));

  set("outdoors", "fuhaoyuan");

  setup();

}
