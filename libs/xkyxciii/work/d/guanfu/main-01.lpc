#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大  院");
  set("long", @LONG
                                                                
    这里是侠客城官府的大院。
LONG
  );

  set("outdoors", "xiakecheng");

  set("exits", ([
    "east": __DIR__ "main-01e",
    "west": __DIR__ "main-01w",
    "south": "/d/center/guanfu",
    "north": __DIR__ "main-02",
  ]));

  setup();

  replace_program(ROOM);
}
