#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "上海滩");
  set("long", @LONG
								
    这里是扬州城西南的上海滩。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "southwest": __DIR__ "yang-sw6",
