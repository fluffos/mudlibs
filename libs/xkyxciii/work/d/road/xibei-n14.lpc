// xibei-n14.c - 西北方向北（绿  洲）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "绿  洲");
  set("long", @LONG
								
    这里是侠客城西北方向北的绿洲。路边插着一个牌子（sign）。
LONG
  );

  set("outdoors", "road");

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([
    "south": __DIR__ "xibei-n13",
    "north": __DIR__ "xibei-n15",
    "west": __DIR__ "xing-e5",
  ]));

  setup();

}

// ┼─│／＼※○
string look_sign(object me) {
  return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
               ▲灵鹫宫  
                  │
      星宿海▲──※
                  │
          昆仑山▲  ▲光明顶
               【西藏】
[2;37;0m
LONG;

}
