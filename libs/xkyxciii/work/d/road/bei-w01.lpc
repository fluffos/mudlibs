#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大官道");
  set("long", @LONG
                                                                
    你走在北京城西的大官道上。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    // "east"  : "/d/beijing/main-gw",
    "west": __DIR__ "bei-w02",
    "east": "/d/road/temp-beijing",
  ]));

  setup();

  replace_program(ROOM);

}
