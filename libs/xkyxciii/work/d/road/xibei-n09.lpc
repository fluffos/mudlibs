#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大沙漠");
  set("long", @LONG
								
    这里是侠客城西北方向北的大沙漠。一走进来，你仿佛迷失了方向。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "east": __DIR__ "xibei-n10",
    "south": __DIR__ "xibei-n09",
    "west": __DIR__ "xibei-n08",
    "north": __DIR__ "xibei-n09",
  ]));

  setup();


}
