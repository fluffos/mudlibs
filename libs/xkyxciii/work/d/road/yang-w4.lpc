#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "江浙水乡");
 	set("long", @LONG
								
    这里是扬州城西的江浙水乡。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"east"  : __DIR__"yang-w3",
		"west"  : __DIR__"yang-w5",
		"south" : __DIR__"cje-harbour-n",
	]));

	setup();

	replace_program(ROOM);

}

