#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大雪山");
  set("long", @LONG
								
    这里是侠客城以西的大雪山。一走进来，你仿佛迷失了方向。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "east": __DIR__ "xia-w11",
    "south": __DIR__ "xia-w12",
    "west": __DIR__ "xia-w12",
    "north": __DIR__ "xia-w13",
  ]));

  setup();


}
