#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "沼泽地");
  set("long", @LONG
								
    这里是侠客城西北方向北的沼泽地。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "south": __DIR__ "xibei-n12",
    "north": __DIR__ "xibei-n14",
  ]));

  setup();

  replace_program(ROOM);

}
