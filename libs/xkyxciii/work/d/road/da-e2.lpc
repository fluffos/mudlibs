#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "云南驿");
  set("long", @LONG
								
    这里是大理城东的云南驿。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "east": __DIR__ "da-e3",
    "west": __DIR__ "da-e1",
  ]));

  setup();

  replace_program(ROOM);

}
