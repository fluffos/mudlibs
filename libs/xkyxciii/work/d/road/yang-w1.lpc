#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大官道");
  set("long", @LONG
                                                                
    这里是扬州城西的大官道。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    //                "east"  : "/d/road/temp-yangzhou",
    "east": "/d/yangzhou/main-gw",
    "west": __DIR__ "yang-w2",
  ]));

  setup();


}
