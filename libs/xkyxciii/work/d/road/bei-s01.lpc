#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "芦沟桥");
        set("long", @LONG
                                                                
    这是北京城的芦沟桥。
LONG
        );

        set("outdoors", "road");

        set("exits", ([
                "south"  : __DIR__"bei-s02",
                // "north"  : "/d/beijing/main-gs",
                // "north"  : "/d/road/temp-beijing",
                // 注：新的北京是由大鱼做的，如果通过试验，可以开放。
                "north"   :  "/d/beijing2/s_gate1",
        ]));

        setup();

        replace_program(ROOM);

}

