// xia-w15.c - 侠客城向西（唐古拉山）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "唐古拉山");
 	set("long", @LONG
								
    这里是侠客城以西的唐古拉山。路边插着一个牌子（sign）。
LONG
	);

	set("outdoors", "road");

	set("item_desc", ([
		"sign": (: look_sign :),
	]) );

 	set("exits", ([
		"east"  : __DIR__"xia-w14",
		"south" : __DIR__"xi-n10",
		"north" : __DIR__"xibei-n01",
	]));

	setup();

}

// ┼─│／＼※○
string look_sign(object me)
{
/*[33m
 ▲星宿海  ▲灵鹫宫  ▲白驼山
        ▲    ▲光明顶 
      昆仑山  │
              ※───【侠客城】
              │
           【西藏】
[2;37;0m
*/
	return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
 ▲星宿海  ▲灵鹫宫  ▲白驼山
              ▲光明顶 
              │
              ※───【侠客城】
              │
           【西藏】
[2;37;0m
LONG ;

}
