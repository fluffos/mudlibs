#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "古  城");
  set("long", @LONG
								
    这里是北京城南的古城。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "south": __DIR__ "bei-s13",
    "north": __DIR__ "bei-s11",
  ]));

  setup();

  replace_program(ROOM);

}
