#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "大运河");
 	set("long", @LONG
								
    这是北京城南大运河。
LONG
	);

	set("outdoors", "road");

 	set("exits", ([
		"south"      : __DIR__"bei-s07",
		"north"      : __DIR__"bei-s05",
	]));

	setup();

	replace_program(ROOM);

}

