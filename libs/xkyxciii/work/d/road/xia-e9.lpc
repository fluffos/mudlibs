// xia-e9.c - 侠客城向东（大禹庙）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "大禹庙");
  set("long", @LONG
								
    这里是侠客城以东的大禹庙。路边插着一个牌子（sign）。
LONG
  );

  set("outdoors", "road");

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("exits", ([
    "southeast": __DIR__ "yang-nw3",
    "west": __DIR__ "xia-e8",
    "north": __DIR__ "huang-s5",
  ]));

  setup();

}

// ┼─│／＼※○
string look_sign(object me) {
  return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
                    【北京】
            ▲黑木崖
                     ▲泰山
                  │
                  │
    【侠客城】──※
                    ＼ 
                    【扬州】
[2;37;0m
LONG;

}
