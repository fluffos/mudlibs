// xia-w10.c - 侠客城向西（岷  山）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create()
{
	set("short", "岷  山");
 	set("long", @LONG
								
    这里是侠客城以西的岷山。路边插着一个牌子（sign）。
LONG
	);

	set("outdoors", "road");

	set("item_desc", ([
		"sign": (: look_sign :),
	]) );

 	set("exits", ([
		"east"  : __DIR__"xia-w09",
		"west"  : __DIR__"xia-w11",
		"south" : __DIR__"xinan-s01",
	]));

	setup();

}

// ┼─│／＼※○
string look_sign(object me)
{
	return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
    光明顶▲           ▲终南山
            ──※──【侠客城】
    【西藏】    │
                ▲峨眉山
[2;37;0m
LONG ;

}
