// hei-se1.c - 黑土崖向东南（白  涧）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "白  涧");
  set("long", @LONG
								
    这里是黑土崖东南的白涧。旁边插着一个牌子（sign）。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "west": __DIR__ "heng-shan-e3",
    "southeast": __DIR__ "hei-se2",
    "northwest": "/d/heimuya/main-01",
  ]));

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  setup();

}

// ┼─│／＼※○
string look_sign(object me) {
  return @LONG
这是一面沾满灰尘的黑木牌子，上面写著：
[33m
                 【北京】
                    │
      黑木崖▲      │
              ＼    │
      恒山▲──※  │
                  ＼│
                    ※
                    │
                  ～～～
[2;37;0m
LONG;

}
