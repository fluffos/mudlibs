#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大官道");
  set("long", @LONG
                                                                
    你走在泉州西北的大官道上。
LONG
  );

  set("outdoors", "road");

  set("exits", ([
    "southeast": "/d/quanzhou/main-gw",
    // "east"       : "/d/quanzhou/main-gw",
    "northwest": __DIR__ "quan-nw2",
  ]));

  setup();


}
