inherit ROOM;

void create() {
  set("short", "华山山麓");
  set("long", @LONG
    这是一个较为开阔的空地，山势到了这里突然间变的层层叠叠。
再往西北方向则是去华山门派的小路，往东北方向则是华山的名胜古
迹：［舍身崖］所在了。在北面好象有一道裂缝（cliff)，看上去就
象一个无底深渊，让人见了，就有种恐惧感。
LONG
  );
  set("item_desc", ([
    "cliff": @TEXT
    一条深不可测的裂缝，你可以试着爬(climb)下去。
TEXT
  ]));

  set("exits", ([
    "northwest": "/d/huashan/huashan5",
    "down": "/d/huashan/huashan3",
    "northeast": "/d/huashan/huashan_5",
  ]));
  set("objects", ([
    __DIR__ "npc/dizi": 1,
  ]));
  set("outdoors", "huashan");

  setup();
  // replace_program(ROOM);
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  object me;

  me = this_player();

  if (arg != "cliff") return 0;

  message_vision("$N手脚并用，小心翼翼地贴着裂缝爬了下去 . . .\n", me);
  tell_room(__DIR__ "qingcao", me->name() + "平安的从上面爬了下来。\n");
  me->move(__DIR__ "qingcao");
  return 1;
}
