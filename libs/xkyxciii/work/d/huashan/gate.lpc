inherit ROOM;

void create() {
  set("short", "华山派大门");
  set("long", @LONG
    这是鼎鼎有名的江湖门派 -- 华山派的大门。一对大石狮子摆在门前，显得
威风凛凛。但是除了那两个石狮子之外，居然没有其他的任何摆设。让人乍眼一
看，好象是一户中等人家的大门摆设一般。两个衣着普通的年轻人一左一右的站
在门口，这一切都显的平凡不过。
LONG
  );
  set("exits", ([
    "west": __DIR__ "wuchang",
    "east": __DIR__ "huashan6",
  ]));
  set("objects", ([
    __DIR__ "npc/dizi": 2,
  ]));
  set("outdoors", "huashan");
  setup();
}
