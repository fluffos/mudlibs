inherit ROOM;

void create() {
  set("short", "华山小路");
  set("long", @LONG
    这是一个较为偏僻的小路，山势到了这里突然间变的非常险峻。
路的两旁杂草丛生，显得此处荒凉无比。由于此处接近舍身崖，更显
的此处充满哀伤。路旁树了一个小木牌：
[35m
		［舍身崖］，北上１０里。
[2;30;0m
LONG
  );
  set("exits", ([
    "southwest": "/d/huashan/huashan4",
    "northup": "/d/huashan/sheshen",
  ]));
  set("objects", ([
    __DIR__ "npc/lu_dayou": 1,
    __DIR__ "npc/monkey": 1,
  ]));
  set("outdoors", "huashan");

  setup();
  replace_program(ROOM);
}
