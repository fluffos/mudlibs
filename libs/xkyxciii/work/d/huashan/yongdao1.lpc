
inherit ROOM;

void create()
{
        set("short", "甬 道");
        set("long", @LONG
    借著微弱的光亮，你看到一条黑漆漆的甬道向下延伸，不知是通向何
处地方。但是你摸了摸石壁，觉得这条甬道绝对不是天然形成的，应该是
人力所为。但是对于前方的未知，是生是死，只能听天由命。
LONG
        );
        set("exits", ([ 
	  "northdown"    : __DIR__"yongdao2",
]));
        set("objects", ([
                __DIR__"obj/skeleton" : 1,
                __DIR__"obj/axe1" : 1,
       ]) );
        setup();
}

void init()
{
        add_action("do_peen", "peen");
}
int do_peen(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要敲开什么？\n");
                return 1;
        }
        if( arg == "小片石壁" || arg == "small stone")
        {
        me = this_player();
        message_vision("$N奋力敲开石壁，一道强烈的光线令你睁不开眼。\n", me);
	if( !query("exits/southup") ) {
	set("exits/southup", __DIR__"siguoya");
	call_out("close_path", 9);
	}
        return 1;
        }
        else
        {
                write("你不可以敲"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/southup") ) return;
        message("vision",
"一个无名老叟突然出现在石壁面前，对着甬道轻叹一声，拣起石块封住了甬道。然后消失了！\n",
                this_object() );
		delete("exits/southup");
}
