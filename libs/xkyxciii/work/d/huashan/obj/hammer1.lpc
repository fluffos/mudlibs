#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("楞铁锤", ({ "tie hammer", "hammer" }));
  set_weight(18000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", "这是一对很重的铁锤。\n");
    set("value", 0);
    set("material", "iron");
    set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_hammer(45);
  setup();
}
