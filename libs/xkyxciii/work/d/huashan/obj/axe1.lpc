
#include <weapon.h>
#include <ansi.h>

inherit HAMMER;

void create()
{
        set_name( WHT "崩了口的开山斧" NOR, ({ "axe" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是一把锋利的开山斧，就可惜崩了口。\n");
                set("value", 0);
                set("material", "iron");
                set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(35);
        setup();
}
