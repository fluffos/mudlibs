// sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("用布包了剑尖的木剑", ({ "sword" }) );
	set_weight(400);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把华山弟子练武时使用的木剑。\n");
		set("value", 0);
		set("material", "wood");
		set("rigidity", 80);
		set("wield_msg", "$N从剑鞘中抽出一把$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
	}
	init_sword(3);
	setup();
}
