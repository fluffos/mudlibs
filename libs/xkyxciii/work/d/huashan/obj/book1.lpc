inherit ITEM;

void create() {
  set_name("紫霞神功秘籍", ({ "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这是华山镇山之宝 -- 紫霞神功秘籍。\n");
    set("value", 0);
    set("material", "paper");
    set("skill", ([
      "name": "zixia-force",
      "exp_required": 100000,

      "sen_cost": 60,
      "difficulty": 60,

      "max_skill": 99

    ]));
  }
}
