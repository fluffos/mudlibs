#include <ansi.h>

inherit NPC;

void create() {
  set_name("施戴子", ({ "shi daizi", "shi", "master" }));
  set("nickname", "四师兄");

  create_family("华山派", 14, "弟子");
  set("rank_info/respect", "大侠");
  set("class", "swordman");

  set("gender", "男性");
  set("age", 32);

  set("long", @LONG
    华山派的弟子，由于此人一向处事行为比较底调，所以在华山中是比较
普通的一个。
LONG
  );

  // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
  // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
  // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
  // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎


  set("str", 18);         // 膂力         
  set("cps", 18);         // 定力
  set("cor", 18);         // 胆识         
  set("per", 18);         // 容貌
  set("int", 18);         // 悟性         
  set("con", 18);         // 根骨
  set("spi", 18);         // 灵性         
  set("kar", 18);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 1000); set("force", 1500); set("force_factor", 25);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 1200000);
  // set("SEN", 0);

  set_skill("force", 110); set_skill("zixia-force", 110);
  set_skill("sword", 110); set_skill("huashan-sword", 110);
  set_skill("unarmed", 110); set_skill("huashan-zhang", 110);
  set_skill("parry", 110);
  set_skill("move", 110); set_skill("huashan-steps", 110);
  set_skill("dodge", 110);
  set_skill("literate", 110);

  map_skill("force", "zixia-force");
  map_skill("sword", "huashan-sword");
  map_skill("blade", "fanliangyi-blade");
  map_skill("unarmed", "huashan-zhang");
  map_skill("parry", "huashan-sword");
  map_skill("move", "huashan-steps");
  map_skill("dodge", "huashan-steps");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}
