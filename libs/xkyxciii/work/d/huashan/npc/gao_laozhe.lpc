#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("高老者", ({ "gao laozhe", "gao", "master" }));

  create_family("华山派", 23, "弟子");
  set("rank_info/respect", "大侠");
  set("class", "swordman");

  set("gender", "男性");
  set("age", 57);

  set("long", @LONG
他是华山派的弟子。
LONG
  );

  // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
  // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
  // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
  // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 3000); set("force", 5000); set("force_factor", 200);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 5000000);
  // set("SEN", 0);

  set_skill("force", 150); set_skill("taixuan-force", 150);
  set_skill("sword", 150); set_skill("dugu-sword", 150);
  set_skill("unarmed", 150); set_skill("xianglong-zhang", 150);
  set_skill("parry", 150);
  set_skill("move", 150); set_skill("lingbo-steps", 150);
  set_skill("dodge", 150);
  set_skill("literate", 150);

  map_skill("force", "taixuan-force");
  map_skill("sword", "dugu-sword");
  map_skill("parry", "dugu-sword");
  map_skill("unarmed", "xianglong-zhang");
  map_skill("move", "lingbo-steps");
  map_skill("dodge", "lingbo-steps");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: perform_action, "sword.counterattack" :),
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}

void attempt_apprentice(object ob) {
  return;
}
