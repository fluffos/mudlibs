// 华山派NPC -- 封不平 （feng_buping.c）
// Dboykey(Key) 孔雀		1998.2.23

// #include <npc.h>
#include <ansi.h>

inherit NPC;

void create() {
  set_name("封不平", ({ "feng buping", "feng", "master" }));
  set("nickname", "华山弃徒");

  create_family("华山派", 13, "弟子");
  set("rank_info/respect", "前辈");
  set("class", "swordman");

  set("gender", "男性");
  set("age", 42);

  set("long", @LONG
他是华山派剑宗弟子。由于当年气宗和剑宗之间的斗争，剑宗败在气宗的
手下，而剑宗弟子也给气宗的掌门人驱逐，成为华山弃徒。
LONG
  );

  // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
  // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
  // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
  // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎

  set("str", 30);         // 膂力         
  set("cps", 20);         // 定力
  set("cor", 20);         // 胆识         
  set("per", 10);         // 容貌
  set("int", 15);         // 悟性         
  set("con", 20);         // 根骨
  set("spi", 15);         // 灵性         
  set("kar", 20);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 2000); set("force_factor", 10);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 2500000);
  // set("SEN", 0);

  set_skill("force", 100); set_skill("zixia-force", 100);
  set_skill("sword", 180); set_skill("huashan-sword", 180);
  set_skill("unarmed", 100); set_skill("huashan-zhang", 100);
  set_skill("parry", 150);
  set_skill("move", 100); set_skill("huashan-steps", 100);
  set_skill("dodge", 100);
  set_skill("literate", 80);

  map_skill("force", "zixia-force");
  map_skill("sword", "huashan-sword");
  map_skill("blade", "fanliangyi-blade");
  map_skill("unarmed", "huashan-zhang");
  map_skill("parry", "huashan-sword");
  map_skill("move", "huashan-steps");
  map_skill("dodge", "huashan-steps");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
  }));

  setup();

  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}

void init() {
  object me;
  string fam;
  ::init();
  me = this_player();
  fam = (string)me->query("family/family_name");
  if (interactive(me) && !is_fighting()) {
    if (fam == "华山派") call_out("rockkill", 1, me);
  }
}

int rockkill(object me) {
  command("heihei");
  say("封不平对" + me->name() + "喝道：" + RANK_D->query_rude(me)
    + "，竟然让我在这里碰到华山弟子！拿命来！\n");
  this_object()->kill_ob(me);
  return 1;
}
