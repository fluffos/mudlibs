
inherit NPC;

void create()
{
        set_name("金冠巨蟒", ({ "snake" }) );
        set("race", "野兽");
        set("age", 15);
        set("long", "一条水桶粗细的巨蟒，它的头部生了一个象它的头一般大的金角。\n");

        set("limbs", ({ "头部", "身体", "尾巴", "七寸" }) );
        set("verbs", ({ "bite" }) );
        set("attitude", "aggressive");
        set_skill("dodge", 150);
        set("combat_exp", 999999);
	set("bellicosity", 30000 );
	set_temp("apply/attack",200);
	set_temp("apply/damage",60);
        setup();
}
