// #include <npc.h>
#include <ansi.h>

inherit NPC;

void create()
{
        set_name("令狐冲", ({ "linghu chong", "linghu", "master" }));
        set("nickname", "大师兄");

        create_family("华山派", 14, "弟子");
        set("rank_info/respect", "大侠");
        set("class", "swordman");

        set("gender", "男性" );
        set("age", 26);

        set("long",@LONG
他是华山派的掌门大弟子，由于他是个孤儿，所以从小由岳不群夫妇带大。
而因此他无可非议的成为华山派的大师兄。此人生性豪爽，好结交朋友，也
因为如此，经常受到掌门人的责骂。
LONG
        );

        // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
        // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
        // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
        // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎

        set("str", 25);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 23);         // 容貌
        set("int", 20);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 10);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 2000);        set("force_factor", 30);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 2000000);
        // set("SEN", 0);

        set_skill("force",    100);     set_skill("zixia-force", 100);
        set_skill("sword",    100);     set_skill("dugu-sword", 170);
        set_skill("parry",    100);
        set_skill("move",     100);     set_skill("huashan-steps", 100);
        set_skill("dodge",    100);
        set_skill("literate", 60);

        map_skill("force",      "zixia-force");
        map_skill("sword",      "dugu-sword");
        map_skill("parry",      "dugu-sword");
        map_skill("move",       "huashan-steps");
        map_skill("dodge",      "huashan-steps");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "recover" :),
        }) );
        
        setup();

        carry_object("/obj/cloth/cloth")->wear();
        carry_object("/obj/weapon/sword")->wield();
}
