
inherit ROOM;
void create()
{
        set("short","华山山脚");
        set("long",@LONG
    脚下为碎石黄土路，两侧是高耸入云的华山，向上仰望乃似无边无际
穹空，向北就是上华山的唯一小山路(road)，乍眼一看，令人联想到古人
有曰：［自古华山一条路］，名不虚传。
LONG
        ); 

        set("item_desc", ([
                "road" : "一条小山路缘山壁而上，若无绝佳的体力就好不要轻意向上爬(climb)。\n",
        ]) );
        
        set("exits",([ 
                "down" : "/d/huashan/shanjiao",
        ]) ); 
        
        setup();
        
} 

void init()
{
        add_action("do_climb", "climb");
}

int do_climb(string arg)
{ 
        object me;
        
        me=this_player();
        
        if ( arg != "road" ) return 0;

        message_vision("$N手脚并用，小心翼翼地沿著小路向上攀缘上去了\n",me);
                       
        me->receive_damage("gin", 30);
        me->receive_damage("kee", 40);
        me->receive_damage("sen", 20);
        
        if ( ((int)me->query("gin") < 0) ||
             ((int)me->query("kee") < 0) ||
             ((int)me->query("sen") < 0) ) {   
                tell_room(__DIR__"huashan1",me->name()+"体力不支了。\n");
                me->move(__DIR__"huashan1");
                return 1;
        }
        
        tell_room(__DIR__"huashan2",me->name()+"平安的从下面爬了上来。\n");
        me->move(__DIR__"huashan2");
        return 1;
}

