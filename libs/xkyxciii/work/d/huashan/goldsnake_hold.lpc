inherit ROOM;

void create() {
  set("short", "无 名 山 洞");
  set("long", @LONG
    方圆丈许的山洞还留着人工斧凿的痕迹。涓涓的细流顺着洞壁往下
流，发出潺潺的水声。借着从出口处透入的天光，你发现一具骷髅依坐
在洞边。前面两步左右隐约中看到有一把剑柄漏在石壁上，地下周遭的
泥土有点翻动过的痕迹。
LONG
  );
  set("exits", ([

  ]));
  set("objects", ([
    __DIR__ "obj/skeleton": 1,
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("item_desc", ([
    "剑柄": "
                        你仔细地看了下，见到剑柄下还有点剑身，看来可以试拨一下！\n",
  ]));

  setup();

}

void init() {
  add_action("do_pull", "pull");
  add_action("do_search", "search");
}

int do_pull(string arg) {
  object ob;
  ob = this_player();
  if ((int)ob->query("force") < 500) {
    write("你的内力不够！\n"); return 1;
  }
  if (ob->is_busy())
    return notify_fail("你的动作还没有完成，不能移动。\n");
  if (arg != "剑柄") {
    message_vision("$N将一股内力运往双臂，用力一拉．．．\n", ob);
    ob->start_busy(2);
    call_out("pull_obj", 4, ob);
  }
  return 1;
}

int pull_obj(object me) {
  int kar;
  int exp;
  object gold_sword;

  if (!(this_object()->query("marks/没了"))) {
    kar = (int)me->query("kar");
    exp = (int)me->query("combat_exp");
    if (kar > 60) kar = 60;
    if ((random(60 - kar) < 5) && exp >= 2500000) {
      this_object()->set("marks/没了", 1);
      write("只见你“刷”的一声，从石缝中拔出一把闪着金光的蛇型剑！！\n", me);
      me->add("force", -500);
      seteuid(geteuid(me));
      gold_sword = new("/d/huashan/obj/gold_sword");
      gold_sword->move(me);
    } else {
      me->add("force", -500);
      message_vision("$N仔细的一看，原来那只是石头的阴影。\n", me);
    }
  } else {
    message_vision("$N仔细的一看，原来那只是石头的阴影。\n", me);
    me->add("force", -500);
  }
  return 1;
}

int do_search(string arg) {
  object ob;

  ob = this_player();
  if (ob->is_busy())
    return notify_fail("你的动作还没有完成，不能移动。\n");
  message_vision("$N仔细地查看地上松动的泥土 . . . \n", ob);
  ob->start_busy(2);
  call_out("search_obj", 4, ob);
  return 1;
}

int search_obj(object me) {
  int kar;
  int exp;
  object wimble;

  if (!(this_object()->query("marks/没了"))) {
    kar = (int)me->query("kar");
    exp = (int)me->query("combat_exp");
    if (kar > 60) kar = 60;
    if ((random(60 - kar) < 5) && exp >= 2000000) {
      this_object()->set("marks/没了", 1);
      message_vision("$N找到了一样东西，放进了怀里。\n", me);
      seteuid(geteuid(me));
      wimble = new("/d/huashan/obj/gold_wimble");
      wimble->move(me);
    } else
      message_vision("$N什么都没找到。\n", me);
  } else
    message_vision("$N什么都没找到。\n", me);

  return 1;
}

void reset() {
  ::reset();

  delete("marks/没了");
}
