
inherit ROOM;

void create()
{
        set("short", "华山山麓");
        set("long", @LONG
    这是一个较为开阔的空地，山势到了这里突然间变的层层叠叠。
再往西北方向则是去华山门派的小路，往东南方向则是去华山的名胜
古迹［舍身崖］的路。在此向东可以看得到一条深渊般的裂缝。
LONG
        );
        set("exits", ([ 
		"northup"    : "/d/huashan/jindi", 
		"west"       : "/d/huashan/gate", 
		"southdown"  : "/d/huashan/huashan5",
		     ]));
        set("objects", ([
                __DIR__"npc/shi_daizi" : 1,
       ]) );

        set("outdoors", "huashan");
        setup();
}


void init()
{
        add_action("do_climb", "climb");
}

int do_climb(string arg)
{ 
        object me;
        
        me=this_player();
        
        if ( arg != "cliff" ) return 0;

        message_vision("$N手脚并用，小心翼翼地贴着裂缝爬了下去 . . .\n",me);
        tell_room(__DIR__"qingcao",me->name()+"平安的从上面爬了下来。\n");
        me->move(__DIR__"qingcao");
        return 1;
}

