
inherit ROOM;
#include <room.h>
void create()
{
        set("short", "华山派大厅");
        set("long", @LONG
    华山派的大厅，也是华山派掌门人处理各种事情的地方。一个大大的［武］
高挂在正中央，下面是华山派开山祖师的画像，画像前摆着一个香炉，正冒着娄
娄香烟。两排旧的木椅整齐的放在两边，一张比较大点的红木椅放在两排木椅的
正中间，显得鹤立鸡群。西面是掌门人的睡房。
LONG
        );
        set("exits", ([ 
	  "east"    : __DIR__"wuchang",
	  "south"    : __DIR__"xiuxishi1",
	  "west"    : __DIR__"xiangfang",
	  "north"    : __DIR__"xiuxishi2",
]));
        set("objects", ([
                __DIR__"npc/lao_denuo" : 1,
                __DIR__"npc/master-yue" : 1,
                __DIR__"npc/master-ning" : 1,
       ]) );
        setup();
        create_door("west", "木门", "east", DOOR_CLOSED);

}

int valid_leave(object me, string dir)
{
	object ob;
        if( dir == "west" && ob=present("lao denuo", this_object()))
        {
		return notify_fail("这个方向的路被"+ob->name()+"挡住了 。\n");
	}
// 门没开也能leave???
//                return 1
// change bye fan
              return ::valid_leave(me, dir);
}
