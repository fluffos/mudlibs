
inherit ROOM;
void create()
{
        set("short", "华山石群");
        set("long", @LONG
    这里有一大片岩石，大大小小，各色各样，千奇百怪的岩石。大的
如天柱排空，高耸入云，直插入穹苍中；小的也高有数十丈，如千奇百
怪的飞禽走兽，静静地蹲据在那里。每当风吹过，一阵阵的历啸从林中
发出，让人心中忐忑不安。向南有一条崎岖的小山路(road)一直延伸。
LONG
        );

        set("item_desc", ([
                "road" : @TEXT
    一条小山路缘山壁而下，若无绝佳的体力就好不要轻意向下爬(climb)。
TEXT
        ]) );
        
        set("exits",([ 
                "east" : "/d/huashan/huashan3",
        ]) ); 
        set("objects", ([
                __DIR__"npc/liang_fa" : 1,
       ]) );
        
        setup();
        
} 

void init()
{
        add_action("do_climb", "climb");
}

int do_climb(string arg)
{ 
        object me;
        
        me=this_player();
        
        if ( arg != "road" ) return 0;

        message_vision("$N手脚并用，小心翼翼地沿著小路向下攀缘下去了\n",me);
                       
        me->receive_damage("gin", 30);
        me->receive_damage("kee", 40);
        me->receive_damage("sen", 20);
        
        if ( ((int)me->query("gin") < 0) ||
             ((int)me->query("kee") < 0) ||
             ((int)me->query("sen") < 0) ) {   
                tell_room(__DIR__"huashan2",me->name()+"体力不支了。\n");
                me->move(__DIR__"huashan2");
                return 1;
        }
        
        tell_room(__DIR__"huashan1",me->name()+"平安的从上面爬了下来。\n");
        me->move(__DIR__"huashan1");
        return 1;
}

