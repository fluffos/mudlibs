
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "小 草 坪");
	set("long", "    一块绿油油的小草坪。放眼四周是高过盖顶的杂乱"+BOLD+"茅草"+NOR+"。由于是崖\n"+
"底，四周显得灰蒙蒙的一片。空中不断地传来一阵阵的鹰鸣兽吼，更显\n"+
"得此地阴森恐怖。还是快点离开这里为妙。\n",
	);
        set("objects", ([
                __DIR__"npc/snake" : 1,
       ]) );
        set("item_desc", ([
                "茅草": "
                        好茂密的茅草，拨开(pushaside)看看后面有什么呢？！\n",
        ]) );

	set("outdoors", "huashan");
	setup();
}

void init()
{
        add_action("do_push", "pushaside");
}
int do_push(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要拨开什么？\n");
                return 1;
        }
        if( arg == "茅草" || arg == "草")
        {
        me = this_player();
        message_vision("$N拨开路边的茅草，发现了一个小山洞的入口。\n", me);
	if( !query("exits/enter") ) {
	set("exits/enter", __DIR__"goldsnake_hold");
	call_out("close_path", 5);
	}
        return 1;
        }
        else
        {
                write("你不可以钻"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/enter") ) return;
        message("vision",
"一阵风吹过，茅草晃了晃，又淹没了小山洞的入口。\n",
                this_object() );
		delete("exits/enter");
}
