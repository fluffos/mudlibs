
inherit ROOM;

void create()
{
	set("short", "青草地");
	set("long", @LONG
    你眼前忽然一亮，出现在你眼前的是一片在群山中的开阔草地，
四周都是灰蒙蒙的一片。空中不断地传来一阵阵的鹰鸣兽吼，更显得
此地阴森恐怖。还是快点离开这里为妙。
LONG
	);
	set("exits", ([ 
//		"north" : "/d/huashan/maoliao",
	]));
        set("objects", ([
                __DIR__"npc/linghu_chong" : 1,
       ]) );
        set("item_desc", ([
                "草": "
                        草地的尽头好象有点什么东西 . . .\n",
        ]) );
	set("outdoors", "huashan");
	setup();
}

void init()
{
        add_action("do_push", "pushaside");
        add_action("do_climb", "climb");
}
int do_push(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要拨开什么？\n");
                return 1;
        }
        if( arg == "青草" || arg == "草")
        {
        me = this_player();
        message_vision("$N拨开路边的青草，发现了一条向北小路。\n", me);
	if( !query("exits/north") ) {
	set("exits/north", __DIR__"maoliao");
	call_out("close_path", 5);
	}
        return 1;
        }
        else
        {
                write("你不可以钻"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/north") ) return;
        message("vision",
"一阵风吹过，青草晃了晃，又淹没了小路。\n",
                this_object() );
		delete("exits/north");
}

int do_climb(string arg)
{ 
        object me;
        
        me=this_player();
        
        if ( arg != "cliff" ) return 0;

        message_vision("$N手脚并用，小心翼翼地贴着裂缝爬了上去 . . .\n",me);
        tell_room(__DIR__"huashan6",me->name()+"平安的从下面爬了上来。\n");
        me->move(__DIR__"huashan6");
        return 1;
}
