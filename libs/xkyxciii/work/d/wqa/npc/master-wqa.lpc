// master-wqa.c 

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(HIW"梦灵"NOR, ({ "master wqa", "master" }));

        set("long",@LONG
她是神仙山庄的小姑娘，掌管神仙山庄的梦幻时空。她身着雪白的衣衫，
雪白的长裙，身形苗条婀娜，气定神闲，轻风动裾，飘飘兮如仙子下凡尘。
你不禁想起庄子的描述：藐姑射之山，有神人居焉，肌肤若冰雪，绰约若
处子，不食五谷，吸风饮露。
LONG
        );

        set("gender", "女性" );
        set("age", 18);

        set("str", 50);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 50);         // 悟性         
        set("con", 50);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 1000);         set("atman", 2000);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 200);
        set("max_mana", 1000);             set("mana", 2000);

        set("combat_exp", 8000000);
        // set("SEN",10000000);

        set_skill("force",    300);     set_skill("bahuang-force", 130);
        set_skill("sword",    300);     set_skill("ruyixiaoyao-sword", 150);
        set_skill("unarmed",  300);     set_skill("tianxian-zhang", 150);
        set_skill("parry",    300);
        set_skill("move",     300);     set_skill("feixian-steps", 150);
        set_skill("dodge",    300);
        set_skill("literate", 300);
        set_skill("spells", 300);       set_skill("necromancy", 200);
        set_skill("taoism", 300);

        map_skill("force",      "bahuang-force");
        map_skill("sword",      "ruyixiaoyao-sword");
        map_skill("unarmed",    "tianxian-zhang");
        map_skill("parry",      "ruyixiaoyao-sword");
        map_skill("move",       "feixian-steps");
        map_skill("dodge",      "feixian-steps");
        map_skill("spells",     "necromancy");

        setup();

        carry_object("/obj/cloth/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
                add_action("do_change","change");
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;

	message_vision( HIW "\n梦灵对$N说道：'你已经回到了现实世界，你是否决定用声望兑换经验？如果要兑换，\n" NOR, ob);
	message_vision( HIW "\t请输入'change'；如果不换请使用quit或者go继续。'\n" NOR, ob);

	return;
}

int do_change(string arg)
{ 
        int i, n;
        object ob;

	ob = this_player();

	if ( ob->query_temp("wqa's room/change") >= 1 )
		return notify_fail("你已经进行过兑换了，下次来到再进行兑换吧。\n");

        i = ob->query_temp("wqa's room/point");
        if( i <= 0 ) i = 1;
        n = i / 2 + random( i / 2 + 1 );

        tell_object( ob, HIW "梦灵对你说：你现在总共有" 
                + chinese_number(i) + "点社会声望。\n" NOR );
        tell_object( ob, HIW "梦灵对你说：它可以转化为" 
                + chinese_number(n) + "点社会经验。\n" NOR );
        tell_object( ob, HIW "梦灵对你说：而且我再送你" 
                + chinese_number(i/2+1) + "点社会声望。\n" NOR );

        ob->add("combat_exp", n);
        ob->set_temp("wqa's room/point", i / 2 + 1);
	ob->set_temp("wqa's room/change",1);

	return 1;
}
