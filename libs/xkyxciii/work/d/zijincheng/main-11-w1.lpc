#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "太极殿");
  set("long", @LONG

    这里是紫禁城的太极殿。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-11",
    "south": __DIR__ "main-10-w1",
    "west": __DIR__ "main-11-w2",
    "north": __DIR__ "main-12-w1",
  ]));

  setup();

  replace_program(ROOM);
}
