#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("黄药师", ({ "huang yaoshi", "huang", "master" }));

  set("long", @LONG
他是桃花岛主。他才气横溢，武学、天文、地理、文学、数术、易学遁术、
奇门五行无所不精，乃是当世奇人。他行事如行云流水，潇洒自如，黑白
两道全不卖帐。又因桃花岛位于东海之滨，江湖中人称“东邪”。
LONG
  );

  create_family("桃花岛", 1, "祖师");
  set("rank_info/respect", "岛主");
  set("gender", "男性");
  set("age", 50);

  set("str", 30);         // 膂力         
  set("cps", 30);         // 定力
  set("cor", 30);         // 胆识         
  set("per", 30);         // 容貌
  set("int", 30);         // 悟性         
  set("con", 30);         // 根骨
  set("spi", 30);         // 灵性         
  set("kar", 30);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 2000); set("force", 4000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 8000000);
  set("SEN", 400);

  set_skill("force", 220); set_skill("luoying-force", 220);
  set_skill("sword", 220); set_skill("yuxiao-sword", 220);
  set_skill("unarmed", 160); set_skill("luoying-zhang", 160);
  set_skill("parry", 160);
  set_skill("move", 150); set_skill("xuanfeng-steps", 150);
  set_skill("dodge", 150);
  set_skill("literate", 200);

  map_skill("force", "luoying-force");
  map_skill("sword", "yuxiao-sword");
  map_skill("unarmed", "luoying-zhang");
  map_skill("parry", "yuxiao-sword");
  map_skill("move", "xuanfeng-steps");
  map_skill("dodge", "xuanfeng-steps");
  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  setup();

  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wear();
}

void attempt_apprentice(object ob) {
  /*
        if( ((string)ob->query("gender") != "男性")) {
                command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，我不收女弟子的。");
                return;
        } 

        if( ((int)ob->query("int") < 20)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
*/
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}

void init() {
  add_action("give_quest", "quest");
}
