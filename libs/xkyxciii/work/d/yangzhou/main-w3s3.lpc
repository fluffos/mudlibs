// main-w3s3.c - 扬州城－荷花池

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "荷花池");
        set("long", @LONG

    这里是扬州城的荷花池。
LONG
        );

        set("city", 1);
        set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-w2s3",
                // "south" : __DIR__"main-w3s4",
                // "west"  : __DIR__"main-w4s3",
                "north" : __DIR__"main-w3s2",
        ]));

        setup();

        replace_program(ROOM);
}
