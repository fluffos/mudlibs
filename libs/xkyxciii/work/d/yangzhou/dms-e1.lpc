// dms-e1.c - 扬州城－大雄宝殿

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大雄宝殿");
  set("long", @LONG

    这里是扬州城大明寺的大雄宝殿。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "dms-e2",
    "south": __DIR__ "dms-e1s1",
    "west": __DIR__ "dms",
    "north": __DIR__ "dms-e1n1",
  ]));

  setup();

  replace_program(ROOM);
}
