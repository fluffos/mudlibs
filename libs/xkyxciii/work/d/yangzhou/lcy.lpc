// lcy.c - 扬州城－大  厅

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "大  厅");
        set("long", @LONG

    这里是扬州城丽春院的大  厅。
LONG
        );

        set("city", 1);
        // set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"lcy-e1",
                // "south" : __DIR__"lcy",
                "west"  : __DIR__"lcy-w1",
                "north" : __DIR__"lcy-n1",
                "out"   : __DIR__"main-w3n2",
        ]));

        set("objects", ([
                "/d/qianjinlou/npc/mother": 1,
                "/d/qianjinlou/npc/mingji": 1,
                "/d/qianjinlou/npc/guinu": 1,
                "/d/qianjinlou/npc/jinu": 1,
       ]));
        setup();

        replace_program(ROOM);
}
