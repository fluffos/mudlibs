#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "西城门");
        set("long", @LONG

    这里是扬州城的西城门。
LONG
        );

        set("city", 1);
        set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-w3",
                "west"  : "/d/road/yang-w1", 
        ]));

        setup();

        replace_program(ROOM);
}
