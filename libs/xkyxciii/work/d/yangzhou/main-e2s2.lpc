// main-e2s2.c - 扬州城－杂货铺

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "杂货铺");
        set("long", @LONG

    这里是扬州城的杂货铺。
LONG
        );

        set("city", 1);
        // set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-e3s2",
                "south" : __DIR__"main-e2s3",
                "west"  : __DIR__"main-e1s2",
                "north" : __DIR__"main-e2s1",
        ]));

        set("objects", ([
                "/d/center/npc/seller-zhp" : 1,
                "/d/center/npc/rat" : 2,
          ]));
        setup();

        replace_program(ROOM);
}
