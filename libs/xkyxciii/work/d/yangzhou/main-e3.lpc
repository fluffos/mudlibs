// main-e3.c - 扬州城－东大街

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "东大街");
        set("long", @LONG

    这里是扬州城的东大街。
LONG
        );

        set("city", 1);
        set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"main-ge",
                "south" : __DIR__"main-e3s1",
                "west"  : __DIR__"main-e2",
                "north" : __DIR__"main-e3n1",
        ]));

        setup();

        replace_program(ROOM);
}
