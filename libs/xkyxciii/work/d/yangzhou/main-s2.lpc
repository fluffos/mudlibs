// main-s2.c - 扬州城－南大街

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "南大街");
  set("long", @LONG

    这里是扬州城的南大街。
LONG
  );

  set("city", 1);
  set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-e1s2",
    "south": __DIR__ "main-s3",
    "west": __DIR__ "main-w1s2",
    "north": __DIR__ "main-s1",
  ]));

  set("objects", ([
    "/obj/npc/rascal": 1,
  ]));
  setup();

}
