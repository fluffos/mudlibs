// main-w1s1.c - 扬州城－客  栈

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "客  栈");
  set("long", @LONG

    这里是扬州城的客  栈。
LONG
  );

  set("city", 1);
  // set("outdoors", "yangzhou");

  set("exits", ([
    "east": __DIR__ "main-s1",
    "south": __DIR__ "main-w1s2",
    "west": __DIR__ "main-w2s1",
    "north": __DIR__ "main-w1",
  ]));

  set("objects", ([
    "/d/center/npc/waiter": 1,
    "/d/center/npc/guniang": 1,
    "/d/center/npc/lvke": 2,
    "/d/center/npc/gongzi": 1,
  ]));
  setup();

  replace_program(ROOM);
}
