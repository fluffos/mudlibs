#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "秋声馆");
        set("long", @LONG

    这里是扬州城丽春院的秋声馆。
LONG
        );

        set("city", 1);
        // set("outdoors", "yangzhou");

        set("exits", ([
                "east"  : __DIR__"lcy-n1",
                "south" : __DIR__"lcy-w1",
                // "west"  : __DIR__"lcy-w1n1",
                "north" : __DIR__"lcy-w1n2",
        ]));

        setup();

        replace_program(ROOM);
}
