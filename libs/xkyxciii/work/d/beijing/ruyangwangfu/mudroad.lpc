// mudroad.c


#include <room.h>

inherit ROOM;

void create() {
  set("short", "小路");
  set("long", @LONG
王府前院的一条小路。连接大厅和正门。
LONG
  );
  set("exits", ([
    "south": __DIR__ "door1",
    "north": __DIR__ "zoulang2"
  ]));

  set("outdoors", "beijing");
  set("item_desc", ([
    "door": (: look_door, "south" :),
  ]));
  /*	set("objects", ([
              "/d/npc/sungoku" : 1,
		"/d/snow/npc/waiter" : 1 ]) );
*/
  create_door("south", "红漆大门", "north", DOOR_CLOSED);

  setup();
}
