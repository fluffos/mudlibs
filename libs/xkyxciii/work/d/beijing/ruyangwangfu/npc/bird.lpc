#include <ansi.h>

inherit NPC;

void create()
{
	set_name("小鸟", ({ "bird" }));

        set("long", @LONG
一只小鸟。
LONG
	);

	set("race", "野兽");
	set("limbs", ({ "头部", "身体", "翅膀", "双脚", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );
        set("age", 1);

	set("str", 24);		// 膂力		
	set("cor", 26);		// 胆识		

	set("combat_exp", 100);

	set("eatable",1);
	set("afterdie","/obj/food/bird-meat");

	set_temp("apply/attack", 0);
	set_temp("apply/armor", 0);
	set_temp("apply/damage", 0);
	set_temp("apply/dodge", 100);

	setup();
}
