// wangye.c
//王爷

inherit NPC;
inherit F_VENDOR;

int ask_me_1();

void create() {
  set_name("汝阳王", ({ "ruyang wang", "wang" }));
  set("gender", "男性");
  set("age", 50);
  set("long",
    "虎背熊腰，威风凛凛，一看就知道他不是一个普通人。\n");
  set("per", 27);         // 容貌
  set("combat_exp", 1000);
  set("attitude", "friendly");
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set("inquiry", ([
    "郡主": (: ask_me_1 :),
    "汝阳郡主": (: ask_me_1 :),
  ]));


  set("score", 100);
  set("SEN", -100);

  setup();
}

int ask_me_1() {

  object ob;
  ob = this_player();
  command("say 小女和几个家丁到后山打猎去了。" + RANK_D->query_respect(ob)
    + "找她有什么事吗？");
  ob->set_temp("ask_wang", 1);
  return 1;
}
