// zhaomin.c
//  赵敏

#include <ansi.h>

inherit NPC;

int consider();

void create()
{
        set_name("赵敏", ({ "zhao min", "zhao","junzhu" }) );
	 set("title","郡主");
        set("gender", "女性");
        set("age", 20);
        set("long",
@LONG
浓眉大眼，穿着一副粉红色的软甲，英资煞爽，非常美艳。
LONG
);
        set("attitude", "friendly");

        set("str", 18);
        set("int", 30);
        set("spi", 28);
        set("per", 30);
        set("cps", 22);
	 set("kar", 28);

        set("combat_exp", 5000);
        set("SEN",100);
        set("score", 20000);

        set("inquiry", ([
                "黑玉断续膏" : (: consider :),
                "帮忙"       : "有什么难题尽管说吧。",
                "帮助"       : "有什么难题尽管说吧。",
                "难事"       : "有什么难题尽管说吧。",

        ]) );



        set_skill("unarmed", 50);
        set_skill("sword", 50);
        set_skill("force", 30);
        set_skill("parry", 60);
        set_skill("dodge", 80);
        set_skill("literate", 100);

        set_temp("apply/defense", 50);
        set_temp("apply/attack",30);

        setup();
     	carry_object("/d/beijing/ruyangwangfu/obj/pink-jia")->wear();	// 装备


}


int consider()
{
   object ob,me,ob1;
   int test;
   string test1;
   
   ob=this_player();
   me=this_object();
   
   test =ob->query("kar");
   
   if( ob->name()=="张无忌" )
        {
          if(  me->query("heiyu") || random( ob->query("kar") )<9 )  //就算有也和福缘有关。
             {
                command("say 对不起哦。无忌哥哥，黑玉断续膏炼制不易，现在已经没了。要再过一段时间才炼好。");
                me->set("heiyu",1);
                return 1;
             }
          else
             {
                command("say 无忌哥哥要的东西，没问题。");
                ob1 = new("/d/beijing/ruyangwangfu/obj/heiyu");
                ob1->move(ob);
                message_vision("$N从身上取出一片黑玉断续膏，交给$n。\n",me,ob);
                me->set("heiyu",1);
                return 1;
             }
        }
  else
      {
         command("say 本郡主和你非亲非故，凭什么把那么珍贵的东西给你？");
         command("heng");
         return 1;
      }
        
}
        
