#include <room.h>

inherit ROOM;

void create()
{
	set("short", "王府大厅");
	set("long", @LONG
汝阳王府的大厅。陈设比较简单朴素，骤眼看来，一点都不象是一个在
朝中灸手可热的王爷的王府。
LONG
	);
	set("exits", ([
		 "south"          : __DIR__"zoulang2",
		 "north"          : __DIR__"zoulang1",
                 "east"           : __DIR__"room4",
                 "west"           : __DIR__"room3",
		 ]) );

        
	set("objects", ([
                __DIR__"npc/yahuan" : 2,
   		__DIR__"npc/wangye" : 1 ]) );



	setup();
}


