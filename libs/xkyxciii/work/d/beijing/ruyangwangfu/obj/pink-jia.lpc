// pink-silk.c 

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name( HIM "粉红软甲" NOR, ({ "pink jia", "jia" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一件粉红色的软甲，穿上它能保护全身免受伤害。\n");
                set("unit", "件");
                set("value", 10000);
		set("material", "steel");
                set("female_only",1);
		set("armor_type", "cloth");
		set("armor_prop/armor", 7 );
		// set("armor_prop/defense", 0 );
                set("armor_prop/dodge", 20 );
        }
        setup();
}
