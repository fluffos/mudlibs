// heiyu.c - 黑玉断续膏
// chance-大条鱼

inherit COMBINED_ITEM;
#include <ansi.h>

int task(object me,object ob);
void increase_skill(object ob);

void create()
{
	set_name("黑玉断续膏", ({ "heiyu", "heiyu duanxu gao","gao" }) );
	if( clonep() )	set_default_object(__FILE__);
	set("unit", "些");
	set("base_unit","帖");
	set("long", "江湖上最名贵的疗伤圣药，敷用（use）之后对伤势会有神奇的效果。\n");
	set("value", 10000);
	set("base_weight", 100);
	set_amount(1);
}

void init()
{
	add_action("do_use", "use");
}

int do_use(string arg)
{
	object me,ob;
        string medicine,target;
	int increasement;

        if(!arg ) return notify_fail("你想要用什么东西？usage:use heiyu (on sb)\n");
        me=this_player();
       
        if( sscanf(arg, "%s on %s", medicine, target)!=2 )
               {  medicine=arg; ob=this_player();}
        else {
            if( !(ob = present(target, environment(me))) )
                return notify_fail("你要用黑玉断续膏救谁？\n");
             }

         
        
	if(!id(medicine) ) return notify_fail("你想要用什么东西？\n");

	if( ob->is_fighting() )	return notify_fail("战斗中无法疗伤。\n");

	if( ob->is_busy() ) return notify_fail("目标正忙着呢！\n");
        if (me->query("force")<100) return notify_fail("你的内力不够，无法发挥黑玉断续膏的功效!\n");

        if ( ob->query("id")=="yu daiyan" ) 
               
                return  task(me,ob);  //完成任务。
               

	ob->start_busy(3);

        if (me==ob)
	    message_vision("$N将黑玉断续膏小心地就着伤口敷了上去，然后坐下运功。\n",me);
        else
            message_vision("$N将黑玉断续膏小心地就着$n伤口敷了上去，然后两人一起坐下，双手贴在一起。。\n",me,ob);

	// me->apply_condition("add_eff_kee", 2);
	increasement = 5;
        
        ob->set("eff_kee", (int)ob->query("max_kee"));
        ob->set("kee", (int)ob->query("max_kee"));
        me->add("force",-100);

	add_amount(-1);        
	return 1;
}

int task( object me,object ob)
{
    if( ! me->query_temp("ask_master_zhang") ) 
           {
            message_vision("$N对着$n大喝一声：想用毒药害我？门都没有。\n",me,ob);
            return 1;
           }
     if( ob->query("eff_kee")==ob->query("max_kee") )    
           {
            message_vision("$N对着$n作了个楫缉：多谢阁下好义，我的伤已经好了。\n",me,ob);
            return 1;
           }          
     ob->set("eff_kee", (int)ob->query("max_kee"));
     ob->set("kee", (int)ob->query("max_kee"));
     me->add("force",-100);
     ob->set("long",@LONG
龙精虎猛，浑身好象有使不完的力气，一点也不象是大病初愈的样子。
LONG
        );
    
// 奖励 begin
     if( ! me->query("job/job1") )
          {
          increase_skill(me);  //all skill add 1 grade
          me->add("potential",300);
          me->add("combat_exp",1000);
          me->add("SEN",1500);
          me->set("job/job1",1);
          }
     else
          {
           me->add("job/job1",1);
           me->add("potential",100);
           me->add("combat_exp",300);
           me->add("SEN",700);
          }
     tell_object(me,GRN"你出色的完成了张三丰交给你的任务。\n"NOR);
     tell_object(me,GRN"由于你的出色表现，你的战斗经验,武功和侠义指数都得到了提高。\n"NOR);			
     me->delete_temp("ask_master_zhang");

//奖励 end

     add_amount(-1);        
     return 1;


}

void increase_skill(object ob)
{
	mapping skl;
	string *sname;
	int i,count;
     
	skl = ob->query_skills();
	if(!sizeof(skl)) 
		return ;
	sname  = sort_array( keys(skl), (: strcmp :) );
	count=sizeof(skl);

	for(i=0; i<3; i++) {
		skl[sname[random(count)]]+=1;
	}
	return;
}
