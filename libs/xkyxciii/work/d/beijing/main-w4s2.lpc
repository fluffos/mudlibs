// main-w4s2.c - 北京城－广安门

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "广安门");
  set("long", @LONG

    这里是北京城的广安门。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w3s2",
    "south": __DIR__ "main-w4s3",
    // "west"  : __DIR__"main-w5s2",
    "north": __DIR__ "main-w4s1",
  ]));

  setup();

}
