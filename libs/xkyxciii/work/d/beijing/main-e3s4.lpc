#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "包子铺");
  set("long", @LONG

    这里是北京城的包子铺。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e4s4",
    "south": __DIR__ "main-gse3",
    "west": __DIR__ "main-e2s4",
    "north": __DIR__ "main-e3s3",
  ]));

  setup();

}
