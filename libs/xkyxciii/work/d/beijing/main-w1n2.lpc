// main-w1n2.c - 北京城－北  海

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "北  海");
        set("long", @LONG

    这里是北京城的北  海。
LONG
        );

        set("city", 1);
        set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-n2",
                "south" : __DIR__"main-w1n1",
                "west"  : __DIR__"main-w2n2",
                "north" : __DIR__"main-w1n3",
        ]));

        setup();

        replace_program(ROOM);
}
