// main-e1n2.c - 北京城－王府井

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "王府井");
  set("long", @LONG

    这里是北京城的王府井。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e2n2",
    "south": __DIR__ "main-e1n1",
    "west": __DIR__ "main-n2",
    "north": __DIR__ "main-e1n3",
  ]));

  setup();

}
