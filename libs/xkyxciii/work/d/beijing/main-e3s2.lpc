// main-e3s2.c - 北京城－工作室

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "工作室");
        set("long", @LONG

    这里是北京城的工作室。
LONG
        );

        set("city", 1);
        // set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-e4s2",
                "south" : __DIR__"main-e3s3",
                "west"  : __DIR__"main-e2s2",
                "north" : __DIR__"main-e3s1",
        ]));

        setup();

        replace_program(ROOM);
}
