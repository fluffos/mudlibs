// main-s1.c - 北京城－大前门

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "大前门");
        set("long", @LONG

    这里是北京城的大前门。
LONG
        );

        set("city", 1);
        set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-e1s1",
                "south" : __DIR__"main-s2",
                "west"  : __DIR__"main-w1s1",
                "north" : __DIR__"main",
        ]));

        setup();

        replace_program(ROOM);
}
