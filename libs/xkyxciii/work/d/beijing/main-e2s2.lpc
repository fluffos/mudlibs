#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "药  铺");
        set("long", @LONG

    这里是北京城的药  铺。
LONG
        );

        set("city", 1);
        // set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-e3s2",
                "south" : __DIR__"main-e2s3",
                "west"  : __DIR__"main-e1s2",
                "north" : __DIR__"main-e2s1",
        ]));

        setup();

        replace_program(ROOM);
}
