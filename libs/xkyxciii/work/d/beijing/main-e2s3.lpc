#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "杂货铺");
  set("long", @LONG

    这里是北京城的杂货铺。
LONG
  );

  set("city", 1);
  // set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-e3s3",
    "south": __DIR__ "main-e2s4",
    "west": __DIR__ "main-e1s3",
    "north": __DIR__ "main-e2s2",
  ]));

  setup();

}
