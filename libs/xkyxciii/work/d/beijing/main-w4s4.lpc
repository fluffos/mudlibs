#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "大观园");
        set("long", @LONG

    这里是北京城的大观园。
LONG
        );

        set("city", 1);
        set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-w3s4",
                // "south" : __DIR__"main-w4s5",
                // "west"  : __DIR__"main-w5s4",
                "north" : __DIR__"main-w4s3",
        ]));

        setup();

        replace_program(ROOM);
}
