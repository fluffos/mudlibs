#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "紫禁城");
        set("long", @LONG

    这里是北京城的紫禁城。
LONG
        );

        set("city", 1);
        set("outdoors", "beijing");

        set("exits", ([
                "east"  : __DIR__"main-e1n1",
