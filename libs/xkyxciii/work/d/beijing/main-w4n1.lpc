// main-w4n1.c - 北京城－御林营

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "御林营");
  set("long", @LONG

    这里是北京城的御林营。
LONG
  );

  set("city", 1);
  set("outdoors", "beijing");

  set("exits", ([
    "east": __DIR__ "main-w3n1",
    "south": __DIR__ "main-w4",
    // "west"  : __DIR__"main-w5n1",
    "north": __DIR__ "main-w4n2",
  ]));

  setup();

}
