// bamboo_hurst_2.c - 青竹林
// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.7

#include <room.h>

inherit ROOM;

void create()
{
        set("short", "青竹林");
        set("long", @LONG

    这里是侠客城的一片青竹林。前面有一棵大树（tree）。
LONG
        );

        set("outdoors", "center");

        set("exits", ([
                "south" : __DIR__"bamboo_hurst_2",
        ]) );                   

        set("objects", ([
                __DIR__"npc/presbyter-liang": 1,
                __DIR__"npc/presbyter-lu": 1,
        ]) );

        set("item_desc", ([
                "tree": "这里一棵很大的大树。\n",
                "大树": "这里一棵很大的大树。\n"
        ]) );

        setup();
        // replace_program(ROOM);
}

void init()
{
        add_action("do_climb", "climb");
}

int do_climb(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要爬什么？\n");
                return 1;
        }
        if( arg == "tree" || arg == "大树" || arg == "up" )
        {
                me = this_player();
                message_vision("$N向大树上爬了上去。\n", me);
                me->move( __DIR__"tree" );
                return 1;
        }
        else
        {
                write("你不可以爬" + arg + "。\n");
                return 1;
        }
}
