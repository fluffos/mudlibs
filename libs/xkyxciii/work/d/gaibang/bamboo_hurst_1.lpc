#include <room.h>

inherit ROOM;

void create()
{
        set("short", "青竹林");
        set("long", @LONG

    这里是侠客城的一片青竹林。微风拂着你的面孔，送来阵阵清香。
LONG
        );

        set("outdoors", "center");

        set("exits", ([
                "north" : __DIR__"bamboo_hurst_2",
                "out"   : "/d/center/bamboo_hurst",
        ]) );                   

        set("objects", ([
                __DIR__"npc/presbyter-jian": 1,
                __DIR__"npc/disciple": 2,
        ]) );

        setup();
        // replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
        if (  (dir == "north")
           && ((string)me->query("family/family_name") != "丐帮")
           && objectp(present("beggar disciple", environment(me))) )
         return notify_fail
                ("丐帮弟子伸手拦住你，说道：“对不起，本门重地，请回！”\n");
        return ::valid_leave(me, dir);
}

