// roadw1.c - 西大街
// Designed by Carlis

inherit ROOM;

void create()
{
                set("short", "西大街");
                set("long", @LONG

    这里是大理城的西大街。你走在一条繁忙的街道上，看着操着南腔北
调的人们行色匆匆。北面是明堂书院，你隐约可以听见学生朗朗的读书声；
南面是一间安静的小书店，几个读书人在里面认真地看书。再往西就是大
理西城门，旅客进进出出，喧闹异常。
LONG
        );

                set("outdoors", "dali");

        set("exits", ([
                "east"  : __DIR__"roadw2",
                                "south" : __DIR__"shudian",
                                "west"  : __DIR__"chengmen-w",
                                "north" : __DIR__"shuyuan",
        ]));

                setup();

        replace_program(ROOM);
}
