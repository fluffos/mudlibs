#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "瓷器铺");
  set("long", @LONG

    这里是大理城的瓷器铺。里面放着各式各样的瓷器。
LONG
  );

  set("exits", ([
    "south": __DIR__ "guwandian",
    "west": __DIR__ "huadian",
  ]));

  set("objects", ([
    __DIR__ "npc/cqp-seller": 1,
  ]));

  setup();

  replace_program(ROOM);
}
