#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "书  店");
        set("long", @LONG

    这里是大理城的书店。一些文人学士经常在这里买书。
LONG
        );

        set("exits", ([
                                "south" : __DIR__"zhubaodian",
                                "east"  : __DIR__"jishi-w",
                "north" : __DIR__"roadw1",
        ]) );

        set("objects", ([
                                __DIR__"npc/sd-seller": 1,
                                __DIR__"npc/dushuren": 3,
        ]) );

        setup();

        replace_program(ROOM);
}
