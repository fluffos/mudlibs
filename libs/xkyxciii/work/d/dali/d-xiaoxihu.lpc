#include <room.h>

inherit ROOM;

void create()
{
        set("short", "小西湖");
        set("long", @LONG

    这里是大理城段府中的小西湖。看着平如镜的湖面，你的心情好了许
多。
LONG
        );

        set("exits", ([
                                "east"  : __DIR__"d-lu-s",
                                "north" : __DIR__"d-jiangjun-w",
        ]) );

        setup();

        replace_program(ROOM);
}
