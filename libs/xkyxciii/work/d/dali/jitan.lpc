#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "祭  坛");
  set("long", @LONG

    这里是大理城的祭坛。祭坛中央站着一位法师。据说，任何人只有请
他为自己施法之后，才可以使用身上的魔法物品。
LONG
  );

  set("exits", ([
    "west": __DIR__ "muqipu",
    "north": __DIR__ "chaodufachang",
    "south": __DIR__ "siyuan",
  ]));

  set("objects", ([
    __DIR__ "npc/fashi": 1,
  ]));

  setup();

}
