#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "木器铺");
        set("long", @LONG

    这是大理城的木器铺。由于整个大理只有这么一小间木器铺，所有木
器必须由她供应，因而生意非常好。
LONG
        );

        set("exits", ([
                                "east"  : __DIR__"jitan",
                                "south" : __DIR__"chenghuangmiao",
                                "north" : __DIR__"guancaidian",
        ]) );

        set("objects", ([
                                __DIR__"npc/mqp-seller" : 1,
                ]) );

        setup();

        replace_program(ROOM);
}
