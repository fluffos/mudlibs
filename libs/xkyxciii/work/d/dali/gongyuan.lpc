#include <room.h>

inherit ROOM;

void create()
{
        set("short", "公  园");
        set("long", @LONG

    这里是大理城的公园，游人十分多。
LONG
        );

        set("outdoors", "center");

                set("exits", ([
                                "west"  : __DIR__"zahuopu",
                                "south" : __DIR__"buzhuang",
                ]) );

        set("objects", ([
                                __DIR__"npc/boy": 2,
                                __DIR__"npc/girl": 1,
        ]) );

        setup();

        replace_program(ROOM);
}
