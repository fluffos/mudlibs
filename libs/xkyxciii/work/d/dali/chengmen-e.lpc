// chengmen-e.c - 东城门
// Designed by Carlis

inherit ROOM;

#include <ansi.h>

void create()
{
        set("short", "东城门");
        set("long", @LONG

    这里是大理城东城门，城门正上方刻着“东门”两个楷书大字，城墙
上贴着几张官府告示(gaoshi)。官兵们警惕地注视着过往行人，你最好小
心为妙。一条笔直的青石板大道向东西两边延伸。东边是郊外，隐约可见
一片一望无际的树林。西边是城里。
LONG
        );

        set("exits", ([
                "east" : "/d/road/da-e1",
                "west" : __DIR__"roade1",
        ]));

        set("outdoors", "dali");

        setup();
}

void init()
{
        add_action("look_gaoshi", "look");
}

int look_gaoshi(string arg)
{
        int i;
        object *ob;

        if(!arg || arg!="gaoshi")       return 0;

        ob=users();
        while(i<sizeof(ob) && (!ob[i]->query("kill_flag")) )
                i++;
        if(i >= sizeof(ob) ) {
                printf("本城治安良好。\n\n         大理城知府\n");
                return 1;
        }
        printf("目前本城正在通辑以下要犯：\n\n");
        while(i < sizeof(ob)) {
                if(ob[i]->query("kill_flag"))
                        printf(RED"%-12s      %-12s\n"NOR, ob[i]->query("name"), ob[i]->query("id"));
                i++;
        }
        printf("\n捉获以上逃犯送官者，重赏！\n\n          大理城知府\n");
        return 1;
}
