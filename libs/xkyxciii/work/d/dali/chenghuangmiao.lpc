#include <obj.h>

inherit ROOM;

void create() {
  set("short", "城隍庙");
  set("long", @LONG

    这里是大理城城隍庙。据说大理城内死去的人的灵魂都会到这里来。
LONG
  );

  set("exits", ([
    "east": __DIR__ "siyuan",
    "west": __DIR__ "yizhan",
    "south": __DIR__ "daoguan",
    "north": __DIR__ "muqipu",
  ]));

  set("no_fight", 1);
  set("no_magic", 1);

  set("objects", ([
    __DIR__ "npc/keeper": 1,
    "/obj/misc/paper_seal": 4,
  ]));

  setup();

}
