#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "太极观");
  set("long", @LONG

    这是大理城的道观。这里每一样东西上都已经布满灰尘、蜘蛛丝，看
来香火断绝已经有些日子了。大概是大理人多不大信奉道教的原故吧。
LONG
  );

  set("exits", ([
    "west": __DIR__ "zhuqipu",
    "north": __DIR__ "chenghuangmiao",
  ]));

  set("objects", ([
    __DIR__ "npc/taoism": 1,
  ]));

  setup();

  replace_program(ROOM);
}
