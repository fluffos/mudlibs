// d-xiaohuayuan.c - 小花园
// Designed by Carlis

#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "小花园");
        set("long", @LONG

    这里是大理城段府内的小花园。看着四处的鲜花，你不禁想：有钱人
真会享受....
    花园里有一口井，你可以装水。
LONG
        );

        set("resource/water", 1);               // 设置可以装水

        set("exits", ([
                                "west"  : __DIR__"d-lu-s",
                                "north" : __DIR__"d-jiangjun-s",
                ]) );

                set("objects", ([
                                "/d/center/npc/dog": 1 ,
                                "/d/center/npc/butterfly": 1,
                                "/d/center/npc/bee": 1,
        ]) );

        setup();

        replace_program(ROOM);
}
