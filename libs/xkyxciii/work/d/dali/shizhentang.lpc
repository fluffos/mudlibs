#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "时珍堂");
  set("long", @LONG

    这里是大理城时珍堂。据说李时珍曾经到过这里，为穷苦百姓治病，
所以大理的这个药店便起名“时珍堂”。
LONG
  );

  set("exits", ([
    "west": __DIR__ "buzhuang",
    "east": __DIR__ "roads1",
  ]));


  set("objects", ([
    __DIR__ "npc/jiashizhen": 1,
  ]));

  setup();

  replace_program(ROOM);
}
