#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "澡堂");
        set("long", @LONG

    这里是大理城的澡堂。
LONG
        );

        set("exits", ([
                                "east"  : __DIR__"guwandian",
                                "north" : __DIR__"huadian",
                ]) );

                set("objects", ([
                                __DIR__"npc/zaotanglaoban": 1,
                __DIR__"npc/xiaoshitong": 1,
                __DIR__"npc/xiaoshinu": 1,
                                __DIR__"npc/luonu": 1,
                                __DIR__"npc/luonan": 1,
        ]) );

        setup();

        replace_program(ROOM);
}
