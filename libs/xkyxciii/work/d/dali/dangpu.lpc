// dangpu.c - 当铺
// Designed by Carlis

#include <room.h>

inherit ROOM;

void create() {
  set("short", "当铺");
  set("long", @LONG

    这里是大理城的当铺。门口上写着大大的一个“当”字，柜台上摆着
一个木牌(sign)。柜台后面，一双精明的眼睛在上上下下打量着你。
LONG
  );

  set("item_desc", ([
    "sign": convert_color(@TEXT
$CYN$本当铺提供以下服务：
$MAG$
        查询        list
        买进        buy
        卖断        sell
        估价        value
        典当        pawn
        赎回        ransom
$CYN$
各种货物，铜钱、银两、黄金、银票一概通用。
$NOR$
TEXT
    )
  ]));

  set("exits", ([
    "east": __DIR__ "qianzhuang",
    "south": __DIR__ "kaochang",
  ]));

  set("objects", ([
    __DIR__ "npc/hockman": 1,
  ]));

  set("no_fight", 1);
  set("no_magic", 1);

  setup();
}
