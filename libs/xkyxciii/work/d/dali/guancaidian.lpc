#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "棺材店");
  set("long", @LONG

    这里是大理城的棺材店。大理城一直以来平安无事，所以这里的生意
并非那么好。
LONG
  );

  set("exits", ([
    "east": __DIR__ "chaodufachang",
    "north": __DIR__ "roade2",
    "south": __DIR__ "muqipu",
  ]));

  set("objects", ([
    __DIR__ "npc/gcp-seller": 1,
  ]));

  setup();

}
