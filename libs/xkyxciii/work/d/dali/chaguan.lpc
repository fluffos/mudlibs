#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
                set("short", "茗闲居");
                set("long", @LONG

    这里是大理城茗闲居。你一走进来，就闻到一股茶香沁入心脾，精神
为之一爽。几张八仙桌一字排开，坐满了客人，或高声谈笑，或交头接耳。
你要想打听江湖掌故和谣言，这里是个好去处。
LONG
        );

        set("exits", ([
                                "south" : __DIR__"jishi-e",
                "west"  : __DIR__"xilou",
                "north" : __DIR__"yuqidian",
                ]) );

        set("objects", ([
                                __DIR__"npc/cg-waiter" : 1,
                                __DIR__"npc/fighter-a" : 3
        ]));

        setup();

        replace_program(ROOM);
}
