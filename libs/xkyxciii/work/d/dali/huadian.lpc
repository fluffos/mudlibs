#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "花店");
        set("long", @LONG

    这是大理城唯一的一家花店。大老远的，你就闻到这里飘出来的花香。
还有几只蜜蜂蝴蝶向这里飞来。
LONG
        );

        set("exits", ([
                                "east"  : __DIR__"ciqipu",
                                "south" : __DIR__"zaotang",
                                "west"  : __DIR__"chemadian",
        ]) );

        set("objects", ([
                                __DIR__"npc/hd-seller": 1,
        ]) );

        setup();

        replace_program(ROOM);
}
