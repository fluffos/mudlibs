// roade2.c - 东大街
// Designed by Carlis

inherit ROOM;

void create() {
  set("short", "东大街");
  set("long", @LONG

    你走在东大街上，踩着坚实的青石板地面。南边是一家棺材店，生意
冷冷清清；北边则有熙熙攘攘的人群，原来是江湖上人称“云来神仙”之
一的云来客栈。再往西走便是大理段府，不过看起来门口的卫兵似乎不会
那么轻易让你进去。
LONG);
  set("outdoors", "dali");

  set("exits", ([
    "east": __DIR__ "roade1",
    "south": __DIR__ "guancaidian",
    "west": __DIR__ "d-men-e",
    "north": __DIR__ "kezhan",
  ]));

  setup();

}
