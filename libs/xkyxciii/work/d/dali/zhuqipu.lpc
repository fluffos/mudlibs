#include <room.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "竹器铺");
  set("long", @LONG

    这里是大理城的竹器铺。货架上摆着琳琅满目的竹器。大理城中居民
所需的竹器都是来自这里。
LONG
  );

  set("exits", ([
    "east": __DIR__ "daoguan",
    "west": __DIR__ "jishi-s",
  ]));

  set("objects", ([
    __DIR__ "npc/zqp-seller": 1,
  ]));

  setup();

  replace_program(ROOM);
}
