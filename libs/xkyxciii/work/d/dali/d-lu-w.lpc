#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "小  路");
  set("long", @LONG

    这里是段府的一条小路，你踩着鹅卵石地面，感受着幽静的环境。
LONG
  );

  set("exits", ([
    "west": __DIR__ "d-men-w",
    "east": __DIR__ "d-tingyuan-w",
  ]));

  setup();

  replace_program(ROOM);

}
