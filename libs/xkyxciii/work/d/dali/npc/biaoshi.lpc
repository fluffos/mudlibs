// dudajin.c

inherit NPC;
inherit F_VENDOR;

void create()
{
		set_name("镖师", ({ "biao shi", "biao", "shi" }) );
		set("long", "看起来他似乎是留恋这里, 久久不肯离去.\n");

		set("rank_info/respect", "师傅");
		set("attitude", "heroism");
		set("gender", "男性" );
		set("age", 30);

		set("combat_exp", 100000);
		set("SEN",10);

		setup();
}

void init()
{
		object ob;

		::init();
		if( this_object()->query_temp("unconcious") ) return;
		if( interactive(ob = this_player()) && !is_fighting() ) {
				remove_call_out("greeting");
				call_out("greeting", 1, ob);
		}
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(1) ) {
                case 0:
						say( "镖师缓慢地说道：这位" + RANK_D->query_respect(ob)
								+ "请走吧，我们镖局已经不做生意了....\n");
                        break;
        }
}
