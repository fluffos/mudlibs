// hd-seller.c - 花店老板
// Designed by Carlis

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("花店老板", ({ "seller", "waiter" }));
  set("gender", "女性");
  set("age", 20);

  set("long", "她是花店老板。\n");
  set("combat_exp", 1300);

  set_skill("dodge", 23);
  set_skill("unarmed", 23);
  set_skill("parry", 23);

  set("attitude", "friendly");

  set("vendor_goods", ([
    "/d/center/npc/obj/purple_flower": 20,
    "/d/center/npc/obj/red_flower": 20,
    "/d/center/npc/obj/yellow_flower": 20,
    "/d/center/npc/obj/blue_flower": 20,
    "/d/center/npc/obj/white_flower": 20,
    "/d/center/npc/obj/black_flower": 20,
  ]));

  setup();

  add_money("silver", 50);
  carry_object("/obj/cloth/white-silk")->wear();
}

void init() {
  object ob;

  ::init();
  if (this_object()->query_temp("unconcious")) return;
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say(this_object()->query("name") + "笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，想买鲜花吗？\n");
      break;
  }
}
