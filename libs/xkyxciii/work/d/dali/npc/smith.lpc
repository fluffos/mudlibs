// smith.c - 铁匠
// Designed by Carlis

#include <ansi.h>
#include <login.h>
#include <command.h>

inherit NPC;

#define SET_SKILL       80                      // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         0                       // 定义正气的值

void create()
{
        int n;

		set_name("铁匠", ({ "smith", "waiter" }));

		set("long", @LONG
这是一名铁匠。
LONG
		);

        set("attitude", "friendly");
        set("gender", "男性" );
		set("age", 30);

		set("str", 50);                         // 膂力

        set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * ( 10 + random( 10 ) ) / 10);
        set("SEN", SET_SEN);

        set("env/wimpy", 30);                   //

        n = SET_SKILL + random(10) - 5;         set_skill("unarmed", (n <= 0) ? 1 : n); 
        n = SET_SKILL + random(10) - 5;         set_skill("parry",   (n <= 0) ? 1 : n);
        n = SET_SKILL + random(10) - 5;         set_skill("dodge",   (n <= 0) ? 1 : n);

        set("inquiry", ([
				"铁锤": "铁锤？请去隔壁兵器铺购买。\n",
				"精钢剑": "隔壁兵器铺的剑又好用又便宜，都是我一人打造的！\n",
				"铁刀": "我也负责给兵器铺供应刀具。\n",
        ]) );

        setup();
        
        carry_object("/obj/cloth/cloth")->wear();       // 装备
        carry_object("/obj/weapon/hammer")->wield();

        add_money("silver", 10);                        // 金钱
}

void init()
{
        add_action("do_type", "type");
        add_action("do_name", "name");
        add_action("do_wield_msg", "wield_msg");
        add_action("do_unwield_msg", "unwield_msg");
        add_action("do_make", "make");
}

int do_type(string type)
{
        object me, ob;
        string s;

        me = this_player();

        if( !type ) return notify_fail( @TEXT
指令格式 : type <类别>
 
这个指令可以让你定义独门兵器的类别：

sword   - 剑    blade   - 刀
stick   - 棒    staff   - 杖    
whip    - 鞭    hammer  - 锤    
fork    - 叉
TEXT
        );

        switch( type ) {
                case "sword":   s = type;  break;
                case "blade":   s = type;  break;
                case "staff":   s = type;  break;
                case "stick":   s = type;  break;
                case "hammer":  s = type;  break;
                case "whip":    s = type;  break;
                case "fork":    s = type;  break;
                default:        s = "sword";  break;
        }

        if ( objectp( ob = present( "my " + me->query("weapon/type"), me ) ) )  destruct(ob);

        me->set( "weapon/type", s );
        tell_object(me, "你将独门兵器的类型定义为：" + type + "。\n");
        ob = new("/obj/self/" + me->query("weapon/type"));
        ob->move(me);
        ob->wield();

        return 1;
}

int do_name(string name)
{
        object me, ob;

        me = this_player();

        if( !name ) return notify_fail( @TEXT
指令格式 : name <命名>

这个指令可以让你为自己身上的独门兵器取一个自定的名字。你如果希望
在名字中使用 ANSI 的控制字元改变颜色，可以用以下的控制字串：

$BLK$ - 黑色            $NOR$ - 恢复正常颜色
$RED$ - 红色            $HIR$ - 亮红色
$GRN$ - 绿色            $HIG$ - 亮绿色
$YEL$ - 土黄色          $HIY$ - 黄色
$BLU$ - 深蓝色          $HIB$ - 蓝色
$MAG$ - 浅紫色          $HIM$ - 粉红色
$CYN$ - 蓝绿色          $HIC$ - 天青色
$WHT$ - 浅灰色          $HIW$ - 白色
 
其中系统自动会在字串尾端加一个 $NOR$。

TEXT
        );

        if( strlen(name) > 40 )
                return notify_fail("你取的名字太长了，想一个短一点的吧。\n");

        name = replace_string(name, "$BLK$", BLK);
        name = replace_string(name, "$RED$", RED);
        name = replace_string(name, "$GRN$", GRN);
        name = replace_string(name, "$YEL$", YEL);
        name = replace_string(name, "$BLU$", BLU);
        name = replace_string(name, "$MAG$", MAG);
        name = replace_string(name, "$CYN$", CYN);
        name = replace_string(name, "$WHT$", WHT);
        name = replace_string(name, "$HIR$", HIR);
        name = replace_string(name, "$HIG$", HIG);
        name = replace_string(name, "$HIY$", HIY);
        name = replace_string(name, "$HIB$", HIB);
        name = replace_string(name, "$HIM$", HIM);
        name = replace_string(name, "$HIC$", HIC);
        name = replace_string(name, "$HIW$", HIW);
        name = replace_string(name, "$NOR$", NOR);
        name = name + NOR;

        me->set("weapon/name", name);
        if ( objectp( ob = present( "my " + me->query("weapon/type"), me ) ) ) {
                ob->init();
                tell_object(me, "你将独门兵器的名称定义为：" + name + "。\n");
        }

        return 1;
}

int do_wield_msg(string arg)
{
        object me, ob;

        me = this_player();

        if( !arg ) return notify_fail( @TEXT
指令格式 : wield_msg <命名>
 
这个指令可以让你设定独门兵器的装备信息。
例如：wield_msg $N「唰」的一声拔出一柄$n握在手中。

TEXT
        );

        arg = arg + "\n";

        me->set("weapon/wield_msg", arg);
        if ( objectp( ob = present( "my " + me->query("weapon/type"), me ) ) ) {
                ob->init();
                tell_object(me, "你将独门兵器的装备信息定义为：" + arg + "\n");
        }

        return 1;
}

int do_unwield_msg(string arg)
{
        object me, ob;

        me = this_player();

        if( !arg ) return notify_fail( @TEXT
指令格式 : unwield_msg <命名>
 
这个指令可以让你设定独门兵器的卸装信息。
例如：unwield_msg $N将手中的$n插回剑鞘。

TEXT
        );

        arg = arg + "\n";

        me->set("weapon/unwield_msg", arg);
        if ( objectp( ob = present( "my " + me->query("weapon/type"), me ) ) ) {
                ob->init();
                tell_object(me, "你将独门兵器的卸装信息定义为：" + arg + "\n");
        }

        return 1;
}

int do_make(string arg)
{
        object me, ob;
        int cost, high, low, n;

        me = this_player();

        if( !arg || !sscanf(arg, "%d", cost) ) return notify_fail( @TEXT
指令格式 : make <花费的精和神的值>
TEXT
        );

        if( cost < 10 ) return notify_fail("你最少要花 10 点「精」和「神」。\n");

        if( (int)me->query("gin") < cost || (int)me->query("sen") < cost )
                return notify_fail("你现在的「精」或「神」太少了。\n");

        if ( !objectp( ob = present( "my " + me->query("weapon/type"), me ) ) )
                return notify_fail("你现在没有独门兵器。\n");

        if ( ob->query("equipped") ) return notify_fail("你必须放下「" + ob->name() + NOR "」。\n");

        if( me->query( "weapon/damage" ) >= 100 ) 
                return notify_fail("你没有必要再升级「" + ob->name() + NOR "」了。\n");

        high = me->query("weapon/points_high");
        low  = me->query("weapon/points_low");
        low += cost;
        if( low > 100 ) {
                high += low / 100;
                low  %= 100;
        }

        if( high >= pow( 2.0, me->query( "weapon/damage" ) / 5.0 + 1.0 ) ) {
                high = 0; low = 0;
                me->add("weapon/damage", 1);
                ob->init();
                tell_object(me, WHT "你的「" + me->query("weapon/name") + WHT "」升级了！\n" NOR);
                tell_object(me, WHT "「" + me->query("weapon/name") + WHT "」的Damage 级别是：" 
                        + chinese_number( me->query("weapon/damage") ) + "。\n" NOR);
        }
        else {
                n = high * 100 / pow( 2.0, me->query( "weapon/damage" ) / 5.0 + 1.0 );
                tell_object(me, WHT "「" + me->query("weapon/name") + WHT "」的完成度是：百分之" 
                        + chinese_number( n ) + "。\n" NOR);
        }

        me->set("weapon/points_high", high);
        me->set("weapon/points_low", low);

        tell_object(me, "你开始制造「" + ob->name() + "」....\n");

        me->receive_damage("gin", cost);
        me->receive_damage("sen", cost);
        me->start_busy(1);

        return 1;
}

int accept_object(object me, object ob)
{
        object weapon;

        if( !ob->id("stone") ) return 0;

        if ( !objectp( weapon = present( "my " + me->query("weapon/type"), me ) ) ) {
                tell_object(me, "你现在没有独门兵器。\n" );
                return 0;
        }

        if ( weapon->query("equipped") ) {
                tell_object(me, "你必须放下「" + weapon->name() + "」。\n" );
                return 0;
        }

        if( ob->id("cyan stone") && me->query("weapon/damage") < 100 ) {
                command( "smile " + me->query("id") );
                me->add("weapon/damage", 1);
                weapon->init();
                tell_object(me, WHT "你的「" + me->query("weapon/name") + WHT "」升级了！\n" NOR);
                tell_object(me, WHT "「" + me->query("weapon/name") + WHT "」的Damage 级别是：" 
                        + chinese_number( me->query("weapon/damage") ) + "。\n" NOR);
                return 1;
        }
        command( "? " + me->query("id") );
        command( "say 你给我这样东西干什么耶。" );

        return 0;
}

int buy_object(object who, string what)
{
        if( what == "铁锤" || what == "hammer" ) return 300;
        if( what == "精钢剑" || what == "剑" || what == "sword"  ) return 500;
        if( what == "铁刀" || what == "刀" || what == "blade"  ) return 500;
        return 0;
}

void compelete_trade(object who, string what)
{
        object ob;
        
        if( what == "铁锤" || what == "hammer") {
                ob = new("/d/center/obj/hammer");
                message_vision("$N交给$n一把沉甸甸的打铁用铁锤。\n", this_object(), who);
        }
        if( what == "精钢剑" || what == "剑" || what == "sword"  ) {
                ob = new("/obj/weapon/long_sword");
                message_vision("$N交给$n一把青光闪闪的精钢剑。\n", this_object(), who);
        }
        if( what == "铁刀" || what == "刀" || what == "blade"  ) {
                ob = new("/obj/weapon/blade");
                message_vision("$N交给$n一把明晃晃的铁刀。\n", this_object(), who);
        }
        ob->move(who);
}
