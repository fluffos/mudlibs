// jiashizhen.c - 贾时珍
// Designed by Carlis

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

#define SET_SKILL       30                      // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         50                      // 定义正气的值

void create()
{
        int n;

		set_name("贾时珍", ({ "jia shizhen", "jia" }) );

		set("long", @LONG
贾时珍的医术虽无法与李时珍相比，但相传他的祖宗曾经拜在李时珍门下，
治病救人是大概可以的吧。
LONG
		);

		set("rank_info/respect", "医者");
		set("attitude", "friendly");
		set("gender", "男性" );
		set("age", 40);

		 set("per", 26);                      // 容貌

        set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * ( 10 + random( 10 ) ) / 10);
        set("SEN", SET_SEN);

        set("env/wimpy", 30);                   //

        n = SET_SKILL + random(10) - 5;         set_skill("unarmed", (n <= 0) ? 1 : n); 
        n = SET_SKILL + random(10) - 5;         set_skill("parry",   (n <= 0) ? 1 : n);
        n = SET_SKILL + random(10) - 5;         set_skill("dodge",   (n <= 0) ? 1 : n);

        set("vendor_goods", ([
                "/obj/medicine/jingqiwan"    : 20,
                "/obj/medicine/gaoyao"       : 20,
                "/obj/medicine/shedan"       : 20,
                "/obj/medicine/shouwu"       : 20,
                "/obj/medicine/jinchuangyao" : 20,
                "/obj/medicine/xuelian"      : 20,
        ]) );

        setup();
        
        carry_object("/obj/cloth/cloth")->wear();       // 装备

        add_money("silver", 50);                        // 金钱
}

void init()
{       
        object ob;

        ::init();
		if( this_object()->query_temp("unconcious") ) return;
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
		if( this_object()->query_temp("unconcious") ) return;
        switch( random(3) ) {
                case 0:
						say( "贾时珍笑咪咪地说道：这位" + RANK_D->query_respect(ob)
								+ "，要买药吗？\n");
						break;
				case 1:
						say( "贾时珍呵呵呵地笑道：这位" + RANK_D->query_respect(ob)
								+ "，请进请进。\n");
						break;
				case 2:
						say( "贾时珍笑咪咪地说道：这位" + RANK_D->query_respect(ob)
								+ "，又受伤了不是？哪天看到萧国师，可要向他好好请教一下。\n");
                        break;
        }
}

