// gm-czlon.c - 古墓派的青竹林（青竹林）（迷宫）
// 编程：中山大学  张三丰（Micro）----exslyc@zsulink.zsu.edu.cn		1997.8

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "青竹林");
 	set("long", @LONG
								
    这里是古墓的青竹林。
LONG
	);

	set("outdoors", "gumu");

 	set("exits", ([
                "east" :  __DIR__"gm-qzl1",
                "west" :  __DIR__"gm-qzl3",
                "south" : __FILE__,
                "north" : __FILE__,
	]));

	setup();

	// replace_program(ROOM);

}

int valid_leave(object me, string dir)
{
       
        int  total_steps ;
        mapping myfam;

        myfam = (mapping) me->query("family");
        if(myfam && myfam["family_name"] != "古墓派") {
	    	me->receive_damage("kee", 5);
    		// me->receive_wound("kee",  5);
	    	message_vision(HIW"嗡嗡的一阵响后，只见一群玉蜂围住$N猛蛰！\n"NOR, me);
	}

        total_steps = 30 / me->query("kar") + 1;
        if(myfam && myfam["family_name"] == "古墓派") total_steps = 1 ; 

	if( random(total_steps) == 0 ) return ::valid_leave(me, dir);
	me->move(__FILE__);
	return notify_fail("");
}
