// /d/gumu/mi-center6.c
#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", "地下隧道");
    set("long", @LONG
    隧道里一片漆黑，看不清路的方向，黑暗中但觉处处都是歧路岔道，似乎永远也走不完！
LONG
    );

    set("exits",([
     "east"    :__DIR__"mi-room5",
     "west"    :__DIR__"mi-center7",
     "south"   :__DIR__"mi-center6",
     "north"   :__DIR__"mi-dump4",
]));

    setup();

}

void init()
{
    add_action("do_look", "look");
    add_action("do_look", "l");
}

int do_look ( string arg )
{  
   object me;
    
  if(!arg)
    return 0;
  if((arg=="east")||(arg=="west")||(arg=="south")||(arg=="north")){
    write("光线太暗，你根本看不清远处的情况！\n");
    return 1;
  } 
  return 0;
}
     

int valid_leave(object me, string dir)
{
  if((dir=="south")||(dir=="s")){
     write(RED "哎哟！你一头撞到了墙壁上，满头鲜血直流！\n"NOR);
     me->receive_wound("kee",10);
     if(me->query("eff_kee")<=10)
     write(HIR "你受伤很严重，要加倍小心啊！\n"NOR);
     return 1;
  }
  return 1; 
}