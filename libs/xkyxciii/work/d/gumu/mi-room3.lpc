// /d/gumu/mi-room3.c
#include <ansi.h>

inherit ROOM;


void create() {
  set("short", "地下石室");
  set("long", @LONG
    这是古墓的地下石室，四周黑黑的，黑暗中似乎有人影在闪动！
LONG
  );

  set("item_desc", ([
    "wall": "在墙壁的壁角上似乎有一块石头突了出来。\n",
  ]));
  set("exits", ([
    "north": __DIR__ "mi-center4",
  ]));

  setup();
}

void init() {
  add_action("do_push", "push");
}
int do_push(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg != "stone") {
    tell_object(ob, "你要推动什么？\n");
    return 1;
  }
  message_vision(BLU "抓住墙角的石头用力一推！\n" NOR, ob);
  message_vision(BLU "石头突然转动起来，露出了一道门！\n" NOR, ob);
  ob->move(__DIR__ "li-room");
  tell_object(ob, HIR " “嘿嘿！”突然有人发出一声冷笑，你感到腰间一酸，腰後「中枢穴」上被人点了一指。\n" NOR);
  message_vision(BLU "  一个女子冷冷地说道：“师傅，又来了一个陪葬的！”\n" NOR, ob);
  //    ob->unconcious();
  return 1;
}
