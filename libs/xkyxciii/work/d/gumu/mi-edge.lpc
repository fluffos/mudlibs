inherit ROOM;

void create() {
  set("short", "地下隧道入口");
  set("long", @LONG
    这里是地下隧道的入口，前面黑乎乎一片，散发出阵阵潮气。
LONG
  );

  set("exits", ([
    "east": __DIR__ "main-08",
    "west": __DIR__ "mi-center1",
    "south": __DIR__ "sun-room",
    "north": __DIR__ "back-room",
  ]));

  setup();
  replace_program(ROOM);

}
