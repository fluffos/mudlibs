// /d/gumu/lin-room.c
#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", "地下石室");
    set("long", @LONG
    这个石室和先一间处处对称，而又处处相反，乃是後窄前宽，西圆东角。
LONG
    );

    set("item_desc", ([
        "室顶" : "室顶的石板上刻满了诸般花纹符号(picture)，均是以利器刻成，或深或浅，殊无规则，
一时之间，哪能领略得出其中的奥妙？\n",
    ]));
    set("exits",([
     "north"      :__DIR__"wang-room",
]));

    setup();
}

void init()
{
    add_action("do_study", "study");
}
int do_study ( string arg )
{
    object me ;
    int times,skl,cost,inc;
    string skill_name; 
    skill_name="yunu-force";
    me = this_player () ;
    if(sscanf(arg, "%d %s",times, arg) == 2 ) { 
         if(times<1) return notify_fail("最少要读一次。\n");
    }
    else times=1;
    if( arg !="picture" ) 
         return 0 ;
    if( me->is_busy() ) return notify_fail("你正忙着呢！\n");

    if( me->is_fighting() ) return notify_fail("你无法在战斗中专心下来研读新知！\n");

    if(times > 100) return notify_fail("你读那么多次干什么？\n");
    if( !me->query_skill("literate", 1) )
          return notify_fail("你是个文盲，先学学读书识字(literate)吧。\n");
    message("vision", me->name() + "正专心地研读室顶的花纹符号。\n", environment(me), me);
    me->start_busy(2+random(3));
    skl=me->query_skill(skill_name,1);
    if( (skl * skl * skl) * 150 / 100 >(int)me->query("combat_exp") ) {
          write("你的实战经验不足，再怎麽读也没用。\n");
          return 1;
    }
    cost = 30 - (int)me->query_int()/20;
    if(cost<1)      cost=1;
    cost *= times;
    if( (int)me->query("sen") < cost ) {
          write("以你现在的水平，读不了那么多次。\n");
          return 1;
        }

    if( me->query_skill(skill_name, 1) > 60) {      //最高可学到60级
          write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
          return 1;
    }

    me->receive_damage("sen", cost);

    inc = (int)me->query("combat_exp") / 10000;
    if( inc > 10 ) inc = 10;
    inc = inc + (int)me->query_int() + (int)( me->query_skill("literate", 1) / 10 );
    inc = inc / 10;    

    if( inc < 1 ) inc = 1;

    inc *= times;

    if( !me->query_skill(skill_name, 1) )
          me->set_skill(skill_name, 0);
    me->improve_skill(skill_name, inc);
    write("你研读室顶上有关" + to_chinese(skill_name) + "的技巧，似乎有点心得。\n");
    return 1 ;
}
