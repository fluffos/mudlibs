// dart.c
#include <ansi.h>
#include <weapon.h>
inherit THROWING;

void create()
{
	set_name( HIY "玉蜂针" NOR, ({ "needle", "yu needle" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"这是一枚细如毛发的金针，含六成黄金、四成精钢，并以玉蜂尾刺上毒液喂过。它是古墓派的独门暗器之一。\n");
		set("unit", "些");
		set("base_unit", "枚");
		set("base_weight", 30);
		set("value", 500);
	}
	set_amount(1);
	init_throwing(20);
	setup();
}
