#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "小溪");
        set("long", @LONG
                                                                
    这里是古墓的秘道，小溪。
LONG
        );

        set("outdoors", "emeishan");

        set("exits", ([
                "east"    :__DIR__ "main-m9",
                "west"    :__DIR__ "main-m7",
        ]));

        setup();

        replace_program(ROOM);

}