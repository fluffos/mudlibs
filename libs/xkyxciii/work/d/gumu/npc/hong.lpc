// /d/gumu/npc/sun.c

#include <ansi.h>
inherit NPC;

#define SET_SKILL       60                     // 定义基本武功的值，自动生成经验
#define SPE_SKILL       60                     // 定义特殊武功的值
#define SET_SEN         -200                      // 定义正气的值

void create()
{
        set_name("洪凌波", ({ "hong" ,"hong linbo "}) );
        set("gender", "女性");
        set("age", 20);
        set("long",
"她是李莫愁的弟子，身穿杏黄道袍，背插双剑。\n"
  
  );
        set("attitude", "peaceful");

        set("str", 20);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 25);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘



        set("max_atman", 0);            set("atman", 0);
        set("max_force", 800);         set("force", 800);     set("force_factor", 5);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 500000);
        set("SEN", SET_SEN);

        set_skill("force",    SET_SKILL);     
                                              
        set_skill("sword",    SET_SKILL);     set_skill("yunu-sword", SPE_SKILL);
        set_skill("unarmed",  SET_SKILL);     set_skill("tianluo-shi", SPE_SKILL);
        set_skill("parry",    SET_SKILL);
        set_skill("move",     SET_SKILL);     set_skill("yingfeng-steps", SPE_SKILL);
        set_skill("dodge",    SET_SKILL);

        map_skill("force",      "yunu-force");
        map_skill("sword",      "yunu-sword");
        map_skill("unarmed",    "tianluo-shi");
        map_skill("parry",      "yunu-sword");
        map_skill("move",       "yingfeng-steps");
        map_skill("dodge",      "yingfeng-steps");

/*        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/        
        setup();

        carry_object("/obj/misc/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
}

