// /d/gumu/li-room.c
#include <ansi.h>

inherit ROOM;


void create()
{
    set("short", "地下石室");
    set("long", @LONG
    这是古墓的地下石室，四周黑黑的，黑暗中似乎有人影在闪动！
LONG
    );
    set("exits",([
     "west"      :__DIR__"mi-room3",
]));
    set("objects", ([
        __DIR__"npc/limc":1,
        __DIR__"npc/hong":1,
    ]) );
    set("no_magic",1);

    setup();
}

void init()
{
        add_action("do_kill", "kill");
        add_action("do_kill", "fight");
        add_action("do_kill", "steal");
}

int do_kill()
{
  object ob;
  ob=this_player();
  tell_object(ob, HIR "你被点了穴，根本无法出手！\n" NOR ) ;
  return 1; 
}
  


int valid_leave(object me, string dir)
{
   return notify_fail(HIR " 你全身没力，动弹不得。\n " NOR);
}