// gate.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIW "鬼门关" NOR);
  set("long", @LONG

    这里就是著名的阴间入口「鬼门关」，在你面前矗立著一座高大的黑
色城楼，许多亡魂正哭哭啼啼地列队前进，因为一进鬼门关就无法再回阳
间了。
LONG
  );

  set("exits", ([
    "north": "/d/death/gateway",
  ]));

  set("objects", ([
    __DIR__ "npc/wgargoyle": 1
  ]));

  setup();

}
