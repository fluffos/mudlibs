inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "小康的家");
  set("long", @LONG

    这里是小康（Sting ）的家。这是一个温馨而舒适的地方，你对面的
墙上是一个书架，书架上摆的众多书籍显示出主人的广泛爱好和高雅品味。
左右两边摆放着一些舒适的座椅，平时常有江湖上的朋友到这里休息聊天。
不知从何处隐隐约约传来一阵悠游的音乐，让你突然感到厌倦了江湖的仇
杀，想金盆洗手，与爱侣退隐江湖。
    房子的主人早年曾游历西洋，房门的上方有一块牌匾，是西洋的朋友
送的礼物，上面是几个西洋文字[Computer & Coffee]， 据说这几个字暗
藏玄机，可以预测未来。
LONG
  );

  set("exits", ([
    "west": "/d/yuanlin-shanzhuang/sz-wsy",
    "up": __DIR__ "cass",
  ]));

  // set("outdoors", "center");

  setup();

}
