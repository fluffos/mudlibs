inherit ROOM;

#include <ansi.h>

void create()
{
	set("short", "中国居");
	set("long", @LONG

    这里是中国居。这是一间充满东方智慧的小屋，阳光从南边的窗口射
进来。屋里东面是一排书架，上面堆满了古今书籍。看来主人必定是沉迷
于书，连南边窗口下的床（chuang）上也散落着几本书（book）。小屋的
西边摆了一张大书桌，上面摆着几只盒子似的东西，其中最大的盒子上有
个标牌，你只勉强认出了586（586）三个数字。盒子的旁边有一本摊开的
书（miji），里面写的是有关武功的内容。
LONG
	);

        set("item_desc", ([
                "chuang" : @LONG
这是一张非常舒适的床。
LONG, 
                "book" : @LONG
这些都是有关玄学、武功、天文、地理等各个方面的精品，你看了半天似
乎也没能看懂，看来此屋主人涉猎颇广，且水平不低。
LONG,
                "miji" : @LONG
这是一本没有写完的秘籍，旁边湿润的毛笔说明主人正处于创作之中。秘
籍封面上写着《桃花岛武功精要大全》。
LONG,
                "586" : @LONG
这些盒子看起来很古怪，下面是个方盒子，表面非金非木，不知道是用什
么材料制的。上面的那个四四方方的东西，前面看起来似乎是水晶做的，
不知道有些什么用呢？方盒子前面摆了一个东西，上面密密麻麻的布满了
按钮，旁边有一个圆乎乎的东西(shu biao)，从未端拉出一根线连入下面
的方盒子中，样子很可爱，你禁不住想拿起来看一看。
LONG,
                "shu biao" : @LONG
你轻轻地碰了碰那个圆乎乎的东西，忽然上面的那个水晶似的窗口亮了起
来，只见一排排你看不懂的字符在不停地往上滚动。依稀你能分辨出主人
正在用机器人玩GNet上的MUD －－《侠客英雄传II》。
LONG
        ]));


        set("exits", ([ 
                "south" : "/d/yuanlin-shanzhuang/yl-hbxl2",
]));
	// set("outdoors", "center");

	setup();

	replace_program(ROOM);
}

