
inherit NPC;
inherit F_MASTER;

void create()
{

        set_name("张无忌", ({ "master zhang", "zhang", "master" }) );

        set("long", @LONG
他年纪轻轻就是明教一教之主，所练九阳神功冠绝天下，更习得乾坤大挪
移心法。只见他一双虎目神光湛湛，英挺的双眉，如漆的长发，挺拔的身
材。一身绢白长衫胸前绣着烈焰，英风袭人。
LONG
        );

        create_family("明教", 34, "教主");
        set("rank_info/respect", "教主");
        set("attitude", "friendly");
        set("gender", "男性" );
        set("age", 28);

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 28);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 5000000);
        set("SEN", 1000);

        set_skill("force",    150);     set_skill("ninesun-force", 150);
                                        set_skill("nuoyi-force", 130);
        set_skill("sword",    210);     set_skill("taiji-sword", 210);
        set_skill("unarmed",  180);     set_skill("taiji-quan", 180);
        set_skill("parry",    180);
        set_skill("move",     180);     set_skill("tiyun-steps", 180);
        set_skill("dodge",    180);
        set_skill("literate", 120);

        map_skill("force",      "ninesun-force");
        map_skill("sword",      "taiji-sword");
        map_skill("unarmed",    "taiji-quan");
        map_skill("parry",      "taiji-sword");
        map_skill("move",       "tiyun-steps");
        map_skill("dodge",      "tiyun-steps");
/*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
        setup();

        carry_object("/obj/cloth/cloth")->wear();
        carry_object("/obj/weapon/long_sword")->wield();

}

void init()
{
        add_action("give_quest", "quest");
}

void attempt_apprentice(object ob)
{
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}
