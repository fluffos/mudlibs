inherit NPC;
inherit F_VENDOR;
inherit F_MASTER;

string diagnose();
void heal_who(object who);

void create() {

  set_name("胡青牛", ({ "hu qingniu", "hu", "waiter" }));
  set("long", "胡青牛是明教的教众，是当世最出名的神医之一。\n");
  create_family("明教", 3, "弟子");

  // set("title","");
  set("nickname", "光明神医");

  set("rank_info/respect", "神医");
  set("attitude", "friendly");
  set("gender", "男性");
  set("age", 40);

  set("str", 25);         // 膂力         
  set("cps", 25);         // 定力
  set("cor", 25);         // 胆识         
  set("per", 25);         // 容貌
  set("int", 27);         // 悟性         
  set("con", 25);         // 根骨
  set("spi", 25);         // 灵性         
  set("kar", 25);         // 福缘

  set("max_atman", 0); set("atman", 0);
  set("max_force", 1000); set("force", 2000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("combat_exp", 300000);
  set("SEN", -50);

  set_skill("force", 90); set_skill("guangming-force", 90);
  set_skill("sword", 100); set_skill("guangming-sword", 100);
  set_skill("unarmed", 90); set_skill("guangming-zhang", 90);
  set_skill("parry", 90);
  set_skill("move", 120); set_skill("lieyan-steps", 120);
  set_skill("dodge", 120);
  set_skill("literate", 100);

  map_skill("force", "guangming-force");
  map_skill("sword", "guangming-sword");
  map_skill("unarmed", "guangming-zhang");
  map_skill("parry", "guangming-sword");
  map_skill("move", "lieyan-steps");
  map_skill("dodge", "lieyan-steps");
  /*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
  set("vendor_goods", ([
    "/obj/medicine/lingbaodan": 10,
    "/obj/medicine/zhengqidan": 10,
    "/obj/medicine/jiulonggao": 10,
  ]));

  set("inquiry", ([
    "治病": (: diagnose :),
  ]));

  setup();

  add_money("gold", 1);
  add_money("silver", 50);
  carry_object("/obj/misc/cloth")->wear();
  carry_object("/obj/weapon/longsword")->wield();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
  add_action("give_quest", "quest");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("胡青牛笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，要买药吗？\n");
      break;
    case 1:
      say("胡青牛呵呵呵地笑道：这位" + RANK_D->query_respect(ob)
        + "，老夫只给明教的教众治病。\n");
      break;
    case 2:
      say("胡青牛笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，又受伤了不是？哪天看到本教张教主，可要向他好好请教一下。\n");
      break;
  }
}

int accept_object(object who, object ob) {
  if (!who->query_temp("diagnose_fee")) return 0;
  if (ob->value() >= who->query_temp("diagnose_fee")) {
    heal_who(who);
    return 1;
  } else {
    command("heihei");
    command("say 就凭这点钱也想叫我帮你看病？");
    return 0;
  }
}

string diagnose() {
  mapping cnd;
  int i = 0;
  object who;

  who = this_player();
  cnd = who->query_conditions();

  if (who->query("family/family_name") != this_object()->query("family/family_name"))
    return "老夫只给明教的教众治病。\n";

  if (who->query("eff_gin") == who->query("max_gin") &&
    who->query("eff_kee") == who->query("max_kee") &&
    who->query("eff_sen") == who->query("max_sen") && !sizeof(cnd))

    return "你又没病，来找我干什么？\n";

  if (who->query("eff_gin") < who->query("max_gin")) {
    message_vision("$N打量了$n几眼，说道：嗯，精元受了点损伤。\n",
      this_object(), who);
    i++;
  }
  if (who->query("eff_kee") < who->query("max_kee")) {
    message_vision("$N打量了$n几眼，说道：嗯，真气" + ((i) ? "还" : "") +
      "受了点损伤。\n", this_object(), who);
    i++;
  }
  if (who->query("eff_sen") < who->query("max_sen")) {
    message_vision("$N打量了$n几眼，说道：嗯，元神" + ((i) ? "还" : "") +
      "受了点损伤。\n", this_object(), who);
    i++;
  }
  if (sizeof(cnd)) {
    message_vision("$N打量了$n几眼，说道：嗯，你" + ((i) ? "还" : "") +
      "中毒了。\n", this_object(), who);
    i++;
  }

  command("say 一共要" + chinese_number(50 * i) + "两银子。");
  who->set_temp("diagnose_fee", 5000 * i);

  return "先给钱，后看病！\n";
}

void heal_who(object who) {
  int i;

  i = who->query("max_gin") - who->query("eff_gin");
  if (i > 0) who->receive_curing("gin", i);

  i = who->query("max_kee") - who->query("eff_kee");
  if (i > 0) who->receive_curing("kee", i);

  i = who->query("max_sen") - who->query("eff_sen");
  if (i > 0) who->receive_curing("sen", i);

  if (sizeof(who->query_conditions())) {
    who->clear_condition();
    if (who->query("poison") > 10)
      who->add("poison", -10);
    else who->delete("poison");
  }

  who->delete_temp("diagnose_fee");

  message_vision("$N拿出一些药丸给$n吃下。\n", this_object(), who);

  tell_object(who, "你服下药丸，顿时感觉身轻体健，身体好象又恢复到了最佳的状态。\n");
}

void attempt_apprentice(object ob) {
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
}
