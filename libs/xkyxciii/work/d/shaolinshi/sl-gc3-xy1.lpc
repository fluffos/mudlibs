#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "小  院");
 	set("long", @LONG
								
    这里是少林寺的小院。
LONG
	);

	set("outdoors", "songshan");

 	set("exits", ([
		"north" : __DIR__"sl-lzd",
	        "west"  : __DIR__"sl-gl",
           	"east"  : __DIR__"sl-gc3",
        ]));

	setup();

	replace_program(ROOM);

}

