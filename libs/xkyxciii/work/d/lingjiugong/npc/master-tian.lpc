#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("天山童姥", ({ "tianshan tonglao", "master" }));

        set("long",@LONG
她是灵鹫宫的主人。她身形矮小，形如八岁女童，但双目如电，炯炯有神
自有一股凌人的威严。只因她所练“八荒六合唯我独尊功”走火入魔，是
以她的身体便从此不能长大，永远是八九岁的样子。
LONG
        );

        create_family("灵鹫宫", 1, "主人");
        set("rank_info/respect", "祖师");
        set("gender", "女性" );
        set("age", 45);

        set("str", 25);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 25);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 4000000);
        // set("SEN",10000000);

        set_skill("force",    200);     set_skill("bahuang-force", 200);
        set_skill("blade",    200);     set_skill("ruyi-blade", 200);
        set_skill("unarmed",  200);     set_skill("zhemei-shou", 200);
        set_skill("parry",    200);
        set_skill("move",     200);     set_skill("lingbo-steps", 200);
        set_skill("dodge",    200);
        set_skill("literate", 100);

        map_skill("force",      "bahuang-force");
        map_skill("sword",      "ruyi-blade");
        map_skill("unarmed",    "zhemei-shou");
        map_skill("parry",      "zhemei-shou");
        map_skill("move",       "lingbo-steps");
        map_skill("dodge",      "lingbo-steps");

        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
        
        setup();

        carry_object("/obj/misc/cloth")->wear();
}

void attempt_apprentice(object ob)
{
        if( ((int)ob->query("kar") < 28)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

