#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("余婆婆", ({ "yu popo", "yu", "popo", "master" }));

        set("long",@LONG
她是“灵鹫宫”九天九部中昊天部的首领。
她跟随童姥多年，出生入死，饱经风霜。
LONG
        );

        create_family("灵鹫宫",2,"弟子");
        set("title", "昊天部副首领");
        set("gender", "女性" );
        set("age", 60);

        set("str", 25);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 25);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 1000);         set("force", 2000);     set("force_factor", 20);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 4000000);
        set("SEN", 0);

        set_skill("force",   100);      set_skill("bahuang-force", 100);
        set_skill("blade",    150);     set_skill("ruyi-blade", 150);
        set_skill("unarmed", 120);      set_skill("zhemei-shou", 120);
        set_skill("parry",   120);
        set_skill("move",    120);      set_skill("lingbo-steps", 120);
        set_skill("dodge",   120);

        map_skill("force",      "bahuang-force");
        map_skill("blade",      "ruyi-blade");
        map_skill("unarmed",    "zhemei-shou");
        map_skill("parry",      "zhemei-shou");
        map_skill("move",       "lingbo-steps");
        map_skill("dodge",      "lingbo-steps");


        set("chat_chance", 3);
        set("chat_msg", ({
                "余婆婆说道：“谁和我们主人作对，我就让他象狗一样生活！”\n", 
        }) );

        set("chat_chance_combat", 60);
/*
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
        setup();

        carry_object(__DIR__"obj/black-mantle")->wear();
        carry_object("/obj/weapon/blade")->wield();
        add_money("silver", 40);
}

void attempt_apprentice(object ob)
{
        if( ((int)ob->query("kar") < 28)) {
                command("say 依我看" + RANK_D->query_respect(ob) + "的资质还不够高？");
                return;
        } 

        if( ((int)ob->query_skill("zhemei-shou",1) < 100)) {
                command("say 天山折梅手是本门武功的基础，依我看" + 
                   RANK_D->query_respect(ob) + "的天山折梅手似乎还不够？");
                return;
        }

        if( ((int)ob->query_skill("bahuang-force",1) < 90)) {
                command("say 本门武功以呼吸吐纳为主，依我看" + RANK_D->query_respect(ob) 
                        + "的八荒六合唯我独尊功似乎还不够？");
                return;
        }

        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

void init()
{
        add_action("give_quest", "quest");
}
