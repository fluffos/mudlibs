#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "桃花林");
 	set("long", @LONG
								
    这里是天师山谷桃花林。
LONG
	);

	set("outdoors", "emeishan");

 	set("exits", ([
		"east"  : __DIR__"ts-thl2",
		"south" : __DIR__"ts-thl3",
		"west"  : __DIR__"ts-thl3",
		"north" : __DIR__"ts-thl4",
	]));

	setup();

	replace_program(ROOM);

}

