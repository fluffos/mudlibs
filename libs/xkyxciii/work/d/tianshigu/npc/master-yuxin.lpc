#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("月心君", ({ "master yuxin", "master" }));

        set("long",@LONG
这位是天师山谷的开山祖师之一。
LONG
        );

        create_family("天师山谷", 1, "开山祖师");
        set("rank_info/respect", "祖师");
        set("gender", "男性" );
        set("nickname", CYN "明月照我心" NOR);
        set("age", 20);

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 2000);         set("force", 4000);     set("force_factor", 20);
        set("max_mana", 2000);          set("mana", 4000);

        set("combat_exp", 8000000);
        set("SEN", 400);

        set_skill("force",    150);     set_skill("huangting-force", 150);
        set_skill("sword",    70);     set_skill("tianshi-sword", 70);
        set_skill("unarmed",  70);     set_skill("tianshi-zhang", 70);
        set_skill("parry",    70);
        set_skill("move",     210);     set_skill("qiankun-steps", 210);
        set_skill("dodge",    210);
        set_skill("literate", 200);
        set_skill("spells", 200);       set_skill("necromancy", 200);
        set_skill("taoism", 200);

        map_skill("force",      "huangting-force");
        map_skill("sword",      "tianshi-sword");
        map_skill("unarmed",    "tianshi-zhang");
        map_skill("parry",      "tianshi-ling");
        map_skill("move",       "qiankun-steps");
        map_skill("dodge",      "qiankun-steps");
        map_skill("spells",     "necromancy");
/*
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action :),
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
*/
        setup();

        carry_object("/obj/misc/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
}

void attempt_apprentice(object ob)
{
        if( (string)ob->query("family/family_name") != "天师山谷") {
                command("say 这位" + RANK_D->query_respect(ob) + "请回去吧，我只收本门弟子。");
                return;
        } 

        if( ob->query_skill("necromancy", 1) < 60) {
                command("say 这位" + RANK_D->query_respect(ob) + "的道术还学得不够？");
                return;
        } 
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
}

void init()
{
        add_action("give_quest", "quest");
}
