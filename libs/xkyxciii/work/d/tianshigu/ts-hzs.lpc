#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "火之山");
 	set("long", @LONG
								
    这里是天师山谷火之山。
LONG
	);

	set("outdoors", "emeishan");

 	set("exits", ([
		"west"      : __DIR__"ts-szs",
		"southeast" : __DIR__"ts-tzs",
	]));

	setup();

	replace_program(ROOM);

}

