#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "西湖十景");
        set("long", @LONG
                                                                
    这里是杭州的西湖十景。
LONG
        );

        set("outdoors", "hangzhou");

        set("exits", ([
                "east"  : "/d/road/yang-sw8",
                "west"  : __DIR__"mzw-02",
                "south" : __DIR__"mzw-01s",
                "north" : __DIR__"mzw-01n",
        ]));

        setup();

        replace_program(ROOM);
}