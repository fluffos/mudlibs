#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "秃笔斋");
        set("long", @LONG
                                                                
    这里是梅庄的秃笔斋。
LONG
        );

        // set("outdoors", "meizhuang");

        set("exits", ([
                "east"  : __DIR__"mz-06e",
                "west"  : __DIR__"mz-06w",
                "south" : __DIR__"mz-05",
                "north" : __DIR__"mz-07",
        ]));

        setup();

        replace_program(ROOM);
}