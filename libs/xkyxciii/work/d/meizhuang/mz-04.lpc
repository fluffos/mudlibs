#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "花  园");
  set("long", @LONG
                                                                
    这里是梅庄的花  园。
LONG
  );

  set("outdoors", "meizhuang");

  set("exits", ([
    "south": __DIR__ "mz-03",
    "north": __DIR__ "mz-05",
  ]));

  setup();

  replace_program(ROOM);
}
