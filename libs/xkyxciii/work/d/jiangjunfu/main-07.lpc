#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "三  堂");
        set("long", @LONG
                                                                
    这里是侠客城将军府的三堂。
LONG
        );

        // set("outdoors", "xiakecheng");

        set("exits", ([
                "east"   : __DIR__"main-07e",
                "west"   : __DIR__"main-07w",
                "south"  : __DIR__"main-06",
                "north"  : __DIR__"main-08",
        ]));

        set("objects", ([
                __DIR__"npc/qian-jiangjun": 1,
                __DIR__"npc/hou-jiangjun": 1,
                __DIR__"npc/zuo-jiangjun": 1,
                __DIR__"npc/you-jiangjun": 1,
	]) );

        setup();

        replace_program(ROOM);
}