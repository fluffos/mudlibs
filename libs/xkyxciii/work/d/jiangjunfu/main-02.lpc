#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "大  院");
        set("long", @LONG
                                                                
    这里是侠客城将军府的大院。
LONG
        );

        set("outdoors", "xiakecheng");

        set("exits", ([
                "south" : __DIR__"main-01",
                "north" : __DIR__"main-03",
        ]));

        set("objects", ([
                __DIR__"npc/jinwei": 2,
                __DIR__"npc/duizhang": 2,
                __DIR__"npc/laobing": 2,
	]) );

        setup();

        replace_program(ROOM);
}