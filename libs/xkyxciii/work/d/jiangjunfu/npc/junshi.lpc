// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com           1997.9

#include <ansi.h>

inherit NPC;

#define SET_SKILL       120                     // 定义基本武功的值，自动生成经验
#define SPE_SKILL       120                     // 定义特殊武功的值
#define SET_SEN         250                     // 定义正气的值

void create() {
  set_name("军师", ({ "jun shi" }));

  set("long", @LONG
他是一位军师。
LONG
  );

  set("rank_info/respect", "将军");       // 尊称
  set("attitude", "friendly");
  set("gender", "男性");                 // 性别
  set("age", 30 + random(20));         // 年纪

  set("str", 40);                         // 膂力         
  set("cps", 40);                         // 定力
  set("cor", 40);                         // 胆识         
  set("per", 30);                         // 容貌
  set("con", 40);                         // 根骨

  set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * (10 + random(10)) / 10);
  set("SEN", SET_SEN);

  set("env/wimpy", 30);                   //

  set("max_atman", 1500); set("atman", 3000);
  set("max_force", 1500); set("force", 3000); set("force_factor", 20);
  set("max_mana", 0); set("mana", 0);

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :),
    (: cast_spell, "drainerbolt" :),
    (: cast_spell, "netherbolt" :),
    (: cast_spell, "feeblebolt" :),
    (: cast_spell, "invocation" :),
  }));

  set_skill("force", SET_SKILL); set_skill("ninemoon-force", SPE_SKILL);
  set_skill("sword", SET_SKILL); set_skill("taiji-sword", SPE_SKILL);
  set_skill("unarmed", SET_SKILL); set_skill("zhemei-shou", SPE_SKILL);
  set_skill("parry", SET_SKILL);
  set_skill("move", SET_SKILL); set_skill("ghostbat-steps", SPE_SKILL);
  set_skill("dodge", SET_SKILL);
  set_skill("spells", SET_SKILL); set_skill("necromancy", SPE_SKILL);
  set_skill("literate", SET_SKILL);

  map_skill("force", "ninemoon-force");
  map_skill("sword", "taiji-sword");
  map_skill("unarmed", "zhemei-shou");
  map_skill("parry", "taiji-sword");
  map_skill("move", "ghostbat-steps");
  map_skill("dodge", "ghostbat-steps");
  map_skill("spells", "necromancy");

  setup();

  carry_object(__DIR__ "obj/biyu-hat")->wear();    // 装备
  carry_object(__DIR__ "obj/silver-baojia")->wear();
  carry_object(__DIR__ "obj/chaotian-boots")->wear();

  carry_object(__DIR__ "obj/longquan_sword")->wield();
}
