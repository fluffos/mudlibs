// 编程：中山大学  张三丰（Micro）----Micro_Liang@Hotmail.Com		1997.9

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name( "铁剑", ({ "sword" }));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "这是一柄普通的铁剑。\n");
                set("value", 1000);
                set("material", "iron");
                set("wield_msg", "$N「唰」的一声拔出一柄$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
        }
        init_sword(30);
        setup();
}
