#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(WHT "铁靴" NOR, ({ "tie xue", "xue" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一双普通的铁靴。\n");
    set("unit", "双");
    set("value", 1000);
    set("material", "iron");
    set("armor_type", "boots");
    set("armor_prop/armor", 3);
    set("armor_prop/defense", 0);
    set("armor_prop/dodge", 0);
  }
  setup();
}
