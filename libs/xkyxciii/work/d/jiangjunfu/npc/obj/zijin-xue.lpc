#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name( HIY "紫金靴" NOR, ({ "zijin xue", "xue" }) );
        set_weight( 5000 );
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一双普通的紫金靴。\n");
                set("unit", "双");
                set("value", 20000);
		set("material", "gold");
		set("armor_type", "boots");
		set("armor_prop/armor", 10 );
		set("armor_prop/defense", 0 );
                set("armor_prop/dodge", 0 );
        }
        setup();
}
