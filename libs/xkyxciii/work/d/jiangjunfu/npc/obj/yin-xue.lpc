#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name( HIW "亮银靴" NOR, ({ "yin xue", "xue" }) );
        set_weight( 4000 );
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一双普通的亮银靴。\n");
                set("unit", "双");
                set("value", 5000);
		set("material", "silver");
		set("armor_type", "boots");
		set("armor_prop/armor", 5 );
		set("armor_prop/defense", 0 );
                set("armor_prop/dodge", 0 );
        }
        setup();
}
