#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("靴子", ({ "xue zi", "xue" }) );
        set_weight( 1000 );
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一双普通的靴子。\n");
                set("unit", "双");
                set("value", 500);
		set("material", "cloth");
		set("armor_type", "boots");
		set("armor_prop/armor", 1 );
		set("armor_prop/defense", 0 );
                set("armor_prop/dodge", 2 );
        }
        setup();
}
