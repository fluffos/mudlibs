#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "练武场");
 	set("long", @LONG
								
    这里是武当山练武场。
LONG
	);

	set("outdoors", "wudangshan");

 	set("exits", ([
		"east"      : __DIR__"wd-lgf",
		"south"     : __DIR__"wd-hd",
		"west"      : __DIR__"wd-xxs",
		"north"     : __DIR__"wd-jd",
	]));

        set("objects", ([
                __DIR__"npc/song_yuanqiao": 1,
                __DIR__"npc/song_qingshu":1,
	]) );

	setup();


}

