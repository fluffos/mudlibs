#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("宋青书", ({ "song qingshu", "song", "master" }));
        // set("nickname", "外号");

        create_family("武当派", 3, "弟子");
        set("rank_info/respect", "道长");
        set("class", "taoist");

        set("gender", "男性" );
        set("age", 26);

        set("long",@LONG
    宋远桥的儿子。武当派新一代的接班人。长得风度翩翩，资质和悟性均是
江湖新一辈中的上上之选。武当上下均认为他将是武当派的第三人掌门人。
LONG
        );

        // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
        // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
        // set(PERSONALITY, 2 );   // 性格：-2 卑鄙、-1 阴险、0 普通、1 有责任心、2 正直
        // set(TEMPER, 1 );        // 脾气：-2 暴躁、-1 鲁莽、0 柔顺、1 镇定、2 谨慎

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 3000);         set("force", 2000);        set("force_factor", 80);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 5000000);
        set("SEN", -100);

        set_skill("force",    40);     set_skill("taiji-force", 40);
        set_skill("sword",    40);     set_skill("taiji-sword", 40);
        set_skill("unarmed",  40);     set_skill("taiji-quan",  40);
        set_skill("parry",    40);
        set_skill("move",     40);     set_skill("tiyun-steps", 40);
        set_skill("dodge",    40);
        set_skill("literate", 60);

        map_skill("force",      "taiji-force");
        map_skill("sword",      "taiji-sword");
        map_skill("parry",      "taiji-sword");
        map_skill("unarmed",    "taiji-quan");
        map_skill("move",       "tiyun-steps");
        map_skill("dodge",      "tiyun-steps");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                (: perform_action, "sword.counterattack" :),
                (: exert_function, "recover" :),
        }) );
        
        setup();

        carry_object("/obj/cloth/cloth")->wear();
        carry_object("/obj/weapon/sword")->wield();
}

void attempt_apprentice(object ob)
{
  
return;

}
