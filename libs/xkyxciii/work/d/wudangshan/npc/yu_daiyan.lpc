        set("eff_kee",6);  //有效的“气”
        set("kee",5);      //"气
        set("eff_sen",6);  //精
        set("sen",5);
        

        set("str", 30);         // 膂力         
        set("cps", 30);         // 定力
        set("cor", 30);         // 胆识         
        set("per", 30);         // 容貌
        set("int", 30);         // 悟性         
        set("con", 30);         // 根骨
        set("spi", 30);         // 灵性         
        set("kar", 30);         // 福缘

        set("max_atman", 0);            set("atman", 0);
        set("max_force", 3000);         set("force", 5000);        set("force_factor", 200);
        set("max_mana", 0);             set("mana", 0);

        set("combat_exp", 5000000);
        set("SEN", 100);

/*
        set_skill("force",    20);     set_skill("taiji-force", 10);
        set_skill("sword",    30);     set_skill("", 100);
