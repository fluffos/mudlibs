{
        set_name("俞岱岩", ({ "yu daiyan", "yu", "master" }));
        // set("nickname", "外号");

        create_family("武当派", 2, "弟子");
        set("rank_info/respect", "道长");
        set("class", "taoist");

        set("gender", "男性" );
        set("age", 56);

        set("long",@LONG
闭目沉睡，脸色惨白，双颊凹陷，奄奄一息地躺在床上。这样一个病夫，
就是当年让坏人闻风丧胆的武当三侠--俞岱岩，看到他现在这个模样，
你不禁黯然泪下。);
LONG
        );

        // set(DISPOSITION, 1 );   // 气质：-2 内向、-1 寡言、0 好静、1 随和、2 活跃
        // set(TOLERANCE, 2 );     // 气量：-2 吝啬、-1 小气、0 普通、1 虚心、2 大量
