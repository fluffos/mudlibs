#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "竹  林");
 	set("long", @LONG
								
    这里是武当山竹林。
LONG
	);

	set("outdoors", "wudangshan");

 	set("exits", ([
		"east"      : __DIR__"wd-zl-4",
		"south"     : __DIR__"wd-zl-3",
		"west"      : __DIR__"wd-zl-4",
		"north"     : __DIR__"wd-zl-4",
	]));

        set("objects", ([
                __DIR__"npc/master-zhang": 1,
	]) );

	setup();

}

