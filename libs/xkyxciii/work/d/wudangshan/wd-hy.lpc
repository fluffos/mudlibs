#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "花  园");
 	set("long", @LONG
								
    这里是武当山花园。
LONG
	);

	set("outdoors", "wudangshan");

 	set("exits", ([
		"east"      : __DIR__"wd-ws2",
		"south"     : __DIR__"wd-zl-1",
		"west"      : __DIR__"wd-ws1",
		"north"     : __DIR__"wd-hd",
	]));

	setup();

	replace_program(ROOM);

}

