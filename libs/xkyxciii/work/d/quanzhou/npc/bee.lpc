#include <ansi.h>

inherit NPC;

void create()
{
	set_name("蜜蜂", ({ "bee" }));

        set("long", @LONG
一只飞来飞去到处采蜜的蜜蜂。
LONG
	);

	set("race", "野兽");
	set("limbs", ({ "头部", "身体", "翅膀" }) );
	set("verbs", ({ "bite", "claw" }) );
        set("age", 1);

	set("str", 24);		// 膂力		
	set("cor", 26);		// 胆识		

	set("combat_exp", 100);

	// set("eatable",1);
	// set("afterdie","/obj/food/haremeat");

	set_temp("apply/attack", 0);
	set_temp("apply/armor", 0);
	set_temp("apply/damage", 10);
	set_temp("apply/dodge", 200);

	setup();
}
