#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

#define SET_SKILL       80                      // 定义基本武功的值（随机），自动生成经验
#define SET_SEN         0                       // 定义正气的值

void create()
{
        int n;

        set_name("屠夫", ({ "butcher" }) );

        set("long", @LONG
他是一位屠夫，一个满脸大胡子和横肉的家伙。
LONG
        );

        set("attitude", "friendly");
        set("gender", "男性" );
        set("age", 35);

        set("str", 30);                         // 膂力         
        // set("cps", 30);                      // 定力
        // set("cor", 30);                      // 胆识         
        // set("per", 30);                      // 容貌
        // set("con", 30);                      // 根骨

        set("combat_exp", SET_SKILL * SET_SKILL * SET_SKILL / 10 * ( 10 + random( 10 ) ) / 10);
        set("SEN", SET_SEN);

        set("env/wimpy", 30);                   //

        n = SET_SKILL + random(10) - 5;         set_skill("unarmed", (n <= 0) ? 1 : n); 
        n = SET_SKILL + random(10) - 5;         set_skill("parry",   (n <= 0) ? 1 : n);
        n = SET_SKILL + random(10) - 5;         set_skill("dodge",   (n <= 0) ? 1 : n);

        set("vendor_goods", ([
                __DIR__"obj/sheep_head": 20,
                __DIR__"obj/pig_head" : 5,
                __DIR__"obj/ox_head" : 10,
        ]) );

        setup();
        
        carry_object("/obj/cloth/cloth")->wear();       // 装备

        add_money("silver", 10);                        // 金钱
        add_money("coin", 500);
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) ) {
                case 2:
                        say( "大胡子咧开大嘴, 笑着道：这位"  
                                + RANK_D->query_respect(ob)
                                + "，要买肉是吗? \n");
                        break;
        }
}
