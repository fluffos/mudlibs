// multi.c

#include <weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif

varargs void init_multi(int damage, int flag)
{
	if( clonep(this_object()) ) return;

	set("weapon_prop/damage", damage);
    set("flag", (int)flag | SECONDARY | EDGED | POINTED );
    set("skill_type", "multi");
	if( !query("actions") ) {
		set("actions", (: call_other, WEAPON_D, "query_action" :) );
        set("verbs", ({ "slash", "slice", "thrust", "chop", "hack",
            "pierce", "poke", "impale", "bash", "stick", "crush",
            "slam"  }) );
	}
}

