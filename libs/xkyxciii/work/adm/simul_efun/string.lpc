// string.c

// 将字符串转换成数字
int atoi(string str)
{
        int v;

        if( !stringp(str) || !sscanf(str, "%d", v) ) return 0;
        return v;
}

// 将数字转换成字符串
string itoa(int n)
{
        return sprintf( "%d", n );
}

// 返回规定的空格数
string space(int n)
{
        return sprintf( "%" + itoa( n ) + "s", "" );
}

