void create() {
  seteuid(getuid());
  set("channel_id", "连线精灵");
}

void logon(object ob) {
  object *usr;
  int i, wiz_cnt, ppl_cnt, login_cnt, i_user;
  int IPCount, WIZIP;                     // 用于使用户（除巫师外）不能双重登录
  string user_num;

  if (BAN_D->is_passed(query_ip_name(ob)) == 0) {
    if (BAN_D->is_banned(query_ip_number(ob)) == 1) {
      // write("对不起，你的地址在" + MUD_NAME + "不受欢迎。\n");
      destruct(ob);
      return;
    }
  }

  usr = users();
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (usr[i]->query("id") == "silverwind") wiz_cnt--;
    if (!environment(usr[i])) login_cnt++;
    else if (wizardp(usr[i]) && !usr[i]->is_ghost()) wiz_cnt++;
    else ppl_cnt++;
    // 用于使用户（除巫师外）不能多重登录
    if (query_ip_name(usr[i]) == query_ip_name(ob) && !usr[i]->query_temp("netdead"))
      IPCount++;
    if (wizardp(usr[i]) && query_ip_name(usr[i]) == query_ip_name(ob)) WIZIP = 1;
  }

  if (IPCount > 10) {
    // write("这个地址已经太多帐号在登录了！\n\n");
    destruct(ob);
    return;
  }


  cat(WELCOME);
  UPTIME_CMD->main();

  /*
        printf(CYN "您的IP地址是：%s，此地址目前共有%s个玩家在线。\n" NOR, 
                query_ip_name(ob), CHINESE_D->chinese_number(IPCount) );

        printf(CYN "目前共有%s位玩家在线上，以及%s位使用者尝试连线中。\n\n" NOR,
                CHINESE_D->chinese_number(ppl_cnt), CHINESE_D->chinese_number(login_cnt) );
*/
  //统计访问量  Bbq 1999-11-28
  user_num = read_file(LOG_DIR "login/users", 1);
  i_user = atoi(user_num);
  printf(BBLK + HIW "自一九九九年十一月二十八日起，" + MUD_NAME + "共有%s人次来访。\n", chinese_number(i_user));
  i_user = i_user + 1;
  user_num = sprintf("%d", i_user);
  write_file(LOG_DIR "login/users", user_num, 1);
  user_num = read_file(LOG_DIR "login/iduser", 1);
  i_user = atoi(user_num);
  printf(MUD_NAME + "目前共有%s个注册玩家。\n", chinese_number(i_user));


  printf(HIW "目前共有%s位管理员、%s位玩家在线上，以及%s位使用者尝试连线中。
本MUD目前处于试运行阶段，有任何BUG均欢迎报告，我们将尽快给你答复，并按其做出相应奖励！！\n\n" NOR,
    CHINESE_D->chinese_number(wiz_cnt), CHINESE_D->chinese_number(ppl_cnt), CHINESE_D->chinese_number(login_cnt));

  write("您的英文名字：");
  input_to((: get_id :), ob);
}

private void read_msg(string arg, object ob) {
  // Key: 1999-02-26 加上重复录累计和登陆次数记录显示
  write(HIY "\n现在共有" + HIR + "/cmds/apr/sameip"->tot_usr(ob) + HIY + "位玩家从您的站点（" + query_ip_name(ob) + "）连线。\n" + NOR);

  ob->add("LOG_IN", 1);
  write(HIM "欢迎光临" HIW + MUD_NAME + HIM "！这是您第" + ob->query("LOG_IN") + "次进入本站！\n\n" NOR);

  return;
}

private void get_id(string arg, object ob) {
  object ppl;

  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    write("您的英文名字：");
    input_to("get_id", ob);
    return;
  }

#ifdef MAX_USERS
  if ((string)SECURITY_D->get_status(arg) == "(player)"
    && sizeof(users()) >= MAX_USERS) {
    ppl = find_body(arg);
    // Only allow reconnect an interactive player when MAX_USERS exceeded.
    if (!ppl || !interactive(ppl)) {
      write("对不起，" + MUD_NAME + "的使用者已经太多了，请待会再来。\n");
      destruct(ob);
      return;
    }
  }
#endif

  if (wiz_level(arg) < wiz_lock_level) {
    write("对不起，" + MUD_NAME + "目前正在整理玩家资料，请过几分钟再连线。\n");
    destruct(ob);
    return;
  }

  if ((string)ob->set("id", arg) != arg) {
    write("Failed setting user name.\n");
    destruct(ob);
    return;
  }

  // Micro: 事先清除非法的帐号
  if (file_size(USER_DIR + arg[0..0] + "/" + arg + "/login" + __SAVE_EXTENSION__) > 0
    && file_size(USER_DIR + arg[0..0] + "/" + arg + "/user" + __SAVE_EXTENSION__) < 0)
    rmhirdir(USER_DIR + arg[0..0] + "/" + arg);


  if (arg == "guest") {
    // If guest, let them create the character.
    confirm_id("Yes", ob);
    return;
  } else if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    if (ob->restore()) {
      write("这个ＩＤ已经被使用，请输入密码：");
      input_to("get_passwd", 1, ob);
      return;
    }
    write("您的人物资料出了一些问题，请利用 guest 人物通知巫师处理。\n");
    destruct(ob);
    return;
  }
  // Key: 1999-02-26 加上不让新手登陆的限制可方便一些活动的进行，以防用新人牟利!
  if (new_user_lock) {
    write("暂时不接受新的ＩＤ登陆，请稍候再创造新的人物。\n");
    destruct(ob);
    return;
  }

  write("使用 " + (string)ob->query("id") + " 这个名字将会创造一个新的人物，您确定吗（y/n）？");
  input_to("confirm_id", ob);
}

private void get_passwd(string pass, object ob) {
  string my_pass;
  object user, *list;
  int i;

  write("\n");
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass) {
    write("密码错误！\n");
    log_file("ATTEMPT_LOGIN", sprintf("FAILED: %s tried to login from %s\n",
      ob->query("id"), query_ip_name(ob)));
    destruct(ob);
    return;
  }

  // Check if we are already playing.
  user = find_body(ob->query("id"));
  if (user) {
    if (user->query_temp("netdead")) {
      reconnect(ob, user);
      return;
    }
    write("您要将另一个连线中的相同人物赶出去，取而代之吗（y/n）？");
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (objectp(user = make_body(ob))) {
    if (user->restore()) {
      log_file("USAGE", sprintf("%s loggined from %s (%s)\n", user->query("name"),
        query_ip_name(ob), ctime(time())));
      log_file("STAT", sprintf("ON %s %s %d %d %d %d %d %d %s\n",
        user->query("id"), user->query("name"), user->query("combat_exp"),
        user->query("deposit"), user->query("potential"), user->query("TASK"),
        user->query("mud_age"), user->query("QUEST"), ctime(time())));

      if (!wizardp(user)) {
        list = users();
        for (i = 0; i < sizeof(list); i++) {
          if (!environment(list[i])) continue;
          if (wizardp(list[i])) continue;
          if ((query_ip_name(ob) == query_ip_name(list[i]))
            && !wizardp(list[i])) {

            // Micro: 改动：允许多重登录。
            write(HIW "\n警告！请不要多重登录！\n" NOR);
            input_to("read_msg", user);
            /*
                                write("你目前这个地址已经有人在使用了。\n");
                                destruct(user);
                                destruct(ob);
                                return;
*/
          }
        }
      }
      enter_world(ob, user);
      return;
    } else {
      destruct(user);
    }
  }
  write("请您重新创造这个人物。\n");
  confirm_id("y", ob);
}

private void confirm_relogin(string yn, object ob, object user) {
  object old_link;

  if (yn == "") {
    write("您要将另一个连线中的相同人物赶出去，取而代之吗（y/n）？");
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，欢迎下次再来。\n");
    destruct(ob);
    return;
  } else {
    tell_object(user, "有人从别处（" + query_ip_number(ob) + "）连线取代你所控制的人物。\n");
    log_file("USAGE", sprintf("%s replaced by %s (%s)\n", user->query("name"),
      query_ip_name(ob), ctime(time())));
  }

  // Kick out the old player.
  old_link = user->query_temp("link_ob");
  if (old_link) {
    exec(old_link, user);
    destruct(old_link);
  }

  reconnect(ob, user);
}

private void confirm_id(string yn, object ob) {
  if (yn == "") {
    write("使用这个名字将会创造一个新的人物，您确定吗（y/n）？");
    input_to("confirm_id", ob);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，那么请重新输入您的英文名字：");
    input_to("get_id", ob);
    return;
  }

  write(@TEXT
[1;35m
本游戏是一个以金庸小说、西欧中世纪传说及漫画为背景的世界，请您
想一个有气质，有个性，又不会太奇怪的中文名字，特别要提醒您的是，
请勿使用金庸小说中的人名，请不要取一些不雅或者容易造成他人困扰
的名字,这个名字将代表你的人物,而且往后将不能再更改，请务必慎重。[37m
                                        ^^^^^^^^^^
[1;33m
如果你不能输入中文名字，请按回车键［ＲＥＴＵＲＮ］，让系统帮您
生成一个。
[1;37m

（除了名字之外，本游戏有许多取绰号、别称的设计，所以郑重建议您
 取一个比较像名字的中文名字。）
[0m
TEXT
  );
  write("您的中文名字：");
  input_to("get_name", ob);
}

private void get_name(string arg, object ob) {
  string name;
  if (arg == "") {
    Rname = random_name();
    write("看来您要个随机产生的中文名字．．\n");
    write("您满意(y)不满意(n)这个中文名字？");
    printf(HIY " -- %s ：" NOR, Rname);
    input_to("get_resp", ob);
  } else {
    if (!check_legal_name(arg)) {
      write("您的中文名字：");
      input_to("get_name", ob);
      return;
    }

    printf("%O\n", ob);
    ob->set("name", arg);
    write("请设定您的密码：");
    input_to("new_password", 1, ob);
  }
}

private void get_resp(string arg, object ob) {
  if (arg == "") {
    write("您满意(y)不满意(n)这个中文名字？");
    input_to("get_resp", ob);
    return;
  }

  if (arg[0] == 'y' || arg[0] == 'Y') {
    printf("%O\n", ob);
    ob->set("name", Rname);
    write("请设定您的密码：");
    input_to("new_password", 1, ob);
    return;
  } else if (arg[0] == 'n' || arg[0] == 'N') {
    Rname = random_name();
    write("您满意(y)不满意(n)这个中文名字？");
    printf(HIY " -- %s ：" NOR, Rname);
    input_to("get_resp", ob);
    return;
  } else {
    write("对不起，您只能选择满意(y)不满意(n)： ");
    input_to("get_resp", ob);
    return;
  }


}

private void new_password(string pass, object ob) {
  write("\n");
  if (!check_legal_password(ob, pass)) {
    write("请设定您的密码：");
    input_to("new_password", 1, ob);
    return;
  }
  ob->set("password", crypt(pass, 0));
  write("请再输入一次您的密码，以确认您没记错：");
  input_to("confirm_password", 1, ob);
}

private void confirm_password(string pass, object ob) {
  string old_pass;

  write("\n");
  old_pass = ob->query("password");
  if (crypt(pass, old_pass) != old_pass) {
    write("您两次输入的密码并不一样，请重新设定一次密码：");
    input_to("new_password", 1, ob);
    return;
  }

  write("您的电子邮件地址：");
  input_to("get_email", ob);
}

private void get_email(string email, object ob) {
  object user;

  ob->set("email", email);

  // If you want do race stuff, ask player to choose one here, then you can
  // set the user's body after the question is answered. The following are
  // options for player's body, so we clone a body here.
  ob->set("body", USER_OB);
  if (!objectp(user = make_body(ob)))
    return;

  write("您要扮演男性(m)的角色或女性(f)的角色？");
  input_to("get_gender", ob, user);
}

private void get_gender(string gender, object ob, object user) {
  int id_temp; string id_num;
  if (gender == "") {
    write("您要扮演男性(m)的角色或女性(f)的角色？");
    input_to("get_gender", ob, user);
    return;
  }

  if (gender[0] == 'm' || gender[0] == 'M')
    user->set("gender", "男性");
  else if (gender[0] == 'f' || gender[0] == 'F')
    user->set("gender", "女性");
  else {
    write("对不起，您只能选择男性(m)或女性(f)的角色：");
    input_to("get_gender", ob, user);
    return;
  }
  //统计注册人数 Bbq  1999-11-28
  id_num = read_file(LOG_DIR "login/iduser", 1);
  id_temp = atoi(id_num); id_temp = id_temp + 1;
  id_num = sprintf("%d", id_temp);
  write_file(LOG_DIR "login/iduser", id_num, 1);
  write("\n");


  write(HIG + read_file(NEW_PLAYER_RACE) + NOR);

  write("
[1;37m	０．人类	１．矮人	２．精灵
	３．妖精	４．龙人	５．兽人[0m
		\n");
  write(HIG + "请选择你在" + MUD_NAME + "中所想扮演的种族（0，１，２，３，４，５）：" + NOR);
  input_to("get_nresp", ob, user);
}
private void get_nresp(string arg, object ob, object user) {
  if (arg == "") {
    write("请选择你在" + MUD_NAME + "中所想扮演的种族（0，１，２，３，４，５）：");
    input_to("get_nresp", ob, user);
    return;
  }
  if (arg[0] == '0' || arg[0] == '1' || arg[0] == '2' || arg[0] == '3' || arg[0] == '4' || arg[0] == '5') {

    log_file("USAGE", sprintf("%s was created from %s (%s)\n", user->query("id"),
      query_ip_name(ob), ctime(time())));
    user->set("national", national[(int)(arg[0] - '0')]);
    //方便巫师统计研究玩家注册情况  Bbq  1999-11-28
    log_file("login/created_log", sprintf("(%s) 玩家 %s(%s) 从%s连线注册，%s，%s\n", ctime(time()), user->query("name"),
      user->query("id"), query_ip_name(ob), user->query("national"), user->query("gender")));

    init_new_player(user);
    enter_world(ob, user);
    return;
  } else {
    write("对不起，您只能从（0,1,2,3,4,5）中选择： ");
    input_to("get_nresp", ob, user);
    return;
  }
}

object make_body(object ob) {
  string err;
  object user;
  int n;

  user = new(ob->query("body"));
  if (!user) {
    write("现在可能有人正在修改使用者物件的程序，无法进行复制。\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}

private void init_new_player(object user) {
  string national;

  national = user->query("national");

  user->set("title", national + "普通百姓");
  user->set("birthday", time());
  user->set("potential", 500);

  switch (national) {


    /*
		case "人类":
//力量，勇气，才智，灵性，定力，魅力，根骨，福缘
//人类 15,15,20,20,15,20,15,15
		set_attribute(user,15,15,20,20,15,20,15,15);
			break;
	        case "矮人族":
//矮人 22,15,15,13,20,15,20,15
                set_attribute(user,22,15,15,13,20,15,20,15);
                        break;
         	case "精灵族":
//精灵 13,15,22,20,15,20,15,15
                set_attribute(user,13,15,22,20,15,20,15,15);
                        break;
         	case "妖精族":
//妖精 13,15,20,25,15,20,15,12
		set_attribute(user,13,15,20,25,15,20,15,12);
                        break;
         	case "龙人族":
//龙人 20,20,15,15,15,15,20,15
		set_attribute(user,20,20,15,15,15,15,20,15);
                        break;
         	case "兽人族":
//兽人 22,22,13,13,15,10,25,15
		set_attribute(user,22,22,13,13,15,10,25,15);
                        break;
*/

    //modify by erer,对各race天赋做了适当调整。1999-11-27

    //力量，勇气，才智，灵性，定力，魅力，根骨，福缘
    case "人类":
      //人类 13,14,22,20,15,17,15,19
      set_attribute(user, 13, 14, 22, 20, 15, 17, 15, 19);
      break;
    case "矮人族":
      //矮人 20,20,14,14,17,14,21,15
      set_attribute(user, 20, 20, 14, 14, 17, 14, 21, 15);
      break;
    case "精灵族":
      //精灵 15,15,20,24,15,16,15,15
      set_attribute(user, 14, 16, 20, 24, 15, 16, 15, 15);
      break;
    case "妖精族":

      //妖精 13,14,21,21,14,20,15,17
      set_attribute(user, 13, 14, 21, 21, 14, 20, 15, 17);
      break;
    case "龙人族":
      //龙人 18,17,17,18,16,15,18,16
      set_attribute(user, 18, 17, 17, 18, 16, 15, 18, 16);
      break;
    case "兽人族":
      //兽人 22,22,13,14,15,10,24,15
      set_attribute(user, 22, 22, 13, 14, 15, 10, 24, 15);
      break;



  }

  user->setup();
  user->set("food", user->max_food_capacity());
  user->set("water", user->max_water_capacity());
  user->set("env/wimpy", 50);
  // Micro: 新玩家预先给十两银放在银行 //Bbq:不如多些， :)))
  if (user->query("id") != "guest") user->set("bank_money", 1000);
  // Micro: 新玩家预先给一定的经验，女性更多  //Bbq:不如多些,  :)))
  if (user->query("id") != "guest") {
    if (user->query("gender") == "女性") user->set("combat_exp", 4500);
    else user->set("combat_exp", 4000);
  }

  user->set("channels", ({ "chat", "rumor", "mud" }));
}

varargs void enter_world(object ob, object user, int silent) {
  object cloth, weapon, animal, room;
  object marry_ring, mail_box, *list;
  string startroom;
  int i;

  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  exec(user, ob);

  write("目前权限：" + wizhood(user) + "\n");
  user->setup();

  // In case of new player, we save them here right aftre setup 
  // compeleted.

  user->save();
  ob->save();

  // 改正八识神通的一个BUG
  if (!wizardp(user) && user->query("env/invisibility"))
    user->delete("env/invisibility");

  // 改正身上钱太重不能正常进入的一个BUG
  MONEY_D->player_pay(user, 0);

  // Micro: 连线后，自动穿戴个人衣物        
  cloth = new("/obj/self/cloth");
  cloth->move(user);
  cloth->wear();

  // Micro: 连线后，自动佩戴个人武器，如果是新玩家，则预先定义个人武器类型为剑
  if (!stringp(user->query("weapon/type"))) user->set("weapon/type", "sword");
  weapon = new("/obj/self/" + user->query("weapon/type"));
  weapon->move(user);
  // weapon->wield();

  // Micro: 连线后，拥有个人坐骑，但不自动骑坐
  animal = new("/obj/self/animal");
  animal->move(user);
  // RIDE_CMD->main(user, animal->query("id"));

  // Micro: 黄金腰带的自动佩戴
  if (user->query("fight_no1")) {
    cloth = new("/obj/wizard/gold-belt");
    cloth->move(user);
    cloth->wear();
  }
  //清除玩家robber后的面具。linghu
  if (user->query_temp("抢劫中")) {
    user->delete("greeting_msg");
    user->set("id", user->query("old_id"));
    user->set("name", user->query("old_name"));
    user->set("nickname", user->query("old_nick"));
    user->set("title", user->query("old_title"));
    user->delete("old_id");
    user->delete("old_name");
    user->delete("old_nick");
    user->delete("old_title");
    user->delete_temp("抢劫中");
    user->delete_temp("不准走");
  }

  // Micro : check
  if ((int)user->query("combat_exp") - (int)user->query("exp") >= 1000
    || (int)user->query("exp") - (int)user->query("combat_exp") >= 1000) {
    log_file("nosave/WARNING", sprintf("%s（%s） 在 %s 连接。经验：%d <> %d\n",
      user->query("name"), user->query("id"),
      ctime(time()),
      (int)user->query("exp"), (int)user->query("combat_exp")));
  }
  if ((int)user->query("potential") - (int)user->query("pot") >= 500
    || (int)user->query("pot") - (int)user->query("potential") >= 500) {
    log_file("nosave/WARNING", sprintf("%s（%s） 在 %s 连接。潜能：%d <> %d\n",
      user->query("name"), user->query("id"),
      ctime(time()),
      (int)user->query("pot") - (int)user->query("learned_points"),
      (int)user->query("potential") - (int)user->query("learned_points")));
  }


  if (!silent) {
    cat(MOTD);
    write(HIG "请按回车将继续．．．．．" NOR);
    input_to("read_msg", user);

    //      1.newbie上路
    if (!stringp(startroom = user->query("startroom")))
      startroom = "/d/beginner/start1";
    else {
      //      2.user上路
      if (catch(load_object(startroom)) ||
        (startroom == "/d/wizard/wizard_room" && (!wizardp(user))
        ))
        startroom = START_ROOM;
      //              3.鬼魂上路                              
      if (user->is_ghost())
        startroom = DEATH_ROOM;
      else if (startroom == DEATH_ROOM)
        startroom = START_ROOM;
    }
    user->move(startroom);
    user->set("startroom", startroom);

    tell_room(startroom, user->query("name") + "连线进入这个世界。\n", ({ user }));
  }

  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s（%s）由%s连线进入。", user->name(), user->query("id"), query_ip_name(user)));

  // Micro: 对已经结婚的玩家，自动加入结婚戒指
  if (user->query("marry") && !present("marry ring", user)) {
    marry_ring = new("/obj/misc/marry_ring");
    marry_ring->move(user);
    marry_ring->wear();
  }

  // Micro: 显示信件的数量
  if (!(mail_box = present("mailbox", user))) {
    mail_box = new("/obj/misc/mailbox");
    mail_box->move(user);
  }

  // UPDATE_D->check_user(user);
}

varargs void reconnect(object ob, object user, int silent) {
  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  exec(user, ob);

  user->reconnect();
  if (!silent) {
    tell_room(environment(user), user->query("name") + "重新连线回到这个世界。\n",
      ({ user }));
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s（%s）由%s重新连线进入。", user->query("name"), user->query("id"), query_ip_name(user)));
}

// 英文ID合法性检查
int check_legal_id(string id) {
  int i;

  i = strlen(id);

  if ((strlen(id) < 3) || (strlen(id) > 12)) {
    write("对不起，你的英文名字必须是 3 到 12 个英文字母。\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("对不起，你的英文名字只能用英文字母。\n");
      return 0;
    }
  if (member_array(id, banned_id) != -1) {
    write("对不起，这种英文名字会造成其他人的困扰。\n");
    return 0;
  }

  return 1;
}

