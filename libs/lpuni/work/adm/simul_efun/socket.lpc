// socket_status() is unavailable on this driver build (no `sockets`
// package -- e.g. the WASM build, where real network sockets don't make
// sense in a browser sandbox). This is a diagnostic admin-tool utility
// only, not part of the boot/login path, so it's neutered to a safe
// stub rather than preserving partial behavior.
string dump_socket_status() {
    return
"Fd    State      Mode       Local Address          Remote Address            PROGRAM\n"
"--  ---------  --------  ---------------------  --------------------- ---------------------\n";
}
