###############################################################################
#              Customizable runtime config file for MudOS v22                 #
###############################################################################

# name of this mud
name : LPUniversity

# port number to accept users on
port number : 40224

# absolute pathname of mudlib
mudlib directory : /home/sunyc/src/mudlib/libs/lpuni/work

# debug.log and author/domain stats are stored here
log directory : /log

# the directories which are searched by #include <...>
include directories : /adm/include:/include

# The global include file is included automatically before every compile.
global include file : <global.h>

# Directory to save binaries in.  (if BINARIES is defined)
save binaries directory : /adm/temp

# the file which defines the master object
master file : /adm/obj/master

# the file where all global simulated efuns are defined.
simulated efun file : /adm/obj/simul_efun

# alternate debug.log file name (assumed to be in specified 'log directory')
debug log file : debug.log

# This mudlib's own ansi_parser.lpc pinkfish-tag colour system (invoked
# from std/user/mobile.lpc's catch_tell()/receive_message()) requires
# catch_tell() to actually fire for interactive players. The archive's
# own bundled driver build config
# (fluffos-2.9-ds2.07/local_options.lpuni) explicitly turns this on
# (`#define INTERACTIVE_CATCH_TELL`, overriding the generic template's
# `#undef`) -- without it, this newer driver's default (0) sends
# interactive player output straight to the socket via add_message(),
# bypassing catch_tell() entirely, so every %^TAG%^ pinkfish marker
# this mudlib writes renders as literal text forever instead of real
# ANSI escapes. See AGENTS.md for the confirmed-live symptom.
interactive catch tell : 1

time to clean up : 120000
time to swap : 0
time to reset : 1800
maximum bits in a bitfield : 1200
maximum local variables : 35
maximum evaluation cost : 5000000
maximum array size : 64000
maximum buffer size : 400000
maximum mapping size : 1500000
inherit chain size : 30
maximum string length : 200000
maximum read file size : 200000
maximum byte transfer : 10000
hash table size : 7001
object table size : 1501
default fail message : What?
default error message : Something *REALLY* bad just happened.

maximum users : 40
evaluator stack size : 1000
compiler stack size : 200
maximum call depth : 30
living hash table size : 100
