#include <ansi.h>
inherit NPC;
void use_poison();
void create() {
  set_name(HIR "血鹦鹉" NOR, ({ "xue yingwu", "yingwu" }));
  set("race", "野兽");
  set("age", 4);
  set("long", "血红的鹦鹉。\n");
  set("limbs", ({ "头部", "身体", "尾巴", "爪子" }));
  set("verbs", ({ "bite" }));
  set_skill("dodge", 500);
  set("combat_exp", 5000000 + random(2000000));
  set("bellicosity", 300);
  set("chat_chance_combat", 1);
  set("chat_msg_combat", ({
  }));
  setup();
}
