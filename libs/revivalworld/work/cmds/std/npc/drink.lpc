#include <ansi.h>
#include <feature.h>

inherit COMMAND;

string help = @HELP
飲用飲料的指令
drink '物品'		- 將某個物品喝到肚子裡

HELP;

private void do_command(object me, string arg)
{
	int capacity;
	object ob;
	
	if( !arg )
	{
		if( me->is_npc() )
			return me->do_command("say 老闆想要我喝些什麼？\n");
		else
			return tell(me, pnoun(2, me)+"想要喝些什麼？\n");
	}
	
	ob = present(arg, me) || present(arg, environment(me));
	
	if( !objectp(ob) )
	{
		if( me->is_npc() )
			return me->do_command("say 附近並沒有 "+arg+" 這種飲料。\n");
		else
			return tell(me, "附近並沒有 "+arg+" 這種飲料。\n");
	}

	if( !ob->is_drink() )
	{
		if( me->is_npc() )
			return me->do_command("say "+ob->query_idname()+"不是飲料，無法飲用。\n");
		else
			return tell(me, ob->query_idname()+"不是飲料，無法飲用。\n");
	}
	
	capacity = query("capacity", ob);

	if( capacity + me->query_drink_cur() > me->query_drink_max() )
	{
		if( me->is_npc() )
			return me->do_command("say 我喝不下"+ob->query_idname()+"了！\n");
		else
			return tell(me, pnoun(2, me)+"喝不下"+ob->query_idname()+"了！\n");
	}
	
	me->add_drink(capacity);

	msg("$ME把$YOU大口大口地喝了下去。\n", me, ob, 1);

	ob->drink();
	destruct(ob, 1);
}