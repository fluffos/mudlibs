#include <ansi.h>
#include <message.h>
#include <inherit.h>

inherit	STANDARD_OBJECT;


int is_bait()
{
	return 1;
}
void create()
{
	set_idname("bread bug", "麵包蟲");
	set_temp("status", HIY"魚餌"NOR);

	if( this_object()->set_shadow_database() ) return;

	set("unit", "條");
	set("value", 1);
	set("mass", 1);
	set("bait", 25);
	set("badsell", 1);

}