#include <inherit.h>

inherit STANDARD_OBJECT;

void create()
{
	set_idname("antler", "鹿茸");
	
	if( this_object()->set_shadow_ob() ) return;
	
	set("long", "粗壯堅硬的鹿茸。\n");
	set("unit", "隻");
	set("mass", 300);
	set("value", 25000);
}
