#include <inherit.h>

inherit STANDARD_OBJECT;

void create()
{
	set_idname("chicken","雞肉");
	
	if( this_object()->set_shadow_ob() ) return;
	
	set("long", "鮮嫩多汁的雞肉。\n");
	set("unit", "塊");
	set("mass", 200);
	set("value", 800);
}
