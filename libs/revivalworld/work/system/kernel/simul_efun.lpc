#include <daemon.h>

// Restores driver-level efuns that this lib's original custom-patched
// MudOS provided (see rw_compat.lpc's own header) -- included first so
// every later file in this compilation unit calling query()/set()/
// count()/ansi()/etc. resolves against a real definition rather than
// binding as "Undefined function" (this driver compiles simul_efun.lpc
// as one single-pass unit; a same-file call must be preceded by its
// definition, see AGENTS.md 6.5).
#include "simul_efun/rw_compat.lpc"

#include "simul_efun/person.lpc"

#include "simul_efun/log.lpc"

#include "simul_efun/path.lpc"

#include "simul_efun/string.lpc"

#include "simul_efun/parse.lpc"

#include "simul_efun/file.lpc"

#include "simul_efun/object.lpc"

#include "simul_efun/zone.lpc"

#include "simul_efun/city.lpc"

#include "simul_efun/area.lpc"

#include "simul_efun/message.lpc"

#include "simul_efun/title_screen.lpc"

#include "simul_efun/socket.lpc"

#include "simul_efun/boolean.lpc"

#include "simul_efun/location.lpc"

#include "simul_efun/array.lpc"

#include "simul_efun/bit.lpc"

#include "simul_efun/math.lpc"

#include "simul_efun/secure.lpc"

#include "simul_efun/int.lpc"

#include "simul_efun/process.lpc"

private void create()
{
	printf("Simul Efun Object(/system/kernel/simul_efun.c) 載入成功\n");
}

string iconv_string(string from, string to, string text)
{
	printf("此 Efun 被懷疑是 Crasher 目前被封鎖中, 請勿任意使用\n");
	return 0;
}