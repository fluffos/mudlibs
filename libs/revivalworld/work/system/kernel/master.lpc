#include "master/valid_socket.lpc";/* 保護 socket 外部函式 */
#include "master/valid_database.lpc";

//-----------------------------------------------------------------------------

/* 回傳連線物件 */
//        connect() 傳回的物件，會當作初始使用者物件 (initial user object)。
//        請注意，之後你可以使用 exec() 外部函式將改變使用者物件。

private object connect( int port )
{
        object ob;
        
        if( !catch(ob = new(LOGIN_OB) ) )
        	return ob;
        else
        	printf("\n登錄程式正在修改中，請稍後再試。\n\n");
}

private void create()
{
        printf("Master Object(/system/kernel/master.c) 載入成功\n");
}

//-----------------------------------------------------------------------------

/* This lib predates PACKAGE_UIDS (its own source has no uid concept
 * anywhere -- confirmed by grepping the whole tree). This driver's build
 * has PACKAGE_UIDS on and hard-requires both of these applies on master
 * or it exit(-1)s at boot; minimal stubs restore a single-uid world,
 * matching every other uid-less lib in this collection. */
string get_root_uid()
{
	return "REVIVALWORLD";
}

string get_bb_uid()
{
	return "REVIVALWORLD";
}

/* PACKAGE_UIDS also hard-requires this apply for EVERY single object
 * load (give_uid_to_object() in the driver's own simulate.cc calls it
 * unconditionally and errors "No function creator_file() defined!" if
 * absent) -- missing this caused a catastrophic cascade during the
 * first batch-compile attempt (every single file failing the same way,
 * hundreds of thousands of near-identical trace lines). Single-uid
 * world, same as get_root_uid()/get_bb_uid() above. */
string creator_file(string file)
{
	return "REVIVALWORLD";
}
