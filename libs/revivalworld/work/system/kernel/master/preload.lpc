#define FIRST_PRELOAD	"/system/daemons/system_d.lpc"

/* 初始化作業 Initialization */
/* 若 driver 參數為 -e , flag 為非零值 */
string *epilog(int flag)
{
	if( flag )
	{
		printf("驅動程式取消預先載入程序。\n");
		log_file("system/preload","驅動程式取消預先載入程序。\n");
		return allocate(0);
	}

	return ({ FIRST_PRELOAD });
}

/* 預先載入物件 */
void preload(string file)
{
	mixed err;
	
	if( err = catch(load_object(file)) )
		log_file("system/preload",sprintf("載入 %s 時發生錯誤: %O\n", file, err));
}
