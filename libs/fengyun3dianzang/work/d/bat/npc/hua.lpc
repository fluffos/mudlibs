inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int teach_perform();
void learn_perform(object me, object ob, int utter);
string *teach_msg = ({
  "\n华真真说道：能不能学会需得看你资质了。\n\n" NOR,
  "华真真说道：记住，「摘心手」用的是手腕的巧劲，并非内力。\n\n" NOR,
  HIR "只见华真真脸露青气，左手五指成抓，鬼魅般地凌空虚抓了数下。\n\n" NOR,
});

void create() {
  set_name(HIC "华真真" NOR, ({ "hua zhen zhen" }));
  set("gender", "女性");
  set("age", 19);
  set("int", 40);
  set("spi", 21);
  set("cor", 15);
  set("con", 20);
  set("per", 40);
  set("str", 30);
  set("attitude", "peaceful");
  set("max_force", 9500);
  set("force", 19000);
  set("force_factor", 30);
  set("max_gin", 5000);
  set("max_kee", 100000);
  set("max_sen", 500);
  set("long",
    "一个斯斯文文，秀秀气气的少女，始终低垂着头，仿佛羞见生人。\n"
  );

  create_family("华山派", 16, "弟子");


  set("combat_exp", 1100000);

  set_skill("move", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("unarmed", 200);
  set_skill("zhaixin-claw", 200);
  set_skill("huashan-force", 100);
  set_skill("literate", 90);
  set_skill("sword", 100);
  set_skill("wind-sword", 100);
  set_skill("huashan-steps", 120);

  map_skill("force", "huashan-force");
  map_skill("parry", "wind-sword");
  map_skill("sword", "wind-sword");
  map_skill("dodge", "huashan-steps");
  map_skill("move", "huashan-steps");
  map_skill("unarmed", "zhaixin-claw");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.xueji" :),
  }));
  set("inquiry", ([
    "血祭": (: teach_perform :),

  ]));



  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}



void attempt_apprentice(object ob) {
  call_out("do_recruit", 1, ob);

}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "huashan");
}
void do_recruit(object ob) {
  command("shy");
  command("recruit " + ob->query("id"));
}

void re_rank(object student) {
  student->set("title", "华山派弟子");
  return;
}
int teach_perform() {
  object me;
  me = this_player();
  if ((string)me->query("class") != "huashan") {
    command("say 你不是华山弟子，我不能教你。\n");
    return 1;
  }
  if ((int)me->query("potential", 1) < 15000 || (int)me->query("str", 1) < 20) {
    command("hmm");
    command("say 你现在还领悟不了。");
    return 1;
  }
  if (me->query("marks/血祭")) {
    command("say 你怎么这么快又忘了呀？");
    return 1;
  }
  if ((int)me->query_temp("learn_perform")) {
    return 1;
  }
  me->add("potential", -15000);
  command("say 嗯，那好吧。");
  me->set_temp("learn_perform", 1);
  me->start_busy(12);
  call_out("learn_perform", 2, this_player(), this_object(), 0);


  return 1;
}
void learn_perform(object me, object ob, int utter) {
  message_vision(teach_msg[utter], ob, me);
  if (++utter < sizeof(teach_msg)) {
    call_out("learn_perform", 2, this_player(), this_object(), utter);
    return;
  }
  me->delete_temp("learn_perform");
  tell_object(me, HIR "\n你把华真真刚才所使的绝招在脑海里默默地演练了几遍，记在了心中。\n" NOR);
  me->set("marks/血祭", 1);
  return;

}
