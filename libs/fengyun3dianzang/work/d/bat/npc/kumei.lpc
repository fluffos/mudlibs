inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  set_name("枯梅大师", ({ "master kumei", "master", "kumei" }));
  set("nickname", HIW "铁仙姑" NOR);
  set("gender", "女性");
  set("age", 56);
  set("int", 40);
  set("spi", 21);
  set("cor", 15);
  set("con", 20);
  set("per", 15);
  set("str", 30);
  set("attitude", "peaceful");
  set("max_force", 9500);
  set("force", 19000);
  set("force_factor", 30);
  set("max_gin", 5000);
  set("max_kee", 100000);
  set("max_sen", 500);
  set("long",
    "这是一个白发苍苍的老妇，一张干枯瘦削的脸上满是伤疤，耳朵缺了半个，
眼睛也少了一只，剩下的一只眼睛半开半合，开合之间，精光暴射，无论谁也
不敢逼视。她身子很瘦小，但却有种说不出来的威严，无论谁人只要瞧上她 
一眼，连说话的声音都会压低些。\n"
  );

  create_family("华山派", 16, "掌门");
  set("combat_exp", 11000000);
  set_skill("move", 100);
  set_skill("parry", 90);
  set_skill("dodge", 100);
  set_skill("force", 120);
  set_skill("unarmed", 80);
  set_skill("zhaixin-claw", 60);
  set_skill("huashan-force", 200);
  set_skill("literate", 100);
  set_skill("sword", 150);
  set_skill("wind-sword", 180);
  set_skill("huashan-steps", 220);

  map_skill("force", "huashan-force");
  map_skill("parry", "wind-sword");
  map_skill("sword", "wind-sword");
  map_skill("dodge", "huashan-steps");
  map_skill("move", "huashan-steps");
  map_skill("unarmed", "zhaixin-claw");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "sword.qiankunjue" :),
    (: perform_action, "sword.tiancanjue" :),
    (: perform_action, "dodge.shenxingbaibian" :),
  }));

  setup();
  carry_object("/obj/weapon/sword")->wield();
  carry_object(__DIR__ "obj/cloth1")->wear();
}


void attempt_apprentice(object ob) {
  call_out("do_recruit", 1, ob);

}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "huashan");
}
void do_recruit(object ob) {
  if ((int)ob->query_skill("sword") < 100) {
    command("say 你的剑术造诣还不够高！\n");
    return;
  }
  command("hmm");
  command("recruit " + ob->query("id"));
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "华山派弟子");
    return;
  } else if (exp <= 128000) {
    student->set("title", "华山派小侠");
    return;
  } else if (exp <= 512000) {
    student->set("title", "华山派少侠");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "华山派大侠");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "华山派奇侠");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "华山派长老");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "华山派元老");
    return;
  } else
    student->set("title", "华山派副掌门");
  return;

}
