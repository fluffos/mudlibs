//XXDER
//Nun's master
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int give_book();
int ask_canchan();
void create()
{
        set_name( "玉芯" , ({ "master yu", "master", "yu" }) );
        set("gender", "女性");
        set("age", 36);
        set("long",
"\n她清丽高雅，斯文慈和，隐隐有种高华贵重的气象。
一个小小尼姑庵的主持竟有这等面相...\n");

        set("combat_exp", 5000000);
        set("score", 200000);
        set("class", "bonze");
        set("str", 30);
        set("int", 30);
        set("agi", 50);
        set("cps", 30);
        set("spi", 30);
        set("tol", 50);
        set("per", 50);
        set("force", 4000);
        set("max_force", 2000);
        set("force_factor", 30);
        set("atman", 1400);
        set("max_atman", 1400);
        set("chat_chance", 1);
        set("chat_msg", ({
name()+"看着天上的白云，轻轻地道：今天好平静......\n",
        }) );
        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 5);
        set("attitude", "peaceful");

        set("apprentice_available", 1);
        create_family("白云庵", 1, "主持");

        set_skill("literate", 220);
        set_skill("force", 30);
        set_skill("spells", 80);
        set_skill("parry", 50);
        set_skill("teadao", 150);
        set_skill("buddhism", 150);
        set_skill("move", 60);
        set_skill("dodge", 50);
        set_skill("unarmed", 100);
        set_skill("rainbow-zhi",150);
        set_skill("acupuncture", 300);
        map_skill("unarmed", "rainbow-zhi");
        map_skill("parry", "rainbow-zhi");
        set_temp("apply/dodge", 500);
        set_temp("apply/armor", 2000);
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
            (: perform_action, "unarmed.changhongjingtian" :),
        }) );
             set("inquiry", ([
                "品茶" : (:give_book:),
                "茶道" : (:give_book:),
                "参禅" : (:ask_canchan:),
                "canchan" : (:ask_canchan:)

        ]));
        setup();
        carry_object("obj/cloth")->wear();
        carry_object(__DIR__"obj/book1");

}

int give_book()
{
      object me,book;
      me = this_player();
      if((string)me->query("family/family_name")!="白云庵") 
      {
      command("smile");
      return 1;
      }
      if( book = present("teabook", this_object())) 
      {
      command("smile");
      command("say 这“和、敬、清、寂”四字须得紧记。\n");
      book->move(me);
      message_vision(HIY "$N微笑着将一本书递给了$n。\n" NOR, this_object(), me );
      }
      return 1;
}


void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 贫尼今天不想再收徒了。");
        }
}

void do_recruit(object ob)
{
        if( (string)ob->query("gender") != "女性" )
                command("say 贫尼是出家人，不便收男徒，得罪了。");
        else {
        if( ob->query("class") || ob->query("marry") || ob->query("divorced")) { 
                command("say 小小的白云庵，岂能容得下九天麟凰，请回吧。\n");
                       } 
                      else {
                command("say 嗯，不错。");
                command("recruit " + ob->query("id") );}
        }
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
            ob->set("class", "bonze");
        add("apprentice_availavble", -1);
}

 
void re_rank(object student)
{
	student->set("title","白云庵庵姑");
       return ;

}

int ask_canchan()
{
        object me=this_player();
        //The canchan bonus designed for 白云庵 only, becoz nun is too weak.
        //XXDER 9/6/2001
	 if((string)me->query("family/family_name")!="白云庵") 
        {
        message_vision(CYN "$N合十道：外人不可在庵堂内参禅，得罪了。\n" NOR,this_object(), me);
        return 1;
        }

        if(me->query_temp("canchan")>10)
        {
        tell_object(me,CYN"玉芯对你说道：“你先去庵堂参悟我刚才所说的吧。”\n"NOR);
        return 1;
        }
        tell_object(me,CYN"玉芯向你讲解了一会儿佛法。\n"NOR);
        tell_object(me,CYN"玉芯对你说道：“你先去庵堂参悟我刚才所说的吧。”\n"NOR);
        me->set_temp("canchan",300);
        return 1;
}

