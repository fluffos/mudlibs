inherit ITEM;
void create()
{
	set_name("茶艺", ({ "teabook" }));
	set_weight(600);
	if( clonep() )
              set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
			"这是一本茶道秘籍。\n");
              set("value", 0);
              set("no_drop",1);
              set("no_get",1);
              set("material", "wood");
              set("skill", ([
			"name": 		"teadao",	
			"exp_required":		1000,		
			"sen_cost":		30,	
			"difficulty":	30,	
			"max_skill":	99		
		]) );
	}
}
