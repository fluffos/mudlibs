// TIE@FY3 ALL RIGHTS RESERVED
inherit ROOM;
int doing_canchan(mixed me);
int doing_pause(object me);
void create()
{
        set("short", "庵堂");
        set("long", @LONG
庵堂正中供奉着一幅水墨画，四壁以松木拾成，板门木柱，
木料均不去皮，天然质朴。左侧的墙前整齐地排着一列蒲团。这
里是参禅(canchan)的好地方。你要是无法入定也可以出去走走
再回来(pause)。
LONG
        );
        set("exits", ([ 
             "east" : __DIR__"annei",
]));
        set("no_fight",1);
        set("no_magic",1);
        set("NONPC",1);
        set("coor/x",-660);
        set("coor/y",-530);
        set("coor/z",30);
        setup();
}
void init()
{
        add_action("do_pause","pause");
        add_action("do_canchan","canchan");
}

int do_canchan(string arg)
{
        object me=this_player();

        if (me->is_busy() || me->query_temp("pending/canchan"))
                return notify_fail("你现在正忙着呢。\n");

        if( me->is_fighting() )
                return notify_fail("战斗中不能静心参禅。\n");
        
        message_vision("$N脸朝里壁，盘膝坐在蒲团上开始参禅。\n", me);

        me->start_busy( (: doing_canchan :),(: doing_pause :));
        me->add_temp("apply/short", ({ me->name() + "正面壁入定 ..." }));
        return 1;
}

int doing_canchan(mixed me)
{
        int i,lvl;
        string *str=({"你的思绪慢慢宁静下来。\n",
                        "你慢慢潜思入定。\n",
                        "你慢慢物我两忘。\n",
                        "你的心境渐渐清明。\n",
                        "你慢慢地领悟到佛的精髓。\n",
                        "你觉得自己进入了一个前所未有的境界。\n"});
        
        if(!objectp(me)||!interactive(me)) return 0;

        if(me->query_temp("canchan")<1) 
        {
                tell_object(me,"你只觉心浮气躁，无法静心。\n");
                me->delete_temp("apply/short");
                return 0;
        }

        me->add_temp("canchan",-2);

        if(me->query("force")<me->query("max_force")*2)
           me->add("force",me->query_skill("force")/10);
        if(me->query_temp("canchan")>0) 
        {
            lvl = (me->query_skill("teadao",1)+me->query_skill("buddhism",1))/30;
            if(lvl > 10) lvl = 10;
            lvl = 11 - lvl;
            i = 5 - me->query_temp("canchan")/50;
            if(!random(15)) tell_object(me,str[i]);
            if(!random(lvl))
            {
                lvl += 1;
                if(!random(lvl))
                {
                me->add("potential",1);
                if(!random(3)) me->improve_skill("teadao", 1);
                }
                else
                {
                me->add("combat_exp",1);
                }
                me->improve_skill("buddhism", 1, 1);
            }
            return 1;
        }

        message_vision("$N缓缓睁开双眼，站了起来。\n", me);
        tell_object(me,"你只觉灵台一片清明，似乎禅意已尽。\n");
        me->delete_temp("apply/short");
 }

int do_pause(string arg)
{
        object me=this_player();

        if(stringp(arg))
                return 0;
        me->set_temp("pause_canchan",1);
        me->interrupt_me();
        return 1;
}

int doing_pause(object me)
{
        if(me->query_temp("pause_canchan"))
        {
                me->delete_temp("pause_canchan");
                tell_object(me,"你缓缓睁开双眼，站了起来。\n");
                me->delete_temp("apply/short");
                return 1;
        }
        else 
                return 0;
}
