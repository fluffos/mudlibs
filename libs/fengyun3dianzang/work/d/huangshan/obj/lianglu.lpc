
inherit ITEM;

void create()
{
	set_name("白泥凉炉", ({ "lianglu" , "白泥凉炉"}) );
	set_weight(500);
	set_max_encumbrance(80000);
	set("no_get", 1);
	set("no_shown", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "沏茶时用来煮水的白泥凉炉。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }
