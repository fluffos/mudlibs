inherit ROOM;
#include <room.h>
void create()
{
        set("short", "露地");
        set("long", @LONG
露地四周是围篱，自庵门至茶亭间还设有一条园路，两侧用植
被和白砂敷于地面。景致简朴而富有山陬村舍的野趣。露地西侧是
庵堂。
LONG);
        set("exits", ([ 
  "west" : __DIR__"antang",
  "northeast" : __DIR__"teating",
  "out" : __DIR__"baiyun",
]));
        set("outdoors", "huangshan");
        set("coor/x",-650);
        set("coor/y",-530);
        set("coor/z",30);
        setup();
        create_door("out", "木门", "enter", DOOR_CLOSED);
}
