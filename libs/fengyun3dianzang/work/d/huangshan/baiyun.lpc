inherit ROOM;
#include <room.h>
void create() {
  set("short", "白云庵");
  set("long", @LONG
长长的石阶，沿途尽是茂林修竹，树枝上挂着云雾草，越发增加了
清凉幽静的感觉，和前面的险峻截然不同。走完石阶便是白云庵，这是
一座明代的尼姑庵，小庵门前翠竹如海，诸潭环布，景色清幽至极。后
面便是五龙潭和翡翠池。
LONG
  );
  set("exits", ([
    "west": __DIR__ "feicui",
    "northup": __DIR__ "caishi",
    "east": __DIR__ "diezhang",
    "enter": __DIR__ "annei",
  ]));
  set("outdoors", "huangshan");
  set("coor/x", -650);
  set("coor/y", -540);
  set("coor/z", 30);
  setup();
  create_door("enter", "木门", "out", DOOR_CLOSED);
  replace_program(ROOM);
}
