string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  // AGENTS.md §15h: this driver's str[i] returns a Unicode codepoint,
  // not a GBK byte, so the original GBK lead-byte range check
  // (str[0] > 160 && str[0] < 255, strlen>=2) never matches real
  // Chinese text once strings are UTF-8. Replaced with a CJK Unicode
  // codepoint range check; a single Chinese character is valid input.
  if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff) return 1;
  return 0;
}
