// tie@fengyun

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra,afp,dfp,lost_force,lost_max_force;
	object weapon;
	if(!target) target=offensive_target(me);
	if(!target
	||	!target->is_character()
	||	!me->is_fighting(target) )
            return notify_fail(HIG"［乾坤决］"NOR"只能对战斗中的对手使用。\n");
	     weapon=me->query_temp("weapon");
	     extra=me->query_skill("wind-sword",1);
            if(extra<150) return notify_fail("你的［清风十三式］还不够精熟！\n");
            if(me->query("force")<500)
            return notify_fail("你的内力不够，无法使出［乾坤决］！\n");
            if(!target->is_busy()&&!target->query_temp("is_unconcious"))
            return notify_fail("你的对手正精神高度集中，无法使出［乾坤决］！\n");                    
            if(target->query("force")<100&&target->query("max_force")<100) 
            return notify_fail("你的对手已经内力尽失，无气可破了。\n");

            msg=HIY "\n$N捻个剑决，手中"+ weapon->name()+ HIY"抖出的逼人剑气破空而出，直射向$n的丹田。"NOR;
            me->start_busy(3);
            me->add("force",-250);
            me->improve_skill("wind-sword", 1, 1);


            lost_force=me->query("force")-target->query_skill("force");
            if(lost_force>target->query("force")) lost_force=target->query("force");
            if(lost_force<1) 
            lost_force=1;
            lost_max_force=target->query("max_force")/20;
	     afp=me->query_skill("sword")/2+me->query_skill("force")/2;
            dfp=target->query_skill("force");
            afp=(afp/10*afp/10*afp)/5+me->query("combat_exp")/25;
            dfp=(dfp/10*dfp/10*dfp)/5+target->query("combat_exp")/25;

            if(random(afp+dfp/3)<dfp/3) 
            {
            msg+="\n$n气运丹田，把剑气挡于体外。\n";
            }
            else if(random(afp+dfp*2)<dfp*2) 
            {                        
            msg+=BLU"\n$n只觉气海穴上微微一痛，全身真气狂泄而出！\n" NOR;
            target->add("force", -lost_force);
            }
            else
            {
            msg+=HIC"\n$n只觉气海穴上剧痛，真元已经受损！\n" NOR;
            target->add("force", -lost_force);
            target->add("max_force", -lost_max_force);
            }
	     message_vision(msg, me, target);
            return 1;
}
