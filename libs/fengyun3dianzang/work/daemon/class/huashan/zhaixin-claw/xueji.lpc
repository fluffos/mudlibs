// tie@fengyun
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra,i,lmt;
	int damage,ap,dp;
       object heart;
	if(!target) target=offensive_target(me);
       extra=me->query_skill("zhaixin-claw",1);
       if(extra<100) 
              return notify_fail("你的［摘心手］还不够纯熟！\n");
       if(!me->query("marks/血祭")&&userp(me))
              return notify_fail("你未得传授此招。\n");
       if(!target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(RED"［血祭］"NOR"只能对战斗中的对手使用。\n"NOR); 

        msg = HIB"\n$N"HIB"的脸上露出一股阴深恐怖的青气，嘴角泛起一丝狞笑....青光一闪, $N"HIB"五指成爪鬼魅般地探向$n"HIR"的胸膛!!\n"NOR;
        me->start_busy(3);
	 me->receive_damage("sen", 200, me);
        me->improve_skill("zhaixin-claw", 1, 1);

        ap=me->query_skill("unarmed");
        ap=(ap/10*ap/10*ap)/5+me->query("combat_exp")/25;

        dp=target->query_skill("dodge")/2+target->query_skill("parry")/2;
        dp=(dp/10*dp/10*dp)/5+target->query("combat_exp")/25;

        if(target->is_busy()) dp/=5;
        if((int)target->query_temp("is_unconcious")) dp=1;

        damage=me->query_str()+me->query_skill("unarmed")-target->query_temp("apply/armor");
        damage+=random(damage);
        damage*=3;

        if(ap<dp/2+random(dp))
        {
        msg+="$n大惊之下，狼贝万分地就地一滚，总算逃过了一劫！\n" NOR;
        message_vision(msg,me,target);          
        }
        else
        {
        msg+=HIR"\n$n"HIR"惊惶失措之下，未及反应，胸膛已被$N"HIR"的五指插入！！\n"NOR;
        message_vision(msg,me,target);
        target->receive_damage("kee", damage, me);
        if(damage>0) COMBAT_D->report_status(target);

        lmt=me->query("unarmed")/30;
        for(i=1;i<=lmt;i++)
	 {
        if(random(ap)<random(dp)) break;
	 msg=RED"\n$N"RED"的手在$n"RED"胸膛里疯狂扭旋，鲜血从$n"RED"的胸口狂喷而出！！！\n"NOR;
        message_vision(msg,me,target);
	 target->receive_damage("kee", damage/2, me);
        me->add("bellicosity", damage/10);
        if(damage>0) COMBAT_D->report_status(target);
        if((int)target->query("kee")<0) break;
        }

        if((int)target->query("kee")<0)
        {
        msg=HIR"\n$N"HIR"突然仰天狂笑，手已从$n"HIR"的胸膛抽了出来，手里握着一颗血淋淋的心！\n"NOR;
        heart=new("/obj/heart");
        heart->set("name",RED + target->query("name") +"的心"NOR);
        heart->save();
        heart->move(me);
        }
        else
        {
        msg=HIY"\n$n"HIY"剧痛之下就地一滚，终于摆脱了$N"HIY"的魔爪，胸口已多了个血肉模糊的大窟窿！\n"NOR;
        }
        message_vision(msg,me,target);
        }       
        return 1;
}
