//XXDER/TIE
//strike back!
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int i, rate, enforce;
  if (!target) target = offensive_target(me);
  if (me->query_skill("bloodystrike", 1) < 20)
    return notify_fail("你的［密宗大手印］还不够纯熟！\n");
  if (me->query_skill_mapped("force") != "bolomiduo")
    return notify_fail("密宗大手印必须和婆萝蜜多心经配合使用！\n");
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［修罗印］只能对战斗中的对手使用。\n" NOR);
  if ((int)me->query("force") < 200) return notify_fail("你的内力不够！\n");

  if (me->query_temp("last_damage_from") != target) {
    msg = HIC "\n$N用尽全力，一招［修罗印］从$n意想不到的角度拍了过去！\n可惜$n早有准备，轻易就躲开了这一招。\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(1);
    return 1;
  }
  msg = HIR "\n$N趁$n正得意之际，一招［修罗印］从$n意想不到的角度拍了过去！\n$n怎么也想不到$N还有这招！" NOR;
  me->start_busy(2);

  rate = me->query_skill("force") * (me->query("max_kee") - me->query("kee")) / me->query("max_kee");
  if (rate > 50) rate = 50;
  enforce = me->query("force_factor");

  me->add_temp("apply/damage", rate * 2);
  me->add("force_factor", enforce * 2);
  target->add_temp("apply/defense", -rate);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  if (!me) return 1;
  me->add_temp("apply/damage", -rate * 2);
  me->add("force_factor", -enforce * 2);
  target->add_temp("apply/defense", rate);
  return 1;
}
