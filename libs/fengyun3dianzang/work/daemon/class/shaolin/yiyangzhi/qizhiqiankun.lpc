#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int ap, dp, afp, dfp;

  if (!target) target = offensive_target(me);
  if ((int)me->query_skill("yiyangzhi", 1) < 100 && userp(me))
    return notify_fail("你的［一阳指］还不够纯熟！\n");
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［气指乾坤］只能对战斗中的对手使用。\n" NOR);
  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够！\n");
  if (target->query_temp("perform/blocked"))
    return notify_fail("你的对手已经无力进攻了。\n");

  msg = HIY "\n$N伸出右手食指向$n凌空一点，一股阳和的气流向$n直逼过去。\n" NOR;
  me->start_busy(4);
  me->add("force", -200);
  me->improve_skill("yiyangzhi", 1, 1);

  ap = me->query_skill("unarmed");
  ap = (ap / 10 * ap / 10 * ap) / 5 + me->query("combat_exp") / 25;

  dp = (target->query_skill("dodge") + target->query_skill("parry")) / 2;
  dp = (dp / 10 * dp / 10 * dp) / 5 + target->query("combat_exp") / 25;

  if (target->is_busy()) dp /= 3;
  if ((int)target->query_temp("is_unconcious")) dp = 1;

  afp = me->query_skill("force");
  afp = afp / 10 * afp / 4 * afp + me->query("combat_exp") / 10;

  dfp = target->query_skill("force");
  dfp = dfp / 10 * dfp / 4 * dfp + target->query("combat_exp") / 10;

  if (random(ap + dp / 3) < dp / 3) {
    msg += "$n一惊之际，连忙往傍让开。\n";
  } else if (random(afp + dfp / 3) < dfp / 3) {
    msg += "$n连忙运气护体，把指气化于无形。\n";
  } else {
    msg += "$n只觉得丹田一痛，真气竟然再也不能凝聚！\n";
    target->set_temp("perform/blocked", 30);
    target->set("force_factor", 0);
    target->start_call_out((: call_other, __FILE__, "remove_effect", target :), 1);
  }
  message_vision(msg, me, target);
  return 1;
}

int remove_effect(object target) {
  if (!target) return 0;
  target->add_temp("perform/blocked", -1);
  if (target->query_temp("perform/blocked"))
    call_out("remove_effect", 1, target);
  else
    tell_object(target, "你终于觉得真气又可以运转自如了。\n");
  return 1;
}
