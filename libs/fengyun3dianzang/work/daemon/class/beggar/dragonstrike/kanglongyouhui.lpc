// tie@fengyun

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg, action_msg, *limbs, limb;
  int force_damage, anti_force;
  int ap, dp, pp, basic_damage, damage, wounded = 0;
  object yourweapon;

  if (!target) target = offensive_target(me);
  if (me->query_skill("dragonstrike", 1) < 120)
    return notify_fail("你的［降龙十八掌］还不够纯熟！\n");
  if (!me->query("marks/亢龙有悔") && userp(me))
    return notify_fail("这招失传已久，你又怎会懂得使？！\n");
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(HIR "［亢龙有悔］" NOR "只能对战斗中的对手使用。\n" NOR);
  if ((int)me->query("force") < 200) return notify_fail("你的内力不够！\n");

  limbs = me->query("limbs");
  limb = limbs[random(sizeof(limbs))];

  message_vision(HIG "\n$N左手划个半弧，右手一招［亢龙有悔］雷霆万钧地拍向$n！\n" NOR, me, target);
  me->start_busy(3);
  me->add("force", -200);
  me->improve_skill("dragonstrike", 1, 1);

  yourweapon = target->query_temp("weapon");
  if (yourweapon && (string)yourweapon->query("skill_type") == "throwing") yourweapon = 0;

  ap = me->query_skill("unarmed");
  dp = target->query_skill("dodge");
  pp = target->query_skill("parry");
  ap = (ap / 10 * ap / 10 * ap) / 5 + me->query("combat_exp") / 25;
  dp = (dp / 10 * dp / 10 * dp) / 5 + target->query("combat_exp") / 25;
  pp = (pp / 10 * pp / 10 * pp) / 5 + target->query("combat_exp") / 25;
  if (target->is_busy()) {
    dp /= 5;
    pp /= 5;
  }
  if ((int)target->query_temp("is_unconcious") || (string)target->query("race") == "野兽") {
    dp = 1;
    pp = 1;
  }
  basic_damage = me->query_str() * 4 + me->query("force") / 5 + me->query("force_factor") * 10 - target->query("force") / 5 - target->query_str() * 4;
  basic_damage += me->query("max_force") + me->query_str() * me->query_str() + me->query_temp("apply/damage") * 2;
  if (basic_damage < 1) basic_damage = 1;

  force_damage = me->query("force") / 10 + me->query("max_force") / 4;
  if (userp(target)) anti_force = target->query("force") / 10 + target->query("max_force") / 4;
  else anti_force = target->query("force") / 200;

  if (random(ap + dp / 3) < dp / 3) {
    message_vision(HIY "$N见机不对往后狠命一跳，躲开了$n的致命一击！\n" NOR, target, me);
  } else if (random(ap + pp / 3) < pp / 3) {
    message_vision(HIC "$N轻轻一拨，把$n的劲道给轻描淡写的化解了！\n" NOR, target, me);
  } else if (random(ap + 2 * pp) < 2 * pp) {
    if (yourweapon) {
      message_vision(
        HIC "$N想躲已经来不及了，只好全力举起" + yourweapon->query("name") + HIC "硬接这招！\n" NOR,
        target
      );
      damage = random(basic_damage) / 2 + basic_damage / 4;

      if (random(ap + pp) > pp &&
        random(me->query_str() + force_damage) > (yourweapon->weight() / 100 + anti_force) / 2) {
        damage += basic_damage / 4;
        message_vision(
          HIW "只听见「啪」地一声，$N手中的" + yourweapon->query("name") + HIW "已被震成两段！\n" NOR,
          target
        );
        yourweapon->unequip();
        yourweapon->set("name", "断掉的" + yourweapon->query("name"));
        yourweapon->set("value", 0);
        yourweapon->set("weapon_prop", 0);
        yourweapon->set("no_get", 0);
        yourweapon->save();
        target->reset_action();
        message_vision("右掌的去势稍缓，但还是打在了$N的身上！\n", target);
      }
      target->receive_damage("kee", damage, me);
      action_msg = COMBAT_D->damage_msg(damage, "瘀伤");
      action_msg = replace_string(action_msg, "$l", limb);
      message_vision(action_msg, me, target);
      if (damage > target->query("force") / 40 + target->query_temp("apply/armor")) {
        target->receive_wound(
          "kee",
          damage - target->query("force") / 40 - target->query_temp("apply/armor"),
          me
        );
        wounded = 1;
      }
      COMBAT_D->report_status(target, wounded);
    } else {
      message_vision(HIC "$N想躲已经来不及了，只好出掌往前全力一格！\n" NOR, target);
      damage = random(basic_damage) * 3 / 5 + basic_damage * 2 / 5;
      target->receive_damage("kee", damage, me);
      action_msg = COMBAT_D->damage_msg(damage, "瘀伤");
      action_msg = replace_string(action_msg, "$l", limb);
      message_vision(action_msg, me, target);
      if (damage > target->query("force") / 40 + target->query_temp("apply/armor")) {
        target->receive_wound(
          "kee",
          damage - target->query("force") / 40 - target->query_temp("apply/armor"),
          me
        );
        wounded = 1;
      }

      COMBAT_D->report_status(target, wounded);

    }
  }

  else {
    message_vision(HIR "只听见啪的一声巨响，$N" HIR "的右掌已经扎扎实实的拍在$n" HIR "身上了！\n" NOR, me, target);
    damage = (basic_damage + random(basic_damage)) * 5 / 2;
    target->receive_damage("kee", damage, me);
    action_msg = COMBAT_D->damage_msg(damage, "瘀伤");
    action_msg = replace_string(action_msg, "$l", limb);
    message_vision(action_msg, me, target);
    if (damage > target->query("force") / 40 + target->query_temp("apply/armor")) {
      target->receive_wound("kee", damage - target->query_temp("apply/armor"), me);
      wounded = 1;
    }
    COMBAT_D->report_status(target, wounded);
  }
  if (target->query("eff_kee") < 0) {
    target->die();
  }
  return 1;

}
