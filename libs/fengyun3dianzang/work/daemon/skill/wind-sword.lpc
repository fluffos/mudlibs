// wind-sword.c
#include <ansi.h>
inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N忽然面露微笑，一招「"HIG"清风徐来"NOR"」，右手$w一闪，舞出三团剑花刺向$n的上中下三路。",
                "dodge":                -20,
                "damage":               80,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N回身低首，神色黯然，一招「"HIG"清风指柳"NOR"」，$w剑尖游移不定地刺向$n的$l",
                "dodge":                -20,
                "damage":               70,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N一招「"HIG"御风而行"NOR"」，身形陡然滑出数尺，手中$w斩向$n的$l",
                "dodge":                -30,
                "damage":               40,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N坐手掩面，一招「"HIG"风拌流云"NOR"」，右手$w斜向下划出，$n微觉奇怪，正迟
疑间，却见$N手中的$w已反挑而上，直刺自己的咽喉",
                "dodge":                -40,
                "damage":               50,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"但见$N挺身而上，$w一旋，一招清风十三式中的「"HIG"来鹤清风"NOR"」直刺$n。",
                "dodge":                -20,
                "damage":               60,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N脸上突现笑容，似乎已看破$n的武功招式，胸有成竹地一剑「"HIG"朔风吹雪"NOR"」刺向$n的$l！",
                "dodge":                -20,
                "damage":               50,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N含笑抱剑，气势庄严，$w轻挥，一式「"HIG"清风拂桂"NOR"」闲舒地刺向$n！",
                "dodge":                -20,
                "damage":               40,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N横剑上前，身形一转手中$w使一招「"HIG"乘风归去"NOR"」画出一道光弧斩向$n的$l",
                "dodge":                -30,
                "damage":               80,
                "damage_type":  "割伤"
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 150 )
                return notify_fail("你的内力不够，没有办法练清风十三式。\n");

        if( (string)me->query_skill_mapped("force")!= "huashanforce")
                return notify_fail("清风十三式必须配合华山派内功才能练。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return 
notify_fail("你的内力或气不够，没有办法练习清风十三式。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你按著所学练了一遍清风十三式。\n");
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("huashan") + "/wind-sword/" + action;
}
 
int effective_level() { return 25;}

string *parry_msg = ({
        "$n使出一招「清风徐来」，手中的$v化作一条长虹，磕开了$N的$w。\n",
        "$n使出「封」字诀，将$N的$w封于丈外。\n",
        "$n使出一招「清风指柳」，手中的$v化做漫天雪影，荡开了$N的$w。\n",
        "$n手中的$v一抖，一招「旱地春雷」，向$N拿$w的手腕削去。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
        "$n反手一招「乘风归去」，整个人消失在一团剑光之中。\n",
        "$n使出一招「御风而行」，$v直刺$N的双手。\n",
        "$n将手中的$v化做十三道剑气，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus()
{
	return -20;
}
int practice_bonus()
{
	return -30;
}
int black_white_ness()
{
	return 15;
}

