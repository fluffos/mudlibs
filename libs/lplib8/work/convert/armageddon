This is the  usual shut-down deamon, which I  hacked  a little  around
with, in order to display (to wizards) how much time left  before next
reboot.  Players  can only see   if there  is  less  than  1/2 hour to
reboot.

I have  also installed a command for  shutting the game down.  You can
give a number of minutes (optional) as the delay:

fastshut [mins]

0 will  reboot IMMEDIATELY. Only Wizards  with level > REBOOTLEVEL can
use 'fastshut'.

The daemon will offer  teleportation to  the shop for all players when
commencing the  reboot-phase. Make the players  'tell' the daemon, and
they will be teleported.

This daemon has run in(at) Deep Trouble for about  1 1/2 month now. No
problems yet.  Hope anyone  can use this.   If  you have  Any Trouble,
please send me mail.

Olorin, ArchWizard @ Deep Trouble MUD, 130.225.48.94 4242
==============================================================================
/*
 * This is a shut down deamon, that will take care of shutting down
 * the game.
 * Call the function "shut" with a number of minutes as an argument.
 *
 * 12/7/91: Enhanced by Olorin for Deep Trouble to include an optional view
 *          of how much time is before reboot (Wizards) or less than 1/2
 *          hour (players)
 *          Wizard level >= reboot may reboot the game using 'fastshut [mins]'
 */

#include "time.h"

inherit "obj/monster";

#define REBOOTLEVEL 1000

int initial_c_time;
int initial_m_time;
int shut_c_time;
int shut_m_time;

reset(arg) {
    int out;
    ::reset(arg);
    if (arg)
	return;
    set_name("armageddon");
    set_level(49);
    set_wc(400);
    set_ac(40);
    set_short("Armageddon the game crasher");
    set_alias("shut");

    mmsgin = "Arrives in a puff of hemp smoke";
    move_player("X#room/church");

    initial_m_time = time();
    shut_m_time = MORNING - (initial_m_time + TIME_ADJUST) % DAY;

    initial_c_time = 0;
    shut_c_time = 0;

    if (shut_m_time < 0)
	shut_m_time += DAY;
    call_out("start_shut", shut_m_time);
}

init() {
    if (call_other(this_player(),"query_level") >= REBOOTLEVEL)
	add_action("shut","fastshut");
}

long(str) {
    write("He looks like he enjoys killing the game.\n" +
	  "He also looks like he would kill you if you attacked him.\n" +
	  "Perhaps it is best not to try.\n");
    show();
}

start_shut() {
	shut("5");
}

shut(m)
{
    int minutes;
    
    write("Ok.\n");

    if (!m) {
	write("No time given\n");
	write("Assuming 5 minutes.\n");
	minutes = 5;
    } else
	sscanf(m, "%d", minutes);

    if (minutes < 0)
	minutes = 0;

    shut_c_time = minutes * 60;
    initial_c_time = time();
    
    call_out("cont_shutting", 0, shut_c_time);

    return 1;
}

format_seconds(seconds) {
    string time_str;
    int time_rest;
    
    time_str = "";
    time_rest = seconds;
    
    if (time_rest >= 60*60*24) {
	if (time_rest < 60*60*24*2) {
	    time_str = " 1 day";
	} else {
	    time_str = " " + time_rest/(60*60*24) + " days";
	}
	time_rest = time_rest % (60*60*24);
    }
    if (time_rest >= 60*60) {
	if (time_rest < 60*60*2) {
	    time_str += " 1 hour";
	} else	{
	    time_str += " " + time_rest/(60*60) + " hours";
	}
	time_rest = time_rest % (60*60);
    }
    if (time_rest >= 60) {
	if (time_rest < 60*2) {
	    time_str += " 1 minute";
	} else {
	    time_str += " " + time_rest/60 + " minutes";
	}
	time_rest = time_rest % 60;
    }
    if (time_rest > 0) {
	if (time_rest == 1)
	    time_str += " 1 second";
	else
	    time_str += " " + time_rest + " seconds";
    }
    time_str += ".\n";

    return time_str;
}
	    
int transport_offer;

cont_shutting(seconds) {
    int new_delay;

    if (seconds <= 0) {
	shout(cap_name + " shouts: I will reboot now.\n");
	shutdown();
	return;
    }
    if (seconds <= 240 && !transport_offer) {
	shout(cap_name +
	    " shouts: 'tell' me if you want a trip to the shop !\n");
	transport_offer = 1;
    }
    new_delay = seconds * 3 / 4 - 10;
    call_out("cont_shutting", seconds - new_delay, new_delay);
    shout(cap_name + " shouts: Game reboot in" + format_seconds(seconds));
}

catch_tell(str) {
    string who, what;
    object ob;

    if (!transport_offer)
	return;
    if (sscanf(str, "%s tells you: %s", who, what) != 2)
	return;
    this_player()->move_player("X#room/shop");
}

show() {

    int how_c_long;
    int how_m_long;

    how_c_long = (shut_c_time+initial_c_time) - time();
    how_m_long = (shut_m_time+initial_m_time) - time();
    
    if (call_other(this_player(),"query_level") < 20)
    {
	write("You seem to notice that he is concentrating on counting.\n");

	/* Inform lower-level creatures about reboot if less that 1/2 hour */

	if (how_m_long < 60*30 || ( how_c_long > 0 && how_c_long < 60*30))
		write("You get the feeling that he will wake up\n" +
		      "in less than half an hour and kill the game.\n");
	return 1;
    }

    write("Morning shutdown : " + format_seconds(how_m_long));

    if (shut_c_time)
	write("Current shutdown : " + format_seconds(how_c_long));

    return 1;
}
