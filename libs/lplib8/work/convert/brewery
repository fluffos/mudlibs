/*
	takes the index into the items array and sets the stock value.
	or whatever the appropriate "field" is in the below procs.
*/
set_stock(num, amount)
{
	if (num > sizeof(stock) || num < 0) return;
	stock[num] = amount;
	return 1;
}

add_stock(num, amount)
{
	stock[num] += amount;
	return 1;
}

set_size(num, amount)
{
	if (num > sizeof(size) || num < 0) return;
	size[num] = amount;
	return 1;
}

set_cost(num, str)
{
	if (num > sizeof(cost) || num < 0) return;
	cost[num] = str;
	return 1;
}

/*
	Removes item X from all the field arrays.
*/
remove_item(x) {
	if (x < 0 || !intp(x) || x > sizeof(item)) return;
	item = fix_array(item, x);
	heal = fix_array(heal, x);
	cost = fix_array(cost, x);
	mess = fix_array(mess, x);
	stock = fix_array(stock, x);
	strength = fix_array(strength, x);
	food = fix_array(food, x);
	size = fix_array(size, x);	
	return 1;
}

fix_array(arr, t) {
array a,b;
	a = extract(arr, 0, t-1);	
	b = extract(arr, t+1);
	return (a + b);
}

set_hours( morn, even )
{
	if (!morn || !even) return 0;
	if (!stringp(morn) || !stringp(even)) return 0;
	hours = ({ morn, even });	
	return 1;
}

/*
	Determines whether or not it is in within operating hours.

	Returns rejection mess if it is not.
*/
out_of_hours()
{
string tim;
	if (pointerp(hours)) {
		/* I hope you have a game clock :-) */
		tim = "obj/game_clock"->query_time();
		if (hours[1] > hours[0]) {
			if (tim < hours[0] || tim > hours[1]) {
				return ("The shop is closed, please come back between the hours of "+hours[0]+" and "+hours[1]+".\n");
			}
		}
		else {
			if (tim < hours[0] && tim > hours[1]) {
				return ("The shop is closed, please come back between the hours of "+hours[0]+" and "+hours[1]+".\n");
			}
		}
	}
	return 0;
}

/*
	Will determine if the shopkeeper is here.

	o Bartender code is currently awaiting some other wizards
	production (ie. a generic bartender).
*/
bartender() 
{
	return 0;
}
/*
	Ok for a player to buy ?
	Return 0 if its ok, otherwise rej message.
*/
ok_to_buy(flag, num)
{
object pob;
	pob = this_player();
	if (!flag && (pob->query_money() < cost[num])) {
		return("The "+shopkeeper+" says: You don't have enough money! Beat it!\n");	
	}
	if (stock[num] <= stock_remove && owner) {
		return ("The "+shopkeeper+" says: I'm sorry - we're out of that at the moment!\nThe "+shopkeeper+" says: Perhaps you should contact "+capitalize(owner)+" about the situation.\n");
	}
	return 0;
}

/*
	Charge the player appropriately.
	Determine if it is the owner and give it to them free.
*/
charge_player(flag, num)
{
object pob;
	pob = this_player();

	if (!flag) {
		write("You pay " + cost[num] + " coins for a " + item[num] + ".\n");
		say(capitalize(pob->query_name()) + " orders a " + item[num] + ".\n");
		pob->add_money( - cost[num] );
	}
	else {
		write("You get a " + item[num] + " on the house.\n");
		say(capitalize(pob->query_name()) + " gets a " + item[num] + " on the house.\n");
	}
	return 1;
}

/*
	The consume function is for consumption at the premesis
	(ie. pubs & restaurants), if package is set then
	a package is produced.
	
	The flag indicates whether or not you have to pay :-).
*/

consume(str,flag)
{
int num, i, me, tim, no_buy;
object pob, pk;

	notify_fail("What would you like to order?\n");
	if (!str) return 0;

	if ((tim = out_of_hours())) {
		write (tim);
		return 1;
	}
	if ((tim = bartender())) {
		write (tim);
		return 1;
	}
	pob = this_player();
	num = get_num(str);
	if (num == -1) return 0;

	if (!flag && owner && pob->query_real_name() == owner) {
		flag = 1;
		write("The "+shopkeeper+" says: Good to see you "+capitalize(owner)+".\n");
	}
	if ((tim = ok_to_buy(flag, num))) {
		write (tim);
		return 1;
	}

	if (!package) {
		if (strength[num] && !pob->drink_alcohol(strength[num])) {
			write("The "+shopkeeper+" says: I think you've had enough.\n");
			say(capitalize(pob->query_name()) + " asks for a " + str + " but the "+shopkeeper+" refuses.\n");
			no_buy = 1;
		}
	    /* should do a food "cooking" delay here! -- later. */
		if (food[num] && !pob->eat_food(food[num])) {
			write("The "+shopkeeper+" says: You look awfully full - you're not going to be ill in my place!\n");
			say(capitalize(pob->query_name()) + " asks for a " + str + " but the "+shopkeeper+" refuses.\n");
			no_buy = 1;
		}
		if (no_buy) return 1;
		write(mess[num] + ".\n");
		if (heal[num] > 0) pob->heal_self(heal[num]);
		else pob->damage(-heal[num]);
		
    	}
	else {
		pk = clone_object(PACKAGE);
		if (strength[num])
		pk->set_package(item[num], heal[num], strength[num], 
				food[num], mess[num], "bottle");
		else
		pk->set_package(item[num], heal[num], strength[num], 
			food[num], mess[num], "container");

		if (transfer(pk, pob)) {
			write("The "+shopkeeper+" says: You're carrying too much!\n");
			destruct(pk);
			return 1;
		}
     }
     charge_player(flag, num);	
     if (owner) {
	     stock[num] -= 1;
	     if (!flag) add_accum(cost[num]);
	     if (package) add_accum(-pk->query_value());
     }
     if (stock[num] <= stock_remove) remove_item(num);
     return 1;
}

/*
	Clones up a food holding barrel and makes it
	available for transfer to the purchaser.
	(really a simple item to make)
*/
make_barrel(i)
{
object a;
	stock[i] -= size[i];
	if (!owner || item[i] > 0)
	{
	a = clone_object("players/dredd/barrel");
	a->set_message(mess[i]);
	a->set_id(item[i]);
	a->set_heal(heal[i]);
	a->set_strength(strength[i]);
	a->set_amount(size[i]);
	a->set_food(food[i]);
	a->set_weight(10); /*(size[i] / 5); */
	}
	return a;
}


order(str,flag) {
int num,i, tim; 
object mb, pob;
	notify_fail("What would you like to order?\n");
	if (!str) return 0;
	if ((tim = out_of_hours())) {
		write (tim);
		return 1;
	}
	if ((tim = bartender())) {
		write (tim);
		return 1;
	}
	pob = this_player();

	num = get_num(str);
	if (num == -1) return 0;

	if (!flag && owner && pob->query_real_name() == owner) {
		flag = 1;
		write("The "+shopkeeper+" says: Good to see you "+capitalize(owner)+".\n");
	}
	if ((tim = ok_to_buy(flag, num))) {
		write (tim);
		return 1;
	}

    	mb = make_barrel(num);
    	if (!mb) {
		write("The "+shopkeeper+" says: Sorry we don't have enough to sell!\n");
		return 1;
	}
	if (transfer(mb, pob)) {
		write("The "+shopkeeper+" says: You don't seems to be able to carry anymore!\n");
		return 1;
	}
     	charge_player(flag, num);	
        if (owner) {
		     stock[num] -= 1;
		     if (!flag) add_accum(cost[num]);
	 }
    	 if (stock[num] <= stock_remove) remove_item(num);  
   	 return 1;
}

/*
	Translate the player's order into an array access number!
*/
get_num(str) {
int num,i;
string tmps;
	sscanf(str, "%d", num);
	if (!num) {
	num = -1;
		for (i=0; i < sizeof(item); i++) 
			if (sscanf(lower_case(item[i]), "%s"+lower_case(str)+"%s", tmps))
			{
				num = i;
				break;
			}
	}
	else num = num - 1; /* array adjustment */
	for (i=0; i < sizeof(item); i++) i = i;
	if (num >= i) num = -1;
	return num;
}

