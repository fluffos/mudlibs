Ok next bit of source; we're trying to establish a player
run economy (and some simple ecology) on our mud. It seemed
appropriate to have player owned pubs (& breweries). Below
is some `generic' brewery and pub code (note we also have a 
full food system in which you're required to eat :-).

You also need a backroom for the pub; or some other way to 
manipulate the inventory (also need "wholesale" food containers etc.),
the appropriate code is mundane. I'd probably post it if it
wasn't such a quick hack :-).

Use it by inheriting it and defining the appropriate flags etc.

geoff
note: you must be able to save arrays.
----

/*
	 Dredd's Dreddful Food & Drink Stores;
	 (Shattered World Lpmud).

	 o Inheritable/configurable standard shop.
	 o allows player ownership ( also see pub_back.c).
	 o Either points of sale OR production point.
	--
	Problems/Ideas.
	 o how often should it save?
	 o exploitation & game balance (as always).
	--
*/

inherit "players/dredd/home";

#define PACKAGE "players/dredd/package"
#define MAXI 10
#define NO_FOOD 1
#define NO_DRINK 2
#include "wiz_dec.h"	/* dual mud hack */

array hours; 		/* hours the shop is open */
array 	item,		/* item name */
	cost, 		/* item cost */
	stock, 		/* amount of stock */
	food, 		/* food value, if it's food. */
	heal, 		/* amount player should be healed for 1 serve */
	strength,	/* alcoholic strength if it's a drink */
	mess,		/* consumption message */
	size; 		/* size of barrel for wholesale amounts */

int	accum,		/* money accumulated by owner */
  	stock_remove,	/* the level of stock to remove an item from menu */ 
	max_items,	/* maximum number of items in store */
	package,	/* The cost of packages, if 0 there are none */
	restrictions;	/* restrictions flag 0-none, 1-no_food, 2-no_drink */
			/* Believe me - I hate magic numbers! */

string type,		/* restaurant, pub, brewery, manafacturer */
       shopkeeper;	/* name of shopkeeper, defaults to 'shopkeeper' */

reset(arg)
{
	if (arg) return;
	if (!max_items) max_items = MAXI;
	if (!restore_object(file_name(this_object()))) {
		zero();
		set_up();
	}
	if (!shopkeeper) shopkeeper = "shopkeeper";
}

set_up() { }

/*
 	Set everything up to be an empty array like
	they should be anyway.
*/
zero()
{
	item = ({ });
	cost = ({ });
	stock = ({ });
	food = ({ });
	heal = ({ });
	strength = ({ });
	mess = ({ });
	size = ({ });
}

/*
	Add a new item into the shop, should fail for
	drinks/food where appropriate.
*/
add_new_item(nm, ct, sk, hl, st, fd, ms, sz)
{
int x, y;	
	if (restrictions == NO_FOOD && fd > 0) return 0;
	if (restrictions == NO_DRINK && st > 0) return 0;

	x = index(item, nm);
	if (x > -1) return;
	y = sizeof(item);

	if (y >= max_items) return;

	/* you need array addition for the below stuff */
	item += ({ nm });
	cost +=({ ct });
	stock +=({ sk });
	heal +=({ hl });
	strength +=({ st });
	food += ({ fd });
	mess +=({ ms });
	size += ({ sz });
	return 1;
}

debug(x) {
	write("item size : "+item[x]+"\n");
	write("strength  : "+strength[x]+"\n");
	write("cost  : "+(cost[x])+"\n");
	write("heal  : "+(heal[x])+"\n");
	write("food  : "+(food[x])+"\n");
	write("mess  : "+(mess[x])+"\n");
	write("stock  : "+(stock[x])+"\n");
	write("size  : "+(size[x])+"\n");
	return 1;
}

menu(flag) {
int i;
	write("\n");
	if (item)
	for(i = 0; i <  sizeof(item); i++)  {
		if (!item[i]) continue;
		write("\t"+(i+1)+") ");
		if (flag) write(stock[i] + " in stock / ");
		if (size[i]) write(size[i] + " per barrel @");
		write(" "+cost[i]+" coins\t"+item[i]+".\n");		
	}
	write("\n");
}

long() {
	if (set_light(0)) {
		write(short_desc +".\n");
		menu(0);
	}
	::long();
	/* optional - you need a real estate agent first :-) */
	if (!owner) write("A large sign reads: FOR SALE - enquiries at the real estate office.\n");
}

init() {
	::init();
	if (type == "brewery" || type == "manafacturer") {
		add_action("order", "buy");
		add_action("order", "order");
	}
	else {
		add_action("consume", "buy");
		add_action("consume", "order");
	}
}

query_accum() { return accum; }

add_accum(str) { 
int taxp;
	/* tax kludge; feel free to exterminate */
	if (str > 10) {
		taxp = str/20 + 1;
		str -= taxp;
		"room/city/treasury"->add(taxp);
	}
	accum += str;
	if (accum < 0) accum = 0;
	return accum;
}
		
/*
	Saves every tim someone leaves the store, probably too often.
*/
exit() {
	if (query_host_name() != WIZ_DEC && !random(10))
			 save_object(file_name(this_object()));
	return 1;
}


/*
	returns -1 if item doesn't exist (string comparison on name),
	otherwise returns it's index in the arrays storing item information.
*/
query_item(name) 
{
int x;
	x = index(item, name);
	return x;	
}

/*
	 adds a name with no values to the list.
 */
