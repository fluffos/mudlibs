/* All the 'n' s at the end of above are located there so that they wont give
 * names starting with Nn, but will insert extra 'n's later
 */

get_name()
{
	int	n; /* which syllable we on */
	int	letters; /* which syllable to pull */
	int	numcons; /* how many syllables */
	string	syll; /* array of syllables */
	string	name; /* final name */

	syll = syllable();
	numcons = random(3) + 2;
	while(n < numcons)
	{
		if(!n)
			letters = random(sizeof(syll) - 5);
			/* so we don't have 'n' as 1st syllable  */
		else
			letters = random(sizeof(syll)) +1;
		if(!name)
			name = syll[letters];
		else
			name += syll[letters];
		n += 1;
	}
	return name;
}
