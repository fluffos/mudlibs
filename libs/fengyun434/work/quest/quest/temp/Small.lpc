//Find the First Index to have exp level >= x
int Find(int x) {
  int total;
  int low, high, now;
  total = sizeof(quest);
  if (quest[0]["exp_bonus"] >= x)
    return 0;
  if (quest[total - 1]["exp_bonus"] < x)
    return total - 1;
  low = 0;
  high = total - 1;
  now = (low + high) / 2;
  while (high - low > 1) {
    if (quest[now]["exp_bonus"] >= x)
      high = now;
    else
      low = now;

    now = (low + high) / 2;
  }
  return high;
}

mapping query_quest(int exp) {
  int a, b;

  a = Find(exp * 8 / 10);
  b = Find(exp * 16 / 10);


  if (a == b)
    return quest[a];
  else
    return quest[a + random(b + 1 - a)];
}
