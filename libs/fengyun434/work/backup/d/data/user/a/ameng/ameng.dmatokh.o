dbase (["item_damaged":1,"wield_msg":"轻烟浮起，往事如梦幻飘过，$N伸手想去抓住什么，却发现$n早已经破空而出，闪出万道金光，令人无法睁开眼睛！","rigidity":3060,"max_enchant":7,"weight":20600,"id":"dreamblade","unwield_msg":"周围的一切趋于平静，金光也渐渐消褪，$N用力往空中一抛，$n嗖的一声消失在云际之间！","name":"[35m此情只待成追忆碎梦破恨刀[2;37;0m","ji_times":15,"base_damage":156,"weapon_prop":(["tolerance":5,"karma":4,"damage":156,"personality":2,"courage":5,"rigidity":50,"intelligence":3,]),])
weapon_actions (["砸":(["damage_type":"瘀伤","post_action":"bash_weapon","action":"$N挥舞$w，往$n的$l用力一砸",]),"抽":(["dodge":-20,"parry":30,"damage_type":"鞭伤","action":"$N将$w一扬，往$n的$l抽去",]),"射":(["damage_type":"刺伤","post_action":"throw_weapon","action":"$N将$w对准$n的$l射了过去",]),"刺":(["dodge":15,"parry":-15,"damage_type":"刺伤","action":"$N用$w往$n的$l刺去",]),"劈":(["parry":-20,"damage_type":"劈伤","action":"$N的$w朝著$n的$l劈将过去",]),"斩":(["parry":20,"damage_type":"割伤","action":"$N挥动$w，斩向$n的$l",]),"砍":(["dodge":20,"damage_type":"砍伤","action":"$N用$w往$n的$l砍去",]),])
