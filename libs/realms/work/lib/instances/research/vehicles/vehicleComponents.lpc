inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
public void BasicComponents()
{
    // Basic frames and hulls
    addResearchElement("/lib/instances/research/vehicles/components/basic-wagon-frame.lpc");
    addChild("/lib/instances/research/vehicles/components/basic-wagon-frame.lpc",
        "/lib/instances/research/vehicles/craftComponents.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/basic-hull-construction.lpc");
    addChild("/lib/instances/research/vehicles/components/basic-hull-construction.lpc",
        "/lib/instances/research/vehicles/craftComponents.lpc");

    // Basic sailmaking
    addResearchElement("/lib/instances/research/vehicles/components/basic-sailmaking.lpc");
    addChild("/lib/instances/research/vehicles/components/basic-sailmaking.lpc",
        "/lib/instances/research/vehicles/craftComponents.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void AdvancedFrames()
{
    addResearchElement("/lib/instances/research/vehicles/components/reinforced-wagon-frame.lpc");
    addChild("/lib/instances/research/vehicles/components/reinforced-wagon-frame.lpc",
        "/lib/instances/research/vehicles/components/basic-wagon-frame.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/armored-wagon-body.lpc");
    addChild("/lib/instances/research/vehicles/components/armored-wagon-body.lpc",
        "/lib/instances/research/vehicles/components/reinforced-wagon-frame.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/war-wagon-chassis.lpc");
    addChild("/lib/instances/research/vehicles/components/war-wagon-chassis.lpc",
        "/lib/instances/research/vehicles/components/armored-wagon-body.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/luxury-wagon-body.lpc");
    addChild("/lib/instances/research/vehicles/components/luxury-wagon-body.lpc",
        "/lib/instances/research/vehicles/components/basic-wagon-frame.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void AdvancedHulls()
{
    addResearchElement("/lib/instances/research/vehicles/components/reinforced-hull-construction.lpc");
    addChild("/lib/instances/research/vehicles/components/reinforced-hull-construction.lpc",
        "/lib/instances/research/vehicles/components/basic-hull-construction.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/ironclad-hull-construction.lpc");
    addChild("/lib/instances/research/vehicles/components/ironclad-hull-construction.lpc",
        "/lib/instances/research/vehicles/components/reinforced-hull-construction.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/shallow-draft-hull.lpc");
    addChild("/lib/instances/research/vehicles/components/shallow-draft-hull.lpc",
        "/lib/instances/research/vehicles/components/basic-hull-construction.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void AdvancedSails()
{
    addResearchElement("/lib/instances/research/vehicles/components/lateen-sailmaking.lpc");
    addChild("/lib/instances/research/vehicles/components/lateen-sailmaking.lpc",
        "/lib/instances/research/vehicles/components/basic-sailmaking.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/square-sailmaking.lpc");
    addChild("/lib/instances/research/vehicles/components/square-sailmaking.lpc",
        "/lib/instances/research/vehicles/components/lateen-sailmaking.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void WeaponSystems()
{
    // Basic weapon systems
    addResearchElement("/lib/instances/research/vehicles/components/harpoon-launcher.lpc");
    addChild("/lib/instances/research/vehicles/components/harpoon-launcher.lpc",
        "/lib/instances/research/vehicles/components/basic-wagon-frame.lpc");

    // Historical siege weapons - building from basic frame
    addResearchElement("/lib/instances/research/vehicles/components/springald-mount.lpc");
    addChild("/lib/instances/research/vehicles/components/springald-mount.lpc",
        "/lib/instances/research/vehicles/components/basic-wagon-frame.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/onager-mount.lpc"); 
    addChild("/lib/instances/research/vehicles/components/onager-mount.lpc",
        "/lib/instances/research/vehicles/components/springald-mount.lpc");

    // Chemical/alchemical weapons
    addResearchElement("/lib/instances/research/vehicles/components/oil-dispenser.lpc");
    addChild("/lib/instances/research/vehicles/components/oil-dispenser.lpc",
        "/lib/instances/research/vehicles/components/basic-wagon-frame.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/greek-fire-projector.lpc");
    addChild("/lib/instances/research/vehicles/components/greek-fire-projector.lpc",
        "/lib/instances/research/vehicles/components/oil-dispenser.lpc");

    // Advanced physical weapons - requiring armored construction
    addResearchElement("/lib/instances/research/vehicles/components/siege-ram.lpc");
    addChild("/lib/instances/research/vehicles/components/siege-ram.lpc",
        "/lib/instances/research/vehicles/components/armored-wagon-body.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/corvus-boarding-bridge.lpc");
    addChild("/lib/instances/research/vehicles/components/corvus-boarding-bridge.lpc",
        "/lib/instances/research/vehicles/components/armored-wagon-body.lpc");

    // Tactical weapons - building from basic systems
    addResearchElement("/lib/instances/research/vehicles/components/net-launcher.lpc");
    addChild("/lib/instances/research/vehicles/components/net-launcher.lpc",
        "/lib/instances/research/vehicles/components/harpoon-launcher.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/caltrop-dispenser.lpc");
    addChild("/lib/instances/research/vehicles/components/caltrop-dispenser.lpc",
        "/lib/instances/research/vehicles/components/basic-wagon-frame.lpc");

    // Basic arcane weapons - requiring arcane frame
    addResearchElement("/lib/instances/research/vehicles/components/magic-missile-launcher.lpc");
    addChild("/lib/instances/research/vehicles/components/magic-missile-launcher.lpc",
        "/lib/instances/research/vehicles/components/arcane-wagon-frame.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/frost-projector.lpc");
    addChild("/lib/instances/research/vehicles/components/frost-projector.lpc",
        "/lib/instances/research/vehicles/components/arcane-wagon-frame.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/acid-sprayer.lpc");
    addChild("/lib/instances/research/vehicles/components/acid-sprayer.lpc",
        "/lib/instances/research/vehicles/components/arcane-wagon-frame.lpc");

    // Advanced arcane weapons - building from basic arcane
    addResearchElement("/lib/instances/research/vehicles/components/arcane-cannon.lpc");
    addChild("/lib/instances/research/vehicles/components/arcane-cannon.lpc",
        "/lib/instances/research/vehicles/components/magic-missile-launcher.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/lightning-cannon.lpc");
    addChild("/lib/instances/research/vehicles/components/lightning-cannon.lpc",
        "/lib/instances/research/vehicles/components/arcane-cannon.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/sonic-disruptor.lpc");
    addChild("/lib/instances/research/vehicles/components/sonic-disruptor.lpc",
        "/lib/instances/research/vehicles/components/arcane-cannon.lpc");

    // High-level arcane weapons
    addResearchElement("/lib/instances/research/vehicles/components/arcane-flame-thrower.lpc");
    addChild("/lib/instances/research/vehicles/components/arcane-flame-thrower.lpc",
        "/lib/instances/research/vehicles/components/arcane-cannon.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/confusion-projector.lpc");
    addChild("/lib/instances/research/vehicles/components/confusion-projector.lpc",
        "/lib/instances/research/vehicles/components/sonic-disruptor.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/soul-reaper.lpc");
    addChild("/lib/instances/research/vehicles/components/soul-reaper.lpc",
        "/lib/instances/research/vehicles/components/lightning-cannon.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/mind-spike-launcher.lpc");
    addChild("/lib/instances/research/vehicles/components/mind-spike-launcher.lpc",
        "/lib/instances/research/vehicles/components/confusion-projector.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void MagicalComponents()
{
    addResearchElement("/lib/instances/research/vehicles/components/arcane-wagon-frame.lpc");
    addChild("/lib/instances/research/vehicles/components/arcane-wagon-frame.lpc",
        "/lib/instances/research/vehicles/components/reinforced-wagon-frame.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/arcane-hull-construction.lpc");
    addChild("/lib/instances/research/vehicles/components/arcane-hull-construction.lpc",
        "/lib/instances/research/vehicles/components/reinforced-hull-construction.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/arcane-sailmaking.lpc");
    addChild("/lib/instances/research/vehicles/components/arcane-sailmaking.lpc",
        "/lib/instances/research/vehicles/components/square-sailmaking.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/arcane-propulsion.lpc");
    addChild("/lib/instances/research/vehicles/components/arcane-propulsion.lpc",
        "/lib/instances/research/vehicles/components/arcane-hull-construction.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/arcane-warding.lpc");
    addChild("/lib/instances/research/vehicles/components/arcane-warding.lpc",
        "/lib/instances/research/vehicles/components/arcane-wagon-frame.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/arcane-cargo.lpc");
    addChild("/lib/instances/research/vehicles/components/arcane-cargo.lpc",
        "/lib/instances/research/vehicles/components/arcane-warding.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/arcane-sanctum.lpc");
    addChild("/lib/instances/research/vehicles/components/arcane-sanctum.lpc",
        "/lib/instances/research/vehicles/components/arcane-cargo.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void ExoticComponents()
{
    addResearchElement("/lib/instances/research/vehicles/components/levitation-matrix.lpc");
    addChild("/lib/instances/research/vehicles/components/levitation-matrix.lpc",
        "/lib/instances/research/vehicles/components/arcane-propulsion.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/illusion-shroud.lpc");
    addChild("/lib/instances/research/vehicles/components/illusion-shroud.lpc",
        "/lib/instances/research/vehicles/components/arcane-warding.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/teleportation-rune.lpc");
    addChild("/lib/instances/research/vehicles/components/teleportation-rune.lpc",
        "/lib/instances/research/vehicles/components/levitation-matrix.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/elemental-binding.lpc");
    addChild("/lib/instances/research/vehicles/components/elemental-binding.lpc",
        "/lib/instances/research/vehicles/components/arcane-propulsion.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/elemental-engine.lpc");
    addChild("/lib/instances/research/vehicles/components/elemental-engine.lpc",
        "/lib/instances/research/vehicles/components/elemental-binding.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/planar-rudder.lpc");
    addChild("/lib/instances/research/vehicles/components/planar-rudder.lpc",
