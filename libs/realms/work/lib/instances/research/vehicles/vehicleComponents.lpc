/////////////////////////////////////////////////////////////////////////////
public void UtilityComponents()
{
    addResearchElement("/lib/instances/research/vehicles/components/paddlewheel.lpc");
    addChild("/lib/instances/research/vehicles/components/paddlewheel.lpc",
        "/lib/instances/research/vehicles/components/basic-hull-construction.lpc");

    addResearchElement("/lib/instances/research/vehicles/components/waterwheel-mill.lpc");
    addChild("/lib/instances/research/vehicles/components/waterwheel-mill.lpc",
        "/lib/instances/research/vehicles/components/paddlewheel.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Vehicle Components");
    Description("This research tree tracks the knowledge required to craft "
        "specialized components for vehicles");
    Source("vehicles");
    addPrerequisite("carpentry", (["type": "skill", "value": 1]));
    addPrerequisite("/lib/instances/research/vehicles/craftVehicles.lpc",
        (["type": "research"]));
    addResearchElement("/lib/instances/research/vehicles/craftComponents.lpc");
    TreeRoot("/lib/instances/research/vehicles/craftComponents.lpc");

    BasicComponents();
    AdvancedFrames();
    AdvancedHulls();
    AdvancedSails();
    MagicalComponents();
    WeaponSystems();
    ExoticComponents();
    UtilityComponents();
}
