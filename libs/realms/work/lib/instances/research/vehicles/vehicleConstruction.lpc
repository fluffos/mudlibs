inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
public void BasicVehicleConstruction()
{
    // Basic wagon construction
    addResearchElement("/lib/instances/research/vehicles/wagons/basic-wagon-construction.lpc");
    addChild("/lib/instances/research/vehicles/wagons/basic-wagon-construction.lpc",
        "/lib/instances/research/vehicles/craftVehicles.lpc");

    // Basic boat construction
    addResearchElement("/lib/instances/research/vehicles/boats/basic-boatbuilding.lpc");
    addChild("/lib/instances/research/vehicles/boats/basic-boatbuilding.lpc",
        "/lib/instances/research/vehicles/craftVehicles.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void AdvancedLandVehicles()
{
    addResearchElement("/lib/instances/research/vehicles/wagons/covered-wagons.lpc");
    addChild("/lib/instances/research/vehicles/wagons/covered-wagons.lpc",
        "/lib/instances/research/vehicles/wagons/basic-wagon-construction.lpc");

    addResearchElement("/lib/instances/research/vehicles/wagons/stagecoaches.lpc");
    addChild("/lib/instances/research/vehicles/wagons/stagecoaches.lpc",
        "/lib/instances/research/vehicles/wagons/covered-wagons.lpc");

    addResearchElement("/lib/instances/research/vehicles/wagons/war-wagons.lpc");
    addChild("/lib/instances/research/vehicles/wagons/war-wagons.lpc",
        "/lib/instances/research/vehicles/wagons/covered-wagons.lpc");

    addResearchElement("/lib/instances/research/vehicles/wagons/siege-wagons.lpc");
    addChild("/lib/instances/research/vehicles/wagons/siege-wagons.lpc",
        "/lib/instances/research/vehicles/wagons/war-wagons.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void RiverVessels()
{
    addResearchElement("/lib/instances/research/vehicles/boats/river-vessels.lpc");
    addChild("/lib/instances/research/vehicles/boats/river-vessels.lpc",
        "/lib/instances/research/vehicles/boats/basic-boatbuilding.lpc");

    addResearchElement("/lib/instances/research/vehicles/ships/multi-hull-vessel.lpc");
    addChild("/lib/instances/research/vehicles/ships/multi-hull-vessel.lpc",
        "/lib/instances/research/vehicles/boats/river-vessels.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void SeaVessels()
{
    addResearchElement("/lib/instances/research/vehicles/ships/coastal-sailing-vessels.lpc");
    addChild("/lib/instances/research/vehicles/ships/coastal-sailing-vessels.lpc",
        "/lib/instances/research/vehicles/boats/river-vessels.lpc");

    addResearchElement("/lib/instances/research/vehicles/ships/longships.lpc");
    addChild("/lib/instances/research/vehicles/ships/longships.lpc",
        "/lib/instances/research/vehicles/ships/coastal-sailing-vessels.lpc");

    addResearchElement("/lib/instances/research/vehicles/ships/lateen-rigged-vessels.lpc");
    addChild("/lib/instances/research/vehicles/ships/lateen-rigged-vessels.lpc",
        "/lib/instances/research/vehicles/ships/coastal-sailing-vessels.lpc");

    addResearchElement("/lib/instances/research/vehicles/ships/large-square-rigged-vessels.lpc");
    addChild("/lib/instances/research/vehicles/ships/large-square-rigged-vessels.lpc",
        "/lib/instances/research/vehicles/ships/lateen-rigged-vessels.lpc");

    addResearchElement("/lib/instances/research/vehicles/ships/oared-warships.lpc");
    addChild("/lib/instances/research/vehicles/ships/oared-warships.lpc",
        "/lib/instances/research/vehicles/ships/longships.lpc");

    addResearchElement("/lib/instances/research/vehicles/ships/dreadnoughts.lpc");
    addChild("/lib/instances/research/vehicles/ships/dreadnoughts.lpc",
        "/lib/instances/research/vehicles/ships/large-square-rigged-vessels.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void MagicalVessels()
{
    addResearchElement("/lib/instances/research/vehicles/boats/arcane-vessels.lpc");
    addChild("/lib/instances/research/vehicles/boats/arcane-vessels.lpc",
        "/lib/instances/research/vehicles/boats/basic-boatbuilding.lpc");

    addResearchElement("/lib/instances/research/vehicles/boats/crystal-vessels.lpc");
    addChild("/lib/instances/research/vehicles/boats/crystal-vessels.lpc",
        "/lib/instances/research/vehicles/boats/arcane-vessels.lpc");

    addResearchElement("/lib/instances/research/vehicles/boats/arcane-glider.lpc");
    addChild("/lib/instances/research/vehicles/boats/arcane-glider.lpc",
        "/lib/instances/research/vehicles/boats/crystal-vessels.lpc");

    addResearchElement("/lib/instances/research/vehicles/ships/mystical-man-of-war.lpc");
    addChild("/lib/instances/research/vehicles/ships/mystical-man-of-war.lpc",
        "/lib/instances/research/vehicles/ships/large-square-rigged-vessels.lpc");

    addResearchElement("/lib/instances/research/vehicles/ships/arcane-dreadnoughts.lpc");
    addChild("/lib/instances/research/vehicles/ships/arcane-dreadnoughts.lpc",
        "/lib/instances/research/vehicles/ships/mystical-man-of-war.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Vehicle Construction");
    Description("This research tree tracks the knowledge required to construct "
        "vehicles for land and sea travel");
    Source("vehicles");
    addPrerequisite("carpentry", 
        (["type": "skill", "value" : 2]));
    addPrerequisite("/lib/instances/research/crafting/craftItems.lpc",
        (["type": "research"]));
    addResearchElement("/lib/instances/research/vehicles/craftVehicles.lpc");
    TreeRoot("/lib/instances/research/vehicles/craftVehicles.lpc");

    BasicVehicleConstruction();
    AdvancedLandVehicles();
    RiverVessels();
    SeaVessels();
    MagicalVessels();
}
