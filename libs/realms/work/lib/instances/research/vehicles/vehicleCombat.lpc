inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
public void BasicCombat()
{
    addResearchElement("/lib/instances/research/vehicles/combat/basic-vehicle-tactics.lpc");
    addChild("/lib/instances/research/vehicles/combat/basic-vehicle-tactics.lpc",
        "/lib/instances/research/vehicles/vehicleCombatBasics.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/vehicle-formations.lpc");
    addChild("/lib/instances/research/vehicles/combat/vehicle-formations.lpc",
        "/lib/instances/research/vehicles/combat/basic-vehicle-tactics.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/ramming-techniques.lpc");
    addChild("/lib/instances/research/vehicles/combat/ramming-techniques.lpc",
        "/lib/instances/research/vehicles/combat/basic-vehicle-tactics.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void NavalCombat()
{
    addResearchElement("/lib/instances/research/vehicles/combat/naval-tactics.lpc");
    addChild("/lib/instances/research/vehicles/combat/naval-tactics.lpc",
        "/lib/instances/research/vehicles/combat/vehicle-formations.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/boarding-actions.lpc");
    addChild("/lib/instances/research/vehicles/combat/boarding-actions.lpc",
        "/lib/instances/research/vehicles/combat/naval-tactics.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/ship-to-ship-combat.lpc");
    addChild("/lib/instances/research/vehicles/combat/ship-to-ship-combat.lpc",
        "/lib/instances/research/vehicles/combat/boarding-actions.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/fleet-tactics.lpc");
    addChild("/lib/instances/research/vehicles/combat/fleet-tactics.lpc",
        "/lib/instances/research/vehicles/combat/ship-to-ship-combat.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void SiegeCombat()
{
    addResearchElement("/lib/instances/research/vehicles/combat/siege-warfare.lpc");
    addChild("/lib/instances/research/vehicles/combat/siege-warfare.lpc",
        "/lib/instances/research/vehicles/combat/ramming-techniques.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/fortification-assault.lpc");
    addChild("/lib/instances/research/vehicles/combat/fortification-assault.lpc",
        "/lib/instances/research/vehicles/combat/siege-warfare.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/mobile-artillery.lpc");
    addChild("/lib/instances/research/vehicles/combat/mobile-artillery.lpc",
        "/lib/instances/research/vehicles/combat/siege-warfare.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void MagicalCombat()
{
    addResearchElement("/lib/instances/research/vehicles/combat/arcane-vehicle-combat.lpc");
    addChild("/lib/instances/research/vehicles/combat/arcane-vehicle-combat.lpc",
        "/lib/instances/research/vehicles/combat/basic-vehicle-tactics.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/mystical-defenses.lpc");
    addChild("/lib/instances/research/vehicles/combat/mystical-defenses.lpc",
        "/lib/instances/research/vehicles/combat/arcane-vehicle-combat.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/elemental-warfare.lpc");
    addChild("/lib/instances/research/vehicles/combat/elemental-warfare.lpc",
        "/lib/instances/research/vehicles/combat/mystical-defenses.lpc");

    addResearchElement("/lib/instances/research/vehicles/combat/planar-combat.lpc");
    addChild("/lib/instances/research/vehicles/combat/planar-combat.lpc",
        "/lib/instances/research/vehicles/combat/elemental-warfare.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Vehicle Combat");
    Description("This research tree tracks the knowledge required for "
        "vehicle-based combat and warfare");
    Source("vehicles");
    addPrerequisite("weapon smithing", 
        (["type": "skill", "value" : 3]));
    addPrerequisite("/lib/instances/research/vehicles/craftVehicles.lpc",
        (["type": "research"]));
    addResearchElement("/lib/instances/research/vehicles/vehicleCombatBasics.lpc");
    TreeRoot("/lib/instances/research/vehicles/vehicleCombatBasics.lpc");

    BasicCombat();
    NavalCombat();
    SiegeCombat();
    MagicalCombat();
}
