/////////////////////////////////////////////////////////////////////////////
public void CraftMaceResearch()
{
    addResearchElement("/lib/instances/research/crafting/weapons/maces/craftComplexMace.lpc");
    addChild("/lib/instances/research/crafting/weapons/maces/craftComplexMace.lpc",
        "/lib/instances/research/crafting/weapons/maces/craftBasicMace.lpc");
}

