/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Axe Forging");
    Description("This research tree tracks the knowledge required to craft hammers");
    Source("crafting");
    addPrerequisite("weapon smithing", 
        (["type": "skill", "value" : 3]));
    addPrerequisite("/lib/instances/research/crafting/weapons/craftWeapons.lpc",
        (["type": "research"]));
    addResearchElement("/lib/instances/research/crafting/weapons/hammers/craftBasicHammer.lpc");
    TreeRoot("/lib/instances/research/crafting/weapons/hammers/craftBasicHammer.lpc");

    CommonResearch();
    CraftHammerResearch();
    Techniques();
}
