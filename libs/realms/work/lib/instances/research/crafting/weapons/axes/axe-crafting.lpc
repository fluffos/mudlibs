/////////////////////////////////////////////////////////////////////////////
public void CraftAxeResearch()
{
    addResearchElement("/lib/instances/research/crafting/weapons/axes/craftDoubleAxe.lpc");
    addChild("/lib/instances/research/crafting/weapons/axes/craftDoubleAxe.lpc",
        "/lib/instances/research/crafting/weapons/axes/craftBasicAxe.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/axes/craftExoticAxe.lpc");
    addChild("/lib/instances/research/crafting/weapons/axes/craftExoticAxe.lpc",
        "/lib/instances/research/crafting/weapons/axes/craftBasicAxe.lpc");
}

