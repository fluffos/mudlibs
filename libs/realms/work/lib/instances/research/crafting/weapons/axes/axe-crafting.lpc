/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Axe Forging");
    Description("This research tree tracks the knowledge required to craft axes");
    Source("crafting");
    addPrerequisite("weapon smithing", 
        (["type": "skill", "value" : 3]));
    addPrerequisite("/lib/instances/research/crafting/weapons/craftWeapons.lpc",
        (["type": "research"]));
    addResearchElement("/lib/instances/research/crafting/weapons/axes/craftBasicAxe.lpc");
    TreeRoot("/lib/instances/research/crafting/weapons/axes/craftBasicAxe.lpc");

    CommonResearch();
    CraftAxeResearch();
    Techniques();
}
