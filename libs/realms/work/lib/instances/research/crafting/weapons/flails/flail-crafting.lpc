/////////////////////////////////////////////////////////////////////////////
public void CraftFlailResearch()
{
    addResearchElement("/lib/instances/research/crafting/weapons/flails/craftComplexFlail.lpc");
    addChild("/lib/instances/research/crafting/weapons/flails/craftComplexFlail.lpc",
        "/lib/instances/research/crafting/weapons/flails/craftBasicFlail.lpc");
}

