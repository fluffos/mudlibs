    addResearchElement("/lib/instances/research/crafting/weapons/common/stepped-quenching.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/stepped-quenching.lpc",
        "/lib/instances/research/crafting/weapons/common/quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/case-hardening.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/case-hardening.lpc",
        "/lib/instances/research/crafting/weapons/common/quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/differential-hardening.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/differential-hardening.lpc",
        "/lib/instances/research/crafting/weapons/common/stepped-tempering.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/folding.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/folding.lpc",
        "/lib/instances/research/crafting/weapons/common/annealing.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/pattern-welding.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/pattern-welding.lpc",
        "/lib/instances/research/crafting/weapons/common/folding.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/wrapping.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/wrapping.lpc",
        "/lib/instances/research/crafting/weapons/common/folding.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/forge-welding.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/forge-welding.lpc",
        "/lib/instances/research/crafting/weapons/common/annealing.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/mystic-folding.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/mystic-folding.lpc",
        "/lib/instances/research/crafting/weapons/common/folding.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/mystic-quenching.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/mystic-quenching.lpc",
        "/lib/instances/research/crafting/weapons/common/quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/mystic-wrapping.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/mystic-wrapping.lpc",
