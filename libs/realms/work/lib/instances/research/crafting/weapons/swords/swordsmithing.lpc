    addResearchElement("/lib/instances/research/crafting/weapons/common/wrapping.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/wrapping.lpc",
        "/lib/instances/research/crafting/weapons/common/folding.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/forge-welding.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/forge-welding.lpc",
        "/lib/instances/research/crafting/weapons/common/annealing.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/mystic-folding.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/mystic-folding.lpc",
        "/lib/instances/research/crafting/weapons/common/folding.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/mystic-quenching.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/mystic-quenching.lpc",
        "/lib/instances/research/crafting/weapons/common/quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/mystic-wrapping.lpc");
