    addResearchElement("/lib/instances/research/crafting/weapons/common/slack-quenching.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/slack-quenching.lpc",
        "/lib/instances/research/crafting/weapons/common/annealing.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/quenching.lpc");
    addChild("/lib/instances/research/crafting/weapons/common/quenching.lpc",
        "/lib/instances/research/crafting/weapons/common/slack-quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/weapons/common/tempering.lpc");
