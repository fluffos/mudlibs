/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Chainmail Crafting");
    Description("This research tree tracks the knowledge required to craft "
        "chainmail");
    Source("crafting");
    addPrerequisite("weapon smithing", 
        (["type": "skill", "value" : 3]));
    addPrerequisite("/lib/instances/research/crafting/armor/craftArmor.lpc",
        (["type": "research"]));

    addResearchElement("/lib/instances/research/crafting/armor/chainmail/craftChainmail.lpc");
    TreeRoot("/lib/instances/research/crafting/armor/chainmail/craftChainmail.lpc");

    CommonResearch();
    Techniques();
}
