/////////////////////////////////////////////////////////////////////////////
public void CraftHeavyArmorResearch()
{
    addResearchElement("/lib/instances/research/crafting/armor/heavy-armor/craftPlateArmor.lpc");
    addChild("/lib/instances/research/crafting/armor/heavy-armor/craftPlateArmor.lpc",
    "/lib/instances/research/crafting/armor/heavy-armor/craftHeavyArmor.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/heavy-armor/craftScaleArmor.lpc");
    addChild("/lib/instances/research/crafting/armor/heavy-armor/craftScaleArmor.lpc",
    "/lib/instances/research/crafting/armor/heavy-armor/craftHeavyArmor.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/heavy-armor/craftSplintArmor.lpc");
    addChild("/lib/instances/research/crafting/armor/heavy-armor/craftSplintArmor.lpc",
    "/lib/instances/research/crafting/armor/heavy-armor/craftHeavyArmor.lpc");
}

