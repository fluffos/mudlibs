    addResearchElement("/lib/instances/research/crafting/armor/common/austempering.lpc");
    addChild("/lib/instances/research/crafting/armor/common/austempering.lpc",
    "/lib/instances/research/crafting/armor/common/quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/stepped-quenching.lpc");
    addChild("/lib/instances/research/crafting/armor/common/stepped-quenching.lpc",
    "/lib/instances/research/crafting/armor/common/quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/case-hardening.lpc");
    addChild("/lib/instances/research/crafting/armor/common/case-hardening.lpc",
    "/lib/instances/research/crafting/armor/common/quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/differential-hardening.lpc");
