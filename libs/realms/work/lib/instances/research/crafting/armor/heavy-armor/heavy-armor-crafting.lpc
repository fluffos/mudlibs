    addResearchElement("/lib/instances/research/crafting/armor/common/wrapping.lpc");
    addChild("/lib/instances/research/crafting/armor/common/wrapping.lpc",
    "/lib/instances/research/crafting/armor/common/folding.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/forge-welding.lpc");
    addChild("/lib/instances/research/crafting/armor/common/forge-welding.lpc",
    "/lib/instances/research/crafting/armor/common/annealing.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/mystic-folding.lpc");
    addChild("/lib/instances/research/crafting/armor/common/mystic-folding.lpc",
    "/lib/instances/research/crafting/armor/common/folding.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/mystic-quenching.lpc");
    addChild("/lib/instances/research/crafting/armor/common/mystic-quenching.lpc",
    "/lib/instances/research/crafting/armor/common/quenching.lpc");

