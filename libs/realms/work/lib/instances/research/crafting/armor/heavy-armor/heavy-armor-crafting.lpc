inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
public void CommonResearch()
{
    addResearchElement("/lib/instances/research/crafting/armor/common/annealing.lpc");
    addChild("/lib/instances/research/crafting/armor/common/annealing.lpc",
    "/lib/instances/research/crafting/armor/heavy-armor/craftHeavyArmor.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/slack-quenching.lpc");
    addChild("/lib/instances/research/crafting/armor/common/slack-quenching.lpc",
    "/lib/instances/research/crafting/armor/common/annealing.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/quenching.lpc");
    addChild("/lib/instances/research/crafting/armor/common/quenching.lpc",
    "/lib/instances/research/crafting/armor/common/slack-quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/tempering.lpc");
    addChild("/lib/instances/research/crafting/armor/common/tempering.lpc",
    "/lib/instances/research/crafting/armor/common/quenching.lpc");

    addResearchElement("/lib/instances/research/crafting/armor/common/stepped-tempering.lpc");
