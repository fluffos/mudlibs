/////////////////////////////////////////////////////////////////////////////
public string *getTypes(string type, object user)
{
    string *types = ({ type });
    if ((type == "metal") && user->isResearched("/lib/instances/research/crafting/materials/useCrystalsAsMetal.lpc"))
    {
        types += ({ "crystal" });
    }
    else if (type == "stone")
    {
        if (user->isResearched("/lib/instances/research/crafting/materials/useCrystalsAsStone.lpc"))
        {
            types += ({ "crystal" });
        }

        if (user->isResearched("/lib/instances/research/crafting/materials/useClaysAsStone.lpc"))
        {
            types += ({ "clay" });
        }
    }

    return types;
}

/////////////////////////////////////////////////////////////////////////////
public nomask mapping getMaterialData(string materialName)
{
    if (isValidMaterial(materialName))
    {
        return materials[materialName] + ([]);
    }
    return ([]);
}
