protected int MaxX = 25;
protected int MaxY = 10;
protected int roomCount = 0;

protected string RegionName = 0;
protected string RegionType = 0;
protected string EnterFrom = 0;
protected string EntryPoint = 0;
protected int RegionLevel = 0;

protected mapping grid = ([ ]);
protected mapping *rooms = ({ });
protected mapping *decorators = ({ });
protected int *entry = ({ });

protected string *availableDirections = ({ "north", "south", "east", "west" });
protected mapping oppositeDirection = ([
    "north": "south",
    "south": "north",
    "west": "east",
    "east": "west",
    "northwest": "southeast",
    "northeast": "southwest",
    "southeast": "northwest",
    "southwest": "northeast"
]);

protected object RegionService = getService("region");

// FluffOS PORT NOTE: every `nomask` function in this file downgraded to
// plain -- same diamond-inheritance class of bug as the
// /lib/environment/modules/environment/ directory's own sweep (see that
// directory's core.lpc port note for the full root-cause writeup).
// /lib/environment/region.lpc (and generate-region.lpc, which it also
// combines) inherits this file both directly and indirectly (via
// generate-region.lpc/generate-room.lpc, which each also inherit it
// directly), reaching these nomask functions at multiple simultaneous
// depths -- confirmed live via the character-creation wizard's
// minimapSelector step, which triggers real region-generation code as
// part of the starting room's own map decoration. No overrides of any of
// these five names exist anywhere else in this codebase, so losing
// `nomask`'s override-protection costs nothing in practice.
/////////////////////////////////////////////////////////////////////////////
protected varargs string getDirectionOfEntry(string enterFrom)
{
    string exitTo = 0;
    if (sizeof(entry))
    {
        if (entry[0] == 0)
        {
            exitTo = "east";
        }
        else if (entry[0] == (MaxX - 1))
        {
            exitTo = "west";
        }
        else if (entry[1] == 0)
        {
            exitTo = "north";
        }
        else if (entry[1] == (MaxY - 1))
        {
            exitTo = "south";
        }

        if (enterFrom)
        {
            exitTo = oppositeDirection[enterFrom];
        }
    }
    return exitTo;
}

/////////////////////////////////////////////////////////////////////////////
public string getEnterFromDirection(string direction)
{
    string ret = 0;
    if (member(oppositeDirection, direction))
    {
        ret = oppositeDirection[direction];
    }
    else
    {
        raise_error("The specified direction must be one of: north, south "
            "east, or west.\n");
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
public string getEntryCoordinates()
{
    string ret = 0;
    if (sizeof(entry))
    {
        ret = sprintf("%dx%d", entry[0], entry[1]);
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
public string regionIdentifier()
{
    return regreplace(sprintf("%s-%s", RegionName, 
        EntryPoint ? EntryPoint : getEntryCoordinates()), 
        "[^A-Za-z0-9-_]", "-", 1);
}

/////////////////////////////////////////////////////////////////////////////
public mapping coordinateToMapping(int x, int y)
{
    mapping ret = 0;
    
    if ((x >= 0) && (y >= 0) && (x < MaxX) && (y < MaxY) &&
        (sizeof(grid) > x) && (sizeof(grid[x]) > y))
    {
        ret = grid[x][y];
    }
    
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
public int *getEntry()
{
    return entry + ({});
}
