inherit "/lib/environment/modules/environment/core.lpc";
inherit "/lib/environment/modules/environment/elements.lpc";
inherit "/lib/environment/modules/environment/exits.lpc";
inherit "/lib/environment/modules/environment/state.lpc";
// FluffOS PORT NOTE: every `nomask` function in this file downgraded to
// plain -- part of a lib-wide sweep of this same diamond-inheritance
// class of bug (see this directory's core.lpc/state.lpc/region.lpc port
// notes for the full root-cause writeup). /lib/environment/environment.lpc
// (the base class for every room in the game) inherits essentially all of
// this directory's modules directly, and several of them ALSO inherit
// each other -- reaching many of these nomask functions at multiple
// simultaneous depths, which broke room compilation lib-wide ("Illegal to
// redefine 'nomask' function ..."), confirmed live via the
// character-creation wizard's minimapSelector step trying to load the
// starting room. No overrides of any of these names exist anywhere else
// in this ~2,500+-file area corpus, so losing `nomask`'s
// override-protection costs nothing in practice.

private int SettlementChance = -1;

/////////////////////////////////////////////////////////////////////////////
public string identifiedBy()
{
    return uniqueIdentifier ? uniqueIdentifier :
        sprintf("%s-%s", object_name(this_object()), currentState());
}

/////////////////////////////////////////////////////////////////////////////
public void setGeneratedSettlementChance(int chance)
{
    SettlementChance = chance;
}

/////////////////////////////////////////////////////////////////////////////
protected varargs void addGeneratedExit(string direction, string location, 
    object region, string state)
{
    if (!state)
    {
        state = "default";
    }
    if (!stringp(direction) || !stringp(location) || !objectp(region))
    {
        raise_error(sprintf("ERROR in environment.c: '%s' must be a string, "
            "'%s' must be a valid destination, and '%s' must be a valid "
            "object.\n", to_string(direction), to_string(location),
            object_name(region)));
    }
    if (!member(exits, state))
    {
        exits[state] = ([]);
    }

    exits[state][direction] = ([
        "destination": location,
        "region": region
    ]);
}

/////////////////////////////////////////////////////////////////////////////
protected varargs void addGeneratedExitWithDoor(string direction, 
    string location, object region, string door, string key, string state)
{
    if (!state)
    {
        state = "default";
    }

    addGeneratedExit(direction, location, region, state);
    addDoor(direction, location, door, key, state);
}

/////////////////////////////////////////////////////////////////////////////
protected varargs void addGeneratedBuilding(string feature, mixed location,
    string path, object region, string door, string key, string state)
{
    if (addEnvironmentalElement(feature, "building", location) && 
        stringp(location))
    {
        if (stringp(path))
        {
            addGeneratedExitWithDoor(location, path, region, door, key, state);
        }
    }
    else
    {
        raise_error(sprintf("ERROR in environment.c: '%s' is not a "
            "valid building with a valid location.\n", feature));
    }
}

/////////////////////////////////////////////////////////////////////////////
public varargs object addGeneratedRegion(string direction, string type,
    int x, int y, int *entryCoordinate, string name, string state)
{
    object ret = 0;
    if (!member(environmentalElements["regions"], direction))
    {
        ret = clone_object("/lib/environment/region.lpc");

        if (SettlementChance >= 0)
        {
            ret->setSettlementChance(SettlementChance);
        }

        if (x && y)
        {
            ret->setDimensions(x, y);
        }

        ret->setRegionName(name ? name : 
            sprintf("%s-%s", identifiedBy(), direction));

        ret->setRegionType(type);

        ret->createRegion(ret->getEnterFromDirection(direction),
            regreplace(object_name(this_object()), "([^#]+)#*.*", "/\\1.lpc", 1),
            entryCoordinate);

        addGeneratedExit(direction, ret->getEntryCoordinates(), ret, state);

        environmentalElements["regions"][direction] = ret;
    }
    return ret;
}
