inherit "/lib/environment/modules/environment/core.lpc";

private object Region = 0;
private int xCoordinate = 0;
private int yCoordinate = 0;

// FluffOS PORT NOTE: every `nomask` function in this file downgraded to
// plain -- same diamond-inheritance fix as this directory's own
// core.lpc/state.lpc (see their port notes). Confirmed live:
// description.lpc inherits this file (region.lpc) both directly and
// indirectly (via environmentSnapshot.lpc, which also inherits it),
// reaching these nomask functions at two depths -- "Illegal to redefine
// 'nomask' function ...", no compiled program, breaking every room that
// combines exits+description (i.e. effectively every room in the game).
// No overrides of any of these six names exist anywhere else in this
// ~2,500+-file area corpus, so losing `nomask`'s override-protection
// costs nothing in practice.
/////////////////////////////////////////////////////////////////////////////
public object getRegion()
{
    return Region;
}

/////////////////////////////////////////////////////////////////////////////
public void setRegion(object region)
{
    Region = region;
}

/////////////////////////////////////////////////////////////////////////////
public void setCoordinates(object region, int x, int y)
{
    if (objectp(region) && 
        (member(inherit_list(region), "/lib/environment/region.lpc") > -1 ||
        member(inherit_list(region), "/lib/environment/walkableRegion.lpc") > -1))
    {
        setRegion(region);
        xCoordinate = x;
        yCoordinate = y;
    }
    else
    {
        raise_error("ERROR in environment.c: You must specify a valid region "
            "when setting coordinates.\n");
    }
}

/////////////////////////////////////////////////////////////////////////////
public string getCoordinates()
{
    return sprintf("%dx%d", xCoordinate, yCoordinate);
}

/////////////////////////////////////////////////////////////////////////////
protected int xCoordinate()
{
    return xCoordinate;
}

/////////////////////////////////////////////////////////////////////////////
protected int yCoordinate()
{
    return yCoordinate;
}
