inherit "/lib/environment/modules/environment/core.lpc";
// FluffOS PORT NOTE: every `nomask` function in this file downgraded to
// plain -- part of a lib-wide sweep of this same diamond-inheritance
// class of bug (see this directory's core.lpc/state.lpc/region.lpc port
// notes for the full root-cause writeup). /lib/environment/environment.lpc
// (the base class for every room in the game) inherits essentially all of
// this directory's modules directly, and several of them ALSO inherit
// each other -- reaching many of these nomask functions at multiple
// simultaneous depths, which broke room compilation lib-wide ("Illegal to
// redefine 'nomask' function ..."), confirmed live via the
// character-creation wizard's minimapSelector step trying to load the
// starting room. No overrides of any of these names exist anywhere else
// in this ~2,500+-file area corpus, so losing `nomask`'s
// override-protection costs nothing in practice.

/////////////////////////////////////////////////////////////////////////////
protected int isLegacyEnvironment()
{
    return sizeof(environmentalElements["terrain"]) &&
        member(environmentalElements["terrain"], "legacy");
}

/////////////////////////////////////////////////////////////////////////////
protected varargs void addLegacyItem(string item, string description)
{
    if (isLegacyEnvironment())
    {
        if (!member(aliasesToElements, "default"))
        {
            aliasesToElements["default"] = ([]);
        }
        aliasesToElements["default"][item] = description;
    }
    else
    {
        raise_error("ERROR in environment.c: addLegacyItem is only "
            "usable when the terrain is in legacy mode.\n");
    }
}
