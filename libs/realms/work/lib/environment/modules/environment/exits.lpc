inherit "/lib/environment/modules/environment/core.lpc";
inherit "/lib/environment/modules/environment/elements.lpc";
inherit "/lib/environment/modules/environment/state.lpc";
// FluffOS PORT NOTE: every `nomask` function in this file downgraded to
// plain -- part of a lib-wide sweep of this same diamond-inheritance
// class of bug (see this directory's core.lpc/state.lpc/region.lpc port
// notes for the full root-cause writeup). /lib/environment/environment.lpc
// (the base class for every room in the game) inherits essentially all of
// this directory's modules directly, and several of them ALSO inherit
// each other -- reaching many of these nomask functions at multiple
// simultaneous depths, which broke room compilation lib-wide ("Illegal to
// redefine 'nomask' function ..."), confirmed live via the
// character-creation wizard's minimapSelector step trying to load the
// starting room. No overrides of any of these names exist anywhere else
// in this ~2,500+-file area corpus, so losing `nomask`'s
// override-protection costs nothing in practice.

/////////////////////////////////////////////////////////////////////////////
public varargs mapping getExitDirections()
{
    return exits + ([]);
}

/////////////////////////////////////////////////////////////////////////////
public string *exits()
{
    string *exitList = ({});

    if (member(exits, currentState()))
    {
        exitList += keys(exits[currentState()]);
    }
    if (member(exits, "default"))
    {
        exitList += keys(exits["default"]);
    }
    exitList = sort_array(keys(mkmapping(exitList)), (: $1 > $2 :));

    return exitList;
}

/////////////////////////////////////////////////////////////////////////////
protected varargs void addExit(string direction, string path, string state)
{
    if (!state)
    {
        state = "default";
    }
    if (!stringp(direction) || !stringp(path))
    {
        raise_error(sprintf("ERROR in environment.c: '%s' must be a string and "
            "'%s' must be a valid destination file.\n", to_string(direction),
            to_string(path)));
    }
    if (!member(exits, state))
    {
        exits[state] = ([]);
    }
    exits[state][direction] = path;
}

/////////////////////////////////////////////////////////////////////////////
protected void addDoor(string direction, string path, string door, 
    string key, string state)
{
    if (!stringp(door))
    {
        door = "/lib/environment/doors/door.lpc";
    }

    object doorObj = getService("environment")->getDoor(door);
    if (doorObj)
    {
        if (!member(environmentalElements["doors"], state))
        {
            environmentalElements["doors"][state] = ([]);
        }
        environmentalElements["doors"][state][path] = doorObj;
        if (getService("environment")->isValidKey(key))
        {
            doorObj->setKey(key);
        }

        if (!addEnvironmentalElement(door, "door", direction))
        {
            raise_error(sprintf("ERROR in environment.c: '%s' is not a "
                "valid door.\n", door));
        }
    }
}

/////////////////////////////////////////////////////////////////////////////
protected varargs void addExitWithDoor(string direction, string path, 
    string door, string key, string state)
{
    if (!state)
    {
        state = "default";
    }

    addExit(direction, path, state);
    addDoor(direction, path, door, key, state);
}

/////////////////////////////////////////////////////////////////////////////
protected varargs void addBuilding(string feature, mixed location, 
    string path, string state)
{
    if (addEnvironmentalElement(feature, "building", location) && stringp(location))
    {
        if (stringp(path))
        {
            addExit(location, path, state);
        }
    }
    else
    {
        raise_error(sprintf("ERROR in environment.c: '%s' is not a "
            "valid building with a valid location.\n", feature));
    }
}

/////////////////////////////////////////////////////////////////////////////
protected varargs void addBuildingWithDoor(string feature, mixed location,
    string path, string door, string key, string state)
{
    addBuilding(feature, location, path, state);
    addExitWithDoor(location, path, door, key, state);
}
