protected mapping environmentalElements = ([
    "terrain":([]),
    "interior": ([]),
    "feature": ([]),
    "building": ([]),
    "item": ([]),
    "door": ([]),
    "objects": ([]),
    "persistent objects": ([]),
    "shop": 0,
    "cloned": 0,
    "description": ([]),
    "location text": ({ " is " }),
    "doors": ([]),
    "regions": ([])
]);

protected mapping aliasesToElements = ([]);
protected mapping exits = ([]);
protected mapping instances = ([]);

protected string uniqueIdentifier = 0;

// FluffOS PORT NOTE: resetEnvironmentData()/capitalizeSentences()/
// setIdentifier() downgraded from `nomask` to plain `protected` -- same
// diamond-inheritance fix as lib/core/thing.lpc's move_object()/command()/
// isIlluminated() (see that file's own port note for the full
// explanation). Confirmed live: /lib/environment/modules/environment/
// bonuses.lpc inherits this file (core.lpc) directly AND indirectly
// through state.lpc (which also inherits core.lpc), reaching these three
// nomask functions at two different depths simultaneously -- this
// driver's diamond-inheritance restriction ("Illegal to redefine 'nomask'
// function ...") gave bonuses.lpc no compiled program at all, which broke
// every room load that reaches it (confirmed live via minimapSelector.lpc's
// setUpUserForSelection() -- one of the 11 character-creation wizard
// steps -- calling load_object() on the starting-location room chain).
// None of the ~2,500+ area files that inherit this class override any of
// these three names, so losing `nomask`'s override-protection costs
// nothing in practice.
/////////////////////////////////////////////////////////////////////////////
protected void resetEnvironmentData()
{
    environmentalElements = ([
        "terrain":([]),
        "interior" : ([]),
        "feature" : ([]),
        "building" : ([]),
        "item" : ([]),
        "door": ([]),
        "objects" : ([]),
        "persistent objects" : ([]),
        "shop" : 0,
        "cloned" : 0,
        "description" : ([]),
        "location text" : ({ " is " }),
        "doors" : ([])
    ]);
    aliasesToElements = ([]);
    exits = ([]);
    instances = ([]);
}

/////////////////////////////////////////////////////////////////////////////
protected string capitalizeSentences(string message)
{
    string ret = regreplace(message, "^[a-z]", (: upper_case :), 1);
        ret = regreplace(ret, "[.!?] +[a-z]", (: upper_case :), 1);
            ret = regreplace(ret, "  ", " ");
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
protected void setIdentifier(string newIdentifier)
{
    uniqueIdentifier = newIdentifier;
}
