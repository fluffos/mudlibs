protected mapping descriptionData = ([ ]);
protected string elementName = 0;
protected string displayName = 0;
protected string State = "default";
protected int suppressAction = 0;

/////////////////////////////////////////////////////////////////////////////
// FluffOS PORT NOTE: every `nomask` function in this file downgraded to
// plain -- same diamond-inheritance class of bug as the sibling
// /lib/environment/modules/environment/ directory's own sweep (see that
// directory's core.lpc port note for the full root-cause writeup).
// /lib/environment/environmentalElement.lpc (the base class for
// clonable/placeable room decorations -- furniture, features, etc.)
// inherits this file directly AND indirectly (via bonuses.lpc/
// harvest.lpc/lighting.lpc, which each also inherit it directly),
// reaching these nomask functions at multiple simultaneous depths.
// Confirmed live via the starting room's own environmental elements.
// No overrides of any of these names exist anywhere else relevant to
// this class hierarchy (a `parseTemplate` name collision exists in
// several completely unrelated classes -- item.lpc, baseCommand.lpc,
// etc. -- none of which inherit this file, so no actual conflict).
public varargs string currentState(string newState)
{
    if (newState && stringp(newState))
    {
        State = newState;
    }
    return State;
}

/////////////////////////////////////////////////////////////////////////////
protected string setupDescriptionForState(string state)
{
    if (!state)
    {
        state = "default";
    }

    if (!member(descriptionData, state))
    {
        descriptionData[state] = ([]);
    }
    return state;
}

/////////////////////////////////////////////////////////////////////////////
public string *states()
{
    return keys(descriptionData) + ({});
}

/////////////////////////////////////////////////////////////////////////////
private string parseSeasonDescription(string message, mapping data,
    int illuminationLevel)
{
    string ret = message;
    string season = getService("environment")->season();
    if (member(data, season) && (illuminationLevel >= 7))
    {
        ret += data[season][random(sizeof(data[season]))];
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
private string parseTimeOfDayDetails(string message, mapping data)
{
    string ret = message;
    string season = getService("environment")->season();
    string timeOfDay = getService("environment")->timeOfDay();
    if (member(data, timeOfDay) && member(data[timeOfDay], season))
    {
        ret += data[timeOfDay][season][random(sizeof(data[timeOfDay][season]))];
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
private string parseWeatherDetails(string message, mapping data,
    int illuminationLevel)
{
    return message;
}

/////////////////////////////////////////////////////////////////////////////
protected void suppressEntryMessage()
{
    suppressAction = 1;
}

/////////////////////////////////////////////////////////////////////////////
public int displayActionText()
{
    return !suppressAction;
}

/////////////////////////////////////////////////////////////////////////////
private string parseEntryAction(string message, mapping data)
{
    return !displayActionText() ? message : getService("environment")->getEntryMessage() + " " +
        message + ".";
}

/////////////////////////////////////////////////////////////////////////////
private string parseAdjectives(string message, mapping data, 
    int illuminationLevel)
{
    string ret = message;

    if (member(data, "adjectives") && sizeof(data["adjectives"]) &&
        sizeof(regexp(({ message}), "##Adjective##")))
    {
        ret = regreplace(ret, "##Adjective##( *)", 
            (illuminationLevel > 5) ?
            data["adjectives"][random(sizeof(data["adjectives"]))] + "\\1" : "", 1);

        ret = regreplace(ret, "(^| +)(a|A) +([aeiouAEIOU][a-zA-Z]*)", "\\1\\2n \\3", 1);
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
protected int displayWeatherDetails()
{
    return 0;
}

/////////////////////////////////////////////////////////////////////////////
protected int displayEntryMessage()
{
    return 0;
}

/////////////////////////////////////////////////////////////////////////////
protected string getDescriptionFromSet()
{
    return (member(descriptionData[State], "active light template") ?
        descriptionData[State]["active light template"] : "");
}

/////////////////////////////////////////////////////////////////////////////
protected varargs string parseTemplate(string template, mapping data,
    int illuminationLevel)
{
    string ret = parseSeasonDescription(template, data, illuminationLevel);
    ret = parseTimeOfDayDetails(ret, data);

    if (displayWeatherDetails())
    {
        ret = parseWeatherDetails(ret, data, illuminationLevel);
    }
    if (displayEntryMessage())
    {
        ret = parseEntryAction(ret, data);
    }

    if (sizeof(regexp(({ template }), "##UseDescriptionSet##")))
    {
        ret = regreplace(ret, "##UseDescriptionSet##", 
            getDescriptionFromSet(), 1);
    }

    ret = parseAdjectives(ret, data, illuminationLevel);
    return ret;
}
