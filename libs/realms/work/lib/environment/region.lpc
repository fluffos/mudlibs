inherit "/lib/environment/modules/regions/core.lpc";
inherit "/lib/environment/modules/regions/domain.lpc";
inherit "/lib/environment/modules/regions/generate-region.lpc";
inherit "/lib/environment/modules/regions/persist-region.lpc";
inherit "/lib/environment/modules/regions/map.lpc";

private int setupCompleted = 0;
private int manualRegion = 0;

// FluffOS PORT NOTE: this driver gives each independent `inherit` of the
// same base program its OWN separate copy of that program's instance
// variables rather than sharing one (confirmed against
// compiler/internal/compiler.cc's define_variable(): a name collision
// from a second inherit path is handled by silently allocating a NEW
// variable slot and repointing the symbol table at it -- "the nasty
// idiots have two variables of the same name in the same object" is the
// driver's own comment -- not by reusing the first slot). This file
// inherits /lib/environment/modules/regions/core.lpc (which declares
// `grid`) both directly AND indirectly through generate-region.lpc,
// persist-region.lpc, and map.lpc (each of which also inherits core.lpc
// directly) -- a real diamond, now legal here since core.lpc's functions
// were already de-nomasked (see core.lpc's own port note), but the
// `grid` variable itself still silently fragments into a separate
// physical slot per file that inherits core.lpc, one of which is
// whatever slot THIS file's own setCoordinate()/create() below end up
// bound to. generate-region.lpc's own createEmptyGrid() (called from
// setCoordinate() below) initializes a DIFFERENT slot -- confirmed live:
// "Value being indexed is zero" at `grid[x][y] = (...)` on the very
// first setCoordinate() call in any hand-authored region.lpc-based area
// (e.g. /areas/eledhel/southern-city/southern-city.lpc, this lib's own
// StartLocation() chain) even though createEmptyGrid() had already run
// moments earlier and reported no error. Overriding createEmptyGrid()
// here (identical body to generate-region.lpc's) guarantees it's
// compiled in the same file as -- and therefore shares the same `grid`
// slot as -- setCoordinate()/create() below, which is what actually
// fixes it (LPC function dispatch is virtual, so this override also
// correctly takes over generate-region.lpc's own internal calls to
// createEmptyGrid() during procedural generation). A full fix for the
// underlying variable-fragmentation class of bug would need the same
// "shared object instead of shared inherit" restructuring already used
// elsewhere in this port for an analogous problem (see NOTES.md section
// 2's dataServiceUtil.lpc writeup) applied across this whole ~20-file
// regions/ directory -- flagged as a residual gap, not attempted here.
protected void createEmptyGrid(int x, int y)
{
    for (int i = 0; i < x; i++)
    {
        grid[i] = ([]);
        for (int j = 0; j < y; j++)
        {
            grid[i][j] = ([
                "x": i,
                "y": j,
                "room type": "none",
                "is placed": 0,
                "exits": ([]),
                "environment": 0
            ]);
        }
    }
}

/////////////////////////////////////////////////////////////////////////////
public nomask void asManualRegion()
{
    manualRegion = 1;
}

/////////////////////////////////////////////////////////////////////////////
public nomask void setDimensions(int x, int y)
{
    if ((x > 25) || (y > 25))
    {
        raise_error("Region: The largest area that can be generated is 25x25.\n");
    }
    else if (!manualRegion && ((x < 5) || (y < 5)))
    {
        raise_error("Region: The smallest area that can be generated is 5x5.\n");
    }
    else
    {
        MaxX = x;
        MaxY = y;
        roomCount = 0;
    }
}

/////////////////////////////////////////////////////////////////////////////
public string regionName()
{
    return RegionName;
}

/////////////////////////////////////////////////////////////////////////////
public nomask string regionType()
{
    return RegionType;
}

/////////////////////////////////////////////////////////////////////////////
public nomask int regionLevel()
{
    return RegionLevel;
}

/////////////////////////////////////////////////////////////////////////////
public nomask void setRegionName(string name)
{
    RegionName = name;
}

/////////////////////////////////////////////////////////////////////////////
public nomask void setRegionType(string type)
{
    if (RegionService->isValidRegionType(type))
    {
        RegionType = type;
    }
    else
    {
        raise_error("ERROR - region: The region must be a valid type as defined in "
            "/lib/services/regions/region-types.h\n");
    }
}

/////////////////////////////////////////////////////////////////////////////
public nomask void setRegionLevel(int level)
{
    if (level > 0)
    {
        RegionLevel = level;
    }
    else
    {
        raise_error("ERROR - region: The region must be an integer greater "
            "than 1.\n");
    }
}

/////////////////////////////////////////////////////////////////////////////
public nomask object getEnvironment(string location)
{
    int x = to_int(regreplace(location, "([0-9]+)x[0-9]+,*.*", "\\1", 1));
    int y = to_int(regreplace(location, "[0-9]+x([0-9]+),*.*", "\\1", 1));
    object ret = 0;

    // Check bounds, grid validity, and room existence
    if ((x >= 0 && y >= 0 && x < MaxX && y < MaxY) &&
        (sizeof(grid) > x && sizeof(grid[x]) > y) &&
        mapp(grid[x][y]))
    {
        if (!objectp(grid[x][y]["environment"]))
        {
            generateRoomDetails(grid[x][y]);
        }
        ret = grid[x][y]["environment"];
    }

    return ret;
}


/////////////////////////////////////////////////////////////////////////////
public int xDimension()
{
    return MaxX;
}

/////////////////////////////////////////////////////////////////////////////
public int yDimension()
{
    return MaxY;
}

/////////////////////////////////////////////////////////////////////////////
public string entryPoint()
{
    return EntryPoint;
}

/////////////////////////////////////////////////////////////////////////////
public string entryDirection()
{
    return EnterFrom;
}

/////////////////////////////////////////////////////////////////////////////
public mapping *rooms()
{
    mapping *ret = rooms + ({});

    return ret;
}

/////////////////////////////////////////////////////////////////////////////
public mapping *decorators()
{
    mapping *ret = decorators + ({});

    return ret;
}

/////////////////////////////////////////////////////////////////////////////
public void setEntryExit(string entryPoint, object region, string state)
{
    if (sizeof(entry))
    {
        grid[entry[0]][entry[1]]["environment"]->updateEntryPoint(
            EnterFrom, entryPoint, region, state);
    }
}

/////////////////////////////////////////////////////////////////////////////
public nomask varargs void setCoordinate(int x, int y, string path,
    string roomType)
{
    PersistRegion = 0;

    if ((x < 0) || (y < 0) || (x > MaxX) || (y > MaxY))
    {
        raise_error(sprintf("Error in region.c: The coordinate provided "
            "(%d,%d) is not valid for this region.\n", x, y));
    }
    
    object environment;
    string loadFailed = catch (environment = load_object(path));
    if(loadFailed || (member(inherit_list(environment), 
        "/lib/environment/environment.lpc") < 0))
    {
        raise_error(sprintf("Error in region.c: The provided path "
            "(%O) is not a valid environment.\n", path));
    }

    if (!roomType)
    {
        roomType = "none";
    }

    if (sizeof(grid) < MaxX)
    {
        createEmptyGrid(MaxX, MaxY);
    }

    string decoratorType = environment->decoratorType();

    grid[x][y] = ([
        "is placed": 1,
        "room type": roomType,
        "name": path,
        "environment": environment,
        "state exits": environment->getExitDirections(),
    ]);

    if (decoratorType)
    {
        grid[x][y]["icon"] = RegionService->getMapDecorator(decoratorType);
    }

    environment->setCoordinates(this_object(), x, y);
}

/////////////////////////////////////////////////////////////////////////////
public nomask void setEntryCoordinate(int x, int y, string path,
    string enterFrom, string entryPoint)
{
    EntryPoint = entryPoint;
    EnterFrom = enterFrom;
    setCoordinate(x, y, path, "entry");

    grid[x][y]["exit to"] = enterFrom;
}

/////////////////////////////////////////////////////////////////////////////
public nomask void setExitCoordinate(int x, int y, string path,
    string exitTo)
{
    setCoordinate(x, y, path, "exit");

    grid[x][y]["exit to"] = exitTo;
    grid[x][y]["exit coordinates"] = ({ });
}

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{

}

/////////////////////////////////////////////////////////////////////////////
public nomask void create()
{
    if (!setupCompleted)
    {
        Setup();
        setupCompleted = 1;
    }
}
