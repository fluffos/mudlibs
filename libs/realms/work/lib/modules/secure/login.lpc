/////////////////////////////////////////////////////////////////////////////
private nomask void movePlayerToStart(object player)
{
    object startingLocation = 0;
    catch (startingLocation = load_object(player->savedLocation()));

    if (startingLocation)
    {
        startingLocation->enterEnvironment(player);
    }
    else
    {
        startingLocation = load_object(StartLocation());
        startingLocation->enterEnvironment(player);

        tell_object(player, "Doh! The room you were last in during your "
            "previous session is broken.\nYou have been moved to a different "
            "location.\n");
    }

    say(sprintf("%s has arrived.\n", player->Name()));
}

/////////////////////////////////////////////////////////////////////////////
private nomask object checkIfPlayerObjectExists(string name)
{
    object ret = 0;

    object *playersWithName = filter(users(), (: $1->RealName() == $2 :), name);

    if (sizeof(playersWithName))
    {
        ret = playersWithName[0];
        if (member(inherit_list(ret), "/lib/realizations/player.lpc") < 0)
        {
            ret = 0;
        }
        if (ret)
        {
            movePlayerToStart(ret);
        }
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
// FluffOS PORT NOTE: `ret->restore(name)` (and the wizard-only
// `ret->updateLoginTime()`) used to happen right here, inside object
// creation -- i.e. BEFORE the caller's `exec(player, this_object())` ever
// runs. `restore()` (lib/modules/secure/persistence.lpc) synchronously
// fires either onRestoreSucceeded, onCreationIncomplete, or (for a
// genuinely brand-new character) onRestoreFailed -- and onRestoreFailed
// is exactly what starts the 11-step character-creation wizard
// (lib/modules/creation/initializePlayer.lpc's onRestoreFailed(), which
// clone_object()s the first selector and calls tell_object()/input_to()
// on the new player). Confirmed live: this driver's tell_object() falls
// back to tell_npc()/catch_tell() (see vm/internal/simulate.cc) for any
// object whose `interactive` flag isn't set yet, and the new player
// object's `interactive` flag isn't set until exec() runs -- so every one
// of the wizard's prompts was silently swallowed, its input_to() was
// registered against a not-yet-interactive object, and the game just fell
// through to a normal (pre-exec, still-broken-in-the-exact-same-way)
// onRestoreSucceeded/movePlayerToStart -- landing every single new
// character in the game world with a completely blank, uninitialized
// character (Race "Unknown", every attribute 0, no skills/traits/guild)
// and no way to ever run character creation. Same underlying "driver
// state (command_giver/interactive) isn't what a create()-time call
// assumes it is" class of bug as this file's own already-documented
// add_action()/command_giver fix (see NOTES.md section 7) -- just hitting
// tell_object()/input_to() instead of add_action(). Fixed the same way:
// object creation no longer calls restore() itself; callers now call the
// new restorePlayerObject() below AFTER exec() has made the player
// actually interactive. See secure/login/user-creation.lpc's
// execNewPlayer()/execGuestPlayer() and secure/login/menu-interactions.lpc's
// execCharacter() for the three updated call sites.
private nomask object loadNewPlayerObject(string name)
{
    object ret = 0;
    object dataAccess = load_object("/lib/modules/secure/dataAccess.lpc");
    switch (dataAccess->playerType(name))
    {
        case "owner":
        case "god":
        case "demigod":
        case "archwizard":
        case "sage":
        case "elder":
        case "admin":
        case "senior":
        case "highwizard":
        case "emeritus":
        case "creator":
        case "wizard":
        case "apprentice":
        {
            ret = clone_object("/lib/realizations/wizard.lpc");
            ret->registerEvent(clone_object(
                "/lib/modules/creation/initializePlayer.lpc"));
            break;
        }
        default:
        {
            ret = clone_object("/lib/realizations/player.lpc");
            ret->registerEvent(clone_object(
                "/lib/modules/creation/initializePlayer.lpc"));

            break;
        }
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
// Restores a player's saved data (or, for a genuinely new character,
// triggers character creation) -- see loadNewPlayerObject()'s port note
// above for why this MUST be called only after the player object is
// already exec()'d/interactive, never during creation. `program_name()`
// (not `inherit_list()`) is used for the wizard-type check -- this
// driver's inherit_list() never includes an object's own class (see
// NOTES.md section 9), so `member(inherit_list(player),
// "/lib/realizations/wizard.lpc")` would always be -1 even for a genuine
// wizard.lpc instance.
/////////////////////////////////////////////////////////////////////////////
public nomask void restorePlayerObject(object player, string name)
{
    player->restore(name);
    if (program_name(player) == "/lib/realizations/wizard.lpc")
    {
        player->updateLoginTime();
    }
}

/////////////////////////////////////////////////////////////////////////////
public nomask void reportUserLogin(object user)
{
    object channels = getService("channel");
    if (channels)
    {
        string address = query_ip_number(user) || "???";
        channels->registerUser(user);
        channels->broadcastMessage("status", sprintf("%s (%s) has joined"
            " the game.\n", capitalize(user->RealName()), address), user);
        user->setProperty("IP address", address);
    }
}

/////////////////////////////////////////////////////////////////////////////
public nomask object getPlayerObject(string name)
{
    object ret = checkIfPlayerObjectExists(name);
    if (!ret)
    {
        ret = loadNewPlayerObject(name);
    }

    call_out("reportUserLogin", 1, ret);
    return ret;
}
