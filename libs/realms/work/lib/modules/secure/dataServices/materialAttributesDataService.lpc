/////////////////////////////////////////////////////////////////////////////
protected nomask mapping getMaterialAttributes(int playerId, int dbHandle)
{
    mapping ret = ([]);

    string query = sprintf("select * from materialAttributes "
        "where playerid = '%d'", playerId);
    db_exec(dbHandle, query);

    mixed result;

    do
    {
        result = db_fetch(dbHandle);
        if (result)
        {
            ret[result[2]] = result[3];
        }
    } while (result);

    return ret;
}

/////////////////////////////////////////////////////////////////////////////
protected nomask void saveMaterialAttributes(int dbHandle, int playerId, mapping playerData)
{
    string query = sprintf("call saveMaterialAttributes("
        "%d,'%s','%s','%s','%s','%s','%s','%s','%s','%s','%s');",
        playerId,
        DB_UTIL->sanitizeString(playerData["title"] || ""),
        DB_UTIL->sanitizeString(playerData["pretitle"] || ""),
        DB_UTIL->sanitizeString(playerData["messageIn"] || ""),
        DB_UTIL->sanitizeString(playerData["messageOut"] || ""),
        DB_UTIL->sanitizeString(playerData["magicalMessageIn"] || ""),
        DB_UTIL->sanitizeString(playerData["magicalMessageOut"] || ""),
        DB_UTIL->sanitizeString(playerData["messageHome"] || ""),
        DB_UTIL->sanitizeString(playerData["messageClone"] || ""),
        DB_UTIL->sanitizeString(playerData["shortDescription"] || ""),
        DB_UTIL->sanitizeString(playerData["longDescription"] || ""));

    db_exec(dbHandle, query);
    mixed result = db_fetch(dbHandle);
}
