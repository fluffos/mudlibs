/////////////////////////////////////////////////////////////////////////////
protected nomask mapping getGuildData(int playerId, int dbHandle)
{
    mapping ret = ([ "guilds": ([]) ]);

    string query = sprintf("select * from guilds "
        "where playerid = '%d'", playerId);
    db_exec(dbHandle, query);

    mixed result;
    
    do
    {
        result = db_fetch(dbHandle);
        if (result)
        {
            ret["guilds"][result[2]] = ([
                "level": to_int(result[3]),
                "experience": to_int(result[4]),
                "rank": DB_UTIL->convertString(result[5]),
                "title": DB_UTIL->convertString(result[6]),
                "pretitle": DB_UTIL->convertString(result[7]),
                "left guild": to_int(result[8]),
                "anathema": to_int(result[9]),
                "rank advanced at": to_int(result[10])
            ]);
        }
    } while (result);

    return ret;
}

/////////////////////////////////////////////////////////////////////////////
protected nomask void saveGuildData(int dbHandle, int playerId, mapping playerData)
{
    if (member(playerData, "guilds") &&
        sizeof(playerData["guilds"]))
    {
        string *guilds = keys(playerData["guilds"]);
        foreach(string guild in guilds)
        {
            string query = sprintf("call saveGuild("
                "%d,'%s','%s','%s','%s',%d,%d,%d,%d,%d);",
                playerId,
                DB_UTIL->sanitizeString(guild),
                DB_UTIL->sanitizeString(DB_UTIL->convertString(playerData["guilds"][guild]["title"])),
                DB_UTIL->sanitizeString(DB_UTIL->convertString(playerData["guilds"][guild]["pretitle"])),
                DB_UTIL->sanitizeString(DB_UTIL->convertString(playerData["guilds"][guild]["rank"])),
                playerData["guilds"][guild]["level"],
                playerData["guilds"][guild]["experience"],
                playerData["guilds"][guild]["left guild"],
                playerData["guilds"][guild]["anathema"],
                playerData["guilds"][guild]["rank advanced at"]);
            db_exec(dbHandle, query);
            mixed result = db_fetch(dbHandle);
        }
    }
}

/////////////////////////////////////////////////////////////////////////////
protected void removeSavedGuildData(int dbHandle, string player, string guild)
{
    string query =
        sprintf("delete from guilds where playerId in "
            "(select id from players where name = '%s') and name = '%s';",
            DB_UTIL->sanitizeString(player),
            DB_UTIL->sanitizeString(guild));

    db_exec(dbHandle, query);
    mixed result = db_fetch(dbHandle);
}
