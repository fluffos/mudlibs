/////////////////////////////////////////////////////////////////////////////
protected nomask mapping getQuestData(int playerId, int dbHandle)
{
    mapping ret = (["quests":([])]);

    string query = sprintf("select * from quests "
        "where playerid = '%d'", playerId);
    db_exec(dbHandle, query);

    mixed result;

    do
    {
        result = db_fetch(dbHandle);
        if (result)
        {
            ret["quests"][result[2]] = ([
                "name":DB_UTIL->convertString(result[3]),
                "state" : DB_UTIL->convertString(result[4]),
                "states completed" : DB_UTIL->convertString(result[5]),
                "is active" : to_int(result[6]),
                "is completed" : to_int(result[7])
            ]);
        }
    } while (result);

    return ret;
}

/////////////////////////////////////////////////////////////////////////////
protected nomask void saveQuestData(int dbHandle, int playerId, mapping playerData)
{
    if (member(playerData, "quests") &&
        sizeof(playerData["quests"]))
    {
        string *quests = keys(playerData["quests"]);
        foreach(string quest in quests)
        {
            string query = sprintf("call saveQuest("
                "%d,'%s','%s','%s','%s',%d,%d);",
                playerId,
                DB_UTIL->sanitizeString(quest),
                DB_UTIL->sanitizeString(playerData["quests"][quest]["name"]),
                DB_UTIL->sanitizeString(playerData["quests"][quest]["state"]),
                DB_UTIL->sanitizeString(playerData["quests"][quest]["states completed"]),
                playerData["quests"][quest]["is active"],
                playerData["quests"][quest]["is completed"]);
            db_exec(dbHandle, query);
            mixed result = db_fetch(dbHandle);
        }
    }
}
