// FluffOS PORT NOTE: the direct `inherit
// "/lib/modules/secure/dataServices/dataService.lpc"` that stood here was
// removed -- every one of the ~18 dataService subclasses below ALSO
// inherits dataService.lpc itself, and this driver rejects the same base
// program being reachable at two different inherit DEPTHS at once
// (directly here at depth 1, AND indirectly through any one of the
// subclasses at depth 2) as an illegal diamond ("Illegal to redefine
// 'nomask' function ..."). Confirmed empirically (see also
// secure/login.lpc's identical fix) that the SAME base reached via many
// parallel SIBLING inherits at the SAME depth -- which is what remains
// here once the redundant direct one is gone -- is fine on this driver;
// it's specifically the direct-plus-indirect shape that isn't.
inherit "/lib/modules/secure/dataServices/basicPlayerDataService.lpc";
inherit "/lib/modules/secure/dataServices/materialAttributesDataService.lpc";
inherit "/lib/modules/secure/dataServices/guildDataService.lpc";
inherit "/lib/modules/secure/dataServices/questDataService.lpc";
inherit "/lib/modules/secure/dataServices/researchDataService.lpc";
inherit "/lib/modules/secure/dataServices/skillsDataService.lpc";
inherit "/lib/modules/secure/dataServices/traitsDataService.lpc";
inherit "/lib/modules/secure/dataServices/inventoryDataService.lpc";
inherit "/lib/modules/secure/dataServices/factionsDataService.lpc";
inherit "/lib/modules/secure/dataServices/combatStatisticsDataService.lpc";
inherit "/lib/modules/secure/dataServices/wizardDataService.lpc";
inherit "/lib/modules/secure/dataServices/conversationsDataService.lpc";
inherit "/lib/modules/secure/dataServices/stateDataService.lpc";
inherit "/lib/modules/secure/dataServices/settingsDataService.lpc";
inherit "/lib/modules/secure/dataServices/domainsDataService.lpc";
inherit "/lib/modules/secure/dataServices/experienceDataService.lpc";
inherit "/lib/modules/secure/dataServices/relationshipsDataService.lpc";

/////////////////////////////////////////////////////////////////////////////
public nomask mapping getPlayerData(string name)
{
    mapping data = (["name": name]);
    if (name == "guest")
    {
        data["is guest"] = 1;
        data["location"] = StartLocation();
    }
    else
    {
        if (canAccessDatabase(previous_object()))
        {
            int dbHandle = DB_UTIL->connect();
            data += getBasicPlayerData(name, dbHandle);

            if (member(data, "playerId"))
            {
                data += getGuildData(data["playerId"], dbHandle);
                data += getMaterialAttributes(data["playerId"], dbHandle);
                data += getQuestData(data["playerId"], dbHandle);
                data += getResearch(data["playerId"], dbHandle);
                data += getResearchChoices(data["playerId"], dbHandle);
                data += getOpenResearchTrees(data["playerId"], dbHandle);
                data += getCompositeResearch(data["playerId"], dbHandle);
                data += getConstructedResearch(data["playerId"], dbHandle);
                data += getSkills(data["playerId"], dbHandle);
                data += getTraits(data["playerId"], dbHandle);
                data += getTemporaryTraits(data["playerId"], dbHandle);
                data += getFactions(data["playerId"], dbHandle);
                data += getWizardLevel(data["playerId"], dbHandle);
                data += getPlayerSettings(dbHandle, name);
                // data += getPlayerDomains(data["playerId"], dbHandle);
                data += getInventory(data["playerId"], dbHandle);
                data += getExperience(data["playerId"], dbHandle);
                data += getRelationships(data["playerId"], dbHandle, name);
            }

            DB_UTIL->disconnect(dbHandle);
        }
        else
        {
            write("This is where a stern message about trying to circumvent "
                "security should probably go: " + program_name(previous_object()) + "\n");
        }
    }
    return data + ([]);
}

/////////////////////////////////////////////////////////////////////////////
public nomask void savePlayerData(mapping playerData)
{
    if (canAccessDatabase(previous_object()))
    {
        if (member(playerData, "name") && (playerData["name"] != "") &&
            (!member(playerData, "is guest") || !playerData["is guest"]))
        {
            int dbHandle = DB_UTIL->connect();
            int playerId = saveBasicPlayerData(dbHandle, playerData);
            saveBiologicalData(dbHandle, playerId, playerData);
            saveCombatData(dbHandle, playerId, playerData);
            saveMaterialAttributes(dbHandle, playerId, playerData);
            saveGuildData(dbHandle, playerId, playerData);
            saveQuestData(dbHandle, playerId, playerData);
            saveResearch(dbHandle, playerId, playerData);
            saveResearchChoices(dbHandle, playerId, playerData);
            saveOpenResearchTrees(dbHandle, playerId, playerData);
            saveCompositeResearch(dbHandle, playerData);
            saveConstructedResearch(dbHandle, playerData);
            saveSkills(dbHandle, playerId, playerData);
            saveTraits(dbHandle, playerId, playerData);
            saveFactions(dbHandle, playerId, playerData);
            saveWizardLevel(dbHandle, playerId, playerData);
            saveSettings(dbHandle, playerData);
//            saveDomains(dbHandle, playerId, playerData);
            saveInventory(dbHandle, playerId, playerData);
            saveExperience(dbHandle, playerId, playerData);
            saveRelationships(dbHandle, playerId, playerData);
            db_close(dbHandle);
        }
    }
    else
    {
        write("This is where a stern message about trying to circumvent "
            "security should probably go: " + program_name(previous_object()) + "\n");
    }
}

/////////////////////////////////////////////////////////////////////////////
private nomask void checkInitialization(string name)
{
    string query = "select count(id) from users";

    int dbHandle = DB_UTIL->connect();
    db_exec(dbHandle, query);

    mixed result = db_fetch(dbHandle);

    if (result)
    {
        if (to_int(result[0]) <= 1)
        {
            query = sprintf("insert into players (name) values ('%s');", name);
            db_exec(dbHandle, query);
            result = db_fetch(dbHandle);

            query = sprintf("insert into wizards (playerId, typeId) "
                "values ((select id from players where name = '%s'), "
                "(select id from wizardTypes where type = 'owner'));", name);
            db_exec(dbHandle, query);
            result = db_fetch(dbHandle);

            // FluffOS PORT NOTE: fixed a pre-existing upstream typo --
            // missing "[" after the ESC byte (every other ANSI sequence
            // in this codebase, including 4 lines below, correctly has
            // "\x1b[..."). LDMud's string-escape parser apparently
            // tolerated it (treating \x1b as literal ESC followed by the
            // plain text "0;37;1m"); this driver's stricter parser
            // rejected it outright ("Illegal character constant").
            printf(format("\n\n\x1b[0;37;1mNOTICE: Since you are the first "
                "character to log on to this MUD, the owner account has "
                "been set up with your information. After you have gone "
                "through the player creation process, you must log out and "
                "log back in to use your wizardly powers.\x1b[0m\n\n", 78));
        }
    }
    DB_UTIL->disconnect(dbHandle);
}

/////////////////////////////////////////////////////////////////////////////
public nomask string playerType(string name)
{
    string ret = "player";

    checkInitialization(name);
    string query = sprintf("select wizardTypes.type from wizards "
        "inner join wizardTypes on wizards.typeId = wizardTypes.id "
        "inner join players on wizards.playerid = players.id "
        "where players.name = '%s'", DB_UTIL->sanitizeString(name));

    int dbHandle = DB_UTIL->connect();

    db_exec(dbHandle, query);

    mixed result = db_fetch(dbHandle);
    DB_UTIL->disconnect(dbHandle);

    if (result)
    {
        ret = result[0];
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
public nomask int playerExists(string name)
{
    int ret = 0;

    string query = sprintf("select players.id from players "
        "where players.name = '%s'", DB_UTIL->sanitizeString(name));

    int dbHandle = DB_UTIL->connect();

    db_exec(dbHandle, query);

    mixed result = db_fetch(dbHandle);
    DB_UTIL->disconnect(dbHandle);

    if (result)
    {
        ret = 1;
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
public void savePlayerDomains(string player, mapping data)
{
    int dbHandle = DB_UTIL->connect();
    savePlayerDomainData(dbHandle, player, data);
    DB_UTIL->disconnect(dbHandle);
}

/////////////////////////////////////////////////////////////////////////////
public mapping getPlayerDomains(string player)
{
    int dbHandle = DB_UTIL->connect();
    mapping ret = getPlayerDomainData(player, dbHandle);
    DB_UTIL->disconnect(dbHandle);

    return ret;
}

