inherit "/lib/tests/framework/testFixture.lpc";

object Service;

/////////////////////////////////////////////////////////////////////////////
void Setup()
{
    Service = clone_object("/lib/services/researchService");
}

/////////////////////////////////////////////////////////////////////////////
void CleanUp()
{
    destruct(Service);
}

/////////////////////////////////////////////////////////////////////////////
void ResearchObjectReturnsNullIfNotResearchItem()
{
    ExpectFalse(Service.researchObject("/lib/realizations/player.lpc"));
    ExpectFalse(Service.researchObject("/lib/not_a_file"));
    ExpectFalse(Service.researchObject("/lib/modules/research.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void ResearchObjectReturnsObjectIfValid()
{
    ExpectTrue(Service.researchObject("/lib/modules/research/activeResearchItem.lpc"));
}
