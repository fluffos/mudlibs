{
    ExpectFalse(Wizard.hasReadAccess("/mail"));
    ExpectFalse(Wizard.hasReadAccess("/mail/m/maeglin.o"));
    ExpectFalse(Wizard.hasReadAccess("/mail/b/blah.o"));
