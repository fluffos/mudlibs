inherit "/lib/tests/framework/testFixture.lpc";

object Wizard;

protected nosave int Unknown = 0x8;
protected nosave int None = 0x0;
protected nosave int Owner = 0x1;
protected nosave int Write = 0x2;
protected nosave int Read = 0x4;

/////////////////////////////////////////////////////////////////////////////
void Init()
{
    setRestoreCaller(this_object());
    object database = clone_object("/lib/tests/modules/secure/fakeDatabase.lpc");
    database.PrepDatabase();

    object dataAccess = clone_object("/lib/modules/secure/dataAccess.lpc");
    dataAccess.savePlayerData(database.GetWizardOfLevel("archwizard"));

    destruct(dataAccess);
    destruct(database);
}

/////////////////////////////////////////////////////////////////////////////
void Setup()
{
    Wizard = clone_object("/lib/realizations/wizard.lpc");
    Wizard.restore("earl");
    setUsers(({ Wizard }));
}

/////////////////////////////////////////////////////////////////////////////
void CleanUp()
{
    destruct(Wizard);
}

/////////////////////////////////////////////////////////////////////////////
void ArchwizardCanReadFilesInRoot()
{
    ExpectTrue(Wizard.hasReadAccess("/ulmo.debug.log"));
    ExpectTrue(Wizard.hasReadAccess("/doc/regexp"));
    ExpectTrue(Wizard.hasReadAccess("/lib/modules/combat.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void ArchwizardCanWriteFilesInRoot()
{
    ExpectTrue(Wizard.hasWriteAccess("/ulmo.debug.log"));
    ExpectTrue(Wizard.hasWriteAccess("/doc/regexp"));
    ExpectTrue(Wizard.hasWriteAccess("/lib/modules/combat.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void ArchwizardIsNotOwnerOfFilesInRoot()
{
    ExpectFalse(Wizard.hasOwnershipAccess("/ulmo.debug.log"));
    ExpectFalse(Wizard.hasOwnershipAccess("/doc/regexp"));
    ExpectFalse(Wizard.hasOwnershipAccess("/lib/modules/combat.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void ArchwizardCanNotReadFilesInSecure()
{
    ExpectFalse(Wizard.hasReadAccess("/secure"));
    ExpectFalse(Wizard.hasReadAccess("/secure/master.lpc"));
    ExpectFalse(Wizard.hasReadAccess("/secure/room/board.lpc"));
    ExpectFalse(Wizard.hasReadAccess("/secure/player/files/player.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void ArchwizardCanNotWriteFilesInSecure()
{
    ExpectFalse(Wizard.hasWriteAccess("/secure"));
    ExpectFalse(Wizard.hasWriteAccess("/secure/master.lpc"));
    ExpectFalse(Wizard.hasWriteAccess("/secure/room/board.lpc"));
    ExpectFalse(Wizard.hasWriteAccess("/secure/player/files/player.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void ArchwizardIsNotOwnerOfFilesInSecure()
{
    ExpectFalse(Wizard.hasOwnershipAccess("/secure"));
    ExpectFalse(Wizard.hasOwnershipAccess("/secure/master.lpc"));
    ExpectFalse(Wizard.hasOwnershipAccess("/secure/room/board.lpc"));
    ExpectFalse(Wizard.hasOwnershipAccess("/secure/player/files/player.lpc"));
}

