inherit "/lib/tests/framework/testFixture.lpc";

object Container;

/////////////////////////////////////////////////////////////////////////////
void Setup()
{
    Container = clone_object("/lib/items/container");
}

/////////////////////////////////////////////////////////////////////////////
void CleanUp()
{
    destruct(Container);
}

/////////////////////////////////////////////////////////////////////////////
void LongReturnsCorrectMessageWhenEmpty()
{
    Container.set("long", "Blah blah blah");
    Container.set("additional long", "even more blah");

    ExpectEq("Blah blah blah\nThis item is typical for its type.\n\n", 
        Container.long(), "long() returns correct value");
}

/////////////////////////////////////////////////////////////////////////////
void LongReturnsCorrectMessageWhenNotEmpty()
{
    object sword = clone_object("/lib/instances/items/weapons/swords/long-sword.lpc");
    sword->move_object(Container);
    Container->move_object("/lib/tests/support/environment/fakeEnvironment.lpc");

    Container.set("long", "Blah blah blah");
    Container.set("additional long", "even more blah");

    ExpectSubStringMatch("Blah blah blah.*This item contains the following.*Long sword",
        Container.long(), "long() returns correct value");
    destruct(load_object("/lib/tests/support/environment/fakeEnvironment.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void LongMergesDuplicateItems()
{
    object sword = clone_object("/lib/instances/items/weapons/swords/long-sword.lpc");
    sword->move_object(Container);
    sword = clone_object("/lib/instances/items/weapons/swords/long-sword.lpc");
    sword->move_object(Container);
    sword = clone_object("/lib/instances/items/weapons/swords/long-sword.lpc");
    sword->move_object(Container);
    Container->move_object("/lib/tests/support/environment/fakeEnvironment.lpc");

    Container.set("long", "Blah blah blah");
    Container.set("additional long", "even more blah");

    ExpectSubStringMatch("Blah blah blah.*This item contains the following.*3. Long sword",
        Container.long(), "long() returns correct value");
    destruct(load_object("/lib/tests/support/environment/fakeEnvironment.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void LongDisplaysManyItemsCorrectly()
{
    object item = clone_object("/lib/instances/items/weapons/swords/long-sword.lpc");
    item->move_object(Container);
    item = clone_object("/lib/instances/items/weapons/swords/long-sword.lpc");
    item->move_object(Container);
    item = clone_object("/lib/instances/items/weapons/swords/long-sword.lpc");
    item->move_object(Container);
    item = clone_object("/lib/instances/items/weapons/swords/short-sword.lpc");
    item->move_object(Container);
    item = clone_object("/lib/instances/items/weapons/axes/battle-axe.lpc");
    item->move_object(Container);
    item = clone_object("/lib/instances/items/potions/healing.lpc");
    item->move_object(Container);
    item = clone_object("/lib/instances/items/potions/mana.lpc");
    item->move_object(Container);

    Container->move_object("/lib/tests/support/environment/fakeEnvironment.lpc");

    Container.set("long", "Blah blah blah");
    Container.set("additional long", "even more blah");

    ExpectSubStringMatch("Blah blah blah.*This item contains the following.*"
        "Battle axe.*Healing.*3. Long sword.*Mana.*Short",
        Container.long(), "long() returns correct value");
    destruct(load_object("/lib/tests/support/environment/fakeEnvironment.lpc"));
}
