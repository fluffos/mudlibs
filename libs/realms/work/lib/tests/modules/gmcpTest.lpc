        "Char.Skills pushed on GMCP enable");
}

/////////////////////////////////////////////////////////////////////////////
void EnableGmcpPushesCharTraitsPackage()
{
    Player.telnetNegotiation(DO, TELOPT_GMCP, 0);
    string allFrames = implode(Player.caughtGmcpFrames(), " ");
