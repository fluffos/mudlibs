inherit "/lib/tests/framework/testFixture.lpc";

object Faction;

/////////////////////////////////////////////////////////////////////////////
void Setup()
{
    Faction = clone_object("/lib/realizations/player");
    Faction.Name("Bob");
    Faction.Gender("male");
}

/////////////////////////////////////////////////////////////////////////////
void CleanUp()
{
    destruct(Faction);
}

/////////////////////////////////////////////////////////////////////////////
void JoinFactionJoinsUserToFaction()
{
    ExpectFalse(Faction.memberOfFaction("/lib/tests/support/factions/testFaction.lpc"));
    ExpectTrue(Faction.joinFaction("/lib/tests/support/factions/testFaction.lpc"));
    ExpectTrue(Faction.memberOfFaction("/lib/tests/support/factions/testFaction.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void FactionsReturnsEmptyListWhenNotMemberOfAnyFactions()
{
    ExpectEq(({}), Faction.Factions());
}

/////////////////////////////////////////////////////////////////////////////
void FactionsReturnsListOfFactions()
{
    ExpectTrue(Faction.joinFaction("/lib/tests/support/factions/testFaction.lpc"));
    ExpectTrue(Faction.joinFaction("/lib/tests/support/factions/anotherFaction.lpc"));
    ExpectEq(({ "/lib/tests/support/factions/testFaction.lpc", "/lib/tests/support/factions/anotherFaction.lpc" }), 
        Faction.Factions());
}

/////////////////////////////////////////////////////////////////////////////
void JoinFactionReturnsFalseIfCalledWhenAlreadyJoined()
{
    ExpectTrue(Faction.joinFaction("/lib/tests/support/factions/testFaction.lpc"));
    ExpectFalse(Faction.joinFaction("/lib/tests/support/factions/testFaction.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void FactionDispositionIsNeutralWhenEncounteringInvalidFaction()
{
    ExpectEq("invalid", Faction.factionDispositionToward("/lib/badFaction"));
}

/////////////////////////////////////////////////////////////////////////////
void FactionDispositionIsNeutralWhenEncounteringUnknownFaction()
{
    ExpectEq("neutral", Faction.factionDispositionToward("/lib/tests/support/factions/testFaction.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void FactionDispositionIsAllyWhenFactionJoined()
{
    ExpectTrue(Faction.joinFaction("/lib/tests/support/factions/testFaction.lpc"));
    ExpectEq("ally", Faction.factionDispositionToward("/lib/tests/support/factions/testFaction.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void FactionDispositionIsBetrayedWhenFactionLeft()
{
    ExpectTrue(Faction.joinFaction("/lib/tests/support/factions/testFaction.lpc"));
    ExpectTrue(Faction.leaveFaction("/lib/tests/support/factions/testFaction.lpc"));
    ExpectEq("betrayed", Faction.factionDispositionToward("/lib/tests/support/factions/testFaction.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void UpdateFactionDispositionModifiesReputation()
{
    ExpectEq(0, Faction.factionReputationToward("/lib/tests/support/factions/testFaction.lpc"));
    Faction.updateFactionDisposition("/lib/tests/support/factions/testFaction.lpc", 10);
    ExpectEq(10, Faction.factionReputationToward("/lib/tests/support/factions/testFaction.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void UpdateFactionDispositionDoesNotModifyDispositionWhenThreshholdNotMet()
{
    ExpectEq("neutral", Faction.factionDispositionToward("/lib/tests/support/factions/testFaction.lpc"));
    Faction.updateFactionDisposition("/lib/tests/support/factions/testFaction.lpc", 1);
    ExpectEq("neutral", Faction.factionDispositionToward("/lib/tests/support/factions/testFaction.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void UpdateFactionDispositionBecomesHostileWhenMemberMurdered()
{
    ExpectEq("neutral", Faction.factionDispositionToward("/lib/tests/support/factions/testFaction.lpc"));
    Faction.updateFactionDisposition("/lib/tests/support/factions/testFaction.lpc", 5, 1);
    ExpectEq("hostile", Faction.factionDispositionToward("/lib/tests/support/factions/testFaction.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void CombatUpdatesDispositionToHostileForFightingByDefault()
{
    object foe = clone_object("/lib/realizations/monster.lpc");
    Faction->move_object(this_object());
    foe->move_object(this_object());
    foe.joinFaction("/lib/tests/support/factions/testFaction.lpc");
    ExpectEq("neutral", Faction.factionDispositionToward("/lib/tests/support/factions/testFaction.lpc"));
    foe.hit(1000, "physical", Faction);
    ExpectEq("hostile", Faction.factionDispositionToward("/lib/tests/support/factions/testFaction.lpc"));
}

/////////////////////////////////////////////////////////////////////////////
void CombatUpdatesReputationForFighting()
{
    object foe = clone_object("/lib/realizations/monster.lpc");
    Faction->move_object(this_object());
    foe->move_object(this_object());
    foe.joinFaction("/lib/tests/support/factions/testFaction.lpc");
    ExpectEq(0, Faction.factionReputationToward("/lib/tests/support/factions/testFaction.lpc"));
    foe.hit(1000, "physical", Faction);
    ExpectEq(-1, Faction.factionReputationToward("/lib/tests/support/factions/testFaction.lpc"));
}
