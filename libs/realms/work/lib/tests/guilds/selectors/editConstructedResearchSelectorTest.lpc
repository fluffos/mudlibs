        "name": "Test Spell",
        "constraint": "/guilds/aeromancer/construct/root.lpc",
        "type": "/guilds/aeromancer/construct/root.lpc",
        "elements": ({})
    ]));
    
    Selector.initiateSelector(User);
    
    ExpectSubStringMatch("Spell Alias: <No Alias>", User.caughtMessage());
