inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/tests/support/environment/fakeTerrain.lpc");
    addFeature("/lib/tests/support/environment/fakeFeature.lpc", "north");
    addFeature("/lib/tests/support/environment/fakeSimpleFeature.lpc", "south");
    addBuilding("/lib/tests/support/environment/fakeBuilding.lpc", "west", "/some/path/location.lpc");
    addFeature("fake feature", "east");
    addItem("/lib/tests/support/environment/fakeItem.lpc", "north");

    addExit("south", "/some/path.lpc");

    addObject("/lib/items/weapon.lpc", "someState");
    addObject("/lib/realizations/monster.lpc");
    setAdditionalLongDescription("This is an extra long description to be "
        "displayed after the feature descriptions");
}

/////////////////////////////////////////////////////////////////////////////
protected int alwaysLight()
{
    return 10;
}
