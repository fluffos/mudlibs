inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("tree of blargness");
    Description("this is the land-loving mother pigeon of all research trees");
    Source("blarg");
    addResearchElement("/lib/tests/support/research/compositeRoot.lpc");
    addResearchElement("/lib/tests/support/research/compositeResearchItemA.lpc");
    addResearchElement("/lib/tests/support/research/compositeResearchItemB.lpc");
    addResearchElement("/lib/tests/support/research/compositeResearchItemC.lpc");
    addResearchElement("/lib/tests/support/research/compositeResearchItemD.lpc");
    addResearchElement("/lib/tests/support/research/compositeResearchItemE.lpc");
    TreeRoot("/lib/tests/support/research/compositeRoot.lpc");
}
