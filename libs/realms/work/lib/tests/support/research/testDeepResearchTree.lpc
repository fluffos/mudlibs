inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("tree of researchiness");
    Description("this is the land-loving mother pigeon of all research trees");
    Source("mage guild");
    addResearchElement("/lib/tests/support/research/testTreeRoot.lpc");
    addResearchElement("/lib/tests/support/research/itemWithModifier.lpc");
    addResearchElement("/lib/tests/support/research/testLimitedByIntoxResearchItem.lpc");
    addResearchElement("/lib/tests/support/research/mockResearchTimed.lpc");
    addResearchElement("/lib/tests/support/research/testResearchA.lpc");
    addResearchElement("/lib/tests/support/research/testResearchB.lpc");
    addResearchElement("/lib/tests/support/research/testResearchC.lpc");
    addResearchElement("/lib/tests/support/research/testResearchD.lpc");
    addResearchElement("/lib/tests/support/research/testResearchE.lpc");
    addResearchElement("/lib/tests/support/research/testResearchF.lpc");
    addResearchElement("/lib/tests/support/research/testResearchG.lpc");
    TreeRoot("/lib/tests/support/research/testTreeRoot.lpc");
    addChild("/lib/tests/support/research/testLimitedByIntoxResearchItem.lpc", 
        "/lib/tests/support/research/testTreeRoot.lpc");
    addChild("/lib/tests/support/research/itemWithModifier.lpc", 
        "/lib/tests/support/research/testTreeRoot.lpc");
    addChild("/lib/tests/support/research/mockResearchTimed.lpc", 
        "/lib/tests/support/research/testTreeRoot.lpc");
    addChild("/lib/tests/support/research/testResearchA.lpc", 
        "/lib/tests/support/research/testTreeRoot.lpc");
    addChild("/lib/tests/support/research/testResearchB.lpc", 
        "/lib/tests/support/research/testTreeRoot.lpc");
    addChild("/lib/tests/support/research/testResearchC.lpc", 
        "/lib/tests/support/research/testLimitedByIntoxResearchItem.lpc");
    addChild("/lib/tests/support/research/testResearchD.lpc", 
        "/lib/tests/support/research/testLimitedByIntoxResearchItem.lpc");
    addChild("/lib/tests/support/research/testResearchD.lpc", 
        "/lib/tests/support/research/testResearchB.lpc");
    addChild("/lib/tests/support/research/testResearchE.lpc", 
        "/lib/tests/support/research/testResearchB.lpc");
    addChild("/lib/tests/support/research/testResearchF.lpc", 
        "/lib/tests/support/research/testResearchE.lpc");
    addChild("/lib/tests/support/research/testResearchG.lpc", 
        "/lib/tests/support/research/testResearchE.lpc");
    addChild("/lib/tests/support/research/testResearchG.lpc", 
        "/lib/tests/support/research/testResearchD.lpc");
}
