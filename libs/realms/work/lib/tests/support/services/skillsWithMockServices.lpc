inherit "/lib/core/thing.lpc";
inherit "/lib/realizations/realization.lpc";
inherit "/lib/core/events.lpc";
inherit "/lib/modules/materialAttributes.lpc";
inherit "/lib/modules/inventory.lpc";
inherit "/lib/modules/combat.lpc";
inherit "/lib/modules/attributes.lpc";
inherit "/lib/modules/factions.lpc";
inherit "/lib/modules/skills.lpc";
inherit "/lib/modules/races.lpc";
inherit "/lib/modules/guilds.lpc";
inherit "/lib/modules/movement.lpc";

inherit "/lib/tests/support/services/mockBackgroundModule.lpc";
inherit "/lib/tests/support/services/mockBiologicalModule.lpc";
inherit "/lib/tests/support/services/mockTraitsModule.lpc";
inherit "/lib/tests/support/services/mockResearchModule.lpc";

/////////////////////////////////////////////////////////////////////////////
public int has(string service)
{
    if (member(({ "guilds", "research", "traits", "biological", "background" }), service) > -1)
    {
        return 1;
    }
    else
    {
        return thing::has(service);
    }
}

/////////////////////////////////////////////////////////////////////////////
public void create()
{
    enable_commands();
}

/////////////////////////////////////////////////////////////////////////////
public nomask int isRealizationOfPlayer()
{
    return 1;
}

/////////////////////////////////////////////////////////////////////////////
public nomask int isRealizationOfLiving()
{
    return 1;
}
