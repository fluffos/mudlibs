inherit "/lib/core/thing.lpc";
inherit "/lib/core/events.lpc";
inherit "/lib/modules/materialAttributes.lpc";
inherit "/lib/modules/inventory.lpc";
inherit "/lib/modules/combat.lpc";
inherit "/lib/modules/attributes.lpc";
inherit "/lib/modules/skills.lpc";
inherit "/lib/modules/races.lpc";
inherit "/lib/modules/movement.lpc";
inherit "/lib/modules/research.lpc";
inherit "/lib/modules/biological.lpc";
inherit "/lib/modules/state.lpc";
inherit "/lib/modules/settings.lpc";

inherit "/lib/tests/support/services/mockBackgroundModule.lpc";
inherit "/lib/tests/support/services/mockGuildsModule.lpc";
inherit "/lib/tests/support/services/mockTraitsModule.lpc";
inherit "/lib/tests/support/services/mockQuestModule.lpc";
inherit "/lib/tests/support/services/mockFactionModule.lpc";

/////////////////////////////////////////////////////////////////////////////
public int has(string service)
{
    if (member(({ "guilds", "traits", "biological", "background", "quests", "factions" }), service) > -1)
    {
        return 1;
    }
    else
    {
        return thing::has(service);
    }
}

/////////////////////////////////////////////////////////////////////////////
public void create()
{
    enable_commands();
}

/////////////////////////////////////////////////////////////////////////////
public nomask int isRealizationOf(string type)
{
    return type == "player" || type == "living";
}

/////////////////////////////////////////////////////////////////////////////
public void heart_beat()
{
    call_other(this_object(), "combatHeartBeat");
    call_other(this_object(), "healingHeartBeat");
    call_other(this_object(), "researchHeartBeat");
}
