inherit "/lib/modules/guilds/baseGuild.lpc";

/////////////////////////////////////////////////////////////////////////////
public void SetupGuild()
{
    guildName("background");
    addPreferredSkillType("combat");
    DoNotAllowReJoinOfGuild();

    addCriteria("hit points", ([
        "type": "modifier",
        "apply": "2 every level",
        "end at level": 5
    ]));
    addCriteria("spell points", ([
        "type": "modifier",
        "apply": "2 every level",
        "end at level": 5
    ]));
    addCriteria("stamina points", ([
        "type": "modifier",
        "apply": "2 every level",
        "end at level": 5
    ]));

    addCriteria("attribute points", ([
        "type": "attribute points",
        "apply": "1 every 2 levels",
        "end at level": 5
    ]));

    addCriteria("skill points", ([
        "type": "skill points",
        "apply": "5 every level",
        "end at level": 5
    ]));

    addCriteria("research points", ([
        "type": "research points",
        "apply": "1 every level",
        "end at level": 5
    ]));

    addCriteria("background focus", ([
        "type": "research path",
        "name": "Your Focus",
        "description": "What types of activities were you most interested "
            "in during your childhood?",
        "apply": "at level 1",
        "research objects": ({ 
            "/guilds/background/paths/learning.lpc",
            "/guilds/background/paths/manipulative.lpc",
            "/guilds/background/paths/athletic.lpc",
            "/guilds/background/paths/martial.lpc",
            "/guilds/background/paths/dutiful.lpc",
            "/guilds/background/paths/miscreant.lpc",
        })
    ]));
}
