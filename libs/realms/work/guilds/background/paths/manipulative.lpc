inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/background/paths/manipulative/silver-tongue.lpc");
    addResearchElement("/guilds/background/paths/manipulative/keen-observer.lpc");
    addResearchElement("/guilds/background/paths/manipulative/social-chameleon.lpc");

    addChild("/guilds/background/paths/manipulative/silver-tongue.lpc",
        "/guilds/background/paths/manipulative/root.lpc");
    addChild("/guilds/background/paths/manipulative/keen-observer.lpc",
        "/guilds/background/paths/manipulative/root.lpc");
    addChild("/guilds/background/paths/manipulative/social-chameleon.lpc",
        "/guilds/background/paths/manipulative/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/background/paths/manipulative/persuader.lpc");
    addResearchElement("/guilds/background/paths/manipulative/hidden-motives.lpc");
    addResearchElement("/guilds/background/paths/manipulative/quick-lie.lpc");

    addChild("/guilds/background/paths/manipulative/persuader.lpc",
        "/guilds/background/paths/manipulative/silver-tongue.lpc");
    addChild("/guilds/background/paths/manipulative/hidden-motives.lpc",
        "/guilds/background/paths/manipulative/keen-observer.lpc");
    // quick-lie does not build off a first-level, so parent to root
    addChild("/guilds/background/paths/manipulative/quick-lie.lpc",
        "/guilds/background/paths/manipulative/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/background/paths/manipulative/master-negotiator.lpc");
    addResearchElement("/guilds/background/paths/manipulative/insightful.lpc");
    addResearchElement("/guilds/background/paths/manipulative/false-face.lpc");

    addChild("/guilds/background/paths/manipulative/master-negotiator.lpc",
        "/guilds/background/paths/manipulative/persuader.lpc");
    // insightful does not build off a second-level, so parent to root
    addChild("/guilds/background/paths/manipulative/insightful.lpc",
        "/guilds/background/paths/manipulative/root.lpc");
    addChild("/guilds/background/paths/manipulative/false-face.lpc",
        "/guilds/background/paths/manipulative/quick-lie.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/background/paths/manipulative/political-savvy.lpc");
    addResearchElement("/guilds/background/paths/manipulative/puppetmaster.lpc");
    addResearchElement("/guilds/background/paths/manipulative/hidden-in-plain-sight.lpc");

    addChild("/guilds/background/paths/manipulative/political-savvy.lpc",
        "/guilds/background/paths/manipulative/master-negotiator.lpc");
    addChild("/guilds/background/paths/manipulative/puppetmaster.lpc",
        "/guilds/background/paths/manipulative/insightful.lpc");
    // hidden-in-plain-sight does not build off a third-level, so parent to root
    addChild("/guilds/background/paths/manipulative/hidden-in-plain-sight.lpc",
        "/guilds/background/paths/manipulative/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/background/paths/manipulative/kingmaker.lpc");
    addResearchElement("/guilds/background/paths/manipulative/untouchable.lpc");
    addResearchElement("/guilds/background/paths/manipulative/legendary-influence.lpc");

    addChild("/guilds/background/paths/manipulative/kingmaker.lpc",
        "/guilds/background/paths/manipulative/political-savvy.lpc");
    // untouchable does not build off a fourth-level, so parent to root
    addChild("/guilds/background/paths/manipulative/untouchable.lpc",
        "/guilds/background/paths/manipulative/root.lpc");
    addChild("/guilds/background/paths/manipulative/legendary-influence.lpc",
        "/guilds/background/paths/manipulative/hidden-in-plain-sight.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("A Manipulative Little Shit");
    Description("You discovered early on that words and influence could be as powerful "
        "as any weapon. Whether charming, deceiving, or persuading, you learned to "
        "shape outcomes to your advantage. The manipulative path is for those who "
        "excel at reading people, navigating social situations, and bending others "
        "to their will.");
    Source("background");
    addResearchElement("/guilds/background/paths/manipulative/root.lpc");
    TreeRoot("/guilds/background/paths/manipulative/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
}
