inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/background/paths/athletic/iron-grip.lpc");
    addResearchElement("/guilds/background/paths/athletic/fleet-footed.lpc");
    addResearchElement("/guilds/background/paths/athletic/steady-balance.lpc");

    addChild("/guilds/background/paths/athletic/iron-grip.lpc",
        "/guilds/background/paths/athletic/root.lpc");
    addChild("/guilds/background/paths/athletic/fleet-footed.lpc",
        "/guilds/background/paths/athletic/root.lpc");
    addChild("/guilds/background/paths/athletic/steady-balance.lpc",
        "/guilds/background/paths/athletic/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/background/paths/athletic/long-distance.lpc");
    addResearchElement("/guilds/background/paths/athletic/quick-recovery.lpc");
    addResearchElement("/guilds/background/paths/athletic/verticality.lpc");

    addChild("/guilds/background/paths/athletic/long-distance.lpc",
        "/guilds/background/paths/athletic/iron-grip.lpc");
    addChild("/guilds/background/paths/athletic/quick-recovery.lpc",
        "/guilds/background/paths/athletic/fleet-footed.lpc");
    // verticality does not build off a first-level, so parent to root
    addChild("/guilds/background/paths/athletic/verticality.lpc",
        "/guilds/background/paths/athletic/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/background/paths/athletic/powerful-leap.lpc");
    addResearchElement("/guilds/background/paths/athletic/relentless.lpc");
    addResearchElement("/guilds/background/paths/athletic/rolling-landing.lpc");

    addChild("/guilds/background/paths/athletic/powerful-leap.lpc",
        "/guilds/background/paths/athletic/long-distance.lpc");
    // relentless does not build off a second-level, so parent to root
    addChild("/guilds/background/paths/athletic/relentless.lpc",
        "/guilds/background/paths/athletic/root.lpc");
    addChild("/guilds/background/paths/athletic/rolling-landing.lpc",
        "/guilds/background/paths/athletic/verticality.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/background/paths/athletic/unstoppable-force.lpc");
    addResearchElement("/guilds/background/paths/athletic/iron-endurance.lpc");
    addResearchElement("/guilds/background/paths/athletic/peak-performance.lpc");

    addChild("/guilds/background/paths/athletic/unstoppable-force.lpc",
        "/guilds/background/paths/athletic/powerful-leap.lpc");
    addChild("/guilds/background/paths/athletic/iron-endurance.lpc",
        "/guilds/background/paths/athletic/relentless.lpc");
    // peak-performance does not build off a third-level, so parent to root
    addChild("/guilds/background/paths/athletic/peak-performance.lpc",
        "/guilds/background/paths/athletic/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/background/paths/athletic/athletic-legend.lpc");
    addResearchElement("/guilds/background/paths/athletic/limitless-energy.lpc");
    addResearchElement("/guilds/background/paths/athletic/indomitable.lpc");

    addChild("/guilds/background/paths/athletic/athletic-legend.lpc",
        "/guilds/background/paths/athletic/unstoppable-force.lpc");
    // limitless-energy does not build off a fourth-level, so parent to root
    addChild("/guilds/background/paths/athletic/limitless-energy.lpc",
        "/guilds/background/paths/athletic/root.lpc");
    addChild("/guilds/background/paths/athletic/indomitable.lpc",
        "/guilds/background/paths/athletic/peak-performance.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("An Athlete");
    Description("You spent your formative years in constant motion - running, climbing, "
        "and testing the limits of your body. Whether through sport, labor, or "
        "adventure, you honed your physical prowess and developed a keen sense "
        "of coordination, endurance, and strength. The athletic path is for those "
        "who thrive on action and physical challenge.");
    Source("background");
    addResearchElement("/guilds/background/paths/athletic/root.lpc");
    TreeRoot("/guilds/background/paths/athletic/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
}
