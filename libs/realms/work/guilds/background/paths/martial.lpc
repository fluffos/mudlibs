inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/background/paths/martial/drill-discipline.lpc");
    addResearchElement("/guilds/background/paths/martial/weapon-familiarity.lpc");
    addResearchElement("/guilds/background/paths/martial/field-awareness.lpc");

    addChild("/guilds/background/paths/martial/drill-discipline.lpc",
        "/guilds/background/paths/martial/root.lpc");
    addChild("/guilds/background/paths/martial/weapon-familiarity.lpc",
        "/guilds/background/paths/martial/root.lpc");
    addChild("/guilds/background/paths/martial/field-awareness.lpc",
        "/guilds/background/paths/martial/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/background/paths/martial/armor-training.lpc");
    addResearchElement("/guilds/background/paths/martial/formation-tactics.lpc");
    addResearchElement("/guilds/background/paths/martial/quick-reaction.lpc");

    addChild("/guilds/background/paths/martial/armor-training.lpc",
        "/guilds/background/paths/martial/drill-discipline.lpc");
    addChild("/guilds/background/paths/martial/formation-tactics.lpc",
        "/guilds/background/paths/martial/weapon-familiarity.lpc");
    // quick-reaction does not build off a first-level, so parent to root
    addChild("/guilds/background/paths/martial/quick-reaction.lpc",
        "/guilds/background/paths/martial/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/background/paths/martial/weapon-mastery.lpc");
    addResearchElement("/guilds/background/paths/martial/battlefield-command.lpc");
    addResearchElement("/guilds/background/paths/martial/unyielding.lpc");

    addChild("/guilds/background/paths/martial/weapon-mastery.lpc",
        "/guilds/background/paths/martial/armor-training.lpc");
    // battlefield-command does not build off a second-level, so parent to root
    addChild("/guilds/background/paths/martial/battlefield-command.lpc",
        "/guilds/background/paths/martial/root.lpc");
    addChild("/guilds/background/paths/martial/unyielding.lpc",
        "/guilds/background/paths/martial/quick-reaction.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/background/paths/martial/strategic-mind.lpc");
    addResearchElement("/guilds/background/paths/martial/iron-wall.lpc");
    addResearchElement("/guilds/background/paths/martial/relentless-advance.lpc");

    addChild("/guilds/background/paths/martial/strategic-mind.lpc",
        "/guilds/background/paths/martial/weapon-mastery.lpc");
    addChild("/guilds/background/paths/martial/iron-wall.lpc",
        "/guilds/background/paths/martial/unyielding.lpc");
    // relentless-advance does not build off a third-level, so parent to root
    addChild("/guilds/background/paths/martial/relentless-advance.lpc",
        "/guilds/background/paths/martial/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/background/paths/martial/marshal-of-war.lpc");
    addResearchElement("/guilds/background/paths/martial/unbreakable.lpc");
    addResearchElement("/guilds/background/paths/martial/legendary-veteran.lpc");

    addChild("/guilds/background/paths/martial/marshal-of-war.lpc",
        "/guilds/background/paths/martial/strategic-mind.lpc");
    // unbreakable does not build off a fourth-level, so parent to root
    addChild("/guilds/background/paths/martial/unbreakable.lpc",
        "/guilds/background/paths/martial/root.lpc");
    addChild("/guilds/background/paths/martial/legendary-veteran.lpc",
        "/guilds/background/paths/martial/relentless-advance.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("A Childhood of Structured Military Learning");
    Description("From an early age, you were drawn to the art of combat. Whether through "
        "formal training, militia service, or personal ambition, you learned the "
        "ways of weapons, tactics, and discipline. The martial path is for those "
        "who see conflict as a crucible for growth and a means to protect or assert "
        "their will.");
    Source("background");
    addResearchElement("/guilds/background/paths/martial/root.lpc");
    TreeRoot("/guilds/background/paths/martial/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
}
