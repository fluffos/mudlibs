inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/background/paths/dutiful/obedient-mind.lpc");
    addResearchElement("/guilds/background/paths/dutiful/steady-hand.lpc");
    addResearchElement("/guilds/background/paths/dutiful/early-riser.lpc");

    addChild("/guilds/background/paths/dutiful/obedient-mind.lpc",
        "/guilds/background/paths/dutiful/root.lpc");
    addChild("/guilds/background/paths/dutiful/steady-hand.lpc",
        "/guilds/background/paths/dutiful/root.lpc");
    addChild("/guilds/background/paths/dutiful/early-riser.lpc",
        "/guilds/background/paths/dutiful/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/background/paths/dutiful/loyal-companion.lpc");
    addResearchElement("/guilds/background/paths/dutiful/attentive-listener.lpc");
    addResearchElement("/guilds/background/paths/dutiful/cleanly-habits.lpc");

    addChild("/guilds/background/paths/dutiful/loyal-companion.lpc",
        "/guilds/background/paths/dutiful/obedient-mind.lpc");
    addChild("/guilds/background/paths/dutiful/attentive-listener.lpc",
        "/guilds/background/paths/dutiful/steady-hand.lpc");
    // cleanly-habits does not build off a first-level, so parent to root
    addChild("/guilds/background/paths/dutiful/cleanly-habits.lpc",
        "/guilds/background/paths/dutiful/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/background/paths/dutiful/steadfast.lpc");
    addResearchElement("/guilds/background/paths/dutiful/keen-memory.lpc");
    addResearchElement("/guilds/background/paths/dutiful/organized-mind.lpc");

    addChild("/guilds/background/paths/dutiful/steadfast.lpc",
        "/guilds/background/paths/dutiful/loyal-companion.lpc");
    // keen-memory does not build off a second-level, so parent to root
    addChild("/guilds/background/paths/dutiful/keen-memory.lpc",
        "/guilds/background/paths/dutiful/root.lpc");
    addChild("/guilds/background/paths/dutiful/organized-mind.lpc",
        "/guilds/background/paths/dutiful/cleanly-habits.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/background/paths/dutiful/iron-discipline.lpc");
    addResearchElement("/guilds/background/paths/dutiful/guardian-instinct.lpc");
    addResearchElement("/guilds/background/paths/dutiful/efficient-worker.lpc");

    addChild("/guilds/background/paths/dutiful/iron-discipline.lpc",
        "/guilds/background/paths/dutiful/steadfast.lpc");
    addChild("/guilds/background/paths/dutiful/guardian-instinct.lpc",
        "/guilds/background/paths/dutiful/keen-memory.lpc");
    // efficient-worker does not build off a third-level, so parent to root
    addChild("/guilds/background/paths/dutiful/efficient-worker.lpc",
        "/guilds/background/paths/dutiful/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/background/paths/dutiful/pillar-of-community.lpc");
    addResearchElement("/guilds/background/paths/dutiful/unbreakable-will.lpc");
    addResearchElement("/guilds/background/paths/dutiful/legacy-of-service.lpc");

    addChild("/guilds/background/paths/dutiful/pillar-of-community.lpc",
        "/guilds/background/paths/dutiful/iron-discipline.lpc");
    // unbreakable-will does not build off a fourth-level, so parent to root
    addChild("/guilds/background/paths/dutiful/unbreakable-will.lpc",
        "/guilds/background/paths/dutiful/root.lpc");
    addChild("/guilds/background/paths/dutiful/legacy-of-service.lpc",
        "/guilds/background/paths/dutiful/efficient-worker.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("A Dutiful Child");
    Description("Responsibility and service defined your early years. You learned the "
        "value of discipline, loyalty, and fulfilling obligations - whether to family, "
        "community, or a higher calling. The dutiful path is for those who find "
        "purpose in structure, order, and the satisfaction of a job well done.");
    Source("background");
    addResearchElement("/guilds/background/paths/dutiful/root.lpc");
    TreeRoot("/guilds/background/paths/dutiful/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
}
