inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/background/paths/miscreant/sly-tricks.lpc");
    addResearchElement("/guilds/background/paths/miscreant/quick-hands.lpc");
    addResearchElement("/guilds/background/paths/miscreant/shadow-walker.lpc");

    addChild("/guilds/background/paths/miscreant/sly-tricks.lpc",
        "/guilds/background/paths/miscreant/root.lpc");
    addChild("/guilds/background/paths/miscreant/quick-hands.lpc",
        "/guilds/background/paths/miscreant/root.lpc");
    addChild("/guilds/background/paths/miscreant/shadow-walker.lpc",
        "/guilds/background/paths/miscreant/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/background/paths/miscreant/urban-survivor.lpc");
    addResearchElement("/guilds/background/paths/miscreant/escape-artist.lpc");
    addResearchElement("/guilds/background/paths/miscreant/keen-observation.lpc");

    addChild("/guilds/background/paths/miscreant/urban-survivor.lpc",
        "/guilds/background/paths/miscreant/sly-tricks.lpc");
    addChild("/guilds/background/paths/miscreant/escape-artist.lpc",
        "/guilds/background/paths/miscreant/quick-hands.lpc");
    // keen-observation does not build off a first-level, so parent to root
    addChild("/guilds/background/paths/miscreant/keen-observation.lpc",
        "/guilds/background/paths/miscreant/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/background/paths/miscreant/dirty-fighting.lpc");
    addResearchElement("/guilds/background/paths/miscreant/poison-affinity.lpc");
    addResearchElement("/guilds/background/paths/miscreant/quick-thinking.lpc");

    addChild("/guilds/background/paths/miscreant/dirty-fighting.lpc",
        "/guilds/background/paths/miscreant/urban-survivor.lpc");
    // poison-affinity does not build off a second-level, so parent to root
    addChild("/guilds/background/paths/miscreant/poison-affinity.lpc",
        "/guilds/background/paths/miscreant/root.lpc");
    addChild("/guilds/background/paths/miscreant/quick-thinking.lpc",
        "/guilds/background/paths/miscreant/keen-observation.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/background/paths/miscreant/underworld-contacts.lpc");
    addResearchElement("/guilds/background/paths/miscreant/lockbreaker.lpc");
    addResearchElement("/guilds/background/paths/miscreant/second-wind.lpc");

    addChild("/guilds/background/paths/miscreant/underworld-contacts.lpc",
        "/guilds/background/paths/miscreant/dirty-fighting.lpc");
    addChild("/guilds/background/paths/miscreant/lockbreaker.lpc",
        "/guilds/background/paths/miscreant/poison-affinity.lpc");
    // second-wind does not build off a third-level, so parent to root
    addChild("/guilds/background/paths/miscreant/second-wind.lpc",
        "/guilds/background/paths/miscreant/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/background/paths/miscreant/master-of-disguise.lpc");
    addResearchElement("/guilds/background/paths/miscreant/uncanny-luck.lpc");
    addResearchElement("/guilds/background/paths/miscreant/escape-death.lpc");

    addChild("/guilds/background/paths/miscreant/master-of-disguise.lpc",
        "/guilds/background/paths/miscreant/underworld-contacts.lpc");
    // uncanny-luck does not build off a fourth-level, so parent to root
    addChild("/guilds/background/paths/miscreant/uncanny-luck.lpc",
        "/guilds/background/paths/miscreant/root.lpc");
    addChild("/guilds/background/paths/miscreant/escape-death.lpc",
        "/guilds/background/paths/miscreant/second-wind.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("A Miscreant");
    Description("You grew up on the fringes, learning to survive by your wits and "
        "sometimes bending or breaking the rules. Whether as a prankster, a thief, "
        "or simply a rebel, you developed cunning, resourcefulness, and a knack "
        "for getting into (and out of) trouble. The miscreant path is for those "
        "who thrive in the shadows and live by their own code.");
    Source("background");
    addResearchElement("/guilds/background/paths/miscreant/root.lpc");
    TreeRoot("/guilds/background/paths/miscreant/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
}
