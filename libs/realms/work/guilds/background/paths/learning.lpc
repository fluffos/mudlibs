inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/background/paths/learning/mental-refresh.lpc");
    addResearchElement("/guilds/background/paths/learning/curious-mind.lpc");
    addResearchElement("/guilds/background/paths/learning/attentive-listener.lpc");

    addChild("/guilds/background/paths/learning/mental-refresh.lpc",
        "/guilds/background/paths/learning/root.lpc");
    addChild("/guilds/background/paths/learning/curious-mind.lpc",
        "/guilds/background/paths/learning/root.lpc");
    addChild("/guilds/background/paths/learning/attentive-listener.lpc",
        "/guilds/background/paths/learning/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/background/paths/learning/clarifying-thought.lpc");
    addResearchElement("/guilds/background/paths/learning/quick-learner.lpc");
    addResearchElement("/guilds/background/paths/learning/keen-memory.lpc");

    addChild("/guilds/background/paths/learning/clarifying-thought.lpc",
        "/guilds/background/paths/learning/mental-refresh.lpc");
    addChild("/guilds/background/paths/learning/quick-learner.lpc",
        "/guilds/background/paths/learning/curious-mind.lpc");
    // keen-memory does not build off a first-level, so parent to root
    addChild("/guilds/background/paths/learning/keen-memory.lpc",
        "/guilds/background/paths/learning/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/background/paths/learning/mental-vigor.lpc");
    addResearchElement("/guilds/background/paths/learning/patient-study.lpc");
    addResearchElement("/guilds/background/paths/learning/analytical.lpc");

    addChild("/guilds/background/paths/learning/mental-vigor.lpc",
        "/guilds/background/paths/learning/clarifying-thought.lpc");
    // patient-study does not build off a second-level, so parent to root
    addChild("/guilds/background/paths/learning/patient-study.lpc",
        "/guilds/background/paths/learning/root.lpc");
    addChild("/guilds/background/paths/learning/analytical.lpc",
        "/guilds/background/paths/learning/keen-memory.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/background/paths/learning/total-recall.lpc");
    addResearchElement("/guilds/background/paths/learning/encyclopedic.lpc");
    addResearchElement("/guilds/background/paths/learning/critical-thinking.lpc");

    addChild("/guilds/background/paths/learning/total-recall.lpc",
        "/guilds/background/paths/learning/mental-vigor.lpc");
    addChild("/guilds/background/paths/learning/encyclopedic.lpc",
        "/guilds/background/paths/learning/analytical.lpc");
    // critical-thinking does not build off a third-level, so parent to root
    addChild("/guilds/background/paths/learning/critical-thinking.lpc",
        "/guilds/background/paths/learning/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/background/paths/learning/genius.lpc");
    addResearchElement("/guilds/background/paths/learning/wise-counsel.lpc");
    addResearchElement("/guilds/background/paths/learning/innovator.lpc");

    addChild("/guilds/background/paths/learning/genius.lpc",
        "/guilds/background/paths/learning/total-recall.lpc");
    // wise-counsel does not build off a fourth-level, so parent to root
    addChild("/guilds/background/paths/learning/wise-counsel.lpc",
        "/guilds/background/paths/learning/root.lpc");
    addChild("/guilds/background/paths/learning/innovator.lpc",
        "/guilds/background/paths/learning/critical-thinking.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("A Studious Childhood");
    Description("Curiosity and a thirst for knowledge shaped your upbringing. You spent "
        "your time reading, studying, and seeking out new ideas - whether in a formal "
        "school, a mentor's tutelage, or self-driven exploration. The learning path "
        "is for those who value intellect, wisdom, and the pursuit of understanding.");
    Source("background");
    addResearchElement("/guilds/background/paths/learning/root.lpc");
    TreeRoot("/guilds/background/paths/learning/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
}
