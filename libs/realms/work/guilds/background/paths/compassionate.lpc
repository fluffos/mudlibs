inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/background/paths/compassionate/gentle-touch.lpc");
    addResearchElement("/guilds/background/paths/compassionate/empathic-sense.lpc");
    addResearchElement("/guilds/background/paths/compassionate/calming-presence.lpc");

    addChild("/guilds/background/paths/compassionate/gentle-touch.lpc",
        "/guilds/background/paths/compassionate/root.lpc");
    addChild("/guilds/background/paths/compassionate/empathic-sense.lpc",
        "/guilds/background/paths/compassionate/root.lpc");
    addChild("/guilds/background/paths/compassionate/calming-presence.lpc",
        "/guilds/background/paths/compassionate/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/background/paths/compassionate/healers-instinct.lpc");
    addResearchElement("/guilds/background/paths/compassionate/understanding-heart.lpc");
    addResearchElement("/guilds/background/paths/compassionate/protective-nature.lpc");

    addChild("/guilds/background/paths/compassionate/healers-instinct.lpc",
        "/guilds/background/paths/compassionate/gentle-touch.lpc");
    addChild("/guilds/background/paths/compassionate/understanding-heart.lpc",
        "/guilds/background/paths/compassionate/empathic-sense.lpc");

    addChild("/guilds/background/paths/compassionate/protective-nature.lpc",
        "/guilds/background/paths/compassionate/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/background/paths/compassionate/shared-burden.lpc");
    addResearchElement("/guilds/background/paths/compassionate/merciful-soul.lpc");
    addResearchElement("/guilds/background/paths/compassionate/nurturer.lpc");

    addChild("/guilds/background/paths/compassionate/shared-burden.lpc",
        "/guilds/background/paths/compassionate/healers-instinct.lpc");

    addChild("/guilds/background/paths/compassionate/merciful-soul.lpc",
        "/guilds/background/paths/compassionate/root.lpc");
    addChild("/guilds/background/paths/compassionate/nurturer.lpc",
        "/guilds/background/paths/compassionate/protective-nature.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/background/paths/compassionate/selfless-devotion.lpc");
    addResearchElement("/guilds/background/paths/compassionate/life-ward.lpc");
    addResearchElement("/guilds/background/paths/compassionate/beacon-of-hope.lpc");

    addChild("/guilds/background/paths/compassionate/selfless-devotion.lpc",
        "/guilds/background/paths/compassionate/shared-burden.lpc");
    addChild("/guilds/background/paths/compassionate/life-ward.lpc",
        "/guilds/background/paths/compassionate/nurturer.lpc");
 
    addChild("/guilds/background/paths/compassionate/beacon-of-hope.lpc",
        "/guilds/background/paths/compassionate/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/background/paths/compassionate/saint.lpc");
    addResearchElement("/guilds/background/paths/compassionate/martyrs-resolve.lpc");
    addResearchElement("/guilds/background/paths/compassionate/healers-legacy.lpc");

    addChild("/guilds/background/paths/compassionate/saint.lpc",
        "/guilds/background/paths/compassionate/selfless-devotion.lpc");
 
    addChild("/guilds/background/paths/compassionate/martyrs-resolve.lpc",
        "/guilds/background/paths/compassionate/root.lpc");
    addChild("/guilds/background/paths/compassionate/healers-legacy.lpc",
        "/guilds/background/paths/compassionate/beacon-of-hope.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("A Compassionate Soul");
    Description("Your formative years were spent caring for others - tending the sick, "
        "comforting the grieving, or protecting the vulnerable. Whether through a "
        "healer's tutelage, family duty, or natural empathy, you learned that true "
        "strength lies in lifting others up. The compassionate path is for those who "
        "find purpose in easing suffering and believe that kindness is never weakness.");
    Source("background");
    addResearchElement("/guilds/background/paths/compassionate/root.lpc");
    TreeRoot("/guilds/background/paths/compassionate/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
}
