inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/background/paths/devoted/inner-peace.lpc");
    addResearchElement("/guilds/background/paths/devoted/faithful-heart.lpc");
    addResearchElement("/guilds/background/paths/devoted/spiritual-awareness.lpc");

    addChild("/guilds/background/paths/devoted/inner-peace.lpc",
        "/guilds/background/paths/devoted/root.lpc");
    addChild("/guilds/background/paths/devoted/faithful-heart.lpc",
        "/guilds/background/paths/devoted/root.lpc");
    addChild("/guilds/background/paths/devoted/spiritual-awareness.lpc",
        "/guilds/background/paths/devoted/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/background/paths/devoted/meditative-focus.lpc");
    addResearchElement("/guilds/background/paths/devoted/spiritual-resilience.lpc");
    addResearchElement("/guilds/background/paths/devoted/humble-servant.lpc");

    addChild("/guilds/background/paths/devoted/meditative-focus.lpc",
        "/guilds/background/paths/devoted/inner-peace.lpc");
    addChild("/guilds/background/paths/devoted/spiritual-resilience.lpc",
        "/guilds/background/paths/devoted/faithful-heart.lpc");
    // humble-servant does not build off a first-level, so parent to root
    addChild("/guilds/background/paths/devoted/humble-servant.lpc",
        "/guilds/background/paths/devoted/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/background/paths/devoted/enlightened-mind.lpc");
    addResearchElement("/guilds/background/paths/devoted/divine-purpose.lpc");
    addResearchElement("/guilds/background/paths/devoted/spiritual-fortitude.lpc");

    addChild("/guilds/background/paths/devoted/enlightened-mind.lpc",
        "/guilds/background/paths/devoted/meditative-focus.lpc");
    // divine-purpose does not build off a second-level, so parent to root
    addChild("/guilds/background/paths/devoted/divine-purpose.lpc",
        "/guilds/background/paths/devoted/root.lpc");
    addChild("/guilds/background/paths/devoted/spiritual-fortitude.lpc",
        "/guilds/background/paths/devoted/humble-servant.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/background/paths/devoted/transcendent-wisdom.lpc");
    addResearchElement("/guilds/background/paths/devoted/unshakeable-faith.lpc");
    addResearchElement("/guilds/background/paths/devoted/spiritual-clarity.lpc");

    addChild("/guilds/background/paths/devoted/transcendent-wisdom.lpc",
        "/guilds/background/paths/devoted/enlightened-mind.lpc");
    addChild("/guilds/background/paths/devoted/unshakeable-faith.lpc",
        "/guilds/background/paths/devoted/spiritual-fortitude.lpc");
    // spiritual-clarity does not build off a third-level, so parent to root
    addChild("/guilds/background/paths/devoted/spiritual-clarity.lpc",
        "/guilds/background/paths/devoted/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/background/paths/devoted/ascended-soul.lpc");
    addResearchElement("/guilds/background/paths/devoted/divine-vessel.lpc");
    addResearchElement("/guilds/background/paths/devoted/spiritual-mastery.lpc");

    addChild("/guilds/background/paths/devoted/ascended-soul.lpc",
        "/guilds/background/paths/devoted/transcendent-wisdom.lpc");
    // divine-vessel does not build off a fourth-level, so parent to root
    addChild("/guilds/background/paths/devoted/divine-vessel.lpc",
        "/guilds/background/paths/devoted/root.lpc");
    addChild("/guilds/background/paths/devoted/spiritual-mastery.lpc",
        "/guilds/background/paths/devoted/spiritual-clarity.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("A Devoted Seeker");
    Description("Your childhood was marked by questions of meaning and purpose. Whether "
        "raised in a religious order, mentored by a mystic, or driven by personal "
        "seeking, you developed a deep connection to something greater than yourself. "
        "The devoted path is for those who find strength in faith, seek wisdom through "
        "contemplation, and believe that spiritual growth is as important as physical prowess.");
    Source("background");
    addResearchElement("/guilds/background/paths/devoted/root.lpc");
    TreeRoot("/guilds/background/paths/devoted/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
}
