inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Supreme Blade");
    addSpecification("source", "rogue");
    addSpecification("description", "This skill provides the rogue "
        "with enhanced blade combat abilities.");

    addSpecification("limited by", (["equipment":({ "dagger", "short sword" })]));

    addPrerequisite("/guilds/rogue/blade-craft/peerless-edge.lpc",
        (["type": "research"]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "rogue",
            "value": 45
        ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus attack", 5);
    addSpecification("bonus dagger", 4);
}
