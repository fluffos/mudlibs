inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Supreme Subterfuge");
    addSpecification("source", "rogue");
    addSpecification("description", "This skill provides the rogue "
        "with enhanced deception and misdirection abilities.");

    addPrerequisite("/guilds/rogue/subterfuge/subterfuge-mastery-viii.lpc",
        (["type": "research"]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "rogue",
            "value": 63
        ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus hide", 12);
    addSpecification("bonus move silently", 8);
}
