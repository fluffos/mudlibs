inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/rogue/shadow-arts/cloak-of-shadows.lpc");
    addResearchElement("/guilds/rogue/shadow-arts/lingering-shadow.lpc");

    addChild("/guilds/rogue/shadow-arts/cloak-of-shadows.lpc",
        "/guilds/rogue/shadow-arts/root.lpc");
    addChild("/guilds/rogue/shadow-arts/lingering-shadow.lpc",
        "/guilds/rogue/shadow-arts/root.lpc");
}

