/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Shadow Arts");
    Description("This research tree provides the rogue with "
        "shadow manipulation techniques.");
    Source("rogue");
    addResearchElement("/guilds/rogue/shadow-arts/root.lpc");
    TreeRoot("/guilds/rogue/shadow-arts/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
}
