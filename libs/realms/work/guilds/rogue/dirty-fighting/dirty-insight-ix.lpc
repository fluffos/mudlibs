inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Dirty Insight IX");
    addSpecification("source", "rogue");
    addSpecification("description", "This skill provides the rogue with the "
        "knowledge to increase the effectiveness of dirty "
        "fighting attacks.");

    addPrerequisite("/guilds/rogue/dirty-fighting/dirty-insight-viii.lpc",
        (["type": "research"]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "rogue",
            "value": 37
        ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Sand Toss": 10,
        "Knee Breaker": 10,
        "Rib Crack": 10,
        "Skull Bash": 10,
        "Gut Punch": 10,
        "Spine Snap": 10,
        "Crippling Blow": 10,
        "Brutal Slam": 10,
        "Bone Crusher": 10,
        "Devastating Strike": 10
    ]));
    addSpecification("affected research type", "percentage");
}
