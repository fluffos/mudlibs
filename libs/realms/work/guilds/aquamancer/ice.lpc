}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/aquamancer/ice/ice-shards.lpc");
    addResearchElement("/guilds/aquamancer/ice/frost-blades.lpc");
    addResearchElement("/guilds/aquamancer/ice/ice-bolt.lpc");

    addChild("/guilds/aquamancer/ice/ice-shards.lpc",
        "/guilds/aquamancer/ice/chill.lpc");
    addChild("/guilds/aquamancer/ice/frost-blades.lpc",
        "/guilds/aquamancer/ice/root.lpc");
    addChild("/guilds/aquamancer/ice/ice-bolt.lpc",
        "/guilds/aquamancer/ice/chill.lpc");
}

