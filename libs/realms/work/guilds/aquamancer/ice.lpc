inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/aquamancer/ice/chill.lpc");

    addChild("/guilds/aquamancer/ice/chill.lpc",
        "/guilds/aquamancer/ice/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/aquamancer/ice/ice-lash.lpc");

    addChild("/guilds/aquamancer/ice/ice-lash.lpc",
