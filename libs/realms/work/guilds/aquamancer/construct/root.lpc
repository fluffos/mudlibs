inherit "/lib/modules/research/constructedActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Constructed Aquamancer Spells");
    addSpecification("source", "aquamancer");
    addSpecification("description", "This skill provides the user with the "
        "knowledge of casting constructed spells that can provide "
        "complex effects.");

    addSpecification("constructed rules", ([
        "form must include only one of": ({
            "/guilds/aquamancer/forms/arc.lpc",
            "/guilds/aquamancer/forms/ball.lpc",
            "/guilds/aquamancer/forms/blade.lpc",
            "/guilds/aquamancer/forms/blast.lpc",
            "/guilds/aquamancer/forms/bolt.lpc",
            "/guilds/aquamancer/forms/cage.lpc",
            "/guilds/aquamancer/forms/coil.lpc",
            "/guilds/aquamancer/forms/droplet.lpc",
            "/guilds/aquamancer/forms/geyser.lpc",
            "/guilds/aquamancer/forms/lance.lpc",
            "/guilds/aquamancer/forms/maelstrom.lpc",
            "/guilds/aquamancer/forms/mist.lpc",
            "/guilds/aquamancer/forms/orb.lpc",
            "/guilds/aquamancer/forms/pulse.lpc",
            "/guilds/aquamancer/forms/razor.lpc",
            "/guilds/aquamancer/forms/ring.lpc",
            "/guilds/aquamancer/forms/spear.lpc",
            "/guilds/aquamancer/forms/splash.lpc",
            "/guilds/aquamancer/forms/spray.lpc",
            "/guilds/aquamancer/forms/strike.lpc",
            "/guilds/aquamancer/forms/tendril.lpc",
            "/guilds/aquamancer/forms/touch.lpc",
            "/guilds/aquamancer/forms/tsunami.lpc",
            "/guilds/aquamancer/forms/wall.lpc",
            "/guilds/aquamancer/forms/waterspout.lpc",
            "/guilds/aquamancer/forms/wave.lpc",
            "/guilds/aquamancer/forms/whirlpool.lpc",
        }),
        "function must include only one of": ({
            "/guilds/aquamancer/functions/water.lpc",
            "/guilds/aquamancer/functions/chill.lpc",
            "/guilds/aquamancer/functions/ice.lpc",
            "/guilds/aquamancer/functions/steam.lpc",
            "/guilds/aquamancer/functions/current.lpc",
            "/guilds/aquamancer/functions/pressure.lpc",
            "/guilds/aquamancer/functions/drowning.lpc",
            "/guilds/aquamancer/functions/crushing.lpc",
            "/guilds/aquamancer/functions/tempest.lpc",
            "/guilds/aquamancer/functions/brine.lpc",
            "/guilds/aquamancer/functions/acid.lpc",
        }),
        "effect must include any of": ({
            "/guilds/aquamancer/effects/damage-hp.lpc",
            "/guilds/aquamancer/effects/damage-sp.lpc",
            "/guilds/aquamancer/effects/damage-stamina.lpc",
            "/guilds/aquamancer/effects/add-hp.lpc",
            "/guilds/aquamancer/effects/add-sp.lpc",
            "/guilds/aquamancer/effects/add-stamina.lpc",
            "/guilds/aquamancer/effects/siphon-hp.lpc",
            "/guilds/aquamancer/effects/siphon-sp.lpc",
            "/guilds/aquamancer/effects/siphon-stamina.lpc",
            "/guilds/aquamancer/effects/enhance-attack.lpc",
            "/guilds/aquamancer/effects/enhance-damage.lpc",
            "/guilds/aquamancer/effects/enhance-defense.lpc",
            "/guilds/aquamancer/effects/enhance-soak.lpc",
            "/guilds/aquamancer/effects/enhance-dodge.lpc",
            "/guilds/aquamancer/effects/enhance-parry.lpc",
            "/guilds/aquamancer/effects/enhance-speed.lpc",
            "/guilds/aquamancer/effects/reduce-attack.lpc",
            "/guilds/aquamancer/effects/reduce-damage.lpc",
            "/guilds/aquamancer/effects/reduce-defense.lpc",
            "/guilds/aquamancer/effects/reduce-soak.lpc",
            "/guilds/aquamancer/effects/reduce-dodge.lpc",
            "/guilds/aquamancer/effects/reduce-parry.lpc",
            "/guilds/aquamancer/effects/apply-slow.lpc",
            "/guilds/aquamancer/effects/apply-enfeebled.lpc",
            "/guilds/aquamancer/effects/staggering-damage.lpc",
            "/guilds/aquamancer/effects/debilitating-damage.lpc",
            "/guilds/aquamancer/effects/disorienting-damage.lpc",
            "/guilds/aquamancer/effects/hampering-damage.lpc",
            "/guilds/aquamancer/effects/exhausting-damage.lpc",
            "/guilds/aquamancer/effects/invigorating-siphon.lpc",
            "/guilds/aquamancer/effects/fortifying-siphon.lpc",
        }),
    ]));

    addSpecification("cooldown", 60);
    addSpecification("cooldown modifiers", ([
        "/guilds/aquamancer/construct/efficient-casting.lpc": 10,
        "/guilds/aquamancer/construct/improved-efficiency.lpc": 10,
        "/guilds/aquamancer/construct/expert-efficiency.lpc": 10,
        "/guilds/aquamancer/construct/master-efficiency.lpc": 10,
        "/guilds/aquamancer/construct/grandmaster-efficiency.lpc": 5,
        "/guilds/aquamancer/construct/legendary-efficiency.lpc": 5,
    ]));

    addSpecification("scope", "area");
    addSpecification("research type", "tree root");
    addSpecification("command name", "cast");
    addSpecification("command template", "cast aquamancer ##Value##");
    addSpecification("use ability message", "##InitiatorName## "
        "##Infinitive::cast## a spell...");
}
