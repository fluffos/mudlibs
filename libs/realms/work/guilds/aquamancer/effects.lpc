inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/aquamancer/effects/damage-hp.lpc");
    addResearchElement("/guilds/aquamancer/effects/add-hp.lpc");

    addChild("/guilds/aquamancer/effects/damage-hp.lpc",
        "/guilds/aquamancer/effects/root.lpc");
    addChild("/guilds/aquamancer/effects/add-hp.lpc",
        "/guilds/aquamancer/effects/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/aquamancer/effects/damage-sp.lpc");
    addResearchElement("/guilds/aquamancer/effects/add-sp.lpc");

    addChild("/guilds/aquamancer/effects/damage-sp.lpc",
        "/guilds/aquamancer/effects/damage-hp.lpc");
    addChild("/guilds/aquamancer/effects/add-sp.lpc",
        "/guilds/aquamancer/effects/add-hp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/aquamancer/effects/damage-stamina.lpc");
    addResearchElement("/guilds/aquamancer/effects/add-stamina.lpc");

    addChild("/guilds/aquamancer/effects/damage-stamina.lpc",
        "/guilds/aquamancer/effects/damage-sp.lpc");
    addChild("/guilds/aquamancer/effects/add-stamina.lpc",
        "/guilds/aquamancer/effects/add-sp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/aquamancer/effects/siphon-hp.lpc");
    addResearchElement("/guilds/aquamancer/effects/enhance-attack.lpc");
    addResearchElement("/guilds/aquamancer/effects/reduce-attack.lpc");

    addChild("/guilds/aquamancer/effects/siphon-hp.lpc",
        "/guilds/aquamancer/effects/damage-hp.lpc");
    addChild("/guilds/aquamancer/effects/enhance-attack.lpc",
        "/guilds/aquamancer/effects/add-hp.lpc");
    addChild("/guilds/aquamancer/effects/reduce-attack.lpc",
        "/guilds/aquamancer/effects/damage-hp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/aquamancer/effects/siphon-sp.lpc");
    addResearchElement("/guilds/aquamancer/effects/enhance-damage.lpc");
    addResearchElement("/guilds/aquamancer/effects/reduce-damage.lpc");

    addChild("/guilds/aquamancer/effects/siphon-sp.lpc",
        "/guilds/aquamancer/effects/siphon-hp.lpc");
    addChild("/guilds/aquamancer/effects/enhance-damage.lpc",
        "/guilds/aquamancer/effects/enhance-attack.lpc");
    addChild("/guilds/aquamancer/effects/reduce-damage.lpc",
        "/guilds/aquamancer/effects/reduce-attack.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/aquamancer/effects/siphon-stamina.lpc");
    addResearchElement("/guilds/aquamancer/effects/enhance-defense.lpc");
    addResearchElement("/guilds/aquamancer/effects/reduce-defense.lpc");

    addChild("/guilds/aquamancer/effects/siphon-stamina.lpc",
        "/guilds/aquamancer/effects/siphon-sp.lpc");
    addChild("/guilds/aquamancer/effects/enhance-defense.lpc",
        "/guilds/aquamancer/effects/enhance-damage.lpc");
    addChild("/guilds/aquamancer/effects/reduce-defense.lpc",
        "/guilds/aquamancer/effects/reduce-damage.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/aquamancer/effects/enhance-soak.lpc");
    addResearchElement("/guilds/aquamancer/effects/reduce-soak.lpc");

    addChild("/guilds/aquamancer/effects/enhance-soak.lpc",
        "/guilds/aquamancer/effects/enhance-defense.lpc");
    addChild("/guilds/aquamancer/effects/reduce-soak.lpc",
        "/guilds/aquamancer/effects/reduce-defense.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/aquamancer/effects/enhance-dodge.lpc");
    addResearchElement("/guilds/aquamancer/effects/reduce-dodge.lpc");
    addResearchElement("/guilds/aquamancer/effects/apply-slow.lpc");

    addChild("/guilds/aquamancer/effects/enhance-dodge.lpc",
        "/guilds/aquamancer/effects/enhance-soak.lpc");
    addChild("/guilds/aquamancer/effects/reduce-dodge.lpc",
        "/guilds/aquamancer/effects/reduce-soak.lpc");
    addChild("/guilds/aquamancer/effects/apply-slow.lpc",
        "/guilds/aquamancer/effects/reduce-soak.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/aquamancer/effects/enhance-parry.lpc");
    addResearchElement("/guilds/aquamancer/effects/reduce-parry.lpc");
    addResearchElement("/guilds/aquamancer/effects/enhance-speed.lpc");
    addResearchElement("/guilds/aquamancer/effects/apply-enfeebled.lpc");

    addChild("/guilds/aquamancer/effects/enhance-parry.lpc",
        "/guilds/aquamancer/effects/enhance-dodge.lpc");
    addChild("/guilds/aquamancer/effects/reduce-parry.lpc",
        "/guilds/aquamancer/effects/reduce-dodge.lpc");
    addChild("/guilds/aquamancer/effects/enhance-speed.lpc",
        "/guilds/aquamancer/effects/enhance-dodge.lpc");
    addChild("/guilds/aquamancer/effects/apply-enfeebled.lpc",
        "/guilds/aquamancer/effects/apply-slow.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/aquamancer/effects/staggering-damage.lpc");
    addResearchElement("/guilds/aquamancer/effects/debilitating-damage.lpc");
    addResearchElement("/guilds/aquamancer/effects/disorienting-damage.lpc");
    addResearchElement("/guilds/aquamancer/effects/invigorating-siphon.lpc");

    addChild("/guilds/aquamancer/effects/staggering-damage.lpc",
        "/guilds/aquamancer/effects/reduce-parry.lpc");
    addChild("/guilds/aquamancer/effects/debilitating-damage.lpc",
        "/guilds/aquamancer/effects/reduce-parry.lpc");
    addChild("/guilds/aquamancer/effects/disorienting-damage.lpc",
        "/guilds/aquamancer/effects/reduce-parry.lpc");
    addChild("/guilds/aquamancer/effects/invigorating-siphon.lpc",
        "/guilds/aquamancer/effects/enhance-speed.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/aquamancer/effects/hampering-damage.lpc");
    addResearchElement("/guilds/aquamancer/effects/exhausting-damage.lpc");
    addResearchElement("/guilds/aquamancer/effects/fortifying-siphon.lpc");

    addChild("/guilds/aquamancer/effects/hampering-damage.lpc",
        "/guilds/aquamancer/effects/apply-slow.lpc");
    addChild("/guilds/aquamancer/effects/exhausting-damage.lpc",
        "/guilds/aquamancer/effects/apply-enfeebled.lpc");
    addChild("/guilds/aquamancer/effects/fortifying-siphon.lpc",
        "/guilds/aquamancer/effects/invigorating-siphon.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Effects");
    Description("This research tree provides knowledge of the various effects "
        "that constructed aquamancer spells can produce.");
    Source("aquamancer");
    addResearchElement("/guilds/aquamancer/effects/root.lpc");
    TreeRoot("/guilds/aquamancer/effects/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
}
