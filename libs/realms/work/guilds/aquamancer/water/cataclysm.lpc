            "formula": "additive",
            "rate": 0.05
        ]),
        ([
            "type": "attribute",
            "name": "dexterity",
            "formula": "additive",
            "rate": 0.025
        ]),
        ([
            "type": "attribute",
            "name": "wisdom",
            "formula": "additive",
            "rate": 0.025
        ]),
    }));

    addSpecification("cooldown", 90);
    addSpecification("event handler", "cataclysmEvent");
    addSpecification("command template", "cataclysm");
    addSpecification("use ability message", "##InitiatorName## "
        "##Infinitive::raise## ##InitiatorPossessive## arms to the heavens "
        "and ##Infinitive::unleash## a world-ending cataclysm - crushing "
        "waves, freezing depths, boiling geysers, and toxic currents "
