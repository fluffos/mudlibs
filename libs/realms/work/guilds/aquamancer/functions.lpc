inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/aquamancer/functions/chill.lpc");
    addResearchElement("/guilds/aquamancer/functions/water.lpc");

    addChild("/guilds/aquamancer/functions/chill.lpc",
        "/guilds/aquamancer/functions/root.lpc");
    addChild("/guilds/aquamancer/functions/water.lpc",
        "/guilds/aquamancer/functions/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/aquamancer/functions/current.lpc");

    addChild("/guilds/aquamancer/functions/current.lpc",
        "/guilds/aquamancer/functions/water.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/aquamancer/functions/pressure.lpc");

    addChild("/guilds/aquamancer/functions/pressure.lpc",
        "/guilds/aquamancer/functions/water.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/aquamancer/functions/ice.lpc");

    addChild("/guilds/aquamancer/functions/ice.lpc",
        "/guilds/aquamancer/functions/chill.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/aquamancer/functions/steam.lpc");

    addChild("/guilds/aquamancer/functions/steam.lpc",
        "/guilds/aquamancer/functions/current.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/aquamancer/functions/drowning.lpc");

    addChild("/guilds/aquamancer/functions/drowning.lpc",
        "/guilds/aquamancer/functions/current.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/aquamancer/functions/crushing.lpc");

    addChild("/guilds/aquamancer/functions/crushing.lpc",
        "/guilds/aquamancer/functions/drowning.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/aquamancer/functions/tempest.lpc");

    addChild("/guilds/aquamancer/functions/tempest.lpc",
        "/guilds/aquamancer/functions/ice.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/aquamancer/functions/acid.lpc");

    addChild("/guilds/aquamancer/functions/acid.lpc",
        "/guilds/aquamancer/functions/steam.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/aquamancer/functions/brine.lpc");

    addChild("/guilds/aquamancer/functions/brine.lpc",
        "/guilds/aquamancer/functions/tempest.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Kinetics");
    Description("This research tree provides knowledge of the various damage "
        "types and propulsion mechanisms for constructed aquamancer spells.");
    Source("aquamancer");
    addResearchElement("/guilds/aquamancer/functions/root.lpc");
    TreeRoot("/guilds/aquamancer/functions/root.lpc");

    FirstLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
}
