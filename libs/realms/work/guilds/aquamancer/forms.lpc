inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/aquamancer/forms/arc.lpc");
    addResearchElement("/guilds/aquamancer/forms/touch.lpc");
    addResearchElement("/guilds/aquamancer/forms/splash.lpc");

    addChild("/guilds/aquamancer/forms/arc.lpc",
        "/guilds/aquamancer/forms/root.lpc");
    addChild("/guilds/aquamancer/forms/touch.lpc",
        "/guilds/aquamancer/forms/root.lpc");
    addChild("/guilds/aquamancer/forms/splash.lpc",
        "/guilds/aquamancer/forms/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/aquamancer/forms/bolt.lpc");
    addResearchElement("/guilds/aquamancer/forms/mist.lpc");
    addResearchElement("/guilds/aquamancer/forms/droplet.lpc");

    addChild("/guilds/aquamancer/forms/bolt.lpc",
        "/guilds/aquamancer/forms/arc.lpc");
    addChild("/guilds/aquamancer/forms/mist.lpc",
        "/guilds/aquamancer/forms/touch.lpc");
    addChild("/guilds/aquamancer/forms/droplet.lpc",
        "/guilds/aquamancer/forms/splash.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/aquamancer/forms/blade.lpc");
    addResearchElement("/guilds/aquamancer/forms/tendril.lpc");

    addChild("/guilds/aquamancer/forms/blade.lpc",
        "/guilds/aquamancer/forms/bolt.lpc");
    addChild("/guilds/aquamancer/forms/tendril.lpc",
        "/guilds/aquamancer/forms/droplet.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/aquamancer/forms/ball.lpc");
    addResearchElement("/guilds/aquamancer/forms/spear.lpc");
    addResearchElement("/guilds/aquamancer/forms/spray.lpc");

    addChild("/guilds/aquamancer/forms/ball.lpc",
        "/guilds/aquamancer/forms/bolt.lpc");
    addChild("/guilds/aquamancer/forms/spear.lpc",
        "/guilds/aquamancer/forms/blade.lpc");
    addChild("/guilds/aquamancer/forms/spray.lpc",
        "/guilds/aquamancer/forms/mist.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/aquamancer/forms/blast.lpc");
    addResearchElement("/guilds/aquamancer/forms/wave.lpc");
    addResearchElement("/guilds/aquamancer/forms/razor.lpc");

    addChild("/guilds/aquamancer/forms/blast.lpc",
        "/guilds/aquamancer/forms/ball.lpc");
    addChild("/guilds/aquamancer/forms/wave.lpc",
        "/guilds/aquamancer/forms/mist.lpc");
    addChild("/guilds/aquamancer/forms/razor.lpc",
        "/guilds/aquamancer/forms/tendril.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/aquamancer/forms/orb.lpc");
    addResearchElement("/guilds/aquamancer/forms/ring.lpc");

    addChild("/guilds/aquamancer/forms/orb.lpc",
        "/guilds/aquamancer/forms/blast.lpc");
    addChild("/guilds/aquamancer/forms/ring.lpc",
        "/guilds/aquamancer/forms/wave.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/aquamancer/forms/wall.lpc");
    addResearchElement("/guilds/aquamancer/forms/cage.lpc");
    addResearchElement("/guilds/aquamancer/forms/lance.lpc");

    addChild("/guilds/aquamancer/forms/wall.lpc",
        "/guilds/aquamancer/forms/wave.lpc");
    addChild("/guilds/aquamancer/forms/cage.lpc",
        "/guilds/aquamancer/forms/ring.lpc");
    addChild("/guilds/aquamancer/forms/lance.lpc",
        "/guilds/aquamancer/forms/spear.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/aquamancer/forms/geyser.lpc");
    addResearchElement("/guilds/aquamancer/forms/strike.lpc");

    addChild("/guilds/aquamancer/forms/geyser.lpc",
        "/guilds/aquamancer/forms/orb.lpc");
    addChild("/guilds/aquamancer/forms/strike.lpc",
        "/guilds/aquamancer/forms/lance.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/aquamancer/forms/coil.lpc");
    addResearchElement("/guilds/aquamancer/forms/whirlpool.lpc");

    addChild("/guilds/aquamancer/forms/coil.lpc",
        "/guilds/aquamancer/forms/cage.lpc");
    addChild("/guilds/aquamancer/forms/whirlpool.lpc",
        "/guilds/aquamancer/forms/geyser.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/aquamancer/forms/pulse.lpc");
    addResearchElement("/guilds/aquamancer/forms/maelstrom.lpc");

    addChild("/guilds/aquamancer/forms/pulse.lpc",
        "/guilds/aquamancer/forms/coil.lpc");
    addChild("/guilds/aquamancer/forms/maelstrom.lpc",
        "/guilds/aquamancer/forms/whirlpool.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/aquamancer/forms/tsunami.lpc");

    addChild("/guilds/aquamancer/forms/tsunami.lpc",
        "/guilds/aquamancer/forms/strike.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyThirdLevel()
{
    addResearchElement("/guilds/aquamancer/forms/waterspout.lpc");

    addChild("/guilds/aquamancer/forms/waterspout.lpc",
        "/guilds/aquamancer/forms/maelstrom.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Forms");
    Description("This research tree provides knowledge of the various forms "
        "that constructed aquamancer spells can take.");
    Source("aquamancer");
    addResearchElement("/guilds/aquamancer/forms/root.lpc");
    TreeRoot("/guilds/aquamancer/forms/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
}
