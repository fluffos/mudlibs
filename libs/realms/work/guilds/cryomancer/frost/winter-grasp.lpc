            "type": "attribute",
            "name": "wisdom",
            "formula": "additive",
            "rate": 0.025
        ]),
    }));

    addSpecification("cooldown", 10);
    addSpecification("event handler", "winterGraspEvent");
    addSpecification("command template", "winter grasp [at ##Target##]");
    addSpecification("use ability message", "A skeletal hand of ice "
