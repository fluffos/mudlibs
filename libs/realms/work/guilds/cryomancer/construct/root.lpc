inherit "/lib/modules/research/constructedActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Constructed Cryomancer Spells");
    addSpecification("source", "cryomancer");
    addSpecification("description", "This skill provides the user with the "
        "knowledge of constructing spells that can provide "
        "complex effects.");

    addSpecification("spell point cost", 30);
    addSpecification("spell point cost modifiers", ([
        "/guilds/cryomancer/construct/efficient-casting.lpc": 10,
        "/guilds/cryomancer/construct/improved-efficiency.lpc": 10,
        "/guilds/cryomancer/construct/expert-efficiency.lpc": 10,
        "/guilds/cryomancer/construct/master-efficiency.lpc": 10,
        "/guilds/cryomancer/construct/grandmaster-efficiency.lpc": 5,
        "/guilds/cryomancer/construct/legendary-efficiency.lpc": 5,
    ]));

    addSpecification("constructed rules", ([
        "form must include only one of": ({
            "/guilds/cryomancer/forms/arc.lpc",
            "/guilds/cryomancer/forms/droplet.lpc",
            "/guilds/cryomancer/forms/touch.lpc",
            "/guilds/cryomancer/forms/bolt.lpc",
            "/guilds/cryomancer/forms/shard.lpc",
            "/guilds/cryomancer/forms/spear.lpc",
            "/guilds/cryomancer/forms/spray.lpc",
            "/guilds/cryomancer/forms/needle.lpc",
            "/guilds/cryomancer/forms/blast.lpc",
            "/guilds/cryomancer/forms/mist.lpc",
            "/guilds/cryomancer/forms/razor.lpc",
            "/guilds/cryomancer/forms/wave.lpc",
            "/guilds/cryomancer/forms/tendril.lpc",
            "/guilds/cryomancer/forms/orb.lpc",
            "/guilds/cryomancer/forms/ring.lpc",
            "/guilds/cryomancer/forms/wall.lpc",
            "/guilds/cryomancer/forms/cage.lpc",
            "/guilds/cryomancer/forms/lance.lpc",
            "/guilds/cryomancer/forms/glacier.lpc",
            "/guilds/cryomancer/forms/strike.lpc",
            "/guilds/cryomancer/forms/coil.lpc",
            "/guilds/cryomancer/forms/vortex.lpc",
            "/guilds/cryomancer/forms/pulse.lpc",
            "/guilds/cryomancer/forms/avalanche.lpc",
            "/guilds/cryomancer/forms/blizzard.lpc",
            "/guilds/cryomancer/forms/icestorm.lpc",
        }),
        "function must include only one of": ({
            "/guilds/cryomancer/functions/cold.lpc",
            "/guilds/cryomancer/functions/frost.lpc",
            "/guilds/cryomancer/functions/ice.lpc",
            "/guilds/cryomancer/functions/chill.lpc",
            "/guilds/cryomancer/functions/sleet.lpc",
            "/guilds/cryomancer/functions/freeze.lpc",
            "/guilds/cryomancer/functions/hail.lpc",
            "/guilds/cryomancer/functions/glacial.lpc",
            "/guilds/cryomancer/functions/blizzard.lpc",
            "/guilds/cryomancer/functions/permafrost.lpc",
            "/guilds/cryomancer/functions/void-cold.lpc",
        }),
        "effect must include any of": ({
            "/guilds/cryomancer/effects/damage-hp.lpc",
            "/guilds/cryomancer/effects/damage-sp.lpc",
            "/guilds/cryomancer/effects/damage-stamina.lpc",
            "/guilds/cryomancer/effects/add-hp.lpc",
            "/guilds/cryomancer/effects/add-sp.lpc",
            "/guilds/cryomancer/effects/add-stamina.lpc",
            "/guilds/cryomancer/effects/siphon-hp.lpc",
            "/guilds/cryomancer/effects/siphon-sp.lpc",
            "/guilds/cryomancer/effects/siphon-stamina.lpc",
            "/guilds/cryomancer/effects/enhance-attack.lpc",
            "/guilds/cryomancer/effects/enhance-damage.lpc",
            "/guilds/cryomancer/effects/enhance-defense.lpc",
            "/guilds/cryomancer/effects/enhance-soak.lpc",
            "/guilds/cryomancer/effects/enhance-dodge.lpc",
            "/guilds/cryomancer/effects/enhance-parry.lpc",
            "/guilds/cryomancer/effects/reduce-attack.lpc",
            "/guilds/cryomancer/effects/reduce-damage.lpc",
            "/guilds/cryomancer/effects/reduce-defense.lpc",
            "/guilds/cryomancer/effects/reduce-soak.lpc",
            "/guilds/cryomancer/effects/reduce-dodge.lpc",
            "/guilds/cryomancer/effects/reduce-parry.lpc",
            "/guilds/cryomancer/effects/apply-slow.lpc",
            "/guilds/cryomancer/effects/apply-frozen.lpc",
            "/guilds/cryomancer/effects/staggering-damage.lpc",
            "/guilds/cryomancer/effects/debilitating-damage.lpc",
            "/guilds/cryomancer/effects/disorienting-damage.lpc",
            "/guilds/cryomancer/effects/hampering-damage.lpc",
            "/guilds/cryomancer/effects/exhausting-damage.lpc",
            "/guilds/cryomancer/effects/invigorating-siphon.lpc",
            "/guilds/cryomancer/effects/fortifying-siphon.lpc",
        }),
    ]));

    addSpecification("cooldown", 60);
    addSpecification("cooldown modifiers", ([
        "/guilds/cryomancer/construct/efficient-casting.lpc": 10,
        "/guilds/cryomancer/construct/improved-efficiency.lpc": 10,
        "/guilds/cryomancer/construct/expert-efficiency.lpc": 10,
        "/guilds/cryomancer/construct/master-efficiency.lpc": 10,
        "/guilds/cryomancer/construct/grandmaster-efficiency.lpc": 5,
        "/guilds/cryomancer/construct/legendary-efficiency.lpc": 5,
    ]));

    addSpecification("scope", "area");
    addSpecification("research type", "tree root");
    addSpecification("command name", "cast");
    addSpecification("command template", "cast cryomancer ##Value##");
    addSpecification("use ability message", "##InitiatorName## "
        "##Infinitive::cast## a spell...");
}
