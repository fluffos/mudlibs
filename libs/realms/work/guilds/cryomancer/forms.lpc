inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/cryomancer/forms/arc.lpc");
    addResearchElement("/guilds/cryomancer/forms/droplet.lpc");
    addResearchElement("/guilds/cryomancer/forms/touch.lpc");

    addChild("/guilds/cryomancer/forms/arc.lpc",
        "/guilds/cryomancer/forms/root.lpc");
    addChild("/guilds/cryomancer/forms/droplet.lpc",
        "/guilds/cryomancer/forms/root.lpc");
    addChild("/guilds/cryomancer/forms/touch.lpc",
        "/guilds/cryomancer/forms/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/cryomancer/forms/bolt.lpc");
    addResearchElement("/guilds/cryomancer/forms/shard.lpc");
    addResearchElement("/guilds/cryomancer/forms/spear.lpc");

    addChild("/guilds/cryomancer/forms/bolt.lpc",
        "/guilds/cryomancer/forms/arc.lpc");
    addChild("/guilds/cryomancer/forms/shard.lpc",
        "/guilds/cryomancer/forms/droplet.lpc");
    addChild("/guilds/cryomancer/forms/spear.lpc",
        "/guilds/cryomancer/forms/touch.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/cryomancer/forms/spray.lpc");
    addResearchElement("/guilds/cryomancer/forms/needle.lpc");

    addChild("/guilds/cryomancer/forms/spray.lpc",
        "/guilds/cryomancer/forms/shard.lpc");
    addChild("/guilds/cryomancer/forms/needle.lpc",
        "/guilds/cryomancer/forms/spear.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/cryomancer/forms/blast.lpc");
    addResearchElement("/guilds/cryomancer/forms/mist.lpc");
    addResearchElement("/guilds/cryomancer/forms/razor.lpc");

    addChild("/guilds/cryomancer/forms/blast.lpc",
        "/guilds/cryomancer/forms/bolt.lpc");
    addChild("/guilds/cryomancer/forms/mist.lpc",
        "/guilds/cryomancer/forms/spray.lpc");
    addChild("/guilds/cryomancer/forms/razor.lpc",
        "/guilds/cryomancer/forms/needle.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/cryomancer/forms/wave.lpc");
    addResearchElement("/guilds/cryomancer/forms/tendril.lpc");

    addChild("/guilds/cryomancer/forms/wave.lpc",
        "/guilds/cryomancer/forms/mist.lpc");
    addChild("/guilds/cryomancer/forms/tendril.lpc",
        "/guilds/cryomancer/forms/razor.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/cryomancer/forms/orb.lpc");
    addResearchElement("/guilds/cryomancer/forms/ring.lpc");

    addChild("/guilds/cryomancer/forms/orb.lpc",
        "/guilds/cryomancer/forms/blast.lpc");
    addChild("/guilds/cryomancer/forms/ring.lpc",
        "/guilds/cryomancer/forms/wave.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/cryomancer/forms/wall.lpc");
    addResearchElement("/guilds/cryomancer/forms/cage.lpc");
    addResearchElement("/guilds/cryomancer/forms/lance.lpc");

    addChild("/guilds/cryomancer/forms/wall.lpc",
        "/guilds/cryomancer/forms/wave.lpc");
    addChild("/guilds/cryomancer/forms/cage.lpc",
        "/guilds/cryomancer/forms/ring.lpc");
    addChild("/guilds/cryomancer/forms/lance.lpc",
        "/guilds/cryomancer/forms/spear.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/cryomancer/forms/glacier.lpc");
    addResearchElement("/guilds/cryomancer/forms/strike.lpc");

    addChild("/guilds/cryomancer/forms/glacier.lpc",
        "/guilds/cryomancer/forms/orb.lpc");
    addChild("/guilds/cryomancer/forms/strike.lpc",
        "/guilds/cryomancer/forms/lance.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/cryomancer/forms/coil.lpc");
    addResearchElement("/guilds/cryomancer/forms/vortex.lpc");

    addChild("/guilds/cryomancer/forms/coil.lpc",
        "/guilds/cryomancer/forms/cage.lpc");
    addChild("/guilds/cryomancer/forms/vortex.lpc",
        "/guilds/cryomancer/forms/glacier.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/cryomancer/forms/pulse.lpc");
    addResearchElement("/guilds/cryomancer/forms/avalanche.lpc");

    addChild("/guilds/cryomancer/forms/pulse.lpc",
        "/guilds/cryomancer/forms/coil.lpc");
    addChild("/guilds/cryomancer/forms/avalanche.lpc",
        "/guilds/cryomancer/forms/vortex.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/cryomancer/forms/blizzard.lpc");

    addChild("/guilds/cryomancer/forms/blizzard.lpc",
        "/guilds/cryomancer/forms/strike.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyThirdLevel()
{
    addResearchElement("/guilds/cryomancer/forms/icestorm.lpc");

    addChild("/guilds/cryomancer/forms/icestorm.lpc",
        "/guilds/cryomancer/forms/avalanche.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Forms");
    Description("This research tree provides knowledge of the various forms "
        "that constructed cryomancer spells can take.");
    Source("cryomancer");
    addResearchElement("/guilds/cryomancer/forms/root.lpc");
    TreeRoot("/guilds/cryomancer/forms/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
}
