inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/cryomancer/functions/cold.lpc");
    addResearchElement("/guilds/cryomancer/functions/frost.lpc");

    addChild("/guilds/cryomancer/functions/cold.lpc",
        "/guilds/cryomancer/functions/root.lpc");
    addChild("/guilds/cryomancer/functions/frost.lpc",
        "/guilds/cryomancer/functions/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/cryomancer/functions/ice.lpc");
    addResearchElement("/guilds/cryomancer/functions/chill.lpc");

    addChild("/guilds/cryomancer/functions/ice.lpc",
        "/guilds/cryomancer/functions/frost.lpc");
    addChild("/guilds/cryomancer/functions/chill.lpc",
        "/guilds/cryomancer/functions/cold.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/cryomancer/functions/sleet.lpc");
    addResearchElement("/guilds/cryomancer/functions/freeze.lpc");

    addChild("/guilds/cryomancer/functions/sleet.lpc",
        "/guilds/cryomancer/functions/chill.lpc");
    addChild("/guilds/cryomancer/functions/freeze.lpc",
        "/guilds/cryomancer/functions/ice.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/cryomancer/functions/hail.lpc");
    addResearchElement("/guilds/cryomancer/functions/glacial.lpc");

    addChild("/guilds/cryomancer/functions/hail.lpc",
        "/guilds/cryomancer/functions/sleet.lpc");
    addChild("/guilds/cryomancer/functions/glacial.lpc",
        "/guilds/cryomancer/functions/freeze.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/cryomancer/functions/blizzard.lpc");
    addResearchElement("/guilds/cryomancer/functions/permafrost.lpc");

    addChild("/guilds/cryomancer/functions/blizzard.lpc",
        "/guilds/cryomancer/functions/hail.lpc");
    addChild("/guilds/cryomancer/functions/permafrost.lpc",
        "/guilds/cryomancer/functions/glacial.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/cryomancer/functions/void-cold.lpc");

    addChild("/guilds/cryomancer/functions/void-cold.lpc",
        "/guilds/cryomancer/functions/permafrost.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Functions");
    Description("This research tree provides knowledge of the various "
        "elemental functions that constructed cryomancer spells can employ.");
    Source("cryomancer");
    addResearchElement("/guilds/cryomancer/functions/root.lpc");
    TreeRoot("/guilds/cryomancer/functions/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
}
