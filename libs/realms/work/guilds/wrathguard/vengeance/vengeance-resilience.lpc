inherit "/lib/modules/research/passiveResearchItem.lpc";

protected void Setup()
{
    addSpecification("name", "Vengeance Resilience");
    addSpecification("source", "Wrathguard");
    addSpecification("description", "The fury of vengeance sustains "
        "the Wrathguard through battle, increasing hit points and "
        "healing rate.");
    addSpecification("research type", "points");
    addSpecification("scope", "self");
    addSpecification("research cost", 1);
    addSpecification("bonus hit points", 28);
    addSpecification("bonus heal hit points rate", 1);
    addPrerequisite("/guilds/wrathguard/vengeance/retributive-mind.lpc",
        (["type": "research"]));
    addPrerequisite("level",
        (["type": "level", "guild": "Wrathguard", "value": 19]));
}
