/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Vain Beauty");
    Description("The magic of Seilyndria's divine beauty, bending minds "
        "and breaking wills through charm, seduction, and domination.");
    Source("Wrathguard");
    addResearchElement("/guilds/wrathguard/combat/vain-beauty-root.lpc");
    TreeRoot("/guilds/wrathguard/combat/vain-beauty-root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
}