inherit "/lib/modules/research/researchTree.lpc";

private void FirstLevel()
{
    addResearchElement("/guilds/wrathguard/wrath/shadow-attunement.lpc");
    addResearchElement("/guilds/wrathguard/wrath/shadow-bolt.lpc");
    addChild("/guilds/wrathguard/wrath/shadow-attunement.lpc",
        "/guilds/wrathguard/wrath/shadow-magic-root.lpc");
    addChild("/guilds/wrathguard/wrath/shadow-bolt.lpc",
        "/guilds/wrathguard/wrath/shadow-magic-root.lpc");
}

