protected void Setup()
{
    Name("Shadow Magic");
    Description("This research tree provides knowledge of shadow and void "
        "magic - the darkness that precedes Seilyndria's ruin. Through study "
        "of the spaces between light, practitioners learn to hurl bolts of "
        "void energy, corrupt their enemies with shadow, and ultimately "
        "command the darkness that falls before the goddess herself.");
    Source("Wrathguard");
    addResearchElement("/guilds/wrathguard/wrath/shadow-magic-root.lpc");
    TreeRoot("/guilds/wrathguard/wrath/shadow-magic-root.lpc");
    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    NineteenthLevel();
    TwentyThirdLevel();
    TwentySeventhLevel();
    ThirtyFirstLevel();
    ThirtyFifthLevel();
    ThirtyNinthLevel();
    FortyThirdLevel();
    FortySeventhLevel();
}