/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Keeper's Rituals");
    Description("The ancient blood rites and dark ceremonies of Seilyndria's "
        "chosen, handed down through the Wrathguard's most devoted servants. "
        "Each ritual draws on sacred and profane power alike to inflict "
        "terrible suffering upon those who oppose the Queen.");
    Source("Wrathguard");
    addResearchElement("/guilds/wrathguard/rituals/keepers-rituals-root.lpc");
    TreeRoot("/guilds/wrathguard/rituals/keepers-rituals-root.lpc");

    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    EleventhLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtiethLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    FortyFirstLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FortyNinthLevel();
    FiftyThirdLevel();
    FiftyFifthLevel();
    FiftySeventhLevel();
    SixtyFirstLevel();
    SixtyFifthLevel();
    SixtySeventhLevel();
    SeventhiethLevel();
}
