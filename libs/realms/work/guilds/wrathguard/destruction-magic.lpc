    addResearchElement("/guilds/wrathguard/destruction/unmake.lpc");
    addChild("/guilds/wrathguard/destruction/ruin-bolt-mastery.lpc",
        "/guilds/wrathguard/destruction/ruin-attunement.lpc");
    addChild("/guilds/wrathguard/destruction/ruinous-resilience.lpc",
        "/guilds/wrathguard/destruction/ruin-attunement.lpc");
    addChild("/guilds/wrathguard/destruction/unmake.lpc",
        "/guilds/wrathguard/destruction/shatter.lpc");
}
