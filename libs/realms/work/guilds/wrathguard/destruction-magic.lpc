inherit "/lib/modules/research/researchTree.lpc";

private void FirstLevel()
{
    addResearchElement("/guilds/wrathguard/destruction/ruin-attunement.lpc");
    addResearchElement("/guilds/wrathguard/destruction/shatter.lpc");
    addChild("/guilds/wrathguard/destruction/ruin-attunement.lpc",
        "/guilds/wrathguard/destruction/ruin-root.lpc");
    addChild("/guilds/wrathguard/destruction/shatter.lpc",
        "/guilds/wrathguard/destruction/ruin-root.lpc");
}
private void ThirdLevel()
{
    addResearchElement("/guilds/wrathguard/destruction/ruin-bolt-mastery.lpc");
