inherit "/lib/modules/research/knowledgeResearchItem.lpc";

protected void Setup()
{
    addSpecification("name", "Void Seduction Mastery");
    addSpecification("source", "Wrathguard");
    addSpecification("description", "Draws void energy into acts of seduction, "
        "giving charm and domination spells a cutting edge.");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("scope", "self");
    addSpecification("effect", "enchantment");
    addPrerequisite("level",
        (["type": "level", "guild": "Wrathguard", "value": 1]));
    addPrerequisite("/guilds/wrathguard/combat/enthralling-mastery.lpc",
        (["type": "research"]));
    addSpecification("affected research type", "percentage");
    addSpecification("affected research", ([
        "Void Charm": 25,
        "Mind Shatter": 20,
        "The Queen's Gaze": 20,
        "Seductive Annihilation": 20,
        "Seilyndria's Kiss": 15
    ]));
}
