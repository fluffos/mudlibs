protected void Setup()
{
    Name("Courage");
    Description("The first pillar of the Order of Phaedra: the courage "
        "to stand firm, to act righteously, and to press forward "
        "where others falter.");
    Source("Order of Phaedra");
    addResearchElement("/guilds/phaedra/courage/courage-root.lpc");
    TreeRoot("/guilds/phaedra/courage/courage-root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
