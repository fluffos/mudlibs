/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("White Rose");
    Description("The rank-gated path of the White Rose companion: those "
        "who have proven themselves worthy of bearing Phaedra's emblem "
        "may unlock deeper knowledge of the Order's most sacred teachings, "
        "combining martial excellence with radiant light.");
    Source("Order of Phaedra");
    addResearchElement("/guilds/phaedra/white-rose/white-rose-root.lpc");
    TreeRoot("/guilds/phaedra/white-rose/white-rose-root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentySeventhLevel();
    ThirtyFirstLevel();
    ThirtyFifthLevel();
    ThirtyNinthLevel();
    FortyFifthLevel();
    FiftyFirstLevel();
