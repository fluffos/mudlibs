protected void Setup()
{
    Name("Stewardship");
    Description("The third pillar of the Order of Phaedra: to preserve "
        "what has been entrusted, to see clearly, to speak with "
        "authority, and to ensure the realm endures.");
    Source("Order of Phaedra");
    addResearchElement("/guilds/phaedra/stewardship/stewardship-root.lpc");
    TreeRoot("/guilds/phaedra/stewardship/stewardship-root.lpc");

    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtyNinthLevel();
    FortyFifthLevel();
    FortySeventhLevel();
    FiftyFirstLevel();
    FiftyFifthLevel();
    SixtyFirstLevel();
    SixtyThirdLevel();
    SixtyFifthLevel();
    SixtySeventhLevel();
    SixtyNinthLevel();
}
