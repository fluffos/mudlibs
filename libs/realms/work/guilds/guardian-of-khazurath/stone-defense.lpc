/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Stone Defense");
    Description("The defensive mastery of Khazurath - the art of becoming "
        "immovable, impenetrable, and unyielding. Guardians who walk this "
        "path transform their body into living stone, adding layer upon layer "
        "of passive defense, soak, and parry until no blow can break them.");
    Source("Guardian of Khazurath");
    addResearchElement("/guilds/guardian-of-khazurath/defense/root.lpc");
    TreeRoot("/guilds/guardian-of-khazurath/defense/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyThirdLevel();
    FortySeventhLevel();
    FiftySecondLevel();
    FiftySeventhLevel();
    SixtySecondLevel();
    SixtyFifthLevel();
    SeventhiethLevel();
}
