inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Battle Presence");
    addSpecification("source", "Guardian of Khazurath");
    addSpecification("description", "This skill provides the user with knowledge of a powerful battle presence that bolsters both offense and defense.");

    addPrerequisite("/guilds/guardian-of-khazurath/keeper/battle-cry.lpc",
        (["type": "research"]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "Guardian of Khazurath",
            "value": 15
        ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus attack", 3);
    addSpecification("bonus damage", 3);
    addSpecification("bonus defense", 2);
}
