/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Mountain Strength");
    Description("The strength of the mountain given form. Guardians who walk "
        "this path develop the raw physical power to shatter stone barehanded, "
        "building devastating attack and damage from the bones of the earth.");
    Source("Guardian of Khazurath");
    addResearchElement("/guilds/guardian-of-khazurath/strength/root.lpc");
    TreeRoot("/guilds/guardian-of-khazurath/strength/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyFifthLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
