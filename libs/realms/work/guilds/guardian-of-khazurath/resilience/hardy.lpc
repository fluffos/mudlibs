inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Hardy");
    addSpecification("source", "Guardian of Khazurath");
    addSpecification("description", "This skill provides the user with the knowledge of a hardy dwarven constitution that shrugs off minor harm.");

    addPrerequisite("/guilds/guardian-of-khazurath/resilience/root.lpc",
        (["type": "research"]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "Guardian of Khazurath",
            "value": 1
        ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus hit points", 10);
    addSpecification("bonus constitution", 1);
}
