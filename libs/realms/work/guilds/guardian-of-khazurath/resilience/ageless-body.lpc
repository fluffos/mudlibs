inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Ageless Body");
    addSpecification("source", "Guardian of Khazurath");
    addSpecification("description", "This skill provides the user with knowledge of an ageless body - flesh that has stopped aging and begun to harden like ancient stone.");

    addPrerequisite("/guilds/guardian-of-khazurath/resilience/immortal-fortress.lpc",
        (["type": "research"]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "Guardian of Khazurath",
            "value": 52
        ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus constitution", 4);
    addSpecification("bonus soak", 5);
    addSpecification("bonus hit points", 60);
}
