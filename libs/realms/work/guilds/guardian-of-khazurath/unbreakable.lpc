/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Unbreakable");
    Description("The ultimate expression of dwarven endurance. Guardians who "
        "walk this path become virtually impossible to destroy, building will, "
        "constitution, and hit points to legendary heights.");
    Source("Guardian of Khazurath");
    addResearchElement("/guilds/guardian-of-khazurath/unbreakable/root.lpc");
    TreeRoot("/guilds/guardian-of-khazurath/unbreakable/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    TwentyFirstLevel();
    TwentyFifthLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    FortyFirstLevel();
    FortyFifthLevel();
    FortyNinthLevel();
    FiftyThirdLevel();
    FiftySeventhLevel();
    SixtySecondLevel();
    SixtyFifthLevel();
    SeventhiethLevel();
}
