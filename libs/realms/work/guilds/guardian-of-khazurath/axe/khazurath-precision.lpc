inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Khazurath Precision");
    addSpecification("source", "Guardian of Khazurath");
    addSpecification("description", "This skill provides the user with the "
        "knowledge of the ancient axe-craft of Khazurath itself, the "
        "pinnacle of cutting technique passed down from the first weaponmasters.");

    addPrerequisite("level",
        (["type": "level",
            "guild": "Guardian of Khazurath",
            "value": 31
        ]));
    addPrerequisite("/guilds/guardian-of-khazurath/axe/deep-rend.lpc",
        (["type": "research"]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Cleave": 25,
        "Rending Blow": 25,
        "Brutal Cleave": 30,
        "Headsman's Arc": 30,
        "Mountain Strike": 30,
    ]));
    addSpecification("affected research type", "percentage");
}
