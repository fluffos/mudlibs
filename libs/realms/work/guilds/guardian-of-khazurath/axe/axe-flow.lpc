inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Axe Flow");
    addSpecification("source", "Guardian of Khazurath");
    addSpecification("description", "This skill provides the user with the "
        "knowledge of a seamless combat flow where each axe strike flows "
        "naturally into the next, minimizing recovery between attacks.");

    addPrerequisite("level",
        (["type": "level",
            "guild": "Guardian of Khazurath",
            "value": 33
        ]));
    addPrerequisite("/guilds/guardian-of-khazurath/axe/dwarven-haste.lpc",
        (["type": "research"]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Cleave": 10,
        "Rending Blow": 10,
        "Brutal Cleave": 10,
        "Headsman's Arc": 15,
        "Mountain Strike": 15,
    ]));
    addSpecification("affected research type", "decrease cooldown");
}
