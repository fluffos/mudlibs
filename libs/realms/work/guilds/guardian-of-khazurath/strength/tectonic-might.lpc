inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Tectonic Might");
    addSpecification("source", "Guardian of Khazurath");
    addSpecification("description", "This skill provides the user with knowledge of tectonic might - the accumulated force of shifting mountain plates.");

    addPrerequisite("/guilds/guardian-of-khazurath/strength/geological-force.lpc",
        (["type": "research"]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "Guardian of Khazurath",
            "value": 29
        ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus strength", 4);
    addSpecification("bonus damage", 5);
}
