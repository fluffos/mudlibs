inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Oath of Valor");
    addSpecification("source", "Guardian of Khazurath");
    addSpecification("description", "This skill provides the user with knowledge of the oath of valor - a sworn promise to face any foe without flinching.");

    addPrerequisite("/guilds/guardian-of-khazurath/oaths/oath-of-battle.lpc",
        (["type": "research"]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "Guardian of Khazurath",
            "value": 7
        ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus attack", 2);
    addSpecification("bonus damage", 2);
}
