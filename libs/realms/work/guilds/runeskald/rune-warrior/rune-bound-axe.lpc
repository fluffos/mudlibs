inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Rune-Bound Axe");
    addSpecification("source", "runeskald");
    addSpecification("description", "The runeskald etches runes into the "
        "haft of their axe, binding the weapon to their will. Passively "
        "improves axe skill.");

    addPrerequisite("/guilds/runeskald/rune-warrior/root.lpc",
        (["type": "research"]));

    addSpecification("limited by", (["equipment": ({
        "axe" })]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus axe", 5);
}
