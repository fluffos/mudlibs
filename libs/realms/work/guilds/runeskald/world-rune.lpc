inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/runeskald/world-rune/world-rune-lore.lpc");

    addChild("/guilds/runeskald/world-rune/world-rune-lore.lpc",
        "/guilds/runeskald/world-rune/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/runeskald/world-rune/rune-of-unmaking.lpc");
    addResearchElement("/guilds/runeskald/world-rune/rune-of-forging.lpc");
    addResearchElement("/guilds/runeskald/world-rune/world-rune-attunement.lpc");

    addChild("/guilds/runeskald/world-rune/rune-of-unmaking.lpc",
        "/guilds/runeskald/world-rune/world-rune-lore.lpc");
    addChild("/guilds/runeskald/world-rune/rune-of-forging.lpc",
        "/guilds/runeskald/world-rune/world-rune-lore.lpc");
    addChild("/guilds/runeskald/world-rune/world-rune-attunement.lpc",
        "/guilds/runeskald/world-rune/world-rune-lore.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/runeskald/world-rune/rune-of-sundering.lpc");
    addResearchElement("/guilds/runeskald/world-rune/rune-of-binding-flesh.lpc");
    addResearchElement("/guilds/runeskald/world-rune/rune-of-the-world-flame.lpc");
    addResearchElement("/guilds/runeskald/world-rune/world-rune-conduit.lpc");

    addChild("/guilds/runeskald/world-rune/rune-of-sundering.lpc",
        "/guilds/runeskald/world-rune/rune-of-unmaking.lpc");
    addChild("/guilds/runeskald/world-rune/rune-of-binding-flesh.lpc",
        "/guilds/runeskald/world-rune/rune-of-forging.lpc");
    addChild("/guilds/runeskald/world-rune/rune-of-the-world-flame.lpc",
        "/guilds/runeskald/world-rune/world-rune-attunement.lpc");
    addChild("/guilds/runeskald/world-rune/world-rune-conduit.lpc",
        "/guilds/runeskald/world-rune/world-rune-attunement.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/runeskald/world-rune/world-rune-aegis.lpc");
    addResearchElement("/guilds/runeskald/world-rune/world-rune-permanence.lpc");
    addResearchElement("/guilds/runeskald/world-rune/rune-of-the-world-frost.lpc");

    addChild("/guilds/runeskald/world-rune/world-rune-aegis.lpc",
        "/guilds/runeskald/world-rune/rune-of-sundering.lpc");
    addChild("/guilds/runeskald/world-rune/world-rune-permanence.lpc",
        "/guilds/runeskald/world-rune/rune-of-binding-flesh.lpc");
    addChild("/guilds/runeskald/world-rune/rune-of-the-world-frost.lpc",
        "/guilds/runeskald/world-rune/world-rune-conduit.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/runeskald/world-rune/world-rune-devastation.lpc");
    addResearchElement("/guilds/runeskald/world-rune/world-rune-resilience.lpc");

    addChild("/guilds/runeskald/world-rune/world-rune-devastation.lpc",
        "/guilds/runeskald/world-rune/world-rune-aegis.lpc");
    addChild("/guilds/runeskald/world-rune/world-rune-resilience.lpc",
        "/guilds/runeskald/world-rune/world-rune-aegis.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SixthLevel()
{
    addResearchElement("/guilds/runeskald/world-rune/world-rune-torrent.lpc");

    addChild("/guilds/runeskald/world-rune/world-rune-torrent.lpc",
        "/guilds/runeskald/world-rune/world-rune-devastation.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/runeskald/world-rune/primal-rune-mastery.lpc");

    addChild("/guilds/runeskald/world-rune/primal-rune-mastery.lpc",
        "/guilds/runeskald/world-rune/world-rune-torrent.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EighthLevel()
{
    addResearchElement("/guilds/runeskald/world-rune/world-singers-transcendence.lpc");

    addChild("/guilds/runeskald/world-rune/world-singers-transcendence.lpc",
        "/guilds/runeskald/world-rune/primal-rune-mastery.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("World Rune");
    Source("runeskald");
    Description("This tree covers the most powerful runic inscriptions, "
        "tapping into the primal forces of the world itself.");

    addResearchElement("/guilds/runeskald/world-rune/root.lpc");
    TreeRoot("/guilds/runeskald/world-rune/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
    SixthLevel();
    SeventhLevel();
    EighthLevel();
}
