inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/runeskald/runic-binding/bind-rune-of-warding.lpc");
    addResearchElement("/guilds/runeskald/runic-binding/bind-rune-of-fury.lpc");
    addResearchElement("/guilds/runeskald/runic-binding/bind-rune-of-endurance.lpc");

    addChild("/guilds/runeskald/runic-binding/bind-rune-of-warding.lpc",
        "/guilds/runeskald/runic-binding/root.lpc");
    addChild("/guilds/runeskald/runic-binding/bind-rune-of-fury.lpc",
        "/guilds/runeskald/runic-binding/root.lpc");
    addChild("/guilds/runeskald/runic-binding/bind-rune-of-endurance.lpc",
        "/guilds/runeskald/runic-binding/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/runeskald/runic-binding/runic-flesh.lpc");
    addResearchElement("/guilds/runeskald/runic-binding/runic-striking.lpc");
    addResearchElement("/guilds/runeskald/runic-binding/runic-endurance-mastery.lpc");
    addResearchElement("/guilds/runeskald/runic-binding/spell-rune-inscription.lpc");

    addChild("/guilds/runeskald/runic-binding/runic-flesh.lpc",
        "/guilds/runeskald/runic-binding/bind-rune-of-warding.lpc");
    addChild("/guilds/runeskald/runic-binding/runic-striking.lpc",
        "/guilds/runeskald/runic-binding/bind-rune-of-fury.lpc");
    addChild("/guilds/runeskald/runic-binding/runic-endurance-mastery.lpc",
        "/guilds/runeskald/runic-binding/bind-rune-of-endurance.lpc");
    addChild("/guilds/runeskald/runic-binding/spell-rune-inscription.lpc",
        "/guilds/runeskald/runic-binding/bind-rune-of-warding.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/runeskald/runic-binding/rune-locked-ward.lpc");
    addResearchElement("/guilds/runeskald/runic-binding/runic-battle-fury.lpc");
    addResearchElement("/guilds/runeskald/runic-binding/spell-rune-mastery.lpc");

    addChild("/guilds/runeskald/runic-binding/rune-locked-ward.lpc",
        "/guilds/runeskald/runic-binding/runic-flesh.lpc");
    addChild("/guilds/runeskald/runic-binding/runic-battle-fury.lpc",
        "/guilds/runeskald/runic-binding/runic-striking.lpc");
    addChild("/guilds/runeskald/runic-binding/spell-rune-mastery.lpc",
        "/guilds/runeskald/runic-binding/spell-rune-inscription.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/runeskald/runic-binding/binding-mastery.lpc");

    addChild("/guilds/runeskald/runic-binding/binding-mastery.lpc",
        "/guilds/runeskald/runic-binding/rune-locked-ward.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/runeskald/runic-binding/rune-scarred-hide.lpc");
    addResearchElement("/guilds/runeskald/runic-binding/rune-burst.lpc");

    addChild("/guilds/runeskald/runic-binding/rune-scarred-hide.lpc",
        "/guilds/runeskald/runic-binding/binding-mastery.lpc");
    addChild("/guilds/runeskald/runic-binding/rune-burst.lpc",
        "/guilds/runeskald/runic-binding/binding-mastery.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SixthLevel()
{
    addResearchElement("/guilds/runeskald/runic-binding/rune-body-convergence.lpc");

    addChild("/guilds/runeskald/runic-binding/rune-body-convergence.lpc",
        "/guilds/runeskald/runic-binding/rune-scarred-hide.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/runeskald/runic-binding/full-runic-awakening.lpc");

    addChild("/guilds/runeskald/runic-binding/full-runic-awakening.lpc",
        "/guilds/runeskald/runic-binding/rune-body-convergence.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Runic Binding");
    Source("runeskald");
    Description("This tree covers the art of inscribing sustained runes "
        "directly onto the body, granting ongoing effects of protection, "
        "fury, and endurance.");

    addResearchElement("/guilds/runeskald/runic-binding/root.lpc");
    TreeRoot("/guilds/runeskald/runic-binding/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
    SixthLevel();
    SeventhLevel();
}
