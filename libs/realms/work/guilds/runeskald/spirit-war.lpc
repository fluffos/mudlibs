inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/runeskald/spirit-war/call-warrior-spirit.lpc");
    addResearchElement("/guilds/runeskald/spirit-war/call-shield-spirit.lpc");

    addChild("/guilds/runeskald/spirit-war/call-warrior-spirit.lpc",
        "/guilds/runeskald/spirit-war/root.lpc");
    addChild("/guilds/runeskald/spirit-war/call-shield-spirit.lpc",
        "/guilds/runeskald/spirit-war/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SecondLevel()
{
    addResearchElement("/guilds/runeskald/spirit-war/spirit-weapon-strike.lpc");
    addResearchElement("/guilds/runeskald/spirit-war/spirit-hardening.lpc");
    addResearchElement("/guilds/runeskald/spirit-war/spirit-armor.lpc");

    addChild("/guilds/runeskald/spirit-war/spirit-weapon-strike.lpc",
        "/guilds/runeskald/spirit-war/call-warrior-spirit.lpc");
    addChild("/guilds/runeskald/spirit-war/spirit-hardening.lpc",
        "/guilds/runeskald/spirit-war/call-shield-spirit.lpc");
    addChild("/guilds/runeskald/spirit-war/spirit-armor.lpc",
        "/guilds/runeskald/spirit-war/call-shield-spirit.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/runeskald/spirit-war/spirit-rend.lpc");
    addResearchElement("/guilds/runeskald/spirit-war/guardian-spirit-surge.lpc");
    addResearchElement("/guilds/runeskald/spirit-war/ancestors-war-cry.lpc");

    addChild("/guilds/runeskald/spirit-war/spirit-rend.lpc",
        "/guilds/runeskald/spirit-war/spirit-weapon-strike.lpc");
    addChild("/guilds/runeskald/spirit-war/guardian-spirit-surge.lpc",
        "/guilds/runeskald/spirit-war/spirit-hardening.lpc");
    addChild("/guilds/runeskald/spirit-war/ancestors-war-cry.lpc",
        "/guilds/runeskald/spirit-war/spirit-weapon-strike.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FourthLevel()
{
    addResearchElement("/guilds/runeskald/spirit-war/warrior-spirit-bond.lpc");
    addResearchElement("/guilds/runeskald/spirit-war/spirit-stamina.lpc");
    addResearchElement("/guilds/runeskald/spirit-war/spirit-storm.lpc");

    addChild("/guilds/runeskald/spirit-war/warrior-spirit-bond.lpc",
        "/guilds/runeskald/spirit-war/spirit-rend.lpc");
    addChild("/guilds/runeskald/spirit-war/spirit-stamina.lpc",
        "/guilds/runeskald/spirit-war/warrior-spirit-bond.lpc");
    addChild("/guilds/runeskald/spirit-war/spirit-storm.lpc",
        "/guilds/runeskald/spirit-war/ancestors-war-cry.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/runeskald/spirit-war/spirit-war-mastery.lpc");

    addChild("/guilds/runeskald/spirit-war/spirit-war-mastery.lpc",
        "/guilds/runeskald/spirit-war/spirit-storm.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SixthLevel()
{
    addResearchElement("/guilds/runeskald/spirit-war/twin-spirit-aspect.lpc");
    addResearchElement("/guilds/runeskald/spirit-war/spirit-volley.lpc");

    addChild("/guilds/runeskald/spirit-war/twin-spirit-aspect.lpc",
        "/guilds/runeskald/spirit-war/spirit-war-mastery.lpc");
    addChild("/guilds/runeskald/spirit-war/spirit-volley.lpc",
        "/guilds/runeskald/spirit-war/spirit-war-mastery.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/runeskald/spirit-war/eternal-war-spirit.lpc");

    addChild("/guilds/runeskald/spirit-war/eternal-war-spirit.lpc",
        "/guilds/runeskald/spirit-war/twin-spirit-aspect.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spirit War");
    Source("runeskald");
    Description("This tree covers the summoning and commanding of "
        "ancestral warrior spirits to fight alongside the runeskald.");

    addResearchElement("/guilds/runeskald/spirit-war/root.lpc");
    TreeRoot("/guilds/runeskald/spirit-war/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
    SixthLevel();
    SeventhLevel();
}
