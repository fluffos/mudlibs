inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Craft Ancient Blade Rune");
    addSpecification("source", "runeskald");
    addSpecification("description", "This skill provides the user with the "
        "knowledge to carve and charge an ancient blade rune.");

    addPrerequisite("level",
        (["type": "level", "guild": "runeskald", "value": 17]));
    addPrerequisite("/guilds/runeskald/rune-crafting/ancient-rune-crafting.lpc",
        (["type": "research"]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);}
