inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Craft Basic Ward Rune");
    addSpecification("source", "runeskald");
    addSpecification("description", "This skill provides the user with the "
        "knowledge to carve and charge a basic ward rune, which enhances "
        "the armor class and physical resistance of the item it is fused into.");

    addPrerequisite("level",
        (["type": "level", "guild": "runeskald", "value": 1]));
    addPrerequisite("/guilds/runeskald/rune-crafting/root.lpc",
        (["type": "research"]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);}
