inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/aeromancer/functions/shock.lpc");
    addResearchElement("/guilds/aeromancer/functions/air.lpc");

    addChild("/guilds/aeromancer/functions/shock.lpc",
        "/guilds/aeromancer/functions/root.lpc");
    addChild("/guilds/aeromancer/functions/air.lpc",
        "/guilds/aeromancer/functions/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/aeromancer/functions/wind.lpc");

    addChild("/guilds/aeromancer/functions/wind.lpc",
        "/guilds/aeromancer/functions/air.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/aeromancer/functions/thunder.lpc");

    addChild("/guilds/aeromancer/functions/thunder.lpc",
        "/guilds/aeromancer/functions/air.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/aeromancer/functions/lightning.lpc");

    addChild("/guilds/aeromancer/functions/lightning.lpc",
        "/guilds/aeromancer/functions/shock.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/aeromancer/functions/chill.lpc");

    addChild("/guilds/aeromancer/functions/chill.lpc",
        "/guilds/aeromancer/functions/wind.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/aeromancer/functions/vacuum.lpc");

    addChild("/guilds/aeromancer/functions/vacuum.lpc",
        "/guilds/aeromancer/functions/wind.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/aeromancer/functions/pressure.lpc");

    addChild("/guilds/aeromancer/functions/pressure.lpc",
        "/guilds/aeromancer/functions/vacuum.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/aeromancer/functions/storm.lpc");

    addChild("/guilds/aeromancer/functions/storm.lpc",
        "/guilds/aeromancer/functions/lightning.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/aeromancer/functions/plasma.lpc");

    addChild("/guilds/aeromancer/functions/plasma.lpc",
        "/guilds/aeromancer/functions/storm.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Kinetics");
    Description("This research tree provides knowledge of the various damage "
        "types and propulsion mechanisms for constructed aeromancer spells.");
    Source("aeromancer");
    addResearchElement("/guilds/aeromancer/functions/root.lpc");
    TreeRoot("/guilds/aeromancer/functions/root.lpc");

    FirstLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    TwentyFirstLevel();
}
