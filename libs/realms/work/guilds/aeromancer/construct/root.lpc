inherit "/lib/modules/research/constructedActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Constructed Aeromancer Spells");
    addSpecification("source", "aeromancer");
    addSpecification("description", "This skill provides the user with the "
        "knowledge of casting constructed spells that can provide "
        "complex effects.");

    addSpecification("constructed rules", ([
        "form must include only one of": ({
            "/guilds/aeromancer/forms/arc.lpc",
            "/guilds/aeromancer/forms/ball.lpc",
            "/guilds/aeromancer/forms/blade.lpc",
            "/guilds/aeromancer/forms/blast.lpc",
            "/guilds/aeromancer/forms/bolt.lpc",
            "/guilds/aeromancer/forms/breath.lpc",
            "/guilds/aeromancer/forms/cage.lpc",
            "/guilds/aeromancer/forms/coil.lpc",
            "/guilds/aeromancer/forms/cyclone.lpc",
            "/guilds/aeromancer/forms/eruption.lpc",
            "/guilds/aeromancer/forms/gust.lpc",
            "/guilds/aeromancer/forms/lance.lpc",
            "/guilds/aeromancer/forms/mist.lpc",
            "/guilds/aeromancer/forms/nova.lpc",
            "/guilds/aeromancer/forms/orb.lpc",
            "/guilds/aeromancer/forms/pulse.lpc",
            "/guilds/aeromancer/forms/razor.lpc",
            "/guilds/aeromancer/forms/ring.lpc",
            "/guilds/aeromancer/forms/spark.lpc",
            "/guilds/aeromancer/forms/spear.lpc",
            "/guilds/aeromancer/forms/strike.lpc",
            "/guilds/aeromancer/forms/tornado.lpc",
            "/guilds/aeromancer/forms/touch.lpc",
            "/guilds/aeromancer/forms/vortex.lpc",
            "/guilds/aeromancer/forms/wall.lpc",
            "/guilds/aeromancer/forms/wave.lpc",
            "/guilds/aeromancer/forms/whip.lpc",
        }),
        "function must include only one of": ({
            "/guilds/aeromancer/functions/lightning.lpc",
            "/guilds/aeromancer/functions/shock.lpc",
            "/guilds/aeromancer/functions/air.lpc",
            "/guilds/aeromancer/functions/storm.lpc",
            "/guilds/aeromancer/functions/vacuum.lpc",
            "/guilds/aeromancer/functions/wind.lpc",
            "/guilds/aeromancer/functions/thunder.lpc",
            "/guilds/aeromancer/functions/chill.lpc",
            "/guilds/aeromancer/functions/pressure.lpc",
            "/guilds/aeromancer/functions/plasma.lpc",
        }),
        "effect must include any of": ({
            "/guilds/aeromancer/effects/damage-hp.lpc",
            "/guilds/aeromancer/effects/damage-sp.lpc",
            "/guilds/aeromancer/effects/damage-stamina.lpc",
            "/guilds/aeromancer/effects/add-hp.lpc",
            "/guilds/aeromancer/effects/add-sp.lpc",
            "/guilds/aeromancer/effects/add-stamina.lpc",
            "/guilds/aeromancer/effects/siphon-hp.lpc",
            "/guilds/aeromancer/effects/siphon-sp.lpc",
            "/guilds/aeromancer/effects/siphon-stamina.lpc",
            "/guilds/aeromancer/effects/enhance-attack.lpc",
            "/guilds/aeromancer/effects/enhance-damage.lpc",
            "/guilds/aeromancer/effects/enhance-defense.lpc",
            "/guilds/aeromancer/effects/enhance-soak.lpc",
            "/guilds/aeromancer/effects/enhance-dodge.lpc",
            "/guilds/aeromancer/effects/enhance-parry.lpc",
            "/guilds/aeromancer/effects/enhance-speed.lpc",
            "/guilds/aeromancer/effects/reduce-attack.lpc",
            "/guilds/aeromancer/effects/reduce-damage.lpc",
            "/guilds/aeromancer/effects/reduce-defense.lpc",
            "/guilds/aeromancer/effects/reduce-soak.lpc",
            "/guilds/aeromancer/effects/reduce-dodge.lpc",
            "/guilds/aeromancer/effects/reduce-parry.lpc",
            "/guilds/aeromancer/effects/apply-slow.lpc",
            "/guilds/aeromancer/effects/apply-enfeebled.lpc",
            "/guilds/aeromancer/effects/staggering-damage.lpc",
            "/guilds/aeromancer/effects/debilitating-damage.lpc",
            "/guilds/aeromancer/effects/disorienting-damage.lpc",
            "/guilds/aeromancer/effects/hampering-damage.lpc",
            "/guilds/aeromancer/effects/exhausting-damage.lpc",
            "/guilds/aeromancer/effects/invigorating-siphon.lpc",
            "/guilds/aeromancer/effects/fortifying-siphon.lpc",
        }),
    ]));

    addSpecification("cooldown", 60);
    addSpecification("cooldown modifiers", ([
        "/guilds/aeromancer/construct/efficient-casting.lpc": 10,
        "/guilds/aeromancer/construct/improved-efficiency.lpc": 10,
        "/guilds/aeromancer/construct/expert-efficiency.lpc": 10,
        "/guilds/aeromancer/construct/master-efficiency.lpc": 10,
        "/guilds/aeromancer/construct/grandmaster-efficiency.lpc": 5,
        "/guilds/aeromancer/construct/legendary-efficiency.lpc": 5,
    ]));

    addSpecification("scope", "area");
    addSpecification("research type", "tree root");
    addSpecification("command name", "cast");
    addSpecification("command template", "cast aeromancer ##Value##");
    addSpecification("use ability message", "##InitiatorName## "
        "##Infinitive::cast## a spell...");
}
