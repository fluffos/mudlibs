    addSpecification("spell point cost", 200);
    addSpecification("spell point cost modifiers", ([
        "/guilds/aeromancer/lightning/boltmasters-reserve.lpc": 10,
        "/guilds/aeromancer/lightning/boltmasters-call.lpc": 10,
        "/guilds/aeromancer/lightning/boltmasters-might.lpc": 10,
        "/guilds/aeromancer/lightning/boltmasters-fury.lpc": 10
    ]));

    addSpecification("cooldown", 100);
    addSpecification("cooldown modifiers", ([
        "/guilds/aeromancer/lightning/boltmasters-boon.lpc": 10,
        "/guilds/aeromancer/lightning/boltmasters-finess.lpc": 10,
        "/guilds/aeromancer/lightning/boltmasters-endurance.lpc": 10,
        "/guilds/aeromancer/lightning/boltmasters-strength.lpc": 10,
