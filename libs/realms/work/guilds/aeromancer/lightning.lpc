/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Path of Lightning");
    Description("This research tree provides knowledge of lightning-based "
        "spells and abilities for the aeromancer.");
    Source("aeromancer");
    addResearchElement("/guilds/aeromancer/lightning/root.lpc");
    TreeRoot("/guilds/aeromancer/lightning/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFirstLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FiftyFirstLevel();
    FiftySeventhLevel();
    SixtyThirdLevel();
    SixtySeventhLevel();
}
