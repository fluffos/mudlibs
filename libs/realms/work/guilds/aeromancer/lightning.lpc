inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/aeromancer/lightning/shock.lpc");

    addChild("/guilds/aeromancer/lightning/shock.lpc",
        "/guilds/aeromancer/lightning/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
