inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/aeromancer/forms/arc.lpc");
    addResearchElement("/guilds/aeromancer/forms/touch.lpc");
    addResearchElement("/guilds/aeromancer/forms/gust.lpc");

    addChild("/guilds/aeromancer/forms/arc.lpc",
        "/guilds/aeromancer/forms/root.lpc");
    addChild("/guilds/aeromancer/forms/touch.lpc",
        "/guilds/aeromancer/forms/root.lpc");
    addChild("/guilds/aeromancer/forms/gust.lpc",
        "/guilds/aeromancer/forms/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/aeromancer/forms/bolt.lpc");
    addResearchElement("/guilds/aeromancer/forms/mist.lpc");
    addResearchElement("/guilds/aeromancer/forms/spark.lpc");

    addChild("/guilds/aeromancer/forms/bolt.lpc",
        "/guilds/aeromancer/forms/arc.lpc");
    addChild("/guilds/aeromancer/forms/mist.lpc",
        "/guilds/aeromancer/forms/touch.lpc");
    addChild("/guilds/aeromancer/forms/spark.lpc",
        "/guilds/aeromancer/forms/gust.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/aeromancer/forms/blade.lpc");
    addResearchElement("/guilds/aeromancer/forms/whip.lpc");

    addChild("/guilds/aeromancer/forms/blade.lpc",
        "/guilds/aeromancer/forms/bolt.lpc");
    addChild("/guilds/aeromancer/forms/whip.lpc",
        "/guilds/aeromancer/forms/spark.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/aeromancer/forms/ball.lpc");
    addResearchElement("/guilds/aeromancer/forms/spear.lpc");
    addResearchElement("/guilds/aeromancer/forms/breath.lpc");

    addChild("/guilds/aeromancer/forms/ball.lpc",
        "/guilds/aeromancer/forms/bolt.lpc");
    addChild("/guilds/aeromancer/forms/spear.lpc",
        "/guilds/aeromancer/forms/blade.lpc");
    addChild("/guilds/aeromancer/forms/breath.lpc",
        "/guilds/aeromancer/forms/mist.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/aeromancer/forms/blast.lpc");
    addResearchElement("/guilds/aeromancer/forms/wave.lpc");
    addResearchElement("/guilds/aeromancer/forms/razor.lpc");

    addChild("/guilds/aeromancer/forms/blast.lpc",
        "/guilds/aeromancer/forms/ball.lpc");
    addChild("/guilds/aeromancer/forms/wave.lpc",
        "/guilds/aeromancer/forms/mist.lpc");
    addChild("/guilds/aeromancer/forms/razor.lpc",
        "/guilds/aeromancer/forms/whip.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/aeromancer/forms/orb.lpc");
    addResearchElement("/guilds/aeromancer/forms/ring.lpc");

    addChild("/guilds/aeromancer/forms/orb.lpc",
        "/guilds/aeromancer/forms/blast.lpc");
    addChild("/guilds/aeromancer/forms/ring.lpc",
        "/guilds/aeromancer/forms/wave.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/aeromancer/forms/wall.lpc");
    addResearchElement("/guilds/aeromancer/forms/cage.lpc");
    addResearchElement("/guilds/aeromancer/forms/lance.lpc");

    addChild("/guilds/aeromancer/forms/wall.lpc",
        "/guilds/aeromancer/forms/wave.lpc");
    addChild("/guilds/aeromancer/forms/cage.lpc",
        "/guilds/aeromancer/forms/ring.lpc");
    addChild("/guilds/aeromancer/forms/lance.lpc",
        "/guilds/aeromancer/forms/spear.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/aeromancer/forms/eruption.lpc");
    addResearchElement("/guilds/aeromancer/forms/strike.lpc");

    addChild("/guilds/aeromancer/forms/eruption.lpc",
        "/guilds/aeromancer/forms/orb.lpc");
    addChild("/guilds/aeromancer/forms/strike.lpc",
        "/guilds/aeromancer/forms/lance.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/aeromancer/forms/coil.lpc");
    addResearchElement("/guilds/aeromancer/forms/vortex.lpc");

    addChild("/guilds/aeromancer/forms/coil.lpc",
        "/guilds/aeromancer/forms/cage.lpc");
    addChild("/guilds/aeromancer/forms/vortex.lpc",
        "/guilds/aeromancer/forms/eruption.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/aeromancer/forms/pulse.lpc");
    addResearchElement("/guilds/aeromancer/forms/cyclone.lpc");

    addChild("/guilds/aeromancer/forms/pulse.lpc",
        "/guilds/aeromancer/forms/coil.lpc");
    addChild("/guilds/aeromancer/forms/cyclone.lpc",
        "/guilds/aeromancer/forms/vortex.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/aeromancer/forms/nova.lpc");

    addChild("/guilds/aeromancer/forms/nova.lpc",
        "/guilds/aeromancer/forms/strike.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyThirdLevel()
{
    addResearchElement("/guilds/aeromancer/forms/tornado.lpc");

    addChild("/guilds/aeromancer/forms/tornado.lpc",
        "/guilds/aeromancer/forms/cyclone.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Forms");
    Description("This research tree provides knowledge of the various forms "
        "that constructed aeromancer spells can take.");
    Source("aeromancer");
    addResearchElement("/guilds/aeromancer/forms/root.lpc");
    TreeRoot("/guilds/aeromancer/forms/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
}
