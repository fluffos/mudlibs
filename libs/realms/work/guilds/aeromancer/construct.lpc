inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/aeromancer/construct/construct-spell.lpc");

    addChild("/guilds/aeromancer/construct/construct-spell.lpc",
        "/guilds/aeromancer/construct/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/aeromancer/construct/efficient-casting.lpc");

    addChild("/guilds/aeromancer/construct/efficient-casting.lpc",
        "/guilds/aeromancer/construct/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/aeromancer/construct/spell-focus.lpc");

    addChild("/guilds/aeromancer/construct/spell-focus.lpc",
        "/guilds/aeromancer/construct/efficient-casting.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/aeromancer/construct/improved-efficiency.lpc");

    addChild("/guilds/aeromancer/construct/improved-efficiency.lpc",
        "/guilds/aeromancer/construct/efficient-casting.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/aeromancer/construct/enhanced-focus.lpc");

    addChild("/guilds/aeromancer/construct/enhanced-focus.lpc",
        "/guilds/aeromancer/construct/spell-focus.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/aeromancer/construct/expert-efficiency.lpc");

    addChild("/guilds/aeromancer/construct/expert-efficiency.lpc",
        "/guilds/aeromancer/construct/improved-efficiency.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFifthLevel()
{
    addResearchElement("/guilds/aeromancer/construct/spell-amplification.lpc");

    addChild("/guilds/aeromancer/construct/spell-amplification.lpc",
        "/guilds/aeromancer/construct/enhanced-focus.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyNinthLevel()
{
    addResearchElement("/guilds/aeromancer/construct/master-efficiency.lpc");

    addChild("/guilds/aeromancer/construct/master-efficiency.lpc",
        "/guilds/aeromancer/construct/expert-efficiency.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyThirdLevel()
{
    addResearchElement("/guilds/aeromancer/construct/spell-mastery.lpc");

    addChild("/guilds/aeromancer/construct/spell-mastery.lpc",
        "/guilds/aeromancer/construct/spell-amplification.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtySeventhLevel()
{
    addResearchElement("/guilds/aeromancer/construct/grandmaster-efficiency.lpc");

    addChild("/guilds/aeromancer/construct/grandmaster-efficiency.lpc",
        "/guilds/aeromancer/construct/master-efficiency.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FortyFirstLevel()
{
    addResearchElement("/guilds/aeromancer/construct/arcane-precision.lpc");

    addChild("/guilds/aeromancer/construct/arcane-precision.lpc",
        "/guilds/aeromancer/construct/spell-mastery.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FortyFifthLevel()
{
    addResearchElement("/guilds/aeromancer/construct/legendary-efficiency.lpc");

    addChild("/guilds/aeromancer/construct/legendary-efficiency.lpc",
