inherit "/lib/modules/research/instantaneousActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Pursuit Shot");
    addSpecification("source", "ranger");
    addSpecification("description", "This skill provides the ranger "
        "with the knowledge to fire while in relentless pursuit.");

    addPrerequisite("/guilds/ranger/wild-hunt/predators-edge.lpc",
        (["type": "research"]));

    addSpecification("limited by", (["equipment":({ "bow" })]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "ranger",
            "value": 19
        ]));

    addSpecification("scope", "targeted");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);

    addSpecification("damage hit points", ({ ([
            "probability": 80,
            "base damage": 30,
            "range": 60
        ]),
        ([
            "probability": 20,
            "base damage": 70,
            "range": 140
        ])
    }));

    addSpecification("damage type", "physical");

    addSpecification("modifiers", ({ 
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/wild-hunt/hunt-focus.lpc",
            "name": "hunt-focus",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.15
        ]),
        ([
            "type": "weapon damage",
            "name" : "bow",
            "types" : ({ "bow" }),
            "formula" : "additive",
            "rate" : 2.0
        ]),
        ([
            "type": "skill",
            "name": "bow",
            "formula": "logarithmic",
            "rate": 1.25
        ]),
        ([
            "type": "skill",
            "name": "perception",
            "formula": "additive",
            "rate": 0.15
        ]),
        ([
            "type": "skill",
            "name": "anatomy and physiology",
            "formula": "additive",
            "rate": 0.10
        ]),
        ([
            "type": "attribute",
            "name": "dexterity",
            "formula": "additive",
            "rate": 0.25
        ]),
        ([
            "type": "attribute",
            "name": "wisdom",
            "formula": "additive",
            "rate": 0.20
        ]),
    }));

    addSpecification("consumables", (["arrow": 1]));
    addSpecification("stamina point cost", 100);
    addSpecification("spell point cost", 75);
    addSpecification("cooldown", 50);

    addSpecification("event handler",
        "pursuitshotEvent");
    addSpecification("command template",
        "pursuit shot [at ##Target##]");
    addSpecification("use ability message",
        "##InitiatorPossessive::Name## ##Infinitive::fire## "
        "##InitiatorPossessive## ##InitiatorWeapon## at "
        "##TargetName## with the fury of the Wild Hunt.");
}
