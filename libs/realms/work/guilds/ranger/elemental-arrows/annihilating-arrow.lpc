inherit "/lib/modules/research/instantaneousActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Annihilating Arrow");
    addSpecification("source", "ranger");
    addSpecification("description", "This skill provides the ranger "
        "with the knowledge to fire an annihilating acid arrow.");

    addPrerequisite("/guilds/ranger/elemental-arrows/elemental-convergence.lpc",
        (["type": "research"]));

    addSpecification("limited by", (["equipment":({"bow"})]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "ranger",
            "value": 61
        ]));

    addSpecification("scope", "targeted");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);

    addSpecification("damage hit points", ({ ([
            "probability": 80,
            "base damage": 92,
            "range": 185
        ]),
        ([
            "probability": 20,
            "base damage": 195,
            "range": 390
        ])
    }));

    addSpecification("damage type", "acid");

    addSpecification("modifiers", ({ 
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/elemental-arrows/venom-lore.lpc",
            "name": "venom-lore",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/elemental-arrows/greater-venom-lore.lpc",
            "name": "greater-venom-lore",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/elemental-arrows/dissolution-mastery.lpc",
            "name": "dissolution-mastery",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/elemental-arrows/annihilation-mastery.lpc",
            "name": "annihilation-mastery",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "weapon damage",
            "name" : "bow",
            "types" : ({"bow"}),
            "formula" : "additive",
            "rate" : 1.5
        ]),
        ([
            "type": "skill",
            "name": "bow",
            "formula": "logarithmic",
            "rate": 1.15
        ]),
        ([
            "type": "skill",
            "name": "elemental earth",
            "formula": "logarithmic",
            "rate": 1.25
        ]),
        ([
            "type": "skill",
            "name": "spellcraft",
            "formula": "additive",
            "rate": 0.10
        ]),
        ([
            "type": "skill",
            "name": "magical essence",
            "formula": "additive",
            "rate": 0.10
        ]),
        ([
            "type": "skill",
            "name": "perception",
            "formula": "additive",
            "rate": 0.10
        ]),
        ([
            "type": "attribute",
            "name": "dexterity",
            "formula": "additive",
            "rate": 0.25
        ]),
        ([
            "type": "attribute",
            "name": "wisdom",
            "formula": "additive",
            "rate": 0.15
        ])
    }));

    addSpecification("consumables", (["arrow": 1]));
    addSpecification("stamina point cost", 235);
    addSpecification("spell point cost", 190);
    addSpecification("cooldown", 90);

    addSpecification("event handler", "annihilatingarrowEvent");
    addSpecification("command template", "annihilating arrow [at ##Target##]");
    addSpecification("use ability message",
        "##InitiatorPossessive::Name## ##Infinitive::fire## "
        "a acid-wreathed arrow at ##TargetName##.");
}
