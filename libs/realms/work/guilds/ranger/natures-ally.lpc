/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Nature's Ally");
    Description("This research tree provides the ranger with "
        "the ability to channel the spirits of nature's "
        "creatures, assuming stances that grant powerful "
        "combat enhancements.");
    Source("ranger");
    addResearchElement("/guilds/ranger/natures-ally/root.lpc");
    TreeRoot("/guilds/ranger/natures-ally/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FortyNinthLevel();
    FiftyFirstLevel();
    FiftyFifthLevel();
    FiftySeventhLevel();
    SixtyFirstLevel();
    SixtyFifthLevel();
    SixtySeventhLevel();
    SixtyNinthLevel();
}
