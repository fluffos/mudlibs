inherit "/lib/modules/research/instantaneousActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Sky Shot");
    addSpecification("source", "ranger");
    addSpecification("description", "This skill provides the ranger "
        "with the knowledge to fire an arrow that arcs from the sky.");

    addPrerequisite("/guilds/ranger/archery/eternal-marksman.lpc",
        (["type": "research"]));

    addSpecification("limited by", (["equipment":({"bow"})]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "ranger",
            "value": 70
        ]));

    addSpecification("scope", "targeted");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);

    addSpecification("damage hit points", ({ ([
            "probability": 80,
            "base damage": 120,
            "range": 240
        ]),
        ([
            "probability": 20,
            "base damage": 250,
            "range": 500
        ])
    }));

    addSpecification("damage type", "physical");

    addSpecification("modifiers", ({ 
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/archery/steady-shot-knowledge.lpc",
            "name": "steady-shot-knowledge",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/archery/quick-shot-knowledge.lpc",
            "name": "quick-shot-knowledge",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/archery/piercing-knowledge.lpc",
            "name": "piercing-knowledge",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/archery/lethal-focus.lpc",
            "name": "lethal-focus",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/archery/arcing-mastery.lpc",
            "name": "arcing-mastery",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "weapon damage",
            "name" : "bow",
            "types" : ({"bow"}),
            "formula" : "additive",
            "rate" : 1.75
        ]),
        ([
            "type": "skill",
            "name": "bow",
            "formula": "logarithmic",
            "rate": 1.25
        ]),
        ([
            "type": "skill",
            "name": "anatomy and physiology",
            "formula": "additive",
            "rate": 0.10
        ]),
        ([
            "type": "skill",
            "name": "perception",
            "formula": "additive",
            "rate": 0.15
        ]),
        ([
            "type": "attribute",
            "name": "dexterity",
            "formula": "additive",
            "rate": 0.25
        ]),
        ([
            "type": "attribute",
            "name": "wisdom",
            "formula": "additive",
            "rate": 0.15
        ])
    }));

    addSpecification("consumables", (["arrow": 1]));
    addSpecification("stamina point cost", 300);
    addSpecification("cooldown", 150);

    addSpecification("event handler", "skyshotEvent");
    addSpecification("command template", "sky shot [at ##Target##]");
    addSpecification("use ability message",
        "##InitiatorPossessive::Name## ##Infinitive::fire## "
        "##InitiatorPossessive## ##InitiatorWeapon## at "
        "##TargetName## with deadly precision.");
}
