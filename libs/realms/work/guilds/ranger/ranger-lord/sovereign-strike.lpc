inherit "/lib/modules/research/instantaneousActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Sovereign Strike");
    addSpecification("source", "ranger");
    addSpecification("description", "This skill provides the ranger "
        "lord with a devastating attack.");

    addPrerequisite("/guilds/ranger/ranger-lord/lords-wrath.lpc",
        (["type": "research"]));

    addSpecification("limited by", (["equipment":({"bow"})]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "ranger",
            "value": 31
        ]));

    addSpecification("scope", "targeted");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);

    addSpecification("damage hit points", ({ ([
            "probability": 80,
            "base damage": 75,
            "range": 150
        ]),
        ([
            "probability": 20,
            "base damage": 160,
            "range": 320
        ])
    }));

    addSpecification("damage type", "physical");

    addSpecification("modifiers", ({ 
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/ranger-lord/lords-focus.lpc",
            "name": "lords-focus",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/ranger-lord/lords-art.lpc",
            "name": "lords-art",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/ranger-lord/lords-mastery-lore.lpc",
            "name": "lords-mastery-lore",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/ranger-lord/supreme-lord-lore.lpc",
            "name": "supreme-lord-lore",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/ranger-lord/eternal-lord-lore.lpc",
            "name": "eternal-lord-lore",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/ranger-lord/peerless-lord-lore.lpc",
            "name": "peerless-lord-lore",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "weapon damage",
            "name" : "bow",
            "types" : ({"bow"}),
            "formula" : "additive",
            "rate" : 2.5
        ]),
        ([
            "type": "skill",
            "name": "bow",
            "formula": "logarithmic",
            "rate": 1.30
        ]),
        ([
            "type": "skill",
            "name": "perception",
            "formula": "additive",
            "rate": 0.15
        ]),
        ([
            "type": "skill",
            "name": "anatomy and physiology",
            "formula": "additive",
            "rate": 0.15
        ]),
        ([
            "type": "attribute",
            "name": "dexterity",
            "formula": "additive",
            "rate": 0.30
        ]),
        ([
            "type": "attribute",
            "name": "wisdom",
            "formula": "additive",
            "rate": 0.20
        ])
    }));

    addSpecification("consumables", (["arrow": 1]));
    addSpecification("stamina point cost", 200);
    addSpecification("spell point cost", 175);
    addSpecification("cooldown", 90);

    addSpecification("event handler", "sovereignstrikeEvent");
    addSpecification("command template", "sovereign strike [at ##Target##]");
    addSpecification("use ability message",
        "##InitiatorPossessive::Name## ##Infinitive::fire## "
        "##InitiatorPossessive## ##InitiatorWeapon## at "
        "##TargetName## with the authority of a ranger lord.");
}
