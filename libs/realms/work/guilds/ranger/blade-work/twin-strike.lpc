inherit "/lib/modules/research/instantaneousActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Twin Strike");
    addSpecification("source", "ranger");
    addSpecification("description", "This skill provides the ranger "
        "with the knowledge to strike twice in rapid succession.");

    addPrerequisite("/guilds/ranger/blade-work/twin-fang.lpc",
        (["type": "research"]));

    addSpecification("limited by",
        (["equipment":({ "short sword", "long sword", "hand and a half sword", "two-handed sword", "dagger" })]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "ranger",
            "value": 11
        ]));

    addSpecification("scope", "targeted");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);

    addSpecification("damage hit points", ({ ([
            "probability": 80,
            "base damage": 18,
            "range": 36
        ]),
        ([
            "probability": 20,
            "base damage": 40,
            "range": 80
        ])
    }));

    addSpecification("damage type", "physical");

    addSpecification("modifiers", ({ 
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/blade-work/blade-focus.lpc",
            "name": "blade-focus",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/blade-work/advanced-technique.lpc",
            "name": "advanced-technique",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/blade-work/masters-technique.lpc",
            "name": "masters-technique",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/blade-work/whirlwind-focus.lpc",
            "name": "whirlwind-focus",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/blade-work/lethal-art.lpc",
            "name": "lethal-art",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/blade-work/supreme-technique.lpc",
            "name": "supreme-technique",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item":
                "/guilds/ranger/blade-work/transcendent-technique.lpc",
            "name": "transcendent-technique",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "weapon damage",
            "name" : "blade",
            "types" : ({ "dagger", "short sword", "long sword", "hand and a half sword", "two-handed sword" }),
            "formula" : "additive",
            "rate" : 1.5
        ]),
        ([
            "type": "highest skill",
            "name": "sword skills",
            "skills": ({ "dagger", "short sword", "long sword", "hand and a half sword", "two-handed sword" }),
            "formula": "additive",
            "rate": 0.5
        ]),
        ([
            "type": "skill",
            "name": "parry",
            "formula": "additive",
            "rate": 0.10
        ]),
        ([
            "type": "skill",
            "name": "anatomy and physiology",
            "formula": "additive",
            "rate": 0.10
        ]),
        ([
            "type": "skill",
            "name": "perception",
            "formula": "additive",
            "rate": 0.10
        ]),
        ([
            "type": "attribute",
            "name": "dexterity",
            "formula": "additive",
            "rate": 0.25
        ]),
        ([
            "type": "attribute",
            "name": "strength",
            "formula": "additive",
            "rate": 0.15
        ])
    }));

    addSpecification("stamina point cost", 70);
    addSpecification("cooldown", 45);

    addSpecification("event handler", "twinstrikeEvent");
    addSpecification("command template", "twin strike [at ##Target##]");
    addSpecification("use ability message",
        "##InitiatorPossessive::Name## ##Infinitive::strike## "
        "##TargetName## with ##InitiatorPossessive## blade.");
}
