inherit "/lib/modules/research/constructedActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Constructed Pyromancer Spells");
    addSpecification("source", "pyromancer");
    addSpecification("description", "This skill provides the user with the "
        "knowledge of casting constructed spells that can provide "
        "complex effects.");

    addSpecification("constructed rules", ([
        "form must include only one of": ({
            "/guilds/pyromancer/forms/arc.lpc",
            "/guilds/pyromancer/forms/ball.lpc",
            "/guilds/pyromancer/forms/blade.lpc",
            "/guilds/pyromancer/forms/blast.lpc",
            "/guilds/pyromancer/forms/bolt.lpc",
            "/guilds/pyromancer/forms/cage.lpc",
            "/guilds/pyromancer/forms/cataclysm.lpc",
            "/guilds/pyromancer/forms/cloud.lpc",
            "/guilds/pyromancer/forms/coil.lpc",
            "/guilds/pyromancer/forms/eruption.lpc",
            "/guilds/pyromancer/forms/firestorm.lpc",
            "/guilds/pyromancer/forms/flare.lpc",
            "/guilds/pyromancer/forms/inferno.lpc",
            "/guilds/pyromancer/forms/lance.lpc",
            "/guilds/pyromancer/forms/orb.lpc",
            "/guilds/pyromancer/forms/pulse.lpc",
            "/guilds/pyromancer/forms/razor.lpc",
            "/guilds/pyromancer/forms/ring.lpc",
            "/guilds/pyromancer/forms/spark.lpc",
            "/guilds/pyromancer/forms/spear.lpc",
            "/guilds/pyromancer/forms/spray.lpc",
            "/guilds/pyromancer/forms/strike.lpc",
            "/guilds/pyromancer/forms/tendril.lpc",
            "/guilds/pyromancer/forms/touch.lpc",
            "/guilds/pyromancer/forms/vortex.lpc",
            "/guilds/pyromancer/forms/wall.lpc",
            "/guilds/pyromancer/forms/wave.lpc",
        }),
        "function must include only one of": ({
            "/guilds/pyromancer/functions/heat.lpc",
            "/guilds/pyromancer/functions/flame.lpc",
            "/guilds/pyromancer/functions/combustion.lpc",
            "/guilds/pyromancer/functions/scorch.lpc",
            "/guilds/pyromancer/functions/inferno.lpc",
            "/guilds/pyromancer/functions/smoke.lpc",
            "/guilds/pyromancer/functions/searing.lpc",
            "/guilds/pyromancer/functions/immolation.lpc",
            "/guilds/pyromancer/functions/conflagration.lpc",
            "/guilds/pyromancer/functions/magma.lpc",
            "/guilds/pyromancer/functions/hellfire.lpc",
        }),
        "effect must include any of": ({
            "/guilds/pyromancer/effects/damage-hp.lpc",
            "/guilds/pyromancer/effects/damage-sp.lpc",
            "/guilds/pyromancer/effects/damage-stamina.lpc",
            "/guilds/pyromancer/effects/add-hp.lpc",
            "/guilds/pyromancer/effects/add-sp.lpc",
            "/guilds/pyromancer/effects/add-stamina.lpc",
            "/guilds/pyromancer/effects/siphon-hp.lpc",
            "/guilds/pyromancer/effects/siphon-sp.lpc",
            "/guilds/pyromancer/effects/siphon-stamina.lpc",
            "/guilds/pyromancer/effects/enhance-attack.lpc",
            "/guilds/pyromancer/effects/enhance-damage.lpc",
            "/guilds/pyromancer/effects/enhance-defense.lpc",
            "/guilds/pyromancer/effects/enhance-soak.lpc",
            "/guilds/pyromancer/effects/enhance-dodge.lpc",
            "/guilds/pyromancer/effects/enhance-parry.lpc",
            "/guilds/pyromancer/effects/enhance-speed.lpc",
            "/guilds/pyromancer/effects/reduce-attack.lpc",
            "/guilds/pyromancer/effects/reduce-damage.lpc",
            "/guilds/pyromancer/effects/reduce-defense.lpc",
            "/guilds/pyromancer/effects/reduce-soak.lpc",
            "/guilds/pyromancer/effects/reduce-dodge.lpc",
            "/guilds/pyromancer/effects/reduce-parry.lpc",
            "/guilds/pyromancer/effects/apply-slow.lpc",
            "/guilds/pyromancer/effects/apply-enfeebled.lpc",
            "/guilds/pyromancer/effects/staggering-damage.lpc",
            "/guilds/pyromancer/effects/debilitating-damage.lpc",
            "/guilds/pyromancer/effects/disorienting-damage.lpc",
            "/guilds/pyromancer/effects/hampering-damage.lpc",
            "/guilds/pyromancer/effects/exhausting-damage.lpc",
            "/guilds/pyromancer/effects/invigorating-siphon.lpc",
            "/guilds/pyromancer/effects/fortifying-siphon.lpc",
        }),
    ]));

    addSpecification("cooldown", 60);
    addSpecification("cooldown modifiers", ([
        "/guilds/pyromancer/construct/efficient-casting.lpc": 10,
        "/guilds/pyromancer/construct/improved-efficiency.lpc": 10,
        "/guilds/pyromancer/construct/expert-efficiency.lpc": 10,
        "/guilds/pyromancer/construct/master-efficiency.lpc": 10,
        "/guilds/pyromancer/construct/grandmaster-efficiency.lpc": 5,
        "/guilds/pyromancer/construct/legendary-efficiency.lpc": 5,
    ]));

    addSpecification("scope", "area");
    addSpecification("research type", "tree root");
    addSpecification("command name", "cast");
    addSpecification("command template", "cast pyromancer ##Value##");
    addSpecification("use ability message", "##InitiatorName## "
        "##Infinitive::cast## a spell...");
}
