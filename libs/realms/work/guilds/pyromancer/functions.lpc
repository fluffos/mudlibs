inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/pyromancer/functions/heat.lpc");
    addResearchElement("/guilds/pyromancer/functions/flame.lpc");

    addChild("/guilds/pyromancer/functions/heat.lpc",
        "/guilds/pyromancer/functions/root.lpc");
    addChild("/guilds/pyromancer/functions/flame.lpc",
        "/guilds/pyromancer/functions/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/pyromancer/functions/combustion.lpc");

    addChild("/guilds/pyromancer/functions/combustion.lpc",
        "/guilds/pyromancer/functions/flame.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/pyromancer/functions/scorch.lpc");

    addChild("/guilds/pyromancer/functions/scorch.lpc",
        "/guilds/pyromancer/functions/flame.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/pyromancer/functions/inferno.lpc");

    addChild("/guilds/pyromancer/functions/inferno.lpc",
        "/guilds/pyromancer/functions/heat.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/pyromancer/functions/smoke.lpc");

    addChild("/guilds/pyromancer/functions/smoke.lpc",
        "/guilds/pyromancer/functions/combustion.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/pyromancer/functions/searing.lpc");

    addChild("/guilds/pyromancer/functions/searing.lpc",
        "/guilds/pyromancer/functions/combustion.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/pyromancer/functions/immolation.lpc");

    addChild("/guilds/pyromancer/functions/immolation.lpc",
        "/guilds/pyromancer/functions/searing.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/pyromancer/functions/conflagration.lpc");

    addChild("/guilds/pyromancer/functions/conflagration.lpc",
        "/guilds/pyromancer/functions/inferno.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/pyromancer/functions/magma.lpc");

    addChild("/guilds/pyromancer/functions/magma.lpc",
        "/guilds/pyromancer/functions/smoke.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/pyromancer/functions/hellfire.lpc");

    addChild("/guilds/pyromancer/functions/hellfire.lpc",
        "/guilds/pyromancer/functions/conflagration.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Kinetics");
    Description("This research tree provides knowledge of the various damage "
        "types and propulsion mechanisms for constructed pyromancer spells.");
    Source("pyromancer");
    addResearchElement("/guilds/pyromancer/functions/root.lpc");
    TreeRoot("/guilds/pyromancer/functions/root.lpc");

    FirstLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
}
