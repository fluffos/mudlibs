/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Path of Flame");
    Description("This research tree provides knowledge of flame-based "
        "spells and abilities for the pyromancer.");
    Source("pyromancer");
    addResearchElement("/guilds/pyromancer/flame/root.lpc");
    TreeRoot("/guilds/pyromancer/flame/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFirstLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FiftyFirstLevel();
    FiftySeventhLevel();
    SixtyThirdLevel();
    SixtySeventhLevel();
}
