inherit "/lib/modules/research/instantaneousActiveResearchItem.lpc";

protected string WeaponType = "ERROR";
protected string WeaponSkill = "unarmed";
protected string *ValidWeaponTypes = ({ });

/////////////////////////////////////////////////////////////////////////////
protected void SetupResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Blizzard");
    addSpecification("source", "Scion of Dhuras");
    addSpecification("description", "This research provides the user with the "
        "knowledge of the blizzard technique. By means of this, the "
        "Scion is able to use their weapon as a conduit for sending a storm "
        "of frigid wind and ice at all foes in the area.");
    SetupResearch();

    addPrerequisite(sprintf("/guilds/scion/paths/%s/root.lpc", WeaponType),
        (["type": "research"]));
    addPrerequisite(sprintf("/guilds/scion/paths/%s/ice/frost-wave.lpc", WeaponType),
        (["type": "research"]));
    addPrerequisite("level",
        (["type": "level",
            "guild": "Scion of Dhuras",
            "value": 37
        ]));

    addSpecification("scope", "area");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("spell point cost", 250);
    addSpecification("spell point cost modifiers", ([
        sprintf("/guilds/scion/paths/%s/ice/scions-reserve.lpc", WeaponType): 10,
        sprintf("/guilds/scion/paths/%s/ice/scions-call.lpc", WeaponType): 10,
        sprintf("/guilds/scion/paths/%s/ice/scions-might.lpc", WeaponType): 10,
        sprintf("/guilds/scion/paths/%s/ice/scions-fury.lpc", WeaponType): 10,
    ]));

    addSpecification("damage hit points", ({ ([
            "probability":90,
            "base damage" : 100,
            "range" : 200
        ]),
        ([
            "probability":10,
            "base damage" : 200,
            "range" : 500
        ])
    }));
    addSpecification("damage spell points", ({ ([
            "probability":90,
            "base damage" : 50,
            "range" : 100
        ]),
        ([
            "probability": 10,
            "base damage": 100,
            "range" : 200
        ])
    }));
    addSpecification("damage type", "cold");

    addSpecification("modifiers", ({ 
        ([
            "type": "research",
            "research item": sprintf("/guilds/scion/paths/%s/ice/chill-the-blood.lpc", WeaponType),
            "name" : "Chill the Blood",
            "formula" : "multiplicative",
            "base value" : 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item": sprintf("/guilds/scion/paths/%s/ice/freezing-mark.lpc", WeaponType),
            "name" : "Freezing Mark",
            "formula" : "multiplicative",
            "base value" : 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item": sprintf("/guilds/scion/paths/%s/ice/winters-rage.lpc", WeaponType),
            "name" : "Winter's Rage",
            "formula" : "multiplicative",
            "base value" : 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item": sprintf("/guilds/scion/paths/%s/ice/wind-chill.lpc", WeaponType),
            "name" : "Wind Chill",
            "formula" : "multiplicative",
            "base value" : 1,
            "rate": 1.35
        ]),
        ([
            "type": "research",
            "research item": sprintf("/guilds/scion/paths/%s/ice/icy-mark.lpc", WeaponType),
            "name" : "Icy Mark",
            "formula" : "multiplicative",
            "base value" : 1,
            "rate": 1.4
        ]),
        ([
            "type": "research",
            "research item": sprintf("/guilds/scion/paths/%s/ice/arctic-rage.lpc", WeaponType),
            "name" : "Arctic Rage",
            "formula" : "multiplicative",
            "base value" : 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item": sprintf("/guilds/scion/paths/%s/ice/frigid-blast.lpc", WeaponType),
            "name" : "Frigid Blast",
            "formula" : "multiplicative",
            "base value" : 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item": sprintf("/guilds/scion/paths/%s/ice/bitter-frost.lpc", WeaponType),
            "name" : "Bitter Frost",
            "formula" : "multiplicative",
            "base value" : 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item": sprintf("/guilds/scion/paths/%s/ice/crushing-chill.lpc", WeaponType),
            "name" : "Crushing Chill",
            "formula" : "multiplicative",
            "base value" : 1,
            "rate": 1.5
        ]),
        ([
            "type": "weapon damage",
            "name": WeaponSkill,
            "types": ValidWeaponTypes,
            "formula": "additive",
            "rate": 1.0
        ]),
        ([
            "type": "skill",
            "name" : WeaponSkill,
            "formula" : "additive",
            "rate" : 0.05
        ]),
        ([
            "type": "skill",
            "name" : "elemental water",
            "formula" : "additive",
            "rate" : 0.10
        ]),
        ([
            "type": "level",
            "name": "level",
            "formula": "logarithmic",
            "rate": 1.05
        ]),
        ([
            "type": "skill",
            "name": "spellcraft",
            "formula": "logarithmic",
            "rate": 1.25
        ]),
        ([
            "type": "skill",
            "name": "magical essence",
            "formula": "logarithmic",
            "rate": 1.25
        ]),
        ([
            "type": "skill",
            "name" : "physics",
            "formula" : "additive",
            "rate" : 0.10
        ]),
        ([
            "type": "skill",
            "name": "mathematics",
            "formula": "additive",
            "rate": 0.05
        ]),
        ([
            "type": "skill",
            "name": "chemistry",
            "formula": "additive",
            "rate": 0.05
        ]),
        ([
            "type": "attribute",
            "name": "intelligence",
            "formula": "additive",
            "rate": 0.05
        ]), 
        ([
            "type": "attribute",
            "name": "dexterity",
            "formula": "additive",
            "rate": 0.025
        ]), 
        ([
            "type": "attribute",
            "name": "wisdom",
            "formula": "additive",
            "rate": 0.025
        ]), 
    }));

    addSpecification("cooldown", 180);
    addSpecification("cooldown modifiers", ([
        sprintf("/guilds/scion/paths/%s/ice/scions-boon.lpc", WeaponType): 10,
        sprintf("/guilds/scion/paths/%s/ice/scions-finess.lpc", WeaponType): 10,
        sprintf("/guilds/scion/paths/%s/ice/scions-endurance.lpc", WeaponType): 10,
        sprintf("/guilds/scion/paths/%s/ice/scions-strength.lpc", WeaponType): 10,
    ]));

    addSpecification("event handler", "blizzardEvent");
    addSpecification("command template", "blizzard");
    addSpecification("use ability message",  "An intense storm of freezing shards "
        "erupt from ##InitiatorPossessive::Name## ##InitiatorWeapon##.");
}
