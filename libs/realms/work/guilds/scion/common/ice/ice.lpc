protected string WeaponType;

/////////////////////////////////////////////////////////////////////////////
protected void SetupResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
protected void AdditionalResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement(sprintf("/guilds/scion/paths/%s/ice/ice-bolt.lpc", WeaponType));
    addResearchElement(sprintf("/guilds/scion/paths/%s/ice/frost-brand.lpc", WeaponType));

    addChild(sprintf("/guilds/scion/paths/%s/ice/ice-bolt.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/ice/root.lpc", WeaponType));
    addChild(sprintf("/guilds/scion/paths/%s/ice/frost-brand.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/ice/root.lpc", WeaponType));
}

