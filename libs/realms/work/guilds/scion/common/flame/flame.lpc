inherit "/lib/modules/research/researchTree.lpc";

protected string WeaponType;

/////////////////////////////////////////////////////////////////////////////
protected void SetupResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
protected void AdditionalResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement(sprintf("/guilds/scion/paths/%s/flame/flame-bolt.lpc", WeaponType));
    addResearchElement(sprintf("/guilds/scion/paths/%s/flame/fire-brand.lpc", WeaponType));

    addChild(sprintf("/guilds/scion/paths/%s/flame/flame-bolt.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/flame/root.lpc", WeaponType));
    addChild(sprintf("/guilds/scion/paths/%s/flame/fire-brand.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/flame/root.lpc", WeaponType));
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement(sprintf("/guilds/scion/paths/%s/flame/sweeping-flames.lpc", WeaponType));

