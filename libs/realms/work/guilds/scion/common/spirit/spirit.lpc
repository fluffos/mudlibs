}

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement(sprintf("/guilds/scion/paths/%s/spirit/spirit-bolt.lpc", WeaponType));
    addResearchElement(sprintf("/guilds/scion/paths/%s/spirit/soul-brand.lpc", WeaponType));

    addChild(sprintf("/guilds/scion/paths/%s/spirit/spirit-bolt.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/spirit/root.lpc", WeaponType));
    addChild(sprintf("/guilds/scion/paths/%s/spirit/soul-brand.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/spirit/root.lpc", WeaponType));
}

