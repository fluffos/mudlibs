    addChild(sprintf("/guilds/scion/paths/%s/electricity/shocking-tendrils.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/electricity/shockstrike.lpc", WeaponType));
    addChild(sprintf("/guilds/scion/paths/%s/electricity/nosave-charge.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/electricity/sparks.lpc", WeaponType));
}

