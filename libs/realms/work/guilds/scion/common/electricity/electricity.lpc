inherit "/lib/modules/research/researchTree.lpc";

protected string WeaponType;

/////////////////////////////////////////////////////////////////////////////
protected void SetupResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
protected void AdditionalResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement(sprintf("/guilds/scion/paths/%s/electricity/sparks.lpc", WeaponType));
    addResearchElement(sprintf("/guilds/scion/paths/%s/electricity/shockstrike.lpc", WeaponType));

    addChild(sprintf("/guilds/scion/paths/%s/electricity/sparks.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/electricity/root.lpc", WeaponType));
    addChild(sprintf("/guilds/scion/paths/%s/electricity/shockstrike.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/electricity/root.lpc", WeaponType));
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
