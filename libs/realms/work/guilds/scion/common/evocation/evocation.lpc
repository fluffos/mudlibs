    addChild(sprintf("/guilds/scion/paths/%s/evocation/eviscerating-tendrils.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/evocation/magical-strike.lpc", WeaponType));
    addChild(sprintf("/guilds/scion/paths/%s/evocation/mystic-charge.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/evocation/energy-shard.lpc", WeaponType));
}

