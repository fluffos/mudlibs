inherit "/lib/modules/research/researchTree.lpc";

protected string WeaponType;

/////////////////////////////////////////////////////////////////////////////
protected void SetupResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
protected void AdditionalResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement(sprintf("/guilds/scion/paths/%s/evocation/energy-shard.lpc", WeaponType));
    addResearchElement(sprintf("/guilds/scion/paths/%s/evocation/magical-strike.lpc", WeaponType));

    addChild(sprintf("/guilds/scion/paths/%s/evocation/energy-shard.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/evocation/root.lpc", WeaponType));
    addChild(sprintf("/guilds/scion/paths/%s/evocation/magical-strike.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/evocation/root.lpc", WeaponType));
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
