protected string WeaponType;

/////////////////////////////////////////////////////////////////////////////
protected void SetupResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
protected void AdditionalResearch()
{
}

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement(sprintf("/guilds/scion/paths/%s/blood/soulspike.lpc", WeaponType));
    addResearchElement(sprintf("/guilds/scion/paths/%s/blood/soulstrike.lpc", WeaponType));

    addChild(sprintf("/guilds/scion/paths/%s/blood/soulspike.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/blood/root.lpc", WeaponType));
    addChild(sprintf("/guilds/scion/paths/%s/blood/soulstrike.lpc", WeaponType),
        sprintf("/guilds/scion/paths/%s/blood/root.lpc", WeaponType));
}

