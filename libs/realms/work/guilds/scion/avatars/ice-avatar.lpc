/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Ice Avatar");
    Description("This skill tree provides the user with the knowledge "
        "to summon an avatar of ice magic.");
    Source("Scion of Dhuras Guild");
    addResearchElement("/guilds/scion/avatars/ice/root.lpc");
    TreeRoot("/guilds/scion/avatars/ice/root.lpc");

    FirstLevel();
    ThirdLevel();
    FourthLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    TenthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
}
