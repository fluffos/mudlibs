inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Attack I");
    addSpecification("source", "Scion of Dhuras");
    addSpecification("description", "This research atunes the "
        "scion's avatar to be more adept at attacks.");

    addPrerequisite("level", ([  
        "type": "level",
        "guild": "Scion of Dhuras Guild",
        "value": 3
    ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/scion/avatars/blood/root.lpc",
        "/guilds/scion/avatars/electricity/root.lpc",
        "/guilds/scion/avatars/evocation/root.lpc",
        "/guilds/scion/avatars/flame/root.lpc",
        "/guilds/scion/avatars/ice/root.lpc",
        "/guilds/scion/avatars/spirit/root.lpc",
    }));
}
