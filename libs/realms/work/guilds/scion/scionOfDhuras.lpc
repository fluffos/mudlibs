inherit "/lib/modules/guilds/baseGuild.lpc";

/////////////////////////////////////////////////////////////////////////////
public void SetupGuild()
{
    guildName("Scion of Dhuras");
    guildClass("combat");
    addPreferredSkillType("combat");

    addRank("neophyte", ([
        "name": "neophyte", 
        "title": "the Scion of Dhuras", 
        "pretitle": "Neophyte", 
        "next rank": "acolyte",
        "delay for next promotion": 1200
    ]));

    addRank("acolyte", ([
        "name": "acolyte", 
        "title": "the Scion of Dhuras", 
        "pretitle": "Acolyte", 
        "previous rank": "neophyte", 
        "next rank": "adept",
        "delay for next promotion": 3600
    ]));

    addRank("adept", ([
        "name": "adept", 
        "title": "the Scion of Dhuras", 
        "pretitle": "Adept", 
        "previous rank": "acolyte", 
        "next rank": "master",
        "delay for next promotion": 7200
    ]));

    addRank("master", ([
        "name": "master", 
        "title": "the Scion of Dhuras", 
        "pretitle": "Master", 
        "previous rank": "adept", 
    ]));

    setDefaultRank("neophyte");
    prohibitedGuildCombinations(({ "Aegis Guard", "fighter", "monk" }));

    addCriteria("hit points", ([
        "type": "modifier",
        "apply" : "4 every level",
        "begin at level" : 1
    ]));
    addCriteria("spell points", ([
        "type": "modifier",
        "apply" : "4 every level",
        "begin at level" : 1
    ]));
    addCriteria("stamina points", ([
        "type": "modifier",
        "apply" : "2 every level",
        "begin at level" : 1
    ]));

    addCriteria("weapon attack", ([
        "type": "attack",
        "apply" : "1 every 15 levels"
    ]));
    addCriteria("attribute points", ([
        "type": "attribute points",
        "apply": "1 every 5 levels"
    ]));
    addCriteria("skill points", ([
        "type": "skill points",
        "apply" : "5 every level"
    ]));

    addCriteria("initial research points", ([
        "type": "research points",
        "apply": "at level 1"
    ]));

    addCriteria("research points", ([
        "type": "research points",
        "apply": "1 every level"
    ]));

    addCriteria("supplemental research points", ([
        "type": "research points",
        "apply": "2 every 5 levels"
    ]));

    addCriteria("spellcraft", ([
        "type": "skill",
        "apply": "3 every 2 levels"
    ]));

    addCriteria("mana shield tree", ([
        "type": "research tree",
        "apply": "at level 1",
        "research tree": "/guilds/scion/common/mana-shield/mana-shield.lpc"
    ]));

    addCriteria("weapon focus", ([
        "type": "research path",
        "name": "The Focus",
        "description": "Choose your weapon focus",
        "apply": "at level 1",
        "research objects": ({ "/guilds/scion/paths/sword.lpc",
            "/guilds/scion/paths/dagger.lpc",
            "/guilds/scion/paths/axe.lpc", 
            "/guilds/scion/paths/mace.lpc",
            "/guilds/scion/paths/hammer.lpc",
            "/guilds/scion/paths/staff.lpc" })
    ]));

    addCriteria("magical sword path", ([
        "type": "research choice",
        "name": "The Path (Sword)",
        "description": "Choose your magical path",
        "apply": "at level 1",
        "apply if chosen": ({ "/guilds/scion/paths/sword.lpc" }),
        "research objects": ({ "/guilds/scion/paths/sword/flame.lpc",
            "/guilds/scion/paths/sword/electricity.lpc",
            "/guilds/scion/paths/sword/ice.lpc",
            "/guilds/scion/paths/sword/blood.lpc",
            "/guilds/scion/paths/sword/evocation.lpc",
            "/guilds/scion/paths/sword/spirit.lpc" })
    ])); 

    addCriteria("magical axe path", ([
        "type": "research choice",
        "name": "The Path (Axe)",
        "description": "Choose your magical path",
        "apply": "at level 1",
        "apply if chosen": ({ "/guilds/scion/paths/axe.lpc" }),
        "research objects": ({ "/guilds/scion/paths/axe/flame.lpc",
            "/guilds/scion/paths/axe/electricity.lpc",
            "/guilds/scion/paths/axe/ice.lpc",
            "/guilds/scion/paths/axe/blood.lpc",
            "/guilds/scion/paths/axe/evocation.lpc",
            "/guilds/scion/paths/axe/spirit.lpc" })
    ])); 

    addCriteria("magical dagger path", ([
        "type": "research choice",
        "name": "The Path (Dagger)",
        "description": "Choose your magical path",
        "apply": "at level 1",
        "apply if chosen": ({ "/guilds/scion/paths/dagger.lpc" }),
        "research objects": ({ "/guilds/scion/paths/dagger/flame.lpc",
            "/guilds/scion/paths/dagger/electricity.lpc",
            "/guilds/scion/paths/dagger/ice.lpc",
            "/guilds/scion/paths/dagger/blood.lpc",
            "/guilds/scion/paths/dagger/evocation.lpc",
            "/guilds/scion/paths/dagger/spirit.lpc" })
    ])); 

    addCriteria("magical mace path", ([
        "type": "research choice",
        "name": "The Path (Mace)",
        "description": "Choose your magical path",
        "apply": "at level 1",
        "apply if chosen": ({ "/guilds/scion/paths/mace.lpc" }),
        "research objects": ({ "/guilds/scion/paths/mace/flame.lpc",
            "/guilds/scion/paths/mace/electricity.lpc",
            "/guilds/scion/paths/mace/ice.lpc",
            "/guilds/scion/paths/mace/blood.lpc",
            "/guilds/scion/paths/mace/evocation.lpc",
            "/guilds/scion/paths/mace/spirit.lpc" })
    ])); 

    addCriteria("magical hammer path", ([
        "type": "research choice",
        "name": "The Path (Hammer)",
        "description": "Choose your magical path",
        "apply": "at level 1",
        "apply if chosen": ({ "/guilds/scion/paths/hammer.lpc" }),
        "research objects": ({ "/guilds/scion/paths/hammer/flame.lpc",
            "/guilds/scion/paths/hammer/electricity.lpc",
            "/guilds/scion/paths/hammer/ice.lpc",
            "/guilds/scion/paths/hammer/blood.lpc",
            "/guilds/scion/paths/hammer/evocation.lpc",
            "/guilds/scion/paths/hammer/spirit.lpc" })
    ])); 

    addCriteria("magical staff path", ([
        "type": "research choice",
        "name": "The Path (Staff)",
        "description": "Choose your magical path",
        "apply": "at level 1",
        "apply if chosen": ({ "/guilds/scion/paths/staff.lpc" }),
        "research objects": ({ "/guilds/scion/paths/staff/flame.lpc",
            "/guilds/scion/paths/staff/electricity.lpc",
            "/guilds/scion/paths/staff/ice.lpc",
            "/guilds/scion/paths/staff/blood.lpc",
            "/guilds/scion/paths/staff/evocation.lpc",
            "/guilds/scion/paths/staff/spirit.lpc" })
    ])); 

    addCriteria("blood avatar tree", ([
        "type": "research tree",
        "apply": "at level 1",
        "apply if any chosen": ({
            "/guilds/scion/paths/axe/blood.lpc",
            "/guilds/scion/paths/dagger/blood.lpc",
            "/guilds/scion/paths/hammer/blood.lpc",
            "/guilds/scion/paths/mace/blood.lpc",
            "/guilds/scion/paths/sword/blood.lpc",
            "/guilds/scion/paths/staff/blood.lpc",
        }),
        "research tree": "/guilds/scion/avatars/blood-avatar.lpc"
    ]));

    addCriteria("electricity avatar tree", ([
        "type": "research tree",
        "apply": "at level 1",
        "apply if any chosen": ({
            "/guilds/scion/paths/axe/electricity.lpc",
            "/guilds/scion/paths/dagger/electricity.lpc",
            "/guilds/scion/paths/hammer/electricity.lpc",
            "/guilds/scion/paths/mace/electricity.lpc",
            "/guilds/scion/paths/sword/electricity.lpc",
            "/guilds/scion/paths/staff/electricity.lpc",
        }),
        "research tree": "/guilds/scion/avatars/electricity-avatar.lpc"
    ]));

    addCriteria("evocation avatar tree", ([
        "type": "research tree",
        "apply": "at level 1",
        "apply if any chosen": ({
            "/guilds/scion/paths/axe/evocation.lpc",
            "/guilds/scion/paths/dagger/evocation.lpc",
            "/guilds/scion/paths/hammer/evocation.lpc",
            "/guilds/scion/paths/mace/evocation.lpc",
            "/guilds/scion/paths/sword/evocation.lpc",
            "/guilds/scion/paths/staff/evocation.lpc",
        }),
        "research tree": "/guilds/scion/avatars/evocation-avatar.lpc"
    ]));

    addCriteria("flame avatar tree", ([
        "type": "research tree",
        "apply": "at level 1",
        "apply if any chosen": ({
            "/guilds/scion/paths/axe/flame.lpc",
            "/guilds/scion/paths/dagger/flame.lpc",
            "/guilds/scion/paths/hammer/flame.lpc",
            "/guilds/scion/paths/mace/flame.lpc",
            "/guilds/scion/paths/sword/flame.lpc",
            "/guilds/scion/paths/staff/flame.lpc",
        }),
        "research tree": "/guilds/scion/avatars/flame-avatar.lpc"
    ]));

    addCriteria("ice avatar tree", ([
        "type": "research tree",
        "apply": "at level 1",
        "apply if any chosen": ({
            "/guilds/scion/paths/axe/ice.lpc",
            "/guilds/scion/paths/dagger/ice.lpc",
            "/guilds/scion/paths/hammer/ice.lpc",
            "/guilds/scion/paths/mace/ice.lpc",
            "/guilds/scion/paths/sword/ice.lpc",
            "/guilds/scion/paths/staff/ice.lpc",
        }),
        "research tree": "/guilds/scion/avatars/ice-avatar.lpc"
    ]));

    addCriteria("spirit avatar tree", ([
        "type": "research tree",
        "apply": "at level 1",
        "apply if any chosen": ({
            "/guilds/scion/paths/axe/spirit.lpc",
            "/guilds/scion/paths/dagger/spirit.lpc",
            "/guilds/scion/paths/hammer/spirit.lpc",
            "/guilds/scion/paths/mace/spirit.lpc",
            "/guilds/scion/paths/sword/spirit.lpc",
            "/guilds/scion/paths/staff/spirit.lpc",
        }),
        "research tree": "/guilds/scion/avatars/spirit-avatar.lpc"
    ]));
}
