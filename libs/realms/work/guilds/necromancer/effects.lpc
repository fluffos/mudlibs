inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/necromancer/effects/damage-hp.lpc");
    addResearchElement("/guilds/necromancer/effects/siphon-hp.lpc");

    addChild("/guilds/necromancer/effects/damage-hp.lpc",
        "/guilds/necromancer/effects/root.lpc");
    addChild("/guilds/necromancer/effects/siphon-hp.lpc",
        "/guilds/necromancer/effects/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/necromancer/effects/damage-sp.lpc");
    addResearchElement("/guilds/necromancer/effects/siphon-sp.lpc");

    addChild("/guilds/necromancer/effects/damage-sp.lpc",
        "/guilds/necromancer/effects/damage-hp.lpc");
    addChild("/guilds/necromancer/effects/siphon-sp.lpc",
        "/guilds/necromancer/effects/siphon-hp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/necromancer/effects/damage-stamina.lpc");
    addResearchElement("/guilds/necromancer/effects/siphon-stamina.lpc");

    addChild("/guilds/necromancer/effects/damage-stamina.lpc",
        "/guilds/necromancer/effects/damage-sp.lpc");
    addChild("/guilds/necromancer/effects/siphon-stamina.lpc",
        "/guilds/necromancer/effects/siphon-sp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/necromancer/effects/add-hp.lpc");
    addResearchElement("/guilds/necromancer/effects/reduce-defense.lpc");

    addChild("/guilds/necromancer/effects/add-hp.lpc",
        "/guilds/necromancer/effects/siphon-hp.lpc");
    addChild("/guilds/necromancer/effects/reduce-defense.lpc",
        "/guilds/necromancer/effects/damage-hp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/necromancer/effects/add-sp.lpc");
    addResearchElement("/guilds/necromancer/effects/reduce-attack.lpc");
    addResearchElement("/guilds/necromancer/effects/enhance-attack.lpc");

    addChild("/guilds/necromancer/effects/add-sp.lpc",
        "/guilds/necromancer/effects/add-hp.lpc");
    addChild("/guilds/necromancer/effects/reduce-attack.lpc",
        "/guilds/necromancer/effects/reduce-defense.lpc");
    addChild("/guilds/necromancer/effects/enhance-attack.lpc",
        "/guilds/necromancer/effects/siphon-hp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/necromancer/effects/add-stamina.lpc");
    addResearchElement("/guilds/necromancer/effects/reduce-damage.lpc");
    addResearchElement("/guilds/necromancer/effects/enhance-damage.lpc");

    addChild("/guilds/necromancer/effects/add-stamina.lpc",
        "/guilds/necromancer/effects/add-sp.lpc");
    addChild("/guilds/necromancer/effects/reduce-damage.lpc",
        "/guilds/necromancer/effects/reduce-attack.lpc");
    addChild("/guilds/necromancer/effects/enhance-damage.lpc",
        "/guilds/necromancer/effects/enhance-attack.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/necromancer/effects/reduce-soak.lpc");
    addResearchElement("/guilds/necromancer/effects/enhance-defense.lpc");
    addResearchElement("/guilds/necromancer/effects/apply-disease.lpc");

    addChild("/guilds/necromancer/effects/reduce-soak.lpc",
        "/guilds/necromancer/effects/reduce-damage.lpc");
    addChild("/guilds/necromancer/effects/enhance-defense.lpc",
        "/guilds/necromancer/effects/enhance-damage.lpc");
    addChild("/guilds/necromancer/effects/apply-disease.lpc",
        "/guilds/necromancer/effects/damage-hp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/necromancer/effects/reduce-dodge.lpc");
    addResearchElement("/guilds/necromancer/effects/enhance-soak.lpc");
    addResearchElement("/guilds/necromancer/effects/apply-poison.lpc");

    addChild("/guilds/necromancer/effects/reduce-dodge.lpc",
        "/guilds/necromancer/effects/reduce-soak.lpc");
    addChild("/guilds/necromancer/effects/enhance-soak.lpc",
        "/guilds/necromancer/effects/enhance-defense.lpc");
    addChild("/guilds/necromancer/effects/apply-poison.lpc",
        "/guilds/necromancer/effects/apply-disease.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/necromancer/effects/reduce-parry.lpc");
    addResearchElement("/guilds/necromancer/effects/enhance-dodge.lpc");
    addResearchElement("/guilds/necromancer/effects/staggering-damage.lpc");

    addChild("/guilds/necromancer/effects/reduce-parry.lpc",
        "/guilds/necromancer/effects/reduce-dodge.lpc");
    addChild("/guilds/necromancer/effects/enhance-dodge.lpc",
        "/guilds/necromancer/effects/enhance-soak.lpc");
    addChild("/guilds/necromancer/effects/staggering-damage.lpc",
        "/guilds/necromancer/effects/damage-hp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/necromancer/effects/enhance-parry.lpc");
    addResearchElement("/guilds/necromancer/effects/debilitating-damage.lpc");
    addResearchElement("/guilds/necromancer/effects/invigorating-siphon.lpc");

    addChild("/guilds/necromancer/effects/enhance-parry.lpc",
        "/guilds/necromancer/effects/enhance-dodge.lpc");
    addChild("/guilds/necromancer/effects/debilitating-damage.lpc",
        "/guilds/necromancer/effects/staggering-damage.lpc");
    addChild("/guilds/necromancer/effects/invigorating-siphon.lpc",
        "/guilds/necromancer/effects/siphon-hp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/necromancer/effects/disorienting-damage.lpc");
    addResearchElement("/guilds/necromancer/effects/hampering-damage.lpc");
    addResearchElement("/guilds/necromancer/effects/fortifying-siphon.lpc");
    addResearchElement("/guilds/necromancer/effects/exhausting-damage.lpc");

    addChild("/guilds/necromancer/effects/disorienting-damage.lpc",
        "/guilds/necromancer/effects/debilitating-damage.lpc");
    addChild("/guilds/necromancer/effects/hampering-damage.lpc",
        "/guilds/necromancer/effects/debilitating-damage.lpc");
    addChild("/guilds/necromancer/effects/fortifying-siphon.lpc",
        "/guilds/necromancer/effects/invigorating-siphon.lpc");
    addChild("/guilds/necromancer/effects/exhausting-damage.lpc",
        "/guilds/necromancer/effects/staggering-damage.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Necrotic Spell Effects");
    Description("This research tree provides knowledge of the effects "
        "that can be applied through constructed necromancer spells.");
    Source("necromancer");
    addResearchElement("/guilds/necromancer/effects/root.lpc");
    TreeRoot("/guilds/necromancer/effects/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
}
