inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/necromancer/forms/touch.lpc");
    addResearchElement("/guilds/necromancer/forms/bolt.lpc");

    addChild("/guilds/necromancer/forms/touch.lpc",
        "/guilds/necromancer/forms/root.lpc");
    addChild("/guilds/necromancer/forms/bolt.lpc",
        "/guilds/necromancer/forms/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/necromancer/forms/arc.lpc");
    addResearchElement("/guilds/necromancer/forms/tendril.lpc");

    addChild("/guilds/necromancer/forms/arc.lpc",
        "/guilds/necromancer/forms/bolt.lpc");
    addChild("/guilds/necromancer/forms/tendril.lpc",
        "/guilds/necromancer/forms/touch.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/necromancer/forms/lance.lpc");
    addResearchElement("/guilds/necromancer/forms/coil.lpc");

    addChild("/guilds/necromancer/forms/lance.lpc",
        "/guilds/necromancer/forms/arc.lpc");
    addChild("/guilds/necromancer/forms/coil.lpc",
        "/guilds/necromancer/forms/tendril.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/necromancer/forms/blast.lpc");
    addResearchElement("/guilds/necromancer/forms/spray.lpc");

    addChild("/guilds/necromancer/forms/blast.lpc",
        "/guilds/necromancer/forms/bolt.lpc");
    addChild("/guilds/necromancer/forms/spray.lpc",
        "/guilds/necromancer/forms/arc.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/necromancer/forms/orb.lpc");
    addResearchElement("/guilds/necromancer/forms/needle.lpc");

    addChild("/guilds/necromancer/forms/orb.lpc",
        "/guilds/necromancer/forms/blast.lpc");
    addChild("/guilds/necromancer/forms/needle.lpc",
        "/guilds/necromancer/forms/lance.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/necromancer/forms/wave.lpc");
    addResearchElement("/guilds/necromancer/forms/pulse.lpc");

    addChild("/guilds/necromancer/forms/wave.lpc",
        "/guilds/necromancer/forms/spray.lpc");
    addChild("/guilds/necromancer/forms/pulse.lpc",
        "/guilds/necromancer/forms/orb.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/necromancer/forms/mist.lpc");
    addResearchElement("/guilds/necromancer/forms/shard.lpc");

    addChild("/guilds/necromancer/forms/mist.lpc",
        "/guilds/necromancer/forms/wave.lpc");
    addChild("/guilds/necromancer/forms/shard.lpc",
        "/guilds/necromancer/forms/needle.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/necromancer/forms/ring.lpc");
    addResearchElement("/guilds/necromancer/forms/strike.lpc");

    addChild("/guilds/necromancer/forms/ring.lpc",
        "/guilds/necromancer/forms/pulse.lpc");
    addChild("/guilds/necromancer/forms/strike.lpc",
        "/guilds/necromancer/forms/coil.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/necromancer/forms/wall.lpc");
    addResearchElement("/guilds/necromancer/forms/vortex.lpc");

    addChild("/guilds/necromancer/forms/wall.lpc",
        "/guilds/necromancer/forms/ring.lpc");
    addChild("/guilds/necromancer/forms/vortex.lpc",
        "/guilds/necromancer/forms/mist.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/necromancer/forms/cage.lpc");
    addResearchElement("/guilds/necromancer/forms/storm.lpc");

    addChild("/guilds/necromancer/forms/cage.lpc",
        "/guilds/necromancer/forms/wall.lpc");
    addChild("/guilds/necromancer/forms/storm.lpc",
        "/guilds/necromancer/forms/vortex.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/necromancer/forms/shroud.lpc");
    addResearchElement("/guilds/necromancer/forms/abyss.lpc");

    addChild("/guilds/necromancer/forms/shroud.lpc",
        "/guilds/necromancer/forms/mist.lpc");
    addChild("/guilds/necromancer/forms/abyss.lpc",
        "/guilds/necromancer/forms/storm.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Necrotic Spell Forms");
    Description("This research tree provides knowledge of the shapes and "
        "forms for constructing necromancer spells.");
    Source("necromancer");
    addResearchElement("/guilds/necromancer/forms/root.lpc");
    TreeRoot("/guilds/necromancer/forms/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
}
