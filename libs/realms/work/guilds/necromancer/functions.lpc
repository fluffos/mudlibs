inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/necromancer/functions/death.lpc");
    addResearchElement("/guilds/necromancer/functions/shadow.lpc");

    addChild("/guilds/necromancer/functions/death.lpc",
        "/guilds/necromancer/functions/root.lpc");
    addChild("/guilds/necromancer/functions/shadow.lpc",
        "/guilds/necromancer/functions/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/necromancer/functions/decay.lpc");
    addResearchElement("/guilds/necromancer/functions/blight.lpc");

    addChild("/guilds/necromancer/functions/decay.lpc",
        "/guilds/necromancer/functions/death.lpc");
    addChild("/guilds/necromancer/functions/blight.lpc",
        "/guilds/necromancer/functions/shadow.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/necromancer/functions/necrotic.lpc");
    addResearchElement("/guilds/necromancer/functions/void.lpc");

    addChild("/guilds/necromancer/functions/necrotic.lpc",
        "/guilds/necromancer/functions/decay.lpc");
    addChild("/guilds/necromancer/functions/void.lpc",
        "/guilds/necromancer/functions/blight.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/necromancer/functions/entropy.lpc");
    addResearchElement("/guilds/necromancer/functions/grave.lpc");

    addChild("/guilds/necromancer/functions/entropy.lpc",
        "/guilds/necromancer/functions/necrotic.lpc");
    addChild("/guilds/necromancer/functions/grave.lpc",
        "/guilds/necromancer/functions/void.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/necromancer/functions/undead.lpc");
    addResearchElement("/guilds/necromancer/functions/soul.lpc");

    addChild("/guilds/necromancer/functions/undead.lpc",
        "/guilds/necromancer/functions/entropy.lpc");
    addChild("/guilds/necromancer/functions/soul.lpc",
        "/guilds/necromancer/functions/grave.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/necromancer/functions/void-death.lpc");

    addChild("/guilds/necromancer/functions/void-death.lpc",
        "/guilds/necromancer/functions/soul.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Necrotic Spell Functions");
    Description("This research tree provides knowledge of the elemental "
        "functions for constructing necromancer spells.");
    Source("necromancer");
    addResearchElement("/guilds/necromancer/functions/root.lpc");
    TreeRoot("/guilds/necromancer/functions/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
}
