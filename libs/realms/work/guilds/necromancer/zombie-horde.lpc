/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Zombie Horde");
    Description("This research tree provides the knowledge necessary for "
        "raising and enhancing zombie minions.");
    Source("necromancer");
    addResearchElement("/guilds/necromancer/zombie/root.lpc");
    TreeRoot("/guilds/necromancer/zombie/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
}
