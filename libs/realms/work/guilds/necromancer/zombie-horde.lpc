private void SeventeenthLevel()
{
    addResearchElement("/guilds/necromancer/zombie/lords-of-undeath.lpc");
    addResearchElement("/guilds/necromancer/zombie/eternal-horde.lpc");
    addResearchElement("/guilds/necromancer/zombie/undying-champion.lpc");

