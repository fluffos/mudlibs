/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/necromancer/zombie/lord-of-the-horde.lpc");

    addChild("/guilds/necromancer/zombie/lord-of-the-horde.lpc",
