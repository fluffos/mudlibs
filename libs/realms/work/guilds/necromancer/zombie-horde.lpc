/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/necromancer/zombie/army-of-the-dead.lpc");
    addResearchElement("/guilds/necromancer/zombie/zombie-apocalypse.lpc");

    addChild("/guilds/necromancer/zombie/army-of-the-dead.lpc",
