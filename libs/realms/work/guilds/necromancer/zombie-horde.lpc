inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/necromancer/zombie/rotting-flesh.lpc");
    addResearchElement("/guilds/necromancer/zombie/decomposing-body.lpc");

    addChild("/guilds/necromancer/zombie/rotting-flesh.lpc",
        "/guilds/necromancer/zombie/root.lpc");
    addChild("/guilds/necromancer/zombie/decomposing-body.lpc",
        "/guilds/necromancer/zombie/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/necromancer/zombie/crushing-blow.lpc");
    addResearchElement("/guilds/necromancer/zombie/festering-wounds.lpc");
    addResearchElement("/guilds/necromancer/zombie/undead-resilience.lpc");

    addChild("/guilds/necromancer/zombie/crushing-blow.lpc",
        "/guilds/necromancer/zombie/rotting-flesh.lpc");
    addChild("/guilds/necromancer/zombie/festering-wounds.lpc",
        "/guilds/necromancer/zombie/decomposing-body.lpc");
    addChild("/guilds/necromancer/zombie/undead-resilience.lpc",
        "/guilds/necromancer/zombie/decomposing-body.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
