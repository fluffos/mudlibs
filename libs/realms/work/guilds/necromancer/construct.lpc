inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/necromancer/construct/necrotic-construct.lpc");

    addChild("/guilds/necromancer/construct/necrotic-construct.lpc",
        "/guilds/necromancer/construct/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/necromancer/construct/spell-focus.lpc");
    addResearchElement("/guilds/necromancer/construct/necromancers-reach.lpc");

    addChild("/guilds/necromancer/construct/spell-focus.lpc",
        "/guilds/necromancer/construct/necrotic-construct.lpc");
    addChild("/guilds/necromancer/construct/necromancers-reach.lpc",
        "/guilds/necromancer/construct/necrotic-construct.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/necromancer/construct/efficient-channeling.lpc");
    addResearchElement("/guilds/necromancer/construct/extended-reach.lpc");

    addChild("/guilds/necromancer/construct/efficient-channeling.lpc",
        "/guilds/necromancer/construct/spell-focus.lpc");
    addChild("/guilds/necromancer/construct/extended-reach.lpc",
        "/guilds/necromancer/construct/necromancers-reach.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/necromancer/construct/greater-spell-focus.lpc");
    addResearchElement("/guilds/necromancer/construct/greater-reach.lpc");
    addResearchElement("/guilds/necromancer/construct/rapid-construction.lpc");

    addChild("/guilds/necromancer/construct/greater-spell-focus.lpc",
        "/guilds/necromancer/construct/efficient-channeling.lpc");
    addChild("/guilds/necromancer/construct/greater-reach.lpc",
        "/guilds/necromancer/construct/extended-reach.lpc");
    addChild("/guilds/necromancer/construct/rapid-construction.lpc",
        "/guilds/necromancer/construct/efficient-channeling.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/necromancer/construct/supreme-spell-focus.lpc");
    addResearchElement("/guilds/necromancer/construct/construct-mastery.lpc");

    addChild("/guilds/necromancer/construct/supreme-spell-focus.lpc",
        "/guilds/necromancer/construct/greater-spell-focus.lpc");
    addChild("/guilds/necromancer/construct/construct-mastery.lpc",
        "/guilds/necromancer/construct/rapid-construction.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/necromancer/construct/supreme-construct-mastery.lpc");
    addResearchElement("/guilds/necromancer/construct/arcane-construct.lpc");

    addChild("/guilds/necromancer/construct/supreme-construct-mastery.lpc",
        "/guilds/necromancer/construct/construct-mastery.lpc");
    addChild("/guilds/necromancer/construct/arcane-construct.lpc",
        "/guilds/necromancer/construct/supreme-spell-focus.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Necrotic Spell Construction");
    Description("This research tree provides the knowledge necessary for "
        "constructing custom necromancer spells by combining forms, "
        "functions, and effects.");
    Source("necromancer");
    addResearchElement("/guilds/necromancer/construct/root.lpc");
    TreeRoot("/guilds/necromancer/construct/root.lpc");

    FirstLevel();
    FifthLevel();
    NinthLevel();
    ThirteenthLevel();
    SeventeenthLevel();
    TwentyFirstLevel();
}
