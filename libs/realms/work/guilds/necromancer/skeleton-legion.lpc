inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/necromancer/skeleton/bleached-bones.lpc");
    addResearchElement("/guilds/necromancer/skeleton/stripped-flesh.lpc");

    addChild("/guilds/necromancer/skeleton/bleached-bones.lpc",
    "/guilds/necromancer/skeleton/root.lpc");
    addChild("/guilds/necromancer/skeleton/stripped-flesh.lpc",
    "/guilds/necromancer/skeleton/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/necromancer/skeleton/razor-bones.lpc");
    addResearchElement("/guilds/necromancer/skeleton/reinforced-skeleton.lpc");
    addResearchElement("/guilds/necromancer/skeleton/skeletal-speed.lpc");

    addChild("/guilds/necromancer/skeleton/razor-bones.lpc",
    "/guilds/necromancer/skeleton/bleached-bones.lpc");
    addChild("/guilds/necromancer/skeleton/reinforced-skeleton.lpc",
    "/guilds/necromancer/skeleton/stripped-flesh.lpc");
    addChild("/guilds/necromancer/skeleton/skeletal-speed.lpc",
    "/guilds/necromancer/skeleton/stripped-flesh.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/necromancer/skeleton/bone-spear.lpc");
    addResearchElement("/guilds/necromancer/skeleton/iron-skeleton.lpc");
    addResearchElement("/guilds/necromancer/skeleton/undying-speed.lpc");
    addResearchElement("/guilds/necromancer/skeleton/skeletal-legion.lpc");

    addChild("/guilds/necromancer/skeleton/bone-spear.lpc",
        "/guilds/necromancer/skeleton/razor-bones.lpc");
    addChild("/guilds/necromancer/skeleton/iron-skeleton.lpc",
        "/guilds/necromancer/skeleton/reinforced-skeleton.lpc");
    addChild("/guilds/necromancer/skeleton/undying-speed.lpc",
        "/guilds/necromancer/skeleton/skeletal-speed.lpc");
    addChild("/guilds/necromancer/skeleton/skeletal-legion.lpc",
        "/guilds/necromancer/skeleton/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
