/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/necromancer/skeleton/bone-hurricane.lpc");
    addResearchElement("/guilds/necromancer/skeleton/death-king.lpc");
    addResearchElement("/guilds/necromancer/skeleton/eternal-legion.lpc");

    addChild("/guilds/necromancer/skeleton/bone-hurricane.lpc",
        "/guilds/necromancer/skeleton/bone-avalanche.lpc");
    addChild("/guilds/necromancer/skeleton/death-king.lpc",
        "/guilds/necromancer/skeleton/skull-lord.lpc");
    addChild("/guilds/necromancer/skeleton/eternal-legion.lpc",
