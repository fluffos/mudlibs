/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/necromancer/skeleton/bone-avalanche.lpc");
    addResearchElement("/guilds/necromancer/skeleton/skull-lord.lpc");
    addResearchElement("/guilds/necromancer/skeleton/death-legion.lpc");

    addChild("/guilds/necromancer/skeleton/bone-avalanche.lpc",
