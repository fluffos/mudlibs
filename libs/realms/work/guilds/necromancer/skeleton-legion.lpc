    addResearchElement("/guilds/necromancer/skeleton/eternal-march.lpc");
    addResearchElement("/guilds/necromancer/skeleton/skeletal-dominion.lpc");

    addChild("/guilds/necromancer/skeleton/bone-barrage.lpc",
