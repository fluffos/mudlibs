inherit "/lib/modules/research/constructedResearchComponent.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Blast Form");
    addSpecification("source", "necromancer");

    addSpecification("description", "This research provides the user with the "
        "knowledge of creating spells that unleashing a blast of necrotic energy.");

    addPrerequisite("/guilds/necromancer/forms/bolt.lpc",
        (["type": "research"]));
    addPrerequisite("level",
        ([
            "type": "level",
            "guild": "necromancer",
            "value": 7
        ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Constructed Spell Multiplier": 18,
    ]));
    addSpecification("affected research type", "percentage");

    addSpecification("additional cooldown", 9);
    addSpecification("additional spell point cost", 14);

    addSpecification("use combination message",
        "##InitiatorName## ##Infinitive::unleash## a blast of ##Function## at ##TargetName##.");
}
