    addResearchElement("/guilds/necromancer/wraith/nightmare-presence.lpc");
    addResearchElement("/guilds/necromancer/wraith/wraith-host.lpc");

    addChild("/guilds/necromancer/wraith/soul-destruction.lpc",
        "/guilds/necromancer/wraith/soul-rend.lpc");
    addChild("/guilds/necromancer/wraith/phantom-strike.lpc",
        "/guilds/necromancer/wraith/void-cloak.lpc");
    addChild("/guilds/necromancer/wraith/nightmare-presence.lpc",
        "/guilds/necromancer/wraith/mind-shatter.lpc");
    addChild("/guilds/necromancer/wraith/wraith-host.lpc",
