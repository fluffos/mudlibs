    addChild("/guilds/necromancer/wraith/shadow-meld.lpc",
        "/guilds/necromancer/wraith/void-step.lpc");
    addChild("/guilds/necromancer/wraith/wail-of-despair.lpc",
        "/guilds/necromancer/wraith/paralyzing-terror.lpc");
    addChild("/guilds/necromancer/wraith/haunting-aura.lpc",
        "/guilds/necromancer/wraith/extra-wraith.lpc");
    addChild("/guilds/necromancer/wraith/shadow-step.lpc",
