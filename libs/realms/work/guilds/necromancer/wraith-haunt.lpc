/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/necromancer/wraith/soul-rend.lpc");
    addResearchElement("/guilds/necromancer/wraith/void-cloak.lpc");
    addResearchElement("/guilds/necromancer/wraith/mind-shatter.lpc");
    addResearchElement("/guilds/necromancer/wraith/shadow-legion.lpc");
    addResearchElement("/guilds/necromancer/wraith/ethereal-armor.lpc");

    addChild("/guilds/necromancer/wraith/soul-rend.lpc",
        "/guilds/necromancer/wraith/spirit-crush.lpc");
    addChild("/guilds/necromancer/wraith/void-cloak.lpc",
        "/guilds/necromancer/wraith/shadow-meld.lpc");
    addChild("/guilds/necromancer/wraith/mind-shatter.lpc",
        "/guilds/necromancer/wraith/wail-of-despair.lpc");
    addChild("/guilds/necromancer/wraith/shadow-legion.lpc",
        "/guilds/necromancer/wraith/haunting-aura.lpc");
    addChild("/guilds/necromancer/wraith/ethereal-armor.lpc",
