inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/necromancer/wraith/ethereal-touch.lpc");
    addResearchElement("/guilds/necromancer/wraith/shadow-form.lpc");

    addChild("/guilds/necromancer/wraith/ethereal-touch.lpc",
        "/guilds/necromancer/wraith/root.lpc");
    addChild("/guilds/necromancer/wraith/shadow-form.lpc",
        "/guilds/necromancer/wraith/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/necromancer/wraith/life-drain.lpc");
    addResearchElement("/guilds/necromancer/wraith/incorporeal.lpc");
    addResearchElement("/guilds/necromancer/wraith/terror.lpc");

    addChild("/guilds/necromancer/wraith/life-drain.lpc",
        "/guilds/necromancer/wraith/ethereal-touch.lpc");
    addChild("/guilds/necromancer/wraith/incorporeal.lpc",
        "/guilds/necromancer/wraith/shadow-form.lpc");
    addChild("/guilds/necromancer/wraith/terror.lpc",
        "/guilds/necromancer/wraith/shadow-form.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/necromancer/wraith/soul-siphon.lpc");
    addResearchElement("/guilds/necromancer/wraith/phase-shift.lpc");
    addResearchElement("/guilds/necromancer/wraith/dread-presence.lpc");
    addResearchElement("/guilds/necromancer/wraith/shadow-haunt.lpc");

    addChild("/guilds/necromancer/wraith/soul-siphon.lpc",
        "/guilds/necromancer/wraith/life-drain.lpc");
    addChild("/guilds/necromancer/wraith/phase-shift.lpc",
        "/guilds/necromancer/wraith/incorporeal.lpc");
    addChild("/guilds/necromancer/wraith/dread-presence.lpc",
        "/guilds/necromancer/wraith/terror.lpc");
    addChild("/guilds/necromancer/wraith/shadow-haunt.lpc",
        "/guilds/necromancer/wraith/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/necromancer/wraith/essence-drain.lpc");
