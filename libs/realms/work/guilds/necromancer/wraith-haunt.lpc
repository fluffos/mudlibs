/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/necromancer/wraith/oblivion-touch.lpc");
    addResearchElement("/guilds/necromancer/wraith/shadow-sovereign.lpc");
    addResearchElement("/guilds/necromancer/wraith/doom-presence.lpc");

    addChild("/guilds/necromancer/wraith/oblivion-touch.lpc",
        "/guilds/necromancer/wraith/annihilation-touch.lpc");
    addChild("/guilds/necromancer/wraith/shadow-sovereign.lpc",
        "/guilds/necromancer/wraith/ghost-walk.lpc");
    addChild("/guilds/necromancer/wraith/doom-presence.lpc",
