/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/necromancer/wraith/annihilation-touch.lpc");
    addResearchElement("/guilds/necromancer/wraith/ghost-walk.lpc");
    addResearchElement("/guilds/necromancer/wraith/eternal-terror.lpc");

    addChild("/guilds/necromancer/wraith/annihilation-touch.lpc",
