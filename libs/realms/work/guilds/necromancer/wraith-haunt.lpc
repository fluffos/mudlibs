    addResearchElement("/guilds/necromancer/wraith/paralyzing-terror.lpc");
    addResearchElement("/guilds/necromancer/wraith/extra-wraith.lpc");

    addChild("/guilds/necromancer/wraith/essence-drain.lpc",
        "/guilds/necromancer/wraith/soul-siphon.lpc");
    addChild("/guilds/necromancer/wraith/void-step.lpc",
        "/guilds/necromancer/wraith/phase-shift.lpc");
    addChild("/guilds/necromancer/wraith/paralyzing-terror.lpc",
        "/guilds/necromancer/wraith/dread-presence.lpc");
    addChild("/guilds/necromancer/wraith/extra-wraith.lpc",
        "/guilds/necromancer/wraith/shadow-haunt.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/necromancer/wraith/spirit-crush.lpc");
    addResearchElement("/guilds/necromancer/wraith/shadow-meld.lpc");
    addResearchElement("/guilds/necromancer/wraith/wail-of-despair.lpc");
    addResearchElement("/guilds/necromancer/wraith/haunting-aura.lpc");
    addResearchElement("/guilds/necromancer/wraith/shadow-step.lpc");

    addChild("/guilds/necromancer/wraith/spirit-crush.lpc",
