/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/necromancer/wraith/void-herald.lpc");
    addResearchElement("/guilds/necromancer/wraith/haunt-supreme.lpc");

    addChild("/guilds/necromancer/wraith/void-herald.lpc",
        "/guilds/necromancer/wraith/oblivion-touch.lpc");
    addChild("/guilds/necromancer/wraith/haunt-supreme.lpc",
        "/guilds/necromancer/wraith/shadow-sovereign.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/necromancer/wraith/lord-of-the-haunt.lpc");

    addChild("/guilds/necromancer/wraith/lord-of-the-haunt.lpc",
        "/guilds/necromancer/wraith/void-herald.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Wraith Haunt");
    Description("This research tree provides the knowledge necessary for "
        "summoning and enhancing wraith minions.");
    Source("necromancer");
    addResearchElement("/guilds/necromancer/wraith/root.lpc");
    TreeRoot("/guilds/necromancer/wraith/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
}
