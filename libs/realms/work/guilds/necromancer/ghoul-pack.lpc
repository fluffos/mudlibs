/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/apocalyptic-plague.lpc");
    addResearchElement("/guilds/necromancer/ghoul/ghoul-lord.lpc");
    addResearchElement("/guilds/necromancer/ghoul/massacre-frenzy.lpc");

    addChild("/guilds/necromancer/ghoul/apocalyptic-plague.lpc",
        "/guilds/necromancer/ghoul/death-plague.lpc");
    addChild("/guilds/necromancer/ghoul/ghoul-lord.lpc",
        "/guilds/necromancer/ghoul/titanium-hide.lpc");
    addChild("/guilds/necromancer/ghoul/massacre-frenzy.lpc",
        "/guilds/necromancer/ghoul/slaughter-frenzy.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/plague-lord.lpc");
    addResearchElement("/guilds/necromancer/ghoul/undead-champion.lpc");
    addResearchElement("/guilds/necromancer/ghoul/death-frenzy.lpc");

    addChild("/guilds/necromancer/ghoul/plague-lord.lpc",
        "/guilds/necromancer/ghoul/apocalyptic-plague.lpc");
    addChild("/guilds/necromancer/ghoul/undead-champion.lpc",
        "/guilds/necromancer/ghoul/ghoul-lord.lpc");
    addChild("/guilds/necromancer/ghoul/death-frenzy.lpc",
        "/guilds/necromancer/ghoul/massacre-frenzy.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/plague-sovereign.lpc");
    addResearchElement("/guilds/necromancer/ghoul/pack-supreme.lpc");

    addChild("/guilds/necromancer/ghoul/plague-sovereign.lpc",
        "/guilds/necromancer/ghoul/plague-lord.lpc");
    addChild("/guilds/necromancer/ghoul/pack-supreme.lpc",
        "/guilds/necromancer/ghoul/undead-champion.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/lord-of-the-pack.lpc");

    addChild("/guilds/necromancer/ghoul/lord-of-the-pack.lpc",
        "/guilds/necromancer/ghoul/plague-sovereign.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Ghoul Pack");
    Description("This research tree provides the knowledge necessary for "
        "raising and enhancing ghoul minions.");
    Source("necromancer");
    addResearchElement("/guilds/necromancer/ghoul/root.lpc");
    TreeRoot("/guilds/necromancer/ghoul/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
}
