    addResearchElement("/guilds/necromancer/ghoul/blood-frenzy.lpc");
    addResearchElement("/guilds/necromancer/ghoul/extra-ghoul.lpc");

    addChild("/guilds/necromancer/ghoul/toxic-bite.lpc",
        "/guilds/necromancer/ghoul/venom-claws.lpc");
    addChild("/guilds/necromancer/ghoul/iron-hide.lpc",
        "/guilds/necromancer/ghoul/corpse-hide.lpc");
    addChild("/guilds/necromancer/ghoul/blood-frenzy.lpc",
        "/guilds/necromancer/ghoul/feeding-frenzy.lpc");
    addChild("/guilds/necromancer/ghoul/extra-ghoul.lpc",
        "/guilds/necromancer/ghoul/pack-hunter.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/plague-bite.lpc");
    addResearchElement("/guilds/necromancer/ghoul/necrotic-armor.lpc");
    addResearchElement("/guilds/necromancer/ghoul/savage-frenzy.lpc");
    addResearchElement("/guilds/necromancer/ghoul/pack-coordination.lpc");
    addResearchElement("/guilds/necromancer/ghoul/death-leap.lpc");

    addChild("/guilds/necromancer/ghoul/plague-bite.lpc",
