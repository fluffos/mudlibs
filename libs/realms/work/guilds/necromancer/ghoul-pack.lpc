/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/virulent-plague-bite.lpc");
    addResearchElement("/guilds/necromancer/ghoul/bone-plating.lpc");
    addResearchElement("/guilds/necromancer/ghoul/berserker-frenzy.lpc");
    addResearchElement("/guilds/necromancer/ghoul/pack-ambush.lpc");
    addResearchElement("/guilds/necromancer/ghoul/rending-leap.lpc");

    addChild("/guilds/necromancer/ghoul/virulent-plague-bite.lpc",
        "/guilds/necromancer/ghoul/plague-bite.lpc");
    addChild("/guilds/necromancer/ghoul/bone-plating.lpc",
        "/guilds/necromancer/ghoul/necrotic-armor.lpc");
    addChild("/guilds/necromancer/ghoul/berserker-frenzy.lpc",
        "/guilds/necromancer/ghoul/savage-frenzy.lpc");
    addChild("/guilds/necromancer/ghoul/pack-ambush.lpc",
        "/guilds/necromancer/ghoul/pack-coordination.lpc");
    addChild("/guilds/necromancer/ghoul/rending-leap.lpc",
        "/guilds/necromancer/ghoul/death-leap.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/death-plague.lpc");
    addResearchElement("/guilds/necromancer/ghoul/titanium-hide.lpc");
    addResearchElement("/guilds/necromancer/ghoul/slaughter-frenzy.lpc");
    addResearchElement("/guilds/necromancer/ghoul/pack-devastation.lpc");

    addChild("/guilds/necromancer/ghoul/death-plague.lpc",
        "/guilds/necromancer/ghoul/virulent-plague-bite.lpc");
    addChild("/guilds/necromancer/ghoul/titanium-hide.lpc",
        "/guilds/necromancer/ghoul/bone-plating.lpc");
    addChild("/guilds/necromancer/ghoul/slaughter-frenzy.lpc",
        "/guilds/necromancer/ghoul/berserker-frenzy.lpc");
    addChild("/guilds/necromancer/ghoul/pack-devastation.lpc",
        "/guilds/necromancer/ghoul/pack-ambush.lpc");
