inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/rending-claws.lpc");
    addResearchElement("/guilds/necromancer/ghoul/necrotic-stench.lpc");

    addChild("/guilds/necromancer/ghoul/rending-claws.lpc",
        "/guilds/necromancer/ghoul/root.lpc");
    addChild("/guilds/necromancer/ghoul/necrotic-stench.lpc",
        "/guilds/necromancer/ghoul/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/paralyzing-bite.lpc");
    addResearchElement("/guilds/necromancer/ghoul/carrion-hide.lpc");
    addResearchElement("/guilds/necromancer/ghoul/grave-hunger.lpc");

    addChild("/guilds/necromancer/ghoul/paralyzing-bite.lpc",
        "/guilds/necromancer/ghoul/rending-claws.lpc");
    addChild("/guilds/necromancer/ghoul/carrion-hide.lpc",
        "/guilds/necromancer/ghoul/necrotic-stench.lpc");
    addChild("/guilds/necromancer/ghoul/grave-hunger.lpc",
        "/guilds/necromancer/ghoul/necrotic-stench.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/venom-claws.lpc");
    addResearchElement("/guilds/necromancer/ghoul/corpse-hide.lpc");
    addResearchElement("/guilds/necromancer/ghoul/feeding-frenzy.lpc");
    addResearchElement("/guilds/necromancer/ghoul/pack-hunter.lpc");

    addChild("/guilds/necromancer/ghoul/venom-claws.lpc",
        "/guilds/necromancer/ghoul/paralyzing-bite.lpc");
    addChild("/guilds/necromancer/ghoul/corpse-hide.lpc",
        "/guilds/necromancer/ghoul/carrion-hide.lpc");
    addChild("/guilds/necromancer/ghoul/feeding-frenzy.lpc",
        "/guilds/necromancer/ghoul/grave-hunger.lpc");
    addChild("/guilds/necromancer/ghoul/pack-hunter.lpc",
        "/guilds/necromancer/ghoul/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/necromancer/ghoul/toxic-bite.lpc");
