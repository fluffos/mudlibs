/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Path of Death");
    Description("This research tree provides knowledge of death-based "
        "spells and abilities for the necromancer.");
    Source("necromancer");
    addResearchElement("/guilds/necromancer/death/root.lpc");
    TreeRoot("/guilds/necromancer/death/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFirstLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FiftyFirstLevel();
    FiftySeventhLevel();
    SixtyThirdLevel();
    SixtySeventhLevel();
}
