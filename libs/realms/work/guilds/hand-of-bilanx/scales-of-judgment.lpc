/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Scales of Judgment");
    Description("This research tree teaches Bilanx's fifth truth - that the "
        "scales see all things truly and correct all imbalances. The priest "
        "learns to weigh souls, punish those who have transgressed against "
        "equilibrium, reward those who hold to the center, and pronounce "
        "Bilanx's final sentence on the unrepentant.");
    Source("Hand of Bilanx");
    addResearchElement("/guilds/hand-of-bilanx/scales-of-judgment/root.lpc");
    TreeRoot("/guilds/hand-of-bilanx/scales-of-judgment/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SixthLevel();
    SeventhLevel();
    EighthLevel();
    NinthLevel();
    TenthLevel();
    EleventhLevel();
    TwelfthLevel();
    ThirteenthLevel();
    FourteenthLevel();
    SixteenthLevel();
    SeventeenthLevel();
    EighteenthLevel();
    NineteenthLevel();
    TwentySecondLevel();
    TwentyFourthLevel();
    TwentyFifthLevel();
    TwentyEighthLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtyEighthLevel();
    ThirtyNinthLevel();
    FortiethLevel();
    FortyFifthLevel();
    FortyEighthLevel();
    FiftiethLevel();
    FiftyFifthLevel();
    SixtyFifthLevel();
}
