inherit "/lib/modules/guilds/baseGuild.lpc";

/////////////////////////////////////////////////////////////////////////////
public void SetupGuild()
{
    guildName("bard");
    guildClass("combat");
    addPreferredSkillType("combat");
    addPreferredSkillType("magic");
    prohibitedGuildCombinations(({ "monk" }));

    addCriteria("hit points", ([
        "type": "modifier",
        "apply" : "4 every level",
        "begin at level" : 1
    ]));

    addCriteria("spell points", ([
        "type": "modifier",
        "apply" : "3 every level",
        "begin at level" : 1
    ]));

    addCriteria("stamina points", ([
        "type": "modifier",
        "apply" : "3 every level",
        "begin at level" : 1
    ]));

    addCriteria("weapon attack", ([
        "type": "attack",
        "apply" : "1 every 20 levels"
    ]));

    addCriteria("attribute points", ([
        "type": "attribute points",
        "apply": "1 every 5 levels"
    ]));

    addCriteria("skill points", ([
        "type": "skill points",
        "apply" : "5 every level"
    ]));

    addCriteria("initial research points", ([
        "type": "research points",
        "apply": "5 at level 1"
    ]));

    addCriteria("research points", ([
        "type": "research points",
        "apply": "1 every level"
    ]));

    addCriteria("supplemental research points", ([
        "type": "research points",
        "apply": "2 every 5 levels"
    ]));

    addCriteria("compose songs", ([
        "type": "research",
        "apply": "at level 1",
        "research object": "/guilds/bard/compositions/compose-song.lpc"
    ]));

    addCriteria("stop performance", ([
        "type": "research",
        "apply": "at level 1",
        "research object": "/guilds/bard/compositions/stop-performance.lpc"
    ]));

    addCriteria("bows", ([
        "type": "research tree",
        "apply": "at level 1",
        "research tree": "/guilds/bard/bows.lpc"
    ]));

    addCriteria("melee weapons", ([
        "type": "research tree",
        "apply": "at level 1",
        "research tree": "/guilds/bard/melee-attacks.lpc"
    ]));

    addCriteria("compositions", ([
        "type": "research tree",
        "apply": "at level 1",
        "research tree": "/guilds/bard/compositions.lpc"
    ]));

    addCriteria("lyrics", ([
        "type": "research tree",
        "apply": "at level 1",
        "research tree": "/guilds/bard/lyrics.lpc"
    ]));

    addCriteria("strings", ([
        "type": "research tree",
        "apply": "at level 1",
        "research tree": "/guilds/bard/strings.lpc"
    ]));

    addCriteria("woodwind-brass", ([
        "type": "research tree",
        "apply": "at level 1",
        "research tree": "/guilds/bard/woodwind-brass.lpc"
    ]));

    addCriteria("percussion", ([
        "type": "research tree",
        "apply": "at level 1",
        "research tree": "/guilds/bard/percussion.lpc"
    ]));
}
