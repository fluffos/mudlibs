inherit "/lib/modules/research/compositeActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Musical Compositions");
    addSpecification("source", "bard");
    addSpecification("description", "This skill provides the user with the "
        "knowledge of composing and playing songs that can provide "
        "complex effects.");

    addSpecification("composite rules", ([
        "template must be one of": ({
            "/guilds/bard/compositions/aaa.lpc",
            "/guilds/bard/compositions/aaba.lpc",
            "/guilds/bard/compositions/abab.lpc",
            "/guilds/bard/compositions/ababcb.lpc",
            "/guilds/bard/compositions/abac.lpc",
            "/guilds/bard/compositions/abacbaa.lpc",
            "/guilds/bard/compositions/freeform.lpc",
            "/guilds/bard/compositions/simple-ballad.lpc",
            "/guilds/bard/compositions/verse-chorus-bridge.lpc",
            "/guilds/bard/compositions/verse-pre-chorus.lpc",
        }),
    ]));

    addSpecification("cooldown", 60);
    addSpecification("cooldown modifiers", ([
        "/guilds/bard/compositions/the-inner-muse.lpc": 10,
        "/guilds/bard/compositions/the-minstrel.lpc": 10,
        "/guilds/bard/compositions/the-troubador.lpc": 10,
        "/guilds/bard/compositions/the-composer.lpc": 10,
    ]));

    addSpecification("scope", "area");
    addSpecification("research type", "tree root");
    addSpecification("command name", "perform");
    addSpecification("command template", "perform ##Value##");
    addSpecification("use ability message", "##InitiatorName## "
        "##Infinitive::begin## to play a song...");
}
