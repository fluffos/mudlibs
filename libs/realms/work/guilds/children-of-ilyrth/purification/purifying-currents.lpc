/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Path of Purifying Currents");
    Description("This research tree provides knowledge of cleansing and "
        "purification magic channeled through the divine power of Ilyrth, "
        "goddess of the sea. Her followers learn to wash away poison, cure "
        "disease, remove curses, and protect against all forms of corruption "
        "through the sacred purity of water.");
    Source("Children of Ilyrth");
    addResearchElement("/guilds/children-of-ilyrth/purification/root.lpc");
    TreeRoot("/guilds/children-of-ilyrth/purification/root.lpc");

    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyFifthLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    FortyFirstLevel();
    FortyFifthLevel();
    FiftyFirstLevel();
    FiftySeventhLevel();
    SixtyThirdLevel();
    SixtySeventhLevel();
}
