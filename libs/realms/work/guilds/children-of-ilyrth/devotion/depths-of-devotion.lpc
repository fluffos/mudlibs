/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Depths of Devotion");
    Description("This research tree provides knowledge of protective magic "
        "channeled through the divine power of Ilyrth, goddess of the sea. "
        "Her followers learn to wrap themselves in the protective embrace "
        "of sacred waters, shielding themselves from harm.");
    Source("Children of Ilyrth");
    addResearchElement("/guilds/children-of-ilyrth/devotion/root.lpc");
    TreeRoot("/guilds/children-of-ilyrth/devotion/root.lpc");

    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFirstLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FortyNinthLevel();
    FiftyThirdLevel();
    FiftySeventhLevel();
}
