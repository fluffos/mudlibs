inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Basic Form");
    addSpecification("source", "Werric Knight");
    addSpecification("description", "This skill provides the user with knowledge "
        "of proper sword forms, improving attack and defense with blade weapons.");

    addSpecification("limited by", (["equipment":({ "dagger", "short sword",
        "long sword", "hand and a half sword", "two-handed sword" }) ]));


    addPrerequisite("/guilds/werric-knight/werric-knight.lpc",

        (["type": "guild", "level":1]));

    addSpecification("scope", "self");

    addPrerequisite("/guilds/werric-knight/werric-knight.lpc",
        (["type": "guild", "level":1]));
    addSpecification("research type", "points");

    addPrerequisite("/guilds/werric-knight/werric-knight.lpc",
        (["type": "guild", "level":1]));
    addSpecification("research cost", 1);
    addSpecification("bonus dagger", 1);
    addSpecification("bonus short sword", 1);
    addSpecification("bonus long sword", 1);
    addSpecification("bonus hand and a half sword", 1);
    addSpecification("bonus two-handed sword", 1);
    addSpecification("bonus attack", 1);
    addSpecification("bonus defense", 1);
}
