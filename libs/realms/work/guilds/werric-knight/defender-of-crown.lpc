inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void TwentyFifthLevel()
{
    addResearchElement("/guilds/werric-knight/defender/crowns-shield.lpc");
    addChild("/guilds/werric-knight/defender/crowns-shield.lpc",
        "/guilds/werric-knight/defender/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentySeventhLevel()
{
    addResearchElement("/guilds/werric-knight/defender/living-wall.lpc");
    addChild("/guilds/werric-knight/defender/living-wall.lpc",
        "/guilds/werric-knight/defender/crowns-shield.lpc");

    addResearchElement("/guilds/werric-knight/defender/intercept.lpc");
    addChild("/guilds/werric-knight/defender/intercept.lpc",
        "/guilds/werric-knight/defender/crowns-shield.lpc");

    addResearchElement("/guilds/werric-knight/defender/guardians-vigil.lpc");
    addChild("/guilds/werric-knight/defender/guardians-vigil.lpc",
        "/guilds/werric-knight/defender/intercept.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyNinthLevel()
{
    addResearchElement("/guilds/werric-knight/defender/selfless-protector.lpc");
    addChild("/guilds/werric-knight/defender/selfless-protector.lpc",
        "/guilds/werric-knight/defender/guardians-vigil.lpc");

    addResearchElement("/guilds/werric-knight/defender/sacrifice.lpc");
    addChild("/guilds/werric-knight/defender/sacrifice.lpc",
        "/guilds/werric-knight/defender/selfless-protector.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyFirstLevel()
{
    addResearchElement("/guilds/werric-knight/defender/shield-innocent.lpc");
    addChild("/guilds/werric-knight/defender/shield-innocent.lpc",
        "/guilds/werric-knight/defender/selfless-protector.lpc");

    addResearchElement("/guilds/werric-knight/defender/immovable-guardian.lpc");
    addChild("/guilds/werric-knight/defender/immovable-guardian.lpc",
        "/guilds/werric-knight/defender/sacrifice.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyThirdLevel()
{
    addResearchElement("/guilds/werric-knight/defender/indomitable-defense.lpc");
    addChild("/guilds/werric-knight/defender/indomitable-defense.lpc",
        "/guilds/werric-knight/defender/immovable-guardian.lpc");

    addResearchElement("/guilds/werric-knight/defender/aegis-of-realm.lpc");
    addChild("/guilds/werric-knight/defender/aegis-of-realm.lpc",
        "/guilds/werric-knight/defender/immovable-guardian.lpc");

    addResearchElement("/guilds/werric-knight/defender/defiant-stand.lpc");
    addChild("/guilds/werric-knight/defender/defiant-stand.lpc",
        "/guilds/werric-knight/defender/aegis-of-realm.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyFifthLevel()
{
    addResearchElement("/guilds/werric-knight/defender/unyielding-bastion.lpc");
    addChild("/guilds/werric-knight/defender/unyielding-bastion.lpc",
        "/guilds/werric-knight/defender/defiant-stand.lpc");

    addResearchElement("/guilds/werric-knight/defender/sanctified-defense.lpc");
    addChild("/guilds/werric-knight/defender/sanctified-defense.lpc",
        "/guilds/werric-knight/defender/unyielding-bastion.lpc");

    addResearchElement("/guilds/werric-knight/defender/kings-champion.lpc");
    addChild("/guilds/werric-knight/defender/kings-champion.lpc",
        "/guilds/werric-knight/defender/unyielding-bastion.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtySeventhLevel()
{
    addResearchElement("/guilds/werric-knight/defender/redemptions-shield.lpc");
    addChild("/guilds/werric-knight/defender/redemptions-shield.lpc",
        "/guilds/werric-knight/defender/kings-champion.lpc");

    addResearchElement("/guilds/werric-knight/defender/protectors-heart.lpc");
    addChild("/guilds/werric-knight/defender/protectors-heart.lpc",
        "/guilds/werric-knight/defender/kings-champion.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyNinthLevel()
{
    addResearchElement("/guilds/werric-knight/defender/ultimate-protector.lpc");
    addChild("/guilds/werric-knight/defender/ultimate-protector.lpc",
        "/guilds/werric-knight/defender/protectors-heart.lpc");

    addResearchElement("/guilds/werric-knight/defender/last-stand.lpc");
    addChild("/guilds/werric-knight/defender/last-stand.lpc",
        "/guilds/werric-knight/defender/protectors-heart.lpc");

    addResearchElement("/guilds/werric-knight/defender/eternal-guardian.lpc");
    addChild("/guilds/werric-knight/defender/eternal-guardian.lpc",
        "/guilds/werric-knight/defender/last-stand.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Defender of the Crown");
    Description("This research tree is available only to Knight Commanders who "
        "have proven themselves worthy of the sacred duty of defending the Crown. "
        "It represents the ultimate defensive techniques and the legendary King's "
        "Champion form.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/defender/root.lpc");
    TreeRoot("/guilds/werric-knight/defender/root.lpc");

    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
}
