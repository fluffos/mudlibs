private void FirstLevel()
{
    addResearchElement("/guilds/werric-knight/light/divine-connection.lpc");
    addChild("/guilds/werric-knight/light/divine-connection.lpc",
        "/guilds/werric-knight/light/root.lpc");

    addResearchElement("/guilds/werric-knight/light/holy-light.lpc");
    addChild("/guilds/werric-knight/light/holy-light.lpc",
        "/guilds/werric-knight/light/root.lpc");
}

