/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Light Magic");
    Description("This research tree represents the holy powers granted to those "
        "who serve the Oath with absolute dedication. Light Magic emphasizes "
        "protection, healing, and smiting evil - the divine blessing upon those "
        "who defend the innocent.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/light/root.lpc");
    TreeRoot("/guilds/werric-knight/light/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    TwentiethLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentyEighthLevel();
    ThirtiethLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    FortiethLevel();
    FortyFifthLevel();
    FiftiethLevel();
    FiftyThirdLevel();
    FiftySeventhLevel();
    SixtiethLevel();
    SixtyThirdLevel();
    SixtySixthLevel();
    SeventiethLevel();
}
