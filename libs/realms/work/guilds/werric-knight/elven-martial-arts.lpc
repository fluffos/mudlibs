/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Elven Martial Arts");
    Description("This research tree represents the elven combat techniques brought "
        "to Hillgarth by Daedrun, the elven master who trained King Werra. These "
        "graceful, precise methods blend elven artistry with human discipline.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/elven/root.lpc");
    TreeRoot("/guilds/werric-knight/elven/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    ThirtyFirstLevel();
}
