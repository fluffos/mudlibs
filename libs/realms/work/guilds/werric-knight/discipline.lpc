/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Discipline");
    Description("This research tree represents the art of training mind and body "
        "to peak performance. Through rigorous practice and unwavering commitment, "
        "Werric Knights push beyond normal human limitations, granting passive "
        "bonuses and resistances.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/discipline/root.lpc");
    TreeRoot("/guilds/werric-knight/discipline/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    TenthLevel();
    EleventhLevel();
    ThirteenthLevel();
    SixteenthLevel();
    SeventeenthLevel();
    TwentiethLevel();
    TwentyFifthLevel();
    ThirtiethLevel();
    ThirtyFifthLevel();
    FortiethLevel();
    FortyFifthLevel();
    FiftiethLevel();
    FiftyFifthLevel();
    SeventiethLevel();
}
