        "/guilds/werric-knight/defense/root.lpc");

    addResearchElement("/guilds/werric-knight/defense/positional-awareness.lpc");
    addChild("/guilds/werric-knight/defense/positional-awareness.lpc",
        "/guilds/werric-knight/defense/root.lpc");
}

