/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Defensive Tactics");
    Description("This research tree provides advanced defensive combat techniques, "
        "allowing knights to protect themselves and their allies through "
        "armor mastery, tactical positioning, and impenetrable defenses.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/defense/root.lpc");
    TreeRoot("/guilds/werric-knight/defense/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    ThirtyFirstLevel();
    FortiethLevel();
}
