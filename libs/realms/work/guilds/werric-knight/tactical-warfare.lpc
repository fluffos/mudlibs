/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Tactical Warfare");
    Description("This research tree represents the tactical and strategic mastery "
        "that made Hillgarath's armies legendary. Formation combat, coordinated "
        "strikes, and battlefield command transform individual warriors into an "
        "unstoppable tactical instrument.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/tactics/root.lpc");
    TreeRoot("/guilds/werric-knight/tactics/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
}
