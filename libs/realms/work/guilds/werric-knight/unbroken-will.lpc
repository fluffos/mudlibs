inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/werric-knight/will/iron-discipline.lpc");
    addChild("/guilds/werric-knight/will/iron-discipline.lpc",
        "/guilds/werric-knight/will/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/werric-knight/will/ignore-pain.lpc");
    addChild("/guilds/werric-knight/will/ignore-pain.lpc",
        "/guilds/werric-knight/will/iron-discipline.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/werric-knight/will/mind-fortress.lpc");
    addChild("/guilds/werric-knight/will/mind-fortress.lpc",
        "/guilds/werric-knight/will/ignore-pain.lpc");

    addResearchElement("/guilds/werric-knight/will/indomitable-spirit.lpc");
    addChild("/guilds/werric-knight/will/indomitable-spirit.lpc",
        "/guilds/werric-knight/will/mind-fortress.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/werric-knight/will/beyond-mortal-limits.lpc");
    addChild("/guilds/werric-knight/will/beyond-mortal-limits.lpc",
        "/guilds/werric-knight/will/indomitable-spirit.lpc");

    addResearchElement("/guilds/werric-knight/will/force-of-will.lpc");
    addChild("/guilds/werric-knight/will/force-of-will.lpc",
        "/guilds/werric-knight/will/beyond-mortal-limits.lpc");

    addResearchElement("/guilds/werric-knight/will/willpower-manifestation.lpc");
    addChild("/guilds/werric-knight/will/willpower-manifestation.lpc",
        "/guilds/werric-knight/will/force-of-will.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyThirdLevel()
{
    addResearchElement("/guilds/werric-knight/will/unyielding-endurance.lpc");
    addChild("/guilds/werric-knight/will/unyielding-endurance.lpc",
        "/guilds/werric-knight/will/force-of-will.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFifthLevel()
{
    addResearchElement("/guilds/werric-knight/will/will-made-manifest.lpc");
    addChild("/guilds/werric-knight/will/will-made-manifest.lpc",
        "/guilds/werric-knight/will/unyielding-endurance.lpc");

    addResearchElement("/guilds/werric-knight/will/absolute-determination.lpc");
    addChild("/guilds/werric-knight/will/absolute-determination.lpc",
        "/guilds/werric-knight/will/will-made-manifest.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentySeventhLevel()
{
    addResearchElement("/guilds/werric-knight/will/shatter-will.lpc");
    addChild("/guilds/werric-knight/will/shatter-will.lpc",
        "/guilds/werric-knight/will/absolute-determination.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyNinthLevel()
{
    addResearchElement("/guilds/werric-knight/will/transcendent-resolve.lpc");
    addChild("/guilds/werric-knight/will/transcendent-resolve.lpc",
        "/guilds/werric-knight/will/shatter-will.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyFirstLevel()
{
    addResearchElement("/guilds/werric-knight/will/impose-will.lpc");
    addChild("/guilds/werric-knight/will/impose-will.lpc",
        "/guilds/werric-knight/will/transcendent-resolve.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyThirdLevel()
{
    addResearchElement("/guilds/werric-knight/will/immortal-will.lpc");
    addChild("/guilds/werric-knight/will/immortal-will.lpc",
        "/guilds/werric-knight/will/impose-will.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyFifthLevel()
{
    addResearchElement("/guilds/werric-knight/will/avatar-of-determination.lpc");
    addChild("/guilds/werric-knight/will/avatar-of-determination.lpc",
        "/guilds/werric-knight/will/immortal-will.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtySeventhLevel()
{
    addResearchElement("/guilds/werric-knight/will/will-eternal.lpc");
    addChild("/guilds/werric-knight/will/will-eternal.lpc",
        "/guilds/werric-knight/will/avatar-of-determination.lpc");
