/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Unbroken Will");
    Description("This research tree is available only to Sworn Knights who have "
        "proven their dedication beyond question. It represents advanced disciplines "
        "of willpower and determination that push beyond mortal limits.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/will/root.lpc");
    TreeRoot("/guilds/werric-knight/will/root.lpc");

    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
}
