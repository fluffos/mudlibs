/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Sword Mastery");
    Description("This research tree provides mastery of the sword, "
        "the primary weapon of the Werric Knights.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/sword/root.lpc");
    TreeRoot("/guilds/werric-knight/sword/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyFifthLevel();
    ThirtyFirstLevel();
    ThirtyNinthLevel();
}
