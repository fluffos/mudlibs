inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void ThirtyFifthLevel()
{
    addResearchElement("/guilds/werric-knight/marshal/strategic-command.lpc");
    addChild("/guilds/werric-knight/marshal/strategic-command.lpc",
        "/guilds/werric-knight/marshal/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FortiethLevel()
{
    addResearchElement("/guilds/werric-knight/marshal/marshals-presence.lpc");
    addChild("/guilds/werric-knight/marshal/marshals-presence.lpc",
        "/guilds/werric-knight/marshal/strategic-command.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FortyFifthLevel()
{
    addResearchElement("/guilds/werric-knight/marshal/grand-strategy.lpc");
    addChild("/guilds/werric-knight/marshal/grand-strategy.lpc",
        "/guilds/werric-knight/marshal/marshals-presence.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FiftiethLevel()
{
    addResearchElement("/guilds/werric-knight/marshal/legendary-commander.lpc");
    addChild("/guilds/werric-knight/marshal/legendary-commander.lpc",
        "/guilds/werric-knight/marshal/grand-strategy.lpc");

    addResearchElement("/guilds/werric-knight/marshal/rally-armies.lpc");
    addChild("/guilds/werric-knight/marshal/rally-armies.lpc",
        "/guilds/werric-knight/marshal/legendary-commander.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FiftyFifthLevel()
{
    addResearchElement("/guilds/werric-knight/marshal/supreme-leadership.lpc");
    addChild("/guilds/werric-knight/marshal/supreme-leadership.lpc",
        "/guilds/werric-knight/marshal/rally-armies.lpc");

    addResearchElement("/guilds/werric-knight/marshal/master-of-war.lpc");
    addChild("/guilds/werric-knight/marshal/master-of-war.lpc",
        "/guilds/werric-knight/marshal/supreme-leadership.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SixtiethLevel()
{
    addResearchElement("/guilds/werric-knight/marshal/invincible-army.lpc");
    addChild("/guilds/werric-knight/marshal/invincible-army.lpc",
        "/guilds/werric-knight/marshal/master-of-war.lpc");

    addResearchElement("/guilds/werric-knight/marshal/werras-legacy-marshal.lpc");
    addChild("/guilds/werric-knight/marshal/werras-legacy-marshal.lpc",
        "/guilds/werric-knight/marshal/invincible-army.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SixtyFifthLevel()
{
    addResearchElement("/guilds/werric-knight/marshal/commanding-aura.lpc");
    addChild("/guilds/werric-knight/marshal/commanding-aura.lpc",
        "/guilds/werric-knight/marshal/werras-legacy-marshal.lpc");

    addResearchElement("/guilds/werric-knight/marshal/victorys-call.lpc");
    addChild("/guilds/werric-knight/marshal/victorys-call.lpc",
        "/guilds/werric-knight/marshal/commanding-aura.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventiethLevel()
{
    addResearchElement("/guilds/werric-knight/marshal/eternal-marshal.lpc");
    addChild("/guilds/werric-knight/marshal/eternal-marshal.lpc",
        "/guilds/werric-knight/marshal/victorys-call.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Lord Marshal's Command");
    Description("This research tree is available only to Lord Marshals - those who "
        "have achieved the highest rank within the Werric Knights. It represents "
        "the pinnacle of military leadership and strategic command.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/marshal/root.lpc");
    TreeRoot("/guilds/werric-knight/marshal/root.lpc");

    ThirtyFifthLevel();
    FortiethLevel();
    FortyFifthLevel();
    FiftiethLevel();
    FiftyFifthLevel();
    SixtiethLevel();
    SixtyFifthLevel();
    SeventiethLevel();
}
