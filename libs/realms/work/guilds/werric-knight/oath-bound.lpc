/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Oath-Bound");
    Description("This research tree represents the sacred Oath of Werric: "
        "'I am not my will.' Abilities that draw upon sworn dedication.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/oath/root.lpc");
    TreeRoot("/guilds/werric-knight/oath/root.lpc");

    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
}
