/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Knightly Virtues");
    Description("This research tree represents the principles of honor, courage, "
        "justice, and mercy that define what it means to be a true knight. These "
        "virtues are sources of tangible power for those who embody them.");
    Source("Werric Knight");
    addResearchElement("/guilds/werric-knight/virtues/root.lpc");
    TreeRoot("/guilds/werric-knight/virtues/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    TwentiethLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    ThirtiethLevel();
    ThirtyFifthLevel();
    FortiethLevel();
    FortyFifthLevel();
    FiftiethLevel();
    FiftyFifthLevel();
    SixtiethLevel();
    SeventiethLevel();
}

