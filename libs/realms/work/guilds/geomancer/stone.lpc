/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Path of Stone");
    Description("This research tree provides knowledge of stone-based "
        "spells and abilities for the geomancer.");
    Source("geomancer");
    addResearchElement("/guilds/geomancer/stone/root.lpc");
    TreeRoot("/guilds/geomancer/stone/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFirstLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FiftyFirstLevel();
    FiftySeventhLevel();
    SixtyThirdLevel();
    SixtySeventhLevel();
}
