inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/geomancer/functions/stone.lpc");
    addResearchElement("/guilds/geomancer/functions/earth.lpc");

    addChild("/guilds/geomancer/functions/stone.lpc",
        "/guilds/geomancer/functions/root.lpc");
    addChild("/guilds/geomancer/functions/earth.lpc",
        "/guilds/geomancer/functions/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/geomancer/functions/gravel.lpc");

    addChild("/guilds/geomancer/functions/gravel.lpc",
        "/guilds/geomancer/functions/earth.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/geomancer/functions/weight.lpc");

    addChild("/guilds/geomancer/functions/weight.lpc",
        "/guilds/geomancer/functions/earth.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/geomancer/functions/crystal.lpc");

    addChild("/guilds/geomancer/functions/crystal.lpc",
        "/guilds/geomancer/functions/stone.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/geomancer/functions/sand.lpc");

    addChild("/guilds/geomancer/functions/sand.lpc",
        "/guilds/geomancer/functions/gravel.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/geomancer/functions/entombing.lpc");

    addChild("/guilds/geomancer/functions/entombing.lpc",
        "/guilds/geomancer/functions/gravel.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/geomancer/functions/crushing.lpc");

    addChild("/guilds/geomancer/functions/crushing.lpc",
        "/guilds/geomancer/functions/entombing.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/geomancer/functions/tectonic.lpc");

    addChild("/guilds/geomancer/functions/tectonic.lpc",
        "/guilds/geomancer/functions/crystal.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/geomancer/functions/magma.lpc");

    addChild("/guilds/geomancer/functions/magma.lpc",
        "/guilds/geomancer/functions/sand.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/geomancer/functions/seismic.lpc");

    addChild("/guilds/geomancer/functions/seismic.lpc",
        "/guilds/geomancer/functions/tectonic.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Kinetics");
    Description("This research tree provides knowledge of the various damage "
        "types and propulsion mechanisms for constructed geomancer spells.");
    Source("geomancer");
    addResearchElement("/guilds/geomancer/functions/root.lpc");
    TreeRoot("/guilds/geomancer/functions/root.lpc");

    FirstLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
}
