inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/geomancer/forms/arc.lpc");
    addResearchElement("/guilds/geomancer/forms/touch.lpc");
    addResearchElement("/guilds/geomancer/forms/burst.lpc");

    addChild("/guilds/geomancer/forms/arc.lpc",
        "/guilds/geomancer/forms/root.lpc");
    addChild("/guilds/geomancer/forms/touch.lpc",
        "/guilds/geomancer/forms/root.lpc");
    addChild("/guilds/geomancer/forms/burst.lpc",
        "/guilds/geomancer/forms/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/geomancer/forms/bolt.lpc");
    addResearchElement("/guilds/geomancer/forms/cloud.lpc");
    addResearchElement("/guilds/geomancer/forms/pebble.lpc");

    addChild("/guilds/geomancer/forms/bolt.lpc",
        "/guilds/geomancer/forms/arc.lpc");
    addChild("/guilds/geomancer/forms/cloud.lpc",
        "/guilds/geomancer/forms/touch.lpc");
    addChild("/guilds/geomancer/forms/pebble.lpc",
        "/guilds/geomancer/forms/burst.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/geomancer/forms/blade.lpc");
    addResearchElement("/guilds/geomancer/forms/tendril.lpc");

    addChild("/guilds/geomancer/forms/blade.lpc",
        "/guilds/geomancer/forms/bolt.lpc");
    addChild("/guilds/geomancer/forms/tendril.lpc",
        "/guilds/geomancer/forms/pebble.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/geomancer/forms/ball.lpc");
    addResearchElement("/guilds/geomancer/forms/spear.lpc");
    addResearchElement("/guilds/geomancer/forms/spray.lpc");

    addChild("/guilds/geomancer/forms/ball.lpc",
        "/guilds/geomancer/forms/bolt.lpc");
    addChild("/guilds/geomancer/forms/spear.lpc",
        "/guilds/geomancer/forms/blade.lpc");
    addChild("/guilds/geomancer/forms/spray.lpc",
        "/guilds/geomancer/forms/cloud.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/geomancer/forms/blast.lpc");
    addResearchElement("/guilds/geomancer/forms/wave.lpc");
    addResearchElement("/guilds/geomancer/forms/razor.lpc");

    addChild("/guilds/geomancer/forms/blast.lpc",
        "/guilds/geomancer/forms/ball.lpc");
    addChild("/guilds/geomancer/forms/wave.lpc",
        "/guilds/geomancer/forms/cloud.lpc");
    addChild("/guilds/geomancer/forms/razor.lpc",
        "/guilds/geomancer/forms/tendril.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/geomancer/forms/orb.lpc");
    addResearchElement("/guilds/geomancer/forms/ring.lpc");

    addChild("/guilds/geomancer/forms/orb.lpc",
        "/guilds/geomancer/forms/blast.lpc");
    addChild("/guilds/geomancer/forms/ring.lpc",
        "/guilds/geomancer/forms/wave.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/geomancer/forms/wall.lpc");
    addResearchElement("/guilds/geomancer/forms/cage.lpc");
    addResearchElement("/guilds/geomancer/forms/lance.lpc");

    addChild("/guilds/geomancer/forms/wall.lpc",
        "/guilds/geomancer/forms/wave.lpc");
    addChild("/guilds/geomancer/forms/cage.lpc",
        "/guilds/geomancer/forms/ring.lpc");
    addChild("/guilds/geomancer/forms/lance.lpc",
        "/guilds/geomancer/forms/spear.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/geomancer/forms/eruption.lpc");
    addResearchElement("/guilds/geomancer/forms/strike.lpc");

    addChild("/guilds/geomancer/forms/eruption.lpc",
        "/guilds/geomancer/forms/orb.lpc");
    addChild("/guilds/geomancer/forms/strike.lpc",
        "/guilds/geomancer/forms/lance.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/geomancer/forms/coil.lpc");
    addResearchElement("/guilds/geomancer/forms/vortex.lpc");

    addChild("/guilds/geomancer/forms/coil.lpc",
        "/guilds/geomancer/forms/cage.lpc");
    addChild("/guilds/geomancer/forms/vortex.lpc",
        "/guilds/geomancer/forms/eruption.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/geomancer/forms/pulse.lpc");
    addResearchElement("/guilds/geomancer/forms/quake.lpc");

    addChild("/guilds/geomancer/forms/pulse.lpc",
        "/guilds/geomancer/forms/coil.lpc");
    addChild("/guilds/geomancer/forms/quake.lpc",
        "/guilds/geomancer/forms/vortex.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/geomancer/forms/avalanche.lpc");

    addChild("/guilds/geomancer/forms/avalanche.lpc",
        "/guilds/geomancer/forms/strike.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyThirdLevel()
{
    addResearchElement("/guilds/geomancer/forms/cataclysm.lpc");

    addChild("/guilds/geomancer/forms/cataclysm.lpc",
        "/guilds/geomancer/forms/quake.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Spell Forms");
    Description("This research tree provides knowledge of the various forms "
        "that constructed geomancer spells can take.");
    Source("geomancer");
    addResearchElement("/guilds/geomancer/forms/root.lpc");
    TreeRoot("/guilds/geomancer/forms/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
}
