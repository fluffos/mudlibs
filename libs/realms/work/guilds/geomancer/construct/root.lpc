inherit "/lib/modules/research/constructedActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Constructed Geomancer Spells");
    addSpecification("source", "geomancer");
    addSpecification("description", "This skill provides the user with the "
        "knowledge of casting constructed spells that can provide "
        "complex effects.");

    addSpecification("constructed rules", ([
        "form must include only one of": ({
            "/guilds/geomancer/forms/arc.lpc",
            "/guilds/geomancer/forms/ball.lpc",
            "/guilds/geomancer/forms/blade.lpc",
            "/guilds/geomancer/forms/blast.lpc",
            "/guilds/geomancer/forms/bolt.lpc",
            "/guilds/geomancer/forms/burst.lpc",
            "/guilds/geomancer/forms/cage.lpc",
            "/guilds/geomancer/forms/cataclysm.lpc",
            "/guilds/geomancer/forms/cloud.lpc",
            "/guilds/geomancer/forms/coil.lpc",
            "/guilds/geomancer/forms/eruption.lpc",
            "/guilds/geomancer/forms/avalanche.lpc",
            "/guilds/geomancer/forms/lance.lpc",
            "/guilds/geomancer/forms/orb.lpc",
            "/guilds/geomancer/forms/pebble.lpc",
            "/guilds/geomancer/forms/pulse.lpc",
            "/guilds/geomancer/forms/quake.lpc",
            "/guilds/geomancer/forms/razor.lpc",
            "/guilds/geomancer/forms/ring.lpc",
            "/guilds/geomancer/forms/spear.lpc",
            "/guilds/geomancer/forms/spray.lpc",
            "/guilds/geomancer/forms/strike.lpc",
            "/guilds/geomancer/forms/tendril.lpc",
            "/guilds/geomancer/forms/touch.lpc",
            "/guilds/geomancer/forms/vortex.lpc",
            "/guilds/geomancer/forms/wall.lpc",
            "/guilds/geomancer/forms/wave.lpc",
        }),
        "function must include only one of": ({
            "/guilds/geomancer/functions/stone.lpc",
            "/guilds/geomancer/functions/earth.lpc",
            "/guilds/geomancer/functions/gravel.lpc",
            "/guilds/geomancer/functions/weight.lpc",
            "/guilds/geomancer/functions/crystal.lpc",
            "/guilds/geomancer/functions/sand.lpc",
            "/guilds/geomancer/functions/entombing.lpc",
            "/guilds/geomancer/functions/crushing.lpc",
            "/guilds/geomancer/functions/tectonic.lpc",
            "/guilds/geomancer/functions/magma.lpc",
            "/guilds/geomancer/functions/seismic.lpc",
        }),
        "effect must include any of": ({
            "/guilds/geomancer/effects/damage-hp.lpc",
            "/guilds/geomancer/effects/damage-sp.lpc",
            "/guilds/geomancer/effects/damage-stamina.lpc",
            "/guilds/geomancer/effects/add-hp.lpc",
            "/guilds/geomancer/effects/add-sp.lpc",
            "/guilds/geomancer/effects/add-stamina.lpc",
            "/guilds/geomancer/effects/siphon-hp.lpc",
            "/guilds/geomancer/effects/siphon-sp.lpc",
            "/guilds/geomancer/effects/siphon-stamina.lpc",
            "/guilds/geomancer/effects/enhance-attack.lpc",
            "/guilds/geomancer/effects/enhance-damage.lpc",
            "/guilds/geomancer/effects/enhance-defense.lpc",
            "/guilds/geomancer/effects/enhance-soak.lpc",
            "/guilds/geomancer/effects/enhance-dodge.lpc",
            "/guilds/geomancer/effects/enhance-parry.lpc",
            "/guilds/geomancer/effects/enhance-speed.lpc",
            "/guilds/geomancer/effects/reduce-attack.lpc",
            "/guilds/geomancer/effects/reduce-damage.lpc",
            "/guilds/geomancer/effects/reduce-defense.lpc",
            "/guilds/geomancer/effects/reduce-soak.lpc",
            "/guilds/geomancer/effects/reduce-dodge.lpc",
            "/guilds/geomancer/effects/reduce-parry.lpc",
            "/guilds/geomancer/effects/apply-slow.lpc",
            "/guilds/geomancer/effects/apply-enfeebled.lpc",
            "/guilds/geomancer/effects/staggering-damage.lpc",
            "/guilds/geomancer/effects/debilitating-damage.lpc",
            "/guilds/geomancer/effects/disorienting-damage.lpc",
            "/guilds/geomancer/effects/hampering-damage.lpc",
            "/guilds/geomancer/effects/exhausting-damage.lpc",
            "/guilds/geomancer/effects/invigorating-siphon.lpc",
            "/guilds/geomancer/effects/fortifying-siphon.lpc",
        }),
    ]));

    addSpecification("cooldown", 60);
    addSpecification("cooldown modifiers", ([
        "/guilds/geomancer/construct/efficient-casting.lpc": 10,
        "/guilds/geomancer/construct/improved-efficiency.lpc": 10,
        "/guilds/geomancer/construct/expert-efficiency.lpc": 10,
        "/guilds/geomancer/construct/master-efficiency.lpc": 10,
        "/guilds/geomancer/construct/grandmaster-efficiency.lpc": 5,
        "/guilds/geomancer/construct/legendary-efficiency.lpc": 5,
    ]));

    addSpecification("scope", "area");
    addSpecification("research type", "tree root");
    addSpecification("command name", "cast");
    addSpecification("command template", "cast geomancer ##Value##");
    addSpecification("use ability message", "##InitiatorName## "
        "##Infinitive::cast## a spell...");
}
