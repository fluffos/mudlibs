/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Path of Earth");
    Description("This research tree provides knowledge of earth-based spells "
        "and abilities for the geomancer.");
    Source("geomancer");
    addResearchElement("/guilds/geomancer/earth/root.lpc");
    TreeRoot("/guilds/geomancer/earth/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFifthLevel();
    FortySeventhLevel();
    FiftyFirstLevel();
    FiftySeventhLevel();
    SixtyThirdLevel();
    SixtySeventhLevel();
}
