/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Nightmare Persona");
    Description("This research tree provides knowledge of adopting nightmare "
        "personas - dark identities drawn from the realm of dreams. These "
        "personas grant passive abilities that enhance the oneiromancers "
        "power, protect their mind, and instill fear in their enemies.");
    Source("oneiromancer");
    addResearchElement("/guilds/oneiromancer/nightmare-persona/persona-root.lpc");
    TreeRoot("/guilds/oneiromancer/nightmare-persona/persona-root.lpc");

    FifthLevel();
    NinthLevel();
    ThirteenthLevel();
    SeventeenthLevel();
    TwentyFirstLevel();
    TwentyFifthLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    FortyFirstLevel();
    FortyFifthLevel();
    FiftyFirstLevel();
    FiftyThirdLevel();
    FiftySeventhLevel();
    SixtyFirstLevel();
    SixtyFifthLevel();
    SixtySeventhLevel();
}
