inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/oneiromancer/psychic-siphon/mental-leech.lpc");

    addChild("/guilds/oneiromancer/psychic-siphon/mental-leech.lpc",
        "/guilds/oneiromancer/psychic-siphon/siphon-root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/oneiromancer/psychic-siphon/drain-essence.lpc");

    addChild("/guilds/oneiromancer/psychic-siphon/drain-essence.lpc",
        "/guilds/oneiromancer/psychic-siphon/mental-leech.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/oneiromancer/psychic-siphon/improved-siphon.lpc");
    addResearchElement("/guilds/oneiromancer/psychic-siphon/life-tap.lpc");

    addChild("/guilds/oneiromancer/psychic-siphon/improved-siphon.lpc",
        "/guilds/oneiromancer/psychic-siphon/drain-essence.lpc");
    addChild("/guilds/oneiromancer/psychic-siphon/life-tap.lpc",
        "/guilds/oneiromancer/psychic-siphon/drain-essence.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/oneiromancer/psychic-siphon/efficient-drain.lpc");

    addChild("/guilds/oneiromancer/psychic-siphon/efficient-drain.lpc",
        "/guilds/oneiromancer/psychic-siphon/improved-siphon.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/oneiromancer/psychic-siphon/master-siphon.lpc");

    addChild("/guilds/oneiromancer/psychic-siphon/master-siphon.lpc",
        "/guilds/oneiromancer/psychic-siphon/efficient-drain.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Psychic Siphon");
    Description("This research tree provides knowledge of draining mental "
        "energy from enemies to restore the caster. These techniques allow "
        "the psion to sustain themselves in extended combat. Available only "
        "to psions and masters.");
    Source("oneiromancer");
    addResearchElement("/guilds/oneiromancer/psychic-siphon/siphon-root.lpc");
    TreeRoot("/guilds/oneiromancer/psychic-siphon/siphon-root.lpc");

    FirstLevel();
    FifthLevel();
    NinthLevel();
    ThirteenthLevel();
    SeventeenthLevel();
}
