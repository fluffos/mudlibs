inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/oneiromancer/dream-dominion/sovereign-will.lpc");

    addChild("/guilds/oneiromancer/dream-dominion/sovereign-will.lpc",
        "/guilds/oneiromancer/dream-dominion/dominion-root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/oneiromancer/dream-dominion/absolute-command.lpc");
    addResearchElement("/guilds/oneiromancer/dream-dominion/reality-warp.lpc");

    addChild("/guilds/oneiromancer/dream-dominion/absolute-command.lpc",
        "/guilds/oneiromancer/dream-dominion/sovereign-will.lpc");
    addChild("/guilds/oneiromancer/dream-dominion/reality-warp.lpc",
        "/guilds/oneiromancer/dream-dominion/sovereign-will.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/oneiromancer/dream-dominion/mind-crush.lpc");

    addChild("/guilds/oneiromancer/dream-dominion/mind-crush.lpc",
        "/guilds/oneiromancer/dream-dominion/absolute-command.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/oneiromancer/dream-dominion/enhanced-dominion.lpc");
    addResearchElement("/guilds/oneiromancer/dream-dominion/dream-mastery.lpc");

    addChild("/guilds/oneiromancer/dream-dominion/enhanced-dominion.lpc",
        "/guilds/oneiromancer/dream-dominion/mind-crush.lpc");
    addChild("/guilds/oneiromancer/dream-dominion/dream-mastery.lpc",
        "/guilds/oneiromancer/dream-dominion/reality-warp.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/oneiromancer/dream-dominion/absolute-dominion.lpc");

    addChild("/guilds/oneiromancer/dream-dominion/absolute-dominion.lpc",
        "/guilds/oneiromancer/dream-dominion/enhanced-dominion.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Dream Dominion");
    Description("This research tree provides knowledge of absolute mastery "
        "over the dream realm. These techniques represent the pinnacle of "
        "oneiromantic power. Available only to masters.");
    Source("oneiromancer");
    addResearchElement("/guilds/oneiromancer/dream-dominion/dominion-root.lpc");
    TreeRoot("/guilds/oneiromancer/dream-dominion/dominion-root.lpc");

    FirstLevel();
    FifthLevel();
    NinthLevel();
    ThirteenthLevel();
    SeventeenthLevel();
}
