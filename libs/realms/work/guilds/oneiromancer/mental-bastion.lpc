inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/oneiromancer/mental-bastion/iron-will.lpc");

    addChild("/guilds/oneiromancer/mental-bastion/iron-will.lpc",
        "/guilds/oneiromancer/mental-bastion/bastion-root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/oneiromancer/mental-bastion/thought-shield.lpc");
    addResearchElement("/guilds/oneiromancer/mental-bastion/mental-armor.lpc");

    addChild("/guilds/oneiromancer/mental-bastion/thought-shield.lpc",
        "/guilds/oneiromancer/mental-bastion/iron-will.lpc");
    addChild("/guilds/oneiromancer/mental-bastion/mental-armor.lpc",
        "/guilds/oneiromancer/mental-bastion/iron-will.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/oneiromancer/mental-bastion/psychic-barrier.lpc");

    addChild("/guilds/oneiromancer/mental-bastion/psychic-barrier.lpc",
        "/guilds/oneiromancer/mental-bastion/thought-shield.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/oneiromancer/mental-bastion/fortified-mind.lpc");
    addResearchElement("/guilds/oneiromancer/mental-bastion/resilient-psyche.lpc");

    addChild("/guilds/oneiromancer/mental-bastion/fortified-mind.lpc",
        "/guilds/oneiromancer/mental-bastion/psychic-barrier.lpc");
    addChild("/guilds/oneiromancer/mental-bastion/resilient-psyche.lpc",
        "/guilds/oneiromancer/mental-bastion/mental-armor.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/oneiromancer/mental-bastion/impenetrable-mind.lpc");

    addChild("/guilds/oneiromancer/mental-bastion/impenetrable-mind.lpc",
        "/guilds/oneiromancer/mental-bastion/fortified-mind.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Mental Bastion");
    Description("This research tree provides knowledge of fortifying the "
        "mind against attack. These techniques improve mental and magical "
        "resistance. Available only to mentalists and higher ranks.");
    Source("oneiromancer");
    addResearchElement("/guilds/oneiromancer/mental-bastion/bastion-root.lpc");
    TreeRoot("/guilds/oneiromancer/mental-bastion/bastion-root.lpc");

    FirstLevel();
    FifthLevel();
    NinthLevel();
    ThirteenthLevel();
    SeventeenthLevel();
}
