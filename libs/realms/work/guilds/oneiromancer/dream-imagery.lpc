/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Dream Imagery");
    Description("This research tree provides knowledge of weaving nightmare "
        "imagery into psionic attacks. These terrifying visions enhance "
        "combination attacks with additional damage types and debilitating "
        "effects drawn from the deepest fears of mortal minds.");
    Source("oneiromancer");
    addResearchElement("/guilds/oneiromancer/dream-imagery/imagery-root.lpc");
    TreeRoot("/guilds/oneiromancer/dream-imagery/imagery-root.lpc");

    FirstLevel();
    ThirdLevel();
    SeventhLevel();
    NinthLevel();
    ThirteenthLevel();
    FifteenthLevel();
    NineteenthLevel();
    TwentyThirdLevel();
    TwentySeventhLevel();
    ThirtyFirstLevel();
    ThirtyFifthLevel();
    ThirtyNinthLevel();
    FortyThirdLevel();
    FortySeventhLevel();
    FiftyFirstLevel();
    FiftyFifthLevel();
    FiftyNinthLevel();
    SixtySeventhLevel();
}
