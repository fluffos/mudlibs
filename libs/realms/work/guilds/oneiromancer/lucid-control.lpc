inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/oneiromancer/lucid-control/clarity-of-purpose.lpc");

    addChild("/guilds/oneiromancer/lucid-control/clarity-of-purpose.lpc",
        "/guilds/oneiromancer/lucid-control/lucid-root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/oneiromancer/lucid-control/focused-dreaming.lpc");
    addResearchElement("/guilds/oneiromancer/lucid-control/waking-trance.lpc");

    addChild("/guilds/oneiromancer/lucid-control/focused-dreaming.lpc",
        "/guilds/oneiromancer/lucid-control/clarity-of-purpose.lpc");
    addChild("/guilds/oneiromancer/lucid-control/waking-trance.lpc",
        "/guilds/oneiromancer/lucid-control/clarity-of-purpose.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/oneiromancer/lucid-control/lucid-burst.lpc");

    addChild("/guilds/oneiromancer/lucid-control/lucid-burst.lpc",
        "/guilds/oneiromancer/lucid-control/focused-dreaming.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/oneiromancer/lucid-control/enhanced-clarity.lpc");
    addResearchElement("/guilds/oneiromancer/lucid-control/sustained-focus.lpc");

    addChild("/guilds/oneiromancer/lucid-control/enhanced-clarity.lpc",
        "/guilds/oneiromancer/lucid-control/lucid-burst.lpc");
    addChild("/guilds/oneiromancer/lucid-control/sustained-focus.lpc",
        "/guilds/oneiromancer/lucid-control/waking-trance.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/oneiromancer/lucid-control/perfect-lucidity.lpc");

    addChild("/guilds/oneiromancer/lucid-control/perfect-lucidity.lpc",
        "/guilds/oneiromancer/lucid-control/enhanced-clarity.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Lucid Control");
    Description("This research tree provides knowledge of maintaining lucid "
        "awareness while channeling dream energy. These techniques improve "
        "spell efficiency and mental clarity. Available only to adepts and "
        "higher ranks.");
    Source("oneiromancer");
    addResearchElement("/guilds/oneiromancer/lucid-control/lucid-root.lpc");
    TreeRoot("/guilds/oneiromancer/lucid-control/lucid-root.lpc");

    FirstLevel();
    ThirdLevel();
    SeventhLevel();
    EleventhLevel();
    FifteenthLevel();
}
