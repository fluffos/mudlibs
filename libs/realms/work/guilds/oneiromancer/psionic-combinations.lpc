inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/layered-assault.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/layered-assault.lpc",
        "/guilds/oneiromancer/psionic-combinations/combination-root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/mental-momentum.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/mental-momentum.lpc",
        "/guilds/oneiromancer/psionic-combinations/layered-assault.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/triple-thread.lpc");
    addResearchElement("/guilds/oneiromancer/psionic-combinations/cascading-thoughts.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/triple-thread.lpc",
        "/guilds/oneiromancer/psionic-combinations/mental-momentum.lpc");
    addChild("/guilds/oneiromancer/psionic-combinations/cascading-thoughts.lpc",
        "/guilds/oneiromancer/psionic-combinations/mental-momentum.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/swift-nightmare.lpc");
    addResearchElement("/guilds/oneiromancer/psionic-combinations/amplified-horror.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/swift-nightmare.lpc",
        "/guilds/oneiromancer/psionic-combinations/cascading-thoughts.lpc");
    addChild("/guilds/oneiromancer/psionic-combinations/amplified-horror.lpc",
        "/guilds/oneiromancer/psionic-combinations/cascading-thoughts.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/woven-terror.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/woven-terror.lpc",
        "/guilds/oneiromancer/psionic-combinations/triple-thread.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFifthLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/quadruple-thread.lpc");
    addResearchElement("/guilds/oneiromancer/psionic-combinations/efficient-weaving.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/quadruple-thread.lpc",
        "/guilds/oneiromancer/psionic-combinations/woven-terror.lpc");
    addChild("/guilds/oneiromancer/psionic-combinations/efficient-weaving.lpc",
        "/guilds/oneiromancer/psionic-combinations/swift-nightmare.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyNinthLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/relentless-horror.lpc");
    addResearchElement("/guilds/oneiromancer/psionic-combinations/devastating-focus.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/relentless-horror.lpc",
        "/guilds/oneiromancer/psionic-combinations/efficient-weaving.lpc");
    addChild("/guilds/oneiromancer/psionic-combinations/devastating-focus.lpc",
        "/guilds/oneiromancer/psionic-combinations/amplified-horror.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyThirdLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/quintuple-thread.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/quintuple-thread.lpc",
        "/guilds/oneiromancer/psionic-combinations/quadruple-thread.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtySeventhLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/nightmare-mastery.lpc");
    addResearchElement("/guilds/oneiromancer/psionic-combinations/terror-weaver.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/nightmare-mastery.lpc",
        "/guilds/oneiromancer/psionic-combinations/devastating-focus.lpc");
    addChild("/guilds/oneiromancer/psionic-combinations/terror-weaver.lpc",
        "/guilds/oneiromancer/psionic-combinations/relentless-horror.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FortyFirstLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/sextuple-thread.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/sextuple-thread.lpc",
        "/guilds/oneiromancer/psionic-combinations/quintuple-thread.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FortyFifthLevel()
{
    addResearchElement("/guilds/oneiromancer/psionic-combinations/dream-lord.lpc");

    addChild("/guilds/oneiromancer/psionic-combinations/dream-lord.lpc",
        "/guilds/oneiromancer/psionic-combinations/nightmare-mastery.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Psionic Combinations");
    Description("This research tree provides knowledge of weaving multiple "
        "psionic techniques into devastating combination attacks. Master "
        "the art of layering mental assaults, dream imagery, and projection "
        "methods for maximum effect.");
    Source("oneiromancer");
    addResearchElement("/guilds/oneiromancer/psionic-combinations/combination-root.lpc");
    TreeRoot("/guilds/oneiromancer/psionic-combinations/combination-root.lpc");

    FifthLevel();
    NinthLevel();
    ThirteenthLevel();
    SeventeenthLevel();
    TwentyFirstLevel();
    TwentyFifthLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    FortyFirstLevel();
    FortyFifthLevel();
}
