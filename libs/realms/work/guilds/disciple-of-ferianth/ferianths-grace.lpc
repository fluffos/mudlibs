inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void ThirtyFifthLevel()
{
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/exarchs-resolve.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/divine-favor.lpc");

    addChild("/guilds/disciple-of-ferianth/ferianths-grace/exarchs-resolve.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/root.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/divine-favor.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtySeventhLevel()
{
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/ferianthian-blessing.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/ferianthian-judgment.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/exarchs-fortitude.lpc");

    addChild("/guilds/disciple-of-ferianth/ferianths-grace/ferianthian-blessing.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/exarchs-resolve.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/ferianthian-judgment.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/exarchs-resolve.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/exarchs-fortitude.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/exarchs-resolve.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FortyFirstLevel()
{
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/rebirth-from-ashes.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/grace-potency.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/divine-resilience.lpc");

    addChild("/guilds/disciple-of-ferianth/ferianths-grace/rebirth-from-ashes.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/exarchs-fortitude.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/grace-potency.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/ferianthian-blessing.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/divine-resilience.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/ferianthian-judgment.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FortyFifthLevel()
{
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/exalted-blessing.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/righteous-fury.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/divine-sanctuary.lpc");

    addChild("/guilds/disciple-of-ferianth/ferianths-grace/exalted-blessing.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/grace-potency.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/righteous-fury.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/divine-resilience.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/divine-sanctuary.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/rebirth-from-ashes.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FortyNinthLevel()
{
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/exarchs-blessing.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/divine-wrath.lpc");

    addChild("/guilds/disciple-of-ferianth/ferianths-grace/exarchs-blessing.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/exalted-blessing.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/divine-wrath.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/righteous-fury.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FiftyThirdLevel()
{
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/divine-judgment.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/eternal-protection.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/holy-bastion.lpc");

    addChild("/guilds/disciple-of-ferianth/ferianths-grace/divine-judgment.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/divine-wrath.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/eternal-protection.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/exarchs-blessing.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/holy-bastion.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/divine-sanctuary.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FiftySeventhLevel()
{
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/harbinger-of-ferianth.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/grace-mastery.lpc");

    addChild("/guilds/disciple-of-ferianth/ferianths-grace/harbinger-of-ferianth.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/divine-judgment.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/grace-mastery.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/eternal-protection.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SixtyFirstLevel()
{
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/ferianths-chosen.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/divine-vessel.lpc");

    addChild("/guilds/disciple-of-ferianth/ferianths-grace/ferianths-chosen.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/harbinger-of-ferianth.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/divine-vessel.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/holy-bastion.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SixtyFifthLevel()
{
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/eternal-flame.lpc");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/apocalyptic-judgment.lpc");

    addChild("/guilds/disciple-of-ferianth/ferianths-grace/eternal-flame.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/divine-vessel.lpc");
    addChild("/guilds/disciple-of-ferianth/ferianths-grace/apocalyptic-judgment.lpc",
        "/guilds/disciple-of-ferianth/ferianths-grace/ferianths-chosen.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Ferianth's Grace");
    Description("This research tree provides knowledge of Ferianth's most "
        "powerful divine blessings - miracles granted only to those who "
        "have achieved the rank of Exarch.");
    Source("disciple of ferianth");
    addResearchElement("/guilds/disciple-of-ferianth/ferianths-grace/root.lpc");
    TreeRoot("/guilds/disciple-of-ferianth/ferianths-grace/root.lpc");

    ThirtyFifthLevel();
    ThirtySeventhLevel();
    FortyFirstLevel();
    FortyFifthLevel();
    FortyNinthLevel();
    FiftyThirdLevel();
    FiftySeventhLevel();
    SixtyFirstLevel();
    SixtyFifthLevel();
}
