inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Searing Touch");
    addSpecification("source", "disciple of ferianth");
    addSpecification("description", "This skill enhances your combat abilities "
        "while in conduit form, your attacks carrying divine heat.");

    addSpecification("limited by", ([
        "research active": ({
            "/guilds/disciple-of-ferianth/flame-conduit/conduit-root.lpc"
        })
    ]));

    addPrerequisite("level",
        (["type": "level",
            "guild": "Disciple of Ferianth",
            "value": 29
        ]));

    addPrerequisite("/guilds/disciple-of-ferianth/flame-conduit/radiant-presence.lpc",
        (["type": "research"]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus attack", 3);
    addSpecification("bonus elemental fire", 2);
}
