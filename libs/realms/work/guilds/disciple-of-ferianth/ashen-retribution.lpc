protected void Setup()
{
    Name("Ashen Retribution");
    Description("This research tree provides knowledge of defensive fire magic "
        "and the protective aspect of Ferianth's sacred flames.");
    Source("disciple of ferianth");
    addResearchElement("/guilds/disciple-of-ferianth/ashen-retribution/root.lpc");
    TreeRoot("/guilds/disciple-of-ferianth/ashen-retribution/root.lpc");

    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FourteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    EighteenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentySecondLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySixthLevel();
    ThirtiethLevel();
    ThirtyFourthLevel();
    ThirtyEighthLevel();
    FortySecondLevel();
    FortySixthLevel();
    FiftiethLevel();
}
