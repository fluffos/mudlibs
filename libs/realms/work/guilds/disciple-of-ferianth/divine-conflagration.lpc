protected void Setup()
{
    Name("Divine Conflagration");
    Description("This research tree provides knowledge of summoning and "
        "enhancing a flame guardian - a divine servant of Ferianth formed "
        "of sacred fire.");
    Source("disciple of ferianth");
    addResearchElement("/guilds/disciple-of-ferianth/divine-conflagration/root.lpc");
    TreeRoot("/guilds/disciple-of-ferianth/divine-conflagration/root.lpc");

    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
