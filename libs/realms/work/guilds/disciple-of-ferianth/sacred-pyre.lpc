/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Sacred Pyre");
    Description("This research tree provides knowledge of Ferianth's sacred "
        "rituals and prayers. Through study of the sacred pyre, practitioners "
        "learn to perform powerful divine rites and gain permanent blessings.");
    Source("disciple of ferianth");
    addResearchElement("/guilds/disciple-of-ferianth/sacred-pyre/root.lpc");
    TreeRoot("/guilds/disciple-of-ferianth/sacred-pyre/root.lpc");

    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SixteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentiethLevel();
    TwentyThirdLevel();
    TwentyFourthLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyEighthLevel();
    ThirtySecondLevel();
    ThirtySixthLevel();
    FortiethLevel();
    FortyFourthLevel();
    FortyEighthLevel();
    FiftiethLevel();
}
