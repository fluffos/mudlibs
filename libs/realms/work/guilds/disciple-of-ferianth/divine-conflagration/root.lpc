inherit "/lib/modules/research/summoningResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Summon Flame Guardian");
    addSpecification("source", "disciple of ferianth");

    addSpecification("description", "This skill provides the user with the "
        "knowledge of summoning a flame guardian - a divine servant of "
        "Ferianth formed of sacred fire. The guardian fights alongside "
        "its summoner and can be enhanced through further research.");

    addSpecification("number to summon", 1);
    addSpecification("maximum that can be summoned", 1);
    addSpecification("persona", "flame guardian");

    addSpecification("modifiers", ([
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-fortitude-i.lpc":({
            (["modifier": "bonus hit points",
               "value": 100 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-fortitude-ii.lpc":({
            (["modifier": "bonus hit points",
               "value": 150 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-fortitude-iii.lpc":({
            (["modifier": "bonus hit points",
               "value": 200 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-defense-i.lpc":({
            (["modifier": "bonus defense",
               "value": 5 ]),
            (["modifier": "bonus soak",
               "value": 2 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-defense-ii.lpc":({
            (["modifier": "bonus defense",
               "value": 8 ]),
            (["modifier": "bonus soak",
               "value": 3 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-defense-iii.lpc":({
            (["modifier": "bonus defense",
               "value": 10 ]),
            (["modifier": "bonus soak",
               "value": 4 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-attack-i.lpc":({
            (["modifier": "bonus attack",
               "value": 5 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-attack-ii.lpc":({
            (["modifier": "bonus attack",
               "value": 8 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-attack-iii.lpc":({
            (["modifier": "bonus attack",
               "value": 10 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-damage-i.lpc":({
            (["modifier": "bonus damage",
               "value": 3 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-damage-ii.lpc":({
            (["modifier": "bonus damage",
               "value": 5 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-damage-iii.lpc":({
            (["modifier": "bonus damage",
               "value": 7 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-fire-i.lpc":({
            (["modifier": "bonus fire attack",
               "value": 10 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-fire-ii.lpc":({
            (["modifier": "bonus fire attack",
               "value": 15 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/guardian-fire-iii.lpc":({
            (["modifier": "bonus fire attack",
               "value": 20 ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/searing-strikes.lpc":({
            (["modifier": "apply research",
               "value": "/guilds/disciple-of-ferianth/divine-conflagration/searing-strikes-spell.lpc" ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/blazing-wrath.lpc":({
            (["modifier": "apply research",
               "value": "/guilds/disciple-of-ferianth/divine-conflagration/blazing-wrath-spell.lpc" ]),
        }),
        "/guilds/disciple-of-ferianth/divine-conflagration/divine-immolation.lpc":({
            (["modifier": "apply research",
               "value": "/guilds/disciple-of-ferianth/divine-conflagration/divine-immolation-spell.lpc" ]),
        }),
    ]));

    addSpecification("scope", "self");
    addSpecification("research type", "tree root");

    addSpecification("spell point cost", 150);
    addSpecification("stamina point cost", 75);
    addSpecification("cooldown", 300);

    addSpecification("event handler", "summonFlameGuardianEvent");
    addSpecification("command template", "summon flame guardian");
    addSpecification("use ability message", "##InitiatorName## "
        "##Infinitive::call## upon Ferianth's power. Sacred flames erupt "
        "from the ground and coalesce into a blazing guardian.");
}
