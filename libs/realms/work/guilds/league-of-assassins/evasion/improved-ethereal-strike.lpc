inherit "/lib/modules/research/knowledgeResearchItem.lpc";

protected void Setup()
{
    addSpecification("name", "Improved Ethereal Strike");
    addSpecification("source", "League of Assassins");
    addSpecification("description", "This research refines the ethereal "
        "strike technique, amplifying its damage and making it "
        "harder for opponents to brace against.");
    addPrerequisite("level",
        (["type":"level","guild":"League of Assassins","value":65]));
    addPrerequisite("/guilds/league-of-assassins/evasion/ethereal-strike.lpc",
        (["type":"research"]));
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research type", "percentage");
    addSpecification("affected research", (["ethereal strike": 30]));
    addSpecification("related research", ({
        "/guilds/league-of-assassins/evasion/ethereal-strike.lpc"
    }));
}
