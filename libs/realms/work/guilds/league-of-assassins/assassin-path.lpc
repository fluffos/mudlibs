/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("assassin's path");
    Description("The rank-gated path of the assassin, covering advanced "
        "combat techniques, target exploitation, shadow-enhanced "
        "strikes, and the disciplined mastery that separates a "
        "League assassin from any common killer.");
    Source("League of Assassins");
    TreeRoot("/guilds/league-of-assassins/assassin-path/root.lpc");

    FirstLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFirstLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FortySeventhLevel();
    FortyNinthLevel();
    FiftyFirstLevel();
    FiftyThirdLevel();
    FiftyFifthLevel();
}