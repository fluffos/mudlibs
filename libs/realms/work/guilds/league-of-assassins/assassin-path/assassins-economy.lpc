inherit "/lib/modules/research/knowledgeResearchItem.lpc";

protected void Setup()
{
    addSpecification("name", "Assassin's Economy");
    addSpecification("source", "League of Assassins");
    addSpecification("description", "This research refines the efficiency "
        "of motion in all path techniques, reducing the spell point "
        "expenditure required to execute them.");
    addPrerequisite("level",
        (["type":"level","guild":"League of Assassins","value":39]));
    addPrerequisite(
        "/guilds/league-of-assassins/assassin-path/assassins-swiftness.lpc",
        (["type":"research"]));
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research type", "decrease cost");
    addSpecification("affected research", ([
        "Precision Strike": 15,
        "Shadow Ambush": 15,
        "Exploit Weakness": 15,
        "Crippling Blow": 15,
        "Marked for Death": 15,
        "Final Reckoning": 15
    ]));
    addSpecification("related research", ({
        "/guilds/league-of-assassins/assassin-path/precision-strike.lpc",
        "/guilds/league-of-assassins/assassin-path/shadow-ambush.lpc",
        "/guilds/league-of-assassins/assassin-path/exploit-weakness.lpc"
    }));
}
