inherit "/lib/modules/research/knowledgeResearchItem.lpc";

protected void Setup()
{
    addSpecification("name", "Perfect Killing Stroke");
    addSpecification("source", "League of Assassins");
    addSpecification("description", "This research represents mastery of "
        "the killing stroke technique. The assassin's decisive "
        "blow has been refined to absolute lethality - a single "
        "committed strike that allows for no recovery.");
    addPrerequisite("level",
        (["type":"level","guild":"League of Assassins","value":59]));
    addPrerequisite(
        "/guilds/league-of-assassins/assassination-techniques/improved-killing-stroke.lpc",
        (["type":"research"]));
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research type", "percentage");
    addSpecification("affected research", (["killing stroke": 25]));
    addSpecification("related research", ({
        "/guilds/league-of-assassins/assassination-techniques/killing-stroke.lpc",
        "/guilds/league-of-assassins/assassination-techniques/improved-killing-stroke.lpc"
    }));
}
