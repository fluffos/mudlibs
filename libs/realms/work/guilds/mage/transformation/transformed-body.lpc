inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Transformed Body");
    addSpecification("source", "mage");
    addSpecification("description", "A passive bonus from the transformation school.");

    addPrerequisite("level",
        (["type": "level", "guild": "mage", "value": 49]));
    addPrerequisite("/guilds/mage/transformation/transformers-strength.lpc",
        (["type": "research"]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus hit points", 25);
}