protected void Setup()
{
    Name("Mind");
    Description("The school of mind is concerned with reaching into the "
        "thoughts and perceptions of others to assault, confuse, or "
        "shatter consciousness.");
    Source("mage");
    addResearchElement("/guilds/mage/mind/root.lpc");
    TreeRoot("/guilds/mage/mind/root.lpc");

    FirstLevel();
    ThirdLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
