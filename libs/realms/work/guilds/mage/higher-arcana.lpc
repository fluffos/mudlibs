/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Higher Arcana");
    Description("Higher arcana represents the advanced principles of "
        "magical theory accessible only to mages who have devoted "
        "years of study to the craft. These teachings amplify the "
        "power of all magical disciplines and unlock abilities beyond "
        "the reach of lesser practitioners.");
    Source("mage");
    addResearchElement("/guilds/mage/higher-arcana/root.lpc");
    TreeRoot("/guilds/mage/higher-arcana/root.lpc");

    TwentiethLevel();
    TwentySecondLevel();
    TwentyFourthLevel();
    TwentyFifthLevel();
    TwentySixthLevel();
    TwentySeventhLevel();
    TwentyEighthLevel();
    TwentyNinthLevel();
    ThirtiethLevel();
    ThirtyFirstLevel();
    ThirtySecondLevel();
    ThirtyThirdLevel();
    ThirtyFourthLevel();
    ThirtyFifthLevel();
    ThirtySixthLevel();
    ThirtySeventhLevel();
    ThirtyEighthLevel();
    FortiethLevel();
    FortySecondLevel();
    FortyFourthLevel();
    FortySixthLevel();
    FortyEighthLevel();
    FiftiethLevel();
    FiftySecondLevel();
    FiftyFourthLevel();
    FiftySixthLevel();
    FiftyEighthLevel();
    SixtiethLevel();
    SixtySecondLevel();
    SixtyFourthLevel();
}
