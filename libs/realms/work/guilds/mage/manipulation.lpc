protected void Setup()
{
    Name("Manipulation");
    Description("The school of manipulation is concerned with redirecting, "
        "absorbing, and stealing the arcane forces that flow through "
        "all living things.");
    Source("mage");
    addResearchElement("/guilds/mage/manipulation/root.lpc");
    TreeRoot("/guilds/mage/manipulation/root.lpc");

    FirstLevel();
    ThirdLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
