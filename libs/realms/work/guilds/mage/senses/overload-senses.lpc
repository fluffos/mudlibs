inherit "/lib/modules/research/instantaneousActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Overload Senses");
    addSpecification("source", "mage");
    addSpecification("description", "A senses-school attack spell.");

    addPrerequisite("/guilds/mage/senses/blinding-surge.lpc",
        (["type": "research"]));
    addPrerequisite("level",
        (["type": "level", "guild": "mage", "value": 19]));

    addSpecification("scope", "targeted");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("effect", "combat");
    addSpecification("spell point cost", 30);
    addSpecification("cooldown", 14);
    addSpecification("command template", "overload senses [at ##Target##]");
    addSpecification("event handler", "overloadSensesEvent");
    addSpecification("use ability message",
        "##InitiatorName## overload##InitiatorReflexive## the senses of ##TargetName## with catastrophic sensory input.");
    addSpecification("use ability fail message",
        "You failed to overload ##TargetName##'s senses.");
    addSpecification("use ability cooldown message",
        "You must wait before overloading senses again.");
    addSpecification("damage type", "magical");
    addSpecification("damage hit points", ({
        (["probability": 100, "base damage": 36, "range": 18])
    }));
    addSpecification("modifiers", ({
        ([
            "type": "skill",
            "name": "spellcraft",
            "formula": "additive",
            "rate": 0.15
        ]),
        ([
            "type": "skill",
            "name": "perception",
            "formula": "additive",
            "rate": 0.2
        ]),
        ([
            "type": "attribute",
            "name": "intelligence",
            "formula": "additive",
            "rate": 0.15
        ]),
        ([
            "type": "attribute",
            "name": "wisdom",
            "formula": "additive",
            "rate": 0.1
        ]),
        ([
            "type": "level",
            "name": "level",
            "formula": "additive",
            "rate": 0.5
        ]),
        ([
            "type": "research",
            "name": "Senses Theory",
            "formula": "multiplicative",
            "rate": 0.10,
            "research item": "/guilds/mage/senses/senses-theory.lpc"
        ]),
        ([
            "type": "research",
            "name": "Senses Mastery",
            "formula": "multiplicative",
            "rate": 0.10,
            "research item": "/guilds/mage/senses/senses-mastery.lpc"
        ]),
        ([
            "type": "research",
            "name": "Pure Senses",
            "formula": "multiplicative",
            "rate": 0.10,
            "research item": "/guilds/mage/senses/pure-senses.lpc"
        ]),
        ([
            "type": "research",
            "name": "Primal Senses",
            "formula": "multiplicative",
            "rate": 0.10,
            "research item": "/guilds/mage/senses/primal-senses.lpc"
        ]),
        ([
            "type": "research",
            "name": "Total Senses",
            "formula": "multiplicative",
            "rate": 0.10,
            "research item": "/guilds/mage/senses/total-senses.lpc"
        ]),
        ([
            "type": "research",
            "name": "Sensory Mastery",
            "formula": "multiplicative",
            "rate": 0.10,
            "research item": "/guilds/mage/senses/sensory-mastery.lpc"
        ]),
        ([
            "type": "research",
            "name": "Perception Theory",
            "formula": "multiplicative",
            "rate": 0.10,
            "research item": "/guilds/mage/senses/perception-theory.lpc"
        ]),
        ([
            "type": "research",
            "name": "Perception Mastery",
            "formula": "multiplicative",
            "rate": 0.10,
            "research item": "/guilds/mage/senses/perception-mastery.lpc"
        ]),
        ([
            "type": "research",
            "name": "Perception Supremacy",
            "formula": "multiplicative",
            "rate": 0.10,
            "research item": "/guilds/mage/senses/perception-supremacy.lpc"
        ]),
    }));
}