inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Senses Theory");
    addSpecification("source", "mage");
    addSpecification("description", "Enhances all senses-based abilities.");

    addPrerequisite("level",
        (["type": "level", "guild": "mage", "value": 3]));
    addPrerequisite("/guilds/mage/senses/root.lpc",
        (["type": "research"]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Keen Strike": 25,
        "Dulled Senses": 25,
        "Perceptive Bolt": 25,
        "Blinding Surge": 25,
        "Sensory Disruption": 25,
        "Heightened Bolt": 25,
        "Overload Senses": 25,
        "Perception Rend": 25,
        "Sensory Annihilation": 25,
        "Total Sensory Collapse": 25,
    ]));
    addSpecification("affected research type", "percentage");
}