inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Arcane Perfection");
    addSpecification("source", "mage");
    addSpecification("description", "The mage's attunement to magical essence reaches perfection.");

    addPrerequisite("level",
        (["type": "level", "guild": "mage", "value": 57]));
    addPrerequisite("/guilds/mage/arcane-theory/boundless-reservoir.lpc",
        (["type": "research"]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus magical essence", 5);
}