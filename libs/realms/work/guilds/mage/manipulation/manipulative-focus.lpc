inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Manipulative Focus");
    addSpecification("source", "mage");
    addSpecification("description", "A passive bonus from the manipulation school.");

    addPrerequisite("level",
        (["type": "level", "guild": "mage", "value": 41]));
    addPrerequisite("/guilds/mage/manipulation/manipulators-power.lpc",
        (["type": "research"]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus spellcraft", 2);
}