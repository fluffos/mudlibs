inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Manipulation Supremacy");
    addSpecification("source", "mage");
    addSpecification("description", "Manipulation supremacy maximizes all manipulative power.");

    addPrerequisite("level",
        (["type": "level", "guild": "mage", "value": 55]));
    addPrerequisite("/guilds/mage/manipulation/supreme-manipulation.lpc",
        (["type": "research"]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Arcane Drain": 20,
        "Force Redirection": 20,
        "Vital Siphon": 20,
        "Energy Absorption": 20,
        "Force Inversion": 20,
        "Life Tap": 20,
        "Arcane Void": 20,
        "Force Collapse": 20,
        "Essence Drain": 20,
        "Total Drain": 20,
    ]));
    addSpecification("affected research type", "percentage");
}