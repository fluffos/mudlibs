inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Total Manipulation");
    addSpecification("source", "mage");
    addSpecification("description", "Total mastery of manipulation elevates all abilities.");

    addPrerequisite("level",
        (["type": "level", "guild": "mage", "value": 61]));
    addPrerequisite("/guilds/mage/manipulation/manipulation-supremacy.lpc",
        (["type": "research"]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Arcane Drain": 25,
        "Force Redirection": 25,
        "Vital Siphon": 25,
        "Energy Absorption": 25,
        "Force Inversion": 25,
        "Life Tap": 25,
        "Arcane Void": 25,
        "Force Collapse": 25,
        "Essence Drain": 25,
        "Total Drain": 25,
    ]));
    addSpecification("affected research type", "percentage");
}