/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Divination");
    Description("The school of divination is concerned with opening "
        "perception to the hidden currents of the world and granting "
        "foresight into the flow of events.");
    Source("mage");
    addResearchElement("/guilds/mage/divination/root.lpc");
    TreeRoot("/guilds/mage/divination/root.lpc");

    FirstLevel();
    ThirdLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFirstLevel();
    FortySeventhLevel();
    FortyNinthLevel();
    FiftyThirdLevel();
    FiftySeventhLevel();
    FiftyNinthLevel();
    SixtyFirstLevel();
}


