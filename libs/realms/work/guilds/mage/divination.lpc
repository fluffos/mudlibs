private void FirstLevel()
{
    addResearchElement("/guilds/mage/divination/arcane-sight.lpc");
    addResearchElement("/guilds/mage/divination/reveal-weakness.lpc");
    addResearchElement("/guilds/mage/divination/foresight-bolt.lpc");

    addChild("/guilds/mage/divination/arcane-sight.lpc",
        "/guilds/mage/divination/root.lpc");
    addChild("/guilds/mage/divination/reveal-weakness.lpc",
        "/guilds/mage/divination/root.lpc");
    addChild("/guilds/mage/divination/foresight-bolt.lpc",
        "/guilds/mage/divination/root.lpc");
}

