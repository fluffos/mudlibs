/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Senses");
    Description("The school of senses is concerned with heightening or "
        "dulling perception - sharpening the mage's own awareness or "
        "stripping awareness from their enemies.");
    Source("mage");
    addResearchElement("/guilds/mage/senses/root.lpc");
    TreeRoot("/guilds/mage/senses/root.lpc");

    FirstLevel();
    ThirdLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFirstLevel();
    FortySeventhLevel();
    FortyNinthLevel();
    FiftyThirdLevel();
    FiftySeventhLevel();
    FiftyNinthLevel();
    SixtyFirstLevel();
    SixtyThirdLevel();
    SixtyFifthLevel();
    SixtySeventhLevel();
    SixtyNinthLevel();
}
