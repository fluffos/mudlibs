inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Destruction Supremacy");
    addSpecification("source", "mage");
    addSpecification("description", "Destruction supremacy maximizes all destructive power.");

    addPrerequisite("level",
        (["type": "level", "guild": "mage", "value": 55]));
    addPrerequisite("/guilds/mage/destruction/supreme-destruction.lpc",
        (["type": "research"]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Destructive Bolt": 20,
        "Ruinous Lash": 20,
        "Entropic Pulse": 20,
        "Chaos Burst": 20,
        "Disintegrate": 20,
        "Entropy Wave": 20,
        "Ruinous Storm": 20,
        "Obliteration": 20,
        "Total Destruction": 20,
        "Total Devastation": 20,
    ]));
    addSpecification("affected research type", "percentage");
}