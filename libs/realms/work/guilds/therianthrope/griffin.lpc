private void SeventeenthLevel()
{
    addResearchElement("/guilds/therianthrope/griffin/eagle-sight.lpc");
    addResearchElement("/guilds/therianthrope/griffin/golden-plumage.lpc");

    addChild("/guilds/therianthrope/griffin/eagle-sight.lpc",
        "/guilds/therianthrope/griffin/griffin-root.lpc");
    addChild("/guilds/therianthrope/griffin/golden-plumage.lpc",
        "/guilds/therianthrope/griffin/griffin-root.lpc");
}

