/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Chimera Form");
    Description("This research tree provides knowledge of transforming into "
        "a fearsome chimera. The chimera form excels at savage melee combat "
        "and fire-based attacks. Progressive mastery unlocks devastating "
        "rending strikes, fiery breath, and eventually the power of the "
        "mythic chimera itself.");
    Source("therianthrope");
    addResearchElement("/guilds/therianthrope/chimera/chimera-root.lpc");
    TreeRoot("/guilds/therianthrope/chimera/chimera-root.lpc");

    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyFirstLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FortySeventhLevel();
    FortyNinthLevel();
    FiftyFifthLevel();
    SixtyFirstLevel();
    SixtySeventhLevel();
}
