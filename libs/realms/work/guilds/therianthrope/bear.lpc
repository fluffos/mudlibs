}

/////////////////////////////////////////////////////////////////////////////
private void SeventeenthLevel()
{
    addResearchElement("/guilds/therianthrope/bear/savage-instinct.lpc");
    addResearchElement("/guilds/therianthrope/bear/hardened-bones.lpc");

    addChild("/guilds/therianthrope/bear/savage-instinct.lpc",
        "/guilds/therianthrope/bear/ursine-fury.lpc");
    addChild("/guilds/therianthrope/bear/hardened-bones.lpc",
        "/guilds/therianthrope/bear/den-mother.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NineteenthLevel()
{
    addResearchElement("/guilds/therianthrope/bear/maul.lpc");
    addResearchElement("/guilds/therianthrope/bear/attack-efficiency.lpc");

    addChild("/guilds/therianthrope/bear/maul.lpc",
        "/guilds/therianthrope/bear/savage-instinct.lpc");
    addChild("/guilds/therianthrope/bear/attack-efficiency.lpc",
        "/guilds/therianthrope/bear/claw-mastery.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFirstLevel()
{
    addResearchElement("/guilds/therianthrope/bear/apex-predator.lpc");
    addResearchElement("/guilds/therianthrope/bear/mountain-hide.lpc");

    addChild("/guilds/therianthrope/bear/apex-predator.lpc",
        "/guilds/therianthrope/bear/savage-instinct.lpc");
    addChild("/guilds/therianthrope/bear/mountain-hide.lpc",
        "/guilds/therianthrope/bear/hardened-bones.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyThirdLevel()
{
    addResearchElement("/guilds/therianthrope/bear/thunderous-roar.lpc");
    addResearchElement("/guilds/therianthrope/bear/regeneration.lpc");

    addChild("/guilds/therianthrope/bear/thunderous-roar.lpc",
        "/guilds/therianthrope/bear/apex-predator.lpc");
    addChild("/guilds/therianthrope/bear/regeneration.lpc",
        "/guilds/therianthrope/bear/mountain-hide.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentyFifthLevel()
{
    addResearchElement("/guilds/therianthrope/bear/attack-speed.lpc");

    addChild("/guilds/therianthrope/bear/attack-speed.lpc",
        "/guilds/therianthrope/bear/attack-efficiency.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void TwentySeventhLevel()
{
    addResearchElement("/guilds/therianthrope/bear/primordial-beast.lpc");
    addResearchElement("/guilds/therianthrope/bear/earthen-resilience.lpc");

    addChild("/guilds/therianthrope/bear/primordial-beast.lpc",
        "/guilds/therianthrope/bear/apex-predator.lpc");
    addChild("/guilds/therianthrope/bear/earthen-resilience.lpc",
        "/guilds/therianthrope/bear/regeneration.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirtyFirstLevel()
{
    addResearchElement("/guilds/therianthrope/bear/titanic-bear.lpc");

    addChild("/guilds/therianthrope/bear/titanic-bear.lpc",
        "/guilds/therianthrope/bear/primordial-beast.lpc");
}

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Bear Form");
    Description("This research tree provides knowledge of transforming into "
        "a massive bear. The bear form excels at absorbing damage and dealing "
        "devastating physical attacks through raw strength. Progressive "
        "mastery unlocks thicker hide, more powerful attacks, and eventually "
        "a titanic form of unmatched power and resilience.");
    Source("therianthrope");
    addResearchElement("/guilds/therianthrope/bear/bear-root.lpc");
    TreeRoot("/guilds/therianthrope/bear/bear-root.lpc");

    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    ThirtyFirstLevel();
}
