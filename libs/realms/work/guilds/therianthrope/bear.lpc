inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/therianthrope/bear/thick-hide.lpc");
    addResearchElement("/guilds/therianthrope/bear/primal-strength.lpc");

    addChild("/guilds/therianthrope/bear/thick-hide.lpc",
        "/guilds/therianthrope/bear/bear-root.lpc");
    addChild("/guilds/therianthrope/bear/primal-strength.lpc",
        "/guilds/therianthrope/bear/bear-root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifthLevel()
{
    addResearchElement("/guilds/therianthrope/bear/bear-claws.lpc");
    addResearchElement("/guilds/therianthrope/bear/ursine-endurance.lpc");

    addChild("/guilds/therianthrope/bear/bear-claws.lpc",
        "/guilds/therianthrope/bear/primal-strength.lpc");
    addChild("/guilds/therianthrope/bear/ursine-endurance.lpc",
        "/guilds/therianthrope/bear/thick-hide.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void SeventhLevel()
{
    addResearchElement("/guilds/therianthrope/bear/crushing-bite.lpc");

    addChild("/guilds/therianthrope/bear/crushing-bite.lpc",
        "/guilds/therianthrope/bear/ursine-endurance.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void NinthLevel()
{
    addResearchElement("/guilds/therianthrope/bear/iron-fur.lpc");
    addResearchElement("/guilds/therianthrope/bear/mighty-swipe.lpc");

    addChild("/guilds/therianthrope/bear/iron-fur.lpc",
        "/guilds/therianthrope/bear/ursine-endurance.lpc");
    addChild("/guilds/therianthrope/bear/mighty-swipe.lpc",
        "/guilds/therianthrope/bear/bear-claws.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void EleventhLevel()
{
    addResearchElement("/guilds/therianthrope/bear/bear-charge.lpc");

    addChild("/guilds/therianthrope/bear/bear-charge.lpc",
        "/guilds/therianthrope/bear/mighty-swipe.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirteenthLevel()
{
    addResearchElement("/guilds/therianthrope/bear/ursine-fury.lpc");
    addResearchElement("/guilds/therianthrope/bear/den-mother.lpc");

    addChild("/guilds/therianthrope/bear/ursine-fury.lpc",
        "/guilds/therianthrope/bear/mighty-swipe.lpc");
    addChild("/guilds/therianthrope/bear/den-mother.lpc",
        "/guilds/therianthrope/bear/iron-fur.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void FifteenthLevel()
{
    addResearchElement("/guilds/therianthrope/bear/claw-mastery.lpc");
    addResearchElement("/guilds/therianthrope/bear/defensive-stance.lpc");

    addChild("/guilds/therianthrope/bear/claw-mastery.lpc",
        "/guilds/therianthrope/bear/bear-charge.lpc");
    addChild("/guilds/therianthrope/bear/defensive-stance.lpc",
