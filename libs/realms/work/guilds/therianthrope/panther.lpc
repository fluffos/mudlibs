    addResearchElement("/guilds/therianthrope/panther/keen-senses.lpc");
    addResearchElement("/guilds/therianthrope/panther/razor-claws.lpc");

    addChild("/guilds/therianthrope/panther/keen-senses.lpc",
        "/guilds/therianthrope/panther/panther-root.lpc");
    addChild("/guilds/therianthrope/panther/razor-claws.lpc",
        "/guilds/therianthrope/panther/panther-root.lpc");
}

