inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Primal Stormcaller");
    addSpecification("source", "druid");
    addSpecification("description", "This research marks the druid as a primal stormcaller, deeply amplifying all storm spells.");

    addPrerequisite("level",
        (["type": "level",
            "guild": "druid",
            "value": 51
        ]));

    addPrerequisite("/guilds/druid/primal-storm/root.lpc",
        ([ "type": "research" ]));

    addPrerequisite("/guilds/druid/primal-storm/storm-apex.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Gust": 25,
        "Ice Shard": 25,
        "Sleet": 25,
        "Frost Nova": 25,
        "Hailstorm": 25,
        "Arctic Gale": 25,
        "Blizzard": 25,
        "Cyclone": 25,
        "Tempest": 25,
        "Frozen Storm": 25,
        "Tempest Fury": 25,
        "Eye of the Storm": 25,
    ]));
}
