/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Ancient Ward");
    Description("This research tree grants the druid mastery over "
        "ancient protective magic - wards and auras drawn from the "
        "enduring power of stone, root, and grove that shield the "
        "druid against harm.");
    Source("druid");
    addResearchElement("/guilds/druid/ancient-ward/root.lpc");
    TreeRoot("/guilds/druid/ancient-ward/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    NinthLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FortySeventhLevel();
    FortyNinthLevel();
    FiftyFirstLevel();
    FiftySeventhLevel();
    SixtyThirdLevel();
    SixtyNinthLevel();
}
