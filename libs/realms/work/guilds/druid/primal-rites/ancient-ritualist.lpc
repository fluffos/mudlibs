inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Ancient Ritualist");
    addSpecification("source", "druid");
    addSpecification("description", "This research marks the druid as a true ancient ritualist, substantially amplifying all primal rites.");

    addPrerequisite("level",
        (["type": "level",
            "guild": "druid",
            "value": 51
        ]));

    addPrerequisite("/guilds/druid/primal-rites/root.lpc",
        ([ "type": "research" ]));

    addPrerequisite("/guilds/druid/primal-rites/primal-rite-mastery.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Rite of Mending": 25,
        "Rite of Vigor": 25,
        "Rite of Clarity": 25,
        "Greater Mending": 25,
        "Greater Clarity": 25,
        "Rite of Endurance": 25,
        "Primal Healing": 25,
        "Nature's Bounty": 25,
        "Rite of Renewal": 25,
        "Grand Renewal": 25,
        "Wild Restoration": 25,
        "Wild Vitality": 25,
        "Primal Attunement": 25,
        "Rite of Wrath": 25,
        "Rite of the Storm": 25,
        "Rite of the Wilds": 25,
        "Nature's Rite": 25,
    ]));
}
