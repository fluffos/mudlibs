inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Nature's Conduit");
    addSpecification("source", "druid");
    addSpecification("description", "This research makes the druid a more perfect conduit for destructive natural forces.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 9
    ]));

    addPrerequisite("/guilds/druid/natures-wrath/earthen-power.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Thorn Whip": 25,
        "Stone Fist": 25,
        "Wildfire": 25,
        "Eruption": 25,
        "Magma Surge": 25,
        "Scorched Earth": 25,
        "Earthen Grasp": 25,
        "Conflagration": 25,
        "Earthquake": 25,
        "Volcanic Fury": 25,
    ]));
}
