inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Volcanic Knowledge");
    addSpecification("source", "druid");
    addSpecification("description", "This research grants insight into the chaotic power of volcanoes and magma.");

    addPrerequisite("/guilds/druid/natures-wrath/root.lpc",
        ([ "type": "research" ]));
    addPrerequisite("level", ([
        "type": "level", "guild": "druid", "value": 9
    ]));

    addPrerequisite("/guilds/druid/natures-wrath/earthen-attunement.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Thorn Whip": 25,
        "Stone Fist": 25,
        "Earthen Grasp": 25,
        "Eruption": 25,
        "Wildfire": 25,
        "Magma Surge": 25,
        "Conflagration": 25,
        "Earthquake": 25,
        "Volcanic Fury": 25,
        "Infernal Wild": 25,
    ]));
}
