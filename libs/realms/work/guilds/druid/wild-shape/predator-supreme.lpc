inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Predator Supreme");
    addSpecification("source", "druid");
    addSpecification("description", "This research marks the druid as the apex of primal combat ability.");

    addPrerequisite("/guilds/druid/wild-shape/root.lpc",
        ([ "type": "research" ]));
    addPrerequisite("level", ([
        "type": "level", "guild": "druid", "value": 31
    ]));

    addPrerequisite("/guilds/druid/wild-shape/fluid-motion.lpc",
        ([ "type": "research" ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus attack", 4);
    addSpecification("bonus damage", 3);
    addSpecification("bonus dexterity", 1);
}
