    addChild("/guilds/druid/primal-storm/ice-shard.lpc",
        "/guilds/druid/primal-storm/gust.lpc");
    addChild("/guilds/druid/primal-storm/cold-veins.lpc",
        "/guilds/druid/primal-storm/storm-born.lpc");
}

