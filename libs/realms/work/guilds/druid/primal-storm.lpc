inherit "/lib/modules/research/researchTree.lpc";

/////////////////////////////////////////////////////////////////////////////
private void FirstLevel()
{
    addResearchElement("/guilds/druid/primal-storm/gust.lpc");
    addResearchElement("/guilds/druid/primal-storm/storm-focus.lpc");
    addResearchElement("/guilds/druid/primal-storm/storm-born.lpc");

    addChild("/guilds/druid/primal-storm/gust.lpc",
        "/guilds/druid/primal-storm/root.lpc");
    addChild("/guilds/druid/primal-storm/storm-focus.lpc",
        "/guilds/druid/primal-storm/root.lpc");
    addChild("/guilds/druid/primal-storm/storm-born.lpc",
        "/guilds/druid/primal-storm/root.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private void ThirdLevel()
{
    addResearchElement("/guilds/druid/primal-storm/storm-affinity.lpc");
