inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Wildbloom");
    addSpecification("source", "druid");
    addSpecification("description", "This research accelerates the druid's natural regeneration through verdant vitality.");

    addPrerequisite("/guilds/druid/verdant-growth/root.lpc",
        ([ "type": "research" ]));
    addPrerequisite("level", ([
        "type": "level", "guild": "druid", "value": 13
    ]));

    addPrerequisite("/guilds/druid/verdant-growth/bark-skin-passive.lpc",
        ([ "type": "research" ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus constitution", 1);
    addSpecification("bonus hit points", 40);
}
