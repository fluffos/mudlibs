inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Verdant Immortal");
    addSpecification("source", "druid");
    addSpecification("description", "This research infuses the druid with the near-immortal regenerative power of ancient trees.");

    addPrerequisite("/guilds/druid/verdant-growth/root.lpc",
        ([ "type": "research" ]));
    addPrerequisite("level", ([
        "type": "level", "guild": "druid", "value": 43
    ]));

    addPrerequisite("/guilds/druid/verdant-growth/ironwood-body.lpc",
        ([ "type": "research" ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus constitution", 2);
    addSpecification("bonus strength", 2);
    addSpecification("bonus hit points", 75);
    addSpecification("bonus defense", 4);
}
