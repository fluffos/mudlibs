inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Thick Skull III");
    addSpecification("source", "druid");
    addSpecification("description", "This research makes the bear supernaturally difficult to incapacitate, its body shrugging off blows to vital areas.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 21
    ]));

    addPrerequisite("/guilds/druid/companions/bear/thick-skull-ii.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/druid/companions/bear/root.lpc",
    }));
}
