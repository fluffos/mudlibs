inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Unstoppable");
    addSpecification("source", "druid");
    addSpecification("description", "This research forges the bear's endurance into something transcendent, allowing it to press through any pain.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 31
    ]));

    addPrerequisite("/guilds/druid/companions/bear/ursine-fortitude.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/druid/companions/bear/root.lpc",
    }));
}
