inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Unyielding Hide");
    addSpecification("source", "druid");
    addSpecification("description", "This research transforms the bear's entire body into a fortress, its hide deflecting blows as stone deflects rain.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 47
    ]));

    addPrerequisite("/guilds/druid/companions/bear/iron-hide-v.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/druid/companions/bear/root.lpc",
    }));
}
