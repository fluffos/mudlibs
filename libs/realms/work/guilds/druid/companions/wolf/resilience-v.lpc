inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Resilience V");
    addSpecification("source", "druid");
    addSpecification("description", "This research grants the wolf a vitality that borders on immortality, its body healing from grievous wounds in moments.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 55
    ]));

    addPrerequisite("/guilds/druid/companions/wolf/primal-resilience.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/druid/companions/wolf/root.lpc",
    }));
}
