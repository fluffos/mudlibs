inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Talon III");
    addSpecification("source", "druid");
    addSpecification("description", "This research elevates the eagle's strikes to something truly dangerous, each talon-rake capable of bypassing hardened defenses.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 19
    ]));

    addPrerequisite("/guilds/druid/companions/eagle/talon-ii.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/druid/companions/eagle/root.lpc",
    }));
}
