inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Apex Hunter");
    addSpecification("source", "druid");
    addSpecification("description", "This research completes the eagle's transformation into the apex aerial predator, combining all its gifts into devastating unity.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 59
    ]));

    addPrerequisite("/guilds/druid/companions/eagle/killing-strike.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/druid/companions/eagle/root.lpc",
    }));
}
