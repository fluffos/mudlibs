inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Iron Feathers IV");
    addSpecification("source", "druid");
    addSpecification("description", "This research completes the toughening of the eagle's natural armor, its body resisting even enchanted weapons.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 51
    ]));

    addPrerequisite("/guilds/druid/companions/eagle/iron-feathers-iii.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/druid/companions/eagle/root.lpc",
    }));
}
