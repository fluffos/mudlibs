inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Predator V");
    addSpecification("source", "druid");
    addSpecification("description", "This research makes the panther a supreme hunter, its attacks carrying lethal precision that few creatures can match.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 37
    ]));

    addPrerequisite("/guilds/druid/companions/cat/eviscerate.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/druid/companions/cat/root.lpc",
    }));
}
