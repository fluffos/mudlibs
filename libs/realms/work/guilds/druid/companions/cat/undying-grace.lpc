inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Undying Grace");
    addSpecification("source", "druid");
    addSpecification("description", "This research forges an unbreakable bond between druid and panther, the companion drawing upon the druid's own essence to persist.");

    addPrerequisite("level", ([
        "type": "level",
        "guild": "druid",
        "value": 59
    ]));

    addPrerequisite("/guilds/druid/companions/cat/primal-vitality.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("related research", ({
        "/guilds/druid/companions/cat/root.lpc",
    }));
}
