/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Primal Rites");
    Description("This research tree grants the druid mastery over "
        "the ancient art of ritual - ceremonies performed with "
        "consumed herbs that channel nature's power to restore "
        "vitality, invoke lasting blessings, and unleash wrath "
        "upon enemies.");
    Source("druid");
    addResearchElement("/guilds/druid/primal-rites/root.lpc");
    TreeRoot("/guilds/druid/primal-rites/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    FortyThirdLevel();
    FortyFifthLevel();
    FortySeventhLevel();
    FiftyFirstLevel();
    FiftySeventhLevel();
    SixtyThirdLevel();
    SixtyNinthLevel();
}
