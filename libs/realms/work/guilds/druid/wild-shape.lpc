/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Wild Shape");
    Description("This research tree grants the druid mastery over "
        "the primal art of channeling the essence of wild creatures. "
        "Each aspect is a sustained combat stance that can be "
        "activated and deactivated at will, channeling the fighting "
        "spirit of a different creature through the druid's own form.");
    Source("druid");
    addResearchElement("/guilds/druid/wild-shape/root.lpc");
    TreeRoot("/guilds/druid/wild-shape/root.lpc");

    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
    ThirtyNinthLevel();
    FortyThirdLevel();
    FortySeventhLevel();
    FiftyFirstLevel();
    FiftySeventhLevel();
    SixtyThirdLevel();
    SixtyNinthLevel();
}
