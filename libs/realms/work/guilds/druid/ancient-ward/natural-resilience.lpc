inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Natural Resilience");
    addSpecification("source", "druid");
    addSpecification("description", "This research grants natural resilience, reducing the impact of attacks.");

    addPrerequisite("/guilds/druid/ancient-ward/root.lpc",
        ([ "type": "research" ]));
    addPrerequisite("level", ([
        "type": "level", "guild": "druid", "value": 9
    ]));

    addPrerequisite("/guilds/druid/ancient-ward/protected-body.lpc",
        ([ "type": "research" ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus defense", 2);
    addSpecification("bonus soak", 2);
}
