inherit "/lib/modules/research/knowledgeResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Natural Fortress");
    addSpecification("source", "druid");
    addSpecification("description", "This research allows the druid to weave more powerful wards from natural energy.");

    addPrerequisite("/guilds/druid/ancient-ward/root.lpc",
        ([ "type": "research" ]));
    addPrerequisite("level", ([
        "type": "level", "guild": "druid", "value": 5
    ]));

    addPrerequisite("/guilds/druid/ancient-ward/ward-lore.lpc",
        ([ "type": "research" ]));

    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("affected research", ([
        "Ancient Ward": 25,
        "Ward of Thorns": 25,
        "Ward of Silence": 25,
        "Nature's Veil": 25,
        "Ward of Stone": 25,
        "Enduring Ward": 25,
        "Ward of Reversal": 25,
        "Ward of Purity": 25,
        "Ward Mastery": 25,
    ]));
}
