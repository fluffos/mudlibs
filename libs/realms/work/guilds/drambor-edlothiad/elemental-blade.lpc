/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("Elemental Blade");
    Description("This research tree teaches the art of infusing wielded blades "
        "with elemental energy. Fire, cold, lightning, acid, shadow, arcane, "
        "and pure energy enchantments can be channeled through a blade to "
        "devastating effect.");
    Source("Drambor Edlothiad");
    addResearchElement("/guilds/drambor-edlothiad/elemental/root.lpc");
    TreeRoot("/guilds/drambor-edlothiad/elemental/root.lpc");

    FirstLevel();
    ThirdLevel();
    FifthLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
    TwentyThirdLevel();
    TwentyFifthLevel();
    TwentySeventhLevel();
    TwentyNinthLevel();
    ThirtyFirstLevel();
    ThirtyThirdLevel();
    ThirtyFifthLevel();
    ThirtySeventhLevel();
    FortyFirstLevel();
    FortyFifthLevel();
    FortySeventhLevel();
    FortyNinthLevel();
    FiftyFirstLevel();
    FiftyThirdLevel();
    FiftyFifthLevel();
    FiftySeventhLevel();
    FiftyNinthLevel();
    SixtyFifthLevel();
}
