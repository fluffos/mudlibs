inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Warding Song");
    addSpecification("source", "Drambor Edlothiad");
    addSpecification("description", "This research teaches a warding melody "
        "that deflects attacks.");

    addPrerequisite(
        "/guilds/drambor-edlothiad/bladesinger/defensive-harmonics.lpc",
        (["type": "research"]));
    addPrerequisite("level",
        (["type": "level",
            "guild": "/guilds/drambor-edlothiad/drambor-edlothiad.lpc",
            "value": 9
        ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus defense", 2);
    addSpecification("bonus dodge", 2);
}
