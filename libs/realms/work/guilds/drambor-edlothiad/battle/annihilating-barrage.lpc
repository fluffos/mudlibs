inherit "/lib/modules/research/instantaneousActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Annihilating Barrage");
    addSpecification("source", "Drambor Edlothiad");
    addSpecification("description", "This research teaches the battlemage to unleash a rapid barrage of annihilating force bolts that saturate an area, each bolt carrying enough energy to unmake matter.");

    addPrerequisite(
        "/guilds/drambor-edlothiad/battle/disintegrate.lpc",
