inherit "/lib/modules/research/instantaneousActiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Tempest");
    addSpecification("source", "Drambor Edlothiad");
    addSpecification("description", "This research teaches the battlemage to summon a devastating electrical tempest that engulfs the battlefield in crackling fury, striking all enemies with arcs of searing lightning.");

    addPrerequisite(
        "/guilds/drambor-edlothiad/battle/chain-lightning.lpc",
        (["type": "research"]));
    addPrerequisite("level",
        (["type": "level",
            "guild": "/guilds/drambor-edlothiad/drambor-edlothiad.lpc",
            "value": 21
        ]));

    addSpecification("scope", "area");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);

    addSpecification("damage hit points", ({
        ([
            "probability": 80,
            "base damage": 75,
            "range": 45
        ]),
        ([
            "probability": 20,
            "base damage": 125,
            "range": 75
        ])
    }));

    addSpecification("damage type", "electricity");

    addSpecification("modifiers", ({
