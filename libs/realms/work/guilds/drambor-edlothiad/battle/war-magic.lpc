            "name": "Spell Penetration",
            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item": "/guilds/drambor-edlothiad/battle/arcane-might.lpc",
            "name": "Arcane Might",
            "formula": "multiplicative",
            "base value": 1,
