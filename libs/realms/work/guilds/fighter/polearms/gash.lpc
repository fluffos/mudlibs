            "formula": "multiplicative",
            "base value": 1,
            "rate": 1.25
        ]),
        ([
            "type": "research",
            "research item": "/guilds/fighter/polearms/master-skewer.lpc",
            "name": "Master Skewer",
            "formula": "multiplicative",
            "base value": 1,
