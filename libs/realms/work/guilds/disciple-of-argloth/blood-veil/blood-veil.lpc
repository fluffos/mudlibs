protected void Setup()
{
    Name("Blood Veil");
    Description("This skill provides the Disciple with the knowledge to weave their own lifeblood into a corrupted magical shield.");
    Source("Disciple of Argloth");
    addResearchElement("/guilds/disciple-of-argloth/blood-veil/root.lpc");
    TreeRoot("/guilds/disciple-of-argloth/blood-veil/root.lpc");

    FirstLevel();
    SecondLevel();
    ThirdLevel();
    SeventhLevel();
    NinthLevel();
    EleventhLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SeventeenthLevel();
    NineteenthLevel();
    TwentyFirstLevel();
