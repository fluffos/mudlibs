protected void Setup()
{
    Name("Forbidden Arts");
    Description("The most forbidden of Argloth's techniques - those he kept secret even from his own disciples, techniques that unmake the boundary between life and death entirely.");
    Source("Disciple of Argloth");
    addResearchElement("/guilds/disciple-of-argloth/forbidden/root.lpc");
    TreeRoot("/guilds/disciple-of-argloth/forbidden/root.lpc");

    FifteenthLevel();
    EighteenthLevel();
    TwentiethLevel();
    TwentySecondLevel();
    TwentyFourthLevel();
    TwentySixthLevel();
    TwentyEighthLevel();
    ThirtiethLevel();
    ThirtySecondLevel();
