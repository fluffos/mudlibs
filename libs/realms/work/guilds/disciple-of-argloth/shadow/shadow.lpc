protected void Setup()
{
    Name("Shadow Arts");
    Description("The manipulation of shadow and darkness as an extension of death - the power to move unseen, strike from darkness, and bend shadow to the Disciple's will.");
    Source("Disciple of Argloth");
    addResearchElement("/guilds/disciple-of-argloth/shadow/root.lpc");
    TreeRoot("/guilds/disciple-of-argloth/shadow/root.lpc");

    FifthLevel();
    SeventhLevel();
    TenthLevel();
    TwelfthLevel();
    ThirteenthLevel();
    FifteenthLevel();
    SixteenthLevel();
    EighteenthLevel();
    TwentiethLevel();
    TwentySecondLevel();
    TwentyFourthLevel();
