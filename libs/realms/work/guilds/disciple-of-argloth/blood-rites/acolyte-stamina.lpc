inherit "/lib/modules/research/passiveResearchItem.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    addSpecification("name", "Acolyte's Stamina");
    addSpecification("source", "Disciple of Argloth");
    addSpecification("description", "Deep reserves of stamina cultivated through blood-rite discipline.");

    addPrerequisite("guild rank",
        (["type": "guild rank",
          "guild": "Disciple of Argloth",
          "value": "death scholar"
        ]));
    addPrerequisite("level",
        (["type": "level",
          "guild": "Disciple of Argloth",
          "value": 14
        ]));

    addSpecification("scope", "self");
    addSpecification("research type", "points");
    addSpecification("research cost", 1);
    addSpecification("bonus stamina points", 40);
    addSpecification("bonus heal stamina rate", 1);
}
