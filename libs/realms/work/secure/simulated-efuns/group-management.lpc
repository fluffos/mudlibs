/////////////////////////////////////////////////////////////////////////////
public string *customGroups(object user)
{
    string *ret = ({});

    if (PORT->member(inherit_list(this_object()),
        "/secure/simulated-efuns/testing.lpc") > -1)
    {
        ret = PORT->call_direct(this_object(), "testingGroups");
    }

    return ret;
}
