#include "/sys/interactive_info.h"

// FluffOS PORT NOTE: this driver has no interactive_info() efun at all
// (LDMud-specific) -- a handful of call sites elsewhere in this codebase
// (secure/master/security.lpc's valid_trace(), userHasWriteAccess(),
// userHasReadAccess()) call it directly rather than going through the
// query_ip_name()/query_ip_number()/query_idle() wrappers below, so it
// needs its own simul_efun (unconditional -- this driver never defines it
// natively, unlike the three query_* wrappers below). Only the three
// flags this codebase actually uses are implemented.
public nomask varargs mixed interactive_info(object ob, int what)
{
    switch (what)
    {
        case II_IP_NUMBER: return query_ip_number(ob);
        case II_IP_NAME:   return query_ip_name(ob);
        case II_IDLE:      return query_idle(ob);
    }
    return 0;
}

// FluffOS PORT NOTE: upstream guarded query_ip_name()/query_ip_number()/
// query_idle() with `#if ! __EFUN_DEFINED__(...)` so they'd only define
// themselves as a fallback on a driver lacking the native efun. All three
// ARE native efuns on this driver (confirmed directly against its own
// packages/core/core.spec) -- so the guard is always false here and the
// fallback bodies are always-dead code, and were simply deleted rather
// than kept behind the guard: `__EFUN_DEFINED__` used inside an
// `inherit`ed fragment file (as opposed to directly in the top-level file
// being compiled) reproducibly hits an unrelated driver preprocessor bug
// on this build ("Condition too complex", from
// compiler/internal/lexer_rules_pp.cc's #if-expression parser failing to
// fully consume the token stream) regardless of which function name is
// checked -- confirmed with a minimal repro. Not investigated further
// (out of scope for this port -- see AGENTS.md's driver-bug-verification
// standard; flagged here for anyone reporting it upstream) since deleting
// the dead fallback code sidesteps it entirely for every real call site in
// this codebase.
