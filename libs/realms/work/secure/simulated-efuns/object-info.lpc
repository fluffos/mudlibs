#include "/sys/object_info.h"

// FluffOS PORT NOTE: upstream guarded set_heart_beat() with
// `#if ! __EFUN_DEFINED__(set_heart_beat)` so it would only define itself
// as a fallback on a driver lacking the native efun. set_heart_beat(int)
// IS a native efun on this driver (confirmed directly against its own
// packages/core/core.spec, same signature) -- so the guard is always
// false here and the fallback body is always-dead code, deleted rather
// than kept behind the guard (see interactive-info.lpc's port note: using
// `__EFUN_DEFINED__` inside an `inherit`ed fragment file reproducibly hits
// an unrelated driver preprocessor bug on this build regardless of the
// function name checked).
//
// query_once_interactive() below is unconditional for the same reason
// (no native equivalent on this driver, so the guard would always be
// true anyway -- see that function's own note for the semantic gap).
/////////////////////////////////////////////////////////////////////////////

// FluffOS PORT NOTE: this driver has neither a native query_once_interactive()
// efun nor the object_info()/OI_ONCE_INTERACTIVE LDMud efun/flag this fallback
// was built on -- and confirmed unused anywhere else in this codebase (grep
// turns up only this definition), so an exact semantic match ("was this
// object ever interactive, even if since disconnected") isn't reachable here.
// Approximated with currently-interactive as the closest available check.
/////////////////////////////////////////////////////////////////////////////
public nomask int query_once_interactive(object ob)
{
    return efun::interactive(ob);
}
