inherit "/secure/master/security/priviledgeGroup.lpc";

/////////////////////////////////////////////////////////////////////////////
protected nomask void applyGroupDetails()
{
    setName("/lib/services/logService");
    addPermission("/log", Read | Write);

    addPriviledgedEfun("write_file");
}
