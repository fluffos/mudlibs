inherit "/secure/master/security/priviledgeGroup.lpc";

/////////////////////////////////////////////////////////////////////////////
protected nomask void applyGroupDetails()
{
    setName("/lib/commands/wizard/cat");
    addPermission("/", Read);

    addPriviledgedEfun("file_size");
    addPriviledgedEfun("read_file");
}
