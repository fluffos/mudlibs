inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/leatherworking-shop.lpc",
        "east", "/areas/eledhel/central-city/leather/0x1.lpc");

    addExit("north", "/areas/eledhel/central-city/14x1.lpc");
    addExit("south", "/areas/eledhel/southern-city/14x9.lpc");
}
