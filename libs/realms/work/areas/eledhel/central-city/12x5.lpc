inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");

    addExit("north", "/areas/eledhel/central-city/12x6.lpc");
    addExit("south", "/areas/eledhel/central-city/12x4.lpc");
    addExit("west", "/areas/eledhel/central-city/11x5.lpc");
    addExit("east", "/areas/eledhel/central-city/13x5.lpc");
}
