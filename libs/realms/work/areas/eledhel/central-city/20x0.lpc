inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/weaponsmith.lpc",
        "west", "/areas/eledhel/central-city/maces/2x1.lpc");
    addBuilding("/lib/environment/buildings/shops/general-shop.lpc",
        "east", "/areas/eledhel/central-city/21x0.lpc");

    addExit("north", "/areas/eledhel/central-city/20x1.lpc");
    addExit("south", "/areas/eledhel/southern-city/20x9.lpc");
}
