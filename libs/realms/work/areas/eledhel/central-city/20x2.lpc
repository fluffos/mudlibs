inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/inn.lpc",
        "east", "/areas/eledhel/central-city/inn/0x4.lpc");

    addExit("west", "/areas/eledhel/central-city/19x2.lpc");
    addExit("south", "/areas/eledhel/central-city/20x1.lpc");
}
