inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/homes/palace.lpc",
        "east", "/areas/eledhel/palace/0x4.lpc");

    addExit("west", "/areas/eledhel/central-city/13x5.lpc");
}
