inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/brewer.lpc",
        "east", "/areas/eledhel/southern-city/13x0.lpc");
    addBuilding("/lib/environment/buildings/civic/theater.lpc",
        "west");

    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");

    addExit("north", "/areas/eledhel/central-city/12x2.lpc");
    addExit("south", "/areas/eledhel/central-city/12x0.lpc");
}
