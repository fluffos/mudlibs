inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/weaponsmith.lpc",
        "east", "/areas/eledhel/central-city/pole-arms/2x1.lpc");
    addBuilding("/lib/environment/buildings/shops/tailor.lpc",
        "west", "/areas/eledhel/central-city/tailor/2x1.lpc");

    addExit("north", "/areas/eledhel/central-city/17x2.lpc");
    addExit("south", "/areas/eledhel/central-city/17x0.lpc");
}
