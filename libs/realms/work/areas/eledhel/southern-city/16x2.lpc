inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/military/military-training-ground.lpc",
        "south");
    addBuilding("/lib/environment/buildings/military/city-wall.lpc", "south");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "east");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "west");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");

    addExit("north", "/areas/eledhel/southern-city/16x3.lpc");
    addExit("south", "/areas/eledhel/southern-city/16x1.lpc");
    addExit("west", "/areas/eledhel/southern-city/15x2.lpc");
    addExit("east", "/areas/eledhel/southern-city/17x2.lpc");
}
