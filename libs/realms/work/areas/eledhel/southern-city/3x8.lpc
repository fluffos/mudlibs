inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/civic/university-building.lpc",
        "south", "/areas/eledhel/southern-city/university/10x10.lpc");

    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "east");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "west");

    addExit("east", "/areas/eledhel/southern-city/4x8.lpc");
    addExit("west", "/areas/eledhel/southern-city/2x8.lpc");
}
