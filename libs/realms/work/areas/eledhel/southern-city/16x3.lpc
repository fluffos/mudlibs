inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/inn.lpc",
        "east", "/areas/eledhel/southern-city/inn/0x0.lpc");
    addBuilding("/lib/environment/buildings/homes/large-limestone-house.lpc",
        "west");

    addExit("north", "/areas/eledhel/southern-city/16x4.lpc");
    addExit("south", "/areas/eledhel/southern-city/16x2.lpc");
}
