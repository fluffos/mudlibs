inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/military/tall-wall-tower.lpc",
        "west", "/areas/eledhel/southern-city/southwest-tower/2x2.lpc");
    addBuilding("/lib/environment/buildings/military/city-wall.lpc", "south");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "east");

    addDecorator("inner east-west wall");

    addExit("north", "/areas/eledhel/southern-city/2x2.lpc");
    addExit("east", "/areas/eledhel/southern-city/3x1.lpc");
}
