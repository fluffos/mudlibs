inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/wainwright.lpc", "east");
    addBuilding("/lib/environment/buildings/shops/apothecary.lpc", 
        "west", "/areas/eledhel/southern-city/11x3.lpc");

    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");

    addExit("north", "/areas/eledhel/southern-city/12x4.lpc");
    addExit("south", "/areas/eledhel/southern-city/12x2.lpc");
}
