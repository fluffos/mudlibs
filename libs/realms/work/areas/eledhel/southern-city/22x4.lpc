inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/pier.lpc");
    addFeature("/lib/environment/features/water/ocean.lpc", "east");
    addBuilding("/lib/environment/buildings/trades/shipYard.lpc", "north");
    addFeature("/lib/environment/features/water/ocean.lpc", "south");

    addDecorator("dock");
    addExit("west", "/areas/eledhel/southern-city/21x4.lpc");
    addExit("east", "/areas/eledhel/southern-city/23x4.lpc");
}
