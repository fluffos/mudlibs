inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/guilds/scion-of-dhuras.lpc", "west");

    addExit("north", "/areas/eledhel/southern-city/9x5.lpc");
    addExit("south", "/areas/eledhel/southern-city/9x3.lpc");
}
