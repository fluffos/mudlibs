inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/gate-house.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "west");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "east");

    addDecorator("south gate house");
    addExitWithDoor("north", "/areas/eledhel/southern-city/12x2.lpc",
        "/lib/environment/doors/portcullis.lpc");
    addExitWithDoor("south", "/areas/eledhel/southern-city/12x0.lpc",
        "/lib/environment/doors/portcullis.lpc");
}
