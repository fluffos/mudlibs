inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/brick-interior-shop.lpc");
    addShop("/lib/environment/shopInventories/medium-armorer.lpc");
    addItem("/lib/environment/items/lighting/window.lpc", "west");
    addItem("/lib/environment/items/lighting/window.lpc", "east");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "south");

    addDecorator("1x1 building armorer");

    addExitWithDoor("west", "/areas/eledhel/southern-city/17x7.lpc");
}
