inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/limestone-interior-shop.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "east");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "west");

    addExit("south", "/areas/eledhel/southern-city/anguleith/3x0.lpc");
}
