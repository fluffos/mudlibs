inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/opulent-entry.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "east");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "west");
    addItem("/lib/environment/items/lighting/window.lpc", "south");

    addExit("north", "/areas/eledhel/southern-city/anguleith/3x1.lpc");
    addExitWithDoor("south", "/areas/eledhel/southern-city/5x2.lpc");
}
