/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/wood-interior.lpc");
    addItem("/lib/environment/items/lighting/window.lpc", "east");

    addDecorator("2x1 building 1x0");
