inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/trades/market.lpc",
        "east", "/areas/eledhel/southern-city/market/0x1.lpc");

    addExit("west", "/areas/eledhel/southern-city/18x5.lpc");
    addExit("south", "/areas/eledhel/southern-city/19x4.lpc");
    addExit("north", "/areas/eledhel/southern-city/19x6.lpc");
}
