inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/pier.lpc");
    addFeature("/lib/environment/features/water/rocky-ocean-shore.lpc", "south");
    addFeature("/lib/environment/features/water/rocky-ocean-shore.lpc", "north");

    addDecorator("dock");
    addExit("west", "/areas/eledhel/southern-city/19x2.lpc");
    addExit("east", "/areas/eledhel/southern-city/21x2.lpc");
}
