inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");

    addBuilding("/lib/environment/buildings/religious/church-of-ilyrth.lpc",
        "east", "/areas/eledhel/southern-city/church-of-ilyrth/0x3.lpc");

    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "west");

    addExit("north", "/areas/eledhel/southern-city/12x6.lpc");
    addExit("south", "/areas/eledhel/southern-city/12x4.lpc");
    addExit("west", "/areas/eledhel/southern-city/11x5.lpc");
}
