inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/bowyer.lpc",
        "west", "/areas/eledhel/southern-city/bowyer/0x2.lpc");
    addBuilding("/lib/environment/buildings/shops/weaponsmith.lpc",
        "east", "/areas/eledhel/southern-city/axe-and-hammer/0x1.lpc");

    addExit("north", "/areas/eledhel/central-city/17x0.lpc");
    addExit("south", "/areas/eledhel/southern-city/17x8.lpc");
}
