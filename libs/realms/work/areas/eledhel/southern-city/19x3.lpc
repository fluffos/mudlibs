inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/inn.lpc",
        "west", "/areas/eledhel/southern-city/inn/0x1.lpc");

    addExit("north", "/areas/eledhel/southern-city/19x4.lpc");
    addExit("south", "/areas/eledhel/southern-city/19x2.lpc");
    addExit("east", "/areas/eledhel/southern-city/20x3.lpc");
}
