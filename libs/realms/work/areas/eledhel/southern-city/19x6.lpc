inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/trades/warehouse.lpc",
        "east", "/areas/eledhel/southern-city/warehouse/0x1.lpc");

    addExit("south", "/areas/eledhel/southern-city/19x5.lpc");
    addExit("north", "/areas/eledhel/southern-city/19x7.lpc");
}
