inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/guilds/scion-of-dhuras.lpc",
        "south", "/areas/eledhel/southern-city/scion-of-dhuras/5x5.lpc");

    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "east");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "west");

    addExit("east", "/areas/eledhel/southern-city/9x5.lpc");
    addExit("west", "/areas/eledhel/southern-city/7x5.lpc");
}
