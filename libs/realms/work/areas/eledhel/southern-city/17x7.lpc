inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/trades/foundry.lpc", "west",
        "/areas/eledhel/southern-city/foundry/2x4.lpc");
    addBuilding("/lib/environment/buildings/shops/armorer.lpc",
        "east", "/areas/eledhel/southern-city/18x7.lpc");

    addExit("north", "/areas/eledhel/southern-city/17x8.lpc");
    addExit("south", "/areas/eledhel/southern-city/17x6.lpc");
}
