inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/guilds/scion-of-dhuras.lpc",
        "east", "/areas/eledhel/southern-city/scion-of-dhuras/0x1.lpc");

    addExit("north", "/areas/eledhel/southern-city/6x4.lpc");
    addExit("south", "/areas/eledhel/southern-city/6x2.lpc");
}
