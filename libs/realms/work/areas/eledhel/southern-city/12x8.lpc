inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/dyer.lpc",
        "east", "/areas/eledhel/southern-city/13x8.lpc");
    addBuilding("/lib/environment/buildings/shops/potter.lpc",
        "west", "/areas/eledhel/southern-city/11x8.lpc");

    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");

    addExit("north", "/areas/eledhel/southern-city/12x9.lpc");
    addExit("south", "/areas/eledhel/southern-city/12x7.lpc");
}
