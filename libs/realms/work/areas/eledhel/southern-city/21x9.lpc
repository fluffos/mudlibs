inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/items/shops/grocer.lpc");
    addItem("/lib/environment/items/lighting/window.lpc", "west");

    addDecorator("2x1 grocer 0x0");
    addExit("west", "/areas/eledhel/southern-city/20x9.lpc");
    addExitWithDoor("east", "/areas/eledhel/southern-city/22x9.lpc");
}
