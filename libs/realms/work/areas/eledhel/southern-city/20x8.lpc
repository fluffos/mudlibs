inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/swordsmith.lpc",
        "west", "/areas/eledhel/southern-city/swordsmith/2x1.lpc");
    addBuilding("/lib/environment/buildings/shops/ship-wright.lpc",
        "east", "/areas/eledhel/southern-city/21x8.lpc");

    addExit("north", "/areas/eledhel/southern-city/20x9.lpc");
    addExit("south", "/areas/eledhel/southern-city/20x7.lpc");
}
