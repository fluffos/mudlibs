inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/military/tall-stone-wall.lpc",
        "west");
    addBuilding("/lib/environment/buildings/homes/manor.lpc", "east",
        "/areas/eledhel/southern-city/hrongar/0x3.lpc");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");
    addFeature("/lib/environment/features/paths/entry-path.lpc", "east");

    addDecorator("inner north-south wall");

    addExit("north", "/areas/eledhel/southern-city/1x4.lpc");
    addExit("south", "/areas/eledhel/southern-city/1x2.lpc");
}
