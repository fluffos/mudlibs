inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/inn.lpc", "south");

    addExit("east", "/areas/eledhel/southern-city/19x5.lpc");
    addExit("west", "/areas/eledhel/southern-city/17x5.lpc");
}
