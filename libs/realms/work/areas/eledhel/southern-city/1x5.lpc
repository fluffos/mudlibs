inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/military/wall-tower.lpc",
        "west", "/areas/eledhel/southern-city/west-wall/2x8.lpc");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "east");

    addDecorator("inner north-south wall");
    addExit("east", "/areas/eledhel/southern-city/2x5.lpc");
    addExit("north", "/areas/eledhel/southern-city/1x6.lpc");
    addExit("south", "/areas/eledhel/southern-city/1x4.lpc");
}
