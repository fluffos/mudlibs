inherit "/lib/environment/region.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setRegionName("Eledhel-southern-swordsmith");
    setRegionType("limestone building");
    setDimensions(5, 5);

    setCoordinate(0, 0,
        "/areas/eledhel/southern-city/swordsmith/0x0.lpc", "shop");
    setCoordinate(0, 1,
        "/areas/eledhel/southern-city/swordsmith/0x1.lpc", "room");
    setCoordinate(0, 2,
        "/areas/eledhel/southern-city/swordsmith/0x2.lpc", "shop");

    setCoordinate(1, 0,
        "/areas/eledhel/southern-city/swordsmith/1x0.lpc", "room");
    setCoordinate(1, 1,
        "/areas/eledhel/southern-city/swordsmith/1x1.lpc", "room");
    setCoordinate(1, 2,
        "/areas/eledhel/southern-city/swordsmith/1x2.lpc", "room");

    setCoordinate(2, 0,
        "/areas/eledhel/southern-city/swordsmith/2x0.lpc", "room");
    setCoordinate(2, 1,
        "/areas/eledhel/southern-city/swordsmith/2x1.lpc", "room");
    setCoordinate(2, 2,
        "/areas/eledhel/southern-city/swordsmith/2x2.lpc", "room");
}
