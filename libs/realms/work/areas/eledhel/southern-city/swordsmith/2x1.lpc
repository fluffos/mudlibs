inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/limestone-interior-shop.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "north");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "south");
    addItem("/lib/environment/items/lighting/window.lpc", "east");

    addExit("west", "/areas/eledhel/southern-city/swordsmith/0x1.lpc");
    addExitWithDoor("east", "/areas/eledhel/southern-city/20x8.lpc");
}
