inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/limestone-interior-shop.lpc");
    addItem("/lib/environment/items/lighting/window.lpc", "west");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "south");
    addShop("/lib/environment/shopInventories/dagger-smith.lpc");

    addExit("south", "/areas/eledhel/southern-city/swordsmith/0x1.lpc");
}
