inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/limestone-interior-shop.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "east");
    addItem("/lib/environment/items/lighting/window.lpc", "west");

    addExitWithDoor("west", "/areas/eledhel/southern-city/17x8.lpc");
    addExit("east", "/areas/eledhel/southern-city/swordsmith/1x1.lpc");
    addExit("north", "/areas/eledhel/southern-city/swordsmith/0x2.lpc");
    addExit("south", "/areas/eledhel/southern-city/swordsmith/0x0.lpc");
}
