inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/limestone-interior-shop.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "west");
    addItem("/lib/environment/items/lighting/window.lpc", "north");

    addExit("south", "/areas/eledhel/southern-city/swordsmith/1x1.lpc");
    addExitWithDoor("east", "/areas/eledhel/southern-city/swordsmith/2x2.lpc");
}
