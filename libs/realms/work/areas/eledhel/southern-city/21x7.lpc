inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/trades/shipYard.lpc",
        "east", "/areas/eledhel/southern-city/shipyard/0x1.lpc");

    addExit("west", "/areas/eledhel/southern-city/20x7.lpc");
}
