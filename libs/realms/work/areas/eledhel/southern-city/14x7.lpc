inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/trades/smelter.lpc", "east");

    addExit("north", "/areas/eledhel/southern-city/14x8.lpc");
    addExit("south", "/areas/eledhel/southern-city/14x6.lpc");
}
