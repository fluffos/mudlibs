inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/military/gate-house.lpc", 
        "north", "/areas/eledhel/southern-city/12x1.lpc");
    addBuilding("/lib/environment/buildings/military/tall-wall-tower.lpc", 
        "west");
    addBuilding("/lib/environment/buildings/military/tall-wall-tower.lpc", 
        "east");

    addExit("south", "/areas/eledhel/southern-rural/3x9.lpc");
}
