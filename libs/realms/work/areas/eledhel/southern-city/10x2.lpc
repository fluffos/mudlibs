inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/military/tall-wall-tower.lpc",
        "south", "/areas/eledhel/southern-city/southwest-gate-tower/0x4.lpc");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "east");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "west");
    addFeature("/lib/environment/features/paths/entry-path.lpc", "south");

    addExit("west", "/areas/eledhel/southern-city/9x2.lpc");
    addExit("east", "/areas/eledhel/southern-city/11x2.lpc");
}
