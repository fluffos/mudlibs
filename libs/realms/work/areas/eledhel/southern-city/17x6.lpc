inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/armorer.lpc",
        "east", "/areas/eledhel/southern-city/18x6.lpc");

    addExit("north", "/areas/eledhel/southern-city/17x7.lpc");
    addExit("south", "/areas/eledhel/southern-city/17x5.lpc");
}
