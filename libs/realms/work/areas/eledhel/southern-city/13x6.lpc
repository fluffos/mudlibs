inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addShop("/lib/environment/shopInventories/jeweler.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "east");
    addItem("/lib/environment/items/lighting/window.lpc", "west");

    addDecorator("1x1 building jeweler");
    addExitWithDoor("west", "/areas/eledhel/southern-city/12x6.lpc");
}
