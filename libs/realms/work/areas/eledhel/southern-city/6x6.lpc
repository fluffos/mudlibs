inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/book-vendor.lpc",
        "east", "/areas/eledhel/southern-city/7x6.lpc");

    addExit("north", "/areas/eledhel/southern-city/6x7.lpc");
    addExit("south", "/areas/eledhel/southern-city/6x5.lpc");
}
