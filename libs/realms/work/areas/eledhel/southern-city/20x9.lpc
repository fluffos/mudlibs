inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/city.lpc");
    addBuilding("/lib/environment/buildings/shops/weaponsmith.lpc",
        "west", "/areas/eledhel/southern-city/axe-and-hammer/2x1.lpc");
    addBuilding("/lib/environment/buildings/shops/grocer.lpc",
        "east", "/areas/eledhel/southern-city/21x9.lpc");

    addExit("south", "/areas/eledhel/southern-city/20x8.lpc");
    addExit("north", "/areas/eledhel/central-city/20x0.lpc");
}
