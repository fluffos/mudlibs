inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/wood-interior-shop.lpc");
    addShop("/lib/environment/shopInventories/apothecary.lpc");
    addItem("/lib/environment/items/lighting/window.lpc", "west");
    addItem("/lib/environment/items/lighting/window.lpc", "south");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "north");

    addDecorator("1x1 building apothecary");
    addExitWithDoor("east", "/areas/eledhel/southern-city/12x3.lpc");
}
