inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/wood-interior-shop.lpc");
    addItem("/lib/environment/items/lighting/window.lpc", "west");

    addDecorator("2x1 shipwright 0x0");
    addExit("west", "/areas/eledhel/southern-city/20x8.lpc");
    addExitWithDoor("east", "/areas/eledhel/southern-city/22x8.lpc");
}
