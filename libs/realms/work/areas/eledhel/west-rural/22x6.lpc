inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "west");
    addFeature("/lib/environment/features/landforms/glen.lpc", "west");
    addFeature("/lib/environment/features/trees/nectarine-stand.lpc", "west");

    addExit("south", "/areas/eledhel/west-rural/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural/22x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/eledhel/west-rural/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
