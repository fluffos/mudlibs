inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "south");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "south");

    addExit("west", "/areas/eledhel/west-rural/3x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/eledhel/west-rural/4x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
