inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "southwest");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/mound.lpc", "southwest");

    addExit("east", "/areas/eledhel/west-rural/4x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/eledhel/west-rural/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
