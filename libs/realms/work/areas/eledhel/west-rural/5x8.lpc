inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "north");

    addExit("south", "/areas/eledhel/west-rural/5x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural/6x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
