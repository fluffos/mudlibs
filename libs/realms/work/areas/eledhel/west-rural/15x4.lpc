inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "south");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "south");

    addExit("west", "/areas/eledhel/west-rural/14x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"weasel","skunk","boar","raccoon"}));
}
