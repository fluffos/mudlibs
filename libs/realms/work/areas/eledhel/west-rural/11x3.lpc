inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/mound.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");

    addExit("south", "/areas/eledhel/west-rural/11x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural/11x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/eledhel/west-rural/12x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
