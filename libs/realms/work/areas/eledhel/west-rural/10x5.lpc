inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "west");

    addExit("south", "/areas/eledhel/west-rural/10x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/eledhel/west-rural/9x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/eledhel/west-rural/11x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
