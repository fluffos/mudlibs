inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northeast");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "northeast");

    addExit("south", "/areas/eledhel/west-rural/17x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/eledhel/west-rural/16x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
