inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "southeast");
    addFeature("/lib/environment/features/trees/ironwood-stand.lpc", "southeast");

    addExit("east", "/areas/eledhel/west-rural/15x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/eledhel/west-rural/13x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"warg","otter","keeper of the night","mink","opossum"}));
}
