inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-waterfall.lpc", "west");
    addFeature("/lib/environment/features/landforms/crag.lpc", "west");

    addExit("north", "/areas/eledhel/west-rural/20x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/eledhel/west-rural/19x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"otter","skunk","boar","skeleton"}));
}
