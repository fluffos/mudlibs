inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "southwest");
    addFeature("/lib/environment/features/trees/grape-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southwest");

    addExit("west", "/areas/eledhel/west-rural/17x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural/18x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
