inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "south");
    addFeature("/lib/environment/features/water/brook.lpc", "south");
    addFeature("/lib/environment/features/trees/grape-stand.lpc", "south");

    addExit("north", "/areas/eledhel/west-rural/8x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"gopher","ruffian","zombie","outlaw","boar","skeleton"}));
}
