inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southeast");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "southeast");

    addExit("south", "/areas/eledhel/west-rural/17x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural/17x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"black bear","boar","skeleton"}));
}
