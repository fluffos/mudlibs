inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "southwest");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "southwest");

    addExit("south", "/areas/eledhel/west-rural/20x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/eledhel/west-rural/19x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural/20x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
