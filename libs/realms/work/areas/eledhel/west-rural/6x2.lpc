inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "north");
    addFeature("/lib/environment/features/water/canyon-brook.lpc", "north");
    addFeature("/lib/environment/features/water/pond.lpc", "north");

    addExit("south", "/areas/eledhel/west-rural/6x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural/7x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/eledhel/west-rural/5x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
