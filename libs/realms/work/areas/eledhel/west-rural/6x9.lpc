inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "southeast");

    addExit("south", "/areas/eledhel/west-rural/6x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural/7x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
