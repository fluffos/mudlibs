inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "south");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "south");
    addFeature("/lib/environment/features/landforms/hill.lpc", "south");

    addExit("east", "/areas/eledhel/west-rural/21x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/eledhel/west-rural/20x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","warg","kit fox"}));
}
