inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hill.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "east");

    addExit("west", "/areas/eledhel/west-rural/10x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/eledhel/west-rural/12x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"gray fox","ruffian","porcupine","outlaw","white-tail deer"}));
}
