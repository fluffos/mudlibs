inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "east");
    addFeature("/lib/environment/features/trees/persimmon-stand.lpc", "east");

    addExit("south", "/areas/eledhel/west-rural/23x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/eledhel/west-rural/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
