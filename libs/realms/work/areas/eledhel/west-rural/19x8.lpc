inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northeast");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "northeast");

    addExit("south", "/areas/eledhel/west-rural/19x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural/19x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"opossum","mink","chipmunk"}));
}
