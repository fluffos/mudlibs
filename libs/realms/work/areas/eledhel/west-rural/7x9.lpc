inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northwest");

    addExit("west", "/areas/eledhel/west-rural/6x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"black bear","muskrat","porcupine","mule deer","groundhog"}));
}
