inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");
    addFeature("/lib/environment/features/water/rocky-lake-shore.lpc", "northwest");

    addExit("east", "/areas/eledhel/west-rural/16x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/eledhel/west-rural/15x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
