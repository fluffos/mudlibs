inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "southwest");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "southwest");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");

    addExit("west", "/areas/eledhel/west-rural/9x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/eledhel/west-rural/11x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
