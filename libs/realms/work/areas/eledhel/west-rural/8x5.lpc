inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "northwest");
    addFeature("/lib/environment/features/water/river.lpc", "northwest");

    addExit("south", "/areas/eledhel/west-rural/8x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/eledhel/west-rural/7x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
