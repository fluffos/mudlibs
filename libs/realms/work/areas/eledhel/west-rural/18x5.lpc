inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "northwest");
    addFeature("/lib/environment/features/water/lake-shore-bluff.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "northwest");

    addExit("west", "/areas/eledhel/west-rural/17x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"warg","mule deer","outlaw"}));
}
