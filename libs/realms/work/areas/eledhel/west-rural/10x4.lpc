inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northwest");

    addExit("east", "/areas/eledhel/west-rural/11x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/eledhel/west-rural/10x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
