inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southwest");

    addExit("south", "/areas/eledhel/west-rural/13x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural/13x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/eledhel/west-rural/14x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
