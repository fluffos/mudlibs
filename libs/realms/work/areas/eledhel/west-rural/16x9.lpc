inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "east");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "east");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "east");

    addExit("east", "/areas/eledhel/west-rural/17x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/eledhel/west-rural/16x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
