inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "west");
    addFeature("/lib/environment/features/landforms/hill.lpc", "west");

    addExit("north", "/areas/eledhel/west-rural/15x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/eledhel/west-rural/14x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"zombie","mule deer","keeper of the night","raccoon","red squirrel","kit fox"}));
}
