inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northwest");

    addExit("north", "/areas/eledhel/west-rural/3x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/eledhel/west-rural/4x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","coyote","porcupine","timber wolf"}));
}
