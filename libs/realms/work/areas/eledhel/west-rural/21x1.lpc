inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southeast");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "southeast");

    addExit("east", "/areas/eledhel/west-rural/22x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","zombie","gopher","boar"}));
}
