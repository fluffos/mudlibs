inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "southeast");
    addFeature("/lib/environment/features/trees/cedar-stand.lpc", "southeast");

    addExit("south", "/areas/eledhel/west-rural/2x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural/3x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
