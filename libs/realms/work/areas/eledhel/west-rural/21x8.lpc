inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "northeast");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "northeast");

    addExit("south", "/areas/eledhel/west-rural/21x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/eledhel/west-rural/20x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
