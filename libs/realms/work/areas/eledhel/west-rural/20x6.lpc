inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "north");
    addFeature("/lib/environment/features/water/river.lpc", "north");
    addFeature("/lib/environment/features/trees/buckthorn-stand.lpc", "north");

    addExit("north", "/areas/eledhel/west-rural/20x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/eledhel/west-rural/20x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"hunter","outlaw","keeper of the night","red wolf"}));
}
