inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "south");
    addFeature("/lib/environment/features/trees/montmorency-cherry-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "south");

    addExit("east", "/areas/eledhel/west-rural/20x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"zombie","porcupine","outlaw","panther","groundhog","mink"}));
}
