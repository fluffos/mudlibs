inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "northwest");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northwest");

    addExit("east", "/areas/eledhel/west-rural/11x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/eledhel/west-rural/10x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
