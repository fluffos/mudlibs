inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/red-apple-stand.lpc", "southwest");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "southwest");

    addExit("north", "/areas/eledhel/west-rural/4x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/eledhel/west-rural/4x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
