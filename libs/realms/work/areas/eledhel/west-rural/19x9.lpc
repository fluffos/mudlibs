inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "south");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "south");
    addFeature("/lib/environment/features/trees/cedar-stand.lpc", "south");

    addExit("west", "/areas/eledhel/west-rural/18x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/eledhel/west-rural/19x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"fisher","ruffian","skeleton","raccoon"}));
}
