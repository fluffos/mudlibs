inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "south");
    addFeature("/lib/environment/features/landforms/glen.lpc", "south");

    addExit("south", "/areas/eledhel/west-rural/9x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/eledhel/west-rural/8x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural/9x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
