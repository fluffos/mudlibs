inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "west");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "west");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "west");

    addExit("west", "/areas/eledhel/west-rural/6x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/eledhel/west-rural/8x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
