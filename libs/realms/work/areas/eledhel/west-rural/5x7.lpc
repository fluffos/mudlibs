inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pear-stand.lpc", "southeast");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "southeast");

    addExit("east", "/areas/eledhel/west-rural/6x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/eledhel/west-rural/5x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
