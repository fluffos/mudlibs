inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "south");

    addExit("east", "/areas/eledhel/west-rural/6x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/eledhel/west-rural/5x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","fisher"}));
}
