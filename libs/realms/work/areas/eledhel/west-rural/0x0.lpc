inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southeast");
    addFeature("/lib/environment/features/water/brook.lpc", "southeast");

    addExit("north", "/areas/eledhel/west-rural/0x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"hunter","fisher","outlaw","keeper of the night","chipmunk"}));
}
