inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "northwest");
    addFeature("/lib/environment/features/water/river.lpc", "northwest");

    addExit("west", "/areas/eledhel/west-rural/5x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural/6x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
