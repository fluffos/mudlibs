inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/dell.lpc", "east");

    addExit("south", "/areas/eledhel/west-rural/24x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural/24x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
