inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "west");
    addFeature("/lib/environment/features/water/creek.lpc", "west");

    addExit("east", "/areas/eledhel/west-rural/4x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/eledhel/west-rural/3x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
