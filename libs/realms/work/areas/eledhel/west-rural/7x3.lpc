inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/hickory-stand.lpc", "northwest");

    addExit("west", "/areas/eledhel/west-rural/6x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"gray fox","ruffian","warg","otter","outlaw","badger"}));
}
