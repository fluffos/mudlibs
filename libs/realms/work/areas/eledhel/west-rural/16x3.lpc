inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/red-oak-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/hill.lpc", "west");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "west");

    addExit("east", "/areas/eledhel/west-rural/17x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"gopher","skeleton","gray wolf"}));
}
