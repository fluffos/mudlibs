inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "north");
    addFeature("/lib/environment/features/trees/nectarine-stand.lpc", "north");

    addExit("north", "/areas/eledhel/west-rural/22x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/eledhel/west-rural/21x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","black bear","outlaw","timber wolf","opossum"}));
}
