inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/river.lpc", "north");
    addFeature("/lib/environment/features/trees/McIntosh-apple-stand.lpc", "north");

    addExit("east", "/areas/eledhel/west-rural/5x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/eledhel/west-rural/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","mink","otter"}));
}
