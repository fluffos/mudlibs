inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");

    addExit("west", "/areas/eledhel/southwest-rural-two/20x1.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "west");
    addExit("north", "/areas/eledhel/southwest-rural-two/21x2.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "north");
}

