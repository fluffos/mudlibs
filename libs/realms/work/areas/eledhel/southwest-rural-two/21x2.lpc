inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");

    addExit("south", "/areas/eledhel/southwest-rural-two/21x1.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "south");
    addExit("east", "/areas/eledhel/southwest-rural-two/22x2.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "east");
}

