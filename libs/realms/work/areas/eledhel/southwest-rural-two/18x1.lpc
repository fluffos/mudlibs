inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest-clearing.lpc");

    addExit("north", "/areas/eledhel/southwest-rural-two/18x2.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "north");
    addExit("east", "/areas/eledhel/southwest-rural-two/19x1.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "east");
    addExit("west", "/areas/eledhel/southwest-rural-two/17x1.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "west");
}
