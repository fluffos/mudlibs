inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");

    addExit("west", "/areas/eledhel/southwest-rural-two/5x2.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "west");
    addExit("south", "/areas/eledhel/southwest-rural-two/6x1.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "south");
}

