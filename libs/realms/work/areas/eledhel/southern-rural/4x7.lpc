inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");

    addExit("south", "/areas/eledhel/southern-rural/4x6.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "south");
    addExit("west", "/areas/eledhel/southern-rural/3x7.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "west");
}

