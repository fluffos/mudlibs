inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");

    addExit("north", "/areas/eledhel/southern-city/12x0.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "north");

    addExit("south", "/areas/eledhel/southern-rural/3x8.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "south");
    addExit("east", "/areas/eledhel/southern-rural/4x9.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "east");
}
