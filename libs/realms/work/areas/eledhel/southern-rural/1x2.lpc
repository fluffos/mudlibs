inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");

    addExit("north", "/areas/eledhel/southern-rural/1x3.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "north");
    addExit("west", "/areas/eledhel/southern-rural/0x2.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "west");
}

