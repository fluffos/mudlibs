inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");

    addExit("north", "/areas/eledhel/southwest-rural-one/16x1.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "north");
    addExit("east", "/areas/eledhel/southwest-rural-one/17x0.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "east");
    addExit("west", "/areas/eledhel/southwest-rural-one/15x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
