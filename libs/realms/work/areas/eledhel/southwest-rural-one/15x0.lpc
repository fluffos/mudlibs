inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");

    addExit("east", "/areas/eledhel/southwest-rural-one/16x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addGeneratedRegion("south", "forest", 25, 10);
}
