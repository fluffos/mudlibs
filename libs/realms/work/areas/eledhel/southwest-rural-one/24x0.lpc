inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");

    addExit("west", "/areas/eledhel/southwest-rural-one/23x0.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "west");

    addExit("east", "/areas/eledhel/southern-rural/0x7.lpc");
    addFeature("/lib/environment/features/paths/road.lpc", "east");
}
