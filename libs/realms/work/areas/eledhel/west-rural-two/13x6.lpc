inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "south");
    addFeature("/lib/environment/features/landforms/combe.lpc", "south");
    addFeature("/lib/environment/features/water/rocky-lake-shore.lpc", "south");

    addExit("south", "/areas/eledhel/west-rural-two/13x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/eledhel/west-rural-two/12x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
