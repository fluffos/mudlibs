inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("west", "/areas/eledhel/west-rural-two/9x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural-two/10x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
