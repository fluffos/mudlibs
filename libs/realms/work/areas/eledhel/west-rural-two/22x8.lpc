inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cortland-apple-stand.lpc", "east");
    addFeature("/lib/environment/features/water/waterfall.lpc", "east");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "east");

    addExit("south", "/areas/eledhel/west-rural-two/22x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural-two/22x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
