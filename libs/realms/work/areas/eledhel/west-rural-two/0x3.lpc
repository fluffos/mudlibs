inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/yew-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/tor.lpc", "east");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "east");

    addExit("east", "/areas/eledhel/west-rural-two/1x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/eledhel/west-rural-two/0x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
