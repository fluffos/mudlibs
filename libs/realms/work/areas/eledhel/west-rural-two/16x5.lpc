inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/waterfall.lpc", "southeast");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "southeast");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "southeast");

    addExit("north", "/areas/eledhel/west-rural-two/16x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/eledhel/west-rural-two/15x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
