inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/hill.lpc", "south");

    addExit("west", "/areas/eledhel/west-rural-two/8x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/eledhel/west-rural-two/10x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"brown bear","mule deer","coyote"}));
}
