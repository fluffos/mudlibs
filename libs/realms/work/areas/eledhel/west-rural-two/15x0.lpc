inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cortland-apple-stand.lpc", "southwest");
    addFeature("/lib/environment/features/water/ravine-waterfall.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/hill.lpc", "southwest");

    addExit("west", "/areas/eledhel/west-rural-two/14x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural-two/15x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
