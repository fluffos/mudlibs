inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/butte.lpc", "southwest");

    addExit("south", "/areas/eledhel/west-rural-two/8x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural-two/9x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
