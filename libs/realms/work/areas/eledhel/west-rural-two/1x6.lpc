inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "northeast");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "northeast");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "northeast");

    addExit("south", "/areas/eledhel/west-rural-two/1x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"black bear","ruffian","outlaw","beaver","gray squirrel"}));
}
