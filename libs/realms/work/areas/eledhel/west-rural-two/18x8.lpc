inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("south", "/areas/eledhel/west-rural-two/18x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/eledhel/west-rural-two/17x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural-two/18x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
