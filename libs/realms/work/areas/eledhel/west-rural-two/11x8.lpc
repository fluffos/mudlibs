inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "southwest");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "southwest");

    addExit("north", "/areas/eledhel/west-rural-two/11x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/eledhel/west-rural-two/12x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
