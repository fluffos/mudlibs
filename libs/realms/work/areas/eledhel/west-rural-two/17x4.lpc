inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/crag.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "northeast");

    addExit("west", "/areas/eledhel/west-rural-two/16x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural-two/17x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
