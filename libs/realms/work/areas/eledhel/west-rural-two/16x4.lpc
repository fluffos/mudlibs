inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northeast");
    addFeature("/lib/environment/features/trees/golden-apple-stand.lpc", "northeast");

    addExit("east", "/areas/eledhel/west-rural-two/17x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/eledhel/west-rural-two/16x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"outlaw","red fox","raccoon","white-tail deer"}));
}
