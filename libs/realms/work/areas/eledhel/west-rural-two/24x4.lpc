inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "southeast");
    addFeature("/lib/environment/features/water/creek.lpc", "southeast");

    addExit("south", "/areas/eledhel/west-rural-two/24x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural-two/24x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
