inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");
    addFeature("/lib/environment/features/water/rocky-lake-shore.lpc", "north");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "north");

    addExit("south", "/areas/eledhel/west-rural-two/10x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"groundhog","muskrat","coyote"}));
}
