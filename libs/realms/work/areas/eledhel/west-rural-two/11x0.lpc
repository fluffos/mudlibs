inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "east");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "east");

    addExit("west", "/areas/eledhel/west-rural-two/10x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/eledhel/west-rural-two/12x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
