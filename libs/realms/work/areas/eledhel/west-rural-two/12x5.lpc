inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "northeast");
    addFeature("/lib/environment/features/water/creek.lpc", "northeast");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "northeast");

    addExit("south", "/areas/eledhel/west-rural-two/12x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural-two/13x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
