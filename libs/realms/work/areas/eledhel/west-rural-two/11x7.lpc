inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "north");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "north");

    addExit("south", "/areas/eledhel/west-rural-two/11x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural-two/12x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
