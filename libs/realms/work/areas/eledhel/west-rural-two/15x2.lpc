inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/combe.lpc", "north");
    addFeature("/lib/environment/features/landforms/mound.lpc", "north");

    addExit("south", "/areas/eledhel/west-rural-two/15x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural-two/15x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
