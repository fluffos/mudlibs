inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/glen.lpc", "north");
    addFeature("/lib/environment/features/trees/persimmon-stand.lpc", "north");

    addExit("south", "/areas/eledhel/west-rural-two/23x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural-two/23x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/eledhel/west-rural-two/22x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
