inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/crag.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/hill.lpc", "southwest");

    addExit("south", "/areas/eledhel/west-rural-two/4x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/eledhel/west-rural-two/4x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
