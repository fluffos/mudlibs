inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "northeast");

    addExit("south", "/areas/eledhel/west-rural-two/7x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural-two/8x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/eledhel/west-rural-two/6x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"hunter","outlaw","badger","white-tail deer"}));
}
