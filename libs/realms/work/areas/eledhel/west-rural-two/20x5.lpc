inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "west");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "west");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "west");

    addExit("north", "/areas/eledhel/west-rural-two/20x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"zombie","skunk","outlaw","opossum"}));
}
