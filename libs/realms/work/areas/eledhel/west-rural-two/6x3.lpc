inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "east");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "east");

    addExit("south", "/areas/eledhel/west-rural-two/6x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural-two/7x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
