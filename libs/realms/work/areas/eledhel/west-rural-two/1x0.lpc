inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/cedar-stand.lpc", "north");

    addExit("west", "/areas/eledhel/west-rural-two/0x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
