inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southeast");
    addFeature("/lib/environment/features/trees/buckthorn-stand.lpc", "southeast");

    addExit("east", "/areas/eledhel/west-rural-two/9x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/eledhel/west-rural-two/7x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
