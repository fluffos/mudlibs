inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "southwest");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "southwest");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "southwest");

    addExit("west", "/areas/eledhel/west-rural-two/5x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural-two/6x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
