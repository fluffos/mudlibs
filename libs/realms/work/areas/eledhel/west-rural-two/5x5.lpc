inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "north");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "north");

    addExit("east", "/areas/eledhel/west-rural-two/6x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/eledhel/west-rural-two/5x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
