inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "east");
    addFeature("/lib/environment/features/trees/dogwood-stand.lpc", "east");

    addExit("south", "/areas/eledhel/west-rural-two/6x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural-two/7x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/eledhel/west-rural-two/5x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
