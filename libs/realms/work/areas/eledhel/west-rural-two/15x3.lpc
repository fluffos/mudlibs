inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/tor.lpc", "southeast");

    addExit("south", "/areas/eledhel/west-rural-two/15x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural-two/16x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
