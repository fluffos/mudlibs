inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "west");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "west");
    addFeature("/lib/environment/features/landforms/mound.lpc", "west");

    addExit("south", "/areas/eledhel/west-rural-two/10x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"outlaw","porcupine","gray squirrel","skeleton"}));
}
