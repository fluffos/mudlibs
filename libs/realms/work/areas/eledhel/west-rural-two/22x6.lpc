inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "northwest");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");

    addExit("east", "/areas/eledhel/west-rural-two/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/eledhel/west-rural-two/22x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
