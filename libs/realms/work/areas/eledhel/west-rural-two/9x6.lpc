inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "west");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "west");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");

    addExit("south", "/areas/eledhel/west-rural-two/9x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"hunter","mule deer","outlaw","skeleton","opossum","mink"}));
}
