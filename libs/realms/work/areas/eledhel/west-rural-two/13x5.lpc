inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("north", "/areas/eledhel/west-rural-two/13x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/eledhel/west-rural-two/14x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/eledhel/west-rural-two/12x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
