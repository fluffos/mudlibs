inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "southwest");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "southwest");
    addFeature("/lib/environment/features/trees/aspen-stand.lpc", "southwest");

    addExit("east", "/areas/eledhel/west-rural-two/2x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/eledhel/west-rural-two/0x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","zombie","fisher","skeleton","white-tail deer"}));
}
