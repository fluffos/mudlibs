inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/bing-cherry-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/dell.lpc", "north");

    addExit("west", "/areas/eledhel/west-rural-two/18x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural-two/19x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
