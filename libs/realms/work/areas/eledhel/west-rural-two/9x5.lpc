inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "southwest");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/combe.lpc", "southwest");

    addExit("west", "/areas/eledhel/west-rural-two/8x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/eledhel/west-rural-two/9x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/eledhel/west-rural-two/10x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
