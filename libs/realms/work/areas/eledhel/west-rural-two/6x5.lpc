inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "east");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "east");
    addFeature("/lib/environment/features/landforms/mound.lpc", "east");

    addExit("west", "/areas/eledhel/west-rural-two/5x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"weasel","gopher","porcupine","opossum","badger","kit fox"}));
}
