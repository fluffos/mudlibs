inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "northwest");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");

    addExit("west", "/areas/eledhel/west-rural-two/8x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/eledhel/west-rural-two/10x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
