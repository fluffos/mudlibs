inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/dell.lpc", "south");
    addFeature("/lib/environment/features/landforms/hill.lpc", "south");

    addExit("east", "/areas/eledhel/west-rural-two/21x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/eledhel/west-rural-two/20x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"hunter","red squirrel","opossum"}));
}
