inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/crag.lpc", "north");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "north");

    addExit("south", "/areas/eledhel/west-rural-two/17x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/eledhel/west-rural-two/18x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
