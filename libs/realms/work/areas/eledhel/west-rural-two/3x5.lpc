inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "northeast");

    addExit("north", "/areas/eledhel/west-rural-two/3x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/eledhel/west-rural-two/4x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
