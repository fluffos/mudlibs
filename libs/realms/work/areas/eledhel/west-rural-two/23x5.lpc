inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hill.lpc", "east");

    addExit("east", "/areas/eledhel/west-rural-two/24x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/eledhel/west-rural-two/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
