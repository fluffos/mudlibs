inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "south");

    addExit("east", "/areas/eledhel/west-rural-two/6x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"hunter","zombie","knight of the storm","outlaw","keeper of the night","red squirrel","skeleton"}));
}
