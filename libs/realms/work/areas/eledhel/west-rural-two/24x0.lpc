inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/McIntosh-apple-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "north");

    addExit("north", "/areas/eledhel/west-rural-two/24x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/eledhel/west-rural-two/23x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
