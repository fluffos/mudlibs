inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/pond.lpc", "west");
    addFeature("/lib/environment/features/trees/aspen-stand.lpc", "west");

    addExit("east", "/areas/eledhel/west-rural-two/8x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/eledhel/west-rural-two/7x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"black bear","weasel","ruffian","outlaw"}));
}
