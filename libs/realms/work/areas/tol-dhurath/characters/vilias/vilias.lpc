inherit "/lib/realizations/npc.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("vilias");
    short("A raven-haired woman");
    description("A woman dressed in a flowing midnight blue dress. She is a "
        "tall, raven-haired, gray-eyed woman of surpassing beauty.");
    addAlias("woman");
    addAlias("raven-haired woman");

    Gender("female");
    Race("deity");
    SetUpPersonaOfLevel("oneiromancer", 80);
    addTrait("/lib/instances/traits/archetypes/iitj.lpc");
    addTrait("/lib/instances/traits/educational/tactician.lpc");
    addTrait("/lib/instances/traits/educational/architect.lpc");
    addTrait("/lib/instances/traits/educational/articulate.lpc");
    addTrait("/lib/instances/traits/educational/arcane.lpc");
    addTrait("/lib/instances/traits/educational/educated.lpc");
    addTrait("/lib/instances/traits/educational/mastermind.lpc");
    addTrait("/lib/instances/traits/eyes/gray.lpc");
    addTrait("/lib/instances/traits/genetic/attractive.lpc");
    addTrait("/lib/instances/traits/genetic/genius.lpc");
    addTrait("/lib/instances/traits/hair/raven.lpc");
    addTrait("/lib/instances/traits/personality/cold.lpc");
    addTrait("/lib/instances/traits/personality/cynical.lpc");
    addTrait("/lib/instances/traits/personality/feared.lpc");
    addTrait("/lib/instances/traits/personality/manipulative.lpc");
    addTrait("/lib/instances/traits/personality/passionate.lpc");
    addTrait("/lib/instances/traits/personality/sardonic.lpc");
    addTrait("/lib/instances/traits/personality/stubborn.lpc");

    addConversation("/areas/tol-dhurath/characters/vilias/startingConversation.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void revealName()
{
    short("Vilias");
}
