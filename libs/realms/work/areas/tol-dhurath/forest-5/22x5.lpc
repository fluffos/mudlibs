inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "west");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-5/22x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-5/21x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-5/22x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
