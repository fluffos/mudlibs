inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-5/11x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-5/13x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
