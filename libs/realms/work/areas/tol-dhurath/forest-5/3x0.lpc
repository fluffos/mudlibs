inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "east");
    addFeature("/lib/environment/features/landforms/tor.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-5/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-5/2x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-5/4x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
