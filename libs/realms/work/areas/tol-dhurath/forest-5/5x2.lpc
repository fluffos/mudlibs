inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northeast");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "northeast");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "northeast");

    addExit("west", "/areas/tol-dhurath/forest-5/4x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-5/5x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
