inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northwest");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "northwest");
    addFeature("/lib/environment/features/water/river.lpc", "northwest");

    addExit("north", "/areas/tol-dhurath/forest-5/8x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-5/8x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
