inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "south");
    addFeature("/lib/environment/features/water/brook.lpc", "south");

    addExit("south", "/areas/tol-dhurath/forest-5/20x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-5/19x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
