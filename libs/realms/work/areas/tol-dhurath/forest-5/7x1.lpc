inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "west");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-5/8x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-5/6x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"fisher","otter","porcupine","red squirrel","mink"}));
}
