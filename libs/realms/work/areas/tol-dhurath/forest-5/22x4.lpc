inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-5/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-5/23x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","coyote","keeper of the night","groundhog","red squirrel","mink","chipmunk"}));
}
