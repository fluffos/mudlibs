inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "east");
    addFeature("/lib/environment/features/water/creek.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-5/18x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-5/18x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"weasel","black bear","keeper of the night","knight of the storm","white-tail deer","badger"}));
}
