inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "north");
    addFeature("/lib/environment/features/landforms/butte.lpc", "north");

    addExit("east", "/areas/tol-dhurath/forest-5/1x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-5/0x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
