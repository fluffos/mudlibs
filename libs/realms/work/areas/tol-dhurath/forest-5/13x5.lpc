inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "southwest");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");
    addFeature("/lib/environment/features/trees/walnut-stand.lpc", "southwest");

    addExit("north", "/areas/tol-dhurath/forest-5/13x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-5/14x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
