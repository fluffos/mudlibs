inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "northwest");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "northwest");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/forest-5/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-5/21x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
