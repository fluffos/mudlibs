inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "northeast");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-5/20x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-5/19x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-5/21x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
