inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southwest");
    addFeature("/lib/environment/features/trees/buckthorn-stand.lpc", "southwest");

    addExit("south", "/areas/tol-dhurath/forest-5/13x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"black bear","otter","chipmunk"}));
}
