inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/mulberry-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "north");

    addExit("north", "/areas/tol-dhurath/forest-5/2x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-5/1x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
