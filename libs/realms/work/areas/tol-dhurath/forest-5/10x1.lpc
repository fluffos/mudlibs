inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/mound.lpc", "northwest");
    addFeature("/lib/environment/features/trees/walnut-stand.lpc", "northwest");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/forest-5/11x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-5/10x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
