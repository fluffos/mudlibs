inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "southwest");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "southwest");

    addExit("east", "/areas/tol-dhurath/forest-5/18x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-5/16x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
