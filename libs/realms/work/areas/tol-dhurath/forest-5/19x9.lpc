inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "north");
    addFeature("/lib/environment/features/landforms/glen.lpc", "north");

    addExit("west", "/areas/tol-dhurath/forest-5/18x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","outlaw","skunk","red squirrel"}));
}
