inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/butte.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-5/14x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-5/15x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-5/13x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
