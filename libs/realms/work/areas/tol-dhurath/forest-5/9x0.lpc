inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/willow-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("west", "/areas/tol-dhurath/forest-5/8x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-5/9x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-5/10x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
