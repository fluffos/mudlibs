inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "north");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "north");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "north");

    addExit("east", "/areas/tol-dhurath/forest-5/16x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"gopher","coyote","white-tail deer","boar","badger","chipmunk"}));
}
