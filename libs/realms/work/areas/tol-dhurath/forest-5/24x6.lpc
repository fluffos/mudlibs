inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pear-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "southwest");

    addExit("north", "/areas/tol-dhurath/forest-5/24x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-5/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"white-tail deer","mink","keeper of the night"}));
}
