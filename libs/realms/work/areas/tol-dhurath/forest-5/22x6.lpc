inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-5/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-5/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"hunter","ruffian","otter","porcupine"}));
}
