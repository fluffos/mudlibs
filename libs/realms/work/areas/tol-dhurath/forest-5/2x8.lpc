inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "northwest");
    addFeature("/lib/environment/features/trees/holly-stand.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");

    addExit("west", "/areas/tol-dhurath/forest-5/1x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-5/2x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
