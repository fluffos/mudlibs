inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/hill.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-5/12x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-5/13x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
