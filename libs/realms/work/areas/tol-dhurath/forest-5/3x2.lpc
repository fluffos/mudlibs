inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "north");
    addFeature("/lib/environment/features/landforms/tor.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("south", "/areas/tol-dhurath/forest-5/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-5/3x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"muskrat","coyote","white-tail deer","kit fox"}));
}
