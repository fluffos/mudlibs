inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northwest");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "northwest");
    addFeature("/lib/environment/features/trees/willow-stand.lpc", "northwest");

    addExit("north", "/areas/tol-dhurath/temple-exterior/3x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-5/3x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-5/2x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
