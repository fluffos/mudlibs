inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/McIntosh-apple-stand.lpc", "northwest");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "northwest");

    addExit("north", "/areas/tol-dhurath/forest-5/10x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-5/9x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
