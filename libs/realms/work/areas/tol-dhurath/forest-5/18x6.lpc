inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/bluff.lpc", "west");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-5/18x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-5/17x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-5/18x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
