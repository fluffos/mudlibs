inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "west");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-5/19x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-5/18x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
