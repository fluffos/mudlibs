inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "southwest");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");

    addExit("east", "/areas/tol-dhurath/forest-5/12x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","fisher","outlaw"}));
}
