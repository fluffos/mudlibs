inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "west");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/glen.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-5/24x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-5/24x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","gopher"}));
}
