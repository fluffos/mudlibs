inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "southwest");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "southwest");

    addExit("east", "/areas/tol-dhurath/forest-5/17x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-5/16x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"coyote","outlaw","red squirrel","badger","chipmunk"}));
}
