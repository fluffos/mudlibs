inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "northeast");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "northeast");

    addExit("west", "/areas/tol-dhurath/forest-5/1x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-5/2x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
