inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "east");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "east");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-5/2x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-5/1x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
