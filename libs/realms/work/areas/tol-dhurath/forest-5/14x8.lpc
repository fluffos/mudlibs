inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/ironwood-stand.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-5/14x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-5/14x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","warg","otter","timber wolf","gray squirrel"}));
}
