inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/yew-stand.lpc", "southwest");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "southwest");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "southwest");

    addExit("east", "/areas/tol-dhurath/forest-5/18x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-5/17x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
