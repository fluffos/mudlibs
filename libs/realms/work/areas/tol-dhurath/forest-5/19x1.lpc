inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "south");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "south");

    addExit("north", "/areas/tol-dhurath/forest-5/19x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-5/18x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
