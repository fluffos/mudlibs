inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-waterfall.lpc", "east");
    addFeature("/lib/environment/features/water/river.lpc", "east");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-5/1x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-5/2x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","zombie","otter","mink"}));
}
