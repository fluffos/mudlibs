inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/hill.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southwest");

    addExit("west", "/areas/tol-dhurath/forest-5/23x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-5/24x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
