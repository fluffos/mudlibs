inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "east");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-5/3x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-5/3x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
