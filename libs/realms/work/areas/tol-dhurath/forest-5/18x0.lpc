inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("north", "/areas/tol-dhurath/forest-5/18x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-5/17x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
