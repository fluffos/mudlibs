inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "west");
    addFeature("/lib/environment/features/landforms/glen.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-5/15x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-5/15x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-5/14x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
