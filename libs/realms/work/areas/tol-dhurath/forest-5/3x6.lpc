inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-waterfall.lpc", "south");
    addFeature("/lib/environment/features/water/brook.lpc", "south");

    addExit("south", "/areas/tol-dhurath/forest-5/3x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-5/3x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-5/4x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
