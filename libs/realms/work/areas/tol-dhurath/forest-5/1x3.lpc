inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "east");
    addFeature("/lib/environment/features/trees/fir-stand.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-5/2x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-5/1x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
