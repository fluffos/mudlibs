inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/valley.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-5/15x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-5/14x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"gopher","fisher","mink","timber wolf","kit fox","chipmunk"}));
}
