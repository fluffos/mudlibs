inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "northwest");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/forest-5/2x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-5/0x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
