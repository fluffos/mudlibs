inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "west");
    addFeature("/lib/environment/features/trees/golden-apple-stand.lpc", "west");
    addFeature("/lib/environment/features/water/creek.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-5/13x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-5/11x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
