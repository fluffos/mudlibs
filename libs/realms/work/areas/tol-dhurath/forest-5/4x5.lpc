inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "northeast");

    addExit("west", "/areas/tol-dhurath/forest-5/3x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"skunk","porcupine","coyote","outlaw","white-tail deer","opossum"}));
}
