inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "south");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-5/24x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-5/22x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"hunter","coyote","mink","badger","timber wolf"}));
}
