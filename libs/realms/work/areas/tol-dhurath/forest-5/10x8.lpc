inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/hill.lpc", "southeast");

    addExit("west", "/areas/tol-dhurath/forest-5/9x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-5/10x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"gopher","muskrat","coyote","otter","gray squirrel"}));
}
