inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/tor.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-5/9x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"coyote","timber wolf","boar","mink"}));
}
