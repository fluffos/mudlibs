inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/honeycrisp-apple-stand.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-5/3x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"moose","ruffian","outlaw"}));
}
