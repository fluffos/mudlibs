inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/alder-stand.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/tor.lpc", "southeast");
    addFeature("/lib/environment/features/trees/willow-stand.lpc", "southeast");

    addExit("north", "/areas/tol-dhurath/forest-5/13x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-5/14x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
