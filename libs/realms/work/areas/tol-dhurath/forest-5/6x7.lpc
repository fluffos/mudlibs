inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "west");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "west");
    addFeature("/lib/environment/features/trees/honeycrisp-apple-stand.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-5/7x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-5/5x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
