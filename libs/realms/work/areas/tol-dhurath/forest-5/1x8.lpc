inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/precipice.lpc", "northeast");

    addExit("north", "/areas/tol-dhurath/forest-5/1x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-5/2x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
