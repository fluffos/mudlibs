inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/stream.lpc", "south");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "south");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "south");

    addExit("south", "/areas/tol-dhurath/forest-5/3x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-5/3x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
