inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "southeast");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "east");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "north");

    addExit("west", "/areas/tol-dhurath/entry/7x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/entry/9x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
