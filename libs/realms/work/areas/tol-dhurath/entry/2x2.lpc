inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/apple-stand.lpc", "south");

    addExit("north", "/areas/tol-dhurath/entry/2x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"hunter","ruffian","gray fox","outlaw","white-tail deer"}));
}
