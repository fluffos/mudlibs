inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/crag.lpc", "west");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "east");

    addExit("south", "/areas/tol-dhurath/entry/12x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"outlaw","red fox","white-tail deer"}));
}
