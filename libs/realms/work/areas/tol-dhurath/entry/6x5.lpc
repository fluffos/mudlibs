inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "south");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("west", "/areas/tol-dhurath/entry/5x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/entry/6x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
