inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/black-cherry-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/tor.lpc", "west");

    addExit("south", "/areas/tol-dhurath/entry/7x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/entry/8x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
