inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "south");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "southeast");

    addExit("north", "/areas/tol-dhurath/entry/18x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/entry/19x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
