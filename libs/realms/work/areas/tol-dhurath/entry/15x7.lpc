inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/holly-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/entry/15x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/15x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
