inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/alp.lpc", "south");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "east");

    addExit("west", "/areas/tol-dhurath/entry/19x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/entry/21x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
