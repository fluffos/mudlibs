inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/pond.lpc", "east");
    addFeature("/lib/environment/features/trees/honeycrisp-apple-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "south");

    addExit("west", "/areas/tol-dhurath/entry/23x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/entry/24x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
