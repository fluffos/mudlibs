inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-brook.lpc", "east");
    addFeature("/lib/environment/features/landforms/bluff.lpc", "west");

    addExit("east", "/areas/tol-dhurath/entry/1x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","hunter","badger","otter"}));
}
