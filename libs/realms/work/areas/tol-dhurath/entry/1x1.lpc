inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "west");
    addFeature("/lib/environment/features/landforms/butte.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/entry/2x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/entry/1x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
