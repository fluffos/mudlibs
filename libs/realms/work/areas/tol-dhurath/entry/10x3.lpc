inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "west");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "east");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "south");

    addExit("south", "/areas/tol-dhurath/entry/10x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/10x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/entry/11x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
