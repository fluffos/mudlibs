inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "west");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/entry/1x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/entry/0x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
