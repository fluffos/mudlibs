inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/lake-shore-bluff.lpc", "west");
    addFeature("/lib/environment/features/trees/willow-stand.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/entry/5x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/entry/4x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
