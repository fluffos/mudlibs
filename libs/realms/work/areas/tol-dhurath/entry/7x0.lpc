inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "west");
    addFeature("/lib/environment/features/trees/chokecherry-stand.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("east", "/areas/tol-dhurath/entry/8x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","outlaw","gray fox"}));
}
