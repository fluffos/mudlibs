inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "northeast");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/entry/16x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/entry/15x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/entry/16x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
