inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "south");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");

    addExit("east", "/areas/tol-dhurath/entry/15x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/entry/14x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
