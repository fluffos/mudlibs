inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "south");

    addExit("east", "/areas/tol-dhurath/entry/6x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","hunter","white-tail deer"}));
}
