inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "west");
    addFeature("/lib/environment/features/trees/fir-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/cedar-stand.lpc", "southeast");

    addExit("east", "/areas/tol-dhurath/entry/9x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/entry/8x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/entry/7x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
