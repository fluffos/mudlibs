inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "east");

    addExit("east", "/areas/tol-dhurath/entry/4x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"hunter","red fox","white-tail deer"}));
}
