inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ambrosia-apple-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/entry/4x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/4x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/entry/3x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
