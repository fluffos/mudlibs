inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "south");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/hill.lpc", "west");

    addExit("west", "/areas/tol-dhurath/entry/1x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","red fox","white-tail deer"}));
}
