inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/fir-stand.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "south");

    addExit("west", "/areas/tol-dhurath/entry/0x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/entry/1x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"hunter","outlaw","white-tail deer"}));
}
