inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-waterfall.lpc", "east");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "south");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("north", "/areas/tol-dhurath/entry/7x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/entry/8x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
