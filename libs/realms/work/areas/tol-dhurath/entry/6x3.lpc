inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/alder-stand.lpc", "south");

    addExit("south", "/areas/tol-dhurath/entry/6x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/entry/7x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/entry/6x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
