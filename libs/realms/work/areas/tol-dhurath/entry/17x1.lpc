inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/crag.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/entry/17x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/entry/16x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/entry/18x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
