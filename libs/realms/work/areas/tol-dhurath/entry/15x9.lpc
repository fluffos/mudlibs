inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "east");
    addFeature("/lib/environment/features/water/ravine-waterfall.lpc", "west");

    addExit("south", "/areas/tol-dhurath/entry/15x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/entry/14x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
