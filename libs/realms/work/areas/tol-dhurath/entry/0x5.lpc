inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/crag.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/entry/0x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/entry/1x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/entry/0x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
