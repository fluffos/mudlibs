inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "northwest");
    addFeature("/lib/environment/features/trees/lilac-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/entry/8x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/8x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
