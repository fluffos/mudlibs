inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "north");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");

    addExit("east", "/areas/tol-dhurath/entry/17x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/entry/16x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
