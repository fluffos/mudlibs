inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "south");

    addExit("east", "/areas/tol-dhurath/entry/24x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"gray fox","ruffian","white-tail deer"}));
}
