inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "northwest");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "southwest");
    addFeature("/lib/environment/features/trees/walnut-stand.lpc", "east");

    addExit("west", "/areas/tol-dhurath/entry/2x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/entry/4x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
