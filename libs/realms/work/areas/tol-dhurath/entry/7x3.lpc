inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southeast");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "west");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "north");

    addExit("south", "/areas/tol-dhurath/entry/7x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/7x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/entry/6x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
