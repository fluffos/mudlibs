inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/tor.lpc", "west");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "north");

    addExit("south", "/areas/tol-dhurath/entry/1x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/entry/2x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
