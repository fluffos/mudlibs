inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/golden-apple-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/valley.lpc", "south");

    addExit("west", "/areas/tol-dhurath/entry/18x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/entry/20x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
