inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/walnut-stand.lpc", "west");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "east");

    addExit("south", "/areas/tol-dhurath/entry/23x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"white-tail deer","outlaw"}));
}
