inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/entry/1x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/1x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
