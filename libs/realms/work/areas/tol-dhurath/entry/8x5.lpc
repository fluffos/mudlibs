inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "north");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "southwest");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "east");

    addExit("east", "/areas/tol-dhurath/entry/9x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/entry/8x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"outlaw","coyote","gray fox"}));
}
