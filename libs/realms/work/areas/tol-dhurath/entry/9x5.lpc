inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "north");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "south");
    addFeature("/lib/environment/features/water/pond.lpc", "east");

    addExit("south", "/areas/tol-dhurath/entry/9x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/entry/8x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
