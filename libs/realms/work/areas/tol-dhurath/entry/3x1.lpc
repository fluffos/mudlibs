inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "north");
    addFeature("/lib/environment/features/trees/cedar-stand.lpc", "east");

    addExit("east", "/areas/tol-dhurath/entry/4x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/entry/2x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
