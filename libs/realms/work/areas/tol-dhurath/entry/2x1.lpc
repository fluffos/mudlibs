inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/montmorency-cherry-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/entry/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/entry/1x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
