inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/precipice.lpc", "southeast");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/entry/13x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/entry/12x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
