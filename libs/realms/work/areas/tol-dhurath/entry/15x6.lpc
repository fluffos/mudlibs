inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "west");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/entry/15x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/15x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
