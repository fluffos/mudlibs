inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/waterfall.lpc", "north");
    addFeature("/lib/environment/features/trees/bing-cherry-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "east");

    addExit("south", "/areas/tol-dhurath/entry/0x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/0x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
