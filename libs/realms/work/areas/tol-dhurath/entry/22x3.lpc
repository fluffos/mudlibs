inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/precipice.lpc", "west");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "north");

    addExit("west", "/areas/tol-dhurath/entry/21x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/entry/22x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/entry/23x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
