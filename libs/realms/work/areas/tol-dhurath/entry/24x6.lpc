inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "south");
    addFeature("/lib/environment/features/landforms/mound.lpc", "west");

    addExit("north", "/areas/tol-dhurath/entry/24x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/entry/24x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
