inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "west");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "east");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "south");

    addExit("south", "/areas/tol-dhurath/entry/13x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/entry/14x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/entry/13x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
