inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/combe.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "north");

    addExit("south", "/areas/tol-dhurath/entry/15x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/15x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
