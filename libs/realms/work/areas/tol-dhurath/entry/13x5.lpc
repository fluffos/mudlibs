inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/lake-shore-bluff.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("north", "/areas/tol-dhurath/entry/13x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"white-tail deer","outlaw","red fox"}));
}
