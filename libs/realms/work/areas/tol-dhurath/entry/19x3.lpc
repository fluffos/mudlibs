inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "southeast");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/butte.lpc", "north");

    addExit("south", "/areas/tol-dhurath/entry/19x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/entry/18x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","outlaw","red fox","coyote"}));
}
