inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/vale.lpc", "west");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "north");

    addExit("south", "/areas/tol-dhurath/entry/2x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/2x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/entry/3x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
