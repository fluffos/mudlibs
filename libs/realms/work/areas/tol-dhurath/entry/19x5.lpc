inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");

    addExit("east", "/areas/tol-dhurath/entry/20x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/entry/18x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
