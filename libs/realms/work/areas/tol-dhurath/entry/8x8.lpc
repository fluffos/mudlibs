inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "south");

    addExit("south", "/areas/tol-dhurath/entry/8x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/entry/9x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
