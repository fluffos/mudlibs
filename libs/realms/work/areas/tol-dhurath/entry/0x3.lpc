inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southwest");
    addFeature("/lib/environment/features/water/canyon-brook.lpc", "east");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "north");

    addExit("south", "/areas/tol-dhurath/entry/0x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/entry/0x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
