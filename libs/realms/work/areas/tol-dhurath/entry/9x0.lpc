inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/mountain.lpc", "south");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "southwest");

    addExit("west", "/areas/tol-dhurath/entry/8x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/entry/10x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
