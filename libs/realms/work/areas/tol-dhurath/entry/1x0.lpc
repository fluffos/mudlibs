inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "southwest");
    addFeature("/lib/environment/features/trees/buckeye-stand.lpc", "northeast");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "south");

    addExit("north", "/areas/tol-dhurath/entry/1x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/entry/0x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
