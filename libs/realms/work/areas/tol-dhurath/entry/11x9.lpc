inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/entry/11x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/entry/10x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
