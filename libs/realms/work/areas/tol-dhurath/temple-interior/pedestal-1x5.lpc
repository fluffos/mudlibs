inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setInterior("/areas/tol-dhurath/interiors/pedestal-chamber.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-floor.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-ceiling.lpc");
    addFeature("/areas/tol-dhurath/features/purple-liquid.lpc");

    addDecorator("ruined interior amethyst floor", "default");

    // First test
    addExit("east", "/areas/tol-dhurath/temple-interior/pedestal-square.lpc", "first test");
    addExit("south", "/areas/tol-dhurath/temple-interior/pedestal-2x5.lpc", "first test");
    addDecorator("ruined interior amethyst floor east south", "first test");

    // Fourth test
    addExit("west", "/areas/tol-dhurath/temple-interior/pedestal-1x4.lpc", "fourth test");
    addExit("south", "/areas/tol-dhurath/temple-interior/pedestal-2x5.lpc", "fourth test");
    addDecorator("ruined interior amethyst floor west south", "fourth test");

    // Poem complete (final passage)
    addExit("west", "/areas/tol-dhurath/temple-interior/pedestal-1x4.lpc", "poem complete");
    addExit("south", "/areas/tol-dhurath/temple-interior/pedestal-2x5.lpc", "poem complete");
    addDecorator("ruined interior amethyst floor west south", "poem complete");

    setStateMachine("/areas/tol-dhurath/state-machine/obedience-quest.lpc");
}
