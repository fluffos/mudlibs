inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin-room.lpc");
    addFeature("/lib/environment/features/floors/ruined-marble-floor.lpc");
    addItem("/lib/environment/items/lighting/sconce.lpc", "south");
    addDecorator("ruined interior 4-way hallway");

    addExit("east",
        "/areas/tol-dhurath/temple-interior/4x1.lpc");
    addExit("west",
        "/areas/tol-dhurath/temple-interior/2x1.lpc");
    addExitWithDoor("north",
        "/areas/tol-dhurath/temple-interior/3x2.lpc");
    addExit("south",
        "/areas/tol-dhurath/temple-interior/3x0.lpc");
}
