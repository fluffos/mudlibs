inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin-hallway.lpc");
    addFeature("/lib/environment/features/floors/ruined-marble-floor.lpc");
    addItem("/lib/environment/items/lighting/sconce.lpc", "west");
    addDecorator("ruined interior east-west hallway north entry");

    addExit("west",
        "/areas/tol-dhurath/temple-interior/11x3.lpc");
    addExit("east",
        "/areas/tol-dhurath/temple-interior/13x3.lpc");
    addExitWithDoor("north",
        "/areas/tol-dhurath/temple-interior/pedestal-5x0.lpc");
}
