inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setInterior("/areas/tol-dhurath/interiors/pedestal-chamber.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-floor.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-ceiling.lpc");
    addFeature("/areas/tol-dhurath/features/purple-liquid.lpc");

    addDecorator("ruined interior amethyst floor", "default");

    // Second test
    addExit("north", "/areas/tol-dhurath/temple-interior/pedestal-2x2.lpc", "second test");
    addExit("east", "/areas/tol-dhurath/temple-interior/pedestal-3x3.lpc", "second test");
    addDecorator("ruined interior amethyst floor east north", "second test");

    // Third test
    addExit("north", "/areas/tol-dhurath/temple-interior/pedestal-2x2.lpc", "third test");
    addExit("east", "/areas/tol-dhurath/temple-interior/pedestal-3x3.lpc", "third test");
    addDecorator("ruined interior amethyst floor east north", "third test");

    // Fifth test
    addExit("north", "/areas/tol-dhurath/temple-interior/pedestal-2x2.lpc", "fifth test");
    addExit("east", "/areas/tol-dhurath/temple-interior/pedestal-3x3.lpc", "fifth test");
    addDecorator("ruined interior amethyst floor east north", "fifth test");

    // Poem complete (final passage)
    addExit("south", "/areas/tol-dhurath/temple-interior/pedestal-4x2.lpc", "poem complete");
    addExit("east", "/areas/tol-dhurath/temple-interior/pedestal-3x3.lpc", "poem complete");
    addDecorator("ruined interior amethyst floor east south", "poem complete");

    setStateMachine("/areas/tol-dhurath/state-machine/obedience-quest.lpc");
}
