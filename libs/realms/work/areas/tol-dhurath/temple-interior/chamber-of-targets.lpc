inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setInterior("/areas/tol-dhurath/interiors/pedestal-chamber.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-floor.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-ceiling.lpc");
    addFeature("/areas/tol-dhurath/features/purple-liquid.lpc");

    addDecorator("ruined interior north-south hallway");
    addDecorator("ruined interior west entry alcove", "sixth test");

    // Sixth test
    addExit("west", "/areas/tol-dhurath/temple-interior/pedestal-5x5.lpc", "sixth test");
    addExit("east", "/areas/tol-dhurath/temple-interior/pedestal-1x1.lpc", "seventh test");

    addObject("/areas/tol-dhurath/objects/gauntlet.lpc");

    setStateMachine("/areas/tol-dhurath/state-machine/obedience-quest.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private object gauntlet()
{
    return present("gauntlet-hidden", this_object());
}

/////////////////////////////////////////////////////////////////////////////
public int moveToIsAllowed(object user, object toLocation)
{
    int ret = 1;

    if (gauntlet())
    {
        ret = gauntlet()->allowMove();
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
public string suppressDeath()
{
    return "The chamber's ancient magic sustains you at the brink of "
        "death. You must endure.\n";
}
