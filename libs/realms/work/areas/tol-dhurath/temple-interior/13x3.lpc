inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin.lpc");
    addDecorator("ruined interior east-west hallway");

    addExit("west",
        "/areas/tol-dhurath/temple-interior/12x3.lpc");
    addExit("east",
        "/areas/tol-dhurath/temple-interior/14x3.lpc");
}
