inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setInterior("/areas/tol-dhurath/interiors/pedestal-chamber.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-floor.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-ceiling.lpc");
    addFeature("/areas/tol-dhurath/features/purple-liquid.lpc");

    addDecorator("ruined interior amethyst floor", "default");

    // First test
    addExit("east", "/areas/tol-dhurath/temple-interior/pedestal-2x4.lpc", "first test");
    addExit("west", "/areas/tol-dhurath/temple-interior/pedestal-2x2.lpc", "first test");
    addDecorator("ruined interior amethyst floor west east", "first test");

    // Third test
    addExit("north", "/areas/tol-dhurath/temple-interior/pedestal-1x3.lpc", "third test");
    addExit("south", "/areas/tol-dhurath/temple-interior/pedestal-3x3.lpc", "third test");
    addDecorator("ruined interior amethyst floor north south", "third test");

    // Sixth test
    addExit("north", "/areas/tol-dhurath/temple-interior/pedestal-1x3.lpc", "sixth test");
    addExit("south", "/areas/tol-dhurath/temple-interior/pedestal-3x3.lpc", "sixth test");
    addDecorator("ruined interior amethyst floor north south", "sixth test");

    setStateMachine("/areas/tol-dhurath/state-machine/obedience-quest.lpc");
}
