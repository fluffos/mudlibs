inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin.lpc");
    addDecorator("ruined interior-to-exterior north-corner hallway west exit");

    addExit("west", "/areas/tol-dhurath/temple-interior/10x9.lpc");
    addExit("south", "/areas/tol-dhurath/temple-interior/11x8.lpc");
}
