inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setTerrain("/lib/environment/terrain/ruin-exterior.lpc");
    addDecorator("ruined interior courtyard with pillar");
    addExit("east", "/areas/tol-dhurath/temple-interior/7x4.lpc");
    addExit("west", "/areas/tol-dhurath/temple-interior/5x4.lpc");
    addExit("north", "/areas/tol-dhurath/temple-interior/6x5.lpc");
    addExit("south", "/areas/tol-dhurath/temple-interior/6x3.lpc");
}
