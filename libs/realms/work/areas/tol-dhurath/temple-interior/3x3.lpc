inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin-hallway.lpc");
    addFeature("/lib/environment/features/floors/ruined-marble-floor.lpc");
    addItem("/lib/environment/items/lighting/sconce.lpc", "east");
    addDecorator("ruined interior west T-intersection");

    addExit("west",
        "/areas/tol-dhurath/temple-interior/2x3.lpc");
    addExit("north",
        "/areas/tol-dhurath/temple-interior/3x4.lpc");
    addExit("south",
        "/areas/tol-dhurath/temple-interior/3x2.lpc");
}
