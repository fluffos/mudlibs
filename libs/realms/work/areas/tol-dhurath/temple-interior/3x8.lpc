inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin.lpc");
    addDecorator("ruined interior-to-exterior north-south hallway west exit");

    addExit("east", "/areas/tol-dhurath/temple-interior/4x8.lpc");
    addExit("north", "/areas/tol-dhurath/temple-interior/3x9.lpc");
    addExit("south", "/areas/tol-dhurath/temple-interior/3x7.lpc");
}
