inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin-great-hall.lpc");
    addFeature("/lib/environment/features/floors/ruined-marble-floor.lpc");
    addItem("/lib/environment/items/lighting/skylight.lpc");
    addItem("/lib/environment/items/columns/ruined-pillar.lpc", "west");

    addDecorator("ruined interior floor");

    addExit("east",
        "/areas/tol-dhurath/temple-interior/11x1.lpc");
    addExit("west",
        "/areas/tol-dhurath/temple-interior/8x1.lpc");
    addExit("north",
        "/areas/tol-dhurath/temple-interior/9x2.lpc");
    addExit("south",
        "/areas/tol-dhurath/temple-interior/9x0.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public string **customIcon(string **baseIcon, string color, string charset)
{
    mapping colors = ([
        "pillar":([
            "none": "",
            "grayscale": "\x1b[0;38;5;243;1m",
            "3-bit": "\x1b[0;36;1m",
            "8-bit": "\x1b[0;38;5;243;1m",
            "24-bit": "\x1b[0;38;2;118;118;128;1m",
        ]),
    ]);

    baseIcon[1][0] = sprintf("%s%s%s", colors["pillar"][color],
        (charset == "unicode") ? "\u25ce" : "*",
        (colors["pillar"][color] != "") ? "\x1b[0m" : "");

    return baseIcon;
}
