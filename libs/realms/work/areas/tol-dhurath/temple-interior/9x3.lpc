inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setTerrain("/lib/environment/terrain/ruin-exterior.lpc");

    addExit("west",
        "/areas/tol-dhurath/temple-interior/8x3.lpc");
    addExitWithDoor("south", 
        "/areas/tol-dhurath/temple-interior/9x2.lpc");
    addExit("north", "/areas/tol-dhurath/temple-interior/9x4.lpc");

    addDecorator("ruined interior large staired entrance left");
}
