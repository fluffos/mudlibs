inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin.lpc");
    addDecorator("ruined interior north entry alcove");

    addExitWithDoor("north", "/areas/tol-dhurath/temple-interior/11x5.lpc");
    addExit("south", "/areas/tol-dhurath/temple-interior/11x3.lpc");
}
