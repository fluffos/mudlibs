inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin-hallway.lpc");
    addFeature("/lib/environment/features/floors/ruined-marble-floor.lpc");
    addItem("/lib/environment/items/lighting/sconce.lpc", "north");
    addDecorator("ruined interior east-west hallway south entry");

    addExit("west",
        "/areas/tol-dhurath/temple-interior/0x3.lpc");
    addExit("east",
        "/areas/tol-dhurath/temple-interior/2x3.lpc");
    addExitWithDoor("south",
        "/areas/tol-dhurath/temple-interior/1x2.lpc");
}
