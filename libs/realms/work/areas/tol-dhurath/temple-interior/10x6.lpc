inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setTerrain("/lib/environment/terrain/ruin-exterior.lpc");
    addDecorator("ruined interior courtyard");

    addExit("east", "/areas/tol-dhurath/temple-interior/11x6.lpc");
    addExit("west", "/areas/tol-dhurath/temple-interior/9x6.lpc");
    addExit("north", "/areas/tol-dhurath/temple-interior/10x7.lpc");
    addExit("south", "/areas/tol-dhurath/temple-interior/10x5.lpc");
}
