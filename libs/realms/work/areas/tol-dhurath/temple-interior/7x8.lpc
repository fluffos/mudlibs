inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setTerrain("/lib/environment/terrain/ruin-exterior.lpc");
    addDecorator("ruined interior courtyard with path");

    addExit("west", "/areas/tol-dhurath/temple-interior/6x8.lpc");
    addExit("east", "/areas/tol-dhurath/temple-interior/8x8.lpc");
    addExit("north", "/areas/tol-dhurath/temple-interior/7x9.lpc");
    addExit("south", "/areas/tol-dhurath/temple-interior/7x7.lpc");
}
