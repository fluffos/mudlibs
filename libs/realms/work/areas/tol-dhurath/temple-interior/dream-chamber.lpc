inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setInterior("/areas/tol-dhurath/interiors/pedestal-chamber.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-floor.lpc");
    addFeature("/areas/tol-dhurath/features/amethyst-ceiling.lpc");
    addFeature("/areas/tol-dhurath/features/purple-liquid.lpc");

    addDecorator("ruined interior north-south hallway");
    addDecorator("ruined interior west entry alcove", "fifth test");

    // Fifth test
    addExit("west", "/areas/tol-dhurath/temple-interior/pedestal-3x5.lpc", "fifth test");
    addExit("east", "/areas/tol-dhurath/temple-interior/pedestal-1x1.lpc", "sixth test");

    addObject("/areas/tol-dhurath/objects/dream-pool.lpc", "fifth test");

    setStateMachine("/areas/tol-dhurath/state-machine/obedience-quest.lpc");
}

/////////////////////////////////////////////////////////////////////////////
private object puzzleObject()
{
    return present("dream-hidden", this_object());
}

/////////////////////////////////////////////////////////////////////////////
public int moveToIsAllowed(object user, object toLocation)
{
    int ret = 1;

    if (puzzleObject())
    {
        ret = puzzleObject()->allowMove();
    }
    return ret;
}

/////////////////////////////////////////////////////////////////////////////
public string suppressDeath()
{
    return "Dark energy sustains you. You cannot die here, but "
        "the pain is very real.\n";
}
