inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setInterior("/lib/environment/interiors/ruin-gatehouse.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "east");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "west");

    addExitWithDoor("north",
        "/areas/tol-dhurath/temple-interior/7x4.lpc",
        "/lib/environment/doors/portcullis.lpc");
    addExitWithDoor("south", 
        "/areas/tol-dhurath/temple-exterior/6x7.lpc",
        "/lib/environment/doors/keep-gate.lpc");

    addDecorator("ruined interior south gatehouse");
}
