inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setStateMachine("/areas/tol-dhurath/state-machine/tol-dhurath-quest.lpc");

    setTerrain("/lib/environment/terrain/ruin-exterior.lpc");
    addDecorator("ruined interior courtyard with path");

    addExit("west", "/areas/tol-dhurath/temple-interior/6x4.lpc");
    addExit("east", "/areas/tol-dhurath/temple-interior/8x4.lpc");
    addExit("north", "/areas/tol-dhurath/temple-interior/7x5.lpc");

    addExitWithDoor("south",
        "/areas/tol-dhurath/temple-interior/7x3.lpc");

    addObject("/areas/tol-dhurath/characters/seilyndria/seilyndria.lpc");
    addObject("/areas/tol-dhurath/characters/galadhel/galadhel.lpc");
    addObject("/areas/tol-dhurath/characters/halgaladh/halgaladh.lpc");
}
