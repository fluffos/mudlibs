inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-3/20x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","hunter","black bear","white-tail deer","timber wolf"}));
}
