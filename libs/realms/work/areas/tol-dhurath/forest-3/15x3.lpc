inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/willow-stand.lpc", "northwest");

    addExit("west", "/areas/tol-dhurath/forest-3/14x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","mule deer","timber wolf","moose","mountain lion","kit fox"}));
}
