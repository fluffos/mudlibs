inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "northwest");

    addExit("west", "/areas/tol-dhurath/forest-3/3x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-3/4x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","coyote","black bear"}));
}
