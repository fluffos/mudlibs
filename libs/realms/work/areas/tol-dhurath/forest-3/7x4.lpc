inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("north", "/areas/tol-dhurath/forest-3/7x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-3/7x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
