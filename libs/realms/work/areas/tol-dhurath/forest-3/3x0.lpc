inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/red-oak-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/dell.lpc", "south");
    addFeature("/lib/environment/features/landforms/combe.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-3/4x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-3/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-3/2x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-4/3x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
