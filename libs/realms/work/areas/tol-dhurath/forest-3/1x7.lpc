inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-3/1x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-3/1x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
