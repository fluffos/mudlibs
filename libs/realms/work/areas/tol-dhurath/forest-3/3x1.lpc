inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "west");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-3/3x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","outlaw","coyote","white-tail deer","kit fox"}));
}
