inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");

    addExit("north", "/areas/tol-dhurath/forest-3/10x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-3/9x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
