inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "north");
    addFeature("/lib/environment/features/trees/apple-stand.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/forest-3/12x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-3/13x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
