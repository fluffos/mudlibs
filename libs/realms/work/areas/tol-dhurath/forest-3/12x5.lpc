inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/yew-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/combe.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/mound.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-3/13x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-3/12x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
