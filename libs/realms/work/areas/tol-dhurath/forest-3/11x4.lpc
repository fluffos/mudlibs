inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/rocky-lake-shore.lpc", "north");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-3/12x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-3/10x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"gray fox","ruffian","hunter","coyote"}));
}
