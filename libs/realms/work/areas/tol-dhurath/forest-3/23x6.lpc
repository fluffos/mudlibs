inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "south");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-3/23x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-3/22x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-3/23x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"outlaw","ruffian","boar"}));
}
