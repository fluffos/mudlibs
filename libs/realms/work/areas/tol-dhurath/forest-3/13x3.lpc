inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-3/13x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-3/14x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-3/13x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
