inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-3/12x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-3/13x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"hunter","coyote","ruffian","red fox"}));
}
