inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "northeast");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-3/24x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-3/24x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-2/0x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
