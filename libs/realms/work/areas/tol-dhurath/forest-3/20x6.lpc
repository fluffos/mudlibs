inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/glen.lpc", "east");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-3/20x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-3/21x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-3/20x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
