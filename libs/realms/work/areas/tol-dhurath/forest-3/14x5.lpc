inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southeast");
    addFeature("/lib/environment/features/water/rocky-lake-shore.lpc", "west");
    addFeature("/lib/environment/features/landforms/valley.lpc", "north");

    addExit("west", "/areas/tol-dhurath/forest-3/13x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"boar","ruffian"}));
}
