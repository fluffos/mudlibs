inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/combe.lpc", "south");
    addFeature("/lib/environment/features/landforms/tor.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-3/12x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-3/12x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-3/11x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
