inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "northwest");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("north", "/areas/tol-dhurath/forest-3/5x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-3/6x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
