inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/fir-stand.lpc", "south");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("south", "/areas/tol-dhurath/forest-3/9x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-3/10x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
