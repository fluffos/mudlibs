inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "north");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-3/6x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-3/8x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
