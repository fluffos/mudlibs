inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/dell.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-3/11x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-3/9x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-3/10x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
