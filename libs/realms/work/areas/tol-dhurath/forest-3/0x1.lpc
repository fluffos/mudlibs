inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "north");
    addFeature("/lib/environment/features/landforms/hill.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-3/0x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-3/1x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
