inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hill.lpc", "south");

    addExit("south", "/areas/tol-dhurath/forest-3/17x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-3/18x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
