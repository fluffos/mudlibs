inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-3/12x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-3/10x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
