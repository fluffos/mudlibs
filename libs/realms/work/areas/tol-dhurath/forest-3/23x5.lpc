inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "east");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "northwest");

    addExit("north", "/areas/tol-dhurath/forest-3/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-3/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
