inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/sandy-lake-beach.lpc", "south");
    addFeature("/lib/environment/features/landforms/valley.lpc", "northeast");

    addExit("east", "/areas/tol-dhurath/forest-3/14x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-3/12x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
