inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/golden-apple-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "west");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "east");

    addExit("west", "/areas/tol-dhurath/forest-3/20x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-3/21x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
