inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-3/1x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-3/2x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
