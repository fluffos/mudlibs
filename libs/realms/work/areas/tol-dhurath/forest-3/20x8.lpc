inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "north");
    addFeature("/lib/environment/features/water/canyon-brook.lpc", "southwest");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-3/20x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-3/19x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"black bear","hunter","outlaw","white-tail deer"}));
}
