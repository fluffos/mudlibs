inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "northeast");
    addFeature("/lib/environment/features/trees/rosewood-stand.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/glen.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-3/20x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-3/20x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
