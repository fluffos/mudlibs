inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/pond.lpc", "north");
    addFeature("/lib/environment/features/trees/crabapple-stand.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-3/19x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"outlaw","red fox","boar"}));
}
