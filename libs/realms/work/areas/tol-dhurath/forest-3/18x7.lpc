inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/mound.lpc", "east");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "south");

    addExit("south", "/areas/tol-dhurath/forest-3/18x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"hunter","mule deer","coyote"}));
}
