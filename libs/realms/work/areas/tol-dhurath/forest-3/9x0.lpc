inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "south");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "north");

    addExit("east", "/areas/tol-dhurath/forest-3/10x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","red fox","outlaw"}));
}
