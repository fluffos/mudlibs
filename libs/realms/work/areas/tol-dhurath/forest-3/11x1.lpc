inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "southeast");

    addExit("east", "/areas/tol-dhurath/forest-3/12x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"hunter","ruffian","coyote","mule deer","outlaw","moose"}));
}
