inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/cedar-stand.lpc", "north");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-3/3x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","white-tail deer","kit fox","wolverine"}));
}
