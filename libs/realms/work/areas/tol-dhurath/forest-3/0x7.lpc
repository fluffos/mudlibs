inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "southwest");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/apple-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-3/0x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","outlaw","coyote","opossum"}));
}
