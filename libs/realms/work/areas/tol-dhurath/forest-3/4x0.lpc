inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "southeast");

    addExit("west", "/areas/tol-dhurath/forest-3/3x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-3/4x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
