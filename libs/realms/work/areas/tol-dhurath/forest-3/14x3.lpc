inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northeast");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-3/14x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-3/13x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-3/15x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
