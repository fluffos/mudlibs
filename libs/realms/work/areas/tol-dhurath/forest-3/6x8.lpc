inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "south");
    addFeature("/lib/environment/features/landforms/butte.lpc", "north");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "northeast");

    addExit("west", "/areas/tol-dhurath/forest-3/5x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-3/7x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
