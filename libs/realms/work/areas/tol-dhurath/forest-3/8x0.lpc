inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/creek.lpc", "east");

    addExit("west", "/areas/tol-dhurath/forest-3/7x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-3/8x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
