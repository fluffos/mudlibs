inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "north");

    addExit("west", "/areas/tol-dhurath/forest-3/6x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-3/8x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
