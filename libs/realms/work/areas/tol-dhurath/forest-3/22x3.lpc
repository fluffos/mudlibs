inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-3/23x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-3/21x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-3/22x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
