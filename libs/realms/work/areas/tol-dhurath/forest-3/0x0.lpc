inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/willow-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-3/0x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","coyote","mule deer","gray wolf"}));
}
