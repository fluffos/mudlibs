inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "east");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "northeast");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");

    addExit("west", "/areas/tol-dhurath/forest-3/5x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-3/6x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","hunter","coyote","white-tail deer","kit fox"}));
}
