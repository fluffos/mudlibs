inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "west");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southwest");

    addExit("west", "/areas/tol-dhurath/forest-3/10x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","outlaw","boar","brown bear"}));
}
