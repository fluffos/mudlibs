inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-river.lpc", "north");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "west");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/forest-3/14x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-3/13x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
