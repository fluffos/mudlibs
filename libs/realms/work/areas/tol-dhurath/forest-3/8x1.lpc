inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-brook.lpc", "south");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "north");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/forest-3/8x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-3/9x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","outlaw","coyote"}));
}
