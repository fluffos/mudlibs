inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "east");
    addFeature("/lib/environment/features/landforms/hill.lpc", "west");

    addExit("south", "/areas/tol-dhurath/temple-exterior/24x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/temple-exterior/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
