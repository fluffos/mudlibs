inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/kingwood-stand.lpc", "east");
    addFeature("/lib/environment/features/water/creek.lpc", "west");

    addExit("west", "/areas/tol-dhurath/temple-exterior/17x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/temple-exterior/18x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
