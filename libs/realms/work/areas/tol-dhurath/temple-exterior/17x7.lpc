inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/stream.lpc", "east");
    addFeature("/lib/environment/features/landforms/bluff.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/temple-exterior/17x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/temple-exterior/18x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"mule deer","ruffian","boar","white-tail deer"}));
}
