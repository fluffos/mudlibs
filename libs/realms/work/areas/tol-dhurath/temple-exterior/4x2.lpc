inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "northwest");
    addFeature("/lib/environment/features/water/brook.lpc", "south");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/temple-exterior/4x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/temple-exterior/4x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
