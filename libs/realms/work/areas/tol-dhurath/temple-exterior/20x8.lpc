inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/green-apple-stand.lpc", "south");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "north");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "west");

    addExit("west", "/areas/tol-dhurath/temple-exterior/19x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"gray fox","ruffian","red fox","outlaw","timber wolf"}));
}
