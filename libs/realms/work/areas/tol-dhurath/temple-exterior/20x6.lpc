inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "northwest");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "east");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "north");

    addExit("east", "/areas/tol-dhurath/temple-exterior/21x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/temple-exterior/19x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
