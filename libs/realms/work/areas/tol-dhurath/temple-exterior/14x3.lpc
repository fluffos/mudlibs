inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "south");

    addExit("south", "/areas/tol-dhurath/temple-exterior/14x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","black bear","hunter","coyote"}));
}
