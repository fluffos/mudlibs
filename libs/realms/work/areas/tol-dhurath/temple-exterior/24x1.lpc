inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "south");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "east");
    addFeature("/lib/environment/features/water/stream.lpc", "north");

    addExit("south", "/areas/tol-dhurath/temple-exterior/24x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/temple-exterior/24x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
