inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "north");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/glen.lpc", "east");

    addExit("south", "/areas/tol-dhurath/temple-exterior/24x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/temple-exterior/24x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
