inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "west");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/temple-exterior/12x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/temple-exterior/13x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
