inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "south");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "northwest");

    addExit("west", "/areas/tol-dhurath/temple-exterior/15x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/17x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
