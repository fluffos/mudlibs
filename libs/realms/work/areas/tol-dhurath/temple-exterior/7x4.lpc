inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southwest");
    addFeature("/lib/environment/features/water/rocky-lake-shore.lpc", "south");

    addExit("south", "/areas/tol-dhurath/temple-exterior/7x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/temple-exterior/8x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/temple-exterior/6x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
