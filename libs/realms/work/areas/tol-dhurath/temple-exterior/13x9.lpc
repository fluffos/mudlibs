inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "southwest");
    addFeature("/lib/environment/features/water/creek.lpc", "south");
    addFeature("/lib/environment/features/water/waterfall.lpc", "east");

    addExit("south", "/areas/tol-dhurath/temple-exterior/13x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/temple-exterior/14x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
