inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "southeast");
    addFeature("/lib/environment/features/water/stream.lpc", "east");
    addFeature("/lib/environment/features/landforms/combe.lpc", "west");

    addExit("west", "/areas/tol-dhurath/temple-exterior/10x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/12x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"black bear","outlaw"}));
}
