inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "south");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "north");

    addExit("south", "/areas/tol-dhurath/temple-exterior/1x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/temple-exterior/0x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/temple-exterior/1x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
