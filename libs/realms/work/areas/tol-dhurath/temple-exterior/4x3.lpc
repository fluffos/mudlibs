inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/glen.lpc", "east");

    addExit("south", "/areas/tol-dhurath/temple-exterior/4x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/temple-exterior/3x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/5x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
