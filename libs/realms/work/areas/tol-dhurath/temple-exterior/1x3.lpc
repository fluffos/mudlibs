inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-waterfall.lpc", "northeast");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "southwest");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/temple-exterior/1x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/temple-exterior/1x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
