inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/golden-apple-stand.lpc", "west");

    addExit("south", "/areas/tol-dhurath/temple-exterior/3x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/temple-exterior/4x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
