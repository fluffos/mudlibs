inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/dogwood-stand.lpc", "west");
    addFeature("/lib/environment/features/water/ravine-waterfall.lpc", "southwest");

    addExit("south", "/areas/tol-dhurath/temple-exterior/24x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/temple-exterior/24x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
