inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/temple-exterior/16x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/temple-exterior/15x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
