inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "east");
    addFeature("/lib/environment/features/water/stream.lpc", "north");
    addFeature("/lib/environment/features/landforms/crag.lpc", "south");

    addExit("west", "/areas/tol-dhurath/temple-exterior/4x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/6x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
