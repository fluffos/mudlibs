inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/butte.lpc", "west");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "north");

    addExit("south", "/areas/tol-dhurath/temple-exterior/22x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/temple-exterior/21x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/23x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"white-tail deer","ruffian"}));
}
