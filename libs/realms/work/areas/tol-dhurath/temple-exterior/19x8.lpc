inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");

    addExit("east", "/areas/tol-dhurath/temple-exterior/20x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/temple-exterior/19x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
