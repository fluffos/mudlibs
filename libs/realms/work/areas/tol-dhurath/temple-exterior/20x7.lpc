inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");

    addExit("west", "/areas/tol-dhurath/temple-exterior/19x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/21x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
