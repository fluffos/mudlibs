inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "west");
    addFeature("/lib/environment/features/water/creek.lpc", "east");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southwest");

    addExit("east", "/areas/tol-dhurath/temple-exterior/4x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/temple-exterior/3x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
