inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "west");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "northwest");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "east");

    addExit("west", "/areas/tol-dhurath/temple-exterior/0x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/temple-exterior/1x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
