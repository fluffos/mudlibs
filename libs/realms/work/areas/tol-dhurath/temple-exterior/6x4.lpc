inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "west");

    addExit("west", "/areas/tol-dhurath/temple-exterior/5x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/7x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/temple-exterior/6x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
