inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");

    addExit("south", "/areas/tol-dhurath/temple-exterior/21x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","boar","outlaw","gray wolf"}));
}
