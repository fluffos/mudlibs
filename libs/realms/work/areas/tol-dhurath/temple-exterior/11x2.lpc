inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/hickory-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "south");
    addFeature("/lib/environment/features/water/brook.lpc", "east");

    addExit("north", "/areas/tol-dhurath/temple-exterior/11x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","coyote","timber wolf","brown bear","mountain lion"}));
}
