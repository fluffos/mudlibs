inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "north");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "east");

    addExit("east", "/areas/tol-dhurath/temple-exterior/11x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/temple-exterior/10x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
