inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "south");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "north");

    addExit("east", "/areas/tol-dhurath/temple-exterior/13x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/temple-exterior/11x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
