inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "south");

    addExit("north", "/areas/tol-dhurath/temple-exterior/12x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"hunter","ruffian","coyote","outlaw","boar","kit fox"}));
}
