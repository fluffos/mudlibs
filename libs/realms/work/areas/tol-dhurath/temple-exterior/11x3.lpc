inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "west");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "south");
    addFeature("/lib/environment/features/landforms/butte.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/temple-exterior/11x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/temple-exterior/11x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
