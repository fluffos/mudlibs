inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "southwest");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "north");

    addExit("north", "/areas/tol-dhurath/temple-exterior/9x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/temple-exterior/8x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
