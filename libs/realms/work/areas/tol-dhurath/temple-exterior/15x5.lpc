inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "east");
    addFeature("/lib/environment/features/water/pond.lpc", "northwest");
    addFeature("/lib/environment/features/trees/magnolia-stand.lpc", "west");

    addExit("north", "/areas/tol-dhurath/temple-exterior/15x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/temple-exterior/15x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","coyote","outlaw","gray wolf"}));
}
