inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/willow-stand.lpc", "south");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");

    addExit("north", "/areas/tol-dhurath/temple-exterior/7x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/temple-exterior/6x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
