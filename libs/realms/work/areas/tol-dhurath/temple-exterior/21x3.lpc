inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/waterfall.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "north");
    addFeature("/lib/environment/features/water/lake.lpc", "east");

    addExit("north", "/areas/tol-dhurath/temple-exterior/21x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/temple-exterior/20x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","outlaw","moose","mountain lion","gray wolf"}));
}
