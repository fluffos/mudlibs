inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "north");
    addFeature("/lib/environment/features/water/waterfall.lpc", "east");

    addExit("west", "/areas/tol-dhurath/temple-exterior/13x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/temple-exterior/14x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
