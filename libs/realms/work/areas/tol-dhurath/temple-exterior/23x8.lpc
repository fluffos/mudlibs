inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/crag.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("south", "/areas/tol-dhurath/temple-exterior/23x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/temple-exterior/22x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
