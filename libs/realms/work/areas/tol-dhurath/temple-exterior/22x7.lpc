inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "south");

    addExit("north", "/areas/tol-dhurath/temple-exterior/22x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/temple-exterior/22x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
