inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "west");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "north");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "south");

    addExit("north", "/areas/tol-dhurath/temple-exterior/2x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","white-tail deer","gray wolf"}));
}
