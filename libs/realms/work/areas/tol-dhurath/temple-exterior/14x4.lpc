inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "south");
    addFeature("/lib/environment/features/landforms/mountain.lpc", "southeast");

    addExit("west", "/areas/tol-dhurath/temple-exterior/13x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","outlaw","white-tail deer","wolverine"}));
}
