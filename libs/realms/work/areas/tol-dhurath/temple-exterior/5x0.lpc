inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "northwest");

    addExit("west", "/areas/tol-dhurath/temple-exterior/4x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"hunter","ruffian","white-tail deer","brown bear"}));
}
