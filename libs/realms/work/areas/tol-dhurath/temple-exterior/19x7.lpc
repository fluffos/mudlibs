inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/mound.lpc", "northwest");

    addExit("north", "/areas/tol-dhurath/temple-exterior/19x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/temple-exterior/20x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
