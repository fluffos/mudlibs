inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "east");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "south");

    addExit("west", "/areas/tol-dhurath/temple-exterior/13x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/15x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/temple-exterior/14x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
