inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("north", "/areas/tol-dhurath/temple-exterior/14x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/temple-exterior/13x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
