inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/tor.lpc", "southeast");
    addFeature("/lib/environment/features/water/canyon-brook.lpc", "south");

    addExit("south", "/areas/tol-dhurath/temple-exterior/2x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/temple-exterior/1x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/3x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
