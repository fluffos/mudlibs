inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "east");
    addFeature("/lib/environment/features/landforms/hill.lpc", "west");

    addExit("north", "/areas/tol-dhurath/temple-exterior/17x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/temple-exterior/17x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
