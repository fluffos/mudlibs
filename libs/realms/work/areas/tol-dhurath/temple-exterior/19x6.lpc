inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "southeast");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/temple-exterior/20x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/temple-exterior/18x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
