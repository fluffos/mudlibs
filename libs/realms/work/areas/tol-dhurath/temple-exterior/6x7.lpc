inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/malorn-stand.lpc", "east");
    addBuilding("/lib/environment/buildings/religious/temple.lpc",
        "north", "/areas/tol-dhurath/temple-interior/7x3.lpc");

    addExit("south", "/areas/tol-dhurath/temple-exterior/6x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
