inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "north");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "southwest");

    addExit("north", "/areas/tol-dhurath/temple-exterior/13x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","outlaw","coyote","boar","timber wolf"}));
}
