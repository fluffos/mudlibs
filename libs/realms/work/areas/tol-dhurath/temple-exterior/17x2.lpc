inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/dogwood-stand.lpc", "west");

    addExit("north", "/areas/tol-dhurath/temple-exterior/17x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/temple-exterior/16x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
