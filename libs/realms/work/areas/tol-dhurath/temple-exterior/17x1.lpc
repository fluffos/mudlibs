inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "northwest");
    addFeature("/lib/environment/features/trees/cedar-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/glen.lpc", "west");

    addExit("south", "/areas/tol-dhurath/temple-exterior/17x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/temple-exterior/16x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/temple-exterior/18x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
