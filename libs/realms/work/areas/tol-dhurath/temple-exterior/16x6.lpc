inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "north");

    addExit("west", "/areas/tol-dhurath/temple-exterior/15x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/temple-exterior/16x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/temple-exterior/17x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
