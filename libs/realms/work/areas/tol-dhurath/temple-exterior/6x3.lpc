inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "west");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "east");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "southwest");

    addExit("east", "/areas/tol-dhurath/temple-exterior/7x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/temple-exterior/5x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
