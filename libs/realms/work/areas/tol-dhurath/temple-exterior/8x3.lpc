inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "west");
    addFeature("/lib/environment/features/landforms/hill.lpc", "southeast");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "south");

    addExit("east", "/areas/tol-dhurath/temple-exterior/9x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/temple-exterior/8x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
