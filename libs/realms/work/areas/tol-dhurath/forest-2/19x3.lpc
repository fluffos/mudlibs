inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "north");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "east");
    addFeature("/lib/environment/features/landforms/mound.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-2/19x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-2/19x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
