inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");
    addFeature("/lib/environment/features/landforms/combe.lpc", "southwest");

    addExit("north", "/areas/tol-dhurath/forest-2/24x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-2/24x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-1/0x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
