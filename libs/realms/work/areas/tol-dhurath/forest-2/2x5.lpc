inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/forest-2/2x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-2/1x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-2/2x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
