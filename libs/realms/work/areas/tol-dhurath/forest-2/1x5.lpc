inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "north");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-2/2x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","outlaw","white-tail deer","gray squirrel"}));
}
