inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "east");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "southeast");

    addExit("west", "/areas/tol-dhurath/forest-2/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-2/24x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-2/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
