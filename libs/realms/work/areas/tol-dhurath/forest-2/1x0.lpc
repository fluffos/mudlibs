inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/black-cherry-stand.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "south");

    addExit("north", "/areas/tol-dhurath/forest-2/1x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-2/0x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","muskrat","outlaw"}));
}
