inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "east");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "north");

    addExit("west", "/areas/tol-dhurath/forest-2/5x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"white-tail deer","otter","hunter"}));
}
