inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "east");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "west");

    addExit("west", "/areas/tol-dhurath/forest-2/8x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-2/9x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"gray fox","ruffian","mule deer"}));
}
