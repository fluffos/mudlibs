inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/dell.lpc", "south");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/forest-2/10x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-2/11x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
