inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "south");

    addExit("south", "/areas/tol-dhurath/forest-2/3x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-2/4x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
