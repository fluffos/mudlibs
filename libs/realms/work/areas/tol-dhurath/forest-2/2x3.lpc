inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "southwest");
    addFeature("/lib/environment/features/trees/cedar-stand.lpc", "south");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-2/3x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-2/1x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","white-tail deer","outlaw","badger"}));
}
