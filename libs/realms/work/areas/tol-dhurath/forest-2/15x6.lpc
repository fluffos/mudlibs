inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "north");
    addFeature("/lib/environment/features/water/pond.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-2/15x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"raccoon","red fox","outlaw"}));
}
