inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/stream.lpc", "northeast");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-2/11x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-2/11x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-2/10x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
