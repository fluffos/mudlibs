inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/mound.lpc", "southwest");

    addExit("south", "/areas/tol-dhurath/forest-2/3x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-2/4x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-2/2x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
