inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "northwest");
    addFeature("/lib/environment/features/water/brook.lpc", "south");

    addExit("north", "/areas/tol-dhurath/forest-2/22x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-2/22x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
