inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "south");

    addExit("north", "/areas/tol-dhurath/forest-2/1x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-2/2x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
