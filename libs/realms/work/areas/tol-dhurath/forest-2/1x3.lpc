inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "south");
    addFeature("/lib/environment/features/trees/marblewood-stand.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/forest-2/1x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-2/2x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
