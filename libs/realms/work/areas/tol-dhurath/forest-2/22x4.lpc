inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "east");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "north");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "south");

    addExit("north", "/areas/tol-dhurath/forest-2/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-2/22x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","coyote"}));
}
