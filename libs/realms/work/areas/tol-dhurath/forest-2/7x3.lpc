inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "south");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-2/7x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","weasel","outlaw","red fox","coyote","white-tail deer"}));
}
