inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "south");

    addExit("south", "/areas/tol-dhurath/forest-2/16x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-2/17x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
