inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/crag.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "north");

    addExit("east", "/areas/tol-dhurath/forest-2/11x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-2/9x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
