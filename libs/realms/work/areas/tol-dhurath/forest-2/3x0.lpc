inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/dogwood-stand.lpc", "east");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "south");

    addExit("north", "/areas/tol-dhurath/forest-2/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-2/4x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
