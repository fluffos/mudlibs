inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "east");
    addFeature("/lib/environment/features/landforms/mound.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");

    addExit("east", "/areas/tol-dhurath/forest-2/3x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-2/2x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
