inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "west");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "southwest");

    addExit("east", "/areas/tol-dhurath/forest-2/22x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-2/21x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
