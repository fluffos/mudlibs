inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/glen.lpc", "north");
    addFeature("/lib/environment/features/landforms/crag.lpc", "southeast");

    addExit("west", "/areas/tol-dhurath/forest-2/9x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-2/10x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
