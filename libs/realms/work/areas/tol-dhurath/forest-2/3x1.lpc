inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "north");

    addExit("west", "/areas/tol-dhurath/forest-2/2x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-2/3x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
