inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/winesap-apple-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "northwest");

    addExit("west", "/areas/tol-dhurath/forest-2/7x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-2/8x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
