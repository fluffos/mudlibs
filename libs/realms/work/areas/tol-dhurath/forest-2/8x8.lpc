inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "north");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-2/9x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-2/8x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"white-tail deer","coyote"}));
}
