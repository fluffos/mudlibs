inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "north");

    addExit("east", "/areas/tol-dhurath/forest-2/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"white-tail deer","red squirrel","outlaw"}));
}
