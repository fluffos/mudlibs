inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/mound.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-2/9x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-2/10x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
