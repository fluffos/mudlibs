inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/butte.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-2/12x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-2/10x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
