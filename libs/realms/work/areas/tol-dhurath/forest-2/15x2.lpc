inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "southwest");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/rosewood-stand.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-2/15x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-2/14x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
