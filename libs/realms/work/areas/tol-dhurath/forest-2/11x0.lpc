inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/chokecherry-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "north");

    addExit("east", "/areas/tol-dhurath/forest-2/12x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-2/11x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","outlaw"}));
}
