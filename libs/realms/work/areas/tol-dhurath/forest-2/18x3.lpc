inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "west");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "southwest");

    addExit("west", "/areas/tol-dhurath/forest-2/17x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"coyote","beaver","outlaw","red fox"}));
}
