inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/lake.lpc", "east");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-2/14x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-2/14x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
