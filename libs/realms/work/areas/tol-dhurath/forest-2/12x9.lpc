inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "west");
    addFeature("/lib/environment/features/water/creek.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southeast");

    addExit("west", "/areas/tol-dhurath/forest-2/11x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-2/12x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
