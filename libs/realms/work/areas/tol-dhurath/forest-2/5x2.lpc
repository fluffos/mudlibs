inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-2/5x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","muskrat","outlaw","opossum","coyote"}));
}
