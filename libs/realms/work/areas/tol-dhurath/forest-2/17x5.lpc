inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "south");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "northwest");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "north");

    addExit("south", "/areas/tol-dhurath/forest-2/17x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-2/17x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-2/16x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
