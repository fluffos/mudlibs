inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "west");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-2/2x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-2/1x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
