inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/waterfall.lpc", "south");
    addFeature("/lib/environment/features/trees/cypress-stand.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-2/4x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-2/5x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
