inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "east");
    addFeature("/lib/environment/features/landforms/glen.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-2/17x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-2/18x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-2/19x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
