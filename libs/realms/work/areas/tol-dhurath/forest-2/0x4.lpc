inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "north");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "southeast");
    addFeature("/lib/environment/features/trees/rosewood-stand.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-2/1x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-3/24x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","outlaw","white-tail deer","kit fox"}));
}
