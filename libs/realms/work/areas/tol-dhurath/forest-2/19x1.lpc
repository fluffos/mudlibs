inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "southwest");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "west");
    addFeature("/lib/environment/features/water/stream.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-2/19x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-2/18x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-2/20x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
