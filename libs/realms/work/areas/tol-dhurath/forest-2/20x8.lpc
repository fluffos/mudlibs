inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/combe.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/butte.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-2/20x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","hunter","coyote","outlaw","white-tail deer"}));
}
