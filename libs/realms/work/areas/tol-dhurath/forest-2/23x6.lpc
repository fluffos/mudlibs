inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cypress-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "south");

    addExit("south", "/areas/tol-dhurath/forest-2/23x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-2/23x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-2/22x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
