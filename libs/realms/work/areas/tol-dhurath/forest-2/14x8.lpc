inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ambrosia-apple-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/glen.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-2/13x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-2/15x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-2/14x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
