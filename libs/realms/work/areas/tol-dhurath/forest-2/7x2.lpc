inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "northeast");
    addFeature("/lib/environment/features/trees/walnut-stand.lpc", "north");

    addExit("east", "/areas/tol-dhurath/forest-2/8x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-2/7x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-2/6x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
