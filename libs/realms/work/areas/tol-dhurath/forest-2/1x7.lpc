inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/bluff.lpc", "northeast");
    addFeature("/lib/environment/features/trees/honeycrisp-apple-stand.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-2/1x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-2/1x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","outlaw"}));
}
