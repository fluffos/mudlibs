inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "east");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-2/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-2/1x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-2/2x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
