inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "north");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "south");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "east");

    addExit("west", "/areas/tol-dhurath/forest-2/3x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-2/4x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
