inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/walnut-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/combe.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-2/5x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"coyote","white-tail deer","hunter"}));
}
