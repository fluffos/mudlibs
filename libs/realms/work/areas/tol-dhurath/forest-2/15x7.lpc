inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/tor.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "south");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-2/15x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-2/15x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"white-tail deer","ruffian","outlaw"}));
}
