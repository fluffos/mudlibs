inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/mound.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-2/19x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-2/20x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","outlaw"}));
}
