inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ambrosia-apple-stand.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("east", "/areas/tol-dhurath/forest-2/21x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-2/20x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
