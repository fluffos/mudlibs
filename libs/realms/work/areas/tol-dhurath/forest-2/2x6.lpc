inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/chokecherry-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "north");

    addExit("west", "/areas/tol-dhurath/forest-2/1x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-2/2x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
