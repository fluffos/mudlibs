inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-2/14x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-2/13x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
