inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "southeast");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "east");

    addExit("west", "/areas/tol-dhurath/forest-2/21x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-2/23x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-2/22x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
