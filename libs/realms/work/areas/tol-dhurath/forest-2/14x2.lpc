inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "north");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "southeast");
    addFeature("/lib/environment/features/water/brook.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-2/15x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-2/14x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
