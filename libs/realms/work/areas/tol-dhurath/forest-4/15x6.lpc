inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/buckeye-stand.lpc", "west");
    addFeature("/lib/environment/features/water/pond.lpc", "west");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "west");

    addExit("west", "/areas/tol-dhurath/forest-4/14x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-4/15x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
