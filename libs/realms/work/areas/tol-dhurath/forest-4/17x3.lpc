inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/mulberry-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/grape-stand.lpc", "west");

    addExit("west", "/areas/tol-dhurath/forest-4/16x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-4/18x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
