inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/combe.lpc", "southwest");

    addExit("south", "/areas/tol-dhurath/forest-4/12x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-4/12x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-4/11x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
