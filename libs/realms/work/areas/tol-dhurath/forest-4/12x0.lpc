inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");

    addExit("east", "/areas/tol-dhurath/forest-4/13x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"weasel","zombie","ruffian","otter","white-tail deer"}));
}
