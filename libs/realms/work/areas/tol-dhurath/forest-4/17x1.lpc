inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/teak-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "south");
    addFeature("/lib/environment/features/landforms/bluff.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-4/18x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","fisher","porcupine","raccoon","gray squirrel","timber wolf"}));
}
