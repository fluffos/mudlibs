inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/fir-stand.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-4/0x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","coyote","warg","porcupine","outlaw","white-tail deer"}));
}
