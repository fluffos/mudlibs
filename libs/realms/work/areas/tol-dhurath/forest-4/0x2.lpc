inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cherry-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/waterfall.lpc", "northeast");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "northeast");

    addExit("east", "/areas/tol-dhurath/forest-4/1x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
