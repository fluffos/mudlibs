inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/mound.lpc", "west");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-4/4x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-4/3x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
