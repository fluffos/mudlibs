inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-dry-creek.lpc", "east");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "east");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-4/16x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-4/14x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-4/15x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"zombie","ruffian","warg","opossum","chipmunk"}));
}
