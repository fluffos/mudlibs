inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "southwest");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");

    addExit("south", "/areas/tol-dhurath/forest-4/0x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"weasel","ruffian","zombie","skunk","brown bear","raccoon"}));
}
