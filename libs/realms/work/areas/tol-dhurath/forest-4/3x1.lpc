inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "south");
    addFeature("/lib/environment/features/water/canyon-brook.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-4/2x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-4/4x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
