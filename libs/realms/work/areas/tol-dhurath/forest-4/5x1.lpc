inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "west");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "west");
    addFeature("/lib/environment/features/landforms/hill.lpc", "west");

    addExit("west", "/areas/tol-dhurath/forest-4/4x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-4/6x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
