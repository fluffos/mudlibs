inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "south");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-4/17x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-4/18x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
