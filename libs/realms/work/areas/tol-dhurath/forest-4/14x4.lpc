inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "east");
    addFeature("/lib/environment/features/trees/paper-birch-stand.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-4/15x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"hunter","weasel","white-tail deer"}));
}
