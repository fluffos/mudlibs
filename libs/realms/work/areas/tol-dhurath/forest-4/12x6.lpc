inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "north");
    addFeature("/lib/environment/features/landforms/glen.lpc", "north");

    addExit("south", "/areas/tol-dhurath/forest-4/12x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-4/12x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-4/11x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
