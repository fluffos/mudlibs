inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-4/13x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-4/13x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-4/12x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
