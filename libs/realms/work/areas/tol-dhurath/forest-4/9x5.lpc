inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "east");
    addFeature("/lib/environment/features/trees/winesap-apple-stand.lpc", "east");

    addExit("west", "/areas/tol-dhurath/forest-4/8x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-4/9x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
