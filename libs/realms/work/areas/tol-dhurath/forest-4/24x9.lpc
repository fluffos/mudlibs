inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "northwest");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "northwest");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-4/24x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-4/23x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
