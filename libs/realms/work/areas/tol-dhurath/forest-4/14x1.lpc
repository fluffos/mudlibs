inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "south");
    addFeature("/lib/environment/features/water/creek.lpc", "south");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "south");

    addExit("south", "/areas/tol-dhurath/forest-4/14x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-4/13x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-4/15x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
