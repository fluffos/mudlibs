inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "northwest");
    addFeature("/lib/environment/features/trees/fir-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-4/8x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"hunter","coyote","warg","mink"}));
}
