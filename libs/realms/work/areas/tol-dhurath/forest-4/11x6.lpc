inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "east");
    addFeature("/lib/environment/features/trees/red-oak-stand.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-4/11x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-4/12x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
