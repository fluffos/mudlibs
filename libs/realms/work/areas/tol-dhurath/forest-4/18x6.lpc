inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "southwest");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "southwest");

    addExit("north", "/areas/tol-dhurath/forest-4/18x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-4/18x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
