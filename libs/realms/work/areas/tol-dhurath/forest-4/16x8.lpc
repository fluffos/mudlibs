inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "south");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-4/15x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-4/16x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"weasel","coyote","outlaw","badger","red wolf"}));
}
