inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "northwest");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");
    addFeature("/lib/environment/features/trees/walnut-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-4/2x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-4/1x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-4/2x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
