inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "north");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("north", "/areas/tol-dhurath/forest-4/16x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-4/17x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
