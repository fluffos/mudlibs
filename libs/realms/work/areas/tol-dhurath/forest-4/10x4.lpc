inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/red-oak-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/dell.lpc", "southwest");

    addExit("west", "/areas/tol-dhurath/forest-4/9x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-4/10x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
