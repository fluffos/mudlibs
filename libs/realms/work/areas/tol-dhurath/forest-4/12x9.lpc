inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/glen.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-4/13x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-4/12x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
