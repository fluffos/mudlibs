inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "southeast");
    addFeature("/lib/environment/features/trees/pear-stand.lpc", "southeast");

    addExit("west", "/areas/tol-dhurath/forest-4/10x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-4/11x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
