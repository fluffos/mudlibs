inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "southeast");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southeast");

    addExit("west", "/areas/tol-dhurath/forest-4/3x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","gray fox","coyote","timber wolf","red wolf"}));
}
