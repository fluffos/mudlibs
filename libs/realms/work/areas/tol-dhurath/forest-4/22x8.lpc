inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "east");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "east");

    addExit("west", "/areas/tol-dhurath/forest-4/21x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-4/22x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
