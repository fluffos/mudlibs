inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "east");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "east");

    addExit("west", "/areas/tol-dhurath/forest-4/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-4/5x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
