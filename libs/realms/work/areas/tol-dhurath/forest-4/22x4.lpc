inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "southwest");

    addExit("north", "/areas/tol-dhurath/forest-4/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-4/22x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","muskrat","coyote","skunk","raccoon","chipmunk"}));
}
