inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "southwest");

    addExit("east", "/areas/tol-dhurath/forest-4/14x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-4/12x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
