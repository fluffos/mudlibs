inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "northwest");

    addExit("east", "/areas/tol-dhurath/forest-4/14x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-4/12x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
