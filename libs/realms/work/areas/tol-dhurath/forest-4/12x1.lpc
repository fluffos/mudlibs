inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "south");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "south");
    addFeature("/lib/environment/features/water/stream.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-4/13x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("north", "/areas/tol-dhurath/forest-4/12x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
