inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "northwest");
    addFeature("/lib/environment/features/trees/dogwood-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-4/20x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"hunter","red fox","red squirrel","raccoon","timber wolf"}));
}
