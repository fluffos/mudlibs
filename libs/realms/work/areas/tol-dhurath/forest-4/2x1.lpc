inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-4/2x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-4/3x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
