inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/green-apple-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/combe.lpc", "east");
    addFeature("/lib/environment/features/water/stream.lpc", "east");

    addExit("west", "/areas/tol-dhurath/forest-4/13x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-4/14x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
