inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northeast");
    addFeature("/lib/environment/features/trees/poplar-stand.lpc", "northeast");

    addExit("north", "/areas/tol-dhurath/forest-4/9x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-4/9x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
