inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "west");
    addFeature("/lib/environment/features/water/canyon-brook.lpc", "west");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-4/7x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-4/8x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
