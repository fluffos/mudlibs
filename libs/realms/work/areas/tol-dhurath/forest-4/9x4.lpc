inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hill.lpc", "east");
    addFeature("/lib/environment/features/landforms/bluff.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-4/9x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-4/10x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
