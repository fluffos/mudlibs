inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/basswood-stand.lpc", "north");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "north");

    addExit("west", "/areas/tol-dhurath/forest-4/13x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"beaver","knight of the storm","outlaw","chipmunk"}));
}
