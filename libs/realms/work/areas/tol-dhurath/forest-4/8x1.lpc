inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "southwest");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "southwest");
    addFeature("/lib/environment/features/water/ravine-creek.lpc", "southwest");

    addExit("west", "/areas/tol-dhurath/forest-4/7x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-4/8x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
