inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/hummock.lpc", "west");

    addExit("west", "/areas/tol-dhurath/forest-4/18x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-4/19x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
