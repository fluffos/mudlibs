inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");

    addExit("north", "/areas/tol-dhurath/forest-4/7x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-4/7x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
