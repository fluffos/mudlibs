inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northwest");

    addExit("west", "/areas/tol-dhurath/forest-4/14x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-4/16x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
