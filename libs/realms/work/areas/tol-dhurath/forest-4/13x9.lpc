inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/peach-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "east");

    addExit("west", "/areas/tol-dhurath/forest-4/12x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","zombie","outlaw","knight of the storm","red squirrel","kit fox"}));
}
