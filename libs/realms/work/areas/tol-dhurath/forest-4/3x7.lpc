inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/kingwood-stand.lpc", "northwest");

    addExit("west", "/areas/tol-dhurath/forest-4/2x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"gray fox","ruffian","panther","mule deer","outlaw","groundhog","mink"}));
}
