inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "east");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "east");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-4/2x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-4/0x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-4/1x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","coyote","otter","knight of the storm","skunk","beaver","kit fox"}));
}
