inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northeast");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");

    addExit("west", "/areas/tol-dhurath/forest-4/20x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-4/22x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
