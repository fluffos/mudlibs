inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "north");
    addFeature("/lib/environment/features/water/pond.lpc", "north");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "north");

    addExit("north", "/areas/tol-dhurath/forest-4/20x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","muskrat","porcupine","boar","red squirrel"}));
}
