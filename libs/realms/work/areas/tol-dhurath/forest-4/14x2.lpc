inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "northeast");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "northeast");

    addExit("north", "/areas/tol-dhurath/forest-4/14x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"muskrat","otter","beaver","white-tail deer","raccoon","skeleton"}));
}
