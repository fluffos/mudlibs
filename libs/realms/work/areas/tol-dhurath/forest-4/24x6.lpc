inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "west");

    addExit("west", "/areas/tol-dhurath/forest-4/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"warg","keeper of the night","beaver"}));
}
