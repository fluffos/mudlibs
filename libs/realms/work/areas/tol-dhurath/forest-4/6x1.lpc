inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-4/5x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-4/7x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"zombie","skunk","white-tail deer","badger"}));
}
