inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "west");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "west");
    addFeature("/lib/environment/features/landforms/glen.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-4/8x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-4/7x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"gopher","outlaw","warg","coyote","timber wolf","boar","mountain lion"}));
}
