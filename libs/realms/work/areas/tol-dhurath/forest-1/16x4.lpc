inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/yew-stand.lpc", "southwest");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "north");

    addExit("south", "/areas/tol-dhurath/forest-1/16x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"badger","red fox"}));
}
