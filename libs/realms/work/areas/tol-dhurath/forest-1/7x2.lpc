inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/butte.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-1/7x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-1/8x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-1/6x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
