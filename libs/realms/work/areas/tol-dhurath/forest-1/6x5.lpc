inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-1/6x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","gray fox","mink","white-tail deer"}));
}
