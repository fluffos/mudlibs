inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "south");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("south", "/areas/tol-dhurath/forest-1/0x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/0x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","hunter","outlaw","mink"}));
}
