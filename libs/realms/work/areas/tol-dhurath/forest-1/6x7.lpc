inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "north");
    addFeature("/lib/environment/features/water/waterfall.lpc", "east");
    addFeature("/lib/environment/features/trees/hemlock-stand.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/forest-1/6x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-1/7x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
