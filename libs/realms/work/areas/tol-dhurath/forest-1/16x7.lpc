inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "south");
    addFeature("/lib/environment/features/water/canyon-stream.lpc", "east");
    addFeature("/lib/environment/features/trees/ironwood-stand.lpc", "north");

    addExit("west", "/areas/tol-dhurath/forest-1/15x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("south", "/areas/tol-dhurath/forest-1/16x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
