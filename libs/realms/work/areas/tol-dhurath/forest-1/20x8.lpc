inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-1/21x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-1/19x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
