inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/glen.lpc", "north");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-1/21x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-1/23x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"hunter","groundhog"}));
}
