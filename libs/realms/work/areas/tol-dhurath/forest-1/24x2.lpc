inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "south");
    addFeature("/lib/environment/features/trees/spruce-stand.lpc", "west");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "north");

    addExit("south", "/areas/tol-dhurath/forest-1/24x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/24x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
