inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/entry/7x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/7x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
