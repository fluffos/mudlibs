inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "north");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "south");

    addExit("east", "/areas/tol-dhurath/forest-1/13x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("south", "/areas/tol-dhurath/forest-1/12x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
