inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "southeast");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "south");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "east");

    addExit("east", "/areas/tol-dhurath/forest-1/10x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"outlaw","coyote","white-tail deer","beaver","mink"}));
}
