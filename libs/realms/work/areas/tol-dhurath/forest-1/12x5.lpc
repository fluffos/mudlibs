inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/fir-stand.lpc", "north");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-1/12x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-1/11x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
