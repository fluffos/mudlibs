inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "north");
    addFeature("/lib/environment/features/water/lake-shore-bluff.lpc", "south");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "southeast");

    addExit("south", "/areas/tol-dhurath/forest-1/11x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/11x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("west", "/areas/tol-dhurath/forest-1/10x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
