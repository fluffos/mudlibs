inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/hickory-stand.lpc", "north");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "south");
    addFeature("/lib/environment/features/landforms/combe.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-1/3x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/3x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
