inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/dell.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/tor.lpc", "southeast");
    addFeature("/lib/environment/features/water/canyon-creek.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-1/7x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/7x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
