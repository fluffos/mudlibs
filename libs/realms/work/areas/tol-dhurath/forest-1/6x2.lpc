inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/glen.lpc", "northwest");
    addFeature("/lib/environment/features/trees/golden-apple-stand.lpc", "southwest");

    addExit("south", "/areas/tol-dhurath/forest-1/6x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-1/7x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
