inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/chokecherry-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northeast");
    addFeature("/lib/environment/features/water/canyon-dry-bed.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-1/22x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/22x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"beaver","hunter","kit fox"}));
}
