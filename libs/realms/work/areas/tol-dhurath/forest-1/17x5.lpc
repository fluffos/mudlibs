inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/brook.lpc", "west");
    addFeature("/lib/environment/features/water/pond.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-1/17x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-1/18x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
