inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/golden-apple-stand.lpc", "south");
    addFeature("/lib/environment/features/water/brook.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-1/7x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-1/6x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
