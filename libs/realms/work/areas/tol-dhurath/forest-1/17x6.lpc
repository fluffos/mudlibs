inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/holly-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "west");

    addExit("east", "/areas/tol-dhurath/forest-1/18x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-1/16x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
