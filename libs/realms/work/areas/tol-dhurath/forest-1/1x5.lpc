inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "north");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "south");
    addFeature("/lib/environment/features/landforms/hill.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-1/1x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-1/2x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");

    addRandomCreature(({"ruffian","outlaw","chipmunk"}));
}
