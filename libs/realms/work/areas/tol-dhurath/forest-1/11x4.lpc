inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "southeast");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/fir-stand.lpc", "northwest");

    addExit("south", "/areas/tol-dhurath/forest-1/11x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-1/12x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
