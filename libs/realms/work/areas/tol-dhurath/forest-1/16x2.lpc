inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "south");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-1/16x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/16x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","outlaw","coyote","white-tail deer"}));
}
