inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/apple-stand.lpc", "east");

    addExit("south", "/areas/tol-dhurath/forest-1/5x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-1/6x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
