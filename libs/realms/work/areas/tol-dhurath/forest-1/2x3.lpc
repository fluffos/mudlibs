inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/promontory.lpc", "south");

    addExit("north", "/areas/tol-dhurath/forest-1/2x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");

    addRandomCreature(({"ruffian","outlaw","coyote","weasel"}));
}
