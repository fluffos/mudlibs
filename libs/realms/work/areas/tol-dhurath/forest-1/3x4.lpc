inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "west");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/sinkhole.lpc", "east");

    addExit("north", "/areas/tol-dhurath/forest-1/3x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-1/3x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");

    addRandomCreature(({"ruffian","red fox","outlaw"}));
}
