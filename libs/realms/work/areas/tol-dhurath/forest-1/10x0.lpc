inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/butte.lpc", "southwest");
    addFeature("/lib/environment/features/water/creek.lpc", "northwest");

    addExit("west", "/areas/tol-dhurath/forest-1/9x0.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-1/10x1.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
