inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");
    addFeature("/lib/environment/features/landforms/valley.lpc", "northwest");

    addExit("north", "/areas/tol-dhurath/forest-1/16x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("south", "/areas/tol-dhurath/forest-1/16x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
}
