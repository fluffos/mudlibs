inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "north");
    addFeature("/lib/environment/features/landforms/hillock.lpc", "southeast");

    addExit("west", "/areas/tol-dhurath/forest-1/5x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-1/7x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
