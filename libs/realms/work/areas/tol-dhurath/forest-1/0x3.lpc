inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "south");
    addFeature("/lib/environment/features/trees/sugar-maple-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "west");

    addExit("north", "/areas/tol-dhurath/forest-1/0x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-1/1x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
