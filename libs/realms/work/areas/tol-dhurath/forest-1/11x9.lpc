inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gulley-creek.lpc", "east");
    addFeature("/lib/environment/features/water/ravine-waterfall.lpc", "north");

    addExit("south", "/areas/tol-dhurath/forest-1/11x8.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("east", "/areas/tol-dhurath/forest-1/12x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
    addExit("west", "/areas/tol-dhurath/forest-1/10x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
}
