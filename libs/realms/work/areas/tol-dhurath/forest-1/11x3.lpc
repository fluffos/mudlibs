inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "northeast");
    addFeature("/lib/environment/features/landforms/mound.lpc", "northwest");
    addFeature("/lib/environment/features/water/canyon-brook.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-1/11x2.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/11x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
