inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/landforms/ridge.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "west");

    addExit("west", "/areas/tol-dhurath/forest-1/0x3.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("north", "/areas/tol-dhurath/forest-1/1x4.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
}
