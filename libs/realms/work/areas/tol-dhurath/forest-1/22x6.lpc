inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/water/gorge-creek.lpc", "south");
    addFeature("/lib/environment/features/water/ravine-brook.lpc", "west");

    addExit("south", "/areas/tol-dhurath/forest-1/22x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("north", "/areas/tol-dhurath/forest-1/22x7.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "north");
    addExit("east", "/areas/tol-dhurath/forest-1/23x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
