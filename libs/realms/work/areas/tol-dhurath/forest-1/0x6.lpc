inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/hollow.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "northeast");

    addExit("south", "/areas/tol-dhurath/forest-1/0x5.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "south");
    addExit("west", "/areas/tol-dhurath/forest-2/24x6.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");

    addRandomCreature(({"ruffian","hunter","outlaw","beaver"}));
}
