inherit "/lib/environment/generatedEnvironment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/chokecherry-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "north");
    addFeature("/lib/environment/features/water/lake.lpc", "south");

    addExit("west", "/areas/tol-dhurath/forest-1/9x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "west");
    addExit("east", "/areas/tol-dhurath/forest-1/11x9.lpc");
    addFeature("/lib/environment/features/paths/path.lpc", "east");
}
