inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");
    addFeature("/lib/environment/features/trees/walnut-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/dale.lpc", "south");
    addBuilding("/lib/environment/buildings/homes/farm-house.lpc", "north");
    addBuilding("/lib/environment/buildings/trades/barn.lpc", "southwest");

    addExit("east", "/areas/argalen-keep/surrounding/12x3.lpc");
    addFeature("/lib/environment/features/paths/dirt-road.lpc", "east");
    addExit("west", "/areas/argalen-keep/surrounding/9x3.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "west");
}
