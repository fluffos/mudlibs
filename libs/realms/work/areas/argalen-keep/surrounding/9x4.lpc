inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/walnut-stand.lpc", "north");
    addFeature("/lib/environment/features/water/brook.lpc", "south");

    addExit("west", "/areas/argalen-keep/surrounding/8x4.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "west");
    addExit("north", "/areas/argalen-keep/surrounding/9x3.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "north");
    addExit("south", "/areas/argalen-keep/surrounding/9x5.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "south");
}
