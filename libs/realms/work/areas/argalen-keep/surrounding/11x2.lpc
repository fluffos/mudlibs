inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");
    addFeature("/lib/environment/features/trees/apple-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/dale.lpc", "northwest");

    addExit("east", "/areas/argalen-keep/surrounding/12x2.lpc");
    addFeature("/lib/environment/features/paths/dirt-road.lpc", "east");
    addExit("south", "/areas/argalen-keep/surrounding/11x1.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "south");
}
