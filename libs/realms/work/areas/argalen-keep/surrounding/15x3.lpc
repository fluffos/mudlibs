inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest-hill.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "north");
    addFeature("/lib/environment/features/landforms/hill.lpc", "east");
    addFeature("/lib/environment/features/landforms/crag.lpc", "northeast");

    addExit("west", "/areas/argalen-keep/surrounding/14x3.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "west");
    addExit("south", "/areas/argalen-keep/surrounding/15x4.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "south");
}
