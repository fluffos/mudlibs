inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "northwest");
    addFeature("/lib/environment/features/water/brook.lpc", "southwest");

    addExit("east", "/areas/argalen-keep/surrounding/9x4.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "east");
}
