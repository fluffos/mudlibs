inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/beech-stand.lpc", "northeast");
    addFeature("/lib/environment/features/water/creek.lpc", "southeast");
    addFeature("/lib/environment/features/landforms/knoll.lpc", "north");

    addExit("west", "/areas/argalen-keep/surrounding/12x0.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "west");
}
