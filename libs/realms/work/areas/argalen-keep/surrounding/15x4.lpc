inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest-hill.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "southeast");
    addFeature("/lib/environment/features/trees/fir-stand.lpc", "west");
    addFeature("/lib/environment/features/landforms/crag.lpc", "east");

    addExit("north", "/areas/argalen-keep/surrounding/15x3.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "north");
    addExit("east", "/areas/argalen-keep/surrounding/16x4.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "east");
}
