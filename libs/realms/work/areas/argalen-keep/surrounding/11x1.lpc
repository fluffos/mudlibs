inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/elm-stand.lpc", "northwest");
    addFeature("/lib/environment/features/trees/hickory-stand.lpc", "south");
    addFeature("/lib/environment/features/landforms/glen.lpc", "southwest");

    addExit("east", "/areas/argalen-keep/surrounding/12x1.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "east");
    addExit("north", "/areas/argalen-keep/surrounding/11x2.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "north");
}
