inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");
    addBuilding("/lib/environment/buildings/homes/farm-house.lpc", "west");
    addBuilding("/lib/environment/buildings/trades/stable.lpc", "east");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");
    addFeature("/lib/environment/features/trees/apple-stand.lpc", "southwest");

    addDecorator("village north-south road");

    addExit("south", "/areas/argalen-keep/surrounding/12x2.lpc");
    addExit("north", "/areas/argalen-keep/surrounding/12x4.lpc");
    addExit("west", "/areas/argalen-keep/surrounding/10x3.lpc");
    addFeature("/lib/environment/features/paths/dirt-road.lpc", "west");
    addExit("east", "/areas/argalen-keep/surrounding/14x3.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "east");
}
