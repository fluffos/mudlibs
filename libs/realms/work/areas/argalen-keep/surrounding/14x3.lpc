inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest-hill.lpc");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "east");
    addFeature("/lib/environment/features/landforms/hill.lpc", "northeast");
    addFeature("/lib/environment/features/water/creek.lpc", "south");

    addExit("west", "/areas/argalen-keep/surrounding/12x3.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "west");
    addExit("east", "/areas/argalen-keep/surrounding/15x3.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "east");
}
