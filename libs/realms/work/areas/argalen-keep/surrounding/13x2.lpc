inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");
    addFeature("/lib/environment/features/water/creek.lpc", "east");
    addFeature("/lib/environment/features/trees/pear-stand.lpc", "northeast");

    addExit("west", "/areas/argalen-keep/surrounding/12x2.lpc");
    addFeature("/lib/environment/features/paths/dirt-road.lpc", "west");
    addExit("south", "/areas/argalen-keep/surrounding/13x1.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "south");
}
