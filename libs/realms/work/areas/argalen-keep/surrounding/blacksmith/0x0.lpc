inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/wood-interior-shop.lpc");
    addItem("/lib/environment/items/lighting/forge-fire.lpc", "north");
    addItem("/lib/environment/items/lighting/window.lpc", "west");
    addItem("/lib/environment/items/furniture/rack.lpc", "east");
    addItem("/lib/environment/items/furniture/coffer.lpc", "south");
    addShop("/lib/environment/shopInventories/swordsmith.lpc");

    addObject("/areas/argalen-keep/surrounding/characters/branna/branna.lpc");

    addExitWithDoor("west", "/areas/argalen-keep/surrounding/12x4.lpc");
}
