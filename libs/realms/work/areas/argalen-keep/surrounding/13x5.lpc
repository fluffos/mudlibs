inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/village.lpc");
    addBuilding("/lib/environment/buildings/trades/market.lpc", "south");
    addBuilding("/lib/environment/buildings/shops/grocer.lpc", "east",
        "/areas/argalen-keep/surrounding/13x6.lpc");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "west");
    addItem("/lib/environment/items/lighting/lantern.lpc", "east");

    addDecorator("village east-west road");

    addExit("west", "/areas/argalen-keep/surrounding/12x5.lpc");
}
