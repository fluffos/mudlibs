inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest-hill.lpc");
    addFeature("/lib/environment/features/landforms/cliff.lpc", "east");
    addFeature("/lib/environment/features/trees/pine-stand.lpc", "south");
    addBuilding("/lib/environment/buildings/trades/mining-company.lpc", "north");

    addExit("west", "/areas/argalen-keep/surrounding/15x4.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "west");
}
