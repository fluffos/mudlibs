inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/hickory-stand.lpc", "southwest");
    addFeature("/lib/environment/features/landforms/combe.lpc", "south");

    addExit("north", "/areas/argalen-keep/surrounding/9x4.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "north");
}
