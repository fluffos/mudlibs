inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/village.lpc");
    addBuilding("/lib/environment/buildings/shops/inn.lpc", "west");
    addBuilding("/lib/environment/buildings/trades/market.lpc", "east");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addItem("/lib/environment/items/lighting/lantern.lpc", "north");
    addItem("/lib/environment/items/lighting/lantern.lpc", "south");
    addItem("/lib/environment/items/furniture/bench.lpc", "east");

    addDecorator("village square");

    addExit("south", "/areas/argalen-keep/surrounding/12x4.lpc");
    addExit("north", "/areas/argalen-keep/surrounding/12x6.lpc");
    addExit("west", "/areas/argalen-keep/surrounding/11x5.lpc");
    addExit("east", "/areas/argalen-keep/surrounding/13x5.lpc");
}
