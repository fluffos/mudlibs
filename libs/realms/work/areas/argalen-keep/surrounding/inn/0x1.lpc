inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/inn.lpc");
    addItem("/lib/environment/items/lighting/hearth.lpc", "west");
    addItem("/lib/environment/items/furniture/counter.lpc", "north");
    addItem("/lib/environment/items/furniture/small-shelf.lpc", "east");
    addItem("/lib/environment/items/lighting/window.lpc", "north");

    addExit("south", "/areas/argalen-keep/surrounding/inn/0x0.lpc");
}
