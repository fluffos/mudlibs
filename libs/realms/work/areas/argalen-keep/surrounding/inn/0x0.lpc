inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/inn.lpc");
    addItem("/lib/environment/items/lighting/fireplace.lpc", "north");
    addItem("/lib/environment/items/lighting/candelabra.lpc", "south");
    addItem("/lib/environment/items/furniture/long-table.lpc", "west");
    addItem("/lib/environment/items/furniture/bench.lpc", "east");
    addItem("/lib/environment/items/lighting/window.lpc", "east");

    addObject("/areas/argalen-keep/surrounding/characters/aldric/aldric.lpc");

    addExitWithDoor("east", "/areas/argalen-keep/surrounding/11x5.lpc");
    addExit("north", "/areas/argalen-keep/surrounding/inn/0x1.lpc");
}
