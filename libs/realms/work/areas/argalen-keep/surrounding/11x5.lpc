inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/village.lpc");
    addBuilding("/lib/environment/buildings/shops/inn.lpc", "west",
        "/areas/argalen-keep/surrounding/inn/0x0.lpc");
    addBuilding("/lib/environment/buildings/shops/bakery.lpc", "south");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "east");
    addItem("/lib/environment/items/lighting/lantern.lpc", "west");

    addDecorator("village east-west road");

    addExit("east", "/areas/argalen-keep/surrounding/12x5.lpc");
}
