inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/birch-stand.lpc", "east");
    addFeature("/lib/environment/features/trees/hazel-stand.lpc", "south");
    addFeature("/lib/environment/features/water/creek.lpc", "northeast");

    addExit("west", "/areas/argalen-keep/surrounding/12x1.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "west");
    addExit("north", "/areas/argalen-keep/surrounding/13x2.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "north");
}
