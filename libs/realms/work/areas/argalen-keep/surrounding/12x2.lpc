inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/farmland.lpc");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");
    addFeature("/lib/environment/features/landforms/dale.lpc", "east");

    addExit("south", "/areas/argalen-keep/surrounding/12x1.lpc");
    addExit("north", "/areas/argalen-keep/surrounding/12x3.lpc");
    addExit("west", "/areas/argalen-keep/surrounding/11x2.lpc");
    addFeature("/lib/environment/features/paths/dirt-road.lpc", "west");
    addExit("east", "/areas/argalen-keep/surrounding/13x2.lpc");
    addFeature("/lib/environment/features/paths/dirt-road.lpc", "east");
}
