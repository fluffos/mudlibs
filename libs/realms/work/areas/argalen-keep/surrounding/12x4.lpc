inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/village.lpc");
    addBuilding("/lib/environment/buildings/homes/wooden-house.lpc", "west");
    addBuilding("/lib/environment/buildings/shops/blacksmith.lpc", "east",
        "/areas/argalen-keep/surrounding/blacksmith/0x0.lpc");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");
    addItem("/lib/environment/items/lighting/lantern.lpc", "east");

    addDecorator("village north-south road");

    addExit("south", "/areas/argalen-keep/surrounding/12x3.lpc");
    addExit("north", "/areas/argalen-keep/surrounding/12x5.lpc");
}
