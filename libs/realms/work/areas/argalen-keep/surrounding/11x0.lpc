inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "southwest");
    addFeature("/lib/environment/features/trees/maple-stand.lpc", "northwest");
    addFeature("/lib/environment/features/landforms/dell.lpc", "west");
    addFeature("/lib/environment/features/water/brook.lpc", "north");

    addExit("east", "/areas/argalen-keep/surrounding/12x0.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "east");
}
