inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/keep.lpc");
    addFeature("/lib/environment/features/landforms/hill.lpc", "north");
    addItem("/lib/environment/items/lighting/lit-torch.lpc", "east");
    addItem("/lib/environment/items/lighting/lit-torch.lpc", "west");

    addDecorator("village keep gate");

    addExit("south", "/areas/argalen-keep/surrounding/12x7.lpc");
    addExit("north",
        "/areas/argalen-keep/keep-interior/5x0.lpc");
}
