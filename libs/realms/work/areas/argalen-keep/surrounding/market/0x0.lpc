inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/wood-interior-shop.lpc");
    addItem("/lib/environment/items/lighting/window.lpc", "south");
    addItem("/lib/environment/items/furniture/counter.lpc", "north");
    addItem("/lib/environment/items/furniture/small-shelf.lpc", "east");
    addItem("/lib/environment/items/furniture/small-shelf.lpc", "west");
    addShop("/lib/environment/shopInventories/apothecary.lpc");

    addObject("/areas/argalen-keep/surrounding/characters/marta/marta.lpc");

    addExitWithDoor("west", "/areas/argalen-keep/surrounding/13x5.lpc");
}
