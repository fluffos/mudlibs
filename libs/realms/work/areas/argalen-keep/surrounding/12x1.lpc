inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/ash-stand.lpc", "east");
    addFeature("/lib/environment/features/water/brook.lpc", "northwest");

    addExit("south", "/areas/argalen-keep/surrounding/12x0.lpc");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "south");
    addExit("north", "/areas/argalen-keep/surrounding/12x2.lpc");
    addFeature("/lib/environment/features/paths/cobblestone-road.lpc", "north");
    addExit("west", "/areas/argalen-keep/surrounding/11x1.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "west");
    addExit("east", "/areas/argalen-keep/surrounding/13x1.lpc");
    addFeature("/lib/environment/features/paths/trail.lpc", "east");
}
