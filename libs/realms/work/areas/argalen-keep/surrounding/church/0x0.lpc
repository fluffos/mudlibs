inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setInterior("/lib/environment/interiors/stone-temple.lpc");
    addItem("/lib/environment/items/lighting/stained-glass-window.lpc", "west");
    addItem("/lib/environment/items/lighting/stained-glass-window.lpc", "east");
    addItem("/lib/environment/items/furniture/pew.lpc", "south");
    addItem("/lib/environment/items/furniture/pew.lpc", "north");
    addItem("/lib/environment/items/furniture/altar-table.lpc", "north");
    addItem("/lib/environment/items/lighting/candelabra.lpc", "north");

    addObject("/areas/argalen-keep/surrounding/characters/osric/osric.lpc");

    addExitWithDoor("east", "/areas/argalen-keep/surrounding/12x6.lpc");
}
