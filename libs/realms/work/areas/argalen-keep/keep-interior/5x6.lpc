inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/bedroom.lpc");
    addItem("/lib/environment/items/lighting/fireplace.lpc", "north");
    addItem("/lib/environment/items/furniture/canopy-bed.lpc", "west");
    addItem("/lib/environment/items/furniture/armoire.lpc", "east");
    addItem("/lib/environment/items/lighting/candelabra.lpc", "south");
    addDecorator("keep interior north alcove");

    addExitWithDoor("south",
        "/areas/argalen-keep/keep-interior/5x5.lpc");
}
