inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/banquet-hall.lpc");
    addItem("/lib/environment/items/lighting/chandelier.lpc", "north");
    addItem("/lib/environment/items/furniture/long-table.lpc", "south");
    addItem("/lib/environment/items/lighting/fireplace.lpc", "west");
    addDecorator("keep interior north-east corner hallway");

    addExit("east",
        "/areas/argalen-keep/keep-interior/5x3.lpc");
    addExit("north",
        "/areas/argalen-keep/keep-interior/4x4.lpc");
}
