inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/guard-room.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "west");
    addItem("/lib/environment/items/furniture/chest.lpc", "north");
    addDecorator("keep interior north-south hallway");

    addExitWithDoor("south",
        "/areas/argalen-keep/keep-interior/3x2.lpc");
    addExitWithDoor("north",
        "/areas/argalen-keep/keep-interior/3x4.lpc");
}
