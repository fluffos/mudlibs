inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/kitchen.lpc");
    addItem("/lib/environment/items/lighting/hearth.lpc", "east");
    addItem("/lib/environment/items/furniture/cabinet.lpc", "north");
    addItem("/lib/environment/items/furniture/long-table.lpc", "west");
    addDecorator("keep interior south entry alcove");

    addExitWithDoor("south",
        "/areas/argalen-keep/keep-interior/7x2.lpc");
    addExit("north",
        "/areas/argalen-keep/keep-interior/7x4.lpc");
}
