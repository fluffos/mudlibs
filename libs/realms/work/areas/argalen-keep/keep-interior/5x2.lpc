inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/hallway.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "south");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "north");
    addDecorator("keep interior floor");

    addExit("south",
        "/areas/argalen-keep/keep-interior/5x1.lpc");
    addExit("north",
        "/areas/argalen-keep/keep-interior/5x3.lpc");
    addExit("west",
        "/areas/argalen-keep/keep-interior/4x2.lpc");
    addExit("east",
        "/areas/argalen-keep/keep-interior/6x2.lpc");
}
