inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/hallway.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "east");
    addDecorator("keep interior east alcove north-south entry");

    addExitWithDoor("south",
        "/areas/argalen-keep/keep-interior/7x4.lpc");
    addExit("west",
        "/areas/argalen-keep/keep-interior/6x5.lpc");
    addExitWithDoor("north",
        "/areas/argalen-keep/keep-interior/7x6.lpc");
}
