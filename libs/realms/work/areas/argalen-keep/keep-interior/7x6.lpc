inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/bedroom.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "east");
    addItem("/lib/environment/items/furniture/bed.lpc", "north");
    addItem("/lib/environment/items/lighting/lattice-window.lpc", "north");
    addItem("/lib/environment/items/furniture/dresser.lpc", "west");
    addItem("/lib/environment/items/furniture/chest.lpc", "west");
    addDecorator("keep interior northeast corner");

    addExitWithDoor("south",
        "/areas/argalen-keep/keep-interior/7x5.lpc");
}
