inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/library.lpc");
    addItem("/lib/environment/items/lighting/candelabra.lpc", "north");
    addItem("/lib/environment/items/furniture/book-shelf.lpc", "west");
    addItem("/lib/environment/items/furniture/book-shelf.lpc", "east");
    addItem("/lib/environment/items/furniture/writing-desk.lpc", "south");
    addDecorator("keep interior northwest corner");

    addExitWithDoor("south",
        "/areas/argalen-keep/keep-interior/3x5.lpc");
}
