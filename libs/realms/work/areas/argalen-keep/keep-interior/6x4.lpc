inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/hallway.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "east");
    addDecorator("keep interior south T-intersection");

    addExit("west",
        "/areas/argalen-keep/keep-interior/5x4.lpc");
    addExit("east",
        "/areas/argalen-keep/keep-interior/7x4.lpc");
    addExit("south",
        "/areas/argalen-keep/keep-interior/6x3.lpc");
}
