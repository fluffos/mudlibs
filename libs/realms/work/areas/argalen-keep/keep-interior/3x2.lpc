inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/guard-room.lpc");
    addItem("/lib/environment/items/lighting/lit-sconce.lpc", "south");
    addItem("/lib/environment/items/furniture/chest.lpc", "west");
    addDecorator("keep interior west alcove north entry");

    addExit("east",
        "/areas/argalen-keep/keep-interior/4x2.lpc");
    addExitWithDoor("north",
        "/areas/argalen-keep/keep-interior/3x3.lpc");
}
