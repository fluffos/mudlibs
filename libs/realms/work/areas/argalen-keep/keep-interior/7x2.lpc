inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/kitchen.lpc");
    addItem("/lib/environment/items/lighting/hearth.lpc", "north");
    addItem("/lib/environment/items/furniture/cabinet.lpc", "east");
    addDecorator("keep interior east alcove north entry");

    addExit("west",
        "/areas/argalen-keep/keep-interior/6x2.lpc");
    addExitWithDoor("north",
        "/areas/argalen-keep/keep-interior/7x3.lpc");
}
