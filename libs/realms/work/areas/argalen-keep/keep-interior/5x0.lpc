inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/gate-house.lpc");
    addItem("/lib/environment/items/lighting/lit-torch.lpc", "east");
    addItem("/lib/environment/items/lighting/lit-torch.lpc", "west");
    addDecorator("keep interior south gatehouse");

    addExit("south",
        "/areas/argalen-keep/surrounding/12x8.lpc");
    addExit("north",
        "/areas/argalen-keep/keep-interior/5x1.lpc");
}
