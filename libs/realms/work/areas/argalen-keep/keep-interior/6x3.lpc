inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/banquet-hall.lpc");
    addItem("/lib/environment/items/lighting/fireplace.lpc", "east");
    addItem("/lib/environment/items/furniture/buffet.lpc", "north");
    addDecorator("keep interior north-west corner hallway");

    addExit("west",
        "/areas/argalen-keep/keep-interior/5x3.lpc");
    addExit("north",
        "/areas/argalen-keep/keep-interior/6x4.lpc");
}
