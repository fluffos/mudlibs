inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    setStateMachine("/areas/argalen-keep/state-machine/argalen-keep-quest.lpc");

    setInterior("/lib/environment/interiors/banquet-hall.lpc");
    addItem("/lib/environment/items/lighting/chandelier.lpc", "south");
    addItem("/lib/environment/items/furniture/long-table.lpc", "north");
    addDecorator("keep interior floor");

    addExit("south",
        "/areas/argalen-keep/keep-interior/5x2.lpc");
    addExit("west",
        "/areas/argalen-keep/keep-interior/4x3.lpc");
    addExit("east",
        "/areas/argalen-keep/keep-interior/6x3.lpc");
    addExit("north",
        "/areas/argalen-keep/keep-interior/5x4.lpc");
}
