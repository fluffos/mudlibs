/////////////////////////////////////////////////////////////////////////////
public void CreateAegisEquipment(object user)
{
    if (objectp(user))
    {
        object equipment = clone_object("/lib/instances/items/armor/medium-armor/chainmail.lpc");
        equipment.set("craftsmanship", 50);
        equipment.set("name", "aegis chainmail");
        equipment.set("short", "Aegis Chainmail");
        equipment.set("material", "steel");
        equipment->move_object(user);
        user.equip(equipment, 1);

        equipment = clone_object("/lib/instances/items/armor/accessories/boots.lpc");
        equipment.set("craftsmanship", 50);
        equipment.set("armor class", 1);
        equipment->move_object(user);
        user.equip(equipment, 1);

        equipment = clone_object("/lib/instances/items/armor/clothing/cloak.lpc");
        equipment.set("name", "aegis cloak");
        equipment.set("short", "Aegis Cloak");
        equipment.set("craftsmanship", 50);
        equipment.set("armor class", 1);
        equipment->move_object(user);
        user.equip(equipment, 1);

        equipment = clone_object("/lib/instances/items/armor/light-armor/leather-arm-greaves.lpc");
        equipment.set("craftsmanship", 50);
        equipment.set("armor class", 1);
        equipment->move_object(user);
        user.equip(equipment, 1);

        equipment = clone_object("/lib/instances/items/armor/light-armor/leather-leg-greaves.lpc");
        equipment.set("craftsmanship", 50);
        equipment.set("armor class", 1);
        equipment->move_object(user);
        user.equip(equipment, 1);
    }
}
