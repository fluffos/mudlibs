inherit "/lib/items/corpse.lpc";
object bow;

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    set("short", "A decaying corpse");
    set("corpse", "human");
    set("aliases", ({ "decaying corpse", "corpse" }));

    if (!bow)
    {
        clone_object("/lib/instances/items/weapons/bows/bow.lpc")->move_object(this_object());
    }
}
