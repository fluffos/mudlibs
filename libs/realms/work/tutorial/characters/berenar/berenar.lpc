inherit "/lib/realizations/npc.lpc";

/////////////////////////////////////////////////////////////////////////////
protected void Setup()
{
    Name("berenar");
    Gender("male");
    Race("maegenstryd");
    SetUpPersonaOfLevel("swordsman", 3);

    addTrait("/lib/instances/traits/educational/tactician.lpc");

    object equipment = clone_object("/lib/instances/items/weapons/swords/long-sword.lpc");
    equipment->set("craftsmanship", 70);
    equipment->set("material", "meteoric iron");
    equipment->move_object(this_object());
    this_object()->equip(equipment);

    object generator = load_object("/tutorial/characters/aegis-equipment.lpc");
    generator->CreateAegisEquipment(this_object());

    addConversation("/tutorial/characters/berenar/startingConversation.lpc");
}
