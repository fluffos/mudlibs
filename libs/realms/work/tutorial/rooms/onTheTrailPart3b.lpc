inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "north");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "east");

    // First test
    addExit("south", "/tutorial/rooms/onTheTrailPart3.lpc", "on the trail");

    setStateMachine("/tutorial/stateMachines/introStateMachine.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void prodThePlayer()
{
    StateMachine->prodPlayer(this_player(), "thomas", "get moving", "south");
}

/////////////////////////////////////////////////////////////////////////////
public void init()
{
    environment::init();

    if (this_player()->isRealizationOfPlayer() && 
        StateMachine->getCurrentState() == "on the trail")
    {
        call_out("prodThePlayer", 2);
    }
}
