inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "south");

    addExit("west", "/tutorial/rooms/fallenAegis.lpc", "on the trail");
    addExit("south", "/tutorial/rooms/entryPoint.lpc");

    setStateMachine("/tutorial/stateMachines/introStateMachine.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void init()
{
    environment::init();

    catch (add_action("resetEverything", "resetEverything"));
}

/////////////////////////////////////////////////////////////////////////////
public int resetEverything(string command)
{
    write("Resetting all the things!\n");

    object *items = filter(all_inventory(this_object()),
        (: !$1->isRealizationOfLiving() :));
    StateMachine->removeActors();

    foreach(object item in items)
    {
        destruct(item);
    }

    this_player()->resetQuest("/tutorial/stateMachines/introStateMachine.lpc");
    load_object("/tutorial/characters/galadhel/galadhel.lpc")->resetConversationState();
    load_object("/tutorial/characters/berenar/berenar.lpc")->resetConversationState();
    load_object("/tutorial/characters/brendan/brendan.lpc")->resetConversationState();
    load_object("/tutorial/characters/bregar/bregar.lpc")->resetConversationState();

    StateMachine->beginIntroduction(this_player());
    return 1;
}
