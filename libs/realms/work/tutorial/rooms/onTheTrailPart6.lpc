inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/oak-stand.lpc", "south");

    // First test
    addExit("east", "/tutorial/rooms/onTheTrailPart5.lpc", "on the trail");
    addExit("west", "/tutorial/rooms/onTheTrailPart7.lpc", "on the trail");

    setStateMachine("/tutorial/stateMachines/introStateMachine.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void continueOnTrail()
{
    tell_room(this_object(),
        "The sound of a heated conversation can be heard to the west.\n");

    StateMachine->moveSquad("west",
        "/tutorial/rooms/onTheTrailPart7.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void init()
{
    environment::init();

    if (this_player()->isRealizationOfPlayer() &&
        (StateMachine->getCurrentState() == "on the trail") &&
        present("alberich"))
    {
        call_out("continueOnTrail", 0);
    }
}
