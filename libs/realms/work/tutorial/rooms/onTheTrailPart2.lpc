inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/sycamore-stand.lpc", "north");

    // First test
    addExit("south", "/tutorial/rooms/onTheTrailPart1.lpc", "on the trail");
    addExit("northwest", "/tutorial/rooms/onTheTrailPart3.lpc", "on the trail");

    setStateMachine("/tutorial/stateMachines/introStateMachine.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void continueOnTrail()
{
    tell_room(this_object(),
        "A flash of black can be seen to the northwest.\n");
    StateMachine->moveSquad("northwest",
        "/tutorial/rooms/onTheTrailPart3.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void init()
{
    environment::init();

    if (this_player()->isRealizationOfPlayer() &&
        (StateMachine->getCurrentState() == "on the trail") &&
        present("alberich"))
    {
        call_out("continueOnTrail", 0);
    }
}
