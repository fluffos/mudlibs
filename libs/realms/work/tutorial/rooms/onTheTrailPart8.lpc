inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "north");
    addFeature("/tutorial/features/obedience-temple-near.lpc", "north");

    // First test
    addExit("east", "/tutorial/rooms/onTheTrailPart7.lpc", "on the trail");
    addObject("/tutorial/characters/brendan/brendan.lpc", "on the trail");

    setStateMachine("/tutorial/stateMachines/introStateMachine.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void init()
{
    environment::init();

    object brendan = present("brendan");
    if (brendan && this_player() && this_player()->isRealizationOfPlayer() &&
        present(this_player()) && !present("zombie"))
    {
        object keeper = clone_object("/tutorial/characters/keeper-of-the-night.lpc");
        keeper->move_object(this_object());
        keeper->registerEvent(brendan);

        object zombie = clone_object("/tutorial/characters/animated-corpse.lpc");
        zombie->move_object(this_object());
        keeper->registerEvent(zombie);

        this_player()->attack(zombie);

        zombie = clone_object("/tutorial/characters/animated-corpse.lpc");
        zombie->move_object(this_object());
        keeper->registerEvent(zombie);
        if (present("alberich"))
        {
            present("alberich")->attack(zombie);
        }

        zombie = clone_object("/tutorial/characters/animated-corpse.lpc");
        zombie->move_object(this_object());
        keeper->registerEvent(zombie);
        if (present("thomas"))
        {
            present("thomas")->attack(keeper);
        }

        if (present("galadhel"))
        {
            present("galadhel")->attack(keeper);
        }
        if (present("halgaladh"))
        {
            present("halgaladh")->attack(keeper);
        }
        if (present("donald"))
        {
            present("donald")->attack(keeper);
            present("donald")->registerEvent(this_object());
        }
    }
}

/////////////////////////////////////////////////////////////////////////////
public void killPoorBrendan()
{
    object brendan = present("brendan");
    if (brendan)
    {
        brendan->hit(1000, "physical");
    }
}

/////////////////////////////////////////////////////////////////////////////
public void killPoorBregar()
{
    object bregar = present("bregar");
    if (bregar)
    {
        bregar->hit(1000, "physical");
    }
}
