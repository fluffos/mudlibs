inherit "/lib/environment/environment.lpc";

/////////////////////////////////////////////////////////////////////////////
public void Setup()
{
    cloneEnvironment();
    setTerrain("/lib/environment/terrain/forest.lpc");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "west");
    addFeature("/lib/environment/features/trees/cottonwood-stand.lpc", "south");

    // First test
    addExit("east", "/tutorial/rooms/fallenAegis.lpc", "on the trail");
    addExit("north", "/tutorial/rooms/onTheTrailPart2.lpc", "on the trail");
    addExit("south", "/tutorial/rooms/onTheTrailPart1b.lpc", "on the trail");

    setStateMachine("/tutorial/stateMachines/introStateMachine.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void continueOnTrailPart2()
{
    StateMachine->moveSquad("north",
        "/tutorial/rooms/onTheTrailPart2.lpc");
}

/////////////////////////////////////////////////////////////////////////////
public void continueOnTrail()
{
    StateMachine->beginConversation("baddies went north");
    call_out("continueOnTrailPart2", 0);
}

/////////////////////////////////////////////////////////////////////////////
public void init()
{
    environment::init();

    if (this_player()->isRealizationOfPlayer() &&
        (StateMachine->getCurrentState() == "on the trail") &&
        present("alberich"))
    {
        call_out("continueOnTrail", 0);
    }
}
