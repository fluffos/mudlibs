###############################################################################
#              Customizable runtime config file for MudOS v22                 #
###############################################################################

# name of this mud
name : RealmsMUD

# port number to accept users on
port number : 40215

# absolute pathname of mudlib
mudlib directory : /home/sunyc/src/mudlib/libs/realms/work

# debug.log and author/domain stats are stored here
log directory : /log

# the directories which are searched by #include <...>. Upstream computed
# this dynamically per-file via its own H_INCLUDE_DIRS driver hook
# (checking /include, /lib/include, /sys in order -- see
# secure/master/hooks.lpc's port notes); this driver has no such
# per-compile hook, so the same three paths are listed statically here
# instead (a colon-separated list, per this driver's own config parser).
include directories : /include:/lib/include:/sys

# The global include file is included automatically before every compile.
# This upstream repo has no single such header (LDMud's own config script
# doesn't use one) -- FluffOS requires SOME real file here (omitting the
# key defaults to an empty-but-non-null value that the driver still tries
# to #include, producing "Cannot read #include file"). Pointed at a new,
# essentially-empty placeholder added for this port, same pattern as
# genesis's /secure/auto.h.
global include file : "/secure/auto.h"

# Directory to save binaries in.  (if BINARIES is defined)
save binaries directory : /binaries

# the file which defines the master object
master file : /secure/master

# the file where all global simulated efuns are defined.
simulated efun file : /secure/simul_efun

# alternate debug.log file name (assumed to be in specified 'log directory')
debug log file : debug.log

time to clean up : 50000
time to swap : 5000
time to reset : 900
maximum bits in a bitfield : 1200
maximum local variables : 40
# Raised well above this project's usual default (5000000): this is a much
# larger codebase than anything else in this collection (16,570 files),
# and its own preload chain (secure/master/preload.lpc's
# traverseDirectoryForSourceFiles(), recursively walking /lib's ~3,180
# files at boot) hit "Too long evaluation" at the default value.
maximum evaluation cost : 100000000
maximum array size : 25000
maximum buffer size : 600000
maximum mapping size : 100000
inherit chain size : 60
maximum string length : 300000
maximum read file size : 300000
maximum byte transfer : 10000
hash table size : 7001
object table size : 1501
default fail message : What?
default error message : Something is wrong.

maximum users : 200
evaluator stack size : 1000
compiler stack size : 200
maximum call depth : 30
living hash table size : 256
