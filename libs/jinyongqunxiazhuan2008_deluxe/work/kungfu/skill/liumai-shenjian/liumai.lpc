//Cracked by Roath
//liumai.c 六脉齐发 

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target)
{
	string weapon;
	object weapon1;
	int    lvl1, lvl2, amount;

	if ( userp(me) && !wizardp(me) && (me->query("family/family_name") != "天龙寺"))
	  	return notify_fail("你不是天龙寺弟子，无法施展「六脉齐发」。\n");
	
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("六脉齐发只能对战斗中的对手使用。\n");

	weapon1 = me->query_temp("weapon");
        if( objectp(weapon1) )
                return notify_fail("你并非空手，如何使得六脉齐发？\n");

	if( userp(me) && !wizardp(me) && me->query_skill("kurong-changong", 1) < 120 )
		return notify_fail("你的枯荣禅功火候未到，无法施展六脉齐发！\n");

  if( me->query_skill("liumai-shenjian", 1) < 120 )
		return notify_fail("你的六脉神剑火候未到，无法施展六脉齐发！\n");

	lvl1=me->query_skill("force");

	lvl2=me->query_skill("finger");

	amount = (lvl1+lvl2) / 15;

	if ( amount < 40 ) amount = 40;
	if ( amount > 80 ) amount = 80;

	if( me->query("neili") <= amount*4 )
		return notify_fail("你的内力不够使用六脉齐发！\n");
	
	weapon = me->query_temp("weapon");

	me->add_temp("apply/damage", amount);
	me->add_temp("apply/attack", amount*2);
	me->add_temp("apply/dodge", amount*2);

	message_vision(HIY "\n$N微微一笑「"+RED"干你妹子哟！"+HIY"」,六道无形剑气顷刻间向$n汹涌而来！\n\n" NOR, me, target);

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->start_busy(random(2));
	me->add_temp("apply/damage", -amount);
	me->add_temp("apply/attack", -amount*2);
	me->add_temp("apply/dodge", -amount*2);
	me->add("neili", -amount*2);
	return 1;
}
