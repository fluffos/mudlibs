// lingxi.c  如意刀 [苍天有泪]

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int count;

  if ((me->query("family/family_name") != "逍遥派"))
    return notify_fail("你不是逍遥派弟子，无法施展「苍天有泪」。\n");
  if (!me->is_fighting())
    return notify_fail("「苍天有泪」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_dex() < 30)
    return notify_fail("你的身法不够, 目前还不能使用「苍天有泪」! \n");

  if ((int)me->query_skill("beiming-shengong", 1) < 100)
    return notify_fail("你的北冥神功的修为不够, 无法使用「苍天有泪」 !\n");

  if ((int)me->query_skill("dodge") < 120)
    return notify_fail("你的轻功修为不够, 不能使用「苍天有泪」！\n");

  if ((int)me->query_skill("blade") < 120)
    return notify_fail("你的刀法修为不够， 目前不能使用「苍天有泪」! \n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的真气不够！\n");


  msg = HIG "$N使出如意刀的绝技「苍天有泪」，身法陡然加快！\n" NOR;
  message_vision(msg, me);

  me->clean_up_enemy();
  ob = me->select_opponent();

  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  me->add("neili", -100);
  me->start_busy(random(2));

  return 1;
}
