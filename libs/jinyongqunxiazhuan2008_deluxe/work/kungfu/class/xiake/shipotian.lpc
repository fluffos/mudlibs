// sample master.c code
// xiake island master.c

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("石破天", ({ "shi potian", "shi", "potian" }));
  set("nickname", HIM "大粽子" NOR);
  set("gender", "男性");
  set("title", "狗杂种");
  set("age", 20);
  set("long",
    "这是一个憨厚的小伙子。\n");
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("jingli", 5000);
  set("max_jingli", 5000);
  set("neili", 60000);
  set("max_neili", 30000);
  set("jing", 150000);
  set("max_jing", 150000);
  set("qi", 150000);
  set("max_qi", 150000);
  set("jiali", 300);
  set("food", 1000);
  set("water", 1000);
  set("combat_exp", 25000000);
  set("score", 500000);

  set_skill("force", 500);
  set_skill("taixuan-gong", 500);
  set_skill("unarmed", 450);
  set_skill("dodge", 450);
  set_skill("parry", 450);

  map_skill("force", "taixuan-gong");
  map_skill("unarmed", "taixuan-gong");
  map_skill("dodge", "taixuan-gong");
  map_skill("parry", "taixuan-gong");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.shibu" :),
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
  create_family("侠客岛", 2, "弟子");
}

void attempt_apprentice(object ob) {
  command("sigh");
  command("say 我哪有本领教你呢？");
}
