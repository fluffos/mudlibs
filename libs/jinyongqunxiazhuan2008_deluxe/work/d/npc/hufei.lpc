// hufei.c
#include <ansi.h>
inherit NPC;
string ask_me();
void do_kill(object ob);

void create()
{
	set_name("胡斐", ({"hu fei", "hu", "fei"}));
	set("gender", "男性");
	set("nickname", HIW"雪山飞狐"NOR);
	set("age", 25);
	set("long", 
		"他就是胡一刀之子，因其武功高强神出鬼没。\n"
		"在江湖上人送外号「雪山飞狐」。\n"
		"他身穿一件白色长衫，腰间别着一把看起来很旧的刀。\n"
		"他满腮虬髯，根根如铁，一头浓发，却不结辫。\n");
	set("attitude", "peaceful");
	set("str", 45);
	set("int", 30);
	set("con", 30);
	set("dex", 30);
	set("chat_chance", 30);
	set("chat_msg", ({
		"胡斐叹了口气道:“不知什么时候还能再见到若兰姑娘。”\n",
		"胡斐说道：“谁愿意为闯王宝藏添金加银，在下愿意指点他一些武功。”\n",
		"胡斐说道：“在下家传的胡家刀法乃是天下最威猛的刀法！”\n",
		"胡斐恨恨道：“苗人凤是我杀父仇人，我必报此仇！”\n",
	//	(: random_move :),
	}));
	set("shen",50000);
	set("qi", 3000);
	set("max_qi", 3000);
	set("jing", 1000);
	set("max_jing", 1000);
	set("jingli",500);
	set("max_jingli",500);
	set("neili", 4500);
	set("max_neili", 3000);
	set("jiali", 100);
	set("combat_exp", 830000);
	set("score", 20000);
	set("food",800);
	set("water",800);
	set_skill("force", 160);             // 基本内功
	set_skill("hujia-daofa", 190);    // 胡家刀法	
	set_skill("blade", 190);           // 基本刀法
	set_skill("yunlong-xinfa", 150);   // 云龙心法
	set_skill("yunlong-shengong",150); //云龙内功
	set_skill("dodge", 180);           // 基本躲闪
	set_skill("feihu-shenfa", 180);   // 飞狐身法
	set_skill("parry", 170);         // 基本招架
	set_skill("unarmed",150);
	set_skill("changquan",150);
	map_skill("force", "yunlong-shengong");
	map_skill("unarmed", "changquan");
	map_skill("blade", "hujia-daofa");
	map_skill("dodge", "feihu-shenfa");
	map_skill("parry", "hujia-daofa");
   	set("inquiry",([
		"宝刀": (: ask_me :),
             	]));
	set("baodao_count",1);
  set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "blade.ddjx" :),
		(: exert_function, "recover" :),
	}) );
	setup();
	carry_object(__DIR__"obj/daopu");
	carry_object(__DIR__"obj/cwbdao")->wield();
    carry_object("/d/city/obj/cloth")->wear();
 
}

string ask_me()
{
	
	
	object ob, me;
	
	me = this_player();
	if((int)me->query("shen") < 0)
	{
//		me->set_leader(ob);
		call_out("do_kill",1,this_player());
	}
	else if((int)(me->query("shen")<100000))
	    return "以你目前的作为是不能拿这把刀的。\n";

   	else if((int)(me->query("shen") > 100000))
	{
		if(query("baodao_count") > 1){		
    		call_out("waiting",0,me,ob);
			add("baodao_count", -1);
    		ob = new ("/d/npc/obj/cwbdao");
    		ob->move(this_player());
			return " 好吧，这把闯王宝刀就赠与你，希望你好好利用它。\n";
		}
		else return "你来晚了, 现在这把刀已不在此处。\n";
	}

}

void do_kill(object ob)
{
	object me, room1;       
    me = this_object();
    room1 = environment(me);
 
    if (room1->query("no_fight"))
	    room1->set("no_fight", 0);
 
    if (interactive(ob))
    {
        command("say 你这恶贼竟敢打我宝刀的主意, 给我纳命来！\n");
        me->set_leader(ob);
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
    }
 
}	
int recognize_apprentice(object ob)
{
	if (!(int)ob->query_temp("mark/胡"))
		return 0; 
	ob->add_temp("mark/胡", -1);
	return 1;
}

int accept_object(object who, object ob)
{
	if (!(int)who->query_temp("mark/胡"))
		who->set_temp("mark/胡", 0);
	if (ob->query("money_id") && ob->value() >= 5000) {
		message_vision("胡斐同意指点$N一些问题。\n", who);
		who->add_temp("mark/胡", ob->value() / 250);
		return 1;
	}
	return 0;
}