inherit NPC;

void create()
{
	set_name("明教弟子", ({ "di zi" }) );
	set("gender", "男性" );

	set("age", 20);
	set("long", "这是一名普通的明教弟子。\n");
	set("shen_type",1);
	set("combat_exp", 20000);

	set("attitude", "peaceful");

	set("apply/attack", 50);
	set("apply/defense", 50);

  set("neili",200);
  set("max_neili",200);
	set_skill("unarmed", 50);
	set_skill("blade", 50);
	set_skill("parry", 50);
	set_skill("dodge", 50);

	setup();
	carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/gangdao")->wield();
	add_money("silver", 10);
}

