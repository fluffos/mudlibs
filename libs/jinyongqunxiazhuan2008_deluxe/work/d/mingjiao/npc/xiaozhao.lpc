// xiaozhao.c 俞小昭
#include <ansi.h>
inherit NPC;

void create() {
  set_name("俞小昭", ({ "yu xiaozhao", "yu", "xiaozhao" }));
  set("gender", "女性");
  set("nickname", HIG "混血美女" NOR);
  set("age", 17);
  set("long",
    "她是一位漂亮的混血小姑娘，脚上套着牢固的镣铐。\n");
  set_temp("apply/defense", 5);
  set("combat_exp", 10000);
  set("shen", 100);
  set("shen_type", 1);
  set("str", 18);
  set("dex", 19);
  set("con", 16);
  set("int", 28);
  set("neili", 300);
  set("max_neili", 300);
  set("attitude", "friendly");
  set_skill("force", 30);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set_skill("literate", 50);
  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 10);
}
