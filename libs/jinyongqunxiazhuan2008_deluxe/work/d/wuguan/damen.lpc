inherit ROOM; 

void create() 
{
	set("short", "连城武馆大门"); 
	set("long",@LONG
这是一间气势宏大的武馆，大门洞开着，门口蹲踞着两个
威猛的石狮子，门上的牌匾写着“连城武馆”。武馆里传来一阵阵练武的声音。
据说这个武馆已经有近百年的历史了。
LONG);
       
        set("exits",([
        "west" : "/d/wuguan/lianwuchang",
        "north": "/d/quanzhou/xijie",
        ])); 
	
        setup(); 
	
} 
