inherit ITEM;
void setup() {}
void init() {
  add_action("do_du", "study");
}
void create() {
  set_name("六脉神剑谱", ({ "liumai jianpu", "jianpu", }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "此乃大理天龙寺无上绝学《六脉神剑谱》。\n");
    set("value", 30000);
    set("material", "paper");
    set("no_drop", "这样东西不能离开你。\n");
    set("no_give", "这样东西不能给人。\n");
  }
}
int do_du(string arg) {
  object me = this_player();
  object where = environment(me);
  mapping skill;
  int liumailvl;
  int neili_lost;

  if (!(arg == "liumai jianpu" || arg == "jianpu"))
    return 0;

  if (where->query("pigging")) {
    write("你还是专心拱猪吧！\n");
    return 1;
  }
  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }

  if (!id(arg)) {
    write("你要读什么？\n");
    return 1;
  }

  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学点文化(literate)吧。\n");
    return 1;
  }
  if ((int)me->query_skill("kurong-changong", 1) < 100) {
    write("你的枯荣禅功修为不够，无法读懂六脉神剑谱。\n");
    return 1;
  }

  message("vision", me->name() + "慌慌张张翻出一本书在读。\n", environment(me), me);

  if ((int)me->query("jing") < 15) {
    write("你现在过于疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  if (me->query_skill("liumai-shenjian", 1) > 84) neili_lost = 15;
  else if (me->query_skill("liumai-shenjian", 1) > 74) neili_lost = 10;
  else neili_lost = 5;


  if ((int)me->query("neili") < neili_lost) {
    write("你内力不够，无法钻研这么高深的武功。\n");
    return 1;
  }

  liumailvl = me->query_skill("liumai-shenjian", 1);
  if ((int)me->query("combat_exp") < (int)liumailvl * liumailvl * liumailvl / 10) {
    write("你的实战经验不足，再怎么读也没用。\n");
    return 1;
  }

  if (me->query_skill("liumai-shenjian", 1) > 99) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }

  me->receive_damage("jing", 15);
  me->set("neili", (int)me->query("neili") - neili_lost);
  if (!me->query_skill("liumai-shenjian", 1)) {
    me->set_skill("liumai-shenjian", 0);
    write("                   《六脉神剑谱》阅读指南\n"
      "\n    恭喜你开始研习六脉神剑谱！\n"
      "         祝你早日成为武林第一高手，称霸天下！\n");
  }
  me->improve_skill("liumai-shenjian", (int)me->query_skill("literate", 1) / 3 + 1);
  write("你研读《六脉神剑谱》，似乎有点心得。\n");
  return 1;
}
