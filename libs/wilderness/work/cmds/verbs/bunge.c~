inherit NVERB_OB;
inherit M_MESSAGES;
inherit M_GRAMMAR;

mixed do_bunge()
{
  write("You feel a tearing pain in your rear.\n");
}

mixed do_bunge_liv(object ob) {
  string *msgs;
  object *who = ({ this_body(), ob });
  if (ob == this_body())
    do_bunge();
  else {
    msgs = action(who, "$N $vbunge $t...ouch!");
    msgs[2] = this_body()->query_name() + " bunges " +
      ob->query_name() + ".  Looks like it hurt!\n";
    inform(who, msgs, environment(this_body()));
  }
}

mixed do_bunge_obj(object ob)
{
  if (!(ob->bunge()))
    { 
      write("You bunge " + ob->query_name() + ".\n");
    }
}

void create() {
  add_rules ( ({ "", "LIV", "OBS", "OBJ" }) );
}

