inherit NVERB_OB;
inherit M_MESSAGES;
inherit M_GRAMMAR;

void create() {
  add_rules ( ({ "", "OBJ", "LIV" }) );
}

mixed can_squish_liv() {
  return 1;
}

void do_squish() {
  write("You squish a passing-by ant.  Meanie!\n");
}

void do_squish_obj(object ob)
{
  write("You squish the " + ob->short() + " a bit.\n");
}

void do_squish_liv(object liv)
{
  if (ob->short() != "Sammy")
    write("I don't think that " + liv->query_name() + " would like it if you"
	+ " squished him.\n");
  else
    write("Sammy happily compresses himself into a spring and bounces around.\n");
}



