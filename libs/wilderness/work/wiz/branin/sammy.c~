inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("Sammy");
  add_id("snake", "sammy");
  set_adj("fuzzy");
  set_gender(1);
  set_proper_name("Sammy Snake");
  set_in_room_desc("A large green fuzzy snake purrs in the corner.");
  set_long("Sammy looks at you with wide eyes. Apparently he is simply a four foot long snake, looking very much like a miniature boa constrictor. However, instead of dry cold scales, he is covered in a warm and soft looking green fuzz. Yellow spots of varying sizes adorn his fur coat. Coiled up into a spring, he is large, fuzzy, and very adorable. He looks up at you with intelligent eyes, his black pupils moving around in their yellow orbs. A small forked tongue occasionally pops out as he purrs at you.");

  set_actions( 20,
	       ({ "emote purrs contentedly at you.",
		  "emote hops up and down happily.",
		  "emote bounces around the room energetically.",
		  "say Meep Meep!",
		  "emote begins to read a story book.",
		  "emote holds a quill in his mouth and begins to write a note.",
		  "emote flops around and rolls on the floor.",
		  "emote looks at you and meeps happily.",
		  "emote looks for a moogle to play with.",
		  "emote lies down, curls up, and takes a cat nap."
		 }) );

  set_max_health(32000);
  set_combat_messages("poke");
  set_skills( ([ "poke":50,
	       "dodge":10,
	       ])
	      );
  set_attributes( 15, 90, 60, 95, 10, 10, 10, 10, 10 );
  set_dmg( ([ "fluffy" : ({ 1, 1, 0 }) ]) );
  set_weapon_skill("poke");
}
