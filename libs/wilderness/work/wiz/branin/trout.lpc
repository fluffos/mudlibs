
inherit FOOD;

void setup()
{
  set_id("trout");
  set_adj("wet");
  set_long("The trout is around 36 inches long and still wiggles every now and then. It is clearly almost dead. At least it hasn't begun to smell. You seem to recall an ancient Nihhon recipe involving raw fish, but the exact details escape you.");

  set_num_eats(6);
  set_eat_action("$N $vtake a bite from the fresh trout.");
  set_last_eat_action("$N $veat the last of $p trout.");
  set_stamina_gain( ({ ({ 3, 6, 1 }) }) );
}
