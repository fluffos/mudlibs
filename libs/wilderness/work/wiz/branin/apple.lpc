inherit FOOD;

void setup()
{
    set_id("apple");
    set_adj("red");
    set_long("The apple is a typical red apple. It is large and appears to be quite ripe and juicy. The skin of the apple is devoid of any spots, bruises, or blemishes.");

    set_num_eats(2);
    set_eat_action("$N $vtake a bite from an apple.");
    set_last_eat_action("$N $veat the last of $p apple.");
    set_stamina_gain( ({ ({ 1, 8, 1 }),
			 ({ 1, 6, 0 })
		    }) );
}
