
inherit WEAPON;

void setup()
{
  set_id("dagger");
  set_adj("rondel", "steel", "shiny");
  set_proper_name("a shiny steel rondel dagger");
  set_combat_messages("piercing");
  set_weapon_skill("piercing");
  set_in_room_desc("A shiny rondel style dagger lies on the floor.");
  set_long("The dagger is a finely crafted example of a rondel style piercing weapon. The handle is covered in a sheath of nicely polished dark wood, and the dagger itself is one whole piece of steel. The blade is a bit more than a foot long, and it reinforced with a thick T-shaped ridge. The blade has been polished to a brilliant sheen.");

  set_dmg( ([ "piercing" : ({ 2, 20, 0 })
	    ])
	   );
  set_size(SMALL);
  set_weight(100);
}

