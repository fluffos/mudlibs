inherit ROOM;

void setup()
{
  set_light(1);
  set_brief("Sammy's Lair");

  set_long("Inside a large square shaped room is a bed of soft green grass. Sunlight pours down through the open ceiling, lighting up the emerald grass and several luscious fruit trees. Small mounds of earth dot the room, each with a hole in its top. Occasional meeps can be heard emanating from the ground.");

  add_item("tree", "The fruit trees appear to be all peaches or pears. Most of the fruit appears to be missing. The large profusion of rinds and cores lying shriveled on the ground suggests the culprits are still nearby.");

  add_item("mound", "Each mound is only a foot high, and covered in grass. It appears they are very old for the grass to be growing on them. A large burrow entrance about a half foot wide rests in the middle of each mound. You hear a distant meeping sound coming from the tunnel.");

  set_objects( ([
		 "/wiz/branin/sammy.lpc" : 1,
		 "/wiz/branin/apple.lpc" : 2,
		 "/wiz/branin/trout.lpc" : 3,
		 "/wiz/branin/demon.lpc" : 1
                ])
	       );

  set_exits( ([ "south":"/wiz/branin/workroom.lpc",
		"east":"/wiz/mog/workroom.lpc"
	      ])
	     );

}
