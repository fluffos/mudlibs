
inherit ROOM;

void setup()
{
  set_light(1);
  set_brief("Branin's Study");

  set_long("The walls are made of oak and the floor is carpetted in a thick furry layer of bear skins. A fireplace is in one of the walls, and emits a cheery glow all over the room. The air is warm and comfortable. A chair and a desk lie to one side of the room, and the walls are almost completely obscured by many bookshelves containing many old books.");

  add_item("papers", "The papers contains several essays Branin has written to his fellow Gods in an effort to secure their efforts to shape their new world. Apparently Branin has been moderately successful.");

  add_item("scrolls", "The scrolls outline a detailed plan for the creation of Branin's new world. Plans of battle, of the human race, and the new world lay scattered all over the desk. Branin has a large plan indeed for shaping the Wilderness.");

  add_item("desk", "The desk is make of oak, and contains a great many drawers. Several papers and scrolls have been left on the desk, as well as an inkwell and several quills. A large green fuzzy snake hops across the desk occasionally.");

  add_item("chair", "The chair is comfortable for a larger person. Made out of hickory, this is most definitely an unusual chair. It would appear to be most comfortable due to the profusion of soft pillows and cushions upon its body. Branin must be one lucky God to have created such a fine chair.");

  add_item("quill", "The feather this quill is made of is a shiny golden color. It obviously did not come from any kind of bird. It must be a feather from some historic beast from the prehistoric times of the Wilderness.");

  add_item("inkwell", "The inkwell is made of a crystal clear glass pot with a gold and silver stand. Tiny diamonds, sapphires, rubies, and emeralds decorate the stand at various points. The craftsmanship of the stand is very precise and fine. Perhaps Branin himself created this work of art.");

  add_item("shelves", "The books contained in the shelves are widely varied, ranging from simple philosophy all way way to mathematics and magic. Most are quite large and made out of expensive paper. Looking at the size of Branin's study, his library is worth quite a fortune!");

  add_item("bookshelves", "The books contained in the shelves are widely varied, ranging from simple philosophy all way way to mathematics and magic. Most are quite large and made out of expensive paper. Looking at the size of Branin's study, his library is worth quite a fortune!");

  set_objects( ([
                 "/wiz/branin/sammy.c" : 1,
		 "/wiz/branin/crystal_sword.c" : 1,
		 "/wiz/branin/broadsword.c" : 1,
		 "/wiz/branin/flaming_zweihander.c" : 1,
		 "/wiz/branin/black_mace.c" : 1,
		 "/wiz/mog/scimitar.c" : 1,
		 "/wiz/branin/zanza.c" : 1,
		 "/wiz/branin/rondel.c" : 1,
		 "/std/portal.c" : ({ "/wiz/kesrin/fronthall.c", "A swirling maelstrom of color."})

                 ]) );

  set_exits( ([ "south":"/domains/std/Wizroom.c",
                "north":"/wiz/branin/lair.c" ]) 
	     );

}
