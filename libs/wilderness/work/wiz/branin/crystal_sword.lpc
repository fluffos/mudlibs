
inherit WEAPON;

string random_in_room_desc();
string random_long_desc();
string get_random_color();

void setup()
{
  set_id("sword");
  set_adj("crystal", "transparent", "translucent");
  set_proper_name("a transparent crystal sword");
  set_combat_messages("edged");
  set_weapon_skill("edged");
  set_in_room_desc( (: random_in_room_desc :) );
  set_long( (: random_long_desc :) );

  set_dmg( ([ "edged" : ({ 6, 8, 8 }),
	    "magic" : ({ 1, 12, 0 }),
	    ])
	   );
  set_size(MEDIUM);
  set_weight(100);
}

string random_in_room_desc()
{
  string s = "A translucent crystal sword lies on the ground. It pulses off " + get_random_color() + " light.";
  return s;
}

string random_long_desc()
{
  string s = "The sword is composed of one large transparent blade of pure crystal. Almost like a lance, the blade is wide at the base, and tapers off into a razor sharp point. A frosted glass or crystal handle extends from the base of the blade. The handle is quite rough and feels quite secure in your hands. The sword pulses in various colors, the streaks of light running up from the base to the tip, where they wink out in a small pin prick of light. As you gaze at the weapon, you see colors wash up the blade, ";

  for (int i=0; i < 10; i++)
    {
      if (i == 9)
	s += "and ";

      s += get_random_color();

      if (i != 9)
	s += ", ";
    }

  s += ".";
  return s;
}

string get_random_color()
{
  string c;

  switch(random(7))
    {
    case 0:
      c = "red";
      break;
    case 1:
      c = "orange";
      break;
    case 2:
      c = "yellow";
      break;
    case 3:
      c = "green";
      break;
    case 4:
      c = "blue";
      break;
    case 5:
      c = "purple";
      break;
    case 6:
      c = "white";
      break;
    }

  return c;
}
