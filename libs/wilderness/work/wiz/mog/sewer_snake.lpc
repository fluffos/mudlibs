inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("The sewer snake");
  add_id("sewer snake", "snake");
  set_adj("long");
  set_gender(2);
  set_proper_name("a sewer snake");
  set_in_room_desc("A sewer snake looks unkindly at your intrusion.");
  set_long("\nYou hear a rippling sound accompanied by a slight hissing, announcing the presence of a rather large snake.\n\n");
  set_weight(2000);
  set_actions( 21,
	       ({ "emote hisses menacingly.",
		  "emote coils itself, waiting for an opening.",
		  "emote watches you warily.",
		  "emote stares at you with it's hypnotic eyes.",
		 }) );
  set_skills ( ([ "dodge" : 75,
		  "fang" : 85,
 		])
	       );
  set_max_health(120);
  set_wander_area("Sewer1", "Sewer2", "Sewer3", "Sewer4", "Sewer5", "Sewer6", "Sewer7", "Sewer8", "Sewer9");
  set_attributes ( 55, 47, 65, 53, 20, 10, 13, 11, 30);
  set_dmg( ([ "fang" : ({ 2, 4, 4 }) ]) );
  set_weapon_skill("fang");
  add_block ("east");
  add_block ("up");
  set_block_action("emote hisses warningly.");
}
