inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("A rabbit");
  add_id("rabbit");
  set_adj("cute", "fuzzy", "blue");
  set_gender(1);
  set_proper_name("a fuzzy rabbit");
  set_in_room_desc("The rabbit nibbles on something, obliviously..");
  set_long("\nThe rabbit has blue fur on its body and a cute white puff for a tail.  It has two almost vestigial teeth in front.  Its ears twitch this way and that.");
  set_actions( 21,
	       ({ "emote hums cutely to itself.",
		  "emote winks at you.",
		  "emote bounces up and down.",
		  "say Let's sing!"
		 }) );
  set_skills ( ([ "dodge" : 40,
		  "bite" : 45,
 		])
	       );
  set_max_health(20);
  set_attributes ( 17, 28, 46, 53, 20, 22, 5, 13, 12);
  set_dmg( ([ "bite" : ({ 2, 2, 0 }) ]) );
  set_weapon_skill("bite");
}
