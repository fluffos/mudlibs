inherit ROOM;

void setup()
{
  set_area("Sewer1");
  set_light(1);
  set_brief("A Sewer");
  set_state_description( "darkness_off", "You cannot see beyond the inky blackness.");
  set_state_description( "darkness_on", "$darkness2");
  set_state_description( "darkness2_off", "You cannot see beyond the inky blackness.");
  set_state_description( "darkness2_on", "You see murky, green water and closely fitted stone walls all around.");
  set_long("$darkness");
  set_default_error("Ouch!  You don't seem to be able to that.\n");
  set_objects( ([ "/wiz/mog/sewer_snake.lpc" : 1,
		  "/wiz/mog/sewer_rat.lpc" : 1,
                 ]) );
  set_exits( ([ "up" : "#You can't reach the hole from which you fell.\n", 
		"north" : "/wiz/mog/Sewer2.lpc",
		"east" : "/wiz/mog/Sewer3.lpc",
		"south" : "/wiz/mog/Sewer4.lpc",
		"west" : "/wiz/mog/Sewer5.lpc",
		]) );
}

void do_listen()
{
  write ("The sound of water is all around you.\n");
}
