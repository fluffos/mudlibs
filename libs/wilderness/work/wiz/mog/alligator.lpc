inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("An alligator");
  add_id("alligator", "gator");
  set_adj("scaly");
  set_gender(1);
  set_proper_name("an allligator");
  set_in_room_desc("The alligator seems just like a large log with eyes.");
  set_long("\nYou really wouldn't be able to tell if it were alive except for the fact that it emits sounds now and again.\n\n");
  set_weight(21000);
  set_actions( 21,
	       ({ "emote floats toward you.",
		  "emote watches you warily.",
		  "emote stares at you with its dead eyes.",
		 }) );
  set_skills ( ([ "dodge" : 55,
		  "fang" : 75,
 		])
	       );
  set_max_health(320);
  set_wander_area("Sewer1", "Sewer2", "Sewer3", "Sewer4", "Sewer5", "Sewer6", "Sewer7", "Sewer8", "Sewer9");
  set_attributes ( 70, 64, 35, 20, 23, 16, 5, 12, 67);
  set_dmg( ([ "fang" : ({ 5, 6, 3 }) ]) );
  set_weapon_skill("fang");
  add_block ("east");
  set_block_action("emote silently but firmly blocks your way.");
}
