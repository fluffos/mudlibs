inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("Sammy");
  add_id("snake", "sammy");
  set_adj("fuzzy");
  set_gender(1);
  set_proper_name("Sammy Snake");
  set_in_room_desc("A large green fuzzy snake purrs in the corner.");
  set_long("\nSammy looks at you with wide eyes. Coiled up into a spring, "
           "he is large, fuzzy, and very adorable. A small forked tongue "
	   "occasionally pops out as he purrs.\n\n");

  set_actions( 20,
	       ({ "emote purrs contentedly at you.",
		  "emote hops up and down happily.",
		  "emote bounces around the room energetically.",
		  "say Meep Meep!",
		  "emote begins to read a story book.",
		  "emote holds a quill in his mouth and begins to write a note.",
		  "emote flops around and rolls on the floor.",
		  "emote looks at you and meeps happily."
		 }) );
}
