inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("A puffball");
  add_id("puffball");
  set_adj("cute", "furry", "pink");
  set_gender(2);
  set_proper_name("a cute puffball");
  set_in_room_desc("The puffball bounces happily from side to side..");
  set_long("\nThe puffball is about a half-foot in diameter.  It has short, pink fuzz about its body.");

  set_actions( 21,
	       ({ "emote hums cutely to itself.",
		  "emote winks at you.",
		  "emote bounces up and down.",
		  "say Let's sing!"
		 }) );
  set_skills ( ([ "dodge" : 25,
		  "poke" : 60,
 		])
	       );
  set_max_health(10);
  set_attributes ( 10, 10, 40, 37, 58, 22, 5, 13, 5);
  set_dmg( ([ "poke" : ({ 1, 1, 0 }) ]) );
  set_weapon_skill("poke");
}
