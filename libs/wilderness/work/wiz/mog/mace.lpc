
inherit WEAPON;

void setup()
{
  set_id("mace");
  add_adj("flaming");
  set_proper_name("a flaming steel mace");
  set_combat_messages("combat-torch");
  set_weapon_skill("blunt");
  set_in_room_desc("A mace lies on the ground, flames wrapped around its head.");
  set_long("\nAn otherwise normal mace lies on the ground. However, its metal head lies wrapped in a thick sheet of lames. The wooden handle appears untouched by the intense head emanating from the head.\n\n");
  set_dmg( ([ "blunt" : ({ 3, 12, 4 })
	    ])
	   );
  set_size(MEDIUM);
}

