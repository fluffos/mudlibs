inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("A minotaur");
  add_id("minotaur");
  set_adj("giant", "monstrous");
  set_gender(1);
  set_proper_name("a minotaur");
  set_in_room_desc("The minotaur watches you closely.");
  set_long("\nThe minotaur is wielding a heavy axe.  He has two large horns and two bull feet and a ring in his nose.");
  set_actions( 21,
	       ({ "emote stares at you.",
		  "emote stomps his feet.",
		  "emote growls menacingly.",
		  "say You will never find your way out!"
		 }) );
  set_skills ( ([ "dodge" : 50,
		  "axe" : 65,
 		])
	       );
  set_max_health(1000);
  set_attributes ( 90, 75, 50, 41, 54, 30, 36, 22, 72);
  set_dmg( ([ "axe" : ({ 4, 8, 3 }) ]) );
  set_weapon_skill("axe");
}
