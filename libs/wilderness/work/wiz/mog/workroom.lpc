inherit ROOM;

void setup()
{
  set_light(1);
  set_brief("Mog's Room");
  set_long("The room has a comfortable atmosphere.  A plush, three-foot tall easy-chair is sitting in one corner.  A small desk is in another corner with a small radio playing some music.  There are some stairs in the corner.  $trap_door");
  add_item("desk", "\nThe desk appears to be made out of solid mahogony.  While the desk appears to be orderly, there is a cluster of papers around the base, strewn about.");
  add_item("papers", "\nSome of the papers seem to outline the use of various magicks.  While looking through the papers, you discover a small trapdoor!");
  add_item("radio", "\nThe radio is playing classical music.  The station appears to be fixed in place, the knob broken off.  Apparently, Mog doesn't allow anyone to mess with his music...");
  add_item("chair", "\nThe chair looks really comfortable.");
  add_item("easy chair", "\nThe chair looks really comfortable.  The floor creaks a bit when you try to sit down.");
  add_item("stairs", "\nThe stairs go up to a quiet little loft.");
  set_state_description( "trap_door_off", "");
  set_state_description( "trap_door_on", "There is an open trapdoor near the desk.");
  set_exits( ([ "west":"/wiz/branin/lair.lpc",
		"east":"/wiz/mog/Arena.lpc",
                "up":"/wiz/mog/clubhouse.lpc" ]) 
	     );
  set_default_error("Ouch!  That really hurt.\n");
  set_objects( ([
                 "/wiz/mog/moogle.lpc" : 1,
		 "/domains/std/trap_door" : ({ "down", "/wiz/mog/Secret_Forest" })
                 ]) );

}

void do_listen()
{
  write ("The music from the radio soothes your troubled mind.\n");
}
