inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("A sewer rat");
  add_id("sewer rat", "rat");
  set_adj("filthy");
  set_gender(1);
  set_proper_name("a sewer rat");
  set_in_room_desc("The sewer rat is covered with lice and grime.");
  set_long("\nThe sewer rat seems to be patrolling its territory, fiercely....\n\n");
  set_weight(150);
  set_actions( 21,
	       ({ "emote stares at you.",
		  "emote watches you warily.",
		  "emote hisses at you warningly.",
		 }) );
  set_skills ( ([ "dodge" : 87,
		  "teeth" : 90,
 		])
	       );
  set_max_health(80);
  set_wander_area("Sewer1", "Sewer2", "Sewer3", "Sewer4", "Sewer5", "Sewer6", "Sewer7", "Sewer8", "Sewer9");
  set_attributes ( 32, 46, 50, 46, 23, 16, 5, 12, 10);
  set_dmg( ([ "teeth" : ({ 4, 2, 1 }) ]) );
  set_weapon_skill("teeth");
  add_block ("east");
  set_block_action("emote gnashes its teeth at you.");
}
