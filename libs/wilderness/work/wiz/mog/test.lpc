/* Do not remove the headers from this file! see /USAGE for more info. */

inherit INDOOR_ROOM;


void setup()
{
  set_area("mog_room");
  set_brief("Mog's Room");
  set_long("This is Mog's Room.  A small radio plays soft classical music.");
  set_exits( ([ "west":"/domains/std/Wizroom.lpc" ]) );
  set_default_error("Ouch!  That really hurt.\n");
  set_exit_msg( "west", ({ "$N $vhop west.", "$N $vbound out." }));
  set_enter_msg( "west", ({ "$N $vdecide to pop in for a visit." }) );
}

void do_listen()
{
  write ("The music from the radio soothes your troubled mind.\n");
}


