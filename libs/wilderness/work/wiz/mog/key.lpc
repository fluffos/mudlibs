inherit KEY;

void mudlib_setup()
{
    ::mudlib_setup();
    set_id("key");
    set_adj("shiny", "gold");
    set_proper_name("a gold key");
    set_long("\nThe gold key is very shiny.  The name 'Mog' appears along the length.\n");
    set_in_room_desc("A shiny key is sitting on the ground.");
    set_key_type("mugumugu");    
}
