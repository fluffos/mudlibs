inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("Kurin");
  add_id("moogle", "kurin", "Kurin");
  set_adj("cute");
  set_gender(1);
  set_proper_name("Kurin Moogle");
  set_in_room_desc("A small, white moogle is sitting on the floor, looking at you.");
  set_long("\nKurin has short, white fur and small, red bat wings.\n\n");

  set_actions( 21,
	       ({ "emote squeaks.",
		  "emote jumps up and down.",
		  "emote watches you curiously.",
		  "emote dances a jig.",
		  "say Kupo!"
		 }) );
  set_skills ( ([ "jump" : 100,
		  "dodge" : 95,
		  "spear" : 85,
 		])
	       );
  set_max_health(777);
  set_wander_area("clubhouse");
  set_attributes ( 30, 40, 65, 77, 50, 30, 35, 45, 30);
  set_dmg( ([ "edged" : ({ 4, 5, 1 }) ]) );
  set_weapon_skill("spear");
}
