/* Do not remove the headers from this file! see /USAGE for more info. */

inherit WEAPON;

void mudlib_setup()
{
    ::mudlib_setup();
    set_id("lance");
    set_adj("holy", "white");
    set_proper_name("an aura lance");
    set_combat_messages("piercing");
    set_weapon_skill("piercing");
    set_long("The spear is as light as air, made of some material you can't identify.  A pleasant glow comes from deep within.");
    set_in_room_desc("A glowing spear is lying here.  It is warm to the touch.");
    set_size(MEDIUM);
    set_weight(100);
    set_dmg( ([ "piercing" : ({ 8, 5, 5 }),
		"holy light" : ({ 10, 10, 10 })
	      ])
	     );
    add_combat_message("miss", "$N $vmiss, leaving behind a white afterimage.");
}
