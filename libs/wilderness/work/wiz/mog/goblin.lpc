inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("A goblin");
  add_id("goblin");
  set_adj("ugly", "warty");
  set_gender(1);
  set_proper_name("an ugly goblin");
  set_in_room_desc("The goblin is looking for a good fight.");
  set_long("\nThe goblin has a large nose and head.  Large, bulbous purple warts cover his face and hands.");

  set_actions( 21,
	       ({ "emote growls at you, indelicately.",
		  "emote bares its teeth at you.",
		  "emote watches you warily.",
		  "say C'mon!  Fight!"
		 }) );
  set_skills ( ([ "dodge" : 40,
		  "goblin punch" : 65,
 		])
	       );
  set_max_health(40);
  set_attributes ( 40, 65, 35, 57, 51, 30, 42, 40, 48);
  set_dmg( ([ "punch" : ({ 3, 2, 0 }) ]) );
  set_weapon_skill("goblin punch");
}
