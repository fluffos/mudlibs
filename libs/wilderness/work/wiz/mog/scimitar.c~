inherit WEAPON;

void mudlib_setup()
{
    ::mudlib_setup();
    set_id("scimitar");
    set_adj("holy", "mithril");
    set_proper_name("a gleaming mithril scimitar");
    set_combat_messages("edged");
    set_weapon_skill("edged");
    set_long("The scimitar has excellent balance.  The silvery blade has a reassuring glow.");
    set_in_room_desc("A brilliant silver scimitar is lying here.  It emits an aura of holiness.");
    set_size(MEDIUM);
    set_weight(200);
    set_dmg( ([ "edge" : ({ 7, 7, 7 }),
		"holy light" : ({ 7, 7, 7 })
	      ])
	     );
    add_combat_message("miss", "$N $vmiss, somehow, leaving behind a trail of sparkles.");
}
