inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("The kitten");
  add_id("The kitten");
  set_adj("tiny", "black");
  set_gender(2);
  set_proper_name("The tiny kitten");
  set_in_room_desc("A tiny kitten is sitting in the corner, watching you with a wary look.");
  set_long("\nThe tiny kitten appears to be about 2 pounds in weight\n\n");
  set_weight(200);
  set_actions( 21,
	       ({ "emote mews softly.",
		  "emote begins purring.",
		  "emote watches you warily.",
		  "emote begins licking its fur.",
		 }) );
  set_skills ( ([ "dodge" : 50,
		  "claw" : 85,
 		])
	       );
  set_max_health(100);
  set_wander_area("clubhouse");
  set_attributes ( 10, 12, 30, 35, 23, 30, 35, 20, 10);
  set_dmg( ([ "edged" : ({ 2, 2, 1 }) ]) );
  set_weapon_skill("claw");
}
