{
  set_area("Secret_Forest");
  set_light(1);
  set_brief("Mog's Secret Forest");
  set_state_description( "trap_door_off", "closed");
  set_state_description( "trap_door_on", "open");
  set_long("This is a beautiful garden.  There are tall fir and pine trees all around.  A rope ladder leads to a tiny wooden trapdoor.  The trapdoor above you is $trap_door.");
