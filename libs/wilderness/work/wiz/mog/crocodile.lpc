inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("A crocodile");
  add_id("croc", "crocodile");
  set_adj("scaly");
  set_gender(2);
  set_proper_name("a crocodile");
  set_in_room_desc("The crocodile seems just like a large log with eyes.");
  set_long("\nYou can't really identify anything about this creature except that it seems like a log.\n\n");
  set_weight(20000);
  set_actions( 21,
	       ({ "emote floats toward you.",
		  "emote watches you warily.",
		  "emote stares at you with its dead eyes.",
		 }) );
  set_skills ( ([ "dodge" : 55,
		  "fang" : 70,
 		])
	       );
  set_max_health(300);
  set_wander_area("Sewer1", "Sewer2", "Sewer3", "Sewer4", "Sewer5", "Sewer6", "Sewer7", "Sewer8", "Sewer9");
  set_attributes ( 70, 64, 35, 20, 23, 16, 5, 12, 65);
  set_dmg( ([ "fang" : ({ 5, 6, 3 }) ]) );
  set_weapon_skill("fang");
  add_block ("east");
  set_block_action("emote floats to block your exit.");
}
