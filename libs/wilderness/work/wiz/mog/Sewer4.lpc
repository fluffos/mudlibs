inherit ROOM;

void setup()
{
  set_area("Sewer4");
  set_light(1);
  set_brief("A Sewer");
  set_state_description( "sewer_grate_off", "a closed");
  set_state_description( "sewer_grate_on" , "an open");
  set_state_description( "darkness_off", "You cannot see beyond the inky blackness.");
  set_state_description( "darkness_on", "You see murky, green water and closely fitted stone walls all around.  In the faint light, there appears to be $sewer_grate sewer grate on the south wall.");
  set_long("$darkness");
  set_default_error("Ouch!  You don't seem to be able to that.\n");
  set_objects( ([ "/wiz/mog/sewer_rat.lpc" : 2,
		  "/domains/std/sewer_grate.lpc" : ({ "south", "/wiz/mog/Arena.lpc" })
                 ]) );
  set_exits( ([ "north" : "/wiz/mog/Sewer1.lpc",
		"west" : "/wiz/mog/Sewer8.lpc", 
		]) );
}

void do_listen()
{
  write ("The sound of water is all around you.\n");
}

void arrived() {
  clear_room_state("sewer_grate");
}
