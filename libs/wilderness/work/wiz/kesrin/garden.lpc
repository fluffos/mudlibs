inherit ROOM;

void setup(){
    set_light(1);
    set_brief("Kesrin's Garden");
    set_long(
"This garden is walled on 3 sides, with the doorway back to the dojo on the fourth side.  A small lake is in the center of this garden, with fish of some sort swimming about in it.  Trees grow all around the garden, as if to shelter the lake from the rest of the world."
);
    add_item("lake", "The lake is shallow, only maybe waist-height at the deepest point, and the water is tranquil and clear.  Occasionally a koi fish can be seen swimming in the water.\n");

    add_item("trees", "The trees are mostly pine, although here and there a cherry tree grows, full of pink blossoms even through it is not the season for them.\n");

    set_exits( (["west":"/wiz/kesrin/dojo.lpc"]) );
    set_objects( ([ "/wiz/kesrin/koi.lpc" : 1,
    ]) );
}
