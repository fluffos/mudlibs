inherit FOOD;

void setup() {
  set_id("bass");
  set_adj("slimy");
  set_long("This bass is heavier than the trout you've seen lying around.  It's a little shorter, but fatter.  It's also quite more dead than the trout, starting to smell from decay.  You should probably cook this soon.");

  set_num_eats(3);
  set_eat_action("$N $vtake a bite out of the slimy bass.");
  set_last_eat_action("$N $vfinish off the last pieces of $p bass.");
  set_stamina_gain( ({ ({ 3, 6, 0 }) }) );
}
