/* Do not remove the headers from this file! see /USAGE for more info. */

inherit WEAPON;

void mudlib_setup()
{
    ::mudlib_setup();
    set_id("sword");
    set_adj("damascus", "steel");
    set_proper_name("a damascus steel tai-chi sword");
    set_combat_messages("weapon");
    set_weapon_skill("edged");
    set_long("A straight tai-chi sword, the blade is made of damascus steel, mottled in the many layers.  A large red tassel adorns the brass hilt.");
    set_in_room_desc("a straight edged sword");
    set_size(MEDIUM);
    set_weight(200);
    set_dmg( ([ "edge" : ({ 12, 12, 12 }),
		"follow up" : ({ 6, 6, 6 })
	      ])
	     );
    add_combat_message("miss", "$N $vmiss, but still $vlook graceful doing it!");
}
