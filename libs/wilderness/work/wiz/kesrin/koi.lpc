inherit WANDERING_MONSTER;
inherit M_BLOCKEXITS;
inherit M_ACTIONS;

void setup()
{
  set_name("a koi fish");
  add_id("koi", "fish");
  set_gender(1);
  set_proper_name("a koi fish");
  set_in_room_desc("A brilliantly colored fish can be seen in the lake from "
                   "time to time.");
  set_long("\nA bright orange and white fish, over a foot in length, swims "
	   "lazily in the pond.  When startled, it can move very quickly, "
	   "though!\n\n");

  set_actions( 30,
	       ({ "emote splashes on the surface",
		  "emote swims about looking for food",
		  "emote drifts lazily about"
		 }) );

  set_max_health(32000);
  set_combat_messages("fish");
  set_skills( ([ "splash":99,
               "dodge":99,
               ])
              );
  set_attributes( 90, 90, 90, 90, 90, 90, 90, 90, 1 );
  set_dmg( ([ "fins" : ({ 0, 0, 0 }) ]) );
  set_weapon_skill("splash");

}
