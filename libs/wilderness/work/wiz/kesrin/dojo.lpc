  set_brief("Kesrin's Dojo");

  set_long("This room is spacious, with wooden floors, and wood-frame walls with papyrus stretched tight across the frames.  A pair of swords are crossed across one wall, and a large wooden training dummy sits in a corner.  The east wall has a sliding door opening to a small garden, while the opposite wall has a small archway leading further into the building.");

