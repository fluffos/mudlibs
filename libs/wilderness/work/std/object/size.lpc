/* Do not remove the headers from this file! see /USAGE for more info. */

private nosave int obj_size = MEDIUM;
private nosave int weight = 0;

//:FUNCTION get_size
//get_size() returns the size of an object
int get_size()
{
  return obj_size;
}

int get_weight()
{
  return weight;
}

//:FUNCTION set_size
//set_size(s) sets the size of an object to 's'
void set_size(int s)
{
  obj_size = s;
}

void set_weight(int w)
{
  weight = w;
}
