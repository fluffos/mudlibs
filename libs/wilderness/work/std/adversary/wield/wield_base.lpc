/* Do not remove the headers from this file! see /USAGE for more info. */

private mapping dmg = ([ "blunt" : ({ 1, 2, 0 }) ]);
private string weapon_skill = "hand to hand";

int do_wield(object);

void set_dmg(mapping input)
{
  dmg = input;
}

void set_weapon_skill(string input)
{
  weapon_skill = input;
}

mapping query_dmg()
{
  return dmg;
}

string query_weapon_skill()
{
  return weapon_skill;
}

int set_wielding(string wep)
{
   object ob = new(wep);

   if(!ob)
      return 0;
   ob->move(this_object());
   return do_wield(ob);
}
