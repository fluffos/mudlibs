#include <classes.h>

inherit CLASS_SKILL;

private mapping skills = ([ ]);

mapping query_skills()
{
    return skills;
}

void set_skills(mapping input)
{
  skills = input;
}

int get_skill(string skill)
{
    return skills[skill];
}

void increase_skill(string skill, int increase)
{
  skills[skill] += increase;
}

void set_skill(string skill, int value)
{
  skills[skill] = value;
}
