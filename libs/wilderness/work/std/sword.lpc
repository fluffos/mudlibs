/* Do not remove the headers from this file! see /USAGE for more info. */

inherit WEAPON;

void mudlib_setup()
{
    ::mudlib_setup();
    set_id("sword");
    set_adj("plain, old");
    set_proper_name("a rusty sword");
    set_combat_messages("edged");
    set_damage_type("blade");
    set_weapon_skill("edged");
    set_long("\nThe old sword is about three feet in length.  It appears to be barely usable, covered in patches of rust.\n\n");
    set_in_room_desc("A rusty sword lies on the ground.  It looks like it might fall apart at the slightest stress.");
    set_size(MEDIUM);
    set_dmg( ([ "edge" : ({ 2, 8, 1 })
	      ])
	     );
    add_combat_message("miss", "The poorly made sword throws $N off-balance.");
}
