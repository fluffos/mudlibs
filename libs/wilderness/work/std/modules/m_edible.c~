private int num_eats = 1;
private int original_eats;
private mixed eat_action = "$N $veat $o.";
private mixed last_eat_action;

// Stamina gain is defined in an array of arrays. Each array in the main array
// is of size 3. These represent the dice to be rolled, and the constant to
// be added. This way, you can have food with an arbitrary number and types
// of dice.
private int* stamina_gain = ({ ({ 1, 1, 0 }) });

string the_short();

//:FUNCTION set_eat_action
//set_eat_action(string) causes 'string' to be printed when someone
//eats this object.  set_eat_action(function) causes the function
//to be called instead.
void set_eat_action(mixed action) {
    eat_action = action;
}

//:FUNCTION set_last_eat_action
//Just like set_eat_action, but only is used for the last eat
void set_last_eat_action(mixed action) {
    last_eat_action = action;
}

//:FUNCTION set_num_eats
//num_eats is the number of eats left before the object is empty.
void set_num_eats(int num)
{
  original_eats = num;
  num_eats = num;
}

void set_stamina_gain(int* input)
{
  stamina_gain = input;
}

int* get_stamina_gain()
{
  return stamina_gain;
}

int get_num_eats()
{
  return num_eats;
}

int get_original_eats()
{
  return original_eats;
}

mixed direct_eat_obj()
{
  if (!num_eats)
    return capitalize(the_short()) + " is gone.\n";

  return 1;
}

void do_eat()
{
    mixed action;
    int st_gain = 0;
    
    // This code gives the user stamina back for eating food. It must be
    // called before the object is possibly destructed, or a runtime
    // error will occur.

    // This loop is called once for each sub-array in the main array.
    // Each sub-array represents a set of dice, a number of sides on
    // each dice, and a constant to be added to the total.
    for (int i=0; i < sizeof(stamina_gain); i++)
      {
	// Call contents of this loop once for each dice set to be rolled,
	// i.e. the first element in the sub-array of size 3.
	for (int j=0; j < stamina_gain[i,,0]; j++)
	  {
	    // Roll the dice with number of sides equal to second
	    // entry in sub-array.
	    st_gain += random(stamina_gain[i,,1]) + 1;
	  }
	
	// Add in the constant stored in the third entry in the
	// sub-array
	st_gain += stamina_gain[i,,2];
      }

    // Increase our stamina by the amount indicated rolled.
    this_body()->stamina_us(st_gain);

    if( num_eats == 1 )
    {
	if(last_eat_action)
	  action = last_eat_action;
	else action = eat_action;
	if( stringp( action ))
	    this_body()->simple_action( action, this_object());
	else evaluate( action );
	this_object()->remove();
    }
    else
    {

	if (stringp(eat_action))
	    this_body()->simple_action(eat_action, this_object());
	else
	    evaluate(eat_action);

	num_eats--;
    }
}
