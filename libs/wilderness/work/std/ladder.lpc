/* Do not remove the headers from this file! see /USAGE for more info. */

inherit STAIRS;

string look_in_desc;

void more_create(mixed up_dest, mixed down_dest, int attached) {
    setup_messages("ladder", up_dest, down_dest);
}
void set_look_in_desc(string s)
{
    look_in_desc = s;
}
    
string get_look_in_desc()
{
    return evaluate(look_in_desc);
}
 
string look_in(string prep)
{
    return evaluate(look_in_desc);
}

mapping lpscript_attributes() {
    return ([
      "look_in_desc" : ({ LPSCRIPT_STRING, "setup", "set_look_in_desc" })
    ]);
}

void set_destination(mixed f)
{
  add_method("climb",f);
}

string get_destination()
{
  return query_method_destination("climb");
}

varargs void mudlib_setup(string destination, string look_desc)
{
    ::mudlib_setup();
    set_id( "ladder" );
    set_attached( 1 );
    if ( destination ) add_method( "climb", destination );
    if (look_desc) look_in_desc = look_desc; 
    set_base((:environment():) );
}

