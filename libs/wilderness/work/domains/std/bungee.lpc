
#include <mudlib.h>

inherit OBJ;
inherit M_GETTABLE;

void setup()
{
  set_id("cord", "coil", "rope", "bungee");
  set_adj("bungee");
  set_long("This is a coiled up bundle of bungee rope.");
  set_droppable(1);
}

int bunge()
{
  if (environment(this_object()) == this_body())
    write("You bunge yourself with the cord.  It hurts.\n");
  else
    write("You'll have to get it first before you can play.\n");

  return 1;
}
