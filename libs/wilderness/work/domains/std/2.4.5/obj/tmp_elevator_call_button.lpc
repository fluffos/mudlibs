#pragma no_warnings
inherit "/std/object";

mixed _where;
void setup(string w);
mixed do_press();
mixed direct_press_obj();

void setup(string w) {
function f;
set_flag(0 | ATTACHED);
set_adj("elevator");
set_id("button");
{
_where = w
;
}
;
}


mixed do_press() {
{
call_other("/domains/std/2.4.5/elevator.scr", "call_elevator",_where);
call_other(environment(this_object()), "set_room_state","lamp");
return 1;;
}
;
}


mixed direct_press_obj() {
{
return 1;;
}
;
}

