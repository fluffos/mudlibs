inherit OBJ;
inherit M_DIGGER;
inherit M_GETTABLE;
inherit M_INPUT;

/* Two inherits define lpscript_attributes(); the later one was already in effect: name it. */
mapping lpscript_attributes() { return m_gettable::lpscript_attributes(); }

void setup()
{
  set_adj("plastic");
  set_id("shovel");
  set_long ("It's a plastic shovel.");
  set_size (SMALL);
}
