/* Do not remove the headers from this file! see /USAGE for more info. */

inherit HIDDEN_DOOR;
inherit M_LOCKABLE;

void do_on_open()
{
    ::do_on_open();
    environment( this_object())->set_room_state( "sewer_grate");
}

void do_on_close()
{
    ::do_on_close();
    environment( this_object())->clear_room_state( "sewer_grate");
}

void on_clone(mixed args...)
{
    ::on_clone(args...);
    if( is_open() ) do_on_open();
    else do_on_close();
}

void setup(string dir, string room, string lock)
{
    set_id("sewer grate");
    set_adj("metal", "rusty", "rusty, metal");
    set_long("It is about 3 feet wide.");
    setup_door("sewer grate", dir, room);
    set_locked(lock);
}
