/* Do not remove the headers from this file! see /USAGE for more info. */

inherit HIDDEN_DOOR;


void do_on_open()
{
    ::do_on_open();
    environment( this_object())->set_room_state( "trap_door");
}

void do_on_close()
{
    ::do_on_close();
    environment( this_object())->clear_room_state( "trap_door");
}

void on_clone(mixed args...)
{
    ::on_clone(args...);
    if( is_open() ) do_on_open();
    else do_on_close();
}

void setup(string dir, string room)
{
    set_id("trapdoor");
    set_adj("tiny", "wooden", "tiny, wooden");
    set_long("It is about 2 feet wide.");
    setup_door("trap_door", dir, room);
}
