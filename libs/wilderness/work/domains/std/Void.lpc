/* Do not remove the headers from this file! see /USAGE for more info. */

#include <mudlib.h>

inherit INDOOR_ROOM;

void setup(){

    /* ensure this place is lit, regardless of DEFAULT_LIGHT_LEVEL */
    set_light(1);

    set_brief("The Void");
    set_long("You float in an inky black darkness. For some reason, you can actually see yourself, but you cannot see anything in the distance. Occasially, a wispy tendril of smoke will waft by your face, and then disappear, never to be seen again. A short distance in front of you, a circular portal floats in the 'air'. Despite your attempts to turn, the portal always remains in front of you. You are not sure if you simply cannot turn, or if the portal moves with you.");

    set_objects( (["/std/portal.lpc" : ({ "/wiz/branin/workroom.lpc", "A swirling maelstrom of color. From somewhere inside, a meeping snake can be heard."})
		  ])
		 );
}
