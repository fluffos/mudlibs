###############################################################################
#     Customizable runtime config file for FluffOS -- Wilderness            #
###############################################################################
# Wilderness runs on the LIMA mudlib codebase (secure/check_config.lpc
# confirms it via the same driver-flag self-test as libs/lima -- see
# NOTES.md). Modeled on libs/lima/config.fluffos for the same architecture;
# this lib REQUIRES the special ~/src/fluffos-lima driver worktree, not the
# project's shared ~/src/fluffos/build-debug -- see NOTES.md for why and how
# to boot it.

name : Wilderness

port number : 40251

mudlib directory : /home/sunyc/src/mudlib/libs/wilderness/work

# log directory resolves against the driver's launch CWD, not the mudlib
# directory -- always launch via `cd libs/wilderness && driver config.fluffos`
log directory : /log

global include file : <global.h>

debug log file : execute
include directories : /include

master file : /secure/master
simulated efun file : /secure/simul_efun

save binaries directory : /secure/binaries

time to clean up : 7200
time to swap : 1800
time to reset : 1800

maximum bits in a bitfield : 1200
maximum local variables : 30
maximum evaluation cost : 5000000
maximum array size : 15000
maximum buffer size : 400000
maximum mapping size : 15000
# Wilderness's std/body.lpc composes several dozen feature modules
# (std/adversary's death/health/wield/armor/pulse/blows/formula/advancement
# submodules alone, plus body/*'s ~20 more) -- this counts every distinct
# object load in one recursive load session, not linear inherit depth, and
# legitimately needs to be much higher than lima's borrowed default of 30
# (hit "Inherit chain too deep: > 30" creating the very first player body).
inherit chain size : 300
maximum string length : 200000
maximum read file size : 200000
maximum byte transfer : 10000

reserved size : 0

mudlib error handler : 1
