inherit NPC;
#include <ansi.h>
void create()
{
   set_name("铁木真",({"tiemuzhen"}));
   set("gender","男性");
      set("long","铁木真是蒙古草原的英雄!\n");
   set("shen",25000);
   set("combat_exp",500000);
     set("age",45);
    set("food",250);
    set("water",250);
   set("neili",2500);
   set("max_neili",2500);
   set("force_factor",60);

   set_skill("dodge",160);
   set_skill("force",160);
   set_skill("parry",160);
   set_skill("unarmed",160);
   set_skill("blade", 200);


	setup();
   carry_object("clone/weapon/gangdao")->wield();
   carry_object("clone/cloth/cloth")->wear();
	add_money("gold",10);
}

