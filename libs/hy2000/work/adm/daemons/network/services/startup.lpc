#include <net/dns.h>
#include <net/macros.h>

inherit F_CLEAN_UP;
inherit F_DBASE;

void incoming_request(mapping info) {
  if (!ACCESS_CHECK(previous_object()))
    return;

  if (stringp(info["NAME"])) {
    PING_A->incoming_request(info);
    PING_Q->incoming_request(info);
  }
}
void create() {
  seteuid(ROOT_UID);
  set("channel_id", "网路连通精灵");
}
