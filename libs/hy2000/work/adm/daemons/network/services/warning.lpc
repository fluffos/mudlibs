#include <mudlib.h>
#include <net/macros.h>

inherit F_CLEAN_UP;

void incoming_request(mapping info) {
  string warn;

  if (!ACCESS_CHECK(previous_object()))
    return;

  warn = "DNS warning from " + info["NAME"] + info["MSG"] + " Fakehost: " + info["FAKEHOST"];
  dns_log("dns_warning", warn);
}
