#include <comando.h>

int comando(int argc, string *argv) {
  int size;
  string str, *clases;

  write("Ficha de " + capitalize(TP->nombre_q()) + ",\n");
  write("Raza: " + capitalize(TP->raza_q()) + "\n");
  size = sizeof(clases = TP->clase_q());
  for (int i = 0; i < size; i++) {
    clases[i] = capitalize(clases[i]);
  }
  if (size > 1) write("Multiclase: ");
  else write("Clase: ");
  write(capitalize(implode(clases, "/")) + "\n");
  write("Nivel: " + TP->nivel_q() + " (");
  str = "";
  foreach (string clase in clases) {
    str += "/" + (string)TP->nivel_q(lower_case(clase));
  }
  write(str[1..] + ")\n");
  write("Gremio: " + TP->gremio_q() + "\n");
  write("Fuerza: " + TP->fue_q() + "\n");
  write("Destreza: " + TP->des_q() + "\n");
  write("Constitucion: " + TP->con_q() + "\n");
  write("Inteligencia: " + TP->tel_q() + "\n");
  write("Sabiduria: " + TP->sab_q() + "\n");
  write("Carisma: " + TP->car_q() + "\n");
  write("Experiencia: " + TP->xp_q() + " de " + TP->xp_total_q() + " puntos conseguidos.\n");
  return 1;
}
