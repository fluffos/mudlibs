private nosave mapping feats = ([]);

void create() {
  feats["alertness"] = 1;
  feats["animal affinity"] = 1;
  feats["light armor proficiency"] = 1;
  feats["medium armor proficiency"] = (: TP->feat_q("light armor proficiency") ? 1 : 0 :);
  feats["heavy armor proficiency"] = (: TP->feat_q("medium armor proficiency") ? 1 : 0 :);
  feats["augment summoning"] = (: TP->feat_q("spell focus") ? 1 : 0 :);
  feats["blind fight"] = 1;
  feats["combat casting"] = 1;
  feats["combat expertise"] = (: TP->tel_q() >= 13 ? 1 : 0 :);
  feats["improved disarm"] = (: ((TP->tel_q() >= 13) && (TP->feat_q("combat expertise"))) ? 1 : 0 :);
  feats["improved feint"] = (: ((TP->tel_q() >= 13) && (TP->feat_q("combat expertise"))) ? 1 : 0 :);
  feats["improved trip"] = (: ((TP->tel_q() >= 13) && (TP->feat_q("combat expertise"))) ? 1 : 0 :);

  /* Falta prereq attack bonus = +4 */
  /* Quitamos -> spring attack y mobility */
  feats["whirlwind attack"] = (: ((TP->dex_q() >= 13) && (TP->tel_q() >= 13) && (TP->feat_q("combat expertise")) && (TP->feat_q("dodge"))) ? 1 : 0 :);

  feats["deceitful"] = 1;
  feats["deft hands"] = 1;
  feats["diligent"] = 1;
  feats["dodge"] = (: TP->des_q() >= 13 ? 1 : 0 :);
  feats["diehard"] = 1; /* pre: endurance */ feats["eschew materials"] = 1;

  /* pre: Base attack bonus = +1 */
  feats["exotic weapon proficiency"] = (: TP->tel_q() >= 13 ? 1 : 0 :);

  /* ... */
}

void debug() {
  printf("%O\n", feats);
}

int requisitos_q(string feat) {
  if (!feats[feat]) return 0;
  else return evaluate(feats[feat]);
}

string *feats_q() {
  return keys(feats);
}
