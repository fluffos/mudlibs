#include <mudlib.h>
#include <daemons.h>
#include <danos.h>
#include <tablas.h>
#include <mensajes.h>

inherit DAEMON;

private nosave mapping iniciativas = ([]);
private nosave object *en_lucha = ({});
private nosave object *pendientes = ({});

void ejecutar_ataque(object);
void unir_pendientes_a_lucha();
void start_fight(object, object);
int calcular_iniciativa(object);
private void limpiar_combatientes();

void start() {
  set_heart_beat(1);
}

void stop() {; }

private void limpiar_combatientes() {
  object *vivos;
  mapping nuevas;
  int iniciativa;

  vivos = ({});
  foreach (object luchador in en_lucha) {
    if (objectp(luchador)) vivos += ({ luchador });
  }
  en_lucha = vivos;

  vivos = ({});
  foreach (object p in pendientes) {
    if (objectp(p)) vivos += ({ p });
  }
  pendientes = vivos;

  nuevas = ([]);
  foreach (iniciativa in keys(iniciativas)) {
    vivos = ({});
    foreach (object a in iniciativas[iniciativa]) {
      if (objectp(a)) vivos += ({ a });
    }
    if (sizeof(vivos)) nuevas[iniciativa] = vivos;
  }
  iniciativas = nuevas;
}

void heart_beat() {
  int *lista_iniciativas;

  limpiar_combatientes();

  /* Unimos a la lucha a los combatientes pendientes */
  if (sizeof(pendientes) != 0) {
    unir_pendientes_a_lucha();
  }
  lista_iniciativas = (int *)keys(iniciativas);
  lista_iniciativas = sort_array(lista_iniciativas, -1);
  foreach (int iniciativa in lista_iniciativas) {
    foreach (object atacante in iniciativas[iniciativa]) {
      if (objectp(atacante)) ejecutar_ataque(atacante);
    }
  }
  foreach (object luchador in en_lucha) {
    if (objectp(luchador)) tell_object(luchador, "\n");
  }
}

int calcular_iniciativa(object personaje) {
  /* Aplicar bonificadores del personaje */
  return efun::call_other(DADO, "lanzar", 1, 20);
}

void start_fight(object atacante, object victima) {
  /* Los nuevos combatientes entraran en lucha en el proximo heart beat,
     * para no interferir en el transcurso del turno actual.
     */
  if (!objectp(atacante) || !objectp(victima)) return;
  if ((member_array(atacante, en_lucha) == -1) && (member_array(atacante, pendientes) == -1)) {
    pendientes += ({ atacante });
  }
  if ((member_array(victima, en_lucha) == -1) && (member_array(victima, pendientes) == -1)) {
    pendientes += ({ victima });
  }
}

void unir_pendientes_a_lucha() {
  int iniciativa;

  foreach (object atacante in pendientes) {
    if (!objectp(atacante)) continue;
    en_lucha += ({ atacante });
    iniciativa = calcular_iniciativa(atacante);

    /* En casos de empate, deberiamos ordenar por quien tiene mas BONUS */
    if (!iniciativas[iniciativa]) {
      iniciativas[iniciativa] = ({ atacante });
    } else {
      iniciativas[iniciativa] += ({ atacante });
    }
    pendientes -= ({ atacante });
  }
}

void ejecutar_ataque(object atacante) {
  int armado, ac, dano, *ataques;
  string *tipo_dano;
  object victima, *candidatos, *armas, arma;
  class mensaje msg;

  if (!objectp(atacante)) return;

  /* Escogemos la victima del ataque */
  candidatos = atacante->atacando_q();
  if (!pointerp(candidatos)) return;
  candidatos = filter(candidatos, (: objectp($1) :));
  if (!sizeof(candidatos)) {
    /* Sin blancos validos: salir de la lucha */
    en_lucha -= ({ atacante });
    foreach (int ini in keys(iniciativas)) {
      iniciativas[ini] -= ({ atacante });
      if (!sizeof(iniciativas[ini])) map_delete(iniciativas, ini);
    }
    return;
  }
  victima = candidatos[random(sizeof(candidatos))];
  if (!objectp(victima)) return;

  /* Recuperamos las armas que estamos empuñando */
  armado = sizeof(armas = atacante->empunando_q());

  /* Resolvemos la lista de ataques y la AC de la victima */
  ataques = efun::call_other(DADO, "tiradas_ataque", atacante);
  ac = 10 + min(victima->mod_des_q(), victima->max_mod_des_q()) + victima->ac_q();

  foreach (int ataque in ataques) {
    if (ataque >= ac) {
      /* El atacante impacta */
      if (!armado) {
        dano = efun::call_other(DADO, "lanzar", 1, 3);

        msg = atacante->mensaje_combate_desarmado_q(random(5) + 1);
      } else {
        arma = armas[random(armado)];
        dano = efun::call_other(DADO, "lanzar", arma->tiradas_q(), arma->dado_q());
        tipo_dano = arma->tipo_dano_q();
      }

      if (msg) {
        tell_object(atacante, replace_string(msg->texto_yo, "$Z", victima->zona_impacto_q()) + ".\n");
        tell_object(victima, msg->texto_el + ".\n");
        tell_room(ENV(atacante), msg->texto_otros + ".\n", ({ atacante, victima }));
      }
    }
  }
}
