#include <tablas.h>

string *feats = ({});

int add_feat(string feat) {
  feat = lower_case(feat);
  if (!efun::call_other(TABLA_FEATS, "requisitos_q", feat)) return 0;
  feats += ({ feat });
  return 1;
}

string feat_q(string feat) {
  return (member_array(feat, feats) == -1 ? 0 : 1);
}

string *feats_q() {
  return feats;
}

string *feats_accesibles_q() {
  string *all_feats;

  all_feats = efun::call_other(TABLA_FEATS, "feats_q");
  foreach (string feat in all_feats) {
    if (!efun::call_other(TABLA_FEATS, "requisitos_q", feat)) {
      all_feats -= ({ feat });
    }
  }
  return all_feats;
}
