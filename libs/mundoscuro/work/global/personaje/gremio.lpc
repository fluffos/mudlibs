#include <mudlib.h>

private string fichero_gremio;
private nosave object gremio;
private int nivel_alistamiento;

int cargar_gremio() {
  string err;
  if (fichero_gremio) {
    err = catch(gremio = load_object(fichero_gremio));
    if ((err) || (!gremio)) {
      write("Error cargando gremio " + fichero_gremio + "\n");
      if (err) write(err + "\n");
      return 0;
    }
  }
  return 1;
}

void gremio(string file) {
  if ((!inherits(GUILDROOM, PO(0))) && (!adminp())) return;
  fichero_gremio = file;
  gremio = load_object(file);
  nivel_alistamiento = TP->nivel_q();
}

string gremio_q() {
  if (!gremio) return "Ninguno";
  return gremio->nombre_gremio_q();
}

string fichero_gremio_q() { return fichero_gremio; }

int nivel_alistamiento_q() { return nivel_alistamiento; }
