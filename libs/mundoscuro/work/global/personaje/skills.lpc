#include <tablas.h>

private mapping skills = ([]);

int add_skill(string skill) {
  skill = lower_case(skill);
  if (!efun::call_other(TABLA_SKILLS, "skill_q", skill)) return 0;
  skills[skill] = 1;
  return 1;
}

string skill_q(string skill) {
  return (skills[skill] ? 1 : 0);
}

int nivel_skill_q(string skill) {
  return (skills[skill] ? skills[skill] : 0);
}

int nivel_maximo_skill_q(string skill) {
  int nivel;

  nivel = TP->nivel_q();
  if (TP->skill_favorita_q(skill))
    nivel += 3;
  else
    nivel = nivel / 2;
  return nivel;
}

int coste_skill_q(string skill) {
  int coste;

  if (!skills[skill]) return 0;
  coste = efun::call_other(TABLA_SKILLS, "coste", skills[skill] + 1);
  if (!TP->skill_favorita_q(skill)) coste *= 2;
  return coste;
}

string *skills_q() {
  return keys(skills);
}

void avanzar_skill(string skill) {
  if (!skills[skill]) return;
  skills[skill] += 1;
}
