int cargar_ficha() {
  string chan;

  if (!::cargar_ficha()) return 0;

  /* Si nos acaban de hacer inmortales o estabamos desconectados, no tenemos
     * agregado el canal de nuestro rango. Lo anyadimos ahora.
     */
  if (!acceso_al_canal_q((chan = efun::call_other(RANGOS, "rango", inmortal_level)))) {
    if (!add_channel(chan)) {
      write("Aviso: no se pudo abrir el canal " + capitalize(chan) + ".\n");
    }
  }
  return 1;
}

int cwd(string nwd) {
  string *dirs;
  dirs = explore_path(nwd, 1);

  if (dirs == ({})) {
    notify_fail("cd: No existe el directorio '" + nwd + "'.\n");
    return 0;
  }
  if (efun::call_other(PERMISOS, "read_access_q", TP, dirs[0])) {
    cwd = dirs[0];
    return 1;
  } else {
    notify_fail("cd: " + dirs[0] + ": Acceso denegado.\n");
    return 0;
  }
}

string cwd_q() {
  if (!cwd) {
    if (find_dir(DIR_HOME + "/" + TP->nombre_q())) cwd = DIR_HOME + "/" + TP->nombre_q();
    else cwd = "/";
  }
  return cwd;
}
