#include <mudlib.h>
#include <daemons.h>
#include <errno.h>
#include <dirs.h>
#include <permisos.h>

inherit JUGADOR;

private nosave int inmortal_level;

private nosave string cwd;

void inicializar() {
  string err;

  /* Recuperar el nivel de inmortal de la BD */
  if (err = catch(inmortal_level = efun::call_other(RANGOS, "nivel_inmortal", nombre_q()))) {
    write(serror(err) + "\n");
    write("Error inicializando objeto inmortal.\n");
    destruct(TO);
  }

  //    set_privs(TO, TO->nombre_q() + " " + inmortal_level);

  ::inicializar();
}

int inmortal_q() { return 1; }

int nivel_inmortal_q() { return inmortal_level; }

