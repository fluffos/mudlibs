/* This sefun is meant to replace the deprecated efun tail().
 * Feel free to add it to your mudlibs, if you have much code using tail() or
 * want to use tail().
 *
 * FluffOS: string path only (LDMud 3.5 bytes branch dropped).
 */

#define TAIL_MAX_BYTES 1000

varargs int
tail(string file)
{
    string txt;
    int index;

    if (!stringp(file) || !this_player()) {
	return 0;
    }

    txt = read_bytes(file, -(TAIL_MAX_BYTES + 80), (TAIL_MAX_BYTES + 80));

    if (!stringp(txt)) {
	return 0;
    }

    /* cut off first (incomplete) line */
    index = strsrch(txt, "\n");

    if (index > -1) {
	if (index + 1 < sizeof(txt)) {
	    txt = txt[index+1..];
	} else {
	    txt = "";
	}
    }

    tell_object(this_player(), txt);
    return 1;
}
