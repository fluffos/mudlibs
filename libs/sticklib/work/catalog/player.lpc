/*
 * Catalog player for sticklib Strategy A (LDMud → FluffOS).
 * Login is /catalog/login; the body lands in the real /room/church.
 */

string name;
string password;
int hp;
int max_hp;
int ghost;
int money;
int ep;
string quests;
object fighting;

int cmd_look(string arg);
int cmd_score(string arg);
int cmd_inventory(string arg);
int cmd_quit(string arg);
int cmd_get(string arg);
int cmd_give(string arg);
int cmd_kill(string arg);
void do_swing();
varargs int tell_me(string s, mixed a, mixed b);
varargs void move_player(string dir_dest, mixed dest_ob);
void save_me();

void create() {
  seteuid(getuid());
  hp = 20;
  max_hp = 20;
  money = 50;
}

string query_name() { return name; }
string query_real_name() { return name; }
string query_password() { return password; }
int query_hp() { return hp; }
int query_mhp() { return max_hp; }
int query_level() { return 1; }
int query_ghost() { return ghost; }
int query_money() { return money; }
string query_race() { return 0; }
int query_ep() { return ep; }
int query_wc() { return 8; }
object query_attack() { return fighting; }
int query_qp() { return 0; }
int query_gender() { return 1; }
int query_stat(int s) { return 10; }
string query_title() { return "the adventurer"; }
int query_ctrl() { return 0; }
int is_npc() { return 0; }

varargs mixed
query_quests(string q)
{
  if (!stringp(q) || q == "")
    return quests;
  if (!stringp(quests) || quests == "")
    return 0;
  return member_array(q, explode(quests, "#")) != -1;
}
int query_crime_level() { return 0; }
int query_invis() { return 0; }
int drink_alcohol(int s) { return 1; }
void heal_self(int x) { hp += x; if (hp > max_hp) hp = max_hp; }
mixed query_keep_items() { return ({}); }
int query(mixed x) { return 0; }

void add_money(int x) { money += x; if (money < 0) money = 0; }
void add_exp(int x) { ep += x; if (ep < 0) ep = 0; save_me(); }
void add_stat(int s, int n) { }
void set_qp(int x) { }
void
set_quest(string q)
{
  if (!stringp(q) || q == "")
    return;
  if (query_quests(q))
    return;
  if (!quests || quests == "")
    quests = q;
  else
    quests += "#" + q;
  save_me();
}
void set_title(string t) { }
void set_level(int x) { }
int add_weight(int w) { return 1; }

varargs int
more(mixed x)
{
  int i;

  if (stringp(x)) {
    write(x);
    if (x[<1] != '\n')
      write("\n");
    return 1;
  }
  if (pointerp(x)) {
    for (i = 0; i < sizeof(x); i++)
      if (stringp(x[i]))
        write(x[i] + "\n");
    return 1;
  }
  return 0;
}
mixed query_env(string k) { return 0; }
int id(string s) { return s && (s == name || s == "player"); }

string save_path() {
  if (!name || name == "")
    return 0;
  return sprintf("/data/%c/%s", name[0], name);
}

void ensure_letter_dir() {
  string d;

  if (!name)
    return;
  d = sprintf("/data/%c", name[0]);
  if (file_size("/data") != -2)
    mkdir("/data");
  if (file_size(d) != -2)
    mkdir(d);
}

int restore_me(string n) {
  name = n;
  if (!restore_object(save_path()))
    return 0;
  if (max_hp < 1)
    max_hp = 20;
  if (hp < 1)
    hp = max_hp;
  if (money < 80)
    money = 200;
  return 1;
}

void setup_new(string n, string pw) {
  name = n;
  password = pw;
  hp = 20;
  max_hp = 20;
  money = 50;
  ghost = 0;
}

void save_me() {
  string p;

  p = save_path();
  if (!p)
    return;
  ensure_letter_dir();
  save_object(p);
}

void wire_commands() {
  enable_commands();
  add_action("cmd_look", "look");
  add_action("cmd_look", "l");
  add_action("cmd_score", "score");
  add_action("cmd_score", "sc");
  add_action("cmd_quit", "quit");
  add_action("cmd_inventory", "inventory");
  add_action("cmd_inventory", "i");
  add_action("cmd_get", "get");
  add_action("cmd_get", "take");
  add_action("cmd_give", "give");
  add_action("cmd_kill", "kill");
  add_action("cmd_kill", "hit");
}

void enter_world() {
  object dest;

  set_living_name(name);
  wire_commands();
  dest = 0;
  catch(dest = load_object("/room/church"));
  if (dest)
    efun::move_object(dest);
  else
    efun::move_object("/catalog/void");
  write("\n");
  command("look");
  save_me();
}

mixed process_input(string str) {
  string verb, rest;

  if (!str)
    return 0;
  if (sscanf(str, "%s %s", verb, rest) != 2) {
    verb = str;
    rest = 0;
  }
  switch (verb) {
    case "look":
    case "l":
      cmd_look(rest);
      return 1;
    case "score":
    case "sc":
      cmd_score(rest);
      return 1;
    case "quit":
      cmd_quit(rest);
      return 1;
    case "inventory":
    case "i":
      cmd_inventory(rest);
      return 1;
    case "get":
    case "take":
      cmd_get(rest);
      return 1;
    case "give":
      cmd_give(rest);
      return 1;
    case "kill":
    case "hit":
      cmd_kill(rest);
      return 1;
  }
  /* Directions, pray, ring, shop buy/order — room command_driver. */
  return 0;
}

int cmd_look(string arg) {
  object env, *inv;
  mixed desc, item;
  string brief, out;
  int i;

  env = environment();
  if (!env) {
    write("You are nowhere.\n");
    return 1;
  }
  if (arg && sscanf(arg, "at %s", arg) == 1)
    ;
  if (arg && arg != "") {
    item = env->query_long(arg, this_object());
    if (stringp(item) && item != "") {
      write(item);
      if (item[<1] != '\n')
        write("\n");
      return 1;
    }
    item = present(arg, env);
    if (!item)
      item = present(arg, this_object());
    if (item) {
      desc = item->query_long();
      if (!desc || desc == "")
        desc = item->query_long(0, this_object());
      if (stringp(desc) && desc != "") {
        write(desc);
        if (desc[<1] != '\n')
          write("\n");
        return 1;
      }
    }
    write("You see nothing special.\n");
    return 1;
  }
  brief = env->query_short();
  if (!brief || brief == "")
    brief = env->short();
  if (brief && brief != "")
    write(brief + "\n");
  desc = env->query_long();
  if (!desc || desc == "")
    desc = env->query_long(0, this_object());
  if (stringp(desc) && desc != "") {
    write(desc);
    if (desc[<1] != '\n')
      write("\n");
  }
  out = env->query_exit_string();
  if (stringp(out) && out != "")
    write(out);
  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == this_object())
      continue;
    brief = inv[i]->short();
    if (!brief || brief == "")
      brief = inv[i]->query_name();
    if (brief && brief != "")
      write(brief + " is here.\n");
  }
  return 1;
}

int cmd_score(string arg) {
  write(capitalize(name || "someone") + " (level " + query_level() + ")\n");
  write("hp: " + hp + "/" + max_hp + "  gold: " + money +
    "  exp: " + ep + "\n");
  if (quests && quests != "")
    write("Quests: " + replace_string(quests, "#", ", ") + "\n");
  if (ghost)
    write("You are a ghost. Go to the temple yard and pray.\n");
  return 1;
}

int
cmd_get(string arg)
{
  object env, item;
  string brief;

  if (!arg || arg == "") {
    write("Get what?\n");
    return 1;
  }
  env = environment();
  if (!env) {
    write("You are nowhere.\n");
    return 1;
  }
  item = present(arg, env);
  if (!item) {
    write("You don't see that here.\n");
    return 1;
  }
  if (living(item)) {
    write("You can't pick that up.\n");
    return 1;
  }
  if (function_exists("get", item) && !item->get()) {
    write("You can't take that.\n");
    return 1;
  }
  move_object(item, this_object());
  brief = item->query_name();
  if (!brief || brief == "")
    brief = arg;
  write("You take " + brief + ".\n");
  return 1;
}

int
cmd_give(string arg)
{
  string what, whom, brief;
  object item, dest;

  if (!arg || arg == "") {
    write("Give what to whom?\n");
    return 1;
  }
  if (sscanf(arg, "%s to %s", what, whom) != 2 &&
      sscanf(arg, "%s %s", what, whom) != 2) {
    write("Give what to whom?\n");
    return 1;
  }
  item = present(what, this_object());
  if (!item) {
    write("You don't have that.\n");
    return 1;
  }
  dest = present(whom, environment());
  if (!dest) {
    write("There is no " + whom + " here.\n");
    return 1;
  }
  move_object(item, dest);
  brief = item->short();
  if (!brief || brief == "")
    brief = item->query_name();
  if (!brief || brief == "")
    brief = what;
  write("You give " + brief + " to " +
    (dest->query_name() || whom) + ".\n");
  if (function_exists("give_object_by", dest))
    dest->give_object_by(this_object(), item);
  return 1;
}

varargs int
hit_player(int dam, mixed dtype, mixed hc, mixed enemy)
{
  if (ghost)
    return 0;
  if (dam > 0)
    hp -= dam;
  if (hp < 0)
    hp = 0;
  tell_me("You take " + dam + " damage.");
  if (hp < 1) {
    ghost = 1;
    hp = 0;
    fighting = 0;
    set_heart_beat(0);
    tell_me("You die.");
    save_me();
  }
  return dam;
}

void
do_swing()
{
  int dam;
  object env;
  string them;

  if (!fighting || !objectp(fighting)) {
    fighting = 0;
    set_heart_beat(0);
    return;
  }
  env = environment();
  if (!env || environment(fighting) != env) {
    tell_me("Your opponent is gone.");
    fighting = 0;
    set_heart_beat(0);
    return;
  }
  them = fighting->query_name() || "someone";
  dam = 6 + random(6);
  tell_me("You hit " + them + ".");
  fighting->hit_player(dam, 0, 0, this_object());
  if (!fighting || !objectp(fighting)) {
    set_heart_beat(0);
    return;
  }
}

void
heart_beat()
{
  if (ghost || !fighting) {
    set_heart_beat(0);
    return;
  }
  do_swing();
}

int
cmd_kill(string arg)
{
  object vic;
  int i;

  if (!arg || arg == "") {
    write("Kill whom?\n");
    return 1;
  }
  if (ghost) {
    write("You are dead. Go to the temple yard and pray.\n");
    return 1;
  }
  vic = present(arg, environment());
  if (!vic || !living(vic) || vic == this_object()) {
    write("No one by that name here.\n");
    return 1;
  }
  fighting = vic;
  write("You attack " + (vic->query_name() || arg) + ".\n");
  if (function_exists("attacked_by", vic))
    vic->attacked_by(this_object());
  for (i = 0; i < 12; i++) {
    if (ghost || !fighting || !objectp(fighting))
      break;
    do_swing();
    if (fighting && objectp(fighting) && function_exists("attack", fighting))
      fighting->attack();
  }
  if (fighting && objectp(fighting) && !ghost)
    set_heart_beat(1);
  else
    set_heart_beat(0);
  return 1;
}

int cmd_inventory(string arg) {
  object *inv;
  string brief;
  int i, n;

  inv = all_inventory(this_object());
  n = sizeof(inv);
  if (!n) {
    write("You are empty-handed.\n");
    return 1;
  }
  write("You are carrying:\n");
  for (i = 0; i < n; i++) {
    brief = inv[i]->short();
    if (!brief || brief == "")
      brief = inv[i]->query_name();
    if (brief && brief != "")
      write("  " + brief + "\n");
  }
  return 1;
}

varargs int
tell_me(string s, mixed a, mixed b)
{
  if (s)
    write(s + (s[<1] == '\n' ? "" : "\n"));
  return 1;
}

varargs void
move_player(string dir_dest, mixed dest_ob)
{
  string dir;
  mixed dest;
  object d;

  if (!dest_ob) {
    if (!dir_dest || sscanf(dir_dest, "%s#%s", dir, dest) != 2) {
      write("Move to bad dir/dest\n");
      return;
    }
  } else {
    dir = dir_dest;
    dest = dest_ob;
  }
  if (objectp(dest))
    d = dest;
  else if (stringp(dest))
    catch(d = load_object(dest));
  if (!d) {
    write("That exit leads nowhere.\n");
    return;
  }
  efun::move_object(d);
  command("look");
}

int remove_ghost() {
  if (!ghost)
    return 0;
  write("You feel a very strong force.\n");
  write("You reappear in a more solid form.\n");
  ghost = 0;
  if (hp < 10)
    hp = 10;
  save_me();
  return 1;
}

int cmd_quit(string arg) {
  write("Saving " + capitalize(name || "someone") + ".\n");
  save_me();
  destruct(this_object());
  return 1;
}
