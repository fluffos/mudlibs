/*
 * FluffOS simul_efun for sticklib Strategy A (LDMud → FluffOS).
 * Original LDMud simul tree is not loaded.
 */

void cat(string file) {
  string s;

  s = read_file(file);
  if (s)
    write(s);
}

void log_file(string file, string str) {
  if (file_size("/log") != -2)
    mkdir("/log");
  write_file("/log/" + file, str);
}

int exists(string path) {
  return file_size(path) != -1;
}

string object_name(object ob) {
  if (!ob)
    return 0;
  return efun::file_name(ob);
}

mixed *m_indices(mapping m) {
  if (!mapp(m))
    return ({});
  return keys(m);
}

mixed *m_values(mapping m) {
  if (!mapp(m))
    return ({});
  return values(m);
}

mapping m_delete(mapping m, mixed key) {
  mapping copy;

  if (!mapp(m))
    return m;
  copy = m + ([]);
  efun::map_delete(copy, key);
  return copy;
}

/*
 * LDMud map_objects / filter_objects: call_other each element.
 * FluffOS filter()/map() call a function with the element as arg;
 * these call e->func(args) on the element itself.
 */
varargs mixed *
map_objects(mixed *arr, string func, mixed a1, mixed a2, mixed a3, mixed a4)
{
    mixed *out;
    int i, n;

    if (!pointerp(arr) || !func)
	return ({});
    n = sizeof(arr);
    out = allocate(n);
    for (i = 0; i < n; i++) {
	if (!objectp(arr[i]))
	    continue;
	if (a4)
	    out[i] = call_other(arr[i], func, a1, a2, a3, a4);
	else if (a3)
	    out[i] = call_other(arr[i], func, a1, a2, a3);
	else if (a2)
	    out[i] = call_other(arr[i], func, a1, a2);
	else if (a1)
	    out[i] = call_other(arr[i], func, a1);
	else
	    out[i] = call_other(arr[i], func);
    }
    return out;
}

varargs mixed *
filter_objects(mixed *arr, string func, mixed a1, mixed a2, mixed a3)
{
    mixed *out;
    int i, n;

    if (!pointerp(arr) || !func)
	return ({});
    n = sizeof(arr);
    out = ({});
    for (i = 0; i < n; i++) {
	if (!objectp(arr[i]))
	    continue;
	if (a3 ? call_other(arr[i], func, a1, a2, a3)
	    : a2 ? call_other(arr[i], func, a1, a2)
	    : a1 ? call_other(arr[i], func, a1)
	    : call_other(arr[i], func))
	    out += ({ arr[i] });
    }
    return out;
}

/*
 * LDMud walk_mapping(m, fun [, extras…]): call fun(key, value[, extras])
 * for each entry. fun may be a string (lfun on previous_object) or a
 * function pointer. FluffOS has no efun.
 */
varargs void
walk_mapping(mapping m, mixed fun, mixed a1, mixed a2, mixed a3)
{
    mixed *k;
    int i, n, extra;

    if (!mapp(m) || !fun)
	return;
    k = keys(m);
    n = sizeof(k);
    extra = (a1 || a2 || a3) ? (a3 ? 3 : (a2 ? 2 : 1)) : 0;
    for (i = 0; i < n; i++) {
	if (stringp(fun)) {
	    if (extra == 0)
		call_other(previous_object(), fun, k[i], m[k[i]]);
	    else if (extra == 1)
		call_other(previous_object(), fun, k[i], m[k[i]], a1);
	    else if (extra == 2)
		call_other(previous_object(), fun, k[i], m[k[i]], a1, a2);
	    else
		call_other(previous_object(), fun, k[i], m[k[i]], a1, a2, a3);
	} else if (functionp(fun)) {
	    if (extra == 0)
		evaluate(fun, k[i], m[k[i]]);
	    else if (extra == 1)
		evaluate(fun, k[i], m[k[i]], a1);
	    else if (extra == 2)
		evaluate(fun, k[i], m[k[i]], a1, a2);
	    else
		evaluate(fun, k[i], m[k[i]], a1, a2, a3);
	}
    }
}

mixed member(mixed what, mixed elem) {
  mixed *k;
  int i;

  if (mapp(what)) {
    k = keys(what);
    for (i = 0; i < sizeof(k); i++)
      if (k[i] == elem)
        return 1;
    return 0;
  }
  if (pointerp(what))
    return efun::member_array(elem, what);
  if (stringp(what))
    return strsrch(what, elem);
  return 0;
}

varargs int
strstr(string s, string sub, int pos)
{
  int r;

  if (!stringp(s) || !stringp(sub))
    return -1;
  if (undefinedp(pos) || pos < 1)
    return strsrch(s, sub);
  if (pos >= sizeof(s))
    return -1;
  r = strsrch(s[pos..], sub);
  if (r < 0)
    return -1;
  return r + pos;
}

int mappingp(mixed x) { return mapp(x); }

int closurep(mixed x) { return 0; }

varargs mixed funcall(mixed f, mixed a, mixed b, mixed c) {
  object ob;

  if (!stringp(f))
    return f;
  ob = previous_object() || this_object();
  if (ob && function_exists(f, ob))
    return call_other(ob, f, a, b, c);
  return f;
}

mixed symbol_function(string name, object ob) {
  if (!ob)
    ob = previous_object();
  if (!ob || !stringp(name) || !function_exists(name, ob))
    return 0;
  return name;
}

object to_object(mixed x) {
  return objectp(x) ? x : 0;
}

string to_string(mixed x) {
  if (stringp(x))
    return x;
  if (intp(x))
    return "" + x;
  if (objectp(x))
    return file_name(x);
  return "";
}

varargs void configure_object(object ob, int what, mixed val) {
  if (!ob)
    return;
  if (what == 1) {
    if (val)
      ob->heart_on();
    else
      ob->heart_off();
  }
}

varargs string implode(mixed *arr, string delim, string last) {
  int n;

  if (!pointerp(arr))
    return "";
  n = sizeof(arr);
  if (n < 1)
    return "";
  if (undefinedp(last) || n < 2)
    return efun::implode(arr, delim || "");
  if (n == 2)
    return arr[0] + last + arr[1];
  return efun::implode(arr[0..n - 2], delim || "") + last + arr[n - 1];
}

varargs void move_object(mixed item, mixed dest) {
  object ob, d;

  if (undefinedp(dest)) {
    if (previous_object())
      call_other(previous_object(), "_efun_move_to", item);
    return;
  }
  if (objectp(item))
    ob = item;
  else if (stringp(item)) {
    ob = find_object(item);
    if (!ob)
      catch(ob = load_object(item));
  }
  if (objectp(dest))
    d = dest;
  else if (stringp(dest)) {
    d = find_object(dest);
    if (!d)
      catch(d = load_object(dest));
  }
  if (!ob || !d)
    return;
  call_other(ob, "_efun_move_to", d);
}

int notify_fail(string s) {
  efun::notify_fail(s);
  return 0;
}

object nature() {
  object ob;

  catch(call_other("/bin/daemons/nature_d", "query_24_hour"));
  ob = find_object("/bin/daemons/nature_d");
  if (!ob)
    ob = find_object("bin/daemons/nature_d");
  return ob;
}


/* LDMud present4 / object_info -- Strategy A catalog sefun (census FAIL) */

#define OI_ONCE_INTERACTIVE -1
#define OI_SHADOW_NEXT -50
#define OI_SHADOW_PREV -51
#define OI_OBJECT_NEXT -40
#define OI_OBJECT_PREV -41

object
present4(string Id, object where, object who, int iflags)
{
    int i, x, c;
    object ob;

    if (!stringp(Id))
        return 0;
    if (sizeof(Id) && Id[<1] >= '0' && Id[<1] <= '9') {
        x = sizeof(Id);
        while (--x && (c = Id[x]) >= '0' && c <= '9')
            i = i * 10 + (c - '0');
        while (x && Id[x] == ' ')
            x--;
        Id = Id[0..x];
        i--;
    }
    if (!where)
        return 0;
    ob = first_inventory(where);
    while (ob) {
        if (ob != who && ob->id(Id, iflags, who)) {
            if (!i--)
                return ob;
        }
        ob = next_inventory(ob);
    }
    return 0;
}

varargs mixed
object_info(object ob, int what)
{
    if (!objectp(ob))
        return 0;
    switch (what) {
    case OI_ONCE_INTERACTIVE:
        return interactive(ob);
    case OI_SHADOW_NEXT:
    case OI_SHADOW_PREV:
        return 0;
    case OI_OBJECT_NEXT:
    case OI_OBJECT_PREV:
        return 0;
    default:
        return 0;
    }
}

void raise_error(string msg) { error(msg); }


/* LDMud apply / mkmapping — Strategy A catalog sefun (census FAIL) */

varargs mixed
apply(mixed f, mixed a0, mixed a1, mixed a2, mixed a3, mixed a4, mixed a5, mixed a6, mixed a7, mixed a8)
{
    /* apply(cl, ({args...})) */
    if (functionp(f) && pointerp(a0) && undefinedp(a1)) {
        switch (sizeof(a0)) {
        case 0: return evaluate(f);
        case 1: return evaluate(f, a0[0]);
        case 2: return evaluate(f, a0[0], a0[1]);
        case 3: return evaluate(f, a0[0], a0[1], a0[2]);
        case 4: return evaluate(f, a0[0], a0[1], a0[2], a0[3]);
        default: return evaluate(f, a0[0], a0[1], a0[2], a0[3], a0[4]);
        }
    }
    /* apply((: call_other :), ob, fun, ({args...})) — explode trailing array */
    if (functionp(f) && objectp(a0) && stringp(a1) && pointerp(a2) && undefinedp(a3))
        return call_other(a0, ({ a1 }) + a2);
    if (functionp(f)) {
        if (!undefinedp(a8)) return evaluate(f, a0, a1, a2, a3, a4, a5, a6, a7, a8);
        if (!undefinedp(a7)) return evaluate(f, a0, a1, a2, a3, a4, a5, a6, a7);
        if (!undefinedp(a6)) return evaluate(f, a0, a1, a2, a3, a4, a5, a6);
        if (!undefinedp(a5)) return evaluate(f, a0, a1, a2, a3, a4, a5);
        if (!undefinedp(a4)) return evaluate(f, a0, a1, a2, a3, a4);
        if (!undefinedp(a3)) return evaluate(f, a0, a1, a2, a3);
        if (!undefinedp(a2)) return evaluate(f, a0, a1, a2);
        if (!undefinedp(a1)) return evaluate(f, a0, a1);
        if (!undefinedp(a0)) return evaluate(f, a0);
        return evaluate(f);
    }
    return 0;
}

/* CD/LDMud-style pair arrays into a mapping (2-arg form). Wide multi-value
 * mkmapping(player, a, b, c, …) is not supported here. */
mapping
mkmapping(mixed index, mixed value)
{
    mapping result;
    int i, n;

    result = ([]);
    if (pointerp(index) && pointerp(value)) {
        n = sizeof(index) < sizeof(value) ? sizeof(index) : sizeof(value);
        for (i = 0; i < n; i++)
            result[index[i]] = value[i];
        return result;
    }
    if (pointerp(index)) {
        n = sizeof(index);
        for (i = 0; i < n; i++)
            result[index[i]] = i;
        return result;
    }
    if (pointerp(value)) {
        n = sizeof(value);
        for (i = 0; i < n; i++)
            result[i] = value[i];
        return result;
    }
    return result;
}


/* LDMud file_lines / interactive_info — Strategy A catalog sefun */

#define FL_BUFF_SIZE 500

int
file_lines(string s)
{
    int i, j;
    string last_str, curr_str;
    string *tmp;

    while ((curr_str = read_file(s, j, FL_BUFF_SIZE)) && sizeof(curr_str)) {
        if (last_str)
            i += FL_BUFF_SIZE;
        j += FL_BUFF_SIZE;
        last_str = curr_str;
    }
    if (last_str) {
        tmp = explode(last_str, "\n");
        i += sizeof(tmp);
        if (!sizeof(tmp[<1]))
            i--;
    }
    return i;
}

#define II_IP_NAME -1
#define II_IP_NUMBER -2
#define II_IP_PORT -3
#define II_EDITING -21
#define II_IDLE -22
#define II_SNOOP_NEXT -30
#define II_SNOOP_PREV -31

mixed
interactive_info(object ob, int what)
{
    if (!objectp(ob))
        return 0;
    switch (what) {
    case II_IP_NAME:
        return query_ip_name(ob);
    case II_IP_NUMBER:
        return query_ip_number(ob);
    case II_IDLE:
        return query_idle(ob);
    case II_EDITING:
        return in_edit(ob);
    case II_SNOOP_NEXT:
        return query_snoop(ob);
    case II_SNOOP_PREV:
        return query_snooping(ob);
    default:
        return 0;
    }
}


/* LDMud do_find_object / get_object — Strategy A catalog sefun */

object
do_find_object(string fname)
{
    object ob;

    if (!stringp(fname))
        error("do_find_object: non-string argument\n");
    if (ob = find_object(fname))
        return ob;
    catch(call_other(fname, "???"));
    return find_object(fname);
}

varargs object
get_object(string str, object player)
{
    string *obpath;
    object what;
    mixed tmp;
    int i;

    if (!str)
        return 0;
    if (!player)
        player = this_player();

    if (sizeof(obpath = explode(str, ":")) > 1)
        str = obpath[0];
    else
        obpath = ({ str });

    do {
        if (player) {
            if (str == "me") { what = player; break; }
            if (what = present(str, player)) break;
            if (what = environment(player)) {
                if (str == "here" || str == "env") break;
                if (what = present(str, what)) break;
            }
        }
        if (what = find_player(str)) break;
        if (what = find_living(str)) break;
        if (what = find_object(str)) break;
        if (!sscanf(str, "%s#", str)
          && (file_size(str) >= 0 || file_size(str + ".lpc") >= 0)) {
            catch(call_other(str, "???"));
            what = find_object(str);
        }
    } while (0);

    while (what && sizeof(obpath) > 1) {
        obpath = obpath[1..];
        str = obpath[0];
        if (str == "e" || str == "env") {
            what = environment(what);
            continue;
        }
        if ((sscanf(str, "i%d", i) || sscanf(str, "%d", i))
          && i >= 1 && sizeof(tmp = all_inventory(what)) >= i) {
            what = tmp[i - 1];
            continue;
        }
        what = present(str, what);
    }
    return what;
}

/* LDMud m_allocate(width[, values]) — 1-value maps only; wide maps → empty. */
varargs mapping
m_allocate(int width, int values)
{
    return ([]);
}

int
get_eval_cost()
{
    return eval_cost();
}

int
query_uptime()
{
    return uptime();
}

varargs int
tail(string file)
{
    string txt;
    int index;

    if (!stringp(file) || !this_player())
        return 0;
    txt = read_bytes(file, -1080, 1080);
    if (!stringp(txt))
        return 0;
    index = strsrch(txt, "\n");
    if (index > -1) {
        if (index + 1 < sizeof(txt))
            txt = txt[index + 1..];
        else
            txt = "";
    }
    tell_object(this_player(), txt);
    return 1;
}


/* LDMud query_once_interactive — once-interactive object (player body). */
int
query_once_interactive(object ob)
{
    return objectp(ob) && interactive(ob);
}


/* LDMud regreplace — literal replace_string for Strategy A help cmds. */
varargs string
regreplace(string str, string pattern, string replace, int flags)
{
    if (!stringp(str) || !stringp(pattern))
        return str;
    return replace_string(str, pattern, replace || "");
}


/* LDMud strrstr — last index of substring (FluffOS strsrch reverse). */
int
strrstr(string str, string sub)
{
    if (!stringp(str) || !stringp(sub))
        return -1;
    return strsrch(str, sub, 1);
}


/* LDMud implode3 / extern_call / driver_info / version — Strategy A catalog */

varargs string
implode3(string *x, string a, string b)
{
    int i, last;
    mixed tmp;
    string s;

    if (!pointerp(x))
        return "";
    i = sizeof(x);
    while (--i >= 0) {
        if (stringp(x[i])) {
            last = i;
            break;
        }
    }
    if (i < 0)
        return "";
    while (--i >= 0) {
        if (stringp(x[i]))
            break;
    }
    if (i < 0)
        return x[last];
    tmp = x[last];
    x[last] = 0;
    s = implode(x, a);
    x[last] = tmp;
    return sprintf("%s%s%s", s, b, tmp);
}

int
extern_call()
{
    return previous_object() && previous_object() != this_object();
}

#define DI_LOAD_AVERAGE_COMMANDS -300
#define DI_LOAD_AVERAGE_LINES -301

mixed
driver_info(int what)
{
    string la;

    la = query_load_average();
    switch (what) {
    case DI_LOAD_AVERAGE_COMMANDS:
        return la || "0";
    case DI_LOAD_AVERAGE_LINES:
        return la || "0";
    default:
        return 0;
    }
}

string
version()
{
    return __VERSION__;
}


/* LDMud to_bytes / binary_message — Strategy A catalog (telopt/GMCP) */

varargs string
to_bytes(string str, string encoding)
{
    return stringp(str) ? str : "";
}

varargs int
binary_message(mixed msg, int flags)
{
    object tp;
    string s;
    int i, n;

    tp = this_player();
    if (!tp)
        return 0;
    if (stringp(msg))
        s = msg;
    else if (pointerp(msg)) {
        s = "";
        n = sizeof(msg);
        for (i = 0; i < n; i++)
            s += sprintf("%c", msg[i]);
    } else
        return 0;
    tell_object(tp, s);
    return sizeof(s);
}


/* FluffOS JSON (formosasaga port) + LDMud name aliases for telopt GMCP */
#include "/catalog/json.lpc"
#undef to_string

mixed json_parse(string text) { return json_decode(text); }
varargs string json_serialize(mixed value) { return json_encode(value); }


/* LDMud hash(TLS_HASH_*, data) — wrap FluffOS hash(algo_string, data) */
#define TLS_HASH_SHA1 1
#define TLS_HASH_SHA224 2
#define TLS_HASH_SHA256 3
#define TLS_HASH_SHA384 4
#define TLS_HASH_SHA512 5
#define TLS_HASH_MD5 6
#define TLS_HASH_RIPEMD160 7

varargs string
hash(mixed algo, string data)
{
    string name;

    if (!stringp(data))
        return 0;
    if (stringp(algo))
        return efun::hash(algo, data);
    if (!intp(algo))
        return 0;
    switch (algo) {
    case TLS_HASH_SHA1: name = "sha1"; break;
    case TLS_HASH_SHA224: name = "sha224"; break;
    case TLS_HASH_SHA256: name = "sha256"; break;
    case TLS_HASH_SHA384: name = "sha384"; break;
    case TLS_HASH_SHA512: name = "sha512"; break;
    case TLS_HASH_MD5: name = "md5"; break;
    case TLS_HASH_RIPEMD160: name = "ripemd160"; break;
    default: return 0;
    }
    return efun::hash(name, data);
}


/* LDMud command(cmd, who) / transfer — Strategy A catalog */

varargs int
command(string cmd, object who)
{
    mixed err;
    int r;

    if (!stringp(cmd))
        return 0;
    if (!who || who == this_object())
        return efun::command(cmd);
    /* Run the efun in the target object's context (FluffOS has no 2-arg command). */
    err = catch(r = evaluate(bind((: efun::command, cmd :), who)));
    return err ? 0 : r;
}

/* MudOS/LDMud transfer(); 0 = success. */
int
transfer(object item, object dest)
{
    int weight;
    object from;

    if (!item || !dest)
        return 3;
    weight = item->query_weight();
    if (!item)
        return 3;
    from = environment(item);
    if (from) {
        if (living(from)) {
            if (item->drop() || !item)
                return 2;
        } else if (environment(from)) {
            if (!from->can_put_and_get() || !from)
                return 3;
        }
    }
    if (environment(dest) && !living(dest)) {
        if (item->prevent_insert())
            return 4;
        if (!dest->can_put_and_get() || !dest)
            return 5;
    }
    if (living(dest)) {
        if (!item->get() || !item)
            return 6;
    }
    if (environment(dest) && weight) {
        if (!dest->add_weight(weight) || !dest)
            return 1;
    }
    if (from && environment(from) && weight)
        from->add_weight(-weight);
    move_object(item, dest);
    return 0;
}
