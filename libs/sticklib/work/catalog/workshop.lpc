mapping exits;

void create() {
  exits = ([
    "south": "/catalog/void",
  ]);
}

string query_short() { return "Protocol workshop"; }

string query_long() {
  return "Protocol workshop\n"
    "StickLib documents GMCP/MSSP/MXP/MSP/MCMP examples on LDMud.\n"
    "This FluffOS catalog does not run those stacks. Original master:\n"
    "/secure/master_ldmud.lpc. South returns to the void.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Exits: south.\n";
}

int id(string str) { return str == "workshop" || str == "here"; }
