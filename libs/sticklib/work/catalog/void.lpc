mapping exits;

void create() {
  exits = ([
    "north": "/catalog/workshop",
  ]);
}

string query_short() { return "The Void"; }

string query_long() {
  return "The Void\n"
    "Catalog landing for StickLib after the LDMud → FluffOS port.\n"
    "Stock StickMUD areas under /areas, guilds under /guilds, and the\n"
    "LDMud secure/ stack remain as sources. A workshop lies to the north.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Exits: north.\n";
}

int id(string str) { return str == "void" || str == "here"; }
