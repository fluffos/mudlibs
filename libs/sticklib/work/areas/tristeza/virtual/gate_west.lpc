#include "../DEFS.h"

inherit TRISTEZA_ROOM_C;

/* TODO: Gate closed or open ***/

object *guard;
object bum;

void
ensure_bum()
{
    if (bum && environment(bum) == this_object())
	return;
    bum = 0;
    catch(bum = clone_object(NPC_DIR + "bum"));
    if (bum && environment(bum) != this_object())
	move_object(bum, this_object());
}

void
reset_room()
{
    int i;
    object g;

    if (!guard)
	guard = allocate(4);
    for (i = 0; i < 4; i++) {
	if (guard[i])
	    continue;
	g = 0;
	catch(g = clone_object(NPC_DIR + "guard"));
	if (!g)
	    continue;
	guard[i] = g;
	catch(g->move_player("foo", this_object()));
	if (environment(g) != this_object())
	    move_object(g, this_object());
    }
    ensure_bum();
}

void
create_room()
{
    ::create_room();
    guard = allocate(4);
    set_short("At the West Gate of "+CITY_NAME);
    set_long("You are at the West Gate of " + CITY_NAME + ".\
 A filthy looking bum is hanging around under the gate.");
    set_exits(([
	"east"	: CITY_DIR + "S1_7",
#ifdef AREA_WEST
	"west"	: WEST_PATH
#endif
      ]));
    add_command("west", "block_west");
    reset_room();
}

status
block_west()
{
    if (!interactive(this_player()) && this_player() ->
      id("city_"+(string)this_player()->query_real_name()))
	return 1;
    return 0;
}
/* Let's prevent guards etc. to leave the city. */
