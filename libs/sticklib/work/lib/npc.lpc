/*
 * FluffOS-compatible Stick NPC (Strategy A).
 * Original LDMud /lib/npc is preserved as /lib/npc_ldmud.lpc
 * (InitFunc closures, configure_object, spell_closure).
 */

#include <npc_defs.h>

inherit LIVING_FILE;

void create_monster() { }

void
create()
{
    enable_commands();
    ::create();
    this_object()->create_monster();
    if (query_name())
	set_living_name(query_name());
}

int query_npc() { return 1; }

void set_group(string s) { }

/* Combat spell hooks (LDMud npc_ldmud); storage only — heart_beat casting stays thin. */
nosave int spell_chance, spell_dmg, spell_dtype;
nosave mixed spell_mess1, spell_mess2;
nosave mixed *breath_attack;

void set_spell_chance(int c) { spell_chance = c; }
void set_chance(int c) { spell_chance = c; } /* alias; prefer set_spell_chance */

void
set_spell_mess1(mixed m)
{
    spell_mess1 = m;
}

void
set_spell_mess2(mixed m)
{
    spell_mess2 = m;
}

varargs void
set_spell_dam(int d, int type)
{
    spell_dmg = d;
    if (!type)
        spell_dtype = 2; /* DT_SLASH */
    else
        spell_dtype = type;
}

varargs void
set_breath_attack(int dmg, int chance, string my_msg, string their_msg, int dtype)
{
    breath_attack = ({ dmg, chance, my_msg, their_msg, dtype });
}


varargs int
attacked_by(object orig, int to_top, int flags)
{
    extra_attacked_by(orig);
    return ::attacked_by(orig, to_top, flags);
}

void
pick_any_obj()
{
    object ob, env;
    int wt;
    string s;

    env = environment();
    if (!env)
        return;
    ob = first_inventory(env);
    while (ob) {
        if (!interactive(ob)
          && !ob->is_corpse()
          && ob->get() && ob->short()) {
            s = (string)ob->query_name(0, this_object());
            if (!s)
                s = "something";
            wt = (int)ob->query_weight();
            if (!add_weight(wt)) {
                env->tell_here(sprintf("%s tries to take the %s but fails.",
                  query_name(), s), this_object());
                return;
            }
            move_object(ob, this_object());
            env->tell_here(sprintf("%s takes the %s.",
              query_name(), s), this_object());
            if ((int)ob->query_wc() > weapon_class)
                wield(ob, 0);
            else if (ob->query_ac()) {
                int old_class = query_ac();
                wear(ob, 0);
                if (query_ac() < old_class)
                    set_ac(old_class);
            }
            return;
        }
        ob = next_inventory(ob);
    }
}

void heart_beat() {
    ::heart_beat();
}

/* LDMud npc_ldmud reset chain (duel orcs call ::reset(arg)). */
varargs void
reset(int arg)
{
}

/* LDMud npc follow/block stubs (Strategy A). */
varargs void
set_follow(int f, int f_delay, int f_count_max, int f_buf_size)
{
}

varargs status
add_block(string direction, mixed type, mixed crit1, mixed crit2,
  string msg1, string msg2, string msg3, string msg4)
{
    return 1;
}

