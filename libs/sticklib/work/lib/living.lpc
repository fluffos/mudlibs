/*
 * FluffOS-compatible Stick living (Strategy A).
 * Original LDMud /lib/living is preserved as /lib/living_ldmud.lpc
 * (closures, LDMud foreach, configure_object, HitFunc).
 */

#include <living_defs.h>
#include <npc_defs.h>
#include <gender.h>
#include <stats.h>
#include <race.h>
#include <attack.h>

nosave string name;
nosave string *ids;
nosave string short_desc;
nosave string long_desc;
nosave string race;
nosave int hit_point;
nosave int max_hp;
nosave int level;
nosave int wc;
nosave int money;
nosave int spell_points;
nosave int max_sp;
nosave mapping Resistances;
nosave int alignment;
nosave int gender;
nosave int ep;
nosave int wander;
nosave int wimpy;
nosave int random_pick;
nosave int liv_Flags;
nosave int Str, Int, Con, Dex, Fatigue;
nosave int max_Str, max_Int, max_Con, max_Dex, max_Fatigue;
nosave object dead_ob;
nosave object attack;
nosave object attacker_ob;
nosave object alt_attacker_ob;
nosave int local_weight;
nosave int experience;
nosave string cap_name;
nosave int armour_class;
nosave int weapon_class;
nosave int dead;

void create_living() { }

void
create()
{
    hit_point = 20;
    max_hp = 20;
    spell_points = 50;
    max_sp = 50;
    level = 1;
    wc = 3;
    gender = G_NEUTER;
    Str = Int = Con = Dex = Fatigue = 10;
    max_Str = max_Int = max_Con = max_Dex = max_Fatigue = 10;
    this_object()->create_living();
}

void init() { }


void set_name(string s) {
    name = s;
    if (s) {
	set_living_name(s);
	cap_name = capitalize(s);
    }
    if (s && !short_desc)
	short_desc = s;
}

void set_id(mixed x) {
    if (pointerp(x))
	ids = x;
    else if (stringp(x))
	ids = ({ x });
    else
	ids = ({});
}

void set_short(mixed s) { if (stringp(s)) short_desc = s; }
void set_long(mixed s) { if (stringp(s)) long_desc = s; }
void set_level(int x) { level = x; }
void set_hp(int x) { hit_point = x; if (max_hp < x) max_hp = x; }
void set_wc(int x) { wc = weapon_class = x; }
void set_money(int x) { money = x; }
void set_alignment(int x) { alignment = x; }
nosave string guild;
void set_guild(string s) { guild = s; }
string query_guild() { return guild; }
void set_race(string s) { race = s; }
void set_gender(int x) { gender = x; }

int
set_stat(int st, int value)
{
    if (value < 1 && st != ST_FAT && st != ST_BASE_FAT)
        value = 1;
    switch (st) {
    case ST_STR: return (Str = max_Str = value);
    case ST_INT: return (Int = max_Int = value);
    case ST_CON: return (Con = max_Con = value);
    case ST_DEX: return (Dex = max_Dex = value);
    case ST_FAT: return (Fatigue = max_Fatigue = value);
    case ST_BASE_STR: return (max_Str = value);
    case ST_BASE_INT: return (max_Int = value);
    case ST_BASE_CON: return (max_Con = value);
    case ST_BASE_DEX: return (max_Dex = value);
    case ST_BASE_FAT: return (max_Fatigue = value);
    }
    return 0;
}

mixed
query_stat(int st)
{
    switch (st) {
    case ST_STR: return Str;
    case ST_INT: return Int;
    case ST_CON: return Con;
    case ST_DEX: return Dex;
    case ST_FAT: return Fatigue;
    case ST_BASE_STR: return max_Str;
    case ST_BASE_INT: return max_Int;
    case ST_BASE_CON: return max_Con;
    case ST_BASE_DEX: return max_Dex;
    case ST_BASE_FAT: return max_Fatigue;
    }
    return 0;
}

void set_keep_hb(int x) { }
void set_ep(int x) { ep = experience = x; }
void set_wander(int x) { wander = x; }
varargs void set_wimpy(int x) { if (undefinedp(x)) x = 20; wimpy = x; }
void set_random_pick(int x) { random_pick = x; }
void set_dead_ob(object ob) { dead_ob = ob; }
void set_ac(int x) { armour_class = x; }
int query_ac() { return armour_class; }
void set_invis(int x) { }
void load_chat(int chance, mixed msgs) { }
void load_a_chat(int chance, mixed msgs) { }
varargs void set_match(mixed a, mixed b, mixed c, mixed d) { }

varargs void
move_player(string dir_dest, mixed dest_ob)
{
    object d;
    string dir, dest;

    if (objectp(dest_ob))
	d = dest_ob;
    else if (stringp(dest_ob))
	catch(d = load_object(dest_ob));
    else if (stringp(dir_dest) && sscanf(dir_dest, "%s#%s", dir, dest) == 2)
	catch(d = load_object(dest));
    if (d)
	move_object(this_object(), d);
}

varargs void
set(mixed what, mixed arg)
{
    if (intp(what) && what > 0)
	liv_Flags |= what;
}

string query_name() { return name; }
string query_real_name() { return name; }
string query_race() { return race; }
int query_level() { return level; }
int query_hp() { return hit_point; }
int query_mhp() { return max_hp; }
int query_wc() { return wc; }
int query_money() { return money; }
int query_alignment() { return alignment; }
int query_gender() { return gender; }
int query_ep() { return experience || ep; }
int query_weight() { return local_weight; }
int query_local_weight() { return local_weight; }
varargs int add_weight(int w, int no_recount) {
    if (w + local_weight < 0) return 0;
    local_weight += w;
    return 1;
}
void recount_weight() {
    object ob;
    local_weight = 0;
    ob = first_inventory(this_object());
    while (ob) {
        local_weight += (int)ob->query_weight();
        ob = next_inventory(ob);
    }
}
varargs void wield(object ob, int silent) { }
varargs void wear(object ob, int silent) { }
varargs void unwear(object ob, int silent) { }
int query_ghost() { return 0; }
int query_coder_level() { return 0; }
int query_npc() { return 0; }
object query_attack() { return attack; }
string Pronoun() {
    if (gender == 1) return "he";
    if (gender == 2) return "she";
    return "it";
}
string Possessive() {
    if (gender == 1) return "his";
    if (gender == 2) return "her";
    return "its";
}
string Objective() {
    if (gender == 1) return "him";
    if (gender == 2) return "her";
    return "it";
}
string query_pronoun() { return Pronoun(); }
string query_possessive() { return Possessive(); }
string query_objective() { return Objective(); }

varargs mixed
query(mixed x)
{
    return 0;
}

varargs int
id(string s, mixed a, mixed b)
{
    if (!s)
	return 0;
    if (s == name)
	return 1;
    return ids && member(ids, s) >= 0;
}

varargs string
query_short(mixed a, mixed b)
{
    return short_desc || name;
}

varargs string
query_long(mixed a, mixed b)
{
    return long_desc || "You see nothing special.";
}

varargs mixed short(mixed a, mixed b) { return query_short(a, b); }
varargs mixed long(mixed a, mixed b) {
    string d;

    d = query_long(a, b);
    if (stringp(d))
	write(d + (d[<1] == '\n' ? "" : "\n"));
    return 1;
}

varargs int
tell_me(string s, mixed a, mixed b, mixed c, mixed d, mixed e)
{
    if (interactive(this_object()) && s)
	write(s + (s[<1] == '\n' ? "" : "\n"));
    return 1;
}

void init_command(string s) {
    if (s)
	command(s);
}

int run_away() { return 1; }

varargs int is_fighting(object x) {
    if (!x)
	return attack != 0;
    return attack == x;
}
int query_dead() { return dead; }
void set_dead(int x) { dead = x; }

void extra_attacked_by(object ob) { }

void die(object killer);
status attack();

varargs int
hit_player(int dam, mixed dtype, mixed hc, mixed enemy)
{
    if (!enemy)
	enemy = this_player();
    if (dam > 0)
	hit_point -= dam;
    if (hit_point < 0)
	hit_point = 0;
    if (enemy && enemy != this_object()) {
	attack = enemy;
	set_heart_beat(1);
    }
    if (hit_point < 1) {
	die(enemy);
	return dam;
    }
    return dam;
}

varargs int
attacked_by(object orig, int to_top, int flags)
{
    if (orig) {
	attack = orig;
	attacker_ob = orig;
    }
    set_heart_beat(1);
    return 1;
}

varargs void
attack_object(object x, int later)
{
    if (!x || x == this_object())
	return;
    attack = attacker_ob = x;
    set_heart_beat(1);
    if (!later)
	attack();
}

status
attack()
{
    int dam;
    object env, victim;
    string me, them;

    victim = attack;
    if (!victim)
	return 0;
    env = environment();
    if (!env || environment(victim) != env) {
	attack = 0;
	return 0;
    }
    dam = wc + random(wc > 0 ? wc : 1);
    if (dam < 1)
	dam = 1;
    me = query_name() || "Someone";
    them = victim->query_name() || "someone";
    env->tell_here(me + " hits " + them + ".");
    victim->hit_player(dam, 0, 0, this_object());
    return 1;
}

void
heart_beat()
{
    if (!attack) {
	set_heart_beat(0);
	return;
    }
    if (!objectp(attack) || environment(attack) != environment()) {
	attack = 0;
	set_heart_beat(0);
	return;
    }
    attack();
}

void
die(object killer)
{
    object env;
    int xp;
    string me;

    me = query_name() || "Something";
    env = environment();
    if (env)
	env->tell_here(me + " dies.");
    if (killer) {
	xp = ep;
	if (xp < 1)
	    xp = level * 20 + 10;
	if (function_exists("add_exp", killer))
	    killer->add_exp(xp);
	if (function_exists("tell_me", killer))
	    killer->tell_me("You killed " + me + ".");
    }
    if (dead_ob)
	catch(dead_ob->monster_died(this_object(), killer, 0));
    destruct(this_object());
}

/* LDMud living combat/condition stubs (Strategy A). */
varargs int
add_hp(int x, int flag)
{
    hit_point += x;
    if (hit_point > max_hp)
        hit_point = max_hp;
    if (hit_point < 0)
        hit_point = 0;
    return hit_point;
}

varargs void
stop_fight(object o, int flags)
{
    if (!o || o == attack)
        attack = 0;
}

nosave mapping conditions;

varargs mixed
query_condition(int c, int mode)
{
    if (!conditions)
        return 0;
    return conditions[c];
}

varargs int
set_condition(int condition, int duration, object item)
{
    if (!conditions)
        conditions = ([]);
    if (!duration)
        map_delete(conditions, condition);
    else
        conditions[condition] = duration;
    return 1;
}

/* LDMud basic/living/moving move messages (Strategy A). */
nosave string msgin, msgout, mmsgin, mmsgout;

status
set_move_msg(string which, string what)
{
    switch (which) {
    case "mout":
    case "msgout":
	msgout = what;
	break;
    case "min":
    case "msgin":
	msgin = what;
	break;
    case "mmout":
	mmsgout = what;
	break;
    case "mmin":
	mmsgin = what;
	break;
    default:
	return 0;
    }
    return 1;
}

string
query_move_msg(string which)
{
    switch (which) {
    case "mout":
    case "msgout":
	return msgout || "leaves";
    case "min":
    case "msgin":
	return msgin || "arrives";
    case "mmout":
	return mmsgout || "suddenly vanishes into thin air";
    case "mmin":
	return mmsgin || "arrives in a puff of smoke";
    default:
	return "<ERROR>";
    }
}

/* Strategy A stubs for LDMud living modules not inherited here. */
void
add_money(int m)
{
    money += m;
    if (money < 0)
	money = 0;
}

int
query_sp()
{
    return spell_points;
}

int
query_max_sp()
{
    return max_sp;
}

void
set_sp(int x)
{
    spell_points = x;
    if (max_sp < x)
	max_sp = x;
}

int
add_sp(int x)
{
    spell_points += x;
    if (spell_points > max_sp)
	spell_points = max_sp;
    if (spell_points < 0)
	spell_points = 0;
    return spell_points;
}

int
query_race_stat(int stat)
{
    /* Human-ish defaults so carry/heal math stays finite (see basic/living/race). */
    switch (stat) {
    case RACE_HP_RATE:
	return 8;
    case RACE_SP_RATE:
	return 9;
    case RACE_FP_RATE:
	return 8;
    case RACE_DRUNKNESS_RATE:
	return 8;
    case RACE_DAMAGE_RATE:
	return 100;
    case RACE_AC_RATE:
	return 100;
    case RACE_CARRY_RATE:
	return 3;
    case RACE_NATURAL_WC:
	return 3;
    case RACE_NATURAL_AC:
	return 0;
    case RACE_HEAL_RATE:
	return 8;
    case RACE_SP_HEAL_RATE:
	return 8;
    case RACE_EAT_RATE:
	return 8;
    case RACE_EAT_VALUE:
	return 8;
    case RACE_FP_HEAL_RATE:
	return 8;
    case RACE_HP_DELAY:
	return 8;
    case RACE_SP_DELAY:
	return 8;
    case RACE_FP_DELAY:
	return 8;
    }
    return 8;
}

int
set_resistance(int res, int value)
{
    if (!res || !value)
	return 0;
    if (!Resistances)
	Resistances = ([]);
    if (value > MAX_RES)
	value = MAX_RES;
    if (res == DT_PHYSICAL) {
	Resistances[DT_PHYSICAL] = value;
    } else
	Resistances[res] = value;
    return 1;
}

mixed
query_resistance(int res)
{
    if (!Resistances)
	return 0;
    return Resistances[res];
}

void
transfer_all_to(mixed dest)
{
    object ob, next, d;

    if (!dest)
	return;
    if (objectp(dest))
	d = dest;
    else if (stringp(dest))
	catch(d = load_object(dest));
    if (!d)
	return;
    ob = first_inventory(this_object());
    while (ob) {
	next = next_inventory(ob);
	move_object(ob, d);
	ob = next;
    }
}

/* Frog curse (LDMud living); Strategy A stub. */
nosave int frog;

varargs void
set_frog(int x)
{
    if (undefinedp(x))
	x = 1;
    frog = x;
}

void
frog_curse(int x)
{
    frog = x;
}

int
query_frog()
{
    return frog;
}

status
query_can_move()
{
    return 1;
}
