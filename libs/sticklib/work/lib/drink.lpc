/*
 * FluffOS-compatible Stick drink (Strategy A).
 * Original LDMud /lib/drink is preserved as /lib/drink_ldmud.lpc
 * (nosave closure, (: begin_drink :), foreach with lambda).
 *
 * Enough for /lib/pub order(): set_value("id#short#msg#heal#cost#str"),
 * set_id, set_pub, id("beer"), get(), query_weight — plus the potion
 * create_drink() setters (set_strength/set_soft/set_info/…).
 */

inherit "/basic/object/dimensions";

string name;
mixed short_desc;
mixed long_desc;
string drinker_mess;
string drinking_mess;
string container;
string liquid_name;
string info;
string read_msg;
string *ids;
int value;
int container_value;
int strength;
int heal_amount;
int from_pub;
int full;
int max_full;
status soft_drink;
status lords_only;
status unbreakable;
status no_heal;
status keep_short;
int invis_level;
string id_name;

void create()
{
    container = "bottle";
    container_value = 10;
    ids = ({});
    full = max_full = 1;
    drinker_mess = "Gloink Glurk Glburp.";
    this_object()->create_drink();
}

void create_drink() { }

int
set_value(mixed arg)
{
    string n, kludge;
    int heal, val, stren;

    if (intp(arg)) {
	value = arg;
	return arg;
    }
    if (!stringp(arg))
	return 0;
    if (sscanf(arg, "%s#%s#%s#%d#%d#%d", n, kludge, drinker_mess,
	heal, val, stren) != 6)
	return 0;
    name = n;
    if (!container)
	container = n;
    short_desc = kludge;
    long_desc = capitalize(kludge) + ".";
    heal_amount = heal;
    strength = stren;
    value = ((val * 2) / 3);
    return 1;
}

void
set_id(mixed x)
{
    if (pointerp(x))
	ids = x;
    else if (stringp(x))
	ids = ({ x });
    else
	ids = ({});
}

void set_long(mixed s) { long_desc = s; }
void set_short(mixed s) { short_desc = s; }
void set_name(string s) { if (stringp(s)) { name = s; id_name = s; } }
void set_invis(int x) { invis_level = x; }
int query_invis() { return invis_level; }
void set_pub() { from_pub = 1; }

void set_info(string str) { info = str; }
void set_read(string str) { read_msg = str; }
void set_strength(int s) { strength = s; }
void set_cost(int c) { value = c; }
void set_container_value(int v) { container_value = v; }
void set_drinking_mess(string dm) { drinking_mess = dm; }
void set_drinker_mess(string dm) { drinker_mess = dm; }
void set_empty_container(string ec) { container = ec; }
void set_soft(status s) { soft_drink = s; }
void set_type(status t) { lords_only = t; }
void set_unbreakable(status x) { unbreakable = x; }
void set_no_heal(status x) { no_heal = x; }
void set_full(int x) { if (x <= max_full) full = x; else full = max_full; }
void set_max_full(int x) { if (x > 0 && x < 12) max_full = x; else max_full = 1; }
void set_keep_short(status x) { keep_short = x; }
void set_liquid(string s) { liquid_name = s; }

status get() { return 1; }
int query_weight() { return weight ? weight : 1; }
int query_value() {
    if (full > 0)
	return container_value + value * full;
    return container_value;
}
int query_strength() { return strength; }
status query_soft() { return soft_drink; }
status query_unbreakable() { return unbreakable; }
status query_no_heal() { return no_heal; }
status query_type() { return lords_only; }
string query_container() { return container; }
int query_container_value() { return container_value; }
int query_full() { return full; }
int query_max_full() { return max_full; }
status query_keep_short() { return keep_short; }
string query_liquid() { return liquid_name; }
string query_info() { return info; }
status is_drink() { return 1; }

varargs string
query_name(mixed a, mixed b)
{
    return name || short_desc || "something";
}

varargs string
query_short(mixed a, mixed b)
{
    if (functionp(short_desc))
	return evaluate(short_desc, a, b);
    return stringp(short_desc) ? short_desc : name;
}

varargs string
query_long(mixed a, mixed b)
{
    if (functionp(long_desc))
	return evaluate(long_desc, a, b);
    return stringp(long_desc) ? long_desc : "A drink.";
}

varargs mixed short(mixed a, mixed b) { return query_short(a, b); }

varargs status
id(string s, object who)
{
    if (!s)
	return 0;
    if (s == name || s == container)
	return 1;
    return ids && member(ids, s) >= 0;
}
