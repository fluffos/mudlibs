/*
 * FluffOS-compatible Stick drink (Strategy A).
 * Original LDMud /lib/drink is preserved as /lib/drink_ldmud.lpc
 * (nosave closure, #'begin_drink, foreach with lambda).
 *
 * Enough for /lib/pub order(): set_value("id#short#msg#heal#cost#str"),
 * set_id, set_pub, id("beer"), get(), query_weight.
 */

string name;
string short_desc;
string long_desc;
string drinker_mess;
string container;
string *ids;
int value;
int strength;
int heal_amount;
int from_pub;

void create()
{
    container = "bottle";
    ids = ({});
}

int
set_value(mixed arg)
{
    string n, kludge;
    int heal, val, stren;

    if (intp(arg)) {
	value = arg;
	return arg;
    }
    if (!stringp(arg))
	return 0;
    if (sscanf(arg, "%s#%s#%s#%d#%d#%d", n, kludge, drinker_mess,
	heal, val, stren) != 6)
	return 0;
    name = n;
    if (!container)
	container = n;
    short_desc = kludge;
    long_desc = capitalize(kludge) + ".";
    heal_amount = heal;
    strength = stren;
    value = ((val * 2) / 3);
    return 1;
}

void
set_id(mixed x)
{
    if (pointerp(x))
	ids = x;
    else if (stringp(x))
	ids = ({ x });
    else
	ids = ({});
}

void set_long(string s) { if (stringp(s)) long_desc = s; }
void set_short(string s) { if (stringp(s)) short_desc = s; }
void set_name(string s) { if (stringp(s)) name = s; }
void set_pub() { from_pub = 1; }

status get() { return 1; }
int query_weight() { return 1; }
int query_value() { return value; }
int query_strength() { return strength; }
status is_drink() { return 1; }

varargs string
query_name(mixed a, mixed b)
{
    return name || short_desc || "something";
}

varargs string
query_short(mixed a, mixed b)
{
    return short_desc || name;
}

varargs string
query_long(mixed a, mixed b)
{
    return long_desc || "A drink.";
}

varargs mixed short(mixed a, mixed b) { return query_short(a, b); }

varargs status
id(string s, object who)
{
    if (!s)
	return 0;
    if (s == name || s == container)
	return 1;
    return ids && member(ids, s) >= 0;
}
