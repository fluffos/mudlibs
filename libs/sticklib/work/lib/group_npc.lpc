/*
 * FluffOS-compatible Stick group NPC (Strategy A).
 * Original LDMud /lib/group_npc is preserved as /lib/group_npc_ldmud.lpc
 * (m_allocate 2-index mappings, GROUP_D, SSF).
 */

#include <npc.h>

private nosave string group;

void
set_group(string str)
{
    group = str;
}

string query_group() { return group; }

nosave mapping group_messages;

/* Storage only; LDMud used m_allocate(1,2) wide maps + format strings. */
varargs void
set_group_message(string msg, string text1, string text2)
{
    if (!group_messages)
        group_messages = ([]);
    group_messages[msg] = ({ text1, text2 });
}

mapping query_group_messages() { return group_messages; }


int
group_attacked(object victim, object attacker, object *members)
{
    return 0;
}
