/*
 * FluffOS-compatible Stick room (Strategy A).
 * Original LDMud /lib/room is preserved as /lib/room_ldmud.lpc
 * (closures, symbol_function, 3-arg implode, GMCP/party daemons).
 */

#include <room_defs.h>
#include <weatherdesc.h>
#include <lights.h>

#define F_ROOM_RESET_USED  1
#define F_ROOM_INIT_USED   2

nosave int flags;
nosave int outdoorness;
nosave int light_level;
nosave int room_flags;
/* Terrains and rooms assign short_desc/long_desc directly; private blocks them. */
nosave mixed short_desc;
nosave mixed long_desc;
nosave mapping Exits;
nosave mapping Items;
nosave mapping commands;
nosave mixed *room_effects;

void _apply_calls(object ob, mixed *spec);

varargs void
_apply_calls(object ob, mixed *spec)
{
    mixed *call;
    int i, n;

    if (!ob || !pointerp(spec))
	return;
    n = sizeof(spec);
    for (i = 0; i < n; i++) {
	call = spec[i];
	if (!pointerp(call) || !sizeof(call) || !stringp(call[0]))
	    continue;
	switch (sizeof(call)) {
	case 1:
	    call_other(ob, call[0]);
	    break;
	case 2:
	    call_other(ob, call[0], call[1]);
	    break;
	case 3:
	    call_other(ob, call[0], call[1], call[2]);
	    break;
	default:
	    call_other(ob, call[0], call[1], call[2], call[3]);
	    break;
	}
    }
}

void set_short(mixed s) { if (stringp(s)) short_desc = s; }
void set_long(mixed s) { if (stringp(s)) long_desc = s; }
void set_light_level(int x) {
    light_level = x;
    set_light(x);
}

void
set_exits(mapping x)
{
    if (mapp(x))
	Exits = x + ([]);
}

void
set_items(mapping x)
{
    if (mapp(x))
	Items = x + ([]);
}

void
set_commands(mapping x)
{
    if (mapp(x))
	commands = x + ([]);
}

varargs void
set(mixed what, mixed arg)
{
    if (what == ROOM_WD) {
	outdoorness = arg;
	return;
    }
    if (intp(what) && what > 0)
	room_flags |= what;
}

varargs mixed
query(int x)
{
    if (x == ROOM_WD)
	return outdoorness;
    if (x == NO_PK)
	return (room_flags & NO_PK) != 0;
    if (x == IN_CITY)
	return (room_flags & IN_CITY) != 0;
    if (x == PREVENT_TELEPORT)
	return (room_flags & PREVENT_TELEPORT) != 0;
    return 0;
}

mapping query_exits() { return Exits; }

string
query_exit(string dir)
{
    if (!dir || !Exits)
	return 0;
    return Exits[dir];
}

string
query_short()
{
    return short_desc;
}

string
query_exit_string()
{
    string *dirs;
    string out;
    int i, n;

    if (!Exits || !sizeof(Exits))
	return "No obvious exits.\n";
    dirs = keys(Exits);
    n = sizeof(dirs);
    if (n == 1)
	return "The only obvious exit is " + dirs[0] + ".\n";
    out = "The obvious exits are ";
    for (i = 0; i < n; i++) {
	if (i == n - 1)
	    out += " and " + dirs[i];
	else if (i)
	    out += ", " + dirs[i];
	else
	    out += dirs[i];
    }
    return out + ".\n";
}

varargs string
query_long(string str, object who)
{
    mixed val;

    if (str && str != "") {
	if (Items && (val = Items[str])) {
	    if (stringp(val) && strlen(val) && val[0] == '=')
		val = Items[val[1..]];
	    if (stringp(val) && strsrch(val, " ") == -1
		&& function_exists(val, this_object()))
		val = call_other(this_object(), val);
	    if (stringp(val))
		return val;
	}
	return 0;
    }
    return long_desc;
}

string
query_exit_list(int mode)
{
    return query_exit_string();
}

varargs int
id(string str, object who)
{
    return Items && str && Items[str];
}

varargs int
add_object(mixed filename, string appearmsg, int reset_chance)
{
    object ob;

    if (stringp(filename))
	catch(ob = clone_object(filename));
    else if (pointerp(filename) && sizeof(filename) && stringp(filename[0])) {
	catch(ob = clone_object(filename[0]));
	if (ob)
	    _apply_calls(ob, filename[1..]);
    }
    if (ob)
	move_object(ob, this_object());
    return ob ? 1 : 0;
}

varargs int
add_monster(mixed filename, string appearmsg, int reset_chance)
{
    return add_object(filename, appearmsg, reset_chance);
}

void
add_exit(string dir, mixed dest)
{
    if (!dir)
	return;
    if (!Exits)
	Exits = ([]);
    if (!dest)
	map_delete(Exits, dir);
    else
	Exits[dir] = dest;
}

void
remove_exit(string dir)
{
    if (!dir || !Exits)
	return;
    map_delete(Exits, dir);
}

varargs int
add_item(mixed names, mixed desc)
{
    int i;

    if (!desc)
	return 0;
    if (!Items)
	Items = ([]);
    if (stringp(names)) {
	Items[names] = desc;
	return 1;
    }
    if (!pointerp(names) || !sizeof(names))
	return 0;
    Items[names[0]] = desc;
    for (i = 1; i < sizeof(names); i++)
	if (stringp(names[i]))
	    Items[names[i]] = "=" + names[0];
    return 1;
}

varargs int
add_permanent(string filename)
{
    object ob;

    if (!stringp(filename))
	return 0;
    catch(ob = clone_object(filename));
    if (!ob)
	return 0;
    move_object(ob, this_object());
    return 1;
}

/*
 * LDMud rooms use add(ROOM_EFFECT|ROOM_EXIT|ROOM_ITEM, …) from
 * basic/room/set_n_query. Strategy A never shipped that; virtual_room
 * set_effects() and any room calling add(ROOM_*) failed Undefined.
 */
status
add(int what, mixed arg1, mixed arg2)
{
    switch (what) {
    case ROOM_EFFECT:
	if (!room_effects || !sizeof(room_effects)) {
	    room_effects = ({ arg1, arg1, arg2 });
	} else {
	    room_effects += ({ arg1, arg2 });
	    room_effects[0] += arg1;
	}
	return 1;

    case ROOM_EXIT:
	add_exit(arg1, arg2);
	return 1;

    case ROOM_ITEM:
	return add_item(arg1, arg2);
    }
    return 0;
}

int
add_command(string cmd_name, mixed cmd_func)
{
    if (!stringp(cmd_name))
	return 0;
    if (!commands)
	commands = ([]);
    if (!cmd_func) {
	map_delete(commands, cmd_name);
	return 1;
    }
    commands[cmd_name] = cmd_func;
    return 1;
}

varargs int
move(string dir, mixed room)
{
    if (!this_player())
	return 0;
    if (!dir)
	dir = query_verb();
    if (!room && (!Exits || !(room = Exits[dir])))
	return 0;
    if (stringp(room))
	this_player()->move_player(dir + "#" + room);
    else if (objectp(room))
	this_player()->move_player(dir, room);
    return 1;
}

/*
 * LDMud rooms take tell_here(mixed msg, sense, flags, skip, me, him, it)
 * where msg may be a string or string array (fstring). Strategy A only
 * needs enough arity/types for priest rooms to compile; formatting stays thin.
 */
varargs int
tell_here(mixed msg, mixed sense, mixed flags, mixed skip,
  object me, object him, object it)
{
    object *inv;
    int i;
    string s;

    if (objectp(sense) || (pointerp(sense) && sizeof(sense) && objectp(sense[0]))) {
	skip = sense;
	sense = 0;
    }
    if (pointerp(msg) && sizeof(msg))
	s = stringp(msg[0]) ? msg[0] : "";
    else if (stringp(msg))
	s = msg;
    else
	return 0;
    if (!s || s == "")
	return 0;
    inv = all_inventory(this_object());
    for (i = 0; i < sizeof(inv); i++) {
	if (objectp(skip) && inv[i] == skip)
	    continue;
	if (pointerp(skip) && member_array(inv[i], skip) >= 0)
	    continue;
	if (!living(inv[i]))
	    continue;
	if (function_exists("tell_me", inv[i]))
	    inv[i]->tell_me(s);
	else
	    tell_object(inv[i], s + "\n");
    }
    return 1;
}

void
create()
{
    if (!Exits)
	Exits = ([]);
    if (!Items)
	Items = ([]);
    if (!commands)
	commands = ([]);
    if (function_exists("reset_room", this_object()))
	flags |= F_ROOM_RESET_USED;
    this_object()->create_room();
    if (function_exists("init_room", this_object()))
	flags |= F_ROOM_INIT_USED;
    if (flags & F_ROOM_RESET_USED)
	this_object()->reset_room();
}

void
reset()
{
    if (flags & F_ROOM_RESET_USED)
	this_object()->reset_room();
}

void
init()
{
    add_action("command_driver", "", 1);
    if (flags & F_ROOM_INIT_USED)
	this_object()->init_room();
}

int
command_driver(string s)
{
    string v;
    mixed f;
    int ret;

    v = query_verb();
    if (commands && (f = commands[v])) {
	if (stringp(f))
	    ret = call_other(this_object(), f, s);
	if (ret)
	    return ret;
    }
    if (Exits && (f = Exits[v]) && (stringp(f) || objectp(f))) {
	ret = move(v, f);
	if (ret)
	    return ret;
    }
    return 0;
}

varargs int
long(mixed what, mixed who)
{
    string desc;

    desc = query_long(what, who);
    if (stringp(desc) && desc != "") {
	write(desc);
	if (desc[<1] != '\n')
	    write("\n");
	if (!what || what == "")
	    write(query_exit_string());
	return 1;
    }
    return 0;
}

void
heart_beat()
{
    int i, r;

    if (!pointerp(room_effects) || !sizeof(room_effects))
	return;
    if ((r = random(100)) >= room_effects[0])
	return;
    i = 1;
    while (i < sizeof(room_effects)) {
	if (r < room_effects[i]) {
	    tell_here(room_effects[i + 1]);
	    break;
	}
	i += 2;
    }
}
