
#include <combat.h>
inherit SKILL;


string *parry_msg = ({

        "却见$n踏前一步，剑式斜指你的右臂，想要使$P闪身而退。\n",

		"$n以攻为守，以进为退，凝神运气向$P猛攻快打地挥出方位大异的三剑。\n",
		"$n剑法突变，剑势伸缩不定，奔腾矫夭，企图迫使$P变招。\n",

		"$n突然一剑点向$P的$l，虽一剑却暗藏无数后着，$P手足无措，攻势不由自主停了下来！\n",

                "$n不闪不避，举剑闪电般反削$P的$l，想挡过你此招。\n",

		"$n挺剑一招回刺$P的$l，企图将$P的攻势化解。\n",

		"只见$n不退反进，身如飘风，动向无定不可捉摸地挡住了$P的\n进攻。\n",

		"$n不退反进，森森剑气充溢四周！架开了$P的这招\n",

});


