// weizheng-steps.c 威震八方步
// wuliao 1999.12.15
#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
  HIR "只见$n一招" HIW "「脚踏乾坤」" NOR "，不闪不躲，硬捱$N这一招 ，人却借力飘远。\n",
  HIM "$n一式" YEL "「屹立如山」" NOR "，直扑而上，被$N这一招击中面门，却混若不觉。。\n"
  HIW "$n使出" MAG "「源远流长」" NOR "，一个空心筋斗向后翻出，避开了$N的凌厉攻势。\n",
  BLU "$n一招" HIC "「君临天下」" NOR "，身随意转，$N只觉眼前一花，$n冲至$N的面前，脸对脸而立，令$N出了一身冷汗。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练威震八方步。\n");
  me->receive_damage("qi", 30);
  return 1;
}
