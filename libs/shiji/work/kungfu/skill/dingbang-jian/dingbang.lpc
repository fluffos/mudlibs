// dingbang.c 一剑定邦

#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  string msg;
  object weapon, target;
  int skill, ap, dp, neili_wound, qi_wound;

  me->clean_up_enemy();
  target = me->select_opponent();

  skill = me->query_skill("dingbang-jian", 1);

  if (!(me->is_fighting()))
    return notify_fail("「一剑定邦」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if (skill < 90)
    return notify_fail("你的定邦剑法等级不够, 不能使用" HIW "「一剑定邦」" NOR "！\n");

  if (me->query("neili") < 250)
    return notify_fail("你的内力不够，无法运用" HIW "「一剑定邦」" NOR "！\n");

  msg = HIR
    "$N一声清啸，剑发虎啸，深吸一口气，剑附内力，一式「一剑定邦」，" + weapon->name() + "闪动不止，剑影如夜幕般扑向$n。\n";
  message_vision(msg, me, target);

  ap = me->query_skill("sword") + skill;
  dp = target->query_skill("force") / 2;
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("neili", -150);
    msg = BLU
      "$n顿时觉得眼前剑光如潮水般涌来，双耳被剑气震的嗡嗡内鸣，整个人横空飞了出去！\n" NOR;
    qi_wound = (int)me->query_skill("dingbang-jian", 1) + (int)me->query_skill("sword", 1) / 2;
    qi_wound = qi_wound / 2 + random(qi_wound);
    if (qi_wound > target->query("qi"))
      qi_wound = target->query("qi");

    target->receive_damage("qi", qi_wound);
    target->receive_wound("qi", qi_wound / 2);
    target->start_busy(2);
    me->start_busy(5);
  } else {
    if (userp(me))
      me->add("neili", -100);
    msg = HIW
      "可是$n宁心静气，运足全身功力后撤，$n忽然只觉得头上一凉，头发洒了一地。\n" NOR;
    me->start_busy(random(3));
  }
  message_vision(msg, me, target);
  if (!target->is_fighting(me)) target->fight_ob(me);
  return 1;
}
