// dingbang-jianfa.c 定邦剑法

#include <ansi.h>

inherit SKILL;

mapping *action = ({
    ([  "name":         "儿女情长只恨短",
        "action":      BLU "$N使一招"HIR"「儿女情长只恨短」"NOR"，"HIR"身形向上飘起，手中$w虚虚实实幻出万点剑花纷纷扬扬撒向$n$l",
        "force":        100,
                "parry":        5,
        "damage":       40,
                "damage_type":  "刺伤"
        ]),
    ([  "name":         "当世我称雄",
        "action":      HIR "$N舞动$w，一式"HIC"「当世我称雄」，左手向$n面门一晃，右手$w抖出几朵剑花挟着虎虎剑气直逼向$n的$l",
        "force":        140,
        "parry":        -20,
        "damage":       50,
        "damage_type":  "刺伤"
    ]),
    ([  "name":         "欲与天公试比高",
        "action":      HIM "$N身形绕$n一转，手中$w望空一指，一式"HIB"「欲与天公试比高」"NOR""HIM"幻出满天剑影，向$n$l接连挥出数剑",
        "force":        180,
                "dodge":        10,
        "damage":       70,
                "damage_type":  "割伤"
        ]),
    ([  "name":         "傲立群雄无所惧",
        "action":      HIW "$N身形飘然而起，在半空中身子一旋，悠然一式"YEL"「傲立群雄无所惧」"NOR""BLU"手中$w若有若无淡淡刺向$n的$l",
        "force":        210,
                "dodge":                -10,
        "damage":       120,
                "damage_type":  "刺伤"
        ]),
    ([  "name":         "将军难免阵前亡",
        "action":      YEL "$N纵起丈余，一式"BLU"「将军难免阵前亡」"NOR""HIR"，手中$w舞成一个光球罩向$n的$l",
        "force":        240,
        "dodge":        10,
        "damage":       120,
        "damage_type":  "刺伤"
    ]),
    ([  "name":         "功败垂成",
        "action":      HIC "$N一声大喝使出"BLU"「功败垂成」"NOR"，"WHT"手中$w幻出漫天剑影，迅若奔雷射向$n的$l",
        "force":        280,
        "dodge":        15,
        "damage":       140,
        "damage_type":  "刺伤"
    ]),
    ([  "name":         "天上天下，唯吾独尊",
        "action":      BLU "$N轻叹一声，手中$w怀中一抱，一招"HIW"「天上天下，唯吾独尊」"NOR"，"RED"$w锵然一声直飞冲天，凌厉的剑气直扑向$n的$l",
        "force":        320,
        "dodge":        0,
        "damage":       140,
        "damage_type":  "刺伤"
    ]),

});

int valid_learn(object me)
{
        object ob;

  if( (int)me->query_skill("baqi-jue",1) < 30)
   return notify_fail("你的霸气诀火候还不够。\n");

    if( (int)me->query("max_neili") < 100 )
 return notify_fail("你的内力不够，不能练定邦剑法。\n");

        if (!objectp(ob = me->query_temp("weapon"))
        || (string)ob->query("skill_type") != "sword")
                return notify_fail("你必须先找一把剑才能学习剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        object ob;

    if( (int)me->query("qi") < 30
    ||  (int)me->query("neili") < 5 )
        return notify_fail("你的内力或气不够，没有办法练习定邦剑法。\n");

        if (!objectp(ob = me->query_temp("weapon"))
        || (string)ob->query("skill_type") != "sword")
                return notify_fail("你必须先找一把剑才能习练剑法。\n");

    me->receive_damage("qi", 30);
        me->add("force", -5);
    write("你按著所学练了一遍定邦剑法。\n");
        return 1;
}

string perform_action_file(string action)
{
    return __DIR__"dingbang-jian/" + action;
}



