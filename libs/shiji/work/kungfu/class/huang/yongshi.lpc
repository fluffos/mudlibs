// yongshi.c

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("皇族勇士", ({ "yong shi", "shi" }));
  set("long",
    "他就是皇族勇士。\n"
    "他看起来三十多岁了。\n");
  set("gender", "男性");
  set("age", 32);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 25);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 3500);
  set("max_jing", 1500);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 1200);
  set("combat_exp", 120000);
  set("score", -7000);

  set_skill("force", 100);
  set_skill("baqi-jue", 100);
  set_skill("dodge", 100);
  set_skill("weizhen-steps", 120);
  set_skill("unarmed", 150);
  set_skill("chiyan-quan", 120);
  set_skill("parry", 100);
  set_skill("cuff", 120);
  set_skill("literate", 70);
  map_skill("force", "baqi-jue");
  map_skill("dodge", "weizhen-steps");
  map_skill("parry", "bashan-zhang");
  map_skill("cuff", "chiyan-quan");

  set("chat_chance", 1);
  set("chat_msg", ({
    "皇族勇士大声吼道：皇族无敌，君临天下！\n",
    "皇族勇士自言自语的说：君临天下可能吗？\n",
    "皇族勇士说道：你想成名吗？要是想的话还是入我皇族吧！。\n",
  }));
  setup();
  carry_object("/d/huang/obj/shoujia")->wear();

}
