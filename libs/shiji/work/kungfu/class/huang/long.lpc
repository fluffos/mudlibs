inherit NPC;

void create()
{

        set_name("食肉龙", ({ "shirou long","long" }) );
        set("gender", "无性" );
        set("age",1000);
set("long",
"食肉龙是天广皇当年征服龙族时的战俘，因其一身好厨艺而
留下了一条命。\n" );
        set("per", 30);
        set("class", "scholar");
        set("combat_exp", 10000);

        set_skill("unarmed",70);
        set_skill("dodge", 80);

        set("chat_chance", 7);
        set("chat_msg", ({
        "食肉龙低吼了一声。。。！\n",
        "食肉龙吐起了白沫。。。。！\n",
        "食肉龙说道：您饿不饿？吃不吃肉？。\n",
        }) );
        setup();
        carry_object("/d/huang/obj/shoujia")->wear();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }

}

void greeting(object ob)
{
        object teatp,foodtp;
        if( !ob || environment(ob)!=environment() )
{say("食肉龙微笑着说： 这位"+RANK_D->query_respect(ob)+"，你好！欢迎来到皇族！\n");               
 return;}
        else
        {
                tell_room(environment(this_object()),"食肉龙奉上茶饭，微笑着说道：这位" + RANK_D->query_respect(ob)+ "，你好！欢迎来到皇族。请用！\n");
                teatp = new("/d/huang/obj/renxue");
                teatp ->move(ob);
                foodtp= new("/d/huang/obj/rou");
                foodtp->move(ob);
                command ("say 这是我亲手做的，请您品尝！\n");
        }
}
