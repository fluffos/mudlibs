// shinv.c

inherit NPC;

void create()
{
  set_name("侍女", ({"shinv","nv"}));
  set("long","一个美丽的侍女。\n");
  set("gender", "女性");
  set("age", 14);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("combat_exp",6000);
  setup();
  carry_object("/d/huang/obj/cai-cloth")->wear();
}
