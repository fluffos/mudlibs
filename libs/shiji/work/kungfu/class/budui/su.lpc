// su.c 苏维安中队长

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();
string ask_him();
void create() {
  set_name("苏唯安", ({ "su weian", "su" }));
  set("long",
    "他就是特种部队里负责训练特种兵的高级教官。\n"
    "他已年过五十，身材高大，混身冒出一股杀气。\n");
  set("gender", "男性");
  set("age", 51);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 25);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 100);
  set("combat_exp", 800000);
  set("score", -7000);

  set_skill("rennai", 120);
  set_skill("jianti-shu", 120);
  set_skill("force", 120);
  set_skill("jiqi-gaizao", 120);
  set_skill("dodge", 130);
  set_skill("jiqi-qudong", 120);
  set_skill("gun", 120);
  set_skill("jiguang-gun", 100);
  set_skill("parry", 120);
  set_skill("literate", 130);
  map_skill("force", "jiqi-gaizao");
  map_skill("rennai", "jianti-shu");
  map_skill("dodge", "jiqi-qudong");
  map_skill("parry", "jiguang-gun");
  map_skill("gun", "jiguang-gun");
  set("inquiry", ([
    "训练": (: ask_me :),
    "完成": (: ask_him :),
  ]));
  create_family("特种部队", 3, "中队长");
  setup();
  carry_object("/clone/weapon/gun")->wield();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("jiqi-gaizao", 1) < 60) {
    command("say 你的机器改造还没到家");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("say 希望你杀人无数,发扬我特种部队!");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "killer")
    ob->set("class", "killer");
}

string ask_me() {
  object me;
  me = this_player();
  if (me->query("family/family_name") != "特种部队") return "你不是特种部队成员，不能参加训练！\n";
  if (me->query("combat_exp") > 500000) return "你已经不需要通过物理修炼来提高自己的战斗力了！\n";
  if (me->query_temp("xunlian") == 1) return "你已经有任务在身了！\n";
  tell_object(me, HIW "那好吧，你先去体力训练室训练！\n" NOR);
  me->set_temp("xunlian", 1);
  return "快点！\n";
}

string ask_him() {
  int money;
  int exp, pot;
  object me;
  me = this_player();
  if (me->query_temp("minjiefin") != 1) return "你的任务还没完成！\n";
  exp = 80 + random(25);
  pot = random(80);
  money = random(50);
  tell_object(me, HIY "苏唯安对着你点点头说：干得不错！\n" NOR);
  tell_object(me, HIM "你被奖励了：\n");
  tell_object(me, HIW "" + sprintf("%d点战斗力、%d点学习值，%d点电子货币。", exp, pot, money) + "\n" NOR);
  me->add("combat_exp", exp);
  me->add("money", money);
  me->add("potential", pot);
  me->set_temp("minjiefin", 0);
  return "好样的！\n";
}
