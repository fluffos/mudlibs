#include <ansi.h>
#define LAST_PAR "bc"
#define THIS_PAR "bcsf"
#define GIFT_NAME "新世纪礼物"
inherit ITEM;
void create()
{
    set_name(HIR + GIFT_NAME + NOR, ({"gift","liwu"}));
    set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
        set("long",
              HIR+"                ┌──────────────────────┐
                │                                            │ 
                │  "HIY"    世纪，所有巫师。"HIR"                      │ 
                │                                            │ 
                │   "HIY"    向所有的玩家问好，HAPPY HAPPY"HIR"        │ 
                │                                            │ 
                │   "HIY"         希望你们能够快乐!  "HIR"             │ 
                │                                            │ 
                │                                            │ 
                │                       "HIW"       addoil!"HIR"       │ 
                │                       "HIG"          桃太朗  "HIR"   │ 
                └──────────────────────┘
世纪 巫师的一点小心意，请打开(chai)来看看是什么？
"NOR
);
    set("value", 0);
    set("no_give",1);
    set("no_get",1);
    set("no_put",1);
    set("no_drop",1);
  }
    setup();
}
void init()
{
    add_action("do_chai", "chai");
}
int do_chai(string arg)
{
     object me = this_player();
   
  if (!id(arg))  return notify_fail("你要拆什么？\n");

  if (!me->query(THIS_PAR + "_chai"))  {

       me->add("potential",15000);
       me->add("combat_exp",50000) ;
       me->add("max_neili",1000) ;


    tell_object(me,HIG "财神爷在你的耳边悄声说道：恭喜发财！快用hp 看看！\n");
//删除上次派礼物生成的参数，增加本次参数，确保每位玩家只能用一次。
      me->delete(LAST_PAR + "_chai");
      me->set(THIS_PAR + "_chai",1);
  } else {
      tell_object(me,HIC "你小心翼翼的拆开礼物包，只见一阵烟雾过后，你顿时隐隐约约感到自己身体没有任何变化。\n" NOR);
  }
     destruct(this_object());
     return 1;
}
void owner_is_killed() { destruct(this_object()); }


