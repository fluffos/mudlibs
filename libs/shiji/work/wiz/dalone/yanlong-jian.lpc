// yanlong-jian.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIR "真·炎龙剑" NOR, ({ "yanlong","sword" }));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "这是把奇怪的兵器，剑上篆刻着几个字"HIR"‘邪不胜正’。\n");
                set("value", 4000000);
                set("material", "steel");
                set("wield_msg", MAG "$N「唰」的一声抽出一柄$n"MAG"握在手中，只觉一股热气扑面而来。\n");
                set("unwield_msg", HIW "$N将手中的$n"HIW"插回剑鞘，只听嗤的一声轻响。\n");
        }
 init_sword(5000);
        setup();
}
int query_autoload()
{
        return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{

        victim->receive_wound("qi",50);
        return HIR "真·炎龙剑剑身散发出一股猩红的火焰，燎烤着$n的全身。\n" NOR;

}