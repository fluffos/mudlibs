// boots.c 炎龙战靴
 
#include <armor.h>
 
inherit BOOTS;
 
void create()
{
	set_name("炎龙战靴", ({ "boots", "long xue", "xue" }) );
	set_weight(3800);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "gold");
		set("unit", "双");
		set("long", "这就是传说中的炎龙战靴。\n");
		set("value", 2221000);
		set("armor_prop/dodge", 2000);
	}
	setup();
}
int query_autoload()
{
        return 1;
}