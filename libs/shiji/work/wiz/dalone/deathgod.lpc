// deathgod.c 死神

inherit NPC;
inherit F_MASTER;

string ask_me();

void create() {
  set_name("死神", ({ "death god", "death", "god" }));
  set("long",
    "他就是索尔的手下死神。\n"
    "主管暗黑门的俗事。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 10000);
  set("max_jing", 8000);
  set("neili", 10000);
  set("max_neili", 10000);
  set("jiali", 300);

  set("combat_exp", 700000);
  set("score", 8500);

  set_skill("force", 260);
  set_skill("anhei-shengong", 240);
  set_skill("dodge", 270);
  set_skill("guimei", 250);
  set_skill("unarmed", 260);
  //	set_skill("duzun-zhao", 260);
  set_skill("parry", 260);
  set_skill("blade", 260);
  set_skill("shixue-daofa", 240);
  set_skill("anhei-xinfa", 260);
  set_skill("literate", 280);

  map_skill("force", "anhei-shengong");
  map_skill("dodge", "guimei");
  //	map_skill("unarmed", "duzun-zhao");
  map_skill("parry", "shixue-daofa");
  map_skill("blade", "shixue-daofa");

  create_family("暗黑门", 2, "死神");
  set("class", "anhei");

  set("inquiry",
    ([
      "邪恶的心法": (: ask_me :),
    ]));

  set("book_count", 1);

  setup();
  carry_object("/d/anhei/obj/sishen-pao.lpc")->wear();
  carry_object("/d/anhei/obj/sishen-dao.lpc")->wield();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") > 0) {
    command("say 我暗黑门乃是堂堂大派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
}

string ask_me() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family"))
    || fam["family_name"] != "暗黑门")
    return RANK_D->query_respect(this_player()) + "你什么时候知道这个的？？";
  if (query("book_count") < 1)
    return "你来晚了，本门的暗黑心经不在此处。";
  add("book_count", -1);
  ob = new("/class/anhei/force_book");
  ob->move(this_player());
  return "好吧，这本「暗黑心经」你拿回去好好钻研。";
}
