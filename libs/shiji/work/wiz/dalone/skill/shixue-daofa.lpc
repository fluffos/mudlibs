// shixue-daofa.c 嗜血刀法
#include <ansi.h>

inherit SKILL;

mapping *action = ({
([	"action" : "$N手中$w乱抡，反身一顿，一刀向$n的$l撩去",
	"force" : 120,
	"dodge" : -10,
	"lvl" : 0,
	"skill_name" : "乱抡",
	"damage_type" : "割伤"
]),
([	"action" : "$N一招"HIR"「地狱之火」"NOR"，左右腿虚点，$w一提一收，平刃挥向$n的颈部",
	"force" : 140,
	"dodge" : -10,
	"damage" : 55,
	"lvl" : 20,
	"skill_name" : "地狱之火",
	"damage_type" : "割伤"
]),
([	"action" : "$N展身虚步，提腰跃落，一招"HIW"「无发无天」"NOR"，刀锋化作两股斩向$n",
	"force" : 160,
	"dodge" : -5,
	"damage" : 75,
	"lvl" : 50,
	"skill_name" : "无法无天",
	"damage_type" : "割伤"
]),
([	"action" : "$N一招"BLK"「日月无光」"NOR"，$w大开大阖，自上而下划出一个大弧，笔直劈向$n",
	"force" : 180,
	"dodge" : 5,
	"damage" : 125,
	"lvl" : 130,
	"skill_name" : "日月无光",
	"damage_type" : "割伤"
]),
([	"action" : "$N手中$w一沉，一招"MAG"「色胆包天」"NOR"，双手持刃拦腰反切，砍向$n的裆部",
	"force" : 200,
	"dodge" : 10,
	"damage" : 140,
	"lvl" : 140,
	"skill_name" : "色胆包天",
	"damage_type" : "割伤"
]),
([	"action" : "$N挥舞$w，使出一招"BLINK+WHT"「万劫不复」"NOR"，上劈下撩，左挡右开，齐齐罩向$n",
	"force" : 250,
	"dodge" : 15,
	"damage" : 200,
	"lvl" : 150,
	"skill_name" : "万劫不复",
	"damage_type" : "割伤"
])
});


int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 250)
		return notify_fail("你的气息不够。\n");
	if ((int)me->query_skill("anhei-shengong", 1) < 110)
		return notify_fail("你的「暗黑神功」火候太浅。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("shixue-daofa",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练「嗜血刀法」。\n");
	me->receive_damage("qi", 25);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"shixue-daofa/" + action;
}