//yeren-shengong.c 野人神功
// By Dalone

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  int lvl = (int)me->query_skill("yeren-shengong", 1);

  if (me->query("gender") == "无性" && lvl > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会过于简单的野人神功。\n");
}

int practice_skill(object me) {
  return notify_fail("野人神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "yeren-shengong/" + func;
}
