// boots.c 踏风靴
 
#include <armor.h>
 
inherit BOOTS;
 
void create()
{
	set_name("踏风靴", ({ "boots", "wind xue", "xue" }) );
	set_weight(3800);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "gold");
		set("unit", "双");
		set("long", "这就是传说中的踏风靴。\n");
		set("value", 2221000);
		set("armor_prop/dodge", 500);
	}
	setup();
}
int query_autoload()
{
        return 1;
}