#include <ansi.h>#include __DIR__"eff_msg.h";

inherit SKILL;




string *dodge_msg = ({

  "$n一招「日长一线」，左右一闪，掩住身形去处，轻飘飘腾身丈外，躲过了$N这一招。\n",

  "$n突然加快脚步，$N分不清$n的身影，手下不由一顿，$n已借这「暗无天日」的步法，
避开了$N的凌厉攻势。\n",

  "$n使出「白日升天」，腾空跳起数丈,$N眼前失去了$n的身影。\n",

  "$n双足在地上一点，眼看$N杀招堪堪袭来，左膝一弯，正是一招「拨云见日」，
身躯已借势平移，闪过一旁。\n",

  "$n一式「偷天换日」，身体贴地滑行，顺势一个空翻，令$N的攻击已然扑空。\n",

});


int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}


int valid_learn(object me) {
  return 1;
}


string query_dodge_msg(object me)

{

  return dodge_msg[random(sizeof(dodge_msg))];


}


int practice_skill(object me)

{

  if ((int)me->query("jingli") < 40)

    return notify_fail("你该休息一下了，等会再练旭日东升吧。\n");

  me->receive_damage("jingli", 30);

  return 1;

}

string perform_action_file(string action) {
  return __DIR__ "xuri-dongsheng/" + action;
}
