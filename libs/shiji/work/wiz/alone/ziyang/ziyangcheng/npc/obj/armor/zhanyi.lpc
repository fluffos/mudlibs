#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create() {
  set_name("战衣", ({ "zhan yi", "cloth", "yi" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件普通的战斗装，很轻便");
    set("unit", "件");
    set("material", "steel");
    set("value", 8000);
    set("armor_prop/armor", 40);
    set("armor_prop/dodge", 5);
  }
  setup();
}
