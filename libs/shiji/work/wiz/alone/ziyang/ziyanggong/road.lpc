#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "城外小路");
  set("long", @LONG
这里是紫阳城城外的一条小路，四处黑漆漆的，你心中有点毛骨悚然的
感觉，我这是到了什么地方呢?
LONG
  );
  set("outdoors", "ziyanggong");

  set("exits", ([
    "south": __DIR__ "guankou",
    "north": __DIR__ "road",
    "west": __DIR__ "road1",
    "east": __DIR__ "road2",
  ]));

  setup();

}

void init() {
  this_player()->receive_damage("qi", 5);
  this_player()->receive_wound("qi", 5);
  write(HIR "你感到自己的周围有着奇怪的能量！\n" NOR,);
  this_player()->improve_skill("force", (int)(this_player()->query_int() / 5));
}
