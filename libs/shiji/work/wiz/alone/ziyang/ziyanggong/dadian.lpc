#include <ansi.h>
inherit ROOM;
 
int do_pick(string arg) ;

void create()
{
        set("short", "大殿");
        set("long",@LONG
这里是紫阳宫的大殿，正面摆放着紫阳真人的石像，前面的蒲团是给人
参拜用的，石像做的栩栩如生，手中拿的宝剑(sword)似乎还在放出寒
光，你眼睛一闪，难道我看花眼了，石像怎么会发光.
LONG);   
        set("item_desc", ([
        "sword" : @TEXT
你仔细看了一下那柄宝剑，好象确实不是石头的，也许可以把它从石像中拔(ba)出来
TEXT ]) );
        set("exits", ([
            "northwest"  : __DIR__"sleeproom",
            "south"  : __DIR__"zoulang2",
            "north"  : __DIR__"houdian",
        ]));
        set("objects", ([
            __DIR__"npc/dizi" : 2,
        ]) );    
//	set("no_clean_up", 0);
        setup();
}
void init()
{
        add_action("do_ba","ba");
}
void reset()
{
        ::reset();
        set("get_available" , 1);
}

int do_ba(string arg)
{
       object me,obj;

       me = this_player();
       if( !arg || arg!="sword" )
              return notify_fail("你要干什么?\n");
       if ( present("di zi",environment(me)))
        
       {
              message_vision(YEL"两旁守护的弟子说道：\"你不想活了，感对祖师爷不敬！\""
                        NOR,me) ;
              return 1 ;
       }
       if ( query("get_available")&&(me->query("max_neili")>300)&&(random(3)>2) ) 
 {
              obj = new (__DIR__"obj/ziyangjian");
              obj->move(me);
              add("get_available", -1);
              message_vision("$N一用力，将剑拔了下来。\n",me );
message("channel:rumor", MAG"【谣言】某人："+this_player()->query("name")+"拿到紫阳剑啦。\n"NOR, users());
       }
       else
              return notify_fail("你疯了还是傻了，那明明是一整块石头,怎么拔的下来呢?\n");
       return 1;
}

