inherit NPC;

inherit F_MASTER;


object ob = this_object();


void create()

{

  set_name("龙霁阳", ({ "long jiyang", "long" }));

  set("nickname", "紫阳城主");

  set("long",
    "他就是紫阳城城主，主持了紫阳宫的重建工作。\n"
    "身材高大，满脸红光，须眉皆白。\n");

  set("gender", "男性");

  set("age", 30);

  set("attitude", "friendly");

  set("shen_type", 1);

  set("str", 30);

  set("int", 30);

  set("con", 30);

  set("dex", 30);


  set("max_qi", 5000);

  set("max_jing", 3000);

  set("neili", 5000);

  set("max_neili", 5000);

  set("jiali", 100);

  set("combat_exp", 2000000);

  set("score", 500000);

  set("chat_chance_combat", 60);

  set("chat_msg_combat", ({

    (: perform_action, "" :)

  }));


  set_skill("force", 200);

  set_skill("dodge", 200);


  set_skill("zidian-ciyun", 200);
  set_skill("unarmed", 200);
  set_skill("xuri-dongsheng", 200);


  set_skill("parry", 200);

  set_skill("sword", 200);


  set_skill("literate", 300);

  set_skill("siling-quan", 200);

  map_skill("force", "zidian-ciyun");
  map_skill("unarmed", "siling-quan");

  map_skill("dodge", "xuri-dongsheng");
  map_skill("sword", "jilei-bajian");
  map_skill("parry", "jilei-bajian");


  create_family("紫阳派", 1, "开山祖师");

  set("class", "taoist");


  setup();

  carry_object(__DIR__ "obj/jianyi")->wield();

}


void attempt_apprentice(object ob)

{

  if ((int)ob->query_skill("force", 1) < 70) {

    command("say 我紫阳派乃内家武功，最重视内功心法。");

    command("say " + RANK_D->query_respect(ob) + "是否还应该在内功上多下点功夫？");

    return;

  }
  if ((int)ob->query_skill("zidian-ciyun", 1) < 60) {

    command("say 我紫阳派乃内家武功，最重视内功心法。");

    command("say " + RANK_D->query_respect(ob) + "是否还应该在内功上多下点功夫？");

    return;

  }



  if (ob->query_int() < 30) {

    command("say 你天资还差些。");

    command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");

    command("say " + RANK_D->query_respect(ob) + "的悟性还大有潜力可挖，还是请回吧。");

    return;

  }

  command("chat 哈哈哈哈！！！！");

  command("chat 想不到我又觅得一个可塑之才，真是可喜可贺。");

  command("recruit " + ob->query("id"));

}


void kill_ob(object me)

{

  command("chat* crazy " + me->query("id"));

  ::kill_ob(me);

}


void unconcious()

{

  command("chat* 长叹一声：今日始信天外有天，人外有人！");

  ::unconcious();

}
