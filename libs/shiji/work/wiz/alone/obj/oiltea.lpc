inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("油茶", ({ "oiltea","tea" }));
        set_weight(500);
        if( clonep() )
            set_default_object(__FILE__);
        else {
        set("long",
"这是一碗清真寺做的油茶，飘出一股香气.\n");
                set("unit", "碗");
                set("value", 20);
                set("max_liquid", 700);
     }
        set("liquid", ([
            "name" : "油茶",
            "remaining" : 5,
                "type" : "water"
        ]) );
        set("liquid_type", "water");
        setup();
}
