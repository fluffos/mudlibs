#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_AUTOLOAD;

void create() {
  set_name(MAG "紫阳剑" NOR, ({ "ziyang jian", "sword", "jian" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是紫阳城主龙霁阳的配剑，剑身古朴无华，却有一种寒气萦绕\n");
    set("value", 500000);
    set("light", 1);
    set("material", "steel");
    set("no_drop", "这样东西不能离开你。\n");
    set("wield_msg", HIW "$N「唰」的一声抽出一柄$n握在手中，只觉一股寒气扑面而来。使人打了个哆嗦\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘，暖活多了，莫非出太阳了? \n");
  }
  init_sword(100);
  setup();
}
