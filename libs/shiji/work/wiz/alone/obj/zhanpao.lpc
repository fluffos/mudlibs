#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(HIW + BLINK "龙霁阳的战袍" NOR, ({ "zhan pao", "pao" }) );
        set_weight(50);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
      set("value", 500000);
            set("long",$HIR$"这是巫师的战袍，穿上它，你将攻无不克，战无不胜.\n"$NOR$);
                set("material", "gold");
          set("armor_prop/armor", 1200);
        }
        setup();
}
