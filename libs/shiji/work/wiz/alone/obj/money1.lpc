inherit MONEY;



void create()

{
  set_name("一元钞票", ({ "chaopiao", "yuan", "money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "chaopiao");
    set("long", "一张面额一元的钞票。\n");
    set("unit", "叠");
    set("base_value", 1);
    set("base_unit", "张");
    set("base_weight", 5);
  }
  set_amount(1);
}
