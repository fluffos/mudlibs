inherit MONEY;


void create()

{
        set_name("一百万元支票", ({"zhipiao", "piao", "cash"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("money_id", "zhipiao2");
                set("long", "一张面额一百万元的支票。\n");
                set("unit", "叠");
                set("base_value", 1000000);
                set("base_unit", "张");
                set("base_weight", 7);
        }
        set_amount(1);
}
