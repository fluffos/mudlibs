

inherit ITEM;
inherit F_FOOD;

void create()
{
     set_name("饼干", ({ "biscuit","binggan","bing" }));
    set_weight(900);
    if( clonep() )
            set_default_object(__FILE__);
    else {
          set("long", "这是一块饼干。\n");
          set("unit", "块");
          set("value", 50);
          set("food_remaining", 1);
          set("food_supply", 200);
     }
}
