inherit ROOM;
#include <ansi.h>
#include <login.h>
#include <room.h>

void create()
{       
set("short", NOR+CYN"蜡笔小新的工作室"HIG);
set("long", @LONG       
 这是蜡笔小新的工作室，里面的摆设很简单，
看来蜡笔小新是一个很扑素的人。在这里有几个出口。
KEDIAN是通往扬州客店的,
LT是到扬州擂台的。
LONG    );      
set("valid_startroom",1);
set("sleep_room", "1");
set("no_steal", "1");      
set("exits", ([
"wiz" : "/d/wizard/wizard_room",
"biwu":"/d/biwu/caipan",
]));
set("objects", ([
"/clone/misc/bm" : 1,
"/wiz/keyboy/telnet" : 1,
]));

setup ();

}
void init()
{
 add_action("do_huifu","huifu");
add_action("do_lmudlist","lmudlist");
add_action("do_accuse","robot");
}
int do_huifu()
{
object me;
me = this_player(1);
if(wizardp(me))
{
me->add("money",1000);
write("你增加了1000 money");
} else {
write("你没有这个权限\n");
}
return 1;
}

int do_accuse(string arg)
{

        object ob;
        string s;

        if( (int)this_player()->query("age") < 15 )
                return notify_fail("你年纪太小了，没有检举别人的权力。\n");

        if( !arg ) return notify_fail("你要检举谁？\n");
        if( ob = find_player(arg) ) {
                if( ob==this_player() )
                        return notify_fail("你要检举自己？\n");
                if( ob->is_ghost() )
                        return notify_fail( ob->name(1) + 
"已经死了，放他一马吧。\n");
                if( wizardp(ob) )
                        return notify_fail("你不能检举巫师。\n");
                tell_object(ob, HIW + this_player()->name(1) + 
"检举你是个机器人，请你接受一个小小的测验。\n" NOR);
                ROBOT_CHECK->test_me(ob);
                write("Ok. 已经将你检举的对象送去做测验。\n");
                
write("为了避免有人用机器人乱检举骚扰别人，请你也接受相同的测验。\n");
                log_file("robot_accuse",
                        sprintf("%s accused %s on %s.\n", 
this_player()->query("id"), ob->query("id"), ctime(time())));
                return 1;
        }
        return notify_fail("目前线上并没有这位玩家。\n");
}

