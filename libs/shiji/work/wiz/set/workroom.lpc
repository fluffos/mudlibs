#include <room.h>
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", BLINK HIG "水心榭" NOR);
  set("long",
    "这是一间幽雅别致的小房，精巧的木门上刻着一片纤纤的羽毛，透过 \n" +
    "落地木窗(chuang)，看到外面有个深潭，一条小河欢快的流动着，微风轻\n" +
    "轻拂过河边一片碧绿的竹林，传来阵阵婉转的鸟语，天际白云优游的飘过，\n" +
    "在远处层叠的山峦间捉着迷藏，望着窗外迷人的景色，使人不由的浑然忘\n" +
    "了自我。屋中的墙上挂着一幅字(zi)\n" NOR
  );
  set("no_clean_up", 1);
  set("item_desc", ([
    "zi": HIC "　　　　　银烛秋光冷画屏\n" + "　　　　　轻罗小扇扑流荧\n" + "　　　　　天街夜色凉如水\n" + "　　　　　坐看牵牛织女星\n" NOR,
    "chuang": BLINK HIG "　　　　　层叠的山峦，柔柔的风\n" + "　　　　　湛蓝的天空，飘飘的云\n" + "　　　　　碧绿的竹林，翩飞的燕\n" + "　　　　　潺潺的流水，欢快的鸭。\n" NOR,
  ]));
  setup();
}
