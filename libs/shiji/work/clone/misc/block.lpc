inherit ROOM;
#include <ansi.h>

void create()
{       
set("short", BLU"沧海"NOR);
set("long",
     "这里就是"HIY"巫师"NOR"把不遵守游戏规则"HIG"玩家"NOR"囚禁思过的地方。一
大片空地，显得无比的凄凉，令你毛骨悚然。到了这儿表示：
"+BRED+HIY+"你已经违反了游戏规则, 请好好的反省一下你自己的所作所为。"NOR"
周围是沧茫的一片大海。\n
");      
      set("valid_startroom",1);
      set("no_steal", "1");
      set("no_fight", 1);
      set("no_sleep", 1);
      setup();
}

void init()
{
        object ob;
        ob = this_player();
        ob->set("startroom","/clone/misc/block");
if(!wizardp(ob))
{
        add_action("block_cmd","lian",1);
        add_action("block_cmd","dazuo",1);
        add_action("block_cmd","du",1);
        add_action("block_cmd","learn",1);
        add_action("block_cmd","practice",1);
        add_action("block_cmd","study",1);
          add_action("block_cmd","suicide",1);
        add_action("block_cmd","exercise",1);
        add_action("block_cmd","chat",1);
        add_action("block_cmd","rumor",1);
        add_action("block_cmd","ss",1);
        add_action("block_cmd","cctx",1);
        add_action("block_cmd","tell",1);
        add_action("block_cmd","reply",1);
        add_action("block_cmd","shout",1);
         add_action("block_cmd","es",1);
          add_action("block_cmd","suicide",1);
          add_action("block_cmd","quit",1);
          add_action("block_cmd","exit",1);
        add_action("block_cmd","new",1);
        add_action("block_cmd","whisper",1);
        add_action("block_cmd","goto",1);
         add_action("block_cmd","home",1);
        add_action("block_cmd","kickout",1);
        add_action("block_cmd","summon",1);
        add_action("block_cmd","edit",1);
        add_action("block_cmd","more",1);
        add_action("block_cmd","ls",1);
        add_action("block_cmd","cat",1);
        add_action("block_cmd","clone",1);
        add_action("block_cmd","mure",1);
        add_action("block_cmd","snoop",1);
        add_action("block_cmd","alarm",1);
        add_action("block_cmd","mv",1);
        add_action("block_cmd","reboot",1);
        add_action("block_cmd","smash",1);
         add_action("block_cmd","who",1);
         add_action("block_cmd","wizlist",1);
        add_action("block_cmd","assoil",1);
          call_out("gern", 1, this_player());
}
}
    int block_cmd(object me)
{
object ob;
          write(RED"你不知到犯了错误,还是在这里好好思过吧。\n");
        return 1;

}
void gern(object ob)
{
             if(ob->query("block/time") < time())
{
              ob->set("startrooom","/d/city/startroom");
            ob->move("/d/city/startroom");
ob->delete("block/time");
}
        tell_room(environment(this_player()),
                 "从远处的世记隐约传来断断续续的歌声：\n\n"+
                "～～沧海一声笑，滔滔两岸潮～～\n\n"
                );
        return;
}

