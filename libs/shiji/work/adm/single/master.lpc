// simulate the old behavior of the driver
string standard_trace(mapping error, int caught)
{
    int i, s;
    string res;

    /* keep track of number of errors per object...if you're into that */
    res = (caught) ? HIW+"错误讯息被拦截: "+NOR : "";
    res = sprintf(HIW+"\n执行时段错误: "+NOR+"%s"+HIW+"\n程式: "+NOR+"%s%s 第%i行\n"+HIW+"\n物件: " + NOR +"%O\n",
        error["error"],
        error["file"],
        error["file"]? "" : "(" + error["program"] + ")",
        error["line"],
        error["object"]);
        res += HIW+" 函数呼叫回溯:\n"+NOR;
        res += HIG+"---------------------------------------------------\n"+NOR;
    for (i=0, s = sizeof(error["trace"]); i < s; i++) {
                res = sprintf("%s%-25s %s%s:%i\n",
                        res,
                        error["trace"][i]["function"] + "()",
                        error["trace"][i]["file"],
                error["trace"][i]["file"]==error["trace"][i]["program"] ?
                        "" : "(" + error["trace"][i]["program"] + ")",
                        error["trace"][i]["line"],
                        // error["trace"][i]["object"]
                );
        }
        res += HIG+"---------------------------------------------------\n"+NOR;
        res += "\n";
        // UTF8/driver-compat FIX (AGENTS.md §15af): CHANNEL_D may not be
        // loaded yet (e.g. a compile warning fired while an earlier preload
        // daemon like securd is still mid-compile) -- calling it here would
        // try to load_object() it, which this driver forbids during
        // compilation. That specific "cannot load during compilation"
        // condition turns out to NOT be catchable at this call site either
        // (verified: even wrapped in catch(), it still cascades into "Error
        // in error handler") -- so check find_object() first and skip the
        // call entirely rather than trying and relying on catch(). Always
        // keep a permanent log write as insurance so the error is never
        // silently lost regardless of whether do_channel ran.
        if (find_object(CHANNEL_D)) catch(CHANNEL_D->do_channel(this_object(), "err", res));
        efun::write_file("/log/RUNTIME_ERRORS", res);
        return res;
}

// error_handler - 主宰物件处理错误的函式.
// 此函式让 mudlib 代替驱动程式处理错误情形.
string error_handler( mapping error, int caught )
{
        string report;

        report = standard_trace(error, caught);

        if (this_player(1)) {
                this_player(1)->set_temp("error", error);
                if( !caught ) tell_object(this_player(1), report);
        }

        // whatever we return goes to the debug.log
        if( caught ) return "";
        else return report;
}

/* log_error - 聪明地纪录错误.

        无论编译程式 (compilation)  时发生任何错误, 驱动程式
        都会以发生错误的档案名称为 file 参数、错误讯息为
        message 参数, 呼叫主宰物件 (master object)  中的
        log_error() 函式. 呼叫此函式时, log_error() 可以做
        任何您认为应该做的资料纪录. 通常 log_error()  根据发
        生错误的档案名称, 决定该纪录要写入哪个错误讯息档案中.
*/
void log_error(string file, string message)
{
        string name, home;
   
        if( find_object(SIMUL_EFUN_OB) )
                name = file_owner(file);

        if (name) home = user_path(name);
        else home = LOG_DIR;

        if(this_player(1) && strsrch(message, "warning:") == -1) efun::write(HIW+"\n编译时段错误：" + HIG +message );

        // UTF8/driver-compat FIX (AGENTS.md §4/§15af): a compile warning
        // fired WHILE securd itself is still mid-compile (e.g. via its own
        // inherited /feature/dbase -> /feature/treemap chain) reaches this
        // function before SECURITY_D exists; write_file()'s valid_write()
        // then tries to load_object(SECURITY_D) while that exact object is
        // mid-compile, an operation this driver forbids -- and that specific
        // condition is NOT catchable at this call site either (verified: an
        // outer catch() around it still cascades into "Error in mudlib
        // error handler"). Guard with find_object() and skip entirely rather
        // than try-and-catch; same for CHANNEL_D. Purely boot-time-only
        // noise either way -- never reaches a connected player.
        if (find_object(SECURITY_D))
                efun::write_file(home + "error.log", sprintf("[%s]%s", ctime(time())[4..18], message));
        if (find_object(CHANNEL_D)) catch(CHANNEL_D->do_channel(this_object(), "err", message));
}

/* valid_shadow - 控制哪些物件可以作为投影 (shadow).

        当一个物件尝试作为 ob 的投影时 (使用 shadow() 超越函
        式 (efun) ) , 会呼叫主宰物件中的 valid_shadow() 函式.
        物件 ob 为此函式的参数, ob  是 previous_object()  尝
        试投影的物件. 如果不准投影 ob, valid_shadow() 应传回
        0 , 导致 shadow() 的呼叫失败并传回 0. 如果
        valid_shadow()  传回 1, 则投影成功.
*/
int valid_shadow( object ob ) { return 0; }

/* valid_override - 控制使用 efun:: 的情形.

        在主宰物件 (master.c) 中加上 valid_override() 可以控制
        efun::  这种前置语法 (prefix) 的使用情形. 当驱动程式尝
        试编译前面加上 efun:: 的函式时, 会呼叫主宰物件的
        valid_override(). 如果 valid_override() 传回 0, 则编译
        失败. 如此一来, valid_override()  可以让一些重要的超越
        函式不能用 efun:: 这种前置语法来修改这些超越函式的作用
         (要修改原始超越函式时, 可以用同名的模拟超越函式
        (simul_efun)  来修改. 并使用 valid_override() 禁止这些
        模拟超越函式被其他函式越权修改 (overriden) ).
*/
int valid_override( string file, string name )
{
        // simul_efun can override any simul_efun by Annihilator
        if (file == SIMUL_EFUN_OB || file==MASTER_OB)
                return 1;

        if( file[0..15] == "/adm/simul_efun/" ) return 1;
        // Must use the move() defined in F_MOVE.
        if(((name == "move_object") || (name == "destruct")) && (file != F_MOVE)) {
                log_error("override", sprintf("%s attempts to override %s(), denied.\n", file, name));
                return 0;
        }

        //  may also wish to protect shutdown, snoop, and exec.
if( (name == "exec") && (file != LOGIN_D)) { 
log_error("override", sprintf("%s attempts to override %s(), denied.\n", file, name));
return 0;
}
        return 1;
}

/* valid_seteuid - 保障使用 seteuid 的系统安全.

        在 seteuid( euid ) 函式里面, 驱动程式呼叫主宰物件
        (master object)  中的 valid_seteuid( ob, euid )
        函式. 如果 valid_seteuid() 传回 0, 则 seteuid(3)
        失败. 如果 valid_seteuid() 传回 1, 则 seteuid(3)
        成功.
*/
int valid_seteuid( object ob, string str )
{
        return (int)SECURITY_D->valid_seteuid( ob, str );
}

