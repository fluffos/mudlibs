/* valid_hide - 允许或禁止一个物件具有匿踪 (hide) 和看到
                     匿踪物件的能力.
        在主宰物件中 (master.c) 加上 valid_hide() 可以让物件
        具有自我匿踪和看到其他匿踪物件的能力. 当一个物件使用
        set_hide()  函式以进入匿踪状态时, 此物件就当成
        valid_hide()  的唯一参数呼叫此函式. valid_hide()
        允许此物件匿踪时应传回 1, 反之则传回 0. 当一个物件想
        看到匿踪状态的物件时, 也以同样的方式呼叫此函式.
*/

int valid_hide( object who )
{
        return 1;
}

/* valid_object - 控制是否载入某个物件.

        载入一个物件之後, 驱动程式会以新创造的此物件为参数, 
        呼叫主宰物件 (master object)  的 valid_object().
        如果 valid_object() 存在, 并传回 0, 则会摧毁此物件
        并使载入物件的超越函式 (efun) 产生错误输出. 如果此
        函式不存在或是传回 1, 则载入物件的过程就跟平常一样.
        在模拟超越函式 (simul_efun) 中使用 nomask 和
        inherit() 超越函式, 再与 valid_object() 并用的话, 
        可以安全限制 destruct() 函式.
*/
int valid_object( object ob )
{
        return (!clonep(ob)) || inherits(F_MOVE, ob);
}

/* valid_link - 控制使用 link(3) 函式的情形

        在 link( from, to ) 超越函式 (efun) 中, 会呼叫主宰物件
        (master object) 里面的 valid_link( from, to ) 函式.
        如果 valid_link() 传回 0, 则 link() 的动作失败. 如果
        传回 1, 还需要以同样的参数呼叫 rename() 成功, 此次的
        link()  才算完成.
*/
int valid_link( string original, string reference )
{
        return 0;
}

/* valid_save_binary - 控制一个物件是否可以储存它的程式码.

        
        驱动程式编译时, 如果定义了 ALWAYS_SAVE_BINARIES; 或是
        一个物件中定义了 #pragma save_binary,  就会以档案名称
        作为参数呼叫 valid_save_binary().  如果此函式传回 1, 
        则准许储存. 反之就不准储存.
*/
int valid_save_binary( string filename )
{
        return 1;
}

/* valid_write - 检查一个人是否有权限写入一个档案.

        每次当一个使用者尝试写入档案时, 驱动程式会呼叫主宰物
        件的 valid_write()  以检查此人的写入权限. 此函式的参
        数 file 为档案名称, user  为尝试写入此档的人名, func
        为造成呼叫 valid_write()  的函式名称. 如果
        valid_write() 传回非零值, 则准许写入.
*/
private nosave int loading_security_d;

// UTF8/driver-compat FIX (AGENTS.md §4): unconditional load_object(SECURITY_D)
// on every call recurses to a stack overflow if it's ever called while
// something is mid-compile (the driver forbids load_object() during
// compilation, and the resulting error routes back through valid_write/read
// again to check log-write permissions). Guard with a re-entrancy flag and
// degrade to "allow" if the load can't complete.
int valid_write( string file, mixed user, string func )
{
        object ob;

        if( !find_object(SECURITY_D) )
        {
                if( loading_security_d ) return 1;
                loading_security_d = 1;
                catch(load_object(SECURITY_D));
                loading_security_d = 0;
                if( !find_object(SECURITY_D) ) return 1;
        }
        return (int)SECURITY_D->valid_write(file, user, func);
}

/* valid_read - 检查一个人是否有权限读取一个档案.

        每次当一个使用者尝试读取档案时, 驱动程式会呼叫主宰物
        件的 valid_read() 以检查此人的读取权限. 此函式的参数
        file  为档案名称, user  为尝试读取此档的人名, func
        为造成呼叫 valid_read() 的函式名称. 如果 valid_read()
        传回非零值, 则准许读取.
*/
int valid_read( string file, mixed user, string func )
{
return 1;
}

