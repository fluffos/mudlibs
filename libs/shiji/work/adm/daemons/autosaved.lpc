// auto_save.c

#include <ansi.h>
#include <dbase.h>

int update_condition(object me, int duration) {
  int i;
  object *ob, link_ob;

  CHANNEL_D->do_channel(me, "sys",
    sprintf("Auto_save has been started for %d minutes。", 5 - duration));
  duration--;
  if (duration > 0) {
    me->apply_condition("auto_save", duration);
    return 0;
  }
  ob = users();
  i = sizeof(ob);
  while (i--) {
    seteuid(getuid());

    if (!objectp(link_ob = ob[i]->query_temp("link_ob")))
      continue;
    if (environment(ob[i])->query("valid_startroom"))
      ob[i]->set("startroom", base_name(environment(ob[i])));

    if ((int)link_ob->save() && (int)ob[i]->save())
      message("system", RED "【存盘精灵】" HIY "你的档案已经自动储存了。\n" NOR, ob[i]);
  }
  me->apply_condition("auto_save", 5);
  return 0;
}
