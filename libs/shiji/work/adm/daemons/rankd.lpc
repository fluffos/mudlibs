// rankd.c

#include <ansi.h>


string query_rank(object ob)
{
        mapping fam;

        int shen;
        int budd;
        int age;
        int exp;
        switch(wizhood(ob)) {
                case "(zhuguan)":
return WHT "〖宇宙特警〗" NOR;
                case "(admin)":
return HIW "〖银河特警〗" NOR;
                case "(arch)":
return HIY "〖星际特警〗" NOR;
                case "(wizard)":
return HIG "〖国际刑警〗" NOR;
                case "(apprentice)":
return HIC "〖国内巡警〗" NOR;
                case "(immortal)":
return HIM "〖普通民警〗" NOR;
              }
if( ob->is_ghost() )
                return HIB "【   黑暗死者   】" NOR;
        exp=ob->query("combat_exp");
        shen = ob->query("shen");
        age = ob->query("age");
        if (!(fam = ob->query("family"))) if (age <= 16)
                                            return HIB"【    老百姓    】"NOR;
                                        else if (age<=30)
                                            return HIC"【    青年人    】"NOR;
                                        else if (age<=60)
                                             return HIC"【    中年人    】"NOR;
                                        else return HIC"【    老年人    】"NOR; 
         switch(ob->query("gender")) {
        case "男性":
  {                        if (fam["family_name"] == "特种部队")
                     {
                           if (exp<10000) return HIW"【    三等兵    】"NOR;
                           else if (exp<50000) return HIC"【     中士     】"NOR;
                           else if (exp<100000) return HIM"【     中尉     】"NOR;
                           else if (exp<200000) return HIB"【     中校     】"NOR;
                           else if (exp<400000) return HIY"【     少将     】"NOR;
                           else if (exp<600000) return HIG"【     中将     】"NOR;
                           else if (exp<800000) return HIR"【     大将     】"NOR;
                           else if (exp<1000000) return WHT"【     元帅     】"NOR;
                           else return CYN"【    总司令    】";
                      }
                       if (fam["family_name"] == "圣殿")
                     {
                           if (exp<10000) return HIW"【     武士     】"NOR;
                           else if (exp<50000) return HIC"【   下级武士   】"NOR;
                           else if (exp<100000) return HIM"【   中级武士   】"NOR;
                           else if (exp<200000) return HIB"【   上级武士   】"NOR;
                           else if (exp<400000) return HIY"【    武士长    】"NOR;
                           else if (exp<600000) return HIG"【   终究武士   】"NOR;
                           else if (exp<800000) return HIR"【     长老     】"NOR;
                           else if (exp<1000000) return WHT"【   太上长老   】"NOR;
                           else return CYN"【   飘渺世间   】";
                      }
                      if (fam["family_name"] == "凤凰星")
                     {
                           if (exp<10000) return HIW"【     战士     】"NOR;
                           else if (exp<50000) return HIC"【    龙战士    】"NOR;
                           else if (exp<100000) return HIM"【     骑士     】"NOR;
                           else if (exp<200000) return HIB"【    龙骑士    】"NOR;
                           else if (exp<400000) return HIY"【   星际战士   】"NOR;
                           else if (exp<600000) return HIG"【   星际骑士   】"NOR;
                           else if (exp<800000) return HIR"【     战神     】"NOR;
                           else if (exp<1000000) return WHT"【   超级战神   】"NOR;
                           else return CYN"【   终究战神   】";
                      }
                   if (fam["family_name"] == "皇族")
                     { 
                           if (exp<10000) return HIW"【     卫士     】"NOR;
                           else if (exp<50000) return HIC"【     勇士     】"NOR;
                           else if (exp<100000) return HIM"【     勇者     】"NOR;
                           else if (exp<200000) return HIB"【    副统领    】"NOR;
                           else if (exp<400000) return HIY"【    大统领    】"NOR;
                           else if (exp<600000) return HIG"【     副将     】"NOR;
                           else if (exp<800000) return HIR"【     龙将     】"NOR;
                           else if (exp<1000000) return WHT"【     神王     】"NOR;
                           else return CYN"【   天际遨游   】";
                      }
}
           default:
{ 
           if (fam["family_name"] == "特种部队")
                     {
                           if (exp<10000) return HIW"【   三等女兵   】"NOR;
                           else if (exp<50000) return HIC"【    女中士    】"NOR;
                           else if (exp<100000) return HIM"【    女中尉    】"NOR;
                           else if (exp<200000) return HIB"【    女中校    】"NOR;
                           else if (exp<400000) return HIY"【    女少将    】"NOR;
                           else if (exp<600000) return HIG"【    女中将    】"NOR;
                           else if (exp<800000) return HIR"【    女大将    】"NOR;
                           else if (exp<1000000) return WHT"【    女元帅    】"NOR;
                           else return CYN"【    女司令    】";
                      }
                       if (fam["family_name"] == "圣殿")
                     {
                           if (exp<10000) return HIW"【    女武士    】"NOR;
                           else if (exp<50000) return HIC"【  下级女武士  】"NOR;
                           else if (exp<100000) return HIM"【  中级女武士  】"NOR;
                           else if (exp<200000) return HIB"【  上级女武士  】"NOR;
                           else if (exp<400000) return HIY"【   女武士长   】"NOR;
                           else if (exp<600000) return HIG"【  终究女武士  】"NOR;
                           else if (exp<800000) return HIR"【    女长老    】"NOR;
                           else if (exp<1000000) return WHT"【  女太上长老  】"NOR;
                           else return CYN"【   飘渺世间   】";
                      }
                      if (fam["family_name"] == "凤凰星")
                     {
                           if (exp<10000) return HIW"【     女战士     】"NOR;
                           else if (exp<50000) return HIC"【    凤战士    】"NOR;
                           else if (exp<100000) return HIM"【    女骑士    】"NOR;
                           else if (exp<200000) return HIB"【    凤骑士    】"NOR;
                           else if (exp<400000) return HIY"【  星际女战士  】"NOR;
                           else if (exp<600000) return HIG"【  星际女骑士  】"NOR;
                           else if (exp<800000) return HIR"【    女战神    】"NOR;
                           else if (exp<1000000) return WHT"【  超级女战神  】"NOR;
                           else return CYN"【  终究女战神  】";
                      }
                   if (fam["family_name"] == "皇族")
                     {
                           if (exp<10000) return HIW"【    女卫士    】"NOR;
                           else if (exp<50000) return HIC"【    女勇士    】"NOR;
                           else if (exp<100000) return HIM"【    女勇者    】"NOR;
                           else if (exp<200000) return HIB"【   女副统领   】"NOR;
                           else if (exp<400000) return HIY"【   女大统领   】"NOR;
                           else if (exp<600000) return HIG"【    女副将    】"NOR;
                           else if (exp<800000) return HIR"【    女龙将    】"NOR;
                           else if (exp<1000000) return WHT"【    女神王    】"NOR;
                           else return CYN"【   天际遨游   】";
                      }
}
       

        }
}
string query_respect(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/respect")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "女性":
			switch(ob->query("class")) {
			case "bonze":
				if( age < 18 ) return "小师太";
				else return "师太";
				break;
			case "taoist":
			case "wudang":
				if( age < 18 ) return "小仙姑";
				else return "仙姑";
				break;
			default:
				if( age < 18 ) return "小姑娘";
				else if( age < 50 ) return "姑娘";
				else return "婆婆";
				break;
			}
		case "无性": {
			if( age < 18 ) return "小公公";
			else if( age < 50 ) return "公公";
			else return "老公公";
			break;
			}
		case "男性":
		default:
			switch(ob->query("class")) {
			case "bonze":
			case "lama" :
				if( age < 18 ) return "小师父";
				else return "大师";
				break;
			case "taoist":
			case "wudang":
				if( age < 18 ) return "道兄";
				else return "道长";
				break;
			case "fighter":
			case "swordsman":
				if( age < 18 ) return "小老弟";
				else if( age < 50 ) return "壮士";
				else return "老前辈";
				break;
			default:
				if( age < 20 ) return "小兄弟";
				else if( age < 50 ) return "壮士";
				else return "老爷子";
				break;
			}
	}
}

string query_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/rude")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "女性":
			switch(ob->query("class")) {
			case "bonze":
			case "lama" :
				return "贼尼";
				break;
			case "taoist":
			case "wudang":
				return "妖女";
				break;
			default:
				if( age < 30 ) return "小贱人";
				else return "死老太婆";
				break;
			}
		case "无性": {
			if( age < 18 ) return "小太监";
			else if( age < 50 ) return "死太监";
			else return "死老太监";
			break;
			}
		case "男性":
		default:
			switch(ob->query("class")) {
			case "bonze":
			case "lama" :
				if( age < 50 ) return "死秃驴";
				else return "老秃驴";
				break;
			case "taoist":
			case "wudang":
				return "死牛鼻子";
				break;
			default:
				if( age < 20 ) return "小王八蛋";
				if( age < 50 ) return "臭贼";
				else return "老匹夫";
				break;
			}
	}
}

string query_self(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/self")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "女性":
			switch(ob->query("class")) {
			case "bonze":
			case "lama" :
				if( age < 50 ) return "贫尼";
				else return "老尼";
				break;
			default:
				if( age < 30 ) return "小女子";
				else return "妾身";
				break;
			}
		case "男性":
		default:
			switch(ob->query("class")) {
			case "bonze":
			case "lama" :
				if( age < 50 ) return "贫僧";
				else return "老纳";
				break;
			case "taoist":
			case "wudang":
				return "贫道";
				break;
			default:
				if( age < 50 ) return "在下";
				else return "老头子";
				break;
			}
	}
}

string query_self_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/self_rude")) )
		return str;

	age = ob->query("age");
	switch(ob->query("gender")) {
		case "女性":
			switch(ob->query("class")) {
			case "bonze":
			case "lama" :
				if( age < 50 ) return "贫尼";
				else return "老尼";
				break;
			default:
				if( age < 30 ) return "本姑娘";
				else return "老娘";
				break;
			}
		case "无性": {
			if( age < 50 ) return "公公我";
			else return "老公公我";
			break;
			}
		case "男性":
		default:
			switch(ob->query("class")) {
			case "bonze":
			case "lama" :
				if( age < 50 ) return "大和尚我";
				else return "老和尚我";
				break;
			case "taoist":
				return "本山人";
				break;
			default:
				if( age < 50 ) return "大爷我";
				else return "老子";
				break;
			}
	}
}

string query_close(object ob, int age, string rgender)
{
	int a1, a2;
	string gender;
	if (objectp(ob) )       {
		if( !age )
			a1 = this_player()->query("age");
		else
			a1 = ob->query("age");
		if( !age)
			a2 = ob->query("age");
		else    a2 = age;
	}
	
	if( !rgender )
		gender = ob->query("gender");					   
	else    gender = rgender;

	switch ( gender ) {
	case "女性" :
		if (a1 > a2)
			return "妹妹";
		else
			return "姐姐";
		break;
	default :
		if (a1 > a2)
			return "弟弟";
		else
			return "哥哥";
	}
}

string query_self_close(object ob, int age)
{
	int a1, a2;
	string gender;
	if( objectp(ob) ) {
		if( !age )
			a1 = this_player()->query("age");
		else
			a1 = ob->query("age");
		if( !age)
			a2 = ob->query("age");
		else    a2 = age;
	}

	if( age )
		gender = ob->query("gender");
	else
		gender = this_player()->query("gender");

	switch (gender) {

	case "女性" :
		if (a1 > a2)
			return "姐姐我";
		else
			return "小妹我";
		break;
	default :
		if (a1 > a2)
			return "愚兄我";
		else
			return "小弟我";
	}
}

