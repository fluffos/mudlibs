//Room: towns.c 市镇捷径
//Date: Sep 8 1997

inherit ROOM;
#include <room.h>
void create()
{
      set("short","市镇捷径");
      set("long",@LONG
你现在在市镇门派转运捷径内。俯视尘寰，点点乡村市镇掩映在
茫茫云雾之下。芸芸攘攘，一派生机盎然。仰望天际，云蒸霞蔚，下
探九幽，阴气森森。
    天  堂：  up
    地  狱：  down
    巫师室：  westup
    武道场：  southwest
    北  京：  northup
    扬  州：  eastdown
    杭  州：  southdown
    成  都：  westdown
    泉  州：  southeast
    汝  州：  northeast
    平定州：  northdown
    南  阳：  north
    衡  阳：  south
    嘉  兴：  southup
    嘉峪关：  west
    北疆镇：  northwest
    华山村：  eastup
LONG);

      set("exits",([ /* sizeof() == 1 */
          "up"        : "/d/death/god2",
          "down"      : "/d/death/gate",
          "westup"    : "/d/wizard/wizard_room",
          "northup"   : "/d/city2/kedian",
          "eastdown"  : "/d/city/kedian",
          "westdown"  : "/d/city3/kedian",
          "southdown" : "/d/hangzhou/kedian",
          "southeast" : "/d/quanzhou/zhongxin",
          "southwest" : "/d/city/wudao",
          "northeast" : "/d/shaolin/ruzhou",
          "northdown" : "/d/heimuya/pingdingzhou",
          "north"     : "/d/shaolin/nanyang",
          "south"     : "/d/henshan/hengyang",
          "southup"   : "/d/quanzhou/yanyu",
          "west"      : "/d/xingxiu/jiayuguan",
          "northwest" : "/d/xingxiu/beijiang",
          "eastup"    : "/d/village/square",
      ]));
      setup();
}
