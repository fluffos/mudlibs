#include <room.h>
inherit ROOM;

void create()
{
      set("short","幽径");
      set("long",@LONG
这是一条很幽静阴暗的林荫小道，路的两边栽满了夹竹桃，小
道是一些碎石铺成的，由于平时很少人走，路上生长着许多青苔。
LONG);
      set("outdoors", "xx");
      set("exits",([ /* sizeof() == 1 */
          "north" : __DIR__"happy",
          "east"  : __DIR__"house",
      ]));
      setup();
}
