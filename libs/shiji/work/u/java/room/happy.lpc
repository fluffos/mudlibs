#include <room.h>
inherit ROOM;

void create()
{
      set("short","忘忧园");
      set("long",@LONG
你处在一个植满茶花的花园里，虽然还不是开花的时节，但是
那些生机勃勃的茶树，不禁让你感到心神清爽。草丛里有些小虫子
正唧喁唧喁地叫得正欢。
LONG);
      set("outdoors", "xx");
      set("exits",([ /* sizeof() == 1 */
          "east"  : __DIR__"upgrade",
          "west"  : __DIR__"practice",
          "north" : __DIR__"garden",
          "south" : __DIR__"path",
      ]));
      setup();
}
