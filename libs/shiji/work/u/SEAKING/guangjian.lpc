// guangjian.c 光剑

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIY"光剑"NOR, ({ "guangjian", "jian","sword" }));
    set_weight(15000);
  set("no_get", 1);
set("no_drop", 1);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "这是一柄气息凝成的的光剑，乍看起来充满了能量。\n");
                set("material", "steel");
                set("wield_msg", "$N提起气息，运至手中，只见一把$n慢慢的凝集起来。\n");
                set("unwield_msg", "$N气息收回丹田，只见$n慢慢消失。\n");
        }
 init_sword(50);
        setup();
}
  
