inherit ITEM;
#include <ansi.h>
void setup() {}
void init() {
  add_action("do_enter", "enter");
}
void create() {
  set_name(MAG "空间传送器(凤凰城--皇族)" NOR, ({ "transfer" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一架空间传送器，可以使人瞬间到达目的地。本架目的地(特种部队)\n");
    set("unit", "架");
    set("no_get", 1);
    set("no_steal", 1);
    set("no_beg", 1);
    set("no_drop", 1);
    set("no_put", 1);
  }
  setup();
}
int do_enter(string arg) {
  object room, me = this_player();
  if (!arg || arg != "transfer") return 0;
  message_vision("$N走进空间传送器。\n\n", me);
  if (!(room = find_object(__DIR__ "space")))
    room = load_object(__DIR__ "space");
  if (room = find_object(__DIR__ "space"))
    me->move(room);
  message("vision", me->name() + "从外面走了进来。\n\n",
    environment(me), ({ me }));
  call_out("reach", 10, me);
  return 1;
}

void reach(object me) {
  tell_object(me, HIW "罩在你头上的紫色光线消失了，传送器提醒你：到了。\n" NOR);
  me->move("/d/huang/luxingchu");
}
