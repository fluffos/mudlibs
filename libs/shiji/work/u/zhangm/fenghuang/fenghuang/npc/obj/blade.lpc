#include <weapon.h>
#include <ansi.h>
inherit F_SSERVER;
inherit BLADE;

void create()
{
        set_name(HIY"霸"HIM"者"HIW"之"HIC"刃"NOR,({"ba dao","blade","dao"}) );
        set("long",
        "由孤魂野鬼的怨气所打造出的，神兵利器。据说拥有强大的魔性。"
        );
        set("no_drop","宝物是扔/卖不了的，也不能给别人。");
        set_weight(500);
        if (clonep() )
                set_default_object(__FILE__);
        else {
                set("unit","把");
                set("value",1000000);           
                set("material", "gold");
       }
      init_blade(100);
        setup();        
}

