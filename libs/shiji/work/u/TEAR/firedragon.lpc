inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIB "火龙" NOR, ({ "fire dragon", "dragon" }));
  set("age", 800);
  set("race", "野兽");
  set("long", "这是一头十分凶猛残暴的火龙，通体火红，口吐火焰，见人就杀，
见者无不闻风而逃\n");
  set("attitude", "peaceful");

  set("str", 50);
  set("dex", 50);
  set("combat_exp", 500000);
  set("limbs", ({ "头部", "身体", "尾巴", "后脚", "嘴巴" }));
  set("verbs", ({ "bite", "claw" }));

  set_temp("apply/attack", 101);
  set_temp("apply/defense", 101);
  set_temp("apply/damage", 101);
  set_temp("apply/armor", 101);

}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) &&
    this_player()->query_temp("火龙肝")) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}
void die() {
  object ob;
  message_vision("$N惨嚎一声，死了！\n", this_object());
  ob = new("/d/budui/obj/jiuhua");
  ob->move(this_player());
  destruct(this_object());
}
