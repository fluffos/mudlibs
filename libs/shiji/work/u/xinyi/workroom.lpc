// Room: /u/xinyi/workroom.c

inherit ROOM;

void create ()
{
  set ("short", "无影浪子工作室");
  set ("long", @LONG
你置身在一个现代化的办公室里，办公室的北侧是一张办公桌(table),办公
桌上摆了一台银河2000的超级微机(computer)。办公桌的东面是一个文件柜，文
件柜里整整齐齐的放着无数的光碟。
　　办公室的西侧有一个 1米直径的圆台，这好象是一架电梯，你踏上去，就可
以到一间布满通道的房间。
LONG);

  set("sleep_room", 1);
  set("no_steal", "1");
  set("no_fight", 1);
  set("valid_startroom", 1);
  set("exits", ([ /* sizeof() == 3 */
  "kd" : "/d/city/kedian",
  "up" : __DIR__"jifang",
  "down" : __DIR__"tongdao",
]));

  setup();
}

