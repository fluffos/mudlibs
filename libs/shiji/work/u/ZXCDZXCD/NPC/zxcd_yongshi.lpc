    " 他 是 小 天 子 的 宫 廷 武 士, 看 上 去 非 常 魁 梧, 但 不 是 很 友 好.二 眼 正 狠 狠 的 盯 着 你 看, 恨 不 得 把 你 吞 了 !\ n ")
        set(" attitude ", " peaceful ")
        
        set(" str ", 60)
        set(" int ", 60)
        set(" con ", 60)
        set(" dex ", 60)
        set(" qi ", 15000)
        set(" max_qi ", 15000)
        set(" jing ", 15000)
        set(" max_jing ", 15000)
        set(" neili ", 20000)
        set(" max_neili ", 20000)
