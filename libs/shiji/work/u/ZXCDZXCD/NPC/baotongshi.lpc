#include <ansi.h>
inherit NPC;

void create()
{
        set_name("豹勇士", ({ "yong shi", "yong" }));
        set("long", 
                "他由于在兽族工作表现出色而晋升为勇士的。\n"
                "他看起来精神饱满。\n");
        set("gender", "男性");
        set("age", 22);
        set("attitude", "peaceful");
        set("shen_type", 0);
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
        
        set("max_qi", 800);
        set("max_jing", 300);
        set("neili", 500);
        set("max_neili", 500);
        set("jiali", 50);
        set("combat_exp", 30000);
        set("score", 1000);

        set_skill("force", 80);
        set_skill("dodge", 90);
        set_skill("unarmed", 90);
        set_skill("parry", 90);
        set_skill("sword", 90);        


        set("chat_chance_combat", 90);

        setup();

}
