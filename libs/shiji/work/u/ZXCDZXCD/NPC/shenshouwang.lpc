#include <ansi.h>
inherit NPC;

void create()
{
        set_name("神兽王", ({ "shen shou wang", "wang" }));
        set("long", 
                "他就是兽族的最高统帅"神兽王"。\n"
        set("gender", "男性");
        set("age", 50);
        set("attitude", "peaceful");
        set("shen_type", 0);
        set("str", 50);
        set("int", 50);
        set("con", 50);
        set("dex", 50);
        
        set("max_qi", 10000);
        set("max_jing", 3000);
        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 300);
        set("combat_exp", 2000000);
        set("score", 100000);

        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("unarmed", 200);
        set_skill("parry", 200);


        set("chat_chance_combat", 90);

        setup();

}
