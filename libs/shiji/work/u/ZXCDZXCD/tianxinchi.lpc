#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", "天心池");
    set("long", @LONG
这里已经是兽族与天最接近的地方了.整个山峰云雾缭绕,祥和的气氛
充满了山谷,在山峰的中央有一个清澈见底的大水池(shuichi).
可是很奇怪水池里居然一条鱼也没有.
LONG );

    set("exits", ([
     "northdown" : __DIR__"shijie3",
     "west" : __DIR__"jiagongchang",
     "east" : __DIR__"zhipichang",
     "south" : __DIR__"shibanlu",
    ]));
 set("objects", ([   "/kungfu/class/shouzu/yongshi": 3        ]));
    setup();
    replace_program(ROOM); 
}
