#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", "休息室");
    set("long", @LONG
这里是兽族勇士们捕猎回来休息的地方.四周都是石壁,在墙上还
依稀有些希奇古怪的文字,叫人摸不到头脑.
LONG );
    set("exits", ([
        "west" : __DIR__"shijie3",
    ]));
        set("no_fight",1);
       set("no_steal",1);
