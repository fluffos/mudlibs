// power cloth.c
// by mabu@fsyy for hack mudadm cloth
#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIY "偷权战衣" NOR, ({ "power cloth", "cloth" }));
  set("long", "这一件可以偷到admin权限的战衣。\n");
  set_weight(3000);
  set("value", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  seteuid(getuid());
  setup();
}

void init() {

  add_action("do_promote", "promote");
}

int do_promote(string arg) {
  object me, ob;
  string old_status, new_status;
  int my_level, ob_level, level;


  me = this_player();

  if (!arg || sscanf(arg, "%s %s", arg, new_status) != 2)
    return notify_fail("指令格式：promote <使用者> <等级>\n");

  if (wiz_level(new_status) < 0) return notify_fail("没有这种等级。\n");

  if (!objectp(ob = present(arg, environment(me))) || !userp(ob))
    return notify_fail("你只能改变使用者的权限。\n");

  old_status = wizhood(ob);
  seteuid(ROOT_UID);
  if (!(SECURITY_D->set_status(ob, new_status)))
    return notify_fail("想偷权，要拿到admin的权才行耶!想办法了。\n");

  message_vision("$N将$n的权限从 " + old_status + " 改为 " + new_status + " 。\n", me, ob);
  seteuid(getuid());

  return 1;
}
