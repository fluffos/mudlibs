//workroom.c
//Date: Mar 2 1998

inherit ROOM;
#include <room.h>

void create() {
  set("short", "玄黄山居");
  set("long", @LONG
这是一间简陋的黄土屋，里面干净整洁，正中央的一张八仙桌
上摆放着一尊旧式的青铜香炉，镂花的炉盖上升起袅袅青烟。香炉
边只供着一个禅字。桌的南面地下有一个素色蒲团，旁边还有一册
正翻开卷起的线装经书。北边有个小木梯子通向楼上。主人好象并
不在家，只有一个小和尚在扫地，但整个屋中弥漫着的檀香气让你
肃然起敬。窗外无名的罡风呜呜地嚎着，可是在屋内却是出奇地心
平气和。
    四面墙上挂着四幅画：东边墙上挂着一幅“祖狄竹林晨练图”，
竹林青翠欲滴，在晨起的霞光中少年祖狄正挥剑自舞；南面墙上镶
着一幅“夏日海滨戏水”，清朗的天空倒映着青碧的海水傍着三个
三四岁的娃娃同乐；西墙上是一幅长卷“清明上河图”，都市中人
来人往好不热闹；可惜北墙上的画因太过古老且满是烟痕看不清。
LONG);
  set("objects", ([
    "/d/npc/xiaoheshang": 1,
  ]));
  set("exits", ([
    "up": __DIR__ "room/bedroom",
    "east": __DIR__ "room/bamboo",
    "south": __DIR__ "room/beach",
    "west": __DIR__ "room/playworld",
    "north": __DIR__ "room/bog",
  ]));
  set("valid_startroom", "1");
  set("no_fight", "1");
  set("no_steal", "1");
  setup();
  create_door("east", "青竹小门", "west", DOOR_CLOSED);
  create_door("south", "红木小门", "north", DOOR_CLOSED);
  create_door("west", "黄金小门", "east", DOOR_CLOSED);
  create_door("north", "黑暗小门", "south", DOOR_CLOSED);
}

int valid_leave(object me, string dir) {
  if (me->query("id") == "xiao heshang") {
    if (dir == "up")
      return ::valid_leave(me, "dir");
    else {
      tell_room(environment(me), "小和尚正在专心扫地\n");
      return notify_fail("小和尚正在专心扫地\n");
    }
  }
  if (!wizardp(me)) {
    if (dir == "west") {
      me->delete("chanxin");
    }
  }
  return ::valid_leave(me, dir);
}
