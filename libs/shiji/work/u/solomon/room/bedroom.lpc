// Room: bedroom.c
// Date: Mar.2 1998

#include <room.h>
inherit ROOM;

void init();
int do_jump(string arg);
int valid_leave(object me, string dir);

void create()
{
      set("short", "陋室空堂");
      set("long", @LONG
其中只有一张唐朝时代的沙发睡椅和一张摇椅，地上胡乱散落
着两三本书，仔细一看居然是金庸大侠的<<鹿鼎记>>。蒙着绿纱的
小窗(window)透过一片叶影，傍着金丝雀清脆的啾啾声萦绕在雕花
梁上。
    这里是本泥塘天帝的居室。
LONG );
      set("item_desc", ([
            "window" : "凭高远眺山下青山点点，绿水丝丝，令人神往。\n",
      ]));
      set("objects",([
          "/d/npc/skywalker":1,
      ]));
      set("exits", ([
          "down":  "/u/solomon/workroom",
          "east":  __DIR__"readroom",
          "west":  __DIR__"kitchen",
          "north": __DIR__"bathroom",
      ]));
      set("no_fight", 1);
      set("no_clean_up", 0);
      set("sleep_room", 1);
      setup();
      create_door("east", "书库小门", "west", DOOR_CLOSED);
}

void init()
{
      add_action("do_jump", "jump");
}

int do_jump(string arg)
{

      object ob;
      object me = this_player();
      int dex = this_player()->query_dex();

      if (arg != "window" && arg != "out")
            return command("jump "+arg);

      message_vision("$N翻开绿窗纱＂嗖＂地一声跳出窗户。\n", me);
      if ((dex <= 30)&&(random(3)<2))
            message_vision("只听＂啪＂地一声$N整个脸贴在空谷回音的石壁上压得平平的。\n", me);
      else
            message_vision("$N提一口气，轻颖地飘落在下面的空地上！\n", me);

      me->move(__DIR__"geste");

      return 1;
}

int valid_leave(object me, string dir)
{
      int i;
      if (!wizardp(me))
      {
           if (dir == "east")
           {
                 if (me->query("chanxin/save")==5)
                 {
                       i=random(100);
                       if (i==0)
                             return ::valid_leave(me, dir);
                       else
                             return notify_fail("天神喝道：“心术不正者免进。”\n");
                 }
                 else
                 {
                       me->delete("chanxin");
                       return notify_fail("天神喝道：“心术不正者免进。”\n");
                 }
           }
           if (dir == "west")
                 me->delete("chanxin");
           return ::valid_leave(me, dir);
      }
      return ::valid_leave(me, dir);
}
