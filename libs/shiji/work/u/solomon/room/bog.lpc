inherit ROOM;
#include <room.h>

void create() {
  set("short", "黑暗之泽");
  set("long", @LONG
这里是一片无尽的黑沼泽，又臭又脏并冒着黑泡的污水，
夹着腐烂的泥巴淹没了你的脚面，让你觉得真是上天无路入
地无门，还是快快回头是岸吧。
LONG);
  set("outdoors", "solomon");
  set("no_fight", "1");
  set("no_steal", "1");
  set("exits", ([
    "south": "/u/solomon/workroom",
    "north": __DIR__ "bog1",
  ]));
  setup();
  create_door("south", "黑暗小门", "north", DOOR_CLOSED);
}
