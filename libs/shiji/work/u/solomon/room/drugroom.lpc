            "/d/city/obj/guiyuan"        : 1,
            "/d/city/obj/shanshen"       : 1,
            "/d/city/obj/yangxin"        : 1,
            "/d/city/obj/zaisheng"       : 1,
            "/clone/misc/jinchuang"      : 1,
            "/clone/misc/yangjing"       : 1,
            "/clone/misc/wuchangdan"     : 1,
