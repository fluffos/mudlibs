// ROOM : shenshanxia.c
inherit ROOM;

void init();
int do_pa(string arg);
int do_la(string arg);
int valid_leave(object me, string dir);

void create() {
  set("short", "神山脚下");
  set("long", @LONG
你走出了那片草原，不由长长地舒了口气。可是, 一座巍峨的
神山耸立在你的面前，悬崖高达万丈，上面仿佛有座白色的建筑。
可云烟缭绕看不清晰。从悬崖上垂下一条绳索(rope)，看上去象是
悬崖上下互通的工具。
LONG);
  set("outdoors", "solomon");
  set("exits", ([
    "south": "/d/xingxiu/saimachang",
  ]));
  set("item_desc", ([
    "rope": "绳子就是绳子,可以向上爬的工具,嘻嘻!\n",
  ]));
  setup();
}

void init() {
  add_action("do_la", "la");
  add_action("do_pa", "pa");
}

int do_la(string arg) {
  int i;
  object me;
  if (!arg || arg != "rope")
    return notify_fail("你要拉啥?\n");
  me = this_player();
  /*
      if (me->query_temp("mark/拉")==2)
      {
            tell_object(me,"你拉了拉绳子发现很不结实!\n");
            return 1;
      }
      i=random(8);
      if (i==0)
      {
*/
  me->set_temp("mark/拉", 1);
  tell_object(me, "你拉了拉绳子发现很结实!\n");
  /*
      }
      else
      {
            me->set_temp("mark/拉",2);
            tell_object(me,"你拉了拉绳子发现很不结实!\n");
      }
*/
  return 1;
}

int do_pa(string arg) {
  object me;
  if (!arg || arg != "rope")
    return notify_fail("你要爬啥?\n");
  me = this_player();
  if (me->query_temp("mark/拉") == 1) {
    me->delete_temp("mark/拉");
    tell_object(me, "你拉着绳子向悬崖上爬!\n");
    me->move(__DIR__ "geste");
  } else {
    tell_object(me, "你想找死呀!\n");
  }
  return 1;
}

int valid_leave(object me, string dir) {
  me->delete_temp("mark/拉");
  return ::valid_leave(me, dir);
}
