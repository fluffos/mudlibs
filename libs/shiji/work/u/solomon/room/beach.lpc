// Room: beach.c
// Date: Mar 2 1998

inherit ROOM;
#include <room.h>

void create()
{
      set("short", "夏日海滨");
      set("long", @LONG
这里是浪漫的夏日海滨，她依山傍海，修长的椰林沿着海滩排
成一溜长队。靓丽的阳光舒服地撒在身上，晒得你有点刺刺的，忍
不住想要跳进大海里畅快地游个泳。东边是一座美丽的城市，南面
有个小铁皮屋，长长的沙滩一直向西延伸。
LONG );
      set("outdoors", "solomon");
      set("no_fight", "1");
      set("no_steal", "1");
      set("exits", ([
            "north"  : "/u/solomon/workroom",
            "south"  : __DIR__"stock",
            "east"   : "/d/hangzhou/tiejiangpu",
            "west"   : "/d/npc/m_weapon/m_room1",
      ]));
      setup();
      create_door("north" , "红木小门", "south" , DOOR_CLOSED);
}

int valid_leave(object me, string dir)
{
      int i;
      if (!wizardp(me))
      {
           if (dir == "south")
           {
                 if (me->query("chanxin/save")==5)
                 {
                       i=random(100);
                       if (i==0)
                             return ::valid_leave(me, dir);
                       else
                             return notify_fail("天神喝道：“心术不正者免进。”\n");
                 }
                 else
                 {
                       me->delete("chanxin");
                       return notify_fail("天神喝道：“心术不正者免进。”\n");
                 }
           }
      }
      return ::valid_leave(me, dir);
}
