// jinggang jia

#include <armor.h>

inherit ARMOR;

void create()
{
    set_name( "精钢甲",({ "jinggang jia","jia", }) );
    set_weight(70000);
	if( clonep() )
		set_default_object(__FILE__);
	else
	{
            set("unit", "件");
            set("long", "一件玄铁和精钢打就的护甲\n");
            set("material", "steel");
            set("value",10);
	        set("no_drop", "这样东西不能离开你。\n");
            set("armor_prop/armor", 1000);
	        set("armor_prop/dodge", -5);
	}
	setup();
}
