inherit F_CLEAN_UP;

int level(mixed, mixed);

int main(object me, string arg) {
  string *list, hood = "", str;
  int j = 0;

  list = sort_array(SECURITY_D->query_wizlist(), (: level :));
  str = "◎ " + MUD_NAME + "目前共有 " + sizeof(list) + " 位巫师：";
  for (int i = 0; i < sizeof(list); i++, j++) {
    if (hood != wizhood(list[i])) {
      hood = wizhood(list[i]);
      if (j % 7) str += "\n";
      str += "\n" + hood + "\n";
      j = 0;
    }
    str += sprintf(" %-9s%c", list[i],
      (j % 7 == 6) ? '\n' : ' ');
  }
  me->start_more(str);
  return 1;
}

int level(mixed ob1, mixed ob2) {
  if (wiz_level(ob1) != wiz_level(ob2))
    return wiz_level(ob1) - wiz_level(ob2);
  return ob1 < ob2 ? -1 : 1;
}

int help(object me) {
  write(@HELP
指令格式 : wizlist

用途 : 列出目前所有的巫师名单。
HELP
  );
  return 1;
}
