#include <ansi.h>
inherit F_CLEAN_UP;
#define NEWS "/clone/board/news_b"


int main(object me, string arg) {
  mapping *news, last_read_time;
  int i, num, last_time_read;
  string msg, myid;
  myid = NEWS->query("board_id");
  //last_time_read = (int)me->query("board_last_read/" + (string)query("board_id"));
  last_read_time = me->query("board_last_read");
  news = NEWS->query("notes");
  msg = HIW "新闻查询系统 Version 1.0。(Created by Fhc)(详细用法参见help news。)\n" NOR;
  if (!pointerp(news) || sizeof(news) == 0)
    return notify_fail(HIR "对不起！不能查询新闻系统。\n" NOR);

  if (!arg) {
    if (!mapp(last_read_time) || undefinedp(last_read_time[myid])) {
      num = 1;
      me->set("board_last_read/" + myid, 0);
    } else
      for (num = 1; num <= sizeof(news); num++)
        if (news[num - 1]["time"] > last_read_time[myid]) break;
    if (num > sizeof(news))
      return notify_fail(HIW "距您上次退出到现在没有任何新闻。如果想参阅以前的新闻，请使用news all指令。\n" NOR);
    for (i = num - 1; i < sizeof(news); i++)
      msg += sprintf("%s[%2d]" NOR "  %-40s %12s (%s)\n",
        (news[i]["time"] > last_read_time[myid] ? HIY : ""),
        i + 1, news[i]["title"], news[i]["author"],
        ctime(news[i]["time"])[0..15]);
    me->start_more(msg);
    return 1;
  }
  if (arg == "all") {
    for (i = 0; i < sizeof(news); i++)
      msg += sprintf("%s[%2d]" NOR "  %-40s %12s (%s)\n",
        (news[i]["time"] > last_read_time[myid] ? HIY : ""),
        i + 1, news[i]["title"], news[i]["author"],
        ctime(news[i]["time"])[0..15]);
    me->start_more(msg);
    return 1;
  }
  if (sscanf(arg, "%d", num));
  {
    if (num < 1 || num > sizeof(news))
      return notify_fail("没有这条新闻。\n");
    num--;
    me->start_more(sprintf(
      "[%d] %-40s %s(%s)\n----------------------------------------------------------------------\n",
      num + 1, news[num]["title"], news[num]["author"], ctime(news[num]["time"])[0..9])
      +news[num]["msg"]);
    if (!mapp(last_read_time))
      me->set("board_last_read", ([ myid: news[num]["time"] ]));
    else if (undefinedp(last_read_time[myid]) || news[num]["time"] > last_read_time[myid])
      last_read_time[myid] = news[num]["time"];
    return 1;
  }
}
int help(object me) {
  write(@HELP
指令格式 : news [all||编号||没有参数]
 
这个指令可以查看目前的最新更动。
 
HELP
  );
  return 1;
}
