//inventory.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        int i,j,a;
        object *inv, ob;
        string str,unt;
        str="";
        if( wizardp(me) && arg ) {
                ob = find_player(arg);
                if( !ob ) ob = find_living(arg);
                if( !ob ) ob = present(arg, environment(me));
        }

        if( !ob ) ob = me;

        inv = all_inventory(ob);
        if( !sizeof(inv) ) {
                write((ob==me)? "目前你身上没有任何东西。\n"
                        : ob->name() + "身上没有携带任何东西。\n");
                return 1;
        }
/*      printf("%s身上带著下列这些东西(负重 %d%%)：\n%s\n",
                (ob==me)? "你": ob->name(),
                (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance(),
                implode(map_array(inv, "inventory_desc", this_object()), "\n") );
*/
        
        for(i=0; i<sizeof(inv); i++) {
        if (inv[i]->query("equipped"))          {
                 str+=HIG"□"NOR+ inv[i]->short()+"\n";
                 inv[i]->set_temp("look/unt", 1);}
                                }
        for(i=0; i<sizeof(inv); i++) 
        { 
                if( inv[i]==me ) continue;
                if( !me->visible(inv[i]) ) continue;
                a=1;
                
                for(j=i+1; j<sizeof(inv); j++)
                {

                if (!inv[i]->query_temp("look/unt")&&inv[i]->short()==inv[j]->short()) 
                        {
                        inv[j]->set_temp("look/unt", 1);
                                a=a+1;
                        }
                }
                                if (a>1) {
                                if(inv[i]->is_character()&& inv[i]->query("race")=="人类" )
                                        str +=CYN"  "+chinese_number(a)+"位"NOR+
                                        inv[i]->short()+"\n";   
                                if(inv[i]->is_character()&& inv[i]->query("race")!="人类" )
                                        {
                                        if (inv[i]->query("id")=="corpse" ||
                                         inv[i]->query("id")=="skeleton")
                                        str +=CYN"  "+chinese_number(a)+"具"NOR+
                                        inv[i]->short()+"\n";
                                        else str +=CYN"  "+chinese_number(a)+"只"NOR+
                                        inv[i]->short()+"\n";   
                                        }
                                if(!inv[i]->is_character() ){
                                        unt=inv[i]->query("unit");
                                        if (!inv[i]->query("unit")) unt="个";
                                        str +=CYN"  "+chinese_number(a)+unt+""+ NOR+
                                        inv[i]->short()+"\n";}  
                                                                                                                     
                                }if (a==1&&!inv[i]->query_temp("look/unt")) {str += "  "+inv[i]->short()+"\n";}
        }
        printf("%s身上带著下列这些东西(负重 %d%%)：\n%s",
                (ob==me)? "你": ob->name(),
                (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance(),
                str );
        for(i=0; i<sizeof(inv); i++) 
        { inv[i]->delete_temp("look/unt");}
        return 1;
}



int help (object me)
{
        write(@HELP
指令格式: inventory
 
可列出你(你)目前身上所携带的所有物品。
 
注 : 此指令可以 " i " 代替。
 
HELP
);
        return 1;
}

