#include <ansi.h>
void display();
private void a(string arg, string wizapply);
private void b(string arg, string wizapply);
private void c(string arg, string wizapply);
private void d(string arg, string wizapply);
private void e(string arg, string wizapply);
private void f(string arg, string wizapply);
private void g(string arg, string wizapply);
private void h(string arg, string wizapply);
private void i(string arg, string wizapply);
private void j(string arg, string wizapply);
private void k(string arg, string wizapply);
private void l(string arg, string wizapply);
private void m(string arg, string wizapply);
private void n(string arg, string wizapply);
private void o(string arg, string wizapply);

int main(object me)
{
     string table;
              display();
         if(!me->query_temp("wizapply"))
         {
           write(YEL"目前选择：\n"NOR);
           write(HIW"真实姓名: "NOR);
         input_to((:a:),this_player());
         } 
         else 
         write("你以经填写过了\n");
         return 1;
     
}
void display()
{
   write(CLR"\n");
   write(HIY"                     "+MUD_NAME+"巫师申请表\n"NOR);
write("         首先，你必须考虑清楚，成为一名巫师代表你将愿意花可能占去你大
部分的休闲时间在泥巴上，如果你不愿意，最好还是当个玩家的好，我们
目前需要的是优秀的巫师，共同开发好这个mud我们的需要
        1. 你必须是个「老练」的玩家.
        2. 你必须学过 C 语言。
        3. 对 RPG 有一定的认识。
        4. 你必须有和他人合作，并且容忍批评和别人修改你的作品的雅量。
        5. 注意这里对巫师的要求很高，如果你不能按时完成任务，请不要申请。?   我们并不打算给新巫师任何压力。在你下定决心要成为一名巫师之後");
write("\n");
}
private void a(string arg, string wizapply)
{
wizapply = "真实姓名: "+arg+"\n";
   this_player()->add_temp("wizapply",wizapply);
   write(HIW"巫师姓名: "NOR);
   input_to((:b:),this_player());
}
private void b(string arg, string wizapply)
{
   wizapply = "巫师姓名: "+arg+"\n";
   this_player()->add_temp("wizapply",wizapply);
   write(HIW"英文姓名: "NOR);
   input_to((:c:),this_player());
}
