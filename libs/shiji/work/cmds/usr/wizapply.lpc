{
   wizapply = "电子信箱: "+arg+"\n";
   this_player()->add_temp("wizapply",wizapply);
   write(HIW"你的单位（学校）: "NOR);
   input_to((:g:),this_player());
}
private void g(string arg, string wizapply)
{
   wizapply = "你的单位（学校）: "+arg+"\n";
   this_player()->add_temp("wizapply",wizapply);
   write(HIW"你是否有足够的时间来参与本MUD的建设: "NOR);
   input_to((:k:),this_player());
}
private void k(string arg, string wizapply)
{
   wizapply = "你是否有足够的时间来参与本MUD的建设: "+arg+"\n";
   this_player()->add_temp("wizapply",wizapply);
   write(HIW"是否熟悉mud: "NOR);
   input_to((:l:),this_player());
}
private void l(string arg, string wizapply)
{
   wizapply = "是否熟悉mud: "+arg+"\n";
   this_player()->add_temp("wizapply",wizapply);
   write(HIW"请问做物件最主要的是:"NOR);
   input_to((:m:),this_player());
}
private void m(string arg, string wizapply)
{
   wizapply = "请问做物件最主要的是:"+arg+"\n";
   this_player()->add_temp("wizapply",wizapply);
   write(HIW"请问做房间最主要的是:"NOR);
   input_to((:n:),this_player());
}
private void n(string arg, string wizapply)
{
   wizapply = "请问做房间最主要的是:"+arg+"\n";
   this_player()->add_temp("wizapply",wizapply);
   write(HIW"你熟悉那几种程序语言（如：C、C++、JAVA）:"NOR);
   input_to((:o:),this_player());
}

private void o(string arg, string wizapply)
{
   string table;
   this_player()->set("wizapply",wizapply);
   wizapply = "你熟悉那几种程序语言（如：C、C++、JAVA）: "+arg+"\n";
   this_player()->add_temp("wizapply",wizapply);
   table =  this_player()->query_temp("wizapply"); 
   write_file("/data/wizapply/"+this_player()->query("id"),table,1);
   write("\n如果你完不成任务，要被降职和杀档的处分。\n");
}
int help(object me)
{
        write(@HELP
指令格式 : wizapply

申请巫师
HELP
    );
    return 1;
}



