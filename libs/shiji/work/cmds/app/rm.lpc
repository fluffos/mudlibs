inherit F_CLEAN_UP;
inherit F_DBASE;
#include <ansi.h>

void create() {
  seteuid(getuid());
  set("name", "删除档案");
  set("id", "edit");
  set("channel_id", "删除精灵");
}

int main(object me, string file) {
  string c_time = CTIME_D->chinese_time(5);
  seteuid(geteuid(me));
  if (!file) return notify_fail(HIG + "你要删除哪个档案?\n" + NOR);
  if (rm(resolve_path(me->query("cwd"), file))) {
    log_file("nosave/rmfile", sprintf("%s%s rm %s (%s)\n",
      me->query("name"),
      "(" + me->query("id") + ")",
      resolve_path(me->query("cwd"), file),
      c_time
    ));
    write_file("/adm/single/rmfile", sprintf("%s%s rm %s (%s)\n",
      me->query("name"),
      "(" + me->query("id") + ")",
      resolve_path(me->query("cwd"), file),
      c_time
    ));

    CHANNEL_D->do_channel(this_object(), "sys", me->query("name") + "(" + me->query("id") + ")" + "删除了" +
      resolve_path(me->query("cwd"), file) + "。" NOR);
    write(HIY "删除完毕.\n" NOR);
    return 1;
  } else if (!resolve_path(me->query("cwd"), file)) {
    write(HIG + "没有这个档案.\n" + NOR); return 1;
  } else {
    write(HIR "你没有删除这个档案的权利。\n" NOR); return 1;
  }
  return 1;
}
