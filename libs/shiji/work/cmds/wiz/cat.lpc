#include <ansi.h>;
inherit F_CLEAN_UP;

int main(object me, string arg) {
  string file;

  seteuid(geteuid(me));
  if (!arg) return notify_fail("你想要显示那个档案?\n");
  file = resolve_path(me->query("cwd"), arg);
  if (!(int)SECURITY_D->valid_read(file, me)) return notify_fail("没有这个档案。\n");
  if (file_size(file) < 0)
    return notify_fail("没有这个档案。\n");
  if (strlen(file) > 8192)
    return notify_fail("文件过长，请使用 more 指令显示档案。\n");
  cat(file);
  log_file("cmds/cat.log", sprintf(HIW "%s(" HIG "%s)" NOR "cat" HIC "%s" NOR "%s\n",
    me->query("name"), me->query("id"), file, CTIME_D->chinese_time(5)));
  return 1;
}
