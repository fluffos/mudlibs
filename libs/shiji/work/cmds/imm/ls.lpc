// ls.c
// keyboy@sjmud
#include <ansi.h>
//#include <localtime.h>
#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string dir, result, cwd = me->query("cwd");
  mixed *files;
  int i, end_line = 0, count = 0;

  seteuid(geteuid(this_player(1)));
  dir = resolve_path(cwd, arg);
  if (file_size(dir) == -2 && dir[strlen(dir) - 1] != '/') dir += "/";
  files = get_dir(dir, -1);

  dir = dir[0..strsrch(dir, "/", -1)];
  if (!sizeof(files)) {
    if (file_size(dir) == -2) return notify_fail("目录是空的。\n");
    else return notify_fail("没有这个目录或者文件。\n");
  }

  result = HIY "目录:" + dir + "\n" NOR;
  for (i = 0; i < sizeof(files); i++) {
    if (!(int)SECURITY_D->valid_read(resolve_path(dir, files[i][0]), me)) continue;
    end_line++;
    if (files[i][1] == -2) result += sprintf(" %-10s" + HIW + "<DIR> |  " + NOR, files[i][0]);
    else result += sprintf(" %-10s" + HIW + " %d KB | " + NOR, files[i][0], 1 + files[i][1] / 1024);

    if (end_line == 3) {
      result += "\n";
      end_line = 0;
    }
    count++;
  }
  result += end_line ? "\n" : "";
  result += sprintf("共有文件: %d 个。\n", count);
  me->start_more(result);
  return 1;
  return notify_fail("抱歉，您没有这个目录的访问权。\n");
}

int help(object me) {
  write(@HELP
指令格式: ls [<路径名>]
列出目录下所有的子目录及档案, 如果没有指定目录, 则列出所在目录
的内容，所列出的档案中前面标示 * 号的是已经载入的物件。
黄色目录为无权限读取的目录。
HELP
  );
  return 1;
}
