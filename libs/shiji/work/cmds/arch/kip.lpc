// ban.c
// Created by Xiang@XKX

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  string site;

  if (!arg)
    KIP_D->print();
  else if (sscanf(arg, "+ %s", site) == 1) {
    if (site[sizeof(site) - 1] == '*' ||
      site[sizeof(site) - 1] == '?' ||
      site[sizeof(site) - 1] == '+')
      write("不能放 *, +, ? 结尾的地址。\n");
    else
      KIP_D->add(site);
    log_file("cmds/kip.log", sprintf("%s(%s)KIP(%s)在%s\n",
      me->query("name"), me->query("id"), site, CTIME_D->chinese_time(5)));
  } else if (sscanf(arg, "- %s", site) == 1)
    KIP_D->remove(site);
  else write("指令格式：kip [+|- site]\n");

  return 1;

}

int help(object me) {
  write(@HELP
指令格式：kip [+|- site]

这条命令是用来防止有人蓄意捣乱。
HELP
  );
  return 1;
}
