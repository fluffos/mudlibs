#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg, string comm, int flag) {
  string cmds;
  object ob;

  if (!arg || !sscanf(arg, "%s %s", arg, cmds))
    if (flag) cmds = comm;
  else return notify_fail("参数错误!\n");
  if (!(ob = present(arg, environment(me))))
    return notify_fail("找不到" + arg + "。\n");
  if (!living(ob))
    return notify_fail("这个物件不能执行命令。\n");
  if (ob == me)
    return notify_fail("直接打命令比较快些。\n");

  if (wiz_level(me) < wiz_level(ob))
    return notify_fail("你没有这种权力。\n");
  if (!wizardp(me)) log_file("FORCE", sprintf("[%s] %s forces %s to %s\n",
    ctime(time()), geteuid(me), geteuid(ob), cmds));
  return ob->force_me(cmds);
}
