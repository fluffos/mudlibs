inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object head, hand, leg, body, foot;
  int headnum, handnum, legnum, bodynum, footnum;
  if (me->query_skill("zhizao-shu") < 20)
    return notify_fail("你还不到火候呢！\n");
  if (!arg)
    return notify_fail("你想制造什么东西？\n");
  if (!(head = present("headjia", me)) ||
    !(hand = present("handjia", me)) ||
    !(leg = present("legjia", me)) ||
    !(body = present("bodyjia", me)) ||
    !(foot = present("footjia", me)))
    return notify_fail("你还缺少点原料吧。\n");
  message_vision("$N拿出工具，开始做起机器人来。\n", me);
  headnum = head->query("num");
  handnum = hand->query("num");
  legnum = leg->query("num");
  bodynum = body->query("num");
  footnum = foot->query("num");
  destruct(head);
  destruct(hand);
  destruct(leg);
  destruct(body);
  destruct(foot);
  call_out("zhizhao", 10, me, headnum, handnum, legnum, bodynum, footnum, arg);
  return 1;
}
void zhizhao(
  object me,
  int headnum,
  int handnum,
  int legnum,
  int bodynum,
  int footnum,
  string arg
) {
  object obj;
  obj = new("/u/seaking/jiqiren");
  message_vision("终于完工啦，$N望着做好的机器人，不禁发出一阵狂笑。\n", me);
  obj->set("ride/dodge", footnum * 200 / me->query_skill("zhizao-shu"));
  obj->set("ride/damage", headnum * 200 / me->query_skill("zhizao-shu"));
  obj->set("ride/attack", handnum * 200 / me->query_skill("zhizao-shu"));
  obj->set("ride/armor", bodynum * 200 / me->query_skill("zhizao-shu"));
  obj->set("ride/parry", legnum * 200 / me->query_skill("zhizao-shu"));
  obj->set("name", arg + "----机械战士");
  obj->move(me);
  return;
}

int help(object me) {
  write(@HELP
指令格式 : zhizao <机器人名称>

这个指令可以让你自己制造机器人。

HELP
  );
  return 1;
}
