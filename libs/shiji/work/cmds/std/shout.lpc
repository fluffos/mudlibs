// shout.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (!arg) return notify_fail("你想要大叫什么？\n");
  if (!wizardp(me) && (int)me->query("max_neili") < 300) return notify_fail("你的内力不够\n");
  if ((int)me->query("qi") < 100) return notify_fail("你的真气不足，没法运气长啸。\n");
  if ((int)me->query("neili") < 1500 && !wizardp(me)) {
    shout(WHT "" + me->name() + WHT "纵声长啸：～～～～\n" NOR);
    write(WHT "你纵声长啸：～～～～\n" NOR);
    write("由于你的内力不够，你的声音没法听清楚\n");
    return 1;
  } else {
    shout(WHT "" + me->name() + "纵声长啸：" + arg + "\n" NOR);
    write(WHT "你纵声长啸：" + arg + "\n" NOR);
    if (!wizardp(me))
      me->add("neili", -300);
  }
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : shout <讯息>
 
这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话。当然。这是需要一定的内力和气的。
 
see also : tune
HELP
  );
  return 1;
}
