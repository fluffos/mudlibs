//cmds/arch/xallowip.c
//欢乐英雄
//xallowip.c
// creatied by lion@hero
#include <login.h>;
inherit F_CLEAN_UP;

void create()
{
        seteuid(getuid());
}

int main(object me, string arg)
{
        object ob,user;
        string id;
        if(!arg||sscanf(arg,"-d %s",id)!=1)
                return notify_fail("用法:xallowip -d ID，\n此命令将删除玩家所设定的合法IP范围，请务必小心！！\n");
        user=find_player(id);
        if(!objectp(user))
        {
        ob = new(LOGIN_OB);
        ob->set("id",id);
        if( !ob->restore() )
                return notify_fail("没有这个玩家。\n");
        else
                {  
                  ob->set("body", USER_OB);                                  
          user=LOGIN_D->make_body(ob);
          if(!objectp(user))
          return notify_fail("玩家复制失败。\n");
        if( !user->restore() )
                return notify_fail("玩家档案载入出错。\n");
          user->delete("allowip");
           tell_object(me, "玩家" + user->query("name") + "("+user->query("id")
                + ")的IP范围已经删除！！\n");
           log_file( "allowip", sprintf("%s %s(%s)删除了%s(%s)的ALLOWIP。\n",
                ctime(time()), me->query("name"), me->query("id"),
                ob->query("name"), ob->query("id")));
           user->save();
           destruct(user);
           destruct(ob);
           return 1;
                }
        }
        user->delete("allowip");
                user->save();
        tell_object(me, "玩家" + user->query("name") + "("+user->query("id")
                + ")的IP范围已经删除！！\n");
        log_file( "allowip", sprintf("%s %s(%s)删除了%s(%s)的ALLOWIP。\n",
                ctime(time()), me->query("name"), me->query("id"),
                user->query("name"), user->query("id")));
                return 1;
}


int help(object me)
{
        write(@HELP
指令格式 : xallowip -d ID
这个指令可以完全删除玩家设定的登录IP范围，使用时千万谨慎！！
HELP
    );
    return 1;
}

