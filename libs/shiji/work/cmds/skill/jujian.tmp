inherit F_CLEAN_UP;
#include <ansi.h>
void create() { seteuid(getuid()); }

int main(object me, string arg)
{ object obj;
  int num;
  if (me->query_skill("wuzhu-xinfa")<30)
     return notify_fail("你还不到火候呢！\n");
 if (me->query("family/family_name")!="圣殿")
     return notify_fail("你不是圣殿中人，不能逼出光剑！\n");
  if (present("guangjian", me))
      return notify_fail ("你已经有了一把光剑了。\n");
  message_vision (HIC"$N气息运至手中，只见一把闪闪发亮的光剑出现在$N的手中。\n"NOR,me);
 num=me->query_skill("wuzhu-xinfa");
  obj=new("/u/seaking/guangjian");
  obj->set("weapon_prop/damage",num);
  if (num<15) obj->set("name",HIW"光剑"NOR);
  if (num>=15 && num<30) obj->set("name",HIC"光剑"NOR);
  if (num>=30 && num<50) obj->set("name",HIY"光剑"NOR);
  if (num>=50 && num<75) obj->set("name",HIR"光剑"NOR);
  if (num>=75 && num<100) obj->set("name",HIM"光剑"NOR);
  if (num>=100) obj->set("name",HIG"光剑"NOR);
  obj->move(me);
  return 1;
}
 
int help(object me)
{
    write(@HELP
指令格式 : jujian

这个指令可以让圣殿的弟子逼出光剑。

HELP
);
  return 1;
}

