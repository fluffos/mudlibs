// chongpo.c

#include <skill.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int chongguan(object me);
int halt_chongguan(object me);

int main(object me, string arg)
{
        int chong;
        object where;

        seteuid(getuid());
        where = environment(me);
        
        if (!arg || arg!="rendu")
               return notify_fail("你要干什么？\n");
        if (me->is_busy() || me->query_temp("chong"))
                return notify_fail("你现在正忙着呢。\n");
        if (me->query("rendu")==1)
               return notify_fail("你已经打通任督二脉，冲破生死玄关了！\n");
        if( me->query("food")<200 )
                return notify_fail("你还是吃饱再来吧，不然会走火入魔。\n");
        
        if (me->query("water")<200)
                return notify_fail("你还是喝足再来吧，不然会走火入魔。\n");

        if( !stringp(me->query_skill_mapped("force")) )
                return notify_fail("你必须先用 enable 选择你要用的内功心法。\n");

        if( (int)me->query("max_neili")<2000)
                return notify_fail("你的内力太低，不能强行冲破任督二脉！\n");

        if( (int)me->query("qi") < (int)me->query("max_qi")*3/2 )
                return notify_fail("你生命值太低，恐怕会走火入魔。\n");

        if( (int)me->query("jing")<(int)me->query("max_jing")*3/2)
                return notify_fail("你持久力不够充裕，恐怕会走火入魔！\n");

        me->set_temp("qixi", 500);
        message_vision(HIW"$N开始聚集丹田内的真气，准备冲破任督二脉！\n"NOR, me);
        me->start_busy((: chongguan :), (:halt_chongguan:));
        return 1;
}

int chongguan(object me)
{     int qixi=me->query_temp("qixi");
      me->set_temp("qixi",qixi-=1);
        if (qixi > 0)
             return 1;
        me->set_temp("chong", 0);
        if (random((int)me->query("max_neili")) > 2000)
        {  
          me->set("rendu",1);
          me->set("max_neili",me->query("max_neili")/2);  
          me->delete_temp("qixi");
          message_vision(HIR"$N身体忽然一颤，全身霸气在这一瞬间似乎全部收敛起来了！\n"NOR,me);
          write(HIM"你已经冲破生死玄关，进入返朴归真的境界了。\n"NOR);
          return 0;
        }
        else 
       { me->delete_temp("qixi");
         me->add("max_neili",-50);
         message_vision(HIR"$N忽然发出一声惨叫，然后就不醒人事了。\n",me);
 me->unconcious();
         return 0;
       }        
      
}

int halt_chongguan(object me)
{
        me->add("max_neili",-10);
        me->set_temp("chong", 0);
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : chongpo rendu

冲破任督二脉，使自己达到返朴归真的致高境界。

HELP
        );
        return 1;
}

