#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR"火龙肝"NOR, ({"huolong gan", "gan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", HIY"这是一粒通体朱红色的火龙肝.\n"NOR);
                set("value", 900000);
        }

        setup();
}

int do_eat(string arg)
{
        object me = this_player();
         me->add("max_jingli",50);
         me->add("max_neili",50);    message_vision(HIR"$N喜极若狂，一口吞下了火龙肝。骨骼“喀喇”作响。
\n" NOR, me,);
        

        destruct(this_object());
        return 1;
}


