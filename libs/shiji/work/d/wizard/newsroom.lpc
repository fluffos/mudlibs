#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
          set("short", WHT "新闻发布中心" NOR);
        set("long", @LONG
  这里是世纪的新闻发布中心，有什么新闻都可以在这里发布(post)，
然后系统自动随机通知所有在线玩家。
LONG );
        set("exits", ([
                     "north" : "/d/wizard/bugroom",
        ]));
        set("no_clean_up", 1);
        setup();
        call_other("/clone/board/news_b", "???");
        replace_program(ROOM);
}

int init()
{
object me;
me=this_player();
if(!wizardp(me))
{
me->move("/d/tianlang/street");
}
}
