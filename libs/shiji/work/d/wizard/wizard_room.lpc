// Room: /d/wizard/wizard_room.c
#include <ansi.h>
#include <room.h>
#include <login.h>

inherit ROOM;

void create() {
  set("short", "巫师休息室");
  set("long", @LONG
这里就是「世纪MUD」巫师的休息所在，刚粉刷过的四周墙壁上光
秃秃的什么都没有，屋子的正中央放着一张楠木桌，上面摆着一本
巫师留言簿(board)。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "guest_room",
    "south": "/d/wizard/bugroom",
  ]));
  set("no_clean_up", 0);
  set("valid_startroom", 1);
  setup();

  call_other("/clone/board/wiz_b", "???");
  call_out("init", 1, this_player());
}
void init() {
  object ob;
  ob = this_player();
  if (!wizardp(ob) && wizhood(ob) != "(immortal)") {
    ob->move(__DIR__ "guest_room");
    return;
  }
}
