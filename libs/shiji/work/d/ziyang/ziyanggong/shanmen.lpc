#include <ansi.h>

inherit ROOM;

 
void create()

{

        set("short", "紫阳宫山门");

        set("long",@LONG

这里曾经是紫阳宫的山门，不过，现在紫阳宫已经成为了一片废墟，所
以也不会有人在这里把守了,旁边立着一块牌子（sign）,好象是后来才
放的，很新的样子。
LONG
);
        set("item_desc",([
              "sign":"如果没事，最好别在这附近乱跑，很危险的!\n",
]));
        set("exits",([
              "south": __DIR__"road",
             "north": __DIR__"feixu1",
]));
   
	set("outdoors", "taohua");

	set("no_clean_up", 0);

        setup();

        replace_program(ROOM);

}

void init()

{

	add_action("do_push", "push");

}
int do_push(string arg)
{

        if( arg=="sign")
	
	{
		write("那个牌子发出轧轧的声音，竟然是一个机关。\n");
		message_vision("随着声响，一道暗门出现了。你看得都傻了\n", this_player());
		set("exits/down", __DIR__"under");

		remove_call_out("close");
call_out("close", 4, this_object());

		return 1;
	}
}

void close(object room)
{
	message("vision","只见暗门又缓缓地合上了。\n", room);
	room->delete("exits/down");
}	
