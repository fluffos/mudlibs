

inherit ROOM;

void create()
{
        set("short", "紫阳城宇航局");
	set("long", @LONG
这里是紫阳城的宇航局，凡是要出入城的人，都得在这里接受检查(exam)
后，才能出城的。
LONG
	);
        set("outdoors", "ziyangcheng");
        set("valid_startroom",1);

	set("exits", ([
	        "east" : __DIR__"street2",
	]));

	setup();
	
}

void init()
{
        add_action("do_exam", "exam");
        add_action("do_out", "out");

}
int do_exam(string arg)
{ 
        object me;
        me = this_player();
         write( me->name() + "经过检查确认合格，可以出城（out）\n");
        me->set_temp("hege",1);
        return 1;
}

int do_out(string arg)
{
        object me;
        me = this_player();
        if (me->query_temp("hege") != 1)
return notify_fail("你好象还没接受检查呀？\n");
        else me->move(__DIR__"road");
        message("vision",
                        me->name() + "终于可以出城了，然而，城外多凶险，要注意\n",
                	environment(me), ({me}) );
        return 1;

}
