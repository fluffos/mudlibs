inherit ROOM;

void create() {
  set("short", "紫阳宫废墟");
  set("long", @LONG
这里就是紫阳宫的旧址，昔日热闹的景象自然早已不在，代之以残垣断
壁，四处都蒙上了一层厚厚的土，你看着这里的景物，不禁了产生无限
的感慨。
LONG
  );

  set("exits", ([
    "west": __DIR__ "feixu2",
    "south": __DIR__ "feixu",
    "north": __DIR__ "feixu3",
    "east": __DIR__ "feixu4",
  ]));
  setup();
}
