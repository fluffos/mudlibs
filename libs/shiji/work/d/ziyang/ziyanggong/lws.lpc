#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", BLU "领悟室" NOR);
  set("long", @LONG
这里是供弟子们领悟武功基础的地方，房间的顶上刻着一些图画(top1),(top2),
(top3)，可以供弟子领悟，领悟的多少就看你个人的悟性了。
LONG
  );
  set("exits", ([

    "east": __DIR__ "zoulang2",
  ]));
  setup();
}

void init() {

  add_action("do_lingwu", "lingwu");
}

int do_lingwu(string arg) {
  mapping fam;
  object me = this_player();

  if (!(fam = me->query("family")) || fam["family_name"] != "紫阳派")
    return notify_fail("你不是紫阳传人，如何能领悟紫阳武功？\n");
  if (me->query("jing") < 30)
    return notify_fail("你委实太过劳累，无法凝神继续修炼。\n");

  if ((int)me->query_skill("literate", 1) < 20)
    return notify_fail("以你目前的文化(literate)程度，难以领悟上乘武功。\n");



  if (arg == "top1") {
    if (me->query_skill("force", 1) >= 101)
      return notify_fail("你对基本内功已经有一定的体会，可以找师傅做进一步的学习了。\n");



    //	  if (me->query("potential", 1) < 1)
    //	  return 0;

    message_vision("$N仰视室顶的图纹，慢慢地头顶冒出丝丝白雾，正自领悟上乘内功。\n", me);
    me->receive_damage("jing", 15);
    me->improve_skill("force", (int)(me->query_int() / 2) +
      (int)(me->query_skill("literate", 1) / 5));
    //	  me->add("potential", -1);
    return 1;
  }
  if (arg == "top2") {
    if (me->query_skill("parry", 1) >= 101)
      return notify_fail("你对招架技巧已经有一定的体会，可以找师傅做进一步的学习了。\n");



    //	  if (me->query("potential", 1) < 1)
    //	  return 0;

    message_vision("$N仰视室顶的图纹，慢慢地头顶冒出丝丝白雾，正自领悟招架之法。\n", me);
    me->receive_damage("jing", 15);
    me->improve_skill("parry", (int)(me->query_int() / 2) +
      (int)(me->query_skill("parry", 1) / 5));
    //	  me->add("potential", -1);
    return 1;
  }
  if (arg == "top3") {
    if (me->query_skill("dodge", 1) >= 101)
      return notify_fail("你对躲闪技巧已经有一定的体会，可以找师傅做进一步的学习了。\n");



    //	  if (me->query("potential", 1) < 1)
    //	  return 0;

    message_vision("$N仰视室顶的图纹，慢慢地头顶冒出丝丝白雾，正自领悟躲闪技巧。\n", me);
    me->receive_damage("jing", 15);
    me->improve_skill("dodge", (int)(me->query_int() / 2) +
      (int)(me->query_skill("dodge", 1) / 4));
    //	  me->add("potential", -1);
    return 1;
  }
  return 0;
}
