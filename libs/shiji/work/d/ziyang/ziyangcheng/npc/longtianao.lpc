inherit NPC;

inherit F_MASTER;


object ob = this_object();


void create()

{

  set_name("龙天傲", ({ "long tianao", "long" }));

  set("nickname", "管家");

  set("long",
    "他就是紫阳城城主的管家，城主不在时,主持了紫阳城主家里的事务。\n"
    "身材高大，满脸红光，须眉皆白。\n");

  set("gender", "男性");

  set("age", 70);

  set("attitude", "friendly");

  set("shen_type", 1);

  set("str", 30);

  set("int", 30);

  set("con", 30);

  set("dex", 30);


  set("max_qi", 1000);

  set("max_jing", 400);

  set("neili", 2000);

  set("max_neili", 2000);

  set("jiali", 30);

  set("combat_exp", 500000);

  set("score", 50);

  set("chat_chance_combat", 60);

  set("chat_msg_combat", ({

    (: perform_action, "rusuo" :)
    ,

  }));


  set_skill("force", 70);

  set_skill("dodge", 70);


  set_skill("zidian-ciyun", 70);
  set_skill("unarmed", 70);
  set_skill("xuri-dongsheng", 70);


  set_skill("parry", 70);

  set_skill("sword", 70);


  set_skill("literate", 150);

  set_skill("siling-quan", 70);

  map_skill("force", "zidian-ciyun");
  map_skill("unarmed", "siling-quan");

  map_skill("dodge", "xuri-dongsheng");
  create_family("紫阳派", 4, "弟子");

  set("class", "taoist");


  setup();

  carry_object(__DIR__ "obj/cloth")->wield();

}


void attempt_apprentice(object ob)

{




  if (ob->query_int() < 23) {

    command("say 你天资还差些。");

    command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");

    command("say " + RANK_D->query_respect(ob) + "的悟性还大有潜力可挖，还是请回吧。");

    return;

  }

  command("chat 哈哈哈哈！！！！");

  command("chat 想不到我老朽又觅得一个可塑之才，真是可喜可贺。");

  command("recruit " + ob->query("id"));

}


void kill_ob(object me)

{

  command("chat* crazy " + me->query("id"));

  ::kill_ob(me);

}


void unconcious()

{

  command("chat* 长叹一声：今日始信天外有天，人外有人！");

  ::unconcious();

}
