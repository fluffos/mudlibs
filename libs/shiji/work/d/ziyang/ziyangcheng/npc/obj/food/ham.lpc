inherit ITEM;

inherit F_FOOD;


void create()

{

  set_name("火腿", ({ "huo tui", "tui", "ham", "leg" }));

  set_weight(110);

  if (clonep())

    set_default_object(__FILE__);

  else {
    set("long", "一根火腿,是用新鲜的猪肉制成的。\n");

    set("unit", "根");

    set("value", 190);

    set("food_remaining", 5);

    set("food_supply", 55);

  }

}
