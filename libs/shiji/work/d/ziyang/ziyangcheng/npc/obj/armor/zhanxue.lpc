#include <ansi.h>
#include <armor.h>
inherit BOOTS;

void create() {
  set_name("战靴", ({ "zhan xue", "shoe", "xue" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一双战斗时常用的战靴,穿上它,跳跃十分灵活。\n");
    set("unit", "双");
    set("value", 6000);
    set("material", "cloth");
    set("armor_type", "feet");
    set("armor_prop/armor", 20);
    set("armor_prop/dodge", 15);

  }
}
