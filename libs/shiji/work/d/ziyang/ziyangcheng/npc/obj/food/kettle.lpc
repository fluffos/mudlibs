inherit ITEM;

inherit F_LIQUID;


void create()

{

  set_name("水壶", ({ "shui hu", "kettle", "hu" }));

  set_weight(700);

  if (clonep())

    set_default_object(__FILE__);

  else {

    set("long", "一个用来装清水的壶。\n");

    set("unit", "个");

    set("value", 100);

    set("max_liquid", 8);

  }



  set("liquid", ([

    "type": "water",

    "name": "清水",

    "remaining": 8,

    "drunk_apply": 15,

  ]));

}
