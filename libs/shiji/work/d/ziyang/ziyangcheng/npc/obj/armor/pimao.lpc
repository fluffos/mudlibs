
 
#include <ansi.h> 
#include <armor.h> 
 
inherit HEAD; 
 
void create() 
{ 
        set_name( HIR "皮帽" NOR, ({ "pi mao", "mao" }) ); 
        set_weight(500); 
        if( clonep() ) 
                set_default_object(__FILE__); 
        else { 
                set("unit", "顶"); 
                set("long", "这是一顶皮子做成的帽子。\n"); 
                set("value", 100); 
                set("material", "head"); 
                set("armor_prop/armor", 10); 
 
        } 
        setup(); 
} 
