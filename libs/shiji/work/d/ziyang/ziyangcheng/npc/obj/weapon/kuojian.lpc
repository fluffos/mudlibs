#include <weapon.h>

inherit SWORD;


void create()

{

  set_name("阔剑", ({ "kuo jian", "jian", "sword" }));

  set_weight(10000);

  if (clonep())

    set_default_object(__FILE__);

  else {

    set("unit", "柄");

    set("long", "这是一柄宽刃的重剑,需要一定的臂力才能拿的动。\n");

    set("value", 8000);
    set("weapon_prop/parry", 5);

    set("weapon_prop/dodge", -8);

    set("material", "steel");

    set("wield_neili", 150);

    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");

    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");

  }

  init_sword(90);

  setup();

}
