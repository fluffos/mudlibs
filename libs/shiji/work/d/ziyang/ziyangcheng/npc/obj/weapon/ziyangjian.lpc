#include <ansi.h>
#include <weapon.h>

inherit SWORD;


void create()

{

  set_name(MAG "紫阳剑" NOR, ({ "ziyang jian", "jian", "sword" }));

  set_weight(12000);

  if (clonep())

    set_default_object(__FILE__);

  else {

    set("unit", "柄");

    set("long", "这是紫阳真人的配剑,剑身隐隐带有紫色的光泽。\n");

    set("value", 100000);
    set("no_sell", "这么珍贵的东西,你都不要了吗?");
    set("no_get_from", "你偷了他的兵刃,他该怎么活下去呢?");

    set("material", "steel");

    set("wield_msg", HIW "$N「唰」的一声抽出一柄$n" HIW "握在手中,你感到一种炙热的感觉。\n" NOR);

    set("unwield_msg", HIW "$N将手中的$n插回剑鞘,似乎吹来了一阵凉爽的风。\n");

  }

  init_sword(500);

  setup();

}
