
inherit NPC;


void create()
{
        set_name("弟子", ({"di zi", }));
        set("title", "紫阳城");
        set("gender", "男性");
        set("age", 24);

        set("str", 30);
        set("int", 30);
        set("dex", 30);
        set("con", 30);

        set("qi", 700); 
        set("max_qi", 700);
        set("jing", 200);
        set("max_jing", 200);
        set("shen", 0);

        set("combat_exp",700000);
        set("shen_type", 1);
        set("attitude", "friendly");
        set("env/wimpy", 50);

        set_skill("unarmed", 150);
        set_skill("dodge", 150);
        set_skill("parry", 200);
        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/damage", 40);
          set("chat_chance", 15);
	  set("chat_msg", ({
//		(: random_move :),
		"紫阳城弟子说道：快进来吧，你一定是来休息的，快到里边来吧。\n",
		"紫阳城弟子给你领到一处床铺:\"你就睡在这里吧。\"\n",
	}) );

        setup();
        carry_object("/clone/misc/cloth")->wear();
}

