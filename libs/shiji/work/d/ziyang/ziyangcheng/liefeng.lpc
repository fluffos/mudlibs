#include <ansi.h>
inherit ROOM;
int do_say(string arg);

void create() {
  set("short", "时空裂缝");
  set("long", @LONG
这里是远古时期,由人们的核战争而产生的一处时空的裂缝,这里
不属于任何一个空间,所以为人们闲暇时提供了一个聊天的好去处.大家
都在这里畅所欲言.
LONG
  );
  set("no_fight", "1");
  set("objects", ([
  ]));
  set("valid_startroom", "1");
  set("exits", ([
    "out": "d/ziyang/ziyangcheng/guangchang"
  ]));
  setup();


  call_other(__DIR__ "obj/ziyangc_b", "???");
}


void init() {
  add_action("do_say", "say");
}
int do_say(string arg) {
  object me;
  me = this_player();
  if (arg == "alone,我找你") {
    write(HIW + BLINK "只听空中一个炸雷,一道光柱直奔云霄\n" NOR);
    me->move("/wiz/alone/workroom");
    message("vision",
      me->name() + "从空中走了下来。\n",
      environment(me), ({ me }));
    return 1;
  }
}
