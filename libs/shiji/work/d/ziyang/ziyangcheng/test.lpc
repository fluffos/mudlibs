
inherit ROOM;

void create()
{
	set("short", "中央广场");
	set("long", @LONG
这里是紫阳城的中心广场,自从上次核战后,幸存的人们在废墟上面建
起了这座城市,现在已经又恢复了以往的繁荣,人们也已忘记了那段陈
年的往事,然而,这里却留下了一处时空的裂缝,那是无法补回的...
LONG );
        set("no_sleep_room",1);
        set("outdoors", "ziyangcheng");
	set("item_desc", ([
                "liefeng" : "这是核战引起的后果,里边不知是什么地方\n",
               "裂缝" : "这是核战引起的后果,里边不知是什么地方\n",
        ]));

	set("exits", ([
                "east" : __DIR__"street4",
                "south" : __DIR__"street7",
                "west" : __DIR__"street3",
                "north" : __DIR__"street10",
	]));
	set("objects", ([
             __DIR__"npc/zuo.lpc":1,
	]));
	setup();
}

void init()
{
        add_action("do_enter", "enter");
}

int do_enter(string arg)
{
	object me;
	me = this_player();

        if( !arg || arg=="" ) return 0;

        if( arg=="liefeng"||arg=="裂缝" ) 
	{
		message("vision",
                        me->name() + "消失在了空气当中.。\n",
			environment(me), ({me}) );
                me->move( __DIR__ "liefeng");
                message("vision",
                        me->name() + "突然出现在你的面前。\n",
                	environment(me), ({me}) );
		return 1;
	}
}	
