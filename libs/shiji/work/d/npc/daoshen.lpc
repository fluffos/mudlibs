// npc: daoshen.c
#include <ansi.h>
inherit NPC;
string ask_me();
string ask_him();
void create()
{
   set_name("刀神", ({ "dao shen","shen","dao"}) );
        set("title", HIM "宇宙五大战神之" NOR );
        set("gender", "男性" );
        set("age", 20);
        set("long",     
                "他身上只穿了一条短裤，拿着一把巨刀，显得很酷的样子。\n");
        set("str", 30);
        set("dex", 30);
        set("con", 17);
        set("int", 30);
        set("shen_type", 0);
        set("max_neli",3000);
        set("jiali",100);

        set_skill("unarmed", 150);
        set_skill("dodge", 150);
        set_skill("force",150);
        set_skill("sword",150);
        set_skill("parry",150);
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/damage",50);

        set("combat_exp", 2500000);
        set("score",0);
        
        set("attitude", "peaceful");
        
        set("inquiry", ([
                "搞把刀来用"  : (: ask_me :),
                "把我的刀还给我" : (: ask_him :),
        ]) );

        setup();
}

void init()
{
        ::init();
        add_action("do_zuo","zuo");
}

string ask_him()
{
  object me,obj;
  me=this_player();
  if (!me->query("weapon/make"))
    return "你又没做武器，别来烦我啦！\n";
  if (me->query("money")<2000)
    return "你还是赚够钱再来吧！\n";
  if (present("myblade",me))
    return "你已经有一把了！\n";
  obj=new("/d/npc/obj/m_blade",1);
  me->add("money",-2000);
  obj->move(me);
  return "这是你的破刀，还给你吧！\n";

}
string ask_me()
{  
   object me;
   me=this_player();     
   if (me->query("family/family_name")!="特种部队")
     return "你不是特种部队的，不能在此做刀！\n";
   me->set_temp("m_blade",1);
 message("vision",HIR"刀神点了点头说道：OK，LET'S DO IT!\n"NOR, me);
   write("请你给自己的刀起个酷点的名字吧！(zuo <刀名> <英文代号>)\n");
   return "快点，别磨磨蹭蹭！\n";

}

int do_zuo(string arg)
{
        string o_name,id,w_name;
        object blade,make_time; 
        object me;
        me = this_player();
        if(!(me->query_temp("m_blade")) )
                return notify_fail("什么?\n");
        me->delete_temp("m_blade");
        me->delete_temp("get_orc");
        me->delete_temp("or");

        if (me->query("money")<10000) 
          {
             say("你没钱跑来干什么，给我滚！\n");
             return 0;
          }
        if((me->query("weapon/make")) ){
                say("刀神望着你做不得声：你有点宝气吧，带我笼子？\n");
                return 0;
        }
        if( !arg )
                return notify_fail("刀神认真的说：快点把名字告诉我落。\n");

        sscanf(arg ,"%s %s" ,w_name ,id);
        if(!w_name||!id)
                return notify_fail("什么?(使用zuo <刀名> <英文代号>\n)");
        make_time=NATURE_D->game_time();
        message_vision(HIM "刀神拿出把破刀交给你，然后嘿嘿的奸笑了几声！\n" NOR,me );
me->add("money",-10000);
        w_name = replace_string(w_name, "$BLK$", BLK);
        w_name = replace_string(w_name, "$RED$", RED);
        w_name = replace_string(w_name, "$GRN$", GRN);
        w_name = replace_string(w_name, "$YEL$", YEL);
        w_name = replace_string(w_name, "$BLU$", BLU);
        w_name = replace_string(w_name, "$MAG$", MAG);
        w_name = replace_string(w_name, "$CYN$", CYN);
        w_name = replace_string(w_name, "$WHT$", WHT);
        w_name = replace_string(w_name, "$HIR$", HIR);
        w_name = replace_string(w_name, "$HIG$", HIG);
        w_name = replace_string(w_name, "$HIY$", HIY);
        w_name = replace_string(w_name, "$HIB$", HIB);
        w_name = replace_string(w_name, "$HIM$", HIM);
        w_name = replace_string(w_name, "$HIC$", HIC);
        w_name = replace_string(w_name, "$HIW$", HIW);
        w_name = replace_string(w_name, "$NOR$", NOR);
        w_name = replace_string(w_name, "$BLINK$", BLINK);
        me->set("weapon/make",1);               //武器制造后防止再造的标志              
        me->set("weapon/name",w_name +NOR);     //武器的名称
        me->set("weapon/id",id);                //武器的代号
        me->set("weapon/lv",1);         //武器等级
        me->set("weapon/value",0);              //记录武器升级已有的点数        
        me->set("weapon/time",make_time);
        me->set("weapon/type","刀");

    blade=new("/d/npc/obj/m_blade",1);  //生成新刀
        blade->move(this_player());
        return 1;
}

