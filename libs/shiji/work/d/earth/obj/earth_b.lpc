inherit BULLETIN_BOARD;

void create()
{
    set_name("电子公告版",({ "board" }) );
    set("location", "/d/earth/gate");
    set("board_id", "earth_b");
    set("long", "这是一个非常先进的电子公告板。\n");
    setup(); 
    set("capacity", 50);
    replace_program(BULLETIN_BOARD);
}
