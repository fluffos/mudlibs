inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIY "枪法训练室" NOR);
  set("long", @LONG
这里就是特种部队的枪法训练室，领了任务的
可以到这里(xunlian gun)来增强自己的枪法。
LONG
  );
  set("no_fight", 1);

  set("exits", ([

    "east": __DIR__ "xunlianshi3",
    "west": __DIR__ "xunlianshi1",
  ]));
  setup();

}
void init() {
  add_action("do_xunlian", "xunlian");
}
int do_xunlian(string arg) {
  object me;
  int exp;
  me = this_player();
  if (!arg || arg != "gun") return notify_fail("你要训练什么？\n");
  if (me->query_temp("tilifin") != 1) return notify_fail("你还是先去做体力训练吧！\n");
  if (me->query("jing") < 10) return notify_fail("你的生命力不够，休息一下再来吧！\n");
  if (me->is_busy()) return notify_fail("你正忙着呢！\n");
  me->add("jing", -5);
  if (random(8) < 2) {
    message_vision("$N望了望正在远处抽烟的教官，坐下来休息了一会儿！\n", me);
    me->start_busy(1);

  }

  else {
    message_vision("$N瞄准远处的枪靶，开始射击。\n", me);
    me->add_temp("gun", 1);
    me->start_busy(1);
    if (me->query_temp("gun") > 10) {
      me->set_temp("tilifin", 0);
      me->set_temp("gunfin", 1);
      me->improve_skill("gun", 5 * random(me->query_int()));
      me->set_temp("gun", 0);
      write("你的枪法训练已经结束！\n");
    }
  }
  return 1;
}
