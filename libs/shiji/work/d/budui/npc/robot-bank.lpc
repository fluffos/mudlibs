inherit NPC;
inherit F_BANKER;
#include <ansi.h>
void create()
{
        set_name("特种银行机器人", ({"robot-bank", "robot", "bank"}));
        set("title", "特种银行老板");
        set("nickname", HIB"有钱就行"NOR);
        set("gender", "男性");
        set("age", 10);

        set("str", 22);
        set("int", 24);
        set("dex", 18);
        set("con", 18);

        set("qi", 800);
        set("max_qi", 800);
        set("jing", 200);
        set("max_jing", 200);
        set("shen", 0);

        set("combat_exp", 100000);
        set("shen_type", 1);
        set("attitude", "friendly");
        set("env/wimpy", 50);
        set("chat_chance", 2);
        set("chat_msg", ({
        "机器人骄傲的说道：本银号已经有上百年的历史，在特种联盟可以说是第一家。\n",
        }));

        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/damage", 40);

        setup();
        
}

void init()
{
       add_action("do_zhuanzhang", "zhuanzhang");
}

