inherit F_DEALER;
inherit NPC;
#include <ansi.h>
void create()
{
        set_name(HIY"服务小姐"NOR, ({ "xiao jie","jie","xiao"}));
	set("shen_type", 0);

	set("gender", "女性");
	set_max_encumbrance(100000000);
	set("age", 23);
	set("long",
		"这位女服务小姐看上去美若天仙，品行端庄，气质非凡。\n"
                "一看就知道是名门之女，但究竟是谁家闺秀，这仍然是个谜！\n");
	set("no_get_from", 1);

        set_skill("unarmed", 100);
        set_skill("dodge", 100);


        set_temp("apply/attack", 50);
        set_temp("apply/damage", 25);

        set("combat_exp", 100000);
	set("attitude", "friendly");
        set("vendor_goods",({
                                "/d/budui/obj/ganpi",
                                "/d/budui/obj/baijiu",
                                "/d/budui/obj/meixinjiu",
          }));
	
	setup();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
	
}

void die()
{
	message_vision("\n$N死了。\n", this_object());
	destruct(this_object());
}
