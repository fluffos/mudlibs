inherit NPC;
#include <ansi.h>
void close_door(object room);
void create()
{
        set_name("犯人", ({ "fanren", "ren" }) );
        set("long",
                "这是一个长相十分凶恶的犯人，满脸横肉，眼神里带着股杀气。\n");
        set("attitude", "peaceful");
        set("chat_chance", 1);
        set("chat_msg", ({"犯人嘿嘿嘿地冷笑起来，对你说道：“兄弟，搞点MONEY给我玩玩！\n",}) );
        set("age", 50);
        set("combat_exp", 50000);
        set("max_jing", 800);
        set("max_qi", 800);
        set_skill("dodge", 100);
        set_skill("unarmed", 100);
        set_temp("apply/armor", 30);
        set_temp("apply/damage", 20);
        setup();
}
void init()
{
   add_action("do_gei","gei");
}
int do_gei(string a)
{
 object me;
 object room;
  me = this_player();
 if (!a) return notify_fail("你要给谁多少钱？\n");
 if (a != "1000") return notify_fail("犯人摇了摇头，失望的看着你。\n");
           message_vision(HIY"犯人左右张望了一下，偷偷替$N打开了通向别的地方的地道！\n"NOR, me);
 me->add("money",-1000);
        room = load_object("d/budui/jianyu1");
          room->set("exits/down","d/budui/midao1");
                remove_call_out("close_door");
                call_out("close_door", 10, room);
return 1;
}
void close_door(object room)
{    
     message_vision("犯人向前大跨一步，把小门关上了！\n",room); 
     room->delete("exits/down");
}   
