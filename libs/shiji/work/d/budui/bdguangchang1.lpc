inherit ROOM;

void create() {
  set("short", "特种部队联盟镇第二层");
  set("long", @LONG
这是特种部队联盟的镇的第二层，这一层是供特种队员购买战斗装备及道具的地方，
这一层，也是特种部队联盟镇最热闹的一层，四周来来往往的行人特多。前面有一块电子显
示屏，上面好象是第二层的购物地图(map)，你可以过去看看。
LONG
  );
  set("item_desc", ([
    "map": "  往东： 通往防具总汇。\n" +
    "  往西： 通往光能武器店。\n" +
    "  往北： 通往废品收购站。\n" +
    "  往南： 通往特种食品店。\n" +
    "  往下： 回到第一层。\n" +
    "  往上： 上到第三层。\n"
  ]));
  set("exits", ([
    "east": __DIR__ "armorshop",
    "west": __DIR__ "wuqidian1",
    "north": __DIR__ "shougou",
    "south": __DIR__ "foodshop",
    "down": __DIR__ "bdguangchang",
    "up": __DIR__ "bdguangchang2",
  ]));
  set("objects", ([ __DIR__ "npc/tezhongbing": 2,
    __DIR__ "npc/jkwushi": 3, ]));
  setup();
  replace_program(ROOM);
}
