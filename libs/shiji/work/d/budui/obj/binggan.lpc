// binggan.c 压缩饼干

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
	set_name(HIW"压缩饼干"NOR, ({"bing gan", "gan"}));
	set_weight(80);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一包绿色派的压缩饼干。\n");
		set("unit", "个");
              set("value",30);
		set("food_remaining", 3);
		set("food_supply", 50);
	}
}
