inherit ITEM;
#include <ansi.h>
void setup()
{}

void init()
{
	add_action("do_drink", "drink");
}

void create()
{
	set_name("能量之泉", ({"power", "quan", "power"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "瓶");
		set("long", "这是一瓶能量之泉。\n");
                set("value", 580);
	}
	setup();
}

int do_drink(string arg)
{
	if (!id(arg))
		return notify_fail("你想喝什么药？\n");
    if ((int)this_player()->query("qi") > 
	    (int)this_player()->query("max_qi"))
		return notify_fail("你现在不需要用能量之泉。\n");
	else {
          this_player()->receive("qi", 50);
		message_vision("$N喝下一瓶能量之泉，气色看起来好多了。\n", this_player());
		destruct(this_object());
		return 1;
	}
}

