inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>
void create() {
  set_name(HIW "太空酒" NOR, ({ "bai jiu", "jiu" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一瓶全外太空都流行喝的酒。\n");
    set("unit", "瓶");
    set("value", 100);
    set("max_liquid", 10);
  }


  set("liquid", ([
    "type": "alcohol",
    "name": "白酒",
    "remaining": 3,
    "drunk_supply": 10,
  ]));
}
