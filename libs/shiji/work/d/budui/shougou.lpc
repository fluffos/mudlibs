inherit ROOM;

void create() {
  set("short", "废品收购站");
  set("long", @LONG
这是一家“废品”收购站，不过私自也收购一些贵重兵器，和道具。废品收购站的主人
是位女士，从表面上看去，也不知她是机器人还是人类。这里是整个特种部队联盟镇最热闹的地
方。门口有一块牌子(paizi)。
LONG
  );
  set("no_fight", 1);
  set("no_beg", 1);
  set("item_desc", ([
    "paizi": "请用 \"list\" 列出货物表，\"buy\" 向老板购物,\"sell\"卖掉身上的物品。\n",
  ]));
  set("exits", ([
    "south": __DIR__ "bdguangchang1",
    "east": __DIR__ "yaopu",
    "west": __DIR__ "wuqidian2",
  ]));
  set("objects", ([ "/d/budui/npc/nvlaoban": 1, ]));

  setup();
  "/d/budui/obj/board"->foo();
}
