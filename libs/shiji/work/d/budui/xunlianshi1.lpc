inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", HIY"体力训练室"NOR);
        set("long", @LONG
这里就是特种部队的体力训练室，领了任务的
可以到这里(xunlian tili)来增强自己的体力。
LONG
        );
        set("no_fight",1);

        set("exits", ([
                
                "east"  : __DIR__"xunlianshi2",
 "west"     : __DIR__"didao2",
        ]));
        setup();
        
}
void init()
{
        add_action("do_xunlian", "xunlian");
}
int do_xunlian(string arg)
{
        object me;
        int exp;
        me = this_player();
  if (!arg || arg!="tili") return notify_fail("你要训练什么？\n");
  if (me->query_temp("xunlian")!=1) return notify_fail("你还是先去领任务吧！\n");
  if ( me->query("qi") < 10 ) return notify_fail("你的生命力不够，休息一下再来吧！\n");
  if ( me->is_busy()) return notify_fail("你正忙着呢！\n");
  me->add("qi", -5);
        if ( random(8) < 3 )
        {
                message_vision("$N望了望正在远处抽烟的教官，坐下来休息了一会儿！\n", me);
                me->start_busy(1);
       
       }

        else
        {
                message_vision("$N开始做起引体向上来。\n", me);
                me->add_temp("tili",1);
                me->start_busy(1);
                if (me->query_temp("tili")>8)
                   {me->set_temp("xunlian",0);
                    me->set_temp("tilifin",1);
                   me->improve_skill("unarmed", 5 * random(me->query_int()));
                    me->set_temp("tili",0);
                write("你的体力训练已经结束！\n");  
                }
        }
return 1;
}

