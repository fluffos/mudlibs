inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "秘密基地");
  set("long", @LONG
这里就是特种部队的秘密基地了，能来这里的人，基本上都是特种部队的
精英了特种部队的龙头老大也在这儿，他们正围在一团，向是在商量着什
么似的枪上有一些花花绿绿的按扭(anniu)。
LONG);
  set("exits", ([ "east": "/d/budui/didao3", ]));
  set("objects", ([
    "/kungfu/class/budui/master": 1,
  ]));
  setup();
}
void init() {
  add_action("do_press", "press");
}
int do_press(string arg) {
  object me;
  object room;
  me = this_player();

  if (!arg || (arg != "anniu")) return notify_fail("你想按什么？\n");
  message_vision("你按了一下按扭……\n", me);
  if (me->query_temp("大任务")) {
    message_vision(HIY "结果墙上出现了一个巨大的洞……\n" NOR, me);
    room = load_object("/d/budui/mimijidi");
    room->set("exits/enter", "/d/budui/mimididao1");
    remove_call_out("close");
    call_out("close", 2, this_object());
    return 1;
  } else return notify_fail("结果什么事都没有！\n");
}
void close(object room) {
  message("vision", "墙上的地洞很快又合上了。\n", room);
  room->delete("exits/enter");
}
