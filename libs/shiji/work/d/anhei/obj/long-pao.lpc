//heilongpao.c
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("黑龙袍", ({"heilong pao", "heilong", "pao"}) );
    set_weight(2000);
    if( clonep() )
       set_default_object(__FILE__);
    else {
	set("unit", "件");
		set("long", "这是件由黑龙皮做的长袍。\n");
	set("material", "cloth");
	set("armor_prop/armor", 200);
        set("value",10000000);
    }
    setup();
}
