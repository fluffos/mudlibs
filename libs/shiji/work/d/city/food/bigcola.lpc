// bigcola.c  

inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("大可乐", ({"big cola", "cola"}));
        set_weight(300);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一瓶又大又凉快的可乐.\n");
                set("unit", "瓶");
                set("value", 200);
                set("max_liquid", 50);
        }

        // because a container can contain different liquid
        // we set it to contain wine at the beginning
        set("liquid", ([
                "type": "alcohol",
                "name": "大可乐",
                "remaining": 30,
                "drunk_supply": 10,
        ]));
}

