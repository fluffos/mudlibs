inherit ROOM;
void create() {
  set("short", "小路");
  set("long", @LONG
这里是一条小路，一眼望去，似乎很长很长，不知道要通向哪里
路旁杂草丛生，密密麻麻的隐伏着危机……
LONG);
  set("exits", ([
    "south": __DIR__ "dongdajie3",
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "n" && dir == "north") return notify_fail("你想向北走，一个甜甜的声音在提醒你：“北面还没做好，谢谢合作！”\n");
  return 1;
}
