#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create()
{
        set_name("接待小姐", ({ "xiao jie", "xiao", "jie" }));
        set("long", "她是卡啦OK厅的接待小姐，满脸都是敷衍的笑。\n");
            set ("title", HIB  "不要乱摸" NOR);
        set("gender", "女性");
        set("age", 23);
        set("attitude", "friendly");
        set("shen_type", -1);

        set("per", 15);
        set("str", 15);
        set("int", 14);
        set("con", 15);
        set("dex", 16);
        set("qi", 200);
        set("max_qi", 200);
        set("jing", 200);
        set("max_jing", 100);
        set("neili", 300);
        set("max_neili", 300);
        set("combat_exp", 20000);

        set_skill("unarmed", 90);
        set_skill("dodge", 90);
        set_skill("parry", 90);

        set("chat_chance", 1);
        set("chat_msg", ({
                "接待小姐说道：欢迎光临！\n",
                        "接待小姐说道：您要唱歌吗？\n",
        }) );

        setup();
        carry_object("/d/city/obj/qun")->wear();
}

