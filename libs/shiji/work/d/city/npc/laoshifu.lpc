inherit NPC;
#include <ansi.h>
void create() {
  set_name("老师傅", ({ "shi fu", "shi", "fu" }));
  set("title", HIR "独一无二" NOR);
  set("gender", "男性");
  set("age", 72);

  set("long", "一个老师傅，据闻是全星球最好的机器人装配专家。\n");
  set("combat_exp", 300000);
  set("shen_type", 2);
  set_skill("zhizao-shu", 200);
  set("chat_msg", ({
    "老师傅说：你要学制造术吗？",
    "老师傅说道：我的技术可是世界一流的。",
    "老师傅说：只要10电子货币就可以学，多便宜。",
  }));
  setup();
}

int recognize_apprentice(object ob) {
  if (ob->query("money") < 10)
    return 0;
  ob->add("money", -10);
  return 1;
}
