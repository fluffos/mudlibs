#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create()
{
        set_name("厉时", ({ "li shi", "li", "shi" }));
        set("long", "他就是警司厅的厅长了，从他脸上的皱纹可以看出他
是一个很精明的警察头儿。\n");
            set ("title", RED  "警司厅厅长" NOR);
        set("gender", "男性");
        set("age", 39);
        set("attitude", "friendly");
        set("shen_type", 1);

        set("per", 20);
        set("str", 20);
        set("int", 20);        set("con", 20);        set("dex", 26);
        set("qi", 2000);
        set("max_qi", 2000);
        set("jing", 2000);
        set("max_jing", 1000);
        set("neili", 3000);
        set("max_neili", 3000);
        set("combat_exp", 200000);

        set_skill("unarmed", 90);
        set_skill("dodge", 90);
        set_skill("parry", 90);

        set("chat_chance", 10);
        set("chat_msg", ({
                "厉时拿起电话的听筒：啊，是我.......什么！！！还没抓住？？再抓不住看
我怎么整你！！！！\n",
                        "厉时气冲冲的放下电话，生气的骂道：一群废物！\n",
        }) );

        setup();
        carry_object("/d/city/obj/cloth1")->wear();
}


