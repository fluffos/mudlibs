inherit NPC;
#include <ansi.h>
void create() {
  set_name("宇航英雄", ({ "shi fu", "shi", "fu" }));
  set("title", HIR "超一流驾驶员" NOR);
  set("gender", "男性");
  set("age", 42);

  set("long", "一个战舰驾驶员，据说在当年的无祖之战中立下了战功。\n");
  set("combat_exp", 500000);
  set("shen_type", 2);
  set_skill("jiashi-shu", 200);
  setup();
}

int recognize_apprentice(object ob) {
  if (ob->query("money") < 5)
    return 0;
  ob->add("money", -5);
  return 1;
}
