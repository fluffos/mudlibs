inherit ROOM;
void create()
{  string num1,num2,num3,num4;
  num1=sprintf("%d",random(10)+1);
  num2=sprintf("%d",random(10)+1);
  num3=sprintf("%d",random(10)+1);
  num4=sprintf("%d",random(10)+1);
    set("short", "外太空");
    set("long", @LONG
这里是太空隧道。只见附近群星闪耀，令人心旷神怡。
根据雷达扫描星系坐标显示，这里似乎是位于天秤星系
一带。
LONG );
set("no_clean_up",0);
     set("exits", ([
       "west" : __DIR__"tiancheng"+num1, 
       "east" : __DIR__"tiancheng"+num2,
       "north" : __DIR__"tiancheng"+num3, 
       "south" : __DIR__"tiancheng"+num4, 
        ]));
    set("canrun",1);
    setup();
}

