#include <room.h>

inherit ROOM;

void create()
{
	set("short", "后花院");
	set("long", @LONG
这里长满了奇花异草，空气中扬溢着阵阵清香，使人觉得
舒畅无比。花从中另辟了一条白石小道，弯弯曲曲的不知会
通向那里。几只辛勤的密峰飞舞在花从中。
LONG );
	set("exits", ([
"south" : __DIR__"shoulao",
	]));
        set("objects", ([
           "/d/shendian/npc/ma" : 1,
       "/d/shendian/npc/wushi1" : 2,
        ]));
	set("outdoors", "shendian");
	setup();
}
