#include <room.h>

inherit ROOM;

void create()
{
	set("short", "练武场");
	set("long", @LONG
这里是圣岛武士练功的场所，面积还是十分的大，几位身着灰白色劲装
的圣岛武士正在练士长的指导下，学习各种武功，其中有几位身法分外的
的轻盈，显然武功已有大成。
LONG );
	set("exits", ([
		"southeast" : __DIR__"guangchang",
		"south" : __DIR__"yongshan",
		"west" : __DIR__"ruxi",
		"east" : __DIR__"jiaoshi",
		"north" : __DIR__"wuqiku",
	]));
        set("objects", ([
                "/d/shendian/npc/lianchang" : 1,
        ]));
	set("outdoors", "shendian");
	setup();
}
