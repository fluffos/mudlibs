inherit NPC;
inherit F_DEALER;
#include <ansi.h>

void create() {
  set_name(HIR "老板" NOR, ({ "laoban", "laoban" }));
  set("title", HIC "电信局" NOR);
  set("shen_type", 0);

  set("gender", "男性");
  set_max_encumbrance(100000000);
  set("age", 50);
  set("long",
    "他就是电信局的老板，在他的领导下，特种电信局办得有声有色！\n"
    "他唯一的爱好就是-------玩泥巴！\n");
  set("no_get_from", 1);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_temp("apply/attack", 30);
  set_temp("apply/attack", 30);
  set_temp("apply/damage", 15);

  set("combat_exp", 1);
  set("attitude", "friendly");
  set("vendor_goods", ({
    "/u/seaking/shouji",
    "/u/seaking/xunhuji",
    "/u/seaking/jieshouqi",
  }));
  set("chat_chance", 1);
  set("chat_msg", ({ "老板对你说道：“要买手机吗，最新到货！\n", }));



  setup();
}
void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
