#include <command.h>
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("阿吧琦", ({ "a baqi", "baqi" }));
  set("nickname", HIY "仇深似海" NOR);
  set("gender", "男性");
  set("age", 52);
  set("attitude", "friendly");
  set("class", "scholar");
  set("str", 30);
  set("int", 28);
  set("con", 30);
  set("dex", 30);
  set("chat_chance", 1);
  set("max_qi", 1500);
  set("max_jing", 500);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 100);
  set("shen_type", 1);

  set("combat_exp", 300000);
  set_skill("force", 120);
  set_skill("sword", 120);
  set_skill("dodge", 120);
  set_skill("guang-jian", 130);
  set_skill("wuzhu-xinfa", 120);
  set_skill("shunjian-yidong", 120);
  map_skill("sword", "guang-jian");
  map_skill("force", "wuzhu-xinfa");
  map_skill("dodge", "shunjian-yidong");
  setup();
  carry_object("/d/shendian/obj/duzhenjian")->wield();
}

int accept_object(object who, object ob) {
  int exp;
  if (query("sharen") < 0) {
    command("say " + RANK_D->query_respect(who) + "我很累，你回头再来领赏吧。");
    return 0;
  }
  if (strsrch(ob->query("name"), "小孩的头颅") < 0 &&
    strsrch(ob->query("name"), "郏芯的头颅") < 0 &&
    strsrch(ob->query("name"), "铸剑师的头颅") < 0 &&
    strsrch(ob->query("name"), "店员的头颅") < 0 &&
    strsrch(ob->query("name"), "特种兵的头颅") < 0 &&
    strsrch(ob->query("name"), "老板的头颅") < 0 &&
    strsrch(ob->query("name"), "警察的头颅") < 0 &&
    strsrch(ob->query("name"), "皇族卫士的头颅") < 0 &&
    strsrch(ob->query("name"), "楼笑风的头颅") < 0 &&
    strsrch(ob->query("name"), "皇族勇士的头颅") < 0 &&
    strsrch(ob->query("name"), "食肉龙的头颅") < 0 &&
    strsrch(ob->query("name"), "刘德花的头颅") < 0 &&
    strsrch(ob->query("name"), "顽童的头颅") < 0 &&
    strsrch(ob->query("name"), "年青女郎的头颅") < 0 &&
    strsrch(ob->query("name"), "星际浪子的头颅") < 0) {
    command("say 给我这些东西有什么用？\n");
    return 0;
  } else {
    command("say 不错不错，我一直想杀这些家伙，谢你代劳了。");
  }
  exp = 20 + random(30);
  add("jinbing", -1);
  tell_object(who, HIW "阿巴琦奖励了你\n" + chinese_number(exp) + "点战斗值\n" NOR);
  ob->add("combat_exp", exp);
  return 1;
}
