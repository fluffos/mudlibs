// shan.c [wlcq lsg 1999/11/23]

inherit NPC;
#include <ansi.h>;
int time_period(int timep, object me);
void create() {
  set_name(HIR "柳清漩" NOR, ({ "liu qinxue", "liu" }));
  set("title", HIC "圣殿长老团" NOR);
  set("age", 133);
  set("str", 25);
  set("dex", 16);
  set("per", 15);
  set("long",
    "圣殿德高望重的长老。\n");
  set("combat_exp", 3000000);
  set("shen_type", 1);
  set("attitude", "peaceful");

  set_skill("unarmed", 80);
  set_skill("force", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/armor", 100);
  set_temp("apply/damage", 100);

  set("neili", 5000);
  set("max_neili", 5000);
  set("jiali", 200);

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("give_quest", "quest");
}

int give_quest() {
  mapping quest;
  object me;
  int j, combatexp, timep, factor, num;
  string tag = "2000000";
  string *levels = ({
    "500000",

  });
  me = this_player();
  combatexp = (int)(me->query("combat_exp"));
  if (combatexp < 400000) {
    message_vision("柳长老看了$N一眼,说到：“你还是再去磨练磨练再来吧？”\n", me);
    return 1;
  }

  // Let's see if this player still carries an un-expired task
  if ((quest = me->query("quest"))) {
    if (((int)me->query("task_time")) > time()) {
      message_vision("柳长老对$N邪视一眼道：让你办的事如何了？\n", me);
      return 0;
    } else {
      //message_vision("柳长老对着$N叹了一口气：哎，我就再给你一次机会吧。\n", me);
      me->add("qi", -(int)(me->query("qi") / 10));
    }
  }

  for (j = sizeof(levels) - 1; j >= 0; j--) {
    if (atoi(levels[j]) <= combatexp) {
      num = j;
      factor = 10;
      break;
    }
  }
  if (num > 0) {
    if (random(50) > 45) {
      num = num - 1;
    }
  } else {
    if ((num < sizeof(levels) - 1) && (random(100) > 95)) {
      num = num + 1;
      factor = 15;
    }
  }
  tag = levels[num];
  quest = QUESTS_D(tag)->query_quest();
  timep = quest["time"];

  time_period(timep, me);
  if (quest["quest_type"] == "带")
    tell_object(me, "先替我把『" + quest["quest"] + "』带来给我。\n");
  quest["exp_bonus"] = quest["exp_bonus"];
  quest["pot_bonus"] = quest["pot_bonus"];
  quest["score"] = quest["score"];

  me->set("quest", quest);
  me->set("task_time", (int)time() + (int)quest["time"]);
  me->set("quest_factor", factor);
  return 1;
}

int time_period(int timep, object me) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";

  tell_object(me, "柳长老说道：请你在" + time + "内");
  return 1;
}

int accept_object(object who, object ob) {
  int bonus, exp, pot, score, factor;
  string test;
  mapping quest;
  if (!(quest = who->query("quest"))) {
    tell_object(who, "柳长老说道：这不是我想要的。\n");
    return 0;
  }

  if (ob->query("name") != quest["quest"]) {
    tell_object(who, "柳长老说道：这是什么东西？我叫你做点事你就这样糊弄我？！\n");
    return 0;
  }

  if ((int)who->query("task_time") < time()) {
    tell_object(who, "柳长老说道：真是废物！你没有在指定的时间内回来！\n");
    destruct(ob);
    return 0;
  } else {
    tell_object(who, "柳长老赞许地点头说道：不错！任务完成得还不错！\n");
    exp = quest["exp_bonus"] + random(quest["exp_bonus"]);
    pot = quest["pot_bonus"] + random(quest["pot_bonus"]);
    score = quest["score"] / 2 + random(quest["score"] / 2);
    factor = who->query("quest_factor");
    destruct(ob);

    if (factor) {
      exp = exp * factor / 8;
      pot = pot * factor / 8;
      score = score * factor / 8;
    }
    bonus = (int)who->query("combat_exp");
    bonus += exp;
    who->set("combat_exp", bonus);
    bonus = (int)who->query("potential");
    bonus = bonus - (int)who->query("learned_points");
    bonus = bonus + pot;
    if (bonus > 30000) bonus = 30000;
    bonus += (int)who->query("learned_points");
    who->set("potential", bonus);
    tell_object(who, HIW "你被奖励了：" + chinese_number(exp)
      + "点战斗值，" + chinese_number(pot) + "点学习值。\n" NOR);
    who->set("quest", 0);
    tell_object(who, HIW "恭喜你完成一个任务！\n" NOR);
    return 0;
  }
  return 1;
}
