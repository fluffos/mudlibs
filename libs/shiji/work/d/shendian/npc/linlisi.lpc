#include <command.h>
#include <ansi.h>
inherit NPC;                                                                    
inherit F_MASTER;                                                               
void create()
{
        set_name( "林丽丝" ,({ "lin lisi", "lisi" }));
        set("nickname", HIY "【婧女姣娘】" NOR);
        set("gender", "女性");
        set("age", 32);
        set("long",
            "据说年轻的时候是很漂亮。\n");
        set("attitude", "friendly");
        set("str", 30);
        set("int", 28);
        set("con", 30);
        set("dex", 30);
        set("per", 30);
        set("chat_chance", 1);
        set("max_qi",1500);
        set("max_jing",500);
        set("neili", 1500);
        set("max_neili", 1500);
        set("jiali", 100);
        set("shen_type",1);

        set("combat_exp", 300000);
        set_skill("force", 210);
        set_skill("sword", 220);
        set_skill("parry", 210);
        set_skill("dodge", 210);
        set_skill("literate", 180);
        set_skill("guang-jian",220);
        set_skill("wuzhu-xinfa",220);
        set_skill("shunjian-yidong",220);
        map_skill("sword", "guang-jian");      
        map_skill("force", "wuzhu-xinfa");      
        map_skill("dodge", "shunjian-yidong");   


        create_family("圣殿", 3, "");
      set("title","圣殿低阶武士");
        setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
}

void attempt_apprentice(object ob)
{
        if (ob->query_dex() < 20)
        {
           command("say 圣殿武功讲究轻灵巧捷。");
           command("say 这位"+RANK_D->query_respect(ob)+"可能是白来圣殿一趟了。");
           return;
        }
        if ((int)ob->query("shen") < 0)
        {
           command("say 圣殿利来以正义为主，"+ RANK_D->query_respect(ob)+"请回吧。");
           return;
        }
        if (ob->query_skill("literate",1) <= 10)
        {
           command("say 虽然武功十分重要，但文化方面也不可不学，这位"+RANK_D->query_respect(ob)+"是否去读点书再来。");
           return;
        }
        command("smile");
        command("say " + RANK_D->query_respect(ob) + "很好，希望以后更加努力。");
        command("recruit " + ob->query("id"));
}
int accept_fight(object ob)
{
        command("wield jian");
}
