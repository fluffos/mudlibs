#include <ansi.h>
inherit NPC;
inherit F_BANKER;

void create()
{
        set_name("露和笙", ({"banker", "zhiyuan"}));
 set("title", HIR "银行职员" NOR);
     set("nickname", HIM "国色天香" NOR);
        set("gender", "女性");
        set("age", 24);
        set("str", 20);
        set("int", 24);
        set("dex", 40);
        set("per", 40);
        set("con", 18);
        set("qi", 1000);
        set("max_qi", 1000);
        set("jing", 1000);
        set("max_jing", 1000);
        set("shen", 0);

        set("combat_exp", 50000);
        set("shen_type", 1);
        set("attitude", "friendly");
        set("env/wimpy", 50);
        set("chat_chance", 2);
        set("chat_msg", ({
   "露和笙对你嫣然一笑：你好，本银号已是千年老店，服务通启遍全国。\n",
  "露和笙笑着说道：你好，有什么需要服务吗？\n"
        }));
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/damage", 40);
        setup();
        add_money("gold", 5);
}

void init()
{
 add_action("do_zhuanzhang", "zhuanzhang");
}



