#include <ansi.h>

inherit NPC;

int do_look(string var);
int ask_me();

void create()
{
	set_name("练兆诚", ({ "lian chaocheng", "lian", "chaocheng" }));
	set("long", "似乎七十馀岁，正值壮年，全身跳跃着活力\n"+
            "脸上笑容满面。\n");
	set("nickname",HIW"古今"+HIY "琦灵" NOR);
	set("gender", "男性");
	set("age", 73);
        set("attitude", "peaceful");
	set("str", 50);
	set("dex", 72);
	set("con", 47);
	set("int", 65);

     set("combat_exp", 1600000);
        set_skill("force", 200);
        set_skill("sword", 200);
        set_skill("parry", 200);
        set_skill("dodge", 200);
        set_skill("literate", 200);
   set_skill("sheshen-zhang", 200);
  set_skill("rennai", 200);
   set_skill("flying-shu", 200);
  set_skill("unarmed", 200);
        set_skill("guang-jian",200);
        set_skill("wuzhu-xinfa",200);
        set_skill("shunjian-yidong",200);
        map_skill("sword", "guang-jian");      
        map_skill("force", "wuzhu-xinfa");      
        map_skill("dodge", "shunjian-yidong");   

       
    
	set("jiali",150);


	set("max_qi", 4000);
	set("max_jing", 1000);
	set("neili", 8000);
	set("max_neili", 8000);

	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
		(: perform_action, "guangmang" :),
            }) );
	setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
	
        create_family("圣殿", 1, "弟子");
      set("title",HIB"圣殿高阶武士"NOR);
}


void attempt_apprentice(object ob)
{
        if ((int)ob->query("combat_exp") < 300000) {
 command("say 你的战斗力太低，让我如何收你？你还是去练练功再回来拜我吧。");
 return;
}
    if ((int)ob->query_skill("wuzhu-xinfa",1) < 150 ) {
        command("say 你的本门心法太低了,还是努努力先提高一下吧!");
		return;
    }
    command("say 好吧，今后你要群奋练功，光大圣殿。");
    command("recruit " + ob->query("id"));
}
