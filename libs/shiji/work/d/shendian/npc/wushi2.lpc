inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>; 
void setup()
{}
void init()
{
        add_action("do_guozao", "guozao");
        add_action("do_taojiao", "taojiao");
}
void create()
{
        set_name(HIY"训练武士"NOR, ({ "wu shi","shi", }));
        set_weight(1000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("material", "stone");
                set("no_get", "你想帮动个武士，确发现根本办不到，$N觉得自己真笨。\n");
                set("long",
        "这是一个训练用的武士，你似乎可以(da)(jia)。\n", );
        }
}

int do_guozhao(string arg)
{
        object me = this_player();
        object where = environment(me);
        object ob;
        mapping skill;
        int pxlevel; 

        if (!(arg=="wu shi" || arg == "shi"))
        return 0;
        if (me->is_busy()) {
                write("你现在正忙着呢。\n");
                return 1;
        }
        if( me->is_fighting() ) {
                write("你无法在战斗中专心下来过招！\n");
                return 1;
        }
        if ((string)me->query("family/family_name") != "圣殿")
             {
             write("你不是圣殿武士不能用！\n");
                return 1;
 }        if (!id(arg)) { 
                write("你要根谁过招？\n");
                return 1;
        }
        message("vision", me->name() + "$N虚心向训练武士过了几招，觉得自己似乎对拳脚技能有了一些了解。\n", environment(me), me);
        if( (int)me->query("qi") < 5 ) {
                write("你现在过于疲倦，无法专心下来跟武士过招。\n");
                return 1;
        }
        pxlevel = me->query_skill("unarmed", 1);
        if( (int)me->query("combat_exp") < (int)pxlevel*pxlevel*pxlevel/10 ) {
                command("laugh");               
                write("你的实战经验不足，武士再怎么训练你，你也不会懂呀。\n");
                return 1;
        }
        if( me->query_skill("unarmed", 1) > 99){
                write("似乎你的拳脚技能已经不低了也。\n");
                return 1;
        }
        me->receive_damage("qi", 5);
        me->improve_skill("unarmed", (int)me->query_skill("unarmed", 1)/2+15);
        write("$N跟训练武士过了几招，觉得自己对拳脚技能有了更进一步的了解。\n");
        return 1;
}
 int do_taojiao(string arg)
{
        object me = this_player();
        object where = environment(me);
        object ob;
        mapping skill;
        int pxlevel; 

        if (!(arg=="wu shi" || arg == "shi"))
        return 0;
        if (me->is_busy()) {
                write("你现在正忙着呢。\n");
                return 1;
        }
        if( me->is_fighting() ) {
                write("你无法在战斗中专心下来讨教！\n");
                return 1;
        }
        if ((string)me->query("family/family_name") != "圣殿")
             {
             write("你不是圣殿武士不能用！\n");
                return 1;
 }        if (!id(arg)) { 
                write("你要干什么？\n");
                return 1;        }
        message("vision", me->name() + "开始使用机器人。\n", environment(me), me);
        if( (int)me->query("qi") < 5 ) {
                write("你现在过于疲倦，无法专心下来打。\n");
                return 1;
        }
        pxlevel = me->query_skill("parry", 1);
        if( (int)me->query("combat_exp") < (int)pxlevel*pxlevel*pxlevel/10 ) {
                write("你的实战经验不足，不能用。\n");
                return 1;
        }
        if( me->query_skill("parry", 1) > 99){
                write("你不能用了。\n");
                return 1;
        }
        me->receive_damage("qi", 5);
        me->improve_skill("parry", (int)me->query_skill("parry", 1)/2+15);
        write("你开始使用机器人。\n");
        return 1;
}

