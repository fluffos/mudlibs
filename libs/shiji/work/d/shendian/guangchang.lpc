//最后修改小悟（ftwc)
#include <room.h>

inherit ROOM;

void create() {
  set("short", "圣岛广场");
  set("long", @LONG
这里是圣岛广场，因为十分宽大，所以使人看了有一种舒服的感觉，
广场四周都是乳白的建筑物，前方便是圣岛有名的承恩塔，据说里面
住着一群武功十分高强、辈份极高的长老，广场西边和东边是栽满了
四季树的绿荫道，东南通向圣岛招待宾客的笃庞楼及大殿，东北方向
且是圣岛武士的练功场所。
LONG);
  set("valid_startroom", 1);
  set("no_sleep_room", 1);
  set("exits", ([
    "south": __DIR__ "zhoulang",
    "north": __DIR__ "ta",
    "west": __DIR__ "luyindao1",
    "east": __DIR__ "luyindao",
    "southdown": __DIR__ "zhuka",
    "northwest": __DIR__ "lianwu",
    "southeast": __DIR__ "zhoulang1",
  ]));
  set("objects", ([
    "/d/shendian/npc/liuming": 1,
  ]));
  set("outdoors", "shendian");
  setup();
  "/clone/board/shendian_b"->foo();
}
