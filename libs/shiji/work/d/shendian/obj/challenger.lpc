int ask_me()
{
        object me,ob;
        me = this_object();
        ob = this_player();

        if(!query("killer_job"))
            return 0;
        if(ob->query("family/family_name") != "圣殿")
          {
           command("shake "+(string)ob->query("id"));
           command("say 你是什么人？我可没是时间跟你搅和。");
           return 1;
          }
        if(!ob->query_temp("mask/challenger"))
          {
           command("shake " + (string)ob->query("id"));
           command("say 我可不是来和你打的。");
           return 1;
          }
           command("say 好！今天就让我来领教领教圣殿的威力！\n");
           ob->fight_ob(me);
           me->fight_ob(ob);
           remove_call_out("checking");
           call_out("checking", 2, me,ob); 
           return 1;
}


int accept_fight()

{

        object ob = this_player();
        object me  = this_object();

       /* if ( !ob->query_temp("mask/fight_ok") ) return 0;

                    remove_call_out("check_fight");

        call_out("checking", 1, me, ob);

        ob->delete_temp("mask/fight_ok");

        return 1;
      */
      return 0;

}

int checking(object me, object ob)
{
  remove_call_out("checking");
  call_out("checking",2,me,ob);
  if(me->is_killing())
  {
    command("halt");
    command("say 想杀人灭口吗？？堂堂的圣殿竟然如此卑鄙，恕不奉陪了！");
    message_vision(HIG"说罢运用飞行术，一个纵身不见了。\n"NOR,this_player());
    destruct(me);
  }
  if((int)me->query("qi") < (int)me->query("max_qi")/10*6)
    {
      if(!living(me))
       {
       message_vision(me->name()+HIG"慢慢的苏醒过来……
\n",ob);
       command("say 圣殿果然是名不虚传！今天在下领教了！");
       command("say 在下告辞，他日再来讨教！");
       message_vision(HIG"说罢运用飞行术，一个纵身不见了。\n"NOR,this_player());
       ob->delete_temp("mask/fight_ok");
       ob->delete_temp("mask/challenger");
       ob->delete_temp("challenger_began");
       ob->set_temp("challenger_finished",1);
       destruct(me);
       }
      command("halt");
      command("say 圣殿果然是名不虚传！今天在下领教了！");
      command("say 在下告辞，他日再来讨教！");
      message_vision(HIG"说罢运用飞行术，一个纵身不见了。\n"NOR,ob);  
      ob->delete_temp("mask/fight_ok");
      ob->delete_temp("mask/challenger");   
      ob->delete_temp("challenger_began");
      ob->set_temp("challenger_finished",1);
      destruct(me);
    }
        if(ob->query("qi") < ob->query("max_qi")/100*55)
   {
   command("halt");
   command("haha "+(string)ob->query("id"));
   command("say 原来圣殿武功不过如此，所谓的神圣之岛也太言过其实了吧。");
   command("say 哼，既然如此那么在下告辞了！");
   message_vision(HIG"说罢$N运用飞行术，一个纵身不见了。\n"NOR,me);
   ob->delete_temp("mask/challenger");
   ob->delete_temp("challenger_began");
   destruct(me);
   }
    me->fight_ob(ob);
    return 1;
}

int ask_surrender()
{
  object me,ob;
  me=this_object();
  ob=this_player();
        if(!query("killer_job"))     return 0;
  ob->delete_temp("mask/challenger");
  ob->delete_temp("challenger_began");
  remove_call_out("destoryer");
  call_out("destoryer",0,me,ob);
  return 1;
}

int destoryer(object me,object ob)
{
  command("halt");
  command("haha "+(string)ob->query("id"));
  command("say 原来圣殿武功不过如此，所谓的神圣之岛也太言过其实了吧。");
  command("say 我看圣殿长老的根本不配列于地球之密，教出来的武士就更差了。");
  command("say 哼，那么在下告辞了！");
  message_vision(HIG"说罢$N运用飞行术，一个纵身不见了。\n"NOR,me);
  
 destruct(me);
}

  int do_follow(object ob)
  {
    remove_call_out("do_search");
    call_out("do_search",1,ob);
  }

  int do_search(object ob)
  {
        object *inv;
        int i;
        inv=all_inventory(environment(ob));

   if(environment(ob)->query("no_fight"))
           environment(ob)->set("no_fight",0);
        if(!present(ob,environment(this_object())))
        {
        for(i=0;i<sizeof(inv);i++)
        {
if((string)inv[i]->query("jobby")==(string)ob->query("id") && !present(inv[i],environment(this_object())))
        {
        this_object()->move(environment(ob));
         message_vision(HIG"$N快步追了过来。\n"NOR,this_object());
         message_vision(HIR"$N狞笑道：想跑？没那么容易，受死吧！\n"NOR,this_object());
        this_object()->kill_ob(inv[i]);
        inv[i]->kill_ob(this_object());
        }
        }
        this_object()->do_follow(ob);
        return 1;
        }
        if(this_object()->query("qi") < this_object()->query("max_qi")/10*6)
        {
        command("halt");
         command("say 没想道圣殿这么难对付，今天不玩了！");
         command("say 下次你就没这么好运了！");
        message_vision(HIG"说罢运用飞行术，一个纵身不见了。\n"NOR,ob);
        ob->add_temp("teach_upskills",1);
        destruct(this_object());
        }
        if(!this_object()->is_fighting())
        {
        command("haha");
        command("say 真过瘾！圣殿武功不过而已！我没兴趣再玩了。");
         message_vision(HIG"说罢$N运用飞行术，一个纵身不见了。\n"NOR,this_object());
        destruct(this_object()); 
        }
        this_object()->do_follow(ob);
        return 1;
  }