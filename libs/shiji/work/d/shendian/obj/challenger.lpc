//challenger.c 挑战者
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_me();
int ask_surrender();
void do_heal();

void create()
{
       string *menpai=({"皇族","特种","凤凰","外星","黑暗","外道",});
       object me, ob;
       int skills,ages;
       skills=this_player()->query_skill("force",1);
       ages=this_player()->query("age");
       if(ages < 20)       ages = 20;
       me = this_object();
       set("gender", "男性");
       set("attitude", "peaceful");
       set("age", ages);
       set("shen_type", 1);
        set("killer_job",1);

       set("str", 21+random(10));
       set("dex", 21+random(10));
       set("int", 21+random(10));
       set("con", 21+random(10));

       set("max_qi",this_player()->query("max_qi")/10*(8+random(8))*3);
       set("max_jing",this_player()->query("max_qi")/10*(8+random(8)));
       set("max_neili",this_player()->query("max_neili")
                      /10*(8+random(5)));
       set("jiaji", random(51));
       set("combat_exp",this_player()->query("combat_exp")
                      /10*(8+random(5)));

       set_skill("force",skills-(random(skills/2)));
       set_skill("dodge",  skills-(random(skills/2)));
       set_skill("parry", skills-(random(skills/2)));
       set_skill("literate",skills-(random(skills/2)));

       set("chat_chance_combat",20);
       set("chat_msg_combat", ({
              (: do_heal :),
        }) );
        set("inquiry", ([  "讨教": (:ask_me:),
                           "认输": (:ask_surrender:),
                                        ]) ); 
        switch(menpai[random(sizeof(menpai))])
        {
        //start case 1(fm)
        case "皇族" :
        set_name("皇族弟子", ({"dizi"}));
        set("title",HIG"皇家一脉"NOR);
 
        set_skill("sword", skills-(random(skills/2)));
        set_skill("cuff", skills-(random(skills/2)));
        set_skill("blade", skills-(random(skills/2)));
        set_skill("chiyan-quan", skills-(random(skills/2)));
        set_skill("baqi-jue", skills-(random(skills/2)));
        set_skill("weizhen-steps", skills-(random(skills/2)));
        set_skill("unarmed", skills-(random(skills/2)));

        map_skill("force", "baqi-jue");
        map_skill("dodge", "weizhen-steps");
        map_skill("unarmed", "chiyan-quan");

       
        setup();
        switch(random(3)) 
        {
        case 0: carry_object("/clone/weapon/changjian")->wield();
                break;
        case 1: carry_object("/clone/weapon/gangdao")->wield();
            break;
        }
        break;     

      //start case 2(hh)
      case "特种":
        set_name("特种部队弟子", ({"dizi"}));
        set("title",HIG"行尸走兽"NOR);
        
        set_skill("cuff", skills-(random(skills/2)));
        set_skill("sword", skills-(random(skills/2)));
        set_skill("unarmed", skills-(random(skills/2)));
        set_skill("blade", skills-(random(skills/2)));
        set_skill("duanqing-xinfa", skills-(random(skills/2)));
        set_skill("yinyang-zhang", skills-(random(skills/2)));
        set_skill("jiqi-qudong", skills-(random(skills/2)));
        map_skill("force", "duanqing-xinfa");
        map_skill("unarmed", "yinyang-zhang");
        map_skill("dodge", "jiqi-qudong");


       
        setup();
        switch(random(3))
        {
        case 0: carry_object("/clone/weapon/changjian")->wield();
                break;
        default: break;
        }
        break;


       //start case 3(xh)
       case "凤凰":
        set_name("凤凰弟子", ({"dizi"}));
        set("title",HIR"万水千山"NOR);

        set_skill("sword", skills-(random(skills/2)));
        set_skill("unarmed", skills-(random(skills/2)));
        set_skill("whip", skills-(random(skills/2)));
        set_skill("yinyang-zhang", skills-(random(skills/2)));
        set_skill("wuzu-xinfa", skills-(random(skills/2)));
        set_skill("fenghuang=shenfa", skills-(random(skills/2)));

        map_skill("unarmed","yinyang-zhang");
        map_skill("dodge", "fenghuang-shenfa");
        map_skill("force", "wuzu-xinfa");

       
        setup();
        switch(random(4))
        {
        case 0: carry_object("/clone/weapon/changbian")->wield();
                break;
        case 1: carry_object("/clone/weapon/changjian")->wield();
                break;
        case 2: carry_object("/clone/weapon/gangdao")->wield();
                break;
        default: break;
        }
        break;

       //start case 4(fy)
       case "外星":
        set_name("外星杀手", ({"dizi"}));
        set("title",HIG"天外来客"NOR);

        set_skill("sword", skills-(random(skills/2)));
        set_skill("cuff", skills-(random(skills/2)));

       
        setup();
        switch(random(3))
        {
        case 0: carry_object("/clone/weapon/changjian")->wield();
                break;
        case 1: carry_object("/clone/weapon/gangdao")->wield();
                break;
        default: break;
        }
        break;

       //start case 5(sl)
        case "黑暗":
        set_name("黑暗使者", ({"dizi"}));
        set("title",HIY"万恶为首"NOR);
   
        set_skill("cuff", skills-(random(skills/2)));
        set_skill("strike", skills-(random(skills/2)));
        set_skill("club", skills-(random(skills/2)));
        set_skill("sword", skills-(random(skills/2)));
        set_skill("blade", skills-(random(skills/2)));
        set_skill("sword", skills-(random(skills/2)));
        set_skill("staff", skills-(random(skills/2)));

       
        setup();
        switch(random(4))
        {
        case 0: carry_object("/clone/weapon/changjian")->wield();
                break;
        case 1: carry_object("/clone/weapon/gangdao")->wield();
                break;
        default: break;
        }
        break;

       //start case 6(ql)
        case "外道":
        set_name("刺客", ({"dizi"}));
        set("title",HIR"有钱老说话"NOR);

        set_skill("strike", skills-(random(skills/2)));



        setup();
        switch(random(2))
        {
        case 0: carry_object("/clone/weapon/changjian")->wield();
                break;
        default: break;
        }        
        break;
    }  
    carry_object("/clone/cloth/cloth")->wear();
}  


void do_heal()
{
   command("exert recover");
   command("exert regenerate");
}
