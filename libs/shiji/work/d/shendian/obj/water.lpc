inherit ITEM;
inherit F_LIQUID;
#include <ansi.h>
void create() {
  set_name(HIG "纯水" NOR, ({ "water" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一瓶清澈的纯净水。\n");
    set("unit", "瓶");
    set("max_liquid", 4);
  }
  set("liquid", ([
    "type": "water",
    "name": "纯水",
    "remaining": 50,
    "drunk_supply": 75,
  ]));
}
