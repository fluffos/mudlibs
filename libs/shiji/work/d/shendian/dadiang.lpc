#include <room.h>

inherit ROOM;

void create() {
  set("short", "大殿");
  set("long", @LONG
这是圣岛高层次人员的集会场所，一般的人是休想进入这里的，
这里建筑搞得辉煌无比，顶上的吊灯发出柔和的光芒，一个大约
100寸的墙壁影像接收器，分外引人注目，几位年轻漂亮的小姐
穿梭在大殿之中，满脸笑意，看来似乎圣岛又有什么大的喜事。
LONG);
  set("no_fight", "1");

  set("exits", ([
    "south": __DIR__ "zhoulang1",
    "north": __DIR__ "shoulao",

  ]));
  set("objects", ([
    "/d/shendian/npc/lianchao": 1,
  ]));
  set("outdoors", "shendian");
  setup();
}
