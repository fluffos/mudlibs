inherit ROOM;

void serve_tea(object who);

void create()
{
  set("short","用膳厅");
  set("long",
      "这虽然说来是一间用饭的地方，但是你却看不到灶以及锅之类的东西，\n原来呀在这个年代"
  
  "吃饭已经不用再单只用煮了，聪明的人类已经知道如何\n合成一份可口的食物。如果你也要想来一份尝尝，你就开口说吧(speak)吧。
\n"
     );
  set("exits",([
      "north" : __DIR__"lianwu",
     ]));
  set("no_fight",1);
 setup();
}

void init()
{
 add_action("do_speak","speak");
}
int do_speak()
{

        object me = this_player();      
                                
        
    if( me->query_temp("marks/served") )
    {
        message_vision("林雅丽$N说道：对不起，今天我用些累了，"+
                                "要吃得你等会再来吧！\n", me);
        return 1;
    }

        message_vision("$N轻轻的舒了一口气，说到：“雅丽请给我准备一份食物好吗？\n", me);
        
    serve_tea(me);

    me->set_temp("marks/served", 1);
    remove_call_out("delete_served");
    call_out("delete_served", 7, me);
    return 1;
}

void serve_tea(object who)
{
        object obt, obc, obn;
        object room;

//      if( !who || environment(who) != environment() ) return;

//      if( !objectp(room = environment()) ) return;

                   obn = new(__DIR__"obj/rou",1);
                obn->move(who);
                message_vision("雅丽对你微微一笑，只见她使用一些白色基因粉，速度合成一份可口的食物。\n",
                        who);

        obn = new(__DIR__"obj/water",1);
        obn->move(who);
        message_vision("雅丽又从身后的一台机器里拿出一杯纯水，连同香肉一起放在你的面前。\n", who);
        
//      return;
}

void delete_served(object me)
{
        if ( objectp(me) ) me->delete_temp("marks/served");
}

int valid_leave(object me, string dir)
{

        if (  (dir == "north")
           && ( present("rou", this_player())
                || present("water", this_player()) ) )
        switch ( random(2) ) 
        {
        case 0: 
         return notify_fail
                ("对不起，为了保持圣殿的环境卫生，请把剩下的食物，留在这里！\n");
         break;
        case 1:
         message_vision("雅丽对你说：“圣岛乃神圣之地，为了保持清洁，食物不得带出此屋。", me);
         return notify_fail("\n");
         break;
        }
        me->delete_temp("marks/served");
        return ::valid_leave(me, dir);
}
