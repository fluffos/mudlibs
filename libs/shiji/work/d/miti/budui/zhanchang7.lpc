inherit ROOM;
void create()
{
        set("short", "战场");
        set("long", @LONG 
这里就是特种部队和凤凰星交战的地方。只见周围尸首
遍野，都被血光笼罩着，而且还不时传来合成大炮、激
光枪的爆炸声。
LONG);
       set("objects",([
           "/d/miti/budui/npc/zhanshi": 2,
          ])); 
       set("exits", ([
     "east"  : __DIR__"zhanchang8",
    "west" : __DIR__"zhanchang6",
        ]));
      setup();
}

int valid_leave(object me, string dir)
{ object obj,ob;
  obj=this_object();
  ob=present("zhan shi",obj);
  if (ob)
    return notify_fail("周围还有敌人，你现在还不能离开！\n");
  return ::valid_leave(me, dir);
}
