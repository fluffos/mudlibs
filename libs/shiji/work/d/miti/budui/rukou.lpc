inherit ROOM;
void create()
{
        set("short", "地道入口");
        set("long", @LONG 
这里就是特种部队和凤凰星交战的地方，边上有个大洞
(dong)，黑漆漆的什么都看不见。只见周围尸首遍野，都被血
光笼罩着，而且还不时传来合成大炮、激光枪的爆炸声。
LONG);
       set("exits", ([
 "west"  : __DIR__"zhanchang9",
        ]));
      setup();
}
int init()
{ add_action("do_jin","jin");
  add_action("do_guancha","guancha");
 }

int do_jin(string arg)
{
object me,ob;
  me=this_player();
  ob=present("fenghuang map",me);
  if (!arg || arg!="dong") return notify_fail("你要进哪里去？\n");
if (!ob) return notify_fail("你没地图，进去恐怕出不来了吧？\n");
tell_object(me,"你翻了翻凤凰星地图，慢慢的爬了进去。\n");
  me->move("/d/miti/budui/didao1");
destruct(ob);
return 1;
}

int do_guancha()
{
object me;
  me=this_player();
 tell_object(me,"你对着地道注视了很久，也看不出个所以然来，还是回去问下吧。\n");
  me->set_temp("guancha",1);
return 1;
}
