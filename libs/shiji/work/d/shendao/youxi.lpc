inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "街机房");
  set("long", @LONG
这是供小朋友们娱乐的场所，但中间也有一些大人爱好此类玩意.
里面放着好多新奇的东西，有一排机器围着好多人，原来那里
放着的是现今最流行的一款游戏，叫做“十二生肖”。你不禁
也想上去操练一下。可是只见人头窜动，不见有空的机器，失
望之际，你只好先挤进去（ji jinqu）再做打算。
LONG);
  set("no_fight", 1);
  set("exits", ([
    "east": __DIR__ "zhouyanjie3",
  ]));

  set("no_clean_up", 0);
  set("no_fight", 0);
  set("no_steal", 0);
  set("no_sleep", 0);
  set("no_beg", 0);
  setup();
}
void init() {
  add_action("do_ji", "ji");
  add_action("do_play", "play");
}
int do_ji(string arg) {
  object me;
  me = this_player();
  if (!arg || !arg = "jinqu")
    return notify_fail("你挤什么？\n");
  message_vision("$N终于挤进了人群，四下打量，发现有一台居然空着。\n
   这下你可以开始玩了。(play) \n", me);
  me->set_temp("ji", 1);
  return 1;
}
int do_play() {
  object me, ob;
  mapping fam;
  int n;
  me = this_player();

  if (!me->query_temp("ji", 1))
    return notify_fail("你还没有抢到一台游戏机啊，怎么玩？\n");

  if ((int)me->query("jing") < 20)
    return notify_fail("你已经玩得头晕眼花，还是休息一下去吧。\n");

  if (me->is_busy())
    return notify_fail("再休息一会吧，你都站不住了。\n");

  if (me->query_temp("pilao") >= 1) {
    me->delete_temp("play");
    n = 0;

    if (random(10) >= 8) {
      message_vision(HIC "只见大家振奋精神细心观战，$N忙的不亦乐乎，身体不住的摇晃，杀杀杀 的叫声相继传来。\n" NOR, me);
      tell_object(me, HIY "$N似乎十分得意,把头一扬：“这个游戏，小意思”！\n" NOR);
      message_vision(HIC "$N挤出人群，似乎要去找一台更好玩的机器!\n" NOR, me);
      me->delete_temp("ji");
      me->add("money", 100);
    } else {
      me->add("money", 80);
      me->delete_temp("play");
      tell_object(me, HIB "你虽然没有能够打通关底，但是也似有所悟。再继续战斗吧！(play)\n" NOR);
    }
  }


  message_vision(HIC "$N掳起袖子，投了一枚硬币。当啷啷...开始了!!!!\n" NOR, me);
  n = me->query_temp("pilao") + 1;
  me->set_temp("pilao", n);
  me->receive_damage("jing", 10);
  me->start_busy(2);
  return 1;
}
int valid_leave(object me, string dir) {
  if (dir == "north")
    me->delete_temp("ji");
  me->delete_temp("play");
  return ::valid_leave(me, dir);
}
