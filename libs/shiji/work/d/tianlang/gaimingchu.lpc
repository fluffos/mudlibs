// Room: /d/wudang/chg-name.c

inherit ROOM;

void create()
{
        set("short", "改名俱乐部");
        set("long", @LONG
这里就是世纪(CENTURY)的改名俱乐部，金书记便是专门负责改名的九品
官，据说敲诈民财颇多。柜台上有一本改名帐薄(book)，里面记载着每
一次玩家的改名记录。
LONG
        );
        set("item_desc", ([
    "book" : "这是一本写满绳头小字的帐薄，输入check可以查询记录。也可以输入check2来查询报名记录。\n"
     ]));  
        set("exits", ([ /* sizeof() == 1 */
       "west" : __DIR__"street3",
        ]));
        set("objects", ([ /* sizeof() == 1 */
       __DIR__"npc/jin-shuji" : 1,
]));
        set("no_clean_up", 0);

        setup();
}
void init()
{
  add_action("do_check","check");
}
int do_check(string arg)
{
        object me = this_player();
        string msg;

        message_vision("$N翻开了柜台上的帐薄。\n", me);
        msg = "只见帐薄上密密麻麻地记录着：\n";

        msg += read_file("/log/CHANGENAME");
        if( sizeof(msg) < 20 )  msg = "目前帐本上没有记录。\n";

        me->start_more(msg);
        return 1;
}

