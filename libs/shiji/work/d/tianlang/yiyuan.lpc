inherit ROOM;

#include <ansi.h>
void create()
{
               set("short", HIW"天狼医院"NOR);
            set("long",@LONG
这里就是天狼医院了，天狼队员可以在这免费医疗
其它门派是进不来的，这里的环境看起来相当的好，给人一种
清净的感觉。天狼队的队员在这医疗请用(yiliao)指令。
LONG);
              set("exits",([
                    "north" : __DIR__"street1",
                         ]));
     setup();
}
void init()
{
     add_action("do_yiliao","yiliao");
}
int do_yiliao()
{
   object me;
  int max;
 me = this_player();
 if (me->query("money") < 10)
  return notify_fail("你的钱不够!\n");
 max = me->query("max_qi");
 max = me->query("max_qi");
me ->set("eff_qi",max);
max = me->query("max_jing");
me ->set("eff_jing",max);
 me->start_busy(3);
me->add("money", -10);
 message_vision("$N做在医疗室里，享受着医疗的舒适。\n",me);
 return 1;
}


