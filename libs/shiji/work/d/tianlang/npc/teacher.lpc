// teacher.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("朱熹", ({ "zhu xi", "zhu", "waiter" }));
  set("title", "教书先生");
  set("gender", "男性");
  set("age", 47);
  set("int", 26);
  set("long",
    "朱熹是大大有名的学者。\n");
  set("inquiry", ([
    "学费": "嗯....知识是无价的，不过如果你有心的话——只要五两银子。\n",
    "读书识字": "对，读书识字。",
  ]));
  set("attitude", "peaceful");
  set_skill("literate", 100);
  set("SEN", 10);

  setup();
}

int recognize_apprentice(object ob) {
  if (ob->query("money") < 30)
    return notify_fail("你的钱不够吧？\n");

  ob->add("money", -30);
  return 1;
}
