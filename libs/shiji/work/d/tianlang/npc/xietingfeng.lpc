#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create() {
  set_name("谢庭峰", ({ "Xie tingfeng", "xie", "tingfeng" }));
  set("long", "他是香港的歌手。\n");
  set("gender", "男性");
  set("age", 19);
  set("attitude", "friendly");
  set("shen_type", -1);

  set("per", 15);
  set("str", 15);
  set("int", 14);
  set("con", 15);
  set("dex", 16);
  set("qi", 200);
  set("max_qi", 200);
  set("jing", 200);
  set("max_jing", 100);
  set("neili", 300);
  set("max_neili", 300);
  set("combat_exp", 20000);

  set_skill("unarmed", 90);
  set_skill("dodge", 90);
  set_skill("parry", 90);

  set("chat_chance", 5);
  set("chat_msg", ({
    "
谢庭峰唱到:因为爱(王非),所以爱(王非)\n
" }));

  setup();
  carry_object("/d/tianlang/obj/cloth")->wear();
}
