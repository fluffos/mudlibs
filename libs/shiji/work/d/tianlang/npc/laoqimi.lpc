//棋迷王
#include <ansi.h>
inherit NPC;
void create() {
  set_name("老棋迷", ({ "qimi" }));
  set("long",
    "他是一个嗜棋如命地老棋迷，年纪也不小了，但还是喜欢在棋室里呆着，\n专等着人和他下棋。\n");
  set("gender", "男性");
  set("str", 27);
  set("cor", 27);
  set("cps", 27);
  set("age", 92);
  set("combat_exp", 1000);
  setup();
}
void init() {
  ::init();
  add_action("do_xiaqi", "xiaqi");
}
int do_xiaqi(string arg) {
  int exp, pot;
  object me;
  me = this_player();
  exp = 1 + random(8);
  pot = 1 + random(6);
  if (me->query("combat_exp") > 100000)
    return notify_fail("你的EXP太多了\n");
  if (me->is_busy()) return notify_fail("老棋迷对你说道：“你这局还没下完哪！”\n");
  message_vision("$N冥思苦想，怪招奇出，终于赢了老棋迷，$N说道：“承让了！”\n", me);
  me->add("gin", -20 + random(16));
  me->add("sen", -10 + random(7));
  me->add("combat_exp", exp);
  me->add("potential", pot);
  message_vision("老棋迷对$N说道：“你赢了，这是奖励你的。\n" HIC "$N得到了:\n" +
    chinese_number(exp) + "点实战经验和" + chinese_number(pot) + "点潜能\n" NOR, me);
  me->start_busy(5);
  return 1;
}
