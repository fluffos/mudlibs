#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create()
{
        set_name("王非", ({ "wangfei", "wang", "fei" }));
        set("long", "她是香港的歌手。\n");
         set("gender", "女性");
        set("age", 30);
        set("attitude", "friendly");
        set("shen_type", -1);

        set("per", 15);
        set("str", 15);
        set("int", 14);
        set("con", 15);
        set("dex", 16);
        set("qi", 200);
        set("max_qi", 200);
        set("jing", 200);
        set("max_jing", 100);
        set("neili", 300);
        set("max_neili", 300);
        set("combat_exp", 20000);

        set_skill("unarmed", 90);
        set_skill("dodge", 90);
        set_skill("parry", 90);

         set("chat_chance", 5);
        set("chat_msg", ({
"明月几时有，把酒问青天。\n
不知天上宫阙，今夕是何年?\n
我欲乘风归去，又恐琼于宇。\n
高处不胜寒。\n
\n\n转朱阁，低琦户，照无眠，你应有恨。\n
何事长向别时圆，此事古难全。\n
但愿人长久，千里共婵娟。\n",
      }) );

        setup();
       carry_object("/d/tianlang/obj/cloth")->wear();
}

