// girl.c

#include <ansi.h>

inherit NPC;

string *name = ({ "红", "碧", "青", "玉", "兰" });
string *id = ({ "hong", "bi", "qing", "yu", "nan" });

void create() {
  int i;

  i = random(sizeof(name));

  set_name("小" + name[i], ({ "xiao " + id[i], id[i] }));
  set("title", "青楼女子");
  set("age", 24);
  set("gender", "女性");
  set("long", "她是丽春院的姑娘，长得颇有几分姿色。\n");

  set("attitude", "friendly");
  set("str", 20);
  set("per", 15 + random(10));
  set("dex", 20);
  set("combat_exp", 500 + random(500));
  set("SEN", 1);

  set_skill("unarmed", 50);
  set_skill("sword", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);

  setup();
}

void init() {
  add_action("do_sleep", "sleep");
}

int accept_fight(object ob) {
  if (ob->query("gender") != "男性")
    return notify_fail("我只和男人打架，对你嘛......可没什么兴趣。\n");

  return notify_fail(name() + "嘻嘻笑道：这位" + RANK_D->query_respect(ob)
    + "，这里哪里是我们打架的地方呢。\n");
}

int do_sleep(string arg) {
  object who = this_player(), me = this_object();

  if (!arg || !id(arg)) return 0;

  if (who->query("gender") != "男性") {
    say(name() + "说道：我可没有这个嗜好，你还是找别人去吧。\n");
    return 1;
  }

  if (who->query("age") < 18) {
    say(name() + "一脸讥笑：就你这身板儿也想泡老娘？\n");
    return 1;
  }

  if (base_name(environment()) != query("startroom")) {
    tell_object(who, name() + "对你说道：你还是到丽春院来找我吧。\n");
    return 1;
  }


  say(name() + "似笑非笑的打量了你一眼，轻笑道：跟我来吧。\n");
  tell_object(who, HIY "你抱起" + name() + "滚到了床上，放下了纱帐......\n" NOR);
  who->set_temp("sleep_once", 1);

  who->add("atman", random(who->query("age") - 14));
  if (who->query("atman") > 2 * who->query("max_atman")) {
    who->add("max_atman", 1);
    who->set("atman", who->query("max_atman"));
  }
  who->sleep();

  return 1;
}
