// jin-shuji.c 改名npc金书记 (By xings,1998.09.20)
// 限制玩家改名次数为三次
// 存档文件于/log/ChangeName
#include <dbase.h>
#include <ansi.h>
inherit F_VENDOR;
inherit NPC;

void create() {
  set_name("金书记", ({ "jin shuji", "jin", "shuji" }));
  set("title", "户部九品文官");
  set("nickname", YEL "全靠一支笔" NOR);
  set("gender", "男性");
  set("str", 25);
  set("age", 35);
  set("long",
    "这个金书记是户部里最小的一名官员，掌管玩家的户口。\n");
  set("combat_exp", 15000);
  set("attitude", "friendly");
  set("inquiry", ([
    "改名": "要改名先得交钱。",
    "金书记": "怎么你也会知道我的大名？",
    "here": "这里是金庸群侠改名俱乐部。",
  ]));

  setup();
  carry_object("/d/tianlang/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

  add_action("do_name", "改");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment())
    return;
  switch (random(2)) {
    case 0:
      say("金书记笑眯眯地说道：这位" + RANK_D->query_respect(ob) +
        "，快请进来歇口气吧。\n");
      break;
    case 1:
      say("金书记说道：哟！这位" + RANK_D->query_respect(ob) +
        "您来了啊！您要改名吗？\n");
      break;
  }
}


int do_name(string target) {
  object me;
  //add by yokel，1999.9.9
  int i;
  //end add
  string old_name;
  me = this_player();
  old_name = me->query("name");

  if (me->query("change_name") >= 10)
    return notify_fail("金书记哼了一声，说道：你还有完没有完，改那么多次名干嘛！\n");

  if (me->query("money") < 10000)
    return notify_fail("你的钱不够啊.\n");

  if (!target || target == " ")
    return notify_fail("金书记迷惑不解地说道：快告诉我您新的名字呀！\n");

  if (old_name == target)
    return notify_fail("金书记奇怪地对你说到：您的钱是不是来得太容易了！\n");
  //add by yokel，1999.9.9
  i = strlen(target);
  if (i < 2 || i > 12) {
    return notify_fail("金书记不耐烦地对你说到：中文名字必须是一到六个中文字！\n");
  }
  while (i--) {
    if (target[i] <= ' ') {
      return notify_fail("金书记大喝一声：你小子是不是存心来捣乱的？\n");
    }
    if (i % 2 == 0 && !is_chinese(target[i..<0])) {
      return notify_fail("金书记用眼角扫了你一下：用这样的名字，你找死呀！\n");
    }
  }
  //end add
  command("chat " + old_name + "从现在开始改名为：" + target + "。大家以后别认错了人！\n");
  me->add("money", -10000);
  log_file("CHANGENAME", me->query("name") + "(" + me->query("id") + ")于 " +
    ctime(time()) + " 改名为：" + target + "。\n");
  me->delete_temp("fee_paid");
  me->set("name", target);
  me->add("change_name", 1);
  return 1;
}
