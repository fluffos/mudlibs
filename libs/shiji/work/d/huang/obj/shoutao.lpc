 
#include <ansi.h>

#include <weapon.h>

inherit "/inherit/weapon/unarmed";

void create()
{
        set_name(MAG"合金手套"NOR, ({ "shoutao" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("long", "这是一双昂贵的合金手套，打造的相当坚实。\n");
set("value",1000);
                set("material", "iron");
                set("wield_msg", "$N拿出一双$n，慢吞吞的戴在了手上。\n");
                set("unwield_msg", "$N脱掉手上的$n。\n");
init_unarmed(40);
        }

        setup();
}

