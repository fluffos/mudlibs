#include <armor.h>
inherit CLOTH;

void create()
{
        set_name("彩裙", ({ "pink skirt", "skirt" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
     set("long", "一条美丽的彩裙，上面绣了几道水波．\n");
                set("unit", "件");
                set("value", 300);
                set("material", "cloth");
                set("armor_prop/armor", 5);
                set("armor_prop/dodge", 10);
        }
        setup();
}
