
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(MAG "真龍剑" NOR, ({"zhenlong","jian"}));
        set_weight(3000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "这是龙族历代狂龙战士的配剑，剑身如镜，光泽夺目。\n");
                set("value", 50000);
                set("material", "steel");
                set("no_drop", "这样东西不能离开你。\n");
                set("no_give", "这样东西不能给人。\n");
                set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中，只觉一股杀气扑面而来。\n");
                set("unwield_msg", "$N将手中的$n插回剑鞘，只听嗤的一声轻响。\n");
        }
      init_sword(100);
        setup();
}

