#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name(HIB "兽甲" NOR, ({ "shou jia", "jia" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
      set("value", 5000);
                set("material", "gold");
          set("armor_prop/armor", 20);
        }
        setup();
}


