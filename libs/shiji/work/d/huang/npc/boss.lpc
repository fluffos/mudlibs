inherit F_DEALER;
inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIY "暗黑之龙" NOR, ({ "anhei zhilong", "dragon" }));
  set("title", HIB "黑钱老大" NOR);
  set("shen_type", 0);

  set("gender", "无性");
  set_max_encumbrance(100000000);
  set("age", 200);
  set("long", HIB
    "它是皇族的管理钱物的黑龙。\n"
    "它长的黑不溜秋，就象一块黑铁，没什么好看的！\n"
    NOR);
  set("no_get_from", 1);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_temp("apply/attack", 30);
  set_temp("apply/attack", 30);
  set_temp("apply/damage", 15);

  set("combat_exp", 2000000);
  set("attitude", "friendly");



  setup();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
  add_action("do_sell", "sell");
}

void die() {
  message_vision("\n$N死了。\n", this_object());
  destruct(this_object());
}
