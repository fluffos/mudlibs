
#include <ansi.h>
inherit F_MASTER;
void consider();
inherit NPC;

void create()
{
        seteuid(getuid());

        set_name("楼笑风", ({ "lou xiaofeng", "lou", "xiaofeng" }) );
        set("gender", "男性" );
        set("age", 30);
        set("title",  HIB "皇族副统领" NOR);
        set("long", "他就是皇族管理外事的楼笑风。\n");
        set("attitude", "heroism");
        set("generation",0);
        set("winner","none");

        set("str", 25);
        set("con", 25);
        set("int", 25);
        set("dex", 25);

        set("max_qi", 400);
        set("eff_qi", 400);
        set("qi", 400);
        set("max_jing", 200);
        set("jing", 200);
        set("neili", 300);
        set("max_neili", 300);
        set("jiali", 30);
        set("shen_type", 0);

        set("no_clean_up",1);
        set("combat_exp", 50000);

        set_skill("force", 100);        
            set_skill("literate", 180); 
        set_skill("parry", 120); 
        set_skill("baqi-jue", 80); 
        set_skill("dodge", 120); 
        set_skill("weizhen-steps", 80); 
        set_skill("chiyan-quan", 80); 
        set_skill("cuff", 120);
        set_skill("sword", 120);
        set_skill("dingbang-jian", 80);

      
       map_skill("force"  , "baqi-jue");
    map_skill("cuff"  , "chiyan-quan");
    map_skill("dodge"  , "weizhen-steps");
    map_skill("parry"  , "chiyan-quan");

        set("fight_times", 0);  

        setup();
       carry_object("/d/huang/obj/shoutao")->wield();   
       carry_object("/d/huang/obj/shoujia")->wear();

}

void attempt_apprentice(object ob)
{
    if (ob->query_int() < 20) {
        command("say 皇族不需要猪脑，您请回吧！");
                return;
    }
    command("say 很好，很好。");
    command("recruit " + ob->query("id"));
}

int accept_fight(object ob)
{
        object me  = this_object();
                
        me->set("eff_qi", me->query("max_qi"));
        me->set("qi",     me->query("max_qi"));
        me->set("jing",   me->query("max_jing"));
        me->set("neili",  me->query("max_neili"));

        if ( me->is_fighting()) return 0;

        if ( !present(ob, environment()) ) return 0;

        if ( me->query("fight_times") >= 10 )
                return notify_fail("楼笑风已经全身脱力，趴在地上大口地喘着粗气！\n");  

        me->add("fight_times", 1);

        remove_call_out("checking");
        call_out("checking", 1, me, ob);
        
        return 1;
}

int checking(object me, object ob)
{
        object obj;
        int my_max_qi, his_max_qi;

        if ( !present(ob, environment()) ) return 1; 

        my_max_qi  = me->query("max_qi");
        his_max_qi = ob->query("max_qi");

        if( me->is_fighting() ) 
        {
                if (( (int)me->query("qi")*100 / my_max_qi) <= 80 ) 
                {
                        say(GRN "\n楼笑风说道： 天广皇泽被天下，福济苍生， 他老人家算无遗策，功无不克，克无不胜！\n" NOR);
                        say(GRN "\n江百胜说道： 天广皇一句话，属下办事戳力，勇往直前！ 冰天雪地往里闯，刀山火海就敢去！\n" NOR);
                        message_vision(HIY "\n楼笑风说完，全身不知打哪里冒出来的一股力气，不但功力尽复，拳力也威猛好多倍！\n" NOR, ob);

                        me->set("eff_qi", me->query("max_qi"));
                        me->set("qi",     me->query("max_qi"));
                        me->set("jing",   me->query("max_jing"));
                        me->set("neili",  me->query("max_neili"));
                }
                else if (( (int)ob->query("qi")*100 / his_max_qi) < 50 ) 
                {
                        say(GRN "\n楼笑风说道： 看来你小子跟我还差着一大截呢，回去练上十年再来吧！\n");
                        return 1;
                }

                if ( present(ob, environment()) ) call_out("checking", 1, me, ob);
        }

        return 1;  
}
void die()
{
        object corpse, killer;
        int i;
        string skill;
        object ling;

        if( !living(this_object()) ) revive(1);
        if( wizardp(this_object()) && query("env/immortal") ) return;

        this_object()->clear_condition();

        COMBAT_D->announce(this_object(), "dead");
        if( objectp(killer = query_temp("last_damage_from")) ) {
                set_temp("my_killer", killer->query("id"));
                COMBAT_D->killer_reward(killer, this_object());
        }

        if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
                corpse->move(environment());

        if (userp(killer))
        {
             message_vision(HIC"$N楼笑风身上搜出一根教鞭。\n",killer);
             ling=new("/d/shendian/quest/obj/jiaodaobian");
             ling->move(killer);
        }

        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());

        this_object()->dismiss_team();
        destruct(this_object());
}


