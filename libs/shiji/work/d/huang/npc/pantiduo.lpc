// wuliao 5/15/96
#include <ansi.h>
inherit NPC;

void create() {
  set_name("潘提多", ({ "pan tiduo", "tiduo" }));
  set("gender", "龙族");
  set("title", HIR "狂龙战士" NOR);
  set("nickname", BLU "力挽狂澜" NOR);
  set("age", 42);
  set("long",
    "潘提多是龙族几千年才出一个的狂龙战士，但是他也"
    "改变不了龙族灭亡的悲惨命运。\n");
  set("str", 45);
  set("dex", 45);
  set("con", 45);
  set("int", 45);
  set("shen_type", 1);

  set_skill("unarmed", 200);
  set_skill("force", 200);
  set_skill("dodge", 200);

  set("combat_exp", 5000000);

  set("max_qi", 2000);
  set("max_jing", 2000);
  set("neili", 1500);
  set("max_neili", 1500);

  set("attitude", "friendly");
  set("inquiry", ([
    "name": "我就是狂龙战士。",
    "龙族": "我们龙族是最古老的种族，现在正面临灭亡的危机。",
    "赤炎龙将": "赤炎龙将真是很厉害，我的伤都是拜他所赐，拔山龙将只是徒具虚名罢了。",
    "天广皇": "我来刺杀这混蛋没有成功，反而身受重伤，暂时在这躲一下。",
  ]));

  setup();
  set("chat_chance", 6);
  set("chat_msg", ({
    "潘提多得意地说道：什么皇族君临天下？我进入他们领地来去自由，哈哈。\n",
    "潘提多怒骂道：可恶的天广皇，总有一天要你死在我的手上！\n",
    "潘提多对你说道：你一双眼睛贼忒嘻嘻的，看个什么！！\n",
  }));
  carry_object("/d/huang/obj/kunglong-jia")->wear();

  carry_object("/d/huang/obj/zhenlong-jian")->wield();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object me) {
  command("look " + me->query("id"));

  if (me->query("family") == "皇族") {
    command("say 皇族的混蛋，我见一个杀一个！");
    command("kill " + me->query("id"));
  }
  return;
}
