inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIY "电影院" NOR);
  set("long", @LONG
这里是一个非常大的电影厅，只见里面不时传来呐喊声和激烈的枪声，
好象是在放映枪战片。一块液晶显示屏(ping)挂在墙上。
LONG
  );
  set("no_fight", 1);

  set("exits", ([

    "west": __DIR__ "road2",
  ]));


  set("item_desc", ([ "ping": "急招守门人员，有意者请加入守门行列(shoumen)！\n",

  ]));
  setup();

}
void init() {
  add_action("do_work", "shoumen");
}
int do_work() {
  object me;
  int exp;
  me = this_player();

  if (me->query("combat_exp") > 10000) return notify_fail("您以后上这来都免票！\n");
  if (me->query("qi") < 20) return notify_fail("你的生命力不够，休息一下再来吧！\n");
  if (me->is_busy()) return notify_fail("你正忙着呢！\n");
  me->add("qi", -random(20));
  if (random((int)me->query("kar")) < 5) {
    message_vision("$N焦急的看着外面，但是没有一个人进来！\n", me);
    me->start_busy(random(10));

  }

  else {
    message_vision("$N只见一位老板走了进来，哇，又有钱赚啦！\n", me);
    me->add("money", random(20));
    me->add("combat_exp", random(20));
    me->add("potential", random(20));
    me->start_busy(random(10));
  }


  return 1;
}
