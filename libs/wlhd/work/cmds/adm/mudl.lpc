//who.c
#include <ansi.h>
#include <net/dns.h>
#include <mudlib.h>
#define ENGLISH_MUD_NAME INTERMUD_MUD_NAME
inherit F_CLEAN_UP;
void create();
mixed main(object me, string arg, int remote);
private string cuptime();
void create() { seteuid(getuid()); }
mixed main(object me, string arg, int remote) {
  string str, str1, *option;
  object *list;
  int i, j, ppl_cnt, wiz_cnt;
  int opt_long, opt_id, opt_wiz;
  int SendInterMud = 0;
  string HostName, strMsg;
  wiz_cnt = 0;
  ppl_cnt = 0;
  if (remote && sizeof(arg) < 2) arg = "";
  if (arg) {
    option = explode(arg, " ");
    i = sizeof(option);
    while (i--) {
      switch (option[i]) {
        case "-l": strMsg = "-l"; opt_long = 1; break;
        case "-i": strMsg = "-i"; opt_id = 1; break;
        case "-w": strMsg = "-w"; opt_wiz = 1; break;
        default:
          if (option[i][0] == '@') {
            if (!find_object(DNS_MASTER))
              return notify_fail("网路精灵并没有被载入，请先将网路精灵载入。\n");
            SendInterMud = 1;
            HostName = sprintf("%s", option[i][1..sizeof(option[i])]);
            break;
          }
          return notify_fail("指令格式：who [-l|-i|-w]\n");
      }
    }
    if (SendInterMud) {
      RWHO_Q->send_rwho_q(HostName, me, strMsg);
      write("网路讯息已送出，请稍候。\n");
      return 1;
    }
  }
  str = sprintf("◎ %s(%s)。\n", CHINESE_MUD_NAME, ENGLISH_MUD_NAME);
  str += "——————————————————————————————————\n";
  list = sort_array(children(USER_OB), "sort_user", this_object());
  if (opt_long || opt_wiz) {
    j = sizeof(list);
    while (j--) {
      // Skip those users in login limbo.

      if (!environment(list[j])) continue;
      if (me && !me->visible(list[j])) continue;
      if (!me && (int)list[j]->query("env/invisibility")) continue;
      if (opt_wiz && !wizardp(list[j])) continue;
      str = sprintf("%s%12s %s\n",
        str,
        RANK_D->query_rank(list[j]),
        list[j]->short(1)
      );
      ppl_cnt++;
      wiz_cnt++;
    }
  } else {
    ppl_cnt = 0;
    j = sizeof(list);
    if (remote) {
      while (j--) {
        // Skip those users in login limbo.
        if (!environment(list[j])) continue;
        if (me && !me->visible(list[j])) continue;
        if (!me && list[j]->query("env/invisibility")) continue;
        str1 = list[j]->name(1) + "(" + capitalize(list[j]->query("id")) + ")";
        str = sprintf("%s%-20s%s", str, str1, (ppl_cnt % 3 == 2 ? "\n" : "\t"));
        ppl_cnt++;
      }
      if (ppl_cnt % 3) str += "\n";
    } else {
      while (j--) {
        // Skip those users in login limbo.
        if (!environment(list[j])) continue;
        if (me && !me->visible(list[j])) continue;
        if (list[j]->query("gender") == "女性")
          str1 = HIR + list[j]->name(1) + NOR + "(" + HIY + capitalize(list[j]->query("id")) + NOR + ")";
        else
          str1 = list[j]->name(1) + "(" + HIY + capitalize(list[j]->query("id")) + NOR + ")";
        str1 += interactive(list[j]) ? (list[j]->query("doing") ? HIB "%" NOR : (query_idle(list[j]) > 120 ? HIG "*" NOR : "")) : (list[j]->query("doing") ? HIY "@" NOR : HIR "#" NOR);

        str = sprintf("%s%-25s%s",
          str,
          str1,
          (ppl_cnt % 3 == 2 ? "\n" : (strlen(list[j]->name(1) + list[j]->query("id")) > 13 ? "\t" : "\t\t"))
        );
        ppl_cnt++;
      }
      if (ppl_cnt % 3) str += "\n";
    }
  }
  str += "——————————————————————————————————\n";
  if (opt_wiz)
    str = sprintf("%s共有%s位巫师连线中，系统负担：%s\n", str, chinese_number(wiz_cnt),
      query_load_average() + "\n");
  else
    str = sprintf("%s共有%s位使用者连线中，系统负担：%s\n", str, chinese_number(ppl_cnt),
      query_load_average() + "\n");

  if (remote) return str;
  //if (sizeof(str)<8190)
  //    write(str);
  //else
  //me->start_more(str);
  me->start_more(str);
  return 1;
}
int sort_user(object ob1, object ob2) {
  if (wizardp(ob1) && !wizardp(ob2)) return -1;

  if (wizardp(ob2) && !wizardp(ob1)) return 1;

  if (wizardp(ob1) && wizardp(ob2))
    return (int)SECURITY_D->get_wiz_level(ob2) - (int)SECURITY_D->get_wiz_level(ob1);

  if (ob1->query("id") && !ob2->query("id"))
    return -1;
  if (ob2->query("id") && !ob1->query("id"))
    return 1;
  if (!ob1->query("id") && !ob2->query("id"))
    return (int)ob2->query("combat_exp") - (int)ob1->query("combat_exp");
  return strcmp(ob2->query("id"), ob1->query("id"));
}
int help(object me) {
  write(@HELP
指令格式 : who [@<MudName>] [-l|-i|-w]

这个指令可以列出所有在线上或连线中的 Mud 的玩家及其等级。
@<MudName> [-l|-i|-w] 例：who @The.Master.Of.Hero -w

-l 选项列出较长的讯息。
-i 只列出玩家的英文代号。
-w 只列出线上所有的巫师。

相关指令： finger
HELP
  );
  return 1;
}
