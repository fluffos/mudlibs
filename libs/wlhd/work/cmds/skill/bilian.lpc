// By rock&jym 2002.5.23

#pragma save_binary
#include <ansi.h>
inherit F_CLEAN_UP;

#define PERIOD          864
#define PERIOD_POT      10000

int lian(object me);
int halt_lian(object me);
int help(object me);

// void create() { seteuid(getuid()); }

int main(object me, string arg) {
  int exercise_cost;
  int skill, skill_basic;
  string skillname;
  object where;

  seteuid(getuid());
  where = environment(me);

  if (!where->query("no_fight"))
    return notify_fail("在这里闭关？不太安全吧？\n");

  if (!where->query("sleep_room"))
    return notify_fail("你得找一个能够休息的地方闭关。\n");

  if (me->query_condition("killer"))
    return notify_fail("官府正在通缉你，你心神不定无法专心练功！\n");

  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");

  if (me->query("doing"))
    return notify_fail("你已经在闭关了。\n");

  if (me->query("potential") - me->query("learned_points") < 100000)
    return notify_fail("你的潜能不够，没法闭关修行。\n");

  if (!me->query("animaout"))
    return notify_fail("你必须要修炼元婴出世。\n");

  if ((int)me->query("qi") / (me->query_max_hp() / 100) < 90)
    return notify_fail("你现在的气太少了，无法静心闭关。\n");

  if ((int)me->query("jing") * 100 / me->query_max_jing() < 90)
    return notify_fail("你现在的精太少了，无法静心闭关。\n");

  if ((int)me->query_max_neili() < 40000)
    return notify_fail("你觉得内力颇有不足，看来目前还难以"
      "进行长时间的闭关修炼。\n");

  if ((int)me->query("neili") * 100 / me->query_max_neili() < 90)
    return notify_fail("你现在的内力太少了，无法静心闭关。\n");

  if (!arg) return help(me);

  if (!stringp(skillname = me->query_skill_mapped(arg)) || arg == "parry")
    return notify_fail("你只能练习用 enable 指定的特殊技能。\n");

  skill_basic = me->query_skill(arg, 1);
  skill = me->query_skill(skillname, 1);

  if (skill < 1)
    return notify_fail("你好像还没有学过这项技能吧？最好先去请教别人。\n");

  if (skill_basic < 1)
    return notify_fail("你对这方面的技能还是一窍不通，最好从先从基本学起。\n");

  if (skill_basic <= skill)
    return notify_fail("你的基本功火候未到，必须先打好基础才能继续提高。\n");

  if (SKILL_D(skillname)->practice_skill(me)) {
    write(HIY "你的" + to_chinese(skillname) + "通过验证了,可以闭关了！\n" NOR);
  } else return 0;

  message_vision("$N盘膝坐下，开始冥神运功，闭关修行。\n", me);
  me->set("startroom", base_name(where));
  me->set("doing", "bilian");
  me->set("bilian", "" + skillname + "");
  me->set("bijiben", arg);
  CLOSE_D->user_closed(me);
  me->start_busy(bind((: call_other, __FILE__, "lian" :), me),
    bind((: call_other, __FILE__, "halt_lian" :), me));
  CHANNEL_D->do_channel(this_object(), "rumor",
    sprintf("武林高手%s(%s)开始闭关自练。",
      me->name(1), me->query("id")));

  return 1;
}

int jixu_lian(object me) {
  me->start_busy(bind((: call_other, __FILE__, "lian" :), me),
    bind((: call_other, __FILE__, "halt_lian" :), me));
  CLOSE_D->user_closed(me);
  tell_object(me, HIR "\n你继续闭关...\n" NOR);
  return 1;
}

int lian(object me) {
  int t;
  int tn;
  int pot;
  int r;
  int i;
  int exp_inc;
  string *ks;
  string *skills;
  mapping all_skills;

  pot = me->query("potential");

  if (me->query("jym_money") < 2) {
    if (pot <= me->query("learned_points") || me->query_skill(
      "" + me->query("bilian") + "",
      1
    ) >= me->query_skill("" + me->query("bijiben") + "", 1)) {
      tell_object(me, "你的闭关结束了。\n");
      message_vision("$N睁开双目，缓缓吐了一口气，站了起来。\n", me);
      CLOSE_D->user_opened(me);
      CHANNEL_D->do_channel(this_object(), "rumor",
        sprintf("听说%s(%s)闭关自练结束了!。",
          me->name(1), me->query("id")));
      if (!interactive(me)) {
        me->force_me("chat* haha");
        call_out("user_quit", 1, me);
      }

      return 0;
    }
    me->add("learned_points", 5);
    me->improve_skill(
      "" + me->query("bilian") + "",
      me->query_skill("" + me->query("bijiben") + "", 1) * 8
    );
    write(HIG "你把你的" + to_chinese(me->query("bilian")) + "自练了四十次,你的" + to_chinese(me->query("bilian")) + "进步了！\n");
  } else {
    if (me->query_skill(
      "" + me->query("bilian") + "",
      1
    ) >= me->query_skill("" + me->query("bijiben") + "", 1)) {
      tell_object(me, "你的武功练满了。\n");
      message_vision("$N睁开双目，缓缓吐了一口气，站了起来。\n", me);
      CLOSE_D->user_opened(me);
      CHANNEL_D->do_channel(this_object(), "rumor",
        sprintf("听说%s(%s)闭关自练结束了!。",
          me->name(1), me->query("id")));
      if (!interactive(me)) {
        me->force_me("chat* haha");
        call_out("user_quit", 1, me);
      }

      return 0;
    }

    if (this_player()->query("money") < 5000001) {
      this_player()->add("jym_money", -1);
      tell_object(this_player(), HIR "你的存款不够，系统自动把你的元宝换成存款了！\n" NOR);
      this_player()->add("money", 100000000);
    }
    me->add("money", -8000000);
    me->improve_skill(
      "" + me->query("bilian") + "",
      me->query_skill("" + me->query("bijiben") + "", 1) * 8
    );
    write(HIG "你把你的" + to_chinese(me->query("bilian")) + "自练了四十次,你的" + to_chinese(me->query("bilian")) + "进步了！\n");
  }

  return 1;
}

int halt_lian(object me) {
  CLOSE_D->user_opened(me);
  tell_object(me, "你中止了闭关。\n");
  message_vision(HIY "$N" HIY "大喝一声，睁开眼来，一股气流登时"
    "将众人迫退四步。\n\n" NOR, me);
  if (me->query("jym_money") > 100) me->add("jym_money", -100);
  else {
    if (me->query("potential") - me->query("learned_points") >= 100000) me->add(
      "learned_points",
      100000
    );
    else me->add("potential", (me->query("learned_points") - me->query("potential")) / 2);
  }
  CHANNEL_D->do_channel(this_object(), "rumor", "听说" + me->name(1) +
    "闭关中途突然复出。");
  me->force_me("quit");
  return 1;
}

private void user_quit(object me) {
  if (!objectp(me) || interactive(me))
    return;

  me->force_me("quit");
}

int help(object me) {
  write(@HELP
指令格式 : bilian <基本技能>

闭关自练,可以在闭关中自练武功,但是需要元宝和潜能!

HELP);
  return 1;
}
