//edit by rock
//宠物回收

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object pet;
  string pet_id, dir;

  if (!arg) return notify_fail("指令：recovery pet(收回宠物)\n指令：recovery drop <宠物ID> (丢弃宠物)\n");

  //如果是回收宠物
  if (arg == "pet") {
    if (pet = me->query_temp("pet")) {
      pet->save();
      destruct(pet);
      tell_object(me, "你将宠物收回。\n");
      return 1;
    } else notify_fail("你并没有放出这只宠物。\n");
  } else if (sscanf(arg, "drop %s", pet_id) == 1) {
    dir = me->query("id");

    if ((pet = me->query_temp("pet")) && pet->query("id") == pet_id) {
      dir = pet->query_save_file() + ".o";
      destruct(pet);
      rm(dir);
      tell_object(me, "你将这只宠物丢弃了。\n");
      return 1;
    } else notify_fail("你并没有放出这只宠物。\n");
  }
  return 0;
}
