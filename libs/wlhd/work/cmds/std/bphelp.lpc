// edit By rock&jym /2004/07/10/

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  object lp;
  string str, banghui, myid;

  myid = me->query("id");

  if (!stringp(banghui = me->query("banghui")))
    return notify_fail("只有帮主才能使用该指令!\n");

  lp = new("/clone/misc/lingpai");
  lp->create(banghui);

  if (lp->query("no_use")) {
    destruct(lp);
    return notify_fail("你的帮会文件有问题，请与巫师联系。\n");
  }

  if (lp->query("bangzhu_id") != myid && !lp->query("bphelp/" + myid)) {
    destruct(lp);
    return notify_fail("您没有使用这个指令的权利。\n");
  }

  if (lp->query("helpci") > 10) {
    destruct(lp);
    return notify_fail("你以为写帮派帮助是一件拿来开玩笑的事情吗?\n");
  }

  if (!arg) {
    destruct(lp);
    return notify_fail("具体请help bphelp\n");
  }

  if (arg == "xiugai") {
    if (!lp->query("help"))
      return notify_fail("你的帮派根本没有帮助文件，你去哪里修改啊？\n");

    str = lp->query("help");
    lp->add("helpci", 1);
    lp->save();
    destruct(lp);
    rm(str);
    write(HIR "现在进入编辑帮助状态。\n" NOR);
    write(HIR "请输入帮派帮助第1行的内容：\n" NOR);
    input_to("edit_help", me, str, 1);
    return 1;
  }

  if (sscanf(arg, "%s", str)) {
    arg = str;
    str = "/doc/bangpai/" + str;
    if (file_size(str) > 0)
      return notify_fail("该名称的帮助文件已存在，请另外取个名字。\n");

    if (lp->query("help"))
      rm(lp->query("help"));

    write(HIR "系统确认help " + arg + "为您帮派的帮助指令！\n" NOR);
    write(HIR "现在进入编辑帮助状态。\n" NOR);
    write(HIR "请输入帮派帮助第1行的内容：\n" NOR);
    lp->set("help", str);
    lp->set("helpid", arg);
    lp->add("helpci", 1);
    lp->save();
    destruct(lp);
    input_to("edit_help", me, str, 1);
    return 1;
  }

  return 0;
}

void edit_help(string arg, object me, string str, int n) {
  object help;

  if (arg == ".") {
    write(HIR "结束编辑状态。" NOR);
    return;
  }
  if (n > 500) return;

  write_file(str, trans_color(arg, 2) + "\n" NOR);
  n++;
  write(HIR "请输入帮派帮助第" + n + "行的内容：(结束请按“.”)\n" NOR);
  input_to("edit_help", me, str, n);
  return;
}

int help(object me) {
  write(@HELP

bphelp 指令使用方法：
一：bphelp <帮助名称>
二：bphelp xiugai
<帮助名称>就是help的后簇，例如help newbie,这个newbie就是
<帮助名称>
bphelp xiugai就是指整个帮派help全部重新输入，原来的帮助
文件已经被系统删除
附：bphelp指令输入的帮助系统支持颜色，具体颜色请查看
help nick，每个帮派只能使用10次，请慎重考虑好后再使用。

by rock&jym
HELP
  );
  return 1;
}
