#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object pet;
  string dir, file;

  if (me->query_temp("pet")) return notify_fail("你的宠物就在这个世界上。无需召唤。\n");
  if (!arg) return notify_fail("你要召唤什么。\n");

  dir = me->query("id");

  file = sprintf("/data/pet/%c/%c/%s_%s.pet.o", dir[0], dir[1], dir, arg);
  if (file_size(file) < 1)
    return notify_fail("你没有这只宠物。\n");

  if (pet = new("/u/rock/pet.lpc")) {
    pet->set("id", arg);
    pet->set("owner_id", me->query("id"));
    if (pet->restore()) {
      pet->set("owner", me);
      pet->move(environment(me));
      pet->pet_heart();
      me->set_temp("pet", pet);
      return notify_fail(sprintf("%s蹦蹦跳跳的跑了过来。\n", pet->query("name")));
    } else {
      destruct(pet);
      return notify_fail(sprintf("你没有%s这只宠物。\n", arg));
    }
  } else notify_fail("宠物文件出错，你所用的代码可能拷贝于金庸梦，请联系Rock。\n");
}
