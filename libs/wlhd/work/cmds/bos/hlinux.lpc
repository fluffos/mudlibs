// multi-convert
inherit F_CLEAN_UP;

int main(object me, string arg)
{
       int i;
       
       mixed *file;
       seteuid( geteuid(me) );

       if( !arg && !me->query("cwd"))
               return notify_fail("指令格式：cvdir <路径>\n");
       if(!arg)arg=me->query("cwd");

       if( arg[strlen(arg)-1]!='/' ) arg += "/";
       if(  file_size(arg)!=-2 )
               return notify_fail("没有这个目录！\n");

       file = get_dir(arg);
       if( !sizeof(file) )
               return notify_fail(arg + " is empty \n");

       for( i = 0; i < sizeof(file); i++ ) 
       {
               if( sscanf(file[i], "%*s.o") ) 
                       continue;
               file[i] = arg + file[i];
               if( file_size(file[i]) < 0 ) 
               {
                       write("没有" + file[i] + "这个档案。\n");
                       continue;
               }

               me->set("cwf", file[i]);
               write(sprintf("[文件转换]:(%s)\n",file[i]));
               "/cmds/bos/cv"->main(me,file[i]);//这个
       }
       return 1;
}


