// by rock&jym  /02/01/03/

#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        object ob, man;
        mapping id;
        string who;
        int i, cost;
        id = me->query("tiaozhan");
        seteuid(getuid());

        foreach (man in all_inventory(environment(me))) {
                if( living(man) && !userp(man) ) break;
        }

        if ( !arg ) return notify_fail("你要挑战谁???\n");

        ob = find_player(arg);

        if( me->is_busy() )
                return notify_fail("( 你上一个动作还没有完成，不能施用内功。)\n");

        if( me->is_fighting() )
        return notify_fail("战斗时不能用该指令！！！\n");

        if( (int)me->query("qi") < (int)me->query_max_hp() / 2 ||
        (int)me->query("eff_qi") < (int)me->query_max_hp() / 2 )
        return notify_fail("此指令只能在您精气旺盛时才能使用！！！\n");

        me->start_busy(1);

// 取消仇杀对象
        if( sscanf(arg, "quxiao %s", who) )
        {
        ob = find_player(who);

        if ( !ob ) return notify_fail("你要挑战的人并没在线!!!\n");

        for(i=1;  i<sizeof(id)+1; i++)
        {
        if ( me->query("tiaozhan/"+i+"") != ob->query("id") )
        cost++;
        }

        if ( cost == sizeof(id) ) 
        return notify_fail(HIB"你并没有和"+ob->name()+"进入仇杀状态呀???\n");

        for(i=1;  i<sizeof(id)+1; i++)
        {
        if ( me->query("tiaozhan/"+i+"") == ob->query("id") ) 
        me->delete("tiaozhan/"+i+"");
        }

        for(i=1;  i<sizeof(id)+1; i++)
        {
        if ( me->query("tiaozhan/"+i+"") == me->query("tiaozhan/"+(i-1)+"") )
        me->delete("tiaozhan/"+i+"");

        if ( !me->query("tiaozhan/"+i+"") && me->query("tiaozhan/"+(i+1)+"") )
        me->set("tiaozhan/"+i+"",""+me->query("tiaozhan/"+(i+1)+"")+"");

        if ( me->query("tiaozhan/"+i+"") == "0" )
        me->delete("tiaozhan/"+i+"");

        if ( i == sizeof(id)+1 )
        me->delete("tiaozhan/"+i+"");
        }

        for(i=1;  i<sizeof(ob->query("tiaozhan"))+1; i++)
        {
        if ( ob->query("tiaozhan/"+i+"") == me->query("id") ) 
        ob->delete("tiaozhan/"+i+"");
        
        }

        for(i=1;  i<sizeof(ob->query("tiaozhan"))+1; i++)
        {
        if ( ob->query("tiaozhan/"+i+"") == ob->query("tiaozhan/"+(i-1)+"") )
        ob->delete("tiaozhan/"+i+"");

        if ( !ob->query("tiaozhan/"+i+"") && ob->query("tiaozhan/"+(i+1)+"") )
        ob->set("tiaozhan/"+i+"",""+ob->query("tiaozhan/"+(i+1)+"")+"");

        if ( ob->query("tiaozhan/"+i+"") == "0" )
        ob->delete("tiaozhan/"+i+"");

        if ( i == sizeof(ob->query("tiaozhan"))+1 )
        ob->delete("tiaozhan/"+i+"");
        }

        shout(HIR"【PK之窗】"HIG""HIW+me->name()+"("+me->query("id")+HIG")和"
HIC+ob->name()+"("+ob->query("id")+HIG")取消了仇杀状态！！！\n"NOR);

        write(HIR"【PK之窗】"HIG""HIW+me->name()+"("+me->query("id")+HIG")和"
HIC+ob->name()+"("+ob->query("id")+HIG")取消了仇杀状态！！！\n"NOR);
        return 1;
        }

// 查看仇杀对象
        if ( arg == "-l" ) {
        write(HIC"≡"HIY"────────────────"HIC"≡\n"NOR);
        write(HIG"你仇杀的对象有以下几人\n"NOR);
        write(HIC"≡"HIY"────────────────"HIC"≡\n"NOR);
        if ( me->query("tiaozhan") )
{
        for(i=1;  i<sizeof(id)+1; i++)
        write(HIR""+me->query("tiaozhan/"+i+"")+"\n"NOR);
}
        else
        write(HIR"暂时无仇杀对象\n"NOR);
        write(HIC"≡"HIY"────────────────"HIC"≡
\n"NOR);
        return 1;
        }
        
        if (me->query("age") < 28 )
                return notify_fail("只有成年人才可以挑战对方！\n");

        if ( !arg )
                return notify_fail("你要挑战谁???\n");

        if (!ob) return notify_fail("你要挑战的人并没在线!!!\n");

        ob->set_temp("msg",time()+300);
        if ( ob == me )
                return notify_fail("你要挑战自己？\n");

        if(wizardp(ob) && !wizardp(me)) return notify_fail("你要挑战天神??不要命了???\n");
        
        for(i=1;  i<sizeof(id)+1; i++)
        {
        if ( me->query("tiaozhan/"+i+"") == ob->query("id") )
        return notify_fail(HIB"你已经和"+ob->name()+"进入仇杀状态了!!!\n");
        }

        if ( i > 10 )
        return notify_fail(HIG"仇杀对象最多只能有十个!!!\n");

        if( ob->query_temp("tiaozhan") != ""+me->query("id")+"" ) {
        me->set_temp("tiaozhan",""+ob->query("id")+"");
        shout(HIR"【PK之窗】"HIG""HIW+me->name()+"("+me->query("id")+HIG")向"
HIC+ob->name()+"("+ob->query("id")+HIG")宣战，江湖中看来又要掀起一阵风雨了！！！\n"NOR);
        write(HIR"【PK之窗】"HIG""HIW+me->name()+"("+me->query("id")+HIG")向"HIC+ob->name()+"("+ob->query("id")+HIG")宣战，江湖中看来又要掀起一阵风雨了！！！\n"NOR);
        }
        else  
        {
        for(i=1;  i<sizeof(id)+1; i++);
        me->set("tiaozhan/"+i+"",""+ob->query("id")+"");

        for(i=0;  i<sizeof(ob->query("tiaozhan"))+1; i++);
        ob->set("tiaozhan/"+i+"",""+me->query("id")+"");

        ob->delete_temp("tiaozhan");
        me->delete_temp("tiaozhan");

        shout(HIR"【PK之窗】"HIG""HIC+me->name()+"("+me->query("id")+HIG")答应了"HIW+ob->name()+"("+ob->query("id")+HIG")的挑战，有好戏上场咯！！！\n"NOR);
        write(HIR"【PK之窗】"HIG""HIC+me->name()+"("+me->query("id")+HIG")答应了"HIW+ob->name()+"("+ob->query("id")+HIG")的挑战，有好戏上场咯！！！\n"NOR);
        }        
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : tiaozhan [<某人>]
这个指令为PK专用！！！
你向对方ID挑战以后，如果对方也tiaozhan你的话，
那么双方ID将进入仇杀阶段，在此阶段，双方ID互相
PK不会被官府通缉，但是PK没进入仇杀阶段的ID依然
会被通缉!!!

            tiaozhan quxiao [<某人>]
这个指令是用于想和对方取消仇杀状态用的！只要一
方用了，双方都取消挑战状态!

            tiaozhan -l
这个指令是用来查看现在和你进入PK仇杀状态的id

附:仇杀对象最多，只能有10个，所以各位下tiaozhan
以前请先考虑好!!!
HELP
    );
    return 1;
}



