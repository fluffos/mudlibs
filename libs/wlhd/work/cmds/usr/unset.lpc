// unset.c
inherit F_CLEAN_UP;
int help();
int main(object me, string arg)
{
	if( !arg || arg=="" ) return help();
        if( arg == "no_msg" ) {
        if( me->query_temp("setmsg")>time() ) 
                return notify_fail("这个变量不能经常删除，请过1分钟后再尝试。\n");
        me->set_temp("setmsg",time()+60);
        }
        if( arg == "ditu" )  write(ESC+"[r"+TOBOT(50));
	me->delete("env/" + arg);
	write("Ok.\n");
	return 1;
}
int help()
{
	write(@TEXT
指令格式：unset <变数名>
这个指令让你删除环境变数的设定。
修改变数设定请用 unset 指令。
TEXT
	);
	return 1;
}
