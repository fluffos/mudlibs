inherit ROOM;
#include <ansi.h>;

void create()
{
        set("short",HBGRN+WHT"商业街北区"NOR);
        set("long", 
"绕过小湖，眼前一亮，青砖路面笔直通向前方，两旁雕
梁画栋的商业铺面让你眼前一亮，这里行人熙来攘往，甚是
繁华，串串灯笼高挂，隐隐还能听到算盘噼噼啦啦的拨打声
和伙计的迎客送客的唱诺，真是好不热闹。

                   $HIY$十$NOR$          $HIY$两$NOR$                               
                   $HIY$省$NOR$          $HIY$江$NOR$
                   $HIY$通$NOR$          $HIY$名$NOR$
                   $HIY$衢$NOR$          $HIY$地$NOR$
                   $HIY$人$NOR$          $HIY$俗$NOR$
                   $HIY$辏$NOR$          $HIY$繁$NOR$
                   $HIY$集$NOR$          $HIY$华$NOR$

"
 );
       set("outdoors", "player");
       set("no_fight",1);
        set("exits", ([
                "south"  : "/d/wizard/fightroom5",
        ]));
        set("objects", ([
        ]));
        setup();
        replace_program(ROOM);
}

void init()
{
        object me = this_player();
                tell_object(me, WHT "\n欢迎光临扬州商业街，想知道如何操作"
                                "请(" HIY "help trade & help cmdtrade" NOR + WHT ")，祝你"
                                "购物愉快。\n\n" NOR);

}
