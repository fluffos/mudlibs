//By rock&jym /2002/4/29/
#include <ansi.h>
#include <login.h>

inherit NPC;
void create() {

  set_name("升级师", ({ "shengji shi", "shi", "shengji" }));
  set("age", 20);
  set("long", @STORY
这个是方舟写的升级师,你可以使用shengji指令来提升你的等级
具体请help shengji
STORY
  );
  set("chat_chance", 8);
  set("title", HIG "升级" NOR);
  exert_function(10);
  set("chat_msg", ({
    "您可以使用shengji指令来提升您的等级\n",
  }));

  set("gender", "男性");
  set("combat_exp", 10000);
  set("max_neili", 1500);
  set("force", 9999999);

  set_skill("hunyuan-yiqi", 999);
  set_skill("force", 999);
  map_skill("force", "hunyuan-yiqi");


  setup();
}

void init() {
  add_action("do_shengji", "shengji");
}

int do_shengji(object me) {
  int exp, dj, index;
  me = this_player();
  exp = me->query("combat_exp");

  dj = me->query("jym_level/level");

  //升级所需经验=50+(当前级别+1)的三次方 
  //index = dj*10000000;
  index = (50 + (dj + 1)) * (50 + (dj + 1)) * (50 + (dj + 1)) * (50 + (dj + 1));
  if (index > 1700000000 || index < 1) index = 1700000000;

  if (exp < index)
    return notify_fail("您想升下一级还需要" + (index - exp) + "点经验值!\n");

  me->add("combat_exp", -index);

  me->add("jym_level/level", 1);

  if ((dj = me->query("jym_level/level")) > 150) {
    me->delete("jym_level/level");
    me->add("jym_level/zhuan", 1);
  }

  tell_object(me, sprintf(HIC "您升到了%d级了!\n" NOR, dj));

  return 1;
}
