#include <room.h>
inherit ROOM;
void create() {
  set("short", "闭关室");
  set("long", @LONG
这里方舟为《武林浩荡》的玩家准备的离线闭关室,
欢迎大家来这里闭关!
LONG
  );
  set("no_fight", "1");
  set("no_steal", "1");
  set("sleep_room", "1");
  set("valid_startroom", "1");
  set("objects", ([
  ]));
  set("exits", ([
    "down": "/d/city/guangchang",
  ]));
  setup();
}
void init() {
  object me;
  me = this_player();
  add_action(
    "discmds",
    ({
      "duanlian",
      "yun",
      "attack",
      "ansuan",
      "touxi",
      "persuade",
      "teach",
      "exert",
      "exercise",
      "study",
      "learn",
      "sleep",
      "kill",
      "steal",
      "cast",
      "conjure",
      "expell",
      "fight",
      "hit",
      "perform",
      "prcatice",
      "scribe",
      "surrender",
      "xue",
      "dazuo",
      "yun"
    })
  );
  if (!me->query("doing") && !wizardp(me)) {
    message_vision(HIR "没在闭关也敢来这里，不想活了!\n" NOR, this_player());
    me->move("/d/city/guangchang");
  }
}
int discmds() {
  tell_object(this_player(), "大胆！在方舟的地盘也敢乱来？！\n");
  return 1;
}
