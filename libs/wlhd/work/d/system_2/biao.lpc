// 银鳞镖
#include <weapon.h>
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIC"银鳞镖" NOR, ({"yinlin biao","biao","yinlin"}));
        set_weight(50);

        if (clonep())
                set_default_object(__FILE__);
        else
        {
                set("unit", "枚");
                set("long", "这是一枚出自无名老人之手的绝世暗器，其威力强横无匹，为镖中之王。\n");
                set("value", 0);
        }
        setup();
}

void init()
{
        add_action("do_use","use");
}

int do_use(string arg)
{
        object me, target;
        string msg;

        me = this_player();
        
        me->clean_up_enemy();
        target = me->select_opponent();

        if ( !arg || arg != "yinlin")
                return 0;
        
 
        if( (int)me->query_skill("throwing", 1) < 501 )
                return notify_fail("你的暗器手法不够娴熟，无法发射银鳞镖。\n");

        if ( !(me->is_fighting()) )
                return notify_fail("这飞镖可不是偷袭用的，你必须在战斗中使用！\n");

           if((int)target->query("mud_age") <= 1728000 && userp(target)) 
           return notify_fail("为了世界更美好，放过小孩子吧.\n"); 
          
         if((int)target->query("jym_level/level")*2 < (int)me->query("jym_level/level"))          
           return notify_fail("暗器伤人，非高手本色！\n"); 

        if( (int)me->query_max_neili() < 50000  ) 
                return notify_fail("你的内力修为不够，无法使用银鳞镖。\n");



        if( (int)me->query("neili") < 80000  ) 
                return notify_fail("你的内力不够。\n");

        msg = HIR"\n$N突然身影微微一止，猛一扬手竟然发出一道银光缓缓向$n射去。\n只见$n的周身飞舞着无数的光影，却听不到一丝声音。\n"NOR;
        message_vision(msg, me, target);
        me->add("neili", -50000);
        me->set_temp("xinqian", 1);

        tell_object(target, HIR"\n你急忙屏气凝神，希望能够躲开这致命的一击。\n"NOR);
        target->start_busy(4);

        remove_call_out("effect_biao");
        call_out("effect_biao", 3, me, target);

        return 1;
}

int effect_biao(object me, object target)
{
        int myskill, trskill;
        string msg;

        myskill = (int) (2 * (int)me->query("dodge") + ((int)me->query("combat_exp") / 1000) + (int)me->uery_skill("tangmen-biaofa", 1));
        trskill = (int) (2 * (int)target->query("dodge") + ((int)target->query("combat_exp") / 1000));

        if ( ( myskill >= trskill ) && ( random(100) != 0 ) )
                {
                        msg = HIG"忽然那无数的光影一闪而没，$n身行一顿，只觉一股奇妙的感觉从心口传遍全身。\n"NOR;
                        message_vision(msg, me, target);
                        tell_object(target, HIR"你只觉得胸口一阵酸楚。低头一看只见那枚暗器已经深深的嵌在你的心口。\n血迹中的飞镖上隐然出现几个小字[曾经沧海]。"NOR);
                        me->delete_temp("xinqian");
                        me->start_busy(4);
                        this_object()->move(target);
                      target->add("jing", -(int)me->query("jym_level/level")*100);
                      target->add("qi", -(int)me->query("jym_level/level")*100);
                      target->add("neili", -(int)me->query("jym_level/level")*200);
                        if ( target->query("jing") < 10 )
                                target->set("jing", 50);
                        if ( target->query("neili") < 10 )
                                target->set("neili", 50);
                        if ( target->query("qi") < 10 )
                                target->set("qi", 50);
                }
        else
                {
                        tell_object(target, HIY"忽然那无数的光影一闪而没，你心中一惊急忙运内力于全身。\n"NOR);
                        msg = HIY"$n双臂急舞，衣袖带起破风之声。只听当的一声轻响，竟将那枚暗器磕飞开去。\n"NOR;
                        message_vision(msg, me, target);
                        if ( target->query("neili") < 1000 )
                                target->set("neili", 0);
                        else
                                target->add("neili", -1000);
                        me->delete_temp("xinqian");
                        me->start_busy(7); 
                        target->start_busy(2);                        destruct(this_object());
                }
        return 1;
}



