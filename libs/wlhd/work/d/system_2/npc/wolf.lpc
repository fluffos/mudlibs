#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIB "老狼" NOR, ({ "old wolf", "wolf" }));
  set("nickname", HIB "都是月亮惹的祸" NOR);
  set("gender", "男性");
  set("age", 98);
  set("long", HIY "这位是〖《武林浩荡》〗的老狼，向他打听“system_2”，以补偿你的损失。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 999999999);
  set("str", 300);
  set("dex", 300);
  set("con", 300);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("jingli", 21000000);
  set("score", 100000);
  set("no_suck", 1);

  set("inquiry", ([
    "system_2": (: ask_me :),
  ]));
  setup();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("whisper " + ob->query("id") + " " HIW "欢迎回到〖《武林浩荡》〗" + HIR + "(ask wolf about system_2)" + NOR + HIW + "来得到补偿。" NOR);
  command("es " + HIC "欢迎光临〖《武林浩荡》〗,IP: 211.97.200.87 Port: 4000,\n" NOR);
  call_out("greeting", 2);

}

string ask_me() {
  object me = this_player();
  mapping fam;

  if ((int)me->query("bbb1"))
    return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
  else {
    me->set("bbb1", 1);
    me->add("potential", 50000);
    me->add("food", 10000);
    me->set("kar", 32);
    me->set("per", 30);
    me->add("water", 10000);
    me->add("max_neili", 500);
    me->add("max_jingli", 500);
    return "欢迎回到" NOR + HIR "〖《武林浩荡》〗" NOR "，巫师组表示非常抱歉。这是你的补偿\n"
      HIG "突然天上掉下个西门无剑，" + this_player()->query("name") + "躲避不及，被砸个眼冒金星。" NOR;
  }
}
