inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("弟子", ({ "dizi", "dizi" }));
        set("gender", "男性");
        set("age", 26);
        set("title", "梅庄弟子");
        set("long", 
                "梅庄的弟子，他正笑嘻嘻的看着你。\n");
        set("attitude", "peaceful");
        set("str", 25);
        set("int", 15);
        set("con", 20);
        set("dex", 25);

        set("qi", 300);
        set("max_qi", 300);
        set("jingli", 200);
        set("max_jingli", 200);
        set("neili", 100);
        set("max_neili", 100);
        set("jiali", 30);
        
        set("combat_exp", 100000);
        
        set_skill("force", 100);
        set_skill("unarmed",100);
        set_skill("dodge", 100);  
        set_skill("sword", 100); 
        set_skill("parry", 100); 
        set_skill("literate", 100); 
        
        setup();
        set("chat_chance", 5);
        set("chat_msg", ({
              "梅庄弟子道：不知向问天他们几时来营救任我行，唉，不知我们还能活命不？\n",
        }));
        add_money("silver", 30+random(30));
}

