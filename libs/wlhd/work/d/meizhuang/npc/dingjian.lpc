#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void greeting(object);
void init();
void create() {
  set_name("丁坚", ({ "ding jian", "ding" }));
  set("long",
    "梅庄家徒。\n");
  set("gender", "男性");
  set("age", 35);
  set("title", HIW "梅庄家徒" NOR);
  set("nickname", HIY "一字电剑" NOR);
  set("shen_type", 1);
  set("attitude", "peaceful");

  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("qi", 8000);
  set("max_qi", 8000);
  set("jing", 4000);
  set("max_jing", 4000);
  set("neili", 8000);
  set("max_neili", 8000);
  set("jiali", 200);
  set("shen", 0);

  set("combat_exp", 5000000);

  set("score", 10000);
  set_skill("force", 350);
  set_skill("wuzheng-xinfa", 350);
  set_skill("dodge", 350);
  set_skill("parry", 340);
  set_skill("sword", 340);
  set_skill("unarmed", 350);

  create_family("梅庄", 2, "家徒");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/d/city/npc/obj/gangjian")->wield();
}

void attempt_apprentice(object ob) {

  if ((string)ob->query("gender") == "无性") {
    command("say 这位公公不要开玩笑了。");
    command("say 这位" + RANK_D->query_respect(ob) +
      "还是快去伺候皇上吧！");
    return;
  }

  command("recruit " + ob->query("id"));
  return;
}
