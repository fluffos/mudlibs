#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIM "七" HIC "彩" HIW "圣" HIY "衣" NOR, ({ "color cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIG "这件七彩圣衣是天上的彩虹制成,\n专门为《武林浩荡》最杰出的玩家打造。\n" NOR);
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
