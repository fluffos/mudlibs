// Room: /d/wizard/fightroom3.c
// This is a room made by roommaker. write by Fan. :)
inherit ROOM;
void create()
{
    set("short", "擂台");
    set("long", @LONG
加油! 加油! 加油! 加油! 加油! 加油! 加油! 加油! 加油! 加油! 
LONG
    );
    set("exits", ([ /* sizeof() == 1 */
  "down" : __DIR__"fightroom2",
]));
    set("no_new_clean_up", 0);
    set("fight_room", __DIR__"fightroom2");
   set("no_sleep_room",1);
  set("no_pf",1);
    setup();
}
void init()
{
        add_action("no_action", "lian");
      add_action("no_action", "xue");
      add_action("no_action", "learn");
       add_action("no_action", "steal");
       add_action("no_action", "duanlian");
     add_action("no_action", "set");
        add_action("no_action", "practice");
         add_action("no_action", "zuanyan");
      if( this_player()->query_condition("killer") )
                {
                 this_player()->move("/d/city/guangchang");
            message_vision("\n"HIW"因为$N杀了人所以被赶出了擂台。NOR\n""\n",this_player());
                }
if (this_player()->query("env/combatd") )
this_player()->delete("env/combatd");
}

int no_action(string str)
{
      write("这里可不许这样哦.. \n");
        return 1;
}
void relay_message(string msg)
{
    object look_fight_room;
   string *msgs;
    int i;
    if (!look_fight_room=find_object("/d/wizard/fightroom2"))
    look_fight_room=load_object("/d/wizard/fightroom2");
   msgs=explode(msg, "\n");
    for (i=0;i<sizeof(msgs);i++)
    if (strlen(msgs[i])>5)
    message("vision",NOR+"@@ -->"+msgs[i]+"\n",look_fight_room);
}
int valid_leave(object me, string dir)
{
   if (me->is_fighting() && dir=="down")
        return notify_fail("临阵脱逃，非大丈夫所为呀！\n");
         return ::valid_leave(me, dir);
}

