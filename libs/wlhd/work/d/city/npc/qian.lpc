inherit BHNPC;
string query_save_file() { return DATA_DIR + "npc/qianyankai"; }
inherit F_BANKER;
int do_zhuanrock(string arg);
void create() {
  set_name("钱眼开", ({ "qian yankai", "qian", "yankai" }));
  //this_object()->init_bhnpc();
  set("area_name", "扬州钱庄");
  set("area_id", "yzqianzhuang");
  set("area_file", "/d/city/npc/qian.lpc");
  set("ziyuan", "黄金");
  set("jizhi", 55);  //注25这个数字关系都地盘的收入,这个数子不要超过100就可以了
  set("kaifa", 40);
  set("title", "钱庄老板");
  set("nickname", "铁公鸡");
  set("gender", "男性");
  set("age", 34);
  set("str", 100);
  set("int", 24);
  set("dex", 18);
  set("con", 18);
  set("neili", 200);
  set("max_neili", 100);
  set("jiali", 10);
  set("shen", 0);
  set("combat_exp", 12500);
  set("shen_type", 1);
  set("attitude", "friendly");
  set("env/wimpy", 50);
  set("chat_chance", 2);
  set("chat_msg", ({
    "钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。\n",
    "钱眼开说道：昨天我亲自看到一个杀手帮的人来取钱，看来杀手帮重出江湖了。\n"
    "钱眼开笑着说道：杀手帮重出江湖对本银号来说，真是求之不的呀！。\n"
    "钱眼开笑着说道：当年雾中楼在本银号存的钱可以说是最多的了。\n",
    "钱眼开笑着说道：在本店存钱无利息，取钱收百分之一的手续费，客官您看着办吧。\n",
    "钱眼开微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。\n",
  }));
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set("no_put", 1);
  set_temp("apply/damage", 40);
  setup();
  add_money("silver", 10);
  carry_object("/clone/misc/changpao")->wear();
}
void init() {
  if (base_name(environment()) != this_object()->query("startroom")) return;
  add_action("do_zhuanrock", "zhuanrock");
  add_action("do_check", "check");
  add_action("do_check", "chaqian");
  add_action("do_convert", "convert");
  add_action("do_convert", "huan");
  add_action("do_deposit", "deposit");
  add_action("do_deposit", "cun");
  add_action("do_withdraw", "withdraw");
  add_action("do_withdraw", "qu");
}
int do_zhuanrock(string arg) {
  string target;
  object who;
  int str;
  object me = this_player();
  if (!arg) return notify_fail("您要转给哪个玩家？请把他也叫过来!\n");

  if (sscanf(arg, "%d to %s", str, target) == 2
    || sscanf(arg, "%s %d", target, str) == 2);
  else return notify_fail("你要转给哪个玩家？\n");

  if (!objectp(who = present(target, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (who == me) return notify_fail("给自己转帐?\n");

  if (wizardp(me)) return notify_fail("巫师不能转帐!\n");
  if (me->is_busy())
    return notify_fail("还是先将你手上的事情做完了再给吧!\n");

  if (me->query("jym_money") < str)
    return notify_fail("你钱庄里没这么多元宝吧\n");

  if (!userp(who))
    return notify_fail("对不起只能转帐给玩家。\n");

  if (!living(who))
    return notify_fail("嗯!很显然," + who->name() + "现在正躺着,不能马上爬起来接受你的馈赠!\n");

  if (str < 1) return notify_fail("最少要转1枚。\n");

  if (str >= 3000)
    log_file("login/moneyid", sprintf("%s转了%d枚元宝给 %s,他的元宝有%d个,(%s)\n",
      me->query("id"), str, who->query("id"), me->query("jym_money"),
      "/cmds/usr/rtime.lpc"->chinese_time(5, ctime(time()))));
  me->add("jym_money", -str);
  who->add("jym_money", str);
  me->start_busy(3);
  me->save();
  who->save();
  message_vision(HIR "" + me->name() + "转了" + str + "枚元宝到" + who->name() + "的户头。\n" NOR, who, me);

  return 1;
}


#include <die.h>
