//获得装备存盘字段
//edit by rock
//2008.10.11

//身上所带物品
string query_save_prop_string(object item) {
  string prop, result, file, uid;
  int point;

  result = "";

  if (prop = item->query("make_name")) result += sprintf("make_name:%s,", prop);  //制造装备者
  if (prop = item->query("_name")) result += sprintf("_name:%s,", prop);      //原本名称
  if (point = item->query("mosaic_index")) result += sprintf("mosaic_index:%d,", point);  //镶嵌孔数量
  if (point = item->query_weight()) result += sprintf("weight:%d,", point);  //装备重量
  if (point = item->query("bangding")) result += sprintf("bangding:%d,", point);  //装备绑定状态
  if (point = item->query_amount()) result += sprintf("amount:%d,", point);  //叠加数量
  if (point = item->query("locktime")) result += sprintf("locktime:%d,", point);  //装备到期时间
  if (point = item->query("jianding")) result += sprintf("jianding:%d,", point);  //装备是否鉴定
  if (point = item->query("need_time")) result += sprintf("need_time:%d,", point);  //需要装备时才计算时间
  if (point = item->query("zhiliang")) result += sprintf("zhiliang:%d,", point);  //装备质量
  if (point = item->query("_level")) result += sprintf("_level:%d,", point);  //装备星级
  if (prop = item->query("name")) result += sprintf("name:%s,", prop);
  if (prop = item->query("gender")) result += sprintf("gender:%s,", prop);
  //	if( prop = item->query("id"))                             result += sprintf( "id:%s,", prop );
  if (point = item->query("exp")) result += sprintf("exp:%d,", point);
  if (point = item->query("max_lasting")) result += sprintf("max_lasting:%d,", point);
  if (point = item->query("level")) result += sprintf("level:%d,", point);
  if (prop = item->query("type")) result += sprintf("type:%s,", prop);
  if (point = item->query("value")) result += sprintf("value:%d,", point);
  if (point = item->query("pp")) result += sprintf("pp:%d,", point);
  if (point = item->query("hp")) result += sprintf("hp:%d,", point);
  if (point = item->query("mp")) result += sprintf("mp:%d,", point);
  if (point = item->query("ap")) result += sprintf("ap:%d,", point);
  if (point = item->query("cp")) result += sprintf("cp:%d,", point);
  if (point = item->query("dp")) result += sprintf("dp:%d,", point);
  if (point = item->query("jing")) result += sprintf("jing:%d,", point);
  if (point = item->query("jingli")) result += sprintf("jingli:%d,", point);
  if (point = item->query("weapon_prop/baoji")) result += sprintf("weapon_prop/baoji:%d,", point);  //爆击率
  if (point = item->query("weapon_prop/damage")) result += sprintf("weapon_prop/damage:%d,", point);  //攻击率
  if (point = item->query("armor_prop/armor")) result += sprintf("armor_prop/armor:%d,", point);  //防御率

  //武器
  if (point = item->query("weapon_prop/strength")) result += sprintf(
    "weapon_prop/strength:%d,",
    point
  );  //装备增加力量
  if (point = item->query("weapon_prop/dexerity")) result += sprintf(
    "weapon_prop/dexerity:%d,",
    point
  );  //装备增加身法
  if (point = item->query("weapon_prop/intelligence")) result += sprintf(
    "weapon_prop/intelligence:%d,",
    point
  );  //装备增加悟性
  if (point = item->query("weapon_prop/constitution")) result += sprintf(
    "weapon_prop/constitution:%d,",
    point
  );  //装备增加根骨

  //衣服
  if (point = item->query("armor_prop/strength")) result += sprintf(
    "armor_prop/strength:%d,",
    point
  );  //装备增加力量
  if (point = item->query("armor_prop/dexerity")) result += sprintf(
    "armor_prop/dexerity:%d,",
    point
  );  //装备增加身法
  if (point = item->query("armor_prop/intelligence")) result += sprintf(
    "armor_prop/intelligence:%d,",
    point
  );  //装备增加悟性
  if (point = item->query("armor_prop/constitution")) result += sprintf(
    "armor_prop/constitution:%d,",
    point
  );  //装备增加根骨

  //装备父类路径 不能调整代码位置
  if (prop = file_name(item)) {
    if (sscanf(prop, "%s#%s", file, uid) == 2) {
      result += sprintf("file:%s,", file);
    } else {
      result += sprintf("file:%s,", prop);
    }
  }

  return result;
}

