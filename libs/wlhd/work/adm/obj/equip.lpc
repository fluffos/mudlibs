void set_prop_baseon_string(object item, string prop) {
  string *str, type, chars;
  int size, i, index = 0;

  if (!item || !prop) return;

  str = explode(prop, ",");
  size = sizeof(str);

  for (i = 0; i < size; i++) {
    if (sscanf(str[i], "%s:%s", type, chars) == 2) {
      if (type == "file") continue;

      if (type == "weight") item->set_weight(to_int(chars));
      else if (type == "amount") item->set_amount(to_int(chars));
      else if (index = to_int(chars)) item->set(sprintf("%s", type), index);
      else item->set(sprintf("%s", type), chars);
    }
  }
}
