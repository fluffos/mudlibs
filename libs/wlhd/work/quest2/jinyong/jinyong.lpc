// accountguaiexp 计算怪的经验值
int accountguaiexp(int turn,object who)
{ 
   int userexp,guaiexp;
   userexp=who->query("combat_exp");
   guaiexp=userexp*3;
   return guaiexp;

}
int guaif(int turn,object who)
{
   int userneili,guaineili;
   userneili=who->query_max_neili();

   guaineili=userneili*(100+turn*60)/80;
   return guaineili;
}
int guaim(int turn,object who)
{
   int userjingli,guaijingli; 
   userjingli=who->query_max_jingli();
   guaijingli=userjingli*2;
   return guaijingli;
}
int set_guai_qi_jing(int turn,object guai)
{
   int maxqi,maxjing;
object who;
        who=this_player();

   maxqi=guai->query_max_neili()/2;
   maxjing=200+(int)guai->query_max_jingli()/2;

        if (who->query("jym_level/level") > 30 ){         guai->set("max_qi",maxqi);}
        if (who->query("jym_level/level") > 80 ){         guai->set("max_qi",maxqi*2);}
        if (who->query("jym_level/level") < 31 ){         guai->set("max_qi",maxqi/2);}
        guai->set("qi",guai->query_max_hp());
        guai->set("eff_qi",guai->query_max_hp());
   guai->set_temp("maxqi",maxqi);

   guai->set("max_jing",maxjing);
   guai->set("eff_jing",maxjing);
   guai->set("jing",maxjing);

   return 1;
}

//杀怪得到的exp,与玩家的skills ,exp,turn 有关
int getexp(int turn,int level,object who)
{
        int exp,userexp;
        userexp=who->query("combat_exp");
        if(turn<1) turn =1;
  exp=random(1000)+turn*2000+(userexp/5000)*turn+(level*level/2000)*turn*100;
        return exp;
}

