string ask_shibai() {
  object me;
  int i, money;
  me = this_player();
  i = me->query("potential");
  money = me->query("jym_money");

  if (!me->query_temp("kill"))
    return "你没有领任务,跑这里瞎嚷嚷什麽?\n";
  me->start_busy(10);

  if (money < 51)
    return "你钱庄里的存款不够了!\n";

  if (me->query("potential") - (int)me->query("learned_points") <= 800)
    return "你的pot不够取消任务了!\n";

  me->add("jym_money", -50);
  me->add("potential", -800);
  me->delete_temp("kill");

  return HIY "我看错你了，我只能找别人了,扣你800点POT和50枚元宝.\n" NOR;
}

void unconcious() {
  reincarnate();
  set("eff_qi", this_object()->query_max_hp());
  set("qi", this_object()->query_max_hp());
  set("eff_jing", this_object()->query_max_jing());
  set("jing", this_object()->query_max_jing());
  set("jingli", query("eff_jingli"));
  say("方舟突然出现在你的面前，说道你怎么可以杀死我的手下呢 ？！\n");
}

void die() {
  unconcious();
}
