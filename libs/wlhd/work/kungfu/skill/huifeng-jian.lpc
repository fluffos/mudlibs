// By jerry@ty
inherit SKILL;
string type() { return "zhongji"; }
int tydamage = this_player()->query("tydamage/sword")?this_player()->query("tydamage/sword"):this_player()->query_skill("huifeng-jian");

// 第一个等级400级以前的描述，和攻击力
