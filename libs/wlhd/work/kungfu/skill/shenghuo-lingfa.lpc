#include <ansi.h>

inherit SKILL;
string type() { return "zhongji"; }
int tydamage = this_player()->query("tydamage/sword")?this_player()->query("tydamage/sword"):this_player()->query_skill("shenghuo-lingfa");

mapping *action = ({
([      "action" : "$N将手中$w横挥，一式「横扫千军」，$w带出一股风声，疾驶向$n的咽喉",
        "skill_name" : "横扫千军",
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
    "lvl" : 77,
    "damage_type" : "刺伤"
]),
([      "action" : "$N双手持$w举过头顶，猛然挥出「"HIC"天降神兵"NOR"」只见一股强劲的气浪随$w自空而降，袭向$n",
        "skill_name" : "天降神兵",
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
        "lvl" : 60,
        "damage" : 150,
        "damage_type" : "内伤",
]),
([      "action" : RED"$N脚下走出怪异步法顿时好似有无数个$N将那无数的$w"NOR RED"斩向$n的头颅，这着唤做「"HIC"天阵伏魔"NOR RED"」"NOR,
        "skill_name" : "天阵伏魔",
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "lvl" : 60,
        "damage" : tydamage,
        "damage_type" : "劈伤",
]),
([      "action" : HIR"只见$N挥力太猛，$w当空坠落，$N急忙俯身去接\n$n看到如此大好时机，岂肯放过，一步抢入准备施展手段\n$n怎知这正中了圣火令法的绝招「偃旗息鼓」，只见$N突然一个鹞子翻身，\n$n只感到胸口冰凉，看时已是$w"HIR"插入了心脏处！"NOR,
        "skill_name" : "偃旗息鼓",
        "lvl" : 60,
        "force" : 560,
        "dodge" : 280,
        "parry" : 240,
        "damage" : tydamage,
        "damage_type" : "刺伤",
]),
});


int valid_enable(string usage) { return usage == "sword"; }

int valid_learn(object me)
{
        object weapon;

        if ((int)me->query_skill("shenghuo-shengong", 1) < 30)
                return notify_fail("你对圣火心法的领悟不够，无法学圣火令法。\n");
        if (me->query("family/master_id")!="zhang wuji")
        return notify_fail("圣火令法是张无忌的功夫，其他师傅参悟还来不及，怎能教你？\n");
    if ((int)me->query("max_neili") < 20000)
        return notify_fail("你的内力不够。\n");
    if (me->query_skill("sword", 1) <=me->query_skill("shenghuo-lingfa",1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
        return 1;
}
mapping query_action(object me, object weapon)
{
        int i, level;
    level   = (int) me->query_skill("shenghuo-lingfa",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
      if( damage_bonus < 110 ) return 0;

 //  第六等级的伤气
      if( me->query_skill("shenghuo-lingfa",1)>4000
  && me->query("jym_level/level")>=25  ) {
              victim->receive_damage("qi", (damage_bonus ) * 2 , me);
return WHT  "$N领悟了圣火令法，顿时手中剑光暴起，一股无形剑气已然穿过$n的身体！！！！！\n" NOR;
  }      

 //  第五等级的伤气
      if( me->query_skill("shenghuo-lingfa",1)>3000
  && me->query("jym_level/level")>=15 ) {
              victim->receive_damage("qi", damage_bonus  , me);
return YEL "$N领悟了圣火令法，顿时手中剑光暴起，一股无形剑气已然穿过$n的身体！！！！\n" NOR;
  }      
      if( damage_bonus < 100 ) return 0;

 //  第四等级的伤气
      if( me->query_skill("shenghuo-lingfa",1)>2000
  && me->query("jym_level/level")>=10 ) {
           victim->receive_damage("qi", (damage_bonus - 100)  , me);
return MAG "$N领悟了圣火令法，顿时手中剑光暴起，一股无形剑气已然穿过$n的身体！！！！！\n" NOR;
  }      


 //  第三等级的伤气
      if( me->query_skill("shenghuo-lingfa",1)>1000
  && me->query("jym_level/level")>=4 ) {
                victim->receive_damage("qi", (damage_bonus - 100) / 3 , me);
return CYN "$N的圣火令法已入返璞归真境界，随意一剑化处无形剑气扑向$n！！！！！\n" NOR;
  }      
 // 第二等级的伤气
        if ( me->query_skill("shenghuo-lingfa",1)>400 
  && me->query("jym_level/level")>=2        ) {
             victim->receive_damage("qi", (damage_bonus - 100) / 8 , me);
return RED "只听见「唰」一声，$N手中长剑已经从$n的后背穿出！！！！！\n" NOR;
}  
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够，练不了圣火令法。\n");
        if ((int)me->query("neili") < 600)
                return notify_fail("你的内力不够练圣火令法。\n");
        me->receive_damage("qi", 30);
        me->add("neili", -10);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"shenghuo-lingfa/" + action;
}


