// chan.c 太极剑法「缠」字诀
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int time;
  object weapon;
  string msg;
  int busy;
  busy = (int)me->query_skill("killsword") / 40;
  if (busy > 20) busy = 20;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("冤魂缠身只能对战斗中的对手使用。\n");
  if ((string)me->query("family/family_name") != "白驼山派")
    return notify_fail("只有白驼山弟子才能使用该PFM。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "sword")
      return notify_fail("你使用的武器不对。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧ⅵ\n");

  if ((int)me->query_skill("killsword", 1) < 80)
    return notify_fail("你的杀手剑不够娴熟，不会使用「冤魂缠身」。\n");
  if (me->is_busy()) return notify_fail("你现在正忙着。\n");
  if (!me->visible(target)) return notify_fail("你看不到" + target->name() + "。\n");
  msg = HIG "$N使出杀手剑的「冤魂缠身」剑法，召唤剑上冤魂压制着$n\n";
  me->start_busy(2);
  if (random(me->query_exp() * 5) > target->query_exp()) {
    msg += HIR " 结果$p被$P攻了个措手不及！\n" NOR;
    target->start_busy(busy);
  } else {
    me->start_busy(2);
    msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);
  return 1;
}
