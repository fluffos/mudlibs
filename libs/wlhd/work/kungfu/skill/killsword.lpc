int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
int valid_learn(object me)
{
me=this_player();
        if (me->query("family/master_id")!="ouyang feng")
        return notify_fail("杀手剑是欧阳锋所创，其他师傅参悟还来不及，怎能教你？\n");
if(me->query_skill("force")<500)
return notify_fail("你的基本内功修为不够学杀手剑！\n");
    if ((int)me->query("max_neili") < 20000)
        return notify_fail("你的内力不够。\n");
if(me->query_skill("sword")<500)
return notify_fail("你的基本剑术不够学杀手剑！\n");
    if (me->query_skill("sword", 1) <=me->query_skill("killsword", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level;
    level   = (int) me->query_skill("killsword",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
      if( damage_bonus < 110 ) return 0;
      if( me->query("neili") < 50000   ) return 0;
      if( random(10) < 2   ) return 0;

 //  第六等级的伤气
      if( me->query_skill("killsword",1)>4000
  && me->query("jym_level/level")>=25  ) {
              victim->receive_damage("qi", (damage_bonus ) * 2 , me);
return WHT  "$N手下剑势猛的加强，只听『波』的一声，『杀手剑』的剑气已将$n五脏震伤！！！\n" NOR;
  }      

 //  第五等级的伤气
      if( me->query_skill("killsword",1)>3000
  && me->query("jym_level/level")>=15 ) {
              victim->receive_damage("qi", damage_bonus  , me);
return YEL "$N手下剑势猛的加强，只听『波』的一声，『杀手剑』的剑气已将$n五脏震伤！！！\n" NOR;
  }      
      if( damage_bonus < 100 ) return 0;

 //  第四等级的伤气
      if( me->query_skill("killsword",1)>2000
  && me->query("jym_level/level")>=10 ) {
           victim->receive_damage("qi", (damage_bonus - 100)  , me);
return MAG "$N手下剑势猛的加强，只听『波』的一声，『杀手剑』的剑气已将$n五脏震伤！！！\n" NOR;
  }      


 //  第三等级的伤气
      if( me->query_skill("killsword",1)>1000
  && me->query("jym_level/level")>=4 ) {
                victim->receive_damage("qi", (damage_bonus - 100) / 3 , me);
return CYN "$N手下剑势猛的加强，只听『波』的一声，『杀手剑』的剑气已将$n五脏震伤！！！\n" NOR;
  }      
 // 第二等级的伤气
        if ( me->query_skill("killsword",1)>400 
  && me->query("jym_level/level")>=2        ) {
             victim->receive_damage("qi", (damage_bonus - 100) / 8 , me);
return RED "只听『波』的一声，『杀手剑』的剑气已将$n五脏震伤！！！\n" NOR;
}
}

int practice_skill(object me)
{
        object weapon;


        if(this_player()->query_skill("hamagong")<100)
        return notify_fail("你还要在蛤蟆功上有所加强！\n");
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练杀手剑！\n");
        me->receive_damage("qi", 25);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"killsword/" + action;
}



