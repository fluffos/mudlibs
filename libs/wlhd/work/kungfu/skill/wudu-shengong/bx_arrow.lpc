inherit F_SSERVER;

int exert(object me, object target) {

  int success, ap, dp, dj, my_combat_exp, dj2, exp2;


  if (!target) target = offensive_target(me);
  if (target == me) target = offensive_target(me);

  if (!me->is_fighting())
    return notify_fail("碧血箭只能在战斗中使用。\n");

  if ((string)me->query("family/family_name") != "五毒教")
    return notify_fail("「" HIR "碧血箭" NOR "」只有五毒教弟子才能使用。\n");


  if (!objectp(target) || target->query("id") == "mu ren")
    return notify_fail("你要对谁施展碧血箭？\n");

  if ((int)me->query("qi") < 20000)
    return notify_fail("你的身体状况太差，不能有效施展碧血箭！\n");

  if ((int)me->query("max_neili") < 15000)
    return notify_fail("你的内力不够，不能有效施展碧血箭！\n");

  if ((int)me->query("max_jingli") < 15000)
    return notify_fail("你的精力不够，不能有效施展碧血箭！\n");

  if ((int)me->query_skill("force", 1) < 100
    || (int)me->query_skill("wudu-shengong", 1) < 1200)
    return notify_fail("你的内功修为不够，不能有效施展碧血箭！\n");

  if ((int)me->query("zjb_dj/dj") < (int)target->query("query_dj/dj") / 3)
    return notify_fail("对方武功强你好几倍，不会有用的，还是快跑吧！\n");

  message_vision(HIC
    "$N双目血红，披头散发，仰天发出一声悲啸！\n\n$N把心一横，在自己舌尖狠命一咬，将毕生功力化做一道奇毒血箭向$n喷了过去！\n" NOR, me, target);

  dj = me->query("zjb_dj/dj"); if (dj > 1) {
    if (dj == 2) my_combat_exp = (int)me->query("combat_exp") + 10000000;
    if (dj == 3) my_combat_exp = (int)me->query("combat_exp") + 30000000;
    if (dj == 4) my_combat_exp = (int)me->query("combat_exp") + 60000000;
    if (dj == 5) my_combat_exp = (int)me->query("combat_exp") + 100000000;
    if (dj == 6) my_combat_exp = (int)me->query("combat_exp") + 150000000;
    if (dj == 7) my_combat_exp = (int)me->query("combat_exp") + 210000000;
    if (dj == 8) my_combat_exp = (int)me->query("combat_exp") + 280000000;
    if (dj == 9) my_combat_exp = (int)me->query("combat_exp") + 360000000;
    if (dj == 10) my_combat_exp = (int)me->query("combat_exp") + 450000000;
    if (dj > 10)
      my_combat_exp = (int)me->query("combat_exp") + (450000000 + ((dj - 10) * 100000000));
  } else {
    my_combat_exp = (int)me->query("combat_exp");
  }

  dj2 = target->query("zjb_dj/dj");
  if (dj2 > 1) {
    if (dj2 == 2) exp2 = (int)target->query("combat_exp") + 10000000;
    if (dj2 == 3) exp2 = (int)target->query("combat_exp") + 30000000;
    if (dj2 == 4) exp2 = (int)target->query("combat_exp") + 60000000;
    if (dj2 == 5) exp2 = (int)target->query("combat_exp") + 100000000;
    if (dj2 == 6) exp2 = (int)target->query("combat_exp") + 150000000;
    if (dj2 == 7) exp2 = (int)target->query("combat_exp") + 210000000;
    if (dj2 == 8) exp2 = (int)target->query("combat_exp") + 280000000;
    if (dj2 == 9) exp2 = (int)target->query("combat_exp") + 360000000;
    if (dj2 == 10) exp2 = (int)target->query("combat_exp") + 450000000;
    if (dj2 > 10)
      exp2 = (int)target->query("combat_exp") + (450000000 + ((dj2 - 10) * 100000000));
  } else {
    exp2 = (int)target->query("combat_exp");
  }
  success = 1;
  ap = me->query_skill("force", 1) + me->query_skill("wudu-shengong", 1);
  ap = ap / 2;
  ap = ap * ap * ap / 10;
  ap = ap + my_combat_exp;
  //      ap = ap * ap;          
  dp = exp2;
  //     dp = dp * dp;
  if (random(ap + dp) < random(dp)) success = 0;

  ap = (int)me->query("max_neili");
  dp = (int)target->query("max_neili");
  if (ap < random(dp)) success = 0;

  if (success == 1) {
    message_vision(HIR "结果$n促不及防被血箭射个正着，顿时发出一声惨叫！\n$N见状哈哈大笑一声，眼前一黑倒在地上。\n" NOR, me, target);

    target->kill_ob(me);
    me->kill_ob(target);
    me->add("max_neili", -10000);
    me->add("max_jingli", -10000);
    me->save();

    target->receive_wound("qi", (int)target->query("max_qi") + 1, me);
    target->receive_wound("jing", (int)target->query("max_jing") + 1, me);
    COMBAT_D->report_status(target);

    me->receive_wound("qi", (int)me->query("max_qi") + 1, target);
    me->receive_wound("jing", (int)me->query("max_jing") + 1, target);
    COMBAT_D->report_status(me);

  }

  else {
    message_vision(HIR "但是血箭被$n内力反震，化做一蓬血雾四散飘去！\n$N一声惨笑，长叹一声，眼前一黑倒在地上。\n" NOR, me, target);

    target->kill_ob(me);
    me->kill_ob(target);

    me->add("max_neili", -50);
    me->add("max_jingli", -50);
    me->save();
    me->start_busy(5);

    me->receive_wound("qi", (int)me->query("max_qi") + 1, target);
    me->receive_wound("jing", (int)me->query("max_jing") + 1, target);
    COMBAT_D->report_status(me);
  }

  //      return 3+random(5);
  return 1;
}
