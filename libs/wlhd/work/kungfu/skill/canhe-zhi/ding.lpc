#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;

    if( !target ) target = offensive_target(me);


    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「一指定天下」只能在战斗时使用。\n");

    if( (int)me->query_skill("canhe-zhi", 1) < 500 )
          return notify_fail("你的「参合指」还不够精纯，无法使用「一指定天下」！\n");


 if ( (string)me->query("family/family_name") != "姑苏慕容") 
       return notify_fail("「一指定天下」乃姑苏慕容家绝技，外人不便施展。。\n");


    if( (int)me->query("max_neili") < 50000 )
           return notify_fail("你的内力修为还不够高。\n");

    if( (int)me->query("neili") < 6100 )
           return notify_fail("你的内力不够了。\n");

    if( me->query_temp("weapon"))
                return notify_fail("你先放下手中的武器再说吧？！\n");     

    msg = HIY "
$N急进一步，乘势一指刺出，这一指凝聚$N一身精纯内力，大有君临天下之威！！\n"NOR;

if( random(me->query_skill("canhe-zhi",1)+me->query_skill("unarmed",1)) > target->query_skill("unarmed",1)) { 
      me->start_busy(1);
   target->start_busy(random(2));

damage = (int)me->query_skill("canhe-zhi", 1)*5+(int)me->query_skill("force",1)*2;

   damage = damage + random(damage);
if (damage<target->query("max_qi",1)/8 && me->query("max_neili",1) > target->query("max_neili",1)/2) damage = random (target->query("max_qi",1)/6);

if (damage>target->query("max_qi",1)/3) damage = random (target->query("max_qi",1)/4);
   target->receive_damage("qi", damage);
   target->receive_wound("qi", damage/2);
   me->add("neili", -6000);
   msg += HIR"$n被$N气势所摄，眼睁睁看着这一指点在自己心口，顿时喷出一口鲜血，元气大伤！\n"NOR;
                message_vision(msg, me, target);
      COMBAT_D->report_status(target);    
        return 1;

    } 
     else
    {
       me->start_busy(1);
           me->add("neili",-200);        
       msg += HIY"$n见此招来势如此凶猛，忙抽身跃起，连变数种身法，堪堪躲了开去。\n"NOR;
    }
    message_vision(msg, me, target);

    if(!target->is_fighting(me)) target->fight_ob(me);
    return 1;
}

