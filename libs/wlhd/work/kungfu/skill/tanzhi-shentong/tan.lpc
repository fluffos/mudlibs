// tan.c  弹字诀

//create bye cuer

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)

{

        int damage;

        string msg;

        object obj; 

        int kill=0;

        

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() )

                return notify_fail("暗器射敌只能对同地方的对手使用。\n");
           if((int)target->query("mud_age") <= 1728000 && userp(target)) 
           return notify_fail("为了世界更美好，放过小孩子吧.\n"); 
          
         if((int)target->query("zjb_dj/dj")*2 < (int)me->query("zjb_dj/dj"))          
           return notify_fail("暗器伤人，非高手本色！\n"); 
        if( !present("tie lianzi",me))
                return notify_fail("你身上没有带铁莲子，还想暗算人？\n");

        if( (int)me->query_skill("tanzhi-shentong", 1) < 400 )
                return notify_fail("你的弹指神通不够娴熟，不会使用「弹字诀」。\n");

        if ( (string)me->query("family/family_name") != "桃花岛") 
                return notify_fail("只有桃花岛弟子才能使用该PFM。\n");

        if( (int)me->query("neili", 1) < 50000 )

                return notify_fail("你现在内力太弱，不能发射铁莲子。\n");

        msg = CYN "突然从暗处射出一发铁莲子，击向$n。\n"NOR;

        if (random(me->query_skill("tanzhi-shentong")) > target->query_skill("dodge")/6 )

        {

                me->start_busy(1);

                target->start_busy(1+random(1));

                 damage = (int)me->query_skill("tanzhi-shentong", 1);

                damage = damage/2 + random(damage);

                target->receive_damage("qi", damage);


                target->receive_wound("jing", damage/2);

                me->add("neili", -45500);

                 msg += HIR"结果$n被铁莲子射中，惨叫一声，身子一歪，退后丈许！！\n"NOR;

        }

        else

        {

                me->start_busy(1);     

                target->start_busy(random(1));

                me->add("neili",-40000);

                msg += CYN"可是$p看到了$N发射的铁莲子，躲开了。\n"NOR;

        }                                    

       if(random(me->query("zjb_dj/dj")*2)>(int)target->query("zjb_dj/dj")&& random(10)>6)

        { 

                msg += CYN"$p没有发现铁莲子的来源！\n"NOR;

        }                                                 

        else

        { 
               msg += HIW"可是$p看到了发射铁莲子的人是$N。\n"NOR;
                kill = 1;                
        }
        message_vision(msg, me, target);

        obj = present("tie lianzi",me);

        obj->add_amount(-1);
log_file("nosave/tanzhiid",sprintf("%s打 %s,(%s)\n",
me->query("id") , target->query("id") , 
"/cmds/usr/rtime.lpc"->chinese_time(5,ctime(time())) ) );
        if(kill==1)

           target->kill_ob(me);

if (userp(target))
{ 
me->set("combat_zjb",""+target->query("id")+"");
}


        return 1;

}


