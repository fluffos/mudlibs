inherit SKILL;
string type() { return "zhongji"; }
int tydamage = this_player()->query("tydamage/blade")?this_player()->query("tydamage/blade"):this_player()->query_skill("taiji-dao");

mapping *action = ({
([      "action" : "$N手中$w斜指，一招「停车问路」，反身一顿，一刀向$n的$l撩去",
        "force" : 560,
        "dodge" : 380,
        "parry" : 340,
        "damage" : tydamage,
        "lvl" : 30,
        "damage_type" : "割伤"
]),
([      "action" : "$N一招「童子挂画」，左右腿虚点，$w一提一收，平刃挥向$n的颈部",
        "force" : 560,
        "dodge" : 380,
        "parry" : 340,
        "damage" : tydamage,   "lvl" : 50,
        "damage_type" : "割伤"
]),
([      "action" : "$N展身虚步，提腰跃落，一招「"HIC"推窗望月"NOR"」，刀锋一卷，拦腰斩向$n",
        "force" : 560,
        "dodge" : 380,
        "parry" : 340,
        "damage" : tydamage,   "lvl" : 100,
        "damage_type" : "割伤"
]),
([  "action" : "$N一招「"YEL"开门见山"NOR"」，$w大开大阖，自上而下划出一个大弧，笔直劈向$n",
        "force" : 560,
        "dodge" : 380,
        "parry" : 340,
        "damage" : tydamage,   "lvl" : 120,
    "damage_type" : "割伤"
]),
([      "action" : "$N手中$w一沉，一招「"WHT"临溪观鱼"NOR"」，双手持刃拦腰反切，砍向$n的胸口",
        "force" : 560,
        "dodge" : 380,
        "parry" : 340,
        "damage" : tydamage,   "lvl" : 150,
        "damage_type" : "割伤"
]),
([      "action" : RED"$N挥舞$w"NOR RED"，使出一招「"HIY"张弓望的"NOR RED"」，上劈下撩，左挡右开，齐齐罩向$n"NOR,
        "force" : 560,
        "dodge" : 380,
        "parry" : 340,
        "damage" : tydamage,
        "lvl" : 1001, 
        "damage_type" : "割伤"
]),
([      "action" : HIB"$N一招「"HIR"风送轻舟"HIB"」，左脚跃步落地，$w"HIB"顺势往前，挟风声劈向$n的$l"NOR,
        "force" : 560,
        "dodge" : 380,
        "parry" : 340,
        "damage" : tydamage,
        "lvl" : 1100, 
        "damage_type" : "割伤"
]),
([  "action" : WHT"$N盘身驻地，一招「"HIB"川流不息"NOR WHT"」，挥出一片流光般的刀影，向$n的全身涌去"NOR,
        "force" : 560,
        "dodge" : 380,
        "parry" : 340,
        "damage" : tydamage,
     "lvl" : 1100, 
    "damage_type" : "割伤"
]),
});

int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }

int practice_skill(object me)
{
    return notify_fail("太级刀法只能通过「"+HIC+"玄字决"+NOR+"」来演练。\n");
}
mapping query_action(object me, object weapon)
{
        int i, level;
    level   = (int) me->query_skill("taiji-dao",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}
int valid_learn(object me)
{ 
        if (me->query_skill("taiji-dao")< 250 && me->query("family/master_id")!="zhang sanfeng")
        return notify_fail("太极刀是武当绝技，非张三丰弟子怎可教导？\n");
    if ((int)me->query("max_neili") < 1000)
        return notify_fail("你的内力不够。\n");
    if (me->query_skill("blade", 1) <=me->query_skill("taiji-dao", 1))
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    if ((int)me->query_skill("taiji-dao",1) > 150)
        return notify_fail("这套刀法只可以学到250级，以后要靠使用玄字决来提高了。\n"); 
     if ((int)me->query_skill("taiji-shengong", 1) < 50)
        return notify_fail("你的太级神功火候不够，无法学太级刀法。\n");
    return 1;
} 
mixed hit_ob(object me, object victim, int damage_bonus)
{
      if( damage_bonus < 110 ) return 0;

 // 第二等级的伤气
        if ( me->query_skill("taiji-dao",1)>400
         && me->query_skill("taiji-dao",1)<1001
&& (me->query("neili")*3) > victim->query("max_neili") ) {
             victim->receive_damage("qi", (damage_bonus - 100) / 2 , me);
return HIW "$N的"HIG"太极刀法"HIW"已初有小成,带出一小阵"HIG"柔劲"HIW"扑向$n！！\n" NOR;
}

 //  第三等级的伤气
        if( me->query_skill("taiji-dao",1)>1000
       && me->query("jym_level/level")>=5
&& (me->query("neili")*3) > victim->query("max_neili") ) {
       victim->receive_damage("qi", (damage_bonus - 100) * 2 , me);
return HIR "$N的"BLINK HIW"太极刀法"NOR HIR"已入返璞归真境界，随意一刀带动数个"BLINK HIW"太极圆意"NOR HIR"震毁$n的真元！！！\n" NOR;
  }      
}

string perform_action_file(string action)
{
    return __DIR__"taiji-dao/" + action;
}


