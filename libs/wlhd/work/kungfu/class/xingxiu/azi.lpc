//wang.c

inherit NPC;

void create()
{
        set_name("阿紫", ({ "azi" }));
        set("long", "她生得极为美貌,一双眼睛顾盼生辉.\n");
        set("nickname", "星宿派小师妹"); 
        set("gender", "女性");
        set("age", 20);
        set("attitude","friendly");
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("no_get", 1);
        set("max_qi", 5000);
        set("max_jing", 1000);
        set("jingli", 15000);
        set("max_neili", 8000);
        set("max_jingli", 8000);

        setup();

}


void kill_ob(object ob)
{
        ob->remove_killer(this_object());
        remove_killer(ob);
        command("peace " + ob->query("id"));
}
void die()
{
        set("eff_qi",this_object()->query_max_hp());
        set("qi",this_object()->query_max_hp());
        set("eff_jing",this_object()->query_max_jing());
        set("jing",this_object()->query_max_jing());
        set("jingli", query("eff_jingli")); 
       set("max_neili",7000); 
      set("max_jingli",7000); 

command("say 不好意思，我是不死身\n");
}
void unconcious()
{
        set("eff_qi",this_object()->query_max_hp());
        set("qi",this_object()->query_max_hp());
        set("eff_jing",this_object()->query_max_jing());
        set("jing",this_object()->query_max_jing());
        set("jingli", query("eff_jingli")); 
       set("max_neili",7000); 
      set("max_jingli",7000); 

command("say 不好意思，我是不死身\n");
}


