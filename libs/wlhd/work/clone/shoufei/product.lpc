//函数：根据类型，开始等级，结束等级，随机选择合适的item路径返回。
string get_random_level_product(int type,int begin, int end)
{
	mapping *product,items;
	int i,size,size2,*key,size3;
	string *get_item = ({ }),file;
	
	//判断类型
	switch(type)
	{
		case 1: product  = armor_list; break;
		case 2: product  = boots_list; break;
		case 3: product  = cloth_list; break;
		case 4: product  = head_list; break;
		case 5: product  = waist_list; break;
		case 6: product  = neck_list; break;
		case 7: product  = blade_list; break;
		case 8: product  = sword_list; break;
		case 9: product  = pike_list; break;
		case 10: product = club_list; break;
		case 11: product = staff_list; break;
		case 12: product = throwing_list; break;
		case 13: product = hammer_list; break;
		case 14: product = whip_list; break;
		case 15: product = axe_list; break;
		case 16: product = xiao_list; break;
	}
	//注意16种类型。
	if(!product) return "";

	//等级校正
	begin = (begin/10)*10;
	end = (end/10)*10;

	if(begin < 0) begin = 0;
	if(end < 0) end = 0;

	if(begin > 120) begin = 120;
	if(end > 120) end = 120;
	
	//防止开始大于结束
	if (begin>end) begin = end;

	//随机选择 item 组
	size = sizeof(product);
	items = product[random(size)];

	//找出合适的 item 路径
	key = keys(items);
	size2 = sizeof(key);
	for(i=0;i<size2;i++)
	{
		if(key[i] >= begin && key[i] <= end )
		{
			get_item += ({ items[key[i]] });
		}
	}

//if(find_player("rock")) tell_object(find_player("rock"),sprintf("DEBUG: product: get_item = %O size3 = %d \n",get_item,size3));

	//随机返回正确的 item 路径
	if(!get_item) return "";
	size3 = sizeof(get_item);
	if(size3) file = get_item[random(size3)];
	else return "";
	if(file) return file;
}
