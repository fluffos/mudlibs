inherit ITEM;

void create() {
  set_name(HIW "耗子的化石" NOR, ({ "daniel shi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("points", 2);
  set("value", 200000);
  //   set("no_put",1);
  //   set("no_give",1);
  set("zhongji_hc", 1);
  set("int", 25);
  set("str", 35);
  set("dex", 20);
  set("con", 30);
  set("bh", 2);
  set("damage", 250);
  set("long", "这是一个差不多绝种的金属，可以用来合成兵器!(help hecheng)\n");

  setup();
}
