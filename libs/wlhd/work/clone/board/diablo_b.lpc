// /clone/board/diablo_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name(HIB"暗黑发言板"NOR,({"board"}));
        set("location","/u/system_2/diablo");
        set("board_id", "system_2_b");
        set("long","小P立的暗黑板，给喜欢暗黑破坏神的朋友们交流用。\n");
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}

