inherit SKILL;
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
    int damage;
    me->add("neili", - factor );
    damage = (int)me->query("neili")/100 + factor - (int)victim->query("neili")/100;
    if( damage < 0 ) {
        if( !me->query_temp("weapon")
        &&  random(me->query_skill("force")) < victim->query_skill("force") ) {
            damage = - damage;
            me->receive_damage( "qi", damage * 2,victim );
            me->receive_wound( "qi", damage ,victim);
            if( damage < 10 ) return "$N受到$p的内力反震，闷哼一声。\n";
            else if( damage < 20 ) return "$N被$p以内力反震，「嘿」地一声退了两步。\n";
            else if( damage < 40 ) return "$N被$p以内力一震，胸口有如受到一记重锤，连退了五六步！\n";
            else return "$N被$p的内力一震，眼前一黑，身子向后飞出丈许！！\n";
        }
    }
    if( damage_bonus + damage < 0 ) return 0;
        return 0;
}
mixed armor_ob(object me, object victim, int damage_bonus,int force_armor)
{
// 金刚不败护体神功  By rock 
int i;
   if (!living(victim) || damage_bonus<0) return damage_bonus;
if(victim->query_skill("buddhism-force", 1) > 300
&& random(victim->query_skill("buddhism-force", 1)*2+victim->query_skill("dodge",1))
>me->query_skill("dodge",1)
&& random(victim->query_skill("buddhism-force", 1)*2)>victim->query_skill("buddhism-force", 1)
&&victim->query("neili")>(victim->query_max_neili()/2)
&& victim->query_skill_mapped("force") == "buddhism-force"){

i=victim->query("neili");
if(me->query("neili") < i) {
            me->receive_damage( "qi", victim->query_skill("force",1) * 3,victim );
            me->receive_wound( "qi", victim->query_skill("force",1) ,victim );
victim->add("neili",-damage_bonus);
return HIR"$N的内力不够雄厚，被$n的" BLINK HIW"金刚不败护体神功"NOR HIR"震汇了$N的"BLINK HIB"真元"NOR HIR"!!!!\n"NOR;
}

if(me->query("neili") >= i){ 
victim->add("neili",-damage_bonus);
return HIW"$n内力深厚,催动" BLINK HIR"金刚不败护体神功"NOR HIW"抵御了$N的"BLINK HIB"攻击"NOR HIW"!!!!\n"NOR;
}

}

if (victim->query_skill_mapped("force") == "buddhism-force"&&victim->query("neili")<(victim->query_max_neili()/2))
{
message_vision(HIW"$N的内力不够无法催动" BLINK HIR"金刚不败护体神功"NOR HIW"，遭到了$n的"BLINK HIB"猛烈攻击"NOR HIW"!!!!"NOR,victim,me);
}

   if (victim->query("neili") >= force_armor &&victim->query_skill_mapped("force") != "buddhism-force")
 if (force_armor > damage_bonus&&victim->query_skill_mapped("force") != "buddhism-force"){
            victim->add("neili",-damage_bonus);
                return BOLD "$p用"+to_chinese(victim->query_skill_mapped("force"))+"的护体真气化解了$N的伤害！\n" NOR;
        }else{
            message_vision( BOLD "\n$p催动"+to_chinese(victim->query_skill_mapped("force"))+"的护体真气试图削弱$N的伤害！" NOR,me,victim);
            victim->add("neili",force_armor);
            return damage_bonus-force_armor;
        }
        return damage_bonus;
}

