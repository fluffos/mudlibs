// 装备修理员
inherit NPC;

void create()
{
	set_name("修理员", ({ "xiu li" }));

	set("gender", "男性");
	set("age", 16);
	set("per", 25);
	set("con", 25);
	set("int", 25);
	set("dex", 25);
	set("str", 25);
	set("title",HIM"修理装备"NOR);
	set("long","我可以为你修理装备，你想修理什么装备呢？\n");
	set("no_kill",1);
	set("inquiry", ([
		"修理装备" : "修理装备指令：xiu<需要修理装备ID>\n",
	]));
	setup();
	carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
        add_action("do_xiu", "xiu");
}

int do_xiu(string age)
{
	object me,npc,item;
	int gold;
	me = this_player();
	npc = this_object();
	
	if(!age || age == " ")
	{
		tell_object(me,"你想修理什么装备呢？\n");
		return 1;
	}
	if(!item = present(age,me))
	{
		tell_object(me,"你身上没有这件物品。\n");
		return 1;
	}
	if(item->query("max_lasting") > 20000)
	{
		tell_object(me,"这件装备毫无瑕疵，无法为你修理。\n");
		return 1;
	}
	gold = me->query("jym_money");
	//1元宝
	if(gold < 1)
	{
		tell_object(me,"抱歉你的存款不足1元宝，无法为你修理。\n");
		return 1;
	}
	me->set("money",gold-1);
	item->add("max_lasting",500);
	item->delete("long");
	item->init();
	tell_object(me,"装备修理完成，请look <装备ID> 察看耐久度。\n");
	return 1;
}