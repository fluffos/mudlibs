inherit ITEM;
void create()
{
        set_name(HIY"千年雪莲"NOR, ({ "qiannian xuelian","xuelian"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一颗雪莲!\n");
                set("unit", "颗"); 
                set("no_get",1);
                set("no_drop",1);             
                set("no_put",1);
                set("no_give",1);                set("value",100000000);
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_eat", "eat");
}
int do_eat(string arg)
{
  object me = this_player();
  int maxneili,neili;
    neili = me->query("neili");
    maxneili = me->query_max_neili();
    
  if(!id(arg)) return 0;
  if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

    
    me->add("max_neili",100);  
    
  message_vision(HIY"$N拿起雪莲吃了下去,感觉内力最大值增加了100点。\n"NOR,me);
       destruct(this_object());
       return 1;
}
 int move(object me)
{  
  me = this_player();
    if(query("zhuren")) {
  if (query("zhuren")!=me->query("id")) { 
message_vision(HIY"因为你不是该物品的主人,该物品自动消失了。\n"NOR,me);  
destruct(this_object());
  }
}
  set("zhuren",""+me->query("id")+"");            
return ::move(me);
}

