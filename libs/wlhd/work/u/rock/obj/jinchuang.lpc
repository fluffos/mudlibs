// jinchuang.c 金创药
inherit ITEM;
void setup()
{}
void init()
{
        if (this_player()==environment())
                add_action("do_eat", "eat");
}
void create()
{
        set_name("金创药", ({"jinchuang yao", "yao", "jinchuang"}));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "包");
                set("long", "这是一包武林人士必备的金创药。\n");
                set("value", 5000);
               set("drop", 1);
    set("ty_del", 1);
    set("no_put", 1);
        }
        setup();
}
int do_eat(string arg)
{
        if (!id(arg))
                return notify_fail("你要吃什么药？\n");
        if ( !this_player() ) return 1;
        if ((int)this_player()->query("eff_qi") == 
            (int)this_player()->query_max_hp())
           return notify_fail("你现在不需要用金创药。\n");
        else {
                this_player()->receive_curing("qi", this_player()->query_max_hp()/5);
                message_vision("$N吃下一包金创药，气色看起来好多了。\n", this_player());
                destruct(this_object());
                return 1;
        }
}

