#include <ansi.h>

inherit EQUIP;

void create()
{
        set_name( HIW "智"HIG"慧"HIY"皇"HIC"冠" NOR, ({ "zhihui huangguan","huangguan","zhihui" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
                set("value", 3000);
                set("material", "cloth");
                set("no_give",1);
                set("no_drop",1);
                set("no_get",1);
                set("ty_paimai",1);
                set("armor_type", "head");
                set("armor_prop/intelligence", 100);
                set("armor_prop/armor", 4);
                set("wear_msg","$N戴上一顶$n。\n");
                set("remove_msg","$N将$n脱了下来。\n");
        }
}
