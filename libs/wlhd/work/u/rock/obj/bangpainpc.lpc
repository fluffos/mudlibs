// By rock&jym 
inherit NPC;
inherit F_UNIQUE;
inherit F_SAVE;
void create()
{
    seteuid(getuid());
    if(!restore()) {
    set_name("帮派使者", ({ "bangpai shizhe", "bangpai", "shizhe" }) );
    set("title", "帮派使者" );
    set("gender", "男性" );
    set("age", 35);
      set("long","这是方舟为大家写的帮派使者。\n");
    set("attitude", "heroism");
    set("generation",0);
    set("winner","NONE");
    set("str", 25);
    set("con", 25);
    set("int", 25);
    set("dex", 25);
    set("max_qi", 500);
    set("eff_qi", 500);
    set("qi", 500);
    set("max_jing", 300);
    set("jing", 300);
    set("neili", 500);
    set("max_neili", 500);
    set("jiali", 30);
    set("shen_type", 0);
    set("no_clean_up",1);
    set("combat_exp", 400000);
    set_skill("force",  160); 
    set_skill("unarmed",160);
    set_skill("sword",  160);
    set_skill("dodge",  160);
    set_skill("parry",  160);
    set("my_weapon", "/d/shaolin/obj/changjian");
    set("my_armor", "/d/city/obj/cloth");
    setup();
    carry_object("/d/shaolin/obj/changjian")->wield();
    carry_object("/d/city/obj/cloth")->wear();        
    }
    else {
          set_name(query("name"), ({ "bangpai shizhe", "bangpai", "shizhe" }));
          set("env/no_accept",1);
          set("no_get",1);
        setup();
        if( this_object()->query("my_weapon") ) carry_object(this_object()->query("my_weapon"))->wield();
        if( this_object()->query("my_armor") )  carry_object(this_object()->query("my_armor"))->wear();        
      UPDATE_D->check_user(this_object());
    }
    set("no_suck",1);
}
string query_save_file() { return DATA_DIR + "npc/" + query("banghui"); }
void init()
{
    object me = this_object();
    object ob = this_player();
    if(!query("banghui"))
set("banghui",ob->query("banghui"));
    if (base_name(environment())!=this_object()->query("startroom")) return;
    if ( me->query("winner") == ob->query("id")
      && me->query("age") <= ob->query("age")
      && time()-me->query("recover")>60){
        ob->set("eff_jing",ob->query_max_jing());
        ob->set("jing",ob->query_max_jing());
        ob->set("eff_qi",ob->query_max_hp());
        ob->set("qi",ob->query_max_hp());
        if (ob->query("neili")<ob->query_max_neili())
            ob->set("neili",ob->query_max_neili());
        if (ob->query("jingli")<ob->query_max_jingli())
            ob->set("jingli",ob->query_max_jingli());
        me->set("recover",time());
    }
    add_action("do_recopy",  "recopy");
    add_action("do_recover", "recover");
    add_action("do_chucun", "chucun");
}
int accept_fight(object ob)
{
    object me, mengzhu, fae;
    string name1, name2;
 
    me  = this_object();
       if( me->query("banghui") != this_player()->query("banghui")){
           command("say 您不是我帮派的吧?\n");
     return 0;
  }
        
   mengzhu = load_object("/d/taishan/npc/meng-zhu");
    mengzhu->restore();
    name1 = mengzhu->query("winner");
    if( this_player()->query("id")==name1 ){
        command("say 帮派使者大人，在下赏善使者怎么是您的对手？！\n");
        return 0;
    }

 fae = load_object("/d/taishan/npc/fa-e");
   fae->restore();
    name2 = fae->query("winner");
    if( this_player()->query("id")==name2 ){
        command("say 你是罚恶使者，我是帮派使者，我们打什么架？！\n");
        return 0;
    }
    fae = load_object("/d/taishan/npc/shang-shan");
    fae->restore();
    name2 = fae->query("winner");
    if( this_player()->query("id")==name2 ){
        command("say 你是赏善使者，我是帮派使者，我们打什么架？！\n");
        return 0;
    }
  fae = load_object("/d/taishan/npc/xinxiu");
    fae->restore();
    name2 = fae->query("winner");
    if( this_player()->query("id")==name2 ){
        command("say 你是新秀使者，我是帮派使者，我们打什么架？！\n");
        return 0;
    }

    if ( me->query("winner") == ob->query("id") ) {
        command("say 你跟你自己打什么架？！\n");
        return 0;
    }
    if (me->is_fighting() || me->query("fighting"))
        return notify_fail("已经有人正在挑战帮派使者！\n");
    me->set("eff_qi", me->query_max_hp());
    me->set("qi",     me->query_max_hp());
    me->set("jing",   me->query_max_jing());
    me->set("neili",  me->query_max_neili());
    remove_call_out("checking");
 call_out("checking", 1, me, ob);
    
    return 1;
}
int checking(object me, object ob)
{
    int my_max_qi, his_max_qi;
    object *enemy=me->query_enemy();
    if (sizeof(enemy)>1)    return 1;
    if (!ob)    return 1;
    my_max_qi  = me->query_max_hp();
    his_max_qi = ob->query_max_hp();
    if (me->is_fighting()) {
        if ( (me->query("qi")*100 / my_max_qi) <= 80 )
            command("exert recover");
 call_out("checking", 1, me, ob);
        return 1;
    }
    if (( (int)me->query("qi")*100 / my_max_qi) <= 50 ) {
        if (!living(me))    me->revive();
command("say 果然厉害，恭喜你成为当今"+query("banghui")+"帮派使者！\n");
command("chat 哈哈哈，到底是长江後浪推前浪，一代新人换旧人！\n");
command("chat 恭喜" + ob->query("name") + "被推举为当今"+query("banghui")+"帮派使者！\n");
        me->set("fighting",1);
me->start_busy(4);
ob->start_busy(4);
        remove_call_out("do_copy");
 call_out("do_copy", 1, me, ob);
        return 1;
    }
    if (( (int)ob->query("qi")*100 / his_max_qi) < 50 ) {
        command("say 看来" + RANK_D->query_respect(ob) + 
            "还得多加练习，方能在当今武林中出人头地 !\n");
        return 1;
    }
    return 1;  
}
int do_copy(object me, object ob)
{
    seteuid(getuid());
    if (!living(me))    me->revive();
    me->add("generation", 1);   
    me->set("name",  ob->query("name") );
    
    ob->delete("party");
     ob->set("party/party_name",HIG+"第" + chinese_number(me->query("generation")) + "代"+ NOR );
     ob->set("party/rank",HIG+""+query("banghui")+"帮派使者！"+NOR);
  
       me->set("short", HIG+"第" + chinese_number(me->query("generation")) + "代"+query("banghui")+"帮派使者！"+ NOR+" " + me->query("name") + "(bangpai shizhe)");
    me->delete("title");
 
    remove_call_out("do_clone");
call_out("do_clone", 0, me, ob);
    return 1;
}
int do_recopy(object me, object ob)
{
    me = this_object();
    ob = this_player();
    if (me->is_fighting() || ob->is_fighting() || me->query("fighting"))
        return notify_fail("现在这里正打的不亦乐乎！等会吧！\n");
    if ( me->query("winner") != ob->query("id") ) 
           return notify_fail("你不是现任帮派使者！\n");
    me->set("name",  ob->query("name") );
    ob->delete("party");
    ob->set("party/party_name",HIG+"第" + chinese_number(me->query("generation")) + "代"+ NOR );
     ob->set("party/rank",HIG+"帮派使者"+NOR);
      me->set("short", HIG+"第" + chinese_number(me->query("generation")) + "代帮派使者"+ NOR+" " + me->query("name") + "(bangpai shizhe)");
    me->delete("title");
    remove_call_out("do_clone");
call_out("do_clone", 0, me, ob);
    return 1;
}
int do_clone(object me, object ob)
{
    object *inv, newob,weapon;
    mapping hp_status, skill_status, map_status;
    string *sname, *mname;
    int i, temp;
    string skill1,skill2;
    seteuid( geteuid(me) );
    if (!living(me))    me->revive();
/* delete and copy skills */
    if (mapp(skill_status=ob->query("weapon")))
        me->set("weapon",skill_status);
    else    me->delete("weapon");
    if ( mapp(skill_status = me->query_skills()) ) {
        skill_status = me->query_skills();
        sname  = keys(skill_status);
        temp = sizeof(skill_status);
        for(i=0; i<temp; i++) {
            me->delete_skill(sname[i]);
        }
    }
    if ( mapp(skill_status = ob->query_skills()) ) {
        skill_status = ob->query_skills();
        sname  = keys(skill_status);
        for(i=0; i<sizeof(skill_status); i++) {
            me->set_skill(sname[i], skill_status[sname[i]]);
        }
    }
    
/* delete and copy skill maps */
    if ( mapp(map_status = me->query_skill_map()) ) {
        mname  = keys(map_status);
        temp = sizeof(map_status);
        for(i=0; i<temp; i++) {
            me->map_skill(mname[i]);
        }
    }
    if ( mapp(map_status = ob->query_skill_map()) ) {
        mname  = keys(map_status);
        for(i=0; i<sizeof(map_status); i++) {
            me->map_skill(mname[i], map_status[mname[i]]);
        }
    }
    
/* unwield and remove weapon & armor */
    inv = all_inventory(me);
    for(i=0; i<sizeof(inv); i++) {
        destruct(inv[i]);
    }
    set("my_weapon", 0);
    set("my_armor", 0);
/* wield and wear weapon & armor */
    inv = all_inventory(ob);
    for(i=0; i<sizeof(inv); i++) {
        if( inv[i]->query("weapon_prop/damage") > 100 
        ||  inv[i]->query("armor_prop/armor") > 100
        ||  inv[i]->query("shaolin")
                ||  inv[i]->query("value")>100000 ) continue;
        if( inv[i]->query("weapon_prop") &&  inv[i]->query("equipped") ) {
            if (!inv[i]->id(query("weapon/id"))){
//            carry_object(base_name(inv[i]))->wield();
            me->set("my_weapon", base_name(inv[i]));
                        }
        }
        else if( inv[i]->query("armor_prop") &&  inv[i]->query("equipped") ) {
//            carry_object(base_name(inv[i]))->wear();
            me->set("my_armor", base_name(inv[i]));
        }
    }

/* copy entire dbase values */
    hp_status = ob->query_entire_dbase();
    me->set("winner", ob->query("id"));
        me->set("str", hp_status["str"]);
        me->set("int", hp_status["int"]);
        me->set("con", hp_status["con"]);
        me->set("dex", hp_status["dex"]);
        me->set("age", hp_status["age"]);
        me->set("max_qi",    hp_status["max_qi"]);
        me->set("eff_qi",    hp_status["eff_qi"]);
        me->set("qi",        hp_status["qi"]);
        me->set("max_jing",  hp_status["max_jing"]);
        me->set("eff_jing",  hp_status["eff_jing"]);
        me->set("jing",      hp_status["jing"]);
        me->set("max_neili", hp_status["max_neili"]);
        me->set("neili",     2*hp_status["max_neili"]);
        me->set("max_jingli",hp_status["max_jingli"]);
        me->set("jingli",    hp_status["jingli"]);
        me->set("jiali",     hp_status["jiali"]);
        me->set("gender",    hp_status["gender"]);
        me->set("combat_exp",hp_status["combat_exp"]);
 me->set("jym_level/level",ob->query("jym_level/level"));
 me->set("banghui",ob->query("banghui"));
    
    me->delete("fighting");
    if (objectp(weapon=me->query_temp("weapon"))){
            skill1=weapon->query("skill_type");
            if (objectp(weapon=me->query_temp("secondaly_weapon")))
                    skill2=weapon->query("skill_type");
        }
    if ( mapp(skill_status = me->query_skills()) ) {
        sname  = keys(skill_status);
        for(i=0; i<sizeof(skill_status); i++) {
            command("enable unarmed "+sname[i]);
            command("enable force "+sname[i]);
            command("enable parry "+sname[i]);
            command("enable dodge "+sname[i]);
                        if (stringp(skill1))
            command("enable "+skill1+" "+sname[i]);
                        if (stringp(skill2))
            command("enable "+skill2+" "+sname[i]);
        }
    }

    command("enforce max");
    command("enable unarmed liumai-shenjian");
  save();
    tell_object(ob, "状态储存完毕。\n");
        newob = new("/d/rock/bangpainpc");
   newob->move(""+query("startroom")+"");
    destruct(me);
    return 1;
}

int do_recover()
{
    object me, ob;
    mapping skill_status, map_status;
    string *sname, *mname;
    int i;
    me = this_object();
    ob = this_player();
    if (me->is_fighting() || ob->is_fighting() || me->query("fighting"))
        return notify_fail("现在这里正打的不亦乐乎！等会吧！\n");
    if ( me->query("winner") != ob->query("id")  || me->query("age")>ob->query("age")) 
        return notify_fail("你不是现任帮派使者！\n");
if (me->query("combat_exp",1)/2 >ob->query("combat_exp",1)||me->query("max_neili",1)/2>ob->query("max_neili",1)||me->query("max_jingli",1)/2>ob->query("max_jingli",1))
  return notify_fail("你的实力和现在的使者的实力差太多了吧？\n");

if (me->query("jym_level/level",1)!=ob->query("jym_level/level",1))
return notify_fail("您偷偷的跑去升级了吧,还是先recopy重新存记录吧,要不然不能恢复的?\n");

if (me->query("str")!=ob->query("str")
 || me->query("dex")!=ob->query("dex")
 || me->query("con")!=ob->query("con")
 || me->query("int")!=ob->query("int"))
return notify_fail("您偷偷的跑去换属性了吧,还是先recopy重新存记录吧,要不然不能恢复的?\n");
    if (time()-me->query("recover")<60)
        return notify_fail("状态暂时不能复元。\n");

    if ( mapp(skill_status = me->query_skills()) ) {
        sname  = keys(skill_status);
        for(i=0; i<sizeof(skill_status); i++) {
            ob->set_skill(sname[i], skill_status[sname[i]]);
        }
    }
    
/* delete and copy skill maps */
    if ( mapp(map_status = ob->query_skill_map()) ) {
        mname  = keys(map_status);
        for(i=0; i<sizeof(map_status); i++) {
            ob->map_skill(mname[i]);
        }
    }
    if ( mapp(map_status = me->query_skill_map()) ) {
        mname  = keys(map_status);
        for(i=0; i<sizeof(map_status); i++) {
            ob->map_skill(mname[i], map_status[mname[i]]);
        }
    }
    
/* copy combat exp values */
        me->set("str", ob->query("str"));
        me->set("int", ob->query("int"));
        me->set("con", ob->query("con"));
        me->set("dex", ob->query("dex"));
    ob->set("combat_exp", me->query("combat_exp"));
ob->set("jym_level/level",me->query("jym_level/level"));
    me->set("recover",time());
    write("状态复元完毕。\n");
    return 1;
}

int do_chucun()
{   
    object lp;
    object newob;
   object me;
    object banghui;
        int i;
        string* sk;
   me=this_player();
   banghui=me->query("banghui");
    lp=new("/clone/misc/lingpai");
     lp->create(banghui);

    if(lp->query("no_use")) {
         destruct(lp);
    return notify_fail("你的帮会文件有问题，请与巫师联系。\n");
      } 

    if( me->query("id") != lp->query("bangzhu_id") )
     return notify_fail("你不是帮主不能更新。\n");

    if( me->query("reset") > time() )
     return notify_fail("你刚刚更新了使者!请再过几分钟去更新");    
 
    if( !me->query_temp("bang_xiang")) {
     me->set_temp("bang_xiang",1);
     me->start_busy(3);
     return notify_fail("这个象"+query("winner")+"可能在用,你确定要更新了?如果确定请在按一次reset!\n");
      }
   set("combat_exp",100);
        sk = keys(query_skills());                 
        for(i = 0; i<sizeof(sk); i++)
        {
                map_skill(sk[i]);                   
                map_delete(query_skills(), sk[i]);  
        }

    me->delete_temp("bang_xiang");
//    me->set("reset",time()+1800);
      newob = new("/d/rock/bangpainpc");
      newob->move(""+query("startroom")+"");
      destruct(this_object());

return 1;
}
