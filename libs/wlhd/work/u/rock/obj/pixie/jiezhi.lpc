#include <armor.h>
inherit FINGER;
void create() {
  set_name(HIY "金" HIW "戒" HIG "指" NOR, ({ "jin jiezhi", "jiezhi", "ring" }));
  set("weight", 400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("material", "gold");
    set("no_give", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("ty_paimai", 1);
    set("skill/pixie-jian", "jiezhi");
    set("armor_prop/strength", 100);
    set("armor_prop/armor", 1);
  }
  setup();
}
