// card-man.c 点卡发放员

#include <ansi.h>
inherit NPC;

void ask_life();
void ask_card();

void create()
{

        set_name("袁天涯", ({ "yuan", "tianya" }));
        set("title", "点卡发放员");

        set("gender", "男性");
        set("age", 27);
        set("long","他是一位年纪很轻的小伙，衣着青布杉，相貌极为忠厚。\n");

	set("inquiry", ([ 
        	"查询活跃度"     : (: ask_life :),
        	"活跃度兑换点卡" : (: ask_card :),
            ])); 

        setup();
        carry_object("/clone/misc/changpao")->wear();
}

void ask_job()
{
	object me = this_player();
	object link_ob = me->query_temp("link_ob");
	int online = 0;

	if(!link_ob) return;
	
	online = time()-link_ob->query("online_time");

	return;
}

void ask_card()
{
	return;
}