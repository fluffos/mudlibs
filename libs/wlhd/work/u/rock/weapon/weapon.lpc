#include <ansi.h>
#include <weapon.h>
#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif

int check_name(string str,object me);
int do_hui(object weapon);
int do_rename(string arg);
int do_qie(string arg);
int do_xiang(object me,object obj);
void init()
{
   if (!mapp(this_player()->query("hecheng"))){
     this_object()->owner_is_killed();
     return;
   }
    if (this_player()!=environment()) return;
    add_action("do_hui","duan");
    add_action("do_rename","gainame");
    add_action("do_qie","xiangqie");
    this_object()->weapon_init();
}
void create()
{   
    object me;
    string w_name,w_id,w_lb;
    int w_damage;
    me = this_player();
    if (me){
    w_name=me->query("hecheng/name");
    w_id = me->query("hecheng/id");
    w_damage = me->query("hecheng/damage");
    w_lb = me->query("hecheng/lb");
    set("skill_type", w_lb);
    set("weapon_prop/damage", w_damage);
    if ( me->query("hecheng/int") ) 
    set("weapon_prop/intelligence",me->query("hecheng/int"));
    if ( me->query("hecheng/dex") ) 
    set("weapon_prop/dexerity",me->query("hecheng/dex"));
    if ( me->query("hecheng/con") ) 
    set("weapon_prop/constitution",me->query("hecheng/con"));
    if ( me->query("hecheng/str") ) 
    set("weapon_prop/strength",me->query("hecheng/str"));
    set_weight(5000);
    
    set_name(w_name, ({w_id,"hecheng",w_lb}));
    set("flag", 1 | EDGED);
    set("unit", "柄");   
    set("no_get",1);
    set("no_give",1);
    set("no_sell",1);
    set("nopaimai",1);
    set("no_drop",1);
    if( !query("actions") ) {
        set("actions", (: call_other,WEAPON_D, "query_action" :) );
        set("verbs", ({ "slash", "slice", "thrust" }) );
    }

     if ( me->query("env/hecheng1"))
set("wield_msg", ""HIG+me->name()+"准备装备合成兵器!  "NOR+me->query("env/hecheng1")+"\n"NOR);
    if ( me->query("env/hecheng2"))
set("unwield_msg", ""HIM+me->name()+"准备放下合成兵器!  "NOR+me->query("env/hecheng2")+"\n"NOR);
/*
 set("wield_msg", ""+HIG+"$N默念数声,只见电光四射,"+w_name+""+HIG+"已稳稳落在"+HIG+"$N!\n");
 set("unwield_msg", ""+HIM+"$N的手轻轻一抖,"+w_name+""+HIM+"竟突然消失在空气中!\n");
*/
    }
    setup();
}   
int check_name(string name,object me)
{
        int i;

        i = strlen(name);

      if( (strlen(name) < 4) || (strlen(name) > 30 ) ) {
              tell_object(me,"合成兵器名字请定在50个位数。\n");
                return 0;
        }
        while(i--) {
              if( name[i]<=' ' ) {
                  tell_object(me,"对不起，你的合成兵器名字中不能用控制字符。\n");
                        return 0;
                }
        }
        return 1;
}

int do_hui(string weapon)
{   
    string w_name;
    object me;
    me=this_player();
    w_name=me->query("hecheng/id");
    if( !weapon || w_name!=weapon)
        return notify_fail("你要摧毁什么?\n");
   message_vision(HIR "$N大喝一声，一掌拍到兵器上，一掌猛力击下。结果轰隆一声巨响"
            +this_object()->name()+HIR+"断为两截!\n" NOR,me);
    me->delete("hecheng");
    
    me->save();
    destruct( this_object() );
    return 1;
}
int do_qie(string arg)
{
    object obj;
    object ob;
    object me;
    me=this_player();

    if(!arg) return notify_fail("你要镶锲什么终极金属进去？\n");
 
    if ( me->query("hecheng/qie") && me->query("hecheng/qie")==me->query("hechengqie")+1 )
    return notify_fail("你已经镶锲了终极金属了，不能再镶锲了!\n");

    if( !objectp(obj = present(arg, me)) )
    return notify_fail("你身上并没有这样东西!\n");

    return do_xiang(me, obj);
}
int do_rename(string arg)
{
    object me;
    me=this_player();
    if( !arg )
        return notify_fail("你改什么的名字?\n");
// 修改抛攻击的Bug  by zjb@TY 
    if( me->query("hecheng/id") != query("id") ||
        me->query("hecheng/damage") != query("weapon_prop/damage") )
        return notify_fail("你不是本合成武器的主人，不能使用该指令!!\n");
        if(! check_name(arg,me))        return 1;
    arg = replace_string(arg, "$BLK$", BLK);
    arg = replace_string(arg, "$RED$", RED);
    arg = replace_string(arg, "$GRN$", GRN);
    arg = replace_string(arg, "$YEL$", YEL);
    arg = replace_string(arg, "$BLU$", BLU);
    arg = replace_string(arg, "$MAG$", MAG);
    arg = replace_string(arg, "$CYN$", CYN);
    arg = replace_string(arg, "$WHT$", WHT);
    arg = replace_string(arg, "$HIR$", HIR);
    arg = replace_string(arg, "$HIG$", HIG);
    arg = replace_string(arg, "$HIY$", HIY);
    arg = replace_string(arg, "$HIB$", HIB);
    arg = replace_string(arg, "$HIM$", HIM);
    arg = replace_string(arg, "$HIC$", HIC);
    arg = replace_string(arg, "$HIW$", HIW);
    arg = replace_string(arg, "$NOR$", NOR);
    me->set("hecheng/name",arg+NOR);
    set("name",arg+NOR);
    write("ok!\n");
    this_object()->create();
    return 1;
}
int do_xiang(object me,object obj)
{
    object ob,user_weapon;
    string arg=obj->short(1);
   
    foreach ( ob in all_inventory(me)){
    if (ob->short(1)!=arg) continue;
    if (!ob->query("zhongji_hc")) {
    write("这样东西并不能拿来镶锲!\n");
    return 1;
    }
    user_weapon = me->query_temp("weapon");
  	if(user_weapon && user_weapon->query("id") == this_object()->query("id"))
  	{
  		write("请放下这把武器。\n");
  		return 1;
  	}

    if ( ob->query("int") )
    me->add("hecheng/int",ob->query("int"));
  
    if ( ob->query("str") )  
    me->add("hecheng/str",ob->query("str"));    

    if ( ob->query("dex") ) 
    me->add("hecheng/dex",ob->query("dex"));
  
    if ( ob->query("con") )
    me->add("hecheng/con",ob->query("con"));
 
    if ( ob->query("damage") )
    me->add("hecheng/damage",ob->query("damage"));

    me->add("hecheng/qie",1);

    //更新武器数据
    this_object()->weapon_init(me);
    write(HIM"你把"+ob->name()+HIM"这样金属镶锲到合成兵器中!\n"NOR);
    destruct(ob);
    return 1;
    }
}

void weapon_init(object me)
{
    string w_name,w_id,w_lb;
    int w_damage;
    object weapon;

	if(!me) return;
	
	weapon = this_object();

    w_name=me->query("hecheng/name");
    w_id = me->query("hecheng/id");
    w_damage = me->query("hecheng/damage");
    w_lb = me->query("hecheng/lb");
    weapon->set("skill_type", w_lb);
    weapon->set("weapon_prop/damage", w_damage);
    if ( me->query("hecheng/int") ) 
    weapon->set("weapon_prop/intelligence",me->query("hecheng/int"));
    if ( me->query("hecheng/dex") ) 
    weapon->set("weapon_prop/dexerity",me->query("hecheng/dex"));
    if ( me->query("hecheng/con") ) 
    weapon->set("weapon_prop/constitution",me->query("hecheng/con"));
    if ( me->query("hecheng/str") ) 
    weapon->set("weapon_prop/strength",me->query("hecheng/str"));
}