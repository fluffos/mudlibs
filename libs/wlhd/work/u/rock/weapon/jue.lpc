// By rock&jym

inherit ITEM;
int rock = random(4);
mapping *weapon = ({
  ([ "name": "方舟流星石",
    "id": "rock shi",
    "yanse": HIB,
    "int": 35,
    "str": 25,
    "dex": 30,
    "con": 20,
    "damage": 250,
    "lei": 1,
  ]),
  ([ "name": "耗子的化石",
    "id": "jerry shi",
    "yanse": HIW,
    "int": 25,
    "str": 35,
    "dex": 20,
    "con": 30,
    "damage": 250,
    "lei": 2,
  ]),
  ([ "name": "方舟的化石",
    "id": "cangyue gang",
    "yanse": WHT,
    "int": 15,
    "str": 45,
    "dex": 20,
    "con": 30,
    "damage": 250,
    "lei": 3,
  ]),
  ([ "name": "魔睛烛舞铁",
    "id": "zhuwu tie",
    "yanse": HIR,
    "int": 45,
    "str": 15,
    "dex": 15,
    "con": 35,
    "damage": 250,
    "lei": 4,
  ]),
});
int panduan(int arg) { if (arg) rock = arg - 1; }
void create() {
  string name, id;

  name = weapon[rock]["name"];

  set_name(weapon[rock]["yanse"] + name + NOR, ({ weapon[rock]["id"] }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("no_get", 1);
  set("no_drop", 1);
  //        set("no_put",1);
  //        set("no_give",1);
  set("zhongji_hc", 1);
  set("bh", weapon[rock]["lei"]);
  if (weapon[rock]["str"])
    set("str", weapon[rock]["str"]);
  if (weapon[rock]["con"])
    set("con", weapon[rock]["con"]);
  if (weapon[rock]["dex"])
    set("dex", weapon[rock]["dex"]);
  if (weapon[rock]["int"])
    set("int", weapon[rock]["int"]);
  if (weapon[rock]["damage"])
    set("damage", weapon[rock]["damage"]);
  set("long", "这是一个差不多绝种的金属，可以用来合成兵器!(help hecheng)\n");

  setup();
}
