// By rock&jym

inherit ITEM; 
int rock = random(5);
mapping *weapon= ({
([     "name":     "烧铁",
       "id":   "shao tie",
       "yanse":       HIR,
       "int":           5,
]),
([     "name":     "红铁",
       "id":   "hong tie",
       "yanse":       HIR,
       "str":           5,
]),
([     "name":     "绿铁",
       "id":     "lv tie",
       "yanse":       HIG,
       "dex":           5,
]),
([     "name":     "蓝铁",
       "id":    "lan tie",
       "yanse":       HIB,
       "con":           5,
]),
([     "name":     "紫铁",
       "id":     "zi tie",
       "yanse":       MAG,
       "damage":       100,
]),
});
void create()
{
    string name,id;

    name = weapon[rock]["name"];

    set_name(weapon[rock]["yanse"]+name+NOR,({weapon[rock]["id"]}) );  
    set_weight(100);
    if( clonep() )
    set_default_object(__FILE__);
    else {
         set("unit", "个");                        
        }

   set("ty_weapon",1);
   set("no_get",1);
   set("no_put",1);
                set("value",10000000);
   if (weapon[rock]["str"])
   set("str",weapon[rock]["str"]);
   if (weapon[rock]["con"])
   set("con",weapon[rock]["con"]);
   if (weapon[rock]["dex"])
   set("dex",weapon[rock]["dex"]);
   if (weapon[rock]["int"])
   set("int",weapon[rock]["int"]);
   if (weapon[rock]["damage"])
   set("damage",weapon[rock]["damage"]);
   set("long", "这是一个铁级的金属，可以用来合成兵器!(help hecheng)\n");
   
   setup();
  }

