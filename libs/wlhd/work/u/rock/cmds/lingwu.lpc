// By rock&jym 2002.5.10
inherit F_SSERVER;

int main(object me, object target) {
  int dj, exp, pot, wx;
  me = this_player();
  dj = me->query("jym_level/level");
  wx = me->query_int();

  if (!me->is_fighting())
    return notify_fail("你现在没在战斗，领悟个头?\n");

  if (me->query_condition("killer"))
    return notify_fail("官府正在通缉你，你心神不定无法专心练功！\n");

  target = offensive_target(me);

  if (
    target->query("id") != "mu ren" &&
    target->query("id") != "tong ren")
    return notify_fail("暂时只开放和木人和铜人领悟？\n");

  if (me->is_busy()) return notify_fail("你现在正忙着，等一下再领悟吧!\n");

  if (me->query_temp("rock_lingwu") > time())
    return notify_fail("你刚刚才领悟过，还想再领悟？\n");

  me->start_busy(2);
  me->set_temp("rock_lingwu", time() + 15);

  if (dj < 2) {
    exp = (wx / 2) + random(10);
    pot = random(wx / 10);
    me->add("combat_exp", exp);
    me->add("potential", pot);
    return notify_fail(HIB "您此次领悟得到了" + exp + "点经验值," + pot + "点潜能!\n" NOR);
  }

  if (dj < 5) {
    exp = wx + random(10);
    pot = random(wx / 7);
    me->add("combat_exp", exp);
    me->add("potential", pot);
    return notify_fail(HIR "您此次领悟得到了" + exp + "点经验值," + pot + "点潜能!\n" NOR);
  }

  if (dj < 10) {
    exp = (wx * 4) / 3 + random(10);
    pot = random(wx / 5);
    me->add("combat_exp", exp);
    me->add("potential", pot);
    return notify_fail(HIM "您此次领悟得到了" + exp + "点经验值," + pot + "点潜能!\n" NOR);
  }

  if (dj >= 10) {
    exp = (wx * 5) / 3 + random(10);
    pot = random(wx / 5);
    me->add("combat_exp", exp);
    me->add("potential", pot);
    return notify_fail(HIG "您此次领悟得到了" + exp + "点经验值," + pot + "点潜能!\n" NOR);
  }

}
