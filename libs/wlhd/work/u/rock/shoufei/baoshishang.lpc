// 宝石商人

#define SYSTEM_BUY "/u/rock/shoufei/include/buy.lpc"
inherit NPC;

void create()
{
	set_name("宝石商人", ({ "baoshi shang", "shang"}));

	set("gender", "女性");
	set("age", 16);
	set("per", 25);
	set("con", 25);
	set("int", 25);
	set("dex", 25);
	set("str", 25);
	set("title",HIM"天下珍宝"NOR);
	set("long","有了我，你就能买到天下最珍贵的宝石。\n");
	set("no_kill",1);

	set("vendor_goods", ([
		"/clone/shoufei/item/hongyu"     : 1,     //红玉     3元
		"/clone/shoufei/item/tianyuan"   : 8,     //天元     8元
		"/clone/shoufei/item/longzhu"    : 1,     //龙珠     2元
		"/clone/shoufei/item/liuxing"    : 1,     //流星     1元
		"/clone/shoufei/item/longhen1"   : 1,     //龙恨内力 5元
		"/clone/shoufei/item/longhen2"   : 1,     //龙恨防御 5元
		"/clone/shoufei/item/longhen3"   : 1,     //龙恨气血 5元
		"/clone/shoufei/item/longhen4"   : 2,     //龙恨攻击 4元
		"/clone/shoufei/item/longhen5"   : 1,     //龙恨精气 5元
		"/clone/shoufei/item/tiangang1"  : 2,     //天罡力量 2元
		"/clone/shoufei/item/tiangang2"  : 2,     //天罡闪避 2元
		"/clone/shoufei/item/tiangang3"  : 2,     //天罡悟性 2元
		"/clone/shoufei/item/tiangang4"  : 2,     //天罡根骨 2元
		"/u/jerry/cisco/tianshi"         : 10,    //天使翅膀 10元
                "/u/rock/newbie/tang"            : 20,    //金庸梦礼糖 20元
	]));

	setup();
	carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

int do_list()
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(SYSTEM_BUY->do_list(me,npc)) return 1;
	else
	{
		tell_object(me,"对不起,现在没有东西出售。\n");
		return 1;
	}
}

int do_buy(string arg)
{
	object me,npc;
	me = this_player();
	npc = this_object();

	if(!arg)
	{
		tell_object(me,"你想买什么？\n");
		return 1;
	}

	return SYSTEM_BUY->do_buy(me,npc,arg);
}
