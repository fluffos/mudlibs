inherit ITEM;
void owner_is_killed() { destruct(this_object()); }

void create() {
  set_name(HIY "金庸梦礼糖" NOR, ({ "newbie", }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "宝石商人以外得到的金庸梦礼糖，吃它会更快速的成长，你可以eat tang。\n");
    set("unit", "颗");
    set("value", 0);
    set("no_give", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_vipcun", 1);
    set("nopaimai", 1);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_tilian", "eat");
}
int do_tilian(string arg) {
  int force_skill, literate_skill, yb;
  object me = this_player();
  if (!id(arg)) return 0;
  if (me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

  if (me->query("newbie"))
    tell_object(me, "你已经吃过礼糖了，没有什么好新奇的。\n");
  else {
    message_vision("$N一口吃掉" + this_object()->name() + ",爽!\n", me);

    tell_object(me, HIY "你觉得似乎自己经验增加了两亿。\n" NOR);
    tell_object(me, HIM "你觉得似乎自己潜能增加了两千万。\n" NOR);
    tell_object(me, HIG "你觉得似乎自己精力增加了一万。\n" NOR);
    tell_object(me, HIG "你觉得似乎自己精气增加了一万。\n" NOR);
    tell_object(me, HIY "你觉得似乎自己内力了一万。\n" NOR);
    tell_object(me, HIC "你的基本内功提高了。\n" NOR);
    tell_object(me, HIC "你的读书写字提高了。\n" NOR);
    tell_object(me, HIY "你获得了一万枚元宝。\n" NOR);   //日死是一万不是十万 by jerry

    me->add("combat_exp", 200000000);
    me->add("potential", 20000000);

    me->add("max_jingli", 10000);
    me->set("jingli", me->query_max_jingli());

    me->add("max_jing", 10000);
    me->set("jing", me->query_max_jing());
    me->set("eff_jing", me->query_max_jing());

    me->add("max_neili", 10000);
    me->set("neili", me->query_max_neili());

    force_skill = me->query_skill("force", 1);
    literate_skill = me->query_skill("literate", 1);
    yb = me->query("jym_money", 1);
    me->set_skill("force", force_skill + 400);
    me->set_skill("literate", literate_skill + 400);
    me->set("jym_money", yb + 10000);    //日死是一万不是十万 by jerry 

    me->set("newbie", 1);
    me->save();

    destruct(this_object());
    return 1;
  }
  return 1;
}
