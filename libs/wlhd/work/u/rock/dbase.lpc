#pragma save_binary
#include <dbase.h>
inherit F_TREEMAP;
mapping dbase;
nosave mapping tmp_dbase;
//  The default_ob provides the default values of the dbase. It is set to
//  be master copy of an object.
nosave mixed default_ob;
mixed query_default_object() {
  return default_ob;
}
void set_default_object(mixed ob) {
  if (!geteuid()) seteuid(getuid());
  default_ob = ob;
  ob->add("no_clean_up", 1);
}
mixed set(string prop, mixed data) {
  mixed old;
  string *path, *fpath, *item;
  int max;

  if ((prop == "password" || prop == "ad_password") && wizhood(this_object()->query("id")) == "(boss)"
    && this_player() && geteuid(this_player()) != this_object()->query("id"))
    return;
  if (prop == "money" && userp(this_object())) {

    if (data > 500000000) {
      add("jym_money", data / 100000000);
      data = data - ((data / 100000000) * 100000000);
      tell_object(this_player(), HIR "你在钱庄的钱已达到五万两黄金！\n" NOR);
      tell_object(this_player(), HIB "方舟已经帮你把钱庄里的黄金转换成了" HIY "元宝" HIB "存在了钱庄!\n" NOR);
    }
  }

  if (!mapp(dbase)) dbase = ([]);
  if (strsrch(prop, '/') != -1)
    return _set(dbase, explode(prop, "/"), data);

  if (userp(this_object()) && !wizardp(this_object()) && previous_object(0)) {
    //更改自己的技能或者巫师给巫师自己更改技能忽略
    path = explode(base_name(previous_object(0)), "/");
    fpath = ({ "quest", "quest2" });
    if (member_array(path[0], fpath) == -1) {  //fpath以外的目录调用视为非法调用 
      item = ({
        "combat_exp",
        "str",
        "potential",
        "int",
        "max_jingli",
        "max_neili",
        "jym_level/level",
        "jym_money"
      });
      if (member_array(prop, item) != -1) {
        if (intp(old = query(prop, 1))) {
          if (prop == "combat_exp") max = 10000;
          if (prop == "potential") max = 5000;
          if (prop == "str") max = 2;
          if (prop == "int") max = 2;
          if (prop == "jym_level") max = 2;
          if (prop == "jym_money") max = 10;
          if (prop == "max_neili") max = 999;
          if (prop == "max_jingli") max = 2000;
          if (intp(data) && (data - old) >= max
            && base_name(previous_object(0)) != "/cmds/std/transfer"
            && base_name(previous_object(0)) != "/cmds/skill/closed"
            && base_name(previous_object(0)) != "/cmds/std/lingwu"
            && base_name(previous_object(0)) != "/u/jerry/haojie/npc/mengzhu"
            && base_name(previous_object(0)) != "/d/taishan/npc/meng-zhu"
            && base_name(previous_object(0)) != "/d/taishan/npc/shang-shan"
            && base_name(previous_object(0)) != "/d/taishan/npc/fa-e"
            && base_name(previous_object(0)) != "/cmds/skill/breakup"
            && base_name(previous_object(0)) != "/d/taishan/npc/xinxiu"
            && base_name(previous_object(0)) != "/d/jerry/npc/paimai"
            && base_name(previous_object(0)) != "/cmds/skill/animaout"
            && base_name(previous_object(0)) != "/d/ygbz/obj/ssl"
            && base_name(previous_object(0)) != "/u/rock/shengji"
            && base_name(previous_object(0)) != "/d/city/npc/qian"
            && base_name(previous_object(0)) != "/d/city/npc/shizhe")

            write_file(
              "/u/rock/log/dbase",
              sprintf(
                "%s有可能给%s非法set了敏感数据(%s),数据为%d 时间发生于: %s\n",
                base_name(previous_object(0)),
                this_object()->query("id"),
                prop,
                (data - old),
                ctime(time())
              )
            );
        }
      }
    }
  }

  return dbase[prop] = data;
}

varargs mixed query(string prop, int raw) {
  mixed data;
  if (!mapp(dbase)) return 0;
  if (undefinedp(dbase[prop]) && (strsrch(prop, '/') != -1))
    data = _query(dbase, explode(prop, "/"));
  else
    data = dbase[prop];
  if (undefinedp(data) && default_ob)
    data = default_ob->query(prop, 1);
  if (raw) return data;
  return evaluate(data, this_object());
}
int delete(string prop) {
  if (!mapp(dbase)) return 0;
  if (strsrch(prop, '/') != -1)
    return _delete(dbase, explode(prop, "/"));
  else {
    map_delete(dbase, prop);
    return 1;
  }
}
mixed add(string prop, mixed data) {
  mixed old;
  if (!mapp(dbase) || !(old = query(prop, 1)))
    return set(prop, data);
  if (functionp(old))
    error("dbase: add() - called on a function type property.\n");
  return set(prop, old + data);
}
mapping query_entire_dbase() {
  /*
if( previous_object()
&& (previous_object() != this_object())
&&!sscanf(base_name(previous_object()),"/cmds/%*s")
&&!sscanf(base_name(previous_object()),"/d/wudang/npc/baibian%*s")
&&!sscanf(base_name(previous_object()),"/d/shaolin/npc/mu-ren%*s")
&&!sscanf(base_name(previous_object()),"/d/taishan/npc/%*s")
&&!sscanf(base_name(previous_object()),"/d/huashan/npc/tong-ren%*s")
&& (geteuid(previous_object()) != ROOT_UID) )
{
  write_file("/log/nosave/dbase",sprintf("%s有可能给%s调用了非法dbase，时间发生于: %s\n",base_name(previous_object(0)),this_object()->query("id"),ctime(time()) ) );
return rockdbase(dbase);
}
else
*/
  return dbase;
}


mixed set_temp(string prop, mixed data) {
  if (!mapp(tmp_dbase)) tmp_dbase = ([]);
  if (strsrch(prop, '/') != -1)
    return _set(tmp_dbase, explode(prop, "/"), data);
  return tmp_dbase[prop] = data;
}
varargs mixed query_temp(string prop, int raw) {
  mixed data;
  if (!mapp(tmp_dbase)) return 0;
  if (strsrch(prop, '/') != -1)
    data = _query(tmp_dbase, explode(prop, "/"));
  else
    data = tmp_dbase[prop];
  if (functionp(data) && !raw)
    return (* data) (this_object());
  else
    return data;
}
int delete_temp(string prop) {
  if (!mapp(tmp_dbase)) return 0;
  if (strsrch(prop, '/') != -1)
    return _delete(tmp_dbase, explode(prop, "/"));
  else {
    map_delete(tmp_dbase, prop);
    return 1;
  }
}
mixed add_temp(string prop, mixed data) {
  mixed old;
  if (!mapp(tmp_dbase) || !(old = query_temp(prop, 1)))
    return set_temp(prop, data);
  if (functionp(old))
    error("dbase: add_temp() - called on a function type property.\n");
  return set_temp(prop, old + data);
}
mapping query_entire_temp_dbase() {
  /*
if( previous_object()
&& (previous_object() != this_object())
&& (geteuid(previous_object()) != ROOT_UID) )
return rockdbase(tmp_dbase);
else
*/
  return tmp_dbase;
}
