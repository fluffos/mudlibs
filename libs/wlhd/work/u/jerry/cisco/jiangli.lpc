inherit ITEM;
void owner_is_killed() { destruct(this_object()); }

void create() {
  set_name(HIW "BUG奖励" NOR, ({ "dan", }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIW "耗子发的礼物，你可以eat dan！\n");
    set("unit", "颗");
    set("value", 0);
    set("no_give", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_vipcun", 1);
    set("nopaimai", 1);
    set("ty_gift", 1);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_tilian", "eat");
}
int do_tilian(string arg) {
  object me = this_player();
  if (!id(arg)) return 0;
  if (me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

  {
    message_vision("$N一口吃掉" + this_object()->name() +
      ",爽!\n", me);


    me->add("combat_exp", 100000000);
    me->add("potential", 10000000);

    destruct(this_object());
    return 1;
  }
}
