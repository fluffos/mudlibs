inherit NPC;
#include <ansi.h>;
#include "/quest2/name.h";
#include "/quest2/location.h";
mapping userskills;
string username;

int give_quests();
int accountguaiexp(int turn,object who);
int guaif(int turn,object who);
int guaim(int turn,object who);
int set_guai_qi_jing(int turn,object guai);
int getexp(int turn,int level,object who);
string setguaititle(int number,object guaiob);
string randomlocation(int i1);


string clear_title(string arg);
string ask_shibai();
void delete_title(object who);
void add_title(object me,string arg);
int do_bihua(string arg);
void do_titles(object obj,int rank);
int do_halt();

string *list,tmp; 
void create()
{
        set_name("金庸", ({ "jin yong"}) );
        set("gender", "男性");
        set("age", 75);
        set("nickname", HIR"天下公平"NOR);
        set("title", HIY"武侠宗主"NOR);
        set("long",
            "这是一位显得略胖的教书匠风度的慈祥老者，早年笔耕不惰，如今早已功成名就。\n据说一身修为已经达到了神的境界,你看他两眼湛然若神， 精光内敛，显然已经
天人合一，返朴归真了。\n");
              set("age", 57);
        set("attitude", "friendly");
        set("str", 40);
        set("per", 50);
        set("int", 40);
        set("con", 40);
        set("dex", 40);
        set("max_qi", 4500);
        set("max_jing", 4500);

        set("jiali", 0);
        set("combat_exp", 30000000);
        set("score", 50000);                
        set_skill("strike",200);
        set_skill("finger",200);
        set_skill("dodge",200);
        set_skill("force", 200);
        set_skill("parry", 210);
        set_skill("sword", 200);
        set_skill("literate", 200);
        set_skill("blade",200);
set("inquiry",([   "kill":(:give_quests():),
"失败":(:ask_shibai():)
]));
  set("chat_chance", 10);
        set("chat_msg", ({
                "金庸抬头看了你一眼，露出一副高深莫测的样子\n",
                "金庸长叹一声，世上再也不会有人记得我了！。\n",
                (: command("'") :),

                }) );
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({

        (: perform_action, "sword.poqi" :),
        (: perform_action, "sword.pozhang" :),
        (: perform_action, "sword.pojian" :),
        (: exert_function, "recover" :),
        (: exert_function, "refresh" :),
}) );  
set("family/family_name","金庸学会");
set("family/generation",1);
        setup();
        carry_object("/clone/misc/cloth")->wear();
            carry_object("/quest2/zhanyao-jian")->wield();
 }

void init()
{
object who;
        ::init();       
        add_action("do_bihua", "bihua");
        add_action("do_yun","yun");
        add_action("do_yun","exert");
        add_action("do_kill","kill");
        add_action("do_kill","hit");
        add_action("do_kill","touxi");

        add_action("do_kill","ansuan");
        add_action("do_fight","perform");
        add_action("do_bihua", "bihua");
        add_action("do_kill", "fight");
        add_action("do_halt", "halt");
        add_action("do_halt", "h");
      add_action("do_findbook", "findbook");

if( interactive(who = this_player()) && !who->is_fighting() ) 
       {
                remove_call_out("greeting");
                call_out("greeting", 1, who);
        }

}

int do_yun(string arg)
{
        if (arg=="roar")
        {
        write(this_player()->query("name")+"，专心比武吧！\n");
        return 1;

        }
        return 0;
 }
void greeting(object who)
{
        if( !who || environment(who) != environment() ) return;
        if ((int)who->query("combat_exp")<1000)
        {
            switch(random(3))
           {
                case 0:command("hi "+(string)who->query("id"));break;
                case 1:command("welcome "+(string)who->query("id"));break;
                case 2:command("bow "+(string)who->query("id"));break;
                case 3:command("whisper "+(string)who->query("id")+" 要领任务? 向我打听kill的消息就可以了!");break;
           }
     
        }
        else
           say("金庸对说道:这位"+RANK_D->query_respect(who)+
               ",别来无恙啊。\n");
           if(random(40)>20)
           command("sigh");
        return;
}

int max_skill_level(object ob)
{  

        int s,i=0,maxlevel=1;
        string *str;
        userskills=ob->query_skills();
        if (!mapp(userskills)) {maxlevel=3;return maxlevel;}

        str=keys(userskills);
        s=sizeof(str);
        if (s<2) return userskills[str[0]]; 
        while (s>0){
                s-=1;
                i=userskills[str[s]];
                if (i>maxlevel) maxlevel=i;
                }
        return maxlevel;
}

int accountlevel(int turn,object ob)
{
        int level;
        level=max_skill_level(ob);
        level=(int)level*(70+turn*4)/100;
        if(level==0) level = 1;
        return level;
}

string randomlocation(int i1)
{

        string *str1,*str2,loca;
        int i2,temp;
        str1=keys(allloca);
        str2=allloca[str1[i1]];
        i2=sizeof(str2);
        temp=random(i2);
        if (temp==0 || temp==i2) temp=1;
        loca=str2[0]+str2[temp];
        return loca;
}
      
int give_quests()
{
        object guaiob;
        object me,who,tempob;
         int chooseguai,rewardpot,rewardexp,turn,dengji;
        int questbusytime,giveuptime,guailevel;
        int temp,i1;
string guaiid;
        string *strtemp,locastr;
        me=this_object();
        who=this_player();
        giveuptime=who->query_temp("questtime2");

        questbusytime=who->query_temp("questtime1");
        turn=who->query_temp("turn");
        if(me->query_temp("pending/exercise")){
                write("金庸正在修炼内功，可能没时间理你!\n");
                return 1;
                }

   if( who->query("combat_exp")>280000000)
{
 write(HIW"这位老大已经这么厉害了,我这里恐怕留不住您！\n"NOR);;
 return 1;
}
        if (who->query_temp("kill")){
                if (time()<giveuptime){      
                write ("$N对$n说道：这位大侠在下不是请您去杀掉"+who->query_temp("guainame")+"吗？\n",me,who);
                return 1;
                }else turn-=2;
        }else{
                        if (time()<questbusytime) {
                        write("$N看了看你,面带微笑的对$n说道：\n"
                        +"这位"+RANK_D->query_respect(who)+",坏人已经除尽，不妨先去歇息。\n"
                        ,me,who);
                        return 1;
                        }
                }

        //每十个任务一轮，用turn 做参数
        if (!turn || turn>9) {

                who->set_temp("turn",0);
                turn=0;
                }

       turn=turn+1;
    if ( !who->query("env/no_msg") )
    who->set("env/no_msg",1);

        who->set_temp("turn",turn);
        guailevel=accountlevel(turn,who);
          guaiob=new(__DIR__"questguai_n"); 


        guaiob->set_heart_beat(1);
        guaiob->set_temp("killername",(string)who->query("id"));

        //设置怪的jingli,neili,exp,
//        set_guai_qi_jing(turn,who);
         guaiob->set("max_neili",who->query("zjb_dj/dj")*80000);
         guaiob->set("neili",who->query("zjb_dj/dj")*80000);
        guaiob->set("max_jingli",guaim(turn,who));
        guaiob->set("jingli",(int)(guaim(turn,who)*6/5));
//        guaiob->set("combat_exp",who->query("zjb_dj/dj")*5000000);
        guaiob->set("combat_exp",accountguaiexp(turn,who));
        guaiob->set("neili_factor",(int)(guailevel/2));
        guaiob->set("jiali",(int)who->query_skill("force")/4);
        guaiob->set("int",(int)who->query_int());

        guaiob->set("str",(int)who->query_str());
        guaiob->set("spi",(int)who->query_spi());
        guaiob->set("con",(int)who->query_con());
        guaiob->set("per",(int)who->query_per());
        guaiob->set("kar",(int)who->query_skill("kar"));
        guaiob->set("jingli_factor",(int)(guailevel/2));
        set_guai_qi_jing(turn,guaiob);

        //set guai's "long" and "title" 
        switch (random(3)){
                case 1 :
                if(guaiob->query("combat_exp")>100000)
                        guaiob->set("long","一个绿林高手,听说出师于星宿派，是"HIR
                                +who->query("name")+NOR"的目标\n");
                else guaiob->set("long","绿林人物"+guaiob->query("name")
                                +",听说是星宿派的高手，颇有些本领。\n");
                break;
                case 2 :
                        if(guaiob->query("combat_exp")>100000)
                                guaiob->set("long","一个黑道高手,听说来自于一个神秘的组织，是"HIR
                                        +who->query("name")+NOR"的目标\n");
                        else guaiob->set("long","黑道人物"+guaiob->query("name")
                                        +"他全身散发出一丝邪气。\n");
                        break;
                        guaiob->set("long","武当叛徒"+guaiob->query("name")
                                        +"，他混身上下杀气逼人。\n");
                }
        chooseguai=random(14);
        setguaititle(chooseguai,guaiob);   
guaiid=CYN+who->name()+HIR+"追杀的"+NOR+guaiob->query("title");
guaiob->set("title",guaiid);
//以下为加入的代码..请其他wiz更改任务NPC等级时按照下面代码添加.
    dengji = who->query("zjb_dj/dj") / 3 + 1;
     if(dengji<0)    dengji=1;
     guaiob->set("zjb_dj/dj",dengji);
        //rewardexp and rewardpot 是杀怪后得到的qn and exp
          rewardexp=3000+random(1000);
        rewardpot=1000+random(1000);
        guaiob->set_temp("killrewardpot",rewardpot);
        guaiob->set_temp("killrewardexp",rewardexp);
        guaiob->set_temp("player",who);
        guaiob->setguaiskill(chooseguai,guailevel,guaiob);
        guaiob->check_time();  
        //确定怪的位置 
        strtemp=keys(allloca);
        i1=sizeof(strtemp);
        temp=random(i1);
        if (temp==i1) temp=0;
        locastr=randomlocation(temp);  

        tempob=load_object(locastr);
        //if we get a wrong path,these can help us ?
        if (!tempob || !guaiob->move(tempob)) {
                write(HIR"$N发现好象并没有:"+locastr
                        +"这个房间，请向通知英雄，并再要一次任务\n"NOR,who);
                destruct(guaiob);
                return 1;
                }
        //设置玩家的暂时参数
      who->set_temp("questtime1",time()+20); 
        who->set_temp("questtime2",time()+600);
        who->set_temp("guainame",guaiob->query("name"));
        who->set_temp("turn",turn);
        who->set_temp("kill",1);
        write("$N微笑着对$n说道：请这位"+RANK_D->query_respect(who)
                +"替我除掉在"+strtemp[temp]+"出没的"+
YEL+guaiob->query("name")+"("+
        guaiob->query("id")+")"+NOR", 老夫必有重谢！\n",me,who); 
        return 1;
}

int accountguaiexp(int turn,object who)
{ 

   int userexp,guaiexp;
   userexp=who->query("combat_exp");
      guaiexp=userexp*(10+turn*6)/10; 

   return guaiexp;
}
// guaif 计算怪的内力
int guaif(int turn,object who)
{
   int userneili,guaineili;
   userneili=who->query("max_neili");
   guaineili=userneili*(70+turn*5)/80;
   return guaineili;
}
int guaim(int turn,object who)
{
   int userjingli,guaijingli; 
   userjingli=who->query("max_jingli");
   guaijingli=userjingli*(70+turn*5)/80;
   return guaijingli;
}

int set_guai_qi_jing(int turn,object guai)
{
   int maxqi,maxjing;
   maxqi=guai->query("max_neili")/2;

   maxjing=200+(int)guai->query("max_jingli")*2;
   guai->set_temp("maxqi",maxqi);
   guai->set("max_qi",maxqi);
   guai->set("eff_qi",maxqi);
   guai->set("qi",maxqi);
   guai->set("max_jing",maxjing);
   guai->set("eff_jing",maxjing);
   guai->set("jing",maxjing);
   return 1;
}
//杀怪得到的exp,与玩家的skills ,exp,turn 有关
int getexp(int turn,int level,object who)
{
        int exp,userexp;
        userexp=who->query("combat_exp");
        if(turn<1) turn =1;
 exp=random(1000)+turn*2000+(userexp/5000)*turn+(level*level/2000)*turn*1000;
        return exp;
}

string setguaititle(int number,object guaiob)
{
   if (random(10)>7){
        if (guaiob->query("combat_exp")>2000000)
                guaiob->set("title","杀人狂魔");
        else if (guaiob->query("combat_exp")>1000000)
                guaiob->set("title","恶贯满盈");
        else if (guaiob->query("combat_exp")>500000)
                guaiob->set("title","江洋大盗");
        else if (guaiob->query("combat_exp")>100000)
                guaiob->set("title","大盗");
        else if (guaiob->query("combat_exp")>50000)
                guaiob->set("title","采花贼");     
        else if (guaiob->query("combat_exp")>10000)
                guaiob->set("title","流氓头");  
        else if (guaiob->query("combat_exp")>5000)
                guaiob->set("title","流氓");
        else  guaiob->set("title","小流氓");
        }else {
        switch (number){
                        case 0 :guaiob->set("title","古墓魔女");break;
                        case 1 :guaiob->set("title","峨嵋恶尼");break;
                        case 2 :guaiob->set("title","全真恶道");break;

                        case 3 :guaiob->set("title","武当贼道");break;
                        case 4 :guaiob->set("title","少林恶僧");break;
                        case 5 :guaiob->set("title","白驼淫贼");break;
                        case 6 :guaiob->set("title","丐帮叛徒");break;
                        case 7 :guaiob->set("title","华山恶龙");break;
                        case 8 :guaiob->set("title","星宿老魔");break;
                        case 9 :guaiob->set("title","明教暴徒");break;
                        case 10 :guaiob->set("title","神龙恶徒");break;
                        case 11 :guaiob->set("title","桃花岛弃徒");break;
                        case 12 :guaiob->set("title","逍遥派奸贼");break;
                        case 13 :guaiob->set("title","雪山喇嘛");break;
                        default :guaiob->set("title","小贼");break;
                        }
                }
}


