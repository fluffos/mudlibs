inherit ITEM;
void owner_is_killed() { destruct(this_object()); }

void create() {
  set_name(HIW "仓库备用包" NOR, ({ "bao", }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIW "金庸梦II 仓库备用包，你可以kai bao！\n");
    set("unit", "个");
    set("no_give", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_cun", 1);
    set("no_paimai", 1);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_tilian", "kai");
}
int do_tilian(string arg) {
  object me = this_player();
  mapping fam;

  if (!id(arg)) return 0;
  if (me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

  message_vision("$N打开了仓库备用包" + this_object()->name() +
    ",爽!\n", me);

  me->add("cangku\ckSize", 10);

  tell_object(me, HIY "恭喜你的仓库增加了10格。\n" NOR);


  destruct(this_object());
  return 1;

}
