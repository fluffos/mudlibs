#include <localtime.h>
#include <ansi.h>
inherit ITEM;

//函数生命
int GiveVipItem(object me);

// 函数：所属类别
int query_xy() { return 1; }

//结构函数
void create() {
  set_name(HIY "贵宾卡" NOR, ({ "vip card", "card" }));
  set("long",
    "拥有了这个道具你将成为金庸梦II的VIP贵宾成员。指令：upvip\n"
  );
  set("unit", "张");
}

void init() {
  add_action("do_vip", "upvip");
}

int do_vip(string arg) {
  object me, ob;
  me = this_player();
  ob = this_object();


  if (GiveVipItem(me)) {
    destruct(ob);
    return 1;
  } else {
    tell_object(me, HIR "升级贵宾权限失败，请联系Wiz。\n" NOR);
    return 1;
  }
  return 1;
}

//函数：赠送道具
int GiveVipItem(object me) {
  int time, i;
  mixed localtime;

  object shiyigift;


  if (!me) return 0;

  if (!me->query("jym_level/vip_time")) time = time() + 24 * 3600 * 365;
  else time = me->query("jym_level/vip_time") + 24 * 3600 * 365;
  localtime = localtime(time);

  message_vision(BLINK + HIR "$N成为了金庸梦II VIP贵宾!恭喜恭喜\n" NOR, me);
  tell_object(
    me,
    sprintf(
      HIG "贵宾权限到期时间%d年%d月%d日%d时%d分%d秒。\n" NOR,
      localtime[LT_YEAR],
      1 + localtime[LT_MON],
      localtime[LT_MDAY],
      localtime[LT_HOUR],
      localtime[LT_MIN],
      localtime[LT_SEC]
    )
  );
  me->set("jym_level/vip", 1);
  me->set("jym_level/vip_time", time);
  //me->add("jym_level/vip_level", 1); 这里不增加VIP等级了
  i = 2;
  while (i--) {
    if (shiyigift = new("/u/jerry/vip/jerryck")) shiyigift->move(me);
    tell_object(me, HIY "你获的了仓库备用包!\n" NOR);
  }
  i = 1;
  while (i--) {
    if (shiyigift = new("/u/jerry/vip/czzy1")) shiyigift->move(me);
    tell_object(me, HIY "你获的了成长之羽3小时!\n" NOR);
  }
  i = 12;
  while (i--) {
    if (shiyigift = new("/u/jerry/vip/zhuwutie")) shiyigift->move(me);
    tell_object(me, HIY "你获的了魔睛烛舞铁!\n" NOR);
  }
  if (!present("ji qimao", me) && shiyigift = new("/u/jerry/vip/ckobj")) {
    shiyigift->move(me);

    tell_object(me, HIY "你得到了机器猫。\n" NOR);
  } else tell_object(me, HIY "你已经拥有机器猫了。\n" NOR);
  if (!me->query("jerryvip") && !present("vip dan", me) && shiyigift = new("/u/jerry/vip/vipdan")) {
    shiyigift->move(me);
    tell_object(me, HIY "你得到了金庸梦II VIP起步丹。\n" NOR);
  } else tell_object(me, HIY "你已经拥有或使用过VIP起步丹了。\n" NOR);
  if (!me->query("jerryjym") && !present(
    "room box",
    me
  ) && shiyigift = new("/u/jerry/vip/roombox")) {
    shiyigift->move(me);
    tell_object(me, HIY "你得到了金庸梦II 房间包裹。\n" NOR);
  } else tell_object(me, HIY "你已经拥有或使用过房间包裹了。\n" NOR);
  me->save();
  return 1;

}
