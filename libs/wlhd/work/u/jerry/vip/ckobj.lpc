//edit by rock

#include <ansi.h>
inherit ITEM;

#define CANGKU "/u/rock/cangku"

// 函数：所属类别
int query_xy() { return 1 ; }

void create()
{
        set_name(HIR"机器猫"NOR, ({ "ji qimao" }) );
        set("long",
                "有了它，您就可以随时打开仓库了。\n保存物品：cunck\n取出物品：quck\n设置密码：setpw\n打开仓库：opck\n察看仓库：chack\n"
        );
        set("unit", "个");
}

void init()
{
        add_action("do_cunck", "cunck");
        add_action("do_quck","quck");
        add_action("do_setpw","setpw");
        add_action("do_opck","opck");
        add_action("do_chack","chack");
        
}

int do_cunck()
{
        return CANGKU->do_cun();
}

int do_quck()
{
        return CANGKU->do_qu();
}

int do_setpw()
{
        return CANGKU->set_password();
}

int do_opck()
{
        return CANGKU->open_cangku();
}

int do_chack()
{
        return CANGKU->do_look();
}
