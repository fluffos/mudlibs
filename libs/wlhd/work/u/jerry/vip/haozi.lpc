#include <localtime.h>
#include <ansi.h>
inherit NPC;

//函数声明
int ask_1xiaoshi();
int ask_2xiaoshi();
int ask_3xiaoshi();
int ask_4xiaoshi();
int ask_vipmoney();
void do_vip_exp(object me, int vip_time);

//函数：结构函数
void create() {
  set_name(HIR "小耗子" NOR, ({ "xiao haozi", "haozi" }));
  set("nickname", HIY "贵宾VIP双倍领取" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是小耗子礼物使者，向他打听“贵宾VIP双倍领取”，来获得贵宾VIP双倍领取奖励。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 999999999);
  set("str", 300);
  set("dex", 300);
  set("con", 300);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("jingli", 21000000);
  set("score", 100000);
  set("no_suck", 1);

  set("inquiry", ([
    "1小时": (: ask_1xiaoshi :),
    "2小时": (: ask_2xiaoshi :),
    "3小时": (: ask_3xiaoshi :),
    "4小时": (: ask_4xiaoshi :),
    "VIP工资": (: ask_vipmoney :),
  ]));
  setup();
}

//函数：时间检查
void check_date(object me) {
  mixed *mixTime;
  mixTime = localtime(time());

  if (mixTime[LT_MDAY] != me->query("vip_tow_time")) {
    me->set("vip_tow_time", mixTime[LT_MDAY]);
    me->delete("jerryxiaoshi");
  }
  if ((mixTime[LT_MON] + 1) != me->query("vipmon_time")) {
    me->set("vipmon_time", mixTime[LT_MON] + 1);
    me->delete("jerrygz");
  }
}

int ask_1xiaoshi() {
  object me = this_player();
  check_date(me);
  do_vip_exp(me, 1);
  return 1;
}

int ask_2xiaoshi() {
  object me = this_player();
  check_date(me);
  do_vip_exp(me, 2);
  return 1;
}

int ask_3xiaoshi() {
  object me = this_player();
  check_date(me);
  do_vip_exp(me, 3);
  return 1;
}

int ask_4xiaoshi() {
  object me = this_player();
  check_date(me);
  do_vip_exp(me, 4);
  return 1;
}

//函数：给予贵宾相应奖励
void do_vip_exp(object me, int vip_time) {
  object item;
  int tow_time;

  if (!me->query("jym_level/vip")) {
    tell_object(me, "抱歉！你不是贵宾,不能获得双倍经验时长。请购买贵宾后再来领取。\n");
    return;
  }

  tow_time = me->query("jerryxiaoshi");
  if (tow_time > 4) {
    tell_object(me, "您今天的双经验已经领完了，请明天在来吧!\n");
    return;
  }

  if ((tow_time + vip_time) > 4) {
    tell_object(me, sprintf("抱歉，你最多只能领取%d小时双倍经验!\n", 4 - tow_time));
    return;
  }

  if (item = new(sprintf("/u/jerry/vip/jerryczzy%d", vip_time))) {
    item->move(me);
    tell_object(me, sprintf(HIY "你获的了成长之羽%d小时的双倍经验!\n" NOR, vip_time));
    me->add("jerryxiaoshi", vip_time);
    me->save();
  } else {
    tell_object(me, "对不起，领取失败，请与WIZ联系。\n");
    return;
  }
}
int ask_vipmoney() {
  object me;
  me = this_player();

  if (!me->query("jym_level/vip")) {
    tell_object(me, "得了吧,请加入VIP先！\n");

    return 1;
  }
  check_date(me);

  if (me->query("jerrygz")) {
    tell_object(me, "对不起，本月以领取,下个月又来！\n");
    return 1;
  }
  me->add("jym_money", 100000);
  tell_object(me, "本月领取工资得到十万元宝！\n");
  me->set("jerrygz", 1);
  me->save();
  return 1;

}
