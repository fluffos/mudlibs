#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "五星红旗" NOR, ({ "wuxing hongqi", "hongqi" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
                ┌──────────────────────┐ 
                │                                            │ 
                │  国庆佳节. 《武林浩荡》巫师组                      │ 
                │                                            │ 
                │         恭祝所有玩家:                      │ 
                │                                            │ 
                │                  国庆节快乐!               │ 
                │                                            │ 
                │                          幸福美满!         │ 
                │                                            │ 
                │                                            │ 
                └──────────────────────┘ 
红旗，请yaohuang hongqi！
LONG
    );
    set("no_get", 1);
    set("ty_gift", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("unit", "块");
  }
}

void init() {
  add_action("do_eat", "yaohuang");
}

int do_eat(string arg) {
  object me;

  me = this_player();
  if (!id(arg))
    return notify_fail("你要摇什么？\n");
  if (me->query("mud_age") < 86400)
    return notify_fail("对不起,未成年人需经过家长允许！\n");


  if (me->query("tygift/20051001eat"))
    tell_object(me, "摇多了会虚脱的！\n");
  else {
    message_vision("$N努力摇了摇手中的" + this_object()->name() +
      "。\n", me);



    tell_object(me, BLINK + HIR "《武林浩荡》巫师组恭祝您：国庆节快乐!!\n" NOR);
    me->add("kar", 1);
    me->add("int", 1);
    me->add("str", 1);
    me->add("con", 1);
    me->add("dex", 1);
    me->add("per", 1);
    me->add("potential", 200000);
    me->add("combat_exp", 3000000);
    me->add("food", 10000);
    me->add("water", 10000);
    me->set("tygift/20051001eat", 1);

    destruct(this_object());
    return 1;
  }
}
