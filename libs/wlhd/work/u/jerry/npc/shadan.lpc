// edit by rock&jym
// 2002.7.7

inherit NPC;
#include <ansi.h>

int ask_me();
int get_gift();

void create()
{
        set_name("傻蛋超人", ({"super man", "super", "man"}));
        set("gender", "男性");
        set("nickname", HIR"傻蛋超人"HIW"(ask man about 傻蛋)"NOR);
set("doing",1);
        set("age", 30000);
        set("inquiry", ([
                         "傻蛋" : (: ask_me :),
         ]) );

       setup();
        carry_object("/clone/cloth/cloth")->wear();
}

int do_get_gift(string arg, object me)
{ 
   int exp, dj = me->query("jym_level/level");  
 
   if( !arg ) {
   tell_object(me,HIC"    您可以使用 A B C D 来选择你想得到的礼物\n"NOR);
        input_to((:do_get_gift:), me);
   return 1;
    }

   if ((int) me->query("tygift/20050501"))
   return notify_fail(BLINK HIR"我虽然傻，但是还不糊涂，已经拿过礼物了，还想拿呀!\n"NOR);

   if( dj > 1)
{
   if ( dj == 2 ) exp=(int)me->query("combat_exp")+10000000; 
   if ( dj == 3 ) exp=(int)me->query("combat_exp")+30000000; 
   if ( dj == 4 ) exp=(int)me->query("combat_exp")+60000000; 
   if ( dj == 5 ) exp=(int)me->query("combat_exp")+100000000; 
   if ( dj == 6 ) exp=(int)me->query("combat_exp")+150000000; 
   if ( dj == 7 ) exp=(int)me->query("combat_exp")+210000000; 
   if ( dj == 8 ) exp=(int)me->query("combat_exp")+280000000;
   if ( dj == 9 ) exp=(int)me->query("combat_exp")+360000000;
   if ( dj ==10 ) exp=(int)me->query("combat_exp")+450000000;
   if ( dj > 10 ) 
exp=(int)me->query("combat_exp")+(450000000+((dj-10)*100000000));
}
else {
exp = (int)me->query("combat_exp");
}

   if( arg == "A") 
{
   me->add("max_neili",me->query_max_neili()/10);
   me->set("tygift/20050501",1);
   tell_object(me,HIC"您拿到了十分之一内力最大值的礼物!\n"NOR);
       return 1;    
}  
   if( arg == "B") 
{         
   me->add("max_jingli",me->query_max_jingli()/10);
   me->set("tygift/20050501",1);
   tell_object(me,HIC"您拿到了十分之一精力最大值的礼物!\n"NOR);
       return 1;    
} 

   if( arg == "C") 
{         
   me->add("combat_exp",exp/20);
   me->set("tygift/20050501",1);
   tell_object(me,HIC"您拿到了二十分之一实际经验值的礼物!\n"NOR);
       return 1;    
}  

   if( arg == "D") 
{         
   me->add("combat_exp",exp/60);
   me->add("max_jingli",me->query_max_jingli()/30);
   me->add("max_neili",me->query_max_neili()/30);
   me->set("tygift/20050501",1);
   tell_object(me,HIC"您拿到了三十分之一内力最大值的礼物!\n"NOR);
   tell_object(me,HIC"您拿到了六十分之一实际经验值的礼物!\n"NOR);
   tell_object(me,HIC"您拿到了三十分之一精力最大值的礼物!\n"NOR);
       return 1;    
}
   write(HIC"    您可以使用 A B C D 来选择你想得到的礼物\n"NOR);
        input_to((:do_get_gift:), me);
   return 1;
  
}
int ask_me()
{
        object me = this_player();
        
  if (me->query("tygift/20050501"))
{
write(BLINK HIR"我虽然傻，但是还不糊涂，已经拿过礼物了，还想拿呀!\n"NOR);
return 1;
}
      else
        {
        write(HIC"一共有四样礼物，请选择你想得到的礼物!\n\n"NOR
              HIG"<A> 内力最大值增加十分之一!\n"NOR
              HIY"<B> 精力最大值增加十分之一!\n"NOR
              HIM"<C> 实际经验值增加二十分之一(包括升级用了的经验值)!\n"NOR
              HIR"<D> 内力最大值增加三十分之一，精力最大值增加三十分\n"
              HIR"    之一，实际经验值增加六十分之一!\n\n"NOR
              HIC"    您可以使用 A B C D 来选择你想得到的礼物\n"NOR
              HIY"附注:你选择其中一项奖励就无法拿其他三项奖励了，请考虑好!\n"NOR);
         input_to((:do_get_gift:), me);    
              return 1;
        }
}


