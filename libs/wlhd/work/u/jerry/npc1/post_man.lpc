// 宝石商人
#include <ansi.h>
#include <localtime.h>
inherit NPC;

#define POST_MSG "/data/sd_msg.txt"

//函数声明
int do_ask();
int do_look();

void create() {
  string msg, *temp_msg, name, id, riqi, post;
  int i, size;
  object npc;

  set_name(HIY "祝福女神" NOR, ({ "nv shen" }));

  set("gender", "女性");
  set("title", HIR "新年的祝福" NOR);
  set("long", "一位神界的天使，听说把你的祝福告诉他，你也将会得到祝福。\n");
  set("no_kill", 1);
  set("no_fight", 1);
  set("no_get", 1);

  set("inquiry", ([
    "新年的祝福": (: do_ask :),
    "查看新年祝福": (: do_look :),
  ]));

  setup();
  carry_object("/clone/cloth/cloth")->wear();

  npc = this_object();
  if (msg = read_file(POST_MSG)) {
    temp_msg = explode(msg, "\n");
    size = sizeof(temp_msg);
    for (i = 0; i < size; i++) {
      if (sscanf(temp_msg[i], "Title: %s(%s)%s Post: %s", name, id, riqi, post) == 4) {
        npc->set(id, temp_msg[i]);
      }
    }
  }
}

int do_ask() {
  object me;
  me = this_player();

  if (me->query("sd_zhufu")) {
    tell_object(me, "你已经得到了新年的祝福。\n");
    return 1;
  }
  if (me->query("age") < 20) {
    tell_object(me, "你的年龄不足，只有老玩家才可以祝福别人。\n");
    return 1;
  }
  tell_object(me, "请输入您祝福的话:\n");
  input_to("do_post", me);
  return 1;
}

int do_post(string msg, object me) {
  object npc;
  mixed time;
  string str, temp = "";
  int size, i;

  if (!me) return 0;

  size = strlen(msg);
  if (!msg || size > 1024) {
    tell_object(me, "不符合标准的祝福，请重新输入:\n");
    input_to("do_post", me);
    return 1;
  }

  for (i = 0; i < size; i++) {
    if (i + 1 <= size) {
      if (sprintf("%c%c", msg[i], msg[i + 1]) == "\n") {
        msg[i] = 0;
      }
    }
    temp += sprintf("%c", msg[i]);
  }

  time = localtime(time());
  str = sprintf(
    "Title: %s(%s)写于%d年%d月%d日 Post: %s\n",
    me->query("name"),
    me->query("id"),
    time[LT_YEAR],
    1 + time[LT_MON],
    time[LT_MDAY],
    msg
  );
  //存到NPC身上。
  npc = this_object();
  npc->set(sprintf("%s", me->query("id")), str);
  //保存到文件
  write_file(POST_MSG, str);
  me->set("sd_zhufu", 1);
  me->add("jym_money", 880000);
  tell_object(me, HIY "祝福已经记录，你获得了八十八万元宝。\n" NOR);
}

int do_look() {
  object me;
  me = this_player();

  tell_object(me, "您要查询哪个ID的祝福留言:\n");
  input_to("do_look2", me);
  return 1;
}

int do_look2(string id, object me) {
  object npc;
  string msg, name, str;

  npc = this_object();

  msg = (string)npc->query(id);
  if (!id || !msg) {
    tell_object(me, "这个玩家尚未留言。\n");
    return 1;
  }

  if (sscanf(msg, "Title: %s Post: %s", name, str) != 2) {
    tell_object(me, "数据格式错误，无法读取该玩家留言。\n");
    return 1;
  }
  tell_object(
    me,
    sprintf("%s\n-------------------------------------------------\n%s\n", name, str)
  );
  return 1;
}
