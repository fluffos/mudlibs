inherit NPC;
void create() {
  set_name(HIR "邪恶巫师" NOR, ({ "jkiller", "shashou" }));
  set("gender", "男性");
  set("age", 30);
  set("long", "他是心魔手下,从一出生就没做过什么好事。\n");
  set("attitude", "aggressive");
  set("str", 200 + random(10));
  set("int", 265);
  set("con", 265);
  set("dex", 265);
  set("kar", 265);
  set("shen_type", -1);
  set("qi", 8000);
  set("max_qi", 8000);
  set("jing", 4000);
  set("max_jing", 4000);
  set("neili", 8000);
  set("max_neili", 8000);
  set("jym_level/level", 20);
  set("jiali", 200);
  set("combat_exp", 50000000);
  set("score", 10000);
  set_skill("force", 2000);
  set_skill("dodge", 2250);
  set_skill("parry", 2040);
  set_skill("sword", 2040);
  set_skill("unarmed", 2050);
  set_skill("dabei-zhang", 1550);
  set_skill("damo-force", 1500);
  set_skill("guxing-sword", 1540);
  set_skill("literate", 1800);
  set_skill("langzi-sword", 1500);
  set_skill("piaomiao-shenfa", 1650);
  map_skill("unarmed", "dabei-zhang");
  map_skill("force", "damo-force");
  map_skill("dodge", "piaomiao-shenfa");
  map_skill("parry", "dabei-zhang");
  map_skill("sword", "langzi-sword");
  prepare_skill("sword", "langzi-sword");

  set("chat_msg_combat", ({
    (: perform_action, "sword.lian" :),
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.sui" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}
void init() {
  call_out("findPlayer", 3);  //寻敌
}
void die() {
  object item, me, ob;
  string item_file;
  item_file = "/clone/shoufei/product"->get_random_level_product(
    1 + random(15),
    me->query("jym_level/level"),
    me->query("jym_level/level") + 5
  );

  if (item_file) {
    item = new(item_file);
    if (item) {
      ob = this_object();  //NPC
      me = ob->query_temp("last_damage_form");  //玩家
      "/adm/item/equip"->init_equip_prop_1(item);  //变更装备品质

      item->move(environment(ob));
    }
  }

}

//函数：寻敌
void findPlayer() {
  object map, *players, ob;
  int i, size, rand;

  ob = this_object();
  map = environment(ob);
  players = all_inventory(map);

  size = sizeof(players);
  rand = random(size);
  if (userp(players[rand])) ob->kill_ob(players[rand]);
  call_out("findPlayer", 1 + random(30));
}
