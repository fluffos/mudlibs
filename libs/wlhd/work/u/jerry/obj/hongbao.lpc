#include <ansi.h>

inherit ITEM;

void init()
{
        add_action("do_chai", "chai");
}

void create()
{
        set_name(HIR"红包"NOR, ({ "hongbao"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                 set("long", "chai hongbao,一个红包，运气好的话你会得到利是钱，反之你会减少exp!\n");
                set("ty_gift", 1);
                set("no_get", 1);
                set("no_give", 1);
                set("no_drop",1); 

        }
        setup();
}

int do_chai(string arg)
{
        int qian ;

        object me = this_player();

        qian = random(2000);

        if (!arg)
        return notify_fail("你要打开什么？\n");

             if ( random(28) > 2 )
        {
             me->add("jym_money",qian);

message_vision(HIY "$N悄悄地打开了红包，运气真好！得到了"+chinese_number(qian)+"元宝。\n" NOR, this_player());
        }
        else
message_vision(HIC "$N打开红包，一股寒气包围了你，唉，看来新年运气不好！\n" NOR,this_player());
              me->add("combat_exp",-random(10));

        destruct(this_object());
        return 1;
}


