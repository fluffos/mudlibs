#include <ansi.h>
#include <localtime.h>
inherit ITEM;

#define NEED_TIME 24

//函数声明
void check_time(object me);

// 函数：所属类别
int query_xy() { return 1 ; }

void create()
{
        set_name(HIC"成长之羽24小时"NOR, ({ "cz yu24" }) );
        set("long","有了它，你的成长将会更加顺利。有效期24小时");
        set("unit", "个");
        set("no_put", 1);
        set("no_give", 1);
}

void init()
{
        object ob,me;
        int time,lotime;
        mixed localtime;
        
        ob = this_object();
        me = this_player();
        time = time() + NEED_TIME * 3600;
        lotime = ob->query("localtime");
        if(!lotime) lotime = time;
        if(lotime <= time())
        {
                ob->set("long","道具已经到期，请做丢弃处理。\n");
                return;
        }
        me->set_temp("temp_exp",me->query("combat_exp"));
        me->set_temp("temp_pot",me->query("potential"));

                localtime = localtime(lotime);
                ob->set("long",sprintf("有了它，您的成长将会更加顺利。\n"HIY"道具到期时间:%d月%d日 %d:%d\n"NOR,1+localtime[LT_MON],localtime[LT_MDAY],localtime[LT_HOUR],localtime[LT_MIN]));

        ob->set("localtime",time);
        call_out("check_time",30,me);
}

//函数：心跳
void check_time(object me)
{
        int old_exp,add_exp;
        int old_pot,add_pot;
        object ob;
        
        ob = this_object();
        if(ob->query("localtime") <= time())
        {
                ob->set("long","道具已经到期，请做丢弃处理。\n");
                return;
        }

        old_exp = me->query_temp("temp_exp");
        add_exp = me->query("combat_exp",1) - old_exp;
        old_pot = me->query_temp("temp_pot");
        add_pot = me->query("potential",1) - old_pot;

        if(add_exp >= 5000000)
        {
                me->set_temp("temp_exp",me->query("combat_exp"));                
        }
        if(add_pot >= 5000000)
        {
                me->set_temp("temp_pot",me->query("potential"));
        }
        else if(add_exp > 0)
        {
                me->add("combat_exp",add_exp);
                me->set_temp("temp_exp",me->query("combat_exp"));                
                tell_object(me,sprintf(HIY"您额外获得了%d点经验。\n"NOR,add_exp));                
        }
        else if(add_pot > 0)
        {
                me->add("potential",add_pot);
                me->set_temp("temp_pot",me->query("potential"));
                tell_object(me,sprintf(HIY"您额外获得了%d点潜能。\n"NOR,add_pot));
        }
        call_out("check_time",30,me);
}
