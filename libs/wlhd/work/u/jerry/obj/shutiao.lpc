inherit ITEM;
void create()
{
        set_name(HIY"薯条"NOR, ({ "shu tiao","tiao"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
               set("long", HIY"薯条，看来不是普通之物，必是仙家精品，吃了肯定不错！\n");
                set("unit", "罐");
                set("ty_gift", 1);
                set("no_get", 1);
                set("no_give", 1);
                set("no_drop",1); 

                 set("value",0);
        }
    setup();
}
void init()
{
    if (environment()==this_player())
         add_action("do_tilian", "eat");
}
int do_tilian(string arg)
{
  object me = this_player(); 
  if(!id(arg)) return 0;
  if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

               
              message_vision(HIW"$N一口吃下薯条，感觉自己的属性都增强了。\n"NOR,me);
              me->add("str",1);
              me->add("con",1);
              me->add("dex",1);
              me->add("kar",1);
              me->add("per",1);
              me->add("int",1);

 destruct(this_object());
       return 1;
}

