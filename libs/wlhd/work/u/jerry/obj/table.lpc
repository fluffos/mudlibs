#include <ansi.h>
#define LAST_PAR "tygift/20040927"
#define THIS_PAR "tygift/20040927"
inherit ITEM;
void create() {
  set_name(HIY "观月台" NOR, ({ "table" }));
  set_weight(5000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("no_get", "这个观月台是大家赏月用的，你好意思搬走？");
    set("long", "一张漂亮观月添，上面放满了大量的月饼，大家快拿(pick gift)啊！");
    set("value", 0);
    set("material", "stone");
  }
}
void init() {
  add_action("do_pick", "pick");
}

int do_pick(string arg) {
  object me, obj;
  me = this_player();
  if (!arg || arg != "gift") return notify_fail("你要拿什么？\n");


  if (me->query(THIS_PAR + "_pick") || me->query("age") < 16) {
    tell_object(me, CYN "小志的身影突然出现在一阵烟雾之中。\n\n");
    tell_object(me, HIR "小志一巴掌敲在你手上：小朋友，每人只有一份礼物！\n\n");
    tell_object(me, CYN "只见一阵烟雾过後，小志的身影已经不见了。\n" NOR);
    tell_object(me, HIY "如果你的年龄小于16岁（不包括16岁），那请等你16岁了再来拿。\n" NOR);
    return 1;
  }
  obj = new(__DIR__ "yuebing2");
  obj->move(me);
  message_vision("$N从观月台上拿起一块月饼。\n", me);
  me->set(THIS_PAR + "_pick", 1);
  me->start_busy(2);
  return 1;
}
