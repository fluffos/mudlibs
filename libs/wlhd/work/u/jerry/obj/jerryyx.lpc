#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
     set_name(HIR"元宵使者"NOR, ({ "jerry shizhe", "shizhe" }) );
         set("nickname", HIY"《武林浩荡》欢迎您的到来"NOR);
        set("gender", "男性" );
        set("age", 18);
         set("long",YEL"这位是〖《武林浩荡》〗的使者，向他打听“元宵节日快乐”，你会有意想不到的惊喜……。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 999999999);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
        set("int", 30);
        set("per", 30);
        set("max_qi", 100000);
        set("neili", 100000);
        set("jingli",21000000);
        set("score", 100000);

        set("inquiry", ([
                         "元宵节日快乐" : (: ask_me :),
        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
  command("whisper " + ob->query("id") + " "HIW"欢迎光临〖《武林浩荡》〗"+HIR+"(ask shizhe about 元宵节日快乐)\n"+NOR+HIW+"，．"NOR);
                       call_out("greeting", 2);

}

string ask_me()
 {
        object me = this_player();
        object obj1;
        mapping fam; 
        
         if ((int) me->query("jerry/20090209")|| me->query("age") < 14)
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
               else
        {
                me->set("jerry/20090209", 1);
                obj1 = new ("/u/jerry/obj/lanternfestival");
                obj1->move(me);
                me->save();
                tell_object(me, HIR "《武林浩荡》恭祝：元宵节日快乐！。\n" NOR);
                tell_object(me, HIW "恭喜你，你得到《武林浩荡》汤圆上个。\n" NOR);


                return "《武林浩荡》巫师组"NOR+HIR"〖恭祝您〗"NOR":元宵节日快乐！\n"NOR;;
        }
}


