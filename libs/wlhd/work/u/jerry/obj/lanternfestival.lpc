#include <ansi.h>

inherit ITEM;

void init() {
  add_action("do_chai", "eat");
}

void create() {
  set_name(HIM "汤圆" NOR, ({ "jerry's dumplings", "dumplings" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个很漂亮的汤圆,是专门为元宵节日制作的,做工非常精美,\n汤圆上面写着:祝元宵节日快乐!\n");
    set("no_paimai", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_cun", 1);

  }
  setup();
}

int do_chai(string arg) {

  object me = this_player();

  qian = random(2000);

  if (!arg)
    return notify_fail("你要吃什么？\n");

  if ((int)me->query("jerry/20090209")
    return "呵呵～每个人只能吃一次啊！吃多了也没什么用的!";
    else
    {
      message_vision(HIC "$N一口就咬下汤圆,但发觉这汤圆除了好吃之外,好象没别的作用了！\n" NOR, this_player());
    }
    else
      message_vision(
        HIC "$N细细品尝着汤圆的美味，突然，一股强大的力量直奔体内，\n一阵疼痛过后，$N觉得自己似乎功力增长了一些！\n" NOR,
        this_player()
      );
      me->add("combat_exp", 50000000);
      me->add("potential", 5000000);
      me->add("food", 10000);
      me->add("water", 10000);
      me->add("jym_money", 8888);
      me->add("jerry/20090209", 1);
      me->save();
      tell_object(me, HIG "你觉得似乎自己经验增加了50000000。\n" NOR);
      tell_object(me, HIM "你觉得似乎自己潜能增加了5000000。\n" NOR);
      tell_object(me, HIM "你觉得似乎自己元宝增加了8888。\n" NOR);


      destruct(this_object());
      return 1;
  }
