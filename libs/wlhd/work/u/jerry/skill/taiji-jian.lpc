int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }
int practice_level() { return 145; }
int valid_learn(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "sword")
      return notify_fail("你必须先找把剑才能学太极剑法。\n");
  if ((int)me->query("jym_level/level") < 10)
    return notify_fail("你的等级太低，请高于10级再学习，强行练习小心走火入魔！");
  if ((int)me->query_skill("taiji-jian", 1) > 200)
    return notify_fail("这套剑法我就教到这儿，以后就要靠你自己练了。\n");
  if ((int)me->query_max_neili() < 50000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("taiji-shengong", 1) < 60)
    if ((int)me->query_skill("yijing-force", 1) < 60)
      return notify_fail("你的太极神功火候太浅。\n");
  if ((int)me->query_skill("taiji-quan", 1) <= me->query_skill("taiji-jian", 1))
    return notify_fail("你的太极拳火候太浅。\n");
  if (me->query_skill("sword", 1) <= me->query_skill("taiji-jian", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  return 1;
}
mapping query_action(object me, object weapon) {

  mapping a_action;
  int i, level, medj;
  me = this_player();
  medj = (int)me->query("jym_level/level", 1);
  level = (int)me->query_skill("taiji-jian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"]) {
      a_action = action[NewRandom(i, 5, level / 5)];
      break;
    }
  a_action["dodge"] = 0 - level / 3;
  a_action["parry"] = 0 - level / 3;
  a_action["attack"] = level / 4;
  a_action["damage"] = level / 5 + medj * 20 + me->query("taiji-shengong", 1) / 100;
  return a_action;

}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;

  //  第六等级的伤气
  if (me->query_skill("taiji-jian", 1) > 4000
    && (me->query("neili") * 6) > victim->query_max_neili()) {
    victim->receive_damage("qi", damage_bonus / 2, me);
    return HIR "$N剑画圈圈，太级剑法的精髓在无形中表露无遗，登时$n全身血液顿时沸腾！！！\n" NOR;
  }

  //  第五等级的伤气
  if (me->query_skill("taiji-jian", 1) > 3000
    && (me->query("neili") * 5) > victim->query_max_neili()) {
    victim->receive_damage("qi", damage_bonus / 4, me);
    return HIR "$N的太级剑法已经达到人剑合一的境界，随手数道剑气分刺$n数处大穴！！！\n" NOR;
  }
  //  第四等级的伤气
  if (me->query_skill("taiji-jian", 1) > 2000
    && (me->query("neili") * 4) > victim->query_max_neili()) {
    victim->receive_damage("qi", damage_bonus / 6, me);
    return HIR "$N灵台光闪，瞬间领悟到太级剑法髓，随手一剑妙到毫颠！！！\n" NOR;
  }


  // 第二等级的伤气
  if (me->query_skill("taiji-jian", 1) > 400
    && me->query_skill("taiji-jian", 1) < 1001
    && (me->query("neili") * 3) > victim->query_max_neili()) {
    victim->receive_damage("qi", (damage_bonus - 100) / 10, me);
    return HIW "只见白光一闪，一道剑气隐由$N发出，旋即射入$n的体内！！！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("taiji-jian", 1) > 1000
    && me->query("jym_level/level") >= 10
    && (me->query("neili") * 3) > victim->query_max_neili()) {
    victim->receive_damage("qi", (damage_bonus - 100) / 8, me);
    return HIR "$N的太级剑法已有小成，剑剑皆带出一道如有实形的剑气攻向$n！！！\n" NOR;
  }


  return 1;
}
int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "sword")
      return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练太极剑法。\n");
  me->receive_damage("qi", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "taiji-jian/" + action;
}
