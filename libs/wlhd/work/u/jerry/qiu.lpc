// edit by rock&jym  /2004/06/18/
// 新的赌局设定好后请记得rm /data/zuqiu.o

#define A  "中国"      //球队A
#define B  "韩国"      //球队B
#define E    1         //A的赔率
#define C    2         //A比B的赔率
#define D    2         //A比B的为平的比率
#define F    20041008         //分辨每期下注
#define ID  "jerry"      //坐庄玩家ID名
#define MAX  10000000     //投入本钱
#define DAAN "日本"    //最后胜利的球队,总共有A,B,"平" 三种，请根据实际比赛情况填写，方便玩家拿取赢得的元宝
#define PD   1      //球赛即将开始，停止下注就定义为 1,下注时间定义为 0

inherit NPC;
inherit F_SAVE;
inherit F_MASTER;

#include <ansi.h>

string ask_form();
int piao_form();

string query_save_file()
{
        return DATA_DIR + "zuqiu";
}

void create()
{
  seteuid(getuid());
    if (!restore()) {
        set_name("赌球代理商", ({"duqiu npc", "duqiu", "npc"}));
        set("gender", "男性");
        set("nickname", HIG"《武林浩荡》赌球代理商"NOR);
        set("age", 1000);
        set("long",
                "他是方舟派出的代理商。\n"
                "您可以花元宝来赌博!。\n");

        set("inquiry", ([
                "行情"       : (: piao_form :),
//                 "赌球"       : (: du_form :),
        ]) );
        setup();
}    else { 
        set_name("赌球代理商", ({"duqiu npc", "duqiu", "npc"}));
        set("gender", "男性");
        set("nickname", HIG"《武林浩荡》赌球代理商"NOR);
        set("age", 1000);
        set("long",
                "他是方舟派出的代理商。\n"
                "您可以花元宝来赌博!。\n");

        set("inquiry", ([
                "行情"       : (: piao_form :),
         ]) );

       setup();
        carry_object("/clone/cloth/cloth")->wear();
}
}

void init()
{
  add_action("do_toupiao","ya");
  add_action("do_naqu","naqu");
} 
int do_toupiao(string arg)
{ 
         object me = this_player(); 
         int str;
        if( !arg )
   return notify_fail("您只能按 ya "+A+" <money> 或者 ya  平 <money> 或者 ya "+B+" <money>!\n");
 
   if( sscanf(arg, "%s %d", arg, str)!=2 ) 
   return notify_fail("您只能按 ya "+A+" <money> 或者 ya  平 <money> 或者 ya "+B+" <money>!\n");

   if( str < 1 ) return notify_fail("你想用Bug啊?\n");
   if (str>me->query("jym_money"))
   return notify_fail("您的钱庄里没那么多元宝!\n");
   if (str> 50000)
   return notify_fail("对不起，每人最多只能押5W!\n");

   if (query(A)+str>MAX)
   return notify_fail("对不起买"+A+"的只有"+MAX+"的陪出了，请不要超过了!\n");

   if (query(B)+str>MAX)
   return notify_fail("对不起买"+B+"的只有"+MAX+"的陪出了，请不要超过了!\n");

   if (query("平")+str>MAX)
   return notify_fail("对不起买平的只有"+MAX+"的陪出了，请不要超过了!\n");

   if ( me->query("duqiu/3"+F+A) || me->query("duqiu/3"+F+B) || me->query("duqiu/3"+F+A+B) )
   return notify_fail("您已经投过票了!\n");

   if ( DAAN == A || DAAN == B || DAAN == "平" ) return notify_fail("现在已经有答案了你还想买啊?\n");

   if ( PD != 0 ) return notify_fail("球赛即将开始，停止下注！\n");

   if ( me->query("duqiu") )  me->delete("duqiu");

   if( arg == A ) 
{
this_object()->add(A,str*E);
this_object()->save();
me->set("duqiu/3"+F+A,str*E); 
me->add("jym_money",-str); 
tell_object(me,HIC"您买了"+A+str+"枚元宝!\n"NOR);
CHANNEL_D->do_channel( this_object(), "chat",HIG"赌球快报："+me->query("name")+"["+me->query("id")+"]。买了"+A+str+"枚元宝!"NOR); 

       return 1;    
}  

   if( arg == B ) 
{
this_object()->add(B,str*C);
this_object()->save();
me->set("duqiu/3"+F+B,str*C); 
me->add("jym_money",-str); 
tell_object(me,HIC"您买了"+B+str+"枚元宝!\n"NOR);
CHANNEL_D->do_channel( this_object(), "chat",HIG"赌球快报："+me->query("name")+"["+me->query("id")+"]。买了"+B+str+"枚元宝!"NOR); 

       return 1;    
}  
/*
   if( arg == "平") 
{         

this_object()->add("平",str*D);
this_object()->save();
me->set("duqiu/3"+F+A+B,str*D);
me->add("jym_money",-str);
tell_object(me,HIC"您买了平"+str+"枚元宝!\n"NOR);
CHANNEL_D->do_channel( this_object(), "chat",HIG"赌球快报："+me->query("name")+"["+me->query("id")+"]。买了平"+str+"枚元宝!"NOR); 


       return 1;    
}  
*/
}
int do_naqu(string arg)
{ 
         object ob, me = this_player(); 
         ob = this_object();

         if ( DAAN != A && DAAN != B && DAAN != "平" ) return notify_fail("谁赢谁输还不知道呢!\n");

         if ( DAAN == A && me->query("duqiu/3"+F+A) )
         {
                 me->add("jym_money",me->query("duqiu/3"+F+A));
                 me->add("jym_money",me->query("duqiu/3"+F+A)/E); //本钱
//                 ob->add(A,-me->query("duqiu/3"+F+A));
                  ob->add(ID,me->query("duqiu/3"+F+A));//记录已赔出money金额
                 ob->save();
                 write(HIG"你共拿取了赌球所赢的"+me->query("duqiu/3"+F+A)+"枚元宝!\n"NOR);
                 me->delete("duqiu");                 
                 return 1;
         }

         if ( DAAN == B && me->query("duqiu/3"+F+B) )
         {
                 me->add("jym_money",me->query("duqiu/3"+F+B));
                 me->add("jym_money",me->query("duqiu/3"+F+B)/C);//本钱
//                  ob->add(A,-me->query("duqiu/3"+F+A));
                  ob->add(ID,me->query("duqiu/3"+F+B));//记录已赔出money金额
                 ob->save();
                 write(HIG"你共拿取了赌球所赢的"+me->query("duqiu/3"+F+B)+"枚元宝!\n"NOR);
                 me->delete("duqiu");
                 return 1;
         }

         if ( DAAN == "平" && me->query("duqiu/3"+F+A+B) )
         {
                 me->add("jym_money",me->query("duqiu/3"+F+A+B));
                 me->add("jym_money",me->query("duqiu/3"+F+A+B)/D);//本钱
//                  ob->add(A,-me->query("duqiu/3"+F+A));
                 ob->add(ID,me->query("duqiu/3"+F+A+B));//记录已赔出money金额
                 ob->save();
                 write(HIG"你共拿取了赌球所赢的"+me->query("duqiu/3"+F+A+B)+"枚元宝!\n"NOR);
                 me->delete("duqiu");
                 return 1;
         }
         return notify_fail("您押的球队好象没胜利吧？\n");
}

int piao_form()
{
  object ob;
  object me = this_player();

ob = this_object();
 
tell_object(me,HIC"当前下注情况如下\n"NOR
HIR"买"+A+"的共有"+ob->query(A)/E+"枚元宝!\n"NOR 
HIW"买"+B+"的共有"+ob->query(B)/C+"枚元宝!\n"NOR
HIG"买平的共有"+ob->query("平")/D+"枚元宝!\n\n"NOR
HIR"如果"+A+"胜利预计赔出"+ob->query(A)+"枚元宝!\n"NOR 
HIW"如果"+B+"胜利预计赔出"+ob->query(B)+"枚元宝!\n"NOR
HIG"如果平的话预计赔出"+ob->query("平")+"枚元宝!\n\n"NOR
HIY"当前坐庄玩家："+ID+"\n"NOR
HIY"赔率为"+A+"胜利1赔"+E+","+B+"胜利1赔"+C+"，为平时赔率为1赔"+D+"\n"NOR
HIY"坐庄金额："+MAX+"枚元宝\n\n"NOR
HIC"下注方法：\n"NOR
HIC"ya "+A+" <Money>或者 ya 平 <money> 或者 ya "+B+" <money>指令来下注。\n"NOR
HIR"赢得比赛后，取回请使用naqu指令。\n\n"
BLINK+HIR"特别注意："NOR+HIG"本次竞猜为谁是冠军，包括90分钟后加时或点球的结果！。\n\n"
HIW"比赛获胜方为"+DAAN+"，目前已赔付彩金为"+ob->query(ID)+"枚元宝!。\n\n"NOR);
       return 1;    
}

