//test.c file.
//数字转图形的一个测试命令。
//可以作为手动任务的起始点



#include <ansi.h>
mapping signs = ([]);
void set_sign();



int main(object me, string arg) {

  string num, sign, str, strs1, strs2;
  int i, j, k, n;

  strs1 = "0123456789";  //
  strs2 = "①②③④⑤⑥⑦⑧⑨⑩";




  //得出四位字符串num
  num = "";
  for (i = 0; i < 4; i++) {
    n = random(sizeof(strs1));
    num += strs1[n..n];
  }
  set_sign();  //载入图形

  //输出图形
  write(HIR "==============================================================\n" NOR);
  for (i = 0; i < 10; i++) {
    // write(HIR"‖"NOR);
    for (j = 0; j < 4; j++) {
      sign = signs[num[j..j]];
      for (k = 0; k < sizeof(sign); k++) {
        n = random(sizeof(strs2) / 2);  //双字节字符
        str = strs2[n * 2..n * 2 + 1];
        //write(str+"\n");
        sign = replace_string(sign, "●", str, 1);
      }
      write(HIG + sign + "\t" NOR);
    }
    write("\n");
  }
  write(HIR "==============================================================\n" NOR);
  write("请输入以上四位数字：\n");
  input_to("get_num", 1, num);



  return 1;
}



void get_num(string str, string num) {
  if (!str || str != num)
    write("输入错误。\n");
  else write("输入正确。\n");
}




int help(object me) {
  write("指令格式：tail <文件名> | <行数>。\n");
  return 1;
}




