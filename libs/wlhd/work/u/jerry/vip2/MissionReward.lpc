#include <ansi.h>
#include <npc/chinese.lpc>
#include <localtime.h>

mixed *local;

//questguai_n任务奖励
void give_reward_questguai_n(object questob)
{
        int exp,pot;
        local = localtime(time());

        
        exp = (questob->query_int()*5) + (questob->query("kar")*25) + random(1000);
       if (exp > 10200) exp = 9809+random(200);
       exp = exp-random(600);
       pot = (exp/10);
       if (pot > 1100) pot = 888+random(200);
        
        // 每晚 19:00 到 22:00 贵宾会员有双倍奖励 by Jerry
        if( local[LT_HOUR] > 18 && local[LT_HOUR] < 22 )        
                                {
                                        if (questob->query("jym_level/vip")==1) {
                                        exp = exp * 2;
                                        pot = pot * 2;
                                        }
                                }

          questob->add("combat_exp",exp);
          questob->add("potential",pot);
          questob->set_temp("questtime1",time()+20);
          tell_object(questob,"你得到了"+HIW+chinese_number(exp)+NOR"点"
           "经验和"+HIW+chinese_number(pot)+NOR"点潜能！\n");
        
}

//dojob任务奖励
void give_reward_dojob(object who)
{
        int exp,pot;
        local = localtime(time());
        
        exp =who->query_int()*6+who->query("kar")*25+random(1000);
  if (exp > 10200) exp = 9809+random(200);
     pot=exp/10+random(100);
     
     // 每晚 19:00 到 22:00 贵宾会员有双倍奖励 by Jerry
        if( local[LT_HOUR] > 18 && local[LT_HOUR] < 22 )        
                                {
                                        if (who->query("jym_level/vip")==1) {
                                        exp = exp * 2;
                                        pot = pot * 2;
                                        }
                                }
                                
        who->add("potential",pot);
        who->add("combat_exp",exp);
          who->delete("job_target");
        who->delete_temp("job_given");
         who->set_temp("peng_time",time()+20);
         
                          tell_object(who,HIW"你被奖励了：\n" + 
        chinese_number(exp) + "点实战经验\n" +
        chinese_number(pot) + "点潜能\n"+
        NOR);
}

//questnpc任务奖励：
void give_reward_questnpc(object killer,int reward_exp,int reward_pot)
{

        local = localtime(time());
        // 每晚 19:00 到 22:00 VIP用户有双倍奖励 by jerry
        if( local[LT_HOUR] > 18 && local[LT_HOUR] < 22 )        
                                {
                                        if (killer->query("jym_level/vip")==1) {
                                        reward_exp = reward_exp * 2;
                                        reward_pot = reward_pot * 2;
                                        }
                                }       
        
        tell_object(killer,HIW"在实战中，你获得了"+
CHINESE_D->chinese_number(reward_exp) +"点的『实战经验』"+
CHINESE_D->chinese_number(reward_pot)+"点的『潜能』！\n"NOR); 
                   killer->add("kill_quest/reward_exp",reward_exp);            
                   killer->add("kill_quest/reward_potential",reward_pot);
                   killer->add("combat_exp",reward_exp);
                   killer->add("potential",reward_pot);
                   killer->add("score",random(5));
        
}

//questkiller任务奖励：
void give_reward_questkiller(object killer,int reward_exp,int reward_pot)
{
        local = localtime(time());
        
        // 每晚 19:00 到 22:00 贵宾会员有双倍奖励 by Jerry
        if( local[LT_HOUR] > 18 && local[LT_HOUR] < 22 )        
                                {
                                        if (killer->query("jym_level/vip")==1) {
                                        reward_exp = reward_exp * 2;
                                        reward_pot = reward_pot * 2;
                                        }
                                }

                   tell_object(killer,HIW"在实战中，你获得了"+
                     CHINESE_D->chinese_number(reward_exp) +"点的『实战经验』"+
                     CHINESE_D->chinese_number(reward_pot)+"点的『潜能』！\n"NOR); 
                   killer->add("shan_quest/reward_exp",reward_exp);
                   killer->add("shan_quest/reward_potential",reward_pot);
                   killer->add("combat_exp",reward_exp);
//839                     killer->add("money",25000000);
                   killer->add("potential",reward_pot);
                   killer->add("score",random(5));
        
}


//镖车任务
void give_reward_yunbiao(object me)
{
        int reward_exp,reward_pot,reward_score,flag,i,dj,my_combat_exp,gold;
        local = localtime(time());
        gold = 50000;
        reward_exp=2000+random(1000)+(int)me->query("quest_yunbiao/bonus")*10-(int)me->query("jym_level/level")*20+(int)me->query_int()*3;

       if(reward_exp<100) reward_exp=200;
       if(reward_exp>10000) reward_exp=10000;
      reward_pot=reward_exp/6;
       reward_score=reward_exp/40;

if (this_player()->query("money",1)>100000000)
{
this_player()->add("jym_money",this_player()->query("money",1)/100000000);
this_player()->set("money",100);
tell_object(this_player(),HIR"你在钱庄的钱已达到一万两黄金！\n"NOR);
tell_object(this_player(),HIR"元宝已经帮你把钱庄里的黄金转换成了"HIB"星空币"HIR"存在了钱庄!\n"NOR);
}


         // 每晚 19:00 到 22:00 VIP用户有双倍经验 by Jerry
        if( local[LT_HOUR] > 18 && local[LT_HOUR] < 22 )        
                                {
                                        if (me->query("vip/vip")==1) {
                                        reward_exp = reward_exp * 2;
                                        reward_pot = reward_pot * 2;
                                        reward_score = reward_score * 2;
                                        gold = gold * 2;                
                                        }
                                }
                                
        tell_object(this_player(),MAG"【传闻】"HIB+me->query("name")+
   "运送的镖车历经千辛万苦，终于顺利抵达！\n"
   +me->query("name")+"获得了"+CHINESE_D->chinese_number(reward_exp)
+"点实战经验、"+CHINESE_D->chinese_number(reward_pot)+"点潜能\n"
+"及"+CHINESE_D->chinese_number(reward_score)+"点综合评价奖励和"+chinese_number(gold/1000)+"两黄金！\n"NOR,);

       me->add("quest_yunbiao/reward_exp",reward_exp);
       me->add("quest_yunbiao/reward_potential",reward_pot);
       me->add("combat_exp",reward_exp );
       me->add("potential",reward_pot );
       me->add("score",reward_score);
       me->add("money",gold);

       me->set_temp("quest_yunbiao/have_task",0);
       me->set_temp("quest_yunbiao/finished_time",time());
        
}

