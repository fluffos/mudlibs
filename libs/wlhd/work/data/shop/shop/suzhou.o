dbase (["no_beg":1,"no_fight":1,"open_long":"听竹轩坐落于苏州城北，虽称之为轩，实际却是一间装潢雅致的店铺。苏州城建筑别具一格，这家店铺也不例外。此时店堂伙计正忙上忙下，招呼着客人。","long":"听竹轩坐落于苏州城北，虽称之为轩，实际却是一间装潢雅致的店铺。苏州城建筑别具一格，这家店铺也不例外。不过货柜上却空无一物，看样子已很久没人来打理了。","objects":(["/u/jerry/shop/waiter":1,]),"exits":(["down":"/d/suzhou/majiu",]),"owner":"VOID_SHOP","short":"听竹轩","shop_type":0,"no_clean_up":0,"no_steal":1,])
