dbase (["chat_chance":5,"id":"qian laoben","chat_msg":({"钱老本说道：我叫钱老本，就是因为做生意连老本也赔了。","钱老本笑着说道：在本店存钱利息至少百分之一，客官您只管存吧。","钱老本说：只有对本派弟子我才这么客气，对别的人啊，哼哼......","钱老本突然说道: 江湖威望很重要，威望值高大有好处啊。","钱老本突然说：五人分开一首诗，身上洪英无人知。",}),"shen":0,"ziyuan":"黄金","zhengzhao":2,"age":34,"env":(["wimpy":50,]),"shiyong":(["cloth":"cloth",]),"food":32,"attitude":"friendly","neili":0,"max_zhongcheng":99,"combat_exp":50000,"last_save":1249655897,"water":32,"str":22,"zhongcheng":15,"int":24,"bellicosity":0,"armor":(["cloth":(["equip_id":"cloth",]),]),"qi":500,"max_qi":500,"title":"钱庄老板","con":18,"dex":18,"no_get":100,"kar":23,"startroom":"/d/city2/qianzhua","eff_qi":500,"per":16,"eff_jing":100,"tybang":(["banghui":"[1;31m金庸Ⅱ[2;37;0m",]),"pighead":0,"kaifa":40,"actions":,"max_jing":100,"name":"钱老本","jing":100,"eff_jingli":0,"gender":"男性","race":"人类","inquiry":(["利息":"想要利息先入会！","加入":"只要入了我天地会，可以向会中各位好手学武艺。","陈近南":"想见总舵主可没那么容易。","威望":,"入会":"只要入了我天地会，可以向会中各位好手学武艺。","江湖威望":,"天地会":"只要是英雄好汉，都可以入我天地会(join tiandihui)。",]),"shen_type":1,"jingli":0,"area_name":"天安门钱庄","default_actions":,"jizhi":55,"area_id":"bjqianzhuang","area_file":"/d/city2/npc/qianlaob.c",])
