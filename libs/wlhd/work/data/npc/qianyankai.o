dbase (["id":"qian yankai","chat_chance":2,"chat_msg":({"钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。","钱眼开说道：昨天我亲自看到一个杀手帮的人来取钱，看来杀手帮重出江湖了。钱眼开笑着说道：杀手帮重出江湖对本银号来说，真是求之不的呀！。钱眼开笑着说道：当年雾中楼在本银号存的钱可以说是最多的了。","钱眼开笑着说道：在本店存钱无利息，取钱收百分之一的手续费，客官您看着办吧。","钱眼开微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。",}),"jiali":10,"shen":0,"ziyuan":"黄金","age":34,"shiyong":(["cloth":"cloth",]),"env":(["wimpy":50,]),"food":41,"neili":200,"attitude":"friendly","combat_exp":12500,"last_save":1264050653,"nickname":"铁公鸡","str":100,"water":41,"int":24,"max_neili":100,"no_put":1,"armor":(["cloth":(["equip_id":"cloth",]),]),"qi":233,"max_qi":233,"con":18,"title":"钱庄老板","dex":18,"kar":14,"startroom":"/d/city/qianzhuang","eff_qi":233,"per":18,"eff_jing":200,"pighead":0,"actions":,"kaifa":40,"max_jing":200,"name":"钱眼开","jing":200,"race":"人类","gender":"男性","shen_type":1,"area_name":"扬州钱庄","default_actions":,"jizhi":55,"area_id":"yzqianzhuang","area_file":"/d/city/npc/qian.c",])
