dbase (["id":"gu yanwu","chat_chance":3,"chat_msg":({"顾炎武说道：普天之下，莫非王土；率土之滨，莫非王臣。","顾炎武说道：出家人，小过损益焉；无妄大过，未济咸困之。","顾炎武说道：大学之道，在明明德。在亲民，在止于至善。 ","顾炎武说道：格物致知，诚意正心，修身齐家，治国平天下。",}),"shen":40000,"zhengzhao":1,"age":65,"shiyong":(["cloth":"cloth",]),"food":47,"neili":0,"combat_exp":400000,"last_save":1264041225,"str":21,"water":47,"int":28,"max_jingli":40000,"armor":(["cloth":(["equip_id":"cloth",]),]),"qi":226,"no_suck":1,"con":21,"max_qi":226,"dex":19,"long":"顾先生被称为当世第一大文学家，肚子里的墨水比海还要深。","kar":27,"startroom":"/d/city2/shuyuan","eff_qi":226,"per":14,"eff_jing":40000,"pighead":0,"actions":,"name":"顾炎武","max_jing":40000,"race":"人类","jing":40000,"gender":"男性","shen_type":1,"jingli":40000,"default_actions":,])
