messages "Onarion**Subj: weightitDate: Apr 17Vaihda areoittes equjen weightit NYT**Bulut**Subj: jeesCc: terrorDate: May  6inherit \"obj/monster\";reset(arg) {         /* <-- unohda naa toistaseks */    ::reset(arg);    /* <--                       */    set_level(1);    /* monsterin leveli */    set_name(\"citizen\");          /* monsterin nimi */    set_alias(\"hobbit\");          /* vaihtoehtonen nimi     */    set_short(\"A hobbit citizen\");/* short descript         */                                  /* eli se mika nakyy kun  */                                  /* tuut huoneeseen        */    set_long(\"A hobbit is lurking around.\\n\"); /* pitka descripti    /*                                          /* tama tulee kun          /*                                          /* laitat look at <monster>/*    set_wc(3);           /* Weapon class */    set_ac(0);           /* Armour class */    set_al(10);          /* Alignmentti  */    set_aggressive(0);   /* Agrooko monsu 0 tai 1 */    }.wq**Bulut**Subj: tassataaCc: irmeliDate: May 11#include \"room.h\"init() {  ::init();add_action(\"fin\", \"fin\");add_action(\"mud\", \"mud\");add_action(\"sales\", \"sales\");add_action(\"tell\", \"tell\");add_action(\"finger\",\"finger\");add_action(\"bell\", \"bell\");}fin(str) {write(\"You are in jail, no one will hear you.\\n\");return 1;}mud(str) {write(\"You are in jail, no one will hear you.\\n\");return 1;}sales(str) {write(\"You are in jail, no one will hear you.\\n\");return 1;}tell(str) {write(\"You are in jail, no one will hear you.\\n\");return 1;}bell(str) {write(\"The guard comes, and catches you bell.\\n\");return 1;}finger(str) {write(\"Keep your fingers in yer own ass.\\n\");return 1;}long(){write(\"You are in Jail\\n\" +\"Have fun\\n\");}finger(str) {write(\"Keep your fingers in yer own ass.\\n\");return 1;}long(){write(\"You are in Jail\\n\" +\"Have fun\\n\");write(\"You are in Jail\\n\" +\"Have fun\\n\");**Terror**Subj: Secret enteranceDate: May 25inherit \"room/room\";inherit \"room/door\";object monster;int jump;reset(arg) {if(!monster) {monster = clone_object(\"/wizards/terror/goblin/mokot/gpeon.c\");move_object(monster, this_object());}add_exit(\"north\",\"/wizards/terror/goblin/roomit/g2.c\");add_exit(\"south\",\"/wizards/terror/goblin/roomit/g7.c\");short_desc = \"A smelly forest\";long_desc = \"You smell some chemicals in the air.\\n\"+\"You have some funny feeling in your nose.\\n\"+\"You wonder what smells like that.\\n\"+\"You feel that part of your brains have died in this ugly smell.\\n\"+More: (line 17)\"You notice some hole in the thick oak you wonder what is inside of it.\\n\";init() {add_action(\"jump\", \"jump\");::init();}jump(str) {write(\"As you jump in oak you hope that you will stay alive.\\n\");say(this_player()->query_name()+\" jumps in the thick oak.\\n\");move_object(this_player(), \"/wizards/terror/goblin/roomit/s1.c\");}  **Celtron**Subj: kenguruDate: May 28aika hauska väsäys**Celtron**Subj: jooDate: Jun  6ei mitaa tallasii enaaTamaon toitoitoi.. nosefiksaa descittoi oli forest5.c fixaa sit.**Golthar**Subj: TimerDate: Aug 18MorjensOlis vaan semmonen juttu, kun kuulin sun jossain eventissa olevan jonkunlaisen laskurinja ite vasailen tossa semmosta huonetta jonka pitais paastaa tietyn ajan paasta poiestoiseen huoneeseen, niin ajattelin etta josko voisit neuvoa mua siina timerissa ja kenties siina etta se siirtaa ajan tultua tiettyyn paikkaan...Kiitoksia jo etukateen../Golthar**Celtron**Subj: fake deathDate: Aug 21following lines have been added to living.c:set_fake_death(int i) {  fake_death = i;} query_fake_death() {  return fake_death;}also death() ja link_death() funkissa on ne sovitut römpsyt..//Celtron**Duncan**Subj: gnambuDate: Sep  3tunees vaha monsuu/necklacees seon vaha liia