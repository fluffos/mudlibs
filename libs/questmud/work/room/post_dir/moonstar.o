messages "Walla**Subj: jerichon cs huoneDate: Sep 27inherit \"room/room\";init() {   ::init();   add_action(\"map\", \"map\");}map(arg) {   if (arg) { return 0; }   cat(\"/wizards/walla/jericho/maps/cs\");   return 1;}reset(arg) {  add_exit(\"north\",\"/wizards/walla/jericho/rooms/ujar-1\");  add_exit(\"south\",\"/wizards/walla/jericho/rooms/ujar1\");  add_exit(\"west\",\"/wizards/walla/jericho/rooms/ispep-1\");  add_exit(\"east\",\"/wizards/walla/jericho/rooms/ispep1\");  short_desc = \"Grand place\";  long_desc =\"You are standing in the middle of the city. The walls can be seen\\n\" +\"in the distance. You notice that the ground has been newly paved\\n\" +\"with white marble from distant lands. A thing that strikes you, is\\n\" +\"the lack of animals in the town. The commotion in the city has not\\n\"\"quite yet started, as people have only just started settling.\\n\";}**Walla**Subj: toinen huoneDate: Sep 27inherit \"room/room\";reset(arg) {  add_exit(\"south\",\"entr2\");  add_exit(\"north\",\"/wizards/nalle/plateau/14_-7\");  short_desc = \"A huge iron gate\";  long_desc =\"You have arrived at a huge iron gate, leading into the mountain in the south.\\n\" +\"the gates are open, and the entrance seems to be lit up by torches. A strong,\\n\" +\"gale is blowing in from the mountains, and it makes your teeth clatter.\\n\";}**Rag**Subj: poksDate: Sep 27inherit \"room/room\";object fox1, fox2;reset(arg) {        if(!fox1) {                fox1 = clone_object(\"/wizards/moonstar/forest/monsut/sfox\");                move_object(fox1,this_object());        }        if(!fox2) {                fox2 = clone_object(\"/wizards/moonstar/forest/monsut/sfox\");                move_object(fox2,this_object());        }if(!present(\"fox 1\") {        move_object(clone_object(\"/wizards/moonstar/forest/monsut/sfox\");}if(!present(\"fox 2\"); {        move_object(clone_object(\"/wizards/moonstar/forest/monsut/sfox\");}Jos pistäs once/boot monsuja ni ne tulee ton if(arg) return; rivin jälkeenEli kaikki mikä on ennen sitä on resettaavaa*/        if(arg) return;        add_exit(\"north\",\"/wizards/moonstar/forest/f_room1\");        add_exit(\"leave\",\"outmap: 123 45\");        short_desc = \"lost in a forest\";        long_desc = \"This is the entrance to the dark forest where animals lives in peace\\n\"                \"This section of the forest is overgrown with tall\\n\"                \"trees that stretch to the sky.  They block out almost\\n\"                \"all sunlight from above making it rather dark as well\\n\"                \"as drop the occassional leaf to the ground.\\n\";        items = allocate(4);        items[0] = \"trees\";        items[1] = \"Huge trees are growing towards the sky\";        items[2] = \"leaves\";        items[3] = \"Small green leaves are lying on the ground\";        set_light(1);}**Walla**Subj: monsuDate: Sep 27inherit \"obj/monster\";reset(arg) {    ::reset(arg);    if (arg) return;    set_level(10);    set_name(\"citizen\");    set_alias(\"citizen\");    set_short(\"A citizen of Jericho\");    set_long(\"Almos all citizens of Jericho have been chased away\\n\"+             \"by Leb-Kamars army. The rest have been enslaved. Only\\n\"+             \"a few remain uncaptured. The citizen is very skinny, and\\n\"+             \"badly bruised.\\n\");    set_al(0);    set_gender(1);    set_race(\"human\");}**Golthar**Subj: artistaDate: Oct 24Armed Defender Sub 1stance skill name: way of weirdingaffecting skills:	Dodge	Parry	Riposte: as counter attack but less effective        Smite: hit opponent with knuckles	Slam: more efficient hit than smite but slower**Golthar**Subj: offu sub 1Date: Oct 24Armed Offensive Sub 1stance skill name: way of cobra	Attack      : one of the common combat skills.	Martial Arts: the common combat skill which affects almost everything.	Smite       : basic offensive skill for martial artists, smites opponent		      with you brass knuckles.	Stun        : use to stun your opponent. (high skill levels not yet available		      at offensive sub _1_)	Critical    : used for scoring larger amounts of damage to opponent, outstanding		      skill level can be reached at offsub2		smack	    : punch your knuckles straight in your opponents face	Advanced	Martial Arts: Improved movements of your arms allow you to score extra hits,		      more damage, and increase your combat factors**Rag**Subj: SkillitDate: Oct 28Pistin sulle /wizards/moonstar/artists/skillfun.cSinne voit lisätä skillcostit.Ei kait mulla muuta :)**Rag**Subj: Skys trikeDate: Nov 12Hienosti typottu subject, mut seo pientäEli, sulta puuttu ennen sitä fail_skilliä yks }Noiden kanssa pitää olla tarkkanaNyt pitäs toimiaViikonloppuna kerkeen ehkä alkaa kattoon niitä masteryjä--Rag**Devil**Subj: TestDate: Nov 27Pääsisinkö testeriks?**Celes**Subj: TesteriksiDate: Nov 29Minä olen valmis testeriksi jos huolit**Dragula**Subj: TestiinDate: Nov 30Minähän pääsen testeriksi?**Cremater**Subj: TesteriksiDate: Dec  7Hep hei! Mäkin tahon testaamaan martialisteja, tarvitaanhan sinne joku tämmönen melko neepa tyyppikin. Ja oonhan mä kokenu testeri, ku oon noitia ja lokkeja ollu testaamassa. =P-- Cremater**Devil**Subj: MartialDate: Dec 10noni mut kans tesmimään**Rag**Subj: Red knucklesitDate: Dec 11Korjasin ne, sulla oli ylimääränen välilyönti niiden weapon_sub_typessä--Rag**Jenny**Subj: hrmhDate: Dec 12bladis nakkaa sky strikel 200k mosan 1 skilli...nojaa eipa se kai haitannemut jos jaksat koita pistaa sillee et ratet ois vaha balances muiden kiltoje kaa 2g jannu ei tee 1m++ ratea missaa muus killas ku sun artisteis atm, mjooh sky striken kestoa jos lisaat vahan ni sekai sen tekis, sinun kilta itse paatat mut ela paasta peliin jos ei oo balan