messages "Zorgul**Subj: sanatDate: Apr 27 /echo x,y = hea mar  gives True Healing %; \\   /echo x,y = bls min  gives Regeneration %; \\   /echo x,y = bls les  gives Durability %; \\   /echo x,y = bls mar  gives More Mana %; \\   /echo x,y = num min  gives %; \\   /echo x,y = num les  gives Remove Poison %; \\   /echo x,y = num mar  gives Remove Scar %; \\   /echo x,y = eth min  gives Resurrection %; \\   /echo x,y = eth les  gives Reincarnation %; \\   /echo x,y = eth mar  gives Resurrection %; \\   /echo x,y = xfr min  gives Drain Health (140 hp) %; \\   /echo x,y = xfr les  gives Transfer Health %; \\   /echo x,y = xfr mar  gives Harm (140 hp)                                    **Proge**Subj: spelleiDate: Apr 27cast chl bls mar at target = manacast chl bls les at target = hpcast chl bls min at target = regencast chl eth min at target = resscast chl eth les at target = reinccast chl xfr min at target = harm body smallcast chl xfr mar at target = harm body largecast chl hea min at target = curecast chl hea mar at target = large curecast chl hea les at target = distand healcast chl num les at target = cure poisoncast chl num min at target = cure diseasecast chl num mar at target = remove scar// proge**"
