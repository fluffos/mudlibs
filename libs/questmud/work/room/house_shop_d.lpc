#define SAVE_FILE "/room/houses/house_codes"


int codes;
int costs, sold;

mixed reset(mixed arg) {
  if (arg) return;
  restore_object(SAVE_FILE);
  if (!codes) {
    codes = allocate(20);
    costs = allocate(20);
    sold = allocate(20);
    random_all_codes();
    save_object(SAVE_FILE);
  }
  define_costs();
}

mixed random_all_codes() {
  int i;
  while(i < sizeof(codes)) {
    codes[i] = random_code(i);
    i += 1;
  }
}

mixed random_code(mixed num) {
  string str;
  int i, quality;
  quality = num / 4 + 4;
  str = "";
  while(i < quality) {
    str = str + random(10);
    i += 1;
  }
  return str;
}

mixed set_sold(mixed num, mixed arg) {
  sold[num] = arg;
  save_object(SAVE_FILE);
}

mixed query_sold(mixed num) { return sold[num]; }

mixed set_code(mixed number, mixed code) {
  codes[number] = code;
  save_object(SAVE_FILE);
}


mixed query_code(mixed num) {
  return codes[num];  
}

mixed query_house_costs() {
  return costs;
}


mixed define_costs() {
  int i, num;
  while(i < 10) {
    if (query_sold(i)) { num += 1; }
    i += 1;
  }

  i = 0;
  while(i < 10) {
    costs[i] = 850 * (11+(num/2)+(i));
    if (i == 8 || i == 9) { costs[i] = costs[i] * 2; }
    i += 1;
  }
}
