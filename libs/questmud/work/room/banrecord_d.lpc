#define SAVEFILE "/data/banrecord"

mapping record;

/* LDMud ran reset(0) when an object loaded; this driver only runs create().
 * call_other so the most-derived reset() runs (KB 06 section 7.177). */
void create() {
    call_other(this_object(), "reset", 0);
}

mixed reset(mixed arg) {
  if(arg) return;
  if(!restore_object(SAVEFILE)) {
    record = ([ ]);
    save_object(SAVEFILE);
  }
}

mixed save_record() {
  save_object(SAVEFILE);
}

mixed add_record(string name,string wiz,string reason,int atime) {
  mapping tmp;
  tmp = ([ ]);
  if(!record[name]) record += ([ name : tmp ]);

  tmp = record[name];
  map_delete(record, name);
  tmp += ([ ctime(time()) : 
	"Reason: "+reason+" ("+ "/obj/player"->stime(atime) +") By: "+wiz ]);
  record += ([ name : tmp ]);
  save_record();
}

mixed list_record(string str) {
  int i;
  string *arg, *arg2;
  if(record[str]) {
    arg = keys(record[str]);
    arg2 = values(record[str]);
    write("Displaying record for "+capitalize(str)+":\n");
    while(i < sizeof(arg)) {
      write(arg[i] +"  "+arg2[i]+"\n");
      i += 1;
    }
    write("++End of record.\n");
    return 1;
  }
  arg = keys(record);
  if(!arg) return 0;
  write("Displaying players with records:\n");
  while(i< sizeof(arg)) {
    write((i+1)+". "+arg[i]+"\n");
    i += 1;
  }
  write("++End of record.\n");
  return 1;
}
