mixed short() {
    return "The void";
}

mixed long() {
    write(short() + ".\n");
    write("You come to the void if you fall out of a room, and have nowhere to go.\n");
    write("Give the command 'inn', and you will come back to the inn.\n");
    write("\nYou are transfered to the inn...\n");
    call_other(this_player(), "move_player", "X#world/city/inn");
}

mixed init() {
    add_action("church", "inn");
}

mixed church() {
    call_other(this_player(), "move_player", "away#world/city/inn");
    return 1;
}

/* LDMud ran reset(0) when an object loaded; this driver only runs create().
 * call_other so the most-derived reset() runs (KB 06 section 7.177). */
void create() {
    call_other(this_object(), "reset", 0);
}

mixed reset(mixed arg)
{
    if (arg)
	return;
    set_light(3);
}

mixed id(mixed str) { return str == "void"; }
