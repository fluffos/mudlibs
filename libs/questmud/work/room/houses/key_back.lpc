inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A bronze key"; }

mixed long() { write("The key is made of bronze.\nYou could 'transfer key to [name]'.\n"); }

mixed reset() {
  set_door_file("/world/city/silcop3.lpc", "hc");
}

mixed drop() { return 0; }
mixed get() { return 1; }

mixed query_auto_load() { return "/room/houses/key:"; }

mixed init() {
  add_action("transfer","transfer");
}

mixed transfer(mixed str) {
  object ob;
  if (sscanf(str, "key to %s", str)) {
    ob = present(str, environment(this_player()));
    if (!ob || !living(ob) || ob->query_npc()) {
      write(capitalize(str)+" is not here.\n");
      return 1;
    }
    write("You transfer the key to "+ob->query_name()+".\n");
    tell_object(ob, this_player()->query_name()+" gives you the key to a house.\n");
    this_object()->move_object(ob);
    return 1;
  }
  return 0;
}
