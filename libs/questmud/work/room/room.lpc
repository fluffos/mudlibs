#define EXPLORE_D "/daemons/explore_d"
#define ENVIRONMENT_D "/cmds/std/_environment"

#include <ansi.h>

/*
 * This is a proposal of a replacement to std.h. It is used with
 * 'inherit "room/room";'.
 * All global variables below are supposed to be setup by the reset()
 * in the function that inherits this file.
 */

/* §2.7's lazy-reset gap (NOTES.md), a new/more severe instance: this
 * driver's call_create() (vm/internal/base/object.cc) sets an object's
 * own next_reset to now+"time to reset" (3600s here) BEFORE create()
 * even runs -- so try_reset()'s lazy-resets check (next_reset <
 * current tick) is already false the instant the object finishes
 * loading, for every single object, preloaded or lazily compiled alike.
 * Since this shared base class is inherited by 5,000+ room files
 * corpus-wide and NONE of them define their own create(), no room's
 * reset() (which is what actually populates short_desc/long_desc/exits
 * via add_exit(), per this file's own opening comment) was ever
 * running until a full hour after that specific room object's first
 * load -- confirmed live: entering a freshly-loaded guild room printed
 * no description at all and "No obvious exits." (a hard, silent
 * dead-end for every new character immediately after chargen, not a
 * cosmetic gap). A bare `reset(0);` call here would call the wrong
 * (non-virtual) copy on this driver per AGENTS.md §7.177's own
 * documented fix for this exact "universal base class whose subclasses
 * each define their own reset()" shape -- routing through
 * call_other(this_object(), ...) instead reliably dispatches to the
 * actual most-derived reset() and is what's used below. */
void create() {
    call_other(this_object(), "reset", 0);
}

/* An array with destinations and directions: "room/church", "north" ... */
/* Assigned allocate()'d results and indexed as an array throughout
 * this file despite being declared a plain string. */
/* Forward declarations: this driver compiles one function-call
 * pass per file (unlike the archive's assumed two-pass compiler),
 * so a same-file function called before its own definition needs
 * a prototype here first. Added mechanically. */
mixed convert_number();
mixed query_long();
mixed query_numbers();
mixed query_room_path();
mixed query_short();
nosave mixed dest_dir;

/* Short description of the room */
nosave string short_desc;

/* Long description of the room */
nosave string long_desc;

/* Special items in the room. "table", "A nice table", "window", "A window" */
string items;

/* Fact about this room. ex: "no_fight", "no_steal" -- can be either a
 * single string or an array of strings (this file's own
 * query_property() explicitly supports both), and countless derived
 * rooms across this whole mudlib assign it array literals in their
 * own reset() -- needs mixed, not string, since this is the shared
 * base declaration every room inherits. */
mixed property;

/* No castles are allowed to be dropped here */
int no_castle_flag;

/* Blocker name and direction */
nosave string blocker, direction;

/* direction possibly blocked by requirements */
string req, map_exit_dir;

/* Defines if sunlight affects this room: 0 = not affecting, 1 = affects */
int out;
/* Define how much water in the room: Scale is 0 to 10 */
int water;

/* Explore v. May04 room hash. */
int explore_hash;


/* Both were declared with no return type at all (old-LPC implicit
 * mixed/int); this driver treats that as a strict "unknown" type,
 * which then fails "unknown vs string" on any caller that concatenates
 * the result with a string (room/room.lpc:89). Declared string
 * explicitly, matching what they actually return. */
string query_room_path();

string PATH()
{
  return query_room_path();
}

string query_room_path()
{
  /* tmp was declared plain "string" alongside path but used as an
   * array throughout (explode()'s result, tmp[...], implode(tmp,...))
   * -- the classic "TYPE a, b;" single-declarator-binds-the-type-only
   * trap (AGENTS.md sec 6.3). Split into two declarations. */
  string path;
  string *tmp;
  tmp = explode(file_name(this_object()), "/");
  tmp[sizeof(tmp)-1] = "";
  path = "/"+implode(tmp, "/");
  return path;
}

mixed init() 
{
 int i;

 if (!dest_dir) return;

 //EXPLORE_D->add_room();

 i = 1;

 while(i < sizeof(dest_dir)) 
      {
       add_action("move", dest_dir[i]);
       i += 2;
      }
}

varargs string parse_dir(string dir, int test) {
  string new_dir, *dir_, tmp;
  int back_dir, i;
  if(dir[0..6] == "virtual") return dir;
  if(dir[0..2] == "out") return dir;
  while(sscanf(dir, "%s//%s", tmp, dir)) {
    back_dir += 1;
  }
  if(!back_dir) {
    if(dir[0..0] == "/" || dir[0..7] == "wizards/" || dir[0..4] == "room/" || dir[0..5] == "world/")
        return dir;
    else
        return query_room_path() + dir;

  }
  dir_ = explode((string) query_room_path(), "/");
  if(back_dir > sizeof(dir_))
        return "error! no such back dir";
  new_dir = "";
  for(i=0; i < sizeof(dir_) - back_dir; i++) {
    new_dir += dir_[i]+"/";
  }
  new_dir += dir;
  if(new_dir[0..0] != "/") new_dir = "/"+new_dir;
  return new_dir;
}

mixed add_exit(string dir, string dest) {
  int i,error;
  mixed tmp;
  string kapy;
  object *stuff;
  tmp = dest_dir;
  dest_dir = allocate(sizeof(tmp)+2);
  while(i<sizeof(tmp)) {
    if(tmp[i] == dir) error = 1;
    dest_dir[i] = tmp[i];
    i+= 1;
  }
  if(error) { dest_dir = tmp; return; }
  dest = parse_dir(dest);
  dest_dir[i] = dest;
  dest_dir[i+1] = dir;
  i = 0;
    kapy = "/obj/update_dest";
    stuff = all_inventory(this_object());
    while(stuff && i<sizeof(stuff)) {
        if(!stuff[i]->query_npc() && living(stuff[i])) {
          stuff[i]->move_object(kapy);
        }
        i += 1;
    }
    i = 0;
    while(stuff && i<sizeof(stuff)) {
        if(stuff[i]) { stuff[i]->move_object(this_object()); }
        i += 1;
    }
}

/* recode by Celtron */
mixed remove_exit(string dir_str) {
  int i;
  string tmp;
  if (!dest_dir || !sizeof(dest_dir)) { return 0; }
  for(i=0; i < sizeof(dest_dir); i++) {
    if(dest_dir[i] == dir_str) {
      dest_dir[i] = 0;
      dest_dir[i-1] = 0;
      dest_dir = explode(implode(dest_dir, ","), ",");
      if(sizeof(dest_dir) == 1) dest_dir = 0;
      return 1;
    }
  }
  /* no such exit */
  return 0;
}

mixed query_dir(string file) {
  int i;
  while(i<sizeof(dest_dir)) {
    if (dest_dir[i] == file) { return dest_dir[i+1]; }
    i += 2;
  }
}

mixed id(mixed str) {
    int i;
    if (this_object()->door_long_desc(str)) {
      return 1;
    }
    if (!items)
      return;
    while(i < sizeof(items)) {
        if (items[i] == str)
            return 1;
        i += 2;
    }
    return 0;
}

mixed long(mixed str, object ob) {
    int i, light_level;
    if (!ob) { ob = this_player(); }
    light_level = ob->test_dark();
    if (!str) {
        if(long_desc) tell_object(ob, query_long() );
        this_object()->write_door_shorts();
        i = 0;
        if (!dest_dir || !sizeof(dest_dir) || !dest_dir[0])
            tell_object(ob,"    No obvious exits.\n");
        else {
            i = 1;
            if (sizeof(dest_dir) == 2)
                tell_object(ob,"    There is one obvious exit:");
            else
                tell_object(ob,"    There are " + convert_number(sizeof(dest_dir)/2) +
                      " obvious exits:");
            while(i < sizeof(dest_dir)) {
              ob->lited(" "+dest_dir[i]);
                i += 2;
                if (i == sizeof(dest_dir) - 1)
                    tell_object(ob, " and");
                else if (i < sizeof(dest_dir))
                    tell_object(ob, ",");
            }
            tell_object(ob, "\n");
        }
        return;
    }
    if (!items)
        return;
    i = 0;
    while(i < sizeof(items)) {
        if (items[i] == str) {
            tell_object(ob, items[i+1] + "\n");
            return;
        }
        i += 2;
    }
}

/*
 * Does this room has a special property ?
 * The 'property' variable can be both a string and array of strings.
 * If no argument is given, return the 'property' variable.
 */

mixed query_property(mixed str) {
    int i;
    if (str == 0)
        return property;
    if (!property)
        return 0;
    if (stringp(property))
        return str == property;
    while(i < sizeof(property)) {
        if (property[i] == str)
            return 1;
        i += 1;
    }
    return 0;
}
mixed set_req(mixed str) {
  req = str;
}

mixed set_blocker(mixed blocker_name, mixed dir) {
    blocker = blocker_name;
    direction = dir;
}

mixed move(mixed str) {
    int i, x, y;
    object ob;
    i = 1;
    while(i < sizeof(dest_dir)) {
        if (query_verb() == dest_dir[i]) {
            if (blocker) {
                if (present(blocker) && dest_dir[i] == direction) {
                     write(capitalize(blocker) + " blocks your way.\n");
                     return 1;
                }
            }
            if (req && dest_dir[i]==req&&this_object()->query_req()) { return 1; }

            if (sscanf(dest_dir[i-1], "outmap: %d %d", x, y)) {
                this_player()->move_player(dest_dir[i]+"#virtual /room/out/outmap "+x+" "+y);
                return 1;
            }
            if (sscanf(dest_dir[i-1], "out: %d %d", x, y)) {
                  y = 199 - y; /* koordit v^D^Drinp^Din */
                  this_player()->move_player(dest_dir[i]+"#virtual /room/out/outmap "+x+" "+y);
                  return 1;
                ob = find_object("world/out/map");
                ob->move_living(dest_dir[i], x, y);
                return 1;
            }
            if (sscanf(dest_dir[i-1], "%s: %d %d", map_exit_dir, x, y)) {
                ob = find_object(map_exit_dir);
                if (!ob) { write("Map object not found.\n"); return; }
                ob->move_living(dest_dir[i], x, y);
                return 1;
            }
            this_player()->move_player(dest_dir[i] + "#" + dest_dir[i-1]);
            return 1;
        }
        i += 2;
    }
}

mixed short(mixed no_exits, object ob) 
{
  int i, light_level;
  string str, color;
  if (no_exits) { return query_short(); }
  if (!ob) { ob = this_player(); }
  light_level = ob->test_dark();
  if (light_level > 0) {
    str = " (";
    i = 1;
    while(i<sizeof(dest_dir)) {
      if (dest_dir[i] == "north") {
        str = str + sprintf("%c",27) + "[1;1;36mn"+sprintf("%c",27)+"[0m";
      }
      else if (dest_dir[i] == "south") {
        str = str + sprintf("%c",27) + "[1;1;36ms"+sprintf("%c",27)+"[0m";
      }
      else if (dest_dir[i] == "east") {
        str = str + sprintf("%c",27) + "[1;1;36me"+sprintf("%c",27)+"[0m";
      }
      else if (dest_dir[i] == "west") {
        str = str + sprintf("%c",27) + "[1;1;36mw"+sprintf("%c",27)+"[0m";
      }
      else if (dest_dir[i] == "northwest") {
        str = str + sprintf("%c",27) + "[1;1;36mnw"+sprintf("%c",27)+"[0m";
      }
      else if (dest_dir[i] == "northeast") {
        str = str + sprintf("%c",27) + "[1;1;36mne"+sprintf("%c",27)+"[0m";
      }
      else if (dest_dir[i] == "southwest") {
        str = str + sprintf("%c",27) + "[1;1;36msw"+sprintf("%c",27)+"[0m";
      }
      else if (dest_dir[i] == "southeast") {
        str = str + sprintf("%c",27) + "[1;1;36mse"+sprintf("%c",27)+"[0m";
      }
      else if (dest_dir[i] == "up") {
        str = str + sprintf("%c",27) + "[1;1;36mu"+sprintf("%c",27)+"[0m";
      }
      else if (dest_dir[i] == "down") {
        str = str + sprintf("%c",27) + "[1;1;36md"+sprintf("%c",27)+"[0m";
      }
      else {
        str = str + sprintf("%c",27) + "[1;1;36m"+dest_dir[i]+
          sprintf("%c",27)+"[0m";
      }
      if(i+2<sizeof(dest_dir)) { str = str + ","; }
      i += 2;
    }
    str = str + ")";
    if (light_level == 1) {
        return "A dark place" + str;
    }   
    return query_short() + str;
  }
  return;
}

mixed query_not_out() {
    return out;
}

mixed set_not_out(int o)
{
 out = o;

 return out;
}

mixed set_no_reloc() 
{
    property = "no_summon";
}

mixed query_valid_dir(string dir) {
  int i;
  i = 1;
  while(i<sizeof(dest_dir)) {
    if (dest_dir[i] == dir) { return dest_dir[i-1]; }
    i += 2;
  }
}

mixed query_dest_dir() 
{
 return dest_dir;
}

varargs mixed query_long(int disable_colour) 
{
 string st;

 if(!disable_colour && this_player() && this_player()->query_terminal())
   st = ENVIRONMENT_D->give_color(this_player(), "room_long")+ long_desc + OFF;
  else
   st = long_desc;

 return st;
}

varargs mixed query_short(int disable_colour) 
{
 string tmp;

 if(!disable_colour && this_player() && this_player()->query_terminal())
   tmp = ENVIRONMENT_D->give_color(this_player(), "room_short")+ short_desc + OFF;
  else
   tmp = short_desc;

 return tmp;
}

/*
 * Convert a number to a word. The array is being created by the
 * standard room/room, and shared by all rooms.
 */
/* Assigned array literals/results throughout despite being declared a
 * plain string. */
mixed *numbers;

mixed convert_number(mixed n) {
    if (!pointerp(numbers))
        numbers = query_numbers();
    if (n > 9)
        return "lot of";
    return numbers[n];
}

varargs mixed query_numbers(int original) {
    if (!numbers) {
        if (original)
            numbers = ({"no", "one", "two", "three", "four", "five",
                            "six", "seven", "eight", "nine" });
        else
            numbers = call_other("room/room", "query_numbers", 1);
    }
    return numbers;
}

mixed query_drop_castle() {
    return no_castle_flag;
}

mixed query_room_file() { return 1; }
int query_water() { return water; }
void set_water(int i) {
  water = i;
}

mixed set_short(mixed s) {
  short_desc = capitalize(s);
}

mixed set_items(mixed s) {
  items = s;
}

mixed set_property(mixed s) {
  property = s;
}

mixed set_long(mixed s) {
  long_desc = capitalize(s);
}

void set_sound(int delay, string str) 
{
 if(!delay     || !str) 	return;
 if( delay < 1 || delay > 200) 	return;

  tell_room(this_object(), str);
  call_out("set_sound", delay, delay, str);
}

int query_explore_hash() 
{ 
 if(!explore_hash) 
    explore_hash = EXPLORE_D->query_hash( file_name(this_object()) );
 return explore_hash; 
}


