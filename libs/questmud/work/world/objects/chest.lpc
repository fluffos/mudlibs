string name;
int local_weight;
int chest_is_open;

mixed init() {
    add_action("open", "open");
    add_action("close", "close");
}

mixed query_value() { return 200; }

mixed query_weight() { return 8; }

mixed can_put_and_get() { return chest_is_open; }

mixed add_weight(mixed w) {
    if (w + local_weight > 8)
        return 0;
    local_weight += w;
}

mixed close(mixed str) {
    if (!id(str))
        return 0;
    chest_is_open = 0;
    write("Ok.\n");
    return 1;
}

mixed reset(mixed arg) {
    object money;
    if (!chest_is_open) {
        money = clone_object("obj/money");
        call_other(money, "set_money", random(100000)+ 100000);
        money->move_object(this_object());
    }
    if (arg) { return; }
    name = "chest"; chest_is_open = 0;
}

mixed set_name(mixed n) { name = n; }

mixed short() { return "An iron reinforced chest"; }

mixed long() {
  write("An iron reinforced chest, suitable for storing expesive stuff.\n");
  write("Opening it might activate some traps though..\n");
  if (chest_is_open) {
      write("It is open.\n");
  } else {
      write("It is closed.\n");
  }
}

mixed get() { return 0; }


mixed open(mixed str) {
  int chance;
  object cloud;
  if (str == "chest") {
   if (!chest_is_open) {
    chance = random(3) + 1;          
    if (chance == 1) {
      write("A small needle sticks into your finger.\n");
      call_other(this_player(), "set_poison", 1);
      return 1;
    }
    if (chance == 2) {
      write("Some strange gas escapes from the chest, but it keeps closed.\n");  
      cloud = clone_object("/obj/cloud");
      call_other(cloud, "set_type", 1);
      cloud->move_object(environment(this_object()));
      return 1;
    }
    if (chance == 3) {
      write("You manage to open the chest.\n");
      chest_is_open = 1;
      return 1;
    }
   } else {
     write("The chest is already open.\n");
     return 1;
   }
  }
}

mixed id(mixed str) {
    return str == name;
}
