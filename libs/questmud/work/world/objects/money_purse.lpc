#define STACK_D "/daemons/string_stack_d"

mixed id(mixed str) { return str == "purse" || str == "money purse"; }

mixed add_weight(mixed w) {	return 1; }

mixed query_weight() { return 100; }

mixed query_no_save() { return 1; }

mixed query_value() { return 50; }

mixed can_put_and_get(object ob) { return 1; }

mixed get() { return 1; }

mixed drop() { return 0; }

mixed short() { return "A silk money purse"; }
mixed query_long() { return "A money purse made from silk. It can be used to carry unlimited amount of money.\n"; }

mixed query_purse() { return 1; }

mixed long() {
  object ob;
  int i;
  string lista, *list;
  write(short()+"\n");
  write("It contains:\n");
  ob = all_inventory(this_object());
  list = allocate(sizeof(ob));
  for(i=0; i<sizeof(ob); i++) {
  list[i] = ob[i]->short();
  }
  lista = STACK_D->stack_item_list(list);
  if(lista) write(lista+".\n");
  return 1;
}