int i;
string short;
/* LDMud ran reset(0) when an object loaded; this driver only runs create().
 * call_other so the most-derived reset() runs (KB 06 section 7.177). */
/* Called before their definitions (LDMud allowed that). */
varargs mixed set_short(mixed str);

void create() {
    call_other(this_object(), "reset", 0);
}

mixed reset(mixed arg) {
  if(arg) return;
  i = random(4);
  if(i==0) set_short("A huge pool of blood covering the ground");
  if(i==1) set_short("Some blood drops lying on the ground");
  if(i==2) set_short("A little pool of blood covers ground");
  if(i==3) set_short("A small amount of blood lying on the ground");
  call_out("dry", 120+random(120));
}

mixed set_short(mixed str) { short = str; }
mixed short() { return short; }
mixed id(mixed str) { return str == "blood" || str == "pool" || str == "drops" || str== short; }

mixed long() {
  write("Blood is fresh and propably from some creature that is nearby.\n"
        "The red liquid looks disgusting.\n");
}

mixed dry() {
  destruct(this_object());
}

mixed query_blood() {
        return this_object();
}

mixed query_level() {
        return 10-i;
}
