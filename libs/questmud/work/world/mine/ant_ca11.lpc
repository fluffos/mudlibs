#include "room.h"
object ant, ant2, ant3, ant4;
mixed extra_reset() {    
    if (!ant || !living(ant)) {
	ant = clone_object("world/monsters/ant1.lpc");
	ant->move_object(this_object());
    }
    if (!ant2 || !living(ant2)) {
	ant2 = clone_object("world/monsters/ant1.lpc");
	ant2->move_object(this_object());
    }
    if (!ant3 || !living(ant3)) {
	ant3 = clone_object("world/monsters/ant1.lpc");
	ant3->move_object(this_object());
    }
    if (!ant4 || !living(ant4)) {
	ant4 = clone_object("world/monsters/ant2.lpc");
	ant4->move_object(this_object());
    }
    set_not_out(1);
}

#undef EXTRA_RESET
#define EXTRA_RESET\
	extra_reset();

THREE_EXIT("world/mine/ant_ca13", "west",
	 "world/mine/ant_ca10", "south",        
	 "world/mine/ant_cav9", "east",        
	 "Ant cave",
	 "You are walking in a huge ant nest.\n" +
	 "The ceiling looks very solid and must have been done by ants.\n" + 
	 "You can see, because there is some strange light\n" + 
	 "coming from the rocks.\n", 3)
	 
