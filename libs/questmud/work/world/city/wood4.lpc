inherit "room/room";
object monster,monster2;
mixed init() {
   ::init();
   add_action("map", "map");
   add_action("south", "south");
}

mixed reset(mixed arg) {
if(arg) return;

if (!monster) {
                monster = clone_object("/world/monsters/citizen.lpc");
                monster->move_object(this_object());
  }

if (!monster2) {
                monster2 = clone_object("/wizards/jenny/city/guards/cityguard.lpc");
                monster2->move_object(this_object());
 }

        add_exit("west","/world/city/wood3.lpc");
        add_exit("east","/world/city/wood5.lpc");
        add_exit("north","/world/city/gold8.lpc");
        add_exit("south","/world/city/southgate.lpc");

    short_desc = "On the crossing of Wood street and Gold street";
    long_desc = "########### You are on the crossing of Wood street and Gold street.\n" + 
		"#    |    # Wood street crosses Emerald street west from here and \n" +
		"#-+--*--+-# the Silver streets some distance in east from here.\n" + 
		"#WTTT=TTTW# These two old streets have all kinds of shops scattered\n" +
		"########### to each side of their streets. The huge south gate lies\n" +
		"just south protecting the city.\n";
  set_light(3);
}

mixed map(mixed arg) {
   int *coords;
   string file;
   object map;

   if (arg) {
        return 0;
   }

   map = (object) "/wizards/moonstar/muut/map";

   file = file_name(environment(this_player()));
   coords = map->to_coords(file);
   map->drawmap(coords[0], coords[1]);

   return 1;
}


int south() {
  if(this_player()) return 0;
  if(previous_object()->query_monster()) return 1;
}
