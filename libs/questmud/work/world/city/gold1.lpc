inherit "room/room";
object monster,monster2;
mixed init() {
   ::init();
   add_action("map", "map");
   add_action("north", "north");
}

mixed reset(mixed arg) {
if(arg) return;

if (!monster) {
                monster = clone_object("/world/monsters/citizen.lpc");
                monster->move_object(this_object());
  }

if (!monster2) {
                monster2 = clone_object("/wizards/jenny/city/guards/cityguard.lpc");
                monster2->move_object(this_object());
  }

        add_exit("east","/world/city/fire4.lpc");
        add_exit("west","/world/city/fire3.lpc");
        add_exit("south","/world/city/gold2.lpc");
        add_exit("north","/world/city/northgate.lpc");

    short_desc = "On the crossing of Fire street and Gold street",
    long_desc = "########### You are on Fire street Crossing the big Gold street running \n" + 
		"#WTTT=TTTW# north-south. These streets are homes to rich merchants as well as\n" +
		"#-+--*--+-# the common folk of Duranghom. These two streets are mostly filled\n" + 
		"#    |    # with high quality houses in which travellers can spend the\n" +
		"########### night and where the citizens live. Silver street is located\n" +
		"east of here, Emerald street is to the west and the Mainstreet of Duranghom\n" +
		"is much south from here. The North gate is located in north.\n";
  set_light(3);
}

mixed map(mixed arg) {
   int *coords;
   string file;
   object map;

   if (arg) {
        return 0;
   }

   map = (object) "/wizards/moonstar/muut/map";

   file = file_name(environment(this_player()));
   coords = map->to_coords(file);
   map->drawmap(coords[0], coords[1]);

   return 1;
}

int north() {
  if(this_player()) return 0;
  if(previous_object()->query_monster()) return 1;
}
