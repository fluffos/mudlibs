#define MAX_WEIGTH	6
int local_weight;

mixed long() {
    write("A bag. ");
    if (first_inventory(this_object()))
	write("There is something in it.\n");
    else
	write("You can put things in it.\n");
}

mixed reset(mixed arg) {
    if (arg)
	return;
    local_weight = 0;
}

mixed query_weight() {
    return 1;
}

mixed add_weight(mixed w) {
    if (local_weight + w > MAX_WEIGTH)
	return 0;
    local_weight += w;
    return 1;
}

mixed short() {
    return "bag";
}

mixed id(mixed str) {
    return str == "bag";
}

mixed query_value() {
    return 12;
}

mixed can_put_and_get() { return 1; }

mixed get() {
    return 1;
}

mixed prevent_insert() {
    if (local_weight > 0) {
	write("You can't when there are things in the bag.\n");
	return 1;
    }
    return 0;
}
