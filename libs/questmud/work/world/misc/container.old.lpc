int value, max_weight, local_weight;
string name_of_container ,cap_name ,alt_name ,alias_name;
string short_desc, long_desc;

mixed long() {
    write(long_desc);
    if (first_inventory(this_object()))
	write("There is something in it.\n");
    else
	write("You can put things in it.\n");
}

mixed reset(mixed arg) {
    if (arg)
	return;
    local_weight = 0;
}

mixed query_weight() { return local_weight; }

mixed query_max_weight() { return max_weight; }

mixed add_weight(mixed w) {
    if (local_weight + w > max_weight)
	return 0;
    local_weight += w;
    return 1;
}

mixed short() { return short_desc; }

mixed id(mixed str) {
   return str == name_of_container || str == alt_name || str == alias_name;
}

mixed query_value() { return value; }

mixed can_put_and_get() { return 1; }

mixed get() { return 1; }

mixed prevent_insert() {
    if (local_weight > 0) {
	write("You can't when there are things in the " + name_of_container + ".\n");
	return 1;
    }
    return 0;
}

mixed set_weight(mixed w) { local_weight = w; }

mixed set_max_weight(mixed w) { max_weight = w; }

mixed set_value(mixed v) { value = v; }

mixed set_name(mixed n) {
    name_of_container = n;
    cap_name = capitalize(n);
    short_desc = cap_name;
    long_desc = cap_name;
}

mixed set_alt_name(mixed n) { alt_name = n; }

mixed set_alias(mixed n) { alias_name = n; }

mixed set_short(mixed sh) { short_desc = sh; long_desc = short_desc + "\n"; }

mixed set_long(mixed lo) { long_desc = lo; }

