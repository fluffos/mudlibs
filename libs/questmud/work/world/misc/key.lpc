string type;
string code;


mixed short()
{
 return "A " + type + " key";
}

mixed set_key_data( mixed str)
{
  if ( sscanf(str, "%s %s", type, code) == 2) 
    return 1;
  return 2;
}
mixed long()
{
 write("\nThis a " + type + " key, wonder where it fits?\n");
}

mixed id( mixed strang)
{
 if ( ( strang == "key" )||( strang == type + " key")||( strang == "H_key") )
   return 1;
 return 0;
}

mixed get()
{
  return 1;
}

mixed query_value()
{
 return 10;
}

mixed query_type() { return type; }
mixed query_code() { return code; }

mixed set_type( mixed str) { type = str; }
mixed set_code( mixed str) { code = str; }

mixed init() {
}

mixed reset( mixed arg) {
 if(arg)
   return;
 type = 0;
 code = 0;
}

