object next;
object monster;
string chat_str;

/*
short() { return chat_str; }
*/

mixed link(mixed ob) {
    next = ob;
}

mixed load_chat(mixed str) {
    chat_str = str;
}

mixed set_monster(mixed m) {
    monster = m;
}

mixed chat(mixed nr) {
    object room;

    if (nr == 0){
	room = environment(monster);
	if(room)
	    return tell_room(room,chat_str);
    }
    nr -= 1;
    if (next)
	return call_other(next, "chat", nr);
    else
	return 0;
}

mixed remove_chat(mixed str) {
    if (str == chat_str) {
	destruct(this_object());
	return next;
    }
    if (next)
	next = call_other(next, "remove_chat", str);
    return this_object();
}

mixed collaps()
{
    if(next)
	call_other(next, "collaps");
    destruct(this_object());
}

mixed drop() { return 1; }
