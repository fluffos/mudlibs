/* LDMud ran reset(0) when an object loaded; this driver only runs create().
 * call_other so the most-derived reset() runs (KB 06 section 7.177). */
void create() {
    call_other(this_object(), "reset", 0);
}

mixed reset() { }

mixed short() { return "One exit: inn"; }

mixed init() {
  add_action("move_out", "inn");
}

mixed move_out() {
  write("Moving..\n");
  this_player()->move_object("/world/city/inn");
  return 1;
}
