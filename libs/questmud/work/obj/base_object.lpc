string name, short_desc, long_desc, extra_long, label, prevent_insert_message, material, alias;
/* Declared as a plain string alongside the other string fields above,
 * but every call site (set_size(2)/set_size(30)/set_size(5), and this
 * file's own get_size(int) below expecting a 0-100 numeric size code)
 * treats it as a numeric size code -- same class as NOTES.md §3's
 * declared-type bugs, just the opposite direction (wrong scalar type,
 * not scalar-vs-array). Broke every object built on this base class
 * whose reset() calls get_size(size) (a same-file forward reference
 * to line 107, itself only reachable once this type mismatch is
 * fixed) -- confirmed live: this crashed /world/city/cs.lpc's own
 * reset() via its fountain clone, silently skipping the exit/short/
 * long setup that comes after in the same function and leaving the
 * game's own Central Square hub with zero exits. */
int size;
int weight, prevent_insert, value, no_drop, no_get, no_save, no_label;

/* Forward declaration: called (line 64) before its own definition
 * (below) in this same file. */
mixed get_size(int i);

mixed reset(mixed arg) {
   if (arg) return;
}

mixed id(mixed str) { return str == name || str == label || str == alias; }

mixed get() { return no_get; }

mixed query_weight() { return weight; }

mixed query_size() { return size; }

mixed query_can_label() { return no_label; }
mixed query_label() { return label; }
mixed query_short() { return short_desc; }

mixed query_value() { return value; }

mixed query_no_save() { return no_save; }

mixed drop() { return no_drop; }

mixed prevent_insert() {
if(prevent_insert && prevent_insert_message) {
write(prevent_insert_message+".\n");
return 1;
} else if(prevent_insert && !prevent_insert_message) {
write("You can't put this item there.\n");
return 1;
}
return 0;
}

mixed short() {
 string str;
 str = "";
 str += short_desc;
 if(label) { str +=" named as '"+label+"'"; }
 return str;
}

mixed long() {
  string str;
  str = "";
  str += long_desc+".\n";
  if(extra_long) { str += extra_long+".\n"; }
  if(material) { str += "It is made from "+material+".\n"; }
  if(size) { str += "It is "+get_size(size)+" sized "+name+".\n"; }
  write(str);
  return 1;
}
mixed query_long() { return long_desc+".\n"; }

//Sets the name of this object
mixed set_name(mixed str) { name=str; }
//Sets the short of this object
mixed set_short(mixed str) { short_desc=str; }
//Sets the long desc of this object
mixed set_long(mixed str) { long_desc=str; }

mixed set_extra_long(mixed str) { extra_long=str; }

//Sets the label of this object
mixed set_label(mixed str) { label=str; }
//Use this if you don't wan't that object to be inserted anywhere
mixed set_prevent_insert() { prevent_insert=1; }
//sets the message what is printed to player if he/she tries to insert this somewhere
mixed set_prevent_insert_message(mixed str) { prevent_insert_message=str; }
//Sets the weight of this object
mixed set_weight(mixed i) { weight=i; }
//Sets the value of this object
mixed set_value(mixed i) { value=i; }
//Sets if this object can be dropped, 1 cant be dropped, 0 can be dropped
mixed set_no_drop(mixed i) { no_drop=i; }
//Sets that this object can be taken, 1 can be taken, 0 can't.
mixed set_no_get(mixed i) { no_get=i; }
//Prevent this object to be saved somewhere
mixed set_no_save(mixed i) { no_save=i; }
//If you don't want to this object to be labeled use: set_can_label(i);
mixed set_can_label(mixed i) { no_label=i; }

mixed set_size(mixed i) { size=i; }

mixed set_alias(mixed str) { alias=str; }

//Something useless tms
mixed set_material(string str) {
	material=str;
}



mixed stat_me() {
write("Short desc: '"+short_desc+"'\n");
write("Long desc: '"+long_desc+".'\n");
write("Name: '"+name+"'.\n");
write("Label: '"+label+"'.\n");
write("Prevent insert: '"+prevent_insert+"' Message: '"+prevent_insert_message+"'.\n");
write("Weight: '"+weight+"' Value: '"+value+"'.\n");
write("Drop: '"+no_drop+"' Get '"+no_get+"' Save '"+no_save+"'.\n");
return 1;
}

mixed get_size(int i) {
        switch(i) {
                case 0..10:return "tiny";
                case 11..20:return "very small";
                case 21..30:return "small";
                case 31..40:return "below medium";
                case 41..50:return "medium";
                case 51..60:return "above medium";
                case 61..70:return "large";
                case 71..80:return "very large";
                case 81..90:return "huge";
                case 91..100:return "gigantic";
			}
			return "Invalid size set";
}