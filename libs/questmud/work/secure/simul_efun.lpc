mixed snoop(object snooper, object snoopee) {
    /* LDMud's snoop() returns an int status code (-1/0/1); this
     * driver's snoop() returns the snooped object on success, 0 on
     * failure -- another dialect gap, fixed by switching result's
     * type and reading its truth value directly (loses the distinct
     * "Busy." vs "Failed." wording FluffOS's own return doesn't
     * distinguish). */
    object result;

    if (snoopee && query_snoop(snoopee)) {
        write("Busy. Snooped by "+query_snoop(snoopee)->query_name()+"\n");
        return 0;
    }
    result = snoopee ? efun::snoop(snooper, snoopee)
                     : efun::snoop(snooper);
    if (!result) {
        write("Failed.\n");
        return 0;
    }
    write("Ok.\n");
    return result;
}

/* You can remove this simul_efun if you have no objects in your mudlib that
 * use process_string in notify_fail, or if you change them to use closures.
 */
void notify_fail(mixed message) {
    /* The "@@...@@" process_string()-in-notify_fail lazy-closure path
     * (LDMud lambda/bind_lambda/funcall, none of which exist here) is
     * dropped: grepped the whole mudlib for notify_fail(...@@...) call
     * sites and found zero -- nothing actually used it. */
    efun::notify_fail(message);
}

string version() {
    return __VERSION__;
}

string query_host_name() {
    /* __HOST_NAME__ isn't a predefine on this driver (no equivalent
     * found at all); this is cosmetic (a few player-info screens), so
     * just name the mud itself rather than a real host. */
    return "questmud";
}

/* On LDMud, m_delete() was a real driver efun (non-mutating: returns a
 * NEW mapping with the key removed), so this mudlib's own version of
 * it shipped commented out. FluffOS has no m_delete efun at all --
 * only map_delete(), which is void/in-place (mutates its argument, no
 * return value) -- the classic MudOS/LDMud map_delete() dialect gap
 * documented project-wide in AGENTS.md. 35 files across this mudlib
 * (obj/player.lpc, several daemons, ...) call m_delete() expecting the
 * old non-mutating LDMud contract, so re-enable this simul_efun
 * (uncommented) as the compat shim, copying via mapping `+` (FluffOS
 * has no copy_mapping() either) before deleting from the copy. */
mapping m_delete(mapping m, mixed key) {
    mapping copy = m + ([]);
    efun::map_delete(copy, key);
    return copy;
}

nomask void shutdown() {
  string file;
  file = object_name(previous_object());
  if (file == "/obj/timer" ||
      file == "/secure/master") {
    efun::shutdown();
  }
}        

mixed command(string cmd, object called) {
  /* This driver's real command() efun takes only the command string
   * and always executes as this_player() -- no second "run as" object
   * argument, and (unlike LDMud) no set_this_player() efun to fake one
   * either: it only exists on a build with add_action DISABLED, the
   * opposite of this one (confirmed via core.spec's #ifndef
   * NO_ADD_ACTION guard). So this can only actually run as the real
   * this_player() of the current connection. That matches the
   * overwhelming majority of call sites already (they pass their own
   * this_object(), which already IS this_player() at that point --
   * doc/misc/player.lpc, doc/misc/living.lpc, etc.); the one known
   * divergent caller is obj/party.lpc's follow-mechanic (running a
   * movement command as OTHER party members), which will now only
   * affect this_player() -- a real, documented limitation rather than
   * an invented workaround. */
  if(!cmd) return 0;
  if(called && called->query_wiz()) {
    if(!interactive(previous_object()) || called->query_wiz() > this_player()->query_wiz())
      return 0;
  }
  return efun::command(cmd);
} 

nomask void set_this_player() {}

void wizlist(string name) {
    /* Driver-tracked command-count/eval-cost scoreboard: relied on
     * wizlist_info() plus the WL_* index constants from wizlist.h,
     * neither of which exist on FluffOS (no wizlist_info() efun at
     * all). Not reconstructable from data this driver tracks, so this
     * is a graceful stub rather than a real port -- see NOTES.md. */
    write("The wizard scoreboard is not available under this driver.\n");
}

void shout(string s) {
    object *u;
    int i;

    u = users();
    for (i = 0; i < sizeof(u); i++) {
        if (environment(u[i]) && u[i] != this_player())
            tell_object(u[i], s); /* s is already a string; to_string() isn't a FluffOS efun */
    }
}

/* Initialized directly (not left to start_simul_efun() below) --
 * master::get_simul_efun() (which called start_simul_efun() on this
 * object) is an LDMud-only master apply not in this driver's applies
 * table at all, so it's never invoked; without a global initializer
 * these stayed the LPC-default int 0, and the very first
 * find_player()/find_living() call ("Value being indexed is zero")
 * crashed every single character's own password-confirmation step,
 * a few calls into move_player_to_start3() -- totally blocking
 * registration. */
mapping living_name_m = ([]), name_living_m = ([]);

void start_simul_efun() {
    /* Original persisted living_name_m/name_living_m across a live
     * `update` of this very file via get_extra_wizinfo()/
     * set_extra_wizinfo() (neither exists on FluffOS). Simplified to
     * plain reinitialize-if-unset: only loses the accumulated
     * find_living()/find_player() name index across a live recompile
     * of secure/simul_efun.lpc, not across an ordinary boot. */
    if (!living_name_m) living_name_m = ([]);
    if (!name_living_m) name_living_m = ([]);
    if (find_call_out("clean_simul_efun") < 0)
	call_out("clean_simul_efun", 1800);
    this_object()->start_simul_efun_dr();
}

nosave void clean_name_living_m(string *keys, int left) {
    int i, j;
    mixed a;

    if (left) {
	if (pointerp(a = name_living_m[keys[--left]]) && member(a, 0)>= 0) {
	    i = sizeof(a);
	    do {
		if (a[--i])
		    a[<++j] = a[i];
	    } while (i);
	    name_living_m[keys[left]] = a = j > 1 ? a[<j..] : a[<1];
	}
	if (!a)
	    efun::map_delete(name_living_m, keys[left]);
	call_out("clean_name_living_m", 1, keys, left);
    }
}

nosave void clean_simul_efun() {
    /* There might be destructed objects as keys. */
    keys(living_name_m);
    remove_call_out("clean_simul_efun");
    if (find_call_out("clean_name_living_m") < 0) {
	call_out(
	  "clean_name_living_m",
	  1,
	  keys(name_living_m),
	  sizeof(name_living_m)
	);
    }
    call_out("clean_simul_efun", 3600);
}

/* disable symbol_function('set_living_name, SIMUL_EFUN_OBJECT) */
// protected void set_living_name(string name) {
void set_living_name(string name) {
    string old;
    mixed a;
    int i;

    if (old = living_name_m[previous_object()]) {
	if (pointerp(a = name_living_m[old])) {
	    a[member(a, previous_object())] = 0;
	} else {
	    efun::map_delete(name_living_m, old);
	}
    }
    living_name_m[previous_object()] = name;
    if (a = name_living_m[name]) {
	if (!pointerp(a)) {
	    name_living_m[name] = ({a, previous_object()});
	    return;
	}
	/* Try to reallocate entry from destructed object */
	if ((i = member(a, 0)) >= 0) {
	    a[i] = previous_object();
	    return;
	}
	name_living_m[name] = a + ({previous_object()});
	return;
    }
    name_living_m[name] = previous_object();
}

object find_living(string name) {
    mixed *a, r;
    int i;

    if (pointerp(r = name_living_m[name])) {
	if ( !living(r = (a = r)[0])) {
	    for (i = sizeof(a); --i;) {
		if (living(a[<i])) {
		    r = a[<i];
		    a[<i] = a[0];
		    return a[0] = r;
		}
	    }
	}
	return r;
    }
    return living(r) && r;
}

object find_player(string name) {
    mixed *a, r;
    int i;

    if (pointerp(r = name_living_m[name])) {
	if ( !(r = (a = r)[0]) || !interactive(r)) {
	    for (i = sizeof(a); --i;) {
		if (a[<i] && interactive(a[<i])) {
		    r = a[<i];
		    a[<i] = a[0];
		    return a[0] = r;
		}
	    }
	    return 0;
	}
	return r;
    }
    return r && interactive(r) && r;
}


// Added by Celtron for LDMUD

string geteuid(object ob) {
  string str, wiz_name;

  str = object_name(ob);
  if(sscanf(str, "/wizards/%s/%s", wiz_name, str) != 2) {
    return "Questlib";
  }
  return "wizard "+wiz_name;
}

void cindent(string name)
{
    /* Wizard dev-tool: shells out to an external "indent" formatter via
     * the erq package (send_erq()/ERQ_FORK), which doesn't exist on
     * this driver -- only ever called from wizards/siki's own sandbox
     * copy of this file, not the live one. Stubbed. */
    write("cindent is not available under this driver.\n");
}

/*
 * Function name: exclude_array
 * Description:   Deletes a section of an array
 * Arguments:     arr: The array
 *		  from: Index from which to delete elements
 *		  to: Last index to be deleted.
 * Returns:       
 */
public mixed *
exclude_array(mixed *arr, int from, int to)
{
    return arr[0..from-1] + arr[to+1..sizeof(arr)];
}


/*
 * Function name: exclude_element
 * Description:   deletes an element from an array
 * Arguments:     arr: the array
 *                from: index of the element to remove from the array
 * Returns:       first element of the array, or -1 if failed.
 * Warning:       elements in the array will have been reshuffled somewhat.
 */
