object *find_all_living(string name) {
  object ob, *all;
  int i;

  /* Original used an unbound_lambda(#'set_living_name) closure so it
   * could bind it fresh to each object in turn; a direct call_other
   * does exactly the same thing without needing closures at all. */
  for(all = ({}),i = 0; (ob = find_living(name)) && i < 45; i++) {
    //if(member_array(ob, all) != -1) break;
    all += ({ ob, });
    ob->set_living_name("DUMMY");
  }
  for(i = sizeof(all); i--; ) {
    all[i]->set_living_name(name);
  }
  return all;
}



