}
*/

/*************************************************************************/

/* Efun: all_environment() */

/*
 * Function name: all_environment
 * Description:   Gives an array of all containers which an object is in, i.e.
 *		  match in matchbox in bigbox in chest in room, would for the
 *		  match give: matchbox, bigbox, chest, room 
 * Arguments:     ob: The object
 * Returns:       The array of containers.
 */
public object *
all_environment(object ob)
{
  object *r;
  
  if (!ob || !environment(ob)) return 0;
  if (!environment(environment(ob)))
      return ({ environment(ob) });
  r = ({ ob = environment(ob) });
  while (environment(ob))
      r = r + ({ ob = environment(ob) });
  return r;
}

/*************************************************************************/

/* Efuns: break_string() and update_actions()
*/

nosave int gCol;

/*
 * Function name: break_string
 * Description:   Breaks a continous string without newlines into a string
 *		  with newlines inserted at regular intervalls replacing spaces
 *		  Each newline separeted string can be indented with a given
 *		  number of spaces.
 * Arguments:     str: Original message
 *		  width: The total maximum width of each line.
 *		  indent: (optional) How many spaces to indent with.
 * Returns:       A string with newline separated strings
 */
public varargs string
break_string(string str, int width, int indent)
{
    mixed *brkarg;
    string indstr;

    if (indent) {
      string spaces = "                                                                                ";
	//indstr = extract("                                                                                ", 0, indent-1);
      indstr = spaces[indent-1..-1];
    }
    else {
	indstr = "";
     }
    gCol = indent;
    brkarg = ({ width, indstr });

    return str;  
    //return indstr + 
    //  implode(to_array(explode(str+" "," "),"brk",this_object(),brkarg," "));
}

nosave string brk(string word, mixed *width_indstr)
{
    int width;
    string indstr;

    width = width_indstr[0];
    indstr = width_indstr[1];
    if ((strlen(word)+gCol) > width) {
	gCol = strlen(indstr) + strlen(word) + 1;
	return "\n" + indstr + word;
    }
    else {
	gCol += strlen(word) + 1;
	return word;
    }
}    

/*
 * Function name:   update_actions
 * Description:     Updates this_objects actions in all living objects
 */
public void
update_actions()
{
  int objs;

  if (environment(previous_object()))
    previous_object()->move(environment(previous_object()),1);
  filter(all_inventory(previous_object()),"move_inv",previous_object());
}

nosave void move_inv(object ob) { if (living(ob)) ob->move(previous_object(),1); }

/*************************************************************************/


/* Functions below are useful but should probably not be made into efuns
*/

/* creator()/domain() are used throughout this mudlib (obj/player.lpc's
 * reset(), logon2(), etc.) as an "is this a wizard's own ad-hoc clone,
 * not a normal system-created object" guard: `if (creator(ob))
 * destruct(ob);`. Under real euid tracking every object always has
 * SOME uid (this driver's master::creator_file() must always return a
 * real string, never LDMud's original int-0/1 "no special uid"
 * sentinel -- see secure/master.lpc's own port-note comment), so a
 * bare getuid() passthrough made creator() truthy for EVERY object,
 * including perfectly legitimate clone_object("obj/player") calls
 * from master::connect() -- every single new connection's player
 * object was destructing itself immediately in reset(), the actual
 * root cause behind "*No program in object '/obj/player'!" on every
 * connect attempt. Filter out the backbone/system uid so only a real
 * per-wizard uid counts as "creator". */
string creator(object ob) {
    string uid = (string)getuid(ob);
    return (uid && uid != (string)MASTER->get_bb_uid()) ? uid : 0;
}
string domain(object ob) {
    string uid = (string)getuid(ob);
    return (uid && uid != (string)MASTER->get_bb_uid()) ? uid : 0;
}

