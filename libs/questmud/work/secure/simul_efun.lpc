/*
 * This is a mudlib file. Copy it to /secure/simul_efun.c, or
 * wherever the get_simul_efun() in master.c says.
 * The functions defined in this file should only be replacements of efuns
 * no longer supported. Don't use these functions any longer, use the
 * replacement instead.
 */

/*
  simul_efun.c
*/
#define MAX_LOG_SIZE 50000

#define BACKBONE_WIZINFO_SIZE 5

#define LIVING_NAME 3
#define NAME_LIVING 4

/* FluffOS port note (questmud): wizlist.h/erq.h dropped -- no
 * wizlist_info()/extra_wizinfo or erq package on this driver. See
 * NOTES.md and secure/master.lpc's own port-note comments. */

#pragma strong_types
#pragma save_types
#define MASTER "secure/master"

//////////////////////////////////////////////
// Replacements for obsolete functions ++C ///
//////////////////////////////////////////////

/* LDMud's bare member() (array-index-or-mapping-presence, argument
 * order (arr, elem)) doesn't exist on this driver at all; FluffOS
 * already has a real member_array(elem, arr) efun with the same
 * contract this wrapper wants, so just fall through to it (efun::
 * bypasses this very simul_efun, avoiding self-recursion). */
int member_array(mixed elem, mixed arr) {
  return efun::member_array(elem, arr);
}

/* Generic member() used ~70x across this mudlib (both array-index
 * lookups and mapping-key presence checks, the LDMud overload). */
mixed member(mixed what, mixed elem) {
  if (mapp(what)) return what[elem] != 0;
  return efun::member_array(elem, what);
}

/* cat(file, start, num) is a genuine LDMud built-in efun (print a
 * chunk of a file's lines) with no FluffOS equivalent at all -- 582
 * call sites across this mudlib, including the very first login
 * banner (obj/player.lpc printing /WELCOME) and the "more"-style
 * pager (even_more()/cat_file()), so this had to be a real
 * implementation, not a stub. Returns 0 on failure (missing file, or
 * start past EOF), else the number of lines actually printed --
 * matches every call site's `== 0`/truthiness check. */
varargs int cat(string file, int start, int num) {
    string content;
    string *lines;
    int total, from, to;

    if (!file) return 0;
    content = read_file(file);
    if (!content) return 0;
    if (strlen(content) && content[strlen(content)-1] == '\n')
        content = content[0..<2];
    lines = explode(content, "\n");
    total = sizeof(lines);
    from = start ? start : 1;
    if (from < 1) from = 1;
    if (from > total) return 0;
    to = num ? from + num - 1 : total;
    if (to > total) to = total;
    write(implode(lines[from-1..to-1], "\n") + "\n");
    return to - from + 1;
}

string extract(string st, int from, int to) {
  return st[from..to];
}

int m_sizeof(mapping map) {
  return sizeof(map);
}

mixed *filter_array(mixed *arr, mapping map, mixed extra) {
  return filter(arr, map, extra);
}

/* LDMud's real efun is object_name(); this driver's real efun is the
 * older MudOS name file_name() instead -- object_name() doesn't exist
 * here at all (confirmed: zero hits anywhere in this project's whole
 * onboarded corpus/AGENTS.md, a genuinely new efun-naming gap, unlike
 * every other MudOS-lineage lib onboarded so far). This mudlib
 * originally aliased file_name() -> object_name() (i.e. assumed
 * object_name was the real one); flipped to alias the other way, so
 * every file_name() call elsewhere in this mudlib keeps working
 * (falls through to the real efun untouched) and object_name() becomes
 * the new compat shim for the handful of LDMud-native call sites
 * (secure/master.lpc, this file's own geteuid(), one wizard test
 * file). */
/* to_string(mixed) is genuinely used 64x across this mudlib (int/float
 * -> string) and isn't a real efun on this driver (to_int() exists,
 * to_string() doesn't). This driver's `+` operator already coerces
 * int/float onto a string (confirmed widely elsewhere in this mudlib,
 * e.g. "text: "+some_int+"\n" compiles and runs fine), so string
 * concatenation with "" is a safe, simple implementation. */
/* set_modify_command(ob) was the LDMud API for registering a per-
 * object H_MODIFY_COMMAND_FNAME hook (direction abbreviations like
 * "n"->"north"); that whole driver_hook mechanism doesn't exist on
 * this driver (see secure/master.lpc's inaugurate_master() port-note)
 * and isn't a real efun either. Cosmetic (players can still type the
 * full direction name), so a no-op is a safe stub. */
void set_modify_command(mixed ob) {
}

/* tail(file) is a genuine LDMud efun (print the LAST few lines of a
 * file) with no FluffOS equivalent -- reimplemented in pure LPC per
 * AGENTS.md's own cataloged fix for this exact efun-naming gap
 * (section 6.2). Matches cat()'s truthy/falsy return contract. */
int tail(string file) {
    string content;
    string *lines;
    int total, from;

    if (!file) return 0;
    content = read_file(file);
    if (!content) return 0;
    if (strlen(content) && content[strlen(content)-1] == '\n')
        content = content[0..<2];
    lines = explode(content, "\n");
    total = sizeof(lines);
    from = total > 10 ? total - 10 : 0;
    write(implode(lines[from..total-1], "\n") + "\n");
    return 1;
}

/* unshadow() (bare, meaning "remove every shadow currently overlaying
 * this_object()") is a real LDMud efun with no FluffOS equivalent --
 * FluffOS only has shadow()/query_shadowing() to walk the chain. This
 * mudlib's spell/status-effect system (haste, shield, heal_resist,
 * stat_boost, ...) shadows the target for the effect's duration, so
 * this needed a real implementation, not a stub. Destructs each
 * shadow layer (these are single-purpose ephemeral effect objects
 * with no other purpose once removed) rather than merely unlinking,
 * matching how master.lpc's own prepare_destruct() already tears down
 * a shadow chain on this driver. */
void unshadow() {
    object sh, next;
    for (sh = shadow(this_object(), 0); sh; sh = next) {
        next = shadow(sh, 0);
        destruct(sh);
    }
}

/* strstr(haystack, needle, start) is LDMud's real efun (used 24x
 * across this mudlib); this driver's equivalent is strsrch() with the
 * same (string, string|int, int start) contract and -1-on-not-found
 * return, so a direct passthrough alias is safe. */
varargs int strstr(string haystack, mixed needle, int start) {
    return strsrch(haystack, needle, start);
}

string to_string(mixed x) {
    return "" + x;
}

string object_name(object ob) {
  return efun::file_name(ob);
}

/////////////////////////////////////////////////////
// End of Replacements for obsolete functions ++C ///
/////////////////////////////////////////////////////

/*
 * new efun to force string length by adding empty spaces 
 * ..or cutting it //Celtron
 */
string force_string_length(string str, int set_length) {
  string spaces;
  int spacelength;
  spaces = "                                                               ";

  if(strlen(str) >= set_length)
    return str[0..(set_length-1)];

  spacelength = set_length - strlen(str);
  if(spacelength > strlen(spaces)) spacelength = strlen(spaces);
  str = str + spaces[0..(spacelength-1)];
  return str;  
}

/*
 * The ls() function is no longer needed, as get_dir() can do the same
 * work.
 */
void ls(string path) {
    int max, i, len, tmp;
    int trunc_flag;
    mixed *dir;
    /* set_this_object() removed: not a FluffOS efun. Bare simul_efun
     * calls already execute with this_object()/current_object left as
     * the ORIGINAL caller (unlike LDMud, where a simul_efun is a real
     * object and this trick was needed to fake that). */
    dir = get_dir (path,3);
#if defined(COMPAT_FLAG) && 0
    if (path[0] == '/')
      path = path[1:];
    if (path != "")
      path += "/";
#else
    if (path != "/")
	path += "/";
#endif
    if (!dir) {
        write("No such directory.\n");
        return;
    }
    if (sizeof(dir) > 999)
    {
        dir = dir[0..998];
        trunc_flag = 1;
    }
    for(i = sizeof(dir); i--; ) {
        if(dir[i--] == -2)
            dir[i]+="/";
        len = strlen(dir[i]);
        if (len > max)
            max = len;
    }
    ++max;
    if (max > 79)
        max = 79;
    for (i=0; i < sizeof(dir); i+=2) {
	string name;
            name = dir[i];
	tmp = strlen(name);
	if (len + tmp > 79) {
	    len = 0;
	    write("\n");
	}
	write(name);
        if (len + max > 79) {
            write("\n");
            len = 0;
        } else {
	  string spaces = " ";//                                                                               ";
	  for(int si=0; si < 80-max+tmp; si++)
	    spaces = spaces + " ";
	  write(spaces);
	  len += max;
        }
    }
    write("\n");
    if (trunc_flag) write("***TRUNCATED***\n");
}

int file_time(string path)
{
    mixed *v;

    /* set_this_object() removed: not a FluffOS efun. Bare simul_efun
     * calls already execute with this_object()/current_object left as
     * the ORIGINAL caller (unlike LDMud, where a simul_efun is a real
     * object and this trick was needed to fake that). */
    if (sizeof(v=get_dir(path,4))) return v[0];
}


mixed valid_write(string str, object caller) {
  string who, file, owner,tmp, current_path;
  int Wiza, i;
  object ob;

  if(!caller) return 0;
  Wiza = caller->query_wiz();
  current_path = caller->query_current_path();
  i = strlen(str) - 1;
  while(i>0) {
    if (str[i] == '.' && str[i-1] == '.') {
      write("Illegal to have '..' in path.\n");
      return 0;
    }
    i -= 1;
  }

  if (str[0] != '/') {
    if (current_path && current_path != "/" && current_path != "")
      str = "/" + current_path + "/" + str;
    else
      str = "/" + str;
  }

  /* keys to the houses around city */
  if(sscanf(str, "/room/houses/keys/%s", tmp) == 1 && !Wiza && interactive(caller)) return str;

  // As requested by Rag -Nalle 
  if(str == "/log/WARLOCK") return str;

  // Requested by Astarel -N
  if(str[0..16] == "/data/stronghold/") return str;


  /* data write access: locker, bank, spellbook etc */
  if(!Wiza && sscanf(str, "/data/%s", file) == 1 && interactive(caller) )
    return str;

  if(str[0..10] == "/data/news/" && previous_object() && object_name(previous_object()) == "/daemons/news_d")
	return str;

  if(!Wiza) return 0;

// Nimikohtaset accessit (write)

  if(caller->query_real_name() == "rimber" && str[0..14] == "/guilds/warlock") return str;

  /* /wizards/.. */
  owner = lower_case(caller->query_name());
  if (sscanf(str, "/wizards/%s/", who) == 1 && owner == who)
    return str;
  if (sscanf(str, "/wizards/%s/%s", who, file) == 2) {
    ob = clone_object("obj/player.lpc");
    if (!ob->restore_player(who) && Wiza >= 3 || Wiza >= 3 && ob->query_wiz() < 5 || who == owner)
      return str;
    destruct(ob);
    return 0;
  }

  
  if(Wiza == 1) return 0;

  if (sscanf(str, "/world/%s", file) == 1) {
    if(sscanf(file, "out/%s", file) == 1 && Wiza < 3)
      return 0;
    return str;
  }
  if (sscanf(str, "/doc/%s", file) == 1)
    return str;

  if(Wiza == 2) return 0;

  if (sscanf(str, "/guilds/%s", file) == 1)
    return str;
  if (sscanf(str, "/cmds/std/%s", file) == 1)
    return str;
  if (sscanf(str, "/room/houses/%s", file) == 1)
    return str;

  if(Wiza == 3) return 0;

  if (sscanf(str, "/cmds/%s", file) == 1)
    return str;
  if (sscanf(str, "/daemons/%s", file) == 1)
    return str;
  if (sscanf(str, "/data/%s", file) == 1)
    return str;
  if (sscanf(str, "/log/%s", file) == 1)
    return str;

    if (sscanf(str, "/stronghold/%s", file) == 1)
      return str;
    if (sscanf(str, "/castle/%s", file) == 1)
      return str;
    if (sscanf(str, "/obj/%s", file) == 1)
      return str;
    if (sscanf(str, "/room/%s", file) == 1)
      return str;
    if (sscanf(str, "/hakemukset/%s", file) == 1)
      return str;

  if(Wiza != 5) return 0;
  return str;
}   


mixed valid_read(string path, object caller) {
  string who, file, tmp1, str, current_path;
  int i, Wiza;
  object ob;

  if(caller) {
    Wiza = caller->query_wiz();
    current_path = caller->query_current_path();
  }
  i = strlen(path) - 1;
  while(i>0) {
    if (path[i] == '.' && path[i-1] == '.') {
      write("Illegal to have '..' in path.\n");
      return 0;
    }
    i -= 1;
  }
  /* if you have write access, then you have read access too */
  file = valid_write(path, caller);
  if (file) return file;  

  str = path;
  switch(str) {
    case "/world/city/map":
    case "/world/city/map.house":
    case "/log/SHOUT":
    case "/log/INFO":
    case "/log/WIZINFO":
    case "/NEWS":
    case "/WIZNEWS":
    case "/WIZLOCKED":
    case "/WELCOME":
    case "/WELCOME2":
    case "/WELCOME3": return str;
  }
  if (str[0] != '/') {
    if (current_path && current_path != "/" && current_path != "")
      str = "/" + current_path + "/" + str;
    else   
      str = "/" + str;
  }
  /* start validate */
  ob = previous_object();
  if(ob && object_name(ob) == "/daemons/guildrank_d" && sscanf(str, "/guilds/%s", tmp1) == 1)
    return str;

  if (sscanf(str, "/banish/%s", tmp1) == 1)
    return str;
  if (sscanf(str, "/doc/%s", file) == 1)
    return str;
  if (sscanf(str, "/daemons/fortune/data/%s", file) == 1)
    return str;
  if (sscanf(str, "/room/ambush/monster_descs/%s", file) == 1)
    return str;
  if (sscanf(str, "/guilds/spell_descs/%s", file) == 1)
    return str;

  /* full read access */
  if (Wiza == 4 || Wiza == 5) { return str; }

  if(!Wiza) return 0;

  if(sscanf(str, "/%s/%s", who, file) != 2 && sscanf(str, "/%s", file) == 1)
    return str;

  if (sscanf(str, "/wizards/%s/%s", who, file) == 2) {
    ob = clone_object("obj/player.lpc");
    if (!ob->restore_player(who) || ob->query_wiz() <= Wiza+1)
      return str;
    destruct(ob);
    return 0;
  } else if (sscanf(str, "/wizards/%s", file) == 1) {
    return str;
  }
 
  if (sscanf(str, "/world/%s", file) == 1)
    return str;
  if (sscanf(str, "/log/%s", file) == 1) {
    if(lower_case(file) == file || Wiza >= 3)
      return str;
    return 0;
  }

  if(Wiza == 1) return 0;

  if (sscanf(str, "/data/%s", file) == 1)
    return str;
  if (sscanf(str, "/cmds/std/%s", file) == 1)
    return str;
  if (sscanf(str, "/cmds/wiz/%s", file) == 1)
    return str;
  if (sscanf(str, "/guilds/%s", file) == 1)
    return str;

  if(Wiza == 2) return 0;

  if (sscanf(str, "/cmds/%s", file) == 1)
    return str;
  if (sscanf(str, "/daemons/%s", file) == 1)
    return str;
  if (sscanf(str, "/castle/%s", file) == 1)
    return str;
  if (sscanf(str, "/room/%s", file) == 1)
    return str;

  if(Wiza == 3) return 0;
  /* t鋒鋘 ei kukaan p滗se ellei oo illegal wiz //Celtron */
  return 0;

  if (sscanf(str, "/obj/%s", file) == 1)
    return str;
  if (sscanf(str, "/players/%s", file) == 1)
    return str;
}

mixed read_bytes(string filename, mixed fromchar, mixed numchar) {
  if ( valid_read(filename, this_player()) ) {
    return efun::read_bytes(filename, fromchar, numchar);
  }
  return 0;
}

string create_wizard(string owner, string domain)
{
    mixed result;

    /* set_this_object() removed: not a FluffOS efun. Bare simul_efun
     * calls already execute with this_object()/current_object left as
     * the ORIGINAL caller (unlike LDMud, where a simul_efun is a real
     * object and this trick was needed to fake that). */
    result =
      (mixed)MASTER->master_create_wizard(owner, domain, previous_object());
    if (stringp(result)) return result;
    return 0;
}

varargs void log_file(string file, string str, int no_send_to_chan )
{
    string object_name;
    int *st;

    object_name = "/log/" + file;
    if ( sizeof(st = get_dir(object_name,2) ) && st[0] > MAX_LOG_SIZE) {
	catch(rename(object_name, object_name + ".old")); /* No panic if failure */
    }
    /* set_this_object() removed: not a FluffOS efun. Bare simul_efun
     * calls already execute with this_object()/current_object left as
     * the ORIGINAL caller (unlike LDMud, where a simul_efun is a real
     * object and this trick was needed to fake that). */
    write_file(object_name, str);
    /* say log msg on channel. goes through buffer so bugging channels don't crash the system // Celtron */
    if(no_send_to_chan) return;
    "/daemons/log_buffer_d"->add_buffer(object_name+"|"+str);
}

void localcmd() {
    /* query_actions() (LDMud: list every verb currently add_action()-ed
     * onto a player, for local-room command introspection) has no
     * FluffOS equivalent efun -- stubbed. */
    write("(command list introspection is not available under this driver)\n");
}
