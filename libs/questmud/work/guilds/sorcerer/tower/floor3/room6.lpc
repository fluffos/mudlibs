inherit "room/room";

mixed reset(mixed arg) {
 if(arg) return;
 set_light(3);
 short_desc = "Inside the Tower of Sorcery";
 long_desc = "Long desc.\n";
 add_exit("southwest", "/guilds/sorcerer/tower/floor3/room3.lpc");
 add_exit("south", "/guilds/sorcerer/tower/floor3/room4.lpc");
 add_exit("southeast","/guilds/sorcerer/tower/floor3/room5.lpc");
 add_exit("up", "/guilds/sorcerer/soul_enchanters.lpc");
}