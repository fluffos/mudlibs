inherit "room/room";

mixed reset(mixed arg) {
 if(arg) return;
 set_light(3);
 short_desc = "Inside the Tower of Sorcery";
 long_desc = "Long desc.\n";
 add_exit("north", "/guilds/sorcerer/tower/floor2/room5.lpc");
 add_exit("east", "/guilds/sorcerer/tower/floor2/room7.lpc");
 add_exit("southwest", "/guilds/sorcerer/tower/floor2/room11.lpc");
}