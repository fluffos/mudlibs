inherit "room/room";

mixed reset(mixed arg) {
 if(arg) return;
 set_light(3);
 short_desc = "Inside the Tower of Sorcery";
 long_desc = "Long desc.\n";
 add_exit("north", "/guilds/sorcerer/tower/floor2/room2.lpc");
 add_exit("west", "/guilds/sorcerer/second.lpc");
 add_exit("south", "/guilds/sorcerer/tower/floor2/room8.lpc");
}
