object user;
int type;

mixed start(mixed ob,mixed ty,mixed duration) {
  user = ob;
  type = ty;
  shadow(user,1);
  call_out("remove_see_invisible", duration);
}

mixed query_see_invisible() {
  return type;
}

mixed remove_see_invisible() {
  write("Your vision blurs and then turns back to normal.\n");
  destruct(this_object());
}

