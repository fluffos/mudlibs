object ob;

mixed start(mixed arg, mixed time) {
  ob = arg;
  if (ob->query_heavy_weight()) { return; }
/*  call_out("end",time); unlimited duration */
  return 1;
}

mixed id(mixed str) { return str == "teleport lock" || str == "beacon"; }

mixed short() {
  return "A magical beacon";
}

mixed long() {
  write("A magical beacon that has something to do with teleporting spells.\n");
}

mixed query_heavy_weight() {
 return 1;
}

mixed drop() {
  call_out("end", 0);
  return 0;
}

mixed get() {
  return 1;
}

mixed end() {
  write("Your teleport lock wears off.\n");
  destruct(this_object());
  return 1;
}
