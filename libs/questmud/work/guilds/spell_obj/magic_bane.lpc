object tp;
int time;

mixed id(mixed str) { return str == "magic_bane"; }

mixed start(object ob,int bonus) {
  tp = ob;
  time = 300;
  call_out("end_magicbane",time);
}

mixed end_magicbane() {
  if(tp) { tell_object(tp, "You feel like your magic powers are rising.\n"); }
  destruct(this_object());
}

mixed query_magic_bane() { return this_object(); }
