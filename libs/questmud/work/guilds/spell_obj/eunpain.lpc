object liv;
int type, gain, delay;

mixed start(mixed ob, mixed effect, mixed time) {
  liv = ob;
  gain = effect;
  delay = time;
  shadow(liv, 1);
  call_out("remove_eunpain", delay);
  update_hp();
}

mixed query_unpain() {
  return 1;
}
    
mixed remove_eunpain() {
  tell_object(liv,"You feel strangely exhausted.\n");
  destruct(this_object());
}

mixed death() {
  liv->death();
  destruct(this_object());
}

mixed update_hp() {
  liv->update_hp();
  liv->set_max_ep(liv->query_max_ep() + gain);
}
