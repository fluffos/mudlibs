object liv;
int type, gain, delay;

mixed start(mixed ob, mixed effect, mixed time) {
  liv = ob;
  gain = effect;
  delay = time;
  shadow(liv, 1);
  call_out("remove_spregen", delay);
}

mixed query_regeneration() {
  return 1;
}
    
mixed remove_spregen() {
  tell_object(liv,"Your unnatural mana regeneration stops.\n"); 
  destruct(this_object());
}

mixed death() {
  liv->death();
  destruct(this_object());
}

mixed shadow_heart_beat() {
  liv->add_sp(gain);
}
