object player;
int time,extra;

mixed start(object ob,int bonus) {
  player = ob;
  time = bonus;
  extra = bonus/25;
  call_out("end_anticounter",time);
  tell_object(player, "You are surrounded by anti countering field.\n");
  shadow(player, 1);
}

mixed end_anticounter() {
  tell_object(player,"The anti counter field around you fades away.\n");
  destruct(this_object());
}

mixed query_anticounter() { return 1; }

mixed query_anticounter_bonus() { return extra; }
