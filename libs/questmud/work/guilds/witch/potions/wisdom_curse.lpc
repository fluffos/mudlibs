#include "/guilds/witch/effects.lpc"
object tp;
int bonus;
mixed start(int bon, object ob) {
tp = ob;
bonus = bon;
if(tp->query_curse()) {
        tell_object(tp, "Nothing happens.\n");
        destruct(this_object());
        return 1;
        }
shadow(tp,1);
update_stats();
tell_object(tp, "You feel cursed.\n");
call_out("end_wis_curse", (bon*2)+random(180));
return 1;
}

mixed query_curse() { return this_object(); }

mixed end_wis_curse() {
        tell_object(tp, "You feel your curse leaving from your body.\n");
        destruct(this_object());
        return 1;
}

mixed update_stats() {
        tp->update_stats();
        tp->set_wis(tp->query_wis()/2);
}
