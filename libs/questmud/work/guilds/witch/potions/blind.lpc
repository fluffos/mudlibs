int time;
object tp;

mixed reset(mixed arg) {
  if(arg) { return; }
}

mixed start(int dama, object ob) {
  time = dama*3;
  tp = ob;
  if(present("blind_curse", tp)) {
          destruct(this_object()); return 1; }
  call_out("end_blind_curse", time);
  this_object()->move_object(tp);
  tell_object(tp, "You are blinded.\n");
  return 1;
}
mixed init() {
add_action("cursed", "ll");
add_action("cursed", "look");
}
mixed cursed() {
write("You are blind and unable to see anything.\n");
return 1;
}

mixed id(mixed str) { return str == "blind_curse"; }
mixed drop() { return 1; }
mixed get() { return 0; }

mixed end_blind_curse() {
        tell_object(tp, "Finally you can see again.\n");
        destruct(this_object());
return 1;
}
