#define maxblood 100
inherit "/guilds/witch/obj/herb_algorithm.lpc";
int blood,i,effect;
string owner,size;
object vial,*ob, tmp1,tmp2,cauldron;

mixed set_owner(object ob,int bonus) {
 owner = ob;
 blood = 0;
 if(bonus < 33) { size = "small"; } else if(bonus > 66) { size = "large"; }
 else { size = "average"; }
}
mixed set_blood(int i) {
  blood = blood+i;
  if(blood > maxblood) blood = maxblood;
 }

mixed drain_blood() {
        blood -= 5;
        if(blood < 0)  blood = 0;
}
mixed short() {
  return owner+"'s "+size+ " magic cauldron";
}

mixed query_maxblood() { return maxblood; }

mixed long() {
  object ob;
  int i;
  write(short()+".\n");
  write("It contains "+blood+"% blood.\n");
  ob = all_inventory(this_object());
  while(i<sizeof(ob)) {
          if(ob[i]) write(ob[i]->short()+".\n");
          i += 1;
  }

}

mixed id(mixed str) { return str == "cauldron"; }


mixed reset(mixed arg) {
  if(arg) return;
  owner = "Neophyte";
  cauldron = this_object();
}

mixed get() {
        return 1;
}

string query_pot_owner() { return owner; }

mixed query_blood() { return blood; }

mixed add_weight(int i) {
  return 1;
}

mixed can_put_and_get() {
        if(owner != this_player()->query_name()) { return 0; }
        return 1;
}
mixed query_no_save() { return 1; }