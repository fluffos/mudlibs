#include "/guilds/witch/obj/herbs.lpc"
mixed reset(mixed arg) {
  if(arg) return;
  i = random(2)+1;
  set_desc();
}
mixed set_desc() {
	if(i == 1) { name = "pine"; s_desc = "A lump of pine needles"; l_desc = "A lump of pine needles\n"; }
	if(i == 2) { name = "dogwood"; s_desc = "A dogwood"; l_desc = "A dogwood\n"; }
}