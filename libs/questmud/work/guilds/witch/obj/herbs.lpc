string name, us_desc, ul_desc, s_desc, l_desc;
int quality, i;
int id;

mixed drop() { return 0; }
mixed get() { return 1; }
mixed query_weight() {  return quality*2; }
mixed query_herb() { return this_object(); }
mixed query_name() { return name; }
mixed id(mixed str) { return str == name || str == "herb"; }
mixed query_long() { if(!id) { return ul_desc; } else { return l_desc+"It is "+call_other("/guilds/witch/obj/potion_d", "get_quality", quality)+" quality\n."; } }
mixed short() { if(!id) { return us_desc; } else { return s_desc; } }
mixed long() { if(!id)  { write(ul_desc+"\n"); } else { write(l_desc+"It is "+call_other("/guilds/witch/obj/potion_d", "get_quality", quality)+" quality.\n"); } }

mixed set_quality(int x) {
	quality = x;
	if(quality > 100)quality = 100;
	if(this_player()->query_skills("identify herb") < random(quality)) {
		us_desc = "A strange looking herb"; ul_desc = "A strange looking herb.\nMaybe you should identify it."; id = 0;
	return 1;
	}
	id = 1;
}
mixed query_quality() { return quality; }
mixed query_identify() { return id; }

mixed set_identify(int i) {
	id = 1;
}

mixed herbs() { return this_object(); }
mixed dest_me() { destruct(this_object()); }
