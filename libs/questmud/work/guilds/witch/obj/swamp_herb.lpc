#include "/guilds/witch/obj/herbs.lpc"
/* LDMud ran reset(0) when an object loaded; this driver only runs create().
 * call_other so the most-derived reset() runs (KB 06 section 7.177). */
/* Called before their definitions (LDMud allowed that). */
varargs mixed set_desc();

void create() {
    call_other(this_object(), "reset", 0);
}

mixed reset(mixed arg) {
  if(arg) return;
  i = random(2)+1;
  set_desc();
}
mixed set_desc() {
	if(i == 1) { name = "mud"; s_desc = "A pile of mud"; l_desc = "A pile of mud\n"; }
	if(i == 2) { name = "moss"; s_desc = "A lump of oak moss"; l_desc = "A lump of oak moss\n"; }
}