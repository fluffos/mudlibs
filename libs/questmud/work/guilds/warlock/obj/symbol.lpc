/* LDMud ran reset(0) when an object loaded; this driver only runs create().
 * call_other so the most-derived reset() runs (KB 06 section 7.177). */
void create() {
    call_other(this_object(), "reset", 0);
}

mixed reset(mixed arg) {
        if(arg) return;
}
mixed short() {
        return "A circle of chaos";
}
mixed id(mixed str) {
        return str == "circle" || str == "circle_of_chaos";
}

mixed long() {
write("Some one has carved on the floor a somekind of circle.\n");
}

mixed drop() {
return 1;
}

mixed get() {
return 0;
}

mixed start_symbol(int i) {
call_out("dest_me", i);
}

mixed dest_me() {
say("The circle fades away.\n");
destruct(this_object());
}
