object user;

mixed start(object ob, int power) {
  user = ob;
  shadow(user, 1);
  call_out("end_chaos_aura", power);
  tell_object(user, "You feel like that raw chaos flowing through your body!\n");
}

mixed end_chaos_aura() {
	if(user) {
	tell_object(user, "You are no longer surrouded by chaos aura.\n");
}
destruct(this_object());
}

mixed short() {
return user->short()+" <surrounded by chaos>";
}

mixed query_chaos_aura() { return 1; }

