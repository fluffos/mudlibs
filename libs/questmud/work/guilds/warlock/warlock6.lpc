inherit "guilds/guilds/guild";
inherit "room/room";
#define WARLOCK_D "/daemons/warlock_d"
mixed reset(mixed arg) {
  load_plaque();
  if(arg) return;
  short_desc = "The secret guild of warlocks";
  long_desc = "This is the secret guild of warlocks. DO NOT JOIN YET!.\n";

  add_exit("out","/guilds/warlock/cathedral/room8");
  set_not_out(1);
  set_light(3);
}

mixed guild_max_level() {
  return 20;
}

mixed guild_name() {
    return "Chaos masters";
}

mixed init() {
  ::init();
  guild_init();
}

mixed check_joining_rec() {
	if(this_player()->query_alignment() >=0) {
	write("We don't wan't you goodies here!\n");
	return 0;
    }
    if(this_player()->query_guild_level("Master warlocks") != 20) {
	write("You need to max out the 'Master warlocks' guild first.\n");
	return 0;
}
    return 1;
}

mixed check_advance_rec(mixed lev) {
  mapping sk;
  sk = ([ ]);
  return sk;
}

mixed get_bonuses(mixed level) {
  return "str 1 , con 1 , ";
}
/*
tempt to evil
cast ritual of chaos

*/
mixed skill_list(int guild_level) {
  mapping skill;
  skill = ([ ]);
  skill += (["cast ritual of chaos":guild_level*5]); //100%
  skill += (["remove purity":guild_level*5]); //100%
  skill += (["knowledge of cleric":guild_level*5]); //100%
  skill += (["knowledge of fighter":guild_level*5]); //100%
  skill += (["knowledge of mage":guild_level*5]); //100%
  return skill;
}