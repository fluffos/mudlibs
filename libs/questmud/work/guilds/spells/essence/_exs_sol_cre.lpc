mixed resolve(mixed bonus, mixed target, mixed caster_ob) {
    if(!caster_ob)caster_ob=this_player();
    tell_object(caster_ob, "You create some food.\n");
    tell_room(environment(caster_ob), caster_ob->query_name()+" creates some food.\n", ({ caster_ob }));
    if (bonus > 200) {
	clone_object("/world/objects/ham")->move_object(caster_ob);
	return 1;
    }
    if (bonus > 100) {
	clone_object("/world/objects/bread")->move_object(caster_ob);
	return 1;
    }
    clone_object("/world/objects/cheese")->move_object(caster_ob);
}
