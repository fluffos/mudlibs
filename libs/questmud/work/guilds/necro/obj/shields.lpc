/* this is a special weapon for undead horde only ~/
/* it has no slot, no descs etc */
int wc, weight;

mixed query_type() {
  return "axe";
}
mixed query_wielded() {
  return 1;
}
mixed query_weight() {
  return weight;
}
mixed set_weight(int w) {
  weight = w;
}
mixed query_shield_factor() {
  return wc/10;
}
mixed set_wc(int i) {
  if(i>100) i = 100;
  wc = i;
}
mixed query_wc() {
  return wc;
}
