/* this is a special weapon for undead horde only ~/
/* it has no slot, no descs etc */
int wc, weight;

mixed query_damage(string str) {
  if(str == "slash") return 60;
  if(str == "bash") return 30;
  if(str == "pierce") return 10;
}

mixed query_name() {
  return "scythes";
}
mixed query_type() {
  return "axe";
}
mixed query_wielded() {
  return 1;
}
mixed query_weight() {
  return weight;
}
mixed set_weight(int w) {
  weight = w;
}
mixed set_wc(int i) {
  if(i>80) {
    i = 80;
    write("Scythes cannot be enchanted anymore.\n");
  }
  wc = i;
}
mixed query_wc() {
  return wc;
}
