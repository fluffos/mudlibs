mapping guilds, multiguilds, subguilds;
void reset(int arg);

/* create() runs synchronously right on load (unlike reset(), which on
 * this driver is scheduled-only unless "lazy resets" fires it on
 * first touch) -- same lazy-reset gap already found and fixed
 * elsewhere in this port. */
void create() {
  reset(0);
}

mapping query_guilds() {
  return guilds;
}

mapping query_multiguilds() {
  return multiguilds;
}

mapping query_subguilds() {
  return subguilds;
}

void reset(int arg) {
  /* LDMud wide/multi-value mapping literals have no FluffOS
   * equivalent -- packed into array values instead; every reader of
   * guilds/multiguilds elsewhere must index [key][N] rather than
   * [key,N]. */
  guilds = ([ "fighter": ({"Fighters","/guilds/fighter/fighter","/guilds/fighter/description",0,0}),
              "mage": ({"Apprentice Mages","/guilds/mage/apprmage","/guilds/mage/description",0,0}),
              "necromancer": ({"necromancers","/guilds/necro/base_guild","/guilds/necro/description",1000000,0}),
              "cleric": ({"Apprentice clerics","/guilds/channel/appr_cleric","/guilds/channel/description",0,0}),
              "psionic": ({"Psionicists","/guilds/psi/psiguild","/guilds/psi/description",0,0}),
              "warlock": ({"Warlocks","/guilds/warlock/warlock","/guilds/warlock/description",0,0}),
              "martial artist": ({"Martial artist","/guilds/artists/base_guild","/guilds/artists/description",0,0}),
           ]);

  multiguilds = ([
"battlemage": ({"mage","fighter"}),
"paladin": ({"fighter","cleric"}),
"abjurer": ({"mage","cleric"}),
 ]);

/*
  multiguilds = ([(string)
"battlemage":"mage";"fighter",
"chaos knight":"fighter";"necromancer",
"paladin":"fighter";"cleric",
"warlock":"necromancer";"mage",
"abjurer":"mage";"cleric",
 ]);

*/

  subguilds = ([
        "fighters" : "/guilds/fighter/fighter.lpc",
        "weaponmaster": "/guilds/fighter/weapon_master.lpc",
        "blademasters" : "/guilds/fighter/blades.lpc",
        "bludgeonists" : "/guilds/fighter/bludgeons.lpc",
        "barbarians" : "/guilds/fighter/barbarian.lpc",
        "warriors" : "/guilds/fighter/warrior.lpc",
        "veterans" : "/guilds/fighter/veterans.lpc",
        "body builders" : "/guilds/fighter/body_builders.lpc",
        "acrobats" : "/guilds/fighter/acrobats.lpc",
        "smith" : "/guilds/fighter/smith.lpc",
        "axers" : "/guilds/fighter/axes.lpc",
        "defenders" : "/guilds/fighter/defender.lpc",
        "berserkers" : "/guilds/fighter/berserker.lpc",
        "rangers" : "/guilds/fighter/ranger.lpc",
                
        "apprentice clerics":"/guilds/channel/appr_cleric.lpc",
        "adept clerics":"/guilds/channel/adept_cleric.lpc",
        "high clerics":"/guilds/channel/high_cleric.lpc",
                
        "abjurer" : "/guilds/abjurer/abjurers.lpc",
        "masters of sorcery": "/guilds/abjurer/masters_of_sorcery.lpc",
        "masters of abjuration": "/guilds/abjurer/masters_of_abjuration.lpc",
        "masters of vulnerability": "/guilds/abjurer/masters_of_vulnerability.lpc",
        
        "psionicists": "/guilds/psi/psiguild.lpc",
        "emphatics":"/guilds/psi/caster_psionicists.lpc",
        "telekinetics": "/guilds/psi/fighter_psionicists.lpc",
                
        "martial artist": "/guilds/artists/base_guild.lpc",
        "mind focusers": "/guilds/artists/mind_focusers.lpc",
        "body focusers": "/guilds/artists/body_focusers.lpc",
        "path of masters": "/guilds/artists/path_of_masters",
                
        "merchants": "/guilds/mage/merchant.lpc",
        "navigators": "/guilds/mage/navigator.lpc",
        "fire school": "/guilds/mage/fire_adept.lpc",
        "scroll scribblers" : "/guilds/mage/scroll_scribblers.lpc",
        "illusionists" : "/guilds/mage/illusionists.lpc",
        "advanced mages" : "/guilds/mage/adv_mages.lpc",
        "ice school" : "/guilds/mage/ice_adept.lpc",
        "master mages" : "/guilds/mage/master_mage.lpc",
        "apprentice mages" : "/guilds/mage/apprmage.lpc",
        "poison school" : "/guilds/mage/poison_adept.lpc",
        "arcaners" : "/guilds/mage/arcaners.lpc",
        "electricity school" : "/guilds/mage/electric_adept.lpc",
                
        "school of dark power" : "/guilds/necro/dark_power.lpc",
        "necromancers" : "/guilds/necro/base_guild.lpc",
        "master animators" : "/guilds/necro/animators.lpc",
        "apprentice controllers" : "/guilds/necro/control1.lpc",
        "adept controllers" : "/guilds/necro/control2.lpc",
        "unholy lords" : "/guilds/necro/unholy_lords.lpc",
        "necromancer adepts" : "/guilds/necro/necro.lpc",
                
        "warlocks" : "/guilds/warlock/warlock.lpc",
        "initiate of chaos" : "/guilds/warlock/warlock2.lpc",
        "master warlocks" : "/guilds/warlock/warlock3.lpc",
        "chaos fighters" : "/guilds/warlock/warlock4.lpc",
        "grand warlocks" : "/guilds/warlock/warlock5.lpc",
        "chaos masters" : "/guilds/warlock/warlock6.lpc",

        "paladin" : "/guilds/paladin/baseguild.lpc",
        "battlemage" : "/guilds/battlemage/baseguild.lpc",
          ]);
}


