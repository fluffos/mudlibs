object mina;

mixed start(mixed ob) {
  mina = ob;
  shadow(mina, 1);
  return 1;
}

mixed kill() { return use(); }

mixed cast() { return use(); }

mixed use() {
  tell_object(mina, "You are asleep and unable to do anything.\n");
  return 1;
}

mixed check_condis() {
  tell_object(mina, "You are asleep and unable to do anything.\n");
  return 0;
}

mixed move_player() {
  tell_object(mina, "You are asleep and unable to move.\n");
  return 1;
}

mixed restore_time_points() {
  tell_object(mina, "You are asleep and cannot fight!.\n");
  return 1;
}

mixed short() {
        return mina->short()+" (camping)";
}

mixed heraa() {
  destruct(this_object());
}
