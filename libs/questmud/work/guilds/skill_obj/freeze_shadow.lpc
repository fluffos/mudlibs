object corp;
mixed start(object ob, int time) {
	corp = ob;
	call_out("melt", time);
	shadow(corp, 1);
}
mixed decay() { return 1; }

mixed short(mixed arg) {
  return corp->short(arg) +" {frozen}";
}

mixed melt() {
	say("Ice melts away and corpse is ruined.\n");
	destruct(corp);
}

mixed query_freeze_shadow() {
  return this_object();
}
