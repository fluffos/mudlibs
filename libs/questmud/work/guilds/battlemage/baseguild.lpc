inherit "guilds/guilds/guild";
inherit "room/room";

mixed reset(mixed arg) {
  load_plaque();
  if(arg) return;
  set_short("The battlemage guild");
  set_long("The sanctum of the battlemagi.\n");
  set_not_out();
  set_light(3);

  add_exit("north","/guilds/mage/apprmage");
  property = ({"no_summon"});
}

mixed init() {
  ::init();
  guild_init();
}

mixed guild_max_level() {
  return 5;
}

mixed guild_name() {
    return "Battlemage";
}

mixed check_joining_rec() {
  return 1;
}

mixed check_advance_rec(mixed lev) {
  mapping sk;
  sk = ([ ]);
  return sk;
}

mixed get_bonuses(mixed level) {
  return "str 1 , con 2 , int 1 ,";
}

mixed skill_list(int guild_level) {
  int i;
  mapping skills;
  skills = ([ ]);

  if (guild_level >=1) {
    skills += (["battlecast": (int) guild_level*20]);
  }
  return skills;
}

