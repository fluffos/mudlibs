mixed start(int i) {
  set_light(3);
  call_out("time_out", i);
}

mixed short() { return "A orb of light"; }
mixed long() { write("A orb of light"); }
mixed query_long() { return "A orb of light"; }


mixed get() { return 0; }
mixed drop() { return 1; }

mixed id(mixed str) { if (str == "orb") { return 1; } }

mixed time_out(mixed i) {
	write("The orb vanishes\n");
	set_light(-3);
	destruct(this_object());
}

mixed query_no_save() { return 1; }