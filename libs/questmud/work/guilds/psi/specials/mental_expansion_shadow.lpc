object liv;
int type, gain, delay;

mixed start(mixed ob, mixed effect, mixed time) {
  liv = ob;
  gain = effect/3;
  delay = time;
  liv->update_stats();
  shadow(liv, 1);
  update_stats();
  call_out("remove_mentale", delay);
}

mixed query_mentale() { return this_object(); }


mixed remove_mentale() {
  tell_object(liv,"You have a strange feeling that your mental state just shrunk a bit.\n");
  liv->update_stats();
  destruct(this_object());
}

mixed update_stats() {
liv->update_stats();
   liv->set_max_ep(liv->query_max_ep() + gain);
}
