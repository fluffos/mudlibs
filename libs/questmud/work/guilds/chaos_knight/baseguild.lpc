inherit "guilds/guilds/guild";
inherit "room/room";

mixed reset(mixed arg) {
  load_plaque();
  if(arg) return;
  set_short("The chaos knight guild");
  set_long("The chaos knight guild is a place of darkness and power.\n");
  set_not_out();
  set_light(3);

  add_exit("south","/world/city/diaeme3");
  property = ({"no_summon"});
}

mixed init() {
  ::init();
  guild_init();
}

mixed guild_max_level() {
  return 1;
}

mixed guild_name() {
    return "Chaos knight";
}

mixed check_joining_rec() {
    return 1;
}

mixed check_advance_rec(mixed lev) {
  mapping sk;
  sk = ([ ]);
  sk += ([5:"call angel:20;"]);
  return sk;
}

mixed get_bonuses(mixed level) {
  return "str 2 , con 2 , wis 2 ,";
}

mixed skill_list(int guild_level) {
  int i;
  mapping skills;
  skills = ([ ]);

  if (guild_level >=4) {
    skills += (["do something": (int) 100]);
  }

  return skills;
}

