/* Scroll makers can only have max 10 scroll */

mapping makers;
/* LDMud ran reset(0) when an object loaded; this driver only runs create().
 * call_other so the most-derived reset() runs (KB 06 section 7.177). */
void create() {
    call_other(this_object(), "reset", 0);
}

mixed reset(mixed arg) {
	if(arg) return;
	makers = ([ ]);
}

mapping query_makers() {
	return makers;
}

mixed query_maker(string str) {
	return makers[str];
}

mixed add_maker(string str) {
	makers[str] += 1;
}

mixed reduce_maker(string str) {
	makers[str] -= 1;
}
