mapping question;

mixed input_data(string str) {
  if(!question) question = ([ ]);
  if(!str) return 0;
  question[m_sizeof(question)] = str;
  return 1;
}

mixed ask_questions(object ob) {
  if(!question || !m_sizeof(question)) return 0;
  tell_object(ob, question[random(m_sizeof(question))]+"\n");
  return 1;
}
