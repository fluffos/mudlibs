/* buffer for log msgs to be displayed at log chan //Celtron */
#define CHANNEL_D	"/daemons/channel_d"

nosave mapping messages;
nosave int e;

/* LDMud ran reset(0) when an object loaded; this driver only runs create().
 * call_other so the most-derived reset() runs (KB 06 section 7.177). */
void create() {
    call_other(this_object(), "reset", 0);
}

void reset(mixed arg) {
  if(arg) return;
  messages = ([ ]);
}

mixed query_messages() {
  return messages;
}

mixed add_buffer(string msg) {
  e += 1;
  messages += ([ e : msg ]);
  call_out("send_to_chan", 2, msg);
}

mixed send_to_chan(string msg) {
  CHANNEL_D->print_log(msg);
}
