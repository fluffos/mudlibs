mixed cmd_fleave(mixed obj) {
  object ob;
  ob = environment(this_player());
  if(!ob) {
    write("No environment found.\n");
    return 1;
  }
  if(!environment(ob)) {
    write("No destination.\n");
    return 1;
  }
  write("You leave "+ob->short()+".\n");
  this_player()->move_object(environment(ob));
  return 1;
}

