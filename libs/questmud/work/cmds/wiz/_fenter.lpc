mixed cmd_fenter(mixed obj) {
  object ob;
  if(!obj) {
    write("Usage: fenter <object>\n");
    return 1;
  }
  ob = present(obj,environment(this_player()));
  if(!ob) {
    write("No "+obj+" here.\n");
    return 1;
  }
  write("You enter "+obj+".\n");
  this_player()->move_object(ob);
  return 1;
}

