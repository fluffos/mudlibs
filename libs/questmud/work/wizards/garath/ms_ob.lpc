object p;
void start(object ob) {
  shadow(ob,1);
  p = ob;
}


mixed hit_with_spell(int dmg,string pref, mixed arg1,mixed arg2,mixed arg3) {
  p->set_sp( (p->query_sp()-dmg));
  if(p->query_sp() <= 0) {
    p->set_sp(0);
    tell_object(p,"The shield fades away.\n");
    destruct(this_object());
  }
}
