inherit "room/room";

mixed reset(mixed arg) {

        if(!present("lendor")) {
           clone_object("/wizards/jenny/gnael/mosut/lendor")->move_object(this_object());
        }
        if(!present("orc")) {
           clone_object("/wizards/jenny/gnael/mosut/meglah")->move_object(this_object());
        }
        if (!present("sign")) {
         clone_object("wizards/jenny/gnael/rojut/sign")->move_object(this_object());
        }

        if(arg) return;

        add_exit("east","out: 81 128");
        add_exit("west","/wizards/jenny/gnael/huoneet/city46.lpc");

  short_desc = "Eastern gate";
  long_desc = "There is a huge gate in front of you,\n"+
              "people are coming and going from it\n"+
              "all the time. A small sign is on the\n"+
              "ground and some torches are burning near\n"+
              "the gate. Behind the gate lies the\n"+
              "large city of Gnael. You see only rich\n"+
              "people inside and all the houses seem to be\n"+
              "very expensively made.\n";
        }
