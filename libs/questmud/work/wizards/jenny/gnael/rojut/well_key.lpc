inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A small gold key"; }

mixed long() { write("A small golden key, with the text 'well' is engraved on it\n"); }

mixed reset() {
  set_door_file("/wizards/jenny/gnael/huoneet/well7.lpc");

  set_key_code("803");
}

mixed get() { return 1; }

mixed query_weight() { return 20; }
