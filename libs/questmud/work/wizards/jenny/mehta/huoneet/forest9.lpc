inherit "room/room";
object monster,monster2,monster3;

mixed reset(mixed arg) {

        if(!present("badger")) {
           clone_object("/wizards/jenny/mehta/mosut/badger.lpc")->move_object(this_object());
        }
        if(!present("bear")) {
           clone_object("/wizards/jenny/mehta/mosut/bear.lpc")->move_object(this_object());
        }
        if(!present("owl")) {
           clone_object("/wizards/jenny/mehta/mosut/owl.lpc")->move_object(this_object());
        }
        if(arg) return;
 
        add_exit("northwest","/wizards/jenny/mehta/huoneet/forest6.lpc");
        add_exit("northeast","/wizards/jenny/mehta/huoneet/forest8.lpc");
        add_exit("southeast","/wizards/jenny/mehta/huoneet/forest10.lpc");

  short_desc = "In a peaceful forest";
  long_desc = "There are insects flying and crawling all around you,\n"+
              "also, you can see lots of trees and bushes near you.\n"+
              "forest looks very calm and peaceful, a small gust of\n"+
              "wind is blowing your hair nicely. A small path is\n"+
              "leading to several directions from here.\n";

 
        items = allocate(4);
        items[0] = "bushes";
        items[1] = "Some branches have been torn, you see something behind the bushes";
        items[2] = "trees";
        items[3] = "Some maple and oak trees are standing near the path";
}


mixed init() {
  ::init(); 
  add_action("enter", "enter"); 
}

mixed enter(mixed str) {
  if(str == "bushes") {
    write("You tear your way through the bushes\n"); 
    say(this_player()->query_name()+" vanished behind the bushes.\n");
    this_player()->move_object("/wizards/jenny/mehta/huoneet/luola1.lpc");
    command("look",this_player());
     }
     return 1;
 }
