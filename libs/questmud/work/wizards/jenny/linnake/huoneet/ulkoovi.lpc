inherit "room/room";
inherit "room/door";
mixed reset(mixed arg) {
object monster;
        if(!present("knight")) {
            clone_object("/wizards/jenny/linnake/mosut/knight.lpc")->move_object(this_object());
        }
        if(arg) return;

        add_exit("east","/wizards/jenny/linnake/huoneet/piha8.lpc");

        short_desc = "You are outside the castle";
        long_desc = "You are walking outside the castle, there are trees around you\n"+
                    "and it looks like knights are using this place as their training\n"+
                    "zone. There are also some odd looking bushes nearby, who knows what\n"+
                    "there might be.\n";

        door_reset();
        set_door_label("Small wooden door",1);
        set_door_dir("west", "/wizards/jenny/linnake/huoneet/sisaovi.lpc",1);
        set_door_link("/wizards/jenny/linnake/huoneet/sisaovi.lpc",1);
        set_door_code("471", 1);
        set_locked(1, 1);

}

mixed init() {
  ::init();
  door_init();
}
