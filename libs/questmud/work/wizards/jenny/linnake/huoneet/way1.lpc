inherit "room/room";
object guard;

mixed reset(mixed arg) {
   
    if(!present("guard")) {
      clone_object("/wizards/jenny/linnake/mosut/bodyguard.lpc")->move_object(this_object());
        }

        add_exit("north","/wizards/jenny/linnake/huoneet/way2.lpc");
        add_exit("south","/wizards/jenny/linnake/huoneet/ylakerta1.lpc");

        short_desc = "Entrance to the throne room";
        long_desc = "You are walking at the entrance of the throne room.\n"+
                    "There are huge statues everywhere around you and\n"+
                    "red carpet is laying on the floor.\n"; 

        set_not_out();
}
