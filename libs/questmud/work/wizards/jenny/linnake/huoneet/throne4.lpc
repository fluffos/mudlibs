inherit "room/room";
object guard;

mixed reset(mixed arg) {
   
    if(!present("guard")) {
      clone_object("/wizards/jenny/linnake/mosut/bodyguard.lpc")->move_object(this_object());
        }

        add_exit("west","/wizards/jenny/linnake/huoneet/throne5.lpc");
        add_exit("southwest","/wizards/jenny/linnake/huoneet/throne2.lpc");
        add_exit("south","/wizards/jenny/linnake/huoneet/throne3.lpc");

        short_desc = "The throne room";
        long_desc = "Large, clean, expensively decorated room where\n"+
                    "king and queen usually give orders. There are\n"+
                    "loads of people running in and out all the time.\n"; 

        set_not_out();
}
