#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object monster;
mixed extra_reset() {
        if(!monster) {
           monster = clone_object("wizards/jenny/linnake/mosut/knight.lpc");
           monster->move_object(this_object());
        }
}

FIVE_EXIT("/wizards/jenny/linnake/huoneet/piha21.lpc", "west",
           "/wizards/jenny/linnake/huoneet/piha23.lpc", "east",
           "/wizards/jenny/linnake/huoneet/piha19.lpc", "southeast",
           "/wizards/jenny/linnake/huoneet/piha18.lpc", "south",
           "/wizards/jenny/linnake/huoneet/piha17.lpc", "southwest",
           "You are outside the castle",
           "You are walking outside the castle, there are trees around you\n" +
           "and it looks like knights are using this place as their training\n" +
           "zone. There are also some odd looking bushes nearby, who knows what\n" +
           "there might be.\n", 1)
