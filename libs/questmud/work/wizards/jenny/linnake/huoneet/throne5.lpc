inherit "room/room";
object monster,monster2;

mixed reset(mixed arg) {
   if(arg) return;
   
       if (!monster) {
                monster = clone_object("/wizards/jenny/linnake/mosut/poika_august.lpc");
                monster->move_object(this_object());
        }
       if (!monster2) {
                monster2 = clone_object("/wizards/jenny/linnake/mosut/queen.lpc");
                monster2->move_object(this_object());
        }


        add_exit("west","/wizards/jenny/linnake/huoneet/throne6.lpc");
        add_exit("east","/wizards/jenny/linnake/huoneet/throne4.lpc");
        add_exit("southeast","/wizards/jenny/linnake/huoneet/throne3.lpc");
        add_exit("south","/wizards/jenny/linnake/huoneet/throne2.lpc");
        add_exit("southwest","/wizards/jenny/linnake/huoneet/throne1.lpc");

  short_desc = "The throne room";
  long_desc = "When you look around you see 2 large thrones, the other one\n"+
              "belongs to queen and other belong to king. There is red carpet\n"+
              "on the floor and a huge curtain is on the wall. There are some\n"+
              "people coming and going all the time and you hear music coming\n"+
              "from somewhere.\n";

 
        items = allocate(2);
        items[0] = "curtain";
        items[1] = "Huge curtain is on the wall, maybe there is something behind it";
}
 

mixed init() {
  ::init(); 
  add_action("penetrate", "penetrate"); 
}

mixed penetrate(mixed str) {
  if(str == "curtain") {
    write("You penetrate yourself through the curtain!\n"); 
    say(this_player()->query_name()+" vanishes behing the curtain!\n");
    this_player()->move_object("/wizards/jenny/linnake/huoneet/treasure1.lpc");
    command("look",this_player());
     }
     return 1;
 }
