inherit "room/room";
object guard;

mixed reset(mixed arg) {
   
    if(!present("guard")) {
      clone_object("/wizards/jenny/linnake/mosut/hallguard.lpc")->move_object(this_object());
        }

        add_exit("north","/wizards/jenny/linnake/huoneet/kaytava3.lpc");
        add_exit("south","/wizards/jenny/linnake/huoneet/sisaovi.lpc");

        short_desc = "You are walking in a hallway";
        long_desc = "You are walking in a hallway and you see stairs leading\n"+
                    "up in north and a big clean looking hall in south.\n"+
                    "You hear some chambermaids giggling somewhere near.\n";

        set_not_out();
}
