           "/wizards/jenny/linnake/huoneet/piha19.lpc", "northwest",
           "/wizards/jenny/linnake/huoneet/piha20.lpc", "north",
           "/wizards/jenny/linnake/huoneet/piha26.lpc", "northeast",
           "/wizards/jenny/linnake/huoneet/piha27.lpc", "east",
           "/wizards/jenny/linnake/huoneet/piha28.lpc", "southeast",
           "/wizards/jenny/linnake/huoneet/piha12.lpc", "south",
           "/wizards/jenny/linnake/huoneet/piha11.lpc", "southwest",
           "You are outside the castle",
           "You are walking outside the castle, there are trees around you\n" +
           "and it looks like knights are using this place as their training\n" +
