inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "jeweled silver key"; }

mixed long() { write("Gorgeous looking jeweled silver key.\n"); }

mixed reset() {
  set_door_file("/wizards/jenny/linnake/huoneet/treasure2.lpc");

  set_key_code("371");
}

mixed get() { return 1; }

mixed query_weight() { return 20; }
