inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "Golden key labelled as 'prisonkey'"; }

mixed long() { write("The key is made of gold.\n"); }

mixed reset() {
  set_door_file("/wizards/jenny/linnake/huoneet/prison4.lpc");
  set_door_file("/wizards/jenny/linnake/huoneet/prison6.lpc");
  set_door_file("/wizards/jenny/linnake/huoneet/prison12.lpc");
  set_door_file("/wizards/jenny/linnake/huoneet/prison10.lpc");
  set_door_file("/wizards/jenny/linnake/huoneet/prison16.lpc");
  set_door_file("/wizards/jenny/linnake/huoneet/prison18.lpc");

  set_key_code("571");
}

mixed get() { return 1; }

mixed query_weight() { return 20; }
