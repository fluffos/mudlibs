inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "Rusty steel key"; }

mixed long() { write("Very rusty looking steel key.\n"); }

mixed reset() {
  set_door_file("/wizards/jenny/linnake/huoneet/ulkoovi.lpc");

  set_key_code("471");
}

mixed get() { return 1; }

mixed query_weight() { return 20; }
