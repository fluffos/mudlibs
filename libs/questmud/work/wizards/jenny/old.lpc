inherit "room/room";

mixed reset(int arg) {
  if(arg) return;
  add_exit("inn","/world/city/inn");
  add_exit("cs","/world/city/cs");
  add_exit("arrin","/wizards/nalle/workroom.lpc");
  short_desc = "Jenny's workroom";
  set_long("Jennyn oma l鋗min huane!\n");
  property = allocate(1);
  property[0] = "no_summon";
  set_light(3);
}
