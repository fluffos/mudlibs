mixed reset() {
  /* give the dirs, descs and other things as descibed in newroom.c */
  if(!present("bear")) {
    clone_object("/wizards/celtron/monster")->move_object(this_object());
  }
  if(!present("bear")) {
    clone_object("/wizards/celtron/monster")->move_object(this_object());
  }
  if(!present("bear")) {
    clone_object("/wizards/celtron/monster")->move_object(this_object());
  }
}

mixed init() {
  ::init();
  add_action("push", "push");
}

mixed push(mixed str) {
  if(str != "wall") return;
  write("You push the wall and it breaks.\n");
  say("The eastern wall collapses.\n");
  /* remove the east exit */
  remove_exit("east");
  return 1;
}
