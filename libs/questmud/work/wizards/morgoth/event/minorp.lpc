mixed id(mixed str) { return str=="potion"; }
 
mixed short() { return "A minor healing potion."; }
 
mixed long() {
 write("This is a minor healing potion. To use it, type 'quaff'.\n");
}
 
mixed query_value() { return 500; }
 
mixed get() { return 1; }
 
mixed init() {
 add_action("quaff","quaff");
}
 
mixed quaff() {
 write("You quaff a potion.\n");
 say(this_player()->query_name()+" quaffs a potion.\n");
 cure_light();
 write("Your potion vanishes.\n");
 destruct(this_object());
 return 1;
}
 
mixed cure_light() {
 object tar;
 int hp,max;
  tar = this_player();
  hp = call_other(tar,"query_hp");
  max = call_other(tar,"query_max_hp");
  if(hp<max) {
   call_other(tar,"set_hp", hp+500);
   hp = call_other(tar,"query_hp");
   max = call_other(tar,"query_max_hp");
   if(hp>max) call_other(tar,"set_hp",max);
   write("You feel little better!\n");
   say(this_player()->query_name()+" looks little better.\n");
   return 1;
  }
}
