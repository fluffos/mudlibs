object monsu;
 
mixed init() {
 add_action("start", "push");
}
 
mixed short() {
  return "tama on monsun cloonaus nappi. 'push button'";
}
 
mixed get() { return 1; }
 
mixed start(mixed str) {
  if(str != "button") return;
  if(monsu) {
    write("monsu elaa viela\n");
    return 1;
  }
  monsu = clone_object("/wizards/morgoth/can");
  monsu->move_object("/wizards/morgoth/workroom");
  shout("Town crier shouts: RAH! RAH! \n");
 
  monsu = clone_object("/wizards/morgoth/can");
  monsu->move_object("/wizards/morgoth/workroom");
 
  return 1;
}
