string name;
mixed reset(mixed arg) {
    if (arg) { return; }
  name = "dummy"; set_living_name(name); enable_commands();
}
mixed id(mixed str) {
    return str == name;
}
mixed query_name() { return name; }
mixed query_max_hp() { return 10000; }
mixed long() {
    write("This is a test dummy. It reports the damage 
done.\n");
}
mixed short() {
    return "A test dummy";
}'
mixed hit_player(mixed dam, mixed dam_type) {
  int d,da;
  if (dam) {
    if (dam_type == 0) { dam_type = 1; }
    d = dam;
    da = dam_type;
    say("Dummy says: 'OUCH! That did " + d + " points of " + 
da + " damage.'\n");
    return d;
  }
}
mixed hit_with_spell(mixed dam, mixed dam_type) {
  int d,da;
  if (dam) {
    if (dam_type == 0) { dam_type = 1; }
    d = dam;
    da = dam_type;
    say("Dummy says: 'OUCH! That did " + d + " points of " + 
da + " damage.'\n");
    return d;
  }
}
mixed query_attack() { return this_player(); }
