#include "room.h"
 
#undef EXTRA_RESET
#define EXTRA_RESET\
    extra_reset();
 
object monsu;
int bucket_found;
 
mixed extra_reset() {
    if (!monsu) {
        monsu = clone_object("/wizards/morgoth/cannibal/npc/cook.lpc");
        monsu->move_object(this_object());
    }
}
 
ONE_EXIT("/wizards/morgoth/cannibal/room/path57.lpc", "out",
         "Cooking place.",
         "Cooking place.\n" +
         "This is cooking place, there is a HUGE pile of bones.\n", 3)
