#include "room.h"
 
#undef EXTRA_RESET
#define EXTRA_RESET\
    extra_reset();
 
object monsu;
int bucket_found;
 
mixed extra_reset() {
    if (!monsu) {
        monsu = clone_object("/wizards/morgoth/cannibal/npc/king.lpc");
        monsu->move_object(this_object());
    }
}
 
ONE_EXIT("/wizards/morgoth/cannibal/room/path10.lpc", "out",
         "Kings hut.",
         "This is kings hut.\n" +
         "This place is decorated with human skulls.\n", 3)
