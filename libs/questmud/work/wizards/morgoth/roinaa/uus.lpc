object ob;

mixed reset(mixed arg) {
  if(arg) return;
  ob = find_player("morgoth");
  if(!ob || ob->query_wizuvarjo()) return;
  shadow(ob, 1);
  tell_object(ob, "wiz shadow start\n");
}

mixed short() {
  return "M O R G O T H";
}

mixed idle() {
  return 60*6+6;
}

mixed query_best_kills() {
  write("Best kills: "+this_player()->short()+": 1 exp (solo)\n");
  write("            "+this_player()->short()+"'s friend: 5000000 exp (party of 3)\n");
}

mixed show_age() {
  write("Age: 666d 6h 6m 6s\n");
}
mixed query_wizuvarjo() { return 1; }

mixed remove_wizuvarjo() { destruct(this_object()); }

 mixed query_plan() {
  if(this_player()->query_hp() <= 10) return 0;
  /* this_player()->reduce_hp(10); */  
 return "piip!\n";

}  
