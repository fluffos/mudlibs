mixed short() { return "Sword of DESTRUCTION"; }

mixed long(mixed str) {
    write("This sword is for immortals only.\n");
    return;
}

mixed id(mixed str) { return str == "sword"; }

mixed get(mixed str) {
    if (str == "sword") {
        write("ZAP!\n");
        this_player()->reduce_hp(100);
    
    }
    return 0;
}

