mixed reset(mixed arg) {
  if(arg) return;
}

mixed init() {
  add_action("west", "w");
  add_action("east", "e");
  add_action("north", "n");
  add_action("south", "s");
  add_action("look", "l");
  add_action("fin", "fin");
  add_action("mud", "mud");
  add_action("score", "score");
}

mixed west() {
  write("Don't do that!\n");
}

mixed east() {
  write("East is no good!\n");
}

mixed north() {
  write("Are you crazy?\n");
}

mixed south() {
  write("You can't do that!\n");
}

mixed look() {
  write("You can see FLOWERS!\n");
}

mixed fin() {
  write("Speak english dummy!\n");
}

mixed mud() {
  write("MUD, MUD AND MUD, can't you think anything else?\n");
}

mixed score() {
  write("Stats: 0 0 0 0 0 0 0 0, Scary? Isn't it...\n");
}

mixed short() {
  return "Kapula";
 }


mixed id(mixed str) {
  return str == "kapula";
 }

mixed long() {
  write("This is the kapula.\n");
}


mixed drop() {
  return 0;
}


mixed get() {
  return 1;
}


mixed query_weight() {
  return 1;
}
