inherit "room/room";
inherit "room/door";

 mixed reset(mixed arg) 
   {
        add_exit("northeast", "hallway9.lpc");        
        add_exit("southwest", "hallway11.lpc");

   short_desc = "Descii uupuu.\n";
   long_desc = ("Desci uupuu.\n"+
               "Keksitaan jotain joskus, teen vaan pohjan mallin valmiiks.\n");  
 set_light(2);
 
 door_reset();
set_door_label("wooden door",1);
set_door_dir("southeast", "koppi6.lpc",1);
set_door_link("/wizards/nipa/areat/torni/huoneet/koppi6.lpc",1);
set_locked(0, 1);

 set_not_out();
}
            
 mixed init() {
     ::init();
     door_init();
}
