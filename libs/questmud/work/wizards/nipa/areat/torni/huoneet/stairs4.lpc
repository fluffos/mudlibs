inherit "room/room";
object hefa;

mixed reset(mixed arg) {
  if(arg) return;
   
   if(!hefa) {
      hefa = clone_object("/wizards/nipa/areat/torni/mosat/hefasto.lpc");
      hefa->move_object(this_object()); }

    add_exit("down","stairs3.lpc");

   short_desc = "Huipulla tuulee, terv. Hugo";
    long_desc = "Huimaa näin korkealla.\n";
               
        set_light(3);
}
