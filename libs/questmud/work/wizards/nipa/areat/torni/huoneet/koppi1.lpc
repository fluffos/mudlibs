inherit "room/room";
inherit "room/door";
object monster;

mixed reset(mixed arg) {
int i;
i = random(2);

 if(!monster && i==1) {
  monster = clone_object("/wizards/nipa/areat/torni/mosat/adeptapp.lpc");
  monster->move_object(this_object());
  }

if(arg) return;

   short_desc = "A small cosy looking apartment.";
   long_desc = "A small apartment room with many books and scrolls around.\n"+
               "It seems this room belongs to an apprentice mage and it is lived. \n"; 

set_light(2);

door_reset();
   set_door_label("wooden door",1);
   set_door_dir("northeast", "hallway2.lpc",1);
   set_door_link("/wizards/nipa/areat/torni/huoneet/hallway2.lpc",1);
   set_locked(0, 1);

set_not_out();
}

mixed init() {
  ::init();
  door_init();
}
