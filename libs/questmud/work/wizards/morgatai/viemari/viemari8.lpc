inherit "room/room";

mixed reset(mixed arg) {
   if(arg) return;
   add_exit("north","/wizards/morgatai/viemari/viemari14.lpc");
   add_exit("east","/wizards/morgatai/viemari/viemari17.lpc");
   add_exit("south","/wizards/morgatai/viemari/viemari21.lpc");
   short_desc = "Perkeleellinen Viem鋜i";
   long_desc = "T鋗on viem鋜i.\n";
   set_light(1);
}
