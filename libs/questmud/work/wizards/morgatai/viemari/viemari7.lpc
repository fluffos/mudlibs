inherit "room/room";

mixed reset(mixed arg) {
   if(arg) return;
   add_exit("west","/wizards/morgatai/viemari/viemari25.lpc");
   add_exit("north","/wizards/morgatai/viemari/viemari22.lpc");
   add_exit("east","/wizards/morgatai/viemari/viemari26.lpc");
   short_desc = "Perkeleellinen Viem鋜i";
   long_desc = "T鋗on viem鋜i.\n";
   set_light(1);
}
