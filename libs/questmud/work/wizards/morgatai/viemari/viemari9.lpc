inherit "room/room";

mixed reset(mixed arg) {
   if(arg) return;
   add_exit("north","/wizards/morgatai/viemari/viemari16.lpc");
   add_exit("west","/wizards/morgatai/viemari/viemari20.lpc");
   add_exit("south","/wizards/morgatai/viemari/viemari23.lpc");
   short_desc = "Perkeleellinen Viem鋜i";
   long_desc = "T鋗on viem鋜i.\n";
   set_light(1);
}
