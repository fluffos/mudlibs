inherit "room/room";
object mob, mob1, mob2, mob3;
mixed reset(mixed arg) {
  /* Applying mobs */
  if(!mob) {
    mob = clone_object("/wizards/gynter/darke/mobs/rat");
    mob->move_object(this_object());
  }
  if (!mob1) {
    mob1 = clone_object("/wizards/gynter/darke/mobs/rat");
    mob1->move_object(this_object());
  }
  if(!mob2 && !random(5)) {
    mob2 = clone_object("/wizards/gynter/darke/mobs/rat");
    mob2->move_object(this_object());
  }
  if (!mob3 && !random(5)) {
    mob3 = clone_object("/wizards/gynter/darke/mobs/rat");
    mob3->move_object(this_object());
  }
  if(arg) return;
  /* Assigning exits */
  add_exit("south","/wizards/gynter/darke/city/Scity6");
  add_exit("east","/wizards/gynter/darke/city/Scity4");
  add_exit("west","/wizards/gynter/darke/city/Scity2");
  add_exit("north","/wizards/gynter/darke/city/Scity1");
  add_exit("southwest","/wizards/gynter/darke/city/Scity5");
  add_exit("southeast","/wizards/gynter/darke/city/Scity7");
  /* setting desc */
  short_desc = "The Slum";
  long_desc = "The slums of men cannot in any way compare to the\n"+
              "stench in this place. It smells like all the cemetaries\n"+
              "in the world has dumped their holdings here.\n";
}
