inherit "room/room";
object mob, mob1, mob2, mob3;

mixed reset(mixed arg) {
  /* Applying mobs */
  if(!mob) {
    mob = clone_object("/wizards/gynter/darke/mobs/");
    mob->move_object(this_object());
  }
  if (!mob1) {
    mob1 = clone_object("/wizards/gynter/darke/mobs/");
    mob1->move_object(this_object());
  }
  if(!mob2) {
    mob2 = clone_object("/wizards/gynter/darke/mobs/");
    mob2->move_object(this_object());
  }
  if (!mob3) {
    mob3 = clone_object("/wizards/gynter/darke/mobs/");
    mob3->move_object(this_object());
  }
  if(arg) return;
  /* Assigning exits */
  add_exit("","/wizards/gynter/darke/city/");
  add_exit("","/wizards/gynter/darke/city/");
  add_exit("","/wizards/gynter/darke/city/");
  add_exit("","/wizards/gynter/darke/city/");
  /* setting desc */
  short_desc = "";
  long_desc = "\n"+
              "\n"+
              "\n"+
              "\n";
}
