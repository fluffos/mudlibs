inherit "room/room";
object demon, demon1, demon2;

mixed reset(mixed arg) {
  /* Applying mobs */
  if(!demon) {
    demon = clone_object("/wizards/gynter/area2/city2/mobs/3priest");
    demon->move_object(this_object());
  }
  if(!demon1) {
    demon1 = clone_object("/wizards/gynter/area2/city2/mobs/3priest");
    demon1->move_object(this_object());
  }
  if(!demon2) {
    demon2 = clone_object("/wizards/gynter/area2/city2/mobs/3priest");
    demon2->move_object(this_object());
  }
  if(arg) return;
  /* Assigning exits */
  add_exit("east","/wizards/gynter/area2/city2/temple9");
  add_exit("south","/wizards/gynter/area2/city2/templee");
  /* setting desc */
  short_desc = "3:rd circle walk";
  long_desc = "Now the walls are showing the thought of long since gone warriors\n"+
              "and archmage's. And strangely one of the things repeating themself are war!\n";
}
