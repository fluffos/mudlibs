inherit "room/room";

mixed reset(mixed arg) {
  /* Assigning exits */
  add_exit("west","/wizards/gynter/element/fire/1");
  add_exit("east","/wizards/gynter/element/fire/3");
  /* setting desc */
  short_desc = "A small corridor";
  long_desc = "You are standing in a small corridor.\n"+
              "There is almost no room to walk without touching\n"+
              "the flames in the walls.\n";
}
