mixed reset(mixed arg) {
  if(arg) return;
}

mixed id(mixed str) {
  return str == "sapphire";
}
mixed short() {
  return "A large almost trasparent sapphire";
}
mixed long() {
  write("This sapphire is almost transparent. It has been created\n"+
        "by the elementallord of the airrealm. And as such it is very special.\n");
}
mixed query_weight() {
  return  1;
}
mixed get() {
  return 1;
}
