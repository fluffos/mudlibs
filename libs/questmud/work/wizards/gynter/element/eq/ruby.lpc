mixed reset(mixed arg) {
  if(arg) return;
}

mixed id(mixed str) {
  return str == "ruby";
}
mixed short() {
  return "A fire-red ruby";
}
mixed long() {
  write("This is a red ruby large as a fist. It has a small light\n"+
        "inside of it. Almost as if there is a flame inside.\n");
}
mixed query_weight() {
  return  1;
}
mixed get() {
  return 1;
}
