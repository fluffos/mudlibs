inherit "obj/monster";
#define OWNER "Gynter"

mixed reset(mixed arg) {
    object armour;
    ::reset(arg);
    if(arg) { return; }
    set_level(100);
    set_name("slave");
    set_alias("gynter");
    set_short("A slave is here to follow "+OWNER);
    set_long("A slave, you don't need to know more than that.\n");
    set_al(0);
    set_exp(0);
    set_aggressive(0);
}

mixed heart_beat() {
object ob; 
ob = find_player(lower_case(OWNER));

if(ob) {
  if(environment(ob) != environment(this_object())) {
    tell_room(environment(this_object()), "Slave follows "+OWNER+".\n");
    this_object()->move_object(environment(ob));
    tell_room(environment(this_object()),"Slave walks in after "+OWNER+".\n");
  }
}
}

mixed hit_player(int i) {
i = 0;
return ::hit_player(i);
}

void catch_tell(string str) {
  string tmp, command, omistaja;
  string comm;
  if(sscanf(str,"%s says 'Slave, %s'", omistaja, command) != 2) return;
  if(omistaja != OWNER) return;

  if(sscanf(command,"%s %s",comm, tmp)) {
    if(present(tmp,environment(this_object())))
      say(query_name()+" "+comm+" "+capitalize(tmp)+".\n");
    return;
  }
}
