inherit "obj/monster";
 
mixed reset(mixed arg) {
    ::reset(arg);
    if(arg) { return; }
    set_level(100);
    set_name("cow");
    set_short("A scottish cow playing the bag pipes ");
    set_long(   "牋牋牋牋牋牋\\ (__)\n"+
		"牋牋牋牋牋牋\\\\(oo)\n"+
		"牋牋牋牋 /-----\\\\\\/\n"+
		"牋牋牋/ |牋(##)\n"+
		"牋牋牋 *||----||\n"+
		"          ^^    ^^\n");
    set_animal(1);
    set_al(0);
    set_log();
    set_aggressive(0);   
}