mixed short() { return "Strong-looking wooden ladders"; }

mixed long(mixed str) {
    write("These ladders have survived the test\n"+
        "of time. Somehow the termites and mould\n"+
        "have avoided these ladders. The ladders\n"+
        "seem long enough to even climb to the\n"+
        "bell tower.\n");
    return;
}

mixed id(mixed str) { return str == "ladders"; }

mixed get() {
    return 1;
}

mixed query_weight() {
  return 1500;
}
