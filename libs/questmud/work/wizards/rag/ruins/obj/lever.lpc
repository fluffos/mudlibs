mixed short() { return "A rusty old lever"; }

mixed long(mixed str) {
    write("This is a rusty old lever. It is stuck in a big pile of\n"+
          "dust. You can't see where the lever ends but you might\n"+
          "be able to pull it.\n");
    return;
}

mixed id(mixed str) { return str == "lever"; }

mixed get() {
    return 0;
}

mixed query_weight() {
  return 100;
}
