inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A bronze key"; }

mixed long() { write("The key is made of bronze.\n"); }

mixed reset() {
  set_door_file("/wizards/rag/elf/w_a1");
  set_key_code("817");
}

mixed get() { return 1; }

mixed query_weight() { return 20; }
