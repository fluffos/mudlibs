mixed short() { return "A sign is leaning against the hillside"; }

mixed long(mixed str) {
    write("/-----+-----\\\n"+
          "|           |\n"+
          "|  O R C S  |\n"+
          "| yu no com |\n"+
          "|           |\n"
         "\\-----+-----/\n");
    return;
}

mixed id(mixed str) { return str == "sign"; }

mixed get(mixed str) {
    if (str == "sign") {
        write("You can't take the sign.\n");
        return 0;
    }
    return 0;
}
