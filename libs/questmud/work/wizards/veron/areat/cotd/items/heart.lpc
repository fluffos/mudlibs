mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "The pulsating heart of Mayor Justin";
}

mixed id(mixed str) {
  return str == "heart";
}

mixed realid(mixed str) {
  return str == "real";
}

mixed long() {
  write("The still-pulsating bloody heart of Justin, the mayor of Remick.\n" + 
        "The heart is still warm\n");
        
}

mixed get() {
  return 1;
}

mixed query_weight() {

  return 1;
}