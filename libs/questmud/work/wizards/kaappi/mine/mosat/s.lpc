mixed short() { return "A bloody skull"; }

mixed long(mixed str) {
 write("Seems that this skull once belonged to a humanoid creature. Maybe some\n" +
       "ferocious animal has been devouring the poor owner of this bloody skull.\n" +
       "All the flesh has been removed from the bony skull and only some stains\n" +
       "of blood colour the otherwise grayish skull.\n");
return; }

 mixed id(mixed str) { return str == "skull"; }

mixed get() {
 return 1;
}
