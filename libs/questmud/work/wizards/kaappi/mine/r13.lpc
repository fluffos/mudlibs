inherit "room/room";
object monster,monster2,monster3;
mixed reset(mixed arg) {

if(!monster) {
  monster = clone_object("/wizards/kaappi/mine/mosat/kaivurit.lpc");
  monster->move_object(this_object()); }

if(!monster2) {
  monster2 = clone_object("/wizards/kaappi/mine/mosat/kaivurit.lpc");
  monster2->move_object(this_object()); }

if(!monster3) {
  monster3 = clone_object("/wizards/kaappi/mine/mosat/kaivurit.lpc");
  monster3->move_object(this_object()); }

  if(arg) return;

   add_exit("south", "r11.lpc");
short_desc = "A tunnel";
long_desc = "Older parts of these tunnels. A thin layer\n"+ 
              "of dust covers the floor and a lot of footprints can be\n"+
              "seen. There are many dwarven miners running everywhere.\n";
  set_light(1);
}
