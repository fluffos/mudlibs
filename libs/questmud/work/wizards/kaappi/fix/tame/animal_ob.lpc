object tamer, animal, tamer_ob;

mixed start(mixed ob, mixed ani) {
        tamer = ob;
        animal = ani;
        tamer_ob = present("tamer_obj", tamer);
        shadow(animal, 1);
}

mixed add_exp(mixed arg) {
  if (arg < 0) { return; }
  tamer->add_exp(arg);
  return;
}
mixed death(mixed arg) {
 if(arg == !animal) {
call_other(tamer_ob, "animal_death");
animal->death();
}
}

mixed query_animal_ob() {
        return this_object();
}
