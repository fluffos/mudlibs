object nuuh, elain;

mixed id(mixed str) { return str == "probe_tame_ob"; }

mixed start(mixed ob, mixed ani) {
 nuuh = ob;
 elain = ani;
}

mixed init() {
    add_action("quit", "quit");
}

mixed quit() {
 write("You feel like your tamed animal is no longer under your control.\n"); 
 if (nuuh) { destruct(nuuh); }
 destruct(this_object());
}

mixed safe_quit() {
 if (nuuh) { destruct(nuuh); }
 if(elain) {
   tell_room(environment(elain), elain->short()+" leaves back into the wilderness.\n");
   elain->move_object("/world/special/dump");
   destruct(elain);
 }
 destruct(this_object());
}

mixed get() { return 1; }
mixed drop() { return 1; }
