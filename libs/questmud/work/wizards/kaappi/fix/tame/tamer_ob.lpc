object tmp;
mixed start(object ob) {
tmp = ob;
}

mixed id(mixed str) { return str == "tamer_obj"; }

mixed get() { return 1; }
mixed drop() { return 1; }
mixed move_test() {
        tmp->move_object(environment(this_player()));
        tell_room(environment(tmp), tmp->short()+" arrives from somewhere.\n");
        return 1;
}
