inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A small key"; }

mixed long() { write("A small key, with the text 'warehouse'\n"); }

mixed reset() {
  set_door_file("/wizards/kaappi/dcity/rooms/katu48.lpc");

  set_key_code("999");
}

mixed get() { return 1; }

mixed query_weight() { return 20; }
