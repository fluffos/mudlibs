inherit "room/room";
object mob,mob2;

mixed reset(mixed arg) {
  if(!mob) {
  mob = clone_object("/wizards/kaappi/dcity/mobs/jannut.lpc");
  mob->move_object(this_object()); }

  if(!mob2) {
  mob2 = clone_object("/wizards/kaappi/dcity/mobs/jannut.lpc");
  mob2->move_object(this_object()); }
{
  if(arg) return;

  add_exit("west", "katu6.lpc");
  add_exit("east", "katu8.lpc");
  add_exit("north", "katu13.lpc");

  short_desc = "The crossing";
  long_desc = ""
"-o---+---+#     You are standing at the crossing of Thrmo and Gimbar\n"+ 
" |   | H |#     street. Gimbar street continues far to the north and Thrmo\n"+   
"H4H  5H H|#     street continues to west and east. A lantern post is\n"+   
" |   | H |#     giving light here.\n"+   
"-+---*---+#\n"+  
"#E#########\n";

  set_light(2);
}
}
