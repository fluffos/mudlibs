inherit "room/room";
object mob,qmob;

mixed reset(mixed arg) {

if(!qmob) {
  qmob = clone_object("/wizards/kaappi/dcity/mobs/qlapsi.lpc");
  qmob->move_object(this_object()); }

if(!mob) {
  mob = clone_object("/wizards/kaappi/dcity/mobs/kids.lpc");
  mob->move_object(this_object()); }
  if(arg) return;

  add_exit("east", "park2.lpc");
  add_exit("northeast", "park5.lpc");
  add_exit("north", "park4.lpc");
short_desc = "A park";
long_desc = "The trees and bushes are growing straight from the rock.\n"+
            "A beautiful green grass covers the ground. Some most commonly\n"+
            "used paths can clearly be seen on the ground. You feel \n"+
            "relaxed as you walk in this park.\n";
  set_light(3);
}
