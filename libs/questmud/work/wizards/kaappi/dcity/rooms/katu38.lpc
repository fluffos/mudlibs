inherit "room/room";
object mob,mob2;

mixed reset(mixed arg) {
  if(!mob) {
  mob = clone_object("/wizards/kaappi/dcity/mobs/jannut.lpc");
  mob->move_object(this_object()); }

  if(!mob2) {
  mob2 = clone_object("/wizards/kaappi/dcity/mobs/jannut.lpc");
  mob2->move_object(this_object()); }
{
  if(arg) return;

  add_exit("south", "katu34.lpc");
  add_exit("north", "katu47.lpc");
  add_exit("west", "house12.lpc");
  
  short_desc = "The Bila street";
  long_desc = ""
"          #       In the shady places of Bila street there are a lots of\n"+
"-+---+---+#       rats and beetles running around.\n"+
"     | H |#       On the left side you see a partially collapsed house.\n"+
"#### |  H*#       There are lots of broken stone lanterns around.\n"+  
"   # | H |#\n"+
" K # +---+#\n";

  set_light(2);
}
}
