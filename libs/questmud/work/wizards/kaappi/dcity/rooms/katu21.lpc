inherit "room/room";
object mob,mob2;

mixed reset(mixed arg) {
  if(!mob) {
  mob = clone_object("/wizards/kaappi/dcity/mobs/jannut.lpc");
  mob->move_object(this_object()); }

  if(!mob2) {
  mob2 = clone_object("/wizards/kaappi/dcity/mobs/jannut.lpc");
  mob2->move_object(this_object()); }
{
  if(arg) return;

  add_exit("south", "katu13.lpc");
  add_exit("north", "katu27.lpc");
  add_exit("west", "katu20.lpc");
  add_exit("east", "katu22.lpc");
  
  short_desc = "The crossing";
  long_desc = ""
"   # |   |#     This is the crossing of Gimbar and Thrala street. There\n"+
"#-## |G  7#     can be seen some houses in the east and south. Far from\n"+
" | p |   |#     the west you can still hear some loud noises from\n"+
"-o---*-6-+#     central square. In the north you can see few guards\n"+
" |   | H |#     entering barracks.\n"+
"H4H  5H H|#\n";

  set_light(2);
}
}
