inherit "room/room";
object mob;

mixed reset(mixed arg) {
  if(!mob) {
  mob = clone_object("/wizards/kaappi/dcity/mobs/jannut.lpc");
  mob->move_object(this_object()); }
{
  if(arg) return;

  add_exit("west", "katu42.lpc");
  add_exit("east", "katu44.lpc");
  
  short_desc = "The Mormain street";
  long_desc = ""
"###########       You are standing at the Mormain street. It is leading\n"+
" V                to east and west. There are some lanterns which are \n"+
" |                lightening the street.\n"+
"-+-9-*---+-       You can see the fence of the park in south.\n"+
" |       | \n"+
"W| ##### | \n";

  set_light(2);
}
}
