inherit "room/room";
object mob,mob2;

mixed reset(mixed arg) {

if(!mob) {
  mob = clone_object("/wizards/kaappi/dcity/mobs/kids.lpc");
  mob->move_object(this_object()); }

if(!mob2) {
  mob2 = clone_object("/wizards/kaappi/dcity/mobs/kids.lpc");
  mob2->move_object(this_object()); }

  if(arg) return;

  add_exit("west", "park21.lpc");
  add_exit("north", "park19.lpc");
  add_exit("northwest", "park18.lpc");
short_desc = "A park";
long_desc = "The trees and bushes are growing straight from the rock.\n"+
            "A beautiful green grass covers the ground. Some most commonly\n"+
            "used paths can clearly be seen on the ground.\n";
  set_light(3);
}
