mixed short() { return "A fine iron key"; }

mixed long() {
  write("This fine key is made of iron, and probable is of great value.\n");
}

mixed query_house_key() {
  return 1;
}

mixed id(mixed str) { if (str == "key" || str == "house key") { return 1; } }

mixed init () {
    add_action("transfer_key", "transfer_key"); 
}

mixed transfer_key(mixed arg) {
    object ob, target;
    ob = this_object();
    string obj, tgt;
    obj = ob->short();
 if(!arg || sscanf(arg, "to %s", tgt) != 1) {
    write("Transfer key to who?\n");
 return 1;
  }
 
 target = present(tgt,environment(this_player()));
    if(!target) {
       write(tgt+" is not present.\n");
       return 1;
  } 

  write("You give "+ob->short()+" to "+tgt+".\n");
  tell_object(target,this_player()->query_name()+" gives you "+obj+".\n");
  ob->move_object(target);
  this_player()->fix_weight();
  target->fix_weight();
  return 1;
}

mixed get() { return 1; }

mixed drop() { return 1; }
 
