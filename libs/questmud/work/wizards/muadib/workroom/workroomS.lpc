inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!monster) { 
    monster = clone_object("/wizards/muadib/projects/katti");
    monster->move_object(this_object());
  }
  if(arg) return;

  add_exit("north","/wizards/muadib/workroom");
  short_desc = "A room";
  long_desc = "The monster room\n";
  set_light(3);


}
