mixed short() { return "Exp checker"; }

mixed id(mixed str) { if (str == "checker") { return 1; } }

mixed get() { return 1; }

mixed long() { 
   write("Use 'check' to use it\n");
}

mixed init() {
   add_action("check","check");
}

mixed check(mixed str) {
   object ob;
   if (!str) { write("Check who?\n"); return 1; }
   ob = present(str);
   if (!ob) { write("No " + str + " here.\n"); return 1; }
   write("Total exp: " + ob->query_worth() + "\n");
   return 1;
}
