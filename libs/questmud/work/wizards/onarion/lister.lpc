mixed short() { return "Lister"; }
mixed long() { write(short() + "\n"); }
mixed id(mixed str) { if (str == "lister") { return 1; } }

mixed init() {
   add_action("update","update");
}

mixed update(mixed str) {
   string seko;
   int skitso;
   if (!str) { return; }
   if (sscanf(str, "%s %d", seko,skitso) != 2) {
	return;
   }
   find_object("/obj/list")->update_list(seko,skitso);
   write("Trying to.\n");
   return 1;
}
