string short,long;

mixed reset() {
   short = allocate(100);
   long = allocate(100);
}

mixed get_short(mixed num) {
   if (num == 1) { return "Basics of Magics"; }
}

mixed get_long(mixed num) {
   if (num == 1) {
      return "Magic is based on the words of power. If you don't know\n"+
	     "them, it is impossible to cast the spell.\n";
   }
}
