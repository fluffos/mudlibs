#include "std.h"

mixed reset(mixed arg) {
    if (!arg) {
	set_light(1);
	clone_object("obj/safe")->move_object(this_object());
    }
}

mixed long(mixed str) {
    if (str == "door") {
	if (call_other("room/bank", "query_door"))
	    write("The door is closed.\n");
	else
	    write("The door is open.\n");
	return;
    }
    write("You are in the backroom of the bank.\n");
}

mixed short() {
    return "backroom of bank";
}

mixed init() {
    add_action("west", "west");
    add_action("open", "open");
}

mixed west() {
    if (call_other("players/shadow/virenda/bank", "query_door")) {
	write("The door is closed.\n");
	return 1;
    }
    call_other(this_player(), "move_player", "west#players/shadow/virenda/bank");
    return 1;
}

mixed open(mixed str) {
    if (!str) return 0;
    if (!call_other("players/shadow/virenda/bank", "query_door"))
	return 0;
    call_other("players/shadow/virenda/bank", "open_door_inside");
    say(call_other(this_player(), "query_name") +
	" opens the door.\n");
    write("Ok.\n");
    return 1;
}
