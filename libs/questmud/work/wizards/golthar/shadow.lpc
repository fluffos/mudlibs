#include <ansi.h>

object liv;

mixed start(object mina) {
   if (!mina) { return; }
   liv = mina;
   shadow(liv,1);
   tell_object(liv, "Entering the shadows...\n");
}
mixed self_destruct() {
destruct(this_object());
}

mixed idle() {
  return 60*6+6;
}

mixed show_age() {
  write("Age: -2s.\n");
}