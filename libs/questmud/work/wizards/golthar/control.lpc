object shadow;

mixed init() {
add_action("start_s","start_s");
add_action("stop_s","stop_s");
}

mixed start_s() {
                write("Shadowing " + this_player()->short() + "\n");
                shadow = clone_object("/wizards/golthar/shadow");
                shadow->start(this_player());
                return 1;
}                         

mixed stop_s() {
        shadow->self_destruct();
        return 1;
}
