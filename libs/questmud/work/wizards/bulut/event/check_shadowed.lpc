object ob;
string str;

mixed short() {
return("Buluts debugging object"); 
}


mixed init() { 
add_action("check","check");
}


mixed long() {
write("check(ob name) = show query_shadowed\n");
}

mixed check(mixed str) {
ob = find_player(str);
write("returned: " + ob->query_shadowed()+"\n");
return 1;
}

mixed id(mixed str) {
return str == "object";
}

