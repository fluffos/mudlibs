object ob;
string str;

mixed short() {
return("Buluts another debugging object"); 
}


mixed init() { 
add_action("helb","helb");
}


mixed long() {
write("helb = find object named sign and dest it :P\n");
}

mixed helb() {
ob = find_object("/wizards/bulut/event/sign");
ob->self_destruct();
return 1;
}

mixed id(mixed str) {
return str == "object";
}

