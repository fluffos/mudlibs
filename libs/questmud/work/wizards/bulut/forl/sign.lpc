mixed short() { return "A sign is here"; }

mixed long(mixed str) {
    write("There is a sign.\n");
    write("It says: 'Welcome to Forlindon village'.\n");
    return;
}


mixed id(mixed str) { return str == "sign"; }



mixed get(mixed str) {
    if (str == "sign") {
        write("You can't take the sign.\n");
        return 0;
    }
    return 0;
}
