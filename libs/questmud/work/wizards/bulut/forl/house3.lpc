#include "room.h"
object guard, guard2;

mixed extra_reset() {
        if (!guard || !living(guard)) {
guard = clone_object("/wizards/bulut/forl/monsters/hguard2.lpc");
        guard->move_object(this_object());
}
        if (!guard2 || !living(guard2)) {
guard2 = clone_object("/wizards/bulut/forl/monsters/hguard2.lpc");
guard2->move_object(this_object());



}
}
#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();


TWO_EXIT("wizards/bulut/forl/road9","out",
"wizards/bulut/forl/room1","west",
"Inside of a house",
"It is very clean here. The floor reflects your figure on itself.\n" +
"There is a open door at western wall.\n",3)
