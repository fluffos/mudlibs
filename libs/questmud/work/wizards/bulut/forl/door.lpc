inherit "obj/door";

mixed reset(mixed arg) {
  if(arg) { return; }
  set_dir("north");
  set_code(191);
  set_type("wood");
  set_door("wizards/bulut/forl/door2.lpc");
  set_closed(1);
  set_locked(1);
  set_can_lock(1);
  set_door_long("A sturdy looking door.\n"
                "You wonder why it is locked.\n");
}
