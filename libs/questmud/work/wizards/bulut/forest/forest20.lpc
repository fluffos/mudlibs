#include "room.h"

object wolf;
object snake;

mixed extra_reset() {
        if (!wolf || !living(wolf)) {
wolf = clone_object("/wizards/bulut/forest/wolf.lpc");
        wolf->move_object(this_object());

              }

        if (!snake || !living(snake)) {
snake = clone_object("/wizards/bulut/forest/snake.lpc");
        snake->move_object(this_object());

              }

}


#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();


TWO_EXIT("wizards/bulut/forest/foresta","north",
"wizards/bulut/forest/forest2","west",
"In the forest",
"Path continues to north and west from here.\n", 1)
