#include "room.h"

object wolf;
object wolf2;
object snake2;

mixed extra_reset() {
        if (!wolf || !living(wolf)) {
wolf = clone_object("/wizards/bulut/forest/wolf.lpc");
        wolf->move_object(this_object());

              }

        if (!wolf2 || !living(wolf2)) {
wolf2 = clone_object("/wizards/bulut/forest/wolf.lpc");
        wolf2->move_object(this_object());

              }

        if (!snake2 || !living(snake2)) {
snake2 = clone_object("/wizards/bulut/forest/snake.lpc");
        snake2->move_object(this_object());

              }


}


#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();


TWO_EXIT("wizards/bulut/forest/forest5","north",
"wizards/bulut/forest/forest3","south",
"In the forest",
"You are standing on a little path.\n" +
"Path continues to north and south from here.\n", 1)
