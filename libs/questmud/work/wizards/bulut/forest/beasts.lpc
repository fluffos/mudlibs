#include "room.h"

object beast_mark,beast_master;


mixed init() {
   ::init();
add_action("join", "join");
}

mixed extra_reset() {
        if (!beast_master || !living(beast_master)) {
        beast_master = clone_object("/wizards/bulut/forest/beast_master.lpc");
        beast_master->move_object(this_object());
                                                    }
              }


mixed join(mixed str) {
write("Were-wolf grabs your neck and BITES!\n");
write("You feel TERRIBLE PAIN.\n");
    beast_mark = clone_object("/wizards/bulut/jep.lpc");
    beast_mark->move_object(this_player());

return 1;
          }

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();



