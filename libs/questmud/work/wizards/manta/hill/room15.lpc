#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object monster24,monster25;

mixed extra_reset() {
        if(!monster24) {
        monster24 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster24->move_object(this_object());
        }
        if(!monster25) {
        monster25 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster25->move_object(this_object());
        }
}

ONE_EXIT("/wizards/manta/hill/room13.lpc", "south",
         "Stables",
         "This used to be stables but now all horses have been eaten.\n", 3)





