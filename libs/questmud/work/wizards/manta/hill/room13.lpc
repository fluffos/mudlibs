#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object monster19,monster20,monster21;

mixed extra_reset() {
        if(!monster19) {
        monster19 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster19->move_object(this_object());
        }
        if(!monster20) {
        monster20 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster20->move_object(this_object());
        }
        if(!monster21) {
         monster21 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster21->move_object(this_object());
        }
}

THREE_EXIT("/wizards/manta/hill/room15.lpc", "north",
           "/wizards/manta/hill/room14.lpc", "south",
           "/wizards/manta/hill/room6.lpc", "west",
           "A small path",
           "This is small path leading to fortress stables.\n", 3)



