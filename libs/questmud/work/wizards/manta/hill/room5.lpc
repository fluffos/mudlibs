#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object monster6,monster7,monster8;

mixed extra_reset() {
        if(!monster6) {
        monster6 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster6->move_object(this_object());
        }
        if(!monster7) {
        monster7 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster7->move_object(this_object());
        }
        if(!monster8) {
        monster8 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster8->move_object(this_object());
        }
}

FOUR_EXIT("/wizards/manta/hill/room9.lpc", "north",
           "/wizards/manta/hill/room4.lpc", "east",
           "/wizards/manta/hill/room8.lpc", "south",
           "/wizards/manta/hill/room12.lpc", "west",
             "A small path",
           "This is small path leading to fortress cooking facilities.\n", 3)


