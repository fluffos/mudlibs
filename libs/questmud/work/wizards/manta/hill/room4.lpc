#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object monster4,monster5;

mixed extra_reset()   {
        if (!monster4)  {
        monster4 = clone_object("wizards/manta/castle/dem1.lpc");
        monster4->move_object(this_object());
        }
        if(!monster5)   {
        monster5 = clone_object("wizards/manta/castle/dem1.lpc");
monster5->move_object(this_object());
        }
}

FOUR_EXIT("wizards/manta/hill/room7.lpc", "north",
            "wizards/manta/hill/room6.lpc", "east",
            "wizards/manta/hill/room3.lpc", "south",
            "wizards/manta/hill/room5.lpc", "west",
            "A central square",
            "You are standing in a desolated square which used to be full of\n" +
            "people chatting and laughing.\n", 3)

                
