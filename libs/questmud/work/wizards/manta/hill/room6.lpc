#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object monster9,monster10,monster11;

mixed extra_reset() {
        if(!monster9) {
        monster9 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster9->move_object(this_object());
        }
        if(!monster10) {
        monster10 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster10->move_object(this_object());
        }
        if(!monster11) {
        monster11 = clone_object("/wizards/manta/castle/dem1.lpc");
        monster11->move_object(this_object());
        }
}

THREE_EXIT("/wizards/manta/hill/room10.lpc", "north",
           "/wizards/manta/hill/room13.lpc", "east",
           "/wizards/manta/hill/room4.lpc", "west",
           "A small path",
           "This is small path leading to fortress guard housing.\n", 3)



