#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object mon22,mon23;

mixed extra_reset()   {
        if(!mon22)      {
        mon22 = clone_object("/wizards/manta/castle/dem4.lpc");
        mon22->move_object(this_object());
        }
      if(!mon23)        {
        mon23 = clone_object("/wizards/manta/castle/dem2.lpc");
        mon23->move_object(this_object());
        }
}

THREE_EXIT("/wizards/manta/castle/cas18.lpc", "east",
          "/wizards/manta/castle/cas12.lpc", "south",
            "/wizards/manta/castle/cas16.lpc", "west",
            "A castle kitchen",
            "A large and cozy kitchen next to dining hall.\n", 2)
