#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object mon8;

mixed extra_reset()   {
        if(!mon8)       {
        mon8 = clone_object("/wizards/manta/castle/dem4.lpc");
        mon8->move_object(this_object());
        }
}

TWO_EXIT("/wizards/manta/castle/cas3.lpc", "south",
          "/wizards/manta/castle/cas8.lpc", "west",
            "Weapon room",
            "This is weapon room where people caming to castle left their\n" +
            "weapons during their stay in castle.\n", 2)
