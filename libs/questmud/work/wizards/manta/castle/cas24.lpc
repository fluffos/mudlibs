#include "room.h"
 
#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();
 
object mon36,mon37,mon38;
 
mixed extra_reset()   {
        if(!mon36)      {
        mon36 = clone_object("/wizards/manta/castle/eqmon3.lpc");
        mon36->move_object(this_object());
        }
      if(!mon37)        {
        mon37 = clone_object("/wizards/manta/castle/dem4.lpc");
        mon37->move_object(this_object());
        }
      if(!mon38)        {
        mon38 = clone_object("/wizards/manta/castle/dem3.lpc");
        mon38->move_object(this_object());
        }
}
 
ONE_EXIT("/wizards/manta/castle/cas23.lpc", "west",
            "Wizards room",
            "this room was reserved for wizards who might came to the castle.\n" +
            "Demon forces wizard is currently ysin this room.", 1)
 
