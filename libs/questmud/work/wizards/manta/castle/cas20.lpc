#include "room.h"
 
#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();
 
object mon27;
 
mixed extra_reset()   {
        if(!mon27)      {
        mon27 = clone_object("/wizards/manta/castle/dem3.lpc");
        mon27->move_object(this_object());
        }
      
}
 
