#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object mon14,mon15;

mixed init() {
        add_action("enter", "enter");
        ::init();
}

mixed extra_reset()   {
        if(!mon14)      {
        mon14 = clone_object("/wizards/manta/hill/mon3.lpc");
        mon14->move_object(this_object());
        }
      if(!mon15)        {
        mon15 = clone_object("/wizards/manta/hill/mon3.lpc");
        mon15->move_object(this_object());
        }
}

mixed long(mixed str) {
        ::long(str);
        if (str == "wall") {
                write("As you look western wall you see small hole in it.\n");
        }
        if (str == "hole") {
                write("This hole seems to lead to another room.\n");
                write("You feel great evil inside hole maybe you should leave?\n");
        }
}

mixed id(mixed str) {
        ::id(str);
        if (str == "wall") { return 1; }
        if (str == "hole") { return 1; }
}

mixed enter(mixed str) {
        if(str == "hole"){
        write("You enter a dark hole.\n");
        say(this_player()->query_name()+" enters a dark hole.\n");
         this_player()->move_object("/wizards/manta/hill/room11.lpc");
        say(this_player()->query_name()+" enters room through hole.\n");
        return 1;
        }
        else {
        write("Enter where?\n");
        return 1;
        }
}       
                        
THREE_EXIT("/wizards/manta/castle/cas17.lpc", "north",
            "/wizards/manta/castle/cas13.lpc", "east",
            "/wizards/manta/castle/cas6.lpc", "south",
            "A castle tavern",
            "You have entered castle tavern, here has been fiersome battle\n" +
          "avalonians sore had fought for this. You notice that entire western\n" +
            "wall has been thorn down.\n", 2)

