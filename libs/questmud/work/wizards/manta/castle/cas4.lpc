#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object mon2;

mixed extra_reset()   {
        if(!mon2)       {
        mon2 = clone_object("/wizards/manta/castle/dem3.lpc");
        mon2->move_object(this_object());
        }
}

FOUR_EXIT("/wizards/manta/castle/cas10.lpc", "north",
            "/wizards/manta/castle/cas5.lpc", "east",
            "/wizards/manta/castle/cas1.lpc", "south",
          "/wizards/manta/castle/cas3.lpc", "west",
            "Southern corridor",
            "A corridor connecting western and eastern part of castle.\n" +
            "To south is castle entrance and long corridor runs to north.\n", 2)
