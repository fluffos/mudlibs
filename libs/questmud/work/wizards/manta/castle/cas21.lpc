#include "room.h"
 
#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();
 
object mon28,mon29,mon30;
 
mixed extra_reset()   {
        if(!mon28)      {
        mon28 = clone_object("/wizards/manta/castle/dem2.lpc");
        mon28->move_object(this_object());
        }
      if(!mon29)        {
        mon29 = clone_object("/wizards/manta/castle/dem5.lpc");
        mon29->move_object(this_object());
        }
      if(!mon30)        {
        mon30 = clone_object("/wizards/manta/castle/dem3.lpc");
        mon30->move_object(this_object());
        }
}
 
ONE_EXIT("/wizards/manta/castle/cas18.lpc", "south",
            "A dead end",
            "this room seems to be destroyed you can't continue this way\n" +
            "walls have crumbled and blocked way ahead.", 1)
 
