#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object mon3;

mixed extra_reset()   {
        if(!mon3)       {
        mon3 = clone_object("/wizards/manta/castle/dem1.lpc");
        mon3->move_object(this_object());
        }
}

