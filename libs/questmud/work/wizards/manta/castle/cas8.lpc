#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object mon6,mon7;

mixed extra_reset()   {
        if(!mon6)       {
        mon6 = clone_object("/wizards/manta/castle/dem3.lpc");
        mon6->move_object(this_object());
        }
      if(!mon7) {
        mon7 = clone_object("/wizards/manta/castle/dem1.lpc");
        mon7->move_object(this_object());
        }
}

THREE_EXIT("/wizards/manta/castle/cas14.lpc", "north",
          "/wizards/manta/castle/cas9.lpc", "east",
            "/wizards/manta/castle/cas2.lpc", "south",
            "Western corridor",
            "A corridor leading nothwards.\n", 2)
