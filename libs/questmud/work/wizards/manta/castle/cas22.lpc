#include "room.h"
 
#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();
 
object mon31,mon32,mon33;
 
mixed extra_reset()   {
        if(!mon31)      {
        mon31 = clone_object("/wizards/manta/castle/eqmon2.lpc");
        mon31->move_object(this_object());
        }
      if(!mon32)        {
        mon32 = clone_object("/wizards/manta/castle/dem5.lpc");
        mon32->move_object(this_object());
        }
      if(!mon33)        {
        mon33 = clone_object("/wizards/manta/castle/dem5.lpc");
        mon33->move_object(this_object());
        }
}
 
ONE_EXIT("/wizards/manta/castle/cas23.lpc", "east",
            "A throne room",
            "this room was castles throne room but now deserted.\n" +
            "Leader of demon forces is currently usin this room.", 1)
 
