#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object mon4,mon5;

mixed extra_reset()   {
        if(!mon4)       {
        mon4 = clone_object("/wizards/manta/castle/dem3.lpc");
        mon4->move_object(this_object());
        }
      if(!mon5) {
        mon5 = clone_object("/wizards/manta/castle/dem4.lpc");
        mon5->move_object(this_object());
        }
}

THREE_EXIT("/wizards/manta/castle/cas12.lpc", "north",
          "/wizards/manta/castle/cas7.lpc", "east",
            "/wizards/manta/castle/cas5.lpc", "west",
            "Southern corridor",
            "A corridor connecting western and eastern part of castle.\n", 2)
