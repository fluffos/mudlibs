#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object mon16,mon17;

mixed extra_reset()   {
        if(!mon16)      {
        mon16 = clone_object("/wizards/manta/castle/dem3.lpc");
        mon16->move_object(this_object());
        }
      if(!mon17)        {
        mon17 = clone_object("/wizards/manta/castle/dem1.lpc");
        mon17->move_object(this_object());
        }
}

THREE_EXIT("/wizards/manta/castle/cas18.lpc", "north",
          "/wizards/manta/castle/cas12.lpc", "west",
            "/wizards/manta/castle/cas7.lpc", "south",
            "Eastern corridor",
            "A corridor leading nothwards.\n", 2)
