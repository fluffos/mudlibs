#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();

object mon19,mon20;

mixed extra_reset()   {
        if(!mon19)      {
        mon19 = clone_object("/wizards/manta/castle/dem4.lpc");
        mon19->move_object(this_object());
        }
      if(!mon20)        {
        mon20 = clone_object("/wizards/manta/castle/dem1.lpc");
        mon20->move_object(this_object());
        }
}

THREE_EXIT("/wizards/manta/castle/cas20.lpc", "north",
          "/wizards/manta/castle/cas16.lpc", "east",
            "/wizards/manta/castle/cas10.lpc", "south",
            "A corridor",
            "A corridor leading northen part of castle.\n", 2)
