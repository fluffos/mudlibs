inherit "room/room";
object monster;
mixed reset(mixed arg) {
if(!monster) {
monster = clone_object("/wizards/terror/goblin/mokot/gpeon.lpc");
monster->move_object(this_object());
}
add_exit("north","/wizards/terror/goblin/roomit/g16.lpc");
add_exit("west","/wizards/terror/goblin/roomit/g24.lpc");
add_exit("northeast","/wizards/terror/goblin/roomit/g18.lpc");
short_desc = "A luke warm fog";
long_desc = "You are standing in luke warm fog.\n"+
"You begin to see some things.\n"+
"As your eyes get accustomed to see easier you discover some path leading northeast.\n";
}

