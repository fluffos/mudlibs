inherit "room/room";
inherit "room/door";
object monster;
mixed reset(mixed arg) {
if(!monster) {
monster = clone_object("/wizards/terror/goblin/mokot/gpeon.lpc");
monster->move_object(this_object());
}
if(arg) return;
add_exit("east","/wizards/terror/goblin/roomit/g2.lpc");
add_exit("west","/wizards/terror/goblin/roomit/g4.lpc");
short_desc = "A light forest";
long_desc = "Sunlight streams down through the trees like beams of gold.\n";
}
