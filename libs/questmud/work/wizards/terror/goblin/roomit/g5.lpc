inherit "room/room";
inherit "room/door";
object monster;
mixed reset(mixed arg) {
if(!monster) {
monster = clone_object("/wizards/terror/goblin/mokot/gpeon.lpc");
monster->move_object(this_object());
}
if(arg) return;
add_exit("north","/wizards/terror/goblin/roomit/g4.lpc");
add_exit("east","/wizards/terror/goblin/roomit/g6.lpc");
short_desc = "Light forest";
long_desc = "Sunlight streams through the trees like beams of gold.\n";
"the ground.\n";
}
