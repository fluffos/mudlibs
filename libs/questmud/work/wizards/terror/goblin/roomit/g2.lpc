inherit "room/room";
inherit "room/door";
object monster;
mixed reset(mixed arg) {
if(!monster) {
monster = clone_object("/wizards/terror/goblin/mokot/gpeon.lpc");
monster->move_object(this_object());
}
if(arg) return;
add_exit("west","/wizards/terror/goblin/roomit/g3.lpc");
add_exit("south","/wizards/terror/goblin/roomit/g8.lpc");
add_exit("east","/wizards/terror/goblin/roomit/g10.lpc");
add_exit("north","/wizards/terror/goblin/roomit/g1.lpc");
short_desc = "A deep forest";
long_desc = "You are in deep forest.\n"+
"You see some figures running behind trees.\n"+
"You feel that someone is laughing at you.\n"+
"You have some feeling .... that someone is looking at you.\n";
}
