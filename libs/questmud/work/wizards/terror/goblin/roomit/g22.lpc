inherit "room/room";
object monster;
mixed reset(mixed arg) {
if(!monster) {
monster = clone_object("/wizards/terror/goblin/mokot/gpeon.lpc");
monster->move_object(this_object());
}
add_exit("north","/wizards/terror/goblin/roomit/g23.lpc");
add_exit("east","/wizards/terror/goblin/roomit/g21.lpc");
short_desc = "A light forest";
long_desc = "You see light coming from sun and you can see a small path leading north.\n"+
"You can see everything clearly and you see next to the tree some small anthill.\n";

}
