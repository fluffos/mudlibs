inherit "room/room";
object monster;
mixed reset(mixed arg) {
if(!monster) {
monster = clone_object("/wizards/terror/goblin/mokot/gpeon.lpc");
monster->move_object(this_object());
}
add_exit("southwest","/wizards/terror/goblin/roomit/g17.lpc");
add_exit("west","/wizards/terror/goblin/roomit/g23.lpc");
short_desc = "A dark forest";
long_desc = "As you enter this room you see some rocks and some trees with leaves.\n"+
"On the ground is an old fireplace and you wonder why there isn't any grass.\n"+
"Path leading to west and southwest. You hear some screams from west.\n";
}

