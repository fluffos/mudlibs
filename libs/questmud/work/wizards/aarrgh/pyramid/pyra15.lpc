inherit "room/room";
mixed reset(mixed arg)  {
            add_exit("west", "/wizards/aarrgh/pyramid/pyra14");
            add_exit("east", "/wizards/aarrgh/pyramid/pyra16");
            add_exit("north", "/wizards/aarrgh/pyramid/pyra20");
            short_desc = "In a large hall";
            long_desc = "You are standing in a large hall.\n"+
                        "Walls are made of brownish yellow stones.\n"+
                        "You can hear some strange screaming...\n";


if(!present("mummy 2"))  {
clone_object("/wizards/aarrgh/pyramid/mon/mummy")->move_object(this_object());
clone_object("/wizards/aarrgh/pyramid/mon/mummy")->move_object(this_object());
                          }
}
