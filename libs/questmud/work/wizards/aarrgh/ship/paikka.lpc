inherit "room/room";
mixed reset(mixed arg)  {
add_exit("pissapoika", "/wizards/aarrgh/workroom.lpc");
short_desc = "huarapaikka!";
long_desc = "This place is clearly a prison. The are chains in the wall\n"+
  "to attach to poor prisoners to wait to be sacrificed to Morfeus.\n";
set_light(1);
set_not_out(1);
if(!present("sailor"))  {
clone_object("/wizards/aarrgh/ship/sailor")->move_object(this_object());
}
if(!present("sailor 2"))  {
clone_object("/wizards/aarrgh/ship/sailor")->move_object(this_object());
}
}
