mixed reset(mixed arg) {
::reset(arg);
if (arg) { return; }
set_name("flower");
set_alias("flower");
set_short("Beautiful purple flower");
set_long("Big flower with beautiful colors \n");
set_weight(20);
set_value(0);
}
mixed query_no_save() { return 1; }
mixed init() {
  add_action("show_x_value", "show_x_value");
  add_action("set_x_value", "set_x_value");
  add_action("reset_x_value", "reset_x_value");
}
mixed show_x_value()
{
call_other("/wizards/luminarc/hmm.lpc", "show_x_value");
}
mixed set_x_value()
{
call_other("/wizards/luminarc/hmm.lpc", "set_x_value");
}
mixed reset_x_value()
{
call_other("/wizards/luminarc/hmm.lpc", "reset_x_value);
}

