mapping event_players;
int allocated_event_players=0;
int players = 1;
mixed reset_event_players()
{
allocated_event_players=0;
return 1;
}
mixed allocate_event_players()
{
        event_players = ([]);

        return 1;
}
mixed sign_up(string player)
{
if (allocated_event_players==0)
        {
        allocated_event_players=allocate_event_players();
        }
event_players[players] = player;
players++;
return 1;
}
mixed how_many_players()
{
        return players;
}

mixed query_event_player(int x)
{
        if (x==0)
                x=1;
        return event_players[x];
}
mixed reduce_players()
{
players--;
return 1;
}
