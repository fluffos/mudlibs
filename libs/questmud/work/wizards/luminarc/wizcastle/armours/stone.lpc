mixed reset(mixed arg) {
  if(arg) return;
}
mixed id(mixed str) {
  return str == "soulstone" || str == "anti-illusion-stone";
}
mixed get() {
  return 1;
}
mixed query_weight() {
  return 100;
}
mixed short() {
  return "Black soulstone";
}
mixed long() {
  write("This stone is made from black stone. you can hear whispers inside of it.\n");
}

