#include "room.h" 
 
#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();
 
object monster;
 
mixed extra_reset() {
    set_not_out(3);
 
    if (!monster) {
        monster = clone_object("/wizards/walla/peepseye/monsters/hellhound");
        monster->move_object(this_object());
    }
}
 
TWO_EXIT("wizards/walla/peepseye/vorticons/h9", "west",
         "wizards/walla/peepseye/vorticons/i10", "south",
         "In the maze",
         "In the maze.\n", 1)

