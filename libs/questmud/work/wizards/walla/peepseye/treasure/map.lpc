mixed reset(mixed arg) {       
  if(arg) return;
}
mixed init() {
    ::init();
   add_action("map", "map");
}
 
mixed map(mixed arg) {
    if (arg) {
        return 0;
    }
   cat("/wizards/walla/map");
 return 1;                  
}
mixed short() {
  return "the map of treasure hunt";
}
mixed id(mixed str) {
  return str == "map";
}
mixed long() {
  write("this is the map.\n");
}
mixed drop() {
  return 0;
}
mixed get() {
  return 1;
}                
mixed query_weight() {
  return 1;
}
