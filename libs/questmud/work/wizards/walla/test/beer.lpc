mixed short() { return "A bottle of beer (labeled '"+str+"')"; }

    i = random(3);
    if(i==0) str = "Koff";
    if(i==1) str = "Karhu";
    if(i==2) str = "Lapin Kulta";

mixed long() {
  write("A bottle of beer, brought from another dimension\n");
  write("probably by Walla or Nalle.\n");
  }

mixed get() { return 1; }

mixed drop() { return 0; }

mixed id(mixed str) { return str == "beer"; }

mixed init() {
  add_action("juo", "drink");
}

mixed juo(mixed str) {
  if(str != "beer" && str != "beer") { return; }
  write("AAAAh, that feels good.\n");
  this_player()->drink_soft(10000);
  destruct(this_object());
  return 1;
}


