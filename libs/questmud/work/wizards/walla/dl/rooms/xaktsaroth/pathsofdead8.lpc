#include "room.h" 
 
#undef EXTRA_RESET
#define EXTRA_RESET\
        extra_reset();
 
object monster;
 
mixed extra_reset() {
    set_not_out(3);
 
    if (!monster) {
        monster = clone_object("/wizards/walla/dl/monsters/poddrac2");
        monster->move_object(this_object());
    }
}
TWO_EXIT("wizards/walla/dl/rooms/xaktsaroth/pathsofdead9", "northwest",
"wizards/walla/dl/rooms/xaktsaroth/pathsofdead7","east",
"The paths of the Dead",
        "This room gives you a really creepy feeling. The fact that you can't see a thing\n" +
        "doesn't make things any less uncomfortable.\n" +
"You seem to be in a staircase, twisting downwards.\n", 0)

