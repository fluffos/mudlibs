inherit "room/room";
 
int location,direction;
 
mixed reset(mixed arg) {
   short_desc = "In a huge pot";
   long_desc = "This is nothing but a mere pot. It seems to have been used to fry lard in an earlier\n"+
               "era, well, at least it smells that way. The pot has for purpose to bring draconians\n"+
               "from one level to another. It seems that the whole machine works by a chain pulled from\n" +
               "somewhere.\n";
   set_not_out(1);
   add_exit("chains", "wizards/walla/dl/rooms/xaktsaroth/pot_up_chains.lpc");
   set_light(3);
}
 
mixed start_ferry() {
 location = 1;
   add_exit("out", "wizards/walla/dl/rooms/xaktsaroth/pot_room_up.lpc");
   call_other("wizards/walla/dl/rooms/xaktsaroth/pot_room_up.lpc", "add_exit","pot", "wizards/walla/dl/rooms/potup.lpc");
   call_out("change_pos", 10);
}
 
mixed change_pos() {
 
   if (location == 1) {
        tell_room(this_object(), "The pot starts swinging upwards.\n");
        tell_room("wizards/walla/dl/rooms/xaktsaroth/potup.lpc","The pot jerks and moves slowly upwards.\n");
        call_other("wizards/walla/dl/rooms/xaktsaroth/pot_room_up.lpc", "remove_exit", "pot");
        remove_exit("out");
 call_out("real_move", 21);
   }
if (location == 2) {
 tell_room(this_object(), "The pot starts moving slowly back down.\n");          
         tell_room("wizards/walla/dl/rooms/xaktsaroth/potup.lpc","The pot slowly start descending.\n");
         call_other("wizards/walla/dl/rooms/xaktsaroth/chiefroom.lpc", "remove_exit", "pot");
         remove_exit("out");
         call_out("real_move", 21);
   }
}
 
mixed real_move() {
   tell_room("wizards/walla/dl/rooms/xaktsaroth/potup.lpc", "The pot seems to have arrived at it's final location.\n");
if (location == 1) {
   tell_room("wizards/walla/dl/rooms/xaktsaroth/pot_room_up.lpc","The pot will go no further.\n");
 
        call_other("wizards/walla/dl/rooms/xaktsaroth/pot_room_up.lpc", "add_exit","pot","wizards/walla/dl/rooms/xaktsaroth/potup.lpc");
        add_exit("out", "wizards/walla/dl/rooms/xaktsaroth/pot_room_up.lpc");
        location = 2;
        call_out("change_pos", 10);
        return 1;
   }
   if (location == 2) {
 
        tell_room("wizards/walla/dl/rooms/xaktsaroth/chiefroom.lpc", "The pot arrives to a complete halt.\n");
        call_other("wizards/walla/dl/rooms/xaktsaroth/chiefroom.lpc", "add_exit","pot","wizards/walla/dl/rooms/xaktsaroth/potup.lpc");
        add_exit("out", "wizards/walla/dl/rooms/xaktsaroth/chiefroom.lpc");
        location = 1;
        call_out("change_pos", 10);
        return 1;
   }
}

