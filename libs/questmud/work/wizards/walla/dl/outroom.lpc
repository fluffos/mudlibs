string id;
int coordinate_x, coordinate_y;
string map;
 
mixed set_coordinates(mixed x,mixed y) {
    coordinate_x = x;
    coordinate_y = y;
}
 
mixed set_id(mixed str) {
  id = str;
}
 
mixed id(mixed str) { return str == id; }
 
mixed reset() {
  if(call_other(find_object("/wizards/walla/dl/map"),"query_number")<200) {
    if(random(4) == 0) {
      clone_object("/wizards/walla/dl/monsters/squirrel")->move_object(this_object());
    } else if (random(3) == 0) {
      clone_object("/wizards/walla/dl/monsters/rodent")->move_object(this_object());
    }
    call_other(find_object("/wizards/walla/dl/map"), "add_number");
  }
}
 
mixed init() {
    add_action("show_big_map", "map");
    add_action("south", "south");
    add_action("north", "north");
    add_action("east", "east");
    add_action("west", "west");
    add_action("northwest", "northwest");
    add_action("northeast", "northeast");
    add_action("southwest", "southwest");
    add_action("southeast", "southeast");
}
 
mixed show_big_map() {
    write("You start looking around..\n");
    call_out("show_map", 1);
    return 1;
}
 
mixed show_map() {
 
find_object("/wizards/walla/dl/map")->draw_map(coordinate_x,coordinate_y,1);
}
 
mixed north() {
 
if(!find_object("/wizards/walla/dl/map")->move_living("north",coordinate_x,coordinate_y))
{
    return 0;
  }
  return 1;
}
 
mixed south() {
 
if(!find_object("/wizards/walla/dl/map")->move_living("south",coordinate_x,coordinate_y))
{
    return 0;
    }
    return 1;
}
 
mixed east() {
 
if(!find_object("/wizards/walla/dl/map")->move_living("east",coordinate_x,coordinate_y))
{
    return 0;
    }
    return 1;
}
 
mixed west() {
 
if(!find_object("/wizards/walla/dl/map")->move_living("west",coordinate_x,coordinate_y))
{
        return 0;
    }
    return 1;
}

mixed northwest() {
 
if(!find_object("/wizards/walla/dl/map")->move_living("northwest",coordinate_x,coordinate_y))
{
        return 0;
    }
    return 1;
}
 
mixed southeast() {
 
if(!find_object("/wizards/walla/dl/map")->move_living("southeast",coordinate_x,coordinate_y))
{
        return 0;
    }
    return 1;
}
 
mixed northeast() {
 
if(!find_object("/wizards/walla/dl/map")->move_living("northeast",coordinate_x,coordinate_y))
{
    return 0;
  }
  return 1;
}
 
mixed southwest() {
 
if(!find_object("/wizards/walla/dl/map")->move_living("southwest",coordinate_x,coordinate_y))
{
    return 0;
  }
  return 1;
}


