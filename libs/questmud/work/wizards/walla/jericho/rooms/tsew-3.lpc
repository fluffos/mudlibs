inherit "room/room";
mixed init() {
   ::init();
   add_action("map", "map");
}
 
mixed map(mixed arg) {
   if (arg) { return 0; }
   cat("/wizards/walla/jericho/maps/tsew-3");
   return 1;
}
object monster;
 
mixed reset(mixed arg) {
  if(!monster) {
    monster = clone_object("/wizards/walla/jericho/mobs/cit3");
    monster->move_object(this_object());
  }
  if(arg) return;
  add_exit("north","wizards/walla/jericho/rooms/htorn-5");
  add_exit("south","wizards/walla/jericho/rooms/tsew-2");
  short_desc = "On Tsew street";
  long_desc =
"You area standing on Tsew street, which is the western road in Jericho.\n" +
"This road follows the western citywall, which can been seen to your left.\n" +
"The road is covered with dust.\n";
}


