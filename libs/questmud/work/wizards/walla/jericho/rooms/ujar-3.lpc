inherit "room/room";
mixed init() {
   ::init();
   add_action("map", "map");
}
 
mixed map(mixed arg) {
   if (arg) { return 0; }
   cat("/wizards/walla/jericho/maps/ujar-3");
   return 1;
}
object monster;
 
mixed reset(mixed arg) {
  if(!monster) {
    monster = clone_object("/wizards/walla/jericho/mobs/cit3");
    monster->move_object(this_object());
  }
  if(arg) return;
  add_exit("north","wizards/walla/jericho/rooms/ujar-4");
  add_exit("south","wizards/walla/jericho/rooms/ujar-2");
  short_desc = "On Ujar street";
  long_desc =
"You area standing on Ujar street, which is one of the main roads of Jericho.\n" +
"The road goes from north to south, ans seems to have been just recently paved.\n" +
"Some old cobblestones are still lying in piles, at the side of the street.\n";
}
 
