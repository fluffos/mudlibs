inherit "room/room"; 

mixed init() {
   ::init();
   add_action("map", "map");
}

mixed map(mixed arg) {
   if (arg) { return 0; }
   cat("/wizards/walla/jericho/map");
   return 1;
}
mixed reset(mixed arg) {
 
  add_exit("west","/wizards/walla/jericho/rooms/bazaar/ylakeski");
  add_exit("south","/wizards/walla/jericho/rooms/bazaar/keskioikea");
  short_desc = "In the bazaar";
  long_desc = 
"You are standing in the northeastern corner of the bazaar. You can hear\n" +
"commotion coming from vendors in the south, aswell as music. This\n" +
"lot of the bazaar is empty, and a sign saying 'free, ask Tsila Tipak\n" +           
"for prices' is planted here. The ground is covered with red dust, \n" 
"which seems to have been coloured by blood.\n";

     
}
