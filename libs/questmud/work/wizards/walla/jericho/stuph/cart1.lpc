 mixed reset(mixed arg) {
  if(arg) return;
}
mixed short() {
  return "A shopping cart, labeled Reg Rubseh";
}
mixed id(mixed str) {
  return str == "cart";
  /* we can also return str == name || str == fire || str == alt_name; etc */
}
mixed long() {
  write("This is a shopping cart, owned by Reg Rubseh.\n");
}
mixed drop() {
  return 1;
}
mixed get() {
  return 0;
}
mixed query_weight() {
  return 1000;
}
