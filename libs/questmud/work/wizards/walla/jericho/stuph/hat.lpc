 mixed reset(mixed arg) {
  if(arg) return;
}
mixed short() {
  return "A small hat, filled with money";
}
mixed id(mixed str) {
  return str == "hat";
  /* we can also return str == name || str == fire || str == alt_name; etc */
}
mixed long() {
  write("This is a small grey hat, to which people can 'donate' money.\n");
}
mixed drop() {
  return 1;
}
mixed get() {
  return 0;
}
mixed query_weight() {
  return 1;
}
