 mixed reset(mixed arg) {
  if(arg) return;
}
mixed short() {
  return "A small yellow shard of a crystal";
}
mixed id(mixed str) {
  return str == "shard";
  /* we can also return str == name || str == fire || str == alt_name; etc */
}
mixed long() {
  write("This is a small yellow shard, from a crystal.\n");
}
mixed drop() {
  return 0;
}
mixed get() {
  return 1;
}
mixed query_weight() {
  return 1;
}

