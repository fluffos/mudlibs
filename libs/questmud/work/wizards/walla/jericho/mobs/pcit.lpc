inherit "obj/monster";
 
mixed reset(mixed arg) {
    ::reset(arg);
    if (arg) return;
    set_level(11+random(4));
    set_name("citizen");
    set_alias("man");
    set_short("A praying citizen");
    set_long("Almost all citizens of Jericho have been chased away\n"+
             "by Leb-Kamars army. The rest have been enslaved. Only\n"+
             "a few remain uncaptured. The citizen is very skinny, and\n"+
             "badly bruised.\n");
    set_al(0);
    set_gender(1);
    set_race("human");
 
 
}


