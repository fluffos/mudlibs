inherit "obj/monster";

mixed reset(mixed arg) {
    ::reset(arg);
    if (arg) return;
    set_level(10);
    set_name("citizen");
    set_alias("citizen");
    set_short("A citizen of Jericho");
    set_long("Almos all citizens of Jericho have been chased away\n"+
             "by Leb-Kamars army. The rest have been enslaved. Only\n"+
             "a few remain uncaptured. The citizen is very skinny, and\n"+
             "badly bruised.\n");
    set_al(0);
    set_gender(1);
    set_race("human");
    set_dead_ob(this_object());

}
      mixed monster_died() {
      this_object()->query_attack()->set_quest("Slay Leb-Kamar");
      shout("Monster #105952 whines as "+this_player()->query_name()+" rips its head off!\n");
      return 0;
     }

