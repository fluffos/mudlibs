}
 mixed id(mixed str) {
  return str == "rod";
}
 mixed long() {
  write("One of the parts to the rod of 7 parts. If you had them all, you could maybe do something.\n");
}
 mixed drop() {
  return 1;
}
 mixed get() {
  return 1;
}
 mixed query_weight() {
  return 2;
}
