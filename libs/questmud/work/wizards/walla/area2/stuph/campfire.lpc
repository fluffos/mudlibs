mixed reset(mixed arg) {
  if(arg) return;
}
mixed short() {
  return "A campfire";
}
mixed id(mixed str) {
  return str == "campfire";
  /* we can also return str == name || str == fire || str == alt_name; etc */
}
mixed long() {
  write("A nice campfire warms the nearby place. It makes you feel more relaxed.\n");
}
mixed drop() {
  return 1;
}
mixed get() {
  return 0;
}
mixed query_weight() {
  return 1000;
}
 
