 mixed reset(mixed arg) {
  if(arg) return;
}
mixed short() {
  return "A huge cauldron";
}
mixed id(mixed str) {
  return str == "cauldron";
  /* we can also return str == name || str == fire || str == alt_name; etc */
}
mixed long() {
  write("A huge cauldron burns, with eternal fire\n");
}
mixed drop() {
  return 1;
}
mixed get() {
  return 0;
}
mixed query_weight() {
  return 1000;
}
