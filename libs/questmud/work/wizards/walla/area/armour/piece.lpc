inherit "obj/armour";
  mixed start() {

   set_class(1);
   set_name("piece");
   set_alias("metal");
   set_short("A piece of metal");
   set_long("A small piece of black metal, unparalleled smooth, light and beatiful. \n"+
            "There are no signs, where it's from or where does it belong.\n");
}

mixed set_id(mixed arg) { return name == arg; }
mixed query_no_save() { return 1; }
