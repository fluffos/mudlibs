mixed short() { return "A can of cola labeled 'codecola'"; }

mixed long() {
  write("A can of cola\n");
  write("probably by Walla or Nalle.\n");
  }

mixed get() { return 1; }


mixed drop() { return 0; }

mixed id(mixed str) { return str == "cola"; }

mixed init() {
  add_action("juo", "drink");
}

mixed juo(mixed str) {
  if(str != "cola" && str != "cola") { return; }
  write("mmmmm, goooood!!!!!!.\n");
  this_player()->drink_soft(21);
  destruct(this_object());
  return 1;
}
