inherit "room/room";
 
 
mixed reset(mixed arg) {
 
  add_exit("north","rampart_18");
  add_exit("west","stairs_d");
  add_exit("up","tower_se");
  short_desc = "On the ramparts under a tower";
  long_desc =
"You are standing on top of the ramparts of castle North Face. You can see the courtyard\n" +
"down below. To the south you can see the mountains stretch for many miles. Looking\n" +
"over the ramparts, you can see the ground, some hundred feet below. A strong breeze\n" +
"blows here, high up in the Khalkhist mountains.\n";
 
}
