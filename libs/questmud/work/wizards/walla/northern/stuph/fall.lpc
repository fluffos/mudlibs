mixed short() { return "You are falling down from the bridge."; }

mixed long(mixed str) {
	write("You are falling down from the bridge.\n");
	return;
}

mixed kuolema(mixed delay, mixed ob) {
	call_out("loppu",delay,ob);
}

mixed loppu(mixed ob) {
	if(!ob->query_wiz()) {
	 tell_object(ob,"You hit the ground.\n");
	 ob->death();
	} else {
	 tell_object(ob,"At this point, a mortal would be dead!\n");
	}
	return 1;
}