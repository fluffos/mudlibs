inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "Golden key labelled as 'hoovee'"; }

mixed long() { write("The key is made of gold.\n"); }

mixed reset() {
  set_door_file("/wizards/walla/northern/rooms/lvl3/drawbridge_2.lpc");

  set_key_code("221");
}

mixed get() { return 1; }

mixed query_weight() { return 20; }




