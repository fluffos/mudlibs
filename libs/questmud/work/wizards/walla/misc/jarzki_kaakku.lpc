#include <ansi.h>
inherit "obj/food";
 
void reset(int x) {
  ::reset(x);
  if (x) { return; }
  set_name("kaakku");
  set_alias("syntt鋜ikaakku");
  set_short("Jarzki's syntt鋜ikaakku");
  set_long("This is jarzki's syntt鋜ikaakku, you can see the beautiful candles.\n");
  set_weight(10);
  set_value(-500);
  set_strength(1000000);
}
 
void init() {
  add_action("blow_candles","blow");
}
 
int blow_candles(string str) {
  if(str != "candles") {
    write("Blow what?\n");
    return 1;
  }
  say(this_player()->query_name()+" blows all of the candles!\n");
  write("You blow all of the candles!\n");
  shout("HAPPY BIRTHDAY JARZKI!!!\n");
  write("The candles magically light up again. Darn :D\n");
  return 1;
}
