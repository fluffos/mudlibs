inherit "room/room";
object apprentice;
object apprentice1;
mixed reset(mixed arg) {
    if (arg) return;
    add_exit("north","/wizards/siggy/area/unseen/uu21.lpc");
    add_exit("south","/wizards/siggy/area/unseen/uu26.lpc");
    add_exit("east","/wizards/siggy/area/unseen/uu24.lpc");
    add_exit("west","/wizards/siggy/area/unseen/uu22.lpc");
    set_not_out(3);
    short_desc = "A hall";
    long_desc = 
        "This is colorful but bore looking hall. There are color all the way between\n"
        + "black and white, like red pillars and blue signs and so on. There are three\n" 
        + "signs pointing in different directions. You can see a paper nailed in the eastern wall.\n";
    if(!apprentice) {
    apprentice = clone_object("/wizards/siggy/area/unseen/wizap1.lpc");
    apprentice->move_object(this_object());
    }
    if(!apprentice1) {
    apprentice1 = clone_object("/wizards/siggy/area/unseen/wizap1.lpc");
    apprentice1->move_object(this_object());
    }
}




