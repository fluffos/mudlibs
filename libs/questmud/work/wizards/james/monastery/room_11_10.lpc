
#include "dir.h"
inherit "room/room";

mixed reset(mixed arg)
{
  if(!arg)
  {
    short_desc = "In a corridor";
    long_desc = "This corridor seems to be leading into some kind of living quarters.\n";
 add_exit("southwest",DIR+"room_10_11.lpc");
 add_exit("northeast",DIR+"room_12_9.lpc");
    set_light(1);
  }
}
