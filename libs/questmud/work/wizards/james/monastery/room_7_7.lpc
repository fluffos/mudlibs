
#include "dir.h"
inherit "room/room";

mixed reset(mixed arg)
{
  if(!arg)
  {
    short_desc = "In a corridor";
    long_desc = "This corridor seems to be leading into some kind of living quarters.\n";
 add_exit("south",DIR+"room_7_8.lpc");
 add_exit("west",DIR+"room_6_7.lpc");
 add_exit("northeast",DIR+"room_8_6.lpc");
    set_light(1);
  }
}
