
#include "dir.h"
inherit "room/room";

mixed reset(mixed arg)
{
  if(!arg)
  {
    short_desc = "In a corridor";
    long_desc = "This corridor seems to be leading into some kind of living quarters.\n";
 add_exit("southeast",DIR+"room_13_5.lpc");
 add_exit("east",DIR+"room_13_4.lpc");
 add_exit("west",DIR+"room_11_4.lpc");
    set_light(1);
  }
}
