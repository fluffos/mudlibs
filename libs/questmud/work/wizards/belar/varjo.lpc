#define COLOR sprintf("%c",27)+"[1;31m"
#define OFF sprintf("%c",27)+"[0m"

object ob;

mixed reset(mixed arg) {
  if(arg) return;
  ob = find_player("Belar");
  if(!ob || ob->query_wizuvarjo()) return;
  shadow(ob, 1);
  tell_object(ob, "wiz shadow start\n");
}

 mixed query_name() {
	return "Darkseid"; }

