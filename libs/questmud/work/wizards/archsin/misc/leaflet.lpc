mixed get() { return 1; }
mixed id(mixed str) { if(str == "leaflet") return 1; }
mixed short() { return "Leaflet about 'Con"; }
mixed long() { write("\nQuestCon 9.3.2002 at Espoo, Finland!\nFor more info, see 'help mudcon'.\n\n"); }

mixed not_wanted_anymore() {
  destruct(this_object());
  return 1;
}

mixed reset() {
  call_out("not_wanted_anymore", 120);
}
