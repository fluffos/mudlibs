string where;

mixed drop() { return 1; }
mixed get() { return 0; }
mixed long() { write("Dim portal.\n"); return 1; }
mixed short() { return "Dim portal"; }
mixed id(mixed str) { return (str == "portal"); }

mixed query_loc() {
  return where;
}

mixed set_loc(mixed arg) {
  where = arg;
}

mixed enter(mixed arg) {
  object ob, env;

  if(!arg) return;
  if(arg == "portal") {

    if(!where) {
      write("Portal stays dim.\n");
      return 1;
    }
    this_player()->move_object(where);
    write("You feel dizzy.\n");
    say(this_player()->query_name()+" vanishes through portal.\n");
  }
  else {
    write("What?\n");
  }
  return 1;
}

mixed init() {
  add_action("enter", "enter");
}
