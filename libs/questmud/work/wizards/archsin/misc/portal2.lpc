mixed drop() { return 1; }
mixed get() { return 0; }
mixed long() { write("Dim portal.\n"); return 1; }
mixed short() { return "Dim portal"; }
mixed id(mixed str) { return (str == "portal"); }

mixed reset(mixed arg) {
  if(arg) return;
}

object query_loc() {
  object env;
  env = environment(this_object());
  //  write("env@query_loc: "+environment(this_object())+"\n");
  if(!env) write("plop\n");

  return env;
}

mixed enter(mixed arg) {
  object ob, env;

  if(!arg) return;
  if(arg == "portal") {

    call_other("/wizards/archsin/misc/portal1", "???", 0);
    ob = find_object("wizards/archsin/misc/portal1");
    env = ob->query_loc();
    //    write("debug: "+ob->query_loc()+"\n");
    //    write("debug: "+env+"\n");
    if(!ob) {
      write("debug: no ob!\n");
      return 1;
    }
    if(objectp(ob)) write("is object\n");
    if(!env) {
      write("debug: no env!\n");
      return 1;
    }
    this_player()->move_object(env);
    write("You feel dizzy.\n");
    say(this_player()->query_name()+" Vanishes through portal.\n");
  }
  return 1;
}

mixed init() {
  add_action("enter", "enter");
}
