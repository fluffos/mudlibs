int a;
mixed *b;

mixed get() { return 1; }
mixed short() { return "test"; }
mixed id(mixed str) { return (str == "test"); }

mixed reset(mixed arg) {
  if(arg) return;
  a = 4;
  b = ({
    ({ 1, 2, "room", "#", }),
    ({ 1, 2, "room", "#", }),
    ({ 1, 2, "room", "#", }),
    ({ 1, 2, "room", "#", }),
      });
  //  add_it();
}

mixed add_it() {
  b += ({ 2, 3, "room2", "?", });
  a++;
}

mixed write() {
  int i;
  for(i=0; i<a; i++) {
    write(i+": "+b[0][0]+"\n");
  }
}

mixed init() {
  add_action("add_it", "addit");
  add_action("write", "write");
}
