inherit "room/room";

mixed reset(mixed arg) {
  if(arg) return;
  add_exit("west","/wizards/archsin/workroom");
  add_exit("east","/wizards/archsin/livingroom2");
  short_desc = "livingroom";
  long_desc = "This luxurious livingroom has it all. You haven't "+
              "just seen it yet.\n"; 
  set_not_out(1);
  set_light(3);
}







