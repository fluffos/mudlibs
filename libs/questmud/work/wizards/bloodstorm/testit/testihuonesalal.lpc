inherit "room/room";

mixed reset(int arg) 
{
  if(arg) return;

  add_exit("bladis", "/wizards/bloodstorm/workroom.lpc");
  add_exit("cs",  "/world/city/cs");

  short_desc = "T鋗on testi huone, jossa salaexit";
  long_desc =   
 "No n鋚ytell滗s t鋒鋘 nytten jotain. T滗l huonees vois v鋒鋘 \n"+
 "opetella n鋓tuusia juttuja mitkon mulle vielhieman hakusessa\n"+
 "niinkuin v鋒鋘 kaikki viel velhona olemisessa. Salaexitti kato sit\n";

 
        items = allocate(2);
        items[0] = "salaexit";
        items[1] = "hieno salaexit josta voi liikkua jonnekkin muualle";

}




mixed init() {
  ::init(); 
  add_action("liiku", "liiku"); 
}

mixed liiku(mixed str) {
  if(str == "salaexit") {
    write("Katoppas menit salexitisthiphei hurraa!\n"); 
    say(this_player()->query_name()+" katosi salaexittiin hmm\n");
    this_player()->move_player("building#/wizards/bloodstorm/testit/salexitti.lpc");
     }
     return 1;
 }

