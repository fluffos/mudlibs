inherit "obj/monster";

mixed reset(mixed arg) {
    ::reset(arg);
    if(arg) { return; }
    set_race("human");
    call_other(this_object(), "set_level", 100);
    call_other(this_object(), "set_name", "mosu");
    call_other(this_object(), "set_alias", "human");
    call_other(this_object(), "set_short", "Pikku mosu");
    call_other(this_object(), "set_long", "pikkupikku mosu joka on todellinen testi m鲻bsteri. T滗llse\n"+
                                          "sipsuttelee edes takaisin ja v鋒鋘 muuallekkin, juuri t鋖leens鋅n"+
                                          "dumdiduu\n");
    call_other(this_object(), "set_al", 2);
    call_other(this_object(), "set_aggressive", 0);
 

}
