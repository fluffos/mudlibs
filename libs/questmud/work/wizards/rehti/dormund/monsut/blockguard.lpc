inherit "obj/monster";
object weapon;
object helm;
object armour;

mixed reset(mixed arg) {
    ::reset(arg);
    if(arg) { return; }
    set_name ("knight");
    set_level (50);
    set_al(20);
    set_alias("knight");
    set_race("human");
    set_short("Knight is here guarding the tower.");
    set_long("This knight is protecting scout towers from unauthorized entries\n");
    set_aggressive(0);
    armour = clone_object("wizards/rehti/dormund/obj/chainmail.lpc");
    armour->move_object(this_object());
    init_command("wear mail");
    weapon = clone_object("wizards/rehti/dormund/obj/broadsword.lpc");
    weapon->move_object(this_object());
    init_command("wield sword");
    helm = clone_object("wizards/rehti/dormund/obj/helm.lpc");
    helm->move_object(this_object());
    init_command("wear helm");
    set_block_dir("up");
    set_block_message("Knight says: You are not allowed to go there");
}