
mixed get_time(mixed str) {
  return random(3)+2;
}
mixed ep_cost() { return 6; }
mixed query_type() { return "neutral"; }

mixed resolve_skill(mixed str) {
	int i;
	object ob;
    if(this_player()->query_sp() < 100) {
    write("You don't have enough mental powers to use this skill.\n");
	return 1;
}
write("You create void pocket.\n");
say(this_player()->query_name()+" creates a mental pocket.\n");
i = this_player()->query_skills("mental pocket")+this_player()->query_wis()+this_player()->query_int()*2;
ob = clone_object("/guilds/psi/specials/void_pocket");
ob->move_object(this_player());
ob->set_max_weight(i);

}

mixed fail_skill(mixed str) {
write("You fail the skill.\n");
say(this_player()->query_name()+" fails the skill.\n");
}
