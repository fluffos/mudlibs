inherit "/obj/weapon";
#define BOW_D "/wizards/siki/bow_d"

//NOSAVE LAPAT, arrow sun muut
nosave int reloaded;
nosave int arrow_dam, arrow_hit, arrow_crit, arrow_stun;
nosave string arrow_desc;
nosave string label;
nosave int durability;
nosave string aim_target;
nosave object wielded_by;

string short_desc, long_desc, missile_type, bow_type;
string slot, type;
string maker, crafted;
int weight, quality, base_damage, base_hit, shoot_time, reload_time, size;

mixed short() {
  string tmp;
  tmp = "";
  tmp +=capitalize(short_desc);
  if(label)tmp += " named as '"+label+"'";
  if(reloaded)tmp += " (Reloaded)";
  if(environment(this_object()) && environment(this_object())->query_keep(this_object()))tmp += " [keep]";
  return tmp;
}
mixed id(mixed str) {
  return str == bow_type || str == label || str == short_desc;
}

mixed long() {
	string tmp;
	tmp ="";
	tmp =short();
	tmp +="\n"+long_desc+"\n";
	tmp +="It is a "+crafted+" crafted "+short_desc+".\n";
	tmp +="It is made by "+maker+".\n";
	if(reloaded)tmp +=arrow_desc;
    write(tmp);
    if(this_player()->query_wiz()) {
	write("Base dam: "+base_damage+" Base hit: "+base_hit+".\n");
	write("Quality: "+quality+" Durability: "+durability+".\n");
	write("Arrow dam: "+arrow_dam+" Hit: "+arrow_hit+" Crit: "+arrow_crit+" Stun: "+arrow_stun+".\n");
	write("Shoot time: "+shoot_time+" Reload time: "+reload_time+".\n");
	write("Size: "+size+" Weight: "+weight+".\n");
}
}

mixed query_long() {
	string tmp;
	tmp ="";
	tmp =short();
	tmp +="\nIt is a "+crafted+" crafted "+short_desc+".\n";
	tmp +="It is made by "+maker+".\n";
	if(reloaded)tmp +=arrow_desc;
return tmp;
}

mixed drop() {
  return 0;
}

mixed get() {
  return 1;
}

mixed query_weight() { return weight; }

mixed query_no_save() { return 1; }
mixed query_can_label() { return 1; }
mixed set_label(mixed to) { label=to; }

//Set this bow reloaded
//Str is the arrow
//i is the quality of arrow
mixed set_reload(string str, int hit, int dam, int crit, int stun, int arq) {
	arrow_desc = "It is loaded with "+str+".\n";
	arrow_hit = hit+arq;
	arrow_dam = dam+arq;
	arrow_crit = crit+arq;
	arrow_stun = stun+arq;
	reloaded = 1;
}
mixed query_arrow_hit() { return arrow_hit; }
mixed query_arrow_dam() { return arrow_dam; }
mixed query_arrow_crit() { return arrow_crit; }
mixed query_arrow_stun() { return arrow_stun; }


//Ends the shooting attempt
mixed end_shoot() {
	reloaded = 0;
	arrow_desc = "";
	arrow_dam = 0;
	arrow_hit = 0;
	arrow_crit = 0;
	durability -= 1;
	if(durability < 0) {
	write(short()+" breaks due the high usage.\n");
	destruct(this_object());
}
}

mixed is_shootable() { return 1; }

mixed query_reload() { return reloaded; }
mixed query_reload_time() { return reload_time; }
mixed query_shoot_time() { return shoot_time; }
mixed query_maker() { return maker; }
mixed query_base_damage() { return base_damage; }
mixed query_base_hit() { return base_hit; }
mixed query_quality() { return quality; }
mixed query_missile_type() { return missile_type; }
mixed query_name() { return short(); }
mixed query_size() { return size; }
mixed query_bow_type() { return bow_type; }

//Settings
mixed set_short(mixed str) { short_desc=str; }
mixed set_long(mixed str) { long_desc=str; }
mixed set_weight(mixed i) { weight=i; }
mixed set_base_damage(mixed i) { base_damage=i; }
mixed set_base_hit(mixed i) { base_hit=i; }
mixed set_size(mixed i) { size=i; }
mixed set_shoot_time(mixed i) { shoot_time=i; }
mixed set_reload_time(mixed i) { reload_time=i; }
mixed set_maker(mixed str) { maker=str; }
mixed set_missile_type(mixed str) { missile_type=str; }
mixed set_bow_type(mixed str) { bow_type=str; }

mixed set_quality(mixed i) {
	quality = i;
	durability = i*5;
	switch(i) {
	case 0..10:
	crafted="awfully";
	break;
	case 11..20:
	crafted="badly";
	break;
	case 21..30:
	crafted="basically";
	break;
	case 31..40:
	crafted="adequately";
	break;
	case 41..50:
	crafted="moderately";
	break;
	case 51..60:
	crafted="finely";
	break;
	case 61..70:
	crafted="flawlessly";
	break;
	case 71..80:
	crafted="superbly";
	break;
	case 81..90:
	crafted="perfectly";
	break;
	case 91..100:
	crafted="divinely";
	break;
}
}

mixed query_weapon() { return 1; }
mixed query_type() { return "bludgeon"; }
mixed query_weapon_type() { return "bow"; }
mixed query_dur() { return 2; }
mixed query_max_dur() { return 2; }