#define STACK_D "/daemons/string_stack_d"
int max_weight, local_weight;
mixed reset(mixed arg) {
   if (arg) return;
}

void create() {
}

void set_max_weight(int i) {
	max_weight=i;
	call_out("end_pocket", i);
}

mixed end_pocket() {
all_inventory(this_object())->move_object(environment(this_object()));
write("The void pocket disappears.\n");
destruct(this_object());
return 1;
}

mixed id(mixed str) { return str == "pocket" || str == "void pocket"; }

mixed add_weight(mixed w) {
    if (w + local_weight > max_weight)
	return 0;
	calc_weight();
	return 1;
}
mixed calc_weight() {
 int i;
 object *obs;
 local_weight = 0;
 obs = all_inventory(this_object());
 for(i=0;i<sizeof(obs);i++) {
	 local_weight += obs[i]->query_weight();
 }
}
mixed query_weight() { return local_weight/2; }
mixed query_no_save() { return 1; }

mixed can_put_and_get(object ob) { return 1; }

mixed get() { return 0; }

mixed drop() { return 1; }

mixed short() { "Void pocket ("+local_weight+"/"+max_weight+" kg)"; }

mixed long() {
  object ob;
  int i;
  string lista, *list;
  write(short()+"\n");
  if(local_weight) write("It contains:\n");
  ob = all_inventory(this_object());
  list = allocate(sizeof(ob));
  for(i=0; i<sizeof(ob); i++) {
  list[i] = ob[i]->short();
  }
  lista = STACK_D->stack_item_list(list);
  if(lista) write(lista+".\n");
  return 1;
}