mixed short() {
  return "A bloody rope";
}
mixed id(mixed str) {
  return str == "rope";
}

mixed long() {
 write("A quite long piece of rope. The rope is\n"+
       "covered with blood. It is made of hemp.\n");
}
mixed drop() {
  return 0;
}
mixed get() {
  return 1;
}
mixed reset(mixed arg) {
  if(arg) return;
}
mixed query_weight() { return 300; }

mixed query_no_save() { return 1; }
