inherit "/obj/base_object";
#define TP this_player()
#define TPN this_player()->query_name()
int drinks_left, max_drinks, drink_value, can_fill;
string drink_message, last_drink_message, liquid_type;

//How many times player can drink from this object
mixed set_max_drinks(mixed i) {
	max_drinks=i;
	drinks_left=i;
}

//drink_cmd calls this
mixed set_drinks_left(mixed i) {
	drinks_left=i;
}
//How much this object gives 'drink' value
mixed set_drink_value(mixed i) {
	drink_value=i;
}

//Can this object be filled from another object, like fountain in cs
mixed set_can_fill(mixed i) {
	can_fill=i;
}
//Sets the drinking message what gets printed when player drinks this
mixed set_drink_message(mixed str) {
	drink_message=str;
}
//Sets the last drinkning message what gets printed when player takes last quaff
mixed set_last_drink_message(mixed str) {
	last_drink_message=str;
}
mixed set_liquid_type(mixed str) {
liquid_type=str;
}

mixed query_potion() { return 1; }
mixed query_max_drinks() { return max_drinks; }
mixed query_drinks_left() { return drinks_left; }
mixed query_drink_value() { return drink_value; }
mixed query_can_fill() { return can_fill; }
mixed query_drink_message() { return drink_message; }
mixed query_last_drink_message() { return last_drink_message; }
mixed query_liquid_type() { return liquid_type; }
mixed can_be_drinked() { return 1; }


mixed short() {
 string str;
 str = "";
 str += short_desc;
 if(!drinks_left) str = "A empty "+name+"";
 if(label) { str +=" named as '"+label+"'"; }
 return str;
}

mixed long() {
  string str;
  str = "";
  str += long_desc+".\n";
  str += get_drinks_left();
  write(str);
  return 1;
}

mixed get_drinks_left() {
int d;
mixed txt;
string n;
txt = "";
if (liquid_type) n = liquid_type;
else n = query_name();
if (drinks_left > 0) {
if (drinks_left >= max_drinks) txt += "It is full of " + n;
else {
d = ((100 * drinks_left) / max_drinks);
if (d > 80) txt += "It is almost full of " + n;
else if (d > 60) txt += "It is more than a half filled with " + n;
else if (d > 40) txt += "It is about half full of " + n;
else if (d > 20) txt += "It is less than a half filled with " + n;
else txt += "There's only a small amount of " + n + " left";
}
txt += ".\n";
}
else txt += "It's empty.\n";
return txt;
}

mixed do_drink() {
string tp_str;
string l_str;
tp_str = "";
l_str = "";
if(liquid_type) { l_str = liquid_type; }
if(drinks_left < 1 && !last_drink_message) {
	tp_str = "You take the last quaff of "+liquid_type+" from "+name+"";
} else if(drinks_left < 1 && last_drink_message) {
tp_str = last_drink_message;
}
if(drinks_left > 1 && !drink_message) {
	tp_str = "You take a quaff of "+liquid_type+" from "+name+"";
} else if(drinks_left > 1 && drink_message) {
	tp_str = drink_message;
}
write(tp_str+".\n");
say(this_player()->query_name()+" drinks "+liquid_type+" from "+name+".\n");
if(drink_value) {
this_player()->drink_soft(drink_value);
}
if(drinks_left < 1) {
short_desc = "A empty potion";
}
drinks_left -= 1;
return 1;
}

