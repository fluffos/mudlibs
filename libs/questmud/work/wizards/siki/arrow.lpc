string short_desc;
string long_desc;
int weight;
int damage;
int quality;
int hit_chance;
int crit_chance;
int stun_chance;
string maker;
string type;
string crafted;

mixed query_missile_type() { return type; }
mixed query_maker() { return maker; }
mixed query_quality() { return quality; }
mixed query_damage() { return damage; }
mixed query_weight() { return 1; }
mixed query_arrow() { return 1; }
mixed query_name() { return short_desc; }
mixed query_hit_chance() { return hit_chance; }
mixed query_crit_chance() { return crit_chance; }
mixed query_stun_chance() { return stun_chance; }


mixed set_short(mixed str) { short_desc=str; }
mixed set_long(mixed str) { long_desc=str; }
mixed set_weight(mixed i) { weight=i; }
mixed set_damage(mixed i) { damage=i; }
mixed set_hit_chance(mixed i) { hit_chance=i; }
mixed set_crit_chance(mixed i) { crit_chance=i; }
mixed set_stun_chance(mixed i) { stun_chance=i; }
mixed set_maker(mixed str) { maker=str; }
mixed set_missile_type(mixed str) { type=str; }

mixed short() {
	return short_desc;
}
mixed id(mixed str) {
	return str == type;
}
mixed long() {
	string tmp;
	tmp="";
	tmp+=short();
	tmp+="\n"+long_desc+"\n";
	tmp+="It is "+crafted+" crafted "+short_desc+".\n";
	tmp+="It was crafted by "+maker+".\n";
	write(tmp);
}
mixed drop() { return 0; }
mixed get() { return 1; }

mixed set_quality(mixed i) {
	quality = i;
	switch(i) {
	case 0..10:
	crafted="awfully";
	break;
	case 11..20:
	crafted="badly";
	break;
	case 21..30:
	crafted="basically";
	break;
	case 31..40:
	crafted="adequately";
	break;
	case 41..50:
	crafted="moderately";
	break;
	case 51..60:
	crafted="finely";
	break;
	case 61..70:
	crafted="flawlessly";
	break;
	case 71..80:
	crafted="superbly";
	break;
	case 81..90:
	crafted="perfectly";
	break;
	case 91..100:
	crafted="divinely";
	break;
}
}
