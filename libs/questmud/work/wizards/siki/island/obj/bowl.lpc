string short_desc, long_desc, alias, name;
int value, weight;

mixed reset() {
  name = "bowl";
  alias = "empty bowl";
  short_desc = "An empty bowl";
  long_desc = "An empty wooden bowl.\n";
  value = 1;
  weight = 1;
}
mixed get() { return 1; }

mixed id(mixed str) { return str == name || str == alias || str == short_desc; }
mixed short() { return short_desc; }

mixed long() { write(long_desc); }


