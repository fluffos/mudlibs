string short_desc, long_desc, alias, name, alt_alias;
int value, weight, heal;

mixed reset() {
  name = "bowl";
  alias = "rabbitsoup";
  alt_alias = "soup";
  short_desc = "A bowl of warm rabbitsoup";
  long_desc = "A wooden bown full of warm rabbitsoup. The smell is\n"+
              "delicious.\n";
  value = 100;
  weight = 3;
  heal = random(10)+20;
}

mixed get() { return 1; }

mixed id(mixed str) { return str == name || str == alias || str == alt_alias ||str == short_desc; }
mixed short() { return short_desc; }

mixed long() { write(long_desc); }

mixed init() {
  add_action("drink","drink");
}

mixed drink(mixed str) {
  object ob;
  if (!str) { return 0; }
  if (this_object() != present(str)) { return 0; }
  write("You drink the entire bowl.\n");
  say(this_player()->query_name()+" drinks something warm from a bowl.\n");
  real_drink(this_player());
  return 1;
}

mixed real_drink(mixed tp) {
  write("You feel warm inside.\n");
  tp->heal_hp(heal);
  
  clone_object("/wizards/siki/island/obj/bowl")->move_object(environment(this_object()));
  destruct(this_object());


}


