object bow, arrow;
int time;

mixed id(mixed str) {
  return str == "reload_object";
}
mixed drop() {
  return 0;
}
mixed get() {
  return 1;
}
mixed query_no_save() { return 1; }

mixed start_reload(object what, object with, int i) {
	bow = what;
	arrow = with;
	time = i;
    call_out("do_reload", time);
}

mixed do_reload() {
	write("You finish reloading your "+bow->short()+".\n");
	bow->set_reload(arrow->short(), arrow->query_damage(), arrow->query_crit_chance(), arrow->query_stun_chance(), arrow->query_quality()/3);
    arrow->move_object(bow);
	destruct(this_object());
}
