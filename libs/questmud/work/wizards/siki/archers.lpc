inherit "guilds/guilds/guild";
inherit "room/room";

mixed reset(mixed arg) {
  load_plaque();
  if(arg) return;
  short_desc = "The Archers shooting area";
  long_desc = "Nods, this is da archer shooting area, and more lappaa coming.\n";
}

mixed init() {
  ::init();
  guild_init();
}

mixed guild_max_level() {
  return 1;
}

mixed guild_name() {
    return "Archer";
}

mixed check_joining_rec() {
  return 1;
}

mixed check_advance_rec(mixed lev) {
  mapping sk;
  sk = ([ ]);
  return sk;
}
mixed get_bonuses(mixed level) {
  if(level >= guild_max_level()) return;
  return " ";
}

mixed skill_list(int guild_level) {
  mapping skill;
    skill = ([ ]);
    skill += (["craftmanship":(int) 100]);
    skill += (["fletchery":(int) 100]);
    skill += (["shooting":(int) 100]);
    skill += (["faster shots":(int) 100]);
    skill += (["markmanship":(int) 100]);
    skill += (["aim":(int) 100]);
    skill += (["critical shots":(int) 100]);
  return skill;
}


