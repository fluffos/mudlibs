inherit "room/room";
object swarm;
mixed reset(mixed arg) {
                if(!swarm) {
                        swarm = clone_object("/wizards/neophyte/swamp/swarm.lpc");
                        swarm->move_object(this_object());
                }
        add_exit("south","swamp1");
        add_exit("northwest","swamp4");
        add_exit("northeast","swamp3");
short_desc = "A boggy swamp";
long_desc = "You are standing in the wet swamp filled with rotting trees.\n"+
            "The ground feels dangerously wet and every where is piles of tussock's.\n"+
            "Air is full of small insects constantly buzzing.\n";

}
mixed init() {
  ::init();
  add_action("test", "south");
  add_action("test", "northwest");
  add_action("test", "northeast");
}

mixed test() {
        if(random(3) == 0) {
                write("You get stuck in the bog.\n");
                say(this_player()->query_name()+" gets stuck in the bog.\n");
                return 1;
}
return 0;
}

