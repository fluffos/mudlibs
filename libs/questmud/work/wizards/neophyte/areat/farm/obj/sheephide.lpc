string desc;
mixed reset(mixed arg) {
  if(arg) return;
  desc = "This hide is whie coloured and smells quite bad.\n";
}


mixed short() {
  return "hide made from sheep";
}

mixed id(mixed str) {
  return str == "hide" || str == "sheephide" || str == "lampaan_talja";
}

mixed long() {
  write(desc);
}
mixed query_long() { return desc; }

mixed drop() {
  return 0;
}

mixed get() {
  return 1;
}

mixed query_weight() {
  return 100;
}

