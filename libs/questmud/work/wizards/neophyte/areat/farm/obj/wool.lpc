string desc;
mixed reset(mixed arg) {
  if(arg) return;
  desc = "This is a tiny patch of sheep wool.\n";
}


mixed short() {
  return "A tiny patch of sheep wool";
}

mixed id(mixed str) {
  return str == "wool" || str == "patch" || str == "lampaan_villa";
}

mixed long() {
  write(desc);
}
mixed query_long() { return desc; }

mixed drop() {
  return 0;
}

mixed get() {
  return 1;
}

mixed query_weight() {
  return 100;
}

