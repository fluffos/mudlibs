string desc;
mixed reset(mixed arg) {
        if(arg) return;
        desc = "A golden watch\nIt is made of gold and a small chain hangs from it.\n";
}
mixed short() {
        return "A golden watch";
}
mixed id(mixed str) {
        return str == "watch" || str == "kulta_kello";
}
mixed long() {
        write(desc);
}
mixed query_long() { return desc; }

        mixed drop() {
                return 0;
        }
        mixed get() {
                return 1;
        }
        mixed query_weight() {
                return 100;
        }
