
mixed short() { return "A orb of light"; }

mixed get() { return 0; }
mixed drop() { return 1; }

mixed id(mixed str) { if (str == "orb") { return 1; } }

mixed init() {
	add_action("pwho", "pwho");
}
mixed pwho(mixed str) {
 if(!str) { write("pwho <player>"); return 1; }
 call_other("/wizards/neophyte/_pwho.lpc", "cmd_pwho", str);
 return 1;
}
