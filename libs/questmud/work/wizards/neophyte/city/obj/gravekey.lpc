inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A bone key"; }

mixed long() { write("The key is made of bone.\n"); }

mixed get() { return 1; }

mixed reset() {
set_key_code("4632");
}

mixed query_name() { return "key"; }
mixed query_long() { return "The key is made of bone"; }

mixed query_weight() { return 500; }
