inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A shimmering key"; }

mixed long() { write("The key is made of iron.\n"); }

mixed reset() {
  set_door_file("/wizards/neophyte/city/lighthouse/corridor16.lpc");
  set_key_code(123);
}

mixed get() { return 1; }
