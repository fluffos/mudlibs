inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A bronze key"; }

mixed long() { write("The key is made of bronze and it has a small name on 'lowie'.\n"); }
mixed query_long() { return "The key is made of bronze and it has a small name on 'lowie'"; }
mixed get() { return 1; }
mixed query_weight() { return 1000; }

mixed reset() {
set_key_code("112");
}
