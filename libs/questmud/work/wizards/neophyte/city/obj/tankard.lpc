int full;

mixed reset(mixed arg) {
  if(arg) return;
  full = 1;
}

mixed init() {
    add_action("drink", "drink");
}
mixed query_full() { return full; }
mixed query_weight() { return 2000; }

mixed drink(mixed str) {
 if (present(this_object()) != this_player()) { write("Maybe you should pick it first.\n"); return 1; }
 if(!str) { write("Drink what?\n"); return 1; }
 if(str == "tankard") {
	 if(!full) {
		 write("The tankard is empty.\n"); return 1; }
		 write("You quickly drink all the beer in tankard.\n");
		 this_player()->drink_soft(1000);
		 full = 0;
		 return 1;
	 }
 }
mixed query_long() { if(!full) { return "An empty tankard of beer.\n"; } return "A tankard full of beer.\n"; }

mixed short() { if(!full) { return "An empty tankard of beer"; } else { return "A tankard full of beer"; } }

mixed long(mixed str) { if(!full) { write("Empty tankard of beer.\n"); return 1; } write("Tankard of beer.\n"); }

mixed get() { return 1; }

mixed id(mixed str) {
    return str == "tankard" || str == "tankard_cheatti";
}

