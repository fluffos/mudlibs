inherit "room/room";

mixed reset(mixed arg) {
 if(!present("citizen")) {
  clone_object("/wizards/torspo/areat/gnomes/monsters/citizen1")->move_object(this_object());
 }
 if(!present("child") && random(5)) {
  clone_object("/wizards/torspo/areat/gnomes/monsters/child1")->move_object(this_object());
 }
  if(arg) { return; }

  add_exit("east", "/wizards/torspo/areat/gnomes/city7.lpc");
  add_exit("south", "/wizards/torspo/areat/gnomes/city3.lpc");

  set_not_out(1);
  set_light(2);
  short_desc = "Gnomish city";
  long_desc = "This is the northwestern part of the city. Road continues its way to east\n"+
              "and south. Boring looking houses are standing on the both sides of the road.\n";
}
