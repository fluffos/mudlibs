inherit "room/room";

mixed reset(mixed arg) {
 if(!present("farmer")) {
   clone_object("/wizards/torspo/areat/gnomes/monsters/farmer1")->move_object(this_object());
 }
 if(!present("child")) {
   clone_object("/wizards/torspo/areat/gnomes/monsters/child1")->move_object(this_object());
 }
  if(arg) { return; }
  add_exit("north", "/wizards/torspo/areat/gnomes/hills12.lpc");
  add_exit("east", "/wizards/torspo/areat/gnomes/hills06.lpc");
  short_desc = "Gnomish fields";
  long_desc = "The fields just continue. On the west side rises up some higher and\n"+
              "even more rocky hills which don't grow even grass. No path leads up there\n"+
              "and it's impossible to climb up. The air gets colder and you are thankful\n"+
              "for the protection the hills give against the strong, chilly wind.\n";
}
