inherit "room/room";

mixed reset(mixed arg) {
  if(arg) return;
  add_exit("south","/wizards/torspo/workroom");
  add_exit("gnomes","/wizards/torspo/areat/gnomes/entrance.lpc");
  add_exit("ogres","/wizards/torspo/areat/ogre/room1.lpc");
  short_desc = "Wizroom";
  long_desc = "Portal.\n"; 
  property = allocate(1);
  property[0] = "no_summon";
}
