inherit "room/room";

mixed reset(mixed arg) {
  add_exit("north", "swa5e");
  add_exit("west", "swa6d");
  short_desc = "swamp";
  long_desc = "swamp 6 e.\n";
}

mixed init() {
  ::init();
  add_action("sikret", "move");
}

mixed sikret(mixed str) {
  if(str == "south") {
    say(this_player()->query_name() + " goes south through the bushes.\n");
    write("You go south through the bushes.\n");
    this_player()->move_object("/wizards/ahma/swamp/rooms/spec1.lpc");
    this_player()->look();
    return 1;
  }
  return 0;
}
