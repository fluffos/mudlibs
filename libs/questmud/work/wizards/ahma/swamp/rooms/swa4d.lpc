inherit "room/room";
inherit "/wizards/ahma/swamp/rooms/swafun";
int found = 1;

mixed reset(mixed arg) {
  add_exit("north", "swa3d");
  add_exit("south", "swa5d");
  add_exit("west", "swa4c");
  if(mode) remove_exit("north");
  short_desc = "swamp";
  long_desc = "swamp 4 d.\n";
}

mixed init() {
  ::init();
  add_action("sikret", "enter");
}


//tullaan undergroundista t鋘ne ni sit on foundi.
mixed sikret(mixed str) {
  if(str != "tree") return 0;
  if(!found) return 0;
  if(mode < 1) return 0;
  write("You enter in the tree.\n");
  say(this_player()->query_name()+" enters in the tree.\n");
  this_player()->move_object("/wizards/ahma/swamp/rooms/tree.lpc");
  this_player()->look();
  return 1;
}

mixed remexit() {
  remove_exit("west");
  tell_room(this_object(), "exitti meni\n");
}

mixed addexit() {
  add_exit("west", "swa4c");
  tell_room(this_object(), "exitti tuli\n");
}