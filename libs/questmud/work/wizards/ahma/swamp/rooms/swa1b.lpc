inherit "room/room";

mixed reset(mixed arg) {
  add_exit("south", "swa2b");
  add_exit("east", "swa1c");
  short_desc = "swamp";
  long_desc = "swamp 1 b.\n";
}

mixed init() {
  ::init();
  add_action("sikret", "move");
}

mixed sikret(mixed str) {
  if(str == "north") {
    say(this_player()->query_name() + " goes north through the bushes.\n");
    write("You go north through the bushes.\n");
    this_player()->move_object("/wizards/ahma/swamp/rooms/spec3.lpc");
    this_player()->look();
    return 1;
  }
  return 0;
}
