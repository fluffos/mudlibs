inherit "room/room";
int i;
object monster01, monster02;

mixed reset(mixed arg) {
  add_exit("south", "/wizards/ahma/castle/rooms/area13e");
  add_exit("west", "/wizards/ahma/castle/rooms/area13a");
  add_exit("east", "/wizards/ahma/castle/rooms/area13c");
  short_desc = "Throne room";
  long_desc = "The throne room.\n" + read_file("/wizards/ahma/castle/thronedesc");

  i = random(8);
  
  if(i == 0) {
    if(!monster01) {
      monster01 = clone_object("/wizards/ahma/castle/mob/mob04");
      monster01->move_object(this_object());
    }
  }
  
  if(i == 1) {
    if(!monster01) {
      monster01 = clone_object("/wizards/ahma/castle/mob/mob08");
      monster01->move_object(this_object());
    }
  }  
  
  if(i == 2) {
    if(!monster01) {
      monster01 = clone_object("/wizards/ahma/castle/mob/mob09");
      monster01->move_object(this_object());
    }
  }

  if(i == 3) {
    if(!monster01) {
      monster01 = clone_object("/wizards/ahma/castle/mob/mob07");
      monster01->move_object(this_object());
    }
    if(!monster02) {
      monster02 = clone_object("/wizards/ahma/castle/mob/mob03");
      monster02->move_object(this_object());
    }
  }

  if(i == 4) {
    if(!monster01) {
      monster01 = clone_object("/wizards/ahma/castle/mob/mob05");
      monster01->move_object(this_object());
    }
    if(!monster02) {
      monster02 = clone_object("/wizards/ahma/castle/mob/mob06");
      monster02->move_object(this_object());
    }
  }

  if(i == 5) {
    if(!monster01) {
      monster01 = clone_object("/wizards/ahma/castle/mob/mob02");
      monster01->move_object(this_object());
    }
    if(!monster02) {
      monster02 = clone_object("/wizards/ahma/castle/mob/mob03");
      monster02->move_object(this_object());
    }
  }
}
