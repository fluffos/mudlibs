mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "A handful of green grass";
}

mixed id(mixed str) {
  return str == "grass";
}

mixed long() {
  write("Weak scent of grass is emitting from the bunch of this pure material of\n" +
        "itself. Grass is used to feed different animals, but also to purify their\n" +
        "intestinal tract. This type of grass can also be smoked in a pipe.\n");
}

mixed get() {
  return 1;
}

mixed query_weight() {
  return 1;
}
