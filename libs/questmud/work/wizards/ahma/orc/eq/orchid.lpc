mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "A beautiful yellow orchid";
}

mixed id(mixed str) {
  return str == "orchid";
}

mixed realid(mixed str) {
  return str == "real";
}

mixed long() {
  write("Very strong-scented and coloured orchid is resonating pure energy. The\n" + 
        "petals are exceptionally large for an orchid and the trunk is very strong-\n" + 
        "looking. The flower is spreading a strong and good scent to attract bees\n" + 
        "and butterflies to pollinate it.\n");
}

mixed get() {
  return 1;
}

mixed query_weight() {
  return 1;
}
