mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "A root of green carnivorous plant";
}

mixed id(mixed str) {
  return str == "root";
}

mixed long() {
  write("Roots of different plants are often said to have a certain ability for\n" + 
        "curing wounds or diseases. They can also be planted in the nutrious soil\n" + 
        "to make a new sprout to grow up. This green and strong-looking root is\n" + 
        "from a carnivorous plant.\n");
}

