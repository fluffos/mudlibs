mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "A shiny white lily";
}

mixed id(mixed str) {
  return str == "lily";
}

mixed realid(mixed str) {
  return str == "real";
}

mixed long() {
  write("A shining white lily is often said to be an insignia of virginity.\n" + 
        "Its bright white petals are quite small and clean. The green stalk\n" + 
        "is very thin but still strong enough to hold the flower-part up in\n" +
        "the mid-air. The flower smells fascinating and pure.\n");
}

mixed get() {
  return 1;
}

mixed query_weight() {
  return 1;
}
