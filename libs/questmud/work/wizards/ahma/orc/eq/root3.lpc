mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "A strong-looking beginning of a green plant";
}

mixed id(mixed str) {
  return str == "plant";
}

mixed long() {
  write("Almost fully grown green plant is rising from the ground. It is almost\n" + 
        "three feet high and very sturdy. Some small holes have started to form\n" + 
        "in the plants trunk. Very soon the plant will be fully grown. The time\n" +
        "will tell what the final form of this plant will be.\n");
}

mixed get() {
  return 0;
}

mixed query_weight() {
  return 1;
}
