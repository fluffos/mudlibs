mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "A grayish big toe";
}

mixed id(mixed str) {
  return str == "toe";
}

mixed long() {
  write("Originally green big toe from an Orc has already begun to turn into\n" + 
        "gray. Small piece of white bone are sticking out from the dry-blooded\n" + 
        "flesh in the base of the toe. You do not have a slightest idea what\n" + 
        "to do with this toe, probably even its former owner does not want it\n" + 
        "back anymore.\n");
}

mixed get() {
  return 1;
}

mixed query_weight() {
  return 1;
}
