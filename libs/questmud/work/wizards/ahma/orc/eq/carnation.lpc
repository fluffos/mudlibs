mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "A fragile grayish carnation";
}

mixed id(mixed str) {
  return str == "carnation";
}

mixed long() {
  write("Very fragile and ugly-looking carnation. Its petals are grayish in\n" + 
        "colour and the stalk is dark green. The carnation seems to be in bad\n" + 
        "shape and it probably does not make anyone happy if given.\n");
}

