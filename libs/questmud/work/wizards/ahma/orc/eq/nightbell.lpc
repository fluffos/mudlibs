mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "A black night-bell";
}

mixed id(mixed str) {
  return str == "night-bell";
}

mixed realid(mixed str) {
  return str == "real";
}

mixed long() {
  write("Rare, almost mythical black flower is very beautiful and big-sized. It\n" + 
        "It is so black that it almost seems to suck the light around its petals.\n" + 
        "The black flowers are often used to bring up the nature in various evil\n" +
        "ceremonies.\n");
}

mixed get() {
  return 1;
}

mixed query_weight() {
  return 1;
}
