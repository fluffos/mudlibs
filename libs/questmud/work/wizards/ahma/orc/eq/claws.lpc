mixed reset(mixed arg) {
  if(arg) return;
}

mixed short() {
  return "Freak's sharp claws";
}

mixed id(mixed str) {
  return str == "claws";
}

mixed long() {
  write("Five sharp claws are sticking out from a bloody piece of deformed arm.\n");
}

