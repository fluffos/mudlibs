inherit "room/room";
int h = random(3);
object mob;

mixed reset(mixed arg) {
  add_exit("north", "/wizards/ahma/orc/forest/sub06");
  add_exit("east", "/wizards/ahma/orc/forest/sub02");
  short_desc = "In an underground opening";
  long_desc = read_file("/wizards/ahma/orc/forest/subdesc") + "\n";

  if(!mob) {
    if(h==0) { mob = clone_object("/wizards/ahma/orc/mob/elemental01")->move_object(this_object()); }
    if(h==1) { mob = clone_object("/wizards/ahma/orc/mob/elemental02")->move_object(this_object()); }
    if(h==2) { mob = clone_object("/wizards/ahma/orc/mob/elemental03")->move_object(this_object()); }
  }
}