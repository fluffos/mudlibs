inherit "room/room";
object mob01, mob02, mob03, mob04, mob05;
int childnum;

mixed reset(mixed arg) {
  add_exit("north", "/wizards/ahma/orc/village/sq05");
  add_exit("south", "/wizards/ahma/orc/village/sq11");
  add_exit("west", "/wizards/ahma/orc/village/sq07");
  add_exit("east", "/wizards/ahma/orc/village/sq09");
  short_desc = "In central part of village square";
  long_desc = read_file("/wizards/ahma/orc/village/sqdesc");

  if(!mob01) { mob01 = clone_object("/wizards/ahma/orc/mob/salesman02")->move_object(this_object()); }
  if(childnum < 2) { if(!mob02) { mob02 = clone_object("/wizards/ahma/orc/mob/child")->move_object(this_object()); childnum++; } }
  if(childnum < 2) { if(!mob03) { mob03 = clone_object("/wizards/ahma/orc/mob/child")->move_object(this_object()); childnum++; } }
  if(!mob04) { mob04 = clone_object("/wizards/ahma/orc/mob/customer")->move_object(this_object()); }
  if(!mob05) { mob05 = clone_object("/wizards/ahma/orc/mob/customer")->move_object(this_object()); }
}

mixed childdead() {
  childnum--;
}