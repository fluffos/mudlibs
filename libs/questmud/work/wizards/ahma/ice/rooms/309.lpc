inherit "room/room";
int i = random(4);
object mob;

mixed reset(mixed arg) {
  add_exit("north", "311");
  add_exit("south", "306");
  add_exit("west", "308");
  add_exit("east", "310");
  add_exit("southwest", "305");
  add_exit("southeast", "307");
  short_desc = "On a frozen pond";
  long_desc = read_file("/wizards/ahma/ice/rooms/icedesc");

  if(!mob) {
    if(i == 0) mob = clone_object("/wizards/ahma/ice/mob/ayeti")->move_object(this_object());
    if(i == 1) mob = clone_object("/wizards/ahma/ice/mob/sgolem")->move_object(this_object());
    if(i == 2) mob = clone_object("/wizards/ahma/ice/mob/igolem")->move_object(this_object());
    if(i == 3) {
      if(random(2)) {
        mob = clone_object("/wizards/ahma/ice/mob/sgolem")->move_object(this_object());
      }
      else {
        mob = clone_object("/wizards/ahma/ice/mob/ayeti")->move_object(this_object());
      }
    }
  }
}

mixed init() {
  ::init();
  call_out("icedrop", 1);
  add_action("north", "north");
  add_action("south", "south");
  add_action("west", "west");
  add_action("east", "east");
  add_action("southwest", "southwest");
  add_action("southeast", "southeast");
}

mixed icedrop() {
  if(present(this_player())) call_out("icedrop", 3);
  else return 1;
  if(random(100)) return;
  tell_room(this_object(), "A sharp icicle falls down from the ceiling.\n");
  if(!random(2)) {
    tell_object(this_player(), "You grunt in pain as the icicle hits you!\n");
    say("An icicle hits " + this_player()->query_name() + "!\n");
    if(this_player()->query_name() == "Adult yeti" || this_player()->query_name() == "Ice golem" || this_player()->query_name() == "Snow golem") return;
    this_player()->hit_with_spell(random(51) + 1);
  }
  else {
    tell_room(this_object(), "The icicle breaks into pieces as it lands on the ground.\n");
  }
  return 1;
}

mixed north() {
  write("You start slippering onwards on the icy surface.\n");
  call_out("moveon", (random(3) + 1), 0);
  return 1;
}

mixed south() {
  write("You start slippering onwards on the icy surface.\n");
  call_out("moveon", (random(3) + 1), 1);
  return 1;
}

mixed west() {
  write("You start slippering onwards on the icy surface.\n");
  call_out("moveon", (random(3) + 1), 2);
  return 1;
}

mixed east() {
  write("You start slippering onwards on the icy surface.\n");
  call_out("moveon", (random(3) + 1), 3);
  return 1;
}

mixed southwest() {
  write("You start slippering onwards on the icy surface.\n");
  call_out("moveon", (random(3) + 1), 4);
  return 1;
}

mixed southeast() {
  write("You start slippering onwards on the icy surface.\n");
  call_out("moveon", (random(3) + 1), 5);
  return 1;
}

mixed moveon(mixed i) {
  if(i == 0) this_player()->move_player("north#/wizards/ahma/ice/rooms/311.lpc");
  if(i == 1) this_player()->move_player("south#/wizards/ahma/ice/rooms/306.lpc");
  if(i == 2) this_player()->move_player("west#/wizards/ahma/ice/rooms/308.lpc");
  if(i == 3) this_player()->move_player("east#/wizards/ahma/ice/rooms/310.lpc");
  if(i == 4) this_player()->move_player("southwest#/wizards/ahma/ice/rooms/305.lpc");
  if(i == 5) this_player()->move_player("southeast#/wizards/ahma/ice/rooms/307.lpc");
  return 1;
}