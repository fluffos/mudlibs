inherit "room/room";
 
object monster;
 
mixed reset(mixed arg) {
  if(!monster) {
    monster = clone_object("/wizards/ozmala/areat/area-testi/mosut/mosa");
    monster->move_object(this_object());
  }
  if(arg) return;
  add_exit("west","wizards/ozmala/areat/area-testi/roomit/roomi2");
  short_desc = "t滗 on huone";
  long_desc =
"jos monsu.c toimii kunnolla\n" +
"niin se pit鋓s cloonaantua t鋘ne\n" +
"huoneeseen...\n";
 
}
