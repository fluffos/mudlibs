inherit "room/room";
 
 
mixed reset(mixed arg) {
  
  add_exit("east","/wizards/grathlek/area2/room4.lpc");   
  add_exit("west","/wizards/grathlek/area2/room2.lpc");
  
  short_desc = "On the road to Tristram.";
  long_desc = "The road leads to Tristram. You can\n"+
              "see light coming from the town of\n"+
              "Tristram.\n";
}
