inherit "room/room";
object monster; 
 
 
mixed reset(mixed arg) {
   if(!monster) { 
    monster = clone_object("/wizards/grathlek/area2/monsies/citi.lpc");
    monster->move_object(this_object());
  }
  add_exit("east","/wizards/grathlek/area2/rooma.lpc");
  add_exit("north","/wizards/grathlek/area2/room13.lpc");
  add_exit("south","/wizards/grathlek/area2/rooms.lpc");
  add_exit("west","/wizards/grathlek/area2/room7.lpc");
  set_light(1); 
  
  short_desc = "In the main street of Tristram.";
  long_desc = "You are standing on the main street of Tristram.\n"+
              "You feel strongly an evils presense in this town.\n"+
              "The weapon shop is east from here.\n"+
              "Street is light whit street lamps.\n";
}
