inherit "room/room";
object monster;
 
mixed reset(mixed arg) {
   if(!monster) {
    monster = clone_object("/wizards/grathlek/area2/monsies/hscav.lpc");
    monster->move_object(this_object());
   }
  add_exit("east","/wizards/grathlek/area2/hroom4.lpc");
  add_exit("north","/wizards/grathlek/area2/hroom2.lpc");
  set_light(0); 
  
  short_desc = "In the corridors of the dark labyrhint.";
  long_desc = "The walls of the corridors are made of\n"+
              "skulls and bones. You can feel the presense\n"+
              "of great evil. It is really cold and dark in here.\n"; 
}
