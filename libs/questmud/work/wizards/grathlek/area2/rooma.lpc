inherit "room/room";
object monster; 
 
mixed reset(mixed arg) {
  if(!monster) { 
    monster = clone_object("/wizards/grathlek/area2/monsies/graul.lpc");
    monster->move_object(this_object());
  }
  add_exit("west","/wizards/grathlek/area2/room8.lpc");
  set_light(2); 
  short_desc = "Weapon shop.";
  long_desc = "You are in the weapon shop.\n"+
              "Commands : list\n"+
              "           buy <ITEM>\n"+
              ".\n"; 
}
