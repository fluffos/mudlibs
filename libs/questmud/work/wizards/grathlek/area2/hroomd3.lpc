inherit "room/room";
object monster;
 
mixed reset(mixed arg) {
   if(!monster) {
    monster = clone_object("/wizards/grathlek/area2/monsies/izual.lpc");
    monster->move_object(this_object());
   }
  add_exit("east","/wizards/grathlek/area2/hroom16.lpc");
  set_light(0); 
  
  short_desc = "A dead end.";
  long_desc = "This is a dead end. It is really cold\n"+
              "and dark in here.\n"; 
}
