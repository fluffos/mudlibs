inherit "room/room";
object monster; 
 
 
mixed reset(mixed arg) {
   if(!monster) { 
    monster = clone_object("/wizards/grathlek/area2/monsies/fall.lpc");
    monster->move_object(this_object());
  }
  add_exit("east","/wizards/grathlek/area2/room15.lpc");
  add_exit("north","/wizards/grathlek/area2/room5.lpc"); 
  set_light(0);  
  short_desc = "In the cathedral street of Tristram.";
  long_desc = "You are standing on the dark coner of Tristram.\n"+
              "You feel strongly an evils presense in this town.\n"+
              "The street lamp is broken.\n";
}
