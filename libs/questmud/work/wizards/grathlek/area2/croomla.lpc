inherit "room/room";
object monster; 

 
mixed reset(mixed arg) {
   if(!monster) { 
    monster = clone_object("/wizards/grathlek/area2/monsies/belz.lpc");
    monster->move_object(this_object());
  }
  add_exit("east","/wizards/grathlek/area2/croomp.lpc");
  add_exit("west","/wizards/grathlek/area2/croom7.lpc");
  
  short_desc = "Arch bishops room.";
  long_desc = "This is arch bishops workroom. This\n"+
              "room is very dirty and messed. It looks\n"+
              "like some maniac would been racing.\n"+
              "around this room.\n"; 
 }
