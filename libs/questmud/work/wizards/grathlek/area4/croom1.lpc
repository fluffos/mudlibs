inherit "room/room";
object monster;
object monster;
 
mixed reset(mixed arg) {
   if(!monster) {
    monster = clone_object("/wizards/grathlek/area4/monsies/cimp.lpc");
    monster->move_object(this_object());
   }
   if(!monster) {
    monster = clone_object("/wizards/grathlek/area4/monsies/cimp.lpc");
    monster->move_object(this_object());
   }
  add_exit("northwest","/wizards/grathlek/area4/croom2.lpc");
  add_exit("southwest","/wizards/grathlek/area4/mroom2.lpc");
  set_light(2);
 
  short_desc = "A dark corner.";
  long_desc = "This is the area where whores usually.\n"+
              "serve their clients. This area has a\n"+
              "very bad reputation among the noble imps.\n";
}
