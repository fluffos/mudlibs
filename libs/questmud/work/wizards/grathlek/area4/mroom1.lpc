inherit "room/room";
object monster;
 
mixed reset(mixed arg) {
   if(!monster) {
    monster = clone_object("/wizards/grathlek/area4/monsies/famu.lpc");
    monster->move_object(this_object());
   }
  add_exit("east","/wizards/grathlek/area4/eroom3.lpc");
  add_exit("west","/wizards/grathlek/area4/mroom2.lpc");
  set_light(2);
 
  short_desc = "A large red corridor.";
  long_desc = "This is the main corridor of this cave.\n"+
              "Red light shines from the west. Large pillars\n"+
              "support the walls which might be a sign of a\n"+
              "higher civilisation\n";
}
