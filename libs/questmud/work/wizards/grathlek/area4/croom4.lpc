inherit "room/room";
object monster;
 
mixed reset(mixed arg) {
   if(!monster) {
    monster = clone_object("/wizards/grathlek/area4/monsies/limp.lpc");
    monster->move_object(this_object());
   }
  add_exit("southwest","/wizards/grathlek/area4/croom5.lpc");
  add_exit("east","/wizards/grathlek/area4/croom3.lpc");
  set_light(2);
 
  short_desc = "A rocky path leading to southwest.";
  long_desc = "This path is full of stones and it's\n"+
              "hard to move also because this passage\n"+
              "is very tight and low.\n";

}
