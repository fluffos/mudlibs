inherit "room/room";
object monster;
 
mixed reset(mixed arg) {
   if(!monster) {
    monster = clone_object("/wizards/grathlek/area4/monsies/dimp.lpc");
    monster->move_object(this_object());
   }
  add_exit("east","/wizards/grathlek/area4/eroom5.lpc");
  add_exit("northwest","/wizards/grathlek/area4/froom2.lpc");
  set_light(2);
 
  short_desc = "A gloomy red passage.";
  long_desc = "Red light glows dimly on the walls. It\n"+
              "smells like somewhere might be a rotting\n"+
              "carcass and dirty rats swarm everywhere\n";
}
