inherit "room/room";
object monster;
 
mixed reset(mixed arg) {
   if(!monster) {
    monster = clone_object("/wizards/grathlek/area4/monsies/wimp.lpc");
    monster->move_object(this_object());
   }
  add_exit("east","/wizards/grathlek/area4/froom6.lpc");
  add_exit("northwest","/wizards/grathlek/area4/mroom10.lpc");
  set_light(2);
 
  short_desc = "A red shining junction.";
  long_desc = "The red light flares everywhere\n"+
              "and your imagination creates horrible\n"+ 
              "fire monsters on the walls of the cave.\n";
}
