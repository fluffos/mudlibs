inherit "room/room";
object monster;
 
mixed reset(mixed arg) {
   if(!monster) {
    monster = clone_object("/wizards/grathlek/area4/monsies/dimp.lpc");
    monster->move_object(this_object());
   }
  add_exit("east","/wizards/grathlek/area4/froom2.lpc");
  add_exit("west","/wizards/grathlek/area4/froom4.lpc");
  set_light(2);
 
  short_desc = "A smelly red passage.";
  long_desc = "The smell of undead is horrible here.\n"+
              "Rats and carrion animals swarm all over\n"+ 
              "this place and everything here makes you\n"+
              "wanna throw up. Even shit smells better than\n"+
              "this place.\n";
}
