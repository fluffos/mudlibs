inherit "room/room";
 
 
mixed reset(mixed arg) {
  add_exit("east","/wizards/grathlek/area1/room2.lpc");
  add_exit("out","/wizards/grathlek/area1/entrance");
 
  
  short_desc = "Path to the east.";
  long_desc = "You see strange light coming from east.\n"+
              "When you look in the east you see a temple\n"+
              "raising from the middle of forest.\n"; 
 

}
 
