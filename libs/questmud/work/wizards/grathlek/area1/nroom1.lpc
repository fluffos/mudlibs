inherit "room/room";
object monster; 
 
 
mixed reset(mixed arg) {
  if(!monster) { 
   if(arg) return;
  monster = clone_object("/wizards/grathlek/area1/monsies/guard2.lpc");
  monster->move_object(this_object());
  }
  add_exit("south","/wizards/grathlek/area1/eroom2.lpc");
  add_exit("enter","/wizards/grathlek/area1/nroom2.lpc");
  
  short_desc = "There is A door. The corriodor turns back to south";
  long_desc = "There is A door to Master Leornics room the corridor turns back south.\n"+
              "Door is open. There is a picture of Master Leornic on the west wall\n"+
              "of the corridor.\n"; 
              
               
 

}
