inherit "room/room";
 
 
mixed reset(mixed arg) {
  add_exit("northwest","/wizards/grathlek/area1/room27.lpc");
  add_exit("east","/wizards/grathlek/area1/room25.lpc");
 
  
  short_desc = "Path goes east and northwest.";
  long_desc = "The temple shimmers in strange light. Dark forest\n"+
              "is against the temple. But even the darkness in the \n"+
              "forest faint's away from the strange light.\n"; 
 

}
