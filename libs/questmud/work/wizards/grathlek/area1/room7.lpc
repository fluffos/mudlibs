inherit "room/room";
object monster; 
 
mixed reset(mixed arg) {
  if(!monster) {
    if(arg) return;
    monster = clone_object("/wizards/grathlek/area1/monsies/snake.lpc"); 
    monster->move_object(this_object());
  }
  add_exit("southeast","/wizards/grathlek/area1/room13.lpc");
  add_exit("west","/wizards/grathlek/area1/room6.lpc");
 
  
  short_desc = "Path goes southeast and west.";
  long_desc = "The temple shimmers in strange light. Dark forest\n"+
              "is against the temple. But even the darkness in\n"+
              "the forest faints away from the strange light.\n";

}
