inherit "room/room";
object monster; 
 
mixed reset(mixed arg) {
  if(!monster) { 
   monster = clone_object("/wizards/grathlek/area1/monsies/guard.lpc");
   monster->move_object(this_object());
  }
  add_exit("north","/wizards/grathlek/area1/room3.lpc");
  add_exit("south","/wizards/grathlek/area1/room27.lpc");
  add_exit("west","/wizards/grathlek/area1/room1.lpc");
  add_exit("enter","/wizards/grathlek/area1/eroom1.lpc");
  
  short_desc = "Entrance to the Temple of Eternal Light";
  long_desc = "The great temple shimmers in some kind of strange light.\n"+
              "There is light coming from the temple's tower.\n"+
              "The entrance to the temple is right here.\n"; 
}
