inherit "room/room"; 
 
 
mixed reset(mixed arg) {
  add_exit("west","/wizards/grathlek/area1/uproom3.lpc");  
  add_exit("southwest","/wizards/grathlek/area1/uproom5.lpc");
  
  short_desc = "The Towers Corridor leads southwest and west";
  long_desc = "This room has a Magical glow which grows to southwest.\n"+ 
              "This corridor shimmers more than any other room this\n"+
              "far away.\n";
              
               
 

}
