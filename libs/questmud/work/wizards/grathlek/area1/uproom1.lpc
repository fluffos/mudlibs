inherit "room/room"; 
 
 
mixed reset(mixed arg) {
  add_exit("north","/wizards/grathlek/area1/uproom2.lpc");
  add_exit("stairs","/wizards/grathlek/area1/eroom12.lpc"); 
  
  
  short_desc = "The Towers Corridor leads north";
  long_desc = "There is a open window in the west wall of the\n"+
              "corridor. From window you can see beatiful landscape.\n"+ 
              "This corridor shimmers more than any other room this\n"+
              "far away.\n";
              
               
 

}
