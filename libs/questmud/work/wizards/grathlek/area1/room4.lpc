inherit "room/room";
object monster;

 
mixed reset(mixed arg) {
  if(!monster) {
  monster = clone_object("/wizards/grathlek/area1/monsies/fox.lpc");
  monster->move_object(this_object());
  }
  add_exit("east","/wizards/grathlek/area1/room5.lpc");
  add_exit("southwest","/wizards/grathlek/area1/room3.lpc");
 
  
  short_desc = "Path goes east and southwest from here.";
  long_desc = "The temple shimmers in strange light. Dark forest\n"+
              "is against the temple. But even the darkness in the \n"+
              "forest faint's away from the strange light.\n"; 
 

}
