object liv;
int type, gain, delay;
int flaggi;

mixed start(mixed ob, mixed effect, mixed time) {
  liv = ob;
  gain = effect;
  delay = time;
  shadow(liv, 1);
  update_ep();
  flaggi = 1;
  call_out("remove_mentale", delay);
}

mixed query_mentale() {
if(this_object() && flaggi == 1)return 1;

else return 0;
}

mixed link_death() {
	liv->link_death();
	if(this_object())destruct_this_object();
}
    
mixed remove_mentale() {

  tell_object(liv,"You have a strange feeling that your mental state just shrunk a bit.\n");
  liv->update_stats();
  flaggi = 0;
  this_object()->unshadow();
if(this_object())destruct_this_object();
}

mixed death(mixed arg) {
  liv->death(arg);
  flaggi = 0;
  this_object()->unshadow();
if(this_object())destruct_this_object();
}

mixed update_ep() {
   liv->set_max_ep(liv->query_max_ep() + gain);
}
