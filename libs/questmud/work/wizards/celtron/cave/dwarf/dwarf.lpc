inherit "obj/monster";

mixed reset(mixed arg) {
    int i;
    string chat_str, a_chat_str;
    object money, weapon;
    ::reset(arg);
    if(arg) { return; }
    set_level(50);
    set_str(query_str()*2);
    set_log();
    i = 1;
    set_name("droim");
    set_alias("soldier");
    set_short("Droim, the dwarf soldier");
    set_long("Droim looks very experienced in combat, many scars in his face tell it.\n"+
		"He looks scared and seems to be mumbling something about orcs.\n");
    chat_str = allocate(3);
    chat_str[0] = "Dwarf says: 'Damn those orcs!'\n";
    chat_str[1] = "Dwarf mumbles in his beard.\n";
    chat_str[2] = "Dwarf says: 'I'd pay anything, if the orc boss were slain.'\n";
    load_chat(20, chat_str);
    set_skill_chance("strike", 100);
    clone_object("/wizards/celtron/cave/dwarf/dwarf_hammer")->move_object(this_object());
    clone_object("/wizards/celtron/sinrad/guard_shield")->move_object(this_object());
    clone_object("/world/eq/armours/platemail")->move_object(this_object());
    clone_object("/world/eq/armours/bracers")->move_object(this_object());
    clone_object("/world/eq/armours/gauntlets")->move_object(this_object());
    clone_object("/world/eq/armours/helm")->move_object(this_object());
    clone_object("/world/eq/armours/leggings")->move_object(this_object());
    init_command("wield warhammer");
    init_command("lwield shield");
    init_command("wear plate");
    init_command("wear helm");
    init_command("wear bracers");
    init_command("wear gauntlets");
    init_command("wear leggings");
}

mixed catch_tell(mixed str) {
    object ob;
    string tmp, tmp2;
    if (sscanf(str, "%s leaves %s", tmp, tmp2) == 2) {
        ob = find_player(lower_case(tmp));
        if (ob == attacker_ob && !random(3)) {
	   call_out("seko", 2, ob);
        }
    }
}

mixed seko(mixed ob) {
  if(!ob || !environment(ob)) return;
  move_player("after " + ob->query_name(), environment(ob));
  attack_object(ob);
}
