inherit "room/outroom";

mixed start() {
  mapfile = "/wizards/celtron/field/virtual_map";
  short_desc = "Plains";
  long_desc = "Grass covers all the ground.\n";
}
mixed reset() {
  ::reset();
  if(!present("fox") && !random(4)) {
    clone_object("/wizards/celtron/field/fox")->move_object(this_object());
  }
}

