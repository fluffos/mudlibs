mixed init() {
  add_action("reloc", "reloc");
}

mixed id(mixed str) { return str == "orb"; }

mixed short() { return "A glowing orb"; }

mixed long() { write("Usage: reloc <player>\n"); }

mixed get() { return 1; }

mixed reloc(mixed str) {
  object ob;
  if(!str) return 0;
  ob = find_player(str);
  if(!ob) {
    write("Player not found.\n");
    return 1;
  }
  write("Moving..\n");
  this_player()->move_object(environment(ob));
  say(this_player()->query_name()+" appears from nowhere!\n");
  return 1;
}
