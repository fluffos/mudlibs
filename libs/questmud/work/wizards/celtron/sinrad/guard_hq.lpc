inherit "room/room";

mixed reset(mixed arg) {
  if(!present("sinrad")) {
	clone_object("/wizards/celtron/sinrad/sinrad")->move_object(this_object());
  }
  if(!present("guard")) {
	clone_object("/world/monsters/guard")->move_object(this_object());
  }
  if(arg) return;
  add_exit("east", "world/city/emerald2");
  short_desc = "Cityguards headquarters";
  long_desc = "There are weapons and armour hanging from the walls.\n"+
	"The whole place is a dim cave digged in rockmade building.\n";
}


