mixed long() { write(short()); }
mixed short() { return "test"; }
mixed id(mixed str) { str == "test"; }
/* Called before their definitions (LDMud allowed that). */
varargs mixed short();
varargs mixed short();

mixed init() {
  add_action("do_test", "test");
}

mixed do_test(string p) {
int i;
sscanf(p, "%d", i);
write("Callout "+i+"\n");
call_out("end_test", i);
  return 1;
}
 
mixed end_test() {
  write("end_test\n");

}
