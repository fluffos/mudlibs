object monsu;

mixed id(mixed str) { return str == "orb"; }
mixed short() { return "Orb of controlling"; }
mixed long() {
  write("Try: control\n");
}
mixed init() {
  add_action("control", "control");
}
mixed get() {
  if(!this_player()->query_wiz()) destruct(this_object());
  return 1;
}
mixed control(mixed arg) {
  object ob,ob2,tmp;
  if(!this_player()->query_wiz()) destruct(this_object());
  if(!arg) return;
  ob = present(arg, environment(this_player()));
  if(!ob) return;
  write("controlling..\n");
  ob2 = this_player();
  tell_object(ob, "YOU ARE A MONSTER!\n");
  if(ob2) tell_object(ob2, "YOU ARE THE PLAYER!\n");
  clone_object("/wizards/celtron/control/cmd_ob")->move_object(ob);
  clone_object("/wizards/celtron/control/shadow")->start(ob,ob2);
  tell_object(ob2, "nyt lahtee.. muista syntax: cmd <command>\n");
  tmp = clone_object("/wizards/celtron/control/control_ob");
  tmp->start(ob);
  tmp->move_object(ob2);
  monsu = ob;
  input_to("komento");
  return 1;
}

mixed komento(string arg) {
  if(arg == "**") return 1;
  monsu->init_command(arg);
  input_to("komento");
  return 1;
}
