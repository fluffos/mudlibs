mixed init() {
  add_action("gag", "gag");
  add_action("chan_ban", "fin");
  add_action("chan_ban", "mud");
}


mixed gag(string str) {
  object ob;
  if(this_player()->query_wiz() != 5) return 0;
  if(!str) {
    write("Self destructing..\n");
    destruct(this_object());
    return 1;
  }
  ob = find_player(str);
  if(!ob) return 0;
  write("Gagged "+str+"\n");
  this_object()->move_object(ob);
  return 1;
}

mixed short() { return "Gag"; }

mixed query_auto_load() {
    return "wizards/celtron/chan_ban:";
}

mixed chan_ban() {
  if(this_player()->query_wiz() == 5) return 0;
  write("No avail.\n");
  return 1;
}
