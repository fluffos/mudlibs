object liv;

mixed start(object ob) {
   if (!ob) { return; }
   liv = ob;
   shadow(liv,1);
}

mixed move_player(mixed arg1,mixed arg2,mixed arg3,mixed arg4,mixed arg5,mixed arg6,mixed arg7,mixed arg8,mixed arg9) {
   liv->move_player(arg1,arg2,arg4,arg4,arg5,arg6,arg7,arg8,arg9);
   destruct(this_object());
}
if(liv->query_hp() < 0) {
call_out("death", 1);
return 1;
}
mixed death() {
   liv->query_attack()->stop_fight();
   liv->query_attack()->stop_all_hunting();
   liv->stop_fight();
   liv->stop_all_hunting();
   liv->move_player("X#/world/arena/temproom");
   tell_object(liv, "\n\nYou die.\n\n");
   tell_room("/world/arena/arena", "You have won the battle.\n");
   liv->set_hp(10);
   liv->remove_death();
   call_out("revive", 1);
   return 1;
}

mixed revive() {
   tell_object(liv,"You are brought back to life.\n");
   liv->move_object("/world/arena/entrance");
   destruct(this_object());
   return 1;
}

mixed query_death_shadow() {
   return 1;
}

mixed end_death_shadow() {
        destruct(this_object());
        return 1;
}

