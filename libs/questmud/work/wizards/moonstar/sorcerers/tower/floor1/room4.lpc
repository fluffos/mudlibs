inherit "room/room";

mixed reset(mixed arg) {
 if(arg) return;
 set_light(3);
 short_desc = "Inside the Tower of Sorcery";
 long_desc = "Long desc.\n";
 add_exit("north", "/guilds/sorcerer/tower/floor1/room10.lpc");
 add_exit("west", "/guilds/sorcerer/tower/floor1/room3.lpc");
 add_exit("south", "/guilds/sorcerer/tower/floor1/room5.lpc");
}