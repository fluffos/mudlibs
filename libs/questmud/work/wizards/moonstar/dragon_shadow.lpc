object liv;
#include <ansi.h>
mixed start(object mina) {
   if (!mina) { return; }
   liv = mina;
   shadow(liv,1);
   tell_object(liv, "You feel dragonic!\n");
   mina->update_stats();
}

mixed end_dragon_shadow() {
destruct(this_object());
}

mixed short() {
        return ""+RED_F+"Moonstar the friendly dictator"+OFF+"";
}

mixed query_str() {
        return liv->query_str()+300;
}

mixed query_con() {
        return liv->query_con()+300;
}

mixed query_size() {
        return 100;
}

mixed query_dex() {
        return liv->query_dex()+150;
}
