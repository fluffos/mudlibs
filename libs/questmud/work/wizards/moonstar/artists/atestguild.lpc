inherit "guilds/guilds/guild";
inherit "room/room";

mixed reset(mixed arg) {
  load_plaque();
  set_not_out(1);
  set_light(3);
  if(arg) return;
  add_exit("leave","/wizards/moonstar/workroom.lpc");
  short_desc = "Artistien testeri guildi";
  long_desc = "Artists test center. Here you can train some martial artist skills.\n";
}

mixed init() {
  ::init();
  guild_init();
}

mixed guild_max_level() {
  return 1;
}
mixed guild_name() {
    return "Artists test";
}

mixed check_joining_rec() {
  if(this_player()->query_guild_level("fighters") < 10) {
    write("You must first complete the guild of fighters.\n");
    return 0;

  }
  return 1;

}
mixed check_advance_rec(mixed lev) {
  mapping sk;
  sk = ([ ]);
  return sk;

}


mixed get_bonuses(mixed level) {
  return "str 5 , con 5 , dex 5";
}


mixed skill_list(int guild_level) {
    mapping skill;
    skill = ([ ]);
      if (guild_level > guild_max_level()) { guild_level = guild_max_level(); }
    if (guild_level >= 1) {
      skill += (["martial arts": 100]);
      skill += (["advanced martial arts": 100]);
      skill += (["dragon blow": 100]);
      skill += (["beartest": 100]);
    }
    return skill;
}

