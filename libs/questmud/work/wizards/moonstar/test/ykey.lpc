inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A shining mithril key"; }

mixed long() { write("Shining mithril key with red rock on it.\n"); }

mixed reset() {
  set_door_file("/wizards/moonstar/areas/wasteland/fortress/yard13");

  set_key_code("999");
}

mixed get() { return 1; }

mixed query_weight() { return 20; }
