object mina;

mixed start(mixed ob) {
  mina = ob;
  shadow(mina, 1);
  return 1;
}

mixed kill() { return use(); }

mixed cast() { return use(); }



mixed use() {
  tell_object(mina, "You are meditating and unable to do anything.\n");
  return 1;
} 

mixed check_condis() {
  tell_object(mina, "You are meditating and unable to do anything.\n");
  return 0;
}

mixed move_player() {
  tell_object(mina, "You are meditating and unable to move.\n");
  return 1;
}

mixed restore_time_points() {
  tell_object(mina, "You are meditating and cannot fight!.\n");
  return 1;
}

mixed short() {
        return mina->short()+" (meditating)";
}

mixed heraa() {
  destruct(this_object());
}

mixed init() {
    ::init();
   add_action("look", "l");
   add_action("tell", "tell");
}
int tell() {
write("You are meditating and unable to do anything\n");
return 1;
}
int look() {
write("You are meditating and unable to do anything\n");
return 1;
}