inherit "obj/monster";

mixed reset(mixed arg) {
    ::reset(arg);
    if (arg) { return; }
    set_level(1);
    set_name("larva");
    set_alias("worm");
    set_animal();
    set_short("A larva ");
    set_long("A vigorously.\n");
    set_al(0);
    set_aggressive(1);
    set_move_at_random(0);

}

