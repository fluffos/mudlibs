mixed id(mixed str) { return str == "beer"; }

mixed init() {
  add_action("juo", "drink");
}

mixed juo(mixed str) {
  if(str != "beer" && str != "beer") { return; }
  write("AAAAh, that feels good.\n");
  this_player()->drink_soft(10000);
  destruct(this_object());
  return 1;
}

