inherit "room/room";

/* melko suorana ripattu esimerkistihan vaan rutiinin vuoksi */

mixed reset(mixed arg) {
        if(arg) return;        
  /* Laittaa kun jaksaa moiset, keppia tulee jos randomit */
  add_exit("postikusti","/world/city/inn");
  add_exit("mbob","/wizards/punishment/workroom.lpc");

  /* Boredescit, sattupa tyhjp鋓vp滗n sis鋖l*/
  short_desc = "Punis' most excellent duudsonroom";
  long_desc = "You can see all kind of marks of Punishments\n"+
		"Excellent duudson moves, even photos of it hanging\n"+
		"on the wall making you wonder if theres any 'j鋜ki'\n"+
		"involved";

  /* itemeitkaksin k鋝in */
  items = allocate(2);
  items[0] = "photo";
  items[1] = "This is a Excellent photo of Punishment performing most excellent\n"+
  	     "Duudsonish' deathtricks";

  /* mun mestassa ei tapella ja muutenkin pit滗 olla rauhallista */
  property = allocate(4);
  property[0] = "no_kill";
  property[1] = "no_skill";
  property[2] = "no_spell";
  property[3] = "no_summon";

/*  /* mosat jne npc, my鰄emmin */
  if (!present("pikkupiru") {
     clone_object("/wizards/punishment/hauskat/pikkupiru.lpc")->move_object(this_object());
  }*/
}

mixed init() {
  ::init(); /*hauska patka milla paasee toisten workroomeihin*/
  add_action("kopteri", "lenna");
}

mixed lenna(mixed str) {
  if(!str) {
    write("To where you wanted to kopterize\n"); 
    return 1;
  }
  write("YOU HAVE BEEN KOPTERIZED! Beware the angry dog.\n");
  this_player()->move_object("/wizards/"+str+"/workroom.lpc");
  return 1;
}

