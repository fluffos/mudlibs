#include "room.h"

#undef EXTRA_RESET
#define EXTRA_RESET\
    extra_reset();

object monster;

mixed extra_reset() {
    items = allocate(2);
    items[0] = "fountain";
    items[1] = "A beautiful fountain. It has been converted into a flowerbed";
    if (!monster) {
        monster = clone_object("/wizards/nalle/area/monsters/lady");
        monster->move_object(this_object());
    }
}

TWO_EXIT("wizards/nalle/area/g3","east",
"wizards/nalle/area/f2","south",
"In the western part of the churchard.",
"You are in the middle of a well-tended garden.\n" +
"The ambience is very calm and no sounds of\n" +
"battle or training can be heard. There is a\n" +
"large fountain to the southeast.\n", 3)
