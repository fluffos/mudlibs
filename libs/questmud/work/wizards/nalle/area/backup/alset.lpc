inherit "obj/monster";

mixed reset(mixed arg) {
    string chat_str, a_chat_str;
    object money, weapon;
    ::reset(arg);
    if (arg) { return; }
    set_level(7);
    set_name("Baronne von Alset");
    set_alias("baronne");
    set_short("Baronne von Alset the luxury shop owner");
    set_long("The baronne is an elderly woman but does not seem dim witted at all.\n");
    set_al(5);
    set_aggressive(0);
    set_move_at_random(0);
        if (!chat_str) {
        chat_str = allocate(3);
        chat_str[0] =
          "The Baronne arranges the objects on the shelves.\n";
        chat_str[1] =
          "The Baronne mutters: These Mr. Billeths candies tend to be so badly packed...\n";
        chat_str[2] =
          "The Baronne fetches a ladder so she can reach to the higher shelves. \n";
    }
    if (!a_chat_str) {
        a_chat_str = allocate(1);
        a_chat_str[0] = "The Baronne slaps you across the face. \n"
;
    }
    load_chat(10, chat_str);
    load_a_chat(10, a_chat_str);

    money = clone_object("obj/money");
    call_other(money, "set_money", random(5));
    money->move_object(this_object());
}
