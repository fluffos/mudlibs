#include <ansi.h>
#define TO tell_object(ob,
string karhu;

mixed reset(arg) {
  if(arg) return;
}
 
mixed init() {
  add_action("battlekarhu", "battlekarhu");
  add_action("karhu", "karhu");
}
 
mixed battlekarhu(string str) {
object ob;

if(!str) return 1;
ob=find_player(str);
if(!ob) return 1;

if(this_player()->query_wiz()<4) { this_player()->reduce_hp(66666); return 1; }

write("BattleBear sent.\n");
say("BattleBear sent.\n");

