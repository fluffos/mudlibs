mixed reset(mixed arg) {
  if(arg) return;
}
 
mixed init() {
  add_action("clearkills", "clearkills");
}
 
mixed clearkills() {
write("Kills cleared.\n");
this_player()->clear_best_kills();
return 1;
}


mixed short() {
  return "A kill clearing device";
}
 

mixed id(mixed str) {
  return str == "device";
}
 
mixed long() {
  write("Damn this is cool, try 'clearkills'.\n");
}
 
mixed drop() {
  return 0;
}
 

mixed get() {
  return 1;
}
 

mixed query_weight() {
  return 1;
}
