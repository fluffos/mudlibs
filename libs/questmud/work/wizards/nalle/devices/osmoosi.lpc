#include <ansi.h>

mixed reset(mixed arg) {
  if(arg) return;
}
 
mixed init() {
  add_action("shortti", "shortti");
}
 
mixed shortti(string str) {

if(!str) return 1;
write("Pok.\n");
find_player("ozmala")->set_wiz_short(str);
return 1;
}

mixed short() {
  return "jutska";
}
 

mixed id(mixed str) {
  return str == "jutska";
}
 
mixed long() {
  write("pah\n");
}
 
mixed drop() {
  return 0;
}
 

mixed get() {
  return 1;
}
 

mixed query_weight() {
  return 1;
}
