#include <ansi.h>

mixed reset(mixed arg) {
  if(arg) return;
}
 
mixed init() {
  add_action("fiksaa", "fiksaa");
}
 
mixed fiksaa(string str) {

if(!str) return 1;
write("Fiksing.\n");
present("horde", environment(this_player()))->add_undead(str);
return 1;
}

mixed short() {
  return "fiksaus";
}
 

mixed id(mixed str) {
  return str == "fiksaus";
}
 
mixed long() {
  write("fiksaa jotain\n");
}
 
mixed drop() {
  return 0;
}
 

mixed get() {
  return 1;
}
 

mixed query_weight() {
  return 1;
}
