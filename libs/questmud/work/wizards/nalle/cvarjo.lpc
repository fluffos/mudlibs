object ob;

mixed reset(mixed arg) {
  if(arg) return;
  ob = find_player("nalle");
  if(!ob || ob->query_wizuvarjo()) return;
  shadow(ob, 1);
  tell_object(ob, "wiz shadow start\n");
}

mixed idle() {
  return 60*4+2+random(10);
}


mixed show_age() {
  write("Age: Hottie-teen!\n");
}

mixed query_wizuvarjo() { return 1; }

mixed remove_wizuvarjo() { destruct(this_object()); }


