mixed long() {
    write(short()+" given to married couples.\n");
}

mixed reset(mixed arg) {
    if (arg)
        return;
}

mixed init() {
add_action("smell","smell");
}

int smell(string str) {
if(!((str == "flowers") || (str != "bouquet")) ) return 0;
write("You smell the flowers. Aahh, lovely.\n");
say(this_player()->query_name()+ " smells a bouquet a flowers.\n");
return 1;
}

mixed query_weight() { return 5; }

mixed short() { return "A lovely bouquet of flowers"; }

mixed id(mixed str) { return ((str == "bouquet") || (str == "flowers")); }

mixed query_value() { return 21; }

mixed get() { return 1; }

