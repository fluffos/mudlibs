mixed init() {
  if(this_player() == environment(this_object())) { 
    add_action("drink", "drink");
  }
}

mixed query_value() { 
  return 20; 
}

mixed query_weight() { return 10; }

mixed drink(mixed str) {
 if (str == "flask") {
  write("You drink the water and throw the empty flask away.\n");
  destruct(this_object());
  this_player()->drink_soft(50000);
  return 1;
  }
 return;
}

mixed short() { 
   return "A full flask of clear water";
}

mixed long(mixed str) {
  write("A flask full of a clear liquid, most probably water.\n");
  return 1;
} 


mixed get() { return 1; }

mixed id(mixed str) {
    return str == "flask";
}



