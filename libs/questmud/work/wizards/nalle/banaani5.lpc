inherit "room/room";
mixed reset(mixed arg) {
  if(arg) return;
  add_exit("out","wizards/nalle/workroom");
  short_desc = "The Plankton Bar.";
  long_desc =
"A room where penguins play the xylophone and eat plankton.\n";
}

mixed init() {
    ::init();
   add_action("read", "read");
}

mixed read(mixed str) {
    if (!str) {
        return 0;
    }
   cat(str);
   return 1;
}
