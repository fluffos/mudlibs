





inherit "room/room";
object dwarf;

mixed reset(mixed arg){
if(!dwarf) {
 dwarf = clone_object("/wizards/yodin/areas/island/tunnel/monsters/dwarf");
 dwarf->move_object(this_object());
 }
  if(arg) return;
   set_not_out(1);
   short_desc = "Tunnels";
   long_desc = "You are walking in the small dwarwen tunnel that seems to be endless.\n";
add_exit("northwest", "/wizards/yodin/areas/island/tunnel/58.lpc");
add_exit("southwest", "/wizards/yodin/areas/island/tunnel/67.lpc");
}
