





inherit "room/room";


mixed reset(mixed arg){

  if(arg) return;
   set_not_out(1);
   short_desc = "Tunnels";
   long_desc = "You are walking in the small dwarwen tunnel that seems to be endless.\n";
add_exit("north", "/wizards/yodin/areas/island/tunnel/21.lpc");
add_exit("south", "/wizards/yodin/areas/island/tunnel/40.lpc");
}
