inherit "room/room";
object bunny;
mixed reset(mixed arg)
{
if(!bunny) {
 bunny = clone_object("/wizards/yodin/areas/windmill/monsters/bunny.lpc");
 bunny->move_object(this_object());
 }

if(arg) return;


short_desc = "Duranghom's windmill.";
long_desc =
"This must be the resting place for travellers.\n" +
"There is white bench under a large tree. Far ahead\n" +
"you see a large windmill.\n";

add_exit("west", "wm3.lpc");


}