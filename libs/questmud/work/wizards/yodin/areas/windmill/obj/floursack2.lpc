inherit "obj/food";

mixed reset(mixed arg) {
set_name("sack of flour");
set_alias("sack");
set_short("Large sack full of flour");
  set_long("This is large sack full of white flour.\n");
set_weight(10);
set_value(0);
set_strength(10000);
}
mixed query_real_flour() { return 1; }
mixed query_no_save() { return 1; }
