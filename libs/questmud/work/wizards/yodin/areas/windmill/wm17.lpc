inherit "room/room";
object pigeon;
mixed reset(mixed arg)
{
if(!pigeon) {
 pigeon = clone_object("/wizards/yodin/areas/windmill/monsters/pigeon.lpc");
 pigeon->move_object(this_object());
 }

if(arg) return;


short_desc = "Duranghom's windmill.";
long_desc =
"This is a narrow path that surrounds the windmill.\n" +
"Around the windmill there are beautiful flowers and few apple\n" +
"trees. Birds are singing very beautifully and butterflies\n" +
"are flying around you.\n";
add_exit("south", "wm18.lpc");
add_exit("northwest", "wm16.lpc");

}