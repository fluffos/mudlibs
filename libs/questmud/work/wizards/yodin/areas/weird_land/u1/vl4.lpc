inherit "room/room";
object deer;

mixed reset(mixed arg)
{
if(!deer) {
 deer = clone_object("/wizards/yodin/areas/forest/monsters/deer");
 deer->move_object(this_object());
 }

if(arg) return;


short_desc = "small odd room.";
long_desc =
"roooom \n" +
" \n" +
" \n" +
"\n";


add_exit("northeast", "vl5.lpc");
add_exit("south", "vl3.lpc");
add_exit("jump", "/u2/vl4.lpc");
add_exit("dig", "/wizards/yodin/areas/weird_land/vl4.lpc");
items = allocate (4);
items[0] = "emt";
items[1] = "These are very old and extremely tall trees.\n";
items[2] = "bushes";
items[3] = "These bushes are some short of berrybushes.\n";




 }
