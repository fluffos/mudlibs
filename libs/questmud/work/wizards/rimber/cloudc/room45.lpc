inherit "room/room";
object mike;

mixed reset(mixed arg) {
 if(!mike) {
 mike = clone_object("/wizards/rimber/cloudc/mobs/mike.lpc");
 mike->move_object(this_object());
 }
 if(arg) return;
 set_light(3);
 short_desc = "In the Cloud Tower";
 long_desc = "Only walls and cracks.\n";
 add_exit("down", "/wizards/rimber/cloudc/room44.lpc");
 set_not_out(1);
}
