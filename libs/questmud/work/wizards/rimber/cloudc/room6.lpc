inherit "room/room";
object mon;

mixed reset(mixed arg) {
 if(!mon) {
 mon = clone_object("/wizards/rimber/cloudc/mobs/soldier.lpc");
 mon->move_object(this_object());
 }
 if(arg) return;
 set_light(3);
 short_desc = "In the castle yard";
 long_desc = "Everything is white.\n";
 add_exit("north", "/wizards/rimber/cloudc/room3.lpc");
 add_exit("northeast", "/wizards/rimber/cloudc/room4.lpc");
 add_exit("east", "/wizards/rimber/cloudc/room7.lpc");
 add_exit("south", "/wizards/rimber/cloudc/room9.lpc");
 add_exit("southeast", "/wizards/rimber/cloudc/room10.lpc");
}
