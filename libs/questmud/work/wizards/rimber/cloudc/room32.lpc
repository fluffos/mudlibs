inherit "room/room";
object mon;

mixed reset(mixed arg) {
 if(arg) return;
 if(!mon) {
 mon = clone_object("/wizards/rimber/cloudc/mobs/guard.lpc");
 mon->move_object(this_object()); }
 set_light(3);
 short_desc = "On a bridge";
 long_desc = "A narrow bridge from the wall.\n";
 add_exit("north", "/wizards/rimber/cloudc/room20.lpc");
 add_exit("south", "/wizards/rimber/cloudc/room33.lpc");
}
