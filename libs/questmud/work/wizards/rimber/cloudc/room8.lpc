inherit "room/room";
object mon, mon1;

mixed reset(mixed arg) {
 if(!mon) {
 mon = clone_object("/wizards/rimber/cloudc/mobs/soldier.lpc");
 mon->move_object(this_object()); }
 if(!mon1) {
 mon1 = clone_object("/wizards/rimber/cloudc/mobs/rider.lpc");
 mon1->move_object(this_object()); }
 if(arg) return;
 set_light(3);
 short_desc = "In the castle yard";
 long_desc = "Everything is white.\n";
 add_exit("northwest", "/wizards/rimber/cloudc/room4.lpc");
 add_exit("north", "/wizards/rimber/cloudc/room5.lpc");
 add_exit("west", "/wizards/rimber/cloudc/room7.lpc");
 add_exit("east", "/wizards/rimber/cloudc/room31.lpc");
 add_exit("southwest", "/wizards/rimber/cloudc/room10.lpc");
 add_exit("south", "/wizards/rimber/cloudc/room11.lpc");
}
