inherit "room/room";
inherit "room/door";

mixed reset(mixed arg) {
 if(arg) return;
 set_light(3);
 short_desc = "Inside the Cloud Castle";
 long_desc = "plaaplaaplaa\n";
 add_exit("north", "/wizards/rimber/cloudc/room35.lpc");
 add_exit("south", "/wizards/rimber/cloudc/room37.lpc");
 door_reset();
 set_door_label("A white steel door", 1);
 set_door_label("A white silver door", 2);
 set_door_dir("west", "/wizards/rimber/cloudc/room47.lpc", 1);
 set_door_dir("east", "/wizards/rimber/cloudc/room38.lpc", 2);
 set_door_code("878", 1);
 set_door_code("222", 2);
 set_locked(1, 1);
 set_locked(1, 2);
 set_door_link("/wizards/rimber/cloudc/room47.lpc", 1);
 set_door_link("/wizards/rimber/cloudc/room38.lpc", 2);
}

mixed init() {
 ::init();
 door_init();
 set_not_out(1);
}
