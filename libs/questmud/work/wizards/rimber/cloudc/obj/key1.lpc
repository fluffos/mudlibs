inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A black obsidian key"; }

mixed long() { write("The key is made of obsidian and it's big and heavy.\n"); }

mixed reset() {
 set_door_file("/wizards/rimber/cloudc/room35.lpc");

 set_key_code("101");
}
mixed get() { return 1;}
