inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A black iron key"; }

mixed long() { write("A black iron key. The flap on the key is decorated with a skull carving.\n"); }

mixed reset() {
 set_door_file("/wizards/rimber/cloudc/room35.lpc");
 set_key_code("020");
}
mixed get() { return 1;}
