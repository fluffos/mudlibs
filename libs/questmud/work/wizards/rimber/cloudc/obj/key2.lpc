inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A beautiful silver key"; }

mixed long() { wirte("A beautifully crafted silver key. The key looks very fracile.\n"); }

mixed reset() {
 set_door_file("/wizards/rimber/cloudc/room36.lpc");

 set_key_code("222");
}
mixed get() { return 1;}
