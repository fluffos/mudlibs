inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A beautiful white steel key"; }

mixed long() { write("The key is made of steel and it's painted white.\n"); }

mixed reset() {
 set_door_file("/wizards/rimber/cloudc/room36.lpc");

 set_key_code("878");
}
mixed get() { return 1;}
