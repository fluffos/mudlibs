inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A huge iron key"; }

mixed long() { write("The key is made of iron and is quite heavy. The key looks to be too big to\n"+
 "fit to an ordinary door lock.\n"); }

mixed reset() {
 set_door_file("/wizards/rimber/hell/entrance.lpc");
 set_key_code("666");
}
mixed get() { return 1;}

mixed query_weight() { return 5; }
