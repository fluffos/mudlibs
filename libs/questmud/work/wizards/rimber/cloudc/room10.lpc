inherit "room/room";
object mon, mon1;

mixed reset(mixed arg) {
 if(!mon) {
 mon = clone_object("/wizards/rimber/cloudc/mobs/soldier.lpc");
 mon->move_object(this_object());
 }
 if(!mon1) {
 mon1 = clone_object("/wizards/rimber/cloudc/mobs/soldier.lpc");
 mon1->move_object(this_object());
 }
 if(arg) return;
 set_light(3);
 short_desc = "In the castle yard";
 long_desc = "Everything is white. High above you floats huge white construction.\n";
 add_exit("northwest", "/wizards/rimber/cloudc/room6.lpc");
 add_exit("north", "/wizards/rimber/cloudc/room7.lpc");
 add_exit("northeast", "/wizards/rimber/cloudc/room8.lpc");
 add_exit("south", "/wizards/rimber/cloudc/entrance.lpc");
 add_exit("west", "/wizards/rimber/cloudc/room9.lpc");
 add_exit("east", "/wizards/rimber/cloudc/room11.lpc");
}
