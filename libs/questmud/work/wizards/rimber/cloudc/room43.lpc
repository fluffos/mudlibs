inherit "room/room";
object guard, guard1;

mixed reset(mixed arg) {
 if(arg) return;
 if(!guard) {
 guard = clone_object("/wizards/rimber/cloudc/mobs/guard.lpc");
 guard->move_object(this_object());
 }
 if(!guard1) {
 guard1 = clone_object("/wizards/rimber/cloudc/mobs/guard.lpc");
 guard1->move_object(this_object()); }
 set_light(3);
 short_desc = "In the Cloud Tower";
 long_desc = "Small tunnel leads south. Bright white walls.\n";
 add_exit("south", "/wizards/rimber/cloudc/room44.lpc");
 add_exit("stairs", "/wizards/rimber/cloudc/room40.lpc");
 set_not_out(1);
}
