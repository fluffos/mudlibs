inherit "room/room";
object monster, monster1, monster2;

mixed reset(mixed arg) {
int a,b,c,d;

a = random(13);
b = random(13);
c = random(13);
d = random(13);

if(!monster) {
monster = clone_object("/wizards/rimber/cave/dweller.lpc");
monster->move_object(this_object());
}
if(!monster1) {
monster1 = clone_object("/wizards/rimber/cave/dweller.lpc");
monster1->move_object(this_object());
}
if(!monster2) {
monster2 = clone_object("/wizards/rimber/cave/dweller.lpc");
monster2->move_object(this_object());
}
if(arg) return;

set_light(2);
short_desc = "Dweller city";
long_desc = "Cave is really damp. Puddles speckles the floor.\n"+
"Distant sound of a dripping water echoes on the tunnels\n"+
"and sometimes sound of footsteps seems to come from next\n"+
"to you. Walls glitter oddly because of the slowly\n"+
"dripping water. Anyone could go crazy in here.\n";
add_exit("south", "/wizards/rimber/cave/"+d);
add_exit("north", "/wizards/rimber/cave/"+a);
add_exit("west", "/wizards/rimber/cave/"+b);
add_exit("east", "/wizards/rimber/cave/"+c);

}
