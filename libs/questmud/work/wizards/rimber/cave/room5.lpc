inherit "room/room";
object monster, monster1;

mixed reset(mixed arg) {
	if(!monster) {
	monster = clone_object("/wizards/rimber/cave/dweller.lpc");
	monster->move_object(this_object());
	}
	if(!monster1) {
	monster1 = clone_object("/wizards/rimber/cave/dweller.lpc");
	monster1->move_object(this_object());
	}
	set_light(3);
	short_desc = "Dark and damp cavern";
       long_desc = "The cave ceiling seems to descend northwards. Dripstones\n"+
                "reach down from the ceiling. Water flows down their surface\n"+
                "making large puddles on the ground.\n"+
                "The sound of dripping water sounds now less distant.\n"+
                "A white sign is hanging on the northern wall.\n";
	items = allocate(2);
	items[0] = "sign";
	items[1] = "'Dark dweller city. Stay away!'";
 	add_exit("north", "/wizards/rimber/cave/room7.lpc");
        add_exit("east", "/wizards/rimber/cave/room6b.lpc");
	add_exit("west", "/wizards/rimber/cave/room4.lpc");
 set_not_out(1);
}
