mixed id(mixed str) { return str == "stone"; }
mixed short() { return "A small stone"; }
mixed long(mixed str) {
 write("This stone looks just like an ordinary stone, but it feels\n"+
  "warm to the touch. Cold vibrations pass through your body\n"+
  "as you hold the stone in your hand\n");
 return;
}
mixed get() { return 1; }
