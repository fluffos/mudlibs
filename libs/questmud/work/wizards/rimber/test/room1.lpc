inherit "room/room";

mixed reset(mixed arg) {
 if(arg) return;
 set_light(3);
 set_not_out(1);
 short_desc = "Test room";
 long_desc = "This is where Rimber tests something sometimes.\n";
 add_exit("west", "/wizards/rimber/test/room2.lpc");
 add_exit("cs", "/wizards/rimber/workroom.lpc");
}

mixed init() {
 ::init();
 add_action("kutsu", "kutsu");
}

mixed kutsu(mixed str) {
 object dreik;
 if(str != "dragon") return 0;
 dreik = clone_object("/wizards/rimber/test/dragon.lpc");
 dreik->move_object(this_object());
 say("Dragon booms: 'Yes master?'\n");
}
