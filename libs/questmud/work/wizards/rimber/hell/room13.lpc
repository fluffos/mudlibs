inherit "room/room";
object mosa, mosa1;
string DIR = "/wizards/rimber/hell/";

mixed reset(mixed arg) {
 if(!mosa) {
 mosa = clone_object("/wizards/rimber/hell/mobs/demon.lpc");
 mosa->move_object(this_object());
 }
 if(!mosa1) {
 mosa1 = clone_object("/wizards/rimber/hell/mobs/demon.lpc");
 mosa1->move_object(this_object());
 } 
 if(arg) return;
 set_light(3);
 set_not_out(1);
 short_desc = "Highway to hell";
 long_desc = "A wide path from south to north. Lava flows slowly on both sides of the path.\n";
 add_exit("north", DIR+"room14.lpc");
 add_exit("up", DIR+"room10.lpc");
}
