inherit "room/door";
inherit "room/room";
object mosa;

mixed reset(mixed arg) {
 if(!mosa) {
 mosa = clone_object("/wizards/rimber/hell/mobs/cerberos.lpc");
 mosa->move_object(this_object());
 }
 if(arg) return;
 door_reset();
 set_light(3);
 set_door_label("A massive iron door", 1);
 set_door_dir("north", "/wizards/rimber/hell/room1.lpc", 1);
 set_door_code("666", 1);
 set_locked(1, 1);
 short_desc = "At the gates of the hell";
 long_desc = "A huge iron gate lies before you.\n";
 add_exit("out", "/wizards/rimber/cloudc/land.lpc");
 set_door_link("/wizards/rimber/hell/room1.lpc", 1);
}

mixed init() {
 ::init();
 door_init();
}
