inherit "room/room";  



mixed reset(mixed arg) {

  add_exit("west","/wizards/irmeli/area3/ruum55.lpc");

  add_exit("east","/wizards/irmeli/area3/ruum53.lpc");

  set_not_out(1);



  short_desc = "Decorated aisle in the huge temple";

  long_desc = "You are walking in beatifully decorated aisle leading deeper into temple.\n"+

                "Walls has painted with white paint and therefore they look like just\n"+

                "painted. Floor is slippery because it's made from marble.\n";

}





