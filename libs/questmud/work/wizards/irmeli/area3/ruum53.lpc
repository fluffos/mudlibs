inherit "room/room";

object monster;



mixed reset(mixed arg) {

  if(!present("mummy")) {

    clone_object("/wizards/irmeli/area3/mummy.lpc")->move_object(this_object());

}

 

  if(arg) return;

 

  add_exit("west","/wizards/irmeli/area3/ruum54.lpc");

  add_exit("east","/wizards/irmeli/area3/ruum57.lpc");

  add_exit("north","/wizards/irmeli/area3/ruum60.lpc");

  add_exit("down","/wizards/irmeli/area3/ruum52.lpc");

  set_not_out(1);



  short_desc = "Central hall in the huge temple";

  long_desc = "Welcome to the central hall in this huge and beatiful temple. This temple\n"+

                "has made hundreds years ago with old-fashion way. There is a big cross\n"+

                "on the wall remembering you from the suffer of jesus.\n";

}



