inherit "room/room";

object monster;



mixed reset(mixed arg) {

  if(!present("mummy")) {

    clone_object("/wizards/irmeli/area3/mummy.lpc")->move_object(this_object());

}

 

  if(arg) return;

 

  add_exit("west","/wizards/irmeli/area3/ruum56.lpc");

  add_exit("east","/wizards/irmeli/area3/ruum54.lpc");

  set_not_out(1);



  short_desc = "Low aisle deep in the huge temple";

  long_desc = "This aisle is lower than the earlier one probably because it's leading you\n"+

                "back under the ground. There are some paintings hanging from the wall\n"+

                "trying to make this aisle more domestic.\n";

}



