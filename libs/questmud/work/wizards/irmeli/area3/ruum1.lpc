inherit "room/room";

mixed reset(mixed arg) {
  add_exit("west","/wizards/irmeli/area3/ruum2.lpc");
  add_exit("out","/wizards/irmeli/workroom.lpc");

  short_desc = "Huge graveyard";
  long_desc = "You have arrived into huge graveyard which is middle in nowhere. You can\n"+
                "smell the rotten corpses which are lying in the graves. The air is\n"+
                "getting thick with mist.\n";
}






