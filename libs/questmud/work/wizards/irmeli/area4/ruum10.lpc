inherit "room/room";

object monster;



mixed reset(mixed arg) {

  if(!present("gremlin 2")) { 

    clone_object("/wizards/irmeli/area4/gremlin2.lpc")->move_object(this_object());

    clone_object("/wizards/irmeli/area4/gremlin2.lpc")->move_object(this_object());

}  



  if(arg) return;



  add_exit("east","/wizards/irmeli/area4/ruum18.lpc");

  add_exit("west","/wizards/irmeli/area4/ruum9.lpc");

  add_exit("northwest","/wizards/irmeli/area4/ruum16.lpc");

  add_exit("northeast","/wizards/irmeli/area4/ruum15.lpc");

  add_exit("southwest","/wizards/irmeli/area4/ruum11.lpc");

  add_exit("southeast","/wizards/irmeli/area4/ruum12.lpc");

  set_not_out(1);



  short_desc = "Inside the Dungeons of Orthanc, tower of death";

  long_desc = "A huge hall opens in front of your eyes making you amazed by handwork. You\n"+

                "can image how hard work it has been building this hall. There are two\n"+

                "cages builded in the ground under your feets. The mightiest prisoners\n"+   

                "were held there until they died.\n";

}





