inherit "room/room";

object monster;



mixed reset(mixed arg) {

  if(!present("gremlin")) { 

    clone_object("/wizards/irmeli/area4/gremlin4.lpc")->move_object(this_object());

}  



  if(arg) return;



  add_exit("east","/wizards/irmeli/area4/ruum31.lpc");

  add_exit("west","/wizards/irmeli/area4/ruum27.lpc");

  set_not_out(1);



  short_desc = "Floor three inside the Orthanc, tower of death";

  long_desc = "A small corridor leading you to the eastern-wing in floor three. This long\n"+

                "corridor is builded about thirty feets above the surface of the earth.\n"+

                "You can feel the wind raping the outwalls with ultimate power and\n"+

                "making this tower wobble a bit.\n";

}

