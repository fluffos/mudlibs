inherit "room/room";  
object monster;


mixed reset(mixed arg) {
  if(!present("guard 2")) {
    clone_object("/wizards/irmeli/area4/guard1.lpc")->move_object(this_object());
    clone_object("/wizards/irmeli/area4/guard1.lpc")->move_object(this_object());
}

if(arg) return;

  add_exit("west","/wizards/irmeli/area4/ruum4.lpc");

  add_exit("east","/wizards/irmeli/area4/ruum6.lpc");

  add_exit("up","/wizards/irmeli/area4/ruum20.lpc");

  add_exit("south","/wizards/irmeli/area4/ruum2.lpc");

  set_not_out(1);



  short_desc = "Inside the Orthanc, tower of death";

  long_desc = "A big hall opens in front of your eyes making you amazed with beaty. This\n"+

                "hall is smaller than the earlier main hall in this tower but this is\n"+

                "more domestic and beatiful. A small window on the northern wall\n"+

                "brings a small amount of light in here.\n";

}

