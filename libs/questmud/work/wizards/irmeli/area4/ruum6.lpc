inherit "room/room";  



mixed reset(mixed arg) {

  add_exit("east","/wizards/irmeli/area4/ruum7.lpc");

  add_exit("west","/wizards/irmeli/area4/ruum3.lpc");

  set_not_out(1);



  short_desc = "Inside the Orthanc, tower of death";

  long_desc = "A small corridor leading you to the eastern-wing of this tower. You notice\n"+

                "that this corridor is leading you a bit down meaby under the surface of\n"+

                "the earth. There is some dirty clothes lying on the floor.\n";

}               

