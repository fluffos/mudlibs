inherit "room/room";
object monster;
  int i;
mixed reset(mixed arg) {
  if(arg) return;
  i = (random(3) +1);
  if(i == 3)  {
  if(!present("lord")) {
    clone_object("/wizards/irmeli/castle/monsters/lord.lpc")->move_object(this_object());
  }
}
else clone_object("/wizards/ahma/misc/sculpture.lpc")->move_object(this_object());

  add_exit("down", "/wizards/irmeli/castle/etower3.lpc");

 short_desc = "On the top of the east tower";
  long_desc = "An incomprehensibly beautiful view opens from the top of the east tower. You\n"+
              "can see the blue sea, the valley, the city and the graveyard from here. The\n"+
              "tower is about fifty meters high. The west tower of the castle is westwards.\n"+
              "A safety fence is built around the roof. A huge fireplace is in the middle of\n"+
              "the roof. It rises a thick smoke screen to the sky. The spiral stairs are\n"+
              "leading down from the southwest corner of the roof. A cold wind is blowing\n"+
              "here.\n";

   set_light(4);

   items = allocate(6);
   items[0] = "safety fence";
   items[1] = "It goes around the roof.";
   items[2] = "stairs";
   items[3] = "The spiral stairs are leading down from the southwest corner.";
   items[4] = "fireplace";
   items[5] = "It's placed in the middle of the roof. Thick smoke screen rises to the sky from it.";

  property = allocate(2);
  property[0] = "no_summon";
  property[1] = "no_tele";
}

