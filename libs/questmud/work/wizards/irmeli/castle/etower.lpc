inherit "room/room";
object monster;


mixed reset(mixed arg) {
  if(arg) return;
  if(!present("knight")) { 
    clone_object("/wizards/irmeli/castle/monsters/towerknight1.lpc")->move_object(this_object());
}


  add_exit("stairs", "/wizards/irmeli/castle/etower1.lpc");
  add_exit("out", "/wizards/irmeli/castle/yard21.lpc");
 
 short_desc = "Inside of the east tower of castle Asgroth";
  long_desc = "The east tower is gloomy from inside. The dusty floor is made of wood. There\n"+
              "are spiral stairs leading up to the darkness. The stairs are made of iron and\n"+
              "they seem to be quite stable. Few torches are burning on the walls of the tower.\n"+
              "Spider webs are hanging from the walls. It seems that the east tower isn't in\n"+
              "use anymore. There are no windows on the walls.\n";

   set_not_out(1);
   set_light(4);

   items = allocate(6);
   items[0] = "torches";
   items[1] = "Few torches are burning on the walls.";
   items[2] = "stairs";
   items[3] = "Stairs made of iron. Shaped as spiral.";
   items[4] = "spider webs";
   items[5] = "The spider webs are covering the walls.";

  property = allocate(2);
  property[0] = "no_summon";
  property[1] = "no_tele";
}


