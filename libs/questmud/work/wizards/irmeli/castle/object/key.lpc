inherit "room/key";

mixed id(mixed str) { if (str == "key") return 1; }

mixed short() { return "A black key"; }

mixed long() { write("The key is black. It's bigger than the usual keys.\n"); }

mixed reset() {
  set_door_file("/wizards/irmeli/castle/well.lpc");

set_key_code("447");
}


mixed get() { return 1; }

