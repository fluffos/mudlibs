inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("hobbit 2")) { 
    clone_object("/wizards/irmeli/area2/hobbit6.lpc")->move_object(this_object());
    clone_object("/wizards/irmeli/area2/hobbit6.lpc")->move_object(this_object());
}  

  if(arg) return;

  add_exit("west","/wizards/irmeli/area2/ruum24.lpc");
  add_exit("east","/wizards/irmeli/area2/ruum25.lpc");
  add_exit("south","/wizards/irmeli/area2/ruum26.lpc");
  add_exit("up","/wizards/irmeli/area2/ruum15.lpc");
  set_not_out(1);
  
  short_desc = "Central gallery in the bottom level";
  long_desc = "You are now in the bottom level. This level is about hundred meters below\n"+
                "surface of the earth. It is freezing in this level. Some icicles are\n"+
                "hanging from the wall.\n";   
}


