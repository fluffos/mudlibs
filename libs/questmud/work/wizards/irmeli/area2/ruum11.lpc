inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("hobbit 2")) { 
    clone_object("/wizards/irmeli/area2/hobbit2.lpc")->move_object(this_object());
    clone_object("/wizards/irmeli/area2/hobbit2.lpc")->move_object(this_object());
}  

  if(arg) return;

  add_exit("north","/wizards/irmeli/area2/ruum10.lpc");
  set_not_out(1);
  
  short_desc = "Dead end";
  long_desc = "This tiny gallery collapsed totally in the explosion. They never\n"+
                "finished building it after that. There are a few picks and\n"+
                "shovels on the ground.\n";   
 }
