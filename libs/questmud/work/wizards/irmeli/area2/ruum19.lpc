inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("hobbit 2")) { 
    clone_object("/wizards/irmeli/area2/hobbit5.lpc")->move_object(this_object());
    clone_object("/wizards/irmeli/area2/hobbit5.lpc")->move_object(this_object());
}  

  if(arg) return;

  add_exit("south","/wizards/irmeli/area2/ruum18.lpc");
  set_not_out(1);
  
  short_desc = "Small storeroom for foods";
  long_desc = "This small storeroom was built here for storing food for miners. There are two\n"+
                "shelfs in the rear of room. Few boxes are lying on the floor waiting someone\n"+
                "to pick them up.\n";    
}


