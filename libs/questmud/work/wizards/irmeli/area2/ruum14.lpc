inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("hobbit 2")) { 
    clone_object("/wizards/irmeli/area2/hobbit2.lpc")->move_object(this_object());
    clone_object("/wizards/irmeli/area2/hobbit2.lpc")->move_object(this_object());
}  

  if(arg) return;

  add_exit("north","/wizards/irmeli/area2/ruum13.lpc");
  set_not_out(1);
  
  short_desc = "Dead end";
  long_desc = "Here has been a strong explosion because the roof and wall has collapsed.\n"+
                "It looks like somebody repaired this gallery a bit but not enough.\n"+
                "There are huge cracks on the ground.\n";   
 }
