inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("angel 2")) { 
    clone_object("/wizards/irmeli/pena/angelfig2.lpc")->move_object(this_object());
    clone_object("/wizards/irmeli/pena/angelfig2.lpc")->move_object(this_object());
}
  
  if(arg) return;

  add_exit("south","/wizards/irmeli/pena/ruum13.lpc");
  add_exit("east","/wizards/irmeli/pena/ruum11.lpc");
  set_not_out(1);

  short_desc = "Small corridor leading you deeper in darkness";
  long_desc = "This is a small corridor leading you down under the surface. You notice\n"+
                "that the floor is covered by water. The walls are all over covered with\n"+
                "something green and slimy.\n";   
}


