inherit "room/room";

mixed reset(mixed arg) {
  add_exit("south","/wizards/irmeli/pena/ruum33.lpc");
  add_exit("north","/wizards/irmeli/pena/ruum23.lpc");
  add_exit("west","/wizards/irmeli/pena/ruum20.lpc");
  add_exit("east","/wizards/irmeli/pena/ruum21.lpc");
  add_exit("northwest","/wizards/irmeli/pena/ruum22.lpc");
  add_exit("northeast","/wizards/irmeli/pena/ruum24.lpc");
 
  short_desc = "Huge field in the Valley of Angels";
  long_desc = "You have arrived to the begin of huge field. The ground is muddy and sandy.\n"+
                "There is some footprints left to the mud. Old corn or something like\n"+
                "that is smelling here.\n";   
}


