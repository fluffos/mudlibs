inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("angel 2")) { 
    clone_object("/wizards/irmeli/pena/angelfig2.lpc")->move_object(this_object());
    clone_object("/wizards/irmeli/pena/angelfig2.lpc")->move_object(this_object());
}
  
  if(arg) return;

  add_exit("west","/wizards/irmeli/pena/ruum6.lpc");
  add_exit("east","/wizards/irmeli/pena/ruum7.lpc");
  add_exit("hole","/wizards/irmeli/pena/ruum9.lpc");
  add_exit("north","/wizards/irmeli/pena/ruum33.lpc");
  
  short_desc = "Small hill in the Valley of Angels";
  long_desc = "You are standing on a small hill. There is a small hole under your feets.\n"+
                "If you are small you might try to get in hole. You can hear noises\n"+
                "coming from hole.\n";   
}


