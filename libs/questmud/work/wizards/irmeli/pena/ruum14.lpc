inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("angel 2")) { 
    clone_object("/wizards/irmeli/pena/angelfig3.lpc")->move_object(this_object());
    clone_object("/wizards/irmeli/pena/angelfig3.lpc")->move_object(this_object());
}
  
  if(arg) return;

  add_exit("south","/wizards/irmeli/pena/ruum15.lpc");
  add_exit("north","/wizards/irmeli/pena/ruum13.lpc");
  set_not_out(1);

  short_desc = "Tiny corridor inside solid rock";
  long_desc = "This is a tiny corridor inside solid rock. Some dark figures are flying\n"+
                "above you. There are lots of corpses and blood on the floor.\n";
                   
}


