inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("angel")) { 
    clone_object("/wizards/irmeli/pena/angelfig4.lpc")->move_object(this_object());
}
  
  if(arg) return;

  add_exit("north","/wizards/irmeli/pena/ruum24.lpc");
  add_exit("west","/wizards/irmeli/pena/ruum10.lpc");
  add_exit("northwest","/wizards/irmeli/pena/ruum23.lpc");
 
  short_desc = "Huge field in the Valley of Angels";
  long_desc = "You are walking on the huge field. The ground is wet and when you step\n"+
                "on the mud you can see your footprints on it. Old corn is smelling\n"+
                "strongly here.\n";   
}


