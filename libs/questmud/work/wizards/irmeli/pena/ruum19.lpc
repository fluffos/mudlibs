inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("crow")) { 
    clone_object("/wizards/irmeli/pena/crow.lpc")->move_object(this_object());
}
  
  if(arg) return;

  add_exit("up","/wizards/irmeli/pena/ruum18.lpc");
  set_not_out(1);

  short_desc = "Room of the royal Crow";
  long_desc = "This is a huge room where the evil crow lives. The floor is made from gold.\n"+
                "There is lying lots of well-eaten corpses of humans and angels on the\n"+
                "golden floor.\n"; 
}

