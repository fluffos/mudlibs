inherit "room/room";
object monster;

mixed reset(mixed arg) {
  if(!present("angel 2")) { 
    clone_object("/wizards/irmeli/pena/angelfig3.lpc")->move_object(this_object());
    clone_object("/wizards/irmeli/pena/angelfig3.lpc")->move_object(this_object());
}
  
  if(arg) return;

  add_exit("east","/wizards/irmeli/pena/ruum16.lpc");
  add_exit("north","/wizards/irmeli/pena/ruum14.lpc");
  set_not_out(1);

  short_desc = "Tiny corridor inside a solid rock";
  long_desc = "This is a tiny corridor inside a solid rock. Some dark figures are moving\n"+
                "in the corner. There are few bones lying on the floor.\n";
}


