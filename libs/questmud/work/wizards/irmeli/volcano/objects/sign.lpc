mixed short() { return "A wooden sign"; }

mixed long() {
  write("\n");
  write("        WARNING!! DON'T GO INSIDE THE VOLCANO!! WARNING!!\n");
  write("\n");
  write("There are dangerous gases hovering inside the volcano.\n");
  write("The volcano may erupt.\n");
  write("\n");
  write("                                         The earlier adventurers.\n");
}

mixed id(mixed str) { return str == "sign"; }

 
