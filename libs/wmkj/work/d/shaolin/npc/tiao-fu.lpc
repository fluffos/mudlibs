// seller.c
inherit BHNPC;
string query_save_file() { return DATA_DIR + "npc/挑夫"; }
void create() {
  set_name("挑夫", ({ "tiao fu", "porter" }));
  this_object()->init_bhnpc();
  set("area_name", "暗江行");
  set("area_file", "/d/shaolin/npc/tiao-fu.lpc");
  set("ziyuan", "担子");
  set("jizhi", 65);
  set("kaifa", 40);
  set("gender", "男性");
  set("age", 28);
  set("long",
    "这是个老实巴交的穷挑夫，长得膀阔腰圆，一身肌肉。\n");
  //  set("shen_type", 1);
  set("combat_exp", 1000);
  set("str", 25);
  set("dex", 22);
  set("con", 20);
  set("int", 15);
  set("attitude", "heroism");
  setup();
  carry_object("clone/misc/cloth")->wear();
}
#include <die.h>
