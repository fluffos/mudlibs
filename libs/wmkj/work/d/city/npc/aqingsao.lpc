// aqingsao.c 阿庆嫂
inherit BHNPC;
//inherit F_VENDOR;
//inherit F_DEALER;
inherit F_BVENDOR;
string query_save_file() { return DATA_DIR + "npc/阿庆嫂"; }
void create() {
  set_name("阿庆嫂", ({ "aqing sao", "aqing", "sao" }));
  set("title", "茶馆老板娘");
  this_object()->init_bhnpc();
  set("area_name", "扬州茶馆");
  set("area_file", "/d/city/chaguan");
  set("kaifa", 38);
  set("jizhi", 46);
  set("ziyuan", "茶叶");
  set("nickname", "扬州一支花");
  set("shen_type", 1);
  set("str", 30);
  set("gender", "女性");
  set("age", 25);
  set("long",
    "阿庆嫂是扬州城里有名的大美人，因为爷儿们总喜欢往她这儿逛，\n"
    "所以她对城里的一举一动都了如执掌。\n");
  set("combat_exp", 500);
  set("attitude", "friendly");
  set("inquiry", ([
    "阿庆": "我们家阿庆去北边做生意去了耶。\n",
    "生意": "这个么……。\n",
  ]));

  set("vendor_goods", ([
    "peanut": __DIR__ "obj/peanut",
    "tofu": __DIR__ "obj/tofu",
    "xiandan": "/clone/food/xiandan",
    "chahu": __DIR__ "obj/chahu",
  ]));
  setup();
  carry_object("/clone/misc/hiw_cloth")->wear();
}
void init() {
  object ob, owner;
  string nature;
  nature = NATURE_D->room_event_fun();
  owner = this_object();
  ::init();
  if (base_name(environment()) != query("startroom")) return;
  if (interactive(ob = this_player()) && !is_fighting()) {
    if (nature != "event_dawn"
      && nature != "event_night"
      && nature != "event_midnight") {
      remove_call_out("greeting");
      call_out("greeting", 1, ob);
    } else owner->command("zzz " + owner->query("id"));
  }
  add_action("do_vendor_list", "list");
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment())
    return;
  switch (random(2)) {
    case 0:
      say("阿庆嫂笑眯眯地说道：这位" + RANK_D->query_respect(ob) +
        "，快请进来喝杯热茶。\n");
      break;
    case 1:
      say("阿庆嫂说道：哟！这位" + RANK_D->query_respect(ob) +
        "您来了啊！本店有刚炸好的五香花生出售。\n");
      break;
  }
}

#include <die.h>
