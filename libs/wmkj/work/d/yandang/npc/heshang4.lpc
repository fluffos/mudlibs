inherit BHNPC;

string query_save_file() { return DATA_DIR + "npc/晦明"; }
void create() {
  set_name("晦明", ({ "hui ming", "hui" }));
  this_object()->init_bhnpc();
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/std/armor/pijia")->wear();
  carry_object("/obj/weapon/sword")->wield();
}
void init() {
  ::init();
  command("guard up");
}
