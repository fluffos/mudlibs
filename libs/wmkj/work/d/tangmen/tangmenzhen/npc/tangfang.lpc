inherit NPC;
inherit F_MASTER;
int carry_qian();

void create() {
  set_name("唐方", ({ "tang fang", "tang" }));
  set("nickname", "");
  set("long",
    "唐门中最飘忽的子弟，唐大之妹，唐尧舜之女，深得唐老太太的欢爱。\n");
  set("gender", "女性");
  set("age", 25);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 20);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("max_qi", 5000);
  set("max_jingli", 1000);
  set("max_douzhi", 300);
  set("douzhi", 300);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 100);
  set("combat_exp", 500000);
  set("shen", 1000);
  set("score", 7000);

  set_skill("force", 150);
  set_skill("throwing", 150);
  set_skill("dodge", 1520);
  set_skill("parry", 150);
  set_skill("tao", 120);
  set_skill("hand", 150);
  set_skill("literare", 120);
  set_skill("boyun-suowu", 150);
  set_skill("tangmen-xinfa", 150);
  set_skill("feiyan-zong", 150);
  set_skill("tangmen-jueqi", 100);
  set_skill("tangmen-throwing", 150);

  map_skill("force", "tangmen-xinfa");
  map_skill("dodge", "feiyan-zong");
  map_skill("parry", "tangmen-throwing");
  map_skill("hand", "boyun-suowu");

  prepare_skill("hand", "boyun-suowu");

  set("chat_chance", 20);
  set("chat_msg", ({
    "我的萧哥哥到哪儿去，到现在还不来看我！\n",
    ( : command("shy") : ),
    ( : command("sigh") : ),
    ( : command("drop qianqian") : ),
    ( : command("wield all") : ),
    ( : command("drop qianqian") : ),
  }));

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    ( : command("yun recover") : ),
    ( : command("yun recover") : ),
    ( : carry_qian: ),
    ( : carry_qian: ),
    ( : command("use qian") : ),
    ( : command("use qian") : ),
    ( : command("wield all") : ),
    ( : command("wield all") : ),
  }));

  set("inquiry", ([
    "千千镖": "问问老太太去啊！\n",
    "千千": "问问老太太去啊！\n",
  ]));
  create_family("四川唐门", 3, "弟子");

  setup();
  carry_object("/d/tangmen/tangmenzhen/obj/mcloth")->wear();
  carry_object("/d/tangmen/tangmenzhen/obj/mshoe")->wear();
  carry_object("/d/tangmen/tangmenzhen/obj/qinglianzi")->wield();
  carry_object("/d/tangmen/tangmenzhen/obj/qinglianzi")->wield();
  carry_object("/d/tangmen/tangmenzhen/obj/feidao")->wield();
  carry_object("/d/tangmen/tangmenzhen/obj/jili")->wield();
}

void attempt_apprentice(object ob) {
  if (ob->query("family/family_name") != "四川唐门") {
    command("say “我四川唐门乃是武林世家，你已是武林中人，我不能收你为徒！”\n");
    return;
  }
  if (ob->query("combat_exp") < 500000) {
    command("say “你的经验太少了。”\n");
    return;
  }
  if (ob->query("gender") != "女性") {
    command("say “你还是到我大哥那边去吧，我只收女弟子的！”\n");
    return;
  }
  if (ob->query_skill("tangmen-xinfa") < 80 && ob->query_skill("tangmen-throwing") < 80) {
    command("say “你的心法和暗器不太熟练，要加油啊！”\n");
    return;
  }

  command("say “好吧，从今天起你就是唐门的弟子了。”\n");
  command("recruit " + ob->query("id"));


}

int carry_qian() {
  object ob;

  ob = new("/kungfu/class/tangmen/obj/qianqian.lpc");
  ob->move(this_object());
  return 1;
}
