inherit NPC;
#include <ansi.h>;
string ask_tanghua();

void create() {
  set_name("唐肥", ({ "tang fei", "tang" }));
  set("nickname", HIC "我也不知道" NOR);
  set("long",
    "唐门三绝之一，名列唐门一流高手之中，其使有的暗器“唐花”是唐门绝门暗器之一。\n");
  set("gender", "女性");
  set("age", 28);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 26);
  set("int", 26);
  set("con", 24);
  set("dex", 23);
  set("max_qi", 7000);
  set("max_jingli", 1400);
  set("max_douzhi", 450);
  set("douzhi", 450);
  set("neili", 3500);
  set("max_neili", 3500);
  set("yanli", 200);
  set("jiali", 100);
  set("combat_exp", 750000);
  set("score", 7000);

  set_skill("force", 150);
  set_skill("throwing", 150);
  set_skill("dodge", 150);
  set_skill("literate", 120);
  set_skill("parry", 150);
  set_skill("tao", 150);
  set_skill("hand", 150);
  set_skill("boyun-suowu", 150);
  set_skill("tangmen-xinfa", 150);
  set_skill("tangmen-jueqi", 150);
  set_skill("feiyan-zong", 150);
  set_skill("tangmen-throwing", 150);

  map_skill("force", "tangmen-xinfa");
  map_skill("dodge", "feiyan-zong");
  map_skill("parry", "tangmen-throwing");
  map_skill("hand", "boyun-suowu");

  prepare_skill("hand", "boyun-suowu");

  set("chat_chance", 5);
  set("chat_msg", ({
    ( : command("dazuo 100") : ),
    ( : command("tuna 40") : ),
    ( : command("yun heal") : ),
  }));
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    ( : command("yun recover") : ),
    ( : command("yun recover") : ),
    ( : command("use hua") : ),
    ( : command("use hua") : ),
  }));

  set("inquiry", ([
    "唐花": ( : ask_tanghua: ),
    "tanghua": ( : ask_tanghua: ),
  ]));

  create_family("四川唐门", 3, "弟子");


  setup();
  carry_object("/d/tangmen/tangmenzhen/obj/mcloth")->wear();
  carry_object("/d/tangmen/tangmenzhen/obj/mshoe")->wear();
  carry_object("/d/tangmen/tangmenzhen/obj/qinglianzi")->wield();
  carry_object("/d/tangmen/tangmenzhen/obj/qinglianzi")->wield();
  carry_object("/kungfu/class/tangmen/obj/tanghua")->wield();

}

string ask_tanghua() {
  object me, ob, her;

  me = this_player();
  her = this_object();

  if (!me->query_temp("thua2")) {
    command("laugh " + me->query("id"));
    return HIC "你以为我有啊！我还要找人要呢！\n" NOR;
  }

  if (me->query("family/family_name") != "四川唐门") {
    command("hmm " + me->query("id"));
    her->kill_ob(me);
    return HIR "又是一个不要命的,哈哈......\n" NOR;
  }

  command("addoil " + me->query("id"));
  command("pat " + me->qurey("id"));
  command("say “好吧，这就是唐花，给你了。” \n");
  ob = new("/kungfu/class/tangmen/obj/tanghua");
  ob->move(me);
  message(
    "channel:chat",
    HIR "【小道消息】" HIC " 哇..." + me->query("name") + "找到了" HIG "唐花" HIC "了！\n" NOR,
    users()
  );
  return "好吧！\n";
}
