inherit NPC;
string ask_for_meirong();
void create() {
  set_name("叶玲珑", ({ "ye linglong", "ye", "linglong" }));
  set("gender", "女性");
  set("age", 35 + random(3));
  set("attitude", "friendly");
  set("meirong/count", 1);
  set("inquiry", ([
    "美容": (: ask_for_meirong :),
  ]));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
void init() {
  add_action("do_yuanyi", "yuanyi");
}
string ask_for_meirong() {
  object me;
  me = this_player();
  if (me->query("have_meirong") >= 5)
    return "再美容你的脸恐怕就要烂了，我可不想砸了自己的招牌，你还是回去吧。\n";
  if (me->query_temp("ask_meirong", 1))
    return "你到底愿意(yuanyi)不愿意啊？\n";
  if (this_object()->query("meirong/count") < 1)
    return "我刚给人美了容，正累着呢！你一会儿再来吧。\n";
  if ((int)me->query_per("") <= 10)
    return "你先天如此，不能改了。\n";
  if ((int)me->query_per("") >= 30)
    return "你已经是标准的美人了，还要美容作什么？\n";
  me->set_temp("ask_meirong", 1);
  return "小女子也不能是每次都能成功的，你愿意(yuanyi)继续吗？\n";
}
int do_yuanyi() {
  object me = this_player();
  if (!me->query_temp("ask_meirong")) return 0;
  me->delete_temp("ask_meirong");
  me->set_temp("have_yuanyi", 1);
  if (!me->query("have_meirong")) {
    write("叶玲珑说道：请交１０００两黄金的美容费。\n");
    me->set_temp("jiaofei", 1000);
    return 1;
  }
  switch (me->query("have_meirong")) {
    case 1: write("叶玲珑说道：你已经美过一次容了，请交１５００两黄金的美容费。\n");
    me->set_temp("jiaofei", 1500);
    return 1;
    case 2: write("叶玲珑说道：你已经美过两次容了，请交２０００两黄金的美容费。\n");
    me->set_temp("jiaofei", 2000);
    return 1;
    case 3: write("叶玲珑说道：你已经美过三次容了，请交２５００两黄金的美容费。\n");
    me->set_temp("jiaofei", 2500);
    return 1;
    case 4: write("叶玲珑说道：这是你最后一次美容了，请交３０００两黄金的美容费。\n");
    me->set_temp("jiaofei", 3000);
    return 1;
    case 5: write("叶玲珑说道：再美容你的脸恐怕就要烂了，我可不想砸了自己的招牌，你还是回去吧。\n");
    return 1;
  }
}
int accept_object(object me, object ob) {
  int rongmao;
  if (!me->query_temp("have_yuanyi")) {
    write("叶玲珑说道：无功不受禄。这位" + RANK_D->query_respect(me) + "此举不知是何用意？\n");
    return 0;
  }
  if (ob->query("money_id") && ob->value() < me->query_temp("jiaofei") * 10000) {
    write("叶玲珑说道：就这么点钱你还想美容？\n");
    return 0;
  }
  write("叶玲珑说道：你先躺下来。\n");
  message_vision("叶玲珑把一块毛巾盖在$N的脸上，$N慢慢进入了梦乡。\n", me);
  message_vision("只听见一阵叮叮当当的响声，$N的脸容慢慢的改变了。\n", me);
  rongmao = random(4) - 1;
  me->add("per", rongmao);
  command("hehe");
  me->unconcious();
  me->delete_temp("have_yuanyi");
  if (!me->query("have_meirong")) me->set("have_meirong", 1);
  else me->add("have_meirong", 1);
  add("meirong/count", -1);
  return 1;
}
