string query_save_file() {
  return ADVERSE;
}
void setup() {
  restore();
}
void recover() {
  int i, j;
  string *name;
  name = keys(adverse);
  for (i = 0; i < sizeof(name); i++) {
    for (j = 0; j < sizeof(name); j++) {
      adverse[name[i]][name[j]] -= (adverse[name[i]][name[j]] - src_adv[name[i]][name[j]]) / 100;
    }
  }
  save();
}
int change_adverse(string src, string dest, int fee) {
  if (!src || !dest) return 0;
  if (undefinedp(adverse[src]) || undefinedp(adverse[dest])) return 0;
  adverse[src][dest] += fee;
  save();
  return adverse[src][dest];
}
//查询src门派对dest门派的敌对程度
int query_adverse(string src, string dest) {
  if (undefinedp(adverse[src]) || undefinedp(adverse[dest])) return 0;
  return adverse[src][dest];
}
//killer杀victim发生时敌对程度改变
int kill_adverse(string killer, string victim) {
  int i;
  string *name;
  name = keys(adverse);
  if (!stringp(killer) || !stringp(victim)) return 0;
  if (undefinedp(adverse[killer]) || undefinedp(adverse[victim])) return 0;
  adverse[victim][killer] += 20;
  adverse[killer][victim] -= 20;
  for (i = 0; i < sizeof(adverse); i++) {
    if (name[i] == killer) continue;
    if (name[i] == victim) continue;
    adverse[name[i]][killer] -= adverse[name[i]][victim] / 100;
    adverse[victim][name[i]] -= adverse[killer][name[i]] / 100;
  }
  save();
  return 1;
}
