#pragma save_binary
// cast.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string spells, spl, trg, file;
  object target;

  seteuid(getuid());

  if (arg && arg == "cancel") {
    if (!me->query_temp("execration")) {
      write("你现在没有施放魔法\n");
      return 1;
    }
    me->set_temp("cast_cancel", 1);
    //这里给玩家身上设置一个标记,为了给/std/magic.c发一个可以终止魔法的信息
    write("ok\n");
    return 1;

  }  //魔法师可以随时终止施法
  if (me->is_busy())
    return notify_fail("( 你上一个动作还没有完成，不能念咒语。)\n");
  if (environment(me)->query("no_magic")
    || environment(me)->query("no_kill")
    || environment(me)->query("no_fight"))
    return notify_fail("这里不准念咒语。\n");

  if (!arg) return notify_fail("指令格式：cast <魔法> on <目标>\n");

  if (sscanf(arg, "%s on %s", spl, trg) == 2) {  //专门为天眼通所设
    target = present(trg, environment(me));
    if (!target) target = present(trg, me);
    if (!target) {  //使用天眼通必须和目标不在同一个房间
      if (spl == "chairvoyance") {
        target = find_living(trg);
        if (!target || target->query_temp("netdead")) return notify_fail("找不到 " + trg + "。\n");
      } else return notify_fail("这里没有 " + trg + "。\n");
    }
    if (target->query_temp("netdead")) return notify_fail("你不能这样无耻的偷袭断线的人.\n");
  } else {
    spl = arg;
    target = 0;
  }
  if (sscanf(arg, "%s on %s", spl, trg) == 2) {
    if (userp(me) && userp(target) && target->query("mud_age") < 72000 && spl != "chairvoyance")
      return notify_fail("你连小孩子也要杀么?太心狠手辣了吧!\n");
    //if(!target->is_killing(me->query("id")))
    //       target->kill_ob(me);
  }
  if (stringp(spells = me->query_skill_mapped("magic"))) {
    return SKILL_D(spells)->cast_spell(me, spl, target);
  } else if (stringp(spells = me->query_skill_mapped("spells"))) {
    return SKILL_D(spells)->cast_spell(me, spl, target);
  } else {
    file = "/daemon/magicpool/" + spl;
    if (file_size(file) > 0) {
      return (int)call_other(file, "cast", me, target);
    } else return notify_fail("你不会任何魔法\n");
  }
}

int help(object me) {
  write(@HELP
指令格式：cast <魔法名称> [on <施法对象>]
         或者cast cancel
 使用魔法攻击生物时，你必需要指定<魔法名称>，<施法对象>则可有可无。 在
 念咒语的时候可以用cast cancel随时终止魔法.在你使用某一个魔法之前，你
 必须先用 enable 指令来指定你要使用的魔法类别。

注：如果你改变自己的魔法系系，你原本蓄积的法力并不能直接转换过去，必须
    从 0 开始。

HELP
  );
  return 1;
}
