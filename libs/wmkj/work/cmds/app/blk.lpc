// summon command..
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str) {
  object ob;
  int i;
  if (!str) return notify_fail("<Syntax>: blk <player id>\n");
  ob = LOGIN_D->find_body(str);
  if (!ob) return notify_fail("咦... 有这个人吗?\n");
  // moving
  tell_room(environment(ob), HIG "突然空中钻出一个吸尘器对准" +
    (string)ob->query("name") + "一吸, 然後不见了.\n" NOR, ob);
  tell_object(ob, "你眼前一阵黑....\n");
  ob->move("/u/xiha/blackroom");
  ob->set("huiguo", 1);
  ob->set("startroom", "/u/xiha/blackroom");
  tell_object(me, "你把" + (string)ob->query("name") + "送入悔过室。.\n");
  tell_object(ob, ".... 醒来时发现是" + (string)me->query("name") +
    "把你弄过来的.\n");
  ob->set("hgtt", (string)ob->query("title"));
  ob->set("title", HIR "悔过中..." NOR);
  tell_room(environment(ob), (string)ob->query("name") + "突然出现" +
    "在你眼前\n", ({ me, ob }));
  // ok ..
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : blk <某人>

此指令可让你(你)将某人送入空房间。
HELP
  );
  return 1;
}
