// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(GRN "水壶", ({ "shui hu", "hu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "用来盛水的家伙。\n");
    set("unit", "个");
    set("owner_name", HIB "岑其斯");
    set("owner_id", "qin qishi");
    set("task_object", 1);
  }
}
