// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(HIR "索命绳", ({ "suoming sheng", "sheng" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这个绳子向你头上一套，你可就。。。。\n");
    set("unit", "个");
    set("owner_name", HIC "金轮法王");
    set("owner_id", "jinlun fawang");
    set("task_object", 1);
  }
}
