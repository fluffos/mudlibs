// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(HIG "戒尺", ({ "jie chi", "chi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "用来执法的戒尺。\n");
    set("unit", "把");
    set("owner_name", HIW "道一禅师");
    set("owner_id", "daoyi chanshi");
    set("task_object", 1);
  }
}
