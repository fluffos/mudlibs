// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(HIG "精制鱼线", ({ "yu xian", "yuxian" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是杨州小贩的丢失的鱼线。\n");
    set("unit", "根");
    set("owner_name", GRN "小贩");
    set("owner_id", "xiaofan");
    set("task_object", 1);
  }
}
