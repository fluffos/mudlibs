// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(GRN "柳树枝", ({ "liushu zhi", "shizhi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这可是具有法力的树枝!\n");
    set("unit", "条");
    set("owner_name", HIW "青云");
    set("owner_id", "qing yun");
    set("task_object", 1);
  }
}
