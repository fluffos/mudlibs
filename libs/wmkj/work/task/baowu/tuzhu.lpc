// topkan@xhc
#include <ansi.h>
inherit ITEM;
#include "task.h"
void create() {
  set_name(HIY "土灵珠" NOR, ({ "tu lingzhu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("material", "crystal");
    set("value", 1);
    set("long", "传说中的五行宝珠之一，佩之可避石砸，并可发出土系
法术。");
    set("owner_id", "su xinghe");
    set("owner_name", HIC "苏星河");
    set("task_object", 1);
  }
  setup();
}
