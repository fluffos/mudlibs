// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(HIG "手巾", ({ "shou jin", "jin" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这块手斤可救人的命。\n");
    set("unit", "块");
    set("task_object", 1);
    set("owner_name", HIC "丁春秋");
    set("owner_id", "ding cunqiu");
  }
}
