// topkan@xhc
inherit ITEM;
#include <ansi.h>
#include "task.h"
void create() {
  set_name(HIY "木笛子", ({ "mu dizi", "dizi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "木笛子。\n");
    set("unit", "支");
    set("task_object", 1);
    set("owner_name", HIM "摘星子");
    set("owner_id", "zhai xingzi");
  }
}
