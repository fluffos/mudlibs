// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(HIG "虎皮帽", ({ "hupi mao", "mao" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "帽子。\n");
    set("unit", "个");
    set("task_object", 1);
    set("owner_name", HIB "陆高轩");
    set("owner_id", "lu gaoxuan");
  }
}
