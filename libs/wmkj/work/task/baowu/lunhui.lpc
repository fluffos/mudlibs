// topkan@xhc
inherit ITEM;
#include <ansi.h>
#include "task.h"
void create() {
  set_name(HIM "轮回棒", ({ "lunhui bang", "bang" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "轮回棒\n");
    set("unit", "条");
    set("task_object", 1);
    set("owner_name", HIC "段正淳");
    set("owner_id", "duan zhengchun");
  }
}
