// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(RED "弹珠", ({ "tan zhu", "zhu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "弹珠。\n");
    set("unit", "件");
    set("owner_name", HIM "逍遥子");
    set("owner_id", "xiaoyaozi");
    set("task_object", 1);
  }
}
