// topkan@xhc
#include <ansi.h>
inherit ITEM;
#include "task.h"
void create() {
  set_name(HIG "风灵珠" NOR, ({ "feng lingzhu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("material", "crystal");
    set("value", 1);
    set("long", "传说中的五行宝珠之一，佩之可避风吹，并可发出风系
法术。");
    set("task_object", 1);
    set("owner_id", "chen jinnan");
    set("owner_name", HIR "陈近南");
  }
  setup();
}
