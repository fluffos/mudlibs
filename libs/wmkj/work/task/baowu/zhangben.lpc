// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create() {
  set_name(RED "人皮账本", ({ "renpi zhangben", "zhangben" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "用来记帐的小本子。\n");
    set("unit", "个");
    set("owner_name", HIW "向问天");
    set("owner_id", "xiang wentian");
    set("task_object", 1);
  }
}
