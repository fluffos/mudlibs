inherit ITEM;
#include "task.h"
void create()
#include <ansi.h>
{
  set_name(HIW "驴鞍", ({ "lu an", "an" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "小毛驴量身定做的。\n");
    set("unit", "块");
    set("owner_name", HIM "岳不群");
    set("owner_id", "yue buqun");
    set("task_object", 1);
  }
}
