#pragma save_binary
#include <dbase.h>
#include <ansi.h>;

//计算升级需要最大的经验
int level_max_exp(object me)
{
   int max_exp,lvl;
   lvl=(int)me->query("level");
   if(lvl<5)
    max_exp=lvl*10+100;
   if(lvl<10 && lvl>4)
    max_exp=lvl*15+2000;
   if(lvl<20 && lvl>9)
    max_exp=lvl*20+5000;
   if(lvl<30 && lvl>19)
    max_exp=lvl*30+10000;
   if(lvl<40 && lvl>29)
    max_exp=lvl*40+20000;
    if(lvl<50 && lvl>39)
    max_exp=lvl*50+50000;
     if(lvl<60 && lvl>49)
    max_exp=lvl*100+100000;
      if(lvl<70 && lvl>59)
    max_exp=lvl*150+200000;
   if(lvl<80 && lvl>69)
    max_exp=lvl*200+500000;
   if(lvl<90 && lvl>79)
    max_exp=lvl*300+1000000;
    if(lvl<100 && lvl>89)
    max_exp=lvl*400+2000000;
    if(lvl>=100)
    max_exp=lvl*500+10000000;
   return max_exp;
}
//升级判断--升级会消耗实战经验。
varargs void improve_level(object me)
{
    int exp_num;
    exp_num=me->query("combat_exp");
    if(exp_num >= level_max_exp(me))
    {
       tell_object(me, HIG"你消耗了一部分实战经验，只见一阵绚丽的光芒从你身上闪过  \n"+NOR);
       printf(HIC"≡"HIY"────────────────────────────"HIC"≡\n"NOR);    
       tell_object(me, HIR" 恭喜:"+NOR" 你的 "+YEL+"「Level」: "HIY" 提升了 ↑"+NOR"！"+HIG"    内: +5  精: +3 "+NOR+"\n");
       me->add("max_neili",5); 
       me->add("max_jingli",3);     
       if(exp_num>level_max_exp(me))
       {
           exp_num=exp_num-level_max_exp(me);
           me->set("combat_exp",exp_num);
           me->add("level",1);
           if((int)me->query("level")%3==0)
            {
               me->add("skill_point",1);
               write(HIG"恭喜：      <你获得附加技能点> + 1 \n"NOR);
            }
            if((int)me->query("level")%10==0)
            {
               me->add("tianfu_point",1);
               write(HIG"恭喜：      <你获得附加天赋点> + 1 \n"NOR);
            }
       }
       else
       {
            me->set("combat_exp",0);
              me->add("level",1);
       }
       printf(HIC"≡"HIY"────────────────────────────"HIC"≡\n"NOR);
     }  
     else
     {
          write(HIR"你的实战经验不足以提升等级!\n"NOR);
     }   
}
//提升天赋点数
varargs void up_tianfu(object me)
{
   int i;
   if((int)me->query("tianfu_point"))
   {
       i=random(400);
        write(HIY"你将一点宝贵的「天赋点」灌注进了身体，顿时一片金光闪过。\n"NOR);
       if(i>0 && i<=100) 
        {
           me->add("str",1) ;
             write(HIR"恭喜：   "HIG"你的「先天臂力」增加了!\n"NOR);
        }
       if(i>100 && i<=200) 
        {
           me->add("int",1) ;
             write(HIR"恭喜：   "HIG"你的「先天悟性」增加了!\n"NOR);
        }
       if(i>200 && i<=300) 
        {
           me->add("con",1) ;
             write(HIR"恭喜：   "HIG" 你的「先天根骨」增加了!\n"NOR);
        }
        if(i>300 && i<=400) 
        {
           me->add("dex",1) ;
             write(HIR"恭喜：   "HIG"你的「先天身法」增加了!\n"NOR);
        }
       me->add("tianfu_point",-1);
   }
   else
   {
     write(HIR"你的天赋点不足以提升先天属性! "NOR);
   }
}

 //随机提升装备的特殊技能等级
varargs void up_skills(object me)
{
   int skill_point;
   mixed me_skills;
   mixed sky_skills;
   mapping skills;
   int i;
   int exp,level;
   me_skills=me->query_skill_map();
   if(sizeof(me_skills))
   {
        if((int)me->query("skill_point"))
       {
            i=random(sizeof(me_skills));
            sky_skills=keys(me_skills);
            skills=me->query_skills();
            exp=me->query("combat_exp");
            level=skills[me_skills[sky_skills[i]]];
            if(level*level*level/10 < exp)
            {
                 skills[me_skills[sky_skills[i]]]++;
            tell_object(me, "你消耗了一个技能点，只见一阵"HIM"紫色"NOR"的光芒从你身上闪过！！！  \n"+NOR);
            printf(HIC"≡"HIY"────────────────────────────"HIC"≡\n"NOR);    
            tell_object(me,HIR"  恭喜："NOR" 你的特殊武功"MAG" [ "+to_chinese(me_skills[sky_skills[i]])+" ]"NOR" 提升了 "HIM"↑"NOR" .\n"NOR);
            printf(HIC"≡"HIY"────────────────────────────"HIC"≡\n"NOR);
            me->add("skill_point",-1);
            }
            else
            {
              write(HIR"你的经验不足以支持技能的提升!\n"NOR);
            }
                
       }
        else
       {
           write(HIR"你的技能点不足!\n"NOR);
       }
   }
   else
   {
        write(HIR"技能点只能提升装备着的特殊武功!\n"NOR);
   }
   
}

