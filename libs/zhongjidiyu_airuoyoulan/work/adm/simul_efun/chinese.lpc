
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

// §15h: this was a GBK lead/trail-byte range check (each Chinese
// character was 2 raw bytes on the original GBK-byte driver). On this
// driver, str[i] is a full Unicode codepoint and strlen() counts
// characters, not bytes -- the old byte-range comparison is now always
// false for real Chinese text. Replaced with a CJK Unified Ideographs
// codepoint range check, one character per index.
int is_chinese(string str)
{
	int i;

	if (strlen(str) < 1) return 0;

	for (i = 0; i < strlen(str); i++)
	{
		if (str[i] < 0x4e00 || str[i] > 0x9fff) return 0;
	}

	return 1;
}
