});

string *knowledge_level_desc = ({
        BLU "新学乍用" NOR,
        BLU "不甚了了" NOR,
        HIB "不知端倪" NOR,
        HIB "平淡无奇" NOR,
        YEL "司空见惯" NOR,
        YEL "初窥门径" NOR,
        HIY "略知一二" NOR,
        HIY "茅塞顿开" NOR,
        CYN "略识之无" NOR,
        CYN "滚瓜烂熟" NOR,
        MAG "马马虎虎" NOR,
        MAG "轻车熟路" NOR,
        HIW "运用自如" NOR,
        HIW "触类旁通" NOR,
        HIM "深入浅出" NOR,
        HIM "已有小成" NOR,
        HIM "心领神会" NOR,
        RED "了然於胸" NOR,
        RED "见多识广" NOR,
        HIR "无所不通" NOR,
        HIR "卓尔不群" NOR,
