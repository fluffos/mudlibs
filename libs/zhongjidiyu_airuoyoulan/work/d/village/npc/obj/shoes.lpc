// gunny_shoes.c

#include <armor.h>

inherit BOOTS;

void create()
{
	set_name("麻鞋", ({ "gunny shoes", "shoes" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
		// §9/§10-shaped pre-existing typo: an "icon" set() call was
		// interleaved mid-argument into this set("long", ...) call,
		// splitting one statement into a syntax error -- reordered
		// so each set() call is a complete, separate statement.
		set("long",
"这是一双麻布鞋，不易大滑，供游人登山使用。\n");
		set("icon","05047");
		set("value", 150);
		set("material", "cloth");
                set("armor_type", "boots");
                set("armor_prop/armor", 1);
	}

}
