// tashui-wuhen.c
inherit SKILL;
#include <ansi.h>
string *dodge_msg = ({
    "只见$n一个「"+YEL+"风月无边"+NOR+"」，随着$N的攻势飘起，从容躲过这一招，衣带随着身影飘起，很是好看。\n",
    "$n使出一招「"+RED+"落花有意"+NOR+"」，一个矮身，从$N臂下躲过，结果$N扑了个空。\n",
    "$n上身形一摇，一招「"+HIY+"流水无情"+NOR+"」，脚步不动，竟然躲过了$N的攻势。\n",
    "$n使一招「"+HIY+"天旋地转"+NOR+"」绕着$N的周围疾风旋转起来，把地上的砂石也带起，竟成了一个不小的旋涡。
可是$N却不能碰到$n分毫。\n",
    "$n左一摇，右一晃，一招「"+HIB+"踏云看日"+NOR+"」已轻松闪过。\n",
    "$n双足一点，斜斜跃起，使出「"+HIR+"蜻蜓点水"+NOR+"」，在空中翻了一个身，落下时已闪到$N身后。\n",
});
int valid_enable(string usage) 
{ 
    return (usage == "dodge") ;
}
int practice_level(){   return 60;  }
int valid_learn(object me) { 
    if (me->query_skill("dodge",1)<=me->query_skill("tashui-wuhen",1))
        return notify_fail("你的基本轻功基础不够，无法领会更高深的技巧。\n");
    else
        return 1;
    
}
string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}
int practice_skill(object me)
{
        if( (int)me->query("qi") < 30 )
            return notify_fail("你的体力太差了，不能练暗影浮香。\n");
       
        me->receive_damage("qi", 20);
        return 1;
}


