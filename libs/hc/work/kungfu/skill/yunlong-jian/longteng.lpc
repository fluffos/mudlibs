// longteng.c  九啸龙腾
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
 
int perform(object me, object target)
{
    object weapon, ob;
        string msg;
 
    if( !target ) target = offensive_target(me);
    if( !me->is_fighting() )
        return notify_fail(HIR"〖九啸龙腾〗"NOR"只能在战斗中使用。\n");
 
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail(HIR"〖九啸龙腾〗"NOR"必需要用剑才能使用！\n");
   if (me->query_temp("perform"))   return notify_fail("你上一个招式还没完成!\n");

    if( (int)me->query("neili") < 100 )
        return notify_fail("你的真气不够！\n");
    if( (int)me->query_skill("sword") < 400 ||
(int)me->query_skill("yunlong-jian", 1) < 400 ||
        me->query_skill_mapped("sword") != "yunlong-jian")
        return notify_fail("你的云龙剑法还不到家，无法使用奥义！\n");
    msg = HIY "$N使出云龙剑法之奥义"HIR""BLINK"〖九啸龙腾〗"NOR""HIW"顿时风云变色！"HIC"
\n手中的剑直冲云宵，刹那间云雾中发出九声龙吟，
\n紧接着九支狂雷如神话般的巨龙直轰"HIG"$n！\n" NOR;
    message_vision(msg, me,target);
    me->clean_up_enemy();
    ob = me->select_opponent();
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    me->add("neili", -900);
    me->set_temp("perform",1);
    call_out("del_perform",2,me);
    return 1;
}
void del_perform(object me)
{
   if (!me) return;
   me->delete_temp("perform");
}

