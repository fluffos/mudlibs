// kungfu/skill/yueying-wubu/tianlingdiwu
// 红尘
// by happy 03/06/22

// powerup.c
#include <ansi.h>
inherit F_SSERVER;
void remove_effect(object me, int amount);
int perform(object me, object target) {
  int skill;
  if (target != me) return notify_fail("你只能对自己用[" + HIR + "天灵地舞" + NOR + "]\n" NOR,);
  if ((int)me->query_skill("yueying-wubu", 1) < 1800)
    return notify_fail("你的月影舞步太差了。\n");
  if ((int)me->query("neili") < 100000) return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("powerup")) return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("force");

  me->add("neili", -50000);
  me->receive_damage("qi", 20);

  message_vision(
    HIW "$N突然身旁出现一道白光,像仙子在天空飞舞一样[周围如梦似幻，轻烟漂浮,霎时间白光溶入$N的体内]。\n" NOR, me);
  me->add_temp("apply/dodge", skill / 5);
  tell_object(me, HIR "你的防御力提高了!\n" NOR);
  me->set_temp("powerup", 1);
  me->add_temp("apply/dexerity", skill / 5);
  tell_object(me, HIG "你的速度提高了!\n" NOR);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 5 :), skill);
  if (me->is_fighting()) me->start_busy(4);
  return 1;
}

void remove_effect(object me, int amount) {
  int skill;
  skill = me->query_skill("dodge");
  me->add_temp("apply/dodge", -amount);
  me->delete_temp("powerup");
  me->add_temp("apply/dexerity", -skill / 5);
  me->delete_temp("apply/dexerity");

  tell_object(me, "你的[" + HIR + "天灵地舞" + NOR + "]运行完毕，将内力收回丹田。\n");
}
