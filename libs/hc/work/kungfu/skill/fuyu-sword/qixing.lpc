#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, object target)
{
        int damage;
        string msg;
        object weapon;
        weapon = me->query_temp("weapon");
        if( !target ) target = offensive_target(me);

        if( !target
            ||  !target->is_character()
            ||  !me->is_fighting(target) )
                return notify_fail("剑转七星只能对战斗中的对手使用。\n");

        if( (int)me->query_skill("fuyu-sword", 1) < 100 )
                return notify_fail("你的剑转七星还未练成，不能使用！\n");

        if( (int)me->query_skill("polang-shengong",1)<100)
        return notify_fail("你的本门内功不够。\n");

              if(me->query("family/family_name") != "怒蛟帮")
              return notify_fail("你并非怒蛟帮的人，无法体会到绝招。\n");

        if( (int)me->query("neili") < 300 )
                return notify_fail("你现在内力不足，不能使用剑转七星！\n");

        if( (int)me->query_skill("sword", 1) < 100 )
                return notify_fail("你的基本剑法不够娴熟，不能使用剑转七星。\n");
        msg = HIY "\n$N手中的剑化成银白芒点，流星追月般画过虚空,循一道包涵了天地至理的弧线往$n刺来\n"NOR;

        if ( random(me->query("dex")) > (int)target->query("dex")*1/2 )
        {
                msg += HIR"\n$p只觉得全身受到内力震荡，钻心般巨痛，一口鲜血喷出，身上多\n" +
                        "出几个血肉模糊的血窟窿。\n" NOR;
                message_vision(msg, me, target);
                me->add("neili", -100);
        }

        else
        {
                msg += HIG"\n$p情急之中双脚跋地而起，空中身行一闪，狼狈地躲过这一照，脸色变的苍白。\n" NOR;
                message_vision(msg, me, target);
                me->start_busy(2);
        }
        if (random(me->query_skill("parry")) > target->query_skill("parry")/2 )
        {
                me->start_busy(2);

                damage = (int)me->query_skill("polang-shengong", 1);

                damage = damage*5/2 + random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage);
                target->add("neili", -random(damage));
                me->add("neili", -100);
                if( damage < 300 ) msg += HIC"\n结果$n脸色变得惨白，踉踉跄跄退了好几步！\n"NOR;
                else if( damage < 400 ) msg += HIM"\n结果重重地击中，$n「哇」地一声吐出一口鲜血！\n"NOR;
                else if( damage < 500 ) msg += RED"\n结果「轰」地一声，$n全身气血倒流，口中鲜血狂喷而出！\n"NOR;
                else msg += HIR"\n结果只听见几声喀喀轻响，$n一声惨叫，像滩软泥般塌了下去！！\n"NOR;

        }
        else
        {
                me->start_busy(2);
                msg += HIG"\n$p情急之中双脚跋地而起，空中身行一闪，狼狈地躲过这一照，脸色变的苍白。\n" NOR;
        }
if( (int)me->query_skill("fuyu-sword", 1) > 299 )
{
message_vision(HIG"\n$N忽然剑锋再转，光球爆炸开来，七式合一变成潮水般的剑雨，一浪接一浪往$n冲击狂涌！\n"NOR,me,target);
msg = HIW"第一招："WHT"〖"HIY"风雨嗡鸣"WHT"〗\n\n"HIG"只见$N手中之剑势一抖，笔直刺向$n的耳朵，$n只觉身上一痛，随即"HIC"『耳朵』"HIG"传来无法形容的剧烈蜂鸣声!\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);    
msg = HIW"第二式："WHT"〖"HIY"结雨成网"WHT"〗\n\n"HIG"只见$N手中之剑连抖几下，笔直刺入$n的身体，$n只觉身上一痛，已被刺了几道口子出来!\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
msg = HIM"第三式："WHT"〖"HIY"剑芒化影"WHT"〗\n\n"HIG"只见$N剑势再抖，像蛟龙出海，大鹏展翅，先是一团光芒，光芒蓦然爆开，化作一片光雨，漫天遍地向$n刺来！\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
msg = MAG"第四式："WHT"〖"HIY"破空急电"WHT"〗\n\n"HIG"只见$N似醒还醉的眼倏地睁亮剑化作一道长虹，先冲而起，忽然速度激增，有若脱弦之箭，游龙破浪般几下起伏急窜，向$n电射而来！\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
msg = YEL"第五式："WHT"〖"HIY"粼光刺目"WHT"〗\n\n"HIG"只见$N寒芒一闪剑魔术变幻般化作漫天剑雨，没有人可以形容那使人目眩神迷的美景，眼前的空间忽然间填满了动人心魄的光雨！\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
msg = HIB"第六式："WHT"〖"HIY"疾雨连绵"WHT"〗\n\n"HIG"只见$N手中的剑难分先后地或点或劈，或刺或扫，毫无道满地击在$n的兵器上，使$n的招式无法施展开来再趁势向$n刺来！\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
msg = RED"第七式："WHT"〖"HIY"声东击西"WHT"〗\n\n"HIG"只见$N转回头来，静若止水地看着手中的剑，再轻叹一声，连续七剑向$n刺来！" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
msg = HIR"第后一式："WHT"〖"HIY"虚空覆雨"WHT"〗\n\n"HIG"$N突然把剑抛了出去化作一团反映着天上电光的银白芒点，流星追月般画过虚空，往$n投来！\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
message_vision(WHT"\n$N使完七招，收剑挺立场中，一代王者风范凛然而出！仿佛毫不在意$n的存在。\n"NOR,me,target); 
        me->add("neili", -300);
         me->start_busy(1+random(2));
        return 1;
}
message_vision(msg, me, target);

        return 1;
}

