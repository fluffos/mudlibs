inherit SKILL;

mapping *action = ({
  ([ "action": "$N前腿踢出，后腿脚尖点地，一式「蛟龙出海」，二掌直出，攻向$n
的上中下三路",
    "force": 150,
    "dodge": 5,
    "damage_type": "瘀伤",
    "lvl": 0,
    "skill_name": "蛟龙出海"
  ]),
  ([ "action": "$N双拳犹如蛟龙一样向$n的面目攻来,正是一招[双蛟夺食]",
    "force": 160,
    "dodge": 5,
    "damage_type": "瘀伤",
    "lvl": 12,
    "skill_name": "双蛟夺食"
  ]),
  ([ "action": "$N使一式「蛟龙乱舞」，右掌上引，左掌由后而上一个甩劈，斩向$n
的$l",
    "force": 170,
    "dodge": 5,
    "damage_type": "劈伤",
    "lvl": 18,
    "skill_name": "蛟龙乱舞"
  ]),
  ([ "action": "$N左掌护胸，右拳凝劲后发，一式「蛟龙入涧」，缓缓推向$n的$l",
    "force": 185,
    "dodge": -5,
    "damage_type": "瘀伤",
    "lvl": 24,
    "skill_name": "蛟龙入涧"
  ]),
  ([ "action": "$N使一式「蛟龙盘身」，全身飞速旋转，双掌一前一后，一圈比一圈紧的劈向$n的胸口",
    "force": 200,
    "dodge": 10,
    "damage_type": "瘀伤",
    "lvl": 30,
    "skill_name": "蛟龙盘身"
  ]),
  ([ "action": "$N合掌抱球，猛吸一口气，一式「蛟龙摆尾」，右腿回旋三百六十度踢向$n的腹部",
    "force": 220,
    "dodge": 5,
    "damage_type": "瘀伤",
    "lvl": 36,
    "skill_name": "蛟龙摆尾"
  ]),
  ([ "action": "$N两掌上下护胸，一式「蛟龙升天」，骤然化为满天掌雨，攻向$n",
    "force": 310,
    "dodge": 30,
    "damage_type": "瘀伤",
    "lvl": 54,
    "skill_name": "蛟龙升天"
  ]),
  ([ "action": "$N一式「神蛟赶月」，双手合十，对着$n遥遥推出一掌，全身内劲如巨浪般汹涌而出",
    "force": 360,
    "dodge": 10,
    "damage_type": "瘀伤",
    "lvl": 60,
    "skill_name": "神蛟赶月"
  ])
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_combine(string combo) { return combo == "nujiao-quan"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("怒蛟拳必须空手。\n");
  if ((int)me->query_skill("polang-shengong", 1) < 20)
    return notify_fail("你的破浪神功火候不够，无法学怒蛟拳。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练怒蛟拳。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("nujiao-quan", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练怒蛟拳。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "nujiao-quan/" + action;
}
