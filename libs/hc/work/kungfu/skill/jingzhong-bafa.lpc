// 井中八法
//    by jingx
inherit SKILL;
mapping *action = ({
  ([ "action": "$N手中$w出鞘，" + CYN + "一招「不攻」，$N整个身体像给刀带动般往前俯踞，刀锋遥指$n，却没有发出丝毫刀气寒气，
似是摆个没有实质的姿态，可$n清楚感受到$N人刀合一，且更与天地浑为一体，天地的力量" + NOR + "",
    "force": 50,
    "damage_type": "割伤",
    "lvl": 0,
  ]),
  ([ "action": "忽地满场刀光劲氨蓦然收敛，$N" + HIB + "一招「击奇」，身随刀走，刀劲化作长虹，直朝$n射去。纵使明知$N要出刀，
$n也想不到如此猛疾凌厉，有如山洪暴发，异军突起" + NOR + "",
    "force": 100,
    "lvl": 50,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N劈向空处，离地三尺而止，" + HIW + "一招「棋弈」，刀锋一卷，刀气以刀锋为核心，形成暴劲狂刮，往四方卷击，
$n讶然发现气场的位置正是自己下一个移动的位置，却已不由自主的投向气场中央。" + NOR + "",
    "force": 150,
    "lvl": 100,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N哑然一笑，蓄满气势的身躯微微向左稍倾，" + HIM + "一招「兵诈」，$w隐隐指向$n身体，$n不自觉提起内力护着身体，
哪知$N跃空而起，手中$w循着天地间某一道无尽完美的曲线轨迹划向$n身体" + NOR + "",
    "force": 200,
    "lvl": 150,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w光芒大盛，" + HIG + "一招「战定」，连续百多刀，每一刀均从不同角度往$n攻去，刀刀妙至毫颠，
似有意若无意，既态趣横生，又是凶险至极点" + NOR + "",
    "force": 250,
    "lvl": 200,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N握着$w迅速的一翻，使出" + WHT + "一招「用谋」，武器竟似凭空消失一般，在众人瞪目结舌下，
$N人随刀走，一缕轻烟般过与$n间的距离，武器又魔术般的回到了$N手上，朝对手照头照脸的劈去" + NOR + "",
    "force": 300,
    "lvl": 250,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N狂喝一声，$w使出“井中八法”" + HIC + "第七法「速战」，长刀先往里弯，再回击往前，
大有一往无前，不是你死便是我亡的气势" + NOR + "",
    "force": 350,
    "lvl": 300,
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N" + HIY + "一招「方圆」，手上$w忽然刀气大盛，气劲从刀锋发出，卷旋而去，成方中之圆，
自身却发出惊人气场，如墙如堵的往$n压去，再成图中之方，且是一先一后，隐含宇宙间的至理，教$n无法可想" + NOR + " ",
    "force": 400,
    "lvl": 500,
    "damage_type": "劈伤"
  ]),
});

int valid_enable(string usage) {
  object me = this_player();
  if (me->query_skill("jingzhong-bafa", 1) > me->query_skill("hujia-daofa", 1) ||
    me->query_skill("hujia-daofa", 1) > me->query_skill("zhuifeng-blade", 1)) {
    return notify_fail("你的基础不够，无法把井中八法运用自如。\n");
  }
  return usage == "blade" || usage == "parry";

}
int practice_level() { return 500; }
int valid_learn(object me) {
  if (me->query("family/master_id") != "kou zhong")
    return notify_fail("井中八法是寇仲的独门绝技，其他师傅参悟还来不及，怎能教你？\n");
  if ((int)me->query("max_neili") < 1200)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("force", 1) >= 20)
    return 1;
  else if ((int)me->query_skill("force", 1) < 20)
    return notify_fail("你的基本内功火候太浅。\n");
  if (me->query_skill("blade", 1) <= me->query_skill("hujian-daofa", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if (me->query_skill("hujia-daofa", 1) > me->query_skill("shaolin-shenfa", 1) ||
    me->query_skill("hujia-daofa", 1) > me->query_skill("hunyuan-yiqi", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
}

mapping query_action(object me, object weapon) {
  mapping a_action;
  int i, level;
  level = (int)me->query_skill("jingzhong-bafa", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"]) {
      a_action = action[NewRandom(i, 20, level / 5)];
      break;
    }
  if (me->query_temp("perform_duan")) level += level;
  a_action["dodge"] = 0 - level;
  a_action["parry"] = 0 - level * 2;
  a_action["attack"] = level;
  a_action["damage"] = level * 50000;
  return a_action;
}

int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if (me->query_skill("huajia-daofa", 1) > 500)
    return notify_fail("你现在只能通过learn来提高井中八法。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够，练不了井中八法。\n");
  if (me->query_skill("hujia-daofa", 1) > me->query_skill("shaolin-shenfa", 1) ||
    me->query_skill("hujia-daofa", 1) > me->query_skill("hunyuan-yiqi", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  me->receive_damage("qi", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "jingzhong-bafa/" + action;
}
