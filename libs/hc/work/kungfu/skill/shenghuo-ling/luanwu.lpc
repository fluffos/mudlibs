#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
 
int perform(object me, object target)
{
    object weapon, ob;
    string msg;
    int i;
 
    if( !target ) target = offensive_target(me);
    if ( !wizardp(this_player()) && (me->query("family/family_name") != "明教"))
        return notify_fail("你不是明教弟子不能使用奥义"HIM"〖圣火乱舞〗.\n"NOR);
    if( !me->is_fighting() )
        return notify_fail(HIM"〖圣火乱舞〗"+NOR+"只能在战斗中使用。\n");
    if (me->query_temp("perform")) return notify_fail("你上一招未使完！\n");
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    else me->set_temp("secondly_weapon",1);
    if( (int)me->query("neili") < 1000 )
        return notify_fail("你的真气不够！\n");
    if( (int)me->query_skill("sword") < 300 ||
        me->query_skill_mapped("sword") != "shenghuo-ling")
        return notify_fail("你的「圣火令法」还不到家，无法使用"+HIM+"〖圣火乱舞〗\n"NOR);
    msg = HIR "$N运起九阳神功，使出圣火令法奥义"+HIM+"〖圣火乱舞〗"+HIG+"
\n此时手中的武器以一化六，如火流星般的坠落"HIW"$n"HIG"去。\n"NOR;
    message_vision(msg, me, target);
    me->clean_up_enemy();
    ob = me->select_opponent();
    me->add("neili", -1000);
    me->set_temp("perform",1);
    me->set_temp("perform_luanwu",1);
    for(i = 0; i < 6; i++)
        if (me->is_fighting(ob) && ob->is_fighting(me) && ob->query("eff_qi")>0){
              me->set_temp("action_msg",HIC"紧接着"NOR);
                if (!weapon->query("equipped")) break;
              COMBAT_D->do_attack(me, ob,weapon, 0);
            }else break;
    me->delete_temp("perform_luanwu");
    me->delete_temp("secondly_weapon");
    me->start_call_out( (: call_other, __FILE__, "del_perform", me :), 6);;
    return 1;
}

void del_perform(object me)
{
   if (!me) return;
   me->delete_temp("perform");
}



