// lingguang-quan.c 灵光拳
// by Swordman 2000

inherit SKILL;

mapping *action = ({
([      "action": "$N双拳平平向前击出，神色沉重的缓缓推向$n的$l",
    "dodge": -30,
    "parry": 10,
    "force": 400,
    "damage_type": "瘀伤"
]),
([      "action": "$N突然身形突然飞起，双拳居高临下拍向$n的$l",     
    "dodge": -15,
    "parry": -20,
    "force": 180,
    "damage_type": "瘀伤"
]),
([      "action": "$N右拳荧光闪动，迅捷无比地挥出打向$n的$l",
    "dodge": -10,
    "parry": -10,
    "force": 120,
    "damage_type": "瘀伤"
]),
([      "action": "$N左拳陡然向右前方打出，隐隐带着风声拍向$n的$l",
    "dodge": -15,
    "parry": -10,
    "force": 160,
    "damage_type": "瘀伤"
]),
([      "action": "$N右拳聚成一股光球，不急不慢的缓缓推向$n的$l",
    "dodge": -10,
    "parry": 10,
    "force": 200,
    "damage_type": "瘀伤"
]),
([      "action": "$N突然向前猛冲，玩命似的用双拳猛的击向$n的$l",
    "dodge": -10,
    "parry": 20,
    "force": 250,
    "damage_type": "瘀伤"
]),
([      "action": "$N暗暗运起灵光波动，右拳向$n的$l挥出",
    "dodge": 0,
    "parry": 10,
    "force": 100,
    "damage_type": "瘀伤"
]),
([      "action": "$N大叫一声，双拳好似带着股狂风般，不顾一切般砸向$n",
    "dodge": -25,
    "parry": -10,
    "force": 300,
    "damage_type": "瘀伤"
]),
([      "action": "$N突然发难对着$n的$l连捶数拳",
    "dodge": -20,
    "parry": -20,
    "force": 230,
    "damage_type": "瘀伤"
]),
([      "action": "$N身形滑动，双拳一前一后直击向$n的$l",
    "dodge": -10,
    "parry": 20,
    "force": 160,
    "damage_type": "瘀伤"
]),
([      "action": "$N双腿未动，身形突然飞起，双拳齐挥向$n的$l打下",     
    "dodge": -20,
    "parry": 30,
    "force": 250,
    "damage_type": "瘀伤"
]),
([      "action": "$N双拳横打，以极快的速度向$n连打六下",
    "dodge": -20,
    "parry": 20,
    "force": 270,
    "damage_type": "瘀伤"
]),
([      "action": "$N突然近身，左拳封住$n的退路，右拳斜斜地挥向$l",     
    "dodge": -15,
    "parry": 20,
    "force": 220,
    "damage_type": "瘀伤"
]),
([      "action": "$N看似漫不经心，双拳软绵绵地击向$n的$l",
    "dodge": -25,
    "parry": 10,
    "force": 350,
    "damage_type": "瘀伤"
]),
([      "action": "$N脚下一转，突然欺到$n身前，一瞬间已出12拳，拳拳打向$n的$l",     
    "dodge": -20,
    "parry": 40,
    "force": 330,
    "damage_type": "瘀伤"
]),
([      "action": "$N突然出现个大破绽，但转瞬间又突然挥拳向$n的$l砸去",
    "dodge": -25,
    "parry": 1,
    "force": 320,
    "damage_type": "瘀伤"
]),
([      "action": "$N右拳由下往上击向$n的$l",
    "dodge": -15,
    "parry": 40,
    "force": 200,
    "damage_type": "瘀伤"
]),
([      "action": "$N左拳护胸，右拳带着闪闪荧光上下晃动着击向$n的$l",     
    "dodge": -10,
    "parry": 40,
    "force": 220,
    "damage_type": "瘀伤"
]),
});

int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry"; }  

int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
   return notify_fail("练灵光拳必须空手。\n");
    if ((int)me->query_skill("ling-bodong", 1) < 20)
   return notify_fail("你的灵波动功力不够，无法练灵光拳。\n")
;
    if ((int)me->query("max_neili") < 100)
   return notify_fail("你的灵力太弱，无法练灵光拳。\n");
    return 1;
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 40)
   return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 10)
   return notify_fail("你的灵力不够练灵光拳。\n");
    me->receive_damage("qi", 30);
    me->add("neili", -5);
    return 1;
}
string perform_action_file(string action)
{
    return __DIR__"lingguang-quan/" + action;
}

