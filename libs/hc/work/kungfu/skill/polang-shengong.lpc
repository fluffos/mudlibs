#include <ansi.h>
inherit FORCE;
inherit F_DBASE;
public string query_type() {
  return "yin";
}

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)  // need more limit here
{
  int i = (int)me->query_skill("polang-shengong", 1);
  int t = 1, j;
  for (j = 1; j < i / 10; j++) t *= 2;

  if ((int)me->query_skill("force", 1) < 10)
    return notify_fail("你的基本内功火候还不够。\n");

  if (
    me->query_skill("hunyuan-yiqi", 1)        //少林初
    || me->query_skill("beiming-shengong", 1)  //逍遥
    || me->query_skill("xiaowuxiang", 1)      //雪山
    || me->query_skill("bahuang-gong", 1)     //灵鹫
    || me->query_skill("bibo-shengong", 1)    //桃花岛     
    || me->query_skill("yijinjing", 1)        //少林最高内功
    || me->query_skill("taiji-shengong", 1)   //武当
    || me->query_skill("zixia-shengong", 1)   //华山高级
    || me->query_skill("huashan-neigong", 1)  //华山低级
    || me->query_skill("xiantian-qigong", 1)  //全真派
    || me->query_skill("xuantian-neigong", 1)  //npc
    || me->query_skill("yunv-xinfa", 1)       //古墓
    || me->query_skill("xuantian-wuji", 1)    //昆仑派
    || me->query_skill("yunlong-shengong", 1)  //云龙门。天地会
    || me->query_skill("kurong-changong", 1)  //大理
    || me->query_skill("linji-zhuang", 1)     //娥眉
    || me->query_skill("wudu-shengong", 1)    //五毒教
    || me->query_skill("hamagong", 1) ||              //白驮山
    me->query_skill("shenlong-xinfa", 1) ||          //神龙教
    me->query_skill("huntian-qigong", 1))            //丐帮
    return notify_fail("你不先散了别派内功，怎能学破浪神功？！\n");
  return 1;
}

int practice_skill(object me) {
  return notify_fail("破浪神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "polang-shengong/" + func;
}
mapping exercise_msg(object me) {
  return ([
    "status_msg": HIG + me->name() + "四周真气如潮水搬一波接一波的涌个不停。" NOR,
    "start_my_msg": HIG "你运起破浪神功，体内的真气如乘风破浪般一股接一股的顺经脉流动。\n",
    "start_other_msg": HIG + me->name() + "运起破浪神功，面色顿时变的如湖水般惨绿。\n" NOR,
    "halt_msg": HIG "$N面色连变数下，绿芒一闪而过人站了起来。。\n",
    "end_my_msg": HIG "你长嘘一口起站了起来，体内的真气似乎要破关而出，看来内息又增强了一分。\n",
    "end_other_msg": "" + HIG + "只见" + me->name() + "长嘘一口气站了起来，眼珠中带着一丝诡异的绿色。\n" NOR,
  ]);
}
