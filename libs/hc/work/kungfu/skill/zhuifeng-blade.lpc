#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": HIY
    "$N手中$w" HIY "轻挥，一招「风起云涌」，带着狂风之势向$n的$l撩去" NOR,
    "force": 150,
    "dodge": 10,
    "lvl": 0,
    "skill_name": "风起云涌",
    "damage_type": "割伤"
  ]),
  ([ "action": HIG "$N一招" + HIW "「狂风暴雨」，右脚一点，$w" HIG "寒光闪闪，快速涌$n的$l" NOR,
    "force": 170,
    "dodge": 35,
    "damage": 20,
    "lvl": 3,
    "skill_name": "狂风暴雨",
    "damage_type": "割伤"
  ]),
  ([ "action": HIR
    "$N一招「风吹草动」，手臂一抡，刀锋一卷，自上而下斩向$n" NOR,
    "force": 190,
    "dodge": 25,
    "damage": 25,
    "lvl": 5,
    "skill_name": "风吹草动",
    "damage_type": "割伤"
  ]),
  ([ "action": HIM
    "$N一招「随风拂柳」，$w" HIM "徐徐扫向$n的$l" NOR,
    "force": 210,
    "dodge": 15,
    "damage": 35,
    "lvl": 10,
    "skill_name": "随风拂柳",
    "damage_type": "割伤"
  ]),
  ([ "action": HIW "$N侧身滑步而上，一招「风卷残云」，欺至$n身前，$w" HIW "猛砍$n的$l" NOR,
    "force": 230,
    "dodge": 20,
    "damage": 50,
    "lvl": 20,
    "skill_name": "风卷残云",
    "damage_type": "割伤"
  ]),
  ([ "action": HIC "$N使一招「秋风扫叶」，$w" HIC "舞出阵阵刀光向$n的下盘扫去" NOR,
    "force": 320,
    "dodge": 40,
    "damage": 105,
    "lvl": 60,
    "skill_name": "秋风扫叶",
    "damage_type": "割伤"
  ]),
  ([ "action": HIB "$N一招「风雨乱舞」，$w" HIB "刀光闪烁不定，时上时下的劈向$n的$l" NOR,
    "force": 350,
    "dodge": 50,
    "damage": 125,
    "lvl": 80,
    "skill_name": "风雨乱舞",
    "damage_type": "割伤"
  ]),
  ([ "action": HIY "$N挪步小退，一招「追风逐浪」，手中$w" HIY "轻描淡写地挥出一
刀，随即又“唰唰”连劈出两刀，后发先至，洒向$n的$l" NOR,
    "force": 400,
    "dodge": 20,
    "damage": 150,
    "lvl": 100,
    "skill_name": "追风逐浪",
    "damage_type": "割伤"
  ]),
});


int valid_enable(string usage) { return usage == "blade"; }

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("zhuifeng-blade", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力不够练追风刀法。\n");
  me->receive_damage("qi", 25);
  return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  object weapon;
  weapon = me->query_temp("weapon");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("id") != "tianbing blade" && (me->query("family/family_name") == "怒蛟帮"))
    return 0;
  if (random(10) > 7)
    return 0;
  else {
    victim->receive_wound("qi", (damage_bonus) / 4);
    return HIW "只见一道" BLINK HIR "红光" NOR HIW "划过，" + me->name() + "与手中的" HBRED HIR "天兵宝刀" NOR HIW "人刀合一,发挥出" BLINK HIR "追风刀法的精髓" NOR HIW ",刀气摧毁了$n的精华!!!!\n" NOR;
  }

}

string perform_action_file(string action) {
  return __DIR__ "zhuifeng-blade/" + action;
}
