//poqiang.c 「破枪式」
//made by deaner
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        object target_w;
        target_w = target->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(HIC"你只能对战斗中的对手使用「破枪式」。\n"NOR);

        if( target->is_busy() )
                return notify_fail(target->name() + "目前正疲于招架，加紧攻击吧！\n");
    if( (int)me->query_skill("dugu-jiujian-sword", 1) < 80 )
        return notify_fail("你的独孤九剑不够娴熟，不能使用「破枪式」。\n");

    msg = CYN "$N悠然使出独孤九剑中的「破枪式」，剑势灵巧地顺着"+target_w->query("name")+"削落，划向$n的五指！\n";
    me->start_busy(2);

        if (target->query_temp("weapon") ||
           (string)target_w->query("skill_type") == "staff"){
        if( random(me->query("combat_exp")) >
                     (int)target->query("combat_exp")/4 ) {
    msg += "$p无法破解这招「破枪式」，唯有舍弃"+target_w->query("name")+"，向后跃开丈许，先求自保。！\n" NOR;
                 target_w->unequip();
                 target_w->move(environment(target));
                 target->reset_action();
                 target->start_busy( (int)me->query_skill("dugu-jiujian-sword") / 20 );
    } else {
        msg += "$p踉踉跄跄，左支右绌，千心万苦才勉强接下$P这招「破枪式」！\n" NOR;
    }
    message_vision(msg, me, target);
    return 1;
        }
        return notify_fail(target->name() + "目前手中使的不是枪棍类兵刃，得用其他招式。\n");
}
