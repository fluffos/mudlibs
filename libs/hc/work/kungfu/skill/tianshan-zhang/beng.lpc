#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  int damage;
  string msg;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("【山崩地裂】只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))

    || (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_skill("tianshan-zhang", 1) < 150)
    return notify_fail("你的天山杖法不够娴熟，不能使用【山崩地裂】! \n");
  if ((int)me->query_skill("huagong-dafa", 1) < 150)
    return notify_fail("你的化功大法的功力不够，不能使用【山崩地裂】！\n");
  if ((int)me->query("neili", 1) < 1000)
    return notify_fail("你现在内力太弱，不能使用【山崩地裂】。\n");

  msg = HIB "$N领悟到天山杖法的精髓- -" HIC "【山崩地裂】" HIM ",只见$N大喝一声
双目青芒乍现,手中钢杖以迅雷不及掩耳之势,夹杂万均之力
还有呼呼风声,向$n胸前砸去。\n" NOR;
  if (!target->is_killing(me)) target->kill_ob(me);
  if (random(me->query_skill("force")) > target->query_skill("force") / 3) {
    target->start_busy(7);

    damage = (int)me->query_skill("tianshan-zhang", 1);
    damage = damage + (int)me->query_skill("staff", 1);

    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage, me);
    me->add("neili", -damage / 2);
    msg += HIR "$n胸口被砸开，五脏六腹流的满地都是。！\n" NOR;
    me->start_busy(3);
  } else {
    msg += HIC "$p急速施展轻功，躲过了这个必杀之招。\n" NOR;
    me->add("neili", -800);
    me->start_busy(4);
  }
  message_vision(msg, me, target);
  return 1;
}
