int valid_enable(string usage) {
  return usage == "unarmed" || usage == "dodge" || usage == "parry";
}
int valid_learn(object me) {
  if (me->query("gender") != "男性")
    return notify_fail("这是恶魔的武功,女子无法领悟!\n");
  if ((int)me->query("max_neili") < 500000)
    return notify_fail("没有雄厚的内力是学不了玄天惊魔的。\n");
  if ((int)me->query_skill("jiuyang-shengong", 1) < 500)
    return notify_fail("你的九阳神功火候太浅。\n");
  if ((int)me->query("str") < 29)
    return notify_fail("你的天性指力这么弱,怎么承受玄天惊魔的巨大威力!\n");

  if ((int)me->query("int") < 30)
    return notify_fail("你的天性不适合学习玄天惊魔!\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("没有足够的精神怎么学习玄天惊魔!\n");
  return 1;
}

string query_parry_msg(object me, object weapon) {
  string msg;
  object my_weapon;

  if (!(my_weapon = me->query_temp("weapon"))) {
    if (!(my_weapon = me->query_temp("secondary_weapon")))
      return "";
  } else {
    if (!valid_enable(my_weapon->query("skill_type"))) {
      if (!(my_weapon = me->query_temp("secondary_weapon")))
        return "";
      else if (!valid_enable(my_weapon->query("skill_type")))
        return "";
    }
  }
  if (weapon)
    msg = weapon_vs_weapon_msg[random(sizeof(weapon_vs_weapon_msg))];
  else
    msg = unarmed_vs_weapon_msg[random(sizeof(unarmed_vs_weapon_msg))];
  msg = replace_string(msg, "$i", my_weapon->name());
  return msg;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  mapping a_action;
  int i, level;
  level = (int)me->query_skill("xuantian-jingmo", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"]) {
      a_action = action[NewRandom(i, 20, level / 5)];
      break;
    }
  a_action["dodge"] = 0 - level * 3;
  a_action["parry"] = 0 - level * 3;
  a_action["attack"] = level * 3 / 2;
  // for Not allowing jingmo so strong to kill everyone
  a_action["damage"] = level * 2 / 3;
  if (me->query_temp("action_flag"))
    me->set_temp("action_msg", "霎时间");
  return a_action;

}
string query_dodge_msg(string limb, object me) {
  me->set_temp("fight/dodge", me->query_skill("xuantian-jingmo", 1));
  return dodge_msg[random(sizeof(dodge_msg))];
}

// 玄天惊魔的特殊攻击
void do_interlink(object me, object victim) {
  int skill, i, j;
  object *enemy;

  skill = me->query_skill("xuantian-jingmo", 1);
  if (skill > 60) {
    enemy = me->query_enemy();
    if (!sizeof(enemy)) return;
    // 对所有敌人均自动进行攻击
    for (i = 0; i < sizeof(enemy); i++) {
      for (j = 0; j < (skill / (30 * sizeof(enemy))); j++)
        if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("qi") > 0) {
          if (environment(me) == environment(enemy[i])) {
            me->add_temp("str", skill / 20);
            me->add_temp("dex", skill / 20);
            COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_REGULAR);
          }
        } else break;
    }
    me->delete_temp("str");
    me->delete_temp("dex");
  }
}
