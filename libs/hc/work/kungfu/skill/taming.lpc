//taming.c
//驯兽术

inherit SKILL;

int valid_learn(object me) 
{
    int lvl;
    
    lvl = (int)me->query_skill("taming", 1);
    
    if ( me->query("family/family_name") != "白驼山派" )
        return notify_fail("此技能为白驼世代相传，不入白驼山派，恐怕不会有人教你。\n");
    
        if ( me->query("kar") < 30 )
                return notify_fail("相传驯兽之术千人之中才有一人有此资质，恐怕你能有此福缘。\n");
        
        return 1;
}

int practice_skill(object me)
{   
    return notify_fail("驯兽之术要想有大成需得实践才行。\n");
}

