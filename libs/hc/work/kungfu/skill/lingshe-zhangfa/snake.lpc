// snake.c 【群蛇乱舞】
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  int damage;
  string msg;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("【群蛇乱舞】只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))

    || (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_skill("lingshe-zhangfa", 1) < 150)
    return notify_fail("你的灵蛇杖法不够娴熟，不能使用【群蛇乱舞】! \n");
  if ((int)me->query_skill("hamagong", 1) < 150)
    return notify_fail("你的蛤玛功的功力不够，不能使用【群蛇乱舞】！\n");
  if ((int)me->query("neili", 1) < 1000)
    return notify_fail("你现在内力太弱，不能使用【群蛇乱舞】。\n");

  msg = HIG "$N使出白驼山的不传之秘" HIM "【群蛇乱舞】" HIM ",只见$N握着蛇杖快速旋转,
在周围的蛇象受了控制一样，都涌向$N身旁,吐着信子等侯命令。接
着$N把蛇杖向$n打过去,万条毒蛇也向$n全身射去。\n" NOR;
  if (!target->is_killing(me)) target->kill_ob(me);
  if (random(me->query_skill("force")) > target->query_skill("force") / 2) {
    target->start_busy(7);

    damage = (int)me->query_skill("lingshe-zhangfa", 1);
    damage = damage + (int)me->query_skill("staff", 1);

    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 1, me);
    me->add("neili", -damage / 2);
    msg += HIR "$n只觉全身一阵麻木，接着不醒人事了！\n" NOR;
    me->start_busy(3);
  } else {
    msg += HIY "可是$p咬住牙关运起了内功,把万条毒蛇震开了。\n" NOR;
    me->add("neili", -800);
    me->start_busy(4);
  }
  message_vision(msg, me, target);
  return 1;
}

inherit NPC;
void create() {
  set_name("流氓", ({ "liu mang", "liu" }));
  set("gender", "男性");
  set("age", 19);
  set("long", "他是一个成天游手好闲的流氓，长得倒是白白胖胖的，也许以前有过钱。\n");

  set("combat_exp", 1000);
  set("shen_type", -1);
  set("attitude", "peaceful");

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  setup();
  carry_object("/clone/misc/hic_cloth")->wear();
  add_money("silver", 2);
}
