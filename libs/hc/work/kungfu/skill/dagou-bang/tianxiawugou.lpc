#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        int damage;
        string msg;
        object weapon;

        if (!target ) target = offensive_target(me);
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "club")
                return notify_fail(RED"开什么玩笑，没装备棍就想用打狗棒法？\n"NOR);
        if (!target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("天下无狗只能对战斗中的对手使用。\n");
        if ((int)me->query_skill("dagou-bang", 1) < 100 )
                return notify_fail(HIR"你的打狗棒法不够娴熟，还使不出这等威力的招式。\n"NOR);
        if ((int)me->query_skill("huntian-qigong", 1) < 60 )
                return notify_fail(RED"你的混天气功不够，会被狗咬的。\n"NOR);
        if ((int)me->query("max_neili")<400)
                return notify_fail(RED"你的内力修为不足，无法运用天下无狗。\n"NOR);
        msg = HIR  "$N低喝一声［天下无狗］，内力聚于手中的"+ weapon->name() +"，"+
weapon->name() +
"化成满天棍影，昏天黑地般盖向$n！" NOR;
           if (random(me->query_skill("force")) > target->query_skill("force")/2 )
    {
        target->start_busy(3);
        
        damage = (int)me->query_skill("dagou-bang", 1);
        damage = damage +  (int)me->query_skill("club", 1);
         target->receive_damage("qi", damage*2/3,me);
 target->receive_wound("qi", damage/2,me);
        me->add("neili", -damage/2);
        msg += HIR"$n只觉一股劲气穿透胸膛，摇摇晃晃就要倒在地上！\n"NOR;
        me->start_busy(3);
    } else 
    {
        msg += CYN"可是$p猛地向后一跃,跳出了$P的攻击范围。\n"NOR;
        me->add("neili", -300);
        me->start_busy(4);
    }
    message_vision(msg, me, target);
    return 1;
}

