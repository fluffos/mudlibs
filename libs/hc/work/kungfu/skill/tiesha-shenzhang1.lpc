// yinyang.c  铁砂神掌十三绝之阴阳归一
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("神掌袭敌只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("tiesha-shenzhang", 1) < 300)
    return notify_fail("你的铁砂神掌不够娴熟，不会使用阴阳归一。\n");

  if ((int)me->query_skill("tiezhang-shengong", 1) < 300)
    return notify_fail("你的铁掌神功不够高，不能用来袭击敌人。\n");

  msg = HIG "$N默运铁掌神功，使出铁砂神掌之 [" + HIR + "阴阳归一" + NOR + "]，突然身子微侧，左掌在右掌上一拍，\n
右掌斜飞而出，直击向$n的小腹。\n" NOR;

  if (random(me->query_skill("force")) > target->query_skill("force") / 4) {
    me->start_busy(2);
    target->start_busy(random(6));

    damage = (int)me->query_skill("tiezhang-shengong", 1);
    damage = damage / 2 + random(damage);

    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 3);
    me->add("neili", -damage / 5);

    if (damage < 40) msg += HIY "结果$N受到$n的内力反震，虽然击中$N，自己却闷哼一声向后退了两步。\n" NOR;
    else if (damage < 80) msg += RED "结果$N被$n以内力反震，胸口有如受到一记重锤，连退了五六步！\n" NOR;
    else msg += HIR "$n茫然不知所措，结果被$N一掌击中腹部，$n眼前一黑，被击飞出两丈许！！！\n" NOR;

  } else {
    me->start_busy(1);
    msg += HIG "可是$p看破了$P的企图，早就闪在了一边。\n" NOR;
  }
  message_vision(msg, me, target);
  if (userp(target)) target->fight_ob(me);
  else if (!target->is_killing(me)) target->kill_ob(me);
  return 1;
}
