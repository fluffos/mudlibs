// self_skill.c 自己创造的招式

inherit SKILL;

int valid_enable(string usage)
{ 
    return (usage == this_player()->query("self_skill/skill_type"));
}

int valid_learn(object me)
{
    if(this_player() != me)
	return notify_fail("偷学人家的自创招式，太没有面子了吧。还是自己创一套好了。\n");
    else
	return 1;
}

string query_skill_name(int level)
{
    int i;
    mapping *action = this_player()->query("self_skill/action");

    for(i = sizeof(action)-1; i >= 0; i--)
	if(level >= action[i]["lvl"])
	    return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    mapping *action = me->query("self_skill/action");

    level   = (int) me->query_skill("self_skill",1);
    for(i = sizeof(action); i > 0; i--)
	if(level > action[i-1]["lvl"])
	    return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon"))
      || (string)weapon->query("skill_type") != me->query("self_skill/skill_type"))
	return notify_fail("你使用的武器不对。\n");
    if ((int)me->query("qi") < 50 || (int)me->query("jing") < 50)
	return notify_fail("你已经累得上气不接下气了。\n");
    me->receive_damage("qi", 25);
    me->receive_damage("jing", 25);
    return 1;
}

