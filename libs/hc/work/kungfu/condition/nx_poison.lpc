//by ahxia, y2k, 8. 31
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
//CHANNEL_D->do_channel(me,"debug",sprintf("%s(%s) nx_poison condition with duration %-i .",me->name(1),me->query("id"),duration));
    if( duration < 1 ) return 0;
    me->apply_condition("nx_poison", duration - 1);
    if( duration < 1 ) return 0;
    return CND_CONTINUE;
}
