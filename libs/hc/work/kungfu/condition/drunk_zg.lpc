//改编自drunk.c 为了zuigun的pfm加强浓度的酒毒，呵呵
//By Swordman@HC 2002/11/10
inherit F_CLEAN_UP;
int update_condition(object me, int duration) {
  int limit_zg;
  limit_zg = (me->query("con") + 5000 + (int)me->query("max_neili") / 5000) * 2;
  if (duration > limit_zg
    && living(me)) {
    me->unconcious();
    return 0;
  } else if (!living(me)) {
    message("vision", me->name() + "摇晃了一下脑袋，似乎没有清醒多少。\n",
      environment(me), me);
  } else if (duration > limit_zg / 2) {
    tell_object(me, "你突然感到一股酒气直冲头顶，脑袋开始晕菜菜的了。\n");
    message("vision", me->name() + "脸色越发通红，看来酒精开始发威了。\n",
      environment(me), me);
    me->receive_damage("jing", 10);
  } else if (duration > limit_zg / 3) {
    tell_object(me, "你觉得胃中上下翻腾，头越来越晕了。\n");
    message("vision", me->name() + "脸上一阵红一阵白，看来确实喝多了。\n",
      environment(me), me);
    me->receive_healing("jing", 10);
    me->receive_healing("qi", 15);
  }
  me->apply_condition("drunk_zg", duration - 1);
  if (!duration) return 0;
  return 1;
}
