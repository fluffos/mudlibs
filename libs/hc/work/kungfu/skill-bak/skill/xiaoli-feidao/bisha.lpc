//bisha 必杀
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  object my_w, ob_w;
  my_w = me->query_temp("weapon");

  if (!target) target = offensive_target(me);
  if (!target)
    return notify_fail("你要对谁使用「必杀诀」?\n");
  ob_w = target->query("name");


  if (!(me->is_fighting()))
    return notify_fail("你只能对战斗中的对手使用「必杀诀」。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正疲于招架，加紧攻击吧。\n");

  if ((int)me->query_skill("xiaoli-feidao", 1) < 1)
    return notify_fail("你的小李飞刀不够娴熟，不能使用「必杀诀」。\n");

  msg = CYN "$N大喝一声，展开小李飞刀「必杀诀」，之间连递数个刀影向$n飞去。\n";
  me->start_busy(2);

  if (target->query_temp("weapon") ||
    target->query_temp("secondary_weapon")) {

    if (random(me->query("combat_exp")) > 1) {

      msg += "结果$n胸口中刀，大吼一声，倒地而亡。\n" NOR;
      ob_w->die();
    }
  } else {
    msg += "可是$n通过巧妙的招架，$N的计谋没有得逞。\n" NOR;

  }
  message_vision(msg, me, target);
  return 1;
}
