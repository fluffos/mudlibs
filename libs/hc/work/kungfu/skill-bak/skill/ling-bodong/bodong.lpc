// bodong.c 灵光波动
// by Swordman

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if (target != me)
    return notify_fail("你只能用灵波动来提高自己的战斗力。\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的灵力不够!");

  if ((int)me->query_temp("bodong"))
    return notify_fail("你的灵光波动已经催动开了。\n");

  skill = me->query_skill("force");

  me->add("neili", -100);
  me->receive_damage("qi", 0);

  message_vision(
    HIC "$N眼中精光暴长，全身灵力尽放而出，周围被一股荧光环环围绕......!\n" NOR, me);

  me->add_temp("apply/attack", skill / 3);
  me->add_temp("apply/dodge", skill / 3);
  me->set_temp("bodong", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 3 :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount) {
  if ((int)me->query_temp("bodong")) {
    me->add_temp("apply/attack", -amount);
    me->add_temp("apply/dodge", -amount);
    me->delete_temp("bodong");
    tell_object(me, "你的灵波动逐渐减弱，灵力逐渐的回到体内，周身荧光逐一进入身体中。\n");
  }
}
