// heal.c 灵光疗伤
// by Swordman

#include <ansi.h>

int exert(object me, object target) {
  if (me->is_fighting())
    return notify_fail("战斗中运功疗伤？找死吗？\n");

  if ((int)me->query_skill("ling-bodong", 1) < 20)
    return notify_fail("你的灵光波动修为还不够。\n");
  if ((int)me->query("neili") < 50)  // - (int)me->query("max_neili") < 50 )
    return notify_fail("你的灵力不够。\n");

  if ((int)me->query("eff_qi") < (int)me->query("max_qi") / 2)
    return notify_fail("你已经受伤过重，只怕催动灵力便有生命危险！\n");

  write(HIC "你散开全身灵力，念动灵波动疗伤咒语，全身散发出隐隐灵光。\n" NOR);
  message("vision",
    HIC + me->name() + "的脸色越发红润，散布周身的灵光逐渐退回到身体之中，\n" NOR,
    environment(me), me);

  me->receive_curing("qi", 10 + (int)me->query_skill("force") / 5);
  me->add("neili", -50);
  me->set("jiali", 0);
  me->start_busy(4);

  return 1;
}
