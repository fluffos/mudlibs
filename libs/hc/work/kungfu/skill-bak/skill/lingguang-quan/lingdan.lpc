//lingdan.c  「灵弹」
// by Swordman
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「" + HIC "灵弹" NOR + "」只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("ling-bodong", 1) < 100)
    return notify_fail("你的灵波动功力不够，使不出「" + HIC "灵弹" NOR + "」。\n");

  if ((int)me->query_skill("lingguang-quan", 1) < 100)
    return notify_fail("你的灵光拳不够熟练，仍没领会到「" + HIC "灵弹" NOR + "」。\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的灵力修为还不够高。\n");

  msg = HIC "
$N散出全身灵力，将灵力凝结于右手食指之上，但见荧光大闪，灵光拳中最大奥义「" + HIC "灵弹" NOR + "」
已瞄准了$n，突然间$N身形骤然不见，$n定睛再看，一颗灵弹已经飞至眼前。\n" NOR;

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    me->start_busy(3);
    target->start_busy(random(3));

    damage = (int)me->query_skill("lingguang-quan", 1) * 4 + (int)me->query_skill("ling-bodong", 1);

    damage = damage + random(damage);

    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 2);
    me->add("neili", -500);
    msg += HIR "
$n只见$N发出的灵弹正面飞来，想闪身躲开已经来不急了。结果被重击了一下，口中鲜血如水雾般喷出!!!\n" NOR;
  } else {
    me->start_busy(1);
    msg += HIG "可是$p看破了$P的企图，闪在了一边。\n" NOR;
  }
  message_vision(msg, me, target);

  if (!target->is_fighting(me)) target->fight_ob(me);
  //    if(userp(target)) target->fight_ob(me);
  //    else if( !target->is_killing(me) ) target->kill_ob(me);
  return 1;
}
