// legendd.c

string *legend = ({ });

string *query_legend()
{
        return legend;
}

string *clear_legend()
{
        legend=({});
}

string random_legend()
{
        int i;
        
        i = sizeof(legend);
        
        return legend[random(i)];
}

void add_legend(string addleg)
{
        legend += ({addleg});
}

void delete_legend(int i)
{
        legend -= ({legend[i]});
}

