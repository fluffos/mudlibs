// inspectd.c

void inspect()
{
        object *ob;
        object man;
        
        remove_call_out("inspect");
        
        ob = users();
        
        for ( int i = 0 ; i < sizeof(ob) ; i++ )
                if ( ob[i] && environment(ob[i]) && ob[i]->query("killer_level") >= 3 ){
                        man = new("/clone/npc/superman.lpc");
                        man->set("target",ob[i]->query("id"));
                        man->move(environment(ob[i]));
                        man->set_leader(ob[i]);
                        man->kill_ob(ob[i]);
                        call_out("inspect",120);
                        return;
                }
        call_out("inspect",120);
}

void create()
{
        seteuid(getuid());
        
        call_out("inspect",120);
}
