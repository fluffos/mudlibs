string money_str(int amount)
{
        // returns a chinese string of `amount` of money
        string output;

        if (amount / 100000) {
                output = chinese_number(amount / 100000) + "张金票";
                amount %= 100000;
        }
        else
                output = "";
        if (amount / 10000) {
                output = output + chinese_number(amount / 10000) + "两黄金";
                amount %= 10000;
        }
        if (amount / 1000) {
                output = output + chinese_number(amount / 1000) + "张银票";
                amount %= 1000;
        }
        if (amount / 100) {
                output = output + chinese_number(amount / 100) + "两白银";
                amount %= 100;
        }
        if (amount)
                return output + chinese_number(amount) + "文铜板";
        return output;
}

string price_str(int amount)
{
        // returns a chinese string of `amount` of money
        string output;

        if (amount < 1)
                amount = 1;

        if (amount / 1000000) {
                output = chinese_number(amount / 1000000) + "张金票";
                amount %= 1000000;
        }
        else
                output = "";
        if (amount / 10000) {
                if (output != "")
                        output += "又" + chinese_number(amount / 10000) + "两黄金";
                else
                        output = chinese_number(amount / 10000) + "两黄金";
                amount %= 10000;
        }
        if (amount / 1000) {
                if (output != "")
                        output += "又" + chinese_number(amount / 1000) + "张银票";
                else
                        output = chinese_number(amount / 1000) + "张银票";
                amount %= 1000;
        }
        if (amount / 100) {
                if (output != "")
                        output += "又" + chinese_number(amount / 100) + "两白银";
                else
                        output = chinese_number(amount / 100) + "两白银";
                amount %= 100;
        }
        if (amount)
                if (output != "")
                        return output + "又" + chinese_number(amount) + "文铜板";
                else
                        return chinese_number(amount) + "文铜板";
        return output;
}

void pay_player(object who, int amount)
{
        int v,total,tgc, gc, tsc, sc, cc, left;
        object ob,tg_ob, g_ob, ts_ob, s_ob, c_ob;
        seteuid(getuid());
        if (tg_ob = present("tengold_money", who))
                tgc = tg_ob->query_amount();
        else
                tgc = 0;
        if (g_ob = present("gold_money", who))
                gc = g_ob->query_amount();
        else
                gc = 0;
        if (ts_ob = present("tensilver_money", who))
                tsc = ts_ob->query_amount();
        else
                tsc = 0;
        if (s_ob = present("silver_money", who))
                sc = s_ob->query_amount();
        else
                sc = 0;
        if (c_ob = present("coin_money", who))
                cc = c_ob->query_amount();
        else
                cc = 0;

                left = cc + sc * 100 + tsc * 1000 + gc * 10000 + tgc * 100000 + amount;
                tgc = left / 100000;
                left = left % 100000;

                gc = left / 10000;
                left = left % 10000;

                tsc = left / 1000;
                left = left % 1000;

                sc = left / 100;
                cc = left % 100;

                if (tg_ob)
                        tg_ob->set_amount(tgc);
                else if (tgc) {
                        tg_ob = new(TGOLD_OB);
                        tg_ob->set_amount(tgc);
                        tg_ob->move(who);
                }
                if (g_ob)
                        g_ob->set_amount(gc);
                else if (gc) {
                        g_ob = new(GOLD_OB);
                        g_ob->set_amount(gc);
                        g_ob->move(who);
                }
                if (ts_ob)
                        ts_ob->set_amount(tsc);
                else if (tsc) {
                        ts_ob = new(TSILVER_OB);
                        ts_ob->set_amount(tsc);
                        ts_ob->move(who);
                }
                if (s_ob)
                        s_ob->set_amount(sc);
                else if (sc) {
                        s_ob = new(SILVER_OB);
                        s_ob->set_amount(sc);
                        s_ob->move(who);
                }
                if (c_ob)
                        c_ob->set_amount(cc);
                else if (cc) {
                        c_ob = new(COIN_OB);
                        c_ob->set_amount(cc);
                        c_ob->move(who);
                }
//              return 1;
/*
        if (amount < 1)
                amount = 1;
                amount = amount + total;
        if (v = amount / 1000000) {
                ob = new(HGOLD_OB);
                ob->set_amount(amount / 1000000);
                ob->move(who);
                amount %= 1000000;
        }
        if (v = amount / 10000) {
                ob = new(GOLD_OB);
                ob->set_amount(amount / 10000);
                ob->move(who);
                amount %= 10000;
        }
        if (amount / 100) {
                ob = new(SILVER_OB);
                ob->set_amount(amount / 100);
                ob->move(who);
                amount %= 100;
        }
        if (amount) {
                ob = new(COIN_OB);
                ob->set_amount(amount);
                ob->move(who);
        }
*/
}

int player_pay(object who, int amount)
{
        object tg_ob, g_ob, ts_ob, s_ob, c_ob;
        int tgc, gc, tsc, sc, cc, left;

        seteuid(getuid());

        if (tg_ob = present("tengold_money", who))
                tgc = tg_ob->query_amount();
        else
                tgc = 0;
        if (g_ob = present("gold_money", who))
                gc = g_ob->query_amount();
        else
                gc = 0;
        if (ts_ob = present("tensilver_money", who))
                tsc = ts_ob->query_amount();
        else
                tsc = 0;
        if (s_ob = present("silver_money", who))
                sc = s_ob->query_amount();
        else
                sc = 0;
        if (c_ob = present("coin_money", who))
                cc = c_ob->query_amount();
        else
                cc = 0;
        if (cc + sc * 100 + sc * 1000 + gc * 10000 + tgc * 100000 < amount) 
                if (present("thousand-gold_money", who))
                        return 2;
                else 
                        return 0;
        else {
                left = cc + sc * 100 + tsc * 1000 + gc * 10000 + tgc * 100000 - amount;
                tgc = left / 100000;
                left = left % 100000;

                gc = left / 10000;
                left = left % 10000;

                tsc = left / 1000;
                left = left % 1000;

                sc = left / 100;
                cc = left % 100;
/*
                if (tg_ob)
                        tg_ob->set_amount(tgc);
                else gc += (tgc * 10);
*/
                if (tg_ob)
                        tg_ob->set_amount(tgc);
                else if (tgc) {
                        tg_ob = new(TGOLD_OB);
                        tg_ob->set_amount(tgc);
                        tg_ob->move(who);
                }
                if (g_ob)
                        g_ob->set_amount(gc);
                else if (gc) {
                        g_ob = new(GOLD_OB);
                        g_ob->set_amount(gc);
                        g_ob->move(who);
                }
                if (ts_ob)
                        ts_ob->set_amount(tsc);
                else if (tsc) {
                        ts_ob = new(TSILVER_OB);
                        ts_ob->set_amount(tsc);
                        ts_ob->move(who);
                }
                if (s_ob)
                        s_ob->set_amount(sc);
                else if (sc) {
                        s_ob = new(SILVER_OB);
                        s_ob->set_amount(sc);
                        s_ob->move(who);
                }
                if (c_ob)
                        c_ob->set_amount(cc);
                else if (cc) {
                        c_ob = new(COIN_OB);
                        c_ob->set_amount(cc);
                        c_ob->move(who);
                }

                return 1;
        }
}

