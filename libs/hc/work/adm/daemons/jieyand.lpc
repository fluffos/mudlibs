#include <localtime.h>

inherit F_CLEAN_UP;

int is_jieyan()
{
        int hour,minute;
        int segments;
        string start_time,end_time;
        int start_hour,end_hour,start_minute,end_minute;
        mixed *local = localtime(time());    
    hour = local[LT_HOUR];
    minute = local[LT_MIN];

        segments = ENV_D->query("jieyan/segments");
        
        if ( !segments )
                return 0;
        
        for ( int i = 1; i <= segments ; i++ ){
                start_time = ENV_D->query(sprintf("jieyan/segment_%d/start_time",i));
                end_time = ENV_D->query(sprintf("jieyan/segment_%d/end_time",i));
                sscanf(start_time,"%d:%d",start_hour,start_minute);
                sscanf(end_time,"%d:%d",end_hour,end_minute);
        
        //判断当前时间是不是落在时间段内        
                if ( (hour > start_hour) && (hour < end_hour) )
                        return 1;
                
                if (hour == start_hour)
                        if ( minute >= start_minute )
                                return 1;
                
                if ( hour == end_hour )
                        if ( minute <= end_minute )
                                return 1;
        }
        return 0;
}
