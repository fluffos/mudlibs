//#pragma optimize all

#ifndef __SENSIBLE_MODIFIERS__
#endif

#include <globals.h>
void create()
{
    seteuid( ROOT_UID );
    write("simul_efun 成功加载.\n");
}

#include "/adm/simul_efun/atoi.lpc"
#include "/adm/simul_efun/chinese.lpc"
#include "/adm/simul_efun/gender.lpc"
#include "/adm/simul_efun/object.lpc"
#include "/adm/simul_efun/path.lpc"
#include "/adm/simul_efun/wizard.lpc"
// This must be after gender.c
#include "/adm/simul_efun/message.lpc"
#include "/adm/simul_efun/file.lpc"

//modified snoop log file part.
varargs object snoop(object who, object target) 
{
    if(!target) return efun::snoop(who);
    return efun::snoop(who, target);
}

void shutdown(int etc)
{
        if( base_name(previous_object())!=NATURE_D) return 0;
        efun::shutdown(etc);
}
void destruct(object ob)
{
    string err;

    if ( ob )
    {
	if ( previous_object() )
	    err = catch(ob->remove( geteuid(previous_object()) ));
	else
	    err = catch(ob->remove(0));
	if ( err )
	{
	    if ( userp(ob) && geteuid(previous_object())!=ROOT_UID )
		return;
	}
	efun::destruct(ob);
    }
}
