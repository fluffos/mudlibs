// atoi.c
int atoi(string str) {
  int v;
  if (!stringp(str) || !sscanf(str, "%d", v)) return 0;
  return v;
}
int movee() {
  int i;
  for (i = 0; i < 1000; i++) {
    new("/clone/user/login");
    reset_eval_cost();
  }
  for (i = 0; i < 1000; i++)
    load_object("/clone/user/login");
}
