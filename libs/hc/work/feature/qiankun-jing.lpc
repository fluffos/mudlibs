// qiankun-jing.c 
// builded by wings

#include <ansi.h>

inherit ITEM;
inherit F_UNIQUE;

int do_attach(string arg);
int do_reflect(string arg);

nosave int use_times = 5000;

void create() {
  set_name(HIG "乾坤镜" NOR, ({ "qiankun jing", "jing" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("value", 10000);
    set("long", "乾坤镜，上古十大神器之一，持有者将拥有时空转移的惊人力量！\n");
    set("no_drop", 1);
    set("no_get", 1);
    set("material", "glass");
  }

  setup();
}

void init() {
  ::init();

  add_action("do_attach", "attach");
  add_action("do_reflect", "reflect");
}

int do_attach(string arg) {
  object dest, env, me;

  me = this_player();

  if (me->is_busy() /* || me->is_fighting() */)  //暂时去掉战斗判定
    return notify_fail("你正忙着呢！\n");

  if (--use_times < 0) {
    message_vision(
      HIW "突然" HIG "乾坤镜" HIW "从$N手中凌空而起，化作一道霞光向" + (random(2) ? "东方" : "西方") + "消逝而去！\n" NOR,
      me
    );
    destruct(this_object());
  }

  if (!arg) {
    if (random(10) == 0) {
      message_vision(
        HIW "突然" HIG "乾坤镜" HIW "从$N手中凌空而起，化作一道霞光向" + (random(2) ? "东方" : "西方") + "消逝而去！\n" NOR,
        me
      );
      destruct(this_object());
    } else
      return notify_fail("乾坤镜乃有灵性之物，千万别惹恼了它！\n");
  }

  dest = find_player(arg);

  if (!dest) {
    if (random(10) == 0) {
      message_vision(
        HIW "突然" HIG "乾坤镜" HIW "从$N手中凌空而起，化作一道霞光向" + (random(2) ? "东方" : "西方") + "消逝而去！\n" NOR,
        me
      );
      destruct(this_object());
    } else
      return notify_fail("找不到目标，乾坤镜乃有灵性之物，千万别惹恼了它！\n");
  }

  if (wizardp(dest) || !(env = environment(dest))) {
    message_vision(HIG "乾坤镜" HIW "“呼”地闪了一下，转而归于平静。\n" NOR, me);
    return 1;
  }

  message_vision(HIC "$N举起手中的" HIG "乾坤镜" HIC "映出一圈光环，随后踏入进去...\n" NOR, me);
  tell_object(me, HIM "\n经过一阵亦真亦幻的异次元，你终于到达了目的地！\n\n" NOR);

  me->move(env);
  me->start_busy(1);

  tell_room(env, HIC "\n突然空中隐现出一圈光环，赫然从之中走出" + me->name() + "来！\n\n" NOR, me);
  return 1;
}

int do_reflect(string arg) {
  object me;

  me = this_player();

  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (--use_times < 0) {
    message_vision(
      HIW "突然" HIG "乾坤镜" HIW "从$N手中凌空而起，化作一道霞光向" + (random(2) ? "东方" : "西方") + "消逝而去！\n" NOR,
      me
    );
    destruct(this_object());
  }

  if (!arg) {
    if (random(10) == 0) {
      message_vision(
        HIW "突然" HIG "乾坤镜" HIW "从$N手中凌空而起，化作一道霞光向" + (random(2) ? "东方" : "西方") + "消逝而去！\n" NOR,
        me
      );
      destruct(this_object());
    } else
      return notify_fail("乾坤镜乃有灵性之物，千万别惹恼了它！\n");
  }

  if ((arg != "up") && (arg != "down")) {
    if (random(10) == 0) {
      message_vision(
        HIW "突然" HIG "乾坤镜" HIW "从$N手中凌空而起，化作一道霞光向" + (random(2) ? "东方" : "西方") + "消逝而去！\n" NOR,
        me
      );
      destruct(this_object());
    } else
      return notify_fail("乾坤镜乃有灵性之物，千万别惹恼了它！\n");
  }

  if (arg == "up") {
    if (me->query("mud_age") >= 24710400) {
      tell_object(me, HIB "你运灵力于乾坤镜面，但是乾坤镜一点反应都没有。\n" NOR);
      return 1;
    } else {
      tell_object(me, HIB "你运灵力于乾坤镜面，从乾坤镜光滑的镜面上映去，你似乎变得苍老了一点。\n" NOR);
      if (me->query("per") > 10)
        if (random(3000) == 0) {
          me->add("per", -1);
          tell_object(me, HIW "你似乎越来越丑陋了。\n" NOR);
        }
      me->add("mud_age", 5);
      me->start_busy(3);
      return 1;
    }
  }

  if (arg == "down") {
    if (me->query("mud_age") <= 345600) {
      tell_object(me, HIB "你运灵力于乾坤镜面，但是乾坤镜一点反应都没有。\n" NOR);
      return 1;
    } else {
      tell_object(me, HIB "你运灵力于乾坤镜面，从乾坤镜光滑的镜面上映去，你似乎变得年轻了一点。\n" NOR);
      if (me->query("per") < 30)
        if (random(3000) == 0) {
          me->add("per", 1);
          tell_object(me, HIW "你似乎越来越漂亮了。\n" NOR);
        }
      me->add("mud_age", -5);
      me->start_busy(3);
      return 1;
    }
  }

  return notify_fail("乾坤镜出错：请报告巫师。\n");
}
