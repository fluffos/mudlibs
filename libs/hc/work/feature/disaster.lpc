//判断浩劫是否被平息
void verdict_end() {
  int sum = 0;

  if (!Cnpcend) return;
  sum += query_children("/d/haojie/npc/pker9.lpc");
  sum += query_children("/d/haojie/npc/pker8.lpc");
  sum += query_children("/d/haojie/npc/pker7.lpc");
  sum += query_children("/d/haojie/npc/pker6.lpc");
  sum += query_children("/d/haojie/npc/pker5.lpc");
  sum += query_children("/d/haojie/npc/pker4.lpc");
  sum += query_children("/d/haojie/npc/pker3.lpc");
  sum += query_children("/d/haojie/npc/pker2.lpc");
  sum += query_children("/d/haojie/npc/pker1.lpc");
  if (sum > 1) return;

  if (count + 1 != sizeof(factions)) {
    shout(HIR "【江湖传闻】" MAG + faction + "弟子在" + lead->name() + "的带领下，杀得敌人溃不成军，大败而逃！\n" NOR);
    shout(HIW "【闲聊】七杀门首领天杀星：他奶奶的，点子手硬，闪先！\n" NOR);
    shout(HIW "【" + HIM MUD_NAME + HIW "】暂时击退敌人，江湖局势得到缓解，临时解除戒严状态！\n" NOR);
    call_out("disaster", 20, count + 1);
  } else {
    shout(HIR "【江湖传闻】" MAG "各大门派接成联盟，在" + lead->name() + "的带领下，终于挫败了神秘组织的阴谋，江湖又恢复了往日的平静。\n" NOR);
    shout(HIW "【" + HIM MUD_NAME + HIW "】敌方大败，江湖恢复平静，解除戒严状态！\n" NOR);
    shout(HIW "【闲聊】七杀门首领天杀星仰天狂叫：我不服！！我不服！！！我不服！！！！\n" NOR);
    call_out("juedou", 5);
  }
  LOGIN_D->set_madlock(0);

}
void juedou() {
  object ob;
  object *user;
  int i, exp, skill, killer = 0;

  user = users();
  for (i = 0; i < sizeof(user); i++)
    if (user[i]->query_temp("hj_killer") > killer) lead = user[i];

  ob = new("/d/haojie/obj/zhanshu.lpc");
  ob->move(lead);
  message_vision(HIY "一张战书飘到了$N的面前。\n" NOR, lead);
  shout(HIM "【谣言】" + "听说" + lead->name() + HIM "得到了一张七杀门首领天杀星的挑战书。\n" NOR);

  exp = lead->query("combat_exp");
  skill = lead->query_skill("parry", 1);
  ob = new("/d/haojie/npc/tianshaxing.lpc");
  ob->set("pk_target", lead);
  set_status(ob, exp, skill);
  ob->move("/d/city/guangchang.lpc");
  message_vision("$N凶神恶煞的走了过来。\n", ob);
}

//取指定pker的人数
int query_children(string arg) {
  object *ch;
  int i, sum = 0;

  ch = children(arg);
  for (i = 0; i < sizeof(ch); i++)
    if (environment(ch[i])) sum++;
  return sum;
}

//定时判断浩劫发生的时间是否超过期限，超过则给予玩家惩罚
void verdict_time() {
  object *user;
  int i, exp, parry, force;

  //设置浩劫的期限为30分钟(1800秒)
  if ((time() - hj_startT) < 1800) {
    remove_call_out("verdict_time");
    call_out("verdict_time", 60);
    return;
  }
  if (!LOGIN_D->get_madlock()) return;

  user = users();
  if (faction != "扬州城")
    for (i = 0; i < sizeof(user); i++) {
      if (user[i]->query("family/family_name") != faction) continue;
      if (!user[i]) continue;
      //                      exp = (int) user[i]->query("combat_exp") * 0.97;
      parry = (int)user[i]->query_skill("parry", 1) * 0.99;
      force = (int)user[i]->query_skill("force", 1) * 0.99;
      //                      if (exp > 1000) user[i]->set("combat_exp",exp);
      if (parry > 5) user[i]->set_skill("parry", parry);
      if (force > 5) user[i]->set_skill("force", force);
    } else for (i = 0; i < sizeof(user); i++) {
      if (!user[i]) continue;
      exp = (int)user[i]->query("combat_exp") * 0.97;
      parry = (int)user[i]->query("balance") * 0.75;
      if (exp > 1000) user[i]->set("combat_exp", exp);
      if (parry > 0) user[i]->set("balance", parry);
    }
  if (count + 1 != sizeof(factions)) {
    shout(HIR "【江湖传闻】" MAG + faction + "弟子力战之下，伤亡惨重，从此消声匿迹。\n" NOR);
    shout(HIW "【闲聊】七杀门首领天杀星冷哼一声：下一个！\n" NOR);
    shout(HIW "【" + HIM MUD_NAME + HIW "】敌人暂时撤退了，现在解除戒严状态！\n" NOR);
    call_out("disaster", 10, count + 1);
  } else {
    shout(HIR "【江湖传闻】" MAG "虽然各派奋力杀敌，无奈悬殊太大，还是败下阵来，一时间腥风血雨，武林一片混暗。\n" NOR);
    shout(HIW "【" + HIM MUD_NAME + HIW "】七杀门大获全胜，江湖一片黑暗，现在解除戒严状态！大家快逃命吧!\n" NOR);
  }
  LOGIN_D->set_madlock(0);

}

//设置和读取浩劫的开始时间
void set_hj_startT(int i) {
  hj_startT = i;
}
int query_hj_startT() {
  return hj_startT;
}
