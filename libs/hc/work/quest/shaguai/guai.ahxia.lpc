#include <ansi.h>;
inherit "/quest/shaguai/npcskill_n";
#include <command.h>;



object me=this_object(),questob,killertemp;
string username;
string *first_name = ({ "赵","钱","孙","李","金","姑苏","慕容","郑","王","周","吴",
  "刘","林" });
string *name_words = ({ "志","忠","良","志","忠","大","彦","良","勇","元","华","宏",
  "孝","雄","龙","明","文","武","斌","来","胜","进","铭","彬","东","伟" });
string *rnd_id = ({"wa","zh","ta","pu","gu","du","su","pa","la","pi","ti","ne","she"});
string *rnd_id_tail = ({"ng","gh","ss","h","le","d","ck","m","tte"});

string *name_wordss = ({ "英","媚","珍","华","盈","小","红","婷","娴","小","娩","妙",
  "娟","如","絮","妲","妮","妹","姑","娥","娜","媸","妯","芳","芬","香" });
string name, id;


int die();
void create()
{  
    int level,chooseguai;
    object guai;   
    guai=this_object();

    //以下程序分配怪的名字
    name = first_name[random(sizeof(first_name))];

    if (random(3)>1){
	set("gender", "男性");
	name += name_words[random(sizeof(name_words))];
	if( random(10) > 2 ) name += name_words[random(sizeof(name_words))];
    }else{
	set("gender", "女性");
	name += name_wordss[random(sizeof(name_wordss))];
	if( random(10) > 2 ) name += name_wordss[random(sizeof(name_wordss))];
    }
    id = rnd_id[random(sizeof(rnd_id))];
    if( random(10) > 4 ) id += rnd_id[random(sizeof(rnd_id))];
    id += rnd_id_tail[random(sizeof(rnd_id_tail))];
    set_name(name, ({ id+" mo", "mo" }) );
    set("env/wimpy", 30);
    set("per",10);
    set("age",60);
    set("attitude", "friendly");
    set("no_suck",1);
    set_temp("apply/armor",600);
    set("chat_chance",10);
    set("chat_msg",({
	(:random_move:)}));
    set("chat_chance_combat",random(90));
    setup();
    carry_object("/clone/cloth/male"+(1+random(8))+"-cloth")->wear();
}
int setguaiskill(int chooseguai,int level,object guai)
{  
    //   set_std_skills(level,guai);
    switch (chooseguai)
    {
    case 0:set_gumu_guai(level,guai);break;
    case 1:set_emei_guai(level,guai);break;
    case 2:set_quanzhen_guai(level,guai);break;
    case 3:set_wudang_guai(level,guai);break;
    case 4:set_shaolin_guai(level,guai);break;
    case 5:set_baituo_guai(level,guai);break;
    case 6:set_mz_guai(level,guai);break;
    case 7:set_huashan_guai(level,guai);break;
    case 8:set_xingxiu_guai(level,guai);break;
    case 9:set_mingjiao_guai(level,guai);break;
    case 10:set_shenlong_guai(level,guai);break;
    case 11:set_taohua_guai(level,guai);break;
    case 10:set_xiaoyao_guai(level,guai);break;
    case 11:set_xueshan_guai(level,guai);break;
    default:set_mz_guai(level,guai);break;
    }
}
//怪怎么也会疗伤?
void heart_beat()
{

    int qi,effqi,maxqi;
    maxqi=(int)this_object()->query_temp("maxqi");   
    effqi=(int)this_object()->query("eff_qi");
    qi=query("qi");
    if (effqi<maxqi/3) command("exert heal");

    ::heart_beat();
}

int check_time()
{
    if (!query_temp("appear")) 
    {
	set_temp("appear",1);
	call_out("check_time",900);
	return 1;
    }
    if (me->is_fighting()) 
    {
	call_out("check_time",600);
	return 1;
    }
    remove_call_out("check_time");
    message_vision(MAG"$N眼见情况不妙，大叫一声，溜了。\n"NOR,
    );
    destruct(this_object());
}


int die()
{
    int pot,exp;
    object killerob,me;
    mixed questob;
    me=this_object();
    killerob=me->query_temp("last_damage_from");

    questob=(object)me->query_temp("player"); 

    remove_action("do_drive","drive");

if( !questob ) { destruct(me); return 1; }
    questob->set_temp("kill",0); 
    if (!killerob) 
    {   
	message_vision("$N惨叫一声，死了。\n",this_object());
	tell_object(questob,"你得到了零点经验和零点潜能！\n"NOR);
	destruct(me);
	return 1;
    }
    else if (killertemp)
    {
	if (killertemp!=killerob)
	{
	    message_vision("$N惨叫一声，死了。\n",this_object());
	    tell_object(questob,"你得到了零点经验和零点潜能！\n"NOR);
	    destruct(me);
	    return 1;
	}
    } 
    if (killerob->query("id")!=questob->query("id"))
    {  
	message_vision("$N惨叫一声，死了。\n",this_object());
	tell_object(questob,"你得到了零点经验和零点潜能！\n"NOR);
	destruct(me);
	return 1;
    }
    /*
	switch(random(4))
	 {
	   case 1: message_vision("$N惨叫一声，死了。\n",this_object());break;
	   case 2: message_vision("$N惨叫一声，死了。\n"
		   questob,this_object());break;
	   case 3: message_vision("$N惨叫一声，死了。\n"
		   questob,this_object());break;
	   default :message_vision("$N惨叫一声，死了。\n",questob,this_object());
	 }
    */
    if(me->query("qi")<= 1){
	message_vision("$N惨叫一声，死了。\n",this_object());
	pot=me->query_temp("killrewardpot");
	exp=me->query_temp("killrewardexp");
	questob->add("potential",pot);
	questob->add("combat_exp",exp);
	tell_object(questob,"你得到了"+HIW+
	  chinese_number(exp)+NOR"点经验和"+HIW+chinese_number(pot)+NOR"点潜能\n");
	destruct(me);
	return 1;
    }
    message_vision("$N惨叫一声，死了。\n",this_object());
    pot=me->query_temp("killrewardpot");
    exp=me->query_temp("killrewardexp");
    questob->add("potential",pot);
    questob->add("combat_exp",exp);
    tell_object(questob,"你得到了"+HIW+
      chinese_number(exp)+NOR"点经验和"+HIW+chinese_number(pot)+NOR"点潜能\n");
    destruct(me);
    return 1;

}
//不能让别人帮忙打晕怪   
void unconcious()
{
    killertemp=query_temp("last_damage_from");
    die();
}       
void init()
{
    if (is_busy()) return;
    add_action("do_drive","drive");
    username=query_temp("killername");
    if ((int)environment(me)->query("no_fight")) return; 
    if (this_player()->query("id")==username)
    { 
	if (query_temp("firstsee")==0||!query_temp("firstsee"))
	{  if(random(40)>20){     
		message_vision(HIR"$N恶狠狠地盯着$n，大叫一声，竟然找上门来了，今天不是你死就是我亡！\n"NOR
		  ,this_object(),this_player());
		this_object()->kill_ob(this_player());  
		command("follow "+this_player()->query("id"));}
	    else this_object()->command("? "+this_player()->query("id"));
	    set_temp("firstsee",1);

	}
	set_heart_beat(1);
	if(random(40)<20) this_object()->kill_ob(this_player());



    }   
}

int do_drive(string arg)
{
    mapping exits;
    string *dirs;
    int size;
    if (arg==(string)this_object()->query("id"))
    {
	if (environment()->query("no_fight"))
	{
	    exits=environment()->query("exits");      
	    dirs=keys(exits);
	    size=sizeof(dirs);
	    if (size>0)
	    { 
		this_player()->command("follow "+this_object()->query("id"));
		command("go "+dirs[random(size)]);
		return 1;
	    }
	}
    }
    return 0;
}


