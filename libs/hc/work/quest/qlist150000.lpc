mapping *quest = ({
  ([ "quest": "柳叶刀",
    "diff": 2,
  ]),
  ([ "quest": "衙役服",
    "diff": 2,
  ]),
  ([ "quest": "冰雪翡翠糕",
    "diff": 2,
  ]),
  ([ "quest": "酸梅汤",
    "diff": 2,
  ]),
  ([ "quest": BLK "黑牡丹" NOR,
    "diff": 2,
  ]),
  ([ "quest": "水壶",
    "diff": 2,
  ]),
  ([ "quest": "道德经「上卷」",
    "diff": 2,
  ]),
});
mapping query_quest() {
  return quest[random(sizeof(quest))];
}
