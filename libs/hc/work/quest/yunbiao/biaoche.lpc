#include <command.h>
#include <ansi.h>
inherit ITEM;
int time_period(int timep, object me);
string *npcs = ({
  "gangster",
  "gangster2",
  "gangster3",
});
mapping default_dirs = ([
  "north": "北",
  "south": "南",
  "east": "东",
  "west": "西",
  "northup": "北边",
  "southup": "南边",
  "eastup": "东边",
  "westup": "西边",
  "northdown": "北边",
  "southdown": "南边",
  "eastdown": "东边",

  "westdown": "西边",
  "northeast": "东北",
  "northwest": "西北",
  "southeast": "东南",
  "southwest": "西南",
  "up": "上",
  "down": "下",
  "enter": "里",
  "out": "外",
]);
mapping alias_dirs = ([
  "n": "north",
  "s": "south",
  "e": "east",
  "w": "west",
  "nu": "northup",
  "su": "southup",
  "eu": "eastup",
  "wu": "westup",
  "nd": "northdown",
  "sd": "southdown",
  "ed": "eastdown",
  "wd": "westdown",
  "ne": "northeast",
  "se": "southeast",
  "nw": "northwest",
  "sw": "southwest",
  "u": "up",
  "d": "down",
]);
void create() {
  set_name(HIW "镖车" NOR, ({ "biao che", "che" }));
  set_weight(3000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "辆");
    set("no_drop", 1);
    set_max_encumbrance(80000000);
    set("long", "这是一辆镖车，里面不知道放着什么东西，镖车两边插着两面旗子\n随着风咧咧作响，上写“福威镖局”四个大字。\n");

    set("no_get", 1);
    set("value", 2000);
  }
}
void init() {
  remove_call_out("des");
  call_out("des", 700);
  add_action("do_gan", "ganche");
  add_action("do_job", "job");
}
int des() {
  message_vision("镖师走了过来，赶起镖车往远处匆匆而去。\n", this_object());
  destruct(this_object());
  return 1;
}
int do_job() {
  mapping job;
  object me = this_player();
  int nowtime = time();
  job = me->query("fjob");
  if (!job) return 0;
  if (query("owner") != me->query("id")) return 0;
  nowtime = (int)me->query("fjob_time") - time();
  write("你现在的任务是运送镖银到" + "『" + job["target_name"] + "』。\n");
  if (nowtime > 0)
    time_period(nowtime, me);
  else
    write("但是你已经没有足够的时间来完成它了。\n");

  return 1;
}
int time_period(int timep, object me) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;

  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  tell_object(me, "你还有" + time + "去完成它。\n");
  return 1;
}
int des_che() {
  object me, biaoshi;
  remove_call_out("des_che");
  if (!(me = present(query("owner"), environment(this_object())))) {
    message_vision("一群土匪一拥而上，顿时把镖银抢了个精光。\n", this_object());
    biaoshi = present("biao shi", environment(this_object()));
    if (biaoshi) {
      message_vision("$N四散奔逃而去。\n", biaoshi);
      destruct(biaoshi);
    }
    destruct(this_object());
    return 1;
  }
  call_out("des_che", 10);
}
int do_gan(string arg) {
  mapping exit, job;
  string dest, dir, min, mout, path;
  object me = this_player(), env, obj, killer, who, biaoshi, gold, npc;
  object *gangs;
  int kar, i, count;
  int j = random(sizeof(npcs));
  env = environment(me);
  if (query("owner") != me->query("id")) return 0;

  if (!arg) return notify_fail("你要把赶镖车往哪里去？\n");

  if (!undefinedp(alias_dirs[arg]))
    arg = alias_dirs[arg];

  if (!mapp(exit = env->query("exits")) || undefinedp(exit[arg]))

    return notify_fail("这个方向没有出路。\n");

  if (me->is_fighting())
    return notify_fail("你正在战斗中，怎么赶镖车？\n");

  gangs = all_inventory(environment(me));
  for (i = 0; i < sizeof(gangs); i++)
    if (gangs[i]->query("id") == "gangster" && gangs[i]->query("target") == me->query("id"))
      if (living(gangs[i]))
        return notify_fail("有人劫镖车，你还是保住镖银再走吧！\n");
  /*   if(objectp(who = present("gangster", environment(me)))) {
		  if(living(who))
		  return notify_fail("有人劫镖车，你还是保住镖银再走吧！\n");
		}
	    */

  if (!env->valid_leave(me, arg)) return 0;

  if (!undefinedp(default_dirs[arg]))
    dir = default_dirs[arg];
  else
    dir = arg;

  dest = exit[arg];
  obj = load_object(dest);

  mout = HIY "$N扬了扬鞭子，高声驱赶骡子架着镖车隆隆的往" + dir + "驶去。\n" NOR;
  min = HIY "镖车隆隆的驶了过来。\n" NOR;

  message_vision(mout, me);
  GO_CMD->main(me, arg);
  kar = me->query("kar");
  job = me->query("fjob");
  if (this_object()->move(obj)) {
    call_out("des_che", 1);
    message_vision(min, me);
    if (me->query("fjob_time") < time()) {
      call_out("des_che", 10);
      return 1;
    }
    if (job && job["target_path"] == file_name(obj)) {
      gold = new("/clone/money/gold");
      message_vision(
        "$N大声喝道：我武扬威！远东镖局押送镖银已到！\n" + job["npc_title"] + "的" + job["job"] + "可在？\n",
        me
      );
      if (!(npc = present(job["npc_id"], environment(me)))) {
        npc = new(job["npc_path"]);
        npc->move(environment(me));

        message_vision("$N急步走了过来。\n", npc);
        call_out("des_npc", 2, npc);
      }
      message_vision(
        job["job"] + "答道：原来是远东镖局的各位镖爷，勤苦各位安全送达！\n这里有点银子请收下暂做酬劳。" + job["job"] + "拿出来了一些银子交给了$N。\n",
        me
      );
      gold->set_amount(5 + random(job["money_bonus"]) / 3);
      gold->move(me);
      me->set("end_job", 1);
      if (biaoshi = present("biao shi", environment(me))) {
        message_vision(
          "$N对$n抱拳道：" + RANK_D->query_respect(me) + "，林总镖头派俺一起保这趟镖总算不辱使命，俺这就先回去向总镖头复命。\n\n$N转身匆匆来去。\n",
          biaoshi,
          me
        );
        destruct(biaoshi);
      }
      destruct(this_object());
      return 1;
    } else if (5 + random(kar) < 8 && environment(me)->query("outdoors")) {
      count = random(1) + 1;
      if (count <= 0) count = 1;
      for (i = 0; i < count; i++) {
        killer = new("/quest/npc/" + npcs[i]);
        killer->set("target", me->query("id"));
        killer->move(environment(me));
      }
      message_vision("忽然间从道两边跳出一群劫匪！\n", this_object());
      message_vision("$N对着$n喝道：臭贼也想劫镖？弟兄们，给我狠狠地教训毛贼！\n", me, killer);
      if (biaoshi = present("biao shi", environment(me))) {
        biaoshi->kill_ob(killer);

        message_vision("\n只见$N应声冲着毛贼扑了过去！喝道：臭贼拿命来吧！。\n", biaoshi);
      }
      message_vision("$N对着$n一剑冷笑一声：狗腿子便是全上，俺又有何惧，看招！\n", killer, me);
    }
    return 1;
  }
  return 0;
}
int des_npc(object npc) {
  message_vision("$N赶着镖车匆匆离开。\n", npc);
  destruct(npc);
  return 1;
}
