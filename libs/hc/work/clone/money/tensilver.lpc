// 10silver.c

#include <ansi.h>

inherit MONEY;

void create() {
  set_name(HIW "十两银票" NOR, ({ "tensilver", "tensilver_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "tensilver");
    set("long", "面值十两白银的银票。\n");
    set("unit", "叠");
    set("base_value", 1000);
    set("base_unit", "张");
    set("base_weight", 16);
  }
  set_amount(1);
}
