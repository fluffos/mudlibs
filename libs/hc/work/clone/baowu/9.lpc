// baowu.c
// by smash
#include <ansi.h>
inherit ITEM;


void create()
{
	set_name(HIG"宝物"NOR, ({"bao wu"}));
	set_weight(80);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "你挖出来的宝物，不知道有什么作用。\n");
		set("unit", "个");
                set("no_sell", 1);
		set("value", 50);
		 set("mingjiao", 1);
	}
}
int init()
{
	add_action("do_use", "use");
}

int do_use(string arg)
{
	object me = this_player();
        int i;
        i = (int)me->query_skill("parry",1);
  if ((int)me->query_skill("parry", 1) > 1500)
               return notify_fail("你的武功够高咯，别乱吃东东了。\n");
	if(arg=="bao wu")
	{
			   if (i*i*i/10 > (int)me->query("combat_exp")) 
	{
		return notify_fail("因为经验不够，宝物失去了作用。\n");
		destruct(this_object());
		return 1;
	}else	{
                if ( this_object()->query("owner") != me->query("id") )
                        return notify_fail("这个宝物不是你挖的。\n");
		message_vision(HIW"$N小心翼翼的将宝物打开。\n"NOR, me);
		tell_object(me,HIW"哇，好神奇，你的基本招架增加了。\n"NOR);
		me->set_skill("parry", i + 1);
		destruct(this_object());
	}
	return 1;
}
}
