// tanxiang.c 檀香
// ahxia 2001.1.9
inherit ITEM;
int send_smell(int i);
void create() {
  set_name("檀香", ({ "tan xiang", "xiang" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一支散发着淡淡幽香的檀香，是做仪式必不可少的物品。\n需要的时候看起来可以点燃(light)它。\n");
    set("unit", "支");
    set("value", 100);
  }
}

void init() {
  add_action("do_light", "light");
}

int do_light(string arg) {
  object me = this_player();
  if (!arg || !(arg == "tan xiang" || arg == "xiang"))
    return 0;
  if (!me || !this_object()) return 0;
  tell_room(environment(me), me->name() + "小心翼翼的点燃了檀香\n", ({ me }));
  write("你小心翼翼的点燃了檀香\n");
  me->set_temp("marks/light_tanxiang", 1);
  call_out("send_smell", 1, 5);
  return 1;
}

int send_smell(int i) {
  remove_call_out("send_smell");
  if ((i--) <= 0) {
    if (this_player())
      this_player()->delete_temp("marks/light_tanxiang");
    write("檀香终于悄悄的燃尽了。\n");
    destruct(this_object());
    return 1;
  }
  tell_room(environment(this_player()), HIM + "檀香徐徐的发出了淡淡的清香气息\n" + NOR);
  call_out("send_smell", 5, i);
  return 1;
}
