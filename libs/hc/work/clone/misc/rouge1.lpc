//rouge.c 胭脂

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIM "胭脂" NOR, ({ "rouge" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盒色泽鲜艳的胭脂，擦(use)在脸上一定很漂亮。\n");
    set("unit", "盒");
    set("value", 1000);
    set("rouge_remaining", 5);
    //set("material", "power");
  }
  setup();
}

void init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  object me = this_player();
  object ob = this_object();

  if (!id(arg) || !me) return 0;

  add("rouge_remaining", -1);
  tell_room(environment(me), HIM + me->name() + "拿起胭脂仔细的擦了一遍。\n");

  me->add_temp("marks/use_rouge", -5);
  if (me->query_temp("marks/use_rouge") > 10) {
    me->add_temp("apply/personality", -3);
  } else {
    me->add_temp("apply/personality", 1);
  }

  if (query("rouge_remaining") <= 0) {
    remove_action("do_use", "use");
    destruct(ob);
  }

  return 1;
}
