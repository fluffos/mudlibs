#include <ansi.h>


inherit NPC;
inherit F_CLEAN_UP;

void create()


{
    set_name( RED"冷血"NOR , ({ "xun bu","bu"}) );
    set("gender", "男性" );
    set("age", 30);

    set("long",HIC"他面颊萧瘦，目光冷峻，眉宇之间透出一股杀气。\n"NOR);

    set("no_die",1);
    set("env/wimpy", 70);
    set("max_jingli", 3000000);
    set("max_neili", 50000000);
    set("jingli", 3000000);
    set("neili",100000000);


    set("jiali",20000);
    set("str", 3000);
    set("con", 30);
    set("int", 10);
    set("dex", 1530);
    set("demogorgon",1);

    set("combat_exp", 500000000);
    set_skill("force", 5000);
    set_skill("sword", 5000+random(2000));
    set_skill("unarmed", 5000+random(2000));
    set_skill("parry", 5000);
    set_skill("dodge", 7000+random(2000));
    set_skill("pixie-jian", 2000+random(2000));
    map_skill("sword", "pixie-jian");
    map_skill("dodge", "pixie-jian");
    set_temp("apply/attack", 20000);
    set_temp("apply/defense", 20000);
    set_temp("apply/armor", 2000);
    set_temp("apply/dodge", 20000);

    setup();
    set("water",max_water_capacity());
    set("food",max_food_capacity());
    carry_object("/d/emei/obj/skysword")->wield();
    carry_object("/d/city/npc/cloth/feature")->wear();
}

void init()
{
        string target;
        object ob;
        
        target = this_object()->query("target");
        
        if ( !target ){
                call_out("self_destruct",20);
                return;
        }
        
        ob = present(target,environment(this_object()));
        
        if ( !ob ){
                call_out("self_destruct",20);
                return;
        }
        
        if ( !this_object()->is_fighting(ob) ){
                set_leader(ob);
                call_out("announce_sb",1,ob);
        }
}

void self_destruct()
{
        remove_call_out("self_destruct");
        message_vision("一阵微风吹过，$N身影立刻无影无踪。\n",this_object());
        destruct(this_object());
}

varargs int move(mixed dest, int silently)
{
        int i;
        
        i = ::move(dest,silently);
        message_vision("突然，远处传来一阵铃声，一个人影渐渐浮现在众人的面前。\n",this_object());
        return i;
}

void annouce_sb(object ob)
{
        remove_call_out("announce_sb");
        kill_ob(ob);
}

