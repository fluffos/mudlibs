// tangmen_b.c 唐门留言板

#include "ansi.h"

inherit BULLETIN_BOARD;

void create() {
  set_name("唐门留言板", ({ "board" }));
  set("location", "/d/tangmen/liujiantang");
  set("board_id", "tangmen_b");
  set("long", "这是一个唐门弟子交流的留言板。\n");
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
