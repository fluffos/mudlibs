#include <ansi.h>
inherit BULLETIN_BOARD;
void create() {
  set_name(HIG "骷髅的鬼哭石碑" NOR, ({ "board" }));
  set("location", "/u/kulou/workroom");
  set("board_id", "kulou_b");
  set("long", "一大堆骷髅头堆积而成的墓碑，凶煞无比。\n");
  set("capacity", 100);
  setup();
}
int do_read(string arg) {
  if (!wizardp(this_player())) {
    write("你被墓碑的煞气熏得透不过气来..，还是不看为妙吧！\n");
    return 1;
  }
  return ::do_read(arg);
}

int do_post(string arg) {
  if (!wizardp(this_player())) {
    write("你写啊写啊, 居然写不上..\n");
    return 1;
  }
  return ::do_post(arg);
}
