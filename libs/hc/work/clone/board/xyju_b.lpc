inherit BULLETIN_BOARD;
void create() {
  set_name("闲逸居留言簿", ({ "board" }));
  set("location", "/d/xyju/bird13");
  set("board_id", "xyju_b");
  set("no_get", 1);
  set("long", "这个留言簿是专门为拜山之人，以及老英雄们留言所用。\n");
  setup();
  set("unit", "块");
  set("capacity", 220);
}
