// findob.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;

  if (!arg) return notify_fail("指令格式 : findob <物件路径>\n");
  ob = find_object(arg);

  if (ob) {
    write(sprintf("物件:%O\n环境:%O\n", ob, environment(ob)));
    return 1;
  }

  return notify_fail("没有这样的物件！\n");
}
