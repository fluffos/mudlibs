//check exp and pot command
//this command is used for check one's exp-pot's gain rating per second
//added by wings@hc

inherit F_CLEAN_UP;

int main(object me,string arg)
{
        object ob;
        float rate_exp,rate_pot;
        float exp,pot,time;
        string msg;
        
        if ( !arg )
                return notify_fail("checkrate <Player ID>\n");
        
        ob = LOGIN_D->find_body(arg);
        if (!ob) ob=find_player(arg);
        if (!ob)
                return notify_fail("此人不存在或者已经离线。\n");
        
        if ( !ob->query_temp("checkrate") ){
                ob->set_temp("checkrate/start",time());
                ob->set_temp("checkrate/exp",ob->query("combat_exp"));
                ob->set_temp("checkrate/pot",ob->query("potential"));
                write("开始启动checkrate，目标：" + ob->query("name") + "。\n");
        } else {
                exp  = ob->query("combat_exp");
                pot  = ob->query("potential");
                time = time() - ob->query_temp("checkrate/start");
                rate_exp = (exp - ob->query_temp("checkrate/exp"))/time;
                rate_pot = (pot - ob->query_temp("checkrate/pot"))/time;
                write(sprintf(ob->query("name")+"的经验值增长率为每秒%f，潜能增长率为每秒%f。\n",rate_exp,rate_pot));
                ob->delete_temp("checkrate");
        }
        
        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : checkrate <某人>
此指令可测试某人的exp和pot增长率。
HELP
    );
    return 1;
}

