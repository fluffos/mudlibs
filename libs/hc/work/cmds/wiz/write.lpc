// backup.c
// Build by wings , 2000/09/29

// operation : backup a file using standard backup method

#include <localtime.h>

inherit F_CLEAN_UP;

void create()
{
        
        seteuid(getuid());
        
}

int main(object me , string arg)
{
        efun::write("test");
        return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : backup <档名> [-y]

参数 -y : 强制覆盖已有的备份档。

此指令备份你选择的档案。
HELP
    );
    return 1;
}

