// man.c
// Created By Ivan.
// 
int main(object me, string arg)
{
        if( !arg) {
                write("此份函数帮助是MudOS.v21c2版本中文翻译\n不完全吻合现在所使用MudOS版本，主在\n方便巫师查阅常用外部函数使用。请键入(man all)来获取外部函数列表\nBy Ivan.2001\n");
                return 1;
        }
        if( arg == "all") {
                me->start_more(read_file("/doc/mudlib/efuns.lpc"));
                return 1;
        }
        if( arg ) {
                if ( file_size("/doc/mudlib/efuns/"+arg) < 0 ) {
                        return notify_fail("没找到这个外部函数。\n");}
                me->start_more(read_file("/doc/mudlib/efuns/"+arg));
                return 1;
                } 
}

int help(object me)
{
        write(@HELP
指令格式：man <函数名称>

这个指令可以帮助你查询相关外部函数帮助。
直接键入man可以获得外部函数列表。

Created By Ivan
HELP
        );
        return 1;
}

