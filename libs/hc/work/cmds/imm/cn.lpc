//ahxia@hc, 2k1, 2k2
inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string arg)
{
    string tmp = "";
    object ob, env, *alluser=users();
    int flag_s = 0;

    if( strlen(arg) > 1
      && strsrch(arg, "-a") != -1 ){
	alluser = livings();
	arg = replace_string(arg, "-a", "");
    }

    if( strlen(arg) > 1
      && strsrch(arg,"-s") != -1 ) {
	flag_s = 1;
	arg = replace_string(arg, "-s", "");
    }
    arg = replace_string(arg, " ", "");

    if (!arg || arg == "") return notify_fail("Syntax: cn [用户中文名] | [[-a] | [-s]]\n");

    foreach(ob in alluser){
	if(!ob || !ob->name() || !ob->name(1)) continue;
	if ( ob->name() == arg || ob->name(1) == arg
	  || (flag_s == 1 && strsrch(ob->name(), arg) != -1)
	  || (flag_s == 1 && strsrch(ob->name(1), arg) != -1)
	)
	    tmp += HIW+(userp(ob)? "Usr ":"NPC ")+NOR
	    + ob->short()+" ["+ob->query("name")+" "+ob->query("id")+"] "
	    + ( (env = environment(ob)) ? file_name(env)+" ["+env->query("short")+"]" : HIW"No_Room!"NOR )
	    +"\n";
	if( random(5)==0 )  reset_eval_cost();
    }
    if( tmp != "" ){
	tmp = "找到如下用户：\n" + tmp + "OK\n";
	me->start_more(tmp);
    }
    else{
	return notify_fail("没有找到用户。\n");
    }
    return 1;
}
int help()
{
    write(@HELP
Syntax: cn [[-a] | [-s]] [用户中文名]

通过"中文名"查当前在线player/living的id。也可适用于pretend了的id。
可选参数 -a: 同时在Player和NPC中查找.比较浪费时间
         -s: 部分匹配方式查找. 

HELP );
    return 1;
}
