// whereis.c
// added by wings@HC , 2002.10.5
// last modified by wings@HC
// 根据User所拥有的权限，在所有可执行的目录里查找指定的命令

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *szPath;
  string szOutput = "";
  mapping mapSearch;

  int nCnt = 0;

  if (!arg)
    return notify_fail("你要做什么？\n");
  if (!living(me))
    return notify_fail("你是人吗？\n");

  if (!sscanf(arg, "%s.lpc", arg))
    sscanf(arg, "%s.C", arg);

  szPath = me->query_path();
  mapSearch = COMMAND_D->query_search();

  for (int i = 0; i < sizeof(szPath); i++) {
    if (undefinedp(mapSearch[szPath[i]])) continue;
    if (member_array(arg, mapSearch[szPath[i]]) != -1) {
      write(szPath[i] + arg + "\n");
      nCnt++;
    }
  }

  if (!nCnt)
    write("没有找到指定的命令。\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : whereis <命令>

查找指定的命令所在的具体路径。
HELP
  );
  return 1;
}
