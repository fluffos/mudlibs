inherit F_CLEAN_UP;
int main(object me,string arg)
{
   object ob;
ob = LOGIN_D->find_body(arg);
if(!ob) return notify_fail("没有这个人。\n");
 ob->move("/d/jianyu");
 CHANNEL_D->do_channel(me,"chat",ob->query("name")+"("+ob->query("id")+")"+"被送往"HIG"海盗船"HIR"监禁。\n"NOR);
 CHANNEL_D->do_channel(me,"new",ob->query("name")+"("+ob->query("id")+")"+"被送往"HIG"海盗船"HIR"监禁。\n"NOR);
return 1;
}
