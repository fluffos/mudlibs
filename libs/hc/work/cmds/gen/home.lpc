// home.c
// modified by wings@HC 01-5-13 10:12

#include "/doc/help.h"

#define WIZ_HALL "wiz"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string msg, fileloc, err;

  if (arg == WIZ_HALL)
    fileloc = "/d/wizard/wizard_room.lpc";
  else
    fileloc = user_path(arg ? arg : geteuid(me)) + "workroom.lpc";

  if (file_size(fileloc) <= 0)
    return notify_fail(arg ? "你找不到 " + HIC + arg + NOR + " 的工作室。\n" : "你没有自己的工作室。\n");

  if (stringp(msg = me->query("env/msg_home")))
    message_vision(msg + "\n", me);

  err = catch(me->move(fileloc));

  if (err)
    write(err);

  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : home [XXX]
利用此一指令可直接回到自己的工作室或者XXX的工作室。
如果你有 'msg_home' 这个设定, 则在场的人都会看到那个讯息.

附：home wiz将回到巫师会议室。
HELP
  );
  return 1;
}
