// coi.c
// get info of call_out
// build by wings , 2000/9/29

inherit F_CLEAN_UP;

void create()
{
   seteuid(getuid());
}

int main(object me, string arg)
{
   mixed info;
   int count , max_eval , i;

   info = call_out_info();

   count = sizeof(info);

   max_eval = info[0][2];

   for (i = 0;i < count;i++){
      if ( max_eval < info[count][2] )
         max_eval = info[count][2];
   }

   write( sprintf("现在有 %d 个延迟函数。\n",count) );
   write(sprintf("其中最大的延迟函数延迟 %d 秒。\n",max_eval));

   return 1;
}
