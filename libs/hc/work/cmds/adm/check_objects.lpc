//check_objects.c
//wings@HC

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object *obMaster;
  object *obClone;
  int nMasterCnt, nCloneCnt;
  int i, nWar;
  string strOut = "";
  string strWar = "";

  if (!arg)
    nWar = 50;
  else
    sscanf(arg, "%d", nWar);

  obMaster = objects("masterp");
  nMasterCnt = sizeof(obMaster);

  for (i = 0; i < nMasterCnt; i++) {
    obClone = children(base_name(obMaster[i]));
    nCloneCnt = sizeof(obClone);

    if (sizeof(obClone) > 1)
      strOut += sprintf("%-60s%-10d\n", base_name(obMaster[i]), nCloneCnt);

    if (sizeof(obClone) > nWar)
      strWar += sprintf("%-60s%-10d\n", base_name(obMaster[i]), nCloneCnt);
  }
  strOut += "\n";
  strWar += "\n";

  strOut += sprintf("目前MUD中总共有%d个Master物件。\n", nMasterCnt);
  strWar += sprintf("目前MUD中总共有%d个Master物件。\n", nMasterCnt);

  write_file(LOG_DIR + "OBJECTS.LOG", strOut, 1);
  write_file(LOG_DIR + "OBJECTSW.LOG", strWar, 1);

  write("检查完毕," + sprintf("目前MUD中总共有%d个Master物件。\n", nMasterCnt));

  return 1;

}

int masterp(object ob) {
  return !clonep(ob);
}
