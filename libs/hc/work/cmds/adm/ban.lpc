// ban.c
// Created by Xiang@XKX
// 2k2.9 slightly modified by ahxia@hc

void create()
{
    seteuid(getuid());
}

int main(object me, string arg)
{
    string site;
    BAN_D->load_sites();
    if( !arg || arg == "")
	write(BAN_D->list_sites());
    else if (sscanf(arg, "+ %s", site) == 1) {
	if( strsrch(site,"**") != -1 )
	    return notify_fail("错误！地址里不能出现连续的*\n");
	BAN_D->add_site(site);
    }else if (sscanf(arg, "- %s", site) == 1)
	BAN_D->remove_site(site);
    else write("指令格式：ban [+|- site]\n");

    return 1;

}

int help(object me)
{
    write(@HELP
这条命令是用来防止有人蓄意捣乱。

指令格式：ban [+|- site]

例子：ban + 10.60.1.*
      ban - 198.*.*.*

注意：地址里*是不能连续出现的。否则会引起登陆失败。

HELP
    );
    return 1;
}
