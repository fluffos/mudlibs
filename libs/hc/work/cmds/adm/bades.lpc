// bades.c, for use with modified gchannel.c & BAD_ES_ID
// by ahxia@hc, only for those who flushes es (intermud) channel.

#define BAD_ES_ID "/adm/etc/BAD_ES_ID"
#define FILE_GCHANNEL "/adm/daemons/network/services/gchannel.lpc"

void create() {
  seteuid(getuid());
}

int update_file() {
  string err;
  object obj;
  obj = find_object(FILE_GCHANNEL);
  if (obj) destruct(obj);
  if (obj) return notify_fail("\n" + FILE_GCHANNEL + " cannot be destructed.\n");
  err = catch(call_other(FILE_GCHANNEL, "???"));
  if (err) printf("Update gchannel发生错误：\n%s\n", err);
  else write("\nUpdate " + FILE_GCHANNEL + " 成功！\n");

  return 1;
}
int main(object me, string arg) {
  string file, *buf;
  string id, site, msg;
  buf = ({});
  msg = "";
  file = read_file(BAD_ES_ID);
  if (!file)
    return notify_fail("File " + BAD_ES_ID + " cannot read or not found.\n");
  foreach (string str in explode(file, "\n")) {
    if (str[0] == '#' || str[0] == '\n' ||
      sscanf(str, "%s@%s", id, site) != 2) continue;
    buf += ({ lower_case(id + "@" + site) });
  }

  if (!arg) {  //list id@site
    msg = "当前禁止的id@site有" + sizeof(buf) + "个：\n";
    foreach (string str in sort_array(buf, 1))
      msg += str + "\n";
    this_player()->start_more(msg);
    return 1;
  }

  if (sscanf(arg, "+ %s@%s", id, site) == 2) {
    if (member_array(lower_case(id + "@" + site), buf) != -1)
      return notify_fail("This id@site already banned.\n");
    buf += ({ lower_case(id + "@" + site) });
    write_file(BAD_ES_ID, buf[sizeof(buf) - 1] + "\n", 0);
    write("\nBannish " + id + "@" + site + " OK!\n");
    update_file();
    return 1;
  }

  if (sscanf(arg, "- %s@%s", id, site) == 2) {
    if (!buf) return notify_fail("没有被禁止的" + id + "@" + site + "\n");
    if (member_array(lower_case(id + "@" + site), buf) == -1)
      return notify_fail("该地址不存在.\n");
    buf -= ({ buf[member_array(lower_case(id + "@" + site), buf)] });
    write_file(BAD_ES_ID, implode(buf, "\n") + "\n", 1);
    write(id + "@" + site + "的封闭解除了.\n");
    update_file();
    return 1;
  }
  write("指令格式：banes [+|- id@site]\n");

  return 1;
}

int help(object me) {
  write(@HELP
Syntax: bades [+|- id@site]

拒绝接受个别id@site在es频道的flood信息，可以都用小写。
e.g. bades + npc@xkx <--就是封闭HOSTNAME = xkx, USRNAME = npc的用户。

HELP
  );
  return 1;
}
