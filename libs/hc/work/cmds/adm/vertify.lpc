#include <localtime.h>

inherit F_CLEAN_UP;

void create()
{
   seteuid(getuid());
}

int main(object me,string arg)
{
   int *detail;
   string str;

   detail = localtime( time() );

   str = sprintf("%d-",detail[LT_YEAR]) + sprintf("%d-",detail[LT_MON]) + sprintf("%d",detail[LT_MDAY]);

   write(str + "\n");
   return 1;
}
