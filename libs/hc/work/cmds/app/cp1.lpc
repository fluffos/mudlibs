// backup.c
// Build by wings , 2000/09/29

// operation : backup a file using standard backup method

#include <localtime.h>

inherit F_CLEAN_UP;

void create() {

  seteuid(getuid());

}

int main(object me, string arg) {

  string src, dest, str, *option;
  int *detail, i;
  int overwrite;


  if (!arg)
    return notify_fail("你要备份什么文件?\n");
  src = replace_string(arg, " -y", "");
  src = replace_string(src, "-y ", "");
  src = replace_string(src, " ", "");
  src = resolve_path(me->query("cwd"), src);

  detail = localtime(time());

  option = explode(arg, " ");
  overwrite = 0;

  str = sprintf(
    "%d-",
    detail[LT_YEAR]
  ) + sprintf("%d-", detail[LT_MON] + 1) + sprintf("%d", detail[LT_MDAY]);

  dest = src + "." + str;

  dest = resolve_path(me->query("cwd"), dest);

  i = sizeof(option);
  while (i--)
    switch (option[i]) {
      case "-y": overwrite = 1; break;
      default: break;
    }

  if (file_size(dest) > 0 || file_size(dest) == -2) {
    if (overwrite)
      if (cp(src, src))
        write(sprintf("备份文件(%s)完成，文件名为：(%s).\n", src, dest));
      else {
        write("备份操作失败！\n");
        return 1;
      } else
        return notify_fail("今日已有备份文件,如果你要覆盖请加上参数 -y.\n");
  } else {
    if (cp(src, dest))
      write(sprintf("备份文件(%s)完成，文件名为：(%s).\n", src, dest));
    else {
      write("备份操作失败！\n");
      return 1;
    }
  }

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : backup <档名> [-y]

参数 -y : 强制覆盖已有的备份档。

此指令备份你选择的档案。
HELP
  );
  return 1;
}
