// cd.c leeyao强化确认版本
inherit F_CLEAN_UP;
#include <ansi.h>
int main(object me, string arg) {
  string dir, str;
  if (!arg)
    arg = user_path(me->query("id"));
  dir = resolve_path(me->query("cwd"), arg);
  if (file_size(dir) != -2) return notify_fail(HIC "没有这个目录。\n" NOR);
  if (dir[strlen(dir) - 1] != '/') dir += "/";
  if ((int)SECURITY_D->valid_read(dir, me)) {
    me->set("cwd", dir);
    write(HIG + "目录改变为: " + NOR + CYN + dir + "\n" + NOR);
  } else {
    //记录查看的文件/log/cmds/cd
    log_file("cmds/cd/" + geteuid(me),
      sprintf("%s(%s) cd %s on %s越权\n",
        me->name(1),  //记录使用命令的人名
        geteuid(me),  //记录使用命令的ID
        dir,        //记录读取文件的路径
        ctime(time())));  //记录使用命令的时间
    return notify_fail(HIR "你没有足够的阅读权限。\n" NOR);
  }


  write("\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : cd <子目录名>, cd .. , and cd
将目前参考的目录移至指定的子目录或回到上一主目录; 亦可直接回到自己工作目录。
HELP
  );
  return 1;
}
