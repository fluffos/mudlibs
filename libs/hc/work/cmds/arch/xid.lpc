// Change player's ID, 2k2.2.25, ahxia@hc

inherit F_CLEAN_UP;

#define UPATH "/data/user"
#define LPATH "/data/login"

object _me;
void msg(string arg) {
  if (_me)
    tell_object(_me, arg + "\n");
}

int main(object me, string arg) {
  object ob, link_ob;
  string s1, s2, pl_usr, pl_lgn, d_usr, d_lgn;
  _me = me;

  if (!arg || (sscanf(arg, "%s %s", s1, s2) != 2))
    return notify_fail("用法: xid <user_id> <新id>\n");
  if (find_player(s1))
    return notify_fail("用户" + s1 + "现在在线,无法进行修改!\n");

  pl_lgn = sprintf("%s/%c/%s.o", LPATH, s1[0], s1);
  pl_usr = sprintf("%s/%c/%s.o", UPATH, s1[0], s1);
  if ((file_size(pl_usr) == -1) && (file_size(pl_lgn) == -1))
    return notify_fail("用户" + s1 + "不存在!\n");

  d_lgn = sprintf("%s/%c/%s.o", LPATH, s2[0], s2);
  d_usr = sprintf("%s/%c/%s.o", UPATH, s2[0], s2);
  if ((file_size(d_usr) != -1) && (file_size(d_lgn) != -1))
    return notify_fail("用户" + d_usr + "已经存在!\n");

  //load ob
  ob = new(USER_OB);
  seteuid(s1);
  export_uid(ob);
  ob->set_name("", ({ s1 }));
  if (!ob->restore()) {
    seteuid(ROOT_UID);
    rm(d_lgn);
    rm(d_usr);
    destruct(ob);
    msg("数据加载不成功!!\n");
    return 1;
  }
  ob->setup();
  //load link_ob 
  seteuid(getuid());
  link_ob = new(LOGIN_OB);
  link_ob->__raw_set("id", s1);
  msg(sprintf("link_ob := %O", link_ob));
  if (!link_ob || !link_ob->restore()) {
    seteuid(ROOT_UID);
    rm(d_lgn);
    rm(d_usr);
    destruct(ob);
    destruct(link_ob);
    msg("加载link_ob失败! \n");
    return 1;
  }
  ob->set("id", s2);
  link_ob->__raw_set("id", s2);
  ob->save();
  link_ob->save();
  //move files
  cp(pl_lgn, d_lgn);
  cp(pl_usr, d_usr);
  rm(pl_lgn);
  rm(pl_usr);

  destruct(ob);
  destruct(link_ob);

  msg("OK!\n");
  return 1;
}

int help(object me) {
  write(@TEXT
用法: xid <user_id> <new_id>
功能: 修改用户user_id为new_id并保存。修改前注意new_id不能存在。
TEXT);
  return 1;
}
