inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  object obj;
  string func, param;
  mixed *args, result;
  int i;


  obj = find_object("/adm/daemons/legendd.lpc");

  if (!obj)
    return notify_fail("未找到legendd.c\n");

  if (!arg)
    return notify_fail("未指定参数！\n");

  if (sscanf(arg, "%s(%s)", func, param) != 2)
    return notify_fail("fail in arguments\n");

  args = explode(param, ",");
  for (i = 0; i < sizeof(args); i++) {
    parse_command(args[i], environment(me), "%s", args[i]);
    if (sscanf(args[i], "%d", args[i])) continue;
    if (sscanf(args[i], "\"%s\"", args[i])) continue;
  }

  args = ({ func }) + args;

  result = call_other(obj, args);

  write(sprintf("%O\n", result));

  return 1;
}
