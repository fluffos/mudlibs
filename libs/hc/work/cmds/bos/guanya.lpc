#include <ansi.h>
#include <weapon.h>

inherit ITEM;

void init() {
  add_action("do_fire", "fa");
}


void create() {
  set_name(BLINK + HBMAG "格杀令" NOR, ({ "qingjian" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是湖水把坏蛋关起来的东西！\n");
    set("value", 5);
    set("unit", "封");
  }
}
int do_fire(string target) {
  object me, conc;

  me = this_object();

  if (!target) return notify_fail("你要发给谁？\n");
  if (target == this_player()->query("id")) return notify_fail("你要发给自己吗？\n");

  if (!(conc = find_player(target)))
    if (!(conc = find_living(target))) {
      write("没有这个人或生物。\n");
      return 1;
    }

  message_vision(HIR "只见一道格杀令破空而出，向$n飞去。
               \n" NOR, me, conc);

  me->move(environment(conc));

  message_vision(HIY "$N闪闪有色，随风而来。\n" NOR, me);

  conc->set_temp("last_damage_from", "接" + me->name() + "到");
  CHANNEL_D->do_channel(this_object(), "rumor", sprintf("%s接到格杀令后，被湖水关了起来，准备午后斩首！", conc->name(1)));

  conc->set("invisibility", 10);
  conc->set("env/invisibility", 0);
  conc->move("/d/jianyu.lpc");

  find_player(target)->reincarnate();
  find_player(target)->delete_temp("apply/name");
  find_player(target)->delete_temp("apply/id");
  find_player(target)->delete_temp("apply/short");
  find_player(target)->delete_temp("apply/long");
  destruct(this_object());
  return 1;
}
