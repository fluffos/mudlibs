// uptime.c
#include <ansi.h>
#include <mudlib.h>
inherit F_CLEAN_UP;
int main() {

  write(HIR "〖" BBLU HIW "红尘" NOR HIR "〗" NOR + "已经运行了" + HIM + CHINESE_D->chinese_period(uptime()) + NOR "\n");
  write("        " + HIY + RESTART_D->GetRemainTimeStr() + NOR + "\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : uptime
 
这个指令告诉您这个泥巴游戏已经连续执行了多久.
 
HELP
  );
  return 1;
}
