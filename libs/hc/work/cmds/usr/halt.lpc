// By Xiang@XKX (12/17/95)
//mixed version by ahxia@hc 2k2.9.13

int main(object me, string arg) {
  object ob, *all_ob;

  if (arg && wizardp(me)) {
    if (arg != "here") {
      ob = present(arg, environment(me));
      if (!ob) return notify_fail("没有这个生物。\n");
      if (!ob->is_fighting()) return notify_fail(ob->name() + "现在不忙。\n");
      ob->remove_all_enemy();
      message_vision("\n$N用巫师的神力停止了$n的战斗。\n", me, ob);
      return 1;
    } else {
      all_ob = all_inventory(environment(me));
      foreach (ob in all_ob)
        ob->remove_all_killer();
      message_vision(HIY "\n$N用神的力量停止了这里所有的战斗。\n\n" NOR, me);
      return 1;
    }
  }
  if (!me->is_busy() && me->is_fighting()) {
    me->remove_all_enemy();
    me->interrupt_me();
    message_vision("\n$N身行向后一跃，跳出战圈不打了。\n", me);
    return 1;
  }
  if (!me->is_busy())
    return notify_fail("你现在不忙。\n");
  me->interrupt_me();
  if (me->is_busy()) write("你现在很忙，停不下来。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：halt

这个命令可以停止你当前的动作。当然，如果你正处在忙的状态下是不行的。

HELP
  );
  if (wizardp(me))
    write(@HELP
巫师用法：halt [对象名称|here]

halt <对象名称> 可以停止某个特定player的战斗动作。halt here 可以停止当前屋子里所有战斗。

HELP
    );
  return 1;
}
