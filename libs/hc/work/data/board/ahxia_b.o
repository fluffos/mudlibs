ll_out，这样的做法不好，  假若我想一个task不是按照时间间隔来执行就没有办法了，例如备份任务  要求在每一天的2：00进行，然而如果用interval明显就非常不合理。我  认为适宜的做法是按照linux上的cron的方式，如果没有linux用NT下  的at的做法也不错。大概的思路是crond.c每秒调用一下主处理函数，来  判断在列表中的任务是否到达了执行时间，如果没到达，继续睡眠，到达  了则开始执行。用call_out或者heart_beat随你的便，考虑到call_out  有一定的误差，建议采用heart_beat,不过也没多大的误差咯 :))     第二，在你的任务列表里面的信息也太简单了吧。我认为里面的信息应  该包括：上次执行时间(last_exec),下次执行时间(next_exec)，任务信  息(describe),当前状态(state，包括excute,sleep,freeze),如果你觉  地还需要什么信息，尽管加上去。至于cron目录底下的任务装载到list中  的时间，我认为在create的时候比较好。你可以定一个load_task函数外  加上reload_task等等，如果要功能全，当然还包括add_task,remove_task,  refresh_task,query_task等等咯。      第三，最好能有一个log文件。。。*/#include <ansi.h>inherit F_DBASE;#define _DEBUG#ifdef _DEBUG#define DEBUG(X) CHANNEL_D->do_channel(this_object(), \"debug\", X );#else#define DEBUG(X)#endif#define CRON_PATH \"/u/ahxia/daemons/cron/\"#define SYS(X) CHANNEL_D->do_channel(this_object(), \"sys\", X );#define SYSMSG(X) message(\"system\", X, users());private static mapping cron_tab;mixed query_cron_files();private int init_cron_tab();private void _main_cron_loop();private int _evoke_cron_main(string fname);int set_interval(string f, int intv);int set_enabled(string f, int ena);void create(){    seteuid( ROOT_UID );    set(\"channel_id\", \"自动调用(Crond)\");    init_cron_tab();    callout(\"_main_cron_loop\",1);    SYS(\"crond created ...\");    return;}private int init_cron_tab(){    int i, intv, *start_day, *strat_time, *start_date;    string desc, status;    string *tmp_files = get_dir(CRON_PATH+\"*.c\");    object ob;    cron_tab = ([]);    for ( i = 0; i < sizeof(tmp_files) ; i++ ) {        tmp_files[i] = CRON_PATH+tmp_files[i];        //清理已经存在的文件object        if(ob = find_object(tmp_files[i]))            destruct(ob);        if (file_size(tmp_files[i]) > 0) {            intv = tmp_files[i]->query_cron_interval();            status = tmp_files[i]->query_cron_status();            start_time = tmp_files[i]->query_cron_start_time();            start_date = tmp_files[i]->query_cron_start_date();            start_day = tmp_files[i]->query_cron_start_day();            cron_tab += ([ tmp_files[i]:                ([                \"interval\": intv,                \"status\": status，     // enabled, executing, sleep, frozen                \"last_exec\": last_exec,                \"next_exec\": next_exec,                \"start_time\":start_time,                \"start_date\": start_date,                \"start_day\": start_day,                ]),            ]);        }else            DEBUG(\"init_cron_tab(), file [\" + tmp_files[i] + \"] does not exists!\");    } //end for    return i;}mixed query_cron_files(){    return keys(cron_tab);}private void _main_cron_loop(){    int i, intv, *start_day, *start_time, *start_date;    string status;    string *key = keys(cron_tab);    remove_callout(\"_main_cron_loop\");    for ( i = 0; i < sizeof(key); i++ ) {        interval = cron_tab[key[i]];        ena = cron_tab[key[i]][1];        if (ena) {            call_out(\"_evoke_cron_main\", 1, key[i]);        }     } //end for    call_out(\"_main_cron_loop\", 1);    return;}private int _evoke_cron_main(string fname){    DEBUG(\"_evoke_cron_main(), calling \"+fname+\".cron_main().\");    call_other(fname, \"cron_main\");}int set_interval(string f, int intv){    if (intp(intv) && stringp(f)) {        return cron_tab[f][0] = intv;    }else        return 0;}// 有用吗？不清楚 :(int set_enabled(string f, int ena){    if (intp(ena) && stringp(f)) {        return cron_tab[f][1] = ena;    }else        return 0;}","title":"2nd crond, unfinished","ip":"218.62.70.253:5555",]),(["author":"Ahxia(ahxia)","time":1036729324,"msg":"你改 wizard_room 了吗? 怎么里边的 board 没有了呢?","title":"to jingx","ip":"61.139.165.70:5555",]),(["author":"爱烦(ivan)","time":1036760673,"msg":"怎么过去那里没有BOARD了。","title":"...","ip":"211.151.89.16:5555",]),(["author":"Ahxia(ahxia)","time":1036808222,"msg":"i just wanna buy a web cam.","title":"hoho... go shopping","ip":"218.62.70.253:5555",]),(["author":"晴风(swordman)","time":1036941397,"msg":"更新时间似乎有问题啊当前时间：Sun Nov 10 23:14:23 2002，共有玩家 96 个总是推迟了一点。我现在这里的时间是23:42[2;37;0m","title":"to ahxia","ip":"61.183.180.134:5555",]),(["author":"Ahxia(ahxia)","time":1036967689,"msg":"// html.c - builds a /users.html file to show online users info.inherit F_CLEAN_UP;#include <ansi.h>int help(object me);void create(){  seteuid(getuid());}int build_html();string ansi2html(string arg);int main(object me,string arg){    string status;    status = wizhood(me);    if( me!=this_player(1) ||wiz_level(me) <wiz_level(status) )	return notify_fail(\"你没有权力使用这个指令。\\n\");    if(arg)	return help(me);    return build_html();}//modified version of short(), ported from /feature/name.cstring short_without_id(object me){    mapping party;    string nick, title, party_title, str, degree;//    str = sprintf(\"%s(%s)\", me->query(\"name\"), capitalize(me->query(\"id\")));////    if( stringp(nick = me->query(\"nickname\")) )//	str = sprintf(\"「%s」%s\", nick, str );    if ( stringp(nick = me->query(\"nickname\")) ) {	str = sprintf(\"「%s」\", nick);    }    if( stringp(title = me->query(\"title\")) )	str = sprintf(\"%s%s%s\", title,(nick?\"\":\" \"), str);    if ( mapp(party = me->query(\"party\")) ){	party_title = nullp(party[\"party_name\"]) ? \"\": party[\"party_name\"];	party_title += nullp(party[\"rank\"]) ? \"\" : party[\"rank\"];	str=sprintf(\"%s %s\", party_title, str);    }    if ( stringp(degree = me->query(\"degree\")) ) 	str = sprintf(\"%s%s%s%s%s\",degree,(party_title?\"\":\"\"),(title?\"\":\"\"),(nick?\"\":\" \"), str);    if( me->is_ghost() ) str = HIB \"(幽魂) \" NOR + str;    if( me->query_temp(\"netdead\") ) str += HIG \" <断线中>\" NOR;    if( query_idle( me ) > 120 ) {	str += HIM+\" <发呆\"+query_idle(me)/60+\"分钟>\"+NOR;    }    if( !living(me) ) str += HIR + me->query(\"disable_type\") + NOR;    return str;}string finger_info(object me){	string gender, perstr, agestr, email, selfdesc, signature, profile;	// TODO: return finger info.}int build_html(){    object *obs, *ppls;    string html, uinfo;    ppls = users();    obs = filter_array( ppls, (: environment($1) && !(wizardp($1) && $1->query(\"env/invisibility\")) :));    //obs = sort_array(obs->name(), 1);    uinfo = \"\";    foreach(object pl in obs){	uinfo += sprintf(\"<br>%s\"NOR\"%s<\\n\",RANK_D->query_rank(pl), short_without_id(pl), finger_info(pl));    }    html = @HTML<html><head><meta http-equiv=\"Content-Language\" content=\"zh-cn\"><meta http-equiv=\"Content-Type\" content=\"text/html; charset=gb2312\"><title>红尘(mud.hk.hi.cn:5555)在线玩家列表</title><!-- show detail script --><script language=\"VBScript\">function sh(id)<!--   if (id.style.display=\"none\") then   id.style.display=\"\"   else   id.style.display=\"none\"   end ifend function//--></script></head><body bgcolor=BLACK text=GREEN><p align=\"center\"><font color=\"red\"><a href=\"http://mud.hk.hi.cn\">☆红 尘☆</a> (<a href=\"telnet:mud.hk.hi.cn:5555\">mud.hk.hi.cn:5555</a>) ☆</font></p><center><hr width=85%></center>HTML;    html += sprintf (\"<center>当前时间：%s，共有玩家 %d 个。</center><p>\\n\", ctime(time()), sizeof(obs));    html += ansi2html(uinfo);    html += \"\\n<center><hr width=85%></center></body></html>\";    return write_file(\"/users.html\", html, 1);}string ansi2html(string arg){    arg = replace_string(arg, \" \", \"&nbsp;\");    arg = replace_string(arg, \"<\", \"&lt;\");    arg = replace_string(arg, \">\", \"&gt;\");    arg = replace_string(arg, \"&lt;br&gt;\", \"<br>\");    arg = replace_string(arg, BOLD, \"\");    arg = replace_string(arg, BLINK, \"\");    arg = replace_string(arg, U, \"\");    arg = replace_string(arg, REV, \"\");    arg = replace_string(arg, HIREV, \"\");    arg = replace_string(arg, ESC+\"[0m\", NOR);    arg = replace_string(arg, ESC+\"[0;1;37m\", \"\");    arg = replace_string(arg, RED, \"</font><font color=\\\"#800000\\\">\");    arg = replace_string(arg, HIR, \"</font><font color=\\\"#FF0000\\\">\");    arg = replace_string(arg, GRN, \"</font><font color=\\\"#008000\\\">\");    arg = replace_string(arg, HIG, \"</font><font color=\\\"#00FF00\\\">\");    arg = replace_string(arg, YEL, \"</font><font color=\\\"#808000\\\">\");    arg = replace_string(arg, HIY, \"</font><font color=\\\"#FFFF00\\\">\");    arg = replace_string(arg, BLU, \"</font><font color=\\\"#000080\\\">\");    arg = replace_string(arg, HIB, \"</font><font color=\\\"#0000FF\\\">\");    arg = replace_string(arg, MAG, \"</font><font color=\\\"#800080\\\">\");    arg = replace_string(arg, HIM, \"</font><font color=\\\"#FF00FF\\\">\");    arg = replace_string(arg, CYN, \"</font><font color=\\\"#008080\\\">\");    arg = replace_string(arg, HIC, \"</font><font color=\\\"#00FFFF\\\">\");    arg = replace_string(arg, HIW, \"</font><font color=\\\"#FFFFFF\\\">\");    arg = replace_string(arg, WHT, \"</font><font color=\\\"#C0C0C0\\\">\");    arg = replace_string(arg, BLK, \"\");    arg = replace_string(arg, NOR, \"</font><font>\");    arg = replace_string(arg, ESC+\"[\", \"^[\");    arg = \"<font>\" + arg + \"</font>\";    return arg;}int help(object me){    write(@TEXT生成一个html文本TEXT);    return 1;}","title":"html.c to be con't","ip":"218.62.70.253:5555",]),(["author":"Ahxia(ahxia)","time":1037053315,"msg":"<u onclick=sh(meihua)>文花(Meihua)</u><font id=meihua style='display:none'><br>meihua....skdfa;lksdjf;asjdfaskjdf<br></font>","title":"ho.","ip":"218.62.70.253:5555",]),(["author":"水点儿(ahxia)","time":1037808066,"msg":"void InsertSort(SeqList R) // SeqList is a Sequence List, e.g. an array{int i,j;for( i = 2; i <= n; i++) if(R[i].key<R[i-1].key){  R[0]=R[i];  j = i - 1;  do{   R[j+1] = R[j];   j--;  }while(R[0].key < R[j].key); } // end if} // end func////////////////////////////void qsort(SeqList r, int low, int high){  int pivotpos;  if(low < high){    pivotpos = partition(r, low, high);    qsort(r, low, pivotpos -1);    qsort(r, pivotpos + 1, high);  }}int partition(SeqList r, int i, int j){  RecordType pivot = r[i];  while(i < j){    while(i<j && r[j]>= pivot.key)      j--;    if(i < j)      r[i++]=r[j];    while(i<j && r[i].key <= pivot.key)      i++;    if(i < j)      r[j--] = r[i];  } //end while  r[i] = pivot;  return i;}qsort的时间复杂度在 O(n^2) 和 O(n*lg(n)) 之间,但是通常效果很好;insertsort时间复杂度在O(n) 和 O(n^2) 之间, 平均复杂度也在 O(n^2),但是时间上非常稳定","title":"sort?","ip":"218.62.70.253:5555",]),(["author":"心思思(ycc)","time":1042262477,"msg":"最近有人破坏大家练功赶快查下是谁快做处理死了好多人了害的不少人都死了上网了吧，网恋了吧，幼稚思想受骗了吧 网恋了吧，投入了吧，感情走上绝路了吧投入了吧，见面了吧，没有以前有电了吧见面了吧，后悔了吧，亮妹变成魔鬼了吧[2;37;0m","title":"to wiz","ip":"61.236.25.134:4000",]),(["author":"心思思(ycc)","time":1057667759,"msg":"ahxia我听大家说居然有wiz来杀玩家？这个事情怎么不和swordman交涉一下啊？是不是这里要关门了？麻烦你和swordman说一下上网了吧，网恋了吧，幼稚思想受骗了吧 网恋了吧，投入了吧，感情走上绝路了吧投入了吧，见面了吧，没有以前有电了吧见面了吧，后悔了吧，亮妹变成魔鬼了吧[2;37;0m","title":"to ahxia","ip":"61.236.25.129:5555",]),(["author":"水点儿(ahxia)","time":1057728735,"msg":"关门？不是的，至少不是现在出现的事情很让人无奈，如果我是管理员的话，会采取很激进的做法的还有，死丫头，总也不来，发呆id都没有见","title":"re ycc","ip":"218.62.71.34:5555",]),(["author":"心思思(ycc)","time":1057740842,"msg":"现在问题是怎么没人去解决问题好多玩家都被杀跑了而且有损失的玩家居然没有补偿还有就是偶的lww的huagong-dafa不见了说了好久没回复1001级啊5555另外现在fan没了，好多新手不会走路。最好把fan改回来你和swordman交涉一下最好能知道他大概什么时间有空能上线先这样吧。再联系上网了吧，网恋了吧，幼稚思想受骗了吧 网恋了吧，投入了吧，感情走上绝路了吧投入了吧，见面了吧，没有以前有电了吧见面了吧，后悔了吧，亮妹变成魔鬼了吧[2;37;0m","title":"to ahxia","ip":"61.236.25.132:5555",]),(["author":"心思思(ycc)","time":1057994502,"msg":"你还来不了？上网了吧，网恋了吧，幼稚思想受骗了吧 网恋了吧，投入了吧，感情走上绝路了吧投入了吧，见面了吧，没有以前有电了吧见面了吧，后悔了吧，亮妹变成魔鬼了吧[2;37;0m","title":"to ahxia","ip":"61.236.25.133:5555",]),(["author":"心思思(ycc)","time":1057994630,"msg":"好久都没看到你我上QQ找你你也不会到底你什么意思？上网了吧，网恋了吧，幼稚思想受骗了吧 网恋了吧，投入了吧，感情走上绝路了吧投入了吧，见面了吧，没有以前有电了吧见面了吧，后悔了吧，亮妹变成魔鬼了吧[2;37;0m","title":"to ahxia","ip":"61.236.25.133:5555