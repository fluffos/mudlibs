ile is required for EditPlus to run correctly.[K; MODIFIED FOR LPC, AHXIA[K[K#DELIMITER=,(){}[]-+*%/=\"'~!&|<>?:;.#[K#QUOTATION1='[K#QUOTATION2=\"[K#CONTINUE_QUOTE=n[K#LINECOMMENT=//[K#LINECOMMENT2=[K#COMMENTON=/*[K#COMMENTOFF=*/[K#COMMENTON2=[K#COMMENTOFF2=[K#ESCAPE=\\[K#CASE=y[K#PREFIX1=[K#PREFIX2=[K#PREFIX3=[K#PREFIX4=[K#PREFIX5=[K#SUFFIX1=[K#SUFFIX2=[K#SUFFIX3=[K#SUFFIX4=[K#SUFFIX5=[K;#SPECIAL_STX=LPC[K[K#KEYWORD=Reserved words[Kauto[Kbool[Kbreak[Kcase[Kcatch[Kchar[Kcerr[Kcin[Kclass[Kconst[Kcontinue[Kcout[Kdefault[Kdelete[Kdo[Kdouble[Kelse[Kenum[Kexplicit[Kextern[Kfloat[Kfor[Kforeach[Kfriend[Kgoto[Kif[Kinherit[Kinline[Kint[Klong[Kmapping[Kmixed [Knamespace[Knew[Koperator[Kobject[Kprivate[Kprotected[Kpublic[Kregister[Kreturn[Kshort[Ksigned[Ksizeof[Kstatic[Kstring[Kstruct[Kswitch[Ktemplate[Kthis[Kthrow[Ktry[Ktypedef[Kunion[Kunsigned[Kvarargs[Kvirtual[Kvoid[Kvolatile[Kwhile[K__asm[K__fastcall[K__based[K__cdecl[K__pascal[K__inline[K__multiple_inheritance[K__single_inheritance[K__virtual_inheritance[K[K#KEYWORD=Compiler directives[Kdefine[Kerror[Kinclude[Kelif[Kif[Kline[Kelse[Kifdef[Kpragma[Kendif[Kifndef[Kundef[Kif[Kelse[Kendif[K[K#KEYWORD=efuns[Kacos[Kadd_action[Kall_inventory[Kall_previous_objects[Kallocate[Kallocate_buffer[Kallocate_mapping[Kapply[Karrayp[Kasin[Katan[Kauthor_stats[Kbind[Kbreak_string[Kbufferp[Kcache_stats[Kcall_other[Kcall_out[Kcall_out_info[Kcapitalize[Kcatch[Kceil[Kchildren[Kclear_bit[Kclone_object[Kclonep[Kcommand[Kcommands[Kcos[Kcp[Kcrc32[Kcrypt[Kctime[Kdebug_info[Kdebugmalloc[Kdeep_inherit_list[Kdeep_inventory[Kdestruct[Kdisable_commands[Kdisable_wizard[Kdomain_stats[Kdump_file_descriptors[Kdump_prog[Kdump_socket_status[Kdumpal