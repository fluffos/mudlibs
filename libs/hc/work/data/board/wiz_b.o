 /binaries# the file which defines the master objectmaster file : /adm/obj/master# The global include file is included automatically.global include file : <globals.h># the file where all global simulated efuns are defined.simulated efun file : /adm/obj/simul_efun# file to swap out objects; not used if time to swap is 0swap file : /adm/tmp/swapfile# alternate debug.log file name (assumed to be in specified 'log directory')。","title":"driver用的脚本",]),(["author":"水点儿(ahxia)","time":1047091611,"msg":"搞不懂。。。大家想想还有什么办法能开启新的driver...用以上脚本有时候出segmeng错，没有segment错的时候也不行。。。","title":"大家帮忙看看为什么",]),(["author":"爱烦(ivan)","time":1047188794,"msg":"比如 int number = 15; float = f;f = ceil( (float)number / 10);ceil() 就计算不了了。 number不能用(float)强制为浮点进行计算吗？帮帮我解决啊~~~~~","title":"about float",]),(["author":"☆快乐★(happy)","time":1047415636,"msg":"  你个笨笨哦，你现在是用哪个os来开拓红尘的测试区？","title":"to ahxia",]),(["author":"☆快乐★(happy)","time":1047415808,"msg":"   hc测试区驾起来后，hc1只留2-3位巫师，其他都过测试区帮忙吧，","title":"to all wiz",]),(["author":"晴风(swordman)","time":1047455376,"msg":"了解，了解。呵呵大家多多支持测试区啊。[2;37;0m","title":"re 296",]),(["author":"晴风(swordman)","time":1047455420,"msg":"xiaoyu被杀档了？？？呵呵，今天dugu打电话给我，说xiaoyu杀档了。我什么都不知道。呵呵，好久没来，没看到有关杀档的帖子。哪位说明一下。谢谢[2;37;0m","title":"about xiaoyu",]),(["author":"拿破伦(jingx)","time":1047605214,"msg":"修正帮会超过EXP或者低于EXP都不能成立帮会的bugg现在应该没问题了，鉴于HC高手越来越多所以暂定EXP限制为3Y                            [0;1;37m无[1m[1m用[1m[1m强[1m[1m争[1m[1m高[1m[1m处[1m[1m心[1m[1m境[1m[1m多[1m[1m恬[1m[1m静[1m[0m                     [0;1;37m逃[1m[1m避[1m[1m四[1m[1m周[1m[1m欺[1m[1m诈[1m[1m隔[1m[1m绝[1m[1m人[1m[1m诱[1m[1m惑[1m[0m                           [0;1;37m欲[1m[1m言[1m[1m无[1m[1m言[1m[1m无[1m[1m语[1m[1m [1m最[1m[1m后[1m[1m最[1m[1m尽[1m[1m最[1m[1m终[1m[0m                       [0;1;37m淡[1m[1m忘[1m[1m淡[1m[1m名[1m[1m淡[1m[1m世[1m[1m [1m对[1m[1m月[1m[1m对[1m[1m日[1m[1m对[1m[1m影[1m[0m                            