//whitlady.c 

inherit NPC;

void create() {
  set_name("白衣少女", ({ "white lady", "lady", "white" }));
  set("gender", "女性");
  set("age", 18);
  set("long", "一个聪明伶俐的白衣少女。\n");
  set("shen_type", -1);
  set("combat_exp", 1000);
  set("str", 20);
  set("dex", 18);
  set("con", 19);
  set("int", 20);
  set("per", 20 + random(10));
  set("attitude", "friendly");
  set("max_qi", 100);
  set("max_jing", 100);
  set("neili", 100);
  set("max_neili", 100);
  set("score", 800);
  set_skill("force", 20);
  set_skill("dodge", 20);
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("taming", 100);
  set_temp("apply/attack", 8);
  set_temp("apply/defense", 12);
  set_temp("apply/damage", 11);
  set_temp("apply/armor", 7);
  create_family("白驼山派", 10, "弟子");
  setup();
  carry_object("/d/baituo/obj/baipao")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (random(3) == 1)
    say("白衣少女冲你眨了眨眼睛，说道：如果你能帮我弄只白兔来，我一定...\n");
  else
    say("白衣少女招招手说道：这位" + RANK_D->query_respect(ob)
      + "，过来和我们一起玩捉迷藏吧。\n");
  return;
}

int accept_object(object who, object ob) {
  object obn;
  int skill_basic;
  if (!who || environment(who) != environment()) return 0;
  if (!objectp(ob)) return 0;

  if (!present(ob, who)) { say("你没有这件东西。\n"); return 0; }

  if (ob->query("id") != "bai tu")
    say("白衣少女瞪着大大的眼睛望着你。\n");

  say("白衣少女怜爱地摸了摸小白兔的脑袋，回过头在你耳边低语了几句，便跑开了。\n");

  skill_basic = who->query_skill("taming");
  if (!skill_basic)
    who->set_skill("taming", 1);

  if (skill_basic < 200)
    who->improve_skill("taming", skill_basic / 5 + 1, 0);

  destruct(ob);

  call_out("new_baitu", 5);

  return 1;
}

void new_baitu() {
  object tuzi;
  object room;
  object *ob;
  int sum = 0, i;

  remove_call_out("new_baitu");

  room = find_object("/d/baituo/tuyuan.lpc");

  if (!room)
    return;

  ob = all_inventory(room);

  for (i = 0; i < sizeof(ob); i++)
    if (ob[i]->query("id") == "bai tu")
      sum++;

  if (sum > 2)
    return;

  tuzi = new("/d/baituo/npc/baitu.lpc");
  tuzi->move("/d/baituo/tuyuan");
  tell_room(room, "一只兔子不知道从哪儿跳了出来。\n");
}
