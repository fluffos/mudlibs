//tulong.c
#include <weapon.h>

inherit BLADE;

void create() {
  set_name(HIY HIR "屠龙刀" NOR, ({ "tulong dao", "dao", "blade" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 50000);
    //        	set("no_drop", "1");
    set("material", "iron");
    set("long", "这是天下第一利器，有“ 武林至尊，宝刀屠龙，号令天下，莫敢不从。”之说。\n");

    set("wield_msg", "一阵雷鸣电闪过后，$n已在$N手中，天地为之变色。\n");
    set("unwield_msg", "$N将$n插回腰间，华光顿敛，天地间只闻龙鸣。\n");
  }
  init_blade(600);
  setup();
}
