inherit ROOM;
void create() {
  set("short", "雨神堂大堂");
  set("long",
    "地处雾中楼西部，为天下七十二绝景之一。\n"
    "这是一座红色的宫殿式建筑，大殿正门正当长廊尽头，\n"
    "廊道看来均像一色，同为红色大理石所砌，打磨得如同\n"
    "明镜，尤其是在夕阳照射之下，交织成一片玫瑰般的异\n"
    "彩，此处乃心思思修真传教之所。\n");
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "ysroad",
  ]));
  setup();
}
