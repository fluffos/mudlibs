inherit ROOM;
void create() {
  set("short", "小广场");
  set("long",
    "这是一块用麻石铺成的小广场，周围是典型的江南水乡，风景怡人。
几只小鸡、小鸭跑来跑去，一派农村气象。后山苍苍郁郁，一条小径不知
是通往哪里的。\n" NOR);

  set("exits", ([
    "east": __DIR__ "mishi",
    "west": __DIR__ "riverroom",
    "north": __DIR__ "bridge",
    "southup": __DIR__ "houshan",
  ]));
  set("outdoors", "ground2");
  setup();
}

int valid_leave(object me, string dir) {
  object ob;
  if (dir != "southup")
    return ::valid_leave(me, dir);
  if (!::valid_leave(me, dir))
    return 0;
  if (me->query("wzl") != 1)
    return notify_fail("那里是人家的后山，你就不要去啦！\n");
}
