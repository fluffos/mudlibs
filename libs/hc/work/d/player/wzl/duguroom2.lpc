inherit ROOM;

void create() {
  set("short", "鳳鸣阁二楼");
  set("long",
    "这里是鳳鸣阁轩二楼，也是本帮的最机密地方之一，因为有秘道可方便地
东到" HIC "雷电" NOR "两堂，西到" HIC "风雨" NOR "两堂，南到" HIW "雾神堂" NOR "，向北就是本帮" HIY "议事厅" NOR "，向上却可
通过秘道直达本帮广场上的" HIG "聊天大榕树。\n" NOR);
  set("exits", ([
    "down": __DIR__ "duguroom",
    "up": __DIR__ "chatroom",
    //            "northwest" : __DIR__"wlt",
    //            "northeast" : __DIR__"wmt",
  ]));
  set("no_clean_up", 0);
  set("no_fight", 1);
  set("no_magic", 1);
  set("valid_startroom", "1");
  set("freeze", 1);
  set("objects", ([
    __DIR__ "npc/dugu": 1,
  ]));
  setup();
}
