inherit ROOM;
void create() {
  set("short", "雾神堂大堂");
  set("long",
    "武林盟主天下第一剑天上星在宅第。位于天\n"
    "府之都以西，堂内充盈玄阴地气，严寒彻骨，各种\n"
    "建筑各具特色，规模宏大，气势磅礴，雕铸细腻，\n"
    "技艺精湛，富丽堂皇，蔚为壮观。旧传堂内有雾，\n"
    "秋雁归时宿此，故名。后天上星与其夫人本橡在此\n"
    "参透武艺之精髓。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "northdown": __DIR__ "wsroad2",
  ]));
  setup();
}
