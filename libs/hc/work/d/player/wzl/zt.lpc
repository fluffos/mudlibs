inherit ROOM;

void create() {
  set("short", "总坛");
  set("long", "
    这里是雾中楼的总坛，中间摆着一个香炉，给有意加入本帮的有心人插香
用的。旁边那位是本帮的使者之一，你可以找他要香(ask shizhe about 入会)。
四周静悄悄，透出一股严肃神圣的气氛，让人觉得肃然起敬！\n");

  set("exits", ([
    "east": __DIR__ "step1",
    "west": __DIR__ "step2",
    "south": __DIR__ "ground1",
    "northdown": __DIR__ "guangchang",
  ]));
  set("objects", ([
    __DIR__ "obj/xianglu": 1,
    __DIR__ "npc/shizhe": 1,
  ]));
  setup();
}
