inherit ROOM;

void create() {
  set("short", "路口");
  set("long",
    "这是个分叉路口，南面通往雾中楼最令人骄傲的雾神堂。西边是弟子们练功的\n"
    "好地方，东边是兵器房，你可以去选把称手的兵器。\n");
  set("exits", ([
    "east": __DIR__ "bingqi",
    "west": __DIR__ "shulin1",
    "north": __DIR__ "ground1",
    "south": __DIR__ "wsroad2",
    "southeast": __DIR__ "xiaolu1",
  ]));

  set("objects", ([
    __DIR__ "npc/dizi": 2,
  ]));

  set("outdoors", "wsroad1");
  setup();
  replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  object ob;
  if (dir != "southeast" || dir != "west")
    return ::valid_leave(me, dir);
  if (!::valid_leave(me, dir))
    return 0;

  if (me->query("wzl") == 1 || wizardp(me))
    return 1;
  else
    return notify_fail("这位客人请留步, 那里只有本帮兄弟才可以进的。\n");
}
