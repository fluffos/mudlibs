inherit ROOM;

void create() {
  set("short", "大门");
  set("long",
    "这里是通往雾中楼最令人骄傲的雾神堂。雾神堂是每个雾中楼\n"
    "弟子敬仰的地方，也是每个人奋斗的目标——进入雾中楼。\n");
  set("exits", ([
    "north": __DIR__ "wsroad1",
    "southup": __DIR__ "wst",
  ]));

  set("objects", ([
    __DIR__ "npc/dizi": 2,
  ]));
  setup();
  replace_program(ROOM);
}
