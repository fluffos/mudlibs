inherit ROOM;
void create() {
  set("short", "『雷神堂』");
  set("long",
    "从外面看上去，雷神堂堂皇、宏大，\n"
    "实际上是一个充满疯狂、恐怖之地。在这里，任何人都\n"
    "可能被杀，也绝没有人救他。之所以形成这种局面皆因\n"
    "该堂堂主南单有一条特殊的堂规：我不杀人，人便杀己\n"
    "。该堂所容纳的都是当今江湖独霸一方的豪杰、无人敢\n"
    "惹的凶神、或者一派掌门之尊。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "lsmen",
  ]));
  setup();
}
