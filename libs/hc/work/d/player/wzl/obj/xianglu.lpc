
#include <ansi.h>
inherit ITEM;

object find_player(string target)
{
    int i;
    object *str;
    str=users();
    for(i=0;i<sizeof(str);i++)
        if (str[i]->query("id")==target)
        {
            if (!environment(str[i]))
                return 0;
            else
                return str[i];
         }
    return 0;
}

void create()
{
    set_name("香炉", ({ "xiang lu", "lu" }) );
    set_weight(300000);
    set_max_encumbrance(5000);
    if( clonep() )
        set_default_object(__FILE__);
    else
    {
        set("unit", "个");
        set("long", "这是一个常见的香炉，用来让有心加入本帮的人插香(pushin)用的。\n");
        set("value", 1000);
        set("material", "gold");
        set("no_get",1);
        set("no_drop",1);
        set("amount",30);
    }
    setup();
}

void init()
{
    add_action("do_pushin", "pushin");
    add_action("do_name","kaichu");
}

int do_pushin(string arg)
{
    object me, ob,*inv;
    int i;
    me = this_player();
    if(!arg&&arg!="xiang")
        return notify_fail("你要插什么东西？\n");
    if( me->query("wzl") == 1 )
        return notify_fail("你已经是本帮弟子啦！\n");
    if( me->query_temp("marks/wzldian")==1 )
    {
    	me->delete("party");
    	message("vision",HIW"〖雾中楼〗"NOR":"HIR" 恭喜"HIY+me->short()+NOR HIR"正式加入我帮，特公告天下!\n"NOR,users());
    	me->set("party/rank",HIW"雾中楼"HIY"弟子"NOR);
    	me->set("wzl",1);
        tell_object(me, "\n恭喜你成为雾中楼的一员！现在请你先阅读本帮的帮规。\n");
        ob = new("/d/player/wzl/obj/guide");
        ob->move(this_player());
        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++)
        {
            if(inv[i]->query("name") == "香")
                 destruct(inv[i]);
        }
        return 1;
    }
    else
        return notify_fail("你把一柱香插进香炉，拜了两拜。\n");
    return 0;
}

int do_name(string target)
{
    object me, dest, *all,ob;
    me = this_player();
    ob = find_player(target);
    all = livings();
    if( !target || target==" ")
        return notify_fail(me->name()+"输入被开除的人的名字！\n");
    foreach (dest in livings())
    {
        if( target == dest->name(1) || dest->id(target) )
            break;
    }

    if(me->query("id")!="dugu")
        return notify_fail(me->query("id")+"你不是楼主，你没有这个权力。\n");
    if( !dest || !environment(dest))
        return notify_fail("他现在不在游戏中。\n");
    if(!(target == dest->name(1) || dest->id(target)) )
        return notify_fail("他现在不在游戏中。\n");
    if( ob->query("wzl")!= 1 )
        return notify_fail("他不是雾中楼的成员 \n");
    if (dest==me)
    {
        tell_object(this_player(),"你疯啦？要开除自己？\n");
        return 1;
    }

    if (ob->query("wzl")==1)
    {
        ob->delete("wzl");
        ob->delete("party");
        message("vision",HIW"〖雾中楼〗"NOR+":"+HIR" 由于"HIW+ob->short()+NOR HIR"不再适合在我帮，被逐出我帮。\n"NOR
                        +HIW"〖雾中楼〗"NOR+":"+HIR" 从今以后此人的一切行为与本帮无关，特此声明公告天下!\n"NOR, users());
    }
    ob->move("/d/city/guangchang");
    return 1;
}
