// yunwuling.c
// wings@HC

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(WHT "云雾令牌" NOR, ({ "yunwu ling", "ling" }));
  set_weight(100);
  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("value", 0);
    set("unit", "块");
    set("long", "    云雾令牌乃万载菩提木所制，长仅尺半，坚逾金钢，可避百邪，\n" +
      "任何神刃亦无法损伤分毫，六成黄金、四成精钢，此令牌出炉时，神\n" +
      "鬼共忌，显现出一种无法可解的凶兆，酷寒之气凝入其间。\n");
    set("no_drop", 1);
  }
}
