#include <ansi.h>
inherit ITEM;
void create()
{
    set_name( NOR "『"HIW"雾中楼"NOR"』"HIC"帮规" NOR, ({ "guide","bangui" }) );
    set_weight(10);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "本");
        set("long",
"\n                     『雾中楼帮规』\n\n"
"雾中楼是dugu创办得玩家帮派，加入雾中楼的玩家必须将所有id都加入到雾中楼，\n"
"加入雾中楼的弟子必须服从帮派内部的分配，还要遵守各项规定。雾中楼一共有\n"
"五个堂，分别是风神、雨神、雷神、电神、雾神堂。其中风是练功，雨是新手入\n"
"门、雷是雇佣杀手的、电是后勤部、雾是给老不死养老的地方。 \n\n"

"        总则：\n"
"一：不得欺负其他非本帮玩家。 \n"
"二：帮派内部要团结，不许屠杀自己帮派弟子，不得违反帮规。 \n"
"三：帮派内部有争议由帮主和堂主解决，不得私自行事。 \n"
"四：发生有pk帮派弟子事件后，由帮主决定行动计划。 \n"
"五：外部雇佣本帮杀手应由电神堂主和帮主指定杀手。 \n"
"六：各堂自己的堂规不得和帮规有所冲突，否则将视为无效。 \n"
"七：和其他帮派发生冲突事，应注意保护自己帮派形象。 \n"
"八：内部杀手完成任务后帮派内部要绝对保密。 \n"
"其它待定.... \n\n"

"        惩罚规定: \n"
"一:如pk自己帮派成员，将pk者的杀人id由雷神堂主负责指定杀手将其pk双倍次数，\n"
"如被的人损失较大，者加重对pk者的惩罚，后果严重（综合损失在50万潜能，skills\n"
"降低3级，exp损失占exp的20%的将视为严重后果)者将被开除帮派，并将视为雾中楼敌人，\n"
"予以消灭。(对于杀手接任务造成的伤害，由帮主裁定；但杀手将不负责任。\n"
"*注意*电神堂负责接任务和保密工作,接任务后应向堂主和帮主汇报）\n"
"二:非本帮人员残杀本帮弟子后要向堂主汇报，后移交帮主裁决。不得私自进行报复。\n"
"如本帮弟子惹事造成和非本帮人员冲突，将由帮主决定对本帮弟子的惩罚。 \n"
"三:帮主应注意本帮利益，如果本帮帮众对帮主有异议，可以组织帮众开会投票解决。\n"
"如帮众不全可以由五大堂主议会决议。(必须有1个wiz在场） \n"
"四:对本帮泄露杀手顾主者将被处以开除本帮并限制发展。\n"
"(该泄露者ip所有id将同视为限制对象) \n\n"

"        奖励规定: \n\n"
"一:无pk(杀手被雇pk除外) \n"
"10天现实时间,不包括玩家不在线时间之内,奖励gold 1万。 \n"
"50天现实时间,不包括玩家不在线时间之内,奖励gold 20万 \n"
"100天现实时间,不包括玩家不在线时间之内,奖励挂机器跳楼10天(24小时) \n"
"每100天为一个循环,各奖励不兼得(玩家自己申请保证时间) \n"
"二:对本帮有突出贡献者奖励挂机器人20天挂机器人跳楼(24小时) \n"
"突出贡献包括(做特殊任务机器人，不包括以公开得机器人) \n"
"三:杀手完成任务后将由本帮所有帮众负责保护。\n"
"并奖励杀手30%的佣金。挂跳楼2天(24小时) \n"
"四:新手成长到5000万exp时奖励挂考试机器人12小时,成长到1亿exp后奖励
"挂机器人考试24小时。 \n"
"<暂时这些其它待定> \n"
"\n\n                                                      —— 雾中楼 ——\n");
        set("value", 100);
        set("material", "paper");
    }
    setup();
}