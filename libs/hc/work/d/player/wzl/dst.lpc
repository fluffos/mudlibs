inherit ROOM;
void create() {
  set("short", "『电神堂』");
  set("long",
    "电神堂居群山之中，林木阴翳，每届晚秋，\n"
    "满山红叶，灿烂有如晚霞。“停车坐爱枫林晚，霜叶红于\n"
    "二月花”即是为此间美景陶醉所作。堂内秘藏诸多稀世珍\n"
    "宝，武林中人人垂涎而不惜以命相搏。\n"
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "dsmen",
  ]));
  setup();
  replace_program(ROOM);
}
