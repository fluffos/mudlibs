//damen.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "雾中楼大门");
  set("long", "
    你来到一座结构宏伟的建筑前，左右石坛上各插着一根两丈多高的旗杆，
杆上青旗飘扬。右首旗子用金线绣着一头张牙舞爪的狮子，狮子上头有一只
蝙蝠飞翔。左首旗子上写着" BLINK HIW "雾中楼" NOR "三个烫金大字，银钩铁划，刚劲非凡。\n");

  set("exits", ([
    "south": __DIR__ "road1",
    "north": "/d/city3/guandao2",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/menwei": 2,
  ]));

  setup();
}

void init() {
  add_action("do_guard", "guard");
}

int valid_leave(object me, string dir) {
  object *ob, obLing;
  int i;

  if (me->query_temp("wzl/guarding"))
    me->delete_temp("wzl/guarding");
  if (dir != "south")
    return ::valid_leave(me, dir);

  if (!environment(me))
    return notify_fail("哪儿？");

  ob = all_inventory(this_object());

  for (i = 0; i < sizeof(ob); i++) {
    //如果是门卫或者守门的玩家的话
    if (objectp(ob[i]) && (ob[i]->query("id") == "men wei" || ob[i]->query_temp("wzl/guarding")) && living(ob[i])) {
      if (ansi2str(me->query("party/party_name")) == "雾中楼") {
        //是帮中人，让其通行
        if ((me->query("gender") == "男性"))
          message_vision("$N说道：帅哥～请进。\n", ob[i]);
        else if ((me->query("gender") == "女性"))
          message_vision("$N嘻嘻笑道：靓女～请进，请进。\n", ob[i]);
        return 1;
      }  //不是帮中人，但是有令牌
      else if (obLing = present("yunwu ling", me)) {
        message_vision("$N从腰带中掏出$n晃了晃，径直走入大门中。\n", me, obLing);
        return 1;
      } else
        return notify_fail(ob[i]->name() + "喝道：你不是本帮弟兄，先去找楼主加入我帮吧，这位" + RANK_D->query_respect(me) + "请止步。\n");
    }
  }

  return ::valid_leave(me, dir);
}

int do_guard(string arg) {
  object me;

  me = this_player();

  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if (ansi2str(me->query("party/party_name")) == "雾中楼") {
    if (me->query_temp("wzl/guarding"))
      return notify_fail("你已经在守门了。\n");
    else {
      message_vision("$N守在门口，倒背着双手，双眼四处张望着。\n", me);
      me->set_temp("wzl/guarding", 1);
      me->start_busy(2);
      return 1;
    }
  } else {
    message_vision("$N很无趣地在门口晃悠了两圈。\n", me);
    me->start_busy(2);
    return 1;
  }

  return 1;
}
