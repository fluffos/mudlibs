
inherit ROOM;

void create()
{
	set("short", "小路");
	set("long", "丛林中密布羊肠小路，当心别迷路。\n");

	set("exits", ([
                "north" : __DIR__"xiaolu"+(random(6)+2),
                "south" : __DIR__"xiaolu8",
                "east" :  __DIR__"xiaolu"+(random(6)+2),
                "west" :  __DIR__"xiaolu"+(random(6)+2),

	]));

	setup();
}

