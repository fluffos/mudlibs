inherit ROOM;
void create() {
  set("short", "后广场");
  set("long",
    "这是一块用大块麻石铺成的小广场，就在总坛的后面。再走下去\n"
    "就是本帮的后山，本帮弟子没事就别乱跑，不是本帮兄弟更要小心！\n"
    "东边是本帮楼主的鳳叁阁，他妹妹明月姑娘就住在西边。\n");

  set("exits", ([
    "east": __DIR__ "duguroom",
    "west": __DIR__ "xiaoyuroom",
    "south": __DIR__ "wsroad1",
    "north": __DIR__ "zt",
  ]));
  set("outdoors", "ground1");
  setup();
}
