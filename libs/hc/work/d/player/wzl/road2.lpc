inherit ROOM;
void create() {
  set("short", "诚信路");
  set("long",
    "这是雾中楼的诚信路，地面铺着红色地毯。南面通往总坛。\n"
    "西南方通往『风神堂』东南方通往『雨神堂』\n");
  set("exits", ([
    "south": __DIR__ "road3",
    "north": __DIR__ "yingbing",
    "southeast": __DIR__ "ysroad",
    "southwest": __DIR__ "fsroad",
  ]));
  set("outdoors", "road2");
  setup();
  replace_program(ROOM);
}
