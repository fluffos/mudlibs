
inherit ROOM;

void create()
{
	set("short", "小路");
	set("long", "丛林中密布羊肠小路，当心别迷路。\n");

	set("exits", ([
                "north" : __DIR__"xiaolu"+(random(3)+2),
                "south" : __DIR__"xiaolu9",
                "east" : __DIR__"xiaolu"+(random(4)+2),
                "west" : __DIR__"xiaolu"+(random(5)+2),

	]));

	setup();
}

