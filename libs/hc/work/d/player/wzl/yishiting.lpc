inherit ROOM;

void create()
{
	set("short", "议事厅");
	set("long",
"这里是本帮的议事厅，也是长老们日常议事的地方，平时只有楼主
和各位堂主可以上来。很多关于本帮发展的决策都是在这里商议决定的。
你可以看到几位须发皆白的老者正在大厅里商议着什么。这里透出一股
凝重的气氛，让人觉得肃然起敬！\n");

	set("exits", ([
		"westdown" : __DIR__"step2",
		"eastdown" : __DIR__"step1",
	]));
	set("no_fight",1);
        set("no_magic",1);
        set("freeze",1);
	setup();
	replace_program(ROOM);
}
