inherit ROOM;

void create() {
  set("short", "迎宾路");
  set("long",
    "踏进大门，迎面是一条气派的宽敞平坦的白玉大道，两旁栏杆都刻有小\n"
    "狮子，神态各异。你走在上面，不禁心里有点惊喜而又尊贵的感觉。前方是\n"
    "雾中楼的迎宾楼。\n");

  set("exits", ([
    "north": __DIR__ "damen",
    "south": __DIR__ "yingbing",

  ]));
  set("outdoors", "road1");
  setup();
  replace_program(ROOM);
}
