inherit ROOM;
void create() {
  set("short", "小木桥");
  set("long", @LONG
这是一条小木桥，由于年旧失修，走在上面你觉得摇摇晃晃，
快走啊，可能随时要断了，掉到河里可就惨了。
LONG
  );
  set("exits", ([
    "south": __DIR__ "ground2",
    "north": __DIR__ "xiaolu9",
  ]));
  setup();
  set("outdoors", "bridge");
  replace_program(ROOM);
}
