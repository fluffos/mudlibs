//menwei.c
inherit NPC;
void greeting(object);
void init();
void create() {
  set_name("门卫", ({ "men wei", "wei" }));
  set("nickname", "铁狮子");
  set("gender", "男性");
  set("age", 22);
  set("long", "这是个年轻力壮的卫兵，样子十分威严。\n");
  set("attitude", "friendly");
  set("shen_type", -1);
  set("str", 1500);
  set("int", 23);
  set("con", 50);
  set("dex", 50);
  set("max_qi", 800000);
  set("max_jing", 300);
  set("neili", 500000);
  set("max_neili", 1000);
  set("jiali", 500);
  set("combat_exp", 129999000 + random(1000));
  set("score", 1200);
  set_skill("force", 1500);
  set_skill("dodge", 1530 + random(10));
  set_skill("unarmed", 1530 + random(10));
  set_skill("parry", 1530 + random(10));
  set_skill("jiuyin-baiguzhao", 1530 + random(10));
  set_skill("tiyunzong", 1530 + random(10));
  set_skill("jiuyang-shengong", 1530 + random(10));
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "jiuyin-baiguzhao");
  map_skill("parry", "jiuyin-baiguzhao");
  map_skill("force", "jiuyang-shengong");
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/armor", 20);
  setup();
  //        carry_object("/d/baituo/obj/dadao")->wield();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if ((ob->query("wzl")) == 1) {
    if ((int)ob->query_condition("killer")) {
      say("门卫冷冰冰地说：这位" + RANK_D->query_respect(ob)
        + "官府来文请师兄火速去扬州城一趟。\n");
    } else {
      say("门卫笑吟吟地说道：这位" + RANK_D->query_respect(ob)
        + "您辛苦了，快请进吧。\n");
    }
  } else {
    //       say("门卫两眼一瞪，说道：这位" + RANK_D->query_respect(ob)
    //           + "你是来找麻烦的吧？\n我劝你不要轻举妄动！\n");
  }
  return;
}
