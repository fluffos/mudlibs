 //dugu.c

#include "/d/player/wzl/include/wzl.h"

inherit NPC;

string ask_guide();
string ask_ling();

void create()
{
   set_name("鳳叁",({"bang zhu"}));
   set("title",HIW"雾中楼"HIR"领袖"NOR);
   set("long",
      "他就是雾中楼的楼主\n"
      "他脸上带着忧郁而又痴痴的笑容。\n");
   set("age", 60);
   set("attitude", "peaceful");
   set("shen_type", 0);
   set("str", 30);
   set("int", 30);
   set("con", 30);
   set("dex", 30);
   set("per", 30);

   set("max_qi", 500000);
   set("max_jing", 500000);
   set("neili", 50000);
   set("max_neili", 500000);
   set("jiali", 500);
   set("combat_exp", 200000000);
   set("score", 500000);

   set_skill("dodge",2002);
   set_skill("unarmed",800);
   set_skill("force", 2222);
   set_skill("parry", 800);
   set_skill("sword", 800);
   set_skill("literate", 2002);

   set("inquiry",
      ([
         "name" : "我就是雾中楼的楼主。你叫什么名啊？\n",
         "here" : "这里是大名鼎鼎的雾中楼，难道你没有听说过？\n",
         "雾中楼" : (: ask_guide :),
         "帮规" : (: ask_guide :),
         "令牌" : (: ask_ling :),
         "云雾令牌" : (: ask_ling :),
      ]));
   setup();
}

string ask_guide()
{
   object ob;
   
   if( present("guide", this_player()) )
      return RANK_D->query_respect(this_player()) +
      "你现在身上不是有了吗，怎么又来要了？别烦我～\n";
   
   ob = new("/d/player/wzl/obj/guide");
   
   ob->move(this_player());
   
   return "我很忙，你自己看看这指南吧。";
}

string ask_ling()
{
   object me = this_player();
        
   if ( me->query("id") == "dugu" || wizardp(me) )
   {
      object ob = new(OBJ_LINGPAI);
            
      if ( !ob )
      {
         message_vision("$N脸上露出慌张的神情，双手在身上到处乱摸，似乎在找什么东西...\n",this_object(),me);
         return "不好意思，东西找不到了！";
      }
            
      message_vision("$N从裤腰带里掏出一块"+ob->name()+"，小心翼翼地交给了$n。\n",this_object(),me);
      ob->move(me);
      
      return "要小心保管啊。";
   }
   
   return "云雾令牌是我们雾中楼的信物，有此令牌，可得到本帮兄弟的照顾。";
}
