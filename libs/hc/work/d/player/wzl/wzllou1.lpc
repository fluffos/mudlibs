inherit ROOM;
void create()
{
      set("short", HIC"轻功大楼");
    set("long", @LONG
这里是和轻功小楼对称的另一个练功楼，只见无数个身影在
围绕着小楼漫天飞舞。似梦似幻,弄得自己也忍不住前去大展身手,
而不知不觉间你已经是一等一的武林高手了。
LONG
    );
    set("exits", ([
          "west" : __DIR__"fightroom2",
        "enter" : __DIR__"wzllou2",
    ]));
            set("no_magic", 1);
    set("objects",([
    ]));
    setup();
}
