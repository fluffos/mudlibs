// Room: /d/player/mingren/bardrm.c
// by zli

#include <room.h>

inherit ROOM;
void create() {
  set("short", "矿泉水厂");
  set("long", @LONG
    一家生产劣质矿泉水的破厂,听说是bard的小屋。门口有个招牌(jieshao)。
红尘中无数的人物谱里，唯有bard独树一格。大凡进入名人堂者，或侠或魔，都是一代名人。
然而，正所谓人如其名，矿泉水一生平淡，既没有喧嚣的事迹，也没有轰轰烈烈的激情，就
在这平平淡淡中，却创造了属于自己的光荣。
LONG);

  set("no_fight", "1");
  set("no_steal", "1");
  set("no_beg", "1");
  set("no_sleep_room", "1");
  set("no_clean_up", 0);
  set("no_magic", 1);

  set("exits", ([
    "out": __DIR__ "mingren4",
  ]));
  set("item_desc", ([
    "jieshao": "每次都是悄悄的来，后又悄悄的走，红尘中只留下不辍练功的身影。在他的内心深处，也许 \n"
    "只有对武学的痴迷吧。“业，精于勤，荒于输”正是这种不问世事，不求闻达的追求，使他\n"
    "在默默无闻中登上了一个令人惊叹的高峰。当后人惊叹他的成就时，他却淡然地一笑，回归\n"
    "到自己的世界。望着他飘然远去的身影，不禁感慨：原来这也是人生的一种境界。\n"
    "“雾失楼台，月渡迷津”。当滚滚红尘中的纭纭众生，为着争名逐利而杀戮不休的时候，却\n"
    "忘记了“宁静致远”这样的武学真谛，而这又不仅仅只是“武”的专属，没有“宁静”的心\n"
    "性和人格，如何能攀登“致远”的颠峰。本是一个普通的人，却创造出一个新的武林神话。\n"
    "或许，将来还会有人继续如他这样攀登的吧，攀的更高，望的更远，但却都是站在了他的肩\n"
    "膀上的。一座令人仰止的高峰，当它矗立起来后，就成为了红尘后世的丰碑！\n"
    "走过红尘的生与死，在这漫漫长路，有着flotalk,baituo,link,seduce,jing.....等朋友，\n"
    "也是他这生的知己。或许他们更能了解一些矿泉水的道路吧。\n"
  ]));
  set("objects", ([
    __DIR__ "npc/bard": 1,
  ]));
  setup();
  replace_program(ROOM);
}
