//ROOM zlirm.c
inherit ROOM;

void create() {
  set("short", HIC "一切随缘" NOR);
  set("long",
    "这里是一个明亮的小屋，是传说中的江湖第一神贩小贩的窝，你\n"
    "刚到门口就听到小贩那熟悉而亲切的叫喊声:“卖秘籍了！新鲜\n"
    "的武林秘籍…………”“祖传仙药，包治百病，一帖就灵!”你\n"
    "一进屋就被里边丢的一地的宝物吓傻了眼：碧玉剑，玄铁剑，倚\n"
    "天剑，金蛇剑，七星剑，血狼，黄金斧，紫金锤。。。墙上帖着\n"
    "一张黄熏熏古老的价格表(jieshao)。屋脚有个书架，堆满了你\n"
    "梦寐以求的失传多年的秘籍，窗台上有几盆奇花，竟然是幽昙仙\n"
    "花，你忍不住上前想。。。可惜脚下一滑，不知怎么被人一脚踢\n"
    "了出去，一摸口袋，钱包不知何时没了。\n"
  );
  set("exits", ([
    "out": "/d/player/mingren/mingren3",
  ])); set("no_clean_up", 0);
  set("item_desc", ([
    "jieshao": "    小贩，一听这名就该明白他是做什么的了。因为初入江湖穷困潦倒，凭借\n"
    "一股韧劲四处探询各类宝物的所在。他偷抢拐骗，竞发现了不少江湖奇宝，生\n"
    "意倒也算过的去，多年来积累下无数家财，成为红尘一大富豪。但贩卖宝物是\n"
    "他的癖好，尽管腰缠万贯，却还是老见他叫卖于大街小巷......可谓世界之大\n"
    "，无奇不有。\n"

    "　　想当年初入江湖，第一个认识了美美(ddk)这死妞，从她那弄了3 tg做老本\n"
    "。与美美上昆仑，闯少林，为将来的江湖生涯打下了基础。之后长期在白驮山\n"
    "和人抢夺task，结下了一些朋友，当然也有仇家了。其中一个后来与他成了忘\n"
    "年之交的大河马link和他的苦瓜老婆小珈。对他以后的江湖生涯起了巨大的影\n"
    "响。想当年几人同生死，共进退，可是那最后小两口却丢下他归隐山林去了，\n"
    "只是偶尔窜出来陪他聊聊天。。。哎，那两个老东东，不提也罢。\n"

    "　　当时的江湖正值多事之秋，门派间的争斗无比惨烈，其中以凌霄山庄与啸\n"
    "天会的争斗为最。在那期间小贩得到了历练，越发的成熟了。在dami，adna，\n"
    "get的帮助下，迅速的成张着，遥想当年的趣事。。。在江湖旅途中结识了诗\n"
    "雨(shiyu)，紫霜(anak)等众多红颜知己，那些珍贵的友情都是他一生的财富。\n"

    "　　早期的他为寻尽天下宝物，不惜深入各门派打探，学的武功杂七杂八，最\n"
    "高记录学了55种skill，多而杂。最后不知怎么突然好象觉悟了，痛改前非，从\n"
    "新做人了。人事间本不就如此么？突然间就发生了什么。。。。。。\n"

    "　  听说最近归隐山林，游戏人间去了。有人看见他在华山\n"
    "绝顶练剑，手中那柄紫隐剑光彩夺目。可是第二天听说他溜进皇宫偷宝物。。。\n"
    "侠踪飘忽，美丽人生，多么另人羡慕。\n"

  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_steal", 1);
  set("no_beg", 1);
  set("no_sleep_room", 1);
  set("objects", ([
    "/d/player/mingren/npc/zli": 1,
  ]));
  setup();
}
