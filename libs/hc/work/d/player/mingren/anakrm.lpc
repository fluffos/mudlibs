//ROOM anakrm.c
inherit ROOM;

void create()
{
set("short", HIB"天仙池"NOR);
        set("long",
"美如天仙的加妙(jieshao)，当年惹不少人争先恐后的引起江湖\n"
"中人娶为妻子，不过其最后却嫁给阿修罗为妻，没想到他的夫君\n"
"这么想不开自杀了，在伤心下，不靠男人，苦练神功，现在已成\n"
"为武林中数一数二的绝顶女大侠。现隐居于此。\n"
); 
        set("exits",  ([
"out" : "/d/player/mingren/mingren3",
]));        set("no_clean_up", 0);
       set("item_desc", ([
"jieshao" : "　　说起加妙这人，从小的时候来说吧，那时候的她，天真无邪，与世无争。\n"
"在机缘巧合之下，结识了前凌宵山庄的庄主雷神(dami)，由那一刻起，她的一\n"
"生就不再平淡。在(dami)的帮助下，她渐渐学会了如何练功。从此迈出了人生\n"
"旅途的第一步。\n"
"　　时光飞逝如电，不知不觉中加妙已经亭亭玉立，貌美如花的她，为了在这\n"
"个残酷而现实的江湖中出人头地，无暇好好地打扮自己，也不管别人所做所为\n"
"和江湖世事，埋头一心苦练武艺。就在这时，她认识了一个改变了她一生的江\n"
"湖奇男子(get)。当时的加妙，苦修一段时间之后，武功已经到了一个瓶颈阶段\n"
"，一直都无法顺利突破，正在江湖中茫然奔走之际，上天安排了(get)来到她的\n"
"眼前。至今，她还清楚的记得第一次见到(get)的情形。从此，她的世界变得灿\n"
"烂起来，两人结伴而行的江湖生活不再枯燥。他教她如何打像，如何用像，如\n"
"何出师等。转眼间，她的武功有了质的飞跃。再不是独孤一味天山灵蹴宫的小\n"
"舞姬。在(get)的陪伴下，她历游逍遥，武当，峨嵋......等门派，领悟各大门\n"
"派的精深武功。\n"
"　　人生得一知已，夫复何求。眼看青春易老，风华渐逝。她于是作出了一个\n"
"人生重大的决定，发出武林贴，比武招亲。那时的加妙，再不是原来默默无闻\n"
"的黄毛小丫头了，在江湖中，加妙这个名字代表着的是一位风华绝代的女侠。\n"
"所以这场比武招亲，吸引了当时的几位武林高手(get),(zli),(waidai),(topd\n"
"-og)前来比武。最后(get)技压群雄，抱得美人归，本就是郎才女貌，心心相映\n"
"，当真皆大欢喜。婚礼当天，加妙和(get)的所有好朋友都前来道贺。大宴群雄\n"
"，场面热闹非凡。不少朋友还趁着酒意来闹新房。从此两人过着美满幸福的生\n"
"活。可是人生不如意事十常八九。美满幸福的日子才不久，一天突然驿站一位\n"
"伙计来叫她去签收一封信件。当时的她心里就有一种不妥的直觉。果不其然，\n"
"这封信是月老发出来的，信上说：你的丈夫已经自杀了。......当时她伤心欲\n"
"绝，一夜之间，青丝顿成白发！\n"

"　　丈夫走了。可是朋友们依然关心着她。特别是(uio)和她说，我们再不需要\n"
"男人帮忙，我们女性要自立，不要靠男人也能过活。就这样，她渐渐走出了生\n"
"活的阴影，与(uio)开始了她们人生里最艰苦的修练。最后她终于得到了成果，\n"
"成为武林中数一数二的女强者。\n"
]));
set("no_fight", 1);
set("no_magic", 1);
set("no_steal", 1);
set("no_beg", 1);
set("no_sleep_room", 1);
set("objects", ([
"/d/player/mingren/npc/anak" : 1,
]));
        setup();
}  

