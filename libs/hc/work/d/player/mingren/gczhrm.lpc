#include <room.h>

inherit ROOM;
void create()
{
        set("short", "隐剑居");
        set("long", @LONG
这里是小山的避世之所。洞的正中摆设着一张八仙桌。上面除了
有起居梳洗之物外。还有着一把普通的长剑.这正是当年小山行走江
湖时自创的怪剑。洞的左右两面皆有一些奇奇怪怪的图案。据说这是
一位前辈高人所留。能参悟则能得到旷古耀今的上古神兵。古洞正中
有一些密集的小字(jieshao)与一条傲翔天空的蛟龙。另有一副对联
“依天屠龙金蛇剑，天神伏魔闯王刀。”足见此处主人乃是爱剑之人。
LONG );

        set("no_fight", "1");
        set("no_steal", "1");
        set("no_beg", "1");
        set("no_sleep_room", "1");
        set("no_clean_up", 0);
       set ("no_magic", 1);

        set("exits", ([
                "out" : __DIR__"mingren2",
        ]));
       set("item_desc", ([
                   "jieshao" :  "    此人一生起伏不平。辈份算是第二代的玩家。曾经进过少林、\n"
"武当、星宿、白驮、古墓等派。学的东西都是挑他人的成果，拣现\n"
"成的便宜。fool！最终深觉少林武当的功夫博大精深，非其它一些\n"
"旁门所能及。所以自制一把削豆腐如铁的剑自名为火龙鞭，实在是\n"
"贻笑大方。 \n"
"    在初到红尘时立誓不落人后。无奈在与一位少林高僧比武时连输\n"
"数场郁郁寡欢，一度与世隔绝，决心终此一生。但是最终在那位少林\n"
"花和尚的帮助下走出胜负成败的玩弄畅游红尘。\n"  
"    对武功的追求不敢抱幻想以后，又开始梦想成为红尘之中最大的\n"
"富翁。注册了自己的czh一族。但是过多的id，work会影响到所有人\n"
"的网速，所以经常看见出现：“成都干猪肉被嗜人鱼吃掉了、肥猫被大\n"
"狼狗咬死了的rumor。”最终也只得不了了之。 \n"
"    此人傻头傻脑，痴痴憨憨像足郭靖。但是天意弄人，100余载的江\n"
"湖行走最终也未遇上与之投缘的黄蓉。真想眼看朋辈成新郎，怒成公公\n"
"练pixie。不过在几位朋友的开导下终于放弃了这个念头。 \n"
"    人死留名老虎死留皮。为了不在这红尘之中白走一遭，决定接受几\n"
"位好友的邀请进驻凌霄山庄。无奈天生愚钝，兼之性格懒惰常常辜负山\n"
"庄上下的期望实非出自真心 sigh 。\n"
"    不喜杀戮、不喜留血。对于新手的帮助经常是看心情而定。有时帮\n"
"得过头，有时明知不语。哎！天生吊儿郎当走马观花，加上本身对于密\n"
"题通常一知半解深恐误人误己，非心之所愿也。\n"
]));
       set("objects", ([
              __DIR__"npc/gczh" : 1,
              ])); 
        setup();
        replace_program(ROOM); 
}
