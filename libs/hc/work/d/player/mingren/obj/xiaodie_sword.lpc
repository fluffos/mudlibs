//xiaodie_sword.c
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIW"人间重"HIM"晚情"NOR, ({ "xiaodie_sword",}));
        set_weight(6000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                         set("value", 187);
set("material", "steel");
                     }
        init_sword(240);
        setup();
}

