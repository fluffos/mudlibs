// yiyun_club.c

#include <weapon.h>
#include <ansi.h>
inherit CLUB;

void create()
{
        set_name(HIC"我意怜"HIM"幽蝶"NOR, ({ "yiyun_club",}));
        set_weight(6000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                        set("long", "看起来晶莹碧绿，透着丝丝的寒意。一种庄严，温和，凛然而不
可侵犯的气息让人不敢有一丝亵渎之意。它已经返朴归真，成为真
正的上古神兵. 上面用小篆刻着一行小字：逸云造于癸丑年十二月
三十一日戌时三刻  \n");
                set("value", 1835);
                set("material", "steel");
                        set("wield_msg", "$N往腰中一摸，拿出了一把"HIC"我意怜"HIM"幽蝶"NOR"，端在手中。\n" NOR);
                set("unwield_msg", "$N手中"HIC"我意怜"HIM"幽蝶"NOR"抖出一棍花，眨眼间已然不见影踪。\n" NOR);
                     }
          init_club(600);
        setup();
}

