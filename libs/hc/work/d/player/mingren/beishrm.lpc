#include <room.h>

inherit ROOM;
void create() {
  set("short", "侠骨留香");
  set("long", @LONG
不算高的身材，略显单薄，有些蓬乱的头发随意的撒在额头，如果说他曾经笑过，那也不过是
嘴角上翘洒脱中多了几分雍懒。这样的外表与“侠”的形象实在是有些差距，或许这也是侠者的
真实一面
他已经不再是“侠”的范畴。明亮的眼眸中隐着一丝留恋，一分眷顾，然而却义无返顾的望着前
方的执着……，一如平日。
 这里是北双的居所，墙角丢着本破破烂烂的日记本(jieshao).
LONG);

  set("no_fight", "1");
  set("no_steal", "1");
  set("no_beg", "1");
  set("no_sleep_room", "1");
  set("no_clean_up", 0);
  set("no_magic", 1);

  set("exits", ([
    "out": __DIR__ "mingren4",
  ]));
  set("item_desc", ([
    "jieshao": "滚滚红尘东逝水，其中多少动人事。风起云涌，浪花拍打，一入江湖岁月催。一代人消隐了， \n"
    "又有不甘寂寞的一代人崛起着，在这些江湖人心中总有梦想和憧憬：成为侠者。有赞叹的，有\n"
    "景仰的,有仇视的和诽谤的，然而，无论是朋友还是对手，都会承认：唯北双不倒！朋友的眼\n"
    "中，他平和亲近，永远是爱心的来源。“有困难找北双”，不知不觉中他就在我们中间，不需要\n"
    "刻意的回忆，\n"
    "红尘中遍布他的朋友，言语和文字已经不足已记录他的事迹，点点滴滴的聚集，他的侠义已经写\n"
    "在每个人的心中，这“侠”字就是这样写成的。\n"
    "穿过岁月的阻隔，尝尽世间的爱与仇。如今，他推开了另外的一道门，金色的阳光倾泻而来，\n"
    "耀眼的光芒将他笼聚在其中，一个新的挑战，一个新的世界在等待着他。除了祝福，我们还能竆n"
    "给予什么,说不清他是否回过了头，也不知道他是否还会归来，但“坚定的执着”如他这般，\n"
    "一定会有上天的眷顾。一杯清酒陪伴，多少朝夕相处的情谊在凝聚。飞跃万水千山他乡，\n"
    "浓浓的思念在漂流。忘不了的“红尘”人与事，侠骨留香，已然拥有……。\n"
    "道路是没有尽头的，无所谓减少，无所谓增加，但每个人都得用自己的尺码去丈量。是的，\n"
    "生活总是这样的，在我们身上什么都会发生。比如一条缓慢向前的河，每粒砂子都服从神秘而复杂\n"
    "的冲力又独立成一个世界。这个世界又会与其他的独立的世界交织着，构成“红尘”经久的画卷...\n"
  ]));
  set("objects", ([
    __DIR__ "npc/beish": 1,
  ]));
  setup();
}
