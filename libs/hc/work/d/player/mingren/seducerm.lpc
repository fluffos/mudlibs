//ROOM seducerm.c
inherit ROOM;

void create() {
  set("short", HIR "凤凰山" NOR);
  set("long", @LONG
鳳飞九千仞 横绝历四海----成名于这句话的他(jieshao)，如鳳凰般
的神话。在武林中独自一派。与徒弟(Yuky)在一起修练。各自苦练其毕生
绝学。经已达到忘我的境界。在这成名之路上，他却杀过不少人。包括武林
中的不少数一数二的高手。现在的他，与世无争，决定于这山终老此生。
LONG
  );
  set("exits", ([
    "out": "/d/player/mingren/mingren3",
  ])); set("no_clean_up", 0);
  set("item_desc", ([
    "jieshao": "　　赤鳳是驚動紅塵的一個厲害id，一生殺人無數。但功勞最高的還是原來的主人\n"
    "　　說起赤鳳，可要从他的几位主人说起了，这几位主人是\n"
    "(seducer)，(casper)，(baituo)三位，在不同的人手上，经\n"
    "历了不同的人生。(seducer)是他的原主人，对于他来说，是\n"
    "启蒙老师。他这位启蒙老师可是一位机器人大师，用了上半\n"
    "生的时间来作quest，自从红尘推出来一种宝物系统后，从此\n"
    "就改变了他的人生的练功方式。因为(seducer)是一位非常厉\n"
    "害的机器人大师，所以他以短短的一个月内，将他的经验提了\n"
    "三倍。在一夜之间，列入了十大高手的排名内。练功速度可畏\n"
    "惊人。当时的他，只在(yiyun)之下。后来他在的帮会(啸天会)\n"
    "与当时的凌宵山庄发生了一场世纪大战。双方的元老都大有损\n"
    "伤。在这场世纪大战过后，(seducer)觉得人生非常没趣，决把\n"
    "他送给朋友管理。这其中就是(casper)和(baituo)。(casper)\n"
    "只管理他的练功速度，在机缘巧合之下，曾用了一种名为金庸\n"
    "手稿(shou gao)的物品加了几百万exp，之后闯罗汉大阵，一天\n"
    "之内加了14M exp。(baituo)是一位pk高手，当然是利用他这种\n"
    "优势，与当时他的头号敌人(gmp)发生了一场惊天动地的大战，\n"
    "双方互相撕杀，但杀到最后，(baituo)以他的特有长，胜过了\n"
    "(gmp)，(gmp)只好向(baituo)低头认输了。随后的他，都是天\n"
    "天练功。与世无争，有空就上擂台与朋友后切磋武艺。\n"
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_steal", 1);
  set("no_beg", 1);
  set("no_sleep_room", 1);
  set("objects", ([
    "/d/player/mingren/npc/seduce": 1,
  ]));
  setup();
}
