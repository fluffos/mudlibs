#include <room.h>

inherit ROOM;
void create()
{
        set("short", "隐剑居");
        set("long", @LONG
楚笑天漂泊一生，终于在这里找到自己的安乐窝。其实是一个小
小的山洞。洞的摆设十分简单，除了梳洗之物，洞中还有一张桌子和
一张床！墙上放着自己的剑！墙上已经破烂不堪！这是此人平时练剑
所留下的伤痕！只有一处没有任何损坏，走近一看，上面有一些小字
（jieshao)和此人喜欢的诗句“天外有天，人外有人。”
LONG );

        set("no_fight", "1");
        set("no_steal", "1");
        set("no_beg", "1");
        set("no_sleep_room", "1");
        set("no_clean_up", 0);
       set ("no_magic", 1);

        set("exits", ([
"out" : __DIR__"mingren2",
        ]));
       set("item_desc", ([
                   "jieshao" :  "    此人也不知道是从哪儿冒出来的玩家，不关哪个门派都拜， \n"
"只要是觉得好的skills都学，结果到后来没一样功夫精通。真是 \n"
"可怜！sigh。幸好后来得到高人的点化。抛开一切，重新练功，\n"
"经过千心万苦，武工终于略有小成。本想造一把举事无双的好剑，\n"
"但由于身体太差，臂力太小，只能拿普通武器，可悲！sigh!所\n"
"以现在此人手中拿的还是普普通通的红尘帆！\n"
"    此人小时候就喜欢关闲事！所以仇家很多！一生只中有大半\n"
"日子是在逃亡中度过。试问又有哪个愿意和一个不能安心过日子\n"
"的人度过一生呢！所以到现在此人好是单身一人！可凄！sigh!\n"
"此人早期一生坎坷，但后期遇到很多恩人（dami.beish.topdog\n"
"......）。在dami的帮助下，此人加入了凌霄山庄。在beish的\n"
"带领下，对武功的领悟更快。在topdog的锻炼下，对江湖事看的\n"
"更清楚。可喜！ya!可以说，此人如果没这几位高人的帮助，现在\n"
"还是平平庸庸的度过，说不定哪天被仇家杀的死无全尸！所以此\n"
"人对自己的恩人十分尊重，十分关心。但对自己的仇人决不放过。\n"
"这就是此人做人的原则！（人对我好，我对人好，人不犯我，我\n"
"不犯人，人若犯我，我必犯人）。\n"

"            金麟岂是池中物，一遇风云便化龙   \n"
]));
   set("objects", ([
                __DIR__"npc/zzss": 1,
       ]));
        setup();
        replace_program(ROOM); 
}


