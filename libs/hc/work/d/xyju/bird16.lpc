#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" HIG "走廊" NOR);

  set("long", @LONG
你走在闲逸居的回廊上，鸟语花香不决于耳，脚下的
鹅卵石铺筑而成的地面，使你的脚得到一定的放松，在
东面是闲逸居的书房，据说里面摆放了不少好书。北面
的回廊又会通向何处？

LONG
  );

  set("exits", ([  //"north":__DIR__"bird17",
  "east": __DIR__ "bookroom",
    "south": __DIR__ "bird15",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  set("light", 1);
  setup();
}
