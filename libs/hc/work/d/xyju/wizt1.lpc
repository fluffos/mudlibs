#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" HIY "巫师殿堂" NOR "外堂");

  set("long", @LONG
这里似乎和对面房间的格局很象，也是一个大套间，
但房间中的摆设却大不相同，在进来的门口旁，放的是
一张写字台，在四周的墙壁上，精美的镶龙金丝壁画显
得十分华丽，几把漂浮的躺椅在墙边排放，一个动人的
“美眉”在招呼着前来参观的人。

LONG
  );

  set("exits", ([ "north": __DIR__ "yuan1",
    "south": __DIR__ "wizt",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  set("light", 1);
  setup();
