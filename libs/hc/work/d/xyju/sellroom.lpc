#include <room.h>
inherit ROOM;
void create()
{
 set("short",HIC"闲逸居"NOR"小卖部");

 set("long",@LONG
这里是一个买卖的地方，这里卖出的东西可不是一般
的地方可以买的到的，其中不乏一些高人精心锤炼之精
品，这里也供应一些常用物品，小二似乎已经有不小年
岁了，在他的身旁有块醒目的木牌(sign)
 
LONG
    );
 
 set("exits",(["west":__DIR__"bird15",
               "north":__DIR__"bookroom",
     ]));
 set("objects",([__DIR__"npc/laoer" : 1,
     ]));
        set("item_desc", ([
                "sign" : HIW "游历四海，行商天涯，货真价实，绝无欺瞒。\n",
        ]));
