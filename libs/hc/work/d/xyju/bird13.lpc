#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short",HIC"闲逸居"NOR"正门");

 set("long",@LONG
这里是闲逸居的正门, 精美的红木门, 门上刻著三
个写金色的大字"闲逸居", 左右有一龙一凤的石像, 在
门口有四个守卫, 看起来都是武功不俗, 这里究竟是何
处?不禁是你心中产生种种疑惑...
 
LONG
    );
 
 set("exits",(["east":__DIR__"bird14",
               "west":__DIR__"bird12",
     ]));
 set("objects",([__DIR__"npc/guard" : 4,
     ]));
 set("outdoors","xyju");
        set("valid_startroom","1");
 set("no_clean_up", 0);
 setup();
        "/clone/board/xyju_b"->foo();
}           
