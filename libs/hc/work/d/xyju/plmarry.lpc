// /d/xyju/plmarry.c
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" HIG "鸳鸯殿堂" NOR);

  set("long", @LONG
这里是“红尘”中的姻缘殿堂，陈列着那些羡
刹人的江湖鸳鸯们的雕象，他们为“红尘”增添了
不少的光彩，也是他们，使得我们的结婚系统不至
于荒废掉(风少语，呵呵)。婚姻本身就是一件非常
值得纪念和高兴的事情，所以这里为他们建设了这
做殿堂。

LONG
  );

  set("exits", ([ "east": __DIR__ "playert",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  set("light", 1);
  setup();
}
