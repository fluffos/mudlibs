#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" HIG "卧房走廊四" NOR);

  set("long", @LONG
这是通往闲逸居中的隐士们卧房的走廊，地面
是极品的花岗岩，稍微有那么点滑溜，不小心很容
易就跌倒了，这里有的地方还仍然在施工，因为还
不断的有人选择这里做他们的归隐之处...

LONG
  );

  set("exits", ([ "east": __DIR__ "xxs4",
    "south": __DIR__ "lang3",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  set("light", 1);
  setup();
}
