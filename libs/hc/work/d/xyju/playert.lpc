// /d/xyju/playert.c
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" HIG "玩家殿堂" NOR);

  set("long", @LONG
这里是玩家殿堂的正堂，在这里陈列的是“红尘”
里第一代元老级玩家的雕象，他们中，有第一次做
“红尘”任务的人，有第一次在“红尘”中pk的人，
他们创造了“红尘”中无数的第一次，他们的努力为
“红尘”的今天奠定了基石，为了感谢他们，在众人
的努力下，终于塑成了这几座雕象，让他们在这幽静
的云霄之中，鸟瞰江湖中的血雨腥风，让他们在一个
清幽的地方好好休息休息...

LONG
  );

  set("exits", ([ "south": __DIR__ "playert1",
    "east": __DIR__ "shijidt",
    "west": __DIR__ "plmarry",
  ]));
  set("objects", ([ __DIR__ "npc/bard": 1,
    __DIR__ "npc/link": 1,
    __DIR__ "npc/wuwei": 1,
    __DIR__ "npc/year": 1,
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  set("light", 1);
  setup();
}
