#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" NOR "大院");

  set("long", @LONG
你漫步走到闲逸居的大院, 你看了看四周, 只见左右
各有一个花池，里面种植着不少罕见的稀世珍品，彩蝶
飞舞，一派田园风光。在两个花池的边上，各有一扇门
，隐约可以看到门后的人影在晃动，使你好奇的想过去
看看。

LONG
  );

  set("exits", ([ "east": __DIR__ "dating",
    "west": __DIR__ "bird14",
    "south": __DIR__ "wizt1",
    "north": __DIR__ "playert1",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  setup();
  set("light", 1);
  replace_program(ROOM);
}
