#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" HIG "事迹殿堂" NOR);

  set("long", @LONG
在这里，放置着一些玩家的江湖经历，他们在
“红尘”中的一些体会，每个人的经历都是不同的，
他们究竟会有如何的经历呢？这里将会为您展现他们
亲笔撰写的文章，他们的文章将会被永远的保存在这
间房子中，供人们阅览。

LONG
  );

  set("exits", ([ "west": __DIR__ "playert",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  set("light", 1);
  setup();
  replace_program(ROOM);
}
