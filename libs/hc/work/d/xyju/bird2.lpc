#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short",HIR"绝世峭壁"NOR);

 set("long",@LONG
你好不容易在峭壁上找到一处稍微凸出的岩石, 于
是你决定在此稍作休息, 你环顾了一下四周, 除了岩石
还是岩石, 你不禁思考这峭壁之上到底有什么东西, 你
又往下望了望, 发现你已经与地面有好一段距离了, 你
心中想著还要继续往上爬吗?

LONG
    );
 
 set("exits",(["up":__DIR__"bird3",
               "down":__DIR__"bird1",
     ]));
 set("outdoors","xyju");
 set("no_clean_up", 0);
 set("limit_dodge",15);
 setup();
 replace_program(ROOM);
}           
