#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" HIG "走廊" NOR);

  set("long", @LONG
你走在闲逸居的回廊上，四处都是鸟语花香，脚下是
鹅卵石铺筑而成的地面，走在上面使人非常的舒适，在
东面是闲逸居里唯一的一个买卖东西的地方。北去则是
回廊的另一段，不知会有些什么呢？

LONG
  );

  set("exits", ([ "east": __DIR__ "sellroom",
    "south": __DIR__ "bird14",
    "north": __DIR__ "bird16",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  setup();
  set("light", 1);
}
