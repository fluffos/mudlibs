// /d/xyju/npc/laoer.c
inherit NPC;
inherit F_VENDOR;
void create() {
  set_name("老二", ({ "lao er", "lao", "er" }));
  set("gender", "男性");
  set("title", HIW "天涯商客" NOR);
  set("age", 48);
  set("long",
    "这是个老二，在年轻的时候，人家叫他小二，现在人老了。\n");
  set("shen_type", 1);
  set("combat_exp", 8007000);
  set("str", 217);
  set("dex", 80);
  set("con", 37);
  set("per", 21);
  set("int", 32);
  set("attitude", "peaceful");
  set_skill("dodge", 1120);
  set_skill("unarmed", 920);
  set("vendor_goods", ({
    __DIR__ "obj/baozi",
    __DIR__ "obj/rsg",
    __DIR__ "obj/water",
  }));
  setup();
  carry_object(__DIR__ "obj/cloth.lpc")->wear();
  add_money("gold", 10);
}
void init() {
  ::init();
  add_action("do_buy", "buy");
  add_action("do_list", "list");
}
