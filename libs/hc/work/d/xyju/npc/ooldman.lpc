#include <ansi.h>
inherit NPC;
void create()
{
 set_name("独臂老人",({"only-one-hand oldman","oldman"}));
 set("long","他是一位曾经闯荡江湖的男子，自从他的左手被人从肩砍断后，
便一直隐居在这里，成为一个铁匠，他的梦想就是打造一把神兵
利器，但是他好像缺了什么....\n");
 set("age",72);
 set("gender","男性");
 set("level",20);
 set("title","单手铁匠");
 set_skill("parry",50);
 set_skill("dodge",50);
 set("chat_chance",20);
 set("chat_msg", ({"独臂老人拿起手中的铁箝叹了一口气.\n",
                   (:command("sigh"):),
 }));
set("chat_chance_combat",200);
 set("talk_reply","你能帮老夫一点忙(help)吗?\n");
 set("inquiry/help","我现在缺的是一种石头，叫精铁石，只有这种石头才能让我这把
阴阳剑能够阴阳调合，拜拖你了。\n");
 set("chat_msg_combat",({                         
                         (:command,"say 你太小看我了!!":),
 }));
 setup();
}
int accept_object(object who,object ob)
{
        object obj;
        obj=this_object();
if(ob->query("id") != "top_grade iron stone")
        {
           command("slap "+who->query("id"));
           command("say 你给我这个是啥啊....-.-");
           return 0;
}
        else {
           if(obj->is_busy() )
           {
             command("whisper "+who->query("id")+" 我正在忙，请你等一下。\n");
             return 0;
           }
             message_vision("$N给了独臂老人一个 "+ob->query("name")+"。\n",who);
             command("think");
             obj->start_busy(10);
             obj->set_temp("givehat",1);
             destruct(ob);
             call_out("givehat",1,who);
return 1;
        }
}
void givehat()
{
      int i;
      object me,obj,plate;
      me=this_player();
      obj=this_object();
      i=obj->query_temp("givehat");
      if( !me || environment(me) != environment(obj) )
        {
                command("say 咦？" + RANK_D->query_respect(me) + "人呢？？");
                return;
        }
      switch( i ) {
          case 1:
            say(HIY"独臂老人摸了摸这块石头。\n"NOR);
            obj->set_temp("givehat",i+1);
            call_out("givehat",3,me);
            break;
          case 2:
            command("say 谢谢你阿，小兄弟。");
            obj->set_temp("givehat",i+1);
            call_out("givehat",2,me);
            break;
          case 3:
            say(HIY"独臂老人拿起了一把剑，开始打造那把剑。\n"NOR);
            command("sweat");
            obj->set_temp("givehat",i+1);
            call_out("givehat",3,me);
            break;
          case 4:
            say(HIY"过了一会独臂老人手上多了一把发著蓝光和红光的剑。\n"NOR);
            obj->set_temp("givehat",i+1);
            call_out("givehat",3,me);
            break;
          case 5:
            command("say 我的梦想已经完成了，这把剑在不在我身边已经不重要了，我就把它给你吧。");
            obj->set_temp("givehat",i+1);
            call_out("givehat",3,me);
            break;
          case 6:
            plate=new(__DIR__"obj/sword");
            plate->move(obj);
            command("give sword to "+ me->query("id") );
            obj->delete_temp("givehat");
            break;
          }
}

