inherit NPC;
//inherit F_VENDOR;
inherit F_DEALER;
void create()
{
        set_name("漂亮美眉", ({ "plmm", "mm"}));
        set("title", "绝色美女");
        set("nickname", HIM"天上玉女"NOR);
        set("shen_type", 1);
        set("str", 30);
        set("per", 24);
        set("gender", "女性");
        set("age", 25);
        set("long",
                "这些漂亮美眉是风少精心从山下挑选上来的，个个国色天香\n"
                "风少也不知道为什么要把她们请上山来，你呢？\n");
        set("combat_exp", 500);
        set("max_jing", 30000);
        set("jing", 30000);
        set("max_qi", 30000);
        set("qi", 30000);
        set("max_jingli", 30000);
        set("jingli", 30000);
        set("attitude", "friendly");
        set("inquiry", ([
                "漂亮妹妹" : "我们是风少请上来伺候大家的。\n",
                "睡觉" : "你好死象哦，这么问人家...\n",
                "伺候" : "你好死象哦，这么问人家...你呀，好色呢。\n",
        ]));
        

        setup();
                carry_object(__DIR__"obj/xiaoq.lpc")->wear();
}
