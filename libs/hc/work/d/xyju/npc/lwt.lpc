//【天界总管】 状元第二届红尘新秀 普通百姓「阮为伊 放未离」冷雾(Lwt)
// /u/kulou/npc/lwt.c
//created by pl2npc.c

inherit NPC;

void create() {
  set_name("冷雾", ({ "wiz lwt" }));
  set("long",
    "        也许放弃才能靠近你\n"
    "        不再见你你才会把我记起\n"
    "        时间累积这盛夏的果实\n"
    "        回忆起红尘的足迹\n"
    "        我以为不露痕迹\n"
    "        思念却满溢\n"
    "        也许这代表了我的心\n"
    "        其实不必说什么才能离开你\n"
    "        起码那些经过属于我\n"
    "        我要离开你不再想你\n"
    "        虽然这并不是我本意\n"

    ".\n"
    "        当结果是那么赤裸裸\n"
    "        不用难过不用掩饰什么\n"
    "        当看尽潮起潮落\n"
    "        只要我记得你\n"
    ".\n"
    "    红尘巫师中四大元老之一，铁掌帮开山祖师，与湖水一起架设了\n"
    "绿柳山庄等。为红尘的发展做出了巨大贡献。性格热情奔放，也因性\n"
    "情所累，几度浮沉，但瑕不掩瑜。后因故离开红尘。\n");
  set("gender", "男性");
  set("age", 20);
  set("birthday", 989708379);
  set("combat_exp", 7000);
  set("potential", 2000);
  set("degree", HIR "【天界总管】" HIW "状元" NOR);
  set("party", ([ /* sizeof() == 2 */
    "party_name": YEL "第二届" NOR,
    "rank": HIR "红尘新秀" NOR,
  ]));
  set("nickname", HIY "阮" HIB "为" HIC "伊 " HIW "放" HIG "未" HIM "离" NOR);
  set("qi", 10000);
  set("eff_qi", 10000);
  set("max_qi", 10000);

  set("food", 300);
  set("water", 300);

  set("jing", 100);
  set("eff_jing", 100);
  set("max_jing", 100);
  set("str", 20);
  set("int", 18);
  set("con", 19);
  set("dex", 23);
  set("kar", 30);
  set("per", 30);




  setup();
  if (query("gender") == "男性")
    carry_object("/clone/cloth/male" + (1 + random(8)) + "-cloth")->wear();
  else
    carry_object("/clone/cloth/female" + (1 + random(8)) + "-cloth")->wear();
}
