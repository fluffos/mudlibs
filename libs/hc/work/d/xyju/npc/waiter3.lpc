// /u/swordman/xyju/npc/waiter3.c
inherit NPC;
inherit F_VENDOR;
void create() {
  set_name("小贩", ({ "xiao fan", "seller", "fan" }));
  set("gender", "男性");
  set("age", 32);
  set("long",
    "这是个小贩，长的一副老实模样，可你别想从他那儿捞便宜。\n");
  set("shen_type", 1);
  set("combat_exp", 10000);
  set("str", 17);
  set("dex", 20);
  set("con", 17);
  set("int", 22);
  set("attitude", "peaceful");
  set_skill("dodge", 20);
  set_skill("unarmed", 20);
  set("vendor_goods", ({
    __DIR__ "obj/baozi",
    __DIR__ "obj/water",
  }));
  setup();
  carry_object("clone/misc/cloth")->wear();
  add_money("coin", 100);
}
void init() {
  ::init();
  add_action("do_buy", "buy");
  add_action("do_list", "list");
}
