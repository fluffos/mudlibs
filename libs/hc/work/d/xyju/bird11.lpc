#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "石头路");

  set("long", @LONG
这是一条用石头打造的路, 虽然说是石头做的, 但
是走起来却比平地还要平, 你看看四周, 发现路边有一
个巨石碑(sign), 上面还有一些你从来没有看过的鸟,
石头路往东方延伸出去。

LONG
  );
  set("item_desc", ([
    "sign": "你朝这石碑上看了看  " HIR "闲
                    逸" NOR "        
你心想终于到了!     " HIR "居\n" NOR
  ]));
  set("exits", ([ "east": __DIR__ "bird12",
    "southdown": __DIR__ "bird10",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
