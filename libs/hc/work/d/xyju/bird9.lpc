#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "石阶");

  set("long", @LONG
你往前又走了一段距离, 来到一个石阶底下, 你抬
起头来看了看北方, 有一条长长的石阶往北边延伸出去,
你抬头看了看天空, 发现这里的天上, 有许许多多的鸟
在天空中飞行, 并且是往北边飞去。 

LONG
  );

  set("exits", ([ "northup": __DIR__ "bird10",
    "west": __DIR__ "bird8",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  setup();
}
