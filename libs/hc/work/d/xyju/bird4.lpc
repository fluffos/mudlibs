#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIR "绝世峭壁" NOR);

  set("long", @LONG
你又往上爬了一段距离, 发现你的身旁出现白雾, 
你又看了看, 不对! 是白云! 原来你已经到达云层中了,
你往上看了看, 还是看不到顶在那里, 你不禁害怕起来,
但是你心想既然已经到这么高了, 难到还要下去? 于是
你决定硬著头皮继续往上爬.....

LONG
  );

  set("exits", ([ "up": __DIR__ "bird5",
    "down": __DIR__ "bird3",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
