#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "石阶");

  set("long", @LONG
这里是石阶的中央, 你抬头往天空望去, 天空的鸟
类愈来愈多了, 全部在你头顶徘徊, 你放眼望去, 全部
的城市和小乡村, 都尽在你的眼底, 你觉得你有高人一
等的感觉, 石阶往北方延伸出去。

LONG
  );

  set("exits", ([ "northup": __DIR__ "bird11",
    "southdown": __DIR__ "bird9",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
