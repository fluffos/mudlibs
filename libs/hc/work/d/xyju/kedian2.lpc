inherit ROOM;

void create() {
  set("short", HIC "闲逸居" HIG "南客房");
  set("long", @LONG
你走在闲逸居的南部客房区，这里是提供给一些
来这里参观的人们休息用的，这里其实还可以做点别的
至于是什么，呵呵。大家自己体味一下先啦，我这里卖个关子
LONG
  );

  set("exits", ([
    "north": __DIR__ "dating",
    "1": __DIR__ "kefang1",
    "2": __DIR__ "kefang2",
    "3": __DIR__ "kefang3",
    "4": __DIR__ "kefang4",
    "5": __DIR__ "kefang5",
  ]));

  set("objects", ([ __DIR__ "npc/plmm": 4,
  ]));
  set("outdoors", "xyju");
  setup();
}

void init() {
  this_player()->delete_temp("rent_paid");
}
