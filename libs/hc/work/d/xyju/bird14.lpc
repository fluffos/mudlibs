#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" NOR "前院");

  set("long", @LONG
你来到闲逸居的前院, 院中种满了清竹，阵阵的筝
声自内院传来，使你的内心中不由升起一股豪迈之气，
想纵声长啸一下方可让这股气由胸中宣泄出来，此处
之清幽，可谓：“此境只能天上有，人间能往何处寻？”
 
LONG
  );

  set("exits", ([ "east": __DIR__ "yuan1",
    "west": __DIR__ "bird13",
    "north": __DIR__ "bird15",

  ]));
  set("outdoors", "xyju");
  set("objects", ([ __DIR__ "npc/parrot": 2,
  ]));
  set("no_clean_up", 0);
  setup();
}
