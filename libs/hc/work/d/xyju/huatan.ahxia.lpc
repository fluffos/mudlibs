// /d/xyju/huatan.c
inherit ROOM;

int do_zhai();
void init() {
  add_action("do_zhai", "zhai");
}
void create() {
  set("short", HIG "花坛" NOR);
  //set_name(HIG"花坛", ({ "hua tan", "tan"}));
  //set("unit", "块");
  set("long", "" HIG "好大的一座花坛，" HIY "五" HIM "彩" HIW "缤" HIR "纷" NOR "" HIG "的花朵在你眼前争香抖艳，你不禁想" HIC "摘(zhai)" NOR "" HIG "一朵来看看。" NOR " \n"
  );
  //set("value", 34530);
  //set("no_get","这个是供人观赏的，你能搬的走么？");
  setup();
}

int do_zhai() {
  object me, tan, new_ob;
  me = this_player();
  tan = this_object();
  if ((int)me->query("per") < 20)
    return notify_fail("花丛里的蜜蜂过多，使得你无法下手。\n");
  message_vision(HIC "$N看中了其中一朵伸手摘去。\n" NOR, me);
  me->add("qi", -1);
  switch (random(5)) {
    case 0:
      new_ob = new("/d/xyju/obj/chahua", 1);
      break;
    case 1:
      new_ob = new("/d/xyju/obj/chahua1", 1);
      break;
    case 2:
      new_ob = new("/d/xyju/obj/chahua2", 1);
      break;
    case 3:
      new_ob = new("/d/xyju/obj/chahua3", 1);
      break;
    case 4:
      new_ob = new("/d/xyju/obj/chahua4", 1);
      break;
    default:
      message_vision(HIM "$N被花上的刺扎了一下，疼得收回了手。\n" NOR, me);
      return 1;
  }
  if (objectp(new_ob)) {
    new_ob->move(me);
    message_vision(HIC "$N从花坛中摘了一朵“" + HIR + new_ob->name() + HIC + "”。\n" NOR, me);
  } else
    return notify_fail("ERROR: BUG here.. report it please.\n");
  return 1;
}
