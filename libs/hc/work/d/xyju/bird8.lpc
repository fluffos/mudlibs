#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "小路");

  set("long", @LONG
你在这荒凉的土地中, 隐约的看到这里有人走过的
样子, 于是你便寻著这条路继续往前走, 你看了看四周,
在你的脚边有一个小铁牌(sign), 附近连个小草野花都
没有, 你想想这到底有谁住呢?

LONG
  );
  set("item_desc", ([ "sign": "
你朝这铁牌看了看, 看到了血红色的字\n

 " HIR "【天上人间】    闲人请勿进入" NOR "\n

这字体柔中带劲，字中隐隐透露着一种闲逸之情...\n",

  ]));
  set("exits", ([ "east": __DIR__ "bird9",
    "west": __DIR__ "bird7",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
