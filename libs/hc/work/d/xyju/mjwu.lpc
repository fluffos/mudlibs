// /d/xyju/mjwu.c
#include <room.h>
#include <ansi.h>
#include <mudlib.h>
inherit ROOM;
void create()
{
set("short",HIC"闲逸居"HIM"麻将馆"NOR"一室");
set("long", @LONG
这是一间让隐士们娱乐的地方，是个麻将馆,
闲来无事之时，倒不失为一种良好的娱乐方式,
想来打个几圈吧，那还愣着干啥？？先过来看
看游戏介绍（jieshao）
LONG
);
set("light",1);
set("no_fight", 1);
set("no_magic", 1);
      set("freeze",1);
set("no_spells", 1);
set("exits",([
        "south": "/d/xyju/houyuan",
        "east": "/d/xyju/mjwu2",
        "west": "/d/xyju/mjwu3",
        "north": "/d/xyju/game1",
]));
    set("outdoors","xyju");
set("objects",([
  __DIR__"npc/mjgirl":1,
]));
set("item_desc",([
"jieshao":"
 一般基本的操作：：  每种牌都有其代码　例：一万－＞1w 七索－＞7s
 加入牌局   ："HIY"addin"NOR"        开始牌局   ："HIY"start"NOR" 
 摸牌       ："HIY"mo"NOR"           重开牌局   ："HIY"restart"NOR" 
 看玩家1的牌："HIY".1"NOR"           看玩家2的牌："HIY".2"NOR" 
 看玩家3的牌："HIY".3 "NOR"          看玩家4的牌："HIY".4"NOR" 
 看自己的牌 ："HIY"."NOR"
 丢牌       ："HIY"dump xx"NOR"      吃         ："HIY"eat xx xx "NOR"        
 碰         ："HIY"pon"NOR"          杠         ："HIY"gon "NOR"              
 胡         ："HIY"hu"NOR"           听         ："HIY"tin xx  "NOR"          
 xx为代码 例："HIY"eat 2w 3w"NOR" 
",
]));
setup();
}
