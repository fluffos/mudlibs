  set("short", HIG "泽林边缘" NOR);

  set("long", @LONG
这里是通往泽林的小路，也是唯一的小路
周围瘴气环绕，使你的心中充满了不安和恐惧。

LONG
  );

  set("exits", ([ "north": "/u/swordman/workroom",
    "east": __DIR__ "migong/exit",
  ]));
  set("no_clean_up", 0);
