#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short",HIC"闲逸居"HIG"wiz档案库"NOR);

 set("long",@LONG
“红尘”所有红尘wiz组的成员们辛勤劳动的
结果，他们没有得到过什么回报，他们的事迹和一
些资料，都陈列在这里，也许你在这里看过了他们
所写的文章之后，会更了解和理解他们。希望这里
陈列的文章能让wiz和玩家们之间的距离缩短。

LONG
    );
 
 set("exits",(["west":__DIR__"wizt",
    ]));
 set("outdoors","xyju");
 set("no_clean_up", 0);
 set("light",1);
 setup();
 replace_program(ROOM);
}           
