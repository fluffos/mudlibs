// book-silk.c

inherit ITEM;

void create()
{
        set_name(HIB "无影剑谱"NOR, ({ "silk", "shu", "book" }));
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("unit", "卷");
		set("long",
                        "这是小册剑谱\n"
                        "由一束薄绢钉成，上书：来！去！若！无！形！\n");
                set("value", 0);
                set("no_drop", 1);
                set("no_give", 1);
                set("no_sell", 1);
                set("no_get", 1);
                set("no_steal", 1);
                set("no_put", 1);
		set("material", "silk");
		set("skill", ([
                        "name": "wuying-jian",        // name of the skill
                        "exp_required": 1000000,      // minimum combat experience required
			"jing_cost":	10,	// jing cost every time study this
			"difficulty":	20,	// the base int to learn this skill
                        "max_skill":    301      // the maximum level you can learn
		]) );
	}
}

void owner_is_killed() { destruct(this_object()); }
