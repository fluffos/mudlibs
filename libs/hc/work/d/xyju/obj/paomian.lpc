inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("速食面", ({ "noodle" }) );
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一碗热腾腾的速食面，看来满好吃的样子。\n");
                set("unit", "碗");
                set("value", 40);  
                set("food_remaining",3);
                set("heal_hp",10);  
        }
}

