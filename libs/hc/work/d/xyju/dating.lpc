// /d/xyju/daing.c
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" HIG "大厅" NOR);

  set("long",
    "" HIW "这里就是“闲逸居”的大厅了，当中的墙上写着:

     " HIC "“信”  " HIR "“义”  " HIR "“仁”" HIW "  “道”" NOR "\n"


    "" HIW "这四个大字真正体现了正道人士的狭义之情。而在旁边
的墙上则写着这么四个大字：

     " HIG "“阴”  " HIW "“险”  " HIY "“毒”  " HIR "“辣”" NOR "\n"


    "" HIW "这四个字也就是邪道人士的座右铭了，闲逸居是一些江
湖中人退隐的地方,这里没有正道邪道之分，他们之所以
写上这些字，是为了告诉那些涉身于江湖中的人们江湖
险恶，人心不估的道理。" NOR "\n"

  );

  set("exits", ([ "west": __DIR__ "yuan1",
    "north": __DIR__ "lang1",
    "south": __DIR__ "kedian2",
    "east": __DIR__ "houyuan",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  set("light", 1);
  setup();
}
