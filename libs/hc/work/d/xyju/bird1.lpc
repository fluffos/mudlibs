#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIR "绝世峭壁" NOR);

  set("long", @LONG
你来到一处峭壁底下, 你抬头往天上看, 峰顶直达
云宵之上, 你实在无法用眼测出这个峭壁到底有多高, 
假如你自认为自己轻功不错, 你就上去看看吧, 在这旁
边有一个巨岩(rock), 上面似乎刻著一些字....忽然你
听到峭壁顶上有人在长啸, 于是你决定上去看看....

LONG
  );
  set("item_desc", ([
    "rock": "你朝这巨岩看了看, 发现上面有四个血红的大字,\n
          " HIR "绝  世  峭  壁" NOR "\n
     你不禁想见识看看写这个字的主人.\n",
  ]));
  set("exits", ([ "south": __DIR__ "bird0",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "xyju");
  setup();
}
void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  object me;
  me = this_player();
  if (arg != "绝世峭壁") return 0;

  message_vision("只见$N手、足并用，慢慢地爬上了峭壁。\n", me);
  me->move(__DIR__ "bird2.lpc");
  tell_room(environment(me), me->query("name") + "气喘嘘嘘地爬了上来。n", me);
  return 1;
}
