// /d/xyju/playert1.c
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" HIG "玩家殿堂" NOR "外堂");

  set("long", @LONG
踏进这件屋子，发现原来是一个大的套间，这里是外
厅，在左边有个门，而右边靠墙放着几把檀木的靠椅，
供来客休息，在进来的门口处，兵器架上，有几把兵
器摆放着。一个小童在忙活着招呼客人。

LONG
  );

  set("exits", ([ "south": __DIR__ "yuan1",
    "north": __DIR__ "playert",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  set("light", 1);
  setup();
  replace_program(ROOM);
}
