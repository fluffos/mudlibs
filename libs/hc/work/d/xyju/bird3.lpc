#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
 set("short",HIR"绝世峭壁"NOR);

 set("long",@LONG
又过了不少时间, 你觉得这个峭壁高的惊人, 不是
平常人所能爬上来的, 你的好奇心又加深了一分, 到底
在这峭壁之上有什么东西, 但是你的恐惧心也加深了一
分, 那个长啸的人到底是谁呢?

LONG
    );
 
 set("exits",(["up":__DIR__"bird4",
               "down":__DIR__"bird2",
     ]));
 set("outdoors","xyju");
 set("no_clean_up", 0);
 setup();
 replace_program(ROOM);
}           
