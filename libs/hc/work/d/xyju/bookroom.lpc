#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "闲逸居" NOR "书库");

  set("long", @LONG
这里是闲逸居的一个书房，排排的书架快把这屋子
给塞满了，书架上各种诗经、武学书籍、闲娱之书排列
的整整齐齐，起中的一个书架中摆放着一些武林前辈所
撰写的自传和武学精要，琳琅满目的书籍使的你不知该
先看哪个才好。
 
LONG
  );

  set("exits", ([ "west": __DIR__ "bird16",
    "south": __DIR__ "sellroom",
    "north": __DIR__ "sleeproom",
  ]));
  set("outdoors", "xyju");
  set("no_clean_up", 0);
  set("light", 0);
  setup();
  replace_program(ROOM);
}
