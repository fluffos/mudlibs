// maofeng.c
inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("毛峰茶", ({ "maofeng cha","cha" }));
        set_weight(1000);
        if( clonep() )
          set_default_object(__FILE__);
        else {
        set("long",
            "这是一杯正宗峨眉毛峰。!\n");
        set("unit", "杯");
        set("value", 20);
        set("max_liquid", 10);
        }
        set("liquid", ([
            "name" : "毛峰茶",
            "remaining" : 8,
            "type" : "water"
        ]) );
        set("liquid_type", "water");
        setup();
}


