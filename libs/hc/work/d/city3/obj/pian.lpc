inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("水煮肉片", ({ "pian" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "正宗川菜,好辣好辣。\n");
    set("unit", "盒");
    set("value", 50);
    set("food_remaining", 6);
    set("food_supply", 100);
  }
}
