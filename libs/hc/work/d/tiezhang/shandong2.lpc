// room: shandong2.c 
// by lwt

inherit ROOM;

int do_use(string arg);
int do_move(string arg);

void create() {
  set("short", "石洞内部");
  set("long", @LONG
这里依旧是一个石洞，什么也看不清。空气中充满了腐臭，你满脑子
只想把昨天的饭都吐出来。看来还是快点离开的好，鬼知道这里会出什么
事情呢！
LONG);
  set("exits", ([
    "out": __DIR__ "shandong1",
  ]));

  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_use", "use");
  add_action("do_move", "move");
}

int do_use(string arg) {
  object me;
  me = this_player();

  if (!arg || arg == "") return 0;
  if (!present("fire", me)) return 0;
  if (arg == "fire") {
    write(
      "你点燃了火折，发现洞中的地上横七竖八的都是一具具骷髅（skeleton），其中还有一具居然正坐着,\n"
      "吓得你差点趴在地上叫娘。洞壁上好象还刻了好多字迹（zi），你不禁想看个清楚。\n"
    );
    this_player()->set_temp("marks/移动1", 1);
    return 1;
  }
}
int do_move(string arg) {
  object ob;
  object me = this_player();

  if (!arg || arg == "") return 0;


  if ((me->query_temp("marks/移动1")) && (me->query_kar() > 24)) {
    if (!query("lwt_dan")) {

      message_vision(
        "$N轻轻地把居中的骷髅挪动了一下，突然从骷髅的怀中滚落一个物件到$N手中。\n", this_player());
      ob = new("/d/tiezhang/obj/jujing-dan");
      if (!ob) return notify_fail("Err: ob not found! please report to wizards.\n");
      ob->move(me);
      me->command("rumor " + me->query("name") + "拿到聚精丹啦。\n");
      set("lwt_dan", 1);
      return 1;
    }
    message_vision(
      "$N轻轻地把居中的骷髅挪动了一下，只听到“哗啦”一声，骷髅散架了。\n", this_player());
    return 1;
  } else {
    message_vision(
      "$N想做什么？\n", this_player());
    return 1;
  }
}
