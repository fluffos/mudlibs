#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();
string ask_me();

void create()
{
    set_name("裘千仞", ({"qiu qianren", "qiu", "qianren"}));
    set("title", "铁掌帮第十四代帮主");
    set("nickname", HIC "铁掌水上飘" NOR );
    set("gender", "男性");
    set("age", 50);
    set("long", 
        "一个白须老头，身穿黄褐短衫，右手挥着一把大蒲扇。神色俨然，
威严殊不可侵犯。他就是铁掌帮帮主，江湖人称[铁掌水上飘]。 \n");
    set("attitude", "peaceful");
    set("class", "scholar");
        
    set("str", 100);
    set("int", 90);
    set("con", 85);
 set("dex", 250);
    set ("per", 20);
    set("chat_chance", 1);
    set("chat_msg", ({
        "裘千仞叹了口气道：“当年要不是我的铁掌神功没有练成，这个天下第一的名头和九阴真经
又怎么会落到王重阳这个牛鼻子的手里呀，唉……”\n",
        "裘千仞低头沉思，悠然不语。\n",
    }));
    

    set("qi", 22000);
    set("max_qi", 22000);
    set("jing", 5000);
    set("max_jing", 5000);
    set("neili", 6000);
    set("max_neili", 20000);
    set("jiali", 300);

    set("book_count", 1);
    set("combat_exp", 50000000);
    set("score", 0);
         
    set_skill("force", 850);             // 基本内功
 set_skill("tiezhang-shengong", 950);     // 铁掌神功
  
    set_skill("unarmed", 900);           // 基本拳脚
    set_skill("strike", 900);            // 基本拳脚
    set_skill("tiesha-shenzhang", 900);     // 铁砂神掌
    
    set_skill("dodge", 1200);             // 基本躲闪
        set_skill("tashui-wuhen", 1000);    // 踏水无痕
    set_skill("parry", 900);             // 基本招架
    set_skill("literate",450);           // 读书识字
        
    map_skill("force"  , "tiezhang-shengong");
    
    map_skill("unarmed", "tiesha-shenzhang");
    map_skill("strike" , "tiesha-shenzhang");
    map_skill("dodge"  , "tashui-wuhen");
    map_skill("parry"  , "tiesha-shenzhang");

    set("inquiry", ([
        "裘千丈" : "那是我的孪生哥哥，可是他的武功不如我，就爱吹牛。不知道他什么时候才会改了这个毛病。 ",
        "九阴真经" : "要是今生能弄到九阴真经一看，也死而无憾了。",
        "裘千尺"  : "那是我的妹妹。唉，多年不见，听说他嫁给绝情谷的谷主了。 ",
        "上官剑南" : "他是我铁掌帮上一任帮主。咳，一个不识时务的家伙！ ",
]));
    create_family("铁掌帮", 14, "帮主");
    setup();
        
    carry_object("/d/tiezhang/obj/cloth2")->wear();
       
}

void attempt_apprentice(object ob)
{
    if (ob->query_int() < 15) {
        command("say 虽然学铁掌帮的武功不需要太高的悟性。可是，你的悟性也太底了点吧！");
                return;
    }
if (ob->query_str() < 25) {
        command("say 铁掌帮的功夫最重臂力，好象你的臂力不够哦！");
                return;
    }

    if ((int)ob->query_skill("tiezhang-shengong",1) < 300 ) {
        command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
                return;
    }
    if ((int)ob->query("shen") >100000 || (int)ob->query ("shen") < -100000 ) {
        command("say 我铁掌帮虽然近几年好生兴旺，却也容不下您这种成名人物，您请回吧！");
                return;
       }
    command("say 好吧，看你那么有诚意，我就收下你吧。");
    command("recruit " + ob->query("id"));
}

