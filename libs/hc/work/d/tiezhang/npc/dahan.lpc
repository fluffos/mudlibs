inherit NPC;
#include <ansi.h>
void create() {
  set_name(HIC "铁掌帮弟子" NOR, ({ "dahan", "man" }));
  set("gender", "男性");
  set("age", 30);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("combat_exp", 70000);
  set("shen_type", 0);
  set("attitude", "peaceful");
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 30);
  set("score", 8000);

  set_skill("force", 200);             // 基本内功
  set_skill("tiezhang-shengong", 200);     // 铁掌神功

  set_skill("unarmed", 200);           // 基本拳脚
  set_skill("strike", 200);            // 基本拳脚
  set_skill("tiesha-shenzhang", 200);     // 铁砂神掌

  set_skill("dodge", 200);             // 基本躲闪
  set_skill("tashui-wuhen", 200);    // 踏水无痕
  set_skill("parry", 200);             // 基本招架
  set_skill("literate", 50);           // 读书识字

  map_skill("force", "tiezhang-shengong");

  map_skill("unarmed", "tiesha-shenzhang");
  map_skill("strike", "tiesha-shenzhang");
  map_skill("dodge", "tashui-wuhen");
  map_skill("parry", "tiesha-shenzhang");

  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);

  setup();
  carry_object("/d/tiezhang/obj/cloth")->wear();
}
