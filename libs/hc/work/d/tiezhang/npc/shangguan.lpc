#include <ansi.h>
inherit NPC;
inherit F_MASTER;


void create()
{
    set_name("上官飞", ({"shangguan fei","fei", "shangguan"}));
    set("title", "铁掌帮刑堂堂主");
    set("gender", "男性");
    set("age", 31);
    set("long", 
        "他是铁掌帮的刑堂堂主，约莫三十来岁，一张黑漆漆的锅底脸，
扎髯满腮，根根如铁。\n");
    set("attitude", "peaceful");
    set("class", "scholar");
        
    set("str", 21);
    set("int", 30);
    set("con", 26);
    set("dex", 30);
    set ("per", 23);
 set("qi", 3000);
    set("max_qi", 3000);
    set("jing", 3000);
    set("max_jing", 3000);
    set("neili", 3500);
    set("max_neili", 3500);
    set("jiali", 100);

    set("book_count", 1);
    set("combat_exp", 270000);
    set("score", 0);
         
    set_skill("force", 300);             // 基本内功
    set_skill("tiezhang-shengong", 300);     // 铁掌神功
  
    set_skill("unarmed", 300);           // 基本拳脚
    set_skill("strike", 300);            // 基本拳脚
    set_skill("tiesha-shenzhang", 300);     // 铁砂神掌
    
    set_skill("dodge", 300);             // 基本躲闪
    set_skill("tashui-wuhen", 300);    // 踏水无痕
    set_skill("parry", 300);             // 基本招架
set_skill("literate",150);           // 读书识字
        
    map_skill("force"  , "tiezhang-shengong");
    
    map_skill("unarmed", "tiesha-shenzhang");
    map_skill("strike" , "tiesha-shenzhang");
    map_skill("dodge"  , "tashui-wuhen");
    map_skill("parry"  , "tiesha-shenzhang");

     create_family("铁掌帮", 15, "帮众");
    setup();

    setup();
        
     carry_object("/d/tiezhang/obj/cloth")->wear();
       
}

void attempt_apprentice(object ob)
{
    if (ob->query_int() < 15) {
        command("say 虽然学铁掌帮的武功不需要太高的悟性。可是，你的悟性也太底了点吧！");
                return;
    }
if (ob->query_str() < 25) {
        command("say 铁掌帮的功夫最重臂力，好象你的臂力不够哦！");
                return;
    }

 if ((int)ob->query_skill("tiezhang-shengong",1) < 150 ) {
        command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
                return;
    }
    if ((int)ob->query("shen") >100000 || (int)ob->query ("shen") < -100000 ) {
        command("say 我铁掌帮虽然近几年好生兴旺，却也容不下您这种成名人物，您请回吧！");
                return;
        }
    command("say 好吧，看你那么有诚意，我就收下你吧。");
    command("recruit " + ob->query("id"));
}

