#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();
string ask_me();

void create() {
  set_name("裘千仞", ({ "qiu qianren", "qiu", "qianren" }));
  set("title", "铁掌帮第十四代帮主");
  set("nickname", HIC "铁掌水上飘" NOR);
  set("gender", "男性");
  set("age", 50);
  set("long",
    "一个白须老头，身穿黄褐短衫，右手挥着一把大蒲扇。看起来自，
高自大，装模做样。眼神中掩饰不住油腔滑调。他就是铁掌帮帮主，
江湖人称[铁掌水上飘]。\n");
  set("attitude", "peaceful");
  set("class", "scholar");

  set("str", 21);
  set("int", 30);
  set("con", 26);
  set("dex", 30);
  set("per", 19);

  set("chat_chance", 1);
  set("chat_msg", ({
    "裘千仞挤眉弄眼道：“老夫我素来与世无争，这个天下第一的名头和九阴真经也从没有放在眼里！”\n",
    "裘千仞嘻嘻哈哈，摇头晃脑起来。\n",
  }));

  set("qi", 3000);
  set("max_qi", 3000);
  set("jing", 3000);
  set("max_jing", 3000);
  set("neili", 3500);
  set("max_neili", 3500);
  set("jiali", 100);

  set("book_count", 1);
  set("combat_exp", 1500000);
  set("score", 0);

  set_skill("force", 200);             // 基本内功
  set_skill("tiezhang-shengong", 200);     // 铁掌神功
  set_skill("unarmed", 200);           // 基本拳脚
  set_skill("strike", 200);            // 基本拳脚
  set_skill("tiesha-shenzhang", 200);     // 铁砂神掌

  set_skill("dodge", 200);             // 基本躲闪
  set_skill("tashui-wuhen", 200);    // 踏水无痕
  set_skill("parry", 200);             // 基本招架
  set_skill("literate", 150);           // 读书识字

  map_skill("force", "tiezhang-shengong");

  map_skill("unarmed", "tiesha-shenzhang");
  map_skill("strike", "tiesha-shenzhang");
  map_skill("dodge", "tashui-wuhen");
  map_skill("parry", "tiesha-shenzhang");

  set("inquiry", ([
    "裘千丈": (: ask_me :),
    "九阴真经": "九阴真经算什么！我帮的掌法包罗万象，比它厉害多了。\n",
    "裘千尺": "那是我的妹妹。嘿嘿，多年不见，听说他嫁给绝情谷的谷主了。 \n",
    "上官剑南": "他是我铁掌帮上一任帮主。咳，一个不识时务的家伙！所以呀，行走江湖是要识时务。
            别人打你左脸，你就应该把右脸贴过去让别人打！ ",
    "裘千仞": "老夫就在这儿了，你没有看到吗！"
  ]));

  create_family("铁掌帮", 14, "帮主");
  setup();
  carry_object("/d/tiezhang/obj/cloth2")->wear();


}

string ask_me() {
  object ob;



  if ((random(10) < 7) || is_fighting())
    return "我…不知道。\n";
  say("裘千仞浑身上下突然一阵颤抖，随即低声说道：“看来...你都知道了？”\n"
    "裘千仞长叹一声，说到：“假的到底真不了，既然如此，老夫就给你一件信物！”。\n");

  ob = new("/d/tiezhang/obj/tiezhang");
  ob->move(this_player());
  message_vision("\n裘千仞诡秘的笑了一声，从身上取出一块铁手掌交给$N。\n\n", this_player());
  return "这个铁手掌就给你，千万不要泄露我的身份呀！";


}
