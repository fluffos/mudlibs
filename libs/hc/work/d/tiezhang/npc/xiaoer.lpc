// xiaoer.c 小二

inherit NPC;
inherit F_DEALER;

void create() {
  set_name("店小二", ({ "xiao er", "xiao", "waiter" }));
  set("gender", "男性");
  set("age", 20);
  set("long",
    "这位店小二正笑咪咪地忙著招呼客人。\n");
  set("combat_exp", 100);
  set("attitude", "friendly");
  set("inquiry", ([
    "猴爪山": "这里就是猴爪山地界，一座山升出五座山峰，你说象不象猴儿爪子。",
    "铁掌帮": "客官既然是来游山玩水的，心中又何必还记挂江湖呢！",
    "铁掌峰": "客官请用茶，这个嘛……这个小的不太清楚。",
    "here": "客官果然好眼力，一看就知道小店不同凡响。告诉你吧，我这里最有名的就是麻笋干炒肉丝！",
    "麻笋干炒肉丝": "客官果然好眼力，一看就知道小店不同凡响。告诉你吧，我这里最有名的就是麻笋干炒肉丝！", ]));

  set("vendor_goods", ({
    "/d/baituo/obj/sherou",
    "/d/shaolin/obj/hulu",
    "/clone/food/baozi",
    "/clone/food/jiudai",
  }));
  setup();
}

void init() {
  object ob;

  ob = this_player();

  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_buy", "buy");
  add_action("do_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(2)) {
    case 0:
      say("店小二笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来喝杯清水，歇歇腿吧。\n");
      break;
    case 1:
      say("店小二用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
        + "，请进请进。山野小店，就先将就着吧。\n");
      break;
  }

}
