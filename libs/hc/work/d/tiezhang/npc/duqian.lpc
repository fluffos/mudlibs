#include <ansi.h>
inherit NPC;
inherit F_MASTER;


void create() {
  set_name("杜谦", ({ "du qian", "du" }));
  set("title", "铁掌帮第十六代帮众");
  set("nickname", HIC "探云手" NOR);

  set("gender", "男性");
  set("age", 21);
  set("long",
    "他是人称探云手的铁掌帮的弟子。\n");
  set("attitude", "peaceful");
  set("class", "scholar");

  set("str", 21);
  set("int", 30);
  set("con", 26);
  set("dex", 30);
  set("per", 27);
  set("qi", 3000);
  set("max_qi", 1500);
  set("jing", 1500);
  set("max_jing", 1500);
  set("neili", 2000);
  set("max_neili", 2000);
  set("jiali", 0);

  set("book_count", 1);
  set("combat_exp", 33750);
  set("score", 0);

  set_skill("force", 150);             // 基本内功
  set_skill("tiezhang-shengong", 150);     // 铁掌神功

  set_skill("unarmed", 150);           // 基本拳脚
  set_skill("strike", 150);            // 基本拳脚
  set_skill("tiesha-shenzhang", 150);     // 铁砂神掌

  set_skill("dodge", 150);             // 基本躲闪
  set_skill("tashui-wuhen", 150);    // 踏水无痕
  set_skill("parry", 150);             // 基本招架
  set_skill("literate", 250);           // 读书识字

  map_skill("force", "tiezhang-shengong");

  map_skill("unarmed", "tiesha-shenzhang");
  map_skill("strike", "tiesha-shenzhang");
  map_skill("dodge", "tashui-wuhen");
  map_skill("parry", "tiesha-shenzhang");

  create_family("铁掌帮", 16, "帮众");

  setup();

  carry_object("/d/tiezhang/obj/cloth")->wear();

}

void attempt_apprentice(object ob) {
  if (ob->query_int() < 15) {
    command("say 虽然学铁掌帮的武功不需要太高的悟性。可是，你的悟性也太底了点吧！");
    return;
  }
  if (ob->query_str() < 25) {
    command("say 铁掌帮的功夫最重臂力，好象你的臂力不够哦！");
    return;
  }

  if ((int)ob->query("shen") > 100000 || (int)ob->query("shen") < -100000) {
    command("say 我铁掌帮虽然近几年好生兴旺，却也容不下您这种成名人物，您请回吧！");
    return;
  }
  command("say 好吧，看你那么有诚意，我就收下你吧。");
  command("recruit " + ob->query("id"));
}
