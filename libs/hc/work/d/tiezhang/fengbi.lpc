// Room: /u/hanbo/tiezhang
// HANBO 2000/01/09

int get_object(object ob);
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIY "峰壁" NOR);
  set("long", @LONG
峰壁位于山峰的第二节，离峰顶以近，山侧生着一排松树，松梢
积雪，树身尽皆向南弯曲，只见左上方二十余丈处黑呼呼的似有一个
洞穴（dong)。
LONG
  );

  set("exits", ([
    "southdown": __DIR__ "shilu5",
  ]));

  set("outdoors", "tiezhang");

  setup();
}

void init() {
  add_action("do_look", "look");
  add_action("do_tiao", ({ "tiao", "jump", }));
}

int do_look(string arg) {
  object me;
  me = this_player();

  if (!arg || arg != "dong") return 0;
  if (me->is_busy() || me->is_fighting())
    return notify_fail("你正忙着哪！\n");
  if (me->query_temp("hanbo_dong") >= 7)
    return notify_fail("你还没有看够？\n");
  if (me->query_temp("hanbo_dong") == 6) {
    me->set_temp("hanbo_dongxue", 1);
    write(HIY "\n你凝神瞧了一阵，看见峭壁上有一石洞，似忽可以跳进去。\n" NOR);
  } else {
    write(HIG "但见洞穴黑呼呼的什么也看不清。\n" NOR);
  }
  tell_room(environment(me), me->name() + "正盯着洞穴仔细地研究着。\n", ({ me }));
  if (!me->query_temp("hanbo_dong")) {
    me->set_temp("hanbo_dong", 1);
  } else me->add_temp("hanbo_dong", 1);
  return 1;
}


int get_object(object ob) {
  if (userp(ob))
    return 1;
  return 0;
}

int do_tiao(string arg, object *obj) {
  object me = this_player();
  object *inv = deep_inventory(me);
  if (!arg || arg != "up") return notify_fail("山上别乱跳，很危险的。\n");
  if (me->is_busy() || me->is_fighting())
    return notify_fail("你正忙着哪！\n");
  if (me->query_temp("hanbo_dongxue")) {
    if (me->query_skill("dodge", 1) < 120
      && me->query("neili") < 1500)
      return notify_fail(HIM "你紧一紧腰带，提了一口气，窜高数尺，离洞口还有十来丈远，已然力气用尽，\n" +
        "当即轻轻溜了下来。\n" NOR);
    obj = filter_array(inv, (: get_object :));
    if (sizeof(obj)) {
      write(HIR "你紧一紧腰带，提了一口气，窜高数尺，离洞口还有十来丈远，突然发现负重过高，\n" +
        "已然累的气喘吁吁，砰然一声从高处摔下。\n" NOR);
      me->unconcious();
      me->move(__DIR__ "fengbi");
      return 1;
    }
    write(HIG "你在石壁下运功调息，养足力气，辗转腾挪之际，一口气窜上了洞穴。\n" NOR);
    me->delete_temp("hanbo_dong");
    me->delete_temp("hanbo_dongxue");
    me->move(__DIR__ "shandong1");
    me->receive_damage("jing", 300);
    me->receive_damage("qi", 300);
    me->start_busy(2);
    tell_room(environment(me), me->name() + "从石壁下窜了上来。\n", ({ me }));
    return 1;
  }
}
