inherit ROOM;

void create() {
  set("short", "休息室");
  set("long", @LONG
这里是铁掌帮弟子休息的地方, 一进门你就看见一张石床。
LONG
  );

  set("exits", ([
    "west": __DIR__ "xiaoyuan",
  ]));

  set("sleep_room", 1);
