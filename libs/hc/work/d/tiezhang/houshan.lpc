// HANBO 2000/28/08

inherit ROOM;
void create() {
  set("short", "后山");
  set("long", @LONG
这里是猴爪山的后山，据说铁掌帮的历代先主，都埋古于此，只
见有一石碑（shibei)竖立于次，又几个彪行大汉，不停的在这里来
回巡逻，现的守卫非常森严！
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "zoulang",
    "north": __DIR__ "shilu4",
  ]));
  set("item_desc", ([
    "shibei": "" HIR "            铁   掌   帮   圣   地   不   得   入   内" NOR "\n",
  ]));
  set("objects", ([
    __DIR__ "npc/dahan": 2,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "tiezhang");
  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "north" &&
    objectp(present("dahan", environment(me))))
    return notify_fail("铁掌帮弟子大声吼道：铁掌帮圣地，不得入内。\n");

  return ::valid_leave(me, dir);
}
