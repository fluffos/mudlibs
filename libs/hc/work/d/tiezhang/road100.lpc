#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", "树林");
    set("long",@LONG
这里是一片树林，远远可以望见猴爪山。树林里不时传来动听的鸟鸣，
伴着远处满山的翠绿不觉中让你心情舒畅起来，你不由地加快了通往猴爪
山的脚步。
LONG );
    set("exits", ([
	"east" : __FILE__,
	"west" : __FILE__,
	"north" : __FILE__,
	"south" : __DIR__"inn",
      ]));
    set("no_clean_up", 0);
    setup();
}

void init()
{            
    object ob = this_player();
    mapping myfam;
    if( !ob || !userp(ob) ) return;

    myfam = (mapping)ob->query("family");
    if(myfam && myfam["family_name"] == "铁掌帮")
    {
	set("exits/west", __DIR__"shanlu");
	return ;
    }       
    set("exits/west", __FILE__);
    remove_call_out("init");
    call_out("init",5);
    return;
}
int valid_leave(object me,string dir)
{
    mapping myfam;
    myfam = (mapping)me->query("family");
    if ( dir == "west" )
	if ( myfam && myfam["family_name"] == "铁掌帮"){
	    return 1;
	}else{
	    ::valid_leave(me,"north");
	}
    return 1;
}
