// Room: /u/hanbo/tiezhang
// HANBO 2000/01/09

inherit ROOM;

int do_use(string arg);
int do_zou(string arg);

void create()
{
    set("short", "山洞");
    set("long", @LONG
这里果然是一个山洞，洞口砌似玉石，修建得极是整齐。再往里
走，黑呼呼的看不清，找不到出口。
LONG
    );
    set("exits", ([ 
	"north" : __FILE__,
	"south" : __FILE__,
	"west" : __FILE__,
	"east" : __FILE__,
      ]));
    set("no_clean_up", 0);
    set("outdoors", "tiezhang" );
    setup();
    //  replace_program(ROOM)
}


void init()
{
    add_action("do_use", "use");
    add_action("do_zou", "zou");
}

int do_use(string arg)
{
    object me;
    me = this_player();

    if( !arg || arg=="" ) return 0;
    if (!present("fire", me))  return 0;
    if( arg=="fire" ) {
	write(
	  "你点燃了火折，发现似乎有一条路可以(zou)进去。\n"
	);
	this_player()->set_temp("enter", 1);
	return 1;
    }
}

int do_zou(string arg)
{
    object me;
    me = this_player();

    if (me->query_temp("enter") ) {
	message("vision", me->name() + "消失在一阵黑暗之中。\n",
	  environment(me),({me}));
	me->move(__DIR__"shandong2");
	message("vision", me->name() + "走了出来。\n",
	  environment(me), ({me}) );
	this_player()->delete_temp("enter");

	return 1;
    }
    else {
	write("你想往哪儿走?!\n");
	return 1;
    }
}

