#include <ansi.h>
inherit ROOM;
void create()
{
    set("short", "猴爪山山路");
    set("long", @LONG
这里是猴爪山的山脚，此时近看，但见五座山峰峭兀突怒，确似
五跟手指竖立在半空之中，居中一峰尤见挺拔，峰顶是一片片松树！
LONG
    );
    set("exits", ([ /* sizeof() == 2 */
        "westup" : __DIR__"shilu",
        "east" : __FILE__,
]));
    set("no_clean_up", 0);
    set("outdoors", "tiezhang" );
    setup();
}
void init()
{            
    object ob = this_player();
    mapping myfam;
    if( !ob || !userp(ob) ) return;

    myfam = (mapping)ob->query("family");
    if(myfam && myfam["family_name"] == "铁掌帮")
    {
        set("exits/east", __DIR__"road100");
        return ;
    }       
    set("exits/east", __DIR__"road105");
    remove_call_out("init");
    call_out("init",5);
    return;
}
int valid_leave(object me,string dir)
{
    mapping myfam;
    myfam = (mapping)me->query("family");
    if ( dir == "east" )
        if ( myfam && myfam["family_name"] == "铁掌帮"){
            return 1;
       }else{
            ::valid_leave(me,"east");
        }
    return 1;
}

