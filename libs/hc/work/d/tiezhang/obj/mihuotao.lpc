#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
void create() {
  set_name(HIG "弥猴桃" NOR, ({ "mihoutao", "tao" }));
  set_weight(40);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个又香又甜的弥猴桃。\n");
    set("unit", "个");
    set("value", 80);
    set("food_remaining", 4);
    set("food_supply", 30);
  }
}
