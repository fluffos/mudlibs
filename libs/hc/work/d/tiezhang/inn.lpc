// room: inn2.c

inherit ROOM;

int do_nachu(string arg);
int do_east(string arg);
int do_north(string arg);

void create() {
  set("short", "山野小店");
  set("long", @LONG
这里是山野中的一个小店，为过往的游客提供食物和水的地方。从店中
摆设不多的桌椅看，来的客人也不多。店里只有一个小二在，真搞不懂这么
萧条的生意他为什么还要做。
LONG);
  set("exits", ([
    "south": __DIR__ "road10",
    "north": "/d/tiezhang/road100",
  ]));
  set("objects", ([
    "/d/tiezhang/npc/xiaoer": 1,
  ]));

  set("no_fight", "1");
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_nachu", "nachu");
  add_action("do_east", "goeast");
  add_action("do_north", "north");
}
/*  int valid_leave(object me,string dir)
{
if( dir == "east" || "north")
	   return notify_fail("小二当在面前，低声说“山道曲折，我劝客官还是不要乱走的好。”\n");

    return 1;
}  */

int do_nachu(string arg) {
  object me;
  me = this_player();

  if (!arg || arg == "") return 0;
  if (!present("tie shouzhang", me)) return 0;
  if (arg == "tie shouzhang") {
    write(
      "你随便拣了张椅子坐下，很牛逼的把铁手掌朝桌面上一拍，只见小二顿时两眼发光，对你客气地说：“看来客官是来拜山的，\n"
      "那就请往东面（goeast）去吧！”\n"
    );
    this_player()->set_temp("marks/东1", 1);
    return 1;
  }
}

int do_east(string arg) {
  object me;
  me = this_player();

  if (me->query_temp("marks/东1")) {
    message("vision", me->name() + "往东离开。\n",
      environment(me), ({ me }));
    me->move(__DIR__ "shanlu");
    message("vision", me->name() + "走了过来。\n",
      environment(me), ({ me }));
    this_player()->delete_temp("marks/东1");

    return 1;
  } else {
    write("你想往哪儿去?!\n");
    return 1;
  }
}
int do_north(string arg) {
  object me;
  object *inv;
  int i;

  me = this_player();

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->is_character()) {
      write("你不能背着" + inv[i]->query("name") + "进去!\n");
      return 1;
    }
  }
  me->move(__DIR__ "road100");
  return 1;
}
