inherit ROOM;
void create() {
  set("short", "练功房");
  set("long", @LONG
只见室内一只大炉中燃了洪炭, 煮着热气腾腾的一锅东西, 锅旁
两个黑衣小童, 一个使劲推拉风箱, 另一个用铁铲翻炒锅中之物, 听
这沙沙之声, 所炒的似是铁沙。一个老头闭目盘坐在锅前, 对着锅中
腾上来的热气缓吐深吸!
LONG
  );
  set("exits", ([
    "east": __DIR__ "shiwu",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "tiezhang");
  set("objects", ([
    "/d/tiezhang/npc/qiu1": 1,
    "/d/tiezhang/npc/shitong": 2,
  ]));
  setup();
}
