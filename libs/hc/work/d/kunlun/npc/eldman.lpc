//oldgod.c 老神仙
//ahxia, Jan. 19. 2001
inherit NPC;

int ask_sword();
void self_destruct();
void create() {
  set_name("老神仙", ({ "old god", "old", "god" }));
  set("long", @TEXT
哦？这个白胡子老头很可爱啊～～长长的白胡子都快到地上了。他正笑眯
眯的看着你，等着送给你一些仙境的珍品呢。可是你得记得身上要有地方戴。
TEXT);
  set("gender", "男性");
  set("age", 350);
  set("no_get", 1);
  set("shen_type", 1);
  set("inquiry", ([
    "xuanyuan jian": (: ask_sword :),
    "jian": (: ask_sword :),
    "轩辕剑": (: ask_sword :),
  ]));
  setup();
  set("chat_chance", 10);
  set("chat_msg", ({
    "老神仙说道：“快啊，快啊，要好东西的赶快啦！”\n",
    "老神仙看了看四周，见没有人找他，就又睡了。\n",
  }));

  carry_object("/clone/cloth/cloth")->wear();
}

int ask_sword() {
  object ob, me = this_player();

  if (!me) return 0;
  if ((int)me->query_temp("xuanyuan")) {
    ob = new("/d/kunlun/obj/xuanyuan-jian");
    if (!ob) return 0;
    if (ob->in_mud() == 1) {
      destruct(ob);
      tell_room(environment(me), "老神仙笑道：“" + RANK_D->query_respect(me)
        + "，你来的太晚了，宝贝已经送出去啦！”\n");
      return 1;
    }
    ob->move(this_object());
    this_object()->command("give " + me->query("id") + " xuanyuan jian");
    message("channel:rumor", HIM "『稀罕事儿』：" + this_player()->query("name")
      + "因机缘巧遇，不知从哪翻出来一把上古神兵“轩辕剑”。\n" NOR, users());
    me->delete_temp("xuanyuan");
    return 1;
  }
  return 0;
}

void init() {
  ::init();
  call_out("self_destruct", 20);
}

void self_destruct() {
  object *inv = all_inventory(this_object());

  if (inv)
    foreach (object ob in inv)
      if (ob) destruct(ob);
  tell_room(environment(this_object()), HIY "老神仙嗖的一声飞到了天空中, 再也看不到了!\n" NOR);
  destruct(this_object());
  return;
}
