//      neidian.c 内殿
//      Designed by secret (秘密)
//      97/04/09
inherit ROOM;
void create() {
  set("short", "内殿");
  set("long", @LONG
    这里是雪山寺的内殿，也是掌门人见客的地方。
在殿角有一个大洞(dong)。
LONG);
  set("exits", ([
    "east": __DIR__ "tiantai",
    "west": __DIR__ "midao",
    "south": __DIR__ "zoulang3",
  ]));
  set("objects", ([
    CLASS_D("xueshan") + "/jiumozhi": 1
  ]));
  setup();
  replace_program(ROOM);
}
void init() {
  add_action("do_enter", "enter");
  add_action("do_enter", "zuan");
}

int do_enter(string arg) {
  object me;
  mapping fam;

  me = this_player();
  if (!arg || arg == "") return 0;
  if (arg == "dong") {
    if ((fam = me->query("family")) && fam["family_name"] == "丐帮") {
      message("vision",
        me->name() + "运起丐帮缩骨功，一弯腰往狗洞里钻了进去。",
        environment(me), ({ me }));
      me->move("/d/gaibang/underxs");
      message("vision",
        me->name() + "从洞里走了进来。\n",
        environment(me), ({ me }));
      return 1;
    }
    return notify_fail("这么小的洞，你钻得进去吗？\n");
  }
}
