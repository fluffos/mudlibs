// ----/d/obj/xiandou.c ----
inherit ITEM;
void create() {
  set_name(HIY "倒霉仙豆" NOR, ({ "xian dou", }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set(
      "long",
      "一颗" + HIY + "金黄色" + NOR + "，" + HIR + "香喷喷" + NOR + "的" + HIW + "仙豆" + NOR + "。据说是由仙人做的，吃一颗，可以好久都不饿。\n"
    );
    set("unit", "棵");
    set("value", 0);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_eat", "eat");
}
int do_eat(string arg) {
  object me = this_player();
  int food, water;
  food = me->query("food");
  water = me->query("water");

  if (!id(arg)) return 0;
  if (me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

  if (food < (int)me->max_food_capacity() * 5 && food < 5000000000) me->add("food", -20200);
  else me->add("food", (int)me->max_food_capacity() / 100000000);

  if (food < (int)me->max_water_capacity() * 5 && water < 5000000000) me->add("water", -20200);
  else me->add("water", (int)me->max_water_capacity() / 10000000);

  if (me->is_fighting()) me->start_busy(2);
  message_vision(HIY "$N把仙豆丢到嘴里，像吃巧克力一样吞了下去，哎~不会珍惜。\n" NOR, me);
  destruct(this_object());
  return 1;
}
