//仿照少林的跳楼设计
inherit ROOM;
void create() {
  set("short", "大楼四层");
  set("long", @LONG
大楼与小楼风格差不多，为了更促进练习,每上一层都会更重
一些，这样使人的身体变得更轻,犹如到了无重空间一样，忘记
了重量的存在。增加了练习轻功的成果。
LONG
  );
  set("exits", ([
    "up": "d/huashan/hslou6",
    "down": "/d/huashan/hslou4",
  ]));
  set("no_magic", 1);
  setup();
  replace_program(ROOM);
}
