// /d/shaolin/npc/wuming.c
// by Swordman@HC 
// wuying-jian master

#include <ansi.h>

inherit NPC;
//inherit F_MASTER;
int ask_wuying();

void create() {
  set_name("无名老僧", ({ "wuming laoseng", "wuming", "laoseng" }));
  set("title", HIM "扫地僧" NOR);
  set("long", "只见他一张慈祥的脸孔，脸色红润，更无半分老态，身体健壮，
身材不高，头戴僧帽，穿的是一袭粗布僧衣。\n");
  set("gender", "男性");
  set("class", "bonze");
  set("age", 110);
  set("attitude", "friendly");
  set("shen_type", 0);
  set("str", 100);
  set("per", 27);
  set("int", 30);
  set("con", 230);
  set("dex", 100);

  set("max_qi", 43000);
  set("max_jing", 31000);
  set("neili", 344000);
  set("max_neili", 14000);
  set("jiali", 3500);
  set("combat_exp", 100000000);
  set("score", 500000);

  set_skill("literate", 800);
  set_skill("force", 1200);
  set_skill("dodge", 2200);
  set_skill("unarmed", 1200);
  set_skill("parry", 1200);
  set_skill("sword", 1200);
  set_skill("yizhi-chan", 1200);
  set_skill("riyue-bian", 1200);
  set_skill("whip", 1200);
  set_skill("shaolin-shenfa", 1200);
  set_skill("wuying-jian", 1200);
  set_skill("buddhism", 2000);
  set_skill("hunyuan-yiqi", 1200);
  set_skill("blade", 1200);

  map_skill("dodge", "shaolin-shenfa");
  map_skill("whip", "riyue-bian");
  map_skill("force", "huntian-yiqi");
  map_skill("unarmed", "yizhi-chan");
  map_skill("sword", "wuying-jian");
  map_skill("parry", "wuying-jian");
  set("inquiry", ([
    "试练": (: ask_wuying :),
    "考验": (: ask_wuying :),
    "无影剑": "这位施主...如果真的想得到无影剑的真传，就得经过老衲的考验方才可以啊..\n",
  ]));
  setup();
  carry_object("/d/shaolin/obj/cheng-cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/weapon/changbian");
}

int ask_wuying() {
  object obj, me = this_player(), ob = this_object();
  message_vision("$N躬身朗声道：“晚辈今日有幸拜见任老前辈，还望多多指教。”\n
$n慈祥的笑道：“这位施主既然愿意接受，老衲今日就活动一下这臭皮囊。”\n", me, ob);
  message_vision("$N道：“晚辈献丑了..”\n
$n点了点头，说道：“我只想瞧瞧你的武功根基，并非真的过
招，而且，老衲也未必能胜得了你。”\n\n", me, ob);
  say(HIC "无名老僧大喝一声：“看第一剑！！！”" NOR);
  COMBAT_D->do_attack(ob, me, query_temp("weapon"));
  if ((int)me->query("qi") < 0 || !present(me, environment())) {
    say("无名老僧缓缓的摇了摇头，说道：“这才是第一招...施主请回吧。”\n");
    return 1;
  }
  command("enable whisper riyue-bian ");
  command("unwield sword");
  command("wield bian");
  say(HIC "无名老僧沉声道：“第二招！日月鞭!!”" NOR);
  COMBAT_D->do_attack(ob, me, query_temp("weapon"));
  if ((int)me->query("qi") < 0 || !present(me, environment())) {
    say("无名老僧缓缓的摇了摇头，说道：“这才是第二招...施主请回吧。”\n");
    return 1;
  }
  command("unwield bian");
  say(HIC "无名老僧大喝一声：“第三招来了！！一指禅”" NOR);
  COMBAT_D->do_attack(ob, me, query_temp("weapon"));
  if ((int)me->query("qi") < 0 || !present(me, environment())) {
    say("无名老僧缓缓的摇了摇头，说道：“这才是第三招...施主请回吧。”\n");
    return 1;
  }
  command("wield sword");
  say(HIC "无名老僧大喝一声：“第四招来了！！无影剑法!”" NOR);
  COMBAT_D->do_attack(ob, me, query_temp("weapon"));
  if ((int)me->query("qi") < 0 || !present(me, environment())) {
    say("无名老僧缓缓的摇了摇头，说道：“已经是第四招了...施主还是请回吧。”\n");
    return 1;
  }
  command("sigh");
  command("perform wuying");
  say(HIC "无名老僧大喝一声：“第五招来了！！无影剑法最高境界！！！”" NOR);
  COMBAT_D->do_attack(ob, me, query_temp("weapon"));
  if ((int)me->query("qi") < 0 || !present(me, environment())) {
    say("无名老僧缓缓的摇了摇头，说道：“已经是第五招了,只差一点了，施主还是请回吧。”\n");
    return 1;
  }

  obj = new("/d/shaolin/obj/wuying_book");
  obj->move(me);
  say("无名老僧微笑道：“这位" + RANK_D->query_respect(me) + "已经通过试练，我就将这本无影剑谱送与你吧。”\n");
  return 1;
}
