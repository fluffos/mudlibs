// dao-cloth.c
//

#include <armor.h>

inherit CLOTH;

void create()
{
set_name(HIY "如来护体袈裟" NOR, ({"jia sha", "cloth" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
set("armor_prop/armor", 60000);
set("no_drop", "这样东西不能离开你。\n");
set("no_give", "这东西不能给别人. \n");
set("no_steal", "宝物你偷不到的, 死心吧. \n");
set("no_put", "这个东西放不进去. \n");
        }
        setup();
}

