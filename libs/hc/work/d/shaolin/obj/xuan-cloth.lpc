#include <armor.h>
inherit CLOTH;
void create()
{
        set_name("护法袈裟", ({ "jia sha" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
            set("shaolin",1);
                set("material", "cloth");
        set("armor_prop/intelligence", 3);
;
        set("armor_prop/intelligence",3);;
        }
        setup();
}
