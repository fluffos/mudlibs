//tianshaxing.c

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_me();

void create() {
  set_name(RED "天煞星" NOR, ({ "tian shaxing", "tian" }));
  set("nickname", HIY "孤独一生" NOR);
  set("gender", "男性");
  set("age", 40);
  set("long", "他是七杀门的首领,以杀人为乐。\n");
  set("per", 30);
  set("attitude", "peaceful");

  set("str", 25);
  set("int", 35);
  set("con", 35);
  set("dex", 35);

  set("qi", 100000);
  set("max_qi", 100000);
  set("jing", 3200);
  set("max_jing", 100000);
  set("neili", 20000);
  set("max_neili", 20000);
  set("jiali", 150);

  set("combat_exp", 30000000);
  set("score", 0);
  set("shen_type", 0);

  set_skill("force", 950);
  set_skill("jiuyang-shengong", 550);
  set_skill("liumai-shenjian", 700);
  set_skill("unarmed", 950);
  set_skill("killsword", 950);
  set_skill("dodge", 950);
  set_skill("qiankun-danuoyi", 950);
  set_skill("sword", 950);
  set_skill("parry", 950);
  map_skill("force", "jiuyang-shengong");
  map_skill("unarmed", "liumai-shenjian");
  map_skill("dodge", "qiankun-danuoyi");
  map_skill("parry", "killsword");
  map_skill("sword", "killsword");
  create_family("七杀门", 1, "杀手");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
    (: perform_action, "sword.tianxie" :),
  }));
  setup();
  carry_object("/clone/weapon/gangjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;

  remove_call_out("dest");
  call_out("dest", 600);

  if (living(this_object())) {
    add_action("do_kill", "kill");
    add_action("do_kill", "hit");
    add_action("do_kill", "touxi");
    add_action("do_yun", "yun");
    if (interactive(ob = this_player()))
      if (ob == query("pk_target")) {
        remove_call_out("killing");
        call_out("killing", 0, ob);
      }
  }
}

void dest() {
  object ob = this_object();
  if (!living(ob) || ob->is_busy() || ob->is_fighting()) {
    remove_call_out("dest");
    call_out("dest", 300);
    return;
  }
  shout(HIW "七杀门首领天杀星：看来中原的高手都是胆小鬼，我回去卷土重来！\n七杀门首领天杀星仰天“哈哈”长笑几声。\n" NOR);
  message_vision("$N一个纵身，转眼就消失在茫茫人海之中。\n", ob);
  destruct(ob);
}

void die() {
  object me = this_player();

  me->set("pk_target", 1);
  me->add("combat_exp", 50000);
  me->add("potential", 2500);
  message_vision("$N说道：“哎,看来我命该如此啊！”说完两眼一闭倒地死了。\n\n", this_object());
  tell_object(me, HIW "你杀死七杀门首领天杀星有功，奖励你 50K 经验和 2500 点潜能！\n" NOR);
  shout(HIM "【谣言】某人：天杀星被" + me->name() + HIM "杀死了。\n" NOR);
  ::die();
}

void if_die() {
  if (!query("pk_target")->is_ghost()) {
    remove_call_out("if_die");
    call_out("if_die", 3);
    return;
  }
  shout(HIW "$N大笑道：中原的武功也不过如此嘛！老子天下第一！待我回去卷土重来！哈！哈！哈！\n" NOR);
  message_vision("$N一个纵身，转眼就消失在茫茫人海之中。\n", this_object());
  destruct(this_object());
}

int do_kill(string arg) {
  object who, me, ob;

  ob = this_object();
  me = this_player();
  who = query("pk_target");

  if (who == me) return 0;
  if (arg != who->query("id") && (arg != "tian shaxing" || arg != "tian")) return 0;
  message_vision(HIW "$N一见$n在此捣乱，跳出来大喝一声道：臭贼！给我滚到一边去，不要妨碍老子决斗！\n" NOR, ob, me);
  message_vision("只见$N飞起一个三百六十度旋风腿将$n踢了出去。\n", ob, me);
  me->move("/d/city/wumiao");
  message_vision("只听“乒”地一声，$N被人一脚踢了过来，模样狼狈万状。\n", me);
  return 1;
}

int do_yun(string arg) {
  object me, ob, who;
  ob = this_object();
  me = this_player();
  who = query("pk_target");

  if (who == me) return 0;
  if (arg != "roar") return 0;
  message_vision(HIW "$N一见$n在此捣乱，跳出来大喝一声道：臭贼！给我滚到一边去，不要妨碍老子决斗！\n" NOR, ob, me);
  message_vision("只见$N飞起一个三百六十度旋风腿将$n踢了出去。\n", ob, me);
  me->move("/d/city/wumiao");
  message_vision("只听“乒”地一声，$N被人一脚踢了过来，模样狼狈万状。\n", me);
  return 1;
}

void killing(object ob) {
  if (environment(this_object()) != environment(ob)) return;
  if ((environment(ob)->query("no_fight"))) return;

  message_vision("$N对著$n喝道：「" + RANK_D->query_rude(ob) + "！今天不是你死就是我亡！」\n", this_object(), ob);
  this_object()->kill_ob(ob);
  remove_call_out("if_die");
  call_out("if_die", 3);
  return;
}
