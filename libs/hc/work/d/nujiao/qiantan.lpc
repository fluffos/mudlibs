inherit ROOM;

void create ()
{
  set ("short", "浅滩");
  set ("long", @LONG
望着碧波千里的洞庭湖，听湖水拍打着沙滩，你不由一阵心旷神怡。
这里是怒蛟岛临湖的浅滩，因为怕敌人由此偷袭，滩后林前还设有了望楼，监视这片湖面。
湖边泊着一艘大船(chuan)。
LONG);
    set("item_desc", ([
        "chuan" : "这是怒蛟帮对外联系的大船。岛上的客人或弟子只要\n"
                  "上船(enter)就可以回中原。\n",
    ]));


  set("exits", ([ /* sizeof() == 1 */
  "southeast" : __DIR__"dadao3",
]));
  set("outdoors", "/d/nujiao");

  setup();
}
void init()
{
    add_action("do_enter", "enter");
}
int do_enter ( string arg )
{
    object ob ;
    object room;
    if( !arg || arg !="chuan" ) 
       {
         tell_object(this_player() , "你要 enter 哪儿？\n" ) ;
         return 1 ;
       }
    if (!room=find_object("/d/nujiao/dahai"))
    room=load_object("/d/nujiao/dahai");
    if (!room->do_check())
        return notify_fail("船刚刚出海了！\n");
    ob = this_player () ;
    message_vision("船夫一见有人上船，忙叫了一声：开船喽！\n", ob);
    message_vision("船夫升起帆，船就向西方航行。\n", ob);
    ob ->move(room) ;
    tell_object(ob, BLU "你在湖中航行了很久很久.......\n" NOR ) ;
    call_out("rtaohua", 10 , ob );
    return 1 ;
}
void rtaohua( object ob )
{
    if (!ob || ob->is_ghost()) return;
  tell_object(ob , "大船终于抵达了中原的一个繁华城市。你走下船来。\n" ) ;
  ob->move ("/d/nujiao/dongting.lpc") ;
}


