// Room: /d/nujiao/
// by zjb@yhtt
inherit ROOM;
void create() {
  set("short", "洞庭湖边");
  set("long", @LONG
这里是去怒蛟帮的必经之地，湖边泊着一艘大船(chuan)。
LONG
  );
  set("exits", ([
    "south": "/d/quanzhou/jiaxing",
  ]));
  set("objects", ([
  ]));
  set("item_desc", ([
    "chuan": "这是去怒蛟帮的大船。只要上船(enter)就可以到怒蛟帮。\n",
  ]));
  set("outdoors", "nujiao");
  setup();
}
void init() {
  add_action("do_enter", "enter");
}
int do_enter(string arg) {
  object ob, room;
  if (!arg || arg != "chuan") {
    tell_object(this_player(), "你要 enter 哪儿？\n");
    return 1;
  }
  if (!room = find_object("/d/nujiao/dahai"))
    room = load_object("/d/nujiao/dahai");
  ob = this_player();
  message_vision("船夫一见有人上船，忙叫了一声：开船喽！\n", ob);
  message_vision("船夫升起帆，船就向东方航行。\n", ob);
  ob->move(room);
  tell_object(ob, BLU "你在湖中航行了很久很久.......\n" NOR);
  call_out("rtaohua", 10, ob);
  return 1;
}
void rtaohua(object ob) {
  if (!ob || ob->is_ghost()) return;
  tell_object(ob, "大船终于抵达在怒蛟帮的浅滩上。你走下船来。\n");
  ob->move("/d/nujiao/qiantan.lpc");
}
