inherit ROOM;

void create ()
{
  set ("short", "祭台");
  set ("long", @LONG
这里几是由武林大会召开后建立的挑战场了，在每个门派
都有这样的一快地方，挑战场四周放着高大的战鼓，不少
本派弟子正守在这里防止别人杀过来。如果你对自己有把
握可以替师门(tiaozhan)挑战这里，来获取该派势力。
LONG);

  set("no_quit",1);
  set("no_flee",1);
  set("alternative_die",1);
  set("exits",([
    "east" : __DIR__"shijie",
  ]));
  setup();
}

