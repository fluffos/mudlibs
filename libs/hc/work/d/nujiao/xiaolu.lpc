inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
这是一条小路，弯弯曲曲，不知道通向哪里。前面好象有个山谷。 
LONG
        );

        set("exits", ([
                "northwest" : __DIR__"nujiaofeng",
               "south" : __DIR__"xiaowu",
        ]));
         set("outdoors", "nujiao");
