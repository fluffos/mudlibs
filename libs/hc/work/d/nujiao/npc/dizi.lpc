inherit NPC;
inherit F_MASTER;

string *name_1 = ({
  "山", "张", "王", "李", "刘", "柳", "东", "候", "川", "山",
  "段", "慕容", "郭",
});

string *name_2 = ({
  "末", "疯", "狂", "笑天", "龙", "梦", "燕", "四", "三",
});

void create() {
  set_name(
    name_1[random(sizeof(name_1))] + name_2[random(sizeof(name_2))],
    ({ "di zi", "zhong", "dizi" })
  );
  set("gender", "男性");
  set("age", 26);
  set("title", "怒蛟帮众");
  set("long",
    "他衣服的胸前绣有一条张牙舞爪、似蛟似龙的怪兽，正是怒蛟帮的标志。。\n");
  set("attitude", "peaceful");
  set("str", 25);
  set("int", 15);
  set("con", 20);
  set("dex", 25);
  set("bac", 15);

  set("qi", 300);
  set("max_qi", 300);
  set("jingli", 200);
  set("max_jingli", 200);
  set("neili", 100);
  set("max_neili", 100);
  set("jiali", 30);

  set("combat_exp", 1000);

  set_skill("force", 10);


  setup();
  set("chat_chance", 2);
  set("chat_msg", ({
    "怒蛟帮众看了你一眼！\n",
  }));
  add_money("silver", 30 + random(30));
}
