#include <ansi.h>;
inherit NPC;
void create() {
  set_name("上官鹰", ({ "shang guanying", "shang" }));
  set("gender", "男性");
  set("title", HIG "怒蛟帮-帮主" NOR);
  set("age", 30);
  set("long",
    "他就是黑道三大帮会之一“怒蛟帮”的帮主。\n");
  set("attitude", "peacefully");
  set("shen_type", 1);
  set("str", 28);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("per", 25);

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: exert_function, "heal" :),
    (: exert_function, "heal" :),
    (: perform_action, "unarmed.nujiao" :),
    (: perform_action, "unarmed.nujiao" :),
    (: perform_action, "unarmed.nujiao" :),
  }));

  set("qi", 10500);
  set("max_qi", 10500);
  set("jingli", 18000000);
  set("jing", 18000000);
  set("max_jing", 180000);
  set("neili", 5000);
  set("max_neili", 20000);
  set("jiali", 60);

  set("combat_exp", 7880000);
  set("score", 100000);

  set_skill("force", 450);
  set_skill("polang-shengong", 450);
  set_skill("dodge", 500);
  set_skill("dengping-fushui", 520);
  set_skill("parry", 450);
  set_skill("unarmed", 450);
  set_skill("nujiao-quan", 450);
  set_skill("literate", 620);

  map_skill("force", "polang-shengong");
  map_skill("dodge", "dengping-fushui");
  map_skill("parry", "dengping-fushui");
  map_skill("unarmed", "nujiao-quan");
  prepare_skill("unarmed", "nujiao-quan");

  create_family("怒蛟帮", 5, "弟子");

  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  command("chat " + RANK_D->query_respect(ob) + "入我怒蛟帮以后就要听命行事。");
  command("recruit " + ob->query("id"));
  ob->set("title", HIR "怒蛟帮弟子" NOR);
}
