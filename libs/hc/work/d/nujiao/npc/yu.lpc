#include <ansi.h>;
inherit NPC;
void create() {
  set_name("翟雨时", ({ "ji yushi", "ji" }));
  set("gender", "男性");
  set("title", HIR "怒蛟帮 军师" NOR);
  set("age", 30);
  set("long",
    "翟雨时是上官鹰提拔的新人中之表表者，帮内资历虽低，却位高权重。\n");
  set("str", 28);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("per", 25);

  set("chat_msg_combat", ({
    (: exert_function, "heal" :),
    (: exert_function, "heal" :),
    (: perform_action, "unarmed.nujiao" :),
    (: perform_action, "unarmed.nujiao" :),
    (: perform_action, "unarmed.nujiao" :),
  }));

  set("qi", 35000);
  set("max_qi", 35000);
  set("jing", 18000000);
  set("jingli", 18000000);
  set("max_jing", 180000);
  set("neili", 10000);
  set("max_neili", 10000);
  set("jiali", 400);

  set("combat_exp", 9880000);
  set("score", 100000);

  set_skill("force", 520);
  set_skill("polang-shengong", 420);
  set_skill("dodge", 400);
  set_skill("dengping-fushui", 420);
  set_skill("parry", 420);
  set_skill("unarmed", 420);
  set_skill("nujiao-quan", 420);
  set_skill("literate", 1620);

  map_skill("force", "polang-shengong");
  map_skill("dodge", "dengping-fushui");
  map_skill("parry", "dengping-fushui");
  map_skill("unarmed", "nujiao-quan");
  prepare_skill("unarmed", "nujiao-quan");

  create_family("怒蛟帮", 5, "弟子");

  setup();

  carry_object(__DIR__ "obj/cloth")->wear();

}

void attempt_apprentice(object ob) {
  command("chat " + RANK_D->query_respect(ob) + "入我怒蛟帮以后就要听命行事。");
  command("recruit " + ob->query("id"));
  ob->set("title", HIR "怒蛟帮弟子" NOR);
}
