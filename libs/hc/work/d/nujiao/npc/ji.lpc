// 星空(zjb)更新于2001.11.18
#include <ansi.h>;
inherit NPC;
void create() {
  set_name("戚长征", ({ "qi changzheng", "qi" }));

  set("gender", "男性");
  set("title", HIY "快刀" NOR);
  set("age", 30);
  set("long",
    "古铜色的脸肩，就像阴天里阳光破云而出的模样．自有一种豪雄洒逸，风度不凡的神韵。\n");
  set("attitude", "peacefully");
  set("shen_type", 1);
  set("str", 28);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("per", 25);

  set("chat_chance_combat", 160);
  set("chat_msg_combat", ({
    (: perform_action, "blade.zhuifeng" :),
    (: perform_action, "blade.zhuifeng" :),
    (: perform_action, "blade.zhuifeng" :),
    (: exert_function, "heal" :),
    (: exert_function, "heal" :),
    (: perform_action, "unarmed.nujiao" :),
    (: perform_action, "unarmed.nujiao" :),
    (: perform_action, "unarmed.nujiao" :),
    (: perform_action, "blade.zhuifeng" :),
  }));

  set("qi", 3500);
  set("max_qi", 35000);
  set("jing", 18000000);
  set("max_jing", 180000);
  set("jingli", 18000000);
  set("neili", 50000);
  set("max_neili", 25000);
  set("jiali", 560);

  set("combat_exp", 38800000);
  set("score", 100000);

  set_skill("force", 820);
  set_skill("polang-shengong", 820);
  set_skill("blade", 850);
  set_skill("zhuifeng-blade", 820);
  set_skill("dodge", 800);
  set_skill("dengping-fushui", 820);
  set_skill("parry", 820);
  set_skill("unarmed", 820);
  set_skill("nujiao-quan", 820);
  set_skill("literate", 620);

  map_skill("force", "polang-shengong");
  map_skill("blade", "zhuifeng-blade");
  map_skill("dodge", "dengping-fushui");
  map_skill("parry", "dengping-fushui");
  map_skill("unarmed", "nujiao-quan");
  prepare_skill("unarmed", "nujiao-quan");

  create_family("怒蛟帮", 4, "弟子");

  set("chat_msg", ({
    "戚长征冲你微微一笑，露出两排雪白整齐的牙齿!\n",
  }));
  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/tianbing")->wield();

}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("blade", 1) < 250) {
    command("say 你基本刀法太差了，学不会我的功夫。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把基本刀法练好了在来找我！");
    return;
  }
  if ((int)ob->query_skill("polang-shengong", 1) < 150) {
    command("say 你的内功底子太差。");
    command("say " + RANK_D->query_respect(ob) +
      "你还是把内功先提高了在来吧？");
    return;
  }
  {
    command("chat " + RANK_D->query_respect(ob) + "入我怒蛟帮以后就要听命行事。");
    command("recruit " + ob->query("id"));
    ob->set("title", HIR "怒蛟帮弟子" NOR);
  }

}
