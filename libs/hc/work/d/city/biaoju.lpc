// Room: /d/fuzhou/biaoju.c

inherit ROOM;

void create() {
  set("short", "远东镖局");
  set("long", @LONG
这是一座结构宏伟的建筑前，左右石坛上各插着一根青铜的高大旗杆，
杆上锦旗飘扬。右首旗子用金线绣着一只腾云驾雾的火龙，上头有一只
凤凰飞翔。左首旗子上写着“远东镖局”四个黑字，刚劲非凡。入口
处排着四条长凳，几名镖头坐着把守。少镖头正跟几个顾客打着招呼。
LONG
  );

  set("exits", ([
    "south": "/u/sonic/datang",
    "northeast": "d/city/xidajie2",
  ]));

  setup();
  replace_program(ROOM);
}
