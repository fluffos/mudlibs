// gongzuoshi.c - 

#include <room.h>
#include <login.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "法宝屋");
        set("long", @LONG
 这里是红尘巫师建的法宝屋，许多玩家都来这儿试运气，看看屋子
中间的那课摇钱树（tree)能不能摇出点钱来。
LONG
        );

        set("exits", ([
                "down"  : __DIR__"guangchang",
        ]) );                   

        set("item_desc", ([
                "tree": @TEXT
黄金色的树，不知道你能不能摇（yao)出点钱来
TEXT
        ]) );

        set("no_fight", 1);
        set("no_kill", 1);

        setup();

}

void init()
{
        add_action("do_yao", "yao");
}

int do_yao(string arg)
{
        object me;
        string tempstr;

        me = this_player();

        if(me->query_temp("working") == 1) return notify_fail("再摇树要断了！\n");
        if(me->query("jing") < 20) return notify_fail("要钱不要命了？？！\n");
        if(me->query("qi") < 20) return notify_fail("要钱不要命了？？！\n");
        message_vision("$N看见树晃了晃....\n", me);

        if( random(20) == 0 ) {
     tempstr = "树上钻出一个人头：“$N！你竟敢偷巫师的钱！！”\n";
                message_vision(tempstr, me);
                me->move("/d/city/guangchang",1);
                tempstr = "树后转出个人，一脚把$N踢了出来：“给我滚！居然敢来偷钱！”\n";
                message_vision(tempstr, me);
                return 1;
        }

        me->set_temp("working", 1);
        call_out( "compelete_work", 3, me );
        return 1;
}

private void compelete_work(object me)
{
//        object ob;
//      int i;

//因為有的時候會出現string/array/object = 0的情况,所以重新set_temp一次
if(!me || !userp(me)) return;
me->set_temp("working",1);
        me->delete_temp("working");

        if( present(me) ) {                     // 如果玩家还在原地
 message_vision("$N发现有钱掉到身上。\n", me);
                me->add("jing", -10);
                me->add("qi", -10);
                me->add("money",10000);
                
/*
                for( i = 0; i < 10; i ++ ) {            // 十两银子
                        ob = new("/clone/money/silver");
                        ob->move(me);
*/
//              }
                tell_object(me, HIW"小菜对你说：你的运气不错，钱我帮你放进银号，你可以去取了!\n"NOR);
        }
        return;
}



