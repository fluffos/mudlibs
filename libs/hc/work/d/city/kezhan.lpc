int block_cmd(string);
void create() {
  set("short", RED "P K 客 店");
  set("long", @LONG

   这家客店位于长安城客店的二楼，这里竟然可以同往的PK城。这更是
成了外地游客落脚的首选。露天摆了七八张桌子，三教九流人等在此
进进出出，络绎不绝，几个跑堂的小二来来回回招待着四方来客。二
楼上是雅厅，后面是客房。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "pk": "d/pkdao/pkdao.lpc",
    "down": __DIR__ "kedian",
  ]));
  set("no_time", 1);
  set("no_time", 1);
