//change by edward
#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
    set_name("使者", ({ "shizhe", "jhfy shizhe" }) );
    set("nickname", HIY"寂寞红尘"NOR);
    set("gender", "男性" );
    set("age", 18);
    set("long", YEL"这位是〖红尘〗的使者，向他打听“寂寞红尘”，他会带给您想不到的惊喜。\n"NOR);
    set("shen_type", 1);
    set("combat_exp", 1000000);
    set("str", 30);
    set("dex", 30);
    set("con", 30);
    set("int", 30);
    set("per", 30);
    set("attitude", "friendly");
    set("max_qi", 100000);
    set("neili", 100000);
    set("max_neili", 1000);
    set("score", 100000);

    set("inquiry", ([
	"寂寞红尘" : (: ask_me :)
      ]));
    set("chat_chance", 1);

    set("chat_msg", ({
	(: command("es " + WHT"〖红☆尘〗欢迎新老玩家光临,IP: 202.100.218.146 Port: 5555"NOR) :),
      }));
    setup();
}

void init()
{
    object ob;
    ob = this_player();     
    ::init();
    if( interactive(ob) && !is_fighting() )
    {
	remove_call_out("greeting");
	call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
    command("whisper " + ob->query("id") + " "WHT"欢迎光临〖红☆尘〗"+HIR+"(ask shizhe about 寂寞红尘)\n"+WHT+"，小的助您行走江湖．"NOR);
    command("es " + WHT"欢迎光临〖红☆尘〗,IP: 202.100.218.146 Port: 5555,奖励送5福缘,小部分qn"NOR);
}

string ask_me()
{
    object me = this_player();
    mapping fam; 

    if ((int) me->query("welcomehc"))
	return "赶快开始你的江湖生涯吧,别浪费时间问我这些无聊的问题了！";
    else
    {
	me->add("potential",me->query("kar") * 15000/30);
	me->set("welcomehc", 1);
	me->add("potential", 1500);
	me->add("kar",5);
	me->add("food", 1000);
	me->add("water", 1000);
	CHANNEL_D->do_channel(me, "es", sprintf("在下%s今日光临〖红尘〗（202.100.218.146 5555）\n         现已得到红尘的帮助和奖励！即日起开始行走江湖了！", me->name(1)));
	return "欢迎光临"NOR+HIR"〖红尘〗"NOR"，你的福缘变满了！潜能增加了！\n"
	HIW"突然天空中一道"HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！"NOR;
    }
}

