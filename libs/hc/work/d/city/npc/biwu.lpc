#include <ansi.h>
inherit NPC;
string do_lunjian();
void create() {
  set_name(HIY "比武大会接引使", ({ "jieyin shizhe", "shizhe" }));
  set("gender", "男性");
  set("age", 19);
  set("long", "华山比武大会的接引使者，负责招待各派武林高手，
                  你可以 ask shizhe about 华山论剑。\n");

  set("combat_exp", 1000);
  set("shen_type", 0);
  set("attitude", "peaceful");
  set("inquiry", ([
    "华山论剑": (: do_lunjian :),
  ]));

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  setup();
  carry_object("/clone/misc/hic_cloth")->wear();
}
string do_lunjian() {
  object ob;
  ob = this_player();
  if ((string)ob->query("gender") == "女性")
    message_vision("接引使者高兴的说到地说道：姑娘加油！\n", ob);
  else
    message_vision("接引使者笑笑说：争取成为天下第一啊！\n", ob);
  write(HIY "只见接引使者拉出一匹骏马，你闪身上马\n
     你只觉得耳边风声骤响，眨眼已经到了华山￣￣\n" NOR);
  ob->move("/d/huashan/houzhiwangyu.lpc");
}
