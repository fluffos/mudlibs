//change by edward
#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
    set_name(HIR"PK使者", ({ "pk shizhe", "pk", "shizhe"  }) );
    set("nickname", HIY"风少密友"NOR);
    set("gender", "男性" );
    set("age", 18);
    set("long", YEL"这位是〖红尘〗的PK使者，是风少专门为纪念911pk大会请来的。\n"NOR);
//    set("shen_type", 1);
    set("combat_exp", 1000000);
    set("str", 30);
    set("dex", 30);
    set("con", 30);
    set("int", 30);
    set("per", 30);
    set("attitude", "friendly");
    set("max_qi", 100000);
    set("neili", 100000);
    set("max_neili", 1000);
    set("score", 100000);

    set("inquiry", ([
        "PK大会" : (: ask_me :)
      ]));
    set("chat_chance", 1);

    setup();
}

void init()
{
    object ob;
    ob = this_player();     
    ::init();
    if( interactive(ob) && !is_fighting() )
    {
	remove_call_out("greeting");
	call_out("greeting", 1, ob);
    }
}
