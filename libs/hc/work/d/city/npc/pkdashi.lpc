string ask_me()
{
    object me = this_player();
    mapping fam; 

    if ((int) me->query("PKDAHUI"))
        return "赶快开始杀人吧,别浪费时间问我这些无聊的问题了！";
    else
    {
//        me->add("potential",me->query("kar") * 15000/30);
        me->set("PKDAHUI", 1);
        me->set("PKS", 0);
        return "欢迎开始进太难的"NOR+HIR"〖红尘〗"NOR"，大PK您的数值已经保存了。\n"NOR;
    }
}

