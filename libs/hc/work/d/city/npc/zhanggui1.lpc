// banker.c
// originally coded by xiang
// 02-01-26 xxin fixed some math problem
inherit NPC;
inherit F_BANKER;
void create() {
  set_name("心思思", ({ "xin sisi", "xin", "sisi" }));
  set("title", HIC "小卖部" NOR);
  set("nickname", HIM "管家婆" NOR);
  set("gender", "女性");
  set("age", 22);
  set("per", 30);
  set("kar", 2000);
  set("str", 100);
  set("int", 24);
  set("dex", 18);
  set("con", 18);
  set("neili", 800000);
  set("max_neili", 100);
  set("jiali", 3000);
  set("shen", 0);
  set("max_qi", 900000);
  set("max_jing", 900000);
  set("combat_exp", 100000000);
  set("jingli", 100000);
  set("shen_type", 1);
  set("attitude", "friendly");
  set("env/wimpy", 50);
  set("chat_chance", 2);
  set("chat_msg", ({
    "心思思暗想：唉！我要是不趁现在留着一手，以后......还不知道他又看上谁了呢，哼！\n",
    "心思思说道：有什么可以为您服务吗？\n"
    "心思思笑着说道：我们要一切向“前”看呀！。\n"
    "心思思笑着说道：童叟无欺哦。\n",
    "心思思微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。\n",
  }));
  set_skill("unarmed", 2000);
  set_skill("dodge", 4000);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set("no_put", 1);
  set_temp("apply/damage", 40);
  setup();
  add_money("silver", 10);
  carry_object("/d/newbie/obj/xiaoq")->wear();
}
void init() {
  if (base_name(environment()) != this_object()->query("startroom")) return;
  add_action("do_check", "check");
  add_action("do_check", "cha");
  add_action("do_convert", "convert");
  add_action("do_convert", "huan");
  add_action("do_deposit", "deposit");
  add_action("do_deposit", "cun");
  add_action("do_withdraw", "withdraw");
  add_action("do_withdraw", "qu");
}
