#include <ansi.h>
inherit NPC;

void create() {
  set_name("日本倭寇", ({ "wo kou", "wo", "kou" }));
  set("long", "这是一名日本倭寇，样子很神秘,他来中原干尽坏事情。\n");
  set("attitude", "aggressive");
  set("age", 30 + random(11));
  set("str", 20 + random(11));            // 膂力
  set("per", 20 + random(11));            // 容貌
  set("int", 20 + random(11));            // 悟性
  set("con", 20 + random(11));            // 根骨
  set("dex", 20 + random(11));            // 身法
  set("kar", 20 + random(11));            // 福缘
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    BOLD "日本倭寇喝道：呔！中原小贼，拿命来！\n" NOR,
    CYN "日本倭寇喝道：快快放下贵重东西，留你一条生路！\n" NOR,
    CYN "日本倭寇喝道：老子看你是要钱还是要命！\n" NOR,
    BOLD "日本倭寇喝道：钱也要，命也要！\n" NOR,
    (: random_move :)
  }));
  set("neili", 700);
  set("max_neili", 700);
  set("jiali", 10);
  set("shen", -10);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 40);
  set_temp("apply/damage", 80);
  set_temp("apply/armor", 40);
  set_temp("apply/dodge", 80);
  set("combat_exp", 150000 + random(500000));
  set("score", 50000);
  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/city/npc/obj/gangdao")->wield();
  add_money("silver", 100);
  if (clonep(this_object()))
    call_out("leave", 70);
}

void leave() {

  command("chat 中原看来没啥高手，这次抢的真痛快，下次我会再来的！");
  message("vision", HIB + name() + "施展东瀛隐身术,消失在空气中。\n" NOR, environment(), this_object());
  destruct(this_object());
}
void die() {
  object user;
  object me = this_object()->query_temp("last_damage_from");
  message("channel:chat", HIM "【官府通告】：" + me->query("name") + "杀死倭寇，为中原增光！\n" NOR, users());
  me->add("combat_exp", 2000);
  me->add("potential", 800);
  message_vision("\n日本倭寇狂叫道：想不到中原有这么多高手！\n", me);
  message_vision("$N暴笑三声,倒在地上!\n", this_object());
  ::die();
}
