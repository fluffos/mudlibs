//fish_white.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("白鲳鱼", ({ "baichang", "fish" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条又肥又嫩的白鲳鱼。\n");
    set("unit", "条");
    set("value", 40);
    set("food_remaining", 5);
    set("food_supply", 15);
  }
}
