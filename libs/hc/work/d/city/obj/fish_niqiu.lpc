//fish_niqiu.c

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("泥鳅", ({"niqiu", "fish"}));
    set_weight(40);
    if (clonep())
	set_default_object(__FILE__);
    else {
	set("long", "一条小泥鳅鱼。\n");
	set("unit", "条");
	set("value", 0);
	set("food_remaining", 5);
	set("food_supply", 15);
    }
}

