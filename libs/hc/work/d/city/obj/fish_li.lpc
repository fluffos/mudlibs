//fish_li.c

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("鲤鱼", ({"liyu","fish"}));
    set_weight(500);
    if (clonep())
	set_default_object(__FILE__);
    else {
	set("long", "一条蛮大个的黄河鲤鱼。\n");
	set("unit", "条");
	set("value", 120);
	set("food_remaining", 5);
	set("food_supply", 35);
    }
}

