// Room: /city/xiaomaibu.c
// buy xxin 2002.1.26
inherit ROOM;
void create() {
  set("short", "小卖部");
  set("long", @LONG
这是一家破旧的小店面，据说是某神秘组织的窝点。承接各种委托，价格公道。你
要是有什么需要，可以在这里留言哦。柜台上有一个牌子(paizi)。
LONG
  );
  set("exits", ([
    "east": __DIR__ "chatroom",
  ]));
  set("item_desc", ([
    "paizi": @TEXT
这里是小卖部，目前我们提供的服务有：
convert(huan)     兑换钱币。
deposit(cun)      存钱。
withdraw(qu)      取钱。
check(cha)        查询存款。
每次取钱必需缴纳百分之一的手续费，将会从你的存款中扣取。
TEXT
  ]));
  set("objects", ([
    __DIR__ "npc/zhanggui1": 1,
  ]));
  set("no_fight", 1);
  setup();
  "/d/board/xiaomaibu_b"->foo();
}
