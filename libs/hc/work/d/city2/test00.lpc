 //room: /d/city2/test00.c
// ahxia 2000.12.20
inherit ROOM;
void create()
{
    set("short", "考试大厅");
    set("long", @LONG
这里是进京赶考学子们聚集的大厅。大厅的四周是一个个单人小考场，
苦读圣贤书的学子们正在认真答题。
LONG );
    set("exits", ([
        "east" : __DIR__"shuyuan",
        "1" : __DIR__"test01",
        "2" : __DIR__"test02",
        "3" : __DIR__"test03",
        "4" : __DIR__"test04",
        "5" : __DIR__"test05",
        "6" : __DIR__"test06",
        "7" : __DIR__"test07",
        "8" : __DIR__"test08",
        "9" : __DIR__"test09",
//      "up": __DIR__"testroom",
      ]) );
    setup();
}

void init()
{
    if( this_player()->query_condition("killer") )
        add_action("do_ban","ansuan");
}

int do_ban(string arg)
{
    write("这里不允许暗算他人耶～～还是好好考试吧。\n");
    return 1;
}

int valid_leave(object me, string dir)
{
    object *inv,room;
    string where = __DIR__+"test0"+dir;

    if( dir == "east" ) return 1;
    if( me->query_condition("killer") ){
        return notify_fail("你现在被通缉呢～～进去会好危险耶!\n");
    }
    if( strlen(dir) == 1 && file_size(where+".lpc")>0){
        room = find_object(where);
        if(!room) room = load_object(where);
        if(!room) return notify_fail("Err: file not found.\n");
        inv = all_inventory(room);
        if(!inv) return notify_fail("Err: file not found.\n");
        foreach(object ob in inv){
            if(userp(ob)){ //user in room
                return notify_fail("屋子里已经有人了。\n");
            }
        }
        return 1;
    }
/*
    if ( dir == "up" )
    {
        room = clone_object(__DIR__+"testroom");
        
        me->move(room);
        
        return -99;
    }
*/
    //应该不会运行到这里吧？
    //return notify_fail("Err: maybe valid_leave wrong.\n");
    return 1;
}
