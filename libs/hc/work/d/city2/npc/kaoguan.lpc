string replace_char(string arg) {
  string normal_char = "##@%$8SXZ";
  int i, len_arg = strlen(arg);
  int len_norm = strlen(normal_char);
  for (i = 0; i < len_arg; i++) {
    if (arg[i..i] == "#") {
      arg[i] = normal_char[random(len_norm)];
    }
  }
  return arg;
}

string replace_space(string arg) {
  string str = "##@%$8SXZ";
  string tmp = "";
  int num = strlen(str);
  int i, j;
  int len = strlen(arg);
  for (i = 0; i < len; i++) {
    if (arg[i..i] == " ") {
      j = random(num);
      tmp += BLK + BBLK + str[j..j] + NOR;
    } else
      tmp += arg[i..i];
  }
  return tmp;
}

int do_test(string arg) {
  object me, ob;
  int i;
  string *x0, *x1, *x2, *x3, *x4, *x5, *x6, *x7, ans;
  string msg = "";  //这个是矩阵形式的答案

  me = this_player();
  ob = this_object();

  if (!me || !environment(me)) return 1;
  if (me->is_busy() || me->is_fighting())
    return notify_fail("你都快要忙死了，还考什么考？\n");
  if (ob->is_fighting())  // || ob->is_busy() ??
    return notify_fail("考官现在没有功夫理你。\n");
  if (ob->query_temp("test"))
    return notify_fail("已经出了题了，快点答吧。\n");
#ifdef EXP_UPPER_LIMIT
  if (me->query("combat_exp") > EXP_UPPER_LIMIT) {
    write("考官说道：你已经长大了，以后要靠自己了。呵。。。呵。。。\n");
    return 1;
  }
#endif
  if (me->query("jing") < Q_JING) {
    write("你已经累得头晕眼花了。\n");
    return 1;
  }
  if (me->query("qi") < Q_QI) {
    write("你已经太累了。\n");
    return 1;
  }

  me->start_busy(BUSY_TIME);
  ob->start_busy(BUSY_TIME);

  me->add("jing", -Q_JING);
  me->add("qi", -Q_QI);

  ans = "";
  x0 = fetch_num(i = random(10)); ans = ans + i;
  x1 = fetch_num(i = random(10)); ans = ans + i;
  x2 = fetch_num(i = random(10)); ans = ans + i;
  x3 = fetch_num(i = random(10)); ans = ans + i;
  x4 = fetch_num(i = random(10)); ans = ans + i;
  x5 = fetch_num(i = random(10)); ans = ans + i;
  x6 = fetch_num(i = random(10)); ans = ans + i;
  x7 = fetch_num(i = random(10)); ans = ans + i;

  DEBUG(wizardp(me), "DEBUG: answer " + ans + "\n");

  ob->set_temp("test/answer", ans);
  me->set_temp("test/wrong", 0);
  write(HIY "\n出题啦：\n" NOR + BBLK);

  switch (random(3)) {
    case 0: {
      for (i = 0; i < Y; i++) {
        msg += x0[i] + x1[i] + x2[i] + x3[i] + x4[i] + x5[i] + x6[i] + x7[i] + "\n";
      }
      ob->set_temp("test/factor", EASY_FACTOR);  //normal reward.
      break;
    }
    case 1: {
      for (i = 0; i < Y; i++)
        msg += x0[i] + x1[i] + x2[i] + x3[i] + "\n";
      msg += "\n";
      for (i = 0; i < Y; i++)
        msg += x4[i] + x5[i] + x6[i] + x7[i] + "\n";
      ob->set_temp("test/factor", HARD_FACTOR);  //hard to make robot.
      break;
    }
    case 2: {
      for (i = 0; i < Y; i++)
        msg += x0[i] + " " + x1[i] + " " + x2[i] + " " + x3[i] + "\n";
      msg += (random(2) ? "\n" : "\n\n");
      for (i = 0; i < Y; i++)
        msg += x4[i] + " " + x5[i] + " " + x6[i] + " " + x7[i] + "\n";
      ob->set_temp("test/factor", HARD_FACTOR);  //hard to make robot.
      break;
    }
  }
  //!!!
  msg = replace_char(msg);
  msg = replace_space(msg);
  write(msg);

  write(NOR "用 " + HIY + "answer 阿拉伯数字" + NOR + " 答题。\n");

  remove_call_out("wait_time");
  call_out("clear_ans_mode", WAIT_TIME);
  return 1;
}

void clear_ans_mode() {
  object ob = this_object();
  object me = this_player();

  if (!me || !ob || !environment(me)) return;

  write("考官说道：“时间到了，停止答题！”\n");
  ob->delete_temp("test");
  me->delete_temp("test");
  return;
}



int do_answer(string arg) {
  int kar, iq, per, cps, reward_exp, reward_pot;
  object me = this_player();
  object ob = this_object();

  if (!me || !ob || !environment(me)) return 1;
  if (me->is_fighting())  //me->is_busy()|| ... ??
    return notify_fail("你都快要忙死了，还考什么考？\n");
  if (ob->is_fighting())
    return notify_fail("考官现在没有功夫理你。\n");
  if (!ob->query_temp("test"))
    return notify_fail("用kaoshi来开始考试，然后用answer答题。\n");

  kar = me->query("kar");
  per = me->query("per");
  cps = me->query("cps");
  iq = me->query_skill("literate", 1);

  //均衡 lit 水准
  if (iq < 50) iq = 100;
  else if (iq < 100) iq = 150;
  else if (iq < 250) iq = 225;
  else if (iq < 500) iq = 300;
  else if (iq < 750) iq = 400;
  else if (iq < 1000) iq = 500;
  else
    iq = 600;

  reward_exp = kar + cps + random(iq) / 2;
  reward_pot = reward_exp / (2 + random(4)) + (me->query("gender") == "女性" ? per / 3 : 0);

  reward_pot *= ob->query_temp("test/factor");
  reward_exp *= ob->query_temp("test/factor");

  if (ob->query_temp("test/answer") == arg) {  //correct!
    me->add("combat_exp", reward_exp);
    me->add("potential", reward_pot);

    write("考官说道：" + me->name() + "答对了！\n", ({ me }));
    write("答对了！你得到" + reward_exp + "点经验，" + reward_pot + "点潜能。\n");

    //wing加入，关于判断是否获得宝石的依据
    me->add_temp("gem/times", 1);
    me->add_temp("gem/correction", 1);
    if (me->query_temp("gem/times") >= GPT) {
      if (me->query_temp("gem/correction") >= (9 * GPT / 10)) {
        command("say 由于你的勤奋，决定奖赏你一枚宝石，继续努力哦！");
        CHANNEL_D->do_channel(
          this_object(),
          "sys",
          me->name(1) + "(" + me->query("id") + ")获得一颗宝石."
        );
        me->add("gem", 1);
      }
      me->delete_temp("gem");
    }

    ob->delete_temp("test");
    me->delete_temp("test");
    remove_call_out("clear_ans_mode");
  } else {  //got an incorrect answer.
    write(me->name() + "！别在这里瞎掰，你的答案不对。\n");
    me->add_temp("test/wrong", 1);
    if (me->query_temp("test/wrong") >= WRONG_FACTOR) {
      reward_exp = (me->query("combat_exp") - reward_exp >= 0) ? reward_exp * PENALTY_FACTOR : 0;
      reward_pot = (me->query("potential") - reward_pot >= 0) ? reward_pot * PENALTY_FACTOR : 0;

      me->add("combat_exp", -reward_exp);
      me->add("potential", -reward_pot);
      write(HIY "你被罚掉" + reward_exp + "点经验，" + reward_pot + "点潜能。\n" NOR);

      me->add_temp("gem/times", 1);
      me->add_temp("gem/correction", -2);
      if (me->query_temp("gem/times") >= GPT) {
        if (me->query_temp("gem/correction") >= (9 * GPT / 10)) {
          command("say 由于你的勤奋，决定奖赏你一枚宝石，继续努力哦！");
          CHANNEL_D->do_channel(
            this_object(),
            "sys",
            me->name(1) + "(" + me->query("id") + ")获得一颗宝石."
          );
          me->add("gem", 1);
        }
        me->delete_temp("gem");
      }

      ob->delete_temp("test");
      me->delete_temp("test");
      remove_call_out("clear_ans_mode");
    }
  }
  return 1;
}
