// kaoguan.c 考官
// 2k1.5.9 3rd ed, by ahxia, wings.
// 2k2.7.8 4ed, ahxia, did some factors modifications

#include <ansi.h>
inherit NPC;
//inherit F_MASTER : 用来防止在half_god的quest中误杀
//参照 master.c 里增加的int is_master() 和half_god的判断部分. is_master() 是自己加的，转移到其MUD情形会不一样。
inherit F_MASTER;

//if X >= 1, tell me answer.
#define DEBUG(X,Y) if(X) write(Y);
//BUSY_TIME = 考试时busy时间, WAIT_TIME = 等答案需要时间.
#define BUSY_TIME 3
#define WAIT_TIME 16
//Q_JING = 需要消耗的"精", Q_QI = 需要消耗的"气"
#define Q_JING 15
#define Q_QI 30
//针对于 *单行* 和 *双行* 题目的难度系数
#define EASY_FACTOR 5/2
#define HARD_FACTOR 4
//答错的惩罚系数,不要设太高才好. 1 到 3/2 之间吧
#define PENALTY_FACTOR 3/4
//每答对多少题获得一枚GEM
#define GPT 200
// combat_exp 上限, 1.5亿
#define EXP_UPPER_LIMIT 150000000
// combat_exp 下限,暂时无用
#define EXP_LOWER_LIMIT 50000
// 准许答错次数
#define WRONG_FACTOR 1

#include "test.h"
#include "test1.h"
#include "test2.h"
#include "test3.h"
#include "test4.h"
#include "test5.h"
#include "test6.h"
#include "test7.h"

string *fetch_num(int);
string replace_char(string);
string replace_space(string);
void clear_ans_mode();

void create() {
  set_name("笔试监考官", ({ "exam inspector", }));
  set("gender", "男性");
  set("age", 45 + random(10));
  set("long",
    "他就是广大学子惧怕的考官。他阴沉着脸，正在看者你。看起\n"
    "来他的监考大法已经是登峰造极了！\n");
  set("attitude", "peaceful");

  set("chat_chance", 1);
  set("chat_msg", ({
    "考官说到：“有不明白的地方记得提问(ask)...”\n",
    "考官说道：“考试么，就是进了考场、等着答题。”\n",
    "考官看了看你，小声嘀咕着：“小心别让我抓到！”\n",
    "考官说道：“认真答题才能早成大侠。”\n",
    //      (: random_move :),
  }));

  set("inquiry", ([
    "test": "用 kaoshi 发题,然后用 answer/da 数字\n",
    "name": "老夫姓名并不重要，你还是好好答题罢！\n",
    "考试": "用 kaoshi 发题,然后用 answer/da 数字\n",
    "作弊": "去死！作弊的一律给零蛋。\n",
    "抄袭": "真没出息，除了这个你还会什么啊？\n",
    "answer": "孺子可教，answer或者da是用来答题的，用kaoshi来考试。\n",
  ]));

  setup();

  carry_object("/clone/cloth/cloth")->wear();
}

void init() {
  if (this_player()->query("gender") == "无性") {
    command("@@ " + this_player()->query("id"));
    return;
  }
  add_action("do_test", ({ "kaoshi", }));
  add_action("do_answer", ({ "answer", "da", }));
}

