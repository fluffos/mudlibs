// transite.c   
// modified by wind

inherit ITEM;

mapping where_map = ([
  "gc": "/d/city/guangchang",
  "sl": "/d/shaolin/guangchang1",
  "bt": "/d/baituo/dating",
  "tam": "/d/city2/tian_anm",
  "hs": "/d/huashan/zhenyue",
  "wd": "/d/wudang/jiejianyan",
  "ts": "/d/taishan/nantian",
  "xy": "/d/xiaoyao/qingcaop",
  "xx": "/d/xingxiu/xxh1",
  "xs": "/d/xueshan/dadian",
  "sld": "/d/shenlong/dating",
  "qz": "/d/quanzhou/zhongxin",
  "lj": "/d/lingjiu/dating",
  "tl": "/d/tianlongsi/damen",
  "td": "/d/city2/dating",
  "em": "/d/emei/hcazhengdian",
  "yz": "/d/yanziwu/yimen",
  "th": "/d/taohua/mudi",
  "gm": "/d/gumu/mumen",
  "quanz": "/d/quanzhen/ximen",
  "cd": "/d/city3/guangchang",
  "wjg": "/d/wanjiegu/entrance",
  "mj": "/d/mingjiao/tianweitang",
  "sz": "/d/suzhou/baodaiqiao",
  "hh": "/d/hangzhou/road14",
  "fz": "/d/fuzhou/dongjiekou",
  "xyc": "/d/xiangyang/westjie2",
  "qc": "/d/qingcheng/xiaoqiao",
  "ss": "/d/songshan/taishique",
  "hes": "/d/henshan/hengyang",
  "hgs": "/d/hengshan/cuipinggu1",
  "dl": "/d/dali/center",
  "sleep": "/d/wudang/xiuxishi",
]);

void init() {
  add_action("do_arrive", "arrive");
}

void create() {
  set_name("红尘帆", ({ "fan", "fan" }));
  set("no_get", 1);
  set("no_steal", 1);
  set_weight(100);
  set_max_encumbrance(8000);
  set("value", 10000);
  set("used_count", 0);
  set("can_use_count", 10 + random(10));
  set("no_put", "这东西不能随便给人！\n");

  if (clonep()) set_default_object(__FILE__);
  else {
    set("long", HIR "这是天上神物(红尘帆)，以它的威力现在所能去(arrive)的地方如下。\n
\t中央广场(gc)    少林寺(sl)    白驼山(bt)    天安门(tam) \n
\t万劫谷(wjg)     华山(hs)      武当山(wd)    泰山(ts)    \n
\t逍遥派(xy)      星宿海(xx)    雪山寺(xs)    神龙岛(sld) \n
\t泉州(qz)        灵鹫宫(lj)    天龙寺(tl)    天地会(td)  \n
\t古墓派(gm)      峨嵋派(em)    燕子坞(yz)    桃花岛(th)  \n
\t 成都 (cd)      红花会(hh)    青城山(qc)    大理(dl) \n
\t恒山 (hes)      衡山 (hgs)    嵩山 (ss)     襄阳城 (xyc)\n 
\t 福州(fz)       苏州 (sz )     明教 (mj)        \n
" NOR);
    set("unit", "个");
  }
}

int do_arrive(string arg) {
  object me, obj; string msg, str; str = where_map[arg];
  if (!arg || !stringp(str)) return notify_fail("你要飞去哪里？\n");
  me = this_player();
  if (!environment(me)->query("outdoors"))
    return notify_fail("在这房间里无法使用红尘帆。\n");
  if (me->is_fighting())
    return notify_fail("战斗中无法使用红尘帆！");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");
  if (me->query("sleeped"))
    return notify_fail("你在睡梦中飞啊飞！\n");

  if (this_object()->query("used_count") > this_object()->query("can_use_count")) {
    this_object()->set("value", 20000);
    this_object()->delete("no_put");
    this_object()->delete("no_drop");
    this_object()->set_name("失去威力的红尘帆", ({ "fan" }));
    return notify_fail("这个红尘帆威力消失了，对你没用了！\n");
  }

  str += ".lpc";
  if (file_size(str) < 0)
    return notify_fail("没有这个地方。\n");
  if (stringp(msg = me->query("env/msg_mout"))) {
    if (msg != "") message_vision(msg + "\n", me);
  } else message_vision(HIM "只见一阵狂风过後，$N坐着红尘帆已经消失在人海中。\n" NOR, me);
  me->move(str);
  if (stringp(msg = me->query("env/msg_min"))) {
    if (msg != "") message_vision(msg + "\n", me);
  } else message_vision(HIG "$N坐着红尘帆突然出现在一群人海之中。\n" NOR, me);
  this_object()->add("used_count", 1);
  return 1;
}
