 //room: /d/city2/testroom.c
//modfied by wings@hc 2002.10.11

inherit ROOM;

void create()
{                                 
        string strName,strCode;
        
        set("short", "考场");
        set("long", @LONG
这里是单人考场，可以通过kaoshi要求发题，用answer来回答。
LONG );
        set("exits", ([
                "out" : __DIR__"test00",
        ]) );

        set("objects", ([
         __DIR__"npc/kaoguan": 1,
        ]));
        
        if ( clonep() )
        {
                if (sscanf(file_name(this_object()),"%s#%s",strName,strCode) == 2)
                        set("short","考场"+strCode);
        }
                        
      setup();
}

void init()
{
        if ( clonep(this_object()) ) call_out("detect",10);
}

void detect()
{
        object *ob;
        int nFlag = 0;  
        int i;
        
        remove_call_out("detect");

        ob = all_inventory(this_object());

        for ( i = 0 ; i < sizeof(ob) ; i++ )
        {
                if ( userp(ob[i]) )
                {
                        nFlag = 1;
                        break;
                }
        }
        
        if ( nFlag )
                call_out("detect",10);
        else
                call_out("self_destruct",10);
}

void self_destruct()
{
        remove_call_out("self_destruct");
        
        destruct(this_object());
}
