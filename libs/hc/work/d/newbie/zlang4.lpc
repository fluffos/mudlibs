// /d/newbie/zlang1.c 走廊一
// by swordman 2001/3/26

inherit ROOM;

void create() {
  set("short", HIW "校场走廊四");
  set("long",
    "这是新手校场的走廊，地上铺着朴素的青面砖，
一些新人在这里来往穿梭。往南是" HIW "逍遥派" NOR "的接引室，
而北面则是" HIC "小桃花" NOR "的接待室.\n"
  );
  set("exits", ([
    "east": __DIR__ "zlang3",
    "north": __DIR__ "throom",
    "south": __DIR__ "xyroom" ]));
  set("no_clean_up", 0);
  set("outdoors", "newbie");
  setup();
}
