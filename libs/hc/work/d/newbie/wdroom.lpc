// by swordman 2001/3/27

inherit ROOM;

void create() {
  set("short", HIG "武当接引室");
  set("long",
    "这便是武当的接引室了，武当向来以名门正派自
居，这次也派下后辈中的得意弟子来充当接引使的角色，
看来江湖纷争，使得这些名门也觉得有写吃紧了。\n"
  );
  set("exits", ([
    "west": __DIR__ "xyroom",
    "north": __DIR__ "zlang3",
    "east": __DIR__ "hsroom",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/wdsz": 1,
  ]));
  set("outdoors", "newbie");
  setup();
}
