// /d/newbie/npc/wdsz.c 武当使者
// by swordman 2001/3/26
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("武当使者", ({ "wd shizhe", "wd", "shizhe" }));
  set("title", "武当接引使");
  set("long",
    "他就是武当的接引大弟子，负责教导新人。\n"
    "如果要学更高的太极功夫，还是要去武当山的。\n"
    "那里才有真正的太极心法可以研学的。\n");
  set("gender", "男性");
  set("age", 27);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 38);
  set("int", 58);
  set("con", 68);
  set("dex", 128);

  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 16000);
  set("max_neili", 8000);
  set("jiali", 50);
  set("combat_exp", 2400000);
  set("score", 70000);
  set_skill("force", 200);
  set_skill("taiji-shengong", 200);
  set_skill("dodge", 200);
  set_skill("tiyunzong", 200);
  set_skill("unarmed", 200);
  set_skill("taiji-quan", 200);
  set_skill("parry", 200);
  set_skill("taoism", 200);
  set_skill("sword", 200);
  set_skill("taiji-jian", 200);
  set_skill("literate", 200);
  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");
  create_family("武当派", 4, "弟子");
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.zhen" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/d/wudang/obj/greyrobe")->wear();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < -1) {
    command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  command("say 好吧，本使就收下你了。");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
}
