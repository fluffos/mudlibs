// /d/newbie/npc/xysz.c 逍遥使者
// by swordman 2001/3/26
inherit NPC;
inherit F_MASTER;
void create()
{
    set_name("逍遥使者", ({ "xy shizhe", "xy", "shizhe" }));
    set("long", 
        "天下第一新手门派逍遥的接引使。可学到不少入门功夫的。\n");
    set("gender", "男性");
    set("title", "逍遥接引使");
    set("age", 26);
    set("attitude", "peaceful");
    set("str", 25);
    set("int", 27);
    set("con", 25);
    set("dex", 25);

    set("max_qi", 1500);
    set("max_jing", 600);
    set("neili", 3000);
    set("max_neili", 3000);
    set("jiali", 60);
    set("combat_exp", 150000);

    set_skill("force", 200);
    set_skill("dodge", 200);
    set_skill("unarmed", 200);
    set_skill("parry", 200);
    set_skill("lingboweibu", 200);
    set_skill("beiming-shengong", 200);
    set_skill("zhemei-shou", 200);
    map_skill("unarmed", "zhemei-shou");
    map_skill("dodge", "lingboweibu");
    map_skill("force", "beiming-shengong");

    create_family("逍遥派", 4, "弟子");
    setup();
    carry_object("/clone/misc/cloth")->wear();
}
void attempt_apprentice(object ob)
{
    command("say 本使就收下你了，以后要多为逍遥派出力啊。");
    command("recruit " + ob->query("id"));
ob->set("class","shaman");
 }
