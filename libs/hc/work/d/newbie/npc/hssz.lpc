// /d/newbie/npc/hssz.c 华山使者
// by swordman 2001/3/26
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("华山使者", ({ "hs shizhe", "hs", "shizhe" }) );
        set("title", "华山派接引使");
        set("gender", "男性");
        set("age", 26);
        set("long",
 "他华山的接引使了,你可以和他学到不少华山\n"
 "的初步功夫，要学更高深的武学，你只有上华山了。\n" );
        set("attitude", "peaceful");
    set("str", 40);
    set("neili",3000);
    set("max_qi",2000);
    set("int", 65);
    set("con", 60);
        set("per", 28);
    set("dex", 130);
        set("max_neili", 1500);
        set("jiali",200);
        set("combat_exp",1562500);
        set("shen",15000);
        set_skill("force", 200);
        set_skill("zhengqijue", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("sword", 200);
        set_skill("blade", 200);
        set_skill("zixia-shengong", 200);
        set_skill("feiyan-huixiang", 200);
        set_skill("huashan-sword", 200);
        set_skill("huashan-ken", 200);
        set_skill("huashan-shenfa", 200);
        set_skill("poyu-quan", 200);
        set_skill("fanliangyi-dao", 200);
        set_skill("literate", 200);
        set_skill("unarmed", 200);
    
    map_skill("dodge", "feiyan-huixiang");
    map_skill("force", "zixia-shengong");
    map_skill("parry", "huashan-sword");
    map_skill("sword", "huashan-sword");
map_skill("unarmed", "huashan-ken");
    map_skill("blade", "fanliangyi-dao");
    create_family("华山派", 15, "弟子");
    setup();
    carry_object("/clone/misc/long_cloth")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob)
{
        if( (string)ob->query("gender") == "无性" )
                command("say 我不收公公，这位同志还是另访名师吧。");
        else {
                command("nod");
                command("say " + RANK_D->query_respect(ob) + "日后定是我华山精英！\n");                command("recruit " + ob->query("id") );
             }
}
void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "swordsman");
}
