// d/xyju/npc/taohua.c

inherit NPC;

void create() {
  set_name("小桃花", ({ "tao hua", "tao", "hua" }));
  set("nickname", HIM "小玉女" NOR);
  set("gender", "女性");
  set("age", 12 + random(6));
  set("long",
    "这是个天真活泼的小姑娘，听说是风少当年下山游历之时收\n"
    "养的孤儿之一，大眼睛顽皮的眨动着，招呼着四方来的客人。\n");
  set("attitude", "friendly");
  set("shen_type", 1);

  set("str", 20);
  set("int", 28);
  set("con", 24);
  set("dex", 20);
  set("per", 30);
  set("kar", 30);
  set("shen", 0);

  set("max_qi", 31150);
  set("max_jing", 21100);
  set("neili", 32150);
  set("max_neili", 21150);

  set("combat_exp", 32121000 + random(200));
  set("score", 1000);

  set_skill("force", 1230);
  set_skill("dodge", 1220);
  set_skill("unarmed", 1215 + random(10));
  set_skill("parry", 1220);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 15);
  set_temp("apply/damage", 3);

  set("chat_msg", ({
    "桃花微微笑道：“这里可悠闲了，闲逸居里的人都是好人呢，嘻嘻...\n",
    "桃花把小鼻子一揪，啐了一口道：“那个死大米，总是捉弄我，看我不告诉干爹要他好看。\n",
    "桃花甩了甩小辫，天真的笑着：“也真要多谢干爹了，要不是他，我现在还在流浪呢。\n",
  }));
  set("inquiry", ([
    "swordman": "那是我干爹呀，就是他把我收养的，要多谢他呢。\n",
    "风少": "那是我干爹呀，就是他把我收养的，要多谢他呢。\n",
    "sonic": "他是我干爹的好朋友，也是个大wiz呢，嘻嘻。他好好玩的。\n",
    "小菜": "他是我干爹的好朋友，也是个大wiz呢，嘻嘻。他好好玩的。\n",
    "lwt": "冷雾呀，人还不错，就是看我的时候眼神总是不对哦，有点“色”呢。\n",
    "冷雾": "冷雾呀，人还不错，就是看我的时候眼神总是不对哦，有点“色”呢。\n",
    "hanbo": "韩柏...嗯..我见过他的太太哦，好漂亮呢。我长大也要那么漂亮。\n",
    "韩柏": "韩柏...嗯..我见过他的太太哦，好漂亮呢。我长大也要那么漂亮。\n",
    "epic": "震源伯父最好了，常常做玩具给我玩，我最喜欢他了。\n",
    "震源": "震源伯父最好了，常常做玩具给我玩，我最喜欢他了。\n",
    "ahxia": "阿霞阿姨我很少见到呢。不过她很漂亮的。对了，你要是见到她帮我问候呀。\n",
    "阿霞": "阿霞阿姨我很少见到呢。不过她很漂亮的。对了，你要是见到她帮我问候呀。\n",
    "wings": "林枫叔叔是我咱们这的常客呢，他说桃花以后会很聪明的呢。嘻嘻，好高兴哦。\n",
    "林枫": "林枫叔叔是我咱们这的常客呢，他说桃花以后会很聪明的呢。嘻嘻，好高兴哦。\n",
    "dami": "大米，大米哦。嘻嘻，我不是老鼠呢。他最讨厌了，老想占我便宜。哼，我才不理他呢。\n",
    "大米": "大米，大米哦。嘻嘻，我不是老鼠呢。他最讨厌了，老想占我便宜。哼，我才不理他呢。\n",
    "flot": "他也是我干爹的一个老朋友了，好久没见过他了。\n",
    "bard": "他是我干爹的一个老朋友了，他最近在干什么呢？\n",
    "miller": "他呀...他是谁？？呀，我开玩笑的啦。别打我哦。\n",
    "raoyun": "绕云？...他是谁？？呀，对了，上次他还欠我一个人参果呢!\n",
    "漂亮妹妹": "我现在还不是哦。将来长大了就是啦。嘻嘻..:)\n",
    "plmm": "你好色哦，我现在只是个可爱妹妹呢。不要问我这样的问题嘛..\n",
    "我是流氓": "你好色哦，我去告诉我干爹去。\n",
  ]));

  setup();
  carry_object(__DIR__ "obj/xiaoq.lpc")->wear();
}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;

  say("桃花笑吟吟地说道：这位" + RANK_D->query_respect(ob)
    + "请先入座，" + "我这就给您上茶。\n");
}


void serve_tea(object who) {
  object obt, obc, obn;
  object room;

  if (!who || environment(who) != environment()) return;

  if (!who->query_temp("marks/sit")) return;

  if (!objectp(room = environment())) return;

  if ((int)who->query_temp("tea_cup") <= 0) {
    obn = new(__DIR__ "obj/dawancha");
    obn->move(room);
    message_vision("桃花搬出个大茶壶来，将桌上的大碗茶倒满．\n",
      who);
  } else {
    who->add_temp("tea_cup", -1);
    obn = new(__DIR__ "obj/xiangcha");
    obn->move(room);
    message_vision("桃花拿出个绍兴小茶壶，沏了杯香茶，放在桌上．\n",
      who);
  }

  obn = new(__DIR__ "obj/mitao");
  obn->move(room);
  message_vision("桃花拿出一碟新鲜的水蜜桃，放在桌上．\n", who);

  return;
}
