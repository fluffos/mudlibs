#include <armor.h>
inherit CLOTH;
void create()
{
        set_name(HIR"绣凤小裙"NOR, ({ "xiao qun", "qun", "xiao"}) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 500);
        }
        setup();
}
