#include <armor.h>
inherit CLOTH;
void create()
{
        set_name(HIM"盘龙长衫"NOR, ({ "chang shan", "shan"}) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 500);
        }
        setup();
}
