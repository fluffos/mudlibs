inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("肉包子", ({ "baozi", "bao" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个热腾腾的牛肉包子，看来满好吃的样子。\n");
    set("unit", "个");
    set("value", 500);
    set("food_remaining", 5);
    set("food_supply", 120);
  }
}
