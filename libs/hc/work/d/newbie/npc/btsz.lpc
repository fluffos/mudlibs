// /d/newbie/npc/btsz.c 白驼使者 
// by swordman 2001/3/26
inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;
void greeting(object);
void init();
void create() {
  set_name("白驼使者", ({ "bt shizhe", "bt", "shizhe" }));
  set("title", "白驼山派接引使");
  set("gender", "男性");
  set("age", 25);
  set("long", "他是白驼的接引使者，你可以和他学习到一些入门功夫。\n");
  set("attitude", "friendly");
  set("shen_type", -1);
  set("str", 23);
  set("int", 23);
  set("con", 22);
  set("dex", 50);
  set("max_qi", 600);
  set("qi", 600);
  set("max_jing", 500);
  set("jing", 500);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 30);
  set("combat_exp", 250000);
  set("score", 20000);
  set_skill("force", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("staff", 200);
  set_skill("hamagong", 200);
  set_skill("sword", 200);
  set_skill("killsword", 200);
  set_skill("chanchu-bufa", 200);
  set_skill("lingshe-zhangfa", 200);
  set_skill("shexing-diaoshou", 200);
  map_skill("force", "hamagong");
  map_skill("dodge", "chanchu-bufa");
  map_skill("parry", "lingshe-zhangfa");
  map_skill("sword", "killsword");
  map_skill("unarmed", "shexing-diaoshou");
  map_skill("staff", "lingshe-zhangfa");
  create_family("白驼山派", 3, "弟子");
  set("chat_chance", 2);
  set("chat_msg", ({
    "白驼使者说道: 勤学苦练才是练功之本..\n",
    "白驼使者鼓励小弟兄们不畏艰难，好好练功。\n",
    "白驼使者亲切的拍拍你的头说：好样的！\n",
  }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if ((string)ob->query("family/family_name") == "白驼山派") {
    message_vision("白驼使者冲着$N点点头，慈祥的笑着。\n", ob);
    return;
  }
  if (!(string)ob->query("family/family_name")) {
    message_vision("白驼使者冲着$N微笑说：你是新来的吧，想入白驼就拜(bai)我吧。\n", ob);
    return;
  }
  message_vision("白驼使者对$N说道:小家伙,你转悠什么呢?\n", ob);
}
void attempt_apprentice(object ob) {
  command("say 小兄弟，欢迎你加入白驼山派,努力练功吧。\n");
  command("recruit " + ob->query("id"));
  if ((int)ob->query("combat_exp") < 1)
    command("say 你先去多积攒点经验吧。\n");
  return;
}
int accept_fight(object ob) {
  if ((string)ob->query("family/family_name") == "白驼山派") {
    if ((int)ob->query("combat_exp") < 1000)
      return notify_fail("白驼使者笑道：你的经验太低了，还是先去多积攒点经验吧！\n");
  }
  return 1;
}
