#include <ansi.h>
inherit NPC;

void create()
{
        set_name("峨嵋使者", ({ "em shizhe", "em", "shizhe" }));
        set("title", "峨嵋派接引使");
        set("long",
      "这是峨嵋派的接引使，拜(bai)她后可以成为俗家弟子，日后可上山剃度出家。\n");
        set("gender", "女性");
        set("age", 28);
        set("attitude", "friendly");
        set("shen_type", 1);
        set("str", 21);
        set("int", 21);
        set("con", 23);
        set("dex", 20);

        set("qi", 650);
        set("max_qi", 650);
        set("jing", 400);
        set("max_jing", 400);
        set("neili", 500);
        set("max_neili", 500);

        set("combat_exp", 200000);
      
        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("sword", 200);
        set_skill("huifeng-jian", 200);
        set_skill("zhutian-bu", 200);
        set_skill("linji-zhuang", 200);
        map_skill("dodge","zhutian-bu");
        map_skill("parry", "huifeng-jian");
        map_skill("sword", "huifeng-jian");
        map_skill("force","linji-zhuang");  
      
        create_family("峨嵋派", 6, "弟子");
        setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
  }
#include "/u/swordman/newbie/npc/sujia.h"
