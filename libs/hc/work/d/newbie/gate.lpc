// /d/newbie/gate.c 新手区大门
// by swordman 2001/3/26

inherit ROOM;

void create() {
  set("short", "新手校场");
  set("long", @LONG
这里是新手校场的大门，是新手们初入红尘的第一站
"永不服输"四个大字十分醒目，相传这是当年的"江湖豪侠
"绝尘的手笔。它在激励着新一代的侠客们勇往直前。
LONG
  );

  set("exits", ([
    "west": __DIR__ "zlang1",
    "east": "/d/village/hsroad1",
  ]));

  set("valid_startroom", "1");
  set("no_magic", 1);
  set("no_fight", 1);
  set("objects", ([ __DIR__ "npc/guard": 4,
  ]));
  set("outdoors", "newbie");
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "west" && this_player()->query("mud_age") > 345600)
    return notify_fail("你已经可以独自行走江湖了，不必再到这里来了。\n");
  return ::valid_leave(me, dir);
}
