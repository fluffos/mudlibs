inherit ROOM;

void create() {
  set("short", HIG "华山接引室");
  set("long",
    "华山乃五岳之一，其壮美无人不晓，华山派历来
以剑术闻名，此次岳不群派下得意弟子来接引新人，
不知哪位又将入到华山门下了。\n"
  );
  set("exits", ([
    "west": __DIR__ "wdroom",
    "north": __DIR__ "zlang2",
    "east": __DIR__ "btroom",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/hssz": 1,
  ]));
  set("outdoors", "newbie");
  setup();
}
