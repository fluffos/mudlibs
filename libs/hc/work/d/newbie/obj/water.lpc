// water.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("泉水壶", ({ "water hu", "hu" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个用来装山泉的壶。\n");
    set("unit", "个");
    set("value", 300);
    set("max_liquid", 10);
  }

  set("liquid", ([
    "type": "water",
    "name": "清水",
    "remaining": 10,
    "drunk_supply": 5,
  ]));
}
