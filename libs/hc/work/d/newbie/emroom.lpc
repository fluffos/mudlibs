// /d/newbie/emroom.c 娥眉接引室
// by swordman 2001/3/27

inherit ROOM;

void create() {
  set("short", HIG "峨嵋接引室");
  set("long",
    "这里是峨嵋的接引室，峨嵋是武林中呵呵有名的
一大门派，对门下弟子的要求也是十分严格的，这次派
遣使者到山下来招募弟子同时传授部分的入门武功。\n"
  );
  set("exits", ([
    "west": __DIR__ "ljroom",
    "south": __DIR__ "zlang1",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/emsz": 1,
  ]));
  set("outdoors", "newbie");
  setup();
}
