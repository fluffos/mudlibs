// by swordman 2001/3/27


inherit ROOM;
void create() {
  set("short", HIG "灵鹫接引室");
  set("long",
    "灵鹫宫乃是逍遥派天山童姥所创，当年虚竹误打
误装居然做了灵鹫宫的主人，可说是机缘巧合，这次由
童姥亲自下令接引使下山引见新人入门，可说是用心良
苦。另外，灵鹫宫只收女弟子。也是一个特色。\n"
  );
  set("exits", ([
    "west": __DIR__ "xxroom",
    "south": __DIR__ "zlang2",
    "east": __DIR__ "emroom",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/ljsz": 1,
  ]));
  set("outdoors", "newbie");
  setup();
}
