inherit ROOM;

void create()
{
set("short",HIG"逍遥接引室");
        set("long",
"逍遥派是闻名的新手门派，大多数的新手都拜入此
派之中，也是因为这样，逍遥得以昌盛，其门人遍及天
下各个角落，此次的接引使也是苏星河为了新人们方便
入门而设立的，这里会有部分基本功传授。\n"
);
        set("exits",([ 
                "east":__DIR__"wdroom",
                "north":__DIR__"zlang4",
 ]));
        set("no_clean_up", 0);
    set("objects", ([
                __DIR__"npc/xysz" : 1,
    ]));
    set("outdoors","newbie");
    setup();
}
