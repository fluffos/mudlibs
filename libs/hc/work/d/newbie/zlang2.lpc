// /d/newbie/zlang1.c 走廊一
// by swordman 2001/3/26

inherit ROOM;

void create() {
  set("short", HIW "校场走廊二");
  set("long",
    "这是新手校场的走廊，地上铺着朴素的青面砖，
一些新人在这里来往穿梭。往南是" HIW "华山派" NOR "的接引室，
而北面则是" HIC "灵鹫宫" NOR "的接引室,接着望西过去的话，是
校场走廊三，可以去别的门派的接引室。" NOR "\n"
  );
  set("exits", ([
    "west": __DIR__ "zlang3",
    "east": __DIR__ "zlang1",
    "north": __DIR__ "ljroom",
    "south": __DIR__ "hsroom" ]));
  set("no_clean_up", 0);
  set("outdoors", "newbie");
  setup();
}
