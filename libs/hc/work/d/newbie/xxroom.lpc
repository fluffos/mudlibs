inherit ROOM;

void create() {
  set("short", HIG "星宿接引室");
  set("long",
    "星宿派是江湖中公认的邪派，可说其武功毒辣之极，
此次丁老怪派下了接引使，誓要广大他这个被人唾骂的
破门派，实在是够阴险...\n"
  );
  set("exits", ([
    "west": __DIR__ "throom",
    "south": __DIR__ "zlang3",
    "east": __DIR__ "ljroom",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/xxsz": 1,
  ]));
  set("outdoors", "newbie");
  setup();
}
