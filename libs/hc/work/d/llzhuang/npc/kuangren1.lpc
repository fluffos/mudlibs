#include <ansi.h>
inherit NPC;
#include <random_name.h>
void create() {
  string name, nickname;
  name = comm_man_name();
  nickname = comm_man_nick();
  set_name(name, ({ "kuang ren" }));
  set("nickname", nickname);
  set("long", @LONG
他眼神凶狠无比，狠狠瞪视着你。
LONG
  );
  set("max_jing", 57000);
  set("max_qi", 27000);
  set("max_sen", 27000);
  set("max_neili", 27000);
  set("neili", 27000);
  set("jiali", 2000);
  set("combat_exp", 15800000);
  set("cor", 150);
  set("age", 65);
  set_skill("pixie-shenjian", 820);
  set_skill("force", 1500);
  set_skill("hamagong", 1200);
  set_skill("dodge", 880);
  set_skill("unarmed", 850);
  set_skill("xingxiu-duzhang", 800);
  set_skill("parry", 850);
  set_skill("zhaixinggong", 800);
  set_skill("tianshan-zhang", 815);
  map_skill("force", "hamagong");
  map_skill("dodge", "zhaixinggong");
  map_skill("unarmed", "xingxiu-duzhang");
  map_skill("parry", "pixie-shenjian");
  map_skill("sword", "pixie-shenjian");
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
  }));

  setup();
  carry_object("/clone/weapon/changjian")->wield();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}
