#include <weapon.h>
#include <ansi.h>
inherit HAMMER;
void create()
{
        set_name(HIG  "千年温玉" NOR, ({ "old jade" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);   else {
                set("unit", "块");
                set("long", "一块醉人的玉石，绿得醉人呀．．．\n");
                set("max_cure",10);
                set("material", "stone");
            set("no_give", 1);
            set("no_put", "省省吧，这个东西可放不进去！\n");
        }
        init_hammer(10);
        setup();
}

