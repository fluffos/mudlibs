#include <ansi.h>
inherit ITEM;
void create() {
  set_name(CYN "指环儿" NOR, ({ "zhihuan" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("material", "stone");
    set("long", "一个小巧的指环儿\n");
    set("no_give", 1);
    set("no_put", "省省吧，这个东西可放不进去！\n");

  }

  setup();
}
