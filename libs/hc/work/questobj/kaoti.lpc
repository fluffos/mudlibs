#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIW"葵花宝卷" NOR, ({ "kuihua-baojuan" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "卷");
            set("material", "paper");
            set("long", "一卷武林秘籍。\n");
            set("no_give", 1);
            set("no_put", "省省吧，这个东西可放不进去！\n");

          }

    setup();
}

