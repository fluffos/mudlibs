#include <armor.h>
inherit CLOTH;
#include <ansi.h>
void create() {
  set_name(HIR "紫荆道袍" NOR, ({ "daopao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件金边淡红道袍\n");
    set("material", "cloth");
    set("no_give", 1);
    set("no_put", "省省吧，这个东西可放不进去！\n");

  }
  setup();
}
