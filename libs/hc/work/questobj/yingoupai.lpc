#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIW "银钩牌" NOR, ({ "yingoupai" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("material", "stone");
    set("long", "银钩牌\n");
    set("no_give", 1);
    set("no_put", "省省吧，这个东西可放不进去！\n");
  }

  setup();
}
