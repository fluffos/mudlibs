//xuejia.c
#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_xi", "xi");
}
void create() {
  set_name(YEL "雪茄" NOR, ({ "xuejia" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一根棕色的古巴雪茄，由冷雾从百货商店里偷来的。
冷雾偷一次东西可不容易，而且一根雪茄可以抽好久的，
所以请你要省着点抽哦！\n");
    set("value", 50000);
  }
  setup();
}

int do_xi(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吸什么？\n");

  message_vision(HIR "$N使劲的吸了一口雪茄，顿时整个空间充满了浓浓的烟味！\n" NOR, me);

  return 1;
}
