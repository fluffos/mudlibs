#include <ansi.h>
inherit ITEM;
void create() {
  set_name(BLU "祗祯语录" NOR, ({ "qizhen-yulu" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("material", "paper");
    set("long", "一本祗祯语录。\n");
    set("no_give", 1);
    set("no_put", "省省吧，这个东西可放不进去！\n");

  }

  setup();
}
