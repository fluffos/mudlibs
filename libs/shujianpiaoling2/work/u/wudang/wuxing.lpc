#include <room.h>

inherit ROOM;

void create()
{
        set("short", "花园");
        set("long", @LONG
这里是一个种满各种鲜花的花园。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
  "west" :__DIR__"dhyuan",
]));
	 set("objects", ([
		__DIR__"npc/jindaoren": 1,
		__DIR__"npc/mudaoren": 1,
		__DIR__"npc/shuidaoren": 1,
		__DIR__"npc/huodaoren": 1,
		__DIR__"npc/tudaoren": 1,
]));
        set("outdoors", "wudang");
        setup();
}
int valid_leave(object me, string dir)
{
        if ( me->query_temp("wudang/jianzhen") )
	me->delete_temp("wudang/jianzhen");
	return ::valid_leave(me, dir);
}


