
inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("茶杯", ({ "tea cup", "tea","cup" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个用景德镇产的通花茶杯。\n");
		set("unit", "个");
		set("value", 0);
		set("max_liquid", 5);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "tea",
		"name": "香茶",
		"remaining": 15,
		"drunk_apply": 6,
	]) );
}
