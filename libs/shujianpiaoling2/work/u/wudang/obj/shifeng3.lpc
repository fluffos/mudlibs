inherit ITEM;

void create() {
  set_name("石缝", ({ "hole", "石缝", "岩石" }));
  set_weight(500);
  set_max_encumbrance(8000);
  set("no_get", 1);
  set("no_shown", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "丛");
    set("long", "一条在岩石上的石缝。\n");
    set("value", 1);
  }
}

int is_container() { return 1; }
