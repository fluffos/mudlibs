
inherit ITEM;

void create()
{
	set_name("绿荫", ({ "grass" , "绿荫"}) );
	set_weight(500);
	set_max_encumbrance(8000);
	set("no_get", 1);
	set("no_shown", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "丛");
		set("long", "一堆厚厚的铺满地的绿荫。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }

