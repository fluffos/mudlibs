// tyroad12.c 桃园小路
// by baiwt@sjpl 
#include <ansi.h>
inherit ROOM;
int do_plant(string arg);
int complete_plant(object me);

void create()
{
	set("short", "桃园小路");
	set("long", @LONG
	眼前豁然开朗，你轻松地走在桃园边的小路上。路上落英缤纷，两边是桃树林，
盛开着粉红的桃花，红云一片，望不到边。还可以看蜜蜂「嗡嗡」地在花间飞上飞
下忙个不停，间或传来猿猴的叽咋声。
LONG
	);
	set("outdoors", "wudang");

	set("exits", ([
		"south" : __DIR__"tyroad10",
	]));
	set("no_fight", 1);
	set("hell", 1);
	set("no_study", 1);
	set("no_magic", 1);
	set("no_spells", 1);
	
	setup();
}
void init()
{	object ob;
	if( interactive( ob = this_player()))
	call_out("complete_plant", random(10) + 3, ob);
	add_action("do_plant", "plant");
	add_action("close_cmds", "fight");
	add_action("close_cmds", "exert");
	add_action("close_cmds", "perform");
}
int close_cmds(object me, string arg)
{
	return 1;
}

int do_plant(string arg)
{
  object me=this_player(); 
	if( arg != "peach")
        return notify_fail("你要种什么？\n");
  if(me->query("marks/wdjob")!="peach")
        return notify_fail("你并没有种栽桃树的任务。\n");
  if(me->query_temp("plant_peach")>20)
        return notify_fail("你的工作已经完成了。\n");
  if(me->is_busy())
        return notify_fail("你正忙着呢。\n");
  if(me->query("sen") < 22)
        return notify_fail("你心神不定，无法静下心来种栽桃树。\n");
  if(!me->query_temp("plant_peach"))
  message_vision(CYN"$N用铲子翻了翻土，挖好了坑，把树苗埋了进去。\n"NOR,me);
  else
  message_vision(CYN"$N把泥土盖上了树根，浇了些水，又往桃林深处走了几步，继续载种。\n
$N用铲子翻了翻土，挖好了坑，把树苗埋了进去。\n"NOR,me);
  me->start_busy(6);  
  me->receive_damage("sen", random(20)+1);
  if( me->query_skill("unarmed",1) < 20 )
  {
  me->improve_skill("unarmed",random((int)me->query("kar"))+10);
  me->add("potential",1);
  }
  me->add("life_exp",random(10)+1);
  me->set_temp("plant_now", 1);
  return 1;
}  
int complete_plant(object ob)
{
	int i;
	int damage;
	object peach;
	if( !ob ) return 0;
	if( !ob->query_temp("plant_now")) 
	{
	call_out("complete_plant",random(20)+1, ob);	
	return 0;
	}
        if(  ob->query_temp("plant_peach") < 20 && environment(ob) == this_object())
	{
	tell_object(this_object(), "\n四周的桃树在微风吹拂下轻轻摇曳，成熟了的桃花绚丽多彩，煞是好看。\n");
	ob->add_temp("plant_peach", 1);
	if( environment(ob) == this_object())
	call_out("complete_plant",random(20)+1, ob);	
	}
	else
	{
	ob->remove_call_out("complete_plant");
	tell_object(this_object(), CYN"\n你看着自己在桃林前种下的那排新的树苗，然后欣慰地笑了。\n\n"NOR);
	peach = new("/obj/food/peach");
	peach->move(ob);
	ob->delete_temp("plant_peach");
	ob->delete_temp("plant_now");
	ob->delete("marks/wdjob");
	}
	return 1;
}
int valid_leave(object me,string dir)
{
	object ob;
       if( me->query_temp("plant_now") )
	      return notify_fail("你的种栽工作还没有做完，怎么就离开了呢？\n");
        return ::valid_leave(me,dir);
}

