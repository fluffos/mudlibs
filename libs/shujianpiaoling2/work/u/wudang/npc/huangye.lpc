inherit NPC;
inherit F_MASTER;

void create() {
  set_name("黄叶道人", ({ "master huangye", "huangye", "master" }));
  set("gender", "男性");
  set("age", 60);
  set("long",
    "黄叶道长是宁静的二弟子，宁静让他负责守卫藏经阁如此重要地方，可见他\n"
    "在武当中地位之高。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的武当山。",
  ]));
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("class", "wudang");

  set("max_kee", 1800);
  set("max_gin", 1800);
  set("max_sen", 1800);
  set("kee", 1800);
  set("gin", 1800);
  set("sen", 1800);

  set("force", 1800);
  set("max_force", 1800);
  set("force_factor", 30);

  set("combat_exp", 6000000);
  set("score", 30000);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("move", 120);
  set_skill("dodge", 120);
  set_skill("literate", 130);
  set_skill("unarmed", 180);
  set_skill("parry", 150);
  set_skill("force", 140);
  set_skill("sword", 130);

  set_skill("taiji-sword", 130);
  set_skill("taiji-ken", 180);
  set_skill("taiji-force", 130);
  set_skill("tiyunzong", 120);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.nian" :),
    (: perform_action, "unarmed.luanhuan" :),
  }));
  create_family("武当派", 5, "弟子");

  setup();

  //        carry_object(__DIR__"obj/youlong_sword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "wudang") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("taiji-force", 1) < 100) {
    command("say 你的太极神功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("taiji-ken", 1) < 100) {
    command("say 你的太极拳修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "wudang");
  ob->set("id_type", 1);
}
