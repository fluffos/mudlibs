inherit NPC;
inherit F_MASTER;
string summon_more(object who);

void create() {
  set_name("白石道人", ({ "master baishi", "baishi", "master" }));
  set("gender", "男性");
  set("age", 55);
  set("long",
    "白石道长是宁静的三弟子，负责守卫武当的内殿，防止外派闯入武当闹事。\n"
    "以他的武功修为，在武林中已经享有很高的威望。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的武当山。",
  ]));
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("class", "wudang");

  set("max_kee", 1600);
  set("max_gin", 1600);
  set("max_sen", 1600);
  set("kee", 1600);
  set("gin", 1600);
  set("sen", 1600);

  set("force", 1600);
  set("max_force", 1600);
  set("force_factor", 30);

  set("combat_exp", 5000000);
  set("score", 30000);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("move", 150);
  set_skill("dodge", 180);
  set_skill("literate", 100);
  set_skill("unarmed", 110);
  set_skill("parry", 120);
  set_skill("force", 130);
  set_skill("sword", 110);

  set_skill("taiji-sword", 110);
  set_skill("taiji-ken", 110);
  set_skill("taiji-force", 120);
  set_skill("tiyunzong", 180);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.tianti" :),
    (: perform_action, "sword.fengbi" :),
    (: summon_more(this_object()) :),
  }));

  create_family("武当派", 5, "弟子");

  setup();

  carry_object("obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "wudang") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("taiji-force", 1) < 90) {
    command("say 你的太极神功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("tiyunzong", 1) < 100) {
    command("say 你的本门轻功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "wudang");
  ob->set("id_type", 1);
}
string summon_more(object who) {
  int i;
  object *enemy;
  object another;
  seteuid(getuid());
  another = new(__DIR__ "wddizi2");
  if ((int)who->query_temp("summon_more") > 2) return "　";
  another->move(environment(who));
  message_vision(another->name() + "走了过来。\n"
    , this_object());
  who->add_temp("summon_more", 1);
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      another->kill_ob(enemy[i]);
      enemy[i]->kill_ob(another);
      another->set_leader(enemy[i]);
    }
  }
  return "1";
}
int accept_fight(object me) {
  command("say 不要在这里惹是生非。");
  return 0;
}
