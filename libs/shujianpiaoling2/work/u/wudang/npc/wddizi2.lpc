#include <ansi.h>

inherit NPC;
void create()
{

	set_name("武当弟子", ({ "wudang dizi", "dizi" }) );
	set("long", "这是一位武当弟子，专门担任保护之责。\n");
	set("attitude", "friendly");
	set("max_atman", 100);
	set("atman", 100);
	set("max_mana", 100);
	set("mana", 100);

	set("str", 40);
	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 90000);
	set_skill("sword", 90);
	set_skill("parry", 90);
	set_skill("dodge", 90);
	set_skill("unarmed", 90);
	set_skill("force", 90);

	set_skill("tiyunzong", 50);
	set_skill("taiji-ken", 50);
	set_skill("taiji-sword", 50);
	set_skill("taiji-force", 50);

        map_skill("force", "taiji-force");
        map_skill("unarmed", "taiji-ken");
        map_skill("dodge", "tiyunzong");
        map_skill("parry", "taiji-sword");
        map_skill("sword", "taiji-sword");
	setup();
        carry_object("/obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}
int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	destruct(this_object());
}

