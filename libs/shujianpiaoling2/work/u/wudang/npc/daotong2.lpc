inherit NPC;

void create() {
  set_name("男道童", ({ "daotong" }));
  set("title", "武当派");
  set("gender", "男性");
  set("age", 16);
  set("long",
    "一个皮肤稍黑的小男孩，脸上还带着几分淘气。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的武当山。",
  ]));
  set("attitude", "peaceful");
  set("str", 26);
  set("int", 22);
  set("spi", 25);
  set("per", 23);
  set("cps", 23);
  set("water", 300);
  set("food", 300);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 1);
  set("combat_exp", 500 + random(500));

  set_skill("unarmed", 20);
  set_skill("sword", 20);
  set_skill("force", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);

  set_skill("taiji-ken", 20);
  set_skill("taiji-force", 20);

  map_skill("unarmed", "taiji-ken");
  map_skill("force", "taiji-force");

  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();

  carry_object(__DIR__ "obj/wood_sword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}
