// pi-armor.c

#include <armor.h>

inherit ARMOR;

void create()
{
	set_name("牛皮软甲", ({ "pi-armor", "armor" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一件有牛皮缝制的软甲，有一定的防御力。\n");
		set("unit", "件");
		set("value", 500);
		set("material", "cloth");
		set("armor_prop/armor", 20);
		set("armor_prop/personality", 3);
	}
	setup();
}

