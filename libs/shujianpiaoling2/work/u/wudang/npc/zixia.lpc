inherit NPC;
inherit F_MASTER;

void create() {
  set_name("紫霞道人", ({ "master zixia", "zixia", "master" }));
  set("gender", "男性");
  set("age", 66);
  set("long",
    "紫霞道长是宁静的大弟子，负责守卫武当的外殿，防止外派闯入武当闹事。\n"
    "以他的武功修为，在武林中已经享有很高的威望。\n");
  set("inquiry", ([
    "here": "这里就是武当派。",
  ]));
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("class", "wudang");

  set("max_kee", 1800);
  set("max_gin", 1800);
  set("max_sen", 1800);
  set("kee", 1800);
  set("gin", 1800);
  set("sen", 1800);

  set("force", 1800);
  set("max_force", 1800);
  set("force_factor", 20);

  set("combat_exp", 7000000);
  set("score", 30000);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("move", 130);
  set_skill("dodge", 130);
  set_skill("literate", 160);
  set_skill("unarmed", 130);
  set_skill("parry", 160);
  set_skill("force", 160);
  set_skill("sword", 180);

  set_skill("taiji-sword", 180);
  set_skill("taiji-ken", 130);
  set_skill("taiji-force", 160);
  set_skill("tiyunzong", 130);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.fengbi" :),
  }));
  create_family("武当派", 5, "弟子");

  setup();

  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "wudang") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("taiji-force", 1) < 100) {
    command("say 你的太极神功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("taiji-sword", 1) < 100) {
    command("say 你的太极剑法修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }

  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "wudang");
  ob->set("id_type", 1);
}
