#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_baohu();
void create() {
  set_name("静因师太", ({ "master jingyin", "jingyin", "master" }));
  set("title", "武当派掌门师姐");
  set("gender", "女性");
  set("age", 76);
  //	set("nickname", HIG "" NOR);
  set("long",
    "静因师太是掌门人宁静真人的师姐，因不好武林恩怨，已退隐江湖。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 7000000);
  set("score", 40000);

  set_skill("move", 210);
  set_skill("dodge", 210);
  set_skill("literate", 180);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("force", 200);
  set_skill("sword", 200);

  set_skill("taiji-sword", 200);
  set_skill("taiji-ken", 200);
  set_skill("taiji-force", 200);
  set_skill("tiyunzong", 200);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.fengbi" :),
  }));
  set("inquiry", ([
    "随行": (: about_baohu :),
  ]));

  create_family("武当派", 4, "掌门师姐");
  set("class", "wudang");

  setup();
  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("gender") != "女性") {
    command("say 贫身向来不收男弟子。\n");
    return;
  }

  if (ob->query_skill("taiji-sword", 1) < 150) {
    command("say 本门乃三大剑派之一，主修剑法，你剑术修为尚浅，还是再多下点功夫吧！\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "wudang");
  ob->set("id_type", 1);
}

int about_baohu() {
  object me, soldier;
  object *t;
  me = this_player();
  if (me->query("class") != "wudang") {
    command("say 对不起，你不是武当弟子！\n");
    return 1;
  }

  if (pointerp(t = me->query_team())) {
    command("say 已经有师兄弟保护你了，好自为之！\n");
    return 1;
  }
  command("say 好吧，我让你的师兄弟与你同行。\n");
  message_vision(CYN "\n从门外走进来一名武当弟子，躬身说道：师父请吩咐！\n" NOR, me);
  message_vision(HIM "\n静因师太说道：武当弟子保护$N一起下山吧！\n" NOR, me);
  message_vision(CYN "\n武当弟子躬身说道：谨遵师命！\n" NOR, me);
  soldier = new(__DIR__ "wddizi.lpc");
  soldier->move(environment(me));
  me->add_team_member(soldier);
  soldier->add_team_member(me);
  soldier->set_leader(me);
  soldier->set("possessed", me);
  return 1;
}
