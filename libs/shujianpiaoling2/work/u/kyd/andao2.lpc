
#include <room.h>
inherit ROOM;




void create()
{
	set("short", "暗道");
	set("long", @LONG
这是一个阴暗潮湿的地道，四壁用粗糙的片岩垒垛而成，一
颗颗水珠沿着墙壁滚下来，溅在地上。也许是因为长时间无人通
行的缘故，整个地道弥漫着一股腐尸般的恶臭。不远处，一道瀑
布挡住了去路。
LONG
	);

	set("exits", ([
		"north" : __DIR__"andao2",
	]));

//	set("objects",([
//		__DIR__"npc/ad-laoshu" : 1,
//	]));
	setup();
	
}

void init()
{          
            add_action("do_jump", "jump");
       add_action("do_jump", "tiao");
}

int do_jump(string arg)
{ 
        mapping fam;
        object me = this_player();
        int dex = me->query("dex");
  
     if ( !living(me) ) return 0;
   
        if( !arg || arg=="" || arg !="瀑布" ) return 0;
        me->add_temp("mark/jump",1);
   	 if ((int)me->query_skill("force", 1) < 90 || (int)me->query_skill("dodge", 1) < 90  ) 
		{            message_vision ("$N纵身向瀑布外冲去，刚到一半，就受到瀑布的强大压力，一下子又被弹了回来。\n" ,me);	
		   	message_vision ("$N蹬，蹬，蹬连退三步，仰天摔在了地上。\n" ,me);	
			this_player()->unconcious();
			return 1;
		}	
        message("vision",
               me->name() + "涌身往瀑布外跳落。\n",
               environment(me), ({me}) );
        write("你纵身向瀑布冲了过去。\n");
        me->move(__DIR__"gaoguanpubu");
	return 1;

}    




