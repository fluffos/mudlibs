void init()
{          
            add_action("do_jump", "jump");
       add_action("do_jump", "tiao");
}

int do_jump(string arg)
{ 
        mapping fam;
        object me = this_player();
        int dex = me->query("dex");
  
     if ( !living(me) ) return 0;
   
        if( !arg || arg=="" || arg !="down" ) return 0;
        me->add_temp("mark/jump",1);
   
        message("vision",
               me->name() + "眼睛一闭，纵身从奈何桥上跳了下去。\n",
               environment(me), ({me}) );
        write("你一闭眼, 纵身跳下无底深隙。\n");
        me->move(__DIR__"bankongzhong3");
	return 1;
}    


