#include <ansi.h>
#include <combat.h>
inherit SSERVER;


#include "/daemon/condition/eff_msg.lpc";
 
int perform(object me, object target)
{       
        string msg;
        int damage, p;

        if( !target ) target = offensive_target(me);
 
         if( !target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail("「阳关三叠」只能在战斗中使用。\n");
        
        if( objectp( me->query_temp("weapon")) )
                return notify_fail("只有空手才能施展「阳关三叠」。\n");

        if( (int)me->query_skill("yiyang-zhi", 1) < 100 ||
            (int)me->query_skill("unarmed", 1) < 100 ||
            (int)me->query_str() < 25)
                return notify_fail("你有的功夫还不够娴熟，不会使用「阳关三叠」。\n");

           if(me->query_skill("liumai_force", 1) <100)
                return notify_fail("以你现在的内功修为还使不出「阳关三叠」。\n");        

        if (me->query_skill_prepared("unarmed") != "yiyang-zhi" || 
            me->query_skill_mapped("unarmed") != "yiyang-zhi" ||
            me->query_skill_mapped("parry") != "yiyang-zhi")
                return notify_fail("你现在无法使用「阳关三叠」进行攻击。\n");                                                                                 
      

        if( (int)me->query("max_force") < 1500 )
                return notify_fail("你的内力太弱，不能使用「阳关三叠」！\n");
        
        if( (int)me->query("force") < 310 )
                return notify_fail("你的真气不够！\n");
//modified bye cool for jinzhong_zhao
   if (me->query("yd_2")&&(target->query_skill_mapped("force") == "jinzhong_zhao"||target->query_skill_mapped("strike") == "jinzhong_zhao"))
        {
        msg = YEL "\n$N背向$n，凝气于指，一式「阳关三叠」反手缓缓点出，纯阳指力直袭$n胸口！\n" NOR;
         if (random(me->query_skill("force")) > target->query_skill("force") /3 )
        {
                me->start_busy(1);
                target->start_busy(1);
                damage = (int)me->query_skill("yiyang-zhi", 1);
                damage = (int)me->query_skill("liumai_force", 1) +damage;
                damage = damage + random(damage/2);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);               
                me->add("force", -300);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += HIR "$n一见之下，大为失色，发现似乎正是自己的克星！\n"NOR;   
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
                if(me->query_skill("yiyang-zhi", 1) > 139)
                call_out("perform4", 0, me, target);
        } else 
        {       me->start_busy(3);
                me->add("kee", -100); 
                target->start_busy(1);               
                msg += HIY"这反手点穴似乎正是金钟罩功的克星，$p识得厉害，危及之中一个铁板桥，上身向后一倒，艰难的躲过这一招。\n"NOR;
          }
        }else{
         msg = YEL "\n$N凝气于指，一式「阳关三叠」点出，但听得嗤嗤声响，一股纯阳的内力直袭$n胸口！\n" NOR;
         if (random(me->query("combat_exp")) > target->query("combat_exp")/2 )
        {
                me->start_busy(1);
                target->start_busy(1);
                damage = (int)me->query_skill("yiyang-zhi", 1);
                damage = (int)me->query_skill("liumai_force", 1) +damage;
                damage = damage + random(damage/2);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/3);               
                me->add("force", -250);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
                if(me->query_skill("yiyang-zhi", 1) > 119)
                call_out("perform2", 0, me, target);    
        } else 
        {       me->start_busy(3);
                me->add("kee", -100);                
                msg += HIY"可是$p一个巧云翻身，远远的躲了开去。\n"NOR;
        }
        }         
        message_vision(msg, me, target);
        return 1;
}

int perform2(object me, object target)
{
        string msg;

        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");  

        if( (int)me->query("force", 1) < 500 )
                return notify_fail("你待要再出第二指，却发现自己的内力不够了！\n");     
       
        msg = YEL "\n接着$N踏前一步，出第二指隔空点向$n胸前“玉堂穴”，认穴竟无厘毫之差！\n"NOR;        
        if (random(me->query_skill("dodge")) > target->query_skill("dodge") / 2)
        {                
                msg += HIR "结果一指点中，$n只觉得全身气脉通道阻塞，真气立受干挠！\n"NOR;   
                me->start_busy(1);
                target->start_busy(me->query_skill("force")/30);
                me->add("force", -200);
                if((int)me->query_skill("yiyang-zhi", 1) > 140)
                  call_out("perform3", 0, me, target);    
        } else 
        {
           me->start_busy(4);
           me->add("force", -200);
           target->add("force", -200);
           msg += HIY"\n$p眼看逼无可逼，便也一指点去，两根指尖相碰，$p顺势跳了开去。\n" NOR;
        }
        message_vision(msg, me, target);
        return 1;
}

int perform3(object me, object target)
{
        int skill;
        string msg;
        skill = (int)me->query_skill("yiyang-zhi", 1);                
        skill = skill/15;
       
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("force", 1) < 300 )
                return notify_fail("你待要再出第三指，却发现自己的内力不够了！\n");     

        msg = YEL "\n紧跟着$N一阳指第三次点出，以纯阳内力，同时透入$n体内任脉紫宫穴、
阴维脉大横穴、冲脉幽门穴、带脉章门穴和阴跤脉晴明穴！\n"NOR;        
        if (random(me->query_skill("force")) > target->query_skill("force") / 2)
        {                
                me->add("neili", -300);
                msg += HIR "$n只觉体内奇经八脉中内息为之一怠，全身气力竟然提不起来了！\n" NOR;
                target->add_temp("apply/attack", -100);
                target->add_temp("apply/dodge", -100);
                target->add_temp("apply/parry", -100);  
                target->add("force", -500);                 
                call_out("back", 3 + skill, target);
                                
        } else 
        {
                me->start_busy(me->query_skill("force")/30);
                me->add("force", -250);
                target->start_busy(2);
                msg += HIY"\n$p喘息未定，见$P指力如狂风般点来，连忙又跃开数尺，狼狈地避开。\n" NOR;
        }
        message_vision(msg, me, target);

        return 1;
}
int perform4(object me, object target)
{
        string msg;
        int damage, p;

        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");  

        if( (int)me->query("force", 1) < 500 )
                return notify_fail("你待要再出第二指，却发现自己的内力不够了！\n");     
       
        msg = YEL "\n接着$N背向$n，倒退而行，出指极慢，隔空点向$n的腰部带脉八穴，认穴竟无厘毫之差！\n"NOR;        
        if (random(me->query_skill("yiyang-zhi")) > target->query_skill("jinzhong_zhao") / 2)
               {
                msg += HIR "结果$n一声闷哼，被点中正着，只觉得全身真气涣散，气脉阻塞！\n"NOR;   
                me->start_busy(1);
                target->start_busy(me->query_skill("force")/50);
                damage = (int)me->query_skill("yiyang-zhi", 1);
                damage = (int)me->query_skill("liumai_force", 1) +damage;
                damage = damage + random(damage);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage);
                me->add("force", -200);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
               if((int)me->query_skill("yiyang-zhi", 1) > 149&&(int)me->query_skill("liumai_force", 1) > 100)
               {     
               call_out("perform5", 0, me, target);
          }   
        } else 
        {
           me->start_busy(4);
           me->add("force", -200);
           target->add("force", -200);
           msg += HIY"\n$p眼看无处可躲，便一掌拍去，指掌相触，$p顺势跳了开去。\n" NOR;
        }
        message_vision(msg, me, target);
        return 1;
}
int perform5(object me, object target)
{
        int skill;
        string msg;
              
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("force", 1) < 800 )
                return notify_fail("你待要再出第三指，却发现自己的内力不够了！\n");     
       
        msg = YEL "\n只见$N出手更加缓慢，突然向后凌空一翻，飞跃而起，反手一指点向$n的眉心。！\n"NOR;        
        if (random(me->query_skill("liumai_force")) > target->query_skill("jinzhong_zhao") / 3)
        {                
                msg += HIR "$n大惊之下不及运功防御，被$N一指击中眉心，只觉体内虚空，被先天功加上一阳指力给破了这蛤蟆神功。\n"NOR;   
                me->add("force", -500);
                target->apply_condition("hama_po",random(50)+50);
                target->add_temp("apply/attack", -100);
                target->add_temp("apply/dodge", -100);
                target->add_temp("apply/parry", -100);  
                target->add("force", -500);                 
                call_out("back", 3 + skill, target);
        } else 
        {
                me->start_busy(me->query_skill("force")/30);
                me->add("force", -250);
                target->start_busy(2);
                msg += HIY"\n$p喘息未定，见$N凌空下击，眼见无法抵挡，急忙就地一滚避开。\n" NOR;
        }
        message_vision(msg, me, target);
        return 1;
}



void back(object target)
{
        target->add_temp("apply/attack", 100);
        target->add_temp("apply/dodge", 100);
        target->add_temp("apply/parry", 100);
}