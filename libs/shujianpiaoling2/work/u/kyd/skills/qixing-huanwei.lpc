// shaolin-step.c

inherit SKILL;

string *dodge_msg = ({
   "$n一式「摇光移步」，前后脚脚尖脚跟相靠，身体如行云流水般滑出丈余。\n",
 "$n一式「天璇掠波」，双臂前伸，全身贴地平飞，顿时闪过了$N的凌厉攻势。\n",
 "$n一式「天玑换形」，足不动，手不抬，一转眼间便绕到了$N的身后。\n",
 "$n一式「开阳分身」，一转身间，四面八方飘动着无数个$n的身影，令$N手无足措。\n",
  "$n一式「玉衡落日」，全身笔直，拔地而起，在半空中一转，已落到几丈远的地方。\n",
 "$n一式「天权双飞」，两臂鹏举如翼，在剌剌风声中，从$N头顶横跃而过。\n",
 "$n一式「天枢出水」，双脚点地，全身化为一道白影，急速绕着$N打了几转。\n",
});

int valid_enable(string usage)
{
	return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
	if( (int)me->query("max_force") < 50 )
        return notify_fail("你的内力不够，没有办法练七星换位。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
        return notify_fail("你的气或内力不够，不能练七星换位。\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	return 1;
}
