#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	int i;
	string *style = ({
"摇光移步----$N化出一个人影，手中的$w刺向$n的$l！",
"天璇掠波----$N化出二个人影，向$n扑了过去!",
 "天玑换形----$N化出三个人影，手中$w狂舞，向$n猛刺过去!",
"开阳分身----$N化出四个人影，将$n逼的手忙脚乱！",
"玉衡落日----$N化出五个人影，连连向$n砍去!",
"天权双飞----$N化出六个人影，手中$w连发，点向$n的六处死穴！",
"天枢出水--------$N化出七个人影，手中的$w攻向$n全身的要害！"                      });

	object weapon,ob;
	if( !target ) target = offensive_target(me);

	 if( !target
      	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("[七星拱月]只能对战斗中的对手使用。\n");


	weapon = me->query_temp("weapon");
	if ( (string) me->query_skill_mapped("sword") != "quanzhen-jian")
	return notify_fail("[七星拱月]只能和全真剑法配和！\n");
         if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能使用[七星拱月]。\n");        
              
        if( (int)me->query_skill("ziliu-force", 1) < 50 )
                return notify_fail("你的紫流气功不够高，不能用[七星拱月]。\n");
	 if( (int)me->query_skill("quanzhen-jian", 1) < 20 )
		    return notify_fail("你的全真剑法不够娴熟，不能使用[七星拱月]。\n");
        if( (int)me->query_skill("qixing-huanwei", 1) < 20 )
                return notify_fail("你的七星换位不够娴熟，不能用[七星拱月]。\n");        

        if( (int)me->query("max_force") < 200 )
                return notify_fail("你现在内力太弱，不能使用[七星拱月]。\n");
                        
        if( (int)me->query("force") < 200 )
                return notify_fail("你的真气不足，不能使用[七星拱月]。\n");

	extra = me->query_skill("quanzhen-jian",1) /2;
	extra += me->query_skill("qixing-huanwei",1) /2;
	me->add_temp("apply/attack", extra);	
	me->add_temp("apply/damage", extra);
	msg = HIR  "$N使出全真剑法中的「七星拱月」，脚踏北斗星位，手中"+ weapon->name() +"变成无数道剑光，闪电般的击向$n！" NOR;
	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	msg =  HIW "剑光犹如一道弯月闪过，刹那间消失．．．．\n" NOR;
        message_vision(msg, me, target);
	for(i=0;i<extra/40;i++)
	{
	msg =HIY + style[i] + NOR;
	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
            me->add("force", -random(200));
	}
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
      	me->start_busy(2);
	return 1;
}