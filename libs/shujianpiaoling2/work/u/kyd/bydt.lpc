
#include <room.h>
inherit ROOM;

void create()
{
        set("short", "别有洞天");
        set("long", @LONG
一间天然的洞穴，石壁上刻着几个大字（dazi），洞中的布置简单而清洁。靠
墙有一石床，上面斜倚着一副骷髅骨，旁边放着一香炉，真有一股清烟轻轻飘出，
使的洞中散发着一股香味。
LONG
        );
	 set("he_count",1);
        set("paper_count",1);
        set("xia_count",1);
  /*      set("exits", ([ 
  "west" : __DIR__"guangchang",
 ]));*/
	set("objects", ([
		(__DIR__"obj/skeleton") : 1,
		]));

	set("item_desc",([
		"dazi"	:	"\n\t\t\t\n\n\n" 
					"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n"
					"\t\t∷　 　　　　　　　　　　 ∷\n"
                                  "\t\t∷　  别  有  洞  天      ∷\n"
                                  "\t\t∷　　 　　　　　　　　　 ∷\n"
                 	  		"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n\n\n",
	
						
		]));

        setup();
        
}
       
 void init()
{	this_player()->set_temp("ketou_times", 99);
	add_action("do_kneel", "kneel");
	add_action("do_ketou", "ketou");
	 add_action("do_zang", ({"zang","zang"}));
        add_action("do_shenzang", ({"shenzang","shenzang"}));
        add_action("do_open", "push");
        
}


int do_shenzang(string arg)
{ 
        object box,map,book;
        object me;
        me = this_player();
  	     if (!( present("tie chu", this_player())))
        return notify_fail("太深了，你很难用手挖！\n");
        if ( !arg || arg != "skeleton" )
            return notify_fail("你要深葬谁？\n");
         if (!(int)me->query_temp("mark/zang"))
             return notify_fail("你要做什麽？\n");
          if(random(10)!=3) {
         me->add("sen",-200);
         return notify_fail("你把坑又挖了深许，也不知够不够。\n"); 
         }
        me->add("sen",-200);
        if (query("xia_count") > 0) 
       {
        message_vision("$N你又把坑挖深了几尺，埋葬了骷髅，突然看到一个铁匣(tiexia)。\n",me);
        add("xia_count", -1);
	seteuid( geteuid(me));
	book = new(__DIR__"obj/book3");
	map = new(__DIR__"obj/map2");
	box = new(__DIR__"obj/tiexia");
	book->move(box);
	map->move(book);
	box->move(__DIR__"bydt");
      me->set_temp("mark/shenzang",1);
        me->add("sen",-200);
        destruct(present("skeleton", this_object()));
        }
        else
       message_vision("$N费力的挖了挖，显然已经被人挖过了。\n", me);
        return 1;
}


int do_zang(string arg)
{      
        object he;
        object me;
        me = this_player();
      
        if ( !arg || arg != "skeleton" )
            return notify_fail("你要埋葬谁？\n");
         if (!(int)me->query_temp("ketou_pass"))
		{
	       message_vision("$N在碰骸骨的一瞬间，骸骨突然四份五裂，也不知什么东西直朝\n"+
				  "$N飞去，穿过了$N的胸躺，$N哼都没来的急哼一，就仰天摔在了地上，\n"+
				  "接着，一切又恢复了平静。", me);
		me->die();
		return 1;
		}
if (!( present("tie chu", this_player())))
      return notify_fail("你很难用手挖！？\n");

       if (query("he_count") > 0) 
          {
        message_vision("$N心下恻然，不禁想安葬这个骷髅，于是抡起锄头，
向地上挖去。没挖几下，突然看到一个大铁合(tiehe)。\n", me);
         add("he_count", -1);
         he=new(__DIR__"obj/datiehe");
         me->set_temp("mark/zang",1);
         me->add("sen", -200);
         he->move(__DIR__"bydt");
          }
        else
         message_vision("$N费力的挖了挖，这里似乎已经被人挖过了。\n", me);
     return 1;

}

int do_kneel(string arg)
{
	object me,room,weapon;
	me = this_player();
	if ( !arg || arg == "") return 0;
	if ( arg != "skeleton") return 0;
	if (!present("skeleton",environment(me))) return 0;
	if (me->query_temp("marks/kneel") == 1 )
		return notify_fail("你已经跪下来了。\n");
	message_vision("$N双膝一屈，跪了下来。\n", me);
	me->add_temp("marks/kneel",1);
	return 1;
}

int do_ketou()
{
	object me, ob;

	me = this_player();
	if ( !me->query_temp("marks/kneel") ) return 0;
	if (!present("skeleton",environment(me))) return 0;
	if ( me->query_temp("ketou_times") == 0 )
	{
		message_vision("$N磕头太拼命了。\n", me);
		me->set_temp("ketou_times", random(99));
		me->unconcious();
		return 1;
	}

	me->add_temp("ketou_times", -1);	

	message_vision("$N恭恭敬敬的向骸骨磕头。咚、咚、咚。。。。\n", me);
	
	if ( random(100) == 37 
	&& !present("paper", me)
	&& query("paper_count") >= 1)
	{
		add("paper_count", -1);
		seteuid( geteuid(me));
		ob=new(__DIR__"obj/paper");
		ob->move(this_player());
		write("一张枯黄的纸从头顶上飘下．．．．！\n");
		write("你双手一伸，在纸落地的一瞬间把它接住了。\n");
		me->set_temp("ketou_pass",1); 
	}

	return 1;

}

int valid_leave(object me, string dir)
{
	if(me->query_temp("ketou_times") >= 0 ) me->delete_temp("ketou_times");
	if (me->query_temp("marks/kneel") ) me->delete_temp("marks/kneel");
	return ::valid_leave();
}



int do_open(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要推开什么？\n");
                return 1;
        }
        if( arg == "bed" || arg == "石床" || arg == "床")
        {
        me = this_player();
        message_vision("$N把小床推开发现了一条密道。\n", me);
        if( !query("exits/down") ) {
        set("exits/down", __DIR__"andao");
        call_out("close_path", 1);
        }
        return 1;
        }
        else
        {
                write("你伸手推了推"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/down") ) return;
        message("vision",
"石床又无声无息的合了起来．\n",
                this_object() );
                delete("exits/down");
}




