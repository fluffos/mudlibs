//xilang2.c 西厢走廊

#include <ansi.h>;
#include <room.h>;
inherit ROOM;

void init();
int do_mianbi();

void create() {
  set("short", "西厢走廊");
  set("long", @LONG
你走在一条长长的走廊上。房顶一侧支在北面的南极殿上，另一侧则
与南边八仙殿的屋顶相连。走廊二边的墙上刻着的是老子的《道德经》。
往南是八仙殿，往北是南极殿。
LONG
  );

  set("exits", ([
    "southeast": __DIR__ "baxiandian",
    "north": __DIR__ "nanjidian",
  ]));
  setup();

}
void init() {
  add_action("do_mianbi", "mianbi");
}
int do_mianbi() {
  mapping fam;
  object me;
  me = this_player();

  if (!living(me)) return 0;

  if (me->query("class") != "taoist")
    return notify_fail("你非玄门中人，学什么道学心法。\n");

  if ((int)me->query_skill("literate", 1) < 30)
    return notify_fail("你斗大的字都认识不了几个,还是去进修一下再来学吧。 \n");

  if ((int)me->query("bellicosity") > -100)
    return notify_fail("你的杀气太重，无法领悟道学心法。\n");

  if ((int)me->query_skill("daoxu-xinfa", 1) < 50)
    return notify_fail("你仔细研读墙上的《道德经》，然而这对你而言过于高深,你无法领悟其中的奥妙。 \n");

  if ((int)me->query_skill("daoxu-xinfa", 1) >= 100)
    return notify_fail("墙上所述对你而言过于肤浅,你无法再从中领悟出新的东西。\n");

  if ((int)me->query("gin") < 30)
    return notify_fail("你今天太累了,还是休息一下吧. \n");

  write("你静心研习墙上的《道德经》，对道学心法有些领悟。\n");

  me->receive_damage("gin", 5 + random(10));
  me->receive_damage("kee", 5 + random(10));
  me->improve_skill("daoxue-xinfa", (int)(me->query_con() / 2) +
    (int)(me->query_skill("literate") / 3));

  return 1;
}
