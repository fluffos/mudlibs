inherit NPC;
inherit F_MASTER;

string ask_me();
string *names = ({"霍尔干勒","铁沙龙","完颜国泰","忽尔丰谷","萨木安邦","新文豹","达尔巴",});

void create()
{
	set_name("赵志敬", ({"zhao zhijing", "zhao", "zhijing"}));
	set("master", "王处一");
	set("gender", "男性");
	set("age", 26);
	set("long",
             "他容貌不算俊，但却十分英挺，高高的个子，体格很健壮。\n"
		"他是王处一最得意的弟子，也是全真教第三代中较出色的一个。\n");
	set("attitude", "friendly");

	set("class", "quanzhen");

	

	set("chat_chance", 2);
	set("chat_msg", ({
		"赵志敬说道：“师父要我去刺杀匈奴人，可是那里高手如云，如果白白的丢了性命。。。这可如何是好？”\n",
             "赵志敬喃喃道：“我一定要想办法成为全真教掌教”。\n",

//		(: random_move :),
	}));
	set("inquiry", ([
		"杀人" : (: ask_me :),
		]));

	set("ling_count", 1);

	set("kee", 2500);
	set("max_kee", 2500);
	set("force", 2500);
	set("max_force", 2500);
	set("force_factor", 150 );

	set("combat_exp", 800000);
	
 
	set_skill("force", 80);             // 基本内功
	set_skill("ziliu-force", 80);    //
	set_skill("unarmed", 70);           // 基本拳脚
	set_skill("tiangang-quanfa", 70);     
	set_skill("dodge",60);      	     // 基本躲闪
	set_skill("qixing-huanwei", 60);        //七星换位
	set_skill("parry", 60);             // 基本招架
	set_skill("sword", 60);             // 基本剑法
	set_skill("quanzhen-jian", 60);        //全真剑法 
	set_skill("daoxue-xinfa",60);           //道学心法  
        set_skill("literate",50);           //读书写字  
      
	map_skill("force", "ziliu-force");
	map_skill("unarmed", "tiangang-quanfa");
	map_skill("dodge", "qixing-huanwei");
	map_skill("parry", "quanzhen-jian");
	map_skill("sword", "quanzhen-jian");

           set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
		(: perform_action, "qixinggongyue" :),
		(: exert_function, "recover" :),
	}) );


	create_family("全真教", 3, "弟子");
	setup();
	
	carry_object(__DIR__"obj/changjian")->wield();
	carry_object(__DIR__"obj/yellowrobe")->wear();

}
	
void attempt_apprentice(object ob)
{	string name, new_name;
	

	object me  = this_object();
	mapping ob_fam;
	mapping my_fam  = me->query("family");

	command("smile");
       command("say 好吧，我就收下你了。");
	command("recruit " + ob->query("id"));
	if( (string)ob->query("class") != "quanzhen")
		ob->set("class", "quanzhen");

}

string ask_me()
{
	mapping fam; 
	object ob;
	string target;

  	target = names[random(sizeof(names))];


	if (!(fam = this_player()->query("family")) || fam["family_name"] != "全真教")
		return RANK_D->query_respect(this_player()) + 
		"与本派素无来往，不知此话从何谈起？";
	if (this_player()->query_temp("zhao_give"))
		return "不是和你讲的很清楚了吗，怎麽又来问了？";

	if (query("ling_count") < 1) return "已经有人去了，不用麻烦了。";

 	message_vision("$N对着$n说道：就烦劳" + RANK_D->query_respect(this_player()) + "下山替我跑一趟了。\n",this_object(),this_player());
 	this_player()->set_temp("job_name",target+"的首级");
	this_player()->set_temp("zhao_give",1);
	add("ling_count", -1);

 	message_vision("$N给了$n一块全真令。\n",this_object(),this_player());
	ob = new(__DIR__"obj/quanzhenling");
	ob->move(this_player());
	return "我师父要的是" + target + "的首级，可不要杀错了。\n";

}









