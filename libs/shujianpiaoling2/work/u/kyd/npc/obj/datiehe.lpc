
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("大铁盒", ({ "tie he","box"}) );
        set_weight(300);
        set_max_encumbrance(800);
	set("unit", "个");
	set("long", "一个生满铁锈的大铁盒。你可以试着把它打开(open)\n");
	set("closed", 1);
	set("value", 200);
}

int is_container() {return 1;}

void init()
{
	if(this_player()==environment())
		 add_action("do_open","open");
}


int do_open(string arg)
{
	object		me, ob;
	int		kar;
	
        if( !arg || arg != "tie he" )
                return notify_fail("你要打开什么？\n");
	me = this_player();
	ob = this_object();
	message_vision("$N小心地想要把$n打开．．．。\n", me, ob);
	kar = me->query("kar");
		message_vision(HIR "只听到一声巨响，铁盒炸了开来，紧跟着。。。\n" NOR, me, ob);
		this_player()->die();
		return 1;

}

