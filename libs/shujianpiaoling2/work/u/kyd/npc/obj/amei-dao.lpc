
#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
	set_name( HIY "阿眉刀" NOR, ({ "amei dao", "dao","blade"}) );

	set_weight(10000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", HIY"     一柄四尺五寸长，宽约两寸，黄光灿耀的金刀，这柄金刀的刀身中背，
     嵌着九枚儿拳大小的金环，刀身沿刃口精工镂雕着四张怪异的人脸，这
     匹张人脸代表着「喜、怒、哀、乐」四种不同的表情，雕刻得如此精细
　    ，人脸上的毫发毕现，甚至连那笑纹、竖眉、泪痕、弯唇，也雕得如此
     清晰仔细，衬着洁白滑腻的象牙刀柄，真是寒芒如电，华贵带煞！\n"NOR);
		set("value", 0);
		set("material", "steel");
		set("weapon_prop/strength", 15);
		set("wield_msg", HIY "阿眉刀「削」的飞起，立见金光扬射，
锐风在金芒里如飞猝闪，「削」「削」之声彷佛魔鬼的嘲笑，冤魂的哭泣。\n" NOR);
		set("unwield_msg", HIY "只见金芒溜溜，纵横交织，却又像极西的电闪，一亮又熄。\n" NOR);
	}
	init_blade(140);
	setup();
}
