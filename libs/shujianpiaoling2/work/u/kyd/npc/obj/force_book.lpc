inherit ITEM;

void create()
{
	set_name( "天罡正气", ({ "force book","book" }));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本修炼内功的图谱，上面画着一些基本内功修练法门。\n");
		set("material", "paper");
		set("skill", ([
			"name":	"force",	
			"exp_required":	5000,	// minimum combat experience required
			"sen_cost": 25, 	// jing cost every time study this
			"difficulty":	40,	// the base int to learn this skill
			"max_skill":	40,	// the maximum level you can learn
		]) );
	}
}
