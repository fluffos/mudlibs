//sunbuer.c 孙不二

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me_wan();
string ask_me_dan();
void consider();
void create()
{
	set_name("孙不二", ({"sun buer", "sun", "buer"}));
	set("nickname", HIR "清静散人"NOR);
	set("gender", "女性");
	set("age", 39);
	set("long",
             "她明目皓齿，肤色白腻，虽穿一身灰色道袍，也掩盖不了她的姿色。\n"
		"她就是全真七子中唯一的女性“清静散人”孙不二。\n");
	set("attitude", "friendly");
	set("class", "quanzhen");

	
	set("chat_chance", 1);
	set("chat_msg", ({
		"孙不二说道：“非本教弟子不要乱走。”\n",
	(: random_move :),
	}));

	set("max_gin", 4200);
	set("max_kee", 4500);
	set("max_sen", 4200);
	set("force", 4000);
	set("max_force", 4000);
	set("force_factor", 300 );
	set("combat_exp", 4500000);
 
	set_skill("force", 130);             // 基本内功
	set_skill("ziliu-force", 130);    //
	set_skill("unarmed", 130);           // 基本拳脚
	set_skill("tiangang-quanfa", 130);     
	set_skill("dodge",150);      	     // 基本躲闪
	set_skill("qixing-huanwei", 140);        //七星换位
	set_skill("parry", 160);             // 基本招架
	set_skill("sword", 130);             // 基本剑法
	set_skill("quanzhen-jian", 130);        //全真剑法 
	set_skill("daoxue-xinfa", 130);            //道学心法  
       set_skill("literate",120);           //读书写字  
     
	map_skill("force", "ziliu-force");
	map_skill("unarmed", "tiangang-quanfa");
	map_skill("dodge", "qixing-huanwei");
	map_skill("parry", "quanzhen-jian");
	map_skill("sword", "quanzhen-jian");

	
	create_family("全真教",2,"长老");
	
	set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
		(: perform_action, "qixinggongyue" :),
		(: exert_function, "recover" :),
	}) );

	set("inquiry", ([
                "碧血丸" :    (: ask_me_wan :),
                "水火丹" :    (: ask_me_dan :),
               
        ]));
  set("wan_count",2+random(2));
        set("dan_count",2+random(2));
	setup();
     carry_object(__DIR__"obj/changjian")->wield();
	carry_object(__DIR__"obj/greyrobe")->wear();



}
string ask_me_dan()
{
        mapping fam; 
        object ob;
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "全真教")
                return RANK_D->query_respect(this_player()) + 
                "与本教素无来往，不知此话从何谈起？";

      if ( (int)this_player()->query_condition("taoist_drug" ) > 0 )
                return RANK_D->query_respect(this_player()) + 
                "你是不是刚吃过药，怎么又来要了？ 灵药多吃有害无宜，过段时间再来吧。";

      if ( (int)this_player()->query("max_force" ) < 300)
                return RANK_D->query_respect(this_player()) + 
                "功力不够，灵药吃了有害无宜，过段时间再来吧。";

        if (  present("shuihuo dan", this_player()) || present("wan", this_player())  )
                return RANK_D->query_respect(this_player()) + 
                "你现在身上不是有颗药丸吗，怎么又来要了？ 真是贪得无餍！";

        if (query("dan_count") < 1) return "对不起，水火丹已经被别人要走了。";

        ob = new(__DIR__"obj/shuihuo-dan");
        ob->move(this_player());

//      add("dan_count", -1);

        message_vision("$N获得一颗水火丹。\n",this_player());
        return "好吧，此丹练之不易，对精力大有好处，你要小心收藏好了。";

}

string ask_me_wan()
{
        mapping fam; 
        object ob;
        
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "崇圣寺")
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";

        if ( (int)this_player()->query_condition("taoist_drug" ) > 0 )
                return RANK_D->query_respect(this_player()) + 
                "你是不是刚吃过药，怎么又来要了？ 灵药多吃有害无宜，过段时间再来吧。";

        if ( (int)this_player()->query("eff_sen" ) < 200)
                return RANK_D->query_respect(this_player()) + 
                "功力不够，灵药多吃有害无宜，过段时间再来吧。";

        if ( present("shuihuo dan", this_player())|| present("xuelu wan", this_player()) )
                return RANK_D->query_respect(this_player()) + 
                "你现在身上不是有颗药丸吗，怎么又来要了？ 真是贪得无餍！";
        if (query("wan_count") < 1) return "对不起，碧血丸已经被领光了";

        ob = new(__DIR__"obj/bixue-wan");
        ob->move(this_player());

      add("wan_count", -1);

        message_vision("$N获得一颗碧血丸。\n",this_player());
        return "好吧，此药乃我教秘制而成，习武之人服之大有好处，你要小心收藏。";

}


