inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
	set_name("张志光", ({"zhang zhiguang", "zhang", "zhiguang"}));
	set("master", "郝大通");
	set("gender", "男性");
	set("age", 25);
	set("long",
             "他中等个子，额下有留少许胡须，体格很魁梧。\n"
		"他是郝大通的二弟子，也是全真教第三代中的高手。\n");
	set("attitude", "friendly");

	set("class", "quanzhen");

	

	set("chat_chance", 1);
	set("chat_msg", ({
		"张志光说道：“我师傅中了玉蜂之毒，我该怎么办呢？”\n",
		"张志光说道：“师傅中的玉蜂之毒，发作起来越来越利害了，再不医治，可能就。。。”\n",
              "张志光敬喃喃道：“一日为师，终生为父，为了救师傅看来我只有犯门规，闯古墓，取解药了。”。\n",
//		(: random_move :),
	}));
	set("inquiry", ([
		"救人" : (: ask_me :),
		]));

	set("cloth_count", 1);


	set("kee", 2500);
	set("max_kee", 2500);
	set("force", 2500);
	set("max_force", 2500);
	set("force_factor", 150 );

	set("combat_exp", 260000);
	
 
	set_skill("force", 40);             // 基本内功
	set_skill("ziliu-force", 40);    //
	set_skill("unarmed", 40);           // 基本拳脚
	set_skill("tiangang-quanfa", 40);     
	set_skill("dodge",40);      	     // 基本躲闪
	set_skill("qixing-huanwei", 40);        //七星换位
	set_skill("parry", 40);             // 基本招架
	set_skill("sword", 40);             // 基本剑法
	set_skill("quanzhen-jian", 40);        //全真剑法 
	set_skill("daoxue-xinfa",50);           //道学心法  
        set_skill("literate",50);           //读书写字  
  
	map_skill("force", "ziliu-force");
	map_skill("unarmed", "tiangang-quanfa");
	map_skill("dodge", "qixing-huanwei");
	map_skill("parry", "quanzhen-jian");
	map_skill("sword", "quanzhen-jian");

           set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
		(: perform_action, "qixinggongyue" :),
		(: exert_function, "recover" :),
	}) );



	create_family("全真教", 3, "弟子");
	setup();
	
	carry_object(__DIR__"obj/changjian")->wield();
	carry_object(__DIR__"obj/yellowrobe")->wear();


}

string ask_me()
{
	mapping fam; 
	object ob;
	string target;

//  	target = names[random(sizeof(names))];


	if (!(fam = this_player()->query("family")) || fam["family_name"] != "全真教")
		return RANK_D->query_respect(this_player()) + 
		"与本派素无来往，不知此话从何谈起？";
	if (this_player()->query_temp("zhang_give"))
		return "别多问了，再慢就来不急了。快去吧。";

	if (query("cloth_count") < 1) return "已经有人去了，不用麻烦了。";

 	message_vision("$N对着$n说道：就烦劳" + RANK_D->query_respect(this_player()) + "替我去古墓跑一趟了。\n",this_object(),this_player());
 //	this_player()->set_temp("job_name",target);
	this_player()->set_temp("zhang_give",1);
	add("ling_count", -1);

 	message_vision("$N给了$n一件夜行衣。\n",this_object(),this_player());
	ob = new(__DIR__"obj/black_suit");
	ob->move(this_player());
	return "我师父要玉蜂蜜解毒，请速去速回。\n";

}










