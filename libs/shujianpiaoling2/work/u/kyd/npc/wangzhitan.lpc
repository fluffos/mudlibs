inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("王志坦", ({"wang zhitan", "wang", "zhitan"}));
	set("master", "刘处玄");
	set("gender", "男性");
	set("age", 26);
	set("long",
             "他张着一张圆脸，又矮又胖的个子，脸上的一双小眼睛却炯炯有神。\n"
		"他是丘处机的弟子，也是全真教第三代中的高手。\n");
	set("attitude",  "friendly");
	set("class", "taoist");

	set("kee", 2500);
	set("max_kee", 2500);
	set("force", 2500);
	set("max_force", 2500);
	set("force_factor", 150 );

	set("combat_exp",245000);
	
 
	set_skill("force", 50);             // 基本内功
	set_skill("ziliu-force", 50);    //
	set_skill("unarmed", 50);           // 基本拳脚
	set_skill("tiangang-quanfa", 50);    
	set_skill("dodge",50);      	     // 基本躲闪
	set_skill("qixing-huanwei", 50);        //七星换位
	set_skill("parry", 50);             // 基本招架
	set_skill("sword", 50);             // 基本剑法
	set_skill("quanzhen-jian", 50);        //全真剑法 
	set_skill("daoxue-xinfa",50);           //道学心法  
       set_skill("literate",50);           //读书写字  
     
    

	map_skill("force", "ziliu-force");
	map_skill("unarmed", "kongming-quan");
	map_skill("dodge", "qixing-huanwei");
	map_skill("parry", "quanzhen-jian");
	map_skill("sword", "quanzhen-jian");

	create_family("全真教", 3, "弟子");
	setup();
	
	carry_object(__DIR__"obj/changjian")->wield();
	carry_object(__DIR__"obj/yellowrobe")->wear();


}

