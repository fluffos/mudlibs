#include <ansi.h>
#include <login.h>

int update_condition(object me, int duration)
{
      int time;
      time = me->query_temp("songshu_time");


        if (duration < 1) {
             tell_object(me, HIY "你时间已过，任务失效！\n" NOR);
              me->delete_temp("qz_job");
              me->delete_temp("songshu_name");
              me->delete_temp("songshu_zuji");
               me->delete_temp("songshu_target_name");
                me->delete_temp("book_steal");
                me->delete_temp("zuji",1);

//            me->delete_temp("wait");
              me->set_temp("qz_job_late",1);
              me->clear_condition("qz_job");
          if (me->query("qz_job") > 0) {
              me->add("qz_job", -1);
              }
                  return 0;
        }
        if (!duration) return 0;
/*    
        if (random(10)>3)
       {
        if (me->query("gin")<80) {
         tell_object(me, RED "你这样急行送信，消耗太多精力，不由想停下来歇一下！\n" NOR);
        me->set_temp("wait",1);
         me->start_busy(1);
         } else {
        me->add("gin", -50+random(50));
        me->delete_temp("wait");

         }
        } 
*/

         if(duration > time/7 && present("miji", me) && !me->query_temp("wait") 
    && duration < time && !me->query_temp("songshu_zuji",1)&&random(10)>2&&(interactive(me))&&!environment(me)->query("no_fight"))
       {
       tell_object(me, HIY "你觉的有些不妙，似乎被人跟踪上了！\n" NOR);
        me->start_busy(1);

       call_out("zuji", 0, me);    
       }

        me->apply_condition("qz_job", duration - 1);
        return 1;
}


void zuji(object me)
{
object obj; 
if (present("miji", me)) 
  {
tell_object(me,"你隐约感觉到有人围了过来。。!!! \n");

 
        if (random(10)>7) {

        //this is killer kill npc
        tell_object(me, RED "糟糕！有人要抢信!\n" NOR);

        new("/u/kyd/npc/mmr1")->move(environment(me));

       me->set_temp("songshu_zuji",1);

         if (me->query("combat_exp")>300000)
                {
         call_out("killer_clone", 1, me);    
                }
           } else {
        //this is stealer steal letter
 
        obj = present("book", me);
        destruct(obj);
tell_object(me, RED "你紧张起来，不由一摸衣袋，不好！秘籍被偷了!\n" NOR);

      me->set_temp("songshu_zuji",1);

         new("/u/kyd/npc/mmr3")->move(environment(me));
  
        if (me->query("combat_exp")>300000)
                {
          call_out("stealer_clone", 1, me);    
                }
           }
   } else {

   tell_object(me,"秘籍已送出，你庆幸的完成了任务!\n");
   }   
    return;
}

void killer_clone(object me)
{
tell_object(me,"糟糕，又冲上来了个人。。!!! \n");
new("/u/kyd/npc/mmr2")->move(environment(me));
return;
}

void stealer_clone(object me)
{
tell_object(me,"糟糕，又冲上来了个人。。!!! \n");
new("/u/kyd/npc/mmr3")->move(environment(me));
return;
 }


