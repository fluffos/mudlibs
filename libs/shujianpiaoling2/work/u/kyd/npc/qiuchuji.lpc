void init()
{
        ::init();
        add_action("do_accept", "accept");

}
int do_accept(string arg)
{	object who = this_player(),ob1;
	object me = this_object();

        mapping guild;
	if (this_player()->query_temp("qiu_pass")){
	  		message_vision ("$N对着$n说道:你既然已接下我三招，快去吧。\n",me,who);
			return 1;			
		}
        if( arg== "yes" ) {
                say("\n丘处机点了点头，说道：看招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("qi") < 0 
                || !present(this_player(), environment())) {
                        
say("丘处机叹了口气，说道：连一招都接不下....\n");
                        return 1;
		}
                say("\n丘处机说道：接第二招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("qi") < 0 
                || !present(this_player(), environment())) {
                        
say("丘处机说道：难道....\n");
                        return 1;
                }
                say("\n丘处机大叫道：最后一招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("qi") < 0 
                || !present(this_player(), environment())) {
                        
say("丘处机摇了摇头说道：太可惜了....\n");
                        return 1;
                }
                
say("\n丘处机说道：好，既然你能接下我三招，这个就给你，以后全看你的造化了。\n\n");
	this_player()->set_temp("qiu_pass",1);
	write ("丘处机给你一张地图。");
	ob1= new(__DIR__"obj/map");
	ob1->move(this_player());
	add("map_count", -1);
                return 1;

        }
        return 0;
}
 
int ask_me()
{	
	object who = this_player();
	object me = this_object();
	mapping fam; 
          //  mapping ob_fam  = ob->query("family");
//	mapping my_fam  = me->query("family");


          if ((string)who->query("family/family_name") != "" &&
	    (string)who->query("family/family_name") != "全真教") {
            command("shrug");
	 command("say " + RANK_D->query_respect(who) + "，并非本教弟子，此事无可奉告。");
		return 1;
	}


	if ( this_player()->query("bellicosity") > 1000 )
	{
		command("say " + RANK_D->query_respect(who) + "，贫道看你杀气太重，还是好好反思一下。\n");
		return 1;
	}
	if ( this_player()->query("kar") <30 )
	{
		command("say " + RANK_D->query_respect(who) + "，贫道看你福浅命薄，还是不要有这非份之想。\n");
		return 1;
	}

 	message_vision ("$N对着$n说道:祖师爷曾经给过我一张地图，并留下遗言说：“五气朝阳剑唯有缘之人才能得到，\n"+
			    "贫道看"+ RANK_D->query_respect(who)+"或许是有缘之人，如果你能接下我三招的话，我就把图\n"+
			    "给你，你同不同意(accept yes/no）\n",me,who);
	return 1;		
}

