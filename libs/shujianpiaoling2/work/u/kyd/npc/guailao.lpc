#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void consider();
int ask_me();
void create()
{
	set_name("张果雨", ({"zhang guailao", "zhang", "guailao"}));
	set("nickname", HIW "终南拐老" NOR);
	set("gender", "男性");
	set("age", 82);
	set("long",
             "他鹤骨仙风，精神抖擞，长须垂胸，脸如婴儿般血红。\n"
	"他就是全真教的开派祖师王重阳的师父，也称做“张拐老”。\n");
	set("attitude", "peaceful");
	set("class", "quanzhen");
	set("chat_chance", 1);

	
	set("max_gin", 8000);
	set("max_kee", 8000);
	set("max_sen", 5000);
	set("force", 10000);
	set("max_force", 10000);
	set("force_factor", 500 );
	set("combat_exp", 50000000);
 
	 
	set_skill("force", 300);                 // 基本内功
	set_skill("ziliu-force", 250);     //紫流气功
	set_skill("unarmed", 300);             // 基本拳脚
	set_skill("dodge", 300);      	     // 基本躲闪
	set_skill("qixing-huanwei", 250);        //七星换位
	set_skill("parry", 300);             // 基本招架
	set_skill("sword", 300);             // 基本剑法
	set_skill("wuqichaoyang", 250);        //五气朝阳剑法 
	set_skill("daoxue-xinfa", 300);            //道学心法  
        set_skill("literate",300);           //读书写字
        set_skill("sanhuajuding",250);           
        set_skill("move",300);           

	map_skill("force", "ziliu-force");
	map_skill("unarmed", "sanhuajuding");
	map_skill("dodge", "qixing-huanwei");
	map_skill("parry", "wuqichaoyang");
	map_skill("sword", "wuqichaoyang");

	create_family("终南派", 1, "祖师");
	
	set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
		(: perform_action, "qihanyunxiao" :),
	}) );

	
	setup();
	
	carry_object(__DIR__"obj/changjian")->wield();
	carry_object(__DIR__"obj/greyrobe")->wear();

}

void attempt_apprentice(object ob)
{
	object me  = this_object();
	mapping ob_fam  = ob->query("family");
	mapping my_fam  = me->query("family");

	
	if ((int)ob->query_str() < 30 || (int)ob->query_con() < 30) {
		command("say 当我的弟子需能吃苦耐劳，依我看" + RANK_D->query_respect(ob) + "的资质似乎并不适合？");
		return;
	}

	if ((string)ob->query("family/family_name") != "全真教") {
		command("say " + RANK_D->query_respect(ob) + "既然已有名师指点，何必又来拜老朽呢？");
		return;
	}
       if ((int)ob->query_skill("ziliu-force", 1) < 190) {
		command("say 我终南派乃内家武功，最重视内功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否还应该在紫流气功上多下点功夫？");
		return;
       }
       if ((int)ob->query_skill("sword", 1) < 190) {
		command("say 我五气朝阳剑法扬名天下，天下无双。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否还应该在基本剑术上多下点功夫？");
		return;
       }
       command("smile");  
       command("say 终南和全真虽非同门，却属同宗，你既然和重阳有缘，老朽就收下你了！");
	command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "quanzhen");
		  if( ob->query("betrayer")>=0 ) ob->add("betrayer",-1);
                ob->set("id_type", 1);
}
