#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "石室");
        set("long", @LONG
一间不大不小的石室，你只感到四周的壁内如万雷轰轰，同时全身如火焚
一般，两眼竟看不见石壁，满目所视，全为电光缭绕。
LONG);
        set("exits", ([ 
		"east" : __DIR__"shishi",
		"west" : __DIR__"shishi",
		"north" : __DIR__"shishi",
		"south" : __DIR__"shishi",
		"out" : __DIR__"naiheqiao",
		


	]));
 
       setup();
}


void init()
{
        add_action("do_enter", "enter");
        
}
int do_enter(string arg)
{
	object me;
	object room;
	me = this_player();
      	if ( !arg || arg=="" || arg!="石壁" ) return 0;
	if( me->query_temp("fu_dan")){
	message("vision",
               me->name() + "一头钻进了石壁中，转眼消失的无影无踪。\n",
               environment(me), ({me}) );
	  write("你一头钻进了石壁。\n");
	room = load_object(__DIR__"shishi2");
	if(room) me->move(room);
//	return 1;
	}
	else {
		return notify_fail("未服天雷丹者，休进洞门！\n");
	}
	return 1;
}
