
#include <room.h>
inherit ROOM;

void create()
{
	 set("short","石室");
	 set("long",@LONG
一间不大不小的石室，迎面有一块石壁，上面没有洞，但却非常光滑，竟
似一面镜子，范围不大，约有一丈，其他地方，仍然是悬石，惟觉光处成圆形。
在走近仔细一看，原来石壁上贴着一张用朱笔划的符（fu）。
LONG);

	     set("exits", ([ 
		"out" : __DIR__"naiheqiao",
		
	]));

       set("item_desc",([
		"fu"	:		"\n\t\t\t\n\n\n" 
					"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n"
					"\t\t∷　　 　　　　　　　　　 ∷\n"
					"\t\t∷  能进禁制者即为有缘人  ∷\n"
                                 	"\t\t∷　　 　　　　　　　　　 ∷\n"
					"\t\t∷ 未食天雷丹者莫动飞龙剑 ∷\n"
                                  "\t\t∷　　 　　　　　　　　　 ∷\n"
					"\t\t∷　　 　　　    张拐老封 ∷\n"
					"\t\t∷　　 　　　　　　　　   ∷\n"
                 	  		"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n\n\n",
	

		]));

	 setup();

//	set("outdoors","全真教");
    
}

void init()
{
        add_action("do_open", "push");
}

int do_open(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要打开什么？\n");
                return 1;
        }
        if( arg == "shi bi" || arg == "bi" || arg == "石壁")
        {
        me = this_player();
        message_vision("$N俯身走了两步，伸出双掌，紧紧贴住石壁，
	使劲力推，石壁上竟裂开了一重门户。\n", me);
        if( !query("exits/north") ) {
        set("exits/north", __DIR__"shishi3");
        call_out("close_path", 1);
        }
        return 1;
        }
        else
        {
                write("你伸手推了推"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/north") ) return;
        message("vision",
"石壁上的门户又无声无息的合了起来．\n",
                this_object() );
                delete("exits/north");
}



