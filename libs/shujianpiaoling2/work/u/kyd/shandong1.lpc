// shandong.c 山洞 

#include <room.h>
inherit ROOM;

void create() {
  set("short", "山洞");
  set("long", @LONG
黑暗中依稀看到山洞顶部凹凸不平，上面有许多草藤交织成的巢穴，也
不知是如何固定在上面的，刚好有一只小鸟从穴中飞出，沿洞壁盘旋一周，
鸣叫着又钻了回去。迎面有一座石像。
LONG);
  // set("outdoors","全真教");
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "fengdong",
  ]));

  set("objects", ([
    __DIR__ "obj/shixiang": 1,
  ]));

  setup();
}

void init() {
  add_action("do_open", "turn");
}

void check_trigger() {
  object room;

  if ((int)query("leftright_trigger") == 3
    //	&&	(int)query("right_trigger")==4
    && !query("exits/northdown")) {
    message("vision", "石像突然发出一阵[轧轧]的异声，向一侧缓缓移开，"
      "向下露出一个黑洞洞的入口。\n", this_object());
    set("exits/northdown", __DIR__ "wushengxi");
    if (room = find_object(__DIR__ "wushengxi")) {
      room->set("exits/southup", __FILE__);
      message("vision",
        "身后的石壁忽然发出一阵[轧轧]的异声，露出一个光亮亮的洞口。\n", room);
    }
    delete("leftright_trigger");
    delete("right_trigger");
    remove_call_out("close_passage");
    call_out("close_passage", 10);
  }
}
void close_passage() {
  object room;

  if (!query("exits/northdown")) return;
  message("vision", "石像忽然发出一阵[轧轧]的异声，缓缓地移回原处，"
    "将向下的洞口盖住了。\n", this_object());
  if (room = find_object(__DIR__ "wushengxi")) {
    room->delete("exits/southup");
    message("vision", "身后的石像忽然发出轧轧的声音，"
      "石壁又缓缓地收了回去，洞口消失了。\n", room);
  }
  delete("exits/northdown");
}
int do_open(string arg) {
  string dir;

  if (!arg || arg == "") {
    write("你要扳什么？\n");
    return 1;
  }

  if (arg == "shi xiang" || arg == "xiang" || arg == "石像") {
    write("你试着扳动这座石像，发现可以左右挪动......\n");
    return 1;
  }
  if (sscanf(arg, "xiang %s", dir) == 1) {
    if (dir == "left and right") {
      message_vision("$N将石像先往左扳了一下，接着又往右扳了一下...，忽然「喀」一声石碑又移回原位。\n",
        this_player());
      add("leftright_trigger", 1);
      check_trigger();
      return 1;
    } else {
      write("你要将石像向那个方向扳？\n");
      return 1;
    }
  }
}




void reset() {
  ::reset();
  delete("leftright_trigger");
  delete("right_trigger");
}
