#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIC"飞龙图"NOR, ({"feilong tu", "tu", "map"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long","这张是江湖人梦寐以求的飞龙宝藏图。上面依稀写着几行字：\n"+
			"\n余于晚年无意得到天下十大名剑之一-----飞龙剑，然神兵利器唯有得缘者\n"+
			"\n才能拥之，否遭天谴，而我座下第子无人有此福缘。故留此图，以待后世有\n"+
			"\n缘人，凭此图寻得神器，光我全真。\n"
			"\n\t\t\t太乙湖东入丛林，\n"
			"\n\t\t\t一股热气化冰霜。\n"
			"\n\t\t\t看似无生却有生，\n"
			"\n\t\t\t食得天雷入洞府。\n"
			"\n\t\t\t飞龙一出群魔惊，\n"
			"\n\t\t\t斩妖除魔兴全真。\n"	);
		set("no_drop", "这样东西不能离开你。\n");
             	set("no_give", "这样东西不能随便给人。\n");
              set("material", "paper");
        }
}

