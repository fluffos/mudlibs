// qz_miji.c

#include <ansi.h>
inherit ITEM;

void create() {
  int i;

  string *names = ({
    "「杖法图解」", "「内功心法」", "「拳法秘籍」", "「剑术图解」",
    "「拆招要诀」", "「闪躲之术」", "「棍法图解」", "「指法秘籍」",
    "「掌法秘籍」", "「爪法秘籍」", "「鞭法图解」", "「刀法图解」",
    "「棒法图解」", "「手法秘籍」", "「锤法图解」", "「腿法图解」",
  });


  i = random(16);
  set_name(names[i], ({ "book", "miji", "mi ji", }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本修练基本武功的密籍,包含了全真教几代人的心血。\n");
    set("value", 0);
    set("material", "paper");
  }
}

void init() {
  call_out("dest", 2000);
  add_action("do_send", "songshu");
  add_action("do_look", "kan");
  add_action("do_look", "chakan");
}
int do_look(string arg) {
  int now_time, time;
  object me;

  me = this_player();
  now_time = me->query_condition("qz_job");
  time = me->query_temp("songshu_time");

  if (!arg) return 0;
  if ((arg == "mi ji" || arg == "miji") && me->query_temp("qz_job")) {
    write(
      "\n这是一本修练基本武功的密籍，上面贴的纸条上写着"
      HIR " 「" + me->query_temp("songxin_target_name") + "」 亲收。\n" NOR);
    if (now_time > time * 3 / 4) write("你现在有充足的时间去送信。\n");
    if (now_time > time / 2 && now_time <= time * 3 / 4) write("已经过去一小半时间了。\n");
    if (now_time > time / 4 && now_time <= time / 2) write("你还有一半的时间去送信。\n");
    if (now_time > time / 8 && now_time <= time / 4) write("你的时间已经不多了。\n");
    if (now_time > 0 && now_time <= time / 8) write("时间将至，任务即将失败。\n");
    return 1;
  }
}

int do_send(string arg) {
  int i, job_time, exp, sh, pot;
  object ob;
  object me, target;
  string t_name, t_id;
  me = this_player();

  if (!arg) return notify_fail("你要送给谁？\n");
  if (!objectp(target = present(arg, environment(me)))) return notify_fail("看清楚点，你要送信的人不在这里！\n");
  t_name = target->query("name");
  t_id = target->query("id");
  i = random((int)(target->query_skill("force", 1) / 5));

  if (!target) return notify_fail("看清楚点，你要送的人不在这里！\n");
  if (target->query("victim_user")) return notify_fail("嘿嘿，想作弊？！\n");
  if (me->query_temp("qz_job_late"))
    return notify_fail("你任务已经失败了，重新再领一个吧。\n");
  if (!present("book", this_player()))
    return notify_fail("你身上没有携带秘籍。\n");
  if (!me->query_family("全真教"))
    return notify_fail(t_name + "道：你不是全真教弟子，怎么会有全真教的武功密籍?");
  if (!me->query_temp("qz_songshu"))
    return notify_fail(t_name + "道：这本书真是马钰道长要你送的？你是不是从别人那里抢来的？");
  if (me->query_temp("songxin_target_name") != t_name)
    return notify_fail(t_name + "道：这本秘籍不是给我的，你是不是送错了？");
  message_vision(HIY "$N擦了一把额头的汗，从怀中掏出一本秘籍交给$n说道，这是全真教掌教马钰道长要我教给您的密籍,请您务必保管好。\n" NOR, me, target);
  message_vision("$N交给了$n一本密籍。\n", me, target);
  //     message_vision(t_name+"点了点头说道：辛苦你了,这辛苦费你就收下吧! \n",me);
  //     target->add_money("silver",(int)(target->query_skill("force",1)/5)+1);
  //     command("give "+me->query("id")+" "+((int)(target->query_skill("force",1)/5)+1)+" silver");
  message_vision(t_name + "点了点头说道：辛苦你了! \n", me);
  me->add_money("silver", i);
  if ((int)me->query("combat_exp") < 200000) {
    if (!me->query_temp("zuji")) {
      exp = ((1 + random(2)) * 20 + (int)(job_time / 5));
      pot = 10 + random(me->query("max_pot") / 7);
      sh = exp * 3;
    } else {
      exp = ((1 + random(3)) * 60 + (int)(job_time / 5));
      pot = 20 + random(me->query("max_pot") / 4);
      sh = exp * 6;
    }
  }
  if ((int)me->query("combat_exp") < 600000 && (int)me->query("combat_exp") > 200000) {

    if (!me->query_temp("zuji")) {
      exp = (1 + random(2)) * 20 + (int)(job_time / 5);
      pot = 10 + random(me->query("max_pot") / 7);
      sh = exp / 4;
    } else {
      exp = (1 + random(3)) * 80 + (int)(job_time / 5);
      pot = 30 + random(me->query("max_pot") / 3);
      if (pot > 150) pot = 150;
      sh = exp * 2 / 3;
    }
  }
  if ((int)me->query("combat_exp") > 600000) {

    if (!me->query_temp("zuji")) {
      exp = (1 + random(2)) * 25 + (int)(job_time / 5);
      pot = 10 + random(me->query("max_pot") / 8);
      sh = exp / 4;
    } else {
      exp = (1 + random(3)) * 100 + (int)(job_time / 4);
      pot = 50 + random(me->query("max_pot") / 3);
      if (pot > 150) pot = 150;
      sh = exp * 3 / 4;
    }
  }
  me->add("potential", pot);
  //            if(me->query("potential") > me->query("max_pot")) 
  //            me->set("potential", me->query("max_pot"));
  me->add("combat_exp", exp);
  tell_object(me, HIW "好！任务完成,你被奖励了：\n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" +
    NOR);
  me->clear_condition("qz_job");
  me->delete_temp("qz_job");
  me->delete_temp("songshu_time");
  me->delete_temp("songshu_target_name");
  me->delete_temp("songshu_where");
  me->set_temp("songshu_ok", 1);
  me->delete_temp("songshu_zuji");
  destruct(this_object());
  return 1;
}
void dest() {
  object me;
  me = this_player();
  write("秘籍忽然掉落在路上不见了。\n", me);
  destruct(this_object());
}
