#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("地图", ({"di tu", "tu", "map",}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long","这是张全真教后山的地图，上面有些注解文字，详细的注解了通过\n"+
				 "青松林，进入玉虚洞的路径：\n"
				 "东。。南。。西。。北。。东。。北。。西。。南。。北。。\n");
					
		set("no_drop", "这样东西不能离开你。\n");
             	set("no_give", "这样东西不能随便给人。\n");
              set("material", "paper");
        }

}


