inherit ITEM;

void create()
{
        set_name("石案", ({ "shi an","石案"}) );
        set_weight(500);
        set_max_encumbrance(50000);
        set("no_get", 1);
        set("no_shown", 1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("prep", "on");
                set("unit", "个");
                set("long", "一个天然的石案。\n");
                set("value", 1);
        }
}

int is_container() { return 1; }

