#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIW "白骨冢地图" NOR, ({ "di tu", "tu", "map" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "这是幅精细的地图，上面还有些注解文字。此外，在另一角又细细密\n" +
      "密的写了不少字迹：\n"
      "      阿眉刀乃天下十大魔刀之一，吾将其与七杀刀法----至高心法\n" +
      "藏于白骨冢内，留赠有缘之人。\n");

    set("no_drop", "这样东西不能离开你。\n");
    set("no_give", "这样东西不能随便给人。\n");
    set("material", "paper");
  }
}
