#include <ansi.h>
inherit ITEM;
void setup()
{}
void init()
{
        add_action("do_eat", "eat");
}
void create()
{
        set_name(CYN"碧血丸"NOR, ({"xuelu wan", "wan", }));   
        set("no_drop",1);
        set("no_get",1);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "这是一颗晶莹半透明的药丸，蓝绿色带有一股清香。\n");
                set("value", 0);     
                set("no_drop",1);
        set("no_get",1);
                
        }

        set("quanzhen",1);
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要吃什么？\n");
        if ( (int)me->query_condition("taoist_drug" ) > 0 )
        {
                if (me->add("max_kee", -1) < 0)
                        me->set("max_kee", 0);
                if (me->add("eff_kee", -1) < 0)
                        me->set("eff_kee", 0);
                message_vision(HIR "$N吃下一颗碧血丸，只觉得头重脚轻，摇摇欲倒，原来服食太急太多，药效适得其反！\n" NOR, me);
        }
        else
        {
                me->add("max_kee", 1);
                me->add("eff_kee", 1);
                message_vision(HIY "$N吃下一颗碧血丸，只觉得体力顿然提高，全身似有无穷的精力！\n" NOR, me);
                me->apply_condition("taoist_drug", 20);
        }
        destruct(this_object());
        return 1;
}