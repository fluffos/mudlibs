#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "fu");
}

void create() {
  set_name(YEL "水火丹" NOR, ({ "shuihuo dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗土黄色圆溜溜的药丸，散发一股清香。\n");
    set("value", 0);
    set("no_drop", 1);
    set("no_get", 1);
    set("quanzhen", 1);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要服什么？\n");


  if ((int)me->query_condition("taoist_drug") > 0) {

    {
      if (me->add("max_gin", -1) < 0)
        me->set("max_gin", 0);
      if (me->add("eff_gin", -1) < 0)
        me->set("eff_gin", 0);
      message_vision(HIR "$N服下水火丹，只觉得头重脚轻，全身发热，摇摇欲倒，原来服食太急太多，药效适得其反！\n" NOR, me);
    }

  } else {
    me->add("max_gin", 1);
    me->add("eff_gin", 1);
    message_vision(HIG "$N服下水火丹，体力顿然提高，全身似有无穷的精力！\n" NOR, me);
    me->apply_condition("taoist_drug", 20);
  }
  destruct(this_object());
  return 1;
}
