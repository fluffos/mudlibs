
inherit ITEM;

void create()
{
        set_name("牛皮纸", ({"niupi zhi", "zhi", "paper"}));
        set_weight(50000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long","这是一张牛皮纸，可以用来粘补（bu）残缺不全的东西。\n");
		set("no_drop", "这样东西不能离开你。\n");
             	set("no_give", "这样东西不能随便给人。\n");
              set("material", "paper");
        }
}

void init()
{
  if(this_player()==environment())
  add_action("do_combine","bu");
}

int do_combine()
{
int i,map1=0,map2=0,map3=0;
object jade,me, *inv;
object zhi1,zhi2,zhi3;
me = this_player();
inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                {
			if(inv[i]->query("name") == "残缺不全的地图二") {map2 = 1; zhi2 = inv[i];}
                        if(inv[i]->query("name") == "残缺不全的地图三") {map3 = 1; zhi3 = inv[i];}
                        if(inv[i]->query("name") == "残缺不全的地图一") {map1 = 1; zhi1 = inv[i];}
       
		}
if( map1 && map2 && map3 )
{
	destruct(zhi1);
        destruct(zhi2);
        destruct(zhi3);
       
	jade = new(__DIR__"ditu");
	jade->move(me);
message_vision("$N把手里的三张残缺不全的地图，仔细的对边，慢慢的粘在了牛皮纸上，拼成了一幅地图，\n",this_player());
	destruct(this_object());

}
else 
message_vision("$N把手里残缺不全的地图拼了一下，总是拼不出一幅地图。\n",this_player());

return 1;
}




