#include <ansi.h>
#include <room.h>;
inherit ROOM;
void create()
{	 
        set("short", "石室");
        set("long", @LONG
石室不大，左右两边的石壁上刻着几行字（zi）,当中有张石案，案上摆着一把宝剑，
长不及一尺，剑身成龙型，看来毫不出奇，即无光泽，又不锋利，可是那既不是铁的，也
不是木的，连柄带剑都不知是什么东西制成的。
LONG);
        set("exits", ([ 
		"out" : __DIR__"naiheqiao",
	//	"enter" : __DIR__"shishi2",
				
	]));
 
	set("objects", ([
	          __DIR__"obj/shian" : 1,

	]));

set("item_desc",([
		"zzi"	:	"\n\t\t\t左边写着：\n\n\n" 				
					"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n"
					"\t\t∷　 　　　　　　　　　　 ∷\n"
                                  "\t\t∷　  无天神力者休进洞门  ∷\n"
                                  "\t\t∷　　 　　　　　　　　　 ∷\n"
                 	  		"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n\n\n",
				                                                             

		"yzi"	:	"\n\t\t\t右边写着：\n\n\n" 
					"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n"
					"\t\t∷　 　　　　　　　　　　 ∷\n"
                                  "\t\t∷ 未食天龙丹，即无天神力 ∷\n"
                                  "\t\t∷　　 　　　　　　　　　 ∷\n"
                 	  		"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n\n\n",
	
		"wall"	: 	"\n\t五气朝阳剑法一招三式，有缘学之，天下无敌：\n\n" 
					"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n"
					"\t\t∷    第一式：一气朝阳 　 ∷\n"
                                  "\t\t∷    第二式：三气朝阳    ∷\n"
                                  "\t\t∷　  第三式：五气朝阳 　 ∷\n"
                 	  		"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n\n"
				"\n\t剑诀：......龙伏池中不成龙，形龙必出，龙出池中，先摆头后摆尾，头
	      动，尾剑乘隙而入......龙摆尾后，体蟠方能腾空入云......随即
              遨游云海，无忧无我，入海腾云，随心所欲。......\n",

		]));

       setup();
}

void reset()
{
	object con, item, *inv;
	::reset();
	if( con = present("shi an",this_object()))
	if( inv = all_inventory(con))
	if( !sizeof(inv))
        {
        item = new(__DIR__"obj/feilong-jian");
        item->move(con);
        }       
}


void init()
{
         add_action("do_study", "lingwu");
}
int do_study(string arg)
{
          mapping fam;
          object me;
          me = this_player();

          if ( !living(me) ) return 0;
	      
	     if ( !arg || arg =="" || arg!="wall" ) return 0;
	      	
    //      if (me->query("title") != "普通百姓" )
    //      return notify_fail("你无法领悟五气朝阳剑法！！\n");

          if ( me->query("int") <24  &&  me->query("con") <24  &&  me->query("str") <22  )
          return notify_fail("你资质不够，永远无法学会五气朝阳剑法，你还是死了这条心吧！！\n");

	   if ((int)me->query_skill("literate", 1) < 30)
          return notify_fail("你斗大的字都认识不了几个,还是去进修一下再来学吧。 \n");

          if ((int)me->query("bellicosity") > 100)
          return notify_fail("你的杀气太重，无法领悟五气朝阳剑法。\n");

          
          if ((int)me->query_skill("wuqichaoyang", 1) >= 100)
          return notify_fail("墙上所述对你而言过于肤浅,你无法再从中领悟出新的东西。\n");

          if ((int)me->query("sen") < 30)
          return notify_fail("你今天太累了,还是休息一下吧. \n");

          write("你静心研习墙上的《五气朝阳剑法》，对五气朝阳剑法有些领悟。\n");
         
          me->receive_damage("gin", 15+random(10));
          me->receive_damage("kee", 15+random(10));
          me->improve_skill("wuqichaoyang", (int)(me->query_con()/2) +
                                                          (int)(me->query_skill("literate")/5) );
          
          return 1;
}


