// chexiangtan.c 车厢潭 

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "车厢潭");
	set("long", @LONG
这里位于高冠瀑布的上游，四周巨石突兀，环绕而成一潭，称车厢潭。
潭清见底，细石如鳞，历历可数，为寻幽探奇之佳地。
LONG
	);
        set("outdoors", "quanzhen");

	set("exits", ([
		"southdown" : __DIR__"gaoguanpubu",
        ]));
	set("objects", ([
		(__DIR__"obj/stone1") : 2]));

	setup();
}


void init()
{
        add_action("do_dive","dive");
}

int do_dive()
{
        object me = this_player();
        message_vision("$N纵身跃起，空中一个浪里翻花，头下脚上，[咚]的一声潜入潭中不见了.\n", me);
        me->move(__DIR__"tan1");
        return 1;
}
