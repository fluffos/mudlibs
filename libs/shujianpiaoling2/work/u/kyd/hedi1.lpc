

#include <room.h>
inherit ROOM;

void create()
{
        set("short", "河底");
        set("long", @LONG
四周黑忽忽的，头顶上看不见一点亮光，身边的水流忽上忽下的涌动着。
脚下似乎有一点亮光，也不知是些什么。周围一片死寂。
LONG
        );
//        set("exits", ([ /* sizeof() == 1 */
//  "west" : __DIR__"guangchang",
// ]));
        set("no_clean_up", 0);
        set("outdoors", "全真教");

        setup();
  
}
void init()
{
        if(interactive(this_player()))
        call_out("do_flush",3,this_player());
        
}

void do_flush(object me)
{
        object room;
        me = this_player();

        if(!me || environment(me) != this_object())
                return;
        write("忽然一道暗流冲来，你脚下一个踉跄，大叫一声：不好！\n");
        message("vision","前面的人影身行猛然一晃，急剧向下坠去。看来是凶多吉少了!\n",
                        environment(me), ({me}) );
        room= load_object(__DIR__"taiyihu2");
        me->move(room);
        message_vision("湖水一阵翻涌，砰的一个人被抛了上来。\n", me);

        
}     