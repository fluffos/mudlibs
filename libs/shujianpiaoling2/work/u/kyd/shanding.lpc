inherit ROOM;
int do_ci(string arg);
void create()
{
        set("short", "终南山顶");
        set("long", @LONG
这里是终南山山峰绝顶，眺望四周，青山丛林，一望无际。山顶正
中竖立着一块大石头。石头的背后，好象有人用手指写了一首诗(shi)。
在这首诗歌的边上，还有五个用手指刺出的小洞(dong)。
LONG
        );
   set("exits", ([ 
	     "southdown" : __DIR__"sheshentai",
]));
       set("objects", ([
		__DIR__"npc/guailao" : 1,
 	]));
	

  set("item_desc",([
		"shi"	:		"\n\t\t\t石上有首诗，诗云：\n\n\n" 
					"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n"
					"\t\t∷　　　　　　　　　　　　　　          ∷\n"
                                  "\t\t∷    子房志亡秦，曾进桥下履。佐汉开鸿  ∷\n"
				       "\t\t∷　　　　　　　　　　　　　　          ∷\n"
                                  "\t\t∷举，屹然天一柱，要拌赤松游，功成拂衣  ∷\n"
	 	                    "\t\t∷　　　　　　　　　　　　　　          ∷\n"
                 	       	"\t\t∷去。异人与异书，乘时或割据。妄迹复知  ∷\n"
					"\t\t∷　　　　　　　　　　　　　　　        ∷\n"
					"\t\t∷非，收心活死人。入传入道初，二仙此想	∷\n"
					"\t\t∷　　　　　　　　　　　　　　        	∷\n"
					"\t\t∷遇。于今终南下，殿阁凌烟雾。        	∷\n"
					"\t\t∷				      	∷\n"
					"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n\n\n",
							
		]));
          
     setup();
}
void init()
{
	add_action("do_ci", "ci");
}

int do_ci(string arg)
{
	object me;
	int gin_cost;

	me = this_player();

	if ( !arg || ( arg != "dong" ) )
		return notify_fail("什么？\n");

	gin_cost = random(50)+1;
	if(((int)me->query("potential")- (int)me->query("learned_points")) <= 1)
		return notify_fail("你的潜能不够！\n");
	if((int)me->query("gin") < 50)
		return notify_fail("你现在精神无法集中！\n");
	if ( (int)me->query_skill("yiyang-zhi", 1) < 40)
		return notify_fail("你对着洞口琢磨了半天，什么也没发现。\n");
	if ( (int)me->query_skill("yiyang-zhi", 1) < 200)
			me->improve_skill("yiyang-zhi", me->query("int"));
	write("你伸出了食指，对着五个小洞一一刺了进去，只觉得手指隐隐生疼。\n");
	write("你似乎对五个小洞的奥妙有所领悟。\n");
	me->add_temp("wuqichaoyang/learn",1);
	me->add("gin", -gin_cost);
	me->add("potential", -1);
	return 1;
}


