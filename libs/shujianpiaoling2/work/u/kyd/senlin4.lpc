
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "千石林");
	set("long", @LONG
这里除了石头还是石头，高的、矮的、胖的......千奇百怪形态各异的石
头布满了四周。前进的路已经被石头所遮掩，要找到(search)出去的路，就必
须靠自己的运气和经验。
LONG
	);
        set("outdoors", "quanzhen");

	set("exits", ([
		"west" : __DIR__"senlin1",
		"east" : __DIR__"senlin2",
             "north": __DIR__"senlin3", 
		"south" : __DIR__"senlin4",

	]));
	setup();
	
}



void init()
{
	add_action("do_search", "search");
}

int do_search(string arg)
{
	int	kar;
	object	box, pearl, nroom;


		kar = this_player()->query("kar");

		if(random(kar+570) < kar) {
			message_vision(HIY "\n$N已经筋疲力尽，却始终无法找到一条出去(out)的道路。\n" NOR, this_player());
 message_vision(HIY "\n$N受到了太大答的惊吓，晕了过去！\n" NOR, this_player());
                        this_player()->unconcious();
			return 1;
		}
	            if(random(kar+270) < kar) {
		message_vision(HIY "$N眼前一亮，终于在千石林中发现一条通往风洞(out)的小路。\n" NOR, this_player());
                        if( !query("exits/out") ){ 
                         set("exits/out", __DIR__"shanlu9");
                   call_out("close_path", 1);
                 	return 1;
}
            	
}
return notify_fail("\n你已经被千石林中的幻景所迷惑，甚么都没发现。\n");
}

void close_path()
{
    if( !query("exits/out") ) return;
        message("vision",
"你眼前一花，找到的出路又被石头遮掩掉了．\n",
                this_object() );
                delete("exits/out");
}






