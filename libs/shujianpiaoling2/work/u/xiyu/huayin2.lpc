inherit ROOM;

void create()
{
        set ("short", "华阴县酒馆");
        set ("long", @LONG
酒馆不大，屋中零乱的摆了几张方桌，几条长凳。小柜台上摆了些
酒坛，所卖也不过是些花生米，老白干之类。累了一天的苦力人总爱
凑到一起喝几杯，吹吹牛，消磨时光。
LONG);
        set("exits", ([
  "east" : __DIR__"huayin1",
]));

        set("no_clean_up", 0);
        set("objects", 
        ([ //sizeof() == 1
              "/npc/nknpc" : 1,
		__DIR__"npc/jiubao" : 1,
        ]));

        setup();
        replace_program(ROOM);
}

