inherit ROOM;

void create()
{
        set("short", "大道");
        set("long", @LONG
这是一条通往华阴县的青石大道。西南面隐约可以看到华阴县的城墙。
LONG
        );
        set("exits", ([
  "northeast" : __DIR__"xxroad2",
  "west" : __DIR__"huayin1",
]));

        set("no_clean_up", 0);
        set("outdoors", "xiyu");

        setup();
        replace_program(ROOM);
}

