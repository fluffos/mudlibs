inherit NPC;
int eff_kees(object me);
void create() {
  object me = this_player();
  set_name("御林军兵", ({ "army men" }));
  set("title", "一百名");
  set("attitude", "heroism");
  set("pursuer", 1);
  set("vendetta_mark", "authority");
  set("str", 100);
  set("long",
    "这是一队军容整齐的御林军，约有一百人之多。\n");
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("max_gin", 10000);
  set("kee", 10000);
  set("sen", 10000);
  set("gin", 10000);
  set("combat_exp", 1000000);
  set("score", 1000);
  set_skill("spear", 50);
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("move", 50);
  set_skill("dodge", 50);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: eff_kees(this_object()) :),
  }));
  setup();
  carry_object("/obj/weapon/longspear")->wield();
  carry_object("/d/city/obj/cloth/bingfu")->wear();
  call_out("eff_kees", 2, me);
}
void init() {
  add_action("do_look", "look");
}

int do_look(string arg) {

  if (arg == "army men") {
    write("这是一队军容整齐的御林军，约有一百人之多。\n");
    write("他们军纪严明，刀枪林立。\n");
    write("御林军旗号在风中飘扬，猎猎作响，煞是威风。\n");
    return 1;
  }
  return 0;
}

int heal_up() {
  object mguard = this_object();
  mguard->set("title", chinese_number(mguard->query("kee") / 100) + "名");
  return ::heal_up() + 1;
}
int eff_kees(object me) {
  object mguard = this_object();
  mguard->set("title", chinese_number(mguard->query("kee") / 100) + "名");
  return 1;
}

void die() {
  ::die();
}
int accept_fight(object me) {
  command("say 我们身负镇守边关的重任，不敢违反军纪。\n");
  return 0;
}
