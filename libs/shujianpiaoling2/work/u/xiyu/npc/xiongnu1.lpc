#include <ansi.h>
inherit NPC;
void create()
{
        int i,amun;
        string *order = ({"完颜", "耶律", "赤福", "萨木", "忽尔", 
"完颜", "耶律", "赤福", "萨木", "忽尔"});
	string *orderr = ({"定国", "安邦", "抚民", "守疆", "平安",
"国泰", "民安", "丰谷"});
        set_name( order[random(9)] + orderr[random(7)], ({ "xiongnu jiang" }) );
	set("gender", "男性" );
	set("age", random(20)+20);
	set("title","匈奴武将");
	set("str", 50);
        set("cor", 50);
        set("max_kee", 1000);
        set("max_sen", 1000);
        set("max_gin", 1000);
	set("bellicosity", 100 );
	set("long",
"他是一位匈奴的将领，长得虎背熊腰，威风凛凛。\n");
        set("attitude", "heroism");
	set("class", "xiongnu_jiang");
	set("combat_exp", 1000000);
	set_skill("parry", 300);
	set_skill("dodge", 300);
	set_skill("unarmed", 300);
	set_skill("hammer", 300);
        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/damage", 30+random(40));
        set_temp("apply/armor", 70);
        set_temp("apply/move", 100);
	setup();
        carry_object("/d/city/npc/obj/kiujia")->wear();
        carry_object("/d/city/obj/weapon/hammer/bahammer")->wield();
}

void die()
{
	object head;
	string headname;
	headname=this_object()->query("name");
	head=new("/u/xiyu/obj/head");
	head->set("name",headname+"的首级");
	head->move(this_object());
	::die();
}


