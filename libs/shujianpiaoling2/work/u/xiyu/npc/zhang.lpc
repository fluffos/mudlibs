// wujiang.c 武将
#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int about_help();

void create()
{
        set_name("张坚浩", ({ "zhang jianhao", "zhang", "jianhao" }));
        set("gender", "男性");
        set("title", "玉门关总兵");
        set("nickname", CYN"浩气长存"NOR);
        set("age", random(10) + 30);
        set("str", 35);
        set("dex", 16);
        set("long", "他是玉门关的守将。\n");
        set("combat_exp", 1750000);
        set("attitude", "heroism");
        set("pursuer", 1);
        set("vendetta_mark", "authority");

        set_skill("unarmed", 80);
        set_skill("force", 80);
        set_skill("spear", 180);
        set_skill("dodge", 80);
        set_skill("yang_spear", 180);
        set_skill("move", 70);
        set_skill("parry", 180);
	map_skill("spear","yang_spear");
	map_skill("parry","yang_spear");
        set_temp("apply/attack", 15);
        set_temp("apply/damage", 10);
        set("inquiry", ([
                "help" : (: about_help :),
        ]));

        set("force", 700); 
        set("max_force", 700);
        set("force_factor", 10);

        setup();
        carry_object("/obj/weapon/longspear")->wield();
        carry_object("/obj/cloth/tiejia")->wear();
}
int accept_fight(object me)
{
        command("say 本将军重任在身，恕不奉陪！");
        return 0;
}
int about_help()
{
	object me, armymen;
	me = this_player();
	if( me->query("class") != "official" ) return 0;
	if( (int)me->query("id_type") != 4 ) return 0;

	if( me->query("guanfu/delay")=="navy" )
	{
        command("say 向我借兵吗？好吧，借给你一支弓箭手部队吧！");
	if( random(9)>4)
	 me->set("quest/guanfu","navy1");
	else
	 me->set("quest/guanfu","navy2");
	me->set("battle/equip", "火箭");
	me->set("battle/damage", 50);
	me->delete("guanfu/delay");
	return 1;
	}

	if( !me->query("quest/battle") || me->query("quest/battle")==0 )
	{
        command("say 对不起，你没有战斗任务。");
	return 1;
	}

	if( (int)me->query_skill("strategy") < 30 )
	{
        command("say 你的兵法战策太差了，会用投石车吗？");
	return 1;
	}

	if( me->query_temp("get_toushiche") )
	{
        command("say 投石车已经用完了，正在制造新的。");
	return 1;
	}

        command("say 新的投石车已经打造完毕，请将军谨慎使用，扬我国威！");
	armymen = new("/u/xiyu/npc/toushiche");
	armymen->move(environment(me));
	armymen->set("possessed",me);
	armymen->set("shoot_power",(int)me->query_skill("strategy")*(random(4)+1)*4 );
	armymen->set_leader(me);
	armymen->set("quest/battle", 1);
	me->set_temp("get_toushiche",1);

	return 1;
}


