// /u/xiyu/npc/toushiche.c
#include <ansi.h>
inherit NPC;
int do_detect(object me);
void create()
{
        set_name("投石车", ({ "toushi che" }) );
        set("attitude", "heroism");
	set("race", "野兽");
        set("pursuer", 1);
        set("vendetta_mark", "authority");
	set("str",50+random(50));
        set("long",
                "这是一辆笨重的投石车，由士兵们推动前进。\n");
        set("max_kee", 10000);
        set("max_sen", 10000);
        set("max_gin", 10000);
        set("kee", 10000);
        set("sen", 10000);
        set("gin", 10000);
        set("combat_exp", 1000000);
        set("shoot_power", 500);
	set("no_living",1);
        set_skill("unarmed", 50+random(50));
        set_skill("parry", 50+random(50));
        set_skill("move", 50+random(50));
        set_skill("dodge", 50+random(50));
	set("arrive_msg","缓缓行驶了过来");
        set("chat_chance", 50);
        set("chat_msg", ({
                (: do_detect :),
        }) );
        setup();
}
void init()
{
add_action("do_look","look");
add_action("do_shoot","shoot");
}

int do_look(string arg)
{

if (arg == "toushi che" )
{
write("这是一辆笨重的投石车，由士兵们推动前进。\n");
write("（你可以使用shoot指令进行发射。）\n");
return 1;
}
return 0;
}

void die()
{
	object owner;
	owner = this_object()->query("possessed");
	if(owner)
	owner->add("battle/reward", -200 );
	say("投石车哗啦啦一声散了架，变成了一堆废物。\n");
	destruct(this_object());
}

int do_detect(object me)
{
	object owner;
	me = this_object();
	owner = me->query("possessed");
	if ( !present(owner, environment(me)))
	{
	destruct(me);
	return 1;
	}
	if( owner->query("quest/battle")==0 )
	destruct(this_object());
return 1;
}

int do_shoot(object me)
{
	object owner, enemy;
	me = this_object();
	owner = this_player();
	if( owner->query("quest/battle")==0 )
	return notify_fail("你没有战斗任务！\n");
	if ( !present("xiongnu bing", environment(me)))
	return notify_fail("你周围没有敌人的军队！\n");
	if ( me->is_busy())
	return notify_fail("士兵们正在忙着装石块，不能立即进行发射。\n");

	if (present("xiongnu bing", environment(me)))
	{
	enemy=present("xiongnu bing", environment(me));
	message_vision(CYN "\n$N大声下令道：投石车准备！预备～～放～！\n\n"NOR,owner);
	message_vision(HIR "随着轰隆一声巨响，从投石车上飞起巨大的石块，猛向$n砸了过去！\n\n"NOR,me, enemy);
	COMBAT_D->report_status(enemy,1);
	enemy->receive_wound("kee", (int)me->query("shoot_power"));
	me->start_busy(3);
	return 1;
	}
return 1;
}

int accept_fight(object me)
{
	return notify_fail("你看花眼了吗？那是一辆车！\n");
}
