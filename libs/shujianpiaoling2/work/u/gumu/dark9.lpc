// Room: /open/hurt/oldtomb/dark9.c

inherit ROOM;
int thing = 0, got=0;

void create()
{
	set("short", "黑洞");
	set("long", @LONG
这里一片黑漆漆的，伸手不见五指，你什么都看不见。你只能
依稀的辨别出方向。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "southeast" : __DIR__"dark5",
  "west" : __DIR__"dark8",
  "northwest" : __DIR__"dark12",
  "southwest" : __DIR__"dark4",
]));
	set("no_clean_up", 0);

	setup();
}
void init()
{
        add_action("do_search", "search");
        add_action("do_open", "open");
}
int do_search(string arg)
{
  	object ob,me;
        me=this_player();

 	if(arg!="箱子") printf("你发现有个箱子，但是你拿不动。\n");
 if(arg=="箱子") {
	    if(thing==0) printf("箱子是锁住的!\n");
           else if(got==1) message_vision( "$N在箱子里找来找去，结果什么也没找到。\n", me );
           else {
               message_vision( "$N从箱子里拿出一把宝剑和一本玉女心经。\n", me );
		 ob=new(__DIR__"obj/heavensw");
		 ob->move(me);  
		 ob=new(__DIR__"book/ninemoon");
		 ob->move(me);  
               got = 1;
		}

}
 	return 1;  
}
int do_open(string arg)
{	
	object obj;
	obj=present("yaoshi",this_player());

	if(arg!="箱子") printf("你要打开什么？\n");
	else if( ! present("yu yaoshi",this_player()) ) 
		printf("箱子是锁住的，你打不开！\n");
       else if(thing==1) printf("箱子已经是打开的。\n");
       else {
           message_vision( "$N拿出一把玉钥匙把箱子打开了。\n", this_player() );
	   destruct(obj);
	    thing = 1;	
	}
	return 1;	
}