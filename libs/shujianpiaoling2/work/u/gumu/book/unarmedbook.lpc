inherit ITEM;

void create() {
  set_name("古筝", ({ "gu zheng", "zheng", "book" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一把年数已经很老的古筝，看上去相当名贵。\n");
    set("value", 5000);
    set("material", "paper");
    set("skill", ([
      "name": "unarmed",
      "exp_required": 500,
      "sen_cost": 30,
      "difficulty": 20,
      "max_skill": 42
    ]));
  }
}
