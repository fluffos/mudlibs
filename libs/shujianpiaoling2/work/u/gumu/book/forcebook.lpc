inherit ITEM;

void create()
{
	set_name("竹片", ({ "bamboo", "book" }));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "片");
		set("long", "一片竹片，上面好象写了些字。\n");
		set("value", 500);		
		set("material", "bamboo");
		set("skill", ([
			"name":	"force",	
			"exp_required":	0,	
			"sen_cost":	20,	
			"difficulty":	20,	
			"max_skill":	32
		]) );
	}
}
	