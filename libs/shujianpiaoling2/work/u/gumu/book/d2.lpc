inherit ITEM;

void create()
{
	set_name("拳法提高篇", ({ "silk", "book" }));
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "块");
		set("long", "一本古书。\n");
		set("value", 500);
		set("material", "silk");
		set("skill", ([
			"name":	"unarmed",	
			"exp_required":	0,	
			"sen_cost":	10,	
			"difficulty":	10,	
			"max_skill":	50
		]) );
	}
}