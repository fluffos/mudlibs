inherit NPC;

void create()
{
      object ob;

        set_name("茶水妞", ({ "tea girl","girl" }) );
        set("gender", "女性" );
        set("age", 18);
        set("long",
"她是一位漂亮的女孩，站在那里楚楚动人.\n"
"她正忙着为客人倒茶送菜。\n");
        set("combat_exp", 70000);
        set("force",1000);
        set("max_force", 1000);
        set_skill("force",50);
        set_skill("dodge", 50);
        set_skill("snow-dance", 50);
        map_skill("dodge","snow-dance");
        set_skill("unarmed", 110);
 	set("inquiry", ([
        "千古神器" : "那是把锋利无比的倚天剑，当年师祖留下的。\n",
        "九阴真经" : "我们古墓派的内功，是臭牛鼻子王重阳送给师祖的! \n",
        ]));
    
          set("chat_chance", 7);
        set("chat_msg", ({
"请问你想喝点什么？要茶么？\n",
"我做的蛋糕很好吃，想尝尝么？\n",
        }) );

        create_family("古墓派",4,"弟子");

        setup();
   carry_object(__DIR__"obj/necklace")->wear();

}


