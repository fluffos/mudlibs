inherit NPC;

void create() {
  set_name("玉鹿天女", ({ "yulu tiannv", "yulu", "tiannv" }));
  set("gender", "女性");
  set("age", 21);
  set("per", 60);
  set("long",
    "她是一位美女，真是红颜似玉，绿鬓如云，明丽的眼睛，\n"
    "洁白的牙齿。容色俊俏，风度飘逸，令人心动。\n");
  set("combat_exp", 9000000);
  set("kee", 3000);
  set("max_kee", 3000);
  set("force", 9000);
  set("max_force", 9000);
  set("force_factor", 90);
  set("sen", 2000);
  set("max_sen", 2000);
  set_skill("literate", 220);
  set_skill("force", 220);
  set_skill("dodge", 220);
  set_skill("unarmed", 220);
  set_skill("beauty-force", 220);
  set_skill("beauty-sword", 220);
  set_skill("luohua_steps", 220);
  set_skill("tldw-shi", 220);

  map_skill("unarmed", "tldw-shi");
  map_skill("force", "beauty-force");
  map_skill("sword", "beauty-sword");
  map_skill("parry", "beauty-sword");
  map_skill("dodge", "luohua_steps");
  set("chat_chance", 7);
  set("chat_msg", ({
    "玉鹿天女说道：我的玉钗呢？\n",
    "玉鹿天女梳了梳头发。\n",
    "玉鹿天女眼睛眨呀眨看著你。\n"
  }));
  set("inquiry", ([
    "玉钗": "哎，上次我掉在玉女洞里了，怎么也找不到。\n",
  ]));
  //        create_family("小孤山",2,"弟子");
  setup();
  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/dress")->wear();
  carry_object(__DIR__ "obj/redbelt")->wear();
  carry_object(__DIR__ "obj/flower_boot")->wear();
}

void init() {
  add_action("do_killing", "kill");

}

int accept_object(object me, object ob) {
  object clasp;
  me = this_player();
  if ((string)ob->query("name") != "玉钗") {
    command("angry");
    command("say 拿这东西来戏弄我，想找死吗？\n");
  } else {
    command("sigh");
    say("这位" + RANK_D->query_respect(me) + "，难得你如此有心，
小女子无以回报，这把钥匙你拿着，或许对你有用。
勿告他人，切记！\n\n");
    ob = new(__DIR__ "obj/key");
    ob->move(this_player());
  }
  return 1;
}
int do_killing(string arg) {

  object player, victim;
  string name;
  player = this_player();
  if (objectp(victim = present(arg, environment(this_object()))) && living(victim)) {
    name = victim->name();
    if (name == "梅花鹿") {
      message_vision("$N柳眉一竖，杏眼圆睁，喝道：你敢伤我爱鹿，拿命来！\n", this_object());
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      return 0;
    }
    return 0;
  }
  return 0;
}
int accept_fight(object me) {
  return 0;
}
