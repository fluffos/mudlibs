inherit NPC;
inherit F_VENDOR;

void create() {
  object ob;

  set_name("颜如玉", ({ "Ru Yu", "yu", "ru yu" }));
  set("gender", "女性");
  set("age", 27);
  set("long",
    "她是一位美女，真是红颜似玉，绿鬓如云，明丽的眼睛，\n"
    "洁白的牙齿。容色俊俏，风度飘逸，令人心动。\n");
  set("combat_exp", 170000);
  set("force", 1000);
  set("max_force", 1000);
  set_skill("force", 50);
  set_skill("dodge", 230);
  set_skill("stormdance", 50);
  map_skill("dodge", "stormdance");
  set_skill("unarmed", 110);
  set("inquiry", ([
    "buy": (: this_object(), "ask_buy" :)
  ]));
  set("chat_chance", 7);
  set("chat_msg", ({
    "颜如玉说道：欢迎你加入古墓派。\n",
    "颜如玉梳了梳头发。\n",
    "颜如玉眼睛眨呀眨看著你。\n"
  }));
  create_family("古墓派", 2, "弟子");
  setup();
  ob = carry_object(__DIR__ "obj/dagger");
}
