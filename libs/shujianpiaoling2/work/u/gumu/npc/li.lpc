inherit NPC;

void create()
{
        set_name("李莫愁", ({ "li mochou", "li" }) );
        set("gender", "女性" );
        set("age",23);
        set("long", @TEXT
这是古墓派二代弟子中的矫矫者，她冷若冰霜。
却掩饰不住她那动人的身材。
TEXT
);
        set("combat_exp", 200000);
        set_skill("unarmed",100);
        set_skill("force",100);
       	set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("sword", 100);
        set("force",1500);
        set("max_force",1500);
        set("force_factor",50);
        set("attitude","peaceful");
        set_skill("beauty-force", 100);
        set_skill("beauty-sword", 100);
        set_skill("snow-dance", 100);
        set_skill("tldw-shi", 100);
       
        map_skill("unarmed", "tldw-shi");
        map_skill("force","beauty-force");
        map_skill("sword", "beauty-sword");
        map_skill("parry", "beauty-sword");
        map_skill("dodge", "snow-dance");

	create_family("古墓派",2,"弟子");
	setup();
	carry_object(__DIR__"obj/redbelt")->wear();
	carry_object(__DIR__"obj/longsword")->wield();
}
void attempt_apprentice(object ob)
{
 	if (ob->query("betrayer")>=1) {
     command("say 古墓派不收不忠之徒，" + RANK_D->query_respect(ob)
			+ "您还是回去吧。\n");
	return;
}
        command("hehe");
        command("say 嘿嘿，" + RANK_D->query_respect(ob) + 
"你真倒霉，既然加入古墓派，就不许偷懒了。\n");
        command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "oldtomb");
}
