inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("小龙女", ({ "master oldtomb", "oldtomb", "master" }) );
        set("gender", "女性" );
        set("age", 20);
        set("str", 27);
        set("cor", 30);
        set("cps", 27);
        set("int", 24);

        set("max_force", 2500);
        set("force", 2500);
        set("force_factor", 100);
 	create_family("古墓派", 1, "掌门人");

        set("long",
"小龙女看上去弱不禁风，楚楚动人。\n"
                "难以想象她竟是古墓派的掌门人。\n");

       create_family("古墓派", 1, "掌门人");

        set("combat_exp", 1500000);
        set("score", 200000);

      
        set_skill("unarmed", 220);
        set_skill("parry", 240);
        set_skill("dodge", 240);
        set_skill("sword", 250);
        set_skill("force", 250);
        set_skill("literate", 120);
        set_skill("beauty-force", 250);
        set_skill("beauty-sword", 250);
        set_skill("snow-dance", 250);
        set_skill("tldw-shi", 240);
       
        map_skill("unarmed", "tldw-shi");
        map_skill("force","beauty-force");
        map_skill("sword", "beauty-sword");
        map_skill("parry", "beauty-sword");
        map_skill("dodge", "snow-dance");
        set("inquiry", ([
                "颜如玉" : 
"她从小就是我的丫鬟，是我最信任的弟子。",
                "玉女洞" : 
"古墓派的弟子，多多少少都知道一些，你去问她们吧。",
                  ]) );

        setup();
        carry_object(__DIR__"obj/sword")->wield();
        carry_object(__DIR__"obj/dress")->wear();
  		carry_object(__DIR__"obj/belt")->wear();
 		carry_object(__DIR__"obj/boot")->wear();
}

void attempt_apprentice(object ob)
{
        if( ((int)ob->query("combat_exp") < 100000) 
        ||      ((int)ob->query("cps") < 20)) {
                command("say 我选择弟子要求很严，依我看" + 
RANK_D->query_respect(ob) + "的条件还不够!");
                return;
        }
 	else if( ob->query("betrayer")) {
     command("say 我不收不忠之徒。\n");
	return;
}

	             
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + 
"很好，你的资质不错，好好努力。\n");
        command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "oldtomb");
}
    