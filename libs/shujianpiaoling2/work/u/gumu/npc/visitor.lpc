inherit NPC;

void create()
{
	set_name("游客", ({ "visitor" }) );
	set("race", "人类");
	set("age", 20);
	set("long", "这位游客一身江南书生的打扮，但是从他气质可以看出这是一个纨绔子弟。\n");
	set("attitude", "friendly");
	set("per", 10);	
	set("str", 26);
	set("cor", 30);
	set("gender","男性");
	set_skill("unarmed",20);
	set_skill("dodge",30);
	set_skill("parry",20);
	set("combat_exp", 3000);

	set("chat_chance", 6);
	set("chat_msg", ({
		(: this_object(), "random_move" :),
	"游客说道：小生文武双全，才高十八斗！\n",
	}) );

	set("chat_msg_combat", ({
		(: this_object(), "random_move" :),
		"呔，小爷从未怕过谁！\n",
		"游客突然跳了起来，双手乱抓乱打，却不知道是在打谁。\n"
	}) );
	setup();
	add_money("silver",15);
}
