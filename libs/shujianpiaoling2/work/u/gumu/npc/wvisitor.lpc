inherit NPC;

void create()
{
	set_name("武林游客", ({ "youke", "visitor" }) );
	set("race", "人类");
	set("age", 20);
	set("long", "这位游客一身青衣，腰间佩着一把长剑，显然是武林中人。\n");
	set("attitude", "friendly");
	set("per", 10);	
	set("str", 26);
	set("cor", 30);
	set("gender","男性");
	set_skill("unarmed",120);
	set_skill("dodge",130);
	set_skill("parry",120);
	set_skill("sword",120);
	set("combat_exp", 50000);

	
	setup();
	
 	carry_object(__DIR__"obj/qingyi")->wear();	
	 carry_object(__DIR__"obj/longsword")->wield();
}
