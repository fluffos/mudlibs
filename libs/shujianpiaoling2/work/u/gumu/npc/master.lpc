#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("霍无影", ({ "master oldtomb", "oldtomb", "master" }) );
        set("gender", "男性" );
        set("age", 40);
        set("str", 67);
        set("cor", 30);
        set("cps", 27);
        set("int", 24);
        set("title", "守墓人"NOR );
        set("nickname", HIW"古墓英魂"NOR );
        set("max_force", 2500);
        set("force", 2500);
        set("force_factor", 100);
 	create_family("古墓", 3, "掌门");
        set("class", "oldtomb");
        set("long",
"这是一个浑身素白，面无表情的中年男子。\n");
        set("combat_exp", 9000000);
        set("score", 2000);
        set_skill("unarmed", 220);
        set_skill("parry", 240);
        set_skill("dodge", 240);
        set_skill("move", 200);
        set_skill("sword", 250);
        set_skill("force", 250);
        set_skill("literate", 120);
        set_skill("nodeath_force", 250);
        set_skill("wudi_sword", 250);
        set_skill("bagua-steps", 250);
        set_skill("tldw-shi", 240);
        set_skill("tieshishu", 160);
       
        map_skill("unarmed", "tldw-shi");
        map_skill("force","nodeath_force");
        map_skill("sword", "wudi_sword");
        map_skill("parry", "wudi_sword");
        map_skill("dodge", "bagua-steps");
        set("inquiry", ([
                "玉女洞" : 
"古墓历代前辈的栖息之地，我会一生一世在此守护她们的灵位。",
                  ]) );
        setup();
        carry_object(__DIR__"obj/sword")->wield();
 		carry_object(__DIR__"obj/boot")->wear();
 		carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
if( ((int)ob->query_skill("literate",1) > 100) 
        ||      ((int)ob->query("cps") < 20)) {
                command("say 我选择弟子要求很严，依我看" + 
RANK_D->query_respect(ob) + "的条件还不够!");
                return;
        }
 	else if( ob->query("betrayer")) {
     command("say 我不收不忠之徒。\n");
	return;
}

	             
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + 
"很好，你的资质不错，好好努力。\n");
        command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "oldtomb");
                ob->set("id_type", 1);
}
    
int accept_object(object who, object ob)
{
        object me;
	string mat,typ,newobj;
	int newrank;
	me = this_player();
	if(me->query_temp("use_jiguan_ren")!="oldtomb")
	{
		say(CYN"霍无影摇了摇头，说道：你没有掌握本派铁石注生术，我帮不了你。\n"NOR);
		return 0;
	}
	if( ob->query("mat_type"))
	{
	mat = ob->query("material");
	typ = ob->query("mat_type");
	newobj = typ+"-"+mat;
	newrank=TROOP_D(newobj)->effective_level();
	me->set_troop(newobj, newrank);
        say( CYN"霍无影把"+ob->name()+"放入铸石机中，不久铸成了"+ to_chinese(newobj) +"。\n"NOR);
	message_vision(CYN"霍无影将"+ to_chinese(newobj) +"交给$N，说道：请善加利用这些机关元件。\n"NOR,me);
	return 1;
        }
		else {
			say(CYN"霍无影摇了摇头，说道：这东西无法作为机关原料。\n"NOR);
			return 0;
                }
        return 1;
}
