inherit NPC;

void create()
{
    set_name("小麻雀", ({ "sparrow" }) );
	set("race", "野兽");
	set("age", 10);
	set("gender", "雌性");
     set("long", "一只灰色的小麻雀。\n");

    set("str", 20);

    set("combat_exp", 8000);
	set("attitude","peaceful");

	set("limbs", ({ "头部", "身体","翅膀" }) );
    set("verbs", ({ "bite","claw" }) );
    set_temp("apply/dodge", 60);

    set("chat_chance", 7);
	set("chat_msg", ({
        "小麻雀叽叽的叫! \n",
        "小麻雀用嘴整理羽毛。 \n"
	}) );

	setup();
}
