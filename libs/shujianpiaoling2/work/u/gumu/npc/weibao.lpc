#include <ansi.h>
inherit NPC;
int about_quest();
string *names = ({
  "兽骨甲",
  "金环锁子甲",
  "牛皮盾",
  "狼皮裙",
  "藤甲",
  "铁甲",
  "熟铜甲",
  "亮银甲",
 });

void create()
{
        set_name("韦保", ({ "wei bao", "wei" }) );
        set("gender", "男性" );
        set("age",32);
        set("title","瞎子");
        set("long", @TEXT
这是一个双目失明的落第书生。你可以向他申请任务。
TEXT
);
        set("combat_exp", 500000);
        set_skill("unarmed", 120);
        set_skill("parry", 140);
        set_skill("dodge", 140);
        set_skill("sword", 150);
        set_skill("force", 150);
        set_skill("literate", 120);
        set_skill("nodeath_force", 150);
        set_skill("wudi_sword", 150);
        set_skill("bagua-steps", 150);
        set_skill("tldw-shi", 140);
       
        map_skill("unarmed", "tldw-shi");
        map_skill("force","nodeath_force");
        map_skill("sword", "wudi_sword");
        map_skill("parry", "wudi_sword");
        map_skill("dodge", "bagua-steps");
        set("inquiry", ([
                "quest" : (: about_quest :),
        ]));

	create_family("古墓",4,"弟子");
	setup();
	carry_object(__DIR__"obj/belt")->wear();
	carry_object(__DIR__"obj/longsword")->wield();
}
void init()
{
	add_action("do_gogo", "go");
	add_action("do_cancel", "cancel");
}

int do_gogo(string arg)
{
	object me;
	me = this_player();
	if( arg != "south" )
	{
	command("say 古墓墓室，请勿乱闯！\n");
	write("这个方向的路被韦保挡住了 。\n");
	return 1;
		}
		else
	return 0;
}
void attempt_apprentice(object ob)
{
     command("say 我不收徒弟，" + RANK_D->query_respect(ob)
			+ "您还是回去吧。\n");
	return;
}

int do_cancel(string arg)
{
	object me=this_player();
	if(!arg || arg!="quest")
          return notify_fail("你要取消什么？\n");
	if (!me->query("marks/gmjob"))
          return notify_fail("你现在没有任务。\n");
	say( CYN"韦保叹道：不想做了吗？好吧，你自己反省一下。\n"NOR);
	if( (int)me->query("combat_exp") <= 100 ) 
		{
			me->delete("marks/gmjob");
			me->unconcious();
			return 1;
		}
	me->add("combat_exp", -random(100));
	me->delete("marks/gmjob");
	me->unconcious();
	return 1;
}

int about_quest()
{
	int task;
	object me=this_player();
	string questname = names[random(sizeof(names))];
	if (!me->query("marks/gmjob"))
	{
	say( CYN"韦保说道：我正替师父寻找［" + questname + "］，你去给我找来。\n"NOR);
	me->set("marks/gmjob",questname);
	return 1;
	}
	else{
	command("say 你还站在这里干什么？好好用功才是啊！");
	return 1;
	}
	return 1;
}

int accept_object(object who, object ob)
{
	int exp,pot;
	object me;
	me = this_player();
	exp = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
	if( ob->name() == (string)me->query("marks/gmjob") ) {
		say( CYN"韦保微笑点头，说道：很好，继续努力。\n"NOR);
		me->set("combat_exp", (int) exp + random(50) + 30);
		me->set("potential", (int) pot + random(50) + 30);
		me->add("score", random(20));
		me->add("life_exp", random(20));
		me->delete("marks/gmjob");
		return 1;
		}
	else{
		say(CYN"韦保说道：多谢你的好意，但这东西对我没用。\n"NOR);
		return 0;
	}
        return 1;
}
int accept_fight(object me)
{
        return 0;
}

