#include <room.h>

inherit ROOM;
int th = 0;

void create()
{
   set("short", "石洞");
	set("long", @LONG
你觉得眼前一亮，原来这个石洞是墓主的房间。洞的深处有一
个书柜，上面排列着许多武功密籍。旁边是张水晶床，用一张白色
的帐子罩着，朦朦胧胧看不清楚。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
    "south" :__DIR__"lian3",
    "east" :__DIR__"lian2",
]));

set("valid_startroom", 1);

      set("objects", ([
//          __DIR__"npc/rabbit" : 1,
          "/daemon/class/gumu/zhushiji" : 1,
	  __DIR__"npc/master" : 1,
   ]));

       set("no_clean_up", 0);

	setup();
	
}
void init()
{
        add_action("do_search", "search");
}
int do_search(string arg)
{
     object ob,me;
     me=this_player();
	
     if(arg=="床") {
           if( th == 0 ) {
	        printf("你在床上发现了一张纸和竹片。\n");
	        ob = new(__DIR__"book/forcebook");
	        ob->move(this_player());
	        ob = new(__DIR__"book/swordbook");
	        ob->move(this_player());
	        th = 1; }
            else printf("你在床上摸了半天，里面什么也没有。\n");
	     return 1;	

	}
}