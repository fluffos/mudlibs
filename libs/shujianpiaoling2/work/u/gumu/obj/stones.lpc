// pearl.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("碎石子", ({ "stone piece", "stone" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"一块普通的碎石子\n");
		set("unit", "堆");
		set("base_unit", "块");
		set("base_weight", 10);
		set("base_value", 1);
	}
	set_amount(20);
	init_throwing(1);
	setup();
}
