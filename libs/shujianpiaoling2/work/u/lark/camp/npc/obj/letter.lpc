// token1.c


inherit ITEM;

void create()
{
        set_name("推荐信",({ "letter" }) );
        set("long",
                "这是一封军用的推荐信\n"
                "被推荐人可以凭它去兵部谋职。\n");
        set_weight(100);
        
        if( clonep() )
                set_default_object(__FILE__);
        else 
                set("unit", "封");
        setup();
}

