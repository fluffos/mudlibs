#include <ansi.h>

inherit NPC;
string reward_more( object who);
void create()
{
        set_name(RED "长安军兵" NOR, ({ "bing" }) );
        set("long", "一个正在刻苦操练的士兵。\n");
        set("attitude", "heroism");
        set("age",20);
        set("str", 10);
        set("cor", 26);
        set("cps", 25);
        set("vendetta_mark", "authority");
        set("combat_exp", 50000);
        set_skill("spear",30);
        set_skill("unarmed", 30);
        set_skill("blade", 30);
        set_skill("parry", 30);
        set_skill("dodge", 30);
        set_skill("move", 50);
        set("max_kee", 800);
        set("kee", 800);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: reward_more(this_object()) :),
        }) );
        set("water", 400);
        set("food", 400);
        setup();

              carry_object("/d/city/obj/cloth/bingfu")->wear();


}

int accept_fight(object me)
{
  object ob;
  command("bow");
  command("say 苦练本领，杀敌报国！\n");
  return 1;
}
string reward_more(object who)
{
        int i;
        object *enemy;
        seteuid(getuid());
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
	if( enemy[i]->query("combat_exp") > 30000 ) return "1";
                        enemy[i]->add("combat_exp", 1);
			if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 200 ) return "1";
			else
		if(random(9)<5)
			enemy[i]->add("potential", 1);
			else
			enemy[i]->add("life_exp", 1);
                }
        }
        return "1";
}

