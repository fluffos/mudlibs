#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string  summon_more( object who);
void re_rank(object student);
void create()
{
         set_name("张智", ({ "zhang zhi","zhang" }) );
        set("long", "负责操练士兵武艺的军官。\n");
        set("title",RED "司隶校尉" NOR);
        set("attitude", "heroism");
        set("student_title","官员");
        create_family("朝廷",7,"官员");
        set("vendetta_mark", "authority");
        set("str", 20);
        set("int", 20);
        set("cor", 20);
        set("spi", 20);
        set("agi", 20);
        set("max_kee", 1000);
        set("max_gin", 1000);
        set("max_sen", 1000);
        set("kee", 500);
        set("gin", 500);
        set("sen", 500);
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 10);
        set("score", 90000);
        set_temp("apply/attack", 20);
        set_temp("apply/defense", 20);
        set_temp("apply/move", 20);
         set("class","official");

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
           (: perform_action, "spear.huima" :),
                
        }) );

        set("combat_exp", 1000000);
        set_skill("unarmed", 60);
        set_skill("dagger",60);
  set_skill("literate",10);
        set_skill("force",60);
        set_skill("parry", 60);
        set_skill("dodge", 60);
        set_skill("spear",60);
        set_skill("blade",60);
        set_skill("xingyi-ken",40);
//  set_skill("nezha_dagger",40)
        set_skill("bixueforce",40);
        set_skill("move", 80);
        set_skill("yang_spear",40);
        
       
        map_skill("unarmed","xingyi-ken");
        map_skill("force","bixueforce");
//  map_skill("dagger","nezha_dagger")
        map_skill("spear","yang_spear");
        setup();

        carry_object("/obj/cloth/tiejia")->wear();
        carry_object("/obj/weapon/longdagger")->wield();
}

void attempt_apprentice(object me)
{
       if(!me->query("solider",1)) {
            command("say 我这两下子沙场砍两个人还行，要是防身你还是找个高明的武师吧。\n");
            return;
        }       
        if(me->query("id_type")==4){
        
         command("blush");
         command("say 大人取笑了。在下怎敢班门弄斧？\n");
         return;
         }
        if(me->query("id_type") == 3)
        {
        command("haha");
        command("say 大人真爱开玩笑。文官就是舞文弄墨什么的干吗要学这粗活？\n");
        return;
        }
        if(me->query("id_type") == 5)
        {
        command("haha");
        command("say 大人言重了！抓个地痞流氓什么的不需要这么大动干戈的吧。\n");
         return;
        }
        
        
        command("pat"+me->query("id"));
        command("say 平时多流汗，战时少流血！好好用功，会派上用场。\n");
        command("recruit " + me->query("id") );
        me->set("class", "official");
        me->set("id_type", 4);
        remove_call_out("re_rank");
        call_out("re_rank",1,me);
      return;
                
}

int accept_object(object who, object ob)
{
   int som;
   som = ob->value();
   if(who->query("relation_exp") < 200000 )
   who->add("relation_exp",som/random(1000));
   tell_object(who,"张志暧昧的看了你一眼，：“有前途，将来一定吃得开。。呵呵”\n");
   return 1;
}

int recognize_apprentice(object ob)
{
 
        if((int)ob->query("combat_exp")+(int)ob->query("relation_exp")*5+(int)ob->query("life_exp")>200000){
           ob->set_temp("arra",1);
           return notify_fail("张智笑了笑：“人往高处走，水往低处流，你现在应该换换环境了，为什么不到兵部谋个职？\n");
          }
        
        return 1;
}

void re_rank(object student)
{
     student->set("title",RED "长安军兵" NOR);
     return;
}
