#include <ansi.h>

inherit NPC;
int do_dao();
int do_qiang();
int do_jia();
int do_dagger();
void create()
{
        set_name("安全", ({ "an quan","an" }) );
        set("long", "主管分发装备的一个老兵。\n");
        set("attitude", "friendly");
        set("age",50);
set("title",RED "军士" NOR);
        set("str", 10);
        set("cor", 10);
        set("cps", 10);
        set("vendetta_mark", "authority");
        set("chat_chance", 5);
        set("chat_msg", ({
            "安全语重心长的对你说：“安全第一，安全第一。。。呵呵”\n", })
);
        set("inquiry", ([
             "刀":(:do_dao:),
             "枪":(:do_qiang:),
             "戟":(:do_dagger:),
             "甲":(:do_jia:),
]) );
        set("combat_exp", 2000);
        set_skill("spear",20);
        set_skill("unarmed", 20);
        set_skill("blade", 20);
        set_skill("parry", 20);
        set_skill("dodge", 20);
        set_skill("move", 20);
        set_skill("yang_spear",20);     //杨家枪法
        set_skill("xingyi-ken",20);     //形意拳
        set_temp("apply/dammage", 5);
        set_temp("apply/defense", 5);
        set_temp("apply/attack", 5);
        map_skill("unarmed","xingyi-ken");
        map_skill("spear","yang_spear");
        setup();

        carry_object("/d/city/obj/cloth/bingfu")->wear();

}

int do_dao()
{
  object me,ob;
  me=this_player();
  if(me->query_temp("guanfu/weapon") ) return 0;
  if(!me->query("solider") && me->query("id_type")!=4){
     write(RED "老安摇了摇头:这里都是管制器械，不能随便发给你\n" NOR);
      return 1;
    }
  if(present("blade",me)){
      write(RED "老安摇了摇头：“你不是有了么？还要，现在国家象你这种挖墙脚的人太多了。所以才.....grin”\n" NOR);
      return 1;
      }
  ob=new("/obj/blade");
  message_vision("老安从库房里取出一把刀交给了$N,说道："+RED" 严格修炼，保证质量，杀敌立功，保卫祖国!" NOR,me);
  ob->move(me);
  me->set_temp("guanfu/weapon",1);
  return 1;
}


int do_qiang()
{
  object me,ob;
  me=this_player();
  if(me->query_temp("guanfu/weapon") ) return 0;
  if(!me->query("solider") && me->query("id_type")!=4){
     write(RED "老安摇了摇头:这里都是管制器械，不能随便发给你\n" NOR);
        return 1;
           }
  if(present("changqiang",me)){
      write(RED "老安摇了摇头：“你不是有了么？还要，现在国家象你这种挖墙脚的人太多了。所以才一年不如一年。哼！”\n" NOR);
       return 1;
        }
  ob=new("/u/lark/camp/obj/spear");;
 message_vision("老安从库房里取出一杆枪交给了$N,说道："+RED" 严格修炼，保证质量，杀敌立功，保卫祖国!" NOR,me);
   ob->move(me);
  me->set_temp("guanfu/weapon",1);
   return 1;
}

int do_jia()
{
  object me,ob;
  me=this_player();
  if(me->query_temp("guanfu/weapon") ) return 0;
  if(!me->query("solider") && me->query("id_type")!=4){
       write(RED "老安摇了摇头:这里都是管制器械，不能随便发给你\n" NOR);
       return 1;
      }
  if(present("armor",me)){
      write(RED "老安摇了摇头：“你不是有了么？还要，现在国家象你这种挖墙脚的人太多了。所以才一年不如一年。哼！”\n" NOR);
       return 1;
       }
  ob=new("/u/lark/camp/obj/jia.lpc");
  message_vision("老安从库房里取出一套盔甲交给了$N,说道："+RED" 严格修炼，保证质量，杀敌立功，保卫祖国!" NOR,me);
  ob->move(me); 
  me->set_temp("guanfu/weapon",1);
  return 1;
}


int do_dagger()
{
   object ob,me;
   me=this_player();
  if(me->query_temp("guanfu/weapon") ) return 0;
   if(!me->query("solider") && me->query("id_type")!=4){
       write(RED "老安摇了摇头:这里都是管制器械，不能随便发给你\n" NOR);
       return 1;
      }
     if(present("dagger",me)){
      write(RED "老安摇了摇头：“你不是有了么？还要，现在国家象你这种挖墙脚的人太多了。所以才一年不如一年。哼！”\n" NOR);
       return 1;
       }
     ob=new("/obj/weapon/dagger");
 message_vision("老安从库房里取出一把短戟交给了$N,说道："+RED" 严格修炼，保证质量，杀敌立功，保卫祖国!" NOR,me);
    ob->move(me);
  me->set_temp("guanfu/weapon",1);
    return 1;
}

