inherit NPC;
object offensive_target(object me);
void create() {
  int i, amun;
  string *order = ({ "张", "王", "李", "赵", "孙", "徐", "郑", "周", "吴",
    "蒋", "沈", "杨", "苗", "尹", "金", "魏", "陶", "俞", "柳", "朱" });
  string *orderr = ({ "阿红", "紫儿", "小明", "艳红", "楚楚", "丹凤", "绝色", "桂花" });

  set_name(order[random(20)] + orderr[random(8)], ({ "girl", "女子" }));
  set("title", "江湖女子");
  set("long", "一个矜持的女子，没有半点江湖豪气。\n");
  set("gender", "女性");
  set("age", 15 + random(10));
  set("combat_exp", 20000 + random(20000));
  set("str", 10);
  set("cps", 10);
  set("int", 10 + random(10));
  set("cor", 10);
  set("con", 10);
  set("spi", 10);
  set("per", 15 + random(10));
  set("kar", 10);
  set("agi", 40);
  set("max_kee", 9000);
  set_skill("dodge", 300);
  set_skill("move", 200);
  set_skill("unarmed", 150);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}


object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;
}

void heart_beat() {
  object me = this_object();
  object target;
  if (me->is_fighting())
    target = offensive_target(me);          //有效对手
    if (userp(target)) {                     //是player
      if (target->query("comabt_exp") > me->query("combat_exp") * 4 / 5
        && target->query("comabt_exp") < me->query("combat_exp") * 8 / 5)  //设定玩家范围
        target->add("combat_exp", 1);   //这个函数每一秒执行一次,也就是每秒 add exp 1 .
    }
  return ::heart_beat();
}
