// teacher.c

inherit NPC;

void create() {
  set_name("焦前", ({ "jiao qian", "jiao" }));
  set("title", "精武馆");
  set("gender", "男性");
  set("age", 37);
  set("int", 26);
  set("long",
    "他是负责精武馆招生的教头\n"

  );
  set("attitude", "peaceful");
  set_skill("literate", 30);
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("force", 80);

  setup();
}

int accept_object(object who, object ob) {
  int som;
  som = ob->value();

  if (som >= 10000) {
    who->set("jingwu/dizi", 1);
    who->set("jingwu/time", time());
    command("say 这为mud同仁,这里不禁止pk要是保命,来这里学点功夫到是正途\n");
    return 1;
  }
  return 0;
}
