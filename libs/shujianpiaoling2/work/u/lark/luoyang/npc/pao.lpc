// garrison.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("庖不了", ({ "pao buliao", "pao" }) );
        set("long",
                "洛阳城的执法官,你要是犯罪了,遇到他可倒霉了.heihei\n");

        set("attitude", "heroism");
        set("vendetta_mark", "authority");
        set("pursuer", 1);
        set("title",RED "洛阳府神捕" NOR);
        set("str", 27);
        set("cor", 26);
        set("cps", 25);
        
        set("combat_exp", random(10000000));

        set_skill("unarmed", 70+random(500));
        set_skill("staff", 70+random(500));
        set_skill("parry", 70+random(500));
        set_skill("dodge", 70+random(500));
        set_skill("move", 100+random(500));

        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/damage", 30+random(200));
        set_temp("apply/armor", 70);
        set_temp("apply/move", 100);
        set("chat_chance", 20);
        set("chat_msg", ({
"庖不了从怀里拿出一张图看了看,打量了你一番,摇头叹气:又不是.\n",
(:random_move :),

        }) );

        setup();

        carry_object(__DIR__"obj/yafu")->wear();
        carry_object(__DIR__"obj/sawei")->wield();
}

void init()
{
 object me;
add_action("do_kill","kill");
  
 
   me=this_player();
   if(this_player()->query("zuiren")){
   message_vision("$N对$n大喝到:你的事儿犯了,这回看你往那里跑\n",this_object(),this_player());
   message_vision("$N用枷锁套住了$n的脖子带走了\n",this_object(),this_player());
   tell_room("/u/lark/luoyang/dalao","一个人跌跌撞撞的被庖不了拉了进来,倒在地上不动了\n");
   
   this_player()->set("beget",time());
   this_player()->move("/u/lark/luoyang/dalao");
   this_player()->unconcious();
   this_object()->move("/u/lark/luoyang/lyw1");
//   command(rumor this_player()->namer()+"被洛阳府邸缉捕归案了\n");
  CHANNEL_D->do_channel(me, "rumor",sprintf("%s被洛阳府缉捕归案了\n", me->name(1))); 
}
}


int do_kill(string arg)
{
 
  object ob;
  if(!arg)
  return notify_fail("你要杀谁?\n");

  if((string) this_player()->query("class") != "official" && (int)this_player()->query("id_type")!=5)
    return 1;
//  if(find_living(this_object()){
  message_vision(RED "$N大喝一声:你也太嚣张了敢当我面杀人?\n" NOR,this_object());
  message_vision("$N用枷锁套住了$n的脖子带走了\n",this_object(),this_player());
  CHANNEL_D->do_channel(ob, "rumor",sprintf("%s因公然杀人被洛阳府收监了\n", this_player()->name(1)));  
  
  this_player()->set("zuiren",1);
  this_player()->set("time",30);
  this_player()->set("beget",time());
  tell_room("/u/lark/luoyang/dalao","一个人跌跌撞撞的被庖不了拉了进来,倒在地上不动了\n");
  this_player()->move("/u/lark/luoyang/dalao");
  this_player()->unconcious();
   return 1;
}
