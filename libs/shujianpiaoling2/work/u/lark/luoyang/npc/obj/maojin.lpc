// dumpling.c
#include <ansi.h>
inherit ITEM;


void create() {
  set_name(HIW "白毛巾" NOR, ({ "maojin" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块纯棉白毛巾\n");
    set("unit", "块");
    set("value", 100);
    //                set("food_remaining", 30);
    //                set("food_supply", 80);
  }
}
