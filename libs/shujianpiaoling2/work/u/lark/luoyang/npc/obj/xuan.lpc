// dingx.c
#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
        set_name(HIG "宣草" NOR, ({"flower"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "宣草象征忘忧,花语为勿忘我\n");
                set("unit", "枝");
                set("value", 100);
                set("armor_prop/personality", 5);
        }
        set("wear_msg","$N细心地把宣草别在鬓角\n");
        set("unequip_msg", "$N从发间取下宣草\n");
        setup();
}

