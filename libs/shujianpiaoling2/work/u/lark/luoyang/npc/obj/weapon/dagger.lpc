// dagger.c : an example weapon
#include <ansi.h>
#include <weapon.h>

inherit DAGGER;

void create()
{
        set_name(HIM "情刃" NOR, ({ "dagger" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "情人就象情人,也许她依偎在你怀中那却正是最致命的伤害，手柄上暗颗“厉”，证明是干将坊的产品\n");
  set("value", 70000);
                set("material", "steel");
        }
        init_dagger(10);

// These properties are optional, if you don't set them, it will use the
// default values.

        set("wield_msg", CYN "$N从怀中摸出一把$n握在手中.\n" NOR);
        set("unwield_msg", CYN "$N将手中的$n藏入怀中。\n" NOR);

// The setup() is required.

        setup();
}


