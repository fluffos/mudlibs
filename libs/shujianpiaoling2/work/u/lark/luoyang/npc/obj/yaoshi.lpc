// token1.c

#include <ansi.h>


inherit ITEM;

void create()
{
        set_name(HIC "衣箱钥匙" NOR,({ "yaoshi" }) );
        
        set("long",
                "清泉浴场衣箱的钥匙\n");
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else 
                        
                           
//                set("armor_prop/personality", 5);
//                 set("armor_prop/armor", 2);
                 set("unit", "个");
//                set("value",5000);
        setup();
}

void init()
{
  add_action("do_look","look");
  add_action("do_open","open");
}

int do_look(string arg)
{
  string name;
  name=this_object()->query("num");
  if(arg=="yaoshi"){
  tell_object(this_player(),"一把钥匙下面挂着一个小铁牌\n");
  tell_object(this_player(),"上面刻:" NOR+name);
  return 1;
  }
  return 0;
}


