#include <ansi.h>
#include <weapon.h>

inherit FORK;

void create() {
  set_name(HIR "举火燎天叉" NOR, ({ "fork" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "一柄纯钢锻造的双股叉，股锷下垂红缨，叉身上暗刻“厉”，证明是干将坊的产品。\n");
    set("value", 70000);
    set("rigidity", 50);
    set("material", "steel");
    set("wield_msg", "$N掳起袖子，执起一柄$n，红缨在风中微微抖动十分威风.\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_fork(50);
  setup();
}
