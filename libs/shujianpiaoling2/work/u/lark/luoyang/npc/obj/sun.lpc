// dingx.c
#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name(HIY "太阳花" NOR, ({ "flower" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "太阳花象征光明，花语为欣欣向荣\n");
    set("unit", "枝");
    set("value", 100);
    set("armor_prop/personality", 5);
  }
  set("wear_msg", "$N细心地把太阳花别在鬓角\n");
  set("unequip_msg", "$N从发间取下太阳花\n");
  setup();
}
