// thin_sword.c
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(HIW "细剑" NOR, ({ "thin sword", "sword" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50000);
    set("material", "steel");
    set("long", "剑身纤细而修长，柔软而灵动，适合女性配合轻灵的剑法，手柄处暗刻“厉”证明是干将坊的产品\n");
    set("wield_msg", HIW "$N右手微微下垂，衣袖一颤一把$n蓦然出现手中,剑身微微颤抖宛若灵蛇\n" NOR);
    set("unequip_msg", HIW "$N手指微动，掌中$n归入衣袖不见了。\n" NOR);
    set("weapon_prop/courage", -4);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/strongth", -5);
    set("weapon_prop/personality", 5);
  }
  init_sword(20);
  setup();
}
