// dingx.c
#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
        set_name(HIW "百合花" NOR, ({"flower"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "百合花象征高洁，花语为百年好合。\n");
                set("unit", "枝");
                set("value", 100);
                set("armor_prop/personality", 5);
        }
        set("wear_msg","$N细心地把百合花别在鬓角\n");
        set("unequip_msg", "$N从发间取下百合花\n");
        setup();
}

