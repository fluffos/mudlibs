int help()
{
        command("nod");
        command("say 但是我们这里的工作可以很累哦。而且薪水很低，你要干就干吧(work)\n");
        this_player()->set_temp("xiaoyao/ok",1); 
        return 1;
}


void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
        }
        add_action("do_vendor_list", "list");
        add_action("do_work", "work");
        add_action("do_ding","ding");
        add_action("do_ding","订");     
        add_action("do_ji","锻造");     

        add_action("do_ji","duanzao");
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say(name()+"说道：这位" +RANK_D->query_respect(ob) + "，进来随便看看吧。\n");
                        break;
                case 1:
                        say(name()+ "低声叹了口气道：真的忙不过来了要是有人能帮忙就好了。\n");
                        command("look "+ob->query("id"));
                        command("hehe");
                        command("say 这位"+RANK_D->query_respect(ob)+"请进请进。\n"); 
                        break;
                case 2:
                        say(name()+ "说道：这位" +RANK_D->query_respect(ob)+ "，进来挑一件称手的兵器吧。\n");
                        break;
        }
}


int do_work(string arg)
{

        object ob;
        object me;
        me = this_player();
        if(!me->query_temp("xiaoyao/ok"))
                return notify_fail("风厉皱眉道：你要干什么别乱动我的东西\n");
        if(me->is_busy()) return notify_fail("你的动作还没有完成，不能工作。\n");
        message_vision("$N辛苦的工作终于结束了，可人也累的要死\n",me);
        me->receive_damage("gin",30,me);
        me->receive_damage("sen",30,me);    
        
        ob = new("/obj/money/silver");    
        ob->move(me);
        message_vision("风厉对$N说：这是你的工钱。\n", me);
        me->start_busy(1);
        return 1;
}

int make_weapon()
{
        object me = this_player();
        
        command("hehe "+me->query("id"));
        command("say 不是我自夸，连当年天下第一高手龙五用的板指也是我打造的。\n");

        command("say 你如果没有看过牌子，喏喏喏，先看看。\n");
        write("风厉说完，指指他身旁的一块牌子。\n");
        command("say 看完了，再订武器吧！\n");
        return 1;
}

int do_ding(string arg)
{
        string ctype, cname, ccolor, cid;
        object ob, me, gold, ob2,weapon;
        string id,newfile,newdirstr,filename;
        
        me = this_player();
        id = me->query("id");
        
        if(!arg || sscanf(arg,"%s %s %s %s",ctype,ccolor,cname,cid) != 4)
                return notify_fail("指令格式：ding|订 <type> <color> <name> <English name>\n");
        if(me->is_busy())
                return notify_fail("你上一个动作还没有完成。\n");
        
        //10岁 ，14岁 ，21岁 可各打造一个。(3)   每7年打造一个。
        if(!wizardp(me) && (int)me->query("items/created_item") >= (int)me->query("age")/7)
                return notify_fail("你现在只能拥有"+chinese_number((int)me->query("age")/7)+"件自造物品。\n");

        
        
        //要不要限定自制物品数量？你自己定吧，目前为3，比较合理。
        if(!wizardp(me) && (int)me->query("items/created_item") >= 3)
                return notify_fail("你已经拥有太多自造物品了。\n");
        
        //有没有10 gold
        if (!wizardp(me)){
                gold = present("gold_money", this_player());
                if(!gold) 
                        return notify_fail("你身上没有金子。\n");
                if((int) gold->query_amount() < 10)
                        return notify_fail("你身上没有那麽多金子。\n");
        }
        
        //检测名字是否合理
        if( !check_legal_name(cname))
                return notify_fail("");

        if( !check_legal_id(cid))
                return notify_fail("");

        if( ccolor != "$BLK$" && 
            ccolor != "$NOR$" &&
          ccolor != "$RED$" &&
            ccolor != "$GRN$" &&
            ccolor != "$YEL$" &&
            ccolor != "$BLU$" &&
            ccolor != "$MAG$" &&
            ccolor != "$CYN$" &&
            ccolor != "$WHT$" &&
            ccolor != "$NOR$" &&
            ccolor != "$HIR$" &&
            ccolor != "$HIG$" &&
            ccolor != "$HIY$" &&
            ccolor != "$HIB$" &&
            ccolor != "$HIM$" &&
            ccolor != "$HIC$" &&
            ccolor != "$HIW$" 
        )
        return notify_fail("不知你要什么颜色．\n");
        
        
        if (ctype!="axe"&&ctype!="blade"&&ctype!="daggar"&&ctype!="fork"&&ctype!="hammer"
        &&ctype!="staff"&&ctype!="sword"&&ctype!="whip"&&ctype!="spear"&&ctype!="banzhi")
                return notify_fail("这里不会做你要的东西．\n");


        
        me->add("items/created_item",1);
        switch (me->query("items/created_item")){
        case 1:
                me->set("weapon1/type",ctype);
                me->set("weapon1/name",cname);                  //武器名
                me->set("weapon1/id",cid);                      //武器id
                me->set("weapon1/color",ccolor);                //武器颜色
                me->set("weapon1/owner",id);                    //武器主人id
                me->set("weapon1/weight",1000);                 //缺省的重量
                me->set("weapon1/rigidity",random(500)+500);    //缺省的锋利度
                me->set("weapon1/damage",20);                   //缺省的杀伤力.缺省必须与 base_damage同
                me->set("weapon1/max_enchant",5);               //缺省的附加属性，可加五点 
                me->set("weapon1/base_damage",20);              //缺省的基本杀伤力
                break;
        case 2: 
                me->set("weapon2/type",ctype);
                me->set("weapon2/name",cname);                  //武器名
                me->set("weapon2/id",cid);                      //武器id
                me->set("weapon2/color",ccolor);                //武器颜色
                me->set("weapon2/owner",id);                    //武器主人id
                me->set("weapon2/weight",1000);                 //缺省的重量
                me->set("weapon2/rigidity",random(500)+1000);    //缺省的锋利度

                me->set("weapon2/damage",30);                   //缺省的杀伤力.缺省必须与 base_damage同
                me->set("weapon2/max_enchant",6);               //缺省的附加属性，可加五点 
                me->set("weapon2/base_damage",30);              //缺省的基本杀伤力
                break;
        case 3:
                me->set("weapon3/type",ctype);
                me->set("weapon3/name",cname);                  //武器名
                me->set("weapon3/id",cid);                      //武器id
                me->set("weapon3/color",ccolor);                //武器颜色
                me->set("weapon3/owner",id);                    //武器主人id
                me->set("weapon3/weight",1000);                 //缺省的重量
                me->set("weapon3/rigidity",random(500)+1500);    //缺省的锋利度
                me->set("weapon3/damage",50);                   //缺省的杀伤力.缺省必须与 base_damage同
                me->set("weapon3/max_enchant",7);               //缺省的附加属性，可加五点 
                me->set("weapon3/base_damage",50);              //缺省的基本杀伤力
                break;
        default:
                me->set("weapons/type",ctype);
                me->set("weapons/name",cname);                  //武器名
                me->set("weapons/id",cid);                      //武器id
                me->set("weapons/color",ccolor);                //武器颜色
                me->set("weapons/owner",id);                    //武器主人id
                me->set("weapons/weight",1000);                 //缺省的重量

                me->set("weapons/rigidity",random(500)+500);    //缺省的锋利度
                me->set("weapons/damage",20);                   //缺省的杀伤力.缺省必须与 base_damage同
                me->set("weapons/max_enchant",5);               //缺省的附加属性，可加五点 
                me->set("weapons/base_damage",20);              //缺省的基本杀伤力
                break;
        }
        
        
        switch( ctype ) {
                case "axe":
                        weapon = new(__DIR__"weapons/axe.lpc");
                        break;
                case "blade":
                        weapon = new(__DIR__"weapons/blade.lpc");
                        break;
                case "dagger":
                        weapon = new(__DIR__"weapons/dagger.lpc");
                        break;
                case "fork":
                        weapon = new(__DIR__"weapons/fork.lpc");
                        break;

                case "hammer":
                        weapon = new(__DIR__"weapons/hammer.lpc");
                      break;
                case "staff":
                        weapon = new(__DIR__"weapons/staff.lpc");
                        break;
                case "sword":
                        weapon = new(__DIR__"weapons/sword.lpc");
                        break;
                case "whip":
                        weapon = new(__DIR__"weapons/whip.lpc");
                        break;
                case "spear":
                        weapon = new(__DIR__"weapons/spear.lpc");
                        break;
                case "banzhi":
                        weapon = new(__DIR__"weapons/banzhi.lpc");
                        break;
                default:
                        me->add("items/created_item",-1);
                        return notify_fail("这里不会做你要的东西．\n");
        }
        
        if(weapon->move(me)){
                if (!wizardp(me)){

                        gold->add_amount(-10);
                }
                me->start_busy(1);
                write("你将身上的黄金交给"+name()+"，订造了一"+weapon->query("unit")+weapon->name()+"\n");
                return 1;
        }
        return 0;
}
 

 

//check chinese name
int check_legal_name(string name)
{
        int i;
        i = strlen(name);
        if( (strlen(name) < 2) || (strlen(name) > 40 ) ) {
                write("对不起，中文名字必须是一到二十个中文字。\n");
                return 0;
        }
        while(i--) {
                if( name[i]<=' ' ) {

                        write("对不起，中文名字不能用控制字元。\n");
                        return 0;
                }
                if( i%2==0 && !is_chinese(name[i..<0]) ) {
                        write("对不起，名字必需是中文。\n");
                        return 0;
                }
        }
        return 1;
}

//check english name
int check_legal_id(string name)
{
        int i;
        i = strlen(name);
        if( (strlen(name) < 3) || (strlen(name) > 20 ) ) {
                write("对不起，英文名字必须是三到二十个字。\n");
                return 0;
        }

        return 1;
}



int  do_ji(string arg)
{
        object me, ob;
        object gold;
        int cost = 1;
        int i,j,base,current;
        string id,name ;        
        string file,newfile,filestring;
        me = this_player();
        
        id = me->query("id");
        if( !arg ) return notify_fail("你要祭什麽武器？\n");
        
        gold = present("gold_money", this_player());
        if( !gold) return 
                notify_fail("你身上没有金子。\n");
        
        if( !objectp(ob = present(arg, me)) )
                return notify_fail("你身上没有这样东西。\n");
        if(me->is_busy())
                return notify_fail("你上一个动作还没有完成。\n");

        
        if( !ob->query("weapon_prop") )
                return notify_fail("你只能祭可当作武器的东西。\n");
        if( ob->query("equipped") )
                return notify_fail("你不可祭装备著了的武器。\n");
        if( !ob->query("owner") )
                return notify_fail("你只可祭自己打造的武器。\n");
        
        base= (int)ob->query("base_damage");
        current = (int) ob->query("weapon_prop/damage");
        for(j=1;j<=100;j++)
        {
                base = base + j;
                if(base >= current) break;
        }
        for(i=1; i<=j;i++)
                        cost = cost * 2;
        if((int) gold->query_amount() < cost)
                return notify_fail("你身上没带够" + sprintf("%d",cost)+ "两金子。\n");
        gold->add_amount(-cost);
        me->start_busy(1);
        me->add("bellicosity",cost);
        

        // need to update 3 things: damage, rigidity, and weight
        
        ob->add("weapon_prop/damage",j);
        ob->set("weight",(int)ob->query("weight")+j*100);
        ob->add("rigidity",j*10);
        
        me->add("weapon"+ob->query("weaponsmnum")+"/damage",j);
        me->add("weapon"+ob->query("weaponsmnum")+"/weight",j*100);
        me->add("weapon"+ob->query("weaponsmnum")+"/rigidity",j*10);
        //更新
        reload_object( ob );
        if(ob->move(me))        
                message_vision("$N向"+ob->name()+"上啐了一口带血的唾沫，剑刃上血光一闪，$N说道：好了！\n",this_object());
        return 1;
}

