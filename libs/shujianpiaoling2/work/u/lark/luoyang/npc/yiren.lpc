// guotai.c
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
void greet(object ob);
string give();
int xiaoyao();
void create() {
  set_name("伊人", ({ "yiren" }));
  set("attitude", "friendly");
  set("gender", "女性");
  set("age", 19);
  set("long", "一个俏丽不可方物的女孩子,清新健康.\n");
  set("str", 15);
  set("per", 30);
  set("cps", 29);
  set("int", 20);

  set("max_kee", 300);
  set("kee", 300);
  set("food", 400);
  set("water", 400);
  //         set("chat_chance", 3);
  //        set("chat_msg", ({
  //           "巧巧轻声说道：“他好久不来了。。。。不知道出了什么事情？”\n",
  //           "巧巧轻声的叹了口气。\n",
  //}) );
  set("combat_exp", 2000);
  set_skill("dodge", 30);
  set_skill("unarmed", 30);
  /*
        set("inquiry", ([
            "紫丁香" : "这是刚从紫薇平原采来的，好新鲜的\n",
            "韩江雪" : (: give :),
            "他"     : (:give:),        
            "紫薇平原": "紫薇平原在城南是个好美的地方，到处开满了紫丁香花\n"
                        "我的花都是从那里采来得。。。。。我也是在那里\n"
                        "认识他的。。。。。。。\n",
           "村子"   : (:xiaoyao:),
     

]) );
*/
  set("vendor_goods", ([
    __DIR__ "obj/sun": 40,
    __DIR__ "obj/kangnaixin": 40,
    __DIR__ "obj/baihe": 40,
    __DIR__ "obj/rose": 40,
    __DIR__ "obj/xuan": 40,
    __DIR__ "obj/mudan": 40,
    __DIR__ "obj/taohua": 40,
  ]));






  setup();
  carry_object("/obj/cloth")->wear();
  //add_money("gold", 1);
}

void init() {
  object ob;

  ::init();
  add_action("do_vendor_list", "list");
  if (interactive(ob = this_player())
    && !is_fighting()) {
    call_out("greet", 1, ob);
  }
}

void greet(object ob) {
  if (!ob || environment(ob) != environment()) return;
  message_vision(
    "伊人对着$N一个可爱的笑容：“欢迎光临”\n", ob);
  return;
}


int accept_object(object who, object ob) {
  int som;
  som = ob->value();
  if (som == 200) {
    command("say 您要送花么?\n");
    who->set_temp("ok", 1);
    return 1;
  }
  return 0;
}
