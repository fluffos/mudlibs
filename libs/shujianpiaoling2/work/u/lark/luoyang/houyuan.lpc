//后院
inherit ROOM;

void create ()
{

        set ("short", "后院");
        set ("long", @LONG
这里是客栈的后院，院子中种满了花草树木，是空气格外清新。
LONG);
        set("exits", ([ 
        "west":         __DIR__"awu",
]));
        set("wangsha/kezhan",1);
        set("outdoors", "luoyang");
        set("no_clean_up", 0);
        setup();
}

int valid_leave(object me, string dir)
{
        object key;
        object owner = find_living("li zhanggui");
        if (!owner) return 1;
        if (userp(me))
        if (dir == "west"&&objectp(key=present("key",me)) && key->query("used")){
                if (me->query("room")=="room1") owner->set("room1",0);
                else if (me->query("room")=="room2") owner->set("room2",0);
                else if (me->query("room")=="room3") owner->set("room3",0);
                else if (me->query("room")=="room4") owner->set("room4",0);
                else if (me->query("room")=="room5") owner->set("room5",0);
                else if (me->query("room")=="room6") owner->set("room6",0);
                else if (me->query("room")=="room7") owner->set("room7",0);
                else if (me->query("room")=="room8") owner->set("room8",0);
                else if (me->query("room")=="room9") owner->set("room9",0);
                else return 1;
                destruct(key);
        }
        return 1;
}


