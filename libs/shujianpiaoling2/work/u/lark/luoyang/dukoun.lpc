// dukous.c

inherit ROOM;

void create()
{
        set("short", "洛河北渡口");
        set("long", @LONG
洛河是洛阳北面的一条河流，属于黄河的支流之一，平时水流并不很大，
但是到了雨季水势还不小的。现下江面还算平静要想过河就要喊,
过江(guojiang).
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"road8",
  "east":"/u/jakey/qspath1",
]));

          set("outdoors", "changan");

        set("objects", ([
        "/u/lark/fnpc/fisher":2,                   
        ]) );
        setup();
}

void init()
{
         add_action("do_jiaochuan", "guojiang");
}

int do_jiaochuan()
{
        object ob,ob1;
        message_vision("$N对着江面喊道: 船..家...渡我过江...\n", this_player());
        if( query("exits/enter") )
                return notify_fail("船已经在这儿了, 你可以上船(enter).\n");
       set("exits/enter",__DIR__"boat");
        message_vision("船家对$N应道：来...啦.....\n", this_player());
        write("船来了，你可以上船(enter).\n");
        if( ob = find_object(__DIR__"boat")) ob->set("exits/out",__DIR__"dukoun");
        call_out("kaichuan_n",10);
        call_out("daoan_n",20);
        return 1;
}
void kaichuan_n()
{
        object ob;
        if( ob = find_object(__DIR__"boat")) {
                ob->delete("exits/out");
                message("vision", "船夫收起了跳板，把船缓缓驶出江心。\n",ob );
        }
       message("vision", "船夫收起了跳板，把船缓缓驶出江心。\n",this_object());
        delete("exits/enter");
        return; 
}
void daoan_n()
{
        object ob;
        if( ob = find_object(__DIR__"boat")) {
                ob->set("exits/out",__DIR__"dukous");
                message("vision", "船夫放下跳板，大声叫道：“船到岸啦！客官请上岸。\n",ob );
        }
        return; 
}

