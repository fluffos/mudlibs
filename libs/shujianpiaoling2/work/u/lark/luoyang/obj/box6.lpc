// bag.c

inherit ITEM;

void create()
{
        set_name("六号衣箱", ({ "box6" }) );
        set_weight(500);
        set("no_get",1);
        set("no_show",1);
        set_max_encumbrance(10000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "你洗澡的时候可以把杂物放在里面。\n");
                set("value", 100);
        }
}

int is_container() { return 1; }

