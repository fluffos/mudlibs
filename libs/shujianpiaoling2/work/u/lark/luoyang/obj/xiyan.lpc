// waterskin.c
#include <ansi.h>
inherit ITEM;


void create()
{
        set_name(RED "喜烟" NOR, ({ "smoke"}) );
        set_weight(7);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "吸烟有害健康 \n");
                set("unit", "根");
                set("value", 10);
               // set("max_liquid", 15);
        }

        // The liquid contained in the container is independent, we set a copy
        // in each cloned copy.
        setup();
}

void init()
{
 add_action("do_chou","chou");
}

int do_chou(string arg)
{
   if(!arg && arg!="smoke" && arg!="喜烟" && arg!="烟")
    return notify_fail("你要抽什么?\n");
   message_vision("$N从怀里那出一根烟点着了，悠闲的抽了起来\n",this_player());
   this_player()->add("gin",10);
   this_player()->add("sen",10);
   this_player()->receive_wound_damage("kee",10);
   destruct(this_object());
   return 1;
}

