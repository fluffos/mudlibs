int valid_leave(object me, string dir)
{
        object *inv;
        object ob;
        int i;
        if( userp(me) && dir == "north")
        if( sizeof(me->query_all_condition()) != 0 )
        return notify_fail("想死换个地方\n");
        
        return 1;
}

