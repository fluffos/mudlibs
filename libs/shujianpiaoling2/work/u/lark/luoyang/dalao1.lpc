#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", RED"洛阳大牢"NOR);
        set("long", @LONG
这里洛阳府关押犯人的所在,左右两旁的铁门里不时伸出一只只脏兮兮
的手,你能听到断断续续的冤.......枉........的声音.
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "down" : __DIR__"dalao",
  "west" : __DIR__"datang",
//  "west"  : __DIR__"lyw2",
//  "east"  : __DIR__"center",
]));
        set("objects", ([
        __DIR__"npc/yayi3": 4,
                        ]) );


        set("outdoors", "luoyang");
        setup();
}

int valid_leave(object me, string dir)
{
   if(dir=="down"){
   if(present("yayi",this_object())){
   return notify_fail("衙役拦住了你说:这里是大牢重地不要乱闯\n");
   }}
   return 1;
}
