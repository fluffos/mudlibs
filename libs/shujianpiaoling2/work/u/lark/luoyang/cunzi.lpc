//changan city

inherit ROOM;

void create ()
{
        set ("short", "村子");
        set ("long", @LONG
这是间不大的村子，围着小场盖着几间茅草房，远处就是田地了，
不时传来了嘹亮的歌谣声，显得十分恬静。中间有一口井，
井水透明清澈。几个孩童在空地里玩耍天真烂漫.
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
                "west" : __DIR__"cun1",
                "east" :  __DIR__"cun2",  //goto luoyang
                "north" : __DIR__"road4",
//              "south" : __DIR__"cun3",
        ]));

        set("objects", 
        ([ //sizeof() == 1
              "/u/lark/fnpc/child" : 2,
              "/u/lark/fnpc/boy":1,
              "/u/lark/fnpc/girl":1,
                
        ]));


        set("outdoors", "changan");
        set("no_clean_up", 0);
        setup();
}

void init()
{
      
        add_action("do_fillwater", "fillwater");
        add_action("do_drink", "drink");
}

int do_fillwater(string arg)
{
        object *list, ob;
        int i, can_fillwater;
        string dir;
        if( !arg || arg=="" ) {
                 write("你要往什么东西里灌水？\n");
                   return 1;
} 
         if(! ob = present(arg,this_player()) ) {
                 write("你身上没有这个东西。\n");
                   return 1;
} 
        if (ob->query("liquid/type") == "alcohol"
 || ob->query("liquid/type") == "water" ) {

                 ob->set("liquid", ([
                           "type": "water",
                           "name": "井水",
                           "remaining": 15,
                           "drunk_apply": 6,
                 ]) );
                 write("你从井里里装满了水! \n");
                 return 1;
                   }
         else {
                        write("你没有装水的东西啊....\n");
                        return 1;
}
}

int do_drink(string arg)
{
        object ob;
        ob=this_player();
        if( ob->is_busy() )
                return notify_fail("你正忙着其他事情呢。\n");
        if( (int)ob->query("water") >= (int)ob->max_water_capacity() )
                return notify_fail("你已经喝得太多了，再也灌不下一滴水了。\n");
        ob->add("water", 30 );
        if( ob->is_fighting() ) ob->start_busy(2);
        message_vision("$N伏到井边喝了几口水。\n", ob);
        return 1;
}

