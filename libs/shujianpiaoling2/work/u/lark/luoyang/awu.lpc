//awu.c ,by eesoft, John Darks
//阿五客栈？
inherit ROOM;

void create() {

  set("short", "饭铺");
  set("long", @LONG
这间号称洛阳最大的客栈居然不大，真是活见鬼了。客栈小居然还住满了
旅客，显得分外拥挤，分外热闹。这里是客栈前面的饭铺，不时有穿着羊皮袄
的大汉进进出出，有的喝了几杯酒，就故意敞开衣襟，表示他们的豪气。门前
挂着一帘红布，夏能遮阳，冬能挡风。铺子中上位供着一个关公像，旁边一副
对联格外显眼：
                天         海
                涯         内
                若         存
                比         知
                邻         己

对联题字为狂草所书，字体龙飞凤舞，不羁中有着闲逸，却不知是何人所书。
LONG);
  set("item_desc", ([
    "对联": @TEXT
                天         海
                涯         内
                若         存
                比         知
                邻         己           
                                 龙五题         
TEXT
    , "duilian": @TEXT
                天         海
                涯         内
                若         存
                比         知
                邻         己           
                                 龙五题         
TEXT
    , "paizi": "住房每日30两白银",
    "牌子": "住房每日30两白银",
  ]));
  set("exits", ([
    "east": __DIR__ "houyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/owner": 1,           //掌柜
    __DIR__ "npc/daoshi": 1,          //道士
    __DIR__ "npc/xiaoer": 1,
    __DIR__ "npc/dahan": 2,           //大汉
    __DIR__ "npc/xiaoli": 1,          //小李
    __DIR__ "npc/xiaoer1": 1,
    __DIR__ "npc/girl": 1,            //女子





  ]));
  set("valid_startroom", 1);
  set("no_magic", 1);
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_fight", "kill");
  add_action("do_fight", "smash");
  add_action("do_fight", "dest");
  add_action("do_fight", "uncon");
  add_action("do_look", "look");
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "east")
      message_vision("一个店小二呵呵一笑，弯腰对$N道：这位客官，这边请。\n", me);
    else {
      if (!present("key", me))
        message_vision("店小二弯腰对$N道：这位客官慢走，欢迎下次光临。\n", me);
      else {
        message_vision("店小二闪身拦住$N道：这位客官如果不住房，请先把钥匙退了。\n", me);
        return notify_fail("\n");
      }
    }
  return ::valid_leave(me, dir);
}

int do_fight() {
  object me = this_player();
  if (userp(me)) {
    message_vision("店里的人忽然都用一种奇怪的眼光看着$N\n", me);
    message_vision("只见一个店小二呵呵一笑，迎了上来，弯腰对$N道：这位客官，想必初到此地。\n", me);
    message_vision("说完，店小二指了指对联，道：客官可知这对联是何人所题？\n", me);
  }
  return 1;
}

int do_look(string arg) {
  object me = this_player();
  if (arg != "duilian" && arg != "对联") return 0;

  if (userp(me)) {
    message_vision("只见店小二呵呵一笑，对$N道：这位客官，本店蒙龙大先生看得起，\n特意为本店写了副对联，如果客官给面子，就不要在本店动手，大家都方便。\n\n\n", me);
  }
  return 0;
}
