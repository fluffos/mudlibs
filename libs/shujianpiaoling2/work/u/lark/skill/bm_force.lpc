// bm_force.c
#include <ansi.h>
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  if ((me->query("class") != "xiaoyao"))
    return notify_fail("北冥神功是逍遥绝学，概不外传。\n");

  if ((int)me->query_skill("force", 1) < 30)
    return notify_fail("你的基本内功火候还不够。\n");

  if ((int)me->query_skill("force") < (int)me->query_skill("bm_force"))
    return notify_fail("你的基本内功修为不够，无法领会更高深的北冥神功。\n");
  if ((int)me->query("bellicosity") > 200)
    return notify_fail("你的杀气太高了，无法继续修炼。\n");

  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  mixed foo;
  int force;
  foo = ::hit_ob(me, victim, damage_bonus, factor);
  if (intp(foo) && (damage_bonus + foo > 0)) {
    if (random(me->query_skill("bm_force")) > (damage_bonus +
      foo)) {
      victim->receive_wound("kee", (damage_bonus + foo));
      force = victim->query("force");
      victim->set("force", force - random(10) - 1);
      me->add("force", force - random(10) - 1);
      return HIC "$N的出招渐渐沉重，每一式似乎都一股强大的吸引力，$n脸色大变出手似乎越来越轻。\n" NOR;
    }
  }
  return foo;
}


int practice_skill(object me) {
  return notify_fail("北冥神功只能用学习，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {
  return CLASS_D("xiaoyao") + "/bm_force/" + func;
}
int effective_level() { return 20; }

int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return 10;
}
int black_white_ness() {
  return 20;
}

void skill_improved(object me) {
  int s;

  s = me->query_skill("bm_force", 1);
  if (!(s % 10) && (int)me->query("con") < s / 4) {
    tell_object(me, HIC
      HIC "你运行北冥神功一个周天，感到身体飘摇欲飞。。。。\n" NOR);
    me->add("con", 1);
    me->unconcious();
  }


  if ((int)me->query("force") / 10 < me->query_skill("bm_force", 1)) {
    tell_object(me,
      HIC "\n你的内力蓬勃不可抑制，几欲破出体外.....\n\n" NOR);
    me->skill_death_penalty();
    me->unconcious();
  }
}
