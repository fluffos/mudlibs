#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target)
{
        object *ob;
        int i, skill, damage;
         if( (int)me->query("force") < 150 )
                return notify_fail("你的内力不够。\n");
           if((int)me->query("bellicosity")>100)
                     return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");
         skill = me->query_skill("bm_force")+me->query("per");


        me->add("force", -150);
        me->receive_damage("kee", 10);

        me->start_busy(2);
        damage = skill + (me->query_per() - 30) * 5
                 - ((int)ob[i]->query("max_force") / 15);
        ob = all_inventory(environment(me));
        if( me->query("gender")=="男性" ){
          tell_object(me,"你逸出一丝淡然潇洒的微笑，眼中泛出摄人的光芒。。。。。\n");
        message_vision(
                HIM "$N露出淡淡洒脱的微笑，深炯的目光里透漏出动人的神采。。。。。\n" NOR, me);
         if( ob[i]->query("gender") == "男性" ) damage = damage / 2;
          }
         
         if( me->query("gender")=="女性" ){
           tell_object(me,"你轻启朱唇淡淡的轻笑妩媚动人，玲珑秋波中神韵深含。。。\n");
           message_vision(
                HIM "$N脸色微红，纤手轻拂额头的刘海，可爱的笑容上两个小小的酒窝。。。。。\n" NOR, me);
          if( ob[i]->query("gender") == "女性" ) damage = damage / 2; 
           }
           
        for(i=0; i<sizeof(ob); i++) {
           if( !living(ob[i]) || ob[i]==me 
                        || ob[i]->query("race")!="人类" ) continue;
            if( skill/2 + random(skill/2) < (int)ob[i]->query("cps") * 2 ) continue;
            if( damage > 0 ) {
                        if( damage > ob[i]->query("sen"))
                                {
                                tell_object(ob[i],"你觉得心中一乱。。。。\n");
                                tell_room(environment(me),ob[i]->query("name")+
                                "满脸通红不禁有些手足无措。"+me->query("name")+
                                "。。。\n",ob[i],ob[i]);
                                }
                        else{
                                tell_object(ob[i], "你觉得脸上一热，心中小鹿乱撞，脑中一片空白，元神不稳。。\n");
                                tell_room(environment(me),ob[i]->query("name")+
                                "满脸通红，有点神不守舍的样子。\n",ob[i],ob[i]);  
                            }
                        ob[i]->receive_damage("sen", damage);
                        if( (int)ob[i]->query("force") < skill * 2 )
                        ob[i]->receive_wound("sen", damage/2);
                         
                
                if( userp(ob[i]) ) ob[i]->fight_ob(me);
                else if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);
        }
 
   }
        return 1;
}

