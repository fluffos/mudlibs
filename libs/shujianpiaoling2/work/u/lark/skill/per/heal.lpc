// heal.c

#include <ansi.h>

int exert(object me, object target) {
  if (me->is_fighting())
    return notify_fail("战斗中疗伤？想找死吗？\n");

  if ((int)me->query("force") < 40)
    return notify_fail("你的真气不够！\n");

  if ((int)me->query("eff_kee") >= (int)me->query("max_kee"))
    return notify_fail("你没有受伤啊。\n");

  if ((int)me->query("eff_kee") < (int)me->query("max_kee") / 4)
    return notify_fail("你的伤太重了，不可以运功疗伤！\n");

  write(BLU "你盘膝坐在地上。默默运起北冥神功，所受的内伤渐渐好转了。\n" NOR);
  message("vision",
    BLU + me->name() +
    "盘膝坐在地上，身旁笼罩着似有似无的青雾，脸上渐渐恢复了血色。\n"
    NOR,
    environment(me), me);
  if ((int)me->query("force") > 160) {
    me->receive_curing("kee", (10 + (int)me->query_skill("force") / 5) * 4);
    me->add("force", -160);
  } else {
    me->receive_curing("kee", 10 + (int)me->query_skill("force") / 5);
    me->add("force", -40);
  }
  //      me->set("force_factor", 0);

  return 1;
}
