  ]),
  ([ "action": "$N轻叹中一式GRE「总是凄凉意」NOR，左手并指如戟一股凌烈无比的气劲，凌虚向$n的「孔最穴」戳去！",
    "dodge": -50,
    "parry": -20,
    "damage": 60,
    "force": 180,
    "damage_type": "指伤"
  ]),
  ([ "action": "$N眼神中渐渐洒脱，一式GRE「却不如随意来去」NOR，右手食指滑弧指端一缕阴柔气进，穿过$n的「中府穴」",
    "dodge": -50,
    "parry": -50,
    "damage": 30,
    "force": 100,
    "damage_type": "指伤"
  ]),
  ([ "action": NOR "$N淡淡微笑双手交互轮划风中卓然衣袂飘然，一式「寒夜轻歌是逍遥」，双手食指微扣拇指，轻轻对着$n的「经渠穴」弹出！" NOR,
    "dodge": 70,
    "parry": -70,
    "damage": 200,
    "force": 250,
    "damage_type": "指伤"
  ]),
});


int valid_learn(object me) {
  string dodskill;
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps" || (int)me->query_skill("wave_steps") < 70)
    return notify_fail("逍遥武功必须要凌波微步的配合.\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力修为不够，无法修习更高深的指法。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练指必须空手。\n");
  if ((int)me->query_skill("finger", 1) / 2 < (int)me->query_skill("fy_finger", 1) / 3)
    return notify_fail("你的指法功夫根基不够，无法练习「浮月流云指」。\n");

  return 1;
}

int valid_enable(string usage) {

  return usage == "finger" || usage == "parry";
}

mapping query_action(object me, object weapon) {

  return action[random(sizeof(action))];
}

int practice_skill(object me) {

  int skill, combat_exp;
  skill = me->query_skill("fy_finger", 1);
  if ((skill >= 99 && skill < 106) || (skill >= 145 && skill < 151))
    return notify_fail("你于细微处无法理解，需要向师父继续学习精妙招式。\n");
  combat_exp = (int)me->query("combat_exp");
  skill = (int)me->query_skill("wave_steps", 1);

  if (skill * skill * skill / 10 > combat_exp)
    return notify_fail("你的实战经验不够，无法练习「浮月流云指」\n");


  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，无法练习「小无相劫指」\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所学练了一遍「浮月流云指」，似乎有些心得。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("xiaoyao") + "/fy_finger/" + action;
}
