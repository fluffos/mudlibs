  ([ "action": "$N面带忧愁，右手四指轻握，食指一式GRE「点点行行」NOR，指尖无数道劲气，指影撒向$n的周身大穴！",
    "dodge": 30,
    "parry": -60,
    "damage": 80,
    "force": 100,
