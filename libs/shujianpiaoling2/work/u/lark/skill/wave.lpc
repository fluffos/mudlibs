//凌波微步
#include <ansi.h>
inherit SKILL;

mapping *action = ({
([      "action" : "$n淡淡的一笑,脚踏MSG身形急转，渺然已逝.\n",
          "lvl":0,
          "dodge"  : 30,
]),
([      "action" :  "$n轻啸一声，足尖点地，身形飘然而起落向MSG.\n",
        "lvl":40,
        "dodge"  : 40,
]),
([      "action" : "$N眼前一花，$n的身影乍分乍合，迈向MSG已然失却踪影.\n",
        "lvl": 50,
        "dodge"  : 60,
]),
([      "action" : "$n面对来招面不改色，突然间一收腹，往后飘落了一寸急踏MSG避过了这招.\n",
        "lvl": 70,
        "dodge"  : 80,
]),
([      "action" :"$n潇洒的一笑，不退反进，趁你$N个破绽，踏上MSG蹂身而上，$N急忙收招自.\n",
        "lvl": 100,
        "dodge"  : 100,
]),
([      "action" : "$n一声长啸，宛若流云瞬间踏到MSG，你的杀招一下子失却了目标。\n",
        "lvl": 110     ,
        "dodge"  : 110,
]),
([      "action" :   "$n背负双手，潇洒来去，刀光剑影均视若不见堪堪踏上MSG，$N百思不得其解身形顿搓。\n",
        "lvl":120,
        "dodge"  : 120,
]),
([      "action" : "$n身体不可思议的弯转了过去，倒踏MSG避过了这一招.\n",
       "lvl":130, 
       "dodge"  : 130,
]),
([      "action" :  "$n无法格挡，脑袋微侧，足下自然而然的斜踏MSG,竟然避过了$N的攻击.\n",
       "lvl":140, 
       "dodge"  : 140,
]),
([
        "action":   "$n膝盖微曲，左足斜斜缓踏MSG,堪堪避过$N的进攻.\n",
        "lvl":150,
        "dodge"  : 150,
]),
});



int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me)
{
    if(me->query("class")!="xiaoyao")
       return notify_fail("凌波微步是逍遥派绝学不传授于别门弟子\n");
    if( (int)me->query("max_force") < 200 )
        return notify_fail("你的内力修为太浅，没有办法练凌波微步。\n");
    if( (int)me->query("spi") < 20 )
        return notify_fail("你的灵性不够，没有办法学习凌波微步。\n");

        return 1;
}

mapping query_action(object me, object weapon)
{
        int zhaoshu, level;

        zhaoshu = sizeof(action);
        level   = (int) me->query_skill("wave_steps",1);
        return action[random(zhaoshu)];
}


string query_dodge_msg(string limb)
{
        object me, ob;
        mapping action;

        me = this_player();
        action = query_action(me, ob);

        return action["action"];
}




int practice_skill(object me)
{
    int lb,dg;
    lb=(int)me->query_skill("wave_step",1);
    if( (int)me->query("kee") <=30 )
        return notify_fail("你的气太少了，不能练凌波微步。\n");
     if( (int)me->query("spi") < 30 )
        return notify_fail("你的灵性不够，没有办法练习凌波微步。\n");

    me->receive_damage("kee", 30);
        dg = me->query_skill("dodge",1)- me->query_skill("wave_step",1);
        if(me->query_learn("wave_step") > (lb+1)*(lb+1)+10 && dg<=0 ) return 0;
    me->add("force",lb/2);
    if( (int)me->query("force") > (int)me->query("max_force") * 2) {
        if( (int)me->query("max_force") <
                        ((int)me->query_skill("force", 1) + me->query_skill("force")/5) * 10 ) {
            write("你的内力提高了。\n");
                        me->add("max_force", 1);
                }
                me->set("force", me->query("max_force"));
        }       

        return 1;
}
string perform_action_file(string action)
{
        return CLASS_D("xiaoyao") + "/wave_steps/" + action;
}
int effective_level() { return 30;}

int learn_bonus()
{
        return -50;
}
int practice_bonus()
{
        return -50;
}
int black_white_ness()
{
        return -50;
}


