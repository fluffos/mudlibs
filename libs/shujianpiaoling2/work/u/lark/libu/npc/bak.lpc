// shusheng.c
#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <move.h>

inherit NPC;


void do_drink();
void create() {
  set_name("席凉秋", ({ "liangqiu", "xi" }));
  set("gender", "男性");
  set("age", 23);
  set("long", "一个文质彬彬的年青书生, 看起来满腹心事\n");
  set("str", 10);
  set("cor", 14);
  set("cps", 29);
  set("int", 40);
  set("relation_exp", 30000);

  set("life_exp", 10000);
  set("combat_exp", 100);
  set("chat_chance", 6);
  set("chat_msg", ({
    "三年寒窗。。。。。却功名未立，眼看盘缠就要用尽， 可。。。这怎么能回家向娘亲交代?\n",
    "席凉秋叹了口气: 也许当初真不如。。。。。\n",

  }));
  set("attitude", "friendly");
  set_skill("unarmed", 20);
  set_skill("dodge", 60);

  set("inquiry", ([
    "盘缠": "席凉秋哭丧着脸说：“哎，我偷偷的把家传的宝剑当掉才凑足了盘缠，可三年来老是名落孙山!马上就要花光了。。。\n",
    "宝剑": "摇了摇头，面带惭愧的说：：“家父乃先朝大将，先朝覆灭后郁郁而终，那是他最心爱之物，却被我。。。sigh\n",
    "当初": "娘亲希望我能继承先父遗愿，纵横沙场，可是我就是讨厌那些打打杀杀的事情。。。。平生最爱不过之乎者也。。\n",
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
  add_money("coin", 100);

}



int accept_object(object who, object ob) {
  int som;
  som = ob->value();
  som /= 10000;

  if (who->query("brother") || who->query("nogive")) {
    command("shy");
    command("say 又让你费心了....");
    who->add("relation_exp", som * 10);
    who->add("life_exp", som * 10);
    return 1;
  }
  if (som < 50) {
    command("bow" + who->query("id"));
    command("thank" + who->query("id"));
    command("say RANK_D->query_respect(who)+真义士也，来日小生腾达之时必当回报.\n");
    who->add("relation_exp", som);
    who->add("life_exp", som / 2);
  } else if (som < 100) {
    command("blush");
    command("say 这位+RANK_D->query_respect(who)+如此慷慨相助，叫小生我。。。如何报答？");
    command("consider");
    command("say 在下身无长物，这本诗集乃区区呕心之作，赠与+RANK_D->query_respect(who)+做个纪念吧。");
    __DIR__ "obj/shiji"->move(who);
    who->add("relation_exp", som);
    who->add("life_exp", som / 2);
  } else {
    command("ah");
    command("touch " + who->id());
    command("say 这... 这... 怎么好意思?我。我。。。");
    command("say 真没有想到世间还有+RANK_D->query_respect(who)+这样的人，这样吧，我们不如结为异姓手足今后患难与公富贵同享，+RANK_D->query_respect(who)+以为如何？");
    who->set_temp("att", 1);

  }
  return 1;
}

void init() {
  int age;
  string name;
  age = this_player()->query("age");
  if (this_player()->query("gender") == "男性") {
    if (age < 23) name = "贤弟";
    if (age > 23) name = "兄长";
  }
  if (this_player()->query("gender") == "女性") {
    if (age < 23) name = "妹妹";
    if (age > 23) name = "姐姐";
  }
  add_action("do_nod", "nod");
  add_action("do_shake", "shake");
  if (this_player()->query("brother"))
    message_vision("$N亲热的向$n一作揖：“" + name + "你好呀。又来看望我了？我娘亲身体如何？”\n",
      this_object(), this_player());

}

int do_nod() {
  int age;
  string name;
  object ob;
  ob = find_object("/u/lark/xiaoyao/npc/obj/yupei");
  age = this_player()->query("age");
  if (this_player()->query("gender") == "男性") {
    if (age < 23) name = "贤弟";
    if (age > 23) name = "兄长";
  }
  if (this_player()->query("gender") == "女性") {
    if (age < 23) name = "妹妹";
    if (age > 23) name = "姐姐";
  }

  if (this_player()->query_temp("att")) {
    message_vision("$N携起$n的手跪倒在地，拈土为香，指天为誓，八拜结交\n", this_player(), this_object());
    tell_object(this_player(), name + "我也没有什么值钱的东西，这块玉佩乃是我随身之物就送与你留个纪念吧.\n");
    ob->set("owner", "lark");
    ob->move(this_player());
    tell_object(this_player(), "我家住在金陵，如果" + name + "有空请到家中代为看望我娘亲.将这封信交与她老人家。\n");
    __DIR__ "obj/letter"->move(this_player());
    this_player()->set("brother", 1);
    this_player()->add("relation_exp", 5000);
    this_player()->add("life_exp", 3000);
    return 1;
  } else return 1;
}

int do_shake() {
  if (this_player()->query_temp("att")) {
    message_vision("$N摇了摇头，说道：“你我萍水相逢，聚散有缘，不必如此吧。”\n", this_player());
    message_vision("$N脸上露出了失望的神情，叹了口气说道：“如此也罢！但在下于心何安。。。？\n", this_object());
    message_vision("$N说着怀里掏出了一个油布包，从里面去出一本发黄的书来\n", this_object());
    tell_object(this_player(), "席凉秋说道：“这个是先父生前所著的HIW《兵法纪要》NOR，一直都带在身边，我无意行伍今日有缘不如就送与你吧。\n");
    __DIR__ "obj/bingfa"->move(this_player());
    this_player()->set("nogive", 1);
    this_player()->add("relation_exp", 1000);
    this_player()->add("life_exp", 500);
    return 1;
  } else return 1;
}
