// tian.c

inherit NPC;

int do_money();
int do_getup();
void create()
{
        set_name("田师爷", ({"tian shiye", "tian"}) );
        set("title", "吏部总管");
        set("gender", "男性");
        set("long", "吏部内务总管，这里大大小小的事宜都由他掌管。");
        set("age", 56);
                
        set("vendetta_mark", "authority");//设置自动追杀反官府的敌人
        set("attitude", "friendly");
        set("combat_exp", 2000);
        set("relation_exp",200000);
        set("life_exp",200000);
        
        set_skill("unarmed", 60);
        set_skill("dodge", 80);
        set("inquiry", ([
           "平步青云"  : (:do_getup:),
           "联络感情"  : (:do_money:),
]) );
        setup();
        carry_object(__DIR__"obj/qcloth")->wear();
}



int do_getup()
{

         string name;
         name=this_player()->query("name");
         if( this_player()->query("class")=="official" ){
          write("田师爷笑眯眯地说: “"+name+"大人飞黄腾达指日可待，呵呵，不必太着急。。。。。。”.\n");
          write("田师爷大有深意的看了看你。。。。。。这官场上靠的其实也就是个情面。大人。。。。。。\n");
           return 1;
           }
         

         write("王师爷抬头看了看你：“平步青云？哈哈，你有翅膀么？。。。。\n");
         write("不过话又说回来了，谋事在人成事在天,但要说梯子么？”。。。田师爷斜睨着你。。笑容怪怪的。\n");
         this_player()->set_temp("askup",1);
         return 1;
}

int do_money()
{
  if( this_player()->query("class")=="official" ){
  write("田师爷赞赏的笑着你：“哈哈！不错不错看来大人深谙为官之道啊。。。\n");
  write("这官场上靠的就是感情。。。感情靠的不就是联络么。。。可。。。”。呵呵\n");
  this_player()->set_temp("askgive",1);
  return 1;
  }
  write("田师爷笑了笑：“不错不错有心计。。。。但阁下似乎并非官府中人吧。。我可能帮不上什么忙了。。。。\n");
  
  return 1;
   
}


int accept_object(object who, object ob)
{
   int som;
   object hall,fang,shiye;
   hall=find_object("/u/lark/libu/hall");
   fang=find_object("/u/lark/libu/zongguanfang");
   shiye=new("/u/lark/libu/npc/tian");
   som = ob->value();
   som = som/10000;
   who->add("relation_exp",som*10);
   who->add("life_exp",som*10);
   if(who->query_temp("askup")){
    if(som<10)
       return notify_fail("你打发叫花子呢？\n");
   tell_object(who,"田师爷微微点了点头，低声说：“随我来\n");
   who->set_temp("come",1);
   message_vision("田师爷带着$N匆匆出去了.\n",who);
shiye->move(hall);
   who->move(hall);
   tell_room(hall,"田师爷带着一个人从外面匆匆进来，在尚书耳边低言几句什么，两人同时露出一丝古怪的笑容。然后匆匆出去了。\n");
   tell_room(fang,"田师爷走了进来\n");
   shiye->move(fang);
   return 1; 
   }
   if(who->query_temp("askgive")){
   if(som<100) 
    return notify_fail("田师爷笑了笑:舍不得孩子套不着狼，要想有朝一日，就不要吝啬此时此刻。。。。。呵呵\n");
   message_vision("王师爷对着$N谀笑着：“看看您的面相就知道您终非池中之物。。。。。哈哈。。。来日必定平步青云。。\n",who);
   who->add("relation_exp",som*10000);
   who->add("life_exp",som*10000);
   
   destruct(ob);
   return 1;
   }
  tell_object(who,"田师爷感激道：“多谢多谢！大人真是慷慨为人”\n");
  return 1;
}


void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && living(this_object()) &&  ob->query_temp("stealer")) {
         set_leader(ob);                
         kill_ob(ob);
         command("say 竟然敢和官府作对？找死！");
        }
}


void die()
{
        string id;
        if( objectp(killer = query_temp("last_damage_from")) ){ 
                killer->set_temp("stealer",1);
                
        }
        ::die();
}


