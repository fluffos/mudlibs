//cfpuren.c
int do_chifan();
void eventGreet();
inherit NPC;

void create() {
  set_name("仆人", ({ "puren" }));
  set("long", "如果你想填饱肚子可以找他解决(chifan)\n");
  set("title", "吏部");
  set("gender", "男性");
  set("age", 19);
  set("attitude", "friendly");
  set("food", 500);
  set("water", 500);
  set("combat_exp", 100);
  set("inquiry", ([
    "吃饭": "哦.您饿了？人是铁饭是钢书要读,饭还是要吃的(chifan)。\n",
  ]));

  setup();

  carry_object(__DIR__ "obj/qcloth")->wear();
}

void init() {
  ::init();

  if (living(this_object())
    {
      add_action("do_chifan", "chifan");
      this_object()->eventGreet(this_player());
    } else {
      tell_object(this_player(), "看来你得等会儿了。。。。hehe\n");
    }
  }
}
void eventGreet(object ob) {
  if (!ob || environment(ob) != environment(this_object())) {
    return;
  } else {
    message_vision("$N对着$n一作揖，恭声说道“您要吃点饭么(chifan)？”.\n", this_object(), ob);
  }
}

int do_chifan() {

  if ((int)this_player()->query("food") >= (int)this_player()->max_food_capacity())
    return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");
  message_vision("$N不一会儿把一碗香喷喷的馄炖端到$n的面前，$n坐在桌前开始狼吞虎咽起来.\n", this_object(), this_player());
  this_player()->add("food", 30);
  this_player()->add("water", 40);
  this_player()->start_busy(3);
  message_vision("$N抹了抹嘴站了起来，看来吃的挺爽！再来一碗？\n", this_player());
  return 1;
}
