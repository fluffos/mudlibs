// token1.c


inherit ITEM;

void create()
{
        set_name("玉佩",({ "yupei" }) );
        set("long",
                "乃是蓝田古玉琢磨而成，上镌“白马西风图”，背面凸刻古篆：“路”。\n");
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else 
                set("unit", "块");
                set("value",5000);
        setup();
}

