// shutong.c

inherit NPC;
create()
{
        set_name("书童", ({"shutong"}) );
        set("title", "吏部");
        set("long", "一个眉目清秀的书童。\n"); 
        set("age",  14);
        set("int", 30);
        set("str", 10);
        set("cor", 10);
        set("combat_exp", 300);
        set_skill("literate", 50);
        set("vendetta_mark", "authority");//设置自动追杀反官府的敌人
       

        setup();
        carry_object(__DIR__"obj/qcloth")->wear();
        
}


