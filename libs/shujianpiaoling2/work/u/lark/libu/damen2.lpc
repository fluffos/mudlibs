//damen2.c
#include <ansi.h>
inherit ROOM;

void create()
{
  set("short","二门");
  set("long",@LONG
这里是吏部尚书府的二门，是分割外院和内院的门户，再往里就是
尚书府的堂院除了尚书府的官员和受到特别容许的人，是不准入内的。
LONG
);
  set("exits",([
    "west":__DIR__"qianyuan",
    "enter":__DIR__"tangyuan",
]));
  set("objects",([
    __DIR__"npc/weishi":2,
]));
   setup();
}

int valid_leave(object who, string exit)
{
        int exp;
        object guard;
        string title;
        title=who->query("title");exp = (int) who->query("relation_exp")*10+(int) who->query
        ("life_exp");

        if( exit != "enter") return 1;
        
        if(who->query("wenzy")) {
         tell_room(this_object(),title+RED"恭喜恭喜请进请进！"NOR);
        return 1;
        }
        
        if( !present("guard",this_object())) return 1;
 if(who->query("job")) return 1;
        if( who->query("class")=="official" )
           {
           
             if(exp>1200000){
             message_vision("卫士抱拳，对着$n恭声说道：“"+title+"大人请进请进。”\n",who);
                 return 1;
               }else{
                  return 1;
            }
        
}
        return notify_fail("卫士不耐烦的挥了挥手，这里是尚书府不要乱闯\n");
}
