//tangyuan.c

inherit ROOM;

void create()
{
  set("short","堂院");
  set("long",@LONG
进来二门就是尚书府的堂院了，肃静的气氛不禁有点让人神经紧张，
这里是不容许大声喧哗的所以十分安静，北面是尚书府的总管房
南面是随从房.
LONG
);
  set("exits",([
   "north":__DIR__"zongguanfang",
   "south":__DIR__"suicongfang",
   "out":__DIR__"damen2",
   "east":__DIR__"tangyuan2",
]));
  setup();
}
