//wenshufang.c

inherit ROOM;

void create()
{
  set("short","文书房");
  set("long",@LONG
这里是尚书府的文书房，房内排放着一排排的格架，这里贮藏着
吏部的一些重要文件，可不是随意就能让人乱看的哦。
LONG
);
  set("exits",([
     "south":__DIR__"tangyuan2",
]));
  set("objects",([
      __DIR__"npc/shutong":1,
]));
  set("item_desc",([
       "文件":@TEXT
都是一些吏部升迁的记录，前人之辙，后人之师，大概会有些借鉴吧。
TEXT
]));
   setup();
}

void init()
{
 add_action("do_get","getdown");
}

int do_get(string arg)
{
object ob;
  string from;
  int x;
  x=random(4);
  if(!arg) return notify_fail("拿什么？\n");
  if(sscanf(arg,"%s from %s",arg,from)==2
  && arg=="文件"
  && from=="格架") {
  if(!present("shutong",this_object()) ||  this_player()->query("id_type")==3){
  message_vision("$N从格架上取下了一摞厚厚的文件。\n",this_player());
  if(x=0){
   __DIR__"obj/file1"->move(this_player());
  }else if(x=1){
   __DIR__"obj/file2"->move(this_player());
  }else if(x=2){
   __DIR__"obj/file3"->move(this_player());  
  }else if(x=3){

   __DIR__"obj/file4"->move(this_player());
  }
    
  return 1;
  }else{
    tell_object(this_player(),"书童拦在了你的面前，说道：“你是干什么？不要乱动!”\n");
    return 0;
 }     
} 
}
int valid_leave(object who, string exit)
{
  object ob,weishi;
  if(ob=present("shutong",this_object()) && present("file",who))
  {
   who->set_temp("stealer");
   message_vision("$N放声大叫：“快来人呀有人偷文件了!\n",ob);
   weishi=new(__DIR__"npc/weishi");
   weishi->move(this_object());
   write("一个卫士冲了进来，叫道：“谁敢在这里闹事？”\n");
   weishi->kill_ob(who);
   weishi->set_leader(who);
   return 0;
  }
  return 1;
}
