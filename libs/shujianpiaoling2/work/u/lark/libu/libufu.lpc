//changan city

inherit ROOM;

void create ()
{
        set ("short", "吏部尚书府");
        set ("long", @LONG

这里是吏部尚书的官邸,两边有两头威武的石狮,台阶下有一块三
丈高的石碑，高高的石阶上有四名虎背熊腰的卫士分立两旁,门口安安
静静,因为这里是不准许停留的。红漆镶金的大门上悬一块额匾。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
