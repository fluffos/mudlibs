//juzitang2.c

inherit ROOM;

void create()
{
   set("short","举子堂");
   set("long",@LONG
这里是尚书府内的举子堂，每年赶考的举子都要住在这里等待
京考的那一天，而在考试期间为了防止作弊考生是与世隔绝的。
如果你有床位就可以在这里安心的复习等待高考。
LONG
);
   set("exits",([
    "out":__DIR__"juzitang",
    "east":__DIR__"chufang",
    "north":__DIR__"juzifang",
    "west":__DIR__"shufang",
]));
   setup();
replace_program(ROOM);
}