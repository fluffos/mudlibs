//boce.c

#include <armor.h>

inherit ITEM;

void create()
{
   set_name("薄册",({"boce"}));
   set("long",@TEXT
        陈夕同： 1000000两
        张白发： 203900两
        王包森： 630450两
        管至诚： 355462两
        。。。。。。。。。。
一些名字和数字不知道表示些什么
                                
TEXT
      );
    set_weight(10);
    if( clonep() )
                set_default_object(__FILE__);
    else
        set("unit","本");
    setup() ;}
      
