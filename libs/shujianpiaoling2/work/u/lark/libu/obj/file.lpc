//paper.c

#include <armor.h>

inherit ITEM;

void create()
{
   set_name("吏部文件",({"paper"}));
   set("long",@TEXT
                  吏部通文
    奉上旨意，。。。政绩卓著。。。。。。
  。。。。擢升。。。。。。。。为  。。
  。。。。刻敬职守。。。。。。。 即日付任。
                                
TEXT
      );
    set_weight(10);
    if( clonep() )
                set_default_object(__FILE__);
    else
        set("unit","张");
    setup() ;}
      
