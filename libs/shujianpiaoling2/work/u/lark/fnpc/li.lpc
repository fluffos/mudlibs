#include <ansi.h>

inherit NPC;
int do_kill();
void create() {
  set_name("李大头", ({ "li datou", "li" }));
  set("long", "很嚣张的样子，但精神好象有点颓废。\n");
  set("attitude", "heroism");
  set("score", 6000);
  set("str", 27);
  set("cor", 26);
  set("cps", 25);

  set("combat_exp", 150000);
  set("max_force", 1000);
  set("force", 1000);
  set_skill("unarmed", 20);
  set_skill("sword", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("move", 100);
  set_skill("force", 150);
  set("chat_chance", 5);
  set("chat_msg", ({
    "李大头摸摸自己的腮帮子，脸上恨恨的表情，嘴里呜噜呜噜的不知道是什么动静。\n",
  }));
  set("inquiry", ([
    "说什么": (: do_kill :),
    "那小子": (: do_kill :),
  ]));
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "李大头满脸怒色，嘴里呜里呜鲁的声响着，好象。。。。，没有舌头。\n"
  }));
  set_temp("apply/dammage", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/attack", 50);

  setup();

  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}

int do_kill() {
  kill_ob(this_player());
  return 1;
}

void unconcious() {
  object killer;
  if (objectp(killer = query_temp("last_damage_from"))) {
    set_temp("fainter", killer->query("id"));
  }
  ::unconcious();
}

void revive() {
  delete_temp("fainter");
  ::revive();
}

void die() {
  string id;
  if (objectp(killer = query_temp("last_damage_from"))) {
    if (!(id = query_temp("fainter"))
      || killer->query("id") == id)
      if (killer->query("combat_exp")
        < query("combat_exp"))
        killer->add("combat_exp", 80);
  }
  ::die();
}
