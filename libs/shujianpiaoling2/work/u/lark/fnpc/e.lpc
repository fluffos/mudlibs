inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("盐水鹅", ({ "yanshuie", "e" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "扬州特产\n");
    set("unit", "只");
    set("value", 100);
    set("food_remaining", 3);
    set("food_supply", 30);
  }
}
