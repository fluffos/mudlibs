// gaolao.c

inherit NPC;
void dochou();
void create()
{
        set_name("吃茶客", ({"man"}));
        set("long", "一位每天吃饱了没事胡侃的人\n");
        set("age", 20);
        set("chat_chance", 2);
        set("combat_exp",4000);
        set("chat_msg", ({
        "吃茶客低声说：“巧巧。。可是越长越水灵了。。hehe”\n",
        "吃茶客点了点头，：“是呀是呀，好象都要滴出水来似的，这个。。那个。。。grin\n",
        "吃茶客压低声音说：“你们都不要舌头了？那个李大头不就是因为对着巧巧胡说，被那个小子一剑.....”\n",
        "吃茶客脸色马上噤若寒蝉，看了看门外，：“。。。来喝茶喝茶了。。。。”\n",       
}) );
        set("inquiry", ([
        "巧巧"      :  "吃茶客暧昧的笑了笑：“你说巧巧？她可是我们镇上的最漂亮的MM\n"
                       "她在镇子里开了个花店，不过没有事情我劝你不要去那里没事搭讪\n"
                       "要是被姓韩的那个小子看到。。。。hehe，不要说我没有告诉你哦\n",
        ]));    
        setup();
        carry_object("/obj/cloth")->wear();
}


