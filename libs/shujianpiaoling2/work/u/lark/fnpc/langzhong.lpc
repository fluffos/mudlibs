// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
create()
{
        set_name("郎中", ({"lang zhong","lang"}) );
        set("gender", "男性");
        set("long", "一个江湖医生\n");
        set("age", 33);
        set("attitude", "friendly");
        set("combat_exp", 8000);
        set("score",600);
        set_skill("parry",50);
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        setup();
        carry_object("/obj/cloth");
}

int accept_fight(object ob)
{
  return 1;
}
