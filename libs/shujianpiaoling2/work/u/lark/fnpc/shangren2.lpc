// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
create()
{
        set_name("商人", ({"shangren"}) );
        set("gender", "男性");
        set("long", "一个富的流油的家伙.\n");
        set("age", 54);
        set("attitude", "friendly");
        set("combat_exp", 70000);
        set("score",400);
        set_skill("parry",80);
        set_skill("unarmed", 80);
        set_skill("dodge", 80);
        
        set("chat_chance", 2);
         set("chat_msg", ({
        "商人摇了摇头道:最近生意可是越来越难做了\n",
        }));
        setup();
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/money/gold");
}

int accept_fight(object ob)
{
  return 1;
}

