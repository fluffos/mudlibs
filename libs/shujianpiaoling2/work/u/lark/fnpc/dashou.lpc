// boaer.c

inherit NPC;
inherit F_VENDOR;


void create()
{
        set_name("打手", ({"dashou","da"}) );
        set("long", "一个满脸横肉的打手\n");
        
        set("age", 27);
        set("max_kee", 1000);
        set("max_force", 1000);
        set("force_factor", 3);
        set("water", 600);
        set("food", 600);
        set_skill("unarmed", 80);
        set_skill("dodge", 80);
        set_skill("force", 80);
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 30);
        set("combat_exp", 30000);
 set("chat_chance", 10);

        set("chat_msg", ({
                "打手撸了撸袖子，狠狠的看着你\n",
          }) );
        setup();
         carry_object("/obj/cloth")->wear();


}


int accept_fight(object ob)
{
  return 1;
}
