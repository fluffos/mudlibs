#include <ansi.h>

inherit NPC;

void create()
{
        set_name("山寨喽罗", ({ "guard" }) );
        set("long", "这是双霄寨的喽罗\n");
        set("attitude", "aggressive");
         set("title",RED "此山是我开 此树是我栽" NOR);
        set("str", 27);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", 5000);

        set_skill("unarmed", 20);
       set_skill("blade", 80);
        set_skill("parry", 70);
        set_skill("dodge", 70);
        set_skill("move", 100);
        set_skill("force", 50);
        
        set_temp("apply/dammage", 10);
        set_temp("apply/defense", 10);
        set_temp("apply/attack", 10);
         set("chat_chance", 15);
        set("chat_msg", ({
         "他奶奶的，最近肥羊可真少！",
        }) );
                set("chat_msg_combat", ({
       "哈哈！总算等到了你了！！！",
        }) );
        setup();

        carry_object("/obj/cloth")->wear();
        carry_object("/obj/blade")->wield();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && living(this_object())) {
                kill_ob(ob);
        }
}

void unconcious()
{
        object killer;
        if( objectp(killer = query_temp("last_damage_from")) ){
                set_temp("fainter", killer->query("id"));
        }
        ::unconcious();
}

void revive()
{
        delete_temp("fainter");
        ::revive();
}

void die()
{
        string id;
        if( objectp(killer = query_temp("last_damage_from")) ){ 
                if(!( id = query_temp("fainter"))
                || killer->query("id") == id )
                        if( killer->query("combat_exp")
                           < query("combat_exp") )
                           killer->add("combat_exp", 20);
        }
        ::die();
}

void killed_enemy(object who)
{
        command("say 哈哈哈哈哈哈...");
        command("get all from corpse");
}
