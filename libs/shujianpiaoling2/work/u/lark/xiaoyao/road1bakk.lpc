//road1.c

inherit ROOM;

void create()
{
  set("short","缥缈山麓");
  set("long",@LONG
沿着小路蹒跚而行，路边点缀着落霜红和珠砂根的蓓蕾，隐约的
闪现着动人的红光，怀着急不可耐的心情你快步的走进村子。石
桓上方露出几栋房屋，白壁，黑色的墙板，一排排漂亮的窗子。
一幢幢屋顶的瓦房轮廓清晰的高耸在斜暮的天际。
LONG
);
  set("exits",([
   "southdown":__DIR__"road",
   "northup":__DIR__"xy",
   "westup":__DIR__"sf",
   "eastup":__DIR__"fall",
]));
  set("objects",([
   __DIR__"npc/saux":1,
]));
  setup();
}

int valid_leave(object who, string exit)
{
  object ob,saux;
  string name;
  name=who->query("name");  
  if(exit=="southdown") return 1; 
  if(!present("saux",this_object())) return 1;
  saux=present("saux",this_object()); 
   if(ob=present("yupei",who)){
     if(ob->query("owner")==name) {
        message_vision("韩江雪亲热的和$N的打了个招呼：“嗨！你好啊回来了？”\n",who);
    return 1;
    }else{
    message_vision("韩江雪拦住了$N，卸下了你的玉佩，仔细看了看：你是从那里得到的？你是谁？敢来冒充？\n",who);
    saux->kill_ob(who);
    return 0;
    }
   }
     
    
  return notify_fail("韩江雪摇了摇头说：“"+RANK_D->query_respect(who)+
  "大师哥不愿意外人打扰呀，请回吧。”\n");
}

