#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "小院");
        set("long", @LONG
高大的红墙包围下是一个小巧的院落，但是显得很萧条的样子。安安静静
听不到一点动静。北面有一栋房间，禁闭着门不知道里面有些什么东西。
窗户上有些发黄的窗纸在微风里微微的振动着.从里面传出模模糊糊的声音。
LONG
        );
        set("item_desc" , ([
        "门" : "禁闭着的门\n",
        "door" : "禁闭着的门\n",
        "窗" : "糊着窗纸\n",
        "window":"糊着窗纸\n",
        "窗纸" : "你是不是个笨蛋呀？按照情节这个时候你只要用自己的吐沫点点不就好了？\n", 
        ]) );
        set("exits", ([ /* sizeof() == 3 */
   "south" : __DIR__"town3",
]));
//        set("objects",([
//        "/u/lark/fnpc/jumin":2,
//]));
        set("outdoors", "yangzhou");
        setup();
}

void init()
{
        add_action("do_knock", "open");
        add_action("do_climb", "tong");
}

void reset()
{
        object ob;
        ::reset();
//        if( ob=present("black", this_object()) )
//                destruct(ob);
        if( query("exits/north") )delete("exits/north");
}

int do_knock(string arg)
{
        object ob;
        int i;
        i=random(5);
        if( arg != "door" && arg != "门" ) return notify_fail("打开什么？\n");
        
        if( query("exits/enter") )return notify_fail("门都开了\n");
        
        set("exits/enter", __DIR__"cxy1");
        message_vision("$N推开了禁闭的门，突然从里面传出一声怒喝：谁？\n", this_player());
        tell_room(__FILE__, "一个沙哑的声音道：不是交代过不许随便打扰么？给我滚！！！\n");
        return 1;
       
 
}

int do_climb(string arg)
{
        if( arg != "window" && arg != "窗纸" )return notify_fail("你要捅什么？\n");
        
        message_vision("$N用食指沾了点唾沫，轻轻的捅破了窗户纸,爬上去往屋内张望\n", this_player());
        call_out("start_ls",1,this_player());
        return 1;
}
/*
int valid_leave(object who, string exit)
{
        if( exit != "north" )return 1;
        if( !present("black", this_object()) ) return 1;
        if( who->query("cxykiller") )return 1;
        return notify_fail("黑衣人低声道：我可警告您不要乱闯，要闹出人命的\n");
}
*/
int start_ls(object ob)
{
  object dcq;
  object room;
  tell_object(ob,"你透过窗纸上的小洞往屋内张望，隐隐约约似乎有两个人影,似乎在交谈什么。\n");
  message_vision("$N把耳朵凑向前，似乎仔细倾听着什么\n",this_player());
  tell_object(ob,"你隐约听道一个苍老的声音：公子，不要动怒，高歌那小子这回给咱们找到了下落\n"
  "这回他可能插翅难飞了。我立刻向教主禀报,派教内高手必定将其击杀。。。\n");
  tell_object(ob,"一个低沉略带嘶哑的声音道：姓高的的确有两下，当年一战竟伤我如斯。。。\n"
   "呵呵（一阵急促的咳嗽声）。。。。。可惜。。。。呵。。。毕竟不能为我教所用。否则可为\n"
   "我父添一强助。。。。呵呵。。。。。\n");
  tell_object(ob,"屋内似乎传来一阵运气吐呐的声音，半晌苍老的声音道：公子请注意身体\n"
  "高歌那小子再厉害不也给公子打的落荒而逃？消声觅迹了这么久不就是怕了公子您？.......\n"
  "嘶哑的声音突然打断说：住口，你懂什么？。。。呵呵。。。。要不是我当年用计策扰乱了他的心神\n"
  "那一战孰赢孰败可能就非如此了。。。。。呵呵。。。。。即便如此更加我使用秘法化血增功依然不能\n"
  "杀他于剑下，被他全身而退，虽然逼他离开了逍遥，却使我大损功力至尽不能复元。。。。。呵呵。\n"
   "唉。。。。。呵...屋内有传来一阵吐呐运气声\n");
  tell_object(ob,"苍老的声音惶恐道：属下无能，属下该死，公子请息怒\n");
tell_object(ob,"过了一阵，嘶哑的声音又说道：罢了罢了，如今既然已经确定了他隐匿在官府\n"
  "呵呵。。此次。。。呵呵。。。此次你回禀我父应派遣教高手务必不能失败，否则再。。。。\n"
  "呵呵。。。恐怕我教之中再无人能将其制服了。。。。。。。。突然屋内静了下来。\n");
  tell_object(ob,HIR "嘶哑的声音厉声道：还象听到什么时候？给我滚出来！！！\n"NOR);
  message_vision(BLU "一股凄厉的杀气从屋内喷薄而出，突然窗栏破碎一个灰衣人影如烟而出，突然出先在 你的面前\n" NOR,this_player());
 
  this_player()->set("faxianle",1);
   room=find_object("/u/lark/xiaoyao/cxy1");
  if(!present("ding chunqiu",room))
   ob=new("/u/lark/xiaoyao/npc/dingcq");
  else
   ob=present("ding chunqiu",room);
   ob->move(__DIR__"cxy");
   return 1;
}

