// medicine.c

inherit ITEM;

void create()
{
        set_name("蘑菇",({"mogu"}));
        set_weight(60);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("long",
               "一朵可爱的蘑菇。\n");
            set("unit","朵");
        set("objattrib", 1);
            set("value", 0);
        }
}

void init()
{
  if(this_player()==environment())
        add_action("apply_medicine","yong");
}

int apply_medicine()
{
        int value = 20;
        int diff;

        if(this_player()->is_fighting())
            return notify_fail("战斗中不能用药！！\n");
        diff = this_player()->query("max_kee")-this_player()->query("eff_kee");
        if(!(diff))    return notify_fail("你没有受伤！\n");
        if(value > diff) value = diff;
            
        message_vision("$N用蘑菇补气 ．\n",this_player());
        this_player()->add("eff_kee",value);
        destruct(this_object());
        return 1;
}

