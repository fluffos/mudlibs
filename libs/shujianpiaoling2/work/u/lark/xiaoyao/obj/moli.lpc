// dingx.c

#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create() {
  set_name(WHT "茉莉" NOR, ({ "moli" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "白色的茉莉那是爱情无暇的纯真\n");
    set("unit", "枝");
    set("value", 100);
    set("armor_prop/personality", 2);
  }
  set("wear_msg", "$N细心地把茉莉别在鬓角\n");
  set("unequip_msg", "$N从发间取下茉莉\n");
  setup();
}
