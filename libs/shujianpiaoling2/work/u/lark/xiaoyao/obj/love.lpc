// dingx.c

#include <armor.h>
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(MAG "我轻舞飞扬的梦想" NOR, ({"show"}));
        set_weight(1000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", @TEXT
          每个人的心底里都有一汪清清的镜湖，
          我们一出生就沉浸在那里，
          她无暇的滋润让我们纯洁而通透，
          她给我们最真诚的眼睛用来面对世界，
          她给我们最善良的心灵用来感受生活，
          她给我们最美丽的笑容用来宽待世人，
          但是随着时间的流失，
          湖水渐渐干涸，
          麻木慢慢让我们习以为常，
          我们学会了习惯，
          真的还是假的都已经不再重要，
          丑的还是恶的都已经安然相对，
          我们坚硬的外壳，
          可以抵挡外界的风雨，
          却让我胸中冲突的激情灼伤了自己，
          于是我创造了这个世界，
          只是为了给我的小湖，
          找一条永不枯竭的水源，
          让她永远充盈，
          当我在迷失了自己的时候，
          可以凭着她涟漪找到归途，
          当我在饥渴的时候，
          可以滋润我枯涩的喉咙，
          当我开始对自己的虚伪厌恶不已的时候
          荡涤我身上沾满尘埃,
          因为我知道，
          我的故乡，
          就在这里,
          镜湖。
          她.........
TEXT         
);


                set("unit", "块");
                set("value", 100);
                
        }
       
        setup();
}


