// book1.c
inherit ITEM;

void create()
{
        set_name("逍遥修仙秘籍", ({ "book" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
                        "这就是武林中人梦寐以求的修仙术.\n");
                set("value", 0);
                set("material", "book");
                set("skill", ([
                        "name":                 "incarnation",     
                        "exp_required": 20000,                            
                        "sen_cost":             30,                              
                        "difficulty":   50,              
                        "max_skill":    50             
                ]) );
        }
}
