// dingx.c

#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create() {
  set_name(HIR "红花" NOR, ({ "hua" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一朵红色的花，看上去很普通,有些发蔫\n");
    set("unit", "朵");
    set("value", 100);
    set("armor_prop/personality", -10);
  }
  set("wear_msg", "$N庄重严肃的把一朵红花别在左胸\n");
  set("unequip_msg", "$N从左胸上小心的取下一朵红花，收藏在怀中\n");
  setup();
}
int query_autoload() {
  string name;
  if (this_player()->query("class", "cccp")) {
    return 1;
  }
  return 0;

}
