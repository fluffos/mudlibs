//daotian.c
#include <ansi.h>
inherit ROOM;
void improve(object who);
void create()
{
        set("short", "田地");
        set("long", @LONG
可能是刚刚收割完的一片闲置的田地，无论你要播种什么，只要
你曾撒下种子，结果。。。在下一个春天你一定能够看到。至于
会是什么不要问，那未知的错觉才是一直支持着我们前进脚步的
来源。
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"daotian"
  
]));
        
        setup();
        
}

void init()
{
  add_action("do_xia","xia");
}

int do_xia(string arg)
{
int n;
 n = random(5)+7;
 if(this_player()->query_temp("xiaoyao/quest")!=6)
       return notify_fail("土豆很好看么？练功去吧!\n");
   if(arg)
    return notify_fail("要下土豆？(xia)\n");
 if(this_player()->query_temp("xiaoyao/busy"))
       return notify_fail(RED "一个字: 急!\n" NOR);
  if(this_player()->query("sen")<40  || this_player()->query("gin")<40)
       return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
 if(this_player()->query_temp("xiaoyao/over"))
    return notify_fail("别假积极了。\n");
  this_player()->set_temp("xiaoyao/busy",1);
  if(this_player()->query_temp("xiaoyao/num")>=n){

 write(YEL "总算下完后一陇，你擦了擦额头的汗水，该收工了！\n" NOR);
 message_vision("$N直起身子摸摸有些酸痛的腰，擦了擦额头的汗水，拍拍身上的尘土收工了!\n",this_player());
 this_player()->delete_temp("xiaoyao/num");
 this_player()->set_temp("xiaoyao/over",1);
 this_player()->delete_temp("xiaoyao/busy");
 return 1;
 }


  message_vision("$N从腰间的袋中掏出土豆芽，在地上刨出一个小坑，小心翼翼的放了下去再培好土。\n",this_player());
   write(YEL "想到埋地下的土豆，正在慢慢成长你的心中充满了等待的期望。\n"  NOR);
   message_vision(YEL "$N愉快的放声高歌道：“浮华尘世兮非我愿，躬耕田亩兮吾知足”\n" NOR,this_player());  
   call_out("improve",1,this_player());
   this_player()->start_busy(1);
   return 1;
}

void improve(object who)
{

  if(!who)  return;
if(who->query_skill("unarmed",1)<200) 
 who->improve_skill("unarmed",random((int)who->query("int")));
 who->add("sen",-(30-(int)who->query_skill("unarmed",1)/8));
 who->add("gin",-(30-(int)who->query_skill("unarmed",1)/8));

 who->add_temp("xiaoyao/num",1);
 who->set_temp("xiaoyao/busy",0);
}
