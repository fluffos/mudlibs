// roadc.c

inherit ROOM;

void create()
{
        set("short", "黄土路");
        set("long", @LONG
这是一条弯弯曲曲的黄土路, 一路向东南折去。远远的前面出现了一片连绵的山脉，
笼罩在朦胧的云烟中看不真切，飘渺无踪。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "southeast" : __DIR__"roadd",
  "northwest" :__DIR__"roadb",
]));

        setup();
        replace_program(ROOM);
}

