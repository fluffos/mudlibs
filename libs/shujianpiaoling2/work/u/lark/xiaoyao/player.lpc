//room:player
#include <ansi.h>
inherit ROOM;
string look_sig(object me);
void create()
{
        set("short", "小院");
        set("long", @LONG
白色的围墙里这里是一片安静的院落是弟子们日常起居的场所，
新修葺的葛草屋顶，散发着幽幽的清新。如果你愿意可以有自
己一套单独的小屋。屋檐上挂着一个风铃.(bell)
LONG
        );
        set("exits", ([ 
  "west": __DIR__"xy2",
  "east":__DIR__"room",
]) );
        
        set("item_desc", ([
            "bell":
@LONG
献给逍遥的创始人，亲爱的海清"
LONG
            ]));
        setup();
//   call_other( "/obj/board/xiaoyao-board", "???" );
}


        
        
void init()
{
          add_action("do_clear","clear");
}

                            

int do_clear(string arg)
{
 int n;
 n = random(5)+8;
        if(this_player()->query_temp("xiaoyao/quest")!=2)
    return notify_fail("什么？\n");
if(this_player()->query_temp("xiaoyao/over"))
    return notify_fail("别假积极了。\n");
  if(arg)
    return notify_fail("打扫院子?？(clear)\n");
  if(this_player()->query_temp("xiaoyao/busy"))
       return notify_fail(RED "一个字: 急!\n" NOR);
 if(this_player()->query("sen")<40  || this_player()->query("gin")<40)
       return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
   this_player()->set_temp("xiaoyao/busy",1);   
  if(this_player()->query_temp("xiaoyao/num")>=n){
    write(YEL "你擦了擦额头的汗水，该收工了！\n" NOR);
 message_vision("$N擦了擦额头的汗水，拍拍身上的粘满的尘土收工了!\n",this_player());
 this_player()->delete_temp("xiaoyao/num");
 this_player()->set_temp("xiaoyao/over",1);
 this_player()->delete_temp("xiaoyao/busy");
 return 1;
 }
  message_vision("$N正在认真的打扫院子\n",this_player());
  call_out("improve",1,this_player());
  this_player()->start_busy(1);
  return 1;
}



void improve(object who)
{

  if(!who)  return;
if(who->query_skill("dodge",1)<200) 
 who->improve_skill("dodge",random((int)who->query("int")));
 who->add("sen",-(35-(int)who->query_skill("dodge",1)/7));
 who->add("gin",-(35-(int)who->query_skill("dodge",1)/7));

 who->add_temp("xiaoyao/num",1);
 who->set_temp("xiaoyao/busy",0);
}

