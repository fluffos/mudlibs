
//road1.c

inherit ROOM;

void create()
{
  set("short","缥缈峰下");
  set("long",@LONG
沿着小路蹒跚而行，路边点缀着落霜红和珠砂根的蓓蕾，隐约的
闪现着动人的红光，山峰高耸入云端，高而不可测。山壁陡峭而
光滑。似乎是不可能攀登的。
LONG
);
  set("exits",([
   "eastdown":__DIR__"road1",
]));
 
  setup();
}

void init()
{
 add_action("do_climb","climb");
}

int do_climb(string arg)
{
  if(!arg)
    return notify_fail("你要爬什么呢？\n");
  if(arg!="up")
    return notify_fail("你要爬向哪个方向？\n");
  message_vision("$N扒住突兀的岩石，开始往上攀爬!\n",this_player());
 
 tell_object(this_player(),"你手脚并用开始吃力的往上爬!\n");
 tell_room(__DIR__"half","一个人从山下狼狈的爬了上来\n");
 remove_call_out("improve");
 call_out("improve",1,this_player());
 this_player()->move(__DIR__"half");
 return 1;
} 
  
void improve(object who)
{
 object ob;
 if(who->query_skill("dodge",1)>100){
 write("你擦了擦额头的汗水，低头看了看，心里不觉暗喜：“这么高的山崖我竟然这么容易就爬上来了”\n");
 return;
 }
 who->improve_skill("dodge",random((int)who->query("int") + (int)who->query_skill("dodge",1)/5));
 who->add("sen",-(60-(int)who->query_skill("dodge",1)/2));
 who->add("gin",-(60-(int)who->query_skill("dodge",1)/2));
 return;
}       
