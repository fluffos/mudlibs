//room:top.c

inherit ROOM;
void create() {
  set("short", "飘渺峰顶");
  set("long", @LONG
山顶之上，空气变的冷冽起来，浓浓的雾充斥着你的周围，
只能看清四五尺外的事物，脚下的石板路平整而光滑，路旁
种着一些珍奇的花草，正散发着郁郁的清香，远处参天的
松柏林，发出类似潮汐涌动的声音。
LONG
  );
  set("exits", ([
    "north": __DIR__ "top1",
  ]));
  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  if (!arg || arg != "down")
    return notify_fail("你要往哪里？\n");



  if (arg == "down") {
    message_vision("$N试了试脚边的岩石稳不稳，开始小心翼翼地往山涧中攀了下去。\n",
      this_player());

    this_player()->move(__DIR__ "sf");
  }
  return 1;
}
