//huofang.c
#include <ansi.h>
inherit ROOM;

void create()
{
  set("short","厨房");
  set("long",@LONG
一间干净整洁的厨房，各种器皿码放整齐，清洁明亮。一个小姑娘正在厨间忙碌着，从
灶上火头上的锅里飘出了诱人的香气。这里为逍遥的弟子们提供饮食。
LONG
);
  set("exits",([
    "east":__DIR__"ground",
]));
  set("objects",([
    __DIR__"npc/qingyan":1,
]));
  setup();

}

void init()
{
   add_action("do_cook","cooking");
}

int do_cook(string arg)
{
  int n;
  n = random(5)+8;
    if(this_player()->query_temp("xiaoyao/over"))
    return notify_fail("别假积极了。\n");
    if(this_player()->query_temp("xiaoyao/busy"))
       return notify_fail(RED "一个字: 急!\n" NOR);
 if(this_player()->query("sen")<40  || this_player()->query("gin")<40)
       return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
   if(this_player()->query_temp("xiaoyao/quest")!=8)
         return notify_fail("云烟子笑了笑说：“你还是好好练功吧，我这里不缺人手了”\n");
  if(arg)
   return notify_fail("要炒菜？ 。(cook)\n");
 this_player()->set_temp("xiaoyao/busy",1);  
     if(this_player()->query_temp("xiaoyao/num")>=n){ 
   write(YEL "不管能不能吃，但总算做完了。\n" NOR);
 message_vision("$N把油腻腻的手在毛巾上擦了擦，抹掉了额头的汗水，从锅里掏出一些碳状物质。。。。。大概那就是今天的晚饭吧。my god!。\n",this_player());
 this_player()->set_temp("xiaoyao/over",1);
 this_player()->delete_temp("xiaoyao/num");
 this_player()->delete_temp("xiaoyao/busy");
 return 1;
}
 message_vision("$N用炒勺在锅里翻腾着什么。。。。。。。。\n",this_player());  

 
  call_out("improve",1,this_player());
  this_player()->start_busy(1);
  return 1;
}

void improve(object who)
{
  if(!who)  return;
if(who->query_skill("parry",1)<200) 
 who->improve_skill("parry",random((int)who->query("int")));
 who->add("sen",-(35-(int)who->query_skill("parry",1)/7));
 who->add("gin",-(35-(int)who->query_skill("parry",1)/7));

 who->add_temp("xiaoyao/num",1);
 who->set_temp("xiaoyao/busy",0);
}
