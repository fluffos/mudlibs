//room:公共休息室
//lou.c
#include <ansi.h>
inherit ROOM;

void create()
{
  set("short",HIC "房改新成果---筒子楼" NOR);
  set("long",@LONG
应广大住户要求，逍遥物业管理公司进行了房屋的拆迁，整修，
根据国家经济，实用，方便的方针政策，进行了筒子楼的建设
现已交付使用，希望广大住户能够满意。

光秃秃的水泥地上放着一排排的草席，从狭小的窗缝里微微露
出一些光线，似乎有些物体倒在上面，发出一些古怪的声音。
LONG
);
 set("exits",([
"west":__DIR__"player",
]));
  set("no_kill",1);
  set("no_magic",1);
  set("no_dead",1);
  set("no_clean_up", 1);
  set("sleep_room",1);
  set("valid_startroom", 1);
  setup();
}

