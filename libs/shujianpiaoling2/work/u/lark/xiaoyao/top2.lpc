//top2.c

inherit ROOM;

void create() {
  set("short", "飘渺峰顶");
  set("long", @LONG
顺着蜿蜒的小径曲折向前，不一会就来到了一块直峭的山壁前，一片楼阁似乎横空迩来，
附着几乎不可攀缘的石壁凌空而建，距地面起码有三四丈高。雕橼画梁依稀可辨，红门
蓝瓦宛然若见。真是巧夺天工的奇迹呀.可。。。。电梯间在那里呀？右手有棵高大的松柏
也不知道有多少年头了，冠如车盖巍然而立，树下似乎有什么物体.
LONG
  );
  set("exits", ([
    "south": __DIR__ "top1",
    "east": __DIR__ "top3",
  ]));
  setup();
  replace_program(ROOM);
}
