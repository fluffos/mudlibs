// kid.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("小孩子", ({ "kid" }));

  set("gender", "男性");
  set("age", 6);
  set("str", 10);
  set("cor", 10);
  set("cps", 11);
  set("per", 30);
  set("int", 21);



  set("long", "一个玩耍的孩童，可爱天真。\n");

  set("combat_exp", 300);
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "你敢欺负我？高哥哥知道了不会饶了你。\n",
  }));
  set("chat_chance", 3);
  set("chat_msg", ({
    "小孩子叫道:该我了该我了!\n"
    "小孩子叫道：“你要是耍赖皮，等高哥哥回来，我就告诉他。”\n",
  }));

  set_skill("unarmed", 5);
  set_skill("parry", 5);
  set_skill("dodge", 5);
  set_skill("sword", 5);
  set_skill("force", 5);
  set_skill("literate", 5);


  setup();
  carry_object("/obj/cloth")->wear();
}
