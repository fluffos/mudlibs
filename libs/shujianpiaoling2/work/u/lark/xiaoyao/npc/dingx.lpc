//saux.c

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("丁香", ({ "ding xiang", "ding", "master ding", "master" }));
  set("long",
    "逍遥派的四师姐，恬淡的脸上却总是带着一丝忧伤。\n");
  set("nickname", MAG "寂寞开无主 无意苦争春" NOR);
  set("attitude", "friendly");

  create_family("逍遥派", 12, "弟子");
  set("title", "四师姐");
  set("gender", "女性");
  set("age", 26);
  set("str", 26);
  set("int", 30);
  set("cor", 20);
  set("spi", 30);
  set("agi", 20);
  set("per", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 40);
  set("score", 90000);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/move", 50);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({

    (: perform_action, "unarmed.rain" :),
    (: perform_action, "unarmed.flower" :),
    (: perform_action, "dodge.walk" :),

  }));
  set("combat_exp", 4000000);
  set("relation_exp", 90000);     //设置人际关系
  set("life_exp", 50000);         //设置江湖阅历
  set_skill("honey", 200);
  set_skill("ymei_strike", 200);
  set_skill("unarmed", 200);
  set_skill("force", 150);
  set_skill("parry", 180);
  set_skill("dodge", 180);
  set_skill("bm_force", 150);
  set_skill("wave_steps", 180);

  map_skill("force", "bm_force");
  map_skill("unarmed", "ymei_strike");
  map_skill("parry", "ymei_strike");
  map_skill("dodge", "wave_steps");
  set_skill("move", 100);
  set_skill("literate", 200);

  setup();


  carry_object("obj/cloth")->wear();
}




int accept_fight(object me)  // 接受玩家fight时调用
{
  if ((string)me->query("family/family_name") == "逍遥派") {
    command("say 好啊！练练手也好。");
    return 1;
  }
  command("smile");
  command("shake");
  return 0;
}

void attempt_apprentice(object me) {

  if (this_player()->query("class") == "xiaoyao") {

    if (this_player()->query("combat_exp") < 50000) {
      command("shake");
      command("say 你还是先和檀香子学些基本工夫吧.\n");
      return;
    }
    command("smile");
    command("recruit " + me->query("id"));
    me->set("class", "xiaoyao");
    me->set("id_type", 1);
  }
  command("hmm");
  command("say 大师哥说过不让随便接受新弟子的，对不起呀。");
}
