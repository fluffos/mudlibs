int accept_object(object who, object ob)
{
        object yu;
        object room;
        room=find_object("/u/lark/xiaoyao/town3");
        if(  !(yu = present("yupei", who) ) )return 0;
        if( !yu->query("equipped"))return 0;
        if( ob->name()!= "密信"|| ob->query("id")!= "letter")return 0; 
//      call_out("laoda", 1, who);
        command("say 哦？信？好的我收下了。\n");
        message_vision("$N说完一转身回去了。大门又关上了\n",this_object());
        destruct(this_object());
        if(room->query("exits/north") ) room->delete("exits/north");
        
        this_player()->delete_temp("letter");
        this_player()->set_temp("over",1);
        return 1;
}

