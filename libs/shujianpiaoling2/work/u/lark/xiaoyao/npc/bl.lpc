#include <ansi.h>
inherit NPC;


int do_permit();
create()
{
        set_name("黑衣人", ({ "black"}) );
        set("gender", "男性");
        set("long", "他一袭黑衣，微微低着头似乎故意不显露自己的面容。\n");
        set("age", 25);
        set("attitude", "friendly");
        set("combat_exp", 200000);
        
        set_skill("unarmed", 200);
        set_skill("dodge", 200);
        set("inquiry", ([
           "信"   :(:do_permit:),
           
]) );
        set_temp("apply/dammage", 100);
        set_temp("apply/dodge", 100);
        set_temp("apply/defense", 50);
        setup();
       carry_object("/obj/cloth")->wear();
}

void init(){
add_action("do_kill","kill");
}




int do_permit()
{
        object room;
        room=find_object("/u/lark/xiaoyao/town3");
//      if(this_player()->query("combat_exp") < 10000)
//              command("say 哈哈，你功夫这么臭...");
//      else if( this_player()->query("wuhankiller") )
//              command("hammer " + this_player()->query("id"));
//      else {
//              command("say 哈哈！你想加入我们！知道我们是干什么的吗？");
//              this_player()->set_temp("joinkiller", 1);
//      }
//      return 1;
        if(present("yupei",this_player())){
        tell_object(this_player(),"黑衣人低头看了看你腰间的如意令点了点头：给我吧。\n");
      
        return 1;}
        if(this_player()->query_temp("zhaocha")){
        command("say 你小子看来是到这里找茬的。找死！！！！\n");
         
        command("heng");
        call_out("do_copy",1,this_player());
        kill_ob(this_player());
        set_leader(this_player());
        return 1;
        }        
        command("hmm");
        command("say 对不起，你找错了\n");
        message_vision("$N一转身回去了。大门砰的一声关上了\n",this_object());
        destruct(this_object());
        this_player()->set_temp("zhaocha",1);
        if(room->query("exits/north") ) room->delete("exits/north");
        return 1;




}
