#include <ansi.h>
string reward_more( object who);

inherit NPC;
void create()
{

         set_name("沙袋",({ "sha dai","dai"})); 
         set("gender", "男性" );
        set("attitude", "friendly");
        

 set("str", 15);
        set("cor", 30);
        set("cps", 25);
         set("chat_chance", 2);
        
        set("combat_exp", 10000);
     set("food",3000);
     set("water",3000);
        set_skill("sword", 30);
        set_skill("parry", 30);
        set_skill("dodge", 30);
        set_skill("unarmed", 30);
        set_skill("force", 30);
        set("chat_chance", 10);
        set_skill("gaoge_sword",60);
        map_skill("sword","gaoge_sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: reward_more(this_object()) :),
        }) );
        setup();
        carry_object("/obj/sword");
        carry_object("/obj/cloth")->wear();
}

string reward_more(object who)
{
        int i;
        object *enemy;
        seteuid(getuid());
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        if( enemy[i]->query("combat_exp") > 100000 ) return "1";
                        enemy[i]->add("combat_exp", 1);
                        if( enemy[i]->query("potential") > 8000 ) return "1";
                        enemy[i]->add("potential", 1);
                }
        }
        return "1";
}
int accept_fight(object ob)
{
     return 1;
}



