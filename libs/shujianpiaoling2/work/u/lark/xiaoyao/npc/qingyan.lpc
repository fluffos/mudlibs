// wu.c

inherit NPC;
void greeting(object ob);
int do_ask();
create()
{
        set_name("云烟子", ({"yun yanzi","qing"}) );
        
        set("gender", "女性");
        set("long", "她的手艺可是不错的哦，以前高师兄就最爱吃她作的饭\n");
        set("age", 16);
        set("attitude", "friendly");
        set("combat_exp", 500);
        
        set_skill("unarmed", 10);
        set_skill("dodge", 10);
        set("inquiry", ([
           "牛奶"   :  "口渴了？这里有新鲜牛奶(drink)哦。\n", 
           "米饭"   :  "饿了啊。我马上给你炒饭(eat)。以前高师兄可就最爱吃哦。\n",
           "高师兄" :  (:do_ask:),
           
]) );
        setup();
        carry_object("/obj/cloth")->wear();
}

void init()
{
        object ob,obc;

        ::init();
      if(this_player()->query_temp("cook"))
             command("say 你帮我把饭闷(cook)上吧");     
      if(this_player()->query_temp("food")){
             command("say 这是我给棋痴子师兄准备好的，给你。\n");
             command("say 唉，他太旁滞外物了，原来高师兄也常说他\n");
             command("say 不知什么时候又迷上了围棋，整天不吃不睡的在山底下看棋谱。\n");
             command("shake");
             obc=new("/u/lark/libu/obj/rice");
             obc->move(this_player());
             }
      if( interactive(ob=this_player()))
              call_out("greeting", 1, ob);
        add_action("do_drink", "drink");
        add_action("do_eat","eat");
        
}

void greeting(object ob)
{
        remove_call_out("greeting");
        if( !ob || environment() != environment(ob))return;
        command("say 师兄饿了吧？有新鲜牛奶喝(drink)还有刚打的大米饭吃(eat)哦");
        return;
}
        

int do_drink(string arg)
{
 object ob;
 if(arg)
    return notify_fail("渴了呀？喝吧。(drink)\n");
 if(this_player()->query("class")!="xiaoyao")
    return notify_fail("轻烟子笑了笑：“不是我舍不得，可是高师兄一向教导我们要自食其力。。xixi\n");
 message_vision("轻烟子转过身提过一桶鲜奶，可爱的笑了笑说:“刚刚才挤的，很新鲜的哦”\n",this_player());
 ob=new(__DIR__"obj/milk");
 ob->move(this_player());
 return 1;
}

int do_eat(string arg)
{
   object ob;
 if(arg)
   return notify_fail("饿了？吃吧.(eat)\n");
 if(this_player()->query("class")!="xiaoyao")
    return notify_fail("轻烟子笑了笑：“不是我舍不得，可是高师兄一向教导我们要自食其力。。xixi\n");
 message_vision("轻烟子揭开锅从里面盛出了一碗香喷喷的什锦炒饭来，笑着说：“这是以前高师兄最爱吃的炒饭。我作的”\n",this_player());
 command("xixi");
 ob=new("/u/lark/libu/obj/rice");
 ob->move(this_player());
 return 1;
}

int do_ask()
{
 
 command("hmm");
 
 tell_object(this_player(),"高师兄是师父最喜爱的弟子，以前是逍遥派的大师兄，"
"我们的功夫都是师兄传授的,可是自从丁师叔把楚师兄带来。。。。。。\n");
  command("sigh");
 tell_object(this_player(),"丁师姐本来和高师兄青梅竹马的，可是楚师兄一来一切"
"都变了。丁师姐和高师兄越来越疏远，还和楚师兄定了婚事。。。。。。。\n");
 
 tell_object(this_player(),"高师兄那段时间好失落，变了个人似的整天喝酒完全了没有以前潇洒的样子\n");
 command("sigh");
 tell_object(this_player(),"可这时候丁师叔却非要逼高师兄和楚师兄比武，结果。。"
 "高师兄就从那个时候不辞而别。。到现在还没有消息。而楚师兄就成了大师兄。。。\n");
 command("shake");
 tell_object(this_player(),"缘分这个东西可能真的注定。。。要是高师兄是喜欢。。。\n");
 tell_object(this_player(),"轻烟子脸上露出一丝幽怨的神情\n");
 command("sigh");
 return 1;
}

int accept_object(object who, object ob)
{
  if(who->query_temp("ok")){
   if(ob->query("name")=="牛奶"){
    command("smile");
    command("say 谢谢啦\n");
    who->set_temp("over",1);
who->delete_temp("ok");
    return 1;
    }
   return 0;
  }
  return 0;
}

