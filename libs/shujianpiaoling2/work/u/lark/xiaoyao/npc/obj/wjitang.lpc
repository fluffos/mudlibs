// baotang.c
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("乌龙白凤汤", ({"jitang"}) );
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一罐看不出所以然来的鲜汤\n");
                set("value", 20000);
                set("unit", "罐");
        }
        setup();
}

void init()
{
    add_action("do_eat", ({"eat", "chi"}));
}

int do_eat(string arg)
{
        if( !this_object()->id(arg) ) return 0;
        if( this_player()->is_busy() )
                return notify_fail("你上一个动作还没有完成。\n");
        if( (int)this_player()->query("food") >=
            (int)this_player()->max_food_capacity() )
                return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");

        this_player()->add("food", this_player()->max_food_capacity());
        if( this_player()->is_fighting() ) this_player()->start_busy(2);
        message_vision("$N拿起" + name() + "一口气喝完\n", this_player());
        tell_object(this_player(), "你觉得浑身充满了活力!\n"); 
        this_player()->add("combat_exp", random(20) );
        destruct(this_object());
        return 1;
}

