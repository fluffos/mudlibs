// token1.c

#include <ansi.h>
inherit ITEM;
inherit F_AUTOLOAD;

void create()
{
        set_name(HIC "如意令" NOR,({ "yupei" }) );
        
        set("long",
                "乃是蓝田古玉琢磨而成，上镌“洛神图”\n");
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else 
                
                set("unit", "块");
                set("value",5000);
        setup();
}

void init()
{
add_action("do_look","look");
}

int do_look(string arg)
{
  string name;
 name=(string)this_object()->query("owner");

if (arg == "yupei" )
{
write(HIC "乃是蓝田古玉琢磨而成，上镌“洛神图\n" NOR);
write(HIC"玉佩后面凸刻" NOR+name+HIC "几个古篆\n" NOR);

return 1;
}
return 0;
}

int query_autoload() { return 1; }

