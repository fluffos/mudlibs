// token1.c
#include <armor.h>
#include <ansi.h>

//inherit F_AUTOLOAD;
inherit NECK;

void create()
{
        set_name(HIC "如意令" NOR,({ "yupei" }) );
        
        set("long",
                "乃是蓝田古玉琢磨而成，上镌“洛神图”\n");
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else 
                         set("no_drop",1);
                            set("no_give",1);
                set("armor_prop/personality", 5);
                 set("armor_prop/armor", 2);
                 set("unit", "块");
                set("owner","逍遥弟子");
                set("value",1);
        setup();
}

void init()
{
  add_action("do_look","look");
}

int do_look(string arg)
{
  string name;
  name=this_object()->query("owner");
  if(arg=="yupei"){
  tell_object(this_player(),HIC "乃是蓝田古玉琢磨而成，上镌“洛神图\n" NOR);
  tell_object(this_player(),HIC "背面凸刻:逍遥派:\n" NOR+name+HIC "佩\n" NOR);
  return 1;
  }
  return 0;
}
