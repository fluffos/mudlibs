// kid.c
#include <ansi.h>

inherit F_VENDOR;
inherit NPC;
void create()
{
        set_name("布随意", ({"freedom"}) );
        
        set("gender", "女性" );
        set("age", 16);
        set("str", 10);
        set("cor", 10);
        set("cps", 11);
        set("per", 30);
        set("int", 21);

       

        set("long", "可爱,但势力\n");

        set("combat_exp", 800);
         set("chat_chance_combat",15);
       set("chat_msg_combat",({
       "\n"
       }));
        set("chat_chance", 5);
        set("chat_msg", ({
        "随意高声吆喝到：谁要谁要刚出版的最新逍遥旅游图。一两银子一张了啊!”\n"
        "随意低声嘟囔:现在这年头，有人给钱就有人办事.\n",
        }) );

        set_skill("unarmed", 10);
        set_skill("parry", 10);
        set_skill("dodge", 10);
        set_skill("sword", 10);
        set_skill("force", 10);
        set_skill("literate", 10);
        set("vendor_goods", ([
         "/u/lark/xiaoyao/obj/map": 40,
   ]) );

        setup();
        carry_object("/obj/cloth")->wear();
}


void init()
{
        
         add_action("do_vendor_list", "list");

       
}
