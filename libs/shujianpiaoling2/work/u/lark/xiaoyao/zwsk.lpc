//dingx.c

#include <ansi.h>

inherit ROOM;

void create()
{
  set("short",MAG "缥缈山口" NOR);
  set("long",@LONG
紫薇平原，三面围绕在缥缈山脉的怀抱，正如其名,平坦的大地上
开满了紫色的丁香花，曼妙的香在空气中萦绕，娓娓的花瓣在风
中飘洒，好象少女的衣裙轻轻飞舞，好象她无暇的笑容璀璨着我
的心，远处的山峦也渐渐若隐若现的朦胧了。
LONG
);
  set("exits",([
   "west": __DIR__"roadd",
   "north": __DIR__"dingx2",
   "east":__DIR__"dingx2",
   "south":__DIR__"dingx2",
   "northeast":__DIR__"dingx2",
   "southeast":__DIR__"dingx2",
 ]));
   set("objects",([
     __DIR__"npc/boy":1,
     __DIR__"npc/girl":1,
     __DIR__"obj/dingx":1,
   ]));
   setup();
 
}

void init()
{
  object ob;
  if(!present("dingx",this_object())){
       ob=new(__DIR__"npc/dingx");
       ob->move(this_object());
     }
  if(!present("boy",this_object())){
       ob=new(__DIR__"npc/boy");
       ob->move(this_object());
    }
   if(!present("girl",this_object())){
       ob=new(__DIR__"npc/girl");
       ob->move(this_object());
    }

}
