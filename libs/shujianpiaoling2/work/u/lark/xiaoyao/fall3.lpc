//fall3.c

inherit ROOM;

void create()
{
 set("short","瀑布");
 set("long",@LONG
一条银练从山顶挂下，隆隆的轰鸣声震天动地，显示着自然的强
大力量水花飞溅在阳光下现出了七彩。这震撼天地的造化是否是
上帝造就的，不管怎么说它存在着，还将存在下去。
LONG
);
 set("exits",([
  "westdown":__DIR__"fall2",
  "southdown":__DIR__"fall4",

]));
set("outdoors","changan");
setup();
}

void init()
{
 add_action("do_into","into");
}

int do_into(string arg)
{
  if(!arg)
     return notify_fail("要干什么？\n");
  if(arg!="瀑布")
    return notify_fail("哪里进不去的\n");
  this_player()->move(__DIR__"waterfall");
  return 1;
}
