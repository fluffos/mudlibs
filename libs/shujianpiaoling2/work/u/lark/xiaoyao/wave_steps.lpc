//wave_steps.c凌波微步

inherit SKILL;

string *dodge_msg = ({
         "$n淡淡的一笑,脚踏「坤位」身形急转，渺然已逝.\n",
         "$n轻啸一声，足尖点地，身形飘然而起落向「中孚」.\n",
         "$N眼前一花，$n的身影乍分乍合，迈向「泰位」已然失却踪影.\n",
         "$n面对来招面不改色，突然间一收腹，往后飘落了一寸急踏「蛊位」避过了这招.\n",
         "$n潇洒的一笑，不退反进，趁你你个破绽，踏上「既济」蹂身而上，$N急忙收招自保.\n",
         "$n一声长啸，宛若流云瞬间踏到「明夷」，你的杀招一下子失却了目标。\n",
         "$n背负双手，潇洒来去，刀光剑影均视若不见堪堪踏上「家人」，$N百思不得其解身形顿搓。\n",
         "$n身体不可思议的弯转了过去，倒踏「无妄」避过了这一招.\n",
         "$n无法格挡，脑袋微侧，足下自然而然的斜踏「井位」,竟然避过了$N的攻击.\n",
         "$n膝盖微曲，左足斜斜缓踏「讼位」,堪堪避过$N的进攻.\n",
});

int valid_enable(string usage)
{
	return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
    if( (int)me->query("max_force") < 200 )
        return notify_fail("你的内力修为太浅，没有办法练凌波微步。\n");
    if( (int)me->query("spi") < 20 )
        return notify_fail("你的灵性不够，没有办法练凌波微步。\n");

        return 1;
}


string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    int lb,dg;
    lb=(int)me->query_skill("wave_step",1);
    if( (int)me->query("kee") < 30 )
        return notify_fail("你的气太少了，不能练凌波微步。\n");
    me->receive_damage("kee", 30);
        dg = me->query_skill("dodge",1)- me->query_skill("wave_step",1);
        if(me->query_learn("wave_step") > (lb+1)*(lb+1)+10 && dg<=0 ) return 0;
    me->add("force",lb/2);
    if( (int)me->query("force") > (int)me->query("max_force") * 2) {
        if( (int)me->query("max_force") <
                        ((int)me->query_skill("force", 1) + me->query_skill("force")/5) * 10 ) {
            write("你的内力提高了。\n");
                        me->add("max_force", 1);
                }
                me->set("force", me->query("max_force"));
        }       

        return 1;
}

string perform_action_file(string action)
{
	 return CLASS_D("xiaoyao") + "/wave_steps/" + action;
}
int effective_level() { return 20;}

int learn_bonus()
{
	return -10;
}
int practice_bonus()
{
	return -10;
}
int black_white_ness()
{
	return 20;
}
