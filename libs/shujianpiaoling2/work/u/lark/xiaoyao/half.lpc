// Room: /d/oldpine/cliff1.c

inherit ROOM;

void create()
{
        set("short", "山壁上的平台");
        set("long", @LONG
你现在正栖身在一个山壁上突出的平台上，从这里无论是要往上爬
或往下爬都有一段不算短的距离，可是你已经精疲力竭再也爬不动
呀。在旁边的石座上有个人坐在那里呆呆的不知是不是活物。　
LONG
        );
 set("objects",([
   __DIR__"npc/qichi":1,
]));

        setup();
}

void init()
{
        add_action("do_climb", "climb");
}

int do_climb(string arg)
{
    string dodskill;
    int n;
       dodskill = (string) this_player()->query_skill_mapped("dodge");
       n=(int)this_player()->query_skill(dodskill,1);

        if( !arg || (arg!= "up" && arg!="down") )
                return notify_fail("你要往上(up)爬还是往下爬(down)？\n");

        if( arg=="up" ) {

if(this_player()->query_skill("dodge",1)+n<200){
message_vision("$N还想继续向上爬但是看来已经没有心有余力不足了。\n",
                        this_player() );
  return 0;
}
if(!present("qi chizi",this_object())) return 1;
 
if(!this_player()->query("winqi"))  
    return notify_fail("棋痴子摇了摇头道:你自信在棋道上能胜过我么？除非你能战胜我.你才有资格上去.\n");

  message_vision("$N身手敏捷，沿着山壁攀沿而上，不一会就不见了\n",this_player());  
  tell_object(this_player(),"你手脚并用，身形迅捷的爬上了山顶\n");
  this_player()->move(__DIR__"top");
        } else if( arg=="down" ) {
                message_vision("$N试了试脚边的岩石稳不稳，开始小心翼翼地往山涧中攀了下去。\n",
                        this_player() );
                tell_room(__DIR__"sf","有个人从山崖上面爬了下来\n");
                remove_call_out("improve");
                call_out("improve",1,this_player());
                this_player()->move(__DIR__"sf");
        }
        return 1;
}

void improve(object who)
{
 object ob;
 string dodskill;
 int n;
 dodskill = (string) this_player()->query_skill_mapped("dodge");
  if(who->query_skill("dodge",1)>100){
 write("你擦了擦额头的汗水，抬头看了看，心里不觉暗喜：“这么高的山崖我竟然这么容易就爬上去了”\n");
 return;
 }
 who->improve_skill("dodge",random((int)who->query("int")) );
// who->improve_skill(dodskill,random((int)who->query("int")));
 who->add("sen",-(30-(int)who->query_skill("dodge",1)/5));
 who->add("gin",-(30-(int)who->query_skill("dodge",1)/5));
 return ;
}       
