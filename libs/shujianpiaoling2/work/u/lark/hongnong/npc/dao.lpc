// wuseng.c 少林寺--武僧
#include <ansi.h>
inherit NPC;


void create()
{

        set_name(HIW "白衣贼人" NOR, ({ "zei" }) );
        set("long", "这是羊鸣塞的贼人,一脸凶相\n");
        set("gender", "男性");
        set("attitude", "heroism");
         set("title",HIW "羊鸣塞" NOR);
        set("age", 30);
        set("str",15);/* = 膂力*/
        set("cor",15);/* = 胆识*/
        set("int",15);/* = 悟性*/
        set("spi",15);/* = 灵性*/
        set("cps",30);/* = 定力*/
        set("per",25);/* = 容貌*/
        set("con",60);/* = 根骨*/
        set("kar",30);/* = 福缘*/
         set("chat_chance", 3);
        set("chat_msg", ({
         "最近手头可真够紧的,点子都闪了让大爷们喝西北风去呀?",
        }) );
                set("chat_msg_combat", ({
       "哼,想跑?留钱没命!",
        }) );
        set("food", 600);
        set("water", 600);
        set("max_kee", 2000);
        set("eff_kee", 2000);
        set("kee", 2000); 
        set("max_force",2000);
        set("force",3500);

        set("force_factor", 50 );
        set_temp("apply/attack", 200);
        set_temp("apply/defense", 200);
        set("combat_exp", 1000000);
        set_skill("blade",100);
        set_skill("force", 200);
        set_skill("unarmed", 300);
        set_skill("dodge", 300);
        set_skill("parry", 300);
        setup();
         carry_object("/obj/cloth")->wear();
        carry_object("/obj/blade")->wield();
}

void unconcious()
{
        object killer;
        if( objectp(killer = query_temp("last_damage_from")) ){
                set_temp("fainter", killer->query("id"));
        }
        ::unconcious();
}

void revive()
{
        delete_temp("fainter");
        ::revive();
}

void die()
{
        string id;
        if( objectp(killer = query_temp("last_damage_from")) ){ 
                if(!( id = query_temp("fainter"))
                || killer->query("id") == id )
                        if( killer->query("combat_exp")
                           < query("combat_exp") )
                           killer->add("combat_exp", 60);
        }
        ::die();
}

void killed_enemy(object who)
{
        command("say 哈哈哈哈哈哈...");
        command("get all from corpse");
        destruct();
}

int accept_object(object who, object ob)
{
  int som;
  if(som=ob->value()<100){
  message_vision("贼人冷笑道:你以为大爷是要饭的?找死!!!\n",this_player());
  
  
  
            set("food", 600);
            set("water", 600);
            set("max_kee", 20000);
            set("eff_kee", 20000);
            set("kee", 20000); 
            set("max_force",2000);
            set("force",2000);
            set("str",5);/* = 膂力*/

        set_temp("apply/attack", 30);
        set_temp("apply/defense", 50);
        set("force_factor", 5 );
        
        set("combat_exp", who->query("combat_exp")+300);
        set_skill("parry",who->query("parry",1)-10);
        set_skill("dodge",who->query("dodge",1)-10);
      
        set_skill("unarmed",who->query("unarmed",1)-20);
        
        set_leader(this_player());
        kill_ob(this_player());
        return 0;
    }else{
  message_vision("贼人对$N笑了笑:谢谢这位大爷,请好走,说完钻进树林去了\n",this_player());
  this_player()->delete("noway");
   destruct();
  return 1;
 }
  
}



