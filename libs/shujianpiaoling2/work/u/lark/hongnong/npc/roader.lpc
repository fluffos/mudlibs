// gaolao.c

inherit NPC;
void dochou();
void create() {
  set_name("路人", ({ "roader" }));
  set("long", "行色匆匆的赶路人.\n");
  set("age", 30);
  set("str", 10);

  set("chat_chance", 2);
  set("combat_exp", 3000);
  set_skill("unarmed", 10);
  set_skill("parry", 10);
  set_skill("dodge", 10);
  set("chat_msg", ({
    "路人低声说：“最近羊鸣塞的贼人可是越来越嚣张了.”\n",
    "路人点了点头，：“是呀是呀，弘农的富裕人家都搬走了.只有那个田大财主还不肯离开.\n",
    "路人压低声音说：“听说前几天他家的大小姐让贼人给夺去了,官兵去了三次都没有抢回来...”\n",
    "路人幸灾乐祸的说：“恐怕现在也当了压寨夫人了吧....heihei”\n",
  }));
  set("inquiry", ([
    "羊鸣塞": "路人噤若寒蝉的点头道:那些贼人可不好惹,不说也罢.\n"
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
}
