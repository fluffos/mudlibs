//changan city

inherit ROOM;

void create() {
  set("short", "黑松林");
  set("long", @LONG
黑松林的枝叶森罗密布遮盖了天日,三步之内即不见五指,
松涛的声响宛若波浪汹涌,阵阵寒气从四周的林逢间透射
出来,那里似乎有什么东西注视着你.
LONG);


  set("exits",
    ([  //sizeof() == 4
    "north": __DIR__ "luan3",
      "southwest": __DIR__ "luan1",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "obj/haigu": 1,

    ]));


  set("outdoors", "hongnong");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
