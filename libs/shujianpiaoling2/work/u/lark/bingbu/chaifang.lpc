//ROOM:/u/changan/bingbu/chaifang.c

inherit ROOM;

void create()
{
set("short","柴房");
set("long",@LONG
这里没什么可瞧的,只是堆放了一些草料(caoliao),几乎占满了
整个房间.
LONG
);
set("exits",([
"out":__DIR__"majiu",
]));
set("item_desc",([
"caoliao":"都是最上等的草料,特地每年从关外送来的,堆了满满
当当的一个房间,好象很松软的样子.\n",
]));
setup();

}

void init()
{
add_action("do_zuan",({"zuan"}));
}

int do_zuan(string arg)
{
   object ob;
   if(!arg)
       return notify_fail("你要钻什么?\n");
   if(arg !="草料"||arg !="caoliao")
       return notify_fail("你是老鼠呀怎么什么都钻?\n");
   message_vision("$N往草料堆里一头扎了进去不见了.\n",this_player());
   this_player()->move(__DIR__"caoliao");
   
   if(ob=find_object(__DIR__"caoliao")) {
   tell_object("ob","有个什么东西从外面钻了进来.\n");
   }
  return 1;

}
