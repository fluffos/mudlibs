//ROOM:/u/changan/bingbu/caoliao.c

inherit ROOM;

void create()
{
set("short","草料堆中");
set("long",@LONG
这里是草料堆的中央,夹杂在其中,一点也不觉得压抑和挤迫,好象
这里是一个早就被开辟出来的,四周有很大一块空间.
LONG
);
setup();
}

void init()
{
 add_action("do_zuan",({"zuan"}));
}

int do_zuan(string arg)
{
  object ob;
  if(!arg) 
      return notify_fail("你要钻什么?\n");
   if(arg !="草料" || arg !="caoliao")
      return notify_fail("你是老鼠呀怎么什么都钻?\n");
   message_vision("$N往草料堆里一头扎了进去不见了.\n",this_player());
   this_player()->move(__DIR__"chaifang");
   
   if(ob=find_object(__DIR__"chaifang")){
   tell_object("ob","有个什么东西从草料堆里冒了出来.\n");
   }
   return 1;
}
