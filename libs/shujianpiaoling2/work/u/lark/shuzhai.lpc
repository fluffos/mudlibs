#include <room.h>
inherit ROOM;
string lookdesk(object me);
string lookshelf(object me);
void create()
{
set("short","书斋内");
set("long",@LONG
当年路大人和先帝纵横天下,靠的不仅是他卓越的军事的
才能,更是靠着他高明的智谋,才能无往不胜,帮助先帝打出了
江山一片,这里就是尚书没夜秉灯夜读的所在.四周高大的书架
排满了各种书籍,书桌上还有几篇没有完成的文章.
东面墙上挂着一幅路大人手绘的《秋风浴血图》.
LONG
);
set("item_desc",([
"desk":(: lookdesk :),
"书桌":(: lookdesk :),
"shelf":(: lookshelf :),
"书架":(: lookshelf :),
]));
set("exits",([
"out":__DIR__"wdd.lpc",
]));
setup();

}

void init()
{
string id="raya";
  object lark;
 add_action("do_get","get");
 add_action("do_learn","study");
add_action("do_getdown","getdown");
  if(this_player()->query("id")==id) 
message_vision("$N听到一个声音在耳边响起：亲爱的，桌上是写给你的文章。\n",this_player());
//        if(!(lark=present("lu",this_object()))) {
//          lark=new(__DIR__"npc/lu");
//          lark->move(this_object());
//          message_vision("$N捧起$n的脸温柔的吻了一下.\n",lark,this_player());
//          lark->set_leader(this_player());
//          lark->set("title","深爱着舞语的");}
}

string lookdesk(object me)
{
if(query("nopaper")) return "一张上好的红木书桌\n";
else return
"一张上好的红木书桌(desk)\n"
"上面放着\n"
"   一篇文章(paper)\n";
}

string lookshelf(object me)
{
  if(query("nobook")) return("一副高大的红木书架(shelf)\n");
  else return
"一个高大的红木书架(shelf)上面排满了各种书籍(book)\n";
}

int do_get(string arg)
{
  int n=2;
  object ob;
  string from;
if(!arg) return notify_fail("拿什么呀\n");
if( sscanf(arg, "%s from %s", arg, from)==2 
&& arg=="paper"
  && from=="desk"
 && !query("nopaper")){
  message_vision("$N从书桌上拿起了一张写满文字的纸片。\n",this_player());
  set("nopaper",1);
  __DIR__"obj/paper"->move(this_player());
  return 1;
  }
}

int do_getdown(string arg)
{
int x;
string from;
object book1;
object book2;
object book3,book4;
book1 =  new(__DIR__"obj/booka");
book2 =  new(__DIR__"obj/bookb");
book3 =  new(__DIR__"obj/bookc");
book4 =  new(__DIR__"obj/bookd");
x = random(4);
if(!arg) return notify_fail("拿什么呀?\n");
if( sscanf(arg, "%s from %s", arg, from)==2 
&& arg=="book"
 && from=="shelf"
 && !query("nobook")){
message_vision("$N从书架上拿下一本书.\n",this_player()); 
switch(x) {
case 0: book1->move(this_player());break;
case 1: book2->move(this_player());break;
case 2: book3->move(this_player());break;
case 3: book4->move(this_player());break;
}
return 1;
}
}
int valid_leave(object who, string exit)
{
if(present("book",who))
return notify_fail("你不能把书带出书斋\n");
return 1;
}
int do_learn(string arg)
{
object me;
int my_skill;
me = this_player();
if ( !arg || ( arg != "drawing" ) ) return 0;
if ( (int)me->query_skill("strategy",1) < 100 )
        {
write("你感到阵阵萧索的寒意渗透身躯,急忙把视线移开了。\n");
        return 1;
        };
    if ( (int)me->query("max_force") < 100 )
        {
        write("你渐渐把持不住自己的精神,迷失了......\n");
        me->unconcious();
        return 1;
        } 
    
    my_skill = my_skill = me->query_skill("strategy", 1)/2;

if( my_skill * my_skill * my_skill > 
                    (int)me->query("combat_exp")+(int)me->query("life_exp")/2 ) {
    write("也许是缺乏实战经验，你对画中的深意无法理解。\n");
    return 1; }

me->add("sen", (-1)*random(60));

message_vision("$N默默的注视着字画,脸上神情渐渐深远.....。\n", me);
    if ( (int)me->query_skill("bu", 1) < 130)
    {
    me->improve_skill("strategy", random(me->query("int")) );
    write("你深刻感受到画上的深意,对兵法战策有所体会.。\n");
}
    else
    write("画的不错不过比较肤浅.。\n");
    return 1;
}




