// baotang.c
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("1kpot", ({ "dan" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "prize\n");
    set("value", 1000);
    set("unit", "罐");
  }
  setup();
}

void init() {
  add_action("do_eat", ({ "eat", "chi" }));
}

int do_eat(string arg) {
  if (!this_object()->id(arg)) return 0;
  if (this_player()->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!this_player()->query_temp("wiz_prize")) return 0;
  if ((int)this_player()->query("food") >=
    (int)this_player()->max_food_capacity())
    return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");

  this_player()->set("food", this_player()->max_food_capacity());
  this_player()->set("water", this_player()->max_water_capacity());
  if (this_player()->is_fighting()) this_player()->start_busy(2);
  //        message_vision("$N拿起" + name() + "一口气喝完\n", this_player());
  this_player()->add("sen", (this_player()->query("max_sen") - this_player()->query("sen")));
  this_player()->add("sen", (this_player()->query("max_gin") - this_player()->query("gin")));
  this_player()->add("potential", 1000);
  destruct(this_object());
  return 1;
}
