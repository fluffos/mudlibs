// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("包子", ({ "baozi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘香喷喷的包子\n");
    set("unit", "个");
    set("value", 15);
    set("food_remaining", 30);
    set("food_supply", 80);
  }
}
