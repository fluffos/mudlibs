// yupei.c 玉佩

#include <armor.h>
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIC "兵部令牌" NOR, ({ "ling pai", "pai" }));
        set("long", "\n这是一块淡兰色的玉牌，莹滑温润，光洁无瑕，上面篆刻《兵部令牌》n"+
         "是兵部官吏的随身信物\n");
        set("weight", 300);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("value", 50000);
                set("material", "玉");
                set("armor_prop/armor", 2);
                set("female_only", 1);
        }
        setup();
}       

