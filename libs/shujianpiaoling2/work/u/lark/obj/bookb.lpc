// unarmed_b.c
#include <skill.h>
inherit ITEM;

void create()
{
        set_name("孙子兵法", ({ "book" }));
        set_weight(600);
        
                set("unit", "本");
                set("long",
                "这是一本线装的《孙子兵法》，记载了孙武的战略思想。比较深刻。\n");
                set("material", "paper");
                set("skill", ([
                        "name":                 "strategy",
                        "exp_required": 10000,
                        "sen_cost":             30,             
                        "difficulty":   30,             
                                
                        "max_skill":    70,             
                ]) );
}
