#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string  summon_more( object who);

void create()
{
          set_name("路远", ({ "lu yuan", "lu","master lu","master" }) );
        set("long",
                "路远是当朝兵部尚书，也是开国元勋之一。\n");
        set("nickname", YEL"决胜千里"NOR);
        set("attitude", "heroism");
        set("student_title","官员");
        create_family("朝廷",6,"官员");
        set("title", "兵部尚书");
        set("id_type", 4);                      //此处设置NPC身份为武将
        set("vendetta_mark", "authority");//设置自动追杀反官府的敌人
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
        set("agi", 30);
        set("max_kee", 1000);
        set("max_gin", 1000);
        set("max_sen", 1000);
        set("kee", 1000);
        set("gin", 1000);
        set("sen", 1000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 30);
        set("score", 900000);
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/move", 50);

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
             (: perform_action, "spear.huima" :),       //杨家枪的绝招“回马枪”
                (: summon_more(this_object()) :),
                (: command, "escort" :),                        //上两行呼叫亲兵保护
        }) );
        set("combat_exp", 4000000);
        set("relation_exp", 90000);     //设置人际关系
        set("life_exp", 50000);         //设置江湖阅历

        set_skill("unarmed", 230);
        set_skill("spear",250);
        set_skill("force",180);
        set_skill("parry", 120);
        set_skill("dodge", 110);
        set_skill("xingyi-ken",200);    //形意拳
        set_skill("yang_spear",220);    //杨家枪法
        set_skill("bixueforce",150);    //碧血心法
        set_skill("move", 100);
        set_skill("literate",190);
        set_skill("officialism",150);   //为官之道
        set_skill("strategy",150);              //兵法战策
        map_skill("unarmed","xingyi-ken");
        map_skill("force","bixueforce");
        map_skill("spear","yang_spear");
        setup();
        

     carry_object(__DIR__"obj/larksword")->wield();
       carry_object(__DIR__"obj/guanfu")->wear();
}

void attempt_apprentice(object me)
{
if(!me->query_temp("permit")){
tell_object(me,"路远笑了笑：“我实在太忙了。你还是去找荆将军吧。”\n");
return ;
}
        if( !me->query("class"))
        {
        command("smile");
        command("say 很好！朝廷正在用人之时，努力吧！\n");
        command("recruit " + me->query("id") );
return;
}
        if(me->query("id_type") == 3)
        {
        command("say 你已经是吏部的官员了！\n");
return;
}
        if(me->query("id_type") == 5)
        {
        command("say 你已经是刑部的官员了！\n");
return;
}
command("say 朝廷不需要你这种不三不四，来历不明之人！\n");
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "official");//设置玩家阶级为朝廷官员
                ob->set("vendetta_mark", "authority");
                ob->set("id_type", 4);          //设置玩家身份为武将
}
