void init()
{
        add_action("give_quest", "quest");
}
*/
void re_rank(object student)
{
        int exp;
         string name;
        exp = (int) student->query("relation_exp")*10+(int) student->query
("combat_exp");
        if( exp <= 1000 ) {
                student->set("title","军士");
                return ;
        } else if ( exp <= 5000 ) {
                student->set("title","旗牌官");
                return ;        
        } else if ( exp <= 10000 ) {
                student->set("title","校尉");
                return ;
        } else if ( exp <=15000  ) {
                student->set("title","都尉");
                return ;
         } else if ( exp <= 21001 ) {
                student->set("title","参将");
                return ; 
        } else if ( exp <= 31030 ) {
                student->set("title","裨将军");
                return ;
        } else if ( exp <= 53100 ) {
                student->set("title","偏将军");
                return ;
        } else if ( exp <= 102000 ) {
                string* lastname = ({ "安国","横江","虎贲"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"将军");
                return ;
        } else if ( exp <= 233300 ) {
                string* lastname = ({ "虎威","伏波","白马"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"将军");
                return ;
        } else if ( exp <= 510200 ) {
                string* lastname = ({ "威远","虎烈","折冲","鹰扬"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"将军");
                return ;
        } else if ( exp <= 1103000 ) {
                string* lastname = ({ "破虏","讨逆","昭文","荡寇"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"将军");
                return ;
        } else if ( exp <= 2010000 ) {
                string* lastname = ({ "强弓","扬武","扬威","羽林"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"将军");
                return ;
        } else if ( exp <= 3187000 ) {
                string* lastname = ({ "奋武","奋威","护国","定邦"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"将军");
                return ;
        } else if ( exp <= 4040040 ) {
                string* lastname = ({ "建威","建武","武卫","枫阑"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"将军");
                return ;
        } else if ( exp <= 5404000 ) {
                string* lastname = ({ "辅国","安远","镇远","征远","龙骧","虎步","征虏"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"中郎将");
                return ;
         } else if ( exp <= 7000000 ) {
                string* lastname = ({ "左","右","前","后"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"将军");
                return ;
        } else if ( exp <= 10000000 ) {
                string* lastname = ({ "征东","征西","征北","征南"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"都督");
                return ;
         } else if ( exp <= 15000000 ) {
                string* lastname = ({ "骠骑","车骑","紫薇","玄武"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"大将军");
                return ;
         } else if ( exp <= 20000000 ) {
                string* lastname = ({ "镇东","镇南","镇西","镇北","安东","安南","安西","安北"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"节度使");
                return ;
          }else{
         string* lastname = ({ "川西","海南","河西","江北","三山","荆襄","北海","应天","顺天"});
                name = lastname[random(sizeof(lastname))];     
                student->set("title",name+"王");
                return ;        
}
}
string summon_more(object who)
{
        object soldier;
        seteuid(getuid());
        soldier = new("/obj/npc/bodyguard");
        soldier->move(environment(who));
        command("escort");              //以上函数对应呼叫亲兵保护
        return "1";
}


