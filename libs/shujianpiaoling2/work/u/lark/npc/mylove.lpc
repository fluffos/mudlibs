// guotai.c

inherit NPC;
void greet(object ob);


void create()
{
        set_name("吴语", ({"wuyu"}));
        set("attitude", "friendly");
        set("gender", "女性");
        set("age", 19);
        set("long", 
                    " 我不知道怎么形容美，但我想看到她你会告诉我。\n");
        set("str", 30);
        set("per", 30);
        set("cps", 30);
        set("int", 20);

        set("max_kee", 300);
        set("kee", 300);
        set("food", 400);
        set("water", 400);
        set("chat_chance", 10);
        set("chat_msg", ({
"吴语轻声叹了口起，轻轻掠了掠额头散乱的头发，清晨淡红的微芒，衬托出她柔和的曲线\n",
"吴语低低轻吟：“。。却为君之故，沉吟夜凄清。。。”\n"
"吴语轻声道：“你总是说越来越忙。。。。。可你是否。。。”\n",
"吴语轻吟：“。。。。泪弹不尽临窗滴，就砚旋研磨。。。。此情深处，红签为无色。。”\n",
              
    }) );
        set("combat_exp", 2000000);
        set_skill("dodge", 300);
        set_skill("unarmed", 300);

        
        setup();
          carry_object(__DIR__"obj/ccloth")->wear();
          carry_object(__DIR__"obj/shoe")->wear();
}

void init()
{
    object ob;

    ::init();
    if( interactive(ob = this_player())
        && !is_fighting()){
        call_out("greet",1,ob);
  }
}

void greet(object ob)
{
    if( !ob || environment(ob) != environment())return;
    message_vision(
    "吴语呆呆的望着窗外出神, 听到脚步声进来, 喜道:你回来了？\n"
    "...这时才回过头来, 见是$N进来, 微微一呆, 急忙收口，脸上浮现出难以描绘失望。\n",
    ob);
    return;
}


