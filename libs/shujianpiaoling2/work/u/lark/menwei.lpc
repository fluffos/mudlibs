inherit ROOM;

void create()
{
set("short","门卫房");
set("long",@LONG
从偏门进来是兵部官卫房,大概有三丈见方,中间有张长案,
有个人正坐在案前忙碌的记载着什么,所有想要进府人等均要在这里接受
盘查,登记,想要混进去是不大可能的.
LONG
);
set("exits",([
"south":__DIR__"damen",
"east":__DIR__"yardn",
"west":__DIR__"street1",
]));
 set("objects", ([
__DIR__"npc/guarder":8,
__DIR__"npc/liu":1,
]));
set("outdoors","street1");
setup();
}
int valid_leave(object who, string exit)
{
        int exp;
        object huwei;
        string title;
        title=who->query("title");
        exp = (int) who->query("relation_exp")*10+(int) who->query
        ("combat_exp");
        if( exit != "east" && exit !="south") return 1;
       
        if(who->query("wuzy")) {
        tell_object(who,title+"恭喜恭喜请进请进！");
        return 1;
        }
        
        if( !present("huwei",this_object()) && !present("liu tongling",this_object())) return 1;
        
        if( who->query("class")=="official" )
           {
             if(exp>1200000)
              {
message_vision("刘雨微微一抱拳，对着$N恭声说道：“"+title+"大人请进。”\n",
                  who);
                 return 1;
              }else{
                 if((int)who->query("id_type")==4) return 1;
                 message_vision("刘雨微微摇了摇头，说道：“兵部乃军机重地，普通官员如无特许不得入内。”。\n",
                  who);
                  return 0;
               }       
            }
        
            
        return notify_fail("铁甲虎卫不耐烦的挥了挥手，这里是尚书府不要乱闯\n");
}





