inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("酒坛", ({ "jiu tan", "tan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个通体漆黑的泥制酒坛。\n");
    set("unit", "个");
    set("value", 0);
    set("max_liquid", 5);
  }


  set("liquid", ([
    "type": "jiu",
    "name": "老白干",
    "remaining": 15,
    "drunk_apply": 6,
  ]));
}
