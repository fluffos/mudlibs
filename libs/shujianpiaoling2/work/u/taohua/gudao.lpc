#include <ansi.h>

inherit ROOM;

void rtaohua( object ob ) ;

void create()
{
    set("short", "孤岛");
    set("long", @LONG
这是一座孤岛的海滩，四周是一望无际的大海。海滩边有一截
被剥去了皮的树根，上面似乎刻着些小字。
LONG
    );

    set("item_desc", ([
        "树根" : "今日困于孤岛，念及离尘之心，遂取名：日暮岛。\n",
    ]));
    set("outdoors", "taohua");
    setup();
}
