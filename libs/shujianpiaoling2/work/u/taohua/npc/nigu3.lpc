inherit NPC;
void create()
{
        set_name("老尼姑", ({ "nigu" }) );
        set("gender", "女性" );
        set("class", "taohua");
        set("age", 50);
        set("cor", 24);
        set("cps", 29);
        set("int", 25);
        set("long", "她是一个表情严肃的尼姑，看上去不沾半点人间烟火。\n");
        set("combat_exp", random(15000)+15000);
        set("attitude", "friendly");
        set("max_force", 1500);
        set("force", 1500);
        set("force_factor", 5);
	set_skill("unarmed", 100);
	set_skill("parry", 100);
	set_skill("dodge", 100);
        setup();
        carry_object(__DIR__"obj/monk_cloth")->wear();
        carry_object(__DIR__"obj/shoe2")->wear();
}
int accept_fight(object me)
{
        command("say 阿弥陀佛！贫身武功低微，施主不要开这种玩笑。\n");
        return 0;
}
