#include <ansi.h>

inherit NPC;

void create()
{
	set_name("罗莹君", ({ "luo yingjun", "luo", "yingjun" }));
	set("long", "这是一个妙龄少女，是“晶莹如雪”四大弟子之一。\n");
	set("gender", "女性");
	set("age", 20);
	set("attitude","peaceful");
	set("str", 30);
	set("per", 32);
	set("con", 17);
	set("int", 25);
	set("class", "taohua");
        create_family("桃花岛", 3, "弟子");
	set("combat_exp", 280000);
	set("max_kee", 500);
	set("max_sen", 500);
	set("force", 400);
	set("max_force", 400);
	set("force_factor", 10);
        set_skill("unarmed", 80);
        set_skill("parry", 60);
        set_skill("dodge", 80);
        set_skill("sword", 80);
        set_skill("force", 80);
        set_skill("literate", 100);
        set_skill("liheforce", 80);
        set_skill("beauty-force", 80);
        set_skill("luoying_sword", 80);
        set_skill("luohua_steps", 80);
        set_skill("tenderzhi", 80);
       
        map_skill("unarmed", "tenderzhi");
        map_skill("force","beauty-force");
        map_skill("sword", "luoying_sword");
        map_skill("parry", "luoying_sword");
        map_skill("dodge", "luohua_steps");

	setup();
	carry_object("/obj/cloth")->wear();
	carry_object("/obj/longsword")->wield();
}


