#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_shizu();
int about_taohua();

void create() {
  set_name("清尘庵主", ({ "master anzhu", "anzhu", "master" }));
  set("gender", "女性");
  set("age", 40);
  set("str", 67);
  set("cor", 30);
  set("per", 37);
  set("int", 24);
  set("title", "南门三奇之一");
  set("nickname", HIM "桃花岛主人" NOR);
  set("max_force", 2500);
  set("force", 2500);
  set("force_factor", 100);
  set("class", "taohua");
  create_family("桃花岛", 2, "掌门");
  set("long",
    "这是一个面情慈祥的中年女子，作尼姑打扮，却掩饰不住当年的风姿。\n");
  set("combat_exp", 2000000);
  set("score", 2000);
  set_skill("unarmed", 180);
  set_skill("parry", 160);
  set_skill("dodge", 180);
  set_skill("sword", 180);
  set_skill("force", 180);
  set_skill("literate", 200);
  set_skill("liheforce", 180);
  set_skill("zhengqijue", 180);
  set_skill("beauty-force", 180);
  set_skill("luoying_sword", 180);
  set_skill("luohua_steps", 180);
  set_skill("tenderzhi", 180);
  set_skill("jiguanshu", 180);
  set_skill("watersong", 200);

  map_skill("unarmed", "tenderzhi");
  map_skill("force", "beauty-force");
  map_skill("sword", "luoying_sword");
  map_skill("parry", "luoying_sword");
  map_skill("dodge", "luohua_steps");
  set("inquiry", ([
    "师祖": (: about_shizu :),
    "飘浮子": (: about_taohua :),
  ]));
  setup();
  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/monk_cloth")->wear();
}
int about_taohua() {
  object me = this_player();
  command("say 桃树犹催少年泪，花自飘零水自流。一纸旧书离别苦，不忍断剑泣红尘。\n");
  command("say 唉，师兄还是一个性情中人呀！\n");
  me->set_temp("taohua/permit_baishi", 1);
  return 1;
}

int about_shizu() {
  command("say 师祖就是武林三逸中的南山野叟，只是他老人家萍踪不定，现在也不知身在何方？\n");
  return 1;
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("combat_exp") < 1000
    || !ob->query_temp("taohua/permit_baishi")) {
    command("say 对不起，贫身已不收徒弟了!");
    return;
  }
  /*
        if( ob->query("gender") != "女性" ) 
	{
                command("say 对不起，贫身只收女徒弟。");
                return;
        }
*/
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) +
    "很好，你既然与桃花岛有缘，我就收下你吧。\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "taohua");
  ob->set("id_type", 1);
}
