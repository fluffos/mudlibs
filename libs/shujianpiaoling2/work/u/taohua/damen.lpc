#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", "清尘庵");
    set("long",@LONG
这里是清尘庵的正门。门前疏落有致地种了几株桃花树，更显得此地主人
对桃花的偏爱。门口站着两个小尼姑看守大门。由于地处边远，人烟罕至，所
以整个尼姑庵看上去清净浩渺，不沾凡俗之气。
LONG);

	set("exits", ([
        "south" : __DIR__"qianyuan",
        "north" : __DIR__"tingzi",
	"east"  : __DIR__"road1" ,       
	]));
        set("objects", ([
                __DIR__"npc/nigu1" : 2,
        ]));
    set("outdoors", "taohua");
    setup();
    
}
