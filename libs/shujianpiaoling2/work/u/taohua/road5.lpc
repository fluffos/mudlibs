inherit ROOM;
 
void create()
{
        set("short", "洞口");
        set("long",@LONG
这是山上的一个小山洞。洞口很小，仅能容一个人钻进去。洞里面
黑黝黝的什么也看不见。
LONG);
        set("exits", ([
  "west"   : __DIR__"road4",
  "enter"  : __DIR__"dong",
]));
        set("outdoors", "taohua");
  set("item_desc",([
      "hole" : "这是一个小洞，你可以试着往洞(hole)里掏(tao)一下。\n" ,
      "洞口" : "这是一个小洞，你可以试着往洞(hole)里掏(tao)一下。\n" ,
      "山洞" : "这是一个小洞，你可以试着往洞(hole)里掏(tao)一下。\n" ,
      "小山洞" : "这是一个小洞，你可以试着往洞(hole)里掏(tao)一下。\n" ,
     ]));

        setup();
}
void init()
{
	add_action("do_tao", "tao");
}
int do_tao(string arg)
{
	object me=this_player(), mouse;
	if(!arg || arg!="hole")
          return notify_fail("你要在哪里掏东西？\n");
	if (present("skeleton", environment(me)))
	return notify_fail("你卷起袖子，将手伸进洞里掏了半天，结果手上沾满了黑灰。\n");
	if (present("corpse", environment(me)))
	return notify_fail("你卷起袖子，将手伸进洞里掏了半天，结果手上沾满了黑灰。\n");
	if (present("mouse", environment(me)))
	return notify_fail("你卷起袖子，将手伸进洞里掏了半天，结果手上沾满了黑灰。\n");
          mouse = new("/daemon/troop/taohua/mouse");
	message_vision("\n$N卷起袖子，将手伸进洞里掏来掏去，突然从洞里嗤地一声蹿出一只$n。\n\n",me,mouse);
          mouse->move(environment(me));
//          mouse->kill_ob(me);
        return 1;
}

