#include <ansi.h>

inherit ROOM;

void rtaohua( object ob ) ;

void create()
{
    set("short", "海滩");
    set("long", @LONG
这是濒临东海的海滩。往东是一望无际的大海；往西则通往中原。
蓝蓝的海蓝蓝的天，金黄色的沙滩，白色的海鸥，这一切都是那么美。
海边泊着一艘大船(chuan)。
LONG
    );

    set("item_desc", ([
        "chuan" : "这是一艘出海的商船。上船(enter)就可以去东海诸岛。\n",
    ]));
    set("exits",([
     "west" :__DIR__"guanroad3",
]));

    set("outdoors", "taohua");
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}
int do_enter ( string arg )
{
    object ob ;
    string dir;
    if( !arg || arg !="chuan" ) 
       {
         tell_object(this_player() , "你要 enter 哪儿？\n" ) ;
         return 1 ;
       }
    ob = this_player () ;
    message_vision("船夫一见有人上船，忙叫了一声：开船喽！\n", ob);
    message_vision("船夫升起帆，船就向西方航行。\n", ob);
    ob ->move("/u/taohua/dahai") ;
    tell_object(ob, HIB "你在海上航行了很久很久.......\n" NOR ) ;
    call_out("rtaohua", 60 , ob );
    return 1 ;
}
void rtaohua( object ob )
{
	if( !ob->query_temp("taohua/permit_going"))
	{
  tell_object(ob , "大船终于抵达了东海的一个小岛。你走下船来。\n" ) ;
  ob->move ("/u/taohua/gudao") ;
    return ;
	}
	else
  tell_object(ob , "大船终于抵达了东海的一个小岛。你走下船来。\n" ) ;
  ob->move ("/u/taohua/haitan") ;
}
