// Room: /u/yanzi/huashan/zawuf.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIC"杂物房"NOR);
	set("long", @LONG
一间放满了各种工具的杂物房，而且堆地乱七八糟，从铲子，锄
头到犁都有，仔细找找说不定还能发现其他什么好东西。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 1 */
  	"east" : __DIR__"huayuan",
]));
	set("obj_count",1);
	setup();
}
void init()
{
	add_action("do_search", "search");
}
int do_search(string arg)
{
	object ob,me;
	
	if( !arg || arg!="here" ) 
	{
        write("你要搜索哪里？\n");
        return 1;
  	}
	if (query("obj_count") < 1 )
		return notify_fail("你将杂物房整个搜了个遍，但没发现有什么有用的东西。\n");
	add("obj_count", -1);
	ob = new(__DIR__"obj/futou");
	ob->move(this_player());
	message_vision("$N在杂物房里到处搜索，发现了一把铁斧。\n",this_player());
	return 1;
}