// Room: /u/yanzi/huashan/songshu.c 
 
inherit ROOM; 
#include <ansi.h>;
 
void create() 
{ 
	set("short", HIC"迎客松"NOR);
	set("long", @LONG
也许天意要你不死，你刚好掉在一棵长在峭壁之上的松树上，山
风把松树吹得晃来晃去，你不得不紧紧抓住树干，以防掉下去，还是
赶紧爬(climb)上去吧。
LONG
	);
	set("no_clean_up", 0);

	setup();
}
void init()
{
	add_action("do_climb", "climb");
}
int do_climb(string arg)
{
	object ob;
	ob = this_player();
	message_vision("$N抓住崖壁，手脚并用，开始往上爬去。\n",ob);
	ob->move(__DIR__"shizi");
	message_vision("$N累地半死，终于爬上了狮子岭。\n",ob);
	return 1;
}