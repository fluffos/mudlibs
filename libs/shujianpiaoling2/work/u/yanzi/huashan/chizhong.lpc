// Room: /u/yanzi/huashan/chizhong.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIC "玉女池中" NOR);
  set("long", @LONG
你正在玉女池水之中，池水虽冷，但是却也十分舒服，九天玉女
沐浴的地方确实与众不同。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "ynchi",
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_dive", "dive");
}
int do_dive() {
  object me = this_player();
  if ((int)me->query("force") < 500)
    return notify_fail("你一个猛子扎下去，只觉一股刺骨的寒气袭遍全身，忍不住又游了上来。\n");
  message_vision("$N一个猛子往池底扎下去。\n", me);
  me->move(__DIR__ "chidi");
  message("vision", "$N从水面上潜了下来。\n", environment(me), me);
  return 1;
}
