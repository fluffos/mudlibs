// laodao.c

inherit NPC;

int ask_me();
int ask_check();
int count = 0;
int ct_ok = 0;

void create() {
  set_name("老道士", ({ "lao daoshi", "daoshi" }));
  set("gender", "男性");
  set("age", 91);

  set("long", "一个十分神秘的老道，一身白净的道袍，雪白的胡子，看上去仙风仙骨。\n");

  set("combat_exp", 500000);
  set("attitude", "friendly");

  set("inquiry", ([
    "借钱": (: ask_me :),
    "鉴定": (: ask_check :),
    "布施": "布施啊，我们只收现钱，不收物品，你只要直接把钱给我就行了。",
  ]));
  set("chat_chance", 15);
  set("chat_msg", ({
    "老道士伸了个懒腰，又打了个哈欠。\n",
    "老道士说道：各位行行好，布施点吧。\n",
  }));
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    "老道士慌忙摆手：不要打，有话好好说，好好说嘛。\n",
    "老道士大叫：杀人啦，太上老君救命啊！原始天尊救我啊！\n",
  }));

  set_skill("literate", 150);
  set_skill("taoism", 300);
  setup();

  carry_object("/obj/cloth")->wear();

  add_money("gold", 10);
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_quan", "quan");
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (present("pill", ob)) {
    command("say 你这颗丹丸不简单啊，要不要我替你鉴定一下？\n");
    command("say 一次只要五两金子。\n");
  }
}
int accept_fight(object me) {
  command("fear");
  return 1;
}
int accept_object(object who, object ob) {
  int i, kar, money;
  i = random(100);
  kar = who->query("kar");
  if (kar <= 10) money = 2500000;
  else if (kar <= 20) money = 5000000;
  else if (kar <= 30) money = 7500000;
  else money = 10000000;
  if ((int)who->query_temp("huashan/quest") == 8 && (int)who->query_temp("over") != 1
    && ob->value() >= 50000) {
    command("smile");
    command("say 好好，有借有还，以后有困难还可以来找我们群仙观。");
    who->set_temp("over", 1);
  } else if (ob->value() >= money) {
    command("smile");
    command("say 各位天尊会保佑这位" + RANK_D->query_respect(who) + "大吉大利，多福多寿的。\n");
    if ((i < 50 - kar / 2) && who->query("kar") <= 39) {
      tell_object(who, "你的运气似乎增加了！\n");
      who->add("kar", 1 + random(1));
    }
  } else
    write("老道一脸不高兴：就这点，多谢啦。\n");
  return 1;
}
int ask_me() {
  object me, money;
  int kar, i;
  me = this_player();
  money = present("gold_money", me);
  kar = (int)me->query("kar");
  i = random(100);

  if ((int)me->query_temp("huashan/quest") != 9)
    return 0;
  if (me->query_temp("over")) {
    tell_object(me, "你已经完成任务了。\n");
    return 1;
  }
  command("consider");
  if ((int)me->query_temp("time") + 600 < (int)me->query("mud_age")) {
    tell_object(me, "老道好像还在生你的气，这时问他借钱多半不肯的。\n");
    return 1;
  } else if (i < 60 + kar / 2) {
    command("say 看在我观在华山深受你们的照顾，就借给你们一些吧。");
    if (!money) {
      money = new("/obj/money/gold");
      money->move(me);
      money->set_amount(2);
    } else money->add_mount(2);
    me->set_temp("success", 2);
    message_vision("老道给$N一些黄金。\n", me);
    tell_object(me, "你数了数，一共是二两金子？就这点？不知道回去交差够不够。\n");
    me->set_temp("over", 1);
    me->set_temp("allow_quan", 1);
    return 1;
  } else {
    command("shake");
    command("say 我们也很困难，无法借给你。");
    me->set_temp("time", (int)me->query("mud_age"));
    return 1;
  }
}
int do_quan(string arg) {
  object me, money;
  int kar, i, lit, num, n;
  string msg;
  me = this_player();
  money = present("gold_money", me);
  i = random(100);
  n = random(4);
  kar = (int)me->query("kar");
  lit = (int)me->query_skill("literate", 1);

  if (!me->query_temp("allow_quan"))
    return 0;
  if (!arg || arg != query("id"))
    return notify_fail("你要劝谁？\n");

  count++;
  if (count >= 2 && lit < 80)
    return 0;
  else if (count >= 3 && lit < 120)
    return 0;
  else if (count >= 4 && lit < 150)
    return 0;
  switch (n) {
    case 0:
      msg = "$N对着老道劝说道：好歹我们也是邻居，给这点少了点吧。\n";
      break;
    case 1:
      msg = "$N对着老道劝说道：群仙观与华山派同处一派，有难应该同当，再多借些吧。\n";
      break;
    case 2:
      msg = "$N对着老道劝说道：再多给点吧，我们华山派像借钱不还的吗？\n";
      break;
    case 3:
      msg = "$N对着老道劝说道：这点钱是杯水车薪啊，再多给点吧，他日如有所求，华山上下赴汤蹈火，在所不辞。\n";
      break;
  }
  message_vision(msg, me);
  if (count < 2) {
    if (i < 60 + kar / 2) {
      message_vision("老道犹豫了半天，终于说道：好吧，就再加些。\n", me);
      num = lit / 50;
      if (num < 1) num = 1;
      money->add_amount(num);
      me->add_temp("success", num);
      message_vision("老道给了$N一些黄金。\n", me);
    } else {
      command("faint " + me->query("id"));
      command("heng");
      command("say 你们华山派可真心黑，我一分也不借了！");
      if ((int)money->query_amount() == 2)
        destruct(money);
      else
        money->add_amount(-2);
      me->set_temp("over", 0);
      me->set_temp("time", (int)me->query("mud_age"));
    }
    return 1;
  } else if (count == 2) {
    if (i < 50 + kar / 2) {
      message_vision("老道踱了踱去，想了半天，终于说道：好吧，再给些。\n", me);
      num = lit / 30;
      if (num < 1) num = 1;
      money->add_amount(num);
      me->add_temp("success", num);
      message_vision("老道又给了$N一些黄金。\n", me);
    } else {
      command("faint " + me->query("id"));
      command("heng");
      command("say 你们华山派可真心黑，我一分也不借了！");
      if ((int)money->query_amount() == (int)me->query_temp("success"))
        destruct(money);
      else
        money->add_amount(-(int)me->query_temp("success"));
      me->set_temp("over", 0);
      me->set_temp("time", (int)me->query("mud_age"));
    }
    return 1;
  } else if (count == 3) {
    if (i < 40 + kar / 2) {
      message_vision("老道皱紧了眉头，似乎内心十分矛盾。\n", me);
      message_vision("老道猛然把头抬起来，一字一句对$N说道：好吧，再给你些，不能再多了。\n", me);
      num = lit / 15;
      if (num < 1) num = 1;
      money->add_amount(num);
      me->add_temp("success", num);
      message_vision("老道又给了$N一些黄金。\n", me);
    } else {
      command("faint " + me->query("id"));
      command("heng");
      command("say 你们华山派可真心黑，我一分也不借了！");
      if ((int)money->query_amount() == (int)me->query_temp("success"))
        destruct(money);
      else
        money->add_amount(-(int)me->query_temp("success"));
      me->set_temp("over", 0);
      me->set_temp("time", (int)me->query("mud_age"));
    }
    return 1;
  } else if (ct_ok == 0) {
    if (i < 30 + kar / 2) {
      message_vision("老道背着手，紧锁双眉，在观中走来走去，内心似乎在做巨大的斗争。\n", me);
      message_vision("老道叹了口气，说道：罢了罢了，"
        +RANK_D->query_respect(me) + "真是能说会道，这些金子给你吧。\n", me);
      num = lit / 5;
      if (num < 1) num = 1;
      money->add_amount(num);
      me->add_temp("success", num);
      message_vision("老道又给了$N一些黄金。\n", me);
    } else {
      command("faint " + me->query("id"));
      command("heng");
      command("say 你们华山派可真心黑，我一分也不借了！");
      if ((int)money->query_amount() == (int)me->query_temp("success"))
        destruct(money);
      else
        money->add_amount(-(int)me->query_temp("success"));
      me->set_temp("over", 0);
      me->set_temp("time", (int)me->query("mud_age"));
    }
    ct_ok = 1;
    count = 0;
    return 1;
  }
}
int ask_check() {
  object me, pill, gold;
  int n;
  string force, exp, pot, long;
  me = this_player();
  pill = present("pill", me);
  gold = present("gold_money", me);

  if (!pill) {
    command("say 你身上没有东西要我鉴定。");
    return 1;
  }
  if (!gold) {
    command("say 你的身上没有金子啊，我只收金子。");
    return 1;
  }
  if ((int)gold->query_amount() < 5) {
    command("say 你身上金子的数目不够，我要五两金子。");
    return 1;
  }
  if (pill->query("effect")) {
    command("say 你的丹丸已经鉴定过了。");
    return 1;
  }
  if ((int)gold->query_amount() > 5)
    gold->add_amount(-5);
  else
    destruct(gold);
  message_vision("$N给了老道士五两金子，让他鉴定一下$N身上丹丸的功效。\n", me);
  say("老道士拿起丹丸，仔细地研究起来。\n");
  n = random(10000);
  if (n < 1000) {
    say("老道士在丹丸上做了些标记。\n");
    pill->set("effect", 1);
    pill->set("long", "一颗黑不溜秋的丹丸，似乎有提高内力之功效。\n");
    return 1;
  } else if (n < 2000) {
    pill->set("effect", 2);
    force = "-15";
  } else if (n < 3200) {
    pill->set("effect", 3);
    exp = "200";
    pot = "80";
  } else if (n < 4000) {
    pill->set("effect", 4);
    exp = "-150";
  } else if (n < 4001) {
    pill->set("effect", 5);
    exp = "30000";
    pot = "500";
  } else if (n < 7000) {
    pill->set("effect", 6);
    exp = "20";
    pot = "10";
  } else if (n < 7020) {
    pill->set("effect", 7);
    exp = "10000";
    pot = "200";
  } else if (n < 7030) {
    pill->set("effect", 8);
    exp = "-10000";
  } else if (n < 7040) {
    pill->set("effect", 9);
    exp = "5000";
    pot = "100";
  } else if (n < 7045) {
    pill->set("effect", 10);
    exp = "-50000";
  } else if (n < 9000) {
    pill->set("effect", 11);
    exp = "-20";
  } else {
    say("老道士在丹丸上做了些标记。\n");
    pill->set("effect", 12);
    pill->set("long", "一颗黑不溜秋的丹丸，似乎没有什么大的用处。\n");
    return 1;
  }
  long = "一颗黑不溜秋的丹丸，它的功效有：\n";
  long = long + "最大内力：" + force + "\n" +
    "经验：" + exp + "\n" +
    "潜能：" + pot + "\n";
  say("老道士在丹丸上做了些标记。\n");
  pill->set("long", long);
  return 1;
}
