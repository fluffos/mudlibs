// huajiang.c

inherit NPC;

int ask_me();
void create()
{
	set_name("老花匠", ({ "huajiang", }) );
	set("gender", "男性");
	set("age",71);
	set("long",@LONG
一个七十多岁的老花匠，常年在太阳下照料花草，整个人都晒得十分
黝黑，他原是洛阳一带有名的花匠，后应令狐冲之请来此照料花草。
LONG
	);
	set("combat_exp", 100000);
	set("score", 100);
	set("max_force", 500);
	set("force",900);
//	set("daode", 9900);

	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_skill("honey", 180);
	set_skill("force", 50);
	set_skill("unarmed", 100);
	set_skill("literate", 10);

	set("inquiry", ([
                "斧头" : (: ask_me :),
	]));
	
	setup();
	carry_object("/obj/cloth")->wear();
}
int ask_me()
{
	command("say 斧头啊，你去工具房看看吧，也许那里有。");
	this_player()->set_temp("marks/futou", 1);
	return 1;
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if( ob->query_temp("garden"))
		command("say 你是来帮忙的吧，赶快干活(work)吧！\n");
}