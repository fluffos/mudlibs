// fang.c
inherit NPC;
#include <ansi.h>;

void create()
{
	set_name("方敬渊", ({ "fang jingyuan","fang" }) );
	set("gender", "男性");
	set("age",26);
	set("title", "华山派三师哥");
	set("nickname", WHT"华山三英"NOR);
	set("long",@LONG
方敬渊是莫天雄三弟子，是华山一派中数一数二的好手，与闪电客、
段成海一起人称“华山三英”，现正管理藏书房。
LONG
	);
	set("attitude", "peaceful");
	set("int", 22);
	set("cor", 22);
	set("agi", 22);
	set("con", 20);
	set("str", 20);
	set("tol", 20);
	set("spi", 18);
	set("dur", 20);
	set("per", 28);
	set("fle", 15);
	set("cps", 20);
	set("max_force", 2200);
	set("force", 3700);
	set("force_factor", 90);
	set("combat_exp", 800000);
	set("score", 40000);
//	set("daode", 49000);

	set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
	(: perform_action, "sword.taiyue" :),
        }) );
	set_skill("dodge", 140);
	set_skill("parry", 150);
	set_skill("sword", 150);
	set_skill("force", 130);
	set_skill("unarmed", 110);
	set_skill("literate", 80);
        set_skill("hs-zhengqi", 100);
	set_skill("huashan-force", 140);
	set_skill("zixia-shengong", 100);
	set_skill("huashan-sword", 150);
	set_skill("huashan-strike", 140);
	set_skill("tianluo-steps", 140);

	set("perform/huashan/taiyue",1000);  //perform lv=1

	map_skill("sword", "huashan-sword");
	map_skill("parry", "huashan-sword");
	map_skill("force", "zixia-shengong");
	map_skill("unarmed", "huashan-strike");
	map_skill("dodge", "tianluo-steps");

	create_family("华山派", 16, "弟子");

	setup();
	carry_object(__DIR__"obj/longsword")->wield();
	carry_object("/obj/cloth")->wear();
}

void init()
{
	add_action("do_killing", "kill");
}
int do_killing(string arg)
{
	object player,victim;
	player = this_player();
	if(!arg)
	return 0;
	if( objectp(victim = present(arg, environment(this_object()))))
	{
		if (victim->query("family/family_name")== "华山派") 
		{
		message_vision("$N大怒，大胆狂徒，竟敢在华山动手，未免太小看我们华山派吧！受死吧！\n",this_object());
		this_object()->kill_ob(player);
		player->kill_ob(this_object());
		return 0;
		}
		else return 0;
	}
	else return 0;
}
void killed_enemy(object ob)
{
	command("say 哈哈, 不自量力的家伙！");
}
