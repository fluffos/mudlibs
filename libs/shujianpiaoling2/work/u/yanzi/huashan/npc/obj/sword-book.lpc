//sword-book.c

inherit ITEM;

void create()
{
        set_name("华山剑谱", ({ "sword-book","book", }));
        set_weight(600);
        set("unit", "本");
        set("long", "这是记录华山派无上剑法秘诀的剑谱。\n");
        set("value", 10000);
        set("skill", ([
                "name":        "sword",          // name of the skill
                "exp_required": 50000,               // minimum combat experience required                                                                           
                                                 // to learn this skill.
                "sen_cost": 25,                  // gin cost every time study this
                "difficulty": 30,                // the base int to learn this skill
                                  // modify is gin_cost's (difficulty - int)*5%
                "max_skill": 100   // the maximum level you can learn from this object.
        ]) );
}
 

