// gusao.c
inherit NPC;

void create() {
  set_name("顾嫂", ({ "gu sao", "gu" }));
  set("gender", "女性");
  set("age", 42);
  set("title", "煮饭婆");
  set("long", @LONG
可别小看她，她可是华山掌门的师妹呢，只是她天生痴迷于烹饪，因
而在这里为华山弟子煮饭，她烧得一手好菜，大家都很喜欢她。
LONG
  );
  set("int", 16);
  set("cor", 20);
  set("agi", 16);
  set("con", 20);
  set("str", 15);
  set("tol", 23);
  set("spi", 21);
  set("dur", 17);
  set("per", 22);
  set("fle", 23);
  set("cps", 20);
  set("max_force", 2500);
  set("force", 4000);
  set("force_factor", 80);
  set("combat_exp", 1500000);
  set("score", 35000);
  //	set("daode", 10900);

  set_skill("dodge", 150);
  set_skill("move", 150);
  set_skill("parry", 140);
  set_skill("sword", 120);
  set_skill("force", 160);
  set_skill("unarmed", 170);
  set_skill("literate", 50);
  set_skill("hs-zhengqi", 100);
  set_skill("huashan-force", 160);
  set_skill("zixia-shengong", 150);
  set_skill("huashan-sword", 140);
  set_skill("huashan-strike", 180);
  set_skill("tianluo-steps", 150);

  map_skill("sword", "huashan-sword");
  map_skill("parry", "huashan-sword");
  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "huashan-strike");
  map_skill("dodge", "tianluo-steps");
  map_skill("move", "tianluo-steps");

  create_family("华山派", 15, "弟子");

  set("chat_chance", 15);
  set("chat_msg", ({
    "顾嫂嘟哝着：奇怪，那把斧头到哪去了？\n",
    "顾嫂叹道：没有斧头我拿什么砍柴呢？\n"
  }));

  set("inquiry", ([
    "莫天雄": "他是我师兄，人品好，武功高，人又长得帅，可惜落花有意，流水无情啊。\n",
    "柴房": "柴房就是放柴火的地方，没柴火我手艺再好也烧不出好菜啊。\n",
    "血迹": "你说的是柴房里的血迹吧，前两天有个小毛贼来华山偷东西，躲在柴房，被我撞见\n了，可气他竟然敢挟持老娘，真他妈地没长眼，我先一下「高山流水」，再来个「无边落木」，\n把他打得鲜血乱喷，落荒而逃，很久没动手，真是过瘾啊，哈哈。\n",
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_killing", "kill");
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob->query_temp("cook"))
    command("say 你是来帮忙的吧，赶快干活(work)吧！\n");
}
int accept_object(object me, object obj) {
  if (obj->query("id") == "tiefu") {
    command("say 太谢谢你啦，疑....");
    command("?");
    command("say 这把斧头不是我的，而且这是把十分罕见的利斧啊，你要好好保管。");
    obj = new(__DIR__ "obj/kaitian-fu");
    obj->move(me);
    message_vision("顾嫂把斧头还给了$N。\n", me);
    return 1;
  }
  if (obj->query("id") == "futou") {
    command(":)");
    command("say 多谢了，这正是我的斧头。上次我打退了个小偷，他的书在我这，就给你吧。");
    obj = new(__DIR__ "obj/sword-book");
    obj->move(me);
    message_vision("顾嫂给$N一本书。\n", me);
    return 1;
  } else return 0;
}
int do_killing(string arg) {
  object player, victim;
  player = this_player();
  if (!arg)
    return 0;
  if (objectp(victim = present(arg, environment(this_object())))) {
    if (victim->query("family/family_name") == "华山派") {
      message_vision("$N大怒，大胆狂徒，竟敢在华山动手，未免太小看我们华山派吧！受死吧！\n", this_object());
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      return 0;
    } else return 0;
  } else return 0;
}
void killed_enemy(object ob) {
  command("say 哈哈, 不自量力的家伙！");
}
