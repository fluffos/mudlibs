inherit NPC;

void create() {
  set_name("蜜蜂", ({ "bee" }));
  set("race", "野兽");
  set("age", 1);
  set("gender", "雌性");
  set("long", "一只翩翩起舞的小蜜蜂哦! \n");

  set("str", 6);
  set("cor", 8);
  set("per", 33);

  set("combat_exp", 100);
  set("score", 10);
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "身体", "翅膀" }));
  set("verbs", ({ "bite" }));
  set_temp("apply/dodge", 50);

  set("chat_chance", 5);
  set("chat_msg", ({
    "蜜蜂嗡嗡地飞来飞去! \n",
    "蜜蜂停在花上吸花蜜。 \n"
  }));

  setup();
}
