// oop.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h> 

void create()
{
        set_name("闪电客", ({ "oop" }) );
        set("gender", "男性");
        set("age",29);
        set("title", "华山派大师兄");
        set("nickname", WHT"华山三英"NOR);
        set("long",@LONG
闪电客相貌英俊，武功高强，乃是华山新一代中的好手。和其师傅也
不相上下。是人称“华山三英”之首，平时一般都是由其代师传艺。
LONG
        );
        set("attitude", "peaceful");
        set("int", 25);
        set("cor", 25);
        set("agi", 25);
        set("con", 20);
        set("str", 20);
        set("tol", 20);
        set("spi", 15);
        set("dur", 20);
        set("per", 30);
        set("fle", 15);
        set("cps", 20);
        set("max_force", 2400);
        set("force", 4000);
        set("force_factor", 60);
        set("combat_exp", 1000000);
        set("score", 40000);
//      set("daode", 49000);

        set("book_count", 1);

        set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
        (: perform_action, "sword.taiyue" :),
        }) );
        set_skill("dodge", 150);
        set_skill("move", 150);
        set_skill("parry", 160);
        set_skill("sword", 160);
        set_skill("force", 150);
        set_skill("unarmed", 100);
        set_skill("literate", 110);
        set_skill("hs-zhengqi", 120);
        set_skill("huashan-force", 150);
        set_skill("zixia-shengong", 120);
        set_skill("huashan-sword", 160);
        set_skill("huashan-strike", 140);
        set_skill("tianluo-steps", 150);

        set("perform/huashan/taiyue",1000);  //perform lv=1

        map_skill("sword", "huashan-sword");
        map_skill("parry", "huashan-sword");
        map_skill("force", "zixia-shengong");
        map_skill("unarmed", "huashan-strike");
        map_skill("dodge", "tianluo-steps");

        create_family("华山派", 16, "弟子");

        setup();
        carry_object(__DIR__"obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();
}
void attempt_apprentice(object ob)
{
        int exp = (int)ob->query("combat_exp");
        if( exp < 10000) {
                if(ob->query("class") != "huashan") {
                command("say 想入华山派？很好很好，不过你得先去跟我的师弟学点入门功夫。");
                message_vision("闪电客说道：来人，带这位"  + RANK_D->query_respect(ob) + "去练功房拜师。\n",ob);
                message_vision("一个华山弟子走来带$N走了。\n",ob);
                switch(random(2)){
                        case 0:
                                ob->move("/u/yanzi/huashan/lian1");
                                break;
                        case 1:
                                ob->move("/u/yanzi/huashan/lian2");
                                break;
                        }
                return;
                }
                command("say 你的经验还不足，要多多努力啊。");
                return;
        }
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + 
"多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
        ob->set("class","huashan");
        ob->set("id_type",1);
}
void init()
{
        add_action("do_learn", "qiujiao");
        add_action("do_killing", "kill");
}
int do_learn(string arg)
{
        string from;
        object me;
        int cz,lit;
        me = this_player();     
        cz = (int)me->query("int",1);
        lit = (int)me->query_skill("literate",1);
        
        if(me->is_busy() )      return notify_fail("你正忙着呢！\n");
        if(me->query("family/family_name")!= "华山派") 
                return notify_fail("你要学太岳三青峰就先入我华山吧。\n");
        if((int)me->query_skill("huashan-sword",1) < 40) 
                return notify_fail("你的华山剑法所学不足，无法领悟太岳三青峰第一重。\n");
        if((int)me->query("perform/huashan/taiyue") >= 1000 )
                return notify_fail("你已学会太岳三青峰第一重，闪电客已不能指点你什么了。\n");
        if((int)me->query("potential") < 10) 
                return notify_fail("你的潜能不足，学习太岳三青峰第一重至少需要10点潜能。\n");
        if((int)me->query("gin") < 20) 
                return notify_fail("你的精力不足，该休息休息了。\n");
        if(sscanf(arg, "%s from %s", arg, from)==2 ) {
                if( from != "oop") 
                        return notify_fail("你要向谁求教？\n");
                if(arg == "太岳三青峰" || arg == "taiyue") {
                tell_object(me,"你向闪电客请教有关华山绝技「太岳三青峰」的疑问。\n");
                tell_object(me,"你听了闪电客的指导，似乎有些心得。\n");
                me->add("perform/huashan/taiyue", cz+lit/8+random(20));
                me->add("potential", -10);
                me->add("gin", -20);
                if(me->query("perform/huashan/taiyue") >= 1000 ) 
                        tell_object(me,HIC"你学会了华山绝技--太岳三青峰第一重！\n"NOR);
                return 1;
                }
                return notify_fail("你只能向闪电客求教太岳三青峰(taiyue)。\n");
        }
        return notify_fail("指令格式：qiujiao (perform) from (sb)\n");
}
int do_killing(string arg)
{
        object player,victim;
        player = this_player();
        if(!arg)
        return 0;
        if( objectp(victim = present(arg, environment(this_object()))))
        {
                if (victim->query("family/family_name")== "华山派") 
                {
                message_vision("$N大怒，大胆狂徒，竟敢在华山动手，未免太小看我们华山派吧！受死吧！\n",this_object());
                this_object()->kill_ob(player);
                player->kill_ob(this_object());
                return 0;
                }
                else return 0;
        }
        else return 0;
}
void killed_enemy(object ob)
{
        command("say 哈哈, 不自量力的家伙！");
}
