// laoshen.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;

void create()
{
	set_name("李志平", ({ "li zhiping", "li" }) );
	set("gender", "男性");
	set("age",60);
	set("attitude", "peaceful");
	set("title", "华山派剑宗十五代传人");
	set("int", 30);
	set("cor", 25);
	set("agi", 30);
	set("con", 25);
	set("str", 25);
	set("tol", 30);
	set("spi", 30);
	set("dur", 30);
	set("per", 28);
	set("fle", 30);
	set("cps", 30);
	set("long",@LONG
他就是大名鼎鼎的华山大侠令狐冲的大弟子，也是唯一得到令狐剑法
精髓的唯一传人，只是他对江湖之事一直不敢兴趣，长年隐居于华山
因而江湖之上知道他的并不多。
LONG
	);
	set("max_force", 3500);
	set("force", 5000);
	set("force_factor", 120);
	set("combat_exp", 8000000);
	set("score", 100000);
//	set("daode", 79900);

	set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
	(: perform_action, "sword.poqi" :),
        }) );
	set_skill("dodge", 280);
	set_skill("move", 280);
	set_skill("parry", 300);
	set_skill("sword", 350);
	set_skill("force", 200);
	set_skill("unarmed", 100);
	set_skill("literate", 200);
        set_skill("hs-zhengqi", 250);
	set_skill("dg9-sword", 300);
	set_skill("huashan-sword", 300);
	set_skill("huashan-force", 250);
	set_skill("huashan-strike", 150);
	set_skill("tianluo-steps", 300);

	set("perform/huashan/pojian",1000);
	set("perform/huashan/podao",1000);
	set("perform/huashan/poqiang",1000);
	set("perform/huashan/poqi",1000);
	set("perform/huashan/swordgod",3000);
	
	map_skill("sword", "dg9-sword");
	map_skill("parry", "huashan-sword");
	map_skill("force", "huashan-force");
	map_skill("unarmed", "huashan-strike");
	map_skill("dodge", "tianluo-steps");
	map_skill("move", "tianluo-steps");

	create_family("华山派", 15, "弟子");

	setup();
	carry_object(__DIR__"obj/gangjian")->wield();
	carry_object("/obj/cloth")->wear();
}
void attempt_apprentice(object ob)
{
	if (!ob->query("marks/huashan/dg9") ) {
	command("say 你我并无师徒之缘，但是如你能找到六枚千年鹰蛋，\n我到能在剑法上指点你一二，由于它们极为稀有，你可以一枚一\n枚找了给我，累计满六枚，我就指点你一次。\n");
	return;
	}
	else {
        command("say 既然你我在思过崖上有一面之缘，我就收你为徒吧。");
        command("recruit " + ob->query("id") );
	ob->delete("marks/huashan/dg9");
	ob->set("class", "huashan-sword");
	ob->set("title", "华山派剑宗第十六代传人");
//	ob->add("betrayer", -1);
	return;
	}
}
int accept_object(object me, object obj)
{
	int sk = (int)me->query_skill("sword",1);
	if( obj->query("id")=="egg" ) {
		if((int)me->query("huashan/egg") < 5) {
			command("say 继续加油找啊！\n");
			me->add("huashan/egg", 1);
			return 1;
		}
		if((int)me->query("huashan/egg") == 5) {
			command("smile");
			command("say 既然如此，我就在剑法上指点你一二。\n");
			message_vision("李志平指点$N有关剑法的技巧，$N似乎有所领悟。\n",me);
			me->set_skill("sword", sk+1);
			tell_object(me,HIC"你的「基本剑法」进步了！\n"NOR);
			me->delete("huashan/egg");
			return 1;
		}
	}
	else return 0;
}
void init()
{
	add_action("do_killing", "kill");
	add_action("do_qiujiao", "qiujiao");
}
int do_killing(string arg)
{
	object ob,victim;
	int sk,kee_wound;
	sk = (int)this_object()->query_skill("dg9-sword",1);
	ob = this_player();
	if(!arg)
	return 0;
	if( objectp(victim = present(arg, environment(this_object()))))
	{
		kee_wound = 200 + random(sk);
		
		if (victim->query("family/family_name")== "华山派"
		&& victim->query("id") != this_object()->query("id")) 
		{
		command("sigh");
		message_vision(HIC"$N自言自语道：现在华山弟子怎么这么随便被人欺侮？莫天雄那小儿也太没出息了！\n"NOR,this_object());
		command("say 哼，各位也太瞧不起小老儿了，在我面前撒野！");
		if((int)ob->query_skill("parry",1) < 150 && random(3) < 2 ) {
			message_vision(HIW"$N手中钢剑缓缓举起，突然，只见白光飞闪，$n已身中一剑，此等剑法，恐当世再无第二人！\n"NOR,this_object(),ob);
			ob->add("kee", -kee_wound);
			ob->add("eff_kee", -kee_wound);
			COMBAT_D->report_status(ob);
			}
		this_object()->kill_ob(ob);
		ob->kill_ob(this_object());
		return 0;
		}
		else 
		message_vision("$N笑嘻嘻得说道：各位在这里动武，叫我这张老脸往哪里搁啊？\n",this_object());
		message_vision("$N说话同时，众人便见几道剑光向$n袭去！\n",this_object(),ob);
		tell_object(ob,HIC"你只觉漫天剑光，全部指向自己的破绽之处，根本无法能有一丝动弹，你顿时惊得目瞪口呆！世上竟有此等剑法！？\n"NOR);
		message("vision",HIC"只见剑光闪过，只剩下" + ob->name() + "瞠目结舌地站着，满脸惊讶，诧异！\n"NOR,environment(ob),ob);
		message_vision("$N一露身手，中止了这场即将开始的打斗。\n", this_object());
		return 1;
	}
	else return 0;
}
int do_qiujiao(string arg)
{
	string from;
	object me,ob;
	int cz,lit;
	me = this_player();	
	ob = this_object();
	cz = (int)me->query("int",1);
	lit = (int)me->query_skill("literate",1);
	if(!arg ) return 0;
	if(me->is_busy() )	return 0;
	if (me->query("family/master_name")!= "李志平") {
		write("你非我弟子！\n");
		return 1;
		}
	if(sscanf(arg, "%s from %s", arg, from)==2 ) {
		if( from != "li zhiping" && from != "li" ) 
			return notify_fail("你要向谁求教？\n");
		if(arg == "剑神决" || arg == "swordgod") {
			if((int)me->query("gin") < 35) 
				return notify_fail("你的精力不足，该休息休息了。\n");
			if((int)me->query("potential") < 25) 
				return notify_fail("你的潜能不足，学习剑神决至少需要25点潜能。\n");
			if((int)me->query_skill("huashan-force",1) < 150
			|| (int)me->query_skill("sword",1) < 200 
			&& (int)me->query("perform/huashan/swordgod") > 2000) 
				return notify_fail("你的华山心法或剑法所学不足，无法领悟剑神决的最高境界。\n");
			else if((int)me->query_skill("huashan-force",1) < 130
			|| (int)me->query_skill("sword",1) < 180
			&& (int)me->query("perform/huashan/swordgod",1) > 1000 )
				return notify_fail("你的华山心法或剑法所学不足，无法继续领悟剑神决。\n");
			else if((int)me->query_skill("huashan-force",1) < 100
			|| (int)me->query_skill("sword",1) < 150
			&& (int)me->query("perform/huashan/swordgod",1) < 1000 )
				return notify_fail("你的华山心法或剑法所学不足，无法学习剑神决。\n");
			if((int)me->query("perform/huashan/swordgod",1) > 3000 )
				return notify_fail("你已领悟了剑神决的最高境界，李志平已不能指点你什么了。\n");
			tell_object(me,"你向李志平请教有关剑宗绝技「剑神决」的疑问。\n");
			tell_object(me,"你听了李志平的指导，似乎有些心得。\n");
			me->add("perform/huashan/swordgod", cz+lit/8+random(20));
			me->add("potential", -25);
			me->add("gin", -35);
			if((int)me->query("perform/huashan/swordgod",1) > 3000 ) {
				tell_object(me,HIC"你领悟了剑宗绝技--剑神决的最高境界！\n"NOR);
				me->delete("marks/huashan/swordgod2");
			}
			else if((int)me->query("perform/huashan/swordgod",1) > 2000
			&& !me->query("marks/huashan/swordgod2")) {
				tell_object(me,HIC"你大体领悟了剑宗绝技--剑神决！\n"NOR);
				me->set("marks/huashan/swordgod2",1);
				me->delete("marks/huashan/swordgod1");
			}
			else if((int)me->query("perform/huashan/swordgod",1) > 1000
			&& !me->query("marks/huashan/swordgod1")) {
				tell_object(me,HIC"你似乎粗通了剑宗绝技--剑神决！\n"NOR);
				me->set("marks/huashan/swordgod1",1);
			}
			return 1;
		}
		if(arg == "破剑式" || arg == "pojian") {
			if((int)me->query_skill("dg9-sword",1) < 100 ) 
				return notify_fail("你的独孤九剑所学不足，无法领悟破剑式。\n");
			if((int)me->query("perform/huashan/pojian") > 1000 )
				return notify_fail("你已学会破剑式，李志平已不能指点你什么了。\n");
			if((int)me->query("gin") < 30) 
				return notify_fail("你的精力不足，该休息休息了。\n");
			if((int)me->query("potential") < 20) 
				return notify_fail("你的潜能不足，学习破剑式至少需要20点潜能。\n");
			tell_object(me,"你向李志平请教有关剑宗绝技「破剑式」的疑问。\n");
			tell_object(me,"你听了李志平的指导，似乎有些心得。\n");
			me->add("perform/huashan/pojian", cz+lit/9+random(15));
			me->add("potential", -20);
			me->add("gin", -30);
			if((int)me->query("perform/huashan/pojian") > 1000 ) 
				tell_object(me,HIC"你学会了剑宗绝技--破剑式！\n"NOR);
			return 1;
		}	
		if(arg == "破刀式" || arg == "podao") {
			if((int)me->query_skill("dg9-sword",1) < 100 ) 
				return notify_fail("你的独孤九剑所学不足，无法领悟破刀式。\n");
			if((int)me->query("perform/huashan/podao") > 1000 )
