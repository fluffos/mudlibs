// tongzi.c
inherit NPC;

void create() {
  set_name("童子", ({ "tongzi", "zi" }));
  set("gender", "男性");
  set("age", 10);
  set("title", "奉茶童子");
  set("long", @LONG
一个十几岁的小孩，专门在这里侍奉茶水。
LONG
  );
  set("max_force", 50);
  set("force", 80);
  set("force_factor", 5);
  set("combat_exp", 500);
  set("score", 50);
  set("daode", 100);

  set_skill("dodge", 10);
  set_skill("parry", 10);
  set_skill("force", 10);
  set_skill("unarmed", 10);
  set_skill("literate", 5);
  set_skill("hs-zhengqi", 5);
  set_skill("huashan-force", 10);
  set_skill("huashan-strike", 15);
  set_skill("tianluo-steps", 10);

  map_skill("force", "huashan-force");
  map_skill("unarmed", "huashan-strike");
  map_skill("dodge", "tianluo-steps");

  create_family("华山派", 17, "弟子");

  setup();
  carry_object("/obj/cloth")->wear();
}
