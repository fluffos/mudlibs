// shenying.c

inherit NPC;

void create()
{
        set_name("千年神鹰", ({ "shen ying","ying" }) );
        set("long",
                "一只一千多岁的神鹰，它看来十分英武。\n");

        set("race", "野兽");
        set("age", 1000);

        set("max_gin", 500);
        set("max_kee", 1000);
        set("max_sen", 1100);

        set("str", 100);
        set("cor", 60);
        set("spi", 60);
        set("int", 10);
//      set("daode", 19900);

        set("limbs", ({ "头部", "身体", "翅膀", "尾巴" }) );
        set("verbs", ({ "bite", "claw", "poke" }) );

        set_temp("apply/attack", 400);
        set_temp("apply/damage", 100);
        set_temp("apply/dodge", 450);
        set_temp("apply/armor", 100);

        set("combat_exp", 1000000);
        setup();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
        this_object()->kill_ob(ob);
        }
}

