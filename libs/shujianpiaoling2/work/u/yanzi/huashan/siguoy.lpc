// Room: /u/yanzi/huashan/siguoy.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIC"思过崖"NOR);
	set("long", @LONG
这里便是华山派弟子受罚思过的地方。位于玉女峰顶，正好有一
小快平地，一面是深不可测的山谷、一面是陡峭的悬壁，由于可
以不受干扰，所以华山弟子可以好好地在这里面壁(mianbi)。
LONG
	);
	set("no_clean_up", 0);
	set("valid_startroom",1);

	setup();
}
void init()
{       
	object ob = this_player();

	if( (int)ob->query_condition("huashan_siguo") <= 0 )
	{
		message("vision",
			HIY "好象有个人走了过来。\n" NOR, 
			environment(ob), ob);

		tell_object(ob, "莫天雄说道：在这里好好反省反省吧\n");

		ob->set("startroom", "/u/yanzi/huashan/siguoy");
	}
	add_action("do_mianbi", "mianbi");
}
int do_mianbi()
{
	object me,master;
	int n,fy;
	me = this_player();
	n = random(100);
	fy = (int)me->query("kar");
	if(fy > 40) fy = 40;

	if (me->query("marks/面壁", 1) )
		return notify_fail("你已经在面壁了。\n");
	message_vision("$N开始坐下来面壁思过。\n",me);
	me->set("marks/面壁", 1);
	if ( n < 5+fy/4 ) { //5%-15%
	tell_object(me,"忽然只见墙上一个人影闪过，一个白发老者出现在崖上。\n");
	master=new(__DIR__"npc/lizhip2");
	master->move(environment(me));
	return 1;
	}
	else if ( n < 45+fy/2) { //40%-50%
	tell_object(me,"忽然只见墙上一个人影闪过，但眨眼就消失了。\n");
	me->apply_condition("huashan_siguo", 30);
	return 1;
	}
	else 
	me->apply_condition("huashan_siguo", 30);
	return 1;
}