// Room: /u/yanzi/huashan/mishi.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", "密室");
  set("long", @LONG
一间空空地石室，石桌之上似乎放着一只古琴，四周墙上(wall)
似乎用剑刻着不少字。
LONG
  );
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "obj/table2": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "woshi",
  ]));
  set("no_clean_up", 0);
  set("item_desc", ([ /* sizeof() == 1 */
    "wall": "墙上写着：
    吾自知将不久于人士，但不愿曲洋、刘正风两位前辈所送于我的
<笑傲江湖曲谱>绝传于人世，特留<燕语>于此，曲谱埋于卧室，另有
玉萧我则送于师侄莫天雄，日后看到此留言的有缘之人，望能将此曲
流传于江湖。

                                                    华山--令狐冲
",
  ]));
  set("book_count", 1);
  setup();

}
void init() {
  add_action("do_play", ({ "tan", "chui" }));
  add_action("do_get", "get");
}
int do_get(string arg) {
  string obj, from;
  object me, table, target, taro;

  if (sscanf(arg, "%s from %s", obj, from) == 2) {
    if (obj == "all") {
      return 0;
    }
    table = present("stone table", this_object());
    target = present(from, this_object());
    me = this_player();
    if (target == table) {
      taro = present(obj, target);
      if (taro) {
        message_vision("$N从石桌上拿下样东西。\n", me);
      }
    }
  }
  return 0;
}
void reset() {
  object *inv;
  object con, item;
  int i;

  ::reset();
  con = present("stone table", this_object());
  inv = all_inventory(con);
  if (sizeof(inv) != 8) {
    for (i = sizeof(inv) - 1; i >= 0; i--) destruct(inv[i]);
    item = new(__DIR__ "obj/7xianqin");
    item->move(con);
  }
}
int do_play(string arg) {
  object me, ob;
  int skill;
  me = this_player();
  skill = (int)me->query_skill("music", 1);
  if (!arg)
    return 0;
  if (arg != "xojh" && arg != "笑傲江湖")
    return 0;
  if (skill < 200)
    return notify_fail("你的琴音韵律所学不足。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的真气不够。\n");
  if (!present("7xianqin", me) && !present("yu xiao", me))
    return notify_fail("《笑傲江湖》必须琴萧合奏。\n");
  if (!present("xojh book", me))
    return notify_fail("你身上没有笑傲江湖曲谱，如何演奏？\n");

  if (query("book_count") < 1) {
    message_vision("只见石桌突然移开，但下面什么也没有。\n", me);
    return 0;
  }
  message("vision", "只见石桌突然移开，露出一个铁盒。\n", environment(me));
  message_vision("$N打开铁盒一看，里面有一本书，还有张纸条，上面写着，在我死后，尚能\n" +
    "有人会这绝世音乐，甚感欣慰，此本<令狐剑要>乃根据我一身所学所著，便赠予你吧。\n", me);
  message_vision("$N大喜，忙把<令狐剑要>放如怀中。\n", me);
  ob = new(__DIR__ "obj/sword-book2");
  ob->move(me);
  ob = new(__DIR__ "obj/box");
  ob->move(environment(me));
  add("book_count", -1);
  return 0;
}
