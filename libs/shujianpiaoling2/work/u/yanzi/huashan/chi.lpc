// Room: /u/yanzi/huashan/chi.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIC"水池"NOR);
	set("long", @LONG
你正身处一个天然的水池中，四周崖壁矗立，想是在一个巨大的
山谷之中，东面似乎有片陆地，当务之急当是赶快游(swin)过去。
LONG
	);
	set("no_clean_up", 0);

	setup();
}
void init()
{
	add_action("do_swin", "swin");
} 
int do_swin(string arg)
{
	if( !arg ) return notify_fail("你要往哪里游？\n");
	if( arg != "east" ) return notify_fail("那里并没有陆地。\n");
	message_vision("$N你向池边奋力游去，不一会便游到了岸边，爬上岸去。\n");
	this_player()->move(__DIR__"gudi4");
//	return 1;
}