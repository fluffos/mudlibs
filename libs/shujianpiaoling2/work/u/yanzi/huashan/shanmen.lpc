// Room: /u/yanzi/huashan/shanmen.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIC"山门"NOR);
	set("long", @LONG
一眼跃入你眼帘的是一座巨大的石制山门，这是华山的门户，过
了这里你就真正进入华山啦。石门之后是长长的石阶，通往山上。
    从这往北是玉泉院，西面是莎萝坪。
LONG
	);
	set("objects", ([ /* sizeof() == 1 */
        __DIR__"npc/duan" : 1,
	__DIR__"npc/dizi-1" : 1,
]));
	set("outdoors", "huashan");
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 2 */
  "northdown" : __DIR__"yuquan",
  "westup" : __DIR__"shaluo",
]));

	setup();
}
void init()
{
	add_action("do_guard", "guard");
}
int do_guard()
{
	object me;
	int cost;
	me = this_player();
	cost=40+(25-me->query("int"));

	if(me->query_temp("over"))
		return notify_fail("你已经完成任务了，快复命去吧。\n");
	if(!me->query_temp("guard"))
		return notify_fail("段成海笑了笑：已经有人帮我了。\n");
	if(me->query_temp("busy"))
		return notify_fail("你正忙着呢。\n");
	if(me->query("sen")<cost  || me->query("gin")<cost)
		return notify_fail("你够累的了，休息一下吧!\n");
	
	me->set_temp("busy",1);
	if(me->query_temp("num")==me->query_temp("guard")){
		tell_object(me,"段成海说道：好了，这里没有需要你帮忙的了。”\n");
		message_vision("$N擦了擦额头的汗水，收工了。\n",me);
		tell_object(me,"你在" + chinese_number((int)me->query_temp("guard")) +
		"次任务中总共成功完成" + chinese_number((int)me->query_temp("success")) +
		"次。\n");
		if((int)me->query_temp("success") == (int)me->query_temp("guard") )
			me->set_temp("wonderful",1);
		me->delete_temp("guard");
		me->delete_temp("num");
		me->set_temp("over",1);
		me->delete_temp("busy");
		return 1;
	}
	message_vision("$N抱剑守在山门口。\n",me);
	call_out("improve",5,me);
 	me->start_busy(5);
	return 1;
}
void improve(object who)
{

	object ob;
	int cost,i,n;
	i = random(100);
	n = 20+who->query("int")+who->query("cps");
	cost=40+(25-who->query("int"));

	who->add("sen",-cost);
	who->add("gin",-cost);
	who->add_temp("num",1);
	who->set_temp("busy",0);
	if(i < n) {
		tell_object(who,"\n你十分专注地守在山门口。\n");
		who->add_temp("success",1);
	}
	else
		tell_object(who,"\n你虽然守在山门口，但却一幅心不在焉的样子。\n");
}

#include "/u/yanzi/huashan/westup.h";
