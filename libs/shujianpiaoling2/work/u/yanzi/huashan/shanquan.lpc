// Room: /u/yanzi/huashan/shanquan.c

inherit ROOM;

void create() {
  set("short", "[1;36m山泉[2;37;0m");
  set("long", @LONG
一处清澈的山泉，从山间一直流向这里，泉水清冽，是华山派饮
用之水的来源，几个女弟子怎正在梳洗嬉闹，欢快的笑声和潺潺的流
水声使地山间热闹起来。
LONG
  );
  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/dizi-2": 2
  ]));
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "zhulin",
  ]));

  setup();
}
void init() {
  add_action("do_fillwater", "fillwater");
  add_action("do_drink", "drink");
}
int do_fillwater(string arg) {
  object *list, ob;
  int i, can_fillwater;
  string dir;

  if (!arg || arg == "") {
    write("你要往什么东西里灌水？\n");
    return 1;
  }
  if (!ob = present(arg, this_player())) {
    write("你身上没有这个东西。\n");
    return 1;
  }

  if (ob->query("liquid/type") == "alcohol"
    || ob->query("liquid/type") == "water") {
    ob->set("liquid", ([
      "type": "water",
      "name": "泉水",
      "remaining": 15,
      "drunk_apply": 6,
    ]));
    write("你从泉边装满了泉水。\n");
    return 1;
  } else {
    write("你没有装水的东西啊....\n");
    return 1;
  }
}
int do_drink(string arg) {
  object ob;
  ob = this_player();

  if (ob->is_busy())
    return notify_fail("你正忙着其他事情呢。\n");
  if ((int)ob->query("water") >= (int)ob->max_water_capacity())
    return notify_fail("你已经喝得太多了，再也灌不下一滴水了。\n");
  ob->add("water", 30);
  if (ob->is_fighting()) ob->start_busy(2);
  message_vision("$N伏到泉边喝了几口泉水。\n", ob);
  return 1;
}
