// Room: /u/yanzi/huashan/gudi3.c

inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", HIC"谷底"NOR);
        set("long", @LONG
这里就象一座室外天境，流水潺潺，小鸟欢唱，还长着一种叫不
出的名字的奇怪的花，竟然开有七钟颜色。溪水之旁有一间小茅屋，
不知是否有人居住，屋旁则是一座坟墓，墓碑(bei)上不知刻得是什
么。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"gudi2",
  "northeast" : __DIR__"yadi",
  "east" : __DIR__"pubu",
]));
        set("item_desc", ([ /* sizeof() == 1 */
  "bei" : @TEXT
                ***********************
                *一                   *
                *代                   *
                *剑  先               *
                *圣  太  风           *
                *    师  清     徒    *
                *    父  扬     孙  李*
                *        之         志*
                *        墓         平*
                *                   立*
                ***********************
TEXT,
]));
        set("no_clean_up", 0);

        set("flower_count", 7);
        set("outdoors", "huashan");
        setup();

}
void init()
{
        add_action("do_fillwater", "fillwater");
        add_action("do_drink", "drink");
        add_action("do_enter", "enter");
        add_action("do_zhai", "zhai");
}
int do_fillwater(string arg)
{
        object *list, ob;
        int i, can_fillwater;
        string dir;

        if( !arg || arg=="" ) {
                 write("你要往什么东西里灌水？\n");
                   return 1; } 
         if(! ob = present(arg,this_player()) ) {
                 write("你身上没有这个东西。\n");
                   return 1; } 

        if (ob->query("liquid/type") == "alcohol"
 || ob->query("liquid/type") == "water" ) {
                 ob->set("liquid", ([
                           "type": "water",
                           "name": "溪水",
                           "remaining": 15,
                           "drunk_apply": 6,
                 ]) );
                 write("你从小溪里装满了溪水! \n");
                 return 1;
                   }
         else {
                        write("你没有装水的东西啊....\n");
                        return 1;  }
}
int do_drink(string arg)
{
        object ob;
        ob = this_player();

        if( ob->is_busy() )
                return notify_fail("你正忙着其他事情呢。\n");
        if( (int)ob->query("water") >= (int)ob->max_water_capacity() )
                return notify_fail("你已经喝得太多了，再也灌不下一滴水了。\n");
        ob->add("water", 30 );
        if( ob->is_fighting() ) ob->start_busy(2);
        message_vision("$N伏到溪边喝了几口水。\n", ob);
        return 1;
}
int do_enter(string arg)
{
        object me = this_player();

        if( (!arg ) || (!(arg=="house" || arg == "茅屋" )) )
                return 0;
        if (me->query("makrs/dg9") 
        || me->query("class") == "huashan-sword") {
                message_vision("$N走进了茅屋。\n",me);
                me->move(__DIR__"house1");
                return 1;
        }
        else {
                message_vision("$N走进了茅屋。\n",me);
                me->move(__DIR__"house2");
                return 1;
        }
}
int do_zhai(string arg)
{
        object me,ob;
        int i,kar;
        me = this_player();
        i = random(100);
        kar = (int)me->query("kar");
        if(kar > 40) kar = 40;

        if( (!arg) || (!(arg=="hua" || arg == "flower" )) )
                return notify_fail("你要摘什么？\n");
        if(query("flower_count") < 1)
                return notify_fail("树上已经没有花了！\n");
        if(me->query_temp("marks/zhai") )
                return notify_fail("你已经摘了一朵了。\n");

        message_vision("$N从树上摘下一朵无名的小花。\n",me);
        add("flower_count", -1);
        me->set_temp("marks/zhai",1);
                if(i < 5){
                        ob = new(__DIR__"obj/hua"); //dead or unconcious 5% 亮红
                        ob->move(me);
                        }
                else if(i < 15){
                        ob = new(__DIR__"obj/hua2");//position 10% 土黄
                        ob->move(me);
                        }
                else if(i < 30){
                        ob = new(__DIR__"obj/hua3");//+ force 15% 蓝
                        ob->move(me);
                        }
                else if(i < 60){
                        ob = new(__DIR__"obj/hua4");//clear condition 30% ；亮绿
                        ob->move(me);
                        }
                else if(i < 75){
                        ob = new(__DIR__"obj/hua5");//- force 15% 天青
                        ob->move(me);
                        }
                else if(i < 85){
                        ob = new(__DIR__"obj/hua6");//+ potential 10% 黄
                        ob->move(me);
                        }
                else    {
                        ob = new(__DIR__"obj/hua7");//+ per 15% 浅紫
                        ob->move(me);
                        }
                return 1;
}
