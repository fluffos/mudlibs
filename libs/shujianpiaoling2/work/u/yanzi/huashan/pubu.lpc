// Room: /u/yanzi/huashan/pubu.c

inherit ROOM;
#include <ansi.h>
void create()
{
	set("short", HIC"瀑布"NOR);
	set("long", @LONG
这里是谷地小溪的源头，一股流水从半山腰中冲出，形成了这一
瀑布，在水流轰鸣之声中，你隐隐看到那水帘之后似乎有些什么，如
果能击开瀑布或许能看个仔细。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"gudi3",
]));
	set("outdoors","huashan");
	setup();
}
void init()
{
	add_action("do_strike", "strike");
	add_action("do_jump", "jump");
}
int do_strike(string arg)
{
	object me,room;
	int force;
	me = this_player();
	room = find_object(__DIR__"hole");
	force = (int)me->query("force");

	if(!arg || arg != "瀑布")
		return notify_fail("你要击什么？\n");
	if(query("hole"))
		return notify_fail("瀑布已经分开了。\n");
	tell_object(me,"你对着瀑布凌空一掌击了过去。\n");
	if(force < 800) {
		message("vision","$N手掌对着瀑布莫名其妙地乱拍，但是什么反应也没有。\n",environment(me),me);
		return 1;
	}
	me->add("force",-800);
	message("vision","$N凝神静气，全身衣衫都为真气鼓动起来，伴着一声“喝！”。一道劈空掌已击向瀑布。\n"
	"伴随着巨大的水流声，水帘在$N掌力的压迫下一下子分了开来，露出一个山洞。\n",environment(me),me);
	tell_object(me,"伴随着巨大的水流声，水帘在你掌力的压迫下一下子分开，露出一个山洞(hole)。\n");
	tell_room(room,"随着巨大的声响，洞外的瀑布似乎分开了。\n");
	set("hole",1);
	remove_call_out("close");
	call_out("close",5,this_object());
	return 1;
}
int do_jump(string arg)
{
	object me = this_player();

	if(!arg || arg != "hole") {
		tell_object(me,"你要跳向哪里？\n");
		return 1;
	}
	if(!query("hole")) {
		tell_object(me,"这里没有山洞可以跳。\n");
		return 1;
	}
	message_vision("$N纵身一越，跳入了洞中。\n",me);
	me->move(__DIR__"hole");
	message("vision","突然，$N从洞外跃了进来。\n",environment(me),me);
	return 1;
}
void close(object room)
{
	message("vision","分开的瀑布一下子又恢复了原状。\n", room);
	room->delete("hole");
}