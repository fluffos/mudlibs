inherit ROOM;

void create()
{
	set("short", "[1;36m饭厅[2;37;0m");
	set("long", @LONG
这儿是华山弟子吃饭的地方，中间有着一个巨大的长桌，上面放
着许多可口的食物，有各色菜肴，面条和点心，可供华山弟子尽情享
用。旁边是一排竹椅，供人吃完饭休息之用。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	  "south" : __DIR__"chufang",
	  "north" : __DIR__"xiaoj1",
]));
	set("no_clean_up", 0);
	set("objects", ([ /* sizeof() == 2 */
  	__DIR__"obj/table" : 1,
	__DIR__"npc/tongzi" : 2,
]));

	setup();
}
void init()
{
        add_action("do_get", "get");
}

int do_get(string arg)
{
	string	obj, from;
	object	me, table, target, taro;

	if(sscanf(arg, "%s from %s", obj, from)==2 ) {
		if(obj == "all") {
			write("拿那么多你又吃不下。\n");
			return 1;
		}
	}
	return 0;
}
void reset()
{
        object  *inv;
        object con, item;
        int i;

        ::reset();
        con = present("long table", this_object());
        inv = all_inventory(con);
        if( sizeof(inv) != 8) {
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new(__DIR__"obj/cai");
                item->move(con);
		item = new(__DIR__"obj/cai");
                item->move(con);
		item = new(__DIR__"obj/cai");
                item->move(con);
                item = new(__DIR__"obj/mian");
                item->move(con);
		item = new(__DIR__"obj/mian");
                item->move(con);
		item = new(__DIR__"npc/obj/liangcha");
                item->move(con);
                item = new(__DIR__"npc/obj/liangcha");
		item->move(con);
		item = new(__DIR__"obj/songgao");
		item->move(con);
	}
}