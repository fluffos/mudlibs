// Room: /u/yanzi/huashan/hldong.c

inherit ROOM;

void create()
{
	set("short", "[1;36m贺老洞[2;37;0m");
	set("long", @LONG
这里就是十一年前华山与魔教为争夺魔教玄铁令而发生大战的地
方，但是途中发生塌方，玄铁令和两方好手都死于洞中，洞口现在完
全被石头(stone)所封死了，以至于无法进入。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"ntmen",
]));
	set("item_desc", ([ /* sizeof() == 1 */
  "stone" : "一堆大石头，想要移开它们是不可能的。
",
]));
	set("no_clean_up", 0);
	set("wide_count", 0);

	setup();
}
void init()
{
        add_action("do_pi", "pi");
}
int do_pi(string arg)
{
	object me,ob,weapon;
	int str;
	me = this_player();
	str = (int)me->query("str",1);

	if( !arg || arg!="stone" )
		return notify_fail("你要劈什么？\n");
	if (!objectp(ob = present("kaitian-fu", me)) || !objectp(ob = present("pidi-fu", me))) {
		if (objectp(weapon = me->query_temp("weapon")) )
			return notify_fail("你用手中兵刃企图把堵在洞口的石头劈开，结果只劈下些石屑。\n");
		if (!objectp(weapon = me->query_temp("weapon")) )
			return notify_fail("空手恐怕不行吧！\n");
	}
	if(str < 15)
		return notify_fail("你虽有开天斧，劈地斧在手，但劈了半天石头仍然纹丝不动，你的臂力也小了点吧。\n");
	message_vision("$N左手开天斧，右手劈地斧，轮流劈向石头，石屑飞舞，石头上的缝隙也逐渐扩大。\n",me);
	add("wide_count",1+random(str/20));
	if (query("wide_count") > 4 ) {
		message_vision("$N费尽力气，在一阵石块崩塌声中，$N终于劈开了条足够宽的裂缝。\n",me);
		set("exits/enter", __DIR__"dong");
		}
	return 1;
}
