// tiefu1.c

inherit ITEM;
#include <ansi.h>;
void create()
{
	set_name(HIB"劈地斧"NOR, ({ "pidi-fu","futou"}) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 150000);
		set("material", "blacksteel");
		set("long","相传这是沉香劈山救母所用之斧。\n");
	}
	setup();
}
