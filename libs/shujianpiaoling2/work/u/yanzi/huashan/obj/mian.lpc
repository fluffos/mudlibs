// mian.c

inherit ITEM;

string* titles = ({
	"大排面",	"素交面",
	"辣酱面",	"炸酱面",
	"海鲜面",	"鱼翅熊掌面",
	"牛肉面",	"三鲜面",
	"阳春白雪面",	"鲜虾面",
	"双菇面筋面",	"鳝丝面",
	"肉丝面",	"刀削面"
});

void create()
{
	int i = random(sizeof(titles));

	set_name(titles[i], ({ "mian" }));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一碗热气腾腾的面条。\n");
		set("unit", "碗");
		set("value", 200);
		set("remaining", 4);
		set("food_supply", 45);
		set("water_supply", 40);
        }
    setup();
}

void init()
{
	add_action("do_eat", "eat");
}


int do_eat(string arg)
{
	object me,ob;
	me = this_player();
	ob = this_object();

	if(!ob->id(arg) ) return 0;
	if(me->is_busy() )
		return notify_fail("你上一个动作还没有完成。\n");
	if((int)me->query("food") >=  (int)me->max_food_capacity() )
		return notify_fail("你已经吃太饱了，再也吃不下了。\n");

	set("value", 0);
	me->add("food", (int)query("food_supply"));
	if((int)me->query("water") < (int)me->max_water_capacity()-(int)query("water_supply"))
	me->add("water", (int)query("water_supply"));

	if(me->is_fighting() ) me->start_busy(2);

	add("remaining", -1);
	if ( query("remaining") )
	{
		if ((string)this_player()->query("gender") == "女性")	
		message_vision("$N捧起面碗，开始吃起热腾腾的" + ob->query("name") + "来。\n", me);
		else 
		message_vision("$N端起" + ob->query("name") + "，狼吞虎咽地吃起来，一边吃一边还发出“滋溜滋溜”的响声。\n", me);
	} 
	else 
	{ 
		if ((string)this_player()->query("gender") == "女性")
		message_vision("$N吃光了最后的几根面条，又喝了几口汤，然后拿出一方丝帕，轻轻的擦了擦嘴。\n",me);
		else 
		message_vision("$N端起碗来，把剩下的面连汤吞了，然后又打了个饱嗝。\n",me);
	destruct(this_object());
	}
	return 1;
}
