//zhqj-book.c

inherit ITEM;

void create()
{
        set_name("正气决--上", ({ "zhengqi-jue1","book", }));
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本简单介绍华山正气决的书。\n");
        set("value", 100);
        set("skill", ([
                "name":        "hs-zhengqi",          // name of the skill
                "exp_required": 0,               // minimum combat experience required                                                                           
                                                 // to learn this skill.
                "sen_cost": 20,                  // gin cost every time study this
                "difficulty": 30,                // the base int to learn this skill
                                  // modify is gin_cost's (difficulty - int)*5%
                "max_skill": 30   // the maximum level you can learn from this object.
        ]) );
}
 
