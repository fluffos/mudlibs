// /u/yanzi/huashan/obj/egg.c

inherit ITEM;
#include <ansi.h>;

void create()
{
	set_name(HIG"千年鹰蛋"NOR, ({ "egg","dan" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一枚十分稀有的千年神鹰的蛋。\n");
		set("unit", "枚");
		set("value", 50000);
		set("remaining", 1);
		set("food_supply", 15);
	}
	setup();
}
void init()
{
	add_action("do_eat", "eat");
}


int do_eat(string arg)
{
	object me,ob;
	int kar;
	me = this_player();
	ob = this_object();
	kar = (int)me->query("kar", 1);
	if( this_player()->query_temp("block_msg/all"));
		return notify_fail("什么？\n");

	if( !this_object()->id(arg) ) return 0;
	if( me->is_busy() )
		return notify_fail("你上一个动作还没有完成。\n");
	if(   (int)me->query("food") >= (int)me->max_food_capacity() )
		return notify_fail("你已经吃太饱了，再也吃不下了。\n");
	message_vision(HIG"$N吃下一只千年鹰蛋，顿时只觉一股热气在身体内游走！\n"NOR,me);
	me->add("food", (int)query("food_supply"));
	if((int)me->query("max_force") <2500 )
	me->add("max_force", 1+random(kar/3));
	if( me->is_fighting() ) me->start_busy(2);
	if((int)me->query("max_force") <1000 )
	{
	me->add("max_force", -1-random(kar/3));
       me->unconcious();
	}
	destruct(ob);
	return 1;
}

   