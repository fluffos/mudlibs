// songgao.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("松糕", ({ "song gao", "gao" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个糯米做的松软的糕点。\n");
		set("unit", "个");
		set("value", 50);
		set("food_remaining", 4);
		set("food_supply", 60);
	}
}
