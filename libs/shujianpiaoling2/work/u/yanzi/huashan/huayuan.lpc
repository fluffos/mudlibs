// Room: /u/yanzi/huashan/huayuan.c

inherit ROOM;

void create() {
  set("short", "[1;36m花园[2;37;0m");
  set("long", @LONG
这是一个大花园，这里除了许多一般的品种之外还有许多奇异的
十分稀有的品种，都是令狐冲创荡江湖时从各地弄来的，奇花异草吸
引了不少蝴蝶蜜蜂在这飞舞。一个七十多岁的老头在这里照料花草。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "northwest": __DIR__ "zhulin1",
    "west": __DIR__ "zawuf",
    "east": __DIR__ "xiaoj3",
  ]));
  set("objects", ([ /* sizeof() == 3 */
    __DIR__ "npc/mifen": 1,
    __DIR__ "npc/huajiang": 1,
    __DIR__ "npc/hudie": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}
int valid_leave(object me, string dir) {
  object ob;
  if (dir == "west" && present("huajiang", environment(me)) && !me->query_temp("marks/futou"))
    return notify_fail("花匠说道：杂物房里乱七八糟的，没啥看头。”\n");
  return ::valid_leave(me, dir);
}
void init() {
  add_action("do_work", "work");
}
int do_work() {
  object me;
  int cost;
  me = this_player();
  cost = 40 + (25 - me->query("int"));

  if (me->query_temp("over"))
    return notify_fail("你已经完工了，快复命去吧。\n");
  if (!me->query_temp("garden"))
    return notify_fail("老花匠笑了笑：我这里不缺人手。\n");
  if (me->query_temp("busy"))
    return notify_fail("你正忙着呢。\n");
  if (me->query("sen") < cost || me->query("gin") < cost)
    return notify_fail("你够累的了，休息一下吧!\n");

  me->set_temp("busy", 1);
  if (me->query_temp("num") == me->query_temp("garden")) {
    tell_object(me, "老花匠说道：“不错不错，今天就干到这吧。”\n");
    message_vision("$N擦了擦额头的汗水，收工了。\n", me);
    tell_object(me, "你在" + chinese_number((int)me->query_temp("garden")) +
      "次任务中总共成功完成" + chinese_number((int)me->query_temp("success")) +
      "次。\n");
    if ((int)me->query_temp("success") == (int)me->query_temp("garden"))
      me->set_temp("wonderful", 1);
    me->delete_temp("garden");
    me->delete_temp("num");
    me->set_temp("over", 1);
    me->delete_temp("busy");
    return 1;
  }
  message_vision("$N开始忙碌地干起活来。\n", me);
  switch (random(5)) {
    case 0:
      message_vision("$N打开蜂箱，把蜜蜂放出来采蜜。\n", me);
      break;
    case 1:
      message_vision("$N一棵一棵仔细察看着花儿，看有没有虫害。\n", me);
      break;
    case 2:
      message_vision("$N帮着老花匠给一棵一棵的花儿施肥。\n", me);
      break;
    case 3:
      message_vision("$N一棵挨着一棵给花朵们松土。\n", me);
      break;
    case 4:
      message_vision("$N拿着水桶给花朵们浇水。\n", me);
      break;
  }
  call_out("improve", 1, me);
  me->start_busy(1);
  return 1;
}
void improve(object who) {

  object ob;
  int cost, sk, n, i;
  cost = 40 + (25 - who->query("int"));
  sk = (int)who->query_skill("honey", 1);
  i = random(100);
  n = 30 + who->query("int") + who->query_skill("honey", 1) / 5;
  cost = 40 + (25 - who->query("int"));

  who->add("sen", -cost);
  who->add("gin", -cost);

  who->add_temp("num", 1);
  who->set_temp("busy", 0);

  if (i < n) {
    tell_object(who, "\n你这次的活干得十分不错。\n");
    if ((int)who->query("combat_exp") >= sk * sk * sk / 10) {
      tell_object(who, "你似乎对园艺有所理解。\n");
      who->improve_skill("honey", random((int)who->query("int")));
    }
    who->add_temp("success", 1);
  } else
    tell_object(who, "\n你这次的活干的好像不怎么样呀。\n");
}
