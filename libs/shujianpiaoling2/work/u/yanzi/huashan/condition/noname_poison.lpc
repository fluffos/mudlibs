// noname_poison.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	me->receive_wound("gin", 10);
	me->receive_wound("sen", 15);
	me->apply_condition("noname_poison", duration - 1);
        if( duration < 1 )
	tell_object(me, HIW "你中的" HIC "无名奇毒" HIW "终于清除了！\n" NOR );
	else
	tell_object(me, HIW "你中的" HIC "无名奇毒" HIW "发作了！\n" NOR );
	if( duration < 1 ) 
		return 0;
	return 1;
}
