// Room: /u/yanzi/huashan/pishan.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", "[1;36m沉香劈山救母处[2;37;0m");
	set("long", @LONG
传说华山三圣母爱上了一个叫刘彦昌的书生，便和他结为夫妇，
其兄二郎神反对他们结合，将她压在华山之下，她的儿子沉香长大后
用斧子劈开华山，救出了母亲。旁边有一块巨大的石头 (stone)，石
头旁还竖着一块牌子(paizi)。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"xifeng",
]));
	set("outdoors", "huashan");
	set("item_desc", ([ /* sizeof() == 1 */
  "stone" : "这是一块巨大的石头，奇怪地是石头中间有裂开很大的一个口子，就象被
斧子劈开一样。裂缝(slit)中还隐隐有闪光射出。\n",
  "paizi" : "		  这是一块木制牌子，上书：\n"
		HIR"			斧  劈  石\n"NOR,
  "slit" : "一条似乎被斧子劈开的裂缝，里面隐隐有闪光射出。\n",
]));

	set("fu_count",1);
	set("wide_count",0);
	setup();

}
void init()
{
        add_action("do_pi", "pi");
	add_action("do_search", "search");
}
int do_pi(string arg)
{
	object me,ob,weapon;
	int str;
	me = this_player();
	str = (int)me->query("str");

	if( !arg || arg!="slit" )
		return notify_fail("你要劈什么？\n");
	if (!objectp(ob = present("kaitian-fu", me)) ) {
		if (objectp(weapon = me->query_temp("weapon")) ) 
			return notify_fail("你用手中兵刃企图把裂缝劈大，结果只劈下些石屑。\n");
		if (!objectp(weapon = me->query_temp("weapon")))
			return notify_fail("空手恐怕不行吧！\n");
	}
	if(str < 15)
		return notify_fail("你虽有开天斧在手，但劈了半天石头仍然纹丝不动，你的臂力也小了点吧。\n");
	message_vision("$N拿起手上开天斧，用力劈下去，结果把裂缝劈开不少。\n",me);
	add("wide_count",1+random(str/20));
	return 1;
}
int do_search(string arg)
{
	object me,ob;
	me = this_player();

	if( !arg || arg!="slit" )
		return notify_fail("你要搜索哪里？\n");
	if(query("fu_count") < 1)
		return notify_fail("你在裂缝里搜索了会，结果什么也没有发现。\n");
	if(query("wide_count") < 3)
		return notify_fail("裂缝太小，你无法将手伸进去。\n");
	message_vision("$N把手伸入裂缝中摸索了会儿，结果发现了一把斧头。\n",me);
	add("fu_count",-1);
	ob=new(__DIR__"obj/pidi-fu");
	ob->move(me);
	return 1;
}