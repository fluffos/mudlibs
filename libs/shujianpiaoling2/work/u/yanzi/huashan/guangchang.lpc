// Room: /u/yanzi/huashan/xiaoj4.c

inherit ROOM;

void create()
{
	set("short", "[1;36m广场[2;37;0m");
	set("long", @LONG
走到这里，突然开阔起来，这是个很大的广场，华山派掌门一般
便在这里教授徒弟武功，华山众弟子也常在这里练功。
    今天华山掌门正好出去了，众弟子都在等你教他们武功。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"xiaoj3",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/dizi-1" : 4,
]));
	set("no_clean_up", 0);
	set("no_fight",1);
	set("no_study",1);
	set("no_magic",1);
	set("outdoors","huashan");

	setup();
}
void init()
{
	add_action("do_teach", "teach");
}
int do_teach()
{
	object me;
	int cost;
	me = this_player();
	cost=40+(25-me->query("int"));

	if(me->query_temp("over"))
		return notify_fail("今天就教到这里吧，你可以回去复命了\n");
	if(me->query_temp("busy"))
		return notify_fail("你正忙着呢。\n");
	if(me->query("sen")<cost  || me->query("gin")<cost)
		return notify_fail("你够累的了，休息一下吧!\n");
	
	me->set_temp("busy",1);
	if(me->query_temp("num")==me->query_temp("teach")){
		tell_object(me,"你看了看，差不多了，今天就教到这里吧。\n");
		message_vision("$N擦了擦额头的汗水，收工了。\n",me);
		tell_object(me,"你在" + chinese_number((int)me->query_temp("teach")) +
		"次任务中总共成功完成" + chinese_number((int)me->query_temp("success")) +
		"次。\n");
		if((int)me->query_temp("success") == (int)me->query_temp("teach") )
			me->set_temp("wonderful",1);
		me->delete_temp("teach");
		me->delete_temp("num");
		me->set_temp("over",1);
		me->delete_temp("busy");
		return 1;
	}
	message_vision("$N开始对着弟子讲解起来。\n",me);
	switch (random(4))
	{
		case 0:
			message_vision("$N拿起剑，挥舞起来，向弟子们示范剑法的要旨。\n",me);
			break;
		case 1:
			message_vision("$N向弟子们讲解吐呐打坐的要决。\n",me);
			break;
		case 2:
			message_vision("$N向弟子们讲解有关轻功的心的。\n",me);
			break;
		case 3:
			message_vision("$N向弟子们讲解有关掌法的心得。\n",me);
			break;
	}
	call_out("improve",8,me);
 	me->start_busy(8);
	return 1;
}
void improve(object who)
{

	object ob;
	int cost,i,n;
	i = random(100);
	n = 30+who->query("int")+who->query_skill("literate",1)/10;
	cost=40+(25-who->query("int"));

	who->add("sen",-cost);
	who->add("gin",-cost);
	who->add_temp("num",1);
	who->set_temp("busy",0);
	if(i < n) {
		tell_object(who,"\n弟子们点了点头，似乎对你的讲解略有所悟。\n");
		who->add_temp("success",1);
	}
	else
		tell_object(who,"\n弟子们一个个睁大了眼睛望着你，似乎不知道你在讲些什么。\n");
}