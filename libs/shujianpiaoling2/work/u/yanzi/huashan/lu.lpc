// Room: /u/yanzi/huashan/lu.c

inherit ROOM;

void create() {
  set("short", "[1;36m炼丹宫[2;37;0m");
  set("long", @LONG
这里传说乃是太上老君在华山落脚时炼丹的所在，直至今日，尚
能够在屋中看到那个巨大的炼丹炉(lu)，至于还有没有仙丹，就不得
而知了。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "jintian",
  ]));
  set("outdoors", "huashan");
  set("item_desc", ([ /* sizeof() == 1 */
    "lu": "一个巨大的炼丹炉，炉火已熄，炉中不知还有没有东西。
",
  ]));
  set("no_clean_up", 0);
  set("pill_count", 2);
  setup();

}
void init() {
  add_action("do_get", "get");
}
int do_get(string arg) {
  string from;
  object obj;
  if (!arg) return 0;
  if (this_player()->is_busy()) return 0;
  if (query("pill_count") < 1)
    return notify_fail("炉里没有任何东西。\n");
  if (sscanf(arg, "%s from %s", arg, from) == 2) {
    if (from == "炼丹炉" || from == "lu") {
      if (arg == "丹丸" || arg == "pill") {
        obj = new(__DIR__ "obj/pill");
        obj->move(this_player());
        message_vision("$N从炼丹炉中拿出一粒丹丸。\n", this_player());
        add("pill_count", -1);
        return 1;
      }
    }
  }
  return 0;
}
