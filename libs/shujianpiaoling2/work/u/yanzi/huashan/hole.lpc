// Room: /u/yanzi/huashan/hole.c

inherit ROOM;
#include <ansi.h>
string msg = "墙上刻着不少字，似乎是剑决：\n"
  "	归妹趋无妄，无妄趋同人，同人趋大有。\n"
  "	甲转丙，丙转庚，庚转癸。\n"
  "	子丑之交，辰巳之交，午未之交。\n"
  "	风雷是一变，山泽是一变，水火是一变。\n"
  "	乾坤相激，震兑相激，离巽相激。\n"
  "	三增而成五，五增而成九…\n";

void create() {
  set("short", HIC "山洞" NOR);
  set("long", @LONG
一个瀑布后的山洞，两侧墙壁上用剑刻着许多字。地上放着块石
头，甚是光滑，想是被人坐了很长的时间。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "pubu",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "wall": msg,
  ]));

  setup();
}
void init() {
  add_action("do_mianbi", "mianbi");
  add_action("do_go", "go");
}
int do_go(string arg) {
  object me = this_player();
  if (arg == "out") {
    me->move(__DIR__ "pubu");
    message("vision", "$N突然从瀑布后一跃而出。\n", environment(me), me);
    return 1;
  } else return 0;
}
int do_mianbi() {
  object me;
  int sk;
  me = this_player();
  sk = (int)me->query_skill("dg9-sword", 1);
  if (me->query("class") != "huashan-sword")
    return notify_fail("你不是华山剑宗弟子。\n");
  if (sk >= 150)
    return notify_fail("你已经领悟了独孤九剑的精髓“无招胜有招”！\n");
  if (sk != 149)
    return notify_fail("以你现在的所学，还无法悟得“无招胜有招”\n");
  message_vision("$N开始盘腿坐下，企图参透剑法的最高奥义。\n", me);
  me->apply_condition("huashan_wujian", 30);
  return 1;
}
