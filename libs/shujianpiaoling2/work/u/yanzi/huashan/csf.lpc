// Room: /u/yanzi/huashan/csf.c

inherit ROOM;

void create()
{
	set("short", "[1;36m藏书房[2;37;0m");
	set("long", @LONG
一间很大的书房，靠墙立着一个大书架，上面放着不少华山派历
代所藏武功秘籍，主要供新入门的弟子学习。华山弟子可以在这里参
阅本派武功。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "northwest" : __DIR__"xiuxi1",
  "west" : __DIR__"xiuxi2",
]));

	set("objects", ([ /* sizeof() == 1 */
 	 __DIR__"obj/shelf2" : 1,
	 __DIR__"npc/fang" : 1,
  __DIR__"npc/dizi-1" : 1,
]));
	set("no_clean_up", 0);

	setup();

}
void init()
{
        add_action("do_get", "get");
}

int do_get(string arg)
{
	string	obj, from;
	object	me, shelf, target, taro;
	me = this_player();

	if(sscanf(arg, "%s from %s", obj, from)==2 ) {
		if(obj == "all" && present("fang jingyuan",environment(me)) ) {
			message_vision("方敬渊一把拦住$N：你把书拿光了，其他人读什么？\n",me);
			return 1;
		}
		if(present("strike-book",me) || present("force-book", me)
		|| present("sword-book", me) || present("zhengqi-jue1",me)) {
			if(present("fang jingyuan",environment(me))) {
			message_vision("方敬渊一把拦住$N，你已经拿过本书了，别再拿了。\n",me);
			return 1;
			}
			else return 0;
		}
	}
	return 0;
}
void reset()
{
        object  *inv;
        object con, item;
        int i;

        ::reset();
        con = present("book shelf", this_object());
        inv = all_inventory(con);
        if( sizeof(inv) != 8) {
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new(__DIR__"obj/zhqj-book1");
                item->move(con);
		item = new(__DIR__"obj/hsjf-book");
                item->move(con);
		item = new(__DIR__"obj/hsxf-book");
                item->move(con);
		item = new(__DIR__"obj/strike-book");
		item->move(con);
	}
}
