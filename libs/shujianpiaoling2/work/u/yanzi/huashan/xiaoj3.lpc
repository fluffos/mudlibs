// Room: /u/yanzi/huashan/xiaoj3.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIC"小径"NOR);
	set("long", @LONG
走出竹林，是一条十分的幽静地碎石小径，不时有蝴蝶从西面飞
来，东面则是一大片小屋，想是华山弟子们起居休息的地方。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"huayuan",
  "east" : __DIR__"xiuxi1",
  "south" : __DIR__"xiaoj4",
  "north" : __DIR__"zlxj2",
]));

	setup();
}
void init()
{
	add_action("do_go","go");
}
int do_go(string arg)
{
	object me = this_player();
	if(arg == "south" && me->query_temp("teach")) {
		me->move(__DIR__"guangchang");
                message("vision","$N走了过来。\n",environment(me),me);
	return 1;
	}
	else
	return 0;
}
