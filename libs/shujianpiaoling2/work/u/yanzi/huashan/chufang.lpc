// Room: /u/yanzi/huashan/chufang.c

inherit ROOM;

void create()
{
	set("short", "[1;36m厨房[2;37;0m");
	set("long", @LONG
这里是一间挺宽敞的厨房，南边是烧菜煮饭的大灶，东边放着许
许多多的锅碗瓢盆，西面是放干柴的柴房，一个四十几岁的大嫂正在
忙碌着为华山弟子准备饭菜。
LONG
	);
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/gusao" : 1,
]));
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"caifang",
  "north" : __DIR__"fanting",
]));
	set("no_clean_up", 0);

	setup();

}
void init()
{
	add_action("do_work", "work");
}
int do_work()
{
	object me;
	int cost;
	me = this_player();
	cost=40+(25-me->query("int"));

	if(me->query_temp("over"))
		return notify_fail("你已经完工了，快复命去吧。\n");
	if(!me->query_temp("cook"))
		return notify_fail("顾嫂笑了笑：我这里不缺人手。\n");
	if(me->query_temp("busy"))
		return notify_fail("你正忙着呢。\n");
	if(me->query("sen")<cost  || me->query("gin")<cost)
		return notify_fail("你够累的了，休息一下吧!\n");
	
	me->set_temp("busy",1);
	if(me->query_temp("num")==me->query_temp("cook")){
		tell_object(me,"顾嫂拍了拍你的头说道：“不错不错，今天就干到这吧。”\n");
		message_vision("$N擦了擦额头的汗水，收工了。\n",me);
		tell_object(me,"你在" + chinese_number((int)me->query_temp("cook")) +
		"次任务中总共成功完成" + chinese_number((int)me->query_temp("success")) +
		"次。\n");
		if((int)me->query_temp("success") == (int)me->query_temp("cook") )
			me->set_temp("wonderful",1);
		me->delete_temp("cook");
		me->delete_temp("num");
		me->set_temp("over",1);
		me->delete_temp("busy");
		return 1;
	}
	message_vision("$N开始忙碌地干起活来。\n",me);
	switch (random(5))
	{
		case 0:
			message_vision("$N帮着顾嫂在切菜。\n",me);
			break;
		case 1:
			message_vision("$N趴在炉子旁，拿着扇子给炉子扇火。\n",me);
			break;
		case 2:
			message_vision("$N嗨呀嗨呀地在擦锅碗瓢盆。\n",me);
			break;
		case 3:
			message_vision("$N帮着顾嫂把青菜萝卜等放进水里冲洗。\n",me);
			break;
		case 4:
			message_vision("$N拿着把巨大的铲子在嘿呦嘿呦地炒菜。\n",me);
			break;
	}
	call_out("improve",1,me);
 	me->start_busy(1);
	return 1;
}
void improve(object who)
{

	object ob;
	int cost,i,n;
	cost=40+(25-who->query("int"));
	i = random(99);
	n = 30+who->query("int")+who->query_skill("unarmed",1)/10;
	cost=40+(25-who->query("int"));

	who->add("sen",-cost);
	who->add("gin",-cost);

	who->add_temp("num",1);
	who->set_temp("busy",0);
	if(i < n) {
		tell_object(who,"\n你这次的活干得相当不错。\n");
		who->add_temp("success",1);
	}
	else
		tell_object(who,"\n你这次的表现似乎不太好啊。\n");
}