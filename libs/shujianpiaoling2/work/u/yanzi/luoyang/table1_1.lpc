// Room: /u/yanzi/luoyang/table1_1.c

inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "一号桌");
        set("long", @LONG
一张在任何一家酒楼都能看到的很普通的木桌，用来放酒菜，给
客人吃饭喝酒之用。你可以用sit(方向)来坐下，order来叫店小二给
你点菜，当然，你也可以用look(table 1-5,dating)来看看其他桌子
及大厅的情况。用look  seat来察看现在桌子上的座位情况。如果你
觉得饱了，可以用leave 来离开座位，再回到大厅。
LONG
        );
        set("no_clean_up", 0);
        set("exits", ([ /* sizeof() == 1 */
  "out" : __DIR__"yanziback",
]));
        set("east_player","无人");
        set("south_player","无人");
        set("west_player","无人");
        set("north_player","无人");
        set("no_fight",1);
        set("no_magic",1);
        set("no_study",1);

        setup();
}
void init()
{
        add_action("do_sit", "sit");
        add_action("do_order", "order");
        add_action("do_look", "look");
        add_action("do_leave", "leave");
        add_action("do_out", "out");
}
int do_look(string arg)
{
        object me,room,*player,*food;
        int i;
        string msg,f_name;
        me = this_player();
        if(!arg)
                return 0;
        switch (arg)
        {
                case "seat_state":
                        tell_object(me,
                        "                     "HIW+query("north_player")+NOR"\n"+
                        "                     (北)\n"+
                        "\n\n"+
                        "          "HIY+query("west_player")+NOR"(西)           "
                        +"(东)"HIR+query("east_player")+NOR"\n"+
                        "\n\n"+
                        "                    (南)\n"+
                        "                     "HIM+query("south_player")+NOR"\n");
                        return 1;
                        break;
                case "food_state":
                        food = all_inventory(environment(me));
                        tell_object(me,"桌上的菜共有：\n");
                        for(i=0; i<sizeof(food); i++) {
                                if(food[i]->query("owner") != me->query("name")) continue;
                        f_name = food[i]->query("name");
                        tell_object(me,f_name+"\n");
                        }
                        return 1;
                        break;
                case "table 1":
                case "1":
                        room = find_object("/u/yanzi/luoyang/table1_1");
                        break;
                case "table 2":
                case "2":
                        room = find_object("/u/yanzi/luoyang/table1_2");
                        break;
                case "table 3":
                case "3":
                        room = find_object("/u/yanzi/luoyang/table1_3");
                        break;
                case "table 4":
                case "4":
                        room = find_object("/u/yanzi/luoyang/table1_4");
                        break;
                case "table 5":
                case "5":
                        room = find_object("/u/yanzi/luoyang/table1_5");
                        break;
                case "dating":
                        room = find_object("/u/yanzi/luoyang/yanziback");
                        break;
                default:
                        return 0;
        }
        if(arg == "dating" )
                msg = "大厅";
        else
                msg = "其他的桌子";
        player = all_inventory(room);
        message_vision("$N向着" + msg + "张望着。\n",this_player());
        "/cmds/std/look"->look_room(this_player(), room);
        for(i=0; i<sizeof(player); i++) {
                if( !living(player[i]) || player[i]==this_player() ) continue;
                tell_object(player[i],"你觉得似乎有人正盯着你这里看。\n");
        }
        return 1;
}
int do_sit(string arg)
{
        object me = this_player();
        if(!arg)
                return notify_fail("你要坐哪里？(东、南、西、北)\n");
        if(me->query_temp("sit_place"))
                return notify_fail("你已经坐下了，要挪位置的话请先离开(leave)现在的位子。\n");
        switch(arg)
        {
                case "east":
                case "东":
                        if(query("east"))
                                return notify_fail("对不起，那里已经有人坐了，挪个位置吧。\n");
                        set("east",1);
                        message_vision("$N在东面的一张位子上坐下。\n",me);
                        set("east_player",me->query("name"));
                        me->set_temp("sit_place","east");
                        break;
                case "south":
                case "南":
                        if(query("south"))
                                return notify_fail("对不起，那里已经有人坐了，挪个位置吧。\n");
                        set("south",1);
                        message_vision("$N在南面的一张位子上坐下。\n",me);
                        set("south_player",me->query("name"));
                        me->set_temp("sit_place","south");
                        break;
                case "west":
                case "西":
                        if(query("west"))
                                return notify_fail("对不起，那里已经有人坐了，挪个位置吧。\n");
                        set("west",1);
                        message_vision("$N在西面的一张位子上坐下。\n",me);
                        set("west_player",me->query("name"));
                        me->set_temp("sit_place","west");
                        break;
                case "north":
                case "北":
                        if(query("north"))
                                return notify_fail("对不起，那里已经有人坐了，挪个位置吧。\n");
                        set("north",1);
                        message_vision("$N在北面的一张位子上坐下。\n",me);
                        set("north_player",me->query("name"));
                        me->set_temp("sit_place","north");
                        break;
                default:
                        return notify_fail("你只能坐在(东、南、西、北)中的一个。\n");
        }
        return 1;
}
int do_leave()
{
        object me;
        string where,place;
        me = this_player();
        where = me->query_temp("sit_place");
        if(!where)
                return notify_fail("你并没有坐着。\n");
        switch(where)
        {
                case "east":
                        place = "东";
                        set("east",0);
                        set("east_player","无人");
                        break;
                case "south":
                        place = "南";
                        set("south",0);
                        set("south_player","无人");
                        break;
                case "west":
                        place = "西";
                        set("west",0);
                        set("west_player","无人");
                        break;
                case "north":
                        place = "北";
                        set("north",0);
                        set("north_player","无人");
                        break;
        }
        me->delete_temp("sit_place");
        message_vision("$N起身离开"+place+"面的位子，站了起来。\n",me);
        return 1;
}
int do_order()
{
        object me,obj,man;
        me = this_player();
        if(!me->query_temp("sit_place"))
                return notify_fail("请先坐下来再叫小二。\n");
        if(present("xiao er",environment(me)))
                return notify_fail("咦？小二不就在这里吗？\n");
        message_vision("$N大声叫道：小二小二，来这里！\n");
        man = new(__DIR__"npc/xiaoer");
        man->move(environment(me));
        message_vision("一个二十几岁的小二跑了过来，对$N说道：客官要吃饭吧，请点菜。\n",me);
        obj = new(__DIR__"food/caipu");
        obj->move(me);
        message_vision("小二给了$N一本$n。",me,obj);
        return 1;
}
int do_out(string arg)
{
        if(this_player()->query_temp("sit_place") ){
                tell_object(this_player(),"你正坐着，要走总得先离开座位。\n");
                return 1;
        }
        if(this_player()->query_temp("marks/luoyang/no_pay")) {
                tell_object(this_player(),"请先结账再走。\n");
                return 1;
        }
        else return 0;
}
