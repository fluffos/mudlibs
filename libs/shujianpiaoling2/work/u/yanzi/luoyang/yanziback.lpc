// Room: /u/yanzi/luoyang/yanziback.c

inherit ROOM;
#include <ansi.h>;

void create()
{
        set("short", "燕归来");
        set("long", @LONG
这里是洛阳城最大的一座酒楼，正中挂着一块大牌匾。
    这里是一楼大厅，客人们都在这里喝喝茶，吃些粗茶淡饭，东西
也都十分便宜。西首是专门外卖各类食物的。正中一个楼梯通往二楼
雅座，那里有上好的美酒佳肴，但价格也不是常人所能承受的。
    这里一溜烟地放着五张桌子。
LONG
        );
        set("item_desc", ([ /* sizeof() == 1 */
        "牌匾" : CYN"                   燕归来\n"NOR,
        "桌子" : "很普通的木桌，供人吃饭之用，共有五张(table 1-5)\n",
]));
        set("no_fight", 1);
        set("no_study", 1);
        set("no_clean_up", 0);
        set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"sell",
]));
        set("no_magic", 1);

        setup();

}
void init()
{
        add_action("do_enter", "enter");
        add_action("do_look", "look");
}
int do_look(string arg)
{
        object room,*player;
        string msg;
        int i;
        if(!arg)
                return 0;
        switch (arg)
        {
                case "table 1":
                case "1":
                        room = find_object("/u/yanzi/luoyang/table1_1");
                        break;
                case "table 2":
                case "2":
                        room = find_object("/u/yanzi/luoyang/table1_2");
                        break;
                case "table 3":
                case "3":
                        room = find_object("/u/yanzi/luoyang/table1_3");
                        break;
                case "table 4":
                case "4":
                        room = find_object("/u/yanzi/luoyang/table1_4");
                        break;
                case "table 5":
                case "5":
                        room = find_object("/u/yanzi/luoyang/table1_5");
                        break;
                default:
                        return 0;
        }
        player = all_inventory(room);
        message_vision("$N向着大厅中的桌子张望着。\n",this_player());
        "/cmds/std/look"->look_room(this_player(), room);
        for(i=0; i<sizeof(player); i++) {
                if( !living(player[i])) continue;
                tell_object(player[i],"你觉得似乎有人正盯着你这里看。\n");
        }
        return 1;
}
int do_enter(string arg)
{
        object room,me,*player;
        me = this_player();
        if(!arg)
                return 0;
        switch (arg)
        {
                case "table 1":
                case "1":
                        room = load_object("/u/yanzi/luoyang/table1_1");
                        break;
                case "table 2":
                case "2":
                        room = load_object("/u/yanzi/luoyang/table1_2");
                        break;
                case "table 3":
                case "3":
                        room = load_object("/u/yanzi/luoyang/table1_3");
                        break;
                case "table 4":
                case "4":
                        room = load_object("/u/yanzi/luoyang/table1_4");
                        break;
                case "table 5":
                case "5":
                        room = load_object("/u/yanzi/luoyang/table1_5");
                        break;
                default:
                        return notify_fail("你要去哪张桌子？(1-5)\n");
        }
        player = all_inventory(room);
        if(sizeof(player) >= 4) 
                return notify_fail("那里已经坐满四个人了。\n");
        message_vision("$N向一张桌子走去。\n",me);
        me->move(room);
        return 1;
}

