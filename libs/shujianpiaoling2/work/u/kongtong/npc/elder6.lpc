// elder6.c

inherit NPC;

void create()
{
	set_name("陈坚石", ({ "chen jenxi", "chen", "jenxi" }) );
	set("title", "达天阁六弟子");
	set("gender", "男性");
	set("age", 37);
	set("long",
		"陈大侠本来的名字已经没有人知道了，但是他的横练功夫「石猿功」成名\n"
		"近十年，加上个性有点....那个....顽固，因此达天阁执法使金振宇给他\n"
		"起了个绰号叫「坚石」，久而久之陈大侠倒也挺喜欢这个名字，索性舍弃\n"
		"了原来的名字改名叫陈坚石。\n");

	set("attitude", "peaceful");
	set("combat_exp", 360000);
	set("score", 75000);

	set("str", 65);
	set("cor", 23);
	set("cps", 23);
	set("con", 27);

	set("force", 1700);
	set("max_force", 1700);
	set("force_factor", 5);

	set_temp("apply/armor", 100);

	set_skill("unarmed", 100);
	set_skill("staff", 100);
	set_skill("force", 90);
	set_skill("parry", 90);
	set_skill("dodge", 90);
	set_skill("literate", 90);
	set_skill("jzxj-force", 90);
	set_skill("five-spin", 90);
	set_skill("move", 100);

	map_skill("force", "jzxj-force");
	map_skill("dodge", "five-spin");
	map_skill("move", "five-spin");

	setup();

	carry_object("/u/kongtong/obj/iron_staff")->wield();
}
