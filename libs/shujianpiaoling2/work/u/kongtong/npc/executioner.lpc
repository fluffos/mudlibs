// executioner.c

#include <ansi.h>

inherit NPC;
int learn_unarmed();

void create() {
  set_name("金振宇", ({ "jin zhenyu", "jin" }));
  set("title", "达天阁执法使");
  set("nickname", CYN "七绝剑" NOR);
  set("gender", "男性");
  set("age", 28);
  set("attitude", "friendly");
  set("combat_exp", 2500000);
  set("score", 20000);

  set("str", 60);
  set("int", 30);
  set("cor", 30);
  set("cps", 30);
  set("con", 30);
  set("class", "kongtong");

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("inquiry", ([
    "拜师": (: learn_unarmed :),
    "学艺": (: learn_unarmed :),
    "掌法": (: learn_unarmed :),
  ]));

  set_skill("unarmed", 150);
  set_skill("sword", 150);
  //	set_skill("throwing", 150);
  set_skill("force", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("literate", 150);
  //	set_skill("perception",150);
  set_skill("qxxl-sword", 150);
  set_skill("jzxj-force", 150);
  set_skill("five-spin", 150);

  map_skill("sword", "qxxl-sword");
  map_skill("parry", "qxxl-sword");
  map_skill("force", "jzxj-force");
  map_skill("dodge", "five-spin");
  map_skill("move", "five-spin");
  create_family("崆峒派", 7, "弟子");
  setup();

  carry_object("/obj/longsword")->wield();
}
int learn_unarmed() {
  object me;
  object book;
  me = this_player();
  if (me->query("class") != "kongtong") {
    command("say 你非本门弟子，竟敢妄想学本派武功？\n");
    return 1;
  }
  if ((int)me->query_skill("jzxj-force", 1) < 50) {
    command("say 你本门内功心法还不够，学不了棋经剑掌。\n");
    return 1;
  }

  else {
    say(CYN "金振宇说道：这本书是当年南棋北斗两位前辈留下的掌法秘籍，你拿去参详参祥吧。\n" NOR);
    book = new(__DIR__ "obj/qijing_book");
    book->move(me);
    return 1;
  }
  return 0;
}
