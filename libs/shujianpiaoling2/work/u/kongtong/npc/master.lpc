// shiao.c
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
        set_name("金振南", ({ "jin zhennan", "jin" }) );
	set("nickname", HIB"七修剑"NOR);
	set("gender", "男性");
	set("age", 24);
	set("attitude", "peaceful");
//        set("title", "达天阁传功使");

	set("str", 66);
	set("cor", 30);
	set("int", 24);
	set("cps", 30);
        set("class", "kongtong");

	set("force", 4000);
	set("max_force", 2400);
	set("force_factor", 30);

	set("combat_exp", 3000000);
	set("score", 20000);
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: consider :),
	}) );

	set_skill("unarmed", 160);
	set_skill("sword", 160);
//	set_skill("throwing", 160);
	set_skill("force", 160);
	set_skill("parry", 160);
	set_skill("dodge", 160);
	set_skill("literate", 160);
//	set_skill("perception",160);
	set_skill("qxxl-sword", 160);
	set_skill("jzxj-force", 160);
	set_skill("five-spin", 160);
	set_skill("move", 170);

	map_skill("sword", "qxxl-sword");
	map_skill("parry", "qxxl-sword");
	map_skill("force", "jzxj-force");
	map_skill("dodge", "five-spin");
	map_skill("move", "five-spin");

	create_family("崆峒派", 7, "弟子");

	setup();

	carry_object("/obj/longsword");
/*
	carry_object(__DIR__"obj/icy_boot")->wear();
	carry_object(__DIR__"obj/icy_girth")->wear();
	carry_object(__DIR__"obj/icy_cloth")->wear();
	carry_object(__DIR__"obj/icy_ribbon")->wear();
*/
}

void init()
{
	add_action("do_swear", "swear");
}

void attempt_apprentice(object me)
{
	if( me->query_temp("pending/jzxj-force_swear") ) {
		command("say 多说无益，若不发誓恪守门规，便是跪著求我也没用。");
		return;
	} else {
		command("say 我崆峒派门规甚严，" + RANK_D->query_respect(me)
			+ "如果真的有心，且发个誓(swear)来。");
		me->set_temp("pending/jzxj-force_swear", 1);
	}
}

int do_swear(string arg)
{
	if( !this_player()->query_temp("pending/jzxj-force_swear") )
		return 0;
	if( !arg ) return notify_fail("你要发什麽誓？\n");
	this_player()->set_temp("pending/jzxj-force_swear", 0);
	message_vision("$N发誓道：" + arg + "\n", this_player());
	if( strsrch(arg, "守") >=0 && strsrch(arg, "门规") >=0 ) {
		command("smile");
		command("say 这就是了。\n");
		command("recruit " + this_player()->query("id"));
	        this_player()->set("class", "kongtong");
		this_player()->set("id_type", 1);
	} else {
		command("say 你发的是什麽鬼誓，别以为我没听到！");
	}
	return 1;
}

int recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		add("apprentice_availavble", -1);
}

void consider()
{
	int i, flag = 0;
	object *enemy;

	enemy = query_enemy() - ({ 0 });
	for(i=0; i<sizeof(enemy); i++) {
		if( !living(enemy[i]) ) continue;
		if( enemy[i]->query_temp("weapon") ) {
			flag++;
			if(	!query_temp("weapon") ) {
				command("say " + RANK_D->query_respect(enemy[i]) + "既然使兵刃，在下空手接招未免不敬。");
				command("wield sword");
				command("say 进招吧！");
				break;
			}
		}
	}
	if( !flag && query_temp("weapon") ) {
		if( sizeof(enemy) > 1 )
			command("say 嗯... 既然" + chinese_number(sizeof(enemy)) + "位都是空手，在下理当奉陪！");
		else
			command("say 既然" + RANK_D->query_respect(enemy[0]) + "不使兵刃，在下自然奉陪！\n");
		command("unwield sword");
	}
}
