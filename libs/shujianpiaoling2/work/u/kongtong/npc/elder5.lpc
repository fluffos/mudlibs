// elder5.c

inherit NPC;

void create()
{
	set_name("南危水", ({ "nan weishuey", "nan", "weishuey" }) );
	set("title", "达天阁五弟子");
	set("gender", "男性");
	set("age", 38);
	set("long",
		"南危水是当世使剑的名家，也是槐阳王的弟弟，一身武学集崆峒　封山\n"
		"两派之所长，在达天阁七弟子中武功仅次於执法使金振宇，南危水手中\n"
		"的焦殇剑也是一把罕见的利器，传说这把剑是名铸剑师黄炎炎生平六把\n"
		"名剑中排名第一的杰作。\n");

	set("attitude", "peaceful");
	set("combat_exp", 800000);
	set("score", 120000);

	set("str", 65);
	set("cor", 30);
	set("cps", 30);
	set("con", 27);

	set("force", 1800);
	set("max_force", 1800);
	set("force_factor", 3);

	set_skill("unarmed", 100);
	set_skill("sword", 90);
//	set_skill("throwing", 90);
	set_skill("force", 90);
	set_skill("parry", 90);
	set_skill("dodge", 90);
	set_skill("literate", 90);
//	set_skill("perception",90);
	set_skill("qxxl-sword", 90);
	set_skill("jzxj-force", 90);
	set_skill("five-spin", 90);
	set_skill("move", 100);

	map_skill("sword", "qxxl-sword");
	map_skill("parry", "qxxl-sword");
	map_skill("force", "jzxj-force");
	map_skill("dodge", "five-spin");
	map_skill("move", "five-spin");
	setup();

	carry_object(__DIR__"obj/sorrowfire")->wield();
	carry_object("/obj/cloth")->wear();
	add_money("silver", 30);
}
