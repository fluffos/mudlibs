// waiter.c
inherit NEW_VENDOR;

int on_service = 0;

void create()
{
	set_name("小贩", ({ "xiao fan", "fan" }) );

	set("age", 26);
	set("long",
		"一个约二十出头的年轻小贩，经常担货上山卖。\n");
	set("merchandise", ([
		"/obj/food/baozi"   : 50,
		"/obj/food/jiudai"  : 20,
		"/obj/food/shuihu"  : 50,
		__DIR__"obj/rflower" : 50,
	]));

	setup();
}

void init()
{
	::init();
	add_action("do_vendor_list", "list");
	add_action("do_buy", "buy");
}

