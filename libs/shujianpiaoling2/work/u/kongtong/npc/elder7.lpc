// watcher.c

inherit NPC;

void create()
{
	set_name("颜违", ({ "yen wei", "yen", "wei" }) );
	set("title", "达天阁七弟子");
	set("gender", "男性");
	set("age", 23);
	set("long",
		"颜违是达天阁七位弟子中最年轻的，虽然他的武功跟其他六位弟子\n"
		"相比仍略逊一筹，但是他办事十分精明干练，因此七弟子每年都派\n"
		"他出外办理武林大会事宜。\n");

	set("attitude", "peaceful");
	set("combat_exp", 270000);
	set("score", 36000);

	set("str", 55);
	set("cor", 23);
	set("cps", 23);
	set("con", 27);

	set("force", 1700);
	set("max_force", 1700);
	set("force_factor", 5);

	set_skill("unarmed", 120);
	set_skill("sword", 19);
	set_skill("force", 19);
	set_skill("parry", 19);
	set_skill("dodge", 19);
	set_skill("literate", 19);
	set_skill("jzxj-force", 19);
	set_skill("five-spin", 19);
	set_skill("move", 120);

	map_skill("force", "jzxj-force");
	map_skill("dodge", "five-spin");
	map_skill("move", "five-spin");
	setup();
}
