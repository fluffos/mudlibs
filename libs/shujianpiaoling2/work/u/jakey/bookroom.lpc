inherit ROOM;

void create()
{
	set("short", "成斌书房");
	set("long", @LONG
这里是成斌自己的书房，外人是不能进去的。屋子里靠窗摆
放着一张大黑书桌，黑色的桌岸上摆放着几本书，笔架上搁着几
只毛笔。在窗户上挂着一串风铃，可能是成斌的女儿送的吧。在
桌子旁边摆着一个靠椅，上面刻着花纹。在书桌左方摆放着两个
书架，架子上整整齐齐的摆着书。在书桌右边摆放着一个小方桌
和两把椅子。方桌上摆着一盆水仙。在靠着方桌的墙上挂着李思
训的“长江绝岛图”。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"west" : __DIR__"houyuan",
	]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_move","move");
}

int do_move(string arg)
{
	string name;
	name=(string)this_player()->query("name");
	if (arg!="长江绝岛图") return 0;
	write("你把墙上的“长江绝岛图”移开，发现图后有一个拉环。\n");
	if (this_player()->query("max_force")<1000) return notify_fail("你拉了一下拉环，什么也没有发生。\n");
	write("你拉了一下拉环，身边无声无息的开了一扇暗门。\n你犹豫了一下，钻了进去。\n");
	this_player()->move(__DIR__"xiaodao");
	tell_room("/u/jakey/bookroom",name+"不知在哪里摸了一下，一闪身就不见了。\n");
	return 1;
}
