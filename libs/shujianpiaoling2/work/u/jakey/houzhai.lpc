inherit ROOM;

void create() {
  set("short", "后宅大门");
  set("long", @LONG
后面就是落月山庄庄主家眷住的地方，从门口可以看到小姐
的闺阁。听说小姐病了很长时间了，庄主夫人为了照顾小姐已经
搬到这里来住了。两位落月山庄护法守在这里。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "northeast": __DIR__ "garden",
    "southwest": __DIR__ "xyuan1",
  ]));
  set("objects", ([
    __DIR__ "npc/hufa1": 1,
    __DIR__ "npc/hufa2": 1,
  ]));
  set("no_clean_up", 0);
  set("no_fight", "1");
  set("no_spells", "1");
  set("no_magic", "1");
  set("outdoors", "jakey");
  setup();
}

int valid_leave(object me, string dir) {
  object hufa;
  hufa = present("yu hufa", environment(me));
  if (dir == "northeast")
    if (objectp(hufa))
      if (!me->query_temp("治病"))
        return notify_fail("余护法伸手拦住你，说道：“里面是庄主的内宅，你不能进去。\n");
  me->delete_temp("治病");
  return 1;
}
