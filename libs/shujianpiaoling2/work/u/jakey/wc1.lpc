inherit ROOM;

void create()
{
	set("short", "粪坑");
	set("long", @LONG
这里是个大粪坑，你半截身子站在粪水中，四旁的坑壁上布
满了秽物，臭气熏天。真想不通你在这里还留恋什么。
LONG
	);
//	set("exits",([
//	]));
	set("objects", ([ /* sizeof() == 2 */
	__DIR__"npc/maggot" : 2,
	]));
	set("no_clean_up", 0);       
	setup();
}

void init()
{
	add_action("do_climb","climb");
}

int do_climb(string arg)
{
	if (arg=="坑壁") {
		message_vision("$N往上一跳，扒住了坑沿，慢慢爬了上去。\n",this_player());
		this_player()->move(__DIR__"wc");
		message_vision("$N从粪坑里爬了出来。\n",this_player());
		return 1;}
	else return 0;
}
