#include <mudlib.h>
#include <ansi.h>
#include <command.h>
#include <globals.h>

inherit ROOM;

void create() {
  set("short", "鬼屋");
  set("long", @LONG
这里是个充满魔法的屋子。里面摆着一个大镜子（mirror），
，镜子变的如水般的流动。在这里你可以看到你想看的人。
LONG
  );
  set("exits", ([ /* sizeof() == x */
    "down": __DIR__ "feng3",
  ]));
  set("no_clean_up", 0);
  set("item_desc", ([
    "mirror": "这是个大大的镜子你可以使用(zhi sb)查找某人在哪里。\n"
    "不过，你首先要确定对方是不是在游戏中。\n",
  ]));
  setup();
}

void init() {
  object ob;
  add_action("whereis", "zhi");
}

int whereis(string arg) {
  object where, me;
  object *ob;
  string msg;
  int i;

  me = this_player();
  if (arg) {
    where = environment(find_player(arg));
    if (!where) return notify_fail("什么？\n");
    msg = where->query("short");

  } else {
    ob = users();
    msg = "";

    for (i = 0; i < sizeof(ob); i++) {
      where = environment(ob[i]);
      if (!ob) return 0;
      if (!where)
        msg = sprintf("%s%14s(%10s) \n",
          msg, ob[i]->query("name"), ob[i]->query("id"),
          query_ip_name(ob[i]),
          "镜子说：“什么玩意？！\n");
      else
        msg = sprintf("%s%14s(%10s) \n",
          msg, ob[i]->query("name"), ob[i]->query("id"),
          query_ip_name(ob[i]),
          file_name(where));
    }
  }
  write("镜子说道：“你要找的人在" + msg + "。\n");
  return 1;
}
