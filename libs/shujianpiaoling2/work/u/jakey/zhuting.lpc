inherit ROOM;

void create()
{
	set("short", "卧龙厅");
	set("long", @LONG
这是落月山庄的大厅，庄主就是在这里会见来访的客人的。
红漆大柱上镶嵌着金色的花纹。厅的两边摆放着几副上好的檀木
桌椅，地面上铺着光洁的花岗岩地板，显得很气派。不过最引人
注目的还要算厅后面放的一个雕刻着百鸟朝凤的巨大玉屏。现在
这里有两个仆人在侯客。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"north" : __DIR__"hspath",
	"south" : __DIR__"qianyuan",
	]));
	set("objects", ([ 
	__DIR__"npc/afu" : 1,
	__DIR__"npc/alu" : 1,
	]));
	set("no_clean_up", 0);
	set("valid_startroom",1);

	setup();
	replace_program(ROOM);
}
