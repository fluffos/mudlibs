inherit ROOM;

void create()
{
	set("short", "窗外");
	set("long", @LONG
这里是古塔的第五层的窗外，你踏着青色的瓦，靠着青色的
塔砖，看着青色的松林，心中一阵心旷神怡。上面是蓝蓝的天，
塔顶的青瓦在天色之下显得格外的古朴。一扇石窗对着你的脸。
LONG
	);
	set("exits", ([ /* sizeof() == x */
	"down" : __DIR__"tower6",
	]));
	set("no_clean_up", 0);       
	set("outdoors", "jakey");
	setup();
}

void init()
{
	add_action("do_climb","climb");
}

int do_climb(string arg)
{
	if (arg=="石窗") {
		message_vision("$N推开石窗，身子一矮，从石窗里钻了进去。\n",this_player());
		this_player()->move(__DIR__"tower8");
		return 1;}
	else return 0;
}
