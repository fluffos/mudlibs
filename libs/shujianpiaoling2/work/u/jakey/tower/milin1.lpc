inherit ROOM;

void create()
{
	set("short", "树林");
	set("long", @LONG
这是一片密林，到处都是有着粗大树干的松树，密密麻麻的
枝干将天空遮挡的严严实实，你在这里根本分不清东南西北。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
	"east" :	__DIR__"milin"+(random(4)+1),
	"south":	__DIR__"milin"+(random(4)+1),
	"west" :	__DIR__"milin"+(random(4)+1),
	"north":	__DIR__"milin"+(random(4)+1),
	]));
	set("no_clean_up", 0);       
	set("outdoors", "jakey");
	setup();
	set("item_desc", ([ /* sizeof()== 1 */
	"树干" : "在你面前有一棵树的树皮被刮掉了，上面刻着一个向东的箭头。\n",
	]));
} 

void right0(object me)
{
if ((int)me->query_temp("step")<15) me->add_temp("step",1);
}

void right1(object me)
{
if ((int)me->query_temp("step")>1) me->add_temp("step",-1);
}

void wrong0(object me)
{
if (((int)me->query_temp("step")-2)>0) me->add_temp("step",-2);
else if (((int)me->query_temp("step")-1)>0) me->add_temp("step",-1);
}

void wrong1(object me)
{
if (((int)me->query_temp("step")+2)<16) me->add_temp("step",2);
else if (((int)me->query_temp("step")+1)<16) me->add_temp("step",1);
}


int valid_leave(object me,string dir)
{
	if (!me->query("class","luoyue")) me->receive_damage("sen",10);
	
switch(dir) {

case "east" :	if (((int)me->query_temp("step")%3)==0)
			switch ((int)me->query_temp("join")) {
			case 0:	wrong0(me);return 1;
			case 1:	wrong1(me);return 1;}
		else
		 	switch ((int)me->query_temp("join")) {
			case 0:	right0(me);return 1;
			case 1:	right1(me);return 1;}

case "south":	if ((int)me->query_temp("step")==1) {me->move("/u/jakey/hspath3");return notify_fail("\n");}
		else {	if (((int)me->query_temp("step")%3)==0)
				switch ((int)me->query_temp("join")) {
				case 0: wrong0(me);return 1;
				case 1: right1(me);return 1;}
			else 
				switch ((int)me->query_temp("join")) {
				case 0: wrong0(me);return 1;
				case 1: if ((int)me->query_temp("step")==1) {me->move("/u/jakey/hspath3");return notify_fail("\n");}
					else {wrong1(me);return 1;}}}

case "west" :	switch ((int)me->query_temp("join")) {
		case 0:	wrong0(me);return 1;
		case 1:	wrong1(me);return 1;}


case "north":	if (((int)me->query_temp("step")%3)==0)
			switch ((int)me->query_temp("join")) {
			case 0: if ((int)me->query_temp("step")==15) {me->move("/u/jakey/tower/clxd");return notify_fail("\n");}
				else {if (((int)me->query_temp("step")+1)<16) me->add_temp("step",1);return 1;}
			case 1: if ((int)me->query_temp("step")==15) {me->move("/u/jakey/tower/clxd");return notify_fail("\n");}
				else {wrong1(me);return 1;}}
		else	switch ((int)me->query_temp("join")) {
			case 0:	wrong0(me);return 1;
			case 1:	wrong1(me);return 1;}
}
}

