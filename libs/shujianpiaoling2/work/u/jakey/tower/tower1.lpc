inherit ROOM;

void create() {
  set("short", "古塔前");
  set("long", @LONG
这里就是落月山庄建庄的时候修建的古塔。塔是八角形，
高五层。要是远远望去，塔隐没在树林中并不是很显露。这里
已经很久没人来了。塔门上的锁上已蒙上了一层厚厚的浮灰。
在塔前立着一块石碑，上面是三个楷体大字“摘星塔”。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "clxd",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "jakey");
  setup();
}

void init() {
  add_action("do_open", "open");
  add_action("do_close", "close");
}

int do_open(string arg) {
  if (arg != "lock" && arg != "door") return 0;
  if (arg == "lock") {
    if ((int)query("haveopenlocked") > 0) return notify_fail("锁已经打开的，你还想干什么？\n");
    if (!present("tower key", this_player())) return notify_fail("锁是锁住的，你没有钥匙，打不开！\n");
    message_vision("$N拿出古塔钥匙把锁打开了。\n", this_player());
    set("haveopenlocked", 1);
    return 1;
  }
  if ((int)query("haveopenlocked") == 0) return notify_fail("门是锁着的，你打不开。\n");
  if ((int)query("haveopendoored") > 0) return notify_fail("门已经打开的，还不赶快进去？\n");
  message_vision("$N伸手把门推开。\n", this_player());
  add("exits/enter", __DIR__ "tower2");
  __DIR__ "tower2"->add("exits/out", __DIR__ "tower1");
  tell_room(__DIR__ "tower2", "古塔的门被人打开了。\n");
  set("haveopendoored", 1);
  return 1;
}

int do_close(string arg) {
  if (arg != "door") return 0;
  if ((int)query("haveopendoored") == 0) return notify_fail("门是关着的。\n");
  message_vision("$N把门关上了。\n", this_player());
  __DIR__ "tower1"->delete("exits/enter", __DIR__ "tower2");
  __DIR__ "tower2"->delete("exits/out", __DIR__ "tower1");
  tell_room(__DIR__ "tower2", "古塔的门被人关上了。\n");
  set("haveopendoored", 0);
  return 1;
}
