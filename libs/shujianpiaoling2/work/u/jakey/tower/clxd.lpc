inherit ROOM;

void create()
{
	set("short", "丛林小道");
	set("long", @LONG
这里突然开朗起来，看来你已经走出了密林了。道路虽然狭
小且曲折，但是给人一种希望----往前走吧。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"north" : __DIR__"tower1",
	"south" : __DIR__"milin"+((random(2)*2)+1),
]));
	set("no_clean_up", 0);       
	set("outdoors", "jakey");
	setup();
}

int valid_leave(object me,string dir)
{
	if (dir=="south") {
	me->set_temp("step",14);
	me->set_temp("join",1);}
	return 1;
}
