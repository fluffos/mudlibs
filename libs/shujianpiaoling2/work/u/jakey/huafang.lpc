inherit ROOM;

void create()
{
	set("short", "花房");
	set("long", @LONG
这里是一个培养各种奇花异草的花房，因为贴着院墙修建的
，平时不注意的话也不会发觉的。有一个老仆正坐在房前慢慢的
修剪着一株硕大的红牡丹。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"west" : __DIR__"hspath1",
	]));
	set("objects",([
	__DIR__"npc/puren2" : 1,
	]));
	set("no_clean_up", 0);
        set("outdoors", "jakey");
	setup();
}

void init()
{
	add_action("do_wa","wa");
}

int do_wa(string arg)
{
	object me,ob,frog,puren;
	me=this_player();
	ob=present("tiechan",this_player());
	puren=present("laopu",environment(me));
	if (!ob) return notify_fail("你没有合适的工具用来挖掘。\n");
	if (arg!="红牡丹") return 0;
	if (query("waed")>0) return notify_fail("牡丹已经被挖开了，底部露出了一个大洞。\n");
	if (objectp(puren)) {write("老仆拦住你，说道：“你想干什么？”\n");return 1;}
	write("你用铁铲从牡丹跟部向下挖去，挖了几下，你发现牡丹下面原有一个洞。\n"
	      "这时，一只红色的蟾蜍从洞里跳了出来，鼓着两只眼睛瞪着你。\n");
	frog=new("/u/jakey/npc/frog");
	frog->move(__FILE__);
	add("waed",1);
	return 1;
}
