//boshi.c
inherit NEW_VENDOR;

void create()
{
 	 object ob;
	set_name("茶博士", ({ "boshi" }) );
	set("gender", "男性" );
	set("age", 22);
	set("long",
		"这位茶博士正笑咪咪地忙著。\n");
	set("combat_exp", 15);
	set("attitude", "friendly");
	set("rank_info/respect", "博士");
	set("merchandise",([
		"/u/jakey/sell/chaguan/longjing":20,
		"/u/jakey/sell/chaguan/guanyin"	:20,
		"/u/jakey/sell/chaguan/wulong"	:20,
		"/u/jakey/sell/chaguan/biluo"	:20,
	   ]));
	setup();

        ob = carry_object("/u/jakey/obj/baicloth1")->wear();
}

void init()
{       
        object ob;
        ::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
        add_action("do_buy", "buy");

}

void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
         say( "茶博士说道：这位" + RANK_D->query_respect(ob)
             + "，天这么热，来壶好茶吧。\n");
}

