inherit NPC;
 
void create()
{
        set_name("成小姐", ({ "cheng xiaojie","cheng","xiaojie" }) );
	set("title", "落月山庄" );
        set("gender", "女性" );
        set("age", 20);
        set("long", "    和她的母亲一样，天生一个美人胚子，虽然缺少成熟女性的妩媚\n"
		    "但是身上一股少女的气息。一双簇蛾眉，含情凤目，现在虽然满面病\n"				
		    "容仍掩不住迷人的姿色。\n"	
);
        set("combat_exp",5000 );
	set("attitude", "friendly");
        set_skill("unarmed",20);
        set_skill("dodge", 20);
        set_skill("force",20);        
        set("chat_chance",3);
        set("chat_msg",({
"成小姐哼道：“好难过呀。”\n",
"成小姐咳嗽了几声。\n",
"成小姐不舒服的动了动身子。\n",
}));     
        set("force", 40);
        set("max_force", 40);
        setup();
        carry_object("/u/jakey/obj/siqun")->wear();
//	carry_object("/u/jakey/obj/shouzhuo")->wear();
}

