inherit NPC;

void create() {
  set_name("石人", ({ "stone man", "stone", "man" }));
  set("gender", "男性");
  set("long", "一个面无表情的机关人，用石头做成。\n");
  set("age", 38);
  set("str", 32);
  set("cor", 30);
  set("cps", 20);
  set("con", 50);
  set("per", 27);
  set("int", 10);
  set("max_kee", 900);
  set("kee", 900);
  set("food", 500);
  set("water", 500);
  set("attitude", "peaceful");
  set("max_force", 800);
  set("force", 800);
  set("force_factor", 10);
  set_temp("apply/attack", 500);
  set_temp("apply/defense", 500);
  set("score", 200);
  set("daode", 100);
  set("combat_exp", 2000000);
  setup();
}


int accept_fight(object ob) {
  object weapon;
  string skill_type;
  int ob_attack, ob_dodge, ob_parry;
  if (environment()->query("short") != "机关房")
    return notify_fail("石人离开了机关房就不会动了。\n");

  if (this_object()->is_fighting())
    return notify_fail("石人不能同时和多人练功。\n");

  if (ob->query("combat_exp") > 1000000) {
    command("fear");
    command("say " + RANK_D->query_respect(ob) + "，你会把我打散架的。\n");
    return 0;
  }

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";

  ob_attack = ob->query_skill(skill_type, 0) + ob->query_temp("apply/attack");
  ob_dodge = ob->query_skill("dodge", 0) + ob->query_temp("apply/defense");
  ob_parry = ob->query_skill("parry", 0) + ob->query_temp("apply/defense");

  set("eff_kee", query("max_kee"));
  set("kee", query("max_kee"));
  set("max_force", ob->query("max_force"));
  set("force", ob->query("force"));
  set("combat_exp", ob->query("combat_exp") + 50);
  set_temp("apply/attack", ob_dodge + ob_dodge / 20 + 10);
  set_temp("apply/defense", ob_attack + ob_attack / 20 + 10);

  //	if( !ob->query("env/no_msg") ) {
  //	    write("系统暂时把你战斗信息关闭，打开战斗信息请用 msg 命令。\n");
  //	    ob->set("env/no_msg",1); }
  return 1;
}
