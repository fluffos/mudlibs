inherit NPC;
string ask_cheng();

void create() {
  set_name("野人", ({ "ye ren", "ren", "ye" }));
  set("gender", "男性");
  set("age", 35);
  set("str", 30);
  set("long", @long
一个又黑又壮的野人，头发零乱，正恶狠狠的看着你。
long
  );
  set("combat_exp", 1562500);
  set("attitude", "heroism");
  set("max_force", 3500);
  set("force", 3500);

  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("force", 210);
  set_skill("parry", 180);
  set_skill("sword", 200);
  set_skill("lunhui-sword", 250);
  set_skill("qingfeng-steps", 220);
  set_skill("luanyu-strike", 180);
  set_skill("xuanyue-force", 210);

  map_skill("dodge", "qingfeng-steps");
  map_skill("unarmed", "luanyu-strike");
  map_skill("parry", "lunhui-sword");
  map_skill("sword", "lunhui-sword");
  map_skill("force", "xuanyue-force");

  set("inquiry", ([
    "成少卓": (: ask_cheng :),
    "成斌": "成斌是家兄，可也就是他，弑父杀弟，丧尽天良！\n",
    "紫木牌": "紫木牌是庄主的象征，成斌虽然谋得庄主之位，他却\n"
    "没有拿到紫木牌。你要是想要，得替我清理门户，为了表示你的\n"
    "诚意，先去把山庄的陈护法杀了。\n",
  ]));

  setup();

  carry_object("/u/jakey/obj/changjian")->wield();

}

int recognize_apprentice(object ob) {
  if (ob->query("marks/lunhui-sword")) return 1;
  return 0;
}

string ask_cheng() {
  call_out("changename", 1, this_player());
  return "不错，我就是成少卓。七年前被成斌打下悬崖绝壁，
幸而未死，可我已是经脉受损，无法运用内力了。这可如何诛杀
成斌，清理门户呀。\n";
}

void changename() {
  object ob;
  ob = this_object();
  ob->set_name("成少卓", ({ "cheng shaozhuo", "cheng" }));
}

int accept_object(object me, object ob) {
  object token;
  if (this_object()->query("name") != "成少卓") return 0;
  if (!((string)ob->query("name") == "陈护法的尸体" &&
    (string)ob->query("id") == "corpse")) return 0;
  if (!this_player()->query_temp("marks/kill_chenhufa")) {
    command("sneer");
    command("say 这个陈护法的尸体是假的，给我滚！！！");
    return 0;
  }
  if (!((string)this_player()->query("class") == "luoyue")) {
    command("nod");
    command("say 不错，我暂时相信你，这是紫木牌，拿去吧。");
    token = new("/u/jakey/special/zimupai");
    token->move(me);
    token->set_temp("marks/real", 1);
    write("成少卓给了你一块木牌。\n");
    return 1;
  }

  command("nod");
  command("say 不错，我暂时相信你，这是紫木牌，拿去吧。
另外，我还可以传你一套轮回剑法(lunhui-sword)，是家父晚年才创
造的。威力不凡。");
  token = new("/u/jakey/special/zimupai");
  token->move(me);
  token->set_temp("marks/real", 1);
  write("成少卓给了你一块木牌。\n");
  me->set("marks/lunhui-sword", 1);
  return 1;
}
