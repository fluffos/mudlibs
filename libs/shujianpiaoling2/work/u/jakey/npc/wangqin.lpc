inherit NPC;
 
void create()
{
        set_name("王勤", ({ "xue qin","xue","qin"}) );
	set("title", "百变神医" );
        set("gender", "男性" );
        set("age", 75);
        set("long", "一个胡子都花白了的老头。\n");
        set("combat_exp", 500000);
	set("attitude", "friendly");
        set_skill("unarmed",170);
        set_skill("dodge", 170);      
        set_skill("parry",170);        
        set("chat_chance",3);
        set("chat_msg",({
"王老头呆呆的出神。\n",
"王老头骂道：“是哪个混蛋，竟然把我的宝贝给偷走了！\n",
}));
	set("inquiry", ([
	"百变神医" : "老夫精通易容之术，大家就给了个这么个外号。\n",
	"易容之术" : "做些面具，化化妆之类的功夫都是些粗浅的东西。\n",
	"宝贝" : "这。。。。这个。。。是很不一般的东西，不知道让谁给偷了。\n",
	"混蛋" : "是不是你这个家伙偷的？\n",
	"治病" : "要是治落月山庄小姐的病，那我可不行。\n",
	"人皮面具" : "那是老夫的绝活，不传。\n",
        "成斌" : "他是落月山庄的庄主，和我还有些交情。\n",
        "成少卓" : "他这个逆子，竟然杀父，还是成庄主仁义，不让张扬。\n",
        ]));
        setup();
	carry_object("/u/jakey/obj/greycloth")->wear();
	add_money("gold",7);
}

int accept_object(object me,object ob)
{
	if ((string)ob->query("name")!="破杂物") return 0;
	write("老头接过破杂物使劲的看了看。\n");
	command("ah");
	command("?");
	command("say 这是张人皮面具，怎么弄成这个样子？");
	command("say 这张人皮面具很像老夫的手法？");
	return 1;
}