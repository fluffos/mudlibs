inherit NPC;
 
void create()
{
        set_name("老者", ({ "lao zhe","laozhe","lao" }) );
        set("gender", "男性" );
        set("age", 66);
        set("long", 
	"一个清瘦的老者，但是两眼炯炯有神，穿着很平常的长衫，\n"
	"腰间按南方人的习惯挂有饰物。\n");
        set("combat_exp",200000);
	set("attitude", "heroism");
        set_skill("unarmed",100);
        set_skill("dodge", 100);
        set_skill("force",100);        
	set_skill("liuh-ken",100);
        map_skill("unarmed","liuh-ken");
        set("force", 2000);
        set("max_force", 2000);
        set("chat_chance",3);
        set("chat_msg",({
"老者闭目养了一会儿神。\n",
"老者信手在古筝上弹了首曲子。\n",
}));
	set("inquiry", ([
	"饰物" : "我身上挂的是一块铁牌，是镇上的一个樵夫送给我的。\n",
	"铁牌" : "这块铁牌很有意思，打成火焰形状，入手沉掂掂的，不知是什么打造的。\n"
		 "可惜这块铁牌不太好看，要能有一个更好的饰物就好了。\n",
	"火形铁牌" : "哦，你知道这块铁牌？原来名字是火形铁牌。\n",
	]));
        setup();
        carry_object("/u/jakey/obj/greycloth")->wear();
	carry_object("/u/jakey/obj/guzheng");
}

int accept_object(object me,object ob)
{
	object token;
	if (!((string)ob->query("name")=="玉佛牌" && 
	    (string)ob->query("id")=="yufo pai")) return 0;
	command("wa");
	command("say 真是太漂亮了，那好，这块铁牌就给你吧。");
	message_vision("老者给了$N一块铁牌。\n",me);
	token=new("/u/jakey/special/token");
	token->move(me);
	return 1;
}
