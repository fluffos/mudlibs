inherit NPC;
 
void create()
{
        set_name("大师傅", ({ "cook" }) );
	set("title", "落月山庄" );
        set("gender", "男性" );
        set("age", 45);
        set("long", "一个胖胖的大师傅，正笑眯眯的看着你。\n");
	set("chat_chance",4);
	set("chat_msg",({
	"大师傅自言自语到：好香的烤鸭呀。\n",
	}));
        set("combat_exp", 10000);
	set("attitude", "friendly");
        setup();
        carry_object("/u/jakey/obj/weiqun")->wear();
}

void init()
{       
        object ob;
        ::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }

}

void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
         say( "大师傅道：这位" + RANK_D->query_respect(ob)
             + "，饿了吗？快来吃饭吧。\n");
}
