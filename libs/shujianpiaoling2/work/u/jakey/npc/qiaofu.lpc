inherit NPC;
 
void create()
{
        set_name("樵夫", ({ "qiao fu","qiao" }) );
        set("gender", "男性" );
        set("age", 33);
        set("long", "一个农民打扮的樵夫一脸的惊恐不安。\n");
        set("combat_exp", 200);
	set("attitude", "friendly");
        set_skill("unarmed",5);
        set_skill("dodge", 5);
        set_skill("parry",5);        
        set("chat_chance",3);
        set("chat_msg",({
	"樵夫拍了拍胸口。\n",
	"樵夫喘了喘气。\n",
	"樵夫喃喃道：差点迷路，真是吓死我了。\n",
	}));

        set("inquiry",([
	"迷路 ": "那个老林子的牌子被弄乱了，差点出不来。\n",
	]));

        setup();
        carry_object("/u/jakey/obj/cloth")->wear();
}

