inherit NEW_VENDOR;
string ask_boss();
string ask_jiu();

void create() {
  object ob;
  set_name("小酒保", ({ "waiter" }));
  set("gender", "男性");
  set("age", 22);
  set("long",
    "这位小酒保正呆在酒柜前斜倚着休息。\n");
  set("combat_exp", 15);
  set("attitude", "friendly");
  set("rank_info/respect", "酒保");
  set("inquiry", ([
    "马老板": (: ask_boss :),
    "猴儿酒": (: ask_jiu :),
  ]));
  set("chat_chance", 3);
  set("chat_msg", ({
    "小酒保叹道：“啊，人可真少呀。真清闲呀。”\n",
    "小酒保琢磨着自己的心事。\n"
  }));
  set("merchandise", ([
    "/u/jakey/sell/jiudian/cuipiya": 20,
    "/u/jakey/sell/jiudian/jitui": 20,
    "/u/jakey/sell/jiudian/shaoji": 20,
    "/u/jakey/sell/jiudian/shuihu": 20,
    "/u/jakey/sell/jiudian/baijiu": 20,
    "/u/jakey/sell/jiudian/huangjiu": 20,
    "/u/jakey/sell/jiudian/dukang": 20,
    "/u/jakey/sell/jiudian/nverred": 20,
    "/u/jakey/sell/jiudian/zhuye": 20,
  ]));
  setup();
  ob = carry_object("/u/jakey/obj/baicloth1")->wear();
}

string ask_boss() {
  call_out("go_maboss", 1, this_player());
  return "您要找我们老板呀，走吧，我带你去。\n";
}

string ask_jiu() {
  object gold_ob, jiu;
  int gc = 0;
  gold_ob = present("gold_money", this_player());
  if (objectp(gold_ob)) gc = gold_ob->query_amount();
  if (gc < 5) return "本店没有什么猴儿酒，您还是尝尝小店的竹叶青吧，很醇的。\n";
  if (gc > 5) return "本店没有什么猴儿酒，您还是尝尝小店的杜康吧，保您满意。\n";
  jiu = new("/u/jakey/sell/jiudian/houerjiu");
  jiu->move(this_player());
  message_vision("酒保从柜台下抱了一坛酒出来，偷偷给了$N。\n", this_player());
  gold_ob->add_amount(-5);
  return "这是我从老板那里偷出来的，您可千万别声张。\n";
}

void go_maboss(object ob) {
  remove_call_out("go_maboss");
  if (!ob || ob->is_fighting() || environment(ob) != environment()) return;
  tell_object(ob, "小酒保带着你在巷子里左转右转，一会儿到了一户人家。\n");
  ob->move("/u/jakey/minzhai1");
  return;
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
  add_action("do_buy", "buy");

}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("小酒保笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来歇歇腿吧。\n");
      break;
    case 1:
      say("小酒保用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
        + "，请进请进，小店的陈年佳酿可是好喝的紧呀。\n");
      break;
    case 2:
      say("小酒保说道：这位" + RANK_D->query_respect(ob)
        + "，进来尝尝本店的小菜吧，我们大师傅的手艺可是一绝。\n");
      break;
  }
}
