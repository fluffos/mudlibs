inherit NPC;
 
void create()
{
        set_name("老何", ({ "lao he","laohe","lao","he" }) );
	set("title", "老铁匠" );
        set("gender", "男性" );
        set("age", 64);
        set("long", "一个皮肤黝黑的老年人。\n");
        set("combat_exp",3000 );
	set("attitude", "friendly");
        set_skill("unarmed",15);
        set_skill("dodge", 15);
        set_skill("force",15);        
	set("inquiry", ([
        "铁牌" : "就是一块玄铁牌，打成了火焰的形状，也不知道陈老庄\n"
	 	 "主是拿去干什么用的。\n",
          ]));
        setup();
        carry_object("/u/jakey/obj/cloth")->wear();
}

int accept_object(object me,object ob)
{
	if (!((string)ob->query("name")=="玄铁匕首" && 
	    (string)ob->query("id")=="black dagger")) return 0;
	write("老何把匕首拿到手中看了看。\n");
	command("say 不错，这把匕首是我为陈老庄主打的。当时的陈老庄
主拿来了一块玄英铁，我把它打成了一把匕首，还有一把剑，剩
下的废料打了铁牌。");
	return notify_fail("\n");
}
