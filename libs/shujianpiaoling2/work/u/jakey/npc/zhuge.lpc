// zhuge.c
inherit NEW_VENDOR;

void create() {
  object ob;
  set_name("诸葛文", ({ "zhuge wen", "zhuge", "wen" }));
  set("gender", "男性");
  set("age", 45);
  set("long", "一个看起来很斯文的的人，戴着个西洋水晶眼镜。\n");
  set("combat_exp", 10000);
  set("attitude", "friendly");
  set("rank_info/respect", "先生");
  set("chat_chance", 3);
  set("chat_msg", ({
    "诸葛文扶了扶眼镜。\n",
    "诸葛文用掸子掸了掸书架。\n",
  }));
  set("inquiry", ([
    "残破棋谱": "怎么，你想要吗？那可是我花高价买来的。你要的话就拿十两金子吧。",
  ]));
  set("merchandise", ([
    "/u/jakey/sell/bookshop/dodgeb": 20,
    "/u/jakey/sell/bookshop/unarmedb": 20,
    "/u/jakey/sell/bookshop/literateb": 20,
    "/u/jakey/sell/bookshop/forceb": 20,
    "/u/jakey/sell/bookshop/swordb": 20,
  ]));
  setup();
  ob = carry_object("/u/jakey/obj/baicloth1")->wear();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
  add_action("do_buy", "buy");

}


void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) return;
  say("诸葛文说道：这位" + RANK_D->query_respect(ob)
    + "，要不要买些书籍充实自己呀？\n");
}

int accept_object(object who, object ob) {
  object book;
  if (ob->value() < 100000) return 0;
  if (query("buyed")) { write("诸葛文笑道：“对不起，已经有人买走了。”\n"); return 1; }
  command("say 好，这是那本书，你收好吧。");
  book = new("/u/jakey/special/qipu");
  book->move(this_player());
  add("buyed", 1);
  return 1;
}
