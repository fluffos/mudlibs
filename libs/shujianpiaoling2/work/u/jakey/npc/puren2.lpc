inherit NPC;
 
void create()
{
        set_name("老仆", ({ "laopu"}) );
	set("title", "落月山庄" );
        set("gender", "男性" );
        set("age", 60);
        set("long", "一位头发花白的老仆人。\n");
        set("combat_exp", 4000);
	set("attitude", "friendly");
        set_skill("unarmed",5);
        set_skill("dodge", 5);        
        set("force", 10);
        setup();
         carry_object("/u/jakey/obj/jpzhifu")->wear();
 	 carry_object("/u/jakey/obj/jiandao")->wield();
}

