inherit NPC;
 
void create()
{
        set_name("兰儿", ({ "laner" }) );
	set("title", "落月山庄" );
        set("gender", "女性" );
        set("age", 20);
        set("long", "一个伶俐的小丫环。\n"	            
);
        set("combat_exp", 1000);
	set("attitude", "friendly");
        set_skill("unarmed",10);
        set_skill("dodge", 10);
        set_skill("force",10);        

        set("force", 50);
        set("max_force", 50);
        setup();
        carry_object("/u/jakey/obj/baiqun")->wear();
}

