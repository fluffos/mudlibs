inherit NPC;
 
void create()
{
        set_name("庄客", ({ "zhuangke" }) );
        set("gender", "男性" );
        set("age", 32);
	set("str", 24);
        set("long", "一个浓眉大眼的江湖豪杰。\n");
        set("combat_exp", 70000);
	set("attitude", "heroism");
        set_skill("unarmed",120);
        set_skill("dodge", 120);
        set_skill("parry", 120);
	set_skill("force",120);
	set_skill("move",120);

        set("force", 1500);
        set("max_force", 1500);
        setup();
	carry_object("/u/jakey/obj/cloth")->wear();
}

