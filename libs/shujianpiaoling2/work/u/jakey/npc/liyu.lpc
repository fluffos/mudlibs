// fish.c

inherit NPC;

void create() {
  set_name("鲤鱼", ({ "cyprinoid" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "一只漂亮无比的鲤鱼，真是好看。 \n");
  set("combat_exp", 700);
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set_temp("armor", 5);
  setup();
}
