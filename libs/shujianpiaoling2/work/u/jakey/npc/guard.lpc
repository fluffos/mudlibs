inherit NPC;
 
void create()
{
        set_name("山庄门卫", ({"guard"}) );

        set("gender", "男性" );
        set("age", 20);
        set("long","这是个身体强壮的小伙子，是落月山庄的门卫。\n");
        set("combat_exp",100000);
//	set("pursuer", 1);    // 追捕？  1=yes 0=no
	set("attitude", "heroism");
	set("chat_msg_combat",({
	"山庄门卫喝道：“大胆狂徒，胆敢到山庄生事，纳命来吧！",
	}));
        set_skill("unarmed",100);
        set_skill("dodge", 100);
        set_skill("blade", 100);
        set_skill("parry", 100);

        setup();
    carry_object("/u/jakey/obj/blade")->wield();
    carry_object("/u/jakey/obj/jpzhifu")->wear();
}