inherit NPC;
 
void create()
{
        set_name("超级巡警", ({"super police","police"}) );

        set("gender", "男性" );
        set("age", 34);
        set("long","这里虽然是个小地方，也有官府的巡警在这里。要想作奸犯科可是不行。\n");
        set("combat_exp",400000);
	set("pursuer", 1);    // 追捕？  1=yes 0=no
	set("attitude", "heroism");
	set("force",3000);
	set("max_force",3000);
	set("chat_msg_combat",({
	"超级巡警喝道：“大胆狂徒，胆敢无故杀人，纳命来吧！",
	}));
	set("vendetta_mark", "authority");  // 记仇标记=“authority” (官府)

        set_skill("unarmed",200);
        set_skill("dodge", 200);
        set_skill("blade", 200);
        set_skill("parry", 200);
        set_skill("sword", 200);

	set("chat_chance",5);
	set("chat_msg",({
		(: random_move :),
	}));
        setup();

    carry_object("/u/jakey/obj/blade")->wield();
    carry_object("/u/jakey/obj/cloth")->wear();
}