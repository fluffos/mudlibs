inherit NPC;

void create() {
  set_name("保镖", ({ "triggerman" }));
  set("gender", "男性");
  set("age", 27);
  set("attitude", "heroism");
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("con", 30);
  set("force", 11000);
  set("max_force", 6000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("max_kee", 4000);
  set("food", 400);
  set("water", 400);
  set("force_factor", 250);
  set("long",
    "一个高大威猛的保镖，让人望之生畏。你要能雇佣他，保证不会有\n"
    "被人暗杀的危险。\n");

  set("combat_exp", 27000000);
  set("env/immortal", 1);

  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("unarmed", 300);
  set_skill("force", 300);
  set_skill("sword", 300);
  set_skill("xuanyue-force", 300);
  set_skill("dm13-sword", 300);
  set_skill("luanyu-strike", 300);
  set_skill("qingfeng-steps", 300);
  set_skill("fjcg-hand", 300);

  map_skill("force", "xuanyue-force");
  map_skill("dodge", "qingfeng-steps");
  map_skill("unarmed", "fjcg-hand");
  map_skill("sword", "dm13-sword");
  map_skill("parry", "dm13-sword");

  setup();
  carry_object("/u/jakey/special/qiushang")->wield();
  carry_object("/u/jakey/obj/triggermancloth")->wear();

  if (clonep()) CHANNEL_D->register_relay_channel("chat");
}

void relay_channel(object ob, string channel, string msg) {
  string who, judge, self, talk;
  object where;

  if (!(ob->query("id") == this_object()->query("master"))) return;

  if (ob == this_object()) return;

  if (channel != "chat") return;

  sscanf(msg, "%s %s", self, talk);
  if (self == "triggerman") {


    if (talk == "come here") {
      where = environment(ob);
      if (!where) { command("chat 我找不到你在哪里呀。"); return; }
      this_object()->move((string)file_name(where) + ".lpc");
      message_vision("$N走了过来。\n", this_object());
      return;
    }

    if (talk == "are you ok ?") {
      if ((this_object()->query("eff_gin") < (this_object()->query("max_gin") / 2)) ||
        (this_object()->query("eff_kee") < (this_object()->query("max_kee") / 2)) ||
        (this_object()->query("eff_sen") < (this_object()->query("max_sen") / 2))) command("chat oh,i will die");
      else command("chat yes,I'm fine");
    }


  }
  return;
}

void init() {
  add_action("do_say", "say");
  add_action("do_whisper", "whisper");
  add_action("do_killer", "kill");
  add_action("do_hiter", "hit");
  add_action("do_stealer", "steal");
}

int do_killer(string arg) {
  object master;
  if (arg == this_object()->query("master")) {
    master = present(this_object()->query("master"), environment(this_player()));
    message_vision("$N纵身一跃，挡在$n身前，断声喝道：“大胆狂徒，竟敢伤我主人。”\n", this_object(), master);
    command("kill " + this_player()->query("id"));
    return 1;
  }
  return 0;
}

int do_hiter(string arg) {
  object master;
  if (arg == this_object()->query("master")) {
    master = present(this_object()->query("master"), environment(this_player()));
    message_vision("$N纵身一跃，挡在$n身前，断声喝道：“大胆狂徒，竟敢偷袭我主人。”\n", this_object(), master);
    command("kill " + this_player()->query("id"));
    return 1;
  }
  return 0;
}

int do_stealer(string arg) {
  object master;
  string sth, sb;
  sscanf(arg, "%s from %s", sth, sb);
  if (sb == this_object()->query("master")) {
    master = present(this_object()->query("master"), environment(this_player()));
    message_vision("$N纵身一跃，挡在$n身前，断声喝道：“大胆毛贼，竟敢偷我主人的东西。”\n", this_object(), master);
    command("kill " + this_player()->query("id"));
    return 1;
  }
  return 0;
}

int do_whisper(string arg) {
  string self, msg;
  sscanf(arg, "%s %s", self, msg);

  if (this_object()->query("master")) return 0;

  if ((self == "triggerman") && (msg == "i'm your master")) {
    this_object()->set("master", (string)this_player()->query("id"));
    return 0;
  }
  return 0;
}

int heal_sb(object ob) {
  ob->set("eff_gin", ob->query("max_gin"));
  ob->set("eff_kee", ob->query("max_kee"));
  ob->set("eff_sen", ob->query("max_sen"));
  ob->set("gin", ob->query("max_gin"));
  ob->set("kee", ob->query("max_kee"));
  ob->set("sen", ob->query("max_sen"));
  ob->set("atman", (ob->query("max_atman") * 2) - 1);
  ob->set("force", (ob->query("max_force") * 2) - 1);
  ob->set("mana", (ob->query("max_mana") * 2) - 1);
  ob->set("food", ((ob->query("str") * 10) + 100));
  ob->set("water", ((ob->query("str") * 10) + 100));
  ob->set("force_factor", (int)(ob->query_skill("force", 0) / 2));
  message_vision("保镖运起内功为$n疗伤。\n只见$n喷出几口鲜血，伤势豁然全愈。\n", ob, ob);
  return 1;
}


void follow_sb(object ob) {
  command("follow " + ob->query("id"));
  return;
}


void kill_sb(object ob, object me) {
  if (me->query("gender") == "男性")
    command("say Yes，Sir！");
  else {
    if (me->query("gender") == "女性")
      command("say Yes，Madam！");
    else command("say Yes ！");
  }
  message_vision("$N冷哼一声：“$n！纳命来吧！\n", this_object(), ob);
  command("kill " + ob->query("id"));
  return;
}

void fight_sb(object ob, object me) {
  if (me->query("gender") == "男性")
    command("say Yes，Sir！");
  else {
    if (me->query("gender") == "女性")
      command("say Yes，Madam！");
    else command("say Yes ！");
  }
  command("fight " + ob->query("id"));
  return;
}

void hit_sb(object ob, object me) {
  if (me->query("gender") == "男性")
    command("say Yes，Sir！");
  else {
    if (me->query("gender") == "女性")
      command("say Yes，Madam！");
    else command("say Yes ！");
  }
  message_vision("$N冷哼一声：“$n！纳命来吧！\n", this_object(), ob);
  command("hit " + ob->query("id"));
  return;
}

void send_sb(object ob) {
  command("say 好的，以后" + ob->query("name") + "就是我的新主人了。");
  return;
}

int do_say(string arg) {
  object ob, where, me = this_player();
  string name, cmd, sb;

  if (!arg) return 0;

  if (!(me->query("id") == this_object()->query("master"))) return 0;

  if (sscanf(arg, "%s %s %s", name, cmd, sb) == 3) {

    if (!(name == "triggerman")) return 0;

    switch (cmd) {

      case "hit": if (!objectp(ob = present(sb, environment(me)))) return 0;
      call_out("hit_sb", 1 / 10, ob, me);
      return 0;
      case "fight": if (!objectp(ob = present(sb, environment(me)))) return 0;
      call_out("fight_sb", 1 / 10, ob, me);
      return 0;
      case "kill": if (!objectp(ob = present(sb, environment(me)))) return 0;
      call_out("kill_sb", 1 / 10, ob, me);
      return 0;
      case "follow": if (sb == "me") { call_out("follow_sb", 1 / 10, me); return 0; }
      if (sb == "none") { command("follow none"); return 0; }
      if (!objectp(ob = present(sb, environment(me)))) return 0;
      call_out("follow_sb", 1 / 10, ob);
      return 0;
      case "help": if (sb == "me") {
        ob = this_player(); call_out("heal_sb", 1 / 10, ob); return 0;
      }
      if (sb == "youself") { ob = this_object(); call_out("heal_sb", 1 / 10, ob); return 0; }
      if (!objectp(ob = present(sb, environment(me)))) return 0;
      call_out("heal_sb", 1 / 10, ob);
      return 0;
      case "send": if (!objectp(ob = present(sb, environment(me)))) return 0;
      this_object()->set("master", (string)ob->query("id"));
      call_out("send_sb", 1 / 10, ob);
      return 0;
    }
  }
  return 0;
}

int accept_fight(object ob) {
  return 0;
}
