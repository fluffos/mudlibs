inherit ROOM;

void create()
{
	set("short", "厨房");
	set("long", @LONG
这里是厨房，里面摆着张大桌子，桌子上面放着做好的食物
，一阵阵的香气直往你的鼻子里钻，让你禁不住垂涎欲滴。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
	"west" : __DIR__"zl5",
	]));
	set("objects",([
	__DIR__"npc/cook" : 1,
	__DIR__"sell/jiudian/kaoya" : 3,
	__DIR__"sell/jiudian/shuigang" : 1,
	]));
	set("no_clean_up", 0);
	setup();
}

int valid_leave(object me,string dir)
{
	object food;
	food=present("kaoya",me);
	if (objectp(food)) return notify_fail("大师傅说道：食物只能在这里吃，不可以带走。\n");
	return 1;
}
