inherit ROOM;

void create()
{
	set("short", "密道");
	set("long", @LONG
这里是黑乎乎的密道，不知是什么时候开凿的，四周没有任
何光亮，你只能深一脚，浅一脚的摸索着前进。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
	"east" :	__DIR__"midao"+(random(4)+1),
	"south":	__DIR__"midao"+(random(4)+1),
	"west" :	__DIR__"midao"+(random(4)+1),
	"north":	__DIR__"midao"+(random(4)+1),
	]));
	set("no_clean_up", 0);       
	setup();
} 

void init()
{
	add_action("do_use","use");
}

int do_use(string arg)
{
	object ob;
	ob=present("huozhe",this_player());
	if (!ob) return 0;
	if (arg!="huozhe") return 0;
	write("你点亮火折，总算能看清路了，你发现在密道旁的墙壁上刻着一个向南的箭头。\n");
	return 1;
}

void right0(object me)
{
if ((int)me->query_temp("step")<15) me->add_temp("step",1);
}

void right1(object me)
{
if ((int)me->query_temp("step")>1) me->add_temp("step",-1);
}

void wrong0(object me)
{
if (((int)me->query_temp("step")-2)>0) me->add_temp("step",-2);
else if (((int)me->query_temp("step")-1)>0) me->add_temp("step",-1);
}

void wrong1(object me)
{
if (((int)me->query_temp("step")+2)<16) me->add_temp("step",2);
else if (((int)me->query_temp("step")+1)<16) me->add_temp("step",1);
}

int valid_leave(object me,string dir)
{
switch(dir){

case "east" :	switch ((int)me->query_temp("join")) {
		case 0:	wrong0(me);return 1;
		case 1:	wrong1(me);return 1;}


case "south":	if ((int)me->query_temp("step")==1) {me->move("/u/jakey/chen/midaorukou");return notify_fail("\n");}
		else {	if (((int)me->query_temp("step")%3)==0)
				switch ((int)me->query_temp("join")) {
				case 0: wrong0(me);return 1;
				case 1: right1(me);return 1;}
			else 
				switch ((int)me->query_temp("join")) {
				case 0: right0(me);return 1;
				case 1: right1(me);return 1;}
		}

case "west" :	switch ((int)me->query_temp("join")) {
		case 0:	wrong0(me);return 1;
		case 1:	wrong1(me);return 1;}

case "north":	if (((int)me->query_temp("step")%3)==0)
			switch ((int)me->query_temp("join")) {
			case 0: if ((int)me->query_temp("step")==15) {me->move("/u/jakey/chen/midao5");return notify_fail("\n");}
				else {right0(me);return 1;}
			case 1: if ((int)me->query_temp("step")==15) {me->move("/u/jakey/chen/midao5");return notify_fail("\n");}
				else {wrong1(me);return 1;}}
		else	switch ((int)me->query_temp("join")) {
			case 0:	wrong0(me);return 1;
			case 1:	right1(me);return 1;}

}
}

