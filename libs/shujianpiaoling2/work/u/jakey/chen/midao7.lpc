inherit ROOM;

void create() {
  set("short", "密道");
  set("long", @LONG
密道终于走到头了，这里的四周是坚硬的石壁，往前已经没
有路了。有一块厚厚的花岗岩石板把前面的路牢牢的挡住了，就
是金刚下凡也难以把这石板挪开。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "midao6",
  ]));
  set("item_desc", ([
    "石板": "这个石板表面光滑无比，把整个密道挡的严严实实。\n"
    "在石板左边一人高处有一个火焰形的凹印。\n",
    "凹印": "一个火焰形状的凹印，好象是用来镶嵌什么东西的。\n",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  object token;
  string to;
  if (!arg) return 0;
  if (sscanf(arg, "%s to %s", arg, to) == 2) {
    if (to == "凹印") {
      if (arg == "火形铁牌") {
        token = present("fire token", this_player());
        if (!token) return notify_fail("你身上没有火形铁牌\n");
        if (query("opened")) return notify_fail("石板已经打开了。\n");
        write("你把火形铁牌放进凹印，再用力一按。\n");
        if (this_player()->query("max_force") < 1500) return notify_fail("什么事情也没有发生。\n");
        write("石板缓缓的移开了。\n");
        add("exits/north", __DIR__ "shishi");
        __DIR__ "shishi"->add("exits/south", __DIR__ "midao7");
        tell_room(__DIR__ "shishi", "石室的一面墙上无声无息开了一扇石门。\n");
        add("opened", 1);
        return 1;
      } else return notify_fail("你不能把" + arg + "用于" + to + "。\n");
    } else return notify_fail("你不能把" + arg + "用于" + to + "。\n");
  } else return notify_fail("指令格式： use <某物> to <某处>\n");
}
