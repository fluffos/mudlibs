inherit ROOM;

void create()
{
	set("short", "机关房");
	set("long", @LONG
这是一个很大的房间，在房间中有九个石人，这些石人看样
子好象是可以动的，和少林的木人一样，大概是可以用来练功的
吧。在房间的一面墙上有一个开关。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
//	"west" : __DIR__"midao5",
	]));
	set("objects",([
	"/u/jakey/npc/shiren" : 4,
	"/u/jakey/npc/shiren1" : 5,
	]));
	set("item_desc",([
	"开关":"一个开关，不知道是控制什么的，扳(turn)一下试试吧。\n",
	]));
	set("no_clean_up", 0);       
	setup();
}

void init()
{
	add_action("do_turn","turn");
}

int do_turn(string arg)
{
	if (arg!="开关") return 0;
	write("你用手把墙上的开关扳了一下。\n");
	tell_room(__FILE__,"只听“咔”一声轻响，你身边开了一扇石门。\n");
	add("exits/west",__DIR__"midao5");
	__DIR__"midao5"->add("exits/east",__DIR__"fight");
	call_out ("close_passage",5);
	return 1;
}

void close_passage()
{
	__DIR__"midao5"->delete("exits/east");
	__DIR__"fight"->delete("exits/west");
	tell_room(__DIR__"midao5","打开的石门又无声无息的关上了。\n");
	tell_room(__DIR__"fight","打开的石门又无声无息的关上了。\n");
	return;
}
