inherit ROOM;

void create() {
  set("short", "楼梯间");
  set("long", @LONG
阴暗的楼梯间里满满的挤着些杂物，仔细看去满是油污的灶
台，旁边有个大水缸，锅碗丢的满地都是，角落里堆着成箱的酒
，你很纳闷，这到底是厨房还是垃圾堆？太不象话了!
LONG
  );
  set("exits", ([ /* sizeof() == x */
    "down": __DIR__ "room1",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "jakey");
  setup();
}

void init() {
  add_action("do_push", "push");
}

int do_push(string arg) {
  if (arg != "大水缸") return 0;
  write("你试着推开大水缸露出一个洞口来\n");
  add("exits/east", "/u/jakey/player/room3");
  call_out("close_passage", 5);
  return 1;
}


void close_passage() {
  object room;
  delete("exits/east");
  tell_room("/u/jakey/player/room3", "挡在出口的水缸被人挪开了。\n");
}
