inherit ROOM;

void create()
{
	set("short", "小屋");
	set("long", @LONG
破烂的小木屋，房间里乱丢着一些破书，墙上挂着盏不起眼
的小油灯，昏暗的灯光照在天棚上显出恍惚的影子，一张棋桌看
起来很久没擦了，上面散落着些棋子，满地的烟头。唉，主人太
邋遢了...
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"east" : "/u/jakey/player/road1",
	]));
	set("objects", ([ /* sizeof() == 2 */
	"/u/jakey/sell/jiudian/shuigang" : 1,
	]));
	set("no_clean_up", 0);       	
	set("valid_startroom",1);
	setup();
}

void init()
{
	add_action("do_search","search");
	add_action("do_press","press");
}

int do_search(string arg)
{
	if (arg!="桌脚") return 0;
	write("你顺着桌脚摸下去，发现内侧有的嵌着个圆形的东西。\n");	
	return 1;
}

int do_press(string arg)
{
	if (arg!="棋子") return 0;
	write("你摸了下棋子，天花板上伸出一个梯子。\n");
	add("exits/up","/u/jakey/player/room2");
	call_out ("close_passage",5);
	return 1;
}
void close_passage()
{
        object room;

	delete("exits/up");
	tell_room("/u/jakey/player/room1","梯子咯咯吱吱的响了几声，收了上去。\n");
	tell_room("/u/jakey/player/room2","梯子咯咯吱吱的响了几声，收了上来。\n");
}
