inherit ROOM;

void create() {
  set("short", "后花园");
  set("long", @LONG
这里是后花园。园中种植着各种各样的奇花异草。园中贴墙
堆砌着假山，假山环抱着一个碧绿的水潭，潭中饲养着七彩鲤鱼
。还未到开荷花的季节，不过潭中不知怎地却开满荷花。潭边种
着不知名的树，开着红色的花。花瓣被风吹在水里，有几条调皮
的鲤鱼用嘴巴顶来顶去。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "southwest": __DIR__ "houzhai",
    "north": __DIR__ "gui1",
    "east": __DIR__ "feng1",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "jakey");
  setup();
}

void init() {
  add_action("do_dive", "dive");
  add_action("do_climb", "climb");
  add_action("do_eat", "eat");
  add_action("do_drink", "drink");
}

int do_dive(string arg) {
  if (arg != "水潭") return 0;
  write("你深吸了两口气，扑嗵一声跳下水潭。\n");
  this_player()->move(__DIR__ "shuitan1");
  message_vision("$N一头扎了下来，脑袋扎在泥里，真是狼狈。:) \n", this_player());
  return 1;
}

int do_climb(string arg) {
  if (arg == "假山") {
    message_vision("$N手足并用的往假山上爬去。\n", this_player());
    this_player()->move(__DIR__ "jiashan");
    return 1;
  } else return 0;
}

int do_eat(string arg) {
  if (arg == "鲤鱼") {
    if ((int)this_player()->query("food") >= (int)this_player()->max_food_capacity())
      return notify_fail("你从水里捞起一条鲤鱼，看看了，实在是吃不下了。\n");
    else {
      message_vision("$N从水里捞起一条鲤鱼，看看了，一口吞了下去。\n", this_player());
      this_player()->add("food", 10);
      return 1;
    }
  } else return 0;
}

int do_drink(string arg) {
  if (arg == "潭水") {
    if ((int)this_player()->query("water") >= (int)this_player()->max_water_capacity())
      return notify_fail("你一口也喝不下了。\n");
    else {
      message_vision("$N趴在水潭旁边喝了几口潭水，真是不卫生。\n", this_player());
      this_player()->add("water", 20);
      return 1;
    }
  } else return 0;
}

int valid_leave(object me, string dir) {
  if (dir == "southwest")
    me->start_busy(3);
  return 1;
}
