#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
     set_name("伤药" ,({"heal pill","pill" }));
	set("long",
   "一个小小的药丸，具有起死回生的功效。\n");
	set("unit", "颗");
	set("base_unit", "颗");
//	set("value",7000);
	set("base_weight", 200);
	set_amount(1);
}

void init()
{
	if( this_player()==environment() )
		add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	int fw,max;
	if( !this_object()->id(arg)) return notify_fail("你要吃什么? \n");
	if( this_player()->query_temp("block_msg/all"));
		return notify_fail("什么？\n");
	message_vision("$N拿出一颗药丸，一口给吞了下去。\n",this_player());
	write("你吃下了药丸，感觉有一股热气从丹田升起。\n",);
	this_player()->receive_curing("gin", 500);
	this_player()->receive_curing("kee", 500);
	this_player()->receive_curing("sen", 500);
	this_player()->receive_heal("gin", 500);
	this_player()->receive_heal("kee", 500);
	this_player()->receive_heal("sen", 500);
	max=this_player()->query("max_force")*2-1;
	this_player()->set("force",max);
	fw=this_player()->query("str")*10 +100;
	this_player()->set("food",fw);
	this_player()->set("water",fw);
	add_amount(-1);
	return 1;
}
