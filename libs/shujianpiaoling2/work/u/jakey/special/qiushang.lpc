// wuji sword.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("秋殇剑", ({ "qiushang sword", "sword" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("material", "steel");
    set("long", "一把锋利无比的好剑。\n");
    set("wield_msg", "$N抽出$n，“刷”的一声，寒光四射。顿时四周的空气为之一窒。\n");
    set("unequip_msg", "$N把手中的$n插回剑鞘。\n");
  }
  init_sword(105);
  setup();
}
