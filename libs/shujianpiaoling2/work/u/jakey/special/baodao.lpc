//bao blade.c

#include <weapon.h>

inherit BLADE;

void create()
{
	set_name("屠龙刀", ({ "tulong blade","blade" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 5000);
		set("material", "diamond");
		set("long", "这是一口削铁如泥的宝刀，份量大约十来斤重。\n");
		set("wield_msg", "只听“嗖”的一声，$N从腰间抽出一把明晃晃的$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
	}
	init_blade(135);
	setup();
}
