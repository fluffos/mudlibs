// peafowl.c

#include <ansi.h>
#include <weapon.h>

inherit ITEM;

void create()
{
	set_name("孔雀翎", ({ "peafowl" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("value", 1);
//		set("no_drop", 1);
//		set("no_get", 1);
		set("material", "steel");
		set("long", "这是一种凌厉无比的暗器，一旦使用，必中无疑。现在世上仅存有这一个。\n"
			    "由于制造暗器的图纸早已丢失，制造者也死了，所以不可能再有第二个了。\n"
			    "你可以用(miao)来瞄准你要打的目标，用(she)发射。\n");
	}
	setup();
}

void init()
{
        add_action("do_aim","miao");
        add_action("do_shoot","she");
}

int do_aim(string arg)
{
	object me, obj;
	me = this_player();
	if( !arg )
		return notify_fail("你想杀谁？\n");

	if( this_object()->query("useed") >0)
		return notify_fail("暗器已经发射过了，不能再用了。\n");

	if( environment(me)->query("no_fight") )
		return notify_fail("这里不准战斗。\n");

	if(!objectp(obj = present(arg, environment(me))))
		return notify_fail("这里没有这个人。\n");

	if( !obj->is_character() || obj->is_corpse() )
		return notify_fail("看清楚一点，那并不是活物。\n");

	if(obj == me)
		return notify_fail("用 suicide 指令会比较快:P。\n");

	message_vision(HIY "\n$N举起孔雀翎，对准了$n，把手指放到了开关上。\n\n" NOR, 
			me, obj);

	this_object()->set_temp("target", arg);

	return 1;
}

int do_shoot()
{
	object me, obj;
	string arg;
	int jing,qi,shen,ran;

	me = this_player();
        if( me->query_temp("sleeping") ) return 
		notify_fail("你正在睡眠中。\n");

	if( !(arg = this_object()->query_temp("target")) ) 
		return notify_fail("你还没有瞄准你的射击目标！\n");

	if( !objectp(obj = present(arg, environment(me)) ))
		return notify_fail("你要射击的对象已经离开了。\n");

	if ((int)me->query("force_factor")<60)
		return notify_fail("以你现在的功夫，可能会控制不住暗器发射时巨大的反作用力，会伤到自己。\n");

	message_vision(HIR "\n$N对准$n按下了暗器开关！！！\n\n你眼前出现了一片绚丽夺目的光芒。$n根本不可能闪开，被暗器击中，受了极重的伤！\n\n" NOR,
			me, obj);

	this_object()->set("value", 0);
	this_object()->add("useed",1);
	jing=((int)obj->query("eff_gin")/10);
	qi=((int)obj->query("eff_kee")/10);
	shen=((int)obj->query("eff_sen")/10);
	ran=(random(3)+1);
	obj->set("eff_gin",jing*ran);
//	obj->set("eff_kee",qi*ran);
	obj->set("eff_sen",shen*ran);
	obj->set("gin",jing*ran);
	obj->receive_damage("kee",300);
	obj->receive_damage("sen",300);
	obj->kill_ob(me);
	me->start_busy(1);
	return 1;
}

