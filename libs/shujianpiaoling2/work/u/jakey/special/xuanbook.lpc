inherit ITEM;

void create()
{
	set_name("玄月心法入门", ({ "xuanyue book", "book" }));
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本学习玄月心法的书籍。\n");
		set("material", "paper");
		set("skill", ([
			"name":	"xuanyue-force",	
			"exp_required":	0,	
			"sen_cost":	20,
			"difficulty":	35,	
			"max_skill":	30	
		]) );
	}
}
