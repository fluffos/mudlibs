inherit ROOM;

void create()
{
	set("short", "遇雨草亭");
	set("long", @LONG
半山腰里有一个草亭，上面铺着黄褐色的茅草，这个草亭还
有一块木匾，上面隐隐约约写着“遇雨草亭”。亭中坐着一个老
者，坐在亭中的长条凳子上，面前的桌子上摆着一张不知道多古
老的古筝，老者一手按在筝上，另一只手拂着花白的胡子，手指
偶尔弹着琴弦，正在自娱自乐。一个樵夫打扮的人蹲在亭外的一
个石头上。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"northup" : __DIR__"lpath1",
	"southdown" : __DIR__"htpath4",
	]));
	set("objects",([
	__DIR__"npc/laozhe" : 1,
	__DIR__"npc/qiaofu" : 1,
	]));
	set("no_clean_up", 0);
        set("outdoors", "jakey");
	setup();
	replace_program(ROOM);
}
