inherit ROOM;

void create()
{
	set("short", "密室");
	set("long", @LONG
这是一个隐蔽的密室，密室的里的四角各摆着一个红烛台，
上面点着白蜡，烛光摇曳。在南面的墙上挂着一把宝剑，在室中
地上放着一个蒲团，在西面有一个书案，上面摆着笔墨纸砚和一
些书信。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
	"southup" : __DIR__"xiaodao",
	]));
	set("item_desc",([
	"书案"	:"在书桌的左上角摆着一块紫色的木牌，下面压着一本泛黄的书卷。\n",
	]));
	set("no_clean_up", 0);       
	setup();
}

void init()
{
	add_action("do_get","get");
}

int do_get(string arg)
{
	object obj;
	string from;
	if (!arg) return 0;
	if( sscanf(arg, "%s from %s", arg, from)==2 ) {
		if(from == "书案") {
		switch (arg) {
		case "book" :
		case "书卷" :	if (query("book")) {
				write("你在书案上找不到"+arg+"\n");
				return 1;}
				else {
				obj = new("/u/jakey/special/forcebook");
			 	obj->move(this_player());     
				add("book",1);
				message_vision("$N从书案上拿了一本书。\n", this_player());
				return 1;}
		case "token":
		case "紫木牌":
		case "木牌" :	if (query("token")) {
				write("你在书案上找不到"+arg+"\n");
				return 1;}
				else {
				obj = new("/u/jakey/special/zimupai");
			 	obj->move(this_player());     
				add("token",1);
				message_vision("$N从书案上拿了一块木牌。\n", this_player());
				return 1;}
				}
		  }
	}
	return 0;
}
