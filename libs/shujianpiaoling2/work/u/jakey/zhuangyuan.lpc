//writen by JC
#include <ansi.h>
inherit ROOM;
string look_sign(object me);

void create()
{
	set("short", "落月山庄庄院");
	set("long", @LONG
这里是落月山庄的庄院，占地约有百八十亩，有的地方已经
盖了一些房子，不过大部分地方还是空着，庄院入口插了一块牌
子(sign)。
LONG
	);
	set("exits", ([
	"south" : __DIR__"xx1",
	]));
	set("item_desc", ([
	"sign" : (: look_sign :),
	]));
	set("no_clean_up", 0);
	set("outdoors","jakey");

	setup();
}

string look_sign(object me)
{
	string msg="\n";
	msg = msg + HIG   "			        落月山庄庄院管理条例\n\n"NOR;
	msg = msg + "		     ****************************************\n\n";
	msg = msg + "			如果需要买房，到山庄钱总管处询问“买房”\n\n";
	msg = msg + "			对已经有房屋者，可以在此使用以下命令：\n\n";
	msg = msg + "			\"backhome\"     : 回家\n\n";
	msg = msg + "			\"invite <id>\"  : 邀请别人到家做客\n\n";
	msg = msg + "			\"visitsb <id>\" : 到别人家中拜访\n\n";
	msg = msg + "		     ****************************************\n\n";

	return msg;
}

void init()
{
	add_action("do_backhome","backhome");
	add_action("do_invite","invite");
	add_action("do_visit","visitsb");
}

int do_backhome()
{
// 	msg = message

	string msg,file = resolve_path("/u/jakey/player", this_player()->query("id")) + ".lpc";

	if(!( file_size(file)!=-1) ) return notify_fail("你在这里没有自己的房子。\n");

	msg = find_object(file)->query("backhome");

	if (msg) write (msg+"\n");

	else write("回家了，真温馨呀。\n");

	this_player()->move(file);

	return 1;
}

int do_invite(string arg)
{
	object guest;

	string file = resolve_path("/u/jakey/player", this_player()->query("id")) + ".lpc";

	if(!( file_size(file)!=-1) ) return notify_fail("你没有自己的房子，无法邀请别人。\n");

	if (!arg) return notify_fail("你想邀请谁来？\n");

	guest=present(arg,environment(this_player()));

	if (!objectp(guest)) return notify_fail("你想邀请的人现在不在这里。\n");

	guest->set_temp("marks/master",this_player()->query("id"));

	message_vision("$N决定邀请$n到家里做客。\n",this_player(),guest);

	return 1;
}

int do_visit(string arg)
{
	string msg,file = resolve_path("/u/jakey/player", arg + ".lpc");

	if (!arg) return notify_fail("你想去谁家拜访？\n");

	if(!( file_size(file)!=-1) ) return notify_fail("这里没有这个人的房间。\n");

	if (arg == this_player()->query("id") ) return notify_fail("拜访自己家？用\"backhome\"命令嘛。\n");
	
	msg = find_object(file)->query("noinvite");

	if (this_player()->query_temp("marks/master")!=arg) 
	
		if (msg) return notify_fail(msg+"\n");

		else return notify_fail("房间的主人没有邀请你，你不能进去。\n");

	msg = find_object(file)->query("sbcome");

	if (msg) tell_room(__DIR__"player/"+arg,"\n"+this_player()->query("name")+msg+"\n\n");

	else tell_room(__DIR__"player/"+arg,"\n"+this_player()->query("name")+"一推门，走了进来。\n\n");

	this_player()->move(file);

	return 1;
}
