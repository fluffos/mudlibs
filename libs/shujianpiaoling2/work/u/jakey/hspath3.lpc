inherit ROOM;

void create()
{
	set("short", "后山小路");
	set("long", @LONG
这是后山的一条小路，弯弯曲曲的在树林中延伸着。树叶被
山风吹得哗哗直响。有时山风卷起几片落叶在你面前打个滚，迅
速的躲进草丛里。从这里往北是一片密密麻麻的树林，看样子会
迷路，还是不要进去的好。西边有一个悬崖。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
	"north" : "/u/jakey/tower/milin"+((random(2)*2)+1),
	"south" : __DIR__"hspath1",
	"west"  : __DIR__"hspath2",
]));
	set("no_clean_up", 0);
        set("outdoors", "jakey");
	setup();
}

int valid_leave(object me,string dir)
{
	if (dir=="north") {
	me->set_temp("step",1);
	me->set_temp("join",0);}
	return 1;
}

