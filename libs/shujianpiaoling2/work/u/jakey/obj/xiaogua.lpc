#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("小褂", ({ "xiao gua","cloth" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"一件小布褂，穿上很凉快，上面有些油腻。\n");
		set("unit", "件");
		set("value", 20);
		set("material", "cloth");
		set("armor_prop/armor", -1);
		set("armor_prop/attack", -1);
	}
	setup();
}
