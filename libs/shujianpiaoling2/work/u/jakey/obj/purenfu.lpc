#include <armor.h>

inherit CLOTH;

void create() {
  set_name("仆人服", ({ "purenfu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "深兰色的仆人服，没什么特点。\n");
    set("unit", "件");
    set("value", 10);
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
