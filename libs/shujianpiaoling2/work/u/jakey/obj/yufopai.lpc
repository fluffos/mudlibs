#include <armor.h>

inherit NECK;

void create() {
  set_name("玉佛牌", ({ "yufo pai", "pai" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一块上面雕刻着佛祖图案的玉石牌，很精巧。\n");
    set("unit", "件");
    set("value", 2000);
    set("material", "cloth");
    set("armor_prop/dodge", 3);

  }
  setup();
}
