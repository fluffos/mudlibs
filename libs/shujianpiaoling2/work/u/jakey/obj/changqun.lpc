#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("长裙", ({ "changqun" }) );
	set_weight(400);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"这是年纪较大一点的妇人穿的长裙，淡兰色。\n");
		set("unit", "件");
		set("value", 200);
		set("material", "cloth");
		set("armor_prop/armor", 1);	 
		set("armor_prop/attack", -1);
	}
	setup();
}
