#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("道袍", ({ "dao pao","cloth" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"一件洗的发白的道袍。\n");
		set("unit", "件");
		set("value", 50);
		set("material", "cloth");
		set("armor_prop/armor", 4);
		set("armor_prop/dodge", 4);
	}
	setup();
}
