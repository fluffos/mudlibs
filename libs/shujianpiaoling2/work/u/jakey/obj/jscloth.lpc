#include <armor.h>

inherit CLOTH;

void create() {
  set_name("紧身衣", ({ "jinshen cloth", "cloth" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一件深色的紧身衣，穿上后行动自如，是练功人的最爱。\n");
    set("unit", "件");
    set("value", 200);
    set("material", "cloth");
    set("armor_prop/armor", 5);
    set("armor_prop/parry", 5);
  }
  setup();
}
