#include <armor.h>

inherit CLOTH;

void create() {
  set_name("白短褂", ({ "white cloth", "cloth" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一件白布做的小短褂。\n");
    set("unit", "件");
    set("value", 200);
    set("material", "cloth");
    set("armor_prop/armor", 3);
    set("armor_prop/attack", -5);
  }
  setup();
}
