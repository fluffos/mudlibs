#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("白布长衫", ({ "baibu cloth","cloth" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"一件常见的丝绸做的白色长衫。\n");
		set("unit", "件");
		set("value", 100);
		set("material", "cloth");
		set("armor_prop/armor", 3);
		set("armor_prop/dodge", 3);
	}
	setup();
}
