#include <armor.h>

inherit WRISTS;

void create() {
  set_name("手镯", ({ "shouzhuo", "zhuo" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是用南洋大黑珍珠做的手镯，很贵重。\n");
    set("unit", "件");
    set("value", 74000);
    set("armor_prop/armor", 3);
    set("armor_prop/dodge", 1);
    set("wear_msg", "$N把$n带在手上。\n");
  }
  setup();
}
