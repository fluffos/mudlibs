#include <weapon.h>

inherit SWORD;

void create() {
  set_name("素面折扇", ({ "shanzi", "shan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 500);
    set("material", "bamboo");
    set("long", "这是一把普通的白纸折扇，上面还挂着一个红穗。\n");
    set("wield_msg", "$N拿出一把白色的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间。\n");
  }
  init_sword(7);
  setup();
}
