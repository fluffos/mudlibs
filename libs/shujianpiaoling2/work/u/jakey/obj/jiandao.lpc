// bamboo_sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
    set_name("大剪刀", ({ "jian dao", "jian" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 200);
		set("material", "steel");
        set("long", "这是一把修剪花草的大剪刀。\n");
        set("wield_msg", "$N拿出一把$n，握在手中。\n");
		set("unequip_msg", "$N放下手中的$n。\n");
	}
    init_sword(4);
	setup();
}
