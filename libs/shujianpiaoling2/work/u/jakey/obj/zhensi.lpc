#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("真丝内衣", ({ "zhensi cloth","cloth" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"这是...是...一件女人的内衣，就不便描述了吧。\n");
		set("unit", "件");
		set("value", 500);
		set("material", "cloth");
		set("armor_prop/armor", 2);
		set("armor_prop/dodge", 2);
	}
	setup();
}
