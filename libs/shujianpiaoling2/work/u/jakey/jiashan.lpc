inherit ROOM;

void create()
{
	set("short", "假山顶");
	set("long", @LONG
这里是假山的山顶，爬到这上面整个后花园是一览无余了。
由碎石堆砌而成的假山紧紧的靠着白色的院墙，从这里你可以
看到墙的那边青色的屋瓦。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
	"down" : __DIR__"garden",
	]));
	set("no_clean_up", 0);       
	set("item_desc",([
	"碎石"   :"都是些用碎石头，石缝紧密相连。\n",
	]));
	set("outdoors", "jakey");
	setup();
}

void init()
{
	add_action("do_climb","climb");
}

int do_climb(string arg)
{
	if (arg=="白色的院墙") {
		message_vision("$N扒住墙头，偷偷的爬了过去。\n",this_player());
		this_player()->move(__DIR__"woshi");
		message_vision("$N从窗户里爬了进来。\n",this_player());
		return 1;}
	else return 0;
}
