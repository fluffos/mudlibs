inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("陶土酒坛", ({ "jiu tan", "jiu" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一个陶土酒坛，里面装的是女儿红。\n");
    set("unit", "个");
    set("value", 10000);
    set("max_liquid", 5);
  }
  set("liquid", ([
    "name": "女儿红",
    "remaining": 5,
    "type": "alcohol",
    "drunk_apply": 6,
  ]));
  setup();
}
