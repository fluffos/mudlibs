inherit ITEM;
inherit F_FOOD;

void create()
{
     set_name("脆皮鸭", ({ "cuipi ya","ya" }));
    set_weight(1000);
    if( clonep() )
            set_default_object(__FILE__);
    else {
          set("long", "一只外皮焦黄，里面鲜嫩无比的脆皮鸭。\n");
          set("unit", "只");
          set("value", 1000);
          set("food_remaining", 10);
          set("food_supply", 120);
     }
}


