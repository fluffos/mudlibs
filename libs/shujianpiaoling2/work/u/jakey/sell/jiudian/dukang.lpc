inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("花瓷酒瓶", ({ "dukang" }));
        set_weight(1000);
        if( clonep() )
            set_default_object(__FILE__);
        else {
        set("long",
		"一个装着杜康佳酿的花瓷酒瓶。\n");
                set("unit", "瓶");
                set("value", 70000);
                set("max_liquid", 5);
        }
        set("liquid", ([
        	"name" : "杜康酒",
        	"remaining" : 5,
        	"type" : "alcohol",
		"drunk_apply":8,
        ]) );
        setup();
}

