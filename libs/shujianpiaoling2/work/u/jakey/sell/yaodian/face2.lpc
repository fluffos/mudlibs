// face off.c

#include <armor.h>

inherit HEAD;
	
void create()
{	
	set_name("乞丐面具", ({ "beggar face", "face" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long",	"一张用人皮制作的乞丐面具。\n");
		set("material", "cloth");
		set("armor_prop/armor", 3);
		set("armor_prop/id", ({"beggar"}) );
		set("armor_prop/name", ({"老乞丐"}) );
		set("armor_prop/short", ({"老乞丐(Beggar)"}) );
		set("armor_prop/long", ({
			"一个邋遢的老乞丐。\n"
		}) );
	}
	setup();
}
