inherit COMBINED_ITEM;

void create()
{
	set_name("薄荷草", ({"bohe cao","bohe"}));
	set("long",	"一株翠绿色的薄荷草。\n");
	set("unit", "株");
	set("base_unit", "株");
	set("value",300);
	set("base_weight", 300);
	set_amount(1);
}

void init()
{
	if( this_player()==environment() )
		add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	if( !arg || arg != "bohe")  return notify_fail("你要吃甚么呢? \n");

	message_vision(
	   "$N拿出一株翠绿的薄荷草吃了下去。\n",this_player()  );
	write("你吃下了一株薄菏草，精神觉得好多了。\n");
	this_player()->receive_heal("gin", 70);	
	add_amount(-1);
	return 1;
}
