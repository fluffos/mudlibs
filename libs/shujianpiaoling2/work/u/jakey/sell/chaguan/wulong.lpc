inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("小茶壶", ({ "wulong cha", "wulong" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一壶沏着乌龙茶的茶壶。\n");
    set("unit", "个");
    set("value", 200);
    set("max_liquid", 5);
  }
  set("liquid", ([
    "name": "乌龙茶",
    "remaining": 5,
    "type": "water"
  ]));
  set("liquid_type", "water");
  setup();
}
