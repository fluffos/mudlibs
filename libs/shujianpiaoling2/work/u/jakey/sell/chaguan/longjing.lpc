inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("小茶壶", ({ "longjing cha","longjing" }));
        set_weight(700);
        if( clonep() )
            set_default_object(__FILE__);
        else {
        set("long",
		"一壶沏着龙井茶的茶壶。\n");
                set("unit", "个");
                set("value", 200);
                set("max_liquid", 7);
        }
        set("liquid", ([
        	"name" : "龙井茶",
        	"remaining" : 7,
        	"type" : "water"
        ]) );
        set("liquid_type", "water");
        setup();
}

