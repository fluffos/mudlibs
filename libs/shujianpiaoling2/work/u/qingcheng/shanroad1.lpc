inherit ROOM;

void create()
{
        set("short", "灌县");
        set("long", @LONG
这里是四川灌县，西南三十里便是青城山。丈许宽的城墙又高又厚，给
人一种安全的感觉。遥望城外，绿色的田野一望无垠，一座座小小的农房星
星点点的点缀着宽广的田野，傍晚时，炊烟袅袅，夕阳斜照，美不胜收。远
处连绵的群山更是令人感到威武壮观。
LONG
        );
        set("exits", ([ 
		"northeast" : __DIR__"tulu2",
		"southup" : __DIR__"xiaolu21",
		"west" : __DIR__"chaguan",
]));
        set("objects", 
        ([
              "/npc/nknpc" : 1,
        ]));
        set("outdoors", "qingcheng");
        setup();
}


