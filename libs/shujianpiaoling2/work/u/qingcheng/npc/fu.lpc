
inherit NPC;
inherit F_MASTER;
string	summon_more( object who);

void create()
{
        set_name("傅青圭", ({ "fu qinggui", "fu" }) );
        set("gender", "男性");
        set("age", 28);
        set("long",
"傅青圭是余德的得意弟子，是七代弟子中最杰出的代表。\n" );
        set("inquiry", ([
                "here": "这里是闻名天下的青城山。",
                "加入": "要加入青城派可以先拜我，以后有所成就再拜其他长辈。",
                "拜师": "要加入青城派可以先拜我，以后有所成就再拜其他长辈。",
                "学艺": "要先拜师，才能学艺。",
        ]) ); 
        set("attitude", "peaceful");
        set("class","qingcheng");
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);

        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 10);

        set("combat_exp", 600000);
        set("score", 8000);

        set_skill("dodge", 80);
        set_skill("move", 70);
        set_skill("literate", 70);
        set_skill("parry", 70);
        set_skill("unarmed", 80);
        set_skill("force", 80);
        set_skill("sword", 80);

        set_skill("rain_sword",88);
        set_skill("rain_strike", 88);
        set_skill("siri_force", 88);
        set_skill("five-steps", 88);
        set_skill("dormancy", 40);

        map_skill("dodge", "five-steps");
        map_skill("unarmed", "rain_strike");
        map_skill("force", "siri_force");
        map_skill("parry", "rain_sword");
        map_skill("sword", "rain_sword");

        create_family("青城派", 7, "弟子");
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: summon_more(this_object()) :),
	}) );

        setup();

        carry_object("obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("id_type")== 2) {
	    command("say 本派乃名门正派，不收邪道人物。\n");
	    return;
	}
      if(ob->query_skill("rain_sword",1)< 50) {
	    command("say 你的本门剑法修为尚浅，还是先跟我师弟去学吧。\n");
	    return;
	}	
      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把青城发扬光大！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "qingcheng");
                ob->set("id_type", 1);
}
string summon_more(object who)
{
	int i;
	object *enemy;
	object another;
	seteuid(getuid());
	another = new(__DIR__"qcdizi2");
	if( (int)who->query_temp("summon_more") > 2)  return "　";
	another->move(environment(who));
	message_vision(another->name()+ "走了过来。\n"
		, this_object() );
	who->add_temp("summon_more",1);
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			another->kill_ob(enemy[i]);
			enemy[i]->kill_ob(another);
			another->set_leader(enemy[i]);
		}
	}
	return "1";
}
int accept_fight(object me)
{
	command("say 请不要在这里惹是生非。");
        return 0;
}


