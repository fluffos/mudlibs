#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_baohu();
void create() {
  set_name("青师太", ({ "master qing", "qing", "master" }));
  set("title", "青城派掌门师姐");
  set("gender", "女性");
  set("age", 76);
  //	set("nickname", HIG "" NOR);
  set("long",
    "青师太是掌门人铁肩道人的师姐，武功甚至在铁肩之上，但因其脾气火暴，未能坐掌门之位。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 8000000);
  set("score", 50000);

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("dodge", 230);
  set_skill("move", 230);
  set_skill("literate", 190);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("force", 230);
  set_skill("sword", 230);

  set_skill("rain_sword", 230);
  set_skill("rain_strike", 200);
  set_skill("siri_force", 230);
  set_skill("five-steps", 220);
  set_skill("dormancy", 250);

  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.pangtuo" :),
  }));
  set("inquiry", ([
    "随行": (: about_baohu :),
  ]));

  create_family("青城派", 4, "掌门师姐");
  set("class", "qingcheng");

  setup();
  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("gender") != "女性") {
    command("say 贫身向来不收男弟子。\n");
    return;
  }

  if (ob->query_skill("siri_force", 1) < 150) {
    command("say 本门武功均以四日玄功作为基础，你修为尚浅，应先在内功方面多下功夫。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把青城发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "qingcheng");
  ob->set("id_type", 1);
}

int about_baohu() {
  object me, soldier;
  object *t;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    command("say 对不起，你不是青城弟子！\n");
    return 1;
  }

  if (pointerp(t = me->query_team())) {
    command("say 已经有师兄弟保护你了，好自为之！\n");
    return 1;
  }
  command("say 好吧，我让你的师兄弟与你同行。\n");
  message_vision(CYN "\n从门外走进来一名青城弟子，躬身说道：师父请吩咐！\n" NOR, me);
  message_vision(HIM "\n青师太说道：青城弟子保护$N一起下山吧！\n" NOR, me);
  message_vision(CYN "\n青城弟子躬身说道：谨遵师命！\n" NOR, me);
  soldier = new(__DIR__ "qcdizi.lpc");
  soldier->move(environment(me));
  me->add_team_member(soldier);
  soldier->add_team_member(me);
  soldier->set_leader(me);
  soldier->set("possessed", me);
  return 1;
}
