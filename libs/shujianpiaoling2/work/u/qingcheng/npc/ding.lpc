inherit NPC;
inherit F_MASTER;

void create() {
  set_name("丁兆平", ({ "ding zhaoping", "ding" }));
  set("gender", "男性");
  set("age", 24);
  set("long",
    "丁兆平主要负责办理加入青城派的事宜，平时有贵客到来时也由他出面招呼。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的青城山。",
    "加入": "要加入青城派可以先拜我，以后有所成就再拜其他长辈。",
    "拜师": "要加入青城派可以先拜我，以后有所成就再拜其他长辈。",
    "学艺": "要先拜师，才能学艺。",
  ]));
  set("attitude", "peaceful");
  set("max_kee", 600);
  set("max_gin", 600);
  set("max_sen", 600);
  set("kee", 600);
  set("gin", 600);
  set("sen", 600);

  set("force", 600);
  set("max_force", 600);
  set("force_factor", 10);

  set("combat_exp", 300000);
  set("score", 3000);

  set_skill("dodge", 40);
  set_skill("move", 30);
  set_skill("literate", 20);
  set_skill("parry", 40);
  set_skill("unarmed", 40);
  set_skill("force", 40);
  set_skill("sword", 40);

  set_skill("rain_sword", 50);
  set_skill("rain_strike", 40);
  set_skill("siri_force", 40);
  set_skill("five-steps", 40);

  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");


  create_family("青城派", 7, "弟子");
  set("class", "qingcheng");

  setup();

  carry_object("obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 2) {
    command("say 本派乃名门正派，不收邪道人物。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把青城发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "qingcheng");
  ob->set("id_type", 1);
}
