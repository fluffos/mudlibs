
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("司马孟", ({ "sima meng", "sima" }) );
        set("gender", "男性");
        set("age", 46);
        set("long",
"司马孟是雨晴子的大弟子，据说曾是名门之后。\n"  );
        set("inquiry", ([
                "here": "这里就是青城派。",
        ]) ); 
        set("attitude", "peaceful");
        set("class","qingcheng");
	set("max_kee", 1800);
	set("max_gin", 1800);
	set("max_sen", 1800);
	set("kee", 1800);
	set("gin", 1800);
	set("sen", 1800);

        set("force", 1800);
        set("max_force", 1800);
        set("force_factor", 20);

        set("combat_exp", 1000000);
        set("score", 10000);

        set_skill("dodge", 120);
        set_skill("move", 120);
        set_skill("literate", 100);
        set_skill("parry", 120);
        set_skill("unarmed", 90);
        set_skill("force", 120);
        set_skill("sword", 90);

        set_skill("rain_sword",96);
        set_skill("rain_strike", 90);
        set_skill("siri_force", 120);
        set_skill("five-steps", 120);
        set_skill("dormancy", 120);

        map_skill("dodge", "five-steps");
        map_skill("unarmed", "rain_strike");
        map_skill("force", "siri_force");
        map_skill("parry", "rain_sword");
        map_skill("sword", "rain_sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "sword.pangtuo" :),
        }) );
        create_family("青城派", 6, "弟子");

        setup();

        carry_object("/obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("class")!="qingcheng") {
	    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
	    return;
	}

      if(ob->query_skill("siri_force",1)< 80) {
	    command("say 你的本门内功修为尚浅，拜师之事还是以后再说吧。\n");
	    return;
	}	
      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把青城发扬光大！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "qingcheng");
                ob->set("id_type", 1);
}


