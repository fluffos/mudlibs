inherit ROOM;

void create()
{
        set("short", "天师洞内");
        set("long", @LONG
天师洞为青城山的重心，洞中挂有被世人传颂为“天师道人”的张
道陵画像。青城山素以清幽著称，有“峨眉天下秀，三峡天下险，剑门
天下雄，青城天下幽”之誉。天师洞也被称为“天下第五洞天”。
LONG
        );
        set("exits", ([ 
	       "up" : __DIR__"tianshi",
]));
	set("objects",([
		__DIR__"npc/chidaoren" : 1,
		__DIR__"npc/chengdaoren" : 1,
		__DIR__"npc/huangdaoren" : 1,
		__DIR__"npc/lvdaoren" : 1,
		__DIR__"npc/qingdaoren" : 1,
		__DIR__"npc/landaoren" : 1,
		__DIR__"npc/zidaoren" : 1,
       	]));
        setup();
}
int valid_leave(object me, string dir)
{
        if ( me->query_temp("qingcheng/jianzhen") )
	me->delete_temp("qingcheng/jianzhen");
	return ::valid_leave(me, dir);
}


