inherit ROOM;

void create()
{
       
        set("short", "峭壁");
        set("long", @LONG
这里人迹罕至,让人觉得有点阴森。左右两边和前面都是高高的峭壁，
已经无路可走了。峭壁上长满了青苔和藤蔓。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
         "south" : __DIR__"yinghuo",
        ]));
        set("item_desc",([
        "藤蔓" : "你透过密密麻麻的藤蔓，隐约可见藤蔓后好象有一个洞口。\n",
        ]));
        set("no_clean_up", 0);
        setup();
}

void init()
{
        add_action("do_enter","enter");
        add_action("do_climb","climb");
}
int do_enter(string arg)
{
        if (arg!="洞口" && arg!="hole") return 0;
        message_vision("$N拨开密密麻麻的藤蔓，露出了一个洞口，$N弯腰钻了进去。\n",this_player());
        this_player()->move(__DIR__"hole1");
        message_vision("$N从外面钻了进来。\n",this_player());
        return 1;
}

int do_climb(string arg)
{
        if (arg!="up") return 0;
	if ( !wizardp(this_player()) )
	{
        write("你伸手抓住一根藤蔓，用力一拉，结果“啪”的一声，竟然把藤蔓扯断了。\n");
	return 1;
	}	
        write("你伸手抓住一根藤蔓，费力的向峭壁上面爬去。\n");
        this_player()->move(__DIR__"qiaobi1");
        message_vision("$N从悬崖下面爬了上来。\n",this_player());
        return 1;
}


