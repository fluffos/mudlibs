inherit ROOM;

void create() {
  set("short", "洗心池");
  set("long", @LONG
这是一泓清澈见底的水池，相传张道陵生前曾犯过重大过失，来到
青城山洗心池沐浴后，忽然顿悟前生，潜心向道，终于成为我国古代道
教创始人。由于道教讲究清心养性，故青城弟子常到这里静思悟道。
LONG
  );
  set("exits", ([
    "north": __DIR__ "xiaolu24",
  ]));
  set("objects", ([
    __DIR__ "npc/zhuang": 1,
  ]));
  set("resource/water", 1);
  set("outdoors", "qingcheng");
  setup();
}
