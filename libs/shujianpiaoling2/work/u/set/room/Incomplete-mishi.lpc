inherit ROOM;
void create()
{
        set("short", "秘室");
        set("long", "这里是磊磊藏宝的地方，地中央有台游戏机和一张大字报，\n"
        );
// This enables players to save this room as their startroom.
        set("valid_startroom", 1);
//        set("objects", 
//        ([ //sizeof() == 1
//                "/u/set/npc/dog.lpc" : 1,
//        ]));
        set("item_desc", ([
                "游戏机": "这是一台高级游戏机，上面还连着十台PentiumⅡ电脑，正联着Mud，\n"+
                          "如果有兴趣，你可以玩(play)一会儿。\n",
                "大字报": "这是WIZ们学习的好地方，可以看(look)一看。\n"+
                          "wiz的基本指令(zhiling1)          wiz的设定指令(zhiling2)\n",
                "zhiling1": "巫师指令1\n"+
"[admin]\n"+
"dump            生成一个当前内存的映象\n"+
"profile         生成指令运行的耗时记录\n"+
"\n"+
"[arch]\n"+
"ban             禁止指定地址的玩家上线\n"+
"callouts        列出或调用系统函数\n"+
"chinese         建立或删除英中对照关系\n"+
"cleanup         清楚无用的对象\n"+
"kickout         强迫指定玩家退出\n"+
"possess         附身到指定对象上\n"+
"promote         设置玩家等级\n"+
"purge           清除玩家档案\n"+
"reboot          重新启动 MudOS\n"+
"reclaim         清除内存中无用的变量\n"+
"rehash          刷新命令表\n"+
"wizlock         限制某个等级以下的玩家上线\n"+
"\n"+
"[wizard]\n"+
"chblk           关闭某人的某个频道\n"+
"config          显示本系统的启动配置\n"+
"cost            测量某条命令的执行时间\n"+
"edemote         编辑 emote\n"+
"gg              没有显示信息的 goto\n"+
"ghost           人鬼切换命令\n"+
"mudlist         Mud 列表\n"+
"qload           显示CPU负担\n"+
"setskill        设置指定玩家的武功级别\n"+
"smash           hehehe　只能用在自己身上,慎之！！\n"+
"snoop           监听\n"+
"summon          把某人抓过来\n"+
"ulist           显示所有玩家的编号\n"+
"unchblk         打开某人的某个频道\n"+
"\n"+
"[apprentice]\n"+
"call            调用指定对象的内部函数\n"+
"cat             显示文件内容\n"+
"clone           复制物品\n"+
"cp              拷贝文件\n"+
"dest            清除指定对象\n"+
"edit            编辑文件\n"+
"ff              查找函数的位置\n"+
"home            回到自己的 workroom\n"+
"ilist           列出一个物件所继承的所有物件\n"+
"info            列出一个物件的相关信息\n"+
"localcmds       列出你身上及四周环境所提供的命令\n"+
"mkdir           建立子目录\n"+
"mv              移动或改名\n"+
"name            修改你的名字\n"+
"rm              删除文件\n"+
"rmdir           删除子目录\n"+
"tail            显示文件最后几行\n"+
"test            给他一家伙\n"+
"title           修改 title\n"+
"update          重新编译文件\n"+
"whoami          显示你的 uid 和 euid\n"+
"[immortal]\n"+
"cd              改变当前目录\n"+
"goto            直接去某个地方\n"+
"ls              列目录\n"+
"mem             查看内存使用情况\n"+
"more            分页显示文件内容\n"+
"pwd             显示你的当前目录\n"+
"status          显示游戏的一些相关状态\n"+
"where           查看玩家位置\n",
                "zhiling2": "巫师指令2\n"+
"巫师环境变数\n"+
"\n"+
"immortal <anything>       设定自己成为不死之身，当状态达到昏迷或死亡时数值\n"+
"                          会停在 -1。\n"+
"invisibility <number>     设定隐形的程度。 0 - 10\n"+
"\n"+
"msg_home <anything>       设定当自己打 home 回家时显示的讯息。\n"+
"\n"+
"msg_min <anything>        设定当使用 goto 到达某处时, 别人所看到的讯息。\n"+
"\n"+
"msg_mout <anything>       设定当使用 goto 离开时, \n"+               "                          原来房间里的人所看到的讯息。\n"+
"\n"+
"msg_clone <anything>      设定当 clone NPC 或 OBJ 时所显示的讯息。\n"+
"\n"+
"msg_dest <anything>       设定当 dest NPC 或 OBJ 时所显示的讯息。但如果该 OBJ\n"+
"                          是存在於自己身上时则不会有讯息。\n",
        ]) );
        set("exits", ([ /* sizeof() == 1 */
  "out" : "/u/set/workroom",
]));
create_door("out", "金门", "enter", );
        set("no_clean_up", 0);
        setup();
        // To "load" the board, don't ever "clone" a bulletin board.
}
void init()
{
        add_action("do_play","play");
}
int do_play(string obj)
{
        if((obj!="mud")&&(obj!="游戏机"))return notify_fail("你要玩什么?\n");
        else
{
                if(this_player()->query("int")>50)
                {
                        this_player()->set("int",this_player()->query("int")+1);
                        this_player()->set("cps",this_player()->query("cps")+1)
;
                        this_player()->set("combat_exp",this_player()->query("combat_exp")+10000)
;
                        this_player()->set("potential",this_player()->query("potential")+1000)
;
                }
                message_vision("$N坐下来开始玩mud\n$N的知识增长了。\n$N的经验增长了。\n$N的潜能增长了。\n",this_player())
;
                this_player()->set("sen",this_player()->query("sen")-0);
                return 1;
        }
}     
