// xuanbei.c 玄悲

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("看门狗", ({"dog","master",}));
	set("long",
                "这是一位年过古稀的老僧人，不知何故被磊磊收买，改名看门狗。\n"
	);

	set("gender", "男性");
        set("attitude", "aggressive");
        set("title", "说不定什么时候就对你下口的");

	set("inquiry",([
		"空见" : "空见是现任少林主持。\n",
		"受伤" : "唉，老衲练功不慎，走火入魔，内伤严重。。\n",
		"伤" : "唉，老衲练功不慎，走火入魔，内伤严重。。\n",
		"治疗" : "这是内伤，无药可治的，除非。。。\n",
		"治伤" : "这是内伤，无药可治的，除非。。。\n",
		"除非什么" : "除非千年的灵芝，可这是可遇不可求的，唉！\n",
		"千年灵芝" : "不知道哪里有。。。\n",
	]));

	set("age", 75);

	set("max_gin", 2500);
	set("max_kee", 5000);
	set("eff_kee", 2000);
	set("kee",2000);
	set("max_sen", 2500);
	set("force", 10000);
	set("max_force", 5000);
	set("force_factor", 180 );
	set("combat_exp", 5000000);

	set_skill("force", 300);
	set_skill("fuxiang_force", 300);
	set_skill("puti_force", 300);
	set_skill("dodge", 300);
	set_skill("shaolin-dodge", 300);
	set_skill("staff", 300);
	set_skill("yizhi-chan", 300);
	set_skill("parry", 300);
	set_skill("unarmed", 300);
	set_skill("jingang-strike", 300);
	set_skill("sword", 300);
	set_skill("damo-sword", 300);

	set_skill("essencemagic", 250);
	set_skill("buddhism", 300);
	set_skill("magic", 300);
	set_skill("literate", 250);
	set_skill("zaahan_gong", 250);

	map_skill("force", "fuxiang_force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("unarmed", "jingang-strike");
	map_skill("parry", "damo-sword");
	map_skill("sword", "damo-sword");

        set("title", "说不定什么时候就对你下口的");
	create_family("少林寺", 2, "弟子");
	set("family/privs",1);

	setup();
	carry_object("/obj/weapon/longsword")->wield();
        carry_object("/u/tian/shaolin/npc/obj/qing_jiasha")->wear();
}

void init()
{
	set("eff_kee", 2000);
	set("kee",2000);
	add_action("do_apprentice","apprentice");
}

void attempt_apprentice(object ob)
{
	string name, new_name;
	mapping family = ob->query("family");
	string *prename =
	({"无","玄","空","明","静","智","虚","慧","觉","清"});

	if( ob->query("shaolin/shou")!=1||(ob->query("family/master_name")!="空见")){
		command("shake");
		message_vision("$n双手合十，对$N说道: 我是不轻易收徒弟的！\n",ob,this_object());
		ob->delete_temp("pending/apprentice");
		return;
	}

	command ("say 阿弥陀佛！老衲就收下你这个徒弟吧。");
	command("say 阿弥陀佛，善哉！善哉！没想到老衲行将就木，还能得此佳徒！");
	command("recruit " + ob->query("id"));

	name = ob->query("name");
	new_name=prename[(int)family["generation"]-2]+name[2..3];
	command("say 从今天起你就改名为"+new_name+"了。");
	ob->set("name",new_name);
	ob->set("title","少林寺高僧");
	ob->set("class","shaolin");
	ob->set("shaolin/tuijian",0);
	ob->set("shaolin/renwu",0);
	ob->delete("shaolin/shou");
}


int do_apprentice(string arg)
{
	int exp,nn,ii,rr;
	string old_t;
	object ob,me=this_player();

	if( !(me->is_apprentice_of(this_object()))) return 0;
	message_vision("$N跪了下来向$n恭恭敬敬地磕了个头，叫道：「师父好！」\n",me,this_object());
	command("smile");
	me->set("shaolin/renwu",0);
	return 1;
}


int accept_object(object me, object ob)
{

	if(me->query("class")!="shaolin") return 0;
	if(me->query("family/master_name")!="空见") return 0;
	if((ob->query("id")=="lingzhi")&&(me->query("id")==ob->query("own_name"))) {
		message_vision("$N把[千年灵芝]递给$n。\n",me,this_object());
		command("wa");
		command("say 你这是从哪里找到的？正是我需要的！\n");
		set("eff_kee", 2000);
		set("kee",2000);
	    remove_call_out("do_eat");
		call_out("do_eat", 2, this_player());
		return 1;
	}
	return 0;
}

void do_eat(object me)
{
	command("eat lingzhi");
	if(this_object()->query("eff_kee")!=this_object()->query("max_kee")){
		command("say 你怎么拿假货来骗老衲？？");
		command("heng");
		return;
	}
	command("haha");
	command("pat "+me->query("id"));
	command("say 难得你有此机缘治好我的伤，老衲就收你为徒吧！");
	me->set("shaolin/shou",1);
	return;
}
