inherit BULLETIN_BOARD;
void create()
{
        set_name("小黑板", ({ "board" }) );
        set("location", "/u/set/room/juxiantang.lpc");
        set("board_id", "tiger_board");
        set("long",     "这是一个漆黑的木版，来爱苗轩参观的各位朋友可以留下您的墨宝。\n" );
        setup();
        set("capacity", 30);
        replace_program(BULLETIN_BOARD);
}
