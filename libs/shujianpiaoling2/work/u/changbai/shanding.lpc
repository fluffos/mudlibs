#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", WHT "长白山顶" NOR);
        set("long", @LONG
你登上长白山顶，放眼望去，只见周围山峰环绕在长白山四周，如
孔雀开屏一般，迎面扑来的飒飒劲风吹得你衣袖飘飘，令你觉得天人合一，
豪兴大发,忍不住要高歌一曲。
LONG);
        set("exits", ([ 
	  "northeast" : __DIR__"blueroad1",
	  "southdown" : __DIR__"shanlu3"
   ]));
	set ("oldarea",32);
	set("outdoors","changbai");
	setup();
 }