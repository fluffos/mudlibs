#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", WHT "梯云峡" NOR);
        set("long", @LONG
此峡岩石裸露，形状如梯。山头终年云雾缭绕，即使是晴天也看不
清峰顶的轮廓。传说此峰直通天宫，是天庭和人间相连的天梯，因
此叫梯云峡。
LONG);
        set("exits", ([ 
    "southeast" : __DIR__"shanlu7",
	"northup" : __DIR__"cbshanlu1",
   ]));
	set ("oldarea",08);
	set("outdoors","changbai");
	setup();
 }