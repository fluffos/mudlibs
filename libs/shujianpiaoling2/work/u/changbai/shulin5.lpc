#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", WHT "桦树林" NOR);
        set("long", @LONG
这里是个桦树林，树枝挺拔，昂首对抗着冰冷的寒风和大雪，
那么多千年古树长得又如此相似，你不禁感叹大自然造物是多么
神奇伟大。
LONG);
        set("exits", ([ 
    "west" : __DIR__"kongdi",
	"southwest" : __DIR__"shulin4",
	"northwest" : __DIR__"shulin6",
   ]));
	set ("oldarea",30);
	set("outdoors","changbai");
	setup();
 }