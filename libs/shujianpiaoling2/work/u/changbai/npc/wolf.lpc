#include <ansi.h>
inherit NPC;
void use_poison();
void create()
{
        set_name( HIW "雪狼" NOR, ({ "snow wolf","wolf" }) );
        set("race", "野兽");
	set("str",40);
        set("age", 5);
        set("long", "一头全身银白，健壮凶残的雪狼。\n");
        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "bite" }) );
        set("attitude", "aggressive");
        set_skill("dodge", 100);
        set("chat_chance_combat", 10);
        set("chat_msg_combat", ({
                (: use_poison :),
        }) );
        set("combat_exp", random(500000));
	set("bellicosity", 999 );
        setup();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}

void use_poison()
{
        object *enemy, ob;
        string msg;

        enemy = query_enemy();
        if( sizeof(enemy) ) ob = enemy[random(sizeof(enemy))];

        tell_object(ob, HIR+"\n\n"+
name()+"向你扑上来，狼牙对着你一口咬下! 只听你一声残嚎．．．\n\n"  NOR);
                ob->receive_wound("kee",100);
}
void unconcious()
{
::die();
}
