#include <ansi.h>

inherit NPC;
void create() {
  set_name("游客", ({ "you ke", "ke" }));
  set("long", "一位报禁风霜的游人。\n");
  set("attitude", "friendly");
  set("max_gin", 500);
  set("max_kee", 500);
  set("max_sen", 500);
  set("age", 35);
  set("gender", "男性");
  set("combat_exp", 5000);
  set_skill("dodge", 50 + random(100));
  setup();
  carry_object("/obj/cloth")->wear();
}
