#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", WHT "大峡谷" NOR);
        set("long", @LONG
长白山大峡谷长70多公里，乃火山爆发后熔岩石表面的火山灰
和泥土被江水及雨水冲刷所致。北锦江从谷底流下，两岸怪石林立
，奇景叠生，栩栩如生，美不胜收。
LONG);
        set("exits", ([ 
  "south" : __DIR__"gudao4",
  "northeast" : __DIR__ "shangu1"
   ]));
	set ("oldarea",07);
	set("outdoors","changbai");
	setup();
 }