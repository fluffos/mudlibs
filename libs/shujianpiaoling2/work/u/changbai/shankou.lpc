#include <ansi.h>
inherit ROOM;
void create() {
  set("short", WHT "长白山口" NOR);
  set("long", @LONG
山上终年积雪，岩石多呈白色、灰白色，故名长白山。长白山山体高大，是东北松
花江、图们江和鸭绿江三大水系的发源地，素有山高水长之誉。
LONG);
  set("exits", ([
    "south": __DIR__ "shanxia",
    "northeast": __DIR__ "shanlu1",
  ]));
  set("oldarea", 01);
  set("outdoors", "changbai");
  setup();
}
