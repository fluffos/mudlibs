#include <ansi.h>
inherit ROOM;
void create() {
  set("short", WHT "崎岖山路" NOR);
  set("long", @LONG
你走在一条崎岖的山路上，路边长满杂草。前面是一处高高的是峭
壁，笼罩在云雾中，隐约可见。你仔细地盯着自己的脚下，不敢抬头望
一眼，惟恐一不小心摔下去。
LONG);
  set("exits", ([
    "southwest": __DIR__ "shanlu2",
    "northwest": __DIR__ "shanlu5",
    "northup": __DIR__ "shanlu4",
  ]));
  set("oldarea", 24);
  set("outdoors", "changbai");
  setup();
}
