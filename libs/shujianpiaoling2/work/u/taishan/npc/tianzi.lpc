#include <ansi.h>
inherit NPC;
string reward_more( object who);

void create()
{

	set_name("天字剑客", ({ "tianzi jianke", "tianzi", "jianke" }) );
	set("long", "这是一位泰山弟子，主守三才剑阵的“天”字位。\n");
	set("attitude", "friendly");

	set("str", 40);
	set("cor", 30);
	set("cps", 25);
	set("class", "taishan");
	set("max_kee", 1000);
	set("max_sen", 1000);

	set("combat_exp", 600000);
	set_skill("sword", 100);
	set_skill("parry", 100);
	set_skill("dodge", 200);
	set_skill("unarmed", 100);
	set_skill("force", 100);

        set_skill("three-sword",100);
        set_skill("pine_strike", 100);
        set_skill("liumai_force", 100);
        set_skill("star_dodge", 100);
        map_skill("dodge", "star_dodge");
        map_skill("unarmed", "pine_strike");
        map_skill("force", "liumai_force");
        map_skill("parry", "three-sword");
        map_skill("sword", "three-sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
	setup();
        carry_object("/obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
	object me = this_object();
        if( !ob || environment(ob) != environment() ) return;
	if( ob->query("class") != "taishan" && ob->query_temp("taishan/jianzhen")<1 )
	{
	command("say 好大的胆子，竟敢擅闯天地人三才剑阵，拿命来吧！\n");
	message_vision(CYN"$N长剑一振，展开了三才剑阵！\n" NOR, me, ob);
	message_vision(CYN"但见人影翻飞，剑光如虹，交织错落，登时将$n罩在一片剑网之中！\n" NOR, me, ob);
	me->set("combat_exp", (int)ob->query("combat_exp")*3/2 );
	if( ob->query("combat_exp") < 600000 )  me->set("combat_exp", 900000);
	me->kill_ob(ob);
	ob->kill_ob(me);
	ob->set("break_jianzhen", 0);
	}
	else
	{
	command("say 有人来闯阵了，三才就位！\n");
	message_vision(CYN"$N长剑一振，展开了三才剑阵！\n" NOR, me, ob);
	message_vision(CYN"但见人影翻飞，剑光如虹，交织错落，登时将$n罩在一片剑网之中！\n" NOR, me, ob);
	me->set("combat_exp", (int)ob->query("combat_exp") );
	if( ob->query("combat_exp") < 600000 )  me->set("combat_exp", 900000);
	me->fight_ob(ob);
	ob->fight_ob(me);
	}
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") > 1000000 ) return "1";
			enemy[i]->add("combat_exp", random(2)+1 );
		if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 500 ) return "1";
				enemy[i]->add("potential", random(2)+1 );
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 0;
}
void die()
{
	object me = this_player();
	if( me->query("id_type") == 2 )  me->add("break_jianzhen", 1);
	::die();
}
