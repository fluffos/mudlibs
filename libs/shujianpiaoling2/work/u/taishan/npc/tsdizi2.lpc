#include <ansi.h>

inherit NPC;
void create()
{

	set_name("泰山弟子", ({ "taishan dizi", "dizi" }) );
	set("long", "这是一位泰山弟子，专门担任保护之责。\n");
	set("attitude", "friendly");
	set("max_atman", 100);
	set("atman", 100);
	set("max_mana", 100);
	set("mana", 100);

	set("str", 40);
	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 90000);
	set_skill("sword", 90);
	set_skill("parry", 90);
	set_skill("dodge", 90);
	set_skill("unarmed", 90);
	set_skill("force", 90);

        set_skill("three-sword",50);
        set_skill("mian_strike", 50);
        set_skill("taiqing_force", 50);
        set_skill("ganchan_steps", 50);
        map_skill("dodge", "ganchan_steps");
        map_skill("unarmed", "mian_strike");
        map_skill("force", "taiqing_force");
        map_skill("parry", "three-sword");
        map_skill("sword", "three-sword");
	setup();
        carry_object("/obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();
}
int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	destruct(this_object());
}

