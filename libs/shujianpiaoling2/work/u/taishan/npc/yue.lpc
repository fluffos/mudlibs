
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("岳钟琪", ({ "yue zhongqi", "yue" }) );
        set("gender", "男性");
        set("age", 19);
        set("per", 25);
        set("str", 25);
        set("long",
"岳钟琪主要负责办理加入泰山派的事宜，平时有贵客到来时也由他出面招呼。\n" );
        set("inquiry", ([
                "here": "这里是闻名天下的泰山。",
                "加入": "要加入泰山派可以先拜我，以后有所成就再拜其他长辈。",
                "拜师": "要加入泰山派可以先拜我，以后有所成就再拜其他长辈。",
                "学艺": "要先拜师，才能学艺。",
        ]) ); 
        set("attitude", "peaceful");
	set("max_kee", 600);
	set("max_gin", 600);
	set("max_sen", 600);
	set("kee", 600);
	set("gin", 600);
	set("sen", 600);

        set("force", 600);
        set("max_force", 600);
        set("force_factor",10);
        set("combat_exp",200000);
        set("score",300);

        set_skill("dodge", 60);
        set_skill("move", 60);
        set_skill("literate", 60);
        set_skill("parry", 60);
        set_skill("unarmed", 60);
        set_skill("force", 60);
        set_skill("sword", 60);

        set_skill("three-sword",65);
        set_skill("pine_strike", 65);
        set_skill("liumai_force", 65);
        set_skill("star_dodge", 65);

        map_skill("dodge", "star_dodge");
        map_skill("unarmed", "pine_strike");
        map_skill("force", "liumai_force");
        map_skill("parry", "three-sword");
        map_skill("sword", "three-sword");
        create_family("泰山派", 3, "弟子");
        set("class","taishan");
        set("chat_chance", 10);
        set("chat_msg", ({
                "岳钟琪对着你点了点头。\n",
                (:random_move :)
        }) );

        setup();

        carry_object("/obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("id_type")== 2) {
	    command("say 本派乃名门正派，不收邪道人物。\n");
	    return;
	}
      if(ob->query("gender")!="男性") {
	    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜我的师妹吧。\n");
	    return;
	}

      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把泰山发扬光大！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "taishan");
                ob->set("id_type", 1);
}


