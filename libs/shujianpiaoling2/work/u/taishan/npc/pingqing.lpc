#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("平青", ({ "ping qing", "ping" }));
  set("gender", "男性");
  set("age", 36);
  set("str", 35);
  set("nickname", HIG "玉箫" NOR);
  set("long",
    "玉箫平青是“江湖双秀”之一，武功在武林中独树一帜，据说来自东海遥远的桃花岛。\n");
  set("inquiry", ([
    "桃花岛": "清尘庵主是我的师父，但是东海茫茫，连我也说不清岛的具体方位。",
  ]));
  set("attitude", "peaceful");
  set("max_kee", 800);
  set("max_gin", 800);
  set("max_sen", 800);
  set("kee", 800);
  set("gin", 800);
  set("sen", 800);

  set("force", 1200);
  set("max_force", 1200);
  set("force_factor", 40);
  set("combat_exp", 900000);
  set("score", 1000);

  set_skill("dodge", 80);
  set_skill("move", 80);
  set_skill("literate", 80);
  set_skill("parry", 80);
  set_skill("unarmed", 80);
  set_skill("force", 80);
  set_skill("sword", 80);

  set_skill("luoying_sword", 100);
  set_skill("liheforce", 50);
  set_skill("zhengqijue", 60);
  set_skill("luohua_steps", 100);

  map_skill("dodge", "luohua_steps");
  map_skill("force", "liheforce");
  map_skill("parry", "luoying_sword");
  map_skill("sword", "luoying_sword");
  create_family("桃花岛", 3, "弟子");
  set("class", "taohua");
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();

  carry_object(__DIR__ "obj/yuxiao")->wield();
  carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 2) {
    command("say 本派乃名门正派，不收邪道人物。\n");
    return;
  }

  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "既然与在下有缘，就收下你吧！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "taohua");
  ob->set("id_type", 1);
}
