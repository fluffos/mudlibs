inherit ROOM;
string *jglist = ({ "/daemon/troop/taohua/*.lpc" });
void create() {
  string jgobj;
  mixed objfile;
  string path;
  int i, j, m;
  set("short", "安然居");
  set("long", @LONG
这里就是小狗娃和安儿的新居了。原木为篱，青藤作绳，粗粗围就一方院落。
柴门不甚坚固，主人也似乎并不在乎。几枝青青蔓萝藤，缠绕而上，微风中柔柔摆
动。门两旁高书：花径不曾缘客扫  柴门今始为君开  正中横书：安然居。
LONG
  );

  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "road3",
    "north": __DIR__ "cyard",
  ]));
  m = random(sizeof(jglist));
  path = jglist[m];
  objfile = get_dir(path);
  path = replace_string(path, "*.lpc", "");
  i = sizeof(objfile);
  for (j = 0; j < i; j++) {
    jgobj = (path + objfile[random(i)]);
    if (!jgobj) jgobj = (path + objfile[random(i)]);
    if (!jgobj) continue;
    break;
  }

  set("objects", ([
    __DIR__ "npc/dog": 1,
    jgobj: 1,
  ]));

  set("outdoors", "taoyuan");
  setup();
  replace_program(ROOM);

}
