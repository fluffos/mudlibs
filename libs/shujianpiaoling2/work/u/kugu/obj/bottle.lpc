// bottle.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("葫芦", ({ "bottle" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个装酒的大葫芦，大概装得十升的酒。\n");
		set("unit", "个");
		set("value", 20);
		set("max_liquid", 15);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
		"name": "女儿红",
		"remaining": 15,
		"drunk_apply": 6,
	]) );
}
