// Room: /d/sanyen/tower.c
#include <ansi.h>
inherit ROOM;
int do_sweep(string arg);
int complete_sweep(object me);

void create() {
  set("short", "塔林");
  set("long", @LONG
你正站在两座高塔前, 左边这一座名曰: 『明心塔』, 右方名叫
『见性塔』　历来, 当枯骨寺中的高僧涅盘後, 遗体火化後所得的舍
利子就存放在这两座塔里。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "back_temple",
  ]));

  set("objects", ([
    __DIR__ "npc/work_bonze": 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "kugu");
  set("no_fight", 1);
  set("hell", 1);
  set("no_study", 1);
  set("no_magic", 1);
  set("no_spells", 1);

  setup();
}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("complete_sweep", random(10) + 3, ob);
  add_action("do_sweep", "sweep");
  add_action("close_cmds", "fight");
  add_action("close_cmds", "exert");
  add_action("close_cmds", "perform");
}
int close_cmds(object me, string arg) {
  return 1;
}

int do_sweep(string arg) {
  object me = this_player();
  if (arg != "ground")
    return notify_fail("你要干什么？\n");
  if (me->query("marks/kgjob") != "broom")
    return notify_fail("你并没有扫塔林的任务。\n");
  if (me->query_temp("sweep_ground") > 20)
    return notify_fail("你的工作已经完成了。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (me->query("sen") < 22)
    return notify_fail("你心神不定，无法静下心来扫塔林。\n");
  if (!me->query_temp("sweep_ground"))
    message_vision(CYN "$N挥起扫帚，全神贯注地扫起地来。\n" NOR, me);
  else
    message_vision(CYN "$N一边扫地，一边用拂尘顺手掸着高塔上的灰尘。\n
$N挥起扫帚，全神贯注地扫起地来。\n" NOR, me);
  me->start_busy(6);
  me->receive_damage("sen", random(20) + 1);
  if (me->query_skill("unarmed", 1) < 20) {
    me->improve_skill("unarmed", random((int)me->query("kar")) + 10);
    me->add("potential", 1);
  }
  me->add("life_exp", random(10) + 1);
  me->set_temp("sweep_now", 1);
  return 1;
}
int complete_sweep(object ob) {
  int i;
  int damage;
  object herb;
  if (!ob->query_temp("sweep_now")) {
    call_out("complete_sweep", random(20) + 1, ob);
    return 0;
  }
  if (ob->query_temp("sweep_ground") < 20 && environment(ob) == this_object()) {
    tell_object(this_object(), "\n高塔四周一片静谧，偶尔传来几声鸟虫的低鸣。\n");
    ob->add_temp("sweep_ground", 1);
    if (environment(ob) == this_object())
      call_out("complete_sweep", random(20) + 1, ob);
  } else {
    ob->remove_call_out("complete_sweep");
    tell_object(this_object(), CYN "\n你将高塔四周打扫了个干净，你的任务终于完成了。\n\n" NOR);
    herb = new("/obj/toy/broom");
    herb->move(ob);
    ob->delete_temp("sweep_ground");
    ob->delete_temp("sweep_now");
    ob->delete("marks/kgjob");
    //	ob->move("/u/emei/xiaolu22");
  }
  return 1;
}
int valid_leave(object me, string dir) {
  object ob;
  if (me->query_temp("sweep_now"))
    return notify_fail("你的扫地工作还没有做完，怎么就离开了呢？\n");
  return ::valid_leave(me, dir);
}
