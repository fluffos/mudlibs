inherit ROOM;

void create()
{
        set("short", "山路");
        set("long", @LONG
两旁怪石林立，各具形态，观之令人浮想联翩。偶尔有几个香客
擦肩而过。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
            "northup" : __DIR__"yiweitin",
            "southdown" : __DIR__"shanlu4",
]));
	set("objects",([
	__DIR__"npc/xiangke" : 1,
	]));

	set("outdoors","shaolin");
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}