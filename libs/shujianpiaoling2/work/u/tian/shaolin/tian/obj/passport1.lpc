// air1.c

inherit ITEM;
inherit F_AUTOLOAD;

int query_autoload() { return 1; }


void create()
{
    set_name("少林通行证", ({ "passport", "zheng" }) );
    set_weight(100);
    set("long", @LONG 
这是一张到少林寺的通行证，fly shaolin,使用后可到达少林地区。
LONG
  );
    set("value", 300);
    set("unit", "张");
    set("material", "paper");
//    set("no_drop","风之符看来无法丢弃。\n");

}

void init()
{
    add_action("do_fly", "fly");
}

int do_fly(string arg)
{
    string obj;
    if( !arg )
        return notify_fail("你想飞到哪里 ？\n");

	if( this_player()->is_fighting() )
        return notify_fail("你在战斗中，无法使用。\n");
    switch(arg) {
        case "shaolin":
             obj="/u/playboy/shaolin/tulu1";
             break;
        default:
             return notify_fail("你不能飞到那个地方 !\n");
             return 1;

    }
    message_vision("在一阵烟幕中，只见$N的身影忽然消失了。\n", this_player());

    this_player()->move(obj);

    message_vision("$N的身影忽然在一阵烟幕中神秘地出现了。\n", this_player());

    return 1;
}

