inherit ROOM;

void create()
{
        set("short", "上山台阶");
        set("long", @LONG
一长列宽大的石阶如同天梯蜿蜒而上，规模宏大，是唐朝时为迎
接高宗皇帝驾临少林寺而开凿。据说是九里十八弯。
    往北是条小路，西面似乎是片碑林。
LONG
        );
        set("exits", ([/* sizeof() == 3 */
