// jingang.c 大力金刚

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
	int damage;

	if(!target) target = offensive_target(me);

	if(!target||!target->is_character()||!me->is_fighting(target))
		return notify_fail("[大力金刚]只能战斗时用。\n");

	if((int)me->query_skill("jingang-strike",1)<80 )
		return notify_fail("你的[金刚神掌]修行不够，不能使用绝技。\n");
	if((int)me->query("force") - (int)me->query("max_force") < 150)
		return notify_fail("你的真气不够。\n");
	me->add("force", -150);

	message_vision(HIR "$N大喝一声，腾空飞起，使出绝技[大力神掌]，直向$n的身上击去！\n" NOR, me, target);
	me->start_busy(2);

	if( random(me->query("kar")+18)>target->query("kar")&&
		(random(me->query_skill("dodge")+target->query_skill("dodge"))+70>target->query_skill("dodge"))){
		damage = (int)me->query_skill("unarmed")*3-(int)target->query_skill("dodge")*2;
		damage += (int)me->query_skill("force")*3-(int)target->query_skill("force")*2;
		damage = random(damage)+random(me->query("kar"));
if(wizardp(me)) printf("damage = %d\n",damage); 
		if(damage>0){
			target->receive_damage("kee", damage);
			target->receive_wound("kee", damage/2);
			target->receive_wound("sen", damage/3);
			message_vision(HIR "只听“嘭”的一声，$N的双掌击在$n身上，$n连连后退几步，坐在地上\n" NOR, me,target);
			target->start_busy(3);
		}
	}                
	else {
		message_vision(CYN "$n身形急转，闪到一边，$N进攻不成，漏出破绽\n" NOR, me,target);
	}
	return 1;
}


