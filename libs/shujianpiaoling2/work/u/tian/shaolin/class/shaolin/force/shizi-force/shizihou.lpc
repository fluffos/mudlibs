// shizihou.c

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target)
{
	object *ob;
	int i, skill, damage;

	if(me->is_busy()) 
		return notify_fail("你上个动作还没结束呢。\n");

	if( environment(me)->query("no_fight") )
		return notify_fail("这里禁止战斗。\n");

	if( (int)me->query("force") < 150 )
		return notify_fail("你的内力不够。\n");

	skill = me->query_skill("force");

	me->add("force", -150);

	me->start_busy(2);
	message_vision(
		HIR "$N双手合十，闭目凝神一会，猛然大吼一声，如同狮子一般！\n" NOR, me);

	ob = all_inventory(environment(me));
	for(i=0; i<sizeof(ob); i++) {
		if( !living(ob[i]) || ob[i]==me ) continue;
		if( skill/2 + random(skill/2) < (int)ob[i]->query("cps") * 2 ) continue;
		
		damage = skill*2 - ((int)ob[i]->query("max_force") / 4);
//printf("%d %d ",damage,(int)ob[i]->query("cps"));
		if( damage > 0 ) {
			ob[i]->receive_damage("sen", damage);
			if( (int)ob[i]->query("force") < skill * 15 )
				ob[i]->receive_wound("sen", damage/3);
			tell_object(ob[i], "你感觉耳朵一阵剧痛，头象要裂开了，神志一阵模糊！\n");
		}
		
		if( userp(ob[i]) ) ob[i]->fight_ob(me);
		else if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);
	}

	return 1;
}

