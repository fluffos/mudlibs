//xctang 心禅堂
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "心禅堂");
  set("long", @LONG
这里是少林寺的心禅堂。是少林弟子静心修行的地方，高高的莲花
台上端坐着三座金身佛像，台前放着几个蒲团，供弟子打坐、忏悔用。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "south": __DIR__ "xiaoyuan2",
  ]));
  set("item_desc", ([
    "佛像": "佛像双目微合，面带笑容，看上去倍感亲切。\n",
    "佛像 1": "这是左面的一个较小的佛像。\n",
    "佛像 2": "这是中间的大佛像，周身金碧辉煌，连佛像背后都刷了金粉。\n",
    "佛像 3": "这是右面的一个较小的佛像。\n",
    "背后": "佛像背后有一副对联：
梵天宫殿，悬日月之光华

佛地园林，动烟云之气色\n",
  ]));

  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/huineng": 1,
  ]));


  setup();
  //        replace_program(ROOM);
}

void init() {
  object me = this_player(), seng;

  add_action("do_chanhui", ({ "chanhui" }));

}

int do_chanhui(string arg) {
  object ob = this_object(), me = this_player();

  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if ((int)me->query("bellicosity") <= 0)
    return notify_fail("你现在毫无杀气，不用忏悔。\n");

  message_vision(
    HIC "$N扑通一声跪在蒲团上，双手合十，双目紧闭，口中念念有词，虔心忏悔....\n" NOR, me);
  me->set("bellicosity", 0);

  me->start_busy(10);
  call_out("do_qi", 10, me);
  return 1;
}

void do_qi(object me) {
  message_vision("过了良久，$N感觉灵台空明，心平气静，站起身来。\n", me);
  me->add("potential", 2);
}
