// changlang3  长廊

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "长廊");
	set("long", @LONG
你走在一条长廊上，架上青藤缠绕，紫色的小花散发着淡淡的清香。
西面尽头是舍利院，北面是菩提院。
LONG
	);

	set("exits", ([
		"east" : __DIR__"changlang2",
		"west" : __DIR__"slyuan",
            "north": __DIR__"ptyuan",
	]));
	
	setup();
	replace_program(ROOM);
}
