inherit ROOM;

void create()
{
        set("short", "悟道堂");
        set("long", @LONG
这里是少林寺的悟道堂。一座高大古朴的禅堂，正中莲花石座上是
达摩祖师的雕像，闭目沉思，神像庄严。前面有一大块方正的白玉石，
相传祖师曾在此顿悟禅机。南面是一间小院。
LONG
        );
        set("exits", ([/* sizeof() == 1 */
           "south"  : __DIR__"xiaoyuan4",
]));
	set("objects",([
	__DIR__"npc/zhixia" : 1,
	]));

        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}