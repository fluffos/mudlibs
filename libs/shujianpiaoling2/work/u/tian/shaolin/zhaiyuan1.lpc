#include <room.h>
inherit ROOM;

void create()
{
	set("short", "斋院");
	set("long", @LONG
这里便是少林寺僧人用斋的地方。斋院极大，从南到北一排
排摆满了长长的餐桌和长凳，几位小和尚正来回忙碌着布置素斋，
看情形可以容纳几百个人同时进餐。
LONG
	);

	set("exits", ([
            "north": __DIR__"liangong6",
	]));
	
	setup();
	replace_program(ROOM);
}
