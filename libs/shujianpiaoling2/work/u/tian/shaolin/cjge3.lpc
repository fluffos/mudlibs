//cjge3  藏经阁三楼
inherit ROOM;

string look_fojing();
string look_book();
string *book = ({
"『大罗汉经』"  ,"luohan-ken"   ,25,20,
"『大光明经』"  ,"fuhu-ken"     ,25,20,
"『维舍论经』"  ,"sanhua-strike",25,20,
"『礼真如经』"  ,"nianhua-zhi"  ,25,20,
"『五龙经』"    ,"longzhua"     ,25,20,
"『大般若经』"  ,"banruo-strike",25,20,

"『佛本行经』"  ,"cibei-blade"  ,25,20,
"『达摩经』"    ,"damo-sword"   ,25,20,
"『虚空藏经』"  ,"shaolin-dodge",25,20,
"『涅槃经』"    ,"essencemagic" ,30,20,
"『菩萨经』"    ,"magic"        ,10,20,
"『释迦经』"    ,"buddhism"     ,10,20,
});

void create()
{
        set("short", "藏经阁三楼");
        set("long", @LONG
这是藏经阁三楼，只见阁中窗明几净，打扫的纤尘不染。左右两排
红木书架摆满了佛经，几个老年僧人正专心致志的默读佛经。
LONG
        );
        set("exits", ([/* sizeof() == 3 */
//           "up" : __DIR__"cjge3",
           "down" : __DIR__"cjge2",
]));
	set("item_desc",([
	"书架"	:(: look_book :),
	"佛经"	:(: look_fojing :),
	"格子"	:"每个书架分成六个格子，里面的佛经排放整齐。\n",
	]));

        set("no_clean_up", 0);

        setup();
}

void init()
{
	this_player()->set_temp("left",6);
	set("push",0);

	add_action("do_du", ({"read"}));
	add_action("do_zou", ({"zou"}));
	add_action("do_push", ({"push"}));
}

void reset()
{
	::reset();
	delete("push");
//	delete("right");
}

int do_push(string arg)
{
	object ob,ob1,me = this_player();

	if(!arg) return 0;
	if(me->query("class")!="shaolin"&&me->query("class")!="shaolin1") return 0;
	if(arg!="佛经") return 0;
	if(me->query_temp("left")!=6){
		write("你伸手在佛经上一推，只见佛经微微一动，你身边传来喀哒一声。\n");
		if(me->query_temp("left")==3&&query("push")==0){
			set("push",1);
			return 1;
		}
		if(me->query_temp("left")==11&&query("push")==1){
			set("push",2);
			return 1;
		}
		if(me->query_temp("left")==1&&query("push")==2){
			set("push",3);
			return 1;
		}
		if(me->query_temp("left")==7&&query("push")==3){
			if(random(me->query("kar"))>15){ 
				write("你发现身边的墙上居然打开一道暗门，里面很暗，看不清有什么。\n");
				write("你犹豫了一下，还是鼓足勇气钻了进去。\n");
				if(random(me->query("kar"))>15){ 
					write("暗门在你身后又关上了。\n");
					ob=(object)__DIR__"cjge4";
					tell_room(ob,me->query("name")+"走了进来。\n");
					me->move(ob);
					tell_room(this_object(),me->query("name")+"一闪身，不见了。\n");
					return 1;
				}
				write("你一脚踏进去，发现里面居然是空的，连楼板都没有。\n");
				write("你大叫一声，直摔到楼下。\n");
				ob=(object)__DIR__"cjge";
				tell_room(ob,me->query("name")+"走了过来。\n");
				me->move(ob);
				tell_room(this_object(),me->query("name")+"一闪身，不见了。\n");
				return 1;
			}
			set("push",4);
			return 1;
		}
		set("push",99);
		return 1;
	}
	return 0;
}

string look_book()
{
	object me=this_player();

	if(me->query_temp("left")==6) 
		return "左右各是一排高大的红木书架，分成好多格子，放满了各种佛经。\n";
	if(me->query_temp("left")<6)
		return "你站在左边书架的第"+(string)(6-me->query_temp("left"))+"个格子的前面。\n";
	if(me->query_temp("left")>6)
		return "你站在右边书架的第"+(string)(me->query_temp("left")-6)+"个格子的前面。\n";
	return 0;
}

string look_fojing()
{
	object me=this_player();

	if(me->query_temp("left")==6) 
		return "你离佛经太远了，看不清是什么佛经。\n";
	if(me->query_temp("left")<6)
		return "你看看格子里的佛经，发现是一本"+book[me->query_temp("left")*4]+"。\n";
	if(me->query_temp("left")>6)
		return "你看看格子里的佛经，发现是一本"+book[(me->query_temp("left")-1)*4]+"。\n";
	return 0;
}

int do_zou(string arg)
{
	object ob,ob1,me = this_player();
	string sth,sb;

	if(!arg) return 0;
	if(sscanf(arg, "%s %s", sth, sb)!=2 ) return 0;
	if(sth!="书架") return 0;
	if(sb=="左"){
		if(me->query_temp("left")<=0){
			write("你已经走到书架的最左边了！\n");
			me->set_temp("left",0);
			return 1;
		}
		write("你往左走了一步。\n");
		me->add_temp("left",-1);
		return 1;
	}
	if(sb=="右"){
		if(me->query_temp("left")>=12){
			write("你已经走到书架的最右边了！\n");
			me->set_temp("left",12);
			return 1;
		}
		write("你往右走了一步。\n");
		me->add_temp("left",1);
		return 1;
	}
	return 0;
}

int do_du(string arg)
{
	object ob=this_object(),me=this_player();
	int my_skill;
	int cost,cost1,cc,nn;

	if(me->query("class")!="shaolin"&&me->query("class")!="shaolin1") return 0;
	if(me->query_temp("sleeping")||me->query_temp("dazuo")||me->is_fighting() ){
		write("你现在无法学习！\n");
		return 1;
	}
	if(arg!="佛经") {
		write("你要看什么？\n");
		return 1;
	}
	nn=me->query_temp("left");
	if(nn==6){
		write("你站在走道里看什么？\n");
		return 1;
	}
	if(nn<0) nn=0;
	if(nn>6) nn=nn-1;
	if(nn>12) nn=12;

	if( !me->query_skill("literate", 1) ){
		write("你是个文盲，先学学读书识字(literate)吧。\n");
		return 1;
	}

	message("vision", me->name() + "专心读了一遍佛经。\n", environment(me), me);
	cc=35-me->query_kar();
	if(cc<0) cc=0;

	if( (int)me->query("combat_exp") < 10000*cc+10000 ) {
		write("你的实战经验不足，再怎麽读也没用。\n");
		return 1;
	}

//	if( !SKILL_D(skill["name"])->valid_learn(me) ) return 0;

	cost1=(int)book[nn*4+2]+cc*2;

	cost = cost1 + cost1* ((int)book[nn*4+3] - (int)me->query_int())/20;
printf("%d ",cost);
	if( (int)me->query("sen") < cost ) {
		write("你现在过於疲倦，无法专心下来研读新知。\n");
		return 1;
	}

	me->receive_damage("sen", cost);

	if( !me->query_skill(book[nn*4+1], 1) )
		me->set_skill(book[nn*4+1], 0);

    my_skill = me->query_skill(book[nn*4+1], 1);
	if(my_skill>(me->query_kar()-20)*10) {
		write("好象是缘分已尽，你再怎么读也没用。\n");
		return 1;
	}
    if( my_skill * my_skill * my_skill/10 >	(int)me->query("combat_exp") ) {
		write("也许是缺乏实战经验，你没有任何收获。\n");
		return 1; 
	}

	me->improve_skill(book[nn*4+1], (int)me->query_skill("literate", 1)/5+1);
	write("你研读有关" + to_chinese(book[nn*4+1]) + "的技巧，有点心得。\n");
	return 1;
}
