//shufang  书房

inherit ROOM;

void create() {
  set("short", "书房");
  set("long", @LONG
这是一间极为简陋的书房。环视四周，房里有一张长桌(table)，
上面放着一堆堆的佛经，几位须发花白的老僧正在坐在蒲团上面，专心
致志忙着修补整理书籍。
    你可以用毛笔在这里抄写经文(chaojingwen)。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "liangong3",
  ]));
  set("objects", ([
    __DIR__ "npc/xukong": 1,
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "长桌": "一张长方形木桌，堆满了佛经，还有一些纸墨，供弟子抄经文用。\n",
    "table": "一张长方形木桌，堆满了佛经，还有一些纸墨，供弟子抄经文用。\n",
  ]));

  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_chao", ({ "chaojingwen" }));
  add_action("do_search", ({ "search", "zhao" }));
}

int do_search(string arg) {
  object me = this_player(), ob;

  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (!arg) return 0;
  if (arg != "木桌") return 0;
  message_vision("$N找到什么东西。\n", this_player());
  ob = new(__DIR__ "obj/baizhi");
  ob->move(me);
  return 1;
}

int do_chao() {
  object me = this_player(), ob;
  int nn, skill_n, kee_cost;

  if (me->query("class") != "shaolin1" && me->query("class") != "shaolin") return 0;
  if (!(ob = present("maobi", me))) return 0;
  seteuid(getuid());
  if (me->query("id") != ob->query("own_name")) {
    printf("这不是你的东西，你不能用!\n");
    return 1;
  }
  if (!(ob = me->query_temp("weapon"))) {
    message_vision("$N拿起经文翻了翻，发现上面写的都不认识。\n", me);
    return 1;
  }
  if (ob->query("name") == "毛笔") {
    if (me->query_temp("sleeping"))
      return notify_fail("你正在睡眠中，不能干别的。\n");
    if (me->query_temp("dazuo"))
      return notify_fail("你正在打坐练功，不能干别的。\n");
    if (me->is_fighting())
      return notify_fail("你已经在战斗中了，专心点吧。\n");

    kee_cost = 40 + (30 - me->query("int"));
    if (kee_cost < 1) kee_cost = 1;
    if (me->query("kee") < kee_cost)
      return notify_fail("休息一下吧，你现在太累了。\n");
    me->receive_damage("kee", kee_cost);
    if (me->query("shaolin/renwu_type") != "抄经文") {
      if (me->query_skill("magic", 1) > 30)
        return notify_fail("你把经文从头到尾抄了一遍，发现对你已没什么用了。\n");
      skill_n = me->query_skill("magic", 1);
      if (skill_n * skill_n * skill_n / 10 > me->query("combat_exp"))
        return notify_fail("也许是缺乏经验吧，你把经文从头到尾抄了一遍，好象没有什么收获。\n");
      message_vision("$N把经文从头到尾抄了一遍，好象学到什么。\n", me);
      nn = (me->query("int") - 20);
      if (nn < 1) nn = 1;
      me->improve_skill("magic", nn, 0);
      return 1;
    } else {
      if (me->query("shaolin/renwu_nn") == 0)
        return notify_fail("你已经完成任务，快回去汇报吧。\n");
      me->add("shaolin/renwu_nn", -1);
      if (random(me->query("kar")) > 13) {
        me->add("combat_exp", 10);
        me->add("potential", 5);
      }
      return notify_fail("你把经文从头到尾抄了一遍。\n");
    }
  } else {
    message_vision("有没有搞错？看清楚你手里拿的是什么？\n", me);
    return 1;
  }
  return 0;
}
