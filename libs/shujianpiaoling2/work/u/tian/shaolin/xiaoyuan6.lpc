//xiaoyuan6  小院
inherit ROOM;

void create() {
  set("short", "小院");
  set("long", @LONG
这是寺里最后面的小院。平时少有人迹，墙角杂草从生，显得有些
荒凉。北面是少林寺后门，南面是讲经台。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "jjtai",
    "north": __DIR__ "houmen",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "shaolin");

  setup();
  //        replace_program(ROOM);
}

void init() {
  add_action("do_search", ({ "search", "zhao" }));
}

int do_search(string arg) {
  object ob;

  if (arg != "grass") return 0;
  if ((int)query("zhao") == 1)
    return notify_fail("这里只有些杂草，没有别的。\n");
  set("zhao", 1);
  message_vision("$N从地上找到什么东西。\n", this_player());
  ob = new(__DIR__ "obj/tiekey");
  ob->move(this_player());
  return 1;
}

void reset() {
  ::reset();
  delete("zhao");
}
