// fangjuwu 防具屋
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "防具屋");
	set("long", @LONG
这里便是少林寺存放防身器具的地方，各种各样的防具应有
尽有，墙上(wall)地下到处都是。凡是少林弟子下山之前都可以在
这里领取防具。有一个小和尚专门负责发放，不过现在他没在这里。
LONG
	);

	set("exits", ([
            "north": __DIR__"liangong6",
	]));
	set("item_desc",([
		"墙上"	:"你仔细看看墙上，发现还有一扇小门。\n",
		"wall"	:"你仔细看看墙上，发现还有一扇小门。\n",
		"地上"	:"地上散乱地放着些用过的防具，还有一个打坏的木头人。\n",
	]));
	
	setup();
//	replace_program(ROOM);
}

void init()
{
	add_action("do_qiao", ({"qiao","knock"}));
}

int do_qiao(string arg)
{
	object ob,me=this_player();

	if(arg != "小门") return 0;
	if(me->query("class")!="shaolin"&&me->query("class")!="shaolin1") return 0;
	ob=present("zhi zhuo",environment(me));
	if(ob) {
		write("智拙对你说：还敲什么？我不是在这里吗？\n");
		return 1;
	}
	write("你在小门上使劲敲了几下，小门应声开了，走出防具屋的管事智拙。\n");
	ob=new(__DIR__"npc/zhizhuo");
	ob ->move(this_object());
	write("智拙打了个哈欠，懒懒地说：你有什么事？\n");
	return 1;
}
