//cjge2  藏经阁二楼
inherit ROOM;

void create()
{
        set("short", "藏经阁二楼");
        set("long", @LONG
这是藏经阁二楼，只见阁中窗明几净，打扫的纤尘不染。左右两排
红木书架摆满了佛经，几个中年僧人正专心致志的默读佛经。有个老年
僧人在整理架上的经书。
LONG
        );
        set("exits", ([/* sizeof() == 3 */
           "up" : __DIR__"newcjge3",
           "down" : __DIR__"cjge1",
]));
	set("objects",([
	__DIR__"npc/oldseng" : 1,
	__DIR__"obj/shelf" : 1,
	]));

        set("no_fight", 1);
        set("no_clean_up", 0);

        setup();
//        replace_program(ROOM);
}

void init()
{
        add_action("do_get", "get");
}

int do_get(string arg)
{
	string	obj, from;
	object	me, shelf, target, taro;

	if(sscanf(arg, "%s from %s", obj, from)==2 ) {
		if(obj == "all") {
			write("拿那么多经书干什么？\n");
			return 1;
		}
		shelf =  present("book shelf",this_object());
		target =  present(from,this_object());
		me = this_player();
		if(target == shelf) {
			taro =  present(obj, target);
			if(taro) {
				message_vision("$N从书架上拿下一本经书。\n", me);
			}
		}
	}
	return 0;
}
void reset()
{
        object  *inv;
        object con, item;
        int i;

        ::reset();
        con = present("book shelf", this_object());
        inv = all_inventory(con);
        if( sizeof(inv) != 8) {
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new("/u/tian/shaolin/obj/force-book");
                item->move(con);
		item = new("/u/tian/shaolin/obj/unarmed-book");
                item->move(con);
//                item = new("/u/tian/shaolin/obj/dodge-book")
//                item->move(con)
//                item = new("/u/tian/shaolin/obj/parry-book")
//                item->move(con)
		item = new("/u/tian/shaolin/obj/staff-book");
                item->move(con);
//		item = new("/u/tian/shaolin/obj/stick-book");
//                item->move(con);
                item = new("/u/tian/shaolin/obj/blade-book");
		item->move(con);
	}
}

int valid_leave(object me,string dir)
{
	string class_name;
	object seng,room;

	seng=present("old seng",environment(me));
	class_name=me->query("class");
	if(dir!="up") return 1;
	if (class_name!="shaolin"&&class_name!="shaolin1") {
		if (objectp(seng)) {
			return notify_fail("老僧伸手拦住你，笑着说道：“施主请留步。”\n");
		}
		write("你刚登上上楼的楼梯，突听后面有人大喊：来人呀，有人要闯藏经阁！\n\n");
		write("只听后面跑来几个少林武僧，领头的一个指着你喊道：大胆狂徒，哪里跑！\n");
		write("你心里一慌，脚下一软，竟然坐到地上，被武僧上前按住，五花大绑捆了起来。\n\n");
		write("领头武僧说：哈哈，你小子好大胆，敢在少林寺撒野，把他丢到地牢里去！\n");
		write("你被武僧推推搡搡地带到地牢门口，武僧打开铁门，一把将你推了进去。\n\n");
		room = (object)__DIR__"dilao";
		message("vision", "只听“哐铛”一声，铁门打开，接着一个人踉跄着进来，差点摔到你身上。\n",room );
		me->move(room);
		message("vision", "\n只听的耳边一阵喧闹，你回头一看\n",this_object() );
		message("vision", me->query("name")+"不知因为什么被几个少林武僧抓走了。\n\n",this_object() );
		return 0;
	}
	if(class_name=="shaolin1")
		return notify_fail("老僧伸手拦住你，说道：“俗家弟子不能进入。”\n");
	if(this_player()->query("family/generation")>8)
		return notify_fail("老僧伸手拦住你，说道：“上面是藏经阁顶层，你现在辈分太低，不能进。”\n");
	return 1;
}

