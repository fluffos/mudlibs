//cjge1  藏经阁一楼
inherit ROOM;

void create() {
  set("short", "藏经阁一楼");
  set("long", @LONG
这是藏经阁一楼，藏经阁是少林寺收藏佛经和武功秘籍的地方，每
年只选拔少数有为的少林弟子到这里来进修，多少林弟子毕生苦修也不
能进到这里。只见阁中窗明几净，打扫的纤尘不染。左右两排红木书架
摆满了佛经，几个年轻僧人正专心致志的默读佛经。有个中年僧人在整
理架上的经书。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "up": __DIR__ "newcjge2",
    "out": __DIR__ "cjge",
  ]));
  set("objects", ([
    __DIR__ "npc/xufang": 1,
  ]));

  set("no_sleep", 1);
  set("no_clean_up", 0);

  setup();
  //        replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  string class_name;
  object seng, room;

  seng = present("xu fang master", environment(me));
  class_name = me->query("class");
  if (dir != "up") return 1;
  if (class_name != "shaolin" && class_name != "shaolin1") {
    if (objectp(seng)) {
      return notify_fail("虚方伸手拦住你，笑着说道：“施主请留步。”\n");
    }
    write("你刚登上上楼的楼梯，突听后面有人大喊：来人呀，有人要闯藏经阁！\n\n");
    write("只听后面跑来几个少林武僧，领头的一个指着你喊道：大胆狂徒，哪里跑！\n");
    write("你心里一慌，脚下一软，竟然坐到地上，被武僧上前按住，五花大绑捆了起来。\n\n");
    write("领头武僧说：哈哈，你小子好大胆，敢在少林寺撒野，把他丢到地牢里去！\n");
    write("你被武僧推推搡搡地带到地牢门口，武僧打开铁门，一把将你推了进去。\n\n");
    room = (object)__DIR__ "dilao";
    message("vision", "只听“哐铛”一声，铁门打开，接着一个人踉跄着进来，差点摔到你身上。\n", room);
    me->move(room);
    message("vision", "\n只听的耳边一阵喧闹，你回头一看\n", this_object());
    message("vision", me->query("name") + "不知因为什么被几个少林武僧抓走了。\n\n", this_object());
    return 0;
  }
  return 1;
}

void init() {
  object me = this_player(), seng;

  seng = present("xu fang master", environment(me));
  if (!seng) {
    seng = new(__DIR__ "npc/xufang");
    seng->move(this_object());
  }
}
