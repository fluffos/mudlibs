inherit ROOM;

void create()
{
        set("short", "山洞");
        set("long", @LONG
你钻进一个黑黢黢的山洞，里面飘出一阵阴风，令你冷不防打了一
个寒战。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
            "out" : __DIR__"shanlu1",
            "northwest" : __DIR__"hole1",
]));

        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}