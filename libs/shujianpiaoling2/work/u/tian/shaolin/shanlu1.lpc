inherit ROOM;

void create()
{
        set("short", "山路");
        set("long", @LONG
你走在一条崎岖的山路上，路边长满杂草。前面是一处高高的是峭
壁，笼罩在云雾中，隐约可见。你仔细地盯着自己的脚下，不敢抬头望
一眼，惟恐一不小心摔下去。
LONG
        );
        set("exits", ([/* sizeof() == 3 */
            "northeast" : __DIR__"qiaobi1",
		"southdown" : __DIR__"laoshulin",
]));

        set("no_clean_up", 0);
	set("outdoors","shaolin");

	setup();
}

