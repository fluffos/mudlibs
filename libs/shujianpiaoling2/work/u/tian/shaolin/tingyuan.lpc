//tingyuan  庭院

inherit ROOM;

void create()
{
        set("short", "庭院");
        set("long", @LONG
这里是少林寺大雄宝殿前的宽阔的庭院。院内周围古柏蔽阴，银
杏参天，向北即是少林寺主殿大雄宝殿，巍峨雄伟，金碧辉煌。
    东西两侧是少林弟子的练功房，向南是大成殿。
LONG
        );
        set("exits", ([/* sizeof() == 4 */
           "east"  : __DIR__"liangong1", 
           "south" : __DIR__"dcdian",
           "west"  : __DIR__"liangong4",
           "north" : __DIR__"dxbdian",
]));
	set("outdoors","shaolin");
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}