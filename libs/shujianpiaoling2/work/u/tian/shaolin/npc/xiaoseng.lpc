// xiaoseng.c

inherit NPC;

void create() {
  set_name("清凉", ({ "qing liang", "liang" }));
  set("title", "少林弟子");
  set("long",
    "一位白白胖胖的小和尚，急急忙忙的不知在找什么。\n"
  );

  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "shaolin");

  set("age", 15);

  set("max_gin", 100);
  set("max_kee", 150);
  set("max_sen", 100);
  set("force", 400);
  set("max_force", 400);
  set("force_factor", 5);
  set("combat_exp", 10000);

  set("chat_chance", 4);

  set("chat_msg", ({
    "清凉自言自语道；小珠子到底掉哪儿了？真奇怪！\n",
    "清凉打个哈欠，说；真想再去睡一觉。\n",
    "清凉皱着眉头说：觉嗔师叔真可恶，老是打人！\n",
    "清凉道：听说他曾在后山找到好东西。\n",
  }));

  set_skill("force", 30);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);

  set("inquiry", ([
    "东西": "唉，师兄给我的珠子，可是我不小心给掉了。\n",
  ]));

  setup();
  carry_object(__DIR__ "obj/seng_cloth")->wear();


}

int accept_object(object me, object ob) {
  me = this_player();

  if (me->query("class") == "shaolin" || me->query("class") == "shaolin1") {
    if (ob->query("name") == "小珠子" && (!query("give"))) {
      command("jump");
      command("say 这正是我丢的小珠子，太谢谢你了。\n");
      command("thank " + me->query("id"));
      printf("清凉说：我这里有一把刷子，也没什么用，就给你吧。\n");
      ob = new(__DIR__ "obj/shuazi");
      ob->set("own_name", me->query("id"));
      ob->move(me);
      set("give", 1);
      printf("清凉给你一把刷子。\n");
      call_out("zou", 1, this_player());
      return 1;
    }
  }
  return 0;
}

void zou(object ob) {
  remove_call_out("zou");
  message("vision", "只见清凉高兴的唱着歌，一蹦一跳的向西离去。\n", environment());
  destruct(this_object());
}

void reset() {
  set("give", 0);
}
