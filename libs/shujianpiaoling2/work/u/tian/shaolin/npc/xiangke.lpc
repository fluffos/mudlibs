inherit NPC;

void create()
{
	set_name("香客", ({ "xiangke" }) );
	set("age", 25);
	set("long", "一位虔诚的进香客，走一步磕个头，一步一步的向上走。\n");
	set("attitude", "friendly");
	set("per", 20);	
	set("str", 26);
	set("cor", 30);
	set("gender","男性");
	set_skill("unarmed",20);
	set_skill("dodge",30);
	set_skill("parry",20);
	set("combat_exp", 3000);

        set("chat_chance", 10);
        set("chat_msg", ({
                (: random_move :)
        }) );

	setup();
	carry_object(__DIR__"obj/cloth")->wear();

	add_money("silver",15);
}

int accept_fight(object me)
{
        command("say " + RANK_D->query_respect(me) + 
"请多指教！\n");
        return 1;
}
