// juechen.c 柴房头陀-觉嗔

inherit NPC;
string ask_me();
string ask_me1();

void create()
{
	set_name("觉嗔", ({"jue chen","chen"}));
	set("long",
		"这是一位胖大的中年头陀，他粗眉大眼，面似锅底，凶神恶煞
一样。是少林弟子最头疼的人物。\n"
	);

	set("gender", "男性");
	set("attitude", "heroism");
	set("title","少林寺柴房头陀");
	set("inquiry",([
		"斋饭" : "他奶奶的，少林寺的斋饭淡的出鸟来，哪有我以前喝酒吃肉好。\n",
		"千年灵芝" :  (: ask_me :),
		"治伤" : "给谁治伤?",
		"玄悲" : (:ask_me1:),
	]));
	set("chat_chance", 2);
	set("chat_msg", ({
		"觉嗔瞪着眼睛骂道：快点劈柴，你小子骨头又痒痒了是吧？\n",
		"觉嗔皱皱眉头骂道：他奶奶的，整天吃这鸟淡斋饭。\n",
		"觉嗔看看柴房说：木柴又不多了，明天要到后山去砍一些来。\n",
	}) );

	set("age", 40);

	set("max_gin", 500);
	set("max_kee", 1000);
	set("max_sen", 500);
	set("force", 2000);
	set("max_force", 2000);
	set("force_factor", 20 );
	set("combat_exp", 300000);



	set_skill("force", 80);
	set_skill("dodge", 80);
	set_skill("unarmed",80);
	set_skill("shaolin-dodge",80);
	set_skill("xinyi_force",80);
	set_skill("luohan-ken",80);

	map_skill("force", "xinyi_force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("unarmed","luohan-ken");

	setup();
	carry_object(__DIR__"obj/hei_jiasha")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player() ) ){
           remove_call_out("comein");
           call_out("comein",1,ob);
        }
}

string ask_me()
{
	object me = this_player(),ob;

	add("say",1);
	switch(query("say")){
		case 1: 
			return "我不知道！\n";
		break;
		case 2: 
			return "没听说过！\n";
		break;
		case 3: 
			return "真罗嗦，你问千年灵芝到底想干什么？\n";
		break;
	}
	set("say",0);
	return "再罗嗦，我敲断你的狗腿！\n";
}

string ask_me1()
{
	object me = this_player(),ob;

	if(query("say")!=3) return "好象听说过。\n";
	command("wa");
	command("say 是玄悲大师受伤啦？他对我可好了！");
	command("kick "+me->query("id"));
	command("say 他奶奶的，你小子怎么不早说？
    耽误了大师治病看我不敲断你的狗腿！");
	tell_object(me,"觉嗔凑近你说：千年灵芝在后山的悬崖峭壁那，很危险，你可要小心呢。\n");
	if(query("give1")==1){
		tell_object(me,"觉嗔说：我这的绳子被别人拿去了，你等会再来吧。\n");
		return "真急死我了！\n";
	}
	tell_object(me,"觉嗔说：我这有根绳子，你拿去吧，会用上的。\n");
	ob = new(__DIR__"obj/shengzi");
	ob->set("own_name",me->query("id"));
	ob->move( me );
	set("give1",1);
	message_vision("觉嗔给$N什么东西！\n",me);
	return "快去吧！\n";
}

void comein(object ob)
{
	if( !ob || environment(ob)!= environment() ) return;
	command("hehe "+ob->query("id"));
	command("grin");
	command("say 又来了一个供我出气的小子。");
	return;
}


int accept_object(object me, object ob)
{
	me = this_player();

	if(me->query("class")=="shaolin"||me->query("class")=="shaolin1") {
		if(ob->query("name")=="烤鸡腿" && (!query("give"))) {
			if(me->query("id")==ob->query("own_name")){
				command("haha");
				command("spank "+me->query("id"));
				command("say 知我者，你小子也。\n");
				command("say 给你一把斧头，好好给我劈柴吧，我不打你了。\n");
				ob = new(__DIR__"obj/futou");
				ob->set("own_name",me->query("id"));
				ob->move( me );
				set("give",1);
				printf("觉嗔给你一把斧头。\n");
				call_out("eat_jitui", 1, this_player());
				return 1;
			}
			else{
				command("kick "+me->query("id"));
				command("slapslap "+me->query("id"));
				command("say 他奶奶的，你小子想让方丈骂我？");
				return 0;
			}
		}
	}
	return 0;
}

void eat_jitui(object ob)
{
    remove_call_out("eat_jitui");
	message("vision", "只见觉嗔把鸡腿一下就塞到嘴里，嚼叭嚼叭居然连鸡骨头都一起吞下肚了。\n",environment());

	destruct(present("jitui",this_object()));
}


void reset()
{
	set("give", 0);
	set("give1", 0);
	set("say",0);
}


