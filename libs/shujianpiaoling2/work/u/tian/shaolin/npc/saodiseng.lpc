// saodiseng.c

inherit NPC;

string ask_me();

void create()
{
	set_name("扫地僧", ({"saodi seng","seng"}));
	set("title", "少林弟子");
	set("long",
		"一位手拿大扫把正专心致志地扫地的小和尚。\n"
	);

	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin");

	set("age", 16);

	set("max_gin", 150);
	set("max_kee", 200);
	set("max_sen", 150);
	set("force", 400);
	set("max_force", 400);
	set("force_factor", 5 );
	set("combat_exp", 10000);

	set("chat_chance", 2);

	set("chat_msg", ({
		"扫地僧说道: 这落叶怎么总是扫不完呀，赶快扫完地还要去练功呢。\n",
		"扫地僧忽然好象想起什么事来。\n",
		"扫地僧自言自语道：清凉这家伙常有些稀奇的玩意。\n",
	}) );

	set_skill("force", 30);
	set_skill("unarmed", 30);
	set_skill("dodge", 30);
	set_skill("parry", 30);
	set_skill("staff", 30);

	set("inquiry", ([
	"扫地" : "哈哈，你可不要小看扫地，在少林寺扫地也是修行。\n",
	"修行" : (: ask_me :),
	]));

	setup();
	carry_object(__DIR__"obj/seng_cloth")->wear();
	carry_object(__DIR__"obj/saoba")->wield();

}

string ask_me()
{
	object me,ob;

	me = this_player();

	if(me->query("class")=="shaolin"||me->query("class")=="shaolin1") {
		if(!query("give")){
			command("xixi");
			command("say 你也想练扫地功？我正想歇歇。");
			ob = new(__DIR__"obj/saoba");
			ob->set("own_name",me->query("id"));
			ob->move( me );
			set("give",1);
			printf("扫地僧给你一把大扫把。\n");
			return "嘻嘻，好好练吧。\n";
		}
	}
	command("sigh");
	command("say 这是师傅给的任务，扫完地才能去练功。");
	return "我得抓紧了。\n";
}
			
void reset()
{
	set("give", 0);
}



