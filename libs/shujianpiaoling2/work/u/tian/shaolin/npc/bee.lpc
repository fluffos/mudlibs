inherit NPC;

void create()
{
	set_name("蜜蜂", ({ "bee" }) );
	set("race", "野兽");
	set("age", 1);
	set("gender", "雌性");
	set("long", "一只嗡嗡作响的小蜜蜂哦! \n");

	set("str", 6);
	set("cor", 8);
	set("per", 33);

    set("combat_exp", 1000);
	set("score", 10);
	set("attitude","peaceful");

	set("limbs", ({ "头部", "身体","翅膀" }) );
	set("verbs", ({ "bite" }) );
    set_temp("apply/dodge", 15);

   set("chat_chance", 5);
	set("chat_msg", ({
		"蜜蜂嗡嗡地拍动著翅膀，围着你飞了一圈! \n",
		"蜜蜂停在路边花上吸花蜜。 \n"
	}) );

	setup();
	carry_object(__DIR__"obj/fengmi");

}
