// zhiqiao.c 兵器库-智巧

inherit NPC;

void create() {

  set_name("智巧", ({ "zhi qiao", "qiao", }));
  set("long",
    "他是一位精明强干，心灵手巧的青年僧人，善做各种机关。\n"
  );

  set("title", "少林寺兵器库管事");
  set("gender", "男性");
  set("attitude", "heroism");
  //	set("class", "shaolin");
  //	create_family("少林寺", 10, "弟子");

  set("age", 28);

  set("max_gin", 1000);
  set("max_kee", 2000);
  set("max_sen", 1000);
  set("force", 5000);
  set("max_force", 3000);
  set("force_factor", 100);
  set("combat_exp", 1000000);

  set_skill("force", 200);
  set_skill("unarmed", 250);
  set_skill("dodge", 250);
  set_skill("parry", 250);
  set_skill("sword", 250);
  set_skill("nianhua-zhi", 250);
  set_skill("luohan_force", 200);
  set_skill("shaolin-dodge", 250);
  set_skill("damo-sword", 250);

  map_skill("force", "luohan_force");
  map_skill("unarmed", "nianhua-zhi");
  map_skill("dodge", "shaolin-dodge");
  map_skill("sword", "damo-sword");
  map_skill("parry", "damo-sword");

  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);

  setup();
  carry_object(__DIR__ "obj/qing_jiasha")->wear();
  carry_object(__DIR__ "obj/changjian")->wield();

}

void init() {
  add_action("do_lingqu", ({ "lingqu", }));
  add_action("do_guihuan", ({ "guihuan", }));
}

int do_lingqu(string arg) {
  object me = this_player(), ob;

  if ((string)me->query("class") != "shaolin" && (string)me->query("class") != "shaolin1")
    return notify_fail("智巧说：不是少林弟子是不能领取兵器的。\n");
  if (!arg)
    return notify_fail("智巧说：你想领取什么兵器呀？要说明的。\n");
  if (query("give") == 15)
    return notify_fail("智巧说：兵器已发完了，你等会再来吧。\n");

  switch (arg) {
    case "刀":
      ob = new(__DIR__ "obj/jieblade");
      break;
    case "剑":
      ob = new(__DIR__ "obj/changjian");
      break;
    case "棍":
      ob = new(__DIR__ "obj/tong-stick");
      break;
    case "杖":
      ob = new(__DIR__ "obj/chanzhang");
      break;
    case "锤":
      ob = new(__DIR__ "obj/hammer");
      break;
    default:
      return notify_fail("智巧说：没有这种兵器呀，你再好好想想吧。\n");
  }
  message_vision("智巧点点头，说：好，这是你要的兵器，给你，可不能胡做非为呀。\n", me);
  message_vision("智巧转身取出一" + ob->query("unit") + ob->query("name") + "递给$N。\n", me);
  ob->move(me);
  add("give", 1);
  return 1;
}

int do_guihuan(string arg) {
  object me = this_player(), ob;

  if ((string)me->query("class") != "shaolin" && (string)me->query("class") != "shaolin1")
    return notify_fail("智巧说：咦，我不记得给过你兵器呀。\n");
  if (!arg)
    return notify_fail("智巧说：你想归还什么兵器呀？要说明的。\n");
  switch (arg) {
    case "刀":
      ob = present("jie dao", me);
      break;
    case "剑":
      ob = present("chang jian", me);
      break;
    case "棍":
      ob = present("tong gun", me);
      break;
    case "杖":
      ob = present("chan zhang", me);
      break;
    case "锤":
      ob = present("tie chui", me);
      break;
    default:
      return notify_fail("智巧说：我没发给你这种兵器呀，你再好好想想吧。\n");
  }
  if (!ob) return notify_fail("智巧说：你身上没有这种兵器呀，是不是丢了？\n");

  message_vision("智巧点点头，说：不错，好借好还，再借不难，好，奖励你10点道德值。\n", me);
  message_vision("$N还给智巧一" + ob->query("unit") + ob->query("name") + "。\n", me);
  ob->move(this_object());
  destruct(ob);
  me->add("daode", 10);
  return 1;

}

int accept_fight(object ob) {
  command("say 阿弥陀佛，佛门圣地怎能动武？");
  return 0;
}


void killed_enemy(object who) {
  command("say 哈哈, 这样低微的本事也胆敢擅闯少林寺？不要命的家伙！");
}

void reset() {
  set("give", 0);
}
