// jingang-strike.c  大力金刚手

inherit SKILL;

mapping *action = ({
    ([  "action":       "$N盘膝而坐，二手合十，一式「大发慈悲」，双拳蓄势而发，击向$n的$l",
        "dodge":        -50,
        "parry":        -60,
                "damage":        70,
        "force":        300,
        
         "damage_type": "瘀伤"
        ]),
    ([  "action":       "$N腾空飞起，一式「力逾千斤」，双手双腿齐出，令$n无可躲藏",
        "dodge":        -60,
        "parry":        -70,
                "damage":        90,
        "force":        350,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N一式「金光万丈」，双掌幻出金光万道，击向$n$l",
        "dodge":        -60,
        "parry":        -40,
                "damage":        90,
        "force":        350,
        
        "damage_type":  "瘀伤"
        ]),
     ([  "action":      "$N双掌虚含，掌缘下沉，一式「刚勇无比」，猛地向$n推出",
        "dodge":        -50,
        "parry":        -80,
                "damage":       100,
        "force":        300,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N一臂前伸，一臂后指，一式「神通广大」，攻向$n的身前身后",
        "dodge":        -70,
        "parry":        -40,
                "damage":       110,
        "force":        350,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N一式「掌中乾坤」，两手十指虚点$n的全身三十六道要穴",
        "dodge":        -80,
        "parry":        -90,
                "damage":       150,
        "force":        400,
        "damage_type":  "瘀伤"
        ]),
    
});


int valid_learn(object me)
{
    if( (int)me->query_skill("force",1) < 150 )
        return notify_fail("你的内功不够，无法修习更高深的大力金刚掌。\n");
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练大力金刚掌必须空手。\n");
        return 1;
}

int valid_enable(string usage)
{
    return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    if( (string)me->query_skill_mapped("force")!= "fuxiang_force")
        return notify_fail("大力金刚掌必须配降龙伏象功才能练习。\n");

    if( (int)me->query("kee") < 40 )
        return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
        me->receive_damage("kee", 40);
        return 1;
}
int effective_level() { return 18;}

string perform_action_file(string action)
{
        return CLASS_D("shaolin") + "/strike/jingang-strike/"+action;
}
int learn_bonus()
{
        return 0;
}
int practice_bonus()
{
        return 0;
}
int black_white_ness()
{
        return 0;
}