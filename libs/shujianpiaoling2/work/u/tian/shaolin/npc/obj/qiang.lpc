// qiang.c

#include <weapon.h>

inherit SPEAR;

void create()
{
	set_name("长枪", ({ "qiang" }) );
	set_weight(6000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "支");
		set("value", 800);
		set("material", "iron");
		set("long", "这是一支军队的长枪。\n");
		set("wield_msg", "$N抄起一支$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n放下。\n");
	}
	init_spear(45);
	setup();
}
