// futou.c 斧头

#include <weapon.h>
inherit AXE;

void create()
{
        set_name("斧头", ({ "futou","axe" }) );
        set_weight(2200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是一把锋利的铁斧，不轻不重，砍柴正好。\n");
                set("value", 1);
                set("wield_msg", "$N拿出一把砍柴用的$n，握在手中当作武器。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }
        init_axe(5, TWO_HANDED);
        setup();
}

