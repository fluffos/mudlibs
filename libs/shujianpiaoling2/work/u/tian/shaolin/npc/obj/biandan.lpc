// biandan.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
	set_name( "扁担", ({ "biandan", "shoulder pole","staff" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "一条粗木扁担，由于常年的使用，显的油光闪亮。\n");
		set("value", 1);
		set("material", "wood");
		set("wield_msg", "$N拿出一条$n抄在手中。\n");
		set("unwield_msg", "$N放下手中的$n。\n");
	}

	init_staff(3);
	setup();
}
