// dunpai.c 盾牌

#include <armor.h>

inherit SHIELD;

void create()
{
	set_name("盾牌", ({ "dun pai", "dun","shield" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "wood");
		set("unit", "面");
		set("value", 2000);
		set("armor_prop/armor", 15);
		set("armor_prop/dodge", -2);
		set("armor_prop/defense", 3);
	}
	setup();
}
