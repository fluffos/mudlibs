//tiejia.c 铁甲

#include <armor.h>

inherit ARMOR;

void create()
{
	set_name("铁甲", ({ "tie jia", "jia" }) );
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "tong");
		set("unit", "件");
		set("value", 4000);
		set("armor_prop/armor", 30);
		set("armor_prop/dodge", -5);
		set("armor_prop/defense", 10);
	}
	setup();
}
