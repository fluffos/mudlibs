// toukui.c 头盔
//

#include <armor.h>

inherit HEAD;

void create()
{
	set_name("头盔", ({ "tou kui","kui" }) );
	set_weight(1500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "只");
		set("material", "tie");
		set("value", 1000);
		set("armor_prop/armor", 10);
		set("armor_prop/dodge", -1);
		set("armor_prop/defense", 10);
	}
	setup();
}
