//gangjia.c 钢甲

#include <armor.h>

inherit ARMOR;

void create() {
  set_name("钢甲", ({ "gang jia", "jia" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "gang");
    set("unit", "件");
    set("value", 6000);
    set("armor_prop/armor", 40);
    set("armor_prop/dodge", -4);
    set("armor_prop/defense", 15);
  }
  setup();
}
