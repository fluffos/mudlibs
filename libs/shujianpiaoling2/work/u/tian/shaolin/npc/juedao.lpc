// juedao.c 大成殿-觉道

inherit NPC;
inherit F_MASTER;

string *title = ({
"少林寺入门第五弟子",  7000,
"少林寺入门第四弟子", 14000,
"少林寺入门第三弟子", 21000,
"少林寺入门第二弟子", 29000,
"少林寺入门大弟子", 37000,
});



string ask_for_join();
string ask_me();

void create()
{
	set_name("觉道", ({"jue dao master","jue dao","master",}));
	set("long",
		"这是一位强壮的青年僧人，他长个国字脸，生得浓眉大眼，\n"
		"虎背熊腰，全身似乎蕴含着无穷劲力。\n"
	);


	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin");

	set("inquiry",([
		"学艺" : "阿弥陀佛，少林武功天下闻名，四海仰慕。\n",
		"拜师" : (: ask_for_join :),
		"慧心大师" : "哈哈，他是我的授业恩师，是人人向往的[般若堂]的首座！\n",
		"推荐信" : (: ask_me :),
	]));

	set("age", 26);

	set("max_gin", 300);
	set("max_kee", 500);
	set("max_sen", 300);
	set("force", 1000);
	set("max_force", 1000);
	set("force_factor", 20 );
	set("combat_exp", 300000);



	set_skill("force", 80);
	set_skill("tongzi-force", 80);
	set_skill("dodge", 80);
	set_skill("shaolin-dodge", 80);
	set_skill("yecha_stick", 80);
	set_skill("stick", 80);
	set_skill("luohan-ken", 80);
	set_skill("parry", 80);
	set_skill("unarmed", 80);
	set_skill("buddhism", 80);
	set_skill("literate", 40);
	set_skill("magic", 40);
	set_skill("xiaochengforce", 80);

	map_skill("force", "tongzi-force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("stick", "yecha_stick");
	map_skill("unarmed", "luohan-ken");

	set("title","少林寺入门弟子师傅");
	create_family("少林寺", 9, "弟子");
	set("no_teach","21212121212");

	setup();
	carry_object("/obj/weapon/stick")->wield();
	carry_object(__DIR__"obj/qing_jiasha")->wear();
}


void init()
{
	add_action("do_apprentice","apprentice");
}

string ask_for_join()
{
	object me = this_player();

	if( me->is_apprentice_of(this_object()) ) 
		return "你这家伙，想给为师磕头就磕吧，还用问？\n";
	if( me->query("family/family_name")=="少林寺" && me->query("generation")<10&&me->query("generation")!=0) 
		return "阿弥陀佛，大师如此多礼小僧可不敢当！\n";
	if( (string)me->query("class")=="shaolin" ){
		command("smile");
		return "阿弥陀佛，"+RANK_D->query_respect(me)+"还没有师傅吗？那就拜我好了。\n";
	}
	if( (string)me->query("gender") != "男性" )
		return "阿弥陀佛！善哉！善哉！女施主若真心皈依我佛，还是到峨嵋山去吧。\n";

	if( me->query("betrayer")){
		command("shake");
		message_vision("觉道双手合十，对$N说道: 少林寺从不收叛师之徒!\n",me);
		return "阿弥陀佛，苦海无边，回头是岸！\n)";
	}
	return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请先剃度受戒吧。\n";
}

void attempt_apprentice(object ob)
{
	object master;
//	if( !(master = present(arg, environment(me)))

	if( (string)ob->query("gender") != "男性" )
	{
		command ("ah");
		command ("say 阿弥陀佛！女施主呀，贫僧可不敢开这等玩笑啊。");
		ob->delete_temp("pending/apprentice");
		return;
	}
	if( ob->query("family/family_name")=="少林寺" && ob->query("generation")<10 &&ob->query("generation")!=0) {
		command("say 阿弥陀佛，大师如此多礼小僧可不敢当！");
		ob->delete_temp("pending/apprentice");
		return;
	}
      if(ob->query("id_type")== 2) {
	    command("say 本派乃名门正派，不收邪道人物。\n");
	    return;
	}

	if( ob->query("betrayer")){
		command("shake");
		message_vision("觉道双手合十，对$N说道: 少林寺从不收叛师之徒!\n",ob);
		ob->delete_temp("pending/apprentice");
		return;
	}

	if( (string)ob->query("class")=="shaolin1" ){
		command("say 阿弥陀佛，归入佛门，想还俗可就难了，你可要仔细思量。");
		command("say 要是真心皈依我佛，请先剃度受戒吧。");
		ob->delete_temp("pending/apprentice");
		return;
	}

	if( ob->query("class")=="shaolin" )	{
		command ("say 阿弥陀佛！贫僧就收下你做『少林寺入门第五弟子』了。\n");
		command("say 阿弥陀佛，善哉！归入佛门可要一心向善，勤学苦练才是。\n");
		command("recruit " + ob->query("id"));
		ob->set("title",title[0]);
		ob->set("class","shaolin");
		ob->set("id_type",1);
		ob->set("shaolin/renwu",0);
		ob->set("shaolin/tuijian",0);
	}
	else {
		command("say 阿弥陀佛，想归依我佛要先行剃度之礼。\n");
		ob->delete_temp("pending/apprentice");
		return;
	}
}

int do_apprentice(string arg)
{
	int exp,nn,ii,rr;
	string old_t;
	object ob,me=this_player();

	if( arg!="jue dao master"&&arg!="jue dao"&&arg!="master") return 1;
	if( !(me->is_apprentice_of(this_object()))) return 0;
	if(me->query("shaolin/tuijian")) {
		command("wa "+me->query("id"));
		tell_object(me, "你还没去拜我师傅慧心大师？快去吧，别耽误了你的修行!\n");
		return 1;
	}

	old_t=me->query("title");
	exp=me->query("combat_exp");
	message_vision("$N跪了下来向$n恭恭敬敬地磕了个头，叫道：「师父好！」\n",me,this_object());

	if(old_t==title[8] && exp>(int)title[9]) {
		command("sigh");
		command("say 真是长江后浪推前浪，一代新人换旧人！为师已没有什么可教你的了。");
		command("say 拿上我的推荐信到慧心大师那里学艺吧！\n");
		message_vision("$n拿出纸和笔，飞快地写了一封信，装到信封里递给$N。\n",me,this_object());
//		printf("觉道拿出纸和笔，飞快地写了一封信，装到信封里递给你。\n");
		ob = new(__DIR__"obj/letter1");
		ob->set("own_name",me->query("id"));
		ob->set("master_name",this_object()->query("name"));
		ob->move( me );

//		command("say 你我师徒一场，为师也没有什么东西，现在要分手了，送你个纪念品吧！\n");
		me->set("shaolin/tuijian",1);
		me->set("shaolin/renwu",0);
		return 1;
	}
	for(ii=0; ii<5; ii++) {
		if(old_t==title[ii*2]) {
			if(exp<=(int)title[ii*2+1]) {
				command("pat "+me->query("id"));
				command("say 你的功夫还不行，要抓紧时间练呀，别光聊天贪玩！\n");
				return 1;
			}
			else {
				command("haha");
				command("spank "+me->query("id"));
				command("say 很好，现在就提升你为" + title[(ii+1)*2] + "。\n");
				me->set("title",title[(ii+1)*2]);
				me->set("shaolin/renwu",0);
				return 1;
			}
		}
	}
	return 1;
}

string ask_me()
{
	object me = this_player(),ob;

	if( !(me->is_apprentice_of(this_object()))) return 0;
	if(!(me->query("shaolin/tuijian"))) return 0;
	if(ob=present("letter",me)){
		if(me->query("id")==ob->query("own_name")) {
			return "推荐信不是在你身上吗？快去吧!\n";
		}
	}

	command("faint "+me->query("id"));
	tell_object(me, "推荐信搞丢了？真是粗心！\n");
	message_vision("$n拿出纸和笔，飞快地写了一封信，装到信封里递给$N。\n",me,this_object());
	ob = new(__DIR__"obj/letter1");
	ob->set("own_name",me->query("id"));
	ob->move( me );
	me->set("title","少林寺入门大弟子");
	return "仔细保管好，不要再搞丢了！\n";

}