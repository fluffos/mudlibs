// xukong.c 书房师傅--虚空

inherit NPC;

void create() {
  set_name("虚空", ({ "xu kong", "teacher", "kong" }));
  set("title", "少林寺书房师傅");
  set("gender", "男性");
  set("age", 47);
  set("int", 26);
  //	create_family("少林寺", 8, "弟子");

  set("long",
    "虚空年轻时是江南有名的才子，学富五车，才高八斗，\n"
    "琴棋书画，样样精通。但因为不善钻营，一直没有功名。\n"
    "后来因为一件伤心事，看破红尘，出家为僧。\n");
  set("inquiry", ([
    "伤心事": "唉，往事不堪回首，不提也罢。\n",
    "学习": "嗯，学无止境，书到用时方恨少呀。\n",
    "抄经文": "别提了，我的毛笔不见了，你帮我找找吧。\n",
    "经文": "经文这里有的是，你随便看，不过高深的都在藏经阁里。\n",
    "毛笔": "我好象丢到修行室里了。\n",
  ]));

  set("chat_chance", 2);

  set("chat_msg", ({
    "虚空说道：唉，有纸无笔怎么能抄经文呢？\n",
    "虚空说道：空即是色，色即是空，无空无色，无色无空。\n",
    "虚空说道：出家即是在家，在家亦是出家，佛在心中。\n",
    "虚空说道：人一老脑子就不好使了，前天约好慧光去虚方那里喝茶，他居然忘了！\n",
  }));

  set("attitude", "peaceful");
  set_skill("literate", 80);

  setup();
  carry_object(__DIR__ "obj/bai_jiasha")->wear();

}

int recognize_apprentice(object ob) {
  if (!ob->query_temp("marks/xue")) {
    say("虚空说道：咦？我不记得收过你这个学生啊....\n");
    return 0;
  }

  return 1;
}

int accept_object(object me, object ob) {

  if (ob->query("name") == "毛笔") {
    command("smile");
    command("say 这正是我需要的东西，谢谢你。");
    command("say 送你一本我自己写的书留做纪念吧。");
    ob = new(__DIR__ "book/literate_book");
    ob->move(me);
    say("虚空把一本书送给" + me->query("name") + "。\n");
    return 1;
  }
  if (ob->value() >= 500) {
    if (!me->query_temp("marks/xue")) {
      say("虚空点点头，说道：很好，从今天起你随时可以来问我\n"
        "    有关读书识字(literate)的任何问题。\n");
      me->set_temp("marks/xue", 1);
      return 1;
    } else {
      say("虚空点了点头，说道：哦，向你这麽有心的学生还真是不多见，好好努力\n"
        "    将来必定前途无量，谢了。\n");
      return 1;
    }
  }
  say("虚空说道：你的诚意不够，这钱还是拿回去吧。\n");
  return 0;
}
