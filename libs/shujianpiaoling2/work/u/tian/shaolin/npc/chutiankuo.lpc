// chutiankuo.c 楚天阔

inherit NPC;

void create()
{
	set_name("楚天阔", ({"chu tiankuo","chen"}));
	set("long",
		"这是一位高高大大的少林俗家弟子。
五年前他代艺投师，拜在少林门下，现在已经是少林俗家弟子中少有的高手。\n"
	);


	set("gender", "男性");
	set("attitude", "heroism");
	set("title","少林寺俗家弟子");
//	create_family("少林寺", 9, "弟子");

	set("chat_chance", 2);

	set("chat_msg", ({
		"楚天阔瞪着眼睛说道：我不过和人打了几次架，就罚我这里！\n",
		"楚天阔皱皱眉头说道：他奶奶的，一天不打架，手就痒痒。\n",
	}) );


	set("age", 30);

	set("max_gin", 500);
	set("max_kee", 5000);
	set("max_sen", 500);
	set("food", 1000);
	set("water", 1000);

	set("force", 3000);
	set("max_force", 4000);
	set("force_factor", 5 );
	set("combat_exp", 800000);



	set_skill("force", 150);
	set_skill("dodge", 150);
	set_skill("parry", 150);
	set_skill("unarmed",150);
	set_skill("luohan-ken",150);
	set_skill("shaolin-dodge",150);
	set_skill("xinyi_force",150);

	map_skill("force", "xinyi_force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("unarmed", "luohan-ken");
    set_temp("apply/attack", 50);
    set_temp("apply/defense", 50);


	setup();

	carry_object(__DIR__"obj/hei_jiasha")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player() ) ){
           remove_call_out("comein");
           call_out("comein",1,ob);
        }
}

void comein(object ob)
{
	if( !ob || environment(ob)!= environment() ) return;
	if(ob->query("class")=="shaolin"||ob->query("class")=="shaolin1") {
		command("xixi "+ob->query("id"));
		command("say 大师又外出办事呀，祝你一路顺风！");
		return;
	}
	if(	ob->query("combat_exp")<10000){
		command("shake "+ob->query("id"));
		command("say 打架你不是我的对手。");
		return;
	}
	command("hehe "+ob->query("id"));
	command("say 我的手又痒痒了，来来来，咱们打上一架。");
    this_object()->fight_ob(ob);	

	return;
}

