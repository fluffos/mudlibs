// tiaoshuiseng.c

inherit NPC;

void create()
{
	set_name("挑水僧", ({"tiaoshui seng","seng"}));
	set("title", "少林弟子");
	set("long",
		"一位手拿扁担准备挑水的小和尚，不知何故，站在井边发呆。\n"
	);

	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin");

	set("age", 16);

	set("max_gin", 100);
	set("max_kee", 150);
	set("max_sen", 100);
	set("force", 400);
	set("max_force", 400);
	set("force_factor", 5 );
	set("combat_exp", 10000);

	set("chat_chance", 1);

	set("chat_msg", ({
		"挑水僧说道：唉，看来日落以前这地是浇不完了，怎么向师傅交代呢？\n",
		"挑水僧说道：奇怪，我的水桶怎么找不到了？\n",
		"挑水僧说道：看我这脑子，放哪去了呢？怎么一转眼就忘了。\n",
	}) );

	set_skill("force", 50);
	set_skill("unarmed", 50);
	set_skill("dodge", 50);
	set_skill("parry", 50);
	set_skill("staff", 50);

	set("inquiry", ([
	"挑水" : "嘻嘻，你替我挑水，行吗？\n",
	]));

	setup();
	carry_object(__DIR__"obj/seng_cloth")->wear();
	carry_object(__DIR__"obj/biandan");

}

int accept_object(object me, object ob)
{
	me = this_player();

	if(me->query("class")=="shaolin"||me->query("class")=="shaolin1") {
		if(ob->query("name")=="水桶" && (!query("give"))){
			command("wa");
			command("say 这正是我的水桶，你怎么找到的？\n");
			command("jump");
			command("thank "+me->query("id"));
			command("say 我这里多一条扁担，送给你吧，你要有空来帮我挑水。");
			ob = new(__DIR__"obj/biandan");
			ob->set("own_name",me->query("id"));
			ob->move( me );
			set("give",1);
			printf("挑水僧给你一条扁担。\n");
			return 1;
		}
	}
	return 0;
}
			
void reset()
{
	set("give", 0);
}



