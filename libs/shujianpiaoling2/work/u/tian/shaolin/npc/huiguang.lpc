// huixin.c 修行室-慧光

inherit NPC;

#include "renwu.h"

string ask_renwu();
string ask_type();
int do_work();
int do_work_end();
int do_buy();
int do_search(); 
int do_disp();
int do_make();
int do_chase();
int do_treasure();

void create()
{
	set_name("慧光", ({"hui guang","guang",}));
	set("long",
		"这是一位年过半百的老僧，满脸的皱纹似乎写着世上的沧桑，
看起来好象虚弱无力，可一双眼睛却竟透着睿智。\n"
	);


	set("gender", "男性");
	set("attitude", "friendly");
	set("class", "shaolin");

	set("inquiry",([
		"任务" : (: ask_renwu :),
		"种类" : (: ask_type :),
	]));

	set("age", 60);

	set("max_gin", 300);
	set("max_kee", 500);
	set("max_sen", 300);
	set("force", 1000);
	set("max_force", 1000);
	set("force_factor", 20 );
	set("combat_exp", 300000);



	set_skill("dodge", 80);
	set_skill("parry", 80);
	set_skill("unarmed", 80);


	set("title","少林寺修行室师傅");
//	create_family("少林寺", 9, "弟子");

	setup();

	carry_object(__DIR__"obj/hei_jiasha")->wear();
}

void init()
{
	add_action("do_shenqing","shenqing");
	add_action("do_zhuxiao","zhuxiao");
	add_action("do_wancheng","wancheng");
	add_action("do_chakan","chakan");
}

string ask_type()
{
	object me = this_player();

	if(me->query("class")!="shaolin1" && me->query("class")!="shaolin") return 0;
	if(!(me->query("family/master_name")) ) return "你还是先去拜个师傅吧。\n";

	return "任务分干活，购买，采集，配药，炼丹，追捕，寻宝等等。\n";
}

string ask_renwu()
{
	object me = this_player();

	if(me->query("class")!="shaolin1" && me->query("class")!="shaolin") return 0;
	if(!(me->query("family/master_name")) ) return "你还是先去拜个师傅吧。\n";

	return "任务有很多种，你申请时要说明种类。\n";
}

int do_zhuxiao()
{
	object me = this_player();

	if(me->query("class")!="shaolin1" && me->query("class")!="shaolin") return 0;
	if(!(me->query("family/master_name")) ) {
		message_vision("$n对$N说道: 你还是先去拜个师傅吧。\n",me,this_object());
		return 1;
	}
	if(!(me->query("shaolin/renwu_type1"))){
		printf("你现在没有任务，注销什么？\n");
		me->delete("shaolin/renwu_nn");
		me->delete("shaolin/renwu_type");
		me->delete("shaolin/renwu_type1");
		return 1;
	}
	command("sigh");
	message_vision("$n对$N说道: 由于你没完成任务，被扣掉10%的经验和50点潜能。\n",me,this_object());
	me->set("combat_exp", (int)(me->query("combat_exp")*9/10));
//	if((me->query("potential")-me->query("learned_points"))>50)
		me->add("potential", -50);
//	else
//		me->set("potential",me->query("learned_points"));

//	if(	me->query("shaolin/renwu")>0)
//		me->add("shaolin/renwu",-1);
	me->delete("shaolin/renwu_nn");
	me->delete("shaolin/renwu_type");
	me->delete("shaolin/renwu_type1");
	return 1;

}

int do_chakan()
{
	object me = this_player();

	if(me->query("class")!="shaolin1" && me->query("class")!="shaolin") return 0;
	if(!(me->query("family/master_name")) ) {
		message_vision("$n对$N说道: 你还是先去拜个师傅吧。\n",me,this_object());
		return 1;
	}
	if(!(me->query("shaolin/renwu_type1"))){
		printf("你现在没有任务。\n");
		me->delete("shaolin/renwu_nn");
		me->delete("shaolin/renwu_type");
		me->delete("shaolin/renwu_type1");
		return 1;
	}
	printf("你现在的任务是%s：%s。\n",me->query("shaolin/renwu_type1"),me->query("shaolin/renwu_type"));
	return 1;
}

int do_wancheng()
{
	object me = this_player();

	if(me->query("class")!="shaolin1" && me->query("class")!="shaolin") return 0;
	if(!(me->query("family/master_name")) ) {
		message_vision("$n对$N说道: 你还是先去拜个师傅吧。\n",me,this_object());
		return 1;
	}
	if(!(me->query("shaolin/renwu_type1"))){
		printf("你现在没有任务。\n");
		me->delete("shaolin/renwu_nn");
		me->delete("shaolin/renwu_type");
		me->delete("shaolin/renwu_type1");
		return 1;
	}
	switch(me->query("shaolin/renwu_type1")){
		case "干活" : 
			do_work_end();
		break;
		case "购买" : 
		break;
		case "采集" : 
		break;
		case "配药" : 
		break;
		case "炼丹" : 
		break;
		case "追捕" : 
		break;
		case "寻宝" : 
		break;
	}
	return 1;

}

int do_work_end()
{
	object me=this_player();
	int ii,nn;

	if((me->query("shaolin/renwu_nn"))) {
		command("shake");
		message_vision("$n对$N说道: 阿弥陀佛，出家人不打诳语，$N怎么能骗人呢？\n",me,this_object());
		tell_object(me, 
me->query("shaolin/renwu_type")+"你还差"+(string)me->query("shaolin/renwu_nn")+"次才行，快去吧！\n");
		return 1;
	}
	command("nod");
	command("spank "+me->query("id"));
	command("say 奖励你50点经验，40点潜能，好好干吧。\n");
	me->add("combat_exp", 50);
	me->add("potential", 40);
	me->delete("shaolin/renwu_nn");
	me->delete("shaolin/renwu_type");
	me->delete("shaolin/renwu_type1");
	return 1;
}

int do_shenqing(string arg)
{
	object me = this_player();
	int exp = (int)me->query("combat_exp");

	if(me->query("class")!="shaolin1" && me->query("class")!="shaolin") return 0;
	if(exp>500000) return 0;
	if(!(me->query("family/master_name")) ) {
		message_vision("$n对$N说道: 你还是先去拜个师傅吧。\n",me,this_object());
		return 1;
	}
	if(!arg) {
		command("say 你想申请什么任务呀？");
		return 1;
	}
	if(me->query("shaolin/renwu_type")) {
		command("say 你的任务还没完成呢，不能再申请新任务！");
		return 1;
	}
	if(me->query("shaolin/renwu")>15){
		command("pat "+me->query("id"));
		command("say 该去练功了，老是申请任务会影响修行的。");
		return 1;
	}
	if(arg!="干活" && arg!="购买" && arg!="采集" && arg!="配药" && arg!="炼丹" && arg!="追捕" && arg!="寻宝"){
		command("shake");
		command("say 好象没有这样的任务。");
		return 1;
	}
	command("smile");
	command("say 是["+me->query("family/master_name")+"]和尚的小徒弟呀，想申请任务？");
	command("say 呵呵，好呀，是应该多锻炼锻炼。");
	switch(arg){
		case "干活" : 
			do_work();
		break;
		case "购买" : 
			do_buy();
		break;
		case "采集" :
			do_search(); 
		break;
		case "配药" : 
			do_disp();
		break;
		case "炼丹" : 
			do_make();
		break;
		case "追捕" : 
			do_chase();
		break;
		case "寻宝" : 
			do_treasure();
		break;
	}
	return 1;
}

int do_work()
{
	object me=this_player();
	int ii,nn;

	if(renwu[0]==0) return notify_fail("暂时没有任务安排。\n");

	me->add("shaolin/renwu",1);
	ii=random((int)renwu[0])+1;
	nn=30+(random(me->query("kar"))*2);
	tell_object(me, "你到"+renwu[ii*2-1]+"去"+renwu[ii*2]+(string)nn+"次，不许偷懒!\n");
	me->set("shaolin/renwu_nn",nn);
	me->set("shaolin/renwu_type",renwu[ii*2]);
	me->set("shaolin/renwu_type1","干活");
	return 1;
	

}

int do_buy()
{
	object me=this_player();
	int ii,nn;

	if(renwu1[0]==0) return notify_fail("暂时没有任务安排。\n");
}

int do_search()
{
	object me=this_player();
	int ii,nn;

	if(renwu2[0]==0) return notify_fail("暂时没有任务安排。\n");
}

int do_disp()
{
	object me=this_player();
	int ii,nn;

	if(renwu3[0]==0) return notify_fail("暂时没有任务安排。\n");
}

int do_make()
{
	object me=this_player();
	int ii,nn;

	if(renwu4[0]==0) return notify_fail("暂时没有任务安排。\n");
}

int do_chase()
{
	object me=this_player();
	int ii,nn;

	if(renwu5[0]==0) return notify_fail("暂时没有任务安排。\n");
}

int do_treasure()
{
	object me=this_player();
	int ii,nn;

	if(renwu6[0]==0) return notify_fail("暂时没有任务安排。\n");
}



int accept_object(object me, object ob)
{
	int mm,nn,ii,rr;
	string name1,id1;

	if( !(me->is_apprentice_of(this_object()))) return 0;
	if(me->query("class")!="shaolin1") return 0;
	nn=me->query("shaolin/renwu");
	if((me->query("shaolin/renwu_ok")==1)||(nn==0)) return 0;
	mm=(nn-1)*4;

	rr=me->query("shaolin/renwu_type");
	if(rr==0){
		name1=renwu[mm];
		id1=renwu[mm+1];
	}
	else {
		name1=renwu1[mm];
		id1=renwu1[mm+1];
	}

	if( nn==5 ){
	if( (me->query("title")==renwu[mm+2])&&(ob->query("name")==name1)&&(ob->id(id1)) ){
		command("say 太好了，这正是我需要的东西，干的不错！\n");
		command("sigh");
		command("say 真是长江后浪推前浪，一代新人换旧人！为师已没有什么可教你的了。");
		command("say 拿上我的推荐信到慧能大师那里学艺吧！\n");
		printf("觉禅拿出纸和笔，飞快地写了一封信，装到信封里递给你。\n");
		ob = new(__DIR__"obj/letter1");
		ob->set("own_name",me->query("id"));
		ob->move( me );

		command("say 你我师徒一场，为师也没有什么东西，现在要分手了，送你个纪念品吧！\n");
		me->set("shaolin/tuijian",1);
		me->set("shaolin/renwu_ok",1);
		return 1;
	}
	}
	if( (me->query("title")==renwu[mm+2])&&(ob->query("name")==name1)&&(ob->id(id1)) ){
		command("haha");
		command("spank "+me->query("id"));
		command("say 很好，现在就提升你为" + renwu[mm+2+4] + "。\n");
		me->set("title",renwu[mm+2+4]);
		me->set("shaolin/renwu_ok",1);
		return 1;
	}

	return 0;
}
