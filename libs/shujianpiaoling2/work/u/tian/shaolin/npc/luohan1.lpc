#include <ansi.h>
inherit NPC;
void create()
{	
        int i,amun;
        string *order = ({"静","智","虚","慧","觉","清"});
        string *orderr = ({"品","多","苦","旋","叶","难","竹","风",
"色","仪","回","渡","新","古","天","安","灵","明","冰","莲","朴","涯","乘","法","加","安","断","避","田"});
        set_name( order[random(6)] + orderr[random(29)], ({ "luohan" }) );
        set("gender", "男性" );
        set("age", random(20)+30);
        set("long",
"他是十八罗汉阵的罗汉。\n");
        set("max_kee", 3000+random(1000));
        set("kee", 3000+random(1000));
        set("force", 2000+random(1000));
        set("max_force", 2000+random(1000));
        set("force_factor",30);
        set("combat_exp", 100000+random(500000));
        set_skill("unarmed", 100+random(100));
        set_skill("blade", 100+random(100));
        set_skill("sword", 100+random(100));
        set_skill("parry", 100+random(100));
        set_skill("dodge", 150+random(100));
        set_skill("yizhi-chan", 100+random(50));
        set_skill("sanhua-strike", 100+random(50));
        set_skill("cibei-blade", 100+random(50));
        set_skill("damo-sword", 100+random(50));
        set_skill("shaolin-dodge", 100+random(50));
        set_skill("fuxiang_force", 100+random(50));
        set_skill("literate", 80);

        map_skill("blade", "cibei-blade");
        map_skill("parry", "cibei-blade");
        map_skill("sword", "damo-sword");
        map_skill("dodge", "shaolin-dodge");
        map_skill("unarmed", "yizhi-chan");
        map_skill("force", "fuxiang_force");
 
        create_family("少林", 20, "弟子");
        setup();
        carry_object("/u/poor/obj/cloth/sengpao")->wear();
        carry_object("/u/poor/obj/weapon/blade")->wield();
}
void die(string arg)
{
	object me;
	me = this_player();
	me->set("shaolin/lh18", 1);
        ::die();
}

