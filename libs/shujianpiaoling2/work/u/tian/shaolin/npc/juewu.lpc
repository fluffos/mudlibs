// juewu.c 斋院大师傅-觉悟

inherit NPC;
string ask_for_eat();
string ask_for_jitui();

void create() {
  set_name("觉悟", ({ "jue wu", "wu" }));
  set("long",
    "这是一位胖胖的红光满面的中年僧人，他围着白围裙，笑咪咪的，\n"
    "你可以向他询问进餐。\n"
  );


  set("gender", "男性");
  set("attitude", "heroism");
  //	set("class", "shaolin1");
  set("title", "少林寺斋院大师傅");
  //	create_family("少林寺", 9, "弟子");

  set("inquiry", ([
    "进餐": (: ask_for_eat :),
    "烤鸡腿": (: ask_for_jitui :),
    "以前": "呵，我出家以前是赫赫有名的掌勺大师傅。\n",
    "出家以前": "嘿嘿，贫僧以前在富贵酒楼。\n",
    "富贵酒楼": "富贵酒楼你不知道？那可是汝洲城最大的酒楼。\n",
  ]));
  set("chat_chance", 3);

  set("chat_msg", ({
    "觉悟嘿嘿一乐，不知想到什么事情。\n",
    "觉悟自言自语道：我以前呀，嘻嘻，不说了。\n",
  }));


  set("age", 40);

  set("max_gin", 500);
  set("max_kee", 1000);
  set("max_sen", 500);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("combat_exp", 300000);



  set_skill("force", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_skill("magic", 60);

  setup();

  carry_object(__DIR__ "obj/weiqun")->wear();
}

string ask_for_eat() {
  int tt;
  object ob, me = this_player();

  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  tt = localtime(time() * 60)[2] / 2;
  if (tt != 6 && tt != 7 && tt != 11 && tt != 12 && tt != 17 && tt != 18) {
    printf("要进餐呀，呵呵，现在才%d点，还没到时间呢。\n", tt);
    return "别老想着吃，快去练功吧，等一会再来。\n";
  }
  command("nod");
  printf("大师傅给你两个包子和一只水壶。\n");
  ob = new("/obj/example/dumpling");
  ob->move(me);
  ob = new("/obj/example/dumpling");
  ob->move(me);
  ob = new("/obj/example/teapot");
  ob->move(me);
  return "是进餐的时间了，快坐下吃吧。\n";

}

string ask_for_jitui() {

  object ob, me = this_player();

  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (me->query("give")) return 0;
  command("xixi");
  command("say 你这家伙，怎么知道我这里有烤鸡腿？");
  command("say 既然知道了，就给你一只吧。");
  message_vision("觉悟看看四周没人，偷偷从怀里摸出个东西塞到$N的手里。\n", me);
  ob = new("/obj/example/jitui");
  ob->set("own_name", me->query("id"));
  ob->move(me);
  set("give", 1);

  return "可千万别告诉别人。\n";

}

void reset() {
  set("give", 0);
}
