// lhzhen  罗汉阵
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "罗汉阵入口");
	set("long", @LONG
这里是罗汉阵入口。少林弟子只有闯过十八罗汉阵，才有下山云游
的资格，可是能全身闯过罗汉阵的少林弟子寥寥无几。据说闯罗汉阵对
少林弟子研修武功有很大益处。
LONG
	);

	set("exits", ([
            "southeast": __DIR__"lhtang",
            "enter": __DIR__"lhzhen1",
	]));
	
	setup();
	replace_program(ROOM);
}
