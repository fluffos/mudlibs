//liangong6  练功房

inherit ROOM;

void create() {
  set("short", "练功房");
  set("long", @LONG
这里是少林寺的练武房。平时寺里的武僧在这里勤练武功，
房里地面由一块块坚硬的青石铺就。武僧成年累月地踩踏已使得
这些青石平整光滑，上面清晰可见一个个浅浅的凹坑。房间里有
几个武僧正在汗流浃背地练功。
    西面是间练功房，里面传来阵阵练武的吆喝声，北面是一间
药品房，南面是修行室，东面是书房。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "shufang",
    "west": __DIR__ "liangong1",
    "north": __DIR__ "yaofang",
    "south": __DIR__ "xiuxing",
  ]));
  set("objects", ([
    __DIR__ "npc/kongbo": 1,
  ]));
  set("no_sleep", 1);

  set("no_clean_up", 0);

  setup();
  //        replace_program(ROOM);
}

int valid_leave(object who, string exit) {
  object ob;
  ob = present("kongbo", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "south") && (who->query("combat_exp") > 500000) && (present(
    "kongbo",
    environment(who)
  )))
    return notify_fail("空泊说道：“南边是少林寺的修行室，你已经不需要修行了！”\n");
  return ::valid_leave(who, exit);
}
