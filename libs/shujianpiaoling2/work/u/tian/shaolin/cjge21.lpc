//cjge21.c  藏经阁二楼窗台
inherit ROOM;

void create()
{
        set("short", "藏经阁二楼窗台");
        set("long", @LONG
这是藏经阁二楼的窗台，只见阁中，打扫的纤尘不染。左右各两排
红木书架摆满了佛经，几个中年僧人正专心致志的默读佛经。有个老年
僧人在整理架上的经书。
LONG
        );
        set("exits", ([/* sizeof() == 3 */
//           "up" : __DIR__"cjge3",
//           "down" : __DIR__"cjge1",
]));

        set("no_clean_up", 0);

        setup();
}

void init()
{
	add_action("do_climb", ({"enter"}));
}

int do_climb(string arg)
{
	object me = this_player();
	object room;

	if(!arg) return 0;
	if(arg!="窗户") return 0;
	write("你一猫腰，从一扇没关的窗户钻了进去！\n");
	room = (object)__DIR__"cjge2";
	message("vision", "只见"+me->query("name")+"走了过来。\n",room );
	me->move(room);
	message("vision", me->query("name")+"一闪身，不见了。\n",this_object());
	return 1;
	
}
