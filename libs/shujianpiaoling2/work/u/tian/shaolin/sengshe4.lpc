inherit ROOM;

void create()
{
	set("short", "休息室");
	set("long", @LONG
这是一间极为简陋的休息室。供游人和香客休息，环视四周，除
了几张长凳外，室内空荡荡地别无他物。
LONG
	);

	set("exits", ([
            "south": __DIR__"zoulang1",
	]));

        set("sleep_room",1);
	
