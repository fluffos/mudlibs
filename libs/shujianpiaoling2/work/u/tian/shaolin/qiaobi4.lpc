//qiaobi4.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "峭壁的树上");
  set("long", @LONG
你站在长在峭壁上的一棵松树上，山风吹来，树身一阵摇晃，吓的你赶紧趴
在树上，一动也不敢动，心中一个劲的念佛，你再也不想在这多呆一秒钟！两手
可绝不敢松劲，摔下去就会粉身碎骨的。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
  ]));
  set("item_desc", ([
    "峭壁": "是一个万丈峭壁，往下一看云雾缭绕，深不可测。\n",
    "松树": "一棵不是很大，但很粗壮旺盛的松树，根部深深的扎在峭壁上。\n",
    "根部": "你仔细看看松树的根部，发现松树的根部背面长着什么东西。\n",
  ]));

  set("no_clean_up", 0);

  setup();
  //        replace_program(ROOM);
}

void init() {
  add_action("do_climb", ({ "climb", "pa" }));
  add_action("do_search", ({ "search", "zhao" }));
}

int do_search(string arg) {
  object ob, me = this_player();

  if (arg != "背面") return 0;
  if (query("zhao") == 1)
    return notify_fail("这里只有些青苔，没有别的。\n");
  set("zhao", 1);
  message("vision", me->name() + "找到什么东西。\n", environment(me), me);
  if (random(me->query_kar() - 15) < 5) {
    write("你从松树背面找到一枚千年灵芝，可是不小心没拿住，掉了。\n");
    return 1;
  }
  write("你从松树背面找到一枚千年灵芝！\n");
  ob = new(__DIR__ "obj/lingzhi");
  ob->set("own_name", me->query("id"));
  ob->move(me);
  return 1;
}

int do_climb(string arg) {
  object ob, me = this_player();

  if (arg == "up") {
    message_vision("$N用手攀着峭壁上的石缝，小心翼翼地向上爬去。\n", me);
    ob = (object)__DIR__ "qiaobi2";
    tell_room(ob, me->query("name") + "从下面爬了上来。\n");
    me->move(ob);
    return 1;
  }
  return 0;
}

void reset() {
  ::reset();
  delete("zhao");
}
