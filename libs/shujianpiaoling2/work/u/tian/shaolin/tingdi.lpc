//tingdi.c 观松亭底

inherit ROOM;

mapping skill = ([
  "name": "parry",
  "exp_required": 10000,
  "sen_cost": 50,
  "difficulty": 30,
  "max_skill": 50,
]);


void create() {
  set("short", "观松亭底");
  set("long", @LONG
这是一间很小的底下室，四周黑黝黝的，看不清有什么东西。
这里没有明显的出口。
LONG
  );

  set("no_clean_up", 0);

  setup();
  //        replace_program(ROOM);
}

void init() {
  add_action("do_du", ({ "study", "du" }));
  add_action("do_use", ({ "use" }));
  add_action("do_push", ({ "push" }));
  add_action("do_look", ({ "look" }));
}

void reset() {
  ::reset();
  delete("du");
  delete("you-ren");
}

int do_du(string arg) {

  object ob = this_object(), me = this_player();
  int my_skill;
  int cost;

  if (ob->query("du") != 1) return 0;
  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (me->query_temp("sleeping") || me->query_temp("dazuo") || me->is_fighting()) {
    write("你现在无法学习！\n");
    return 1;
  }
  if (arg != "石壁") {
    write("你要读什么？\n");
    return 1;
  }

  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学学读书识字(literate)吧。\n");
    return 1;
  }

  message("vision", me->name() + "专心读一遍石壁。\n", environment(me), me);

  if ((int)me->query("combat_exp") < skill["exp_required"]) {
    write("你的实战经验不足，再怎麽读也没用。\n");
    return 1;
  }

  if (!SKILL_D(skill["name"])->valid_learn(me)) return 0;

  cost = skill["sen_cost"] + skill["sen_cost"] * (skill["difficulty"] - (int)me->query("int")) / 20;
  //printf("%d ",cost);
  if ((int)me->query("sen") < cost) {
    write("你现在过於疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  //	if( me->query_skill(skill["name"], 1) > skill["max_skill"] ) {
  //		write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
  //		return 1;
  //	}

  me->receive_damage("sen", cost);

  if (!me->query_skill(skill["name"], 1))
    me->set_skill(skill["name"], 0);

  my_skill = me->query_skill(skill["name"], 1);
  if (my_skill > (me->query("kar") - 8) * 10) {
    write("好象是缘分已尽，你再怎么读也没用。\n");
    return 1;
  }
  if (my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp")) {
    write("也许是缺乏实战经验，你没有任何收获。\n");
    return 1;
  }

  me->improve_skill(skill["name"], (int)me->query_skill("literate", 1) / 5 + 1);
  write("你研读有关" + to_chinese(skill["name"]) + "的技巧，有点心得。\n");
  return 1;
}

int do_use(string arg) {
  object ob1, ob = this_object(), me = this_player();

  if (!(ob1 = present("huo ba", me))) return 0;
  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (arg != "火把") {
    write("无效的命令。\n");
    return 1;
  }
  if (ob->query("du") == 1) {
    write("火把点着呢，小心烫着！\n");
    return 1;
  }
  write("你拿出火把来，点着，发现四周和顶上都是石壁。\n");
  ob->set("du", 1);
  return 1;
}

int do_look(string arg) {
  object ob1, ob = this_object(), me = this_player();


  if (ob->query("du") != 1) return 0;
  if (arg == "石壁") {
    write("你高高举起火把，凑近石壁仔细一看，发现上面刻着很多小人和图案。\n");
    return 1;
  }
  if (arg == "顶上") {
    write("你高高举起火把，抬头向上仔细查看，发现上面石壁好象有道缝。\n");
    return 1;
  }

  write("无效的命令。\n");
  return 1;
}

int do_push(string arg) {
  object ob, me = this_player();

  if (arg != "顶上") return 0;
  write("你双手顶着上面的石壁，一运力，居然推开了一块石板，露出一个洞口。\n");
  write("你一提气，双脚一纵，从洞口处跃了出来。\n");
  ob = (object)__DIR__ "guansong";
  ob->delete("you-ren");
  ob->delete("move1");
  tell_room(ob, me->query("name") + "走了过来。\n");
  me->move(ob);
  tell_room(this_object(), me->query("name") + "纵身一跃，出去了。\n");
  return 1;

}
