// bqfang 兵器库

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "兵器库");
	set("long", @LONG
这里是少林寺存放兵器的库房，到处银光闪闪，让人眼花缭
乱。兵器架上刀、剑、棍、杖，锤，各色各样的兵器应有尽有。
有个武僧负责管理。少林弟子在此可以领取(lingqu)兵器，不过
用完要记得归还(guihuan)呀！
LONG
	);
	set("objects",([
	__DIR__"npc/zhiqiao" : 1,
	]));

	set("exits", ([
            "south": __DIR__"liangong6",
	]));
	
	setup();
	replace_program(ROOM);
}

