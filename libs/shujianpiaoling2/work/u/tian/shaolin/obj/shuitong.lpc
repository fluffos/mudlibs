// shuitong.c 

inherit ITEM;

void create() {
  set_name("水桶", ({ "shui tong" }));
  set_weight(400);
  set_max_encumbrance(80000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "这是一个铁皮水桶，上面有些锈迹。\n");
    set("value", 1);
  }
}

int is_container() { return 1; }
