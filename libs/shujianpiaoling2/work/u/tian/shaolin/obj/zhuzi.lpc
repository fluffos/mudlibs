// zhuzi.c 小珠子

#include <weapon.h>

inherit THROWING;

void create() {
  set_name("小珠子", ({ "zhuzi" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一粒色彩斑斓的玻璃小珠子。\n");
    //		set("unit", "粒");
    set("base_unit", "粒");
    set_weight(300);
    set("unit", "个");
  }
  set_amount(1);
  init_throwing(2);

  setup();
}
