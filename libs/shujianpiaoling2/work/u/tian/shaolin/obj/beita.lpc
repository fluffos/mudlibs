// beita.c 碑拓

inherit ITEM;

void create() {
  set_name("碑拓", ({ "bei ta", "book", }));
  set_weight(200);
  set("unit", "张");
  set("long", "一张碑文的拓片，是刚刚制成的，墨迹尚且未干。\n");
  set("value", 0);
  set("skill", ([
    "name": "magic",
    "exp_required": 1000,
    "sen_cost": 30,
    "difficulty": 30,
    "max_skill": 58,
  ]));
}
