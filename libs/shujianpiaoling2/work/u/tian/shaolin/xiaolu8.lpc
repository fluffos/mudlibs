inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
你走在一条山间小路上。周围树林郁郁苍苍，间或传来鸟鸣声。前
面传来潺潺的流水声。
LONG
       );
        set("exits", ([/* sizeof() == 2 */
            "north" : __DIR__"xiaoqiao",
            "west" : __DIR__"xiaolu3",
]));

        set("no_clean_up", 0);
	set("outdoors","shaolin");

        setup();
        replace_program(ROOM);
}

