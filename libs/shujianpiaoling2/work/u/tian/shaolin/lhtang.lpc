// lhtang  罗汉堂
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "罗汉堂");
	set("long", @LONG
这里是罗汉堂。两旁塑着少林十八罗汉的金身佛像，或喜或怒，或
嗔或静，或站或坐，神形各异，有的手持伏魔圈，有的高举金钢杵，栩
栩如生，叹为观止。
LONG
	);

	set("exits", ([
            "south": __DIR__"changlang1",
            "northwest": __DIR__"lhzhen",
	]));
	set("objects",([
	__DIR__"npc/jingping" : 1,
	]));
	
	setup();
	replace_program(ROOM);
}
