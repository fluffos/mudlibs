inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
路边长满杂草，地上湿漉漉的，青苔遍布，身边水气缭绕，雾气
蒸蒸。前面传来轰鸣的水声，越往前走水声越大。
LONG
       );
        set("exits", ([/* sizeof() == 2 */
            "southwest" : __DIR__"taijie1",
            "northeast" : __DIR__"poubu",
]));

        set("no_clean_up", 0);
	set("outdoors","shaolin");

        setup();
        replace_program(ROOM);
}