//ciayuan1  菜园草屋
inherit ROOM;

void create()
{
        set("short", "草屋");
        set("long", @LONG
这是菜园里的一间小小的草屋，地上有些稻草，在墙角放着一些农具。
LONG
        );
        set("exits", ([/* sizeof() == 1 */
           "south"  : __DIR__"caiyuan",
]));

        set("no_clean_up", 0);
		set("item_desc",([
			"农具"	:"墙角放一些常用的农具，锄头，铁锨，叉子，还有几只水桶。\n",
		]));

        setup();
}


void init()
{
	add_action("do_search", ({"search","zhao"}));
}

int do_search(string arg)
{
	object ob;

	if(arg != "墙角") return 0;
	if((int)query("zhao")== 1)
		return notify_fail("这里只有些稻草，没有别的。\n");
	set("zhao", 1);
	message_vision("$N从地上找到什么东西。\n",this_player());
	ob = new( __DIR__"obj/shuitong");
	ob ->move(this_player());
	return 1;
}

void reset()
{
	::reset();
	delete("zhao");
}


