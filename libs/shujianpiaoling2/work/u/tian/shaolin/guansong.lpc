inherit ROOM;

void create()
{
        set("short", "观松亭");
        set("long", @LONG
攀登到此，你不禁觉得有些气喘，额头上微微见汗，正要寻个歇
息之处，眼前出现一个四角凉亭，地上放着石桌石凳，你心中不由的
一阵高兴。
    抬头望去，远远地似乎有一些寺院。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
            "southdown" : __DIR__"taijie2",
            "northeast" : __DIR__"taijie3",
]));
	set("item_desc", ([ /* sizeof() == 1 */
  "凉亭" : "一个四角凉亭，周围都是奇松怪树，左侧高峰耸立，令人触目惊心。\n",
  "石桌" : "一张整块青石刻就的石桌，放在凉亭的正中。\n",
  "石凳" : "几个小石凳，雕刻的精巧细致，似乎年代久远。\n",
]));

	set("objects",([
	__DIR__"npc/huayuanseng" : 1,
	]));



        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}
