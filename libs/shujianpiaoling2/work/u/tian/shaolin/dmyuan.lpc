//dmyuan 达摩院
inherit ROOM;

void create()
{
        set("short", "达摩院");
        set("long", @LONG
这里便是少林寺赫赫有名的达摩院。是少林寺取长补短，钻研绝技
的地方，收藏有天下各个门派的武功秘籍，由少林寺中悟性极高，武艺
超群的弟子钻研学习，可不是一般人随便进入的地方。这里正有几个面
目清瘦的老和尚闭目打坐，潜心修炼。
LONG
        );
        set("exits", ([/* sizeof() == 1 */
           "south"  : __DIR__"xiaoyuan5",
        "north"  : __DIR__"newdmyuan1",
]));
	set("objects",([
	__DIR__"npc/minghui" : 1,
	]));

        set("no_clean_up", 0);

        setup();
}

int valid_leave(object me,string dir)
{
	string class_name;
	object seng,ob;

	seng=present("ming hui",environment(me));
	if(!seng) return 1;
	class_name=me->query("class");
	if(dir!="north") {
		if(!(ob=present("book",me))) return 1;
		if(ob->query("name")=="达摩院的书")
			return notify_fail("明晦伸手拦住你，说道：“达摩院的书不能带出去。”\n");
		return 1;
	}
	if (class_name!="shaolin"&&class_name!="shaolin1") 
		return notify_fail("明晦伸手拦住你，笑着说道：“里面是达摩院内室，施主请留步。”\n");
	if(class_name=="shaolin1")
		return notify_fail("明晦伸手拦住你，说道：“里面是达摩院内室，俗家弟子不能进入。”\n");
	if(this_player()->query("family/generation")>8)
		return notify_fail("明晦伸手拦住你，说道：“里面是达摩院内室，你现在辈分太低，不能进。”\n");
	return 1;
}

void init()
{
	object me=this_player(),seng;	

	seng=present("ming hui",environment(me));
	if(!seng){
		seng=new(__DIR__"npc/minghui");
		seng->move(this_object());
	}
	add_action("do_put", ({"put"}));
}

int do_put(string arg)
{
	write("不要偷藏东西！\n");
	return 1;
}

	
