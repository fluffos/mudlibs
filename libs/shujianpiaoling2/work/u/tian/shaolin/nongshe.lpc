inherit ROOM;

void create()
{
        set("short", "农舍");
        set("long", @LONG
室内光线较暗，乍一进来，几乎什么也看不见，定一定神，才看
清是一间普通的农舍，一张小床，一张桌子，一把椅子，收拾的干干
净静，仔细一闻，屋里居然有一股淡淡的清香。
    墙上有一幅字，靠墙有个碗柜，墙角放一些农具。但是屋里没人。
LONG
       );
        set("exits", ([/* sizeof() == 1 */
            "out" : __DIR__"nongjia",

]));
	set("item_desc",([
	"墙上的字":"清心寡欲。\n",
	"桌子":"一张粗木方桌，上面放着茶壶，茶杯，还有一块抹布。\n",
	]));

        set("no_clean_up", 0);

        setup();
//        replace_program(ROOM);
}

void init()
{
	add_action("do_get", ({"get"}));
	add_action("do_use", ({"use"}));
}

int do_get(string arg)
{
	object ob;
	string sth,sb;

	if(!arg) return 0;
	if(sscanf(arg, "%s from %s", sth, sb)!=2 ) return 0;
	if(sb!="桌子") return 0;
	if(sth=="抹布"){
		if((int)query("zhao")== 1)
			return notify_fail("这东西好象不能拿。\n");
		set("zhao", 1);
		message_vision("$N找到什么东西。\n",this_player());
		ob = new( __DIR__"obj/mabu");
		ob->set("own_name",this_player()->query("id"));
		ob ->move(this_player());
		return 1;
	}
	if(sth=="茶杯"){
		if((int)query("zhao1")== 1)
			return notify_fail("这东西好象不能拿。\n");
		set("zhao1", 1);
		message_vision("$N找到什么东西。\n",this_player());
		ob = new( __DIR__"obj/chabei");
		ob->set("own_name",this_player()->query("id"));
		ob ->move(this_player());
		return 1;
	}
}

void reset()
{
	::reset();
	delete("zhao");
	delete("zhao1");
}

int do_use(string arg)
{
	object ob,me=this_player();
	string sth,sb;

	if(!arg) return 0;
	if(sscanf(arg, "%s to %s", sth, sb)!=2 ) return 0;
	if(sb!= "抹布"||sth!="茶杯") return 0;
	if(!(ob=present("cha bei",me))) return 0;
	if(!(ob=present("ma bu",me))) return 0;
	destruct(ob);
	write("你把茶杯里的水倒在抹布上，把抹布弄湿了。\n");
	ob = new( __DIR__"obj/shimabu");
	ob ->set("own_name",me->query("id"));
	ob ->move(me);
	return 1;
}