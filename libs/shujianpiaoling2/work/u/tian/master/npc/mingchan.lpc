// mingchan

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

string ask_me();

void create() {
  set_name("明禅", ({ "ming chan", "chan", }));
  set("long",
    "这是一位红光满面的中年僧人，在这里打坐。\n"
  );


  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin");

  set("inquiry", ([
    "空见": "你说空见大师呀，是少林寺方丈。\n",
    "达摩院": "。。。。。。。",
  ]));

  set("age", 45);

  set("max_gin", 1500);
  set("max_kee", 3000);
  set("max_sen", 1500);
  set("force", 9000);
  set("max_force", 4500);
  set("force_factor", 140);
  set("combat_exp", 8000000);



  set_skill("force", 200);
  set_skill("fuxiang_force", 200);
  set_skill("dodge", 200);
  set_skill("shaolin-dodge", 200);
  set_skill("yizhi-chan", 200);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("blade", 200);
  set_skill("staff", 200);
  set_skill("wenshu_staff", 200);

  //	set_skill("essencemagic", 250);
  set_skill("buddhism", 200);
  //	set_skill("magic", 250);
  set_skill("literate", 100);

  map_skill("force", "fuxiang_force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "yizhi-chan");
  map_skill("parry", "wenshu_staff");
  map_skill("staff", "wenshu_staff");

  set_temp("apply/attack", 5);
  set_temp("apply/defense", 5);


  set("title", "少林寺达摩院老僧");
  create_family("少林寺", 4, "弟子");
  set("no_teach", 1);
  set("family/privs", 1);

  setup();
  //	carry_object("/d/city/obj/weapon/staff/chanzhang")->wield();
  carry_object(__DIR__ "obj/qing_jiasha")->wear();
}

void attempt_apprentice(object ob) {
  command("shake");
  message_vision("$n双手合十，对$N说道: 我是不收徒弟的，你还是找我师傅空见去吧！\n", ob, this_object());
  ob->delete_temp("pending/apprentice");
  return;
}
