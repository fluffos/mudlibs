// kongbo.c  空泊

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

string ask_me();

void create() {
  set_name("空泊", ({ "kong bo", "kongbo", }));
  set("long",
    "这是一位红光满面的中年僧人，神态肃然地站在这里。\n"
  );


  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin");

  set("inquiry", ([
    "空见": "你说空见大师呀，他是我的师兄，现在是少林寺方丈。\n",
    "修行": "少林寺中辈分较低的僧人才可以去修行。",
  ]));

  set("age", 55);

  set("max_gin", 1500);
  set("max_kee", 3000);
  set("max_sen", 1500);
  set("force", 9000);
  set("max_force", 4500);
  set("force_factor", 140);
  set("combat_exp", 8000000);



  set_skill("force", 250);
  set_skill("fuxiang_force", 250);
  set_skill("dodge", 250);
  set_skill("shaolin-dodge", 250);
  set_skill("yizhi-chan", 250);
  set_skill("parry", 250);
  set_skill("unarmed", 250);
  set_skill("blade", 250);
  set_skill("staff", 250);
  set_skill("wenshu_staff", 250);

  //	set_skill("essencemagic", 250);
  set_skill("buddhism", 250);
  //	set_skill("magic", 250);
  set_skill("literate", 100);

  map_skill("force", "fuxiang_force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "yizhi-chan");
  map_skill("parry", "wenshu_staff");
  map_skill("staff", "wenshu_staff");

  set_temp("apply/attack", 5);
  set_temp("apply/defense", 5);


  set("title", "少林寺神僧");
  create_family("少林寺", 3, "弟子");
  set("no_teach", 1);
  set("family/privs", 1);

  setup();
  //	carry_object("/d/city/obj/weapon/staff/chanzhang")->wield();
  carry_object(__DIR__ "obj/qing_jiasha")->wear();
}

void attempt_apprentice(object ob) {
  command("shake");
  message_vision("$n双手合十，对$N说道: 我是不收徒弟的，你还是找我师兄空见去吧！\n", ob, this_object());
  ob->delete_temp("pending/apprentice");
  return;
}
