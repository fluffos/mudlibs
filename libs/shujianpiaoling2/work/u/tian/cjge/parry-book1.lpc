//fayuan-jing
inherit ITEM;

void setup() {}

void init() {
  add_action("do_du", "du");
  add_action("do_du", "study");
}

void create() {
  set_name("《达摩心经》", ({ "damoxin-jing", "jing" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本用梵文记载的高深佛法的书籍。\n");
    set("value", 0);
    set("material", "paper");
  }
}


int do_du(string arg) {
  object me = this_player();
  object ob;
  mapping skill;
  int lvl;

  if (!(arg == "damoxin-jing" || arg == "jing"))
    return 0;

  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }
  if (me->query_temp("dazuo")) {
    write("你无法在练功打坐中专心下来研读新知！\n");
    return 1;
  }
  if (me->query_temp("sleeping")) {
    write("你正在睡眠中，不能学习技能。\n");
  }
  if (!id(arg)) {
    write("你要读什么？\n");
    return 1;
  }
  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学点文化(literate)吧。\n");
    return 1;
  }
  message_vision("$N拿出《达摩心经》，开始细细钻研起来。\n", me);
  if ((int)me->query("sen") < 40) {
    write("你现在过于疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  lvl = me->query_skill("buddhism", 1);
  if ((int)me->query("combat_exp") < (int)lvl * lvl * lvl / 10) {
    write("你的实战经验不足，再怎么读也没用。\n");
    return 1;
  }

  if (me->query_skill("fanwen", 1) < 150) {
    write("你研读了一会儿，但是无法将上面所写与自己所学的联系起来。\n");
    return 1;
  }
  if (me->query_skill("parry", 1) > 151) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }

  me->receive_damage("sen", 40);

  me->improve_skill("parry", (int)me->query_skill("literate", 1) / 3 + 1);
  write("你研读《达摩心经》，颇有心得。\n");
  return 1;
}
