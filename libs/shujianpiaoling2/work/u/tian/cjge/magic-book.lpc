// literate_book.c

inherit ITEM;

void create()
{
        set_name("《悔心经》", ({ "huixin-jing","jing", }));
        set_weight(600);
        set("unit", "本");
        set("long", "一本记载高深佛法的书籍。\n");
        set("value", 300);
        set("skill", ([
                "name": "literate",
                "exp_required": 100,
                "sen_cost": 20,
                "difficulty": 30,
                "max_skill": 70  
        ]) );
}
 
