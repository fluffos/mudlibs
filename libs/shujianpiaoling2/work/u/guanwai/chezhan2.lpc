#include <ansi.h>
inherit ROOM;

void check_trigger();
void on_board();
void arrive();
void close_passage();
int do_zuo(string arg);
int do_dive();
void reset();


void create ()
{
  set ("short", "藏边车站");
  set ("long", @LONG
这是提供前往中原的马车的驿站，由于去中原路途遥远，还要
跋涉雪山草地，所以朝廷专门在此开设车站，为藏汉两族人民的交
往提供便利。车站的开通促进了中原和西域文化的交流，保障了国
家的安定团结和繁荣昌盛。站外正缓缓驶来一辆马车（mache）。
LONG);

  set("item_desc", ([ /* sizeof() == 1 */
  "mache" : "一辆整洁宽敞的四轮马车，后面还拖着一节载货的车厢，你可以坐(sit)上去。
",
]));
  set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"suishiroad",
]));
  set("outdoors", "guanwai");

  setup();
}

void init()
{
    add_action("do_zuo", "zuo");
    add_action("do_zuo", "sit");
}

void check_trigger()
{
    object room;

    if(!query("exits/enter") ) {
        if( !(room = find_object(__DIR__"mache")) )
            room = load_object(__DIR__"mache");
        if( room = find_object(__DIR__"mache") ) {
            if((int)room->query("zuo_trigger")==0 ) {
                room->set("zuo_trigger", 1);
                set("exits/enter", __DIR__"mache");
                room->set("exits/out", __FILE__);
                message("vision", "一辆马车从东面驶了过来。\n", this_object() );
                message("vision", "马车缓缓地停了下来。\n", room);
                remove_call_out("on_board");
                call_out("on_board", 20);
            }
            else
                message("vision", "车夫正在休息，看样子还得等一等。\n",this_object() );
        }
        else
            message("vision", "ERROR: mache not found\n", this_object() );
    }
    else 
        message("vision", "马车已经到站了，随时都可上去。\n",
            this_object() );
}


void on_board()
{
    object room;

    if( !query("exits/enter") ) return;

    message("vision", "车夫扬鞭一喝，马车向东方驶去。\n",
        this_object() );

    if( room = find_object(__DIR__"mache") )
    {
        room->delete("exits/out");
        message("vision", "\n马车缓缓行驶着，从车窗往外望去，周围有时是一片广阔的田野，
有时又是颠簸的山路和深林。\n", room );
    }
    delete("exits/enter");

    remove_call_out("arrive");
    call_out("arrive", 60);
}

void arrive()
{
    object room;
    if( room = find_object(__DIR__"mache") )
    {
        room->set("exits/out", "/u/guanwai/chezhan");
        message("vision", "\n马车缓缓停了下来，车夫喊道：“客官，到啦。”\n",room );
    }
    remove_call_out("close_passage");
    call_out("close_passage", 90);
}

void close_passage()
{
    object room;
    if( room = find_object(__DIR__"mache") ) {
        room->delete("exits/out");
        message("vision","车夫扬鞭一喝，马车向东方驶去。\n", room);
room->set("zuo_trigger", 0);
    }
}

int do_zuo(string arg)
{
    string dir;

    if( (arg=="mache") || (arg=="马车")){ 
        message_vision("$N向车夫招手，喊道：车老板，我要去中原。\n", this_player());
        check_trigger();
        return 1;
    }
    else return notify_fail("你要坐上什么？\n");
}

void reset()
{
    object room;

    ::reset();
    if( room = find_object(__DIR__"mache") )
        room->delete("zuo_trigger"); 
}
