inherit ROOM;

void create() {
  set("short", "后寺院");
  set("long", @LONG
这是塔尔寺后寺，院落里有很大的空地，六名黄衣喇嘛分六个方
位站立，个个神情严肃。这正是黄教护教大阵“阿叠多杖阵”。
LONG
  );
  set("exits", ([
    "east": __DIR__ "wensi",
  ]));
  set("objects", ([
    __DIR__ "npc/lama_zhen1": 1,
    __DIR__ "npc/lama_zhen2": 1,
    __DIR__ "npc/lama_zhen3": 1,
    __DIR__ "npc/lama_zhen4": 1,
    __DIR__ "npc/lama_zhen5": 1,
    __DIR__ "npc/lama_zhen6": 1,
  ]));
  set("outdoors", "guanwai");
  setup();
}
int valid_leave(object me, string dir) {
  if (me->query_temp("lama/jianzhen"))
    me->delete_temp("lama/jianzhen");
  return ::valid_leave(me, dir);
}
