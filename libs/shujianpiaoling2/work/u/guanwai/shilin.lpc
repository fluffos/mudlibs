
inherit ROOM;

void create()
{
        set("short", "蜀南石林");
        set("long", @LONG
在四川南部兴文县城南六十里处，地面石峰如林，地下溶洞纵横，构
成一种奇特的自然风光。石林有一圆柱形巨石拔地而起，形如塔，好似欢
迎宾客，故名“迎宾塔”。“塔”东不远，怪石奇峰，鳞次节比，石柱、
石笋、石屏、石峰、石兽、石人，突兀峥嵘。还有夫妻峰、山鹰峰、七女
峰等名胜。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "southwest" : __DIR__"rongdong",
  "northeast" : __DIR__"guanroad2",
  "down" : "/u/dahui/zheng/shilin00",
]));
        set("outdoors", "changan");
        set("objects", 
        ([
              "/npc/nknpc" : 1,
        ]));

        setup();
	replace_program(ROOM);
}
