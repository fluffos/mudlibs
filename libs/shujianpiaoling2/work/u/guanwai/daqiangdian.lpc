#include <ansi.h>
inherit ROOM;
int do_build(string arg);
int complete_build(object me);

void create() {
  set("short", "大强巴殿");
  set("long", @LONG
这是著名的大强巴殿。殿内“未来佛”佛像为镏金铜佛，耗用黄
金六七百两，造型生动，工艺精湛。
LONG
  );
  set("exits", ([
    "north": __DIR__ "dajindian",
  ]));
  set("objects", ([
    __DIR__ "npc/shimoke": 1,
  ]));
  set("outdoors", "guanwai");
  set("no_fight", 1);
  set("hell", 1);
  set("no_study", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("complete_build", random(10) + 3, ob);
  add_action("do_build", "build");
  add_action("close_cmds", "fight");
  add_action("close_cmds", "exert");
  add_action("close_cmds", "perform");
}
int close_cmds(object me, string arg) {
  return 1;
}

int do_build(string arg) {
  object me = this_player();
  if (arg != "temple")
    return notify_fail("你要修建什么？\n");
  if (me->query("marks/lamajob") != "tile")
    return notify_fail("你并没有修建金殿的任务。\n");
  if (me->query_temp("build_temple") > 20)
    return notify_fail("你的工作已经完成了。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (me->query("sen") < 22)
    return notify_fail("你心神不定，无法静下心来修建金殿。\n");
  if (!me->query_temp("build_temple"))
    message_vision(CYN "$N一边堆砌砖瓦，一边将损坏的墙角和大梁修补完缮。\n" NOR, me);
  else
    message_vision(CYN "$N在砖瓦上刷上金漆，然后去寺后继续搬运砖石。\n
$N一边堆砌砖瓦，一边将损坏的墙角和大梁修补完缮。\n" NOR, me);
  me->start_busy(6);
  me->receive_damage("sen", random(20) + 1);
  if (me->query_skill("unarmed", 1) < 20) {
    me->improve_skill("unarmed", random((int)me->query("kar")) + 10);
    me->add("potential", 1);
  }
  me->add("life_exp", random(10) + 1);
  me->set_temp("build_now", 1);
  return 1;
}
int complete_build(object ob) {
  int i;
  int damage;
  object temple;
  if (!ob) return 0;
  if (!ob->query_temp("build_now")) {
    call_out("complete_build", random(20) + 1, ob);
    return 0;
  }
  if (ob->query_temp("build_temple") < 20 && environment(ob) == this_object()) {
    tell_object(this_object(), "\n大殿内气度严谨，香烟缭绕，令人油然而生敬畏之心。\n");
    ob->add_temp("build_temple", 1);
    if (environment(ob) == this_object())
      call_out("complete_build", random(20) + 1, ob);
  } else {
    ob->remove_call_out("complete_build");
    tell_object(this_object(), CYN "\n只见大殿渐渐焕然一新，你的任务终于完成了。\n\n" NOR);
    temple = new("/obj/toy/tile");
    temple->move(ob);
    ob->delete_temp("build_temple");
    ob->delete_temp("build_now");
    ob->delete("marks/lamajob");
  }
  return 1;
}
int valid_leave(object me, string dir) {
  object ob;
  if (me->query_temp("build_now"))
    return notify_fail("你的修建工作还没有做完，怎么就离开了呢？\n");
  return ::valid_leave(me, dir);
}
