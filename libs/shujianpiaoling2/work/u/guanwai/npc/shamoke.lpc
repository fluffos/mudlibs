
inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("沙摩柯", ({ "sha hufa", "sha","hufa" }) );
	set("gender", "男性" );
	set("age", 69);
        set("agi",25);
        set("int",30);
        set("apprentice_available", 20);
        set("class", "lama");
        create_family("塔尔寺", 5, "护法");
	set("long",
		"沙摩柯已在塔尔寺护法多年，武功佛法都已登峰造极。\n"
		);
        set("force", 1500);
        set("max_force", 1500);
        set("force_factor", 20);
        set("combat_exp", 3000000);
        set("score", 70000);
        set_skill("unarmed", 180);
	set_skill("dodge", 180);
	set_skill("move", 180);
        set_skill("staff", 180);
        set_skill("force", 190);
        set_skill("parry", 180);
        set_skill("literate", 150);
	set_skill("iron-cloth", 180);

	set_skill("blood_strike", 180);
	set_skill("kongling_staff", 180);
	set_skill("xuanzang_force", 190);
	set_skill("chanting", 150);
        set_skill("jinzhong_zhao", 180);
	set_skill("yixing_huanwei", 180);

	map_skill("unarmed", "blood_strike");
        map_skill("force", "xuanzang_force");
        map_skill("dodge", "yixing_huanwei");
        map_skill("iron-cloth", "jinzhong_zhao");
        map_skill("staff", "kongling_staff");
        map_skill("parry", "kongling_staff");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "staff.wanxiang" :),
        }) );
	setup();
	carry_object(__DIR__"obj/redcloth")->wear();
        carry_object(__DIR__"obj/ironstaff")->wield();
}
void reset()
{
        delete_temp("learned");
        set("apprentice_available", 20);
}
void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {

      if(ob->query("class")!="lama") {
	    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜我的弟子吧。\n");
	    return;
	}

      if(ob->query_skill("xuanzang_force",1)< 150) {
	    command("say 本门武功均以大迷玄藏功作为基础，你修为尚浅，应先在内功方面多下功夫。\n");
	    return;
	}	
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 本护法今天已经收了二十个弟子，不想再收徒了。");
        }
}

void do_recruit(object ob)
{
                command("smile");
                command("say 很好，很好，很好。");
                command("recruit " + ob->query("id") );
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "lama");
                ob->set("id_type", 1);
        add("apprentice_availavble", -1);
}
/*
void init()
{
        add_action("give_quest", "quest");
}
*/
void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","塔尔寺弟子");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","塔尔寺罗汉");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","塔尔寺高僧");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","塔尔寺圣僧");
                return ;
        } else
                student->set("title","塔尔寺法师");
                return ;

}
