#include <ansi.h>

inherit NPC;
int about_quest();
string *names = ({
  "鸡毛毽子",
  "苗刀",
  "小面馆的地契",
  "当归",
  "韭菜合子",
  "糙面",
  "北芪",
  "淮山",
  "鲜鱼",
  "砍林刀",
  "镰刀",
  "开裆裤",
  "旧书",
});

void create() {
  set_name("伊丽娜", ({ "yi lina", "yi", "lina" }));
  set("gender", "女性");
  set("age", 23);
  set("long",
    "伊丽娜被青藏人民传为青海第一美女，现为塔尔寺圣女，但是她终日忧愁满面，常到鸟岛徘徊。\n");
  set("inquiry", ([
    "here": "这里是闻名西域的青海湖鸟岛。",
    "quest": (: about_quest :),
  ]));
  set("attitude", "peaceful");
  set("int", 22);
  set("spi", 23);
  set("per", 25);
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 10);
  set("combat_exp", 100000);
  set("score", 10000);
  set_skill("unarmed", 50);
  set_skill("dodge", 40);
  set_skill("move", 40);
  set_skill("staff", 40);
  set_skill("force", 40);
  set_skill("parry", 40);
  set_skill("literate", 30);
  set_skill("iron-cloth", 40);

  set_skill("tianzhu_finger", 50);
  set_skill("kongling_staff", 40);
  set_skill("xuanzang_force", 40);
  set_skill("yoga", 30);
  set_skill("chanting", 30);
  set_skill("jinzhong_zhao", 40);
  set_skill("yixing_huanwei", 40);

  map_skill("unarmed", "tianzhu_finger");
  map_skill("force", "xuanzang_force");
  map_skill("dodge", "yixing_huanwei");
  map_skill("iron-cloth", "jinzhong_zhao");

  create_family("塔尔寺", 7, "弟子");

  setup();

  //	carry_object(__DIR__"obj/1staff")->wield();
  carry_object(__DIR__ "obj/redclothh")->wear();
}

void init() {
  add_action("do_cancel", "cancel");
}

int do_cancel(string arg) {
  object me = this_player();
  if (!arg || arg != "quest")
    return notify_fail("你要取消什么？\n");
  if (!me->query("marks/lamajob"))
    return notify_fail("你现在没有任务。\n");
  say(CYN "伊丽娜叹道：不想做了吗？好吧，你自己反省一下。\n" NOR);
  if ((int)me->query("combat_exp") <= 100) {
    me->delete("marks/lamajob");
    me->unconcious();
    return 1;
  }
  me->add("combat_exp", -random(100));
  me->delete("marks/lamajob");
  me->unconcious();
  return 1;
}

int about_quest() {
  int task;
  object me = this_player();
  string questname = names[random(sizeof(names))];
  if (me->query("class") != "lama")
    return notify_fail("伊丽娜说道：你不是本教弟子，我怎么能给你任务呢？\n");
  if (random(9) < 5 && !me->query("marks/lamajob")) {
    command("say 我寺大强巴殿需要修建了，你去参与修建工作吧。");
    me->set_temp("workobj_name", "tile");
    me->set("marks/lamajob", "tile");
    return 1;
  }
  if (!me->query("marks/lamajob")) {
    say(CYN "伊丽娜说道：我想要［" + questname + "］，你去给我找来。\n" NOR);
    me->set("marks/lamajob", questname);
    return 1;
  } else {
    command("say 你还站在这里干什么？好好用功才是啊！");
    return 1;
  }
  return 1;
}

int accept_object(object who, object ob) {
  int exp, pot;
  object me;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");
  if (ob->name() == (string)me->query("marks/lamajob")
    || (ob->query("id") == (string)me->query_temp("workobj_name") && ob->query("objattrib"))) {
    say(CYN "伊丽娜微笑点头，说道：很好，继续努力。\n" NOR);
    me->set("combat_exp", (int)exp + random(50) + 30);
    me->set("potential", (int)pot + random(30) + 20);
    me->add("score", random(10));
    me->add("life_exp", random(20));
    if (me->query("marks/lamajob"))
      me->delete("marks/lamajob");
    if (me->query_temp("workobj_name"))
      me->delete_temp("workobj_name");
    return 1;
  } else {
    say(CYN "伊丽娜说道：多谢你的好意，但这东西对我没用。\n" NOR);
    return 0;
  }
  return 1;
}
int accept_fight(object me) {
  return 0;
}
