
inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("雅布陀罗", ({ "master yabu", "master","yabu" }) );
	set("gender", "男性" );
	set("age", 56);
	set("int", 23);
        set("apprentice_available", 20);
        create_family("塔尔寺", 6, "法师");
	set("long",
		"雅布陀罗是沙摩柯的得意弟子。\n"
		);

	set("inquiry", ([
		"quest": "嗯....现在没有任务。\n",
	]) );

        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 20);
        set("combat_exp", 1000000);
        set("score", 50000);
        set_skill("unarmed", 120);
	set_skill("dodge", 100);
	set_skill("move", 70);
        set_skill("staff", 100);
        set_skill("force", 120);
        set_skill("parry", 100);
        set_skill("literate", 70);
	set_skill("iron-cloth", 100);

	set_skill("blood_strike", 120);
	set_skill("kongling_staff", 100);
	set_skill("xuanzang_force", 120);
	set_skill("chanting", 100);
        set_skill("jinzhong_zhao", 100);
	set_skill("yixing_huanwei", 100);

	map_skill("unarmed", "blood_strike");
        map_skill("force", "xuanzang_force");
        map_skill("dodge", "yixing_huanwei");
        map_skill("iron-cloth", "jinzhong_zhao");
        map_skill("staff", "kongling_staff");
        map_skill("parry", "kongling_staff");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "staff.wanxiang" :),
        }) );
	setup();
	carry_object(__DIR__"obj/redcloth")->wear();
        carry_object(__DIR__"obj/3staff")->wield();
}
void reset()
{
        delete_temp("learned");
        set("apprentice_available", 20);
}
void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {

      if(ob->query("class")!="lama") {
	    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜我的弟子吧。\n");
	    return;
	}

      if(ob->query_skill("xuanzang_force",1)< 80) {
	    command("say 你本门内功修为尚浅，拜师之事还是以后再说吧。\n");
	    return;
	}	

      if(ob->query_skill("chanting",1)< 50) {
	    command("say 你诵经修为尚浅，拜师之事还是以后再说吧。\n");
	    return;
	}	
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 本法师今天已经收了二十个弟子，不想再收徒了。");
        }
}

void do_recruit(object ob)
{
                command("smile");
                command("say 很好，很好，很好。");
                command("recruit " + ob->query("id") );
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "lama");
                ob->set("id_type", 1);
        add("apprentice_availavble", -1);
}
/*
void init()
{
        add_action("give_quest", "quest");
}
*/
void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","塔尔寺弟子");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","塔尔寺罗汉");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","塔尔寺高僧");
                return ;
        } else  student->set("title","塔尔寺圣僧");
                return ;
}
