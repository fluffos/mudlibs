inherit NPC;
inherit F_MASTER;
string summon_more(object who);

void create() {
  set_name("阿泰什", ({ "atai shi", "shi", "atai" }));
  set("gender", "男性");
  set("age", 36);
  set("long",
    "阿泰什主要负责办理加入塔尔寺的事宜，平时有贵客到来时也由他出面招呼。\n");
  set("attitude", "peaceful");
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 20);
  set("combat_exp", 700000);
  set("score", 30000);
  set_skill("unarmed", 70);
  set_skill("dodge", 70);
  set_skill("move", 50);
  set_skill("staff", 70);
  set_skill("force", 70);
  set_skill("parry", 70);
  set_skill("literate", 70);
  set_skill("iron-cloth", 70);

  set_skill("blood_strike", 70);
  set_skill("kongling_staff", 70);
  set_skill("xuanzang_force", 70);
  set_skill("chanting", 60);
  set_skill("jinzhong_zhao", 70);
  set_skill("yixing_huanwei", 70);

  map_skill("unarmed", "blood_strike");
  map_skill("force", "xuanzang_force");
  map_skill("dodge", "yixing_huanwei");
  map_skill("iron-cloth", "jinzhong_zhao");
  map_skill("staff", "kongling_staff");
  map_skill("parry", "kongling_staff");

  create_family("塔尔寺", 7, "弟子");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: summon_more(this_object()) :),
  }));

  setup();

  carry_object(__DIR__ "obj/1staff")->wield();
  carry_object(__DIR__ "obj/redcloth")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "lama") {
    command("say 本寺不收留判师弟子，施主请回吧。\n");
    return;
  }
  if (ob->query_skill("xuanzang_force", 1) < 30) {
    command("say 你本门内功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要维护本寺尊严！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "lama");
  ob->set("id_type", 1);
}
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "塔尔寺弟子");
    return;
  } else
    student->set("title", "塔尔寺罗汉");
  return;
}
string summon_more(object who) {
  int i;
  object *enemy;
  object another;
  seteuid(getuid());
  another = new(__DIR__ "lama3");
  if ((int)who->query_temp("summon_more") > 2) return "　";
  another->move(environment(who));
  message_vision(another->name() + "走了过来。\n"
    , this_object());
  who->add_temp("summon_more", 1);
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      another->kill_ob(enemy[i]);
      enemy[i]->kill_ob(another);
      another->set_leader(enemy[i]);
    }
  }
  return "1";
}
int accept_fight(object me) {
  command("say 请不要在这里惹是生非。");
  return 0;
}
