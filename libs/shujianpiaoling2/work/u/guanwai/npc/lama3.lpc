
inherit NPC;

void create()
{
	set_name("护寺喇嘛", ({ "husi lama", "lama"}) );
	set("gender", "男性" );
	set("age", 25);
	set("str", 20);
	set("long", @LONG
一个塔尔寺的喇嘛。
LONG
);
	set("attitude", "peaceful");

        set("combat_exp", 60000);
        create_family("塔尔寺", random(4)+22, "弟子");
        set_skill("unarmed", 50+random(10));
        set_skill("blood_strike", random(50)+20);
        set_skill("force", 40);
	set_skill("iron-cloth", 40+random(10));
        set_skill("staff", 50+random(10));
        set_skill("kongling_staff", random(50)+20);
	map_skill("unarmed", "blood_strike");
        map_skill("staff", "kongling_staff");

	setup();

        carry_object(__DIR__"obj/redcloth2")->wear();
}
int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	destruct(this_object());
}
