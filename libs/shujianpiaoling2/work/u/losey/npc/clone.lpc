#include <ansi.h>

inherit NPC;
void huaming(object me);
void create()
{

        set_name("分身化影", ({ "shadow" }) );
        set("long", "这是一个影子。\n");
        set("attitude", "friendly");

        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);

        set("max_kee", 9000);
        set("max_gin", 9000);
        set("max_sen", 9000);

        set("force", 3000);
        set("max_force", 3000);
        set("force_factor", 10);

        set("atman", 2000);
        set("max_atman", 2000);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 10);


        set("combat_exp", 100000);
        set_skill("force", 200);
        huaming(this_object());

        setup();

        carry_object("/obj/cloth")->wear();
}




void huaming(object me)
{
        string name,id,title,nickname;
        name = this_player()->query("name");
        id = this_player()->query("id");
        title = this_player()->query("title");
        nickname = this_player()->query("nickname");
        this_object()->set("id", id);
        this_object()->set("name", name);
        this_object()->set("nickname", nickname);
        this_object()->set("title", title);
}



