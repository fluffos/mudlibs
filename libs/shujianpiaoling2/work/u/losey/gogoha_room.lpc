#include <ansi.h>
inherit ROOM;

void create()
{       
        set("short", "怡然居");
        set("long", @LONG
    轩堂中一尘不染，窗明几净，四壁堆满了书架，屋角一张琴几，琴旁一
方棋枰。还有几张未完成的画，散乱地堆在另一角的画桌上。门上挂著湘妃
帘，偷过竹帘，可以看见那一洼盛开的菊花，在门旁边有一个绿键，好象可
以按动。

LONG
        );

set("valid_startroom",1);
set("no_steal", "1");






set("item_desc", ([
   "duilian" : HIC "\n      人生在世不称意，\n\n\n      明朝散发弄扁舟。\n" NOR,
                "picture1" : HIR
"      ****           ****     ****           ****\n"
"    *********     ********* *********     *********\n"
"  ************* *********************** *************\n"
" *****************************************************\n"
" ************"HIW"心 心"HIR"*******************"HIW"心 心"HIR"************\n"
"  ***********"HIW"相 映"HIR"*******************"HIW"相 映"HIR"***********\n"
"   *************************************************\n"
"     *********************   *********************\n"
"       *****************       *****************\n"
"        *************           *************\n"
"          *********               *********\n"
"            *****                   *****\n"
"              *                       *\n" NOR,

            "picture2" : HIW
"　　　　　　　　　　　　　　　******\n"
"　　　　　　　　　　　　　　　　*　*\n"
"　　　　　　　　　　　　　　　*　　*\n"
"　　　　　　　　　　　　　　*\n"
"　　　　　　　　　　　　　*\n"
"　　　　　 　　　　　　*\n"
"　　　　　　　 *******    \n"      
"　　　　　　*******　*    \n"    
"　　　　 *******　*　*\n"
"　　　*******　*　*　*\n"
"　　　 　　　*　*　*　    \n"  
"　　　 　　　*　*\n"
"　　　　　　 *\n"NOR,
        
        ]));
setup();
}
void init()
{
        add_action("do_press", "press");
//        add_action("do_search","search");  
}

int do_press(string arg)
{
        
     if(arg=="绿键") {
                message_vision(HIC"$N走到电梯门前,在绿色键上按了一下，\n只听嘎的一声，电梯门缓缓的打开，你走了进去。\n"NOR, this_player());
               this_player()->move("/u/losey/dianti");
}
            else write("你想按什么？\n");
          return 1;
}
