//baicaodan.c

#include <ansi.h>


inherit ITEM;

void create()
{
        set_name("芒果" NOR,({"guo"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",
                HIM "这是一个紫红色的山竹,里面是一瓣瓣的白果肉.\n"NOR);
                set("unit","个");
                set("value", 400000);
        }
}
void init()
{
        add_action("ba_ke","ba");
        add_action("eat_guo","eat");
}
int ba_ke(string arg)
{
        int m_kee;
        int m_sen;
        int m_gin;
        int m_force;
        object me;
        int score, pot;
        me = this_player();
       if(arg != "壳")
                 return notify_fail("你要扒开什么？ \n");


        me->set_temp("marks/ba", 1);

        message_vision(HIC"\n$N小心翼翼的把山竹的壳扒开,露出了一瓣瓣的白果肉。\n", me);
       

        return 1;
     }
  


int eat_guo(string arg)
{
        int m_kee;
        int m_sen;
        int m_gin;
        int m_force;
        object me;
        int score, pot;
        me = this_player();
        score = (int) me->query("max_force");
        pot = (int) me->query("force");

        if ( arg == "guo"){
                m_kee = this_player()->query("max_kee");
        m_sen = this_player()->query("max_sen");
        m_gin = this_player()->query("max_gin");
        m_force = this_player()->query("max_force");
 
         if(!me->query_temp("marks/ba"))
     return notify_fail("你还没扒壳呢,怎么吃。\n");


       message_vision(HIC"$N轻轻的将白果肉放入口中,感到有点酸甜,滑润适口.\n"NOR,this_player());
        this_player()->set("eff_kee",m_kee);
        this_player()->set("kee",m_kee);
        this_player()->set("eff_gin",m_gin);
        this_player()->set("gin",m_gin);
        this_player()->set("eff_sen",m_sen);
        this_player()->set("sen",m_sen);
        this_player()->set("force",m_force);
        this_player()->set("food",500);
        this_player()->set("water",500);
        destruct(this_object());
        return 1;
     }
     return 0;
}

