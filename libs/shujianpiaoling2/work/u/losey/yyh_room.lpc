void init()
{
        add_action("do_pull", "pull");
//        add_action("do_search","search");  
}

int do_pull(string arg)
{
        object me=this_player(), room;

        if(arg!="床板")
                return notify_fail("你要拉什么？\n");
if(this_player()->query("id")!="gogoha")
return 0;

        if(!( room = find_object(__DIR__"bedroom")) )
                room = load_object(__DIR__"bedroom");


        message_vision(HIC"\n$N掀开床板,通过一条暗道,来到了另一个房间里。\n",me);
        message_vision(NOR "\n",me);
        me->move(room);
        return 1;
}
