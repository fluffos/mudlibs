//secretary.c
// by worm
inherit NPC;
void create() {
  set_name("浮云", ({ "fu yun", "yun" }));
  set("gender", "男性");
  set("long",
    "浮云是随意的得力助手，虽然年纪轻轻，却十分能干。\n");
  set("combat_exp", 100);
  set("age", 17);
  set("per", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 10);

  setup();
  carry_object("/obj/cloth")->wear();
}
