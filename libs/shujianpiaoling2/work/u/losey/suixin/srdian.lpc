inherit ROOM;

void create()
{
        set("short", "散人殿");
        set("long", @LONG
 散人殿乃是专为随心堂的散人们建造，这些武林志士不理名利头衔，一心
只求为随心堂贡献自己的一份力量，故唤名随心散人，逍遥洒脱。大殿中的摆
饰也以此特点放置，给人一种返补归臻的感觉，白墙上挂着的几幅山水丹青图
又给大殿增添几分儒雅之气。从北门出去是随心堂的花园，穿过花园就是随心
大殿了。
LONG
        );
        set("exits", ([
       "west" :__DIR__"ywchang",
       "north" :__DIR__"txyuan",

]));
   
        setup();
    
}


