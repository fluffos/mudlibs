inherit ROOM;

void create()
{
        set("short", "同心门");
        set("long", @LONG
来到大道的尽头，随心堂的同心门呈现在你眼前，高高的门楼气魄非凡
阳光照在金黄色的琉璃瓦上，光彩夺目。你进了此门就算和随心堂有缘，天
下同心。往北就是随心堂的英雄演武场。
LONG
        );
        set("exits", ([
       "north" :__DIR__"ywchang",
       "south" :__DIR__"road1",

]));
        setup();
}

int valid_leave(object me, string dir)
{
        if( dir=="north" && sizeof(me->query_all_condition()) != 0 )
                return notify_fail("你只觉前方一道罡气挡住了你。\n");
        return ::valid_leave(me, dir);
}

