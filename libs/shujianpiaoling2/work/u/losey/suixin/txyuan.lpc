inherit ROOM;

void create()
{
        set("short", "听心花园");
        set("long", @LONG
 随心堂中的一座花园，规模也算不小，碧绿的池塘里长着不少荷花，不时
能见到几尾红鲤鱼在荷花间戏闹，这里的假山怪石专从江南运来，玲珑剔透，
于荷花相互忖托，显得格外秀丽骄艳。西边不远处有一座飞鹤亭闪烁着阵阵华
光。
LONG
        );
        set("exits", ([
       "south" :__DIR__"srdian",
       "north" :__DIR__"fhting",
]));
   
        setup();
    
}


