inherit ROOM;

void create() {
  set("short", "青石大道");
  set("long", @LONG
 随心堂前的一条由青石铺成的大道，在路的两边长满了幽幽的翠竹和一些
不知名的小花，相映成趣。再往前不远就是大名顶顶的随心堂了，你不由的
加快了脚步，想尽快一睹随心堂的风貌。
LONG
  );
  set("exits", ([
    "north": __DIR__ "txmen",
    "southwest": "/u/lark/xiaoyao/roadb",

  ]));

  setup();

}
