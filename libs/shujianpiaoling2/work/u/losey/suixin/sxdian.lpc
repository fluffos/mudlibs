inherit ROOM;

void create()
{
        set("short", "随心大殿");
        set("long", @LONG
 这里是随心堂的最大最宏伟的建筑“随心大殿”，堂中所有大小事宜都在
此殿商议决策，大殿正前方放着一张紫檀木雕龙宽背椅，显然是堂主首坐。次
首的席上放着三张红木高背椅，是为三部首领而设，再次者则是各部部众的坐
椅。在堂主首坐后的墙上挂有一块匾额，上书有“天地人魔”四个苍劲有力的
大字。大殿的顶部开有一扇很大的天窗，阳光直射入殿，暖暖地照在每一个人
的身上，在光照下你不禁地觉得自己也要像这无私的阳光对人对事正大光明。
往北通向随心堂的四个分部，往东通向听心花园。
LONG
        );
        set("exits", ([
       "north" :__DIR__"houyuan",
       "east" :__DIR__"fhting",
       "south" :__DIR__"ywchang",


]));
   
        setup();
    
}


