#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "电梯");
  set("long", @LONG
这里是一个电梯，电梯的空间不大，四面镶着镜子，你不禁感到奇怪，
在这个年代怎么会后这么先进的东西。在电梯门的右边写着“瓦房店电
梯厂制造”的字样，在字的下边有1--10个按键，在按键的下方有一个
说明(shuoming)。
LONG
  );


  set("no_clean_up", 0);
  setup();
  set("item_desc", ([
    "shuoming": HIC
    "|————————|\n"
    "|  " HIW "10楼-随意居" HIC " |\n"
    "|————————|\n"
    "|  " HIW " 9楼-过儿居" HIC " |\n"
    "|————————|\n"
    "|  " HIW " 8楼-小小居" HIC " |\n"
    "|————————|\n"
    "|  " HIW " 7楼-杀手居" HIC " |\n"
    "|————————|\n"
    "|  " HIW " 6楼-苗苗居" HIC " |\n"
    "|————————|\n"
    "|  " HIW " 5楼-伤心居" HIC " |\n"
    "|————————|\n"
    "|  " HIW " 4楼-怡然居" HIC " |\n"
    "|————————|\n"
    "|  " HIW " 3楼-小李居" HIC " |\n"
    "|————————|\n"
    "|  " HIW " 2楼-云月居" HIC " |\n"
    "|————————|\n"
    "|  " HIW " 1楼-大厅" HIC "   | \n"
    "|————————|\n"
    "|  " HIW "-1楼-慈恩寺" HIC " |\n"
    "|————————|\n" NOR
  ]));
}
void init() {

  add_action("do_press", "press");
}


int do_press(string arg)

{
  string b_name, f_name, str, *astr, *bstr, name, id, stri;
  string kind;
  int i, j, data;
  switch (arg) {

    case "-1":
      message_vision(HIC "$N在-1键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在慈恩寺停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/d/city/ciensi");
      return 1;
    case "1":
      message_vision(HIC "$N在1键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在1楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/dating");
      return 1;
    case "2":
      message_vision(HIC "$N在2键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在2楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/wwd_room");
      return 1;
    case "3":
      message_vision(HIC "$N在3键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在3楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/alert_room");
      return 1;
    case "4":
      message_vision(HIC "$N在4键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在4楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/gogoha_room");
      return 1;
    case "5":
      message_vision(HIC "$N在5键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在5楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/shang_room");
      return 1;
    case "6":
      message_vision(HIC "$N在6键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在6楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/yuj_room");
      return 1;
    case "7":
      message_vision(HIC "$N在5键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在7楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/kill_room");
      return 1;
    case "8":
      message_vision(HIC "$N在8键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在8楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/yyh_room");
      return 1;
    case "9":
      message_vision(HIC "$N在9键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在9楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/xuan_room");
      return 1;
    case "10":
      message_vision(HIC "$N在10键上小心翼翼的按了一下，你感觉到电梯在缓缓移动。\n" NOR, this_player());
      message_vision(HIC "$N过了一会，电梯在10楼停了下来，电梯门自动打开。\n" NOR, this_player());
      message_vision(HIC "$N从电梯里走了出来。\n" NOR, this_player());
      this_player()->move("/u/losey/bedroom");
      return 1;
    default:
      return notify_fail("你想到几楼?\n");
  }
}
