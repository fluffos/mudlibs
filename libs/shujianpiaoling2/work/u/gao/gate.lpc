{
  set ("short", "太室山庄");
  set ("long", @LONG
这里便是太室山庄的大门口．北面一对黑木做的大门紧紧关着，门上
贴着一对门神．门左右摆着一对张牙舞爪的石狮，倒是登封县运来的正品
。看门的老人家正打着瞌睡。
LONG);
set("exits", ([ /* sizeof() == 4 */
"southdown" : __DIR__"shanroad3",
"north" : __DIR__"zhyuan",
]));

set("objects", ([
                __DIR__"npc/laoxiao": 1 ]) );
        set("outdoors", 1);
        set("no_clean_up", 0);
        setup();
