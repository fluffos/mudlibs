}
int valid_leave(object me, string dir)
{
        if (me->query("quest/biaoju"))
	return ::valid_leave(me, dir);
	if (dir == "north" ) {
        if (!objectp(present("biao che", environment(me))))
	return notify_fail("大门紧紧关闭着。\n");
        if (!objectp(present("bai weitang", environment(me))))
	return notify_fail("大门紧紧关闭着。\n");
        }   
        return ::valid_leave(me, dir);
}


