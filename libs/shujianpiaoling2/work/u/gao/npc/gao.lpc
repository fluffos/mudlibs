// gao.c

inherit NPC;
void create() {
  set_name("高乐先生", ({ "gao le", "gao" }));

  set("long", "太室山庄的主人，据说是个隐居江湖的高人。\n");
  set("gender", "男性");
  set("age", 52);
  set("title", "太室山庄庄主");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 85000);
  set_skill("unarmed", 25);
  set_skill("dodge", 15);
  set_skill("dagger", 35);
  set_skill("parry", 45);
  set("inquiry", ([
    "name": "老夫姓高，乃是家中的主人．\n",
    "here": "太室山庄是也．\n",
  ]));

  setup();
  add_money("silver", 5 + random(5));
  carry_object("/u/baiwt/xueshan/npc/obj/yandou")->wield();
  carry_object("/d/city/obj/cloth/choupao")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  object biaoche, wage;
  if (!ob || environment(ob) != environment()) return;
  if (present("biao che", environment(ob)) && ob->query("quest/biaoju") == "taishi") {
    biaoche = present("biao che", environment(ob));
    wage = new("/obj/money/10silver");
    command("say 镖车送到了吗？太好了，有劳你了！替老夫向邱总镖头问好。\n");
    destruct(biaoche);
    ob->set("quest/biaoju", 0);
    ob->add("potential", 50);
    ob->add("combat_exp", 60);
    ob->add("score", 5);
    ob->add("life_exp", 10);
    wage->move(ob);
  }
  return;
}
