// guanjia.c

inherit NPC;

void create()
{
       set_name("奚怀言", ({"xi huaiyan", "xi"}));
       set("long","老高家的管家，正拿着帐簿算帐．\n");
       set("gender", "男性");
       set("age", 36);
       set("attitude", "peaceful");
       set("shen_type", 1);
	set("title", "太室山庄管家");
	set("combat_exp", random(20)*500+5000);
       set_skill("unarmed", 35);
	set_skill("dodge", 35);
	setup();
       add_money("silver", 5+random(8));
        carry_object("/u/gao/obj/magua")->wear();

}
int accept_fight(object me)
{
        command("say 活动活动筋骨也好！\n");
        return 1;
}

