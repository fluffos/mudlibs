inherit ITEM;

void create()
{
	set_name("积雪", ({ "sand" , "积雪"}) );
	set_weight(500);
	set_max_encumbrance(8000000);
	set("no_get", 1);
	set("no_shown", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "堆");
		set("long", "一片厚厚的积雪，软软的一脚就能踩个深坑，让人有种如履薄冰的感觉。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }


