#include <ansi.h>
#include <room.h>

inherit ROOM;
int drop_him(object me);
void create() {
  set("short", "冰天雪地");
  set("long", @LONG
这是一片漫无边际的冰天雪地，到处可见冰川和冰斗。雪地高原气势
磅礴，终年积雪不化，厚厚的雪层足有数十尺深，白茫茫地渺无人烟。刺
骨的寒风夹带着雪花冰珠时不时向你袭来，让你难以呼吸和行走。脚下的
积雪软绵绵的无处着力，你不由得心中发毛，禁不住感叹天地间自然力量
的可怕。
LONG
  );
  set("exits", ([
    "west": __DIR__ "desert0",
    "north": __DIR__ "desert7",
    "south": __DIR__ "desert8",
    "east": __DIR__ "desert3",
    //  "down"  : __DIR__"quicksand4",
  ]));
  set("objects", ([
    __DIR__ "obj/sand": 1,
    //                __DIR__"npc/snake" : 2,
    "/obj/money/gold": 1,
    "/obj/money/silver": 1,
  ]));

  set("outdoors", "quicksand");

  setup();
}

void init() {
  object ob;
  object jade;
  int water, food, force, life_exp;
  string outexit;
  if (interactive(ob = this_player())) {
    water = ob->query("water");
    food = ob->query("food");
    force = ob->query("force");
    life_exp = ob->query("life_exp");
    water -= (random(4) + 1) * water / 10;
    food -= (random(2) + 1) * water / 10;
    force -= (random(4) + 1) * force / 10;
    life_exp += random(3);
    ob->set("water", water);
    ob->set("food", food);
    ob->set("force", force);
    ob->set("life_exp", life_exp);
    if (!objectp(jade = present("jade", ob))) {
      if (random(200) < 2) drop_him(ob);
    } else {
      if (random(1000) < 2) drop_him(ob);
    }
  }
  add_action("do_pull", "pull");
}
int drop_him(object me) {
  me->start_busy(1);
  call_out("dropnow", 1, me);
  return 1;

}
int dropnow(object me) {
  message_vision(HIW "$N突然感到脚底软绵绵的，无处着力！", me);
  message_vision("$N大叫一声“不好！”，可是来不及了…\n", me);
  message_vision("$N已陷身积雪之中！！\n" NOR, me);
  me->move(__DIR__ "quicksand4");
  return 1;
}

int do_pull(string arg) {
  object me, who;
  object room;
  me = this_player();
  if (!arg) return notify_fail("你要拉谁上来？\n");
  room = load_object(__DIR__ "quicksand4");
  if (!objectp(who = present(arg, room)) || !living(who))
    return notify_fail("积雪里没有这个人。\n");
  message_vision(HIW "$N用尽全身力量，将$n从积雪中救了出来。\n" NOR, me, who);
  who->move(__FILE__);
  return 1;

}
