inherit ROOM;

void create() {
  set("short", "温泉");
  set("long", @LONG
你脚下的积雪已经不见，一池小小的泉水呈现在你的眼前。泉里的水
虽然只有二指厚，却很清澈。在寒冷的风中，湖水仍是那么的温热，并且
向上冒着腾腾热气，带给在雪地里艰苦跋涉的旅人一份可贵的暖意。
LONG
  );
  set("exits", ([
    "west": __DIR__ "desert9",
    "east": __DIR__ "desert8",
    "north": __DIR__ "desert5",
    "south": __DIR__ "desert6",
  ]));
  set("resource/water", 1);
  set("outdoors", "quicksand");

  setup();
}

void init() {
  object ob;
  string outexit;
  if (interactive(ob = this_player())) {
    if (query("exits/east")) delete("exits/east");
    outexit = __DIR__ "desert" + (string)(random(3) + 6) + ".lpc";
    set("exits/east", outexit);

  }
  add_action("do_fillwater", "fillwater");
}

int do_fillwater(string arg) {
  object *list, ob;
  int i, can_fillwater;
  string dir;

  if (!arg || arg == "") return notify_fail("你要往什么东西里灌水？\n");
  ;

  if (arg == "skin" || arg == "wineskin") {
    list = all_inventory(this_player());
    i = sizeof(list);
    can_fillwater = 0;
    while (i--) {
      if (((string)list[i]->query("liquid/type") == "alcohol")
        || ((string)list[i]->query("liquid/type") == "water")) {
        ob = list[i];
        can_fillwater = 1;
        ob->set("liquid", ([
          "type": "water",
          "name": "温水",
          "remaining": 15,
          "drunk_apply": 6,
        ]));
        write("你从泉眼里装满了温水! \n");
        return 1;
      }
    }
    if (can_fillwater == 0) {
      write("你没有装水的东西啊啊....\n");
      return 1;
    }
  } else {
    write("你要往什么东西里灌水？\n");
  }
  return 1;
}
