int accept_fight(object me)
{
	return notify_fail("你看花眼了吗？那是一辆车！\n");
}

int do_gogo(string arg)
{
	string dest, mout, min, dir, blk;
	object env, me,obj, player;
	mapping exit;
	me=this_object();
	player=this_player();

	if ( !player->query_temp("in_moving_room") )
			return notify_fail("什么？\n");
	if ( !arg )
	return notify_fail("你想驾车往哪个方向走？\n");

//command("go" + arg);
	env = environment(me);

	if( !mapp(exit = env->query("exits")) || undefinedp(exit[arg]) ) {
		if( query_verb()=="go" && !env->query("auto_maps") )
			return notify_fail("这个方向没有出路。\n");
		else if( env->query("auto_maps") )  return 1;
		else  return 0;
	}
	dest = exit[arg];

	if( !(obj = find_object(dest)) )
		call_other(dest, "???");
	if( !(obj = find_object(dest)) )
		return notify_fail("无法移动。\n");

	if( !env->valid_leave(me, arg) ) 
		return notify_fail("马车现在不听指挥。\n");

	if( !undefinedp(default_dirs[arg]) )
		dir = default_dirs[arg];
	else
		dir = arg;

		if( mout = me->query("leave_msg"))
		mout = "往" + dir + mout +" 。\n";
		else mout = "往" + dir + "离开。\n";
		if( min = me->query("arrive_msg"))
		min = min + " 。\n";
		else
		min = "“得得得”地行驶了过来。\n";

	if (!userp(me) && obj->query("NONPC"))
			return notify_fail("马车不可去那里。\n");

	if( !obj->query("outdoors") )
		return notify_fail("马车没有办法去那个地方。\n");

	message( "vision", me->name() + mout, environment(me), ({me}) );
	if( me->move(obj) ) {
		me->remove_all_enemy();
		message( "vision", me->name() + min, environment(me), ({me}) );
		me->set_temp("pending", 0);
		all_inventory(env)->follow_me(me, arg);
		write("你来到了"+obj->query("short")+"。\n");

		return 1;
	}

return 0;

}

int do_lookout()
{
	int i;
	string str,*dirs;
	object env, me,obj,player;
	mapping exits;

	me=this_object();
	player=this_player();

	env = environment(me);
	str = env->query("long");

	if ( !player->query_temp("in_moving_room") )
			return notify_fail("什么？\n");

	if( mapp(exits = env->query("exits")) ) {
		dirs = keys(exits);
		for(i=0; i<sizeof(dirs); i++)
			if( (int)env->query_door(dirs[i], "status") )
				dirs[i] = 0;
		dirs -= ({ 0 });
		if( sizeof(dirs)==0 )
			str += "    这里没有任何明显的出路。\n";
		else if( sizeof(dirs)==1 )
			str += "    这里唯一的出口是 " + BOLD + dirs[0] + NOR + "。\n";
		else
			str += sprintf("    这里明显的出口是 " + BOLD + "%s" + NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
				implode(dirs[0..sizeof(dirs)-2], "、"), dirs[sizeof(dirs)-1]);
	}
	write(str);

return 1;
}

int do_goup(object me)
{
	object che,inv;
	me = this_player();
	che = this_object();

	if ( inv = first_inventory(che) )
{
	if( wizardp(me) )
		write("车上已经有"+inv->query("name")+"（"+inv->query("id")+"）"+"了。\n");
			return notify_fail("车上已经有人了。\n");
}
	me->set_temp("in_moving_room",1);
	me->move(che);
	message( "vision", me->name() + "上了车。\n", environment(che), ({me}) );
return 1;
}

int do_godown(object me)
{
	object che,env;
	me = this_player();
	che = this_object();

	if ( !me->query_temp("in_moving_room") )
			return notify_fail("什么？\n");

	if( env = environment(che) )
	{
	me->move(env);
	me->delete_temp("in_moving_room",1);
	message( "vision", me->name() + "从车上走了下来。\n", environment(che), ({me}) );
	}
return 1;
}

int close_cmds(object me, string arg)
{
	write("这里不能练功和乱丢东西。\n");
	return 1;
}

