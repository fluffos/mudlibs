#include <ansi.h>

inherit NPC;
int about_baohu();

void create() {
  set_name("冲虚道长", ({ "master chongxu", "master", "chongxu" }));
  set("gender", "男性");
  set("age", 56);
  set("long",
    "冲虚道长是武当派继开山祖师张三丰后最杰出的掌门，他的武功才智在武林中\n"
    "都算是超一流人物。近年武当重震声威，就是全赖冲虚的英明领导。\n");
  set("inquiry", ([
    "秘籍": "好的，给你秘籍.....",
    "随行": (: about_baohu :),
  ]));
  set("attitude", "peaceful");
  set("class", "wudang");
  set("str", 26);
  set("int", 22);
  set("spi", 25);
  set("per", 23);
  set("cps", 23);
  set("water", 400);
  set("food", 400);
  set("force", 9000);
  set("max_force", 9000);
  set("force_factor", 90);
  set("combat_exp", 3000000);
  set("score", 1000);

  set_skill("unarmed", 280);
  set_skill("sword", 250);
  set_skill("force", 290);
  set_skill("parry", 290);
  set_skill("dodge", 240);
  set_skill("literate", 230);

  set_skill("taiji-sword", 270);
  set_skill("taiji-ken", 260);
  set_skill("taiji-force", 280);
  set_skill("tiyunzong", 260);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    "嘿嘿，见识一下武当剑法的厉害吧！\n",
    (: perform_action, "sword.chan" :)
    (: perform_action, "sword.fengbi" :)
  }));
  create_family("武当派", 6, "掌门");

  setup();

  carry_object(__DIR__ "obj/youlong_sword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "wudang") {
    command("say 这位" + RANK_D->query_respect(ob) + "请先找知客道长询问拜师之事。\n");
    return;
  }

  if (ob->query_skill("taiji-force", 1) < 80) {
    command("say 本门武功均以太极神功作为基础，你修为尚浅，应先在内功方面多下功夫。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "wudang");
}

int about_baohu() {
  object me, soldier;
  object *t;
  me = this_player();
  if (ob->query("class") != "wudang") {
    command("say 对不起，你不是武当弟子！\n");
    return 1;
  }

  if (pointerp(t = me->query_team())) {
    command("say 已经有师兄弟保护你了，好自为之！\n");
    return 1;
  }
  command("say 好吧，我让你的师兄弟与你同行。\n");
  message_vision(CYN "\n从门外走进来一名武当弟子，躬身说道：师父请吩咐！\n" NOR, me);
  message_vision(HIM "\n张三丰说道：武当弟子保护$N一起下山吧！\n" NOR, me);
  message_vision(CYN "\n武当弟子躬身说道：谨遵师命！\n" NOR, me);
  soldier = new(__DIR__ "wddizi.lpc");
  soldier->move(environment(me));
  me->add_team_member(soldier);
  soldier->add_team_member(me);
  soldier->set_leader(me);
  return 1;
}
