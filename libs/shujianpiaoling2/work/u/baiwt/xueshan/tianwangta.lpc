#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", HIY"镇妖塔"NOR);
        set("long",@LONG
这是一座巨大的石塔，塔内阴沉沉的，听不到半点声息。四周墙上
到处刻画着天钟、法轮、金翅鸟和降魔杵，显得庄严而神圣。据说这是
天庭元帅托塔李天王的镇妖法宝，有着六道轮回的法力。你耳边似乎听
到四大金刚低沉有力的呼号，不禁心中打颤，不由自主跪了下来。
LONG      
  );
        set("exits", ([
		"out" : __DIR__"tudimiao",
        ]));
	set("no_fight",1);
	set("no_magic",1);
        setup();
//        replace_program(ROOM);
}
void init()
{
	add_action("do_drink", "drink");
	add_action("do_study", "study");
}
int do_drink()
{
	write("这不可喝东西！\n");
	return 1;
}
int do_study()
{
        write("这不可学东西！\n");
        return 1;
}

