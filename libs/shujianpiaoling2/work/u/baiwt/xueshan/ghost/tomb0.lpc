inherit ROOM;

void create()
{
        set("short", "坟地");
        set("long", @LONG
这里是一片坟地，到处是荒坟堆，不时地可见几个白骨骷髅(bone)在
绿色的磷火中若隐若现。你闻到的全是血腥气息和尸体的腐臭，令你不禁
把一天的饭全都呕吐了出来。
LONG
        );
        set("exits", ([ 
	       "north" : __DIR__"duanqiao",
]));
        set("objects", ([
		__DIR__"npc/obj/bonesword" : 1,
		__DIR__"npc/obj/dieflag" : 1,
       ]) );
        set("outdoors", "xueshan");
//	set("no_death_penalty",1);
        setup();
}
int valid_leave(object me, string dir)
{
 	if((string)me->query("class")!="deadman")
	{ 
	me->set("food",0);
	}
	me->set("env/brief", 0);
	me->set_alias("l");
	me->set_alias("look");
	return 1;
}
void init()
{
	add_action("do_make", "make");
}
int do_make(string arg)
{      
	int chance;
	object me=this_player(), bone;
	if(!arg || arg!="bone")
          return notify_fail("你要用什么做东西？\n");
 	if((string)me->query("class")!="deadman")
          return notify_fail("你不是幽冥教弟子。\n");
	if((int)me->query("gin")< 30)
	return notify_fail("你感到精疲力尽，看来需要休息了。\n");
	if((int)me->query("potential")< 1)
	return notify_fail("你的潜能不够。\n");
	message_vision("\n$N拣起荒坟堆里的一根白骨，默念起招魂地煞诀，一边来回捏搓着那根白森森的尸骨。\n",me);

	chance=random(8);
	if(chance==3){
          bone = new(__DIR__"npc/obj/bonesword");
	message_vision("\n$N捏着念着，忽然手中白光一闪，那根尸骨竟然被捏成了一把$n。\n\n",me,bone);
          bone->move(me);
	me->add("gin",-20);
	me->add("potential",-1);
	me->start_busy(2);
        return 1;
			}
	if(chance==6){
          bone = new(__DIR__"npc/obj/dieflag");
	message_vision("\n$N捏着念着，忽然手中白光一闪，那根尸骨竟然被捏成了一面$n。\n\n",me,bone);
          bone->move(me);
	me->add("gin",-20);
	me->add("potential",-1);
	me->start_busy(2);
        return 1;
			}
	else{
	message_vision("\n$N把那根尸骨摆弄了半天，但什么也没做成。\n\n",me);
	me->add("gin",-20);
	me->add("potential",-1);
	me->start_busy(2);
        return 1;
		}	
        return 1;
}

