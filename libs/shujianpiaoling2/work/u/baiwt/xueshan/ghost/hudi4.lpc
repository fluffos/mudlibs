inherit ROOM;
void create()
{
        set("short", "湖底");
        set("long", @LONG
这里是天湖的湖底。这里的泥沙(mud)特别松软，似乎可以挖开(dig).
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"hudi1",
]));
        set("objects", ([
		__DIR__"npc/wawayu" : 1,
                        ]) );
        setup();
}
void init()
{
	add_action("do_dig", "dig");
	add_action("do_sleep", "sleep");
}
int do_dig(string arg)
{      
	object me=this_player(), fish;
	if(!arg || arg!="mud")
          return notify_fail("你要挖什么？\n");
	if((int)me->query("gin")< 50)
	return notify_fail("你感到精神疲倦，看来需要休息了。\n");
	if((int)me->query("sen")< 50)
	return notify_fail("你感到精神疲倦，看来需要休息了。\n");
          fish = new(__DIR__"npc/wawayu");
	message_vision("\n$N用手在泥沙里挖了半天，终于捉到了一条$n。\n\n",me,fish);
          fish->move(me);
	me->add("gin",-30);
	me->add("sen",-30);
	me->start_busy(2);
        return 1;
}
int do_sleep(string arg)
{      
	if(!arg || arg)
          return notify_fail("这里不能睡觉。\n");
        return 1;
}