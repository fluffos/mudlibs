#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_he();
void create()
{
	set_name("阎青", ({ "master yan", "yan", "master" }));
	set("title", "幽冥教护法");
	set("gender", "男性");
	set("age", 46);
	set("nickname", HIG "追魂阎罗" NOR);
	set("attitude", "peaceful");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);

        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);

        set("combat_exp", 10000000);
        set("score", 20000);

        set_skill("literate", 100);
        set_skill("force", 200);
        set_skill("unarmed", 200);
        set_skill("sword", 200);
        set_skill("parry", 200);
        set_skill("dodge", 200);
        set_skill("ghostsword", 180);
        set_skill("ghoststeps", 180);
        set_skill("ghostclaw", 80);
        set_skill("hotforce", 180);
        map_skill("sword", "ghostsword");
        map_skill("force", "hotforce");
        map_skill("parry", "ghostsword");
        map_skill("dodge", "ghoststeps");
        map_skill("unarmed", "ghostclaw");

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "dodge.ghostdream" :),
        }) );
	create_family("幽冥教",2, "弟子");
	set("class", "deadman");
        set("inquiry", ([
                "解毒" : (: about_he :),
        ]));

	setup();
	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/longsword")->wield();
}

void attempt_apprentice(object ob)
{
   if ((int)ob->query_skill("ghostflag", 1) < 50) 
           {
		command("say " + RANK_D->query_respect(ob) + "是否还应该多练练地煞旗？");
		return;
	   }  
   if ((string)ob->query("class")=="deadman")
   {
		message_vision("阎青说道：“好吧, 我就收下你了。”\n",ob);
       command("recruit " + ob->query("id"));
		if((string)ob->query("class") != "deadman")
			ob->set("class", "deadman");
       return;}
   else
      {
		message_vision("阎青冷冷说道：“阁下擅闯幽冥谷，胆子可真不小!”\n",ob);
       return;}
}
int about_he()
{
        object me;
        object huadu;
	me = this_player();
 	if((string)me->query("class")!="deadman")
		{ say("阎青冷冷说道：你不是本教弟子！\n");
		return 0;}
	if( !present("huadu dan", me) )
	{
          say("阎青冷峻的目光扫了你一眼，说道：别再问我要了！\n");
          huadu = new("/u/baiwt/xueshan/xsobj/huadu");
          huadu->move(me);
	}
          return 1;
}
