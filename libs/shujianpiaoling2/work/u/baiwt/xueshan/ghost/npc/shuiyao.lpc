//法术：［浪涌咒］ 属性：水  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("水妖", ({ "shuiyao", "taoist guard" }) );
	set("gender", "男性");
	set("age", 40);
	set("attitude", "aggressive");
	set("bellicosity", 13500 );

	set("magic_power", 135);

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("max_mana", 1350);
	set("mana", 1350);

        set("limbs", ({ "头部", "身体", "爪子" }) );
        set("verbs", ({ "claw" }) );
 
        set("combat_exp", 135000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();
	carry_object(__DIR__"obj/iceblock");
}
int magic_more(object who)
{
	int i, mwp;
	object *enemy, mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	message_vision(HIC"\n$N拨开水浪，对着$n念起了咒语。"NOR,who,enemy[i]);
	message_vision(HIC"\n顷刻间只见四周波涛汹涌，一个个巨大的浪花朝$n打了过来！\n"NOR,who,enemy[i]);
	message_vision(HIG"［浪涌咒］！\n\n"NOR,who,enemy[i]);
	if( random(enemy[i]->query("magic_defense"))< random(500) )
			enemy[i]->receive_wound("kee", mwp);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

