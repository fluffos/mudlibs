#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
	set_name("石三重", ({ "master shi", "shi", "master" }));
	set("title", "幽冥教护法");
	set("gender", "男性");
	set("age", 46);
	set("nickname", HIG "夺命判官" NOR);
	set("attitude", "peaceful");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);

        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);

        set("combat_exp", 8000000);
        set("score", 20000);

        set_skill("literate", 180);
        set_skill("force", 180);
        set_skill("unarmed", 180);
        set_skill("fork", 180);
        set_skill("parry", 180);
        set_skill("dodge", 180);
        set_skill("ghostflag", 180);
        set_skill("ghoststeps", 180);
        set_skill("ghostclaw", 80);
        set_skill("hotforce", 180);
        map_skill("fork", "ghostflag");
        map_skill("force", "hotforce");
        map_skill("parry", "ghostflag");
        map_skill("dodge", "ghoststeps");
        map_skill("unarmed", "ghostclaw");

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "fork.corpsehurt" :),
        }) );
	create_family("幽冥教",2, "弟子");
	set("class", "deadman");

	setup();
	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/dieflag")->wield();
}

void attempt_apprentice(object ob)
{
   if ((int)ob->query_skill("ghoststeps", 1) < 40) 
           {
		command("say " + RANK_D->query_respect(ob) + "是否还应该多练练鬼幽身法？");
		return;
	   }  
   if ((string)ob->query("class")=="deadman")
   {
		message_vision("石三重说道：“好吧, 我就收下你了。”\n",ob);
       command("recruit " + ob->query("id"));
		if((string)ob->query("class") != "deadman")
			ob->set("class", "deadman");
       return;}
   else
      {
		message_vision("石三重冷冷说道：“阁下擅闯幽冥谷，胆子可真不小！”\n",ob);
       return;}
}
int accept_object(object who, object ob)
{
        object me;
	int score, pot;
	if( ob->name() == "腐烂的尸体") {
	me = this_player();
	score = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
		me->set("combat_exp", (int) score + 20);
		me->set("potential", (int) pot + 20);
        say( "石三重发出了一声沉重的叹息，说道：唉！人浮于世，薄命如斯。不管是生是死，都要找个好归宿. . .\n");
	return 1;
        }
		else {
			say("石三重冷冷说道：你想去死？\n");
			return 0;
                }

        return 1;
}

