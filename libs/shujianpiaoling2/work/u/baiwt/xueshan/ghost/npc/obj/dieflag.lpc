#include <weapon.h>

inherit FORK;

void create() {
  set_name("骷髅旗", ({ "death flag", "flag", "fork" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "面");
    set("long", "这是一面画着骷髅头的小旗子，旗杆用尸骨做成。\n");
    set("value", 2);
    set("material", "steel");
  }
  init_fork(20);
  setup();
}
