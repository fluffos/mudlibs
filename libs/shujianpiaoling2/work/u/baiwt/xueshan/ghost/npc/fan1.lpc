#include <ansi.h>
inherit NPC;
//inherit F_VENDOR;
void create()
{
        set_name("韦十三", ({ "seller"}) );
        set("gender", "男性" );
        set("age", 36);
        set("long",
          "这是一个卖灯笼的小贩.\n"
        );
        set("attitude", "friendly");
        set("combat_exp",100);
        set_skill("unarmed",50);
        setup();
        carry_object(__DIR__"obj/cloth")->wear();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        command("say 我的灯笼是自己用纸做的，虽然破了点，但是挺实用，只要十文钱。\n");
        
}
int accept_object(object who, object ob)
{
        int val;
	object paper;
        val = ob->value();
        if( !val )
                return 0;
        else if( val = 10) {
	paper = new(__DIR__"obj/paper_light");
	if( paper) {
	paper->set("targetprice", val);
	paper->move(who);
		    }
        }
        say( "韦十三说道：多谢客倌照顾小人生意。\n");
        return 1;
}
