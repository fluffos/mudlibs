inherit NPC;
void create() {
  set_name("冥府狱卒", ({ "ghost guard" }));
  set("gender", "男性");
  set("str", 26);
  set("combat_exp", 1500000);
  set("attitude", "friendly");
  set("max_force", 600);
  set("force", 600);
  set("force_factor", 10);
  set("no_shown", 1);
  set_skill("force", 100);
  set_skill("fork", 300);
  set_skill("dodge", 100);
  set_skill("hell-fork", 180);
  set_skill("ghostclaw", 100);
  map_skill("unarmed", "ghostclaw");
  map_skill("fork", "hell-fork");
  setup();
  carry_object(__DIR__ "obj/godfork")->wield();
}
int is_ghost() { return 1; }

void init() {
  add_action("do_kill", "kill");
}
int getme(object me) {
  this_object()->kill_ob(me);
  return 1;
}

int do_kill(string arg) {
  object me;
  me = this_player();
  if (arg == "du wuchang" || arg == "du" || arg == "wuchang") {
    message_vision("毒无常阴恻恻地冷笑道：他妈的活得不耐烦了，送$N一张追魂帖吧！！\n", me);
    call_out("getme", 1, me);
    return 1;
  }
  return 0;
}
