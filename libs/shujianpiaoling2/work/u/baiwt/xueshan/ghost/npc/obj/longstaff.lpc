#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create() {
  set_name(MAG "盘龙双拐" NOR, ({ "dragon staff", "staff" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", "一对又粗又短的寒铁拐杖，上面刻画著数条苍龙。\n");
    set("value", 120000);
    set("material", "iron");
    set("wield_msg", "$N拿出一对乌黑的$n握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_staff(63);
  setup();
}
