inherit ROOM;
void create()
{
        set("short", "湖底");
        set("long", @LONG
这里是天湖的湖底。
LONG
        );
        set("exits", ([ /* sizeof() == 5 */
  "up" : __DIR__"bingchi",
  "east" : __DIR__"hudi2",
  "south" : __DIR__"hudi3",
  "west" : __DIR__"hudi4",
  "north" : __DIR__"hudi5",
]));
        setup();
}
void init()
{
	add_action("do_sleep", "sleep");
}
int do_sleep(string arg)
{      
	if(!arg || arg)
          return notify_fail("这里不能睡觉。\n");
        return 1;
}
