inherit ROOM;
void create() {
  set("short", "湖底");
  set("long", @LONG
这里是天湖的湖底。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "hudi1",
  ]));
  set("objects", ([
    __DIR__ "npc/watersnake": 1,
  ]));
  setup();
}
void init() {
  add_action("do_sleep", "sleep");
}
int do_sleep(string arg) {
  if (!arg || arg)
    return notify_fail("这里不能睡觉。\n");
  return 1;
}
