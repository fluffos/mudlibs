inherit ROOM;

void create()
{
        set("short", "幽冥谷");
        set("long", @LONG
你又来到了一处山谷，两边是陡峭的山崖，崖壁上刻着[幽冥谷]三个
大字，谷中轻烟缭绕，仿佛白色的鬼魂在那里飘来荡去。一阵阴风吹来，
你机伶伶打了个冷战，不禁心中想道：莫非这里是人间通向地府的门户？
LONG
        );
        set("exits", ([ 
	       "west" : __DIR__"duanqiao",
	       "southeast" : __DIR__"yanwang",
		"northeast" : __DIR__"mingwang",
]));
        set("valid_startroom", 1);
        set("outdoors", "xueshan");
        setup();
     call_other( "/obj/board/yg-board", "???" );
}

