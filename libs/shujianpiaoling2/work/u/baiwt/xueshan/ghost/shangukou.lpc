inherit ROOM;
int do_climb(string arg);
void create() {
  set("short", "山谷入口");
  set("long", @LONG
这是一个神秘山谷的入口，由于阳光照不到这个地方，因此山谷四周
终日阴沉沉的，而且鸟兽绝迹，草木不生，更让人感到阴森恐怖。但奇怪
的是仍然有许多点着各式各样灯笼的江湖人物毫不犹豫地进入谷中，仿佛
在寻求成仙之道。遗憾的是迄今为止从来没有一个进谷的人能够出来。
LONG
  );
  set("exits", ([
    "east": __DIR__ "sancha1",
    "northup": __DIR__ "beikou",
    "southup": __DIR__ "nankou",
  ]));
  set("outdoors", "xueshan");
  setup();
}
int valid_leave(object me, string dir) {
  object *inv;
  object ob, room;
  int i;
  int withfeather = 0;
  if (!(room = find_object("/u/baiwt/xueshan/ghost/sancha2")))
    room = load_object("/u/baiwt/xueshan/ghost/sancha2");
  if (dir == "east") {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      if ((string)(inv[i]->query("id")) != "paper_light") {
        me->move(room);
        return 0;
      } else {}
      if ((string)(inv[i]->query("id")) == "paper_light")
        withfeather = 1;
    }
    if (!withfeather) {
      me->move(room);
      return 0;
    } else {}
  }
  return 1;
}
void init() {
  add_action("do_climb", "climb");
}
int do_climb(string arg) {
  object me = this_player(), room2;
  if (!arg || arg != "east")
    return notify_fail("什么？\n");
  if ((string)me->query("class") != "deadman")
    return notify_fail("什么？\n");
  if (!(room2 = find_object("/u/baiwt/xueshan/ghost/sancha1")))
    room2 = load_object("/u/baiwt/xueshan/ghost/sancha1");
  message_vision("\n$N爬上了山壁，又沿着山壁往东爬去。\n\n", me);
  me->move(room2);
  return 1;
}
