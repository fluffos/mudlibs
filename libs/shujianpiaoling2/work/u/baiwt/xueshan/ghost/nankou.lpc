inherit ROOM;

void create()
{
        set("short", "南谷口");
        set("long", @LONG
这里是神秘山谷的南谷口。据说幽冥谷主人最喜爱灯笼，而进入谷中
的唯一方法就是带一盏灯笼，因此常又许多卖灯笼的人汇集到了这里，以
出售各式各样奇怪的灯笼而发了笔财。
LONG
        );
        set("exits", ([ 
		"westdown" : __DIR__"xueyu4",
		"northeast" : __DIR__"bingchi",
	       "northdown" : __DIR__"shangukou",
]));
        set("objects", ([
		__DIR__"npc/fan4" : 1,
       ]) );
        set("outdoors", "xueshan");

        setup();
}


