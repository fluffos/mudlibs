
inherit ROOM;

void create()
{
	set("short", "观澜亭");
	set("long", @LONG
这是二王庙内的观澜亭，在这里可以眺望到水流湍急的岷江。亭
下丹墙石壁上，镌刻着李冰及其后来历代治水经验格言碑文石刻：
“深淘滩，低作堰，遇湾截角，逢正抽心”等，通称治水三字经、
六字诀。
LONG
	);
	set("exits", ([
		"north" : __DIR__"boat_east",
	]));
	set("objects", ([
              "/npc/nknpc" : 1,
		__DIR__"npc/guanlan" : 1,
	]));
	set("outdoors", "xueshan");
	setup();
replace_program(ROOM);

}
