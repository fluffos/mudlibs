inherit ROOM;
void create()
{
  set("short","大街");
  set("long",@LONG
南阳城自古是关，洛通荆，襄的必经之路。城虽不大，却很整洁，且民风淳
朴。街东有一家大院，红漆大门甚是威武。左首旗斗上悬一面杏黄大旗，上书“
武林双鹤”，随风飘动。大门两边的灯笼上写着“杨府”二字。街西边是一家商
号。
LONG);
  set("exits",([
    "north"   : __DIR__"beimen",
    "south"  : __DIR__"dajie2",
    "east"  : __DIR__"qianyuan",
    "west"  : __DIR__"shop",
  ]));
   set("objects",([
         "/u/baiwt/xueshan/xsnpc/cityguanbing":2,
   ]));

   set("oldarea","nanyang");
  setup();
}
int valid_leave(object me,string dir)
{
       if(!objectp(present("jia ding",environment(me))))
               return 1;
       if( dir != "east")
               return 1;
       if( me->query("family/family_name") == "伏牛派"){
               message_vision(
"家丁向$N道：你回来啦? 快进去歇歇吧。\n",me);
               return 1;
       }
        return 1;
}
