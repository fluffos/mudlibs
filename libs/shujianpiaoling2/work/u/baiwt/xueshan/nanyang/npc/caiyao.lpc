#include <ansi.h>
inherit NPC;
int about_here1();
void create() {
  set_name("采药人", ({ "caiyao ren", "ren" }));
  set("gender", "男性");
  set("age", 35);
  set("max_kee", 800);
  set("max_sen", 700);
  set_skill("unarmed", 50);
  set_skill("stealing", 900);
  set_skill("dodge", 50);
  set("attitude", "friendly");
  set("combat_exp", 1500);
  set("inquiry", ([
    "青松冈": (: about_here1 :),
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/dangshen");
  carry_object(__DIR__ "obj/gancao");
  carry_object(__DIR__ "obj/baier");
}
int accept_object(object who, object ob) {
  object room;
  if (ob->name() == "雪山灵芝") {
    if ((int)ob->query("objattrib") != 1) return 0;
    if (!(room = find_object("/u/baiwt/xueshan/nanyang/laoya")))
      room = load_object("/u/baiwt/xueshan/nanyang/laoya");
    say("采药人说道：多谢这位" + RANK_D->query_respect(who)
      + "助我一臂之力。我这就带你过去。\n");
    message_vision(HIC "\n采药人让$N抓住一根山藤，自己抓住另一根，然后向上攀去。\n" NOR, who);
    who->move(room);
    message_vision(HIC "\n采药人带$N攀了上来，向$N挥了挥手，又攀下去了。\n" NOR, who);
    return 1;
  } else {
    say("采药人摇了摇头，说道：这东西有什么用呀？\n");
    return 0;
  }
  return 1;
}
int about_here1() {
  say("采药人说道：我正到处寻求灵芝仙草，为我那重病的老母治疗，如果你能帮我的话，我就送你去青松冈.\n");
  return 1;
}
