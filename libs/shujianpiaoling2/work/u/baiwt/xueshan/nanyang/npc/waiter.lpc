#include <ansi.h>

inherit NPC;
void create() {
  set_name("金不少", ({ "waiter" }));
  set("gender", "男性");
  set("age", 46);
  set("long",
    "金不少是这间店铺的店主，他身上穿着一件半旧的蓝布短衫，手上沾满了油迹。\n"
  );
  set("combat_exp", 6000);
  set("attitude", "friendly");
  setup();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(2)) {
    case 0:
      say("金不少笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来歇歇腿吧。\n");
      break;
    case 1:
      say("金不少用油乎乎的毛巾擦了擦桌子，说道：这位" + RANK_D->query_respect(ob)
        + "，来点什么？\n");
      break;
  }
}
int refuse_killing(object me) {
  command("look " + me->query("id"));
  //     command("grin");
  message_vision("金不少恶狠狠地对$N道：“这真是天堂有路你不走，地狱无门你却偏要闯进来，哈哈!!”\n", me);
  set_skill("parry", 100);
  set_skill("unarmed", 100);
  set("bellicosity", 1000);
  return 0;
}
