
inherit ROOM;

void create()
{
	set("short", "小道");
        set("long",@LONG
一条小道蜿延曲折地通向远方, 两旁是郁郁葱葱的树林，微风吹过，
树叶发出奚索的声音。
LONG
        );
	set("outdoors", "xueshan");
        set("exits", ([
		"north" : __DIR__"nanmen",
        ]));
   set("oldarea","nanyang");
        setup();
        replace_program(ROOM);
}