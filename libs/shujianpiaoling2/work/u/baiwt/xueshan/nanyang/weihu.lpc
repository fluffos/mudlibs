#include <ansi.h>
inherit ROOM;
void create()
{
  set("short",HIW"威虎堂"NOR);
  set("long",@LONG
威虎堂建在一个大土台上。粗粗搭建的房子似显不太工整，却颇有气势。门
前有两个喽罗把门，手中拿着长柄大刀。门外地下一口大锅，正烧着旺火。两边
几间歪歪扭扭的木屋，里面不时传来笑声，叫骂声。进得门来，正中一把太师椅
上坐着一位寨主，两边列着兵器。
LONG);
  set("exits",([
    "west"   : __DIR__"shanzhai",
  ]));
   set("objects",([
         __DIR__"npc/man":1,
         __DIR__"npc/elang":1,
         __DIR__"npc/lanjiao2":1,
   ]));
   set("oldarea","nanyang");

  setup();
}
