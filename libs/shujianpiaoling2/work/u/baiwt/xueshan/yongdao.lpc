inherit ROOM;

void create() {
  set("short", "地下甬道");
  set("long", @LONG
这是一条昏暗的地下甬道，四周都是石壁，阴暗潮湿，不知通向何处.
LONG
  );
  set("exits", ([
    "eastup": __DIR__ "secrect_hut",
    "westdown": __DIR__ "dijiao",
  ]));
  set("outdoors", "xueshan");

  setup();
}
void init() {
  add_action("do_go", "go");

}

int do_go() {
  if (random(8)) {
    this_player()->move(this_object());
    return 1;
  }
}
