
inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
这是一条通向雪山林海的小路，四下里静悄悄的，只能听见你自己的
脚步声。
LONG
        );
        set("exits", ([ 
  "north" : __DIR__"forest",
  "southdown" : __DIR__"xiaowu",
]));
        set("outdoors", "xueshan");

        setup();
}

void init()
{
        add_action("do_go","go");

}

int do_go()
{
if(random(2)){
this_player()->move(this_object());
return 1;
}
}
