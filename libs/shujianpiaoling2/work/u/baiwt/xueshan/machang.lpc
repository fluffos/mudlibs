inherit ROOM;

void create ()
{
  set ("short", "雪山马场");
  set ("long", @LONG
这是雪山脚下的马场，场子的四周搭起了一排长长的马棚，棚里是
各种各样的马。马前放着食槽，槽里堆着切好的新鲜草料。不远处便可
看见一片绿色的大草原，那里水草丰厚，成群的马匹在草原上尽情奔驰.
马场的入口处挂着一块木牌(sign)，旁边站着一个牧马人。
LONG);

  set("exits", ([
        "west" : __DIR__"shanjiao",
      ]));
  set("objects", ([
        __DIR__"xsnpc/maguan" : 1,
        "/u/baiwt/xueshan/xsnpc/horse" : 8,
      ]));
  set("no_fight",1);
  set("no_steal",1);
	set("item_desc", ([
	    "sign" : "欢迎来到雪山马场。骑马请用mount，下马请用dismount。\n
目前正需养马的伙计，有意打工者请work开始工作。\n",
        ]));
  set("outdoors", "xueshan");
  setup();
}


