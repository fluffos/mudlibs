
inherit ROOM;

void create()
{
	set("short", "冰瀑");
        set("long",@LONG
你走到这里便觉得眼前一亮，巨大的冰瀑从山峰顶上倒挂而下，发出
隆隆巨响，声势极为惊人。这里仍是阳光普照，但冰壁并不因此而融化，
在冰瀑的冲击下腾起蒙蒙白雾，景色蔚为壮观。
LONG
        );
        set("outdoors", "xueshan");
	set("exits", ([
		"east" : __DIR__"yan",
        ]));
	set("objects",([
		__DIR__"npc/mafeng" : 1,
       	]));
        setup();
}

void init()
{
	add_action("do_zha", "bomb");
}

int do_zha()
{
	object me, *inv;
	int i;
	object exp;
	object con,item;
	me = this_player();
	if( !(int)me->query("marks/墨无为"))
	return 0;
	inv = all_inventory(me);
	               for(i=0; i<sizeof(inv); i++)
                {
				
			if( (int) inv[i]->query("explosive") )
				exp = inv[i];
		}
	if( !exp) 
	{
	tell_object(me,"你没有引爆的东西．\n");
	return 1;
	}

	message_vision("$N点燃了手中的"+exp->name()+"．．．
只听得一声滔天巨响＂轰＂，冰瀑被炸开个大洞．\n", me, exp);
	destruct(exp);
	con = new(__DIR__"obj/seal");
	item = new(__DIR__"obj/starpai");
	if( con && item){
	item->move(con);
	con->move(this_object());
	me->set("marks/墨无为",0);
			}
	return 1;

}

