inherit ROOM;

void create() {
  set("short", "长春谷");
  set("long", @LONG
冰河到这里突然变浅了，你只觉豁然开朗，在你面前是花繁叶茂，绿草如茵
的景象，整个山谷都洋溢着春天的气息，仿佛到了人间天堂。冰雪和花草并存，
也许只有雪山长春谷才有这般令人惊叹的自然奇观。一边的山壁之上有一块冰
岩，在日光的照耀下反射出绚烂的光彩，象晶莹的水晶，十分好看。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "south": __DIR__ "lianyuan",
    "northup": __DIR__ "sroad",
    "eastdown": __DIR__ "shanlu2",

  ]));
  set("item_desc", ([
    "冰岩": "这是一块光亮透明的冰岩，你忍不住便想摸摸它(touch)。\n",
    "bingyan": "这是一块光亮透明的冰岩，你忍不住便想摸摸它(touch)。\n",

  ]));

  setup();
}

void init() {
  add_action("do_touch", "touch");
}
int do_touch(string arg) {
  object obj;
  object me;
  if (!arg || arg == "") {
    write("你要摸什么？\n");
    return 1;
  }
  if (arg == "bingyan" || arg == "冰岩") {
    me = this_player();
    message_vision("$N摸了一下冰岩，忽然旁边的山石往左移开，露出了一个秘洞。\n", me);
    if (!query("exits/west")) {
      set("exits/west", __DIR__ "midong");
      call_out("close_path", 1);
    }
    return 1;
  } else {
    write("你不可以乱碰" + arg + "\n");
    return 1;
  }
}
void close_path() {
  if (!query("exits/west")) return;
  message("vision",
    "山石[咯]地一声移了回来，又遮住了秘洞。\n",
    this_object());
  delete("exits/west");
}
