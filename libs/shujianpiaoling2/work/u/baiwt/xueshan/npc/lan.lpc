
#include <ansi.h>

inherit NPC;
string	summon_more( object who);
void create()
{
	set_name("兰儿", ({ "lan er", "lan"}));
	set("long",
	    "她是「翠兰倚萍」四大侍女之一.\n"+
	    "眼如点漆, 清秀绝俗.\n");
	set("gender", "女性");
	set("age", 18);
	set("shen_type",1);
	set("attitude", "peaceful");

	set("str", 25);
	set("per", 40);

	set("combat_exp", 1000000);
	set("score", 10000);
	set_skill("force", 70);
	set_skill("unarmed", 70);
	set_skill("dodge", 80);
	set_skill("parry", 70);
	set_skill("sword",80);

        set_skill("bingchuan-sword", 80);
        set_skill("fengxue-steps", 80);
        set_skill("xuanyinforce", 80);
        set_skill("piaoxue-strike", 80);

	map_skill("force", "xuanyinforce");
	map_skill("dodge", "fengxue-steps");
	map_skill("unarmed", "piaoxue-strike");
	map_skill("parry", "bingchuan-sword");
	map_skill("sword", "bingchuan-sword");

	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: summon_more(this_object()) :),
	}) );


	create_family("雪山琼宫",3,"侍女");
	setup();
	carry_object(__DIR__"obj/qingyi")->wear();
            carry_object(__DIR__"obj/doupeng")->wear();
	carry_object(__DIR__"obj/longsword")->wield();
	add_money("gold",15);
}

void init()
{
	object		me;

        ::init();
        if( interactive(me = this_player()) && !is_fighting() ) {
		if(name() == "兰儿") {
                	call_out("dogattack", 1, me);
		}
        }
}

int dogattack(object me)
{
	object		groom;

	if( (string)me->query("family/family_name")!="雪山琼宫" ) {
		set_leader(me);
		message_vision(HIW "\n$n忽然感到一阵寒意，禁不住机伶伶打了个冷战！\n" NOR, this_object(), me);
		me->receive_damage("kee", 30);
		return 1;
	}
	return 0;
}
string summon_more(object who)
{
	int i;
	object *enemy;
	object another;
	seteuid(getuid());
	another = new(__DIR__"shinv");
	another->move(environment(who));
	message_vision(another->name()+ "走了过来。\n"
		, this_object() );
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			another->kill_ob(enemy[i]);
			enemy[i]->kill_ob(another);
			another->set_leader(enemy[i]);
		}
	}
	return "1";
}
int accept_fight(object me)
{
	command("say 琼宫圣地不准动武。");
        return 0;
}
