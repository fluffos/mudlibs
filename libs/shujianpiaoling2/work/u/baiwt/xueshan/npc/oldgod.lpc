#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("无名老人", ({ "oldgod" }));
  set("gender", "男性");
  set("age", 82);
  set("long", "这是一位鹤发童颜的老人，传说居住在遥远的东海无名岛...\n");
  set("attitude", "friendly");
  set("title", "　");
  create_family("东海无名岛", 1, "岛主");

  set("str", 360);
  set("int", 30);
  set("spi", 30);
  set("cor", 90);

  set("max_kee", 9000);
  set("max_gin", 9000);
  set("max_sen", 9000);
  set("kee", 9000);
  set("gin", 9000);
  set("sen", 9000);
  set("force", 90000);
  set("max_force", 90000);
  set("force_factor", 100);

  set("atman", 2000);
  set("max_atman", 2000);
  set("atman_factor", 50);

  set("mana", 4000);
  set("max_mana", 2000);
  set("mana_factor", 50);


  set("combat_exp", 90000999);
  set_skill("literate", 240);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("sword", 300);
  set_skill("changesword", 300);
  set_skill("piaoxiang-steps", 300);
  set_skill("liuhe-force", 300);
  set_skill("fenglei-sword", 300);
  set_skill("force", 300);
  set_skill("wuxing-zhi", 300);
  map_skill("force", "liuhe-force");
  map_skill("dodge", "piaoxiang-steps");
  map_skill("sword", "fenglei-sword");
  map_skill("parry", "wuxing-zhi");
  map_skill("unarmed", "wuxing-zhi");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "liuhe" :),
    (: perform_action, "unarmed.qijian" :),
  }));

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("bellicosity") >= 20) {
    command("say 你心术不正，做不了我的弟子。\n");
    return;
  }
  if ((int)ob->query_skill("qidaoxinfa", 1) < 10) {
    command("say 你我非有缘之人。\n");
    return;
  }
  if ((int)ob->query_skill("one-sword", 1) < 100) {
    command("say " + RANK_D->query_respect(ob) + "的剑术修为不够，做不成我的弟子.");
    return;
  } else {
    message_vision(CYN "无名老人微笑说道：“你资质不错，我就收下你吧。”\n" NOR, ob);
    command("recruit " + ob->query("id"));
    if ((string)ob->query("class") != "snowman")
      ob->set("class", "snowman");
    return;
  }
}


void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      message_vision("$N看了$n一眼，说道：这里不是极乐仙境。\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N摇了摇头，叹道：可怜我那莲儿还不知道生父是谁呢！\n", this_object(), ob);
      break;
    case 2:
      command("sigh");
  }
}
int accept_fight(object me) {
  command("say 快回去吧，不要这么争强好胜。");
  return 0;
}
