// /u/baiwt/xueshan/npc/gexianren.c    created by Baiwt

#include <ansi.h>
inherit NPC;
int about_quest();
string summon_more(object who);

void create() {
  set_name("葛长庚", ({ "ge changgeng", "ge" }));
  set("long",
    "这是一个六十多岁的老人, 精神矍铄，神态安详。\n" +
    "他和飘浮子、清尘庵主同是[武林三逸]中南山野叟的弟子。\n" +
    "他继承了师父的医术，一生专研药理，被江湖称作百草之王。\n");
  set("title", "南门三奇之一");
  set("gender", "男性");
  set("age", 64);
  set("nickname", HIC "百草仙翁" NOR);
  set("shen_type", 1);
  set("attitude", "peaceful");

  set("str", 130);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 9000);
  set("max_gin", 9000);
  set("max_sen", 9000);
  set("kee", 9000);
  set("gin", 9000);
  set("sen", 9000);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 20);

  set("mana", 2000);
  set("max_mana", 2000);

  set("inquiry", ([
    "quest": (: about_quest :),
  ]));

  set("combat_exp", 1200000);
  set("score", 20000);

  set_skill("stealing", 900);
  set_skill("literate", 200);
  set_skill("force", 150);
  set_skill("unarmed", 150);
  set_skill("dagger", 150);
  set_skill("zhichi-dagger", 130);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("liuh-ken", 100);
  map_skill("unarmed", "liuh-ken");
  map_skill("dagger", "zhichi-dagger");
  set("chat_chance_combat", 99);
  set("chat_msg_combat", ({
    (: summon_more(this_object()) :),
  }));
  setup();
  carry_object(__DIR__ "obj/yandou")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}
string summon_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      message_vision(HIM "\n忽然林外传来一声朗朗长笑，一男一女两条人影霎时出现在$N眼前！\n", enemy[i]);
      message_vision(GRN "\n葛长庚说道：师弟、师妹来得正好，快来助我一臂之力！\n", enemy[i]);
      message_vision(NOR "\n飘浮子斜身进步，从$N绝对意想不到的方位踏近身来，骈指一戳。\n", enemy[i]);
      message_vision(CYN "$N只觉得笑腰穴上一麻，忍不住[哈哈]大笑起来，结果笑得前仰后合，上气不接下气。\n", enemy[i]);
      message_vision(NOR "\n清尘庵主手腕一抖，拂尘唰地一声往$N脚下疾扫而来。\n", enemy[i]);
      message_vision(CYN "$N不知怎的，鬼使神差竟然自己撞到了拂尘上，结果被绊了个四脚朝天，半天爬不起来。\n", enemy[i]);
      message_vision(NOR "\n葛长庚见$N跌倒，连忙抓起一把烂泥往$N的嘴里塞去。\n", enemy[i]);
      message_vision(CYN "$N只觉得满嘴臭气直冲心扉，气得两眼翻白，昏了过去。\n\n" NOR, enemy[i]);
      enemy[i]->unconcious();
      enemy[i]->move("/u/baiwt/xueshan/tudimiao.lpc");
    }
  }
  return "1";
}

void init() {
  add_action("do_cancel", "cancel");
}

int do_cancel(string arg) {
  object me = this_player();
  if (!arg || arg != "quest")
    return notify_fail("你要取消什么？\n");
  return notify_fail("现在无法取消任务！\n");
  if (!me->query_temp("marks/gejob"))
    return notify_fail("你现在没有任务。\n");
  say(CYN "葛长庚叹道：不想做了吗？好吧，你自己反省一下。\n" NOR);
  if ((int)me->query("combat_exp") <= 100) {
    me->delete_temp("marks/gejob");
    me->unconcious();
    return 1;
  }
  me->add("combat_exp", -random(100));
  me->delete_temp("marks/gejob");
  me->unconcious();
  return 1;
}

