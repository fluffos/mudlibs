int accept_object(object who, object ob) {
  int exp, pot;
  object me;
  me = this_player();
  exp = (int)me->query_quest_time() / 10;
  pot = exp / 2;
  if (exp < 1) exp = 0;
  if (pot < 1) pot = 0;
  if (ob->name() == (string)me->query_temp("marks/gejob")) {
    say(CYN "葛长庚微笑点头，说道：很好，继续努力。\n" NOR);
    me->add("combat_exp", exp);
    if (random(9) < 5)
      me->add("potential", pot);
    else
      me->add("life_exp", random(10));
    me->add("score", random(5));
    me->delete_temp("marks/gejob");
    me->set_quest_time(0);
    return 1;
  } else {
    say(CYN "葛长庚说道：多谢你的好意，但这东西对我没用。\n" NOR);
    return 0;
  }
  return 1;
}
