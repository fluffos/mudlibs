#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("雪山神尼", ({ "master ni", "ni", "master" }));
	set("long",
	    "这是一个白发苍苍的老妇人\n"+
	    "她是雪珠连和冷凝珠的师父.\n");
	set("gender", "女性");
	set("age", 85);
//	set("shen_type",1);
	set("attitude", "peaceful");

        set("str", 350);
        set("int", 30);
        set("per", 50);
        set("cor", 90);
        set("spi", 30);
	set("max_kee", 9000);
	set("max_gin", 9000);
	set("max_sen", 9000);

        set("force", 90000);
        set("max_force", 90000);
        set("force_factor", 100);

        set("atman", 2000);
        set("max_atman", 2000);
        set("atman_factor", 50);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 50);
//        set("potential", 50000);
        set("combat_exp", 90000999);
        set("score", 200000);

        set_skill("literate", 300);
        set_skill("force", 300);
        set_skill("unarmed", 300);
        set_skill("sword", 300);
        set_skill("parry", 300);
        set_skill("dodge", 300);
        set_skill("mystforce", 300);
	set_skill("mystsword",300);
        set_skill("piaoxue-strike", 300);
        set_skill("mysterrier", 300);
	set_skill("fantianqi",260);
        set_skill("throwing", 260);
        set_skill("fengxue-steps", 300);
        set_skill("qidaoxinfa", 260);

        map_skill("force", "mystforce");
        map_skill("parry", "mystsword");
        map_skill("sword", "mystsword");
        map_skill("unarmed", "piaoxue-strike");
        map_skill("dodge", "fengxue-steps");
        map_skill("throwing", "fantianqi");

        set("chat_chance_combat", 99);
        set("chat_msg_combat", ({
                (: perform_action, "dodge.xuedipiaofeng" :),
//                (: perform_action, "throwing.xingyi" :),
        }) );

	create_family("雪山琼宫",1, "祖师");
	setup();
	carry_object(__DIR__"obj/changpao")->wear();
	carry_object(__DIR__"obj/stone")->wield();
}

void attempt_apprentice(object ob)
{
	message_vision("雪山神尼垂目说道：贫身已不收徒弟，你去拜我的弟子吧。\n",ob);
       return;
}
int accept_fight(object me)
{
	command("say 琼宫圣地不准动武。");
        return 0;
}

