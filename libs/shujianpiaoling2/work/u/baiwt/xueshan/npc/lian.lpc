#include <ansi.h>

inherit NPC;
int about_he();
int about_oldgod();
int about_baiyuan();
int about_jade2();

void create() {
  set_name("莲儿", ({ "lian er", "lian" }));
  set("long",
    "这是个容貌姣好的女子, 瓜子脸蛋,\n" +
    "眼如点漆, 清秀绝俗.\n" +
    "你总觉得在哪见过她.\n");
  set("gender", "女性");
  set("age", 17);
  set("shen_type", 1);
  set("title", "放鹤少女");
  set("attitude", "peaceful");
  set("chat_chance", 10);
  set("chat_msg", ({
    "莲儿说道：你见到我爷爷了吗？\n",
    "莲儿幽幽地叹了口气，道：我妈妈留给我的玉佩被金毛怪抢走了，我怎么才能找回来呢？\n",
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    "莲儿杏眼圆睁，叱道：你原来是坏人啊！\n",
    (: command, "crane.saveme" :),
  }));

  set("str", 20);
  set("per", 90);
  set("combat_exp", 6000000);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("kee", 5000);
  set("gin", 5000);
  set("sen", 5000);
  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 30);

  set("inquiry", ([
    "琼宫": (: about_he :),
    "雪山琼宫": (: about_he :),
    "无名老人": (: about_oldgod :),
    "金毛怪": (: about_baiyuan :),
    "玉佩": (: about_jade2 :),
  ]));

  set_skill("stealing", 900);
  set_skill("force", 200);
  set_skill("unarmed", 200);
  set_skill("dodge", 300);
  set_skill("parry", 200);
  set_skill("piaoxiang-steps", 200);
  set_skill("wuxing-zhi", 200);
  set_skill("konghegong", 200);
  set_skill("xuanyinforce", 200);
  map_skill("unarmed", "wuxing-zhi");
  map_skill("dodge", "piaoxiang-steps");
  set("class", "snowman");
  setup();
  carry_object(__DIR__ "obj/qingyi")->wear();
  carry_object(__DIR__ "obj/doupeng")->wear();
  //	carry_object(__DIR__"obj/longsword")->wield();
  add_money("silver", 40);
}


int about_he() {
  object me = this_player();
  if (me->query("life_exp") < 200) {
    command("say 我的仙鹤病了，我要快点治好它呀！没空跟你说话了。");
    return 0;
  }
  command("say 你也是慕名来的吗？坐仙鹤过去吧，小心别摔着了！(zuo) \n");
  me->add_temp("xueshan/allow_fly", 1);
  return 1;
}

int about_baiyuan() {
  command("say 你问金毛怪吗？我常看见他在长春谷出没的。 \n");
  return 1;
}

int about_jade2() {
  command("say 爷爷说，我小时侯被遗失在海边，他从婴儿襁褓中发现了这块玉佩，上面刻有我的姓.\n");
  return 1;
}

int about_oldgod() {
  object me;
  object yumao;
  me = this_player();
  say("莲儿嫣然一笑。\n");
  say("莲儿说道：爷爷最爱养荷花了，你拿着这东西去见爷爷，爷爷会让你进莲花池的。\n");
  say("莲儿从仙鹤身上拔了根羽毛，轻轻塞在你的手里。\n");
  yumao = new(__DIR__ "obj/white_feather");
  yumao->move(me);
  return 1;
}

int accept_object(object who, object ob) {
  object me;
  int score, pot;
  me = this_player();
  if (ob->name() == "玉莲佩") {
    if ((int)ob->query("objattrib") != 1) return 0;
    if ((int)me->query("xueshan/lianpei") > 5) return 0;
    score = (int)me->query("combat_exp");
    pot = (int)me->query("potential");
    me->set("combat_exp", (int)score + 1000);
    me->set("potential", (int)pot + 300);
    say("莲儿笑面如花，开心地说道：多谢这位" + RANK_D->query_respect(who)
      + "替我找回了玉佩！\n");
    me->add("xueshan/lianpei", 1);
    return 1;
  } else {
    say("莲儿摇了摇头，说道：我不要这东西。\n");
    return 0;
  }

  return 1;
}

int accept_fight(object me) {
  command("say 我哪里是您的对手呀? ");
  return 0;
}
