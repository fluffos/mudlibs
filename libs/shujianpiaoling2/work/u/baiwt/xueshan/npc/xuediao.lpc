inherit NPC;

void create()
{
        set_name("雪貂", ({ "xue diao", "diao" }) );
        set("race", "野兽");
        set("age", 2);
        set("long", "一只可爱的雪貂。\n");
        set("attitude", "peaceful");
 
        set("str", 15);
        set("cor", 16);

        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "bite" }) );
 
        set("combat_exp", 300);

        set_temp("apply/attack", 5);
        set_temp("apply/damage", 3);
	set_temp("apply/defence",5);
	set_temp("apply/armor",3);
	setup();
        carry_object("/u/baiwt/xueshan/xsobj/chuanguo");
}
