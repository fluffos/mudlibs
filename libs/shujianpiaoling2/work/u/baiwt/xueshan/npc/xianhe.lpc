inherit NPC;

void create()
{
        set_name("仙鹤", ({ "xian he","he" }) );
        set("race", "野兽");
        set("age", 2);
        set("long", "一只浑身雪白的丹顶鹤，传说乃雪山灵禽。\n");
        set("attitude", "peaceful");
 
        set("str", 45);
        set("cor", 46);
	set("kee", 5000);
	set("gin", 5000);
	set("sen", 5000);
        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "claw" }) );
 
        set("combat_exp", 2000000);

        set_temp("apply/attack", 500);
        set_temp("apply/damage", 300);
	set_temp("apply/defence",500);
	set_temp("apply/armor",300);

	setup();
}
