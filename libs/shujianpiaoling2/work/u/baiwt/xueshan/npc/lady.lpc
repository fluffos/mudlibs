#include <ansi.h>

inherit NPC;

void create()
{
        set_name("卖艺姑娘", ({ "maiyi girl","girl" }) );
        set("long", "一个俏丽的姑娘，身穿紧身衣裤，正在打把式卖艺。\n");
        set("age", 18);
        set("gender", "女性");
        set("attitude", "peaceful");
        set("combat_exp", 1000);
	set_skill("stealing", 900);
        set("chat_chance", 10);
        set("chat_msg", ({
                "卖艺姑娘流泪说道：要是我武功好一点，就不会受人欺负了！\n",
        }) );
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
        add_money("silver", 10);
}
int accept_object(object who, object ob)
{
        object me;
	int score, pot;
	me = this_player();
//	if(!(int)me->query_temp("marks/lady")) return 1;
	if( ob->name() == "[雪山派轻功]") {
	if((int)ob->query("objattrib") !=1 )  return 0;
	score = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
		me->set("combat_exp", (int) score + 30);
		me->set("potential", (int) pot + 40);
        say( "卖艺姑娘说道：多谢这位" + RANK_D->query_respect(who)
                + "给我练武的书籍，我一定好好学.\n");
	me->delete_temp("marks/lady");
        say( "卖艺姑娘轻声说道：告诉你一个秘密，南阳城杨家藏着一把金色宝刀，削铁如泥！\n");
//        say( "卖艺姑娘匆匆离开了。\n");
//	this_object()->move("/u/baiwt/npc_hut.lpc");
//      command("drop all");
	return 1;
        }
		else {
			say("卖艺姑娘摇了摇头，说道：这东西有什么用呀？\n");
			return 0;
                }
        return 1;
}
