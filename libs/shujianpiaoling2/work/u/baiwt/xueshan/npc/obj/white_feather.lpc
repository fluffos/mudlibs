
#include <armor.h>

inherit CLOTH;
void create()
{
	set_name("白羽毛", ({ "white feather", "feather" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一根雪白的仙鹤羽毛\n");
		set("unit", "条");
		set("value", 1);
		set("material", "cloth");
		set("armor_prop/armor", 1);
		set("armor_prop/dodge", -10);
		set("armor_prop/unarmed",-10);
	}
	setup();
}

