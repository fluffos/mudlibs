#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create() {
  set_name(HIM "玉龙镯" NOR, ({ "dragon jade" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个翠绿欲滴的玉手镯，内有一条白龙若隐若现。\n");
    set("unit", "个");
    set("value", 30000);
    set("objattrib", 1);
    set("armor_prop/armor", 20);
    set("armor_prop/personality", 20);
    set("wear_msg", "$N轻轻地把一个$n戴在手腕上。\n");
    set("unwield_msg", "$N轻轻地把$n从手腕上除了下来。\n");
  }
  setup();
}
