// medicine.c

inherit ITEM;

void create()
{
	set_name("白莲藕",({"lotus root"}));
        set_weight(60);
        if( clonep() )
                set_default_object(__FILE__);
	else {
	    set("long",
     	        "一根雪白的莲藕，看上去如同羊脂白玉一般，洁白无暇。\n");
	    set("unit","根");
	    set("value", 2);
	}
}

void init()
{
  if(this_player()==environment())
	add_action("apply_medicine","eat");
}

int apply_medicine()
{
//	int value = 20;
//	int diff;
	object me;
	int score, pot;
	me = this_player();
	score = (int) me->query("max_mana");
	pot = (int) me->query("mana");

	if(this_player()->is_fighting())
	    return notify_fail("战斗中不能服用莲藕！！\n");
//	diff = this_player()->query("max_kee")-this_player()->query("eff_kee");
//	if(!(diff))    return notify_fail("你没有受伤！\n");
//	if(value > diff) value = diff;
	message_vision("$N采了根莲藕，津津有味地吃了下去。\n",this_player());
		me->set("max_mana", (int) score + 5);
		me->set("mana", (int) pot + 5);
//	this_player()->add("eff_kee",value);
	destruct(this_object());
	return 1;
}


