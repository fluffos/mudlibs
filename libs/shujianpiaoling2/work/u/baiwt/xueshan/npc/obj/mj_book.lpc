inherit ITEM;

void create()
{
	set_name( "满江红剑谱", ({ "manjianghong" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本满江红剑谱，上面画着一些纷繁复杂的招式及修练法门。\n");
		set("value", 500);
		set("material", "paper");
		set("skill", ([
			"name":	"mjsword",	
			"exp_required":	30000,	// minimum combat experience required
			"sen_cost": 50, 	// jing cost every time study this
			"difficulty":	60,	// the base int to learn this skill
			"max_skill":	120,	// the maximum level you can learn
		]) );
	}
}
