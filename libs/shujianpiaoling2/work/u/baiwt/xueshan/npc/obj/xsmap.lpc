
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name("琼宫地图", ({"map"}) );
	set_weight(5);
	set("long",
	    "这是一张记录琼宫各内宫方位的地图，乃琼宫弟子所必备。\n"+
	    "\n"+
	    "　　　琼宫回廊－彩凤宫－琼宫回廊－洗剑池－琼宫回廊\n"+
	    "　　／　　　　　　｜　　　　｜　　　｜　　　　　　＼　\n"+
	    "睡莲宫　　　　琼宫回廊　　小天湖　琼宫回廊　　　　翠萍宫\n"+
	    "　　＼　　　／　　　　　　　　　　　　　　＼　　　／\n"+
	    "　　琼宫回廊　　　　　　　　　　　　　　　　琼宫回廊\n"+
	    "　　　｜　　＼　　　　　　　　　　　　　　／　　｜\n"+
	    "　　瑶竹宫　智慧宫　　　　　　　　　　寒冰洞　玉藕宫\n"+
	    "　　　　　＼　　　　　　　　　　　　　　　　　／\n"+
	    "　　　　　　琼宫回廊　　　　　　　　　琼宫回廊\n"+
	    "　　　　　　　　　　＼　　　　　　　／\n"+
	    "　　　　　　　　　　　　放　鹤　厅\n"+
	    "\n");
	set("unit", "张");
       set("no_drop",1);
        set("value", 0);
}

