#include <ansi.h>

inherit NPC;

void create()
{
	set_name("骆姑婆", ({ "luo gupo", "luo", "gupo" }));
	set("long",
	    "她是琼宫弟子的长辈，传说来自遥远的天山。\n");
	set("gender", "女性");
	set("age", 60);
	set("shen_type",1);
	set("title", "　");
	set("attitude", "peaceful");

	set("str", 25);
	set("int", 25);
	set("con", 30);
	set("dex", 30);

	set("kee", 800);
	set("max_kee", 800);
	set("sen", 500);
	set("max_sen", 500);
	set("force", 1000);
	set("max_force", 1000);

	set("combat_exp", 1000000);
	set("score", 1000);
	set_skill("force", 100);
	set_skill("unarmed", 180);
	set_skill("dodge", 100);
	set_skill("parry", 100);

	set_skill("piaoxue-strike",180);
	set_skill("xuanyinforce",180);
   	set_skill("yueying-wubu",100);

	map_skill("force", "xuanyinforce");
	map_skill("dodge", "yueying-wubu");
	map_skill("unarmed", "piaoxue-strike");

	create_family("雪山琼宫",3,"弟子");
	setup();
	carry_object(__DIR__"obj/qingyi")->wear();
	carry_object(__DIR__"obj/doupeng")->wear();
	add_money("silver",10);
}
int accept_fight(object me)
{
	command("say 琼宫圣地不准动武。");
        return 0;
}

