#include <ansi.h>

inherit NPC;

void create() {
  set_name("冷蝶", ({ "lengdie", "die" }));
  set("long",
    "这是个身材娇好的女郎, 轻纱遮面,\n"
    "一双秀目中透出一丝杀气。\n"
  );
  set("gender", "女性");
  set("nickname", HIC "满蕊香寒" NOR);
  set("age", 20);
  set("attitude", "peaceful");

  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("kee", 2000);
  set("max_kee", 2000);
  set("sen", 2000);
  set("max_sen", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 1500000);
  set("score", 10000);
  set_skill("literate", 150);
  set_skill("force", 150);
  set_skill("unarmed", 150);
  set_skill("sword", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("mystforce", 150);
  set_skill("mystsword", 150);
  set_skill("piaoxue-strike", 150);
  set_skill("mysterrier", 150);

  map_skill("force", "mystforce");
  map_skill("parry", "mystsword");
  map_skill("sword", "mystsword");
  map_skill("unarmed", "piaoxue-strike");
  map_skill("dodge", "mysterrier");

  create_family("雪山琼宫", 3, "弟子");
  setup();
  carry_object(__DIR__ "obj/pink_cloth")->wear();
  carry_object(__DIR__ "obj/doupeng")->wear();
  carry_object(__DIR__ "obj/longsword")->wield();
  add_money("silver", 15);
}
int accept_fight(object me) {
  command("say 琼宫圣地不准动武。");
  return 0;
}
