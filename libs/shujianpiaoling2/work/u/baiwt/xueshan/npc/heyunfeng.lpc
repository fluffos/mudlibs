
#include <ansi.h>

inherit NPC;
int about_he();
int about_yang();
void create()
{
	set_name("何云峰", ({ "he yunfeng","he" }));
	set("long",
	    "这是一个四十五六岁的中年人, 浓眉大眼,\n"+
	    "身穿一件华贵雅致的长袍, 倒使他更显几分精神.\n"+
	    "他位居四大护法之一.\n");
	set("title", "红枫英魂");
	set("gender", "男性");
	set("age", 46);
	set("nickname", HIC "通天剑客" NOR);
	set("shen_type",1);
	set("attitude", "peaceful");

        set("str", 20);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);
	set("max_kee", 5000);
	set("max_gin", 5000);
	set("max_sen", 5000);
	set("kee", 5000);
	set("gin", 5000);
	set("sen", 5000);

        set("force", 3000);
        set("max_force", 3000);
        set("force_factor", 50);

        set("atman", 2000);
        set("max_atman", 2000);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 30);

        set("inquiry", ([
                "谷兰香" : (: about_he :),
                "杨兰娇" : (: about_yang :),
        ]));

        set("combat_exp", 10000000);
        set("score", 200000);

      set_skill("literate", 100);
        set_skill("force", 150);
        set_skill("unarmed", 200);
        set_skill("sword", 200);
        set_skill("parry", 200);
        set_skill("dodge", 150);
        set_skill("qidaoforce", 150);
	set_skill("mjsword",250);
        set_skill("shenkong-xing", 150);
//	set_skill("stealing", 200);
	set_skill("liuh-ken",200);
        map_skill("unarmed", "liuh-ken");
        map_skill("force", "qidaoforce");
        map_skill("parry", "mjsword");
        map_skill("sword", "mjsword");
        map_skill("dodge", "shenkong-xing");

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "sword.chaotian" :),
                (: exert_function, "recover" :),
        }) );

	create_family("红枫派",2, "弟子");

	setup();
        carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/longsword")->wield();
	add_money("silver",40);
}

int accept_object(object who, object ob)
{
        object me;
        object mjbook;
        object leafsheet;
	if( ob->name() == "情诗") {
	me = this_player();
          leafsheet = new(__DIR__"obj/leafsheet");
          mjbook = new(__DIR__"obj/mj_book");
         leafsheet->move(me);
 	if( !me->query("class"))
         return mjbook->move(me);
        say( "何云峰说道：有劳这位" + RANK_D->query_respect(who)
                + "给我送信，只是何某已是有家室之人，恐怕要辜负芸香的一翻心意了！\n");
	return 1;
        }
		else {
			say("何云峰摇了摇头，说道：我不要你的东西。\n");
			return 0;
                }

        return 1;
}

int about_he()
{
      command("say 她就是当年的潇湘女侠张芸香，我和她曾有一段情缘。");
      command("say 后来谷扶西出山了，没想到她竟然是这个魔头失散多年的女儿！");
      command("say 她父亲十分专横，强迫她陪他一起隐居深山，终日难见阳光。唉，好可怜！\n");
	return 1;
}

int about_yang()
{
	object me=this_player(), room;
	message_vision(HIC"\n何云峰双目含泪，望着火烛出神，似乎回忆起了遥远的过去. . .\n"NOR,me);
	message_vision(HIC"\n何云峰叹了口气，说道：我一直遗憾未能救得兰娇性命，唉！\n\n"NOR,me);
      command("say 难得你有这般侠义心肠，你就替我去完成心愿吧！拜托你了！\n");
	if(!( room = find_object("/u/baiwt/xueshan/nanyang/xiaodao")) )
		room = load_object("/u/baiwt/xueshan/nanyang/xiaodao");
	message_vision(HIC"\n$N只觉眼前一阵烟雾飘过，使$N不知身在何处。\n\n"NOR,me);
        me->move(room);
	message_vision(HIG"\n$N揉了揉眼睛，发现周围的一切全变了！\n\n"NOR, me);

	return 1;
}
int accept_fight(object me)
{
	command("say 何某久未与人动手，早已去了争胜之心了。");
        return 0;
}
int recognize_apprentice(object ob)
{
	if( (int)ob->query_skill("mjsword",1) >30 )	return 1;
	return 0;
}
