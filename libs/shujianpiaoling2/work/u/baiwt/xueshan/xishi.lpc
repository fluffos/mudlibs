inherit ROOM;

void create()
{
	set("short", "歇脚石");
        set("long",@LONG
这里有一块平整光光滑的山石，可以供人坐下歇息，所以小贩们也经
常到这里来摆摊，提供给上山的旅客一些水和食物。石边有一口小井.
LONG
        );
        set("outdoors", "xueshan");
	set("exits", ([
		"east" : __DIR__"shanpo",
        ]));
        set("resource/water",1);
//	set("liquid/name","清凉的井水");
	set("objects",([
		__DIR__"npc/seller" : 1,
       	]));
        setup();
//        replace_program(ROOM);
}

void init()
{
        add_action("do_fillwater", "fillwater");
}
int do_fillwater(string arg)
{
        object *list, ob;
        int i, can_fillwater;
        string dir;

        if( !arg || arg=="" ) return 0;

        if( arg=="skin" || arg=="wineskin" ) {
                list = all_inventory(this_player());
                i = sizeof(list);
                can_fillwater = 0;
                while (i--) {
                  if (((string)list[i]->query("liquid/type") == "alcohol")
 || ((string)list[i]->query("liquid/type") == "water")         ) {
                        ob = list[i];
                        can_fillwater = 1;
                        ob->set("liquid", ([
                                "type": "water",
                                "name": "清水",
                                "remaining": 15,
                                "drunk_apply": 6,
                        ]) );
                        write("你从小井里装满了清水! \n");
                        return 1;
                   }
                }
                if (can_fillwater ==0) {
                        write("你没有装水的东西啊....\n");
                        return 1;
                }
        }
        else {
                write("你要往什么东西里灌水？");
        }
        return 1;
}
