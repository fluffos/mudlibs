
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name("星河帖" , ({ "starpai" , "pai"}) );
	set_weight(5);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("long", "这是一张纸帖，是出入星河宫的信物。\n");
		set("material", "paper");
		set("objattrib", 1);
		set("value", 0);
	}
}



