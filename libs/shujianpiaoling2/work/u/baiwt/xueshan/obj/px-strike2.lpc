inherit ITEM;

void create()
{
	set_name( "飘雪云穿掌法图下卷", ({ "zhangfatu2", "tu" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "幅");
		set("long", "这是一幅飘雪云穿掌法图，上面画着一些纷繁复杂的招式。\n");
		set("value", 500);
//		set("no_get",1);
		set("material", "paper");
		set("skill", ([
			"name":	"piaoxue-strike",	
			"exp_required":	200000,	// minimum combat experience required
			"sen_cost": 40, 	// jing cost every time study this
			"difficulty":	40,	// the base int to learn this skill
			"max_skill":	60,	// the maximum level you can learn
		]) );
	}
}
