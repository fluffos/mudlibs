#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("地灵符",({ "earthsheet" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("material", "steel");
                set("long", "一块铜制小牌，上面刻着[地灵符]三个字。你可以祭(ji)\n");
        }
}

void init()
{
        add_action("do_ji", "ji");
}

int do_ji(string arg)
{
	object tudi;
	object me=this_player(),room;
        if( arg != "earthsheet" ) return 0;
	if (objectp(present("tudi", environment(me))) )
	 return notify_fail
		("土地说道：“老神我不是在这儿吗？你还叫什么！”\n");
	seteuid(getuid());
	tudi= new("/u/baiwt/xueshan/npc/tudi");
	tudi->move(environment(me));
        message_vision(HIC"$N拿起" + this_object()->name() + "往空一举，口中念念有词：山灵灵，地灵灵，土地老儿快显灵！\n"NOR, me);
	message_vision(HIB "\n只见一阵烟雾过后，$N咳嗽一声从地下钻了出来！\n" NOR, tudi);
//        environment(this_player())->earth_notify();
        return 1;
}
