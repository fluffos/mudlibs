inherit ITEM;
void create()
{
	set_name("符号", ({ "fuhao" }));
	set_weight(2000000);
        set("no_get", 1);
        set("no_shown", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "局");
		set("value", 70);
		set("no_shown",1);
		set("no_get",1);
		set("material", "wood");
		set("no_drop",1);
		set("skill", ([
			"name": 		"throwing",	
			"exp_required":	100000,		
			"sen_cost":		50,	
			"difficulty":	60,	
			"max_skill":	201		
		]) );
	}
}
