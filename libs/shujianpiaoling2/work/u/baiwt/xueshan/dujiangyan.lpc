inherit ROOM;

void create()
{
    set("short", "都江堰");
    set("long", @LONG
这是位于岷江上流的都江堰，由战国秦昭王时蜀郡太守李冰率众
兴建。都江堰工程主要包括鱼嘴、飞沙堰和宝瓶口。岷江汹涌，经都
江堰化险为夷，变害为利，出宝瓶口流入内江，造福农桑，使川西平
原千百年来成为“水旱从人，不知饥馑，沃野千里，世好陆海”的天
府。从这里可以眺望波涛翻滚的岷江。
LONG
    );

    set("exits", ([
        "westdown" : __DIR__"guanroad",
        "northdown" : __DIR__"farm2",
        "southdown" : __DIR__"farm1",
    ]));
        set("objects", 
        ([ //sizeof() == 1
              "/obj/npc/worker1" : 2,
        ]));
	set("hell",1);
	set("no_fight",1);
	set("no_study",1);
	set("no_magic",1);
	set("NONPC",1);
    set("outdoors", "xueshan");
    setup();
}

int valid_leave(object me, string dir)
{

        if(me->query("quest/guanfu")=="water" && me->query_temp("doing_work")<= 1)

	return notify_fail("你的工作还没有完成，怎么就想走了？\n");
	me->set_temp("doing_work", 0);
       return ::valid_leave(me, dir);
}


