inherit ROOM;
#include <room.h>
void create()
{
        set("short", "秘室");
        set("long", @LONG
这是一间石室，四面墙壁挂着几支火把。天花板上刻着横竖无数条剑痕，令人眼
花缭乱。地上深深地刻有六个脚印，都是一般大小，象是被人硬生生踩出来的。石室
的一边角落里有一块青石板，看上去沉甸甸的。石板上放着一些珍奇的灵药。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "south" : __DIR__"midong",
]));
        set("objects", ([
        __DIR__"obj/lingzhi2" : 1,
	__DIR__"obj/lotus2" : 1,
	__DIR__"obj/lurong2" : 1,
		__DIR__"obj/fl-book" : 1,
		__DIR__"obj/px-book" : 1,
                        ]) );

        setup();
//door here
        create_door("south", "石门", "north", DOOR_CLOSED);

}

void init()
{
	add_action("do_look","look");
	add_action("do_study","study");
}

int do_look(string arg)
{
	if(!arg || (arg != "剑痕" && arg != "脚印"))
	return 0;
	this_player()->add_temp("looked_jianhen",1);
	if((int) this_player()->query_temp("looked_jianhen") <= 15)
	{
	write("纵横交错的剑痕和脚印，似乎奥妙无穷．．．\n");
	return 1;
	}
	else
	{
	write("你似乎看出了一些奥妙．．学习一下吧．．\n");
	return 1;
	}
}
 
int do_study(string arg)
{
	if(!arg || (arg != "剑痕" && arg != "脚印"))
	return 0;
	if(this_player()->query_temp("looked_jianhen") <= 15)
	{
	write("纵横交错的剑痕和脚印，似乎奥妙无穷．．．\n");
	return 1;
	}
	else
	return 0;
	
}

