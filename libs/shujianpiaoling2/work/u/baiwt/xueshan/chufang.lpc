inherit ROOM;

void create() {
  set("short", "玉藕宫");
  set("long", @LONG
这是琼宫弟子用膳的玉藕宫。宫里的柱子都由白玉雕成莲藕状，样子
十分奇特而好看，不禁让人精神振奋，食欲大开。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "changl3",
    "north": __DIR__ "changl7",
  ]));
  set("objects", ([
    __DIR__ "npc/luogupo": 1,
    __DIR__ "obj/suanmei": 2,
    __DIR__ "obj/gao": 2,
  ]));
  setup();
  replace_program(ROOM);
}
