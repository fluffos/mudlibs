//雪山山脚: shanjiao.c [baiwt]

inherit ROOM;

void create() {
  set("short", "雪山山脚");
  set("long", @LONG
这里是雪山山脚, 百花绽开，泉流鸣响，恰似江南初春。抬头上望, 
雪峰耸入云天, 峰顶白云缭绕, 宛若仙境。白云深处隐约可见琼楼玉宇, 
那就是令江湖人物心驰神往的神秘的『雪山琼宫』。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "northup": __DIR__ "shanpo",
    "south": __DIR__ "huangyie1",
    "east": __DIR__ "machang",
  ]));
  setup();
  replace_program(ROOM);
}
