inherit ROOM;

void create()
{
  set("short","积霜岩");
  set("long",@LONG
这是通向雪峰峰顶的必经之路，山道被一块奇特的巨岩截断，巨岩
上面结了一层厚厚的冰霜，光可鉴人。岩石中间凿出了一条窄窄的石阶通
向山道的那一头。你已经可以感觉到从石缝中透出的一股寒气。东面是一
个小亭子，经常有两个人在那里下棋，西面是奇特的冰瀑。
LONG
     );
  set("outdoors", "xueshan");
  set("exits",([
      "northup" : __DIR__"shanlu1",
      "eastdown" : __DIR__"ya",
      "east" : __DIR__"tingzi",
      "west" : __DIR__"bingpu",
     ]));

 setup();
 replace_program(ROOM);
}