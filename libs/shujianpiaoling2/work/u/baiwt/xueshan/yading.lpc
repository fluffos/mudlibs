inherit ROOM;

void create() {
  set("short", "崖顶");
  set("long", @LONG
这是一座陡峭的山崖，峰顶漂泊的大雪被山风吹到这里，在崖上婉
转飞舞，煞是奇妙好看，故当地人称这里为[飞雪崖]。你正站在崖顶上。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "down": __DIR__ "ya",
  ]));
  set("objects", ([
    __DIR__ "obj/goldblade": 1,
    __DIR__ "obj/zhengqi_book": 1,
  ]));

  setup();
  replace_program(ROOM);
}
