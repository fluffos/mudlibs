inherit ITEM;
#include <ansi.h>
void create()
{
  set_name(HIG "化毒丹" NOR,({"huadu dan","dan"}));
  set("long", HIG
      "这是一颗能解百毒的化毒丹。\n" NOR);
  set("value",1000);
  set("unit","颗");
}

void init()
{
  if(this_player()==environment())
  add_action("do_cure","yong");
}

int do_cure()
{
	object me;
	me = this_player();
	message_vision("$N把化毒丹一口吞了下去！\n",me);
	if( !me->query("kill_player_record") )
		me->clear_condition();
	me->unconcious();
	destruct(this_object());
//	me->unconcious();
  return 1;
}
