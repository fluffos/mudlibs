inherit ITEM;
inherit F_FOOD;
void create()
{
	int	i;
        string *names = ({
                "川贝果", "枇杷果", 
        });
	i = random(2);
        set_name( names[i], ({ "guozi" }));
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一颗能治疗疾病的果子。\n");
		set("unit", "颗");
		set("value", 0);
		set("objattrib", 1);
		set("food_remaining", 1);
		set("food_supply", 10);
	}
}
