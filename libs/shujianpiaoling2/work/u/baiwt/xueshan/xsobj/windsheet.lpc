#include <ansi.h>
inherit ITEM;

void create() {
  set_name("大风云飞符", ({ "wind_sheet", "sheet" }));
  set_weight(300);
  set("unit", "块");
  set("long",
    "这是一块神奇的铁牌，上面刻着一些云层。你可以祭这块神符(blow).\n");
  set("value", 0);
}

void init() {
  add_action("do_blow", "blow");
}

int do_blow(string arg) {
  object me, target, room;
  string msg, place;
  int number;
  me = this_player();
  if (!arg)
    return notify_fail("你想对谁用符？\n");
  target = present(arg, environment(me));

  if (!environment(me)->query("outdoors"))
    return notify_fail("这里无法使用大风云飞符！\n");
  if (environment(me)->query("hell"))
    return notify_fail("这里无法使用大风云飞符！\n");

  if ((int)me->query("gin") < 70)
    return notify_fail("你的精神没有办法有效集中！\n");
  if ((int)me->query("sen") < 90)
    return notify_fail("你的精神没有办法有效集中！\n");

  if (!target->is_character() || target->is_corpse() || target == me)
    return notify_fail("大风云飞符没有起作用。\n");
  if (!userp(target))
    return notify_fail("大风云飞符被祭了起来，但是什么也没有发生。\n");
  if (!me->is_fighting(target))
    return notify_fail("大风云飞符被祭了起来，但是什么也没有发生。\n");
  me->receive_damage("gin", 60);
  me->receive_damage("sen", 70);
  number = random(12);

  if (number <= 3) {
    place = "/u/baiwt/xueshan/ya.lpc";
    message_vision(HIC "$N祭起了［大风云飞符］，口中喃喃念道：天地间的风啊，快吹起来吧！\n" NOR, me);
    msg = YEL "$N举起的神符上放出一道刺目光芒射向了云层，霎时四周狂风大作，尘砂飞扬！";
    msg += "\n一股龙卷风平地而起，呼啸着将$n的身体吹向了天空，转眼消失不见了．．\n\n" NOR;
    message_vision(msg, me, target);
    target->move(place);
    message_vision(YEL "\n一股龙卷风呼啸而过，一条人影从风中跌了下来。\n\n" NOR, target);
    destruct(this_object());
    return 1;
  }
  if (number <= 6) {
    place = "/u/baiwt/xueshan/mroad.lpc";
    message_vision(HIC "$N祭起了［大风云飞符］，口中喃喃念道：天地间的风啊，快吹起来吧！\n" NOR, me);
    msg = YEL "$N举起的神符上放出一道刺目光芒射向了云层，霎时四周狂风大作，尘砂飞扬！";
    msg += "\n一股龙卷风平地而起，呼啸着将$n的身体吹向了天空，转眼消失不见了．．\n\n" NOR;
    message_vision(msg, me, target);
    target->move(place);
    message_vision(YEL "\n一股龙卷风呼啸而过，一条人影从风中跌了下来。\n\n" NOR, target);
    destruct(this_object());
    return 1;
  }

  if (number <= 9) {
    place = "/u/baiwt/xueshan/guanroad2.lpc";
    message_vision(HIC "$N祭起了［大风云飞符］，口中喃喃念道：天地间的风啊，快吹起来吧！\n" NOR, me);
    msg = YEL "$N举起的神符上放出一道刺目光芒射向了云层，霎时四周狂风大作，尘砂飞扬！";
    msg += "\n一股龙卷风平地而起，呼啸着将$n的身体吹向了天空，转眼消失不见了．．\n\n" NOR;
    message_vision(msg, me, target);
    target->move(place);
    message_vision(YEL "\n一股龙卷风呼啸而过，一条人影从风中跌了下来。\n\n" NOR, target);
    destruct(this_object());
    return 1;
  }

  if (number <= 12) {
    place = "/u/baiwt/xueshan/ghost/huangyie3.lpc";
    message_vision(HIC "$N祭起了［大风云飞符］，口中喃喃念道：天地间的风啊，快吹起来吧！\n" NOR, me);
    msg = YEL "$N举起的神符上放出一道刺目光芒射向了云层，霎时四周狂风大作，尘砂飞扬！";
    msg += "\n一股龙卷风平地而起，呼啸着将$n的身体吹向了天空，转眼消失不见了．．\n\n" NOR;
    message_vision(msg, me, target);
    target->move(place);
    message_vision(YEL "\n一股龙卷风呼啸而过，一条人影从风中跌了下来。\n\n" NOR, target);
    destruct(this_object());
    return 1;
  }
  return 0;
}
