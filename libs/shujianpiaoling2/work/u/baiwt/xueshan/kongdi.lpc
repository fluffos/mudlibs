inherit ROOM;

void create()
{
	set("short", "山坡空地");
        set("long",@LONG
这里是一块空旷的平地，经常有一些江湖艺人到这里来舞拳弄棍，靠
卖艺维持生计。
LONG
        );
        set("outdoors", "xueshan");
	set("exits", ([
		"west" : __DIR__"shanpo",
        ]));
	set("objects",([
		__DIR__"npc/oldpig" : 1,
		__DIR__"npc/lady" : 1,
       	]));
        setup();
        replace_program(ROOM);
}