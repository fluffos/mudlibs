#include <ansi.h>

inherit ROOM;
void init();
int do_cheng(string);

void create() {
  set("short", "雪山冰川");
  set("long", @LONG
冰川的冰层，虽因受到阳光已有部分融化，但山顶的雪花，一片片轻
飘飘地下着，就好象白纸屑、水晶末一般，落到冰川之上，逐渐结晶冻结
，最后转化为冰层。所以山上的冰川，亘古不化。由于阳光的折射和散射
，整个冰层都变为浅兰色的透明体，端的是奇丽万状，难以形容。你只觉
得寒风凛冽，似乎快要将你冻僵了。要是能有东西烧来取暖该多好！
LONG
  );
  set("outdoors", "xueshan");
  set("objects", ([
    __DIR__ "npc/xianhe": 1,
    __DIR__ "npc/hufa3": 1,
    __DIR__ "obj/blade": 1,
  ]));
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("blowing", random(10) + 1, ob);
  add_action("do_cheng", "cheng");
  add_action("do_burn", "burn");
}

int blowing(object ob)

{
  int i;
  int damage;
  if (ob && environment(ob) == this_object()) {
    tell_object(this_object(), HIW "\n\n突然一股刺骨的寒风猛烈地刮来，你只觉浑身发抖，站都站不住！！\n\n" NOR);
    COMBAT_D->report_status(ob, 1);
    ob->receive_wound("kee", random(20) + 20);
    if (environment(ob) == this_object())
      call_out("blowing", random(10) + 1, ob);
  } else

    return 1;
}

int do_cheng(string arg) {
  object me = this_player(), room;
  if (me->query_temp("xueshan/allow_fly") < 4)
    return notify_fail("你要干什么？\n");

  if (!arg || arg != "仙鹤")
    return notify_fail("你要骑什么？\n");

  if (!(room = find_object(__DIR__ "shanyao4")))
    room = load_object(__DIR__ "shanyao4");

  if (!objectp(room))
    return notify_fail("ERROR:not found 'xianchou.c' \n");
  message_vision(HIW "\n$N轻轻一跃，骑到了仙鹤背上，只见白鹤引吭高鸣，驮着$N振翅飞上山去。\n", me);
  message_vision(NOR "\n", me);
  me->move(room);
  me->start_busy(1);
  return 1;
}


int do_burn(string arg) {
  object me;
  object tar;
  int score, pot;
  me = this_player();
  score = (int)me->query("combat_exp");
  pot = (int)me->query("potential");
  if (!arg || arg == "")
    return notify_fail("你烧啥东西．\n");
  tar = present(arg, me);
  if (!tar)
    return notify_fail("你身上没有这东西．\n");
  if (userp(tar))
    return notify_fail("你不可烧活的东西．\n");
  if (tar->query("owner"))
    return notify_fail("你不可烧订的东西．\n");
  if (tar->is_corpse()) {
    me->set("combat_exp", (int)score + random(30));
    me->set("potential", (int)pot + random(30));
  }
  message_vision("$N将$n点火烧起来取暖，不久$n渐渐化为灰烬．\n", me, tar);
  tar->move(environment(me));
  destruct(tar);
  return 1;
}
