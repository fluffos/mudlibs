#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("雨晴子", ({ "yu qing", "yu", "master" }));
  set("gender", "男性");
  set("age", 56);
  set("long",
    "雨晴子是铁肩道人的大弟子，在武林中已经享有很高的威望。\n");
  set("inquiry", ([
    "here": "这里就是青城派。",
  ]));
  set("attitude", "peaceful");
  set("class", "qingcheng");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 4000000);
  set("score", 40000);

  set_skill("dodge", 130);
  set_skill("move", 130);
  set_skill("literate", 150);
  set_skill("parry", 150);
  set_skill("unarmed", 150);
  set_skill("force", 150);
  set_skill("sword", 160);

  set_skill("rain_sword", 160);
  set_skill("rain_strike", 150);
  set_skill("siri_force", 150);
  set_skill("five-steps", 130);
  set_skill("dormancy", 160);

  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.pangtuo" :),
  }));

  create_family("青城派", 5, "弟子");

  setup();

  carry_object(__DIR__ "weapon/sword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
