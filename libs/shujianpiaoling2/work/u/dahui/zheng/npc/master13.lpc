#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int about_quest();

void create()
{
        set_name("张华堂", ({ "zhang huatang", "zhang" }) );
	 set("nickname","逾越剑客");
        set("gender", "男性");
        set("age", 36);
        set("long",
"张华堂主要负责办理红旗镖局的接镖护镖事宜，是邱震海的得力助手。\n" );
        set("attitude", "peaceful");
        set("str", 26);
        set("int", 22);
        set("spi", 25);
        set("per", 23);
        set("cps", 23);
        set("force", 800);
        set("max_force", 800);
        set("force_factor",20);
        set("combat_exp",800000);
	set("class", "biaoju");
        set_skill("unarmed", 90);
        set_skill("sword", 90);
        set_skill("force", 90);
        set_skill("parry", 90);
        set_skill("dodge", 90);
        set("NKreward_MASTER", 1);
	set("id_type",1);

        set_skill("three-sword",90);
        set_skill("xingyi-ken", 90);
        set_skill("taiji-force", 90);
        set_skill("tiyunzong", 90);

        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "xingyi-ken");
        map_skill("force", "taiji-force");
        map_skill("sword", "three-sword");
        map_skill("parry", "three-sword");

        create_family("红旗镖局", 3, "镖师");

        setup();

       carry_object(__DIR__"weapon/longsword")->wield();
	carry_object(__DIR__"obj/jinzhuang")->wear();
}

void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}


