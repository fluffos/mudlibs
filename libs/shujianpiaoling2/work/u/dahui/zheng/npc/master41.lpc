#include <ansi.h>

inherit NPC;

void create() {
  set_name("凌云子", ({ "tong yun", "yun", "master" }));
  set("gender", "男性");
  set("age", 43);
  set("long",
    "凌云子是永吉真人的弟子，被称为“峨眉三云”之一。\n");
  set("inquiry", ([
    "here": "这里就是峨眉派。",
  ]));
  set("attitude", "peaceful");
  set("class", "emei");
  set("str", 25);
  set("int", 22);
  set("spi", 25);
  set("per", 23);
  set("cps", 23);
  set("max_kee", 1400);
  set("max_gin", 1400);
  set("max_sen", 1400);
  set("kee", 1400);
  set("gin", 1400);
  set("sen", 1400);

  set("force", 1400);
  set("max_force", 1400);
  set("force_factor", 30);
  set("combat_exp", 4000000);
  set("score", 30000);

  set_skill("dodge", 70);
  set_skill("move", 60);
  set_skill("literate", 80);
  set_skill("parry", 90);
  set_skill("unarmed", 90);
  set_skill("force", 90);
  set_skill("sword", 60);

  set_skill("wind_sword", 60);
  set_skill("mian_strike", 100);
  set_skill("taiqing_force", 90);
  set_skill("ganchan_steps", 70);

  map_skill("dodge", "ganchan_steps");
  map_skill("unarmed", "mian_strike");
  map_skill("force", "taiqing_force");
  map_skill("parry", "wind_sword");
  map_skill("sword", "wind_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.foguang" :),
  }));
  create_family("峨眉派", 6, "弟子");

  setup();

  carry_object(__DIR__ "weapon/sword");
  carry_object(__DIR__ "obj/daopao")->wear();
}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
