// servant.c
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("金振夫", ({ "jin zhenfu", "jin" }));
  set("nickname", HIC "七灵剑" NOR);
  set("gender", "男性");
  set("age", 34);
  set("attitude", "peaceful");
  set("combat_exp", 4000000);
  set("score", 20000);
  set("class", "kongtong");

  set("str", 60);
  set("int", 30);
  set("cor", 30);
  set("cps", 30);
  set("con", 30);

  set("force", 4000);
  set("max_force", 2200);
  set("force_factor", 30);

  set("inquiry", ([
    "武学": "武学之道....嗯....只可意会，不可言喻。\n",
  ]));

  create_family("崆峒派", 7, "掌门");

  set_skill("unarmed", 200);
  set_skill("sword", 190);
  set_skill("force", 190);
  set_skill("parry", 190);
  set_skill("dodge", 190);
  set_skill("literate", 190);
  set_skill("qxxl-sword", 190);
  set_skill("jzxj-force", 190);
  set_skill("five-spin", 190);
  set_skill("move", 200);

  map_skill("sword", "qxxl-sword");
  map_skill("parry", "qxxl-sword");
  map_skill("force", "jzxj-force");
  map_skill("dodge", "five-spin");
  map_skill("move", "five-spin");
  setup();

  carry_object(__DIR__ "weapon/sword")->wield();
  carry_object(__DIR__ "obj/jinzhuang")->wear();
}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
