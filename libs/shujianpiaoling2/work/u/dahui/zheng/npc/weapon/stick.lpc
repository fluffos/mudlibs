#include <ansi.h>

#include <weapon.h>

inherit STICK;

void create()
{
      string *order1 = ({"勇敢", "神圣", "荣耀", "祝福", "凯旋", "幻影", "乙木","空冥",
"正义", "胜利", "蟒蛇", "巨龙", "火焰", "神水", "土行", "天雷", "地狱", "太古", "追风" });
	string *order2 = ({"战士", "武士", "上人", "王者", "圣者",
"大师", "大士", "郎君", "侠客", "使者"});
	string *order3 = ({"金棍", "银棍", "铜棍", "铁棍", "双截棍", "铁戈", "锡棍",
"三节棍", "哭丧棒", "木棍", "竹棍"});
      set_name( HIC + order1[random(18)] + order2[random(9)]+ HIG+ order3[random(10)]+ NOR, ({ "stick" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "这是一把看起相当普通的木棍");
		set("m_ap_rank",7);
		set("m_dp_rank",7);
		set("value", random(7)*random(100)*100 + 1000);
                set("material", "wood");
        }
        init_stick(random(90)+10);

// These properties are optional, if you don't set them, it will use the
// default values.

        set("wield_msg", "$N把$n紧紧地握在手中。\n");
        set("unwield_msg", "$N松开了手中的$n。\n");

// The setup() is required.

        setup();
}
