// magic_weapon  created by Baiwt@Sjpl 07/11/1999
#include <ansi.h>

#include <weapon.h>

inherit HAMMER;

void create() {
  string *order1 = ({ "勇敢", "神圣", "荣耀", "祝福", "凯旋", "幻影", "乙木", "空冥",
    "正义", "胜利", "蟒蛇", "巨龙", "火焰", "神水", "土行", "天雷", "地狱", "太古", "追风" });
  string *order2 = ({ "战士", "武士", "上人", "王者", "圣者",
    "大师", "大士", "郎君", "侠客", "使者" });
  string *order3 = ({ "金锤", "银锤", "铜锤", "铁锤", "子母环", "金刚杵", "流星锤",
    "铅锤", "钢锤", "木锤", "锯齿轮", "闪电鎚", "方锤" });
  set_name(
    HIC + order1[random(18)] + order2[random(9)] + HIG + order3[random(12)] + NOR,
    ({ "hammer" })
  );
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把沈重的铁锤，打造的相当坚实。\n");
    set("m_ap_rank", 6);
    set("m_dp_rank", 6);
    set("value", random(6) * random(100) * 100 + 1000);
    set("material", "iron");
    set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_hammer(random(90) + 10);
  setup();
}
