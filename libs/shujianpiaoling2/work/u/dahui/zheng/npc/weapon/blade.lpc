// magic_weapon  created by Baiwt@Sjpl 07/11/1999
#include <ansi.h>

#include <weapon.h>

inherit BLADE;

void create() {
  string *order1 = ({ "勇敢", "神圣", "荣耀", "祝福", "凯旋", "幻影", "乙木", "空冥",
    "正义", "胜利", "蟒蛇", "巨龙", "火焰", "神水", "土行", "天雷", "地狱", "太古", "追风" });
  string *order2 = ({ "战士", "武士", "上人", "王者", "圣者",
    "大师", "大士", "郎君", "侠客", "使者" });
  string *order3 = ({ "金刀", "银刀", "铜刀", "铁刀", "锡刀", "大环刀", "柳叶刀",
    "雁翎刀", "钢刀", "木刀", "竹刀", "偃月刀" });
  set_name(
    HIC + order1[random(18)] + order2[random(9)] + HIG + order3[random(12)] + NOR,
    ({ "blade" })
  );
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("m_ap_rank", 4);
    set("m_dp_rank", 4);
    set("value", random(4) * random(100) * 100 + 1000);
    set("material", "iron");
    set("long", "这是一寻常的单刀，份量大约六、七斤重。\n");
    set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  init_blade(random(90) + 10);
  setup();
}
