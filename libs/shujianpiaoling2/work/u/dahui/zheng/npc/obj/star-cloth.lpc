// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
	set_name(BLU "七星道袍" NOR, ({ "star-cloth","cloth" }) );
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 5000);
		set("material", "cloth");
		set("armor_prop/armor", 30);
	}
	setup();
}
