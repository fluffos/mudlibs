#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_baohu();
void create()
{
	set_name("宁静真人", ({ "master ningjing", "ningjing", "master" }));
	set("title", "武当派掌门");
	set("gender", "男性");
	set("age", 70);
//	set("nickname", HIG "" NOR);
        set("long",
"宁静真人是武当派继开山祖师张三丰后最杰出的掌门，他的武功才智在武林中\n"
"都算是超一流人物。近年武当重震声威，就是全赖宁静的英明领导。\n"  );
	set("attitude", "peaceful");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("class", "wudang");

	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);

        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);

        set("combat_exp", 9000000);
        set("score", 50000);
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);
	set_temp("apply/move", 30);

        set_skill("move", 240);
        set_skill("dodge", 250);
        set_skill("literate", 230);
        set_skill("unarmed", 250);
        set_skill("parry", 250);
        set_skill("force", 250);
        set_skill("sword", 250);

        set_skill("taiji-sword",250);
        set_skill("taiji-ken", 250);
        set_skill("taiji-force", 250);
        set_skill("tiyunzong", 250);

        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-ken");
        map_skill("parry", "taiji-sword");
        map_skill("force", "taiji-force");
        map_skill("sword", "taiji-sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "sword.chan" :),
                (: perform_action, "sword.fengbi" :),
        }) );
        set("inquiry", ([
                "随行" : (: about_baohu :),
        ]) ); 

        create_family("武当派", 4, "掌门");

	setup();
        carry_object(__DIR__"obj/youlong_sword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}

void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}

