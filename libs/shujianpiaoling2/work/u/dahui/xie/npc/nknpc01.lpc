void create()
{
        set_name((mname[random(206)] + chinese_number(random(19))), ({ "dizi","wulin renshi" }) );
        set("gender", "男性" );
        set("age", random(40)+10);
	set("combat_exp", (random(90)*random(10)+1)*10000);
	set("title",mtitle[random(17)] );
        set("str", 60);
        set("cor", 30);
	set("env/wimpy", 10);
        set("potential", 10);
        set("NKreward_NPC", 1);
        set("attitude", "heroism");
        set("gin", random(500)+300);
        set("kee", random(500)+300);
        set("sen", random(500)+300);
	set("max_force",1000);
	set("force",2000);
	set("force_factor",10);
	set("atman",500);
	set("mana",600);	
        set("last_load_time", uptime());
        set("chat_chance", 50);
        set("chat_msg", ({
		(: random_move :),
		(: custom :)	
        }) );
        set_skill("force", random(100)+100);
        set_skill("unarmed", random(100)+100);
        set_skill("parry", random(100)+100);
        set_skill("dodge", random(100)+100);
        set_skill("move", random(100)+100);
        set_skill("literate", random(100)+100);
	  set_temp("apply/damage", random(100)+50);	
	  set_temp("apply/armor", random(30)+20);	
        
        switch(this_object()->query("title")) {
                case "普通百姓": 
		{
		set("id_type", 0);
		set_skill("ding-dodge", random(100)+50);
		set_skill("bai-quan", random(100)+50);
		map_skill("unarmed", "bai-quan");
		map_skill("dodge", "ding-dodge");
		set("perform_msg","$N使出白家拳的绝招“忆苦思甜”，向$n攻来！");
		break;
		}
                case "塔尔寺弟子": 
		{
		set("id_type", 2);
		set_skill("yixing_huanwei", random(100)+50);
		set_skill("tianzhu_finger", random(100)+50);
		map_skill("unarmed", "bai-quan");
		map_skill("dodge", "yixing_huanwei");
		set("perform_msg","$N使出喇嘛教天竺佛指的绝招“佛在心头”，向$n攻来！");
		break;
		}
                case "魔教弟子": 
		{
		set("id_type", 2);
		set_skill("huashu-steps", random(100)+50);
		set_skill("wusha-strike", random(100)+50);
		map_skill("unarmed", "wusha-strike");
		map_skill("dodge", "huashu-steps");
		set("perform_msg","$N使出魔教五煞神掌的绝招“五煞离魂”，向$n攻来！");
		break;
		}
                case "披麻教教徒": 
		{
		set("id_type", 2);
		set_skill("jiangshi-steps", random(100)+50);
		set_skill("black_claw", random(100)+50);
		map_skill("unarmed", "black_claw");
		map_skill("dodge", "jiangshi-steps");
		set("perform_msg","$N使出披麻教黑煞四十九爪的绝招“腥风血雨”，向$n攻来！");
		break;
		}
                case "海鲸帮帮众": 
		{
		set("id_type", 2);
		set_skill("dragon-steps", random(100)+50);
		set_skill("dragon_strike", random(100)+50);
		map_skill("unarmed", "dragon_strike");
		map_skill("dodge", "dragon-steps");
		set("perform_msg","$N使出海鲸帮龙舞九天手的绝招“龙门鼓浪”，向$n攻来！");
		break;
		}
                case "饿鬼帮帮众": 
		{
		set("id_type", 2);
		set_skill("ding-dodge", random(100)+50);
		set_skill("sanlianhuan", random(100)+50);
		map_skill("unarmed", "sanlianhuan");
		map_skill("dodge", "ding-dodge");
		set("perform_msg","$N使出饿鬼帮鬼蜮秘技的绝招“鬼影现形”，向$n攻来！");
		break;
		}
                case "枯骨寺弟子": 
		{
		set("id_type", 2);
		set_skill("jiangshi-steps", random(100)+50);
		set_skill("yimu-strike", random(100)+50);
		map_skill("unarmed", "yimu-strike");
		map_skill("dodge", "jiangshi-steps");
		set("perform_msg","$N使出枯骨寺乙木旋风掌的绝招“旋风乙”，向$n攻来！");
		break;
		}
                case "振远镖局镖师": 
		{
		set("id_type", 3);
		set_skill("chaos-steps", random(100)+50);
		set_skill("yuanyang_tui", random(100)+50);
		map_skill("unarmed", "yuanyang_tui");
		map_skill("dodge", "chaos-steps");
		set("perform_msg","$N使出鸳鸯连环腿的绝招“连环踢”，向$n攻来！");
		break;
		}
                case "朝廷兵部将领": 
		{
		set("id_type", 4);
		set_skill("chaos-steps", random(100)+50);
		set_skill("xingyi-ken", random(100)+50);
		map_skill("unarmed", "xingyi-ken");
		map_skill("dodge", "chaos-steps");
		set("perform_msg","$N使出形意拳法的绝招“如影随行”，向$n攻来！");
		break;
		}
                case "朝廷刑部捕快": 
		{
		set("id_type", 5);
		set_skill("chaos-steps", random(100)+50);
		set_skill("liuh-ken", random(100)+50);
		map_skill("unarmed", "liuh-ken");
		map_skill("dodge", "chaos-steps");
		set("perform_msg","$N使出八卦掌法的绝招“霸王举鼎”，向$n攻来！");
		break;
		}

		default :
		{
		set("id_type", 2);
		set_skill("ding-dodge", random(100)+50);
		set_skill("bai-quan", random(100)+50);
		map_skill("unarmed", "bai-quan");
		map_skill("dodge", "ding-dodge");
		set("perform_msg","$N使出白家拳的绝招“忆苦思甜”，向$n攻来！");
		}

                }

        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
		(: perform_more(this_object()) :),
        }) );

        setup();
        carry_object("/obj/cloth/belt")->wear();
        carry_object("/obj/cloth/jinzhuang")->wear();
}

