inherit ROOM;

void create()
{
	set("short", "石牛古洞");
        set("long",@LONG
这里是石牛古洞，洞里曲折不平，加上阴暗潮湿。实在让人看不清楚
景物，洞中偶尔轻轻的传来水滴声。
LONG
        );
        set("exits", ([
		"north" : __DIR__"gudong6",
		"west" : __DIR__"gudong3",
        ]));
        set("no_clean_up",0);
        setup();
        replace_program(ROOM);
}
