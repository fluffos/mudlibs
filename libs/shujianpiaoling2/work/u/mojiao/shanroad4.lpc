//shanroad4.c written by john darks
inherit ROOM;
void create()
{
	set("short", "洞外山路");
        set("long",@LONG
山路随着山势延伸，山间一道清流从山石后面流了出来，不知道和哪
里的小溪汇了起来，滑过河床向山下奔去。水声哗哗作响，给青山又添一
份翠意。小路被这股好水隔断了起来。河对面小路又在山中延伸了起来。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"westup" : __DIR__"tiesuo",
		"south" : __DIR__"gudong10",
        ]));
        set("resource/water",1);
        set("item_desc", ([
                "water": 	"一道清澈的小溪，溪水一定可以喝的。\n",
                "小溪":		"一道清澈的小溪，溪水一定可以喝的。\n",
	]));
	set("objects", ([
                __DIR__"npc/dizi5000" : 4,
       	]) );
        set("no_clean_up",0);
        setup();
}

void init()
{	
	object ob;
	if( interactive( ob = this_player()) && ob->query_temp("wangsha/wfrom")=="south"){
		set ("long", @LONG
山路随着山势延伸，山间一道清流从山石后面流了出来，不知道和哪
里的小溪汇了起来，滑过河床向山下奔去。水声哗哗作响，给青山又添一
份翠意。小路被这股好水隔断了起来。河对面小路又在山中延伸了起来。
LONG);	
	}else{
		set ("long", @LONG
一过铁索桥，前面立刻传来流水声，一道清泉自山石后面流了出来，
不知道和哪里的小溪汇了起来，滑过河床向山下奔去。水声哗哗作响，给
青山又添一份翠意。小路被这股好水隔断了起来。和对面是一壁山崖，崖
下细石铺路通一个小山洞。
LONG);
	}
	add_action("do_drink",({"drink","喝"}));
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "westup" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}

int do_drink(string arg)
{
        int current_water;
	int max_water;
        object me;
        me = this_player();
        if (!arg || (arg!="water" && arg!="小溪")) return 0;
        current_water = me->query("water");
        max_water = (int)me->max_water_capacity();
        if (current_water <= max_water - 30) {
            	me->add("water", 30);			//喝水
            	message("vision", me->name()+"趴在山溪边用手捧了些水喝。\n", environment(me), ({me}) );
            	write("你喝了一口从山上流淌下来的溪水，简直比蜜还甜。\n");
        }
        else write("逮着不要钱的水就这么喝，至于吗?\n");
        return 1;
}
