//qimeng1.c written by john darks
inherit ROOM;
void create()
{
        set("short", "紫铜庄门");
        set("long", @LONG
一扇紫铜镶边的庄门虚掩着。门上扎着一个紫铜风铃。门随风开合，
风铃发出断断续续的叮咚之声。门上隶书一行：
               梦  中  人  生
LONG
        );
        set("exits", ([
                "northeast":__DIR__"qimeng2",
        ]));
        set("outdoors", "tianzhu");
        setup();

}

void init()
{
        add_action("do_break","break");
}

int valid_leave(object me, string dir)
{
        if(userp(me) && dir == "northeast"){
                if( me->query_temp("mojiao/baochou")==4 ||
                         me->query_temp("mojiao/qimeng")==1 ){
                        me->set_temp("wangsha/wfrom","south");
                        return 1;               
                }else
                        return notify_fail("大门忽然关了起来，你过不去了。\n");
        }
        return 1;
}

int do_break(string arg)
{
        object me = this_player();
        if (arg!="door") return 0;
        if (me->query_temp("mojiao/baochou")==4){
                write("大门随风开合，不必打破它。\n");
                return 1;
        }else {
                message_vision("只见$N气沉丹田，一个坐马立裆式，一掌击向大门。\n",me);
                message_vision("只听彭的一声，大门被击开了。\n",me);
                me->set_temp("mojiao/qimeng",1);
                return 1;
        }
        return 1;
}


