//guanyin.c written by john darks
inherit ROOM;
void create() {
  set("short", "观音峰");
  set("long", @LONG
这座山峰真的很奇怪，与别的峰有很不同的地方。这里的峰顶上四周
都是绿草丛生。在这里的所有的植物都显得格外的生机勃勃。这里虽然高，
但是却是带着一股热气。原来在有的地方有温泉的暗泉眼。如此高的地方
竟然能有温泉，真是令人费解。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "northeast": __DIR__ "river",
    "southdown": __DIR__ "jishi",
  ]));
  set("objects", ([
    __DIR__ "npc/libo": 1,
    __DIR__ "npc/suncan": 1,
    __DIR__ "npc/zhaoai": 1,
    __DIR__ "npc/tiantuo": 1,
  ]));
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "northeast") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
void reset() {
  object ob, *inv;
  int i;
  ::reset();
  ob = present("li bo", this_object());
  inv = all_inventory();
  if (ob) {
    ob->dismiss_team();
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("id") == "sun can")
        ob->add_team_member(inv[i]);
      if (inv[i]->query("id") == "zhao ai")
        ob->add_team_member(inv[i]);
      if (inv[i]->query("id") == "tian tuo")
        ob->add_team_member(inv[i]);
    }
  }
}
