//qimeng4.c written by john darks
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "庄后小路");
        set("long", @LONG
两边花丛丛树葱葱，一片逸人景象。树叶偶尔随风飘舞，盘旋落下。
又偶尔一两声茑叫，划破宁静。
LONG
        );
        set("exits", ([
                "north":__DIR__"qimeng5",
                "southeast" : __DIR__"bedroom3",
        ]));
        set("objects", ([
                __DIR__"npc/bird" : 1,
                __DIR__"npc/mei":1,
        ]));
        set("outdoors", "tianzhu");
        setup();

}

void init()
{
        if(interactive(this_player()))
        {
                remove_call_out("dropleaf");
                call_out("dropleaf",random(10)+10,this_player());
        }
}


int valid_leave(object me, string dir)
{
        object ob;
        if( userp(me))  
        if( dir == "north" )
        {
                ob = present("mei",this_object());
                if (objectp(ob) && living(ob)){
                        message_vision("$N大喝一声：往哪里走！！\n",ob);
                        tell_object(me,HIR"出路被"+ob->name()+"挡住了！\n"NOR);
                        return notify_fail("\n");
                }else{
                        me->set_temp("wangsha/wfrom","south");
                        return 1;
                }
        }
        else
        {
                me->set_temp("wangsha/wfrom","north");
                return 1;
        }
        return 1;
}

void dropleaf(object me)
{
        object leaf;
        if(me)
        if(environment(me) == this_object())
        {
                tell_object(me,"一片树叶随风飘下．．．．\n");
                leaf = present("leaf",this_object());
                if (objectp(leaf))
                        leaf->add_amount(1);
                else {
                        leaf = new(__DIR__"obj/leaf");
                        leaf->move(this_object());      
                }
                call_out("dropleaf",random(10)+10,me);
        }
}


