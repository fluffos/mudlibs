inherit ROOM;
void create()
{
	set("short", "飞来峰");
        set("long",@LONG
一条青石路蜿蜒的向着山上延伸着。四周安静的很，鸟儿在你的周围
快乐的鸣叫着。四周绽开着鲜艳的野花。五彩斑斓的令人神迷。远离了世
俗的纷争，这里如同是极乐之地一般。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"southdown" : __DIR__"dingxinshi",
		"northup" : __DIR__"xuantian",
        ]));
         set("objects", ([
                __DIR__"npc/dizi50000" : 2,
        ]));
        setup();
        replace_program(ROOM);
}
