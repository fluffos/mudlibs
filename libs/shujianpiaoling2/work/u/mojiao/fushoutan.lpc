#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "伏兽坛");
        set("long",@LONG
这里是黄色祭坛的中央，坛上的石头上按照东南西北四个方向，刻着
四样神物。看起来好像分别是青龙、白虎、朱雀、玄武，但是与世人传说
中的样子又不是那么相似。石头的四圈上还有许许多多的石刻动物，将那
四样神物围绕起来。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northwest" : __DIR__"zhulin2",
		"southeast" : __DIR__"zhulin1",
        ]));
/*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
        setup();
        replace_program(ROOM);
}
