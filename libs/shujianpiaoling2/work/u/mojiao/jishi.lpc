inherit ROOM;
void create()
{
	set("short", "鸡鸣石");
        set("long",@LONG
这里是个小拐弯，鸡鸣石就在这里。据说有只神鸡为了让天下万民不
被九个太阳烧死。每当九日驾车出巡的时候就引颈长鸣，后被天神化为石
头落下凡间。据说每天早上第一缕阳光就会照到这块儿石头上。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northup" : __DIR__"guanyin",
		"west" : __DIR__"shanlu2",
        ]));
        set("objects", ([
                __DIR__"npc/dizi12000" : 2,
       	]) );
        set("no_clean_up",0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "northup" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}
