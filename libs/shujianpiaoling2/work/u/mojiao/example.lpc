#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "小道");
        set("long",@LONG
一条小道蜿延曲折地通向远方, 两旁是郁郁葱葱的树林，微风吹过，
树叶发出奚索的声音
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"north" : __DIR__"men3",
		"south" : __DIR__"xiaodao1",
        ]));
/*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
        setup();
        replace_program(ROOM);
}
