inherit ROOM;
void create()
{
	set("short", "石牛古洞");
        set("long",@LONG
这里是石牛古洞，洞里曲折不平，加上阴暗潮湿。实在让人看不清楚
景物，远处似乎隐隐传来人走动的脚步声。
LONG
        );
        set("exits", ([
		"east" : __DIR__"gudong3",
		"north" : __DIR__"gudong7",
        ]));
        set("no_clean_up",0);
        setup();
        replace_program(ROOM);
}
