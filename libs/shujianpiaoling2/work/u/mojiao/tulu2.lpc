inherit ROOM;
void create()
{
        set("short", "黄土路");
        set("long", @LONG
一条黄土铺就的大路，两旁的白杨渐渐稀少，间或有几棵灌木，这里可以
看见不远处的天柱山。天柱山地势险要，在这里已经可以看出大概了。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
            "west" : __DIR__"tulu1",
            "northwest" : __DIR__"shanjiao1",
            "northeast" : __DIR__"shanjiao2",
]));

	set("outdoors","tianzhu");
	set("no_clean_up", 0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "west" )
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	return 1;
}