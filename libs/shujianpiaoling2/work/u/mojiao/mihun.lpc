#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "紫松林");
  set("long", @LONG
这座山峰真的很奇怪，与别的峰有很不同的地方。这里的峰顶上四周
都是绿草丛生。在这里的所有的植物都显得格外的生机勃勃。这里虽然高，
但是却是带着一股热气。原来在有的地方有温泉的暗泉眼。如此高的地方
竟然能有温泉，真是令人费解。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "eastdown": __DIR__ "songlin2",
  ]));
  set("objects", ([
    __DIR__ "npc/jiruyu": 1,
    __DIR__ "npc/dizi2000": 2,
  ]));
  setup();
  replace_program(ROOM);
}
