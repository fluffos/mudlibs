//downriver.c written by john darks
inherit ROOM;
void create()
{
	set("short", "谷中");
        set("long",@LONG
谷地到这里忽然围拢，山河在这里突然没入山间，成为地下河。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northeast" : __DIR__"pubu1",
        ]));
        set("resource/water",1);
        set("no_clean_up",0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "northeast" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}

void init()
{	
	add_action("do_dive","dive");
}

int do_dive(string arg)
{
	if (!arg || (arg!="水潭" && arg!="swag"))
		return 0;
	message_vision("$N吸了口气，一头扎下了水潭！\n",this_player());
	this_player()->move(__DIR__"downriver3");
	message("vision",this_player()->name()+"跳入了水潭来！\n",environment(this_player()),this_player());
	return 1;
}