#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "天柱峰顶");
        set("long",@LONG
小路曲折蜿蜒。青竹翠绿，松柏丛生。在这山间小路漫步，走着走着
不觉得就豪意大发起来。“竹杖芒鞋轻胜马，谁怕？一簑烟雨任平生。”
脚下的步伐也轻快了起来。向上延伸的青石路在这里拐了个弯，朝着一个
巨大的宫殿延伸过去。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"westdown" : __DIR__"tianzhu1",
		"north" : __DIR__"tianmo/zhengyang",
        ]));
/*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
        setup();
        replace_program(ROOM);
}
