inherit ROOM;
void create() {
  set("short", "风劈石");
  set("long", @LONG
这里是幽冥亭旁边的一块儿巨石，此石传说是被风神试法力的时候所
劈的。这石头被劈成了一道近两尺的大口子。真乃天公造化。在这石头旁，
不知道什么人放了另外一块儿差不多的巨石，方方正正的。但是上面也有
个口子。但是好像比那块儿要浅上四五寸。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "south": __DIR__ "youming",
  ]));
  setup();
  replace_program(ROOM);
}
