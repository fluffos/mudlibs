#include <ansi.h>
#include <weapon.h>
#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif
void create() {
  set_name(CYN "指环儿" NOR, ({ "zhihuan" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("material", "stone");
    set("long", "八魔之一。一个小巧的指环儿，上面刻着一个青面怪兽的头像。\n");
    set("weapon_prop/damage", 75);
    set("flag", SECONDARY);
    set("skill_type", "unarmed");
  }
  set("wield_msg", "$N从怀中摸出一个$n带在手上。\n");
  set("unwield_msg", "$N将手上的$n拿下来藏入怀中。\n");
  seteuid(getuid());
  setup();
}


void init() {
  add_action("do_du", "du");
  add_action("do_du", "study");
}

int do_du(string arg) {
  object me = this_player();
  object ob;
  string book;
  int level, sena;

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }
  if (me->is_busy()) {
    write("你上一个动作还没有完成，不能研读新知。\n");
    return 1;
  }
  if (!arg || sscanf(arg, "%s %d", book, sena) != 2) {
    write("指令格式：study <物品> <神数量>\n");
    return 1;
  }
  if (!objectp(ob = present(book, me))) {
    return 0;
  }
  if (!me->query_skill("literate", 1)) {
    write("你看不懂耶．．，先学学识字吧。\n");
    return 1;
  }
  level = me->query_skill("bamohuantian", 1);
  if (level < 100) {
    write("你看了半天，结果什么也没看懂。\n");
    return 1;
  }
  if ((int)me->query("combat_exp") < (int)level * level * level / 2) {
    write("你的实战经验不足，再怎么读也没用。\n");
    return 1;
  }
  if (sena < 20) {
    write("你至少要花二十点神\n");
    return 1;
  }
  if (me->query("sen") < sena) {
    write("你现在过於疲倦，无法专心下来研读。\n");
    return 1;
  }
  if (level < 150) {
    me->receive_damage("sen", sena);
    write("你研读指环儿上的图案字符，颇有心得。\n");
    me->improve_skill("bamohuantian", (int)me->query_skill("literate", 1) / 5 + sena);
    return 1;
  } else {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }
}
