//gudong8.c written by john darks
inherit ROOM;
void create()
{
	set("short", "石牛古洞");
        set("long",@LONG
这里是石牛古洞，洞里曲折不平，加上阴暗潮湿。实在让人看不清楚
景物，四周越发静寂。
LONG
        );
        set("exits", ([
		"west" : __DIR__"gudong10",
		"south" : __DIR__"gudong6",
        ]));
        set("no_clean_up",0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "west" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}

