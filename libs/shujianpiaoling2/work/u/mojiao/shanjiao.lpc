// Room: /d/snow/m-road3.c

inherit ROOM;
int valid_leave(object me,string dir);

void create()
{
	set("short", "天柱山脚");
	set("long", @LONG
这里是天柱山脚，北面是一条大道，一直通往茅山。东西两边都是山路。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "eastup" : __DIR__"w-road1",
  "north" :  __DIR__"n-road1",
]));
	set("objects",([
		__DIR__"npc/jiaotu":4,
	]));

	set("no_clean_up", 0);

	setup();
}
int valid_leave(object me, string dir)
{
	if (dir == "eastup" ) {
        if (!objectp(present("bai weitang", environment(me))))
	return notify_fail("一股罡气挡住了你。\n");
        }   
        return ::valid_leave(me, dir);
}
