//yadi.c written by john darks
inherit ROOM;
void create()
{
	set("short", "瀑布");
        set("long",@LONG
一道瀑布自天际直泻而下，画出一道银色的屏障。水声风声交织在一
起，格外的壮丽。瀑布在谷的中央形成了一个水潭，清水泱泱。阳光在水
面荡漾间，映出瀑布的中间似乎有个黑黑的影子。山崖间长满了藤条树枝，
也许这里是唯一爬出深谷的机会了。
LONG
        );
        set("exits", ([
        	"south": __DIR__"road01",
        ]));
	set("outdoors", "tianzhu");
        setup();
}

void init()
{	
	add_action("do_climb","climb");
	add_action("do_rush","rush");
	add_action("do_dive","dive");
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "south" )
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	return 1;
}

int do_climb(string arg)
{
	if (!arg || arg!="up")
		return 0;
	message_vision("$N抓住藤条，奋力向上爬去！\n",this_player());
	this_player()->move(__DIR__"yixiantian");
	message_vision("$N狼狈的爬上了来！\n",this_player());
	return 1;
}

int do_rush(string arg)
{
	if (!arg || (arg!="瀑布" && arg!="waterfull"))
		return 0;
	message_vision("$N吸了口气，奋力向瀑布冲去！\n",this_player());
	if(random(2)){
		message_vision("$N居然冲进了瀑布里面！\n",this_player());
		this_player()->move(__DIR__"pubu2");
		message("vision",this_player()->name()+"从外面冲了进来！\n",environment(this_player()),this_player());
	}
	else {
		message_vision("$N被瀑布冲了开来！\n",this_player());
		this_player()->receive_damage("kee",100,this_player());
		COMBAT_D->report_status(this_player());
	}
	return 1;
}

int do_dive(string arg)
{
	if (!arg || (arg!="水潭" && arg!="swag"))
		return 0;
	message_vision("$N吸了口气，一头扎下了水潭！\n",this_player());
	this_player()->move(__DIR__"downriver2");
	message("vision",this_player()->name()+"跳入了水潭来！\n",environment(this_player()),this_player());
	return 1;
}