//shemi3.c written by john darks
inherit ROOM;
void create() {
  set("short", "神秘谷");
  set("long", @LONG
山路在谷中曲折前进，四周烟气弥漫，你也只能分清个前后左右，但
是究竟哪里是东，哪里是西，你自己恐怕再也难分清楚。可谓坎坷。此时
前面的路忽然被阻，一块塌下来的山石隔断了出路。在山石的下方有一个
黑乎乎的石洞，洞前足迹重重，显然常有人走动。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "shenmi2",
  ]));
  set("item_desc", ([
    "hole": "虽然洞口不大，却也足以一个人弯腰而行。看来完全可以钻(enter)进去。\n",
    "石洞": "虽然洞口不大，却也足以一个人弯腰而行。看来完全可以钻(enter)进去。\n",
  ]));
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()) && ob->query_temp("wangsha/wfrom") == "south") {
    set("long", @LONG
山路在谷中曲折前进，四周烟气弥漫，你也只能分清个前后左右，但
是究竟哪里是东，哪里是西，你自己恐怕再也难分清楚。可谓坎坷。此时
前面的路忽然被阻，一块塌下来的山石隔断了出路。在山石的下方有一个
黑乎乎的石洞，洞前足迹重重，显然常有人走动。
LONG);
  } else {
    set("long", @LONG
走出地洞，已经置身于一个幽谷之中，烟气弥漫，阴风嗖嗖。让人感
到很不舒服。不过比起刚才的杀戮之气，算是轻松过了。
LONG);
  }
  add_action("do_enter", "enter");
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "southwest") {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    }
  return 1;
}

int do_enter(string arg) {
  object me;
  object room;
  if (!arg && arg != "hole" && arg != "石洞")
    return 0;
  me = this_player();
  message_vision("$N一弯腰，奔入了石洞。\n", me);
  room = find_object(__DIR__ "didong1");
  if (!room) room = load_object(__DIR__ "didong1");
  if (room) {
    me->move(room);
    me->set_temp("wangsha/wfrom", "south");
    message("vision", me->name() + "走了过来。\n", environment(me), me);
    return 1;
  } else return 0;
}
