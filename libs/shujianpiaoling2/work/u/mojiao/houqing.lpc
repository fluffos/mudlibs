inherit ROOM;
#include <ansi.h>
void create()
{
  set("short","魔极大殿");
  set("long",@LONG
这是魔教总坛的议事厅魔极大殿。殿正中墙壁上挂着一幅大大的
“魔”字，教中四大神坛的法器都排列两旁，中央一张玉石椅，椅背
上雕刻着一个长有九条臂膀的壮汉，神威凛凛，栩栩如生。整个大殿
肃极无声，却处处升腾起强烈的杀气。殿门两旁石柱上刻有一副对联
：无极无道道非道，是幻是魔魔非魔。
LONG
  );
  set("exits",([
         "north":__DIR__"tongting.lpc",
         "south":__DIR__"tiankuang.lpc",
         "east" :__DIR__"peiqing1.lpc",
         "west" :__DIR__"peiqing2.lpc",
               ]));
        set("item_desc", ([
                "九臂魔君": "
九臂魔君高六尺，型貌活灵活现，宛如真人一般。\n",
        ]) );
  setup();
}
