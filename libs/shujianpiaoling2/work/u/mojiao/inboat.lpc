//inboat.c  written by john darks
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "扁舟中");
        set("long", @LONG
舱中光线昏暗，船头站着一个白发苍苍的老妇人，她年龄虽已老迈，但站在动
荡的船头上，强劲的山风间，身子却仍挺得笔直，似是一生从未曾弯曲过。
LONG
        );
        set("objects",([
        	__DIR__"npc/boater" : 1,
		]));
	set("outdoors","tianzhu");
	set("no_magic",1);
	set("no_sleep",1);
	set("no_fight",1);
	setup();
}   

void init()
{
	add_action("do_fight","kill");
}

int do_fight(string arg)
{
	object room;
	object ob = this_player();
	object me = present("old boater",this_object());
	if (!me || arg!="old boater")
		return 0;
	message_vision(CYN"$N冷冷一笑，对$n道："+RANK_D->query_rude(ob)+"，\n我早就知道你贼眉鼠眼，不是个好东西。你下去吧！\n"NOR,me,ob);
	message_vision(CYN"$N右脚轻轻一踩船舷，扁舟立刻一晃，$n怪叫一声，跌入了河中。\n"NOR,me,ob);
	if (!objectp(room = find_object(__DIR__"inriver2")))
		room = load_object(__DIR__"inriver2");
		ob->move(room);
		message("vision",ob->name()+"扑通一声跌了下来。\n",room,ob);
	return 1;
}
