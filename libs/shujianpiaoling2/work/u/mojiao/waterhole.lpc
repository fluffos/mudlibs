//waterhole.c written by john darks
#include <ansi.h>
inherit ROOM;
void remove_dazuo(object me,string *name);
void create()
{
	object con,cloth,blade,letter;
	set("short", "神秘水洞");
        set("long",@LONG
一条水流静静的在水洞旁流过，一个精致的水流器每每发出“嗒哒”
的声音，似乎依旧这样的转动下去。石洞不是很大，却空气新鲜，视线
明亮。在靠东的地方有一块石头，光整异常，隐隐有异光显现。在石头
上还躺着一具骸骨，从遗骨上看，此人生前似乎只有七指。石头的左边，
是一面光滑的石壁，映着水光，上面刻满了密密麻麻的字。水洞的洞顶
长满了倒吊兰，发出淡淡的幽香。
LONG
        );
        set("exits", ([
        	"westdown": __DIR__"downriver4",
        ]));
         set("item_desc", ([
                "倒吊兰": "一朵发出淡淡幽香的倒吊兰，拔（ｐｕｌｌ）一棵吧！\n",
                "daodiao lan":"一朵发出淡淡幽香的倒吊兰，拔（ｐｕｌｌ）一棵吧！\n",
                "lan":"一朵发出淡淡幽香的倒吊兰，拔（ｐｕｌｌ）一棵吧！\n",
        ]) );
        set("objects", ([
                __DIR__"obj/qizhi" : 1,
                __DIR__"obj/shibi" : 1,
        ]));
        set("no_magic",1);
        set("resource/water",1);
        setup();
        con = present("skeleton",this_object());
        cloth = new("/obj/cloth");
        blade = new(__DIR__"obj/xiuluo-blade");
        letter = new(__DIR__"obj/letter");
        cloth->move(con);
        blade->move(con);
        letter->move(con);
}

void init()
{	
	if( interactive(this_player()) )
		this_player()->set("mojiao/qizhi",1);
	add_action("do_dazuo","dazuo");
	add_action("do_pull","pull");
}
int valid_leave(object me, string dir)
{
	message_vision("$N扑通跳入流水中。\n",me);
	return 1;
}

int do_dazuo()
{
	string *name,str,nick,title;
	int mybusy;
	object me = this_player();
	if( me->is_busy() ){
                write("你上一个动作还没有完成，不能打坐。\n");
                return 1;
        }
	message_vision("$N盘腿跌坐在石头上，闭上眼睛开始调息打坐。\n",me);
	tell_object(me,"一股寒意自下肢顺入你的身体，游遍你的全身。\n");
	if (me->query("food")&&me->query("water"))
	{
       		me->set_temp("block_msg/all",1);
		me->set_temp("is_unconcious",1);
		if( !stringp(str = me->query("short")) )
			str = me->name() + "(" + capitalize(me->query("id")) + ")";
		if(sizeof(name = me->query_temp("apply/short")) )
			str = (string)name[sizeof(name)-1];
		if( stringp(nick = me->query("nickname")) )
			str = sprintf("「%s」%s", nick, str);
		if( stringp(title = me->query("title")) )
			str = sprintf("%s%s%s", title,(nick?"":" "), str);
		str += HIW" <打坐中>" NOR ;	
		me->set_temp("apply/short",({ str }));
		mybusy = random(50 - (int) me->query_con());
		if ( mybusy < 10) mybusy = 10;
		me->start_busy(mybusy);
        	me->start_call_out( (: call_other, __FILE__, "remove_dazuo", me , name:), mybusy );
		me->receive_heal("kee",me->query("kee"));
		me->receive_heal("gin",me->query("gin"));
		me->receive_heal("sen",me->query("sen"));
		me->set("force",0);
		me->add("food", -me->query("food")/2);
		me->add("water", -me->query("water")/2);
	}
	return 1;
}

void remove_dazuo(object me,string *name)
{
   	me->delete_temp("block_msg/all");
   	me->delete_temp("is_unconcious");
   	me->set_temp("apply/short",name);
   	if(!me->is_ghost())
	   	message_vision("$N从忘我的境界中回神敛气，睁开了眼睛。\n",me);
   	me->start_busy(1);
}	

void reset()
{
	::reset();
	delete("pulled");
}

int do_pull()
{
	object vege;
	if((int)query("pulled")<3)
	{
		write("你拔了一棵放在怀里。\n");
		vege = new(__DIR__"obj/lan");
		vege->move(this_player());
		add("pulled",1);
		return 1;
	}
	else
	write("都被人拔光了！！\n");
	return 1;
}