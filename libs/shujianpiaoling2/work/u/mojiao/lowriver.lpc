//lowriver.c written by john darks
#include <ansi.h> 
inherit ROOM;
void create()
{
        set("short", "激流下游");
        set("long", @LONG
这里的河床极窄，水流更加湍急。无风但河浪汹涌，稍有不慎就会
被河浪卷走。只有武功极高之人才敢涉足。
......水流越来越急，几乎已经立不住足了......
LONG
        );
	set("outdoors","tianzhu");
        set("objects", ([
                __DIR__"npc/eyu2" :2,
                        ]) );
	setup();
}
void init()
{
	if(interactive(this_player()))
	call_out("do_flush",10,this_player());
}

void do_flush(object me)
{
	if(!me || environment(me) != this_object())
		return;
	tell_object(me,HIR"一阵暗流涌来，你被冲的气血沸腾．．\n"NOR);
	me->receive_damage("kee",30+random(20),me);
	remove_call_out("do_flush");
	me->add_temp("mojiao/inriver",1);
	if (me->query_temp("mojiao/inriver")==4)
		tell_object(me,HIW"\n远处忽然传来一个姑娘唱歌的声音，歌声婉转动听。\n\n"NOR);
	call_out("do_flush",5,me);
	call_out("do_flush2",35,me);
	call_out("do_save",30,me);
}

void do_flush2(object me)
{
	object room;
        if(!me || environment(me) != this_object())
                return;
	tell_object(me,BLU"一阵暗流涌来，你被冲往河下游．．\n"NOR);
	if (!objectp(room = find_object(__DIR__"lowriver2")))
		room = load_object(__DIR__"lowriver2");
	me->move(room);
	message("vision",me->name()+"被激流冲了过来。\n",room,me);
}	
	

void do_save(object me)
{
	object room,ob,*inv;
	int i;
	if(!me || environment(me) != this_object())
		return;
	message_vision("\n一扁小舟之河的上游漂来．．．\n",me);
	tell_object(me,"\n你绝望中不禁大喜，正欲开口求救。\n");
	if (!objectp(room = find_object(__DIR__"badboat")))
		room = load_object(__DIR__"badboat");
	if (!me->query_temp("mojiao/baochou")){
		inv=all_inventory(room);
		if (!(ob=present("yu girl",room)) || !living(ob))
		{              
			message_vision("却见扁舟彭的撞在了暗礁上，化作了一片片木块。原来竟是一扁空舟。\n",me);
			return;
		}
		for (i=0;i<sizeof(inv);i++)
	    		if (userp(inv[i]))
			{
				message_vision("却见扁舟彭的撞在了暗礁上，化作了一片片木块。原来竟是一扁空舟。\n",me);
				return;
			}
		message_vision("却舟上伸过一根竹竿，将$N拉了上去。\n",me);
		me->move(room);
		message("vision",me->name()+"被拉了上来。\n",room,me);
	}else   message_vision("却见扁舟彭的撞在了暗礁上，化作了一片片木块。原来竟是一扁空舟。\n",me);
}