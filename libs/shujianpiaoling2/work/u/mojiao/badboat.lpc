//badboat.c  written by john darks
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "小舟中");
        set("long", @LONG
这是一艘小渔舟，一个渔家打扮的少女俏生生站在船头撑着竹竿划
水，流水虽激，小船却在河中缓缓行进着。
LONG
        );
        set("objects",([
        	__DIR__"npc/girl" : 1,
		]));
	set("no_magic",1);
	set("no_sleep",1);
	set("no_fight",1);
	set("outdoors","tianhu");
	setup();
}

void init()
{
	add_action("do_fight","kill");
	add_action("do_accept","accept");
	add_action("do_ask","ask");
}

int do_fight(string arg)
{
	object room;
	object ob = this_player();
	object me = present("yu girl",this_object());
	if (!me || ( arg!="yu girl"&&arg!="hong mian"))
		return 0;
	message_vision("$n看起来要杀了$N，$N惊叫一声，扁舟突然一晃，\n$n怪叫一声，跌入了河中。\n",me,ob);
	if (!objectp(room = find_object(__DIR__"lowriver2")))
		room = load_object(__DIR__"lowriver2");
	ob->move(room);
	message("vision",ob->name()+"扑通一声跌了下来。\n",room,ob);
	return 1;
}

int do_ask(string arg)
{
	string dest, topic;
	object room;
	object me = this_player();
	object ob = present("yu girl",this_object());
	if( !arg || sscanf(arg, "%s about %s", dest, topic)!=2 )
		return notify_fail("你要问谁什麽事？\n");
	if (!ob || (dest!="yu girl"&& dest!="hong mian"))
		return 0;
	if( !INQUIRY_D->parse_inquiry(me, ob, topic) )
		message_vision("$N向$n打听有关『" + topic + "』的消息。\n", me, ob);
	
	if( !living(ob) ) {
		message_vision("但是很显然的，$n现在的状况没有办法给$N任何答覆。\n",
			me, ob);
		return 1;
	}
	if (topic=="name"||topic=="姓名"){
		message_vision(CYN"$N浅笑盈盈，说道：“我叫红棉，这位"+RANK_D->query_respect(me)+"要去哪里呀？”\n"NOR,ob);
		ob->set_name("红棉",({"yu girl","hong mian"}));
		me->set_temp("mojiao/baochou",1);
		return 1;
	}else if (topic=="mojiao"||topic=="魔教"){
		message_vision(CYN"$N睁大眼睛道：魔教？是不是都是些恶人呀？不过我只知道绮梦山庄。\n"NOR,ob);
		return 1;
	}else if (topic=="qimeng"||topic=="绮梦山庄"){
		if (me->query_temp("mojiao/baochou")==1){
			message_vision(CYN"$N脸色忽然暗了下来，恨恨说道：“我是去绮梦谷报仇的，\n那里的谷主倒是个大恶人，她害死了我娘。”说着眼泪扑簌簌流了下来。\n"NOR,ob);
			me->set_temp("mojiao/baochou",2);
		}else message_vision(CYN"$N脸色突然暗了下来，眼泪扑簌簌流了下来。\n"NOR,ob);
		return 1;
	}else if (topic=="baochou"||topic=="报仇"){
		if (me->query_temp("mojiao/baochou")==2){
			message_vision(CYN"$N突然大喜，悄声在$n耳边私语了几句。\n"NOR,ob,me);
			tell_object(me,"红棉在你耳边私语道：“你愿不愿意(accept yes/no)跟我去报仇吗？”\n");
			me->set_temp("mojiao/baochou",3);
		}else {
			message_vision(CYN"$N脸色一变，突然道：到岸了，下船吧。\n"NOR,ob);
			message_vision("原来小舟不知不觉中已经到了岸边，$N慌忙跳上了岸。\n",me);
			if (!objectp(room = find_object(__DIR__"luwei2")))
				room = load_object(__DIR__"luwei2");
			me->move(room);
			message("vision",me->name()+"从河中的小舟跳了上来。\n",room,me);
		}
		return 1;
	}else message_vision(CYN"$N嘻嘻一笑，歪着头看着$n，好奇的道：这个问题原来你不知道，嘻嘻，我就不告诉你。\n"NOR,ob,me);
	return 1;
}



int do_accept(string arg)
{
	object room,*inv;
	int i;
	object ob = this_player();
	object me = present("yu girl",this_object());
	if (!me || (arg!="yes" && arg!= "no"))
		return 0;
	if (ob->query_temp("mojiao/baochou")==3){
		if (arg=="yes"){
			message_vision(CYN"$N喜道：“你愿意跟我去报仇？太好了。”\n"NOR,me);
			ob->set_temp("mojiao/baochou",4);
			message_vision("$N突然道：到岸了，我们下船吧。\n",me);
			message_vision("原来小舟不知不觉中已经到了岸边，$n慌忙和$N一起跳上了岸。\n",me,ob);
			if (!objectp(room = find_object(__DIR__"qimeng1")))
				room = load_object(__DIR__"qimeng1");
			ob->move(room);
			me->move(room);
			me->set_leader(ob);
			message("vision",me->name()+"和"+ob->name()+"跳上岸来。\n",room,ob);
			ob->ccommand("go northeast");
			ob->ccommand("go northeast");
		}else {
			ob->set_temp("mojiao/baochou",4);
			message_vision(CYN"$N突然尖叫道：要触礁了！\n"NOR,me);
			message_vision("由于流水太激，小舟一下子撞到了暗礁上。\n",ob);
			tell_object(ob,HIR"\n你只觉一股大力击来，将你甩了出去！\n"NOR);
			if (!objectp(room = find_object(__DIR__"lowriver2")))
				room = load_object(__DIR__"lowriver2");
			inv=all_inventory(environment(me));
			for (i=0;i<sizeof(inv);i++)
	    			if (userp(inv[i])){
					inv[i]->move(room);
					message("vision","彭的一声巨响，一扁舟撞到了暗礁。"+inv[i]->name()+"跌了出来。\n",room,inv[i]);
				}
		}
		return 1;
	}		
	else return 0;
}



