//yadi.c written by john darks
inherit ROOM;
void create()
{
	set("short", "悬崖底");
        set("long",@LONG
四周烟云弥漫，潮湿中透着一种死亡的气息。抬头望天，只见铁桶般
的峭壁耸入云间，只有一小片天空可以告慰自己，还可以见到天日。这里
虽然给人寂寥的感觉，但四处环山，幽静宜人。吸一口新鲜的空气，使人
感觉好极了。山谷不大，地上长满了一种奇怪的长草，湿湿的长长的还好
像在蠕动，踩上去摸起来粘忽忽的。
LONG
        );
        set("exits", ([
        	"northeast": __DIR__"road01",
        ]));
	set("outdoors", "tianzhu");
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "northeast" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}






