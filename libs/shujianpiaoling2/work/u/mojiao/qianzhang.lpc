#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "千丈岩");
        set("long",@LONG
这里是上山去长青峰的路。路滑且陡。虽然被铺上了石板，但是仍然
难走的很。这里的岩石是断层岩，层层迭迭。几入云宵。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"westup" : __DIR__"duxian",
		"east" : __DIR__"qinglian",
        ]));
/*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
        setup();
        replace_program(ROOM);
}
