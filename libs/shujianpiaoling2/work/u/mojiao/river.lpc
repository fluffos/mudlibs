//river.c written by john darks
inherit ROOM;
void create()
{
	set("short", "芦苇地");
        set("long",@LONG
在山坡的一边居然是一片芦苇地，在高山有芦苇也算一奇了。一条遄
急的河流至山的深处流出，没入芦苇地深处。站在河边，眼前是飞奔的激
流和震耳的涛声。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"southwest" : __DIR__"guanyin",
        ]));
        set("resource/water",1);
        set("no_clean_up",0);
        set("mojiao/hasboat",0);
        setup();
}

void init()
{
	add_action("do_pick", "pick");
	add_action("do_swim", "swim");
	add_action("do_yell", "yell");
	add_action("do_jump", "jump");
}

int do_pick(string arg)
{
	object	me, lu;
	if( arg != "luwei" && arg != "芦苇") 
		return 0;
	me = this_player();
	if(me->query_temp("mojiao/luwei"))
		return notify_fail("芦苇已经被你摘没了。\n");
	lu = new(__DIR__"obj/luwei");
	lu->move(me);
	me->set_temp("mojiao/luwei", 1);
	message_vision("\n$N摘了一根芦苇放在怀里。\n", me);
	return 1;
}

int do_swim(string arg)
{
	object	me,room;
	if( arg != "river" && arg != "激流" && arg!="河流") 
		return 0;
	me = this_player();
	message_vision("$N在河边站了半响，突然一个猛子扎入激流中。\n",me);
	if (!objectp(room = find_object(__DIR__"inriver")))
		room = load_object(__DIR__"inriver");
	me->move(room);
	message("vision",me->name()+"扑通一声跳了下来。\n",room,me);
	return 1;
}

int do_jump(string arg)
{
	object	me, room ,river;
	me = this_player();
	river = this_object();
	if( (arg!="boat" && arg!="小舟") || river->query("mojiao/hasboat")!= 1)
		return 0;
	if( me->query("marks/帮派")!="魔教") {
		message_vision("$N大喝一声，奋力的一跳，却扑通一声跳到了河里。\n",me);
		if (!objectp(room = find_object(__DIR__"inriver2")))
		room = load_object(__DIR__"inriver2");
		me->move(room);
		message("vision",me->name()+"扑通一声跳了下来。\n",room,me);
		return 1;
	}else {
		message_vision("$N大叫了一声：我来也。奋力一跳，跳到了小舟上。\n",me);
		message_vision("小舟一荡，漂走了。\n",me);
		river->set("mojiao/hasboat",0);
		if (!objectp(room = find_object(__DIR__"inboat")))
		room = load_object(__DIR__"inboat");
		me->move(room);
		message("vision",me->name()+"跳了过来。\n",room,me);
		river->set("mojiao/hasjump",1);
		call_out("jump_down",20,me,room);
		return 1;
	}
	return 1;
}


int do_yell(string arg)
{
	object	me = this_player();
	object river = this_object();
	
	if( arg != "boat" || me->query("marks/帮派")!="魔教" ||river->query("mojiao/hasjump")) {
		message_vision("$N大叫了一声："+arg+"～～～\n\n但却半响没有反应。\n",me);
		return 1;
	}else { 
		if (river->query("mojiao/hasboat"))
			return notify_fail("小舟就停在河边，但要跳(jump)过去才可以。\n");
		message_vision("$N大叫了一声：渡船～～～\n\n半响，远处忽然驶来一扁小舟。\n",me);
		message_vision("小舟就停在了河边，但要跳(jump)过去才可以。\n",me);
		river->set("mojiao/hasboat",1);
		return 1;
	}
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "southwest" )
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	return 1;
}

void jump_down(object me,object room)
{
	object river = this_object();
	if(!me || environment(me) != room){
		river->set("mojiao/hasjump",0);
		return; 
	}
	message_vision("$N忽然大叫了一声：啊，到岸了。$N奋力一跳，跳到了岸上。\n",me);
	message_vision("小舟一荡，漂走了。\n",me);
	river->set("mojiao/hasjump",0);
	if (!objectp(room = find_object(__DIR__"overiver")))
	room = load_object(__DIR__"overiver");
	me->move(room);
	message("vision",me->name()+"跳了过来。\n",room,me);
}