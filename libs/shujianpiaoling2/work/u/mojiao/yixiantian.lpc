//yixiantian.c written by john darks
inherit ROOM;
void create()
{
	set("short", "一线天");
        set("long",@LONG
此处的山从上到下裂开了一道将近半丈宽的口子，仿佛是雷公发怒，
用那神器将山劈了个口子似的。此处被人称为“一线天”。人在此山缝中
抬头看天，如同一个一字。此处易守难攻，是兵家中出了名儿的“一夫当
关，万夫莫开”的死地。到此处才可以深深体会天柱山地势险峻之处。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"eastup" : __DIR__"lianhua",
		"southwest" : __DIR__"didong3",
        ]));
         set("objects",([
	 	__DIR__"npc/lirenlong" : 1,
	 	__DIR__"npc/miaojinlong" : 1,
	 	__DIR__"npc/piaoyihu" : 1,
	 	__DIR__"npc/hechanggan" : 1,
	]));
        set("no_clean_up",0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "eastup" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}

void reset()
{
	object ob,*inv;
	int i;
	::reset();
	ob = present("li renlong", this_object());
	inv = all_inventory();
	if(ob)
	{
		ob->dismiss_team();
		for(i=0;i<sizeof(inv);i++){
			if(inv[i]->query("id") == "he changgan")
				ob->add_team_member(inv[i]);
			if(inv[i]->query("id") == "miao jinlong")
				ob->add_team_member(inv[i]);
			if(inv[i]->query("id") == "piao yihu")
				ob->add_team_member(inv[i]);
		}
	}
}
