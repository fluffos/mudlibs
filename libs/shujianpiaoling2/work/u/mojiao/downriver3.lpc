//downriver2.c written by john darks
inherit ROOM;
void create()
{
	set("short", "水潭中");
        set("long",@LONG
水潭中极为清晰,依稀可以看到一条水道向南而去。
LONG
        );
        set("exits", ([
        	"up" : __DIR__"downriver",
		"south" : __DIR__"downriver4",
        ]));
        set("resource/water",1);
        set("no_clean_up",0);
        setup();
}

void init()
{	
	object ob,room;
	if( interactive( ob = this_player()) && ob->query_temp("wangsha/wfrom")=="south"){
		set ("long", @LONG
这里出现一片亮光，应该到了出口了。	
LONG);	
	}else{
		set ("long", @LONG
水潭中极为清晰,依稀可以看到一条水道向南而去。
LONG);
	}
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "south" )
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	return 1;
}

