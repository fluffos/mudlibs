//didong1.c written by john darks
inherit ROOM;
void create()
{
	set("short", "地狱洞");
        set("long",@LONG
奔入石洞中，但觉酷热全消，迎面吹来一阵寒风。越往里走寒风更烈，
呼啸之声，连绵不绝。这寒风的呼啸，听来竞犹如战场上的杀戮之声一般，
使得这阴森幽暗的洞窟之中，充满了恐怖与杀机。
LONG
        );
        set("exits", ([
		"eastdown" : __DIR__"didong2.lpc",
		"out" : __DIR__"shenmi3",
        ]));
        set("no_clean_up",0);
        setup();
}

void init()
{	
	object ob;
	if( interactive( ob = this_player()) && ob->query_temp("wangsha/wfrom")=="south"){
        set("long",@LONG
奔入石洞中，但觉酷热全消，迎面吹来一阵寒风。越往里走寒风更烈，
呼啸之声，连绵不绝。这寒风的呼啸，听来竞犹如战场上的杀戮之声一般，
使得这阴森幽暗的洞窟之中，充满了恐怖与杀机。
LONG);	
	}else{
		set ("long", @LONG
一路摸索，在这里终于看到了一个洞口。寒风不断自洞口呼啸而入，隐隐
充溢这杀戮之气。身后偶尔传来一声凄凉的叫声，也分不出是风声还是人声。
LONG);
	}
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "eastdown" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}