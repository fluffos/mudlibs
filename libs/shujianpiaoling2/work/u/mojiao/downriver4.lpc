//downriver4.c written by john darks
inherit ROOM;
void create() {
  set("short", "水潭中");
  set("long", @LONG
水潭中极为清晰,依稀可以看到一条水道向北而去。
LONG
  );
  set("exits", ([
    "south": __DIR__ "downriver2",
    "north": __DIR__ "downriver3",
  ]));
  set("resource/water", 1);
  set("no_clean_up", 0);
  setup();
}

void init() {
  object ob, room;
  if (interactive(ob = this_player()) && ob->query_temp("wangsha/wfrom") == "south") {
    set("long", @LONG
水潭中极为清晰,依稀可以看到一条水道向北而去。	
LONG);
  } else {
    set("long", @LONG
水潭中极为清晰,依稀可以看到一条水道向南而去。
LONG);
  }
}
int valid_leave(object me, string dir) {
  object room;
  if (userp(me))
    if (dir == "north") {
      me->set_temp("wangsha/wfrom", "south");
      /*if (!me->query("mojiao/qizhi") && random(me->query_kar()+360) < 20){
			if (!objectp(room = find_object(__DIR__"waterhole")))
				room = load_object(__DIR__"waterhole");
			me->move(room);
			message_vision("$N忽然只觉头上一空，顿时浮出水面。\n",me);
			return notify_fail("\n");
		}*/
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
