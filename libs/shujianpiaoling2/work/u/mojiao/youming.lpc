inherit ROOM;
void create()
{
	set("short", "幽冥亭");
        set("long",@LONG
这个小亭子可谓普通之极。普通的和平常的山间小亭没有什么区别。
但是这就是江湖上很有名气的幽冥亭。亭子上的一个小木匾上刻着“幽冥
亭”三个字。可能是找的刻匾的人技术太差，字写的歪歪扭扭的。
LONG
        );
	set("outdoors", "tianzhu");
	set("item_desc", ([
                "小木匾": 	"幽冥亭    落款两个小字  龙五。\n",
	]));
        set("exits", ([
		"north" : __DIR__"fengshi",
		"southwest" : __DIR__"heihu",
        ]));
        setup();
        replace_program(ROOM);
}
