
inherit ROOM;

void create()
{
	set("short", "山崖边");
	set("long", @LONG
这是山顶的悬崖边，西面是万丈深渊，要是你活的不耐烦了，跳下去倒也是
一个解脱的好办法。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "east" :       __DIR__"shanding",
]));
	set("no_clean_up", 0);
//	set("objects",([
//		__DIR__"npc/dingde":1,
//	]));


	setup();
}

void init()
{
        add_action("jump_down","jump");
}

int jump_down(string arg)
{
        object me;
        me=this_player();
	 if( arg!="west" ) tell_object(me,"你要往哪个方向跳？\n");
	 else {
          message_vision("$N闭上眼睛，往悬崖跳了下去。\n",me);
	   if(me->query_skill("dodge")<80) {
                me->move(__DIR__"yadi");
		  tell_object(me,"你只觉得一阵剧疼，眼前一黑，接着就什么也不知了。\n");
                message("vision",me->name()+"突然从天上掉了下来，摔得粉身碎骨！\n",environment(me),me);
		  me->die();	
                CHANNEL_D->do_channel(this_object(), "rumor",
                        sprintf("%s摔下悬崖死了。", me->name())); 

		}
	   else if(me->query_skill("dodge")<135) {
                me->move(__DIR__"yadi");
                message("vision",me->name()+"突然从天上掉了下来，重重地摔在地上。\n",environment(me),me);
		  me->set("startroom", base_name(environment(me)));
		  me->unconcious();
	       }
	  else {
		  tell_object(me,"你施展绝妙的轻功，象一片树叶般飘落到崖底。\n");
                me->move(__DIR__"yadi");
		  me->set("startroom", base_name(environment(me)));
                message("vision",me->name()+"突然从天上无声无息地飘了下来，象一片落叶，又象一只飞鸟...\n",environment(me),me);
		}
	 }	
        return 1; 
}
