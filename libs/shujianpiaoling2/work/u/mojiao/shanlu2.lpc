inherit ROOM;
void create()
{
	set("short", "山麓");
        set("long",@LONG
这里只是随着山势依稀有条小路，但却极不好走，有的地方已经断了
路，只有靠攀沿着山石，脚踏着突起之处才可前进。气温降低，发冷。让
人觉得“高处不胜寒”。　　
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northup" : __DIR__"lianhua",
		"east" : __DIR__"jishi",
        ]));
        set("objects", ([
                __DIR__"npc/dizi5000" : 2,
                __DIR__"npc/dizi12000" : 2,
       	]) );
        set("no_clean_up",0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "east" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}
