#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
	set_name("九臂魔君", ({ "master jiubi", "jiubi", "master" }));
	set("title", "魔教前任教主");
	set("gender", "男性");
	set("age", 76);
	set("nickname", HIG "勾漏双魔" NOR);
	set("attitude", "peaceful");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);

        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);

        set("combat_exp", 60000000);
        set("score", 20000);

        set_skill("literate", 200);
        set_skill("force", 300);
        set_skill("unarmed", 300);
        set_skill("whip", 300);
        set_skill("parry", 300);
        set_skill("dodge", 300);
        set_skill("huangsha-whip", 250);
        set_skill("huashu-steps", 300);
        set_skill("wusha-strike", 250);
        set_skill("senluo-force", 250);
        map_skill("whip", "huangsha-whip");
        map_skill("force", "senluo-force");
        map_skill("parry", "huangsha-whip");
        map_skill("dodge", "huashu-steps");
        map_skill("unarmed", "wusha-strike");
        set("mojiao/势力",1);
	create_family("魔教",1, "教主");
	set("class", "mojiao");
	setup();
	carry_object("/obj/cloth")->wear();
	carry_object("/obj/weapon/whip")->wield();
}

void attempt_apprentice(object ob)
{
      if( ob->query("id_type")== 1) {
	    command("say 你身为正派弟子，哪里会诚心拜师？正邪势不两立！\n");
	    return;
	}
   if ((int)ob->query_skill("senluo_force", 1) < 150) 
           {
		command("say " + RANK_D->query_respect(ob) + "是否还应该多练练森罗万象变？");
		return;
	   }  
   if ( ob->query("class")=="mojiao")
   {
		message_vision("九臂魔君说道：“好吧, 我就收下你了。”\n",ob);
       command("recruit " + ob->query("id"));
		if((string)ob->query("class") != "mojiao")
			ob->set("class", "mojiao");
			ob->set("id_type", 2);
       return;}
   else
      {
		message_vision("九臂魔君冷冷说道：“阁下擅闯倚天殿，胆子可真不小!”\n",ob);
       return;}
}
