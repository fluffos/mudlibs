#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_he();
void create() {
  set_name("钱不良", ({ "qian buliang", "qian", "master" }));
  set("title", "魔教“敬地香”香主");
  set("gender", "男性");
  set("age", 36);
  set("nickname", HIG "盟城三恶之恶书生" NOR);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 900000);
  set("score", 2000);

  set_skill("literate", 70);
  set_skill("force", 90);
  set_skill("unarmed", 90);
  set_skill("sword", 90);
  set_skill("parry", 90);
  set_skill("dodge", 90);
  //set_skill("six-chaos-sword", 80);
  //set_skill("huashu_steps", 80);
  //set_skill("iron_strike", 80);
  //set_skill("senluo_force", 80);
  //map_skill("sword", "six-chaos-sword");
  //map_skill("force", "senluo_force");
  //map_skill("parry", "six-chaos-sword");
  //map_skill("dodge", "huashu_steps");
  //map_skill("unarmed", "iron_strike");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.ghostdream" :),
  }));
  create_family("魔教", 5, "香主");
  set("class", "mojiao");
  set("inquiry", ([
    "九阴夫人": (: about_he :),
    "教主": (: about_he :),
    "魔教总坛": (: about_he :),
    "总坛": (: about_he :),
  ]));

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 1) {
    command("say 你身为正派弟子，哪里会诚心拜师？正邪势不两立！\n");
    return;
  }
  if ((int)ob->query_skill("senluo_force", 1) < 50) {
    command("say " + RANK_D->query_respect(ob) + "是否还应该多练练森罗万象变？");
    return;
  }
  if (ob->query("id_type") != 1) {
    message_vision("钱不良说道：“好吧, 我就收下你了。”\n", ob);
    command("recruit " + ob->query("id"));
    if ((string)ob->query("class") != "mojiao")
      ob->set("class", "mojiao");
    ob->set("id_type", 2);
    return;
  } else {
    message_vision("钱不良冷冷说道：“阁下擅闯天柱洞，胆子可真不小!”\n", ob);
    return;
  }
}
int about_he() {
  object me;
  object huadu;
  me = this_player();
  if ((string)me->query("class") != "mojiao") {
    say("钱不良冷冷说道：你不是本教弟子！\n");
    return 0;
  }
  say("钱不良冷峻的目光扫了你一眼，说道：好吧，这就送你去见教主！\n");
  me->move("/u/mojiao/songlin1");
  message_vision("$N走了过来。\n", me);
  return 1;
}
