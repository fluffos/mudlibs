//badbug.c written by john darks
inherit NPC;
void create() {
  if (random(2))
    set_name("大蟑螂", ({ "cockroach" }));
  else
    set_name("小蟑螂", ({ "cockroach" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "一只非常恶心的蟑螂。 \n");
  set("combat_exp", 2000);
  set("force", 200);
  set_skill("dodge", 100);
  set("limbs", ({ "头部", "身体" }));
  set("verbs", ({ "bite" }));
  set_temp("armor", 50);
  setup();
}
