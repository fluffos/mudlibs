//shedan.c written by john darks
#include <ansi.h>
inherit ITEM;
void create()
{
	set_name(HIY"蛇胆"NOR, ({"shedan"}));
        set("unit", "只");
	set("long", "这是一只黄灿灿的蛇胆。\n");
	set("questvalue", 80);
	set("questobj",1);
        setup();
}

void init()
{
        add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	if (!arg || arg!="shedan")
                return 0;
        message_vision("$N一口吞下蛇胆，腹部咕噜噜做响。\n",this_player());
        this_player()->apply_condition("bigsnake_poison",0);
        destruct(this_object());
}