//renjia.c 小桥流水人家  written by john darks
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
        set_name( HIG"小桥流水人家"NOR, ({ "glide sword", "sword" }) );
        set_weight(14000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",
                        "＂小桥流水人家＂又名＂流水人家＂。当今十大名器之一。\n");
                set("value", 350000);
                set("material", "sapphire");
		set("rigidity", 500000);
		set("no_get",1);
		set("questvalue",90);
                set("wield_msg", "一缕如月光般和谐的剑光一闪，$N已将一柄$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入腰间的剑鞘。\n");
                set("weapon_prop/agility", 5);
        }
        init_sword(95);
        setup();
}

void owner_is_killed(object killer)
{
	message_vision("\n\n "+ HIG"小桥流水人家 " NOR +"化作一道金光飞入$N的怀中！\n\n",killer);
	this_object()->move(killer);
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	me->receive_curing("kee",100+random(20));
	me->receive_heal("kee",200 +random(30));
	tell_object(me,"一股暖流自剑上传入你的体内，流遍了你的全身。\n");
        return HIG "＂小桥流水人家＂闪出奇异的金黄色光芒．．．\n" NOR;
}

