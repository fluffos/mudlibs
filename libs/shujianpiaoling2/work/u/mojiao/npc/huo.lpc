#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
	set_name("火迪明", ({ "huo diming", "huo", "master" }));
	set("title", "魔教“昼游堂”堂主");
	set("gender", "男性");
	set("age", 46);
	set("nickname", HIG "飞天蜈蚣" NOR);
	set("attitude", "peaceful");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);
        set("combat_exp", 3500000);
        set("score", 2000);
        set_skill("literate", 90);
        set_skill("force", 140);
        set_skill("unarmed", 140);
        set_skill("blade", 140);
        set_skill("parry", 140);
        set_skill("dodge", 140);
        set_skill("xiuluo-blade", 100);
        set_skill("senluo-force", 130);
        set_skill("hanxing-strike",300);
        map_skill("blade", "xiuluo-blade");
        map_skill("force", "senluo-force");
        map_skill("parry", "xiuluo-blade");
        map_skill("dodge", "pyrobat-steps");
        map_skill("unarmed", "hanxing-strike");
	create_family("魔教",4, "堂主");
	set("class", "mojiao");
	set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.wudusuohou" :),
        }) );
	setup();
	carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	message_vision(CYN"火迪明说道：“在下武功低微，阁下说笑了。”\n"NOR,ob);
	return;
}

int about_skills()
{
	object me = this_player();
	object ob = this_object();
	if (me->query("marks/帮派")!="魔教"){
		message_vision(CYN"火迪明说道：“在下武功低微，阁下说笑了。”\n"NOR,ob);
		return 1;
	}
	if (me->query("mojiao/忠心") < 54000){
		message_vision(CYN"火迪明说道：“阁下职位低微，还是去做些其它对本教有益的事吧。”\n"NOR,ob);
		return 1;
	}
	if (!me->query_skill("hanxing-strike",1)){
		message_vision(CYN"火迪明说道：“蒙阁下垂青，属下自当倾力相授寒星毒掌(hanxing-strike)。”\n"NOR,ob);
		me->improve_skill("hanxing-strike",me->query_int()*me->query_int()/100);
	}else 	
		message_vision(CYN"火迪明说道：“属下自当倾力相授寒星毒掌(hanxing-strike)。”\n"NOR,ob);
	me->set("mojiao/hanxing-strike",1);
	return 1;
}

int recognize_apprentice(object ob)
{
        if( ob->query("mojiao/hanxing-strike"))
		return 1;
        return 0;
}