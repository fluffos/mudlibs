// dizi-2.c

inherit NPC;

void create()
{
	object ob;

	set_name("萧枫", ({ "xiao feng","xiao","feng" }) );
       set("title","千里独行客");
	set("gender", "男性");
	set("age", 48);
	set("max_kee",6000);
	set("kee",6000);
	set("cor",40);
	set("str",40);
	set("agi",40);
	set("food",1000);
	set("water",1000);
//       set("vendetta_mark", "mojiao");  

	set("long",
		"这是一个流浪的剑客，据说他已经练成无相剑法的最高境界。\n");
	set("combat_exp", 250000);
	set("score", 500);
	set("force", 1500);
	set("max_force", 1500);
	set("food", 500);
	set("water", 500);
       set("force_factor",50);

	set("bellicosity", 800);
	set_skill("unarmed", 280);
	set_skill("parry", 250);
	set_skill("dodge", 230);
	set_skill("force", 252);
	set_skill("wuxing-quan", 220);
	set_skill("sword", 230);
	set_skill("wx-sword", 260);
	set_skill("ding-dodge",270);
	set_skill("ding-force",270);
	set_skill("literate",130);
       map_skill("sword", "wx-sword");
       map_skill("parry", "wx-sword");
       map_skill("unarmed","wuxing-quan");
       map_skill("force", "ding-force");
       map_skill("dodge", "ding-dodge");
	setup();
	carry_object("/u/kongtong/npc/obj/sorrowfire")->wield();
	carry_object("/u/kongtong/npc/obj/icy_boot")->wear();
}


