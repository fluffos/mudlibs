//mojiao master
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_pingding();
int about_join();
int about_xinwu();
void reset_level(object student);
string *task = ({"武当遗失多年的七星宝剑，最近突然出现在武当附近，请务必找回。",
		 "最近传闻一把宝刀出现在扬州，正是十年前东瀛浪人带来中原的妖刀村正，请务必找回。",
		 "当年石观音的无坎真阴秘籍出世，最近有传闻说有人在金陵见过此书。",
		 "本教天蚕斗笠最近遗失，极有可能被本教叛逆弟子带到了长安。",
		 "无字天书本为茅山道教藏书，但最近突然遗失，教主认为可能还在茅山附近。",
		 "最近有人带着无极仙丹在长安出现，此人自称萧枫。教主急需此丹。",
		 "最近朝廷中似乎有人要对教主不利，此人名叫某某，务必取回此人首级。",
		 "教主急需一种毒蛇的蛇丹，这种蛇叫天冠巨蛇，据说只出现在桃花岛附近。",
		 "据说雪山有种猴子全身金毛，这种猴子的猴皮乃无价之宝，务必取回。",
		 "据说少林有个扫地僧，此人身上有少林一苇渡江轻功秘籍，务必取回。",
		 "本教镇教之宝太阳神弓最近离奇失踪，据传可能被人带入了紫薇山麓。",
		 "据传最近在华山出现一种血麒麟，其血乃无价之宝，务必取回。",
		 "教主最近急需雪蛤蟆用来下药，据说此蛤蟆只在雪山出现，常与雪人为伴。",
		 "一把剑名叫「流水人家」的短剑出现在峨嵋，务必取回。",
		 "请取回天柱山特有的短尾鳄的眼泪。",
		});//snowmen  jinmaohou
void init_quest();
void load_questnpc(string file1,string file2);
void load_questroom(string file1,string file2);
void create()
{
	set_name("许天君", ({ "master xu", "xu", "master" }));
	set("title", "魔教长老");
	set("gender", "男性");
	set("age", 66);
	set("nickname", HIG "天锦星" NOR);
	set("attitude", "friendly");
	set("startquest",0);
        set("str", 30);
        set("int", 30);
        set("cor", 300);
        set("spi", 30);
	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
        set("force", 3999);
        set("max_force", 2000);
        set("force_factor", 60);
        set("combat_exp", 18000000);
        set("score", 20000);
        set_skill("literate", 200);
        set_skill("force", 240);
        set_skill("unarmed", 240);
        set_skill("parry", 240);
        set_skill("dodge", 240);
        set_skill("move",240);
        set_skill("music",240);
        set_skill("writetao",200);
        set_skill("qidao",200);
        set_skill("painting",200);
        set_skill("iron-cloth",200);
        set_skill("wusha-strike", 30);
        set_skill("senluo-force", 180);
	create_family("魔教",2, "长老");
	set("class", "mojiao");
        set("inquiry", ([
                "评定大会" : (: about_pingding :),
                "meeting" : (: about_pingding :),
                "魔教":(:about_join:),
                "mojiao":(:about_join:),
                "魔教天邪令":(:about_xinwu:),
                "tianxie":(:about_xinwu:),
                "quest":"到适当的时候，我自然会发布任务的。",
                "任务":"到适当的时候，我自然会发布任务的。",
        ]));

	setup();
	carry_object("/obj/cloth")->wear();
}

void init()
{
	add_action("join_in","join");
	add_action("do_answer","answer");
}

void unconcious()
{
	::die();
}

void die()
{
	remove_all_killer();
	set("eff_kee", 2000);
	set("eff_gin", 2000);
	set("eff_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);
}

void attempt_apprentice(object ob)
{
     	if( ob->query("id_type")==1 ) {
		command("say 你身为正派弟子，哪里会诚心拜师？正邪势不两立！\n");
	    	return;
      	}
      	if(ob->query("mojiao/弃子")) {
		command("say 你没有资格成为我的弟子！\n");
	    	return;
      	}
      	if ((int)ob->query("combat_exp")>50 && (int)ob->query_skill("senluo-force", 1) < 50) 
      	{
		command("say " + RANK_D->query_respect(ob) + "是否还应该多练练森罗万象变？");
		return;
	}
	if (ob->query("mojiao/势力")!="教主系")
	{
		switch(ob->query("mojiao/势力")){
		case "紫迷坛":
			command("say " + RANK_D->query_respect(ob) + "好像应该去见见紫迷坛主才对。");
			return;
			break;
		case "地撤坛":
			command("say " + RANK_D->query_respect(ob) + "好像应该去见见地撤坛主才对。");
			return;
			break;
		case "天玄坛":
			command("say " + RANK_D->query_respect(ob) + "好像应该去见见天玄坛主才对。");
			return;
			break;
		case "伏兽坛":
			command("say " + RANK_D->query_respect(ob) + "好像应该去见见伏兽坛主才对。");
			return;
			break;
		}
	}	
	message_vision(CYN"许天君说道：“好吧, 我就收下你了。”\n"NOR,ob);
       	command("recruit " + ob->query("id"));
	ob->set("class", "mojiao");
	ob->set("id_type", 2);
	ob->set("mojiao/势力","教主系");
	ob->set("marks/帮派","魔教");
	ob->set("marks/魔教","教徒");
	if (ob->query("mojiao/势力"!="教主系"))
		ob->add("mojiao/忠心",2000);
	call_out("reset_level",1,ob);
       	return;
}

int about_xinwu()
{
	object me,ob,ling;
	me = this_player();
	ob = this_object();
 	if (me->query("marks/帮派")!="魔教")
 		return 0;
 	else if (objectp(ling = present("tianxie",me))){
 		write(CYN"许天君淡淡一笑：不是在你身上吗？\n"NOR);
 		return 1;
	}
 	else {
 		ling = new(__DIR__"obj/tianxie");
 		ling->move(me);
 		write(CYN"许天君注视你一会儿，递给你一个令牌。\n"NOR);
 		return 1;
 	}
}

int about_pingding()
{
        object me,ob;
        string path;
	me = this_player();
	ob = this_object();
	path = replace_string(__DIR__,"npc/","");
 	if (me->query("marks/帮派")=="魔教"){
		if (!ob->query("can_enter") && !me->query("mojiao/enter_time")){
			say(CYN"许天君冷峻的目光扫了你一眼，说道：你去总坛等候吧。\n"NOR);
			message("vision",CYN"只见许天君左手一招，北边洞壁孜孜呀呀居然移出一个洞来！\n"NOR,environment(me));
			tell_object(me,CYN"你一闪身进入洞中，身后的石门砰的关了起来。\n"NOR);
			message("vision",CYN+me->name()+CYN"一闪身进入洞中，又见许天君手一招，北边洞壁立刻合了起来！\n"NOR,environment(me),me);
			me->move(path+"sc_road1");
			message("vision",CYN+me->name()+CYN"走了过来。\n"NOR,environment(me),me);
		}else if (!ob->query("can_enter") && (int)me->query("mojiao/enter_time")==2){
			say(CYN"许天君冷冷的扫了你一眼，说道：你好大的胆子，居然敢缺席评定大会。\n"NOR);
			tell_object(me,HIR"因受处罚你被减掉了：\n" +
//        				chinese_number(me->query("combat_exp")/1000) + 
//"点实战经验\n"+
        				"一百点信赖度。\n"NOR );
//        		me->add("combat_exp", - me->query("combat_exp")/1000);
        		me->add("mojiao/忠心", - 100);
        		if ((int)me->query("mojiao/忠心")+200 <0){
        			say(CYN"许天君冷冷一哼，道：你没有资格再做魔教弟子了！"NOR);
        			me->set("mojiao/弃子",1);
        			me->delete("marks/帮派");
        			me->delete("marks/魔教");
			}
			me->set("mojiao/enter_time",0);		        			
		}else if (ob->query("can_enter")){
			say(CYN"许天君冷峻的目光露出一丝暖意，说道：快去吧，教主正在总坛召开大会。\n"NOR);
			message("vision",CYN"只见许天君左手一招，北边洞壁孜孜呀呀居然移出一个洞来！\n"NOR,environment(me));
			tell_object(me,CYN"你一闪身进入洞中，身后的石门砰的关了起来。\n"NOR);
			message("vision",CYN+me->name()+CYN"一闪身进入洞中，又见许天君手一招，北边洞壁立刻合了起来！\n"NOR,environment(me),me);
			me->move(path+"sc_road1");
			message("vision",CYN+ me->name()+CYN"走了过来。\n"NOR,environment(me),me);
          	}
	}else if (me->query("combat_exp") > 5000000){
		say(CYN"许天君目光一凝，道：阁下武功深不可测，许某佩服。请！\n"NOR);
		message("vision",CYN"只见许天君左手一招，北边洞壁孜孜呀呀居然移出一个洞来！\n"NOR,environment(me));
		tell_object(me,CYN"你一闪身进入洞中，身后的石门砰的关了起来。\n"NOR);
		message("vision",CYN + me->name()+CYN"一闪身进入洞中，又见许天君手一招，北边洞壁立刻合了起来！\n"NOR,environment(me),me);
		me->move(path + "sc_road1");
		message("vision",CYN+ me->name()+CYN"走了过来。\n"NOR,environment(me),me);
	}
	else	say(CYN"许天君冷峻的目光扫了你一眼，说道：凭你还没有资格见我们教主！\n"NOR);
	return 1;
}

int about_join()
{
	object me,obj;
	me = this_player();
	obj = this_object();
	if(me->query_temp("num_of_ask") < 5)
	{
		me->add_temp("num_of_ask",1);
		switch (me->query_temp("num_of_ask")){
		case 1:
		message_vision(CYN"$N道：〔魔教〕是当今武林中最强大的帮会！\n"NOR,obj);
			break;
		case 2:
		message_vision(CYN"$N道：〔魔教〕现在正笼络天下各派高手，有志者都可以加入。\n"NOR,obj);
			break;
		case 3:
		message_vision(CYN"$N道：〔魔教〕常以暗杀方式来铲除异己，以巩固自己在武林中的地位！\n"NOR,obj);
			break;
		case 4:
		message_vision(CYN"$N道：你似乎对〔魔教〕很感兴趣，是否想加入呢（join yes/no）？\n"NOR,obj);
			break;
		case 5:
		message_vision(CYN"$N道：〔魔教〕是当今武林中最神秘，邪恶的帮会。\n"NOR,obj);
			break;
		}
	}
	else	message_vision(CYN"$N道：阁下如果是正义之辈万万不可加入魔教！\n"NOR,obj);
	return 1;
}

int join_in(string arg)
{
	object me;
	me = this_player();
	if((int)me->query_temp("num_of_ask") < 4) 
		return 0;
	if(!arg || arg != "yes" || me->query("combat_exp") < 800000 || me->query("mojiao/弃子"))
	{
		me->delete_temp("num_of_ask");
		tell_object(me,CYN"许天君道：阁下如果是正义之辈万万不可加入魔教！\n"NOR);
		return 1;
	}else{
		if (me->query("marks/帮派")=="魔教")
			tell_object(me,CYN"许天君微微一笑道：你已经是魔教中人了，好好努力吧。\n"NOR);	
		else {
			tell_object(me,CYN"许天君冷冷一笑道：实说不妨，我就是魔教长老，我先问你一些问题。
你要如实回答(answer)，答完了才能加入本教。\n"NOR);	
			me->set_temp("can_answer",1);
        		me->delete_temp("num_of_ask");
        		write(CYN"你出生在什么环境？\n"NOR);
        	}
		return 1;
	}
	return 1;
}

int do_answer(string arg)
{
	object me = this_player();
	
	if (!me->query_temp("can_answer"))
		return 0;
	switch (me->query_temp("can_answer")){
	case 1:
		if (!arg || strsrch((string)me->query("national"),arg)==(-1) ){
			me->set("mojiao/忠心",-700);
			write(CYN"许天君摇摇头道：你不是很诚实。\n"NOR);
		}
		else {
			me->add("mojiao/忠心",3000);
			write(CYN"你现在是什么门派的？\n"NOR);
			me->set_temp("can_answer",2);
		}
		return 1;
		break;
	case 2:
		if (!arg || strsrch(arg,(string)me->query("family/family_name"))==(-1)){
			me->set("mojiao/忠心",-700);
			write(CYN"许天君摇摇头道：你不是很诚实。\n"NOR);
		}else {
			me->add("mojiao/忠心",3000);
			write(CYN"你现在最擅长的是什么武功？\n"NOR);
			write("回答其中的一种：内功，外功，轻功，拳脚，兵刃，暗器。\n");
			me->set_temp("can_answer",3);
		}
		return 1;
		break;
	case 3:
		if (!arg || (arg!="内功" && arg!="外功"&&arg!="轻功"&&arg!="拳脚"&&arg!="兵刃"&&arg!="暗器"))
			write("请回答其中的一种：内功，外功，轻功，拳脚，兵刃，暗器。\n");
		else {
			me->set_temp("mojiao/武功",arg);
			write(CYN"你现在最喜欢的是什么武功？\n"NOR);
			write("回答其中的一种：内功，外功，轻功，拳脚，兵刃，暗器。\n");
			me->set_temp("can_answer",4);
		}
		return 1;
		break;
	case 4:
		if (!arg || (arg!="内功" && arg!="外功"&&arg!="轻功"&&arg!="拳脚"&&arg!="兵刃"&&arg!="暗器"))
			write("请回答其中的一种：内功，外功，轻功，拳脚，兵刃，暗器。\n");
			//体质 韧性 速度 力量 勇气 定力
		else {
			if (arg == me->query_temp("mojiao/武功"))
				me->set("mojiao/"+arg,300);
			else me->set("mojiao/"+arg,-300);
			write(CYN"你现在最擅长的是什么技能？\n"NOR);
			write("回答其中的一种：乐理，棋道，御官，书法，丹青，文采。\n");
			me->set_temp("can_answer",5);
		}
		return 1;
		break;
	case 5:
		if (!arg || (arg!="乐理" && arg!="棋道"&&arg!="御官"&&arg!="书法"&&arg!="丹青"&&arg!="文采"))
			write("请回答其中的一种：乐理，棋道，御官，书法，丹青，文采。\n");
			//灵性 气量 运气 耐力 魅力 才智
		else {
			me->set_temp("mojiao/技能",arg);
			write(CYN"你现在最喜欢的是什么技能？\n"NOR);
			write("回答其中的一种：乐理，棋道，御官，书法，丹青，文采。\n");
			me->set_temp("can_answer",6);
		}
		return 1;
		break;
	case 6:
		if (!arg || (arg!="乐理" && arg!="棋道"&&arg!="御官"&&arg!="书法"&&arg!="丹青"&&arg!="文采"))
			write("请回答其中的一种：乐理，棋道，御官，书法，丹青，文采。\n");
		else {
			if (arg == me->query_temp("mojiao/技能"))
				me->set("mojiao/"+arg,300);
			else me->set("mojiao/"+arg,-300);
			write(CYN"本教四大分坛，你现在最喜欢的是哪一坛？\n"NOR);
			write("回答其中的一种：紫迷坛，地撤坛，天玄坛，伏兽坛。\n");
			me->set_temp("can_answer",7);
		}
		return 1;
		break;
	case 7:
		if (!arg || (arg!="紫迷坛" && arg!="地撤坛"&&arg!="天玄坛"&&arg!="伏兽坛"))
			write("请回答其中的一种：紫迷坛，地撤坛，天玄坛，伏兽坛。\n");
		else {
			write(CYN"许天君点点头，道：很好。以后你就是"+arg+"的弟子了。\n"NOR);
			me->set("mojiao/势力",arg);
			me->set("marks/帮派","魔教");
			me->set("marks/魔教","教徒");
			me->set_temp("can_answer",0);
		}
		return 1;
		break;
	}
	return 1;
}

void reset()
{
	object me = this_object();
	if (!me->query("start")){
		me->set("start",1);
		return;
	}
	init_quest();
}

void init_quest()
{
	object me = this_object();
	object *ob,*target,questobj;
	string *tasklist,*quest;
	int i,j,list,k,m;
	string questarg ;
	// give quest to mojiao player
	ob = users();
        i = sizeof(ob);
        while (i--) {
if (ob[i]->query("marks/帮派")=="魔教" ||wizardp(ob[i]))
		{
			if (sizeof(target)==0)
				target = ({ob[i]});
			else 	target+=({ob[i]});
			call_out("reset_level",1,(ob[i]));
		}
	}
	//get quest
	for (k=0; k<sizeof(task);k++)		
		if (sizeof(tasklist)==0)
			tasklist = ({task[k]});
		else 
			tasklist+=({task[k]});
	list = sizeof(task);
	for (k=0 ; k<4 ;k++){
		j = random(list);
		questarg = tasklist[j];
		for(i=0 ; i < list-j-1 ;i++)
			tasklist[j+i] = tasklist[j+i+1];
		list = list -1; 
		//依次对quest进行处理
		if (questarg == task[0]){
			load_questnpc(__DIR__"questobj/7_sword","/u/wudang/*.lpc");
		}else if (questarg == task[1]){
			load_questnpc(__DIR__"questobj/longblade","/d/yangzhou/*.lpc");
		}else if (questarg == task[2]){
			load_questnpc(__DIR__"questobj/forcebook","/d/jinling/*.lpc");
		}else if (questarg == task[3]){
			load_questnpc(__DIR__"questobj/silkhat","/d/city/*.lpc");
		}else if (questarg == task[4]){
			load_questnpc(__DIR__"questobj/nothingbook","/u/maoshan/*.lpc");
		}else if (questarg == task[5]){
			load_questroom(__DIR__"xiaofeng","/d/city/*.lpc");
			questobj = find_object(__DIR__"xiaofeng");
			questarg = replace_string(questarg,"萧枫",questobj->query("name"));
		}else if (questarg == task[6]){
			load_questroom(__DIR__"officer","/d/city/*.lpc");
			questobj = find_object(__DIR__"officer");
			questarg = replace_string(questarg,"某某",questobj->query("name"));
		}else if (questarg == task[7]){
			load_questroom(__DIR__"bigsnaker","/u/taohua/*.lpc");
		}else if (questarg == task[8]){
			load_questroom(__DIR__"monkey","/u/baiwt/xueshan/*.lpc");
		}else if (questarg == task[9]){
			load_questroom(__DIR__"saodi_seng","/u/tian/shaolin/*.lpc");
		}else if (questarg == task[10]){
			load_questnpc(__DIR__"questobj/sunbow","/u/lark/xiaoyao/*.lpc");
		}else if (questarg == task[11]){
			load_questroom(__DIR__"xueqilin","/u/yanzi/huashan/*.lpc");
		}else if (questarg == task[12]){
			load_questroom(__DIR__"xuehama","/u/baiwt/xueshan/*.lpc");
		}else if (questarg == task[13]){
			load_questnpc(__DIR__"questobj/renjia","/u/emei/*.lpc");
		}else if (questarg == task[14]){
			questobj = find_object(__DIR__"bigeyu");
			if (!objectp(questobj))
				questobj = load_object(__DIR__"bigeyu");
			questobj->move("/u/mojiao/inriver2.lpc");
		}else break;
		message("vision", HIW "【魔教】许天君：" + questarg + "\n\n" NOR, target);	
	}
	if (me->query("task_num")>= 24){
		call_out("init_task",1);
		me->set("task_num",0);
	}else 	me->add("task_num",1);
}

void init_task()
{
	string path;
	object *ob,*target,npc,npcroom,room;
	int i,j;
	object me = this_object();
	ob = users();
        i = sizeof(ob);
        while (i--) {
		if (ob[i]->query("marks/帮派")=="魔教")
		{
			if (sizeof(target)==0)
				target = ({ob[i]});
			else 	target+=({ob[i]});
			ob[i]->set("mojiao/enter_time",1);
		}
	}
	me->set("can_enter",1);
	message("vision", HIG "【魔教】许天君(master xu)：教主在总坛召开每月评定大会！请在一天内赶到总坛参加大会！\n" NOR, target);	

	call_out("init_endtask",700);
	//all mojiao npc move dating to have a meeting
	path = replace_string(__DIR__,"/npc/","/");
	if (!objectp(npcroom = find_object(path + "yitian")))
		npcroom = load_object(path + "yitian");
	npcroom->reset();
	npcroom->set("meeting",1);
	if (!objectp(npcroom = find_object(path + "feiyun")))
		npcroom = load_object(path + "feiyun");
	npcroom->reset();
	npc = present("master jiuyin",npcroom);
	npc->set("start_vote",0);
	message("vision",CYN + npc->name() + CYN"急急忙忙地离开了。\n"NOR,npcroom,npc);
	npc->move(path + "yitian");
	call_out("init_vote",300);
	if (!objectp(npcroom = find_object(path + "dichetan")))
		npcroom = load_object(path + "dichetan");
	npcroom->reset();
	npc = present("jiu chenyang",npcroom);
	message("vision",CYN + npc->name() + CYN"急急忙忙地离开了。\n"NOR,npcroom,npc);
	npc->move(path + "yitian");
	if (!objectp(npcroom = find_object(path + "mihun")))
		npcroom = load_object(path + "mihun");
	npcroom->reset();
	npc = present("ji ruyu",npcroom);
	message("vision",CYN + npc->name() + CYN"急急忙忙地离开了。\n"NOR,npcroom,npc);
	npc->move(path + "yitian");
	if (!objectp(npcroom = find_object(path + "heihu")))
		npcroom = load_object(path + "heihu");
	npcroom->reset();
	npc = present("xuanyuan shan",npcroom);
	message("vision",CYN + npc->name() + CYN"急急忙忙地离开了。\n"NOR,npcroom,npc);
	npc->move(path + "yitian");
	if (!objectp(npcroom = find_object(path + "xuantian")))
		npcroom = load_object(path + "xuantian");
	npcroom->reset();
	npc = present("long buqing",npcroom);
	message("vision",CYN + npc->name() + CYN"急急忙忙地离开了。\n"NOR,npcroom,npc);
	npc->move(path + "yitian");
	if (!objectp(npcroom = find_object(path + "guanyin")))
		npcroom = load_object(path + "guanyin");
	npcroom->reset();
	npc = present("li bo",npcroom);
	message("vision",CYN + npc->name() + CYN"急急忙忙地离开了。\n"NOR,npcroom,npc);
	npc->move(path + "yitian");
	npc = present("sun can",npcroom);
	message("vision",CYN + npc->name() + CYN"急急忙忙地离开了。\n"NOR,npcroom,npc);
	npc->move(path + "yitian");
	npc = present("zhao ai",npcroom);
	message("vision",CYN + npc->name() + CYN"急急忙忙地离开了。\n"NOR,npcroom,npc);
	npc->move(path + "yitian");
	npc = present("tian tuo",npcroom);
	message("vision",CYN + npc->name() + CYN"急急忙忙地离开了。\n"NOR,npcroom,npc);
	npc->move(path + "yitian");
	
}

void init_vote()
{
	object room;
	string path;
	path = replace_string(__DIR__,"npc/","");
	if (!objectp(room = find_object(path + "yitian")))
		room = load_object(path + "yitian");
	room->start_vote();
	room->set("subip",({}));
	return;
}

void init_endtask()
{
	string path;
	object *ob,npcroom;
	int i,j;
	object me = this_object();
	ob = users();
        i = sizeof(ob);
        while (i--) {
		if (ob[i]->query("marks/帮派")=="魔教")
		{
			if ((int)ob[i]->query("mojiao/enter_time")==1){
				ob[i]->set("mojiao/enter_time",2);
				tell_object(ob[i],HIR"因缺席评定大会你被减掉了：\n" +
        				chinese_number(0) + "点实战经验\n"+
//        				chinese_number(ob[i]->query("combat_exp")/100) + "点实战经验\n"+
        				"十点信赖度。\n"NOR );
//        			ob[i]->add("combat_exp", - ob[i]->query("combat_exp")/100);
        			ob[i]->add("mojiao/忠心", - 10);
        			if ((int)ob[i]->query("mojiao/忠心") + 500 <0){
        				tell_object(ob[i],HIR"由于你忠心度太低，被逐出魔教了！"NOR);
        				ob[i]->set("mojiao/弃子",1);
        				ob[i]->delete("marks/帮派");
        				ob[i]->delete("marks/魔教");
        			}
			}				
		}
	}
	me->set("can_enter",0);
	path = replace_string(__DIR__,"npc/","");
	if (!objectp(npcroom = find_object(path + "yitian")))
		npcroom = load_object(path + "yitian");
	npcroom->end_meeting();
	//all mojiao npc move back home
	if (!objectp(npcroom = find_object(path + "dichetan")))
		npcroom = load_object(path + "dichetan");
	npcroom->reset();
	if (!objectp(npcroom = find_object(path + "mihun")))
		npcroom = load_object(path + "mihun");
	npcroom->reset();
	if (!objectp(npcroom = find_object(path + "heihu")))
		npcroom = load_object(path + "heihu");
	npcroom->reset();
	if (!objectp(npcroom = find_object(path + "xuantian")))
		npcroom = load_object(path + "xuantian");
	npcroom->reset();
	if (!objectp(npcroom = find_object(path + "guanyin")))
		npcroom = load_object(path + "guanyin");
	npcroom->reset();
	if (!objectp(npcroom = find_object(path + "feiyun")))
		npcroom = load_object(path + "feiyun");
	npcroom->reset();
	if (!objectp(npcroom = find_object(path + "yitian")))
		npcroom = load_object(path + "yitian");
	npcroom->reset();
}

void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","魔教弟子");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","魔教小魔");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","魔教少魔");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","魔教大魔");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","魔教奇魔");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","魔教长老");
                return ;
        } else
                student->set("title","魔教供奉");
                return ;
}

void reset_level(object student)
{
        int exp;
        exp = (int) student->query("mojiao/忠心");
        if( exp <= 5000 ) {
                student->set("marks/魔教","教徒");
                return ;
        } else if ( exp <= 25000 ) {
                student->set("marks/魔教","银衣教徒");
                return ;
        } else if ( exp <= 56000 ) {
                student->set("marks/魔教","金衣教徒");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("marks/魔教","堂主");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("marks/魔教","坛主");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("marks/魔教","护法");
                return ;
        } else if ( exp <= 780000 ) {
                student->set("marks/魔教","外堂堂主");
                return ;
        } else if ( exp <= 1250000 ) {
                student->set("marks/魔教","内堂堂主");
                return ;
        } else if ( exp <= 1800000 ) {
                student->set("marks/魔教","元老");
                return ;
        } else
                student->set("marks/魔教","副教主");
                return ;
}

void load_questnpc(string file1,string file2)
{
	object *allroom,*inv2;
	object questobj,questroom,questnpc,*inv;
	string *objfile,path;
	int i,j;
	inv2 = ({});
	allroom = ({});
	if (!objectp(questobj = find_object(file1)))
		questobj = load_object(file1);
	objfile = get_dir(file2);
	path = replace_string(file2,"*.lpc","");
	for (i=0 ; i<sizeof(objfile);i++){
		if (!objectp(questroom = find_object(path + objfile[i])))
			continue;
		inv = all_inventory(questroom);
		for(j=0; j<sizeof(inv); j++) 
			if(inv[j]->is_character() && !userp(inv[j]))
				allroom += ({ questroom });
	}
	if (!sizeof(allroom)){
		for(j=0;j<20;j++){
			i = random(sizeof(objfile));
			if (!objectp(questnpc = find_object(path + objfile[i])))
				continue;
			else break;
		}
	}else {
		i = random(sizeof(allroom));
		inv = all_inventory(allroom[i]);
		for(i=0; i<sizeof(inv); i++){ 
			if(inv[i]->is_character() && !userp(inv[i]))
				inv2 += ({ inv[i] });
		}
		if(sizeof(inv2)) 
			questnpc = inv2[random(sizeof(inv2))];
	}
	if( !questobj || !questnpc )  return;
	questobj->set("questobj",1);
	questobj->move(questnpc);
	return;
}

void load_questroom(string file1,string file2)
{
	object questobj,questroom;
	string *objfile,path;
	int i,j;
	if (!objectp(questobj = find_object(file1)))
		questobj = load_object(file1);
	objfile = get_dir(file2);
	path = replace_string(file2,"*.lpc","");
	for(j=0;j<50;j++){
		i = random(sizeof(objfile));
		if (!objectp(questroom = find_object(path + objfile[i])))
			continue;
		else break;
	}
	if( !questobj || !questroom )  return;
	questobj->move(questroom);
	return;
}

int accept_object(object who, object ob)
{
	int exp,pot,score;
	object me = who;
	if (me->query("marks/帮派")!="魔教")
		return 1;
	if ((int)me->query("mojiao/task") > 20000){
		write("以你的功德地位，已不必再做魔教的任务了。\n");
		return 1;
	}
	if (ob->query("questobj")){
		exp = ob->query("questvalue")*5 + random(100);
        	pot = exp/5;
        	score = random(25)+25;
        	me->add("combat_exp",exp);
        	me->add("potential",pot);
        	me->add("mojiao/忠心",score);
		tell_object(me,HIW"你被奖励了：\n" +
        	chinese_number(exp) + "点实战经验\n"+
        	chinese_number(pot) + "点潜能\n" +
        	chinese_number(score)+"点忠心度\n"NOR);
		me->add("mojiao/task",1);
		return 1;
	}
	if (((string)ob->query("liquid/type") == "blood")
 		&& ((string)ob->query("liquid/name") == "麒麟血")
 		&& ((int)ob->query("liquid/remaining") > 5 ) ){
 		exp = 200 + random(100);
        	pot = exp/7;
        	score = random(25)+25;
        	me->add("combat_exp",exp);
        	me->add("potential",pot);
        	me->add("mojiao/忠心",score);
		tell_object(me,HIW"你被奖励了：\n" +
        	chinese_number(exp) + "点实战经验\n"+
        	chinese_number(pot) + "点潜能\n" +
        	chinese_number(score)+"点忠心度\n"NOR);
		me->add("mojiao/task",1);
                return 1;
        }
        if (((string)ob->query("liquid/type") == "tear")
 		&& ((string)ob->query("liquid/name") == "鳄鱼泪")
 		&& ((int)ob->query("liquid/remaining") > 5 ) ){
 		exp = 60 + random(100);
        	pot = exp/7;
        	score = random(25)+25;
        	me->add("combat_exp",exp);
        	me->add("potential",pot);
        	me->add("mojiao/忠心",score);
		tell_object(me,HIW"你被奖励了：\n" +
        	chinese_number(exp) + "点实战经验\n"+
        	chinese_number(pot) + "点潜能\n" +
        	chinese_number(score)+"点忠心度\n"NOR);
		me->add("mojiao/task",1);
                return 1;
        }				
        return 0;
}


