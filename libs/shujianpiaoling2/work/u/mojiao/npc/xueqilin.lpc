//bigsnake.c written by john darks
#include <ansi.h>
inherit NPC;
void use_poison();
int magic_more( object who);
void create()
{
        set_name(HIR"血麒麟"NOR, ({ "xue qilin","qilin" }) );
        set("race", "野兽");
        set("age", 15);
        set("long", "一只灵兽。\n");
        set("limbs", ({ "头部", "身体", "尾巴"}) );
        set("verbs", ({ "bite","claw"}) );
        set("attitude", "aggressive");
        set_skill("dodge", 250);
        set("max_kee",3000);
        set("max_gin",3000);
        set("max_sen",3000);
        set("max_force",40000);
        set("force",40000);
        set("fle",80+random(20));
        set("combat_exp", 999999);
	set("bellicosity", 30000 );
	set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: use_poison :),
		(: magic_more(this_object()) :),
        }) );
	set_temp("apply/attack",500);
	set_temp("apply/damage",330);
        setup();
}

void die()
{
	message_vision("$N一死，身上的血立刻干了！\n",this_object());
	this_object()->set("start_blood",0);
	::die();
}

void use_poison()
{
        object ob = this_object();
        if (ob->query("kee") < 1000  ||  ob->query("max_kee") < 1500){
        	message_vision(HIY"$N"+HIY"开始流血，那血竟是金黄色的！\n"NOR,ob);
        	ob->set("start_blood",1);
        }
}

void init()
{
        add_action("do_fill", "fill");
}

int do_fill(string arg)
{
        object *list, ob;
        int i, can_fillwater;
        string dir;
        function f;
        if( !arg || arg=="" || !this_object()->query("start_blood") ) return 0;
        if (this_object()->query("hadfill") > 5){
        	message_vision("$N身上的血立刻干了！\n",this_object());
        	this_object()->set("start_blood",0);
		::die();
	}
        if( arg=="skin" || arg=="wineskin" ) {
                list = all_inventory(this_player());
                can_fillwater = 0;
                for (i=0 ;i<sizeof(list);i++){
                  	if (((string)list[i]->query("liquid/type") == "alcohol")
 				|| ((string)list[i]->query("liquid/type") == "water")) {
                        	ob = list[i];
                        	can_fillwater = 1;
                        	ob->set("liquid", ([
                                	"type": "blood",
                                	"name": "麒麟血",
                                	"remaining": 15,
                        	]) );
                        	f = (: call_other, __FILE__, "drink_drug" :);
				ob->set("liquid/drink_func", bind(f, ob));
                        	write("你装了些麒麟血！ \n");
                        	this_object()->add("hadfill",1);
                        	return 1;
                	}
                }
                if (can_fillwater ==0) {
                        write("你没有装麒麟血的东西啊....\n");
                        return 1;
                }
        }
        else {
                write("你要往什么东西里装麒麟血？\n");
        }
        return 1;
}

int drink_drug(object ob)
{
	if( this_player()->is_busy())
	{
	tell_object(this_player(),"\n你正忙着呢！\n");
	return 0;
	}
	tell_object(this_player(),HIR"\n你只觉一股暖意涌了上来！\n"NOR);
	if (!this_player()->query_temp("mojiao/qilinxue") && this_player()->query("max_kee")< 5000)
		this_player()->add("max_kee",random(200) + 100);
		this_player()->start_busy(2);
	return 0;
}	

int magic_more(object who)
{
	int i, mwp;
	object *enemy, mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("force") < 150 )  return 1;
	if (!objectp(present("taoist guard", environment(who))))
	{
		mygod = new("/d/earth/npc/mguard"+(string)(random(21)+30));
		message_vision("\n$N"+HIR"发出一声长吼，顿时天上红云翻滚，山摇地动。"NOR,who,mygod);
		message_vision(HIR"\n不久只见四周一片血雾弥漫，$n的身影渐渐在烟雾中浮现出来。\n"NOR,who,mygod);
		message_vision(HIG"［麒麟吼］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		mygod->kill_ob(enemy[i]);
		enemy[i]->kill_ob(mygod);
		if( who->query("force") >= 150 )
		who->add("force", -150);
//		who->remove_all_killer();
	}
	else
	{
		mygod = present("taoist guard", environment(who));
		mygod->kill_ob(enemy[i]);
		enemy[i]->kill_ob(mygod);
		if( who->query("force") >= 50 )
		who->add("force", -50);
//		who->remove_all_killer();
	}
		}
	}
	return 1;
}
