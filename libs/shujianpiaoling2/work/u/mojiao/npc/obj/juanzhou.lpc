//juanzhou.c written by john darks
inherit ITEM;
void create()
{
    	set_name( "卷轴", ({ "secret scroll","scroll"  }) );
    	set("unit", "封");
    	set("long","\n");
    	set_weight(1);
}

void init()
{
	add_action("do_look","look");
}

int do_look(string arg)
{
	object me;
	object obj;
	me = this_player();
	if (!arg) return 0;
	if (arg!= "scroll" && arg!="secet scroll") return 0;
	if((obj = present(arg, me)) || (obj = present(arg, environment(me))))
	{
		if (obj != this_object()) return 0;
		if ((random(me->query_int())<15) || (random(me->query_kar())<12))
		{
			obj->set("long","这是一封空白的卷轴。\n");
			return 0;
		}
		else
		{
			obj->set("long","这是一封空白的卷轴，阳光一闪，你似乎看到了什么！
似乎是推开锁龙石的诀窍。\n");
			me->set("mojiao/movestone",1);
			return 0;
		}
		
	}
	return 0;
}          