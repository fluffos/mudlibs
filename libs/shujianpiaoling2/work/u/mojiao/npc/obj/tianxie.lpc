// tianxie.c written by john darks
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIG "魔教天邪令" NOR, ({ "tianxie" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long",
      "魔教信物\n");
    set("material", "stone");
  }
}

void init() {
  if (this_player()->query("marks/帮派") == "魔教" || wizardp(this_player())) {
    add_action("do_talk", ({ "mojiao", "mj" }));
    add_action("do_score", "score");
    //add_action("do_kill","kill");
  }
}

int do_score(string arg) {
  object me, ob;
  string line;
  me = this_player();
  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) {
      write("你要察看谁的状态？\n");
      return 1;
    }
  } else {
    write("你只可以察看自己的状态。\n");
    return 1;
  }
  line = sprintf(HIR " 目前你对魔教的忠诚度： %d\n" NOR, ob->query("mojiao/忠心"));
  line += sprintf(HIY " 你已完成了%s个魔教任务。\n" NOR, chinese_number(ob->query("mojiao/task")));
  line += sprintf(HIW " 你做了%s件对魔教有益的任务。\t" NOR, chinese_number(ob->query("mojiao/goods")));
  line += sprintf(HIW " 你做了%s件对魔教有害的任务。\n" NOR, chinese_number(ob->query("mojiao/bads")));
  if (ob->query("marks/帮派") == "魔教")
    write(line);
  return 0;
}

int do_talk(string arg) {
  object *ob, *target;
  int i;
  string mebang, obbang, outarg;
  object me = this_player();
  if (me->query("chblk_on"))
    return notify_fail("你的频道被关了！\n");
  mebang = (string)me->query("marks/帮派");
  if (mebang != "魔教")
    return notify_fail("你不属于魔教！\n");
  ob = users();
  i = sizeof(ob);
  while (i--) {
    obbang = (string)ob[i]->query("marks/帮派");
    if ((mebang == obbang || wizardp(ob[i])) && !ob[i]->query("env/mojiao")) {
      if (sizeof(target) == 0)
        target = ({ ob[i] });
      else
        target += ({ ob[i] });
    }
  }
  if (!stringp(outarg = arg))
    outarg = "．．．．．";
  message("vision", HIW "【" + mebang + "】" +
    me->query("name") + "(" + capitalize(me->query("id")) + ")" +
    "：" + outarg + "\n" NOR, target);
  return 1;
}
