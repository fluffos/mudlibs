//crystalblade.c written by john darks
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
void create() {
  set_name(HIY "虎翼" NOR, ({ "crystal blade", "blade" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把东瀛武士常用的刀，所不同的是居然由水晶所制。");
    set("value", 500000);
    set("rigidity", 30000);
    set("material", "crystal");
    set("wind-blade", 1);
  }
  init_blade(130);
  setup();
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (me->query("force_factor") > 30) return 0;
  if (me->query("force_factor") < 10) return 0;
  if (random((40 - me->query("force_factor")) * 50) > me->query("kee")
    || me->is_ghost() == 1) {
    victim->receive_wound("gin", random(20));
    victim->start_busy(3);
    return HIY "虎翼" + HIM "发出眩人的紫光，将$n" + HIM "裹在里面。\n" NOR;
  }
}
