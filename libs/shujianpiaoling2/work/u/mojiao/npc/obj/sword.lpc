//bandring.c  only used for wiz  written by john darks
#include <ansi.h>
inherit ITEM;
object offensive_target(object me);
string query_autoload() { return 1 + ""; }
void create()
{
 set_name("长剑", ({ "sword"}) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
set("long", "这是一把长剑。\n");
                set("unit", "个");
                set("value", 1000);
                set("no_get",1);
                set("no_drop",1);
                set("material", "steel");
                set("owner","darks");
        }
        setup();
}

void init()
{
        add_action("do_song","song");
        add_action("do_flee","flee");
        add_action("do_revive","revive");
        add_action("do_heal","heal");
        add_action("do_jiayi","km");
}

object offensive_target(object me)
{
        int sz;
        object *enemy;

        enemy = me->query_enemy();
        if( !enemy || !arrayp(enemy) ) return 0;

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;

        if( sz > 0 ) return enemy[random(sz)];
        else return 0;
}

int do_song(string arg)
{
        object target;
        object me=this_player();
        if (!arg) return 0;
        if(!(target= find_player(arg))) return 0;
        if (me->query("id")=="darks"){
                this_object()->move(target);
                this_object()->set("owner",arg);
                tell_object(me,"你给了"+target->name()+"一块石头。\n");
                tell_object(target,me->name()+"给了你一块石头。\n");
                return 1;
        }
        else return notify_fail("这东西不能随便给人！\n");
}

int do_revive(string arg)
{
        object target;
        object me=this_player();
        if (!arg) return notify_fail("你要救醒谁？\n");
        if(!(target=present(arg, environment(me)))) return notify_fail("你要救醒谁？\n");
        if(!target->is_character() )
                return notify_fail("你要救醒谁？\n");
        if( target->is_corpse() )
                return notify_fail("来不及了，只有活人才能救醒。\n");
        message_vision( HIY "$N"+HIY"一手放在$n"+HIY"的天灵盖上，一手贴在$n"+HIY"的后心，缓缓输入真气...\n" NOR, me, target);
        target->revive();
        return 1;
}

int do_heal(string arg)
{
        object target;
        object me=this_player();
        int max;
        if (!arg) target = me;
        else {
                if (!(target=present(arg, environment(me)))) return notify_fail("你要替谁疗伤？\n");
                if (!userp(target) && !objectp(target)) return notify_fail("你要替谁疗伤？\n");
        }
        target->clear_condition();
        if(target->is_ghost())
                target->reincarnate();
        target->delete("vendetta");
        target->set("bellicosity",0);
        target->set("eff_kee", (int)target->query("max_kee"));
        target->set("kee", (int)target->query("eff_kee"));
        target->set("eff_gin", (int)target->query("max_gin"));
        target->set("gin", (int)target->query("eff_gin"));
        target->set("eff_sen", (int)target->query("max_sen"));
        target->set("sen", (int)target->query("eff_sen"));
        max = ((int)target->query_skill("force", 1) + target->query_skill("force")/5) * 5 ;
        target->set("max_force", target->query("max_force")>max?target->query("max_force"):max); 
        target->set("force",target->query("max_force")*2);

        max = ((int)target->query_skill("spells", 1) + target->query_skill("spells")/5) * 5;
        target->set("max_mana",target->query("max_mana")>max?target->query("max_mana"):max); 
        target->set("mana",target->query("max_mana")*2);

        max = ((int)target->query_skill("magic", 1) + target->query_skill("magic")/5) * 5;
        target->set("max_atman",target->query("max_atman")>max?target->query("max_atman"):max); 
        target->set("atman",target->query("max_atman")*2);

        if (target==me)
                write( HIW "你全身放松，坐下来开始运功疗伤。\n" NOR);
        else{
                message_vision(
                HIY "$N"+HIY"坐了下来运起内功，将手掌贴在$n"+HIY"背心，缓缓地将真气输入$n"+HIY"体内....\n\n"
                "过了不久，$N"+HIY"额头上冒出豆大的汗珠，$n"+HIY"吐出一口瘀血，脸色看起来红润多了。\n" NOR,
                me, target );
        }
        return 1;
}

int do_flee(string arg)
{
        object target;
        object me=this_player();
        if (!arg) target = me;
        else {
                if (!(target=present(arg, environment(me)))) return notify_fail("你要替谁解穴？\n");
                if (!userp(target) && !objectp(target)) return notify_fail("你要替谁解穴？\n");
        }
        if (target==me ){
                if (!me->is_busy())  return notify_fail("你现在不忙，不必冲穴。\n");
                if(me->is_fighting()){
                        target = offensive_target(me);
                        message_vision(HIG"$N"+HIG"轻轻一笑，身形突然飘逸，随势一个跟斗，人已到了$n"+HIG"的身后！！\n"NOR,me,target);
                        message_vision(HIR"结果$N"+HIR"反而大惊失色，手忙脚乱！\n"NOR,target);
                        target->start_busy(1);
                        me->start_busy(1,2);
                }else{
                        message_vision(HIG"$N"+HIG"忽然嘻嘻一笑，徐徐吐出一口气，居然能动了！！\n"NOR,me);
                        me->start_busy(1,2);
                }
        }else{
                if (!target->is_busy())  return notify_fail("对方没有被点穴，不必解穴。\n");
                message_vision(HIG"$N"+HIG"轻笑一声，左手一扬，$n"+HIG"猛地吐出口气，居然能动了！！\n"NOR,me,target);
                target->start_busy(1,2);
        }
        return 1;
}

int do_jiayi(string arg)
{
        object target,weapon1,weapon2;
        object me=this_player();
        string msg;
        if (!arg) target = me;
        else if (!(target=present(arg, environment(me)))
                       || (!userp(target) && !objectp(target)) )
                                return notify_fail("护身罡气只能对自己使用！\n");
        if (target==me){
                if (me->query_temp("gangqi"))   return notify_fail("你已经发动了罡气！！\n");
                me->add_temp("apply/defense",500);
                me->add_temp("apply/armor",5000);
                me->add_temp("apply/extra_fle",1000);
                me->add_temp("apply/iron-cloth",500);
                message_vision(HIY"$N"+HIY"低喝一声，一股无比强大的气劲突然爆发出来，“呼”的一声，成环状散开！！\n"NOR,me);
                message_vision(HIY"这股罡气在$N"+HIY"身周形成一道气墙，令他人难以越近！！\n"NOR,me);
                me->set_temp("gangqi",1);
                call_out("del_gangqi",30,me);
        }else return notify_fail("护身罡气只能对自己使用！\n");
        return 1;
}

void del_gangqi(object me)
{
        if ( me->query_temp("gangqi") ){
                write("你收起了护身罡气！！\n");
                message("vision",HIY+me->name()+HIY"吸了口气，护身罡气突然消失！！\n"NOR,environment(me),me);
                me->add_temp("apply/defense",-500);
                me->add_temp("apply/armor",-5000);
                me->add_temp("apply/extra_fle",-1000);
                me->add_temp("apply/iron-cloth",-500);
                me->delete_temp("gangqi");
        }
}
