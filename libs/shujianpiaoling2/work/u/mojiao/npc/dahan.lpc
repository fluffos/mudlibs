inherit NPC;

void create()
{
        set_name("大汉", ({"dahan"}));
        set("age", 25);
        set("gender", "男性");
        set("long","一个体型魁悟的大汉，正在苦苦思索。\n");
        set("attitude", "peaceful");
	set("str", 70);
        set("combat_exp", 12000+random(3000));
        set("force", 200);
        set("force_factor", 3);
        set_skill("unarmed", 30);
        set_skill("dodge", 30);
        set_skill("parry", 30);
        setup();
        carry_object("/obj/cloth")->wear();
}

int accept_fight(object me)
{
        return 0;
}


