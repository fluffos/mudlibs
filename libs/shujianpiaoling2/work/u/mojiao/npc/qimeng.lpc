//qimeng.c written by john darks
#include <ansi.h>
inherit NPC;
void create()
{
	set_name("绮梦姑娘" , ({ "qi meng"}));
	set("long", "一位看上去柔情似水的姑娘。\n");
	set("attitude", "friendly");
	set("max_gin", 10000);
	set("max_kee", 10000);
	set("max_sen", 10000);
	set("age",26);
        set("gender", "女性" );
        set("title", "绮梦庄主");
	set("combat_exp", 500000);
	set("fle",300);
        set_skill("unarmed", 50);
        set_skill("sword", 185);
        set_skill("force", 90);
        set_skill("parry", 67);
        set_skill("dodge", 89);
        set_skill("literate", 50);
	setup();
	carry_object("/obj/cloth")->wear();
        carry_object("/obj/weapon/sword")->wield();
}

void init()
{
        object me = this_player();
        object ob = present("yu girl",environment(this_object()));
        if(interactive(me) && me->query_temp("mojiao/baochou")==4 )
        	if (objectp(ob))
        		call_out("chase_him", 1, ob);
        else if (interactive(me) && (me->query("gender") == "男性" || me->query_temp("mojiao/qimeng")==1))
        	call_out("chase_him",1, me);
}

void chase_him(object me)
{
        message_vision(CYN"$N向$n喝道："+ RANK_D->query_rude(me)+"，你几次三番来与我作对，本庄主哪能容你！\n"NOR,this_object(),me);
        kill_ob(me);
        me->kill_ob(this_object());
}

void die()
{
	object ob = this_object();
	object me = ob->query_temp("last_damage_from");
	message_vision(CYN"$N对$n惨然说道：你被小贱人迷惑了．．．你会后悔的．．．\n"NOR,ob,me);
	me->set_temp("mojiao/qimeng",3);
	environment(ob)->fulldown(me);
	::die();
}