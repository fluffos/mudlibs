//ghostmaster.c written by john darks
#include <ansi.h>
inherit NPC;
int ask_skill();
void create()
{
        set_name("七指煞君", ({ "master qizhi", "qizhi", "master"}) );
        set("title", HIC"勾漏双魔"NOR);
        set("nickname", HIR"不死修罗"NOR);
        set("gender", "男性" );
        set("age", 42);
        set("int",11);
        set("agi",35);
        set("str",60);
        set("max_force",5000);
        set("force", 8000);
        set("attitude", "peaceful");
        set_skill("literate",300);
        set_skill("blade", 210);
        set_skill("xiuluo-blade", 100);
        set_skill("yanyun-steps",90);
        set_skill("dodge",200);
        map_skill("dodge","yanyun-steps");
        map_skill("blade","xiuluo-blade");
        set("combat_exp", 9000000);
        set("inquiry", ([
                "学艺": (:ask_skill  :),
                "skill":(:ask_skill :),
        ]) );
        set("chat_chance", 1);
        set("chat_msg", ({
                "一阵风掠过，似乎刀光一闪，一刹那，你也分不清是刀风还是山风．．．”\n",
        }) );
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "blade.yidaoshan" :),
        }) );
        setup();
        carry_object(__DIR__"obj/crystalblade")->wield();
}

int is_ghost() { return 1; }

int recognize_apprentice(object ob)
{
        if( ob->query_temp("mojiao/ghostlearn") && this_object()->query("canlearn") )
                return 1;
        return 0;
}

int ask_skill()
{
        object ob = this_player();
        if (!ob->query_temp("mojiao/ghostlearn"))
                command("shake");
        else {
                tell_object(ob,"我只能传你几招［修罗刀法］(xiuluo-blade)的功夫！！\n");
        }
        return 1;
}

int accept_object(object who, object ob)
{
        int exp,pot,score;
        object me = who;
        if (ob->query("questobj") && ob->query("name")==HIC"天蚕斗笠"NOR){
                me->set_temp("mojiao/ghostlearn",1);
                this_object()->set("canlearn",1);
                return 1;
        }
}

void reset()
{
        this_object()->set("canlearn",0);
}
