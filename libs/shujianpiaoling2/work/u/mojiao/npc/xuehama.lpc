//xuehama.c written by john darks
inherit NPC;
void create()
{
        set_name("雪蛤蟆", ({ "snowfrog" }) );
        set("race", "野兽");
        set("age", 1);
	set("yes_carry", 1);
        set("long", "一只通体雪白的蛤蟆。\n");
        set("limbs", ({ "头部", "身体", "尾巴", "眼睛" }) );
        set("verbs", ({ "bite" }) );
        set_skill("dodge", 50);
	set_skill("move",300);
        set("combat_exp", 9999);
        set("questobj",1);
        set("questvalue",200);
	add_temp("apply/damage",30+random(20));
        setup();
}

void init()
{
  	if(this_player()==environment())
  		add_action("do_cure","cure");
 	add_action("do_get","get");
}

int do_cure()
{
	object me;
	me = this_player();
	message_vision("$N把雪蛤蟆用手捏住，闭上眼睛，一口吞了下去！\n",me);
	me->clear_condition();
        message_vision("$N的腹内＂隆隆＂作响！\n",me);
	destruct(this_object());
  	return 1;
}

int do_get(string arg)
{
	object me;
	me = this_player();
	if (!arg ||arg!="snowfrog") return 0;
	if (environment()==this_player())
		return 0;
	message_vision("$N轻轻的捧起雪蛤蟆，笑嘻嘻的自言自语：好可爱。说着将雪蛤蟆偷偷纳入怀中。\n",me);
	this_object()->move(me);
	call_out("jump_out",30);
  	return 1;
}

void jump_out()
{
	object ob = this_object();
	object me = environment(ob);
	if (environment(ob)->is_character())
		message_vision("$N忽然露出奇怪的笑容，只见$N怀中一阵骚动，跳出一只可爱的雪蛤蟆来。\n",me);
	ob->move(environment(me));
	return;
}