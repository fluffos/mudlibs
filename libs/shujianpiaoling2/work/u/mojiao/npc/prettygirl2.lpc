#include <ansi.h>
inherit NPC;
void create()
{
	set_name( "天魔女", ({ "tianmo", "girl" }) );
	set("long", "她身穿轻纱柔丝，白足如霜，青丝飘扬。\n");
	set("attitude", "friendly");
	set("title", HIG "梦如人生" NOR);
	set("max_gin", 500);
	set("max_kee", 500);
	set("max_sen", 500);
	set("age", 17);
        set("gender", "女性" );
	set("str", 35);
	set("cor", 30);
	set("cps", 25);
	set("per", 40);
	set("combat_exp", 50000);
	set_skill("unarmed", 1+random(200));
	setup();
        add_money("gold", 5);
}

int accept_fight(object me)
{
	command("say 小女子哪里是您的对手？");
	message_vision(CYN"$N双目含幽，深情的注视着$n，$n只觉心神荡漾．．．\n"NOR,this_object(),me);
	tell_object(me,"如果你感兴趣，可以(enjoy)\n");
	return 0;
}

int accept_object(object me, object obj)
{
        command("smile");
        command("say 多谢这位" + RANK_D->query_respect(me) +"！");
        return 1;
}

