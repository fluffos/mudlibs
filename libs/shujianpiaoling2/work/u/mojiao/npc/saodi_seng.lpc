//saodi_seng.c written by john darks
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int about_me();
int about_book();
void create()
{
        set_name("扫地僧", ({ "saodi seng", "seng", "wu qiu"}) );
        set("title","少林寺老僧");
        set("vendetta_mark","shaolin");
        set("gender", "男性" );
        set("age", 101);
	set("per", 25);
        set("int",30);
        set("str",80);
        set("cor",100);
        set("agi",100);
	set("attitude","friendly");
	set("max_kee",30000);
	set("max_sen",30000);
	set("max_gin",30000);
        set("max_force", 1500);
        set("force", 1500);
        set_temp("apply/damage",200);
        set("long","这是一位专职负责清埽工作的寺内杂役僧人。\n");
        create_family("少林寺", 9, "大师");
        set("class","bonze");
        set("chat_chance", 1);
        set("chat_msg", ({
        	this_object()->query("name")+"低诵道：天悠悠不期而来！\n",
        	this_object()->query("name")+"低诵道：随缘而去，一苇渡江。\n",
        	this_object()->query("name")+"低诵道：阿弥陀佛，善哉善哉。\n",
        	this_object()->query("name")+"低诵道：地茫茫不辞而别！\n",
        }) );
        set("inquiry", ([
                "name" : (: about_me :),
                "姓名" : (: about_me :),
                "无求" : (: about_me :),
                "秘籍":(:about_book:),
                "book":(:about_book:),
        ]));
        set("combat_exp", 9000000);
        set_skill("move", 190);
        set_skill("dodge", 190);
        set_skill("force", 190);
        set_skill("literate", 190);
	set_skill("unarmed",400);
	set_skill("buddhism",350);
	set_skill("luohan-ken",400);
	//set_skill("lighting_ken",200);
	set_skill("tongzi-force",300);
	//set_skill("yiwei-steps",190);
	map_skill("force","tongzi-force");
	map_skill("unarmed", "luohan-ken");
	map_skill("dodge","yiwei-steps");
        setup();
        carry_object("/obj/cloth")->wear();
        carry_object(__DIR__"questobj/yiwei-book");
}

void attempt_apprentice(object me)
{
	command("shake");
	command("say 老衲年事已高，你还是去找掌门吧！\n");
}

int about_me()
{
	say("老和尚单掌成什，低声诵道：阿弥陀佛，老衲正是无求。\n");
	this_object()->set_name("无求", ({ "saodi seng", "wu qiu" ,"seng"}));	
	this_player()->set_temp("mojiao/slquest",1);
	return 1;
}

int about_book()
{
	object me = this_object();
	object ob = this_player();
	if (ob->query("class")=="shaolin" && ob->query("PKS") < 20 
		&& ob->query_kar() > 35
		&& (int)ob->query_temp("mojiao/slquest")){
		say("无求低声道：阿弥陀佛，小施主与老衲倒是颇有缘分。\n");
		command("give yiwei-book to "+ob->query("id"));
		ob->set_temp("mojiao/slquest",0);
	}else{
		say("老和尚低声道：阿弥陀佛，小施主与老衲无缘，还是请回吧。\n");
		ob->set_temp("mojiao/slquest",0);
	}
	return 1;
}