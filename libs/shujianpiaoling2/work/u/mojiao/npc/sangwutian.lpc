#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
	set_name("桑无天", ({ "master sang", "sang", "master" }));
	set("title", "魔教长老");
	set("gender", "男性");
	set("age", 66);
	set("nickname", HIG "黑星君" NOR);
	set("attitude", "peaceful");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 100);
        set("combat_exp", 15000000);
        set("score", 20000);
        set_skill("force", 50);
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_skill("huashu-steps", 250);
        set_skill("wusha-strike", 220);
        set_skill("senluo-force", 250);
        set_skill("hansha-force",100);
        set_skill("leaf-strike",60);
        map_skill("blade", "xiuluo-blade");
        map_skill("force", "senluo_force");
        map_skill("dodge","huashu-steps");
        map_skill("unarmed", "wusha-strike");
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.wushalihun" :),
        }) );
	create_family("魔教",2, "长老");
	set("class", "mojiao");
	setup();
	carry_object("/obj/cloth")->wear();
	carry_object("/obj/weapon/blade")->wield();
}

void attempt_apprentice(object ob)
{
      	if( ob->query("id_type")==1 ) {
		command("say 你身为正派弟子，哪里会诚心拜师？正邪势不两立！\n");
	    	return;
      	}
      	if(ob->query("mojiao/弃子")) {
		command("say 你没有资格成为我的弟子！\n");
	    	return;
      	}
      	if ((int)ob->query_skill("senluo-force", 1) < 80) 
      	{
		command("say " + RANK_D->query_respect(ob) + "是否还应该多练练森罗万象变？");
		return;
	}
	if( ob->query("id_type")!= 1 && ob->query("marks/帮派")=="魔教" && ob->query("mojiao/势力")=="教主系"){
		message_vision(CYN"桑无天说道：“好吧, 我就收下你了。”\n"NOR,ob);
       		command("recruit " + ob->query("id"));
		ob->set("class", "mojiao");
		ob->set("id_type", 2);
	}else command("say 今天我不想收徒。\n");
       	return;
}
