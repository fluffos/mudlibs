inherit ROOM;
void create()
{
	set("short", "石牛古洞");
        set("long",@LONG
这里是石牛古洞，洞里曲折不平，加上阴暗潮湿。实在让人看不清楚
景物，远处似乎隐隐传来人走动的脚步声，很轻的脚步声。
LONG
        );
        set("exits", ([
		"west" : __DIR__"gudong11",
		"north" : __DIR__"gudong8",
		"south" : __DIR__"gudong4",
        ]));
        set("no_cleab_up",0);
        setup();
        replace_program(ROOM);
}
