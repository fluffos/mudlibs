//gudong10.c written by john darks
inherit ROOM;
void create() {
  set("short", "石牛古洞");
  set("long", @LONG
此处有一个小洞口，乃是通往山外的一条通道。此洞连接着石牛古洞。
别看古洞前面那么大，可是很难令人想到，石牛古洞的出口竟然会那么
小。洞口铺上了花石块儿。显得更加精细。
LONG
  );
  set("exits", ([
    "east": __DIR__ "gudong8",
    "west": __DIR__ "gudong9",
    "north": __DIR__ "shanroad4",
    "down": "/u/dahui/xie/shilin00",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  object ob, room;
  if (interactive(ob = this_player()) && ob->query_temp("wangsha/wfrom") == "south") {
    set("long", @LONG
此处有一个小洞口，乃是通往山外的一条通道。此洞连接着石牛古洞。
别看古洞前面那么大，可是很难令人想到，石牛古洞的出口竟然会那么
小。洞口铺上了花石块儿。显得更加精细。
LONG);
  } else {
    set("long", @LONG
穿过小山洞，里面豁然开朗，但却更阴暗了，四周寂静，只有深处偶尔传
来滴答的水滴声。
LONG);
  }
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "north") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
