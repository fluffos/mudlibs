//lowriver2.c written by john darks
#include <login.h>
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "激流下游");
        set("long", @LONG
这里的河床极窄，水流更加湍急。无风但河浪汹涌，稍有不慎就会
被河浪卷走。只有武功极高之人才敢涉足。
......水流越来越急，几乎已经立不住足了......
LONG
        );
	set("outdoors","tianzhu");
        set("objects", ([
                __DIR__"npc/eyu2" :2,
                        ]) );
	setup();
}

void init()
{
	if(interactive(this_player()))
		call_out("do_flush",10,this_player());
	add_action("do_climb","climb");
}

void do_flush(object me)
{
	if(!me || environment(me) != this_object())
		return;
	tell_object(me,HIR"\n一阵暗流涌来，你被冲的气血沸腾．．看来要赶快爬(climb up)上岸去。\n"NOR);
	me->receive_damage("kee",30+random(20),me);
	remove_call_out("do_flush");
	call_out("do_flush",5,me);
	call_out("do_drop",30,me);
}	

int do_climb(string arg)
{
	object me = this_player();
	object room;
	if (arg!="up")
		return 0;
	message_vision("$N手足并用，拼命的游向岸边。\n",me);
	if (random(me->query_kar())>24 && me->query_cps()>29){
		message_vision("$N手足并用，狼狈的爬上了岸边。\n",me);
		if (!objectp(room = find_object(__DIR__"luwei2")))
			room = load_object(__DIR__"luwei2");
		me->move(room);
		message("vision",me->name()+"狼狈的从激流中爬了上来。\n",room,me);
	}
	else    message_vision("$N手足并用，刚碰到岸边，立刻被激流冲了回来。\n",me);
	return 1;
}

void do_drop(object me)
{
	object room,corpse,*inv;
	int i;
	if(!me || environment(me) != this_object())
		return;
	tell_object(me,HIR"\n一阵暗流涌来，你再也坚持不住，立被激流冲了下去。\n"NOR);
	if( userp(me)) {
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++) {
                        if(inv[i]->name() == "芦苇" && me->query_kar()>29 && me->query_fle()>15) {
                        	me->unconsious();
                        	message("vision",me->name()+"被激流冲走了。\n",environment(me),me);
                        	if (!objectp(room = find_object(__DIR__"pubu1")))
					room = load_object(__DIR__"pubu1");
				me->move(room);
				message("vision",me->name()+"被瀑布冲了下来，在潭中一沉一浮，又被冲到了岸边。\n",room,me);
				return ;
                        }
                }
                me->clear_condition();
		message_vision("\n$N死了。\n\n", me);
		CHANNEL_D->do_channel(this_object(), "rumor",me->name(1) + "被激流淹死了！\n");
		if( objectp(corpse = CHAR_D->make_corpse(me, me)) ){
			if (!objectp(room = find_object(__DIR__"pubu1")))
					room = load_object(__DIR__"pubu1");
			message("vision",me->name()+"的尸体被激流冲走了。\n",environment(me),me);
			corpse->move(room);
			message("vision","一具尸体被瀑布冲了下来，在潭中一沉一浮，又被冲到了岸边。\n",room);
		}
		me->remove_all_killer();
		me->dismiss_team();
		if( userp(me) ) {
			me->set("gin", 1);	me->set("eff_gin", 1);
			me->set("kee", 1);	me->set("eff_kee", 1);
			me->set("sen", 1);	me->set("eff_sen", 1);
			me->be_ghost(1);
			me->save();
			me->move(DEATH_ROOM);
			DEATH_ROOM->start_death(me);
		}
		else	destruct(me);
        }
}