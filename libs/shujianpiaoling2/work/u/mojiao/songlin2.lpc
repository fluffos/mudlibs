inherit ROOM;
void create() {
  set("short", "紫松林");
  set("long", @LONG
此处乃是一片树林，林子里的树木的年岁想来已是久远。合抱之木比
比皆是。地下沉积着厚厚的松针叶，把地都铺成了黄色。树枝铺天盖地，
将天空几乎遮了个严严实实。这里时不时你还可以见到一些山雀，松鼠
之类的小动物。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "westup": __DIR__ "mihun",
    "southeast": __DIR__ "overiver",
  ]));
  set("objects", ([
    __DIR__ "npc/bird": 2,
    __DIR__ "npc/songshu": 1,
    __DIR__ "npc/dahan": 1,
  ]));
  setup();
  replace_program(ROOM);
}
