inherit ROOM;
void create()
{
        set("short", "地牢");
        set("long", @LONG
阴森的地牢，潮湿中飘动着腐尸的味道。
LONG
        );
        set("exits", ([
        	"north":__DIR__"qimeng4",
	]));
	set("objects", ([
                __DIR__"npc/mice" : 1,
                __DIR__"npc/mouse" :2,
                __DIR__"npc/badbug":1,
        ]));
	setup();

}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "north" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}

