#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("孟寿昌", ({ "master meng", "master", "meng" }) );
        set("nickname", HIG"蛊神"NOR);
        set("gender", "男性" );
        set("age", 54);
        set("str", 90);
        set("cor", 30);
        set("cps", 30);
        set("int", 30);
	set("per", 30);
//	set("attitude","aggresive");
        set("max_gin", 2500);
        set("max_kee", 2500);
        set("max_sen", 2500);
        set("eff_gin", 1500);
        set("eff_kee", 1500);
        set("eff_sen", 1500);
        set("max_force", 15000);
        set("force", 15000);
        set("force_factor", 30);
        set("long",
"
孟寿昌学艺于自然，以最毒之物为师，一身毒气杀人于无形, 更精于蛊术．．
\n"
	);
        create_family("披麻教", 1, "教主");
        set("class", "pima");

        set("combat_exp", 9000000);
        set("score", 200000);
        set("chat_chance", 10);
        set("chat_msg", ({
                                (: random_move :)
        }) );

        set_skill("move", 200);
        set_skill("parry", 180);
        set_skill("stick", 150);
        set_skill("unarmed", 160);
        set_skill("kusang-bang", 140);
        set_skill("black_claw", 160);
        set_skill("dodge", 200);
        set_skill("force", 250);
        set_skill("blood_force", 250);
        set_skill("literate", 90);
	set_skill("cursism",250);
	set_skill("celecurse",250);
	map_skill("force", "blood_force");
	map_skill("cursism","celecurse");
	map_skill("unarmed", "black_claw");
	map_skill("stick", "kusang-bang");
	set("chat_chance_combat", 30 );
	set("chat_msg_combat", ({
		(: command, "curse noname" :),
	}) );

        setup();
        carry_object(__DIR__"obj/wuchangbang")->wield();
        carry_object(__DIR__"obj/ducloth")->wear();
}

void attempt_apprentice(object me)
{
	if( me->query("class")=="pima"){
      if(me->query_skill("cursism",1) < 100) {
	    command("say 本教专修蛊术，你显然还没有修炼到家，做不成我的弟子。\n");
	    return;
	}	
	else
	command("smile");
        command("recruit " + me->query("id") );
	}
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "pima");
                ob->set("id_type", 2);
}
 
void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","披麻教众");
                return ;
        } else if ( exp <= 64000 ) {
                student->set("title","披麻教副堂主");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","披麻教堂主");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("title","披麻教副坛主");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","披麻教坛主");
                return ;
        } else if ( exp <= 1024000 ) {
                student->set("title","披麻教副舵主");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","披麻教舵主");
                return ;
        } else if ( exp <= 2304000 ) {
                student->set("title","披麻教护法");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","披麻教大护法");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","披麻教长老");
                return ;
        } else if ( exp <= 26244000 ) {
                student->set("title","披麻教大长老");
                return ;
        } else
                student->set("title","披麻教副教主");
                return ;
}

