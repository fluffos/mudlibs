#include <ansi.h>
#include <combat.h>
inherit NPC;
int do_detect(object me);

void create()
{
	set_name("傀儡蛊", ({ "kuileigu" }) );
	set("gender", "男性");
	set("age", 20);
	set("long", "这是一个神秘而又可怕的傀儡蛊. \n");
	set("str", 48);
	set("cor", 52);
	set("cps", 22);
	set("food", 200);
	set("no_drop",1);
	set("no_get",1);
	set("fake_name", "傀儡");
	set("max_kee", 600);
	set("max_gin", 600);
	set("max_sen", 600);
	set("attitude", "aggressive");
	set("combat_exp", 2000);
        set("chat_chance", 50);
        set("chat_msg", ({
                (: do_detect :),
        }) );
	
	setup();
}
void init()
{
	add_action("do_look","look");
}
int do_look(string arg)
{

if (arg == "kuileigu" )
{
write("这是一个神秘而又可怕的傀儡蛊. \n");
return 1;
}
return 0;
}

int do_detect(object me)
{
	string msg, fakename;
	object target;
	me=this_object();
	target = environment(me);
	if( !target )  return 1;
	if( !userp(target) )  return 1;
	fakename = me->query("fake_name");
        msg = HIB + fakename + "嘿嘿冷笑，黑暗中向$n发起突然攻击！\n"NOR;
	if( target->query_skill("iron-cloth")>100 )
	me->set_temp("apply/damage", 500);	
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	tell_object(target, BLU "\n你只听到一个声音在耳边说道：你就算逃到天涯海角，也逃不出我的掌心！\n" NOR );
	if( me->query("food") < 50 )
	{
	tell_object(target, BLU + fakename + "的声音“哼”了一声，渐渐远去了！\n" NOR );
	if( !userp(me) )  destruct(me);
	}
	return 1;
}

void die()
{
	destruct(this_object());
}
