#include <ansi.h>

inherit NPC;

void create() {
  set_name(RED "军士" NOR, ({ "jun shi", "shi" }));
  set("title", RED "招募新丁" NOR);
  set("long", "一个精明强干的军士，负责登录新兵。\n");
  set("attitude", "heroism");
  set("age", 20);
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("chat_chance", 5);
  set("chat_msg", ({
    "军士卖力的喊着：“守土卫国，人人有责，适龄青年，踊跃入伍！\n", })
  );
  set("vendetta_mark", "authority");  //设置自动追杀反官府的敌人
  set("combat_exp", 8000);
  set_skill("spear", 60);
  set_skill("unarmed", 50);
  set_skill("blade", 60);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set_skill("move", 50);
  set_skill("yang_spear", 50);     //杨家枪法
  set_skill("xingyi-ken", 50);     //形意拳
  set_skill("duanmen_blade", 50);  //五虎断门刀法
  set_temp("apply/dammage", 20);
  set_temp("apply/defense", 20);
  set_temp("apply/attack", 20);
  map_skill("unarmed", "xingyi-ken");
  map_skill("unarmed", "whdm-blade");
  map_skill("spear", "yang_spear");
  setup();

  carry_object("/obj/cloth/tiejia")->wear();
  carry_object("/d/city/obj/weapon/blade/blade")->wield();
}
