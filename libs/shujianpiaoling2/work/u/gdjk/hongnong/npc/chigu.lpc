void re_rank(object student) {
  int exp;
  string name;
  exp = (int)student->query("relation_exp") * 10 + (int)student->query("combat_exp");
  if (exp <= 1000) {
    student->set("title", "军士");
    return;
  } else if (exp <= 5000) {
    student->set("title", "旗牌官");
    return;
  } else if (exp <= 10000) {
    student->set("title", "校尉");
    return;
  } else if (exp <= 15000) {
    student->set("title", "都尉");
    return;
  } else if (exp <= 21001) {
    student->set("title", "参将");
    return;
  } else if (exp <= 31030) {
    student->set("title", "裨将军");
    return;
  } else if (exp <= 53100) {
    student->set("title", "偏将军");
    return;
  } else if (exp <= 102000) {
    string *lastname = ({ "安国", "横江", "虎贲" });
  }
}
