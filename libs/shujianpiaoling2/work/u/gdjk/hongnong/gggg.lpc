#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "营门");
  set("long", @LONG
这里是本地守军的大门，门口站着两个身穿铁甲的军兵，从门
里传出阵阵的响亮口号声。从木栅栏的缝隙中隐约可以看到刀
枪闪亮的光影。门口木牌上贴着一张《告示》。旁边有一大群
人排成长队在干些什么。
LONG
  );
  set("item_desc", ([
    "告示": @TEXT
               征兵告示
奉天承运，皇帝昭曰：
    广守疆土，克尽职者，庇佑吾民，修武备，勤操练，
    企天报我国万事长安。乃募天下有勇力者。入行伍，
    以卫土也。特此昭曰。
                                 建武元年.
TEXT
  ]));
  set("objects", ([
    __DIR__ "npc/officer": 1,
    __DIR__ "npc/bing": 2,
  ]));
  set("exits", ([
    "west": "/d/city/zhuque-n2",
    "enter": __DIR__ "jiaochang",
  ]));
  setup();

}

void init() {
  add_action("do_baoming", "baoming");
}

int do_baoming(string arg) {

  object me;
  me = this_player();
  if (arg)
    return notify_fail("想投军？报名(baoming)吧.\n");
  if (!present("jun shi", this_object()))
    return notify_fail("现在暂时不接受报名，也不急在一时休息休息一会儿\n");
  if (me->query("solider") || me->query("class") == "official")
    return notify_fail("军士摆了摆手：“你想混军饷呀？我们只接受白身的乡勇。”\n");
  message_vision("军士点了点头，：“好的好的，保家卫国，男儿本色！好好干吧！”\n", me);
  write("从现在起你就是一名光荣的士兵了。要学习雷锋叔叔好榜样，作一个毛主席他老人家的好战士！\n");
  me->set("solider", 1);
  me->set("title", RED "长安军兵" NOR);
  me->set("class", "official");
  me->set("vendetta_mark", "authority");
  write("新兵蛋子，你可以到兵器库去领取装备!\n");
  return 1;
}

int valid_leave(object who, string exit) {
  string title;
  title = who->query("title");

  if (exit != "enter") return 1;
  if (!present("bing", this_object())) return 1;
  if (who->query("solider")) return 1;






  if (who->query("id_type") == 4) {
    message_vision("军兵对$N行军礼道：“" + title + "长官，请进,这里是RED 长安城守军驻地. NOR”\n", who);
    return 1;
  }
  return notify_fail("军兵摇了摇手道：“这里是军机重地，没有事情赶快离开。”\n");

}
