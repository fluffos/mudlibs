#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_AUTOLOAD;
void create() {
  set_name(HIC "毒谷佩剑" NOR, ({ "sword" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "三尺的长剑，寒光展露出摄人的锋芒.\n");
    set("value", 5000000);
    set("material", "steel");
    set("no_drop", "这样东西不能离开你。\n");
    set("no_give", "这样东西不能给人。\n");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中，只觉一股寒气扑面而来。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘，只听嗤的一声轻响。\n");
  }
  init_sword(65);

  setup();

}
void init() {
  add_action("do_look", "look");
}

int do_look(string arg) {
  string name;
  name = this_object()->query("owner");
  if (arg == "peijian") {
    tell_object(this_player(), HIC "细长的剑身，光芒流转剑刃透露着摄人的寒意\n" NOR);
    tell_object(this_player(), "剑锷上篆刻逍遥:\n" + name + "佩\n");
    return 1;
  }
  return 0;
}

int query_autoload() {
  string name;
  if (this_player()->query("name", "gdjk")) {
    name = this_player()->query("name");
    this_object()->set("owner", name);
    return 1;
  }
  return 0;

}
