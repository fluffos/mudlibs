//fallwater.c
#include <ansi.h>
inherit ROOM;
void task(object who);
void create()
{
  set("short","瀑布内");
  set("long",@LONG
强大的水流从高处铺泻而下，自然的惊人威力如斯无匹，你拼命
抵抗着巨大的冲力，仍然感觉自己的身体似乎就要飞逝而出。
LONG
);
 set("exits",([
  "out":__DIR__"fall3",
]));
  setup();
}

void init()
{
        object ob;

        if( interactive(ob = this_player()) && living(this_player())) {
        remove_call_out("task");
        call_out("task",1,this_player());
        }
}

void task(object who)
{
  int n;
  if( !who || !present(who) ) 
    {
     remove_call_out("task");
     return;
    }
  n=who->query_skill("force",1);
  if(n>150){
   write(WHT "你感觉水流柔顺的随着你的体形划过，忽然想起呀！的确该洗个澡了.\n" NOR);
   return; 
   }
  who->add("gen",-10);
  who->add("gin",-10);
  who->receive_damage("kee",30);
  who->receive_wound("kee",10);
  who->improve_skill("force",random((int)who->query("int") + (int)who->query_skill("force",1)/10));
  write(HIC "水无常形，水无常势，而功力的运行也应象这水流运转流畅\n" NOR);
  remove_call_out("task");
  call_out("task",3,who);
  return ;
}

int valid_leave(object who, string exit)
{
   remove_call_out("task");
   return 1;
}
