"赞军校尉","护军校尉","管军校尉","统兵校尉",
"殿中校尉",
"帐前校尉" NOR});
           name = lastname[random(sizeof(lastname))];  
                student->set("title", name);
                return ;
        } else if ( exp <=300000  ) {
  string* lastname = ({RED "骑都尉","帐前都尉","泰山都尉",
