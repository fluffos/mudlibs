void re_rank(object student)
{
        int exp;
         string name;
        exp = (int) student->query("relation_exp")+(int) student->query
("combat_exp")+query("life_exp")*5;
        if( exp <= 50000 ) {
                student->set("title",RED "军士" NOR);
                return ;
        } else if ( exp <= 100000 ) {
                student->set("title",RED "旗牌官" NOR);
                return ;        
        } else if ( exp <= 200000 ) {
         string* lastname = ({RED "典军校尉","司隶校尉",
"左军校尉","右军校尉","后军校尉",
"中军校尉","越骑校尉","骁骑校尉",
"城门校尉","行军校尉","平虏校尉",
"折冲校尉","军前校尉",
