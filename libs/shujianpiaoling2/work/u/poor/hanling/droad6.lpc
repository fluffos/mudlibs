// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create()
{
	set("short", "地道");
	set("long", @LONG
你走在寒灵山附近的地道之中，这里光线十分昏暗，几乎
看无清四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。北边
有道石门，石门上有个水形的凹槽。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
    "southeast" : __DIR__"droad5",
]));
	setup();
}
void init()
{
        add_action("do_use", "use");
}
int do_use(string arg)
{
	object me,ob;
	me = this_player();

	if( arg=="水形令牌" || arg=="lingpai" ) {
	if (!objectp(ob = present("lingpai", me))) {
		     write("你用的这个东西怎么也插不合适。\n");
	       return 1;
		}
       	message_vision("$N把水形令牌插了进去，“咚”的一声，石门开了，你走了进去。\n",me);
	       me->move(__DIR__"dbingpo");
       	return 1;
	}
	else return 0;
}




