// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create()
{
	set("short", "地道");
	set("long", @LONG
你走在寒灵山附近的地道之中，这里光线十分昏暗，几乎
看无清四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。在右
边有一块巨石，堵住了一条路。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
    "east" : __DIR__"dyijin2",
]));
	set("objects", ([ 
		__DIR__"obj/rock" : 1,
]));
	setup();
}
void init()
{
	add_action("do_move", "move" );
}

int do_move(string arg)
{
	object me,ob;
	me = this_player();

	if( arg=="rock" || arg=="巨石" || arg=="大岩石"  ) {
	if (!objectp(ob = present("yj-jing", me))) {
       	message_vision("$N用力挪开巨石，向巨石后的岔路走去。\n",me);
	       me->move(__DIR__"droad3");
	       return 1;
		}
       	message_vision("$N用力挪开巨石，向巨石后的岔路走去。\n",me);
	       me->move(__DIR__"dfang");
       	return 1;
	}
	else return 0;
}


