// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create() {
  set("short", "地洞");
  set("long", @LONG
这是一个天然形成的地洞，四周都是泥土。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "泥土": "在右边的泥土中嵌着块石头，石头上没粘一点泥土。
",
  ]));

  set("exits", ([ /* sizeof() == 3 */
    "up": __DIR__ "shulin2",
  ]));

  setup();
}

void init() {
  add_action("do_zhuan", "zhuan");
}

int do_zhuan(string arg) {
  if (arg == "石头" || arg == "stone") {
    message_vision("$N用手转了一下石头，结果左边出现了个暗门。\n", this_player());
    message_vision("$N走了进去。\n\n", this_player());
    this_player()->move(__DIR__ "droad1");
    message("vision", this_player()->name() + "走进了暗门。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
