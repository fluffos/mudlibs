// wu
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;

void create()
{
	set_name("寒芳", ({ "han fang", "master" }) );
	set("gender", "女性");
       set("title", "寒灵山庄电剑堂堂主");
	set("age",25);
       set("attitude", "aggressive");
	set("str", 40);
	set("per", 40);
	set("long",@LONG
她就是江湖上传言的寒灵四高手之一的[电]。
LONG
	);
        set("max_kee", 3000);
        set("kee", 3000);
        set("force", 2000+random(2500));
        set("max_force", 3000);
        set("force_factor",20+random(60));
        set("combat_exp", 500000+random(800000));

        set("chat_chance_combat", 10);
        set("chat_msg_combat", ({
                (: perform_action, "dodge.guixi" :),
                (: perform_action, "dodge.baoxing" :),
        }) );

        set_skill("unarmed", 100+random(80));
        set_skill("blade", 100+random(80));
        set_skill("parry", 100+random(80));
        set_skill("dodge", 100+random(80));
        set_skill("xianyin_blade", 100+random(80));
        set_skill("xianglong_strike", 100+random(80));
        set_skill("hidden_dodge", 100+random(80));
        set_skill("canyun_force", 100+random(80));

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "xianglong_strike");
        map_skill("blade", "xianyin_blade");
        map_skill("parry", "xianyin_blade");
        map_skill("force", "canyun_force");


	create_family("寒灵山庄", 2, "弟子");

	setup();
	carry_object("/u/poor/obj/weapon/blade")->wield();
	carry_object("/u/poor/obj/cloth/heiyi")->wear();
}

void attempt_apprentice(object ob)
{
	int exp = (int)ob->query("combat_exp");
	if( exp > 5000000) {
       command("smile");
       command("say 很好，" + RANK_D->query_respect(ob) + 
"跟随我修炼，他日必定有成。\n");
       command("recruit " + ob->query("id") );
       ob->set("class", "hanling");
	}
	else {
	command("say 这位" + RANK_D->query_respect(ob) + "不要异想天开了，我怎么能收你为徒。\n");
	}
}

void die(object me, object ob)
{
        int exp,pot;
        me=this_player();
        exp = (int) me->query("combat_exp");
        pot = (int) me->query("potential");
	tell_object(me,HIY"寒芳被打伤在地，奄奄一息了，说道：寒灵山庄的人一定会给我报仇的！！\n"NOR);
	tell_object(me,HIY"恭喜你！！你杀死了这个江湖大魔头！！\n\n"NOR);
	tell_object(me,HIM"你增加了50000点经验。\n"NOR);
	tell_object(me,HIM"你增加了10000点潜能。\n\n"NOR);
       me->set("combat_exp", (int) exp + 50000);
       me->set("potential", (int) pot + 10000);
	 me->set("marks/killfang", 1);
        ::die();
}




