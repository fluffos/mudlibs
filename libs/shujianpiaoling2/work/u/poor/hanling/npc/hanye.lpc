// wu
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;

void create() {
  set_name("寒叶", ({ "han ye", "master" }));
  set("gender", "女性");
  set("title", "寒灵山庄轻风堂堂主");
  set("age", 40);
  set("str", 40);
  set("per", 40);
  set("long", @LONG
她就是江湖上传言的寒灵四高手之一的[风]。
LONG
  );
  set("max_kee", 3000);
  set("kee", 3000);
  set("force", 2000 + random(2500));
  set("max_force", 3000);
  set("force_factor", 10 + random(60));
  set("combat_exp", 500000 + random(1000000));

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.guixi" :),
    (: perform_action, "dodge.baoxing" :),
  }));

  set_skill("unarmed", 100 + random(100));
  set_skill("blade", 100 + random(100));
  set_skill("parry", 100 + random(100));
  set_skill("dodge", 150 + random(100));
  set_skill("xianyin_blade", 200);
  set_skill("hidden_dodge", 100 + random(100));
  set_skill("canyun_force", 100 + random(100));

  map_skill("dodge", "hidden_dodge");
  map_skill("blade", "xianyin_blade");
  map_skill("parry", "xianyin_blade");
  map_skill("force", "canyun_force");


  create_family("寒灵山庄", 2, "弟子");

  setup();
  carry_object("/u/poor/obj/weapon/blade")->wield();
  carry_object("/u/poor/obj/cloth/heiyi")->wear();
}

void attempt_apprentice(object ob) {
  int exp = (int)ob->query("combat_exp");
  if (exp > 5000000) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) +
      "跟随我修炼，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "hanling");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "不要异想天开了，我怎么能收你为徒。\n");
  }
}

void die(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");
  tell_object(me, HIY "寒叶被打伤在地，奄奄一息了，说道：[雷]、[电]一定会给我报仇的！！\n" NOR);
  tell_object(me, HIY "恭喜你！！你杀死了这个江湖大魔头！！\n\n" NOR);
  tell_object(me, HIM "你增加了100点潜能。\n\n" NOR);
  me->set("potential", (int)pot + 100);
  ::die();
}
int recognize_apprentice(object ob) {
  if (!ob->query("marks/hanye")) {
    say("寒叶说道：你是谁？\n");
    return 0;
  }

  return 1;
}

int accept_object(object who, object ob) {
  if (!who->query("marks/hanye")) {
    if ((string)ob->query("id") != "qingming-sword") {
      say("寒叶说道：不要无事生非了。\n");
      return 0;
    } else {
      say("寒叶说道：多谢你了，我本想杀上少林，去取剑的。\n\n");
      message_vision("寒叶传授$N有关[弦音刀法]的秘诀，$N似乎有所领悟。\n", who);
      tell_object(who, HIC "你的「弦音刀法」进步了！\n" NOR);
      who->set("marks/hanye", 1);
      who->set_skill("xianyin_blade", 1);
      who->set("title", "寒灵山庄庄客");
      return 1;
    }
  } else
    say("寒叶说道：多谢你了。\n");
  return 1;
}
