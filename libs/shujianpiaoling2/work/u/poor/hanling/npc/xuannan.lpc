// xuanbei.c 玄悲

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("玄难", ({ "xuan nan", "xuannan", "master", }));
  set("long",
    "他就是数十年前追查《易筋经》下落而失踪的高僧。\n"
  );

  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin");

  set("inquiry", ([
    "空见": "空见是现任少林主持。\n",
    "受伤": "唉。别天帝老儿诱到此处，不甚被捉。\n",
    "易筋经": "没有《易筋经》，我怎么去见师傅无边大师呀。\n",
    "无边大师": "因为天帝假扮头陀偷走了《易筋经》，无边大师立誓不回少林。\n",
    "治伤": "我已经活不长了，可《易筋经》。。。。。。。\n",
  ]));

  set("age", 85);

  set("max_gin", 2500);
  set("max_kee", 5000);
  set("eff_kee", 2000);
  set("kee", 2000);
  set("max_sen", 2500);
  set("force", 10000);
  set("max_force", 5000);
  set("force_factor", 180);
  set("combat_exp", 5000000);

  set_skill("force", 300);
  set_skill("fuxiang_force", 300);
  set_skill("weituo_chu", 300);
  set_skill("dodge", 300);
  set_skill("shaolin-dodge", 300);
  set_skill("staff", 300);
  set_skill("yizhi-chan", 300);
  set_skill("parry", 300);
  set_skill("unarmed", 300);
  set_skill("jingang-strike", 50);
  set_skill("damo-force", 300);
  set_skill("hammer", 300);

  set_skill("essencemagic", 200);
  set_skill("buddhism", 300);
  set_skill("magic", 200);
  set_skill("literate", 240);
  set_skill("zaahan_gong", 250);

  map_skill("force", "fuxiang_force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "jingang-strike");

  set("title", "少林寺高僧");
  create_family("少林寺", 2, "弟子");
  set("family/privs", 1);

  setup();
  carry_object("/u/poor/obj/cloth/sengpao")->wear();
}


void attempt_apprentice(object ob) {
  command("say 阿弥陀佛！老衲不收徒弟。");
}

int accept_object(object me, object ob, object obj) {

  if (me->query("class") != "shaolin") return 0;
  if (!me->query("marks/killfang")) return 0;
  if ((ob->query("id") == "yj-jing")) {
    command("say 你这是从哪里找到的？\n");
    command("say 阿弥陀佛！你去找无边大师，把这封信给他，他就会收你为徒弟的。\n");
    me->set("marks/baiwu", 1);
    obj = new(__DIR__ "obj/tj-xin");
    obj->move(me);
    return 1;
  }
  return 0;
}
