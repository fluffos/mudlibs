// Room: /city/nandajie2.c

inherit ROOM;

void create()
{
	set("short", "福运酒楼");
	set("long", @LONG
这是一家很大的酒楼，生意非常兴隆。外地游客多选择这
里落脚，你可以在这里打听到各地的风土人情。店小二里里外
外忙得团团转，接待着南腔北调的客人。
      墙上挂着一个牌子(paizi)。
LONG
	);
	set("item_desc", ([
		"paizi" : "内设雅房，每夜十两白银。\n",
	]));
	set("exits", ([
		"west" : __DIR__"jiulou3",
		"up" : __DIR__"jiulou2",
		"east" : __DIR__"nandajie1",
	]));
	set("objects", ([
		__DIR__"npc/waiter" : 1,
		__DIR__"npc/qingsong" : 1,
		__DIR__"npc/rdnpc" : 1,
	]));
	set("no_fight", 1);
	set("valid_startroom", 1);
       set("no_clean_up", 0);

	setup();
}
int valid_leave(object me, string dir)
{

	if ( !me->query_temp("rent_paid") && dir == "west" )
	return notify_fail("店小二一下挡住，白眼一翻：怎麽着，想白住啊！\n");

	if ( me->query_temp("rent_paid") && dir == "east" )
	return notify_fail("店小二跑到门边拦住：客官已经付了银子，怎麽不住店就走了呢！
旁人还以为小店伺候不周呢！\n");

	return ::valid_leave(me, dir);
}
