// Room: /city/nandajie2.c

inherit ROOM;

void create() {
  set("short", "热窝");
  set("long", @LONG
你走进了热窝之中，在屋子里已经来了很多客人。十分吵
闹。江湖豪客往往也聚集于此，谈论武林中的奇闻怪事。
    在门口挂着一个牌子（paizi）。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "paizi": "姑娘：香兰、柳燕，要一两金子。
",
  ]));
  set("exits", ([
    "east": __DIR__ "lizi2",
    "west": __DIR__ "rewo2",
  ]));
  set("objects", ([
    __DIR__ "npc/qianmazi": 1,
    __DIR__ "npc/dashou": 2,
    __DIR__ "npc/haoke1": 1,
    __DIR__ "npc/haoke2": 1,
    __DIR__ "npc/rat_seller": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}
int valid_leave(object who, string exit) {
  object ob;
  ob = present("dashou", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "west") && (who->query("class") != "guanfu") && (present(
    "dashou",
    environment(who)
  )))
    return notify_fail("钱麻子说道：“想找姑娘呀！是随便就能进的吗？”\n");
  return ::valid_leave(who, exit);
}
