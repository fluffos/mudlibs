//huadian.c
inherit ROOM;

void create()
{
        set("short", "胭脂店");
        set("long", @LONG
你走进了一家胭脂店，这里摆放的都是高档胭脂，都是让有
钱人家买的。很少有普通百姓光顾。
LONG
        );
        set("exits", ([/* sizeof() == 4 */
           "west":__DIR__"yanzhidian1",
           "east":__DIR__"nandajie2",
]));
        set("objects", ([
		__DIR__"npc/yzh_seller" : 1,
]));
        set("no_clean_up", 0);

        setup();
}
int valid_leave(object who,string exit)
{
  object ob;
  ob = present("zhang yan",environment(who));

  if( ob ) if( ob->query_temp("block_msg/all"))
      return ::valid_leave(who,exit);
  
  if( (exit == "west") && (who->query("class")!="guanfu") && (present("zhang yan",environment(who))))
      return notify_fail("张嫣说道：“里边是我家后远，您还是别进去了！”\n");
  return ::valid_leave(who,exit);
}

