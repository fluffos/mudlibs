// /d/city
#include <room.h>
inherit HOCKSHOP;

void create() {
  set("short", "奇奇当铺");
  set("long", @LONG
这是张家口最大的一家当铺了。素来以买卖公平着称。门口
挂了一块牌子 (paizi)。现在店里十分冷清。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "beidajie2",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "paizi": "
本当铺财力雄厚，童叟无欺，欢迎惠顾，绝对保密。
客官可以在这里：
    ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
    ＊  典当(pawn)               ＊
    ＊  卖断(sell)               ＊
    ＊  估价(value)              ＊
    ＊  赎回(redeem)             ＊
    ＊  购买(buy) 用list查看。   ＊
    ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
各种货物，铜钱、银两、黄金、银票一概通用。

" ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/dangpu_boss": 1,
  ]));
  set("no_clean_up", 1);
  set("NONPC", 1);

  setup();
}
void init() {
  add_action("do_value", "value");
  add_action("do_pawn", "pawn");
  add_action("do_sell", "sell");
  add_action("do_redeem", "redeem");
  add_action("do_buy", "buy");
  add_action("do_list", "list");
}
