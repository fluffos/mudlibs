//huadian.c
inherit ROOM;

void create()
{
        set("short", "后院");
        set("long", @LONG
你穿过胭脂店来到这里，在院子的正中有一棵高大的树木，
树隐隐发出金光。在树上接着很多人形的果子。在树旁边有个
牌子（sign)。
LONG
        );
	set("item_desc", ([ /* sizeof() == 1 */
  "牌子" : "在牌子上写着：人参果，遇金而落，遇土而入，遇火而焦，遇水而化。
",
  "sign" : "在牌子上写着：人参果，遇金而落，遇土而入，遇火而焦，遇水而化。
",
]));
        set("exits", ([/* sizeof() == 4 */
           "east":__DIR__"yanzhidian",
]));
	set("outdoors","zhang");
        set("no_clean_up", 0);

        setup();
}

void init()
{
	add_action("do_climb", "climb" );
}

int do_climb(string arg)
{
	if( arg=="大树" || arg=="树") {
	    if(this_player()->query_skill("dodge", 1)<=20) {
		     write("你慢慢向树上爬去，突然手一滑，从半空掉了下来。\n");
                  this_player()->unconcious();
			 return 1;
		}
		message_vision("$N慢慢向树上爬去，不一会儿，爬上了大树。\n", this_player());
		this_player()->move(__DIR__"yzhtree");
		message("vision", this_player()->name() + "爬上了大树。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}

