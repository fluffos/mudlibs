{
        set("short", "花店");
        set("long", @LONG
你走进了一家花店，店中摆放着数十种不同种类，不同颜色
的鲜花。现在花店里十分冷清，没有几个人。
LONG
        );
        set("exits", ([/* sizeof() == 4 */
           "west":__DIR__"nandajie2",
]));
