// seller.c

inherit F_VENDOR;
inherit NPC;

void create() {
  set_name("王屠户", ({ "wang", "seller" }));
  set("title", "肉铺老板");
  set_skill("unarmed", 70);
  set_skill("parry", 70);
  set_skill("dodge", 70);
  set("gender", "男性");

  set("force", 600);
  set("max_force", 600);
  set("per", 10);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 1000);

  set("age", 36);
  set("long", @LONG
他在这家店的老板。
LONG
  );

  set("vendor_goods", ([
    __DIR__ "obj/beef": 20,
    __DIR__ "obj/pork": 20,
  ]));

  setup();

  carry_object("/u/poor/obj/weapon/caidao")->wield();
  carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
