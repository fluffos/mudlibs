// golder.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("老汉", ({"laotou","seller"}));
	set("title","茶棚");
	set_skill("unarmed", 20);
	set_skill("parry", 30);
	set_skill("dodge", 30);
	set("gender","男性");

	set("force",600);
	set("max_force",600);
	set("per",30);
	set("food",200);
	set("water",200);
	set("combat_exp",600000);

	set("age", 66);
	set("long", @LONG
他是这里卖茶的老汉。
LONG
);

	set("vendor_goods", ([
		__DIR__"obj/tea"     : 20,
	]));

	setup();

	carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void init()
{
	add_action("do_vendor_list", "list");
}
