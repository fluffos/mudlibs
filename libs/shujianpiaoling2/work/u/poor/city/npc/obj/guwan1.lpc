// yanzhi

inherit ITEM;
#include <ansi.h>

void create() {
  string *order = ({ HIW "商代玉玺" NOR, HIB "蓝宝石" NOR, HIM "珍珠" NOR, HIR "鸡血石" NOR, HIY "战国金鼎" NOR });
  set_name(order[random(5)], ({ "gudong" }));
  set_weight(500);
  set("long", @LONG 
这是一个贵重的古董。
LONG
  );
  set("unit", "个");
  set("material", "iron");
  set("value", 200000);
}
