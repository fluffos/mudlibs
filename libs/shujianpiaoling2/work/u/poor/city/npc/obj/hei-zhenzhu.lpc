// rose.c

#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create() {
  set_name(MAG "黑珍珠" NOR, ({ "hei-zhenzhu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一颗十分贵重的黑珍珠。\n");
    set("unit", "颗");
    set("value", 200000);
    set("material", "zhenzhu");
    set("armor_prop/armor", 1);
    //		set("armor_prop/personality", 0);
    //		set("female_only", 1);
  }
  setup();
}
