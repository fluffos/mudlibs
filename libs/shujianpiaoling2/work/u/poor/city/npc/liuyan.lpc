// golder.c

inherit NPC;
int ask_me();
#include <ansi.h>

void create()
{
	set_name("柳燕", ({"liuyan"}));
	set_skill("unarmed", 30);
	set_skill("parry", 30);
	set_skill("dodge", 30);
	set("gender","女性");

	set("per",40);
	set("force",100);
	set("max_kee", 100);
	set("max_force",10);
	set("food",500);
	set("water",500);
	set("combat_exp",1000);

	set("age", 19);
	set("long", @LONG
她是热窝的招牌人物。
LONG
);
        set("chat_chance_combat", 1);
        set("chat_chance", 2);
        set("chat_msg", ({
        "柳燕冲你甩了个眉眼，说道：大爷来吗？\n",
        }) );
        set("inquiry", ([
                "过夜": (: ask_me :),
                "sex": (: ask_me :),
                "上床": (: ask_me :),
                "name": "大家都管我[草]。",
        ]) ); 

	setup();

	carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
}
int ask_me()
{
	object me,ob;
       me = this_player();

	tell_object(me,"柳燕把你推到床上，给你宽衣解带。\n");
	tell_object(me,"你躺在了床上，看着柳燕脱掉了一件件衣服，露出了洁白的身躯。\n");
	tell_object(me,"柳燕依偎在你的怀里。\n\n");
	tell_object(me,HIW"半个时辰过后。\n\n"NOR);
	tell_object(me,"你感到有些累了。\n");
       this_player()->unconcious();
       return 1;
}

int accept_object(object me, object ob)
{
         object clasp;
         me=this_player();
         if( (string)ob->query("id") !="zhitiao") 
         {
         command("say 这不是我写的。\n");
         }
         else{
	tell_object(me,"柳燕说道：我带你去个地方。\n\n"
"柳燕走到床边，不知碰了一下什么，突然打开了一道石门，来到了一间密室之中。\n"
"柳燕说道：我要爱死你！\n");
	me->move("/u/poor/city/rewoliu1");
	}
       return 1;
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 你总算来了，还不把纸条还给我。");      
}
