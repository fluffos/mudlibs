// golder.c

inherit NPC;
inherit F_VENDOR;
int ask_me();
int ask_me1();
#include <ansi.h>

void create() {
  set_name("钱麻子", ({ "qian mazi", "qian" }));
  set("title", "热窝老板");
  set_skill("unarmed", 70);
  set_skill("parry", 70);
  set_skill("dodge", 70);
  set("gender", "男性");

  set("force", 800);
  set("max_force", 800);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 200000);

  set("age", 46);
  set("long", @LONG
他是热窝的老板，为人十分吝啬。
LONG
  );

  set("vendor_goods", ([
    __DIR__ "obj/cai": 10,
    __DIR__ "obj/jiudai": 10,
  ]));
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "钱麻子说道：今儿个，又来了不少客人。\n",
    "钱麻子仔细的打量了一下你。\n",
    "钱麻子对你说道：不找个姑娘玩玩。\n",
  }));
  set("inquiry", ([
    "柳燕": (: ask_me :),
    "香兰": "一两金子！",

  ]));

  setup();

  carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
int ask_me() {
  object me, ob;
  me = this_player();

  if (!objectp(ob = present("zhitiao", me))) {
    tell_object(me, "柳燕姑娘可不轻易接客。\n\n");
    return 1;
  } else {
    command("say 什么？？你早跟柳燕姑娘有约？快进去吧。\n");
    tell_object(me, "钱麻子带着你穿过后院，来到了柳燕姑娘的绣房中。\n\n");
    me->move("/u/poor/city/rewoliu");
    return 1;
  }
}
int accept_object(object me, object ob) {
  me = this_player();
  if (ob->query("money_id") && ob->value() >= 10000) {
    command("say 多谢大爷赏赐，小的着就带您去。\n");
    tell_object(me, "钱麻子带着你穿过后院，来到了香兰姑娘的绣房中。\n\n");
    me->move("/u/poor/city/rewoxiang");
    return 1;
  } else {
    command("say 想找姑娘，还不想花钱？吝啬鬼！\n");
    return 1;
  }
}
