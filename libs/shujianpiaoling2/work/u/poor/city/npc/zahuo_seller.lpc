// golder.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("杨老板", ({"yang laoban","yang"}));
	set("title","杂货铺老板");
	set_skill("unarmed", 40);
	set_skill("parry", 40);
	set_skill("dodge", 40);
	set("gender","男性");

	set("force",800);
	set("max_force",800);
	set("food",200);
	set("water",200);
	set("combat_exp",80000);

	set("age", 36);
	set("long", @LONG
他是这家杂货铺的老板。
LONG
);

	set("vendor_goods", ([
		__DIR__"obj/mabudai" :15,
		__DIR__"obj/beixin":15,
		__DIR__"obj/toukui":15,
		__DIR__"obj/cycle":15,
		__DIR__"obj/shield":15,
		__DIR__"obj/caoxie":15,
		__DIR__"obj/pixue":15,
		"/u/poor/beggar/renduo/obj/tieqiao"	      : 15,
	]));

	setup();

	carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
}

void init()
{
	add_action("do_vendor_list", "list");
}
