// golder.c

inherit NPC;

void create() {
  set_name("古董商人", ({ "shangren", "shang" }));
  set_skill("unarmed", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("literate", 120);
  set("gender", "男性");

  set("force", 800);
  set("max_force", 800);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 80000);
  set("chat_chance", 3);
  set("chat_msg", ({
    "古董商人说道：天好热呀。\n",
    "古董商人端起茶杯，喝了口茶。\n",
  }));
  set("inquiry", ([
    "商代玉镯": "我有是有，我得要100两金子。",
  ]));
  set("age", 56);
  set("long", @LONG
他是一个正在喝茶的古董商人。
LONG
  );

  setup();

  carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
  carry_object(__DIR__ "guwan1");
}

int accept_object(object me, object ob) {
  me = this_player();
  if (ob->query("money_id") && ob->value() >= 1000000) {
    command("say 好，一手交钱，一手交货。\n");
    tell_object(me, "古董商人从背包里拿出了一只手镯，交给了你。\n\n");
    ob = new("/u/poor/beggar/jigong/obj/yuzhuo");
    ob->move(me);
    return 1;
  } else {
    command("say 钱不够！\n");
    return 0;
  }
}
