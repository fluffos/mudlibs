// golder.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("郭老大", ({"guo laoda","guo"}));
	set("title","包子铺掌柜");
	set_skill("unarmed", 50);
	set_skill("parry", 50);
	set_skill("dodge", 50);
	set("gender","男性");

	set("force",700);
	set("max_force",700);
	set("food",200);
	set("water",200);
	set("combat_exp",60000);

	set("age", 46);
	set("long", @LONG
他是这家包子铺的掌柜，带人很温和。
LONG
);

	set("vendor_goods", ([
		__DIR__"obj/baozi"	      : 15,
	]));

	setup();

	carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void init()
{
	add_action("do_vendor_list", "list");
}
