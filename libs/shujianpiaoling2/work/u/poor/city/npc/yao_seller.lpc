// golder.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("药铺伙计", ({ "yaopu huoji", "huoji" }));
	set("str", 20);
	set("gender", "男性");
	set("age", 18);
	set("long", "他是这家药铺的小伙计。\n");
	set("combat_exp", 250);
	set("attitude", "friendly");
	set_skill("unarmed", 50);
	set_skill("parry", 50);
	set_skill("dodge", 50);

	set("force",700);
	set("max_force",700);
	set("food",200);
	set("water",200);
	set("combat_exp",60000);


	set("vendor_goods", ([
		__DIR__"obj/jinchuang"	      : 15,
		__DIR__"obj/yangjing"	      : 15,
	]));

	setup();

	carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void init()
{
	add_action("do_vendor_list", "list");
}
