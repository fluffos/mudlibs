// golder.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("冯大娘", ({"feng daniang","feng"}));
	set("title","饺子馆掌柜");
	set_skill("unarmed", 20);
	set_skill("parry", 20);
	set_skill("dodge", 20);
	set("gender","女性");

	set("force",70);
	set("max_force",70);
	set("food",200);
	set("water",200);
	set("combat_exp",6000);

	set("age", 46);
	set("long", @LONG
他是这家饺子铺的掌柜。
LONG
);

	set("vendor_goods", ([
		__DIR__"obj/jiaozi"	      : 15,
		__DIR__"obj/jiaozi1"	      : 5,
	]));

	setup();

	carry_object("/u/poor/obj/cloth/gcloth")->wear();
}

void init()
{
	add_action("do_vendor_list", "list");
}
