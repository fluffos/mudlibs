#include <ansi.h>
inherit NPC;
void create() {
  set_name("贾龙", ({ "jia long", "jialong" }));
  set("gender", "男性");
  set("age", 45);
  set("title", "黑风寨邪堂堂主");
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "贾龙说道：不知道那个头陀把《易筋经》藏哪了？。\n",
    "贾龙说道：寒灵山庄的人怎么还不到？。\n",
  }));
  set("long", "他是黑风寨狂堂堂主。\n");

  set("combat_exp", 2000000);
  set("max_kee", 2500);
  set("kee", 2500);
  set("force", 3000);
  set("max_force", 2000);
  set("force_factor", 50);
  set("inquiry", ([
    "象牙骨子": "干吗？？",
    "头陀": "据说是寒灵山庄的天帝，偷到少林秘籍后被打成重伤。被我家寨主埋到西边了。",
  ]));

  set_skill("unarmed", 120);
  set_skill("force", 120);
  set_skill("parry", 120);
  set_skill("sanhua-strike", 120);
  set_skill("shaolin-dodge", 120);
  set_skill("dodge", 120);
  set_skill("literate", 50);
  map_skill("unarmed", "sanhua-strike");
  map_skill("dodge", "shaolin-dodge");

  setup();

  carry_object("/u/poor/obj/cloth/tiejia")->wear();
  carry_object("/u/poor/obj/weapon/golden-hammer");
  carry_object(__DIR__ "obj/xy-guzi");
}
