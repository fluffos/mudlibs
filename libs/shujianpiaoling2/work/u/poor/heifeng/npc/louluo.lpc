// beggar.c

#include <ansi.h>
inherit NPC;


void create() {
  string *order = ({ "狂堂", "邪堂", "毒堂" });

  set_name("喽罗", ({ "louluo" }));
  set("title", "黑风寨" + (order[random(3)]) + "弟子");
  set("gender", "男性");
  set("age", 15 + random(50));
  set("long",
    "他是黑风寨的喽罗。\n");
  set("attitude", "aggressive");
  set("max_kee", 500);
  set("kee", 500);
  set("force", 600);
  set("max_force", 600);
  set("force_factor", 20);
  set("combat_exp", 10000 + random(50000));
  set_skill("unarmed", 40 + random(30));
  set_skill("sword", 40 + random(30));
  set_skill("parry", 40 + random(30));
  set_skill("dodge", 40 + random(30));

  create_family("黑风寨", 3 + random(7), "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/cloth")->wear();
  carry_object("/u/poor/obj/weapon/sword")->wield();
}
