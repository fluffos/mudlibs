#include <ansi.h>
inherit NPC;
void create()
{
        set_name("厨子", ({ "chu zi", "chuzi" }) );
        set("gender", "男性" );
        set("age", 30);
        set("long",     "他是被黑风寨抓来的厨子。\n");

        set("combat_exp", 600);
        set("max_kee", 200);
        set("kee", 200);
        set("force", 200);
        set("max_force", 150);
        set("force_factor",10);

        set_skill("unarmed", 10);
        set_skill("force", 10);
        set_skill("parry", 10);

        setup();

        carry_object("/u/poor/obj/cloth/cloth")->wear();
}
