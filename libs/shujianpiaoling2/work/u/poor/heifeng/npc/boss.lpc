#include <ansi.h>
inherit NPC;
void create() {
  set_name("胡戈", ({ "hu ge", "huge" }));
  set("gender", "男性");
  set("age", 55);
  set("title", "黑风寨大寨主");
  set("long", "他是黑风寨的寨主。\n");

  set("combat_exp", 2000000);
  set("max_kee", 3000);
  set("kee", 3000);
  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 50);
  set("inquiry", ([
    "凝血匕首": "我不会给你的。",
    "头陀": "据说是寒灵山庄的天帝，偷到少林秘籍后被打成重伤。被我家寨主埋到西边了。",
  ]));

  set_skill("unarmed", 150);
  set_skill("force", 100);
  set_skill("dagger", 240);
  set_skill("parry", 150);
  set_skill("sanhua-strike", 120);
  set_skill("shaolin-dodge", 120);
  set_skill("dodge", 150);
  set_skill("literate", 50);
  map_skill("unarmed", "sanhua-strike");
  map_skill("dodge", "shaolin-dodge");

  setup();

  carry_object("/u/poor/obj/cloth/tiejia")->wear();
  carry_object("/u/poor/obj/weapon/nx-dagger")->wield();
}
