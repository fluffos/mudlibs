// yanzhi

inherit ITEM;
#include <ansi.h>

void setup()
{}

void init()
{
        add_action("do_du", "du");
        add_action("do_tear", "tear");
        add_action("do_du", "study");
}

void create()
{
	set_name("《易筋经》", ({  "yijin-jing","book" }));
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是少林的武功秘籍。\n");
		set("value", 0);
		set("material", "paper");
	}
}


int do_du(string arg)
{
        object me = this_player();
        object ob;
        mapping skill;
	 int lvl; 

	if (!(arg=="yijin-jing" || arg == "book" ))
	return 0;
   
        if (me->is_busy()) {
                write("你现在正忙着呢。\n");
                return 1;
        }

        if( me->is_fighting() ) {
                write("你无法在战斗中专心下来研读新知！\n");
                return 1;
        }
	if( me->query_temp("dazuo") ){
		write("你无法在练功打坐中专心下来研读新知！\n");
		return 1;
	}
	if( me->query_temp("sleeping") ){
		write("你正在睡眠中，不能学习技能。\n");
	}
        if (!id(arg)) {	
                write("你要读什么？\n");
                return 1;
        }
        if( !me->query_skill("literate", 1) ){
                write("你是个文盲，先学点文化(literate)吧。\n");
                return 1;
        }
	message_vision("$N拿出《易筋经》，开始细细钻研起来。\n",me);
        if( (int)me->query("sen") < 10 ) {
                write("你现在过于疲倦，无法专心下来研读新知。\n");
                return 1;
        }
       
	this_player()->unconcious();
       return 1;
}
int do_tear(string arg)
{
	object me,book;
	me = this_player();
	if (!(arg=="yijin-jing" || arg == "易筋经" ))
	return 0;
	if (!(arg)) {	
                write("你要撕开什么？\n");
                return 1;
        }
	tell_object(me,@TEXT
你小心翼翼的把书的封皮撕开，发现里边的夹页中有张纸片。
TEXT
	);
	book = new(__DIR__"yijin-map");
	book->move(me);
	destruct(this_object());
	return 1;
}
