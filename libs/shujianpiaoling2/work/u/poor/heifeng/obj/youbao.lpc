// yanzhi

inherit ITEM;
#include <ansi.h>

void create()
{
    set_name(YEL"油包"NOR, ({ "youbao" }) );
    set_weight(500);
    set("long", @LONG 
这是一个油包，油包上有几个模模糊糊的字：
	藏身少林，偷拳盗书；
	被追至此，精尽力竭；
	投书池底，命归黄泉；
	包中何物，少林易筋。
LONG
  );
    set("unit", "个");
    set("material", "teeth");
}
void init()
{
        add_action("do_open", "open");
}
int do_open(string arg)
{
	object me,book;
	me = this_player();
	if (!(arg=="youbao" || arg == "油包" ))
	return 0;
	if (!(arg)) {	
                write("你要打开什么？\n");
                return 1;
        }
	tell_object(me,@TEXT
你小心翼翼地把油包打开，从里边拿出了本书。
TEXT
	);
	book = new(__DIR__"yijin");
	book->move(me);
	destruct(this_object());
	return 1;
}
