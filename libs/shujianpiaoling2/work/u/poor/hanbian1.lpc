// Room: 
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "东海之滨");
  set("long", @LONG
你已经来到了东海的海边，海浪不时拍打着一座座巨大的礁石，
发出巨大的响声。这里颇有“观沧海”中所云的气势。远远眺望，
能够看到一些小岛的轮廓。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "southwest": __DIR__ "yidao5",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/laozhe": 1,
  ]));

  setup();
}

void init() {
  add_action("do_swim", "swim");
}

int do_swim() {
  object me = this_player();

  message_vision(HIY "$N纵身一跃，跳入海中。只见$N使足了全身力气，手足并用，不一会儿又游了上来。\n" NOR, me);
  me->move(__DIR__ "hanbian1");
  message_vision(HIY "只见$N浑身湿漉漉地从海里爬了上来。\n" NOR, me);
  me->receive_damage("sen", 50);
  me->receive_damage("kee", 50);
  return 1;
}
