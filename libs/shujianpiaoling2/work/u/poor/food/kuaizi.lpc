// sword,c

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("筷子", ({ "kuaizi" }) );
        set_weight(800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("long", "这是一双普普通通的筷子。\n");
                set("value", 500);
                set("material", "wood");
                set("wield_msg", "$N拿出一条$n，握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_sword(10);
        setup();
}
