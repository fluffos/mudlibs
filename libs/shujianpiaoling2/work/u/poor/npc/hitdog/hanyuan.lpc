// hanyuan

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("寒渊", ({ "han yuan", "master", "hanyuan" }) );
        set("nickname", HIB "万里鞭" NOR);
        set("title", "丐帮大仁分舵舵主");
        set("gender", "男性");
        set("age", 28);
        set("long",
 "他就是丐帮大仁分舵的舵主。\n");

        set("max_kee", 600);
        set("kee", 600);
        set("force", 1000);
        set("max_force", 600);
        set("force_factor",30);
        set("combat_exp",100000);
        set("class", "gaibang");

        set_skill("unarmed", 80);
        set_skill("force", 80);
        set_skill("parry", 80);
        set_skill("dodge", 80);
        set_skill("stick", 80);
        set_skill("begging", 80);

        set_skill("iron_strike", 80);
        set_skill("hitdog_zhen", 80);
        set_skill("canyun_force", 80);
        set_skill("hitdog_stick", 80);

        map_skill("dodge", "hitdog_zhen");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
        map_skill("stick", "hitdog_stick");
        map_skill("parry", "hitdog_stick");

        create_family("丐帮", 5, "弟子");

        setup();

        carry_object("/u/poor/obj/weapon/stick")->wield();
        carry_object("/u/poor/obj/cloth/cloth")->wear();
}

