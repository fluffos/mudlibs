// Room: /jing/duankit.c

inherit ROOM;

int rou_num = 3;

void create()
{
	set("short", "河边");
	set("long", @LONG
你顺着小河来到这里，在河边晒着一张渔网，渔网有边放着
一个竹筐。在远处有一间茅屋，西边是大片大片的树林，东北能
远远望见连绵起伏的群山。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "竹筐" : "一个装虾用的竹筐，里边装满了青虾。
",
]));
        
       set("exits", ([ /* sizeof() == 2 */
  "southwest" : __DIR__"jhhebian2",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/fish_seller" : 1,
]));
	set("no_clean_up", 0);
	set("outdoors","gaibang");

	setup();
//	replace_program(ROOM);
}

void init()
{
	add_action("do_search", "search" );
}

int do_search(string arg)
{
	object obj,me;
       me = this_player();
	if( arg=="竹筐" || arg=="筐" ) {
	     if(rou_num!=0) {
		    obj = new(__DIR__"npc/obj/qingxia");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N从竹筐里拿出了一只青虾。\n", this_player());
		 	rou_num--;
		 }
		 else write("筐里已经空了。\n");
		 return 1;
	}
	else return 0;
}
