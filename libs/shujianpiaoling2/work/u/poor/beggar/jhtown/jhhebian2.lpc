// Room: /jing/duankit.c

inherit ROOM;

int rou_num = 5;

void create()
{
	set("short", "河边");
	set("long", @LONG
你顺着小河来到这里，这里的河滩上有很多淤泥，在这些泥
上有很多不规则的小洞，有几个小孩正在这里寻找什么。远远望
去西边有一片树林，东边是一条不宽的河流。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "小洞" : "一个拇指大的洞。
",
]));
        
       set("exits", ([ /* sizeof() == 2 */
  "northeast" : __DIR__"jhhebian3",
  "southwest" : __DIR__"jhhebian1",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/boy" : 2,
]));
	set("no_clean_up", 0);
	set("outdoors","gaibang");

	setup();
//	replace_program(ROOM);
}

void init()
{
	add_action("do_dig", "dig" );
       add_action("do_dig", "wa" );
}

int do_dig(string arg)
{
	object obj,me;
       me = this_player();
	if( arg=="小洞" || arg=="hole" ) {
	     if(rou_num!=0) {
		    obj = new(__DIR__"npc/pangxie");
			obj->set_amount(1);
              	obj->move(environment(me));     
			message_vision("$N挖开小洞，从洞中爬出一只螃蟹。\n", this_player());
		 	rou_num--;
		 }
		 else write("洞中什么都没有。\n");
		 return 1;
	}
	else return 0;
}
