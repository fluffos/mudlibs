// Room: /jing/duankit.c

inherit ROOM;

int rou_num = 2;

void create()
{
	set("short", "民居");
	set("long", @LONG
你走进了一户农民的家中，在右边有一个大水缸，旁边是一
个灶，上面放着一口锅。灶的旁边有一些干柴。在那边的地上放
这一张席子。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "锅" : "一口盖着盖子的锅。
",
]));
        
       set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"jhn1",
]));
	set("objects", ([ /* sizeof() == 2 */
  __DIR__"npc/liuson" : 1,
  __DIR__"obj/shuigang" : 1,
]));
	set("no_clean_up", 0);

	setup();
//	replace_program(ROOM);
}

void init()
{
	add_action("do_search", "search");
}

int do_search(string arg)
{
	object obj;
	if( arg=="锅" || arg=="guo" ) {
	     if(rou_num!=0) {
		    obj = new(__DIR__"obj/xianrou");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N从锅里找到一块咸肉。\n", this_player());
		 	rou_num--;
		 }
		 else write("锅里已经空了。\n");
		 return 1;
	}
	else return 0;
}
