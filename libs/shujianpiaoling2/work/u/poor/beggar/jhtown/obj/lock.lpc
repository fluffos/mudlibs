
#include <armor.h>

inherit NECK;

void create()
{
	set_name("长命锁", ({ "lock", "suo" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一条保佑人长命百岁的护身符。\n");
		set("unit", "条");
		set("value", 5000);
		set("material", "gold");
		set("armor_prop/armor", 1);
		set("armor_prop/personality", 5);
		set("female_only", 0);
	}
	setup();
}

