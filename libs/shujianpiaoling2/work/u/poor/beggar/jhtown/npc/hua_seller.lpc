// golder.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("孙梅", ({ "sun", "seller" }));
  set("title", "花店掌柜");
  set_skill("unarmed", 40);
  set_skill("parry", 40);
  set_skill("dodge", 40);
  set("gender", "女性");

  set("force", 600);
  set("max_force", 600);
  set("per", 30);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 1000);

  set("age", 26);
  set("long", @LONG
她是这家花店的掌柜的，长得美丽动人，十分惹村里人的喜欢。
LONG
  );

  set("vendor_goods", ([
    __DIR__ "obj/redrose": 20,
    __DIR__ "obj/whiterose": 20,
  ]));

  setup();

  carry_object(__DIR__ "obj/gcloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
