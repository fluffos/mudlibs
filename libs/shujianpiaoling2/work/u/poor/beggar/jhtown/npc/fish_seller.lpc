// fisher

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("渔民", ({ "yu min", "seller" }));
  //	set("title","");
  set_skill("unarmed", 80);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set("gender", "男性");

  set("force", 600);
  set("max_force", 600);
  set("per", 15);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 60000);

  set("age", 39);
  set("long", @LONG
他是一个普通的渔民，有时也卖点鱼为生。
LONG
  );
  set("chat_chance_combat", 10);
  set("chat_chance", 1);
  set("chat_msg", ({
    "渔民说道：你想买点鱼吗？\n"
  }));
  set("inquiry", ([
    "鱼": "你是想买鱼吗？这几天我只捕到了不少鱼",
    "买鱼": "我就卖鱼。",
    "扇贝": "这个我可没有。",
    "青虾": "你随便从筐里拿几只吧。",
    "螃蟹": "我没有螃蟹。",
  ]));

  set("vendor_goods", ([
    __DIR__ "obj/caoyu": 5,
    __DIR__ "obj/nianyu": 5,
    __DIR__ "obj/zunyu": 5,
    __DIR__ "obj/shibanyu": 5,
    __DIR__ "obj/jiyu": 5,
  ]));

  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
