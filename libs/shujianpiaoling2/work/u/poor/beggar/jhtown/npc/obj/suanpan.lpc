// stick.c

#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create()
{
	set_name("算盘", ({ "suanpan" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "一个算数用的普通算盘。\n");
		set("value", 200);
		set("material", "wood");
		set("wield_msg", "$N拿出一个$n抄在手中。\n");
		set("unwield_msg", "$N放下手中的$n。\n");
	}

	init_stick(1);
	setup();
}
