inherit NPC;

void create()
{
        set_name("刘威", ({ "liu wei","liu","man" }) );
        set("gender", "男性" );
        set("age", 27);
        set("title", "刘长老之子");
        set("long",
"他是一个高高大大的村民，但是他的太阳穴\n"
"稍稍突起，可见他也练过几年的功夫，内力不弱。\n");
        set("combat_exp", 10000);
        set("force",500);
        set("max_force", 500);
        set_skill("force",50);
        set_skill("dodge", 50);
        set_skill("unarmed", 50);
	  set_skill("sanhua-strike", 50);
        set_skill("hidden_dodge", 50);
        set_skill("canyun_force", 50);
       
	  map_skill("unarmed", "sanhua-strike");
        map_skill("force","canyun_force");
        map_skill("dodge", "hidden_strike");
        set("chat_chance", 10);
        set("chat_msg", ({
"刘威说道：不知道父亲现在在哪里？\n",
        }) );

       set("inquiry", ([
         "父亲" : "我父亲是丐帮的长老，不知道现在他云游到了何处。\n",
         "map" : "这是父亲上次回来留下的，好象和什么宝藏有关。\n",
         "长命锁" : "这是奶奶生前给父亲留下的遗物。\n",
         ]));
     
       setup();
       carry_object("/u/poor/obj/cloth/linen")->wear();
}

int accept_object(object me, object ob)
{
         object clasp;
         me=this_player();
         if( (string)ob->query("name") !="长命锁" && (string)ob->query("id") !="lock"  ) 
         {
         command("say 你给我这东西干吗？\n");
         }
         else{
         say("这位" + RANK_D->query_respect(me) + "，多谢你把父亲的遗物带回来，我感激不尽。
你得到了商殷藏宝图的右边。\n");
         ob = new(__DIR__"obj/mapright");
         ob->move(this_player());
      }
        return 1;       
}
