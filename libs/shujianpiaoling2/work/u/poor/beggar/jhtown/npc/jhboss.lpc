#include <ansi.h>
inherit NPC;
void create()
{
        set_name("王铨宁", ({ "wang quaning", "wang" }) );
        set("gender", "男性" );
        set("age", 55);
        set("str", 20);
        set("cor", 10);
        set("cps", 15);
        set("title", "鸡华村村长");
        set("per", 10);
        set("int", 20);
        set("chat_chance_combat", 10);
        set("chat_chance", 10);
        set("chat_msg", ({
        "王铨宁说道：真晦气，一早出门就碰上了个死人。\n",
        "王铨宁皱了皱眉头，自言自语道：“粮仓里的老鼠真多！”\n",
        }) );
        set("long",     "他是这个村的村长，管理村里的一切事情。\n");
        set("inquiry", ([
                "尸体": "那个死人就在村子的东边。",
                "corpse": "那个死人就在村子的东边。",
                "老鼠药": "一般的大城镇里都有卖的吧。",
                "老鼠": "老鼠药怎么还没买回来。",
        ]) ); 

        set("combat_exp", 2600);

        set_skill("dodge", 40);
        set_skill("parry", 40);
        set_skill("literate", 80);
        set_skill("unarmed", 20);
        set_temp("apply/defense", 30);
        set_temp("apply/move", 30);

        setup();

        carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
}

int accept_object(object me, object ob)
{
         object clasp;
         me=this_player();
         if( (string)ob->query("id") !="rat-medicine") 
         {
         command("say 这不是老鼠药。\n");
        return 0;       
         }
         else{
         command("say 多谢帮我买来老鼠药。");
         command("say 这本书你拿着随便看看吧！");
         ob = new("/u/poor/obj/book/literate-book2");
         ob->move(me);
      }
        return 1;       
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 这位兄台有什么事情？");      
}