// seller.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("李君", ({"li jun","seller"}));
	set("title","杂货铺掌柜");
	set_skill("unarmed", 20);
	set_skill("parry", 20);
	set_skill("dodge", 20);
	set("gender","男性");

	set("force",600);
	set("max_force",600);
	set("per",10);
	set("food",200);
	set("water",200);
	set("combat_exp",1000);

	set("age", 56);
	set("long", @LONG
他是这家杂货铺的老板，做一些小本生意。
LONG
);

	set("vendor_goods", ([
		__DIR__"obj/chutou"	      : 20,
		__DIR__"obj/masheng"	      : 20,
              __DIR__"obj/liandao"      : 20,
	]));

	setup();

	carry_object(__DIR__"obj/suanpan")->wield();
	carry_object(__DIR__"obj/cloth")->wear();       
}

void init()
{
	add_action("do_vendor_list", "list");
}
