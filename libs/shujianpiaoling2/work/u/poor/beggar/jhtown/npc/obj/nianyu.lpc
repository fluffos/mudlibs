// fish

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("鲶鱼", ({ "nianyu" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一条刚死不久的鲶鱼。\n");
		set("unit", "条");
		set("value", 1000);
		set("food_remaining", 2);
		set("food_supply", 10);
	}
}
