// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "地道" NOR);
  set("long", @LONG
你走在丐帮的地道之中，这里光线十分昏暗，几乎看无清
四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。在南边是一
扇木门。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "木门": "这是一扇普通的木门。
",
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "ddwu1",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    //  __DIR__"npc/beggar" : 2,
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object me = this_player();

  if ((!arg) || (!(arg == "木门" || arg == "door")))
    return 0;
  if (me->query("marks/killwu")) {
    message_vision("$N打开木门，走了进去。\n", me);
    me->move(__DIR__ "ddwu4");
    return 1;
  } else {
    message_vision("$N打开木门，走了进去。\n", me);
    me->move(__DIR__ "ddwu3");
    return 1;
  }
}
