#include <ansi.h>
inherit NPC;
void create()
{
        set_name("赵纺", ({ "zhao fang", "zhaofang" }) );
        set("gender", "女性" );
        set("age", 25);
        set("title", "丐帮四袋弟子");
        set("chat_chance_combat", 1);
        set("chat_chance", 2);
        set("chat_msg", ({
        "赵纺说道：王端，你知道钥匙在哪位舵主手里吗？\n",
        }) );
        set("long",     "她是一个丐帮弟子，负责看守石门。\n");

        set("combat_exp", 600000);

        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("literate", 20);
        set_skill("unarmed", 100);
        set_temp("apply/defense", 30);
        set_temp("apply/move", 30);

        setup();

        carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
