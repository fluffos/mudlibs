// shihaifeng.c

#include <ansi.h>
inherit NPC;
int ask_me();
int paper_count = 1;

void create() {
  set_name("石海风", ({ "shi haifeng", "master", "shi" }));
  set("nickname", HIY "酒仙神丐" NOR);
  set("title", "丐帮现任帮主");
  set("gender", "男性");
  set("age", 55);
  set("long",
    "他就是丐帮的现任帮主，施楠的嫡传弟子，其武功人品都超过了师父当年的风采。\n");
  set("inquiry", ([
    "拜师": "你想帮我报仇吗？",
    "报仇": (: ask_me :),
    "打狗棒": "你想帮我报仇吗？",
    "name": "我就是石海风，你想帮我报仇吗？",
  ]));
  set("str", 56);
  set("max_kee", 8000);
  set("kee", 8000);
  set("force", 9500);
  set("max_force", 9000);
  set("force_factor", 150);
  set("combat_exp", 8000000);

  set_skill("unarmed", 250);
  set_skill("force", 250);
  set_skill("parry", 250);
  set_skill("dodge", 250);
  set_skill("stick", 250);
  set_skill("fanwen", 180);
  set_skill("begging", 250);

  set_skill("xianglong_strike", 230);
  set_skill("hidden_dodge", 230);
  set_skill("canyun_force", 230);
  set_skill("penyuntuwu", 180);
  set_skill("literate", 180);
  set_skill("hitdog_zhen", 180);
  set_skill("hitdog_stick", 230);

  map_skill("dodge", "hitdog_zhen");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");
  map_skill("stick", "hitdog_stick");
  map_skill("parry", "hitdog_stick");

  create_family("丐帮", 2, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/killwu")) {
    command("say 这位" + RANK_D->query_respect(ob) + "还是先向传功长老讨教武功吧。\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->delete("marks/baishi", 1);
    ob->set("class", "gaibang");
    ob->set("title", "丐帮长老");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("checklooking");
    call_out("checklooking", 1, ob);
  }
}

void checklooking(object ob) {
  command("say 总算有人来了，你能给我报仇吗？");
}
int ask_me() {
  object me, ob, xiao;
  int sk;
  me = this_player();
  ob = this_object();
  sk = (int)me->query_skill("begging", 1);
  if ((sk > 50) && (ob->query("paper_count") < 0)) {
    command("say 铁棒已经送人了。\n");
    return 1;
  } else if ((sk > 50)) {
    command("say 好！我的深仇大恨都交给你了！");
    command("say 我把这根铁棒给你，折断(zhe)后里边是打狗棒，把它给现在的假帮主。然后给我报仇！！");
    ob->add("paper_count", -1);
    xiao = new(__DIR__ "obj/iron-stick");
    xiao->move(me);
    return 1;
  } else {
    command("shake");
    command("say 我看你资质不佳，还是算了吧！");
    return 1;
  }
}
