// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIB"石室"NOR);
	set("long", @LONG
你来到了这间石室里，这里的光线很差。在屋子的正中间
有一口井。井边有几个湿漉漉的脚印。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
    "south" : __DIR__"ddroad6",
]));
        set("no_clean_up", 0);

	setup();
}
void init()
{
	add_action("do_jump", "jump" );
	add_action("do_jump", "tiao" );
}

int do_jump(string arg)
{
	if( arg=="井" || arg=="well") {
	    if(this_player()->query_skill("dodge", 1)<=20) {
		     write("你犹豫了一下，没敢跳下去。\n");
			 return 1;
		}
		message_vision("$N深吸一口气，从井边跳了下去。\n", this_player());
		this_player()->move(__DIR__"ddwell");
		message("vision", this_player()->name() + "跳到了井中。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}
