inherit ITEM;
inherit F_LIQUID;
int do_get(string arg);
int do_fillwater(string arg);
int do_drink(string arg);

void create()
{
	set_name("大水缸", ({ "shuigang","shui","gang" }));
	set_weight(10000000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
	       set("long", "一个装满清水的大水缸，如果你口渴，可以舀水来喝(drink)　\n");
		set("unit", "个");
		set("value", 1000);
	}
}

void init()
{
        add_action("do_fillwater", "fillwater");
        add_action("do_drink", "drink");
        add_action("do_get", "get");
}

int do_fillwater(string arg)
{
        object *list, ob;
        int i, can_fillwater;
        string dir;

        if( !arg || arg=="" ) {
                 write("你要往什么东西里灌水？\n");
		   return 1; } 
	 if(! ob = present(arg,this_player()) ) {
                 write("你身上没有这个东西。\n");
		   return 1; } 

        if (ob->query("liquid/type") == "alcohol"
 || ob->query("liquid/type") == "water" ) {
                 ob->set("liquid", ([
                           "type": "water",
                           "name": "清水",
                           "remaining": 15,
                           "drunk_apply": 6,
                 ]) );
                 write("你从水缸里装满了清水! \n");
                 return 1;
                   }
         else {
                        write("你没有装水的东西啊....\n");
                        return 1;  }
}

int do_get(string arg)
{
	if( environment() != environment(this_player())
	||	!id(arg) ) return 0;

	if( (int)this_player()->query("kee") < 20 || 
 (int)this_player()->query("str") < 50) {
		write("你的力气不够了，休息一下再说吧。\n");
		return 1;
	}

	if( move(this_player()) ) {
		message_vision("$N弯下腰将地上的" + name() + "扛了起来。\n", this_player());
		this_player()->receive_damage("kee", 20);
		return 1;
	}
}

int do_drink(string arg)
{
	if( this_player()->is_busy() )
		return notify_fail("你正忙着其他事情呢。\n");
	if( (int)this_player()->query("water") >= (int)this_player()->max_water_capacity() )
		return notify_fail("你已经喝得太多了，再也灌不下一滴水了。\n");
	this_player()->add("water", 40);
	if( this_player()->is_fighting() ) this_player()->start_busy(2);
	message_vision("$N拿起勺子往水缸里盛了一些清水喝了几口。\n", this_player());
	return 1;
}







