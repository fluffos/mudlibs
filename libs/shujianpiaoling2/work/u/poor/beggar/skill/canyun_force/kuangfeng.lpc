//狂风舞柳

#include <ansi.h>

inherit SSERVER;

int exert(object me, object target) {
  object *ob;
  int i, skill, damage;

  if (me->is_busy())
    return notify_fail("你正在忙着呢。\n");

  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");

  skill = me->query_skill("canyun_force", 1);
  if (skill <= 50) return notify_fail("你的「风卷残云功」修为不足，无法使用狂风舞柳！\n");

  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够。\n");

  if (!target) target = offensive_target(me);

  if (!target || target == me) {
    target = offensive_target(me);
    if (!target) return notify_fail("你要对谁施展「狂风舞柳」？\n");
  }


  me->add("force", -100);
  me->receive_damage("sen", 10);

  message_vision(
    HIB "$N丹田升起一股强劲真气，罩住全身，在场所有人只觉得四周空气骤然凝结，一时不知所措！\n" NOR, me);

  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;

    if (me->query("force") > ob[i]->query("force")) {
      ob[i]->start_busy(3);
      tell_object(ob[i], HIB "你觉得四周真气激荡，连忙暗运真气抵御。\n" NOR);
    } else tell_object(ob[i], HIG "你觉得四周真气激荡，体内真气自然产生抵御。\n" HIG);

  }
  if (random(target->query("dodge") / 3) > (int)me->query("force") / 4) {
    message_vision("但是$N借着$n袭来的强劲真气，身体轻轻向后飘了出去。\n", target, me);
    target->fight_ob(me);
    return 1;
  }
  me->start_busy(3);
  damage = random(me->query_skill("force", 0)) - target->query_skill("force", 0) / 2;
  damage = damage * 10;
  if (damage > 300) damage = 300;
  if (damage < 1) {
    message_vision("但是$N对$n发出的强劲的真气似乎没有丝毫感觉。\n", target, me);
    target->fight_ob(me);
    return 1;
  }
  if (damage < 40 && damage >= 1)
    message_vision("$N只觉得一股真气袭来，不由退了两步！\n", target, me);
  else if (damage < 80 && damage >= 40)
    message_vision("$N只觉得一股强大的真气压来，连退好几步，几乎摔倒！\n", target, me);
  else if (damage < 160 && damage >= 120)
    message_vision("$N只觉得气血翻滚，连退几步，仍然无法控制体内真气！\n", target, me);
  else if (damage < 240 && damage >= 160)
    message_vision(RED "$N只觉得心口一阵剧痛，鼻孔和嘴角渗出了鲜血！\n" NOR, target, me);
  else if (damage >= 240)
    message_vision(HIR "$N只觉得眼前一黑，口中鲜血狂喷，身体象稻草般飞了出去！\n" NOR, target, me);
  target->receive_damage("kee", damage);
  target->receive_wound("kee", damage / 2);

  if (userp(target)) target->fight_ob(me);
  else if (!target->is_killing(me)) target->kill_ob(me);

  return 1;
}
