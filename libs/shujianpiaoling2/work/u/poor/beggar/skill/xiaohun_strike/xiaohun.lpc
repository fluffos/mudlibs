//xiaohun.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        if( !target ) target = offensive_target(me);

        if( !target||!target->is_character()||!me->is_fighting(target) )
                return notify_fail("你现在没有作战，怎么用[销魂式]呢？\n");
        
        if( me->query_skill("xiaohun_strike",1) < 100)
                return notify_fail("你的黯然销魂掌法修行不够!\n");

        message_vision(YEL "$N长啸一声，使出绝技[销魂式]，接连不断的发出三招！\n" NOR, me, target);

        message_vision(YEL "\n只见$N使出[销魂式]的第一种变化。\n" NOR, me, target);
        COMBAT_D->do_attack(me, target);
        message_vision(YEL "\n只见$N使出[销魂式]的第二种变化。\n" NOR, me, target);
        COMBAT_D->do_attack(me, target);
        message_vision(YEL "\n只见$N使出[销魂式]的最终种变化。\n" NOR, me, target);
        COMBAT_D->do_attack(me, target);

        me->start_busy(2);
        return 1;
}
