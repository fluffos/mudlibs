// Room: /u/poor/gaibang/gbwuch2

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "翠竹林" NOR);
  set("long", @LONG
这里是丐帮总舵北边的一片竹林，不时有阵阵微风吹过，发出
“沙，沙”地声音。全然不像是在丐帮的总舵之中，从这里能远远
看到北边的大片竹林。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "zdrukou",
    "south": __DIR__ "zdroad2",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/wukun": 1,
  ]));
  set("outdoors", "gaibang");
  set("no_clean_up", 0);

  setup();
}

int valid_leave(object who, string exit) {
  int beg = (int)who->query_skill("begging", 1);
  object ob;
  ob = present("wukun", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "south") && (beg < 100) && (present("wukun", environment(who))))
    return notify_fail("吴昆说道：“前面是丐帮总舵，你辈分不够，不能入内！”\n");
  return ::valid_leave(who, exit);
}
