// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create()
{
	set("short", HIB" 打狗阵中"NOR);
	set("long", @LONG
你已经走进天下文明的丐帮打狗阵了，这里机关重重，并有
许多丐帮高手在这里埋伏，只要的一招不慎，就会死无葬身之地。
LONG
	);

	set("exits", ([ /* sizeof() == 3 */
    "north" : __DIR__"dagou3",
    "south" : __DIR__"dagou1",
]));
       set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/dagou11" : 1,
  __DIR__"npc/dagou12" : 1,
]));
	set("outdoors","gaibang");
        set("no_clean_up", 0);

	setup();
}

int valid_leave(object who,string exit)
{
  object ob;
  ob = present("zhao",environment(who));

  if( ob ) if( ob->query_temp("block_msg/all"))
      return ::valid_leave(who,exit);
  
  if( (exit == "north") && (who->query("class")=="gaibang") && (present("zhao",environment(who))))
      return notify_fail("赵处良说道：“先过我，再过阵！”\n");
  return ::valid_leave(who,exit);
}
