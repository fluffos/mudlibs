// 比武场
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIB"比武场"NOR);
        set("long", @LONG
这里是丐帮弟子的露天比武场，有许多丐帮弟子在此习武弄棒。
常常有许多弟子来此比武较量，也是丐帮选拔人才的地方。比武难免
有失手之时，但在这里大家是不计较的，放心打吧。
LONG
        );
	set("exits", ([/* sizeof() == 4 */
       "east"  : __DIR__"zdwuch4",
       "south" : __DIR__"zdwuch1",
]));
		set("no_dead", 1);
        set("no_clean_up", 0);
	set("outdoors","gaibang");
       set("sleep_room",1);	

        setup();
}
