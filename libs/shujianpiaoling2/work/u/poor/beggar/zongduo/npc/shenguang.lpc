// wangqr.c

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int paper_count = 1;
int ask_wu();

void create()
{
        set_name("神光", ({ "shen guang", "shen", "guang" }) );
        set("nickname", HIY "飘渺神僧" NOR);
        set("title", "丐帮受业长老");
        set("gender", "男性");
        set("age",65);
        set("long",
 "他本是位高僧，后因为对老帮主的景仰加入了丐帮，但是现在他武功全失。\n");
        set("inquiry", ([
                "悟" : (: ask_wu :),
                "悟道" : (: ask_wu :),
                "无我境界" : (: ask_wu :),
                "老帮主": "哎，老帮主已经失踪多年。但是..........",
                "商殷宝藏": "这宝藏里有什么谁都不知道，但是已经流传很久了。",
                "商殷藏宝图": "我的好友刘长老已经去找地图了。",
                "翡翠匕首": "我的功夫就是被这柄匕首废的，刘长老说：老帮主的失踪和匕首有关。",
        ]) ); 
        set("chat_chance", 1);
        set("chat_msg", ({
        "神光叹了口气，说道：师祖总说我悟不到无我的境界，无我到底是什么境界呢？\n",
        "神光自言自语道：商殷宝藏不知道害死了多少人。\n",
        "神光说道：刘长老上次来说，他已经打探到老帮主的踪迹了。\n",
        }));
        set("str", 36);
        set("max_kee", 5000);
        set("kee", 5000);
        set("force", 6000);
        set("max_force", 5000);
        set("combat_exp",1000000);

        set_skill("force", 200);
        set_skill("begging", 200);
        set_skill("canyun_force", 200);
        set_skill("literate", 200);
        map_skill("force", "canyun_force");

        create_family("丐帮", 2, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/sengpao")->wear();
}

int ask_wu()
{
	object me,ob,xiao;
	int sk;
	me = this_player();
	ob = this_object();
	sk = (int)me->query_skill("literate", 1);
	if ( (sk > 50) && (ob->query("paper_count") < 0) ){
	command("say 我的手书已经送人了。\n");
	return 1;
	}
	else if  (sk > 50) {
	command("say 我就把我一生所悟到的传与你吧。\n");
	ob->add("paper_count", -1);
	xiao = new(__DIR__"obj/white_paper");
	xiao->move(me);
	message_vision("$N给$n一张白色纸片。\n",ob,me);
	return 1;
	}
	else {
	command("shake");
	command("say 这是我一生所悟，怎能随便送人！\n");
	return 1;
	}
}

int accept_object(object me, object ob)
{
         object clasp;
         me=this_player();
         if( (string)ob->query("name") !="黄色纸片" && (string)ob->query("id") !="yellow_paper"  ) 
         {
         command("say 一切本是空，你又何必呢？\n");
         }
         else{
         command("say 贫僧茅塞顿开，多谢师主指点。");
         command("say 这个拜山帖你就先拿走吧。");
         command("whisper " + me->query("id") + " 有一片地图在飞鹰寨中。\n");
         ob = new(__DIR__"obj/mentie");
         ob->move(me);
      }
        return 1;       
}

void attempt_apprentice(object ob)
{
	command("say 这位" + RANK_D->query_respect(ob) + "，贫僧从不收徒。\n");
}
