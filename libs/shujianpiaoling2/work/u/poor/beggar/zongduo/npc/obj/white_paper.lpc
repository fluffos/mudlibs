// stone.c

inherit ITEM;

void create() {
  set_name("白色纸片", ({ "white_paper" }));
  set_weight(100);
  set("long", @LONG 
纸片上写着：
                莫   朝   心   身
                使   朝   如   是
                惹   勤   明   菩
      神        尘   拂   镜   提
      光        埃   拭   台   树
      书

LONG
  );
  set("unit", "张");
  set("material", "paper");
}
