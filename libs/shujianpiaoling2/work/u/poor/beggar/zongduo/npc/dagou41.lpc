#include <ansi.h>
inherit NPC;
void create() {
  set_name("王铁狂", ({ "wang" }));
  set("title", "丐帮打狗阵守阵弟子");
  set("gender", "男性");
  set("age", 66);
  set("long", "他是打狗阵的守阵弟子。\n");

  set("max_kee", 3500);
  set("kee", 3500);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 80);
  set("combat_exp", 400000);

  set_skill("unarmed", 140);
  set_skill("force", 140);
  set_skill("parry", 140);
  set_skill("dodge", 140);
  set_skill("stick", 140);

  set_skill("iron_strike", 140);
  set_skill("hitdog_zhen", 140);
  set_skill("canyun_force", 140);
  set_skill("hitdog_stick", 140);
  set_skill("literate", 100);

  map_skill("dodge", "hitdog_zhen");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("parry", "hitdog_stick");
  map_skill("stick", "hitdog_stick");

  create_family("丐帮", 5, "弟子");

  setup();
  carry_object("/u/poor/obj/weapon/stick")->wield();
  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}

void die(string arg) {
  object me;
  me = this_player();
  me->set("marks/baishi", 1);
  ::die();
}
