#include <ansi.h>
inherit NPC;
void create()
{
        set_name("宋古东", ({ "dong" }) );
        set("title", "丐帮打狗阵守阵弟子");
        set("gender", "男性" );
        set("age", 46);
        set("long",     "他是打狗阵的守阵弟子。\n");

        set("max_kee", 3000);
        set("kee", 3000);
        set("force", 1500);
        set("max_force", 1500);
        set("force_factor",80);
        set("combat_exp",250000);

        set_skill("unarmed", 110);
        set_skill("force", 110);
        set_skill("parry", 110);
        set_skill("dodge", 110);
        set_skill("blade", 110);

        set_skill("iron_strike", 110);
        set_skill("hidden_dodge", 110);
        set_skill("canyun_force", 110);
        set_skill("golden_blade", 110);
        set_skill("literate", 100);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
        map_skill("parry", "golden_blade");
        map_skill("blade", "golden_blade");

        create_family("丐帮", 5, "弟子");

        setup();
        carry_object("/u/poor/obj/weapon/blade")->wield();
        carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
