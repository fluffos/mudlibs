#include <ansi.h>
inherit NPC;
void create()
{
        set_name("项丛", ({ "xiang" }) );
        set("title", "丐帮打狗阵守阵弟子");
        set("gender", "男性" );
        set("age", 55);
        set("long",     "他是打狗阵的守阵弟子。\n");

        set("max_kee", 2000);
        set("kee", 2000);
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor",50);
        set("combat_exp",200000);
        set("attitude", "aggressive");

        set_skill("unarmed", 100);
        set_skill("force", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("sword", 100);

        set_skill("iron_strike", 100);
        set_skill("hidden_dodge", 100);
        set_skill("canyun_force", 100);
        set_skill("crazy_sword", 100);
        set_skill("literate", 100);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
        map_skill("parry", "crazy_sword");
        map_skill("sword", "crazy_sword");

        create_family("丐帮", 5, "弟子");

        setup();
        carry_object("/u/poor/obj/weapon/sword")->wield();
        carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
