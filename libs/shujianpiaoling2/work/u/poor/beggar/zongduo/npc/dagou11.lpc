#include <ansi.h>
inherit NPC;
void create()
{
        set_name("赵处良", ({ "zhao chuliang", "zhao"  }) );
        set("title", "丐帮打狗阵守阵弟子");
        set("gender", "男性" );
        set("age", 45);
        set("long",     "他是打狗阵的守阵弟子。\n");

        set("max_kee", 1000);
        set("kee", 1000);
        set("force", 800);
        set("max_force", 800);
        set("force_factor",50);
        set("combat_exp",100000);

        set_skill("unarmed", 80);
        set_skill("force", 80);
        set_skill("parry", 80);
        set_skill("dodge", 80);
        set_skill("stick", 80);

        set_skill("iron_strike", 80);
        set_skill("hidden_dodge", 80);
        set_skill("canyun_force", 80);
        set_skill("literate", 80);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
 
        create_family("丐帮", 5, "弟子");

        setup();
        carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
