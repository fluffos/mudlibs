#include <ansi.h>
inherit NPC;
void create() {
  set_name("彭衫", ({ "peng" }));
  set("title", "丐帮打狗阵守阵弟子");
  set("gender", "男性");
  set("age", 15);
  set("long", "他是打狗阵的守阵弟子。\n");

  set("max_kee", 1500);
  set("kee", 1500);
  set("force", 900);
  set("max_force", 900);
  set("force_factor", 50);
  set("combat_exp", 200000);
  set("attitude", "aggressive");

  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);

  set_skill("iron_strike", 100);
  set_skill("hidden_dodge", 100);
  set_skill("canyun_force", 100);
  set_skill("literate", 100);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");

  create_family("丐帮", 5, "弟子");

  setup();
  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
