// girl.c

inherit NPC;

void create()
{
        set_name("小和尚", ({ "heshang" }) );
        set("gender", "男性" );
        set("age", 24);
        set("str", 15);
        set("cor", 21);
        set("cps", 20);
        set("int", 25);

        set("max_force", 300);
        set("force", 300);
        set("force_factor", 10);
	 set("attitude", "friendly");


        set("long",@LONG
这是一位吃斋念佛的和尚。
LONG);

        set("combat_exp", 22250);
        set("score", 2);

        set_skill("unarmed", 60);
        set_skill("parry", 60);
        set_skill("dodge", 60);
     
        setup();
        carry_object("/u/poor/obj/cloth/sengpao")->wear();
}

