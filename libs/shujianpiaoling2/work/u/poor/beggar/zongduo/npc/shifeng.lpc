// wangqr.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("史枫", ({ "shi feng", "master", "shi" }));
  set("nickname", HIR "无招剑狂" NOR);
  set("title", "丐帮传功长老");
  set("gender", "男性");
  set("age", 65);
  set("long",
    "他以前是名镇江湖的使剑高手，由于老帮主对他有恩，他就投靠了丐帮。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
    "老帮主": "老帮主已经失踪多年。",
  ]));
  set("max_kee", 3000);
  set("kee", 3000);
  set("force", 6000);
  set("max_force", 5000);
  set("force_factor", 60);
  set("combat_exp", 500000);

  set_skill("unarmed", 200);
  set_skill("sword", 200);
  set_skill("force", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("begging", 200);

  set_skill("iron_strike", 200);
  set_skill("hidden_dodge", 200);
  set_skill("xianglong_strike", 180);
  set_skill("canyun_force", 200);
  set_skill("crazy_sword", 200);
  set_skill("literate", 120);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("sword", "crazy_sword");
  map_skill("parry", "crazy_sword");

  create_family("丐帮", 2, "弟子");

  setup();

  carry_object("/u/poor/obj/weapon/dragon-sword")->wield();
  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}

void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg > 140) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮八袋弟子");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去找吴昆修习武功吧。\n");
  }
}
