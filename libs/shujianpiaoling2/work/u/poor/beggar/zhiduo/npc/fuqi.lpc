// fuqi.c

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("付崎", ({ "fu qi", "master", "fuqi" }) );
        set("nickname", WHT "铁指银钩" NOR);
        set("title", "丐帮五袋弟子");
        set("gender", "男性");
        set("age", 25);
        set("long",
 "他是负责守护智舵的弟子，带人很温和。\n");
        set("inquiry", ([
                "拜师": "问那么多干吗，快拜师吧！",
                "进门": "只有本帮弟子才能进入智舵。",
        ]) ); 
        set("max_kee", 1000);
        set("kee", 1000);
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor",30);
        set("combat_exp",80000);

        set_skill("unarmed", 80);
        set_skill("force", 80);
        set_skill("parry", 80);
        set_skill("dodge", 80);
        set_skill("begging", 80);

        set_skill("iron_strike", 80);
        set_skill("hidden_dodge", 80);
        set_skill("canyun_force", 80);
        set_skill("literate", 80);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");

        create_family("丐帮", 6, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/jingyi")->wear();
}

void attempt_apprentice(object ob)
{
	int beg = (int)ob->query_skill("begging", 1);

	if( beg > 40) {
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
	command("recruit " + ob->query("id") );
	command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
	ob->set("class","gaibang");
	ob->set("title","丐帮净衣帮智舵弟子");
	}
	else {
	command("say 这位" + RANK_D->query_respect(ob) + "还是去仁舵修习武功吧。\n");
	}
}
