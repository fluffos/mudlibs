// mengxiance

#include <ansi.h>
inherit NPC;

void create() {
  set_name("玉池若明", ({ "yuchi ruoming", "master", "ruoming" }));
  set("nickname", HIW "白面书生" NOR);
  set("title", "丐帮大智分舵舵主");
  set("gender", "男性");
  set("age", 35);
  set("long",
    "他就是丐帮大智分舵的舵主。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
    "古董": "你听说过吗？商代玉镯是十分昂贵的！",
    "喜好": "我爱收集天下的古董。",
    "钥匙": "你问那么多干吗？",
  ]));
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 80);
  set("combat_exp", 300000);

  set_skill("unarmed", 140);
  set_skill("force", 140);
  set_skill("parry", 140);
  set_skill("dodge", 140);
  set_skill("begging", 140);

  set_skill("iron_strike", 140);
  set_skill("xianglong_strike", 120);
  set_skill("hidden_dodge", 140);
  set_skill("canyun_force", 140);
  set_skill("literate", 120);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");

  create_family("丐帮", 5, "弟子");

  setup();
  carry_object("/u/poor/obj/weapon/iron_finger")->wear();
  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}

void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg > 100) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮智舵副舵主");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去找孟献策修习武功吧。\n");
  }
}

int accept_object(object me, object ob) {
  object clasp;
  me = this_player();
  if ((string)ob->query("id") != "sd-yuzhuo") {
    command("say 这不是我要的商代玉镯。\n");
    return 0;
  } else {
    command("say 这玉镯我可得到了！");
    command("say 这把钥匙你就拿走吧。");
    ob = new(__DIR__ "obj/yellow-key");
    ob->move(me);
  }
  return 1;
}
