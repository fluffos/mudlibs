// Room: /jing/duankit.c

inherit ROOM;

void create()
{
	set("short", "洞中");
	set("long", @LONG
这里一片漆黑，只能借助洞口的点点光亮来分辨四周围
的事物。不时能听到石钟乳流下的水声，在四周都有洞穴。
LONG
	);
       set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"hole2",
  "east" : __DIR__"hole5",
  "north" : __DIR__"hole2",
  "south" : __DIR__"hole4",

]));
	set("no_clean_up", 0);

	setup();
}
void init()
{
        add_action("do_go","go");
}

int do_go()
{
if(random(3)){
this_player()->move(this_object());
return 1;
}
}

