// fish.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("吸血蝙蝠", ({ "bianfu" }) );
	set("long",	"一只吸食血液的蝙蝠。\n");

	set("race", "野兽");
	set("age", 1);
       set("attitude", "aggressive");
	set("max_gin", 400);
	set("max_kee", 400);
	set("max_sen", 400);
       set_skill("move", 30);
       set_skill("unarmed", 30);
       set_skill("parry", 30);

	set("str", 90);
	set("cor", 60);

	set("limbs", ({ "头部", "身体" }) );
	set("verbs", ({ "bite" }) );

	set_temp("apply/attack", 20);
	set_temp("apply/damage", 20);
	set_temp("apply/armor", 20);
	set("combat_exp", 50000);
	setup();
}

