// laoshen.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;

void create()
{
	set_name("无名客", ({ "no name", "master" }) );
	set("gender", "男性");
       set("nickname", BLU "匕首的主人" NOR);
       set("title", "寒灵山庄第二代庄主");
	set("age",55);
	set("attitude", "peaceful");
	set("str", 40);
	set("int", 40);
	set("long",@LONG
他就是江湖上传说的大魔头无名客，没有人见过他的真正面目，他总
是带着一个人皮面具，以各种模样出现在人的面前。由于他总是用匕
首当做武器，所以江湖上又叫他匕首的主人。
LONG
	);
	set("max_force", 6000);
	set("force", 8000);
	set("force_factor", 80);
	set("combat_exp", 2000000);
	set("score", 20000);
       set("inquiry", ([
                "丐帮老帮主": "他被我打下了山崖。",
                "杨姑娘": "她敌不过我。",
                "刘长老": "他没挡的了我一招。",
                "神光": "他仅仅接了我五招。",
        ]) ); 

	set_skill("dodge", 250);
	set_skill("parry", 250);
	set_skill("sword", 250);
	set_skill("force", 250);
	set_skill("unarmed", 250);
	set_skill("literate", 100);
	set_skill("hanling_sword", 200);
	set_skill("hanling_force", 200);
	set_skill("hanling_steps", 200);

	map_skill("sword", "hanling_sword");
	map_skill("parry", "hanling_sword");
	map_skill("force", "hanling_force");
	map_skill("dodge", "hanling_steps");

	create_family("寒灵山庄", 2, "传人");

	setup();
	carry_object(__DIR__"obj/fcdagger")->wield();
	carry_object(__DIR__"obj/heiyi")->wear();
	carry_object(__DIR__"obj/mianju")->wear();
}

void attempt_apprentice(object ob)
{
	int exp = (int)ob->query("combat_exp");
	if( exp > 500000) {
       command("smile");
       command("say 很好，" + RANK_D->query_respect(ob) + 
"跟随我修炼，他日必定有成。\n");
       command("recruit " + ob->query("id") );
       ob->set("class", "hanling");
	}
	else {
	command("say 这位" + RANK_D->query_respect(ob) + "不要异想天开了，我怎么能收你为徒。\n");
	}
}

int accept_fight()
{
	object me,ob;
	me = this_player();
     	ob = this_object();
       command("say 哈哈！你也配跟我交手？在下不奉陪了。");
	tell_object(me,HIY"只见无名客人影一晃，他已不见踪迹了。\n"NOR);
	destruct(ob);
}



