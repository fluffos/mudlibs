// fish.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("老虎", ({ "tiger" }) );
	set("long",	"一只凶猛的老虎。\n");

	set("race", "野兽");
	set("age", 6);
       set("attitude", "aggressive");
	set("max_gin", 2000);
	set("max_kee", 2000);
	set("max_sen", 2000);
       set_skill("move", 80);
       set_skill("unarmed", 80);
       set_skill("parry", 80);

	set("str", 90);
	set("cor", 60);

	set("limbs", ({ "头部", "身体" }) );
	set("verbs", ({ "bite" }) );

	set_temp("apply/attack", 40);
	set_temp("apply/damage", 40);
	set_temp("apply/armor", 40);
	set("combat_exp", 300000);
	setup();
}

