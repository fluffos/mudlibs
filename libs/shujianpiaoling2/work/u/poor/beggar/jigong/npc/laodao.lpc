#include <ansi.h>
inherit NPC;
void create()
{
        set_name("老道", ({ "laodao" }) );
        set("gender", "男性" );
        set("age", 45);
        set("str", 30);
        set("cor", 10);
        set("cps", 15);
        set("per", 10);
        set("int", 20);
        set("chat_chance_combat", 10);
        set("chat_chance", 20);
        set("chat_msg", ({
        "老道说道：南面的“朝云穴”里太可怕了。\n",
        }) );
        set("long",     "他是一个修身养性的老道。\n");

        set("combat_exp", 50000);

        set_skill("dodge", 60);
        set_skill("parry", 60);
        set_skill("unarmed", 60);

        setup();

        carry_object(__DIR__"obj/daopao")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 快回去吧。");      
}