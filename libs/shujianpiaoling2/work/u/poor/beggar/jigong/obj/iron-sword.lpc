// bamboo_sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("玄铁剑", ({ "iron_sword" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 10000);
                set("material", "iron");
                set("long", 
"这是一把由玄铁打造成的剑，锋利无比。。\n");
                set("wield_msg", "只见一道青光闪过，$N已经把$n握在手中。\n");
                set("unequip_msg", "只见一道青光闪过，$N放下手中的$n。\n");
        }
        init_sword(150);
        setup();
}
 
