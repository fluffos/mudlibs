// /u/poor/gaibang/hj
inherit ROOM;
#include <ansi.h>;

void create()
{
        set("short", "山腰");
        set("long", @LONG
这里已经接近了山顶，从这里向东就是无尘崖了，南边不远
就是“朝云穴”，北边是一条下山的小路。
LONG
        );
        set("exits", ([/* sizeof() == 3 */
           "south" : __DIR__"hole1",
           "east" : __DIR__"wuchenya",
           "northwest" : __DIR__"road2",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/laodao" : 1,
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

        setup();
}

void init()
{
	add_action("do_go", "go");
}

int do_go(string arg)
{
	object me,ob;
       me = this_player();
	if( me->query("marks/noname") ) {
	tell_object(me,CYN"无名客突然出现在你眼前，喝道：受死吧。\n\n"NOR);
	tell_object(me,HIR"无名客看起来想杀死你！\n\n"NOR);
	message_vision("无名客把匕首交在左手，右手施出一招「残命合归」，隐隐带着风声拍向$N的头部！\n", me);
	message_vision("结果只听见「砰」地一声巨响，$N像一捆稻草般飞了出去！！\n\n", me);
	tell_object(me,"你掉下了无尘崖。\n\n");
       me->set("marks/noname", 0);
	me->move(__DIR__"yadi1");
       me->unconcious();
       }
       else {
       }
}
