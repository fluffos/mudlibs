// /u/poor/gaibang/hj
inherit ROOM;
#include <ansi.h>;
int paper_count = 1;

void create()
{
        set("short", "无尘崖");
        set("long", @LONG
这里就是无尘崖。无尘崖位于报晓峰顶，正好有一大片空
地，在悬崖边上有一块大石头，石头上插着一把剑，东面是深
不可测的山谷，西面是一条小路。
LONG
        );
	set("item_desc", ([ /* sizeof() == 1 */
  "剑" : "一把插在石头中的剑，你可以试试拔(pull)出来。
",
]));
        set("exits", ([/* sizeof() == 1 */
           "west" : __DIR__"road3",
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

          setup();
}
void init()
{
	add_action("do_pull", "pull");
}


int do_pull(string arg)
{
	object me,ob,master;
	int n,sk;
       n = random(100);
	me = this_player();
	sk = (int)me->query("kar");
	if ( ( n < 10+sk/2) && (paper_count!=0) ){
	ob = new(__DIR__"obj/wuchen-sword");
       ob->set_amount(1);
	ob->move(me);
	me->receive_damage("sen", 50);
	me->receive_damage("kee", 200);
	message_vision("$N用力把剑拔了出来。\n\n", me);
	tell_object(me,HIR"你的力量消失了。\n"NOR);
       paper_count--;
	return 1;
	}
	else if  ( n < 5+sk/4) {
	message_vision("剑已经被拔下来了。\n", me);
	tell_object(me,"忽然只见崖上人影闪过，一个蒙面人出现在崖上。\n");
	tell_object(me,HIY"有人走了过来。\n\n"NOR);
	tell_object(me,HIR"你的力量消失了。\n"NOR);
	me->receive_damage("sen", 50);
	me->receive_damage("kee", 200);
       me->set("marks/noname", 1);
	master=new(__DIR__"npc/noname");
	master->move(environment(me));
	return 1;
	}
	else {
	me->receive_damage("kee", 100);
	message_vision("$N没有那么大的力气。\n\n", me);
	tell_object(me,HIR"你的力量消失了。\n"NOR);
	return 1;
	}
}

int valid_leave(object me, string dir)
{
        object killer;
        me->clear_condition();  
        if( objectp(present("no name", environment(me))) )
        {
        killer=present("no name", environment(me));
        destruct(killer);
        }
        return 1;
}

