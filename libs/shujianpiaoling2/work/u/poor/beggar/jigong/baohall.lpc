// Room: /jing/duankit.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", "商殷宝藏中");
  set("long", @LONG
你来到了商殷宝藏之中，这里四边有四个出口，南边的
是你进来的入口，剩下的三个有两个生门，一个死门。进入
死门是必死无疑，进入生门不知道会发生什么。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "baoroom1",
    "south": __DIR__ "baodoor",
    "west": __DIR__ "baodie",
    "east": __DIR__ "baoroom2",
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_go", "go");
}

int do_go(string arg) {
  object me, ob;
  me = this_player();

  if (arg == "west") {
    message_vision("$N向西边的门走去。\n\n", me);
    message_vision(HIR "突然从墙壁上射出几只箭刺中了$N。\n" NOR, me);
    me->die();
    return 1;
  } else return 0;
}
