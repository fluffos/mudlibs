// fifth npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();

void create()
{
        set_name("章大凯", ({ "zhang dakai", "master", "zhang" }) );
        set("title", "丐帮智舵弟子");
        set("gender", "男性");
        set("age", 25);
        set("long",
 "他是丐帮智舵弟子，脾气十分不好，这里的人都怕他。\n");
        set("inquiry", ([
                "拜师": "想拜我为师？我怎么干当呢？",
                "老帮主": "哎，老帮主已经失踪多年。",
                "污衣帮": "随便说是要死人的。",
                "加入污衣帮": "你没开玩笑吧。",
                "穿污衣，行侠义": (: ask_me :),
                "升级": (: ask_me1 :),
        ]) ); 
        set("str", 36);
        set("max_kee", 1500);
        set("kee", 1500);
        set("force", 800);
        set("max_force", 800);
        set("force_factor",50);
        set("combat_exp",120000);

        set_skill("unarmed", 120);
        set_skill("force", 120);
        set_skill("parry", 120);
        set_skill("dodge", 120);
        set_skill("begging", 120);

        set_skill("hidden_dodge", 120);
        set_skill("canyun_force", 120);
        set_skill("literate", 100);
        set_skill("iron_strike", 120);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");

        create_family("丐帮污衣帮", 6, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/wuyi")->wear();
}

void attempt_apprentice(object ob)
{
	if (!ob->query("marks/wuyi4") ) {
	command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
	}
	else {
        command("say 很好，" + RANK_D->query_respect(ob) +
"多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
       ob->set("class", "gaibang");
       ob->set("title","丐帮污衣帮仁舵弟子");
	}
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "gaibang");
}
int accept_object(object me, object ob)
{
        int exp,pot;
         me=this_player();
        exp = (int) me->query("combat_exp");
        pot = (int) me->query("potential");

	if( me->query("marks/wuyi4") ) {
       if( (string)ob->query("id") !="star-cloth") {
       command("say 这不是我想要的。\n");
       return 0;
	} 
	else {
	tell_object(me,"章大凯接过七星道袍。\n\n"
"章大凯说道：你到丐帮大仁分舵，找柳无言，告诉她暗号，她就会收你为徒弟的。\n\n");
	tell_object(me,HIM"你增加了250点经验。\n"NOR);
	tell_object(me,HIM"你增加了200点潜能。\n\n"NOR);
	me->set("marks/wuyi5", 1);
	me->delete("marks/wuyi4", 1);
       me->set("combat_exp", (int) exp + 250);
       me->set("potential", (int) pot + 200);
	return 1;}
	} else
		say("章大凯接过七星道袍。\n\n");
	return 1;
}

int ask_me()
{
	object me;
       me = this_player();
       if( !me->query("marks/wuyi4") ) {
	tell_object(me,"章大凯说道：你在他妈的说什么？！\n");
	return 1;
	}
       else {
	tell_object(me,"章大凯说道：智明那个王八，就知道给我找麻烦，你还等什么呢？？\n\n");
       return 1;
	}
}

int ask_me1()
{
	object me;
       me = this_player();
       if( this_player()->query_skill("begging",1)<50) {
	tell_object(me,"章大凯说道：你他妈在练练修炼乞讨术吧！\n");
	return 1;
	}
       else {
	tell_object(me,"章大凯说道：你快去把七星道袍给我找来。\n\n");
       return 1;
	}
}
