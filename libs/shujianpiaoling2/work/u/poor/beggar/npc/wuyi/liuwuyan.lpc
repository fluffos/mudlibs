// sixth npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();

void create() {
  set_name("柳无言", ({ "liu wuyan", "master", "liu" }));
  set("title", "丐帮仁舵弟子");
  set("gender", "女性");
  set("age", 26);
  set("long",
    "她是一个丐帮仁舵弟子。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "老帮主": "哎，老帮主已经失踪多年。",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "升级": (: ask_me1 :),
  ]));
  set("str", 26);
  set("max_kee", 1800);
  set("kee", 1800);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 50);
  set("combat_exp", 150000);

  set_skill("unarmed", 120);
  set_skill("force", 120);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set_skill("whip", 120);
  set_skill("begging", 120);

  set_skill("hidden_dodge", 120);
  set_skill("canyun_force", 120);
  set_skill("literate", 120);
  set_skill("iron_strike", 120);
  set_skill("fire_whip", 120);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("whip", "fire_whip");
  map_skill("parry", "fire_whip");

  create_family("丐帮污衣帮", 6, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/wuyi")->wear();
  carry_object("/u/poor/obj/weapon/whip")->wield();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/wuyi5")) {
    command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "gaibang");
    ob->set("title", "丐帮污衣帮礼舵弟子");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
int accept_object(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if (me->query("marks/wuyi5")) {
    if ((string)ob->query("id") != "wuse-yanzhi") {
      command("say 这不是我想要的。\n");
      return 0;
    } else {
      tell_object(me, "柳无言冲你笑了笑，接过无色胭脂。\n\n"
        "柳无言说道：你去找张家口的一个穷老头，告诉他暗号，他就会收你为徒弟的。\n\n");
      tell_object(me, HIM "你增加了300点经验。\n" NOR);
      tell_object(me, HIM "你增加了250点潜能。\n\n" NOR);
      me->set("marks/wuyi6", 1);
      me->delete("marks/wuyi5", 1);
      me->set("combat_exp", (int)exp + 300);
      me->set("potential", (int)pot + 250);
      return 1;
    }
  } else
    say("柳无言冲你笑了笑，接过无色胭脂。\n\n");
  return 1;
}

int ask_me() {
  object me;
  me = this_player();
  if (!me->query("marks/wuyi5")) {
    tell_object(me, "柳无言说道：你是在说绕口令吗？！\n");
    return 1;
  } else {
    tell_object(me, "柳无言说道：是章大凯让你来的呀！\n\n");
    return 1;
  }
}

int ask_me1() {
  object me;
  me = this_player();
  if (this_player()->query_skill("begging", 1) < 60) {
    tell_object(me, "柳无言说道：你现在不够升级的资格，继续修炼乞讨术吧！\n");
    return 1;
  } else {
    tell_object(me, "柳无言说道：去把无色胭脂给我找来。\n\n");
    return 1;
  }
}
