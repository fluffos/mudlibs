// tenth npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();

void create() {
  set_name("寒渊", ({ "han yuan", "master", "han" }));
  set("gender", "男性");
  set("nickname", HIB "万里鞭" NOR);
  set("title", "丐帮大仁分舵舵主");
  set("age", 28);
  set("long",
    "他是丐帮大礼分舵的舵主。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "老帮主": "哎，老帮主已经失踪多年。",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "升级": (: ask_me1 :),
  ]));
  set("str", 36);
  set("max_kee", 3000);
  set("kee", 3000);
  set("force", 2500);
  set("max_force", 2500);
  set("force_factor", 80);
  set("combat_exp", 300000);

  set_skill("unarmed", 200);
  set_skill("force", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("whip", 200);
  set_skill("begging", 200);
  set_skill("xianglong_strike", 200);

  set_skill("fire_whip", 200);
  set_skill("hidden_dodge", 200);
  set_skill("canyun_force", 200);
  set_skill("literate", 180);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");
  map_skill("whip", "fire_whip");
  map_skill("parry", "fire_whip");

  create_family("丐帮污衣帮", 3, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/wuyi")->wear();
  carry_object("/u/poor/obj/weapon/whip")->wield();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/wuyi9")) {
    command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "gaibang");
    ob->set("title", "丐帮污衣帮礼舵副舵主");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
int accept_object(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if (me->query("marks/wuyi9")) {
    if ((string)ob->query("id") != "xy-guzi") {
      command("say 这不是我想要的。\n");
      return 0;
    } else {
      tell_object(me, "寒渊接过象牙骨子。\n\n"
        "寒渊说道：你去找丐帮大礼分舵的神光长老，告诉他暗号，他就会收你为徒弟的。\n\n");
      tell_object(me, HIM "你增加了500点经验。\n" NOR);
      tell_object(me, HIM "你增加了450点潜能。\n\n" NOR);
      me->set("marks/wuyi10", 1);
      me->delete("marks/wuyi9", 1);
      me->set("combat_exp", (int)exp + 500);
      me->set("potential", (int)pot + 450);
      return 1;
    }
  } else
    say("寒渊接过象牙骨子。\n\n");
  return 1;
}

int ask_me() {
  object me;
  me = this_player();
  if (!me->query("marks/wuyi9")) {
    tell_object(me, "寒渊说道：再胡说就打死你！\n");
    return 1;
  } else {
    tell_object(me, "寒渊说道：是罗鹏让你来的，还不拜师？\n\n");
    return 1;
  }
}

int ask_me1() {
  object me;
  me = this_player();
  if (this_player()->query_skill("begging", 1) < 100) {
    tell_object(me, "寒渊说道：你现在不够升级的资格，继续修炼乞讨术吧！\n");
    return 1;
  } else {
    tell_object(me, "寒渊说道：去把象牙骨子给我找来。\n\n");
    return 1;
  }
}
