// third npc by poor

#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
int ask_me();
int ask_me1();

void create() {
  set_name("猎人", ({ "hunter", "master", "lieren" }));
  set("title", "九华山");
  set("gender", "男性");
  set("age", 35);
  set("long",
    "他是一个普通的猎人。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "老帮主": "哎，老帮主已经失踪多年。",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "虎": "我听说鸡公山里有虎。",
    "兔肉": "您要尝尝吗。",
    "蛇": "我害怕蛇。",
    "狼": "山里有狼，小心点吧。",
    "咸猪肉": "我可没有这东西。",
    "升级": (: ask_me1 :),
  ]));
  set("chat_chance_combat", 1);
  set("chat_chance", 1);
  set("chat_msg", ({
    "猎人说道：你想尝尝野味吗？\n"
  }));
  set("str", 36);
  set("max_kee", 1200);
  set("kee", 1200);
  set("force", 600);
  set("max_force", 600);
  set("force_factor", 50);
  set("combat_exp", 50000);

  set_skill("unarmed", 80);
  set_skill("force", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("begging", 80);
  set_skill("stick", 80);

  set_skill("hidden_dodge", 80);
  set_skill("canyun_force", 80);
  set_skill("literate", 70);
  set_skill("iron_strike", 80);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");

  set("vendor_goods", ([
    "/u/poor/beggar/jiuhua/npc/obj/turou": 5,
    "/u/poor/beggar/jiuhua/npc/obj/yejirou": 5,
    "/u/poor/beggar/jiuhua/npc/obj/yeyarou": 5,
    "/u/poor/beggar/jiuhua/npc/obj/zhzirou": 5,
  ]));

  create_family("丐帮污衣帮", 7, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/wuyi")->wear();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/wuyi2")) {
    command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "gaibang");
    ob->set("title", "丐帮污衣帮五袋弟子");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
int accept_object(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if (me->query("marks/wuyi2")) {
    if ((string)ob->query("id") != "sherou") {
      command("say 这不是我想要的。\n");
      return 0;
    } else {
      tell_object(me, "猎人接过蛇肉。\n\n"
        "猎人说道：你去找甘露寺中的智明，告诉他暗号，是我让你去的。\n\n");
      tell_object(me, HIM "你增加了150点经验。\n" NOR);
      tell_object(me, HIM "你增加了100点潜能。\n\n" NOR);
      me->set("marks/wuyi3", 1);
      me->delete("marks/wuyi2", 1);
      me->set("combat_exp", (int)exp + 150);
      me->set("potential", (int)pot + 100);
      return 1;
    }
  } else
    say("猎人接过蛇肉。\n\n");
  return 1;
}

int ask_me() {
  object me;
  me = this_player();
  if (!me->query("marks/wuyi2")) {
    tell_object(me, "猎人说道：您是要买什么野味吗？！\n");
    return 1;
  } else {
    tell_object(me, "猎人说道：是李清云让你来的，还不快拜师？\n\n");
    return 1;
  }
}

int ask_me1() {
  object me;
  me = this_player();
  if (this_player()->query_skill("begging", 1) < 20) {
    tell_object(me, "猎人说道：你现在不够升级的资格，继续修炼乞讨术吧！\n");
    return 1;
  } else {
    tell_object(me, "猎人说道：去把蛇肉给我找来。\n\n");
    return 1;
  }
}

void init() {
  add_action("do_vendor_list", "list");
}
