#include <ansi.h>
inherit NPC;
void create()
{
        set_name("人厨子", ({ "renchuzi" }) );
        set("title", "天下第一厨子");
        set("gender", "男性" );
        set("age", 65);
        set("str", 90);
        set("cor", 10);
        set("cps", 15);
        set("per", 10);
        set("int", 20);
        set("long",     "他就是天下第一的厨子。\n");

        set("max_kee", 2200);
        set("kee", 2200);
        set("force", 1000);
        set("max_force", 1500);
        set("force_factor",10);
        set("combat_exp",60000);
        set("inquiry", ([
                "学做菜": "你的臂力太低了！能搬动门外那块石头后再来。",
        ]));

        set_skill("unarmed", 80);
        set_skill("sword", 50);
        set_skill("force", 80);
        set_skill("parry", 80);
        set_skill("dodge", 80);
        set_skill("stick", 80);

        set_skill("iron_strike", 80);
        set_skill("hidden_dodge", 80);
        set_skill("canyun_force", 80);
        set_skill("literate", 50);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
 
        setup();
        carry_object("/obj/cloth")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 你也是来学做菜的？");      
}