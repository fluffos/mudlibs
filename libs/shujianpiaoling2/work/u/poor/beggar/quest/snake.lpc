// fish.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("赤链蛇", ({ "snake" }));
  set("long", "一条一米多长的赤链蛇，这种蛇性情凶猛，会吞食同类。\n");

  set("race", "野兽");
  set("age", 5);
  set("attitude", "aggressive");

  set("max_gin", 400);
  set("max_kee", 400);
  set("max_sen", 400);
  set_skill("dodge", 30);
  set_skill("unarmed", 30);
  set_skill("parry", 30);

  set("str", 10);
  set("cor", 50);

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 10);
  set_temp("apply/damage", 10);
  set_temp("apply/armor", 10);

  set("combat_exp", 10000);
  setup();
}
void die() {
  object rou;
  rou = new(__DIR__ "sherou");
  rou->move(this_object());
  ::die();
}
