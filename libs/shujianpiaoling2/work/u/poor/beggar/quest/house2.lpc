// Room: 炒菜屋

inherit ROOM;
#include <ansi.h>
int do_cook(string arg);

void create() {
  set("short", "竹棚");
  set("long", @LONG
你走进了一间由竹子搭成的竹棚，棚子里的陈设很简单，
在棚子的右边有两个灶，上边放着锅和笼屉。旁边的地上放着
各式各样的炊具，你可以在这里做菜(food)。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "zhulin6",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "cooker": 1,
  ]));
  set("no_clean_up", 0);
  setup();
  //	replace_program(ROOM);
}

void init() {
  add_action("do_cook", "cook");
}

int do_cook(string arg) {
  object food1;
  object me, newfood, ob;
  me = this_player();

  if ((int)me->query("marks/food") == 1) {
    if (objectp(ob = present("beef", me))) {
      message_vision(YEL "$N把牛肉放到了炒勺里，在火上一阵狂炒，一盘蚝油牛肉做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food1");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有牛肉，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 2) {
    if (objectp(ob = present("pork", me))) {
      message_vision(YEL "你把猪肉放到了炒勺里，在火上一阵狂炒，一盘过油肉做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food2");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有猪肉，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 3) {
    if (objectp(ob = present("muer", me))) {
      message_vision(YEL "你把木耳放到了炒勺里，在火上一阵狂炒，一盘木耳菜做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food3");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有木耳，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 4) {
    if (objectp(ob = present("egg", me))) {
      message_vision(YEL "你把鸟蛋放到了炒勺里，在火上一阵狂炒，一盘荷包蛋做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food4");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有鸟蛋，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 5) {
    if (objectp(ob = present("sherou", me))) {
      message_vision(YEL "你把蛇肉放到了炒勺里，在火上一阵狂炒，一盘炒蛇肉做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food5");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有蛇肉，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 6) {
    if (objectp(ob = present("songmo", me))) {
      message_vision(YEL "你把松蘑放到了炒勺里，在火上一阵狂炒，一盘小鸡炖松蘑做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food6");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有松蘑，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 7) {
    if (objectp(ob = present("xiaocao", me))) {
      message_vision(YEL "你把紫色小草放到了炒勺里，在火上一阵狂炒，一盘香野菜做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food7");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有紫色小草，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 8) {
    if (objectp(ob = present("turou", me))) {
      message_vision(YEL "你把兔肉放到了炒勺里，在火上一阵狂炒，一盘焦香兔肉做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food8");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有兔肉，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 9) {
    if (objectp(ob = present("yejirou", me))) {
      message_vision(YEL "你把野鸡肉放到了炒勺里，在火上一阵狂炒，一盘炖野鸡肉做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food9");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有野鸡肉，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 10) {
    if (objectp(ob = present("xianrou", me))) {
      message_vision(YEL "你把咸猪肉放到了炒勺里，在火上一阵狂炒，一盘凉拌咸肉做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food10");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有咸猪肉，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 11) {
    if (objectp(ob = present("jiyu", me))) {
      message_vision(YEL "你把鲫鱼放到了炒勺里，在火上一阵狂炒，一盘红烧鲫鱼做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food11");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有鲫鱼，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 12) {
    if (objectp(ob = present("pea", me))) {
      message_vision(YEL "你把扁豆放到了炒勺里，在火上一阵狂炒，一盘油焖扁豆做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food12");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有扁豆，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 13) {
    if (objectp(ob = present("qingxia", me))) {
      message_vision(YEL "你把青虾放到了炒勺里，在火上一阵狂炒，一盘油焖大虾做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food13");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有青虾，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 14) {
    if (objectp(ob = present("rice", me))) {
      message_vision(YEL "你把大米放到了炒勺里，在火上一阵狂炒，一盘炒米饭做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food14");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有大米，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 15) {
    if (objectp(ob = present("shanbeirou", me))) {
      message_vision(YEL "你把扇贝肉放到了炒勺里，在火上一阵狂炒，一盘水晶鲜贝做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food15");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有扇贝，不能炒菜。\n" NOR);
      return 0;
    }
  }
  if ((int)me->query("marks/food") == 16) {
    if (objectp(ob = present("xierou", me))) {
      message_vision(YEL "你把螃蟹肉放到了炒勺里，在火上一阵狂炒，一盘炒蟹肉做好了。\n" NOR, me);
      newfood = new("/u/poor/food/food16");
      newfood->move(me);
      destruct(ob);
      return 1;
    } else {
      tell_object(me, YEL "你身上没有螃蟹肉，不能炒菜。\n" NOR);
      return 0;
    }
  } else {
    tell_object(me, YEL "你身上的料不全，不能炒菜。\n" NOR);
    return 0;
  }
  return 1;
}
