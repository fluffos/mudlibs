#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int paper_count = 1;
int ask_jing();

void create()
{
        set_name("空相", ({ "kong xiang" }) );
        set("title", "甘露寺方丈");
        set("gender", "男性" );
        set("age", 69);
        set("str", 30);
        set("cor", 10);
        set("cps", 15);
        set("per", 10);
        set("int", 20);
        set("chat_chance", 1);
        set("chat_msg", ({
        "空相说道：不知道无边大师进来如何。\n",
        }) );
        set("long",     "他是甘露寺的方丈，辈分很高。\n");

        set("inquiry", ([
                "法缘经" : (: ask_jing :),
                "空见": "他是少林寺的方丈。",
                "无边大师": "他是少林寺的得道高僧，现在住在本寺之中。",
        ]) ); 
        set("max_kee", 2000);
        set("kee", 2000);
        set("force", 2000);
        set("max_force", 1500);
        set("force_factor",50);
        set("combat_exp",600000);

        set_skill("unarmed", 180);
        set_skill("force", 180);
        set_skill("parry", 180);
        set_skill("dodge", 180);

        set_skill("banruo-strike", 180);
        set_skill("literate", 180);
        set_skill("buddhism", 180);


        map_skill("unarmed", "banruo-strike");
 
        create_family("甘露寺", 6, "弟子");

        setup();
        carry_object(__DIR__"obj/sengpao")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 我佛慈悲。");      
}

void attempt_apprentice(object ob)
{
	command("shake");
	message_vision("$n双手合十，对$N说道: 我是不收徒弟的。\n",ob,this_object());
	return;
}

int ask_jing()
{
	object me,ob,xiao;
	int sk;
	me = this_player();
	ob = this_object();
	sk = (int)me->query_skill("literate", 1);
	if ( (sk > 60) && (ob->query("paper_count") < 0) ){
	command("say 《法缘经》已经送人了。\n");
	return 1;
	}
	else if  (sk > 60) {
	command("say 我就把《法缘经》增与你吧。\n");
	ob->add("paper_count", -1);
	xiao = new(__DIR__"obj/fayuan-jing");
	xiao->move(me);
	message_vision("$N给$n一本《法缘经》。\n",ob,me);
	return 1;
	}
	else {
	command("shake");
	command("say 《法缘经》怎能随便送人！\n");
	return 1;
	}
}
