inherit NPC;

void create()
{
	set_name("游人", ({ "you ren","visitor" }) );
	set("race", "人类");
	set("age", 25);
	set("long", "一位文诌诌书生打扮的游客，正在欣赏风景。\n");
	set("attitude", "friendly");
	set("per", 20);	
	set("str", 26);
	set("cor", 30);
	set("kar", 15);
	set("gender","男性");
	set_skill("unarmed",20);
	set_skill("dodge",30);
	set_skill("parry",20);
	set("combat_exp", 3000);

	set("chat_chance", 3);
	set("chat_msg", ({ 
		"游人说道：九华山的风景确实不同一般。\n",
		"游人说道：东边的寺院历史十分悠久了。\n",
	}) );

	setup();
	carry_object(__DIR__"obj/sword")->wear();

	add_money("silver",15);
}

