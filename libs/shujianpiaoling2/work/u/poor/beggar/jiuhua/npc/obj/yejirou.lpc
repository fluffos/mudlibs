// rou

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("野鸡肉", ({ "yejirou" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块新鲜的野鸡肉。\n");
		set("unit", "块");
		set("value", 1000);
		set("food_remaining", 3);
		set("food_supply", 5);
	}
}
