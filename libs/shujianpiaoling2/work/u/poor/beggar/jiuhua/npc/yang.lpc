// yang.c
#include <ansi.h>;
inherit NPC;

void create()
{
	set_name("美貌女子", ({ "yang", "master" }) );
	set("title", "世外桃源主人");
	set("gender", "女性" );
	set("age", 41);
	set("per", 60);
	set("long",
		"她就是这里的主人，站在这里自然就显出她那不凡的气质，她的\n"
		"那双美丽的眼睛中隐隐呈现绿色，这是内力练到高深末测的表现。\n");
	set("inquiry", ([
		"黯然销魂掌": "这是先祖传下来的一套掌法。\n",
		"玄铁剑": "你能帮我找回来吗？一个使匕首的人夺走了玄铁剑。\n",
              "施楠": "施帮主是在跟我比武中被个用匕首的人偷袭，而摔下山崖的。\n",
              "匕首的主人": "经常用一把翡翠匕首伤人。\n",
	]) );
       set("chat_chance", 5);
	set("chat_msg", ({
		"美貌女子自言自语道：何时才能夺回玄铁剑呢。 \n",
	}) );

	set("attitude", "peaceful");
	set_skill("xiaohun_strike", 250);
	set_skill("dodge", 300);
       set_skill("unarmed", 300);
       map_skill("unarmed", "xiaohun_strike");

	setup();
	carry_object(__DIR__"obj/baiyi")->wear();
}

int recognize_apprentice(object ob)
{
	if( !ob->query("marks/yang") ){
		say("美貌女子说道：你是谁？\n");
		return 0;
	}

	return 1;
}

int accept_object(object who, object ob)
{
	if( !who->query("marks/yang") ) {
              if( (string)ob->query("id") !="iron_sword") {
			say("美貌女子说道：不要无事生非了。\n");
              	return 0;
		} else {
			say("美貌女子平平淡淡地说道：多谢你了，小女子也无以回报，你就跟着我修习武功吧。\n\n");
	              message_vision("美貌女子传授$N有关黯然销魂掌法的秘诀，$N似乎有所领悟。\n",who);
			tell_object(who,HIC"你的「黯然销魂掌法」进步了！\n"NOR);
			who->set("marks/yang", 1);
                     who->set_skill("xiaohun_strike", 1);
	              who->set("title","古墓派嫡传弟子");
			return 1;
		}
	} else
		say("美貌女子平平淡淡说道：多谢你了。\n");
	return 1;
}

