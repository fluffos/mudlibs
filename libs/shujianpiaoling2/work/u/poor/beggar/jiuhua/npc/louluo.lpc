// banker.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("喽罗", ({ "louluo" }) );
        set("title", "飞鹰寨");
        set("gender", "男性" );
        set("age", 31);
        set("long",
"他是飞赢寨中的喽罗，干尽了各种伤天害理的坏事。\n");
 
        set("combat_exp", 50000);
        set("attitude", "aggressive");

        set("max_force", 800);         set("force", 1000);             
	 set("force_factor", 10);

        set_skill("unarmed", 60);
        set_skill("parry", 50);
        set_skill("dodge", 50);
        set_skill("force", 50);
        
        setup();
        
        carry_object(__DIR__"obj/cloth")->wear();
}

int accept_fight(object me)
{
        command("say 咦... 要打就真打吧，光是较量多没意思？");
        kill_ob(me);
        return 1;
}
 
