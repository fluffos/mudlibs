inherit NPC;

void create()
{
        set_name("小喽罗", ({ "louluo","xiao" }) );
        set("gender", "男性" );
        set("age", 21);
        set("title", "飞鹰寨");
        set("long",
"他是负责守门的喽罗，进出飞鹰寨都得经过他的同意。\n");
        set("combat_exp", 40000);
        set("force",500);
        set("max_force", 500);
        set_skill("force",50);
        set_skill("dodge", 50);
        set_skill("unarmed", 50);
        set("chat_chance", 10);
        set("chat_msg", ({
"小喽罗说道：老大好象在让兄弟们找什么宝图？\n",
        }) );

       set("inquiry", ([
         "宝图" : "我也不清楚，好象和什么宝藏有关。\n",
         "map" : "我也不清楚，好象和什么宝藏有关。\n",
         "进门" : "想进门也不写个拜山帖？\n",
         ]));
     
       setup();
       carry_object(__DIR__"obj/cloth")->wear();
}

int accept_object(object me, object ob)
{
         object clasp;
         me=this_player();
         if( (string)ob->query("id") !="mentie"  ) 
         {
         command("say 你找死吗？\n");
         }
         else{
         say("这位" + RANK_D->query_respect(me) + "，既然如此你就随我来吧。\n");
	  me->move("/u/poor/beggar/jiuhua/fymid");
	  tell_object(me,"小喽罗推开大门，带着你走了进去。\n");
         }
        return 1;       
}