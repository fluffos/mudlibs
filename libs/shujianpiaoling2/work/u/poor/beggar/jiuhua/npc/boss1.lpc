#include <ansi.h>
inherit NPC;
void create() {
  set_name("马超", ({ "machao" }));
  set("nickname", HIB "无影神爪" NOR);
  set("title", "飞鹰寨二寨主");
  set("gender", "男性");
  set("age", 45);
  set("str", 30);
  set("cor", 10);
  set("cps", 15);
  set("per", 10);
  set("int", 20);
  set("long", "他是这里的二寨主，在江湖上也小有名气。\n");
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 2000);
  set("max_force", 1500);
  set("force_factor", 20);
  set("combat_exp", 100000);
  set("attitude", "aggressive");

  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("dodge", 180);
  set_skill("literate", 50);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("checklooking");
    call_out("checklooking", 1, ob);
  }
}

void checklooking(object ob) {
  command("say 你受死吧！");
}

int accept_fight(object me) {
  command("say 咦... 要打就真打吧，光是较量多没意思？");
  kill_ob(me);
  return 1;
}
