// xuanbei.c 玄悲

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("无边", ({"wu bian master","wu bian","master",}));
	set("long",
		"这是一位年过古稀的老僧人，不知道为何住在这里。\n"
	);

	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin");

	set("inquiry",([
		"空见" : "空见是现任少林主持。\n",
		"玄悲" : "他是老衲的弟子。\n",
		"玄难" : "他是老衲的弟子。\n",
		"老僧" : "是藏经阁的那个吗？他可是个高人呀！\n",
	]));

	set("age", 125);

	set("max_gin", 2500);
	set("max_kee", 5000);
	set("kee",5000);
	set("max_sen", 2500);
	set("force", 10000);
	set("max_force", 8000);
	set("force_factor", 200 );
	set("combat_exp", 8000000);

	set_skill("force", 300);
	set_skill("jingang_force", 280);
	set_skill("wenshu_staff", 280);
	set_skill("dodge", 300);
	set_skill("shaolin-dodge", 280);
	set_skill("staff", 300);
	set_skill("bright_ken", 300);
	set_skill("parry", 300);
	set_skill("unarmed", 300);
	set_skill("jingang-strike", 250);
	set_skill("hammer", 300);

	set_skill("essencemagic", 300);
	set_skill("buddhism", 300);
	set_skill("magic", 200);
        set_skill("literate", 300);
	set_skill("zaahan_gong", 300);

	map_skill("staff", "wenshu_staff");
	map_skill("parry", "wenshu_staff");
	map_skill("force", "jingang_force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("unarmed", "jingang-strike");

	set("title","少林寺高僧");
	create_family("少林寺", 1, "弟子");
	set("family/privs",1);

	setup();
	carry_object("/u/poor/obj/cloth/sengpao")->wear();
}

void init()
{
	set("eff_kee", 2000);
	set("kee",2000);
	add_action("do_apprentice","apprentice");
}
void attempt_apprentice(object ob)
{	string name, new_name;
	mapping family = ob->query("family");
	string *prename =
	({"无","玄","空","明","静","智","虚","慧","觉","清"});

	if (!ob->query("marks/baiwu")||(ob->query("family/master_name")!="玄悲" )) {
	command("say 我是不轻易收徒弟的！\n");
	}
	else {
	command ("say 阿弥陀佛！老衲就收下你这个徒弟吧。");
	command("say 阿弥陀佛，善哉！善哉！没想到老衲行将就木，还能得此佳徒！");
       command("recruit " + ob->query("id") );
	name = ob->query("name");
	new_name=prename[(int)family["generation"]-2]+name[2..3];
	command("say 从今天起你就改名为"+new_name+"了。");
	ob->set("name",new_name);
	ob->set("title","少林寺高僧");
	ob->set("class","shaolin");
	ob->set("shaolin/tuijian",0);
	ob->set("shaolin/renwu",0);
	ob->delete("shaolin/shou");
	ob->delete("shaolin/baiwu");
	}
}



int do_apprentice(string arg)
{
	int exp,nn,ii,rr;
	string old_t;
	object ob,me=this_player();

	if( !(me->is_apprentice_of(this_object()))) return 0;
	message_vision("$N跪了下来向$n恭恭敬敬地磕了个头，叫道：「师父好！」\n",me,this_object());
	command("smile");
	me->set("shaolin/renwu",0);
	return 1;
}


int accept_object(object me, object ob)
{
	if((ob->query("id")=="tj-xin")) {
		command("say 还不快拜师？！\n");
		return 1;
	}
	return 0;
}

