// fisher

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("静误", ({"jing wu","wu"}));
	set("title","甘露寺藏经阁学士");
	set_skill("unarmed", 120);
	set_skill("parry", 120);
	set_skill("dodge", 120);
	set("gender","男性");

	set("force",2000);
	set("max_force",1500);
	set("per",15);
	set("food",200);
	set("water",200);
	set("combat_exp",100000);

	set("age", 49);
	set("long", @LONG
他是掌管经书的僧人，你可以向他买经书。
LONG
);
        set("chat_chance", 5);
        set("chat_msg", ({
        "静误说道：你是想买经书吗？？\n"
        }) );

	set("vendor_goods", ([
		__DIR__"obj/jingang-jing"	      : 5,
		__DIR__"obj/fahua-jing"	      : 5,
		__DIR__"obj/chanshuo"	      : 5,
		__DIR__"obj/fumo-jing"       : 5,
	]));

	setup();

	carry_object(__DIR__"obj/cloth")->wear();       
}

void init()
{
	add_action("do_vendor_list", "list");
}
