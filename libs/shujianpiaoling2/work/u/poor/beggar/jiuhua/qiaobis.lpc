// /u/poor/gaibang/hj
inherit ROOM;

int rou_num = 1;

void create()
{
        set("short", "平台");
        set("long", @LONG
这里是峭壁上的一块突出的巨石，能够勉强站一个人，在
巨石边有几株紫色的小草，下边是几十米高的山涧。
    这里没有明显的出口。
LONG
        );
       set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/bird" : 2,
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

        setup();
}
void init()
{
        add_action("do_climb", "climb");
        add_action("do_pick", "pick");
}
int do_climb(string arg)
{
	object me,ob;
	me = this_player();

	if( arg=="xia" || arg=="down") {
	if (!objectp(ob = present("masheng", me))) {
		     write("你慢慢的向悬崖下爬去，一不小心摔了下来。\n");
                  this_player()->unconcious();
	       return 1;
		}
       	message_vision("$N的双手牢牢的抓住了麻绳向下爬去。\n",me);
	       me->move(__DIR__"qiaobi1");
       	return 1;
	}
	else return 0;
}

int do_pick(string arg)
{
	object obj;
	if( arg=="xiaocao" || arg=="紫色小草" ) {
	     if(rou_num!=0) {
		    obj = new(__DIR__"obj/xiaocao");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N摘下一株紫色小草。\n", this_player());
		 	rou_num--;
		 }
		 else write("你的手够不到紫色小草。\n");
		 return 1;
	}
	else return 0;
}

