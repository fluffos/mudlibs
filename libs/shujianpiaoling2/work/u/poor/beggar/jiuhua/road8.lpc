inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
你走在九华山西边的山路上，两旁是山中的苍松翠竹，能隐
隐看见南边香烟缭绕。北边是一条黄土路。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "road9",
    "south": __DIR__ "road7",
  ]));
  set("objects", ([ /* sizeof() == 2 */
    // __DIR__"npc/qiangdao" : 2,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "gaibang");

  setup();
}

void init() {
  add_action("do_go", "go");
}

int do_go() {
  if (random(3)) {
    this_player()->move(this_object());
    return 1;
  }
}
