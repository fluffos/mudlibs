// /u/poor/gaibang/hj
inherit ROOM;

void create()
{
        set("short", "铁索桥");
        set("long", @LONG
你走到了铁索桥上，由于铁索桥年久失修，已经有很多
木板腐烂，能从桥上直接看到脚下的山涧。从这里从能真正
看清九华山的雄壮、秀奇，李白曾诗赞：“天河挂绿水，绣
出九芙蓉。”
LONG
        );
        set("exits", ([/* sizeof() == 2 */
           "west" : __DIR__"road3",
           "east" : __DIR__"road4",
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

        setup();
}
void init()
{
        add_action("do_go","go");
}

int do_go()
{
if(random(2)){
this_player()->move(this_object());
return 1;
}
}
