// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIB"偏院"NOR);
	set("long", @LONG
你走到了丐帮的大仁分舵院子中，这里是丐帮弟子练功的
地方，有许多乞丐在这里舞枪弄棒，练的汗流浃背。东边是仁
舵的丹房。
LONG
	);

	set("exits", ([ /* sizeof() == 2 */
    "north" : __DIR__"renyzi1",
    "east" : __DIR__"renpill",
    "southwest" : __DIR__"renbook",
    "northwest" : __DIR__"renyzi3",
]));
       set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/beggar3" : 2,
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

	setup();
}
int valid_leave(object who,string exit)
{
  object ob;
  ob = present("beggar",environment(who));

  if( ob ) if( ob->query_temp("block_msg/all"))
      return ::valid_leave(who,exit);
  
  if( (exit == "southwest") && (who->query("class")!="gaibang") && (present("beggar",environment(who))))
      return notify_fail("小乞丐说道：“前面是丐帮大仁分舵书房，请您速速离去！”\n");
  return ::valid_leave(who,exit);
}
