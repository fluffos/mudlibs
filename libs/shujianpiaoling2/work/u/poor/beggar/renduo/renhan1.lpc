// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIB"破屋后"NOR);
	set("long", @LONG
你来到了破屋子的后边，这里三面都是树林，只有南边是
那间破屋子，屋子的窗户还开着。
LONG
	);

	set("exits", ([ /* sizeof() == 2 */
    "north" : __DIR__"renhan2",
    "east" : __DIR__"renhan2",
    "west" : __DIR__"renhan2",
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

	setup();
}

void init()
{
	add_action("do_jump", "jump" );
	add_action("do_jump", "tiao" );
}

int do_jump(string arg)
{
	if( arg=="window" || arg=="窗户") {
		message_vision("$N深吸一口气，从窗子中跳了出去。\n", this_player());
		this_player()->move(__DIR__"renhan");
		message("vision", this_player()->name() + "跳出了窗子。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}

