// stick

#include <weapon.h>

inherit STICK;

void create() {
  set_name("铁锹", ({ "tieqiao" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把普通的铁锹");
    set("value", 500);
    set("material", "iron");
  }
  init_stick(20);

  set("wield_msg", "$N把$n紧紧地握在手中。\n");
  set("unwield_msg", "$N松开了手中的$n。\n");

  setup();
}
