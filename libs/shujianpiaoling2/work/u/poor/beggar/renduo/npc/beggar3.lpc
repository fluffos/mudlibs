// beggar.c

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("小乞丐", ({ "beggar" }) );
        set("title", "丐帮二袋弟子");
        set("gender", "男性");
        set("age", 15);
        set("long",
 "他是仁舵的弟子。\n");
        set("inquiry", ([
                "拜师": "问那么多干吗，快拜师吧！",
                "进门": "只有本帮弟子才能进入智舵。",
        ]) ); 
        set("max_kee", 100);
        set("kee", 100);
        set("force", 100);
        set("max_force", 100);
        set("force_factor",10);
        set("combat_exp",1000);

        set_skill("unarmed", 10);
        set_skill("force", 10);
        set_skill("parry", 10);
        set_skill("dodge", 10);
        set_skill("begging", 10);

        set_skill("iron_strike", 10);
        set_skill("hidden_dodge", 10);
        set_skill("canyun_force", 10);
        set_skill("literate", 20);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");

        create_family("丐帮", 9, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
