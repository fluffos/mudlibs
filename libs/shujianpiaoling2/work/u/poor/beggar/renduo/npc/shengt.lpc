// songqing.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("沈公拓", ({ "shen gongtuo", "master", "shen" }));
  set("title", "丐帮四袋弟子");
  set("gender", "男性");
  set("age", 35);
  set("long",
    "他是仁舵的弟子，带人很温和。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
  ]));
  set("max_kee", 1000);
  set("kee", 1000);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 30);
  set("combat_exp", 80000);

  set_skill("unarmed", 30);
  set_skill("force", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set_skill("whip", 60);
  set_skill("begging", 60);

  set_skill("fire_whip", 60);
  set_skill("iron_strike", 60);
  set_skill("hidden_dodge", 60);
  set_skill("canyun_force", 60);
  set_skill("literate", 60);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("parry", "fire_whip");
  map_skill("whip", "fire_whip");

  create_family("丐帮", 7, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/jingyi")->wear();
  carry_object("/u/poor/obj/weapon/whip")->wield();
}

void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg < 40) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮仁舵弟子");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去智舵修习武功吧。\n");
  }
}
