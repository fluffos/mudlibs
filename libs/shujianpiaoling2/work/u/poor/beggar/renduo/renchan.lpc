// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "破屋" NOR);
  set("long", @LONG
这是间十分残破的屋子，在屋子右边的墙角放着一把铁锹。
在屋子的左边有一个木柜子。旁边是张三个腿的桌子。
LONG
  );
  set("item_desc", ([
    "木柜子": "虽然屋子四周都有一层土，但是柜子上没有尘土。\n",
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "renyzi3",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "obj/tieqiao": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_move", "move");
}

int do_move(string arg) {
  if (arg == "木柜子" || arg == "柜子") {
    if (this_player()->query_skill("parry", 1) <= 20) {
      write("你没有那么大力气，搬不开柜子。\n");
      return 1;
    }
    message_vision("$N把柜子搬开，发现后边有个洞，就钻了进去。\n", this_player());
    this_player()->move("/u/poor/beggar/didao/ddren");
    message("vision", this_player()->name() + "搬开了柜子，钻进了柜子后边的洞。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
