// Room: /beggar/door.c
inherit ROOM;
#include <ansi.h>;
int rou_num = 1;

void create()
{
	set("short", HIB"小木屋"NOR);
	set("long", @LONG
你走进了间小木屋中，在屋子的右边是个木床。中间摆放着
一张桌子，桌子旁边摆放着几把椅子。这里就是丐帮的刘长老住
的地方。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "桌子" : "在桌子上放着一封拜山帖。
",
  "木床" : "这是个普通的木床，但在床板上有个拉环。
",
]));

	set("exits", ([ /* sizeof() == 3 */
    "east" : __DIR__"xshulin1",
]));
        set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_pull", "pull" );
	add_action("do_search", "search" );
}

int do_pull(string arg)
{
	if( arg=="拉环" || arg=="床板") {
	    if(this_player()->query_skill("unarmed", 1)<=20) {
		     write("你没有那么大力气，拉不动。\n");
			 return 1;
		}
		message_vision("$N用力拉开床板，发现下边有个地道，就钻了进去。\n", this_player());
		this_player()->move("/u/poor/beggar/didao/ddxiao");
		message("vision", this_player()->name() + "拉开床板，钻进了床下的地道。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}

int do_search(string arg)
{
	object obj,me;
       me = this_player();
	if( arg=="桌子" || arg=="tablo" ) {
	     if(rou_num!=0) {
		    obj = new(__DIR__"obj/mentie");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N从桌子上找到一封拜山帖。\n", this_player());
		 	rou_num--;
		 }
		 else write("桌子上什么都没有。\n");
		 return 1;
	}
	else return 0;
}
