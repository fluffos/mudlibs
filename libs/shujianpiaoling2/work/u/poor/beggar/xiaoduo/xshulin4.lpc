// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create()
{
	set("short", HIB"树林中"NOR);
	set("long", @LONG
你来到了树林之中，四周都是茂密的树林，只有星星点点的
阳光穿过枝叶照在地上。不时能听见鸟叫的声音。在左边有一棵
十分粗大的树。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "大树" : "在树上好象有个人影。
",
]));
	set("exits", ([ /* sizeof() == 3 */
    "southwest" : __DIR__"xshulin3",
]));
       set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/bird" : 2,
]));
	set("outdoors","gaibang");
        set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_climb", "climb" );
}

int do_climb(string arg)
{
	if( arg=="大树" || arg=="树") {
	    if(this_player()->query_skill("dodge", 1)<=20) {
		     write("你慢慢向树上爬去，突然手一滑，从半空掉了下来。\n");
                  this_player()->unconcious();
			 return 1;
		}
		message_vision("$N慢慢向树上爬去，不一会儿，爬上了大树。\n", this_player());
		this_player()->move(__DIR__"xzou");
		message("vision", this_player()->name() + "爬上了大树。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}
