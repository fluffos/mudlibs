// zhao.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("赵仲义", ({ "zhao zhongyi", "master", "zhao" }));
  set("title", "丐帮四袋弟子");
  set("gender", "男性");
  set("age", 55);
  set("long",
    "他是孝舵的弟子，也是丐帮弟子的入门师父。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
  ]));
  set("max_kee", 800);
  set("kee", 800);
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 10);
  set("combat_exp", 8000);

  set_skill("unarmed", 30);
  set_skill("force", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set_skill("blade", 50);
  set_skill("begging", 50);

  set_skill("golden_blade", 50);
  set_skill("iron_strike", 30);
  set_skill("hidden_dodge", 50);
  set_skill("canyun_force", 50);
  set_skill("literate", 50);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("parry", "golden_blade");
  map_skill("blade", "golden_blade");

  create_family("丐帮", 7, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/jingyi")->wear();
  carry_object("/u/poor/obj/weapon/blade")->wield();
}

void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg < 40) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮孝舵弟子");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去礼舵修习武功吧。\n");
  }
}
