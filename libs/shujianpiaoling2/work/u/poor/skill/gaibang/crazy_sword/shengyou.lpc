#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  int i;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「无中生有」？\n");

  if (!me->is_fighting())
    return notify_fail("「无中生有」只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");

  i = (int)me->query_skill("crazy_sword", 1) + (int)me->query_kar();

  if (i < 150)
    return notify_fail("你的狂乱颠疯剑法级别还不够，不能使用！\n");

  message_vision(HIC "\n$N身形往前滑出，手中的剑霹啪有声，使出了「无中生有」的绝技！\n" NOR, me);

  if ((target->query_skill_mapped("sword") == "dg9-sword") &&
    ((int)target->query_skill("dg9-sword", 1) > (int)me->query_skill("crazy_sword"))) {
    message_vision(CYN "\n但是$n剑法一展，$N的攻势莫名其妙地扑了个空！\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }
  target->delete("env/brief_message");

  me->set_temp("crazy_perform", 7);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  me->delete_temp("crazy_perform");

  me->receive_damage("sen", 100 + random(100));
  me->add("force", -200);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->start_busy(2);
  return 1;
}
