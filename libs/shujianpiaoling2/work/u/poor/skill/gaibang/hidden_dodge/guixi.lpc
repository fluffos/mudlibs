//龟息
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon, room;
	extra = me->query_skill("hidden_dodge",1);
	if ( extra < 70) return notify_fail("你的［龟藏豹隐身法］还不够纯熟！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［龟息］只能对战斗中的对手使用。\n");
	if(target->is_busy())
		return notify_fail(target->name()+"已经不知所措了！\n");
	message_vision(CYN"$N突然身形缩成一团，咕碌碌滚在一边，$n顿时失去了攻击目标！\n"NOR,me,target);

	if(random((int)target->query("combat_exp")) < (int)me->query("combat_exp"))
	{
	room = environment(me);
	me->move("/daemon/class/gaibang/space.lpc");
	me->move(room);
	target->start_busy(3);
	}
	else{
	msg = "但是$N还是如影随形般跟上了$n，向$n迅然攻击！";
	COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);	
	}
	return 1;
}
