// anran
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
        int damage;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("「黯然式」只能对战斗中的对手使用。\n");

        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你必须空手才能使用「黯然式」！\n");         
                
        if( (int)me->query_skill("xiaohun_strike", 1) < 40 )
                return notify_fail("你的黯然销魂掌法不够娴熟，不会使用「黯然式」。\n");
                                
        if( (int)me->query("force", 1) < 500 )
                return notify_fail("你现在内力太弱，不能使用「黯然式」。\n");
                        
        msg = MAG "$N脸上喜怒哀乐，怪状百出，使出绝技「黯然式」攻向$n。\n"NOR;

        if (random(me->query_skill("force")) > target->query_skill("force")/2 )
        {
                me->start_busy(2);
                target->start_busy(1+ random(3));
                
                damage = (int)me->query_skill("xiaohun_strike", 1);
                
                damage = damage/2 + random(damage);
                
                target->receive_damage("kee", damage);
                target->receive_damage("sen", damage/5);
                target->receive_wound("kee", damage/10);
                me->add("force", -damage/10);
                
                if( damage < 20 ) msg += HIY"结果$n受到$N的干扰，身体摇晃了几下。。\n"NOR;
                else if( damage < 40 ) msg += HIY"结果$n受到$N的干扰，登时心神难以自制。\n"NOR;
                else if( damage < 80 ) msg += RED"结果$n被$N的表情所制，全身已经麻木。\n"NOR;
                else msg += HIR"结果$N被$n的表情所制，心神中自然听命于$n，很难自制！\n"NOR;
                
        } else 
        {
                me->start_busy(1);
                msg += MAG"可是$n没受到任何干扰。\n"NOR;
        }
        message_vision(msg, me, target);

        return 1;
}
