//打狗棒法

inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N使一招「拨草寻狗」，手中$w扫向$n下盘！",
                "damage":               30,
                "dodge":                -60,
                "parry":                -40,
                "damage_type":  "挫伤"
        ]),
        ([      "action":               
"$N挥起$w，一招「恶狗在前」攻向$n$l！",
                "damage":               50,
                "dodge":                -50,
                "parry":                -80,
                "damage_type":  "挫伤"
        ]),
        ([      "action":               
"$N横过手中$w，使出「痛击饿狗」击向$n$l！",
                "damage":               30,
                "dodge":                -50,
                "parry":                -40,
                "damage_type":  "挫伤"
        ]),
        ([      "action":               
"$N举起手中$w，挥出一股棒气，使出「打狗打瘠」压向$n$l！",
                "damage":               40,
                "dodge":                -40,
                "parry":                -40,
                "damage_type":  "挫伤"
        ]),
        ([      "action":               
"$N将手中$w一挥，泛出满天丈影，一招「丈影蔽天」向$n$l罩去！",
                "damage":               80,
                "dodge":                -70,
                "parry":                -40,
                "damage_type":  "挫伤"
        ]),
        ([      "action":               
"$N将手中$w抡圆，使出「天狗食月」横扫$n$l头部！",
                "damage":               90,
                "dodge":                -60,
                "parry":                -40,
                "damage_type":  "挫伤"
        ]),
        ([      "action":               
"只见$N将$w一振，丈头顿时泛成一朵梅花，挟着一股劲风，一招「疯狗难驯」直指$n$l咽喉！",
                "damage":               70,
                "dodge":                -70,
                "parry":                -40,
                "damage_type":  "挫伤"
        ]),
        ([      "action":               
"$N反手握住$w，棒未发，力已至，使出「串烧狗肉」，棒未到，一股热浪已径直扑向$n$l！",
                "damage":               100,
                "dodge":                -60,
                "parry":                -40,
                "damage_type":  "挫伤"
        ]),
        ([      "action":               
"眨眼间$N手中的$w已变换了十三个攻击点，一招「群狗乱吠」攻向$n$l！",
                "damage":               90,
                "dodge":                -80,
                "parry":                -40,
                "damage_type":  "挫伤"
        ]),

        ([      "action":               
"$N使出一招「棒挺狗头」，$w一挺撞向$n$l！",
                "damage":               60,
                "dodge":                -50,
                "parry":                -40,
                "damage_type":  "挫伤"
        ]),
});

int valid_learn(object me)
{
        if( (int)me->query("str") + (int)me->query("max_force") / 10 < 40 )
                return 
notify_fail("你的膂力还不够，也许该练一练内力来增强力量。\n");

        return 1;
}

int valid_enable(string usage)
{
        return (usage=="stick") || (usage=="parry");
}
int effective_level() { return 23;}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        object weapon;

        if( !objectp(weapon = me->query_temp("weapon"))
        ||      (string)weapon->query("skill_type") != "stick" )
                return 
notify_fail("你必须先找一根竹丈或者是类似的武器，才能练打狗棒法。\n");

        if( (int)me->query("kee") < 20 )
                return 
notify_fail("你的体力不够练这门棒法，还是先休息休息吧。\n");
        me->receive_damage("kee", 20);
        return 1;
}
string *parry_msg = ({
        "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
        "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
        "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
        "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
        "$n不退反进，$v直刺$N的双手。\n",
        "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int learn_bonus()
{
	return -10;
}
int practice_bonus()
{
	return -10;
}
int black_white_ness()
{
	return 10;
}

string perform_action_file(string action)
{
        return CLASS_D("gaibang") + "/hitdog_stick/" + action;
}

 
