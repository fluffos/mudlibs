// houndbane.c

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("烂铁剑", ({ "poor-sword" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把无坚不摧的宝剑。\n");
		set("value", 2000);
		set("material", "blacksteel");
		set("wield_msg", "只见白光一闪，$N手中出现了一把$n。\n");
		set("unequip_msg", "只见白光一闪，$N手中的$n已经插在了背后。\n");
	}

	init_sword(80);
	setup();
}
