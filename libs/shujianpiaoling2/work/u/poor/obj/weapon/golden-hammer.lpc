// hammer.c

#include <weapon.h>
#include <ansi.h>;

inherit HAMMER;

void create()
{
        set_name(HIY"金槌"NOR, ({ "golden-hammer" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是一把金槌。\n");
                set("value", 2);
                set("material", "gold");
                set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(5);
        setup();
}
