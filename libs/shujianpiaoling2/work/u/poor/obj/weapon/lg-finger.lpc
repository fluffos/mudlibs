#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create() {
  set_name(RED "灵古指环" NOR, ({ "lg-zhihuan", "finger" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一只上古流传下来的指环。\n");
    set("unit", "只");
    set("value", 0);
    set("material", "iron");
    set("armor_prop/damage", 20);
    set("armor_prop/personality", 20);
    set("female_only", 0);
  }
  setup();
}
