// blade.c

#include <weapon.h>

inherit BLADE;

void create()
{
	set_name("菜刀", ({ "caidao" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 500);
		set("material", "iron");
		set("long", "这是一寻常的菜刀，份量大约六、七斤重。\n");
		set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插入腰间。\n");
	}
	init_blade(10);
	setup();
}
