// qiufu

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("囚服", ({ "qiufu" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "cloth");
		set("long", "这是一件犯人穿的衣服。\n");
		set("unit", "件");
		set("value", 40);
		set("armor_prop/armor", 2);
	}
	setup();
}
