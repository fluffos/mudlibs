// magic book

inherit ITEM;

void create() {
  set_name("木片", ({ "wood" }));
  set_weight(600);
  set("unit", "片");
  set("long", "这是一片写满字迹的木片。\n");
  set("value", 300);
  set("skill", ([
    "name": "stick",          // name of the skill
    "exp_required": 200,           // minimum combat experience required                                                                           
    // to learn this skill.
    "sen_cost": 40,                  // gin cost every time study this
    "difficulty": 15,                // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 25   // the maximum level you can learn from this object.
  ]));
}
