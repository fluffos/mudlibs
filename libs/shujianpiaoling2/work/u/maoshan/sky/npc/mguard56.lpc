//法术：［嫦娥奔月］ 属性：busy9  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("月仙", ({ "moon god", "taoist guard" }));
  set("gender", "女性");
  set("age", 20);
  set("attitude", "peaceful");
  set("long", "天界之月神，掌管月宫仙女，俗称嫦娥。\n");

  set("mguard", "mguard56");
  set("mguard_level", 56);
  set("magic_power", 3000);
  set("last_load_time", uptime());

  set("str", 72);
  set("cor", 52);
  set("cps", 22);
  set("per", 92);

  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("max_mana", 2500);
  set("mana", 2500);

  set("combat_exp", 10000000);

  set_skill("whip", 300);
  set_skill("snowwhip", 200);
  set_skill("yueying-wubu", 300);
  set_skill("dodge", 300);
  map_skill("dodge", "yueying-wubu");
  map_skill("whip", "snowwhip");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/whip", 300);
  set_temp("apply/damage", 60);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

  carry_object("/obj/cloth/belt")->wear();
  carry_object("/obj/cloth/color_cloth")->wear();
  carry_object("/obj/cloth/silver-finger")->wear();
  carry_object("/obj/cloth/flower-shoes")->wear();
  carry_object("/obj/cloth/silver-neck")->wear();
  carry_object("/obj/weapon/rainbowbelt")->wield();
}

int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (random(enemy[i]->query("magic_defense")) < random(1000) && !enemy[i]->is_busy()) {
        message_vision(HIM "\n$N双袖挥舞，顿时一片月色照住了$n。" NOR, who, enemy[i]);
        message_vision(HIM "\n$N身姿曼妙，围着那片月光奔走旋转，渐渐与月光融为一体。" NOR, who, enemy[i]);
        message_vision(HIM "\n$n只觉得神志模糊，意志消沉，渐渐失去了战斗的能力。\n" NOR, who, enemy[i]);
        message_vision(HIG "［嫦娥奔月］！\n\n" NOR, who);
        enemy[i]->start_busy(9);
        enemy[i]->receive_wound("sen", 100);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        if (!who->query_soft_powerup())
          who->soft_powerup(30, 30);
        COMBAT_D->report_status(enemy[i], 1);
      }
      enemy[i]->set_delay(5);
      if (enemy[i]->query("force") > 100) enemy[i]->add("force", -100);
    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
void die() {
  object who;
  seteuid(getuid());
  who = this_object();
  if (who->query_temp("already_die") < 3) {
    message_vision(HIY "\n$N一声召唤，只见天上云烟缭绕，从中跃出一只玉兔。" NOR, who);
    message_vision(HIY "\n那玉兔跳上$N肩头，伸出舌头舔着$N的伤口。转眼$N的伤口愈合了！" NOR, who);
    message_vision(HIY "\n$N拍了拍玉兔的背，那玉兔乘着月光升起，向东方隐去。\n" NOR, who);
    message_vision(HIG "［玉兔东升］！\n\n" NOR, who);
    who->receive_curing("kee", 1000);
    who->receive_heal("kee", 1000);
    who->receive_curing("sen", 1000);
    who->receive_heal("sen", 1000);
    who->receive_curing("gin", 1000);
    who->receive_heal("gin", 1000);
    who->add_temp("already_die", 1);
    who->remove_busy();
    if (!who->query_soft_powerup())
      who->soft_powerup(30, 30);
  } else
    ::die();
}
