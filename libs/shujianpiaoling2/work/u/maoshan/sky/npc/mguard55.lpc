// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［万蛊蚀天］ 属性：condition  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("蛊魔", ({ "gumo", "taoist guard" }));
  set("gender", "男性");
  set("age", 70);
  set("attitude", "peaceful");

  set("mguard", "mguard55");
  set("mguard_level", 55);
  set("magic_power", 3000);
  set("last_load_time", uptime());

  set("str", 72);
  set("cor", 52);
  set("cps", 22);
  set("max_mana", 2500);
  set("mana", 2500);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("combat_exp", 10000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      message_vision(HIY "\n$N突然化做无数五彩蛊烟，迅速钻入$n身体内各处！" NOR, who, enemy[i]);
      message_vision(GRN "\n$n闻到一股恶腥气，刹那间感到肠胃痉挛，皮肤上竟然渗出了一粒粒可怕的绿色汗液！\n" NOR, who, enemy[i]);
      message_vision(RED "\n$n刹那间感到难受之极，头昏脑涨，皮肤上竟然渗出了一粒粒可怕的红色汗液！\n" NOR, who, enemy[i]);
      message_vision(WHT "\n$n闻到恶腥气扑鼻，刹那间感到难受之极，皮肤上竟然渗出了一粒粒可怕的白色汗液！\n" NOR, who, enemy[i]);
      message_vision(HIG "［万蛊蚀天］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(1000))
        enemy[i]->receive_wound("kee", 10);
      if (!enemy[i]->query_condition("green_blood"))
        enemy[i]->apply_condition("green_blood", 20);
      if (!enemy[i]->query_condition("no_shadow"))
        enemy[i]->apply_condition("no_shadow", 20);
      if (!enemy[i]->query_condition("red_blood"))
        enemy[i]->apply_condition("red_blood", 20);

      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  who->die();
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
