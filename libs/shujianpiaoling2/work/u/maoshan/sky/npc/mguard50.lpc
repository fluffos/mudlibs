// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［八方归元术］ 属性：heal  对象：me  克星：无
//法术：［鬼神伏魔功］ 属性：attack  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("形天", ({ "xingtian", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard50");
  set("mguard_level", 50);
  set("magic_power", 250);

  set("str", 32);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("last_load_time", uptime());
  set("max_mana", 2500);
  set("mana", 2500);

  set("combat_exp", 500000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIC "\n$N双手一挥，登时四面八方升起无数鬼怪，同时将自身的元神输入$N体内，" NOR, who, enemy[i]);
        message_vision(HIC "\n$N的伤势立即恢复了。\n" NOR, who, enemy[i]);
        message_vision(HIG "［八方归元术］！\n\n" NOR, who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(who, 1);
        return 1;
      }
      message_vision(HIR "\n$N双手一挥，登时有无数鬼神恶魔从地底冒了出来，将$n团团围住，" NOR, who, enemy[i]);
      message_vision(HIR "\n$n喃喃念动咒语，那些鬼神立时一齐朝$n扑了上去！！\n" NOR, who, enemy[i]);
      message_vision(HIG "［鬼神伏魔功］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(900))
        enemy[i]->receive_wound("kee", mwp, who);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
