#include <room.h>
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "西天门");
  set ("long", @LONG

    西门靠近天宫的平乐殿，是玉帝大宴群臣的地方。墙里传来阵阵
仙乐，大概是仙女们在跳舞吧。你听着美妙的音乐，不由得陶醉了。
唉，天上一日，人间一年。你到现在才知道为什么在天宫里时间过得
那么快。

LONG);

  set("hell", 2);
  set("exits", ([ /* sizeof() == 3 */
  "north" : __DIR__"wn1",
  "south" : __DIR__"ws1",
]));
  setup();
}

