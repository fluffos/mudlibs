
//key.c 丹房钥匙

#include <ansi.h>
inherit ITEM;

void create()
{
        set_name( YEL"阴界传送符"NOR ,({"sheet"}) );
        if (clonep())
                set_default_object(__FILE__);
        else {
	        set_weight(300);
	        set("long", "这是一张阴界传送符。\n");
                set("unit", "张");
                set("value",1);
        }
        setup();
}
