
//dan.c 丹药

#include <ansi.h>
inherit ITEM;

string *name_array = ({
        WHT"丹药"NOR,
        HIY"乌金丹"NOR,
        HIG"润木丹"NOR,
        HIB"凝水丹"NOR,
        HIR"烈火丹"NOR,
        YEL"生土丹"NOR,
        HIC"大风丹"NOR,
        HIG"清心丹"NOR,
        HIW"神力丹"NOR,
        CYN"飞云丹"NOR,
        HIM"生生再造丹"NOR,
        HIR"霹雳惊雷丹"NOR,
        HIC"六道轮回丹"NOR,
        HIY"天王补心丹"NOR,
        HIB"九转阴阳丹"NOR,
        HIW"天道太极丹"NOR
});

string *id_array = ({
        "danyao",
        "jin dan",
        "mu dan",
        "shui dan",
        "huo dan",
        "tu dan",
        "feng dan",
        "qing dan",
        "li dan",
        "yun dan",
        "shengsheng dan",
        "pili dan",
        "liudao dan",
        "tianwang dan",
        "jiuzhuan dan",
        "tiandao dan"
});

void set_dan_kind(int kind)
{
	set_name(name_array[kind],({ id_array[kind], "dan" }) );
	set("kind",kind);
}

void create()
{
        if (clonep())
                set_default_object(__FILE__);
        else {
	        set_weight(100);
	        set("long", "这是一颗丹药，似乎可以用来炼丹或者服用(eat)。\n");
                set("unit", "颗");
                set("value",100);
        }
        set_dan_kind(random(5)+1);
        setup();
}

void init()
{
        add_action("do_eat", "eat");
}

int do_eat(string arg)
{
        object me,ob;
        me = this_player();
        ob = this_object();

        if( !ob->id(arg) ) return 0;
        if( me->is_busy() )
                return notify_fail("你上一个动作还没有完成。\n");
	if( me->query("class")!="taoist" )
                return notify_fail("你不是道士，吃了丹药也不能运功消化，还是不要吃了吧！\n");
        message_vision("$N一口吞下了个$n，接着盘膝坐下将真气在全身游走一周，运功消化了$n！\n",me,ob);
	switch(ob->query("kind")){
        case 6:
                me->add("potential", 10);
                me->add("combat_exp",20);
                tell_object(me,"你似乎感到功力略有提高！\n");
                break;
        case 7:
                me->receive_curing("gin", 10);
                me->receive_curing("kee", 10);
                me->receive_curing("sen", 10);
                tell_object(me,"你似乎感到身上的伤势恢复了少许！\n");
                break;
        case 8:
                me->add("potential", 30);
                me->add("combat_exp",60);
                tell_object(me,"你似乎感到功力有所提高！\n");
                break;
        case 9:
                me->receive_curing("gin", 30);
                me->receive_curing("kee", 30);
                me->receive_curing("sen", 30);
                tell_object(me,"你似乎感到身上的伤势好了一些！\n");
                break;
        case 10:
                me->add("potential", 100);
                me->add("combat_exp",200);
                tell_object(me,"你似乎感到功力有些长进！\n");
                break;
        case 11:
                me->add("max_mana", 2);
                me->add("max_force",2);
                me->add("max_atman", 2);
                tell_object(me,"你似乎感到内力、法力、灵力都有些长进！\n");
                break;
        case 12:
                me->add("potential", 250);
                me->add("combat_exp",500);
                tell_object(me,"你似乎感到功力长进不少！\n");
                break;
        case 13:
                me->receive_curing("gin", 100);
                me->receive_curing("kee", 100);
                me->receive_curing("sen", 100);
                tell_object(me,"你似乎感到身上的伤势迅速恢复了！\n");
                break;
        case 14:
                me->add("potential", 500);
                me->add("combat_exp",1000);
                tell_object(me,"你似乎感到功力长进许多！\n");
                break;
        case 15:
                me->receive_curing("gin", 300);
                me->receive_curing("kee", 300);
                me->receive_curing("sen", 300);
                me->receive_heal("gin",500);
                me->receive_heal("kee",500);
                me->receive_heal("sen",500);
                tell_object(me,"你似乎感到身上的伤势几乎完全恢复了！\n");
                break;
        default:
                tell_object(me,"但是似乎什么反应都没有！\n");
	};
        destruct(ob);
        return 1;
}
