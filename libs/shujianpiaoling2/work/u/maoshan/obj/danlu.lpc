
//danlu.c 炼丹炉

inherit ITEM;

void create()
{
        set_name("炼丹炉", ({ "dan lu", "lu" }));
        set_weight(30000);
        set_max_encumbrance(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", "一只青铜做的炼丹炉，专门用于炼丹(liandan)的，小巧玲珑，可以随身携带。\n");
                set("value", 10000);
        }
}

void init()
{
        add_action("do_liandan","liandan");
}

int is_container() { return 1; }

int do_liandan(string arg)
{
        object me,dan1,dan2,*inv; 
        int kind1,kind2,kind3,lvl,kar;

        me = this_player();
	inv = all_inventory(this_object());
        if ( (sizeof(inv) != 2) || !( ( dan1 = inv[0] )->id("dan")) ||
            !(( dan2 = inv[1] )->id("dan")) ) 
                return notify_fail("每次炼丹必须用两颗丹药炼制！\n");
        lvl=me->query_skill("liandanshu",1);
        kar=me->query("kar");
        kind1=dan1->query("kind");
        kind2=dan2->query("kind");
        if(kind1>kind2){kind3=kind1;kind1=kind2;kind2=kind3;}
        switch(kind1*100+kind2){
                case 305:kind3=6;break;
                case 102:kind3=7;break;
                case 104:kind3=8;break;
                case 406:kind3=9;break;
                case 709:kind3=10;break;
                case 508:kind3=11;break;
                case 211:kind3=12;break;
                case 310:kind3=13;break;
                case 612:kind3=14;break;
                case 1011:kind3=15;break;
                default:kind3=0;
        }
        if( kind3 && ( lvl >= (kind3 - 5)*25 )&&( random(lvl * 2 + kar * 5) + 50 > kind3 * 10 )) 
        {
                destruct(dan2);
                dan1->set_dan_kind(kind3);
                message_vision("$N将丹药放入炼丹炉中，催动内力使炉火暴涨……\n过了片刻炉火慢慢熄灭，炉内出现了一颗$n！\n",me,dan1);
        }else{
                message_vision("$N将丹药放入炼丹炉中，催动内力使炉火暴涨……\n但似乎炼丹不当，炉内突然发出了一阵爆炸声，$N躲避不及，被飞溅的丹药碎片炸伤！\n",me);
                destruct(dan1);
                destruct(dan2);
                me->receive_wound("gin",10+random(200/kar));
                me->receive_wound("kee",10+random(200/kar));
                me->receive_wound("sen",10+random(200/kar));
        }
        me->start_busy(2);
        return 1;
}
