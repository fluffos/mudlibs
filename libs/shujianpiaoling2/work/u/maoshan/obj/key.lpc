
//key.c 丹房钥匙

#include <ansi.h>
inherit ITEM;

void create()
{
        set_name( HIY"丹房钥匙"NOR ,({"key","danfang key"}) );
        if (clonep())
                set_default_object(__FILE__);
        else {
	        set_weight(300);
	        set("long", "这是一把铜钥匙，上面刻着丹房两字。\n");
                set("unit", "把");
                set("value",1);
        }
        setup();
}
