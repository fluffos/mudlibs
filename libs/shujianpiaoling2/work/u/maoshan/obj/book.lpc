// book.c 炼丹入门

inherit ITEM;

void create() {
  set_name("炼丹入门", ({ "liandan book", "book" }));
  set_weight(800);
  set("unit", "本");
  set("long", "这是本专门讲炼丹术的书，不过看起来似乎总有点奇怪，对一本入门书来说，书好象太厚了点。\n");
  set("value", 100);
  set("skill", ([
    "name": "liandanshu",    // name of the skill
    "exp_required": 50000,           // minimum combat experience required
    // to learn this skill.
    "sen_cost": 40,              // gin cost every time study this
    "difficulty": 30,              // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 40               // the maximum level you can learn
    // from this object.
  ]));
}

void init() {
  add_action("do_tear", "tear");
}

int do_tear(string arg) {
  object ob;
  string *msg = ({
    "大风丹是由凝水丹和生土丹炼制而成的。\n",
    "清心丹是由乌金丹和润木丹炼制而成的。\n",
    "神力丹是由乌金丹和烈火丹炼制而成的。\n",
    "飞云丹是由烈火丹和大风丹炼制而成的。\n",
    "生生再造丹是由清心丹和飞云丹炼制而成的。\n",
    "霹雳惊雷丹是由生土丹和神力丹炼制而成的。\n",
    "六道轮回丹是由润木丹和霹雳惊雷丹炼制而成的。\n",
    "天王补心丹是由凝水丹和生生再造丹炼制而成的。\n",
    "九转阴阳丹是由大风丹和六道轮回丹炼制而成的。\n",
    "天道太极丹是由生生再造丹和霹雳惊雷丹炼制而成的。\n",
  });
  ob = this_object();
  if (!arg || ((arg != "liandan book") && (arg != "book")))
    return notify_fail("你要撕什么？\n");
  message_vision(
    "$N三下五去二，将$n撕成了碎片，在碎片中，突然出现了一张黄色的小纸条，上面写着：\n" + msg[random(sizeof(msg))],
    this_player(),
    ob
  );
  destruct(ob);
  return 1;
}
