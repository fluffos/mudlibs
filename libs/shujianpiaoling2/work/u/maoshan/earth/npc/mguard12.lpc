// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［合精法］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("蝙蝠精", ({ "bianfujing", "taoist guard" }) );
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 20);
        set("attitude", "peaceful");
        set("long",@LONG
一个在阴阳界之间游荡的鬼魂，传说只有在人间饱尝了冤屈的灵魂，死不
瞑目之后才会有一段间歇时间留在阴界的出口，等待人间的法术高深的道
士来为其超度亡魂，以致于超脱十八重地狱的罪孽。
如果你想为其超度，请念无量咒（chaodu）。
LONG
	);

 	set("mguard", "mguard12");
 	set("mguard_level", 12);
	set("magic_power", 60);

	set("str", 32);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
 	set("can_be_get", 1);

        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "claw","bite" }) );
        set("last_load_time", uptime());
	set("max_mana", 600);
	set("mana", 600);

        set("combat_exp", 120000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
void init()
{
	add_action("do_nianzhou", "chaodu");
}

int do_nianzhou(string arg)
{
	object me,ob;
	string gname;
	int i,glvl;
	object *enemy;

	me = this_player();
	ob = this_object();
	if( !arg || (arg!="wangsheng" && arg!="jile") )
		{
		write("你想如何用 [无量咒] 进行超度？\n");
		return notify_fail("格式：chaodu wangsheng 往生咒    chaodu jile 极乐咒\n");
		}
	seteuid(getuid());

	if((int)me->query("gin") < 90 )
		return notify_fail("你的精神没有办法有效集中！\n");
	if((int)me->query("sen") < 90 )
		return notify_fail("你的精神没有办法有效集中！\n");

	if ( me->query("class") != "taoist" && me->query("class") != "qingcheng" )
	return notify_fail("你不是道士，无法念［无量咒］进行超度。\n");

	if( !ob->query("can_be_get") )
	return notify_fail("你现在无法念［无量咒］进行超度。\n");

	if( arg=="wangsheng" )
	{
	if ( present("taoist guard", me) )
	return notify_fail("你现在无法念［无量往生咒］。\n");

	message_vision(CYN"$N喃喃念起了［无量往生咒］，只见$n化做一道轻烟飞入了$N的怀中！\n"NOR,me,ob);

	ob->move(me);
	ob->set("taoist_owner",me);
	}
	else if( arg=="jile" )
	{

	if( ob->query("taoist_owner")!=me )
	return notify_fail("你现在无法念［无妄极乐咒］。\n");

	message_vision(CYN"$N喃喃念起了［无妄极乐咒］，只见一道轻烟化做$n从$N的怀中飞了出来！\n"NOR,me,ob);
	ob->move(environment(me));
	if( me->is_fighting() )
	{
	enemy = me->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) 
		ob->kill_ob(enemy[i]);
		enemy[i]->kill_ob(ob);
	}
        me->remove_all_killer();
	ob->delete("taoist_owner");
	ob->delete("can_be_get");
	}

	}
	me->receive_damage("gin", 50);
	me->receive_damage("sen", 50);
	me->start_busy(2);
//	destruct(ob);
	return 1;
}

int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( who->query("kee") < who->query("max_kee")*3/4 )
	{
	message_vision(HIC"\n$N双目一合，身体忽然倒挂在空中。"NOR,who,enemy[i]);
	message_vision(HIC"\n$N的身体被风一吹，顿时浑身上下精力充沛，敏捷大增。\n"NOR,who,enemy[i]);
	message_vision(HIG"［合精法］！\n\n"NOR,who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
	if( who->query("mana") >= 50 )
	who->add("mana", -50);
	COMBAT_D->report_status(who,1);
	}
		}
	}
	return 1;
}

int heal_up()
{
	object who=this_object();
	if( !environment(who) )
	{
		destruct(who);
		return 1;
	}
	if( !who->is_fighting() && (uptime()-(int)who->query("last_load_time")) > (random(500)+300) )
	{
		if(!userp(environment(who)) )
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

