#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int magic_more( object who);

void create()
{
        set_name("吕洞实", ({ "lv dongshi","lv","master" }) );
	 set("nickname",HIY"金洞金仙"NOR);
        set("gender", "男性");
        set("age", 47);
        set("str", 10);
        set("long",
"吕洞实是掌门人温道乙的师弟，负责看守茅山镇山宝物“炼妖壶”。\n" );
        set("attitude", "peaceful");
	set("max_kee", 5000);
	set("max_gin", 5000);
	set("max_sen", 5000);
	set("kee", 5000);
	set("gin", 5000);
	set("sen", 5000);

	set("max_atman", 1000);
	set("atman", 1000);

	set("max_mana", 3000);
	set("mana", 3000);
        set("mana_factor", 5);

        set("force", 500);
        set("max_force", 500);
        set("force_factor", 1);

        set("combat_exp", 500000);
        set("score", 5000);
	set_temp("apply/defense", 5);
	set_temp("apply/move", 5);

        set_skill("literate", 150);
        set_skill("magic", 170);
        set_skill("force", 190);
        set_skill("move", 150);
        set_skill("scratching", 180);
	set_skill("spells",180);
        set_skill("unarmed", 150);
        set_skill("sword", 140);
        set_skill("parry", 160);
        set_skill("dodge", 160);
        set_skill("gouyee", 190);
	set_skill("sanqing-jian", 140);
        set_skill("taoism", 120);
        set_skill("scratmancy", 170);
	set_skill("necromancy",170);
        set_skill("liandanshu",200);

        map_skill("scratching", "scratmancy");
        map_skill("spells", "necromancy");
        map_skill("parry", "sanqing-jian");
        map_skill("sword", "sanqing-jian");
        map_skill("force", "gouyee");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        create_family("茅山派", 4, "弟子");

        setup();

        carry_object(__DIR__"obj/taomujian")->wield();
        carry_object(__DIR__"obj/robe")->wear();
}
int magic_more(object who)
{
	int i, mwp;
	object *enemy, mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if (!objectp(present("death god", environment(who))))
	{
		mygod = new("/daemon/troop/maoshan/deathgod");
		message_vision(HIB"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,who,enemy[i]);
		message_vision(HIB"\n不久只见四周一片浓雾弥漫，冥府判官的身影渐渐在烟雾中浮现出来。\n"NOR,who,enemy[i]);
		message_vision(HIG"［生死符］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		mygod->kill_ob(enemy[i]);
		enemy[i]->kill_ob(mygod);
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
		who->remove_all_killer();
	}
	else
	{
		message_vision(HIB"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,who,enemy[i]);
		message_vision(HIB"\n不久只见四周一片浓雾弥漫，冥府判官的身影渐渐在烟雾中浮现出来。\n"NOR,who,enemy[i]);
		message_vision(HIG"［生死符］！\n\n"NOR,who,enemy[i]);
		mygod = present("death god", environment(who));
		mygod->kill_ob(enemy[i]);
		enemy[i]->kill_ob(mygod);
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
		who->remove_all_killer();
	}
		}
	}
	return 1;
}

void die()
{
	object who;
	seteuid(getuid());
	who = this_object();
	if( who->query_temp("already_die") < 3 )
	{
	message_vision("\n$N死了。\n",who);
	message_vision(HIY"\n$N尸体边渐渐显出一个仙影，鹤发道袍，手持古松杖。"NOR,who);
	message_vision(HIY"\n那洞仙对着$N的尸体念起了长生咒，只见尸体缓缓立了起来！"NOR,who);
	message_vision(HIY"\n洞仙微笑地点了点头，转瞬消失了。$N获得了重生！\n"NOR,who);
	message_vision(HIG"［劫后重生］！\n\n"NOR,who);
       who->receive_curing("kee", 1000);
       who->receive_heal("kee", 1000);
       who->receive_curing("sen", 1000);
       who->receive_heal("sen", 1000);
       who->receive_curing("gin", 1000);
       who->receive_heal("gin", 1000);
	who->add_temp("already_die",1);
	who->remove_busy();
	}
	else
	::die();
}


