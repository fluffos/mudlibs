
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("穆朗清", ({ "mu langqing","mu" }) );
        set("nickname","神钩天使");
        set("gender", "男性");
        set("age", 26);
        set("long",
"穆朗清是掌门人温道乙的嫡传弟子，尽得师父真传。\n" );
        set("attitude", "peaceful");
        set("str", 26);
        set("int", 22);
        set("spi", 25);
        set("per", 23);
        set("cps", 23);
        set("max_kee", 2000);
        set("max_gin", 2000);
        set("max_sen", 2000);
        set("kee", 2000);
        set("gin", 2000);
        set("sen", 2000);

        set("max_atman", 2000);
        set("atman", 2000);

        set("max_mana", 5000);
        set("mana", 5000);
        set("mana_factor", 10);

        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);

        set("combat_exp", 2000000);
        set("score", 10000);
        set_temp("apply/attack", 5);
        set_temp("apply/defense", 5);
        set_temp("apply/move", 5);

        set_skill("literate", 80);
        set_skill("magic", 100);
        set_skill("force", 160);
        set_skill("move", 100);
        set_skill("scratching", 160);
        set_skill("spells",160);
        set_skill("unarmed", 100);
        set_skill("sword", 100);
        set_skill("parry", 110);
        set_skill("dodge", 120);
        set_skill("gouyee", 160);
        set_skill("sanqing-jian", 120);
        set_skill("taoism", 200);
        set_skill("scratmancy", 160);
        set_skill("necromancy",160);
        set_skill("liandanshu",100);

        map_skill("scratching", "scratmancy");
        map_skill("spells", "necromancy");
        map_skill("parry", "sanqing-jian");
        map_skill("sword", "sanqing-jian");
        map_skill("force", "gouyee");

        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: cast_spell, "invocation" :),
                (: cast_spell, "netherbolt" :),
                (: cast_spell, "feeblebolt" :),
        }) );

        create_family("茅山派", 5, "弟子");

        set("inquiry", ([
                "鬼屋" : "听说现在各地有一些孤魂野鬼作祟，在鬼屋兴风作浪，到\n夜里就四处游荡，扰得百姓不宁，我派弟子应该挺身而出，降妖收魔，\n为民除害。\n",
                "孤魂野鬼" : "听说现在各地有一些孤魂野鬼作祟，在鬼屋兴风作浪，到\n夜里就四处游荡，扰得百姓不宁，我派弟子应该挺身而出，降妖收魔，\n为民除害。\n",
                "驱鬼" : "驱鬼可不是件容易的事啊，你不仅要有高超的咒术和符之\n术，还要准备一点桃符纸，才能驱鬼(lay ghost)，使鬼魂显出原形。"
        ]));
        set("chat_chance", 20);
        set("chat_msg", ({
                "穆朗清自言自语地说道：到何时才能收服那些鬼屋里的孤魂野鬼呢？\n",            
                "穆朗清说道：如果先驱鬼的话，那些鬼魂就会遭到重创，再收拾他们就容易多了！\n",
                "穆朗清说道：听说那些鬼魂所用的兵器都是有恶灵附体的，一定要把这些\n兵器都妥善处理掉。\n",
        }) );
        setup();

        carry_object("/obj/longsword")->wield();
        carry_object(__DIR__"obj/robe")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query_skill("taoism",1) < 80) {
            command("say 本门法术均以天师正道作为基础，你修为尚浅，拜师之事还是以后再说吧。\n");
            return;
        }       
      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要勤于修道，少过问江湖之事！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
        {
                ob->set("class", "taoist");
                ob->set("id_type", 1);
        }
}

int accept_object(object me,object ob)
{
        int lvl,bonus;
        if( me->query("class")=="taoist" && ob->id("ghostwhip") && ob->name()=="追魂鞭" )
        {
                command("smile");
                command("say 你终于为民除了一害，太好了！");
                lvl = me -> query_skill( "taoism" , 1 );
                if( lvl < 60 ) return 1;
                if( lvl < 90 )
                {
                      me->set_skill( "taoism" , lvl+1 );
                      return 1;
                }else if( me->query("combat_exp") < 500000 && me->query("potential") < 400000)
                {
                      bonus=me->query("life_exp");
                      bonus=((bonus>10000)?10000:bonus)/200;
                      bonus=random(bonus);
                      me->add("life_exp",30+bonus);
                      me->add("combat_exp",30+bonus);
                      me->add("potential",10+bonus);
                      me->add("daode_point",1);
                }
                return 1;
        }
        else
                return 0;
}
