// taoist3.c 假道士

inherit NPC;

void create()
{
        set_name("道士", ({ "taoist" }) );
        set("gender", "男性" );
        set("age", 51);
        set("long", "一个满面红光的老道士。\n");
        set("combat_exp", 9000);
        set("str", 27);
        set("force", 200);
        set("max_force", 200);
        set("force_factor", 2);
        setup();
        set("chat_chance", 30);
        set("chat_msg", ({
                "道士说道：我这里有上好的生生再造丹，5两金子一颗，吃了强身健体，你要不要来一颗～\n",
                (: random_move :)
        }) );
        carry_object(__DIR__"obj/robe")->wear();
        carry_object("/u/maoshan/obj/dan");
}

int accept_object(object me, object ob)
{
        object fakedan;
        if (ob->query("money_id") && ob->value() >= 50000) 
        {
                tell_object(me, "道士说道：多谢这位" + RANK_D->query_respect(me) + "，这是生生再造丹，您可拿好了！\n");
                fakedan=new("/u/maoshan/obj/fakedan");
                fakedan->move(me);
                return 1;
        }
        else
        {
                tell_object(me, "道士说道：生生再造丹每颗5两黄金。\n");
                return 0;
        }
}

void die()
{
        object killer;
        int bonus;
        if( objectp(killer = query_temp("last_damage_from")) ) {
                bonus=killer->query("life_exp");
                bonus=((bonus>10000)?10000:bonus)/300;
                bonus=random(bonus);
                killer->add("life_exp",30+bonus);
                killer->add("combat_exp",20+bonus);
                killer->add("potential",10+bonus);
                killer->add("daode",2);
        }
        ::die();
}

int accept_fight(object me)
{
       return 1;
}
 
