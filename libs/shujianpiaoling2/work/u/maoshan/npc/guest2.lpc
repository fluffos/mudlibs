//guest2.c 进香客

#include <ansi.h>
inherit NPC;

void create() {
  set_name("进香客", ({ "guest" }));
  set("gender", "男性");
  set("age", 32);
  set("long",
    "一个神情沉重的中年人, 他手握一束香，口里正喃喃自语。\n");
  set("combat_exp", 5000);
  set("attitude", "friendly");

  set("inquiry", ([
    "父母": "我自小就远离家乡，在外闯荡江湖，近年来终于积攒了一小笔钱，
原想回家赡养父母，却不料回乡后才发现人事已非，父母都已病故，真是树欲静
而风不止，子欲养而亲不在。听说父母死前最放心不下我的安危，我只希望能跟
父母亲再见一面，问问他们在阴间一切可还安好，让他们知道我现在依然平安，
就心满意足了。"
  ]));
  set("chat_chance", 20);
  set("chat_msg", ({
    "进香客自言自语地说道：不知道我父母在阴间可还安好……\n",
    "进香客眼含泪光，轻声说道：我真想再见父母最后一面啊！\n",
  }));
  setup();
  add_money("silver", 10);

}

int accept_object(object me, object obj) {
  object key;
  int bonus;
  if (obj->name() == YEL "阴界传送符" NOR) {
    command("say 多谢这位" + RANK_D->query_respect(me) + "的大恩大德！");
    command("thank");
    command("say 对了，这把钥匙是我在山下拣到的，不知道有什么用处，就送给恩公了！");
    message_vision("进香客点燃了$N，一眨眼的工夫，人影已经不见了。\n", obj);
    this_object()->move(VOID_OB);
    key = new("/u/maoshan/obj/key");
    key->move(me);
    bonus = me->query("life_exp");
    bonus = ((bonus > 10000) ? 10000 : bonus) / 100;
    bonus = random(bonus);
    me->add("life_exp", 30 + bonus);
    me->add("combat_exp", 20 + bonus);
    me->add("potential", 10 + bonus);
    return 1;
  }
}
