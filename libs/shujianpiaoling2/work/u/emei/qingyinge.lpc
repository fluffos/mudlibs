inherit ROOM;

void create() {
  set("short", "清音阁");
  set("long", @LONG
清音阁隐身在一片苍松翠柏之间。阁楼门面七间，飞檐三层，绿
瓦朱梁，阁底砖砌平台，重立支柱，工艺奇巧，观瞻堂皇。阁廊下东
西两侧树立着峨眉派记事石碑二块。峨眉佛道兼容，不争长短，可谓
天下绝无仅有。
LONG
  );
  set("exits", ([
    "west": __DIR__ "xiaolu22",
    "southeast": __DIR__ "xiaolu21",
  ]));
  set("objects", ([
    __DIR__ "npc/qingyun": 1,
  ]));
  set("valid_startroom", 1);
  setup();
  call_other("/obj/board/emei_b", "???");
}

int valid_leave(object me, string dir) {
  object ob;
  if (dir == "west" && present("qing yun", environment(me)) &&
    me->query("class") != "emei")
    return notify_fail("青云子伸手一拦，说道：“非本派弟子请回！”\n");
  return ::valid_leave(me, dir);
}
