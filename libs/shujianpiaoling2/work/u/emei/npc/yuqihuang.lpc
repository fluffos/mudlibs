inherit NPC;
inherit F_MASTER;

void create() {
  set_name("于启煌", ({ "yu qihuang", "yu" }));
  set("gender", "男性");
  set("age", 33);
  set("long",
    "于启煌是“峨眉三云”弟子，江湖人称“银弹剑客”。\n");
  set("inquiry", ([
    "here": "这里就是峨眉派。",
  ]));
  set("attitude", "peaceful");
  set("class", "emei");
  set("max_kee", 900);
  set("max_gin", 900);
  set("max_sen", 900);
  set("kee", 900);
  set("gin", 900);
  set("sen", 900);

  set("force", 900);
  set("max_force", 900);
  set("force_factor", 20);
  set("combat_exp", 1000000);
  set("score", 9000);

  set_skill("dodge", 80);
  set_skill("move", 50);
  set_skill("literate", 30);
  set_skill("parry", 80);
  set_skill("unarmed", 76);
  set_skill("force", 60);
  set_skill("sword", 50);

  set_skill("wind_sword", 50);
  set_skill("mian_strike", 76);
  set_skill("taiqing_force", 50);
  set_skill("ganchan_steps", 76);

  map_skill("dodge", "ganchan_steps");
  map_skill("unarmed", "mian_strike");
  map_skill("force", "taiqing_force");
  map_skill("parry", "wind_sword");
  map_skill("sword", "wind_sword");

  create_family("峨眉派", 7, "弟子");

  setup();

  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 2) {
    command("say 本派乃名门正派，不收邪道人物。\n");
    return;
  }

  if (ob->query_skill("mian_strike", 1) < 40) {
    command("say 你的本门掌法修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("ganchan_steps", 1) < 40) {
    command("say 你的本门轻功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }

  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把峨眉发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "emei");
  ob->set("id_type", 1);
}
