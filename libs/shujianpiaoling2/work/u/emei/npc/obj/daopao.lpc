// daopao.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("青布道袍", ({ "daopao", "cloth" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一件青布缝制的道袍，道袍上面有八卦图形。\n");
		set("unit", "件");
		set("value", 0);
		set("material", "cloth");
		set("armor_prop/armor", 1);
		set("armor_prop/personality", 3);
	}
	setup();
}

