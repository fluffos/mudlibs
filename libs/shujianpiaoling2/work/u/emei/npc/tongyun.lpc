
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("彤云子", ({ "tong yun", "yun","master" }) );
        set("gender", "男性");
        set("age", 43);
        set("long",
"彤云子是永吉真人的弟子，被称为“峨眉三云”之一。\n"  );
        set("inquiry", ([
                "here": "这里就是峨眉派。",
        ]) ); 
        set("attitude", "peaceful");
        set("class","emei");
        set("str", 25);
        set("int", 22);
        set("spi", 25);
        set("per", 23);
        set("cps", 23);
	set("max_kee", 1400);
	set("max_gin", 1400);
	set("max_sen", 1400);
	set("kee", 1400);
	set("gin", 1400);
	set("sen", 1400);

        set("force", 1400);
        set("max_force", 1400);
        set("force_factor",30);
        set("combat_exp",4000000);
        set("score",30000);

        set_skill("dodge", 70);
        set_skill("move", 60);
        set_skill("literate", 80);
        set_skill("parry", 90);
        set_skill("unarmed", 90);
        set_skill("force", 90);
        set_skill("sword", 60);

        set_skill("wind_sword",60);
        set_skill("mian_strike", 100);
        set_skill("taiqing_force", 90);
        set_skill("ganchan_steps", 70);

        map_skill("dodge", "ganchan_steps");
        map_skill("unarmed", "mian_strike");
        map_skill("force", "taiqing_force");
        map_skill("parry", "wind_sword");
        map_skill("sword", "wind_sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.foguang" :),
        }) );
        create_family("峨眉派", 6, "弟子");

        setup();

//        carry_object("/obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("class")!="emei") {
	    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
	    return;
	}

      if(ob->query_skill("mian_strike",1)< 60) {
	    command("say 你的本门掌法修为尚浅，拜师之事还是以后再说吧。\n");
	    return;
	}	
      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把峨眉发扬光大！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "emei");
                ob->set("id_type", 1);
}


