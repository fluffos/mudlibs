inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
你正走在峨眉山的山路上。峨眉山在四川眉县城西南十五里，雄
踞四川盆地西南缘，与浙江普陀山、安徽九华山、山西五台山并称佛
教四大名山。因山势逶迤，如娥眉细而长，美而艳，故名。
LONG
  );
  set("exits", ([
    "eastdown": __DIR__ "shisun",
    "westup": __DIR__ "yixiantian",
  ]));
  set("outdoors", "emei");
  setup();
}
