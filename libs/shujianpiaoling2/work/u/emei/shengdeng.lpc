inherit ROOM;

void create() {
  set("short", "金顶圣灯");
  set("long", @LONG
从睹光岩向谷底望去，可见无数光点，在谷中腾涌碰撞，由少及
多，飘舞山谷，佛家称为“万盏明灯照普贤”，又称“圣灯”。金顶
圣灯一般出现在秋季雨后，无月光之夜。
LONG
  );
  set("exits", ([
    "northwest": __DIR__ "wanfo",
  ]));
  set("outdoors", "emei");
  set("objects", ([
    __DIR__ "npc/questman": 1,
  ]));
  setup();
  replace_program(ROOM);
}
