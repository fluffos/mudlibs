inherit ROOM;

void create()
{
        set("short", "龙宫");
        set("long", @LONG
龙宫高居于悬崖峭壁之上，被一层薄如蝉翼的石幔遮住了，雕梁
画栋尽在朦胧之中，时隐时现，若有若无。进入宫中，那穹形的洞顶
高达数十丈，大厅可容纳千人之多。环顾宫中，只见“宫灯”高悬，
“丹陛龙座”居于正中，很有一番庄严肃穆的景象。
LONG
        );
        set("exits", ([ 
	       "out" : __DIR__"longmen",
]));
	set("objects",([
		__DIR__"npc/master2" : 1,
       	]));
        setup();
}


