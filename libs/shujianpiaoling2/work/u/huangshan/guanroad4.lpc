inherit ROOM;

void create() {
  set("short", "大官道");
  set("long", @LONG
一条宽阔笔直的大官道自崇山峻岭间由东西向远远地伸延开来，官道
平整可容得下十马并驰。大官道的东南通向远方群山。
LONG);

  set("exits", ([
    "northwest": __DIR__ "town2",
    "eastup": __DIR__ "jiuhua1",
  ]));
  set("outdoors", "huangshan");

  setup();
}
