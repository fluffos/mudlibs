inherit ROOM;
void create()
{
        set("short", "九华山南段");
        set("long", @LONG
九华山有“东南第一山”之称，在汉代称陵阳山，又名九子山。山上
苍松如海，翠竹满坡，奇峰呈秀，古刹林立。唐代诗人李白客居此山时写
有“昔在九江上，遥望九华峰，天河挂绿水，秀出九芙蓉”的名句，因此
易名为九华山。　
LONG
        );
