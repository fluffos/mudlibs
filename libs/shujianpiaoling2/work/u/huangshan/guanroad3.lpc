inherit ROOM;

void create ()
{
  set ("short", "大官道");
  set ("long", @LONG
一条宽阔笔直的大官道自盆地上由东西向远远地伸延开来，官道
平整可容得下十马并驰。大官道的东西通向远方。
LONG);

  set("exits", ([
        "northwest" : __DIR__"huangtulu",
        "east" : __DIR__"town2",
      ]));
  set("outdoors", "huangshan");

  setup();
}
