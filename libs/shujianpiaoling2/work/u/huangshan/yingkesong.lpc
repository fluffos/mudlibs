//huangshan yingkesong.c
inherit ROOM;

void create ()
{
        set ("short", "迎客松");
        set ("long", @LONG
来到黄山山脚,一棵刚毅挺拔的千年老松在石逢中顽强地迎风而立,这
就是黄山有名的"迎客松",它立于此千年只久,迎接这每一位来黄山的客人。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
              "eastup" : __DIR__"shijie",
		"westdown" : __DIR__"huangtulu",
           ]));

        set("objects", 
        ([ //sizeof() == 1
		__DIR__"npc/people" : 2,
        ]));


        set("outdoors", "huangshan");
	set("no_clean_up", 0);
	        setup();
}


