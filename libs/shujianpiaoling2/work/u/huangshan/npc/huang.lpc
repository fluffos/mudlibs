#include <ansi.h>
inherit NPC;
//inherit F_MASTER;

void create() {
  set_name("黄清溪", ({ "huang qingxi", "huang", "qingxi" }));
  set("long", "万松山庄庄主黄清溪是个隐居世外的前辈高人\n");
  set("title", "万松山庄庄主");
  set("nickname", CYN "天都剑客" NOR);
  set("gender", "男性");
  set("age", 50);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("per", 26);
  set("str", 30);
  set("int", 30);
  set("max_kee", 5000);
  set("max_gin", 1000);
  set("max_sen", 5000);
  set("kee", 5000);
  set("gin", 1000);
  set("sen", 5000);
  set("force", 5000);
  set("max_force", 2500);
  set("force_factor", 100);
  set("max_mana", 2500);
  set("mana", 2500);
  set("combat_exp", 9000000);
  set_skill("literate", 250);
  set_skill("unarmed", 250);
  set_skill("dodge", 250);
  set_skill("parry", 250);
  set_skill("sword", 250);
  set_skill("three-sword", 250);
  set_skill("yiqiforce", 200);
  set_skill("force", 250);
  set_skill("dk-xubu", 250);
  map_skill("unarmed", "yiqiforce");
  map_skill("force", "yiqiforce");
  map_skill("sword", "three-sword");
  map_skill("parry", "three-sword");
  map_skill("dodge", "dk-xubu");
  setup();

  carry_object("/d/city/obj/cloth/changpao")->wear();
  carry_object("/d/city/obj/cloth/cloudyshoe")->wear();
  carry_object("/d/city/obj/weapon/sword/qinghong")->wield();
}

int accept_fight(object me, object ob) {
  ob = this_player();
  command("say " + RANK_D->query_rude(ob) + "杀心太重，恐祸不久已！\n");
  return 0;
}
