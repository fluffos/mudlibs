#include <ansi.h>

inherit NPC;

#define DEBUG 0

#define MYFILE "/u/huangshan/npc/peng.lpc"

#define MAXCATEGORY 5
#define MAXPOSITION 3

string *categories = ({
  "天下第一",
  "天下第二",
  "天下第三",
  "天下第四",
  "天下第五",
 });

string *positions = ({
  "大宗师",
  "大英雄",
  "大高手",
 });

int *limits = ({
  5000000,
  1500000,
  1000000,
  800000,
  600000,
 });

#define LEVEL_NONE 0
#define LEVEL_ASKED 1
#define LEVEL_RANKED 2

int interval_set = 0;
int fight_times = 0;
string FST = 0;

void create()
{
  set_name("彭飞", ({ "peng fei", "peng","fei" }));
  set("title", "武林大会主持");
  set("nickname", HIY"兵书宝剑侠"NOR);
  set("gender", "男性");
  set("age", 33);
  set("per", 30);
  set("combat_exp", 5000000);
  set_skill("force", 200);
  set_skill("spells", 200);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("move", 200);
  set_skill("literate", 200);
  set_skill("sword", 200);
  set_skill("parry", 200);
  set("gin", 5000);
  set("max_gin", 5000);
  set("kee", 5000);
  set("max_kee", 5000);
  set("sen", 5000);
  set("max_sen", 5000);
  set("force", 5000);
  set("max_force", 5000);
  set("mana", 5000);
  set("max_mana", 5000);
  set("force_factor", 150);
  setup();
  carry_object("/d/city/obj/cloth/jinpao")->wear();
  carry_object("/d/city/obj/weapon/sword/baojian")->wield();

}

int execute_help();
int execute_ask();

void init()
{
  ::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_exert", "exert");
  add_action("do_perform", "perform");
  set("inquiry", ([
        "?":   (: execute_help() :),
        "help":   (: execute_help() :),
        "fight":  (: execute_ask() :),
        "武林大会": (: execute_ask() :),
        "比武":   (: execute_ask() :),
      ]));
  if (FST == 0)
  {
    FST = "/u/huangshan/fst";
  }
}

string randomize (string *strs)
{
  return strs[random(sizeof(strs))];
}

string get_name (object who)
{
  return who->query("name");
}

string get_respect (object who)
{
  return "这位"+RANK_D->query_respect(who);
}

void announce (object me, string str)
{
  if (DEBUG)
  { 
    object baiwt = find_player ("baiwt");
    if (baiwt && wizardp(baiwt))
      tell_object (baiwt,"◆ "+str+"\n");
  }
  else
  {
    CHANNEL_D->do_channel(me,"chat",str);
  }
}

int do_fight(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
    message_vision ("$N对$n摇头示意: "+get_respect(who)+
                    "，武林大会岂可动粗！\n",me,who);
    return 1;
  }
  return 0;
}

int do_kill(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
    message_vision ("$N对$n摇头示意: "+get_respect(who)+
                    "，武林大会不可妄念杀人！\n",me,who);
    return 1;
  }
  return 0;
}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg == "transfer")
    return 0;

  message_vision ("$N对$n摇头示意: "+get_respect(who)+
                  "，武林大会岂可乱施妖术！\n",me,who);
  return 1;
}

int do_exert(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg != "bloodsun peng fei" &&
      arg != "bloodsun peng" &&
      arg != "bloodsun fei" &&
      arg != "zhenqi")
    return 0;

  message_vision ("$N对$n摇头示意: "+get_respect(who)+
                  "，武林大会岂可偷施内功伤人！\n",me,who);
  return 1;
}

int do_perform(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision ("$N对$n摇头示意: "+get_respect(who)+
                  "，武林大会岂可私施邪功！\n",me,who);
  return 1;
}

int do_steal(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision ("$N对$n摇头示意: "+get_respect(who)+
                  "，武林大会岂能行窃！\n",me,who);
  return 1;
}

int execute_help ()
{
  object who = this_player();
  object me = this_object();

  switch (me->query_temp("huangshan/level"))
  {
    case LEVEL_NONE:
    {
      message_vision ("$N对$n说道："+get_respect(who)+
                      "参加武林大会，有何难处请问便是。\n",me,who);
      break;
    }
    case LEVEL_ASKED:
    {
      message_vision ("$N对$n说道："+get_respect(who)+
                      "可凭自身声望和经验大小，去武林排名榜上挑合适的人选与之比试。\n",me,who);
      break;
    }
    case LEVEL_RANKED:
    {
      message_vision ("$N对$n说道："+get_respect(who)+
                      "可凭自身声望和经验大小，去武林排名榜上挑合适的人选与之比试。\n",me,who);
      break;
    }
  }
  return 1;
}

void reset_interval ()
{
  interval_set = 0;
  fight_times = 0;
}

int execute_ask ()
{
  object who = this_player();
  object me = this_object();

/*
  if (who->query("combat_exp") >= limits[0])
  {
    message_vision ("$N对$n摇头摇头："+get_respect(who)+
                    "已可！\n",me,who);
    return 1;
  }
*/
  if (me->query_temp("huangshan/is_busy"))
  {
    message_vision ("$N对$n摇摇头："+get_respect(who)+
                    "，在下正忙得不可开交，恕罪失陪了。\n",me,who);
    return 1;
  }

  if(me->query_temp("huangshan/level") < LEVEL_ASKED)
  {
    if (interval_set)
    {
      message_vision ("$N对$n摇摇头："+get_respect(who)+
                      "，大会时间已过，请回吧。\n",me,who);
      return 1;
    }

    announce (me,who->query("name")+get_respect(who)+"前来参加武林大会！\n");
    message_vision ("$N对$n说道："+get_respect(who)+
                    "，在下这就准备召开天下武林大会！\n",me,who);
    message_vision ("$N话音未落，人影已经消失不见了。\n",me);
    //me->set("env/invisibility",9);
    me->set_temp("huangshan/reappear",environment(me));
    load_object("/u/baiwt/npc_hut");
    me->move("/u/baiwt/npc_hut");
    remove_call_out ("make_asked");
    call_out ("make_asked",5,me,who);
    return 1;  
  }
  // LEVEL_ASKED, LEVEL_RANKED
  remove_call_out ("continue_asked");
  call_out ("continue_asked",1,me,who);
  return 1;  
}

void make_asked (object me, object who)
{
  int i;
  object *list;

  if (!who ||
      !environment(who) ||
      environment(who) != me->query_temp("huangshan/reappear"))
  {
    me->move(me->query_temp("huangshan/reappear"));
    message_vision ("一阵微风拂过，$N矫健的身影转眼出现在面前。\n",me);
    return;
  }

  announce (me,"天下武林大会正式召开！");
  announce (me,"五湖四海各路英雄恭请上黄山天都峰参与论剑！");

  interval_set = 1;
  fight_times = 0;
  call_out ("reset_interval", 14400); // 4h
  me->set_temp("no_return",1);
  me->set_temp("huangshan/level",LEVEL_ASKED);
  //me->set("env/invisibility",0);
  me->move(me->query_temp("huangshan/reappear"));
  message_vision ("一阵微风拂过，$N矫健的身影转眼出现在面前。\n",me);
  remove_call_out ("continue_asked");
  call_out ("continue_asked",1,me,who);

}

void continue_asked (object me, object who)
{
  message_vision ("$N对$n说道："+get_respect(who)+
                  "带在下前去挑战，我会主持武林公道。\n",me,who);
  message_vision ("$N身形一晃，如影随形般跟在$n后面。\n",me,who);
  who->set_leader(me);
  me->set_leader(who);
}

int execute_approve_fight(object who, object ob, int position, int category)
{
  object *all, *list, *inv;
  int i, j;
  object me = this_object();

/*
  if (who->query("combat_exp") >= limits[0])
  {
    message_vision ("$N对$n说道："+get_respect(who)+
                    "已可。\n",me,who);
    return 0;
  }
*/
  if (who->query("combat_exp") >= limits[category-1])
  {
    message_vision ("$N对$n说道："+get_respect(who)+
                    "声望和经验过高，挑战"+categories[category-1]+"已经没有意义了。\n",me,who);
    return 0;
  }

  if (category < MAXCATEGORY &&
      who->query("combat_exp") < limits[category])
  {
    message_vision ("$N对$n说道："+get_respect(who)+
                    "声望和经验过低，无法与"+categories[category-1]+""+positions[position-1]+"比试。\n",me,who);
    return 0;
  }

  announce (me,who->query("name")+"前来挑战"+categories[category-1]+
            ""+positions[position-1]+"，与"+ob->query("name")+"比武争夺江湖排名！\n");
  
  me->set_temp("huangshan/is_busy",1);
  me->set_leader(0);
  call_out("reset_is_busy",60,me);
  return 1;
}

int execute_fight_result (object who, object ob, int success)
{
  object me = this_object();
  int i, y, d, h;

  reset_eval_cost();
  call_out("reset_is_busy",5,me);

  if (! success)
    return 1;
  if (!ob)
    return 1;
  if (!present(ob, environment(me)))
    return 1;

  announce (me,ob->query("name")+environment(me)->query("short")+
            "击败"+who->query("name")+"！\n");
  announce (me,"现在宣布，"+ob->query("name")+"为"+
            who->get_honor_str()+"！\n");
  i = ob->query("huangshan/wins")+1;
  ob->set("huangshan/wins",i);
  i = (MAXPOSITION*MAXCATEGORY*9)/i + random(9);
  ob->add("combat_exp",i);
  ob->add("score",i/2);
  ob->add("life_exp",i/2);
  y = i/1000;
  d = (i - y*1000) / 4;
  h = (i - y*1000 - d*4) * 3;
  if (y > 0)
    tell_object(ob,"你的声望和经验增加了！\n\n");
  else if (d > 0)
    tell_object(ob,"你的声望和经验增加了！\n\n");
  else if (h > 0)
    tell_object(ob,"你的声望和经验增加了！\n\n");
  me->set_temp("huangshan/current_player",ob->query("id"));
  me->set_temp("huangshan/level",LEVEL_RANKED);

  fight_times++;
  if (fight_times > (MAXPOSITION*MAXCATEGORY/2))
  {
    announce (me,"天下武林大会圆满结束，各路英雄恭请离山！\n");
    message_vision ("$N话音未落，人影已经消失不见了。\n",me);
    me->move(FST);
    me->set_temp("huangshan/is_busy",0);
    me->set_temp("huangshan/level",LEVEL_NONE);
    return 1;
  }

  message_vision ("$N说道：若还有英雄欲继续挑战，"+
                  "可带在下前去比试。\n",me);
  message_vision ("$N身形一晃，如影随形般跟在$n后面。\n",me,ob);
  me->set_leader(ob);
  return 1;
}

void reset_is_busy(object me)
{
  me->set_temp("huangshan/is_busy",0);
}

