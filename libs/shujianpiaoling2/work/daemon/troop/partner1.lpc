//何云峰
inherit TROOP;
int valid_appoint(string usage) { return usage=="shence-jun"; }

int practice_troop(object me)
{
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        if( (int)me->query("force") < 5 )
                return notify_fail("你的士气不够高，让他休息一下再练吧。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        return 1;
}
int effective_level() { return 60;}
int default_exp() { return 70000;}

string occupation_type() { return "武者"; }

string partner_troop_file(string ename)
{
        return "/daemon/troop/partner/heyunfeng";
}

string apply_action_file(string action)
{
        return CLASS_D("partner") + "/npc/" + action;
}


