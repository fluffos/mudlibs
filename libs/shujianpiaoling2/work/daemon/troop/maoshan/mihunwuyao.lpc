//法术：［雾缚符］ 属性：busy5  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("迷魂雾妖", ({ "mihunwuyao", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard29");
  set("mguard_level", 29);
  set("magic_power", 3000);

  set("str", 42);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("combat_exp", 1000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (random(enemy[i]->query("magic_defense")) < random(500) && !enemy[i]->is_busy()) {
        message_vision(HIW "\n$N张口徐徐吐出一团团烟雾，烟雾越聚越多，" NOR, who, enemy[i]);
        message_vision(HIW "\n渐渐将$n笼罩在其中，登时令$n迷失了方向。\n" NOR, who, enemy[i]);
        message_vision(HIG "［雾缚符］！\n\n" NOR, who);
        enemy[i]->start_busy(5);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(enemy[i], 1);
      }
    }
  }
  return 1;
}

int heal_up() {
  object mguard = this_object();
  if (!present(
    (string)mguard->query("player_guard"),
    environment(mguard)
  ) && !userp(environment(mguard))) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
