//法术：［反阴补天符］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("人面鹗", ({ "renmiane", "taoist guard" }) );
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard27");
 	set("mguard_level", 27);
	set("magic_power", 3000);

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "claw","bite" }) );
 
        set("combat_exp", 1000000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( who->query("kee") < who->query("max_kee")*3/4 )
	{
	message_vision(HIC"\n$N拿出一只反八卦印，对空一招，立时有一股暖气升上半空，"NOR,who,enemy[i]);
	message_vision(HIC"\n那股气流在空中转了一圈又注入$N头顶。\n"NOR,who,enemy[i]);
	message_vision(HIG"［反阴补天符］！\n\n"NOR,who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
	if( who->query("mana") >= 50 )
	who->add("mana", -50);
	COMBAT_D->report_status(who,1);
	}
		}
	}
	return 1;
}

int heal_up()
{
	object mguard=this_object();
	if( !present((string)mguard->query("player_guard"),environment(mguard)) && !userp(environment(mguard)) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

