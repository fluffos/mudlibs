//法术：［祭火符］ 属性：召唤  对象：火神  克星：无
//法术：［焰火环］ 属性：火  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("烛阴", ({ "zhuyin", "taoist guard" }) );
	set("gender", "男性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard42");
 	set("mguard_level", 42);
	set("magic_power", 3000);

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "claw" }) );
 
        set("combat_exp", 1000000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy,mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if (!objectp(present("fire god", environment(who))))
	{
		mygod = new("/daemon/troop/maoshan/firegod");
		message_vision(RED"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,who,enemy[i]);
		message_vision(RED"\n不久只见空中热气翻腾，火光乍现，眨眼间满地升起熊熊燃烧的火焰，"NOR,who,enemy[i]);
		message_vision(RED"\n火神的身影渐渐在火光中浮现出来。\n"NOR,who,enemy[i]);
		message_vision(HIG"［祭火符］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
	return 1;
	}
	message_vision(HIR"\n$N喃喃念动咒语，只见一团团焰火自$N口中吐出，五彩缤纷的焰火"NOR,who,enemy[i]);
	message_vision(HIR"\n盘旋飞舞，形成一圈火环，将$n围在当中，一会儿火环越缩越小，"NOR,who,enemy[i]);
	message_vision(HIR"\n$n被烧了个焦头烂额。\n"NOR,who,enemy[i]);
	message_vision(HIG"［焰火环］！\n\n"NOR,who,enemy[i]);
	if( random(enemy[i]->query("magic_defense"))< random(500) )
			enemy[i]->receive_wound("kee", mwp);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

int heal_up()
{
	object mguard=this_object();
	if( !present((string)mguard->query("player_guard"),environment(mguard)) && !userp(environment(mguard)) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

