// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［封魔符］ 属性：busy6  对象：all  克星：无
//法术：［惊鬼符］ 属性：attack  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("门神", ({ "menshen", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard33");
  set("mguard_level", 33);
  set("magic_power", 3000);

  set("str", 42);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("combat_exp", 1000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (random(9) < 4) {
        message_vision(YEL "\n$N喃喃念动咒语，只见$N手中忽然变出一把桃木剑和一张符纸，" NOR, who, enemy[i]);
        message_vision(YEL "\n$N将剑钉在符纸上用力一挥，桃木剑带着那张布满法力的符纸直向$n飞来！\n" NOR, who, enemy[i]);
        message_vision(HIG "［惊鬼符］！\n\n" NOR, who);
        if (random(enemy[i]->query("magic_defense")) < 100)
          enemy[i]->receive_wound("kee", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(enemy[i], 1);
        return 1;
      } else if (random(enemy[i]->query("magic_defense")) < random(500) && !enemy[i]->is_busy()) {
        message_vision(HIC "\n$N喃喃念动咒语，只见一张符纸缓缓升上半空，符纸慢慢变大，" NOR, who, enemy[i]);
        message_vision(HIC "\n纸上显出一个巨大的“封”字，直贴在$n身上。\n" NOR, who, enemy[i]);
        message_vision(HIG "［封魔符］！\n\n" NOR, who);
        enemy[i]->start_busy(6);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(enemy[i], 1);
      }
    }
  }
  return 1;
}

int heal_up() {
  object mguard = this_object();
  if (!present(
    (string)mguard->query("player_guard"),
    environment(mguard)
  ) && !userp(environment(mguard))) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
