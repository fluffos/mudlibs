//法术：［祭风符］ 属性：召唤  对象：风神  克星：无
//法术：［滚风喷嚏］ 属性：风  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("风生兽", ({ "fengshengshou", "taoist guard" }) );
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard39");
 	set("mguard_level", 39);
	set("magic_power", 3000);

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "claw","bite" }) );
 
        set("combat_exp", 1000000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy,mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if (!objectp(present("wind god", environment(who))))
	{
		mygod = new("/daemon/troop/maoshan/windgod");
		message_vision(HIC"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,who,enemy[i]);
		message_vision(HIC"\n不久只见四周狂风大作，风声呜呜作响，吹得人气也喘不过来。"NOR,who,enemy[i]);
		message_vision(HIC"\n随着大风愈刮愈烈，风神的身影渐渐在半空中浮现出来。\n"NOR,who,enemy[i]);
		message_vision(HIG"［祭风符］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
	return 1;
	}
	message_vision(HIR"\n$N忽然猛吸一口气，噗地一声打出一个震天响的喷嚏，\n"NOR,who,enemy[i]);
	message_vision(HIR"\n只见四周狂风大作，夹杂着那喷嚏的异味直向$n卷了过来！\n"NOR,who,enemy[i]);
	message_vision(HIG"［滚风喷嚏］！\n\n"NOR,who,enemy[i]);
	if( random(enemy[i]->query("magic_defense"))< random(500) )
			enemy[i]->receive_wound("kee", mwp);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

int heal_up()
{
	object mguard=this_object();
	if( !present((string)mguard->query("player_guard"),environment(mguard)) && !userp(environment(mguard)) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

