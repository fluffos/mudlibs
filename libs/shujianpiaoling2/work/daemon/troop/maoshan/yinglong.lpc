//法术：［布云补天符］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("应龙", ({ "yinglong", "taoist guard" }) );
	set("gender", "男性");
	set("age", 70);
        set("attitude", "peaceful");

 	set("mguard", "mguard53");
 	set("mguard_level", 53);
	set("magic_power", 3000);

	set("str", 92);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 3000);
	set("max_gin", 3000);
	set("max_sen", 3000);
	set_skill("unarmed",200);
        set_skill("dodge", 200);
        set("combat_exp", 1000000);
	set("max_mana", 3000);
	set("mana", 3000);

        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "claw","bite" }) );

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );
	set_temp("super_damage",86400*7);

        set_temp("apply/unarmed", 600);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( who->query("kee") < who->query("max_kee")*3/4 )
	{
	message_vision(HIC"\n$N吐出一张符纸，缓缓飘上天空。"NOR,who);
	message_vision(HIC"\n$N发出龙吟，刹那间半空四周回响，那符纸化做一层厚厚云层！"NOR,who);
	message_vision(HIC"\n云层越积越多，$N转眼被云层包围，伤口都痊愈了。\n"NOR,who);
	message_vision(HIG"［布云补天符］！\n\n"NOR,who);
       who->receive_curing("kee", 1000);
       who->receive_heal("kee", 1000);
       who->receive_curing("sen", 1000);
       who->receive_heal("sen", 1000);
       who->receive_curing("gin", 1000);
       who->receive_heal("gin", 1000);
	if( who->query("mana") >= 50 )
	who->add("mana", -50);
	if( !who->query_soft_powerup() )
		who->soft_powerup(30,30);

	COMBAT_D->report_status(who,1);
	 return 1;
	}
	enemy[i]->set_delay(5);
	if( enemy[i]->query("force")>100 ) enemy[i]->add("force",-100);
		}
	}
	return 1;
}

int heal_up()
{
	object mguard=this_object();
	if( !present((string)mguard->query("player_guard"),environment(mguard)) && !userp(environment(mguard)) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

void die()
{
	object who;
	seteuid(getuid());
	who = this_object();
	if( who->query_temp("already_die") < 3 )
	{
	message_vision(HIW"\n$N吐出一张符纸，缓缓飘上天空。"NOR,who);
	message_vision(HIW"\n$N发出长啸，刹那间半空四周回响，那符纸化做一层厚厚云层！"NOR,who);
	message_vision(HIW"\n云层越积越多，$N转眼被云层包围，伤口都痊愈了。\n"NOR,who);
	message_vision(HIG"［布云补天符］！\n\n"NOR,who);
       who->receive_curing("kee", 1000);
       who->receive_heal("kee", 1000);
       who->receive_curing("sen", 1000);
       who->receive_heal("sen", 1000);
       who->receive_curing("gin", 1000);
       who->receive_heal("gin", 1000);
	who->add_temp("already_die",1);
	who->remove_busy();
	if( !who->query_soft_powerup() )
		who->soft_powerup(30,30);

	}
	else
	::die();
}
