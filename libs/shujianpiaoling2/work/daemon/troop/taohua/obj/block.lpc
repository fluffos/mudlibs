// block.c

#include <weapon.h>

inherit HAMMER;

void create() {
  string *mname = ({
    "铁条", "铜片", "钢材", "银器",
    "木料", "干草", "琉璃", "石块",
    "铁条", "铜片", "钢材", "银器",
    "木料", "干草", "琉璃", "石块",
  });
  string *mat = ({
    "straw", "wood", "iron", "steel",
    "copper", "stone", "silver", "glaze",
    "straw", "wood", "iron", "steel",
    "copper", "stone", "silver", "glaze",
  });
  string *typ = ({
    "head", "body", "arm", "leg",
    "head", "body", "arm", "leg",
  });
  set_name(mname[random(15)], ({ "block" }));
  set_weight(5000);
  set("material", mat[random(15)]);
  set("mat_type", typ[random(7)]);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是普通的用来制作工艺物品的材料。\n");
    set("value", 200);
    set("unit", "些");
  }
  init_hammer(1);
  setup();
}
