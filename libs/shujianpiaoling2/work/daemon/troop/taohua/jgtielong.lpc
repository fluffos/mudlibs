//法术：［火龙吐炎符］ 属性：fire  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("机关铁龙", ({ "jgtielong", "jiguan guard" }) );
	set("gender", "男性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("jgguard", "jgguard29");
 	set("jgguard_level", 29);
	set("magic_power", 3000);
 	set("jgguard_attrib", "兽类");

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("max_mana", 500);
	set("mana", 1000);

        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "claw" }) );
 
        set("combat_exp", 1000000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );
	set_temp("super_damage",86400*7);

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy,mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if (!objectp(present("fire god", environment(who))))
	{
		mygod = new("/daemon/troop/maoshan/firegod");
		message_vision(RED"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,who,enemy[i]);
		message_vision(RED"\n不久只见空中热气翻腾，火光乍现，眨眼间满地升起熊熊燃烧的火焰，"NOR,who,enemy[i]);
		message_vision(RED"\n火神的身影渐渐在火光中浮现出来。\n"NOR,who,enemy[i]);
		message_vision(HIG"［祭火符］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
	return 1;
	}
	message_vision(HIR"\n$N对着火云念起了召唤咒语。不久只见彤云翻滚，云层开处，"NOR,who,enemy[i]);
	message_vision(HIR"\n一条满身通红的长龙出现在空中，只见它发出一声龙吟，张口"NOR,who,enemy[i]);
	message_vision(HIR"\n吐出一团团火焰，直向$n烧了过去！\n"NOR,who,enemy[i]);
	message_vision(HIG"［火龙吐炎符］！\n\n"NOR,who);
	if( random(enemy[i]->query("magic_defense"))< random(700) )
			enemy[i]->receive_wound("kee", mwp,who);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

int heal_up()
{
	object jgguard=this_object();
	if( !present((string)jgguard->query("player_guard"),environment(jgguard)) 
		&& environment(jgguard)->query("outdoors")!="taoyuan")
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "发出一阵嘎嘎的响声，一股焦烟升了起来。\n\n"
		 "焦烟越来越浓，很快将" + name() + "化为了灰烬......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

