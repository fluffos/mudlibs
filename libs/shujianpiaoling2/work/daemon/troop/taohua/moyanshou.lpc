//法术：［刃风符］ 属性：wind  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("魔岩兽", ({ "moyanshou", "jiguan guard" }) );
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("jgguard", "jgguard18");
 	set("jgguard_level", 18);
	set("magic_power", 3000);
 	set("jgguard_attrib", "兽类");

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("max_mana", 500);
	set("mana", 1000);

        set("limbs", ({ "头部", "身体", "爪子", "尾巴" }) );
        set("verbs", ({ "claw" }) );
 
        set("combat_exp", 1000000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy,mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if (!objectp(present("wind god", environment(who))))
	{
		mygod = new("/daemon/troop/maoshan/windgod");
		message_vision(HIC"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,who,enemy[i]);
		message_vision(HIC"\n不久只见四周狂风大作，风声呜呜作响，吹得人气也喘不过来。"NOR,who,enemy[i]);
		message_vision(HIC"\n随着大风愈刮愈烈，风神的身影渐渐在半空中浮现出来。\n"NOR,who,enemy[i]);
		message_vision(HIG"［祭风符］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
	return 1;
	}
	message_vision(HIR"\n$N发出一声兽吼，只见其背上的岩石中腾起一股旋风，风越"NOR,who,enemy[i]);
	message_vision(HIR"\n转越快，好似刀刃般朝$n刮了过来！\n"NOR,who,enemy[i]);
	message_vision(HIG"［刃风符］！\n\n"NOR,who);
	if( random(enemy[i]->query("magic_defense"))< random(500) )
			enemy[i]->receive_wound("kee", mwp);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

int heal_up()
{
	object jgguard=this_object();
	if( !present((string)jgguard->query("player_guard"),environment(jgguard)) 
		&& environment(jgguard)->query("outdoors")!="taoyuan")
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "发出一阵嘎嘎的响声，一股焦烟升了起来。\n\n"
		 "焦烟越来越浓，很快将" + name() + "化为了灰烬......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

