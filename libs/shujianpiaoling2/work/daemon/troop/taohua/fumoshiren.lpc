//法术：［动地咒］ 属性：attack  对象：all  克星：无
//法术：［分身术］ 属性：召唤  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("伏魔石人", ({ "fumoshiren", "jiguan guard","fumo shiren" }) );
	set("gender", "男性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("jgguard", "jgguard30");
 	set("jgguard_level", 30);
	set("magic_power", 3000);
 	set("jgguard_attrib", "人类");

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("max_mana", 500);
	set("mana", 1000);

        set("combat_exp", 1000000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );
	set_temp("super_damage",86400*7);

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy,mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if (!objectp(present("fumo shiren", environment(who))))
	{
		mygod = new("/daemon/troop/taohua/fumoshiren");
		message_vision(HIC"\n$N身体一晃，转眼间变出另一个一模一样的$N，一齐朝$n发动攻击！\n"NOR,who,enemy[i]);
		message_vision(HIG"［分身术］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		mygod->kill_ob(enemy[i]);
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
	return 1;
	}
	message_vision(HIR"\n$N喃喃念动咒语，突然间将手中巨石朝地下一撞，登时轰隆"NOR,who,enemy[i]);
	message_vision(HIR"\n一声巨响，山摇地动，地上骤然裂开了口子。\n"NOR,who,enemy[i]);
	message_vision(HIG"［动地咒］！\n\n"NOR,who);
	if( random(enemy[i]->query("magic_defense"))< random(800) )
			enemy[i]->receive_wound("kee", mwp,who);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

int heal_up()
{
	object jgguard=this_object();
	if( !present((string)jgguard->query("player_guard"),environment(jgguard)) 
		&& environment(jgguard)->query("outdoors")!="taoyuan")
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "发出一阵嘎嘎的响声，一股焦烟升了起来。\n\n"
		 "焦烟越来越浓，很快将" + name() + "化为了灰烬......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

