// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［残影击］ 属性：attack  对象：all  克星：无
//法术：［踏风步］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("傀儡剑客", ({ "kljianke", "jiguan guard" }) );
	set("gender", "男性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("jgguard", "jgguard24");
 	set("jgguard_level", 24);
	set("magic_power", 3000);
 	set("jgguard_attrib", "人类");

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("max_mana", 500);
	set("mana", 1000);

        set("combat_exp", 1000000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );
	set_temp("super_damage",86400*7);

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( who->query("kee") < who->query("max_kee")*3/4 )
	{
	message_vision(HIC"\n$N双脚轻点，身体竟然平地而起，宛若无物般飘在半空，"NOR,who,enemy[i]);
	message_vision(HIC"\n踏风而行。\n"NOR,who,enemy[i]);
	message_vision(HIG"［踏风步］！\n\n"NOR,who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
	if( who->query("mana") >= 50 )
	who->add("mana", -50);
	COMBAT_D->report_status(who,1);
	 return 1;
	}
	message_vision(HIR"\n$N信手拈来一柄长剑，剑光杂乱无章地一阵挥舞，剑光中一道"NOR,who,enemy[i]);
	message_vision(HIR"\n残缺的剑影突然飞出，直落到$n咽喉！！\n"NOR,who,enemy[i]);
	message_vision(HIG"［残影击］！\n\n"NOR,who);
	if( random(enemy[i]->query("magic_defense"))< random(500) )
			enemy[i]->receive_wound("kee", mwp,who);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

int heal_up()
{
	object jgguard=this_object();
	if( !present((string)jgguard->query("player_guard"),environment(jgguard)) 
		&& environment(jgguard)->query("outdoors")!="taoyuan")
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "发出一阵嘎嘎的响声，一股焦烟升了起来。\n\n"
		 "焦烟越来越浓，很快将" + name() + "化为了灰烬......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

