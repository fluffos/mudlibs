//法术：［妖灯聚］ 属性：召唤  对象：all  克星：无
//法术：［机关修复术］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("机关鬼灯", ({ "jgguideng", "jiguan guard" }) );
	set("gender", "男性");
	set("age", 30);
        set("attitude", "peaceful");

 	set("jgguard", "jgguard21");
 	set("jgguard_level", 21);
	set("magic_power", 3000);
 	set("jgguard_attrib", "物类");

	set("str", 42);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("max_mana", 500);
	set("mana", 1000);

        set("combat_exp", 1000000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy,mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( who->query("kee") < who->query("max_kee")*3/4 )
	{
	message_vision(HIC"\n$N腾出一只手，变出了钉子、锤子、螺丝刀等工具，迅速将"NOR,who,enemy[i]);
	message_vision(HIC"\n自己被损坏的部件修理了起来。\n"NOR,who,enemy[i]);
	message_vision(HIG"［机关修复术］！\n\n"NOR,who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
	if( who->query("mana") >= 50 )
	who->add("mana", -50);
	COMBAT_D->report_status(who,1);
	 return 1;
	}
	if (!objectp(present("yaodenggui", environment(who))))
	{
		mygod = new("/daemon/troop/maoshan/yaodenggui");
		message_vision(HIC"\n$N点起两盏鬼灯，只见灯光忽幽忽明，朦胧中妖灯鬼的身影"NOR,who,enemy[i]);
		message_vision(HIC"\n显现了出来，向$n发起了骤然攻击！\n"NOR,who,enemy[i]);
		message_vision(HIG"［妖灯聚］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		mygod->kill_ob(enemy[i]);
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
	return 1;
	}

		}
	}
	return 1;
}

int heal_up()
{
	object jgguard=this_object();
	if( !present((string)jgguard->query("player_guard"),environment(jgguard)) 
		&& environment(jgguard)->query("outdoors")!="taoyuan")
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "发出一阵嘎嘎的响声，一股焦烟升了起来。\n\n"
		 "焦烟越来越浓，很快将" + name() + "化为了灰烬......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

