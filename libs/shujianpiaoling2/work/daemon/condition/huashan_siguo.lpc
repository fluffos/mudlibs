// huashan_siguo.c

#include <ansi.h>
#include <login.h>

int update_condition(object me, int duration)
{
	int num = (int)me->query("int",1);
	if (duration < 1) {
		me->delete("marks/面壁");
		me->delete("disable_type");
		tell_object(me, HIY "只听华山弟子说道：思过已毕，你可以下去了！\n" NOR);
		tell_object(me,"你从思过崖上走了下去。\n");
		me->set("startroom", START_ROOM);
		me->move("/u/yanzi/huashan/xiaoj4");
		message("vision",HIY "只见" + me->name() + 
		"从思过崖上走了下来，想是刚刚思过好吧。\n" NOR, environment(me), me);
		return 0;
	}
	me->set("disable_type",HIG "<思过中>" NOR);
	me->apply_condition("huashan_siguo", duration - 1);
	me->start_busy(20);

	if(random(5) < 1 ){
		tell_object(me,"你静心思过，似乎略有所悟。\n");
		tell_object(me,HIC"你的杀气降低了！\n"NOR);
			if ((int)me->query("bellicosity",1) - 200 < 0)
				me->set("bellicosity",0);
			me->add("bellicosity", -200);
//		return 1;
	}
	else if (random(5) < 2){
		tell_object(me,"你静心思过，对武学之道略有所悟。\n");
		tell_object(me,HIC"你的潜能增加了！\n"NOR);
		me->add("potential",2 + random(num/2));
//		return 1;
	}
	else if (random(5) < 3){
		tell_object(me,"你静心思过，对武学之道略有所悟。\n");
		tell_object(me,HIC"你的经验增加了！\n"NOR);
		me->add("combat_exp",100 + random(num));
//		return 1;
	}
	else if (random(5) < 4){
		tell_object(me,"你静心思过，对武学之道略有所悟。\n");
		tell_object(me,HIC"你的潜能与经验增加了！\n"NOR);
		me->add("potential",2 + random(num/2));
		me->add("combat_exp",100 + random(num));
//		return 1;
	}
	else {
		tell_object(me,"你企图面壁思过，但无法静下心来。\n");
//		return 1;
	}
	return 1;
}
