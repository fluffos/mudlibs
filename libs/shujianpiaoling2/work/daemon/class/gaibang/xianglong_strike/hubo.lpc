//双龙互搏
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void brave_up(object me, object target);
void stop_atk(object me);
int perform(object me, object target) {
  int skill;
  if ((int)me->query_temp("hubo"))
    return notify_fail("你已经在施展［双龙互搏］了。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［双龙互搏］只能对战斗中的对手使用。\n");
  skill = me->query_skill("xianglong_strike", 1);
  if (skill <= 90) return notify_fail("你的降龙十八掌还不够纯熟！\n");
  if ((int)me->query_skill("force") < 50)
    return notify_fail("你的内功心法不够高！\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够。\n");
  message_vision(RED "$N使出降龙十八掌的绝招［双龙互搏］，刹那间一人化二，双手同时使出不同的招式！\n" NOR, me, target);
  me->set_temp("hubo", 1);
  me->add("force", -120);
  me->start_busy(1);
  call_out("brave_up", 1, me, target);
  call_out("brave_up", 10, me, target);
  call_out("brave_up", 20, me, target);
  call_out("brave_up", 30, me, target);
  call_out("brave_up", 40, me, target);
  call_out("brave_up", 50, me, target);
  call_out("brave_up", 60, me, target);
  call_out("brave_up", 70, me, target);
  call_out("brave_up", 80, me, target);
  call_out("stop_atk", 90, me);
  return 1;
}

void brave_up(object me, object target) {
  int extradm;
  string msg;
  //	if( !target ) target = offensive_target(me);
  if (!target || !me
    || !target->is_character()
    || !me->is_fighting(target))
    return;

  if (me->query("marks/baishinan") && random(9) < 3 && (int)target->query_skill(
    "siri_force",
    1
  ) < 100) {
    msg = HIR "\n$N突然施展出帮主绝迹真传，左手降龙掌使一招「亢龙有悔」，右手一招「见龙在田」，\n
双掌合而为一又是一招「震惊百里」，$n只觉四周涌来无形巨力，难以招架，被重重击中全身！\n" NOR;
    message_vision(msg, me, target);
    extradm = (int)me->query_skill("xianglong_strike") * 3 + (int)me->query("force_factor");
    target->receive_wound("kee", extradm, me);
    COMBAT_D->report_status(target, 1);
    me->start_busy(1);
    return;
  }

  target->add_temp("apply/iron-cloth", -200);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  msg = YEL "\n左手降龙掌力掠过，$N只觉劲风拂面，不由自主倒退了几步。\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_damage("kee", 20, me);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
  msg = YEL "\n右手降龙掌力掠过，$N只觉呼吸急迫，身不由己倒退了几步。\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_damage("kee", 20, me);
  target->add_temp("apply/iron-cloth", 200);

  me->start_busy(1);
}
void stop_atk(object me) {
  if (!me) return;
  me->delete_temp("hubo");
  tell_object(me, RED "你的［双龙互搏］施展完毕，龙形身法在一瞬间消失了。\n" NOR);
  me->start_busy(1);
}
