#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target, int damage)

{
  string msg;
  int extra, i, p;
  object ob, *obs, weapon;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［七星聚会］只能对战斗中的对手使用。\n");
  if (!pointerp(obs = me->query_team()) || !me->is_team_leader())
    return notify_fail("只有队伍领袖才可以发动此式！\n");
  if (sizeof(obs) >= 5)
    return notify_fail("[七星聚会]最多只能有五个人共同施展！！\n");
  if (sizeof(obs) < 2)
    return notify_fail("[七星聚会]最少要有二个人才能施展！！\n");

  for (i = 0; i < sizeof(obs); i++) {
    if (!obs[i]) return notify_fail("你需要重新组合队伍。\n");
    if (environment(obs[i]) != environment(me)) return notify_fail("你无法组队。\n");
    if (!obs[i]->query_skill("sanhuajuding") < 120) return notify_fail("队伍中有人三花聚顶掌法火侯不够。\n");
    if (!obs[i]->query_skill("unarmed") < 120) return notify_fail("队伍中有人掌法跟基不够。\n");
    if (objectp(ob = obs[i]->query_temp("weapon"))) return notify_fail("队伍中有人装备着兵器！\n");
    if (obs[i]->query_skill_mapped("unarmed") != "sanhuajuding") return notify_fail("队伍中有人没有使用三花聚顶掌法！\n");
    if (!obs[i]->query("force") < 200) return notify_fail("队伍中有人真气不济。\n");
  }

  message_vision(HIR + "\n\n$N大喝一声：七星聚会！\n只见每个人一闻呼喝，并肩而立，或出右掌，或出左掌，每人之力归并为一。\n" NOR, me);

  for (i = 1; i < sizeof(obs); i++) {

    ob = obs[i]->query_temp("weapon");
    extra = obs[i]->query_skill("unarmed");
    extra *= (i + 1);
    obs[i]->add_temp("apply/attack", extra);
    obs[i]->add_temp("apply/damage", extra);
    msg = HIY "\n众人起心，其利断金。\n" NOR;
    COMBAT_D->do_attack(obs[i], target, ob, TYPE_REGULAR, msg);
    obs[i]->kill_ob(target);
    obs[i]->add_temp("apply/attack", -extra);
    obs[i]->add_temp("apply/damage", -extra);
    obs[i]->start_busy(3);

  }
  //     message_vision(HIY"\n$N吟道：手握灵珠常奋笔，心开天簌不吹箫！天罡北斗阵散了开来。\n"NOR,me);  
  return 1;
}
