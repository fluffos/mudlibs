// 七星连心

#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  int extra;
  if (me->is_fighting())
    return notify_fail("战斗中练“七星连心”，找死吗。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if ((int)me->query("force") - (int)me->query("max_force") < 50)
    return notify_fail("你的真气不够。\n");

  if ((int)me->query("eff_kee") < (int)me->query("max_kee") / 3)
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险。\n");

  extra = me->query_skill("daoxue-xinfa", 1);
  if (extra < 20) return notify_fail("你的［道学心法］还不够高！\n");

  if (!target) target = me;
  if (me->query_temp("qz/lianqx")) {
    extra = me->query_temp("qz/lianqx");
    if (extra > me->query_skill("qixing-huanwei", 1) / 10)
      return notify_fail("你已经达到你所能练的最高境界了！\n");
  }
  message_vision(HIC "\n$N身形几个起伏，按北斗七星的方位走起圈来。\n" NOR, me);
  message_vision(HIC "$N走的圈子越绕越快，突然间一个急停，止住了步伐。\n\n" NOR, me);
  write(CYN "你的“七星连心”进步了。\n" NOR);
  me->add("force", -70);
  me->add_temp("qz/lianqx", 1);
  me->start_busy(1);
  return 1;
}
