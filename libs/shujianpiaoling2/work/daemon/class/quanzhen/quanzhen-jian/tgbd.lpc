#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string *msg_style = ({
  HIR "\n$N吟道：一柱行窝几十年！\n" NOR,
  HIR "\n$N吟道：蓬头长日走如颠！\n" NOR,
  HIR "\n$N吟道：海棠亭下重阳子！\n" NOR,
  HIR "\n$N吟道：练叶舟中太乙仙！\n" NOR,
  HIR "\n$N吟道：无物可离虚壳外！\n" NOR,
  HIR "\n$N吟道：有人能悟未生前！\n" NOR,
  HIR "\n$N吟道：出门一笑无拘碍！\n" NOR,
  HIR "\n$N吟道：云在西湖月在天！\n" NOR,
  //"\n！\n"NOR,
});
int perform(object me, object target, int damage) {
  string msg;
  int extra, i, p;
  object ob, *obs, weapon;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［天罡北斗阵］只能对战斗中的对手使用。\n");
  if (!pointerp(obs = me->query_team()) || !me->is_team_leader())
    return notify_fail("只有队伍领袖才可以发动此阵！\n");
  if (sizeof(obs) < 2)
    return notify_fail("[天罡北斗阵]必须有二个人才行！！\n");
  if (sizeof(obs) > 7)
    return notify_fail("[天罡北斗阵]最多只能有七人！！\n");

  for (i = 0; i < sizeof(obs); i++) {
    if (!obs[i]) return notify_fail("你需要重新组合队伍。\n");
    if (environment(obs[i]) != environment(me)) return notify_fail("你无法组队。\n");
    if (!obs[i]->query_skill("quanzhen-jian")) return notify_fail("队伍中有人不会全真剑法。\n");
    if (!objectp(ob = obs[i]->query_temp("weapon"))) return notify_fail("队伍中有人没有兵器！\n");
    if (ob->query("skill_type") != "sword") return notify_fail("队伍中有人没有用剑！\n");
    if (obs[i]->query_skill_mapped("sword") != "quanzhen-jian") return notify_fail("队伍中有人没有使用全真剑法！\n");
    if (!obs[i]->query("force") < 200) return notify_fail("队伍中有人真气不济。\n");
  }

  message_vision(HIR + "\n$N大喝一声，布天罡北斗阵\n\n$N的对员，心领神会，慢慢分散，立时发动了天罡北斗阵！\n\n" NOR, me);

  for (i = 0; i < sizeof(obs); i++) {

    ob = obs[i]->query_temp("weapon");
    extra = obs[i]->query_skill("sword");
    extra *= (i + 1);
    obs[i]->add_temp("apply/attack", extra);
    obs[i]->add_temp("apply/damage", extra);
    msg = msg_style[random(sizeof(msg_style))];
    COMBAT_D->do_attack(obs[i], target, ob, TYPE_REGULAR, msg);
    obs[i]->kill_ob(target);
    obs[i]->add_temp("apply/attack", -extra);
    obs[i]->add_temp("apply/damage", -extra);
    obs[i]->start_busy(3);

  }
  message_vision(HIY "\n$N吟道：手握灵珠常奋笔，心开天簌不吹箫！天罡北斗阵散开！\n" NOR, me);
  return 1;
}
