// 奇门五转
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  extra = me->query_skill("five-spin", 1);
  if (extra < 40) return notify_fail("你的［奇门五转］还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［天地五转］只能对战斗中的对手使用。\n");
  if (me->query_skill_mapped("force") != "jzxj-force")
    return notify_fail("奇门五转必须配合甲子玄机心法使用。\n");
  if (userp(me) && me->query_temp("kt/fivespin") <= 0) return notify_fail(CYN "\n你还没有到施展［天地五转］的境界！\n\n");
  if (target->is_busy())
    return notify_fail(target->name() + "已经手忙脚乱了！\n");
  message_vision(HIR "$N施展［天地五转］，脚踩连环，环绕着$n转个不停！\n" NOR, me, target);
  if ((int)target->query_skill("piaoxiang-steps") > (int)me->query_skill("five-spin")) {
    message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
    return 1;
  }
  extra = me->query_temp("kt/fivespin");
  if (random((int)target->query("combat_exp")) < (int)me->query("combat_exp")) {
    message_vision(HIR "结果$N被扰得眼花潦乱，接应不暇！\n" NOR, target);
    target->start_busy(extra);
    me->start_busy(1);
  } else {
    message_vision(HIR "结果$N自己转了个头晕眼花！\n" NOR, me);
    me->start_busy(2);
  }
  me->add_temp("kt/fivespin", -1);
  return 1;
}
