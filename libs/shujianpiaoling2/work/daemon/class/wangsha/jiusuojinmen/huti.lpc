//护身罡气 written by john darks
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void del_gangqi(object me, int amount, int str, int extra);
int perform(object me, object target) {
  int skill, str, extra;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target)) target = me;

  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("tianhu/gangqi"))
    return notify_fail("你已经发动了罡气！！\n");
  skill = me->query_skill("jiusuojinmen");
  if (skill < 110)
    return notify_fail("你的九锁金门太差了！\n");
  skill = random(skill) + skill;
  str = target->query("force_factor");
  str = str * str / 10;
  me->add("force", -100);
  message_vision(HIY "$N" + HIY "低喝一声，一股无比强大的气劲突然爆发出来，“呼”的一声，成环状散开！！\n" NOR, me);
  message_vision(HIY "这股罡气在$N" + HIY "身周形成一道气墙，令他人难以越近！！\n" NOR, me);
  me->add_temp("apply/iron-cloth", skill);
  me->add_temp("apply/extra_fle", str);
  if ((string)me->query_skill_mapped("dodge") == "jl-shibagua") {
    extra = (int)me->query_skill("dodge") / 2;
    me->add_temp("apply/defense", extra);
    me->set_temp("tianhu/dodge", 1);
  } else if ((string)me->query_skill_mapped("parry") == "sanshoubapu") {
    extra = (int)me->query_skill("parry") / 2;
    me->add_temp("apply/parry", extra);
    me->set_temp("tianhu/parry", 1);
  }
  me->set_temp("tianhu/gangqi", 1);
  me->start_call_out((: call_other, __FILE__, "del_gangqi", me, skill, str, extra :),
    skill / 5);
  if (me->is_fighting()) me->start_busy(3);
  return 1;
}

void del_gangqi(object me, int amount, int str, int extra) {
  if (me->query_temp("tianhu/gangqi")) {
    write(HIY "你收起了护身罡气！！\n" NOR);
    message("vision", HIY + me->name() + HIY "吸了口气，护身罡气突然消失！！\n" NOR, environment(me), me);
    if (me->query_temp("tianhu/dodge")) {
      me->set_temp("tianhu/dodge", 0);
      me->add_temp("apply/defense", -extra);
    }
    if (me->query_temp("tianhu/parry")) {
      me->set_temp("tianhu/parry", 0);
      me->add_temp("apply/parry", -extra);
    }
    me->add_temp("apply/extra_fle", -str);
    me->add_temp("apply/iron-cloth", -amount);
    me->delete_temp("tianhu/gangqi");
  }
}
