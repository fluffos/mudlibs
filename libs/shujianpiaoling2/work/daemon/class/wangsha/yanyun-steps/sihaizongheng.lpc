//四海纵横  written by john darks

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, level, i;
  extra = me->query_skill("yanyun-steps") / 5;
  level = me->query_skill("dodge") / 40 + 1;
  if (extra < 10) return notify_fail("你的［烟云缥缈步法］还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［四海纵横］只能对战斗中的对手使用。\n");
  message_vision(HIW "$N" + HIW "身形突然飘逸起来，如秋风中的落叶，如急涛中的扁舟！\n" NOR, me, target);
  message_vision(HIW "既有无尽的肃杀之气，又有纵横四海的潇洒！！\n\n" NOR, me, target);
  if (random(me->query("combat_exp") * level) > (int)target->query("combat_exp")) {
    if (random(2)) {
      message_vision(HIR "$N围住$n，结果$n" + HIR "被攻得大惊失色，手忙脚乱！\n" NOR, me, target);
      target->start_busy(4);
    } else if (extra > 20) {
      msg = HIY "$N" + HIY "围住$n" + HIY "施展烟云缥缈步中的绝技——旋风腿！\n" NOR;
      message_vision(msg, me, target);
      for (i = 1; i < extra / 6; i++) {
        msg = HIR "\n$N攻出第" + chinese_number(i) + "腿！\n" NOR;
        message_vision(msg, me, target);
      }
      msg = HIR "最后再一腿！" NOR;
      me->add_temp("apply/attack", extra * 2);
      me->add_temp("apply/damage", extra);
      COMBAT_D->do_attack(me, target, 0, TYPE_REGULAR, msg, "瘀伤");
      me->add_temp("apply/attack", -extra * 2);
      me->add_temp("apply/damage", -extra);
      me->start_busy(2);
    } else {
      message_vision(HIY "但是$N" + HIY "并不慌张！\n" NOR, target);
      me->start_busy(2);
    }
  } else {
    message_vision(HIY "但是$N" + HIY "并不慌张！\n" NOR, target);
    me->start_busy(2);
  }
  return 1;
}
