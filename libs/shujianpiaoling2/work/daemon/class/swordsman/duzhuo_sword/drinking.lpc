// 劝君更饮千杯酒

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg, wn;
  int extra;
  object weapon;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［劝君更饮千杯酒］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("duzhuo_sword", 1) / 4;
  if (extra < 25) return notify_fail("你的独酌剑法还不够熟练！\n");
  if (me->query("force") < 150) return notify_fail("你的内力不足！\n");
  if (!present("wineskin", me))
    return notify_fail("你还需要一只酒袋，才能施展［劝君更饮千杯酒］这招。\n");
  wn = weapon->query("name");
  //	me->add_temp("apply/attack", extra);	
  me->add_temp("apply/damage", extra);
  target->add_temp("apply/iron-cloth", -extra * 4);

  msg = HIR "$N将手中" + wn + HIR "托住酒袋，内力一吐，竟然逼出一股酒剑向$n喷去！" NOR;
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  if (!target->query_condition("drunk"))
    target->apply_condition("drunk", (int)me->query_skill("duzhuo_sword") / 5);
  me->add_temp("apply/damage", -extra);
  target->add_temp("apply/iron-cloth", extra * 4);
  me->add("force", -100);
  me->start_busy(1);
  return 1;
}
