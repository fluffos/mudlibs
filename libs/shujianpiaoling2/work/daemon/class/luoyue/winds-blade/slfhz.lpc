// 饮风浴火咒

#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  int extra;
  object weapon;
  if (me->is_fighting())
    return notify_fail("战斗中念“饮风浴火咒”，找死吗。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if ((int)me->query("force") - (int)me->query("max_force") < 50)
    return notify_fail("你的真气不够。\n");

  if ((int)me->query("eff_kee") < (int)me->query("max_kee") / 3)
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险。\n");

  extra = me->query_skill("winds-blade", 1);
  if (extra < 20) return notify_fail("你的［十里狂刀］还不够高！\n");
  weapon = me->query_temp("weapon");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你没使用刀，不能念 [饮风浴火咒] 。\n");

  if (!target) target = me;
  extra = me->query_temp("tianbian/fhz");
  if (extra && (extra - 1 > me->query_skill("winds-blade", 1) / 10))
    return notify_fail("你已经念过 [饮风浴火咒] 了！\n");

  message_vision(HIC "\n$N双手托刀，喃喃地念起 [饮风浴火咒] 来。\n" NOR, me);
  if (extra && (extra > me->query_skill("winds-blade", 1) / 10))
    message_vision(HIR "\n$N的刀上渐渐发热变红，突然“扑哧”一声冒起火来！\n\n" NOR, me);
  me->add("force", -70);
  me->add_temp("tianbian/fhz", 1);
  me->start_busy(1);
  return 1;
}
