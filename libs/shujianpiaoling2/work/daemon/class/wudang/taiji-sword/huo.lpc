// 火凤凰符  baiwt@sjpl 5,25,2000

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  int i, extra;
  object *inv;
  object weapon, mygod, paper;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if (!target) target = offensive_target(me);
  seteuid(geteuid(me));

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［火凤凰符］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("taiji-sword", 1);
  if (extra < 80)
    return notify_fail("你的［太极剑法］还不够。\n");
  if (me->query_skill("taiji-force", 1) < 50)
    return notify_fail("你的［太极神功］还不够。\n");
  if (!me->query_skill("taiji-ken", 1))
    return notify_fail("你没有学会太极拳。\n");
  if (!objectp(present("paper seal", me)))
    return notify_fail("你没有桃符纸，无法施展符术。\n");
  if ((int)me->query("force") <= 60)
    return notify_fail("你的内力不够。\n");

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if ((string)(inv[i]->query("id")) != "paper seal")
      continue;
    if ((string)(inv[i]->query("id")) == "paper seal")
      inv[i]->add_amount(-1);
  }

  if (!objectp(present("fire god", environment(me)))) {
    mygod = new("/daemon/troop/maoshan/firegod2");
    message_vision(RED "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, me, target);
    message_vision(RED "\n不久只见空中热气翻腾，火光乍现，眨眼间满地升起熊熊燃烧的火焰，" NOR, me, target);
    message_vision(RED "\n火光中忽然飞出一只火凤凰，在半空盘旋飞舞。\n" NOR, me, target);
    message_vision(HIG "\n［火凤凰符］！\n\n" NOR, me, target);
    mygod->move(environment(me));
  } else {
    message_vision(CYN "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, me, target);
    message_vision(CYN "\n过了一会符纸便落了下来。\n\n" NOR, me, target);
  }
  if (me->query("force") >= 10)
    me->add("force", -10);
  me->start_busy(1);
  return 1;
}
