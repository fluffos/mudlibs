//大挪移
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, other;
  object weapon, room;
  extra = me->query_skill("yixing_huanwei", 1);
  if (extra < 70) return notify_fail("你的［移形换位术］还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［大挪移］只能对战斗中的对手使用。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "已经不知所措了！\n");
  message_vision(CYN "$N看上去丝毫未动，身形却陡然移后了数十尺！\n" NOR, me, target);

  if ((int)target->query_skill("bixueforce", 1) > (int)me->query_skill("yixing_huanwei")) {
    message_vision(CYN "\n但是$n神定气闲，一眼就看破了$N的方位！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("five-steps") > (int)me->query_skill("yixing_huanwei")) {
    message_vision(CYN "\n但是$n脚步沉稳，丝毫不乱地跟上了$N！\n" NOR, me, target);
    return 1;
  }

  if (userp(me))
    extra = (int)(me->query("combat_exp") + me->query("p_power_rank"));
  else extra = (int)(me->query("combat_exp"));
  if (userp(target))
    other = (int)(target->query("combat_exp") + target->query("p_power_rank"));
  else other = (int)(target->query("combat_exp"));

  if (random(other) < extra) {
    room = environment(me);
    me->move("/daemon/class/lama/space.lpc");
    me->move(room);
    target->start_busy(3);
  } else {
    msg = "$N如影随形般跟上了$n，向$n迅然攻击！";
    COMBAT_D->do_attack(target, me, target->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  return 1;
}
