//摔碑手
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int myexp,yourexp,lvl;
	object weapon;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［摔碑手］只能对战斗中的对手使用。\n");
        if((int)me->query_skill("blood_strike") < 30 )
                return notify_fail("你的大藏掌血印手不够高！\n");
	if( (int)me->query("force") < 200 )
		return notify_fail("你的内力太差了，无法施展摔碑手。\n");
	weapon = me->query_temp("weapon");
	myexp = (int) me->query("combat_exp");
	yourexp = (int) target->query("combat_exp");
	lvl = (int) me->query_skill("blood_strike") / 10 + 1;
	msg = HIR "$N双手突然抓向$n的手腕脉门！" NOR;
	if( random(myexp * lvl) > yourexp )
	{
		message_vision(msg + "\n", me, target);
		msg = RED"$N奋起神力，竟然将$n抡了起来，结果$n被$N重重摔了个四脚朝天！\n"NOR;
		message_vision(msg, me, target);
		target->move(me);
		target->move(environment(me));
		target->receive_damage("kee", lvl*5 + random(100));
		target->start_busy(3);
		me->add("force",-100);
		me->start_busy(1);
	}
	else
		        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
			me->start_busy(2);
	return 1;
}
