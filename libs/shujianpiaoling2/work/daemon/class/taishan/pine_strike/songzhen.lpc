//松针索

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［松针索］只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	extra = me->query_skill("pine_strike",1) / 10;
	if ( extra < 10) return notify_fail("你的碧针清掌法还不够纯熟！\n");
	msg = HIG "$N双掌一抖，刹那间掌力化做无数细针般的内劲向$n飞射过去！" NOR;
	if(target->query_skill("iron-cloth",1)&&target->query_skill("iron-cloth") < random(me->query_skill("unarmed")*2) )
	{
	message_vision(msg,me,target);
	message_vision(HIR"\n结果$N强大的内劲摧破了$n的真元！\n" NOR, me,target);
	target->receive_wound("kee", (int)me->query_skill("pine_strike",1)*3);
	COMBAT_D->report_status(target,1);
	me->start_busy(2);
	return 1;
	}
	target->add_temp("apply/defense", -extra);	
	target->add_temp("apply/dodge", -extra);
	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	target->add_temp("apply/defense", extra);
	target->add_temp("apply/dodge", extra);
	me->start_busy(2);
	return 1;
}
