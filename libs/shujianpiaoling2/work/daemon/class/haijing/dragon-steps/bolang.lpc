//追波逐浪（游龙身法）（游泳术）    created by baiwt@sjpl  12,17,1999
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void run_away(object me, object target);
void dive_water(object me, object target);
int perform(object me, object target)
{
	string msg;
	int skill;
	if( (int)me->query_temp("haijing/bolang") ) 
		return notify_fail("你已经在施展［追波逐浪］了。\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［追波逐浪］只能对战斗中的对手使用。\n");
	if ( me->query_skill("dragon-steps",1) < 50) return notify_fail("你的游龙身法还不够纯熟！\n");
	if ( me->query_skill("swimming",1) < 50) return notify_fail("你的游泳术还不够纯熟！\n");
	if ( me->query_skill("diving",1) < 20) return notify_fail("你的水下功夫还不够纯熟！\n");
	if( (int)me->query("force") < 100  ) 
		return notify_fail("你的内力不够。\n");
        if( me->query_skill_mapped("force") != "dragonforce" )
                return notify_fail("［追波逐浪］必须配合潜龙护宝心法使用。\n");
        if( me->query_skill_mapped("dodge") != "dragon-steps" )
                return notify_fail("［追波逐浪］必须配合游龙身法使用。\n");

	if ( !userp(target))
	{
	msg = HIR  "$N一个鲤鱼翻身，迅捷无比地向$n踢出“鲤鱼摆尾腿”！" NOR;
	COMBAT_D->do_attack(me,target, 0, TYPE_REGULAR,msg,"瘀伤");
	me->add("force", -50);
	me->start_busy(1);
	return 1;
	}

	message_vision(CYN"只见$N身形一晃，迅速往远处遁去！\n" NOR, me);
	message_vision(CYN"$n喝道：“往哪里走！”紧随$N之后追了过去。\n" NOR, me,target);
	me->set_temp("haijing/bolang", 1);
	me->add("force", -100);
	me->start_busy(1);
	me->remove_all_killer();
	me->move("/daemon/class/haijing/swimroad");
	target->move("/daemon/class/haijing/swimroad");
	target->start_busy(2);
        call_out("run_away", 1, me, target);
        call_out("run_away", 2, me, target);
        call_out("run_away", 3, me, target);
        call_out("dive_water", 4, me, target);
	return 1;
}

void run_away(object me, object target)
{
	if( !target || !me
	||	!target->is_character())  return;
	me->move("/daemon/class/haijing/swimroad");
	target->move("/daemon/class/haijing/swimroad");
//	target->set_temp("apply/composure",100);
}
void dive_water(object me, object target)
{
	if( !target || !me
	||	!target->is_character())  return;

	message_vision(CYN"眼前忽然出现一条宽阔的大江，$N纵身跃起，一个猛子扎入了水中！\n" NOR, me);
	message_vision(CYN"$n不由自主紧跟着$N跳了下去。\n" NOR, me,target);
	me->delete_temp("haijing/bolang");
	me->move("/daemon/class/haijing/swimpool");
	target->move("/daemon/class/haijing/swimpool");
	me->start_busy(1);
	target->start_busy(1);
}
