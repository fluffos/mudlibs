int pull_down(string arg)
{
	int woundp;
	object me,target;
	me = this_player();
	if( !arg )  return notify_fail("你要将谁拖入水中？\n");
	if (!present(arg, environment(me)))
	return notify_fail("这里没有这个人。\n");
	target = present(arg, environment(me));
	if( !target->is_character() || target->is_corpse() )
		return notify_fail("你无法拖"+target->query("name")+"下水。\n");
	woundp = (me->query_skill("diving",1)+me->query_skill("swimming",1));
	if( woundp < 20 )
		return notify_fail("你根本不会水下功夫。\n");
	if( me->query("gin") < 30 )
		return notify_fail("你已经精疲力尽，在水里扑腾不动了。\n");
	if( me->is_busy() )
		return notify_fail("( 你正忙着在水里扑腾呢。)\n");

	message_vision(CYN"\n$N吸一口气，钻入了水里，抓住$n的双脚，用力往江底拖去！\n\n"NOR, me,target);

	if( (random(woundp)+10) < target->query_skill("damo-force",1)*2 && target->query_skill_mapped("force") == "damo-force"  )
	{
	message_vision(CYN"$n神色不变，默运“达摩闭息功”，摒住了呼吸！\n"NOR, me,target);
	message_vision(CYN"$n在水里任$N如何拖拽，总是能几个沉浮之后又漂了上来！\n"NOR, me,target);
	message_vision(WHT"随着$n护体神功全身充盈，竟然发出一股气墙将四周水波推了开去！\n\n"NOR, me,target);
	COMBAT_D->report_status(target,1);
	me->receive_damage("gin", random(20)+10);
	me->start_busy(2);
	return 1;
	}

	else if( (random(woundp)+10) > (target->query_skill("diving",1)+target->query_skill("swimming",1)) )
	{
	message_vision(CYN"$n顿时手足无措，又咸又浊的江水一个劲地往嘴巴、鼻孔、耳朵等处灌了进去！\n"NOR, me,target);
	message_vision(CYN"$n在水里拼命挣扎，想浮出江面，没料到$N一个翻身，又将$n的头按了下去！\n"NOR, me,target);
	message_vision(HIR"$n感到身体不断下沉，一颗心也沉了下去。。。\n\n"NOR, me,target);
	target->receive_wound("kee", random(woundp)+10);
	COMBAT_D->report_status(target,1);
	me->receive_damage("gin", random(20)+10);
	me->start_busy(1);
	target->start_busy(2);
	return 1;
	}
	else
	message_vision(CYN"$n一个鲤鱼翻身，竟然从$N双手脱了出来，反手抱住$N往江底摔去！\n"NOR, me,target);
	me->receive_wound("kee", random(20)+2);
	COMBAT_D->report_status(me,1);
	me->start_busy(2);
	message_vision(CYN"\n$N和$n各自施展水下功夫，犹如两条鲨鱼般在水里酣斗！\n"NOR, me,target);
	target->receive_wound("kee", random(20)+2);
	COMBAT_D->report_status(target,1);
	target->start_busy(2);
	return 1;
}

int close_cmds(object me, string arg)
{
	write("你现在忙得很，没有办法顾及其他事情。\n");
	return 1;
}
int valid_leave(object me, string dir)
{
        if( dir=="up" && !me->query_skill("diving",1) )
                return notify_fail("你试图浮出水面，但是一个波浪打来，又将你卷入了水里。\n");
        return ::valid_leave(me, dir);
}
