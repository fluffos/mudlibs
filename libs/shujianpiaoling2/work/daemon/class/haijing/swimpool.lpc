// Room: swimpool.c    baiwt@sjpl  12,17,1999
#include <ansi.h>

inherit ROOM;
void create()
{
	set("short", "江中");
	set("long", @LONG
汹涌的江水在你身周翻滚流动，水下光线极暗，看不清前面的事物，江水
时而向上推起，时而又形成旋涡仿佛要把所有东西都吸入江底。你觉着胸口被
江水逼得异常紧迫，于是拼命划水，但在这深不见底的长江江心，任你水性再
好，也难以与奔泻千里的波涛相抗。
LONG
	);
        set("exits", 
        ([ //sizeof() == 1
		"up" : "/d/wuhan/jiangbian1",
        ]));
	set("hell", 1);
	setup();
//	replace_program(ROOM);
}

