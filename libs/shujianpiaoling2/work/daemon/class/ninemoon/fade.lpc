//降低杀气的force perform

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me);

int exert(object me, object target)
{
        int skill;

        if( target != me ) return notify_fail("你只能用内功压制自己的杀气。\n");

        if( (int)me->query("force") < 100 )     return notify_fail("你的内力不够。\n");
        if( me->query_temp("fade") ) return notify_fail("你已经在运功中了。\n");
        if( (int)me->query("bellicosity") <= 0 )
                return notify_fail("你现在心平气和。\n");

        skill = me->query_skill("force");

        me->add("bellicosity", - 100 - skill/3 );
        if(me->query("bellicosity")<0) me->set("bellicosity",0);
        me->add("force", -100);
        me->receive_damage("sen", 100);

        message_vision(
                BLU "$N微一凝神，运起内功，放慢呼吸，开始收敛自己的杀气 ....\n\n" NOR, me);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), 2);
        me->add_temp("fade",1);
        if( me->is_fighting()
        &&      (random(skill) < (int)me->query("cps") * 3 ) )
                me->unconcious();

        return 1;
}

void remove_effect(object me)
{
//      me->add_temp("apply/attack", - amount);
//      me->add_temp("apply/dodge", - amount);
//      me->add_temp("apply/damage", - amount);
        me->delete_temp("fade");
        tell_object(me, HIC"你的真气运转一周，收回丹田。\n"NOR);
}

