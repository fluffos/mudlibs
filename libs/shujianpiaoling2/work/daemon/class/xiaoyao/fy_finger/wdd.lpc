// 晓风残月

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int me_force, ob_force, tz, damage, ob_dodge;
  string dodskill;
  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");
  if (!target) target = offensive_target(me);
  return notify_fail("没有这项技能。\n");

  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps" || (int)me->query_skill("wave_steps") < 60)
    return notify_fail("需要凌波微步身法的配和！\n");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁使用？\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够。\n");

  me_force = me->query_skill("force");
  ob_force = target->query_skill("force");
  tz = me->query_skill("fy_finger", 1);
  ob_dodge = target->query_skill("dodge", 0);
  if (tz == 0)
    return notify_fail("你根本没有修习过「浮月流云指」\n");
  if (tz < 100)
    return notify_fail("你的火候不够！\n");
  me->add("force", -50);
  me->receive_damage("kee", 20);
  me->start_busy(2);

  message_vision(
    GRN "$N左手食指轻轻一弹，一股阴柔的内劲射向$n！\n" NOR, me, target);
  if (wizardp(me)) printf("tz = %d, ob_dodge = %d \n", tz, ob_dodge);
  if (random(tz + ob_dodge) < ob_dodge / 2) {
    message_vision(
      HIM "结果被$n闪开了。\n" NOR, me, target);
    target->fight_ob(me);
    me->add("force", -me->query("force_factor"));
    return 1;
  }
  damage = (int)me->query("max_force") / 8 * tz / 100;
  damage = (int)me->query("max_force") / 8 + damage - (int)target->query("max_force") / 10;
  if (damage > 0) {
    if (damage > 300) damage = 300;
    target->receive_damage("kee", damage);
    if ((int)ob_force < me_force * 2)
      target->receive_wound("kee", damage / 2);
    if (damage < 50) message_vision(
      "$n身体晃了一下，好象受了点伤。\n", me, target);
    else if (damage < 100) message_vision(YEL
      "$n发出一声闷叫，身体不由倒退三步。\n", me, target);
    else message_vision(RED
      "$n惨叫一声，一道血箭从$p的身上射了出来。\n", me, target);

  }

  else message_vision("$N的内力有如泥牛入海，消失得无声无息。\n", me, target);
  me->improve_skill("fy_finger", random((int)me->query("int") + (int)me->query("con")), 1);
  if (userp(target)) target->fight_ob(me);
  else if (!target->is_killing(me)) target->kill_ob(me);
  me->add("force", -me->query("force_factor"));
  return 1;
}
