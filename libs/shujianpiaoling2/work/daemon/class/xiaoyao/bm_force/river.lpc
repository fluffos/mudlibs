//北冥神功之百川汇海
//crazy studio design
//id:lark
//data:99.8.13
//吸取敌人内力为己用(bm>200)
#include <ansi.h>
#include <login.h>
inherit SSERVER;
int exert(object me, object target) {
  int bm, ob_dodge, damage, die, me_dodge;
  int max_force;
  string dodskill;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［百川汇海］只能对战斗中的对手使用。\n");
  bm = me->query_skill("bm_force", 1);
  max_force = me->query_skill("force", 1) * 10 + me->query_skill("bm_force", 1);
  max_force = (int)max_force * 3 / 2;
  ob_dodge = target->query_skill("dodge");
  me_dodge = me->query_skill("dodge");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");
  if ((int)me->query_skill("bm_force", 1) < 150)
    return notify_fail("你的北冥神功修为不够。\n");
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");
  if (((string)me->query("class") == "xiaoyao") || ((string)me->query("class") == "xiaoyao2")) {
    dodskill = (string)me->query_skill_mapped("dodge");
    if (dodskill != "wave_steps" || (int)me->query_skill("wave_steps", 1) < 80)
      return notify_fail("需要凌波微步身法的配和！\n");
    if ((int)target->query("force") < 200)
      return notify_fail("对方内息已经相当微弱，不可能在吸取什么了.\n");
    if (me->query("sen") < 100 || me->query("gin") < 100 || me->query("kee") < 100)
      return notify_fail("你的身体状况太差，不能施展［百川汇海］。\n");

    if ((target->query_skill_mapped("force") == "liheforce") &&
      ((int)target->query_skill("liheforce") > (int)me->query_skill("bm_force")))
      return notify_fail("你施展出［百川汇海］，但是你的内力如石沉大海，眨眼无影无踪。\n");
    if ((target->query_skill_mapped("force") == "blood_force") &&
      ((int)target->query_skill("blood_force") > (int)me->query_skill("bm_force")))
      return notify_fail("你施展出［百川汇海］，但是你的内力如石沉大海，眨眼无影无踪。\n");

    me->receive_damage("sen", 50, me);
    me->receive_damage("gin", 50, me);
    me->receive_damage("kee", 50, me);
    me->start_busy(5);
    tell_object(me, "你轻舒手臂手指按向敌人的「檀中穴」\n");
    message_vision(HIW "$N左手拇指急探，按向$n的「檀中穴」\n" NOR, me, target);
    if (random(me->query("combat_exp")) > (int)target->query("combat_exp") * 3 / 5
      || target->is_busy()) {
      if (random(me_dodge) < ob_dodge / 2) {
        message_vision(HIM "结果被$n闪开了。\n" NOR, me, target);
        return 1;
      }
      damage = (int)((bm - ((int)target->query("force") / 30) - ((int)target->query_skill("force") / 2)) * 1 / 3 + random(bm) + random(((int)(me->query("force") - target->query("force")) / me->query("kar") / 3)));
      // if(damage<0) return notify_fail("你潜心运功但似乎没有吸收到什么。\n");
      if (damage > 0) {
        tell_object(target, "你觉得突然手臂突然一阵酸软。\n");
        message_vision("双方突然僵持不动，$N拇指按住$n的「檀中穴」,头顶冒出丝丝白烟。\n", me);
        tell_room(environment(me), target->query("name") + "满脸通红，摇摇晃晃地神情突显萎靡\n", target, target);
        target->start_busy(5);
        me->start_busy(3);
      } else {
        tell_object(target, "你突然觉得感觉内力外泄，急忙抱元守一护住元神。\n");
        tell_room(environment(me), target->query("name") + "脸上显出一丝萎靡但随即一震恢复了精神。\n", target, target);
        me->start_busy(3);
      }
      if ((int)me->query("force") < (int)target->query("force")) {
        tell_object(me, HIM "受到对方深厚内力的吸引，你突然感到内力倒涌而出，不禁大骇收回了手指。 \n");
        message_vision(HIM "$N脸色突变，顿时涨的通红，身躯微震，手指忙不迭的收了回来。\n" NOR, me, target);
        me->add("force", -damage);
        if ((int)(me->query("max_force")) < max_force)
          me->add("max_force", -(int)(damage / (5 + random(2))));
        target->add("force", damage);
        me->receive_damage("gin", (int)(damage / (5 + random(2))), me);
        me->receive_wound("gin", (int)(damage / (5 + random(2))), me);
        me->receive_wound("sen", (int)(damage / (5 + random(2))), me);
        me->receive_damage("sen", (int)(damage / (5 + random(2))), me);
        return 1;
      }
      if (bm < 200) {
        //target->add("force", -damage);
        target->add("force", -(int)(damage / (6 + random(4))));
        me->receive_damage("gin", (int)(damage / (6 + random(4))), me);
        me->receive_wound("gin", (int)(damage / (6 + random(4))), me);
        me->receive_wound("sen", (int)(damage / (6 + random(4))), me);
        me->receive_damage("sen", (int)(damage / (6 + random(4))), me);
        target->receive_damage("gin", (int)(damage / (6 + random(4))), me);
        target->receive_wound("gin", (int)(damage / (6 + random(4))), me);
        target->receive_wound("sen", (int)(damage / (6 + random(4))), me);
        target->receive_damage("sen", (int)(damage / (6 + random(4))), me);
        if ((int)(me->query("max_force")) < max_force)
          me->add("force", (int)(damage / (6 + random(4))));
      } else {
        target->add("force", -damage);
        target->add("max_force", -(int)(damage / (5 + random(3))));
        me->add("force", damage);
        me->add("max_force", (int)(damage / (5 + random(3))));
        me->receive_damage("gin", (int)(damage / (5 + random(3))), me);
        me->receive_wound("gin", (int)(damage / (5 + random(3))), me);
        me->receive_wound("sen", (int)(damage / (5 + random(3))), me);
        me->receive_damage("sen", (int)(damage / (5 + random(3))), me);
        target->receive_damage("gin", (int)(damage / (5 + random(3))), me);
        target->receive_wound("gin", (int)(damage / (5 + random(3))), me);
        target->receive_wound("sen", (int)(damage / (5 + random(3))), me);
        target->receive_damage("sen", damage / (3 + random(2)), me);
        if ((int)(me->query("max_force")) > max_force) {
          call_out("zouhuo", 2, me);
        }
      }
      return 1;
    }
    message_vision(HIM "$N脸色一变，身形急转侧身避过了$n的攻击\n" NOR, target, me);
    message_vision(HIR "$N怒喝一声：混球!你受死吧!\n" NOR, target);
    target->kill_ob(me);
    return 1;
  } else
    return notify_fail("你不是逍遥弟子，无法使用北冥神功的绝技。\n");
}



void zouhuo(object me) {
  int bm, ng, max_force;
  object corpse;
  bm = me->query_skill("bm_force", 1);
  ng = me->query_skill("force", 1);
  max_force = ng * 10 + bm;
  max_force = max_force * 4 / 3;
  tell_object(me, HIR "你觉得丹田膨胀，真气鼓动不可抑止，浑身象炸裂一样巨痛\n" NOR);
  message_vision(HIY "$N突然脸色大变，忽青忽红，面容扭曲，狰狞可怖。\n" NOR, me);
  if (bm < 150) {
    tell_object(me, HIW "你由于内功等级不够，不能控制过于庞大的真气，走火入魔死掉了\n" NOR);
    me->clear_condition();
    message_vision("\n$N死了。\n\n", me);
    CHANNEL_D->do_channel(environment(me), "rumor", me->name(1) + "走火入魔死掉了。！\n");
    if (objectp(corpse = CHAR_D->make_corpse(me, me)))
      corpse->move(environment(me));
    me->remove_all_killer();
    me->dismiss_team();
    if (userp(me)) {
      me->set("gin", 1);
      me->set("eff_gin", 1);
      me->set("kee", 1);
      me->set("eff_kee", 1);
      me->set("sen", 1);
      me->set("eff_sen", 1);
      me->set("max_force", max_force);
      me->add("max_force", -(me->query_skill("force") + random(me->query("kar")) * 10));
      if (me->query("max_force") < 0)
        me->set("max_force", 0);
      me->set("force", 0);
      me->set_skill("force", ng - (int)(100 / random(me->query("kar"))));
      me->set_skill("bm_force", bm - (int)(100 / random(me->query("kar"))));
      me->be_ghost(1);
      me->save();
      me->move(DEATH_ROOM);
      DEATH_ROOM->start_death(me);
    } else destruct(me);
    return;
  }
  if (bm < 200) {
    tell_object(me, HIR "你突然觉得体内真气冲突不已，走入岔道，浑身如火中烧，晕了过去\n" NOR);
    message_vision(HIG "$N如中邪般手舞足蹈起来，突然惨叫一声晕了过去.\n" NOR, me);
    me->set("max_force", max_force);
    me->save();
    me->unconcious();
  }
  tell_object(me, HIR "你觉得突然体内真气激荡如脱缰野马，不禁大惊，急忙运功调息,这是走火入魔的征兆\n" NOR);
  message_vision(HIC "$N深吸几口气，脸色由青转红，逐渐恢复正常\n" NOR, me);
  me->set("max_force", max_force);
  me->save();
  me->start_busy(2);
  return;
}
