//子午踏庄步
#include <ansi.h>
#include <combat.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);
int perform(object me, object target) {
  int skill;
  if (target != me) return notify_fail("你只能将［子午踏庄步］用在自己的身上。\n");
  if ((int)me->query("force") < 100) return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("tazhuang")) return notify_fail("你已经在施展［子午踏庄步］了。\n");
  skill = me->query_skill_eff_lvl("five-steps");
  if (skill <= 100) return notify_fail("你的五行步法太差了！\n");
  me->add("force", -100);
  message_vision(HIM
    "$N行功运气，身形渐渐稳定，脚下踏着五行八卦的方位行走起来！\n" NOR, me);
  me->add_temp("apply/dodge", skill / 5);
  me->set_temp("tazhuang", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me,
    skill / 5 :), skill / 3);
  if (me->is_fighting()) me->start_busy(3);
  return 1;
}

void remove_effect(object me, int amount) {
  if (!me) return;
  me->add_temp("apply/dodge", -amount);
  me->delete_temp("tazhuang");
  tell_object(me, "你的［子午踏庄步］施展完毕，身形稳定了下来。\n");
}
