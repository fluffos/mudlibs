//暴雨摧花
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int myexp,yourexp,lvl;
	object weapon;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［暴雨摧花］只能对战斗中的对手使用。\n");
        if((int)me->query_skill("rain_strike",1) < 60 )
                return notify_fail("你的雨打飞花掌不够高！\n");
	weapon = me->query_temp("weapon");
	myexp = (int) me->query("combat_exp");
	yourexp = (int) target->query("combat_exp");
	lvl = (int) me->query_skill("unarmed") / 10 + 1;
	msg = HIR "$N手臂暴长，五指骨骼哗啦啦一阵响，霎时幻出无数掌影劈头盖脑击向$n！" NOR;
	if( random(myexp * lvl) > yourexp )
	{
		message_vision(msg + "\n", me, target);
		msg = "结果$n被$N攻了个手忙脚乱！\n";
		message_vision(msg, me, target);
		me->add("bellicosity", random(100));
		target->start_busy(3);
	}
	else
		        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
		        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
			me->add("bellicosity", random(100));
			me->start_busy(2);
	return 1;
}
