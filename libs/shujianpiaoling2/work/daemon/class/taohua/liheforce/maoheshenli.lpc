//貌合神离.C  created by baiwt@sjpl 11,2,1999

#include <ansi.h>
inherit SSERVER;
void copy_status(object soldier,object target);
int exert(object me, object target)
{
	object soldier;
	int level, kee;
	string msg;

	if( !target ) 
//		target = offensive_target(me);
		return notify_fail("你要对谁施展［貌合神离］？\n");
	if( !target->is_character()	|| !me->is_fighting(target) )
		return notify_fail("[貌合神离]只能对战斗中的对手使用。\n");

	if((int) me->query_skill("liheforce",1) < 120)
	return notify_fail("你的离合神功还不到高深境界，不能施展[貌合神离]。\n");

	if( (int)me->query("force") < 600 )
		return notify_fail("你的内力不够，没有办法运行离合神功。\n");

	level = (int)me->query_skill("liheforce",1);
	kee = (int)me->query("max_kee");
	seteuid(getuid());

	message_vision(HIC"$N目不转睛地盯着$n，似乎已经看透了$n的一切。\n"NOR,me,target);
msg = CYN "$N身形闪动之间，已经施展出了旷世绝学[貌合神离]，转眼间举手投足都和$n非常相似！" ;
msg +=  "\n$N已经达到了[此时无招胜有招]的最高境界！\n" NOR;

	if( (int)me->query_temp("maohe_shenli") ) 
	{
		if (present("lihe shadow", environment(me)))
		soldier = present("lihe shadow", environment(me));
		if( soldier && soldier->query("name")== me->name() )
		{
		message_vision(msg, me, target);
		soldier->kill_ob(target);
	       me->remove_all_killer();
		return 1;
		}
	}
	message_vision(msg, me, target);
	me->add("force",-500);
	me->set_temp("maohe_shenli", 1);
      me->add_temp("apply/composure", 10);
	soldier= new("/daemon/class/taohua/lhshadow");
	soldier->move(environment(me));
        soldier->invocation(me, level);
        soldier->set("possessed", me);
        soldier->set("name", me->name());
        soldier->set("max_kee", kee);
        soldier->set("eff_kee", kee);
        soldier->set("kee", kee);
        me->remove_all_killer();
        me->start_busy(3);
        call_out("copy_status", 1, soldier, target);
	return 1;
}

void copy_status(object soldier,object target)
{
	object *inv, obj;
	mapping skill_status,map_status;
	string *sname,*mname;
	int i, weapon_cnt, armor_cnt;

	skill_status=target->query_skills();
	sname=keys(skill_status);
	for(i=0;i<sizeof(skill_status);i++) {
		soldier->set_skill(sname[i],skill_status[sname[i]]);
	}
	if ( mapp(map_status = target->query_skill_map()) ) {
                mname  = keys(map_status);

                for(i=0; i<sizeof(map_status); i++) {
                        soldier->map_skill(mname[i]);
                }
        }
        map_status = target->query_skill_map();
        mname  = keys(map_status);

        for(i=0; i<sizeof(map_status); i++) {
                soldier->map_skill(mname[i], map_status[mname[i]]);
        }

  weapon_cnt = 0;
  armor_cnt = 0;
  inv = all_inventory(target);
  for(i=0; i<sizeof(inv); i++) {
    if ( !inv[i]->query_unique() && inv[i]->query("skill_type") &&
        inv[i]->query("equipped") && !weapon_cnt ) {
      obj = new(base_name(inv[i]));
      if (obj)
      {
        if(obj->move(soldier))
          obj->wield();
      }
      soldier->set("weapon", base_name(inv[i]));
      weapon_cnt = 1;
    }
    else if ( !inv[i]->query_unique() && !inv[i]->query("skill_type") && 
        inv[i]->query("equipped") && !armor_cnt ) {
      obj = new(base_name(inv[i]));
      if (obj)
      {
        if(obj->move(soldier))
          obj->wear();
      }
      soldier->set("armor", base_name(inv[i]));
      armor_cnt = 1;
    }
	else if( weapon_cnt && armor_cnt )
                 break;
  }
}
