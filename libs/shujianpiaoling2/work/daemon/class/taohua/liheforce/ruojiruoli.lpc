//若即若离
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
//nosave object *enemy = ({});
int exert(object me, object target)
{
       int i;
	object *enemy;
	if ( me->query_skill("liheforce",1) < 100) return notify_fail("你的离合神功还不够纯熟！\n");
	if( (int)me->query("force") < 500 )
		return notify_fail("你的内力不够，没有办法施展[若即若离]。\n");
	enemy=me->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
           target=enemy[i];
		}
	}
        if( !target ) return notify_fail("你必须至少指定一个对手\n");
        if( !target->is_character() || !me->is_fighting(target))
		return notify_fail("［若即若离］只能对战斗中的对手使用。\n");
        if( !target->query_skill_map() ) return notify_fail("对方已经无法施展武功了！\n");

        message_vision(HIC"\n$N身形闪动之间，已经施展出了离合神功的旷世绝学「若即若离」!\n",me,target);
	if( random(9)>4 && target->query_kar()+ target->query_cps() +target->query_agi()
		+target->query_tol() < random( (me->query_skill("liheforce",1)*2 )+100 ) )
	{
	target->skill_enable_none();
       target->reset_action();
	message_vision(HIC"\n$n只觉得四周一股无形压力涌来，所有武功竟然都无从施展！\n\n"NOR,me,target);
        me->add("force",-200);
        target->set_delay(5);
        me->start_busy(1);
	}
	else{
        message_vision(HIC"\n但是$n护体神功遍布全身，将离合神功的压力卸了开去！\n"NOR,me,target);
        me->add("force",-500);
        me->set_delay(5);
	}
     	return 1;
}
