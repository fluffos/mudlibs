// 貌合神离
#include <ansi.h>
inherit NPC;
void backattack();
void summon_more(object soldier);

void create() {

  set_name("貌合神离", ({ "lihe shadow" }));
  set("max_atman", 300);
  set("atman", 300);
  set("max_mana", 300);
  set("mana", 300);
  set("no_shown", 1);

  set("str", 60);
  set("cor", 60);
  //	set("cps", 30);

  set("combat_exp", 100000);
  set_skill("unarmed", 100);
  set_skill("move", 100);
  set_skill("dodge", 100);
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: summon_more(this_object()) :),
  }));

  setup();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  if (is_fighting() && (int)this_object()->query("kee") <= 100)
    backattack();
  return ::heal_up() + 1;
}

void leave() {
  object owner;
  if (objectp(owner = this_object()->query("possessed")))
    owner->set_temp("maohe_shenli", 0);
  //      if(owner) owner->add_temp("apply/composure", -10);
  message("vision",
    CYN + name() + "的[离合神功]运行完毕，把功力收回丹田。\n\n" NOR, environment(),
    this_object());
  destruct(this_object());
}

void invocation(object who, int level) {
  int i;
  object *enemy;
  set_skill("move", 100 + random(level / 2));
  set_skill("dodge", 100 + random(level / 2));
  set("combat_exp", 100000 + random(level / 4) * level * level);
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
  set("possessed", who);
}

void summon_more(object soldier) {
  int i;
  object *enemy;
  seteuid(getuid());
  soldier = this_object();
  enemy = soldier->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      message_vision(HIR, soldier);
      COMBAT_D->do_attack(soldier, enemy[i], soldier->query_temp("weapon"));
      message_vision(NOR, soldier);
    }
  }
  return;
}

void backattack() {
  int i;
  object owner, *enemy;
  if (objectp(owner = this_object()->query("possessed"))) {
    enemy = this_object()->query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])) {
        owner->kill_ob(enemy[i]);
        enemy[i]->kill_ob(owner);
      }
    }

  }

}

void die() {
  object owner;
  if (objectp(owner = this_object()->query("possessed")))
    owner->set_temp("maohe_shenli", 0);
  //      if(owner) owner->add_temp("apply/composure", -10);
  message("vision",
    CYN + name() + "的[离合神功]运行完毕，把功力收回丹田。\n\n" NOR, environment(),
    this_object());
  destruct(this_object());
  //     ::die();
}
