//落花流水

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［落花流水］只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	extra = me->query_skill("luoying_sword",1) / 10;
	if ( extra < 10) return notify_fail("你的落英神剑还不够纯熟！\n");
	msg = HIM "$N手腕一抖，刹那间化出无数剑花，在绵绵内劲推动下向$n挥去！" NOR;

	if((target->query_skill_mapped("sword") == "dg9-sword")&&
	((int)target->query_skill("dg9-sword") > (int)me->query_skill("luoying_sword")))
	{
	message_vision(msg, me, target);
	message_vision(CYN"\n但是$n剑法一展，$N的攻势莫名其妙地扑了个空！\n" NOR, me,target);
	me->add_temp("apply/attack", 5);	
	me->start_busy(2);
	return 1;
	}
	target->add_temp("apply/defense", -extra);	
	target->add_temp("apply/dodge", -extra);
       target->add_temp("apply/iron-cloth", -extra*5);

	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	msg = HIM "$N展臂一掠，刹那间化出一道剑河，在绵绵内劲推动下向$n泻去！" NOR;
	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	target->add_temp("apply/defense", extra);
	target->add_temp("apply/dodge", extra);
       target->add_temp("apply/iron-cloth", extra*5);

	me->start_busy(2);
	return 1;
}
