//天王咒
#include <ansi.h>

inherit SSERVER;
void jump_up(object me, object target);

int cast(object me, object target) {
  object room;
  string msg;
  int number;
  //	me = this_player();
  //	if( !target ) target = offensive_target(me);
  if (!target)
    return notify_fail("你要对谁施咒？\n");
  if (!target
    || !me->is_fighting(target))
    return notify_fail("［天王咒］只能对战斗中的对手使用。\n");

  if ((string)me->query("class") != "taoist")
    return notify_fail("你不是茅山道士，不会用这个法术！\n");

  if ((int)me->query("mana") < 170)
    return notify_fail("你的法力不够！\n");
  if ((int)me->query("gin") < 50)
    return notify_fail("你的精神没有办法有效集中！\n");
  if ((int)me->query("sen") < 60)
    return notify_fail("你的精神没有办法有效集中！\n");
  if ((int)me->query_skill("necromancy", 1) <= 80)
    return notify_fail("你的茅山道术还不够精纯。\n");
  me->add("mana", -150);
  me->receive_damage("gin", 30);
  me->receive_damage("sen", 50);
  if (!target->is_character() || target->is_corpse())
    return notify_fail("你口中喃喃地念了几句咒语，但是什么也没有发生。\n");
  if (!userp(target) && (object)target->query_temp("pending/fight") != me)
    return notify_fail("你口中喃喃地念了几句咒语，但是什么也没有发生。\n");

  if (target->query("magic_defense") + target->query("combat_exp") / 2 > me->query("magic_attack") + me->query("combat_exp") / 2) {
    me->start_busy(3);
    return notify_fail("你口中喃喃地念了几句咒语，但是什么也没有发生。\n");
  }
  number = random(9);
  //	target = me->query_enemy();
  //		place = "/u/baiwt/xueshan/tianwangta.lpc";

  if (number <= 3) {
    if (!(room = find_object("/u/baiwt/xueshan/tianwangta.lpc")))
      room = load_object("/u/baiwt/xueshan/tianwangta.lpc");
    message_vision(HIW "$N口中喃喃地念了几句咒语。\n" NOR, me);
    msg = HIC "只见天上云开雾绽，托塔李天王高大的身影忽然出现在云头！";
    msg += "\n李天王把手中的镇妖塔往空一举，沉闷的声音喝道：“孽障，还不伏法！”\n\n" NOR;
    message_vision(msg, me);
    message_vision(HIY "\n一道金光从天而降，镇妖塔象一座山似的将$N牢牢罩住。\n\n" NOR, target);
    target->move(room);
    target->set_temp("sleep/no_move", 1);
    if (target->query("potential") - target->query("learned_points") > 0)
      number = target->query("potential") - target->query("learned_points");
    if (environment(target)->query("no_death_penalty") <= 0 && random(9) < 4)
      target->add("potential", -number);
    target->unconcious();
    call_out("jump_up", 30, me, target);
    return 1;
  }
  say("你口中喃喃地念了几句咒语，但是什么也没有发生。\n");
  return 1;
}
void jump_up(object me, object target) {
  string msg;
  if (!me || !target) return;
  msg = HIB "\n$N只感到体内的潜能随着镇妖塔法力的减弱而渐渐消失了！\n\n" NOR;
  message_vision(msg, target);
  target->set_temp("sleep/no_move", 0);
  target->start_busy(2);
}
