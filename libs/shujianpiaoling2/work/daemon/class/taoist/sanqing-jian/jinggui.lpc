// 惊鬼符  baiwt@sjpl 5,25,2000

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  int i, extra;
  object *inv;
  object weapon, yourgod, paper;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［惊鬼符］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  extra = ((int)me->query_skill("sanqing-jian", 1) + (int)me->query_skill("sword", 1)) / 2;
  if (extra < 100)
    return notify_fail("你的［三清剑法］还不够。\n");
  if (!me->query_skill("scratching", 1))
    return notify_fail("你没有学会符之术。\n");
  if (!me->query_skill("scratmancy", 1))
    return notify_fail("你没有学会茅山符术。\n");
  if (!objectp(present("paper seal", me)))
    return notify_fail("你没有桃符纸，无法施展符术。\n");
  if ((int)me->query("mana") <= 30)
    return notify_fail("你的法力不够。\n");

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if ((string)(inv[i]->query("id")) != "paper seal")
      continue;
    if ((string)(inv[i]->query("id")) == "paper seal")
      inv[i]->add_amount(-1);
  }
  message_vision(YEL "\n$N喃喃念动咒语，只见$N手中忽然变出一把桃木剑和一张符纸，" NOR, me, target);
  message_vision(YEL "\n$N将剑钉在符纸上用力一挥，桃木剑带着那张布满法力的符纸直向$n飞来！\n" NOR, me, target);
  message_vision(HIG "［惊鬼符］！\n\n" NOR, me, target);
  if ((string)target->query("mguard")) {
    target->receive_wound("kee", extra * 3 / 2);
    COMBAT_D->report_status(target, 1);
  } else {
    target->receive_wound("kee", extra / 3);
    COMBAT_D->report_status(target, 1);
  }
  if (me->query("mana") >= 30)
    me->add("mana", -30);
  me->start_busy(1);
  return 1;
}
