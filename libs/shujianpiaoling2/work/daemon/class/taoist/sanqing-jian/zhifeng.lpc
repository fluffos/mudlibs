// 止风符  baiwt@sjpl 5,25,2000

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	int i,extra;
      	 object *inv;
	object weapon, yourgod, paper;
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［止风符］只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	extra = me->query_skill("sanqing-jian",1);
	if (extra < 40)
		return notify_fail("你的［三清剑法］还不够。\n");
	if( !me->query_skill("scratching",1) )
		return notify_fail("你没有学会符之术。\n");
	if( !me->query_skill("scratmancy",1) )
		return notify_fail("你没有学会茅山符术。\n");
	if (!objectp(present("paper seal", me)))
		return notify_fail("你没有桃符纸，无法施展符术。\n");
        if( (int)me->query("mana") <= 30 )
                return notify_fail("你的法力不够。\n");

        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++)
        {
                if( (string)(inv[i]->query("id")) != "paper seal" )
			continue;
                if( (string)(inv[i]->query("id")) == "paper seal" )
                        inv[i]->add_amount(-1);
        }

	if (objectp(present("wind god", environment(me))))
	{
		yourgod = present("wind god", environment(me));
		message_vision(HIC"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,me,target);
		message_vision(HIC"\n不久只见大风渐渐停了下来，风神的身影转瞬消失在云头。"NOR,me,target);
		message_vision(HIG"\n［止风符］！\n\n"NOR,me,target);
		destruct(yourgod);
	}
	else
	{
		message_vision(CYN"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,me,target);
		message_vision(CYN"\n过了一会符纸便落了下来。\n\n"NOR,me,target);
	}
	if( me->query("mana") >= 30 )
	me->add("mana", -30);
	me->start_busy(1);
	return 1;
}
