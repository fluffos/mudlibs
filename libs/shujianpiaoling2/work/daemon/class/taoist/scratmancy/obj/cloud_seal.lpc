//cloud_seal.c 驾云符 created by baiwt
#include <ansi.h>
inherit ITEM;
mapping where_map=([
"ca":"/d/city/guanroad3",
"sl":"/u/tian/shaolin/tulu3",
"wd":"/u/wudang/shanmen",
"xs":"/u/baiwt/xueshan/shanjiao",
"em":"/u/emei/shanroad1",
"hs":"/u/xiyu/huaroad2",
"qz":"/u/guanwai/suishiroad",
"ms":"/u/maoshan/ladder5",
"gm":"/u/gumu/hillcross",
"ly":"/u/jakey/qspath1",
"wh":"/d/wuhan/jiangb1",
"xy":"/u/lark/xiaoyao/roadt5",
]);
void init(){
add_action("do_trans","hop");
}
void create(){
set_name("驾云符",({"cloud charm","charm"}));
set_weight(100); 
//set_max_encumbrance(8000);
//set("no_drop", "这样东西不能离开你。\n");
        if( clonep() )  set_default_object(__FILE__);
 else {     set("long",
"一张可以腾云驾雾的神符，以它的法力现在所能到达(hop)的地方如下。\n
\t长安(ca)        少室山(sl)     武当山(wd)       雪山(xs) \n
\t峨眉山(em)      华山(hs)       青藏高原(qz)     茅山(ms) \n
\t小孤山(gm)      缥缈山(xy)     落月山庄(ly)     武汉(wh) \n
\n");
set("unit","张");
}
}
int do_trans(string arg)
{
        object me,obj;string msg,str;str=where_map[arg];
        if( !arg||!stringp(str)) return notify_fail("你要去哪里？\n");
me=this_player();
             if (! environment(me)->query("outdoors"))
 return notify_fail("在这里无法腾云驾雾。\n");
             if (environment(me)->query("oldarea"))
 return notify_fail("在这里无法腾云驾雾。\n");
             if (environment(me)->query("hell"))
 return notify_fail("在这里无法腾云驾雾。\n");
 if (me->is_fighting())
return notify_fail("战斗中无法腾云驾雾！");
	if( (int)me->query("mana") < 100 )
		return notify_fail("你的法力不能控制驾云符。\n");

str+=".lpc";
        if(file_size(str)<0) 
return notify_fail("无法去这个地方。\n");
    if( stringp(msg = me->query("env/msg_mout")) )
       {if (msg!="") message_vision(msg+"\n", me);} 
       else  message_vision(HIW"\n只见$N将驾云符化做一朵云彩，高高兴兴地坐了上去，冉冉向上升起. . .\n\n"NOR, me);
me->move(str);
me->add("mana",-50);
if( stringp(msg = me->query("env/msg_min")) )
       {if (msg!="") message_vision(msg+"\n", me);}
        else  message_vision(HIW"\n天上缓缓降下一朵云彩，$N从云中走了出来。\n\n"NOR, me);
destruct(this_object());
return 1;
}
