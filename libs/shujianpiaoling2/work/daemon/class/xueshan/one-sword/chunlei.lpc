//春雷震怒  created by baiwt@sjpl 11,2,1999
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void return_busy(object me,object target);

int perform(object me, object target)
{
        int force,lvl;
        if((int)me->query("force")< 200)
        return notify_fail("你的内力太差了！\n");
        force = (int)me->query_skill("force");
        lvl = (int)me->query_skill("one-sword");

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
		return notify_fail("［春雷震怒］只能对战斗中的对手使用。\n");

        if(force < 20 || lvl < 20)
        return notify_fail("你的风雷一剑和内功太差了，无法施展“春雷震怒”！\n");       
	if( (int)me->query_temp("situ/one") ) 
        return notify_fail("你正在施展“春雷震怒”！\n");       
        me->start_busy(1);
        me->add("force",-200);
        me->set_temp("situ/one",1);
        message_vision(HIR"\n$N剑光起处，稳稳地使出仅有的一招剑式“春雷震怒”！\n\n"NOR,me);
        call_out("return_busy", 1, me, target);
        return 1;
}

void return_busy(object me,object target)
{
	string msg;
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
	{
        if(me->query_temp("situ/one"))
        me->delete_temp("situ/one");
        message_vision(HIC"$N的［春雷震怒］施展完毕，把功力收回丹田！\n"NOR,me);
	return;
	}
	if( me->is_busy() )
	{
       target->add_temp("apply/iron-cloth", -100);
        message_vision(HIR"$N并不忙乱，一招剑法［春雷震怒］使得又平又稳。\n"NOR,me);
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
       target->add_temp("apply/iron-cloth", 100);
	}
        call_out("return_busy", 3, me, target);
}

