//尸蛊咒
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	object weapon;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「尸蛊咒」只能对战斗中的对手使用。\n");
        if((int)me->query_skill("ghostflag") < 50 )
               return notify_fail("你的地煞旗诀不够高！\n");
	if((int)me->query_skill("ghostflag",1)*3 < (int)target->query_skill("force",1) ) 
	return notify_fail("你阴森地发出了[尸蛊毒]，但是被对方的内力逼开了。\n");
	weapon = me->query_temp("weapon");
	if( weapon->query("id")!="death flag" )
	return notify_fail("［尸蛊咒］必须使用骷髅旗。\n");

	message_vision(HIB "\n$N的骷髅旗发出一种腐臭，向$n的面门挥去。\n" NOR, me,target);	

	if((target->query_skill_mapped("force") == "blood_force")&&
	((int)target->query_skill("blood_force",1) > (int)me->query_skill("ghostflag")))
	{
	message_vision(CYN"\n但是$n咬了咬舌间，噗地吐出一口毒血，将那股腐臭逼了开去！\n" NOR, me,target);
	me->start_busy(1);
	return 1;
	}
	if((target->query_skill_mapped("force") == "puti_force")&&
	((int)target->query_skill("puti_force",1) > (int)me->query_skill("ghostflag")))
	{
	message_vision(CYN"\n$n运起菩提心法，眨眼便将那股腐毒逼了出来！\n" NOR, me,target);
	me->start_busy(1);
	return 1;
	}

	message_vision( HIG "$N忽然闻到一股恶腥气，刹那间觉得体内五脏六腑刀绞般难受。\n\n" NOR,target);
	if(!target->query_condition("corpsesick"))
		target->apply_condition("corpsesick",random(10)+10);
	me->start_busy(1);
	return 1;
}
