//地狱炼
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［地狱炼］只能对战斗中的对手使用。\n");
	extra = me->query_skill("ghostclaw",1) ;
	if(extra <= 90 ) return notify_fail("你的［无常枷锁手］不够熟练！\n");
	msg = HIR "$N突然绕到$n身后，双手合抱同时抓向$n，企图将$n全身撕裂！" NOR;
        weapon = me->query_temp("weapon");
	me->add_temp("apply/damage",extra/5);
       target->add_temp("apply/iron-cloth", -extra);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	me->add_temp("apply/damage",-extra/5);
       target->add_temp("apply/iron-cloth", extra);
	me->start_busy(2);
	return 1;
}
