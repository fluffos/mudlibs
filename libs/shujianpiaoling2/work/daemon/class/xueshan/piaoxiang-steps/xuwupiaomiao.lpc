//虚无飘渺
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
	int lvl,i;
	object env, *inv;
	lvl = (int) me->query_skill("piaoxiang-steps");
	lvl += (int) me->query("spi");
        if ( lvl <= 70)
                return notify_fail("你飘香步法不够高！\n");
	if( me->query("force") < 50 )
		return notify_fail("你的内力不够！\n");
        if( me->query("gin") <= 30 )
                return notify_fail("你的精不够！\n");
	me->add("force", -50);
	me->receive_damage("gin", 15);
	message_vision(HIW "$N凝神提气，整个人犹如一团轻烟，渐渐飘散在了空气之中．．．\n" NOR, me);
	        me->set("env/invisibility", 1);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), lvl/10);
        if( me->is_fighting() ) me->start_busy(3);
        return 1;

}
void remove_effect(object me)
{
	if( !me ) return;
        me->set("env/invisibility", 0);
        tell_object(me, "你的[虚无飘渺]失效了。\n");
}
