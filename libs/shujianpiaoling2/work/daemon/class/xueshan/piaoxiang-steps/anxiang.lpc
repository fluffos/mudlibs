//暗香疏影
#include <ansi.h>
#include <combat.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);
int perform(object me, object target)
{
        int skill;
        if( target != me ) return 
	notify_fail("你只能将［暗香疏影］用在自己的身上。\n");
//       if( (string)me->query("gender") != "女性" )
//                return notify_fail("［暗香疏影］是只有女子才能练的功夫。\n");
        if( (int)me->query("force") < 100 )
     return notify_fail("你的内力不够。\n");
        if( (int)me->query_temp("anxiang") ) return 
	notify_fail("你已经在施展［暗香疏影］了。\n");
	skill = me->query_skill("piaoxiang-steps");
	if(skill <= 70) return notify_fail("你的飘香步法太差了！\n");
	 me->add("force", -100);
        message_vision( HIR
"$N轻啸一声，使出飘香步法中的［暗香疏影］，整个身行忽隐忽现，飘缈不定！\n" NOR, me);
        me->add_temp("apply/dodge", skill/3);
        me->add_temp("apply/defense", skill/3);
        me->set_temp("anxiang", 1);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, 
skill/3 :), skill/3);
        if( me->is_fighting() ) me->start_busy(3);
        return 1;
}

void remove_effect(object me, int amount)
{
	if( !me ) return;
        me->add_temp("apply/dodge", -amount);
        me->add_temp("apply/defense", -amount);
        me->delete_temp("anxiang");
        tell_object(me, "你的［暗香疏影］施展完毕，身行稳定了下来。\n");
}
 
