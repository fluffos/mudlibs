//隔空解穴
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	if( !target )
		return notify_fail("你想点谁的穴道？\n");
	if( !target->is_character() || target->is_corpse() )
		return notify_fail("看清楚一点，那并不是活物。\n");

	if( (int)me->query("force") < 100 )
		return notify_fail("你的内力不够，没有办法隔空解穴。\n");

	if( !target ) target = offensive_target(me);

	if((int) me->query_skill("wuxing-zhi",1) <= 150)
	return notify_fail("你的无形指还不够精纯，不能隔空解穴。\n");
        if((int)me->query_skill("liuhe-force") < 50 )
                return notify_fail("你的六合真气不够高！\n");
	if(!target->is_busy())
		return notify_fail(target->name()+"并没有被封住穴道！\n");

	message_vision(HIC"$N施展出神技[隔空解穴]，对着$n遥遥点出一指。\n"NOR,me,target);
msg = YEL "$N指尖一股无形指力破空而出，接连点中了$n的三处大穴！" ;
msg +=  "\n$n只觉浑身一震，登时被封闭的穴道全解开了。" NOR;
	message_vision(msg, me, target);
	target->remove_busy();
	me->add("force",-100);
	me->set_delay(3);
	return 1;
}

