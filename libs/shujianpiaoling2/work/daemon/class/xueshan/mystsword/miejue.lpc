//七步灭绝剑
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("七步灭绝剑只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	extra = me->query_skill("mystsword",1) / 7;
	msg = HIR  "$N使出小步玄剑中的精髓［七步灭绝剑］，手中的"+ weapon->name() +"嗡地一声刺向$n！" NOR;

	if(target->query_skill("iron-cloth",1)&&target->query_skill("iron-cloth") < random(me->query_skill("sword")*2) )
	{
	message_vision(msg,me,target);
	message_vision(HIR"\n结果$N强大的内劲催破了$n的真元！\n" NOR, me,target);
	target->receive_wound("kee", (int)me->query_skill("mystsword",1)*3);
	COMBAT_D->report_status(target,1);
	msg =  HIW "\n$N的身影斜进七步，偏锋一闪，剑光刹那间消失了．．．．\n" NOR;
	message_vision(msg, me, target);
	me->start_busy(2);
	return 1;
	}
	me->add_temp("apply/attack", extra);	
	me->add_temp("apply/damage", extra);
	target->add_temp("apply/dodge", -extra);
	target->add_temp("apply/parry", -extra);
	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	msg =  HIW "$N的身影斜进七步，偏锋一闪，剑光刹那间消失了．．．．\n" NOR;
	message_vision(msg, me, target);
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
	target->add_temp("apply/dodge", extra);
	target->add_temp("apply/parry", extra);
	me->start_busy(2);
	return 1;
}
