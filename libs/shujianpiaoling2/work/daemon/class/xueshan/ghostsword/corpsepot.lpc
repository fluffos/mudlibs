//借尸还魂
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int damage, ap, dp;
	int extradam;
	object corp;
	object *t;
	if( !target ) target = offensive_target(me);

        if((int)me->query_skill("ghostsword") < 30 )
                return notify_fail("你的招魂剑术不够高！\n");
	if( !target
	|| !target->is_ghost()
	||	target==me)
		return notify_fail("你只能对鬼魂用招魂剑术。\n");

	if((int)me->query("kee") < 100 )
		return notify_fail("你的气血不够！\n");
	if(!corp = present("corpse",environment(me)))
		return notify_fail("你的周围没有尸体！\n");

	if(pointerp(t=me->query_team()))
                return notify_fail("你只能驱动一具鬼魂！\n");

	me->receive_wound("kee", 100);
	msg = HIC "$N凌空对着$n虚点几下，$n缓缓的站了起来！\n\n" NOR;
	message_vision(msg,me,corp);
	target->be_ghost(0);
	target->set("title","幽冥教第四代弟子");
	target->set("nickname", HIB "借尸还魂" NOR);
	target->set_skill("ghostflag", 40 + random(100));
	target->set_skill("parry", 80 + random(100));
	target->set_skill("dodge", 80 + random(100));
	target->set_skill("unarmed", 40 + random(100));
	target->set_skill("ghostclaw", 40 + random(100));
	target->set_skill("fork", 40 + random(100));
	target->set("combat_exp", (int)me->query_skill("ghostsword", 1)*2000 + random(10)*10000); 
	me->add_team_member(target);
	target->add_team_member(me);
	target->set_leader(me);
	destruct(corp);
	me->start_busy(2);
	return 1;
}

