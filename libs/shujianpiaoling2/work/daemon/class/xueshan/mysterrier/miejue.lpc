//七步灭绝剑
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("灭绝七步只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	if (!weapon) return notify_fail("灭绝七步只能和小步玄剑配和！\n");
	if( (string)weapon->query("skill_type") != "sword" )
	return notify_fail("灭绝七步只能和小步玄剑配和！\n");
	if ( (string) me->query_skill_mapped("sword") != "mystsword")
	return notify_fail("灭绝七步只能和小步玄剑配和！\n");
	extra = me->query_skill("mystsword",1) / 7;
	extra += me->query_skill("mysterrier",1) /7;
	me->add_temp("apply/attack", extra);	
	me->add_temp("apply/damage", extra);
	target->add_temp("apply/dodge", -extra);
	target->add_temp("apply/iron-cloth", -extra*2);
	msg = HIR  "$N脚踏［步玄七诀］，同时使出［小步玄剑中］的精髓－－七步灭绝剑，手中的"+ weapon->name() +"划出一道长虹，闪电般的击向$n！" NOR;
//	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	msg =  HIW "$N的身影斜进七步，偏锋一闪，剑光刹那间消失了．．．．\n" NOR;
	message_vision(msg, me, target);
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
	target->add_temp("apply/dodge", extra);
	target->add_temp("apply/iron-cloth", extra*2);
	me->start_busy(2);
	return 1;
}
