//玄冰真气
#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target, int amount)
{
	object *ob;
	int i, skill, damage;
	string envarg;

	if( !me->is_fighting() )
		return notify_fail("「玄冰真气」只能在战斗中使用。\n");

	if( (int)me->query("force") < 150 )
		return notify_fail("你的内力不够。\n");

	skill = me->query_skill("force");

	me->add("force", -150);
	me->receive_damage("kee", 10);

	me->start_busy(3);
	message_vision(
		HIW "$N深深地吸一口气，突然全身罩上了一层白蒙蒙的寒雾！\n" NOR, me);

	ob = all_inventory(environment(me));
	for(i=0; i<sizeof(ob); i++) {
		if( !living(ob[i]) || ob[i]==me ) continue;
		if( skill/2 + random(skill/2) < (int)ob[i]->query("cps") * 2 ) continue;
		
		damage = skill - ((int)ob[i]->query("max_force") / 10);
		if( damage > 0 ) {
			ob[i]->receive_damage("sen", damage);
			if( (int)ob[i]->query("force") < skill * 2 )
				ob[i]->receive_wound("sen", damage/2);
			tell_object(ob[i], HIW"你忽然感到一阵寒意，禁不住机伶伶打了个冷战。\n"NOR);
				ob[i]->apply_condition("icesick", damage/5);
		}
		
		if( userp(ob[i]) ) ob[i]->fight_ob(me);
		else if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);
	}
	if(environment(me)->query("short"))
	envarg = environment(me)->query("short");
	if( envarg )
log_file( "EXERT_LOG", sprintf("(%s) %s exert icehurt at %s\n", ctime(time()), me->query("id"), envarg ));

	return 1;
}

