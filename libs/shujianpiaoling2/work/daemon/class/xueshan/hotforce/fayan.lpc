//法眼诀
#include <ansi.h>

inherit SSERVER;

int exert(object me, object target)
{
	int skill;

	if( me->query_temp("apply/astral_vision") )
		return notify_fail("你已经施展过[法眼诀]了。\n");

	if( (int)me->query("force") < 60 )
		return notify_fail("你的内力不够。\n");

	skill = me->query_skill("force");

	me->add("force", - 60);
	me->receive_damage("sen", 5);

	message_vision(
		HIB "$N微一凝神，双目放出异样光芒，施展起绝技「法眼诀」。\n" NOR, me);

	me->add_temp("apply/astral_vision", 1);
	me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), skill);

	if( me->is_fighting() ) me->start_busy(3);

	return 1;
}

void remove_effect(object me)
{
	me->add_temp("apply/astral_vision", -1);
	tell_object(me, "你的法眼诀失效了。\n");
}
