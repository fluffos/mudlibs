//fengyun.c风云三式

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("你现在没有作战，怎么用[风云三式]呢？\n");

  if (me->query_skill("banruo-strike", 1) < 60)
    return notify_fail("你的般若掌修行不够!\n");
  if ((int)me->query("force") < 150)
    return notify_fail("你的内力不够。\n");

  message_vision(HIW "$N身形突然一变，使出绝技[风云三式]，化出左中右三个人影！\n" NOR, me, target);

  message_vision("\n只见$N左边的人影一晃来到$n的面前\n", me, target);
  COMBAT_D->do_attack(me, target);
  message_vision("\n只见$N中间的人影一晃来到$n的面前\n", me, target);
  COMBAT_D->do_attack(me, target);
  message_vision("\n只见$N右边的人影一晃来到$n的面前\n", me, target);
  COMBAT_D->do_attack(me, target);
  me->add("force", -100);
  me->start_busy(3);
  return 1;
}
