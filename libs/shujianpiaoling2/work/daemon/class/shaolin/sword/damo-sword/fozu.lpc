// 佛祖归来

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra,extrad;
	object weapon;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［佛祖归来］只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	extra = me->query_skill("damo-sword",1) / 5;
	if( extra <=10) return notify_fail("你的达摩剑法还不够熟练！\n");
	me->add_temp("apply/attack", extra);	
	me->add_temp("apply/damage", extra);
       target->add_temp("apply/iron-cloth", -extra*2);

	msg = HIY  "$N力透剑尖，手中"+weapon->query("name")+"＂嗡＂的一声射出一道佛光向$n刺去！" NOR;

	if( target->query("daode") < me->query("daode") )
	{
	extrad = random(extra + me->query("spi") + me->query("kar") + me->query("tol"));
       message_vision(HIW"\n只见一道剑气横空掠过。。。\n\n"NOR,me,target);
	target->receive_wound("kee", extrad);
	}

	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
       target->add_temp("apply/iron-cloth", extra*2);

	me->start_busy(1);
	return 1;
}
