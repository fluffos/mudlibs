//pili.c 霹雳三杖

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	int dodge,staff;
	object ob;

	if( !target ) target = offensive_target(me);

	if( !target||!target->is_character()||!me->is_fighting(target) )
		return notify_fail("你现在没有作战，怎么用[霹雳三杖]呢？\n");
	
	if( me->query_skill("wenshu_staff",1) < 80)
		return notify_fail("你的大文殊杖法修行不够!\n");
	if( !(ob = me->query_temp("weapon"))||(string)ob->query("skill_type") != "staff" )
		return notify_fail("你不拿杖怎么用[霹雳三杖]？\n");        
	if( (int)me->query("force") < 500 )
		return notify_fail("你现在内力太弱，不能使用[霹雳三杖]。\n");
	me->add("force", -100);

	message_vision(HIR "$N高高跃起，使出绝技[霹雳三杖]，直向$n袭来！\n" NOR, me, target);
	me->start_busy(3);

	if((target->query_skill_mapped("sword") == "taiji-sword")&&
	((int)target->query_skill("taiji-sword") > (int)me->query_skill("wenshu_staff")))
	{
	message_vision(CYN"\n但是$n剑法画了一个圆圈，轻巧地将$N的攻势化解了开去！\n" NOR, me,target);
	return 1;
	}
	staff=me->query_skill("staff")/4;
       target->add_temp("apply/iron-cloth", -100);

    me->add_temp("apply/staff", staff);
    me->add_temp("apply/agility", staff/2);
	message_vision("\n只见$N凌空直下，\n", me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"),0);
	message_vision("\n只见$N凌空直下，\n", me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"),0);
	message_vision("\n只见$N凌空直下，\n", me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"),0);
    me->add_temp("apply/staff", -staff);
    me->add_temp("apply/agility", -staff/2);
       target->add_temp("apply/iron-cloth", 100);

	return 1;
}
