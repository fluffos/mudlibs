//梵心咒

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target, int amount)
{
	mapping my;
	int skill;
        if( target != me ) return notify_fail("你只能用梵心咒恢复自己的道德。\n");

        if( (int)me->query("force") < 100 )  return notify_fail("你的内力不够。\n");
	  if(me->query_skill("xiaochengforce",1)<20)
		return notify_fail("你的小乘心经太差了。\n");
//	  if(me->is_busy())
//		return notify_fail("你上一个动作还没有做完。\n");
	  if(me->query("sen") < 100)
		return notify_fail("你的心神不够。\n");
	my = me->query_entire_dbase();

	  if(me->query_skill("xiaochengforce",1) <= 10) amount=1;
	  if(me->query_skill("xiaochengforce",1) > 10)
		skill=me->query_skill("xiaochengforce",1);
		amount=me->query_skill("xiaochengforce",1)/10;
	  me->add("daode_point", amount);
	  me->receive_damage("sen",30);
		amount=me->query("daode_point");
		if(amount - my["MKS"] >0)  amount = my["MKS"]+1;
		me->set("daode_point", amount);
	  me->start_busy(1);
        me->add("bellicosity", - skill/3 );
        me->add("force", -100);
        me->receive_damage("sen", 100);

        message_vision(WHT"$N凝神静坐，一切都安定下来。$N念起“梵心咒”，只觉得心情特别宁静平和。\n" NOR, me);
        return 1;
}

