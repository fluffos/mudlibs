// 破衲功 pona.c  by baiwt@sjpl 1999,5,28
#include <ansi.h>

inherit SSERVER;
int do_remove(object me, object ob);

int exert(object me, object target)
{
	object ob, *inv;
	int i, force;
        if( !me->is_fighting() )
                return notify_fail("破衲功只能在战斗中使用。\n");
        if((int)me->query_skill("xinyi_force") < 60 )
                return notify_fail("你的心意气混元功不够高！\n");
	if((int)me->query("force") < 500 )
		return notify_fail("你的内力不够！\n");

		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++) {
			if( inv[i]->query("armor_type")=="cloth" ) 
		{
			if( inv[i]->query("equipped") ) 
			ob = inv[i];
		}
			continue;
	}
	if (!ob)  return notify_fail("你没有穿衣服。\n");
	if ( userp(ob) ) 
	return notify_fail("你身上没有衣服。\n");

	force = (int) me->query_skill("xinyi_force",1);	
	do_remove(me, ob);
        message_vision(HIC "\n$N忽然扯起身上的$n，拿在手中一抖！\n" NOR, me,ob);
        message_vision(HIR "\n$N上登时布满了真气，“呼”地一声带起一团劲风向$n兜头罩去！\n" NOR, ob,target);
	target->receive_wound("kee",force,me);
	COMBAT_D->report_status(target);

	me->add("force",-50);
	me->start_busy(1);
	return 1;
}
 
int do_remove(object me, object ob)
{
	string str;

	if( (string)ob->query("equipped")!="worn" )
		return notify_fail("你并没有装备这样东西。\n");

	if( ob->unequip() ) {
		if( !stringp(str = ob->query("unequip_msg")) )
			switch(ob->query("armor_type")) {
				case "cloth":
				case "armor":
				case "surcoat":
				case "boots":
					str = YEL "$N将$n脱了下来。\n" NOR;
					break;
				case "bandage":
					str = YEL "$N将$n从伤口处拆了下来。\n" NOR;
					break;
				default:
					str = YEL "$N卸除$n的装备。\n" NOR;
			}
		message_vision(str, me, ob);
		return 1;
	} else
		return 0;
}
