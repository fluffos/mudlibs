//横扫千军
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon,ride;
	extra = 8+(int)me->query_skill("jinchui-hammer",1)/10;
	weapon = me->query_temp("weapon");

        if((int)me->query_skill("bixueforce") < 40 )
                return notify_fail("你的碧血心法不够高！\n");

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「横扫千军」只能对战斗中的对手使用。\n");

	if( (int)me->query("gin") < 200 )
		return notify_fail("你的精力不足，没有办法施展「横扫千军」。\n");

	ride = me->query_temp("ridee");
	if( ride ) msg = ride->query("id");  else msg = "\n";
	if( msg!="\n" && (ride->query_temp("rider")==me) && present(msg,environment(me)) )
	{
	me->add_temp("apply/damage",extra*3);
	me->add_temp("apply/dodge",extra*3);
	me->add_temp("apply/hammer",extra*3);
	}

	msg = HIR  "$N将手中的"+ weapon->name() +"在身前横向挥动，带起一片金铁轰鸣之声，\n
犹如元霸再世，正是那招「横扫千军」！\n" NOR;

	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);

	if( ride ) msg = ride->query("id");  else msg = "\n";
	if( msg!="\n" && (ride->query_temp("rider")==me) && present(msg,environment(me)) )
	{
	me->add_temp("apply/damage",-extra*3);
	me->add_temp("apply/dodge",-extra*3);
	me->add_temp("apply/hammer",-extra*3);
	}

	target->set("force_factor",0);
	if( !target->query_delay() )
	target->set_delay(extra);
	me->add("gin",-200);
	me->set_delay(1);
	return 1;
}
