// poqi.c 破气式
 
#include <ansi.h>
 
inherit SSERVER;
 
int perform(object me)
{
        string msg;
        object weapon, target;
        int skill, ap, dp, force_wound, kee_wound;

        me->clean_up_enemy();
        target = me->select_opponent();

        skill = me->query_skill("dg9-sword",1);

        if( !(me->is_fighting() ))
                return notify_fail("「破气式」只能对战斗中的对手使用。\n");
 
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");

        if((int)me->query("perform/huashan/poqi") < 1000 )
                return notify_fail("你还没有学会「破气式」！\n");

        if( me->query("force") < 200 )
                return notify_fail("你的内力不够，无法运用「破气式」！\n");
 
        msg = HIC "$N潜运独孤九剑「破气式」，运气贯剑使其由利返钝，毫无花俏地直刺$n的丹田。\n";
        message_vision(msg, me, target);
 
        ap = me->query_skill("sword") + skill;
        dp = target->query_skill("force") / 2;
        if( dp < 1 )
                dp = 1;
        if( random(ap) > dp )
        {
                if(userp(me))
                        me->add("force",-200);
                msg = "$N运起「破气式」, $n顿时觉得气海穴上一阵刺痛，\n";
                msg += "全身真气狂泄而出！\n" NOR;

                force_wound = 500 + random(skill);
                if(force_wound > target->query("force"))
                        force_wound = target->query("force");

                kee_wound = force_wound / 3;
                if(kee_wound > target->query("kee"))
                        kee_wound = target->query("kee");

                if((int)target->query("force") - force_wound < 0)
                        target->set("force",0);
                else target->add("force", -force_wound);
                target->receive_wound("kee", kee_wound);
                target->start_busy(2);
                me->start_busy(random(2));
        }
        else
        {
                if(userp(me))
                        me->add("force",-200);
                msg = "可是$n看破了$N的企图，立刻守紧门户，几经艰难终于还招挡开。\n"NOR;
                me->start_busy(3);
        }
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        return 1;
}

