// pozhang.c 「破掌式」
 
#include <ansi.h>
 
inherit SSERVER;
 
int perform(object me)
{
	string msg;
	object weapon, weapon2, target;
	int skill, ap, dp, wound, damage;

	me->clean_up_enemy();
	target = me->select_opponent();

	skill = me->query_skill("dg9-sword",1);

	if( !(me->is_fighting() ))
		return notify_fail("「破掌式」只能对战斗中的对手使用。\n");
 
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if (objectp(weapon2 = target->query_temp("weapon")))
		return notify_fail("对方没有空手，你用不了「破掌式」。\n");

	if((int)me->query("perform/huashan/pozhang") < 1000 )
		return notify_fail("你还没有学会「破掌式」！\n");

	if( me->query("force") < 80 )
		return notify_fail("你的内力不够，无法运用「破掌式」！\n");
 
	msg = HIC "$N使出独孤九剑之「破掌式」，剑化流星，迅急无比地点向$n的掌心。\n";
	message_vision(msg, me, target);
 
	damage = 100 + random(skill / 2);
	ap = me->query_skill("sword") + skill;
	dp = target->query_skill("unarmed") / 2;
	if( dp < 1 )
		dp = 1;
	if( random(ap) > dp )
	{
		if(userp(me))
			me->add("force",-50);
		msg = "结果$n被$p攻了个措手不及，掌根一痛，手掌";
		msg += HIC"几乎要被卸了下来！\n" NOR;

		target->receive_damage("kee", damage);
		target->start_busy(1);
//		weapon2->move(environment(me));
        }
	else
	{
		if(userp(me))
			me->add("force",-80);
		msg = "可是$n看破了$N的企图，迅即退开，使$N的「破掌式」没有起到作用。\n"NOR;
		me->start_busy(3);
	}
	if( !target->query_delay() && target->query_skill("unarmed",1) )
	{
	target->map_skill("unarmed");
	target->reset_action();
	target->set_delay(60);
	}

	message_vision(msg, me, target);
	COMBAT_D->report_status(target);
	return 1;
}