// pojian.c 破剑式

#include <ansi.h>

inherit SSERVER;

int perform(object me) {
  string msg;
  object weapon, weapon2, target;
  int skill, ap, dp, damage;

  me->clean_up_enemy();
  target = me->select_opponent();

  skill = me->query_skill("dg9-sword", 1);

  if (!(me->is_fighting()))
    return notify_fail("「破剑式」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if (!objectp(weapon2 = target->query_temp("weapon"))
    || (string)weapon2->query("skill_type") != "sword")
    return notify_fail("对方没有使剑，你用不了「破剑式」。\n");

  if ((int)me->query("perform/huashan/pojian") < 1000)
    return notify_fail("你还没有学会「破剑式」！\n");

  if (me->query("force") < 100)
    return notify_fail("你的内力不够，无法运用「破剑式」！\n");

  msg = HIC "$N默运独孤九剑之「破剑式」,手中" + weapon->name() + HIC "一抖，直削$n手腕。\n";

  if ((target->query_skill_mapped("force") == "liheforce") &&
    ((int)target->query_skill("liheforce", 1) > (int)me->query_skill("dg9-sword"))) {
    message_vision(msg, me, target);
    message_vision(CYN "\n但是$n施展出 [若即若离] ，$N的攻势莫名其妙地扑了个空！\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }

  message_vision(msg, me, target);

  damage = 100 + random(skill / 2);
  ap = me->query_skill("sword") + skill;
  dp = target->query_skill("sword") / 2;
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    if (userp(me))

      me->add("force", -100);
    msg = "$n顿时直觉手腕一凉，手中";
    msg += weapon2->name();
    msg += HIC "已脱手而出！\n" NOR;
    target->receive_damage("kee", damage);
    target->start_busy(1);
    weapon2->move(environment(me));
  } else {
    if (userp(me))
      me->add("force", -100);
    msg = "可是$n看破了$N的剑路，用手中" + weapon2->name() + "将$N的" + weapon->name() + "格开\n" NOR;
    me->start_busy(3);
  }
  if (!target->query_delay() && target->query_skill("sword", 1)) {
    target->map_skill("sword");
    target->reset_action();
    target->set_delay(60);
  }

  message_vision(msg, me, target);
  COMBAT_D->report_status(target);

  return 1;
}
