//jingtianyijian.c  written by john darks  
#include <ansi.h>
inherit SSERVER;
void jian(object me);
int perform(object me, object target)
{
        int skill = me->query_skill("bamohuantian",1);
        if( skill < 180 ) return notify_fail("你的八魔环天大法修为不够！\n");
        message_vision(HIR "$N深深地呼出一口气，整个人处于心神和一的境界．．．\n" NOR, me);
        me->set_temp("jtyj/jian",1);
        call_out("jian",1,me);
        return 1;
}

void jian(object me)
{
	int i;
	object *ob = users();
	object *enemy = me->query_enemy();
	object *inv =  all_inventory(environment(me));
	if (sizeof(enemy)){
		if( (me->query("kee") < 0 || me->query("eff_kee") < 0) && !me->query_temp("is_unconcious")){
			me->set("kee",10);
			me->set("eff_kee",me->query("max_kee"));
			message("vision",HIY"\n\n一道剑光突然自天际窜起，宛如天边的惊雷，划过天穹！\n\n"NOR,ob,inv);
			message("vision",HIY"\n一道剑光突然窜起，宛如天边的惊雷，划过天穹！\n"NOR,environment(me),me);
			for (i=0; i<sizeof(enemy);i++){
				if( me->query_temp("jtyj/jian") && enemy[i] && (environment(enemy[i]) == environment(me))&& me->is_fighting(enemy[i])){
					if(!enemy[i]->query_temp("jtyj/jian")){
						message("vision",HIR"那一剑重重的击中了" + enemy[i]->name() + HIR"的胸口！\n"NOR,environment(me),({me,enemy[i]}));
						tell_object(me,HIW"你昏迷前发出了惊天一剑！！\n"NOR);
						tell_object(enemy[i],HIR + me->name() +"昏迷前突然从一个极不可能的角度出剑，一剑刺中了你的胸口！\n"NOR);
						enemy[i]->unconcious();
					}else {
						message("vision",HIW + enemy[i]->name() + HIW"突然将剑一横，竟然神奇的架开那一剑！\n"NOR,environment(me),({me,enemy[i]}));
						tell_object(me,HIW"你昏迷前发出了惊天一剑！！\n"NOR);
						tell_object(enemy[i],HIY + me->name() +HIY"昏迷前突然从一个极不可能的角度出剑，但被你架开了！\n"NOR);
					}
				}
			}
			me->remove_all_killer();
			me->unconcious();
		}
	}
	call_out("jian",1,me);
}
 
