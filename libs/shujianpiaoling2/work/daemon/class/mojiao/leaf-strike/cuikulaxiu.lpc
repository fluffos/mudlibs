//cuikulaxiu.c 摧枯拉朽
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  object *inv;
  object weapon;
  int i, skill, kee;
  string msg;
  if (!me->is_fighting())
    return notify_fail("「摧枯拉朽」只能在战斗中使用。\n");
  if ((int)me->query_skill("leaf-strike", 1) < 60)
    return notify_fail("你的飞叶催心掌不够高，不能施展“摧枯拉朽”！\n");
  if ((int)me->query_skill("leaf-strike", 1) < 60)
    return notify_fail("你的含沙射影功不够高，不能施展“摧枯拉朽”！\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够。\n");
  if (!target || target == me) {
    target = offensive_target(me);
    if (!target) return notify_fail("你要对谁施展「摧枯拉朽」？\n");
  }
  if (!objectp(present("maple leaf", me)))
    return notify_fail("你身上没带枫树叶，如何施展绝招？\n");
  weapon = me->query_temp("weapon");
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if ((string)(inv[i]->query("id")) != "maple leaf")
      continue;
    if ((string)(inv[i]->query("id")) == "maple leaf")
      inv[i]->add_amount(-1);
  }
  skill = (int)me->query_skill("force", 1) + (int)me->query_skill("leaf-strike", 1);
  me->add("force", -200);
  msg = HIG "$N凝神定气，将全身功力注入于树叶之上，忽然翻掌一挥，树叶悄无声息地向$n后心飘去！\n" NOR;
  kee = target->query("kee");
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg, "瘀伤");

  if ((int)target->query_skill("nodeath_force") > (int)me->query_skill("leaf-strike")) {
    message_vision(CYN "\n结果树叶刚碰上$n身体就被震落在地上。\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }
  if ((int)target->query_skill("liumai_force") > (int)me->query_skill("leaf-strike")) {
    message_vision(CYN "\n结果树叶刚碰上$n身体就被震落在地上。\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }
  if ((int)target->query_skill("guiyu_force") > (int)me->query_skill("leaf-strike")) {
    message_vision(CYN "\n结果树叶刚碰上$n身体就被震落在地上。\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }
  if ((int)target->query_skill("liuhe-force") > (int)me->query_skill("leaf-strike")) {
    message_vision(CYN "\n结果树叶刚碰上$n身体就被震落在地上。\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }
  if (target->query_skill(
    "iron-cloth",
    1
  ) && target->query_skill("iron-cloth") < random(me->query_skill("unarmed") * 2)) {
    message_vision(HIR "\n结果$N强大的内劲催破了$n的真元！\n" NOR, me, target);
    target->receive_wound("kee", (int)me->query_skill("leaf-strike", 1) * 3);
    COMBAT_D->report_status(target, 1);
    me->start_busy(2);
    return 1;
  }

  if (kee > target->query("kee") + 100 && random(10) < 3) {
    message_vision(HIB "结果一击命中，一股暗劲渗入了$N的体内！！\n" NOR, target);
    target->receive_damage("sen", skill);
    target->receive_wound("kee", skill);
    COMBAT_D->report_status(target, 1);
  }
  me->start_busy(3);
  return 1;
}
