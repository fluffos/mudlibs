//myperform.c written by john darks
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
	string msg,pfmname;
	int extra,oldforce,FLAG,TYPE;
	object weapon;
	if (!me->query("my_perform/canpfm"))
		return notify_fail("你还没有将自创技融会贯通。\n");
	pfmname = me->query("my_perform/name");
	if (!pfmname){
		pfmname = "[ 笑对长天 ]";
		TYPE = -1;
	}else 	TYPE = me->query("my_perform/type");
	msg = pfmname + "只能对战斗中的对手使用。\n";
	if( !target ) target = offensive_target(me);
	if( !target  
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(msg);
	weapon = me->query_temp("weapon");
	if (!objectp(weapon)){
		FLAG = 0;
		oldforce = me->query("force");
		extra = me->query_skill("unarmed")/10;
		me->add("force_factor",extra * 5);
		me->add("force",me->query("force_factor") * 10);
	}else{
		FLAG = 1;
		extra = me->query_skill(weapon->query("skill_type"))/2;
		me->add_temp("apply/damage",extra);
	}
	switch(TYPE){
		case (-1):	//缺省状态
			message_vision(HIR"$N"+HIR"仰天长笑，发出自创的绝技 [笑对长天]，一招四式连环攻向$n！\n"NOR,me,target);
			me->add_temp("apply/attack", extra);
			msg = HIW"
  ;;,,,, ;;,,,,
  ;' ';  ;' ';
       ,;;,
    ,;';; 
 ,,,,,,;;,,,,;,
      ,;;,  
     ;'  ;,	 	
    ;'	  ;,		
  ,; 	   ;;,		
    	    '		
    	    		"NOR;
     			COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
			msg = HIY"
	     , 	
            ;; 
 ,,,,,;, ,,,;;,;, 
 ';  ,;     ;;
   ; ;  ',  ;;
   ;';   '; ;;
  ;' ';     ;;
 ;'   ';    ;;	
           ';' 	
  	   		"NOR;
     			COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
     			msg = HIC"
    ,     			
   ;;   ,;,         
   ;; ,;''          
 ,,;;;,,,,,,,;,     
   ;;',   
   ;; ';, 
   ;;   ';,   
   ;;  	  ';,	
   ';'	   		
  	   		"NOR;
     			COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
     			msg = HIR"
  
    ,,,,,,,,,;,  
        ;; 
 ,,,,,,,;;,,,,,,;,  
       ;;' 
      ,;  ',
     ,;	   ;,	
    ,;'     ';;	
   ;'	      ;;, 	
			"NOR;
     	    		COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
 	   		me->add_temp("apply/attack", -extra);
			break;
		case 0:
			break;		
		case 1:
			break;
	}
	if (!FLAG){
		me->set("force",oldforce);
		me->set("force_factor",0);
	}else{
		me->add_temp("apply/damage",- extra);
	}
	me->start_busy(2);
	return 1;
}
