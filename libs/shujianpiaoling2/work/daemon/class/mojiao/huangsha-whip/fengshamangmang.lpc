//fengshamangmang.c 风沙莽莽
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［风沙莽莽］只能对战斗中的对手使用。\n");
        weapon = me->query_temp("weapon");
        extra = me->query_skill("huangsha-whip",1);
        if( extra <= 90) return notify_fail("你的黄沙万里鞭法还不够熟练！\n");
        if( (int)me->query("force") < 200 )
                return notify_fail("你的内力不够！\n");
        me->add_temp("apply/attack", extra/10); 
        me->add_temp("apply/damage", extra/10);
       target->add_temp("apply/iron-cloth", -extra);

        msg = HIR  "$N力灌鞭梢，手中的"+weapon->query("name")+"纵横飞舞，带起了满地尘沙！" NOR;
        msg += HIG  "\n尘沙随风扬起，挟着一股劲力象一把把利刃般割刺着$n的手脸和衣襟！" NOR;
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
        me->add_temp("apply/attack", -extra/10);
        me->add_temp("apply/damage", -extra/10);
        me->add("force", -100);
       target->add_temp("apply/iron-cloth", extra);

        me->start_busy(3);
        if( !me->query_temp("mojiao/fengsha") ) 
        call_out("brave_up", 5, me, target);
        me->set_temp("mojiao/fengsha", 1);
        return 1;
}

void brave_up(object me, object target)
{
	if( !target || !me
	||	!target->is_character()
	||	!me->is_fighting(target) )
	{
        	call_out("stop_atk", 1, me);
		return;
	}
        message_vision(HIG"\n尘沙随风扬起，挟着一股劲力象一把把利刃般割刺着$N的手脸和衣襟！\n\n" NOR, target);
        target->receive_wound("kee", 10 + random(40));
        COMBAT_D->report_status(target,1);
        if( (int)me->query("force") < 200 )
        	call_out("stop_atk", 2, me);
        else {
        	me->add("force", -100);
      		call_out("brave_up", 6, me, target);
      	}
}

void stop_atk(object me)
{
	if( !me ) return;
        me->delete_temp("mojiao/fengsha");
        tell_object(me, CYN"你的［风沙莽莽］施展完毕，漫天风沙都在一瞬间消失了。\n"NOR);
        me->start_busy(1);
}
