mapping last_action1 = ([      "action":               
"只见$N脸上发出阵阵的淡紫色,发出了剑法的最高境界\n"
"一招"+HIW"「月既不解饮，影徒随我身」"NOR+"，$w在天际划出一个光狐,劈向$n的",
                  "skill_name" : "月既不解饮，影徒随我身",
                  "force" : 520,
                  "dodge" : -50,
                  "parry" : -50,
                  "damage": 160,
                 "damage_type": "劈伤"
        ]);

mapping last_action2 = ([      "action":               
"$N一声厉啸，$w贯满了全身的真气"
"剑脊发出阵阵的呜咽的声音,一招"+HIW"「永结无情游，相期邈云汉」"NOR+"刺向$n的$l",
                  "skill_name" : "永结无情游，相期邈云汉",
                  "dodge": -180,
                  "force" : 580,
                   "parry" : -175,
                  "damage": 150,
                  "damage_type": "刺伤"
        ]);

int valid_learn(object me)
{
        object ob;
        string dodskill;
        if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力不够，没有办法练独酌剑法。\n");
        dodskill = (string) me->query_skill_mapped("dodge");
        if ( dodskill != "literate" || (int)me->query_skill("literate",1)<100)
                return notify_fail("独酌剑法要和文才相配合,才能领悟到其中的意境.\n");
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能学习剑法。\n");
       if( (int)me->query_skill("sword",1)/2 < (int)me->query_skill("duzhuo_sword",1)/3 )
                return notify_fail("你的基本剑法功夫根基不够，无法修习。\n");
        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	 if(me->query_skill("duzhuo_sword",1)>=150 && random(3)>1 )
	      return last_action2;
	 if(me->query_skill("duzhuo_sword",1)>=200 && random(3)>1 )
	      return last_action1;
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
         int skill,combat_exp;
        object ob;
         skill = me->query_skill("duzhuo_sword",1);
         combat_exp=(int)me->query("combat_exp");
         skill=(int)me->query_skill("literate", 1);

        if( skill*skill*skill/10 > combat_exp )
          return notify_fail("你的实战经验不够，无法练习独酌剑法.\n");        
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练习剑法。\n");
 if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return 
        notify_fail("你太累了，没有办法再练习独酌剑法了。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你练了一遍,果然有了提高。\n");
        return 1;
}
        
string perform_action_file(string action)
{
        return CLASS_D("swordsman") + "/duzhuo_sword/" + action;
}

string *parry_msg = ({
       
        "$n挥动手中$v连削带打，令$N的$w无法靠近。\n",
        "$n手中的$v化做一团寒光，荡开了$N的$w。\n",
        "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
        "$n不退反进，$v直刺$N\n",
 "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int effective_level() { return 15;}

int learn_bonus()
{
        return -10;
}
int practice_bonus()
{
        return -5;
}
int black_white_ness()
{
        return -20;
}

