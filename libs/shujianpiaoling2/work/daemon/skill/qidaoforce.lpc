// 棋道心法
#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }
string skill_cname()
{
	return "棋道心法";
}

void skill_improved(object me)
{
	int s;
	
	s = me->query_skill("qidaoxinfa", 1);
	if( s >= 300 )
		{
		tell_object(me, "你的棋道心法已经无法再提高了。\n" NOR);
		me->set_skill("qidaoxinfa", s-1);
		return;
		}
	if((int)me->query("kar") < s/4) {
		tell_object(me, HIW "由於你勤学棋道心法，你的运气提高了。\n" NOR);
		me->add("kar", 1);
	}
}

int learn_bonus()
{
	return 20;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 0;
}

