// 战船攻击

inherit SKILL;
string skill_cname()
{
	return "战船攻击";
}

mapping *action = ({
	([	"action":		"我军水师战船向敌军船舰开炮。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"倭船向我军水师战船开炮。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"我军水师快速战船向敌军发起冲锋。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"我军水师先锋战船与敌船短兵相接，水军将士登上敌船与倭寇展开厮杀。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"我军水师战船向敌倭船发射火箭。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"倭船向我军水师战船发射火铳。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"我军水师战船向敌倭船发射连弩。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"倭船逼近我军水师战船，倭寇与我军展开肉搏。",
		"dodge":		0,
		"damage_type":	"瘀伤"
	]),
});

int valid_learn(object me)
{
	object ob;

	if( (int)me->query("max_force") < 0 )
		return notify_fail("你的不够，没有办法练法。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage=="unarmed" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int effective_level() { return 1;}

string *parry_msg = ({
	"轰地一声，炮弹击中倭寇船舷，立时将船身炸了个大洞。\n",
	"敌军火箭击中我军水师战船，船上立时着起火来。\n",
	"敌军炮弹击中我军水师战船，船桅立刻折为两段。\n",
	"我军炮弹击中敌倭船船舱，将敌船打得碎片纷飞，船员伤亡严重。\n",
	"敌军炮火击中我军战船，顿时将我军将士打得血肉模糊。\n",
	"我军火箭射中敌船，敌倭船立刻变成了一条火龙。\n",
	"我军连弩纷纷射中敌寇，敌将士从船上纷纷跌落水中，被射伤淹死的不计其数。\n",
	"敌军投石器发射的石块击中我船尾，船尾立时折断。\n",
	"敌一艘倭船冒着浓烟，仓皇逃遁。\n",
	"我军一艘战船进水过多，终于渐渐沉入了海底。\n"
});

string *unarmed_parry_msg = ({
	"轰地一声，炮弹击中倭寇船舷，立时将船身炸了个大洞。\n",
	"敌军火箭击中我军水师战船，船上立时着起火来。\n",
	"敌军炮弹击中我军水师战船，船桅立刻折为两段。\n",
	"我军炮弹击中敌倭船船舱，将敌船打得碎片纷飞，船员伤亡严重。\n",
	"敌军炮火击中我军战船，顿时将我军将士打得血肉模糊。\n",
	"我军火箭射中敌船，敌倭船立刻变成了一条火龙。\n",
	"我军连弩纷纷射中敌寇，敌将士从船上纷纷跌落水中，被射伤淹死的不计其数。\n",
	"敌军投石器发射的石块击中我船尾，船尾立时折断。\n",
	"敌一艘倭船冒着浓烟，仓皇逃遁。\n",
	"我军一艘战船进水过多，终于渐渐沉入了海底。\n"
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action)
{
        return CLASS_D("guanfu") + "/other_skills/" + action;
}


