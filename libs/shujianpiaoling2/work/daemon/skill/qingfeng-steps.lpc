// qingfeng-step.清风步法

#include <ansi.h>		
inherit SKILL;
string skill_cname()
{
	return "清风步法";
}

string *dodge_msg = ({
	"$n身子微微一斜，后脚一踢，身子斜掠了出去。\n",
     	"$n身子一折，双脚一蹬地面，身体拔高数尺，躲了开去。\n",
	"$n借着$N送来的力道，飘出一丈开外。\n",
	"$n提气一纵，身子一个倒翻，从$N的头顶越过。\n",
	"$n突然身子急转，在$N的身旁旋走，把$N弄了个眼花缭乱。\n",
	"$n身子微微一绻，身子从$N的身旁急纵而走。\n",
});

int valid_enable(string usage) { return (usage=="dodge") || (usage=="move"); }

int valid_learn(object me)
{
	if( (int)me->query("spi") <= 10 )
		return notify_fail("你的灵性不够，没有办法练清风步法。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 20 )
		return notify_fail("你的体力太差了，不能练习清风步法。\n");
	me->receive_damage("kee", 20);
	return 1;
}
int effective_level() { return 10;}

int learn_bonus()
{
	return 20;
}
int practice_bonus()
{
	return 25;
}
int black_white_ness()
{
	return 100;
}
string perform_action_file(string action)
{
        return CLASS_D("luoyue") + "/qingfeng-steps/" + action;
}

