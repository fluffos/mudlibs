//风卷残云功
inherit FORCE;
string skill_cname()
{
	return "风卷残云功";
}

int valid_enable(string usage) { return usage=="force"; }
int valid_learn(object me) { return 1; }
string force_type() { return "yang_force"; }

int practice_skill(object me)
{
        return 
notify_fail("风卷残云功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
        return CLASS_D("gaibang") + "/canyun_force/" + func;
}
 
int effective_level() { return 21;}

int learn_bonus()
{
	return 10;
}
int black_white_ness()
{
	return 20;
}

