// 【金锤八打】

inherit SKILL;
string skill_cname()
{
	return "金锤八式";
}
mapping *action = ({
        ([      "action":
"$N大喝一声，施展一招「泰山压顶式」，手中$w带着这一吼的威猛之势，朝$n当头砸下",
                "damage":               45,
                "dodge":                20,
                "parry":                -15,
                "post_action":  (: call_other, WEAPON_D, "bash_weapon" :),
                "damage_type":  	"挫伤",
		"name":			"泰山压顶式",
        ]),
        ([      "action":
"$N施展一招「苏秦背箭式」，顺势带过大锤，趁$n一愣之际，以锤柄向$n面门疾戳",
                "damage":               25,
                "dodge":                20,
                "parry":                -15,
                "damage_type": 		"刺伤",
		"name":			"苏秦背箭式", 
       ]),
        ([      "action":
"$N施展一招「流星赶月式」，翻转锤头，手中$w划出一道银弧，奔着$n的脑袋横扫而至",
                "damage":               40,
                "dodge":                20,
                "parry":                -15,
                "post_action":  (: call_other, WEAPON_D, "bash_weapon" :),
                "damage_type": 		"挫伤",
		"name":			"流星赶月式", 
        ]),
	([       "action":
"$N施展一招「乳燕穿林式」，趁$n换招中的空隙，以锤柄向$n的$l狠狠戳了下去",
                "damage":               30,
                "dodge":                -20,
                "parry":                15,
                "damage_type": 		"刺伤", 
		"name":			"乳燕穿林式", 
        ]),
        ([      "action":
"$N施展一招「海底捞月式」，沉下锤头，手中$w由下而上，奔着$n的下巴横扫而至",
                "damage":               35,
                "dodge":                10,
                "parry":                -15,
                "post_action":  (: call_other, WEAPON_D, "bash_weapon" :),
                "damage_type": 		"挫伤",
		"name":			"海底捞月式", 
        ]),
        ([      "action":
"$N大喝一声，施展一招「万马奔腾式」，手中$w带着这一吼的威猛之势，朝$n当胸直砸",
                "damage":               55,
                "dodge":                -20,
                "parry":                -15,
                "post_action":  (: call_other, WEAPON_D, "bash_weapon" :),
                "damage_type":  	"挫伤",
		"name":			"万马奔腾式",
        ]),
        ([      "action":
"$N施展一招「霸王卸甲式」，手中$w交叉护住前胸，同时朝外挥去",
                "damage":               15,
                "dodge":                -10,
                "parry":                -35,
                "post_action":  (: call_other, WEAPON_D, "bash_weapon" :),
                "damage_type": 		"挫伤",
		"name":			"霸王卸甲式", 
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (string)me->query_skill_mapped("force")!= "bixueforce")
	return notify_fail("金锤八式需配合碧血心法才可发挥威力。\n");
        if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力不够，无法随意挥动一柄大锤。\n");
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "hammer" )
                return notify_fail("手里没有大锤怎么能领悟师父所教的奥妙呢？\n");
        return 1;
}
int effective_level() { return 18;}

int valid_enable(string usage)
{
        return (usage=="hammer") || (usage=="parry");
}
mapping query_action(object me, object weapon)
{
    int total=3, current;
    if (me->query_skill("jinchui-hammer", 1) > 60)
	total=6;
    return action[random(total)];
}
 
int practice_skill(object me)
{
        object weapon;
 
        if( (string)me->query_skill_mapped("force")!= "bixueforce")
	return notify_fail("金锤八式需配合碧血心法才可发挥威力。\n");
        if( !objectp(weapon = me->query_temp("weapon"))
        ||      (string)weapon->query("skill_type") != "hammer" )
                return notify_fail("手中无锤，如何练习锤法？\n");
 
        if( (int)me->query("kee") < 50 
        ||    (int)me->query("force") < 30)
                return notify_fail("你的体力不够练金锤八式，还是先休息休息吧。\n");
        me->receive_damage("kee", 50);
        me->add("force", -30);
        write("你按着所学练了一遍金锤八式。\n");
        return 1;
}
string *parry_msg = ({
	"$n使出金锤八式中的“霸王卸甲式”，手中的$v交叉护住前胸。\n",
});

string *unarmed_parry_msg = ({
        "$n使出金锤八式中的“霸王卸甲式”，双手交叉护住前胸。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
 
string perform_action_file(string action)
{
        return CLASS_D("guanfu") + "/jinchui-hammer/" + action;
}
void skill_improved(object me)
{
      if( (int)me->query_skill("jinchui-hammer", 1) % 10 == 0 ) 
        {
	tell_object(me, "\n你练锤过勤，受了点内伤。");
            me->add("max_force", -(int)(me->query_skill("jinchui-hammer",1)/10));
        }
	return;
}
