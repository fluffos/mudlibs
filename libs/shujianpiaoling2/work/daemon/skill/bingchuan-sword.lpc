//冰川剑法
inherit SKILL;
string skill_cname()
{
	return "冰川剑法";
}

mapping *action = ({
	([	"action":		"$N使出冰川剑法中的起手式“积水凝冰”，手中的$w划出一溜光芒斩向$n的$l",
		"force":		500,
             "damage":               30,
		"damage_type":	"刺伤"
	]),
	([	"action":		"$N手一抖，一招“雪花六出”手中的$w幻成一片剑花，散向$n的$l",
		"force":		300,
             "damage":               30,
		"damage_type":	"刺伤"
	]),
	([	"action":		"$N剑锋忽转，手中的$w一招“雪拥蓝关”，闪电般劈向$n的$l",
		"force":		200,
             "damage":               30,
		"damage_type":	"割伤"
	]),
	([	"action":		"$N身影晃动，剑锋忽左忽右，一招“怒卷霜雪”，手中的$w，从中路突然袭至$n的$l",
		"force":		300,
             "damage":               40,
		"damage_type":	"刺伤"
	]),
	([	"action":		"$N的双脚点地，剑背贴身，一招“寒潮匝地”全身转出一团剑光滚向$n",
		"force":		200,
             "damage":               40,
		"damage_type":	"割伤"
	]),
	([	"action":		"$N剑锋向上，一招“倒卷冰河”，从一个$n意想不到的角度撩向$n的$l",
		"force":		200,
             "damage":               50,
		"damage_type":	"割伤"
	]),
	([	"action":		"$N你手中的$w左右横划，一招“冰河解冻”，来来回回地狂扫向$n的$l",
		"force":		100,
             "damage":               50,
		"damage_type":	"割伤"
	]),
        ([      "action":               "$N使出冰川剑法中的收手式“飞瀑流泉”，手中的$w迅捷无比地刺向$n的$l",
                "force":                500,
                "damage":               50,
                "damage_type":  "刺伤"
        ]),
});

int valid_learn(object me)
{
        if( (int)me->query_skill("force", 1) < 10 )
                return
                notify_fail("你的内功心法火候不足，无法练冰川剑法。\n");
        if( (int)me->query_skill("xuanyinforce", 1) < 60 )
                return
		notify_fail("你的大五行玄阴气功火候不足，无法练冰川剑法。\n");
	return 1;
}

int need_biguan()
{
	return 1;
}

int valid_enable(string usage)
{
	return (usage=="sword") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	object weapon;

	if( !objectp(weapon = me->query_temp("weapon"))
	||	(string)weapon->query("skill_type") != "sword" )
		return notify_fail("你必须先找一把剑，才能练剑法。\n");

	if( (int)me->query("kee") < 40 )
		return notify_fail("你的体力不够练这门剑法，还是先休息休息吧。\n");
	me->receive_damage("kee", 40);
	return 1;
}
int effective_level() { return 20;}

string *parry_msg = ({
	"$n使出冰川剑法中的“千里冰封”，手中的$v化成一片剑网护住全身。\n",
});

string *unarmed_parry_msg = ({
        "$n使出冰川剑法中的“千里冰封”，双指化剑挥动成一片剑网护住全身。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return -5;
}
int black_white_ness()
{
	return 20;
}

string perform_action_file(string action)
{
        return CLASS_D("xueshan") + "/bingchuan-sword/" + action;
}

