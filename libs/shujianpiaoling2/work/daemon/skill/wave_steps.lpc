//凌波微步
#include <ansi.h>
inherit SKILL;
string *dodge_msg = ({
  "$n淡淡的一笑,脚踏MSG身形急转，渺然已逝。\n",
  "$n轻啸一声，足尖点地，身形飘然而起落向MSG。\n",
  "$N眼前一花，$n的身影乍分乍合，迈向MSG已然失却踪影。\n",
  "$n面对来招面不改色，突然间一收腹，往后飘落了一寸急踏MSG避过了这招。\n",
  "$n潇洒的一笑，不退反进，趁你$N个破绽，踏上MSG蹂身而上，$N急忙收招自。\n",
  "$n一声长啸，宛若流云瞬间踏到MSG，$P的杀招一下子失却了目标。\n",
  "$n背负双手，潇洒来去，刀光剑影均视若不见堪堪踏上MSG，$N百思不得其解身形顿搓。\n",
  "$n身体不可思议的弯转了过去，倒踏MSG避过了这一招。\n",
  "$n无法格挡，脑袋微侧，足下自然而然的斜踏MSG,竟然避过了$N的攻击。\n",
  "$n膝盖微曲，左足斜斜缓踏MSG，堪堪避过$N的进攻。\n",
});

string skill_cname() {
  return "凌波微步";
}

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) {
  if (me->query("family/family_name") != "逍遥派")
    return notify_fail("你只觉得凌波微步太简单，但就是没法运用。\n");
  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力修为太浅，没有办法练凌波微步。\n");
  if ((int)me->query("spi") < 20)
    return notify_fail("你的灵性不够，没有办法学习凌波微步。\n");
  return 1;
}


string query_dodge_msg(string limb) {
  string msg;
  string *name = ({
    HIC "「讼位」" NOR,
    HIC "「井位」" NOR,
    HIC "「无妄」" NOR,
    HIC "「家人」" NOR,
    HIC "「明夷」" NOR,
    HIC "「既济」" NOR,
    HIC "「蛊位」" NOR,
    "「泰位」",
    HIC "「中孚」" NOR,
    HIC "「坤位」" NOR,
    HIC "「壬癸」" NOR,
    HIC "「妗母」" NOR,
    HIC "「亥活」" NOR
  });
  msg = dodge_msg[random(sizeof(dodge_msg))];
  msg = replace_string(msg, "MSG", name[random(sizeof(name))]);
  return msg;
}

int practice_skill(object me) {
  int lb, dg;
  lb = (int)me->query_skill("wave_steps", 1);
  if ((int)me->query("kee") < 30)
    return notify_fail("你的气太少了，不能练凌波微步。\n");
  me->receive_damage("kee", 30);
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("xiaoyao") + "/wave_steps/" + action;
}

int effective_level() { return 20; }

int learn_bonus() {
  return -350;
}
int practice_bonus() {
  return -250;
}
int black_white_ness() {
  return -50;
}

mixed max_dodge(object me, object target, int dodge, int attack) {
  int bm_lvl, level;
  bm_lvl = me->query_skill("beiming-force", 1);
  level = me->query_skill("wave_steps", 1);
  if (random(bm_lvl) > 100) {
    tell_object(me, BLU "你的北冥真气应运而生，生生流转不熄，气血渐渐恢复充盈。\n" NOR);
    me->receive_heal("kee", bm_lvl / 5);
  }
  if (random(level) > 100 && me->is_busy() && (me->query("force") - me->query("max_force") > 200)) {
    me->remove_busy();
    me->add("force", -200);
    return HIC "$n轻点方位，身形飘渺如一股轻烟，围绕$N衔枚急走，却无迹可寻，$N顿时不知所措。\n" NOR;
  }
  return 0;
}
