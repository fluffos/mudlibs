// honey.c

#include <ansi.h>

inherit SKILL;
string skill_cname()
{
	return "花艺";
}

string type() { return "knowledge"; }

void skill_improved(object me)
{
        int s;

        s = me->query_skill("honey", 1);
        if((int)me->query("per") < s/4) {
                tell_object(me, HIW "通过对花艺的修习，你的魅力提高了。\n" NOR);
                me->add("per", 1);
        }
}

int learn_bonus()
{
        return 20;
}
int practice_bonus()
{
        return 0;
}
int black_white_ness()
{
        return 0;
}

