// watersong.c

#include <ansi.h>

inherit SKILL;
string skill_cname()
{
	return "似水流音";
}

string type() { return "knowledge"; }

void skill_improved(object me)
{
        int s;

        s = me->query_skill("watersong", 1);
        if((int)me->query("daode_point") < s/2) {
                tell_object(me, HIW "通过对 [似水流音] 的修习，你的道德增加了。\n" NOR);
                me->add("daode_point", 1);
        }
}

int learn_bonus()
{
        return 20;
}
int practice_bonus()
{
        return -10;
}
int black_white_ness()
{
        return -10;
}

