// shaolin-step.c蜻蜓点水提纵术

inherit SKILL;
string skill_cname()
{
	return "蜻蜓点水提纵术";
}

string *dodge_msg = ({
    "$n一招「达摩渡江」轻轻巧巧地避了开去。\n",
    "只见$n身影一晃，一式「如影随形」早已避在八尺之外。\n",
    "$n使出「无影无踪」，$N眼睛一花，早找不到$n的去处。\n",
    "$n使出「如来迈步」，贴着地面向后飘了开去。\n",
    "$n左足一点，一招「佛祖身形」腾空而起，避了开去。\n",
    "可是$n使一招「腾空飞跃」, 身子高高纵起。\n",
    "$n身形不动, 竟然藉一招「分身化影」飘了开去。\n",
    "但是$n一招「观音化身」使出，早已绕到$N身後。\n"
});

int valid_enable(string usage)
{
	return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
	if( (int)me->query("max_force") < 50 )
        return notify_fail("你的内力不够，没有办法学蜻蜓点水提纵术。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
        return notify_fail("你的气或内力不够，不能练蜻蜓点水提纵术。\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	return 1;
}
int effective_level() { return 17;}

string perform_action_file(string action)
{
        return CLASS_D("shaolin") + "/shaolin-dodge/" + action;
}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 20;
}
