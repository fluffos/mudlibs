// taiji-ken.c

inherit SKILL;
string skill_cname()
{
	return "太极拳法";
}

mapping *action = ({
	([	"action":
"$N右手如钩，轻灵飘拂，使一招「单鞭」，左手出奇不意向$n的$l击去",
		  "parry":	-20,
		  "dodge":	-40,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N使出一招「搬拦肘」，左手由掌变拳，右勾手顺缠变拳，一先一后猛击$n$l",
		  "parry":	-20,
		  "dodge":	-80,
		  "force": 	70,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N两掌缠着$n双手，劲力一吐，一招「煞腰压肘拳」击向$n的$l",
		  "parry":	-10,
		  "dodge":	-80,
		  "force": 	280,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N使出一招「风扫梅花」，双掌分飞，如风车般向$n$l攻去",
		  "parry":	-40,
		  "dodge":	-70,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N左手转动，右拳使出「撇身捶」向$n当头击下",
		  "parry":	-20,
		  "dodge":	-30,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N使出一招「翻花舞袖」，轻灵跃起，双掌顺缠虚劈，击向$n的$l",
		  "parry":	-60,
		  "dodge":	-100,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N双臂逆缠蓄劲待发，猛然使一招「掩手肱拳」，劲力急吐，打向$n$l",
		  "parry":	-10,
		  "dodge":	-30,
		  "force": 	200,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N使一招「连珠炮」，手缠腿铲，猛攻$n上中下三路",
		  "parry":	-40,
		  "dodge":	-60,
		  "force": 	60,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N身形一转，左掌虚劈，右掌自下而上挥出，使一招「白蛇吐信」击向$n$l",
		  "parry":	-20,
		  "dodge":	-40,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N使一招「海底翻花」，双拳缠劈，制住$n两臂，左脚蹬向$n的下盘",
		  "parry":	-20,
		  "dodge":	-90,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N左掌虚划，右拳从掌影中穿出，来一招「撇身捶」打向$n的$l",
		  "parry":	-40,
		  "dodge":	-50,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N使出「伏虎式」，左手击向$n的胸口，右手击$n的头部",
		  "parry":	-10,
		  "dodge":	-30,
		  "force": 	50,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N左掌连使两个虚招，右拳来一招「黄龙三搅水」打向$n$l",
		  "parry":	-20,
		  "dodge":	-60,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N突然使出「旋风腿」，闪电般向$n$l连环踢出",
		  "parry":	-40,
		  "dodge":	-70,
		  "force": 	120,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N左手吊手变掌自上而下划弧，右掌从弧中穿出，一记「玉女穿梭」劈向$n$l",
		  "parry":	-30,
		  "dodge":	-60,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N两肘下沉运劲，右脚一铲，紧接着右臂使一招「穿心肘」，猛击$n的胸口",
		  "parry":	-30,
		  "dodge":	-60,
		  "force": 	180,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N看准机会使一招「白猿献果」，右拳勾击$n的下巴",
		  "parry":	-10,
		  "dodge":	-30,
		  "force": 	50,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N一招「白鹤亮翅」，右掌向上斜飞，左掌出奇不意削向$n头部",
		  "parry":	-20,
		  "dodge":	-60,
		  "force": 	20,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N双掌如抱琵琶，来一招「手挥琵琶」，向$n$l连击数掌",
		  "parry":	-20,
		  "dodge":	-60,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N使出「野马分鬃」，运劲如风，双掌成弧形连环击向$n$l",
		  "parry":	-20,
		  "dodge":	-50,
		  "force": 	40,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N马步沉稳，双臂紧紧缠住$n，突然双臂一抖，使出「青龙出水」打向$n$l",
		  "parry":	-20,
		  "dodge":	-60,
		  "force": 	50,
		  "damage_type":  "瘀伤"
	]),
	([	"action":
"$N使一招「弯弓射虎」，双掌由绕变拳，右拳护身，左拳猛击$n的$l",
		  "parry":	-20,
		  "dodge":	-20,
		  "force": 	150,
		  "damage_type":  "瘀伤"
	]),
});

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练太极拳必须空手！\n");
        return 1;
}

int valid_enable(string usage)
{
        return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
string perform_action_file(string action)
{
        return CLASS_D("wudang") + "/taiji-ken/" + action;

}
int effective_level() { return 13;}
int practice_skill(object me)
{
        if( (int)me->query("kee") < 30 )
                return notify_fail("你的体力不够了，休息一下再练吧。\n");
        me->receive_damage("kee", 30);
        return 1;
}
