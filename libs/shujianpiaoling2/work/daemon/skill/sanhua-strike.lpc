// sanhua-stike.c  散花掌

inherit SKILL;
string skill_cname()
{
	return "散花掌";
}

mapping *action = ({
    ([  "action":  "$N合掌抱球，一式「春深芳草尽」，双掌变幻吞吐，缓缓推向$n的$l",
        "dodge":   -30,
        "parry":   -20,
		"damage":   20,
        "force":   100,
        
         "damage_type": "瘀伤"
        ]),
    ([  "action":  "$N五指绽开，一式「夏闲独兰馨」，左右掌穿插翻飞，疾向$n的$l拍去",
        "dodge":   -20,
        "parry":   -30,
		"damage":   30,
        "force":   120,
        
        "damage_type":  "瘀伤"
        ]),
    ([  "action":  "$N使一式「秋酣菊霜清」，左掌虚托，右掌乍伸乍合，猛地插往$n的$l",
        "dodge":   -40,
        "parry":   -30,
		"damage":   40,
        "force":   140,
        
        "damage_type":  "瘀伤"
        ]),
     ([  "action": "$N双掌血红，一式「冬卧听梅吟」，幻成漫天梅花朵朵，雨点般向$n击去！",
        "dodge":   -50,
        "parry":   -50,
		"damage":   60,
        "force":   160,
        
        "damage_type":  "瘀伤"
        ]),
});


int valid_learn(object me)
{
    if( (int)me->query("max_force") < (int)me->query_skill("sanhua-strike")*10 )
        return notify_fail("你的内力修为不足，无法修习更高深的散花掌。\n");
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练散花掌必须空手。\n");
    return 1;
}

int valid_enable(string usage)
{
    return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
string *parry_msg = ({
        "$n以守为攻，猛击$N握$w的手腕。\n",
});

string *unarmed_parry_msg = ({
        "$n左掌击下，右掌自保，将$N封于尺外。\n",

});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}


int practice_skill(object me)
{

    if( (int)me->query("kee") < 40 )
        return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
        me->receive_damage("kee", 40);
        return 1;
}
int effective_level() { return 16;}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 20;
}
string perform_action_file(string action)
{
        return CLASS_D("shaolin") + "/strike/sanhua-strike/" + action;
}
