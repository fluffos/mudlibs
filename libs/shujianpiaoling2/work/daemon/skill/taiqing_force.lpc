// 太清玄功

inherit SKILL;

int valid_enable(string usage) { return usage == "force"; }
string skill_cname() {
  return "太清玄功";
}
string force_type() { return "yin_force"; }

int valid_learn(object me) {
  if ((int)me->query_skill("force") < (int)me->query_skill("taiqing_force"))
    return notify_fail("你的基本内功修为不够，无法领会更高深的太清玄功。\n");

  return 1;
}

int practice_skill(object me) {
  return notify_fail("太清玄功只能用学习，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {
  return CLASS_D("emei") + "/taiqing_force/" + func;
}
int effective_level() { return 10; }

int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return 10;
}
int black_white_ness() {
  return 20;
}
