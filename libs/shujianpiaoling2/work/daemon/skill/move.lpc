// move.c

#include <ansi.h>
inherit SKILL;
string skill_cname()
{
	return "基本轻功";
}

void skill_improved(object me)
{
        int s;

        s = me->query_skill("move", 1);
        if( (int)me->query("agi") < s/4) {
                tell_object(me, HIW "由於你勤练轻功，你的速度提高了。\n" NOR);
                me->add("agi", 1);
        }
}
int valid_learn(object me)
{
	if( (int)me->query("p_power_rank") < (int)me->query_skill("move",1) * 3
		&& (int)me->query_skill("move",1) > 30)
        return notify_fail("你的武学积累不足，没有办法领会更高的轻功神行术。\n");
	return 1;
}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 0;
}

