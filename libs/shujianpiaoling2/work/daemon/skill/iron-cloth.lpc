// iron-cloth.c

inherit SKILL;
#include <ansi.h>
string skill_cname()
{
	return "铁布衫硬功";
}

void skill_improved(object me)
{
        int s;

        s = me->query_skill("iron-cloth", 1);
        if( (int)me->query("fle") < s/4) {
                tell_object(me, HIW "由於你勤练铁布衫，你的韧性提高了。\n" NOR);
                me->add("fle", 1);
        }
}
string *absorb_msg = ({
	"$n已有准备，不慌不忙的运起铁布衫。\n",
        "$n闭目凝神，气走全身，护体硬功达到巅峰状态。\n",
        "$n「嘿」的一声，不躲不闪，运起铁布衫迎向$N！\n",
});

string query_absorb_msg()
{
	return absorb_msg[random(sizeof(absorb_msg))];
}
int valid_learn(object me)
{
	if( (int)me->query("p_power_rank") < (int)me->query_skill("iron-cloth",1) * 3
		&& (int)me->query_skill("iron-cloth",1) > 30)
        return notify_fail("你的武学积累不足，没有办法领会更高的铁布衫硬功。\n");
	if( (int)me->query("life_exp") < (int)me->query_skill("iron-cloth",1) * 100
		&& (int)me->query_skill("iron-cloth",1) > 30)
        return notify_fail("你的阅历太浅了，没有办法领会更高的铁布衫硬功。\n");
	return 1;
}

int learn_bonus()
{
	return 10;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 0;
}

