//离合神功

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }
string skill_cname()
{
	return "离合神功";
}
string force_type() { return "all_force"; }

int valid_learn(object me)
{
        if( (int)me->query_skill("zhengqijue") < (int)me->query_skill("liheforce") )
	return notify_fail("你需要修炼[春秋正气]，才能继续提升离合神功的造诣。\n");
        return 1;
}

int practice_skill(object me)
{
        return notify_fail("离合神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
        return CLASS_D("taohua") + "/liheforce/" + func;
}
int effective_level() { return 30;}

int learn_bonus()
{
        return 7;
}
int practice_bonus()
{
        return 5;
}
int black_white_ness()
{
        return 25;
}

