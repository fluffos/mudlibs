// throwing.c

inherit SKILL;
string skill_cname()
{
	return "暗器功夫";
}

int valid_learn(object me)
{
	if( (int)me->query("p_power_rank") < (int)me->query_skill("throwing",1) * 3
		&& (int)me->query_skill("throwing",1) > 30)
        return notify_fail("你的武学积累不足，没有办法领会更高的暗器功夫。\n");
	return 1;
}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 0;
}

