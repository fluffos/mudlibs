//飞叶摧心掌
#include <ansi.h>
inherit SKILL;
string skill_cname() {
  return "飞叶摧心掌";
}
mapping *action = ({
  ([ "action":
    "$N双掌一错，一招“飞叶翩翩”幻出漫天掌影拢向$n的$l",
    "dodge": 30,
    "parry": 10,
    "damage": 50,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N双掌纷飞，一招“黄叶萧瑟”直取$n的$l",
    "dodge": 10,
    "parry": 30,
    "damage": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N暴喝一声，双掌连环推出，一招“遮天连叶”强劲的掌风直扑$n的$l",
    "dodge": 30,
    "parry": 10,
    "damage": 50,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N化掌为刀，一招“叶底藏花”，左右掌分砍$n的两处要害",
    "dodge": 20,
    "parry": 30,
    "damage": 40,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N内气上提，全身拔起，一招“叶落归根”，双掌凌空拍下",
    "dodge": 70,
    "parry": 10,
    "damage": 80,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N提气游走，一招“落叶秋风”，森森掌风无孔不入般地击向$n的$l",
    "parry": 40,
    "force": 120,
    "damage_type": "瘀伤"
  ]),
});
int valid_learn(object me) {
  int lvl1, lvl2;
  lvl1 = me->query_skill("hansha-force", 1);
  lvl2 = me->query_skill("leaf_strike", 1);
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练飞叶摧心掌必须空手。\n");
  if ((int)me->query_skill("senluo-force", 1) < 10)
    return notify_fail("你的森罗万象变心法火候不足，无法练飞叶摧心掌。\n");
  if (lvl1 < lvl2)
    return notify_fail("你的含沙射影功还不够高，无法练飞叶摧心掌。\n");
  return 1;
}

int valid_enable(string usage) { return usage == "unarmed"; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 5)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  return 1;
}
int effective_level() { return 19; }

string *parry_msg = ({
  "$n使出「粘」字诀，双掌一划，引偏了$N的$w。\n",
});

string *unarmed_parry_msg = ({
  "$n施展出飞叶摧心掌，轻描淡写的化解了$N的攻势。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return 5;
}
int black_white_ness() {
  return -10;
}

string perform_action_file(string action) {
  return CLASS_D("mojiao") + "/leaf-strike/" + action;
}

void skill_improved(object me) {
  int s;
  s = me->query_skill("leaf-strike", 1);
  if (s == 0) return;
  if (s == 1) {
    tell_object(me, HIW "\n飞叶摧心掌乃当今最奇特的掌法之一，威力极大！\n" NOR);
  }
  if (s == 61)
    tell_object(me, HIW "由于你苦练武功，领悟绝技摧枯拉朽(Perform Cuikulaxiu)！\n\n" NOR);
}
