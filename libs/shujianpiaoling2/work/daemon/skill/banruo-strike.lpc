// banruo-strike.c  般若禅掌

inherit SKILL;
string skill_cname() {
  return "般若禅掌";
}

mapping *action = ({
  ([ "action": "$N前腿踢出，后腿脚尖点地，一式「横空出世」，二掌直出，攻向$n的上中下三路",
    "dodge": -30,
    "parry": -20,
    "damage": 30,
    "force": 150,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌划一半圆，一式「长虹贯日」，右掌斜穿而出，疾拍$n的胸前大穴",
    "dodge": -50,
    "parry": -30,
    "damage": 40,
    "force": 140,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式「云断秦岭」，右掌上引，左掌由后而上一个甩劈，斩向$n的$l",
    "dodge": -50,
    "parry": -50,
    "damage": 50,
    "force": 170,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌护胸，右拳凝劲后发，一式「铁索拦江」，缓缓推向$n的$l",
    "dodge": -40,
    "parry": -50,
    "damage": 40,
    "force": 130,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式「狂风卷地」，全身飞速旋转，双掌一前一后，猛地拍向$n的$l",
    "dodge": -40,
    "parry": -50,
    "damage": 50,
    "force": 160,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N合掌抱球，猛吸一口气，一式「怀中抱月」，双掌疾推向$n的$l",
    "dodge": -40,
    "parry": -20,
    "damage": 50,
    "force": 150,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N向上高高跃起，一式「高山流水」，居高临下，掌力笼罩$n的全身",
    "dodge": -50,
    "parry": -40,
    "damage": 70,
    "force": 200,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式「摘星换斗」，劲气弥漫，双掌如轮，一环环向$n的$l斫去",
    "dodge": -70,
    "parry": -20,
    "damage": 20,
    "force": 140,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N两掌上下护胸，一式「翻江搅海」，骤然化为满天掌雨，攻向$n",
    "dodge": -40,
    "parry": -50,
    "damage": 70,
    "force": 200,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一式「金刚伏魔」，双手合十，对着$n微微一揖，全身内劲如巨浪般汹涌而出",
    "dodge": -90,
    "parry": -90,
    "damage": 60,
    "force": 250,
    //        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
    "damage_type": "瘀伤"
  ]),
});


int valid_learn(object me) {
  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你的内功不够，无法修习更高深的般若掌。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练般若掌必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}

int effective_level() { return 21; }

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 20;
}

string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/strike/banruo/" + action;
}
