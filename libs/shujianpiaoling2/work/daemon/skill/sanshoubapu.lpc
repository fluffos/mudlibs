//散手八扑  written by john darks
#include <ansi.h>
inherit SKILL;
void fight_force(object me, object target);
void tell_msg(object me, object target);
string skill_cname() {
  return "散手八扑";
}

mapping *action = ({
  ([ "action": "$N无招无式，中宫直进，就那么一拳",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N右脚一踏，左袖就那么的随意一挥",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身子一转，右掌自一个$n意想不到的角度击出",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身影一晃，右手托开$n守势，左手一指点向$n的$l",
    "weapon": "左手食指",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N突然欺近$n，一肩撞向$n",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N右脚退了一步，左脚却从一个$n意想不到的角度踢向$n的$l",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N突然双手托地，双腿来来回回地狂扫向$n的$l",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一个鹞子穿林，到了$n的身后，一声低喝，已一肩撞向$n背部",
    "damage_type": "瘀伤"
  ]),
});

string *parry_msg = ({
  "$n左手手指一弹，反击$N破绽，逼得$N不得不收势。\n",
  "$n顺着来势一迎，$N一时收势不住，反而差点跌倒。\n",
});

string *unarmed_parry_msg = ({
  "$n双手一旋，化出一道气墙，挡住了来势。\n",
  "$n不避不让，居然一掌相迎！\n",
});


int valid_learn(object me) {
  int lvl;
  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你的内功心法火候不足，无法练散手八扑。\n");
  if ((int)me->query("force") < 800)
    return notify_fail("你的真气不够，没有办法练散手八扑。\n");
  if ((lvl = (int)me->query_skill("thforce", 1)) < 100)
    return notify_fail("你的天和内气火候不足，无法练散手八扑。\n");
  return 1;
}

int practice_skill(object me) {
  if ((int)me->query_skill("unarmed", 1) < 100)
    return notify_fail("你基本拳脚不够高，不能练散手八扑。\n");
  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练这门武功，还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}

int valid_enable(string usage) {
  return (usage == "unarmed") || (usage == "parry");
}

int effective_level() { return 11; }

mapping query_action(object me, object weapon) {
  mapping action1;
  action1 = action[random(8)];
  if (me->query("force") > 2500)
    action1["force"] = 2500;
  else action1["force"] = (int)me->query("force");
  action1["dodge"] = (int)me->query_skill("unarmed") * 2;
  action1["parry"] = (int)me->query_skill("unarmed") * 2;
  if (me->query("force_factor") > 0)
    me->add("force", me->query("force_factor"));
  return action1;
}

string query_parry_msg(object weapon) {
  object target = this_player();
  object *enemy = target->query_enemy();
  object me, weapon1;
  int i, force;
  for (i = 0; i < sizeof(enemy); i++) {
    if (enemy[i] == target->query_temp("last_opponent")) {
      me = enemy[i];
      weapon1 = me->query_temp("weapon");
    } else continue;
  }
  if (weapon1 && me)
    return parry_msg[random(2)];
  else if (objectp(me)) {
    force = (int)me->query("force") + (int)target->query("force");
    if (!weapon && random(force) > target->query("force")) {
      call_out("fight_force", 1, me, target);
      me->start_busy(3);
      target->start_busy(3);
      return unarmed_parry_msg[1];
    } else return unarmed_parry_msg[0];
  } else return unarmed_parry_msg[0];
}

int learn_bonus() {
  return -200;
}

int practice_bonus() {
  object me = this_player();
  int lvl = (int)me->query_skill("sanshoubapu", 1);
  if (lvl < 101)
    return -250;
  else return 50;
}
int black_white_ness() {
  return 20;
}

void skill_improved(object me) {
  int s;
  s = me->query_skill("sanshoubapu", 1);
  if (s == 0) return;
  if (s == 1) {
    tell_object(me, HIW "\n散手八扑是天和道人晚年所悟，威力不凡！\n" NOR);
    tell_object(me, HIW "散手八扑以内力为基础，一招一式都需要强大的内力为辅，所以内力越深厚威力也越大！\n" NOR);
    tell_object(me, HIW "这种武功收发由心(Perform Sanshoubapu)，如果定力足够，可以不受对手所惑！\n\n" NOR);
  }
  if (s == 101)
    tell_object(me, HIW "由于你苦练武功，领悟了绝技 [折梅手] (Perform Zhemei)！\n\n" NOR);
}


string perform_action_file(string action) {
  return CLASS_D("mojiao") + "/sanshoubapu/" + action;
}

void fight_force(object me, object target) {
  if (objectp(me) && objectp(target) && me->is_fighting(target)) {
    me->start_busy(3);
    target->start_busy(3);
    message_vision(HIY "\n$N和$n双掌相持，竟然比起内力来！\n" NOR, me, target);
    tell_msg(me, target);
  }
}

void tell_msg(object me, object target) {
  if (me->is_fighting(target)) {
    if (target->query("force") >= 150) {
      tell_object(me, HIB "你感觉对方的内力源源不断的传来！\n" NOR);
      target->add("force", -150);
      if (me->query("force") >= 150) {
        tell_object(target, HIB "你感觉对方的内力源源不断的传来！\n" NOR);
        me->add("force", -150);
      } else {
        tell_object(target, HIB "你感觉对方的内力突然减弱！\n" NOR);
        message_vision(HIR "$N突然露出痛苦的表情，全身颤抖，似乎已力尽！\n" NOR, me);
        me->set("force", 0);
        me->receive_damage("kee", 150);
        me->receive_damage("sen", 50);
        me->receive_damage("gin", 50);
        COMBAT_D->report_status(me);
      }
    } else {
      tell_object(me, HIB "你感觉对方的内力突然减弱！\n" NOR);
      if (me->query("force") >= 150) {
        tell_object(target, HIB "你感觉对方的内力源源不断的传来！\n" NOR);
        me->add("force", -150);
      } else {
        tell_object(target, HIB "你感觉对方的内力突然减弱！\n" NOR);
        message_vision(HIR "$N突然露出痛苦的表情，全身颤抖，似乎已力尽！\n" NOR, me);
        me->set("force", 0);
        me->receive_damage("kee", 150);
        me->receive_damage("sen", 50);
        me->receive_damage("gin", 50);
        COMBAT_D->report_status(me);
      }
      message_vision(HIR "$N突然露出痛苦的表情，全身颤抖，似乎已力尽！\n" NOR, target);
      target->set("force", 0);
      target->receive_damage("kee", 150);
      target->receive_damage("sen", 50);
      target->receive_damage("gin", 50);
      COMBAT_D->report_status(target);
    }
    if (me->is_busy() && me->is_fighting(target))
      call_out("tell_msg", 1, me, target);
    else if (me->is_fighting(target))
      message_vision(HIR "$N和$n闷哼了一声，各退了一步，显然都不好过。\n" NOR, me, target);
  }
}
