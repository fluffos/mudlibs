int valid_learn(object me) {
  if ((int)me->query("str") + (int)me->query("max_force") / 10 < 55)
    return notify_fail("你的膂力还不够，也许该练一练内力来增强力量。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "stick") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  object target, *obs, ob;
  int extra, i;
  string msg;
  target = me->query_temp("last_opponent");
  if (!me->query_temp("array/hitonly")) {
    if (pointerp(obs = me->query_team())) {
      for (i = 0; i < sizeof(obs); i++) {
        if (!obs[i]) continue;
        if (environment(obs[i]) != environment(me)) continue;
        if (!obs[i]->query_skill("stickarray", 1)) continue;
        if (!objectp(ob = obs[i]->query_temp("weapon"))) continue;
        if (ob->query("skill_type") != "stick") continue;
        if (obs[i]->query_skill_mapped("stick") != "stickarray") continue;
        extra = obs[i]->query_skill("stick");
        extra *= (i + 1);
        obs[i]->add_temp("apply/attack", extra);
        obs[i]->add_temp("apply/damage", extra);
        obs[i]->set_temp("array/hitonly", 1);
        msg = style[random(sizeof(style))];
        COMBAT_D->do_attack(obs[i], target, ob, TYPE_REGULAR, msg);
        if (!obs[i]->is_killing(target)) obs[i]->kill_ob(target);
        obs[i]->add_temp("apply/attack", -extra);
        obs[i]->add_temp("apply/damage", -extra);
        obs[i]->set_temp("array/hitonly", 0);
      }
    }
    me->start_busy(sizeof(obs) + 1);
  }
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "stick")
    return notify_fail("你必须先找一根木杖或者是类似的武器，才能练棍法。\n");
  if ((int)me->query("kee") < 60)
    return notify_fail("你的体力不够练这门棍阵，还是先休息休息吧。\n");
  me->receive_damage("kee", 60);
  return 1;
}

int effective_level() { return 9; }

string *parry_msg = ({
  "$n使出一招「豹子摇头」手中$v摆开，格开了$N的$w。\n",
  "$n手中$v横摆，一招「白虎探爪」，荡开了$N的$w。\n",
});

string *unarmed_parry_msg = ({
  "$n身形徐徐后退，手中$v抡动，封住了$N的攻势。\n",
  "$n身形直挺挺扑到在地，手中$v径自扫向$N。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action) {
  return CLASS_D("mojiao") + "/stickarray/" + action;
}

int learn_bonus() {
  return 50;
}
int practice_bonus() {
  return 10;
}
int black_white_ness() {
  return 0;
}
