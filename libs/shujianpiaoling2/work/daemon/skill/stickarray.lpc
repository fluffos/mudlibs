#include <ansi.h>
#include <combat.h>
inherit SKILL;
string skill_cname() {
  return "龙虎干戈棍阵";
}

string *style = ({
  HIR "$N" + HIR "抡动手中$w" + HIR "，棍风呼啸，打向$n" + HIR "的$l！" NOR,
  HIY "$N" + HIY "手中$w" + HIY "化做棍影重重，将$n" + HIY "团团围住！" NOR,
  HIB "$N" + HIB "向前一纵，手中$w" + HIB "狂舞，向$n" + HIB "猛扑过去！" NOR,
  HIW "$N" + HIW "欺身急进，手中$w" + HIW "头尾齐出，分打$n" + HIW "的两处要害！" NOR,
  HIG "$N" + HIG "手中$w" + HIG "一顿，暗蓄内力，点向$n" + HIG "的$l！" NOR,
  HIC "$N" + HIC "身形连纵连跃，手中$w" + HIC "威势陡增，连连向$n" + HIC "打去！" NOR,
  HIM "$N" + HIM "身影绕着$n" + HIM "连续晃动，手中$w" + HIM "连发，扫向$n" + HIM "的$l！" NOR,
  CYN "$N" + CYN "身形纵起，手中$w" + CYN "自上而下，迅猛无比，砸向$n" + CYN "的$l！" NOR
});

