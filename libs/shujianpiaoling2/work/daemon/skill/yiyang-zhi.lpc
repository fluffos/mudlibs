int valid_enable(string usage) 
{  
   return usage=="unarmed" || usage=="parry"; 
}
int valid_combine(string combo)
 {
         object me;
         me = this_player();
 
         if ((int)me->query_int() > 40)
                 return combo=="liumai_force";
 }
int valid_learn(object me)
{
       
       if ((string)me->query("gender") != "男性") 
                return notify_fail("一阳指乃是纯阳玄功，你如何可以修习？\n");
       if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练一阳指必须空手。\n");
          if((int)me->query_skill("liumai_force", 1) < 100)
                return notify_fail("你的六脉神功火候不够，无法学一阳指。\n");
       if ((int)me->query("max_force") < 1500)
                return notify_fail("你的内力太弱，无法练一阳指。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{           if((int)me->query_skill("liumai_force", 1) < 100)
                return notify_fail("你的六脉神功火候不够，无法练一阳指。\n");
        if ((int)me->query("sen") < 40)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("force") < 10)
                return notify_fail("你的内力不够。\n");
                          
        me->receive_damage("sen", 40);
        me->add("force", -10);
        return 1;
}

string perform_action_file(string action)
{
      return CLASS_D("quanzhen") + "/yiyang-zhi/" + action;
}

int effective_level() { return 17;}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    string name,weapon;
    name = xue_name[random(sizeof(xue_name))];
    
        if(me->query_skill("yiyang-zhi", 1) > 100
       && me->query("force") > 500
       && me->query_skill_mapped("parry") == "yiyang-zhi" 
       && victim->query("force") > 100){
         victim->add("force", -random(10));     
        }   
    if(victim->is_busy()) return 0;
        if (!objectp(weapon = me->query_temp("weapon"))) {
        if((!random(6)) && (me->query("force")>200) && me->query_skill("yiyang-zhi", 1) > 60)
      {
                victim->start_busy(2);
	if( me->query("force") > 60 )
        me->add("force",-30);
	if( victim->query("force") > 100 )
                victim->add("force",-60);
                return CYN "$n被$N凌空一指点中"RED+name+CYN"，真气不由得一滞！\n" NOR;
        } 
        } else 
        {
          if((!random(6)) && (me->query("force")>200) && me->query_skill("yiyang-zhi", 1) > 60)
           {
            victim->start_busy(2);
	if( me->query("force") > 60 )
        me->add("force",-30);
	if( victim->query("force") > 60 )
                victim->add("force",-30);
                victim->receive_damage("kee", me->query_skill("yiyang-zhi",1)/10);
        victim->receive_wound("kee", me->query_skill("yiyang-zhi",1)/20);       
                return CYN "$n被$N发出的剑气刺中"RED+name+CYN"，真气不由得一滞！\n" NOR;
        }   
        }
 
}
