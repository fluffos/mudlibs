// By Style@sjpl
#include <ansi.h>
#include <combat.h>
inherit SSERVER int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  extra = me->query_skill("winds-blade", 1);
  if (extra < 80) return notify_fail("你的[十里狂刀]还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target; || !target->is_character() || !me->is_fighting(target))
    return notify_fail("［艳阳霹雳］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  msg = HIM "$N凝聚起太阳光华的无边热量，- 艳 - 阳 - 霹 - 雳 -如急电般劈向$n！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIB "$N手中" + weapon->name() + "幻出妖艳的光华奔向$n！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIB "$N手中" + weapon->name() + "如万丈阳光般的涌向$n！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIB "$N手中" + weapon->name() + "忽然一阵狂抖，闪电地击中$n！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "$N手中" + weapon->name() + "竟然发出滚滚雷声,惊人的扑向$n！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIC "万道彩虹在云端隐现，$N手中" + weapon->name() + "鬼神莫测已然到了$n的眼前！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->start_busy(4);
  me->add("force", -500);
  me->add("kee", -80);
  return 1;
}
