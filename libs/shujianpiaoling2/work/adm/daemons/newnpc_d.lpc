//
// newnpc_d.c	维护一份在线高级智能 NPC 的名单表
//
// 设计 By 狂风 For 神剑魔刀 (07/09/98)

inherit F_CLEAN_UP;
mapping New_Npc = ([]);

void refresh()
{
	int i;
	mapping * key;
	if( !mapp(New_Npc) || !sizeof(New_Npc) ) return;
	key = keys(New_Npc);
	for( i = 0; i < sizeof(key); i++) 
		if( ! objectp(New_Npc[key[i]]) ) map_delete( New_Npc, key[i] );
}

void add_npc(string id,object ob)
{
	New_Npc[id] = ob;
}

mapping query_new_npc()
{
	return New_Npc;
}
