// Ported to ES2 mudlib by Annihilator@ES2.

#include <ansi.h>
#include <command.h>
#include <net/dns.h>
#include <net/macros.h>
#include <net/daemons.h>

inherit F_CLEAN_UP;
inherit F_DBASE;

/*
* Someone has asked us for a remote who...
* Lets oblige them.
*/
void incoming_request(mapping info) {
  object *who;
  string str, *bits;
  int i;

  if (!ACCESS_CHECK(previous_object())) return;

  if (stringp(info["NAME"]) && stringp(info["PORTUDP"])) {
    if (info["NAME"] == Mud_name()) return;
    if (!DNS_MASTER->dns_mudp(info["NAME"])) {
      PING_Q->send_ping_q(info["HOSTADDRESS"], info["PORTUDP"]);
      CHANNEL_D->do_channel(this_object(), "sys",
        sprintf("rwho request from %s rejected, ping_q sent.", info["NAME"]));
    }
    str = info["MSG"];

    //#ifdef DEBUG
    message("channel:chat", CYN + "【闲聊】" + str + NOR, users());
    //#endif

    DNS_MASTER->send_udp(info["HOSTADDRESS"], info["PORTUDP"],
      "@@@" + DNS_SJPL_A +
      "||NAME:" + Mud_name() +
      "||PORTUDP:" + udp_port() +
      "||RWHO:" + str +
      "||ASKWIZ:" + info["ASKWIZ"] +
      "@@@\n");
  }
}

void send_msg_q(string mud, object them, string msg) {
  mapping info;
  string askwiz;

  if (!ACCESS_CHECK(previous_object())) return;

  if (!them) them = this_player();
  askwiz = geteuid(them);

  info = DNS_MASTER->query_mud_info(mud);
  if (!info) {
    tell_object(them, "没有这个 MUD。\n");
    return;
  }
  //#ifdef DEBUG
  set("channel_id", "网路频道精灵");
  CHANNEL_D->do_channel(this_object(), "sys", sprintf("send msg to %s:%s",
    info["HOSTADDRESS"], info["PORTUDP"]));
  //#endif

  DNS_MASTER->send_udp(info["HOSTADDRESS"], info["PORTUDP"],
    "@@@" + DNS_SJPL_Q +
    "||NAME:" + Mud_name() +
    "||PORTUDP:" + udp_port() +
    "||MSG:" + msg +
    "||ASKWIZ:" + askwiz +
    "||@@@\n");
}

void create() { seteuid(ROOT_UID); }

int visiblep(object obj) { return 1; }

string get_name(object obj) { return capitalize(geteuid(obj)); }
