// quest.c

#include <ansi.h>
#include <dbase.h>

mapping quests;
mapping quest_map;

mapping query_quests() { return quests; }

void set_quest(string quest, int val)
{
	if( !find_object(QUESTS_D(quest))
	&&	file_size(QUESTS_D(quest)+".lpc") < 0 )
		error("F_QUEST: No such quest (" + quest + ")\n");

	if( !mapp(quests) ) quests = ([ quest: val ]);
	else quests[quest] = val;
}

int delete_quest(string quest)
{
	if( mapp(quests) ) {
		map_delete(quests, quest);
		return undefinedp(quests[quest]);
	}
	return 0;
}

// This function 'map' a quest <quest> to another quest <mapped_to>.
// If 2nd argument not given, cancel the mapped quest <quest>.
varargs void map_quest(string quest, string mapped_to)
{
	if( !mapped_to && mapp(quest_map) ) {
		map_delete(quest_map, quest);
		return;
	}

	if( !find_object(QUESTS_D(quest))
	&&	file_size(QUESTS_D(quest)+".lpc") < 0 )
		error("F_QUEST: No such quest (" + quest + ")\n");

	if( !mapp(quests) || undefinedp(quests[mapped_to]) )
		return;
		
	if( !mapp(quest_map) ) quest_map = ([ quest: mapped_to ]);
	else quest_map[quest] = mapped_to;
}

string query_quest_mapped(string quest)
{
	if( mapp(quest_map) && !undefinedp(quest_map[quest]) )
		return quest_map[quest];
	return 0;
}
varargs int query_quest(string quest, int raw)
{
	if( !raw ) {
		int s , level;
		s = query_temp("apply/" + quest);
		if( mapp(quests) ) {
			s += quests[quest] ;
			if( mapp(quest_map) )
			{
		 if( quest_map[quest])
		 level = (int) (QUESTS_D(quest_map[quest])->effective_level())  ;
		 else
		 level = 0;
				s += quests[quest_map[quest]] * level / 10 ;
			}
		}
		return s;
	}
	if( mapp(quests) && !undefinedp(quests[quest]) ) return quests[quest];
	return 0;
}

mapping query_quest_map()
{
	return quest_map;
}

varargs int query_quest_eff_lvl(string quest)
{
        int level;
if(mapp(quests)){
level = (int) (QUESTS_D(quest)->effective_level())  ;
// for baisc quests where effecitive_level() undefined
if( level == 0) level = 10;
return quests[quest] * level /10;
}
return 0;
}


