#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <move.h>

int ghost = 0;

int is_ghost() { return ghost; }

varargs int receive_damage(string type, int damage, object who)
{
	int val;
	if( damage < 0 ) error("F_DAMAGE: 伤害值为负值。\n");
	if( !who && damage > 500 )  damage=500;
	if( type!="gin" && type!="kee" && type!="sen" )
		error("F_DAMAGE: 伤害种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

	if( objectp(who) ) set_temp("last_damage_from", who);
	if( objectp(who) && (uptime()-who->query_temp("super_damage")>60) && (damage>500) )  damage=500;

	val = (int)query(type) - damage;

	set(type, val);
	set_heart_beat(1);
	return damage;
}

varargs int receive_wound(string type, int damage, object who)
{
	int val;

	if( damage < 0 ) error("F_DAMAGE: 伤害值为负值。\n");
	if( !who && damage > 500 )  damage=500;
	if( type!="gin" && type!="kee" && type!="sen" )
		error("F_DAMAGE: 伤害种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

	if( objectp(who) ) set_temp("last_damage_from", who);
	if( objectp(who) && (uptime()-who->query_temp("super_damage")>60) && (damage>500) )  damage=500;

	val = (int)query("eff_" + type) - damage;

	set("eff_" + type, val);
	if( (int)query(type) > val ) set(type, val);
	set_heart_beat(1);
	return damage;
}

int receive_heal(string type, int heal)
{
	int val;

	if( heal < 0 ) error("F_DAMAGE: 恢复值为负值。\n");
	if( type!="gin" && type!="kee" && type!="sen" )
		error("F_DAMAGE: 恢复种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

	val = (int)query(type) + heal;

	if( val > (int)query("eff_" + type) ) set(type, (int)query("eff_" + type));
	else set( type, val );

	return heal;
}

int receive_curing(string type, int heal)
{
	int max, val;

	if( heal < 0 ) error("F_DAMAGE: 恢复值为负值。\n");
	if( type!="gin" && type!="kee" && type!="sen" )
		error("F_DAMAGE: 恢复种类错误( 只能是 gin, kee, sen 其中之一 )。\n");

	val = (int)query("eff_" + type);
	max = (int)query("max_" + type);

	if( val + heal > max ) {
		set("eff_" + type, max);
		return max - val;
	} else {
		set( "eff_" + type, val + heal);
		return heal;
	}
}

void unconcious()
{
	object defeater;

	if( !living(this_object()) ) return;
	if( wizardp(this_object()) && query("env/immortal") ) return;

	if( objectp(defeater = query_temp("last_damage_from")) )
		COMBAT_D->winner_reward(defeater, this_object());
		COMBAT_D->loser_penalty(defeater, this_object());
	if( ! this_object()->query("possessed"))
	this_object()->remove_all_enemy();

	message("system", HIR "\n你的眼前一黑，接著什麽也不知道了....\n\n" NOR,
		this_object());
	this_object()->disable_player(" <昏迷不醒>");
	set("gin", 0);
	set("kee", 0);
	set("sen", 0);
	set_temp("block_msg/all", 1);
	this_object()->set_wait(30);
	COMBAT_D->announce(this_object(), "unconcious");

	call_out("revive", random(50 - (int) this_object()->query_con()) + 10);
}

varargs void revive(int quiet)
{
	remove_call_out("revive");
	while( environment()->is_character() )
		this_object()->move(environment(environment()));
        if( (int) this_object()->query("gin") < 0 ) this_object()->set("gin",0);
        if( (int) this_object()->query("kee") < 0 ) this_object()->set("kee",0);
        if( (int) this_object()->query("sen") < 0 ) this_object()->set("sen",0);
	if( !quiet ) {
		COMBAT_D->announce(this_object(), "revive");
		set_temp("block_msg/all", 0);
		this_object()->set_wait(0);
//		message("system", HIY "\n慢慢地你终於又有了知觉....\n\n" NOR,
//		this_object());
	} else
		set_temp("block_msg/all", 0);
		this_object()->set_wait(0);
        this_object()->enable_player();

}
void be_ghost(int flag)
{
	ghost = flag;
}
void die()
{
	object corpse, killer;
	int i;

	if( !living(this_object()) ) revive(1);
	if( wizardp(this_object()) && query("env/immortal") ) return;

	// Clear all the conditions by death.
	this_object()->clear_condition();

	COMBAT_D->announce(this_object(), "dead");
	if( objectp(killer = query_temp("last_damage_from")) ) {
		set_temp("my_killer", killer->query("id"));
		set_temp("my_killer_name", killer->query("name"));
		COMBAT_D->killer_reward(killer, this_object());
	}
		COMBAT_D->victim_penalty(this_object());
	
	if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
		corpse->move(environment());

	this_object()->remove_all_killer();
	this_object()->remove_call_out();

	all_inventory(environment())->remove_killer(this_object());

	this_object()->dismiss_team();
	if( userp(this_object()) ) {
		set("gin", 1);	set("eff_gin", 1);
		set("kee", 1);	set("eff_kee", 1);
		set("sen", 1);	set("eff_sen", 1);
		ghost = 1;
		this_object()->save();
		this_object()->move(DEATH_ROOM);
		DEATH_ROOM->start_death(this_object());
	} else
		destruct(this_object());
}

void reincarnate()
{
	ghost = 0;
	set("eff_gin", query("max_gin"));
	set("eff_kee", query("max_kee"));
	set("eff_sen", query("max_sen"));
}

int max_food_capacity() { return query_weight() / 200; }

int max_water_capacity() { return query_weight() / 200; }

int heal_up()
{
	int update_flag, i;
	mapping my;

	if( this_object()->is_fighting() ) return -1;
	update_flag = 0;

	my = query_entire_dbase();

	if( my["water"] > 0 ) { my["water"] -= 1; update_flag++; }
	if( my["food"] > 0 ) { my["food"] -= 1; update_flag++; }
	if( my["magic_exp"] > my["age"] && random(20)<10 ) { my["magic_exp"] -= 1; update_flag++; }
	if( my["force"] > my["max_force"] ) { my["force"] -= 1; update_flag++; }
	if( my["atman"] > my["max_atman"] ) { my["atman"] -= 1; update_flag++; }
	if( my["mana"] > my["max_mana"] ) { my["mana"] -= 1; update_flag++; }
	if( this_object()->query("env/wimpy")> 30 && userp(this_object()) )
	 { this_object()->add("env/wimpy",-1); update_flag++; }

 	if( (my["potential"] - my["learned_points"])> 100 )
	{
 	if( (my["combat_exp"]>900)&& (my["potential"] - my["learned_points"])> my["combat_exp"] /3) { my["potential"] -= 10; update_flag++; }
 	if( (my["combat_exp"]>900)&& (my["potential"] - my["learned_points"])> my["combat_exp"] /2) { my["potential"] -= 100; update_flag++; }
	}

	if( my["p_power_rank"] > my["age"] && userp(this_object()) && random(20)<10) {
		my["p_power_rank"] --; 
		update_flag++;
	} else
		if( userp(this_object()) && (my["potential"] - my["learned_points"]) > 1 && my["food"] < 1 )
		{
		my["potential"] --; 
		update_flag++;
		}

	if( my["water"] < 1 && userp(this_object()) )  return update_flag;
       if( my["food"] < 1 && userp(this_object()) )  return update_flag;
	
	my["gin"] += my["spi"]  + my["atman"] / 10;
	if( my["gin"] >= my["eff_gin"] ) {
		my["gin"] = my["eff_gin"];
		if( my["eff_gin"] < my["max_gin"] ) { my["eff_gin"] ++; update_flag++; }
	} else update_flag++;

	my["kee"] += my["con"]  + my["force"] / 10;
	if( my["kee"] >= my["eff_kee"] ) {
		my["kee"] = my["eff_kee"];
		if( my["eff_kee"] < my["max_kee"] )	{ my["eff_kee"] ++; update_flag++; }
	} else update_flag++;

	my["sen"] += my["int"]  + my["mana"] / 10;
	if( my["sen"] >= my["eff_sen"] ) {
		my["sen"] = my["eff_sen"];
		if( my["eff_sen"] < my["max_sen"] )	{ my["eff_sen"] ++; update_flag++; }
	} else update_flag++;

	if( my["max_atman"] && my["atman"]<50 && my["atman"] < my["max_atman"] ) {
		my["atman"] += (int)this_object()->query_skill("magic", 1) / 2;
		if( my["atman"] > my["max_atman"] ) my["atman"] = my["max_atman"];
		update_flag++;
	}

	if( my["max_force"] && my["force"]<50 && my["force"] < my["max_force"] ) {
		my["force"] += (int)this_object()->query_skill("force", 1) / 2;
		if( my["force"] > my["max_force"] ) my["force"] = my["max_force"];
		update_flag++;
	}

	if( my["max_mana"] && my["mana"]<50 && my["mana"] < my["max_mana"] ) {
		my["mana"] += (int)this_object()->query_skill("spells", 1) / 2;
		if( my["mana"] > my["max_mana"] ) my["mana"] = my["max_mana"];
		update_flag++;
	}

	return update_flag;
}

void soft_powerup(int rate,int tm)
{
	int effdm,effam,effstr;
	if(tm<0) tm=0;
		else if(tm>60) tm=60;
	if(rate>100) rate=100;
		else if(rate<50) rate=50;
	effdm=(this_object()->query_temp("apply/damage"))*rate/100;
	effam=(this_object()->query_temp("apply/armor"))*rate/50;
	if(effam<=50) effam=50;
	if(effam>=100) effam=100;
	effstr=(this_object()->query("str"))*rate/100;
	this_object()->add_temp("apply/damage",-effdm);
	this_object()->add_temp("apply/armor",effam);
	this_object()->add_temp("apply/parry",rate*3/2);
	this_object()->add_temp("apply/flexibility",10);
	if(this_object()->query("str")>=20 && effstr>0 )
	{
		this_object()->add_temp("apply/strength",-effstr);
		this_object()->set_temp("soft_power_strength",effstr);
	}
	this_object()->set("sen",this_object()->query("eff_sen"));
	this_object()->set_temp("next_soft_powerend",tm+uptime());
	this_object()->set_temp("soft_power_damage",effdm);
	this_object()->set_temp("soft_power_armor",effam);
	this_object()->set_temp("soft_power_rate",rate);
	this_object()->set("p_power_rank",this_object()->query("p_power_rank")*10);
	call_out("soft_powerend", tm, this_object());
	return;
}

void soft_powerend(object ob)
{
	int rate,effdm,effam,effstr;
	if(!ob || !ob->is_character()) return;
	rate=ob->query_temp("soft_power_rate");
	effdm=ob->query_temp("soft_power_damage");
	effam=ob->query_temp("soft_power_armor");
	effstr=ob->query_temp("soft_power_strength");

	ob->add_temp("apply/damage",effdm);
	ob->add_temp("apply/armor",-effam);
	ob->add_temp("apply/parry",-rate*3/2);
	ob->add_temp("apply/flexibility",-10);
	if(ob->query_temp("soft_power_strength"))
	{
		ob->add_temp("apply/strength",effstr);
		ob->delete_temp("soft_power_strength");
	}
	ob->set("sen",ob->query("eff_sen"));
	ob->delete_temp("next_soft_powerend");
	ob->delete_temp("soft_power_damage");
	ob->delete_temp("soft_power_armor");
	ob->delete_temp("soft_power_rate");
	ob->set("p_power_rank",ob->query("p_power_rank")/10);
	return;
}

int query_soft_powerup()
{
	int tm;
	tm=(this_object()->query_temp("next_soft_powerend"))-uptime();
	if(tm>0) return tm;
		else return 0;
}

