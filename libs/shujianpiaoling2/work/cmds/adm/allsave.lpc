inherit F_CLEAN_UP;

int main(object me, string arg)
{
 object *usr ;
 int i;
         usr = users();
        message("system", "\n天上忽然间云开雾绽，元始天尊出现在云头，俯瞰大地．．．\n\n", users());
        for(i=0; i<sizeof(usr); i++) 
		{
		if( !environment(usr[i]) ) continue;
//		if( !usr[i]->save() ) write("存档失败。。。\n");
		if( userp(usr[i]) ) 
		usr[i]->save();
        message("system", usr[i]->name()+ "的名字被刻上了书剑英雄录．．．\n", users());
		}
	message("system", "\n元始天尊收起书剑英雄录，转身消失在云头．．． \n\n", users()); 
	me->set("child_1/id",({"xbaiwt","baby"}));
	me->set("child_1/parents",({"baiwt","mon"}));
	return 1;
}

 
