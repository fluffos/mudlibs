// more /cmds/arch/cpemote
#include <net/macros.h>
#include <ansi.h>

inherit F_SAVE;
inherit F_DBASE;
mapping emote;
string emote_file;

string query_save_file() { return emote_file; }

int main(object me, string arg)
{
        string msg;
        int i;
        if( me != this_player(1) || wiz_level(me) < wiz_level("(arch)") )
                return notify_fail("你没有这种权力。\n");
        if (!arg) return notify_fail("你要导入哪个 emote 库？\n");
        if( sscanf(arg,"%s %s",arg,msg) ==2 ){
                if( !restore() && !mapp(emote) )
                        return notify_fail("目标 emote 库存在错误。程序异常中断。\n");
                emote = EMOTE_D->query_emote(arg);
                if (!emote || !sizeof(keys(emote))){
                        if( !undefinedp(emote[msg]) ) {
                                emote[msg]["updated"] = geteuid(me);
                                EMOTE_D->set_emote(msg,emote[msg] );
                                write("OK!\n");
                                return 1;
                        }       
                }else {
                        write("这个 emote 动词已经存在，确定要加入新的吗？(y/n)");
                        input_to("confirm_addemote", me);
                }
        }
        write("OK!\n");
        return 1;
}

void confirm_addemote(string yn, object me)
{
        if( yn=="" ) {
                write("这个 emote 动词已经存在，确定要加入新的吗？(y/n)");
                input_to("confirm_addemote", me);
                return;
        }       

        if( yn[0]!='y' && yn[0]!='Y' ) {
                write("已经选择放弃。\n");
                return;
        }
        write("您要将原来的 emote 取代掉吗？(y/n)");
        input_to("confirm_rewrite", me);
}

void confirm_rewrite(string yn, object me)
{
        if( yn=="" ) {
                write("这个 emote 动词已经存在，确定要加入新的吗？(y/n)");
                input_to("confirm_rewrite", me);
                return;
        }       

        if( yn[0]!='y' && yn[0]!='Y' ) {
                write("已经选择放弃。\n");
                return;
        }
}

