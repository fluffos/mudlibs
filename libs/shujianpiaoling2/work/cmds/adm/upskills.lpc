//upskills
#include <command.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  int loop;
  int f1 = 0, f2 = 0, f3 = 0, f4 = 0;
  string dir, name, err;
  string *file;

  seteuid(geteuid(me));
  if (!arg) arg = "/daemon/skill/";
  dir = resolve_path(me->query("cwd"), arg);
  if (file_size(dir) == -2 && dir[strlen(dir) - 1] != '/') dir += "/";
  file = get_dir(dir, -1);
  if (!sizeof(file)) {
    if (file_size(dir) == -2) return notify_fail("目录是空的。\n");
    else return notify_fail("没有这个目录。\n");
  }
  log_file(
    "SKILL_LOG",
    sprintf("%35s %20s %10s %10s\n\n", "（文件名）", "（技能名称）", "  （有效等级）", "  （内功性质）")
  );

  for (loop = 0; loop < sizeof(file); loop++) {
    reset_eval_cost();
    "/cmds/wiz/update"->main(me, dir + file[loop][0]);

    err = catch(call_other(dir + file[loop][0], "???"));
    if (err) {
      log_file("NPC_LOG", sprintf("\n%s有编译错误！！\n", dir + file[loop][0]));
      continue;
    }

    name = dir + file[loop][0];
    log_file(
      "SKILL_LOG",
      sprintf(
        "%35s  %20s  %10d %15s\n",
        name,
        name->skill_cname(),
        name->effective_level(),
        name->force_type()
      )
    );
    if (name->force_type() == "yin_force") f1++;
    if (name->force_type() == "yang_force") f2++;
    if (name->force_type() == "all_force") f3++;
    f4++;
  }
  log_file(
    "SKILL_LOG",
    sprintf("\n\n（阴功）%4d    （阳功）%4d    （亦阴亦阳）%4d    （总共技能）%6d\n", f1, f2, f3, f4)
  );
  write("DONE\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : update <目录>
 
这个指令可以更新目录下的所有档案, 并将新档的内容载入记忆体内. 
 
HELP
  );
  return 1;
}
