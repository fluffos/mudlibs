// /cmds/arch/locate
// overview.c
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        object *ob_list,ob,room;
        int i;
        string msg ="",where = " 在 ";
        ob_list = children(TASK_OB);
        if (!arg){
                for(i=0; i< sizeof(ob_list); i++){
                        msg += sprintf("%s(%s)",ob_list[i]->query("name"),ob_list[i]->query("id"));
                        if (environment(ob_list[i])){
                                if (!stringp(where = environment(ob_list[i])->query("short")))
                                        where = environment(ob_list[i])->query("name");
                                where += file_name(environment(ob_list[i]));
                        }else where += "无\n";
                        msg += "   " + where + "\n";
                }
                me->start_more(msg);
                return 1;
        }
        else {
        for(i=0; i<sizeof(ob_list); i++) {
                if (ob_list[i]->query("id")==arg){
                        ob = ob_list[i];
                        if (!ob->query("has_refresh"))
                                return notify_fail("你凝气聚神，捻指一算，结果脑子一片混乱，什么也没算出来。\n");
                        room = environment(ob);
                        while(room)
                        {
                                if ( function_exists("create_door",room) )
                                        break;
                                else room = environment(room);
                        }
                        if (!room) return notify_fail("你凝气聚神，捻指一算，结果脑子一片混乱，什么也没算出来。\n");
                        
                        msg = "结果：" + ob_list[i]->query("id") + " 在" + room->query("short") + " " + file_name(room);
                        write(msg + "\n");
                        return 1;
                }
        }
}

        write("结果：无\n");
        return 1;
}



