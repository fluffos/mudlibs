//updir
#include <ansi.h>
#include <command.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        int loop;
        string dir;
        string *file;

        seteuid( geteuid(me) );
        dir = resolve_path(me->query("cwd"), arg);
        if( file_size(dir)== -2 && dir[strlen(dir)-1] != '/' ) dir += "/";
        file = get_dir(dir, -1);
        if( !sizeof(file) )
        {
                if (file_size(dir) == -2) return notify_fail("目录是空的。\n");
                else    return notify_fail("没有这个目录。\n");
        }
        
        for(loop = 0; loop < sizeof(file); loop++)
        {
                reset_eval_cost();
                "/cmds/wiz/update"->main(me, dir + file[loop][0] );
        }
        write("DONE\n");
        return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : update <目录>
 
这个指令可以更新目录下的所有档案, 并将新档的内容载入记忆体内. 
 
HELP
    );
    return 1;
}

