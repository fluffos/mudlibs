inherit F_CLEAN_UP;

int main(object me, string arg) {
  string key;

  if (!arg || arg == "")
    return notify_fail("指令格式  b5gb <big5 code>\n");

  seteuid(getuid());
  printf("GB code = %s\n", B5GB_D->to_gb(arg));
  return 1;
}

int help() {
  write(@HELP
指令格式  b5gb <big5 code>
HELP
  );
  return 1;
}
