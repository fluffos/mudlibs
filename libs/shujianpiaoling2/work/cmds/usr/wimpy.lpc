// wimpy.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  int wmp;

  if (!arg) {
    write("你现在的当「气」低於 " + (int)me->query("env/wimpy")
      + "% 时就会尝试逃跑。\n");
    return 1;
  }

  if (me->query("env/wimpy") > 30) {
    write("你现在的士气过低，无法自行设定逃跑几率。\n");
    return 1;
  }

  if (sscanf(arg, "%d", wmp) != 1 || wmp < 0 || wmp > 30)
    return help(me);

  me->set("env/wimpy", wmp);
  write("Ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式： wimpy [<逃跑时「气」的百分比>]

这个指令让你设定当「气」剩下百分之多少时，要开始「逃跑」。

设定值的范围只能是0--30之间的整数。
HELP
  );
  return 1;
}
