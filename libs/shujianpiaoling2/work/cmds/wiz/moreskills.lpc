inherit F_CLEAN_UP;

int main(object me, string arg) {
  string file;
  arg = "/log/SKILL_LOG";
  //	seteuid(getuid(me));
  file = resolve_path(me->query("cwd"), arg);
  if (file_size(file) < 0)
    return notify_fail("没有针对这项主题的说明文件。\n");
  me->start_more(read_file(file));
  return 1;
}
