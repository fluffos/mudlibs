//占卜术
inherit F_CLEAN_UP;

int main(object me, string str)
{
	object ob, where, *ob_list;
	int i;
	if( environment(me)->query("no_magic") )
		return notify_fail("这里不准念咒文。\n");
	if (!str)
		return notify_fail("你要算谁的卦？\n"); 
         if (me->query("biguan_begin") )
	return notify_fail("正在闭关修行中，无法执行该动作。\n");

	if((int)me->query_skill("zuodaoshu") < 20 )
		return notify_fail("你的旁门左道术太差了！\n");
	if((int)me->query_skill("spells") < 20 )
		return notify_fail("你的法术不够高！\n");
	if((int)me->query("mana") < 25 )
		return notify_fail("你的法力不够！\n");
	if((int)me->query("sen") < 20 )
		return notify_fail("你的精神没有办法有效集中！\n");
	me->add("mana", -25);
	me->receive_damage("sen", 20);
	ob = find_player(str);
	if( !ob ) ob = find_living(str);
	if( !ob || !me->visible(ob)) {
		str = resolve_path(me->query("cwd"), str);
		ob_list = children(str);
		for(i=0; i<sizeof(ob_list); i++) {
			if( !ob = environment(ob_list[i]) ) continue;
			printf("%O\n", ob );
		}
		return 1;
	}
	if (!ob) return notify_fail("你口中念念有词，在掌心里画了个八卦印，但什么也没显示出来.\n");
	where = environment(ob);
	if (!where) return notify_fail("你口中念念有词，在掌心里画了个八卦印，但什么也没显示出来.\n");
	printf("你口中念念有词，在掌心里画了个八卦印，结果印上显示出：%s(%s)现在在%s.\n",
		(string)ob->name(),
		(string)ob->query("id"),
		(string)where->query("short"),
		(string)file_name(where));
	return 1;
}

