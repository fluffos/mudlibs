//查找  /d/cmds/std/findout.c
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str) {
  object ob, where;
  int i;
  if (!(string)me->query_temp("use_jiguan_ren"))
    return notify_fail("什么？\n");
  if (me->query("battle_slg_mode"))
    return notify_fail("正在战略模式中，没有提供该指令。\n");
  if (!str) str = "ground";
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神没有办法有效集中！\n");
  if (me->query("biguan_begin"))
    return notify_fail("正在闭关修行中，无法执行该动作。\n");

  if (me->query_temp("sleeping")) return notify_fail("你正在睡眠中。\n");

  seteuid(getuid());
  me->receive_damage("sen", 20);
  where = environment(me);
  if (!where) return notify_fail("你现在没法找到任何东西。\n");
  if (!where->query("outdoors"))
    return notify_fail("你蹲在地上搜寻了半天，但什么也没有找到。\n");

  if (random((int)me->query("kar")) > random(20) && !where->query_temp("already_findout")) {
    message_vision(HIC "\n$N瞪大眼睛，蹲在地上仔细搜寻起来。\n" NOR, me);
    ob = new("/daemon/troop/taohua/obj/block");
    ob->move(where);
    if (!ob) return notify_fail("找不到这样东西。\n");
    message_vision(HIC "\n$N找来找去，终于在角落里发现了“$n”！\n" NOR, me, ob);
    where->set_temp("already_findout", 1);
    me->start_busy(1);
    return 1;
  } else
    message_vision(HIC "\n$N瞪大眼睛，蹲在地上仔细搜寻起来。\n" NOR, me);
  return 1;
}
