//require.c  created by Baiwt 12,10,1998
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
	int chance;
	object waiter, eating, drinking;
	if ((string)me->query("class") != "official")
	return notify_fail("什么？\n");
	if( !arg ) 
	return notify_fail("Usage: “require eating ”or “require drinking”\n");
	if (!present("waiter", environment(me)))
	return notify_fail("什么？\n");
	waiter = present("waiter", environment(me));
	if( !objectp( waiter ))
	return notify_fail("什么？\n");
	seteuid(getuid());

	chance=random(2);
	if (chance<=1)
	eating=new("/obj/example/dumpling");
	drinking=new("/obj/example/teapot");
	if (chance==2)
	eating=new("/obj/example/chicken_leg");
	drinking=new("/obj/example/wineskin");

	if( arg=="eating" ) 
	{
	message_vision(CYN "\n$N大声喊道：店家，快拿点吃的来！\n" NOR, me);	
	message_vision(CYN "\n$N忙不迭说道：来啦！给您吃的。大人请慢用。\n" NOR, waiter);	
	eating->move(me);
	return 1;
	}
	if( arg=="drinking" ) 
	{
	message_vision(CYN "\n$N大声喊道：店家，快拿点喝的来！\n" NOR, me);	
	message_vision(CYN "\n$N忙不迭说道：来啦！给您喝的。大人请慢用。\n" NOR, waiter);	
	drinking->move(me);
	return 1;
	}
       me->add("life_exp",random(2)-1);
	return 1;
}

