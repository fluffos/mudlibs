// practice.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string skillname;
	mapping my;
	int skill, skill_basic;
	int amount;
         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");
        if( me->query_temp("sleeping") )
		return notify_fail("你正在睡眠中。\n");
//         if (me->query("biguan_begin") )
//	return notify_fail("正在闭关修行中，无法执行该动作。\n");

	seteuid(getuid());
	if( !wizardp(me) && environment(me)->query("no_study") )
		return notify_fail("这里禁止练功。\n");
	if( me->is_fighting() )
		return notify_fail("你已经在战斗中了，学一点实战经验吧。\n");
       if( me->query_delay() )
                return notify_fail("你现在心绪紊乱，不能练功。\n");

	my = me->query_entire_dbase();

	if (arg=="zhengqijue")
	{
	  if(!me->query_skill("zhengqijue"))
		return notify_fail("你不会这种技能。\n");
	  if(me->is_busy())
		return notify_fail("你上一个动作还没有做完。\n");
	  if(me->query("sen") < 50)
		return notify_fail("你的心神不够。\n");
	  if(me->query_skill("zhengqijue",1) <= 10) amount=1;
	  if(me->query_skill("zhengqijue",1) > 10)
		amount=me->query_skill("zhengqijue",1)/10;
	  me->add("daode_point", amount);
	  me->receive_damage("sen",30);
		amount=me->query("daode_point");
		if(amount - my["MKS"] >0)  amount = my["MKS"]+1;
		me->set("daode_point", amount);
	  me->start_busy(1);
	  write(HIW "你凝神静坐，一切都安定下来。你只觉得心情特别宁静平和。\n" NOR);
	  return 1;
	}

	if( !arg ) return (__DIR__"enable")->main(me, arg);

	if( !stringp(skillname = me->query_skill_mapped(arg)) )
		return notify_fail("你只能练习用 enable 指定的特殊技能。\n");

	skill_basic = me->query_skill_eff_lvl(arg) * 1 + 1;
	skill = me->query_skill_eff_lvl(skillname)  + 1;

	if( skill < 1 )
		return notify_fail("你好像还没「学会」这项技能吧？最好先去请教别人。\n");
	if( skill_basic < 1 )
		return notify_fail("你对这方面的技能还是一窍不通，最好从先从基本学起。\n");

	notify_fail("你现在不能练习这项技能。\n");
	if( !SKILL_D(skillname)->valid_learn(me) ) return 0;

	notify_fail("你试著练习" + to_chinese(skillname) + "，但是并没有任何进步。\n");
	if( SKILL_D(skillname)->practice_skill(me) ) {
		amount = (skill - 75) * SKILL_D(skillname)->black_white_ness()/100;
		if((amount < -25) && (skill < 75)) amount = -25;
		amount += SKILL_D(skillname)->practice_bonus() + skill_basic/5 + 1;
		if( amount < 1) amount = 1;
		me->improve_skill(skillname, amount, skill_basic > skill? 0: 1);
		write( HIY "你的" + to_chinese(skillname) + "进步了！\n" NOR);
		if( (int)me->query("p_power_rank") < 1000000 )
		me->add("p_power_rank",(me->query("age")/10+1));
		if( me->query("national") == "出生于武力世家" )
			{
			if( (int)me->query("p_power_rank") < 1000000 )
			me->add("p_power_rank",random(9)+1);
			}
	  	me->start_busy(1);
		return 1;
	}
	else return 0;
}

int help(object me)
{
	write(@TEXT
指令格式：practice <技能种类>

这个指令让你练习某个种类的技能，这个技能必须是经过 enable 的专业技能。

如果你对这方面的基本技能够高，可以经由练习直接升级，而且升级的上限只跟
你基本技能的等级有关，换句话说，勤加练习是使你的所学「青出於蓝胜於蓝」
的唯一途径，当然，在这之前你必须从实际运用中获得足够的经验以提升你的基
本技能。
TEXT
	);
	return 1;
}
