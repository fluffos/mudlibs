// 瑜珈功--缩骨术
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
	object yoganpc, room;
	int yoga,xuanzang_force, yoga_time;
         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");
        if( !me->is_fighting() )
        return notify_fail("好象没有人要杀你！\n");
	if((int)me->query("sen")< 60)
	return notify_fail("你的神太差了！\n");
	yoga = (int)me->query_skill("yoga");
	xuanzang_force = (int)me->query_skill("xuanzang_force");
	if(yoga < 10 || xuanzang_force < 10)
	return notify_fail("你的瑜珈功和大迷玄藏功太差了，没法使用缩骨术！\n");	
	yoga_time = yoga * xuanzang_force / 10000 + 8;
         if (me->query("biguan_begin") )
	return notify_fail("正在闭关修行中，无法执行该动作。\n");

	if( me->query_temp("yoga_suogu") )
                return notify_fail("你正在施展缩骨术！\n");
	seteuid(getuid());
	me->receive_damage("sen",20);
	yoganpc= new("/daemon/class/lama/yoganpc");
	yoganpc->move(environment(me));
        yoganpc->invocation(me, (xuanzang_force+yoga));
        yoganpc->set("possessed", me);
        yoganpc->set("name", (string)me->query("name"));
        yoganpc->set("id", (string)me->query("id"));
        yoganpc->set("title", (string)me->query("title"));
        yoganpc->set("nickname", (string)me->query("nickname"));
        yoganpc->set("yoga_id", (string)me->query("id"));
	room = environment(me);
	me->set_temp("yoga_room",(string)room);
	message_vision(HIB "\n$N运起［瑜珈缩骨术］，全身骨骼咯咯一阵响，身形陡然缩小了一倍！\n\n" NOR, me);	
	me->move("/daemon/class/lama/yogaspot");
        me->add_temp("yoga_suogu",1);
        call_out("come_back", yoga_time, me);
	return 1;
}
void come_back(object me)
{
	object yoganpc;
	string yogaroom, yoganame;
	if( !me || !living(me) || me->is_ghost() ) return;
	yogaroom = me->query_temp("yoga_room");
	yoganame = me->query("id");
	if ( !yogaroom ) return;
	me->delete_temp("yoga_suogu");
	me->move(yogaroom);
	message_vision(HIB "\n$N全身骨骼咯咯一阵响，身形渐渐恢复了原样。\n" NOR, me);	
	me->delete_temp("yoga_room");
	if (present("suogu ren", environment(me)))
	{
	yoganpc=present("suogu ren", environment(me));
	if (yoganpc->query("yoga_id")==yoganame )
	destruct(yoganpc);
	}
}

