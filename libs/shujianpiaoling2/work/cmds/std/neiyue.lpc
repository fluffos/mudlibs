//内月玄壮
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  object env;
  object *inv;
  int i, force, zhanyi;
  if (me->query("battle_slg_mode"))
    return notify_fail("正在战略模式中，没有提供该指令。\n");
  if (me->query_delay())
    return notify_fail("你现在心绪紊乱，不能打坐。\n");
  if (me->query("biguan_begin"))
    return notify_fail("正在闭关修行中，无法执行该动作。\n");

  if ((int)me->query("gin") < 50)
    return notify_fail("你的精太差了！\n");

  if ((int)me->query("force") < 250)
    return notify_fail("你的内力不够！\n");

  force = (int)me->query_skill("force");
  zhanyi = (int)me->query_skill("zhanyidie");
  if (force < 30 || zhanyi < 30)
    return notify_fail("你的沾衣十八跌和内功太差了，无法运内月玄壮！\n");

  force = (int)me->query_skill("guiyu_force");
  zhanyi = (int)me->query_skill("chaos-steps");
  if (force < 30 || zhanyi < 30)
    return notify_fail("你运起内月玄壮，但是什么也没有发生。\n");

  if ((int)me->query("daode") < 100)
    return notify_fail("你运起内月玄壮，但是什么也没有发生。\n");

  seteuid(getuid());
  me->receive_damage("gin", 30);
  me->remove_busy();
  me->add("force", -200);
  me->remove_all_killer();
  /*
        env = environment(me);
        link_ob = me->query_temp("link_ob");
        obj = LOGIN_D->make_body(link_ob);
        if (!obj) return 0;
        me->save();
        exec(link_ob, me);
        destruct(me);
        obj->restore();
        LOGIN_D->enter_world(link_ob, obj, 1);
        obj->move(env);
        obj->write_prompt();
*/
  if (!arg)
    message_vision(HIC "\n$N运起［内月玄壮］，刹那间打通了全身经脉，身体舒泰自如。\n" NOR, me);
  else {
    zhanyi = 0;
    env = environment(me);
    inv = all_inventory(env);
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] == me) continue;
      if (!inv[i]->is_character() || inv[i]->is_corpse()) continue;
      if (userp(inv[i]) && inv[i]->query("env/invisibility") && arg == inv[i]->query("id")) {
        inv[i]->set("env/invisibility", 0);
        inv[i]->set_delay(3);
        zhanyi++;
      }
    }
    if (zhanyi) {
      message_vision(YEL "\n$N运起［内月玄壮］，刹那间全身宛若笼罩在一层月光之中。\n" NOR, me);
      message_vision(YEL "\n朦胧的月光骤然放出光辉，穿透了周围一切事物！\n" NOR, me);
    } else
      message_vision(YEL "\n$N运起［内月玄壮］，刹那间打通了全身经脉，身体舒泰自如。\n" NOR, me);
  }
  return 1;
}
