//七宝色相阵
#include <ansi.h>
//inherit F_CLEAN_UP;
inherit SSERVER;
int main(object me, object target)
{
	string msg;
	object firstob, nextob;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("[七宝色相阵]只能对战斗中的对手使用。\n");
         if (me->query("biguan_begin") )
	return notify_fail("正在闭关修行中，无法执行该动作。\n");

	if((int) me->query_skill("stormdance",1) <= 100)
	return notify_fail("你的七宝天岚舞还不够精纯，不能使用七宝色相阵。\n");
	if((int) me->query_skill("dodge",1) <= 100)
	return notify_fail("你的轻功身法太差了，不能施展七宝色相阵。\n");
	if((int) me->query_skill("force",1) <= 60)
	return notify_fail("你的内功太差了，不能施展七宝色相阵。\n");
	if((int) me->query_skill("zuodaoshu",1) <= 60)
	return notify_fail("你的旁门左道术太差了，不能施展七宝色相阵。\n");
	if( me->query_delay()>0 && me->query_delay()<4 )
                return notify_fail("(你上一个动作还没有完成，不能进行跳舞。)\n");

	if( (int)me->query("gin") < 100 )
		return notify_fail("你的精力不够，没有办法施展七宝色相阵。\n");
	if( (int)me->query("force") < 700 )
		return notify_fail("你的内力不够，没有办法施展七宝色相阵。\n");
	if( (string)target->query("gender")!="男性" )
	return notify_fail("你施展起七宝色相阵，但是对方不为所动。\n");
	if( target->query("mguard")||target->query("jgguard") )
	return notify_fail("你施展起七宝色相阵，但是对方根本不为所动。\n");
	if( (int)target->query("kill_player_record") >= 300 )
	return notify_fail("你施展起七宝色相阵，但是没有起任何效果。\n");
        if( target->is_busy() )
	return notify_fail("对方正手忙脚乱呢！\n");
        if( me->is_busy() )
	return notify_fail("你正忙着呢！\n");

	if( target->query("per")*10+ target->query("cps") +target->query("force") 
> random( (me->query("per")*10 +me->query_skill("stormdance",1)+ me->query("force"))*2 ) )
	return notify_fail("你施展起七宝色相阵，但是对方不为所动。\n");

message_vision(CYN"$N对$n冷哼一声，说道：让你见识一下本大士的[七宝色相阵]！\n"NOR,me,target);
msg = HIM "$N的身前突然化出六个一丝不挂的少女，手中各拿一盏宫灯，围着$n转个不停！" ;
msg +=  "\n$n只觉得身陷温柔乡中，登时目眩神迷，不能自拔。\n$n迷迷糊糊地丢下了身上的东西，慢慢解开了衣服. . .\n" NOR;

	message_vision(msg, me, target);
	target->add("kill_player_record", 100);
	target->set("force_factor", 0);
	if(target->query_skill_map()&& random(9)>4)
	{
	target->skill_enable_none();
       target->reset_action();
	}
//	target->set("env/brief", 1);
//	message_vision("\n$N忽然觉得眼前一片朦胧，什么也看不清楚了. . .\n\n"NOR,target);
//	target->set_alias("l", "");
//	target->set_alias("look", "");
	firstob = first_inventory(target);
	if(firstob){
	firstob->move(environment(target));}
	me->add("gin",-70);
	me->add("force",-700);
	me->add("kill_player_record", random(100));
	nextob = first_inventory(target);
	if(nextob){
	nextob->move(environment(target));}
	target->start_busy(3);
	me->start_busy(5);
	return 1;
}
