// more /cmds/usr/maphell.c
#include <ansi.h>

int main(object me, string str)
{
        object room;
        string msg,line;
        int i,x,y,z,j,k;
        room = environment(me);
	z=me->query("map_xyz")%10;
	i=0;

        if( !room->query("auto_maps") )
                return notify_fail("这里没法显示正邪武林大会的地图。\n");
//        file = base_name(room);

	write(HIY"\n武林大会--第"+chinese_number(z+1)+"层--大致地形。\n\n"NOR);
		for(y=0;y<19;y++)
		{
			for(x=0;x<19;x++)
			{
			if( (x*100+y*10+z)==me->query("map_xyz")%1000+990 && !i)
			{
			write("■");
			i++;
			}
			else if( (x*100+y*10+z)==me->query("master_xyz")%1000+990 && !j)
			{
			write("◎");
			j++;
			}
			else if( (x*100+y*10+z)==me->query("next_exit_xyz")%1000+990 && !k)
			{
			write("○");
			k++;
			}
			else
			write("□");
			}
		write("\n");
		}
	write("\n■为当前位置。");
	if( wizardp(me) )  write("  坐标: "+(string)(me->query("map_xyz")%1000)+"\n");
	write("\n◎为通往下层的出口。");
	if( wizardp(me) )  write("  坐标: "+(string)(me->query("master_xyz")%1000)+"\n");
	write("\n○为通往上层的出口。");
	if( wizardp(me) )  write("  坐标: "+(string)(me->query("next_exit_xyz")%1000)+"\n");
	else write("\n");
        return 1;
}

