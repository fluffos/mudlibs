// conjure.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string spells, spl, trg;
	object target;
	int pts;
	
	seteuid(getuid());
         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");
         if (me->query("biguan_begin") )
	return notify_fail("正在闭关修行中，无法执行该动作。\n");

	if( me->is_busy() )
		return notify_fail("( 你上一个动作还没有完成，不能施展神通。)\n");
	if( me->query_delay() )
		return notify_fail("( 你上一个动作还没有完成，不能施展神通。)\n");

	if( environment(me)->query("no_magic") )
		return notify_fail("这里无法使用神通。\n");
	if (present("toushi che", environment(me)))
		return notify_fail("你作法失败了。\n");
	if (present("biao che", environment(me)))
		return notify_fail("你作法失败了。\n");
	 pts=(int)me->query("atman_factor")/2+10;
	if( userp(me) && !wizardp(me) )
	{
        if( me->query("atman") < pts )
                return notify_fail("你的灵力不够！\n");
	}

	if( !arg ) return notify_fail("指令格式：conjure <神通> [on <目标>]\n");
	if( sscanf(arg, "%s on %s", spl, trg)==2 ) {
		target = present(trg, environment(me));
		if( !target ) target = present(trg, me);
		if( !target ) return notify_fail("这里没有 " + trg + "。\n");
	} else {
		spl = arg;
		target = 0;
	}
	if( me->query("kill_player_record") >= 300 )
		{
		me->set("force",0);
		me->set("force_factor",0);
		me->set_temp("weapon",0);
		me->add("kill_player_record", 10);
		return notify_fail("你刚动了意念，忽然感到身体一阵抽蓄，你的心魔发作了！\n");
		}

	spl = replace_string( spl, " ", "_");

	if( stringp(spells = me->query_skill_mapped("magic")) )
	{
		me->add("magic_exp", random(5));
		if( userp(me) && !wizardp(me) )
		me->add("atman",-pts);
		me->set_delay(1);
		return (int)SKILL_D(spells)->conjure_magic(me, spl, target);
	}
		
	return notify_fail("你请先用 enable 指令选择你要使用的神通系。\n");
}

int help (object me)
{
        write(@HELP
指令格式：conjure <法术名称> [on <对象>]
 
施法，你必需要指定<法术名称>，<对象>则可有可无。
在你使用某一个法术之前，你必须先用 enable 指令来指定你要使用的法术系。
 
HELP
        );
        return 1;
}
