//pizhi-monk.c 清判师纪录的NPC written by john darks
#include <ansi.h>
inherit NPC;
void create() {
  set_name("披枝和尚", ({ "pizhi monk", "monk" }));
  set("gender", "男性");
  set("age", 31);
  set("title", GRN "大慈恩寺住持" NOR);
  set("long",
    "大慈恩寺住持，江东八侠的二侠。\n");
  set("combat_exp", 800000);
  set("attitude", "friendly");
  set("per", 30);
  set("agi", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 40);
  set("score", 90000);
  set_skill("staff", 150);
  set_skill("lunhui-zhang", 150);
  set_skill("pyrobat-steps", 150);
  set_skill("dodge", 150);
  set_skill("wuxing-quan", 150);
  set_skill("unarmed", 150);
  set_skill("lotusforce", 150);
  set_skill("force", 150);
  set_skill("parry", 150);
  map_skill("dodge", "pyrobat-steps");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  map_skill("unarmed", "wuxing-quan");
  map_skill("force", "lotusforce");
  setup();
  carry_object("/d/city/obj/weapon/staff/gangzhang")->wield();
  carry_object("/d/city/obj/cloth/monkcloth")->wear();
}

void init() {
  add_action("do_answer", "answer");
}

int accept_object(object who, object ob) {
  int val;
  val = ob->value();
  if (!val) return 0;
  if (val >= 1000000) {   //Gold是一种标记 需要但不能依赖
    if (who->query("betrayer") > 0) {
      say(CYN "披枝和尚合什说道：阿弥陀佛，施主欲解判师之过，须散去本身武功的一部分。\n" NOR);
      write("减判师纪录一次，读书识字减半，所有的技能将减少十级！\n");
      //减少10 level等级 其实是用原来的10level特殊技换取新的20level特殊技
      write("如果你确认的话，请输入(Answer Yes)\n");  //给次机会 万一捐款多了. hehe
      who->add_temp("city/betrayer", 1);  //使用临时标记 
      return 1;
    } else {
      say(CYN "披枝和尚合什说道：阿弥陀佛，多谢施主为本寺捐助。\n" NOR);
      say(CYN "披枝和尚微笑道：施主并没有判师之过，但是这份心意老衲领了。\n" NOR);
      return 1;
    }
  } else say(CYN "披枝和尚合什说道：阿弥陀佛，多谢施主为本寺捐助。\n" NOR);
  return 1;
}

int do_answer(string arg)

{
  mapping myskill;
  int i;
  string *dirs;
  object me = this_player();
  if (!me->query_temp("city/betrayer"))
    return 0;
  if (!arg || (arg != "yes" && arg != "Yes")) {

    say(CYN "披枝和尚含笑点了点头，慈祥的摸了模你的头顶。\n" NOR);
    return 1;
  }
  if (me->query_skill("literate", 1))
    me->set_skill("literate", me->query_skill("literate", 1) / 2);
  me->add("betrayer", -1);
  say(HIC "披枝和尚僧袍被内力鼓起，你只觉周围微风飒然。\n" NOR);
  say(CYN "披枝和尚微微一笑，道：好了，施主今后要多报答师恩。去吧！\n" NOR);
  myskill = me->query_skills();
  dirs = keys(myskill);
  for (i = 0; i < sizeof(dirs); i++) {
    if (me->query_skill(dirs[i], 1) > 10)  //10 level
      me->set_skill(dirs[i], me->query_skill(dirs[i], 1) - 10);
    else {
      me->map_skill(dirs[i]);  //相当于放弃 但必须事先enable none 不然可能有bug
      //abandon指令没有这一步
      me->delete_skill(dirs[i]);
      me->reset_action();
    }
  }
  me->delete_temp("city/betrayer");
  return 1;
}
