#include <ansi.h>

inherit NPC;
string reward_more( object who);

void create()
{
        set_name("李都白", ({ "li doubai", "li"}) );
        set("gender", "男性" );
        set("age", 32);
        set("long", "这是一位武当弟子。\n");
        set("combat_exp", 50000);
	set("title", "武当弟子");
//	set("nickname", "");
        set("attitude", "friendly");
        set_skill("move", 40);
        set_skill("dodge", 40);
        set_skill("literate", 40);
        set_skill("unarmed", 40);
        set_skill("parry", 40);
        set_skill("force", 40);
        set_skill("sword", 40);

        set_skill("taiji-sword",40);
        set_skill("taiji-ken", 40);
        set_skill("taiji-force", 40);
        set_skill("tiyunzong", 40);

        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-ken");
        map_skill("parry", "taiji-sword");
        map_skill("force", "taiji-force");
        map_skill("sword", "taiji-sword");
        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
	
	setup();
	add_money("silver", 50);
        carry_object(__DIR__"obj/jinzhuang")->wear();
	carry_object("/obj/longsword")->wield();
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 120000 ) return "1";
			if( enemy[i]->query("combat_exp") > 150000 ) return "1";
			enemy[i]->add("combat_exp", 1);
		if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 200 ) return "1";
				enemy[i]->add("potential", 1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 1;
}

