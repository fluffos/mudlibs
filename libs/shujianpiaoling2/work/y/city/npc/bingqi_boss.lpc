// /d/city/npc/bingqi_boss.c  created by Baiwt

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create()
{
        object ob;

	set_name("时迅飞", ({ "shi xunfei","shi","boss" }) );
	set("gender", "男性" );
	set("age", 31);
	set("nickname", HIG "霹雳飞刀" NOR);
	set("long",
		"霹雳飞刀时迅飞，一手飞刀绝技出神入化。\n");
	set("combat_exp", 500000);
	set("attitude", "friendly");
	set("per",30);
	set("vendor_goods", ([
               "/obj/weapon/whip":20,
               "/obj/weapon/longsword":20,
               "/obj/weapon/dart":10,
               "/obj/weapon/shield":10,
               "/obj/weapon/eighthammer":10,
               "/obj/weapon/thin_sword":10,
               "/obj/weapon/dagger.lpc":10,
               "/obj/weapon/stick.lpc":10,
               "/obj/weapon/spear.lpc":10,
               "/obj/weapon/blade.lpc":10,
		  "/d/city/obj/weapon/whip/tielian":10,
                "/d/city/obj/weapon/axe/tiefu.lpc":10,
		__DIR__"obj/1staff.lpc":10,
               __DIR__"obj/knife.lpc":20,
               __DIR__"obj/dual_ring.lpc":10,
	]) );
	set_skill("throwing",250);
	set_skill("pyrobat-steps",50);
	set_skill("dodge",50);
	set_skill("parry",50);
	map_skill("dodge","pyrobat-steps");
	setup();
	carry_object(__DIR__"obj/jinzhuang")->wear();
        ob = carry_object("/obj/weapon/throwing_knife");
        ob->set_amount(30);
        ob->wield();
}
void init()
{
        add_action("do_vendor_list", "list");
}

