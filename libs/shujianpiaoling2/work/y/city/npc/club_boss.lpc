// waiter.c

inherit NPC;
#include <ansi.h>
void create() {
  set_name("公孙扬", ({ "gongsun yang", "gongsun", "boss" }));
  set("gender", "男性");
  set("age", 45);
  set("nickname", HIY "圣手得来" NOR);
  set("long",
    "这位＂圣手得来＂的赌场老板正满眼诡密的忘着你\n");
  set("combat_exp", 300000);
  set("attitude", "friendly");
  set("per", 30);
  set_skill("dodge", 250);
  set_skill("unarmed", 250);
  set_skill("stealing", 250);
  set_skill("wuxing-quan", 250);
  map_skill("unarmed", "wuxing-quan");
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 50);
  set_temp("apply/damage", 500);
  setup();
  carry_object("/obj/cloth/changpao")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      message_vision("$N向$n说道：请上二楼玩。\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N对$n阴笑一声：没钱别到这里来！\n", this_object(), ob);
      break;
    case 2:
      message_vision("$N望了$n一眼，笑道：这里十赌九赢，你信不信？\n", this_object(), ob);
      break;
  }
}
