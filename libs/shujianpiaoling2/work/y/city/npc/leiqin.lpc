#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("雷钦", ({ "lei qin", "lei" }));
  set("long",
    "这是个正在执行守城任务的大将，是龙飞虎大人的得力部将。\n"
    "[31m你最好不要招惹官府的人。 [37m\n");
  set("attitude", "heroism");

  set("title", "巡城将");
  set("nickname", HIG "铜锤太保" NOR);
  set("pursuer", 1);
  set("vendetta_mark", "authority");
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("combat_exp", 100000 + random(1000000));
  create_family("朝廷", 7, "官员");
  set("student_title", "官员");

  set_skill("unarmed", 50 + random(100));
  set_skill("parry", 50 + random(100));
  set_skill("dodge", 50 + random(100));
  set_skill("move", 100 + random(100));
  set_skill("force", 50 + random(100));
  set_skill("bixueforce", 50 + random(100));
  set_skill("hammer", 80 + random(100));
  set_skill("jinchui-hammer", 80 + random(100));
  map_skill("hammer", "jinchui-hammer");
  map_skill("force", "bixueforce");

  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 30 + random(100));
  set_temp("apply/armor", 70);
  set_temp("apply/move", 100);

  setup();

  carry_object(__DIR__ "obj/kiujia")->wear();
  carry_object("/d/city/obj/weapon/hammer/bahammer")->wield();
}
void attempt_apprentice(object ob) {
  if (ob->query("class") != "official") {
    command("say 我不教非官府的人。\n");
    return;
  }

  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，保家卫国！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "official");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("relation_exp") * 10 + (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "小兵");
    return;
  } else if (exp <= 64000) {
    student->set("title", "校尉");
    return;
  } else if (exp <= 128000) {
    student->set("title", "中郎将");
    return;
  } else if (exp <= 256000) {
    student->set("title", "牙将");
    return;
  } else if (exp <= 512000) {
    student->set("title", "偏将");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "参将");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "副将");
    return;
  }
}
