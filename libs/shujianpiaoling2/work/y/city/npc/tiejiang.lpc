// /d/city/npc/tiejiang.c  created by Baiwt
#include <ansi.h>
inherit NPC;
int check_legal_name(string arg);
int check_legal_id(string arg);

void create()
{
        set_name("雷海涛", ({ "lei haitao", "lei", "tiejiang"}) );
        set("gender", "男性" );
	set("nickname",HIB"惊雷斗鸷"NOR);
        set("age", 42);
        set("long",
                "雷海涛四十多岁，长得虎背熊腰。。\n");
        set("combat_exp", 600000);
        set("attitude", "peaceful");
	set("agi", 30);
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 50);
        set("score", 90000);

	set_skill("hammer",300);
	set_skill("pyrobat-steps",150);
	set_skill("dodge",150);
	set_skill("parry",150);
	set_skill("unarmed",150);
	set_skill("force",150);
	set_skill("lotusforce",150);
	set_skill("wuxing-quan",150);
	map_skill("dodge","pyrobat-steps");
	map_skill("unarmed","wuxing-quan");
	map_skill("force", "lotusforce");

        setup();

        carry_object("/d/city/obj/cloth/linen")->wear();
        carry_object("/d/city/obj/weapon/hammer/hammer")->wield();

}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
		call_out("greeting", 1, ob);
        }
	add_action("do_makeup","make");
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say( name()+"说道：这位" +
RANK_D->query_respect(ob)
                                + "，进来随便看看吧。\n");
                        break;
                case 1:
                        say(name()+ "用脖子上的毛巾抹了抹手，说道：这位" +
RANK_D->query_respect(ob)
                                + "，请进请进。\n");
                        break;
                case 2:
                        say(name()+ "说道：这位" +
RANK_D->query_respect(ob)
                                + "，进来挑一件称手的兵器吧。\n");
                        break;
        }
}

int do_makeup(string arg)
{
	string ctype, cname, ccolor, cid;
	object ob, me, gold;
	string id,newfile,filename;
        me = this_player();
	id = me->query("id");
/*
	printf( "player uid %O, player euid %O\n"
		"Smith's uid %O, Smith's euid %O\n",
		getuid(me), geteuid(me),
		getuid(this_object()),geteuid(this_object()));
*/
	seteuid(getuid( me ));
	if(!arg || sscanf(arg,"%s %s %s %s",ctype,ccolor,cname,cid ) != 4)
        return notify_fail("指令格式：make <type> <color> <name> <English name>\n");
	if(me->is_busy())
	return notify_fail("你上一个动作还没有完成。\n");
	if((int)me->query("created_item") >= 3)
	return notify_fail("你已经拥有太多自造物品了。\n");
	if((int)me->query("life_exp") < 100)
	return notify_fail("你的江湖阅历不够。\n");
	gold = present("gold_money", this_player());
        if(!gold) return notify_fail("你身上没有金子。\n");
        if((int) gold->query_amount() < 1)
        return notify_fail("你身上没有那麽多金子。\n");
	if( !check_legal_name(cname))
	return notify_fail("");
        if( !check_legal_id(cid))
        return notify_fail("");

	if( ccolor != "$BLK$" && 
	    ccolor != "$NOR$" &&
            ccolor != "$RED$" &&
            ccolor != "$GRN$" &&
            ccolor != "$YEL$" &&
            ccolor != "$BLU$" &&
            ccolor != "$MAG$" &&
            ccolor != "$CYN$" &&
            ccolor != "$WHT$" &&
            ccolor != "$NOR$" &&
            ccolor != "$HIR$" &&
            ccolor != "$HIG$" &&
            ccolor != "$HIY$" &&
            ccolor != "$HIB$" &&
            ccolor != "$HIM$" &&
            ccolor != "$HIC$" &&
            ccolor != "$HIW$" 
	)
	return notify_fail("不知你要什么颜色．\n");
	cname = ccolor + cname;
        cname = replace_string(cname, "$BLK$", BLK);
        cname = replace_string(cname, "$RED$", RED);
        cname = replace_string(cname, "$GRN$", GRN);
        cname = replace_string(cname, "$YEL$", YEL);
        cname = replace_string(cname, "$BLU$", BLU);
        cname = replace_string(cname, "$MAG$", MAG);
        cname = replace_string(cname, "$CYN$", CYN);
        cname = replace_string(cname, "$WHT$", WHT);
        cname = replace_string(cname, "$HIR$", HIR);
        cname = replace_string(cname, "$HIG$", HIG);
        cname = replace_string(cname, "$HIY$", HIY);
        cname = replace_string(cname, "$HIB$", HIB);
        cname = replace_string(cname, "$HIM$", HIM);
        cname = replace_string(cname, "$HIC$", HIC);
        cname = replace_string(cname, "$HIW$", HIW);
        cname = replace_string(cname, "$NOR$", NOR);
        cname += NOR;
	switch( ctype ) {
                case "axe":
                        newfile = read_file(__DIR__"obj/weapons/axe.lpc");
                        break;
                case "blade":
                        newfile = read_file(__DIR__"obj/weapons/blade.lpc");
                        break;
                case "dagger":
                        newfile = read_file(__DIR__"obj/weapons/dagger.lpc");
                        break;
                case "fork":
                        newfile = read_file(__DIR__"obj/weapons/fork.lpc");
                        break;
                case "hammer":
                        newfile = read_file(__DIR__"obj/weapons/hammer.lpc");
                        break;
                case "staff":
                        newfile = read_file(__DIR__"obj/weapons/staff.lpc");
                        break;
                case "sword":
                        newfile = read_file(__DIR__"obj/weapons/sword.lpc");
                        break;
                case "whip":
                        newfile = read_file(__DIR__"obj/weapons/whip.lpc");
                        break;
                case "spear":
                        newfile = read_file(__DIR__"obj/weapons/spear.lpc");
                        break;
                case "stick":
                        newfile = read_file(__DIR__"obj/weapons/stick.lpc");
                        break;
                case "ssword":
                        newfile = read_file(__DIR__"obj/weapons/ssword.lpc");
                        break;

		default:
			return notify_fail("这里不会做你要的东西．\n");
	}
	newfile = replace_string( newfile, "订作的", cname);
        newfile = replace_string( newfile, "order", cid);
        newfile = replace_string( newfile, "sjpl", id);
	filename = DATA_DIR+"login/" + id[0..0] + "/" + id + "/" + id +sprintf("%d",time()) + ".lpc";
	if( !write_file(filename, newfile,1))
		return 0;
	ob = new(filename);
	if(ob->move(me)){
	gold->add_amount(-1);
	me->add("created_item",1);
        me->start_busy(1);
	write("雷海涛满脸汗水说道：好啦，大功告成！拿去吧！\n");
	return 1;
	}
	return 0;
}
int check_legal_name(string name)
{
        int i;
        i = strlen(name);
        if( (strlen(name) < 2) || (strlen(name) > 40 ) ) {
                write("对不起，中文名字必须是一到二十个中文字。\n");
                return 0;
        }
        while(i--) {
                if( name[i]<=' ' ) {
                        write("对不起，中文名字不能用控制字元。\n");
                        return 0;
                }
                if( i%2==0 && !is_chinese(name[i..<0]) ) {
                        write("对不起，名字必需是中文。\n");
                        return 0;
                }
        }
        return 1;
}

int check_legal_id(string name)
{
        int i;
        i = strlen(name);
        if( (strlen(name) < 3) || (strlen(name) > 20 ) ) {
                write("对不起，英文名字必须是三到二十个字母。\n");
                return 0;
        }

	return 1;
}



