//changan city

inherit ROOM;

void create ()
{
        set ("short", "小院");
        set ("long", @LONG
这里是一个小小的院子,院中种着好大一片绿竹丛，迎风摇曳，雅致天然。
北面是店主卧室，南面是书房，再往里走是后院的一片草地。
LONG);

        set("exits", 
        ([ //sizeof() == 2
                "east" : __DIR__"yd-zl",
                "west" : __DIR__"yd-cd",
                "north" : __DIR__"yd-ws",
                "south" : __DIR__"yd-sf",
        ]));
/*
        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/yaopu_boss" : 1,
        ]));
*/
	set("outdoors", "changan");
        setup();
	replace_program(ROOM);
}


