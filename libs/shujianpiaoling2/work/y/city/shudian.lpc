//changan city

inherit ROOM;

void create() {
  set("short", "举才书局");
  set("long", @LONG
这是一家历史悠久的书店，一进门就可以看到几排书架，书架上整整
齐齐地放着一些手抄的卷轴，也有一些印刷精美的图书，书局老板陈举才
是当世大儒，因为看破世事，所以辞官不做，在长安城开了这家书局，使
得人们可以遨游书海。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "west": __DIR__ "qinglong-s2",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/bookseller": 1,
    ]));

  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
