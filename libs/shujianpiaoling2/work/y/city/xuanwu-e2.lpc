//changan city

inherit ROOM;

void create ()
{
        set ("short", "玄武大街");
        set ("long", @LONG

这里的路相当的宽，能容好几匹马车并行，长长的道路贯穿东西。
这是玄武大街的东段，北面是一家胭脂店，是夫人小姐们最常去的地方
，南边是一所大帮会，进出的都是一些江湖人物。往西通往东市中心，
往东便是春明门，从那里出城可以去往扬州。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
		"south" : __DIR__"beiyin1",
                "north" : __DIR__"yanzhidian",
                "west" : __DIR__"dongshi-center",
                "east" : __DIR__"dongmen",
        ]));

        set("objects", 
        ([ //sizeof() == 1
              NPC_DIR"people/army" : 1,
              NPC_DIR"people/boy" : 1,
                __DIR__"npc/shaonv" : 1,
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}

