//changan city

inherit ROOM;

void create ()
{
        set ("short", "启夏门");
        set ("long", @LONG

这里是长安的启夏门。北面就到了城中，远望人山人海，往来行人车
流不绝。东南一条大路通向茅山。城门下有一些执勤的兵士。时下虽
已天下太平，但一干兵将还是英姿勃勃，警惕的盯着往来人士。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
                "southeast" : __DIR__"qujiang",//goto maoshan and mojiao
                "north" : __DIR__"baihu-s3",
        ]));

        set("objects", 
        ([ //sizeof() == 1
//                __DIR__"npc/wujiang" : 1,
		__DIR__"npc/bing" : 3,
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
//	replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
        if (me->query("wiz")=="baiwt" )
	return ::valid_leave(me, dir);
	 else if (dir == "southeast" )
        return notify_fail("只听城楼上小兵喊道：城里戒严了，任何人未经允许不得出城！\n");
	else
        return ::valid_leave(me, dir);
}


