//changan city

inherit ROOM;

void create() {
  set("short", "白虎大街");
  set("long", @LONG
这里已是白虎大街的北段，北面可以看到一座大的宫殿，那是皇上
逢年过节或丰收时日与民同庆的行宫。西面是长安城的城隍庙，东面是
军校场，是军队出征集结之地。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "baihu-n2",
      "north": __DIR__ "xingqing",
      "west": __DIR__ "chenghuang",
      "east": __DIR__ "jiaochang",
    ]));

  set("objects",
    ([  //sizeof() == 1
    NPC_DIR "people/boy": 1,
      NPC_DIR "people/girl": 1,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
