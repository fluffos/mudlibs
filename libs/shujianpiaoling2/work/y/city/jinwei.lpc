//changan city

inherit ROOM;

void create() {
  set("short", "禁卫军营");
  set("long", @LONG
京城驻扎着数万禁卫军，保卫皇上的安全，大多驻扎在皇宫周围以确
保皇宫的安全。只见兵营内一排排兵营延绵不绝，还隐隐约约能听见操练
士兵发出的呐喊声，不时还有一队队士兵走过。远处只能看见一面帅旗随
着风飘扬在空中。
LONG);
  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "west": __DIR__ "zhuque-n2",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/jinwei_master": 1,
      __DIR__ "npc/qipaiguan": 1,
      __DIR__ "npc/armymen1": 5,
    ]));
  set("NONPC", 1);

  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
