//changan city

inherit ROOM;

void create() {
  set("short", "国宾馆大厅");
  set("long", @LONG
大厅相当的大，能容几百人开宴会。大厅内各国使节往来不断，不
同方言充斥耳间。桌上摆了各种新鲜水果，美味佳肴，招待着四方
来客。一群舞女随着节拍翩翩起舞，娥娜多姿。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 2
    "east": __DIR__ "baihu-n2",
      "west": __DIR__ "guobinguan2",
    ]));

  set("objects",
    ([  //sizeof() == 1
    "/d/city/obj/misc/tables": 1,
      "/d/city/obj/misc/chairs": 2,
    ]));

  set("no_clean_up", 0);
  setup();
  //	replace_program(ROOM);
}
int valid_leave(object me, string dir) {
  if (dir == "west") {
    if (me->query("quest/guanfu") != "waijiao")
      return notify_fail("国宾馆是接待各国使节的地方，寻常人等不得入内。\n");
  }
  return ::valid_leave(me, dir);
}
