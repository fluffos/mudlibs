// shoe.c

#include <armor.h>
inherit BOOTS;
inherit F_AUTOLOAD;
string query_autoload() 
{ 
	return query("name") + " " + query("long"); 
}
void autoload(string arg)
{
	string name,long;
    sscanf(arg, "%s %s", name, long);
    set("name",name);
    set("long",long);
}

void create()
{
	set_name( "布鞋", ({ "shoes" }) );
	set_weight(900);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","一双手工精细的鞋子。\n");
		set("material", "cloth");
		set("unit", "双");
		set("armor_prop/armor", 1 );
	}
	setup();
}


