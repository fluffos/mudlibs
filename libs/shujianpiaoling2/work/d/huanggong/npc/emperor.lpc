#include <ansi.h>
inherit NPC;

void create()
{
  set_name("德宗皇帝", ({"dragon king", "king", "dezong", "dragon", "emperor"}));
  set("long", "中华大国之皇帝德宗。\n");
  set("title", HIR"当今圣上"NOR);
  set("nickname", HIY"君临天下"NOR);
  set("gender", "男性");
  set("rank_info/respect", "陛下");
  set("age", 80);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("id_type", 9);
  set("per", 30);
  set("int", 30);
  set("class","official");
  set("off_position",1);
  set("max_kee", 39999);
  set("max_gin", 39999);
  set("max_sen", 39999);
  set("combat_exp", 999999);
  set_skill("leadership",299);
  set_skill("economics",299);
  set_skill("officialism",299);
  set_skill("dodge", 399);
  set_skill("parry", 399);
	set_temp("apply/attack", 99);
	set_temp("apply/defense", 99);
	set_temp("apply/move", 99);
	set_temp("apply/damage",199);
	set_temp("apply/armor",199);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: command, "alert" :),
        }) );
  setup();
  carry_object("/d/city/obj/cloth/mangpao")->wear();
  
}

void init ()
{
//  ::init();
  add_action("do_kneel", "kneel");
}

string *strs = ({
  "$N对$n赞赏道：",
  "$N微笑着对$n说道：",
  "$N赞许地对$n说道：",
});


int do_kneel(string arg)
{
	object me = this_player();
	object ob = this_object();
	if(!arg || arg!="king")
		return notify_fail("你要拜谁？\n");
	if (me->query("off_position") )
	return notify_fail("你已经求过赏了，快退下！\n");
	if ((string)me->query("class") != "official")
	return notify_fail("你不是朝廷命官，求什么赏？还不快退下！\n");
	if ((int)me->query("combat_exp") < 1000000 )
	return notify_fail("你经验太低了，求什么赏？还不快退下！\n");
	if ((int)me->query_skill("officialism",1 ) < 100 )
	return notify_fail("你为官之道太低了，求什么赏？还不快退下！\n");
	if ((int)me->query_skill("leadership",1 ) < 100 )
	return notify_fail("你用人之技太低了，求什么赏？还不快退下！\n");
  message_vision (YEL+ strs[random(sizeof(strs))]+RANK_D->query_respect(me)+
                  "为国操劳，功勋卓著，朕有赏御赐与你！\n"NOR,ob,me);
  message_vision (CYN"\n$N走上前，赶紧在$n的殿前俯身跪下。\n"NOR,me,ob);
  me->start_busy (3);
  call_out ("reward_player",3,me,ob);
  return 1;
}

void reward_player (object me, object ob )
{
  message_vision (YEL"\n$n高声向$N说道：朕封你为一品钦差，赏赐御前带刀侍卫一名，随时保护你的安全。（使用alert指令）\n"NOR,me,ob);
  me->set("title","御赐钦差");
  me->set("off_position", 1);
  message_vision (CYN"\n$N连忙俯身一拜，叩头谢道：谢主龙恩！\n\n"NOR,me);
  return;
}
