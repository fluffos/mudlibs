inherit ROOM;

void create ()
{
  set ("short", "皇城");
  set ("long", @LONG
这是雄伟恢弘的皇城，巨大的紫铜城门紧闭着，城墙是用条形
花岗石奠基，城砖是按规定的尺寸、重量烧制的。整个工程结构复
杂，壮观浩大，令人叹为观止。
LONG);

  set("objects", ([ /* sizeof() == 2 */
  __DIR__"npc/weishi" : 3,
  __DIR__"npc/lvzhen" : 1,
]));
  set("outdoors", 1);
  set("exits", ([ /* sizeof() == 4 */
  "south" : "/d/city/zhuque-men",
  "north" : __DIR__"chengtian-men",
]));
	set("NONPC",1);

  setup();
}

int valid_leave(object me, string dir)
{
        if (me->query("class")=="official")
	return ::valid_leave(me, dir);
	if (dir == "north" ) {
        if (objectp(present("lv zhen", environment(me))))
	return notify_fail("吕振铁枪一横，喝道：此乃皇宫，禁行！\n");
        if (objectp(present("wei shi", environment(me))))
        return notify_fail("金甲卫士喊道：我家将军不在，小人不敢放您进去！\n");
        }   
        return ::valid_leave(me, dir);
}

 

