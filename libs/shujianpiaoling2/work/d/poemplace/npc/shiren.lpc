// shiren.c

inherit NPC;

#include <ansi.h>

int send_back(object me);

void create() {
  set_name("浪游诗人", ({ "langyou shiren", "shiren", "langyou" }));
  set("gender", "男性");
  set("age", 26);
  set("combat_exp", 200000);
  set("attitude", "friendly");
  set_skill("literate", 100);
  set_skill("dodge", 100);
  setup();
  //	carry_object("/d/city/obj/cloth/skirt")->wear();
  carry_object("/obj/cloth")->wear();
}
