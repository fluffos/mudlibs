#include <room.h>
inherit ROOM;
void create()
{
  set("short","二楼大厅");
  set("long",@LONG
大厅的四壁极为辉煌，连墙纸都是镀银的，在灯火下
闪闪发光。大厅正中悬吊着一座由上千支蜡烛插在一起的
巨灯，使整个大厅没有一个黑暗的角落。门口一张黑底金
LONG
  );
  set("exits",([
	 "down" : __DIR__"ta-duchang",
//	"up" : __DIR__"gold",
               ]));
        set("objects", ([
                __DIR__"npc/huoyuee" : 1,
       ]) );
        set("no_fight",1);
        set("no_magic",1);
        set("no_study",1);
        set("NONPC",1);
        set("no_steal",1);
	set("hell", 1);
        setup();

}
int valid_leave(object me, string dir)
{
        object dealer, pl;
        string *locs = ({"north","south","east","west","down"});
        int m;
        dealer = present("huo yuee",this_object());
        for(m=0;m<sizeof(locs);m++)
        if(objectp(pl=dealer->query(locs[m]+"/player")) && pl == me)
        return notify_fail("赌局正在进行中，不可随便走动！\n");
        return 1;
}

