inherit NPC;
string do_learnbook();
void create()
{
    set_name("魏柄林",({"wei binglin","wei"}));
    set("long", "魏老先生乃是当朝探花的授业恩师，学富五车，远近学子多来求教。\n");
    set("title", "老师爷");
    set("gender", "男性");
    set("age",54);
    set("attitude", "friendly");
    set("food", 500);
    set("water", 500);
    set("str", 120);
    set("per", 20);
    set("con", 20);
    set("int", 20);
    set("cps", 20);
    set("inquiry", ([
        "learn"  :  (:do_learnbook:),
        "求教"  :  (:do_learnbook:),
        "study" : (:do_learnbook:),

]) );
    set_temp("combat_exp", 20000);
    set_temp("apply/attack", random(100));
    set_temp("apply/defense", random(100));
    set_temp("apply/damage", 30);
    set_temp("apply/armor", 40);

    set_skill("dodge", 100);
    set_skill("unarmed", 100);
    set_skill("parry", 100);
    set_skill("sword", 100);
    setup();
        carry_object("/obj/cloth")->wear();
 }

string do_learnbook()
{
  object me=this_player(); 
  if(!me->query_temp("can_learn"))
          return "你需要先付学费。\n";
  if(me->is_busy())
          return "这一课还没上完呢，学习要循序渐进，不能着急。\n";
  if(me->query("sen") < 20)
          return "你心神不定，无法学习新的知识。\n";
  if(me->query_skill("literate",1) > 20)
          return "你的学问已经不错了，在这里已经没什么可学了。\n";
  message_vision("$N摇头晃脑地读道：人之初，性本善。道相近，习相远。。。\n",this_object(),me);
  me->start_busy(9);  
  me->receive_damage("sen", random(20)+1);
  if( me->query_skill("literate",1) < 20 )
  {
  me->improve_skill("literate",random((int)me->query("int")) + 20);
  me->add("potential",1);
  }
  me->delete_temp("can_learn");
  return "路漫漫其修远兮。。。\n";
}  
                                           
int accept_object(object me, object ob)
{
	if (ob->query("money_id") && ob->value() >= 200) 
	{
		me->set_temp("can_learn",1);
		tell_object(me, "魏柄林说道：很好，你自己找位子坐下，准备上课。（ask wei about study）\n");
	return 1;
	}
	else
		tell_object(me, "魏柄林说道：每上一课要交至少二两银子的学费。\n");
		return 0;
}
