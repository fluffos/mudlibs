#include <ansi.h>
inherit NPC;
int custom();

void create() {
  set_name("归驼子", ({ "gui tuozi", "gui" }));
  set("gender", "男性");
  set("age", 44);
  set("long",
    "他是武林四恶中的[恶穷神]归驼子。\n"
  );
  set("title", "武林四恶之一");
  set("nickname", HIG "恶穷神" NOR);
  set("str", 127);
  set("int", 22);
  set("per", 2);
  set("id_type", 2);
  set("max_kee", 1700);
  set("max_sen", 1500);
  set("kee", 1700);
  set("sen", 1500);
  set("max_force", 20000);
  set("force", 20000);
  set("force_factor", 10);
  set("combat_exp", 550000);
  set_skill("force", 130);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 140);
  set_skill("iron-cloth", 100);
  set_skill("zhanyidie", 120);
  set_skill("xianglong_strike", 120);
  map_skill("iron-cloth", "zhanyidie");
  map_skill("unarmed", "xianglong_strike");
  set("score", 1000);
  set("chat_chance", 50);
  set("chat_msg", ({
    (: random_move :),
    (: custom :)
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.hubo" :),
  }));
  setup();
  carry_object("/u/baiwt/xueshan/obj/cloth")->wear();
}
int custom() {
  int i;
  object env, *inv;
  object me = this_object();
  env = environment(me);
  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (inv[i]->is_corpse()) continue;
    if (!inv[i]->is_character()) continue;
    if (inv[i]->query("id_type") == 1)
      me->fight_ob(inv[i]);
  }
  return 1;
}
