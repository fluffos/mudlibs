inherit ROOM;

void create()
{
        set("short", "青石官道");
        set("long", @LONG
这是一条宽敞坚实的青石大道，向西延伸。你隐约中已经看到
雄伟高大的泰山了。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"guanroad3",
  "west" : "/u/taishan/yidao",
//  "west" : "/y/baiwt/chezhan",
]));
        set("outdoors", "shandong");
        set("NONPC", 1);
	set("hell", 1);

        setup();
//        replace_program(ROOM);
}
int valid_leave(object me,string dir)
{
	object ob;
       if( dir=="west" && !me->query_temp("not_newbie") )
	{
	 if( me->query_skill("unarmed",1)< 4 || me->query_skill("dodge",1)<4||me->query_skill("literate",1)<4
	|| me->query_skill("parry",1)< 4 || me->query("combat_exp")< 200 ) 
	return notify_fail("你想离开家乡，踏入漭漭江湖。\n你心中暗道：江湖险恶，还是先回去学点功夫吧！\n");
	me->set_temp("not_newbie",1);
	me->set("startroom","/u/taishan/yidao");
//	me->set("startroom","/y/baiwt/chezhan");
       return notify_fail("你决定离开家乡，踏入漭漭江湖。\n江湖险恶，这一去就不能再回头了。你确定吗？\n");
}
