inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("酒壶", ({ "jiuhu" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个装“三碗不过岗”的大葫芦，哇！武松喝的耶！\n");
    set("unit", "个");
    set("value", 200);
    set("max_liquid", 20);
  }

  set("liquid", ([
    "type": "alcohol",
    "name": "三碗不过岗",
    "remaining": 20,
    "drunk_apply": 3,
  ]));
}
