inherit ITEM;
inherit F_FOOD;

void create()
{
     set_name("烤乳猪", ({ "zhu" }));
    set_weight(2000);
    if( clonep() )
            set_default_object(__FILE__);
    else {
          set("long", "一块油腻的烤乳猪，香着呢！流口水了吧！哈哈！\n");
          set("unit", "块");
          set("value", 200);
          set("food_remaining", 10);
          set("food_supply", 200);
     }
}


