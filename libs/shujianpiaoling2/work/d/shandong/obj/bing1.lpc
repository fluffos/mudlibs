inherit ITEM;
inherit F_FOOD;

void create()
{
     set_name("白吉膜", ({ "bing" }));
    set_weight(1000);
    if( clonep() )
            set_default_object(__FILE__);
    else {
          set("long", "引进的外省的小吃，白面饼夹肉，哈哈！香着呢！\n");
          set("unit", "个");
          set("value", 80);
          set("food_remaining", 6);
          set("food_supply", 120);
     }
}


