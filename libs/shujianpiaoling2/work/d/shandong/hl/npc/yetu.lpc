#include <ansi.h>

inherit NPC;
void reward_more( object who);

void create()
{
	set_name("野兔", ({ "ye tu", "tu" }) );
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 5);
	set("long", "这是一只可爱的野兔，正在找胡萝卜吃. \n");
	
	set("str", 25);
	set("cor", 30);
	set("cps", 22);

	set("max_kee", 100);
	set("max_gin", 100);
	set("max_sen", 100);
	set("limbs", ({ "头部", "身体", "前脚", "後脚" }) );
	set("verbs", ({ "bite", "claw" }) );
        set_skill("move", 30);
        set_skill("dodge", 30);
	set("attitude", "friendly");
	set("env/wimpy", 60);
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
        }) );

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
		set("combat_exp", 100);
	setup();
        carry_object("/obj/food/turou");
}
void reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
		if( random(9)>6 )
		{
			if( enemy[i]->query("combat_exp") < 10000 )
			enemy[i]->add("combat_exp", 1);
		}
		else
                if( enemy[i]->query_skill("dodge",1)<20 ) 
                enemy[i]->improve_skill("dodge",2);
		}
	}
	return;
}
int accept_fight(object me)
{
        return 0;
}

