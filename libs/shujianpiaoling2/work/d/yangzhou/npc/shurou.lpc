inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("死老鼠", ({ "died mouse", "mouse" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一只鲜血淋漓肥的死老鼠。\n");
    set("unit", "只");
    set("value", 200);
    set("food_remaining", 4);
    set("food_supply", 50);
  }
}
