inherit NPC;

void create()
{
        set_name("皮包骨", ({"pi baogu", "pi"}));
        set("age", 22);
        set("title", "饿鬼帮帮众");
        set("gender", "男性");
        set("long",
"虽然武功不怎么样，但心黑手辣，也不好惹。\n");
        set("attitude", "heroism");

        set("combat_exp", 10000+random(2000));
        set("shen_type", 1);

        set_skill("unarmed", 30);
        set_skill("dodge", 30);
        set_skill("parry", 20);
        set_skill("dagger", 25);

        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );
        setup();
        carry_object("/d/city/obj/weapon/dagger/dagger")->wield();
        carry_object("/d/city/obj/cloth/linen")->wear();
}


