// Npc: guard.c
inherit NPC;
void create() {
  set_name("参将", ({ "jiang" }));
  set("gender", "男性");
  set("age", 35);
  set("long", @LONG
这是一名守卫扬州城的参将，看他的模样，显然是身经百战的勇士。
LONG
  );
  set("combat_exp", 300000);
  set("attitude", "friendly");
  set("vendetta_mark", "authority");  // 记仇标记=“authority” (官府)

  set("inquiry", ([
  ]));
  set_skill("dodge", 500);
  set_skill("hammer", 100);
  set_skill("unarmed", 500);
  set_skill("force", 500);
  set("water", 400);
  set("food", 400);
  set("max_force", 3000);
  set("force", 3000);
  set("force_factor", 50);
  setup();
  carry_object("/obj/weapon/sixhammer")->wield();
  carry_object("/obj/armor/armor1")->wear();
  add_money("silver", 50);

}
