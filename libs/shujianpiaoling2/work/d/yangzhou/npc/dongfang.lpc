#include <ansi.h>

inherit NPC;

void create()
{
        set_name("东方无通", ({ "dongfang"}) );
        set("gender", "男性" );
        set("age", 32);
        set("long", "这是长安棋院院主");。\n");
        set("combat_exp", 50000);
	set("title", "长安棋院院主");
//	set("nickname", "");
        set("attitude", "friendly");
        set_skill("unarmed", 90);
	set_skill("dodge", 100);
        set("parry", 200);
	
	setup();
	add_money("silver", 50);
        carry_object(__DIR__"obj/jinzhuang")->wear();
}

