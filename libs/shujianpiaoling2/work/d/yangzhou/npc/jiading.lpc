

inherit NPC;
void create()
{
        set_name("青衣家丁", ({ "jiading" }) );
        set("gender", "男性" );
        set("age", 38);
        set("str", 28);
        set("cor", 27);
        set("cps", 25);
        set("int", 23);

        set("max_force", 100);
        set("force", 100);
        set("force_factor", 1);

        set("attitude", "heroism");

        set("long","这是一位赵王府的家丁。\n");

        set("combat_exp", 2000);
        set("score", 50);

        set_skill("hammer", 20);
	set_skill("dodge", 20);
	set_skill("parry", 20);
	setup();
        carry_object("/obj/cloth")->wear();
        carry_object(__DIR__"obj/6hammer")->wield();
        add_money( "coin" , 50);
}

