inherit NPC;

void create()
{
        set_name("骂不三", ({"ma busan", "ma"}));
        set("age", 22);
        set("gender", "男性");
        set("title", "饿鬼帮帮众");
        set("long",
"虽然武功不怎么样，但心黑手辣，也不好惹。\n");
        set("attitude", "heroism");

        set("combat_exp", 10000+random(2000));
        set("shen_type", 1);

        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set_skill("parry", 20);
        set_skill("blade", 20);

        set("chat_chance_combat", 10);
        set("chat_msg_combat", ({
                "骂不三大喊，敢跟老子过不去，去死吧！\n"
        }));
        setup();
        carry_object("/d/city/obj/weapon/blade/blade")->wield();
        carry_object("/d/city/obj/cloth/linen")->wear();
}


