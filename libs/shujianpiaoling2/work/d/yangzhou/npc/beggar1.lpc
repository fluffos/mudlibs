// beggar.c
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("乔峰", ({ "wind","beggar" }) );
		set("title",GRN "小乞丐" NOR);
        set("gender", "男性" );
        set("age", 17);
        set("long", "一个满脸泥污的小乞丐，身上背着一个布袋。\n");
        set("combat_exp", 200);
        set("str", 27);
        set("force", 110);
        set("max_force", 110);
        setup();
        carry_object("/obj/beg_cloth")->wear();
        carry_object("/obj/bag");
	    add_money("silver", 20);
}

int accept_fight(object me)
{
        command("say " + RANK_D->query_respect(me) + 
"想打架？我是流氓我怕谁！！\n");
        return 1;
}
 
