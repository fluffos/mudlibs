inherit NPC;
void create()
{
	set_name("少林武僧", ({ "seng" }) );
	set("gender", "男性" );
	set("age", 30);
	set("str",60);
	set("cor",30);
	set("cps",30);
	set("int",30);
	set("long", "这是一个身穿袈裟，虎背熊腰的少林僧人。\n");
	set("combat_exp", 1000000);
	set("env/wimpy", 2);
	set("force",5000);
	set("max_force",3200);
	set_skill("literate",50);
	set_skill("dodge",150);
	set_skill("parry",150);
	set_skill("unarmed",150);
	set_skill("sword",150);
	set_skill("shaolin-step",130);
	set_skill("yingzhua",150);
	map_skill("dodge","shaolin-step");
	map_skill("unarmed","yingzhua");
	setup();
	carry_object("/obj/cloth")->wear();
}
