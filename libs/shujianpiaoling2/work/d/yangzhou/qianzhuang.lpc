//yangzhou  qianzhuang.c
inherit ROOM;

void create() {
  set("short", "钱庄");
  set("long", @LONG
你走进了扬州的钱庄，这里略现昏暗，当前巨大的柜台用手指粗细的
铁栏杆围着，一副小心谨慎的模样。柜台后面坐着一个一脸精明的中年人,
就是这里的老板了，据说他本事江湖大盗归隐后开了这坐钱庄，因此没有什
么人敢打他的主意，把钱存在这里看来是很安全的了,柜台上放着一个牌子
(sign)，提醒着大家。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "dongjie2",
  ]));

  set("item_desc", ([
    "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

convert     兑换钱币。
withdraw    提取存款。
deposit     存入钱币。
balance     察寻存款。
TEXT
  ]));


  set("objects", ([
    __DIR__ "npc/bank_boss": 1,

  ]));


  setup();
}
