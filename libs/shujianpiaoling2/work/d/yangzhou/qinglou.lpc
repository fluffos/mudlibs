inherit ROOM;

void create ()
{
        set ("short", "妓院大厅");
        set ("long", @LONG
你信步走进丽春院的大厅。整个大厅布置的极其豪华奢侈。一看就
知道不是普通百姓所能来的地方。光当前的一座玉石屏风就以不是普通
官宦人家所能买的起的。在迎面的墙壁上挂着一副对联：曾观沧海难为
水，除却巫山不是云。横批几个大字：   春  风  满  堂
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
             	"west" : __DIR__"louti",
              "south" : __DIR__"xijie2",

        ]));

        set("objects", 
        ([ //sizeof() == 1
		__DIR__"npc/guipo" : 1,
"/u/lark/fnpc/guinu":2,
]));


     //   set("outdoors", "yangzhou");
	set("no_clean_up", 0);
	        setup();
}


