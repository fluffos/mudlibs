//yangzhou  yizhan.c
inherit ROOM;

void create()
{
        set("short", "驿站");
        set("long", @LONG
这里是扬州唯一的一家驿站，你要是有什么物品的话可以托这里的人转
交，当然是要花钱的了。但只要是交到这里的物品你就放心好了，这里的信
誉是首屈一指的。
LONG
        );
        set("exits", ([/* sizeof() == 4 */
           "north" : __DIR__"dongjie2",
]));
set("objects", ([
		__DIR__"npc/yizhan_boss": 1
	]) );


        set("no_clean_up", 0);

        setup();
//        replace_program(ROOM);
}
int valid_leave(object me, string dir)
{
	object mbox;

	if( mbox = me->query_temp("mbox_ob") ) {
		tell_object(me, "你将信箱交回驿站。\n");
		destruct(mbox);
	}
	return 1;
}

