// Room: /u/wuhan/shui3.c

inherit ROOM;

void create()
{
	set("short", "江下");
	set("long", @LONG
你沿着礁石往下游了一段, 忽然见前面黑忽忽的有一团什么东西, 游近了一看
却是一条大水蛇, 盘着一口箱子. 礁石林中夹着不少断折的圆木, 好象曾经是艘
大船的桅杆.
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "up" : __DIR__"shui2",
]));
        set("objects", ([
	__DIR__"npc/shuishe"  : 1,
	__DIR__"obj/swordbook" : 1,
	__DIR__"obj/parrybook" : 1,
]));
	set("no_clean_up", 0);

	setup();
}
void init()
{
     add_action("do_dive", ({"dive","tiao","tiaoshui"}) );
}

int do_dive()
{
        object ob;

        if((int) this_player()->query_skill("diving", 1)<55)    
	    return notify_fail("你的水下功夫不够!\n");

       tell_room(__DIR__"shui4",
		this_player()->query("name")+"一个猛子扎下来!\n");
       message_vision("$N深吸了一口气, 一个猛子又往水的深处扎下去\n", this_player());
                this_player()->move(__DIR__"shui4");
	
       return 1;
}
