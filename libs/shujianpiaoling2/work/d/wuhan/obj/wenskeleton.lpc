inherit ITEM;

void create() {
  object ob;
  set_name("骷髅", ({ "skeleton", "wenskeleton" }));
  set("long", "这具骷髅在这里大概有几十年了吧！衣服都已腐朽掉了，靠\n"
    "腰部的地上有一个镖囊。\n");
  set_max_encumbrance(10000);
  set("no_get", 1);
  setup();
  ob = new("/d/wuhan/hankou/obj/yanwei");
  ob->move(this_object());
  ob = new(__DIR__ "pinglongren");
  ob->move(this_object());
  ob = new(__DIR__ "map2");
  ob->move(this_object());
}

int is_container() { return 1; }
