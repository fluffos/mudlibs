// pinglongren.c

inherit ITEM;

void create()
{
	set_name("平龙认", ({ "pinglongren" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
		"平龙认   玄黄教主著\n");
		set("material", "paper");
		set("skill", ([
			"name": 		"force",
			"exp_required":	1000,
			"sen_cost":		40,		
			"difficulty":	40,			
			"max_skill":	71,		
	        ]) );
	}
}


