// lumber_axe.c

#include <weapon.h>

inherit ITEM;

void create()
{
	set_name("钥匙", ({ "this key" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "一个钥匙");
                set("value", 11);
        }
        setup();
}
