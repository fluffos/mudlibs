// mengran.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("梦冉", ({ "silk"}) );
	set_weight(0);
	set("value", 0);
	set("long", "如梦如幻似梦非梦\n");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "silk");
		set("armor_prop/armor", -10);
		set("armor_prop/dodge", 50);
	}
	setup();
}

