// myroom :D

inherit ROOM;

void create()
{
        set("short","穷的家");
        set("long",
        "  这是穷的家, 房间不大, 只放了一张桌子一张床, 连椅子都没有,\n"
	"显出特别是没钱的样子。你鬼鬼祟祟地望望，却发现左边的墙脚有一\n"
	"狗洞, 如果试试，你都刚好能爬进去. 门(door)后面有一堆柴火.\n");
        set("exits", ([
                "south" : __DIR__"myroom_st",
        ]) );
	set("item_desc", ([
			"狗洞":
			   "看来这个洞(hole)能钻进去.\n",
			"柴火":
			   "一堆要砍(chop)的柴火(chaihuo).\n",
			"chaihuo":
			   "一堆要砍(chop)的柴火(chaihuo).\n",
			"door":
			  "门上有个钥匙孔(kong), 可以把钥匙放进去(put in).\n"
	]) );
        set("objects", ([
			 __DIR__"npc/nomoney1" : 1 ]) );
        set("no_clean_up", 0);
        setup();
} 

void init()
{
	add_action("do_enter",({"enter", "zuan"}) );
	add_action("do_search", ({"search"}) );
	add_action("do_throw",({"throw"}) );
	add_action("do_chop", ({"chop"}) );
	add_action("do_put", ({"put"}) );
	add_action("do_look", ({"look"})  );
}


int do_enter(string arg)
{
	object me = this_player();
	
	if( !arg || arg!= "hole")
		return notify_fail("你要钻什么?\n");
//	message_vision(
//		"穷在你屁股上拍了一下, 说:'钻什么钻, 那是狗洞你不知道吗?'\n",
//		this_player());
	tell_object(me,"穷在你屁股上拍了一下, 说:'钻什么钻, 那是狗洞你不知道吗?'\n"	);
	message("vision", "穷在"+me->name()+"屁股上拍了一下, 说:'钻什么钻, 那是狗洞你不知道吗?'\n",
		environment(me),me);
	return 1;
}


int do_search(string arg)
{
	object ob;
	
	ob = new(__DIR__"obj/goushi");
	ob->move(this_player());
	
	this_player()->receive_damage("sen",20);
	message_vision(
		"$N在桌子上找到了点什么放在身上.\n",
		this_player() );
	return 1;
}  

int do_throw(string arg)
{
	string from , to;
	object ob;
	
	if( !arg || sscanf(arg, "%s to %s", from, to)!=2
	|| from!="rice" || to != "hole" )
	 return notify_fail("你把什么扔到(to)什么地方去?\n");
	
	if( !(ob = present("rice",this_player())))
	  return notify_fail("你身上没有这个东西!\n");
	  
	ob = new(__DIR__"npc/crazy_dog");
	ob->move(this_object());
	ob->kill_ob(this_player());
	
	ob = new(__DIR__"obj/axe");
	ob->move(this_object());
	tell_room(__DIR__"myroom",
	"一条疯狗猛地从洞里冲出来,同时把一个什么东西带了出来...\n");
	return 1;
}


int do_chop(string arg)
{		
	object ob;
	
	if( !arg || arg!= "chaihuo")	
	      return notify_fail("你砍什么?\n");
	if( !(ob = this_player()->query_temp("weapon")) )
		return notify_fail("你用什么砍?\n");
	if( (string)ob->name() != "斧子") {
		message_vision("$N用"+(string)ob->name()+"你乱砍一通\n",
		this_player() );
		return 0;
	}
//		return notify_fail("你用"+(string)ob->name()+"你乱砍一通\n");
	destruct(ob);	
	ob = new(__DIR__"obj/key");
	ob->move(this_player());
	message_vision(
		"$N把柴火砍完, 累得一塌糊涂, 却在墙角找着了一把钥匙.\n",
		this_player() );
	
	this_player()->receive_damage("gin", 30);
	this_player()->receive_damage("kee", 50);
	this_player()->receive_damage("sen",40);
	return 1;
}

int do_put(string arg)
{
	string from , to;
	object ob;
	
	if( !arg || sscanf(arg, "%s in %s", from, to)!=2
	|| from!="key" || to != "kong" )
	     return notify_fail("?????\n");
	
	if( !(ob = present("this key",this_player())))
	  return notify_fail("你身上没有这个东西!\n");
	 if( !this_player()->query("mark/nomoney") ){ 
	message_vision(
	"$N用钥匙开开门!!!wow!!!!!!\n"
	"\n"
	"  恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜 \n"
	"  恭喜                                                恭喜 \n"
	"  恭喜         CONGRADULARIONS!YOU get a reward:      恭喜 \n"
	"  恭喜            1000  exp   100  pt                 恭喜 \n"
	"  恭喜                                                恭喜 \n"
	"  恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜恭喜 \n"
	,this_player() );
	    this_player()->set("mark/nomoney", 1);
	if(this_player()->query_temp("wiz_prize"))
		{
	    this_player()->add("combat_exp", random(1000));
	    this_player()->add("potential", random(100));
		}
	}
	else{
	     message_vision(
                "$N用钥匙开开门!!!wow!!!!!!\n", this_player());
	}
	destruct(ob);
	set("exits/south",__DIR__"myroom_st");
	if(ob = find_object(__DIR__"myroom_st"))
		ob->set("exits/north",__FILE__);
	return 1;
}
	
int do_look(string arg)
{
	if(arg!="i_am_nomoney")
		return 0;
	this_player()->receive_damage("gin", 30);
	return "/cmds/std/look"-> main( this_player(), arg);
}
