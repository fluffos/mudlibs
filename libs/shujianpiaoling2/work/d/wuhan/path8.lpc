
inherit ROOM;

void create()
{
        set("short", "山崖边");
        set("long", @LONG
你站在李乐山顶，七大山寨的东侧。高耸的寨墙上长满了青色的
蔓藤。蔓藤从墙顶一直垂到你的脚下。而你脚下仍是万丈悬崖。
LONG
        );
        set("exits", ([
                "west" : __DIR__"path7",
        ]));
        set("item_desc", ([
                "wall": "城墙虽陡，但长满了蔓藤。你似乎可以试着爬(climb)上去。\n",
		"蔓藤": "蔓藤长满了城墙，你似乎可以试着爬(climb)上去。\n"	
        ]) );
       set("outdoors", "wuhan");

        setup();
}

void init()
{
	add_action("climbing", "climb");
}

int climbing(string arg)
{
	object obj;
	object me;
	if(!arg || arg=="")
	{
		write("你要爬什么？\n");
		return 1;
	}
	if( arg == "wall" || arg == "蔓藤" || arg == "城墙")
	{
	me = this_player();
        message_vision("$N抓着蔓藤，慢慢的顺着城墙爬了上去。\n", me);
	me->start_busy(3);
	call_out("fliping",3,me);
	me->stop_busy();
	return 1;
	}
	else
	{
		write("你不可以爬"+arg+"\n");
		return 1;
	}
}

int fliping(object me)
{
        me->move(__DIR__"shanzhai/east_garden.lpc");
        message_vision("$N用手一撑墙头儿，轻巧的跳了过来。\n", me);
	return 1;
}
