// lou3.c

inherit ROOM;

create() {
  set("short", "黄鹤楼--四楼");
  set("long", @LONG
你又上了一层楼. 一派江山如画. 传说中这里是黄鹤楼上
看翻船的地方.
	这一层还在修.
LONG);
  set("exits", ([
    "down": __DIR__ "lou3.lpc",
  ]));
  set("objects", ([
    __DIR__ "npc/king": 1,
    __DIR__ "npc/baobiao": 1,
  ]));
  setup();
}

int valid_leave(object who, string exit) {
  if (who->query_temp("killingking"))
    return notify_fail("想当逃兵?\n");
  else return 1;
}
