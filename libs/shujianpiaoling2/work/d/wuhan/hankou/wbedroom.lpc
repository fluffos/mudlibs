// wbedroom.c

inherit ROOM;

void create()
{
    set("short", "卧房");
    set("long", @LONG
这是老太太的卧房。床是大床，老太太疼孙子，总是和孙子一起睡。左面靠墙
立着个古朴别致的矮柜，再过去是一个梳妆台。墙角放着几口装衣服的箱子。正中
间摆着张八仙桌，桌上备着些茶具。右边墙上则自顶而下挂了副极长的狂草，笔法
雄浑磅礴，却不是文少爷这样淡泊的人能写得出来的。
LONG);
    set("item_desc", ([
        "矮柜"  :   "一个五个抽屉的柜子，不知里面都放了些什么东西。\n",
        "梳妆台":   "梳妆台已经有些年头了，大概还是老太太的陪嫁吧。\n",
]) );
    set("exits", ([
        "west"    :   __DIR__"wtangwu"
]) );
    set("objects", ([
        __DIR__"npc/wlaotai"    : 1,
]) );
    set("outdoors", "hankou");
    setup();
}

void init()
{
     add_action("do_open", ({"open"}) );
}

int do_open(string arg)
{
    object ob;
    int tim;
    
    tim = localtime(time()*60)[2]/2;
    if ( arg == "矮柜" ){
       if( tim<12 && tim>3 && present("wen laotai", this_object() ) )
            return notify_fail("文老太太皱皱眉头说：你这人怎么能够随便"
                              "在别人家乱翻东西的？\n"); 
       if( query("_key_") == 1 ){
            message_vision("$N把矮柜的抽屉一个个翻遍，从最下面的抽屉里"
"发现一把锈迹斑斑的铜钥匙藏在怀里。\n", this_player() );
            delete("_key_");
            ob = new(__DIR__"obj/redkey");
            ob->move( this_player() );
            return 1;
       }
       else return notify_fail("你翻了翻矮柜发现没有什么令你感兴趣的东西。\n");
    }
    
    if( arg == "狂草" ){
       if( tim<12 && tim>3 && present("wen laotai", this_object() ) )
            return notify_fail("文老太太皱皱眉头说：你这人怎么能够随便"
                               "在别人家乱翻东西的？\n"); 
       message_vision("$N在条幅周围摸索几下，不知触动了什么机关，"
                       "只见整副狂草猛地向上卷起，后面露出一个暗室。\n",
                        this_player() );
       set("exits/east", __DIR__"wsecret");
       call_out("close_passage",1);
       return 1;  
    }
    return 0;
}

void close_passage()
{
    remove_call_out("close_passage");
    tell_room("条幅又弹了回来重新遮住了暗室.\n");   
           delete("exits/east");
   return; 
}       

void reset()
{   
    ::reset();
    set("_key_", 1);
}
