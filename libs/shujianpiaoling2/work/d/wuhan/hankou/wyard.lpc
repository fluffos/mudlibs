// wyard.c
#include <room.h>
inherit ROOM;

create()

{
    set("short", "天井");
    set("long", @LONG
这是文家的天井。靠墙一棵四人合抱的老槐伟岸挺拔，看来已不下三四百岁。地上
铺就黄土，平整如镜，还错落有致的种着些花草。往前走是文家堂屋，左右是文家两兄
弟的住房。自从文学文失踪后，左手的屋子一直没在用过，门上一把大铜锁好象还在执
着地盼着主人的归来。
LONG );
    set("exits", ([
//        "north"   :   __DIR__"wwenroom",
        "south"   :   __DIR__"wwuroom",
        "east"    :   __DIR__"wtangwu",
        "west"    :   __DIR__"proad3",
]) );
    set("objects", ([
       __DIR__"npc/wyingzhi"    : 1,
]) );
    setup();
}

void init()
{
    add_action("do_open", ({"open"}) );
}
 
int do_open(string arg)
{
    object ob;
    if(!arg) return notify_fail("你要打开什么?\n");
    if(arg != "door")return 0;
    if( present("red key", this_player()) ){
	message_vision("$N用钥匙把门打开\n", this_player());
        set("exits/north", __DIR__"wwenroom");
        return 1;
    }
    else     return notify_fail("门是锁着的!\n");
}

int valid_leave(object ob,string exit)
{
    if( query("exits/north") ){
       message_vision("$N把门带上.\n ", this_player());
       delete("exits/north");
    }
    return 1;
}
