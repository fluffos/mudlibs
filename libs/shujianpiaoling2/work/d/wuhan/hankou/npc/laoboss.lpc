// boaer.c

inherit NEW_VENDOR;

void create()
{
	set_name("老武", ({"wu"}) );
	set("long", "老武是个脾气暴躁的老头子, 但是豆皮确实做得好\n");
	set("title", "老通城");
        set("age", 47);
        set("max_kee", 800);
        set("max_force", 1000);
        set("force_factor", 1);
	set("water", 600);
	set("food", 600);
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("force", 100);
        set_temp("apply/attack", 80);
        set_temp("apply/defense", 80);
        set("combat_exp", 200000);

	set("merchandise", ([
	    __DIR__"obj/xdoupi" : 20,
	 __DIR__"obj/doupi"   : 20 ,
]) );
	setup();
}


void init()
{
	::init();
	add_action("do_vendor_list", "list" );
        add_action("do_buy", "buy");
}
