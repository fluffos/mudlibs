// killer.c

inherit NPC;

string *lastname = ({ "陈", "李", "王", "张", "卫", "林" });
string *name1 = ({ "擒", "博", "放", "腾", "封" });
string *name2 = ({ "龙", "鹤", "飒", "维", "答", "克" });

void create() {
  string name;
  name = lastname[random(sizeof(lastname))] + name1[random(sizeof(name1))] + name2[random(sizeof(name2))];
  set_name(name, ({ "man" }));
  set("gender", "男性");
  set("str", 45);
  set("cor", 30);
  set("cps", 27);
  set("int", 10);

  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 2);
  set("water", 400);
  set("food", 400);

  set("combat_exp", 10000);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("parry", 80);
  set_temp("apply/attack", 20);

  setup();
  carry_object(__DIR__ "obj/sskillercloth");
  carry_object(__DIR__ "obj/sskillersword");
}

void init() {
  object ob, ob1, killer;

  ::init();

  if (interactive(ob = this_player())
    && ob->query("id") == query("victime")) {
    killer = this_object();
    if (!(ob1 = present("yellow suit", killer))) {
      ob1 = new(__DIR__ "obj/sskillercloth");
      ob1->move(killer);
    }
    ob1->wear();
    if (!(ob1 = present("killersword", killer))) {
      ob1 = new(__DIR__ "obj/sskillersword");
      ob1->move(killer);
    }
    ob1->wield();
    killer->set_leader(ob);
    message_vision("$N决定开始跟随$n一起行动。\n", killer, ob);
    kill_ob(ob);
  }
}
