
inherit NPC;

void create()
{
        set_name("花蝴蝶", ({ "butterfly" }) );
        set("race", "野兽");
        set("attitude", "peaceful");
        set("age", 1);
        set("str", 5);
        set("long", "一只美丽的小蝴蝶\n");

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

	set("combat_exp", 1000);
        set_skill("dodge", 50);
	set_skill("unarmed", 5);
        setup();
}

