// wxuewu.c

inherit NPC;

void create()
{
   	set_name("文学武", ({"wen xuewu","wen"}) );
     	set("long", @LONG
文学武据说是武汉第一才子, 却也耐得住寂寞, 极少出外走动.
他虽然学富五车, 却不屑于功名, 心里常常自责此乃对先父大
大的不孝.
LONG);
	set("age", 37);
	set("chat_chance", 5);
        set("chat_msg", ({
                "文学武喃喃道：问世间情为何物...唉!\n"}));
	set("per", 25);
        set("combat_exp", 500);
       	set_skill("dodge", 20);
 	set_skill("unarmed", 20);
	set_temp("apply/attack", 10);
	set_temp("apply/defense", 10);
 	setup();
}

