// woman.c

inherit NPC;

void create()
{
    set_name("妇人",   ({"woman"}));
    set("gender", "女性");
    set("attitude", "friendly");
    set("per", 19);
    set("combat_exp", 300);
    set_skill("unarmed", 20);
    set_skill("dodge", 20);
    set("inquiry", ([
	"封庄主" : "封庄主可是个雄狮般威风的人物, 一向是乐善好施, 仁义潇洒, \n"
	           "这一次却不知得罪了什么人, 弄得生死不明\n",
]));
    set("chat_chance", 5);
    set("chat_msg", ({
	"妇人一副神情恍惚的样子, 没想到那一庄子人都给人杀得一干二净了!\n",
	"妇人自言自语那道: 封庄主倒是个好人, 听说庄里没有他的尸体, 他是不是还活着.\n",
	"妇人喃喃道: 真是造孽哟, 也不知是什么怨仇\n",
	    }));
    
    setup();
    carry_object("/obj/cloth")->wear();
}
