// guqian.C

inherit NPC;
string guqian();
void create()
{
        set_name("金先生", ({"jin xiansheng", "jin"}) );
        set("long", @LONG
金先生住在黄家已有近一个多月了。从黄老先生对他的态度来看，他们之间的
交情非同一般。金先生白天很少在外走动，晚上则门窗紧闭，细心的丫环留意过，
一到晚上南厢房总是出其的安静，也不知金先生在里面做什么。
    他一张堂堂正正的国字脸，天庭饱满，浓眉豹眼。他身上的肌肉决不会该多的
地方少一点也决不会在该少的地方多一点，浑身上下好象充满了无穷的精力。他只
穿了一件好象很普通的麻布长衫，但是他那么高高大大地往里一站，你便觉得盛气
逼人，让人不可仰视。你想了一想，就觉得  威风凛凛  说的就是他。
LONG);
        set("age",  56);
        
        set("str", 31);
        set("cor", 30);
        set("combat_exp", 1000000);
        set("max_force", 3000);
        set("force", 5000);
        set("force_factor", 10);
        
        set_skill("dodge", 100);
        set_skill("blade", 150);
	set_skill("spring-blade",150); 
        set_skill("unarmed", 100);
        set_skill("parry", 150);
        set_skill("force", 100);
	map_skill("blade", "spring-blade");
	map_skill("parry", "spring-blade");

        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/dammage", 60);
        
        set("inquiry", ([
        "name"  :  "金狂！\n",
        "古谦"  :  (:guqian:),
]) );
        setup();
        carry_object(__DIR__"obj/mabuc.lpc")->wear();
 }

string guqian()
{
	this_player()->set_temp("guqian", 1);
	return "古谦是谁？\n\n"
                 "金先生把你上上下下打量了一番, 想了一会儿, 然后叹了一口气,\n"
                 "说道: 既然你看出来了我也不再隐瞒, 我便是被那臭皇帝满门抄斩\n"
                 "的古谦. 我看你不象是奸细, 便信了你也无妨. 我正在找当年手下\n"
                 "的一元大将, 叫做雷廷, 他一定是隐居在武汉附近, 只是我找了一\n"
                 "个多月却毫无结果. 你若是能帮我找到他, 合我二人之力, 或许能\n"
                 "将这昏君杀了. 那时....哼哼....\n";
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player() ) ){
           remove_call_out("regard");
           call_out("regard",1,ob);
        }
}

void regard(object ob)
{
        if( !ob || environment(ob)!= environment() ) return;
        tell_object(ob, "金先生冷冷地打量了一下你, 你只觉得浑身一激泠.\n");
        message( "vision","金先生冷冷地打量了一下" + ob->query("name") +"\n",
                environment(ob), ob);
        return;
}

int accept_object(object who, object ob)
{
	if( ob->query("name") != "旧盔甲")return 0;
	command("say 哎呀！这正是以前雷将军的军甲！谢谢你找到他！");
	if( who->query_temp("guqian") ){
		command("say 来！我把给你个信物，你去将他带来。");
		__DIR__"obj/binfu"->move(who);
	}
	return 1;
}
