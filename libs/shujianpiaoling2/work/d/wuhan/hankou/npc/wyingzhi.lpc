// wyingzhi.c

inherit NPC;

void create() {
  set_name("文英志", ({ "wen yingzhi", "wen" }));
  set("title", "文家小公子");
  set("long", "一个很机灵的小孩, 正有事没事地吃着一包糖");
  set("chat_chance", 3);
  set("chat_msg", ({
    "文英志自言自语道: 奶奶最近总是瞌睡多.\n" }));
  set("age", 9);
  set("combat_exp", 100);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  setup();
  carry_object(__DIR__ "obj/baotang");
}
