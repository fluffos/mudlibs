// killer.c

inherit NPC;

string* lastname = ({ "陈","李","王","张","卫","林"});
string* name1 = ({"擒", "博","放","腾","封"});
string* name2 = ({"龙", "鹤","飒","维","答","克"});

void create()
{
        string name ;
        name = lastname[random(sizeof(lastname))] +    
               name1[random(sizeof(name1))] + name2[random(sizeof(name2))];
	set_name(name, ({ "man"}));
	set("gender", "男性" );
        set("str", 45);
        set("cor", 30);
        set("cps", 27);
        set("int", 10);

	set("max_force", 3000);
        set("force", 3000);
        set("force_factor", 20);
        set("water", 400);
        set("food", 400);

        set("combat_exp", 50000);
        set_skill("force", 100);        
        set_skill("unarmed", 60);
        set_skill("sword", 150);
        set_skill("dodge", 150);
        set_skill("parry", 150);
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/dammage", 50);
        setup();
	carry_object(__DIR__"obj/sskillercloth");
	carry_object(__DIR__"obj/sskillersword");
}

void init(){
        object ob, ob1,killer;

        ::init();
        killer = this_object();
        if( interactive(ob = this_player())
        && ob->query("id") == query("victime")){
        
        if( !killer->query("foundvictime") ){
                killer->set_leader(ob);
                remove_call_out("killvictime");
                call_out("killvictime", 1, ob);
        }
        else killer->set_leader(ob);
        }
}

void killvictime(object ob)
{
	object  ob1,killer;
	killer=this_object();
	if( environment()!=environment(ob) ) return;
 
		if( !( ob1=present("yellow suit",killer ) ) ){
			ob1 = new(__DIR__"obj/sskillercloth");
			ob1->move(killer);
		}
		  ob1->wear();
		if( !( ob1=present("killersword", killer) ) ){
                        ob1 = new(__DIR__"obj/sskillersword");
                        ob1->move(killer);
		}
		  ob1->wield();
		message_vision(
		"$N阴阴地笑道：有人花金子买你命了，看你往哪里跑\n",	
		killer);
		killer->set_leader(ob);
      	  message_vision("$N决定开始跟随$n一起行动。\n", killer,ob); 
		kill_ob(ob);
		ob->fight_ob(killer);
		killer->set("foundvictime", 1);
}
