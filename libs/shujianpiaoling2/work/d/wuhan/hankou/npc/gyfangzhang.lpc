inherit NPC;
void create()
{
	set_name("清风", ({"feng"}));
	set("title", "方丈");
	set("long", "这个和尚老而快朽了\n");

	set("age", 72);
	set("inquiry", ([
	"弘灵禅师" : "据说弘灵禅师活了七十二岁，然后有一天就再也没有"
	"人见过他了\n",
	"归元寺"  : "你别听穷瞎说，其实归元寺地处汉阳，并不在汉口。\n"
	"归元寺本是个小寺，大慨千年以前有个弘灵禅师来到本寺修行，从此本寺\n"
	"武功佛法都得以大成\n",
	]));

	setup();
}
