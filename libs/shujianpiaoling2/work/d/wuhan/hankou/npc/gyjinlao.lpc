inherit NPC;

int sss();

void create()
{
	set_name("清涟", ({"lian"}) );
	set("title", "藏经阁长老");
	set("long", "老和尚对你的出现很不高兴\n");
	set("inquiry", ([
		"「毒经」" : (:sss:)
	]) );
	set("age", 71);	
	set("combat_exp", 1000000);
	setup();
}

int sss()
{
	command("say 就为这个打破我的清修？好！给你！");
	__DIR__"obj/dujin2"->move(this_player());
	message_vision("说罢，清涟翩然而去\n", this_player());
	destruct(this_object());
	return 1;
}
