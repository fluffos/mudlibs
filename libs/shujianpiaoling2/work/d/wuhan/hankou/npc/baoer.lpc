// boaer.c

inherit NEW_VENDOR;

void create()
{
	set_name("汤包刘", ({"liu"}) );
	set("long", "肥头大耳笑呵呵的老刘.\n");
	set("title", "四季美");
        set("age", 47);
        set("max_kee", 800);
        set("max_force", 1000);
        set("force_factor", 1);
	set("water", 600);
	set("food", 600);
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("force", 100);
        set_temp("apply/attack", 80);
        set_temp("apply/defense", 80);
        set("combat_exp", 200000);

	set("merchandise", ([
  	 __DIR__"obj/xiabao"  :20, 
	__DIR__"obj/xiebao" :20 ,
 	__DIR__"obj/jibao"   :20 , 
]) );
	setup();
}


void init()
{
	::init();
	add_action("do_vendor_list", "list" );
        add_action("do_buy", "buy");
}
