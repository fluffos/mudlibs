// dyayi.C

inherit NPC;
void create() {
  set_name("衙役", ({ "yayi" }));
  set("title", "武汉府");
  set("long", "一个满脸横肉的衙役\n");
  set("age", 19);

  set("str", 20);
  set("cor", 30);
  set("combat_exp", 8000);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 2);

  set_skill("dodge", 30);
  set_skill("unarmed", 30);
  set_skill("staff", 30);

  set_temp("apply/attack", 10);

  setup();
  carry_object(__DIR__ "obj/ycloth")->wear();
  carry_object(__DIR__ "obj/tanggun")->wield();
}
