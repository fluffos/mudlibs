// yanwei.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("柳叶飞刀", ({ "feidao" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","长七寸，宽两寸，起薄如纸\n");
		set("unit", "些");
		set("base_unit", "把");
		set("base_weight", 10);
		set("base_value", 100);
	}
	set_amount(100);
	init_throwing(80);
	setup();
}
