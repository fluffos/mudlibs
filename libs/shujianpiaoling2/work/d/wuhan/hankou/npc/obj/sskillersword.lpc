// blade.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("杀人剑", ({ "killersword" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 2000);
		set("material", "iron");
		set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
	}
	init_sword(35);
	setup();
}
