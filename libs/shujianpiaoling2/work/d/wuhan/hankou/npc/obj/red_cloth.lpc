// pink_cloth.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("大红绸衫", ({ "red cloth", "cloth" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","鲜红的绸衫上绣着些展翅欲飞的蝴蝶.\n");
		set("unit", "件");
		set("value", 600);
		set("material", "cloth");
		set("armor_prop/armor", 1);
		set("armor_prop/personality", 1);
		set("female_only", 1);
	}
	setup();
}

