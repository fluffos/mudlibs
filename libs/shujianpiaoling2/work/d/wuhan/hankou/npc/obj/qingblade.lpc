// houndbane.c

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
	set_name( GRN"临渊"  NOR, ({ "qingblade" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把青光闪闪的宝刀\n");
		set("value", 42000);
		set("material", "crimsonsteel");
		set("wield_msg", "$N「飕」地一声抽出一把青光闪闪的$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
	}

	init_blade(76);
	set("weapon_prop/courage", 5);
	set("weapon_prop/composure", 5);
	setup();
}
