// baotang.c
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("虾肉汤包", ({"xiabao"}) );
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一笼香喷喷的虾肉汤包\n");
                set("value", 100);
		set("unit", "笼");
                set("food_remaining", 7);
                set("food_supply", 40);
	}
	setup();
}

