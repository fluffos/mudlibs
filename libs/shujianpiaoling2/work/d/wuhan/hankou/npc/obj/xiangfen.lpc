// yanzhi.c

inherit ITEM;

void create()
{
	set_name("香粉", ({"xiangfen"}));
	set("long", "一盒很精致的香粉, 涂(tu)在脸上会让人美一些\n");
	if( clonep() )
		set_default_object(__FILE__);
	else{
		set("value", 1000);
		set("weight", 10);
                set("unit", "盒");
	}
	setup();
}

void init()
{
	add_action("do_tu", ({"tu"}) );
}

int do_tu(string arg)
{
	if(!id(arg))
		return notify_fail("你涂什么?\n");
	if(this_player()->query("gender") != "女性"){
		CHANNEL_D->do_channel(this_player(), "rumor", "大家来看"
		 + this_player()->query("name") + "搽香粉啊! 羞羞羞!!!");
		return notify_fail("你个大男人, 羞也不羞?\n");
	}
	message_vision("$N含羞带笑地把香粉搽在脸上\n", this_player());
	this_player()->add_temp("mark/香粉", 1);
	if(this_player()->query_temp("mark/香粉") == 1){
		this_player()->add_temp("apply/personality", 1);
		call_out("huifu",1000,this_player());
	}
	else {
		this_player()->add_temp("apply/personality", -1);
		tell_object(this_player(),"你变丑了\n");
		call_out("jia",1000, this_player() );
	}
	return 1;
}

int huifu(object me)
{
	me->add_temp("mark/香粉", -1);
	me->add_temp("apply/personality", -1);
	tell_object(me, "香粉的作用失效了\n");
	return 1;
}

int jia( object me )
{
	me->add_temp("mark/香粉", -1);
	tell_object(me,"香粉的作用失效了\n");
        me->add_temp("apply/personality", 1);
	return 1;
} 
