// mubuc.c


#include <armor.h>

inherit CLOTH;

void create() {
  set_name("黄布长袍", ({ "huang cloth", "cloth" }));
  set_weight(3000);
  set("value", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
