// tang.c
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("糖", ({"tang"}) );
        set_weight(350);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("value", 10);
                set("food_remaining", 1);
                set("food_supply", 10);
	}
	setup();
}

