// pink_cloth.c

#include <armor.h>

inherit HEAD;

void create()
{
	set_name("白玫瑰", ({"white-rose", "rose"}));
	set_weight(10);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一朵美丽的白玫瑰\n");
		set("unit", "朵");
		set("value", 100);
		set("armor_prop/personality", 1);
		set("female_only", 1);
	}
	set("wear_msg", "$N细心地把白玫瑰别在鬓角\n");
	set("unequip_msg", "$N从发间取下白玫瑰\n");
	setup();
}
