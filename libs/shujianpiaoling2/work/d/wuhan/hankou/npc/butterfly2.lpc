
inherit NPC;

void create()
{
        set_name("黑蝴蝶", ({ "butterfly" }) );
        set("race", "野兽");
        set("age", 2);
        set("str", 10);
        set("long", "一只美丽的小蝴蝶\n");

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set_skill("dodge", 50);
	set_skill("unarmed", 20);
        set("combat_exp", 2000);

        setup();
}

