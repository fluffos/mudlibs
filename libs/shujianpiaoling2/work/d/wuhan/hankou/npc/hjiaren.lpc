// hjiaren.c

inherit NPC;


void do_permit();
void create()
{
        set_name("黄安", ({"huang an", "huang"}) );
        set("title", "老家人");
        set("gender", "男性");
        set("long", "黄安在黄家已有六十年了，比黄老先生还老。");
        set("age", 75);
	set("attitude", "friendly");
        set("combat_exp", 20000);
        
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set("inquiry", ([
           "黄老先生"   : (:do_permit:)
]) );
        setup();
        carry_object(__DIR__"obj/hcloth")->wear();
}

int do_permit()
{
        if( this_player()->query_temp("wes_tigger") ){
           write("黄安笑眯眯地说: " + RANK_D->query_respect(this_player()) +
               "自己进去吧！我家老先生今天没出门\n");
           return 1;
        }
        write("黄安笑眯眯地说: " + RANK_D->query_respect(this_player()) +
               "大概是慕名来见我家老先生的吧！您进去可不要乱闯啊！\n");
        this_player()->set_temp("wes_tigger", 1);
        return 1;
}
