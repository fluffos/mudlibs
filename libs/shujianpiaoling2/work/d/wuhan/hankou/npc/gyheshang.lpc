inherit NPC;
void movemove();
void hithole();
void create()
{
	set_name("道静", ({"jing"}));
	set("title", "罗汉堂大弟子");
	set("long", "这个和尚精精确壮壮，一点儿也不静\n");

	set("age", 25);
	set("str", 200);
	set("combat_exp", 200000);	
	set("max_force", 3000);
	set("force", 3000);
	set("force_factor", 50);
	set("food", 3000);
	set("water", 3000);
	set_skill("unarmed", 200);
	set_skill("dodge", 200);
	set_skill("parry", 200);
	
	set("chat_chance", 5);
	set("chat_msg", ({
	  	"道静道：这些天手痒痒，就想找人打架\n",
		(:movemove:),
	}) );
	set("chat_chance_combat", 30);
	set("chat_msg_combat", ({ (:hithole:) }));
	set_temp("apply/dammage", 200);
	set_temp("apply/defense", 10);
	set_temp("apply/attack", 10);
	set_temp("apply/armor", 100);

	setup();
}

void movemove()
{
	string move;
	move = environment()->query("movedirection");
	command(move);
}

void hithole()
{
	int before, after;
	object en, *enemy;
	start_busy(1);

	command("say 来!看我厉害的!");
	add_temp("apply/attack", 50);
	add_temp("apply/strength", 100);

	enemy = this_object()->query_enemy();
	if( !enemy || !arrayp(enemy) || sizeof(enemy) <= 0 )return;
	en = enemy[0];
	before = en->query("kee");
	COMBAT_D->do_attack(this_object(), en);
	after = en->query("kee");
	if( after < before )return;
	else if( random(2) == 0 ){
	if( environment()->query("short") == "藏经阁"){
		tell_object(environment(),
		"道静这一掌击空，掌风落处，却将地板打了个大洞....\n");
		environment()->set("exits/down", "/u/wuhan/hankou/gyjin");
	}
	else 
		tell_object(environment(),
                "道静这一掌击空，掌风落处，却将地板打了个大坑\n");
	}
	add_temp("apply/attack", -50);           
        add_temp("apply/strength", -100);

	return ;
}

int return_home(object home)
{
	// Are we at home already?
        if( !environment()
        ||      environment()==home )
                return 1;

	// Leave for home now.
        message("vision", this_object()->name() + "急急忙忙地离开了。\n",
                environment(), this_object());
        return move(home);
}

