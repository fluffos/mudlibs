// ypuren.C

inherit NPC;
void create()
{
        set_name("老仆", ({"puren"}) );
        set("title", "武汉府");
        set("long", "他满脸的苍桑和忠诚.\n"); 
        set("age",  55);
        
        set("str", 25);
        set("cor", 30);
        set("combat_exp", 2000);
        set("max_force", 1000);
        set("force", 1000);
        
        set("dodge", 30);
        set("blade", 30);
        set("unarmed", 30);
        set("force", 100);
        set_temp("apply/attack", 10);

        setup();
        carry_object(__DIR__"obj/ycloth.lpc")->wear();
 }

