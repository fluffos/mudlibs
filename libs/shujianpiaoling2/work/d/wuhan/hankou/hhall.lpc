// hhall.c

inherit ROOM;

create() {
  set("short", "黄家大厅");
  set("long", @LONG
这里是黄家会客的大厅，地上铺着白玉石板，墙壁也刷得雪白。正面挂了
一副松鹤图，手法佳妙，听说是黄老先生朝中一位带兵的朋友画的。靠墙
放了一排太师椅和茶几，摆设不是很多却样样都很精致。黄老先生就坐在
一张楠木靠椅上悠闲地饮茶。
LONG);
  set("exits", ([
    "west": __DIR__ "hbyard",
    "east": __DIR__ "hfyard"
  ]));
  set("objects", ([
    __DIR__ "npc/huanglx.lpc": 1,
  ]));
  set("outdoors", "hankou");
  setup();
}
