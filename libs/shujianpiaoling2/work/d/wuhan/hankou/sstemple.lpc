// Room: /u/wuhan/hankou/sstemple.c

inherit ROOM;
void create()
{
	set("short", "破祠堂");
	set("long", @LONG
一个破祠堂，没啥特别的。到处都是蛛网，一边有个神龛，旁边有
个小石头。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"ssstreet2",
]));
	set("item_desc", ([
	"神龛" : "里面是空的，可以把什么东西投(throw)进去\n",
	]) );
	setup();
}

void init()
{
	object ob;

	if( ( ob = this_player() ) )
		tell_room(__DIR__"ssgarden", ob->name()+"走进破祠堂");
	add_action("do_throw", "throw");
}

int do_throw(string arg)
{
	object killer,ob,me;
	string name;
	
	if( arg != "pozhipian" )return notify_fail("这东西投不进去");
	if( !( ob = present("pozhipian", this_player() ) ) )
		return notify_fail("你身上没有这个东西\n");
	message_vision("$N将纸片投入神龛中\n", this_player());
	message_vision("过了一会儿，一个人走进来，对$N说道：好我跟你走\n",
	this_player());
	killer = new(__DIR__"npc/sskiller"+ob->query("level"));
	killer->set("victime", ob->query("victime"));
	killer->move(this_object());

	killer->set_leader(this_player());
	me = this_player();
	message_vision(killer->name() +"决定开始跟随$N一起行动。\n",  me);
	destruct(ob);
		return 1;
}
	
	
