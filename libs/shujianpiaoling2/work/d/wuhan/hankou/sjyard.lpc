// Room: /u/wuhan/hankou/sjyard.c

inherit ROOM;

void create() {
  set("short", "院子");
  set("long", @LONG
这里是试剑山庄的前院。苗圃，林木，道路本来都是工匠们好生伺
弄过的，本来这里应该是一处宁静的所在，现在却到处躺着是尸体，大
块大块干涸的血迹在绿茵中分外醒目，阴森。
    门口边的一具尸体穿的好象不是庄内人物的衣服，胸前腹部有好几
处致命的伤口，似乎临死还拼命纠缠着敌人。他手里兀自还紧握着把钢
刀，双目圆睁，嘴唇间却隐隐有些笑意，仿佛因为终于完成一项任务感
到死得其所。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "sjentrance",
  ]));
  set("objects", ([
    __DIR__ "obj/ducorpse": 1,
  ]));
  setup();
  replace_program(ROOM);
}

void reset() {
  object ob;
  ::reset();
  if (ob = present("ducorpse", this_object())) {
    destruct(ob);
    __DIR__ "obj/ducorpse"->move(this_object());
  }
}
