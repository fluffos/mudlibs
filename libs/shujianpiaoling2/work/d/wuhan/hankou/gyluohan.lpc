// Room: /u/wuhan/hankou/gyluohan.c

inherit ROOM;

void create()
{
	set("short", "罗汉堂");
	set("long", @LONG
这里就是有名的五百罗汉堂。五百罗汉每一位都塑得栩栩如生。大
堂里香烟缭绕，木鱼声声，好一派佛教佳境。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"gywc1",
  "north" : __DIR__"gync2",
  "south" : __DIR__"gysc2",
  "east" : __DIR__"gyzhanglao",
]));

	setup();
}

void init()
{
	add_action("do_push", "push");
}

int do_push(string arg)
{
	if( arg == "罗汉")return notify_fail("你推什么?\n");
	if( arg != "伏虎罗汉")return 0;
	message("vision", this_player()->name() +
		"认准一个罗汉，用力一推，居然发现了一个暗室，随之隐身进去\n",
		this_object(), this_player());
	tell_object(this_player(), "你认准伏虎罗汉，用力一推，居然发现了一个暗室，随之隐身进去\n");
	tell_room(__DIR__"gysecret", "有人发现了这里，钻了进来\n");
	this_player()->move(__DIR__"gysecret");
	return 1;
}
