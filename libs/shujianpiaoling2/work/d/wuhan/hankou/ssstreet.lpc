// Room: /u/wuhan/hankou/ssstreet.c

inherit ROOM;

void create()
{
	set("short", "小巷");
	set("long", @LONG
这是一条幽静的小胡同。北边却住着好气派的一户人家。两扇大门
紧闭着，门上各又一个粗大的黄铜门环。高大的红砖院墙里不知有些什
么秘密。
LONG
	);
	set("item_desc" , ([
	"院墙" : "墙不是太高，不过爬进去是很危险的\n",
	"wall" : "墙不是太高，不过爬进去是很危险的\n",
	]) );
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"proad5",
  "east" : __DIR__"ssstreet2",
]));
	set("outdoors", "hankou");
	setup();
}

void init()
{
	add_action("do_knock", "knock");
	add_action("do_climb", "climb");
}

void reset()
{
	object ob;
	::reset();
	if( ob=present("sswang", this_object()) )
		destruct(ob);
	if( query("exits/north") )delete("exits/north");
}

int do_knock(string arg)
{
	object ob;
	if( arg != "door" && arg != "大门" )return 0;
	
	if( query("exits/north") )return notify_fail("门都开了，还敲\n");
	
	set("exits/north", __DIR__"ssyard");
	if( !(ob=present("sswuang", this_object())) ){
		ob=new(__DIR__"npc/sswang");
		ob->move(this_object());
	}
	message_vision("$N将门上的铜环轻扣两下，过了一会儿，门从里面打开\n"
			"一个人走了出来\n", this_player());
	tell_room(__FILE__, "王老二问道： 你有什么事？\n");
	return 1;
}

int do_climb(string arg)
{
	if( arg != "wall" && arg != "院墙" )return 0;
	message_vision("$N试了试院墙的高度，纵身跃了过去\n", this_player());
	this_player()->move(__DIR__"ssyard");
	message_vision("$N纵身跃了进来\n", this_player());

	return 1;
}

int valid_leave(object who, string exit)
{
	if( exit != "north" )return 1;
	if( !present("sswang", this_object()) ) return 1;
	if( who->query("wuhankiller") )return 1;
	return notify_fail("王老二笑道：我可警告您不要乱闯，要闹出人命的\n");
}

