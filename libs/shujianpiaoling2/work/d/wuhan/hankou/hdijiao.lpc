// hdijiao.c
#include <room.h>
inherit ROOM;

create()
{
    set("short", "地窖");
    set("long", @LONG
这里好象是一个未完工的地窖. 地上倒是铺了石板, 四周墙壁却还保持着
挖掘的痕迹. 南边用一块木板封着.
LONG);
    set("exits", ([
        "south" : __DIR__"andao.lpc"
]) );
    set("no_clean_up", 0);
    create_door("south","木板", "north", DOOR_CLOSED);
    setup();
}


