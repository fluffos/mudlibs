// hngr.c

inherit ROOM;

create()
{
    set("short", "北厢房");
    set("long", @LONG
厢房还很干净, 但看得出好久没住人了. 床上只铺了床褥子, 被子却是没有.
屋里摆设很是简单, 西面靠墙放着一个五斗柜, 桌椅都擦得干干净净, 青石板的地
面一尘不染, 显然经常有人来打扫.
LONG );
    set("item_desc", ([
    "五斗柜"  : "很普通的柜子, 好象很久没用过的.\n",
    "石板"    : "方方正正的青石板, 接缝处很严实, 看得出是上等石匠的手艺.\n"
]) );
    set("exits", ([
        "south" : __DIR__"hfyard",
]) );
    set("outdoors", "hankou");
    setup();
}

void init()
{
    add_action("do_open",  ({"open"}) );
    add_action("do_close",  ({"close"}) );
}


int do_open(string arg)
{
    object room;
    if(!arg || arg != "石板" )return notify_fail("你要打开什麽？\n");
    if( (this_player()->query("str")+this_player()->query("max_force")/10) < 45)
          return notify_fail("你试着掀开石板, 发现床下有一块有点松动. 但要掀开它你有些力不从心.\n");
    message_vision("$N发现床下有一块石板有点松动, 用力一掀, 居然揭开了一道向下的楼梯.\n", this_player());
    tell_room(__DIR__"hdijiao", "有人从上面将石板掀开\n");
    if(room = find_object(__DIR__"hdijiao")){
        set("exits/down", __DIR__"hdijiao");
        room->set("exits/up", __FILE__);
    }     
return 1;
}

int do_close(string arg)
{
    object room;
    if(!query("exits/down"))return 0;
    if(arg != "石板" )return 0;
    message_vision("$N重新把石板掩好\n", this_player());
    if(room = find_object(__DIR__"hdijiao")){
        delete("exits/down");
        room->delete("exits/up");
        tell_room(__DIR__"hdijiao", "有人从上面把石板盖上了.\n");
    }
    return 1;
}

int valid_leave(object me, string exit)
{
     if(exit == "south"){
         if( query("exits/down") ){
	      tell_object(me, "嘿嘿, 把人家家里弄的乱七八糟的就拍屁股走了?!以后记住要擦屁股的哇.\n");
	      delete("exits/down");
	      __DIR__"hdijiao"->delete("exits/up");
         }
     }
     
     return 1;
}




