// token1.c


inherit ITEM;

void create()
{
	set_name("药水",({ "potion" }) );
	set("long",
		"这是一小瓶药水，可以用(use)在(on)什么东西上面\n");
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else 
		set("unit", "瓶");
	setup();
}

void init()
{
	add_action("do_use", "use");
}

int do_use(string arg)
{
	object ob;

	if( sscanf(arg, "potion on %s", arg) != 1 )return 0;
	if( !(ob = present(arg, this_player())) )return 0;
	if( ob->query("name") != "密信" )
	return notify_fail("你不能把它用在这上面\n");
	message_vision("$N小心地将药水涂在信封上\n", this_player());
	tell_object(this_player(),
	"一行字显现出来：\n"
	"\n"
	" 	隍哥：\n"
	"	见佩如见人，你替我杀了皇上！\n"
	"\n"
	"	来人若不问：我也来帮你，杀无赦。\n\n");
	return 1;
}
	


