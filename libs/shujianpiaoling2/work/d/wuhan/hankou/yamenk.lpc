inherit ROOM;

void create()
{
	set("short", "牢房");
	set("long", @LONG
这里通向关押犯人的大牢. 由一个牢头守着.
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"yamenll",
  "south" : __DIR__"yamen",
]));
        set("objects", ([
	    __DIR__"npc/laotou": 1,
]));
	setup();
}


int valid_leave(object who, string arg)
{
       if(arg == "north" && present("laotou" , this_object()))
         return notify_fail("牢头挡住你: 官府重地, 休得乱闯!\n");
       return ::valid_leave(who, arg);
}
