// hbyard.c

inherit ROOM;

create()
{
    set("short", "后院");
    set("long", @LONG
你走进一个很别致的花园, 一条条细卵石铺成的小路将院子分割
成大大小小形状各异的花圃, 正中间有一座凉亭, 攀满了牵牛花. 这
里种的都是一些很普通的花草, 却生机勃勃的惹人的眼, 北边一块圆
形的花圃密密地开着五颜六色的太阳花, 更是绚烂夺目, 讨人喜爱.
    几个黄府的丫头在园中追逐嬉戏着, 无数美丽的蝴蝶在花间起舞
. 空气里洋溢着少女灿烂迷人的笑容, 醉人心脾的花香, 真好一派春
光.
LONG );
    set("exits", ([
        "east"    : __DIR__"hhall",
        "south"   : __DIR__"hlbr",
        "north"   : __DIR__"hxbr"
]) );
    set("objects", ([
        __DIR__"npc/hyatou" : 2,
        __DIR__"npc/butterfly1" : 1,
        __DIR__"npc/butterfly2" : 1,
        __DIR__"npc/butterfly3" : 1,
]) );
    setup();
}

