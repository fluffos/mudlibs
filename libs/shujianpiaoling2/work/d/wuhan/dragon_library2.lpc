// Room: /u/wuhan/dragon_library2.c

inherit ROOM;

void create()
{
	set("short", "内书房");
	set("long", @LONG
这里到处都是书, 堆得象座山一样！你不禁想起你在帮里什么
地方看见过的一句话。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"dragon_changlang2",
]));
        set("objects", ([
	    __DIR__"obj/dfstatue" : 1,
	    __DIR__"obj/dstrpicture" : 1,
	    __DIR__"obj/divpicture" : 1,
]) );
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_enter", ({"enter"}));
}

int do_enter(string arg)
{
	if( arg != "书山" )return notify_fail("你往哪里钻？\n");
	tell_object(this_player(), "你在书堆里细心的翻弄着，居然找到一条路来！"
			"书山有路这句话果然不假！\n");
	this_player()->move(__DIR__"dragon_secret2");
	tell_room(__FILE__, this_player()->name() +
		"在书丛中来来去去，突然就不见了！\n");
	return 1;
}
