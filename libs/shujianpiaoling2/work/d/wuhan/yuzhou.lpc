// Room: /u/fuzhou/duchuan.c
#include <ansi.h>

inherit ROOM;
int do_thrownet(string arg);
int complete_fishing(object me);

void create() {
  set("short", "渔舟");
  set("long", @LONG
一叶小舟，最多也就能载五、六个人。舟内放着渔网、鱼钩等
捕鱼工具，缓缓飘荡在江面上。你可以撒网捕鱼（throw net）。
LONG
  );
  set("outdoors", "wuhan");
  set("hell", 1);
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("complete_fishing", random(10) + 1, ob);
  add_action("do_thrownet", "throw");
}

int do_thrownet(string arg) {
  object me = this_player();
  if (arg != "net")
    return notify_fail("你要撒什么？\n");
  if (me->query_temp("catch_fish") > 20)
    return notify_fail("你的渔船上已经装满鱼了。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (me->query("sen") < 22)
    return notify_fail("你心神不定，无法静下心来捕鱼。\n");
  if (!me->query_temp("catch_fish"))
    message_vision(CYN "$N用足气力，嗨地一声将渔网远远地撒了开去。\n" NOR, me);
  else
    message_vision(CYN "$N觉得这里鱼太少了，又把船往前划了一段路。\n
$N用足气力，嗨地一声将渔网远远地撒了开去。\n" NOR, me);
  me->start_busy(6);
  me->receive_damage("sen", random(20) + 1);
  if (me->query_skill("unarmed", 1) < 20) {
    me->improve_skill("unarmed", random((int)me->query("kar")) + 10);
    me->add("potential", 1);
  }
  me->add("life_exp", random(10) + 1);
  me->set_temp("fishing_now", 1);
  return 1;
}
int complete_fishing(object ob) {
  int i;
  int damage;
  object fish;
  if (!ob->query_temp("fishing_now")) {
    call_out("complete_fishing", random(20) + 1, ob);
    return 0;
  }
  if (ob->query_temp("catch_fish") < 20 && environment(ob) == this_object()) {
    tell_object(this_object(), "\n江面上波光粼粼，时不时可以看见几条鱼儿跃出水面嬉戏。\n");
    ob->add_temp("catch_fish", 1);
    if (environment(ob) == this_object())
      call_out("complete_fishing", random(20) + 1, ob);
  } else {
    ob->remove_call_out("complete_fishing");
    tell_object(this_object(), CYN "\n渔船满载着新鲜的鱼儿，缓缓向江岸边驶了回去。\n\n" NOR);
    fish = new("/obj/food/fish");
    fish->move(ob);
    ob->delete_temp("catch_fish");
    ob->delete_temp("fishing_now");
    ob->move("/d/wuhan/jiangb1");
    destruct(this_object());
  }
  return 1;
}
