#include <ansi.h>

inherit NPC;

void create()
{
        set_name("师长顺", ({ "shi changshun" ,"shi"}) );
        set("long", "这就是七大山寨的寨主：师长顺\n");
        set("attitude", "heroism");
	set("title", "七大山寨寨主");
	set("age", 48);
        set("str", 30);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", 500000);
	set("max_force",3000);
	set("force", 3000);
        set_skill("unarmed", 20);
        set_skill("sword", 60);
        set_skill("parry", 300);
        set_skill("dodge", 200);
        set_skill("move", 100);
	set_skill("force",300);
	set_skill("hammer", 300);
	set_temp("apply/dammage", 100);
	set_temp("apply/defense", 70);
	set_temp("apply/attack", 70);
	
        setup();
	carry_object("/d/wuhan/shanzhai/obj/map3");
        carry_object("/obj/cloth")->wear();
        carry_object("/d/wuhan/shanzhai/obj/greathammer")->wield();
}

void unconcious()
{
	object killer;
	if( objectp(killer = query_temp("last_damage_from")) ){
		set_temp("fainter", killer->query("id"));
	}
	::unconcious();
}

void revive()
{
	delete_temp("fainter");
	::revive();
}

void die()
{
	string id;
	if( objectp(killer = query_temp("last_damage_from")) ){	
		if(!( id = query_temp("fainter"))
		|| killer->query("id") == id )
			if( killer->query("combat_exp")
			   < query("combat_exp") )
			   killer->add("combat_exp", 70);
	}
	::die();
}
