#include <ansi.h>

inherit NPC;

void create()
{
        set_name("头目", ({ "guard" }) );
        set("long", "这是七大山寨的头目\n");
        set("attitude", "heroism");

        set("str", 27);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", 150000);
set("max_force",1000);
        set("force", 1000);
        set_skill("unarmed", 20);
        set_skill("sword", 150);
        set_skill("parry", 150);
        set_skill("dodge", 150);
        set_skill("move", 100);
	set_skill("force", 150);
	
	set_temp("apply/dammage", 50);
	set_temp("apply/defense", 50);
	set_temp("apply/attack", 50);
	
        setup();

        carry_object("/obj/cloth")->wear();
        carry_object("/obj/longsword")->wield();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && living(this_object())) {
		kill_ob(ob);
        }
}

void unconcious()
{
	object killer;
	if( objectp(killer = query_temp("last_damage_from")) ){
		set_temp("fainter", killer->query("id"));
	}
	::unconcious();
}

void revive()
{
	delete_temp("fainter");
	::revive();
}

void die()
{
	string id;
	if( objectp(killer = query_temp("last_damage_from")) ){	
		if(!( id = query_temp("fainter"))
		|| killer->query("id") == id )
			if( killer->query("combat_exp")
			   < query("combat_exp") )
			   killer->add("combat_exp", 80);
	}
	::die();
}
