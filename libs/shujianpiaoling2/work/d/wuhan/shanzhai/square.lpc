void create()
{
	set("short", "练武场");
	set("long", @LONG
这是七大山寨喽罗们练兵的地方。地上的黄土被踏得结实平整。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"kitchen",
  "south" : __DIR__"room1",
  "west" : __DIR__"hall",
  "east" : __DIR__"east_garden",
   "northwest" : __DIR__"room4",
]));
	set("outdoors", "wuhan");
	setup();
}

int valid_leave(object who, string exit)
{
        who->start_busy(2);
        return ::valid_leave(who, exit);
}

