// dragon_library.c
#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <move.h>
inherit ROOM;

varargs void do_revive(object me, int quiet);

void create() {
  set("short", "外书房");
  set("long", @LONG
这是海鲸帮首领看书的地方, 靠墙放着两排大书架, 正面挂着一幅条幅, 墙角
有一个小书橱. 正中间摆一张杉木长桌, 上面放了一个铜炉, 点了几副香, 屋子里
清香缭绕.
LONG);
  set("item-desc", ([
    "条幅": "\n        学海无涯\n\n"
  ]));
  set("objects", ([
    __DIR__ "obj/swimbook1": 1,
  ]));
  setup();
}

void init() {
  add_action("do_knock", ({ "knock" }));
  add_action("do_open", ({ "open" }));
}

int do_knock(string arg) {
  if (arg != "书橱") return notify_fail("你敲什么?\n");
  add("knock_tigger", 1);
  message_vision("$N在小书橱\"梆梆\"的敲了一下\n", this_player());
  if ((int)query("knock_tigger") == 3 && !query("exits/west")) {
    message("vision",
      "西面的书架忽然发出轧轧的声音，缓缓移开...\n", this_object());
    set("exits/west", __DIR__ "dragon_guetteroom");
    tell_room(__DIR__ "dragon_guetteroom",
      "书架忽然发出轧轧的声音，缓缓移开...\n");
    delete("knock_tigger");
    call_out("close_passage", 10);
  }
  return 1;
}

void close_passage() {
  delete("exits/west");
  message("vision",
    "西面的书架忽然发出轧轧的声音，缓缓移回原位.\n", this_object());
  tell_room(__DIR__ "dragon_guetteroom",
    "书架忽然发出轧轧的声音，缓缓移回原位.\n");
}

int do_open(string arg) {
  object ob;

  if (arg != "door") return notify_fail("你打开什么?\n");
  if (query("exits/north")) return notify_fail("门是开的!!\n");
  message_vision("$N打开向北的门.\n", this_player());
  set("exits/north", __DIR__ "dragon_neitang");
  if (ob = find_object(__DIR__ "dragon_neitang")) {
    ob->set("exits/south", __DIR__ "dragon_library");
    tell_room(__DIR__ "dragon_neitang", "有人从南边把门打开\n");
  }
  call_out("close_passage_north", 5);
  return 1;
}

void close_passage_north() {
  object ob;

  tell_room(__FILE__, "门轻轻地关上.\n");
  delete("exits/north");
  if (ob = find_object(__DIR__ "dragon_neitang")) {
    ob->delete("exits/south");
    tell_room(__DIR__ "dragon_neitang", "门轻轻地关上.\n");
  }
}

int valid_leave(object me, string exit) {
  object *list, ob;
  int i;

  if (exit == "north" || exit == "n") {
    if (!present("diving book", me))
      return 1;
    if (!query("free")) {
      tell_room(__FILE__, "突然, 一个声音响起来: 拿了东西就想溜?\n\n");
      list = all_inventory(me);
      i = sizeof(list);
      while (i--)
        destruct(list[i]);
      if (!living(me)) return 1;
      message("system", HIR "\n你的眼前一黑，接著什麽也不知道了....\n\n" NOR,
        me);
      //	tell_room(__FILE__, "只见两个海鲸帮弟子扛起" + me->query("name")+"就走\n\n");
      me->set("gin", 0);
      me->set("kee", 0);
      me->set("sen", 0);

      //	if( ob = find_object(__DIR__"dragon_lao1") )
      //                                me->move(ob);
      me->set_temp("block_msg/all", 1);
      tell_room(__DIR__ "dragon_lao1",
        "两个海鲸帮弟子把" + me->query("name") + "一丢就走了!\n");

      COMBAT_D->announce(me, "unconcious");
      if (ob = find_object(__DIR__ "dragon_lao1"))
        me->move(ob);
      tell_room(__FILE__, "只见两个海鲸帮弟子扛起" + me->query("name") + "就走\n\n");
      me->disable_player(" <昏迷不醒>");

      call_out("do_revive", random(100 - query("con")) + 30, this_player());
      //
      //			this_player()->unconcious();
      //			if( ob = find_object(__DIR__"dragon_lao1") )
      //				this_player()->move(ob);


      return notify_fail("\n");
    }
  }
  return 1;
}

varargs void do_revive(object me, int quiet) {
  remove_call_out("do_revive");
  me->enable_player();
  if (!quiet) {
    COMBAT_D->announce(me, "revive");
    me->set_temp("block_msg/all", 0);
    message("system", HIY "\n慢慢地你终於又有了知觉....\n\n" NOR,
      this_player());
  } else
    me->set_temp("block_msg/all", 0);
}

void reset() {
  ::reset();
  delete("knock_tigger");
}
