//wsecret.c

inherit ROOM;

create() {
  set("short", "密室");
  set("long", @LONG
这间屋子里点了两盏昏暗的烛灯，可以看见中间放了张很大的供桌，上面
摆满了牌位，供的都是文家的列祖列宗，又毕恭毕敬地放着些供品，中间还摆
了个古色古香的小盒子。地上放着三个蒲团。正面墙上挂了一副画像，下面隶
书写着“本门祖师  玄黄教主像”。
LONG);
  set("exits", ([
    "west": __DIR__ "wbedroom",
  ]));
  set("outdoors", "hankou");
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_open", ({ "open" }));
}

int do_open(string arg) {
  if (arg == "盒子")
    return notify_fail("你打开盒子，发现里面什么都没有。\n");
}
