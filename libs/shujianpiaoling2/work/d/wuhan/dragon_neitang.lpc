// dragon_neitang.c

inherit ROOM;

void create()
{
	set("short", "内堂");
	set("long", @LONG
幽静的厅堂中放着两张太师椅, 一张桃木茶几上放着两只茶杯, 清香
的龙井还冒着热气. 正中墙上悬着一幅画, 画的是龙腾虎跃. 往南有一扇
门紧闭着.
    庭院深深, 你不知道里面还有几重院落. 这里由一名护法守着, 闲杂
人等不得入内.
LONG );
	set("exits", ([
	"north" : __DIR__"dragon_changlang",
	"east"  : __DIR__"dragon_hall",
]) );
	set("objects", ([
		__DIR__"npc/dragon_hufa2"	: 1,
]) );
	setup();
}

void init()
{
	add_action("do_open", ({"open"}) );
}

int do_open(string arg)
{
	object ob;
	
	if( arg != "door")return notify_fail("你打开什么?\n");
	if( query("exits/south") )return notify_fail("门是开的!!\n");
	if( ob = present("key", this_player()) ){
		if( ob ->query("name") == "铜钥匙" ){
			message_vision(
			"$N打开向南的门.\n", this_player());
			set("exits/south", __DIR__"dragon_library");
			tell_room(__DIR__"dragon_library", "有人从北边把门打开.\n");
			if( ob =find_object(__DIR__"dragon_library")){
			  ob ->set("exits/north", __FILE__);
			  
			}
		return 1;
		}
		return notify_fail("你发现钥匙不对!\n");
	}
	return notify_fail("你发现门是锁着的!\n");
}

int valid_leave(object me, string exit)
{
	object ob;

	me->delete("marks/蓝宫柳");
	if( exit == "south" || exit == "s" ){
		 tell_object(this_player(), 
		"门在你身后轻轻地关上.\n");
		 delete("exits/south");
		 if( ob =find_object(__DIR__"dragon_library") ){
			ob->delete("exits/north");
		 	tell_room(__DIR__"dragon_library", "门轻轻地关上.\n");
		}
		return 1;
	}
	if( exit == "north" || exit == "n"){
		if(!present("lan hufa", this_object()) )return 1;
		if(me->query("class")!="haijing")
		  return notify_fail("蓝宫柳身形一闪挡住你的路, 说道"
			"外帮客人请勿乱闯!\n");
		if( me->query("combat_exp")< 100000)
		   return notify_fail("蓝宫柳身形一闪挡住你的路, 说道"
			"年轻弟子莫要乱闯!\n");
		return 1;
	}
        return 1;
}

