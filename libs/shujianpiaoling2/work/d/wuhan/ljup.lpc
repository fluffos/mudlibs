// Room: /u/wuhan/ljup.c

inherit ROOM;

void create()
{
	set("short", "珞珈山--山坡");
	set("long", @LONG
你沿山而上, 这里山势平缓的很, 草丛里好象还有些古怪的
东西。北面可以看见一座小山丘, 山下是一望无际的花海。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"lj_dongkou",
  "down" : __DIR__"luojia",
]));
set("objects", ([
	__DIR__"npc/woodcutter"  : 1,
]));
		setup();
}

void init()
{
    add_action("do_search", "search");
}

int do_search(string arg)
{
    object ob;
    
    if(arg != "grass" )return 0;
    if(query("no_pill"))
	return notify_fail("那里什么也没有!\n");
    ob = new(__DIR__"obj/zpaper");
    ob->move(this_player());
    message_vision("$N从草丛中找到些什么放在怀里\n", this_player());
    set("no_pill", 1);
    return 1;
}

void reset()
{
    ::reset();
    delete("no_pill");
}
