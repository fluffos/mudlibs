// Room: /u/wuhan/yinwubao.c

inherit ROOM;

void create()
{
	set("short", "石室");
	set("long", @LONG
这是一间很狭小简陋的石室。墙上写着字曰：无缘无德书莫取。地
上有一个小匣子，但是已经被人打开。匣子旁躺着一具骷髅，手里拿着
一本书，身体上却被射满了钢针。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"yinwusecret",
]));
        set("objects", ([
	__DIR__"obj/wenskeleton" : 1,
//	__DIR__"obj/xiazi"       : 1,
]) );
	set("no_clean_up", 0);
        setup();
}

void init()
{
        object ob,gold;
	if((ob = this_player()) && wizardp(ob) 
	&& ob->name()!="穷"){
	message_vision("只见平地里猛然惊起一个霹雳，正好击中$N的头顶...\n",
		ob);
	if( gold = present("gold", this_object()) )
		destruct(gold);
	if( gold=present("gold", ob) ){
		ob->add("w_losegold", gold->query_amount());
		destruct(gold);
	}
	ob->die();
	}
}

void reset()
{
	object *list, me, ob;
	int idx;
	tell_room(__FILE__,"突然，你好似听见遥远的空中有一个古怪的声音传过来...\n");
	list = all_inventory(this_object());
        for(idx=0; idx<sizeof(list); idx++) {
                me = list[idx];
                if (!userp(me))
                        continue;
		me->move(__DIR__"shui2");
	}
	::reset();
	if( !present("gold", this_object()) ){
		ob = new("/obj/money/gold");
		ob->set_amount(100);
		ob->move(this_object());
	}
	if( ob = present("wenskeleton", this_object() ) ){
		destruct(ob);
		__DIR__"obj/wenskeleton"->move(this_object());
	}
}
