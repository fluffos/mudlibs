// Room: /u/wuhan/ljguiyuan2.c

inherit ROOM;

void create()
{
	set("short", "桂园院内");
	set("long", @LONG
这是个很大的院子。这么大个院子居然全用大理石铺地, 地
上正凉晒着桂花。庄院里有十几进房屋, 外形皆是精巧气派。四
面是高高的院墙, 红砖绿瓦, 矜持地把这里和外界隔绝开。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"ljguiyuan1",
  "north" : __DIR__"ljguiyuan3",
]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
    add_action("do_climb", "climb");
}

int do_climb(string arg)
{
    if( arg != "院墙" && arg != "wall" )return 0;
    message_vision("$N纵身翻过院墙...\n", this_player());
    tell_room(__DIR__"dhbian1", this_player()->namer() +
	      "突然出现在你面前, 一副作贼心虚的样子\n");
    this_player()->move(__DIR__"dhbian1");
    return 1;
}

    
