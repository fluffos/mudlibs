// Room: /u/wuhan/dragon_secret_room.c

inherit ROOM;

void create()
{
	set("short", "暗室");
	set("long", @LONG
你进到一间一丝光线也没有的石室中. 接着进来是的那点点亮光, 你依析可见
一个人缩在墙角, 手足都被铁练锁住, 铁练另一端则穿入地底. 你一进来, 头
顶的石板落下, 你就什么也看不见了.
LONG
	);
	set("objects", ([
		__DIR__"npc/xiazi" : 1
]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_push", ({"push"}));
}


int do_push(string arg)
{
	if(arg!="石板")return notify_fail("你推什么?\n");
	tell_object(this_player(), "你用力一推头上的石板\n");
	if(this_player()->query("max_force")<500)
		return notify_fail("结果没有推动\n");
	message_vision("一丝光线射进来, 头上的石板开了\n",this_player());
	set("exits/up", __DIR__"dragon_yard");
	call_out("close_passage", 3);
	return 1;
}

void close_passage()
{
	remove_call_out("close_passage");
	delete("exits/up");
	tell_room(__FILE__, "轰的一声, 石板又落下来\n");
	return;
}

int valid_leave(object who, string exit)
{
	object ob;
	if( ob = present("xiazi", who) ){
	    return notify_fail ("瞎老头被链子锁住了，你动弹不得\n"); 
	}
	return ::valid_leave(who, exit);
}
