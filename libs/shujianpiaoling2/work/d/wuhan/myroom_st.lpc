// myroom_st.c 
inherit ROOM;

void create()
{
        set("short","街道");
        set("long",
	"一条街, 北边是穷的家. 小心, 穷的家不是那么好进去的!\n");
	set("exits", ([
		"north"  :  __DIR__"myroom",
		"eastup" :  __DIR__"luojia",
	]));
	
	
        setup();
}

int valid_leave(object me, string exit)
{
	object ob;
	string namee;
	
	if( exit != "north" || !query("exits/north"))
	  	return 1;
	ob = find_object(__DIR__"myroom");
	namee = me->name();
	message("vision", 
		"门在"+namee+"身后\"轰\"的关上, "+namee+"发现被关在门内, 看来你只有讨好\n"
		"讨好主人, 她才有可能告诉你如何出去.\n"
		"\n",
	   	 ob
	);
	tell_object(me,
		"门在你身后\"轰\"的关上, 你发现被关在门内, 看来你只有讨好\n"
		"讨好主人, 她才有可能告诉你如何出去.\n"
		"\n"
	);
	delete("exits/north");
	if( ob = find_object(__DIR__"myroom") )
		ob->delete("exits/south");
	return 1;
}

void reset()
{
	object ob;
	
	::reset();
	set("exits/north", __DIR__"myroom");
	if ( ob = find_object(__DIR__"myroom") )
		ob->set("exits/south",__FILE__);
}

