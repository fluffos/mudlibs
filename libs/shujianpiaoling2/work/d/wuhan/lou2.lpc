// lou2.c

inherit ROOM;

create()
{
        set("short", "黄鹤楼--二楼");
	set("long", @LONG
这是一个喝酒赏景的所在, 厅堂里摆着数十张桌子, 小二忙得不亦乐乎. 右首
临窗的一个桌子上, 一个书生模样的年轻人正喝得烂醉如泥.
LONG );
	set("exits", ([
	"up"	:  __DIR__"lou3",
	"down"	:  __DIR__"lou1",
]) );
	set("objects", ([
	__DIR__"npc/yedong.lpc" 	: 1,
]) );
	setup();
}



