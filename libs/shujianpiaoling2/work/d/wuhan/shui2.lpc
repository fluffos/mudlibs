// Room: /u/wuhan/shui2.c

inherit ROOM;

void create()
{
	set("short", "江下");
	set("long", @LONG
这里是江中的一块礁石林, 却还不是江底. 下面乌黑一团, 要继续游
下去, 你可要掂量一下功夫和胆量. 你在附近游个来回, 发现有块礁石缝
中夹着个油纸包.
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "up" : __DIR__"shui1",
]));
        set("objects", ([
	__DIR__"obj/unarmed_b"  : 1,
]) );
	set("no_clean_up", 0);

	setup();
}

void init()
{
add_action("do_dive", ({"dive","tiao","tiaoshui"}) );
}

int do_dive()
{
        object ob;

        if((int) this_player()->query_skill("diving", 1)<30)    
	    return notify_fail("你的水下功夫不够!\n");

       tell_room(__DIR__"shui3",
		this_player()->query("name")+"一个猛子扎下来!\n");
       message_vision("$N深吸了一口气, 一个猛子又往水的深处扎下去\n", this_player());
                this_player()->move(__DIR__"shui3");
	
       return 1;
}
