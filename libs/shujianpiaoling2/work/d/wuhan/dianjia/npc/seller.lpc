// seller.c
inherit NEW_VENDOR;

void create()
{
        set_name("点龙思", ({"seller" }) );
        set("title", "点家庄");
        set("gender", "男性" );
        set("age", 41);
	set("combat_exp", 20000);
	set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("sword", 60);
	
	set("vendor_goods", ([
	    "/obj/example/dumpling" : 30,
	    "/obj/example/wineskin" : 20,
	    "/obj/exmaple/bag"      : 20,
	    "/obj/exmaple/teapot"   : 20,
        ]) );

        setup();
        add_money("silver", 25);
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/weapon/longsword")->wield();
}

void init()
{
        ::init();
        add_action("do_vendor_list", "list");
}

