// pinksword.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name( "粉剑", ({ "pink sword" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把精巧的小粉剑\n");
		set("value", 42000);
		set("material","stell");
	}

	init_sword(25);
	set("weapon_prop/personality", 1);
	setup();
}
