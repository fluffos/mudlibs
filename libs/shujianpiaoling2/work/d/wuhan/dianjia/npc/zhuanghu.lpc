// zhuanghu.c

inherit NPC;

string first_name = "点龙";

string *name_words = ({ "答", "复", "盖", "层", "望", "朋", "拉" });

void create() {
  string name;
  name = first_name + name_words[random(sizeof(name_words))];
  set_name(name, ({ "dian" }));
  set("gender", "男性");
  set("title", "点家庄");
  set("age", 42);
  set("str", 25);
  set("cor", 30);
  set("cps", 27);
  set("int", 10);
  set("attitude", "friendly");

  set("max_kee", 1000);
  set("kee", 1000);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 2);
  set("water", 40000);
  set("food", 40000);

  set("combat_exp", 100000);

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);
  set_temp("apply/damage", 10);

  setup();
  carry_object("/obj/cloth")->wear();
}

void reset() {
  set("water", 40000);
  set("food", 40000);
}
