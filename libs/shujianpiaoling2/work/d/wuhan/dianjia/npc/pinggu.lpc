// pinggu.c
#include <ansi.h>
inherit NPC;
void create()
{
        set_name("点萍姑", ({ "dian pinggu","dian", "pinggu"}));
	set("gender", "女性" );
	set("title", "点家庄庄主");
	set("long", "点萍姑和祠堂中画像里的点点一模一样，却毫无点点的忧郁\n");
        set("age", 42);
        set("str", 25);
        set("cor", 30);
        set("cps", 27);
	set("per", 35);
        set("int", 10);
	set("attitude", "peaceful");

	set("max_force", 4000);
        set("force", 4000);
        set("force_factor", 2);
	set("water", 400);
	set("food", 400);

	set("combat_exp", 1000000);
	
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
        set_skill("parry", 100);
	set_skill("sword", 100);
	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);

	setup();
	carry_object(__DIR__"obj/pingcloth")->wear();
}

int accept_object(object who, object ob)
{
    if( ob->query("name")!= "映月梅花") return 0;
    call_out("secret", 1, who);
    return 1;
}

void secret(object who)
{
    remove_call_out("secret");
    if( !living(this_object()) || is_fighting() 
	||!who || environment() != environment(who) )return;
    if( environment()->query("short") != "萍姑的家")return;

    command(":P");
    command("thank " + who->query("id"));
    
    command("whisper " +  who->query("id") + 
	    " 我跟你讲一个这把剑的故事吧! 你随我来!\n");
    tell_object(environment(), 
	       "点萍姑在大床的角落里摸索了几下, 西边的大箱子突然向一旁移开,\n"
		"露出一个密室。\n"
		"忽然, 点萍姑猛地回过头来, 嗬道：谁？\n"
		"你转身看时，只见老柏树上青影一晃。\n"
		"点萍姑说道：这里谁都不要走动！说着身子已如剑一般追了出去。\n"
	);
    environment()->set("exits/westdown", "/d/wuhan/dianjia/secretroom");
    this_object()->move("/d/wuhan/dianjia/pinggu");

    call_out("rentre", 2, who);
    return;
}

void rentre(object who)
{
    object ob;

    if(!living(this_object()) || !who)return;
    
    if(environment(who)->query("short") == "点家密室"){
	tell_object(who, "点萍姑怒道：为什么私自就闯进来？\n");
	this_object()->move(environment(who));
	this_object()->kill_ob(who);
	return;
    }

    this_object()->move("/d/wuhan/dianjia/phome");
    
    ob = environment();
    tell_object(ob, "点萍姑走过来\n");
    if( environment(who)!= ob){
//	tell_object(ob, "guan\n");
	ob->delete("exits/westdown");
	return;
    }

    command("say 唉！此人轻功竟然如此了得, 居然追出去时, 人影皆无!");
    command("westdown");
    who->move("/d/wuhan/dianjia/secretroom");
    ob->delete("exits/westdown");
    call_out("history", 1, who);
    return;
}

void history(object who)
{
    command("say " @LONG
您倒也知道这把剑和我们家大有关系, 却是难得。你可知道这件事的缘委
吗？想当年我门方大侠年纪虽轻，却收得三个年长的弟子, 便是屠双, 田
一, 和我祖点点。方大侠当年为情所伤, 退出江湖之日, 留下一份藏宝地
图。这张地图撕成九份, 方大侠及其三大弟子, 方大侠之挚友玄妙教主及
其四大弟子每人分持一张。当时有言云后世有缘者得之。这九人各奔东西
, 后世要寻到这九张图当真是非有大缘不可。其时, 田一与点点本是对想
亲相爱的情侣, 然而有一日田祖外出, 便杳无音迅。至于为何事外出, 连
点点也未告知。点点无望之后便隐居此地, 产下田一的遗腹女儿, 这即是
点家庄的来历。这把映月梅花是我家老祖的配剑, 你找到它也算是了了一
庄悬案。这本书是我家祖传的秘籍, 如今赠给你以作感谢吧！
LONG);
    call_out("repose", 1, who);
    return;
}

void repose(object who)
{
    command("say 好吧, 你先去歇息吧");
    command("eastup");	
    who->move("/d/wuhan/dianjia/pgroom");
    call_out("accident", 1, who);
    return;
}

void accident(object who)
{	
    object ob, room;

    if( !(room = find_object("/d/wuhan/dianjia/pyroom"))){
	call_other("/d/wuhan/dianjia/pyroom","???");
	room = find_object("/d/wuhan/dianjia/pyroom");
    }
    if( !(ob = present("xiaohong", room)))
	ob = new("/d/wuhan/dianjia/npc/xiaohong");
	ob->move("/d/wuhan/dianjia/phome");

	COMBAT_D->announce(this_object(), "unconcious");
	this_object()->disable_player(" <昏迷不醒>");
//	tell_object(environment(), "xiaohong");
	CHANNEL_D->do_channel(ob, "chat", "来人啊！不得了啦！萍姑给人迷晕过去啦！！！");
	call_out("reiv", 5);
	return;
}
	
void reiv()
{
	object where, ob;

    COMBAT_D->announce(this_object(), "revive");
    this_object()->enable_player();
    command("say 居然中了歹人的迷香！");
    tell_object(environment(), 
		"点萍姑突然惊叫一声, 好象想起什么事来。\n"
		"点萍姑打开密室, 飞身进去\n"
		"只听得点萍姑在里面长叹一声, 缓步走出来, 满联都是沮丧的神情。\n"
		);
    command("say 没料到这份地图会在我手上遗失... 盗图者应该是庄中内贼....");
    tell_room("/d/wuhan/dianjia/lyinjia", "点龙印突然一阵慌乱\n");
    where = find_object("/d/wuhan/dianjia/lyinjia");
    while( ob = present("dian longyin", where) )
	destruct(ob);
    ob = new(__DIR__"longyin");
    ob->set("map", 1);
    ob->move(where);
    
    tell_room("/d/wuhan/dianjia/lyinn", "点龙印的客人突然一阵慌乱\n");
    where = find_object("/d/wuhan/dianjia/lyinn");
   while( ob = present("dian longyin", where) )
        destruct(ob);

    return;
}
	
