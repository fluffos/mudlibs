// fenggu.c
#include <ansi.h>
inherit NPC;
void create() {
  set_name("点凤姑", ({ "dian fenggu", "dian", "fenggu" }));
  set("gender", "女性");
  set("title", "点家庄");
  set("long", "她看起来很和蔼可亲\n");
  set("age", 45);
  set("str", 25);
  set("cor", 30);
  set("cps", 27);
  set("per", 26);
  set("int", 25);
  set("attitude", "friendly");

  set("max_force", 4000);
  set("force", 4000);
  set("force_factor", 2);
  set("water", 400);
  set("food", 400);

  set("combat_exp", 700000);

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("sword", 100);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);

  setup();
}

int accept_object(object who, object ob) {
  if (ob->query("name") != "武昌鱼的尸体") return 0;
  command("say 谢谢您！芸娘最喜欢吃武昌鱼了！");
  add_money("silver", 10);
  command("give silver to " + who->query("id"));
  if (random(2) == 0) {
    command(":P");
    command("say 这条鱼里还有个珠子呢!");
    __DIR__ "obj/yuzhu"->move(this_object());
    command("give perle to " + who->query("id"));
  }
  return 1;
}
