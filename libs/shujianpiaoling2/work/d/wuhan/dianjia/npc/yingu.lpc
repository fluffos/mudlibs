// yinggu.c
#include <ansi.h>
inherit NPC;
void create()
{
        set_name("点音姑", ({ "dian yingu","dian", "yingu"}));
	set("gender", "女性" );
	set("title", "点家庄");
	set("long", "她有一双聪慧的眼睛\n");
        set("age", 37);
        set("str", 25);
        set("cor", 30);
        set("cps", 27);
	set("per", 20);
        set("int", 25);
	set("attitude", "friendly");

	set("max_force", 4000);
        set("force", 4000);
        set("force_factor", 2);
	set("water", 400);
	set("food", 400);

	set("combat_exp", 400000);

	set_skill("unarmed", 100);
	set_skill("dodge", 100);
        set_skill("parry", 100);
	set_skill("sword", 100);
	set_temp("apply/attack", 100);
	set_temp("apply/defense", 100);

	setup();
}
