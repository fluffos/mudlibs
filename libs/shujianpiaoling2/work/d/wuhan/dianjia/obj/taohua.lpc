// taohua.c

#include <armor.h>

inherit HEAD;

void create()
{
	set_name("桃花", ({"taohua"}));
	set_weight(10);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一枝美丽的桃花\n");
		set("unit", "枝");
		set("value", 100);
		set("armor_prop/personality", 1);
	}
	set("wear_msg","$N细心地把桃花别在鬓角\n");
	set("unequip_msg", "$N从发间取下桃花\n");
	setup();
}
