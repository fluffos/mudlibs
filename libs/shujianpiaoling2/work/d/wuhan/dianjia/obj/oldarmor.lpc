// yinarmor.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("旧盔甲", ({ "armor", "jiu kuijia" }));
  set_weight(10000);
  set("value", 50000);
  set("long", "这是一件旧军装，以前也曾气派非凡\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "iron");
    set("armor_prop/armor", 100);
    set("armor_prop/dodge", -2);
  }
  setup();
}
