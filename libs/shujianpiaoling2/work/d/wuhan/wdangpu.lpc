// Room: dangpu.c

#include <room.h>

inherit HOCKSHOP;

void create()
{
	set("short", "辛氏当铺");
	set("long", @LONG
这是一家中等规模的当铺，老旧的柜台上放著一张木牌(sign)，屋
里的光线不是很亮.
LONG
	);
	set("item_desc", ([
		"sign": @TEXT
本当铺财力雄厚，童叟无欺，欢迎惠顾，绝对保密。
客倌可以在这里典当(pawn)、卖断(sell)各种货物，也可以在这里赎回
(redeem)自己的物品或购买(buy)别人典当的物品。

玩家可把物品估价(value)，或列出(list)可出售的物品。
TEXT
	]) );
	set("exits", ([
	"south"	: __DIR__"wroad4",
	]));
        set("objects", ([
	__DIR__"npc/dangpuer" : 1,
]) );
	set("outdoors", "wuhan");
	setup();

}

int do_sell(string arg)
{
    object ob;

   if(arg == "duanku" 
   && (ob = present(arg, this_player()))
   && ob->query("name") == "青布短裤")
       if(sizeof(all_inventory(this_player())) == 1){
         message_vision(
         "辛老板叹了口气: 这条裤子虽不值钱, 但是既然你穷到了这个份上, 我却不能不帮你一把了\n", 
	 this_player());
         destruct(ob);
         "/obj/money/gold"->move(this_player());
         return 1;
}
else 
       message_vision(
   "辛老板道: 你还有不少家当嘛, 不至于要卖裤头吧!\n", this_player());
return ::do_sell(arg);
}
