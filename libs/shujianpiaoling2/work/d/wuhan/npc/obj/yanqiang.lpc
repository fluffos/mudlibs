// yandou.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("烟枪", ({ "yanqiang" }));
  set("long", "一杆长烟枪, 可以抽(chou)\n");
  set_weight(10);
  set("value", 500);
  if (clonep())
    set_default_object(__FILE__);
  else
    set("unit", "杆");
  init_sword(2);
  setup();
}

void init() {
  add_action("do_chou", "chou");
}

int do_chou(string arg) {
  object ob = environment();
  if (arg != "yanqiang") return 0;
  tell_room(environment(ob), ob->query("name") + "抽了一口烟枪.\n");
  return 1;
}
