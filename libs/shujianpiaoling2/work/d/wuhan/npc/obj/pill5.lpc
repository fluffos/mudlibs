// pill.c
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("丹丸", ({"pill"}) );
        set_weight(250);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "粒");
                set("long", "经验 5000 潜能 100\n");
                set("value", 0);
                set("food_remaining", 1);
                set("food_supply", 1);
	}
	setup();
}

void init()
{
      	add_action("do_eat", ({"eat"}));
}


int do_eat(string arg)
{
	int n;
	if( this_player()->query_temp("block_msg/all"));
		return notify_fail("什么？\n");
	if(!id(arg))return 0;
	    if( (int)this_player()->query("food") >= (int)this_player()->max_food_capacity() )
		return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");
	if( random(9)>4)
	{
             this_player()->add("combat_exp", 5000);
             this_player()->add("potential", 100);
	}
	this_player()->add("food", query("food_supply"));
	if( this_player()->is_fighting() ) this_player()->start_busy(2);
        message_vision("$N将剩下的" + name() + "吃得乾乾净净。\n", this_player());
        destruct(this_object());     
        return 1;

}
