// jasmine_boots.c

#include <armor.h>

inherit BOOTS;

void create()
{
        set_name( "九转紫龙靴", ({ "jasmine boots","jasmine boots" }) );
        set_weight(900);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("unit", "双");
                set("value", 50000);
                set("armor_prop/armor", 1 );
        }
        setup();
}
