// ngblade.c

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create() {
  set_name(GRN "黄金刀" NOR, ({ "jin blade", "blade" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是把金光闪闪的大刀\n");
    set("value", 42000);
    set("material", "gold");
  }
  set("weapon_prop/courage", 5);
  set("weapon_prop/composure", 5);
  set("weapon_prop/personality", 5);
  init_blade(50);
  setup();
}
