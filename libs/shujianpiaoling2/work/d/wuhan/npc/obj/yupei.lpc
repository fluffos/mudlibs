// yupei.c

#include <armor.h>

inherit NECK;

void create()
{
	set_name("玉佩", ({ "yupei" }) );
	set_weight(1000);
	set("long", "玉佩上雕着一条黄凤\n");
	set("value", 10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "支");
//		set("material", "jade");
		set("armor_prop/personality", 1);
	}
	setup();
}

