// shangren.c

inherit NPC;

void create()
{
	set_name("商人", ({ "shangren" }) );
	set("gender", "男性");
	set("age", 41);
	set("long",
		"一个肥肥胖胖的有钱人。最好不要去惹他!\n");
	set("str", 26);
        set("cor", 14);
        set("cps", 29);
        set("int", 25);

	set("combat_exp", 3600);
	
//	set("attitude", "friendly");
        set_skill("force", 60);
        set_skill("unarmed", 80);
        set_skill("dodge", 60);
 
	setup();
	carry_object(__DIR__"obj/goldcloth")->wear();
	add_money("/obj/money/gold", 1);
	carry_object(__DIR__"obj/letter");
}

void init()
{
	add_action("dokill", ({"kill"}));
}

int accept_fight(object me)
{
        object ob=environment();
	
//	if( !( ob = present("young man", ob)))
	if( !( ob = present("youngman", ob)))
	    return 0;
	ob->kill_ob(me);
	fight_ob(me);
	return 0;
}

int dokill(string arg)
{
	object ob,me = this_player();
	if(!this_object()->id(arg))return 0;
        if( ob = present("youngman", environment()))
	    ob->kill_ob(me);
	return "/cmds/std/kill"->main(me, this_object());
}
