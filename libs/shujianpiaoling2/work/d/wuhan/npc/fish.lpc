// fish.c

inherit NPC;

void create()
{
        set_name("武昌鱼", ({ "fish"}) );
	set("long", "一只味道鲜美的武昌鱼\n");
	set("race", "野兽");
        set("age", 1);
	set("limbs", ({ "头部", "身体","翅膀"}) );
	set("verbs", ({ "bite" }) );
	set("score", 100);
	
	set_skill("dodge", 40);
	set_skill("unarmed", 10);
	
	setup();
}

void init()
{
	object ob;
	
	::init();
	if(interactive(ob= this_player())){
	 remove_call_out("do_drift");
	 call_out("do_drift", 20, ob);
	}
}

void do_drift(object who)
{
	object ob;
	if(environment(who) == environment()
	&& environment()->query("short")=="江下")
	
//      if ( ob = find_object("/d/wuhan/yinwuzhou1") )

	{
		message_vision("一股暗流冲过来, $N惨叫一声无影无踪...\n",
			who);
		who->move("/d/wuhan/yinwuzhou1");
	}
}

