// youngman.c

inherit NPC;

void create()
{
	set_name("小伙子", ({ "youngman" }) );
	set("gender", "男性");
	set("age", 21);
	set("long",
		"一个很精干的年轻人, 不紧不慢地跟着商人.\n");
	set("str", 26);
        set("cor", 14);
        set("cps", 29);
        set("int", 25);

	set("combat_exp", 50000);
	
	set("attitude", "friendly");
        set_skill("force", 100);
        set_skill("unarmed", 200);
        set_skill("dodge", 200);
 
	setup();
	carry_object("/obj/cloth")->wear();
	carry_object(__DIR__"obj/yupei");
	add_money("/obj/money/gold", 2);
//	carry_object(__DIR__"obj/letter");
}
