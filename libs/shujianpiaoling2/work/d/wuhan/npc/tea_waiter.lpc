// ruihuan.c

inherit NEW_VENDOR;

int on_service = 0;

void create()
{
	set_name("小二", ({ "waiter"}));
	set("long", @LONG
卖茶水的小二
LONG);
	set("title", "茶室");
	set("age", 17);
	set("merchandise", ([
                __DIR__"obj/teapot"  : 20,
	]) );
	set("attitude", "friendly");
	set("str", 17);
        set("int", 30);
        set("spi", 30);
        set("con", 30);

        set("combat_exp", 100);

	
	setup();

	carry_object("/obj/cloth")->wear();
}

void init()
{
        ::init();
        add_action("do_vendor_list", "list");
}

