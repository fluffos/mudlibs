// judge.c
#include "ansi.h"
inherit NPC;
string *dian = ({
  RED "\n"
  "         \n"
  "         ◎\n"
  "             \n"
  "\n" NOR,

  "\n" RED
  "\n"
  "       ◎\n"
  "\n"
  "           ◎\n"
  "\n" NOR,

  "\n" RED
  "       ◎\n"
  "         ◎\n"
  "           ◎\n"
  "\n" NOR,

  "\n" RED
  "       ◎  ◎\n"
  "\n"
  "       ◎  ◎\n"
  "\n" NOR,

  "\n" RED
  "       ◎  ◎\n"
  "         ◎\n"
  "       ◎  ◎\n"
  "\n" NOR,

  "\n" RED
  "       ◎  ◎\n"
  "       ◎  ◎\n"
  "       ◎  ◎\n"
  "\n" NOR,
});

void pay_player(object who, int amount);
void create() {
  set_name("大宝公", ({ "gong" }));
  set("gender", "男性");
  set("title", "好再来");
  set("age", 35);
  set("long", "他脸上的表情仿佛是看到了你口袋里的钱一般。\n");
  set("per", 25);
  set("combat_exp", 4000000);
  set("attitude", "friendly");
  set("force", 3000);
  set("max_force", 3000);
  set("max_kee", 800);
  set("kee", 800);
  set("max_gin", 800);
  set("gin", 800);
  set("sen", 800);
  set("max_gin", 800);
  set("max_sen", 800);

  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/dodge", 100);
  set_temp("apply/damage", 50);
  set_temp("apply/armor", 50);

  set("inquiry", ([
    "赌": "咱也不玩悬的。赌就赌最爽快的, 赌大小, 如何？\n",
    "烂铁剑": "咱这里每天进出的银两叮当响! 你问的是哪一把?\n",
    "吴大麻子": "你是问吴大麻子输掉的那把啊? 那我倒记得, \n"
    "就那把破铜烂铁, 居然被好些大爷看中了, 倒是奇怪的很。\n"
    "想不到试剑山庄的封大庄主赌坛也是把好手, 这把剑最后输给他了\n",
    "试剑山庄": "你这人烦不烦, 不赌就出去吧!\n",
    "封大爷": "你这人烦不烦, 不赌就出去吧!\n",
  ]));

  setup();
  add_money("gold", 1);
  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player())) {
    ob->delete_temp("wuhanbet");
    //		delete("bet/" + ob->query("id"));
    if (!is_fighting()) {
      remove_call_out("greeting");
      call_out("greeting", 1, ob);
    }
  }
  add_action("do_bet", "bet");
  add_action("do_sa", "sa");
}

int do_bet(string arg) {
  int n, m;
  object ob, me = this_player();

  if (!arg
    || sscanf(arg, "%d", n) != 1
    || n <= 0) return notify_fail("你干啥哩? 看看ｓｉｇｎ!\n");

  if (!(ob = present("silver", me))
    || (m = ob->value() / 100) < n)
    return notify_fail("你身上没有这么多银子\n");

  if (query("sa"))
    return notify_fail("大宫宝对你嚷道：怎么？想玩赖？这里已经开赌了！\n");

  destruct(ob);
  //	printf("%d %d\n", m,n);
  if (m != n) {
    ob = new("/obj/money/silver");
    ob->set_amount(m - n);
    ob->move(me);
  }

  message_vision("$N从怀里掏出" + chinese_number(n) +
    "两银子押在台上\n"
    "$n对$N笑道：好！您先撒(ｓａ)！\n", me, this_object());
  if (me->query_temp("wuhanbet") != query("bet/" + me->query("id"))) {
    if (wizardp(me))
      tell_object(me, sprintf("error: %d %d\n",
        me->query_temp("wuhanbet"),
        query("bet/" + me->query("id"))));
    me->set_temp("wuhanbet", n);
    set("bet/" + me->query("id"), n);
  }

  me->add_temp("wuhanbet", n);
  add("bet/" + me->query("id"), n);
  return 1;
}

int do_sa(string arg) {
  object me = this_player();
  if (!arg || arg != "骰子") return notify_fail("你撒什么?\n");

  if (query("sa")) return notify_fail(
    "大宫宝对你说道：急个啥, 这不正赌着哩\n");
  if (!me->query_temp("wuhanbet"))
    return notify_fail("你要先押了才能赌！\n");

  set("sa", me->query("id"));

  message_vision("$N把三粒骰子在手里颠了颠, 随即向小碗里投进去\n"
    "骰子发出清脆的声音, 欢快地蹦嗒起来。\n", this_player());

  set("mytotal", 0);
  set("gongtotal", 0);
  call_out("myresult", 1, 1);
  call_out("myresult", 2, 2);
  call_out("myresult", 3, 3);

  call_out("gongsa", 4);
  call_out("gongresult", 5, 1);
  call_out("gongresult", 6, 2);
  call_out("gongresult", 7, 3);

  call_out("result", 8, me);
  return 1;
}

void myresult(int no) {
  int di = random(6);
  //	tell_object(environment(),sprintf("%d\n", query("mytotal")));
  tell_object(environment(), "第" + chinese_number(no) +
    "粒骰子停了下来\n" +
    dian[di]);
  add("mytotal", di + 1);
  //	tell_object(environment(),sprintf("%d\n", query("mytotal")));
  return;
}

void gongsa() {
  int gongtotal;
  command("nod");
  tell_object(environment(), "大宫宝大声叫道：赌家"
    +chinese_number(query("mytotal")) + "点！\n");

  tell_object(environment(), "大宫宝又叫道：该我啦！\n"
    "大宫宝凝神深吸一口气, 骰子在手心里抡起来, 再叫一声：开！\n"
    "将三粒骰子掷入翡翠小碗中。\n"
    "\n"
  );
  return;
}

void gongresult(int no) {
  int di = random(6);
  tell_object(environment(), "第" + chinese_number(no) +
    "粒骰子缓缓的停了下来...\n" +
    dian[di]);
  add("gongtotal", di + 1);
  return;
}

void result(object me) {
  tell_object(environment(), "大宫宝大声叫道：庄家" +
    chinese_number(query("gongtotal")) + "点！");
  if (!me) {
    tell_object(environment(), "\n玩家不在！谁接着来？\n");
    delete("bet/" + me->query("id"));
    delete("sa");
    return;
  }
  if (query("mytotal") > query("gongtotal")) {
    tell_object(environment(), " 庄家小！庄家赔！赢家－"
      +me->query("name"));
    if (environment() != environment(me)) {  // i am not  here
      tell_object(environment(), "  人不在！\n");
    } else if (query("bet/" + me->query("id")) != me->query_temp("wuhanbet")) {  // i really bet this hand?
      tell_object(environment(), " 中途退场，不算！\n");
    } else {
      tell_object(environment(), "\n");
      pay_player(me, me->query_temp("wuhanbet") * 2);
    }
  } else
    tell_object(environment(), " 庄家大！庄家赢！\n");
  me->delete_temp("wuhanbet");
  delete("bet/" + me->query("id"));
  delete("sa");
  return;
}





void greeting(object ob) {
  if (!ob || environment(ob) != environment() ||
    is_fighting() || !living(this_object())) return;
  message_vision("$N对$n大声招呼道：这位"
    +RANK_D->query_respect(ob) +
    "过来耍两把？\n",
    this_object(), ob);
}

void pay_player(object who, int amount) {
  object ob;

  if (amount / 100) {
    ob = new("/obj/money/gold");
    ob->set_amount(amount / 100);
    ob->move(who);
    amount %= 100;
  }
  if (amount) {
    ob = new("/obj/money/silver");
    ob->set_amount(amount);
    ob->move(who);
  }
}
