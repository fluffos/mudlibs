// master.c

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("余志枭", ({"master whale", "master","whale" }) );
        set("nickname", "百变蛟龙");
        set("gender", "男性" );
	set("attitude", "friendly");
	set("class", "haijing");
        set("age", 43);
        set("str", 90);
        set("cor", 30);
        set("cps", 27);
        set("int", 30);

        set("max_force", 5000);
        set("force", 5000);
        set("force_factor", 100);

        set("rank_info/respect", "余帮主");

        set("long", @LONG
余志枭是一个不高不矮的中年人, 粗看一眼好象觉得他也很普通, 仔细一打量
你却发现他浑身上下都充满了魅力. 难怪他四十岁出头居然能独创海鲸帮, 崛
起江湖, 作了长江十八盘连营三十六环水寨的总头领. 
LONG
);
        create_family("海鲸帮",1 , "帮主");

        set("combat_exp", 1500000);
        set("score", 200000);

        set("chat_chance_combat", 10);
        set("chat_msg_combat", ({
"余志枭轻笑道: 阁下自己来找麻烦, 就别怪我手下不留情了!!!\n",

//                (: perform_action, "sword.counterattack" :)
        }) ); 
      

        set_skill("unarmed", 200);
        set_skill("dodge", 200);
        set_skill("force", 200);
        set_skill("literate", 150);

        set_skill("dragonforce", 150 );
        set_skill("dragon_strike", 200);
        set_skill("dragon-steps", 150);

	map_skill("force", "dragonforce");
        map_skill("unarmed", "dragon_strike");
        map_skill("dodge", "dragon-steps");

        set("inquiry", ([
                "name": "你既然知道我余帮主，怎麽不知道我是余志枭？",
                "here": "这里便是海鲸帮总舵。",
        ]) );

        setup();
        carry_object(__DIR__"obj/jasmine_hat")->wear();
        carry_object(__DIR__"obj/jasmine_cloth")->wear();
	carry_object(__DIR__"obj/jasmine_boots")->wear();
}

void attempt_apprentice(object ob)
{
        command("smile");
        command("say " + RANK_D->query_respect(ob)
        +"愿为鄙帮效力, 在下自是求之不得!!!"
"n");
        command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "haijing");
}
 
int accept_fight(object ob)
{
	if ((int)ob->query("combat_exp") < 10000){
		command("say "+ RANK_D->query_respect(ob) +
		"功夫还得练练, 要动手去找本帮香主去吧!!");
		command("pat" + ob->query("id") );
		return 0;}
	if ((int)ob->query("combat_exp") < 100000){
		command("say "+ RANK_D->query_respect(ob) +
		"功夫还得练练, 要动手去找本帮舵主去吧!!");
		command("pat" + ob->query("id") );
		return 0;}
	if ((int)ob->query("combat_exp") < 500000){
		command("say "+ RANK_D->query_respect(ob) +
		"功夫还得练练, 要动手去找本帮护法去吧!!");
		command("pat" + ob->query("id") );
		return 0;}
	command("praise" + ob->query("id") );
		return 0;
}
		

void init()
{
	object ob;
	
	::init();
	if (ob = present("master swordsman",environment()))
		kill_ob(ob);
}
