// danpuer.c

inherit NPC;

void create() {
  set_name("辛老板", ({ "xin" }));
  set("gender", "男性");
  set("long", "辛老板是个精明的商人, 其实心地是很好的.\n");
  set("title", "辛家当铺");
  set("age", 35);
  set("str", 20);
  set("cor", 30);
  set("cps", 27);
  set("per", 27);
  set("int", 10);

  set("attitude", "friendly");

  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 10);
  set("water", 400);
  set("food", 400);

  set("combat_exp", 10000);

  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("force", 80);
  set_skill("parry", 80);

  setup();
}
