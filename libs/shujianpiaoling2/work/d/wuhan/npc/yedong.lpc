// yedong.c
#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <move.h>

inherit NPC;


void do_drink();
void create() {
  set_name("冬叶", ({ "dong ye", "dong" }));
  set("gender", "男性");
  set("age", 29);
  set("long", "一个文质彬彬的年青书生, 看起来满腹心事\n");
  set("str", 10);
  set("cor", 14);
  set("cps", 29);
  set("int", 40);

  set("combat_exp", 100);
  set("chat_chance", 6);
  set("chat_msg", ({
    "冬叶喃喃地说: 明天就要与黄家小姐相见, 我却如何找不着胭脂了呢? 这可如何是好?\n",
    "冬叶叹了口气: 今天连去抄书的心情都没有了...\n",
    (: do_drink :),
  }));
  set("attitude", "friendly");
  set_skill("unarmed", 20);
  set_skill("dodge", 60);

  set("inquiry", ([
    "黄家小姐": "黄家小姐是我的未婚妻子!\n",
    "胭脂": "胭脂是黄小姐送我的定情信物, 丢了可如何是好?\n",
    "抄书": "这两天我都在郭东家家里抄书.\n",
  ]));
  setup();
  carry_object("/obj/cloth")->wear();
  add_money("coin", 200);
  carry_object("/obj/example/wineskin");
}

void do_drink() {
  object *list, ob;
  int i, can_drink;
  if ((int)this_object()->query("water") >= 100) return;
  list = all_inventory(this_object());
  i = sizeof(list);
  can_drink = 0;
  while (i--) {
    if ((string)list[i]->query("liquid/type") == "alcohol") {
      ob = list[i];
      can_drink = 1;
    }
  }
  if (can_drink) {
    command("drink " + (string)ob->query("id"));
    if ((int)ob->query("liquid/remaining") == 0) {
      command("drop wineskin");
      ob = new("obj/example/wineskin");
      ob->move(this_object());
    }
  }
}

int accept_object(object who, object ob) {
  if (ob->name() != "贡品胭脂") return 0;
  command(":P");
  command("thank " + who->id());
  command("say 这太好了... 太好了... 您怎么找到的?");
  command("say 这样吧, 我带你去见锦, 她一定很高兴认识你.");
  call_out("huangjia", 1, who);
  return 1;
}

void huangjia(object ob) {
  if (!living(this_object()) || !ob || environment(ob) != environment()) return;

  this_object()->move("/d/wuhan/hankou/hxbr");

  ob->move("/d/wuhan/hankou/hxbr");
  command("say 锦, 我来看你了. 给你介绍一个好朋友, 你知道...");
  message("vision",
    "黄家小姐听完冬叶的叙说, 不由得拧这他的耳朵娇怒道: 我看你还...\n"
    "冬叶轻轻的拥著黄家小姐。\n"
    "黄家小姐对着" + ob->name() + "大笑道: 这可要多谢" + RANK_D->query_respect(ob)
    + ". 这杯酒非喝不可.\n"
    "黄家小姐把一壶酒塞给" + ob->name() + "...\n"
    +ob->name() + "一高兴仰脖子把整壶酒都给喝了.\n"
    +ob->name() + "脚下一个不稳，跌在地上一动也不动了。\n"
    "冬叶叹了口气: 你就喜欢喝酒, 又总爱把人家灌醉\n"
    "黄家小姐笑得嘴巴都合不起来.\n"
    "黄家小姐叫了几个丫头, 说道: 北厢房不是空着吗? 送这位"
    +RANK_D->query_respect(ob) + "去歇息罢\n"
    "冬叶在黄家小姐的额头上吻了一下说道: 那我们明天还是老地方?\n"
    "一朵红云飞上了黄家小姐的面颊\n",
    "/d/wuhan/hankou/hxbr", ob);

  tell_object(ob,
    "黄家小姐听完冬叶的叙说, 不由得拧这他的耳朵娇怒道: 我看你还...\n"
    "冬叶轻轻的拥著黄家小姐。\n"
    "黄家小姐对着你大笑道: 这可要多谢" + RANK_D->query_respect(ob)
    + ". 这杯酒非喝不可.\n"
    "黄家小姐把一壶酒塞给你...\n"
    "你一高兴仰脖子把整壶酒都给喝了.\n",
    "/d/wuhan/hankou/hxbr", ob);
  ob->set_temp("block_msg/all", 1);
  ob->move("/d/wuhan/hankou/hngr");

  tell_room("/d/wuhan/hankou/hngr",
    "两个丫头把" + ob->name() + "放抬进来, 在床上\n");
  ob->set_temp("block_msg/all", 0);
  ob->unconcious();
  command("wave");
  this_object()->move("/d/wuhan/lou2");
  return;
}
