inherit NPC;

void create() {
  set_name("大雕", ({ "diao" }));
  set("long",
    "这是一只硕大无朋的老雕, 身上都不剩几根羽毛了,看起来却结实的很!\n");

  set("race", "野兽");
  set("age", 1000);
  set("attitude", "peaceful");

  set("max_gin", 2000);
  set("max_kee", 4900);
  set("max_sen", 2500);
  set("force", 6000);
  set("max_force", 6000);
  set("food", 800);
  set("water", 800);
  set("str", 30);
  set("cor", 2000);
  set("cps", 100);
  set("spi", 20);
  set("int", 10);

  set("limbs", ({ "头部", "躯干", "尾巴", "翅膀" }));
  set("verbs", ({ "bite" }));

  set_skill("force", 400);
  set_temp("apply/attack", 300);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 1000);
  set_temp("apply/dodge", 300);
  set_temp("apply/parry", 300);
  set_temp("apply/defense", 300);


  set("combat_exp", 1000000);
  set("score", 10000);
  setup();
}
