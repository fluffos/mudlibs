// nomoney.c

#include <ansi.h>

inherit NPC;

void use_poison();

void create() {
  set_name("穷", ({ "i_am_nomoney" }));


  set("gender", "女性");
  set("age", 22);
  set("long",

    "啊!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
    "你从没有见过这么穷却这么美的女子, 你醉了..................\n"
    "\n");

  set("attitude", "peaceful");
  set("class", "dancer");
  set("apprentice_available", 10);

  set("str", 21);
  set("int", 28);
  set("spi", 26);
  set("per", 30);
  set("cps", 30);

  set("force", 12000);
  set("max_force", 12000);
  set("force_factor", 1000);

  set("combat_exp", 1000000);
  set("score", 90000);

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({

    "穷嫣然一笑，一个转身迳自舞了起来，对眼前这场恶斗似乎全不放在心上。\n",
    (: use_poison :),
    (: exert_function, "chillgaze" :),
  }));

  set_skill("unarmed", 40);
  set_skill("sword", 70);
  set_skill("throwing", 100);
  set_skill("force", 30);
  set_skill("parry", 70);
  set_skill("dodge", 100);
  set_skill("literate", 100);
  set_skill("perception", 100);
  set_skill("whip", 100);

  set_skill("stormdance", 100);
  set_skill("tenderzhi", 100);
  set_skill("iceforce", 100);
  set_skill("snowwhip", 90);

  map_skill("dodge", "stormdance");
  map_skill("unarmed", "tenderzhi");
  map_skill("force", "iceforce");
  map_skill("whip", "snowwhip");

  create_family("晚月庄", 1, "庄主");

  set_temp("apply/defense", 100);

  set("inquiry", ([
    "here": "这是我家呀!",
    "出去": "呀! 我是从来不出门的. 不过.....你知道, 我是很穷的..",
    "如何出去":
    "呀! 我是从来不出门的. 不过.....你知道, 我是很穷的..",
  ]));
  setup();

  carry_object(__DIR__ "obj/echowhip")->wield();

  carry_object("/obj/cloth")->wear();
}

void use_poison() {
  object *enemy, ob;
  string msg;

  enemy = query_enemy();
  if (sizeof(enemy)) ob = enemy[random(sizeof(enemy))];

  if (ob->query_condition("rose_poison")) return;

  tell_object(ob,
    "你觉得脸上似乎沾上了什麽东西，伸手一摸却什麽也没有。\n");
  if (random(query("combat_exp")) > (int)ob->query("combat_exp"))
    ob->apply_condition("rose_poison", 20);
}

int accept_object(object who, object ob) {
  if (ob->value() < 10000) {
    command("say 这东西不值钱 ！");
    command(":D");
    return 0;
  }
  if (ob->value() < 200000) {
    command("say 对不起，你的钱不够 ！");
    command(":D");
    return 0;
  }

  tell_object(this_player(),
    "穷说道： 桌子(desk)上有一点儿狗食, 你可以找找(search)看还在不在!\n");
  command(":D");
  return 1;
}
