// cguard.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("守卫", ({ "guard" }) );
        set("long",
                
"这是个壮实的守卫。他站在那里，纹丝不动，目不转睛。\n");

        set("attitude", "friendly");

        set("str", 27);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", 50000);


        set_skill("unarmed", 70);
        set_skill("blade", 70);
        set_skill("parry", 70);
        set_skill("dodge", 70);
        set_skill("move", 100);

        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/damage", 30);
        set_temp("apply/armor", 70);
        set_temp("apply/move", 100);

        setup();

//        carry_object("/obj/g_cloth")->wear();
        carry_object("/obj/blade")->wield();
}

 
