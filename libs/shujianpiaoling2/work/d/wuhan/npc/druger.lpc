inherit NEW_VENDOR;
string feng();
string jieyao();

void create()
{
	set("title", "江湖朗中");
	set_name("风大仙", ({"feng"}));
	set("longer", "一个江湖朗中\n");
	set("combat_exp", 1000);
	set("unarmed", 20);
	set("chat_msg",({
		 "风大仙大声叫道：嗨！卖药罗！卖药罗！祖传秘方！祖传秘方！\n",
		"风大仙恨恨道：他妈的，你可以当老板，我却只能跑江湖！\n"
		}) 
	);
	set("chat_chance", 10);
	set("inquiry", ([
		"祖传秘方" : "您要不要毒药，祖传秘方特灵，只要一两金子\n",
		"断肠散的解药" : (:jieyao:),
		"风拂柳"  : (:feng:),
	]) );
	set("merchandise", ([
		__DIR__"obj/medicine" : 100,
		__DIR__"obj/duan"     : 30,
	]) );
	setup();
	carry_object("/obj/cloth")->wear();
}

void init()
{
	::init();
        add_action("do_vendor_list", "list");
        add_action("do_buy", "buy");
}

int accept_object(object who, object ob)
{
	object drug;

	if( ob->value() != 10000 ) return 0;
	drug =  new(__DIR__"obj/duanchang");
	drug->move(who);
	command("say 好好！这个您拿着！\n");
	tell_object(who, "风大仙偷偷地塞给你个东西\n");
	return 1;
}

string jieyao()
{
	object money, ob, me;
	int amount;
	
	me = this_player();
	if( !(money=present("gold_money", me))) 
		return "您得带点金子啊！\n"; 
	amount = (int)money->query_amount(); 
	if( amount == 1)destruct(money);
	else money->set_amount(amount - 1);
	__DIR__"obj/duanchang_jieyao"->move(me);
	message_vision("风大仙从$N身上拿走一两金子，又塞给$N个东西\n", me );
	return "很好！很好！\n";
}

string feng()
{
	this_player()->set_temp("fengfuliu", 1);
	return "哼！不错，那是我大哥，要不是他占着那本毒经\n"
"我现在也当老板了．．．\n";
}
