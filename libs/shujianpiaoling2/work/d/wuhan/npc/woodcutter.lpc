// woodcutter.c

inherit NPC;
string wenlu();
void movemove();
void create() {
  set_name("樵夫", ({ "woodcutter" }));
  set("gender", "男性");
  set("age", 27);
  set("int", 26);
  set("long",
    "一个年青的樵夫, 正唱着山歌\n");
  set("chat_chance", 10);
  set("chat_msg", ({
    "樵夫自言自语道：好久没有看见那头老雕吃蛇啦\n",
  }));
  set("attitude", "peaceful");
  set("combat_exp", 500);
  setup();
  carry_object("/d/wuhan/dianjia/npc/obj/axe")->wield();
}
