// jieduren.c

inherit NPC;
string askbook();
void create()
{
	set_name("欧阳痴", ({"chi"}) );
	set("long", "精瘦，目光敏锐, 淡灰色的眼球，鹰钩鼻，小嘴唇\n");
	
	set("age", 54);
	set("per", 20);
	set("chat_chance", 10);
	set("chat_msg", ({
		"欧阳痴冷笑道：他们竟敢吃了熊心豹子胆，居然有如此大逆不道的计划\n",	}) );
	set("inquiry", ([
	"大逆不道的计划" : (:askbook:),
	"计划" : (:askbook:),
	]) );
	setup();
}

string askbook()
{
	if( this_player()->query("class")=="haijing")
		return "哼！你们自己的事自己清楚\n";
	else
		return "好！我就指望你了！你先去将一本毒经找给我\n";
}

int accept_object(object who, object ob)
{
	if( who->query("class")=="haijing") 
		return notify_fail("哼！你们不要指望能从我这得到任何东西！\n");
	if( ob->name() == "毒经" ){
		 message_vision(
		"欧阳痴哎的叹了口气，道：这是本假的，没多大用，\n"
		"我需要一本真毒经\n"
		"          ~~~~~~\n", who);
		return 1;
	}
	else if( ob->name() == "「毒经」"){
		command("say 你让我先好好看看，看好了穷会告诉你们的.");
		return 1;
	}
	else return 0;
} 
