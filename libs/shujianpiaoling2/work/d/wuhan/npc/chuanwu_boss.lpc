#include <ansi.h>
inherit NPC;
void create()
{
    set_name("金坎",({"jin kan","jin"}));
    set("long", "金坎曾经是黄河三套五行帮中赫赫有名的人物，现在在两江隐居。\n");
    set("title", "船坞主人");
    set("nickname", HIY"金鲤"NOR);
    set("gender", "男性");
    set("age",34);
    set("attitude", "friendly");
    set("food", 200);
    set("water", 200);
    set("str", 120);
    set("per", 20);
    set("con", 20);
    set("int", 20);
    set("cps", 20);
    set("inquiry", ([
        "boat"  :  "打造渔船要一两金子。\n",
        "make"  :  "打造渔船要一两金子。\n",
        "打造"  :  "打造渔船要一两金子。\n",
        "造船"  :  "打造渔船要一两金子。\n",
        "打造渔船"  :  "打造渔船要一两金子。\n",
]) );
    set_temp("combat_exp", 100000);
    set_temp("apply/damage", 200);
    set_temp("apply/armor", 200);

    set_skill("dodge", 100);
    set_skill("unarmed", 100);
    set_skill("diving", 100);
    set_skill("swimming", 100);
    set_skill("parry", 100);
    setup();
        carry_object("/obj/cloth")->wear();
 }

int accept_object(object me, object ob)
{
	if (ob->query("money_id") && ob->value() >= 10000) 
	{
		if (me->query_temp("fuzhou_boat")) 
		{
	        tell_object(me, "金坎说道：你不是已经有一艘渔船了吗？\n");
			return 0;
		}
		me->set_temp("fuzhou_boat",1);
		tell_object(me, "金坎说道：好吧，正好有一艘现成的渔船，你拿去用吧。\n");
	return 1;
	}
	else
		tell_object(me, "金坎说道：打造一艘渔船至少要一两金子。\n");
		return 0;
}
