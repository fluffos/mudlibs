// cllectr.c

inherit NPC;

void create() {
  set_name("萧通", ({ "xiao", "collector" }));
  set("title", "收藏家");
  set("gender", "男性");
  set("age", 46);

  set("inquiry", ([
    "玄黄教主": "玄黄教主乃是百十年来罕见的人才，据说有人在西方一\n"
    "块乐土上见过他的仙踪，不知是否是真的\n",
    "方玉琪": "大侠方玉琪武功上的境界百十年来世人只可仰止，据说\n"
    "有人在西方一块乐土还见过他老人家的侠踪，不知是否是真的\n",
    "大侠方玉琪": "大侠方玉琪武功上的境界百十年来世人只可仰止，据说\n"
    "有人在西方一块乐土还见过他老人家的侠踪，不知是否是真的\n",
    "纸片": "什么？你给我看看！\n",
    "平龙认": "没听说过\n",
    "丹丸": @LONG
这种丹丸和玄黄教主有大大的关系。当年有一段时间教主致力于
练丹术，不料教主也有做不成的事情，终于没有练成长生不老的丹药。教主
不久就有新的兴趣，随之把练丹的事忘得一干二净。他老人家练过的丹丸也
就散落人间。这些丹丸有的吃了虽不能长生不老却能强身健体，有的吃了则
大病不起。老夫对此到有研究，天下恐怕只有我一人能鉴别。不过鉴别一次
我是要收五两金子的。
LONG,
    //
    "文卜": "哈哈！想不到你对玄黄教主也有如此的兴趣，文卜是\n"
    "玄黄教主的四大弟子之一！\n",
    "郭佤": "郭佤是玄黄教主的四大弟子之一！此人信佛，自称伏\n"
    "虎罗汉，据说曾跟弘灵禅师学过功夫，能使一手好禅杖。\n",
    "师基": "师基是玄黄教主的四大弟子之一！据说此人凶捍无比\n",
    "非叶": "非叶是玄黄教主的四大弟子之一！此人信道，据说深\n"
    "得教主真传\n",
    "玄黄教主的四大弟子":
    "话说玄黄教主遣散教众之后，有四个弟子追随他来到武汉。待到\n"
    "教主与方大侠西去后，就再没有这四个人的消息了。这四个人各叫做文卜，郭佤，\n"
    "师基，非叶。\n",
    //
    "点点": "哈哈！想不到你对方大侠也有如此的研究，点点是方大侠\n"
    "的三大弟子之一！\n",
    "田一": "田一是方大侠的三大弟子之一。他使一口宝剑叫映月梅花\n",
    "屠双": "屠双是方大侠的大弟子\n",
    "方大侠的三大弟子":
    "方大侠只收了三个弟子，分别叫做点点，田一，屠双\n",
    //
    "映月梅花": "那是田一的兵器啊！\n",
    //
    "真毒经": "哦！毒经其实不分真假，只是据说玄黄教主曾著有一本\n"
    "「毒经」，和平常的毒经大不相同。听说有人在归元寺藏经阁里见\n"
    "过，不过自从清涟那老和尚不知去哪儿修行后就再没人看见过了\n",
  ]));
  set("str", 22);
  set("cor", 30);
  set("cps", 30);
  set("int", 26);
  set("per", 23);
  set("con", 24);
  set("spi", 30);
  set("kar", 25);

  set("long",

    "萧通是有名的收藏家。不但收藏，他还搞研究，对于玄黄教主和大侠方玉琪，\n" "当今世上可能没有人比他更有了解了，远近八方不少人都来向他请教。据说\n"
    "他手头有玄黄教主所著《平龙认》的头三页，是以练得雄厚内力。不过他平\n"
    "时足不出户，没有谁真看见过他和别人比试。\n"

    "现在萧通正拿着一面水晶小透镜，细细观察着桌上的一片锈铁。\n");

  set("combat_exp", 100000);
  set("attitude", "friendly");
  set("env/wimpy", 70);

  set("max_atman", 1000); set("atman", 1000);
  set("atman_factor", 3);
  set("max_force", 1000); set("force", 1000);
  set("force_factor", 3);
  set("max_mana", 1000); set("mana", 1000);
  set("mana_factor", 3);

  set("chat_chance", 15);
  set("chat_msg", ({
    "萧通喜道：看来这可是一件真货啊！\n",
    "萧通摇摇头：可是此处还是有疑点。\n",
    "萧通叹口气：这是不是方大侠所用凤翔颡翮之一部分？可凤翔颡翮应是历千年而不锈的呀！\n"
  }));


  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("liuh-ken", 100);
  set_skill("bixueforce", 100);
  set_skill("sanqing-jian", 100);
  set_skill("six-chaos-sword", 100);
  set_skill("chaos-steps", 100);
  set_skill("spells", 100);
  set_skill("necromancy", 100);

  map_skill("force", "bixueforce");
  map_skill("unarmed", "liuh-ken");
  map_skill("dodge", "chaos-steps");
  map_skill("sword", "sanqing-jian");
  map_skill("spells", "necromancy");
  map_skill("sword", "sanqing-jian");

  setup();

}

int accept_fight(object me) {
  command("say 阁下又在说笑话了，在下一介书生，哪会什么武功。");
  return 0;
}

int accept_object(object who, object ob) {
  object pill;
  int n;

  if (ob->value() >= 50000)
    if ((pill = present("pill", who))
      && pill->query("name") == "丹丸"
      && !pill->query("special")) {
      destruct(pill);

      n = random(10000);
      if (n < 1000)
        pill = new(__DIR__ "obj/pill1");
      else if (n < 2000)
        pill = new(__DIR__ "obj/pill2");
      else if (n < 3200)
        pill = new(__DIR__ "obj/pill3");
      else if (n < 4000)
        pill = new(__DIR__ "obj/pill4");
      else if (n < 4003)
        pill = new(__DIR__ "obj/pill5");
      else if (n < 7000)
        pill = new(__DIR__ "obj/pill6");
      else if (n < 7020)
        pill = new(__DIR__ "obj/pill7");
      else if (n < 7030)
        pill = new(__DIR__ "obj/pill8");
      else if (n < 7040)
        pill = new(__DIR__ "obj/pill9");
      else if (n < 7045)
        pill = new(__DIR__ "obj/pill10");
      else if (n < 9000)
        pill = new(__DIR__ "obj/pill11");
      else
        pill = new(__DIR__ "obj/pill12");
      pill->set("special", 1);
      pill->move(who);
      command("say 好了我在丹丸上面作了标签");
      return 1;
    }
  //
  if (ob->query("name") == "无名纸卷") {
    command("say 这是大侠方玉琪的武功心得啊！据说大侠与教主有次\n"
      "乘船出游，覆于江中，许多物品都遗落了\n");
    return 1;
  }
  //	    
  if (ob->query("id") == "zhipian") {
    command("say 哎呀！这可是稀罕物啊！你是什么地方发现的？也难怪你不认识上面的字？\n"
      "这可是教主的手迹！说什么某年某月某日藏书鹦鹉洲下刻字处前走(qian)二十步\n"
      "右走(you)三十步掘地(jue)可得乱掘者死也．．．这是何意？什么刻字处藏的又是\n"
      "什么书？这我得想一想．．．\n");
    return 1;
  }
  return 0;
}
