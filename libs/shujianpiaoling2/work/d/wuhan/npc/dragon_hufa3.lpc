// drangon_hufa3.c

inherit NPC;

void create()
{
        set_name("杨凤亭", ({ "yang hufa", "yang", "hufa" }) );
        set("gender", "男性" );
	set("title", "海鲸帮刑堂堂主");
        set("age", 40);
        set("str", 30);
        set("cor", 30);
        set("cps", 30);
        set("per", 30);
        set("int", 35);


        set("max_force", 2200);
        set("force", 4200);
        set("force_factor", 4);

        set("combat_exp", 800000);
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: exert_function, "powerup" :),
                (: exert_function, "recover" :),
        }) );
	set("water", 600);
	set("food", 600);
	set_skill("force", 150);
        set_skill("blade", 80);
        set_skill("parry", 150);
        set_skill("dodge", 80);

        set_skill("guiyu_force", 140);
        set_skill("spring-blade", 180);
        set_skill("pyrobat-steps", 90);

        map_skill("force", "guiyu_force");
        map_skill("blade", "spring-blade");
        map_skill("dodge", "pyrobat-steps");

        setup();

        carry_object(__DIR__"obj/yangblade")->wield();
	carry_object(__DIR__"obj/zigoldcloth")->wear();
}

void init()
{
	add_action("do_app", ({"apprentice"}));
}

int accept_fight(object ob)
{
        if(ob->query("class")=="haijing")
        {
                command("say 好, 自帮兄弟点到为止!");
                return 1;
        }
        return 0;
}

int do_app(string arg)
{
	object ob=this_player();

        if(arg == "hufa"){
	 message_vision("$N向杨凤亭请教武学的疑问.\n",this_player() );
	 if( ob->query("class") == "haijing"){
	    if( ob->query_kar() >= 28 ){
	        command("say " + RANK_D->query_respect(ob) +
                "和我有缘, 我这身功夫你好好学吧!\n");
		ob->set("marks/杨凤亭", 1);
		return 1;
	    }
	    else {
		command("say " + RANK_D->query_respect(ob) +
			"缘份不够, 就不用勉强了吧..\n");
		return 1;
	    }
	 }
	}
        return (int)call_other("/cmds/std/apprentice", "main", ob, arg);
} 

int recognize_apprentice(object ob)
{
        if( !ob->query("marks/杨凤亭") ) return 0;
	return 1;
}
