// girl.c

inherit NPC;

void create()
{
        set_name("柳护法", ({ "liu hufa", "liu", "hufa" }) );
        set("gender", "男性" );
        set("age", 35);
        set("str", 26);
        set("cor", 24);
        set("cps", 11);
        set("per", 27);
        set("int", 27);


        set("max_force", 200);
        set("force", 200);
        set("force_factor", 2);
        set("combat_exp", 500000);
	set("chat_chance", 2);
	set("chat_msg",  ({
		"柳护法说道: 大家仔细找找, 别让小贼给跑了!!!\n"
})  );
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword.counterattack" :),
        }) );

        set_skill("unarmed", 80);
        set_skill("parry", 120);
        set_skill("dodge", 80);
        set_skill("sword", 80);
        set_skill("force", 80);
        set_skill("literate", 80);

        set_skill("guiyu_force", 100);
        set_skill("zgongsword", 150);
        set_skill("liuh-ken", 80);
        set_skill("chaos-steps", 100);

        map_skill("unarmed", "liuh-ken");
        map_skill("force", "guiyu_force");
        map_skill("sword", "zgongsword");
        map_skill("parry", "zgongsword");
        map_skill("dodge", "chaos-steps");

        setup();

        carry_object("/obj/sword")->wield();
	carry_object(__DIR__"obj/zigoldcloth")->wear();
}

void init()
{
	add_action("do_app", ({"apprentice"}));
}

int accept_fight(object ob)
{
        if(ob->query("class")=="haijing")
        {
                command("say 好, 自帮兄弟点到为止!");
                return 1;
        }
        return 0;
}

int do_app(string arg)
{
	object ob=this_player();

        if(arg == "hufa")
	if( ob->query("class") == "haijing"){
	        message_vision("柳护法对$N说道：你我既然同是一家人, 我这身武艺, "+RANK_D->query_respect(ob) +
"就随便学吧!\n", this_player());
		ob->set("marks/柳护法", 1);
		return 1;
		}
//         call_other("/cmds/std/apprentice", "main", this_player(),arg);
         return 1;
} 

int recognize_apprentice(object ob)
{
        if( !ob->query("marks/柳护法") ) return 0;
	return 1;
}
