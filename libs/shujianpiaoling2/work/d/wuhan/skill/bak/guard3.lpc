#include <ansi.h>

inherit NPC;

void create()
{
        set_name("山寨头目", ({ "guard" }) );
        set("long", "这是七大山寨的头目\n");
        set("attitude", "heroism");

        set("str", 27);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", 70000);
	set("max_force",600);
        set("force", 600);
        set_skill("unarmed", 20);
        set_skill("sword", 120);
        set_skill("parry", 120);
        set_skill("dodge", 120);
        set_skill("move", 100);
	set_skill("force", 200);
	
	set_temp("apply/dammage", 30);
	set_temp("apply/defense", 30);
	set_temp("apply/attack", 30);
	
        setup();

        carry_object("/obj/cloth")->wear();
        carry_object("/obj/longsword")->wield();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && living(this_object())) {
		kill_ob(ob);
        }
}

void unconcious()
{
	object killer;
	if( objectp(killer = query_temp("last_damage_from")) ){
		set_temp("fainter", killer->query("id"));
	}
	::unconcious();
}

void revive()
{
	delete_temp("fainter");
	::revive();
}

void die()
{
	string id;
	if( objectp(killer = query_temp("last_damage_from")) ){	
		if(!( id = query_temp("fainter"))
		|| killer->query("id") == id )
			if( killer->query("combat_exp")
			   < query("combat_exp") )
			   killer->add("combat_exp", 60);
	}
	::die();
}
