// bank.c

inherit BANK;

void create()
{
        set("short", "南宫钱庄");
        set("long", @LONG
这是南宫家在武昌设的分行。南宫在一千百年来一直是江湖首富。南宫家
的银票从来都是最有效的票子。南宫家的钱庄从来都是最有信誉的钱庄。
    这里装饰华贵气派，大红挂毯上悬着个招牌(sign)。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
	"west" : __DIR__"wnroad1",
]));

        set("item_desc", ([
                "sign": @TEXT
这里是钱庄，目前我们提供的服务有：
deposit       存款
withdraw      取款 
convert       兑换钱币。

货币种类:
coin  铜钱  silver  银子  gold   黄金
例如：
            convert 1 silver to coin     把一两银子换成铜钱
            deposit 100 silver           存十两银子入钱庄 
            withdraw 20 gold             从钱庄取出二十两金子
TEXT
        ]) );
        set("objects", ([
                __DIR__"npc/banker": 1 ]) );
        setup();
}

