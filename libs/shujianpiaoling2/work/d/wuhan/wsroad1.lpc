// wsroad1.c

inherit ROOM;

void create()
{
	set("short", "小路");
	set("long", "你走在一条小路上, 路边杂草(grass)从生。北面传来流水的声音。\n");
	set("exits", ([
	"north" : __DIR__"jiangbian2",
	"east"  : __DIR__"wroad1",
]) );
	set("outdoors", "jinling");
	setup();
}

void init()
{
    add_action("do_search", "search");
}

int do_search(string arg)
{
    object ob;
    
    if(arg != "grass" )return 0;
    if(query("no_pill"))
	return notify_fail("那里什么也没有!\n");
    ob = new(__DIR__"hankou/obj/pill");
    ob->move(this_player());
    message_vision("$N从草丛中找到些什么放在怀里\n", this_player());
    set("no_pill", 1);
    return 1;
}

void reset()
{
    ::reset();
    delete("no_pill");
}
