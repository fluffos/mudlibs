// Room: /u/wuhan/shui5.c

inherit ROOM;

void create()
{
	set("short", "暗流中");
	set("long", @LONG
你被无情地冲入一股暗流中，浑身动弹不得．你看见几道不同劲力的
涡流从更深的地方涌上来．而几条怪鱼却游得悠闲自得．
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"shui4",
]));
        set("objects", ([
	__DIR__"npc/guaiyu"  : 3,
	__DIR__"obj/mengran": 1,
	__DIR__"obj/dodge_b" : 1,
]) );

	set("no_clean_up", 0);

	setup();
}

void init()
{
     add_action("do_dive", ({"dive"}));
}

int do_dive()
{
        object ob;

	if( this_player()->is_busy())return 0;
        if((int) this_player()->query_skill("diving", 1)<85)    
            return notify_fail("你的水下功夫不够!\n");

       tell_room(__DIR__"shui5",
                this_player()->query("name")+"一个猛子扎下来!\n");
       message_vision("$N深吸了一口气, 一个猛子向礁石中扎下去\n", this_player());
                this_player()->move(__DIR__"shui6");
		this_player()->start_busy(5);
        
       return 1;
}

