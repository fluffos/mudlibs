//changan city

inherit ROOM;

void create ()
{
        set ("short", "白虎大街");
        set ("long", @LONG

你走在一条宽阔的石板大街上，这是白虎大街的南段。东面是一片民
宅，西面是一座大的寺庙，气势雄伟，善男信女络绎不绝，据说朝廷每当
丰收之日便在这里散发钱粮救济穷苦百姓，所以这座寺庙被天下人称为大
慈恩寺，它原来的名字反而没人记得了。往南便是启夏门。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
		"south" : __DIR__"qixia-men",
                "north" : __DIR__"baihu-s2",
                "west" : __DIR__"ciensi",
                "east" : __DIR__"minzhai4",
        ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/youke" : 1,
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}


