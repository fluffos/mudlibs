//ROOM:/u/changan/street2.c

inherit ROOM;

void create()
{
set("short","朱雀大街");
set("long",@LONG
走过市中心,眼前一条笔直的青石大道,平整而光滑,却是十分冷清,全没有了其它
地方的车马喧嚣.一打听原来这里乃是朝廷大员们的府邸所在.不许闲杂人等无事
逗留只有稀稀拉拉的几个行人急匆匆的走过,气氛肃穆而冷清。再往前即是兵部
尚书大人的官邸了.
LONG
);
set("exits",([
"west":__DIR__"  ",
//"east":__DIR__"  ",
//"south":__DIR__"  ",
"north":__DIR__"street1",
]));
//set("objects", ([
// __DIR__"npc/weishi":2,
//]))
set("outdoors","changan");
setup();

}

void init()
{
   add_action("do_climb","climb");
}

void reset()
{
     object ob;
        ::reset();
	if(!(ob=present("weishi", this_object())) ){
        ob=new(__DIR__"npc/weishi");
	ob->move(this_object());
        }
	
}
	
int do_climb(string arg)
{
        object ob;
	if( arg != "wall" && arg != "院墙" )
                            return 0;
if((int)this_player()->query_skill("dodge")<50)
                           return notify_fail("这个高的墙头你看看就眼晕\n");
        if(ob=present("weishi",this_object())){
               ob->kill_ob(this_player());
message_vision("$N大叫一声:有刺客",this_object());
               this_player()->set_temp("killer",1);          
        }
	message_vision("$N试了试院墙的高度，纵身跃了过去\n", this_player());
	this_player()->move(__DIR__"majiu");
	message_vision("$N纵身跃了进来\n", this_player());

	return 1;
}
