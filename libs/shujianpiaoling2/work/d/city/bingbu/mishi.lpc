//ROOM:/u/changan/bingbu/mishi.c

inherit ROOM;

void create() {
  set("short", "密室");
  set("long", @LONG
这里是假山中的密室什么也没有，墙上有个铁环．
LONG
  );
  setup();

}

void init() {
  add_action("do_la", ({ "la" }));
}

int do_la(string arg) {
  if (!arg) return notify_fail("拉什么?\n");
  if (arg != "铁环") return notify_fail("拉什么呢?\n");
  message_vision("圆石唧唧哑哑的移开了一个空隙\n", this_player());
  set("exits/up", __DIR__ "jiashan");
  tell_room(__DIR__ "jiashan", "假山突然凭空出现了一个缝隙.\n");
  call_out("close_passage", 3);
  return 1;
}

void close_passage() {
  remove_call_out("close_passage");
  delete("exits/up");
  tell_room(__FILE__, "圆石又慢慢的移了回去,严丝合缝什么也看不出来\n");
  return;
}
