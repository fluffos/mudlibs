{
        set ("short", "议事厅");
        set ("long", @LONG
你走进一个庄严肃穆的大厅,整个大厅都是用青石所筑,正中的石壁上高
悬一块巨匾,上书:"聚义厅",底下是一排小字“红旗镖局”镖局里的重要事
件都是在这里决定的。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
              "north" : __DIR__"dayuan",
        ]));

        set("objects", 
        ([ //sizeof() == 1
		__DIR__"npc/zhang" : 1,
        ]));


        set("outdoors", "biaoju");
	set("no_clean_up", 0);
	        setup();
}


