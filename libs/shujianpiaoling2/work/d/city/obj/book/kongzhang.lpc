#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("空白帐本", ({"zhang ben", "zhangben", "book", "shu", "zhang",}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
	set("long",
	"一本空白的帐本，跟一般客店里的没什么两样。\n");
        set("material", "paper");
        set("value", 0);
	set("册", 1);
        set("skill", ([
                        "name": "stealing",
                        "exp_required": 10000,
                        "sen_cost": 35,
                        "difficulty": 35,
                        "max_skill": 50,
]) );
        }
	setup();
}

