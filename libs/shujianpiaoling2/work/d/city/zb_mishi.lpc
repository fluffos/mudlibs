#include <ansi.h>
#include <room.h>

inherit ROOM;
void init();
int do_push(string);
void create()
{
  set("short","内室");
  set("long",@LONG
这是一间内室，屋子不大但收拾得十分整洁。
LONG
    );
  set("exits",([
      "southeast" : __DIR__"zhubao",
     ]));
  set("objects",([
	"/obj/dust" : 2,
	"/obj/shouzhuo" : 1,
  ]));
  create_door("southeast","木门","northwest",DOOR_CLOSED);
 setup();
replace_program(ROOM);
}

