//changan city

inherit ROOM;

void create ()
{
        set ("short", "中心广场");
        set ("long", @LONG
这里是长安城的中心地带.玄武与朱雀两条大路交汇与此。路口车水马
龙，十分热闹。不时还有一队队带刀军士与一些江湖豪客走过。这的路面
是大理石镶嵌的，看上去富丽堂皇，气派非凡，是全城富豪为了庆祝皇上
寿诞而捐钱造的。广场的中心竖立着一块汉白玉丰碑（bei）。
LONG);

        set("item_desc", (["bei" : 
"谨以此碑纪念在长安城建设过程中作过杰出贡献的人士：
	笑苍天		（lmoon）
	残月		（cmoon）
	不动明王	（westwood）

", ]));
        set("exits", 
        ([ //sizeof() == 4
		"south" : __DIR__"zhuque-s2",
                "north" : __DIR__"zhuque-n2",
                "west" : __DIR__"xuanwu-w1",
                "east" : __DIR__"xuanwu-e1",
        ]));
        set("objects", 
        ([ //sizeof() == 1
              __DIR__"npc/drugseller" : 1,
              __DIR__"npc/flowerseller2" : 1,
              __DIR__"npc/scavenger" : 1,
              __DIR__"npc/youke" : 1,
              __DIR__"npc/people" : 1,
//              __DIR__"npc/protect3" : 1,
        ]));

        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}

