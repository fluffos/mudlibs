#include <ansi.h>

inherit NPC;

void create() {
  set_name("童健", ({ "tong jian", "tong" }));
  set("long",
    "这是个正在执行守城任务的大将，是龙飞虎大人的得力部将。\n"
    "[31m你最好不要招惹官府的人。 [37m\n");
  set("attitude", "heroism");

  set("title", "巡城将");
  set("nickname", HIW "白花蛇" NOR);
  set("pursuer", 1);
  set("vendetta_mark", "authority");
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("combat_exp", 100000 + random(1000000));

  set_skill("unarmed", 70 + random(100));
  set_skill("blade", 70 + random(100));
  set_skill("parry", 70 + random(100));
  set_skill("dodge", 70 + random(100));
  set_skill("move", 100 + random(100));

  set_temp("apply/attack", 70);
  set_temp("apply/defense", 70);
  set_temp("apply/damage", 30 + random(200));
  set_temp("apply/armor", 70);
  set_temp("apply/move", 100);

  setup();

  carry_object(__DIR__ "obj/kiujia")->wear();
  carry_object(__DIR__ "obj/blade")->wield();
}
