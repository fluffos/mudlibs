// kuliman.c

inherit NPC;
string reward_more( object who);

void create()
{
        set_name("伙计", ({ "huoji" }) );
        set("gender", "男性" );
        set("age", 22);
        set("long", "这个伙计正在手忙脚乱的往车上装载货物. \n");

        set("combat_exp", 1000);
        set("attitude", "heroism");
        set_skill("unarmed", 10);
        set_skill("parry", 10);
	set_skill("dodge", 10);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
	setup();
	add_money("silver", 1);
        carry_object(__DIR__"obj/jinzhuang")->wear();
        
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 2000 ) return "1";
			if( enemy[i]->query("combat_exp") > 6000 ) return "1";
			enemy[i]->add("combat_exp", 1);
		if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 200 ) return "1";
				enemy[i]->add("potential", 1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 1;
}
