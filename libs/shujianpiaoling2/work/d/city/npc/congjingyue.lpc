#include <ansi.h>
string reward_more( object who);

inherit NPC;

void create()
{
        set_name("丛镜月", ({ "cong jingyue", "cong"}) );
        set("gender", "女性" );
        set("age", 22);
        set("long", "这是一位颇有几分姿色的年轻女子。\n");
        set("combat_exp", 50000);
	set("title", "峨眉弟子");
//	set("nickname", "");
        set("attitude", "friendly");
        set_skill("dodge", 40);
        set_skill("move", 30);
        set_skill("literate", 20);
        set_skill("parry", 40);
        set_skill("unarmed", 40);
        set_skill("force", 40);
        set_skill("sword", 40);

        set_skill("wind_sword",36);
        set_skill("mian_strike", 36);
        set_skill("taiqing_force", 36);
        set_skill("ganchan_steps", 36);

        map_skill("dodge", "ganchan_steps");
        map_skill("unarmed", "mian_strike");
        map_skill("force", "taiqing_force");
        map_skill("parry", "wind_sword");
        map_skill("sword", "wind_sword");
        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
	
	setup();
	add_money("silver", 50);
        carry_object(__DIR__"obj/jinzhuang")->wear();
	carry_object("/obj/longsword")->wield();
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 120000 ) return "1";
			if( enemy[i]->query("combat_exp") > 150000 ) return "1";
			enemy[i]->add("combat_exp", 1);
		if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 200 ) return "1";
				enemy[i]->add("potential", 1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 1;
}


