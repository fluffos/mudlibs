#include <weapon.h>
inherit SPEAR;
void create()
{
	set_name("订作的", ({ "order" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
                set("no_drop",1);
                set("no_get",1);
                set("owner","sjpl");
                set("rigidity",300);
                set("value", 1);
		set("material", "steel");
                set("wield_msg", "$N拿出一把$n，挽了个枪花，然後握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
	}
	init_spear(30);
	setup();
}
