#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("柯避邪", ({ "ke bixie", "ke", "boss" }));
  set("gender", "男性");
  set("age", 59);
  set("nickname", HIB "转世钟馗" NOR);
  set("long", "这是一位面色青紫的店掌柜\n");
  set("combat_exp", 900000);
  set("str", 30);
  set("agi", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);
  set("score", 90000);
  set("attitude", "friendly");
  set("vendor_goods", ([
    __DIR__ "obj/jade1": 7,
    __DIR__ "obj/jade2": 7,
    __DIR__ "obj/jade3": 7,
    __DIR__ "obj/jade4": 7,
  ]));
  set_skill("sword", 170);
  set_skill("unarmed", 170);
  set_skill("parry", 170);
  set_skill("dodge", 170);
  set_skill("force", 170);
  set_skill("pyrobat-steps", 170);
  set_skill("wuxing-quan", 170);
  set_skill("lotusforce", 170);
  set_skill("six-chaos-sword", 170);
  map_skill("force", "lotusforce");
  map_skill("unarmed", "wuxing-quan");
  map_skill("parry", "six-chaos-sword");
  map_skill("sword", "six-chaos-sword");
  map_skill("dodge", "pyrobat-steps");

  setup();
  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/jinzhuang")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(10)) {
    case 0:
      say(" 柯避邪笑着道：这位"
        +RANK_D->query_respect(ob)
        + "，买玉吗？ \n");
      break;
    case 1:
      say(" 柯避邪笑着道：这位"
        +RANK_D->query_respect(ob)
        + "，玉是吉祥之物，买一块吧。 \n");
      break;

  }
}
