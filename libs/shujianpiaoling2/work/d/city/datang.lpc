#include <ansi.h>
inherit ROOM;

void create()
{
  set ("short", "长安府大堂");
  set ("long", @LONG

大堂之上有一种威严之势，不由让人心惊胆颤。前方一张大桌，后面
坐着知府大人。上有一幅大匾，写着＂清正廉名＂四个烫金大字。一边墙
上有一块大的投状栏，栏旁立着一位大内名捕。
LONG);

  set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"yamen",
  "north" : __DIR__"ympianting",
  "south" : __DIR__"shufang",
]));
        set("item_desc", ([
                "投状栏" : "这是个用来贴状纸的布告栏，里面有些纸片。\n"
        ]) );

        set("objects", ([
              __DIR__"npc/jinzm" : 1,
              __DIR__"npc/yayi" : 2,
              __DIR__"npc/yayi1" : 2,
              __DIR__"npc/yayi2" : 2,
                        ]) );
	set("NONPC",1);
        set("no_fight", 1);
        set("no_magic", 1);
  set("light_up", 1);
  setup();
}
void init()
{
	add_action("do_throw", "throw");
}
int do_throw(string arg)
{
	object *inv;
	object me, who;
	object paper;
	object killer;
	string target;
	int targetprice;
	int i;
	if (!arg) return notify_fail("你要放什么入投状栏？\n");
	if( arg !="zhuang zhi" && arg != "状纸")
		return notify_fail("你不可把"+arg+"放入投状栏．\n");
	me = this_player();
	who = this_player();
	inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                {
			if( (string)(inv[i]->query("name")) == "状纸")
				{
					paper = inv[i];		
					break;
				}
		}
	if( !paper) return notify_fail("你没有状纸．\n");
	if( !stringp(paper->query("targetid")))
	return notify_fail("你的状纸上没写字(print)．\n");
 	if( me->query("class")=="official")
	return notify_fail("你身为朝廷命官，没有通过刑部的会审不能随便缉拿人犯。\n");

	if (!present("jin zuoma", environment(me)))
	return notify_fail("金大人不在这里，以后再来吧！\n");

	who->start_busy(2);
	target = (string)paper->query("targetid");
	killer = new(__DIR__"npc/bukuai1");
	killer->set("possessed",who);
	killer->set_leader(who);
	killer->set("haunttar", target); 
	targetprice = (int)paper->query("targetprice");
	destruct(paper);
	killer->set("combat_exp", targetprice/10 );
	targetprice = targetprice / 200000 + 1;
	killer->set_temp("apply/attack", targetprice);
	killer->set_temp("apply/move", targetprice);
	killer->set_temp("apply/dodge", targetprice);
	killer->set_temp("apply/damage", targetprice / 2 );
	message_vision("$N面色凝重地把状纸放入投状栏．\n",who);
	log_file("KILL_LOG",sprintf("(%s)%s在衙门状告%s\n",
		ctime(time()),
		who->query("id"),
		killer->query("haunttar")));
	call_out("gothim", 2, who,killer);
	return 1;
}

void gothim(object who, object killer)
{
	int chance;
	if(who && killer) {
	chance = random(who->query("daode")+who->query("age"));
	if ( chance < 0)
	{
       message_vision(CYN"金作马拿起状纸看了看，对$N冷笑一声：你竟敢诬告陷害他人？来呀，给我拿下！\n\n",who);
       message_vision("转眼冲进来一群捕快，将$N掀翻在地一阵乱打，然后架起$N拖了出去！\n\n"NOR,who);
	who->unconcious();
	who->move("/d/city/yamen.lpc");
	destruct(killer);
	return;
	}
	else{
       message_vision(CYN"金作马拿起状纸看了看，点了点头，说道：我派手下跟你去。来人！\n\n",who);
       message_vision("一个身形矫健的捕快走了进来，附耳在金作马身边听了会儿，又上下打量了$N一眼。\n\n",who);
        killer->move(environment(who));
        message_vision("$N向$n说道：在哪里？带我去．．\n\n"NOR,killer,who);
		}
	return;
	}
}


