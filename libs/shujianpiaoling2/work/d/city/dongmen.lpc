//changan city

inherit ROOM;

void create ()
{
        set ("short", "春明门");
        set ("long", @LONG

这里是长安城的春明门。西面就到了城中，远望人山人海，往来行人车
流不绝。东面一条大路通向武当山。城门下有一些执勤的兵士。时下虽
已天下太平，但一干兵将还是英姿勃勃，警惕的盯着往来人士。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
                "west" : __DIR__"xuanwu-e2",
                "east" : __DIR__"guanroad2",  //goto wudang
                "north" : __DIR__"yan-street3",
                "south" : __DIR__"yan-street4",
        ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/lusiping" : 1,
                __DIR__"npc/bing" : 3,
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}



