#include <ansi.h>
inherit NPC;

void create()
{
	set_name("温百病", ({ "wen baibing","wen","baibing" }));
	set("long",
	    "这是一个四十多岁的怪人, 据说他冷酷无情,\n"+
	    "他衣衫上沾满了油污，目光无神地扫视着四周。\n");
	set("title", "饿鬼帮执法使");
	set("gender", "男性");
	set("age", 44);
	set("nickname", HIB "瘟神" NOR);
	set("attitude", "peaceful");
        create_family("饿鬼帮", 2, "帮众");

        set("str", 40);
        set("int", 30);
        set("cor", 20);
        set("spi", 30);
	set("max_kee", 3000);
	set("max_gin", 3000);
	set("max_sen", 3000);
	set("kee", 3000);
	set("gin", 3000);
	set("sen", 3000);

        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 100);

        set("combat_exp", 2000000);
        set("score", 2000);

        set_skill("literate", 80);
        set_skill("force", 150);
        set_skill("unarmed", 150);
        set_skill("axe", 140);
        set_skill("parry", 120);
        set_skill("dodge", 120);
        set_skill("guiyu_force", 110);
	set_skill("shengui_axe",140);
        set_skill("sanlianhuan", 100);
	set_skill("chaos-steps",120);

        map_skill("force", "guiyu_force");
        map_skill("parry", "shengui_axe");
        map_skill("axe", "shengui_axe");
        map_skill("unarmed", "sanlianhuan");
	map_skill("dodge", "chaos-steps");

	setup();
        carry_object("/obj/weapon/axe")->wield();
        carry_object("/obj/cloth")->wear();
}

void init()
{	
	add_action("do_forge","forge");
}

int  do_forge(string arg)
{
	object me, ob;
	object gold;
	int cost = 1;
	int i,j,base,current;
	string id,name ;	
	string file,newfile,filestring;
	me = this_player();
	id = me->query("id");

        if( !arg ) return notify_fail("你要锤炼什麽武器？\n");
        gold = present("gold_money", this_player());
        if( !gold) return notify_fail("温百病冷冷说道：你身上没有金子！\n");
        if( !objectp(ob = present(arg, me)) )
        return notify_fail("你身上没有这样东西。\n");
        if(me->is_busy())
        return notify_fail("你上一个动作还没有完成。\n");
        if( !ob->query("weapon_prop") )
        return notify_fail("你只能锤炼可当作武器的东西。\n");
        if( ob->query("equipped") )
        return notify_fail("你不可锤炼装备著了的武器。\n");
        if( !ob->query("owner") )
        return notify_fail("你只可锤炼自己打造的武器。\n");
	if( ob->query("skill_type") =="dagger") base= 5;
	else base= 30;
	current = (int) ob->query("weapon_prop/damage");
	for(j=1;j<=100;j++)
	{
		base = base + j;
		if(base >= current) break;
	}
	for(i=1; i<=j;i++)
			cost = cost * 2;
        if((int) gold->query_amount() < cost)
        return notify_fail("你身上没带够" + sprintf("%d",cost)+ "两金子。\n");
        gold->add_amount(-cost);
        me->start_busy(1);
	me->add("bellicosity",cost);
	file = base_name(ob) + ".lpc";
	filestring = read_file(file);
	filestring = replace_string( filestring, 
		sprintf("%d",current), sprintf("%d",current+j));
	newfile = DATA_DIR+"login/" + id[0..0] + "/" + id + "/" + id +
		sprintf("%d",time()) + ".lpc";	
        if( !write_file(newfile, filestring,1))
                return notify_fail("读写文件失败.\n");
	ob->move(this_object());
	destruct(ob);
	rm(file);
	ob = new(newfile);
	name = ob->query("name");
	if(ob->move(me))	
	message_vision(sprintf("$N把%s放入大火炉中一烧，兹地冒出一股浓烟，说道：好了！\n",name),this_object());
	return 1;
}

