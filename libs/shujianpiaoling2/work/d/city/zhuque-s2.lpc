//changan city

inherit ROOM;

void create() {
  set("short", "朱雀大街");
  set("long", @LONG
朱雀大街是长安城的商业中心。大小店铺比邻而立，一派欣欣向荣。
这的路面比不上广场，只是普通的青石大路，但路面很宽，能并行数辆马
车。这里南通明德门，北往朱雀门。西面是全国著名的穆记钱庄，东边是
"百货全"杂货铺，如果你要买一些稀奇古怪的东西可以到那看看。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "zhuque-s3",
      "north": __DIR__ "center",
      "west": __DIR__ "qianzhuang",
      "east": __DIR__ "zahuopu",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/jiaowude": 1,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
