inherit ROOM;

void create ()
{
        set ("short", "城隍庙");
        set ("long", @LONG
这是一间十分破旧的城隍庙，残破不堪。此种景象在一片富贵的长安
很罕见，但没人知道这是为什么。庙里只有一个驼了背的老庙祝看守，平
常也没什么善男信女前来还愿，愈发的感觉它的萧条。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
		"east" : __DIR__"baihu-n3",
        ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/keeper" : 1,
        ]));
	set("no_fight", 1);
	set("no_magic", 1);

//        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}



