inherit ROOM;

void create ()
{
  set ("short", "城郊马场");
  set ("long", @LONG
这是位于城西郊的马场。此马场的老板是退休的军队养马官，素
有小伯乐之称。这里的马虽来自各个地方，但无一例外都是良种马。
只见这里占地极广，绿草茵茵，远处飞奔着几匹高头骏马，一副很美
丽的图画。马场入口处挂着一块木牌（sign）。
LONG);

  set("exits", ([
        "southwest" : "/d/xiangyang/outeroad1",//goto emei and qingcheng
        "northeast" : __DIR__"anhua-men",
      ]));
  set("objects", ([
        __DIR__"npc/maguan" : 1,
        "/u/baiwt/xueshan/xsnpc/horse" : 6,
      ]));
  set("no_fight",1);
  set("no_steal",1);
	set("item_desc", ([
	    "sign" : "欢迎来到西郊马场。骑马请用mount，下马请用dismount。\n",
        ]));
  set("outdoors", "changan");
  setup();
}


