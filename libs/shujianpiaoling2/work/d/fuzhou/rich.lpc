// rich.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        set("short", "白府废园");
	set("long", @LONG
这里是一座久已废弃的府邸，原来的主人据说是二十多年前哧姹江湖的
白蛛剑客，但是自从他死后这里逐年荒芜，到处已是杂草丛生，蛛网联结，
若大的庭院变成了一堆堆乱石堆。
LONG
        );
        set("exits", ([
                "south"    : __DIR__"eroad3" ]) );
	set("objects", ([ /* sizeof() == 1 */
		__DIR__"npc/liu" : 1,
		__DIR__"npc/longboy" : 1,
		__DIR__"obj/hole" : 1,
	]));

        set("item_desc", ([
                "石堆": (: look_sign :),
        ]) );
	set("hell", 1);

        setup();

}
void reset()
{
object con, item, *inv;
::reset();
if( con = present("stonehole",this_object()))
if( inv = all_inventory(con))
if( !sizeof(inv))
	{
	item = new(__DIR__"obj/letter.lpc");
	item->move(con);
	}	
}

string look_sign(object me)
{
        return "石堆里似乎有一团白色的事物。\n";
}

