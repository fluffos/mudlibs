#include <ansi.h>
inherit Q_ITEM;
void create()
{
	set_name(WHT"白绢"NOR, ({"white silk","silk"}) );
	set_weight(5);
	set("long",
	    "\n琼妹:\n"+
	    "　　数月不见，不料汝消瘦多矣！吾与汝既非两心相隔，山重水复，思念更切。\n"+
	    "吾自大师兄点化，已悔不听师父教诲，是非曲直，盖出吾称霸之野心也。大师兄\n"+
	    "方正明义，实令吾感慨万分。今欲改过自新，前罪旧错，一并诚心弥补，怎奈与\n"+
	    "世不容，与人不和，事及至此，虽命之所存，天实为之。然而累汝至此者，未尝\n"+
	    "非予之过也。\n"+
	    "    汝忆否？四年前适冬之望日时节，窗外疏梅月影，依稀掩映，吾与汝并肩携\n"+
	    "手，低低切切，何事不语，何情不诉？及今思之，空余泪痕。吾常思汝之有身也\n"+
	    "，及汝生时，却不知吾亦在你身畔也。汝与神尼之言，盖出吾心，君儿若能堂正\n"+
	    "为人，莫蹈其父之辙，则吾心甚慰，不复多矣。\n"+
	    "    吾诚愿与汝相守以死，然天下人之不愿离而离者，不可数计，吾又将奈之何\n"+
	    "？今吾抱君儿去也，抚其成人，必善待之，汝不必为其担忧。呜呼！早知决汝，\n"+
	    "则予岂肯远游，即游亦尚有几许心中言要汝知闻，共汝筹画也。然则抱此无涯之\n"+
	    "憾，千里相思，唯愿汝当尽吾意为幸矣！\n"+
	    "　　　　　　　　　　　　　　　　　　　　　　　　　          夫紫桦搁笔\n"+
	    "\n");
	set("unit", "幅");
        set("value", 0);
//	set("no_drop", 1);
	set("talk_name","包大通");
	set("talk_msg","$N对$n说道：这件事好象可以去峨眉打听一下。\n");
}
void init()
{
	add_action("do_shows", "show");		//出示，给予
}

int do_shows(string arg)
{
	object me,target;
	me = this_player();
	if( !arg )
		return notify_fail("你想与谁交流？\n");
      if (environment(me)->query("hell"))
	return notify_fail("这里无法与别人交流。\n");
	seteuid(getuid());

	target = present(arg, environment(me));
	if( !target )
		return notify_fail("你想与谁交流？\n");
	if( !target->is_character() || target->is_corpse() )
		return notify_fail("你只能与人交流。\n");
	if( userp(target) && (object)target->query_temp("pending/fight")!=me ) 
		return notify_fail("你没有必要与那个人交流。\n");

	if( target->query("name") == "青云子"){
	message_vision("$N摸出怀中的白绢给$n看了看。\n ", me, target);
	message_vision("$n满面惊疑之色，说道：你。。。你这是从哪里得来的？\n ", me, target);
	message_vision("$n叹了口气，说道：唉，既然如此，你就去见见师伯吧！\n ", me, target);
	message_vision("$n让$N走了进去。\n\n", me, target);
	me->move("/u/emei/hongchun");
	return 1;
	}
	else
	message_vision("$n无奈说道：你问的我不知道。\n", me, target);
	return 1;
}

