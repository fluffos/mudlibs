int accept_object(object who, object ob)
{
	int exp,pot;
	object me;
	me = this_player();
	exp = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
	if( ob->name() == (string)me->query("marks/gejob") ) {
		say( CYN"葛长庚微笑点头，说道：很好，继续努力。\n"NOR);
		me->set("combat_exp", (int) exp + random(50) + 50);
		me->set("potential", (int) pot + random(50) + 50);
		me->add("score", random(20));
		me->add("life_exp", random(20));
		me->delete("marks/gejob");
		return 1;
		}
	else{
		say(CYN"葛长庚说道：多谢你的好意，但这东西对我没用。\n"NOR);
		return 0;
	}
        return 1;
}
