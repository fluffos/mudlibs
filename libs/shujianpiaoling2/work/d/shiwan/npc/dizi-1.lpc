// dizi-1.c

inherit NPC;

void create()
{
	object ob;

	set_name("披麻教第三代弟子", ({ "pima dizi","pima","dizi" }) );
	set("gender", "男性");
	set("age", 20);
	set("long",
		"这是一个披麻教的男弟子。\n");
	set("combat_exp", 10000);
	set("score", 400);
	set("bellicosity", 100);
	set_skill("unarmed", 70);
	set_skill("parry", 70);
	set_skill("dodge", 70);
	setup();
}


void killed_enemy(object who)
{
	command("say 哈哈哈, 不要命的家伙！");
}

