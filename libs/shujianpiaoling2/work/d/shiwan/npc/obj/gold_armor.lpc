// gold_armor.c

#include <armor.h>

inherit ARMOR;

void create()
{
	set_name("乌金战甲", ({ "gold armor", "armor" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "gold");
		set("value", 5000);
		set("armor_prop/armor", 40);
		set("armor_prop/dodge", -10);
	}
	setup();
}
