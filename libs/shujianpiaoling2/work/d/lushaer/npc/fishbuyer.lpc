inherit NPC;
void create() {
  set_name("桑玛", ({ "sang ma" }));
  set("gender", "女性");
  set("age", 15);
  set("combat_exp", 5);
  set("attitude", "friendly");
  set("per", 20);
  set("chat_chance", 15);
  set("chat_msg", ({
    "桑玛问道：这鱼怎么卖？\n",
    "桑玛道：八文一斤卖不卖？\n",
  }));

  setup();
  carry_object("/obj/cloth")->wear();
}
