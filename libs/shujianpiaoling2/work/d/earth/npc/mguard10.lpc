//法术：［山神念法］ 属性：召唤  对象：山神  克星：无
//法术：［山石乱坠符］ 属性：山野  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("山鬼", ({ "shangui", "taoist guard" }) );
	set("gender", "男性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard10");
 	set("mguard_level", 10);
	set("magic_power", 50);

	set("str", 32);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

           set("last_load_time", uptime());
	set("max_mana", 500);
	set("mana", 500);

        set("combat_exp", 100000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy,mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if (!objectp(present("mountain god", environment(who))))
	{
		mygod = new("/daemon/troop/maoshan/hillgod");
		message_vision(HIC"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,who,enemy[i]);
		message_vision(HIC"\n不久只听一阵山崩地裂之声，山神巨大的身影从地上长了出来！\n"NOR,who,enemy[i]);
		message_vision(HIG"［山神念法］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
	return 1;
	}
	message_vision(HIR"\n$N双臂挥舞，只见凭空坠下无数乱石，"NOR,who,enemy[i]);
	message_vision(HIR"\n伴随着一阵山石翻滚之声，那乱石纷纷向$n砸去！\n"NOR,who,enemy[i]);
	message_vision(HIG"［山石乱坠符］！\n\n"NOR,who,enemy[i]);
	if( random(enemy[i]->query("magic_defense"))< random(500) )
			enemy[i]->receive_wound("kee", mwp);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
		}
	}
	return 1;
}

int heal_up()
{
	object who=this_object();
	if( !who->is_fighting() && (uptime()-(int)who->query("last_load_time")) > (random(500)+300) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

