// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［逆灵剑法］ 属性：attack  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("恶灵", ({ "eling", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard40");
  set("mguard_level", 40);
  set("magic_power", 200);

  set("str", 32);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("last_load_time", uptime());
  set("max_mana", 2000);
  set("mana", 2000);

  set("combat_exp", 400000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      message_vision(HIR "\n$N突然变出一柄长剑，剑光一阵乱舞，杂乱无章地朝$n头顶落下，" NOR, who, enemy[i]);
      message_vision(HIR "\n$n只觉灵魂震颤，难以躲闪！\n" NOR, who, enemy[i]);
      message_vision(HIG "［逆灵剑法］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(500))
        enemy[i]->receive_wound("kee", mwp);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
