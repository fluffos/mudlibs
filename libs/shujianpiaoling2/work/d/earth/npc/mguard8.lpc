//法术：［错节符］ 属性：busy1  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("藤怪", ({ "tengguai", "taoist guard" }) );
	set("gender", "男性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard8");
 	set("mguard_level", 8);
	set("magic_power", 40);

	set("str", 32);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

           set("last_load_time", uptime());
	set("max_mana", 400);
	set("mana", 400);

        set("combat_exp", 80000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( random(enemy[i]->query("magic_defense"))< random(500) && !enemy[i]->is_busy())
	{
	message_vision(HIC"\n$N浑身一抖，抖出无数枝叶，象千万只触角般伸了出来。"NOR,who,enemy[i]);
	message_vision(HIC"\n那枝叶相互缠绕，很快织成了一张大网，将$n围困在网中间，"NOR,who,enemy[i]);
	message_vision(HIC"\n然后旁枝不断收紧，令$n无法动弹。\n"NOR,who,enemy[i]);
	message_vision(HIG"［错节符］！\n\n"NOR,who);
			enemy[i]->start_busy(1);
			if( who->query("mana") >= 50 )
			who->add("mana", -50);
			COMBAT_D->report_status(enemy[i],1);
	}
		}
	}
	return 1;
}

int heal_up()
{
	object who=this_object();
	if( !who->is_fighting() && (uptime()-(int)who->query("last_load_time")) > (random(500)+300) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

