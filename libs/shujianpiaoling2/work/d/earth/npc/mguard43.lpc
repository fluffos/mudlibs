//法术：［迷意波］ 属性：busy6  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("相柳", ({ "xiangliu", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard43");
  set("mguard_level", 43);
  set("magic_power", 210);

  set("str", 32);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("limbs", ({ "头部", "身体", "爪子", "尾巴" }));
  set("verbs", ({ "claw" }));
  set("last_load_time", uptime());
  set("max_mana", 2100);
  set("mana", 2100);

  set("combat_exp", 430000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (random(enemy[i]->query("magic_defense")) < random(500) && !enemy[i]->is_busy()) {
        message_vision(HIM "\n$N张口一吐，吐出一团紫色波纹，正中$n面门，" NOR, who, enemy[i]);
        message_vision(HIM "\n$n顿时神志模糊，意志消沉，失去了战斗的能力。\n" NOR, who, enemy[i]);
        message_vision(HIG "［迷意波］！\n\n" NOR, who);
        enemy[i]->start_busy(6);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(enemy[i], 1);
      }
    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
