//法术：［祭火符］ 属性：召唤  对象：火神  克星：无
//法术：［火珠符］ 属性：火  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("妖火", ({ "yaohuo", "taoist guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("mguard", "mguard4");
  set("mguard_level", 4);
  set("magic_power", 20);

  set("str", 32);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("last_load_time", uptime());
  set("max_mana", 200);
  set("mana", 200);

  set("combat_exp", 40000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy, mygod;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (!objectp(present("fire god", environment(who)))) {
        mygod = new("/daemon/troop/maoshan/firegod");
        message_vision(RED "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
        message_vision(RED "\n不久只见空中热气翻腾，火光乍现，眨眼间满地升起熊熊燃烧的火焰，" NOR, who, enemy[i]);
        message_vision(RED "\n火神的身影渐渐在火光中浮现出来。\n" NOR, who, enemy[i]);
        message_vision(HIG "［祭火符］！\n\n" NOR, who, enemy[i]);
        mygod->move(environment(who));
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        return 1;
      }
      message_vision(HIR "\n$N摇身一变。忽然化做无数颗燃烧的火珠。" NOR, who, enemy[i]);
      message_vision(HIR "\n那火珠越烧越亮，呼啸着朝$n身上撞了过来！\n" NOR, who, enemy[i]);
      message_vision(HIG "［火珠符］！\n\n" NOR, who, enemy[i]);
      if (random(enemy[i]->query("magic_defense")) < random(500))
        enemy[i]->receive_wound("kee", mwp);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
