// bandit_commander.c

inherit NPC;

void create()
{
	set_name("雷明远", ({ "lei mingyuan", "lei", "zhaizhu" }) );
	set("title", "老松寨寨主");
	set("nickname", "恨福来迟");
	set("gender", "男性");
	set("age", 43);
	set("str", 83);
	set("combat_exp", 460000);
	set("score", 17000);
	set("daode",-500);
	set("bellicosity", 6000);
	set("attitude", "aggressive");

	set("max_force", 1000);
	set("force", 1500);
	set("force_factor", 3);

	set_skill("force", 160);
	set_skill("blade", 200);
	set_skill("parry", 200);
	set_skill("dodge", 170);

	set_temp("apply/attack", 100);
	set_temp("apply/defense", 60);

	setup();

	carry_object(__DIR__"obj/glaive")->wield();
	carry_object(__DIR__"obj/leather")->wear();
	carry_object(__DIR__"obj/fur_coat")->wear();
	carry_object(__DIR__"obj/bamboo_pipe");
	add_money("silver", 50);
}
