//special.c 顿悟绝技

#include <ansi.h>
#include <combat.h>

int exert(object me, object target, int amount)
{
	string pname, msg;
	int pdm;
        string *zs = ({"身形一转，", "反身穿越，", "腾空而起，", "斜跨进跃，",
"连绕数步，", "平空横掠，", "着地滚近，", "大喝一声，", "一个筋斗翻来，" });
        string *ms = ({"如秋风落叶", "如风驰电掣", "如灵蛇翻身", "如追风踏浪",
"如平地惊雷", "如春潮涌动", "如疾风骤雨" });
	string *act = ({"蹬出一脚", "打出一拳", "拍出一掌", "戳出一指", "踢出一腿",
"一头撞去", "扫出一臂"});

	if( !me->query_temp("temp_exert/cname") )
		return notify_fail("什么？\n");
	if( !target )
		return notify_fail("你要攻击谁？\n");
	if( !target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("你并不在战斗中。\n");

        if((int)me->query_skill("force",1) < 40 )
                return notify_fail("你的内功不够高！\n");

	if( (int)me->query("force") < 200  ) 
		return notify_fail("你的内力不够。\n");
	if( !me->query_temp("temp_exert/damage") ) pdm = 1;
	else
	pdm = (int)me->query_temp("temp_exert/damage");
	pname = me->query_temp("temp_exert/cname");
	msg = HIR"$N施展出绝技"+pname+ "！\n";
	msg += "只见$N"+ zs[random(8)] +ms[random(6)]+"，朝$n意想不到的方位骤然"+ act[random(6)]+ "！"NOR;
//	message_vision(msg, target);
	me->add_temp("apply/damage", pdm);	
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	me->add_temp("apply/damage", -pdm);	
	me->add_temp("temp_exert/damage", random(6));	
	me->add("force", -100);
	me->start_busy(2);
	return 1;
}
