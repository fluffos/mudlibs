// repent.c  对抗心魔 指令  baiwt@sjpl 4,12,2000
#include <ansi.h>

inherit SSERVER;

int exert(object me, object target, int amount) {
  if (target != me) return notify_fail("你只能用内功降低自己的心魔。\n");
  if (me->query("kill_player_record") < 1)
    return notify_fail("你没有生出心魔。\n");

  if (amount == -1) amount = 50;
  else if (amount < 50)
    return notify_fail("最少用五十点内力。\n");

  if ((int)me->query("force") < amount)
    return notify_fail("你的内力不够。\n");
  if ((me->query("potential") - me->query("learned_points")) < 1)
    return notify_fail("你的潜能不够。\n");
  if ((me->query("potential") - me->query("learned_points")) > 1)
    me->add("potential", -1);
  me->add("kill_player_record", -1);
  me->add("force", -amount);
  me->set("bellicosity", 0);
  message_vision(WHT "$N面色苍白，头顶冒出丝丝白气，豆大的汗珠滚滚而下，强行控制着岔乱的内息。\n" NOR, me);
  message_vision(YEL "$N脸色由白转红，由红转黄，又由黄转白．．．．．．\n" NOR, me);
  message_vision(RED "$N“哇”地吐出一口鲜血，眼中终于恢复了些许神采。\n" NOR, me);
  message_vision(CYN "$N颤动的经脉渐渐平息下来，$N的心魔降低了！\n" NOR, me);
  me->start_busy(3);

  return 1;
}
