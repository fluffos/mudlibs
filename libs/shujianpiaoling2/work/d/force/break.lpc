#include <ansi.h>

inherit SSERVER;

int exert(object me, object ob)
{
	ob = me->query_temp("weapon");
	if( !ob )
		return notify_fail("你手里并没有拿着兵器。\n");
	if((int)me->query("force") < 100 )
		return notify_fail("你的内力不够！\n");
	if(me->query("id") != ob->query("owner"))
	{
	message_vision(HIW"\n$N运起内力，手臂一震，“啪”的一声，竟将$n震为两截！\n\n"NOR,me,ob);
	destruct(ob);
	me->add("force",-50);
	me->start_busy(1);
	return 1;
	}	  
	seteuid(ROOT_UID);
	rm(base_name(ob) + ".lpc");
	ob->move(environment(me));
	me->add("created_item",-1);
	seteuid(getuid());
	message_vision(HIW"\n$N运起内力，手臂一震，“啪”的一声，竟将$n震为两截！\n\n"NOR,me,ob);
	destruct(ob);
	me->add("force",-50);
	me->start_busy(1);
	return 1;
}
 
