// gate.c

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", HIW "鬼门关" NOR);
        set("long", 
                "这里就是著名的阴间入口「鬼门关」，在你面前矗立著一座高大的\n"
                
"黑色城楼，许多亡魂正哭哭啼啼地列队前进，因为一进鬼门关就无法再\n"
                "回阳间了。\n");
        set("exits", ([
                "north" : "/d/death/gateway",
        ]) );
        set("objects", ([
                __DIR__"npc/wgargoyle":1
        ]) );
set("no_fight",1);
set("no_magic",1);
set("no_spells",1);
set("no_study",1);
set("no_steal",1);
set("hell",1);

        setup();
//        replace_program(ROOM);
}
 
void init()
{
     add_action("close_cmds", "drop");
     add_action("close_cmds", "get");
     add_action("close_cmds", "give");
     add_action("close_cmds", "fight");
     add_action("close_cmds", "sjpl");
     add_action("close_cmds", "sjpl*");
     add_action("close_cmds", "rumor");
     add_action("close_cmds", "rumor*");
}	
int close_cmds(object me, string arg)
{
	return 1;
}
