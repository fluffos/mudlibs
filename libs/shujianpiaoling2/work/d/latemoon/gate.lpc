#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "晚月庄大门");
  set("long", @LONG
你来到了这个小径的尽头，一个有著朱红漆大门大宅院矗立在
你的面前，门口挂著两串灯笼(deng), 上面写得有字，像这样一间
豪华的大宅院出现在这样的乡间野外，使你觉得有些突兀，大宅的
南边、东边都是茂密的林子，看来也没有其他的路。
LONG
  );
  set("item_desc", ([
    "deng": "灯笼上几个娟秀的字迹写著：\n\n"
    GRN "晚 霞 西 照 人 影 依 稀 \n月 影 高 挂 和 风 婉 约 \n" NOR
  ]));

  set("exits", ([
    "enter": __DIR__ "front_yard",
  ]));

  set("outdoors", "latemoon");

  setup();
  replace_program(ROOM);
}
