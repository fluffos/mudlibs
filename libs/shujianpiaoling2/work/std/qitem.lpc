// qitem.c  quest item情节设计继承物件  by blue and baiwt@sjpl
// this_object()需要定义的内容：
// 指令名_name,  指令名_msg,  指令名_file,   指令名_i,  奖励quest_reward,  回应信息reply_msg
// me->query("reward_rate")为玩家所能获得的奖励机率

#include <dbase.h>
#include <move.h>
#include <name.h>
#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

void setup()
{
	seteuid(getuid());
}
void init()
{
        object ob=this_object();
        ob->set("env/invisibility",99);
	ob->set("value", 0);
	ob->set("no_get", 1);
	ob->set("no_drop", 1);
	add_action("do_talks", "talk");		//交谈,ask,answer y
	add_action("do_cures", "cure");		//治疗            y x
	add_action("do_defend", "defend");  	//打抱不平 意思不清楚，fight?
        add_action("do_lookfor", "lookfor");    //寻找            y
        add_action("do_use", "use");            //用              y
	add_action("do_give", "show");		//出示	 	出示给npc看
	//命令串同talk一样的
//        add_action("do_give", "xgive");		//给予            y
	add_action("do_sing", "sing");		//吟唱      一般要达到什么目的？
        add_action("do_yield", "yield");        //让步，放弃 什么情况下？
        add_action("do_climb", "climb");        //爬		y
        add_action("do_climb", "jump");         //跳            y
       	//命令串同climb一样的
        add_action("do_take", "take");        //拿              y
	add_action("do_pushpull", "push");        //推，压      y
	//命令串同push一样的
        add_action("do_pushpull", "pull");        //拉，拔      y
	//命令串同push一样的
	add_action("do_pushpull", "move");        //移动物体    y
	//命令串同push一样的
        add_action("do_turn", "turn");        //转              y
/*
	add_action("do_cut", "cut");          //削，割，砍       未完成
	add_action("do_make", "make");        //制造		未完成
	add_action("do_open", "xopen");        //打开		未完成
	add_action("do_close", "xclose");        //关闭		未完成
       	add_action("do_hit", "hit");        //打击		未完成
        add_action("do_give","xgive");          //给           
*/
}
int destructobj(object ob)
{
	if(ob)  destruct(ob);
	return 1;
}
//可以在继承中重载dotalk,以实现自己的功能，返回1这将不处理，返回0将缺省处理
//talk_name为动作的中文名，talk_msg为交谈信息，talk_file将新的item交给player和自动消除这个//item,player 的命令是player npc or player id;
// name 为npc 对象时必须是中文名，为其他时应与动作的参数相配
//设计时请多用random以增加难度和不重复;下面其他动作类
//新动作请在继承物件中实现，具体参看/std/qitem.c
//如有其他什么公用的的命令也通知我来做
//有了这个部件后,npc & room 可能很简单，尽量用这种item来做,
//不过npc & room名字需要唯一

//talk_name 谈话对象中文名字，talk_msg 谈话内容，talk_file后续物件或房间
//me player对象 target npc 对象
int dotalk(object me,object targer) {return 0;}
int do_talks(string arg)
{
        object me,target,ob;
	string talk_msg, talk_name, talk_file,reply_msg;
	int reward;
	reward = (int)this_object()->query("quest_reward");

	me = this_player();
	if( !arg )
		return notify_fail("你想与谁交流？\n");
      if (environment(me)->query("hell"))
	return notify_fail("这里无法与别人交流。\n");
        seteuid( geteuid(me) );

	target = present(arg, environment(me));
	if( !target )
		return notify_fail("你想与谁交流？\n");
	if( !target->is_character() || target->is_corpse() )
		return notify_fail("你只能与人交流。\n");
	if( userp(target) && (object)target->query_temp("pending/fight")!=me ) 
		return notify_fail("你没有必要与那个人交流。\n");

	talk_name = this_object()->query("talk_name");
	talk_msg = this_object()->query("talk_msg");
	talk_file = this_object()->query("talk_file");
	reply_msg = this_object()->query("reply_msg");

	if(!talk_msg) talk_msg="什么？\n";
	if(!reply_msg) reply_msg="\n";

        if( target->query("name") == talk_name){
        if (! dotalk(me,target)) {
          message_vision(talk_msg, me, target);
          message_vision(reply_msg, target, me);
          if (talk_file) {
           ob=new(talk_file);
          	if (ob) {
          		if (ob->query_max_encumbrance()==100000000000) //room
          		me->move(ob);
          		else ob->move(me); //item
          		}
          }
		if( reward )
		{
		reward = reward * (int)me->query("reward_rate")/100;
		if( reward <= 0 )  reward = 1;
		me->add("potential",reward/10);
		me->add("combat_exp",reward);
		}
           call_out("destructobj",1,this_object());
         }
         return 1;
	}
	else
	message_vision("$n无奈说道：你问的我不知道。\n", me, target);
	return 1;
}

int dodefend(object me,object targer) {return 0;}
int do_defend(string arg)
{
        object me,target,ob;
	string defend_msg, defend_name, defend_file,reply_msg;
	int reward;
	reward = (int)this_object()->query("quest_reward");

	me = this_player();
	if( !arg )
		return notify_fail("你想跟谁战斗？\n");
      if (environment(me)->query("hell"))
	return notify_fail("这里无法打抱不平。\n");
        seteuid( geteuid(me) );

	target = present(arg, environment(me));
	if( !target )
		return notify_fail("你想跟谁战斗？\n");
	if( !target->is_character() || target->is_corpse() )
		return notify_fail("你只能与人战斗。\n");
	if( userp(target) ) 
		return notify_fail("你没有必要在那个人面前打抱不平。\n");
	if( me->query_temp("is_defending") )
		return notify_fail("你没有必要在那个人面前打抱不平。\n");

	defend_name = this_object()->query("defend_name");
	defend_msg = this_object()->query("defend_msg");
	defend_file = this_object()->query("defend_file");
	reply_msg = this_object()->query("reply_msg");

	if(!defend_msg) defend_msg="什么？\n";
	if(!reply_msg) reply_msg="\n";

        if( target->query("name") == defend_name){
        if (! dodefend(me,target)) {
          message_vision(defend_msg, me, target);
          message_vision(reply_msg, target, me);
	me->kill_ob(target);
	target->kill_ob(me);
	me->set_temp("is_defending",1);  //设置状态为defend
	me->set_delay(1);
	me->set_wait(1);
          if (defend_file) {
           me->set_temp("load_defend_file",defend_file);
/*
          	if (ob) {
          		if (ob->query_max_encumbrance()==100000000000) //room
          		me->move(ob);
          		else ob->move(me); //item
          		}
*/
          }
		if( reward )
		{
		reward = reward * (int)me->query("reward_rate")/100;
		if( reward <= 0 )  reward = 1;
		me->add("potential",reward/10);
		me->add("combat_exp",reward);
		}
           call_out("destructobj",1,this_object());
         }
         return 1;
	}
	else
	message_vision("$n无奈说道：你问的我不知道。\n", me, target);
	return 1;
}
int doyield(object me,object targer) {return 0;}
int do_yield(string arg)
{
        object me,target,ob;
	string yield_msg, yield_name, yield_file,reply_msg;
	int reward;
	reward = (int)this_object()->query("quest_reward");

	me = this_player();
	if( !arg )
		return notify_fail("你想向谁作出让步？\n");
      if (environment(me)->query("hell"))
	return notify_fail("现在无法进行让步。\n");
        seteuid( geteuid(me) );

	target = present(arg, environment(me));
	if( !target )
		return notify_fail("你想向谁作出让步？\n");
	if( !target->is_character() || target->is_corpse() )
		return notify_fail("你只能对人作出让步。\n");
	if( !me->is_fighting(target) ) 
		return notify_fail("你没有必要在那个人面前作出让步。\n");
	if( me->query_temp("is_defending")!=1 )
		return notify_fail("你没有必要在那个人面前作出让步。\n");

	yield_name = this_object()->query("yield_name");
	yield_msg = this_object()->query("yield_msg");
	yield_file = this_object()->query("yield_file");
	reply_msg = this_object()->query("reply_msg");

	if(!yield_msg) yield_msg="什么？\n";
	if(!reply_msg) reply_msg="\n";

        if( target->query("name") == yield_name){
        if (! doyield(me,target)) {
          message_vision(yield_msg, me, target);
          message_vision(reply_msg, target, me);
       me->remove_all_killer();
	me->set_temp("is_defending",3);  //设置状态为yeild
	me->set_delay(1);
	me->set_wait(1);
          if (yield_file) {
           ob=new(yield_file);
          	if (ob) {
          		if (ob->query_max_encumbrance()==100000000000) //room
          		me->move(ob);
          		else ob->move(me); //item
          		}
          }
		if( reward )
		{
		reward = reward * (int)me->query("reward_rate")/100;
		if( reward <= 0 )  reward = 1;
		me->add("potential",reward/10);
		me->add("combat_exp",reward);
		}
           call_out("destructobj",1,this_object());
         }
         return 1;
	}
	else
	message_vision("$n无奈说道：你问的我不知道。\n", me, target);
	return 1;
}

//lookfor_msg 为寻找时提示信息,lookfor_name指定的寻找的room 短名 
//lookfor_name 则为动作对象要与输入的动作对象名相等,lookfor_file为后续物件
//dolookfor me player 对象 envir 环境对象
int dolookfor(object me,object envir) {return 0;}
int do_lookfor(string arg)
{
        object me,envir,ob;
	string lookfor_msg, lookfor_envir,lookfor_name, lookfor_file, reply_msg;
	int reward;
	reward = (int)this_object()->query("quest_reward");
	me = this_player();
	if( !arg )
	    return notify_fail("什么！\n");
        seteuid( geteuid(me) );
        envir=environment(me);
	lookfor_name = this_object()->query("lockfor_name");
        lookfor_envir = this_object()->query("lockfor_envir");
	lookfor_msg = this_object()->query("lookfor_msg");
	lookfor_file = this_object()->query("lookfor_file");
//	reply_msg = this_object()->query("reply_msg");

//	if(!lookfor_msg) lookfor_msg="什么？\n";
//	if(!reply_msg) reply_msg="\n";

	if( (lookfor_envir == envir->query("short")) && (lookfor_name==arg) ){
         if (! dolookfor(me,envir)) {
          if (lookfor_msg) tell_object(me,lookfor_msg);
          if (lookfor_file){ 
           ob=new(lookfor_file);
          	if (ob) {
          		if (ob->query_max_encumbrance()==100000000000) //room
          		me->move(ob);
          		else ob->move(me); //item
          		}
          }
		if( reward )
		{
		reward = reward * (int)me->query("reward_rate")/100;
		if( reward <= 0 )  reward = 1;
		me->add("potential",reward/10);
		me->add("combat_exp",reward);
		}
           call_out("destructobj",1,this_object());
         }
	 return 1;
	}
	else
	tell_object(me,"这里没有什么你感兴趣的。\n");
	return 1;
}

// cure_msg 为动作提示内容，cure_name 动作的对象中文名
//cure_type 为治疗种类现为治病疗毒&疗伤 cure_lvl 为动作效率整数，cure_file 后续物件
int docure(object me,object targer,string c_type,int c_lvl) {return 0;}
int do_cures(string arg)
{
        object me,target,ob;
	string cure_msg, cure_name,cure_type,cure_file;
        int cure_lvl;
	int reward;
	reward = (int)this_object()->query("quest_reward");
	me = this_player();
	if( !arg )
		return notify_fail("你想治疗谁？\n");
        seteuid( geteuid(me) );

	target = present(arg, environment(me));
	if( !target )
		return notify_fail("你想治疗谁？\n");
	if( target->is_corpse() )
		return notify_fail("你不能治疗尸体。\n");
	if( userp(target) && (object)target->query_temp("pending/fight")!=me ) 
		return notify_fail("你不能治疗那个人。\n");

	cure_name = this_object()->query("cure_name");
	cure_msg = this_object()->query("cure_msg");
	cure_file = this_object()->query("cure_file");
        cure_type = this_object()->query("cure_type");        
        cure_lvl = (int) this_object()->query("cure_lvl");
	if(!cure_msg) cure_msg="什么？\n";
        if( target->query("name") == cure_name){
        if (! docure(me,target,cure_type,cure_lvl)) {
          if (cure_msg) {message_vision(cure_msg, me, target);}
	  if (cure_type=="治病疗毒") {target->clear_condition();} //也可以根据cure_lvl值降低一些dur
	  if (cure_type=="疗伤") {
                target->receive_curing("kee",cure_lvl);
		target->receive_curing("gin",cure_lvl);
		target->receive_curing("sen",cure_lvl);
          }
          if (cure_file) {
           ob=new(cure_file);
          	if (ob) {
          		if (ob->query_max_encumbrance()==100000000000) //room
          		me->move(ob);
          		else ob->move(me); //item
          		}
          }
		if( reward )
		{
		reward = reward * (int)me->query("reward_rate")/100;
		if( reward <= 0 )  reward = 1;
		me->add("potential",reward/10);
		me->add("combat_exp",reward);
		}
           call_out("destructobj",1,this_object());
         }
         return 1;
	}
	else
	message_vision("$n叹口气说：你不行的。\n", me, target);
	return 1;
}

//climb_msg 动作显示内容，climb_envir 为动作特定的room
//climb_name 动作的对象名字,climb_file 后续物件
int doclimb(object me,object envir,string room) {return 0;}
int do_climb(string arg)
{
        object me,envir,ob;
	string climb_msg, climb_name, climb_file,climb_envir;
	int reward;
	reward = (int)this_object()->query("quest_reward");
	if( !arg )
	    return notify_fail("什么！\n");
	me = this_player();
        seteuid( geteuid(me) );
        envir=environment(me);
	climb_name = this_object()->query("climb_name");
        climb_envir = this_object()->query("climb_envir"); 
	climb_msg = this_object()->query("climb_msg");
	climb_file = this_object()->query("climb_file");
	if( (climb_envir == envir->query("short")) && (climb_name==arg) ){
         if (! doclimb(me,envir,climb_file)) {
          if (climb_msg) tell_object(me,climb_msg);
          if (climb_file){ 
             me->move(climb_file);
            };
         }
	 return 1;
	}
	else
	tell_object(me,"什么。\n");
	return 1;
}
//msg 为动作提示内容，name 动作对象的名字，envir 指定的场所，file 后续物件 
//act 说明后续物件为npc,item,room之一
int dopushpull(object me,object envir,string roomitem) {return 0;}
int do_pushpull(string arg)
{
        object me,envir,ob;
	string pushpull_msg, pushpull_name, pushpull_file,pushpull_envir,pushpull_act;
	int reward;
	reward = (int)this_object()->query("quest_reward");
	me = this_player();
	if( !arg )
	    return notify_fail("什么！\n");
        seteuid( geteuid(me) );

        envir=environment(me);
	pushpull_name = this_object()->query("pushpull_name");
        pushpull_envir = this_object()->query("pushpull_envir"); 
	pushpull_msg = this_object()->query("pushpull_msg");
        pushpull_act = this_object()->query("pushpull_act");
	pushpull_file = this_object()->query("pushpull_file");
	if( (pushpull_envir == envir->query("short")) && (pushpull_name==arg) ){
         if (! dopushpull(me,envir,pushpull_file)) {
           if (pushpull_msg) tell_object(me,pushpull_msg);
           if (pushpull_act=="move") {
            if (pushpull_file) { me->move(pushpull_file); };
            return 1;
           }  
           if (pushpull_act=="item") {
            if (pushpull_file){ ob=new(pushpull_file); if (ob) ob->move(me); };
            return 1;
           }
           if (pushpull_act=="npc") {
            if (pushpull_file){ ob=new(pushpull_file); if (ob) ob->move(envir); };
            return 1;
           }
         }
	 return 1;
	}
	else
	tell_object(me,"什么。\n");
	return 1;
}

//msg 动作提示内容，envir 动作所发生的room,name 动作对象
//后续比较复杂，无缺省动作，需要在物件中加载doturn
int doturn(object me,object envir,string name) {return 0;}
int do_turn(string arg)
{
        object me,envir,ob;
	string turn_msg, turn_name,turn_envir;
	int reward;
	reward = (int)this_object()->query("quest_reward");

	me = this_player();
	if( !arg )
	    return notify_fail("什么！\n");
        seteuid( geteuid(me) );

        envir=environment(me);
	turn_name = this_object()->query("turn_name");
        turn_envir = this_object()->query("turn_envir"); 
	turn_msg = this_object()->query("turn_msg");
	if( (turn_envir == envir->query("short")) && (turn_name==arg) ){
         return doturn(me,envir,turn_name); //后续比较复杂，无缺省动作，需要在物件中加载doturn
         }
	else
	tell_object(me,"什么。\n");
	return 1;
}

//msg 动作提示的内容，name 动作对象,file 后续物件 envir 动作应该的场所
int douse(object me,object envir,string name) {return 0;}
int do_use(string arg)
{
        object me,envir,ob;
	string use_msg, use_name,use_envir,use_file;
	int reward;
	reward = (int)this_object()->query("quest_reward");

	me = this_player();
	if( !arg )
	    return notify_fail("什么！\n");
        seteuid( geteuid(me) );

        envir=environment(me);
	use_name = this_object()->query("use_name");
        use_envir = this_object()->query("use_envir"); 
	use_msg = this_object()->query("use_msg");
	use_file = this_object()->query("use_file");
	if( (use_envir == envir->query("short")) && (use_name==arg) ){
         if (! douse(me,envir,use_file)) {
          if (use_msg) tell_object(me,use_msg);
          if (use_file){ 
          	ob=new(use_file);
          	if (ob) {
          		if (ob->query_max_encumbrance()==100000000000) //room
          		me->move(ob);
          		else ob->move(me); //item
          		}
          }
		if( reward )
		{
		reward = reward * (int)me->query("reward_rate")/100;
		if( reward <= 0 )  reward = 1;
		me->add("potential",reward/10);
		me->add("combat_exp",reward);
		}
           call_out("destructobj",1,this_object());
          }
          return 1;
        }
	else
	tell_object(me,"什么。\n");
	return 1;
}

//msg 动作提示的内容 name 动作对象的中文名字 file 后续物件
int dogive(object me,object targer) {return 0;}
int do_give(string arg)
{
        object me,target,ob;
	string give_msg, give_name, give_file,reply_msg;
	int reward;
	reward = (int)this_object()->query("quest_reward");

	me = this_player();
	if( !arg )
		return notify_fail("你想与谁交流？\n");
        seteuid( geteuid(me) );

      if (environment(me)->query("hell"))
	return notify_fail("这里无法与别人交流。\n");
	target = present(arg, environment(me));
	if( !target )
		return notify_fail("你想与谁交流？\n");
	if( !target->is_character() || target->is_corpse() )
		return notify_fail("你只能与人交流。\n");
	if( userp(target) &&         (object)target->query_temp("pending/fight")!=me ) 
		return notify_fail("你没有必要与那个人交流。\n");

	give_name = this_object()->query("give_name");
	give_msg = this_object()->query("give_msg");
	give_file = this_object()->query("give_file");
	reply_msg = this_object()->query("reply_msg");
	if(!give_msg) return notify_fail("什么？\n");
	if(!give_name) return notify_fail("什么？\n");
	if(!reply_msg) reply_msg="\n";

        if( target->query("name") == give_name){
        if (! dogive(me,target)) {
          message_vision(give_msg, me, target);
          message_vision(reply_msg, target, me);
          if (give_file) {
           ob=new(give_file);
          	if (ob) {
          		if (ob->query_max_encumbrance()==100000000000) //room
          		me->move(ob);
          		else ob->move(me); //item
          		}
          }
		if( reward )
		{
		reward = reward * (int)me->query("reward_rate")/100;
		if( reward <= 0 )  reward = 1;
		me->add("potential",reward/10);
		me->add("combat_exp",reward);
		}
           call_out("destructobj",1,this_object());
         }
         return 1;
	}
	else
	message_vision("$n无奈说道：我不知道。\n", me, target);
	return 1;
}

//msg 动作提示的内容，name 动作对象 动作如 take book from stone name="book from stone"
//file 后续物件 envir 动作应该的场所
int dotake(object me,object envir,string name) {return 0;}
int do_take(string arg)
{
        object me,envir,ob;
	string take_msg, take_name,take_envir,take_file;
	int reward;
	reward = (int)this_object()->query("quest_reward");
	me = this_player();
	if( !arg )
	    return notify_fail("什么！\n");
        seteuid( geteuid(me) );

        envir=environment(me);
	take_name = this_object()->query("take_name");
        take_envir = this_object()->query("take_envir"); 
	take_msg = this_object()->query("take_msg");
	take_file = this_object()->query("take_file");
	if( (take_envir == envir->query("short")) && (take_name==arg) ){
         if (! dotake(me,envir,take_file)) {
          if (take_msg) tell_object(me,take_msg);
          if (take_file){ 
          	ob=new(take_file);
          	if (ob) {
          		if (ob->query_max_encumbrance()==100000000000) //room
          		me->move(ob);
          		else ob->move(me); //item
          		}
          }
		if( reward )
		{
		reward = reward * (int)me->query("reward_rate")/100;
		if( reward <= 0 )  reward = 1;
		me->add("potential",reward/10);
		me->add("combat_exp",reward);
		}
           call_out("destructobj",1,this_object());
          }
          return 1;
        }
	else
	tell_object(me,"什么。\n");
	return 1;
}
