// matong.c 

inherit ITEM;

void create()
{
	set_name("马桶", ({ "matong" }) );
	set_weight(800);
	set_max_encumbrance(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "这是一个少室山竹子做的铁箍马桶，外刷桐油，坚固耐用。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }
