#include <ansi.h>
inherit ITEM;
void create()
{
	set_name("二胡琴", ({ "erhu", "er hu", "二胡琴" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("value", 1);
		set("material", "wood");
		set("long", "一个古色古香的二胡琴。\n");
	}
	setup();
}

void init()
{
   	add_action("do_play","play");
   	add_action("do_show","show");
}

int do_play(string arg)
{
   	object me;
   	me = this_player();
   	if (!arg || arg != "erhu") {
      		tell_object(me, "你要做什么。\n");
      		return 1;
   	}
   	if (me->query("id")=="darks"){
   		message_vision("$N眼中露出落寂的神情，二胡扬起幽怨的琴声，带着深深的思念。\n",me);
   	}else message_vision("$N一拉二胡琴，立时响起了一阵幽怨的琴声。\n",me);
   	return 1;
}

int do_show()
{
   	object me,ob;
   	mapping ob_list;
   	string *path,*list,err,arg;
   	int i,j;
   	me = this_player();
	arg="/daemon/skill";
   	if (!arg) {
      		tell_object(me, "你要做什么。\n");
      		return 1;
   	}
   	message_vision("$N一拉二胡琴，立时响起了一阵幽怨的琴声。\n",me);
   	if( file_size(arg)==-2 && arg[strlen(arg)-1] != '/' ) arg += "/";       //判定为目录
   	path = get_dir(arg+"*.lpc");
   	if( !sizeof(path) ){
   		if (file_size(arg) == -2) return notify_fail("目录是空的。\n");
		else return notify_fail("没有这个目录。\n");
	}
	//开始log
	for(i=0; i< sizeof(path); i++){
		if (i==0) log_file("SKILL_LOG", sprintf("\n\n%30s  %50s  %25s  %40s\n\n","["+arg+"]    技能名称","技能文件名","有效等级","绝招目录"));
		if (file_size(arg + path[i])==-2) continue;
		if (!objectp(ob = find_object( arg + path[i] ))){
			err = catch( call_other(arg + path[i] , "???") );
        		if (err) {
        			log_file("SKILL_LOG", sprintf("\n%s有编译错误！！\n", arg + path[i] ));
        			continue;
        		}
			else ob = load_object( arg + path[i] );
		}
/*
		ob_list = ob;  //取出房间的物品
		if( !mapp(ob_list) ) continue;
		list = keys(ob_list);		//物品文件名
		for (j=0; j<sizeof(list);j++){
			if (list[j]->is_character())   //ok. its npc. let us write it down.
*/
				log_file("SKILL_LOG", sprintf("%30s  %50s  %25s  %40s\n",arg + path[i]->skill_cname(),arg + path[i],arg + path[i]->effective_level(),arg + path[i]));
//			else continue;
//		}
	}
   	return 1;
}
