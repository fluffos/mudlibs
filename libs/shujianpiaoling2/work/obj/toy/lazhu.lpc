// item: /obj/toy/fire.c
// baiwt@sjpl 3/17/2001
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("蜡烛", ({"lazhu", "fire"}));
        set_weight(80);
        if (clonep())
                set_default_object(__FILE__);
        else {
         set("long", "这是一支用于照明的蜡烛，到了黑暗的地方就用(use)得着了。\n");
                set("unit", "支");
                set("value", 500);
                set("lightness", 10);
        }
	setup();
}

void init()
{
   	add_action("do_use","use");
}
int do_use(string arg)
{
   	object me;
   	me = this_player();
   	if (!arg || arg != "lazhu") {
      		tell_object(me, "你要用什么？\n");
      		return 1;
   	}
	if( this_object()->query("lightness")<=0 ) {
      		tell_object(me, "这支蜡烛已经用完了。\n");
      		return 1;
   	}
   	message_vision(HIY"$N点亮了蜡烛，四周立时亮了起来。\n"NOR,me);
	environment(me)->set("use_lighting",uptime());
	me->set_temp("use_fire_time",uptime());
	this_object()->add("lightness",-1);
   	return 1;
}
