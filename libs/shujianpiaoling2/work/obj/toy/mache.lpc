// /obj/toy/mache.c
#include <ansi.h>
inherit NPC;
int do_detect(object me);
mapping default_dirs = ([
	"north":		"北",
	"south":		"南",
	"east":			"东",
	"west":			"西",
	"northup":		"北边",
	"southup":		"南边",
	"eastup":		"东边",
	"westup":		"西边",
	"northdown":	"北边",
	"southdown":	"南边",
	"eastdown":		"东边",
	"westdown":		"西边",
	"northeast":	"东北",
	"northwest":	"西北",
	"southeast":	"东南",
	"southwest":	"西南",
	"up":			"上",
	"down":			"下",
	"out":			"外",
]);

void create()
{
        set("short","马车(Ma che)");
        set_name("马车", ({ "ma che" }) );
        set("attitude", "heroism");
	set("race", "野兽");
        set("pursuer", 1);
	set("str",50+random(50));
        set("long",
                "这是一辆供人乘坐的马车，由两匹马拉动前进。\n");
        set("max_kee", 10000);
        set("max_sen", 10000);
        set("max_gin", 10000);
        set("kee", 10000);
        set("sen", 10000);
        set("gin", 10000);
        set("combat_exp", 1000000);
	set("no_living",1);
	set("hell",1);
        set_skill("unarmed", 50+random(50));
        set_skill("parry", 50+random(50));
        set_skill("move", 50+random(50));
        set_skill("dodge", 50+random(50));
	set("arrive_msg","缓缓行驶了过来");

        setup();
}
void init()
{
object me=this_player();
add_action("do_look","look");
add_action("do_gogo","jiache");
add_action("do_goup","goup");
add_action("do_godown","godown");
add_action("do_lookout","lookout");

if( !me->query("wiz") )
	{
	add_action("close_cmds","drop");
	add_action("close_cmds","exercise");
	add_action("close_cmds","practice");
	add_action("close_cmds", "exert");
	add_action("close_cmds", "cast");
	add_action("close_cmds", "conjure");
	add_action("close_cmds", "burn");
	add_action("close_cmds", "perform");
	add_action("close_cmds", "study");
	add_action("close_cmds", "lian");
	add_action("close_cmds", "yun");
	add_action("close_cmds", "neiyue");
	add_action("close_cmds", "sexarray");
	add_action("close_cmds", "shijia");
	add_action("close_cmds", "transfer");
	add_action("close_cmds", "meditate");
	add_action("close_cmds", "respirate");
	}
}

int heal_up()
{
	object che=this_object();
	if( !present((string)che->query("hire_user"),environment(che)) && !first_inventory(che) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

int do_look(string arg)
{

if (arg == "ma che" )
{
write("这是一辆供人乘坐的马车，由两匹马拉动前进。\n");
write("（你可以使用goup, godown指令上下车，lookout, jiache指令驾车。）\n");
return 1;
}
return 0;
}

void die()
{
	object owner;
	say("马车哗啦啦一声散了架，变成了一堆废物。\n");
	destruct(this_object());
}

int accept_fight(object me)
{
	return notify_fail("你看花眼了吗？那是一辆车！\n");
}

int do_gogo(string arg)
{
	string dest, mout, min, dir, blk;
	object env, me,obj, player;
	mapping exit;
	me=this_object();
	player=this_player();

	if ( !player->query_temp("in_moving_room") )
			return notify_fail("什么？\n");
	if ( !arg )
	return notify_fail("你想驾车往哪个方向走？\n");

//command("go" + arg);
	env = environment(me);

	if( !mapp(exit = env->query("exits")) || undefinedp(exit[arg]) ) {
		if( query_verb()=="go" && !env->query("auto_maps") )
			return notify_fail("这个方向没有出路。\n");
		else if( env->query("auto_maps") )  return 1;
		else  return 0;
	}
	dest = exit[arg];

	if( !(obj = find_object(dest)) )
		call_other(dest, "???");
	if( !(obj = find_object(dest)) )
		return notify_fail("无法移动。\n");

	if( !env->valid_leave(me, arg) ) 
		return notify_fail("马车现在不听指挥。\n");

	if( !undefinedp(default_dirs[arg]) )
		dir = default_dirs[arg];
	else
		dir = arg;

		if( mout = me->query("leave_msg"))
		mout = "往" + dir + mout +" 。\n";
		else mout = "往" + dir + "离开。\n";
		if( min = me->query("arrive_msg"))
		min = min + " 。\n";
		else
		min = "“得得得”地行驶了过来。\n";

	if (!userp(me) && obj->query("NONPC"))
			return notify_fail("马车不可去那里。\n");

	if( !obj->query("outdoors") )
		return notify_fail("马车没有办法去那个地方。\n");

	message( "vision", me->name() + mout, environment(me), ({me}) );
	if( me->move(obj) ) {
		me->remove_all_enemy();
		message( "vision", me->name() + min, environment(me), ({me}) );
		me->set_temp("pending", 0);
		all_inventory(env)->follow_me(me, arg);
		write("你来到了"+obj->query("short")+"。\n");

		return 1;
	}

return 0;

}

int do_lookout()
{
	int i;
	string str,*dirs;
	object env, me,obj,player;
	mapping exits;

	me=this_object();
	player=this_player();

	env = environment(me);
	str = env->query("long");

	if ( !player->query_temp("in_moving_room") )
			return notify_fail("什么？\n");

	if( mapp(exits = env->query("exits")) ) {
		dirs = keys(exits);
		for(i=0; i<sizeof(dirs); i++)
			if( (int)env->query_door(dirs[i], "status") )
				dirs[i] = 0;
		dirs -= ({ 0 });
		if( sizeof(dirs)==0 )
			str += "    这里没有任何明显的出路。\n";
		else if( sizeof(dirs)==1 )
			str += "    这里唯一的出口是 " + BOLD + dirs[0] + NOR + "。\n";
		else
			str += sprintf("    这里明显的出口是 " + BOLD + "%s" + NOR + " 和 " + BOLD + "%s" + NOR + "。\n",
				implode(dirs[0..sizeof(dirs)-2], "、"), dirs[sizeof(dirs)-1]);
	}
	write(str);

return 1;
}

int do_goup(object me)
{
	object che,inv;
	me = this_player();
	che = this_object();

	if ( inv = first_inventory(che) )
{
	if( wizardp(me) )
		write("车上已经有"+inv->query("name")+"（"+inv->query("id")+"）"+"了。\n");
			return notify_fail("车上已经有人了。\n");
}
	me->set_temp("in_moving_room",1);
	me->move(che);
	message( "vision", me->name() + "上了车。\n", environment(che), ({che}) );
return 1;
}

int do_godown(object me)
{
	object che,env,inv;
	me = this_player();
	che = this_object();

	if ( !me->query_temp("in_moving_room") )
			return notify_fail("什么？\n");

	if( env = environment(che) )
	{
	me->move(env);
	me->delete_temp("in_moving_room",1);
	message( "vision", me->name() + "从车上走了下来。\n", environment(che), ({me}) );
	}
	while ( inv = first_inventory(che) )
	inv->move(env);
	message( "vision", "\n车夫扬鞭一击，马车“得得得”地离开了。\n\n", environment(che), ({che}) );
	if( me->query_temp("hire_mache") )  me->delete_temp("hire_mache");
	destruct(this_object());
return 1;
}

void leave()
{
	message("vision", NOR"\n车夫扬鞭一击，马车“得得得”地离开了。\n\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

int close_cmds(object me, string arg)
{
	write("这里不能练功和乱丢东西。\n");
	return 1;
}

