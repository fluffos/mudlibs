// lar-healpill.c

inherit ITEM;

void create()
{
	set_name("大还丹", ({ "lar-heal pill","pill" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一粒黑黑的小药丸，可以大量恢复精气神，为疗伤圣药。\n");
		set("unit", "粒");
		set("value", 800);
	}
}
void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	
	if( !this_object()->id(arg) ) return notify_fail("你要吃什麽？\n");
	if( this_player()->query_temp("block_msg/all"));
		return notify_fail("什么？\n");
        this_player()->receive_curing("kee", 100 );
        this_player()->receive_curing("gin", 100 );
        this_player()->receive_curing("sen", 100 );
        this_player()->receive_heal("kee", 100);
        this_player()->receive_heal("gin", 100);
        this_player()->receive_heal("sen", 100);

	 message_vision("$N吞下一粒" + name() + "，精神好了很多。\n", this_player());
	 destruct(this_object());
	return 1;

}

