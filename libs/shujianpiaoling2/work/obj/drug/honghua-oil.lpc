// oil.c

inherit ITEM;
void create()
{
	set_name("红花油", ({ "honghua oil","oil","honghua" }) );
	set_weight(10);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一小瓶褐色的药油，发出一种奇异的香气，使用(use)后有疗伤的作用。\n");
		set("unit", "瓶");
		set("value", 350);
		set("oil_left",5);
	}
}
void init()
{
	add_action("do_use", "use");
}

int do_use(string arg)
{
	
	if( !this_object()->id(arg) ) return notify_fail("你使用什么？\n");
	if( this_player()->query_temp("block_msg/all"));
		return notify_fail("什么？\n");
        this_player()->receive_curing("kee", 30 );
        this_player()->receive_curing("gin", 10 );
        this_player()->receive_heal("gin", 10);
        this_player()->receive_heal("kee", 30);
        add("oil_left",-1);

	 message_vision("$N拿出一个小瓷瓶，搽了一些" + name() + "在伤口上。\n", this_player());
	 if(!query("oil_left")) {
		message_vision("$N把小瓷瓶里" + name() + "用完了。\n",this_player());
		destruct(this_object()); }
	 return 1;

}

