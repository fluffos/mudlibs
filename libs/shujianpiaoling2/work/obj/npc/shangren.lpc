// farmer.c

inherit NPC;

void create()
{
	set_name("商人", ({ "shangren" }) );
	set("gender", "男性" );
	set("age", 33);
	set("long", "你看到一位做小生意的商人。\n");
	set("combat_exp", 20);
	set("attitude", "friendly");
	set("env/wimpy", 60);
	set("chat_chance_combat", 50 );
	set("chat_msg_combat", ({
		"商人叫道：杀人哪！杀人哪！\n",
		"商人叫道：有土匪哪！光天化日下打劫哪！\n",
		(: command, "surrender" :),
	}) );
	setup();
	carry_object("/obj/cloth")->wear();
	add_money("coin", 20);
}
