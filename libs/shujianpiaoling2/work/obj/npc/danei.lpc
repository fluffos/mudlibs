#include <ansi.h>

inherit NPC;
void backattack();
void create() {
  string *order = ({ "淳于", "夏候", "上官", "赫连", "澹台", "公冶", "太叔", "师空", "西门",
    "尉迟", "濮阳", "长孙", "呼延", "幕容", "钟离", "宇文", "申屠" });
  string *orderr = ({ "保家", "卫国", "江山", "社稷", "翻江",
    "捣海", "光复", "河山", "开山" });
  set_name(order[random(17)] + orderr[random(8)], ({ "body guard", "guard" }));
  set("long", "这是一位大内侍卫，位列京师十大高手之一。\n");
  set("title", YEL "御前侍卫" NOR);
  set("nickname", HIR "大内高手" NOR);
  set("attitude", "friendly");
  set("max_kee", 2000);
  set("kee", 2000);
  set("max_atman", 100);
  set("atman", 100);
  set("max_mana", 100);
  set("mana", 100);

  set("str", 60);
  set("cor", 30);
  set("cps", 25);

  set("combat_exp", 100000);
  set_skill("blade", 70);
  set_skill("parry", 70);
  set_skill("dodge", 70);
  set_skill("move", 70);
  set_skill("spring-blade", 70);
  map_skill("blade", "spring-blade");
  map_skill("parry", "spring-blade");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "blade.zhanluanma" :),
  }));

  setup();

  carry_object("/obj/cloth")->wear();
  carry_object("/obj/blade")->wield();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  if (is_fighting() && (int)this_object()->query("kee") <= 100)
    backattack();
  return ::heal_up() + 1;
}

void leave() {
  object owner;
  message("vision",
    HIB + name() + "说道：如再有变化，发哨为警！\n\n"
    +name() + "闪了闪就消失不见了。\n" NOR, environment(),
    this_object());
  if (objectp(owner = this_object()->query("possessed")))
    owner->add_temp("max_danei", -1);
  destruct(this_object());
}

void invocation(object who, int level) {
  int i;
  object *enemy;
  set_skill("blade", 70 + random(level / 2));
  set_skill("parry", 70 + random(level / 2));
  set_skill("spring-blade", 70 + random(level / 2));
  set_skill("dodge", 70 + random(level / 2));
  set_skill("move", 70 + random(level / 2));
  set("combat_exp", 700000 + random(level / 4 * level * level));
  message("vision",
    HIY + name() + "喝道：大胆贼子！竟敢犯上作乱！\n" NOR,
    environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
  set("possessed", who);
}
void backattack() {
  int i;
  object owner, *enemy;
  if (objectp(owner = this_object()->query("possessed"))) {
    enemy = this_object()->query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])) {
        owner->kill_ob(enemy[i]);
        enemy[i]->kill_ob(owner);
      }
    }

  }

}

void die() {
  object owner;
  if (objectp(owner = this_object()->query("possessed")))
    owner->add_temp("max_danei", -1);
  ::die();
}
