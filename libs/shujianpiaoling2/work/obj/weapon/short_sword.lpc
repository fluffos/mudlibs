// short_sword.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("短剑", ({ "short sword", "sword" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 200);
    set("objattrib", "short");
    set("material", "steel");
    set("long",
      "这是一把很短的短剑，可以藏在袖子里。\n");
    set("wield_msg", "$N拿出一把练剑用的$n，握在手中。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }
  init_sword(20);
  setup();
}
