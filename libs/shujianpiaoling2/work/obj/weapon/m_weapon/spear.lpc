// magic_weapon  created by Baiwt@Sjpl 07/11/1999
#include <ansi.h>

#include <weapon.h>

inherit SPEAR;

void create() {
  string *order1 = ({ "勇敢", "神圣", "荣耀", "祝福", "凯旋", "幻影", "乙木", "空冥",
    "正义", "胜利", "蟒蛇", "巨龙", "火焰", "神水", "土行", "天雷", "地狱", "太古", "追风" });
  string *order2 = ({ "战士", "武士", "上人", "王者", "圣者",
    "大师", "大士", "郎君", "侠客", "使者" });
  string *order3 = ({ "金枪", "银枪", "铜枪", "铁枪", "钩鐮枪", "火尖枪", "蛇矛",
    "长枪", "点钢枪", "木枪", "链子枪", "竹枪" });
  set_name(
    HIC + order1[random(18)] + order2[random(9)] + HIR + order3[random(11)] + NOR,
    ({ "spear" })
  );
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "这是一条看起相当普通的长枪。\n");
    set("m_ap_rank", 3);
    set("m_dp_rank", 3);
    set("value", random(3) * random(100) * 100 + 1000);
    set("material", "wood");
  }
  init_spear(random(90) + 10);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N把$n一抖，紧紧地握在手中。\n");
  set("unwield_msg", "$N松开了手中的$n。\n");

  // The setup() is required.

  setup();
}
