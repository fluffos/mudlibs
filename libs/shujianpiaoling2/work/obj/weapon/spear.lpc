// dagger.c : an example weapon

#include <weapon.h>

inherit SPEAR;

void create()
{
	set_name("木枪", ({ "spear" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "这是一条看起相当普通的木枪。\n");
		set("value", 300);
		set("material", "wood");
	}
	init_spear(20);

// These properties are optional, if you don't set them, it will use the
// default values.

        set("wield_msg", "$N把$n一抖，紧紧地握在手中。\n");
        set("unwield_msg", "$N松开了手中的$n。\n");

// The setup() is required.

	setup();
}
