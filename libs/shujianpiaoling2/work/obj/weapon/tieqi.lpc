// gangcha.c

#include <weapon.h>

inherit FORK;

void create() {
  set_name("铁旗", ({ "iron flag", "flag" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "面");
    set("value", 1000);
    set("material", "iron");
    set("long", "一面沉重的铁旗。\n");
    set("wield_msg", "$N抄起一面$n，拿在手中挥舞了一下。\n");
  }
  init_fork(25);
  setup();
}
