// gun.c

#include <ansi.h>
#include <weapon.h>

inherit HAMMER;

void init()
{
        add_action("do_aim","aim");
        add_action("do_shoot","shoot");
}

void create()
{
	set_name("雷火珠", ({ "boom" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("bullet", 1);
		set("guanfu/objattrib", 5);
		set("value", 0);
		set("material", "steel");
	       set("no_drop", 1);
		set("long", "这是一个装有雷火珠的黑匣子。\n");
		set("wield_msg", "$N从怀中掏出一只$n藏在手中。\n");
		set("unequip_msg", "$N将手中的$n放回怀中。\n");
	}
        init_hammer(10);
	setup();
}

int do_aim(string arg)
{
	object me, obj;
	
	me = this_player();

	if( !arg )
		return notify_fail("你想对付谁？\n");
	if( environment(me)->query("no_fight") && me->query("daode") < 100 )
		return notify_fail("这里不准战斗。\n");
        if( me->query_temp("sleeping") ) return 
		notify_fail("你正在睡眠中。\n");

	if( this_object()->query("bullet") <=0)
		return notify_fail("雷火珠已经打光了。\n");

	if(!objectp(obj = present(arg, environment(me))))
		return notify_fail("这里没有这个人。\n");

	if( !obj->is_character() || obj->is_corpse() )
		return notify_fail("看清楚一点，那并不是活物。\n");

	if(obj == me)
		return notify_fail("用 suicide 指令会比较快:P。\n");

	message_vision(HIY "\n$N举起黑匣子，暗暗地瞄准$n，接着「咔」地一声，打开了发射孔。\n\n" NOR, 
			me, obj);

	this_object()->set_temp("target", arg);
	if ( !obj->query_delay() )
	obj->set_delay(3);

	return 1;
}

int do_shoot()
{
	object me, obj;
	string arg;
	int dmp;
	me = this_player();
	if( environment(me)->query("no_arrest") )
		return notify_fail("这里不准战斗。\n");
        if( me->query_temp("sleeping") ) return 
		notify_fail("你正在睡眠中。\n");

	if( environment(me)->query("no_fight") && me->query("daode") < 100 )
		return notify_fail("这里不准战斗。\n");

	if( !(arg = this_object()->query_temp("target")) ) 
		return notify_fail("你还没有瞄准你的射击目标！\n");

	if( !objectp(obj = present(arg, environment(me)) ))
		return notify_fail("你要射击的对象已经离开了。\n");

	message_vision(HIR "\n$N对准$n按动了黑匣子！！！\n只听「轰」地一声巨响，硝烟弥漫，$n惨叫一声，顿时满身鲜血！\n\n" NOR,
			me, obj);
	this_object()->add("bullet", -1);
	if( userp(obj) && obj->query("eff_kee") > 300 )
	{
	obj->set("eff_kee", random(300));
	dmp=obj->query("eff_kee");
	obj->set("kee", dmp);
	}
	else 
	obj->receive_wound("kee", random(200)+100);
	this_object()->delete_temp("target");
	if ( obj )
	{
	obj->kill_ob(me);
	if ( !obj->query_wait() )
	obj->set_wait(2);
	}

	return 1;
}

