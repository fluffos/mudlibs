// 青城派情节设计物件
inherit Q_ITEM;

void create()
{
	set_name("青城派信物", ({ "xinwu" }) );
	set_weight(300);
	set("unit", "块");
	set("long",
		"这是一块神奇的铁牌，上面刻着一些云层。\n");
	set("value", 0);
	set("no_get", 1);
	set("no_drop", 1);
	set("talk_name","仁山头陀");
	set("talk_msg","$N对$n抱拳说道：请问这位大师，去东门怎么走？\n");
}

