//mojiao dizi exp 1200000	written by john darks
inherit NPC;
#include <ansi.h>
void remove_fight();
string *winner_msg = ({
  CYN "\n$N双手一拱，笑著说道：承让！\n\n" NOR,
  CYN "\n$n向後一纵，躬身做揖说道：阁下武艺不凡，果然高明！\n\n" NOR,
});
void create() {
  set_name("魔教弟子", ({ "mojiao dizi", "dizi", "魔教弟子" }));
  set("gender", "男性");
  set("age", 20);
  set("long", "一位魔教教徒\n");
  set("attitude", "peaceful");
  set("str", 40);
  set("cor", 40);
  set("agi", 40);
  set("chat_chance", 1);
  set("chat_msg", ({
    "魔教弟子低声私语：少林武学虽然博大，但比起我们魔教的藏经阁，恐怕也是有所不及。\n",
  }));
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: remove_fight :),
  }));
  set("max_sen", 3000);
  set("max_gin", 3000);
  set("max_kee", 3000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 50);
  set("combat_exp", 1500000);
  set_skill("unarmed", 150);
  set_skill("wusha-strike", 150);
  set_skill("force", 100);
  set_skill("dodge", 300);
  set_skill("yanyun-steps", 100);
  set_skill("senluo-force", 30);
  map_skill("unarmed", "wusha-strike");
  map_skill("force", "senluo-force");
  map_skill("dodge", "yanyun-steps");
  create_family("魔教", 7, "弟子");
  setup();
  carry_object("/obj/cloth")->wear();
}

//FIGHTING--------------------------------------------------------------
object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;
}

void heart_beat() {
  object me, target;
  me = this_object();
  if (me->is_fighting()) {
    target = offensive_target(me);
    if (userp(target) && !target->is_killing(me->query("id"))) {
      if (target->query("mojiao/combat_exp") < 1200000) {
        target->add("combat_exp", random(6) + 6);
        target->add("mojiao/combat_exp", 15);
      }
      if (!random(3) && target->query("mojiao/combat_exp") < 1200000)
        target->add("potential", 8);
    }
  }
  return ::heart_beat();
}

void remove_fight() {
  object me, target;
  me = this_object();
  if (me->is_fighting()) {
    target = offensive_target(me);
    message_vision(CYN "$N" + CYN "突然一闪身，欺入$n" + CYN "中宫，一掌击在$n" + CYN "胸口。\n" NOR, me, target);
    message_vision(HIR "$n" + HIR "被$N" + HIR "震得气血翻腾，大惊失色。\n" NOR, me, target);
    me->remove_killer(target);
    target->remove_killer(me);
    message_vision(winner_msg[random(sizeof(winner_msg))], me, target);
  }
}
