#include <ansi.h>
inherit NPC;
int custom();
void create()
{
        set_name("费慎", ({ "fei shen","fei" }) );
        set("gender", "男性" );
        set("age", 27);
	set("combat_exp", (random(7)+1)*100000);
	set("title","罗浮剑派");
	set("nickname",HIM"彩衣双剑"NOR);
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
		(: custom :)	
        }) );
        set("str", 70);
        set("id_type", 1);

        set("attitude", "heroism");
	set("max_force",1270);
	set("force",1226);
	set("force_factor",30);
	set("atman",731);
	set("mana",592);	
        set_skill("dodge", 90);
        set_skill("unarmed", 80);
        set_skill("parry", 100);
        set_skill("force", 100);
        set_skill("sword", 120);

        set_skill("luoying_sword",110);
        set_skill("luanyu-strike", 80);
        set_skill("xuanyue-force", 100);
        set_skill("luohua_steps", 70);

        map_skill("dodge", "luohua_steps");
        map_skill("unarmed", "luanyu-strike");
        map_skill("parry", "luoying_sword");
        map_skill("force", "xuanyue-force");
        map_skill("sword", "luoying_sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: perform_action, "sword.luohua" :),
        }) );

        setup();
        carry_object("/obj/cloth/clothw")->wear();
        carry_object("/obj/longsword")->wield();
}
int custom()
{
	int i;
	object env, *inv;
	object me=this_object();
        env = environment(me);
        inv = all_inventory(env);
	if( me->query("bellicosity") >10 )
	me->set("bellicosity",1);
        for(i=0; i<sizeof(inv); i++) {
                if( inv[i]==me ) continue;
                if( inv[i]->is_corpse() ) continue;
		if( !inv[i]->is_character()) continue;
                if( inv[i]->query("id_type")==2 ) 
                me->fight_ob(inv[i]);
        }
return 1;
}

