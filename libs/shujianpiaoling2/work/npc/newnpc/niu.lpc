#include <ansi.h>
inherit NPC;
int custom();
void create()
{
        set_name("牛乘灵", ({ "niu chengling","niu" }) );
        set("gender", "男性" );
        set("age", 39);
	set("combat_exp", (random(7)+1)*100000);
	set("title","八卦门掌门");
	set("nickname",HIR"八卦刀"NOR);
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
		(: custom :)	
        }) );
        set("str", 70);
        set("id_type", 1);

        set("attitude", "heroism");
	set("max_force",1270);
	set("force",2226);
	set("force_factor",30);
	set("atman",731);
	set("mana",592);	
        set_skill("dodge", 130);
        set_skill("unarmed", 130);
        set_skill("parry", 130);
        set_skill("force", 130);
        set_skill("blade", 130);

        set_skill("fanliangyi-dao",130);
        set_skill("wuxing-quan", 130);
        set_skill("guiyu_force", 130);
        set_skill("bagua-steps", 130);

        map_skill("dodge", "bagua-steps");
        map_skill("unarmed", "wuxing-quan");
        map_skill("parry", "fanliangyi-dao");
        map_skill("force", "guiyu_force");
        map_skill("blade", "fanliangyi-dao");
/*
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: perform_action, "dodge.tianti" :),
        }) );
*/
        setup();
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/blade")->wield();
}
int custom()
{
	int i;
	object env, *inv;
	object me=this_object();
        env = environment(me);
        inv = all_inventory(env);
	if( me->query("bellicosity") >10 )
	me->set("bellicosity",1);
        for(i=0; i<sizeof(inv); i++) {
                if( inv[i]==me ) continue;
                if( inv[i]->is_corpse() ) continue;
		if( !inv[i]->is_character()) continue;
                if( inv[i]->query("id_type")==2 ) 
                me->fight_ob(inv[i]);
        }
return 1;
}

