
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// AGENTS.md §15h: was a GBK lead-byte range check (str[0] > 160 &&
	// str[0] < 255), which never matches now that this driver indexes
	// strings by UTF-8 codepoint, not raw byte. Replaced with a CJK
	// Unified Ideographs codepoint range check. strlen bound was ">=2"
	// (>=1 full 2-byte GBK char); with per-character indexing that's
	// now ">=1" (>=1 character) -- required so the LAST character of a
	// name (checked as a length-1 substring by logind.lpc's
	// check_legal_name loop) is still recognized instead of always
	// failing the old ">=2" test.
	if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
	return 0;
}
