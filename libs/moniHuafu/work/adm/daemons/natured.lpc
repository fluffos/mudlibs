void event_night() {
  string news = read_file("/doc/help/news.txt", 1);
  object *ob = users();
  int i;
  for (i = 0; i < sizeof(ob); i++) {
    if (ob[i]->query("env/no_broadcast") == 0)
      message(
        "system",
        WHT "\n 华附广播站现在开始广播啦：\n\n" + news + "\n" WHT "今天晚上的广播就到这里，谢谢！\n" NOR,
        ob[i]
      );
  }
}

// This is called everyday dawn by update_day_phase, defined in the
// "event_fun" field in /adm/etc/nature/day_phase
void event_midnight() {
  object badguy;
  object room;
  int i = random(30);
  string get_month, get_day;
  get_day = CHINESE_D->chinese_monthday(TIME_TICK1);
  get_month = CHINESE_D->chinese_month(TIME_TICK1);

  switch (get_month) {
    // 春天花会开:)
    case "三":
    case "四":
    case "五":
      switch (random(3)) {
        case 0:
          day_phase = read_table("/adm/etc/nature/spring_rain");
          break;
        case 1:
          day_phase = read_table("/adm/etc/nature/spring_sun");
          break;
        case 2:
          day_phase = read_table("/adm/etc/nature/spring_wind");
          break;
      }
      break;
      // 夏日炎炎正好眠:)
    case "六":
    case "七":
    case "八":
      switch (random(3)) {
        case 0:
          day_phase = read_table("/adm/etc/nature/summer_rain");
          break;
        case 1:
          day_phase = read_table("/adm/etc/nature/summer_sun");
          break;
        case 2:
          day_phase = read_table("/adm/etc/nature/summer_wind");
          break;
      }
      break;
      // 秋凉请注意保暖
    case "九":
    case "十":
    case "十一":
      switch (random(3)) {
        case 0:
          day_phase = read_table("/adm/etc/nature/autumn_rain");
          break;
        case 1:
          day_phase = read_table("/adm/etc/nature/autumn_sun");
          break;
        case 2:
          day_phase = read_table("/adm/etc/nature/autumn_wind");
          break;
      }
      break;
      // 冬天，寒冷的冬天！
    case "十二":
    case "一":
    case "二":
      switch (random(3)) {
        case 0:
          day_phase = read_table("/adm/etc/nature/winter_rain");
          break;
        case 1:
          day_phase = read_table("/adm/etc/nature/winter_sun");
          break;
        case 2:
          day_phase = read_table("/adm/etc/nature/winter_wind");
          break;
      }
      break;
    default:
      day_phase = read_table("/adm/etc/nature/day_phase");
  }

  if (i >= 20) {
    if (objectp(room = load_object("/d/huafu/playgrnd1")) &&
      objectp(badguy = new("/d/huafu/npc/badguy")))
      badguy->move(room);
    badguy->ccommand("chat 今天是借钱的时候了！");
    badguy = new("/d/huafu/npc/badguy");
    badguy->move(room);
    badguy = new("/d/huafu/npc/badguy");
    badguy->move(room);
  }
  if (i >= 10 && i < 20) {
    if (objectp(room = load_object("/d/huafu/hgate")) &&
      objectp(badguy = new("/d/huafu/npc/badguy")))
      badguy->move(room);
    badguy->ccommand("chat 今天是借钱的时候了！");
    badguy = new("/d/huafu/npc/badguy");
    badguy->move(room);
  }
  if (i >= 10 && i < 10) {
    if (objectp(room = load_object("/d/huafu/zhgate")) &&
      objectp(badguy = new("/d/huafu/npc/badguy")))
      badguy->move(room);
    badguy->ccommand("chat 今天是借钱的时候了!");
    badguy = new("/d/huafu/npc/badguy");
    badguy->move(room);
    badguy = new("/d/huafu/npc/badguy");
    badguy->move(room);
  }
}
void event_sunrise() {
  object *ob_list;
  int i;
  ob_list = children("/d/huafu/npc/badguy");
  for (i = 0; i < sizeof(ob_list); i++)
    if (environment(ob_list[i])) {
      message_vision("$N叫道：糟糕，回去找老大再说！\n", ob_list[i]);
      destruct(ob_list[i]);
    }
}
void event_dawn() {
  string gb = read_file("/doc/help/hfjobs.txt", 1);
  object *ob = users();
  int i;
  for (i = 0; i < sizeof(ob); i++) {
    if (ob[i]->query("env/no_broadcast") == 0)
      message("system", WHT "\n 华附广播站现在开始广播啦：\n\n" + gb + "\n" WHT "今天早上的广播就到这里，谢谢！\n" NOR, ob[i]);
  }
}
// 由jjgod增加“华附广播站”系统。
void event_evening() {
  string gb = read_file("/doc/help/newcmds.txt", 1);
  object *ob = users();
  int i;
  for (i = 0; i < sizeof(ob); i++) {
    if (ob[i]->query("env/no_broadcast") == 0)
      message("system", WHT "\n 华附广播站现在开始广播啦：\n\n" + gb + "\n" WHT "今天傍晚的广播就到这里，谢谢！\n" NOR, ob[i]);
  }
}
void event_noon() {
  object *ob;
  int i, skill, con, con1, con2, con3;
  string get_month, ill, msg;
  get_month = CHINESE_D->chinese_month(TIME_TICK1);
  switch (get_month) {
    case "三":
    case "四":
    case "五":
      ill = "ill_kesou";
      msg = GRN + "忽然喉头一阵痕痒，你感觉似乎要咳嗽了。\n" + NOR;
      break;
    case "六":
    case "七":
    case "八":
      ill = "ill_zhongshu";
      msg = GRN + "突然你胸臆之间一阵翻腾，你中暑了。\n" + NOR;
      break;
    case "九":
    case "十":
    case "十一":
      ill = "ill_shanghan";
      msg = GRN + "陡的你打了个冷战，头昏沉沉的，你得伤寒病了。\n" + NOR;
      break;
    case "十二":
    case "一":
    case "二":
      ill = "ill_dongshang";
      msg = GRN + "你肢体末端一阵僵直，看来你被冻伤了。\n" + NOR;
      break;
  }
  if (random(2)) {
    ill = "ill_fashao"; msg = GRN + "你偶感风寒，竟而发起烧来。\n" + NOR;
  }
  ob = users();
  for (i = 0; i < sizeof(ob); i++) {
    if (!environment(ob[i])) continue;
    if (!environment(ob[i])->query("outdoors")) continue;
    if (ob[i]->query("age") == 14) continue;
    con1 = ob[i]->query("kee");
    con2 = ob[i]->query("max_kee");
    (int)con = con1 / con2 * 50;  //形成第一个生病判断条件
    con3 = ob[i]->query("force");
    con2 = ob[i]->query("max_force");
    if (con2 == 0) con2 = 1;
    (int)con1 = con3 / con2 * 50;  //形成第二个生病判断条件
    if (random(con) + random(50) + random(con1) < 25) {
      ob[i]->apply_condition(ill, 10);
      tell_object(ob[i], msg);
    }
  }

  /*	object *ob;
	int i, skill;

	ob = users();
	for(i=0; i<sizeof(ob); i++) {
		if( !environment(ob[i]) ) continue;
		if( !environment(ob[i])->query("outdoors") ) continue;
		if( !ob[i]->query("mana") ) continue;
		if( !(skill = ob[i]->query_skill("spells", 1) )) {
			tell_object(ob[i], "你觉得一阵晕眩，好像有一件什么事情忘记了。\n");
			ob[i]->set("mana", 0);
			ob[i]->receive_damage("sen", 0);
		} else if( skill < 25 ) {
			tell_object(ob[i], "正午时刻，你觉得你的记的单词开始消失了。\n");
			ob[i]->set("mana", (int)ob[i]->query("mana") * skill / 25 );
		}
	}*/
}
string outdoor_room_description() {
  return "    " + day_phase[current_day_phase]["desc_msg"] + "。\n";
}

string outdoor_room_outcolor() {
  return day_phase[current_day_phase]["outcolor"];
}

string game_time() {
  return CHINESE_D->chinese_date(TIME_TICK);
}

// This function is to read a regular type of data table for day_phase and
// etc.
mapping *read_table(string file) {
  string *line, *field, *format;
  mapping *data;
  int i, rn, fn;

  line = explode(read_file(file), "\n");
  data = ({});
  for (i = 0; i < sizeof(line); i++) {
    if (line[i] == "" || line[i][0] == '#') continue;
    if (!pointerp(field)) {
      field = explode(line[i], ":");
      continue;
    }
    if (!pointerp(format)) {
      format = explode(line[i], ":");
      continue;
    }
    break;
  }

  for (rn = 0, fn = 0; i < sizeof(line); i++) {
    if (line[i] == "" || line[i][0] == '#') continue;
    if (!fn) data += ({ allocate_mapping(sizeof(field)) });
    sscanf(line[i], format[fn], data[rn][field[fn]]);
    fn = (++fn) % sizeof(field);
    if (!fn)++ rn;
  }
  return data;
}


mapping *query_day_phase() { return day_phase; }
string room_event() { return day_phase[current_day_phase]["event_fun"]; }
