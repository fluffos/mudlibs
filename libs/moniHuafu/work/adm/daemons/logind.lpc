void logon(object ob) {
  object *usr;
  int i, wiz_cnt, ppl_cnt, login_cnt, i_user, log_num = 0, repeatlogin;
  string user_num;
  string nowip;
  if (BAN_D->is_banned(query_ip_number(ob)) ||
    BAN_D->is_banned(query_ip_number(ob))) {
    write(RED "对不起，你的IP被禁止通行，请mailto:gzjjgod@163.net陈诉。\n" NOR);
    destruct(ob);
    return;
  }
  if (random(10) > 5) cat(WELCOME);
  else cat(NEWWELCOME);
  UPTIME_CMD->main();
  // 下面是限制多ip连接
  nowip = query_ip_name(ob);
  // loopback connections are exempt from the per-IP multi-login cap below;
  // anything else (including a name/IP the driver failed to resolve) stays
  // subject to it.
  if (stringp(nowip) && (nowip == "127.0.0.1" || nowip == "localhost" ||
    nowip == "::1" || (strlen(nowip) > 3 && nowip[0..3] == "127.")))
    nowip = 0;
  usr = users();
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  repeatlogin = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (nowip && query_ip_name(usr[i]) == nowip) {
      if (repeatlogin > 2 && query_ip_name(usr[i]) != "127.0.0.1") {
        printf("对不起，同一个IP地址 (%s) 只允许连接三个用户！\n", nowip);
        destruct(ob);
        return;
      } else repeatlogin++;
    }
    if (!environment(usr[i])) login_cnt++;
    else if (wizardp(usr[i])) wiz_cnt++;
    else ppl_cnt++;
  }
  user_num = read_file(__DIR__ "users", 1);
  i_user = atoi(user_num);
  printf(WHT "访问人数：%s人次\n", chinese_number(i_user));
  i_user = i_user + 1;
  user_num = sprintf("%d", i_user);
  write_file(__DIR__ "users", user_num, 1);
  user_num = read_file(__DIR__ "iduser", 1);
  i_user = atoi(user_num);
  printf(YEL "注册人数：%s人\n", chinese_number(i_user));
  printf(BLU "目前在线：%s人\n" GRN "其中有%s位巫师、%s位玩家、及%s位正在连入者。\n\n" NOR,
    chinese_number(WHO_D->query_num()), chinese_number(wiz_cnt),
    chinese_number(ppl_cnt), chinese_number(login_cnt));

  write(WHT "您的英文名字：" NOR);
  input_to((: get_id :), ob);
}

private void get_id(string arg, object ob) {
  object ppl;
  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    write(CYN "您的英文名字：" NOR);
    input_to("get_id", ob);
    return;
  }
#ifdef MAX_USERS
  if ((string)SECURITY_D->get_status(arg) == "(player)"
    && sizeof(users()) >= MAX_USERS) {
    ppl = find_body(arg);
    if (!ppl || !interactive(ppl)) {
      write(RED "对不起，" + MUD_NAME + "的使用者已经太多了，请待会再来。\n" NOR);
      destruct(ob);
      return;
    }
  }
#endif
  // 如果出现权限错误……
  if (wiz_level(arg) < wiz_lock_level) {
    write(CYN "对不起，" + MUD_NAME + "目前正在维护之中，请稍候再连线。\n" NOR);
    destruct(ob);
    return;
  }

  if ((string)ob->set("id", arg) != arg) {
    write("Failed setting user name.\n");
    destruct(ob);
    return;
  }
  // 本来fy3中是不允许guest登录的，我现在允许了。
  if (arg == "guest") {
    // 如果是guest，每次都创建一个新的人物。（有点傻）
    confirm_id("Yes", ob);
    return;
  } else if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    if (ob->restore()) {
      write("“" BLINK CYN + arg + NOR "”这个英文名字已被使用，请输入此帐号的密码：");
      input_to("get_passwd", 1, ob);
      return;
    }
    write("您的人物储存档出了一些问题，请利用 guest 人物通知巫师处理。\n");
    destruct(ob);
    return;
  }
  if (new_user_lock) {
    write(CYN "现在模拟华附不接受新的人物，请稍候再创造新的人物。\n" NOR);
    destruct(ob);
    return;
  }
  write(CYN "使用“" BLINK WHT + (string)ob->query("id") + NOR CYN "”这个名字将会创造一个新的人物，您确定吗(y/n)？" NOR);
  input_to("confirm_id", ob);
}

private void get_passwd(string pass, object ob) {
  string my_pass;
  object user;
  write("\n");
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass) {
    write("密码错误！\n");
    log_file("ATTEMPT_LOGIN", sprintf("密码错误： %s 尝试从 %s连入失败。\n",
      ob->query("id"), query_ip_name(ob)));
    destruct(ob);
    return;
  }

  // 是否断线重连。
  user = find_body(ob->query("id"));
  if (user) {
    if (user->query_temp("netdead")) {
      reconnect(ob, user);
      return;
    }

    write(RED "您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)" NOR);
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (objectp(user = make_body(ob))) {
    if (user->restore()) {
      log_file("USAGE", sprintf("%s 由 %s连入于 (%s)\n", user->query("id"),
        query_ip_name(ob), ctime(time())));
      if (time() - (int)user->query("kickout_time") < 3600) {
        write(RED "你现在没有进入模拟华附的权利，请一小时后再联线。\n" NOR);
        destruct(user);
        destruct(ob);
        return;
      }
      enter_world(ob, user);
      return;
    } else {
      destruct(user);
    }
  }
  write(WHT "请您重新创造这个人物。\n" NOR);
  confirm_id("y", ob);
}

private void confirm_relogin(string yn, object ob, object user) {
  object old_link;

  if (yn == "") {

    write(RED "您要将另一个连线中的相同人物赶出去，取而代之吗？" WHT "(y/n)" NOR);
    input_to("confirm_relogin", ob, user);
    return;
  }
  // 如果返回的不是“y”。
  if (yn[0] != 'y' && yn[0] != 'Y') {
    write(CYN "好吧，欢迎下次再来。\n" NOR);
    destruct(ob);
    return;
  } else {
    tell_object(user, "有人从别处( " + query_ip_name(ob)
      + " )连线取代你所控制的人物。\n");
    log_file("USAGE", sprintf("%s 取代 %s (%s)\n", user->query("name"),
      query_ip_name(ob), ctime(time())));
  }

  // 把原来的ppl赶走。
  old_link = user->query_temp("link_ob");
  if (old_link) {
    exec(old_link, user);
    destruct(old_link);
  }

  reconnect(ob, user);
}

