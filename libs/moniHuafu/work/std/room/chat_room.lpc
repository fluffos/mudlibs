// chat_room.c - 聊天室
// 《侠客英雄传》 - 1997-12

#include <ansi.h>
#include <room.h>

inherit ROOM;

void setup() {
  ::setup();
}

void create() {
  set("chat_room", 1);
  // 禁止用各类法术进入聊天室
  set("restrict_enter_room", 1);
  // 禁止玩家在聊天室里使用某些命令
  set("restrict_action", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  set("no_steal", 1);
  setup();
}
