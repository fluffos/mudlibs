#/cmds/usr/news.c
dbase (["notes":({(["time":963060082,"msg":"校园公告栏制作成功！Horray!","title":"成功!","author":"阿飞(jjgod)",]),(["time":963136967,"msg":"从正门到生化楼的路途建设成功！","title":"建设手记","author":"阿飞(jjgod)",]),(["time":963205194,"msg":"生化楼后面的大操场基本建成，就差主席台了。值得庆祝！","title":"操场基本建成！","author":"阿飞(jjgod)",]),(["time":963227148,"msg":"一个下午的时间，问答系统测试版基本建设成功！(/d/huafu/elou1)","title":"问答系统测试版建设成功！","author":"阿飞(jjgod)",]),(["time":963555340,"msg":"本系统是由：1、小卖部食品饮料系统2、单车楼赚钱系统。;组成的。;同期完成的还有：1、西教学楼的拜师系统。2、图书馆读书系统。;准备开发的有：1、图书馆潜能系统。2、宿舍系统。3、饭堂系统。4、计算机游戏系统。","title":"模拟华附生态系统基本完成","author":"阿飞(jjgod)",]),(["time":963665606,"msg":"模拟华附的帮助文件基本写作成功！各位请参考 help指令。","title":"帮助文件基本完成","author":"阿飞(jjgod)",]),(["time":963671968,"msg":"今天，把很多内容，如：拜师系统，连入系统“现代化”了，还增加了一个task：叶克明的华附校规。。","title":"今日进度","author":"阿飞(jjgod)",]),(["time":963752826,"msg":"今天，新增了一个所在地图查询程序。玩家可以用maphere指令在室外查询；所在的地图位置。","title":"所在地图查询程序完成","author":"阿飞(jjgod)",]),(["time":963754577,"msg":"经过无数的艰辛和痛苦，不堪回首呀，TASK系统终于制作改良完成了！万岁！","title":"TASK系统制作完成！","author":"阿飞(jjgod)",]),(["time":963828889,"msg":"钱币金融系统已经由“文”、“两”、“银票”成功的过渡为“分”、“元”、“支票”了！基本银行商店系统的现代化也已完成。同时，今天还新增了几个TASK，包括指南针、计算器等等。还有，现在用的剑全部变成了扫帚，呵呵，安全第一嘛！","title":"钱币系统现代化完成","author":"阿飞(jjgod)",]),(["time":963841592,"msg":"三层楼的图书馆系统制作完成了，每层都有好东西呀！就看你找不找得到了！小心一点，有时会吃不了兜着走的！另外新增的化学步法，绝招永不停息的实验很好用的！","title":"图书馆完成新增化学步法","author":"阿飞(jjgod)",]),(["time":963924989,"msg":"两间的宿舍系统制作完成！可以通过睡觉恢复体力了，同期完工的还有：环校东路、饭堂。","title":"宿舍系统制作完成！","author":"阿飞(jjgod)",]),(["time":964014750,"msg":"今天没干什么事，写了一个自己的工作室，加了一些帮助文件。","title":"今天进度","author":"阿飞(jjgod)",]),(["time":964018274,"msg":"三个成绩：一、学生会完成，人人都可以当学生会主席！二、生化楼毒气系统完成，现在去生化楼变得十分危险。三、与玩家无关，改良了full指令。。","title":"三个成绩","author":"阿飞(jjgod)",]),(["time":964104870,"msg":"21层教工宿舍、沙池基本顺利的完工了。两个地方都危险重重，大家要小心啊！0-4000经验的quest系统已经完成了！新增生化楼毒气，校医室有解毒药。新增生活指导。","title":"21层教工宿舍、沙池完工！","author":"阿飞(jjgod)",]),(["time":964193597,"msg":"今天，在正门外的由邮局、小件寄存处、银行组成的校外金融系统正式完成。地图和maphere系统也作了更新。新增的中山大道危险重重，大家小心。奥校楼，由“方家葱”为主体的博彩游戏也完成了。经研究，我们决定为了避免侵犯名誉权，构成诽谤，模拟华附中的一部分人物将使用假名，如“方家葱”就是一例。","title":"校外金融奥校楼游戏完成","author":"阿飞(jjgod)",]),(["time":964279013,"msg":"模拟华附的破解迷题增加评价的系统终于完成了，一共设置了九个谜题。新增了游泳池。汉化了一些config.cfg学会了semote的修改方法。","title":"评价系统完成新增游泳池","author":"阿飞(jjgod)",]),(["time":964451775,"msg":"昨天玩暗黑2没干，今天也干得太少，只加了阶梯教室、两个校道。不过，大规模修改了combatd.c和look.c以及skills.c，基本上把武侠风格一扫而空！新增物理神功和政治刀法两种课程。","title":"干得太少","author":"阿飞(jjgod)",]),(["time":964531149,"msg":"本mud的门面：welcome文件终于制作完成了！不知大家喜不喜欢？好累！","title":"welcome完成","author":"阿飞(jjgod)",]),(["time":964595588,"authorid":"jjgod","msg":"昨天及今天中午进度昨天基本上写完了整个后门花园和法轮邪教。三个法轮邪教的技能、李洪志等等。今天从网上找了很多新东西，对整个mud系统作了一定的更新，像我现在写这篇东西就是用新的bbshelp。","title":"昨天及今天中午进度","author":"阿飞",]),(["time":964677309,"msg":"昨天完成了一个新门派法轮邪教，主要人物有李洪志、四大金刚等等。技能有法轮刀法、法轮掌法、转法轮心法、法轮步法。今天又充实了一下帮助系统。","title":"昨天完成了一个新门派","author":"阿飞(jjgod)",]),(["time":964708379,"msg":"体育馆的主体部分：篮球比赛、棋艺比赛基本完成。现在只需稍微完善一下即可。","title":"体育馆制作完成","author":"阿飞(jjgod)",]),(["time":964770562,"msg":"今天，测试第二版的所有区域终于完成了！hooray!基本上其他方面也没有太大的问题了，只需做做QC就可以打包发行了。万岁！","title":"第二版所有区域正式完成","author":"阿飞(jjgod)",]),(["time":964926615,"msg":"昨天晚上终于把topten排行榜程序做完了！而且测试了一下打包安装，CreateInstall不错，安装速度比Winzip解压快多了！","title":"TOPTEN完成","author":"阿飞(jjgod)",]),(["time":966652105,"msg":"新增了一个麦当劳餐厅，里面可以点菜，也可以做工作，确实很不错。","title":"新增麦当劳餐厅","author":"阿飞(jjgod)",]),(["time":967778546,"msg":"HTTP系统终于调试完成了，看上去很不错！。","title":"HTTP系统调试完成","author":"阿飞(palmy)",]),(["time":968573859,"authorid":"palmy","msg":"给巫师用的办公楼制作改良完成。玩家也可以去看看。","title":"办公楼制作完成","author":"阿飞",]),(["time":968846797,"msg":"WindowsNT系统下的架设测试完成，今后本游戏在学校的服务器将使用Windows2000操作系统，IT LOOKS VERY NICE!","title":"WinNT系统下架设测试完成","author":"阿飞(palmy)",]),(["time":969022751,"msg":"在附中的mud服务器正式架设成功！ip：202.104.76.202 port：3333很不错的服务器。今天在电子阅览室有不少人玩。","title":"服务器正式架设成功！","author":"阿飞(palmy)",]),(["time":969022855,"msg":"新增由借书证、校徽构成的证卡系统，在图书馆没有借书证不能借书，在校门口没有校徽不能离开！","title":"新增证卡系统","author":"阿飞(palmy)",]),(["time":969091883,"msg":"新增上次当机原因检查，每次连入皆可看到，原来每次连入时要先运行uptime.c指令的！","title":"新增上次当机原因检查","author":"阿飞(palmy)",]),(["time":969709078,"msg":"限制multilogin的技术完成，找出look的一个大bug!","title":"限制multilogin完成","author":"阿飞(palmy)",]),(["time":971505257,"msg":"模拟华附测试第三版，即最终测试版在为了适应于国际标准接轨的目标，10月14日正式开始开发，目前进展顺利。10月14日进度：新增新手军训指导以及新手奖励系统。各方面work\\zixi等的难度均衡，稳定性增加。10月15日进度：新增钓鱼工作。改进谜题系统，各方面获得的学分和潜能都有提示。改进生化楼的毒气、走廊的滑倒、无粥喂的问题等bug改进0-4000 quest改进login提示等等。.,","title":"测试第三版开发进展顺利","author":"阿飞(palmy)",]),(["time":971530039,"msg":"现在身上的钱币可以autoload。体育馆的地形大大改变，扫地的工作设计完成。钟楼每层可以扫7次，一共7层。扫完了只好等reset了。","title":"钱可以autoload完成扫地","author":"阿飞(palmy)",]),(["time":971535148,"msg":"现在每个连入游戏的人都将拥有一个文具盒，从中可以拿出尺子或圆珠笔。小卖部卖的东西也有大的改进。图书馆扩大，书籍增多，还可以在一楼买处理的过期旧书。","title":"完善图书馆书籍系统","author":"阿飞(palmy)",]),(["time":971536395,"msg":"新增了两个教室，各放了3个练功的叮当。战斗系统初步完成。不过日后还要修改combatd.c","title":"战斗系统初步完成","author":"阿飞(palmy)",]),(["time":972138035,"msg":"正式的睡觉系统完成了，以前的是用add_action的，不算。今天重新写过sleep.c指令，现在只要有sleep_room,1或有sleep bag就可以睡觉了.大家不要以为这个东西很简单，其实很复杂的。睡觉系统完成了，我也要睡觉了，呵欠！","title":"正式的睡觉完成了","author":"阿飞(palmy)",]),(["time":972193264,"msg":"大大方便玩家做quest得lookup指令终于完成，我花了很长时间终于独立完成了这段程序，本来是想向侠客英雄传巫师要的，哎，真难做不过好歹做完了，感觉上还可以，大家试试有没有bug!","title":"lookup指令终于完成","author":"阿飞(palmy)",]),(["time":972313359,"msg":"受欢乐英雄的启发，历经千辛万苦之后，list系统终于改良完成了！现在的list好看多了。本来今天计划做廖要粮的job的，没时间的。现在有几个想法，1、写杀毒job 2、写一个吴与郑的连环谜题，涉及李鼻梁3、增加job系统的互动性。迟点再作罢。","title":"list系统改良完成","author":"阿飞(palmy)",]),(["time":972472736,"msg":"华附广播站完成！但华附广播站并非一个地方，而是每天24小时滚动播出模拟华附的一个系统。廖要粮与呆呆那里的job也完成了。法轮邪教区域扩大，人物增多。拜法轮邪教须10级blade。小流氓强了很多。","title":"华附广播站完成！","author":"阿飞(palmy)",]),(["time":972744756,"msg":"        BLU \"一向零分\" NOR,BLU \"从未及格\" NOR,BLU \"很难及格\" NOR,BLU \"刚刚及格\" NOR,BLU \"六十上下\" NOR,BLU \"七十左右\" NOR,;'BLU \"快上八十\" NOR,;'BLU \"平平淡淡\" NOR,BLU \"平淡无奇\" NOR,BLU \"八十上下\" NOR,BLU \"时好时坏\" NOR,BLU \"马马虎虎\" NOR,;'BLU \"偶尔九十\" NOR,BLU \"常上九十\" NOR,BLU \"轻松九十\" NOR,WHT \"偶尔95\" NOR,WHT \"95不难\" NOR,;'WHT \"常上95\" NOR,;'WHT \"轻松95\" NOR,WHT \"鲜逢败绩\" NOR,WHT \"出类拔萃\" NOR,;'WHT \"居高临下\" NOR,;'WHT \"全班第一\" NOR,WHT \"高得出奇\" NOR,WHT \"出神入化\" NOR,;'WHT \"傲视全级\" NOR,CYN \"满分不难\" NOR,;'CYN \"轻松一百\" NOR,CYN \"超越老师\" NOR,;'CYN \"难寻对手\" NOR,CYN \"未逢对手\" NOR,CYN \"惊世骇俗\" NOR,CYN \"罕见天才\" NOR,;'CYN \"从未失败\" NOR,RED \"绝对满分\" NOR'\"很不用功\",;'\"挺不用功\",;'\"不太用功\",;'\"比较认真\",;'\"很用功\",;'\"非常用功\"'","title":"look的强度","author":"阿飞(palmy)",]),(["time":973259055,"msg":"               最新改进最近完成了法轮邪教的虚拟迷宫，与真实迷宫构成了一个庞大的迷宫群，加大了拜法轮邪教的难度。完成了task的改良，称为“测向小组任务”，需要到南楼二楼申请加入测向小组（50元）并且要购买一台测向仪（200元）才能做测向小组任务，使做task的人减少一些。完成了饭堂二楼，未满16岁的青少年可以到该处问大师傅要水和食物。","title":"最新改进","author":"阿飞(palmy)",]),(["time":973348003,"msg":"           最新想法的小部分实现最新想法就是将模拟华附分成一个一个的组织，比如文学社、奥校、测向小组、运动队等等，每个组织有自己特有的好处，比如测向小组的人才可以做task，而且，每个组织都有自己的专业学分，一般来讲，加入了一个组织就不能同时加入另一个组织，但可以退出目前的组织，但专业学分会全部清零。专业学分的作用主要是向这个学科的负责人换取一些本学科技能的等级或者一些奖励（可以慢慢想）。专业学分的获取方法就是通过本组织的一些活动，比如测向小组做成一个task加一些专业学分，而文学社则是答对几次唐诗加以点专业学分，etc.所谓“小部分实现”就是说目前物理测向小组的雏形已经基本建成了，看起来好像不是很难，但却着实耗费了我不少精力。sigh.","title":"最新想法的小部分实现","author":"阿飞(palmy)",]),(["time":974467342,"msg":"好多天没干事，不过在学校架了一个服务器。今天新增了一个新闻系统，也是属于华附广播站辖下，还挺有用的，虽然是用刀剑笑的源码，但我也改了好久。还加了一个创始时间纪年的设计。另外，人物的出生日期不再显示八字，而显示真正的现代日期。算是一个改进。","title":"新增新闻系统","author":"阿飞(palmy)",]),(["time":974991791,"msg":"     模拟华附最近更新模拟华附新增一个welcome图，原来的还保留，随机显示新的或原来的。;新增了室内跑道和沙池。可以跳远和举重。但加重量的设计还没完成。这是有关运动队的。新改动了sc2指令，改为scmore指令，基本上全部重写。新增uptime里面的创始时间和nature的四季天气。另外华附广播站的节目可以关闭收听。","title":"最近更新","author":"阿飞(palmy)",]),(["time":975139358,"msg":"校园卡系统完工，目前可以用于在任何地方购买支取自己的存款。至于如何提成以及，有校园卡又有钱的人是先用校园卡付钱还是先用现金，有待商榷。另外，重新改写了一下麦当劳餐厅的job。奖励多了些。","title":"校园卡完工","author":"阿飞(palmy)",]),(["time":976185559,"msg":"                模拟华附最终测试版最终补丁包完成模拟华附的最新补丁包包括：1、新增一个非常强大的组织——运动队，很适合玩家的练功。2、新增模拟华附人物等级系统，现在是网上提供下载版本的改良版。3、新增校园卡系统，可以在饭堂办理，此卡可以支取你在银行的存款。4、新增一个welcome、一个新闻系统、四季循环、创始纪年等系统。   此外还有不少改进。","title":"最新补丁包完成","author":"阿飞(palmy)",]),}),"no_get":1,"long":"这是华师附中的校园公告栏。用read阅读，post发表新文章。","capacity":500,"id":"newsboard","location":"/u/jjgod/workroom","board_id":"vrhfnews_b","name":"[32m校园公告栏[2;37;0m",])
