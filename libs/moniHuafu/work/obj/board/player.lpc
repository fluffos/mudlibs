// player.c

inherit BULLETIN_BOARD;
#include <ansi.h>
void create() {
  set_name(WHT "玩家交流版" NOR, ({ "board" }));
  set("location", "/u/jjgod/workroom");
  set("board_id", "player");
  set("long", "这是一个供玩家和巫师交流，提出意见的留言板。\n");
  setup();
  set("capacity", 30);
  replace_program(BULLETIN_BOARD);
}
