//juqing_b.c

inherit BULLETIN_BOARD;
#include <ansi.h>
void create() {
  set_name(GRN "校园公告栏" NOR, ({ "board" }));
  set("location", "/d/huafu/zhting");
  set("board_id", "zhting_b");
  set("long", "这是华师附中的校园公告栏。用read阅读，post发表新文章。\n");
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
