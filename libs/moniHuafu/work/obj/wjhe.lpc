#include <ansi.h>
inherit ITEM;
void create() {
  set_name("文具盒", ({ "wj case", "case" }));
  set_weight(500);
  set_max_encumbrance(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long",
      "这是一个普普通通的文具盒。你可以从它里面拿（na）或者放回（back）学习用具。\n"
      "你可以拿尺子（blade）或者圆珠笔（sword）。\n");
  }
}
int is_container() { return 1; }
void init() {
  object ob;
  add_action("do_make", "na");
  if (this_player() && environment() == this_player()) {
    set_name(this_player()->name(1) + "的文具盒", ({ "wj case" }));
  }
}

int do_make(string arg) {
  object me;
  object obj;
  me = this_player();
  if (environment() == this_player() && (int)this_player()->query("sen") > 250) {
    if (!arg) return notify_fail("你可以拿尺子（blade）或者圆珠笔（sword）。\n");
    {
      me->add("sen", -10);
      if (arg == "blade") {
        obj = new(__DIR__ "cmblade"); obj->move(me);
        write("你将手中的文具盒打开，拿出了一把尺子。\n");
      }
      if (arg == "sword") {
        obj = new(__DIR__ "cmsword"); obj->move(me);
        write("你将手中的文具盒打开，拿出了一枝圆珠笔。\n");
      }
      destruct(this_object());
    }
    return 1;
  }
  return 0;
}
