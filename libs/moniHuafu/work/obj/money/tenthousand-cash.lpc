//tenthousand-cash.c

inherit MONEY;

void create()
{
	set_name("一万元支票", ({"yiwancash", "tenthousand-cash_money", "ttcash"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "thousand-cash");
		set("long", "一张华附银行开出的值一万元人民币的支票。货币种类：tenthousand-cash\n");
		set("unit", "叠");
		set("money_id", "hundred-cash");
		set("base_value", 1000000);
		set("base_unit", "张");
		set("base_weight", 3);
	}
	set_amount(1);
}

