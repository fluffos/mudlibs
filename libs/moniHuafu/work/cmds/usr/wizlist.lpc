// wizlist.c
#include <ansi.h>

inherit F_CLEAN_UP;

mapping hoodname = ([
  "(admin)": WHT "【 天  神 】",
  "(arch)": YEL "【 总  管 】",
  "(wizard)": GRN "【 巫  师 】",
  "(apprentice)": CYN "【 学  徒 】",
  "(immortal)": RED "【 仙  人 】"
]);

int level(mixed, mixed);

int main(object me, string arg) {
  string *list, hood = "", str;
  int j = 1;

  list = sort_array(SECURITY_D->query_wizlist(), (: level :));
  str = YEL "【模拟华附】" + NOR + "目前共有" + chinese_number(sizeof(list)) + "位巫师：";
  for (int i = 0; i < sizeof(list); i++, j++) {
    if (hood != wizhood(list[i])) {
      hood = wizhood(list[i]);
      if (j % 8) str += "\n";
      str += sprintf("%-13s" NOR ": ", hoodname[hood]);
      j = 1;
    }
    if (!(j % 8)) {
      str += sprintf("%14s", "");
      j++;
    }
    str += sprintf("%-9s%s", capitalize(list[i]),
      (j % 8 == 7) ? "\n" : "");
  }
  me->start_more(str);
  return 1;
}

int level(mixed ob1, mixed ob2) {
  if (wiz_level(ob1) != wiz_level(ob2))
    return wiz_level(ob1) - wiz_level(ob2);
  return ob1 < ob2 ? -1 : 1;
}

int help(object me) {
  write(@HELP
指令格式 : wizlist

用途 : 列出目前所有的巫师名单。
HELP
  );
  return 1;
}
