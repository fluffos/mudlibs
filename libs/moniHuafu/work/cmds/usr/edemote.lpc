//谁与争锋 /cmds/usr/edemote.c
//by llm 开放给玩家，加入限制条件

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	mapping emote;
	string can;

//    if(!wizardp(me))
//        return notify_fail("文件过大，暂时停止玩家编制emote！\n");
//三种人：巫师、30岁以上500K exp普通玩家、以及巫师指定的聊天职业人以上者可以
	if(!wizardp(me)&&me->query("jobname")!="chat"&&me->query("combat_exp")<500000&&me->query("age")<30)
		return notify_fail("对不起，你现在还没有编制emote的权力。（要500K学分才能参加编写emote）\n");

    if(me->query("lock_edemote"))//由巫师发现恶意捣乱者的最轻处理
        return notify_fail("由于你胡乱编制垃圾emote，你的此类权力被永久剥夺了。\n");

	if( !arg ) return notify_fail("你要编辑什么 emote？\n");

	if( sscanf(arg, "%s %s", can,arg)==2) 
	{
		emote = EMOTE_D->query_emote(arg);
		switch(can)
		{
		case "-d":
    		if(!wizardp(me))
    		{
				if(me->query("id")!=emote["updated"]&&me->query("jobname")!="chat")
					return notify_fail("你无权删除别人编制的emote！\n");
				if(!emote["new"])
/*这是新加的参数，为兼容以前的考虑，新加的都有new，原作者可以删除，并可以EMOTE_D文件里加上判断，
有这个参数的emote不能使用：
    if(emote[verb]["new"]) return notify_fail("有此emote,但尚未通过检查，请稍候尝试。\n");
巫师也可以通过一个命令查找目前emote里含有new参数的新编条目
只有巫师通过下面的加-a参数审查通过固化后才行
*/
					return notify_fail("你无权删除经过巫师固化的emote！\n");
			}
			write("删除 emote：" + arg + "\n");
			EMOTE_D->delete_emote(arg);
			break;
		case "-p":
			if(!emote["updated"])
				return notify_fail("还没有这个emote！你可自己设计编制了。\n");
         	if(!wizardp(me)&&me->query("id")!=emote["updated"]&&me->query("jobname")!="chat")
				return notify_fail("你无权查看别人编制的emote！\n");
			printf("上次修改：%s\n", emote["updated"]);
        	printf("—————————————\n%s\n%s\n%s\n",
/*
我已经去掉了emote的另四种句式，如采取七句式的请用下句
        	printf("—————————————\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n",
*/
        		emote["others"],emote["others_self"],emote["others_target"],);
/*用七句式的还有加上下面四个
				emote["myself"],emote["myself_self"],emote["myself_target"],emote["target"],*/
			break;
		case "-a"://巫师审查emote并确认可以使用
		 	if(!wizardp(me)) return 0;
		 	if(emote == ([])) return notify_fail("这个emote不存在！\n");
		 	if(!emote["new"]) return notify_fail("这个emote已经固化了。\n");
			emote["new"] = 0;
			EMOTE_D->set_emote(arg, emote);
			write_file("/u/llm/emotetxt",sprintf("%s:\n对自己:%s\n对别人:%s\n无对象:%s\n\n",
				arg,emote["others_self"],emote["others_target"],emote["others"]) );//生成一个文本
			break;
		default:
			return notify_fail("emote请使用一个单词。\n");
		}
		return 1;
	}
    if(strlen(arg) > 10)
        return notify_fail("emote的单词不宜太长！\n");

	emote = EMOTE_D->query_emote(arg);
	if(emote["updated"])//表示这个emote已经存在
	{
		if(!wizardp(me))
		{
			if(me->query("id")!=emote["updated"])
				return notify_fail("你无权编辑别人编制的emote！\n");
			if(!emote["new"])
				return notify_fail("你无权编辑经过巫师固化的emote！\n");
		}
	 	write("\n[1m[31m你决定重新编写 "+arg+" 这个emote！(若放弃请立即输入 q后回车)[0m\n\n");
	}
	emote = ([
		"updated":geteuid(me),//作者
		"new":1,//统一加上这个参数，不让这个emote编制后立即生效
		]);
	
	write("编辑 emote：" + arg + "\n"
		"讯息可以多行，用 . 表示结束。用 q 表示放弃。\n"
		"讯息中可使用的参数有以下几种：\n"
		"  $N  自己的名字。　　　　　　　$n  使用对象的名字。\n"
		"  $P  自己的人称代词，如你他。　$p  使用对象的人称代名词，如你、她。\n"
		"  $S  对自己的称呼。　　　　　　$s  对自己的粗鲁称呼。\n"
		"  $C  对自己与对方的关系呢称。　$c  对别人与自己的关系呢称。\n"
		"  $R  对别人的尊称。　　　　　　$r  对别人的粗鲁称呼。\n"
		"————————————————————————————————————\n");
	write("不指定对象使用这个 emote 时，看到的讯息：\n->");

	input_to("get_msg_others", emote, arg);
	return 1;
}

int get_msg_others(string msg, mapping emote, string pattern)
{
	if (msg==".") 
	{
        if(strlen(emote["others"])>80&&!wizardp(this_player()))//除巫师外，只能在40个中文字内
		{
			write("单项文字不能超过40，重新输入！\n不指定对象使用这个 emote 时，看到的讯息：\n->");
			emote["others"] = "";
			input_to("get_msg_others", emote, pattern);
			return 1;
		}
		else if(strsrch(emote["others"],"$N") >= 0)//必须加入$N才能通过
		{
			write("对自己使用这个 emote 时，看到的讯息：\n->");
			input_to("get_msg_others_self", emote, pattern);
			return 1;
		}
		else
		{
			write("必须得包括“$N”这个参数，重新输入！\n不指定对象使用这个 emote 时，看到的讯息：\n->");
			emote["others"] = "";
			input_to("get_msg_others", emote, pattern);
			return 1;
		}
	}
	if (msg=="q"||msg=="Q")//增强功能，改变以往输入错误时会产生垃圾emote的弊病
	{
		EMOTE_D->delete_emote(pattern);
		return 1;
	}
	if( !undefinedp(emote["others"])&&emote["others"]!="")//如果已有，这就解决编多行emote的问题
		emote["others"] += "    "+msg + "\n";
//前面加两个中文字的空格，以防止玩家让第二行出现顶头文字，以产生类似to命令的一些弊端
	else emote["others"] = msg + "\n";
	write("->");
	input_to("get_msg_others", emote, pattern);
	return 1;
}

/*下面同上面的差不多，由于本程序只提供三种基本句式，所以下面只有两个输入函数，有兴趣
要维持原先的七个句式的，可以按照这三个函数改写原先的get_msg_myself()、get_msg_myself_self()、
get_msg_myself_target()、get_msg_target()
就是注意在这另外四种句式的函数判断中要更加注意一些类似$N的关键词的判断，有些句式里只
能出现$S$s而不能出现$N等等，相信愿意花时间与精力推敲制作七种句式的巫师应该很明白这些
道理，如果你看不懂，理解不了，那么还是老老实实地用这三种句式吧！
*/
int get_msg_others_self(string msg, mapping emote, string pattern)
{
	if (msg==".") 
	{
        if(strlen(emote["others_self"])>80&&!wizardp(this_player()))
		{
			write("单项文字不能超过40，重新输入！\n对自己使用这个 emote 时，看到的讯息：\n->");
			emote["others_self"] = "";
			input_to("get_msg_others_self", emote, pattern);
			return 1;
		}
		else if(strsrch(emote["others_self"],"$N") >= 0)
		{
			write("对别人使用这个 emote 时，看到的讯息：\n->");
			input_to("get_msg_others_target", emote, pattern);
			return 1;
		}
		else
		{
			write("必须得包括“$N”这个参数，重新输入！\n对自己使用这个 emote 时，看到的讯息：\n->");
			emote["others_self"] = "";
			input_to("get_msg_others_self", emote, pattern);
			return 1;
		}
	}
	if (msg=="q"||msg=="Q")//增强功能，改变以往输入错误时会产生垃圾emote的弊病
	{
		EMOTE_D->delete_emote(pattern);
		return 1;
	}
	if( !undefinedp(emote["others_self"])&&emote["others_self"]!="")
		emote["others_self"] += "    "+msg + "\n";
	else emote["others_self"] = msg + "\n";
	write("->");
	input_to("get_msg_others_self", emote, pattern);
	return 1;
}

int get_msg_others_target(string msg, mapping emote, string pattern)
{
	if (msg==".") 
	{
        if(strlen(emote["others_target"])>80&&!wizardp(this_player()))
		{
			write("单项文字不能超过40，重新输入\n对别人使用这个 emote 时，看到的讯息：\n->");
			emote["others_target"] = "";
			input_to("get_msg_others_target", emote, pattern);
			return 1;
		}
		else if(strsrch(emote["others_target"],"$N") >= 0
			&&strsrch(emote["others_target"],"$n") >= 0)
		{
			EMOTE_D->set_emote(pattern, emote);
			write("Emote 编辑结束。\n");
			if(!wizardp(this_player())) 
        		log_file("emote",sprintf("%s(%s) 编辑 (%s) in %s。\n",
					this_player()->name(),this_player()->query("id"),pattern,ctime(time())));
			return 1;
		}
		else
		{
			write("必须包括“$N”与“$n”参数，重新输入！\n对别人使用这个 emote 时，看到的讯息：\n->");
			emote["others_target"] = "";
			input_to("get_msg_others_target", emote, pattern);
			return 1;
		}
	}
	if (msg=="q"||msg=="Q")//增强功能，改变以往输入错误时会产生垃圾emote的弊病
	{
		EMOTE_D->delete_emote(pattern);
		return 1;
	}
	if( !undefinedp(emote["others_target"])&&emote["others_target"]!="" )
		emote["others_target"] += "    " + msg + "\n";
	else emote["others_target"] = msg + "\n";
	write("->");
	input_to("get_msg_others_target", emote, pattern);
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : edemote [-d|-p] <emote>
 
这个指令可以修改, 删除 emote 或列出其内容. 加上 -d 参数会删除
指定的 emote, -p 参数则会列出指定 emote 的内容. 列出的顺序与编
辑 emote 时相同.
 
输入 emote 讯息时有三个项目: 没有目标, 指定目标或是对自己. 若
不想有某项讯息, 则直接在空白行输入 '.' 跳过.
 
如果发现中间某行输入有误，或者不想做了可以输入 'q' 结束编制，那
么这个编制了一半emote即会被自动删除。
 
编辑 emote 时可以用以下的符号来表示:
 
$N : 自己的名字。　　　　$n : 目标的名字。
$P : 自己的人称代名词。　$p : 目标的人称代名词。
$S : 对自己的称呼。　　　$s : 对自己的粗鲁称呼。
$C : 对自己的呢称。　　　$c : 对别人的呢称。
$R : 对别人的尊称。　　　$r : 对别人的粗鲁称呼。
HELP
    );
    return 1;
}