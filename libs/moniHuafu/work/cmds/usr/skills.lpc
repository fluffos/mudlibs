// skills.c

#include <ansi.h>

inherit F_CLEAN_UP;

string *skill_level_desc = ({
  BLU "永远零分" NOR,
  BLU "从未及格" NOR,
  BLU "刚刚及格" NOR,
  BLU "七十左右" NOR,
  BLU "八十上下" NOR,
  CYN "偶尔九十" NOR,
  CYN "轻松九十" NOR,
  CYN "全班第一" NOR,
  CYN "傲视全级" NOR,
  CYN "满分不难" NOR,
  WHT "罕见天才" NOR
});

string *knowledge_level_desc = ({
  BLU "第一节课" NOR,
  BLU "很难及格" NOR,
  BLU "略识一二" NOR,
  BLU "七十左右" NOR,
  BLU "渐入佳境" NOR,
  CYN "快上八十" NOR,
  CYN "胸有成竹" NOR,
  CYN "豁然贯通" NOR,
  CYN "轻松一百" NOR,
  CYN "超越老师" NOR,
  WHT "罕见天才" NOR
});
// added by yiru: 超过100的等级评价
string *high_skill_level_desc = ({
  WHT "罕见天才" NOR,
  YEL "珍稀动物" NOR,
  RED "惊世骇俗" NOR,
  RED "超凡脱俗" NOR,
  RED "返朴归真" NOR,
});

string skill_level(string, int);

int main(object me, string arg) {
  object ob, *list, couple_ob;
  mapping skl, lrn, map;
  string *sname, *mapped, target, cardname;
  int i, marry_flag, sd, ed;
  string *tmps;

  seteuid(getuid());

  if (!arg || arg == "1" || arg == "2" || arg == "3"
    || arg == "4" || arg == "5" || arg == "6"
    || arg == "7" || arg == "8" || arg == "9" || arg == "0")
    ob = me;
  else {
    ob = present(arg, environment(me));
    //        if ( ob->query("SPSKILLS",1)  ) return ob->skills();		 
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的课程？\n");
  }
  target = (string)me->query("marry");
  if (stringp(target)) couple_ob = find_player(target);
  if (ob != me && !wizardp(me) && !ob->is_apprentice_of(me)
    && !me->is_apprentice_of(ob) && ob != couple_ob && (ob->query("possessed") != me)
    && !ob->query("skill_public"))
    return notify_fail("只有巫师或有师生关系的人能察看他人的课程。\n");

  skl = ob->query_skills();
  if (!sizeof(skl)) {
    write((ob == me ? "你" : ob->name()) + "目前并没有学习任何课程。\n");
    return 1;
  }
  write((ob == me ? "你" : ob->name()) + "目前共上过" + chinese_number(sizeof(skl)) + "种课程：\n\n");
  sname = sort_array(keys(skl), (: strcmp :));

  map = ob->query_skill_map();
  if (mapp(map)) mapped = values(map);
  if (!mapped) mapped = ({});

  lrn = ob->query_learned();
  if (!mapp(lrn)) lrn = ([]);

  if (arg == "1") {
    sd = 0; ed = 10;
  } else if (arg == "2") {
    sd = 10; ed = 20;
  } else if (arg == "3") {
    sd = 20; ed = 30;
  } else if (arg == "4") {
    sd = 30; ed = 40;
  } else if (arg == "5") {
    sd = 40; ed = 50;
  } else if (arg == "6") {
    sd = 50; ed = 60;
  } else if (arg == "7") {
    sd = 60; ed = 70;
  } else if (arg == "8") {
    sd = 70; ed = 80;
  } else if (arg == "9") {
    sd = 80; ed = 90;
  } else if (arg == "0") {
    sd = 90; ed = 100;
  } else {
    sd = 0; ed = sizeof(skl);
  }
  if (sizeof(skl) < sd) return notify_fail("你没有学过这么多课程。\n");
  printf(CYN "≡" YEL "─技能名称──技能ＩＤ────────────技能评价─等级／熟练度─" CYN "≡\n" NOR);
  for (i = sd; i < ed; i++) {
    if (i == sizeof(skl)) break;
    printf("%2d %s%s %-38s" NOR " ─ %-10s %4d ／%5d\n", i + 1,
      (lrn[sname[i]] >= (skl[sname[i]] + 1) * (skl[sname[i]] + 1)) ? MAG : "",
      (member_array(sname[i], mapped) == -1 ? "  " : CYN "★" NOR),
      to_chinese(sname[i]) + " (" + sname[i] + ")",
      skill_level(SKILL_D(sname[i])->type(), skl[sname[i]]),
      skl[sname[i]], (int)lrn[sname[i]],
    );
  }
  printf(CYN "≡" YEL "────────────────────模拟华附最终测试版──────" CYN "≡\n" NOR);
  return 1;
}

string skill_level(string type, int level) {
  int grade;

  grade = level / 10;

  if (grade >= 50) grade = 50;
  if (grade >= 10)
    return high_skill_level_desc[grade / 10 - 1];
  switch (type) {
    case "knowledge":
      if (grade >= sizeof(knowledge_level_desc))
        grade = sizeof(knowledge_level_desc) - 1;
      return knowledge_level_desc[grade];
    default:
      if (grade >= sizeof(skill_level_desc))
        grade = sizeof(skill_level_desc) - 1;
      return skill_level_desc[grade];
  }
}

string pet_skill(object ob) {
  string desc;
  object *list, couple_ob;
  mapping skl, lrn, map;
  string *sname, *mapped, target, cardname;
  int i, marry_flag;
  skl = ob->query_skills();
  if (!sizeof(skl)) {
    desc = ob->name() + "目前并没有学习任何课程。\n";
    return desc;
  }
  desc = ob->name() + "目前所上过的课程：\n\n";
  sname = sort_array(keys(skl), (: strcmp :));

  map = ob->query_skill_map();
  if (mapp(map)) mapped = values(map);
  if (!mapped) mapped = ({});

  lrn = ob->query_learned();
  if (!mapp(lrn)) lrn = ([]);

  for (i = 0; i < sizeof(skl); i++) {
    desc += sprintf("%s%s%-40s" NOR " - %-10s %3d/%5d\n",
      (lrn[sname[i]] >= (skl[sname[i]] + 1) * (skl[sname[i]] + 1)) ? MAG : "",
      (member_array(sname[i], mapped) == -1 ? "  " : "★"),
      to_chinese(sname[i]) + " (" + sname[i] + ")",
      skill_level(SKILL_D(sname[i])->type(), skl[sname[i]]),
      skl[sname[i]], (int)lrn[sname[i]],
    );
  }
  return desc + "\n";
}

int help(object me) {
  write(@HELP
指令格式 : skills [<某人>]

这个指令可以让你查询所学过的课程。

你也可以指定一个和你有师生关系的对象，用 skills 可以查知对方的课程状况。

skills 1 看从  1-10 的课程，
skills 2 看从 10-20 的课程，
依此类推。


HELP
  );
  return 1;
}
