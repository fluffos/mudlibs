// Room: /d/huafu/wlou1.c

#include <ansi.h>
void test_me(object me);
inherit ROOM;

void create()
{
	set("short", "西教学楼");
	set("long", @LONG
这里是华附高中的教学楼——西教学楼，也是大家找老师授课的地方，每天都有不
少同学在这里向老师学习知识以提高自己的水平，不过最近高中的老师都不大露面，留
下一个叫什么“熔尸红”的，让人不大放心，不过他门门功课都是二百五，水平算是很
不错的了……
LONG
	);
        set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"wroad1",
  "northeast" : __DIR__"wlang",
  "west" : __DIR__"libzixi",
  "up" : __DIR__"wlou2",
]));
	set("valid_startroom",1);
	set("objects", ([
		__DIR__"npc/rong":1 ]) );

	set("coor/x",-40);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}
void init()
{
        object me = this_player();
        if (me->query_temp("zhiri")) {
	me->set_temp("zhiri/wlou", 1);
	message_vision(WHT"$N按照校长的指示，在西教学楼逛了一圈。\n"NOR,me);}
        return;
}