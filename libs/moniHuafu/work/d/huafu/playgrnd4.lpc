// Room:/d/huafu/playgrnd4.c
// 足球场，为运动队设计
#include <ansi.h>
inherit ROOM;

string look_sign();
void finish_play(object me);
int do_start();
int do_join(string arg);
int do_prepare();

void create() {
  set("short", "足球场");
  set("long", @LONG
这里就是华师附中的足球场了，足球场虽然不错，不过为了维护场地，常常
不让学生进场踢球，最近倒还算好心，球场又开放了，不少同学正在紧张的进行
着比赛，抢不抢得到场就看你的运气了。旁边的柱子上贴着一块告示（sign）。
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([
    "east": __DIR__ "desert",
    "north": __DIR__ "qigan",
  ]));
  set("objects", ([
    __DIR__ "npc/runner": 2,
  ]));
  set("item_desc", ([
    "sign": (: look_sign :),
  ]));
  set("outdoors", "华师附中");
  set("coor/x", -60);
  set("coor/y", -60);
  set("coor/z", 0);
  setup();
}
void init() {
  object me = this_player();
  add_action("do_prepare", "prepare");
  add_action("do_join", "join");
  add_action("do_start", "start");
  if (me->query_temp("run/circle"))
    call_out("do_run", random(6), this_player());
}

string look_sign() {
  object me = this_player();
  string str, str2, *name;
  mapping starters = query("starters");
  int i;
  str = YEL "足球场踢球须知\n" NOR;
  str += "\n足球场踢球的方法：\n请召集踢球者使用“" WHT "prepare" NOR "”指令来准备开始游戏，召集玩家加入。\n";
  str += "其他人请使用“" WHT "join <id>" NOR "”指令加入你想加入的队伍。\n";
  str += "人数凑够五人时，请召集者使用“" WHT "start" NOR "”指令开始打球。\n";
  str += "打完一场球后，队伍即自动解散。\n";
  str += "假如谁想退出，离开此房间即可，召集人退出队伍即解散。\n";
  str += "篮球场是公用场地，最多允许3队同时上场。每队七人。\n";
  str2 = "";
  // 下面是显示目前正在召集球员的召集人，以免新进来的人不知道谁在召集人
  if (starters) {
    name = keys(starters);
    for (i = 0; i < sizeof(name); i++) {
      if (str2 != "") str2 += "、";
      str2 += name[i];
    }
    str += "现在正在召集成员的有：" + str2 + "。\n";
  }
  str += YEL "\n请遵守以上规章制度。\n" NOR;
  return str;
}

int do_prepare() {
  object me = this_player();
  object obj;
  if (!objectp(obj = present("football", me))) return notify_fail("你都没有足球，怎么打？\n");
  if (me->query_temp("playftb/zhaoji")) return notify_fail("你已经开始召集同学一起踢球了。\n");
  else {
    me->set_temp("playftb/zhaoji", 1);
    me->set_temp("playftb/joined", 1);
    message_vision("$N大声叫道：“踢球了！踢球了！谁来一起踢球呀？\n", me);
    add("starters", ([ me->query("id"): 1, ]));  // 在房间上加一个starters的mapping，记录召集者id
    write("你开始召集要踢球的同学。假如你不想打了，离开这个房间就可以了。\n");
    return 1;
  }
}

int do_join(string arg) {
  object me = this_player();
  object ob;
  mapping starters = query("starters");
  if (!arg) return notify_fail("你要和谁一起踢球呀？\n");
  if (!ob = present(arg, environment(me))) return notify_fail("没有这个人耶……\n");
  // 加入了一个就不能加入第二个了，假如像加入第二个时，先离开这个房间，便会自动退出原来的队伍。
  if (me->query_temp("joined")) return notify_fail("你已经加入了一个队伍，怎么能见异思迁呢？\n");
  if (!ob->query_temp("playftb/zhaoji")) return notify_fail("你想加入的那个人并不是足球活动的召集人。\n");
  if (ob->query_temp("playftb/joined") >= 7) return notify_fail("那个队已经凑够七个人了。\n");
  if (me->name() == ob->name()) return notify_fail("你自己加入自己？你神经不太正常吧？\n");
  if (me->query_temp("playftb/zhaoji")) return notify_fail("你自己就是足球活动的召集人，怎么能加入别人的队伍呢？\n");
  else {
    me->set_temp("joined", ob->query("id"));
    ob->add_temp("playftb/joined", 1);
    message_vision("$N拍拍$n的肩膀，问道：“我们一起踢好吗？”\n$n笑道：“当然好啦，欢迎欢迎！”。\n", me, ob);
    tell_object(
      ob,
      me->name() + "加入了你的队伍，现在你的队伍里有" + chinese_number(ob->query_temp("playftb/joined")) + "个人了。\n"
    );
    tell_object(
      me,
      "你加入了" + ob->name() + "的队伍，现在队伍里有" + chinese_number(ob->query_temp("playftb/joined")) + "个人了。\n"
    );
    tell_object(me, "假如你想退出现在这个队伍的话，离开这个房间就可以了。\n");
    if (ob->query_temp("playftb/joined") == 7) {
      message_vision("$N加入了$n的队伍，凑够了七个人，可以开始玩了。\n", me, ob);
      map_delete(starters, ob->query("id"));  // 删掉房间中原来的那个纪录召集者的mapping
      tell_object(ob, "你现在可以使用start指令开球。\n");
    }
    return 1;
  }
}

// 打完球了，要有奖赏，减去气血精力
void finish_play(object me) {
  int adg = random((me->query("int") + me->query("str")) / 2);
  int adp = random((me->query("spi") + me->query("agi")) / 2);
  int time = me->query("str") / 5;
  if (query("playing") > 0) { add("playing", -1); }
  // 下面都是删除有关本次打球的标记
  me->delete_temp("is_unconcious");
  me->delete_temp("disable_inputs");
  me->delete_temp("playftb");
  me->delete("disable_type");
  me->delete_temp("joined");
  // 减去精力气血
  me->receive_damage("gin", adg);
  me->receive_damage("kee", adp);
  //	write("减去精力："+adg+"点。\n");
  //	write("减去气血："+adp+"点。\n");
  me->improve_skill("unarmed", adg / 2 + time);
  me->improve_skill("parry", adp / 2 + time);
  message_vision("$N终于累得从场上下了来。\n", me);
  tell_object(me, RED "你觉得自己十分疲惫，但攻防方面有了一些进步。\n" NOR);
}

// 开始打球！
int do_start() {
  object me = this_player();
  object *ob, obj;
  int i, time;
  if (!me->query_temp("playftb/zhaoji")) return notify_fail("你都不是本次足球比赛的召集人，怎么可以开始比赛呢？\n");
  if (!objectp(obj = present("football", me))) return notify_fail("你都没有足球，怎么打？\n");  // 防止有人利用篮球多次使用
  if (me->query_temp("playftb/joined") < 7) return notify_fail("你们队还没凑够七个人，不能开始打篮球。\n");
  if (query("playing") > 3) return notify_fail("足球场里人满为患，根本无法开始踢球。\n");  // 只能3个队伍
  else {
    message_vision("$N大声叫道：“注意注意，大家注意，开始踢球了啊！”\n", me);
    add("playing", 1);  // 在房间中增加一个正在打球的队伍，假如这个数字大于3，别的队伍就不能开始打。
    me->delete_temp("playftb/joined");  // 原来计算加入人数的东西删掉
    me->set_temp("disable_inputs", 1);  // 打球要专心！
    me->set_temp("is_unconcious", 1);  // 防止打球过程中出现“<发呆中>”
    me->set("disable_type", GRN "<踢球中>" NOR);
    ob = all_inventory(environment(me));
    for (i = 0; i < sizeof(ob); i++) {
      if (ob[i]->query_temp("joined") == me->query("id")) {
        time = (ob[i]->query("str") + ob[i]->query("agi")) / 3;
        tell_object(ob[i], "你在" + me->name() + "的带领下跳下场，开始打篮球。\n");
        ob[i]->set_temp("is_unconcious", 1);
        ob[i]->set("disable_type", GRN "<篮球运动中>" NOR);
        ob[i]->set_temp("disable_inputs", 1);
        write(ob[i]->name() + "打球时间：" + time + "秒。\n");
        call_out("finish_play", time, ob[i]);
      }
    }
    time = (me->query("str") + me->query("agi")) / 3;
    tell_object(me, "你带领大家跳下场，开始打篮球。\n");
    write("你的打球时间：" + time + "秒。\n");
    call_out("finish_play", time, me);
    return 1;
  }
}

// 这里是为了防止有人召集了人，又走开了，或者有人加入了队伍，又走开了。
int valid_leave(object me, string dir) {
  string who;
  object starter, *ob;
  int i;
  mapping starters = query("starters");
  if (me->query_temp("playftb/zhaoji")) {
    message_vision(YEL "$N放弃了踢球的想法。\n" NOR, me);
    me->delete_temp("playftb");
    if (mapp(starters)) {
      map_delete(starters, me->query("id"));
    }
    ob = all_inventory(environment(me));
    for (i = 0; i < sizeof(ob); i++) {
      if (ob[i]->query_temp("joined") == me->query("id")) {
        tell_object(ob[i], "你们队的召集人" + me->name() + "放弃了踢球的想法，所以你们的队伍自动解散！\n");
        ob[i]->delete_temp("joined");
      }
    }
    return 1;
  }
  if (who = me->query_temp("joined")) starter = present(who, environment(me));
  if (starter) {
    message_vision(YEL "$N放弃了踢球的想法，退出了" + starter->name() + "的队伍。\n" NOR, me);
    starter->add_temp("playftb/joined", -1);
    tell_object(
      starter,
      "你们队的" + me->name() + "放弃了踢球的想法，所以你们的队伍现在只剩下" + chinese_number(starter->query_temp("playftb/joined")) + "个人了。\n"
    );
    me->delete_temp("joined");
    return 1;
  } else return 1;
}
void do_run(object me) {
  int i = random(me->query_skill("force") / 2);
  if (!me || environment(me) != this_object())
    return;
  tell_object(me, "你深吸一口气，奋力向前跑去……\n");
  me->receive_damage("kee", i);
  if (random(3) > 2) {
    me->improve_skill("force", i);
  }
  me->add_temp("run/circle", -1);
  me->move(__DIR__ "desert");
}
