// bank.c
// 建设银行石牌储蓄所，涉及校园卡的充值

inherit ROOM;


void create() {
  set("short", "建设银行石牌储蓄所");
  set("long", @LONG
这间外表华丽实则内部装修破烂不堪的房子就是建设银行石牌储蓄所了，除了空
调质量比隔壁好点儿，也找不到什么其他的优点了。房间中央有一个高大的柜台，差
不多比人都高了，上面挂着一张表（ｓｉｇｎ）。
[31m
                	中国建设银行石牌储蓄所
[37m
LONG
  );

  set("exits", ([
    "west": __DIR__ "youju",
  ]));
  set("item_desc", ([
    "sign": @TEXT
这里是建设银行，目前我们提供的服务有：

convert     兑换钱币。
withdraw    提取存款。
deposit     存入钱币。
balance     察寻存款。
loan	    向银行贷款。
TEXT
  ]));

  set("valid_startroom", 1);
  set("objects", ([
    __DIR__ "npc/bankofficer": 1,

  ]));


  set("coor/x", 20);
  set("coor/y", 140);
  set("coor/z", 0);
  setup();
}
