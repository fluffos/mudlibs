// An example book

inherit ITEM;

void create()
{
set_name("初中拳法入门" , ({ "unarmedbooka","book" }) );
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本介绍基本拳法的初中课本。\n");
        set("value", 20);
        set("skill", ([
                "name":                 "unarmed",      
                "exp_required": 0,       
                "sen_cost":             5,
                "difficulty":   20,  
                "max_skill":    100     
        ]) );
}
 
