// An example book

inherit ITEM;

void create() {
  set_name("初中内功入门", ({ "forcebooka", "book" }));
  set_weight(600);
  set("unit", "本");
  set("long", "这是一本介绍内功的初中课本。\n");
  set("value", 20);
  set("skill", ([
    "name": "force",
    "exp_required": 0,
    "sen_cost": 10,
    "difficulty": 20,
    "max_skill": 100
  ]));
}
