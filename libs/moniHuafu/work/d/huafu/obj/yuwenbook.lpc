// An example book

inherit ITEM;

void create()
{
	set_name("语文神拳读本" , ({ "yuwenbook","book" }) );
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本介绍语文神拳的书。\n");
        set("value", 0);
        set("skill", ([
                "name":                 "yuwen",      
                "exp_required": 20000,       
                "sen_cost":             35,
                "difficulty":   20,  
                "max_skill":    100     
        ]) );
}
 
