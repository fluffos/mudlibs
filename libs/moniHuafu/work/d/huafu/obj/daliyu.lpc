// yu.c 大鲤鱼

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("大鲤鱼", ({ "da liyu", "yu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一尾大鲤鱼，活蹦乱跳的。\n");
    set("unit", "尾");
    set("value", 10);
    set("food_remaining", 60);
    set("food_supply", 60);
  }
}
