// card.c
// 校园卡。

#include  <ansi.h>

inherit ITEM;

void create() {
  set_name("校园卡", ({ "school card", "card", "ka" }));
  set_weight(150);
  set("long", "这是一张校园卡。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("material", "plastic");
    set("value", 1500);
    set("deposit", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("amount", 30);
  }
  setup();
}
int query_autoload() { return 1; }
void init() {
  object ob;
  object me = this_player();
  if (this_player() && environment() == this_player()) {
    set_name(this_player()->name(1) + "的校园卡", ({ "school card", "card", "ka" }));
  }
  set("deposit", me->query("deposit"));
  add_action("do_look", "look");
}
int do_look(string arg) {
  object me = this_player();
  if (arg != "school card" && arg != "card" && arg != "ka") return 0;
  write("这张校园卡的编号是：" + me->query("get_time") + "。\n" +
    "这张校园卡上还有" + me->query("deposit") / 100 + "元钱。\n");
  return 1;
}
