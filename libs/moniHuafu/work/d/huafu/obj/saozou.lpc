// sword.c : an example weapon

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("扫把", ({ "broom","sao" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把看起相当普通的扫帚，好像挺沉的。\n");
		set("value", 400);
		set("material", "steel");
	}
	init_sword(25);


	set("wield_msg", "$N「唰」地一声拿出一把$n紧紧握在手中。\n");
	set("unwield_msg", "$N将手中的$n放下，背在背上。\n");


	setup();
}
