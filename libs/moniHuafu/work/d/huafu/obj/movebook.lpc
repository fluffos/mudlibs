inherit ITEM;

void create()
{
	set_name("初中轻功读本" , ({ "movebooka","book" }) );
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本介绍纵跃之术的书。\n");
        set("value", 20);
        set("skill", ([
                "name":                 "move",      
                "exp_required": 0,       
                "sen_cost":   10,
                "difficulty":   20,  
                "max_skill":    100     
        ]) );
}
 