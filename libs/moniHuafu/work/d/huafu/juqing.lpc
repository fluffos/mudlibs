// Room:/d/huafu/juqing.c
// 聚清园，最早的房间，也是最重要的房间
// 比如复活，出世，quest等等都在这里出现

inherit ROOM;
#include <room.h>
#include <ansi.h>
void create()
{
        set("short", "聚清园");
        set("long", @LONG
这里是华师附中各条校道交错相通的地方，整齐的道路在这里呈井字交叉，将碧绿
的草坪分成等大的方块，形成了一个巨大的广场。广场的中央是方园约十米的水池，池
中有尾尾金鱼在悠闲的漫游。金色的鱼鳞与碧绿的浮萍相互辉映，赏心悦目。石桥横跨
整个聚清池，池的四周是一圈巨大的石球，环绕着池水，显得很有气势。池水的上方是
一座石拱桥，石拱桥时常有同学们坐在上面读书观景。有时一些同学一不注意，就掉进
了水中，引人发笑。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"zhting",
  "south" : __DIR__"weiji",
  "east" : __DIR__"eroad1",
  "west" : __DIR__"wroad1",
  "up" : "/u/jjgod/workroom",
]));
	set("valid_startroom",1);
        set("outdoors", "华师附中");
        set("resource/water",1);
	set("liquid/name","可乐");
	set("liquid/type", "cola");
	set("liquid/drunk_apply",3);
        set("objects", ([
               __DIR__ "npc/yekeming" : 1,
       ]) );
	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
	create_door("up", "通天门", "down", DOOR_CLOSED,DOOR_LOCKED,__DIR__"obj/key");
	create_door("south", "生化楼大门", "north", DOOR_CLOSED);
}
// 值日job
void init()
{
        object me = this_player();
        add_action("do_fillwater", "fillwater");
        if (me->query_temp("zhiri")) {
	me->set_temp("zhiri/juqing", 1);
	message_vision(WHT"$N按照校长的指示，在聚清园逛了一圈。\n"NOR,me);}
        return;
}

//“灌水”

int do_fillwater(string arg)
{
        object *list, ob;
        int i, can_fillwater;
        string dir;

        if( !arg || arg=="" ) return 0;

        if( arg=="skin" || arg=="wineskin" ) {
                list = all_inventory(this_player());
                i = sizeof(list);
                can_fillwater = 0;
                while (i--) {
                  if (((string)list[i]->query("liquid/type") == "cola") || ((string)list[i]->query("liquid/type") == "water")) {
                        ob = list[i];
                        can_fillwater = 1;
                        ob->set("liquid", ([
                                "type": "water",
                                "name": "清水",
                                "remaining": 15,
                                "drunk_apply": 6,
                        ]) );
                        write("你从水池里装满了清水！ \n");
                        return 1;
                   }
                }
                if (can_fillwater ==0) {
                        write("你没有装水的东西啊....\n");
                        return 1;
                }
        }
        else {
                write("你要往什么东西里灌水？\n");
        }
        return 1;
}

