inherit ROOM;
int do_pay();
void create()
{
        set("short", "收破烂的家");
        set("long", @LONG
如果这也能算“家”的话，这恐怕就是收破烂的家了。
LONG);
        set("exits", ([
            "out" : __DIR__"tyuguan",
        ]));
        set("objects", ([
            __DIR__"npc/trashcan" : 1,
        ]));
	set("no_clean_up", 0);
        set("no_fight", "1");
        set("no_steal", "1");
        set("no_beg", "1");
        setup();
}

int valid_leave(object me, string dir)
{
    me = this_player();
    if (me->query_condition("prostitute"))
    return notify_fail("收破烂的一把抱住你：看你往哪里逃！\n");
    else  return 1;
}
