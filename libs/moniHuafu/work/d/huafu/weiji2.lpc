inherit ROOM;
#include <ansi.h>
string look_clock();
void create() {
  set("short", "生化楼二楼");
  set("long", @LONG
站在这里，往南可以一览聚清园的全部景色，往北透过窗子，就是学校的大操场，
往东去是东教学楼，西边当然是西教学楼。这里是同学们上实验课的地方。也隐隐有一
股令人感到不大舒服的气味传来，使你不由捂住了鼻子。上面挂着一个时常不准的破烂
大钟（clock）。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "northeast": __DIR__ "elou2",
    "northwest": __DIR__ "wlou2",
    "down": __DIR__ "weiji",
  ]));
  set("valid_startroom", 1);
  set("objects", ([
    __DIR__ "npc/teacher": 1,
  ]));
  set("item_desc", ([
    "clock": (: look_clock :),
  ]));
  set("coor/x", 0);
  set("coor/y", -20);
  set("coor/z", 20);
  setup();
}
int valid_leave(object me, string dir) {
  if (random(3) > 1) {
    message_vision(BLU "一阵令人觉得不大舒服的气味飘过，$N不由立刻屏住呼吸，可惜还是迟了。\n" NOR, me);
    if (!me->query_condition("fhq"))
      me->apply_condition("fhq", random(10) + 10);
    return 1;
  }
  return 1;
}
string look_clock() {
  string str = CYN "≡" YEL "─模拟华附生化楼时钟──────────────────────────" CYN "≡\n   " YEL BMAG "\t\t";
  str += RTIME_D->chinese_time(1, ctime(time()));
  str += "\t\t\n" NOR CYN "≡" YEL "──────────────────────模拟华附最终测试版─────" CYN "≡\n" NOR;
  return str;
}
