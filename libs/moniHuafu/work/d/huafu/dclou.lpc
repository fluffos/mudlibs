// Room:/d/huafu/dclou.c 单车楼
// 涉及单车楼工作，很适合新手
inherit ROOM;

void create()
{
        set("short", "单车楼");
        set("long", @LONG
这是华师附中骑车的同学每天放自行车的地方，除了上学放学时，门都是锁着的管
理自行车的是一个上了年纪的老伯，就住在这里。不过记性不大好，常常忘记开门，单
车楼的门口竖着一块黑板（ｓｉｇｎ），听说最近老伯在搞什么新举措，不知是真是假。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"whroad",
  "south" : __DIR__"whroad2",
]));
	set("valid_startroom",1);
        set("item_desc", ([
                "sign": @TEXT

现在招聘培养有志于看管自行车这项神圣职业的同学，
凡热爱自行车，热爱看自行车事业的初中高中同学皆可
报名参加工作，男女不限，16岁以下需家长同意。酬金
丰厚，1两现钱。
有兴趣者请用：ｗｏｒｋ　立即开始工作。
TEXT
        ]) );
        set("objects", ([
        __DIR__"npc/laobo" : 1,
                        ]) );
    set("no_fight", 1);
    set("no_magic", 1);
        set("coor/x",-60);
	set("coor/y",60);
	set("coor/z",0);
	setup();
        replace_program(ROOM);
}

