// 同样涉及跑步
inherit ROOM;
void create() {
  set("short", "跑道");
  set("long", @LONG
这里就是华师附中的大操场了，操场外侧是一圈400米的胶塑跑道，有不少
人在跑道上奔跑，内侧是一个巨大的足球场，不过为了维护场地，常常不让学生
进场踢球，操场两边各有一个沙池，当然是用来跳远或跳高的。操场北角是一些
单杠双杠，也有不少人在练引体向上什么的。操场正前方是一座主席台。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "playgrnd1",
    "west": __DIR__ "qigan",
    "south": __DIR__ "desert",
  ]));
  set("objects", ([
    __DIR__ "npc/runner": 3,
  ]));
  set("outdoors", "华师附中");
  set("valid_startroom", 1);
  set("coor/x", -20);
  set("coor/y", -40);
  set("coor/z", 0);
  setup();
}
void init() {
  object me = this_player();
  if (me->query_temp("run/circle"))
    call_out("do_run", 6, this_player());
}
void do_run(object me) {
  int i = random(me->query_skill("force") / 2);
  if (!me || environment(me) != this_object())
    return;
  tell_object(me, "你深吸一口气，奋力向前跑去……\n");
  me->receive_damage("kee", i);
  if (random(3) > 2) {
    me->improve_skill("move", random(me->query("agi")) / 2);
  }
  me->add_temp("run/circle", -1);
  me->move(__DIR__ "qigan");
}
