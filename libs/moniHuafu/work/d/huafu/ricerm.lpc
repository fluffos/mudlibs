
inherit ROOM;

void create()
{
        set("short", "饭堂");
        set("long", @LONG
这里就是每到早晨中午傍晚华师附中最热闹嘈杂的地方——饭堂了，每天这里
出入的学生不下几千人，自然收入也颇丰了。你的前面排了长长的一条队伍，好像
不要钱白送似的，门口立着一块牌子（sign）。
LONG
        );
        set("exits", ([
	"west" : __DIR__"elou1",
	"north" : __DIR__"nsushe",
	"south" : __DIR__"21lou",
	"up" : __DIR__"ricerm2",
        ]));
        set("item_desc",([
"sign":"校园卡系统已经完工，请同学们使用以下方法购买：
	1、办一张新的校园卡，你的存款至少要有100元，输入“newcard”
	大师傅会将你的存款存入校园卡，并按10%自动提成。
	2、给校园卡充值。请前往石牌的建设银行存入即可。\n",
]));
	set("valid_startroom",1);
        set("objects", ([
                __DIR__"npc/shifu": 1,
        ]) );
        set("coor/x",60);
        set("coor/y",0);
        set("coor/z",0);
        setup();
        replace_program(ROOM);
}

