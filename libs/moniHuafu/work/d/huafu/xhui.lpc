// Room:/d/huafu/xhui.c 正门广场
inherit ROOM;
void create()
{
        set("short", "正门广场");
        set("long", @LONG
这是华师附中正门前的广场，广场正中是一个喷水池，池中矗立着华附的校徽，一
只鸽子展翅欲飞，又像一只有五个指头的手，象征着德智体美劳全面发展。校徽下方刻
着六校合校成立华师附中的历史记忆。校徽前方是一堵大理石砌成的墙壁，墙壁朝外一
边刻着镏金的江泽民总书记在1990年视察附中时为附中的题词：以完善的现代教育培养
高素质的现代人。朝内一侧则刻着邓小平同志关于教育问题的名言：广场北面就是华附
的正门了。
[33m
                	教育要面向现代化、面向世界、面向未来。
[37m
LONG
        );
	set("valid_startroom",1);
        set("exits", ([ 
  "north" : __DIR__"zhgate",
  "south" : __DIR__"zhxd1",
  "west" : __DIR__"whroad",
  "east" : __DIR__"ehroad",
]));
        	set("outdoors", "华师附中");
	set("coor/x",0);
	set("coor/y",60);
	set("coor/z",0);
	setup();
        replace_program(ROOM);
}
