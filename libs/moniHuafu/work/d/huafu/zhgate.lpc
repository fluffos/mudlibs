inherit ROOM;
#include <ansi.h>
void timepass();
void create()
{
        set("short", "正门");
        set("long", @LONG
华师附中正门显得高大而有气势，大理石砌的外墙一边镶着“华南师范大学附
属中学”几个镏金的大字，还有华附的英文校名。门口人来人往，非常热闹，就连
传达室也显得不同凡响一些。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
  "south"   : __DIR__"xhui",
  "north"   : __DIR__"zhshdadao",
  "northup"   : __DIR__"tianqiao",
]));
	set("valid_startroom",1);
        set("objects", ([
        __DIR__"npc/kmdog": 2, 
        __DIR__"npc/trashcan": 1, 
			]) );
        set("outdoors", "华师附中");
        set("coor/x",0);
	set("coor/y",80);
	set("coor/z",0);
	setup();
	timepass();
}
void init()
{
        object me = this_player();
        if (me->query_temp("zhiri")) {
	me->set_temp("zhiri/zhgate", 1);
	message_vision(WHT"$N按照校长的指示，在正门逛了一圈。\n"NOR,me);}
        return;
}
int valid_leave(object me, string dir)
{
	object *inv;
	object ob;
	int i;
	if( userp(me))
	{
	if( dir == "south" 
	&& !random(10) && ob=present("kmdog", this_object()))
	{
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++)
		{
                        if(((string)(inv[i]->name()) == "校徽"))
                        return 1;
                }
                return notify_fail(ob->name()+"向你喝道：未戴校徽不得出入校门！\n");
		}
	        if( dir != "south"  && ob=present("kmdog", this_object()))
        {
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                {
                        if(((string)(inv[i]->name()) == "校徽"))
                        return 1;

                }
                return notify_fail(ob->name()+"向你喝道：未戴校徽不得出入校门！\n");
        }

        return 1;
	}
	else
		return 1;
}
void timepass()
{
     string time; 
     time = NATURE_D->room_event();
     switch(time) {                  
            case "event_evening":
              if(query("exits/north")&&query("exits/northup")) {
                 tell_room(this_object(), BLU"天黑了，守们保安吱呀呀的把校门关了。\n"NOR);	      
                 delete("exits/north");
                 delete("exits/northup");
                  }
              break;
            
            case "event_dawn":
              if(!query("exits/north")) {
                 tell_room(this_object(),WHT"天亮了，守们保安吱呀呀的把校门开了。\n"NOR);
                 set("exits", ([
                           "north" :   __DIR__"zhshdadao",
	           "south"   : __DIR__"xhui",
	           "north"   : __DIR__"zhshdadao",
	           "northup"   : __DIR__"tianqiao",
                              ]));
                 }
                break;               
            default:  break;	  	
        }
                   remove_call_out("timepass");        
                   call_out("timepass",240);
}