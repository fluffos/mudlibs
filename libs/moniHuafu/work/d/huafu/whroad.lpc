inherit ROOM;
void create() {
  set("short", "环校西路");
  set("long", @LONG
这条环校西路几乎使每个学生每天放学的必经之路，从前门一直到后门。在这
里是从正门前的广场一直通往单车楼的路，自然也是每个骑车回家的同学上学放学
都得路过的，人人都非常熟悉。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "xhui",
    "west": __DIR__ "dclou",
    "southeast": __DIR__ "xian",
  ]));
  set("valid_startroom", 1);
  set("objects", ([
    __DIR__ "npc/student2": 1,
  ]));

  set("outdoors", "华师附中");
  set("coor/x", -40);
  set("coor/y", 60);
  set("coor/z", 0);
  setup();
  replace_program(ROOM);
}
