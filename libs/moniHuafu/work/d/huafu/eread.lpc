// Room:/d/huafu/eread.c
// 用于放置呆呆和他的工作——杀毒。

inherit ROOM;
#include <ansi.h>
void create()
{
	set("short", "电子阅览室");
	set("long", @LONG
这里是一个拥有60台奔三450的电子阅览室，每天下午这里都有不少爱玩电
脑的同学们们，都经常聚在这里看电影，玩弹珠游戏。今天屋里又座无虚席,然
而竟然没有一个人play MUD。墙上贴着一份通告 (tonggao)，旁边的架子上摆
着一块小黑板(board).
LONG );
	set("exits", ([ 
		"down" : __DIR__"library",
	]));

       set("item_desc", ([
                "tonggao" :   
  RED "本机房郑重宣布,以下同学皆被停机一月:\n" NOR +
  RED "并罚款五十人民币,望其它同学引以为戒:\n" NOR +
  MAG "高一五班程骏(darkjail)\n" NOR +
  MAG "高二七班丁宁(crazy)\n" NOR +
  MAG "高二七班判官(pkiller)\n" NOR +
  RED ".......\n" NOR,
 "board" :   CYN "请注意,以下机器因长期被敲敲打打，已不能正常使用：\n" NOR +
  MAG "2号机，21号机，39号机，28号，........\n" NOR,
	]));

	set("valid_startroom",1);
	set("objects", ([ 
		__DIR__"npc/daidai" : 1,
	]));
	set("coor/x",-80);
	set("coor/y",0);
	set("coor/z",30);
	setup();
}

int valid_leave(object me, string dir)
{
    int i;
    object *inv;
if(dir=="up")
 {
        inv = all_inventory(me);
        for(i=sizeof(inv)-1; i>=0; i--)
		if(objectp(present("daidai", environment(me)))&&living(present("daidai", environment(me))))
                    return notify_fail("呆呆冲上前大喝一声："+
                        RANK_D->query_rude(me) + "哪里走？！\n");
	return ::valid_leave(me, dir);
 }
return ::valid_leave(me, dir);
}