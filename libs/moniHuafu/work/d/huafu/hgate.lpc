// 后门，没什么大用处
inherit ROOM;
#include <room.h>
#include <ansi.h>
void create()
{
        set("short", "华附后门");
        set("long", @LONG
后门本来倒是简陋的可怜，虽然后门一定要在早上6：30到7：30才开，上午
11：30才开，1：00就关，下午是2：10才许进，7：00关门，管得特别严，但因
为就近，所以每天上学放学的人也不少。现在学校又重建了后门，显得气派了很多，
但一个这么气派的后门只不过对着一个窄小的巷子，显得有些不伦不类。后门北面
是后门北路。
LONG
        );
	set("valid_startroom",1);
        set("exits", ([ /* sizeof() == 1 */
  "north"   : __DIR__"hnroad",
  "south"   : __DIR__"xxiang",
]));
        set("objects", ([
        __DIR__"npc/kmdog2": 2, 
        __DIR__"npc/trashcan": 1, 
			]) );
        set("outdoors", "华师附中");
        set("coor/x",20);
	set("coor/y",-100);
	set("coor/z",0);
	setup();
	create_door("south", "后门", "north", DOOR_CLOSED);
}
void init()
{
        object me = this_player();
        if (me->query_temp("zhiri")) {
	me->set_temp("zhiri/hgate", 1);
	message_vision(WHT"$N按照校长的指示，在后门逛了一圈。\n"NOR,me);}
        return;
}