inherit ROOM;

void create() {
  set("short", "中山大道");
  set("long", @LONG
除了华附校门，就来到了车水马龙的中山大道了，很多同学每天放学后都来这
里等车，这里也是通往邮局的必由之路，所以来来往往的人流很多。你要小心被车
装着。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "tianqiao",
    "south": __DIR__ "zhgate",
    "north": __DIR__ "youju",
  ]));
  set("outdoors", "华师附中");
  set("objects", ([
    __DIR__ "npc/student": 1
  ]));
  set("valid_startroom", 1);
  set("coor/x", 0);
  set("coor/y", 100);
  set("coor/z", 0);
  setup();
}
int valid_leave(object me, string dir) {
  if (random((int)me->query("kar")) < 1) {
    message_vision("一辆汽车飞驰而过，把$N撞倒在血泊中，又飞驰而去了！\n\n", me);
    this_player()->unconcious();
    return notify_fail("");
  }
  return 1;
}
