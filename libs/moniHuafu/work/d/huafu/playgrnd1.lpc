// Room:/d/huafu/playgrnd1.c
// 大操场，为运动队设计
#include <ansi.h>
inherit ROOM;
int do_run(string arg);
#define TIME_TICK1 ((time()-900000000)*60)
void create() {
  set("short", "大操场");
  set("long", @LONG
这里就是华师附中的大操场了，操场外侧是一圈400米的胶塑跑道，有不少
人在跑道上奔跑，内侧是一个巨大的足球场，不过为了维护场地，常常不让学生
进场踢球，操场两边各有一个沙池，当然是用来跳远或跳高的。操场北角是一些
单杠双杠，也有不少人在练引体向上什么的。操场正前方是一座主席台。
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([
    "east": __DIR__ "eroad3",
    "west": __DIR__ "playgrnd2",
    "north": __DIR__ "weiji",
    "southup": __DIR__ "zhuxitai",
    "south": __DIR__ "pdindoor",
  ]));
  set("objects", ([
    __DIR__ "npc/runner": 2,
  ]));
  set("outdoors", "华师附中");
  set("coor/x", 0);
  set("coor/y", -40);
  set("coor/z", 0);
  setup();
}
void init() {
  object me = this_player();
  add_action("do_run", "pao");
  add_action("do_run", "run");
  if (me->query_temp("run/circle"))
    call_out("go_on_run", random(5), this_player());
}
int do_run(string arg) {
  object me = this_player();
  int circle;
  int kee = me->query("kee");
  string get_month = CHINESE_D->chinese_month(TIME_TICK1);
  if (!arg || sscanf(
    arg,
    "%d circle",
    circle
  ) != 1) return notify_fail("请指定一个数值，比如run 10 circle。\n");
  if (circle * 10 > kee) return notify_fail("以你现在的状态，最多只能跑" + chinese_number(kee / 10 - 1) + "圈。\n");
  if (me->is_busy()) return notify_fail("你现在正忙着呢，跑什么步！\n");
  if (me->is_fighting()) return notify_fail("你正在战斗中，无法专心跑步！\n");
  if (me->query_temp("run")) return notify_fail("你现在就在跑啊，加油！\n");
  if (!living(me)) return notify_fail("你发疯了？\n");
  if (objectp(me->query_temp("weapon"))) return notify_fail("只有空手才能跑步。\n");
  if (get_month != "十一" && get_month != "十二" && get_month != "一" && me->query("guild/name") != "运动队")
    return notify_fail("现在还不是冬季，你就少跑一点，把机会留给运动队的吧。\n");
  else {
    me->set_temp("run/circle", circle * 6);
    write("你下定决心，要跑" + chinese_number(circle) + "圈。\n");
    message_vision(CYN "$N迈开步子，精神振奋的向前跑去……\n" NOR, me);
    tell_object(me, "目前你跑的是第一圈。\n");
    me->move(__DIR__ "playgrnd2");
    return 1;
  }
}
void go_on_run(object me) {
  int circle = me->query_temp("run/circle");
  int i = random(me->query_skill("force") / 2);
  int j = random(5);
  if (!me || environment(me) != this_object())
    return;
  if (circle - 1 <= 0) {
    tell_object(me, BLINK YEL "你终于坚持跑完全程！恭喜你！\n" NOR);
    me->receive_damage("kee", i * 2);
    me->improve_skill("force", i * 2);
    me->improve_skill("move", random(me->query("agi")) / 2);
    if (j >= 4) { me->add("max_kee", j); }
    me->delete_temp("run");
    return;
  } else {
    tell_object(me, "你深吸一口气，奋力向前跑去……\n");
    tell_object(me, MAG "你还剩下" + chinese_number(circle / 6) + "圈就可以跑完了！\n" NOR);
    me->receive_damage("kee", i);
    me->improve_skill("force", i);
    if (random(3) > 2) {
      me->improve_skill("move", random(me->query("agi")) / 2);
    }
    me->move(__DIR__ "playgrnd2");
    me->add_temp("run/circle", -1);
  }
}
