inherit ROOM;

void create() {
  set("short", "西走廊");
  set("long", @LONG
这里是从南楼中厅通往西教学楼的西走廊，沿着这条走廊行走，你也可以一览聚清
园的风光，走廊的南边是学生会。你若不是干部，就跟你没什么关系了。走廊的地是水
磨石的，小心会滑倒。
LONG
  );
  set("exits", ([
    "east": __DIR__ "zhting",
    "southwest": __DIR__ "wlou1",
    "south": __DIR__ "xshhui",
  ]));
  set("valid_startroom", 1);
  set("coor/x", -20);
  set("coor/y", 20);
  set("coor/z", 0);
  setup();
}
int valid_leave(object me, string dir) {
  if (random((int)me->query("kar")) < 1) {
    message_vision("$N脚下一个不稳，四脚朝天地摔在地上。然后又狼狈的爬起来。\n", me);
    this_player()->add("gin", -15);
    this_player()->add("kee", -15);
    return notify_fail("");
  }
  return 1;
}
