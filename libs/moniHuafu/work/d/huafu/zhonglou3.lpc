// Room: /d/shaolin/zhonglou1.c
#include <ansi.h>

inherit ROOM;



string look_floor();
int do_sao(string arg);


void create()
{
	set("short", "钟楼三层");
	set("long", @LONG
每个楼层上都铺设了结实的砖楼板，四角形的墙身上则开
了四扇大窗。从窗孔看，墙体也是极为厚实。从这里往外眺望，
可以看到围绕馆周的小园以及北边的小卖部。
LONG
	);

	set("exits", ([
		"west" : __DIR__"tyuguan3",
		"up" : __DIR__"zhonglou4",
		"down" : __DIR__"zhonglou2",
	]));
	set("coor/x",-50);
	set("coor/y",-20);
	set("coor/z",40);
	set("item_desc",([
		"floor"		:	(: look_floor :),
		"di"	:(: look_floor :),
		"地"		:	(: look_floor :),
		"地面"		:	(: look_floor :),
		"地板"		:	(: look_floor :),
	]));

	
	setup();
}


void init()
{
	add_action("do_sao", "sao");
}

int do_sao(string arg)
{
	object room, me;
           me=this_player();
	

	if(!arg && arg != "di" && arg!="floor")
                return notify_fail("你要扫什么？\n");
	
	if(!present("broom", me))
                return notify_fail("没扫地的家伙怎么行？\n");
      
         if((int)me->query_temp("clean_floor3")>=2){
          return notify_fail("地下已经够干净不用扫了！\n"NOR);
}
          me->add("combat_exp",3+(random(8))); 
          me->add("potential",1+(random(3)));
          
        if((int)me->query("gin") <20)
                return notify_fail(RED"你已经太累了，还是歇歇吧！\n"NOR);
        message_vision(CYN"$N挥舞着大扫帚扫起地来。\n"NOR, me);
        write(CYN"眼前灰尘弥漫，你什么也看不见了。\n"NOR);
        message_vision(CYN"$N抹了一把汗，看了看自己干的结果，得意的笑了。\n"NOR, me);
        me->receive_damage("gin", 20+(random(15)));
	  me->add_temp("clean_floor3", 1);
        return 1;
        }
 


string look_floor()
{
	return
	"这是木制的地板，地下很脏，看来今天没人打扫。\n";
}
