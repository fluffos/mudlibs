// Npc: /d/huafu/npc/zhengfu.c 郑吃请
// 处理有关“正负校长”的谜题

inherit NPC;
#include <ansi.h>
int zhengfu();
int ask_js();
void create()
{
	set_name(CYN"郑吃请"NOR, ({ "zheng chiqin", "zheng" }) );
	set("title", "华师附中副校长");
	set("gender", "男性" );
	set("age", 47);
	set("int", 26);
	set("class","huafu");
	set("long",
		"朕斥卿是华附的副校长，因为姓郑，不大好称呼，如果你冒昧的\n"
		"问他究竟是郑校长还是副校长，他一定会给你好看。\n");
	set("attitude", "peaceful");
	set_skill("literate", 40);
 	set("inquiry", ([
                "正校长" : (: zhengfu :),
                "正校长还是副校长" : (: zhengfu :),
                "你是正校长还是副校长" : (: zhengfu :),
                "你究竟是正校长还是副校长" : (: zhengfu :),
                "奖赏" : (: ask_js :),
                "jiangshang" : (: ask_js :),
                "奖励" : (: ask_js :),
                "jiangli" : (: ask_js :),
]));
	setup();
}

int recognize_apprentice(object ob)
{
	return 1;
}

int zhengfu()
{
	object me;
	me=this_player();
if (me->query_temp("kill_headmaster")){
	message_vision(CYN"郑副校长大惑不解的望着$N，说道：“我不是要你去杀吴颖民的吗，你怎么还没去？”\n"NOR, me);
	return 1;
}
if (!me->query("marks/正负校长")){
	message_vision(CYN"郑副校长满怀心事的望着你，说道：“$N，你真的有办法让我当上正校长？”\n"NOR, me);
	me->set_temp("kill_headmaster",1);
	tell_object(me,WHT"看来郑吃请想让你帮他把吴瘾酩干掉！\n"NOR);
	return 1;}
return 0;
}
int ask_js()
{
	object me=this_player();
	int i=500+random(500);
	int n=me->query_skill("force");
if (me->query_temp("kill_headmaster")){
	message_vision(CYN"郑副校长大惑不解的望着$N，说道：“我不是要你去杀吴颖民的吗，你还没有干掉他吧？”\n"NOR, me);
	return 1;
}
	if (!me->query("marks/正负校长")&&me->query_temp("killed_headmaster")){
	message_vision(WHT"郑吃请激动的说道：“$N，你真的把那个害的我当不上正校长的老不死给杀了？\n好，好！老天有眼呀！这位"+RANK_D->query_respect(me)+"，干的好！让我给你一些奖赏吧！”\n"NOR, me);
	me->add("max_sen",i);
	me->set_skill("force",n*2+i/100);
	me->set("marks/正负校长",1);
	set("title","华师附中正校长");
	CHANNEL_D->do_channel(this_object(),"chat",sprintf("盼了这么多年，正校长终于给我盼到了，多亏了%s啊！",me->name()));
	tell_object(me,WHT"你得到了郑吃请增加"+chinese_number(i)+"点最大心情，增加"+chinese_number(i/100)+"级内功心法的奖励！\n"NOR);
	return 1;}
return 0;
}