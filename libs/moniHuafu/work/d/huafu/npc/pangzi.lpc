int ask_upgrade() {
  object me = this_player();
  int j = random(5);
  int i = j * 100;
  int un = me->query_skill("unarmed", 1);
  int dg = me->query_skill("dodge", 1);
  if (time() - me->query_temp("last_up") <= 500) {
    message_vision("体育老师笑道：“你好像刚刚才来问我要过奖励嘛，怎么又来了？”\n", me);
    return 1;
  }
  if (me->query("guild/name") != "运动队") {
    message_vision("体育老师笑道：“你都不是运动队的成员，怎么来问我要奖励？”\n", me);
    return 1;
  }
  if (me->query("guild/score") <= 500) {
    message_vision("体育老师问道：“你真的这么想要奖励？哎，等你积累了500点专业学分再拿来换不迟！”\n", me);
    return 1;
  } else {
    message_vision("体育老师笑道：“好，好！$N，你的体育成绩很不错嘛！好，好！让我给你一些奖励！”\n", me);
    if (un > dg) {
      me->set_skill("unarmed", un + j);
      tell_object(me, CYN "你得到了增加" + j + "级扑击格斗之术的奖励！\n" NOR);
    } else {
      me->set_skill("dodge", un + j);
      tell_object(me, CYN "你得到了增加" + j + "级纵跃闪躲之术的奖励！\n" NOR);
    }
    me->set_temp("last_up", time());
    me->add("guild/score", -i);
    tell_object(me, WHT "你用你的" + chinese_number(i) + "点专业学分换取了一些奖励！\n" NOR);
    return 1;
  }
  return 0;
}
int ask_quit() {
  object me = this_player();
  if (me->query("guild/name") != "运动队") {
    message_vision("体育老师笑道：“你都不是运动队的成员，怎么来跟我说要退出？”\n", me);
    return 1;
  }
  command("sigh");
  message_vision("体育老师说道：“算了，要退出就退出吧。可不要后悔！”\n", me);
  me->delete("guild");
  me->set("combat_exp", me->query("combat_exp") * 9 / 10);
  tell_object(me, WHT "你用退出了学校运动队，从此不再是运动队的成员了！\n" NOR);
  return 1;
}
