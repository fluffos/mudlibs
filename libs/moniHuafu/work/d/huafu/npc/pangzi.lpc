// Npc:/d/huafu/npc/pangzi.c
// 负责运动队小组的申请、奖励。

inherit NPC;
#include <ansi.h>
int ask_jiaru();
int ask_upgrade();
int ask_upobj();
int ask_quit();
void create() {
  set_name("胖子", ({ "05", "pang zi", "pang", "lingwu", "teacher" }));
  set("title", "体育老师");
  set("gender", "男性");
  set("age", 57);
  set("int", 26);
  set("str", 56);
  set("combat_exp", 5000000);
  set("long",
    "他是一名体育老师，负责管理运动队的工作。\n");
  set("attitude", "peaceful");
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("move", 100);
  set_skill("unarmed", 100);
  set("class", "huafu");
  set("inquiry", ([
    "加入": (: ask_jiaru :),
    "运动队": (: ask_jiaru :),
    "jiaru": (: ask_jiaru :),
    "join": (: ask_jiaru :),
    "升级": (: ask_upgrade :),
    "upgrade": (: ask_upgrade :),
    "奖励": (: ask_upgrade :),
    "premium": (: ask_upgrade :),
    "quit": (: ask_quit :),
    "退出": (: ask_quit :),
  ]));
  setup();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(5)) {
    case 0:
      message_vision("$N友善的望了$n一眼。\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N问道：这位" + RANK_D->query_respect(ob) +
        "要加入运动队么？只要你的肱二头肌够强壮！呵呵。\n", this_object(), ob);
      break;
    case 2:
      message_vision("$N说道：加入了我们运动队，就可以毫无限制的参加各种体育活动了！\n", this_object());
  }
}
int ask_jiaru() {
  object me;
  me = this_player();
  if (me->query("guild/name") == "运动队") {
    message_vision("体育老师笑道：“你已经是我们运动队的人了，还要加入？”\n", me);
    return 1;
  }
  if (!me->query("guild") && me->query_skill("unarmed", 1) > 40
    || !me->query("guild") && me->query_skill("dodge", 1) > 40
    || !me->query("guild") && me->query_skill("move", 1) > 40
    || !me->query("guild") && me->query_skill("huaxue", 1) > 40
    || !me->query("guild") && me->query_skill("yuwen", 1) > 40) {
    message_vision("体育老师笑道：“好，好！$N，你从此就是我们运动队的一员了！快去练习吧！”\n", me);
    me->set("guild/name", "运动队");
    me->set("guild/score", 10 + random(10));
    me->set("title", "运动员");
    tell_object(me, CYN "你正式加入了运动队，现在可以正式参加运动队的活动了！\n" NOR);
    me->delete_temp("gived");
    return 1;
  }
  message_vision("体育老师笑道：“唉，你呀，不行不行，把身子骨练壮实点在来找我不迟！”\n", me);
  tell_object(me, RED "一定是你的基本技能太差了，要么就是你已经参加了别的小组，\n否则这么善良的胖子怎么会不让你参加运动队呢？\n" NOR);
  return 1;
}
