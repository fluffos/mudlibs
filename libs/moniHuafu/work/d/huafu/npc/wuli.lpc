// Npc:/d/huafu/npc/wuli.c
// 负责物理小组的申请、奖励，卖测向仪

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
int ask_jiaru();
int ask_upgrade();
int ask_upobj();
int ask_quit();
void create() {
  set_name("零件", ({ "wuli laoshi", "ling", "laoshi", "wuli" }));
  set("title", "物理老师");
  set("gender", "男性");
  set("age", 47);
  set("int", 26);
  set("combat_exp", 5000000);
  set("long",
    "他是一名物理老师，负责管理测向小组的工作和贩卖测向仪。\n");
  set("attitude", "peaceful");
  set_skill("literate", 40);
  set("class", "huafu");
  set("inquiry", ([
    "加入": (: ask_jiaru :),
    "测向小组": (: ask_jiaru :),
    "jiaru": (: ask_jiaru :),
    "join": (: ask_jiaru :),
    "测向仪": (: ask_upobj :),
    "升级": (: ask_upgrade :),
    "upobj": (: ask_upobj :),
    "upgrade": (: ask_upgrade :),
    "奖励": (: ask_upgrade :),
    "premium": (: ask_upgrade :),
    "quit": (: ask_quit :),
    "退出": (: ask_quit :),
  ]));
  set("vendor_goods", ([
    __DIR__ "obj/cxyi": 30,
  ]));
  setup();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(5)) {
    case 0:
      message_vision("$N友善的望了$n一眼。\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N问道：这位" + RANK_D->query_respect(ob) +
        "要加入物理测向小组么？只要五十块钱！\n", this_object(), ob);
      break;
    case 2:
      message_vision("$N说道：加入了我们物理测向小组，就可以做task了！\n", this_object());
  }
}
int ask_jiaru() {
  object me;
  me = this_player();
  if (me->query("guild/name") == "测向小组") {
    message_vision("物理老师笑道：“你已经是物理测向小组的成员了，还要加入？”\n", me);
    return 1;
  }
  if (!me->query("guild") && (!me->query_temp("gived"))) {
    message_vision("物理老师问道：“你真的想加入测向小组？好，好！交点钱来吧，权当是手续费！”\n", me);
    return 1;
  } else {
    message_vision("物理老师笑道：“好，好！$N，你从此就是我们物理测向小组的一员了！”
		还不快来买个测向仪？\n", me);
    me->set("guild/name", "测向小组");
    me->set("guild/score", 10 + random(10));
    me->set("title", "物理测向小组成员");
    tell_object(me, CYN "你正式加入了物理测向小组，现在可以正式参加测向小组的活动了！\n" NOR);
    me->delete_temp("gived");
    return 1;
  }
}
int accept_object(object who, object ob) {
  object me;
  me = this_player();
  if (me->query("guild/name") == "测向小组") {
    message_vision("物理老师笑道：“你已经是物理测向小组的成员了，还要交钱？”\n", me);
    return notify_fail("看来零件并不想收你的钱。\n");
  }
  if ((int)ob->value() >= 5000) {
    say("零件呵呵的笑道：嗯，钱够了，你挺有诚意的嘛！\n");
    me->set_temp("gived", 1);
    return 1;
  } else {
    say("零件说道：这点钱还不够呀，要五十块！\n");
    return notify_fail("看来零件并不想要你这么一点钱。\n");
  }
  return 0;
}

int ask_upgrade() {
  object me = this_player();
  int j = random(5);
  int i = j * 100;
  int n = me->query_skill("wuli");
  if (time() - me->query_temp("last_up") <= 500) {
    message_vision("物理老师笑道：“你好像刚刚才来问我要过奖励嘛，怎么又来了？”\n", me);
    return 1;
  }
  if (me->query("guild/name") != "测向小组") {
    message_vision("物理老师笑道：“你都不是物理测向小组的成员，怎么来问我要奖励？”\n", me);
    return 1;
  }
  if (me->query("guild/score") <= 500) {
    message_vision("物理老师问道：“你真的这么想要奖励？哎，等你积累了500点专业学分再拿来换不迟！”\n", me);
    return 1;
  } else {
    message_vision("物理老师笑道：“好，好！$N，你的专业很不错嘛！好，好！让我给你一些奖励！”\n", me);
    me->set_skill("wuli", n * 2 + j);
    tell_object(me, CYN "你得到了增加" + j + "级物理神功的奖励！\n" NOR);
    me->set_temp("last_up", time());
    me->add("guild/score", -i);
    tell_object(me, WHT "你用你的" + chinese_number(i) + "点专业学分换取了一些奖励！\n" NOR);
    return 1;
  }
  return 0;
}
int ask_upobj() {
  object me = this_player();
  int i = 300 + random(200);
  object obj;
  if (time() - me->query_temp("last_up") <= 500) {
    message_vision("物理老师笑道：“你好像刚刚才来问我要过奖励嘛，怎么又来了？”\n", me);
    return 1;
  }
  if (me->query("marks/测向仪")) {
    message_vision("物理老师笑道：“你都已经有一台测向仪了，怎么还来问我要？”\n", me);
    return 1;
  }
  if (me->query("guild/name") != "测向小组") {
    message_vision("物理老师笑道：“你都不是物理测向小组的成员，怎么来问我要奖励？”\n", me);
    return 1;
  }
  if (me->query("guild/score") <= 500) {
    message_vision("物理老师问道：“你真的这么想要奖励？哎，等你积累了500点专业学分再拿来换不迟！”\n", me);
    return 1;
  } else {
    message_vision("物理老师笑道：“好，好！$N，你的专业很不错嘛！好，好！让我给你一些奖励！”\n", me);
    obj = new("/d/huafu/npc/obj/cxyi_up");
    obj->move(me);
    me->set("marks/测向仪", 1);
    tell_object(me, CYN "你得到了一台可以永久使用的无线电测向仪！\n" NOR);
    me->set_temp("last_up", time());
    me->add("guild/score", -i);
    tell_object(me, WHT "你用你的" + chinese_number(i) + "点专业学分换取了一些奖励！\n" NOR);
    return 1;
  }
  return 0;
}
int ask_quit() {
  object me = this_player();
  if (me->query("guild/name") != "测向小组") {
    message_vision("物理老师笑道：“你都不是测向小组的成员，怎么来跟我说要退出？”\n", me);
    return 1;
  }
  command("sigh");
  message_vision("物理老师说道：“算了，要退出就退出吧。可不要后悔！”\n", me);
  me->delete("guild");
  me->set("combat_exp", me->query("combat_exp") * 9 / 10);
  tell_object(me, WHT "你用退出了学校物理测向小组，从此不再是测向小组的成员了！\n" NOR);
  return 1;
}
