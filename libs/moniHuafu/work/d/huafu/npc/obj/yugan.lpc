// yugang.c 鱼竿 

#include <weapon.h>

inherit STAFF;

void create() {
  set_name("鱼竿", ({ "yu gan", "gan" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("long", "这是一副上好的鱼竿，鱼线，鱼饵一应齐全。\n");
    set("value", 6000);
    set("material", "steel");
    set("wield_msg", "$N抽出一根$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");
  }
  init_staff(10);
  setup();
}
