#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create() {
  set_name(RED "法轮魔刀" NOR, ({ "falun blade", "blade" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "＂法轮魔刀＂是李洪志最喜欢的一把刀。\n"
      "此刀极邪，又削铁如泥。\n");
    set("value", 350000);
    set("material", "sapphire");
    set("rigidity", 500000);
    set("no_get", 1);
    set("no_drop", 1);
    set("wield_msg", "$N轻轻一弹刀鞘，$n立刻从中跳出落在手中。\n");
    set("unequip_msg", "$N将手中的$n一挥，$n忽然不见了！\n");
    set("weapon_prop/agility", 5);
  }

  init_blade(95);
  setup();
}

void owner_is_killed(object killer) {
  message_vision(RED "\n \n 法轮魔刀 " NOR + "落在地上，又弹入$N的怀中！\n\n", killer);
  this_object()->move(killer);
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  me->add("bellicosity", 2 + random(3));
  return RED "$N的眼里映着＂法轮魔刀＂闪出的诡异红光．．．\n" NOR;
}
