// cloth.c
//

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("华附教工服", ({ "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是华附教工最常穿的衣服。\n");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/armor", 20);
  }
  setup();
}
