#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
	set_name(YEL "公文包" NOR, ({ "gongwen bao"}) );
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一个没装什么东西的公文包。\n");
		set("unit", "个");
		set("value", 200000);
		set("armor_prop/armor", 0);
		set("armor_prop/personality", 3);
		set("wear_msg", "$N偷偷地把一个$n拿出来举在头上。\n");
		set("unwield_msg", "$N偷偷地把$n藏了起来。\n");


	}
	setup();
}

