// ufomian.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("UFO飞碟炒面", ({ "ufomian" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一碗马上就可以吃的UFO飞碟炒面。\n");
		set("unit", "碗");
		set("value", 300);
		set("food_remaining", 4);
		set("food_supply", 60);
	}
}

