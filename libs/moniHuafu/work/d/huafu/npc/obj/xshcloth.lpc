// cloth.c

#include <armor.h>

inherit CLOTH;

void create() {
  string *order = ({ "夏装", "冬装", "运动装", "西装" });
  set_name((order[random(4)]) + "校服", ({ "hf cloth", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 1000);
    set("armor_prop/armor", 30);
    set("armor_prop/dodge", 10);
    set("value", 4000);
  }
  setup();
}
