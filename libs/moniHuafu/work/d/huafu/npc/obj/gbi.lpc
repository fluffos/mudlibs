// blade.c

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("钢笔", ({ "pen" }) );
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "枝");
                set("value", 2000);
                set("material", "iron");
                set("long", "这是一枝国产英雄牌钢笔。\n");
                set("wield_msg", "$N抽出一把$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n收好，塞回口袋里。\n");
        }
        init_sword(55);
        setup();
}
