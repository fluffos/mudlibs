// blade.c

#include <weapon.h>

inherit BLADE;

void create() {
  set_name("小刀", ({ "blade" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 700);
    set("material", "iron");
    set("long", "这种轻巧的小刀，小流氓喜欢用，份量很轻。\n");
    set("wield_msg", "$N拿出一把表面斑驳的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n收好塞回口袋里。\n");
  }
  init_blade(35);
  setup();
}
