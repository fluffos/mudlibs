//xiaoyi.c

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create()
{
	set_name("校医甲", ({ "xiaoyi" }) );
	set("gender", "女性" );
	set("age", 31);
	set("title", GRN "阎王友" NOR);
	set("long",
		"这位校医的本事实在差劲得很，若不是不得已，谁都不会来找她。\n");
	set("combat_exp", 500000);
	set("attitude", "friendly");
	set("per",30);
	set("vendor_goods", ([
                __DIR__"obj/gzg":12,
                __DIR__"obj/asipling":22,
                __DIR__"obj/weige":12,
                __DIR__"obj/yinqiao":3,
	]) );
	set_skill("unarmed",50);
	set_skill("dodge",150);
	set_skill("yuwen",150);
	map_skill("unarmed", "yuwen");
	setup();
	carry_object(__DIR__"obj/hfcloth")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(2) ) {
		case 0:
message_vision("$N望了$n一眼，低声说道：你死定了！你死定了！\n",this_object(),ob);
			break;
	}
}
