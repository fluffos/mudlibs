// bankofficer.c

#include <ansi.h>

inherit NPC;
inherit F_BANKOWNER;

void create() {
  set_name("银行工作人员甲", ({ "officer" }));
  set("title", RED "一本万利" NOR);
  set("gender", "男性");
  set("age", 22);
  set("richness", 50000000000);
  set("str", 22);
  set("cor", 30);
  set("cps", 30);
  set("int", 26);
  set("per", 23);
  set("con", 24);
  set("spi", 30);
  set("kar", 25);
  set("no_arrest", 1);
  set("long", "这是个正在向隔壁学习如何用极差态度对待顾客而不被顾客投诉的方法的银行工作人员。\n");
  set("combat_exp", 1000000);
  set("attitude", "friendly");
  set("max_atman", 1000);
  set("atman", 1000);
  set("atman_factor", 3);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 3);
  set("max_mana", 1000);
  set("mana", 1000);
  set("mana_factor", 3);
  set("chat_chance", 3);
  set("chat_msg", ({
    (: exert_function, "heal" :),
  }));
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("wuli", 100);
  set_skill("yuwen", 100);
  set_skill("huaxue", 100);
  map_skill("force", "wuli");
  map_skill("unarmed", "yuwen");
  map_skill("dodge", "huaxue");
  set("inquiry", ([
    "抢劫": "唉！这群小流氓真厉害！来无影，去无踪！\n",
    "rob": "唉！这群小流氓真厉害！来无影，去无踪！\n",
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  add_money("gold", 50);
}

void init() {
  ::init();
  add_action("do_convert", "convert");
  add_action("do_deposit", "deposit");
  add_action("do_balance", "balance");
  add_action("do_withdraw", "withdraw");
  add_action("do_loan", "loan");
}
