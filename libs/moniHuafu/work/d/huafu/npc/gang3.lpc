inherit NPC;
void create() {
  set_name("李赛钢", ({ "lee", "lee gang" }));
  set("gender", "男性");
  set("age", 32);
  set("long", "这是法轮邪教四大金钢之一。\n");
  set("combat_exp", 10000);
  set("attitude", "friendly");
  set_skill("unarmed", 50);
  set_skill("falun-strike", 10);
  set_skill("falun-steps", 30);
  set_skill("dodge", 40);
  set("class", "falun");
  map_skill("unarmed", "falun-strike");
  map_skill("dodge", "falun-steps");
  set_skill("iron-cloth", 250);
  create_family("法轮邪教", 2, "教众");
  setup();
  add_money("silver", 5);
  carry_object(__DIR__ "obj/yellowrobe")->wear();
}
