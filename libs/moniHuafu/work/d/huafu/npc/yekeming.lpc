inherit NPC;
#include <ansi.h>
int time_period(int timep, object me);
string sysmsg;
void create()
{
	set_name(YEL "夜刻名" NOR, ({ "ye keming", "keming", "ye" }) );

	set("gender", "男性");
	set("age", 59);
	set("long",
"有的人，把名字刻在石头上，想“不朽”——摘自
臧克家《有的人》。\n");
	set("attitude", "peaceful");
	set("skill_public",1);
	set("class","huafu");
	set("str", 26);
	set("cor", 30);
	set("int", 24);
	set("cps", 30);
        set("chat_chance", 1);
        set("chat_msg", ({
                "夜刻名拿起石头砸了几下自己的脚，连说：“不痛，不痛！”\n",
        }) );
	set("force", 4000);
	set("max_force", 4000);
	set("force_factor", 300);
	set("combat_exp", 1000000);
	set_skill("unarmed", 320);
	set_skill("force", 300);
	set_skill("iron-cloth", 100);
	set_skill("wuli", 300);
	set_skill("yuwen", 300);
	set_skill("dagger",200);
	set_temp("apply/attack",300);
	set_temp("apply/damage",300);
	map_skill("iron-cloth", "yiqiforce");
	map_skill("force", "wuli");
	map_skill("unarmed", "yuwen");
	set("title", "地中海");
	setup();
	carry_object(__DIR__"obj/watch")->wear();
	carry_object(__DIR__"obj/bao")->wear();
	carry_object(__DIR__"obj/pixie")->wear();
	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/gun")->wield();
}
int accept_fight(object me)
{
        command("say 生命可贵！不要想不开！");
        return 0;
}
void init()
{
        add_action("give_quest", "quest");
}
int accept_object(object who, object ob)
{
        int  exp, pot, score, val;
	string test;
	mapping quest;
	val = ob->value();
	if (val && val >10000 )
	{
		who->set("quest", 0 );
       	 	tell_object(who,"夜刻名说道：好吧，这个任务就算了吧．．\n");
		who->delete_temp("quest_number");
		return 1;
	}
        if(!(quest =  who->query("quest")))
	{
        tell_object(who,"夜刻名说道：这不是我想要的。\n");
	return notify_fail("看来夜刻名并不想要你的东西。\n");
	}
        if( (string)ob->query("name") != quest["quest"])
        {
        tell_object(who,"夜刻名说道：这不是我想要的。\n");
        return notify_fail("看来夜刻名并不想要你的东西。\n");;
        }
        if ((int) who->query("task_time") < time() )
        {
        tell_object(who,"夜刻名说道：真可惜！你没有在指定的时间内完成！\n");
                        return 1;
        }
        else
        {
        tell_object(who,"夜刻名说道：恭喜你！你又完成了一项任务！\n");
	exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2)+1;
// put a cap
	if(exp > 150) exp = 150;
	exp = exp * (int) who->query_temp("quest_number");
	pot = exp / 5 + 1;
//	due to weekly quest, each quet worth 20
//	score = quest["score"]/2 + random(quest["score"]/2);
	score = -1;
	who->add("combat_exp",exp);
	who->add("potential",pot);
	who->add("score",score);
	tell_object(who,WHT"你被奖励了：\n" +
	chinese_number(exp) + "点学分！\n"+
	chinese_number(pot) + "点潜能！\n" NOR);
	who->set("quest", 0 );
                        return 1;
        }
                return 1;
}
int give_quest(string arg)
{
	mapping quest ;
	object me;
	int j, combatexp, timep, lvl=0;
        mixed *local;
        int  t;
	string tag = "40000000";
 string *levels = ({
                        "0",
                        "4000",
                        "8000",
                        "16000",
                        "32000",
                        "64000",
                        "128000",
                        "256000",
                        "512000",
                        "1024000",
                        "1536000",
                        "2304000",
                        "3456000",
                        "5184000",
                        "7776000",
                        "11664000",
                        "17496000",
                        "26244000",
	        "40000000"
        });
	if( ! arg || !sscanf(arg, "%d", lvl))
	lvl = 0;
	if(lvl<0) lvl=0;
	me = this_player();
// Let's see if this player is a ghost
	if((int)me->query("combat_exp") >= 64000)
	{
		write("抱歉，在本测试版中不提供64000学分以上的任务。\n");
		return 1;
	}
	if((int) me->is_ghost())
	{
		write("你不是确实的人，真正的人，就没有使命，没有任务！\n");
		return 1;
	}

// Let's see if this player still carries an un-expired task
        if((quest =  me->query("quest")))
	{
	if( ((int) me->query("task_time")) >  time() )
		return 0;
	else
		me->set("kee", me->query("kee")/2+1);
		me->delete_temp("quest_number");
	}
	combatexp = (int) me->query("combat_exp");
        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
                if( atoi(levels[j])  <= combatexp )
                        {
                                tag = levels[j];
				if(j < (sizeof(levels)- lvl)) tag = levels[j+lvl];
                                break;
                        }
        }
	quest = QUEST_D(tag)->query_quest();
//	to use less mem...
//	timep = quest["time"];	
	timep = 600;   // each quest give 10 mins.
// A factor here to make time random
	timep = random(timep/2)+timep/2;
	time_period(timep, me);
	if (quest["quest_type"] == "寻")
	{
        tell_object(me,"找回我要的『"+quest["quest"]+"』！\n" NOR);
	sysmsg +="找回『"+quest["quest"]+"』。";
	}
	        if (quest["quest_type"] == "杀")
        {
        tell_object(me,"杀了那个该死的『"+quest["quest"]+"』！\n" NOR);
	sysmsg +="杀了『"+quest["quest"]+"』。";
        }
 	me->set("quest", quest);
	me->set("task_time", (int) time()+(int) timep);
	if((int)me->query_temp("quest_number") < 5)
	me->add_temp("quest_number",1);
	CHANNEL_D->do_channel(this_object(), "sys", sprintf("%s(%s)：%s", 
	me->query("name"),me->query("id"),sysmsg));

return 1;
}

int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";

        tell_object(me,WHT + sprintf("%s",this_object()->name()) +"说道：\n给我" + time + "内");
	sysmsg = "在" + time + "内";
        return 1;
}
