inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int kill_him();
void create() {
  set_name("李洪志", ({ "master li", "master", "li" }));
  set("nickname", YEL "法轮佛法研究会会长" NOR);
  set("gender", "男性");
  set("age", 64);
  set("per", 3);
  set("agi", 25);
  set("int", 30);
  set("class", "falun");
  set("attitude", "friendly");
  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 100);
  set("long",
    "
李洪志是法轮邪教中的教主，李洪志的生日谁也不清楚，
也没人敢问。凡是问过或知道李洪志生日的人都不明不白的
消失了。
\n"
  );
  create_family("法轮邪教", 1, "教主");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "blade.falunchangzhuan" :),
    (: perform_action, "dodge.lianhuanbabu" :),
    (: perform_action, "blade.falunchangzhuan" :),
    (: perform_action, "zhen" :),
    (: perform_action, "shan" :),
    (: perform_action, "ren" :),
    (: exert_function, "mihun" :),
    (: exert_function, "powerup" :)
  }));
  set("combat_exp", 1000000);
  set("score", 200000);
  set_skill("move", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("literate", 80);
  set_skill("unarmed", 300);
  set_skill("falun-steps", 300);
  set_skill("falun-force", 300);
  set_skill("falun-strike", 300);
  set_skill("blade", 350);
  set_skill("falun-blade", 350);
  map_skill("dodge", "falun-steps");
  map_skill("unarmed", "falun-strike");
  map_skill("force", "falun-force");
  map_skill("blade", "falun-blade");
  map_skill("parry", "falun-blade");
  set("inquiry", ([
    "生日": (: kill_him :),
    "birthday": (: kill_him :),
  ]));
  setup();
  carry_object(__DIR__ "obj/wufu")->wear();
  carry_object(__DIR__ "obj/yellowrobe");
  carry_object(__DIR__ "obj/falunblade")->wield();

}

void attempt_apprentice(object me) {
  object cloth;
  object ob = this_object();
  if ((int)me->query_skill("blade") >= 6) {
    command("say 好！好！好好学，把我们法轮圣教发扬光大！");
    command("give robe to " + me->query("id"));
    command("recruit " + me->query("id"));
    cloth = new("/d/huafu/npc/obj/yellowrobe");
    cloth->move(ob);
    return;
  } else {
    command("sigh");
    command("say 要入我法轮圣教，至少也要有一些防身之技。");
    command("say 你的刀法若有几分水平，我便收你为徒。");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "falun");
}
int kill_him() {
  object me;
  me = this_player();
  command("say 看来你已经知道我的生日了！！ \n");
  this_object()->kill_ob(me);
  me->kill_ob(this_object());
  return 1;
}
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "法轮邪教教徒");
    return;
  } else if (exp <= 64000) {
    student->set("title", "法轮邪教副堂主");
    return;
  } else if (exp <= 128000) {
    student->set("title", "法轮邪教堂主");
    return;
  } else if (exp <= 256000) {
    student->set("title", "法轮邪教副坛主");
    return;
  } else if (exp <= 512000) {
    student->set("title", "法轮邪教坛主");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "法轮邪教副舵主");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "法轮邪教舵主");
    return;
  } else if (exp <= 2304000) {
    student->set("title", "法轮邪教护法");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "法轮邪教大护法");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "法轮邪教长老");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "法轮邪教大长老");
    return;
  } else
    student->set("title", "法轮邪教副教主");
  return;

}
void die() {
  object ob;
  if (!ob = query_temp("last_damage_from"))
    ob = this_player(1);
  CHANNEL_D->do_channel(this_object(), "chat", sprintf("我被%s杀了，本教徒弟们要为我报仇啊！", ob->name(1)));
  ::die();
}
