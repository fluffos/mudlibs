// waiter.c

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create() {
  set_name("小卖部售货员甲", ({ "seller" }));
  set("gender", "女性");
  set("age", 41);
  set("title", CYN "财源滚滚" NOR);
  set("long",
    "这位售货员每天都忙得不可开交，自然也财源滚滚了。\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("per", 10);
  set("vendor_goods", ([
    __DIR__ "obj/kekou": 10,
    __DIR__ "obj/baishi": 20,
    __DIR__ "obj/fruitbread": 20,
    __DIR__ "obj/rousbao": 30,
    __DIR__ "obj/ufomian": 30,
    __DIR__ "obj/xuegao": 10,
    __DIR__ "obj/xshcloth": 10,
    __DIR__ "obj/chizi": 30,
    __DIR__ "obj/ybkchi": 30,
    __DIR__ "obj/yzbi": 30,
    __DIR__ "obj/gbi": 30,
  ]));
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  setup();
  carry_object(__DIR__ "obj/hfcloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(10)) {
    case 0:
      message_vision("$N对$n说道：小同学，买什么？\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N望了$n一眼，再一扫货物，道：不贵，不贵，真的不贵！\n", this_object(), ob);
      break;
  }
}
