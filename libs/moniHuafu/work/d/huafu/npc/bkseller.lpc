// bkseller.c
// 负责卖书。

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create() {
  set_name("过期图书处理人员", ({ "seller" }));
  set("gender", "女性");
  set("age", 41);
  set("long",
    "这位老师正在处理图书馆过期的图书。\n");
  set("combat_exp", 500000);
  set("attitude", "friendly");
  set("per", 10);
  set("class", "huafu");
  set("vendor_goods", ([
    "/d/huafu/obj/swordbook": 10,
    "/d/huafu/obj/bladebook2": 20,
    "/d/huafu/obj/unarmedbook": 20,
    "/d/huafu/obj/swordbook2": 30,
    "/d/huafu/obj/movebook": 30,
    "/d/huafu/obj/parrybook": 10,
    "/d/huafu/obj/dodgebook": 10,
    "/d/huafu/obj/unarmedbook2": 20,
    "/d/huafu/obj/forcebook": 30,
    "/d/huafu/obj/book": 30,
    "/d/huafu/obj/bladebook": 20,
  ]));
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  setup();
  carry_object(__DIR__ "obj/hfcloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      message_vision("$N对$n大声说道：小同学，今天是我们这里图书处理，你买一本吧！\n", this_object(), ob);
      break;
    case 1:
      message_vision("$N望了$n一眼，再一扫过期的图书，道：不贵，不贵，真的不贵！\n", this_object(), ob);
      break;
  }
}
