// kuliman.c

inherit NPC;

void create()
{
        set_name("语文老师", ({ "teacher" }) );
        set("gender", "男性" );
        set("age", 42);
        set("long", "这是一位爱出题考人的语文老师。 \n");
        set("combat_exp", 1000);
        set("attitude", "heroism");
        set_skill("unarmed", 10);
        set_skill("parry", 10);
	set_skill("dodge", 10);
	set("class","huafu");
	setup();
	add_money("silver", 1);
        carry_object(__DIR__"obj/xshcloth")->wear();
        
}

