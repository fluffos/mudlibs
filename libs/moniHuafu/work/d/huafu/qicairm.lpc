// jjgod 00.11.30
// Room:/d/huafu/qicairm 器材室
// 为运动队小组设计

#include <ansi.h>
inherit ROOM;
void create()
{
set("short", "器材室");
set("long", @LONG
这间房间是专门供同学们借用器材的房间，只见里面坐着一个正在翘着二郎腿看报
纸的家伙，对你极不友好。再加上借用器材又有一大堆的规矩，假如你不是运动队的话，
就要把随身物品留在这里或是交上押金。顺便提醒一句，押金未必是会退还的。若不是
里面的器材好歹对你的体育练习有所帮助，你才不会来求他呢。
旁边墙上挂着一块牌子（sign），写着借用器材的具体要求。
LONG);
set("exits", ([
"out" : __DIR__"pdindoor",
]));
set("item_desc", ([
"sign" :@TEXT
现在体育科器材室提供各种器材的借用，
包括沙袋、篮球、足球、羽毛球、乒乓球、
等等，请自行察看（list），除运动队成
员以外人员，请缴纳押金或者将随身的价
值较高的物品压（ya）在此处。然后就可
以借（borrow）走，还器材请使用huan指
令。
TEXT
]) );
	set("objects", ([
	__DIR__"npc/tofu" : 1,
	]) );
	set("valid_startroom",1);
	set("coor/x",10);
	set("coor/y",-60);
	set("coor/z",0);
	setup();
}