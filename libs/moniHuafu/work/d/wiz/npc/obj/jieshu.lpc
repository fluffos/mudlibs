// jieshu.c
// 借书证，用于图书馆借书

inherit  ITEM;

void  create()
{
                set_name("借书证",  ({  "card"  }));
                set_weight(200);
	set("long",  "这是张普普通通的借书证。\n"  );
                if(  clonep()  )
                                set_default_object(__FILE__);
                else  {
                                set("unit",  "张");
                                set("material",  "paper");
                set("value",  2000);
                  set("no_get",  1);
	set("no_drop",  1);
                set("amount",30);
                }
                setup();
}
int query_autoload() { return 1; }