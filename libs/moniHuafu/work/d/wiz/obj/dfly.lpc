// dragonfly.c
// by kittt

#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(GRN "竹蜻蜓" NOR, ({ "bamboo dragonfly", "fly" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "小叮当的交通工具。\n");
    set("unit", "支");
    set("value", 0);
  }

  setup();
  init_sword(800);
}

void init() {
  add_action("do_fly", "flyto");
}


int do_fly(string arg) {

  object obj, me = this_player();

  if (!arg) return notify_fail("你要去哪里？\n");


  obj = find_player(arg);
  if (!obj) obj = find_living(arg);
  if (!obj) obj = LOGIN_D->find_body(arg);
  if (!obj || !me->visible(obj)) {
    arg = resolve_path(me->query("cwd"), arg);
    if (!sscanf(arg, "%*s.lpc")) arg += ".lpc";
    if (!(obj = find_object(arg))) {
      if (file_size(arg) >= 0)
        obj = load_object(arg);
      else
        return notify_fail("没有这个玩家、生物、或地方。\n");
    }
  }
  if (environment(obj))
    obj = environment(obj);

  message_vision(GRN "$N将竹蜻蜓安在头顶上，接著飞走了。\n" NOR, me);

  me->move(obj);
  message_vision(GRN "$N从半空中飞下来，把竹蜻蜓从头上拿下来放进了口袋。\n" NOR, me);

  return 1;
}
