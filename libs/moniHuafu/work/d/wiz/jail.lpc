// Room: /d/wiz/courthouse.c

#include <ansi.h>
void test_me(object me);
inherit ROOM;

void create()
{
	set("short", "办公楼三楼训导处");
	set("long", @LONG
这里是华师附中处理屡教不改的学生的训导处，能到这里来的人一定都是令人
头痛的学生。但是一到这里，别人的头就不痛了，你的头应该开始痛了吧．．．
好好改造，重新做人，争取减刑吧！
LONG
	);
        set("exits", ([ /* sizeof() == 2 */
  "down" : __DIR__"courthouse"
]));
	set("objects", ([
	__DIR__"npc/zhuren2":1 ]) );
	set("no_fight", 1);
	set("no_magic", 1);
	set("no_spells", 1);
	set("coor/x",10);
	set("coor/y",0);
	set("coor/z",10);
	setup();
}
void init()
{
        if(!wizardp(this_player()))
	{
	this_player()->set("startroom", __FILE__);
	add_action("do_nothing", "go");
	add_action("do_quit","quit");
	}
}	

int do_nothing()
{
"/cmds/std/look"->look_room(this_player(),this_object());
message_vision("$N猛摇铁栏杆，大叫：“我要出去！我要出去！”\n",this_player());
tell_room("/d/wiz/jobroom",RED"你隐隐约约听见楼上有什么人在大叫，好像是叫：“我要出去！我要出去！”\n"NOR);
write("训导处的生活真苦啊．．．．！\n");
return 1;
}

int do_quit()
{
write("你觉得你现在还退得出吗？\n");
"/cmds/usr/quit"->main(this_player(),"");
return 0;
}
