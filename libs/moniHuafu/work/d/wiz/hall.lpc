inherit ROOM;
void create()
{
	set("short", "领导休息室");
	set("long", @LONG
这里是模拟华附的领导——管理人员休息和聊天讨论的地方。
这里全部按照办公楼的校长室布局，看来是整个华附最舒服的地
方了。但如果你不是巫师，就不要进来了，给阿飞发现了，后果
不堪设想……
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "out" : __DIR__"jobroom"
]));
        set("valid_startroom", 1);
	set("coor/x",0);
	set("coor/y",-10);
	set("coor/z",10);
	setup();
	call_other("/obj/board/wizard_b", "???");
}

void init()
{
object room;
object me=this_player();
if(!wizardp(this_player()))
{
if(!room = find_object("/d/huafu/juqing"))
room = load_object("/d/huafu/juqing");
message_vision("$N不是巫师，误闯巫师会客室，结果被一阵清风送回聚清园了。\n",me);
this_player()->move(room);
}
}
