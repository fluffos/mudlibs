#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "冥府大道");
        set("long", @LONG
愁云惨淡之中一片死寂，人来人往亦不少于其他年级，据说但凡能
在此路自行行走之人，都是高三成绩不错的学生，高三规矩森严更甚其
他年级，十八层地狱管尽天下学子，所以此路倒还太平，安静。顺路前
行便是阎宫。
LONG
        );
        set("exits", ([
                "north" : "/d/death/gate",
	"south" : "/d/death/naihe2",
        ]) );
	set("coor/x",-1020);
	set("coor/y",-10);
	set("coor/z",-100);
	setup();
        replace_program(ROOM);
}
 
