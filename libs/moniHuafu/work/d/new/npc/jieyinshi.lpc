// jieyinshi.c 新生指导员
// jjgod 00/10/03

inherit NPC;
#include <ansi.h>

void create() {
  set_name("模拟华附新生指导员", ({ "zhi dao" }));
  set("long", "这是一名为专门接待新学生而设的同学。\n");
  set("gender", "男性");
  set("age", 18);
  setup();

  carry_object("/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  CHANNEL_D->do_channel(this_object(), "chat", sprintf("热烈欢迎我们的新同学——%s！", ob->name(1)));
  say("指导员说道：这位" + RANK_D->query_respect(ob)
    + "，欢迎光临，模拟华附老玩家请往南走，新玩家请往东走。\n");

}
