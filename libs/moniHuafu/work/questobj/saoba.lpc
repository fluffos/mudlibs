#include <weapon.h>
#include <ansi.h>

inherit SWORD;
void create() {
  set_name("扫把", ({ "sba", "sao" }));
  //        set_name(YEL"扫把"NOR, ({ "saoba","sao" }) );
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("material", "iron");
    set("long", "一把不错的扫把，好像可以当剑用。\n");
    set("wield_msg", "$N拿出一把$n紧紧握在手中。\n");
    set("unequip_msg", "$N将手中的$n放下，背在肩上。\n");
  }
  init_sword(75);
  setup();
}
