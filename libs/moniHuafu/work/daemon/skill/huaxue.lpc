
inherit SKILL;

string *dodge_msg = ({
	"$n一声大喝拿出呈熔融状的四氧化三铁，问$N道：“吃？还是不吃？！”。\n",
	"$n点燃手中的二氧化硫，刺鼻的气味使$N不敢近前。\n",
	"$n举起一杯浓硫酸，顺手抓住$N的拳头，把它往杯子里一塞，可惜塞不下。\n",
	"$n将$N放上一个天平，称了半天，指着$N连说：“晚饭就指望他了……”\n",
	"$n将身子幻化成几千个分子，无影无踪的躲过了$N的攻势。\n",
       "$n轻轻跃起，倏忽已落至$N身后，拍拍$N的后脑勺道：“化学这门学科，就是研究$N变化的规律的！”\n",

});

int valid_enable(string usage)
{
	return (usage=="dodge"||usage=="move") ;
}

int valid_learn(object me)
{
	if( (int)me->query("max_force") < 100 )
		return notify_fail("你的内力不够，没有办法练化学步法。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
		return notify_fail("你的气或内力不够，不能练化学步法 。\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	return 1;
}
int effective_level() { return 19;}

int learn_bonus()
{
	return -90;
}
int practice_bonus()
{
	return -50;
}
int black_white_ness()
{
	return 40;
}

string perform_action_file(string action)
{
        return CLASS_D("huafu") + "/huaxue/" + action;
}

