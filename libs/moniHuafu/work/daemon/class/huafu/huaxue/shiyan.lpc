// Jjgod@mnhf
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	extra = me->query_skill("huaxue",1);
	if ( extra < 30) return notify_fail("你的［化学步法］还不够纯熟！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［永不停息的实验］只能对战斗中的对手使用。\n");
	if(target->is_busy())
		return notify_fail(target->name()+"已经手忙脚乱了！\n");
	message_vision( YEL "$N朗声问道：“$n！稀盐酸加氢氧化钙加氢氧化钠加硝酸加石蕊加碳酸氢氨加碳酸纳加硫酸铜加氯化银
		再通入二氧化碳再加上$n，最后得到什么？！\n" NOR ,me,target);
	if(random((int)target->query("combat_exp")) < (int)me->query("combat_exp"))
	{
	message_vision(BLU "结果$N怎么也想不出来，一筹莫展！！\n"NOR,target);
	target->start_busy(5);
	}
	else{
	message_vision("结果$N并不慌张！\n",target);
	me->start_busy(2);
	
	}
	return 1;
}

