// prostitute.c
#include <condition.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (duration < 1) return 0;
  if (base_name(environment(me)) != "/d/huafu/shoujia") {
    tell_object(me, YEL "收破烂的突然出现在你身边：你能跑哪里去！快回去！\n" NOR);
    message_vision(CYN "收破烂的突然出现，不由分说，拉了$N就走。\n" NOR, me);
    me->move("/d/huafu/shoujia");
  }
  me->apply_condition("prostitute", duration - 1);
  return CND_CONTINUE;
}
