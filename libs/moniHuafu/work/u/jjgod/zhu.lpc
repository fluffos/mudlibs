#include <room.h>
inherit ROOM;

void create() {
  set("short", "品竹楼");
  set("long", @LONG
郁郁葱葱的竹林间，竟有这样一处胜地，只见青竹扎成的小楼上
摆着两张竹椅，一张竹台，台上摆着一块棋盘，棋盘上的残局乃是小
楼的主人阿飞闲暇时摆成，不料普天之下竟无人解得，你若有兴趣也
可参详一下，但重棋而轻竹，实在是大违“品竹”的本意了。还有一
条小溪穿林而过，溪水清冽，绝对无毒。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "workroom",
  ]));
  set("item_desc", ([
    "棋局": @TEXT
棋局对你太难，看了于身心无益，不看也罢。
TEXT
  ]));
  set("valid_startroom", 1);
  setup();
}
