inherit ROOM;
#include <room.h>
void create()
{
        set("short", "储藏室");
        set("long", @LONG
这里放满了各种各样的阿飞从各个地方收集来的奇珍异宝，每样东西
都有独特的功效，但是未经阿飞的同意，你最好不要乱拿，否则会死得很
难看的，你不信？LOOK!
LONG );
        set("exits", ([ /* sizeof() == 1 */
            "north"  : __DIR__"workroom",
        ]));
        set("objects", ([
        "/obj/corpse" : 1,
        __DIR__"obj/donkey" : 1,
        "/obj/magicstone" : 1,
        "/obj/dust" : 1,
        "/obj/teststone" : 1,
        "/obj/test" : 1,
        "/obj/prize/black_vest" : 1,
        "/obj/prize/f_p" : 1,
        "/obj/prize/t_p" : 1,
        "/obj/prize/s_p" : 1,
        "/obj/example/askstone" : 1,
        "/obj/example/dragon" : 1,
        "/obj/example/roc" : 1,
                        ]) );
        set("valid_startroom", 1);
        setup();
	create_door("north", "储藏室门", "south", DOOR_CLOSED);
}
void init()
{
        add_action("do_tiaoshi", "tiaoshi");
}
int do_tiaoshi(string arg)
{
        object me;
        me = this_player();
        if (me->query("id")!="jjgod") return 0;
        me->set_skill("buddhism",200);
        me->set_skill("dodge",200);
        me->set_skill("force",200);
        me->set_skill("hammer",200);
        me->set_skill("literate",200);
        me->set_skill("magic",200);
        me->set_skill("parry",200);
        me->set_skill("staff",200);
        me->set_skill("stealing",200);
        me->set_skill("strike",200);
        me->set_skill("sword",200);
        me->set_skill("taoism",200);
        me->set_skill("throwing",200);
        me->set_skill("unarmed",200);
        return 1;
}
