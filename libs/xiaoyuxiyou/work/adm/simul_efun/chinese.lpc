string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  // AGENTS.md sec15h: this was a GBK lead-byte range check
  // (str[0] > 160 && str[0] < 255, strlen>=2 meaning "at least one
  // full 2-byte GBK char"). This driver's strings are UTF-8 native:
  // str[i] is a Unicode codepoint and strlen() counts characters, not
  // bytes, so the old check silently never matched real Chinese text.
  // Fixed to a CJK Unified Ideographs codepoint range check; the
  // byte-count bound becomes a 1-character bound.
  if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff) return 1;
  return 0;
}
