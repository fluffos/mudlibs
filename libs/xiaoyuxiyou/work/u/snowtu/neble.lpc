#include <ansi.h>
inherit ITEM;

void create()
{
    	set_name("生死簿",({"tools"}));
    	if(clonep()) 
    		set_default_object(__FILE__); 
    	set("unit","个");
    	set("no_give",1);
    	set("no_get",1);
    	set("no_put",1);
    	set("no_steal",1);
    	set("no_sell",1);
    	set("no_drop",1);
    	set("no_zm",1);
    	set("value",0);
    	set("level",0);
	setup();
}