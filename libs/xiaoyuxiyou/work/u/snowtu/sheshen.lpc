// sheshen.c        舍身技
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int calculate_damage(object me, object target, int base_damage, int damge_bonus);

int perform(object me, object target)
{
        string msg, str;
        int mydf,ap, dp, pp;
        int youcps, mycor, mystr, youstr;
        int damage_bonus, damage, wound,delay;
        object ob;

        if( !target ) target = offensive_target(me);
        if( !target
         || !target->is_character()
         || !me->is_fighting(target) )
                return notify_fail("不在战斗中，舍什么身？\n");
        if( me->query("family/family_name")!="东海龙宫"
        && me->query("chushi/chushi_longgong")!="yes" )
                return notify_fail("你不能使用这项技能！\n");

        mydf=(int)me->query_skill("dragonfight",1);
        if(mydf<100) 
        return notify_fail("你的修为不够深，还不能领悟舍身技的精髓。\n");
        mydf=(int)me->query_skill("dragonforce",1);
        if(mydf<100) 
                return notify_fail("你的修为不够深，还不能领悟舍身技的精髓。\n");
        if((int)me->query("force")<300) 
                return notify_fail("你的内力不够了。\n");
        
        msg = CYN "$N"CYN"右掌挥出，斩向$n"CYN"的左肩，\n";

        me->add("force", -300);

        mycor = me->query_cor();
        youcps = target->query_cps();
        ob = target->query_temp("weapon");
        str= "右手";
        if(ob && objectp(ob)) 
        str="手中的"+ob->query("name");
        
        ap = COMBAT_D->skill_power(me, "unarmed", SKILL_USAGE_ATTACK);
        dp = COMBAT_D->skill_power(target,"dodge", SKILL_USAGE_DEFENSE);
        dp+= COMBAT_D->skill_power(target,"parry", SKILL_USAGE_DEFENSE);
        dp/= 2;
        pp = COMBAT_D->skill_power(target,"unarmed", SKILL_USAGE_DEFENSE);      
        if(ob && objectp(ob)) 
        {
        dp/=2;
        pp/= 2;
    }
        mystr = me->query_str();
        youstr = me->query_str();
        
        damage_bonus = mystr*(100+me->query("force_factor"))/100;

        if( random(youcps) < 15 || random(100)>=dp/(ap+dp)*80 ) 
        {
                msg += CYN"$n"CYN"想用"+str+NOR CYN"挡开，不料却被$N"CYN"一把抓住。\n"NOR;
        msg += "$N"CYN"顺势上步，使出了「舍身技」！\n\n" NOR;
        msg += CYN"$N"CYN"左脚铲向$n"CYN"右腿膝盖，";                
        if( random(100)>=pp/(ap+pp)*90 ) 
        {
                        msg += "结果正铲在$p的小腿上。\n" NOR;
                        damage= calculate_damage(me, target, 100, damage_bonus);
                        wound = random(damage-(int)target->query_temp("apply/armor"));
                        if(damage>0) 
                        {
                                target->receive_damage("kee", damage, me,TYPE_PERFORM);
                if(wound>0) target->receive_wound("kee", wound, me,TYPE_PERFORM);
                                msg+=COMBAT_D->damage_msg(damage, "内伤");
                        }
                }
        else    msg+="结果被$n"CYN"提腿挡开了。\n" NOR;
        msg += CYN "\n紧跟着$N"CYN"收左脚，提左膝撞向$n"CYN"的软肋，\n";
        msg += "同时右手曲肘撞向$n"CYN"的面门，";
        if( random(100)>=pp/(ap+pp)*95 ) 
                {
                msg += "结果正中$n"CYN"。\n" NOR;
                        damage = calculate_damage(me, target, 120, damage_bonus);
                        wound = random(damage-(int)target->query_temp("apply/armor"));
            if(damage>0) 
            {
                target->receive_damage("kee", damage, me,TYPE_PERFORM);
                                if(wound>0) target->receive_wound("kee", wound, me,TYPE_PERFORM);
                                msg+=COMBAT_D->damage_msg(damage, "内伤");
                        }
                }
        else    msg+="结果被$n挡开了。\n" NOR;
                msg += CYN "\n$N"CYN"接着顺势用右手抓住$n"CYN"右臂，半转身将$p摔了出去，\n";
                if( random(100)>=pp/(ap+pp)*100 ) 
                {
                msg += "结果$n"CYN"一跟头摔在地上。\n" NOR;
            damage = calculate_damage(me, target, 150, damage_bonus);
            wound = random(damage-(int)target->query_temp("apply/armor"));
            if(damage>0) 
            {
                target->receive_damage("kee", damage, me,TYPE_PERFORM);
                                if(wound>0) target->receive_wound("kee", wound, me,TYPE_PERFORM);
                                msg+=COMBAT_D->damage_msg(damage, "内伤");
                        }
                }
        else    msg+="结果$n"CYN"一个踉跄，却没摔倒。\n" NOR;
        message_combatd(msg, me, target);
                if( damage )
                        COMBAT_D->report_status(target);
                if( wound )     
                        COMBAT_D->report_status(target,1);
        } 
        else    
        {
        msg += "可是$p看破了$P的企图，向后越开。\n" NOR;
                message_combatd(msg, me, target);
        }
        delay = random(2)+2;
        me->start_busy(delay);
        return 1;
}

int calculate_damage(object me, object target, int base_damage, int damage_bonus)
{
        int damage;
        int myexp, youexp;

        damage = base_damage+(damage_bonus+random(damage_bonus))/2;
        myexp = me->query("combat_exp")/10000;
        youexp= target->query("combat_exp")/10000;
        if(random(youexp)>myexp) 
    {
        damage-=damage/3;
                youexp/=2;
        }
        if(wizardp(me) && me->query("env/combat") )
        tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
        return damage;
}

int help(object me)
{
string str;
if( !me )      return 0;
str = @LONG
        外功名称：舍身技
        外功所属：龙形搏击
        外功效果：舍身攻击敌人
                  使用后自身busy2-3秒
        外功条件：
                  内力300点，消耗300点
                  龙形搏击100级
                  龙神心法100级
LONG;
me->start_more(str);
return 1;
}


