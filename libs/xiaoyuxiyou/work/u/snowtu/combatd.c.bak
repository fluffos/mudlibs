                                rkmsg = "妖极天世";break;
                        case "perform_hongyan":
                                rkmsg = "红颜白发";break;
                        case "perform_wanling":
                                rkmsg = "万铃魔音";break;
                        case "perform_mantian":
                                rkmsg = "青霞漫天";break;
                        case "perform_juehu":
                                rkmsg = "九阴绝户手";break;
                        case "perform_feicha":
                                rkmsg = "飞叉绝技";break;
                        case "perform_juesha":
                                rkmsg = "天魔绝杀";break;
                        case "perform_yunyu":
                                rkmsg = "翻云覆雨";break;
                        case "perform_xuesha":
                                rkmsg = "血杀";break;
                        case "perform_duan":
                                rkmsg = "断云";break;
                        case "perform_duanyun":
                                rkmsg = "断云";break;
                        case "perform_shixie":
                                rkmsg = "嗜血";break;
                        case "perform_tianxia":
                                rkmsg = "天下无狗";break;
                        case "perform_kuang":
                                rkmsg = "神龙狂舞";break;
                        case "perform_dianxue":
                                rkmsg = "点穴";break;
                        case "perform_jianyi":
                                rkmsg = "逍遥剑意";break;
                        case "perform_qishen":
                                rkmsg = "泣神十六剑";break;
                        case "perform_luanwu":
                                rkmsg = "猪头乱舞";break;
                
                        case "exert_sheqi":
                                rkmsg = "摄气";break;
                        case "exert_roar":
                                rkmsg = "龙吟";break;
                
                        case "special_msg"://特殊的攻击
                                rkmsg = killer->query_temp("special_msg");      
                                break;
                        default : rkmsg = "特殊技能";break;        
                        }                        
					}                        
                        
                        
                }//if( killmsg)
        
                if( userp(killer) && init_killer!=-1 ) 
                { // killer is user.
                        killer->apply_condition("no_pk_time",240+no_pk);
                        lose =victim_lose(killer,victim,killerid);
                        gain=lose*2/3;
                        if( gain<0) gain=0;
                        victim->delete_temp("last_fainted_from");
                        if( lose>100)
                                killer->delete("kill/last_killer");
                        victim->set("kill/last_killer",killerid);
                        victim->set("kill/last_lose",gain);
                        victim_penalty(victim);
                        weapon=killer->query_temp("kill_weapon");
                        if( weapon && rkmsg)
                        {           
                                str=victim->name(1)+"在"+MISC_D->find_place(environment(killer))+"被"+killer->name(1)+"用"HIY+weapon->name()+HIM+rkmsg+"死了。"+str;
                                CHANNEL_D->do_channel(this_object(), "rumor",str);
                        } 
                        else    
                        {
                                if( rkmsg && !weapon)
                                {
                                        str=victim->name(1)+"在"+MISC_D->find_place(environment(killer))+"被"+killer->name(1)+"用一招"+HIW"“"+rkmsg+"”"+HIM"送去见了阎王。"+str;
                                        CHANNEL_D->do_channel(this_object(), "rumor",str);
                                }
                                else if( weapon && !rkmsg)
                                {
                                        str=victim->name(1)+"在"+MISC_D->find_place(environment(killer))+"被"+killer->name(1)+"用"HIY+weapon->name()+HIM"送去了见了阎王。"+str;
                                        CHANNEL_D->do_channel(this_object(), "rumor",str);
                                }
                                else    
                                {
                                        str=victim->name(1)+"在"+MISC_D->find_place(environment(killer))+"被"+killer->name(1)+"杀死了。"+str;
                                        CHANNEL_D->do_channel(this_object(), "rumor",str);
                                }
                        }
                        if( !victim->query("tongji/fanren")&&vics&&member_array(victim->query("id"),vics)>-1)
                        {   
                                message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->name(1)+"无视王法，滥伤人命，打死了"+victim->name(1)+"，现正被官府通缉！\n"+NOR,users());
                                killer->set("tongji/fanren",1);
                                killer->set("tongji/mudage",killer->query("mud_age"));
                                killer->add("tongji/pktime",1);
                                killer->delete_temp("kill/target/"+victim->query("id"));
                                str = "听说"+killer->name(1)+"杀了人，正在逃命。";
                                CHANNEL_D->do_channel(this_object(), "rumor",str);
                                if( killer->query("tongji/pktime")>=3)
                                {
                                        killer->move("/d/wiz/dalao");
                                        message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->query("name")+"连续杀伤人命，现被关进大牢，待秋后发落！\n"NOR,users());
                                } 
                        }
                        else if( victim->query("tongji/fanren"))
                        {
                                message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->name(1)+"杀死通缉犯"+victim->name(1)+"有功，现通报嘉奖！\n"+NOR,users());
                                killer->add("kill/pkgain",gain);
                                killer->add("combat_exp",gain);
                                killer->add("PKFANREN",1);
                                victim->delete("tongji");
                                str=chinese_daoxing(gain);
                                if( strlen(str)<=1)
                                        str="零点";
                                str=killer->name(1)+"得到了"+str+"道行！";
                                str=victim->name(1)+"被"+killer->name(1)+"就地正法。"+str;
                                CHANNEL_D->do_channel(this_object(), "rumor",str);    
                        }
                        else if( kils&&member_array(killer->query("id"),kils)>-1)
                        {       
                                str=victim->name(1)+"被"+killer->name(1)+"正当防卫杀死了。";
                                CHANNEL_D->do_channel(this_object(), "rumor",str);    
                        }
                        else    
                        {
                                message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->name(1)+"失手打死了"+victim->name(1)+"，现已逃命，望知其下落者，速报知官府！\n"+NOR,users());
                                killer->set("tongji/fanren",1);
                                killer->set("tongji/mudage",killer->query("mud_age"));
                                killer->add("tongji/pktime",1);
                                killer->delete_temp("kill/target/"+victim->query("id"));
                                str = "听说"+killer->name(1)+"因过失伤人，正被官府通缉。";
                                CHANNEL_D->do_channel(this_object(), "rumor",str);
                                if( killer->query("tongji/pktime")>=3)
                                {
                                        killer->move("/d/wiz/dalao");
                                        message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->name(1)+"连续杀伤人命，现被关进大牢，待秋后发落！\n"NOR,users());
                                }
                        }             
                        bls=10;
                        killer->delete_temp("kill_weapon");
                        killer->delete_temp("kill_msg");
                } 
                else    
                {    // killer is not user or killer didn't init the kill.
                        string last_faint;
                        object fainter;
                        last_faint=victim->query_temp("last_fainted_from");
                        if( last_faint) 
                        {       
                                fainter=find_player(last_faint);
                                if( fainter && userp(fainter)) 
                                {
                                        if( !my_killer_list) init_killer=-1;
                                        else init_killer=member_array(last_faint, my_killer_list);
                                        if( init_killer!=-1) 
                                        {
                                                fainter->apply_condition("no_pk_time",240+fainter->query_condition("no_pk_time"));
                                                log_file("death","["+ctime(time())+"] "+victim->query("id")+" was fainted by "+fainter->query("id")+" and killed by "+killer->query("id")+".\n");
                                        }
                                }
                        }
                        victim_penalty(victim);
                        bls = 10;
                        weapon=killer->query_temp("kill_weapon");
                        if( weapon && rkmsg)
                        {           
                                str=victim->name(1)+"在"+MISC_D->find_place(environment(killer))+"被"+killer->name(1)+"用"HIY+weapon->name()+HIM+rkmsg+"死了。";
                                CHANNEL_D->do_channel(this_object(), "rumor",str);
                        }       
                        else    
                        {
                                if( rkmsg && !weapon)
                                {
                                        str=victim->name(1)+"在"+MISC_D->find_place(environment(killer))+"被"+killer->name(1)+"用一招"+HIW"“"+rkmsg+"”"+HIM"送去了阎罗地府。";
                                        CHANNEL_D->do_channel(this_object(), "rumor",str);
                                }
                                else if( weapon && !rkmsg)
                                {
                                        str=victim->name(1)+"在"+
                                        MISC_D->find_place(environment(killer))+"被"+killer->name(1)+"用"HIY+weapon->name()+HIM"送去了阎罗地府。";
                                        CHANNEL_D->do_channel(this_object(), "rumor",str);
                                }
                                else    
                                {
                                        str=victim->name(1)+"在"+MISC_D->find_place(environment(killer))+"被"+killer->name(1)+"杀死了。";
                                        CHANNEL_D->do_channel(this_object(), "rumor",str);
                                }
                                if( userp(killer) )
                                {
                                        if( !victim->query("tongji/fanren")&&vics&&member_array(victim->query("id"),vics)>-1)
                                        { 
                                                message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->name(1)+"无视王法，滥伤人命，打死了"+victim->name(1)+"，现正被官府通缉！\n"+NOR,users());
                                                killer->set("tongji/fanren",1);
                                                killer->set("tongji/mudage",killer->query("mud_age"));
                                                killer->add("tongji/pktime",1);
                                                killer->delete_temp("kill/target/"+victim->query("id"));
                                                str = "听说"+killer->name(1)+"杀了人，正在逃命。";
                                                CHANNEL_D->do_channel(this_object(), "rumor",str);
                                                if( killer->query("tongji/pktime")>=3)
                                                {
                                                        killer->move("/d/wiz/dalao");
                                                        message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->name(1)+"连续杀伤人命，现被关进大牢，待秋后发落！\n"NOR,users());
                                                }
                                        }
                                        else if( victim->query("tongji/fanren"))
                                        {
                                                message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->name(1)+"杀死通缉犯"+victim->name(1)+"有功，现通报嘉奖！\n"+NOR,users());
                                                killer->add("kill/pkgain",gain);
                                                killer->add("combat_exp",gain);
                                                killer->add("PKFANREN",1);
                                                victim->delete("tongji");
                                                str=chinese_daoxing(gain);
                                                if( strlen(str)<=1)
                                                        str="零点";
                                                str=killer->name(1)+"得到了"+str+"道行！";
                                                str=victim->name(1)+"被"+killer->name(1)+"就地正法。"+str;
                                                CHANNEL_D->do_channel(this_object(), "rumor",str);    
                                        }
                                        else if( kils&&member_array(killer->query("id"),kils)>-1)
                                        {
                                                str=victim->name(1)+"被"+killer->name(1)+"正当防卫杀死了。";
                                                CHANNEL_D->do_channel(this_object(), "rumor",str);    
                                        }
                                        else    
                                        {
                                                message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->name(1)+"失手打死了"+victim->name(1)+"，现已逃命，望知其下落者，速报知官府！\n"+NOR,users());
                                                killer->set("tongji/fanren",1);
                                                killer->set("tongji/mudage",killer->query("mud_age"));
                                                killer->add("tongji/pktime",1);
                                                killer->delete_temp("kill/target/"+victim->query("id"));
                                                str = "听说"+killer->name(1)+"因过失伤人，正被官府通缉。";
                                                CHANNEL_D->do_channel(this_object(), "rumor",str);
                                                if( killer->query("tongji/pktime")>=3)
                                                {
                                                        killer->move("/d/wiz/dalao");
                                                        message("channel:xyj",HIR+"【创世通告】薛仁贵(xueren gui)："+killer->name(1)+"连续杀伤人命，现被关进大牢，待秋后发落！\n"NOR,users());
                                                }
                                        }                   
                                } 
                                if( !userp(killer)&&userp(victim)&&victim->query("tongji/fanren"))
                                {
                                        str=victim->name(1)+"被"+killer->name(1)+"就地正法。";
                                        CHANNEL_D->do_channel(this_object(), "rumor",str);
                                        victim->delete("tongji");
                                }
                        }    
                }
        } 
        else    
        {  //NPC is the victim.
                if( userp(killer) )
                {
                        int reward;
                        reward = nk_gain(killer, victim);
                        if( (int)victim->nk_reward(killer, reward)>0) 
                        {
                        } 
                        else if( reward>0) 
                        {
                                string msg;
                                killer->add("kill/nkgain",reward);
                                killer->add("daoxing",reward);
                                str=chinese_daoxing(reward);
                                tell_object(killer,"\n你得到了"+str+"道行。\n");
                                msg=sprintf("%s(%d)杀死了%s(%d)，得到%d点道行。", 
                                                killer->query("id"),killer->query("daoxing")+"/"+killer->query("combat_exp"), 
                                                victim->query("id"),victim->query("daoxing")+"/"+victim->query("combat_exp"),
                                                reward );
                                log_file("npc_kill","["+ctime(time())+"] "+msg+"\n");
                                CHANNEL_D->do_channel(this_object(), "sys",msg);
                        }
                }
        killer->add("MKS", 1);
        bls = 1;
        }
        
        ap = killer->query("combat_exp")+killer->query("daoxing");
        ap = ap/10;
        dp = victim->query("combat_exp")+victim->query("daoxing");
        dp = dp/10;
        
        if( !userp(killer) 
         && ap>dp )
                bls=0;

        killer->add("bellicosity", bls * (userp(killer)? 1: 10));
        if( stringp(vmark = victim->query("vendetta_mark")) )
                killer->add("vendetta/" + vmark, 1);
        if( userp(killer)) killer->save();
        if( userp(victim)) victim->save();
}

void victim_penalty(object victim)
{
   int combat_exp_loss,dx_loss;
   if( !victim )
	return;

   combat_exp_loss = (int)victim->query("combat_exp") / 40;
   dx_loss = (int)victim->query("daoxing") / 40;
   victim->set("death/mud_age",victim->query("mud_age"));
   victim->set("death/combat_exp_loss",combat_exp_loss);
   victim->set("death/dx_loss",dx_loss);
   log_file("death",victim->query("id")+" lost "+combat_exp_loss+" exp points and "+ dx_loss+ " dx points.\n");
   victim->add("combat_exp", -combat_exp_loss);
   victim->add("daoxing", -dx_loss);

        victim->delete("vendetta");
        if( victim->query("thief") )
                victim->set("thief", (int)victim->query("thief") / 2);
//        if( (int)victim->query("potential") > (int)victim->query("learned_points") )
//                victim->add("potential",((int)victim->query("learned_points") - (int)victim->query("potential"))/2 );
        if( random(100)>(int)victim->query("kar") ) 
        {
                victim->set("death/skill_loss",1);
                victim->skill_death_penalty();
        } 
        else    victim->set("death/skill_loss",0);
        victim->save();
}
int nk_gain(object killer, object victim)
{
   string fam, fam1;
   int cla, eff_dx, eff1, eff2, dx, reward, nkgain;

   if( victim->query("no_nk_reward") ) 
      return 0;
   if( victim->query_temp("last_fainted_from")
    && victim->query_temp("last_fainted_from")!=killer->query("id") ) 
      return 0;
   fam = killer->query("family/family_name");
   if( fam && !undefinedp(family[fam]) ) 
   {
      cla = family[fam];
      eff_dx = victim->query("eff_dx");
      nkgain = victim->query("nkgain");
      fam1 = victim->query("family/family_name");
      if( fam1 && fam==fam1 )
         return 0;
      if( eff_dx!=0 && cla*eff_dx>0 )
         return 0;
      if( !eff_dx ) 
      { 
         int dxn = 0;
         eff_dx = (victim->query("daoxing")+victim->query("combat_exp"))/2;
         if( eff_dx>20000 )
            dxn = eff_dx/3;
         else if( eff_dx>5000 )
            dxn = eff_dx/2;
         else    dxn = eff_dx;
         eff_dx = dxn;
      }
      if( !nkgain ) 
      {
         int effdx = eff_dx;
         if( effdx<0 )
            effdx = -effdx;
         if( effdx>667000 ) 
            nkgain = 600;
         else if( effdx>333000 )
            nkgain = 500;
         else if( effdx>100000 )
            nkgain = 400;
         else if( effdx>33000 )
            nkgain = 300;
         else if( effdx>17000 )
            nkgain = 200;
         else if( effdx>5000 )
            nkgain = 150;
         else if( effdx>2000 )
            nkgain = 100;
         else if( effdx>500 )
            nkgain = 50;
         else    nkgain = 25;
            nkgain+= 20;
      }
      if( eff_dx<0 )
         eff_dx=-eff_dx;
      eff1 = eff_dx/8;
      eff2 = eff_dx/4;
      dx = (killer->query("daoxing")+killer->query("combat_exp"))/2;
      if( dx>eff_dx )   reward=0;
      else if( dx>eff2 )     reward=nkgain;
      else if( dx>eff1 )     reward=10*(dx-eff1)/(eff2-eff1)*nkgain/10;
      else          reward=0;

      if( cla==0 || (cla!=0 && !fam1) )
         reward=reward*2/3;
      return reward;
   }
   return 0;
}

int victim_lose(object killer,object victim,string killerid) 
{
   int lose,exp_k,exp_v,lose1;

   if( (wizardp(victim) && !wizardp(killer))
    || (!wizardp(victim)&&wizardp(killer)) )
      return 0;
   if( victim->query_temp("last_fainted_from")
    && victim->query_temp("last_fainted_from")!=killerid ) 
      lose=0;
   else    
   {
      exp_k = killer->query("daoxing");
      exp_v = victim->query("daoxing");
      if( exp_k>exp_v )
      {
         lose=10*exp_v/(exp_k+1)*(4000+exp_v)/500;
         if( exp_k>exp_v*4 ) 
            lose=0;
      } 
   else    lose=(4000+exp_v)/50;  // about 2% lose for victim.
   if( lose<0 )   lose=0;
   if( lose>exp_v )       lose=exp_v;
   }
   lose1 = (int)victim->query("daoxing")/40;
   if( lose>lose1 )       lose=lose1;
   return lose;
}

int check_family(string fam)
{
        if( fam && !undefinedp(family[fam]) )
                return family[fam];
        else    return 0;
}

void super_attack(object me,object target,string clr)
{
        mapping m_act;
        string msg;
        if( !me || !target )
                return;
        m_act = me->query("actions");
        if( !m_act || !mapp(m_act) )
                return;
        msg = m_act["action"]+"\n";
        msg = COLOR_D->clear_color(msg);
        msg = clr+msg+NOR;
        msg = COLOR_D->replace_color(msg);
        do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM,msg);
}

varargs void perform_attack(object me,object target,int damage)
{
        if( !me || !target )
                return;
        me->add_temp("apply/damage",damage);
        do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);
        if( me )
                me->add_temp("apply/damage",-damage);           
}               
                
void apply_damage(object winner, object victim,int damage, string damage_type, string msg_hit)
{
        int temp, type, damage_qi, damage_shen,adjust,success;
        int def_count = 0;
        if( damage <= 0 ) return;
        if(damage_type == "qi" || damage_type == "kee") 
        {
                damage_qi = damage;
                damage_shen = 0;
                type = 0;
        }
        else if(damage_type == "shen" || damage_type == "sen") 
        {
                damage_qi = 0;
                damage_shen = damage;
                type = 1;
        }
        else    
        {
                damage_qi = damage;
                damage_shen = damage;
                type = 2;
        }
	message_combatd(msg_hit, winner, victim);
        if( damage_qi > 0 )
        {
                if( damage_qi>0 )
                {
                        victim->receive_damage("kee", damage_qi, winner,TYPE_PERFORM);
                        victim->receive_wound("kee", damage_qi/2, winner,TYPE_PERFORM);      
                        report_status(victim);        
                }
        }
        if( damage_shen > 0 )
        {
                if( damage_shen>0 )
                {
                        victim->receive_damage("sen", damage_shen, winner,TYPE_PERFORM);
                        victim->receive_wound("sen", damage_shen/2, winner,TYPE_PERFORM);
                        report_sen_status(victim);
                }
        }
        return;
}

int attacking_perform_success(object attacker, object target, int skill_level, int success_adj)
{
   object weapon;  
   int ap, dp, success;
   string skill;
   if( !weapon = attacker->query_temp("weapon") )
      skill = "unarmed";
   else    
   {
      if( weapon->query_temp("original/skill_type2") )
         skill = weapon->query_temp("original/skill_type2");
      else    skill = weapon->query("skill_type");
   }
   ap = skill_power(attacker,skill,SKILL_USAGE_ATTACK);
   dp = skill_power(target,"dodge",SKILL_USAGE_DEFENSE);
   dp+= skill_power(target,"parry",SKILL_USAGE_DEFENSE);
   dp/= 2;
   if( wuxing_restrain(attacker,target)==1 )
      dp-= random(dp/3);      
   if( wuxing_restrain(attacker,target)==-1 )
      dp+= random(dp/3);      
   if( target->is_busy() )
      ap+= random(ap/3);
   if( !living(target) )
      dp = 0;    
   success = 0;
   if( success_adj < 20 )
      success_adj = 20;
   else if( success_adj > 500 )
      success_adj = 500;
   ap = ap*success_adj/100;
   if( random(100)>dp*100/(ap+dp) )
      success = 1;
   return success;
}

int attacking_perform_damage(object attacker, object target, int damage_adj)
{
   int ap,dp,damage;
   object weapon;
   string skill;
   if( damage_adj < 50 )
      damage_adj = 50;
   else if( damage_adj > 200 )
      damage_adj = 200;
   if( !weapon = attacker->query_temp("weapon") )
      skill = "unarmed";
   else    
   {
      if( weapon->query_temp("original/skill_type2") )
         skill = weapon->query_temp("original/skill_type2");
      else    skill = weapon->query("skill_type");
   }
   ap = skill_power(attacker,skill,SKILL_USAGE_ATTACK);
   dp = skill_power(target,"dodge",SKILL_USAGE_DEFENSE);
   dp+= skill_power(target,"parry",SKILL_USAGE_DEFENSE);
   dp/= 2;
   if( wuxing_restrain(attacker,target)==1 )
      dp-= random(dp/3);      
   if( wuxing_restrain(attacker,target)==-1 )
      dp+= random(dp/3);      
   if( target->is_busy() )
      ap+= random(ap/3);
   if( !living(target) )
      dp = 0;    
   if( random(100)>=dp*100/(ap+dp) )
   {
      damage = attacker->query_skill(skill);
      damage+= attacker->query("force_factor")/100;
      damage+= attacker->query_temp("apply/damage");  
      damage-= target->query_temp("apply/armor");
   }
   else if( random(100)>=dp*50/(ap+dp) )
      damage = 0;
   else    
   {
      if( !weapon = target->query_temp("weapon") )
         skill = "unarmed";
      else    
      {
         if( weapon->query_temp("original/skill_type2") )
            skill = weapon->query_temp("original/skill_type2");
         else    skill = weapon->query("skill_type");
      }
      damage = target->query_skill(skill);
      damage+= target->query("force_factor")/100;
      damage+= target->query_temp("apply/damage");    
      damage-= attacker->query_temp("apply/armor");
      damage/= 2;
      damage = -damage;
   }
   if( damage!=0 )         
      damage = damage/100*damage_adj; //last damage scaled again.
   if( wizardp(attacker) )  tell_object(attacker,sprintf("\tap=%d dp=%d lastDamage=%d\n",ap,dp,damage));
   if( wizardp(target) )  tell_object(target,sprintf("\tap=%d dp=%d lastDamage=%d\n",ap,dp,damage));
   return damage;
}

void attacking_perform(
   object attacker,
   object target,
   int skill_level,//the level of skill used to attack.
   int success_adj,
   int damage_adj, //default value is 100 for this 2 parameters.
   string damage_type, //must be "shen"/"sen", "qi"/"kee" or "both"(default)
   string msg_init,
   string msg_success,
   string msg_fail,
   string msg_backfire_init,
   string msg_backfire_success)
{
   
   int damage;
   message_vision( msg_init, attacker, target );

   if( attacking_perform_success(attacker, target, skill_level, success_adj) == 0 )
   {
      if( !attacker->query("env/brief_message") && !target->query("env/brief_message") )   
         message_vision( msg_fail, attacker, target );
      if( attacker && target && attacker->is_fighting(target) )   
         target->kill_ob(attacker);
      return;
   }
   damage = attacking_perform_damage(attacker, target, damage_adj);
   if( damage > 0 ) //attacker hit target
      apply_damage(attacker, target, damage, damage_type, msg_success);
   else if( damage < 0 ) //backfire
   {
      if( !attacker->query("env/brief_message") && !target->query("env/brief_message") )      
         message_vision(msg_backfire_init, attacker, target);
      apply_damage(target, attacker, -damage, damage_type, msg_backfire_success);
   }
   else    message_vision(HIY"结果被$N"HIY"以奋力"+({"架住","闪开",})[random(2)]+"，谁也没有吃亏。\n"NOR, target);
   if( attacker && target && attacker->is_fighting(target) )   
      target->kill_ob(attacker);
   return;
}

void same_attack(object me,object target)
{
   mapping action;
   if( !me || !target || !me->is_fighting(target) )
      return;
   target->reset_action();
   action = target->query("actions");
   if( !action || !mapp(action) )    
      return;
   me->set("actions",action);
   do_attack(me,target,me->query_temp("weapon"),TYPE_PERFORM);
   if( me )  me->reset_action();
}
