string eff_status_msg(int ratio)
{
        if( ratio==100 ) return HIG "看起来气血充盈，并没有受伤。"NOR;
        if( ratio > 95 ) return HIG "似乎受了点轻伤，不过光从外表看不大出来。"NOR;
        if( ratio > 90 ) return HIY "看起来可能受了点轻伤。"NOR;
        if( ratio > 80 ) return HIY "受了几处伤，不过似乎并不碍事。"NOR;
        if( ratio > 60 ) return HIY "受伤不轻，看起来状况并不太好。"NOR;
        if( ratio > 40 ) return HIR "气息粗重，动作开始散乱，看来所受的伤着实不轻。"NOR;
        if( ratio > 30 ) return HIR "已经伤痕累累，正在勉力支撑着不倒下去。"NOR;
        if( ratio > 20 ) return HIR "受了相当重的伤，只怕会有生命危险。"NOR;
        if( ratio > 10 ) return RED "伤重之下已经难以支撑，眼看就要倒在地上。"NOR;
        if( ratio > 5  ) return RED "受伤过重，已经奄奄一息，命在旦夕了。"NOR;
        return RED "受伤过重，已经有如风中残烛，随时都可能断气。"NOR;
}

string status_msg(int ratio)
{
        if( ratio==100 ) return HIG "看起来充满活力，一点也不累。"NOR;
        if( ratio > 95 ) return HIG "似乎有些疲惫，但是仍然十分有活力。"NOR;
        if( ratio > 90 ) return HIY "看起来可能有些累了。"NOR;
        if( ratio > 80 ) return HIY "动作似乎开始有点不太灵光，但是仍然有条不紊。"NOR;
        if( ratio > 60 ) return HIY "气喘嘘嘘，看起来状况并不太好。"NOR;
        if( ratio > 40 ) return HIR "似乎非常疲惫，看来需要好好休息了。"NOR;
        if( ratio > 30 ) return HIR "已经一副头重脚轻的模样，正在勉力支撑着不倒下去。"NOR;
        if( ratio > 20 ) return HIR "看起来已经力不从心,马上要支持不住了。"NOR;
        if( ratio > 10 ) return RED "摇头晃脑、歪歪斜斜地站都站不稳，眼看就要倒在地上。"NOR;
        return RED "已经陷入半昏迷状态，随时都可能摔倒晕去。"NOR;
}

string sen_status_msg(int ratio)
{
        if( ratio==100 ) return HIG "看起来头脑清醒，一点也不迷糊。"NOR;
        if( ratio > 90 ) return HIG "拍了拍自己的脑袋，似乎有点不太得劲。"NOR;
        if( ratio > 80 ) return HIY "看起来有些迷糊了。"NOR;
        if( ratio > 60 ) return HIY "的确有点迷糊了，但还辨得出东西南北。"NOR;
        if( ratio > 40 ) return HIR "两眼发直，口角流涎，神智开始混乱。"NOR;
        if( ratio > 20 ) return HIR "迷迷糊糊，摇摇晃晃，已经辨不出东西南北了。"NOR;
        if( ratio > 10 ) return RED "神智已经处在极度混乱中,再也支持不住了。"NOR;
        return RED "心智已经完全迷失，随时都有可能背过气去。"NOR;
}                       

varargs void report_status(object ob, int effective)
{
	string str;
	if( str=ob->query_report_status() )
		message_vision( "( $N"+str+" )\n",ob);
	else if( effective ) 
                message_vision( "( $N" + eff_status_msg((int)ob->query("eff_kee") * 100 /(1+(int)ob->query("max_kee")))+ " )\n", ob);
        else    message_vision( "( $N" + status_msg((int)ob->query("kee") * 100/(1+(int)ob->query("max_kee")) ) + " )\n", ob);
}

varargs void report_sen_status(object ob, int effective)
{
	string str;
	if( str = ob->query_report_sen_status() )
		message_vision( "( $N"+str+" )\n",ob);
	else	message_vision( "( $N" + sen_status_msg((int)ob->query("sen") * 100 /(1+(int)ob->query("max_sen")) ) + " )\n", ob);
}

string damage_msg(int damage, string type)
{
        if( damage == 0 ) 
                return "结果没有造成任何伤害。\n";
        if( member_array(type,keys(damage_msgs))==-1 )
                type = "其他";
        if( damage<10 ) 
                return damage_msgs[type][0];
        else if( damage<20 ) 
                return damage_msgs[type][1];
        else if( damage<40 ) 
                return damage_msgs[type][2];
        else if( damage<60 ) 
                return damage_msgs[type][3];
        else if( damage<80 ) 
                return damage_msgs[type][4];
        else    return damage_msgs[type][5];
}

mapping KillMsg = ([
        "slash"         : "斩",         "slice"         : "砍",
        "chop"          : "劈",         "hack"          : "劈",
        "thruse"        : "刺",         "pierce"        : "刺",
        "wave"          : "鞭",         "whip"          : "抽",
        "impale"        : "戳",         "rake"          : "筑",
        "bash"          : "砸",         "crush"         : "砸",
        "slam"          : "挫",         "throw"         : "射",
        "shoot"         : "射",         
]);

int victim_lose(object killer,object victim,string killerid);
void victim_penalty(object victim);
int nk_gain(object killer, object victim);
int check_family(string fam);

void create()
{
        seteuid(getuid());
        set("name", "战斗精灵");
        set("id", "combatd");
}

varargs int skill_power(object ob, string skill, int usage)
{
        int status, level,pp,percent = 0;
        int power,tmp;
        float x,y,z,p;
        string msg = "";
        if( !ob || !living(ob) ) return 0;

        level = ob->query_skill(skill);
        if( level<=0 )
                level = 0;
        switch(usage) 
        {
                case TYPE_PERFORM:
                case SKILL_USAGE_ATTACK:
                        level = ob->eff_skill_level(level, SKILL_USAGE_ATTACK);
                        level += ob->query_temp("apply/attack");
                        break;
                case SKILL_USAGE_DEFENSE:
                        level = ob->eff_skill_level(level, SKILL_USAGE_DEFENSE);
                        level += ob->query_temp("apply/defense");
                        break;
        }
        if( !level ) return ob->query("combat_exp");
        
        // 门派技能
        pp = 100;
        // 月宫弟子冷月凝香舞提高命中及回避等级
        if( ob->query_skill("moondance", 1)>=100 && !undefinedp(ob->query("family")) && ob->query("family/family_name")=="月宫" )
                percent = ob->query_skill("moondance",1)/50;
        // 普陀莲台心法提高staff命中
        else if( ob->query_skill("lotusforce", 1) >= 100
                && usage == SKILL_USAGE_ATTACK
                && skill == "staff"
                && ob->query_skill_mapped("staff") == "lunhui-zhang" )
                percent = ob->query_skill("lotusforce", 1) / 80;
        // 地府杀气增加命中 
        else if( !undefinedp(ob->query("family")) && ob->query("family/family_name")=="阎罗地府" 
                && ob->query("bellicosity")>=500 )
                percent = ob->query("bellicosity")/300;
        // 方寸两仪剑法提高命中
        else if( !undefinedp(ob->query("family")) && ob->query("family/family_name")=="方寸山三星洞" 
                && ob->query_skill("liangyi-sword",1)>1 )
                percent = ob->query_skill("liangyi-sword",1)/70;
        //雪山throwing提高命中
        else if( !undefinedp(ob->query("family")) && ob->query("family/family_name")=="大雪山" 
                && ob->query_skill("throwing",1)>1 )
                percent = ob->query_skill("throwing",1)/60;
        //将军府雁行步法增加命中
        else if( !undefinedp(ob->query("family")) && ob->query("family/family_name")=="将军府" 
                && ob->query_skill("yanxing-steps",1)>1 )
                percent = ob->query_skill("yanxing-steps",1)/90;
        //盘丝洞驻颜术增加命中
        else if( !undefinedp(ob->query("family")) && ob->query("family/family_name")=="盘丝洞" 
                && ob->query_skill("zhuyan",1)>1 )
                percent = ob->query_skill("zhuyan",1)/50;
        //百花谷驻颜术增加纵横剑法的命中
        else if( !undefinedp(ob->query("family")) && ob->query("family/family_name")=="百花谷" 
                && usage == SKILL_USAGE_ATTACK
                && skill == "sword"
                && ob->query_skill_mapped("sword") == "zongheng-sword" 
                && ob->query_skill("zhuyan",1)>1 )
                percent = ob->query_skill("zhuyan",1)/60;   
        //无底洞追腥逐血状态增加剑法命中
        else if( !undefinedp(ob->query("family")) && ob->query("family/family_name")=="陷空山无底洞" 
                && usage == SKILL_USAGE_ATTACK
                && skill == "sword"
                && ob->query_temp("zxzx")
                && ob->query_skill("qixiu-jian",1)>100 )
                percent = ob->query_skill("qixiu-jian",1)/60;    
        p = to_float(pp);
        p+= to_float(percent);
        // 新公共技能 器械格斗 提高命中
        //可提高其他武功的命中最多20%，放在这里可以适当缓和威力的提高比例        
        if( ob->query_skill("qixie-gedou",1)>100 )
        {
                if( (attack_skill == "staff" && ob->query_skill_mapped(attack_skill) == "lunhui-zhang") 
                 || (attack_skill == "whip" && ob->query_skill_prepared(attack_skill) == "hellfire-whip") 
                 || (attack_skill == "stick" && ob->query_skill_prepared(attack_skill) == "qianjun-bang") 
                 || (attack_skill == "sword" && ob->query_skill_prepared(attack_skill) == "snowsword") 
                 || (attack_skill == "whip" && ob->query_skill_prepared(attack_skill) == "jueqingbian") 
                 || (attack_skill == "sword" && ob->query_skill_prepared(attack_skill) == "bainiao-jian") 
                 || (attack_skill == "fork" && ob->query_skill_prepared(attack_skill) == "fengbo-cha") 
                 || (attack_skill == "axe" && ob->query_skill_prepared(attack_skill) == "sanban-axe") 
                 || (attack_skill == "mace" && ob->query_skill_prepared(attack_skill) == "jinglei-mace") 
                 || (attack_skill == "spear" && ob->query_skill_prepared(attack_skill) == "bawang-qiang") 
                 || (attack_skill == "mace" && ob->query_skill_prepared(attack_skill) == "wusi-mace") 
                 || (attack_skill == "spear" && ob->query_skill_prepared(attack_skill) == "wuyue-spear") 
                 || (attack_skill == "blade" && ob->query_skill_prepared(attack_skill) == "kugu-blade") 
                 || (attack_skill == "sword" && ob->query_skill_prepared(attack_skill) == "yujianshu") 
                 || (attack_skill == "sword" && ob->query_skill_prepared(attack_skill) == "chixin-jian") 
                 || (attack_skill == "whip" && ob->query_skill_prepared(attack_skill) == "yinsuo-jinling") 
                 || (attack_skill == "sword" && ob->query_skill_prepared(attack_skill) == "zongheng-sword") 
                 || (attack_skill == "blade" && ob->query_skill_prepared(attack_skill) == "pomo-blade")
                 || (attack_skill == "sword" && ob->query_skill_prepared(attack_skill) == "qinglian-jian") )
                        p+= to_float(ob->query_skill("qixie-gedou",1))/25;
                 else   p+= to_float(ob->query_skill("qixie-gedou",1))/50;      
        }
/*经脉修炼
　  阳脉-提升气血值     阴脉-提升防御力 
　　维脉-提升法力值     任脉-提升命中率
　　督脉-提升暴击率     冲脉-提升闪躲值
　　奇脉-提升攻击力     带脉-提升全抗属性
*/
        if( ob->query("经脉修炼/任")>1 ) 
                p+= to_float(ob->query("经脉修炼/任"));
        p/= 100;
        if( environment(ob) && environment(ob)->query("combat_room") )
        	msg+= ob->query("id")+"["+skill+">"+level+"]: 命中附加="+p;
	if( level>2000 )
		level = 2000;
	if( level>100 )
		power = level/10*level*level;			        	
        else	power = level*level*level/10;
        if( environment(ob)->query("combat_room") )
                msg+= "  技能乘3方后="+power;
	x = to_float(power);
	x = x*p;
	power = to_int(x);	        
        if( !valid_move(ob) )
                power = power/10*9;
        power+= ob->query("combat_exp");
        if( ob->is_busy() )  power = power/10*8;
        if( environment(ob)->query("combat_room") )
                msg+= "  技能加武学:"+ob->query("combat_exp")+"后，最后取值："+power+"\n";
        if( msg!="" )
                tell_room(environment(ob),msg);          
        return power;
}  

//五行相克 金克木,木克土,土克水,水克火,火克金
//返回值
// 1 . 克
// 0 . 一般
// -1. 被克
int wuxing_restrain(object who,object victim)
{
        string my,his;  
        mapping ttype = ([
                "jin"   : "mu",
                "mu"    : "tu",
                "tu"    : "shui",
                "shui"  : "huo",
                "huo"   : "jin",
        ]);     
                
        if( !who || !victim )  return 0;
        my = RANK_D->query_wuxing(who);
        his = RANK_D->query_wuxing(victim);
        if( my=="none" || his=="none" )
                return 0;
        if( ttype[my]==his )
                return 1;
        if( ttype[his]==my )
                return -1;              
        return 0;
}

//门派相克，1为相克
int family_restrain(object me,object victim)
{
	if( !me || !victim )
		return 0;
	if( !me->query("family/family_name")
	 || !victim->query("family/family_name") )
		return 0;	 
	return family_xk[victim->query("family/family_name")]==me->query("family/family_name");
}

varargs int do_attack(object me, object victim, object weapon, mixed attack_type,string combat_msg,int damage)
{
	mapping my, your, action, victim_action;
	string limb, *limbs, result,damage_info = "";
	string attack_skill, force_skill, martial_skill, dodge_skill, parry_skill;
	int dp,ap,mod_val,pp,defense_factor,my_exp,vfp,afp,force_adj,damage1, damage_bonus,fbp;
	mixed foo;
	int wounded = 0;
	int bjp = 0; 
	float x;
	int baoji = 0;

        if( !me )
        {
        	log_file("combat_err","["+XYJTIME_D->chinese_time(time())+"] 战斗出错，没有攻击方.\n");
        	return 0;	
        }
        if( !victim )
        {
        	log_file("combat_err","["+XYJTIME_D->chinese_time(time())+"] 战斗出错，没有被攻击方.\n");
        	return 0;	
        }
        if( me->is_ghost() || victim->is_ghost() ) 
        	return 1;

	if( environment(me)->query("no_fight")) 
        {
                message_vision("$N和$n各自退了一步，收住了招。\n", me, victim);
                me->remove_enemy(victim);
                victim->remove_enemy(me);
                return 0;
        }
        if( environment(me) != environment(victim)) 
        {
                me->remove_enemy(victim);
                victim->remove_enemy(me);
                return 0;
        }
	if( !attack_type || !intp(attack_type) )
		attack_type = TYPE_COMBAT;
	my = me->query_entire_dbase();
	your = victim->query_entire_dbase();

// (1) Find out what action the offenser will take.
	action = me->query("actions");
	if( !action || !mapp(action) ) 
	{
		me->reset_action();
		action = me->query("actions");
		if( !action || !mapp(action) ) 
		{
			CHANNEL_D->do_channel( this_object(), "sys",sprintf("%s(%s): bad action = %O",me->name(1), me->query("id"), me->query("actions")));
			log_file("combat_err",sprintf("[%s]%s(%s): bad action = %O\n",XYJTIME_D->chinese_time(time()),me->name(1), me->query("id"), me->query("actions")));
			return 0;
		}
	}
	limbs = victim->query("limbs");
	if( !arrayp(limbs)) 
	{ 
        	limbs = ({ "身体" }); 
		log_file("combat_err",sprintf("[%s]%s(%s): limb缺失.\n",XYJTIME_D->chinese_time(time()),me->name(1), me->query("id")));        	
                victim->set("limbs", limbs); 
	} 
	limb = limbs[random(sizeof(limbs))]; 	
	if( combat_msg && strlen(combat_msg)>0 )
	{
		combat_msg = replace_string(combat_msg,"$l",limb);
		if( weapon )
			combat_msg = replace_string(combat_msg,"$w",weapon->name());
		else	combat_msg = replace_string(combat_msg,"$w","劲风");
		if( victim->query_temp("weapon") )
			combat_msg = replace_string(combat_msg,"$W",(victim->query_temp("weapon"))->name());
		else	combat_msg = replace_string(combat_msg,"$W","劲风");
		if( !me->query_temp("pfm_msg") )
			message_combatd(combat_msg,me,victim,"");
		else	message_vision(combat_msg,me,victim,"");	
		result = "";
	}
	else
	{
		result = action["action"];
		result = replace_string(result,"\n","");
       		if( me->query_temp("action_flag") )
			result = "紧跟着" + result; 
       		if( !me->query_temp("pfm_msg") )   result+= "\n";	
       	}	
// (2) Prepare AP, DP for checking if hit.
	if( objectp(weapon) )	
	{
		if( weapon->query("use_apply_skill") )
        		attack_skill = weapon->query("apply/skill_type");
            	else	attack_skill = weapon->query("skill_type");
        }
	else	attack_skill = "unarmed";


//JLDL
       if ( victim->query_temp("jldl") && living(victim) )       //如果敌人运用了jldl,而且不是晕的                          
       {
       	    	afp = skill_power(me, "force", SKILL_USAGE_ATTACK);
       	    	if( afp<1 )
       	    		afp = 1;
            	vfp = skill_power(victim, "force", SKILL_USAGE_DEFENSE);
            	if( vfp<1 )
            		vfp = 1;
            	mod_val = 0;
            	mod_val -= random(25);
            	if( !victim->query_temp("weapon") ) 
            		mod_val += 10;
		mod_val = (100 + mod_val);
		mod_val = mod_val*vfp/1000;
		if( mod_val<1 )
			mod_val = 1;	
		force_adj = random(afp+vfp);				            	
	}
       	else 
	{
       		force_adj=1;
       		mod_val=1;
	}
        if ( force_adj>mod_val )
        {
		foo = "/daemon/class/puti/wuxiangforce/jldl.c"->jldl_result(victim, me, mod_val, force_adj,action);
                result += foo;
                damage = RESULT_FORCE;
        }    

	else
	{
////////////////////////////////////////////////////////

	ap = skill_power(me, attack_skill, SKILL_USAGE_ATTACK);
//五行相克，命中增加10%
	if( wuxing_restrain(me,victim)==1 )
	        ap+= random(ap/3);
//门派克制，命中增加，反之降低，否则不变
	if( family_restrain(me,victim)==1 )
	        ap-= random(ap/3);
//加力0增加命中
	if( attack_type==TYPE_PERFORM )
	{
		if( me->query("force_factor")==0 )
			ap+= random(ap/3);
	}		
	else if( family_restrain(me,victim)==-1 )
		ap-= random(ap/3);		
//重要部位的伤害，命中减低10%		
        if( member_array(limb, danger_limbs)!= -1 )
        	ap-= random(ap/5);
	if( attack_type && attack_type==TYPE_PERFORM )
		ap+= random(ap/3);
//怒气导致暴击	
	if( me->query_temp("anger")>99 ) 
	{
		ap = ap*2;
		bjp = me->query_temp("apply/baoji");
		bjp = 1;
		if( bjp<=0 ) bjp = 0;
		if( bjp>100 ) bjp = 100;
		if( random(100)>50/(bjp+50)*100 )
		{
			baoji =1;
			me->set_temp("anger",0);
			damage_info+= BLINK HIY"$N"BLINK HIY"怒气冲天，打出了一击暴击！\n"NOR;
		}
	}	

	dp = skill_power(victim, "dodge", SKILL_USAGE_DEFENSE);
	if(living(victim)) 
		dodge_skill = victim->query_skill_mapped("dodge");
	else	dodge_skill = 0;
	mod_val = 1;
	if( dodge_skill )  
	{
        	victim_action = SKILL_D(dodge_skill)->query_action();
	   	if( victim_action && victim_action["dodge_power"] )
	      		mod_val = victim_action["dodge_power"];
	}
	if( dodge_skill && action["dodge"] )  
		mod_val += action["dodge"];
	mod_val = mod_val+mod_val/100;			
// (3) Fight!
	if( random(ap + dp) < mod_val )
	{
		if( !dodge_skill ) 
		{
			dodge_skill = "dodge"; 
           		result += SKILL_D(dodge_skill)->query_dodge_msg(limb);
		}
		else   
		{
           		if( victim_action && victim_action["dodge_action"] )
				result += victim_action["dodge_action"];
			else	result += SKILL_D(dodge_skill)->query_dodge_msg(limb);
		}

		if( dp<ap && (!userp(victim) || !userp(me)) 
		&& random(sizeof(victim->query_enemy())) < 4
		&& random(your["sen"]*100/your["max_sen"] + your["int"]*your["cps"]) > 150 ) 
		{
			victim->add("combat_exp",1);
			victim->improve_skill("dodge", 1);
		}

		// This is for NPC only. NPC have chance to get exp when fail to hit.
		if( ap<dp && !userp(me) ) 
		{
			if( random(my["int"]) > 15 ) 
				me->add("combat_exp",1);
			me->improve_skill(attack_skill, random(my["int"]));
		}
		damage = RESULT_DODGE;
	} 
	else 
	{
//(4) Check if the victim can parry this attack.
		if( victim->query_temp("weapon") ) 
		{
			pp = skill_power(victim, "parry", SKILL_USAGE_DEFENSE);
			if( !weapon ) pp*= 2;
			parry_skill = victim->query_skill_mapped("parry");
		} 
		else 
		{
			if( weapon ) 
				pp = 0;
			else 	pp = skill_power(victim, "unarmed", SKILL_USAGE_DEFENSE);
			parry_skill = victim->query_skill_mapped("unarmed");
		}
		mod_val = 1;
        	if( action["parry"] )       
        		mod_val = action["parry"];
        	mod_val = mod_val+mod_val/100;	
		
		if( random(ap + pp)< mod_val ) 
		{
			if( !parry_skill ) parry_skill = "parry";
			dodge_skill = SKILL_D(parry_skill)->query_parry_msg(weapon);
			if( dodge_skill )
				result += dodge_skill;
			else	result += SKILL_D("parry")->query_parry_msg(weapon);
			
			if( pp<ap && (!userp(victim) || !userp(me)) 
			&&  	random(sizeof(victim->query_enemy())) < 4
			&&	random(your["sen"]*100/your["max_sen"] + your["int"]*your["cps"]) > 150 ) 
			{
				victim->add("combat_exp",1);
				victim->improve_skill("parry", 1);
			}
			damage = RESULT_PARRY;
		} 
		else 
		{
//(5) We hit the victim and the victim failed to parry
			if( attack_type==TYPE_PERFORM )
			{
				if( !damage )  damage = 0;
			}
			else	damage = 0;	
			damage+= me->query_temp("apply/damage");
			damage = (damage + random(damage)) / 2;
			if( weapon )
				damage+= weapon->valid_damage(me,victim,damage);
			if( action["damage"] )
				damage += action["damage"] * damage / 100;
			damage_bonus = me->query_str()/10; 
			if( my["force_factor"] && (my["force"] > my["force_factor"]) ) 
			{
				if( force_skill = me->query_skill_mapped("force") ) 
				{
					foo = SKILL_D(force_skill)->hit_ob(me, victim, damage_bonus, my["force_factor"]);
					if( stringp(foo) ) damage_info += foo;
					else if( intp(foo) ) damage_bonus += foo;
				}
			}
			if( action["force"] )
				damage_bonus += action["force"] * damage_bonus / 100;
			if( martial_skill = me->query_skill_mapped(attack_skill)  ) 
			{
				foo = SKILL_D(martial_skill)->hit_ob(me, victim, damage_bonus);
				if( stringp(foo) ) damage_info += foo;
				else if(intp(foo) ) damage_bonus += foo;
			}
			if( weapon  ) 
			{
				foo = weapon->hit_ob(me, victim, damage_bonus);
				if( stringp(foo) ) damage_info += foo;
				else if(intp(foo) ) damage_bonus += foo;
			} 
			else
			{
				foo = me->hit_ob(me, victim, damage_bonus);
				if( stringp(foo) ) damage_info += foo;
				else if(intp(foo) ) damage_bonus += foo;
			}
			if( damage_bonus > 0 )
				damage += (damage_bonus + random(damage_bonus))/3;
			if( damage < 0 ) damage = 0;
			//暴击
			if( baoji>0 )
			{
				damage = damage*3;
				damage = damage/2+random(damage/2);
				baoji = 0;
			}

                        // 根据攻击的部位影响伤害
       	                if( !undefinedp(limb_damage[limb]) )
               	                damage = (damage * limb_damage[limb] / 100);
			if( victim->query("character") == "光明磊落" )
				damage-= damage/5;
			if( damage>150 && victim->query_temp("armor/FABAO") && !me->query_temp("pfm_msg") )
			{
				fbp = victim->query_temp("armor/FABAO")->protect_qi(damage);
				if( fbp>=damage/5 )
					damage = fbp;
			}	
			if( damage<0 )
				damage = 0;							
			
			// Let combat exp take effect
			
			defense_factor = victim->query("combat_exp");
			my_exp = me->query("combat_exp");
			while( random(defense_factor)>my_exp )
			{
				damage -= damage / 3;
                                defense_factor/= 5;
			}
			damage-= (1+random(victim->query("apply/armor")));
			if( damage<0 ) damage = 0;			
			damage = victim->receive_damage("kee",damage,me,attack_type);
			if( damage>10 )
			{
				switch( limb ) 
                        	{
                        		// 头、颈受伤会伤一些神。
                	        	case "头部":
                        		case "颈部":
                                		damage /= 5;
						if( victim->query_temp("armor/FABAO") )
						{
							fbp = victim->query_temp("armor/FABAO")->protect_shen(damage);
							if( fbp>=150 )
								damage = fbp;
						}	
						victim->receive_damage("sen", damage, me ,attack_type);
                	                	fbp = victim->query("sen")*100/victim->query("max_sen");
                        	        	if( fbp <= 30 )
                                	        	damage_info+= head_damage_me_msg[2];
	                                	else if( fbp<= 70 )
        	                                	damage_info+= head_damage_me_msg[1];
                	                	else	damage_info+= head_damage_me_msg[0];
                                		break;
                        		// 击中这些部位真气会受到振荡。
		                        case "胸口":
        		                case "后心":
                		        case "小腹":
                        		       	if( victim->query("max_force") && victim->query("force"))
                                		{
                                        		damage /= 8;
	                                	        if( victim->query("force") <= damage )
        	                                	        victim->set("force", 0);
	        	                                else	victim->add("force", -damage);
	                	                        if( damage <= 500 )
        	                	                        damage_info+= replace_string(body_damage_me_msg[0],"$l",limb);
                	                	        else if( damage <= 1000 )
                        	                	        damage_info+= replace_string(body_damage_me_msg[1],"$l",limb);
	                                	        else	damage_info+= replace_string(body_damage_me_msg[2],"$l",limb);
        	                        	}
                                	break;
                        	}				
			}

			if( (me->is_killing(victim) || weapon)
			&& random(damage) > (int)victim->query_temp("apply/armor") ) 
			{
				wounded = damage-(int)victim->query_temp("apply/armor");
				victim->receive_wound("kee",wounded, me,attack_type);
			}
			if( !me->query_temp("pfm_msg") )
				result += damage_msg(damage, action["damage_type"]);
			// 由于受到伤害，victim产生愤怒，愤怒值随着伤害大小而变
			if( damage > victim->query("max_kee")/5)
				victim->add_temp("anger",1+random(3));
			else	victim->add_temp("anger",1);
			
			//(7) Give experience
			if( !userp(me) || !userp(victim) ) 
			{
				if( ap<dp
				 && (random(my["sen"]*100/my["max_sen"] + my["int"]*my["cps"]) > 150) ) 
				{
					me->add("combat_exp",1);	
					if( my["potential"] - my["learned_points"] < 100 )
						my["potential"] += 1;
					me->improve_skill(attack_skill, 1);
				}
				if( random(your["max_kee"] + your["kee"]) < damage ) 
				{
					victim->add("combat_exp",1);
					if( your["potential"] - your["learned_points"] < 100 )
						your["potential"] += 1;
				}
			}
		}
	} 
//////////////////////////////////
	}
	result = replace_string( result, "$l", limb );
	if( stringp(action["weapon"]) )
		result = replace_string( result, "$w", action["weapon"] );
	else if( objectp(weapon) )
		result = replace_string( result, "$w", weapon->name() );
        else if( attack_skill == "unarmed" || attack_skill == "unarmed")
                result = replace_string(result, "$w", "手指" );
        else if( attack_skill == "strike" || attack_skill == "parry")
                result = replace_string(result, "$w", "手掌" );
        else    result = replace_string(result, "$w", "拳头" );

	damage_info = replace_string( damage_info, "$l", limb );
	if( stringp(action["weapon"]) )
		damage_info = replace_string( damage_info, "$w", action["weapon"] );
	else if( objectp(weapon) )
		damage_info = replace_string( damage_info, "$w", weapon->name() );
        else if( attack_skill == "unarmed" || attack_skill == "unarmed")
                damage_info = replace_string(damage_info, "$w", "手指" );
        else if( attack_skill == "strike" || attack_skill == "parry")
                damage_info = replace_string(damage_info, "$w", "手掌" );
        else    damage_info = replace_string(damage_info, "$w", "拳头" );


	if( objectp(victim->query_temp("weapon")) )
		result = replace_string( result, "$W",victim->query_temp("weapon")->name() );
	else	result = replace_string( result, "$W","双掌");
	if( me->query_temp("pfm_msg") )
		damage_info = 0;
	message_combatd(result, me, victim, damage_info,damage,wounded);

	if( damage > 0 ) 
	{
		if( !me->query_temp("pfm_msg") )
			report_status(victim, wounded);
                if( attack_type!=TYPE_QUICK && me->query_temp("zxzx") == 1 )
                        "/daemon/class/yaomo/wudidong/qixiu-jian/zxzx"->zxzx_effect(me,victim);
/*
                if( attack_type!=TYPE_QUICK && me->query_temp("santouliubi") )
                        "/daemon/class/puti/qianjun-bang/santouliubi"->stlb(me);
*/
                if( me->is_busy() ) me->interrupt_me(me, 30 + random(10));
		if( (!me->is_killing(your["id"])) && (!victim->is_killing(my["id"])) )
                {
                        if( victim->query("kee") < victim->query("max_kee") * 50 / 100)
                        {
                                me->remove_enemy(victim);
                                victim->remove_enemy(me);
                                message_vision( winner_msg[random(sizeof(winner_msg))], me, victim);
                        }
                }
        }
	if( functionp(action["post_action"]) )
		evaluate( action["post_action"], me, victim, weapon, damage);

	if( damage > 0 && attack_type != TYPE_QUICK &&
	me->query_temp("perf_quick") && me->is_fighting(victim) )   
	{
        	if( me->query_temp("weapon") && me->query_temp("perf_quick/"+me->query_temp("weapon")->query("skill_type")) )  
        	{
        		if( !me->query("env/brief_message") && !victim->query("env/brief_message") )
        		{
           			if( me->query_temp("perf_quick/msg") )
               				message_vision(CYN + me->query_temp("perf_quick/msg") +NOR, me, victim);
           			else	message_vision(CYN"$N"NOR CYN"得势不饶人，对$n"NOR CYN"展开连续攻击。"NOR, me, victim);
           		}	
           		do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
           		return 1;
        	}
    	}

	if( attack_type==TYPE_REGULAR
	 && damage < 1
	 && victim->query_temp("guarding") ) 
	{
		victim->set_temp("guarding", 0);
		if( random(my["cps"]) < 5 ) 
		{
			if( !me->query("env/brief_message") && !victim->query("env/brief_message") )
				message_vision(CYN"$N"NOR CYN"一击不中，露出了破绽！\n"NOR, me);
			do_attack(victim, me, victim->query_temp("weapon"), TYPE_QUICK);
		} 
		else 
		{
			if( !me->query("env/brief_message") && !victim->query("env/brief_message") )
				message_vision(WHT"$N"NOR WHT"见$n"NOR WHT"攻击失误，趁机发动攻击！\n"NOR, victim, me);
			do_attack(victim, me, victim->query_temp("weapon"), TYPE_RIPOSTE);
		}
	}
	return damage;     
}

void fight(object me, object victim)
{
        object ob;

        if( !living(me) || !victim ) 
                return;
        if( me->query_temp("netdead") && !me->query_temp("pkmeet/begin") )  
                return;
        if( victim->query_temp("netdead") && !victim->query_temp("pkmeet/begin"))   
        {
                if( member_array( me, victim->query_netdead_enemy() ) == -1 )
                        return;     // can't start fight if the victim is already netdead
        }
        if( !me->visible(victim)
        && (random(100 + (int)me->query_skill("perception")) < 100) )
                return;
        if( victim->is_busy() || !valid_move(victim) || !living(victim) ) 
        {
                me->set_temp("guarding", 0);
                if( !victim->is_fighting(me) ) victim->fight_ob(me);
                do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
        } 
        else if( random( (int)victim->query("cps") * 3 ) < ((int)me->query("cor") + (int)me->query("bellicosity") / 50) ) 
        {
                me->set_temp("guarding", 0);
                if( !victim->is_fighting(me) ) victim->fight_ob(me);
                do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR);
        } 
        else if( !me->query_temp("guarding") ) 
        {
                me->set_temp("guarding", 1);
                if( !me->query("env/brief_message") && !victim->query("env/brief_message") )    
                        message_vision( guard_msg[random(sizeof(guard_msg))], me, victim);
        } 
        return;
}

//  auto_fight()
void auto_fight(object me, object obj, string type)
{
        if( !userp(me) && !userp(obj) ) return;
        if( me->query_temp("looking_for_trouble") ) return;
        me->set_temp("looking_for_trouble", 1);
        call_out( "start_" + type, 0, me, obj);
}

void start_berserk(object me, object obj)
{
        int bellicosity;
        if( !me ) return;// Are we still exist( not becoming a corpse )?
        me->set_temp("looking_for_trouble", 0);
        if( !obj ) return;
        if( wizardp(obj) ) return;  
        if( me->is_fighting(obj)                // Are we busy fighting?
        || !living(me)                         // Are we capable for a fight?
        || environment(me)!=environment(obj)   // Are we still in the same room?
        || environment(me)->query("no_fight") )  // Are we in a peace room?
                return;
        bellicosity = (int)me->query("bellicosity");
        message_vision("$N用一种异样的眼神扫视着在场的每一个人。\n", me);
        if( (int)me->query("force") > (random(bellicosity) + bellicosity)/2 ) 
                return;
        if( bellicosity > 100000000 &&  !wizardp(obj) ) 
        {// auto kill, mark my_killer_list. -- mon 9/23/98
                message_vision(HIW"\n$N"HIW"对着$n"HIW"喝道：" + RANK_D->query_self_rude(me)+ HIW"看你实在很不顺眼，去死吧。\n"NOR, me, obj);
                me->set_temp("kill/target/"+obj->query("id"),1); 
                me->kill_ob(obj);
        } 
        else    
        {
                message_vision(HIW"\n$N"HIW"对着$n"HIW"喝道：喂！" + RANK_D->query_rude(obj)+ HIW"，" + RANK_D->query_self_rude(me) + HIW"正想找人打架，陪我玩两手吧！\n"NOR,me, obj);
                me->fight_ob(obj);
        }
}

void start_hatred(object me, object obj)
{
        if( !me || !obj ) return;               // Are we still exist( not becoming a corpse )?
        me->set_temp("looking_for_trouble", 0);
        if( me->is_fighting(obj)                // Are we busy fighting?
        || !living(me)                         // Are we capable for a fight?
        || environment(me)!=environment(obj)   // Are we still in the same room?
        || environment(me)->query("no_fight") )  // Are we in a peace room?
                return;
        message_vision( catch_hunt_msg[random(sizeof(catch_hunt_msg))], me, obj);
        me->kill_ob(obj);
}

void start_vendetta(object me, object obj)
{
        if( !me || !obj ) return;               // Are we still exist( not becoming a corpse )?
        me->set_temp("looking_for_trouble", 0);
        if( me->is_fighting(obj)                // Are we busy fighting?
        || !living(me)                         // Are we capable for a fight?
        || environment(me)!=environment(obj)   // Are we still in the same room?
        || environment(me)->query("no_fight") )  // Are we in a peace room?
                return;
        me->kill_ob(obj);
}

