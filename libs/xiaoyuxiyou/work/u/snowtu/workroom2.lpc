#include <ansi.h>
inherit ROOM;

void create ()
{
	set ("short", "CPU");
	setup();
}

void init()
{
	add_action("do_code","zuixin");
	add_action("do_code2","txt");
}

int do_code()
{
	string *dir,*files,file,tmp,str;
	int i,k,j;
	
	dir = get_dir("/html/");
	for(i=0;i<sizeof(dir);i++)
	{
		
		file = "/html/"+dir[i]+"/";
		files = get_dir(file);
               if( !files ) continue;
		files = sort_array(files,-1);
		for(k=0;k<sizeof(files);k++)
		{
			reset_eval_cost();
			if( k<=1 )
				continue;
			tmp = files[k];
			rm(file+tmp);			
		}
	}
	write("ok\n");
	return 1;
}		
	
int do_code2( )
{
	mixed *file,*dirs;
	string dir,str,arg,msg,msg2;
	int i,k;
	
	dirs = get_dir("/html/",-1);
	str = "";
	for(i=0;i<sizeof(dirs);i++)
	{
		arg = dirs[i][0];
		str+= arg+"\n";	
	}
	set_temp("liu",dirs);
	write_file("/doc/html.txt",str,1);
	return 1;
}		