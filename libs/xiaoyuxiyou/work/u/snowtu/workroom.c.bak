int do_code(string cc)
{
	mixed *file,*dirs;
	string dir,str,arg,msg,msg2,aa;
	int i,k;
	
	dirs = get_dir("/HTML/");
	for(i=0;i<sizeof(dirs);i++)
	{
		dir = "/HTML/"+dirs[i];	
		file = get_dir( dir+"/*.htm");
		if( !sizeof(file) )
			continue;
		
		for(k=0;k<sizeof(file);k++)	
		{
			str = file[k];
			if( !str )
				continue;
			sscanf(str,"%s.htm",arg);
			msg = read_file(dir+"/"+str);
			if( !msg )
				continue;
			if( strsrch(msg,"内容丢失")==-1 )				
				continue;
			msg2 = read_file(dir+"/"+arg+".txt");
			if( !msg2 )
				continue;
			msg2 = replace_string(msg2,"document.write('","");
			msg2 = replace_string(msg2,"');","");
			msg = replace_string(msg,"内容丢失,请联系管理员!",msg2);
			write(CLR);
			aa = "\n\n\n\n\n\n修正中......................";
			if( k%1==0 )
				aa+= "─";
			else if( k%2==0 )
				aa+= "╲";
			else if( k%3==0 )
				aa+= "│";
			else if( k%4==0 )
				aa+= "╱";
			else if( k%5==0 )
				aa+= "─";
			else if( k%6==0 )
				aa+= "╲";
			else if( k%7==0 )
				aa+= "│";
			else if( k%8==0 )
				aa+= "╱";
			else 	aa+= "─";
			write(aa);
			write_file(dir+"/"+str,msg,1);
			reset_eval_cost();	
		}
	}
	write("全部修正完毕\n");
	return 1;
}		

int do_code2(string cc)
{
	mixed *file,*dirs;
	string dir,str,arg,msg,msg2;
	int i,k;
	
	dirs = get_dir("/HTML/");
	for(i=0;i<sizeof(dirs);i++)
	{
		dir = "/HTML/"+dirs[i];	
		file = get_dir( dir+"/*.htm");
		if( !sizeof(file) )
			continue;
		for(k=0;k<sizeof(file);k++)	
		{
			reset_eval_cost();	
			str = file[k];
			if( !str )
				continue;
			sscanf(str,"%s.htm",arg);
			msg = read_file(dir+"/"+str);
			if( !msg )
				continue;
			if( strsrch(msg,"内容丢失")==-1 )
			{
				("/cmds/adm/adrm.c")->main(this_player(),dir+"/"+str);
				("/cmds/adm/adrm.c")->main(this_player(),dir+"/"+arg+".txt");
			}
		}
	}
	return 1;
}		
	
	
			
		
