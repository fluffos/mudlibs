int do_code(string cc)
{
	mixed *file,*dirs;
	string dir,str,arg,msg,msg2;
	int i,k;
	
	dirs = get_dir("/HTML/");
	for(i=0;i<sizeof(dirs);i++)
	{
		dir = "/HTML/"+dirs[i];	
		file = get_dir( dir+"/*.htm");
		if( !sizeof(file) )
			continue;
		
		for(k=0;k<sizeof(file);k++)	
		{
			str = file[k];
			if( !str )
				continue;
			sscanf(str,"%s.htm",arg);
			msg = read_file(dir+"/"+str);
			if( !msg )
				continue;
			if( strsrch(msg,"内容丢失")==-1 )				
				continue;
			msg2 = read_file(dir+"/"+arg+".txt");
			if( !msg2 )
				continue;
			msg2 = replace_string(msg2,"document.write('","");
			msg2 = replace_string(msg2,"');","");
			msg = replace_string(msg,"内容丢失,请联系管理员!",msg2);
			write(dir+"/"+str+"修正完毕\n");
			write_file(dir+"/"+str,msg,1);
			reset_eval_cost();	
		}
	}
	write("全部修正完毕\n");
	return 1;
}		


void destfile(mixed *dirs)
{
	mixed *file;
	string dir,str,arg,msg,msg2;
	int i;
	
	dirs-= ({0});
	if( !dirs || !arrayp(dirs) )
	{
		delete("doing");
		write("删除正确的文件，完毕。\n");
		return;
	}		
	reset_eval_cost();	
	dir = "/HTML/"+dirs[0];	
	file = get_dir( dir+"/*.htm");
	if( file && arrayp(file) )
	{
		for(i=0;i<sizeof(file);i++)	
		{
			str = file[i];
			//write("str="+str+"\n");
			if( !str )
				continue;
			if( sscanf(str,"%s.htm",arg)!=1 )
				continue;				
			msg = read_file(dir+"/"+str);
			if( !msg )
				continue;
			if( strsrch(msg,"内容丢失")==-1 )
			{
				rm(dir+"/"+str);
				rm(dir+"/"+arg+".txt");
			}
		}
		write(dir+"清除完毕。\n");
	}
	dirs-=({ dirs[0] });
	destfile(dirs);
}		

int do_code2(string cc)
{
	mixed *dirs;
	dirs = get_dir("/HTML/");
	if( query("doing") )
		write("正在工作中。\n");
	else
	{
		set("doing",1);
		write("开始清除正确的文件....\n");
		destfile(dirs);
	}	
	return 1;
}		
	
	
			
		
