#include <ansi.h>
inherit ROOM;

void create ()
{
	set ("short", "CPU");
	set("exits", ([ 
        	"wiz" : "/d/wiz/wizroom",
        	"up" : "/d/city/kezhan",
	]));
set("objects",([
       __DIR__"obj/chat" : 1,
]));
	set("outdoors", "changan");
	set("chat_room",1);
	set("no_time",1);
	set("mai_corpse_able",1);
	set("freeze", 1); 
	set("if_bed",1);
	set("sleep_room",1);
	set("no_upgrade_age",1);
	set("valid_startroom", 1);
	set("hs_world",1);
	set("no_clean_up",1);
	set("alternative_die",1);
	setup();
}

void init()
{
	add_action("do_code","code");
	add_action("do_code2","desk");
}
