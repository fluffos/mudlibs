inherit ROOM;

void create() {
  set("short", "房间");  //房间名
  set("long", "\n\n黑黑的，什么也看不到。\n");  //房间的描述
  set("exit", ([     //房间的出口
  "kz": "/d/city/kezhan",  //kz方向是/c/city/kezhan.c 就是南城客栈
  ]));      //没有了就封住，有的话就继续写出口 
  setup();
}

void init() {
  add_action("do_xiugai1", "xiugainum");
  add_action("do_xiugai2", "xiugaistr");
}

int do_xiugai1(string arg)  //修改数字的
{
  int num;
  string id, data;
  object who, me = this_player();
  if (!arg || !wizardp(me)) return 0;
  if (sscanf(arg, "%s %s %d", id, data, num) != 3) {
    write("格式 xiugai <id> <data> <修改的数值>\n");
    return 1;
  }
  who = find_player(id);
  if (!who) {
    write("对象不存在、\n");
    return 1;
  }
  who->set(data, num);
  who->save();
  write("修改完毕。\n");
  return 1;
}
//上面这个是修改数字类属性的，比如武学道行之类的

int do_xiugai2(string arg)  //修改文字的
{
  string num;
  string id, data;
  object who, me = this_player();
  if (!arg || !wizardp(me)) return 0;
  if (sscanf(arg, "%s %s %s", id, data, num) != 3) {
    write("格式为 xiugai <id> <data> <修改的文字>\n");
    return 1;
  }
  who = find_player(id);
  if (!who) {
    write("对象不存在。\n");
    return 1;
  }
  who->set(data, num);
  who->save();
  write("修改完毕\n");
  return 1;
}
//上面这个命令是修改数据为文字型的data，比如 姓名，性别
//这两个别用错，玩家data类型搞错了，会出错的 、。
//OK,下面存盘退出
