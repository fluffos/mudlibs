varargs void powerup(object who,int flag)
{
        if( !who )  return;
        who->set("kee",who->query("max_kee"));
        who->set("eff_kee",who->query("max_kee"));
        who->set("sen",who->query("max_sen"));
        who->set("eff_sen",who->query("max_sen"));
        who->set("mana",who->query("max_mana")*2);
        who->set("force",who->query("max_force")*2);
        who->clear_condition();
        who->delete_temp("no_move");
        who->delete_temp("no_cast");
        if( who->is_busy() )
        {
                who->start_busy(1,10);
                who->interrupt_me(who,"神力");          
                who->reset_action();
                if( flag )
                        message_vision("\n$N念动真言：“金木水火土，急急如律令！”顿时变的身轻如燕！\n\n",who);
        }
        if( flag && flag==1 )
                message_vision(HIG"\n$N"HIG"从怀里小心翼翼的拿出一颗云丹送入嘴中，果然见$P脸上慢慢
泛出红光，法力和内力到了极限！\n"NOR,who);
        return;
}

varargs void addSen(object me,int flag)
{
        int neilineed,diff;
        if( me->query("force")<20 ) 
                return;
        diff = me->query("eff_sen")-me->query("sen");
        neilineed = diff*50/(int)me->query_skill("force");
        if( neilineed<1 ) return;
        if( neilineed>me->query("force") ) neilineed = me->query("force");
        diff = neilineed*(int)me->query_skill("force")/50;
        me->receive_heal("sen", diff);
        me->add("force", -neilineed);
        if( !flag && random(3) )  
                message_vision("$N略一凝神，吸了口气，精神看起来清醒多了。\n", me);
        return;
}

varargs void addKee(object me,int flag)
{
        int diff,neilineed;
        if( me->query("force")<20 ) 
                return;
        diff = me->query("eff_kee")-me->query("kee");
        neilineed = diff*30/(int)me->query_skill("force");
        if( neilineed<1 ) return;
        if( neilineed>200 ) neilineed=200;
        if( neilineed>me->query("force") )
                neilineed = me->query("force");
        diff = neilineed*(int)me->query_skill("force")/20;
        me->receive_heal("kee", diff );
        me->add("force",-neilineed);
        if( !flag && random(3) )  
                message_vision("$N深深吸了几口气，脸色看起来好多了。\n", me);
        return;
}

varargs void addEffSen(object me,int flag)
{
        int addSen;
        addSen = me->query("max_sen")-me->query("eff_sen");
        if( addSen<=0 ) return;
        while( me->query("eff_sen")<me->query("max_sen") )
        {
                if( me->query("mana")<200 )
                        break;
                me->receive_curing("sen",(200+(int)me->query_skill("spells",1)/2) );
                me->add("mana",-200);
        }
        if( !flag && random(3) )  
                message_vision("$N吃下一些混元丹，气色看起来好多了。\n"NOR,me); 
        return;
}

varargs void addEffKee(object me,int flag)
{
        int add_kee;
        add_kee = me->query("max_kee")-me->query("eff_kee");
        if( add_kee<=0 ) return;
        while( me->query("eff_kee")<me->query("max_kee") )
        {
                if( me->query("force")<200 )
                        break;
                me->receive_curing("kee",(100+(int)me->query_skill("force",1)/2) );
                me->add("force",-200);
        }
        if( !flag && random(3) )  
                message_vision("$N吃下一些金创药，气色看起来好多了。\n"NOR,me); 
        return;
}

int sort_skill(string file)
{
        int i;
        if( !sscanf(file, "%*s.lpc") )  
                return 0;
        i = strlen(file);
        while(i--)
        {
                if( file[i] == '.' ) continue;
                if( file[i] < 'a' || file[i] > 'z' )
                        return 0;
        }
        return 1;
}

int max(int a,int b)
{
        if( a>b )  return a;
        return b;
}

string checkSkill(object who,string arg)
{
        int i;
        string *str,sk,exert,*file;
        mapping skill = who->query_skills();

        if( !skill || !mapp(skill) )  return 0;
        if( !skill[arg] )    return 0;
        str = keys(skill);
        for( i=0;i<sizeof(str);i++ )
        {
                if( who->query_skill_mapped(arg)==str[i] )
                {
                        sk = str[i];
                        break;
                }
        }
        if( !stringp(sk) )     
                return 0;
        if(file_size(SKILL_D(sk)+".lpc") < 1)
                error ("daemon/"+sk+".c文件损坏.\n");
        if( stringp(exert=SKILL_D(sk)->perform_action_file("")) )
        {
                file = get_dir(exert);
                if( sizeof(file)>0 )
                        file = filter_array(file, (: sort_skill :) );
        }
        else if( stringp(exert = SKILL_D(sk)->exert_function_file("")) )
        {
                file = get_dir(exert);
                if( sizeof(file)>0 )
                        file = filter_array(file, (: sort_skill :) );
        }
        else if( stringp(exert = SKILL_D(sk)->cast_spell_file("")) )
        {
                file = get_dir(exert);
                if( sizeof(file)>0 )
                        file = filter_array(file, (: sort_skill :) );
        }
        if( sizeof(file)<=0 )
                return 0;
        i = random(sizeof(file));
        if( !file[i] )  
                return 0;
        exert = replace_string(file[i],".lpc","");
        who->set_temp("sdsd/checkskill",exert);
        return exert;
}

//最高的skills
int maxSkill(object who)
{
        int i,num = 1;
        mapping skills;
        string *skill;

        skills = who->query_skills();
        if( !skills || !mapp(skills) )
                return 250;
        skill = keys(skills);
        if( sizeof(skill)>0 )
        {
                for (i=0;i<sizeof(skill);i++)
                {
                        if( who->query_skill(skill[i],1)>num )
                                num = who->query_skill(skill[i],1);
                }
        }
        else    num = 200+random(300);
        return num;
}

varargs void randomPfm(object who,string arg)
{
        string exert;
        object weapon;
        if( !who )
                return;
        if( !who->is_fighting() 
         || !living(who) )
                return; 
        if( !arg )
        {
        if( !objectp(weapon=who->query_temp("weapon")) )
                arg = "unarmed";
        else    arg = weapon->query("skill_type");
        }                       
        if( !arg || !stringp(arg) )   arg = "unarmed";
        exert = checkSkill(who,arg);
        if( !exert || !stringp(exert) )  return;
        if( time()<who->query_temp("no_perform/start")+who->query_temp("no_perform/time") )
                return;
        if( !who->perform_action(arg,exert) )
                who->command("perform "+exert);
}

void randomCast(object who)
{
        string exert,*noMsg;
        if( !who )
                return;
        exert = checkSkill(who,"spells");
        if( !exert )  exert = "feng";
        noMsg = ({      
                "shuidun",                 //dragon
                "escape","chongsheng",//emei swordman
                "townportal",              //hell
                "yin",                     //gumu
                "mysticism",               //sanxian
                "tuoqiao",                 //shushan
                "bagua",                   //youxia
                "qimen",                    //wzg
                "tudun",                   //wdd
                "chuqiao",              //all
                });
        if( member_array(exert,noMsg)!=-1 )
                return;
        if( !who->cast_spell(exert) )
                who->command("cast "+exert);
}

void randomExert(object who)
{
        string exert;
        if( !who )
                return;
        exert = checkSkill(who,"force");
        if( !exert )  return;
        if( !who->exert_function(exert) )
                who->command("exert "+exert);
}

varargs string no_color_msg(string str,object who)
{
        if( who )
        {
                str = replace_string(str, "$N", who->name());
                str = replace_string(str, "$C", RANK_D->query_respect(who));
                str = replace_string(str, "$c", RANK_D->query_rude(who));
        }
        if( !str )  str = "";
        str = COLOR_D->clean_color(str);
        return str;
}

varargs string color_msg(string str,object who)
{
        if( who )
        {
                str = replace_string(str, "$N", who->name());
                str = replace_string(str, "$C", RANK_D->query_respect(who));
                str = replace_string(str, "$c", RANK_D->query_rude(who));
        }
        if( !str || !stringp(str) )  str = "";
        str = COLOR_D->replace_color(str,1);
        return str;
}

varargs int super_attack(object npc,object who,int damage,string clr)
{
        COMBAT_D->super_attack(npc,who,damage,clr);
        return 1;
}


varargs varargs object random_place(string *dirs)
{
        int  i, j, k;
        object newob;
        mixed* file, exit;

        if( !sizeof(dirs) )
                dirs = ({
                "/d/city",      "/d/jjf",       "/d/westway",
                "/d/kaifeng",   "/d/lingtai",   "/d/moon",
                "/d/gao",       "/d/sea",       "/d/nanhai", 
                "/d/eastway",   "/d/xueshan",   "/d/dntg/hgs",
                "/d/luoyang",   "/d/pansi",
                
                "/d/qujing/wuzhuang",   "/d/qujing/baotou", 
                "/d/qujing/baoxiang",   "/d/qujing/bibotan",
                "/d/qujing/biqiu",      "/d/qujing/chechi",
                "/d/qujing/dudi",       "/d/qujing/fengxian",
                "/d/qujing/firemount",  "/d/qujing/jilei",
                "/d/qujing/jindou",     "/d/qujing/jingjiling",
                "/d/qujing/jinping",    "/d/qujing/jisaiguo",
                "/d/qujing/maoying",    "/d/qujing/nuerguo",
                "/d/qujing/pingding",   "/d/qujing/pansi",
                "/d/qujing/tongtian",   "/d/qujing/qilin",
                "/d/qujing/qinfa",      "/d/qujing/qinglong",
                "/d/qujing/tianzhu",    "/d/qujing/wudidong",
                "/d/qujing/wuji",       "/d/qujing/xiaoxitian",
                "/d/qujing/yinwu",      "/d/qujing/yuhua",
                "/d/qujing/zhujie",     "/d/qujing/zhuzi",
        
                "/d/penglai",           "/d/pantao",
                "/d/death",             "/d/meishan",
                "/d/qujing/lingshan",
        });

        i = random(sizeof(dirs));    // pick up one directory

        file = get_dir( dirs[i]+"/*.lpc", -1 );
        if( !sizeof(file) )             
                return 0;
        for(k=0;k<30;k++) 
        { // try 20 times
                reset_eval_cost();      
                j = random(sizeof(file));
                if( file[j][1] > 0 ) 
                {
                        newob=load_object(dirs[i]+"/"+file[j][0]);
                        if(newob) 
                        {  
                                if(newob->query("no_fight") 
                                 ||newob->query("no_magic") 
                                 ||newob->query("no_mieyao") 
                                 ||!(exit=newob->query("exits")) 
                                 ||sizeof(exit)<1)
                                        continue;
                                if( newob )  
                                        return newob;
                        }
                }
        }
        return 0;
}
        
varargs object random_npc(object obj,string *dirr)
{
        object *inv,npc,where;
        int i;
        where = random_place(dirr);
        if( !where )
                return 0;
        inv = all_inventory(where);
        i = sizeof(inv);
        while(i--)
        {
        if( !inv[i] || !inv[i]->is_character() 
          || inv[i]->is_fighting() 
          || !living(inv[i]) 
          || inv[i]->is_busy() )
                continue;
        if( inv[i] )
                return inv[i];
        }
        return 0; 
}                         

string random_msg(string arg)
{
        int i,k,j;
        string str,arg1;        
        if( !arg || !stringp(arg) )
                return "";
        arg = COLOR_D->clean_color(arg);        
        i = strlen(arg);
        if( random(2) ) j= i/2;
        else j = i-2;
        for(j;j>0;j--)
        {
                k = random(i*2)/2;
                while( i>2 && (k==i-2 || k%2!=0) )
                        k = random(i*2)/2;
                str = sprintf("%c%c",arg[k],arg[k+1]);
                arg = replace_string(arg,str,"□");
        }
        return arg;
}

mapping check_time()
{
        mapping times = ([]);  
        string e_time, week, month, year,time99;
        int months,day, hour, minute, second;
        string *month_name = ({"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"});
        e_time = ctime(time());
        sscanf(e_time,"%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);
    
        if(hour>12) 
        {          
                if(hour==13)           hour=1;      
                else if(hour==14)       hour=2;     
                else if(hour==15)       hour=3;    
                else if(hour==16)       hour=4;    
                else if(hour==17)       hour=5;     
                else if(hour==18)       hour=6;      
                else if(hour==19)       hour=7;      
                else if(hour==20)       hour=8;    
                else if(hour==21)       hour=9;   
                else if(hour==22)       hour=10;     
                else if(hour==23)       hour=11;    
                else if(hour==24)       hour=0;    
        }
        months = (member_array(month, month_name)+1);
        times["year"] = year;    //string
        times["month"] = months; //int
        times["day"] = day;      //int
        times["hour"] = hour;    //int
        times["minute"] = minute;//int
        times["second"] = second;//int
        return times;
}

varargs object random_item(string *dirr)
{
        object *inv,npc,obj;
        int i;
	npc=random_npc(0,dirr);
        if( !npc || !living(npc) || sizeof(all_inventory(npc))<1 )
                return 0;
        inv = all_inventory(npc);
        i = sizeof(inv);
        while(i--)
        {
                obj = inv[random(i)];   
                if( !obj || obj->is_character() || obj->query("no_get") )
                        continue;
                else    return obj;
        }
        return 0; 
}
