#include <ansi.h>
inherit NPC;

string time_string(int time)
{
        int month, day, hour, min, sec;

        sec = time % 60;
        time /= 60;
        min = time % 60;
        time /= 60;
        hour = time % 24;
        time /= 24;
        day = time % 30;
        month = time / 30;
        return (month?chinese_number(month) + "月":"") + (day?chinese_number(day) + "天":"") + 
        (hour?chinese_number(hour) + "小时":"") + chinese_number(min) + "分钟"+(sec?chinese_number(sec)+"秒":"");
}

string guoqing()
{
	int wx;
	mixed *local;
	object me = this_player();
	local = localtime(time());
	

	if( local[5]!=2011 )
		return "今年是"+local[5]+"哦。";
	if( (local[4]+1)!=10 )
		return "现在是"+chinese_number(local[4]+1)+"月哦。";
	if( local[3]>7 )
		return "今天是"+chinese_number(local[3])+"号哦。";
	if( time()<me->query("giftmark/20111001")+10800 )
		return "你可以在"+time_string(me->query("giftmark/20111001")+10800-time())+"后再来。";
	me->set("giftmark/20111001",time());
	wx = 10000;
	wx = wx/2+random(wx);
	me->add("combat_exp",wx);
	me->add("daoxing",wx);
	me->add("potential",wx/10);
	tell_object(me,"节日快乐，你得到了"+wx+"点武学、"+COMBAT_D->chinese_daoxing(wx)+"道行以及"+(wx/10)+"点潜能。\n");
	log_file("reward",sprintf("[%s] %s 得到 %d 点 2011国庆节.\n",ctime(time()),me->query("id"),wx));
	return "节日快乐，三小时后你可以来再次要礼物。";
}     

void create()
{
        set_name("小阿枚",({"xiao amy","amy"}));
        set("long", "   可爱的小女孩，她是当机补偿大使。\n");
        set("gender", "女性");
        set("title",HIW"当机补偿大使"NOR);
        set("age", 6);
        set("per", 40);
        set("inquiry", ([
                "gift" : (: guoqing :),
        ]));    
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}

