#include <ansi.h>
inherit NPC;

void create()
{
        set_name("凌惊雪",({"ling jingxue","xue","ling"}));
        set_level(1);
        set("long","她是绑定石兑换大使，你可以通过 genghuan <id> 的命令来向她更换可重叠的绑定石。\n");
        set("gender", "女性");
        set("title",HIM"须弥石兑换大使"NOR);
        set("age", 14);
        set("per",800);
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}

void init()
{
	add_action("do_huan","genghuan");
}

int do_huan(string arg)
{
	string type,file;
	object new_shi,ob,me = this_player();
	
	if( !arg )
		return 0;
	if( me->is_busy() )
		return err_msg("你现在正忙着。\n");
	ob = present(arg,me);
	if( !ob || base_name(ob)!="/d/obj/misc/bangding" )
		return err_msg(CYN+name()+"说道：你只能从我这里换"NOR HIR"绑定石"NOR CYN"。"NOR"\n");
	if( !stringp(type=ob->query("from")) 
	 || strlen(type)<2 )
	 	return err_msg(CYN+name()+"说道：你这块"NOR HIR"绑定石"NOR CYN"没有出处，没法从我这换。"NOR"\n");
	
	me->start_busy(1);
	switch(type)
	{
		case "【背阴巷副本】" : file = "/d/maze/beiyin/obj/bangding";break;
		case "【小雁塔副本】" : file = "/d/maze/xiaoyan-ta/obj/bangding";break;
		case "【大雁塔副本】" : file = "/d/maze/dayan-ta/obj/bangding";break;
		case "【始皇陵一层副本】" : file = "/d/maze/qingling-1/obj/bangding";break;
		default : return err_msg(CYN+name()+"说道：你这块"NOR HIR"绑定石"NOR CYN"是从哪里来的？"NOR"\n");
	}
	new_shi = new(file);
	if( new_shi->move(me) )
	{
		destruct(ob);
		write(HIY"【系统】你兑换了一颗绑定石。"NOR"\n");
	}
	else
	{
		if( new_shi )
			destruct(new_shi);
		write(HIR"【系统】你的背包满了。"NOR"\n");
	}
	write(HIY"【系统】友情提示：注销的命令是 "HIR"destruct <ID>"HIY"。"NOR"\n");
	return 1;
}
	 	