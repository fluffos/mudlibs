#include <ansi.h>
inherit NPC;

string song_tt();

void create()
{
    	set_name("小雨",({"xiao yu","yu","rain"}));
    	set("long", "小雨西游的初创者，我们很想念她。你可以向她索要「小雨」套装。\n");
        set("gender", "女性");
        set("title",HIW"套装发放大使"NOR);
        set("age", 16);
        set("per", 40);
        set("inquiry", ([
                "gift" : (: song_tt :),
        ]));    
	setup();
}

string song_tt()
{
	mapping my_data;
	string *ars;
	int i;
	object npc,obj,armor,me = this_player();
	if( !userp(me) )
		return 0;
	if( me->is_busy() || me->is_fighting() )
	 	return ("你现在正忙着呢。\n");		
	if( me->query("giftmark/20121124")>=2 )
		return ("你我似曾相识。。。\n");
	
	npc = clone_object("/d/city/npc/libai");
	npc->set_skill("force",100+random(100));
	npc->set_temp("apply/karma",20000);
	if( me->query("giftmark/20121124")==0 )
		armor = new("/d/obj/narmor/shield");
	else
		armor = new("/d/obj/narmor/kui");	
	armor->init_armor(npc);
	destruct(npc);
	if( me->query("giftmark/20121124")==0 )
	{
		armor->set_name("相濡以沫",({"xiang ru","dun","shield"}));
		armor->set("id","xiang ru");
		armor->set("unit","面");
		armor->set("ids",({"xiang ru","dun","shield"}));
	}
	else
	{
		armor->set_name("同甘共苦",({"gang ku","kui","mao"}));
		armor->set("id","gang ku");
		armor->set("unit","顶");
		armor->set("ids",({"gang ku","kui","mao"}));
	}	
	armor->set("armor_title","小雨");
	armor->set("long",HIM+@LONG
	风雨十年，你我同行。	
LONG+NOR);
	armor->setup();
	my_data = armor->query_entire_dbase();
	obj = new("/obj/armor");
	obj->set("owner_id",me->query("id"));
	ars = keys(my_data);
	for(i=0;i<sizeof(ars);i++)
	{
		if( !ars[i] || ars[i]=="changed" )
			continue;
		obj->set(ars[i],my_data[ars[i]]);
	}
	obj->set("shorts",armor->short());
	obj->set("ids",armor->parse_command_id_list());	
	obj->set_name(armor->query("name"),obj->query("ids"));
	obj->setup();
	destruct(armor);
	if( !obj->move(me) )
	{
		destruct(obj);
		return ("你背包满了。\n");
	}	
	if( obj->to_save() )
	{
		write(HIY"你得到了"+obj->short()+HIY"。\n"NOR);
		me->add("giftmark/20121124",1);
		me->save();
		me->start_busy(3);
		if( me->query("giftmark/20121124")==0 )
			tell_object(me,HIY"你还有一次索要的机会。\n"NOR);
		return "宝贝给你，重新登录后你可以通过 zhaohuan armor 来得到它。\n";
	}
	me->start_busy(3);
	destruct(obj);
	return ("套装存储出错了！请联系巫师！\n");
}
