//inviting
inherit NPC;
#include <ansi.h>

string do_check();
void inviting(object me);

void create() {
  set_name("神秘老人", ({ "lao zhe", "ren" }));
  set("name_color", "HIR");
  set("inquiry", ([
    "南山经": (: do_check :),
  ]));
  setup();
}

int information(object who) {
  mapping my, his, skills;
  string *str, *skill;
  object weapon;
  int i;

  if (!who)
    return 0;
  if (!this_object()->visible(who)) {
    tell_object(who, name() + "疑惑的朝四周看看：我怎么什么也看不到？\n");
    return 0;
  }
  if (who->query("combat_exp") < 1000000
    || who->query_skill("force", 1) < 120) {
    tell_object(who, name() + "不屑的朝你瞥了眼：这么弱也来送死？！\n");
    return 0;
  }
  if (who->query("giftmark/2007-9-9")) {
    tell_object(who, name() + "不屑的朝你瞥了眼：你又来骗某的宝贝？！\n");
    return 0;
  }
  if (this_object()->is_fighting()
    || this_object()->is_busy()) {
    tell_object(who, name() + "擦了擦汗道：等等，老夫正忙。\n");
    return 0;
  }
  my = query_entire_dbase();
  his = who->query_entire_dbase();
  str = ({
    "max_kee", "max_sen", "max_force", "max_mana", "family",
    "mana_factor", "force_factor", "int", "per", "str", "spi",
    "con", "cps", "combat_exp", "daoxing", "bellicosity",
    "maximum_force", "maximum_mana",
  });
  for (i = 0; i < sizeof(str); i++) {
    if (his[str[i]])
      my[str[i]] = his[str[i]];
  }
  powerup(1);
  skills = who->query_skills();
  skill = keys(skills);
  for (i = 0; i < sizeof(skill); i++) {
    set_skill(skill[i], who->query(skill[i], 1));
    if (who->query_skill_mapped(skill[i]))
      map_skill(skill[i], who->query_skill_mapped(skill[i]));
  }
  reset_action();
  weapon = who->query_temp("weapon");
  if (weapon)
    weapon = clone_object(base_name(weapon));
  if (weapon && weapon->move(this_object()) && weapon->wield()) {
    reset_action();
    say(name() + "满意的摸了摸" + weapon->name() + "。\n");
  }
  tell_object(who, name() + "朝你点了点头。\n");
  set("owner", who);
  return 1;
}

string do_check() {
  object me = this_player();

  if (me->query_temp("nsj_kill"))
    return "加油加油。";
  if (information(me))
    tell_object(me, "下定决心的话，就下kill吧。\n");
  me->set_temp("nsj_kill", 1);
  return "你我战它三个回合看看。";
}

void init() {
  add_action("do_kill", "kill");
  add_action("do_start", "start");
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

void check_data(object me, object npc, int kee, int sen) {
  int kk, ss;
  object ob;
  if (!me)
    return;
  if (me->query("giftmark/2007-9-9"))
    return;
  npc->remove_killer(me);
  me->remove_killer(npc);
  if (!present(me, environment()) || !living(me)) {
    me->delete_temp("nsj_kill");
    return;
  }
  kk = me->query("kee");
  ss = me->query("sen");
  me->powerup();
  if ((kk * 100 / kee) < 80
    || (ss * 100 / sen) < 80) {
    message_vision("$N笑道：" + me->name() + "还需努力哈。\n", npc);
    return;
  }
  ob = new("/d/wiz/gift/snowtu/obj/zzpfm/book");
  if (ob && ob->move(me)) {
    ob->set("num", 10 + random(30));
    me->set("giftmark/2007-9-9", 1);
    me->save();
    message_vision("$N给$n一本南山经。\n", npc, me);
    return;
  }
}

int do_kill(string arg) {
  int kee, sen;
  object who, me = this_player();
  if (!arg)
    return 0;
  who = present(arg, environment());
  if (!who || who != this_object())
    return 0;
  if (me != query("owner")
    || !me->query_temp("nsj_kill"))
    return err_msg(name() + "不想和你打。\n");

  message_vision(
    "$N躬身朝$n道：" + me->name() + "领教" + RANK_D->query_respect(this_object()) + "几招。\n",
    me,
    this_object()
  );
  me->powerup();
  kee = me->query("kee");
  sen = me->query("sen");
  remove_call_out("check_data");
  call_out("check_data", 3, me, this_object(), kee, sen);
  return 0;
}

int do_start() {
  object me = this_player();
  if (!wizardp(me))
    return 0;
  if (query_temp("invite"))
    return 0;
  set_temp("invite", "public");
  CHANNEL_D->do_channel(this_object(), "chat", "南山经发放活动即将开始，诸位仙贤如愿观礼，使accept lao zhe便可！");
  remove_call_out("inviting");
  call_out("inviting", 1, this_object());
  return 1;
}

void die() {
  powerup(1);
  return;
}
void inviting(object me) {
  int i;
  object *list;

  if (!me->query_temp("invite"))
    return;
  remove_call_out("inviting");
  call_out("inviting", 4 + random(4), me);
  list = users();
  i = sizeof(list);
  while (i--) {
    string here, there;
    reset_eval_cost();
    if (!environment(list[i]))
      continue;
    if (environment(list[i])->query("unit"))  // not a room
      continue;
    if (list[i]->is_fighting())
      continue;
    if (list[i]->is_busy())
      continue;
    if (list[i]->query_temp("no_move"))
      continue;
    if (!living(list[i]))
      continue;
    if ((string)list[i]->query_temp("accept") != me->query("id"))
      continue;
    if (list[i]->query("giftmark/2007-9-9"))
      continue;
    list[i]->set_temp("accept", 0);
    here = (string)environment(me);
    there = (string)environment(list[i]);
    if (here == there)
      continue;
    message_vision("$N的喃喃念了几句咒语…\n", me);
    list[i]->set_temp("accept", 0);
    message_vision("一道金光落下将$N罩住，消失在天空中。\n", list[i]);
    if (list[i]->move(here))
      message_vision("…金光消去，$n滑了出来。\n", me, list[i]);
    break;
  }
}
