#include <ansi.h>
inherit NPC;

void give_gift(object me) {
  object gift;
  if (!me || !present(me, environment()))
    return;
  if (me->query("礼物/" + query("name")))
    return;
  gift = new(__DIR__ "gift_ob");
  if (!gift)
    return;
  gift->set("owner", this_object());
  gift->set("target", me);
  message_vision("$N对$n说道：许个愿吧。。。。\n", this_object(), me);
  gift->move(me);
  return;
}

string dangji_gift() {
  int k;
  object ob, stone, me = this_player();
  if (!userp(me)) {
    me->unconcious();
    return 0;
  }
  if (me->query("age") < 16)
    return 0;
  if (me->query("礼物标志/当机补偿20071"))
    return 0;
  if (this_object()->is_busy())
    return "我有点小忙....";
  ob = new("/obj/armor");
  if (!ob)
    return "唉，我找不到宝贝了。";
  stone = new("/u/snowtu/obj/shengji_armor");
  if (!ob->move(me)) {
    destruct(ob);
    return "你身上垃圾太多了。。。。";
  }
  if (stone && stone->move(me)) {
    k = 1 + random(10);
    stone->set_amount(k);
    message_vision(
      "$N递给$n" + chinese_number(k) + stone->query("base_unit") + stone->name() + "。\n",
      this_object(),
      me
    );
  }
  command("nod");
  this_object()->start_busy(1 + random(3));
  message_vision("$N递给$n一" + ob->query("unit") + ob->name() + "。\n", this_object(), me);
  me->set("礼物标志/当机补偿20071", 1);
  return "东西就在这了，到底是好是丑，就看你的造化了。。。。";
}

string do_gift() {
  object me = this_player();
  int age;
  if (!me || !present(me, environment()))
    return 0;
  age = 14 + me->query("age_modify") / 86400 + me->query("mud_age") / 86400 + me->query_temp("age_modify") / 86400;
  if (age < 16)
    return "你尚未成年，还是算了吧。";
  if (me->query("礼物/" + query("name")))
    return "礼物只有一次哦。";
  if (me->is_busy())
    return "你先歇着吧。";
  me->start_busy(3);
  remove_call_out("give_gift");
  call_out("give_gift", random(2), me);
  return "好吧，这就给你礼物。";
}

void create() {
  set_name(HIW "阿枚" NOR, ({ "a mei", "mei", "amy" }));
  set("gender", "女性");
  set("title", HIC "补偿大使" NOR);
  set("long", "当机补偿的使者，你可以向她询问关于当机补偿的消息。\n");
  set("age", 16);
  set("per", 40);
  set("int", 30);
  set("inquiry", ([
    "当机补偿": (: dangji_gift :),
  ]));
  setup();
  carry_object("/d/obj/cloth/nichang")->wear();
  carry_object("/d/obj/cloth/yuanxiang")->wear();
}

void default_gift(object me) {
  object ob;
  string *msg, *tt;
  int i;
  if (!me)
    return;
  msg = ({
    "结果$n一时眼花，伸手擦了擦眼睛，没听到$N的许愿。。。。\n",
    "结果$n一时眼花，伸手揉了揉眼睛，没听到$N的许愿。。。。\n",
    "结果$n一时耳背，没听到$N的许愿。。。。\n",
    "结果$n一时耳背，没听清楚$N的许愿。。。。\n",
    "结果旁边一阵喧闹，$n一时没听到$N的许愿。。。。\n",
    "结果旁边一阵喧闹，$n一时没听清楚$N的许愿。。。。\n",
    "结果旁边一阵喧哗，$n一时没听清楚$N的许愿。。。。\n",
    "结果旁边一阵喧哗，$n一时没听到$N的许愿。。。。\n",
  });
  message_vision(msg[random(sizeof(msg))], me, this_object());
  tt = ({
    "gold", "silver", "coin",
  });
  i = random(3);
  ob = new("/obj/money/" + tt[i]);
  if (!ob)
    this_object()->command("pat " + me->parse_command_id_list()[0]);
  else {
    switch (i) {
      case 0: i = 1 + random(10); break;
      case 1: i = 50 + random(250); break;
      default: i = 1000 + random(10000); break;
    }
    ob->set_amount(i);
    if (!ob->move(me))
      this_object()->command("pat " + me->parse_command_id_list()[0]);
    else message_vision("$n给$N一些" + ob->name() + "。\n", me, this_object());
  }
  return;
}
