inherit F_VENDOR_SALE;

void create() {
  set_name("王小二", ({ "wang", "wang xiaoer", "xiaoer" }));
  set("title", "包子店老板");
  set("gender", "男性");
  set("age", 42);
  set("long", "一个很喜欢笑的商人。\n");
  set("str", 30);
  set("con", 30);
  set("spi", 30);
  set("combat_exp", 20000);
  set("daoxing", 20000);
  set_skill("force", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 5);
  set("vendor_goods", ([
    "jiudai": "/d/moon/obj/jiudai",
    "gourou": "/d/ourhome/obj/gourou",
    "jinpai": "/d/obj/misc/tiaozhanpai",
    "jitui": "/d/ourhome/obj/jitui",
    "ball": "/d/obj/misc/crystalball",
    "huasheng": "/d/ourhome/obj/huasheng",
    "zhinan": "/d/obj/misc/xiaqi-zhinan",
  ]));
  setup();
  add_money("silver", 20);
}

void init() {
  object ob;
  ::init();
  add_action("do_vendor_list", "list");
}

int complete_trade(object me, int num, string what) {
  if (me->query_temp("test_buy"))
    return notify_fail(name() + "对你说道：对不起，本店的东西对你只售一次。\n");
  if ( ::complete_trade(me, num, what)) {
    me->set_temp("test_buy", 1);
    return 1;
  }
  return 0;
}
