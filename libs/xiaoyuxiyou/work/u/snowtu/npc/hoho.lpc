inherit NPC;
#include <ansi.h>


void create() {
  string msg;
  msg = HIR "\n" + @LONG
＃〓§〓〓〓〓〓§〓〓〓〓〓〓§〓〓〓〓〓§〓＃ 
　　↓　　　　　↓　　　　　　↓　　　　　↓ 
　☆★☆　　　☆★☆　　　　☆★☆　　　☆★☆ 
☆　周　☆　☆　末　☆　　☆　快　☆　☆　乐　☆ 
　☆★☆　　　☆★☆　　　　☆★☆　　　☆★☆ 
　　↓　　　　　↓　　　　　　↓　　　　　↓ 
　　※　　　　　※　　　　　　※　　　　　※  
LONG + NOR "\n";
  msg = replace_string(msg, "★", NOR BLINK HIY "★" NOR HIR);
  msg = replace_string(msg, "☆", NOR BLINK HIG "☆" NOR HIR);
  msg = replace_string(msg, "周", NOR HIY "周" NOR HIR);
  msg = replace_string(msg, "末", NOR HIY "末" NOR HIR);
  msg = replace_string(msg, "快", NOR HIY "快" NOR HIR);
  msg = replace_string(msg, "乐", NOR HIY "乐" NOR HIR);
  set_name("", ({ "", "x y m u d" }));
  set("title", msg);
  setup();
}
