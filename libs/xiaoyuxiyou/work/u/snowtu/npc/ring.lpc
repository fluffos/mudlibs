#include <ansi.h>
inherit NPC;

string check_me() {
  object ring;
  object me = this_player();

  if (time() < me->query("mark/snowtuRing") + 10800)
    return "你不是要过了吗？";
  if (time() - me->query("mud_age") < 3600 * 24)
    return "你还不够资格。";
  ring = present("jie zhi", me);
  if (ring)
    return "你先得将身上的" + ring->name() + "丢掉。";
  ring = new("/u/snowtu/obj/ring");
  if (ring && ring->move(me))
    tell_object(me, HIY "你得到了一枚" + ring->name(1) + "。\n" NOR);
  ring->set("snowtuRing", time());
  me->set("mark/snowtuRing", time());
  return "好吧，给你。。。";
}

void create() {
  set_name("小阿枚", ({ "xiao amy", "amy" }));
  set("long", "可爱的小女孩，她是新道具体验发放大使。\n");
  set("gender", "女性");
  set("title", HIW "新道具体验发放大使" NOR);
  set("age", 6);
  set("per", 40);
  set("inquiry", ([
    "gift": (: check_me :),
  ]));
  setup();
  carry_object("/obj/loginload/skirt.lpc")->wear();
}
