#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIR "硫酸" NOR, ({ "liu suan", "suan" }));
  set("long", "%s的硫酸，极度" HIR "危险" NOR "的东西，据说是修道士没炼丹中发现的，能毁坏人的皮肤。
和别人如没深仇大恨，就千万别洒(sa)到别人的身上。\n");
  set("unit", "瓶");
  set("amount", 100);
  set("max_amount", 100);
  set_weight(1000);
  set("value", 0);
  set("no_put", 1);
  setup();
}

void init() {
  add_action("do_sa", "sa");
}

void saing(object me, object who) {
  int ap, dp, i;
  if (!me)
    return;
  if (!who || !present(who, environment(me))) {
    message_vision("$N见下手的对象不在，将" + name() + "又收到怀中。\n", me);
    me->delete_temp("liusuan_to");
    return;
  }
  ap = me->query_kar();
  dp = who->query_kar();
  i = random(30) + 10;
  if (random(ap + dp) >= dp) {
    tell_object(me, "\n得手了！\n\n");
    message_vision("$N瞅准$n一个不留神，将手中" + name() + "对准$n泼去！\n", me, who);
    message_vision("\n\n毁了！\n\n", me, who);
    message_vision("$n顿时给泼了满脸，惨叫一声，一张粉脸顿时不成人形！\n", me, who);
    CHANNEL_D->do_channel(
      who,
      "rumor",
      "听说" + who->name(1) + "一不小心，中了" + me->name() + "的阴枪－－惨遭" + name() + HIM "毁容！" NOR
    );
    me->add("bellicosity", 50);
    tell_object(me, HIR "你顿时觉得戾气高涨。\n" NOR);
    who->add_temp("apply/personality", -(int)(i / 10));
    this_object()->add("amount", -i);
  } else {
    message_vision("$n无意间朝$N瞅了一眼，$N顿时心跳加速，手忙脚乱，手中的" + name() + "泼了几滴在地。。。\n", me, who);
    this_object()->add("amount", -(int)i / 2);
  }
  me->delete_temp("liusuan_to");
  me->start_busy(3);
  return;
}

int do_sa(string arg) {
  object ob, who, target, me = this_player();
  ob = this_object();
  if (!present(ob, me))
    return 0;
  if (me->is_busy()) {
    write("你正忙着呢。\n");
    return 1;
  }
  if (query("amount") <= 0) {
    write("这瓶" + name() + "已经空了。\n");
    return 1;
  }
  if (!arg) {
    write("你要向谁泼" + name() + "。\n");
    return 1;
  }
  who = present(arg, environment(me));
  if (!who) {
    write("你要向谁泼" + name() + "。\n");
    return 1;
  }
  if (me->query_temp("liusuan_to") != 0) {
    target = me->query_temp("liusuan_to");
    if (target && objectp(target)) {
      if (target == who)
        write("加油加油。\n");
      else {
        message_vision("$N一不小心，将手中的" + name() + "洒出来几滴。。。\n", me);
        me->delete_temp("liusuan_to");
        this_object()->add("amount", -(1 + random(3)));
      }
      return 1;
    }
  }
  message(
    "vision",
    me->name() + "掏出一瓶" + name() + "，鬼鬼祟祟的盯着" + who->name() + "，不知在打什么鬼注意。。。\n",
    environment(me),
    ({ me, who })
  );
  write("你鬼鬼祟祟盯着" + who->name() + "，伺机而动。\n");
  me->set_temp("liusuan_to", who);
  remove_call_out("saing");
  call_out("saing", 5 + random(5), me, who);
  return 1;
}

string long() {
  int i;
  string str, msg;
  str = ::long();
  i = query("amount") * 100 / query("max_amount");
  if (i == 100)
    msg = "满满";
  else if (i > 60)
    msg = "一大瓶";
  else if (i == 50)
    msg = "整半瓶";
  else if (i > 0)
    msg = "一小瓶";
  else msg = "空空";
  str = sprintf(str, msg);
  return str;
}
