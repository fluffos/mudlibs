#include <ansi.h>
inherit ITEM;

void do_msg() {
  string msg = @LONG
请许愿吧：
        1. 增加武学经验 
        2. 增加技能等级
        3. 增加潜能点数
        4. 增加属性点数
你想许哪个愿(1/2/3/4)
LONG;
  printf(msg);
  return;
}

void create() {
  set_name("礼物", ({ "amy's gift" }));
  set("unit", "个");
  set_weight(1);
  set("no_give", 1);
  set("no_get", 1);
  set("no_put", 1);
  set("value", 0);
  setup();
}

void do_gift_wx(object me) {
  int wx;
  object npc;
  if (!me)
    return;
  npc = query("owner");
  if (!npc)
    return;

  me->set("礼物/" + npc->query("name"), 1);
  message_vision("$N向$n许愿道：我要多多的武学。。。。\n", me, npc);
  if (random(100) < 40) {
    npc->default_gift(me);
    destruct(this_object());
    return;
  }
  wx = me->query("combat_exp") / 1000;
  if (wx > 500000) wx = 500000;
  if (wx < 50000) wx = 50000;
  wx = wx / 2 + random(wx / 2);
  message_vision("$n点了点头，说道：好吧。\n", me, npc);
  me->add("combat_exp", wx);
  tell_object(me, "你的武学经验增加了" + wx + "点。\n");
  destruct(this_object());
  return;
}

void do_gift_pot(object me) {
  object npc;
  int wx;
  if (!me)
    return;
  npc = query("owner");
  if (!npc)
    return;
  me->set("礼物/" + npc->query("name"), 1);
  message_vision("$N向$n许愿道：我要多多的潜能。。。。\n", me, npc);
  if (random(100) < 30) {
    npc->default_gift(me);
    destruct(this_object());
    return;
  }
  wx = me->query("combat_exp") / 10000;
  if (wx > 80000) wx = 80000;
  if (wx < 10000) wx = 10000;
  wx = wx / 2 + random(wx / 2);

  message_vision("$n点了点头，说道：好吧。\n", me, npc);
  me->add("potential", wx);
  tell_object(me, "你的潜能增加了" + wx + "点。\n");
  destruct(this_object());
  return;
}

void do_gift_sk(object me) {
  mapping skills;
  string *skill, sk;
  object npc;
  int i;
  if (!me)
    return;
  npc = query("owner");
  if (!npc)
    return;
  me->set("礼物/" + npc->query("name"), 1);
  message_vision("$N向$n许愿道：我要多多的技能。。。。\n", me, npc);
  if (random(100) < 15) {
    npc->default_gift(me);
    destruct(this_object());
    return;
  }
  message_vision("$n点了点头，说道：好吧。\n", me, npc);
  skills = me->query_skills();
  if (!skills || !mapp(skills))
    skill = ({ "force", "dodge", "spells", "unarmed", "parry", "literate", });
  else skill = keys(skills);
  sk = skill[random(sizeof(skill))];
  i = 1 + random(3);
  me->set_skill(sk, me->query_skill(sk, 1) + i);
  tell_object(me, "你的" + to_chinese(sk) + "增加了" + i + "级。\n");
  destruct(this_object());
  return;
}

void do_gift_sco(object me) {
  string *da, tmp;
  mapping data;
  object npc;
  if (!me)
    return;
  npc = query("owner");
  if (!npc)
    return;
  me->set("礼物/" + npc->query("name"), 1);
  message_vision("$N向$n许愿道：我要多多的人物属性。。。。\n", me, npc);
  if (random(100) < 40 || random(100) > 60) {
    npc->default_gift(me);
    destruct(this_object());
    return;
  }
  message_vision("$n点了点头，说道：好吧。\n", me, npc);
  data = ([
    "力量": "str",
    "勇气": "cor",
    "悟性": "int",
    "魅力": "per",
    "灵性": "spi",
    "定力": "cps",
    "根骨": "con",
    "福缘": "kar",
  ]);

  da = keys(data);
  tmp = da[random(sizeof(da))];
  me->add(data[tmp], 1);
  tell_object(me, "你的" + tmp + "增加了一点。\n");
  destruct(this_object());
  return;
}

void init() {
  object me = this_player();
  if (me != environment()) {
    destruct(this_object());
    return;
  }
  if (me != query("target") || !query("owner")) {
    destruct(this_object());
    return;
  }
  do_msg();
  add_action("do_none", "", 1);
}

int do_none(string arg) {
  object me = this_player();
  arg = query_verb();
  switch (arg) {
    case "1": do_gift_wx(me); break;
    case "2": do_gift_sk(me); break;
    case "3": do_gift_pot(me); break;
    case "4": do_gift_sco(me); break;
    default:
      do_msg();
  }
  return 1;
}
