#include <ansi.h>
inherit NPC;

mixed about_spring();
mixed spring_msg();
mixed about_dj();

void create() {
  set_name(HIC "阿枚" NOR, ({ "a mei", "amy" }));
  set("title", HIG "春节使者" NOR);
  set("long", "春节礼物发送大使。\n");
  set("gender", "女性");
  set("age", 18);
  set("attitude", "peaceful");
  set("per", 8000);
  set_level(100);
  set("chat_chance", 10);
  set("chat_msg", ({
    (: spring_msg :),
  }));
  set("inquiry", ([
    "gift": (: about_spring :),
    "春节礼物": (: about_spring :),
    "当机补偿": (: about_dj :),
  ]));
  set("env/test", "HIB");
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
  carry_object("/d/obj/cloth/shoes")->wear();
}

mixed spring_msg() {
  string msg = "\n";
  msg += HIY "    ┏┻┓            ┏┻┓            ┏┻┓            ┏┻┓\n" NOR;
  msg += RED "  ◢███◣        ◢███◣        ◢███◣        ◢███◣" NOR "\n";
  msg += RED "  █" NOR HBRED HIY " 二〇 " NOR RED "█        █" NOR NOR HBRED HIY " 一四 " NOR RED "█        █" NOR HBRED HIY " 元宵 " NOR RED "█        █" NOR HBRED HIY " 快乐 " NOR RED "█\n";
  msg += RED "  ◥███◤        ◥███◤        ◥███◤        ◥███◤\n" NOR;
  msg += HIY "    ║║║            ║║║            ║║║            ║║║ \n" NOR;
  if (!environment())
    return 0;
  if (time() >= query("channel/last_msg") + 3600) {
    set("channel/last_msg", time());
    message("shout", msg, users());
    return 1;
  }
  if (time() >= query("channel/last_msg2") + 1500) {
    set("channel/last_msg2", time());
    message("shout", HIG "【" HIY "新春愉快" HIG "】阿枚(Amy)：祝大家元宵愉快，可以到客栈找我要礼物哦。" NOR "\n", users());
    return 1;
  }
  tell_room(environment(), CYN "阿枚笑嘻嘻的看着你。\n" NOR);
  return 1;
}

void give_mod(object me, string type) {
  object ob;
  if (!me || !living(me) || !present(me, environment()))
    return;
  if (me->query_temp("spring/" + type))
    return;
  ob = new("/d/obj/narmor/" + type);
  ob->init_armor(this_object());
  ob->set("no_give", 1);
  ob->set("no_store", 1);
  ob->set("no_put", 1);
  ob->set("armor_title", "小雨");
  ob->set("from", "阿枚");
  ob->delete("family_name");
  ob->delete("class");
  ob->delete("female_only");
  if (ob->move(me)) {
    me->set_temp("spring/" + type, ob);
    tell_object(me, CYN + name() + CYN "亲手递给你一件土豪金的宝宝，金光闪闪亮瞎了你的眼。\n" NOR);
  } else {
    if (ob) destruct(ob);
    tell_object(me, CYN + name() + CYN "说道：你包裹都满了。。。\n" NOR);
  }
}

mixed about_spring() {
  int p, lvl;
  object ob, me = this_player();
  EMOTE_D->do_emote(this_object(), "hny", geteuid(me), CYN, 0, 0, 0);
  if (!userp(me))
    return 1;
  if (me->query("mark/2014spring")) {
    if (time() < me->query("mark/2014spring_mod") + 300) {
      tell_object(me, CYN + name() + CYN "说道：你是在消遣老娘吗？你刚刚要过，还是待会再来吧！\n" NOR);
      return 1;
    }
  }
  lvl = me->query_level();
  if (lvl > 30)
    lvl = 30;
  set_temp("armor_level", lvl);
  me->set("mark/2014spring_mod", time());
  give_mod(me, "kui");
  give_mod(me, "armor");
  give_mod(me, "shoes");
  give_mod(me, "cloth");

  if (!me->query("mark/2014spring")) {
    me->set("mark/2014spring", 1);
    p = 20000;
    if (me->query("potential") - me->query("learned_points") + p < me->query_level() * 5000)
      me->add("potential", 20000);
    else me->set("potential", me->query_level() * 5000 + me->query("learned_points"));
    tell_object(me, HIY "【系统】春节愉快，你得到了20000点潜能。" NOR "\n");

    if (!me->check_pay(5000000) && !me->check_balance(5000000)) {
      me->money_add(5000000);
      tell_object(me, HIY "【系统】春节愉快，你得到了500两黄金。" NOR "\n");
    }
    me->save();
  }
  tell_object(me, CYN + name() + CYN "说道：恭喜恭喜，发财发财，求抱大腿。\n" NOR);
  return 1;
}

mixed about_dj() {
  object me = this_player();
  EMOTE_D->do_emote(this_object(), "hny", geteuid(me), CYN, 0, 0, 0);
  if (!userp(me))
    return 1;
  if (me->query("mark/2014spring_dj"))
    return 1;
  me->set("mark/2014spring_dj", 1);
  me->money_add(10000000);
  tell_object(me, HIY "【系统】春节愉快，你得到了" HIR "一千两" HIY "黄金。" NOR "\n");
  me->add("combat_exp", 30000);
  tell_object(me, HIY "【系统】春节愉快，你得到了" HIR "30000" HIY "点武学经验。" NOR "\n");
  me->save();
  return 1;
}
