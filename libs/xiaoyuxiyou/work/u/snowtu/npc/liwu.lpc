inherit NPC;
#include <ansi.h>
string gift_me();
string gift_zq();

void create()
{
        set_name("礼物大师",({"li wu"}));
        set("long","你可以输入 yao <武器类型|防具> 来获得武器。\n");
	set("age",30);
	set_level(10);
	set("env/test","HIR");
	set("inquiry", ([
		"gift" : (: gift_me :),
		"中秋" : (: gift_zq :),
	]));	
        setup();
        carry_object(0,"cloth",1)->wear();
        carry_object(0,"armor",1)->wear();
        carry_object(0,"kui",1)->wear();
        carry_object(0,"shoes",1)->wear();
        carry_object(0,"pifeng",1)->wear();
        carry_object(0,"shield",1)->wear();
        carry_object(0,"neck",1)->wear();
        carry_object(0,"ring",1)->wear();
        carry_object(0,"hand",1)->wear();
        carry_object(0,"wrists",1)->wear();
        carry_object(0,"waist",1)->wear();
}

string gift_me()
{
	object me = this_player();
	if( me->query("giftmark/newbie_gold") )
		return "你不是要过了吗?";
	message_vision("$N递给$n五十两黄金。\n",this_object(),me);	
	me->money_add(500000);
	me->set("giftmark/newbie_gold",1);
	me->save();
	return "好生用着。";
}

void init()
{
	add_action("do_yao","yao");
}

int have_it(object me,string file)
{
	object *inv;
	int i;
	if( !me )
		return 0;
	inv = all_inventory(me);
	if( !inv || !arrayp(inv) || sizeof(inv)<1 )
		return 0;
	for(i=0;i<sizeof(inv);i++)
	{
		if( base_name(inv[i])==file )
			return 1;
	}
	return 0;		
}

int do_yao(string arg)
{
	int i;
	string str,*ar,*wp;
	object ob,me = this_player();
	if( !arg )
		return 0;
	ar = ({ "armor","cloth","hand","kui","neck","pifeng","ring","shield","shoes","waist","wrists", });
	wp = ({ "axe","blade","fork","hammer","mace","spear","staff","stick","whip","sword","unarmed",});
	if( member_array( arg,ar )==-1 
	 && member_array( arg,wp )==-1 )
	{
		str = "你可以输入 yao <武器类型|防具> 来获得武器。\n";
		str+= "防具类型有：\n";
		for(i=0;i<sizeof(ar);i++)
		{
			str+= ar[i];
			if( i%4==0 && i!=0 )
				str+= "\n";
			else	str+= "  ";	
		}
		str+= "武器类型有：\n";	
		for(i=0;i<sizeof(wp);i++)
		{
			str+= wp[i];
			if( i%4==0 && i!=0 )
				str+= "\n";
			else	str+= "  ";	
		}
		write(str);
		return 1;
	}
	if( member_array( arg,ar )!=-1 )
		str = "/d/obj/narmor/"+arg;
	else	str = "/d/obj/nweapon/"+arg;	
	if( have_it(me,str) )
	{
		write("你身上不是有了吗？\n");
		return 1;
	}
	message_vision("$N朝$n点了点头，口中念叨了几句咒语。\n",this_object(),me);
	ob = new(str);
	if( !ob )
		return err_msg("奇怪，啥也没有。\n");
	me->set("env/test",({"HIY","HIY","HIY","HIY","HIY","HIY","HIY","HIY","HIY","HIB",})[random(10)]);
	if( me->query_level()>40 )
	{
		me->set_temp("weapon_level",30+random(20));	 
		me->set_temp("armor_level",30+random(20));
	}
	me->delete("env/test");
	me->delete_temp("weapon_level");	 
	me->delete_temp("armor_level");
	if( member_array( arg,ar )!=-1 )
	{
		if( ob->init_armor(me) )
			message_vision("结果变出了 "+ob->name()+" 。\n",this_object());
		else
		{
			if( ob )  destruct(ob);
			return err_msg("结果啥反应也没有。\n");
		}
	}
	else	
	{
		if( ob->init_weapon(me) )
			message_vision("结果变出了 "+ob->name()+" 。\n",this_object());
		else
		{
			if( ob )  destruct(ob);
			return err_msg("结果啥反应也没有。\n");
		}
	}
	if( ob->move(me) )
		message_vision("$N将"+ob->name()+"交到$n手中，意味深长的说：玩泥巴要从娃娃抓起啊。\n",this_object(),me);
	else
	{
		if( ob )  destruct(ob);
		return err_msg("你身上是不是物什太多了？！\n");
	}
	return 1;
}		

string gift_zq()
{
	object gift,me=this_player();
	
	if( me->query("giftmark/2013中秋") )
		return "不是已经给过你了吗？";
	if( time()<me->query("mark/2013中秋")+3600 )	
		return "你不是刚刚要过了吗？";
	gift = new("/u/snowtu/obj/level_up");
	gift->set("owner_id",me->query("id"));
	if( gift->move(me) )
	{
		me->set("mark/2013中秋",time());
		tell_object(me,HIY"节日快乐！你得到了一颗"+gift->name()+HIY"！"NOR"\n");
		return "给你，要尽快吃，不然药效过了就没用了。";
	}
	if( gift )  destruct(gift);
	return "你身上东西太多了。";
}		