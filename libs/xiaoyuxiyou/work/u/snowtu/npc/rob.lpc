#include <ansi.h>
inherit NPC;

void post1(object, object, object, int);
void post2(object, object, object, int);
void check_self();

int num = 1 + random(10);
mapping *combat_action = ({
  ([ "action": "$N“轰”的一声，朝$n$l连发了" + chinese_number(num) + "颗导弹",
    "damage_type": "瘀伤",
    "post_action": (: post1 :),
  ]),
  ([ "action": "$N往$n的$l发出一梭子子弹",
    "damage_type": "刺伤",
    "post_action": (: post2 :),
  ]),
});

mapping query_action() {
  return combat_action[random(sizeof(combat_action))];
}

int query_max_oil() {
  return 10000;
}

void create() {
  object ob;
  set_name(YEL "零号机" NOR, ({ "No. zero", "zero", "ji" }));
  set("title", HIC "福音战士" NOR);
  set("long", "这是一架巨型的机械装甲。\n");
  set("race", "赛亚人");
  set("age", 0);
  set("combat_exp", 10000);
  set("limbs", ({ "头部", "胸部", "腹部", "脚部", "手部" }));
  set("default_actions", (: call_other, __FILE__, "query_action" :));
  set("chat_chance", 1);
  set("oil", 10000);
  set("ride/msg", "驾驶");
  set("ride/dodge", 100 + random(6));
  set_temp("apply/attack", 100);
  set_temp("apply/armor", 500);
  setup();
  ob = new("/d/city/npc/obj/sword");
  ob->set("name", RED "子弹" NOR);
  ob->move(this_object());
  set_temp("weapon", ob);
  set("default_actions", (: call_other, __FILE__, "query_action" :));
  set("actions", (: call_other, __FILE__, "query_action" :));
}

varargs int receive_damage(string type, int damage, object who) {
  if (who && who == this_object())
    return ::receive_damage(type, damage, who);
  if (!type || type == "sen")
    damage = 0;
  damage = 1 + random(damage / 10);
  if (query("oil") > 0) {
    if (query("oil") > damage) {
      add("oil", -damage);
      damage = 0;
    } else {
      damage -= query("oil");
      set("oil", 0);
    }
    check_self();
  }
  return ::receive_damage(type, damage, who);
}

receive_wound(string type, int damage, object who) {
  if (who && who == this_object())
    return ::receive_wound(type, damage, who);
  if (!type || type == "sen")
    damage = 0;
  damage = 1 + random(damage / 10);
  if (query("oil") > 0) {
    if (query("oil") > damage) {
      damage = 0;
      add("oil", -damage);
    } else {
      damage -= query("oil");
      set("oil", 0);
    }
    check_self();
  }
  return ::receive_wound(type, damage, who);
}

void die() {
  tell_room(environment(), HIR "警告：即将爆炸！\n" NOR);
  message_vision(YEL "\n$N" YEL "“轰”的一声爆炸了！\n\n" NOR, this_object());
  destruct(this_object());
}

void unconcious() {
  die();
}

void init() {
  if (this_player() == query_temp("rider")) {
    add_action("do_addoil", "addoil");
    add_action("do_out", "dismount");
    add_action("do_shoot", "shoot");
  } else add_action("do_enter", "mount");
}

int do_out(string arg) {
  object me = this_player();
  if (!arg || !id(arg))
    return 0;
  message_vision(YEL "$N" YEL "打开舱门，挺身从$n" YEL "上跃下来。\n" NOR, me, this_object());
  set_temp("no_return", 0);
  delete_temp("rider");
  me->delete_temp("ridee", 0);
  me->add_temp("apply/dodge", -me->query_temp("ride/dodge"));
  me->delete_temp("ride/dodge", 0);
  return 1;
}

int do_enter(string arg) {
  object me = this_player();

  if (!arg || !id(arg))
    return 0;
  if (objectp(me->query_temp("ridee")))
    return 0;
  if (objectp(query_temp("rider")))
    return 0;
  message_vision(YEL "$N" YEL "打开舱门，进入到$n" YEL "中去。\n" NOR, me, this_object());
  set_temp("no_return", 1);
  set_temp("rider", me);
  me->set_temp("ridee", this_object());
  me->add_temp("apply/dodge", query("ride/dodge"));
  me->set_temp("ride/dodge", query("ride/dodge"));
  return 1;
}

int do_addoil() {
  object me = this_player();
  if (query("oil") >= query_max_oil())
    return 0;
  message_vision(YEL "$N" YEL "替$n" YEL "加入了少许机油。。。\n" NOR, me, this_object());
  check_self();
  add("oil", 50);
  me->start_busy(2);
  if (query("oil") >= query_max_oil())
    set("oil", query_max_oil());
  return 1;
}

string short() {
  object who;
  string str;
  if (objectp(who = query_temp("rider")))
    str = YEL + who->name() + YEL "驾驶中" NOR;
  else str = YEL "空置中" NOR;
  return query("name") + HIY " [ " NOR + str + HIY " ] " NOR;
}

varargs int _move(mixed dest, int silently) {
  object ob, who, env, *inv, me;
  int i;
  mapping exits;
  string str = "", str1 = "", *dirs;
  string ridemsg = "";
  me = this_object();
  if (!objectp(who = query_temp("rider"))) {
    check_self();
    return ::_move(dest, silently);
  }
  if (query("oil") < 10) {
    check_self();
    tell_object(
      who,
      HIR "警告:" + name() + HIR "机动力不足了" NOR YEL " >>>>>>>>>" NOR + sprintf(
        HIR "%d(%d%%)\n" NOR,
        query("oil"),
        query("oil") / 100
      )
    );
    tell_room(environment(), YEL + name() + YEL "”喀喀“一阵响后，停止了运作。。。\n" NOR);
    if (!present(who, environment()))
      who->move(environment());
    return 0;
  }
  if ( ::_move(dest, silently)) {
    add("oil", -10);
    check_self();
    tell_room(environment(), YEL + name() + YEL "”轰隆隆“的走了过来。。。\n" NOR);
    if (!present(who, environment()))
      who->move(environment());
    return 1;
  }
  return ::_move(dest, silently);
}

int do_shoot(string arg) {
  string str, str2;
  int pot = 10;
  object who, me = this_player();

  check_self();
  write(HIR "系统：查找攻击目标" NOR WHT ">>>>>>>>" NOR);

  if (!arg) {
    write(WHT ">>>>>>>" NOR HIR "查找失败，攻击目标不存在。\n" NOR);
    return 1;
  }
  who = present(arg, environment());
  if (!who)
    who = find_player(arg);
  if (!who)
    who = find_object(arg);
  if (!who)
    who = find_living(arg);
  if (!who || !objectp(environment(who))) {
    write(WHT ">>>>>>>" NOR HIR "查找失败，攻击目标不存在。\n" NOR);
    return 1;
  }
  if (!living(who) || who->query("kee") < 500 || who->query("eff_kee") < 500) {
    write(WHT ">>>>>>>" NOR HIR "锁定失败，攻击目标生命值过低。\n" NOR);
    return 1;
  }
  if (environment() != environment(who))
    pot += 50;

  if (query("oil") < pot) {
    write(WHT ">>>>>>>" NOR HIR "锁定失败，机动力不足。\n" NOR);
    return 1;
  }

  if (pot <= 10)
    write(WHT ">>>>>>>" NOR HIR "锁定成功，目标距离为 短距 。\n" NOR);
  else write(WHT ">>>>>>>" NOR HIR "锁定成功，目标距离为 长距 。\n" NOR);

  message_vision(YEL "$n" YEL "”轰隆“一声，开始运作起来！\n" NOR, me, this_object());

  str = environment()->query("short");
  if (MISC_D->find_place(environment()) != environment()->query("short"))
    str = MISC_D->find_place(environment()) + str;
  str2 = environment(who)->query("short");
  if (MISC_D->find_place(environment(who)) != environment(who)->query("short"))
    str2 = MISC_D->find_place(environment(who)) + str2;
  if (pot > 10) {
    message("shout", YEL "一道激光”啪啦“一声，从" + str + YEL "径直射向" + str2 + YEL "！\n" NOR, users());
    tell_object(who, HIR "一道激光”哗“的一声，径直射向了你！\n" NOR);
  }
  set("combat_exp", who->query("combat_exp") / 2 * 3);
  set_skill("dodge", who->query_skill("dodge", 1) * 3);
  set_skill("unarmed", who->query_skill("dodge", 1) * 3);
  COMBAT_D->do_attack(this_object(), who);
  this_object()->remove_killer(who);
  who->remove_killer(this_object());
  add("oil", -pot);
  check_self();
  return 1;
}

varargs void post1(object me, object victim, object weapon, int damage) {
  int i;
  while (num--) {
    if (!victim || !me)
      return;
    if (num <= 0)
      return;
    message_vision("“轰”的一声，第" + chinese_number(num) + "颗导弹在$n四周爆炸了！" NOR, me, victim);
    if (!living(victim) || victim->query("kee") <= 500) {
      message_vision("\n", me);
      return;
    }
    message_vision("$n给炸的血肉模糊！\n" NOR, me, victim);
    victim->receive_damage("kee", 500);
    COMBAT_D->report_status(victim);
  }
}

varargs void post2(object me, object victim, object weapon, int damage) {
  while (num--) {
    if (!victim || !me)
      return;
    if (num <= 0)
      return;
    message_vision("“飕飕”几声，一颗子弹从$n四周穿了过去！" NOR, me, victim);
    if (!living(victim) || victim->query("sen") <= 500) {
      message_vision("\n", me);
      return;
    }
    message_vision("$n给吓得屁滚尿流！\n" NOR, me, victim);
    victim->receive_damage("sen", 500);
    COMBAT_D->report_sen_status(victim);
  }
}

void check_self() {
  string msg = sprintf(BLINK BRED GRN "█" NOR HBRED WHT "机甲系统" NOR BLINK BGRN + RED "█" NOR WHT "：机动力" NOR HIG "查询" NOR YEL ">>>>>>>>" NOR);
  if (query("oil") > 0)
    msg += sprintf(YEL ">>>>>>>>" NOR HIR "完毕" NOR WHT "状态 " NOR HIR "正常" NOR WHT " 当前机动力" NOR HIR " %d " NOR WHT " ( %d%% ) \n" NOR,
      query("oil"), query("oil") / 100);
  else {
    msg += sprintf(YEL ">>>>>>>>" NOR HIR "完毕" NOR WHT "状态 " NOR HIR "危险\n" NOR);
    write(msg);
    die();
    return;
  }
  write(msg);
}
