#include <ansi.h>
inherit NPC;

int base = 50;

mapping clr = ([
        BLK"黑色"NOR    : "BLK", RED"暗红"NOR    : "RED", GRN"绿色"NOR    : "GRN",
        YEL"土黄"NOR    : "YEL", BLU"深蓝"NOR    : "BLU", MAG"紫色"NOR    : "MAG",
        CYN"墨绿"NOR    : "CYN", WHT"淡白"NOR    : "WHT", HIR"大红"NOR    : "HIR",
        HIG"鲜绿"NOR    : "HIG", HIY"金黄"NOR    : "HIY", HIB"蓝色"NOR    : "HIB",
        HIM"粉红"NOR    : "HIM", HIC"青色"NOR    : "HIC", HIW"白色"NOR    : "HIW",
        HBRED"赤绿"NOR  : "HBRED", HBGRN"双绿"NOR  : "HBGRN",
        HBYEL"黄绿"NOR  : "HBYEL", HBBLU"蓝绿"NOR  : "HBBLU",
        HBMAG"紫绿"NOR  : "HBMAG", HBCYN"青绿"NOR  : "HBCYN",
        HBWHT"白绿"NOR  : "HBWHT", BRED"红绿"NOR   : "BRED",
        BGRN"重绿"NOR   : "BGRN", BYEL"土绿"NOR   : "BYEL",
        BBLU"蓝青"NOR   : "BBLU", BMAG"紫青"NOR   : "BMAG",
        BCYN"暗青"NOR   : "BCYN",
]);
        
mapping val = ([
        "BLK"   : 11,
        "RED"   : 5,    
        "GRN"   : 1,
        "YEL"   : 4,
        "BLU"   : 6,
        "MAG"   : 7,
        "CYN"   : 2,
        "WHT"   : 10,
        "HIR"   : 8,
        "HIG"   : 15,
        "HIY"   : 19,
        "HIB"   : 9,
        "HIM"   : 13,
        "HIC"   : 3,
        "HIW"   : 20,
        "HBRED" : 21,
        "HBGRN" : 22,
        "HBYEL" : 23,
        "HBBLU" : 24,
        "HBMAG" : 25,
        "HBCYN" : 26,
        "HBWHT" : 27,
        "BRED"  : 28,
        "BGRN"  : 29,
        "BYEL"  : 30,
        "BBLU"  : 31,
        "BMAG"  : 32,
        "BCYN"  : 33,
]);

string how_do();

void create()
{
        set_name(HIG"颜"HIY"色"HIM"精"HIR"灵"NOR,({"jing ling","color jingling","color",}));
        set("title",HIW"小雨西游"NOR);
        set("gender","女性");
        set("per",40);
        set("age",16);
        set("inquiry",([
                "名字加颜色" : (: how_do :),
        ]));    
        setup();
}

string how_do()
{
        int i,flag=0;   
        string *str;    
        string arg = "给我一定的钱，就可以赋予你名字以相应的颜色:\n\n";
        str = keys(clr);
        i = sizeof(str);
        while(i--)
        {
                flag++;
                if( flag%4==0 )
                        arg+= "\n";
                arg+= "\t"+str[i]+" "+  val[clr[str[i]]]*base+"两黄金";
        }
        arg+= "\n"NOR;
        if( time()<query("speaker")+5 )  return "刷屏不好，你看看上面。。。";
        else set("speaker",time());
        return arg;
}

int accept_object(object who,object ob)
{
        int i,v;
        string *str,arg;
        if( ob->query("money_id") && v=ob->value()/10000 )
        {
                str = keys(val);
                i = sizeof(str);
                while(i--)
                {
                        if( val[str[i]]==v/base )
                        {
                                arg = str[i];
                                break;
                        }
                }
                if( stringp(arg) )
                {
                        who->set("name_color",arg);
                	tell_object(who,"你将自己的名字颜色设置成"+COLOR_D->replace_color(arg+"█",1)+NOR"了。\n");
                        return 1;
                }
        }               
        return 0;                                                               
}
