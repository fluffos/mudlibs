#include <ansi.h>
inherit NPC;

int ask_for_dan();

mapping plys = ([
	"brood" : 42,
	"sxuef" : 40,
	"amythk": 33,
	"uranus": 31,
	"skyfcd": 16,
	"bear"  : 16,
	"faint" : 11,
	"snowtu": 51,
]);	

void create()
{
	set_name("神曲", ({ "shen qu" }) );
	set("title",HIC"天赋使者"NOR);
	set("long","你可以向他打听天赋丹的消息。\n");
	set("gender", "男性");
	set("age", 140);
	set("attitude", "peaceful");
	set("per",32);
	set("int", 30);
	set("spi", 30);
	set("con", 30);
	set("cps", 30);
	set("cor", 20);
	set("atman", 200);
	set("max_atman", 200);

	set("force", 150);
	set("max_force", 150);
	set("force_factor", 5);

	set("mana", 200);
	set("max_mana", 200);

	set("combat_exp", 10000);
	set("daoxing", 50000);

	set("inquiry", ([
		"天赋丹" : (: ask_for_dan :),
	]) );
	setup();
	carry_object("/d/obj/cloth/changpao")->wear();
}


int ask_for_dan()
{
	int num,get;
	string *ids,id;
	object yao;
    object me = this_player();
    if( !userp(me) )
    	return 0;
	ids = keys(plys);
	id = me->query("id");
	if( !id )
		return 0;
	if( member_array(id,ids)==-1 )
	{
		if( me->query("giftmark/sq_12829") )
			return err_msg(CYN+name()+"说道：目前只派送到12年8月29日的统计，没有关于你的奖励，可能你没有参与或未报id。\n"NOR);	 
		yao = new("/d/obj/equip/gift_dan1");
		yao->set("owner_id",me->query("id"));
		if( yao->move(me) )
		{
			me->add("giftmark/sq_12829",1);
			me->save();
			tell_object(me,CYN+name()+"在怀中搓了半天，结果掏出一粒黑不溜秋的丹药，递给你。\n"NOR);
			return err_msg(CYN+name()+"说道：此丹共可调整你的天赋属性"+1+"点。\n"NOR);
		}	
		else
		{
			destruct(yao);
			return err_msg(CYN+name()+"说道：你妹哦，你身上东西太多了。\n"NOR);
		}
	}		

    get = me->query("giftmark/sq_12829");
	num = plys[id];
	if( num<=0 )
		return 0;

	num = num-get;
	if( num<=0 )
		return err_msg(CYN+name()+"说道：目前只派送到12年8月29日的统计，你已经领完了。\n"NOR); 
	
	yao = new("/d/obj/equip/gift_dan1");
	yao->set("owner_id",me->query("id"));

	if( yao->move(me) )
	{
		me->add("giftmark/sq_12829",1);
		me->save();
		tell_object(me,CYN+name()+"在怀中搓了半天，结果掏出一粒黑不溜秋的丹药，递给你。\n"NOR);
		return err_msg(CYN+name()+"说道：你还可以领取"+(num-1)+"次。\n"NOR);
	}	
	else
	{
		destruct(yao);
		return err_msg(CYN+name()+"说道：你身上东西太多了。\n"NOR);
	}
	
}
