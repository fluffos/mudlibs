#include <ansi.h>
inherit NPC;

string qixi();

void create() {
  set_name("织女", ({ "zhi nv", "nv", "girl" }));
  set("long",
    "西王母的外甥女。因为私自下凡与牛郎相爱，而被罚银河永隔，\n只有每年的七月初七才能鹊桥相会。\n");
  set("gender", "女性");
  set("age", 20);
  set("class", "xian");
  set("title", "");
  set("attitude", "friendly");
  set("rank_info/respect", "仙姑");
  set("per", 30);
  set("int", 30);
  set("title", HIG "七夕之夜" NOR);
  set("inquiry", ([
    "gift": (: qixi :),
  ]));
  set_skill("force", 200 + random(200));
  setup();
  set_temp("apply/karma", 50000);
  carry_object(0, "cloth", 1)->wear();
  carry_object(0, "ring", 1)->wear();
  carry_object(0, "neck", 1)->wear();
  carry_object(0, "shoes", 1)->wear();
}

string qixi() {
  object me = this_player();

  if (!me || !living(me) || !userp(me)
    || !present(me, environment()))
    return 0;
  if (me->query("giftmark/20120823"))
    return "银烛秋光冷画屏，轻罗小扇扑流萤。\n";

  return "你要许什么愿？(wish)";
}

void init() {
  add_action("do_wish", "wish");
}

int do_wish(string arg) {
  object me = this_player();

  if (me->query("giftmark/20120823") || !userp(me)
    || !present(me, environment()))
    return 0;
  if (!arg || (arg != "exp" && arg != "qn" && arg != "dx"))
    return err_msg("你要什么？(exp|qn|dx)\n");

  switch (arg) {
    case "exp": me->add("combat_exp", 300000); break;
    case "qn": me->add("potential", 150000); break;
    default: me->add("daoxing", 300000); break;
  }
  me->set("giftmark/20120823", 1);
  write(HIY "你低下头，诚心祈愿：天下所有有情人能终成眷属。。。。\n" NOR);
  write(HIC "你得到了你想要的。。。\n" NOR);
  me->save();
  return 1;
}
