#include <ansi.h>
inherit NPC;
void create() {
  seteuid(getuid());
  set_name("李白", ({ "li bai", "li" }));
  set("long", "大诗人李白，清高飘逸，剑术通神。\n");
  set("gender", "男性");
  set("title", "诗仙");
  set("class", "scholar");
  set("age", 37);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 100000);
  set("attitude", "heroism");
  set("chat_chance", 10);
  set_skill("dodge", 80);
  set_skill("force", 80);
  set_skill("parry", 80);
  set_skill("unarmed", 80);
  set_skill("sword", 180);
  set_skill("qinglian-jian", 200);
  set_skill("wuzheng-force", 100);
  set_skill("literate", 320);
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 10);
  set("max_kee", 700);
  set("max_gin", 400);
  set("max_sen", 500);
  create_family("散仙派", 3, "蓝");
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/d/obj/book/poem");
  add_money("silver", 40);
}

int is_job() { return 1; }
