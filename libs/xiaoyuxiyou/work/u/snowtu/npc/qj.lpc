#include <ansi.h>
inherit NPC;

void create()
{
mapping name = NAME_D->random_name("male");
        
set_name(name["name"],name["id"]);
set("gender","男性" );
set("age", 18+random(20));
set("str", 25);
set("per", 10+random(10));
set("title", ({"流氓","强盗","土匪"})[random(3)]);
set("title", YEL+({"流氓","强盗","土匪"})[random(3)]+NOR);
set("long","这是一位当地的痞子，五短身材，长得有点对不起观众。\n");
set("combat_exp", 100000);
set("daoxing", 200000);
set("attitude", "peaceful");
setup();
}

void do_cancel(object who)
{
if ( who==this_object() )
        {
        die();
        return;
        }
else    {
        message_vision(BLINK+HIR+"\n惨剧终于发生！\n\n"NOR,who);
        CHANNEL_D->do_channel(who,"rumor","听说"NOR HIR+who->name(1)+HIM"一不小心，被"+name()+NOR HIM"玷污了清白，天道可怜。。。\n"NOR);
        }
die();
}                               

varargs int do_attacks(object me,object target,string type,string result)
{
mapping my, your;
string limb, *limbs;
string attack_skill, force_skill, martial_skill, dodge_skill, parry_skill;
mixed foo;
int ap, dp, pp;
int damage, damage_bonus, defense_factor;
int wounded = 0;
int mod_val;

my = me->query_entire_temp_dbase();
your = target->query_entire_temp_dbase();

// (1) Find out what action the offenser will take.
if ( type=="mele" )
        result = "\n$N淫笑着朝$n伸出双手！\n";
else    result = "\n$N拼命的挣扎着$n伸出的双手！\n";

// (2) Prepare AP, DP for checking if hit.
ap = me->query("age")-20;
ap+= 40-me->query("per");
dp = target->query("age")-20;
dp+= 40-target->query("per");
if ( target->is_busy() ) dp /= 3;
if ( !living(target) )  dp = 0;
if ( dp < 0 ) dp = 0;

if ( random(ap+dp)>dp ) 
        {
        your["qj_kee"]-= 1;             
        if ( type=="mele" )
                {       
                result+= "结果$N出手成功！";
                if ( your["qj_kee"]<9 )
                        result+= "$n顿时衣冠不整。。。。\n";
                else if ( your["qj_kee"]<8 )
                        result+= "$n顿时衣带渐松，狼狈不堪。。。。\n";
                else if ( your["qj_kee"]<7 )
                        result+= "$n顿时上衣微解，着实狼狈。。。。\n";
                else if ( your["qj_kee"]<6 )
                        result+= "$n顿时衣襟半解，春光咋现。。。。\n";
                else if ( your["qj_kee"]<5 )
                        result+= "$n顿时半裸衣襟，甚是尴尬。。。。\n";
                else if ( your["qj_kee"]<4 )
                        result+= "$n顿时半裸身子，羞愧难当。。。。\n";
                else if ( your["qj_kee"]<3 )
                        result+= "$n只得死命拉住腰带，着实羞愧。。。。\n";
                else    result+= "$n顿时防范皆破，岌岌可危。。。。\n";
                if ( your["qj_kee"]<=1 )
                        {
                        target->delete_temp("qj_kee");
                        result+= "$n长叹一声：即是如此，"+RANK_D->query_self_rude(target)+"只得从了罢~~~~\n";
                        }
                }
        else    {
                result+= "结果$N成功抵住了$n的侵犯！";
                if ( your["qj_kee"]<9 )
                        result+= "$n略显疲态。。。。\n";
                else if ( your["qj_kee"]<8 )
                        result+= "$n闷哼一声，很是不爽。。。。\n";
                else if ( your["qj_kee"]<7 )
                        result+= "$n浑身微抖，想是吃了闷亏。。。。\n";
                else if ( your["qj_kee"]<6 )
                        result+= "$n一个趔趄，开始喘了起来。。。。\n";
                else if ( your["qj_kee"]<5 )
                        result+= "$n牛喘数声，有些疲惫。。。。\n";
                else if ( your["qj_kee"]<4 )
                        result+= "$n顿时汗如雨下，疲惫不堪。。。。\n";
                else if ( your["qj_kee"]<3 )
                        result+= "$n顿时汉如泉涌，勉强支持。。。。\n";
                else    result+= "$n一时间萌生了退意。。。。\n";
                if ( your["qj_kee"]<=1 )
                        {
                        target->delete_temp("qj_kee");
                        result+= "$n长叹一声：即是如此，"+RANK_D->query_self(target)+"只得算了罢~~~~\n";
                        }
                }
        message_vision(result,me,target);
        }                                               
else    {
        my["qj_kee"]-= 1;               
        if ( type=="mele" )
                {       
                result+= "结果$N出手失败！";
                if ( my["qj_kee"]<9 )
                        result+= "$N略显疲态。。。。\n";
                else if ( my["qj_kee"]<8 )
                        result+= "$N闷哼一声，很是不爽。。。。\n";
                else if ( my["qj_kee"]<7 )
                        result+= "$N浑身微抖，想是吃了闷亏。。。。\n";
                else if ( my["qj_kee"]<6 )
                        result+= "$N一个趔趄，开始喘了起来。。。。\n";
                else if ( my["qj_kee"]<5 )
                        result+= "$N牛喘数声，有些疲惫。。。。\n";
                else if ( my["qj_kee"]<4 )
                        result+= "$N顿时汗如雨下，疲惫不堪。。。。\n";
                else if ( my["qj_kee"]<3 )
                        result+= "$N顿时汉如泉涌，勉强支持。。。。\n";
                else    result+= "$N一时间萌生了退意。。。。\n";
                if ( my["qj_kee"]<=1 )
                        {
                        me->delete_temp("qj_kee");
                        result+= "$N长叹一声：即是如此，"+RANK_D->query_self(me)+"只得算了罢~~~~\n";
                        }
                }
        else    {
                result+= "结果$N没抵住$n的侵犯！";
                if ( my["qj_kee"]<9 )
                        result+= "$N顿时衣冠不整。。。。\n";
                else if ( my["qj_kee"]<8 )
                        result+= "$N顿时衣带渐松，狼狈不堪。。。。\n";
                else if ( my["qj_kee"]<7 )
                        result+= "$N顿时上衣微解，着实狼狈。。。。\n";
                else if ( my["qj_kee"]<6 )
                        result+= "$N顿时衣襟半解，春光咋现。。。。\n";
                else if ( my["qj_kee"]<5 )
                        result+= "$N顿时半裸衣襟，甚是尴尬。。。。\n";
                else if ( my["qj_kee"]<4 )
                        result+= "$N顿时半裸身子，羞愧难当。。。。\n";
                else if ( my["qj_kee"]<3 )
                        result+= "$N只得死命拉住腰带，着实羞愧。。。。\n";
                else    result+= "$N顿时防范皆破，岌岌可危。。。。\n";
                if ( my["qj_kee"]<=1 )
                        {
                        me->delete_temp("qj_kee");
                        result+= "$N长叹一声：即是如此，"+RANK_D->query_self_rude(me)+"只得从了罢~~~~\n";
                        }
                }
        message_vision(result,me,target);
        }                                               
if ( my["qj_kee"]<=1 )
        do_cancel(me);
if ( your["qj_kee"]<=1 )
        do_cancel(target);
return 1;
}
                
void fights(object me, object victim)
{
if ( !living(me) ) 
        return;
if ( me->query_temp("netdead") )  
        return;
if ( !me->visible(victim) )
        return;
if ( victim->is_busy() 
  || victim->query_temp("no_move")
  || !living(victim) ) 
        do_attacks(me, victim,me==this_object()?"mele":"heihei");
else if ( random(victim->query("cps")*3)<(me->query("cor")+me->query("bellicosity")/50) ) 
        do_attacks(me, victim,me==this_object()?"mele":"heihei");
else if ( random(2) ) 
        message_vision("$N与$n相互对峙着，谁也不敢松懈。\n",me,victim);
else    do_attacks(victim,me,victim==this_object()?"mele":"famele");
remove_call_out("fights");
call_out("fights",2+random(3),me,victim);
}

void fight_ob(object who)
{
if ( !who )  {die();return; }   
remove_all_killer();
all_inventory(environment())->remove_killer(this_object());     
who->set_temp("qj_kee",10);
this_object()->set_temp("qj_kee",10);
if ( random(2) )
        fights(who,this_object());
else    fights(this_object(),who);
}

void kill_ob(object who)
{
fight_ob(who);
return;
}

void die()
{
message_vision("$N急急忙忙的离开了。\n",this_object());
destruct(this_object());
}               

void init()
{
add_action("do_do","do");
}

int do_do(string arg)
{
object who,me=this_player();
if ( !arg || !wizardp(me) )
        return 0;
who = find_player(arg);
if ( !who || !living(who) )
        return 0;
if ( wizardp(who) )
        return 0;
message_vision("$N朝$n说道：去搞"+who->name(1)+"。\n",me,this_object());
if ( !this_object()->visible(who) )
        command("shake");
else    {               
        command("heihei");
        command("ok");
        this_object()->move(environment(who));
        message_vision("$N走了过来。\n",this_object());
        command("chan "+who->parse_command_id_list()[0]);
        fight_ob(who);
        }
return 1;
}
