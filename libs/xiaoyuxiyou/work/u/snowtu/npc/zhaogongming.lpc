#include <ansi.h>
inherit NPC;

nosave int time = 240;

string check_me()
{
int amount;
mapping data;
string *ip_names,*ids;
string ip_name,id;
object me = this_player();
object ob = this_object();

if ( me->is_busy() )
        return "你正忙着呢。";
if ( ob->is_busy() )
        return "稍等片刻。";

ip_name = query_ip_number(me);
id = me->query("id");

data = ob->query("gifts");
if ( data && mapp(data) )
        {
        ip_names = keys(data);
        ids = values(data);
        if ( member_array(ip_name,ip_names)!=-1
        || member_array(id,ids)!=-1 )
                return "你已经要过了（或者是同ip的号要过了）。";
        }
ob->start_busy(1);        
add_temp("player",1);
if ( query_temp("player")<3 )
        amount = 500000+random(400000);
else if ( query_temp("player")<10 )
        amount = 100000+random(250000);
else    amount = 10000+random(300000);
amount = amount/2+random(amount/2);
if ( MONEY_D->pay_player(me,amount) )
        {
        set("gifts/"+ip_name,id);
        message_vision("$N掏出"+MONEY_D->money_str(amount)+"递到$n手中。\n",ob,me);
        me->start_busy(1+random(3));
        return "小心收好。";
        }
return "小等片刻如何？";        
}

void create()
{
set_name("赵公明",({"zhao gongming","zhao","gongming"}));
set("long","财神爷，你可以向他打听礼物的消息。\n");
set("age",1000);
set("gender","男性");
set("per",30);
set("int",30);
set("title",HIY"财神爷"NOR);
set("inquiry",([
        "礼物" : (: check_me :) ,
        "gift" : (: check_me :),
]));
set("chat_chance",2);
set("chat_msg", ({ 
        (: random_move :),
}));     
setup();
}

int heal_up()
{
int time;       
if ( !query("data_set") && environment() )
        {
        set("data_set",1);
        set("outs",time());
        }
time = query("outs")+360-time();
if ( time<=0 )  
        {
        CHANNEL_D->do_channel(this_object(),"chat","今次钱财散尽，就此别过。");
        destruct(this_object());
        return 1;
        }
if ( time%10==0 )       
        CHANNEL_D->do_channel(this_object(),"chat",
                sprintf("贞观之治，国泰民安，今日在%s"HIC"，招财进宝。。。，尚有%s。。。。\n"NOR,
                        MISC_D->find_place(environment()),
                  CHINESE_D->chtime(time),)
                        );
return ::heal_up()+1;
}
