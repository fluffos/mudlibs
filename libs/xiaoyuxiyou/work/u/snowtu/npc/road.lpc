#include <ansi.h>
inherit NPC;

nosave object *Find;
nosave int First = 0;
nosave string *errs;

void kill_ob(object who)
{
	if( !environment() )
		return;
	remove_all_killer();
	all_inventory(environment())->remove_killer(this_object());
}

void create()
{
	set_name("日志",({"system log","log"}));
	set_level(100);
	setup();
	Find = ({});
}

void check_dir(string dir)
{
	object ob;
	mixed *dirs,*now_dirs,*arrs,err;
	string file_n,temp;
	int file_s;
	int i;
	if( !dir )
		dir = "/d/";
	dirs = get_dir(dir,-1);
	if( !dirs || !arrayp(dirs) || sizeof(dirs)<1 )
	{
		say(name()+"说道："+dir+"扫描完成，无动作。");
		return;
	}
	for(i=0;i<sizeof(dirs);i++)
	{
		reset_eval_cost();
		now_dirs = dirs[i];
		if( !now_dirs || !arrayp(now_dirs) || sizeof(now_dirs)<1 )
			continue;
		file_n = now_dirs[0];
		file_s = now_dirs[1];
		if( file_s==-2 )
		{
			temp  = dir+file_n+"/";
			check_dir(temp);
			continue;
		}
		else if( file_s<=0 )
			continue;
		temp = dir+file_n;	
		if( file_size(temp)>0 )
		{
			err = catch(clone_object(temp));
			if( err )
			{
				errs+= ({temp});
				continue;
			}
			else
			{
				ob = find_object(temp);
				if( ob
				 && ob->query_max_encumbrance()>50000000000 
				 && ob->query("short") )
				{
					if( First==0 )
					{
						First = 1;
						Find = ({temp});
					}	
					else	Find+= ({temp});
				}
			}	
		}
	}
	set("AA",errs);
	say(name()+"说道："+dir+" 扫描完毕。\n");
}
		
void init()
{
	add_action("do_start","start");
	add_action("do_start2","do");
}

int do_start(string arg)
{
	First = 0;
	errs = ({});
	check_dir(arg);
	return 1;
}	

int do_start2()
{
	string str,name,*list;
	int i,k,j;
	object *inv,ob,*obj;
	mixed err;
	if( !Find || !arrayp(Find) || sizeof(Find)<1 )
		return err_msg("还未扫描。\n");
	set("startroom",environment());	
	First = 0;
	str = "";
	reset_eval_cost();	
	for(i=0;i<sizeof(Find);i++)
	{
		if( Find[i]->query("short")==HIR"拔舌地狱"NOR
		 || Find[i]->query("short")=="长安大牢"
		 || Find[i]->query("short")=="鸿蒙之外"
		 || Find[i]->query("short")=="黑暗中" )
			continue;
		err = catch(this_object()->move(Find[i]));
		if( err )
		{
			shout(sprintf("%O 无法MOVE\n",Find[i]));
			continue;
		}
		this_object()->move(Find[i]);
		message_vision("$N过来检查了。\n",this_object());
		name = MISC_D->find_place(environment());
		if( !name )
		{
			move(query("startroom"));
			say(sprintf("%O没有place_name\n",Find[i]));
			break;
		}
		if( First==0 )
		{
			First = 1;
			str+= name+" \n";
		}
		inv = all_inventory(environment());
		for(k=0;k<sizeof(inv);k++)
		{
/*所有NPC*/
			if( inv[k]->query("startroom")==base_name(environment())
			 && inv[k]->is_character() )
				//str+= sprintf("	%30-s:%30-s:%s\n",base_name(environment()),COLOR_D->clean_color(inv[k]->short()),base_name(inv[k]));
				str+= sprintf("	%30-s:%30-s:%s\n",environment()->query("short"),COLOR_D->clean_color(inv[k]->short()),base_name(inv[k]));

/*			if( inv[k]->query("startroom")==base_name(environment())
			 && inv[k]->is_character()
			 && obj=all_inventory(inv[k]) )
			{
				j = sizeof(obj);
				while(j--)
				{
					if( sscanf(base_name(obj[j]),"/d/obj/narmor/%*s") 
					 || sscanf(base_name(obj[j]),"/obj/money/%*s") 
					 || sscanf(base_name(obj[j]),"/d/obj/nweapon/%*s") )
					 	continue;	
					str+= sprintf("           %30s : %s\n",obj[j]->short(),base_name(obj[j]));
				}	
			}
*/
		}
	}	
	write_file(__DIR__+name,str,1);
	move(query("startroom"));
	say("查找完毕。\n");
	return 1;
}
	
	
	