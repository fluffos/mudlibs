#include <ansi.h>
inherit NPC;

void create() {
  set_name("自创perform临时NPC", ({ "perform npc", "npc" }));
  setup();
}

void init() {
  add_action("do_perform", "perform");
}

void type_perform(object me, string arg) {
  object pfm;
  if (!me)
    return;
  pfm = me->query_temp("perform_OBJ");
  if (!pfm)
    return;
  switch (arg) {
    case "1":
      pfm->set("busy_self", random(3));
      pfm->set("busy_target", 1 + random(5));
      break;
    default:
      write(@LONG
请输入你想要自创的perform绝招的类型：
        1.  busy技      使敌人busy的技能，失败可能会导致自身busy 1-2秒
        2.  连击技      连续对敌人进行攻击，发出后自身会busy 2-3 秒
        3.  猛击技      对敌人进行狠狠的一击，延迟型绝招
LONG);
      write("请输入你想要自创的perform绝招的类型：(1|2|3)");
      input_to((: call_other, __FILE__, "type_perform", me :));
      return;
  }
  pfm->save();
  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    "听说" HIR + me->name(1) + HIM "自悟一招绝技" HIR + pfm->query("name") + HIY " perform " + pfm->query("id") + HIM "。" NOR
  );
  return;
}

void name_perform(object me, string arg) {
  object pfm;
  if (!me)
    return;
  pfm = me->query_temp("perform_OBJ");
  if (!pfm)
    return;
  pfm->set("name", arg);
  write(@LONG
请输入你想要自创的perform绝招的类型：
        1.  busy技      使敌人busy的技能，失败可能会导致自身busy 1-2秒
        2.  连击技      连续对敌人进行攻击，发出后自身会busy 2-3 秒
        3.  猛击技      对敌人进行狠狠的一击，延迟型绝招
LONG);
  write("请输入你想要自创的perform绝招的类型：(1|2|3)");
  input_to((: call_other, __FILE__, "type_perform", me :));
  return;
}

int do_perform(string arg) {
  object pfm, me = this_player();
  if (!arg || !wizardp(me))
    return 0;
  if (me->query("new_pfm/" + arg)) {
    write("你已创了" + arg + "的绝技。\n");
    return 1;
  }
  pfm = new("/obj/perform.lpc");
  if (!pfm)
    error("\n自制pfm控制文件残缺。\n");
  pfm->set("owner_id", me->query("id"));
  pfm->set("id", arg);
  me->set_temp("perform_OBJ", pfm);
  write("请输入你想要自创的pfm的中文名:");
  input_to((: call_other, __FILE__, "name_perform", me :));
  return 1;
}
