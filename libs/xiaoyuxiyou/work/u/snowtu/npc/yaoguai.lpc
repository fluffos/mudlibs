#include <ansi.h>
inherit NPC;

string only_attack_type()
{
return "cast";
}

string *nick = ({
        "千秋不朽业，尽在杀人中",
        "睚眦即杀人，身比鸿毛轻",
        "又有雄与霸，杀人乱如麻",
        "驰骋走天下，只将刀枪夸",
        "今欲觅此类，徒然捞月影",
        "竖儒蜂起壮士死，神州从此夸仁义",
        "名声同粪土，不屑仁者讥",
        "身佩削铁剑，一怒即杀人",
        "割股相下酒，谈笑鬼神惊",
        "千里杀仇人，愿费十周星",
        "专诸田光俦，与结冥冥情",
        "朝出西门去，暮提人头回",
        "神倦唯思睡，战号蓦然吹",
        "西门别母去，母悲儿不悲",
        "身许汗青事，男儿长不归",
        "杀斗天地间，惨烈惊阴庭",
        "三步杀一人，心停手不停",
        "血流万里浪，尸枕千寻山",
        "壮士征战罢，倦枕敌尸眠",
        "梦中犹杀人，笑靥映素辉",
        "女儿莫相问，男儿凶何甚",
        "古来仁德专害人，道义从来无一真",
        "狮虎猎物获威名，可怜麋鹿有谁怜",
        "世间从来强食弱，纵使有理也枉然",
        "男儿行，当暴戾",
        "事与仁，两不立",
        "男儿事在杀斗场，胆似熊罴目如狼",
        "生若为男即杀人，不教男躯裹女心",
        "男儿从来不恤身，纵死敌手笑相承",
        "仇场战场一百处，处处愿与野草青",
        "杀一是为罪，屠万是为雄",
        "屠得九百万，即为雄中雄",
        "千年仁义名，但使今生逞雄风",
        "美名不爱爱恶名，杀人百万心不惩",
        "宁教万人切齿恨，不教无有骂我人",
        "放眼世界几千年，何处英雄不杀人",
});

void create()
{
int i;  
string nn,temp; 
mapping name;
name = NAME_D->random_name("yaoguai");
set_name(name["name"],name["id"]);
set("title",HIR"狮驼密探"NOR);
set("nickname",HIM+nick[random(sizeof(nick))]+NOR);
set("gender","中性");
set("per",5);
set("str",60);
set("int",60);
set("spi",60);
set("cps",60);
set("con",60);
nn = query("name");
i = strlen(nn);
nn = sprintf("%s",nn[0..i-3]);
temp = sprintf("%s",nn[i-2..i-1]);
if ( temp!="精" && temp!="怪" )
        nn = query("name");
set("long","此怪乃是"+nn+"修炼成人形，因狮驼国王欲刺探东土状况，
此物便蠢蠢欲动，自荐出来看看风土人情，兼着打打牙祭。");

set("max_kee",10000);
set("eff_kee",10000);
set("kee",10000);
set("max_sen",10000);
set("eff_sen",10000);
set("sen",10000);
set("combat_exp",10000);
set("daoxing",1000);

setup();
}


