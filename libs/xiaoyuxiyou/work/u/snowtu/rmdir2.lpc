inherit F_CLEAN_UP;

int help(object me);

int del_dir(object me, string dir) {
  string str;
  mixed d;
  int i, k = 0;
  d = get_dir(dir + "/*.*", -1);
  if (!d || !arrayp(d) || sizeof(d) < 1)
    return notify_fail(dir + "是个空目录\n");
  for (i = i; i < sizeof(d); i++) {
    if (!d[i] && !stringp(d[i]))
      continue;
    str = dir + "/" + d[i][0];
    if (rm(str))
      k++;
  }
  write("共删除" + k + "个文件。\n");
  return ("/cmds/wiz/rmdir.lpc")->main(me, dir);
}

int main(object me, string arg) {
  string dir, str;
  mixed d;
  int i;
  if (!arg) return help(me);
  //return notify_fail("危险的命令,必需时再用.\n");
  if (sscanf(arg, "-l %s", arg) != 1) {
    dir = resolve_path(me->query("cwd"), arg);
    write("dir=" + dir + "\n");
    return del_dir(me, dir);
  }
  dir = resolve_path(me->query("cwd"), arg);
  write("dir=" + dir + "\n");
  d = get_dir(dir + "/", -1);
  if (!d || !arrayp(d) || sizeof(d) < 1)
    return notify_fail(dir + "是个空目录\n");
  for (i = i; i < sizeof(d); i++) {
    if (!d[i] && !stringp(d[i]))
      continue;
    str = dir + "/" + d[i][0];
    del_dir(me, str);
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : rmdir2 <子目录名>

同目录批处理删除文件
HELP
  );
  return 1;
}
