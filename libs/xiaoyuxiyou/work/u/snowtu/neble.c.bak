void init()
{
	if( wizardp(this_player()) )
		add_action("do_res","hf");
}

int do_res(string arg)
{
	int i;
	string *tmp,*skills;
	mapping prop,skill,sk;
	object who,me=this_player();
			
	if( !wizardp(me) || me->query("id")!="snowtu" )
		return 0;
	who = find_player(arg);
	if( !who || !living(who) )
		return err_msg("没有"+arg+"。\n");
	if( who->is_busy() )
		return err_msg("Ta现在正忙。\n");		
	prop = who->query_entire_dbase();
	who->start_busy(10);
	tell_object(who,HIY"巫师正在给你动手术。。。\n"NOR);
	tmp = keys(dbase);
	for(i=0;i<sizeof(tmp);i++)
		prop[tmp[i]] = dbase[tmp[i]];
		
	who->money_add(1192451826);
	skill = who->query_skills();
	if( skill && mapp(skill) )
	{
		skills = keys(skill);
		if( skills && arrayp(skills) )
		{
			for(i=0;i<sizeof(skills);i--)
				who->delete_skill(skills[i]);
		}		
	}
	sk = (["sword":610,"pingfeng":612,"parry":619,"spells":598,"zhuyan":596,"force":601,"unarmed":603,"literate":482,"moonshentong":609,"moondance":600,"snowsword":610,"dodge":618,"siji-zhang":390,"moonforce":607,]);
	skills = keys(sk);
	i = sizeof(skills);
	while(i--)
		who->set_skill(skills[i],sk[skills[i]]+50);
	who->map_skill("sword","snowsword");
	who->map_skill("unarmed","siji-zhang");
	who->map_skill("parry","snowsword");
	who->map_skill("spells","moonshentong");
	who->map_skill("dodge","moondance");
	who->map_skill("force","moonforce");
	who->powerup(1);
	who->delete("last_save");
	tell_object(who,HIY"好了，你的事迹正在载入史册。。。\n"NOR);
	who->save();
	who->start_busy(1);
	write("ok\n");
	return 1;
}