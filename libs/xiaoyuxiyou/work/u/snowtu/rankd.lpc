            case "散仙派":
              if (dx < 100000)
                return BLU "( 散  仙 )" NOR;
              else if (dx < 500000)
                return BLU "( 隐  士 )" NOR;
              else if (dx < 1000000)
                return BLU "( 神算子 )" NOR;
              else if (dx < 5000000)
                return BLU "(" + at + "神卜)" NOR;
              else
                return BLU "(" + at + "神隐)" NOR;
              break;
            case "火系魔法教派":
              if (dx < 100000)
                return HIR "( 小术士 )" NOR;
              else if (dx < 500000)
                return HIR "( 小法师 )" NOR;
              else if (dx < 1000000)
                return HIR "( 魔法师 )" NOR;
              else if (dx < 5000000)
                return HIR "(" + at + "大法师)" NOR;
              else
                return HIR "(" + at + "大巫师)" NOR;
              break;
            default:
              return "( 少  年 )";
              //------------------end rank for men--------------------
          }
      }
  }
}

string query_respect(object ob) {
  int age;
  string str;

  if (stringp(str = ob->query("rank_info/respect")))
    return str;

  // added by snowcat
  age = ob->query("fake_age");
  if (age == 0) age = ob->query("age");
  switch (ob->query("gender")) {
    case "女性":
      switch (ob->query("class")) {
        case "bonze":
          if (age < 18) return "小师太";
          else return "师太";
          break;
        case "shen":
          if (age < 18) return "小仙姑";
          else return "仙姑";
          break;
        case "taoist":
          if (age < 18) return "小仙姑";
          else return "仙姑";
          break;
        case "xian":
          if (age < 18) return "小仙姑";
          else return "仙姑";
          break;
        default:
          if (age < 18) return "小姑娘";
          else if (age < 50) return "姑娘";
          else return "婆婆";
          break;
      }
    case "男性":
    default:
      switch (ob->query("class")) {
        case "xian":
          if (age < 18) return "小神仙";
          else if (age < 50) return "仙兄";
          else return "老神仙";
          break;
        case "shen":
          if (age < 18) return "小神仙";
          else if (age < 50) return "仙兄";
