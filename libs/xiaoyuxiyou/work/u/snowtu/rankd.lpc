string gettof(object me, object ob) {
  object weapon;
  string skill_type, parry_type;
  int attack_points;
  if (objectp(weapon = ob->query_temp("weapon"))) {
    skill_type = weapon->query("skill_type");
    parry_type = "parry";
  } else {
    skill_type = "unarmed";
    parry_type = "unarmed";
  }

  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  return tough_level(attack_points);
}

string tough_level(int power) {

  int lvl;
  int rawlvl;
  int grade = 1;
  if (power < 0) power = 0;
  //        rawlvl = (int) pow( (float) 0.01 * power, 0.3);
  rawlvl = (int)pow((float)1.0 * power, 0.3);
  lvl = to_int(rawlvl / grade);
  if (lvl >= sizeof(tough_level_desc))
    lvl = sizeof(tough_level_desc) - 1;
  return tough_level_desc[((int)lvl)];
}
//////////////////////////////
string describe_dx(int value) {
  int grade, two_year, n;

  //        two_year = value/2000;
  //        two_year = value/5000;
  two_year = value / 100000;
  for (grade = 0; grade < sizeof(dx_level_desc); grade++)  //sizeof(dx_level_desc)
  {
    n = (grade + 1) * (grade + 1) * (grade + 1);
    if (two_year < n) break;
  }
  if (grade >= sizeof(dx_level_desc)) grade = sizeof(dx_level_desc) - 1;
  return dx_level_desc[grade];
}

string dx_need() {
  string str;
  int i, tmp;
  float dx, x, y;
  int max_dx;
  i = sizeof(dx_level_desc);
  str = "◇" + MUDLIB_NAME + "道行要求：\n";
  while (i--) {
    y = to_float(i + 1);
    dx = pow(y, 3.0);
    tmp = to_int(dx);
    max_dx = tmp * 100;
    str += "\t" + sprintf("%20s : %d年\n", dx_level_desc[i], max_dx,);
  }
  return str;
}

string exp_need() {
  string str;
  int i, tmp;
  float dx, x, y;
  int max_dx;
  i = sizeof(exp_level_desc);
  str = "◇" + MUDLIB_NAME + "武学要求：\n";
  while (i--) {
    y = to_float(i + 1);
    dx = pow(y, 3.0);
    tmp = to_int(dx);
    max_dx = tmp * 5000;
    str += "\t" + sprintf("%20s : %d\n", exp_level_desc[i], max_dx,);
  }
  return str;
}

int grade_dx(string desc) {
  int grade, n;

  for (grade = 0; grade < sizeof(dx_level_desc); grade++) {
    n = grade;
    if (dx_level_desc[grade] == desc)
      return n;
  }
  return 0;
}

string describe_exp(int value) {
  int grade, lvl, n;

  //        lvl = value/100;
  //        lvl = value/250;
  lvl = value / 5000;
  //note, this is to make 深不可测 requires 2700k combat_exp,
  //which also means player can learn skill level to 300.

  for (grade = 0; grade < sizeof(exp_level_desc); grade++) {
    n = (grade + 1) * (grade + 1) * (grade + 1);
    if (lvl < n) break;
  }
  if (grade >= sizeof(exp_level_desc)) grade = sizeof(exp_level_desc) - 1;
  return exp_level_desc[grade];
}

int grade_exp(string desc) {
  int grade, n;

  for (grade = 0; grade < sizeof(exp_level_desc); grade++) {
    n = grade;
    if (exp_level_desc[grade] == desc)
      return n;
  }
  return 0;
}

string describe_neili(int value) {
  int year, sixty, left;
  string line;

  year = value / 100;
  sixty = year / 60;
  left = year - sixty * 60;

  if (year <= 0) {
    line = HIB "不到一年" NOR;
    return line;
  }

  if (sixty > 0) {
    if (left != 0) {
      line = HIW + chinese_number(sixty) + "甲子" + NOR + "又" + HIR + chinese_number(left) + "年" + NOR;
    } else {
      line = HIW + chinese_number(sixty) + "甲子" + NOR;
    }
  } else
    line = HIR + chinese_number(year) + "年" + NOR;

  return line;
}

string describe_fali(int value) {
  int grade, lvl, n;

  //in unit of 40, increase by n^2.
  //        lvl=value/40;
  lvl = value / 50;
  for (grade = 0; grade < sizeof(fali_level_desc); grade++) {
    n = (grade + 1) * (grade + 1);
    if (lvl < n) break;
  }
  if (grade >= sizeof(fali_level_desc)) grade = sizeof(fali_level_desc) - 1;
  return fali_level_desc[grade];
}

int grade_fali(string desc) {
  int grade;

  for (grade = 0; grade < sizeof(fali_level_desc); grade++) {
    if ((string)fali_level_desc[grade] == desc)
      return grade;
  }
  return 0;
}

string query_description(int type) {
  int i;
  string *level_desc;
  string line = "";

  if (type == 0) level_desc = dx_level_desc;
  else if (type == 1) level_desc = exp_level_desc;
  else if (type == 2) level_desc = fali_level_desc;
  else level_desc = tough_level_desc;

  for (i = 0; i < sizeof(level_desc); i++) {
    line += level_desc[i] + "    ";
    if ((i % 5) == 4) line += "\n";
  }

  return line;
}
//门派的五行设置
string query_wuxing(object ob) {
  switch (ob->query("family/family_name")) {
    case "南海普陀山":
      return "tu";
      break;
    case "阎罗地府":
      return "shui";
      break;
    case "方寸山三星洞":
      return "mu";
      break;
    case "月宫":
      return "jin";
      break;
    case "大雪山":
      return "mu";
      break;
    case "五庄观":
      return "huo";
      break;
    case "东海龙宫":
      return "shui";
      break;
    case "将军府":
      return "jin";
      break;
    case "火云洞":
      return "huo";
      break;
    case "陷空山无底洞":
      return "tu";
      break;
    case "蜀山派":
      return "jin";
      break;
    case "百花谷":
      return "mu";
      break;
    case "散仙派":
      return "shui";
      break;
    default:
      return "none";
  }
}
string query_wuxing_c(object ob) {
  switch (ob->query("family/family_name")) {
    case "南海普陀山":
      return YEL "土" NOR;
      break;
    case "阎罗地府":
      return HIC "水" NOR;
      break;
    case "方寸山三星洞":
      return HIG "木" NOR;
      break;
    case "月宫":
      return HIY "金" NOR;
      break;
    case "大雪山":
      return HIG "木" NOR;
      break;
    case "五庄观":
      return HIR "火" NOR;
      break;
    case "东海龙宫":
      return HIC "水" NOR;
      break;
    case "将军府":
      return HIY "金" NOR;
      break;
    case "火云洞":
      return HIR "火" NOR;
      break;
    case "陷空山无底洞":
      return YEL "土" NOR;
      break;
    case "蜀山派":
      return HIY "金" NOR;
      break;
    case "百花谷":
      return HIG "木" NOR;
      break;
    case "散仙派":
      return HIC "水" NOR;
      break;
    default:
      return HIB "无" NOR;
  }
}
