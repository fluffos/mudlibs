string skill_all_desc() {
  string str = "";
  int j;
  /*
	for(j=0;j < sizeof(force_level_desc);j++) 
        {
                str += force_level_desc[j] + "  ";
                str += spells_level_desc[j] + "  ";
                str += waigong_level_desc[j] + "  ";
                str += dodge_level_desc[j] + "  ";
                str += knowledge_level_desc[j] + "\n";
        }
*/
  for (j = 0; j < sizeof(skill_level_desc); j++) {
    str += skill_level_desc[j] + "  ";
    if ((j + 1) % 5 == 0) str += "\n";
  }
  return str;
}

string skill_get_level(string skill, int level) {
  int grade;

  if (is_forceskill(skill)) {
    grade = level / 100;
    if (grade >= sizeof(force_level_desc))
      grade = sizeof(force_level_desc) - 1;
    return force_level_desc[grade];
  } else if (is_dodgeskill(skill)) {
    grade = level / 100;
    if (grade >= sizeof(dodge_level_desc))
      grade = sizeof(dodge_level_desc) - 1;
    return dodge_level_desc[grade];
  } else if (is_spellskill(skill)) {
    grade = level / 100;
    if (grade >= sizeof(spells_level_desc))
      grade = sizeof(spells_level_desc) - 1;
    return spells_level_desc[grade];
  } else if (is_knowledge(skill)) {
    grade = level / 100;
    if (grade >= sizeof(knowledge_level_desc))
      grade = sizeof(knowledge_level_desc) - 1;
    return knowledge_level_desc[grade];
  } else {
    grade = level / 100;
    if (grade >= sizeof(skill_level_desc))
      grade = sizeof(skill_level_desc) - 1;
    return skill_level_desc[grade];
  }
}

string skill_level(string type, int level) {
  int grade;

  if (type == "normal") {
    grade = level / 20;
    if (grade >= sizeof(skill_level_desc))
      grade = sizeof(skill_level_desc) - 1;
    return skill_level_desc[grade];
  } else if (type == "force") {
    grade = level / 25;
    if (grade >= sizeof(force_level_desc))
      grade = sizeof(force_level_desc) - 1;
    return force_level_desc[grade];
  } else if (type == "dodge") {
    grade = level / 25;
    if (grade >= sizeof(dodge_level_desc))
      grade = sizeof(dodge_level_desc) - 1;
    return dodge_level_desc[grade];
  } else if (type == "waigong") {
    grade = level / 25;
    if (grade >= sizeof(waigong_level_desc))
      grade = sizeof(waigong_level_desc) - 1;
    return waigong_level_desc[grade];
  } else if (type == "spells") {
    grade = level / 25;
    if (grade >= sizeof(spells_level_desc))
      grade = sizeof(spells_level_desc) - 1;
    return spells_level_desc[grade];
  } else if (type == "damage") {
    grade = level / 40;
    if (grade >= sizeof(damage_level_desc))
      grade = sizeof(damage_level_desc) - 1;
    return damage_level_desc[grade];
  } else if (type == "armor") {
    grade = level / 75;
    if (grade >= sizeof(armor_level_desc))
      grade = sizeof(armor_level_desc) - 1;
    return armor_level_desc[grade];
  } else if (type == "knowledge") {
    grade = level / 25;
    if (grade >= sizeof(knowledge_level_desc))
      grade = sizeof(knowledge_level_desc) - 1;
    return knowledge_level_desc[grade];
  } else if (type == "combat_power") {
    grade = level / 200;
    if (grade >= sizeof(combat_power_desc))
      grade = sizeof(combat_power_desc) - 1;
    return combat_power_desc[grade];
  } else if (type == "combat_damage") {
    grade = level / 25;
    if (grade >= sizeof(combat_damage_desc))
      grade = sizeof(combat_damage_desc) - 1;
    return combat_damage_desc[grade];
  } else {
    grade = level / 100;
    if (grade >= sizeof(skill_level_desc))
      grade = sizeof(skill_level_desc) - 1;
    return skill_level_desc[grade];
  }
}

nosave int sort_keys(int one, int two) {
  return one - two;
}

// 门派职位的title设定 by waiwai
// last updated by Jingxue 4.1.2004
int re_title(object master, object who) {
  string family_name;
  int level, *levels, i, rand;

  if (!who || !master)
    return 0;
  family_name = who->query("family/family_name");

  if (!stringp(family_name)
    || undefinedp(titles[family_name]))
    return 0;
  /*
	{
		who->set_temp("ask_zhiwei_time",time());
		master->command("say 职位还未开放！\n"); 
		return 1; 
	}
*/
  if (time() - who->query_temp("ask_zhiwei_time") < 60 && !wizardp(who)) {
    master->command("say 你不是刚问过职位嘛！\n");
    return 1;
  }
  if (master->query("family/family_name") != who->query("family/family_name")) {
    master->command("?");
    master->command("say 你并不是本门弟子啊！\n");
    return 1;
  }
  if (who->query("zhangmen") || who->query("lord")) {
    master->command("spank " + who->query("id"));
    master->command("say 你现在的职位已经很高了。\n");
    return 1;
  }
  who->set_temp("ask_zhiwei_time", time());
  level = (int)who->query("level");
  levels = keys(titles[family_name]);
  levels = sort_array(levels, "sort_keys", this_object());
  for (i = 0; i < sizeof(levels); i++)
    if (level < levels[i])
      break;
  i--;
  //		rand=random(sizeof(titles[family_name][levels[i]])); 
  rand = random(3);
  master->command("say 很好，我就赋予你「" + titles[family_name][levels[i]][rand]
    + "」的称号吧。\n");
  who->set("title", family_name + titles[family_name][levels[i]][rand]);
  return 1;
}


string _query_rank(object ob);

string query_rank(object ob) {
  string rank = _query_rank(ob);
  string s1, s2, s3;
  int len, len1, len2;

  if (sscanf(rank, "%s(%s)%s", s1, s2, s3) != 3) return rank;
  rank = replace_string(rank, "(", "【");
  rank = replace_string(rank, ")", "】");
  len = 14 - sizeof(s2);
  if (len < 1) return rank;

  len1 = len / 2;
  len2 = len - len1;
  if (len1) s2 = repeat_string(" ", len1) + s2;
  if (len2) s2 += repeat_string(" ", len2);

  return s1 + "【" + s2 + "】" + s3;
}

string _query_rank(object ob) {
  string at;
  int dx, exp, avg;
  int budd;
  int age;
  if (strlen(ob->query("added_title")) < 1) ob->set("added_title", "无名");
  //need this default, otherwise looks too ugly sometimes.

  at = ob->query("added_title");
  dx = (int)ob->query("daoxing");
  exp = (int)ob->query("combat_exp");
  avg = (dx + exp) / 2;
  age = ob->query("age");

  if (ob->is_ghost()) return HIB "( 鬼  魂 )" NOR;
  switch (ob->query("gender")) {
    case "女性":
      switch (wizhood(ob)) {
        case "(admin)": return GRNBLU "(九天玄女)" NOR;
        case "(arch)": return GRNBLU "(九天神女)" NOR;
        case "(wizard)": return GRNBLU "(巫    女)" NOR;
        case "(apprentice)": return GRNBLU "(见习巫女)" NOR;
        //                        case "(immortal)":      return GRNBLU "(客座巫女)" NOR;
        case "(immortal)": return GRNBLU "(荣誉天使)" NOR;
        case "(elder)": return GRNBLU "(荣誉玩家)" NOR;
        default:
          switch (ob->query("family/family_name")) {
            //------------------rank for girls--------------------
            case "南海普陀山":
              if (dx < 100000)
                return HIY "( 小尼姑 )" NOR;
              else if (dx < 500000)
                return HIY "( 小师太 )" NOR;
              else if (dx < 1000000)
                return HIY "( 圣  尼 )" NOR;
              else if (dx < 5000000)
                return HIY "(" + at + "神尼)" NOR;
              else
                return HIY "(" + at + "菩萨)" NOR;
              break;
            case "阎罗地府":
              if (dx < 100000)
                return HIB "(阴曹小鬼)" NOR;
              else if (dx < 500000)
                return HIB "(迷魂女鬼)" NOR;
              else if (dx < 1000000)
                return HIB "(幽冥女使)" NOR;
              else if (dx < 5000000)
                return HIB "(" + at + "修罗)" NOR;
              else
                return HIB "(" + at + "女王)" NOR;
              break;
            case "方寸山三星洞":
