#include <ansi.h>
inherit "/obj/newdrug.lpc";

void create()
{
set_name("奖励丹",({"reward dan"}));
set_weight(50);
if (clonep())
        set_default_object(__FILE__);
else    {
        set("base_unit", "颗");
        set("unit","些");
        set("drug_type", "补品");
        set("no_give",1);
        set("no_put",1);
        set("no_sell",1);
        set("no_get",1);        
        }
setup();
set_amount(1);
}

string query_target()
{
string *str = ({
        "lijing","rulai_杀","rulai_擒","rulai_劝",
        "rulai_add_杀","rulai_add_擒",
        "rulai_add_劝",
});
return str[random(sizeof(str))];        
}

string query_type()
{
string *str = ({
        "combat_exp","daoxing","potential",
});
return str[random(sizeof(str))];
}

int query_time()
{
return (3600*(1+random(3)));
}

string query_eat_msg()
{
return HIW"$N"HIW"轻轻掰开一颗$n"HIW"一时间香气四溢。\n"NOR;
}

int query_pot()
{
return 100+random(30);
}

