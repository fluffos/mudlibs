inherit ITEM;

void create() {
  set_name("封魔符", ({ "fengmo fu", "fu", "seal" }));
  set("unit", "张");
  set("channel_id", "魔法门清除行动");
  setup();
}

void init() {
  add_action("do_check", "check");
}

int is_magic(object who) {
  string *skills;
  int i;
  if (!who) return 0;
  if (who->query("family/family_name") == "火系魔法教派")
    return 1;
  skills = ({
    "fireforce", "firemagic", "magic",
    "add_dagger", "firefinger", "mas_dagger",
  });
  for (i = 0; i < sizeof(skills); i++) {
    if (who->query_skill(skills[i], 1) > 0)
      return 1;
  }
  return 0;
}

int do_check() {
  int i;
  object *oo;

  oo = users();
  for (i = 0; i < sizeof(oo); i++) {
    if (is_magic(oo[i])) {
      if (!oo[i]->move("/d/wiz/family_room" + sprintf("%d", 1 + random(3))))
        CHANNEL_D->do_channel(
          this_object(),
          "chat",
          oo[i]->name(1) + "(" + oo[i]->query("id") + ") 移动至门派调整室失败。"
        );
      else CHANNEL_D->do_channel(
        this_object(),
        "chat",
        oo[i]->name(1) + "(" + oo[i]->query("id") + ") 移动至门派调整室成功。"
      );
    }
  }
  destruct(this_object());
  return 1;
}
