inherit ITEM;

void create()
{
        string msg;
        set_name("大钱包",({"gold"}));
        set("unit","哥");
        set("value",0);
        setup();
}

void gift(object me)
{
        remove_call_out("gift");
        if( !me )
                return;
        if( !me->check_pay(10000000) 
          && !me->check_balance(10000000) )
        {
                me->money_add(500000);
                tell_object(me,"你得到了新手启动资金。\n");
        }
        destruct(this_object());
}               

void init()
{
        object me = this_player();
        if( !query("used") )
        {
                if( present(this_object(),me) )
                {
                        set("used",1);
                        remove_call_out("gift");
                        call_out("gift",1,me);
                }
        }
}
