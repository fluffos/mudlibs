#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIW "浑天仪" NOR, ({ "huntian yi", "yi" }));
  set_weight(1000000);
  set("unit", "座");
  set("long", "上查天文下测地理的仪器。\n");
  setup();
}

void init() {
  if (wizardp(this_player())) {
    add_action("do_check", "check");
    add_action("do_change", "change");
  }
}

int do_change(string arg) {
  object w1, w2, who, me = this_player();
  if (!arg) return 0;
  who = find_player(arg);
  if (!who) return 0;
  w1 = who->query_temp("weapon");
  if (w1)
    w1->unequip();
  w2 = who->query_temp("secondary_weapon");
  if (w2)
    w2->unequip();

  who->set_temp("apply/damage", 0);
  if (w1)
    w1->wield();
  if (w2)
    w2->wield();
  who->reset_action();
  write("ok\n");
  return 1;
}

int do_check(string arg) {
  string str, msg;
  object who, *usr;
  int i, p, j;

  if (!arg) return 0;
  usr = users();
  msg = "";
  for (i = 0; i < sizeof(usr); i++) {
    who = usr[i];
    if (!who) continue;
    switch (arg) {
      case "damage":
        p = who->query_temp("apply/damage");
        str = "伤害";
        break;
      case "armor":
        p = who->query_temp("apply/armor");
        str = "防御";
        break;
      case "attack":
        p = who->query_temp("apply/attack");
        str = "攻速";
        break;
      default: return 0;
    }
    if (p > 800)
      msg += sprintf("%20-s%10-s的 %6s 异常 ------------ %10-d\n",
        who->name(1),
        "(" + who->query("id") + ")",
        str,
        p);
  }
  write(msg);
  return 1;
}
