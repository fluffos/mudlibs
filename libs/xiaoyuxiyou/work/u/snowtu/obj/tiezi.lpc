#include <ansi.h>
inherit ITEM;

string name = "【逍遥鼠】(Kidmouse)";
void create()
{
set_name("请帖",({"qing tie","tie"}));
set("unit","张");
set("value",0);
set_weight(100);
set("no_put",1);
set("no_get",1);
setup();
}

void dismiss()
{
write(name()+"被一阵风给吹走了，你顶着狂风，放声大哭。\n\n");
destruct(this_object());
}       

void init()
{
object me = environment();
if ( !me )
        return;
if ( me && !query("owner") )
        set("owner",me->query("id"));
if ( query("owner")!=me->query("id") )
        {
        remove_call_out("dismiss");
        call_out("dismiss",1+random(3));
        return;
        }
if ( !query("get_time") )
        set("get_time",time());
add_action("do_give","give");
}

int do_give(string arg)
{
int pot;        
string n_id;    
object obj,npc,me = this_player();
if ( !arg || !userp(me) )
        return 0;
if ( sscanf(arg,"%s to %s",arg,n_id)!=2
  && sscanf(arg,"%s %s",n_id,arg)!=2 )
        return 0;
npc = present(n_id,environment(me));
if ( !npc || !living(npc) )
        return 0;
obj = present(arg,me);
if ( obj!=this_object() )
        return 0;
message_vision("$N递给$n一封"+obj->name()+"。\n",me,npc);
message_vision(CYN"$n"CYN"惊讶地“啊”了一声。\n"NOR,me,npc);
CHANNEL_D->do_channel(npc,"chat","恭喜"+name+"喜结良缘，世上的光棍又少了一个！");
if ( npc=query("target") )
        {
        pot = 1000000;
        pot = pot/2+random(pot/2);
        message_vision(CYN"$n"CYN"说道：我忙着挂机呢，就麻烦这位"+RANK_D->query_respect(me)+"帮我送下红包吧。\n"NOR,me,npc);
        message_vision("$n递给$N"+MONEY_D->money_str(pot)+"。\n",me,npc);
        MONEY_D->pay_player(me,pot);
        }
destruct(this_object());
return 1;
}

string long()
{
object target,*usr;
string str;
str = "据说"+name+"最近吊了个马子，所以广发英雄帖，邀请天下豪杰
去它家里庆祝，这张就是请帖。\n";
if ( !query("target") )
        {
        usr = users();
        target = usr[random(sizeof(usr))];
          if ( !target || !living(target) || !objectp(target) )  {
               remove_call_out("dismiss");
               call_out("dismiss",1+random(3));
          return "一张过期了的帖子。\n";
               }
        set("target",target);
        }
target = query("target");
str+= sprintf("你最好尽快帮"+name+"把这张帖子送给%s%s的%s(%s)。\n",
                MISC_D->find_place(environment(target)),
                environment(target)->query("short"),
                target->name(1),
                capitalize(target->query("id")),
        );
return str;
}

