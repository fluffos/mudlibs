inherit ITEM;

void create() {
  set_name("装备大礼包", ({ "bag" }));
  set("unit", "个");
  set("value", 0);
  setup();
}
void init() {
  int i;
  string file, *files = ({
    "armor", "cloth", "hand", "kui", "neck", "pifeng", "ring", "shield", "shoes", "waitst", "wrists",
  });
  object npc, ob, me = this_player();
  if (query("used"))
    return;
  for (i = 0; i < sizeof(files); i++) {
    file = files[i];
    if (!file)
      continue;
    gift(me, file);
  }
  ob = new("/d/obj/nweapon/unarmed");
  npc = new("/d/city/npc/libai");
  npc->set_temp("apply/karma", 200 + random(100));
  npc->set_skill("force", 100 + random(50));

  ob->init_weapon(npc);
  if (ob->move(me))
    tell_object(me, "你得到了" + ob->short() + "。\n");
  else
    destruct(ob);
  destruct(npc);
  set("used", 1);
  remove_call_out("dest_ob");
  call_out("dest_ob", 2);
}
