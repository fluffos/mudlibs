#include <ansi.h>
inherit ITEM;

void create()
{
	set_name("仓颉笔",({"shen bi"}));
   set_weight(1000);
   if( clonep() )
   	set_default_object(__FILE__);
	else 
   	set("unit", "支");
	setup();
}

void init()
{
	add_action("do_chat","cc");
}

int do_chat()
{
	int i,k,j;
	mixed *dirs,*tmp,*ff,*kk;
	string dir,file,temp;
	mapping cast = ([]);
	
	dirs = get_dir("/daemon/class/");
	for(i=0;i<sizeof(dirs);i++)
	{
		dir = sprintf("/daemon/class/%s/",dirs[i]);
		tmp = get_dir(dir);
		if( !tmp || !arrayp(tmp) )
			continue;		
		for(k=0;k<sizeof(tmp);k++)
		{
			dir = sprintf("/daemon/class/%s/%s/",dirs[i],tmp[k]);
			if( !dir )
				continue;
			ff = get_dir(dir);
			if( !ff || !arrayp(ff) )
				continue;
			for(j=0;j<sizeof(ff);j++)								
			{
				if( sscanf(ff[j],"%s.lpc",temp)!=1 )
					continue;	
				file = read_file(dir+ff[j]);
				if( !file )
					continue;
				if( strsrch(file,"->move")==-1 )
					continue;
				if( strsrch(file,"int cast")==-1 )
					continue;
				cast[dirs[i]+"_"+tmp[k]] = ff[j];	
			}	
		}
	}
	set("cast",cast);
	write("ok\n");
	return 1;
}