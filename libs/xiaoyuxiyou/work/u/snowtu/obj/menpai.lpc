#include <ansi.h>
inherit ITEM;

void init()
{
add_action("do_clean","clean");
}

int do_clean(string arg)
{
int i,k,j=0;
string *file,str;
object *yaos;
if ( !arg )     arg = "snowtu";
file = ({
        "/d/obj/yao/yao-dragon.lpc",
        "/d/obj/yao/yao-pansi.lpc",
        "/d/obj/yao/yao-putuo.lpc",
        "/d/obj/yao/yao-moon.lpc",
        "/d/obj/yao/yao-fangcun.lpc",
        "/d/obj/yao/yao-hell.lpc",
        "/d/obj/yao/yao-jjf.lpc",
        "/d/obj/yao/yao-kunlun.lpc",
        "/d/obj/yao/yao-wudidong.lpc",
        "/d/obj/yao/yao-wzg.lpc",
        "/d/obj/yao/yao-xueshan.lpc",
        "/d/obj/yao/yao-kunlun.lpc",
});
str = "门派怪列表\n";
for(i=0;i<sizeof(file);i++)
        {
        yaos = children(file[i]);
        if ( !yaos || !arrayp(yaos) )
                continue;
        for(k=0;k<sizeof(yaos);k++)
                {               
                reset_eval_cost();
                if( !yaos[k] )
                        continue;
                j++;
                if( arg=="all" )
                        {                       
                        if ( environment(yaos[k])
                          && yaos[k]->is_fighting() )
                                {
                                message_vision(HIW"$N"HIW"说道：「不打了，不打了，我投降....。」\n\n"NOR,yaos[k]);
                                yaos[k]->remove_all_killer();
                                all_inventory(environment(yaos[k]))->remove_killer(yaos[k]);
                                }
                        message_vision("\n半空中传来一声鹤鸣，有人在云中斥道：$N，还不速速归位！\n",yaos[k]);
                        message_vision("\n$N哈哈一笑，化作一道金光冲天而去！\n\n",yaos[k]);                                 
                        destruct(yaos[k]);                                      
                        }
                else    {
                        str+= sprintf("%20s %20s %s\n",
                                        yaos[k]->name(1),
                                        (environment(yaos[k])?environment(yaos[k])->query("short"):"无空间"),
                                        (yaos[k]->query("owner")?yaos[k]->query("owner"):"无主"),
                                        );
                        }                       
                }
        }
write("操作结果>>>>>>>共"+(arg=="all"?"清理了":"存在")+j+"个门派怪。\n");  
if ( arg!="all" )
        write(str);
return 1;
}

void create()
{
set_name("门派怪清理器",({"qili qi","qi"}));
set("long",@LONG
        clean all       清理所有存在的门派怪
        clean           列出存在的门派怪数目
LONG);  
set_weight(1000);
set("unit","个");
setup();
} 
