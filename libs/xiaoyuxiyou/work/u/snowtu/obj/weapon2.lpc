inherit ITEM;

void create() {
  set_name("装备包", ({ "bag" }));
  set("unit", "个");
  set("value", 0);
  setup();
}

void gift(object me) {
  string file;
  object ob;
  if (!me)
    return;
  if (!me->query("family/family_name"))
    file = "sword";
  else {
    switch (me->query("family/family_name")) {
      case "阎罗地府": file = "stick"; break;
      case "五庄观": file = "hammer"; break;
      case "火云洞": file = "spear"; break;
      case "方寸山三星洞": file = "stick"; break;
      case "将军府": file = "axe"; break;
      case "蜀山": file = "sword"; break;
      case "百花谷": file = "sword"; break;
      case "盘丝洞": file = "sword"; break;
      case "月宫": file = "sword"; break;
      case "东海龙宫": file = "unarmed"; break;
      case "大雪山": file = "sword"; break;
      case "陷空山无底洞": file = "sword"; break;
      case "南海普陀山": file = "staff"; break;
      default: return;
    }
  }
  ob = new("/d/obj/nweapon/" + file);
  if (ob) {
    me->set("env/test", "HIB");
    if (me->query_level() > 40)
      me->set_temp("weapon_level", 40);
    if (ob->init_weapon(me)) {
      ob->move(me);
      tell_object(me, "你得到了一件" + ob->short() + "。\n");
    } else destruct(ob);
    me->delete("env/test");
    me->delete_temp("weapon_level");
  }
}

void dest_ob() {
  destruct(this_object());
}


void init() {
  object me = this_player();

  call_out("gift", 1, me);
  remove_call_out("dest_ob");
  call_out("dest_ob", 5);
}
