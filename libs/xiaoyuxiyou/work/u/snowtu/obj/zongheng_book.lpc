#include <ansi.h>
inherit ITEM;

int step = 0;

mixed *story = 
({
        "$N眼泪汪汪的看着凝眸仙子。。。",
        "凝眸仙子：好徒儿，你有何心事？",
        "$N：弟子愚钝，算命的都说弟子五行缺心眼！",
        "凝眸仙子：哦，好徒儿，五行所属乃是天生，姐也帮你不到啊。",
        "‥‥‥‥‥‥‥‥",
        "$N：弟子不敢奢望，只求美女师傅能给我一次重悟纵横剑法的机会。",
        "凝眸仙子：哦，就这么黄豆大的事啊。",
        "凝眸仙子：本仙子仁厚为本，就给你一次机会。",
        "凝眸仙子：这可不关你说了美女两字。",
        "凝眸仙子：讨厌。",
        "‥‥‥‥‥‥‥‥",
        "听说$N得到了【纵横剑法遗忘心经】！",
});

mixed query_story_message(int step)
{
	return step < sizeof(story) ? story[step] : 0;
}

void go_on_process(object me,object who)
{
	remove_call_out("start_smash");
	if( !me || !who) 
        	return;
	call_out("start_smash",2+random(3),me,who);
}

void start_smash(object me,object who)
{
	mixed line;
	string prompt;

	if( !me || !who )
        	return;
	go_on_process(me,who);        
	line = query_story_message(step);
	if( !line )
	{
		remove_call_out("start_smash");
		me->delete("bhg");
		me->delete_knowing("bhg_zongheng");
		me->add("gin",-3);
		me->save();
		tell_object(me,"你清除了纵横剑法的领悟。\n");
		tell_object(me,"你失去了3点活力。\n");
		destruct(this_object());
		return;
	}
	step++;
	prompt = ""; 
	if( functionp(line) ) 
        	catch(line = evaluate(line));
	if( stringp(line) )
	{
		line = replace_string(line,"$N",me->query("name")+"("+capitalize(me->query("id"))+")");
		message("channel:chat",HIG"【"HIY"百花轶事"HIG"】"+line+NOR"\n",users());
        }
	if(intp(line) && !line)
        	go_on_process(me,who);
}

void create()
{
        set_name("纵横剑法遗忘心经",({"book"}));
    	set("unit","本");
    	set("value",50000);
    	set("no_drop",1);
    	set("no_give",1);
    	set("channel_id","百花轶事");
    	setup();
}
void init()
{
	add_action("do_read","read");
	add_action("do_read","study");
	add_action("do_read","du");
}

int do_read(string arg)
{
	if( !arg || !id(arg) )
		return 0;
	if( query("duing") )
		return err_msg("你正在使用着呢。\n");
	if( this_player()->query("gin")<3 )
		return err_msg("你的活力不够。\n");	
	set("duing",1);
	step = 0;
	start_smash(this_player(),this_object());
	return 1;		
}