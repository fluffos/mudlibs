#include <ansi.h>
inherit ITEM;
#include "/cmds/std/valid_move.h"
string lvl = "";
string skill = "";

string random_skills() {
  int i;
  string f, *dir, *file = ({});
  dir = get_dir("/daemon/skill/*.lpc", -1);
  if (!dir || !arrayp(dir))
    return 0;
  for (i = 0; i < sizeof(dir); i++) {
    file += ({ dir[i][0] });
  }
  if (sizeof(file) < 1)
    return 0;
  f = file[random(sizeof(file))];
  if (!f || !stringp(f))
    return 0;
  f = replace_string(f, ".lpc", "");
  if (!is_chinese(to_chinese(f)))
    return 0;
  return f;
}

void create() {
  int k;
  string name;

  switch (random(10)) {
    case 0: k = random(500); lvl = "初级入门"; break;
    case 1: k = 500 + random(500); lvl = "指导入门"; break;
    case 2: k = 1000 + random(1000); lvl = "进级入门"; break;
    case 3: k = 1500 + random(1500); lvl = "中级入门"; break;
    case 5: k = 2000 + random(2000); lvl = "高级入门"; break;
    case 7: k = 2500 + random(2500); lvl = "进阶入门"; break;
    case 8: k = 3000 + random(3000); lvl = "大成入门"; break;
    case 9: k = 5000 + random(5000); lvl = "终极入门"; break;
    default: k = 10000 + random(10000); lvl = "宗师入门"; break;
  }
  skill = random_skills();
  if (!skill || !stringp(skill))
    skill = "idle-force";
  name = to_chinese(skill);
  name = replace_string(name, " ", "");
  set_name(name + "技能书", ({ "book", skill + " book" }));
  set("long", "一本上古遗下的技能书");
  set("value", 0);
  set("unit", "本");
  set("pot", k);
  set("skills", skill);
  set("no_put", 1);
}

string short() {
  string name = query("name");
  name = replace_string(name, "技能书", "");
  return sprintf("上古技能书(%s)(%s" NOR YEL "%s" NOR ")", capitalize(query("id")), name, lvl);
}

void init() {
  add_action("do_study", "study");
  add_action("do_study", "du");
  add_action("do_study", "read");
}

int do_study(string arg) {
  object me = this_player();
  if (me != environment())
    return 0;
  if (!arg || !id(arg))
    return 0;
  if (!valid_move(me)) {
    write("你现在正忙着呢。\n");
    return 1;
  }
  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学学读书识字(literate)吧。\n");
    return 1;
  }
  if (me->query_skill(skill, 1) <= 0)
    return notify_fail("你好似还没学到这个技能，光读死书没有用！！！\n");
  message_vision(
    "$N撕开$n,开始研读里面关于" HIC + to_chinese(skill) + NOR "的技巧，似乎有点心得。\n",
    me,
    this_object()
  );
  me->improve_skill(skill, query("pot"));
  me->start_busy(1);
  destruct(this_object());
  return 1;
}

string long() {
  string name = query("skills");
  if (!name) return ::long();
  if (!this_player()->query_skill(name, 1))
    return query("long") + "，不过看来你领悟不了其中的奥妙。";
  name = to_chinese(name);
  name = replace_string(name, " ", "");
  return query("long") + "，你可以从中提高你的" + name + "。";
}
