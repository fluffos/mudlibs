#include <ansi.h>
inherit ITEM;

int step = 0;
object ob = 0;

string do_smash();

mixed *story = ({
  "$N将手中戒尺晃了几晃，朝着$n嘿嘿一阵冷笑，",
  "$n横眉冷对千夫指：当今世界WHO怕WHO啊……",
  "没等$n反应过来，$N已经窜到$p面前，扬出手中戒尺……",
  "$N说道：不许动，把所有值钱的东西交出来！",
  "$n想大声呼救，结果发现没有一个人了，都溜的精光，跑的比球还快。",
  "形势危急……",
  "$N说道：快点！m d，大爷没时间跟你磨蹭！",
  "$n横眉冷对千夫指：当今世界WHO怕WHO啊……",
  "只见$N举起戒尺，大喝：“看打!”, 只见一道电光闪过，",
  "戒尺带着咆哮的风声自天而降，向着$n的屁屁奔去……",
  "……",
  "………………",
  "………………………………",
  "$n摸着又红又肿的屁屁，委屈的看着眠兔…………",
  "…………",
  "……………………",
});

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

void go_on_process(object ob) {
  remove_call_out("start_smash");
  if (!ob) return;
  call_out("start_smash", 1);
}

void start_smash() {
  mixed line;
  string prompt;

  if (!ob)
    return;
  go_on_process(ob);
  line = query_story_message(step);
  line = replace_string(line, "$N", this_player()->query("name"));
  line = replace_string(line, "$n", ob->query("name"));
  line = replace_string(line, "$p", "她");
  step++;
  prompt = NOR CYN "";
  if (functionp(line))
    catch(line = evaluate(line));
  if (stringp(line))
    message("channel:chat", NOR YEL "\t" + prompt + YEL + line + YEL "\n" NOR, users());
  if (intp(line) && !line)
    go_on_process(ob);
}

void create() {
  set_name("戒尺", ({ "jie chi", "chi" }));
  set("unit", "把");
  setup();
}

void init() {
  add_action("do_heihei", "hai");
}

int do_heihei(string arg) {
  if (!wizardp(this_player())
    || SECURITY_D->get_status(this_player()) != "(admin)")
    return 0;
  if (!arg)
    return 0;
  ob = find_player(arg);
  if (!ob || !living(ob))
    return 0;
  step = 0;
  start_smash();
  write("ok\n");
  return 1;
}
