#include <ansi.h>
inherit ITEM;

void setup()
{
}

void create()
{
set_name("升级石",({"shengji shi","stone","shi"}));
set("unit","颗");
set("no_put",1);
set("no_get",1);
set("no_give",1);
set("value",0);
set("no_drop",1);
set("long","灵光四溢的石头，上面闪烁着神奇的光芒。\n你可以用它来升级(shengji) 防具(id)\n ");
setup();
}

void _leave()
{
write("\n\n天上伸出一只大手，将"+name()+"一把攥住“还我宝贝！”\n\n");
destruct(this_object());
}       

void init()
{
add_action("do_shengji","shengji");
if ( environment() )
        {
        if ( !query("owner_id") )
                {
                if ( userp(environment()) )
                        set("owner_id",environment()->query("id"));
                else    {
                        _leave();
                        return;
                        }       
                }
        else    {
                if ( !userp(environment()) )
                        {
                        _leave();
                        return;
                        }
                else if ( environment()->query("id")!=query("owner_id") )
                        {
                        _leave();
                        return;
                        }
                }
        }
}                               
 
int do_shengji(string arg)
{
object obj,me = this_player();
if ( !arg )     return 0;
obj = present(arg,me);
if ( !obj )   return 0;
if ( !obj->is_zhaohuan() )
        {
        write(obj->name()+"不是可召唤的防具。\n");
        return 1;
        }
if ( obj->query("equipped") )
        {
        write("你先得将"+obj->name()+"卸除。\n");
        return 1;
        }
if ( !obj->query("armor_prop/armor") )
        {
        write(obj->name()+"不是防具。\n");
        return 1;
        }
if ( me->is_busy() )
        {
        write("你正忙着呢。\n");
        return 1;
        }
message_vision("$N对"+obj->name()+"使用了"+name()+"。\n",me);   
me->start_busy(1+random(3));
obj->level_up();
obj->save();
destruct(this_object());
return 1;
}
