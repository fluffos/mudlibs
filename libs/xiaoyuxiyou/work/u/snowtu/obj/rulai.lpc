#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_clean", "clean");
}

int do_clean(string arg) {
  int i, k = 0;
  object *ob;
  ob = children("/d/npc/rulaiguai/guai.lpc");
  if (!arg) arg = "hi";
  for (i = 0; i < sizeof(ob); i++) {
    reset_eval_cost();
    if (!ob[i]) continue;
    if (ob[i]->is_fighting()) {
      ob[i]->remove_all_killer();
      all_inventory(environment())->remove_killer(ob[i]);
      message_vision(HIW "$N" HIW "说道：「不打了，不打了，我投降....。」\n\n" NOR, ob[i]);
    }
    k++;
    if (arg == "all")
      destruct(ob[i]);
  }
  write("ok，共" + (arg == "all" ? "清理了" : "存在") + k + "个如来怪。\n");
  return 1;
}

void create() {
  set_name("如来怪清理器", ({ "qili qi", "qi" }));
  set("long", @LONG
        clean all       清理所有存在的如来怪
        clean           列出存在的如来怪数目
LONG);
  set_weight(1000);
  set("unit", "个");
  setup();
}
