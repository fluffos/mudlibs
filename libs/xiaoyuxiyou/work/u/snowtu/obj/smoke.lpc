inherit ITEM;
#include <ansi.h>

string *names=({
        HIR"大中华"NOR,"zhong hua",HIM"万宝路"NOR,"wan bao lu",
        HIW"大熊猫"NOR,"da xiong mao",HIG"玉溪"NOR,"yu xi",
        HIC"云烟"NOR,"yun yan",YEL"大前门"NOR,"da qian men",
        HIG"飞马"NOR,"fei ma",HIG"一品梅"NOR,"yi pin mei",
        HIY"七星"NOR,"qi xing",HIB"５５５"NOR,"san wu",
        HIR"双喜"NOR,"shuang xi",HIC"牡丹"NOR,"mu dan",
        HIW"寿百年"NOR,"shou bainian",HIB"大卫杜夫"NOR,"davidoff",
        HIY"金桥"NOR,"jin qiao",WHT"健"NOR,"jian",
        HIB"石狮"NOR,"shi shi",RED"大红鹰"NOR,"da hong ying",
        HIR"南京"NOR,"nan jing",HIY"南京"NOR,"nanjing",
        YEL"金丝猴"NOR,"jin si hou",HIW"石林"NOR,"shi lin",
        HIM"希尔顿"NOR,"xi er dun",BLU"摩尔"NOR,"mo er",
});

void goaway(object ob)
{
write("烟屁股随风化作一堆碎片。\n");
destruct(ob);
return;
}

void dismiss(object ob)
{
object me = environment(ob);
if ( living(me) )
        tell_room(environment(me),ob->name()+"渐渐的燃烧完了，烟头的红光闪了几闪，终于熄灭了。\n");
ob->set_name("烟屁股",({"yan pi gu"}));
ob->delete("num");
ob->save();
if ( me )  me->delete_temp("smoking");
call_out("goaway",1+random(9),ob);
return;
}
        
void create()
{
int max_pot,i;
string name,id;
max_pot = 30+random(30);
i = random(sizeof(names)/2)*2;
name = names[i];
id = names[i+1];
set_name(name,({id,"xiang yan","yan","smoke"}));
set_weight(10);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("unit", random(2)?"支":"根");
        set("long", HIR"这是巫师组发给大家的香烟，吸吸("NOR HIY"xi"NOR HIR")看看。\n"NOR);
        set("material", "paper");
        set("num",max_pot);
        set("no_drop",HIR"新年快乐。\n"NOR);
        set("no_get",HIR"新年快乐。\n"NOR);
        set("no_put",HIR"新年快乐。\n"NOR);
        set("no_give",HIR"新年快乐。\n"NOR);
        }
setup();
}

void init()
{
add_action("do_xi","xi");
}

void smoke(object ob,object me)
{
string msg,*str;
int num = ob->query("num");
int pot = 5000+random(5000);

remove_call_out("smoke");

if ( !me || !present(ob,me) )
        {
        call_out("dismiss",1,ob);
        return;
        }
if ( num<1 )
        {
        call_out("dismiss",1,ob);
        return;
        }
        
str = ({
        "青烟缭绕，$N吞云吐雾了一番。\n",
        "$N深深得吐了一口气，吐了一串的烟圈。\n",
        "$N深深的吸了一口$n,憋得脸红脖子粗，看来是呛着了。\n",
        "$N深深的吸了一口$n,然后从鼻孔里喷出两道粗白的烟柱。\n",
        "$N夹着$n在一边楞楞的发呆。\n",
        "$N夹起$n，空点着沉默不语。\n",
});
msg = str[random(sizeof(str))];
message_vision(msg,me,ob);
ob->add("num",-1);
ob->save();
call_out("smoke",10+random(20),ob,me);
}

int do_xi(string arg)
{
string msg,*m_str,*f_str;
int i;
object *inv,ob = this_object();
object me = environment(ob);
int ageme = me->query("mud_age");
int num = ob->query("num");

if ( !arg || (!id(arg)&&arg!="yan") )
        return 0;
if ( me->query_temp("smoking") )
        return notify_fail(YEL"你正抽着呢。\n"NOR);
if ( num<1 )
        {
        call_out("dismiss",5+random(5),ob);
        return 0;
        }

m_str = ({
        "$N拿出一根$n点着了深深的吸了一口，得意的打了个响指，叼在了嘴上。\n",
        "$N掏出根$n叼在嘴上，低头点着了，深深吸了一口。\n",
        "$N将$n叼在嘴里，朝四周看了看，低头点着了。\n",
});     
f_str = ({
        "$N嘻嘻一笑，伸手拿出根$n，点着了，优雅的在一旁吸了起来。\n",
        "$N抽出一支$n拿中食指夹住了，点上火开始吸了起来。\n",
        "$N嘻嘻一笑，中食指夹起根$n，点上火开始吸了起来。\n",
});
if ( me->query("gender")=="女性" )
        msg = f_str[random(sizeof(f_str))];
else    msg = m_str[random(sizeof(m_str))];
message_vision(msg,me,ob);
me->set_temp("smoking",1);
if ( random(5) )
        {
        inv = all_inventory(environment(me));
        for(i=0;i<sizeof(inv);i++)
                {
                if ( inv[i]==me || !living(inv[i]) )
                        continue;       
                if ( random(5) )
                        {
                        if ( inv[i]->query_temp("smoking") )
                                message_vision("$N见状，不由面露喜色：想不到"+me->query("name")+"也与吾是同道中人啊~~~\n",inv[i]);
                        else    message_vision("$N见状，不由面露怒色：想不到"+me->query("name")+"居然是个大烟鬼~~~\n",inv[i]);                 
                        }
                }
        }
me->add("water",1+random(5));   
me->add("food",1+random(5));    
call_out("smoke",5+random(25),ob,me);
return 1;
}


