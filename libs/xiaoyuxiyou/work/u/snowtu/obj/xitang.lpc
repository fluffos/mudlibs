#include <ansi.h>
inherit ITEM;

void create()
{
set_name("喜糖",({"xitang","tang"}));
set("unit","包");
set("value",0);
set_weight(500);
set("no_put",1);
set("no_get",1);
set("no_sell",HIR"你敢！！\n"NOR);
set("no_drop",HIR"你敢！！\n"NOR);
setup();
}

void dismiss()
{
write(name()+"被一阵风给吹走了，你顶着狂风，放声大哭。\n\n");
destruct(this_object());
}       

void init()
{
object me = environment();
if ( !me )
        return;
if ( me && !query("owner") )
        set("owner",me->query("id"));
if ( query("owner")!=me->query("id") )
        {
        remove_call_out("dismiss");
        call_out("dismiss",1+random(3));
        return;
        }
if ( !query("get_time") )
        set("get_time",time());
add_action("do_give","give");
}

int do_give(string arg)
{
int pot;        
string n_id;    
object obj,npc,me = this_player();
if ( !arg || !userp(me) )
        return 0;
if ( sscanf(arg,"%s to %s",arg,n_id)!=2
  && sscanf(arg,"%s %s",n_id,arg)!=2 )
        return 0;
npc = present(n_id,environment(me));
if ( !npc || !living(npc) )
        return 0;
obj = present(arg,me);
if ( obj!=this_object() )
        return 0;
message_vision("$N递给$n一包"+obj->name()+"。\n",me,npc);
message_vision(CYN"$n"CYN"惊讶地“啊”了一声。\n"NOR,me,npc);
CHANNEL_D->do_channel(npc,"chat","恭喜阿枚(Amy)最近和她的Tony喜结良缘～～～");
message_vision(CYN"$n"CYN"一口讲喜糖吃进肚里，满意的拍拍肚皮，意犹未尽。\n"NOR,me,npc);
npc->add("combat_exp",5000);
npc->add("daoxing",5000);
npc->add("potential",5000);
npc->add("food",3000);
npc->add("water",3000);
npc->save();
CHANNEL_D->do_channel(npc,"rumor","听说"+HIW+npc->name(1)+HIM"吞食了阿枚(Amy)和Tony结婚喜糖，很是有些收获。"NOR);
if ( npc=query("target") && !me->query("礼物标志/amy结婚") )
        {
        set("channel_id","喜结良缘");
        me->add("combat_exp",100000);
        me->add("daoxing",200000);
        me->add("potential",50000);
        me->set("礼物标志/amy结婚",1);
        me->save();
        CHANNEL_D->do_channel(this_object(),"chat",me->name(1)+"为阿枚(Amy)和她的Tony赠送喜糖，功德无量，特奖励10万武学，200年道行以及5万潜能。");
        write(HIY"你得到了10万武学,5万潜能以及200年道行。\n"NOR);
        }
destruct(this_object());
return 1;
}

string long()
{
object target,*usr;
string str;
str = "据说阿枚(Amy)最近和所爱Tony新结良缘，所以广发喜糖。\n";
if ( !query("target") )
        {
        usr = users();
        target = usr[random(sizeof(usr))];
          if ( !target || !living(target) || !objectp(target) )  {
               remove_call_out("dismiss");
               call_out("dismiss",1+random(3));
          return "一块过期的喜糖。\n";
               }
        set("target",target);
        }
target = query("target");
str+= sprintf("你最好尽快帮阿枚(Amy)把喜糖送给(give)%s%s的%s(%s)。\n",
                MISC_D->find_place(environment(target)),
                environment(target)->query("short"),
                target->name(1),
                capitalize(target->query("id")),
        );
return str;
}

