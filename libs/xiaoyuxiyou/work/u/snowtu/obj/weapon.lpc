inherit ITEM;

void create() {
  set_name("装备包", ({ "bag" }));
  set("unit", "个");
  set("value", 0);
  setup();
}

void gift(object me, string file) {
  object ob;
  if (!me)
    return;
  //ob = new("/d/obj/narmor/"+file);
  ob = new("/d/obj/nweapon/" + file);
  if (ob) {
    me->add_temp("apply/karma", 10000);
    //if( ob->init_armor(me) )
    if (ob->init_weapon(me)) {
      ob->move(me);
      tell_object(me, "你得到了一件" + ob->short() + "。\n");
    } else destruct(ob);
    me->add_temp("apply/karma", -10000);
  }
}

void dest_ob() {
  destruct(this_object());
}


void init() {
  int i;
  string file, *files = ({
    //"armor","cloth","hand","kui","neck","pifeng","ring","shield","shoes","waist","wrists",
    "axe", "blade", "fork", "hammer", "mace", "spear", "staff", "stick", "whip", "sword", "unarmed",
  });
  object me = this_player();

  for (i = 0; i < sizeof(files); i++) {
    file = files[i];
    call_out("gift", 1, me, file);
  }
  remove_call_out("dest_ob");
  call_out("dest_ob", 5);
}
