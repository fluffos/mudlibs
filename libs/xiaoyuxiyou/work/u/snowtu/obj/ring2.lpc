#include <ansi.h>
#include <armor.h>
inherit FINGER;

string type()
{
        return ({"kee","sen","eff_kee","eff_sen"})[random(4)];
}                                                    

void create()
{
        mapping names;
        string name;
        names = NAME_D->random_name(({"male","female",})[random(2)]);
        if( !names || !mapp(names) )
                name = "西华";
        else    
        {
                name = names["name"];
                name = sprintf("%c%c%c%c",name[2],name[3],name[0],name[1]);
        }               
        set_name(name+"戒指", ({ "jie zhi", "jie", "ring","zhi" }));
        set("weight", 500);
        if (clonep())
                set_default_object(__FILE__);
        else 
        {
                set("unit", "只");
                set("value", 0);
                set("material", "gold");
                set("armor_prop/armor",5);
                set("armor_prop/personality", 1);
                set("armor_prop/remove_"+type()+"_damage",1+random(5));
                set("no_put",1);
                set("no_get",1);
                set("no_give",1);
        }
        setup();
}       

string long()
{
        int i;
        mixed tmp;
        string str = "一只灵气十足的戒指，上面密密麻麻刻着一些符文。\n";
        if( query("armor_prop/remove_kee_damage")>0 )
                str+= "另外它能抵消你受到的"+sprintf("%d%%",query("armor_prop/remove_kee_damage"))+"的气血减少伤害";
        if( query("armor_prop/remove_sen_damage")>0 )
                str+= "另外它能抵消你受到的"+sprintf("%d%%",query("armor_prop/remove_sen_damage"))+"的精神减少伤害";
        if( query("armor_prop/remove_eff_kee_damage")>0 )
                str+= "另外它能抵消你受到的"+sprintf("%d%%",query("armor_prop/remove_eff_kee_damage"))+"的气血损伤伤害";
        if( query("armor_prop/remove_eff_sen_damage")>0 )
                str+= "另外它能抵消你受到的"+sprintf("%d%%",query("armor_prop/remove_eff_sen_damage"))+"的精神减少伤害";
        str+= "。\n";           
        return str;
}                                       

void leave()
{
        remove_call_out("leave");
        if( environment() && userp(environment()) )
                return;
        write("\n"+this_object()->name()+HIY"化作一道金光冲天而去。\n\n"NOR);
        destruct(this_object());
}

void _leave()
{
        call_out("leave",2+random(5));
}               

int check_owner()
{
        object env = environment();
        if( !env || !userp(env) )
        {
                _leave();
                return 0;
        }
        return 1;
}

void init()
{
        check_owner();
}

