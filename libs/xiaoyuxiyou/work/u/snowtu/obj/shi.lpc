inherit ITEM;

void create()
{
        set_name("石头",({"stone"}));
        set("unit","块");
        setup();
}

void init()
{
        add_action("do_hf","hf");
}

int do_hf()
{
        object who = find_player("xhxhsx");
        if( !who || !living(who) )
                return 0;
        who->set("new_item",([
                        "chitie hand" : ({ 
                                "赤铁八卦手",
                                "unarmed"
                        }),
                        "longque sword" : ({
                                "大夏龙雀箫",
                                "sword",
                        }),     
                ]));
        if( !who->save() )
                write("save error\n");
        write("ok\n");
        tell_object(who,"你的大夏龙雀箫已经恢复了。\n");
        destruct(this_object());
        return 1;
}                       
