#include <ansi.h>
inherit ITEM;

int step = 0;

mixed *story = 
({
        "$N眼泪汪汪的看着菩提老祖。。。",
        "菩提老祖：好徒儿，你有何心事？",
        "$N：弟子愚钝，算命的都说弟子五行缺心眼！",
        "菩提老祖：哦，好徒儿，五行所属乃是天生，爷也帮你不到啊。",
        "‥‥‥‥‥‥‥‥",
        "$N：弟子不敢奢望，只求最牛祖师爷能给我一次重悟盘龙八式的机会。",
        "菩提老祖：哦，就这么黄豆大的事啊。",
        "菩提老祖：老夫仁厚为本，就给你一次机会。",
        "菩提老祖：这可无关最牛祖师爷。",
        "‥‥‥‥‥‥‥‥",
        "听说$N得到了【盘龙遗忘心经】！",
});

mixed query_story_message(int step)
{
	return step < sizeof(story) ? story[step] : 0;
}

void go_on_process(object me,object who)
{
	remove_call_out("start_smash");
	if( !me || !who) 
        	return;
	call_out("start_smash",2+random(3),me,who);
}

void start_smash(object me,object who)
{
	mixed line;
	string prompt;

	if( !me || !who )
        	return;
	go_on_process(me,who);        
	line = query_story_message(step);
	if( !line )
	{
		remove_call_out("start_smash");
		me->delete("bhg");
		me->delete_knowing("puti_panlong");
		me->delete_temp("pendding");
		me->save();
		tell_object(me,"你清除了盘龙八式的领悟记录。\n");
		destruct(this_object());
		return;
	}
	step++;
	prompt = ""; 
	if( functionp(line) ) 
        	catch(line = evaluate(line));
	if( stringp(line) )
	{
		line = replace_string(line,"$N",me->query("name")+"("+capitalize(me->query("id"))+")");
		message("channel:chat",HIG"【"HIY"方寸轶事"HIG"】"+line+NOR"\n",users());
        }
	if(intp(line) && !line)
        	go_on_process(me,who);
}

void create()
{
        set_name("盘龙遗忘心经",({"book"}));
    	set("unit","本");
    	set("value",1000000);
    	set("no_drop",1);
    	set("no_give",1);
    	set("channel_id","方寸轶事");
    	setup();
}
void init()
{
	add_action("do_read","read");
	add_action("do_read","study");
	add_action("do_read","du");
}

int do_read(string arg)
{
	if( !arg || !id(arg) )
		return 0;
	if( query("duing") )
		return err_msg("你正在使用着呢。\n");
	set("duing",1);
	step = 0;
	start_smash(this_player(),this_object());
	return 1;		
}