#include <ansi.h>
inherit ITEM;

int step = 0;
string do_smash();

mixed *story = ({
  "$N将手中戒尺晃了几晃，朝着$n嘿嘿一阵冷笑，",
  "$n横眉冷对千夫指：当今世界WHO怕WHO啊……",
  "没等$n反应过来，$N已经窜到$p面前，扬出手中戒尺……",
  "$N说道：不许动，把所有值钱的东西交出来！",
  "$n想大声呼救，结果发现没有一个人了，都溜的精光，跑的比球还快。",
  "形势危急……",
  "$N说道：快点！m d，大爷没时间跟你磨蹭！",
  "$n横眉冷对千夫指：当今世界WHO怕WHO啊……",
  "只见$N举起戒尺，大喝：“看打!”, 只见一道电光闪过，",
  "戒尺带着咆哮的风声自天而降，向着$n的屁屁奔去……",
  "……",
  "………………",
  "………………………………",
  "$n摸着又红又肿的屁屁，委屈的看着$N…………",
  "…………",
  "……………………",
});

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

void go_on_process(object me, object who) {
  remove_call_out("start_smash");
  if (!me || !who)
    return;
  call_out("start_smash", random(3), me, who);
}

void start_smash(object me, object who) {
  mixed line;
  string prompt;

  if (!me || !who)
    return;
  go_on_process(me, who);
  line = query_story_message(step);
  step++;
  prompt = NOR CYN "";
  if (functionp(line))
    catch(line = evaluate(line));
  if (stringp(line))
    message_vision("\t" + prompt + line + NOR "\n", me, who);
  if (intp(line) && !line)
    go_on_process(me, who);
}

void create() {
  set_name("戒尺", ({ "jie chi", "chi" }));
  set("long", "一把又长又宽的戒尺，可以用它来拍打(pai)别人的屁屁 :)\n");
  set("unit", "把");
  setup();
}

int query_autoload() {
  return 1;
}

void init() {
  add_action("do_heihei", "pai");
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

int do_heihei(string arg) {
  object ob;
  if (!arg)
    return 0;
  if (time() < query("last_hit") + 300)
    return err_msg("你刚刚用过" + name() + "还是歇歇吧。\n");
  ob = find_player(arg);
  if (!ob || !living(ob))
    return 0;
  step = 0;
  set("last_hit", time());
  start_smash(this_player(), ob);
  write("ok\n");
  return 1;
}
