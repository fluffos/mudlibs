#include <ansi.h>
inherit ITEM;

void create()
{
	set_name( "仙丹" , ({"xian dan", "dan"}));
  	set_weight(90);
  	if (clonep())
    		set_default_object(__FILE__);
  	else 
  	{
    		set("unit", "颗");
    		set("long", "一颗金黄色的丹丸，略微能闻到些许香气。\n");
    		set("value", 1);
    		set("no_sell", 1);
    		set("drug_type", "补品");
  	}
	setup();
}

void init()
{
	add_action("do_eat", "eat");
}

void dest_ob()
{
	destruct(this_object());
}

int do_eat(string arg)
{
	int k;
	object me = this_player();
  	if( !arg || !id(arg) )
  		return 0;
  	if( !query("owner_id") || query("owner_id")!=me->query("id") )
  		return err_msg("这不是你的。\n");
  	if( me->query("giftmark/2013中秋") )
  	{
  		remove_call_out("dest_ob");
  		delete("owner_id");
  		call_out("dest_ob",3);
  		return err_msg("你已经吃过了。\n");
  	}
  	if( time()>me->query("mark/2013中秋")+3600 )
  	{
  		remove_call_out("dest_ob");
  		delete("owner_id");
  		call_out("dest_ob",3);
  		return err_msg("这是颗废丹，药性早过了。\n");
  	}
  	if( me->query_level()<40 )
  		k = 4;
  	else if( me->query_level()<80 )	
  		k = 3;
  	else if( me->query_level()<110 )
  		k = 2;
  	else	k = 1;
  	if( k>1 )
  		k = random(k)+1;
	message_vision(HIG "$N轻轻掰开一颗$n"HIG"送入嘴中，一时间香气四溢。\n\n"NOR,me,this_object());
	me->set("giftmark/2013中秋",1);
  	while(k>0)
  	{
  		k = k-1;
  		me->level_up();
  		tell_object(me,HIY"【系统】节日快乐，你升级了！"NOR"\n");
  	}
  	me->save(1);
	destruct(this_object());
  	return 1;
}

