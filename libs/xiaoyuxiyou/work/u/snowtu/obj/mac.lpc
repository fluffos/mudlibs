#include <ansi.h>
inherit ITEM;

void create() {
  set_name("骰子", ({ "shai zi", "shai" }));
  set("unit", "粒");
  setup();
}

void init() {
  add_action("do_ran", "ren");
}

int do_ran(string arg) {
  string name, title, prop;
  int i, j, k, x, max, v, p;
  mapping tz, mm;
  string *mods, n1, *temp, tmp, *tt, *t2, *t3;
  mm = ([]);
  tz = ([]);
  if (file_size("/doc/mod") <= 0)
    return 0;
  arg = read_file("/doc/mod");
  if (!arg || !stringp(arg))
    return 0;
  mods = explode(arg, "~");
  if (!mods || !arrayp(mods))
    return 0;
  for (i = 0; i < sizeof(mods); i++) {
    tmp = mods[i];
    temp = explode(tmp, "^");
    if (!temp || !arrayp(temp))
      continue;
    n1 = temp[0];
    n1 = replace_string(n1, "\n", "");
    n1 = replace_string(n1, " ", "");
    if (sscanf(n1, "%s#%s#%d", title, name, max) != 3)
      continue;
    printf("title=%s\nname=%s\nmax=%d\n", title, name, max);
    set_temp("mod/" + title + "/name", name);
    set_temp("mod/" + title + "/max", max);
    tmp = temp[1];
    tmp = replace_string(tmp, "\n", "");
    tmp = replace_string(tmp, " ", "");
    tt = explode(tmp, "@");
    for (k = 0; k < sizeof(tt); k++) {
      tmp = tt[k];
      tmp = replace_string(tmp, "\n", "");
      tmp = replace_string(tmp, " ", "");
      t2 = explode(tmp, "&");
      if (!t2 || !arrayp(t2))
        continue;
      sscanf(t2[0], "%d", v);
      tmp = t2[1];
      tmp = replace_string(tmp, "\n", "");
      tmp = replace_string(tmp, " ", "");
      t3 = explode(tmp, "$");
      for (x = 0; x < sizeof(t3); x++) {
        tmp = t3[x];
        tmp = replace_string(tmp, "\n", "");
        tmp = replace_string(tmp, " ", "");
        if (sscanf(tmp, "%s#%d", prop, p) != 2)
          continue;
        //tz["tz"][v][prop] = p;	
        set_temp("mod/" + title + "/tz/" + v + "/" + prop, p);
      }
    }
  }
  return 1;
}
