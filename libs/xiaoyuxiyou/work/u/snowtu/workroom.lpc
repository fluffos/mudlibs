#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "CPU");
  set("outdoors", "changan");
  set("chat_room", 1);
  set("no_time", 1);
  set("mai_corpse_able", 1);
  set("freeze", 1);
  set("if_bed", 1);
  set("exits/up", "/d/huanggong/dadian");
  set("objects", ([
    /*
                "/d/kaifeng/npc/xianggong" : 1,
                "/d/kaifeng/npc/xiangpo" : 1,
                "/d/kaifeng/npc/xianglan" : 1,
                "/d/kaifeng/npc/hujingde" : 1,
                "/d/kaifeng/npc/zhubajie" : 1,
                "/d/kaifeng/npc/chenguangrui" : 1,
                "/d/kaifeng/npc/yinwenjiao" : 1,
*/
  ]));
  set("sleep_room", 1);
  set("no_upgrade_age", 1);
  set("valid_startroom", 1);
  set("hs_world", 1);
  set("no_clean_up", 1);
  setup();
}

void init() {
  add_action("do_code", "check");
}

int do_code(string arg) {
  int i, k;
  mapping ar;
  object weapon, *obj, *usr = users();

  reset_eval_cost();
  for (i = 0; i < sizeof(usr); i++) {
    weapon = 0;
    if (!usr[i] || !objectp(usr[i]))
      continue;
    if (usr[i]->query_temp("apply/attack") < 90
      && usr[i]->query_temp("apply/combat_succ") < 90
      && usr[i]->query_temp("apply/spells_succ") < 90)
      continue;
    printf("%s 状态强制异常常。\n", usr[i]->query("id"));
  }
  return 1;
}
