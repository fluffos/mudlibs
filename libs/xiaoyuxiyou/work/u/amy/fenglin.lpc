// 纵横四海 Zongheng.c
// Cracked by 凌惊雪 5.4.2003

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        int extra;
        object weapon;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［纵横四海］只能对战斗中的对手使用。\n");
        extra = me->query_skill("zongheng-sword",1);
        if ( extra < 100) return notify_fail("你的[纵横剑法]还不够纯熟！\n");
        extra = me->query_skill("brightjade-force",1);
        if ( extra < 100) return notify_fail("你的[明玉神功]还不够纯熟，无法发挥纵横剑法的威力！\n");
        if( time()-(int)me->query_temp("zongheng") < 6 )
                return notify_fail("绝招用多就不灵了！\n");                

        weapon = me->query_temp("weapon");
//////////根骨增加额外威力
	extra = (int)me->query_skill("zongheng-sword",1)/10+(int)me->query_skill("brightjade-force",1)/10+(int)me->query("con")*2;
         me->add_temp("apply/attack",extra*2);
        me->add_temp("apply/damage",extra);

        message_vision(HIC"\n                       风云天下\n"NOR, me, target);
	me->set_temp("ZHJ", 1);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        message_vision(HIY"                       日月同辉\n"NOR, me, target);
	me->set_temp("ZHJ", 2);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        message_vision(HIR"                       横扫六合\n"NOR, me, target);
	me->set_temp("ZHJ", 3);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        message_vision(HIC"                       纵横四海\n"NOR, me, target);
	me->set_temp("ZHJ", 4);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);


         me->add_temp("apply/attack",-extra*2);
        me->add_temp("apply/damage",-extra);
        me->set_temp("zongheng",time());
        return 1;
}
