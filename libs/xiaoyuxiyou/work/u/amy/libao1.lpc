#include <ansi.h>
#include <command.h>

inherit ITEM;

int do_open(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "不要随便捡别人的礼品哦！\n");
    set("no_give", "这是送给个人的礼品包哦，怎么能随便给人呢？\n");
    set("no_drop", "礼品包扔了多可惜呀！\n");
    set("no_sell", "这是礼品，卖不掉的。\n");
  }
  add_action("do_open", "open");
}
void create() {
  set_name(HIC "新年" HIY "大" HIR "礼包" NOR, ({ "dali bao", "libao" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIG "一个精美的大礼包，小雨西游纪念2005年圣诞及2006年元旦专发。可以打开（open）\n" NOR);
    set("value", 0);
    set("no_beg", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_steal", 1);
  }
  set("is_monitored", 1);
  setup();
}

int do_open(string arg) {
  object me, ob;
  me = this_player();
  if (arg != "dali bao" && arg != "libao")
    return notify_fail("你想打开什么？\n");
  if (me->query("giftmark/2006-1-1-open"))
    return notify_fail("你已经开过礼包了吧？别太贪心哦！\n");
  if (me->query("id") != this_object()->query("onwerid"))
    return notify_fail("这是你自己的礼包吗？别太贪心哦！\n");

  log_file(
    "nosave/jinchai",
    "[" + ctime(time()) + "] " + sprintf(
      "%s(%s)打开了%O\n",
      this_player()->query("name"),
      this_player()->query("id"),
      this_object()
    )
  ); me->set("giftmark/2006-1-1-open", 1);
  if (me->query("gender") == "女性")
    message_vision(HIG "$N小心翼翼地拆开精美礼包。\n\n" NOR, me);
  else
    message_vision(HIG "$N迫不及待地拆开精美礼包。\n\n" NOR, me);
  me->add("combat_exp", 150000 + random(50000));
  me->add("daoxing", 150000 + random(50000));
  me->add("potential", 100000 + random(20000));
  return 1;
}

void owner_is_killed() {
  object me = this_player();
  write(HIM "只见一阵烟雾闪过...尸体上什么东西消失了。\n" NOR);
  destruct(this_object());
  return;
}
