#include <ansi.h>
inherit F_DBASE;

string *list1=({
	"南海普陀山",	"观音菩萨",
	"月宫",			"西王母",
	"五庄观",		"镇元大仙",
	"蜀山派",		"剑圣",
    "方寸山三星洞",	"云阳真人",
    "将军府",		"秦琼",
	});
string *list2=({
    "阎罗地府",		"地藏菩萨",
    "盘丝洞",		"紫霞仙子",
    "东海龙宫",		"东海龙王",
	"火云洞",		"红孩儿",
    "大雪山",		"大鹏明王",
	"陷空山无底洞",	"玉鼠精",
	});

void create()
{
    seteuid(getuid());
    set("name","");
    remove_call_out("choose_miemen");
    call_out("choose_miemen",5410);
}

void choose_miemen()
{
	int i,j,k,m1,m2;
	object room;
	i=random(sizeof(list1)/2);
	j=random(sizeof(list2)/2);

    if(!( room = find_object("/d/miemen/job/entrance")) )
        room = load_object("/d/miemen/job/entrance");

	k = 200+random(200);  //怪物总数
	m1 = 10 + random(950); //老怪地点
	m2 = 10 + random(950); //老怪地点

	room->set("miemen/miemen",1);
	room->set("miemen/family11",list1[2*i]);
	room->set("miemen/family12",list1[2*i+1]);
	room->set("miemen/family21",list2[2*j]);
	room->set("miemen/family22",list2[2*j+1]);
	room->set("miemen/killer",k);
	room->set("miemen/master1",m1);
	room->set("miemen/master2",m2);

    message("xyj",HIG+"\n〖"+HIG+"门派火拼"+HIG+"〗"+HIG+room->query("miemen/family22")+"：最近"HIY+room->query("miemen/family11")+HIG"很嚣张，有必要给他们点颜色看看！\n"NOR,users());
    message("xyj",HIG+"〖"+HIG+"门派火拼"+HIG+"〗"+HIG+room->query("miemen/family12")+"：这几天"HIY+room->query("miemen/family21")+HIG"的手下频繁在本门附近出没，弟子们防范着点！\n"NOR,users());

	remove_call_out("choose_miemen");
    call_out("choose_miemen",10800);
    remove_call_out("start_miemen");
    call_out("start_miemen",300);
    remove_call_out("finish");
    call_out("finish",2100);
}
void start_miemen()
{
	object room;
    if(!( room = find_object("/d/miemen/job/entrance")) )
        room = load_object("/d/miemen/job/entrance");
    message("xyj",HIG+"\n〖"+HIG+"门派火拼"+HIG+"〗"+HIG+room->query("miemen/family22")+"：弟子们，今天我们"HIY+room->query("miemen/family21")+HIG"就要进攻"HIR+room->query("miemen/family11")+HIG"，各弟子现在出发！不得有误！\n"NOR,users());
    message("xyj",HIG+"〖"+HIG+"门派火拼"+HIG+"〗"+HIG+room->query("miemen/family12")+"：好！好！，今天我们"HIY+room->query("miemen/family11")+HIG"就和你们"HIR+room->query("miemen/family21")+HIG"火拼一场！！\n"NOR,users());
    message("xyj",HIG+"〖"+HIG+"小道消息"+HIG+"〗"+HIM"某人：听说"HIY+room->query("miemen/family11")+HIM"和"HIY+room->query("miemen/family21")+HIM"要开始火拼了！\n"NOR,users());

	room->set("miemen/miemen","start");
}
void finish()
{
	int i ,s;
	int killed1, killed2;
	object *alluser,room ,obj;
	alluser=users();
    s=sizeof(alluser);
    if(!( room = find_object("/d/miemen/job/entrance")) )
        room = load_object("/d/miemen/job/entrance");
    killed1 = room->query("miemen/killed1");
    killed2 = room->query("miemen/killed2");

	if( killed1 - killed2 > 100 )
    	message("xyj",HIG+"\n〖"+HIG+"门派火拼"+HIG+"〗 "HIY+room->query("miemen/family21")+HIG"和"HIR+room->query("miemen/family11")+HIG"经过一场血战，"HIR+room->query("miemen/family11")+HIG"大获全胜！\n"NOR,users());
	else
		if( killed2 - killed1 > 100 )
    		message("xyj",HIG+"\n〖"+HIG+"门派火拼"+HIG+"〗 "HIY+room->query("miemen/family21")+HIG"和"HIR+room->query("miemen/family11")+HIG"经过一场血战，"HIY+room->query("miemen/family21")+HIG"大获全胜！\n"NOR,users());
		else
			if( killed1 + killed2 < 100 )
	    		message("xyj",HIG+"\n〖"+HIG+"门派火拼"+HIG+"〗 "HIY+room->query("miemen/family21")+HIG"和"HIR+room->query("miemen/family11")+HIG"经过一场较量，双方势均力敌,各有损失！\n"NOR,users());
    		else
    			message("xyj",HIG+"\n〖"+HIG+"门派火拼"+HIG+"〗 "HIY+room->query("miemen/family21")+HIG"和"HIR+room->query("miemen/family11")+HIG"经过一场血战，双方损失惨重！\n"NOR,users());

	room->set("killer",1);
	room->set("miemen/miemen","end");
    room->set("miemen/family11",1);
    room->set("miemen/family12",1);
    room->set("miemen/family21",1);
    room->set("miemen/family22",1);
    room->set("miemen/killed1",0);
    room->set("miemen/killed2",0);
    room->set("miemen/master1",1000);
    room->set("miemen/master2",1000);
    for (i=0;i<s;i++)
    {
        obj=alluser[i];
        if (obj->query("miemen/start") == 1)
        {
        	obj->move("/d/miemen/job/entrance");
        	message_vision("$N被传送出门派战场。\n",obj);
        	obj->set("miemen/start",0);
        	obj->set("miemen/finish",1);
    	}
    }
}

