#include <ansi.h>
inherit ROOM;
#include <room.h>
void create() {
  set("short", "门派战场入口");
  set("long", "

前面就是周围杀气腾腾、烟雾弥漫的战场。这儿有一个很大
的" + HIR "兵器架" NOR + "上摆放着各种各样的兵器，你可以用
（拿取 or take）来拿取这儿的兵器。这里唯一的通道是
（enter），可以进入到门派的内部。
"
  );
  set("exits", ([ /* sizeof() == 4 */
    "out": "/d/luoyang/haijiao",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "兵器架": "
	一个很大的兵器架上摆放着各种各样的兵器，你可以
用（拿取 or take）来拿取这儿的兵器。（比如take sword）：
──────────────────────────────
盔甲：
          甲(armor)        靴(shoes)     盾(shield)
          盔(kui)          衣(cloth)     披风(pifeng)
兵器：
          棒(stick)        剑(sword)     筋(whip)
          刀(blade)        爪(zhua)      杖(staff)
          斧(axe)          铲(fork)      锤(hammer)
          枪(spear)        琴(qin)       锏(mace)
──────────────────────────────

" ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("miemen/miemen", 1);
  set("miemen/family11", 1);
  set("miemen/family12", 1);
  set("miemen/family21", 1);
  set("miemen/family22", 1);
  set("miemen/killed1", 0);
  set("miemen/killed2", 0);
  set("miemen/master1", 1000);
  set("miemen/master2", 1000);
  setup();
}

void init() {
  add_action("block_cmd", "", 1);
  add_action("do_enter", "enter");
  add_action("do_take", "take");
  add_action("do_take", "拿取");
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();

  if (verb == "bian") return 1;
  if (verb == "xiudao") return 1;
  if (verb == "exert") return 1;
  if (verb == "cast") return 1;
  if (verb == "ji") return 1;
  if (verb == "burn") return 1;
  return 0;
}

int do_enter() {
  object where = this_object();
  object me = this_player();
  if (where->query("miemen/miemen") == "end")
    return notify_fail(HIW "门派战斗已经结束。\n" NOR);

  if (where->query("miemen/miemen") == 1)
    return notify_fail(HIW "门派战斗还没准备好，请稍做等待。\n" NOR);

  me->set("miemen/start", 1);
  message(
    "xyj",
    HIG + "\n〖" + HIG + "门派火拼" + HIG + "〗" + HIY "" + me->query("name") + HIG "开始参加" + where->query("miemen/family11") + "和" + where->query("miemen/family21") + "的门派战斗！！！\n" NOR,
    users()
  );
  me->move("/d/miemen/zhanchang" + random(998));
  return 1;
}

int do_take(string arg) {
  string type;
  object ob;
  object who = this_player();
  object me = this_object();
  if (!arg)
    return notify_fail("你想拿起什么？兵器？还是盔甲？(比如:take sword)\n");
  else {
    sscanf(arg, "%s", type);
    switch (type) {
      //盔甲
      case "armor": ob = new("/d/obj/normal/armor.lpc"); break;
      case "pifeng": ob = new("/d/obj/normal/pifeng.lpc"); break;
      case "shield": ob = new("/d/obj/normal/shield.lpc"); break;
      case "shoes": ob = new("/d/obj/normal/shoes.lpc"); break;
      case "cloth": ob = new("/d/obj/normal/cloth.lpc"); break;
      case "kui": ob = new("/d/obj/normal/kui.lpc"); break;
      //兵器
      case "sword": ob = new("/d/obj/normal/sword.lpc"); break;
      case "whip": ob = new("/d/obj/normal/whip.lpc"); break;
      case "blade": ob = new("/d/obj/normal/blade.lpc"); break;
      case "stick": ob = new("/d/obj/normal/stick.lpc"); break;
      case "spear": ob = new("/d/obj/normal/spear.lpc"); break;
      case "fork": ob = new("/d/obj/normal/fork.lpc"); break;
      case "hammer": ob = new("/d/obj/normal/hammer.lpc"); break;
      case "qin": ob = new("/d/obj/normal/qin.lpc"); break;
      case "axe": ob = new("/d/obj/normal/axe.lpc"); break;
      case "staff": ob = new("/d/obj/normal/staff.lpc"); break;
      case "zhua": ob = new("/d/obj/normal/zhua.lpc"); break;
      case "bonnet": ob = new("/d/obj/normal/bonnet.lpc"); break;
      case "mace": ob = new("/d/obj/normal/mace.lpc"); break;
    }
    ob->set("no_sell", 1);
    ob->set("lianmeng", 1);
    ob->move(who);
    tell_object(who, "你从兵器架上拿取了" + ob->query("name") + "。\n");
  }
  return 1;
}
