
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
	set_name("观音菩萨", ({ "guanyin pusa", "guanyin", "pusa" }));
	set("title", "救苦救难大慈大悲");
	set("long", @LONG
理圆四德，智满金身。眉如小月，眼似双星。兰心欣紫竹，
蕙性爱得藤。她就是落伽山上慈悲主，潮音洞里活观音。
LONG);
	set("gender", "女性");
	set("age",30);
       	set("str",30);
	set("per",30);
	set("attitude", "peaceful");

	set("miemengain", 5000);
	set("menpai", "南海普陀山");
    set("family/family_name","南海普陀山");

	set("max_kee", 15000);
	set("max_sen", 5000);
	set("force_factor", 225);
	set("mana_factor", 150);
	set("max_mana", 3500);
	set("mana", 7000);
	set("force", 5000);
	set("max_force", 2500);
	set("combat_exp", 4000000);
	set("daoxing", 6000000);

	set_skill("literate", 380+random(40));
	set_skill("spells", 500+random(40));
	set_skill("buddhism", 500+random(40));
	set_skill("unarmed", 380+random(40));
	set_skill("jienan-zhi", 380+random(40));
	set_skill("dodge", 380+random(40));
	set_skill("lotusmove", 380+random(40));
	set_skill("parry", 380+random(40));
	set_skill("force", 380+random(40));
	set_skill("lotusforce", 380+random(40));
	set_skill("staff", 380+random(40));
	set_skill("blade", 380+random(40));
	set_skill("cibeidao", 380+random(40));
	set_skill("lunhui-zhang", 380+random(40));
	map_skill("spells", "buddhism");
	map_skill("blade", "cibeidao");
	map_skill("unarmed", "jienan-zhi");
	map_skill("dodge", "lotusmove");
	map_skill("force", "lotusforce");
	map_skill("parry", "lunhui-zhang");
	map_skill("staff", "lunhui-zhang");

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: cast_spell, "bighammer" :),
	    (: exert_function, "recover" :),
	}) );

	setup();
	carry_object("/d/obj/weapon/staff/budd_staff")->wield();
	carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob)
{
	object me = this_object();
	command("heng");
	command("heihei "+ob->query("id"));
	me->kill_ob(ob);
	return 1;
}

void die()
{
    object me=this_object();
    object who;

    if( me->query_temp("last_damage_from"))
    	who=me->query_temp("last_damage_from");

    if( (string)who->query("family/family_name") != (string)me->query("family/family_name") )
    {
        message_vision(HIY"$N的经验提高了。\n"NOR,who);
		who->add("miemen/miemengain", (int)me->query("miemengain"));
    	who->add("miemen/num",1);
	}
    message_vision(HIY"$N死了。\n"NOR,me);
	destruct(this_object());
}


void unconcious()
{
	die();
}

void destroy(object ob)
{
    destruct(ob);
    return;
}
