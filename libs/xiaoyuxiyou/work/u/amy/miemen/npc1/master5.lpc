
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
       set_name(HIW"菩提祖师"NOR, ({"master puti","puti", "master"}));
       set("long", "大觉金仙没垢姿，西方妙相祖菩提\n");
       set("title", HIC"斜月三星"NOR);
       set("gender", "男性");
       set("age", 100);
       	set("str",30);
	set("per",30);
	set("attitude", "peaceful");

	set("miemengain", 5000);
	set("menpai", "方寸山三星洞");
        set("family/family_name","方寸山三星洞");

	set("max_kee", 18000);
	set("max_sen", 5000);
	set("force_factor", 225);
	set("mana_factor", 150);
	set("max_mana", 2500);
	set("mana", 5000);
	set("force", 5000);
	set("max_force", 2500);
	set("combat_exp", 4000000);
	set("daoxing", 6000000);

	set_skill("literate", 380+random(40));
	set_skill("spells", 380+random(40));
	set_skill("dao", 380+random(40));
	set_skill("unarmed", 380+random(40));
	set_skill("puti-zhi", 380+random(40));
	set_skill("dodge", 380+random(40));
	set_skill("jindouyun", 380+random(40));
	set_skill("parry", 380+random(40));
	set_skill("force", 380+random(40));
	set_skill("wuxiangforce", 380+random(40));
	set_skill("stick", 550+random(40));
	set_skill("sword", 380+random(40));	
	set_skill("liangyi-sword", 380+random(40));	
	set_skill("qianjun-bang", 550+random(40));
	map_skill("spells", "dao");
	map_skill("sword", "liangyi-sword");	
	map_skill("unarmed", "puti-zhi");
	map_skill("dodge", "jindouyun");
	map_skill("force", "wuxiangforce");
	map_skill("parry", "qianjun-bang");
	map_skill("stick", "qianjun-bang");

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
	        (: exert_function, "recover" :),
	        (: exert_function, "shenjia" :),
	}) );

	setup();
	carry_object("/d/obj/weapon/stick/xiangmo")->wield();
	carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob)
{
	object me = this_object();
	command("heng");
	command("heihei "+ob->query("id"));
	me->kill_ob(ob);
	return 1;
}

void die()
{
        object me=this_object();
        object who;

        if( me->query_temp("last_damage_from"))
        	who=me->query_temp("last_damage_from"); 

        if( (string)who->query("family/family_name") != (string)me->query("family/family_name") ) 
        {
            	message_vision(HIY"$N的经验提高了。\n"NOR,who);
		who->add("miemen/miemengain", (int)me->query("miemengain"));
        	who->add("miemen/num",1);
	}
        message_vision(HIY"$N死了。\n"NOR,me);
	destruct(this_object());
}


void unconcious()
{
	die();
}

void destroy(object ob)
{
        destruct(ob);
        return;
}