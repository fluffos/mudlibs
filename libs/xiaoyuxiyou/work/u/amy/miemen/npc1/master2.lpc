inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name("西王母", ({ "xi wangmu", "xi", "wangmu", "master" }));
  set("long", "西华至妙生伊川，穆王八骑访昆仑。\n");
  set("title", "月宫祖师");
  set("gender", "女性");
  set("age", 100);
  set("str", 30);
  set("per", 30);
  set("attitude", "peaceful");

  set("miemengain", 5000);
  set("menpai", "月宫");
  set("family/family_name", "月宫");

  set("max_kee", 15000);
  set("max_sen", 4500);
  set("force_factor", 225);
  set("mana_factor", 150);
  set("max_mana", 2000);
  set("mana", 4000);
  set("force", 5000);
  set("max_force", 2500);
  set("combat_exp", 4000000);
  set("daoxing", 6000000);

  set_skill("literate", 380 + random(40));
  set_skill("spells", 380 + random(40));
  set_skill("moonshentong", 380 + random(40));
  set_skill("unarmed", 380 + random(40));
  set_skill("baihua-zhang", 380 + random(40));
  set_skill("dodge", 550 + random(40));
  set_skill("moondance", 550 + random(40));
  set_skill("parry", 380 + random(40));
  set_skill("force", 380 + random(40));
  set_skill("moonforce", 380 + random(40));
  set_skill("sword", 380 + random(40));
  set_skill("whip", 380 + random(40));
  set_skill("snowsword", 380 + random(40));
  set_skill("jueqingbian", 380 + random(40));
  map_skill("spells", "moonshentong");
  map_skill("whip", "jueqingbian");
  map_skill("unarmed", "baihua-zhang");
  map_skill("dodge", "moondance");
  map_skill("force", "moonforce");
  map_skill("parry", "snowsword");
  map_skill("sword", "snowsword");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "arrow" :),
    (: exert_function, "recover" :),
    (: perform_action, "dodge", "wu" :),
  }));

  setup();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
  carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob) {
  object me = this_object();
  command("heng");
  command("heihei " + ob->query("id"));
  me->kill_ob(ob);
  return 1;
}

void die() {
  object me = this_object();
  object who;

  if (me->query_temp("last_damage_from"))
    who = me->query_temp("last_damage_from");

  if ((string)who->query("family/family_name") != (string)me->query("family/family_name")) {
    message_vision(HIY "$N的经验提高了。\n" NOR, who);
    who->add("miemen/miemengain", (int)me->query("miemengain"));
    who->add("miemen/num", 1);
  }
  message_vision(HIY "$N死了。\n" NOR, me);
  destruct(this_object());
}


void unconcious() {
  die();
}

void destroy(object ob) {
  destruct(ob);
  return;
}
