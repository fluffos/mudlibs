
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
  set_name(HIW"白发老人"NOR, ({ "lao ren", "lao", "laoren","ren", "baifa", "immortal", "master", "shifu" }));
  set("long","
这是一位鹤发童颜的老人。他看起来似乎很老的样子，
但偏又是红光满面。看到你打量他，他对你和蔼地笑了
一笑。

");
  set("title", HIY"神仙"NOR);
  set("gender", "男性");
  set("age", 100);
       	set("str",30);
	set("per",30);
	set("attitude", "peaceful");

	set("miemengain", 5000);
	set("menpai", "将军府");
        set("family/family_name","将军府");

	set("max_kee", 25000);
	set("max_sen", 5000);
	set("force_factor", 225);
	set("mana_factor", 150);
	set("max_mana", 2000);
	set("mana", 4000);
	set("force", 5000);
	set("max_force", 2500);
	set("combat_exp", 4000000);
	set("daoxing", 6000000);

	set_skill("literate", 380+random(40));
	set_skill("spells", 380+random(40));
	set_skill("baguazhou", 380+random(40));
	set_skill("unarmed", 380+random(40));
	set_skill("changquan", 380+random(40));
	set_skill("dodge", 380+random(40));
	set_skill("yanxing-steps", 380+random(40));
	set_skill("parry", 380+random(40));
	set_skill("force", 380+random(40));
	set_skill("lengquan-force", 380+random(40));
	set_skill("spear", 550+random(40));
	set_skill("axe", 380+random(40));	
	set_skill("sanban-axe", 380+random(40));	
	set_skill("bawang-qiang", 550+random(40));
	map_skill("spells", "baguazhou");
	map_skill("axe", "sanban-axe");	
	map_skill("unarmed", "changquan");
	map_skill("dodge", "yanxing-steps");
	map_skill("force", "lengquan-force");
	map_skill("parry", "bawang-qiang");
	map_skill("spear", "bawang-qiang");

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
        	(: exert_function, "jingxin" :),
	        (: exert_function, "recover" :),
	}) );

	setup();
	carry_object("/d/obj/weapon/spear/changqiang")->wield();
	carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob)
{
	object me = this_object();
	command("heng");
	command("heihei "+ob->query("id"));
	me->kill_ob(ob);
	return 1;
}

void die()
{
        object me=this_object();
        object who;

        if( me->query_temp("last_damage_from"))
        	who=me->query_temp("last_damage_from"); 

        if( (string)who->query("family/family_name") != (string)me->query("family/family_name") ) 
        {
            	message_vision(HIY"$N的经验提高了。\n"NOR,who);
		who->add("miemen/miemengain", (int)me->query("miemengain"));
        	who->add("miemen/num",1);
	}
        message_vision(HIY"$N死了。\n"NOR,me);
	destruct(this_object());
}


void unconcious()
{
	die();
}

void destroy(object ob)
{
        destruct(ob);
        return;
}