inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name("剑圣", ({ "jian sheng", "sheng", "swordsman" }));
  set("title", "");
  set("long",
    "蜀山派祖师爷，满头白发的老人，两眼炯炯有神。\n");

  set("gender", "男性");
  set("age", 65);
  set("str", 30);
  set("per", 30);
  set("attitude", "peaceful");

  set("miemengain", 5000);
  set("menpai", "蜀山派");
  set("family/family_name", "蜀山派");

  set("max_kee", 18000);
  set("max_sen", 5000);
  set("force_factor", 225);
  set("mana_factor", 150);
  set("max_mana", 1500);
  set("mana", 3000);
  set("force", 5000);
  set("max_force", 2500);
  set("combat_exp", 6000000);
  set("daoxing", 4000000);

  set_skill("literate", 380 + random(40));
  set_skill("spells", 380 + random(40));
  set_skill("taoism", 380 + random(40));
  set_skill("unarmed", 380 + random(40));
  set_skill("hunyuan-zhang", 380 + random(40));
  set_skill("dodge", 550 + random(40));
  set_skill("sevensteps", 380 + random(40));
  set_skill("parry", 380 + random(40));
  set_skill("force", 380 + random(40));
  set_skill("zixia-shengong", 380 + random(40));
  set_skill("sword", 550 + random(40));
  set_skill("whip", 380 + random(40));
  set_skill("mindsword", 380 + random(40));
  set_skill("yujianshu", 380 + random(40));
  set_skill("canxin-jian", 550 + random(40));
  map_skill("spells", "taoism");
  map_skill("unarmed", "hunyuan-zhang");
  map_skill("dodge", "sevensteps");
  map_skill("force", "zixia-shengong");
  map_skill("parry", "canxin-jian");
  map_skill("sword", "canxin-jian");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "fu" :),
    (: exert_function, "recover" :),
    (: exert_function, "zhanqi" :),
    (: exert_function, "huti" :),
  }));

  setup();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
  carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob) {
  object me = this_object();
  command("heng");
  command("heihei " + ob->query("id"));
  me->kill_ob(ob);
  return 1;
}

void die() {
  object me = this_object();
  object who;

  if (me->query_temp("last_damage_from"))
    who = me->query_temp("last_damage_from");

  if ((string)who->query("family/family_name") != (string)me->query("family/family_name")) {
    message_vision(HIY "$N的经验提高了。\n" NOR, who);
    who->add("miemen/miemengain", (int)me->query("miemengain"));
    who->add("miemen/num", 1);
  }
  message_vision(HIY "$N死了。\n" NOR, me);
  destruct(this_object());
}


void unconcious() {
  die();
}

void destroy(object ob) {
  destruct(ob);
  return;
}
