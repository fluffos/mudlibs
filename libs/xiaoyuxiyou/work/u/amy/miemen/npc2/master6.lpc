inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name("玉鼠精", ({ "yu shu", "yushu", "shu", "monster" }));
  set("gender", "女性");
  set("age", 23);
  set("long",
    "她就是这无底洞的洞主了。她从修道成人行以来，吃人无数，\n"
    "也不知为什么玉皇还未曾派兵来围剿。听说她在天宫有亲，也\n"
    "不知真假。\n");
  set("title", "地涌夫人");
  set("age", 30);
  set("str", 30);
  set("per", 30);
  set("attitude", "peaceful");

  set("miemengrin", 5000);
  set("menpai", "陷空山无底洞");
  set("family/family_name", "陷空山无底洞");

  set("max_kee", 20000);
  set("max_sen", 5000);
  set("force_factor", 225);
  set("mana_factor", 150);
  set("max_mana", 2000);
  set("mana", 4000);
  set("force", 5000);
  set("max_force", 2500);
  set("combat_exp", 6000000);
  set("daoxing", 4000000);

  set_skill("literate", 380 + random(40));
  set_skill("spells", 380 + random(40));
  set_skill("yaofa", 380 + random(40));
  set_skill("unarmed", 380 + random(40));
  set_skill("yinfeng-zhua", 380 + random(40));
  set_skill("dodge", 380 + random(40));
  set_skill("lingfu-steps", 380 + random(40));
  set_skill("parry", 380 + random(40));
  set_skill("force", 380 + random(40));
  set_skill("huntian-qigong", 380 + random(40));
  set_skill("sword", 380 + random(40));
  set_skill("blade", 550 + random(40));
  set_skill("kugu-blade", 550 + random(40));
  set_skill("qixiu-jian", 380 + random(40));
  map_skill("spells", "yaofa");
  map_skill("blade", "kugu-blade");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("dodge", "lingfu-steps");
  map_skill("force", "huntian-qigong");
  map_skill("parry", "kugu-blade");
  map_skill("sword", "qixiu-jian");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "dodge", "bianfu" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/d/obj/weapon/blade/yanblade")->wield();
  carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob) {
  object me = this_object();
  command("heng");
  command("heihei " + ob->query("id"));
  me->kill_ob(ob);
  return 1;
}

void die() {
  object me = this_object();
  object who;

  if (me->query_temp("last_damage_from"))
    who = me->query_temp("last_damage_from");

  if ((string)who->query("family/family_name") != (string)me->query("family/family_name")) {
    message_vision(HIY "$N的经验提高了。\n" NOR, who);
    who->add("miemen/miemengain", (int)me->query("miemengain"));
    who->add("miemen/num", 1);
  }
  message_vision(HIY "$N死了。\n" NOR, me);
  destruct(this_object());
}


void unconcious() {
  die();
}

void destroy(object ob) {
  destruct(ob);
  return;
}
