inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name("大鹏明王", ({ "dapeng mingwang", "dapeng", "mingwang", "wang" }));
  set("title", "雪山之祖");
  set("gender", "男性");
  set("age", 45);
  set("per", 30);
  set("str", 30);
  set(
    "long",
    "这位大鹏明王的确大有来历，说起来跟佛祖如来也有点亲戚关系，\n算是如来的“舅舅”。他不似其兄孔雀明王作恶多端，却也并非善类，\n且因其兄之故跟佛门结下深仇。生平最讨厌的就是和尚。\n"
  );
  set("attitude", "peaceful");

  set("miemengrin", 5000);
  set("menpai", "大雪山");
  set("family/family_name", "大雪山");

  set("max_kee", 18000);
  set("max_sen", 5000);
  set("force_factor", 225);
  set("mana_factor", 150);
  set("max_mana", 2000);
  set("mana", 4000);
  set("force", 5000);
  set("max_force", 2500);
  set("combat_exp", 4000000);
  set("daoxing", 6000000);

  set_skill("literate", 380 + random(40));
  set_skill("spells", 380 + random(40));
  set_skill("dengxian-dafa", 380 + random(40));
  set_skill("unarmed", 380 + random(40));
  set_skill("cuixin-zhang", 380 + random(40));
  set_skill("dodge", 580 + random(40));
  set_skill("xiaoyaoyou", 600 + random(40));
  set_skill("parry", 580 + random(40));
  set_skill("force", 380 + random(40));
  set_skill("ningxie-force", 380 + random(40));
  set_skill("sword", 380 + random(40));
  set_skill("blade", 380 + random(40));
  set_skill("bingpo-blade", 380 + random(40));
  set_skill("bainiao-jian", 500 + random(40));
  map_skill("spells", "dengxian-dafa");
  map_skill("blade", "bingpo-blade");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("force", "ningxie-force");
  map_skill("parry", "bainiao-jian");
  map_skill("sword", "bainiao-jian");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "juanbi" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/d/obj/weapon/sword/fenghuangqin")->wield();
  carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob) {
  object me = this_object();
  command("heng");
  command("heihei " + ob->query("id"));
  me->kill_ob(ob);
  return 1;
}

void die() {
  object me = this_object();
  object who;

  if (me->query_temp("last_damage_from"))
    who = me->query_temp("last_damage_from");

  if ((string)who->query("family/family_name") != (string)me->query("family/family_name")) {
    message_vision(HIY "$N的经验提高了。\n" NOR, who);
    who->add("miemen/miemengain", (int)me->query("miemengain"));
    who->add("miemen/num", 1);
  }
  message_vision(HIY "$N死了。\n" NOR, me);
  destruct(this_object());
}


void unconcious() {
  die();
}

void destroy(object ob) {
  destruct(ob);
  return;
}
