
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
  set_name(HIY"黄飞虎"NOR, ({"huang feihu", "huang", "feihu", "huangfeihu"}));
  set ("long", @LONG
开国武成王黄飞虎，兴周第一大将，封神榜
上五岳之首东岳泰山大齐仁圣大帝，下凡寻
找其五色神牛的下落。
LONG);
 
  set("title", HIW"东岳泰山大齐仁圣大帝"NOR);
  set("gender", "男性");
  set("age", 43);
       	set("str",30);
	set("per",30);
	set("attitude", "peaceful");

	set("miemengrin", 5000);
	set("menpai", "火云洞");
        set("family/family_name","火云洞");

	set("max_kee", 20000);
	set("max_sen", 5000);
	set("force_factor", 225);
	set("mana_factor", 150);
	set("max_mana", 1500);
	set("mana", 3000);
	set("force", 5000);
	set("max_force", 2500);
	set("combat_exp", 4000000);
	set("daoxing", 6000000);

	set_skill("literate", 380+random(40));
	set_skill("spells", 380+random(40));
	set_skill("pingtian-dafa", 380+random(40));
	set_skill("unarmed", 380+random(40));
	set_skill("moyun-shou", 380+random(40));
	set_skill("dodge", 380+random(40));
	set_skill("moshenbu", 550+random(40));
	set_skill("parry", 550+random(40));
	set_skill("force", 380+random(40));
	set_skill("huomoforce", 380+random(40));
	set_skill("spear", 380+random(40));
	set_skill("stick", 380+random(40));	
	set_skill("dali-bang", 380+random(40));	
	set_skill("wuyue-spear", 380+random(40));
	set_skill("huoyun-qiang", 550+random(40));
	map_skill("spells", "pingtian-dafa");
	map_skill("stick", "dali-bang");	
	map_skill("unarmed", "moyun-shou");
	map_skill("dodge", "moshenmbu");
	map_skill("force", "huomoforce");
	map_skill("parry", "huoyun-qiang");
	map_skill("spear", "wuyue-spear");

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: cast_spell, "sanmei" :),
	        (: exert_function, "recover" :),
	}) );

	setup();
	carry_object("/d/obj/weapon/spear/changqiang")->wield();
	carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob)
{
	object me = this_object();
	command("heng");
	command("heihei "+ob->query("id"));
	me->kill_ob(ob);
	return 1;
}

void die()
{
        object me=this_object();
        object who;

        if( me->query_temp("last_damage_from"))
        	who=me->query_temp("last_damage_from"); 

        if( (string)who->query("family/family_name") != (string)me->query("family/family_name") ) 
        {
            	message_vision(HIY"$N的经验提高了。\n"NOR,who);
		who->add("miemen/miemengain", (int)me->query("miemengain"));
        	who->add("miemen/num",1);
	}
        message_vision(HIY"$N死了。\n"NOR,me);
	destruct(this_object());
}


void unconcious()
{
	die();
}

void destroy(object ob)
{
        destruct(ob);
        return;
}
