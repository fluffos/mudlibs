
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
       set_name(HIM"紫霞仙子"NOR, ({"zixia xianzi", "zixia", "xianzi","master"}));
       set("long", "她就是盘丝洞的开山祖师,传说她是佛祖的一棵灯芯。随佛祖修道悟
真,后来思凡下界占了花果山一处洞府,开山立派,传授门徒。\n");
       set("title", HIB"盘丝大仙"NOR);
       set("gender", "女性");
       set("age", 20);
       	set("str",30);
	set("per",30);
	set("attitude", "peaceful");

	set("miemengrin", 5000);
	set("menpai", "盘丝洞");
        set("family/family_name","盘丝洞");

	set("max_kee", 15000);
	set("max_sen", 4000);
	set("force_factor", 225);
	set("mana_factor", 150);
	set("max_mana", 2000);
	set("mana", 3500);
	set("force", 5000);
	set("max_force", 2500);
	set("combat_exp", 4000000);
	set("daoxing", 6000000);

	set_skill("literate", 380+random(40));
	set_skill("spells", 380+random(40));
	set_skill("pansi-dafa", 280+random(40));
	set_skill("unarmed", 380+random(40));
	set_skill("lanhua-shou", 280+random(40));
	set_skill("dodge", 380+random(40));
	set_skill("yueying-wubu", 380+random(40));
	set_skill("parry", 380+random(40));
	set_skill("force", 380+random(40));
	set_skill("jiuyin-xinjing", 380+random(40));
	set_skill("sword", 550+random(40));
	set_skill("whip", 380+random(40));	
	set_skill("chixin-jian", 550+random(40));	
	set_skill("yinsuo-jinling", 380+random(40));
	map_skill("spells", "pansi-dafa");
	map_skill("whip", "yinsuo-jinling");	
	map_skill("unarmed", "lanhua-shou");
	map_skill("dodge", "yueying-wubu");
	map_skill("force", "jiuyin-xinjing");
	map_skill("parry", "chixin-jian");
	map_skill("sword", "chixin-jian");

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: cast_spell, "wuzhishan" :),
		(: cast_spell, "ziqi" :),
	        (: exert_function, "recover" :),
	        (: exert_function, "tear" :),
	}) );

	setup();
	carry_object("/d/obj/weapon/sword/qingfeng")->wield();
	carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob)
{
	object me = this_object();
	command("heng");
	command("heihei "+ob->query("id"));
	me->kill_ob(ob);
	return 1;
}

void die()
{
        object me=this_object();
        object who;

        if( me->query_temp("last_damage_from"))
        	who=me->query_temp("last_damage_from"); 

        if( (string)who->query("family/family_name") != (string)me->query("family/family_name") ) 
        {
            	message_vision(HIY"$N的经验提高了。\n"NOR,who);
		who->add("miemen/miemengain", (int)me->query("miemengain"));
        	who->add("miemen/num",1);
	}
        message_vision(HIY"$N死了。\n"NOR,me);
	destruct(this_object());
}


void unconcious()
{
	die();
}

void destroy(object ob)
{
        destruct(ob);
        return;
}
