
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
       	set_name("敖广", ({"ao guang", "ao","guang","longwang","wang"}));

	set("long","敖广是东海的龙王，其兄弟分别掌管东，西，南，北四海。
由余其水族众多，声势浩大，俨然独霸一方。\n");
       set("gender", "男性");
       set("age", 66);
	set("title", "东海龙王");
       	set("str",30);
	set("per",30);
	set("attitude", "peaceful");

	set("miemengrin", 5000);
	set("menpai", "东海龙宫");
        set("family/family_name","东海龙宫");

	set("max_kee", 18000);
	set("max_sen", 5000);
	set("force_factor", 225);
	set("mana_factor", 150);
	set("max_mana", 2000);
	set("mana", 4000);
	set("force", 5000);
	set("max_force", 2500);
	set("combat_exp", 4000000);
	set("daoxing", 6000000);

	set_skill("literate", 380+random(40));
	set_skill("spells", 380+random(40));
	set_skill("seashentong", 380+random(40));
	set_skill("unarmed", 550+random(40));
	set_skill("dragonfight", 550+random(40));
	set_skill("dodge", 550+random(40));
	set_skill("dragonstep", 550+random(40));
	set_skill("parry", 380+random(40));
	set_skill("force", 380+random(40));
	set_skill("dragonforce", 380+random(40));
	set_skill("fork", 380+random(40));
	set_skill("hammer", 380+random(40));	
	set_skill("huntian-hammer", 380+random(40));	
	set_skill("fengbo-cha", 380+random(40));
	map_skill("spells", "seashentong");
	map_skill("hammer", "huntian-hammer");	
	map_skill("unarmed", "dragonfight");
	map_skill("dodge", "dragonstep");
	map_skill("force", "dragonforce");
	map_skill("parry", "fengbo-cha");
	map_skill("fork", "fengbo-cha");

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
//		(: cast_spell, "freez" :),
	        (: exert_function, "recover" :),
	}) );

	setup();
//	carry_object("/d/obj/weapon/fork/gangcha")->wield();
	carry_object("/d/suburb/miemen/obj/zhanyi2")->wear();
}
int accept_fight(object ob)
{
	object me = this_object();
	command("heng");
	command("heihei "+ob->query("id"));
	me->kill_ob(ob);
	return 1;
}

void die()
{
        object me=this_object();
        object who;

        if( me->query_temp("last_damage_from"))
        	who=me->query_temp("last_damage_from"); 

        if( (string)who->query("family/family_name") != (string)me->query("family/family_name") ) 
        {
            	message_vision(HIY"$N的经验提高了。\n"NOR,who);
		who->add("miemen/miemengain", (int)me->query("miemengain"));
        	who->add("miemen/num",1);
	}
        message_vision(HIY"$N死了。\n"NOR,me);
	destruct(this_object());
}


void unconcious()
{
	die();
}

void destroy(object ob)
{
        destruct(ob);
        return;
}
