
inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
        set_name("护法小妖", ({ "hufa xiaoyao", "hufa", "xiaoyao" }));
        set("title", "无底洞护法小妖");   
        set("long", @LONG
陷空山无底洞的护法小妖怪。
LONG);
        set("gender", "男性");
        set("age", 25);
       	set("str",30);
	set("per",30);
	set("attitude", "peaceful");

	set("miemengain", 1000);
	set("menpai", "陷空山无底洞");
        set("family/family_name","陷空山无底洞");

	set("max_kee", 2000);
	set("max_sen", 2000);
	set("force_factor", 100);
	set("mana_factor", 80);
	set("max_mana", 1000);
	set("mana", 2000);
	set("force", 2000);
	set("max_force", 1000);
	set("combat_exp", 3000000);
	set("daoxing", 2000000);

	set_skill("literate", 250+random(40));
	set_skill("spells", 250+random(40));
	set_skill("yaofa", 250+random(40));
	set_skill("unarmed", 250+random(40));
	set_skill("yinfeng-zhua", 250+random(40));
	set_skill("dodge", 250+random(40));
	set_skill("lingfu-steps", 250+random(40));
	set_skill("parry", 250+random(40));
	set_skill("force", 250+random(40));
	set_skill("huntian-qigong", 250+random(40));
	set_skill("sword", 250+random(40));
	set_skill("blade", 250+random(40));	
	set_skill("kugu-blade", 250+random(40));	
	set_skill("qixiu-jian", 250+random(40));
	map_skill("spells", "yaofa");
	map_skill("blade", "kugu-blade");	
	map_skill("unarmed", "yinfeng-zhua");
	map_skill("dodge", "lingfu-steps");
	map_skill("force", "huntian-qigong");
	map_skill("parry", "kugu-blade");
	map_skill("sword", "qixiu-jian");

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: cast_spell, "bite" :),
	}) );

	setup();
	carry_object("/d/obj/weapon/blade/yanblade")->wield();
	carry_object("/d/suburb/miemen/obj/zhanyi1")->wear();
}
int accept_fight(object ob)
{
	object me = this_object();
	command("heng");
	command("heihei "+ob->query("id"));
	me->kill_ob(ob);
	return 1;
}

void die()
{
        object me=this_object();
        object who;

        if( me->query_temp("last_damage_from"))
        	who=me->query_temp("last_damage_from"); 

        if( (string)who->query("family/family_name") != (string)me->query("family/family_name") ) 
        {
            	message_vision(HIY"$N的经验提高了。\n"NOR,who);
		who->add("miemen/miemengain", (int)me->query("miemengain"));
        	who->add("miemen/num",1);
	}
        message_vision(HIY"$N死了。\n"NOR,me);
	destruct(this_object());
}


void unconcious()
{
	die();
}

void destroy(object ob)
{
        destruct(ob);
        return;
}
