inherit NPC;
#include <ansi.h>
void create()
{
        set_name("枚儿", ({"npc amy"}));
        set("name_color","HIM");
        set("gender", "女性" );
        set("age", 20);
        set("title", HIM"梦中的"NOR);
        set("attitude", "friendly");
        set("per", 60);
        set("str", 500);
        set("max_kee", 5000);
        set("max_sen", 5000);
        set("max_mana", 5000);
        set("mana", 5000);
        set("mana_factor", 200);
        set("max_force", 5000);
        set("force", 5000);
        set("force_factor", 200);
        set("combat_exp", 100000000);
        set("daoxing", 100000000);
        set_skill("sword",999);
        set_skill("unarmed",999);
        set_skill("baihua-zhang",999);
        set_skill("snowsword",999);
        set_skill("moondance",999);        
        set_skill("parry",999);
        set_skill("dodge",999);
     	map_skill("parry", "snowsword");
        map_skill("unarmed", "baihua-zhang");
	map_skill("dodge", "moondance");
        map_skill("sword", "snowsword");
        setup();
        carry_object("/d/city/obj/rose")->wear();
}

void init()
{ 
        add_action("do_faint", "touch");
        add_action("do_faint", "kick");
        add_action("do_faint", "nip");
        add_action("do_faint", "heihei");
        add_action("do_faint", "kiss");
        add_action("do_faint", "kiss5");
        add_action("do_faint", "kiss11");
        add_action("do_faint", "hug");
        add_action("do_faint", "slap");
        add_action("do_faint", "18mo"); 
}


 
void unconcious ()
{
  	die ();
}  
void die()
{
        object ob;
        command("inn");
        command("wuwu");
        command("kick");
        message_vision("\n$N背上长出一对透明的羽翼，一开一合间，$N又变得神采奕奕。\n", this_object());
        ob = new("/u/amy/npc/amy");  //人物的路径，自定义。目的是不死....
        ob->move(environment(this_object()));
        destruct(this_object());
} 

int do_faint()
{
        object me, ob;
        me=this_object();
        ob=this_player();
        if(ob->query("id") != "jingxue" && ob->query("id") != "amy")
	{
		message_vision("$N脸一红，说：“哎呀，你怎么能对我做这么丢脸的事呢？”\n" NOR, me);
        	message_vision("说罢，口中念了句咒语，$N眼前一黑，晕了过去。\n",ob);
        	ob->set("immortal",0);
        	ob->delete("immortal");
        	ob->unconcious();
        }
        return 0;
}
