
#include <ansi.h>
#include <command.h>

inherit ITEM; 

    int do_open(string);
void init();

void init()
{
        if (!wizardp(this_player())) 
        {
                set("no_get","不要随便捡别人的礼品哦！\n");
                  set("no_give","这是送给个人的礼品哦，怎么能随便给人呢？\n");
                      set("no_drop","礼品扔了多可惜呀！\n");
                set("no_sell","这是礼品，卖不掉的。\n");
        }
            add_action("do_open", "use");
}
void create()
{
                set_name( HIM "胭脂" NOR , ({"yan zhi", "yanzhi"}));
        set_weight(90);
        if (clonep())
                set_default_object(__FILE__);
        else {
                  set("unit", "盒");
                    set("long", HIG"一盒精致的胭脂，小雨西游纪念2006年妇女节专发。可以使用（use）\n"NOR);
                set("value", 0);
                set("no_beg",1);
                set("no_get",1);
                set("no_give",1);
                set("no_steal",1);
        }
        set("is_monitored",1);
        setup();
}

int do_open(string arg)
{
        object me, ob;
        me = this_player(); 
            if (arg!="yan zhi" && arg!="yanzhi")
                  return notify_fail("你想使用什么？\n");
                if (me->query("giftmark/2006-03-08-open"))
                      return notify_fail("你已经涂过胭脂了吧？别太贪心哦！\n");
        if (me->query("id")!=this_object()->query("onwerid"))
                  return notify_fail("这是你自己的胭脂吗？别太贪心哦！\n");

             log_file("nosave/jinchai","["+ctime(time())+"] "+        sprintf("%s(%s)使用了%O\n",this_player()->query("name"),this_player()->query("id"),this_object()));     me->set("giftmark/2006-03-08-open",1);
        if (me->query("gender")=="女性")
                    {message_vision(HIG "$N小心翼翼地涂好胭脂，感觉自己美极了。\n\n" NOR, me);
                me->add("combat_exp",120000+random(30000));
                me->add("daoxing",120000+random(30000));
                  me->add("potential",100000+random(20000));}
        else
                      message_vision(HIG "$N迫不及待地涂好胭脂，对着镜子臭美死了。\n\n" NOR, me);
             me->add("combat_exp",80000+random(20000));
            me->add("daoxing",80000+random(20000));
                me->add("potential",70000+random(15000));
        return 1;
}

void owner_is_killed()
{
        object me = this_player();
        write(HIM"只见一阵烟雾闪过...尸体上什么东西消失了。\n"NOR);
        destruct(this_object());
        return;
}

