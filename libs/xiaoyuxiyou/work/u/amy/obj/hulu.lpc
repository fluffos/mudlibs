#include <ansi.h>
#include <command.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "糖葫芦掉在地上就不能吃了！\n");
    set("no_give", "这是糖葫芦啊，怎么能随便给人呢？\n");
    set("no_drop", "糖葫芦扔了多可惜呀！\n");
    set("no_sell", "这是特别的糖葫芦，卖不掉了。\n");
  }
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIC "人见人爱" HIY "御赐" HIR "冰糖葫芦" NOR, ({ "bingtang hulu", "hulu" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "串");
    set("long", MAG "这是小雨西游为国庆准备的特别礼品，看上去晶莹剔透，红扑扑的逗人喜爱，你不觉流出了口水，忍不住就想咬（eat）上一口。\n" NOR);
    set("value", 0);
    set("no_beg", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_steal", 1);
    set("drug_type", "补品");
  }
  set("is_monitored", 1);
  setup();
}

int do_eat(string arg) {
  object me, ob;
  me = this_player();
  if (arg != "bingtang hulu" && arg != "hulu")
    return notify_fail("你想吃什么？\n");
  if (me->query("giftmark/2007-10-1-open"))
    return notify_fail("已经吃过糖葫芦了吧？别太贪心哦！\n");
  //          if (me->query("id")!=this_object()->query("onwerid"))
  //                          return notify_fail("不是你的糖葫芦吧？别太贪心哦！\n");

  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());

  log_file("nosave/jinchai", "[" + ctime(time()) + "] " +
    sprintf(
      "%s(%s)吃了%O\n",
      this_player()->query("name"),
      this_player()->query("id"),
      this_object()
    ));
  me->set("giftmark/2007-10-1-open", 1);
  if (me->query("gender") == "女性")
    message_vision(HIR "$N剥开糖纸小口小口地舔着糖葫芦。\n\n" NOR, me);
  else
    message_vision(HIR "$N撕开糖纸狼吞虎咽地对糖葫芦咬了下去。\n\n" NOR, me);
  me->add("combat_exp", 600000 + random(100000));
  me->add("daoxing", 600000 + random(100000));
  me->add("potential", 300000 + random(100000));
  destruct(this_object());
  return 1;
}

void owner_is_killed() {
  object me = this_player();
  write(HIM "只见一阵烟雾闪过...尸体上什么东西消失了。\n" NOR);
  destruct(this_object());
  return;
}
