inherit ROOM;
#include <ansi.h>

nosave string my_id = "azure";
void create() {
  set("short", HIW "临" HIR "风" HIM "快" HIG "意" HIC "楼" NOR);
  set(
    "long2",
    "
    " HIR ".      " BLINK + HIY "*            " NOR + HIR ". " CYN " .      " BLINK + HIW "  * " NOR + HIB "*   " YEL "      .   
" HIB "*           " HIY "*  " HIR " .   " RED "   ." HIG ".*      " HIB " * " HIY "*    " MAG " .     " RED " * " MAG "*    " HIM ".    " BLINK + HIB "." NOR + HIG "*         " HIY "* 
" BLINK + HIB "    *" NOR + HIR "*    " RED ". " MAG "*          " HIG " ." RED "*" BLINK + CYN "*           " NOR + MAG ".  " HIB "   *  " HIC ". " BLINK + HIG "*      " NOR + MAG ".       " HIG "*" HIR "*
             " BLINK + HIY "." NOR + HIM "*                     .  *" HIY "*          " BLINK + HIM ".          " NOR + CYN "   . " BLINK + HIM "* " NOR + CYN ". " HIM "*" CYN "*
" HIC ".      " BLINK + HIR ".  " NOR + HIB "   *     " HIR " .  " HIB " " HIG " ." BLINK + HIC "*        " NOR + HIG "   ." HIM "* " HIB ".               " HIR "*      " HIB ".  
" HIR "*" HIM "*   " HIM "*         " RED " .   *" BLINK + HIY "*" NOR + CYN "*            " RED ".*      " HIC ".      *" HIG "*" MAG "*       ." BLINK + HIR "." NOR + MAG ".     
 " RED "*   " BLINK + HIB "      . " NOR + HIC "*" HIY "*" CYN " .    *" HIR "*.  " HIC "  ." MAG "." RED ".   " CYN "*   " HIB "     *" BLINK + HIG "* " NOR + HIY " .     " HIB "*   . *." HIB "*   *  " CYN ".
" BLINK + HIB "*  " NOR + HIG "         *  " RED " .     " HIY " ." BLINK + HIR "." NOR + RED "*       " HIB "* " HIM "*    " RED " .         " HIR "* " MAG "*      " BLINK + HIC " .   " NOR + HIM " ." HIR "*
" HIB "    *" HIY "*  " BLINK + HIG "  ." NOR + MAG " *           " HIR ".*" HIY "* " HIB "        " HIG "  .     " RED "* " HIB " ." RED " *     " HIG " .       *" HIY "*
   " CYN "*" HIM "*         " RED " ." HIR "*                   " BLINK + CYN "  .        " NOR + HIC "*       " HIG ".            " BLINK + HIY " ." NOR "
" BLINK + HIB ".       " NOR + MAG "*    " HIG "*" HIM ".     " MAG " .  " HIB "  ." BLINK + MAG "*           " NOR + HIY "." HIG "* " HIR ".         " BLINK + MAG "   *     " NOR + HIB " .   
                 
        \n" NOR
  );
  set("exits", ([
    "kz": "/d/city/kezhan",
    "hell": "/d/death/gate",
    "wiz": "/d/wiz/wizroom",
  ]));
  set("objects", ([
    __DIR__ "npc/amy": 1,
  ]));
  set("valid_startroom", 20000);
  set("if_bed", 1);
  set("sleep_room", 1);
  set("no_clean_up", 0);
  setup();
}

void init() {
  object me = this_player();
  if (me->query("id") == "amy"
    && wizardp(me)) {
    tell_object(me, HIY "命令如下:\n
                        mark  <数据标识>
                        jia  <防具类型>
                        bing <武器类型>
                        gold <黄金数量>
                        qn   <潜能数量>\n" NOR);
    add_action("do_jia", "jia");
    add_action("do_bing", "bing");
    add_action("do_gold", "gold");
    add_action("do_ma", "mark");
    add_action("do_qn", "qn");
    add_action("do_wx", "wx");
  }
}

int do_gold(string arg) {
  int v;
  object who, me = this_player();
  if (!who = find_player(my_id))
    return err_msg("主人，小号不在线啊.\n");
  if (!living(who))
    return err_msg("主人，小号好似昏了。\n");
  if (!arg || sscanf(arg, "%d", v) != 1)
    return err_msg("主人，命令格式 gold <黄金的数量>\n");
  if (v <= 0 || v > 200000)
    return err_msg("主人别贪心，一次最多只能给20w。\n");
  v = v * 10000;
  who->money_add(v);
  who->save();
  write("ok，搞掂！\n");
  return 1;
}

int do_ma(string arg) {
  mixed data;
  object who;
  if (!who = find_player(my_id)) return err_msg("主人，小号不在线啊.\n");
  if (!living(who)) return err_msg("主人，小号好似昏了。\n");
  if (!arg) return err_msg("主人，小号好似昏了。\n");
  who->set(arg, 1);
  who->save();
  write("ok，搞掂！" + arg + "设置为1。\n");
  return 1;
}


int do_qn(string arg) {
  int i, v;
  object who, me = this_player();
  if (!who = find_player(my_id))
    return err_msg("主人，小号不在线啊.\n");
  if (!living(who))
    return err_msg("主人，小号好似昏了。\n");
  if (!arg || sscanf(arg, "%d", v) != 1)
    return err_msg("主人，命令格式 qn <qn的数量>\n");
  i = who->query("potential");
  i = 2000000000 - i;
  if (i <= 0)
    return err_msg("主人，不需要，他的潜能都快爆了。。。\n");
  if (v > i)
    return err_msg("主人别贪心，只能给" + i + "，不然她就爆了。\n");

  who->add("potential", v);
  who->save();
  write("ok，搞掂！\n");
  return 1;
}
int do_wx(string arg) {
  int i, v;
  object who, me = this_player();
  if (!who = find_player(my_id))
    return err_msg("主人，小号不在线啊.\n");
  if (!living(who))
    return err_msg("主人，小号好似昏了。\n");
  if (!arg || sscanf(arg, "%d", v) != 1)
    return err_msg("主人，命令格式 wx <wx的数量>\n");
  i = who->query("combat_exp");
  i = 2000000000 - i;
  if (i <= 0)
    return err_msg("主人，不需要，他的武学都快爆了。。。\n");
  if (v > i)
    return err_msg("主人别贪心，只能给" + i + "，不然她就爆了。\n");

  who->add("combat_exp", v);
  who->save();
  write("ok，搞掂！\n");
  return 1;
}


int do_jia(string arg) {
  int i;
  string file, *files;
  object jia, who, me = this_player();
  if (!who = find_player(my_id))
    return err_msg("主人，小号不在线啊.\n");
  if (!living(who))
    return err_msg("主人，小号好似昏了。\n");
  files = ({
    "armor", "cloth", "hand", "kui", "neck", "pifeng", "ring", "shield", "shoes", "waist", "wrists",
  });
  if (!arg || member_array(arg, files) == -1) {
    file = "主人，你只可以要以下这些类型：\n";
    for (i = 0; i < sizeof(files); i++)
      file += files[i] + "\n";
    return err_msg(file);
  }
  jia = new("/d/obj/narmor/" + arg);
  jia->set("no_get", 1);
  //      jia->set("no_give",1);
  jia->set("value", 0);
  i = query("valid_startroom");
  who->add_temp("apply/karma", i);
  jia->init_armor(who);
  who->add_temp("apply/karma", -i);
  if (!jia->move(who)) {
    destruct(jia);
    return err_msg("主人，她的背包满了！~~\n");
  }
  write("ok，搞掂，搞了个" + jia->short() + "\n");
  return 1;
}

int do_bing(string arg) {
  int i;
  string file, *files;
  object jia, who, me = this_player();
  if (!who = find_player(my_id))
    return err_msg("主人，小号不在线啊.\n");
  if (!living(who))
    return err_msg("主人，小号好似昏了。\n");
  files = ({
    "axe", "blade", "fork", "hammer", "mace", "spear", "staff", "stick", "sword", "unarmed", "whip",
  });
  if (!arg || member_array(arg, files) == -1) {
    file = "主人，你只可以要以下这些类型：\n";
    for (i = 0; i < sizeof(files); i++)
      file += files[i] + "\n";
    return err_msg(file);
  }
  jia = new("/d/obj/nweapon/" + arg);
  jia->set("no_get", 1);
  jia->set("no_give", 1);
  jia->set("value", 0);
  i = query("valid_startroom");
  who->add_temp("apply/karma", i);
  jia->init_weapon(who);
  who->add_temp("apply/karma", -i);
  if (!jia->move(who)) {
    destruct(jia);
    return err_msg("主人，她的背包满了！~~\n");
  }
  write("ok，搞掂，搞了个" + jia->short() + "\n");
  return 1;
}
