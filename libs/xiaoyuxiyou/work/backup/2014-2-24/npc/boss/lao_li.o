dbase (["id":"lao li","actions":,"combat_exp":6807,"inquiry":([]),"race":"人类","long":"铁铺的主人．","chat_chance":5,"kar":19,"attitude":"friendly","can_speak":1,"eff_kee":829,"str":29,"atman":0,"cps":26,"eff_gin":100,"int":27,"chat_msg":({"老李头一脚踢在小学徒的屁股上，嚷道：不许偷懒！","老李头对小学徒嚷道：教你多少次了！你怎么这么笨！","老李头说道：听说宝象锡器铺的新到了一批高等级的锡。","老李头说道：听说西域比丘的金器店里有高纯度的金。","老李头大声对着小学徒嚷道：再不学好，把你送去祭赛银器店卖银！","老李头说道：听说西域天竺首饰店里有奇珍寒玉卖，真想见识见识哈。","老李头喃喃自语：从天竺玉华县的铁匠铺新进的一批铜不知能不能用。","老李头说道：本店的天外飞石绝对真货！","老李头说道：若论铁矿，还是无底洞铁匠铺的好。","老李头说道：西域钦法的寒铁可是炼兵器的好材料。",}),"force":0,"gin":100,"mana":0,"cor":23,"con":28,"unit":"位","vendor_goods":(["dagger":"/obj/example/dagger","sword":"/d/gao/obj/sword","yunshi":"/d/obj/yelian/yunshi","blade":"/d/gao/obj/blade",]),"spi":24,"startroom":"/d/gao/tiepu","per":15,"kee":794,"title":"铁匠","daoxing":80000,"potential":19,"shen_type":1,"bellicosity":0,"food":0,"age":56,"water":0,"eff_sen":824,"name":"老李头","gender":"男性","sen":824,"max_kee":829,"limbs":({"头部","颈部","胸口","后心","左肩","右肩","左臂","右臂","左手","右手","腰间","小腹","左腿","右腿","左脚","右脚",}),"max_sen":824,"max_gin":100,"default_actions":,])
