// clean_up.c
// by Annihilator@ES2

int clean_up() {
  object *inv;
  int i;

  if (!clonep() && this_object()->query("no_clean_up")) return 1;

  if (interactive(this_object())) return 1;

  // If we are contained in something, let environment do the clean
  // up instead of making recursive call. This will prevent clean-up
  // time lag.
  if (environment()) return 1;

  inv = all_inventory();
  for (i = sizeof(inv) - 1; i >= 0; i--)
    // interactive() is false for a net-dead player (the connection is
    // gone, but the player's body/save state is still logically
    // "here" and reconnectable) -- checking only interactive() let a
    // room holding nothing but a net-dead player be treated as empty
    // and destructed out from under them (AGENTS.md deep-functional-
    // test finding on xiaoyuxiyou: a room-cleanup mechanism destructing
    // a room a player is still "in"). userp() reflects the driver's
    // O_ONCE_INTERACTIVE flag, which stays true for a player body
    // across a net-dead disconnect (and is what obj/user.lpc's own
    // net_dead()/do_net_dead() rely on elsewhere), so it correctly
    // keeps the room loaded for both connected and net-dead players.
    if (interactive(inv[i]) || userp(inv[i])) return 1;

  destruct(this_object());
  return 0;
}
