
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("标准军服", ({ "uniform" }) );
	set("long","标准军服的长描述。\n");
	set_weight(3000);
	set("no_drop",1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 5);
	}
	setup();
}
