// blade.c

#include <weapon.h>

inherit AXE;

void create()
{
	set_name("大斧", ({ "axe" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 500);
		set("material", "iron");
		set("long", "这是一柄份量大约三四公斤重的大斧。\n");
		set("wield_msg", "$N抽出一柄$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插回腰间。\n");
	}
	init_axe(25,TWO_HANDED);
	setup();
}
