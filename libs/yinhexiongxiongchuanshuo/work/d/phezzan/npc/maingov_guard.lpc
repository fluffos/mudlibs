inherit NPC;

#include <ansi.h>

void create()
{
	set_name("自制领主府守卫", ({ "guard" }) );
	set("gender", "男性" );
	set("age", 27);
	set("long","卫兵的长描述。\n");
	set("combat_exp", 100000);
	set("attitude", "friendly");

	create_family("费沙自治领",6,"武官");
	set_space("vassalage","费沙");
	set("rank",1);

	setup();

	carry_object("/obj/cloth/uniform_p")->wear();
}

void init()
{
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(20) ) {
	   case 0:
		message_vision("$N一脸严肃的环视着周围的情况，当然这是他的职责。\n",this_object(),ob);
			break;
	   case 1:
		message_vision("$N紧紧的盯着$n，好象要从$n的脸上看出什么似的。\n",this_object(),ob);
			break;
	}
}
