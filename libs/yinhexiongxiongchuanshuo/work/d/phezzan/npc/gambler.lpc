inherit NPC;
inherit F_VENDOR;

#include <ansi.h>

void create()
{
	set_name("投机商", ({ "merchant","gambler" }) );
	set("gender", "男性" );
	set("age", 42);
	set("long","一脸精明德投机商人，手里总是有些难买到的东西。\n");
	set("combat_exp", 200);
	set("attitude", "friendly");
	if( !random(5) )
	{
		set("vendor_goods", ([
			__DIR__"obj/ladder" : 1,
			__DIR__"obj/mag_suit" : 1,
		]) );
	}
	else
	{
		set("vendor_goods", ([
			__DIR__"obj/smock" : 1,
			__DIR__"obj/cook1" : 1,
		]) );
	}

	setup();

	carry_object(__DIR__"obj/suit")->wear();
}

void init()
{
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(10) ) {
		case 0:
		message_vision("$N清点了一下自己手头的货物，摇了摇头\n",this_object(),ob);
			break;
		case 1:
		message_vision("$N看到了$n，就象看到救星一样，两眼发出热烈的光彩。\n",this_object(),ob);
			break;
	}
}
