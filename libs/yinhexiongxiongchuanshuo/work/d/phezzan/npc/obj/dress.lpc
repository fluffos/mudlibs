
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("职业女装", ({ "dress" }) );
	set("female_only",1);
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("value",300);
		set("armor_prop/armor", 1);
	}
	setup();
}
