// book.c
#include <ansi.h>

inherit ITEM;

void create()
{
	set_name("现代人材论", ({ "talent book","book" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
			"《现代人材论----杨威利》-----$#$！@著\n");
		set("value", 100);
		set("material", "paper");
	}
}
