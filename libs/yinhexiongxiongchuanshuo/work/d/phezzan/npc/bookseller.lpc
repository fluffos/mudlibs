// bookseller.c

inherit NPC;
inherit F_VENDOR;

#include <ansi.h>

void create()
{
	set_name("书店老板", ({ "seller" }) );
	set("gender", "男性" );
	set("age", 52);
	set("long","胖乎乎的书店老板，总是笑眯眯的看著来往的买书人。\n");
	set("combat_exp", 200);
	set("attitude", "friendly");
	set("vendor_goods", ([
		__DIR__"obj/book1" : 20,
		__DIR__"obj/book2" : 20,
		__DIR__"obj/book3" : 20,
		__DIR__"obj/book4" : 20,
	]) );

	setup();

	carry_object(__DIR__"obj/suit")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(10) ) {
		case 0:
		message_vision("$N对$n说：有新到的《杨威利的四次战争》，要不要买一本？\n",this_object(),ob);
			break;
		case 1:
		message_vision("$N看了$n一眼，嘴里嘟嘟囔囔道：不买就算，别把我的书弄脏了。\n",this_object(),ob);
			break;
	}
}
