inherit NPC;
inherit F_VENDOR;

#include <ansi.h>

void create()
{
	set_name("酒店服务生", ({ "waiter" }) );
	set("gender", "男性" );
	set("age", 22);
	set("long","表情很酷的服务生，手上端着酒盘。\n");
	set("combat_exp", 200);
	set("attitude", "friendly");
	set("per",23);
	set("vendor_goods", ([
		__DIR__"obj/beer" : 20,
		__DIR__"obj/whisky" : 20,
		__DIR__"obj/wine" : 20,
		__DIR__"obj/lotion" : 20,
	]) );

	setup();

	carry_object(__DIR__"obj/suit")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(5) ) {
		case 0:
		message_vision("$N向$n微微颔首，问道：请问您是几位来喝酒？\n",this_object(),ob);
			break;
		case 1:
		message_vision("$N对$n说道：欢迎光临巴特亚酒店，请您里面坐。\n",this_object(),ob);
			break;
	}
}
