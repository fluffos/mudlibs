inherit NPC;
inherit F_VENDOR;

#include <ansi.h>

void create()
{
	set_name("坐台小姐", ({ "girl","bar_girl" }) );
	set("gender", "女性" );
	set("age", 23);
	set("long","神情妩媚的朵拉库尔吧台小姐。\n");
	set("combat_exp", 200);
	set("attitude", "friendly");
	set("per",23);

	set("chat_chance", 5);
	set("chat_msg", ({
		"坐台小姐半信半疑的问：“···真的吗？”\n",
		"坐台小姐捂住了嘴，惊叫：“噢···我的天哪！”\n",
		"坐台小姐饶有兴趣的问着：“然后呢？”\n",
		"坐台小姐很钦佩的说道：“哇，你真行···”\n",
		"坐台小姐一脸的焦急：“后来呢？”\n",
		"坐台小姐显得非常好奇：“后来怎么样？”\n",
		"坐台小姐用极其崇拜的语气说道：“你好伟大哦！”\n",
		"坐台小姐附和着：“真了不起！”\n",
		"坐台小姐轻轻的拍着胸口，松了一口气似的说道：“你真幸运！”\n",
	}) );

	set("vendor_goods", ([
		__DIR__"obj/beer" : 20,
		__DIR__"obj/whisky" : 20,
	]) );

	setup();

	carry_object(__DIR__"obj/skirt")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(20) ) {
		case 0:
		message_vision("$N招呼着$n：您来点什么，啤酒？还是威士忌？\n",this_object(),ob);
			break;
		case 1:
		message_vision("$N对$n说道：您不久前来过吧，看起来很面熟啊。\n",this_object(),ob);
			break;
	}
}
