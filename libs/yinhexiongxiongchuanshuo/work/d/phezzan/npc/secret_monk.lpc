inherit NPC;

#include <ansi.h>

void create()
{
	set_name("旅游者", ({ "traveller" }) );
	set("gender", "男性" );
	set("age", 27);
	set("long","东张西望的旅游者，似乎对周围所有的东西都感到好奇。\n");
	set("combat_exp", 100000);
	set("attitude", "peaceful");

	set("chat_chance", 5);
	set("chat_msg", ({
		"旅游者在西服内兜里摸索着，里面好象是什么电子仪器吧，神情有点紧张。\n",
		"旅游者抬头看了看天气，然后若有所思的想着什么。\n",
		"旅游者东张西望的，也不知道在看什么，真象个没见过市面的乡下佬。\n",
		(: random_move :),
		(: random_move :),
	}) );

	setup();

	carry_object(__DIR__"obj/blinker");
	carry_object(__DIR__"obj/suit")->wear();
}
