#include <ansi.h>

inherit ROOM;

void create()
{
	set("short",GRN"费沙广场"NOR);
	set("long", @LONG
费沙虽然只有二十亿人口，但是它的财力却与同盟、帝国不相上
下。提供地上车高速运行的八车道干路横贯东西，路边的人行路吵嚷
而充满活力。迎面偶尔走过豆蔻年华的费沙少女，衣着入时，一串串
不加掩饰的银铃般笑声仿佛把空气也漂得更加透明。一些行人正站在
路边等着地上车。
LONG
	);

	set("globe","phezzan");
	set("valid_startroom", 1);

	set("exits", ([
		"north" : __DIR__"nstreet",
		"south" : __DIR__"highway5",
                "east" : __DIR__"estreet",
		"west" : __DIR__"wstreet",
	]));

	set("taxi",([
		__DIR__"highway" : 200,
		__DIR__"hotelstreet" : 20,
	]) );

	set("walk_bonus",5);

	set("objects", ([
		__DIR__"npc/girl" : 2,
	]) );

	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);

	setup();
}
