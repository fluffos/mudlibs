#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "供电中心操作间");
	set("long", @LONG
一间如同战舰泊位般巨大的房间，里面布满了各种仪器、设备，
以及监控他们的巨型电脑、众多的显示屏和身穿制服的工作人员。
嘈杂的噪音使你什么也听不见。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"south" : __DIR__"e_center",
	]));

	set("objects", ([
		__DIR__"npc/engineer" : 1,
	]) );

	set("coor/x",80);
	set("coor/y",40);
	set("coor/z",0);

	setup();
}

int valid_leave(object me)
{
	me->delete_temp("bother_time");
	return 1;
}
