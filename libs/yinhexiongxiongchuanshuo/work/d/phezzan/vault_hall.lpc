#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "地下掩体大厅");
        set("long", @LONG
掩体的布局为了消除住在里面的人的压抑感而刻意铺设得一如
豪奢的王朝宫殿，由于同样的理由，天花板也特意挑高，整个空间
多出了许多无用的部分。西面是掩体内的卧室，东边大厅中隐约能
看到一张长桌，显然是一个餐厅。
****************************************
这里的北面出口应隐藏，机关在西面的卧室酒柜中。
从这里可以由地下通道单向通往神秘山庄的“人造湖畔”lakeside.c
******************************************
LONG
	);

	set("exits", ([
		"north" : __DIR__"lakeside",
		"west" : __DIR__"vault_bedroom",
		"east" : __DIR__"vault_refectory",
		"south" : __DIR__"vault",
	]));

	set("globe","phezzan");
	setup();
}
