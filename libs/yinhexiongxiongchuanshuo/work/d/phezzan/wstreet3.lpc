//Modified by xyc
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short","罗夫汀地区");
	set("long", @LONG
西费沙大道的这一街区是罗夫汀地区。这里有费沙最大的贮油库，
从向西望去是巨大的圆柱型贮油罐，在阳光下闪着奕奕银光。费沙
的战略物资贮存于此，据说里面有难以数计的维护建筑，但是普通
公民是无法进入的。西南面已经是郊区了。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"east" : __DIR__"wstreet2",
		"southwest" : __DIR__"west_suburb",
	]));

	set("coor/x",-80);
	set("coor/y",0);
	set("coor/z",0);

	set("walk_bonus",5);

	setup();
}

void init()
{
	add_action("go_west","west");
}

int go_west()
{
	object room;

	room = load_object(__DIR__"oilcan0.lpc");
	message_vision("$N向贮油罐区域深处走去。\n",this_player());
	if( this_player()->move(room) )
		return 1;
	return 0;
}
