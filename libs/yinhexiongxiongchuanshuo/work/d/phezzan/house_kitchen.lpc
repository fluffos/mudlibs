#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "神秘山庄餐厅");
        set("long", @LONG
明媚的阳光使里面的陈设显得更加的一尘不染。雪白的墙壁映
衬着长圆型餐桌上的银亮餐具，与整体风格稍有不同的是，这里的
陈设却比较古朴。从东面的玄窗可以见到一条青石小路在树林间曲
折穿行。
***********************************************************
这里的窗子可以跳出去。如果blackfox发现玩家出现，会触发
alert，比如说ask blackfox about 地球教 等。进而大门禁闭，所有
房间出现n多地球教徒，见人就杀，只有从这里跑掉
***********************************************************
LONG
	);

	set("exits", ([
		"west" : __DIR__"house_parlor",
		"east" : __DIR__"estoneway1",
	]));

	set("globe","phezzan");
	setup();
}
