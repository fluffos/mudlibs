#include <ansi.h>

inherit ROOM;

void create()
{
        set("short",GRN"主题喷泉"NOR);
        set("long", @LONG
水池到这里忽然扩展成一个大圆盘，当中就是在广场上都能一望
可及的、射高达十五米的主题喷泉了。中心的主喷泉直刺青天；周边
十二个小喷泉角度稍稍倾斜，刚好与主喷泉在黄金分割点附近会聚，
激出纷扬的水花。。。由此向西是冬馆，东面则是费沙中央银行。
LONG
        );

	set("globe","phezzan");

        set("exits", ([
		"east" : __DIR__"center_bank_w",
		"south" : __DIR__"nstreet1",
		"west" : __DIR__"winter_gate",
		"north" : __DIR__"nstreet3",
	]));

	set("coor/x",0);
	set("coor/y",60);
	set("coor/z",0);

	setup();
}

int valid_leave(object me, string dir)
{
        message_vision( HIC "一阵淡淡的水雾飘落，使$N浑身上下拂上了一层晶莹的雾珠。\n\n\n" NOR,me);
	return 1;
}
