#include <ansi.h>

inherit ROOM;

void create()
{
	set("short","高等事务官书房");
	set("long", @LONG
这里是银河帝国派驻在费沙最高长官的办公室，形式上负责处理
与费沙政治经济的管理。办公室内文件和其他的一些办公用具散乱在
四周。曾是帝国高等事务官的瑞姆夏德害怕回国后新体制的裁判。内
战结束后，他就离开了驻费沙事务官公邸，去向不明。
LONG
	);

	set("item_desc", ([
		"文件":"屋子里散乱在角落的文件，也不知道有什么用处，似乎可以捡起来(ＰＩＣＫ)看看。\n",
		"file":"屋子里散乱在角落的文件，也不知道有什么用处，似乎可以捡起来(ＰＩＣＫ)看看。\n",
		"wenjian":"屋子里散乱在角落的文件，也不知道有什么用处，似乎可以捡起来(ＰＩＣＫ)看看。\n",
		"办公用具":"被丢弃在角落的办公用具。\n",
		"用具":"被丢弃在角落的办公用具。\n",
		"yongju":"被丢弃在角落的办公用具。\n",
	]) );

	set("globe","phezzan");

	set("exits", ([
		"north" : __DIR__"empire_garden",
		"south" : __DIR__"empire_hall",
	]));

	set("coor/x",40);
	set("coor/y",30);
	set("coor/z",0);

	setup();
}

void init()
{
	add_action("do_pick","pick");
}

int do_pick(string arg)
{
	object file;

	if( !arg )
		return 0;

	if( arg != "文件" && arg != "wenjian" && arg != "file" )
		return 0;
	if( query("already_picked") )
	{
		tell_object(this_player(),"这里的文件好象已经被别人捡走了。\n");
		return 1;
	}
	file = new(__DIR__"obj/file");
	if( file->move(this_player()) )
	{
		tell_object(this_player(),"你捡起了一本已经残缺不全的文件。\n");
		set("already_picked",1);
		return 1;
	}
	return 0;
}
