#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "巴特亚酒店");
	set("long", @LONG
“巴特亚”酒店是这里档次最高的酒店，以前费沙政府经常在这
里举办一些茶话会、酒会；而且，每当同盟和帝国的驻在事务官到任
或离任，这里都是有着接待的惯例。宽大的宴会厅拥有一个巨大的穹
顶，几十张酒桌对面是一个阶梯上的舞台，摆放着一些乐器。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"east" : __DIR__"hotelstreet",
	]));

	set("objects", ([
		__DIR__"npc/bateya_waiter" : 1,
	]) );

	set("coor/x",-60);
	set("coor/y",-30);
	set("coor/z",0);

	setup();
}
