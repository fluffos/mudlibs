#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "神秘山庄二楼");
        set("long", @LONG
对面的墙上挂有一幅巨大的圣女油画像。走廊尽头左右分开，两
边各有一个房间。西面的房间大门紧锁，东面的大门敞开着，直可以
看到阳台外面射进的阳光。
***********************************************************
西面的房间必须硬闯，也就是说，要想见到里面的鲁宾斯基，必然
会触动警报，大量地球教徒就会涌入。
***********************************************************
LONG
	);

	set("exits", ([
		"east" : __DIR__"house_saloon",
		"west" : __DIR__"house_bedroom",
		"down" : __DIR__"house_parlor",
	]));

	set("globe","phezzan");
	setup();
}
