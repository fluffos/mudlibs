inherit ITEM;

void create()
{
	set_name("电脑", ({ "computer" , "pc", "电脑", "diannao"}) );
	set("no_get", 1);
	set("no_show", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "台");
		set("long", "一台同盟造的电脑，联接着墙角的存储机，也不知道里面有什么有用的信息。\n");
		set("value", 1);
	}
}

void init()
{
	add_action("do_search","search");
}

int do_search(string arg)
{
	object me, disk;

	if( !arg ) return 0;

	if( ( arg != "电脑" ) && ( arg != "computer" ) && ( arg != "pc" ) && ( arg != "diannao" ) )
		return 0;
	me = this_player();
	message_vision("$N在电脑前忙活着，也不知道在搜索什么信息。\n",me);

	if( !objectp( disk = present("disk",me) ) )
		return notify_fail("电脑里提到了有关星图什么的信息，但是这么海量的数据没法都记在脑子里。\n");

	disk->set("memory", (["巴拉特星系星图":"/u/ballat"]) );
	tell_object(me,"你把搜索到的巴拉特星系星图记录在了随身携带的磁碟上。\n");
	return 1;
}
