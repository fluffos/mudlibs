inherit ITEM;

void create()
{
	set_name("垃圾筒", ({ "canister", "lajitong", "垃圾筒"}) );
	set_weight(5000);
	set_max_encumbrance(8000);
	set("no_get", 1);
	set("no_show", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "一个堆满了废物的垃圾筒。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }
