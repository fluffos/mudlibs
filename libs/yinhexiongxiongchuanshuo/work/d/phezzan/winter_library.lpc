#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "冬馆图书馆");
        set("long", @LONG
硬木制的暗红色高大书架陈列在房间的四周，上面有着些许的灰
尘----显然这里并不经常打扫。窗外的自然光被高大的冬青树柔和的
过滤，看来窗下的躺椅是这里唯一适合阅览书籍的地方。
LONG
	);

	set("exits", ([
		"west" : __DIR__"e_gallery2",
	]));

	set("globe","phezzan");

	create_door("west", "木门", "east", 1);

	set("objects", ([
		__DIR__"npc/boltic" : 1,
	]) );

	set("coor/x",-35);
	set("coor/y",90);
	set("coor/z",20);

	setup();
}
