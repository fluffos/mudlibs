//Modified by xyc
#include <ansi.h>

inherit ROOM;

void close_path();
void messaging();

void create()
{
	set("short", "镭射室");
	set("long", @LONG
昏暗的房间里隐约可辨认出一台几乎占满房间的设备，不时发出
“喀嚓”、“喀嚓”的恐怖声音。屋顶的应急灯看上去有些陈旧，似
乎好久没有用过。当然，医院的镭射室是应当保持２４小时待命状态
的，所以这很正常。
LONG
	);

	set("globe","phezzan");

	set("exits", ([
		"north" : __DIR__"hospital",
	]));

	set("coor/x",-60);
	set("coor/y",-30);
	set("coor/z",0);

	messaging();
	setup();
}

void init()
{
	add_action("do_open","open");
}

int do_open(string arg)
{
	object me;

	if( !arg ) return 0;

	if( ( arg != "盖板" ) && ( arg != "planking" ) && ( arg != "gaiban" ) )
		return notify_fail("你要打开什麽？\n");

	me = this_player();
	if( !query("no_power") )
	{
		message_vision(HIR"$N去拉地上的盖板，可是漏电的机器把$N重重的电了一下！\n"NOR,me);
		me->unconcious();
		return 1;
	}
	else
	{
		message_vision("$N拉开了地上的盖板，发现了一个向下的通道。\n", me);
		if( !query("exits/down") )
		{
			set("exits/down", __DIR__"hospital_cellar");
			call_out("close_path", 1);
		}
		return 1;
	}
	return 1;
}

void close_path()
{
	if( !query("exits/down") ) return;

	message("vision","地上的盖板在弹簧的拉力下回到了它原来的位置。\n",this_object());
	delete("exits/down");
}

void messaging()
{
	if( this_object()->query("no_power") )
	{
		call_out("messaging",300);
		return;
	}
	switch( random(5) )
	{
		case 0:
			message("vision",CYN"漏电的机械臂摩擦着地面上的盖板，打出蓝色的火花。。。\n"NOR,this_object());
			break;
		default:
			message("vision",CYN"巨大的设备在运转，发出恐怖的“喀嚓”“喀嚓”声。。。\n"NOR,this_object());
			break;
	}
	call_out("messaging",300);
}
