inherit ROOM;

void create()
{
	set("short","市中心");
	set("long",@LONG
奥丁的市中心
LONG
	);
	set("globe","odin");
	set("exits",([
		"east" : "/d/odin/eastway",
		"west" : "/d/odin/westway",
		"south" : "/d/odin/highway1",
		"north" : "/d/odin/northway",
	]));
	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}
