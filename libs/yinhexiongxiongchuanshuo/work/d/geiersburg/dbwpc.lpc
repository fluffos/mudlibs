inherit ROOM;

void create()
{
	set("short","瓦普控制室");
	set("long",@LONG
瓦普控制室是控制１２个瓦普引擎同步工作的地方，每个瓦普室
控制两个瓦普引擎。这里可以说是要塞的核心部分因为稍一不小心就
可能导致整个要塞陷入时空的漩涡再也回不来了。所以这里的设施都
是最先进的。另外为了防止敌人渗透破坏，每个控制室都有一个连的
要塞最精锐的地面部队把守，其重要性由此可见一斑。
LONG
	);
	set("globe","geiersburg");
	set("exits",([

		"west" : "/d/geiersburg/dbwpass",
		"south" : "/d/geiersburg/wp11",
		"north" : "/d/geiersburg/wp12",
	]));
	set("coor/x",120);
	set("coor/y",60);
	set("coor/z",-60);
	setup();
}
