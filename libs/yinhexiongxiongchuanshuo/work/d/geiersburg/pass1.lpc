inherit ROOM;

void create()
{
	set("short","秃鹰防御检疫中心");
	set("long",@LONG
这里是秃鹰之城卫生防御检疫中心，任何初次来到这里的人都要
在这里经过隔离检疫才能进入秃鹰之城。这是一个必要步骤，因为在
宇宙的深处至今还存在着不为人知的可怕的细菌。如果一经发现携带
者，就会连人一起处理掉。虽然很不人道，但却是最有效的方法。
LONG
	);
	set("globe","geiersburg");
	set("exits",([

		"west" : "/d/geiersburg/starport",
		"south" : "/d/geiersburg/cfpass",
		"north" : "/d/geiersburg/cspass1",
	]));
	set("coor/x",-180);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}
