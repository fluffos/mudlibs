inherit ROOM;

void create()
{
	set("short","士兵通道1段");
	set("long",@LONG
士兵通道是连接要塞内部和秃鹰之城空港的另一条通道，与高级
军官专用通道不同的是，几乎所有的士兵和车辆都经过这里所以显得
格外热闹．
LONG
	);
	set("globe","geiersburg");
	set("exits",([
		"east" : "/d/geiersburg/cspass2",
		"south" : "/d/geiersburg/pass1",
	]));
	set("coor/x",-180);
	set("coor/y",30);
	set("coor/z",0);
	setup();
}
