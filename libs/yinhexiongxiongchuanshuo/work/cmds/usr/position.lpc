//position.c

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_DISTANCE;

string display_direction(string result, int alpha, int beta );

int main(object me, string arg)
{
	int range, alpha, beta;
	string result;
	object obj, env;

	seteuid(getuid());

	if( !objectp(env=environment(me)) ) return 0;

	if( !env->is_space_room() && !env->is_planet() )
		return notify_fail("只有在空间才能使用POSITION指令。\n");

	if( !arg )
		return notify_fail("要计算什么的位置？\n");

	if( undefinedp( range = me->query_space("scouting")) )
	{
		range = 1;
		me->set_space("scouting",1);
	}

	if( objectp( obj = present(arg, env) )
		&& calculate_distance(me,obj,range) )
	{
		if( obj->is_character() )
		{
			alpha = obj->query_space("x-dir");
			beta = obj->query_space("y-dir");
			result = sprintf("\n%s，当前坐标Alpha %d，Beta %d\n",
				obj->space_short(1),alpha,beta);
		}
		else
		{
			alpha = obj->query("x-dir");
			beta = obj->query("y-dir");
			result = sprintf("\n%s，当前坐标Alpha %d，Beta %d\n",
				obj->name(),alpha,beta);
		}
	}
	else return notify_fail("没有这个星球，舰队或者星际物。\n");

	if( obj == me )
		return notify_fail("用LOOK指令就可以得到本舰队位置信息。\n");

	alpha -= me->query_space("x-dir");
	beta -= me->query_space("y-dir");

	if( !alpha && !beta )
		return notify_fail("目标坐标几乎与我舰队重合。\n");

	result += sprintf("与我军距离%f，",sqrt( alpha*alpha + beta*beta ) );

	result = display_direction(result,alpha,beta);

	write(HIW + result + "\n"NOR);

	return 1;
}

string display_direction(string result, int alpha, int beta )
{
	float k;

	if( !alpha && ( beta > 0 ) ) result += "零点钟方向。\n";
	else if( !alpha && ( beta < 0 ) ) result += "六点钟方向。\n";
	else if( !beta && ( alpha > 0 ) ) result += "三点钟方向。\n";
	else if( !beta && ( alpha < 0 ) ) result += "九点钟方向。\n";
	else
	{
		k = to_float(beta)/to_float(alpha);
		if( alpha > 0 )
		{
			if( k == 1 ) result += "两点半方向。\n";
			else if( k == -1 ) result += "四点半方向。\n";
			else if( k > 1 ) result += "一点钟方向。\n";
			else if( k > 0 ) result += "两点钟方向。\n";
			else if( k > -1 ) result += "四点钟方向。\n";
			else result += "五点钟方向。\n";
		}
		else if( alpha < 0 )
		{
			if( k == 1 ) result += "七点半方向。\n";
			else if( k == -1 ) result += "十点半方向。\n";
			else if( k > 1 ) result += "七点钟方向。\n";
			else if( k > 0 ) result += "八点钟方向。\n";
			else if( k > -1 ) result += "十钟方向。\n";
			else result += "十一点钟方向。\n";
		}
		else result += "不知道什么方向。\n";
	}
	return result;
}

int help(object me)
{
	write(@HELP
指令格式：
	position <星球|舰队|星际物>

获得某星球，舰队，星际物的位置信息。

HELP
    );
    return 1;
}
