// uptime.c
#include <ansi.h>

inherit F_CLEAN_UP;

// This command is also called by LOGIN_D, so we don't want it use 
// arguments.
int main()
{
	int t, d, h, m, s;
	string time;

	t = uptime();
	s = t % 60;		t /= 60;
	m = t % 60;		t /= 60;
	h = t % 24;		t /= 24;
	d = t;

	if(d) time = CHINESE_D->chinese_number(d) + "天";
	else time = "";

	if(h) time += CHINESE_D->chinese_number(h) + "小时";
	if(m) time += CHINESE_D->chinese_number(m) + "分";
	time += CHINESE_D->chinese_number(s) + "秒";

	write(CYN"银河英雄传说已经执行了" + time + "。\n"NOR);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : uptime
 
这个指令告诉你  银河英雄传说  已经连续执行了多久。
HELP
    );
    return 1;
}
