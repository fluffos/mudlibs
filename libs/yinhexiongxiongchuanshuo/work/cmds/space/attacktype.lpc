#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	int which,i;
	string all,attacktype;
	mapping *all_sub_fleet,fleet;

	seteuid(getuid());

	if( !environment(me)->is_space_room() && !environment(me)->is_planet() )
		return notify_fail("现在你并没有率领舰队在外太空航行。\n");

	if( !arg ) { help(me);return 1; }

	all_sub_fleet = me->query_space("sub_fleet");
	if( sscanf(arg,"%d %s",which,attacktype) != 2 )
	{
		if( sscanf(arg,"%s %s",all,attacktype) != 2 ) { help(me);return notify_fail(""); }
		if( all != "all" ) { help(me);return notify_fail(""); }
		if( ( attacktype != "beam" ) && ( attacktype != "missile" ) && ( attacktype != "airforce" ) )
			return notify_fail("部队无法识别你所要求的攻击形式。\n");
		for(i=0;i<sizeof(all_sub_fleet);i++)
		{
			fleet = all_sub_fleet[i];
			fleet["attacktype"] = attacktype;
		}
		tell_object(me,"我军所有部队攻击形式更改完毕。\n");
		return 1;
	}

	if( ( which < 1 ) || ( which > sizeof(all_sub_fleet) ) )
		return notify_fail("我军还没有这个部队编制。\n");

	fleet = all_sub_fleet[which-1];
	switch (attacktype)
	{
	   case "beam":
		fleet["attacktype"] = attacktype;
		tell_object(me,"我军第" + to_chinese(which) + "部队攻击形式已经改为主炮。\n");
		break;
	   case "missile":
		fleet["attacktype"] = attacktype;
		tell_object(me,"我军第" + to_chinese(which) + "部队攻击形式已经改为飞弹。\n");
		break;
	   case "air_force":
		fleet["attacktype"] = attacktype;
		tell_object(me,"我军第" + to_chinese(which) + "部队攻击形式已经改为空战。\n");
		break;
	   default:
		return notify_fail("部队无法识别你所要求攻击形式。\n");
        }
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：
	attacktype <舰队编号> <beam|missile|air_force>
 
这个指令用来更改我军某部队的攻击形式。
如果想改变全舰队攻击形式，<舰队编号>处用all代替。
例：
	attacktype 1 missile	更改我军第一部队攻击形式为飞弹攻击。
	attacktype all beam	更改我军所有部队攻击形式为主炮攻击。
HELP
    );
    return 1;
}
