//orbit.c  Writen by Alarms 5/9/99

#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DISTANCE;

int main(object me,string arg)
{
	object planet,env;
	object *result;

	seteuid(getuid());

	if( !environment(me)->is_space_room() && !environment(me)->is_planet() )
		return notify_fail("现在你并没有率领舰队在外太空航行。\n");

	if( !arg )
		return notify_fail("要进入哪一个星球的轨道？\n");
	if( !(planet = present(arg,environment(me))) 
		|| !planet->is_planet()
		|| !distance(me,planet->query("x-dir"),planet->query("y-dir"),me->query_space("scouting"))
		)
		return notify_fail("没有这个星球。\n");

	if( ( me->query_space("x-dir") != planet->query("x-dir") )
		|| ( me->query_space("y-dir") != planet->query("y-dir") ) )
		return notify_fail("还没有到达星球空域，无法进入星球轨道。\n");
	if( me->is_combating() )
		return notify_fail("战斗中无法进入星球轨道。\n");

	env = environment(me);
	result = receiver_filter(all_inventory(env),me);

	if( me->move(planet) )
		{
		message("vision",HIY"\n" + me->space_short() + "渐渐向" + planet->query("name")
			+ HIY"靠拢，最后消失在星球轨道的另一边...\n"NOR,result,({}));
		message("vision",HIY"\n" + me->space_short() + HIY"渐渐向这里靠拢，准确的进入了轨道环绕状态。\n"NOR,planet,({me}));
		tell_object(me,HIY"你的舰队渐渐向" + planet->query("name") + HIY"靠拢，准确的进入了轨道环绕状态。\n"NOR);
		return 1;
		}
	return 0;
}

int help (object me)
{
	write(@HELP
指令格式: orbit <星球>
 
这个指令让你可以率领舰队进入星球的轨道。
 
HELP
);
	return 1;
}
