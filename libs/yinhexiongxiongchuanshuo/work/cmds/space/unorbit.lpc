//unorbit.c  Writen by Alarms 7/7/99
#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DISTANCE;

int main(object me)
{
	object planet,env;
	object *result;

	seteuid(getuid());

	planet = environment(me);
	if( !planet->is_planet() )
		return notify_fail("舰队没有处于行星轨道上。\n");
	if( me->is_combating() )
		return notify_fail("战斗中无法脱离星球轨道。\n");



	if( me->move(env = environment(planet)) )
	{
		result = receiver_filter(all_inventory(env),me);
		me->set_space("x-dir",planet->query("x-dir"));
		me->set_space("y-dir",planet->query("y-dir"));
		message("vision",HIY"\n" + me->space_short() + HIY"从" + planet->query("name")
			+ HIY"轨道的另一边渐渐的显现，进入了星域空间。\n"NOR,result,({}));
		message("vision",HIY"\n" + me->space_short() + HIY"渐渐脱离了轨道环绕状态，进入了星域空间。\n"NOR,planet,({me}));
		tell_object(me,HIY"你的舰队渐渐脱离了" + planet->query("name") + HIY"的轨道环绕状态，进入了星域空间。\n"NOR);
		return 1;
	}
	return 0;
}

int help (object me)
{
	write(@HELP
指令格式: unorbit
 
这个指令让你可以率领舰队脱离星球轨道。
 
HELP
);
	return 1;
}
