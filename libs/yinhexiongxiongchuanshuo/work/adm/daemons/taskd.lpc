#include <ansi.h>
#include <command.h>

inherit F_DBASE;

varargs void init_dynamic_task(int hard);
varargs int spread_task(string task, int hard);
varargs int already_spreaded(string str, int hard);

string locate_obj(object me,string str);
string dyn_task_list();
int task_reward( object me, object who,object task_item);
object find_env(object ob);

string *tasks;
string *locations;
string *galaxies;

#define MAX_DIS		7
#define MAX_ALT		2
#define MAX_DIR		8

void create()
{
	string name;
	int i;
	seteuid(getuid());
	set("name","使命精灵");
	set("id","taskd");

//	reset_eval_cost();
	tasks = get_dir("/obj/task/");
	for(i=0;i<sizeof(tasks);i++)
	{
		if( sscanf(tasks[i],"%s.lpc",name) == 1 )
			tasks[i] = "/obj/task/" + name + ".lpc";
		else
		{
			tasks -= ({ tasks[i] });
			i--;
		}
	}

//最后要换成所有的屋子。
	locations = get_dir("/d/phezzan/");

	for(i=0;i<sizeof(locations);i++)
	{
		if( sscanf(locations[i],"%s.lpc",name) == 1 )
			locations[i] = "/d/phezzan/" + name + ".lpc";
		else
		{
			locations -= ({ locations[i] });
			i--;
		}
	}
//CHANNEL_D->do_channel(this_object(),"sys",sprintf("LOCATIONS: %O\n",locations));
//	CRON_D->set_last_hard_dis();
//CHANNEL_D->do_channel(this_object(),"sys",sprintf("TASK: %O\n",tasks));
	init_dynamic_task(1);
}

int task_reward(object me, object who,object task_item)
{
	int exp, score;

	if( userp(who) ) return 0;
	if( who->name() != task_item->query("owner_name") ) return 0;

	exp =200+random(500);
	score = exp/15+1;
	me->add_space("combat_exp",exp);
	me->add("score",score);

	tell_object(me,HIW"通过这次寻找使命的历程：\n你的实战经验上升" +
		chinese_number(exp) + "点\n你的功绩上升"+
		chinese_number(score)+"点\n"NOR);
	me->add("TASK",1);

//about big_reward, it is no use in this mud
//	if( !undefinedp(task["fin_func"]))
//	call_other(this_object(),task["fin_func"],me,who,task_item);

	if(task_item) destruct(task_item);
	return 1;
}

varargs void init_dynamic_task(int hard)
{
	int i;
	for( i=0; i < sizeof(tasks); i++)
		spread_task(tasks[i],hard);
}

varargs int spread_task(string task, int hard)
{
	object obj, tar, cur_obj;
	object *inv;
	object *target=({});
	int i;
	string location;

	if( already_spreaded(task,hard) ) return 0;

	tar = load_object(task);
	tar->set("value",0);

	reset_eval_cost();
/*	if( tar->is_space_task() )
		location = galaxies[random(sizeof(galaxies))];
	else*/ location = locations[random(sizeof(locations))];
	obj = find_object(location);

	if( obj ) obj->reset();
	else obj = load_object(location);
	cur_obj = obj;

	while( !cur_obj->query("coor") )
	{
		/*if( tar->is_space_task() )
			location = galaxies[random(sizeof(galaxies))];
		else*/ location = locations[random(sizeof(locations))];
		obj = find_object(location);

		if( obj ) obj->reset();
		else obj = load_object(location);
		cur_obj = obj;
	}

	if(cur_obj)
	{
		inv = all_inventory(cur_obj);
		for(i=0; i<sizeof(inv); i++)
		{
			if(inv[i]->is_character() && !userp(inv[i]))
				target += ({ inv[i] });
			if(inv[i]->is_container())
				target += ({ inv[i] });
		}
	}

	if(sizeof(target)) cur_obj = target[random(sizeof(target))];
	if(cur_obj)
	{
//write(sprintf("Now init_dynamic_task is spreading tasks,\ntask is %O,\nfile is %s,\ndest is %O\n\n",tar,task,cur_obj));
CHANNEL_D->do_channel(this_object(),"sys",sprintf("Now init_dynamic_task is spreading tasks,\ntask is %O,\nfile is %s,\ndest is %O\n\n",tar,task,cur_obj));
//		tar->set("dynamic_task",task);
		tar->move(cur_obj);
	}
	return 1;
}

string dyn_task_list()
{
	string output="";
	object owner,item;
	int i;

	reset_eval_cost();
	for( i=0; i < sizeof(tasks); i++)
	{
		if(objectp(item= find_object(tasks[i])))
//			item = load_object(tasks[i]);

//		if(!objectp(owner= find_object(item->query("owner_name"))))
//			owner = load_object(item->query("owner_name"));
		{
			if(already_spreaded(tasks[i]))
			output += sprintf("%s的%s（%s）\n",item->query("owner_name"),item->query("name"),item->query("id"));
		}
		else
		{
			item = load_object(tasks[i]);
			output += sprintf("%s的%s（%s）〔已完成〕\n",item->query("owner_name"),item->query("name"),item->query("id"));
			destruct(item);
		}
	}
	return output;
}

string locate_obj(object me,string str)
{
	string *distance = ({
	"极近", "很近", "比较近", "不远",
	"不近", "比较远", "很远", "极远"
	});
	string *altitude =({
	"并且较高的", "的", "并且较低的"
	});
/*	string *directions=({
	"周围","北方", "南方", "东方","西方",
	"东北方","西北方","东南方","西南方"
	});
*/
	object ob, tmpobj,where, *ob_list;
	object item,room;
	string output="",dis,alt,dir;
	int i;
	int x,y,z,x0,y0,z0;
	int realdis;
	int tmp;
	string result="";

	reset_eval_cost();
	for( i=0; i < sizeof(tasks); i++)
	{
/*		if( !(item= find_object(tasks[i])) )
			call_other(tasks[i],"???");
write(sprintf("task is %O,file is %s\n",item,tasks[i]));
*/
		if( !(item = find_object(tasks[i])) ) continue;
		else
		{
//write(sprintf("Now funtion is locating the task,and task is loaded into memory.\ntask id is %s,name is %s\n",item->query("id"),item->query("name")));
			if( item->query("id") == str || item->query("name") == str )
				result = tasks[i];
		}
	}
	if(result != "")
	{
		room = environment(me);
		ob_list = children(result);
		for(i=0; i<sizeof(ob_list); i++)
		{
			ob=find_env(ob_list[i]);
//write(sprintf("task env is %O,task obj is %O\n",ob,ob_list[i]));
			if(ob)
			{
				if( !stringp(ob->query("globe"))
					|| ( room->query("globe") != ob->query("globe") ) )
				return "『"+ob_list[i]->query("name")+"』似乎并不在这个星球上。\n";

				x0= (int)room->query("coor/x");
				y0= (int)room->query("coor/y");
				z0= (int)room->query("coor/z");
				x=(int)ob->query("coor/x")-x0;
				y=(int)ob->query("coor/y")-y0;
				z=(int)ob->query("coor/z")-z0;
				realdis=0;
				if(x<0)realdis-=x; else realdis+=x;
				if(y<0)realdis-=y; else realdis+=y;
				if(z<0)realdis-=z; else realdis+=z;
				tmp =(int)  realdis/50;
				if(tmp>MAX_DIS) tmp = MAX_DIS;
				dis=distance[tmp];

				if(z>0) alt=altitude[0];
				if(z<0) alt=altitude[2];
				if(z==0) alt=altitude[1];
				if(x==0&&y==0) dir="周围某处。\n";
				else dir=POSITION_CMD->display_direction("", x,y);
				output = "『"+ob_list[i]->query("name")+"』似乎在"+dis+alt+dir;
				return output;
			}
		}
	}
	else if( wizardp(me) )
	{
		tmpobj = find_player(str);
		if(!tmpobj) tmpobj = find_living(str);
		if(!tmpobj) return "";
		ob = find_env(tmpobj);
		room = environment(me);
		if(ob)
		{
			if( !stringp(ob->query("globe"))
				|| ( room->query("globe") != ob->query("globe") ) )
			return "『"+tmpobj->query("name")+"』似乎并不在这个星球上。\n";

			x0= (int)room->query("coor/x");
			y0= (int)room->query("coor/y");
			z0= (int)room->query("coor/z");
			x=(int)ob->query("coor/x")-x0;
			y=(int)ob->query("coor/y")-y0;
			z=(int)ob->query("coor/z")-z0;
			realdis=0;
			if(x<0)realdis-=x; else realdis+=x;
			if(y<0)realdis-=y; else realdis+=y;
			if(z<0)realdis-=z; else realdis+=z;
			tmp =(int)  realdis/50;
			if(tmp>MAX_DIS) tmp = MAX_DIS;
			dis=distance[tmp];

			if(z>0) alt=altitude[0];
			if(z<0) alt=altitude[2];
			if(z==0) alt=altitude[1];
			if(x==0&&y==0) dir="周围某处。\n";
			else dir=POSITION_CMD->display_direction("", x,y);
			output = "『"+tmpobj->query("name")+"』似乎在"+dis+alt+dir;
			return output;
		}
	}
	return "";
}

varargs int already_spreaded(string str,int hard)
{
	object ob,*ob_list;
	int i;

	if(!str) return 0;
	if(hard)
	{
		ob_list = children(str);
		for(i=0; i<sizeof(ob_list); i++)
		{
			ob=find_env(ob_list[i]);
			if(ob)
			{
				ob_list[i]->move(VOID_OB);
				destruct(ob_list[i]);
			}
		}
		return 0;
	}
	else
	{
		if(!str) return 0;
		ob_list = children(str);
		for(i=0; i<sizeof(ob_list); i++)
		{
			ob=find_env(ob_list[i]);
			if(ob) return 1;
		}
		return 0;
	}
}

object find_env(object ob)
{
	while(ob)
	{
		if(ob->query("coor") ) return ob;
		else ob=environment(ob);
	}
	return ob;
}

void execute_accept_object(object me, object who, object item)
{
	who->accept_object(me,item);
}

