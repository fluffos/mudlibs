void start_hatred(object me, object obj)
{
	if( !me || !obj ) return;			// Are we still exist( not becoming a corpse )?

	me->set_temp("looking_for_trouble", 0);

	if(	me->is_fighting(obj)			// Are we busy fighting?
	||	!living(me)				// Are we capable for a fight?
	||	environment(me)!=environment(obj)	// Are we still in the same room?
	||	environment(me)->query("no_fight") 	// Are we in a peace room?
	)	return;

	// We found our hatred! Charge!
	message_vision( catch_hunt_msg[random(sizeof(catch_hunt_msg))], me, obj);
	me->kill_ob(obj);
}

void start_vendetta(object me, object obj)
{
	if( !me || !obj ) return;			// Are we still exist( not becoming a corpse )?

	me->set_temp("looking_for_trouble", 0);

	if(	me->is_fighting(obj)			// Are we busy fighting?
	||	!living(me)				// Are we capable for a fight?
	||	environment(me)!=environment(obj)	// Are we still in the same room?
	||	environment(me)->query("no_fight") 	// Are we in a peace room?
	)	return;

	// We found our vendetta opponent! Charge!
	me->kill_ob(obj);
}

void start_aggressive(object me, object obj)
{
	if( !me || !obj ) return;			// Are we still exist( not becoming a corpse )?

	me->set_temp("looking_for_trouble", 0);

	if(	me->is_fighting(obj)			// Are we busy fighting?
	||	!living(me)				// Are we capable for a fight?
	||	environment(me)!=environment(obj)	// Are we still in the same room?
	||	environment(me)->query("no_fight") 	// Are we in a peace room?
	)	return;

	// We got a nice victim! Kill him/her/it!!!
	me->kill_ob(obj);
}

// This function is to announce the special events of the combat.
// This should be moved to another daemon in the future.
void announce(object ob, string event)
{
	switch(event) {
		case "dead":
			message_vision("\n$N死了。\n\n", ob);
			break;
		case "unconcious":
			message_vision("\n$N两腿一软，跌倒在地上一动也不动了。\n\n", ob);
			break;
		case "revive":
			message_vision("\n$N挣扎似的用力睁开眼睛，清醒了过来。\n\n", ob);
			break;
	}
}

void winner_reward(object killer, object victim)
{
	killer->defeated_enemy(victim);
}

void killer_reward(object killer, object victim)
{
	int exp, score, check, rank;
	string vmark, report, vassalage;

	// Call the mudlib killer apply.
	killer->killed_enemy(victim);

	if( userp(victim) )
	{
		victim->clear_condition();
		// Give the death penalty to the dying user.
		victim->set("bellicosity", 0);
		victim->add("combat_exp", -(int)victim->query("combat_exp") / 10);
		victim->add("score", -(int)victim->query("score") / 10);

		if( stringp(vmark = killer->query("vendetta_mark")) )
			victim->delete("vendetta/" + vmark);

		victim->save();  //autosave when U die.

		CHANNEL_D->do_channel(this_object(), "rumor",
			sprintf("%s被%s杀死了。", victim->name(1), killer->name(1)));
	}
	else
	{
		if (victim->query("owner") != (string)killer->query("id"))
			killer->add("MKS", 1); 
	}

	if( !interactive(victim) )
	if( stringp(vmark = victim->query("vendetta_mark")) )
		killer->add("vendetta/" + vmark, 1);

	if(mapp(killer->query_space("quest")))
	{
		mapping quest;
		if( interactive(killer)
			&& ( quest = killer->query_space("quest") )
			&& ( quest["quest_type"] == "杀死" )
			&& ( (int)killer->query_space("task_time") >= time() )
			&& ( victim->name() == quest["quest"] )
			&& !userp(victim) )
	        {
			exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2);
// put a limit on max exp we can get from a quest
			if( exp > 100) exp = 100;
			exp = exp * (int) killer->query_space_temp("quest_number");
			score = exp/ 15 + 1;
			killer->add("combat_exp", exp);
			killer->add("score", score);
			killer->delete_space("quest");
			killer->add_space_temp("quest_number");
			tell_object(killer,HIW"通过此次行动：\n你的格斗经验上升" +
				chinese_number(exp) + "点\n你的功绩上升"+
				chinese_number(score) + "点\n"NOR);

		check = killer->query("score");
		rank = killer->query("rank");

		if( !stringp( vassalage = killer->query_space("vassalage") )
			|| ( vassalage == "地球" )
			|| ( vassalage == "中立" ) )
			return;
		if( ( check > 100) && !rank ) killer->set("promoted",1);
		else if( ( check > 400 ) && ( rank < 2 ) ) killer->set("promoted",2);
		else if( ( check > 700) && ( rank < 3 ) ) killer->set("promoted",3);
		else if( ( check > 1000 ) && ( rank < 4 ) ) killer->set("promoted",4);
		else if( ( check > 4000 ) && ( rank < 5 ) ) killer->set("promoted",5);
		else if( ( check > 7000 ) && ( rank < 6 ) ) killer->set("promoted",6);
		else if( ( check > 10000 ) && ( rank < 7 ) ) killer->set("promoted",7);
		else if( ( check > 40000 ) && ( rank < 8 ) ) killer->set("promoted",8);
		else if( ( check > 700000 ) && ( rank < 9 ) ) killer->set("promoted",9);
		else if( ( check > 1000000 ) && ( rank < 10 ) ) killer->set("promoted",10);
		else if( ( check > 4000000 ) && ( rank < 11 ) ) killer->set("promoted",11);
		else if( ( check > 7000000 ) && ( rank < 12 ) ) killer->set("promoted",12);
		else if( ( check > 10000000 ) && ( rank < 13 ) && ( vassalage == "帝国" ) )
			killer->set("promoted",13);
		
		else killer->delete("promoted");
		if( killer->query("promoted") )
			{
			report = sprintf("鉴于在行动中的优异表现，现决定晋升%s\n            "
				"%s之官阶。特此通告！请回军部接受任命！\n",
				killer->query("title") ? killer->query("title"):"",
				killer->name(1) );
			CHANNEL_D->do_channel(this_object(),"report",report);
			}
		}
	}
}
