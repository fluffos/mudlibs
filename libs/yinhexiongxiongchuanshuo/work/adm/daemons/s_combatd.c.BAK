string damage_space_msg(int damage, string attacktype, string shiptype)
{
	string result;

	switch( attacktype ) {
	case "beam":
		if( damage < 5 ) result = HIC"总共有几艘$T被击毁。\n"NOR;
		else if( damage < 10 ) result = HIC"总共有不足十艘$T被击毁。\n"NOR;
		else if( damage < 20 ) result = HIC"总共有十几艘$T被击毁。\n"NOR;
		else if( damage < 60 ) result = HIY"总共有几十艘$T被击毁。\n"NOR;
		else if( damage < 100 ) result = HIY"总共有近百艘$T被击毁。\n"NOR;
		else if( damage < 200 ) result = YEL"总共有百余艘$T被击毁。\n"NOR;
		else if( damage < 500 ) result = YEL"总共有几百艘$T被击毁。\n"NOR;
		else if( damage < 750 ) result = HIR"总共有数百艘$T被击毁。\n"NOR;
		else if( damage < 1000 ) result = RED"总共有近千艘$T被击毁。\n"NOR;
		else result = RED"总共有难以计数的$T被击毁。\n"NOR;
		break;
	case "missile":
		if( damage < 5 ) result = HIC"总共有几艘$T被击毁。\n"NOR;
		else if( damage < 10 ) result = HIC"总共有不足十艘$T被击毁。\n"NOR;
		else if( damage < 20 ) result = HIC"总共有十几艘$T被击毁。\n"NOR;
		else if( damage < 60 ) result = HIY"总共有几十艘$T被击毁。\n"NOR;
		else if( damage < 100 ) result = HIY"总共有近百艘$T被击毁。\n"NOR;
		else if( damage < 200 ) result = YEL"总共有百余艘$T被击毁。\n"NOR;
		else if( damage < 500 ) result = YEL"总共有几百艘$T被击毁。\n"NOR;
		else if( damage < 750 ) result = HIR"总共有数百艘$T被击毁。\n"NOR;
		else if( damage < 1000 ) result = RED"总共有近千艘$T被击毁。\n"NOR;
		else result = RED"总共有难以计数的$T被击毁。\n"NOR;
		break;
	case "air_force":
		if( damage < 5 ) result = HIC"总共有几艘$T被击毁。\n"NOR;
		else if( damage < 10 ) result = HIC"总共有不足十艘$T被击毁。\n"NOR;
		else if( damage < 20 ) result = HIC"总共有十几艘$T被击毁。\n"NOR;
		else if( damage < 60 ) result = HIY"总共有几十艘$T被击毁。\n"NOR;
		else if( damage < 100 ) result = HIY"总共有近百艘$T被击毁。\n"NOR;
		else if( damage < 200 ) result = YEL"总共有百余艘$T被击毁。\n"NOR;
		else if( damage < 500 ) result = YEL"总共有几百艘$T被击毁。\n"NOR;
		else if( damage < 750 ) result = HIR"总共有数百艘$T被击毁。\n"NOR;
		else if( damage < 1000 ) result = RED"总共有近千艘$T被击毁。\n"NOR;
		else result = RED"总共有难以计数的$T被击毁。\n"NOR;
		break;
	default:
		if( damage < 5 ) result = HIC"结果有几艘$T被击毁。\n"NOR;
		else if( damage < 10 ) result = HIC"总共有不足十艘$T被击毁。\n"NOR;
		else if( damage < 20 ) result = HIC"结果有十几艘$T被击毁。\n"NOR;
		else if( damage < 60 ) result = HIY"总共有几十艘$T被击毁。\n"NOR;
		else if( damage < 100 ) result = HIY"结果有近百艘$T被击毁。\n"NOR;
		else if( damage < 200 ) result = YEL"总共有百余艘$T被击毁。\n"NOR;
		else if( damage < 500 ) result = YEL"结果有几百艘$T被击毁。\n"NOR;
		else if( damage < 750 ) result = HIR"总共有数百艘$T被击毁。\n"NOR;
		else if( damage < 1000 ) result = RED"结果有近千艘$T被击毁。\n"NOR;
		else result = RED"结果有难以计数的$T被击毁。\n"NOR;
/*		if( damage < 5 ) result = HIC"结果只$R几艘$T。\n"NOR;
		else if( damage < 10 ) result = HIC"结果只$R不足十艘$T。\n"NOR;
		else if( damage < 20 ) result = HIC"结果$R十几艘$T。\n"NOR;
		else if( damage < 60 ) result = HIY"结果$R几十艘$T。\n"NOR;
		else if( damage < 100 ) result = HIY"结果$R近百艘$T。\n"NOR;
		else if( damage < 200 ) result = YEL"结果$R百余艘$T。\n"NOR;
		else if( damage < 500 ) result = YEL"结果$R几百艘$T。\n"NOR;
		else if( damage < 750 ) result = HIR"结果$R数百艘$T。\n"NOR;
		else if( damage < 1000 ) result = RED"结果$R近千艘$T。\n"NOR;
		else result = RED"结果$R难以计数的$T。\n"NOR;
*/
	}
	return replace_string( result, "$T", shiptype );
}

string morale_space_msg(int ratio)
{
	if( ratio > 90 ) return HIG "的舰队阵形整齐划一，非常漂亮。" NOR;
	if( ratio > 80 ) return HIG "的舰队阵形看起来整齐，标准，所有舰船各司其位。" NOR;
	if( ratio > 70 ) return HIG "的舰队阵形比较整齐，舰船都努力保持自己的位置。" NOR;
	if( ratio > 60 ) return HIY "的舰队阵形还算是完整，只有少数舰船脱离了自己的位置。" NOR;
	if( ratio > 50 ) return HIY "的舰队阵形看起来有些松散，部分舰船被孤零零的甩在外面。" NOR;
	if( ratio > 40 ) return HIY "的舰队阵形比较松散，不少舰船盲目的四处行动。" NOR;
	if( ratio > 30 ) return HIR "的舰队阵形非常松散，不能有效战斗了。" NOR;
	if( ratio > 20 ) return HIR "的舰队阵形看起来有些混乱，马上就要溃散了。" NOR;
	if( ratio > 10 ) return RED "的舰队阵形非常混乱，已经接近溃散的边缘。" NOR;
	return RED "的舰队阵形混乱不堪，不需攻击也会马上溃散。" NOR;
}

string status_space_msg(int ratio)
{
	if( ratio >= 10000 ) return HIG "似乎布满了整块星域，庞大的光点群让人不寒而栗。" NOR;
	if( ratio >= 5000 ) return HIG "闪耀着无数的光点，很难正确的判断出舰队规模。" NOR;
	if( ratio >= 1000 ) return HIY "舰船数逾数千，此等舰队编制足以进行大规模的杀伤。" NOR;
	if( ratio >= 500 ) return HIY "舰船数目接近千艘，战力看上去仍不可随意小觑。" NOR;
	if( ratio >= 100 ) return HIY "舰船大约有数百艘，战力似乎并不十分强大。" NOR;
	if( ratio >= 50 ) return HIR "舰船数目接近百余，看上去的光点比较稀少。" NOR;
	if( ratio >= 10 ) return HIR "舰船总数不多，大概只有几十艘的样子。" NOR;
	if( ratio >= 5 ) return HIR "舰船数目不到十艘，难以抵挡哪怕是微弱的一下攻击。" NOR;
	return RED "几乎全军覆没，只余下最后的几艘战舰还在负隅顽抗。" NOR;
}


mixed combat_no_vision(object me,object victim)
{
	int x,y,i;
	object *inv,env,*result;

	result = ({});
	x = me->query_space("x-dir") + victim->query_space("x-dir");
	y = me->query_space("y-dir") + victim->query_space("y-dir");
	x = x/2;
	y = y/2;
	if( (env=environment(me)) != environment(victim) ) return;
	inv = all_inventory(env);

	for(i=0;i<sizeof(inv);i++)
		{
		if( !userp(inv[i]) ) continue;
		if( !distance(inv[i],x,y,inv[i]->query_space("scouting"))
			|| inv[i] == me
			|| inv[i] == victim )
			result += ({ inv[i] });
		}
	return result;
}

string report_space_status(object victim,int victim_usage)
{
	int moral,k;
	mapping fleet;

	fleet = query_usage_fleet(victim,victim_usage);
	moral = fleet["morale"];
	k = fleet["eff_amt"]*100/fleet["max_amt"];

	if( ( moral > 50) && ( k > 50 ) ) return "";

	return "( $D" + status_space_msg(fleet["eff_amt"]) + " )\n" + "( $D" + morale_space_msg(moral) + " )\n";
}

//计算攻/防指数，影响到能否击中敌军，以及伤害的大小
varargs int s_skill_power(object ob,int which,string attacktype,int att)
{
	int coefficient, level, power, attribute, exp;
	float morale;
	string formation;
	mapping usage_fleet;

//取出正在使用的阵型
	if( !( formation = ob->query_s_skill_mapped("formation") ) )
		formation = "formation";
//根据判断攻击或防御，分别取出
//阵型的攻、防加权
//人物的自身指数(胆识或沉着)
//相应技能有效等级
	if ( att )
	{
		coefficient = S_SKILL_D(formation)->att_coefficient();
		attribute = ob->query_cor() * 3;
		level = ob->query_s_skill(attacktype);
	}
	else
	{
		coefficient = S_SKILL_D(formation)->def_coefficient();
		attribute = ob->query_cps() * 3;
		level = ob->query_s_skill(attacktype);
		level += ob->query_s_skill("defending")*2;
		level = to_int(level/3);
	}

	exp = to_int( sqrt( to_float( ob->query_space("combat_exp") ) ) );
	power = ( level + attribute + (exp/4) ) * coefficient / 10;

//取出当前舰队的士气
	usage_fleet = query_usage_fleet(ob,which);
	morale = to_float( usage_fleet["morale"] );
	if( morale < 0 ) morale = 1;
	power = to_int( power * sqrt( morale ) ) / 10;

//判断当前舰队是否处于混乱状态，即enable数值
	if( !usage_fleet["enable"] )
		power /= 2;

	if ( power < 1 ) power = 1;
	return power;
}

int attack_reward(object me,string skill,int ap,int dp)
{
	string mapped;
	if( ap < dp )
	{
//		if( random( (dp-ap)/10 ) )
//		{
		me->add_space("combat_exp",1);
		me->improve_s_skill(skill,1,1);
		if( stringp(mapped = me->query_s_skill_mapped(skill)) )
			me->improve_s_skill(mapped,1,0);
		return 1;
//		}
//		return 0;
	}
	if( !random(ap-dp) ) me->add_space("combat_exp",1);
	return 0;
}

int defend_reward(object victim,string skill,int ap,int dp)
{
	string mapped;
	if( ap > dp )
	{
//		if( random((ap-dp)/10) )
//		{
		victim->add_space("combat_exp",1);
//		if( random(2) ) victim->improve_s_skill(skill,1,0);
//		else 
		victim->improve_s_skill("defending",1,1);
		if( stringp(mapped = victim->query_s_skill_mapped("defending")) )
			victim->improve_s_skill(mapped,1,0);
		else if( random(victim->query_int()) > 10 )
			victim->improve_s_skill(skill,1,1);
		return 1;
//		}
//		return 0;
	}
	if( !random(ap-dp) ) victim->add_space("combat_exp",1);
	return 0;
}

int do_space_attack(object ob, object victim,int ob_usage,int victim_usage)
{
	int ap, dp, damage, defend, cost, i;
	string skill, attacktype, ob_shiptype, victim_shiptype;
	string *limbs,limb;
	string attacker,defender;
	string result,report_ob,report_victim,report_all;
	mapping ob_usage_fleet,victim_usage_fleet;
	object *receiver;

	if( !ob || !victim ) return 0;
	if( environment(ob) != environment(victim) ) return 0;
	if( !environment(ob)->is_space_room() && !environment(ob)->is_planet()) return 0;
	if( !environment(victim)->is_space_room() && !environment(victim)->is_planet() ) return 0;
	if( !living(ob) || !living(victim) ) return 0;

	ob_usage_fleet = query_usage_fleet(ob,ob_usage);
	victim_usage_fleet = query_usage_fleet(victim,victim_usage);

	attacktype = ob_usage_fleet["attacktype"];
	ob_shiptype = ob_usage_fleet["shiptype"];
	victim_shiptype = victim_usage_fleet["shiptype"];

	if ( !query_base_beam(ob_shiptype)
		&& !query_base_missile(ob_shiptype)
		&& !query_base_air_force(ob_shiptype) )
		return 0;

	receiver = all_inventory(environment(ob));
	receiver -= combat_no_vision(ob,victim);
//write(sprintf("beam factor is %d\n",space_factor(ob,"beam")));
//write(sprintf("missile factor is %d\n",space_factor(ob,"missile")));
//write(sprintf("air_force factor is %d\n",space_factor(ob,"air_force")));
//write(sprintf("construction factor is %d\n",space_factor(ob,"con")));

	if( !ob_usage_fleet["enable"] )
	{
		tell_object(ob,HIR"旗舰通讯员：我军" + sprintf("第%s部队",chinese_number(ob_usage+1))
			+ "内部发生了混乱！无法进行有效的攻击与防御了！\n"NOR);
		message("vision",ob->space_short(1) + sprintf("第%s部队",chinese_number(ob_usage+1))
			+ confusion_msg[random(sizeof(confusion_msg))],
			receiver + ({ victim }),({}));
		return 0;
	}

	result = "\n";

	i = random(sizeof(attack_space_msg));



	switch(attacktype)
		{
		case "beam":
			if ( !query_base_beam(ob_shiptype) )
			{
				if( !userp(ob) ) ob_usage_fleet["attacktype"] = "missile";
				tell_object(ob,HIY"我军"+ sprintf("第%s部队",chinese_number(ob_usage+1))
					+ "司令官报告：“我部队舰艇没有主炮，正在防御状态，请司令官指示！”\n"NOR);
				message("vision",ob->space_short(1)
					+ guard_space_msg[random(sizeof(guard_space_msg))],
					receiver + ({ victim }),({}));
				return 0;
			}
			ap=s_skill_power(ob,ob_usage,attacktype,1);
			dp=s_skill_power(victim,victim_usage,attacktype,0);
			cost = query_base_beam(ob_shiptype)/5;
			if ( cost > ob_usage_fleet["energy"] ) 
			{
				if( !userp(ob) ) ob_usage_fleet["attacktype"] = "missile";
				tell_object(ob,HIY"我军"+ sprintf("第%s部队",chinese_number(ob_usage+1))
					+ "主炮能源告急！\n"NOR);
				message("vision",ob->space_short(1)
					+ guard_space_msg[random(sizeof(guard_space_msg))],
					receiver + ({ victim }),({}));
				return 0;
			}
			damage = ob_usage_fleet["eff_amt"] * ap
				* ( query_base_beam(ob_shiptype) + space_factor(ob,"beam") );
			ob_usage_fleet["energy"] -= cost;
			break;
		case "missile":
			if ( !query_base_missile(ob_shiptype) )
			{
				if( !userp(ob) ) ob_usage_fleet["attacktype"] = "air_force";
				tell_object(ob,HIY"我军"+ sprintf("第%s部队",chinese_number(ob_usage+1))
					+ "司令官报告：“我部队舰艇没有飞弹发射器，正在防御状态，请司令官指示！”\n"NOR);
				message("vision",ob->space_short(1)
					+ guard_space_msg[random(sizeof(guard_space_msg))],
					receiver + ({ victim }),({}));

				return 0;
			}
			ap=s_skill_power(ob,ob_usage,attacktype,1);
			dp=s_skill_power(victim,victim_usage,attacktype,0);
			cost = 2/*query_base_missile(ob_shiptype)/5*/;
			if ( ob_usage_fleet["missile"] < 1)
			{
//				ob_usage_fleet["attacktype"] = "beam";
				ob_usage_fleet["missile"] = 0;
				if( !userp(ob) ) ob_usage_fleet["attacktype"] = "air_force";
				tell_object(ob,HIY"我军" + sprintf("第%s部队",chinese_number(ob_usage+1))
					+ "司令官报告：“我部队飞弹耗尽了，请司令官指示！\n"NOR);
				message("vision",ob->space_short(1)
					+ guard_space_msg[random(sizeof(guard_space_msg))],
					receiver + ({ victim }),({}));
				return 0;
			}
			if ( ob_usage_fleet["missile"] < cost )
			{
				damage = ob_usage_fleet["eff_amt"] * ap
					* ( query_base_missile(ob_shiptype) + space_factor(ob,"missile") );
				ob_usage_fleet["missile"] = 0;
			}
			else
			{
				damage = ob_usage_fleet["eff_amt"] * ap * 2
					* ( query_base_missile(ob_shiptype) + space_factor(ob,"missile") );
				ob_usage_fleet["missile"] -= cost;
			}
			break;
		case "air_force":
			if ( !query_base_air_force(ob_shiptype) )
			{
				if( !userp(ob) ) ob_usage_fleet["attacktype"] = "beam";
				tell_object(ob,HIY"我军"+ sprintf("第%s部队",chinese_number(ob_usage+1))
					+ "司令官报告：“我部队不具备舰载艇发射能力，正在防御状态，请司令官指示！”\n"NOR);
				message("vision",ob->space_short(1)
					+ guard_space_msg[random(sizeof(guard_space_msg))],
					receiver + ({ victim }),({}));
				return 0;
			}
			ap=s_skill_power(ob,ob_usage,attacktype,1);
			dp=s_skill_power(victim,victim_usage,attacktype,0);
			if ( ob_usage_fleet["craft"] < 1 )
			{
//				ob_usage_fleet["attacktype"] = "beam";
				ob_usage_fleet["craft"] = 0;
				if( !userp(ob) ) ob_usage_fleet["attacktype"] = "beam";
				tell_object(ob,HIY"我军"+ sprintf("第%s部队",chinese_number(ob_usage+1))
					+ "司令官报告：“我部队舰载艇损失殆尽，请司令官指示！\n"NOR);
				message("vision",ob->space_short(1)
					+ guard_space_msg[random(sizeof(guard_space_msg))],
					receiver + ({ victim }),({}));
				return 0;
			}
			damage = ob_usage_fleet["eff_amt"] * ap
				* ( query_base_air_force(ob_shiptype) + space_factor(ob,"air_force") );
			cost = 5;
//change in future
			if ( cost > ob_usage_fleet["craft"] ) ob_usage_fleet["craft"] = 0;
			else ob_usage_fleet["craft"] -= cost;
			break;
		default:
			ob_usage_fleet["attacktype"] = "beam";
			attacktype = "beam";
			if ( !query_base_beam(ob_shiptype) )
			{
				if( !userp(ob) ) ob_usage_fleet["attacktype"] = "missile";
				tell_object(ob,HIY"我军"+ sprintf("第%s部队",chinese_number(ob_usage+1))
					+ "司令官报告：“我部队舰艇没有主炮，正在防御状态，请司令官指示！”\n"NOR);
				message("vision",ob->space_short(1)
					+ guard_space_msg[random(sizeof(guard_space_msg))],
					receiver + ({ victim }),({}));
				return 0;
			}
			ap=s_skill_power(ob,ob_usage,attacktype,1);
			dp=s_skill_power(victim,victim_usage,attacktype,0);
			cost = query_base_beam(ob_shiptype)/5;
			if ( cost > ob_usage_fleet["energy"] ) 
			{
				if( !userp(ob) ) ob_usage_fleet["attacktype"] = "missile";
				tell_object(ob,HIY"我军"+ sprintf("第%s部队",chinese_number(ob_usage+1))
					+ "主炮能源告急！\n"NOR);
				message("vision",ob->space_short(1)
					+ guard_space_msg[random(sizeof(guard_space_msg))],
					receiver + ({ victim }),({}));
				return 0;
			}
			damage = ob_usage_fleet["eff_amt"] * ap
				* ( query_base_beam(ob_shiptype) + space_factor(ob,"beam") );
			ob_usage_fleet["energy"] -= cost;
		}

	defend = ( query_base_con(victim_shiptype) + space_factor(ob,"con") ) * dp * 100;

	if( defend < 1 ) defend = 1;
	damage = damage/defend;
	if( damage > victim_usage_fleet["eff_amt"] )
		damage = victim_usage_fleet["eff_amt"];
	if( damage < 1 ) damage = 1;

//write(sprintf("Attacker is %O\nDefender is %O\n",ob,victim));
//write(sprintf("AP is %d,DP is %d.\n",ap,dp));
//write(sprintf("Cost is %d,Damage is %d\n",cost,damage));

	defender = victim->space_short(1);
	defender += sprintf("%s部队",chinese_number(victim_usage+1));
	attacker = ob->space_short(1);
	attacker += sprintf("%s部队",chinese_number(ob_usage+1));

	limbs = victim->query_space("limbs");
	limb = limbs[random(sizeof(limbs))];

	result += attack_space_msg[i];

	switch(attacktype)
	{
	   case "beam":
		result += "进行炮击。\n";
		break;
	   case "missile":
		result += "发射飞弹。\n";
		break;
	   case "air_force":
		result += "放出战斗艇。\n";
		break;
	   default:
		attacktype = "beam";
		result += "进行炮击。\n";
	}

//根据双方攻、防判断是否可以击中
	if( dp < ap )
	{
		if( random( dp/ap ) )
		{
			defend_reward(victim,attacktype,ap,dp);

			result += miss_space_msg[random(sizeof(miss_space_msg))];

			result = replace_string( result, "$L", limb );

			report_ob = replace_string( result, "$D", defender );
			report_ob = replace_string( report_ob, "$A", sprintf("我军第%s部队",
					chinese_number(ob_usage+1)) );

			report_all = replace_string( result, "$A", ob->space_short(1) );
			report_all = replace_string( report_all, "$D", victim->space_short(1) );

			report_victim = replace_string( result, "$D", sprintf("我军第%s部队",
					chinese_number(victim_usage+1)) );
			report_victim = replace_string( report_victim, "$A", attacker );

			tell_object(ob,report_ob);
			tell_object(victim,report_victim);
			message("vision", report_all, receiver, ({}) );

			return 0;
		}
	}

	if( victim_usage_fleet["eff_amt"] > 0 )
	{
		victim_usage_fleet["morale"] -= damage*50/victim_usage_fleet["eff_amt"];
		ob_usage_fleet["morale"] += damage*10/ob_usage_fleet["eff_amt"];
		victim_usage_fleet["eff_amt"] -= damage;
		ob->add_space_temp("history/" + victim_shiptype, damage);
	}

	attack_reward(ob,attacktype,ap,dp);
	victim->set_space_temp("last_damage_from",ob);

	result = replace_string( result, "$L", limb );

	report_victim = result + damage_space_msg(damage,attacktype,victim_shiptype);
	report_victim += report_space_status(victim,victim_usage);
	
	result += S_SKILL_D(attacktype)->query_msg();
	result += damage_space_msg(damage,attacktype,victim_shiptype);
	result += report_space_status(victim,victim_usage);

	report_ob = replace_string( result, "$D", defender );
	report_ob = replace_string( report_ob, "$A", sprintf("我军第%s部队",
			chinese_number(ob_usage+1)) );

	report_all = replace_string( result, "$A", ob->space_short(1) );
	report_all = replace_string( report_all, "$D", victim->space_short(1) );

	report_victim = replace_string( report_victim, "$D", sprintf("我军第%s部队",
				chinese_number(victim_usage+1)) );
	report_victim = replace_string( report_victim, "$A", attacker );

	tell_object(ob,report_ob);
	tell_object(victim,report_victim);
	message("vision", report_all, receiver, ({}) );

	return 1;
}

int combat(object ob, object victim)
{
	int ob_usage,victim_usage,i,attack_focus,success_attack;
	object last_againster;

	if( !ob || !victim ) return 0;
	if( environment(ob) != environment(victim) ) return 0;
	if( !environment(ob)->is_space_room() && !environment(ob)->is_planet()) return 0;
	if( !environment(victim)->is_space_room() && !environment(victim)->is_planet() ) return 0;
	if( !living(ob) || !living(victim) ) return 0;

	success_attack = 0;
	last_againster = ob->query_space_temp("last_againster");

	tell_object(ob,HIW"\n旗舰通讯员：“有以下来自各部队的战况报告！”\n"NOR);
	for(i=0;i<sizeof(ob->query_space("sub_fleet"));i++)
	{
		ob_usage = i;
		if( undefinedp(victim_usage = ob->query_space("attack_focus"))
			|| victim_usage > sizeof(victim->query_space("sub_fleet")) )
		victim_usage = random(sizeof(victim->query_space("sub_fleet"))) + 1;

		do_space_attack(ob,victim,ob_usage,victim_usage - 1);
		success_attack++;
	}
	if( success_attack ) return 1;
	return 0;
}

void start_combat(object ob, object victim)
{
	string result;
	int alpha,beta;

	if( !ob || !victim ) return;
	if( environment(ob) != environment(victim) ) return;
	if( !environment(ob)->is_space_room() ) return;
	if( !environment(victim)->is_space_room() ) return;
	if( !calculate_distance(ob,victim,ob->query_space("scouting")) ) return;

	ob->set_space_temp("prepare_to_combat", 0);

	if( ob->is_combating(victim) ) return;

	ob->combat_ob(victim);

	result = "\n警报！！！军事工作官报告：我军舰队遭到攻击！\n敌军";

	if( F_DISTANCE->calculate_distance(ob,victim,victim->query_space("scouting")) )
	{
		victim->combat_ob(ob);
		result += ob->space_short(1) + "，";
	}
	else result += "不明，";
	alpha = ob->query_space("x-dir") - victim->query_space("x-dir");
	beta = ob->query_space("y-dir") - victim->query_space("y-dir");

	if( !alpha && !beta ) result += "攻击近在咫尺！\n";
	else result += "部队受损来自" + POSITION_CMD->display_direction("",alpha,beta);

	tell_object( victim , HIR + result + "\n"NOR );
}

void auto_combat(object ob, object victim)
{
	string ob_vassalage,victim_vassalage;

	if( !userp(ob) && !userp(victim) ) return;
	if( !living(ob) || !living(victim) ) return;
	if( !calculate_distance(ob,victim,ob->query_space("scouting")) ) return;

	if( !stringp(victim_vassalage = victim->query_space("vassalage"))
		|| (victim_vassalage == "中立") )
	{
		if( ob->query("attitude") != "aggressive" ) return;
		if( ob->query_space_temp("prepare_to_combat") ) return;
		ob->set_space_temp("prepare_to_combat", 1);
		tell_object(ob,CYN"\n我军整合舰列，准备对" + victim->space_short(1) + "进行攻击！\n\n"NOR);
		call_out( "start_combat", 10, ob, victim);
	}
	else if( !stringp(ob_vassalage = ob->query_space("vassalage"))
		|| (ob_vassalage == "中立") )
	{
		if( ob->query("attitude") != "aggressive" ) return;
		if( ob->query_space_temp("prepare_to_combat") ) return;
		ob->set_space_temp("prepare_to_combat", 1);
		tell_object(ob,CYN"\n我军整合舰列，准备对" + victim->space_short(1) + "进行攻击！\n\n"NOR);
		call_out( "start_combat", 10, ob, victim);
	}
	else
	{
		if( ob_vassalage == victim_vassalage )
		{
			if( !victim->query("is_wanted") ) return;
			tell_object(ob,HIR"侦察舰队发现了被通缉的" + victim->name() + HIR"舰队的踪迹！\n"NOR);
		}
		else tell_object(ob,HIR"侦察舰队发现了" + victim->space_short(1) + HIR"的踪迹！\n"NOR);
		if( query_eff_amount(victim)/2 > query_eff_amount(ob) )
		{
			if( !random( 20 - ob->query_cps() ) )
			{
				tell_object(ob,HIY"但是面对较本舰队强大的敌军，似乎不应轻举妄动。\n"NOR);
				return;
			}
		}
		if( ob->query_space_temp("prepare_to_combat") ) return;
		ob->set_space_temp("prepare_to_combat", 1);
		tell_object(ob,CYN"\n我军整合舰列，准备对" + victim->space_short(1) + "进行攻击！\n\n"NOR);
		call_out( "start_combat", 10, ob, victim);
	}
}

void killer_reward(object killer, object victim)
{
	int exp, score, i, check, rank;
	mapping fleet;
	string report;

	killer->add_space("combat_win",1);
	killer->killed_enemy(victim);

	/*if( !userp(victim) )*/ killer->add("score",victim->query("score")/100);
	victim->add("score",-victim->query("score")/10);

	for(i=0;i<sizeof(killer->query_space("sub_fleet"));i++)
	{
		fleet = killer->query_sub_fleet(i);
		fleet["morale"] += random( fleet["morale"]/10 );
	}
	tell_object(killer,YEL"战斗的胜利鼓舞着舰队的每一位士兵！\n"NOR);

	if(mapp(killer->query_space("quest")))
	{
		mapping quest;
		if( interactive(killer)
			&& ( quest = killer->query_space("quest") )
			&& ( (int)killer->query_space("task_time") >= time() )
			&& ( victim->space_short(1) == quest["quest"] )
			&& !userp(victim) )
	        {
			exp = quest["exp_bonus"]/2 + random(quest["exp_bonus"]/2);
// put a limit on max exp we can get from a quest
			if( exp > 100) exp = 100;
			exp = exp * (int) killer->query_space_temp("quest_number");
			score = exp/ 15 + 1;
			killer->add_space("combat_exp", exp);
			killer->add("score", score);
			killer->delete_space("quest");
			killer->add_space_temp("quest_number");
			tell_object(killer,HIW"通过此次行动：\n你的实战经验上升" +
				chinese_number(exp) + "点\n你的功绩上升"+
				chinese_number(score) + "点\n"NOR);
		}
	}

	check = killer->query("score");
	rank = killer->query("rank");

	if( ( check > 100) && !rank ) killer->set("promoted",1);
	else if( ( check > 400 ) && ( rank < 2 ) ) killer->set("promoted",2);
	else if( ( check > 700) && ( rank < 3 ) ) killer->set("promoted",3);
	else if( ( check > 1000 ) && ( rank < 4 ) ) killer->set("promoted",4);
	else if( ( check > 4000 ) && ( rank < 5 ) ) killer->set("promoted",5);
	else if( ( check > 7000 ) && ( rank < 6 ) ) killer->set("promoted",6);
	else if( ( check > 10000 ) && ( rank < 7 ) ) killer->set("promoted",7);
	else if( ( check > 40000 ) && ( rank < 8 ) ) killer->set("promoted",8);
	else if( ( check > 700000 ) && ( rank < 9 ) ) killer->set("promoted",9);
	else if( ( check > 1000000 ) && ( rank < 10 ) ) killer->set("promoted",10);
	else if( ( check > 4000000 ) && ( rank < 11 ) ) killer->set("promoted",11);
	else if( ( check > 7000000 ) && ( rank < 12 ) ) killer->set("promoted",12);
	else if( ( check > 10000000 ) && ( rank < 13 )
		&& ( killer->query_space("vassalage") == "帝国" ) )
		killer->set("promoted",13);
		

	else killer->delete("promoted");

	if( killer->query("promoted") )
	{
		report = sprintf("鉴于在数次行动中的优异表现，现决定晋升%s\n            "
		"%s之官阶。特此通告！请回首都接受任命！\n",
		killer->query("title") ? killer->query("title"):"",
		killer->name(1) );
		CHANNEL_D->do_channel(this_object(),"report",report);
	}
}

void announce(object ob, object killer, string event)
{
	string flagship;

	flagship = ob->query_space("flagship") ? ob->query_space("flagship") : "";
	if( event == "space_die" )
	{
		tell_object(killer,HIM"
    敌旗舰" + flagship + "在最后的顽抗中被直接命中，核融合炉内部发生爆炸。\n"
+ "    闪光最初看来像是火球群，然而，立刻又重叠在一起，形成一道白亮、璀灿的
巨大光云，而舰艇则在云中炸裂四散，或者满载着舰员，或者把舰员抛向虚空，然
后沉入光芒的漩涡当中，最后在坠满繁星的黑幕中消失得无影无踪。。。。。\n\n"NOR);

		message("vision",HIM"
    敌旗舰" + flagship + "在最后的顽抗中被直接命中，核融合炉内部发生爆炸。\n"
+ "    闪光最初看来像是火球群，然而，立刻又重叠在一起，形成一道白亮、璀灿的
巨大光云，而舰艇则在云中炸裂四散，或者满载着舰员，或者把舰员抛向虚空，然
后沉入光芒的漩涡当中，最后在坠满繁星的黑幕中消失得无影无踪。。。。。\n\n"NOR,
environment(killer),combat_no_vision(ob,killer) );

		CHANNEL_D->do_channel(this_object(),"report",
			ob->space_short() + HIW"在" + environment(ob)->query("short") + HIW"被"
			+ killer->space_short() + "击败！\n"NOR);
		tell_object(ob,HIR"我军被击败了。\n"NOR);
	}
}