inherit SPACE_ROOM;

void create()
{
	set("short", "费沙星系");
	set("long", @LONG
银河系被充满巨星、矮星、变光星的一堵围墙划分为两大部分，
同盟和帝国各自掌管着属于他们的星系。时至今日，这两部分宙域仍
然只发现了两条可以贯通的狭长空间：其中一个是战略要地伊谢尔伦
长廊，而另一个就是费沙自治领。
LONG
	);

	set("exits", ([
		"+ +" : __DIR__"walhalla",
		"- +" : __DIR__"ballat",
	]) );

	set("objects", ([
		__DIR__"globe/phezzan" : 1,
		__DIR__"globe/npc/guard" : 1
	]) );

	setup();
}

void reset()
{
	object *inv;
	object con, item;
	::reset();
	con = present("phezzan", this_object());
        inv = all_inventory(con);
        if( !sizeof(inv) ) {
	item = new("/u/globe/obj/radar");
	item->move(con);
	}
}
