inherit SPACE_ROOM;

void create()
{
	set("short", "瓦尔哈拉星系");
	set("long", @LONG
这里是瓦尔哈拉星系，主星奥丁。
LONG
	);

	set("exits", ([
		"- +" : __DIR__"iserlohn",
		"- -" : __DIR__"phezzan",
	]) );

	set("objects", ([
        __DIR__"globe/odin" : 1,
	__DIR__"globe/npc/guard" : 1
	]) );

	setup();
}

