inherit SPACE_ROOM;

void create()
{
	set("short", "伊谢尔伦星系");
	set("long", @LONG
                边境星域---伊谢尔伦。
    变光星、红色巨星、异常的重力场……这一带是宇宙航行上的
「魔鬼三角」，是曾经使从前自由行星同盟的建国者们失去许多同
志的「宇宙坟场」。回廊中壮年期的恒星亚尔提那本是一颗孤独的
恒星,直到三十年前，银河帝国才在此处建设了伊谢尔伦要塞。
    如果由天顶方向俯瞰银河系，伊谢尔伦的位置正是银河帝国势
力范围向自由行星同盟方向延伸处构成的三角形地带的项点。
LONG
	);

	set("exits", ([
		"+ -" : __DIR__"walhalla",
		"- -" : __DIR__"ballat",
	]) );

	set("objects", ([
        __DIR__"globe/iserlohn" : 1,
	__DIR__"globe/npc/guard" : 1
	]) );

	setup();
}

