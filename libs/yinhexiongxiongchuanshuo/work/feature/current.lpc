#include <dbase.h>
#include <current.h>

//在CHAR中的heart_beat()里调用本函数可以顺序执行current列表中的命令行
nomask int process_current(object this)
{
	mapping my_current;
	string number,*cmd,skill;
	int nowip;

	my_current = this->query_entire_current_dbase();
	if( mapp(my_current) && (sizeof(my_current) > 2) )
	{
		nowip = my_current["nowip"];
	        if(nowip)
		{
			number = "cmd" + (string)nowip;
			cmd = my_current[number];

			if( stringp(skill = S_SKILL_D(cmd[0])) && sizeof(cmd) == 4 )
			{
//				if( sizeof(cmd) == 3 )
//					call_other(skill,cmd[1],this,cmd[2]);
//				else 
				call_other(skill,cmd[1],this,cmd[2],cmd[3]);
				if( nowip > 17 ) nowip=0;
				this->set_current("nowip",nowip+1);
				this->delete_current(number);
			}
			else
			{
				cmd[0] = "/cmds/space/" + cmd[0];
				if( sizeof(cmd) == 1) call_other(cmd[0], "sub_main", this);
				else call_other(cmd[0], "sub_main", this, cmd[1]);

				if( nowip > 17 ) nowip=0;
				this->set_current("nowip",nowip+1);
				this->delete_current(number);
			}
		}
		return 1;
	}
	return 0;
}

//此函数可以向current列表中加入新的项
nomask void add_command(object me,string *arg)
{
	string number;
	mapping commands;
	int finalip;

	if ( !pointerp(arg) ) return;

	commands = me->query_entire_current_dbase();
	if ( sizeof(commands) >= 20 )
		{write("Too many orders for your fleets to process!\n");return;}
	if ( sizeof(commands) == 0 )
	{
		me->set_current("cmd1",arg);
		me->set_current("nowip",1);
		me->set_current("finalip",2);
		return;
	}

	if( me->query_current("finalip") > 18 ) me->set_current("finalip",1);

	finalip = me->query_current("finalip");
	number = "cmd"+finalip;
	me->set_current(number,arg);
	me->add_current("finalip",1);
	return;
}

