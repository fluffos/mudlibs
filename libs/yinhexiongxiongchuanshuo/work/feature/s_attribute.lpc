mapping query_ship_ability(string shiptype)
{
        return ship_dbase[shiptype];
}

int query_base_con(string shiptype)
{
	mapping entire_ability;
	entire_ability = query_ship_ability(shiptype);
	return entire_ability["conlevel"];
}

int query_base_def(string shiptype)
{
	mapping entire_ability;
	entire_ability = query_ship_ability(shiptype);
	return entire_ability["deflevel"];
}

