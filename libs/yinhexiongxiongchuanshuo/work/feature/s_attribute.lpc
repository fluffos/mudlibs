//返回一个子舰队的mapping，which是me的哪个子舰队就返回哪个子舰队的mapping
mapping query_usage_fleet(object me,int which)
{
	mapping *all_sub_fleet;

	all_sub_fleet = me->query_space("sub_fleet");
	return all_sub_fleet[which];
}

//输入object返回这个object舰队的总体最大cargo
int query_max_cargo(object me)
{
	int i,max_cargo = 0;
	mapping *sub_fleets,fleet;

	sub_fleets = me->query_space("sub_fleet");
	for(i=0;i<sizeof(sub_fleets);i++)
	{
	fleet = sub_fleets[i];
	max_cargo += query_base_max_cargo(fleet["shiptype"])*fleet["eff_amt"];
	}
	return max_cargo;
}

//返回整个舰队的当前承载量
int query_cargo(object me)
{
	int i,*amount,cargo = 0;
	mapping in_cargo;

	in_cargo = me->query_space("in_cargo");
	amount = values(in_cargo);
	for(i=0;i<sizeof(in_cargo);i++)
	{
		cargo += amount[i];
	}
	return cargo;
}

//输入object返回这个object舰队的总体最大舰艇数
int query_max_amount(object me)
{
	int i,max_amount = 0;
	mapping *sub_fleets,fleet;

	sub_fleets = me->query_space("sub_fleet");
	for(i=0;i<sizeof(sub_fleets);i++)
	{
	fleet = sub_fleets[i];
	max_amount += fleet["max_amt"];
	}
	return max_amount;
}

//返回整个舰队的总舰船数
int query_eff_amount(object me)
{
	int i,amount;
	mapping *sub_fleets,fleet;

	sub_fleets = me->query_space("sub_fleet");
	for(i=0;i<sizeof(sub_fleets);i++)
	{
	fleet = sub_fleets[i];
	amount += fleet["eff_amt"];
	}
	return amount;
}

//返回舰队平均士气
int query_aver_morale(object me)
{
	int i,morale,div;
	mapping *sub_fleets,fleet;

	sub_fleets = me->query_space("sub_fleet");
	for(i=0;i<(div=sizeof(sub_fleets));i++)
	{
	fleet = sub_fleets[i];
	morale += fleet["morale"];
	}
	return morale/div;
}

//返回舰队有效速度
int query_eff_spd(object me)
{
	int i, spd, slowest;
	mapping *sub_fleets, fleet;

	sub_fleets = me->query_space("sub_fleet");
	if( !pointerp(sub_fleets) ) return 0;

	fleet = sub_fleets[0];
	slowest = query_base_spd(fleet["shiptype"]);

	for(i=0;i<sizeof(sub_fleets);i++)
	{
		fleet = sub_fleets[i];
		if ( slowest > query_base_spd(fleet["shiptype"]) )
			slowest = query_base_spd(fleet["shiptype"]);
		if( me->query_lea()*2 < query_base_ctrl(fleet["shiptype"]) )
			slowest *= me->query_lea()*2/query_base_ctrl(fleet["shiptype"]);
	}
	if( slowest < 10 ) slowest = 10;
	slowest += F_SPACEEQUIP->space_factor(me,"speed");
	return slowest/2;
}

