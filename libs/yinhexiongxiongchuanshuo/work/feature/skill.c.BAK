#include <ansi.h>
#include <dbase.h>

mapping skills;
mapping learned;
mapping skill_map;

//New Writen
mapping s_skills;
mapping s_learned;
mapping s_skill_map;

mapping query_s_skills() { return s_skills; }
mapping query_s_learned() { return s_learned; }

void set_s_skill(string skill, int val)
{
	//printf( "find_object(
	if ( !find_object( S_SKILL_D(skill) ) &&
		 file_size( S_SKILL_D(skill) + ".c" ) < 0 )
	{
		error("F_SKILL: No such skill (" + S_SKILL_D( skill ) + ")\n");
	}

	if ( !mapp( s_skills ) ) 
		s_skills = ([ skill: val ]);
	else 
		s_skills[ skill ] = val;
}

int delete_s_skill(string skill)
{
	if ( mapp(s_skills) ) 
	{
		map_delete( s_skills, skill );
		if ( mapp( s_learned ) ) 
		{
			map_delete( s_learned, skill );
			return undefinedp( s_learned[ skill ] );
		}
		return undefinedp( s_skills[ skill ] );
	}
	return 0;
}

varargs void map_s_skill(string skill, string mapped_to)
{
	if ( !mapped_to && mapp( s_skill_map ) ) 
	{
		map_delete( s_skill_map, skill );
		return;
	}

	if ( !find_object( S_SKILL_D(skill) ) &&
		 file_size( S_SKILL_D(skill) + ".c" ) < 0 )
	{
		error("F_SKILL: No such skill (" + skill + ")\n");
	}

	if ( !mapp(s_skills) || undefinedp( s_skills[ mapped_to ] ) )
		return;
		
	if ( !mapp(s_skill_map) ) 
		s_skill_map = ([ skill: mapped_to ]);
	else 
		s_skill_map[skill] = mapped_to;
}

string query_s_skill_mapped(string skill)
{
	if ( mapp(s_skill_map) && !undefinedp(s_skill_map[skill]) )
		return s_skill_map[skill];
	return 0;
}

varargs int query_s_skill(string skill, int raw)
{
	if( !raw )
	{
		int s=0 , level;
		s += query_space_temp("apply/" + skill);

		if( mapp(s_skills) )
		{
			s += s_skills[skill] / 2;

			if( mapp(s_skill_map) )
			{
				if( s_skill_map[skill] )
				level = S_SKILL_D(s_skill_map[skill])->efficient_level();
				else
				level = 0;
				s += s_skills[s_skill_map[skill]] * level / 10;
			}
		}
		return s;
	}

	if( mapp(s_skills) && !undefinedp(s_skills[skill]) )
		return s_skills[skill];

	return 0;

