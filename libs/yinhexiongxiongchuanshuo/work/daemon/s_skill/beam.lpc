inherit S_SKILL;

string *beam_msg = ({
	"光束与光束互相冲突，炫目的光彩漩涡涌起又碎落···\n",
	"在闪亮的放电当中，又一串新的闪光爆炸开来···\n",
	"数以千计的能源光束直飞过去，多彩的爆炸火光四处绽开···\n",
	"军舰阵绽放出眩目的花朵，旗舰释放出的能源波，震撼着周围的战舰！\n",
	"舰阵中，无数的光条穿过了宇宙，爆炸光在银幕上脉动；\n",
	"以黑暗的空间为背景，数万的光点在闪烁，敌舰群被七彩的光芒包围着..\n",
	"所有主炮喷出烈电,交织成白色的光幕，整个宙域都震颤着···\n",
	"集中发射的荷电粒子光束，饱和地奔向敌舰队所在宙域!!\n",
	"核融合炉爆炸所散射的能源, 冲破了中和磁场, 直接冲击着敌军的舰体··\n",
	"射入舰内的中子弹头爆炸时掀起了杀人的粒子狂涛，无情地席卷着一切··\n",
	"对方已经沐浴在能量光束及铀238高速弹之下··\n",
	"尽管爆炸光量已经在调整之中，但是整个萤幕仍然充满了像是脉搏般跳动的白浊光芒。\n",
	"铀２３８炮弹的火线在虚空中织出死亡的刺绣！\n",
	"永恒的黑夜被彩色的刀刃切割成无数细片；那一片片的漆黑，贪婪地吸取着无数人的生命。··\n",
});

string query_msg()
{
	return beam_msg[random(sizeof(beam_msg))];
}

int valid_learn(object me) { return 1; }