inherit S_SKILL;

string *air_force_msg = ({
	"空中战斗艇的战斗就这样开始了，交叉发射的炮火到处乱飞··\n",
	"战斗艇已将敌军的舰艇引诱至己方火力网中!\n",
	"战斗艇群先是与追踪者缠斗，然后朝着敌人的战舰奔驰在宇宙中。\n",
	"数只战斗艇一跃而出，紧急低飞，在敌舰的上空俯冲袭至··\n",
	"从天而降的能源之剑撕扯着敌军，流出来不是血，而是能源；飞散的不是肉，而是装甲板。\n",
	"机体擦过了战舰产生摩擦的火花，驾驶员从龟裂的机体中被吸向宇宙的深渊···\n",
	"无畏的战斗艇从正面撞进战舰的装甲，化成一团杂色的火球四散迸裂··\n",
	"战斗艇大肆杀戮之后，迅即提高速度脱离。有些被弹击中的失去控制，撞向敌舰爆炸开来。\n",
//	"此时这些飞行员的血液完全处于兴奋的状态下，他们根本就想不到自己是在杀人。\n",
	"在激烈的射击后，击落的飞机都在极高的速度中坠进了一片无限虚空··\n",
});

string query_msg()
{
	return air_force_msg[random(sizeof(air_force_msg))];
}

int valid_learn(object me) { return 1; }