// modify by unix
#include <weapon.h>
#include <ansi.h>
#include <login.h>
inherit NPC;
int time=0;
void create()
{
        set_name(this_player()->name(),({"cd-3"}));
        set("long", @LONG
ｔｈｉｓ  ｉｓ  ａ  ｔｏｐ  ｍｕｓｉｃ  ｃｄ\n
原唱：范晓萱          主唱："+this_player()->name()+"\n\n",users());
LONG);
        set("attitude", "friendly");
        setup();
        set_heart_beat(1);
}
void init()
{
        add_action("do_start", "start");
        add_action("do_stop", "stop");
}
void heart_beat()
{
object ob;
        this_object()->set_temp("sing", 1);
        this_player()->set_temp("sing",1);
        time++;
        if(time==1)
{
        message("system", HIC""+this_player()->name()+HIR"羞嗒嗒的说：\n\n"+
HIW"    下面我为大家献上一首歌<<心太软>>希望大家喜欢
        \n"+"   想听(music)否则可以(tune music)\n"
NOR,users());
}
        if(time==3)
        {
        CHANNEL_D->do_channel(this_object(), "music",
HIC""
+this_player()->name()+HIR"小声唱道：\n"+
HIY"\n你总是心太软，心太软\n\n把所有问题都让我扛\n"NOR);
        }
        if(time==6)
        {
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIB"放开嗓门唱道：\n"+
HIY"\n相爱总是简单相处太难\n\n不是你的就别再勉强\n"NOR);
        }
        if(time==9)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"温柔的唱着：\n"+
HIY"\n夜深了你还不想入睡...\n\n你还再想着他吗？\n"NOR);
}
        if(time==12)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"继续唱道：\n"+
HIY"\n你这样痴情到低累不累...\n\n明知他不会回来安慰...\n"NOR);
}
        if(time==15)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+"唱完对大家深鞠一躬说：快鼓掌啊！\n"NOR);
        this_object()->set_temp("sing", 0);
        this_player()->set_temp("sing", 0);
destruct(this_object());
}
}

