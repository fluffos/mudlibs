// modify by Apollo
#include <weapon.h>
#include <ansi.h>
#include <login.h>
inherit NPC;
int time=0;
//void init_data ();
void create()
{
        set_name(this_player()->name(),({"cd-2"}));
        set("long", @LONG
ｔｈｉｓ  ｉｓ  ａ  ｔｏｐ  ｍｕｓｉｃ  ｃｄ\n
LONG);
        set("attitude", "friendly");
        setup();
        set_heart_beat(1);
}
void init()
{
        add_action("do_start", "start");
        add_action("do_stop", "stop");
}
void heart_beat()
{
object ob;
        this_object()->set_temp("sing", 1);
        this_player()->set_temp("sing",1);
        time++;
        if(time==1)
{
        message("system", HIC""+this_player()->name()+HIR"
        羞嗒嗒的说：下面我为大家演唱一首\n\n"+
HIW"            <<我想我是海>>"NOR
HIW"希望大家喜欢\n"NOR+
HIW"    想欣赏的请大开(music)否则可以(tune music)\n"
NOR,users());
}
        if(time==3)
        {
        CHANNEL_D->do_channel(this_object(), "music",
HIC""
+this_player()->name()+HIR"小声唱道：\n"+
HIY"\n我的心像软的沙滩，留着步履凌乱 \n\n偶尔有些悲欢，总是去而复返 \n"NOR);
        }
        if(time==6)
        {
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"痴痴地唱道：\n"+
HIY"\n人越成长 彼此想了解似乎越难 \n\n人太敏感 活得虽丰富却烦乱 \n"NOR);
        }
        if(time==9)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"温柔的唱着：\n"+
HIY"\n有谁孤单却不祈盼，一个梦想的伴 \n\n相依相偎相知，爱得又美又暖\n"NOR);
}
        if(time==12)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"继续唱道：\n"+
HIY"\n没人分享，再多的成就都不圆满\n\n没人安慰，苦过了还是酸 \n"NOR);
}
        if(time==15)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"深情地唱道：\n"+
HIY"\n我想我是海 冬天的大海，心情随风轻摆 \n\n潮起的期待 潮落的无奈，眉头就皱了起来  \n"NOR);
}
        if(time==18)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"高声唱道：\n"+
HIY"\n我想我是海 宁静的深海，不是谁都明白 \n\n胸怀被敲开 一颗小石块，都可以让我澎湃 \n"NOR);
}
        if(time==21)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"最后高歌\n"+
HIY"\n胸怀被敲开 一颗小石块，都可以让我澎湃\n\n啦啦啦．．．啦．．啦．．．．\n"NOR);
        this_object()->set_temp("sing", 0);
        this_player()->set_temp("sing", 0);
destruct(this_object());
}
}

