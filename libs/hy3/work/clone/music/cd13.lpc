// modify by Apollo
#include <weapon.h>
#include <ansi.h>
#include <login.h>
inherit NPC;
int time = 0;
//void init_data ();
void create() {
  set_name(this_player()->name(), ({ "cd-12" }));
  set("long", @LONG
ｔｈｉｓ  ｉｓ  ａ  ｔｏｐ  ｍｕｓｉｃ  ｃｄ\n
LONG);
  set("attitude", "friendly");
  setup();
  set_heart_beat(1);
}
void init() {
  add_action("do_start", "start");
  add_action("do_stop", "stop");
}
void heart_beat() {
  object ob;
  this_object()->set_temp("sing", 1);
  this_player()->set_temp("sing", 1);
  time++;
  if (time == 1) {
    message("system", HIC "" + this_player()->name() + HIR "
        羞嗒嗒的说：下面我为大家演唱一首\n\n" +
      HIW "            <<世间始终你好>>" NOR
      HIW "希望大家喜欢\n" NOR +
      HIW "    想欣赏的请大开(music)否则可以(tune music)\n"
      NOR, users());
  }
  if (time == 3) {
    CHANNEL_D->do_channel(this_object(), "music",
      HIC ""
      +this_player()->name() + HIR "雄壮地唱道：\n" +
      HIY "\n问世间，是否此山最高 \n\n或者，另有高处比天高 \n" NOR);
  }
  if (time == 6) {
    CHANNEL_D->do_channel(this_object(), "music",
      HIG "" + this_player()->name() + HIR "痴痴地唱道：\n" +
      HIY "\n在世间，自有山比此山更高 \n\n但爱心，找不到比你好 \n" NOR);
  }
  if (time == 9) {
    CHANNEL_D->do_channel(this_object(), "music",
      HIG "" + this_player()->name() + HIR "温柔的唱着：\n" +
      HIY "\n一山还比一山高 \n\n啦啦。。啦。。。\n" NOR);
  }
  if (time == 12) {
    CHANNEL_D->do_channel(this_object(), "music",
      HIG "" + this_player()->name() + HIR "继续唱道：\n" +
      HIY "\n真爱有如天高，千百样好\n\n千百样好 \n" NOR);
  }
  if (time == 15) {
    CHANNEL_D->do_channel(this_object(), "music",
      HIG "" + this_player()->name() + HIR "深情地唱道：\n" +
      HIY "\n论武功，俗世中不知边个高 \n\n或者，绝招同途异路  \n" NOR);
  }
  if (time == 18) {
    CHANNEL_D->do_channel(this_object(), "music",
      HIG "" + this_player()->name() + HIR "高声唱道：\n" +
      HIY "\n但我知 \n\n论爱心找不到更好 \n" NOR);
  }
  if (time == 21) {
    CHANNEL_D->do_channel(this_object(), "music",
      HIG "" + this_player()->name() + HIR "最后高歌\n" +
      HIY "\n待我心\n\n世间始终你好\n" NOR);
    this_object()->set_temp("sing", 0);
    this_player()->set_temp("sing", 0);
    destruct(this_object());
  }
}
