// modify by Apollo
#include <weapon.h>
#include <ansi.h>
#include <login.h>
inherit NPC;
int time=0;
//void init_data ();
void create()
{
        set_name(this_player()->name(),({"cd-2"}));
        set("long", @LONG
ｔｈｉｓ  ｉｓ  ａ  ｔｏｐ  ｍｕｓｉｃ  ｃｄ\n
LONG);
        set("attitude", "friendly");
        setup();
        set_heart_beat(1);
}
void init()
{
        add_action("do_start", "start");
        add_action("do_stop", "stop");
}
void heart_beat()
{
object ob;
        this_object()->set_temp("sing", 1);
        this_player()->set_temp("sing",1);
        time++;
        if(time==1)
{
        message("system", HIC""+this_player()->name()+HIR"
        羞嗒嗒的说：下面我为大家演唱一首\n\n"+
HIW"            <<铁血丹心>>"NOR
HIW"希望大家喜欢\n"NOR+
HIW"    想欣赏的请大开(music)否则可以(tune music)\n"
NOR,users());
}
        if(time==3)
        {
        CHANNEL_D->do_channel(this_object(), "music",
HIC""
+this_player()->name()+HIR"柔情地唱道：\n"+
HIY"\n依稀往梦似曾见，心内波澜现 \n\n抛开世事断仇怨，相伴到天边 \n"NOR);
        }
        if(time==6)
        {
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"痴痴地唱道：\n"+
HIY"\n逐草四方沙漠苍茫，哪恨雪霜扑面 \n\n射雕引弓塞外奔驰，笑傲此生无缱倦 \n"NOR);
        }
        if(time==9)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"温柔的唱着：\n"+
HIY"\n天苍苍 野茫茫\n\n应知爱意似流水 \n"NOR);
}
        if(time==12)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"继续唱道：\n"+
HIY"\n万般变换\n\n万般变换 \n"NOR);
}
        if(time==15)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"深情地唱道：\n"+
HIY"\n身经百劫也在心间 \n\n恩义两难断  \n"NOR);
}
        if(time==18)
{
        CHANNEL_D->do_channel(this_object(), "music",
HIG""+this_player()->name()+HIR"高声唱道：\n"+
HIY"\n身经百劫也在心间 \n\n恩义两难断 \n"NOR);
        this_object()->set_temp("sing", 0);
        this_player()->set_temp("sing", 0);
destruct(this_object());
}
}

