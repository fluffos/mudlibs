// baowu.c
// by smash
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIG "宝物" NOR, ({ "bao wu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "你挖出来的宝物，不知道有什么作用。\n");
    set("unit", "个");
    set("value", 0);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_steal", 1);
    set("no_put", 1);
  }
  setup();
  call_out("destruct_me", 10);
}

int init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  object me = this_player();
  int i = random(3);

  if (arg == "bao wu") {
    message_vision(HIW "$N小心翼翼的将宝物打开。\n" NOR, me);
    if (i == 0) {
      tell_object(me, HIW "哇，好神奇，你的经验增加了。\n" NOR);
      me->add("combat_exp", 100 + random(50));
    } else if (i == 1) {
      tell_object(me, HIW "哇，好神奇，你的潜能增加了。\n" NOR);
      me->add("potential", 100 + random(50));
    } else {
      tell_object(me,
        HIM "老板看你挖的好辛苦，可是好象什么都没奖励你！\n");
    }
  }
  remove_call_out("destruct_me");
  destruct(this_object());
  return 1;
}

void destruct_me() {
  destruct(this_object());
  return;
}
