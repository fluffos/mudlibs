// /clone/board/wiz_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("自动留言电话", ({ "board" }) );
        set("location", "/u/mini/workroom");
        set("board_id", "wizm_b");
        set("long", "这是一个专供大家找甄小玉的电话。\n" );
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}

