// /clone/board/kedian_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIC "客店留言板" NOR, ({ "kdboard" }));
  set("location", "/d/city/kedian");
  set("board_id", "kd_b");
  set("long", "有有用的话就往这里说，乱灌水杀无赦。\n");
  setup();
  set("capacity", 1000);
  replace_program(BULLETIN_BOARD);
}
