#include <ansi.h>

inherit BULLETIN_BOARD;

void create() {
  set_name(HIR "新闻留言簿" NOR, ({ "board" }));
  set("location", "/d/wizard/news_room");
  set("board_id", "news_b");
  set("long", "这是一个专供发布新闻使用的留言板。\n");
  setup();
  set("capacity", 300);
}

void init() {
  ::init();
  add_action("do_meet", "meet");
}

int do_meet() {
  object *ob = objects();
  int i = sizeof(ob);
  if (!wizardp(this_player())) return notify_fail("你沒有權力使用 MEET 命令！\n");


  message_vision("$N按动机关召集巫师。\n", this_player());
  while (i--)
    if (userp(ob[i]) && wiz_level(ob[i])
      && !present(ob[i], environment())) {
      ob[i]->move(environment());
      message_vision("$N稀里糊涂地被扔了过来。\n", ob[i]);
    }
  shout("由" + HIY + (string)this_player()->query("name") + NOR "決定，現在全體巫師開會！\n");
  write("由" + HIY + (string)this_player()->query("name") + NOR "決定，現在全體巫師開會！\n");
  return 1;
}
