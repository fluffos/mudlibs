// /clone/board/wumaio_b.c

inherit BULLETIN_BOARD;
#include <ansi.h>
void create() {
  set_name(HIG "火云江湖留言板" NOR, ({ "wumaio_board" }));
  set("location", "/d/city/wumiao");
  set("board_id", "wumaio_b");
  set("long", "有有用的话就往这里说，乱灌水杀无赦。\n");
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
