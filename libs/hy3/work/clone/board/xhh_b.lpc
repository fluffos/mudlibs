// wiz_b.c

inherit BULLETIN_BOARD;
#include <ansi.h>

void create() {
  set_name(HIC "小混的留言本" NOR, ({ "xhh_board" }));
  set("location", "/u/xhh/workroom");
  set("board_id", "xhh_b");
  set("long", HIY "这是小混的留言本，你有什么事请写在这\n" NOR);
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
