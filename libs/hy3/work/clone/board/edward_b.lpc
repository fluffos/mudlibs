// wiz_b.c

inherit BULLETIN_BOARD;
#include <ansi.h>

void create()
{
        set_name(HIC"胡葳城留言簿"NOR, ({ "edward_board" }) );
        set("location", "/u/edward/workroom");
        set("board_id", "edward_b");
        set("long", HIY"这是胡葳城的留言本，你有什么事请写在这\n" NOR);
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}


