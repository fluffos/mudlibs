// card.c
#include <ansi.h>;
#include <command.h>;
inherit ITEM;

void create() {
  set_name(HIG "国庆礼物盒" NOR, ({ "he-zi" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "盒");
    set("long",
      "这是一盒装了希望之光WIZ国庆节送给玩家们礼物。你可以打开(dakai)来看看。\n");
    set("value", 0);
    set_weight(10);
  }
  setup();
}
void init() {
  add_action("do_dakai", "dakai");
}

int do_dakai(string arg) {
  object obj0, obj1, obj2, obj3, obj4, obj5, obj6, obj7, obj8;
  object me = this_player();
  int col;

  if (!arg || arg != "he-zi") return notify_fail("你要打开什么？\n");

  if (arg == "he-zi") {
    message_vision(HIR "$N充满憧憬地拆开了国庆礼物盒，突然出现了一些让人激动的礼物。\n" NOR, me);

    if (random(5) == 1) {
      obj0 = new("/d/city/obj/bing5");
      obj0->move(me);
    }
    if (random(4) == 1) {
      obj5 = new("/d/city/obj/bing4");
      obj5->move(me);
    }
    if (random(3) == 1) {
      obj6 = new("/d/city/obj/bing3");
      obj6->move(me);
    }
    if (random(2) == 1) {
      obj7 = new("/d/city/obj/bing2");
      obj7->move(me);
    }
    if (random(2) == 1) {
      obj8 = new("/d/city/obj/bing1");
      obj8->move(me);
    }
    if (random(7) == 1) {
      obj1 = new("/d/city/obj/bing6");
      obj1->move(me);
    }
    if (random(2) == 1) {
      obj2 = new("/clone/money/thousand-cash");
      obj2->move(me);
    }
    if (random(2) == 1) {
      obj3 = new("/clone/money/gold");
      obj3->move(me);
    }
    obj3 = new("/clone/money/thousand-cash");
    obj3->move(me);
    destruct(this_object());
  }
  return 1;
}
