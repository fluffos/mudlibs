// 九转金丹

#include <ansi.h>

inherit ITEM;

void setup() {}

void init() {
  if (!wizardp(this_player())) {
    set("no_give", "这么珍贵的药，哪能随便给人？\n");
    set("no_drop", "这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
    set("no_put", "");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name("九转金丹", ({ "jiuzhuan jindan", "jindan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗晶莹如玉的九转金丹，他看起来好像是神仙才能有的东西。\n");
    set("value", 500000);
    set("unique", 1);
  }
  setup();
}

int do_eat(string arg) {
  int force_limit, neili_limit, force_skill;

  object me = this_player();

  force_limit = me->query_skill("force") * 10;
  neili_limit = me->query("max_neili");
  force_skill = me->query_skill("force", 1);

  if (!id(arg))
    return notify_fail("你要吃什么？\n");


  if ((int)me->query_condition("bonze_drug") > 0) {
    me->add("max_neili", -50);
    message_vision(HIR "$N将九转金丹嚼碎了咽到肚中，脸色突然转绿，一下跌倒在地！\n" NOR, me);
    tell_object(me, HIB "你腹中如同刀搅一般难受，痛的你在地下直打滚！\n\n" NOR);
  } else if (neili_limit <= force_limit) {

    me->add("max_neili", 50);
    me->add("neili", 50);

    message_vision(HIR "$N将九转金丹嚼碎了咽到肚中，脸色突然转绿，一下跌倒在地！\n" NOR, me);
    tell_object(me, HIB "你腹中如同刀搅一般难受，痛的你在地下直打滚！\n\n" NOR);
    message_vision(HIG "过了一阵，$N头上冒出淡淡的紫气，又神采奕奕的站了起来。\n" NOR, me);
    me->apply_condition("bonze_drug", 1000);
  }

  //        me->unconcious();
  destruct(this_object());
  return 1;
}
