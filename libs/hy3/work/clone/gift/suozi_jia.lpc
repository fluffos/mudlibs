#include <ansi.h>
#include <armor.h>
inherit ARMOR;
void create()
{
        set_name(HIY"黄金索子甲"NOR, ({ "suozi jia", "jia" }));
        set_weight(2000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long",HIY"这是一件黄金镶片打造的索子甲，亮闪闪地十分好看。\n");
                set("material", "cloth");
                set("unit", "件");
                set("no_steal", 1);
                set("no_drop",1);
                set("no_put", 1);
                set("value", 70000);  
                set("wear_msg",HIY"$N“哗”地一声披上一件黄金索子甲。\n"NOR);
                set("unequip_msg", HIY"$N“哗”地将黄金索子甲脱了下来。\n"NOR);
                set("armor_prop/armor", 200);
        }
        setup();
}

