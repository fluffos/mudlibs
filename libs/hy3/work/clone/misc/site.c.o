// transite.c
 
inherit ITEM;
 
void create()
{
    set_name("魔法传送贴", ({ "trans site", "trans", "site" }) );
      set_weight(100);
    set("long", @LONG
这是一张魔法传送站，可以瞬间把你传送到你希望到达
的地方。对于十七岁后的成年人毫无用处了！
使用方法：    trans < 要到达的目的地 >
 (例如： trans gc)
以你目前的魔力可以到达这些地方 ：
 
 gc (中央广场)    qz (泉州)      bj  (北京)
 xj (新疆)        dl (大理)      ny  (南阳)
 xy (逍遥派)      hs (华山派)    wd  (武当派)
 kl (昆仑派)      hh (浣花剑派)  qzj (全真教)
 bt (白驼山)      em (峨眉山)    ts  (泰山)
 mj (明教)        sl (少林寺)    xs  (雪山寺)
 ss (杀手楼)      lj (灵鹫宫)    xx  (星宿海)
 
LONG
  );
    set("unit", "张");
            set("value", 10000);
}

void init()
{
// nodify by iiooppq
//    if(this_player()->query("mud_age") < 86400 || wizardp(environment())){
//    add_action("do_trans", "trans");
//    }
  add_action("do_trans", "trans");
}

int do_trans(string arg)
{
    int i;
    string obj, msg;
    object me=this_player(),*inv;
    
  if( me->query("age")>18 ) return notify_fail("那是小孩子的把戏，你已经不适合了。\n");

    if( !arg )
        return notify_fail("你想传送到哪里 ？\n");

    if(this_player()->query_temp("sleeping") )
         return notify_fail("睡觉都能用魔法，真是厉害！\n");

    if( this_player()->is_fighting() )
        return notify_fail("你正在战斗，无法使用此传送魔法！\n");

    if(!environment(this_player())->query("outdoors") )
         return notify_fail("在"+environment(me)->query("short")+"无法使用传送魔法！\n");

    if(present("biao yin", this_player()) )
         return notify_fail("你身上带着镖银，无法使用此传送魔法！\n");

    inv = all_inventory(me);
    for(i=0;i<sizeof(inv);i++)
         if(inv[i]->is_character())
            return notify_fail("你背着"+inv[i]->query("name")+"无法穿越时空!\n");

    switch(arg) {
        case "gc":
             obj="/d/city/guangchang";
             break;
        case "bj":
             obj="/d/city2/tian_anm";
             break;
        case "qz":
             obj="/d/quanzhou/zhongxin";
             break;
        case "xj":
             obj="/d/xingxiu/beijiang";
             break;
        case "hs":
             obj="/d/huashan/square";
             break;
        case "lj":
             obj="/d/lingjiu/damen";
             break;
        case "dl":
             obj="/d/dali/center";
             break;
        case "xy":
             obj="/d/xiaoyao/qingcaop";
             break;
        case "bt":
             obj="/d/baituo/liangong";
             break;
        case "wd":
             obj="/d/wudang/guangchang";
             break;
        case "em":
             obj="/d/emei/shijie3";
             break;
        case "mj":
             obj="/d/mj/shanmen";
             break;
        case "sl":
             obj="/d/shaolin/guangchang1";
             break;
        case "ts":
             obj="/d/taishan/daizong";
             break;
        case "ny":
             obj="/d/shaolin/nanyang";
             break;
        case "xx":
             obj="/d/xingxiu/xxh1";
             break;
        case "xs":
             obj="/d/xueshan/shanmen";
             break;
        case "hh": 
             obj="/d/huanhua/guanyuge";      
             break;
        case "ss":
             obj="/d/shashou/jiaochang"; 
             break;   
        case "qzj":
             obj="/d/quanzhen/shanmen"; 
             break;   
        case "kl":
             obj="/d/kunlun/shanmen"; 
             break;   
             default:
             return notify_fail("你不能传送到那个地方 !\n");
             return 1;

    }
    if( stringp(msg = this_player()->query("env/msg_mout")) )
        message_vision(msg+"\n", this_player());
    else
         message_vision("只见一阵烟雾过後，$N的身影已经不见了。\n", this_player());

    this_player()->move(obj);

        if( stringp(msg = this_player()->query("env/msg_min")) )
                message_vision(msg+"\n", this_player());
        else
                message_vision("$N的身影突然出现在一阵烟雾之中。\n", this_player());

    if( !wizardp(me) ) this_player()->receive_damage("jing",15);

    return 1;
}

