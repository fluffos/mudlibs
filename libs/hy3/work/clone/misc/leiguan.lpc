#include <ansi.h>

inherit ITEM;

void create() {
  set_name("雷管", ({ "lei guan", "guan", "lei" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一捆里面装有火药的管子，专门用来爆破作业。\n");
    set("unit", "捆");
    set("material", "guan");
    set("value", 0);
  }
  setup();
}
