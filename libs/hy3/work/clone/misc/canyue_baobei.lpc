inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIM "残" HIW "月" HIY "宝" HIB "贝" NOR, ({ "canyue baobei", "baobei" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      HIY "一本绚丽夺目闪闪发光的小册子，读读(read)看吧？" NOR);
    set("material", "paper");
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("value", 0);
  }
  setup();
}

void init() {
  add_action("do_read", "read");
}

int do_read(string arg) {
  object me = this_player();

  if (!arg) return 0;
  else if (arg == "baobei" || arg == "canyue baobei") {
    write(HIW "残月宝贝——共三篇，第一篇“菜鸟生存篇”，用read cainiao "
      + "进行\n阅读；第二篇——“新手任务篇” ，用read xinshou 进行阅读；"
      + "第三篇：\n“火云密闻篇”，用read miwen 进行阅读。\n" NOR);
    return 1;
  } else if (arg == "cainiao") {
    me->command("help cainiao");
    return 1;
  } else if (arg == "xinshou") {
    me->command("help xinshou");
    return 1;
  } else if (arg == "miwen") {
    me->command("help miwen");
    return 1;
  } else {
    write("你要读什么？\n");
    return 0;
  }
}
