#include <ansi.h>

inherit ITEM;

void create()
{
     set_name("大石", ({ "big stone", "stone" }));
     set_weight(50000);
     if( clonep() )
            set_default_object(__FILE__);
     else {
            set("long", "一块刚从山中采出来的大石头。\n");
            set("unit", "块");
            set("material", "stone");
            set("value", 0);
          }
     setup();
}

