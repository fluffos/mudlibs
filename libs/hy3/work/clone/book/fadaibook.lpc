// fadaibook.c
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(YEL "发呆神经" NOR, ({ "fadai jing", "fadai", "jing" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "想要发呆人读的经书。\n");
    set("value", 50000);
    set("material", "paper");
    set("skill",
      ([
        "name": "fadai-qigong",      // name of the skill
        "exp_required": 10,      // minimum combat experience required
        "jing_cost": 10,      // jing cost every time study this
        "difficulty": 15,      // the base int to learn this skill
        "max_skill": 49,      // the maximum level you can learn
        "min_skill": 20,      // minimun level required
      ]));
  }
}
