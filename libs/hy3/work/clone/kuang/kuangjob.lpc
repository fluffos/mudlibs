// work.c 

inherit ROOM;

int cot;
void create() {
  set("short", "矿场");
  set("long", @LONG
  这是就是山西矿场了，只见到处都是挖矿工,一个一个正在辛勤的挖
，挖，挖，大家一起来使劲挖！
LONG
  );
  set("no_sleep_room", 1);
  set("no_die", 1);
  set("no_fight", 1);
  set("no_beg", 1);
  set("no_steal", 1);
  set("exits", ([
    "north": "/d/xingxiu/xxroad1",
  ]));

  set("no_magic", 1);
  set("coor/x", 30);
  set("coor/y", -10);
  set("coor/z", 0);
  setup();
}
void init() {
  add_action("do_dig", "dig");
  if (!wizardp(this_user()))
    add_action(
      "discmds",
      ({
        "duanlian",
        "ansuan",
        "touxi",
        "persuade",
        "teach",
        "exert",
        "exercise",
        "study",
        "learn",
        "sleep",
        "kill",
        "steal",
        "cast",
        "conjure",
        "expell",
        "fight",
        "hit",
        "perform",
        "prcatice",
        "scribe",
        "surrender"
      })
    );
}
int discmds() {
  tell_object(this_player(), "还是老老实实挖你的矿吧？！\n");
  return 1;
}
int do_dig(string arg) {
  int time;
  object me;
  me = this_player();
  time = 300 / (int)me->query("str");
  if (time < 15) time = 15;

  if ((int)me->query("jing") < 30 || (int)me->query("qi") < 30) return notify_fail(HIR "你已经累得不行了！\n");
  if (me->query_temp("working")) return notify_fail("你正在挖着呢！\n");

  message_vision(HIW "$N开始辛苦地挖矿......\n" NOR, me);
  me->set_temp("working", 1);
  me->add_temp("work_times", 1);
  call_out("working", 30 + random(time), me);
  return 1;
}
int working(object me) {
  object ob;
  int num;
  if (!me) return 1;

  me->add("jing", -random(30));
  me->add("qi", -random(30));
  /*
        if((string)environment(me)->query("short")!="火云录矿场"||me->query_temp("work_out"))
        {
        write("你工作的时候开小差，结果累了半天什么都没得到!\n");
        me->set_temp("working",0);
        me->delete_temp("work_out");
        cot--;
        return 1;
        }
*/
  num = random(300);
  if (num < 100) {
    message_vision("$N挖了一阵，但是一无所获。\n", me);
  }
  if (num > 110 && num < 160) {
    message_vision("$N挖了很久，但是只挖出个十级矿产。\n", me);
    ob = new("/clone/kuang/kuang10");
    ob->move(me);
  }
  if (num > 160 && num < 190) {
    message_vision("$N挖了很久，但是只挖出个九级矿产。\n", me);
    ob = new("/clone/kuang/kuang9");
    ob->move(me);
  }
  if (num > 190 && num < 210) {
    message_vision("$N挖了很久，但是只挖出个八级矿产。\n", me);
    ob = new("/clone/kuang/kuang8");
    ob->move(me);
  }
  if (num > 210 && num < 220) {
    message_vision(HIY "$N挖了很久，终于挖出个七级矿产。\n" NOR, me);
    ob = new("/clone/kuang/kuang7");
    ob->move(me);
  }
  if (num > 220 && num < 235) {
    message_vision(HIY "$N挖了很久，终于挖出个六级矿产。\n" NOR, me);
    ob = new("/clone/kuang/kuang6");
    ob->move(me);
  }
  if (num > 230 && num < 245) {
    message_vision(HIY "$N挖了很久，终于挖出个五级矿产。\n" NOR, me);
    ob = new("/clone/kuang/kuang5");
    ob->move(me);
  }
  if (num > 245 && num < 250) {
    message_vision(HIY "$N挖了很久，终于挖出个四级矿产。\n" NOR, me);
    ob = new("/clone/kuang/kuang4");
    ob->move(me);
  }
  if (num > 250 && num < 260) {
    message_vision(HIW "$N挖呀挖，哇，竟然挖出个三级矿产。\n" NOR, me);
    //        message("vision",HIY"〖顺风耳〗"NOR+":"+HIY" "HIR+me->name()+NOR HIW"挖到了一个三级矿产，大家快去抢呀!\n"NOR,users());
    ob = new("/clone/kuang/kuang3");
    ob->move(me);
  }
  if (num > 260 && num < 270) {
    message_vision(HIW "$N挖呀挖，哇，竟然挖出个二级矿产。\n" NOR, me);
    //        message("vision",HIY"〖顺风耳〗"NOR+":"+HIY" "HIR+me->name()+NOR HIW"挖到了一个二级矿产，大家快去抢呀!\n"NOR,users());
    ob = new("/clone/kuang/kuang2");
    ob->move(me);
  }
  if (num > 270 && num < 275) {
    message_vision(HIW "$N挖呀挖，哇，竟然挖出个一级矿产。\n" NOR, me);
    message(
      "vision",
      HIY "〖顺风耳〗" NOR + ":" + HIY " " HIR + me->name() + NOR HIW "挖到了一个一级矿产，大家快去抢呀!\n" NOR,
      users()
    );
    ob = new("/clone/kuang/kuang1");
    ob->move(me);
  }
  if (num > 275 && num < 300) {
    message_vision("$N挖了很久，但是只挖出个烂鞋子。\n", me);
    ob = new("/clone/kuang/xiezi");
    ob->move(me);
  }
  me->add("potential", random(50));
  me->add("combat_exp", random(50));
  me->delete_temp("work_times");
  me->set_temp("working", 0);
  cot--;
  return 1;
}
int valid_leave(object me, string dir) {
  if (dir == "north")
    me->set_temp("work_out", 1);

  return ::valid_leave(me, dir);
}
void reset() {
  cot = 0;
  ::reset();
}
