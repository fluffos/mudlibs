    cot--;
    return 1;
  }
  num = random(50);
  if (num != 5) {
    write("你冲关失败！\n");
    message_vision(HIW "$N站了起来，但似乎没有什么进展！\n" NOR, me);
    return 1;
  }
  write("你成功冲破第二层了！\n");
  message_vision(HIY "$N站了起来，显得神采奕奕！\n" NOR, me);
  return 1;
}

int working3(object me) {

  int num;
  if (!me) return 1;

  me->add("jing", -100);
  me->add("qi", -100);
  if ((string)environment(me)->query("short") != "地下修炼室" || me->query_temp("work_out")) {
    write("你放弃修炼了!\n");
    me->set_temp("working", 0);
    me->delete_temp("work_out");
    cot--;
    return 1;
  }
  num = random(100);
  if (num != 5) {
    write("你冲关失败！\n");
    message_vision(HIW "$N站了起来，但似乎没有什么进展！\n" NOR, me);
    return 1;
  }
  write("你成功冲破第三层了！\n");
  message_vision(HIY "$N站了起来，显得神采奕奕！\n" NOR, me);
  return 1;
}

int valid_leave(object me, string dir) {
  if (dir == "north")
    me->set_temp("work_out", 1);

  return ::valid_leave(me, dir);
}
void reset() {
  cot = 0;
  ::reset();
}
