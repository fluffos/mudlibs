// xiulianshi.c 

inherit ROOM;

int cot;
void create() {
  set("short", "地下修炼室");
  set("long", @LONG
安心修炼吧！
LONG
  );
  set("no_sleep_room", 1);
  set("no_die", 1);
  set("no_fight", 1);
  set("no_beg", 1);
  set("no_steal", 1);
  set("exits", ([
    "up": "/d/city/dongdajie1",
  ]));

  set("no_magic", 1);
  set("coor/x", 30);
  set("coor/y", -10);
  set("coor/z", 0);
  setup();
}
void init() {
  add_action("do_chong", "chong");
  if (!wizardp(this_user()))
    add_action(
      "discmds",
      ({
        "duanlian",
        "ansuan",
        "touxi",
        "persuade",
        "teach",
        "exert",
        "exercise",
        "study",
        "learn",
        "sleep",
        "kill",
        "steal",
        "cast",
        "conjure",
        "expell",
        "fight",
        "hit",
        "perform",
        "prcatice",
        "scribe",
        "surrender"
      })
    );
}
int discmds() {
  tell_object(this_player(), "还是老老实实修炼吧？！\n");
  return 1;
}
int do_chong(string arg) {
  int time;
  object me;
  me = this_player();
  time = 300 / (int)me->query("kar");
  if ((int)me->query("jing") < 100 || (int)me->query("qi") < 100) return notify_fail(HIR "你已经很累了！\n");
  if (me->query_temp("working")) return notify_fail("你正在修炼中！\n");
  if ((int)me->query("neili_can") < 1)
    return notify_fail("你没有经过天龙大师的同意，不能修炼！\n");
  if ((int)me->query("neili_can") == 1) {
    if ((int)me->query("neili_lv") > 0)
      return notify_fail("你的内力修为已经够高了！\n");
    message_vision(HIR "$N开始修炼第一层内力修为\n" NOR, me);
    me->set_temp("working", 1);
    me->add_temp("work_times", 1);
    call_out("working1", random(time), me);
    return 1;
  }
  if ((int)me->query("neili_can") == 2) {
    if ((int)me->query("neili_lv") > 1)
      return notify_fail("你的内力修为已经够高了！\n");
    message_vision(HIR "$N开始修炼第二层内力修为\n" NOR, me);
    me->set_temp("working", 1);
    me->add_temp("work_times", 1);
    call_out("working2", random(time), me);
    return 1;
  }
  if ((int)me->query("neili_can") == 3) {
    if ((int)me->query("neili_lv") > 2)
      return notify_fail("你的内力修为已经够高了！\n");
    message_vision(HIR "$N开始修炼第三层内力修为\n" NOR, me);
    me->set_temp("working", 1);
    me->add_temp("work_times", 1);
    call_out("working3", random(time), me);
    return 1;
  }
}
int working1(object me) {

  int num;
  if (!me) return 1;

  me->add("jing", -100);
  me->add("qi", -100);
  if ((string)environment(me)->query("short") != "地下修炼室" || me->query_temp("work_out")) {
    write("你放弃修炼了!\n");
    me->set_temp("working", 0);
    me->delete_temp("work_out");
    cot--;
    return 1;
  }
  num = random(10);
  if (num != 5) {
    write("你冲关失败！\n");
    message_vision(HIW "$N站了起来，但似乎没有什么进展！\n" NOR, me);
    return 1;
  }
  write("你成功冲破第一层了！\n");
  message_vision(HIY "$N站了起来，显得神采奕奕！\n" NOR, me);
  return 1;
}

