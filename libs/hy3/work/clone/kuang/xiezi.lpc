#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(HIC"鞋子"NOR, ({"xiezi"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "这是一个鞋子！\n");
              set("value", 10000);
        }
        setup();
}

