#include <ansi.h>
inherit ITEM;


void create()
{
        set_name(HIY"潜能丹"NOR, ({"qianneng dan","dan"}));
        set_weight(80);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一颗黄色的小药丸。\n");
                set("unit", "颗");
                set("value", 50);
             
        }
}
int init()
{
        add_action("do_use", "eat");
}

int do_use(string arg)
{
        object me = this_player();
        
        
        if(arg=="dan" || arg=="qianneng dan")
        {
                message_vision(HIW"$N服下潜能丹。\n"NOR, me);
                tell_object(me,HIW"哇，好神奇，你的潜能增加了。\n"NOR);
                me->add("potential",random(5000));

                destruct(this_object());
        }
        return 1;
}

