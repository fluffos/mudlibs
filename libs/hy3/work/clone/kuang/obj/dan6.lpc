#include <ansi.h>
inherit ITEM;


void create()
{
        set_name(HIR"养神丸"NOR, ({"yangshen wan","wan"}));
        set_weight(80);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一颗红色的小药丸。\n");
                set("unit", "颗");
                set("value", 50);
             
        }
}
int init()
{
        add_action("do_use", "eat");
}

int do_use(string arg)
{
        object me = this_player();
        
        
        if(arg=="wan" || arg=="yangshen wan")
        {
                message_vision(HIW"$N服下养神丸。\n"NOR, me);
                tell_object(me,HIW"哇，好神奇，你的精神增加了。\n"NOR);
                me->add("shen",100);

                destruct(this_object());
        }
        return 1;
}

