#include <ansi.h>
inherit ITEM;


void create() {
  set_name(HIW "大还丹" NOR, ({ "dahuan dan", "dan" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗白色的小药丸。\n");
    set("unit", "颗");
    set("value", 50);

  }
}
int init() {
  add_action("do_use", "eat");
}

int do_use(string arg) {
  object me = this_player();


  if (arg == "dan" || arg == "dahuan dan") {
    message_vision(HIW "$N服下大还丹。\n" NOR, me);
    tell_object(me, HIW "哇，好神奇，你的经验增加了。\n" NOR);
    me->add("combat_exp", random(1000));
    destruct(this_object());
  }
  return 1;
}
