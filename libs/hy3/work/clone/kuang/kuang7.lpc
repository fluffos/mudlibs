#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(HIC"七级矿"NOR, ({"kuang"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "这是一块七等矿！\n");
               set("value", 50);
        }
        setup();
}

