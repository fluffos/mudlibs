#include <ansi.h>
inherit NPC;
int ask_me1();
int ask_me2();
int ask_me3();
int ask_me4();
int ask_me5();
int ask_me6();
void create()
{
        set_name("风雷杀", ( { "feng leisha", "feng" }) );
        set("title", HIW"矿贩子"NOR);
        set("gender", "男性" );
        set("age", 65);
        set("long",
              "这是个五十来岁的瘦男子。\n"
             );

        set("int", 30);
        set("str", 25);
        set("con", 23);
        set("dex", 22);
        
        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/damage", 100);
        set("qi",10000);
        set("max_qi", 10000);
        set("jing", 1000);
        set("max_jing", 1000);
        set("neili", 1000);
        set("max_neili", 1000);
        set("jiali", 150);
        set("combat_exp", 5000000);
        set("score", 250000);

        set_skill("force", 90);
        set_skill("unarmed", 90);
        set("chat_chance", 3);
        set("inquiry", ([
       "经验丹":(:ask_me1:), //exp加随机5万,1个1矿3个3矿5个5矿7个7矿10个10矿可换
       "小还丹": (: ask_me2 :),//exp加随机1000,1个2矿,1个4矿,1个6矿,1个8矿,5个10矿可换
       "大还丹": (: ask_me3 :),//exp加随机1万,2个2矿,5个4矿,7个6矿,5个8矿,10个10矿可换
       "摇头丸" : (: ask_me4 :),//加气,1个3矿,3个10矿可换
       "潜能丹" : (: ask_me5 :),//加潜能随机5万,5个2矿,5个4矿,5个6矿,5个8矿,10个10矿
       "养神丸" : (: ask_me6 :), //加神,2个4矿,3个10矿可换  
        ]) );

        setup();
}

int ask_me1()
{
object me,ob;
me=this_player();
if (me->query("kuang1")<1 || me->query("kuang3")<3 || me->query("kuang5")<5 ||
me->query("kuang7")<7 || me->query("kuang10")<10)
{tell_object(me, "你的矿产不够!\n");
return 0;
}
ob=new("/clone/kuang/obj/dan1");
ob->move(me);
me->add("kuang1",-1);
me->add("kuang3",-3);
me->add("kuang5",-5);
me->add("kuang7",-7);
me->add("kuang10",-10);
tell_object(me,"你得到一个经验丹!\n");
return 1;
}

