#include <ansi.h>
inherit NPC;
int ask_me1();
int ask_me2();
int ask_me3();
void create()
{
        set_name("天龙", ( { "tian long", "tian" }) );
        set("title", HIR"武学宗师"NOR);
        set("gender", "男性" );
        set("age", 35);
        set("long",
              "武学宗师天龙，没听说过？不要紧，如果你有矿就问他\n"
         "第一层、第二层、第三层，他会把你的内力带上一个新境界。\n"
             );

        set("int", 30);
        set("str", 25);
        set("con", 23);
        set("dex", 22);
        
        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/damage", 100);
        set("qi",100000);
        set("max_qi", 100000);
        set("jing", 10000);
        set("max_jing", 10000);
        set("neili", 10000);
        set("max_neili", 10000);
        set("jiali", 150);
        set("combat_exp", 10000000);
        set("score", 250000);

        set_skill("force", 500);
        set_skill("unarmed",500);
        set("chat_chance", 3);
        set("inquiry", ([
       "第一层":(:ask_me1:), //第一层,20个1矿40个2矿80个4矿100个8矿200个10矿可换
       "第二层":(:ask_me2:),//第二层,40个1矿80个2矿100个4矿200个8矿300个10矿可换
       "第三层":(:ask_me3:),//第三层,80个1矿160个2矿200个4矿300个8矿400个10矿可换
              ]) );

        setup();
}

int ask_me1()
{
object me;
me=this_player();
if (me->query("kuang1")<20 || me->query("kuang2")<40 || me->query("kuang4")<80 ||
me->query("kuang8")<100 || me->query("kuang10")<200)
{tell_object(me, "你的矿产不够!\n");
return 0;
}

if (me->query("neili_lv")>0)
{tell_object(me,"你的内力修为已经超过第一层了!");
 return 0;
}
me->set("neili_can",1);
me->add("kuang1",-20);
me->add("kuang2",-40);
me->add("kuang4",-80);
me->add("kuang6",-100);
me->add("kuang8",-200);
tell_object(me,"你可以去修炼第一层内力修为了!\n");
return 1;
}

int ask_me2() //第二层,40个1矿80个2矿100个4矿200个8矿300个10矿可换
{
object me;
me=this_player();
if (me->query("kuang1")<40 || me->query("kuang2")<80 || me->query("kuang4")<100 ||
me->query("kuang8")<200 || me->query("kuang10")<300)
{tell_object(me, "你的矿产不够!\n");
return 0;
}

if (me->query("neili_lv")>1)
{tell_object(me,"你的内力修为已经超过第二层了!");
 return 0;
}
if (me->query("neili_lv")<1)
{tell_object(me,"你的内力修为还不足以冲破第二层!");
 return 0;
}
me->add("kuang1",-40);
me->add("kuang2",-80);
me->add("kuang4",-100);
me->add("kuang6",-200);
me->add("kuang8",-300);
me->set("neili_can",2);
tell_object(me,"你可以去修炼第二层内力修为了!\n");
return 1;
}
int ask_me3() //第三层,80个1矿160个2矿200个4矿300个8矿400个10矿可换
{
object me;
me=this_player();
if (me->query("kuang1")<80 || me->query("kuang2")<160 || me->query("kuang4")<200 ||
me->query("kuang8")<300 || me->query("kuang10")<400)
{tell_object(me, "你的矿产不够!\n");
return 0;
}

if (me->query("neili_lv")>2)
{tell_object(me,"你的内力修为已经超过第三层了!");
 return 0;
}
if (me->query("neili_lv")<2)
{tell_object(me,"你的内力修为还不足以冲破第三层!");
 return 0;
}
me->add("kuang1",-80);
me->add("kuang2",-160);
me->add("kuang4",-200);
me->add("kuang6",-300);
me->add("kuang8",-400);
me->set("neili_can",3);
tell_object(me,"你可以去修炼第三层内力修为了!\n");
return 1;
}


