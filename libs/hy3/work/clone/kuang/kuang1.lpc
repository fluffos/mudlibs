#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(HIC"一级矿"NOR, ({"kuang"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "这是一块一等矿！\n");
              set("value", 150000);
        }
        setup();
}

