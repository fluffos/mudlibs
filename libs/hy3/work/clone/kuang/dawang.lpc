#include <ansi.h>
inherit NPC;

void create()
{
        set_name("矿业大王", ( { "kuangye dawang", "dawang" }) );
        set("title", HIR"矿业巨子"NOR);
        set("gender", "男性" );
        set("age", 65);
        set("long",
              "这是个八十来岁的胖男子。\n"
             );

        set("int", 30);
        set("str", 25);
        set("con", 23);
        set("dex", 22);
        
        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/damage", 100);
        set("qi",10000);
        set("max_qi", 10000);
        set("jing", 1000);
        set("max_jing", 1000);
        set("neili", 1000);
        set("max_neili", 1000);
        set("jiali", 150);
        set("combat_exp", 5000000);
        set("score", 250000);

        set_skill("force", 90);
        set_skill("unarmed", 90);
        set("chat_chance", 3);
        setup();
}

int accept_object(object who, object ob)
{
       
        if( !who || environment(who) != environment() ) return 0;
        if ( !objectp(ob) ) return 0;
        if ( !present(ob, who) ) return notify_fail("你没有这件东西。\n");

        if (  (string)ob->query("id") != "kuang")
                    return notify_fail(HIR"矿业大王对着你的屁股就是一脚。\n"NOR);

        if ( (string)ob->query("name") == HIC"一级矿"NOR )
                {
    message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang1",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }
        if ( (string)ob->query("name") == HIC"二级矿"NOR )
                {
        message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang2",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }

        if ( (string)ob->query("name") == HIC"三级矿"NOR )
                {
        message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang3",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }
        if ( (string)ob->query("name") == HIC"四级矿"NOR )
                {
        message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang4",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }
        if ( (string)ob->query("name") == HIC"五级矿"NOR )
                {
        message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang5",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }
        if ( (string)ob->query("name") == HIC"六级矿"NOR )
                {
        message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang6",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }
        if ( (string)ob->query("name") == HIC"七级矿"NOR )
                {
        message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang7",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }
        if ( (string)ob->query("name") == HIC"八级矿"NOR )
                {
        message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang8",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }
        if ( (string)ob->query("name") == HIC"九级矿"NOR )
                {
        message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang9",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }
        if ( (string)ob->query("name") == HIC"十级矿"NOR )
                {
        message_vision(HIY"矿业大王拍拍你的肩，说道：不错，不错！"NOR,who);
    who->add("kuang10",1);
    remove_call_out("destrory");
    call_out("destrory",1,ob);
    return 1;
                }
return 1;

}
void destrory(object ob)
{
        destruct(ob);
}

