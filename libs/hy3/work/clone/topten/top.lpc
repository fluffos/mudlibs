// topten.c
// 1998/12/17 Modified by Winder

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "火云金榜" NOR, ({ "hero board", "board" }));
  set_weight(800);
  set("unit", "本");
  set("long", "这是记载火云录英雄座次排行情况的金榜。你可以用(read)来查阅。\n");
  set("value", 1600);
  set("no_get", 1);
  set("no_steal", 1);
  set("no_put", 1);
  set("no_beg", 1);
  set("material", "paper");
}
void init() {
  add_action("do_read", "read");
}
int do_read(string arg) {

  string str;
  if (!arg || arg == "")
    str = "/adm/daemons/toptend"->query_type();
  else
    str = "/adm/daemons/toptend"->topten_query(arg);
  write(str + "\n");
  return 1;
}
