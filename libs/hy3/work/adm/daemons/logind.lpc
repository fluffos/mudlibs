// logind.c
#include <ansi.h>
#include <command.h>
#include <login.h>
#define NEWS     "/cmds/usr/news"
inherit F_DBASE;
int wiz_lock_level = WIZ_LOCK_LEVEL;
int mad_lock = 0;
string *banned_name = ({
  "你", "你的", "我", "我的", "自己", "屁", "他", "他的", "她", "她的", "它", "它的",
  "鬼王", "风云", "流氓", "爸", "妈", "祖先", "祖宗", "爷", "奶", "毛泽东", "邓小平", "江泽民",
  "高军", "他", "她", "它", "江泽民", "邓小平", "李鹏", "朱榕基",
  "傻逼", "  ", "自己", "操", " ", "中神通", "刀剑笑", "秋叶风",
  "自己", "某人", "尸体", "金庸", "我们", "你们", "他们", "大家",
  "他妈的", "去你的", "江泽民", "巫师", "【", "】", "伊天丑", "尹天丑", "骚逼",
});
string *default_name = ({ "包包", "宝宝", "乖乖", "小小", "珀珀",
  "甜甜", "一笑", "狗狗", "朱朱", "猪猪", "老虎", "鸭蛋", "老五", "老大", "老三", "老幺" });
string *default_prefix = ({ "张", "王", "李", "赵", "孙", "徐", "郑", "周", "吴",
  "蒋", "沈", "杨", "苗", "尹", "金", "魏", "陶", "俞", "柳", "朱", "司徒", "司马", "欧阳" });
string *banned_id = ({ "admin", "arch", "wizard", "apprentice", "immortal", "player" });
protected void get_id(string arg, object ob, int ip_cnt);
protected void confirm_id(string yn, object ob, int ip_cnt);
object make_body(object ob);
protected void init_new_player(object user);
varargs void enter_world(object ob, object user, int silent);
varargs void reconnect(object ob, object user, int silent);
object find_body(string name);
int check_legal_id(string arg);
int check_legal_name(string arg);
protected void get_language(string lan, object ob);
protected void logon_in(object ob);
protected void random_gift(mapping my) {
  int i;
  int tmpstr, tmpint, tmpcon, tmpdex;
  tmpstr = tmpint = tmpcon = tmpdex = 10;
  for (i = 0; i < 40; i++) {
    switch (random(4)) {
      case 0: tmpstr++; break;
      case 1: tmpint++; break;
      case 2: tmpcon++; break;
      case 3: tmpdex++; break;
    }
  }
  if (tmpstr <= 30) my["str"] = tmpstr; else my["str"] = 30;
  if (tmpint <= 30) my["int"] = tmpint; else my["int"] = 30;
  if (tmpcon <= 30) my["con"] = tmpcon; else my["con"] = 30;
  if (tmpdex <= 30) my["dex"] = tmpdex; else my["dex"] = 30;
  // next 2 are randomly selected
  my["kar"] = 10 + random(21);
  my["per"] = 10 + random(21);
}

void create() {
  seteuid(getuid());
  set("channel_id", "连线精灵");
}
protected void logfile(string str) {
  mixed *local = localtime(time());
  string file = sprintf("login/login%d%d.log", local[5], local[4] + 1);
  log_file(file, str);
}

void logon(object ob) {
  write("\n\n");
  write("Welcome to hyl2000, please choose your language first? (GB/BIG5)\n");
  input_to((: get_language :), ob);
}

protected void get_language(string lan, object ob) {
  if (lan == "BIG5" || lan == "Big5" || lan == "big5")
    ob->set_temp("big5", 1);
  logon_in(ob);
}

protected void logon_in(object ob) {
  object *usr;
  int i, wiz_cnt, ppl_cnt, ip_cnt, ban_cnt, login_cnt, i_user, title, online_num;
  int t, d, h, m, s;
  string time;
  string str, msg, user_num;
  str = query_ip_number(ob);
  if (mad_lock == 1) {
    write("现在时空已经封闭了，不能进入！！ \n");
    destruct(ob);
    return;
  }
  title = random(2);
  if (title == 1) {
    write("\n\n\n");
    msg = NOR "                        " + HIG "<<<<" HIW "Huo Yun 2000" HIY "〖" HIR "火云2000" HIY "〗 " HIG ">>>>\n" NOR;
    msg += HIG "          ※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※\n";
    msg += HIG "          ※※ " RED + "    谁  纵  千  救  眼  三  将  闲  事  十  银  赵  " + HIG " ※※\n";
    msg += HIG "          ※※ " RED + "    能  死  秋  赵  花  杯  炙  过  了  步  鞍  客  " + HIG " ※※\n";
    msg += HIG "          ※※ " RED + "    书  侠  二  挥  耳  吐  啖  信  拂  杀  照  缦  " + HIG " ※※\n";
    msg += HIG "          ※※ " RED + "    阁  骨  壮  金  热  然  朱  陵  衣  一  白  胡  " + HIG " ※※\n";
    msg += HIG "          ※※ " RED + "    下  香  士  锤  后  诺  亥  饮  去  人  马  缨  " + HIG " ※※\n";
    msg += HIG "          ※※" HIW "李                                                   " + HIG " ※※\n";
    msg += HIG "          ※※" HIW "白  " RED + " 白  不  烜  邯  意  五  持  脱  深  千  飒  吴  " + HIG " ※※\n";
    msg += HIG "          ※※● " RED + "  首  惭  赫  郸  气  岳  觞  剑  藏  里  沓  钩  " + HIG " ※※\n";
    msg += HIG "          ※※    " RED + " 太  世  大  先  素  倒  劝  膝  身  不  如  霜  " + HIG " ※※\n";
    msg += HIG "          ※※    " RED + " 玄  上  梁  震  霓  为  侯  前  与  留  流  雪  " + HIG " ※※\n";
    msg += HIG "          ※※    " RED + " 经  英  城  惊  生  轻  嬴  横  名  行  星  明  " + HIG " ※※\n";
    msg += HIG "          ※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※\n";
    msg += "\n";
    msg += NOR "                   " + BYEL HIC "  火云信箱 :hsly@etang.com \n" NOR;
    msg += NOR "                   " + BYEL HIC "   - MudOS  v22.prell -     " NOR "\n";
    msg += NOR "                   " + BYEL HIC "火云玩家论坛http://61.133.87.165/bbs \n" NOR;

    write(msg);
  } else cat(WELCOME);

  usr = users();
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  ban_cnt = 0;
  ip_cnt = 0;

  str = query_ip_number(ob);
  for (i = 0; i < sizeof(usr); i++) {
    if (str == query_ip_number(usr[i])) ip_cnt++;
    if (str == query_ip_number(usr[i]) && !environment(usr[i])) ban_cnt++;
    if (!environment(usr[i])) login_cnt++;
    else if (wizardp(usr[i])) { if (!usr[i]->query("env/invisibility")) wiz_cnt++; } else ppl_cnt++;
  }
  user_num = read_file("/topten/login/users", 1, 1);
  i_user = atoi(user_num);
  printf(
    NOR + "\n" HIR "〖" BBLU WHT "火云录" NOR HIR "〗" NOR "自2002年4月架站起，" + "共有" + CYN "%s" NOR + "人次来访。\n" NOR,
    chinese_number(i_user)
  );
  i_user = i_user + 1;
  user_num = sprintf("%d", i_user);
  write_file("/topten/login/users", user_num, 1);
  user_num = read_file("/topten/login/iduser", 1, 1);
  i_user = atoi(user_num);
  online_num = atoi(read_file("/topten/login/maxonline", 1));
  printf(
    NOR + HIR "〖" BBLU WHT "火云录" NOR HIR "〗" NOR "目前共有" + CYN "%s个注册玩家。\n",
    chinese_number(i_user)
  );
  write(NOR + HIR "〖" BBLU WHT "火云录" NOR HIR "〗" NOR "最高在线人数：" + CYN + chinese_number(online_num) + NOR " 人\n");
  write(NOR + HIR "〖" BBLU WHT "火云录" NOR HIR "〗" NOR "最大支持人数：  " CYN + chinese_number(MAX_USERS) + NOR " 人\n");
  write(NOR + HIR "〖" BBLU WHT "火云录" NOR HIR "〗" NOR "已连续运行了：  " CYN);

  t = uptime();
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + HIR "天" NOR;
  else time = "";

  if (h) time += chinese_number(h) + HIG "小时" NOR;
  if (m) time += chinese_number(m) + CYN "分" NOR;
  time += chinese_number(s) + HIB "秒";

  write(time + "\n" NOR);

  //added by xingyun用来禁止恶意破坏的ip login
  // BUG FIX (AGENTS.md §8.14): was query_ip_name(ob), a reverse-DNS
  // hostname string -- but band.lpc's is_banned() sscanf()s its argument
  // as a dotted-quad IP and fail-closed bans (returns 1) whenever that
  // parse doesn't yield exactly 4 dot-separated tokens, which a hostname
  // (including "localhost" for loopback) essentially never does. Use the
  // real IP so is_banned() actually evaluates against banned_sites as
  // designed instead of rejecting almost every connection outright.

  if (BAN_D->is_banned(query_ip_number(ob))) {
    write("Sorry, your ip is banned by this mud.\n");
    destruct(ob);
    return;
  }

  if (ip_cnt - 1 > 0) {
    printf("你现在从%s连线进入。", CYN + str + NOR);
    printf("在这个地址上，还有" + YEL + chinese_number(ip_cnt - 1) + NOR + "位其他玩家。\n");
  } else printf("你现在从%s连线进入。\n", CYN + str + NOR);
  printf("目前共有" + HIY "%s" NOR + "位巫师、" + HIW "%s" NOR + "位江湖人士在江湖中，以及" + HIB "%s" NOR + "位朋友正在步入途中。\n",
    chinese_number(wiz_cnt), chinese_number(ppl_cnt), chinese_number(login_cnt));

  if (ban_cnt > 9) {
    write("这个IP上来的玩家太多了，不能进入！！ \n");
    destruct(ob);
    return;
  }

  write("您的" + HIW "英文" NOR + "名字：");
  input_to((: get_id :), ob, ip_cnt);
}
protected void get_id(string arg, object ob, int ip_cnt) {
  object ppl;
  object *usr;
  int i, wiz_cnt, usr_cnt;
  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    write("您的" + HIW "英文" NOR + "名字：");
    input_to("get_id", ob, ip_cnt);
    return;
  }
  usr = users();
  wiz_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (wizardp(usr[i])) wiz_cnt++;
  }
  if ((string)SECURITY_D->get_status(arg) == "(player)"
    && (sizeof(users()) - wiz_cnt) >= 150) {
    ppl = find_body(arg);
    // Only allow reconnect an interactive player when MAX_USERS exceeded.
    if (!ppl || !interactive(ppl)) {
      write("对不起，" + MUD_NAME + "的使用者已经太多了，请待会再来。\n");
      destruct(ob);
      return;
    }
  }
  if (wiz_level(arg) < wiz_lock_level) {
    write("对不起，" + MUD_NAME + "目前限制巫师等级 " + WIZ_LOCK_LEVEL
      + " 以上的人才能连线。\n");
    destruct(ob);
    return;
  }

  if ((string)ob->set("id", arg) != arg) {
    write("Failed setting user name.\n");
    destruct(ob);
    return;
  }
  for (i = 0; i < sizeof(banned_id); i++)
    if (strsrch(arg, banned_id[i]) != -1) {
      write("对不起，这个帐户正在有另一个使用者在登录，请重新输入你的英文名。\n");
      write("您的英文名字：");
      input_to("get_id", ob, ip_cnt);
      return;
    }
  if (arg == "guest") {
    // If guest, let them create the character.
    write("对不起，现在限制guest帐户登录，请重新输入你的英文名。\n");
    write("您的" + HIW "英文" NOR + "名字：");
    input_to("get_id", ob, ip_cnt);
    return;
  }
  if (wiz_level(arg) < 2) {
    if (!BAN_D->is_welcome(arg)) {
      if (!BAN_D->is_netclub(query_ip_number(ob)))
        if (ip_cnt > 12) {
          write(HIR "这个IP上来的玩家太多了，不能进入！！ \n" NOR);
          destruct(ob);
          return;
        }
    }
  }

  if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    if (ob->restore()) {
      write("请输入密码：");
      input_to("get_passwd", 1, ob, arg);
      return;
    }
    write("您的人物储存挡出了一些问题，请利用 guest 人物通知巫师处理。\n");
    destruct(ob);
    return;
  }
  usr_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (usr[i]->query("id") == arg) {
      usr_cnt++;
      if (usr_cnt > 1) {
        write("对不起，这个帐户正在有另一个使用者在登录，请重新输入你的英文名。\n");
        write("您的英文名字：");

        input_to("get_id", ob, ip_cnt);
        return;
      }
    }
  }

  // 补丁
  if ((strlen(arg) < 3) || (strlen(arg) > 7)) {
    write(HIR "对不起，你的英文名字必须是 3 到 7 个英文字母。\n" NOR);
    write("您的" + HIW "英文" NOR + "名字：");
    input_to("get_id", ob, ip_cnt);
    return;
  }
  //
  write("使用 " + (string)ob->query("id") + " 这个名字将会创造一个" + HIC "新的人物" NOR + "，您确定吗(y/n)？");
  input_to("confirm_id", ob, ip_cnt);
}
protected void get_passwd(string pass, object ob, string arg) {
  string my_pass;
  object user;
  write("\n");

  if ((time() - ob->query("last_on")) < 20 && wiz_level(ob->query("id")) < 2) {
    write(RED "为了减轻系统负担请过一会再连入，谢谢合作。!\n" NOR);
    destruct(ob);
    return;
  }
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass) {
    write(HIR "密码错误！\n" NOR);
    destruct(ob);
    return;
  }
  if (!BAN_D->vaild_allow_address(ob)) {
    destruct(ob);
    return;
  }
  // Check if we are already playing.
  user = find_body(ob->query("id"));
  if (user) {
    if (user->query_temp("netdead")) {
      if ((string)SECURITY_D->get_status(arg) == "(admin)") {
        __DIR__ "wzd_log"->wzd_log(arg, ob, user, query_ip_name(ob), 2);
        return;
      } else
        reconnect(ob, user);
      return;
    }
    if ((string)SECURITY_D->get_status(arg) == "(admin)") {
      __DIR__ "wzd_log"->wzd_log(arg, ob, user, query_ip_name(ob), 3);
      return;
    } else {
      write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
      input_to("confirm_relogin", ob, user);
      return;
    }
  }
  if (objectp(user = make_body(ob))) {
    if (wiz_level(user) < 2)
      log_file("npc_save", sprintf("%s%s login from %s %s\n", ob->query("name"),
        "(" + ob->query("id") + ")", pass, ctime(time())));
    if (user->restore()) {
      log_file("USAGE", sprintf("%-16s loggined from %20s (%s)\n", user->query("id"),
        query_ip_number(ob), ctime(time())));
      if ((string)SECURITY_D->get_status(arg) == "(admin)") {
        __DIR__ "wzd_log"->wzd_log(arg, ob, user, query_ip_name(ob), 1);
        return;
      } else
        enter_world(ob, user);
      return;
    } else {
      destruct(user);
    }
  }
  write("请您重新创造这个人物。\n");
  confirm_id("y", ob, 1);
}
protected void confirm_relogin(string yn, object ob, object user) {
  object old_link;
  if (!ob || !user) return;
  if (yn == "") {
    write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }
  if (yn[0] != 'y' && yn[0] != 'Y') {
    if (wiz_level(user) > 3) {
      if (objectp(user = make_body(ob))) {
        if (user->restore()) {
          log_file(
            "USAGE",
            sprintf(
              "%-16s loggined from %20s (%s)\n",
              user->query("id"),
              query_ip_number(ob),
              ctime(time())
            )
          );
          enter_world(ob, user);
          return;
        } else destruct(user);
      }
    }

    write(GRN "好吧，欢迎下次再来。\n" NOR);
    destruct(ob);
    return;
  } else {
    tell_object(user, "有人从别处( " HIW + query_ip_number(ob)
      +NOR " )连线取代你所控制的人物。\n");
    log_file("USAGE", sprintf("%-16s replaced by %22s (%s)\n", user->query("id"),
      query_ip_number(ob), ctime(time())));
  }
  // Kick out tho old player.
  old_link = user->query_temp("link_ob");
  if (old_link) {
    exec(old_link, user);
    destruct(old_link);
  }
  reconnect(ob, user);
}
protected void confirm_id(string yn, object ob, int ip_cnt) {
  if (yn == "") {
    write("使用这个名字将会创造一个新的人物，您确定吗(y/n)？");
    input_to("confirm_id", ob, ip_cnt);
    return;
  }
  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，那么请重新输入您的英文名字：");
    input_to("get_id", ob, ip_cnt);
    return;
  }
  write(@TEXT
请输入您的高姓大名，由于这个名字代表你的人物，而且以后不能更改，
务必慎重择名（不雅观的姓名将被删除）。另：请不要选择金庸小说中
已有人物姓名。名字一经选定就很难更改，因此请慎重取名。
(除了名字之外，本 mud 有许多取绰号、别称的设计，所以郑重建议您
 取一个比较像名字的中文名字。)
TEXT
  );
  write("您的" + HIY "中文" NOR + "名字：");
  input_to("get_name", ob);
}
protected void get_name(string arg, object ob) {
  //if (arg && ob->query_temp("big5"))
  //   arg=LANGUAGE_D->Big52GB(arg);
  if (!check_legal_name(arg)) {
    ob->add_temp("get_name", 1);
    if (ob->query_temp("get_name") > 2) {
      // the user can't input proper chinese name.
      // assign one for him/her.    mon 4/19/98

      arg = default_prefix[random(sizeof(default_prefix))] + default_name[random(sizeof(default_name))];

      write("因为你不能输入适当的中文名字，系统指定你的名字为：" RED +
        arg + NOR "\n");


    } else {
      write("您的" + HIY "中文" NOR + "名字：");
      input_to("get_name", ob);
      return;
    }
  }

  printf("%O\n", ob);
  ob->set("name", arg);
  write("请设定您的" + RED "密码：" NOR);
  input_to("new_password", 1, ob);

}
protected void new_password(string pass, object ob) {
  write("\n");
  if (strlen(pass) < 5) {
    write(RED "密码" NOR + "的长度至少要五个字符，请重设您的密码：");
    input_to("new_password", 1, ob);
    return;
  }
  ob->set("password", crypt(pass, 0));
  write("请再输入一次您的" + RED "密码" NOR + "，以确认您没记错：");
  input_to("confirm_password", 1, ob);
}
protected void confirm_password(string pass, object ob) {
  mapping my;
  string old_pass;
  write("\n");
  old_pass = ob->query("password");
  if (crypt(pass, old_pass) != old_pass) {
    write("您两次输入的" + RED "密码" NOR + "并不一样，请重新设定一次密码：");
    input_to("new_password", 1, ob);
    return;
  }
  write(
    "一个人物的天赋对于他或她所修习的武艺息息相关。火云中的人物大多具有
以下四项天赋：\n");
  write(YEL "   膂力：" NOR + "影响攻击能力及负荷量的大小。\n" NOR);
  write(YEL "   悟性：" NOR + "影响学习武功秘籍的速度及理解师傅的能力。\n" NOR);
  write(YEL "   根骨：" NOR + "影响体力恢复的速度及升级后所增加的体力。\n" NOR);
  write(YEL "   身法：" NOR + "影响防御及躲避的能力。\n" NOR);
  my = ([]);
  random_gift(my);
  write("\t\n膂力[" + RED + my["str"] + NOR + "]， 悟性[" + RED + my["int"] + NOR + "]， 根骨[" + RED + my["con"] + NOR + "]， 身法[" + RED + my["dex"] + NOR + "]\n");
  write("您接受这一组天赋吗？");
  input_to("get_gift", ob, my);
}
protected void get_gift(string yn, object ob, mapping my) {
  if (yn[0] != 'y' && yn[0] != 'Y') {
    random_gift(my);
    write("\t\n膂力[" + RED + my["str"] + NOR + "]， 悟性[" + RED + my["int"] + NOR + "]， 根骨[" + RED + my["con"] + NOR + "]， 身法[" + RED + my["dex"] + NOR + "]\n");
    write("您同意这一组天赋吗？");
    input_to("get_gift", ob, my);
  }
  if (yn[0] == 'y' || yn[0] == 'Y') {
    write("\n您的电子邮件地址：");
    input_to("get_email", ob, my);
  }
}
protected void get_email(string email, object ob, mapping my) {
  object user;
  write("\n");
  if (email == "" || strsrch(email, "@") == -1) {
    write("电子邮件地址需要是 " + GRN "id@address" NOR + " 的格式。\n");
    write("您的" + GRN "电子邮件" NOR + "地址：");
    input_to("get_email", ob, my);
    return;
  }
  ob->set("email", email);
  ob->set("registered", 1);
  // If you want do race stuff, ask player to choose one here, then you can
  // set the user's body after the question is answered. The following are
  // options for player's body, so we clone a body here.
  ob->set("body", USER_OB);
  if (!objectp(user = make_body(ob)))
    return;
  user->set("str", my["str"]);
  user->set("dex", my["dex"]);
  user->set("con", my["con"]);
  user->set("int", my["int"]);
  ob->set("registered", 1);
  user->set("registered", 1);
  write("您要扮演" + CYN "男性(m)" NOR + "的角色或" + MAG "女性(f)" NOR + "的角色？");
  input_to("get_gender", ob, user);
}
protected void get_gender(string gender, object ob, object user) {
  int id_temp; string id_num;
  write("\n");
  if (gender == "") {
    write("您要扮演" + CYN "男性(m)" NOR + "的角色或" + MAG "女性(f)" NOR + "的角色？");
    input_to("get_gender", ob, user);
    return;
  }
  if (gender[0] == 'm' || gender[0] == 'M')
    user->set("gender", "男性");
  else if (gender[0] == 'f' || gender[0] == 'F')
    user->set("gender", "女性");
  else {
    write("对不起，您只能选择" + CYN "男性(m)" NOR + "或" + MAG "女性(f)" NOR + "的角色：");
    input_to("get_gender", ob, user);
    return;
  }
  log_file("USAGE", sprintf("%s was created from %s (%s)\n", user->query("id"),
    query_ip_number(ob), ctime(time())));
  CHANNEL_D->do_channel(
    this_object(),
    "sys",
    "又有一个新玩家：" + user->query("name") + "[" + user->query("id") + "]。" NOR
  );
  init_new_player(user);
  enter_world(ob, user);
  id_num = read_file("/topten/login/iduser", 1, 1);
  id_temp = atoi(id_num); id_temp = id_temp + 1;
  id_num = sprintf("%d", id_temp);
  write_file("/topten/login/iduser", id_num, 1);
  write("\n");

}
object make_body(object ob) {
  string err;
  object user;
  if (stringp(ob->query("body")))
    user = new(ob->query("body"));
  else return 0;
  if (!user) {
    write("现在可能有人正在修改使用者物件的程式，无法进行复制。\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}
protected void init_new_player(object user) {
  user->set("title", "火云百姓");
  user->set("birthday", time());
  user->set("potential", 300);
  user->set("food", 300);
  user->set("water", 300);
  user->set("combat_exp", 500);
  user->set("channels", ({ "chat", "rumor", "new", "party", "music", "bidd", "hyl" }));
  user->set("money", 1010);
}
protected void have_mail() {
  write(BOLD + "\n杜宽(Post officer)告诉你：有您的信！请到驿站来一趟...\n\n" + NOR);
}
protected void load_equip(object user) {
  string *equip, file;
  int *i_list = ({});
  mapping equip_list;
  int i, k;
  object ob;

  if (!objectp(user) || !environment(user)) return;

  equip_list = user->query("equip");
  if (!mapp(equip_list)) equip_list = ([]);
  if (sizeof(equip_list) < 1) return;

  equip = keys(equip_list);
  for (i = 0; i < sizeof(equip); i++) {
    i_list = equip_list[equip[i]];
    for (k = 0; k < sizeof(i_list); k++) {
      file = "/quest/quest_obj/equip/" + equip[i];

      if (objectp(ob = new(file))) {
        ob->set("owner_id", user->query("id"));
        ob->set("num", i_list[k]);

        if (stringp(ob->query_save_file()) &&
          file_size((ob->query_save_file() + ".o")) != -1 && ob->restore()) {
          ob->set_name(ob->query("name"), ({ ob->query("id") }));
          ob->setup();
          ob->move(user);
        } else { destruct(ob); i_list[k] = 0; }
      }
    }

    i_list -= ({ 0 });
    user->set("equip/" + equip[i], i_list);
  }
  return;
}
varargs void enter_world(object ob, object user, int silent) {
  object cloth, mailbox, card;
  string startroom, id, str, couple_name1, couple_name2;
  object login_ob, couple;

  if ((string)SECURITY_D->get_status(user) == "(admin)" && (!previous_object()
    || base_name(previous_object()) != "/adm/daemons/wzd_log")) {
    __DIR__ "wzd_log"->wzd_log(user->query("id"), ob, user, query_ip_name(ob), 1);
    return;
  }

  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  user->set("registered", ob->query("registered"));
  exec(user, ob);
  user->set_temp("big5", ob->query_temp("big5"));
  user->setup();

  __DIR__ "check_level.lpc"->check_level(user);
  // added by xingyun,进行经验和所支持武技等级的检测;
  // BUG FIX (AGENTS.md §8.9): was ob->query("age") -- ob is the transient
  // login stub, whose "age" is never set anywhere in this codebase, so
  // this condition was permanently false by construction. Currently
  // masked in practice because init_new_player() (called just above, at
  // enter_world()'s call site) already unconditionally seeds food/water
  // to 300, but the gate should still read the object update_age()
  // actually writes to, in case that other default is ever refactored.
  if (!user->query("food") && !user->query("water") && user->query("age") == 14) {
    user->set("food", user->max_food_capacity());
    user->set("water", user->max_water_capacity());
  }
  // In case of new player, we save them here right aftre setup
  // compeleted.
  user->save();
  ob->save();

  if (user->query("couple")) {
    card = new("/d/city/obj/marry_card");
    card->set("name", "你和" + user->query("couple/couple_name") + "的结婚证");
    card->move(user);
  }
  if (!user->over_encumbranced()) {
    if (!present("canyue baobei", user))
      new("/clone/misc/canyue_baobei")->move(user);
    mailbox = new("/clone/misc/mailbox");
    mailbox->set_owner(user);
    mailbox->move(user);
    id = user->query("id");
    str = DATA_DIR + "mail/" + id[0..0] + "/" + id + ".o";
    if (stringp(str) && mailbox->query_mails() > user->query("new_mail"))
      call_out("have_mail", 3);

    if (wizhood(user) == "(player)") {
      if (user->query("shen") > 10000)
        cloth = new("/clone/misc/red_cloth");
      else if (user->query("shen") < -10000)
        cloth = new("/clone/misc/black_cloth");
      else if (user->query("gender") != "女性")
        cloth = new("/clone/misc/cloth");
      else cloth = new("/clone/misc/pink_cloth");
      cloth->move(user);
      cloth->wear();
      if (!present("canyue baobei", user) && !wizardp(user))
        new("/clone/misc/canyue_baobei")->move(user);
      if (user->query("age") < 18) {
        cloth = new("/clone/misc/site");
        cloth->move(user);
      }
    } else {
      if (user->query("gender") != "女性")
        cloth = new("/clone/misc/baipao");

      else cloth = new("/clone/misc/color_cloth");
      cloth->move(user);
      cloth->wear();
    }
  }
  if (!silent) {
    login_ob = new(LOGIN_OB);
    login_ob->set("id", user->query("id"));
    login_ob->restore();
    user->start_more(read_file("/adm/etc/player"));
    write(HIC "★" + HIG " 〖您目前权限〗" NOR + " : " + HIY + wizhood(user) + NOR + "\n");
    write(HIC "★" + HIG " 〖您上次光临〗" + HIG "火云是从" NOR + " : " NOR + HIY + login_ob->query("last_from") + NOR + "\n");
    write(HIC "★" + HIG " 〖您上次连线的时间〗是" NOR + " : " + HIY + ctime(login_ob->query("last_on")) + NOR + "\n\n");
    if (user->is_ghost())
      startroom = DEATH_ROOM;
    else {
      if (!stringp(startroom = user->query("startroom")))
        switch (random(3)) {
          case 0: startroom = "/d/city/kedian"; break;
          case 1: startroom = "/d/city2/wenmiao"; break;
          case 2: startroom = "/d/city/wumiao"; break;
        }
      if (startroom == DEATH_ROOM)
        startroom = START_ROOM;
    }
    if (wiz_level(user->query("id")) > 1) {
      user->move("/d/wizard/wizard_room");
      CHANNEL_D->do_channel(user, "wiz*",
        sprintf("连线进入" + HIG "火云。" NOR));
    } else if (file_size(startroom + ".lpc") > 0 && !catch(load_object(startroom)))
      user->move(startroom);
    else {
      user->move(START_ROOM);
      startroom = START_ROOM;
      user->set("startroom", START_ROOM);
    }

    if (wiz_level(user->query("id")) < 2)
      tell_room(startroom, user->query("name") + "连线进入这个世界。\n",
        ({ user }));
  }

  write(HIW "你连线进入这个世界，开始了自己的" + HIG "江湖" + HIW "生涯\n\n" NOR);
  if (ob->query_temp("no_allow_ip"))
    write("\n\n警告：你未设定自己的登录地址范围。请用" HIR " allowip " NOR "指令设置。\n\n");
  if (file_size("/log/login/notice") > 0) {
    write(HIG "     ～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～\n" NOR);
    write(read_file("/log/login/notice"));
    write(HIG "     ～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～～\n\n" NOR);
  }
  if (user->query("gender") == "男性" && user->query("age") <= 25) {
    switch (random(2)) {
      case 0: str = "少年侠士"; break;
      case 1: str = RANK_D->query_respect(user); break;
    }
  } else if (user->query("gender") == "女性" && user->query("age") <= 25) {
    switch (random(2)) {
      case 0: str = "妙龄少女"; break;
      case 1: str = RANK_D->query_respect(user); break;
    }
  } else str = RANK_D->query_respect(user);

  if (!wizardp(user))
    message(
      "channel:chat",
      HIR "〖火云客店〗" NOR + ": " + HIC "听说又来了一位叫做" + HIW + user->name() + HIC "的" + str + "\n" NOR,
      users()
    );
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf(
      "%s%s" + HIG "由" + "%s" + HIG "连线进入。" NOR,
      user->short(1),
      user->query_temp("big5") ? (HIR + "(使用大五码)" + WHT) : WHT,
      query_ip_number(user)
    ));
  UPDATE_D->check_user(user);
  STATUS_D->compare_status(user);
  if (!user->query("possessed")) {
    NEWS->check_news(user);
    TOPTEN_D->topten_checkplayer(user);
  }
  user->set_temp("temp_exp", user->query("combat_exp"));
  user->set_temp("temp_time", time());
  if (user->query("equip")) call_out("load_equip", 1, user);

  if (user->query("couple/couple_id")
    && objectp(couple = find_player(user->query("couple/couple_id")))
    && environment(couple)) {
    if (user->query("gender") == "女性") {
      couple_name1 = "老公";
      couple_name2 = "老婆";
    } else {
      couple_name1 = "老婆";
      couple_name2 = "老公";
    }

    if (user->query("couple/child")) {
      tell_object(user, HIY "你们夫妻都来了，到产房领回你们的孩子吧。\n" NOR);
      tell_object(couple, HIY "你们夫妻都来了，到产房领回你们的孩子吧。\n" NOR);
    }
    tell_object(user, HIM "你的" + couple_name1 + "在线上哪，还不赶快到"
      +environment(couple)->query("short") + HIM "前去迎接？\n" NOR);

    tell_object(couple, HIM "你" + couple_name2 + "来啦，还不赶快"
      +HIM "准备前去迎接？\n" NOR);

  }
}
varargs void reconnect(object ob, object user, int silent) {
  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  exec(user, ob);
  user->reconnect();
  if (!silent) {
    tell_room(environment(user), user->query("name") + YEL "重新连线回到这个世界。\n" NOR,
      ({ user }));
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s(%s)由(%s)重新连线进入。", user->query("name"), user->query("id"), query_ip_number(user)));

  //    UPDATE_D->check_user(user);
  //造成铸造兵器的bug，特此注释，xingyun 2001.10.31
}
int check_legal_id(string id) {
  int i;
  i = strlen(id);

  if ((strlen(id) < 3) || (strlen(id) > 7)) {
    write("对不起，你的" + HIW "英文" NOR + "名字必须是 3 到 7 个英文字母。\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("对不起，你的" + HIW "英文" NOR + "名字只能用英文字母。\n");
      return 0;
    }
  return 1;
}
int check_legal_name(string name) {
  int i;
  i = strlen(name);
  if ((strlen(name) < 1) || (strlen(name) > 5)) {
    write("对不起，你的中文名字必须是 1 到 5 个中文字。\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，你的中文名字不能用控制字元。\n");
      return 0;
    }
    if (!is_chinese(name[i..i])) {
      write("对不起，请您用「中文」取名字。\n");
      return 0;
    }
  }
  if (member_array(name, banned_name) != -1) {
    write("对不起，这种名字会造成其他人的困扰。\n");
    return 0;
  }
  for (i = 0; i < sizeof(banned_name); i++)
    if (strsrch(name, banned_name[i]) != -1) {
      write("对不起，这种名字会造成其他人的困扰。\n");
      return 0;
    }
  return 1;
}
object find_body(string name) {
  object ob, *body;
  if (objectp(ob = find_player(name)))
    return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++)
    if (clonep(body[i])
      && getuid(body[i]) == name) return body[i];
  return 0;
}
int set_wizlock(int level) {
  if (wiz_level(this_player(1)) <= level)
    return 0;
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  wiz_lock_level = level;
  return 1;
}
int set_madlock(int setmark) {
  if (wiz_level(this_player(1)) < wiz_level("(arch)"))
    return 0;
  if (setmark == 1) mad_lock = 1;
  else mad_lock = 0;
  return 1;
}
int get_madlock() {
  return mad_lock;
}
