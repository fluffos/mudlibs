#include <ansi.h>
string clear_title(string arg) {
  if ((strsrch(arg, HIW "幼年天下第一  " NOR) >= 0) ||
    (strsrch(arg, HIW "幼年天下第二  " NOR) >= 0) ||
    (strsrch(arg, HIW "少年天下第一  " NOR) >= 0) ||
    (strsrch(arg, HIW "少年天下第二  " NOR) >= 0) ||
    (strsrch(arg, HIW "天下第一少侠  " NOR) >= 0) ||
    (strsrch(arg, HIW "天下第二少侠  " NOR) >= 0) ||
    (strsrch(arg, HIW "天下第一侠客  " NOR) >= 0) ||
    (strsrch(arg, HIW "天下第二侠客  " NOR) >= 0) ||
    (strsrch(arg, HIW "天下第一大侠  " NOR) >= 0) ||
    (strsrch(arg, HIW "天下第二大侠  " NOR) >= 0)) {
    arg = replace_string(arg, HIW "幼年天下第一  " NOR, "");
    arg = replace_string(arg, HIW "幼年天下第二  " NOR, "");
    arg = replace_string(arg, HIW "少年天下第一  " NOR, "");
    arg = replace_string(arg, HIW "少年天下第二  " NOR, "");
    arg = replace_string(arg, HIW "天下第二少侠  " NOR, "");
    arg = replace_string(arg, HIW "天下第一侠客  " NOR, "");
    arg = replace_string(arg, HIW "天下第二侠客  " NOR, "");
    arg = replace_string(arg, HIW "天下第一大侠  " NOR, "");
    arg = replace_string(arg, HIW "天下第二大侠  " NOR, "");
  }

  return arg;
}

void check_level(object me) {
  mapping skill_status;
  string *sname, title;
  int level, i, exp, *skills;
  object *ilist;

  if (!interactive(me)) return;

  ilist = all_inventory(me);
  ilist = all_inventory(me);
  for (i = 0; i < sizeof(ilist); i++) {
    if (ilist[i]->query("money_id") == "thousand-gold"
      && ilist[i]->query_amount() > 1)
      ilist[i]->set_amount(1);
    if (ilist[i]->query("money_id") == "thousand-cash"
      && ilist[i]->query_amount() > 100)
      ilist[i]->set_amount(100);
    if (ilist[i]->query("money_id") == "gold"
      && ilist[i]->query_amount() > 1000)
      ilist[i]->set_amount(1000);

  }

  if (me->query("biwu") && (time() - me->query("biwu")) > 720 * 3600) {
    title = clear_title(me->query("title"));
    me->set("title", title);
    me->delete("biwu");
  }

  if (me->query("jined"))
    me->disable_player(HIC "  <禁闭中..........>" NOR);

  exp = (int)me->query("combat_exp");
  level = ceil(pow(exp * 10.0, 0.333333));

  if (me->query("age") < 20)
    return;

  if (!(skill_status = me->query_skills()))
    return;

  sname = keys(skill_status);
  skills = values(skill_status);

  for (i = 0; i < sizeof(skill_status); i++) {
    if (SKILL_D(sname[i])->type() != "knowledge"
      && sname[i] != "literate" && sname[i] != "taoism"
      && sname[i] != "mahayana" && sname[i] != "buddhism"
      && sname[i] != "mizong-xinfa")
      if (skills[i] > level)
        me->set_skill(sname[i], level);
  }
  return;
}
