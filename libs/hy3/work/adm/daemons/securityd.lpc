// securityd.c
// xingyun 设置 on 2002.1

#include <login.h>
nosave mapping wiz_status;
nosave string *wiz_levels = ({
    "(player)",
    "(immortal)",
    "(wizard)",
    "(arch)",  
    "(admin)"
});
void create()
{
    string *wizlist, wiz_name, wiz_level;
    int i;
    wizlist = explode(read_file(WIZLIST), "\n");
    wiz_status = allocate_mapping(sizeof(wizlist));
    for(i=0; i<sizeof(wizlist); i++) {
    if( wizlist[i][0]=='#'  ||
        sscanf(wizlist[i], "%s %s", wiz_name, wiz_level)!=2 ) continue;
        wiz_status[wiz_name] = wiz_level;
    }
}
string *query_wizlist() { return keys(wiz_status); }

// This function returns the status of an uid.
string get_status(mixed ob)
{
    string euid;
    if( objectp(ob) ) {
        euid = geteuid(ob);
        if( !euid ) euid = getuid(ob);
    }   else if( stringp(ob) ) euid = ob;

    if( !undefinedp(wiz_status[euid]) ) return wiz_status[euid];
    else if( member_array(euid, wiz_levels)!=-1 ) return euid;
    else return "(player)";
}
int get_wiz_level(object ob)
{
    return member_array(get_status(ob), wiz_levels);
}
int valid(object user,string filename)
{
    string euid,mail_file,login_file,id;
    if (!user)   return 0;
    euid = geteuid(user);

    switch ( get_status(euid) )
    {
        case "(player)"    :

              id = euid;
              mail_file = sprintf(DATA_DIR"mail/%c/%s",id[0],id);
              login_file = sprintf(DATA_DIR"login/%c/%s",id[0],id);
   
              if( ( filename == (string)user->query_save_file() ||
                    filename == (string)user->query_save_file()+".o" ||
                    filename == mail_file || filename== mail_file+".o" ||
                    filename == login_file || filename== login_file+".o") && 
                  ( sscanf(filename, "/data/login/%*s") ||
                    sscanf(filename, "/data/user/%*s") ||
                    sscanf(filename, "/data/mail/%*s") ) )
               return 1;
               return 0;
        case "(immortal)"   :   return 0;
        case "(apprentice)" :
        case "(wizard)"     :
               if ( sscanf(filename,"/u/"+euid+"/%*s") )
               return 1;
               write("警告：你只能操作属于自己目录下的文件。\n");
               return 0;
 
       case "(arch)"     :
               if ( sscanf(filename,"/u/"+euid+"/%*s")||
                    sscanf(filename,"/d/%*s") ||
                    sscanf(filename,"/kungfu/%*s") ||
                    sscanf(filename,"/doc/%*s") )
                return 1;
                write("警告：你不能操作这些目录下的文件。\n");
                return 0;
        case "(admin)"     :
                if( sscanf(filename,"/include/global%*s") ||
                    sscanf(filename,"/adm/obj/%*s") ||
                    sscanf(filename,"/adm/simul_efun/%*s") ||
                    sscanf(filename,"/adm/daemons/security%*s") ||
                    sscanf(filename,"/adm/daemons/wzd_log%*s") ||
                    sscanf(filename,"/log/%*s") ) 
                {
                    write("警告：你不能操作这些目录下的文件。\n");
                    return 0;
                } else return 1;
    }

    return 0;
}
int set_status(mixed ob, string status)
{
    string uid,str,*wiz, wizlist;
    int i;
    object me;

    if( geteuid(previous_object())!= ROOT_UID ) return 0;
    if (get_status(this_player(1)) != "(admin)" 
        || previous_object(0)!=find_object("/cmds/adm/promote"))
    {
       me=this_player(1);
       str="On "+ctime(time())+"\n"+
       "This Player: "+me->query("name")+"("+me->query("id")+")\n"+
       "Previous Object: "+base_name(previous_object())+"\n"+
       "This player's ROOM: "+base_name(environment(me))+"\n"+
       "Committed illegal promote!\n";
       str+="**********************\n";
       log_file("trace/file/illegal_promote",str);
       return 0;
    }

    if(stringp(ob))    uid = ob;
    else if( userp(ob) )   uid = getuid(ob);
    else return 0;
    
    if( status == "(player)" )
        map_delete(wiz_status, uid);
    else
        wiz_status[uid] = status;
    wiz = keys(wiz_status);
    for(wizlist = "", i=0; i<sizeof(wiz); i++)
        wizlist += wiz[i] + " " + wiz_status[wiz[i]] + "\n";
    rm(WIZLIST);
    write_file(WIZLIST, wizlist,1);
    log_file( "nosave/promotion", capitalize(uid)
     + " become a " + status + " on " + ctime(time()) + "\n" );
    return 1;
}

string *get_wizlist() { return keys(wiz_status); }

int valid_set(object ob, object user)
{
    int level_ob,level_user;
    string str;     

    if ( author_file(base_name(user)) == ROOT_UID 
         || author_file(base_name(user)) == "MudLib")
          return 1;
    else if( get_status( author_file(base_name(user)) ) != "(admin)" )
    {
         str="On "+ctime(time())+"\n"+
             "Illegal File: "+base_name(user)+"\n"+
             "Set user: "+ob->query("name")+"("+ob->query("id")+")\n";
         str+="**********************\n";
         log_file("trace/illegal_set",str);

         return 0;            // wiz use illegal object to set player
    }

    if (ob==user)   return 1;
    
    level_ob=member_array(get_status(ob), wiz_levels);
    level_user=member_array(get_status(user), wiz_levels);
    
    if ( !level_ob && level_user<3 )  return 0;            // wiz set player
    return ( level_user >= level_ob );                   // wiz set wiz
}
    
int valid_write(string file, mixed user, string func)
{
    string euid;
    mixed localtime;
    
    if( !objectp(user) )
        error("valid_write: Invalid argument type of user.\n");
     
//Allow user or other object to save their data;
    if( func == "save_object" &&
        (file == (string)user->query_save_file() ||
        file == (string)user->query_save_file()+".o") )
    {
        if( creator_file(file) != "Data" ) return 0;

        if( sscanf(file, "/data/login/%*s") ||
            sscanf(file, "/data/user/%*s") )
        if( sscanf(base_name(user),"/clone/user/%*s") != 1 )
        return 0;

        return 1;
     }

//Give the player and wizard different rights; 
     if( userp(user) ) return valid(user,file);

//Protect some important files and data;
     if( func == "write_file" || func == "rename" || func == "cp" ||
         func == "rm" || func == "move_file" )
     {
         if( sscanf(file, "/include/global%*s")
             || sscanf(file, "/adm/obj/%*s") 
             || sscanf(file,"/adm/daemons/security%*s")
             || sscanf(file,"/adm/daemons/wzd_log%*s") ) 
         return 0;

         if( creator_file(base_name(user)) != ROOT_UID &&
             base_name(user) != SIMUL_EFUN_OB &&
             ( creator_file(file) == ROOT_UID ||
               creator_file(file) == "MudOS" ||
               sscanf(file,"/u/%*s") ) )
         return 0;

         if( sscanf(file,"/u/%*s") )
         if( creator_file(base_name(user)) != ROOT_UID &&
             base_name(user) != SIMUL_EFUN_OB &&
             creator_file(base_name(user)) != creator_file(file) )
         return 0;

         if( creator_file(file) == "Data" && func != "rm" )
         return 0;
     } 

//Allow the system to write, include player's suiciding;
    if( base_name(user) == SIMUL_EFUN_OB ||
        creator_file(base_name(user)) == ROOT_UID ||
        creator_file(base_name(user)) == creator_file(file) )
    return 1;

//Recording illegal users;  
    euid = geteuid(user);
    localtime=localtime(time());
    log_file(sprintf("FILES.%d%d",localtime[5],localtime[4]+1),
                      sprintf("%s %s %s failed.\n", euid, func , file));
    return 0;
}

int valid_seteuid( object ob, string uid )
{
    if( uid==0 ) return 1;
    if( uid==getuid(ob) ) return 1;
    if( getuid(ob)==ROOT_UID ) return 1;
    if( sscanf(file_name(ob), "/adm/%*s") ) return 1;
    if( wiz_status[uid] != "(admin)"
    &&  wiz_status[getuid(ob)] == "(admin)" )
        return 1;
    return 0;
}
int valid_read(string file, mixed user, string func)
{
        string str;
        object ob;
        int flag;

        if( !objectp(user) ) return 1;

        if( file == WIZLIST ) return 1;
        if( func == "stat" || func == "file_size" ) return 1;

        if( strsrch(file, ".") >= 0 ) flag = 1;
        if( !flag && sscanf(file,"/adm/%*s") != 1 ) return 1;

//Protect some important files;
        if( userp(user) )
        {
            if( get_status(geteuid(user)) != "(admin)" )
            if( sscanf(file, "/adm/obj/%*s")
                || sscanf(file,"/adm/simul_efun/%*s")
                || sscanf(file,"/adm/daemons/%*s")
                || sscanf(file,"/quest/%*s") )
            return 0;
        }

//Only system root can read root;
        if( stringp(func) )
        if( creator_file(file) == ROOT_UID &&
            creator_file(base_name(user)) != ROOT_UID && 
            base_name(user) != SIMUL_EFUN_OB )
        return 0;

//Olny user can restore for user data;
        if( func == "restore_object" && 
            (file == (string)user->query_save_file() ||
            file == (string)user->query_save_file()+".o") )
        {
            if( sscanf(file, "/data/login/%*s") || 
                sscanf(file, "/data/user/%*s") ) 
            if( sscanf(base_name(user),"/clone/user/%*s") != 1 )
            return 0;
        }

//Allow other all of other read;
        return 1;
}

