void event_dawn()
{
        object *ob_list;
        int i;
        ob_list = children("/quest/feizei/feizei");
                for(i=0; i<sizeof(ob_list); i++) 
                if(environment(ob_list[i]))
                {
                        message_vision("$N笑道：天亮了，东西也到手了，我闪！\n",ob_list[i]);
                        destruct(ob_list[i]);
                }
}

void event_midnight()
{
        string get_month, get_day;
        get_day = CHINESE_D->chinese_monthday(TIME_TICK1);
        get_month = CHINESE_D->chinese_month(TIME_TICK1);
        switch(get_month)
        {
                //spring weather
                case "三月":
                case "四月":
                case "五月":
                     switch(random(3))
                     {
                        case 0:
                           day_phase = read_table("/adm/etc/nature/spring_rain");
                           break;
                        case 1:
                           day_phase = read_table("/adm/etc/nature/spring_sun");
                           break;
                        case 2:
                           day_phase = read_table("/adm/etc/nature/spring_wind");
                           break;
                     }
                     break;
                //summer weather
                case "六月":
                case "七月":
                case "八月":
                     switch(random(3))
                     {
                        case 0:
                           day_phase = read_table("/adm/etc/nature/summer_rain");
                           break;
                        case 1:
                           day_phase = read_table("/adm/etc/nature/summer_sun");
                           break;
                        case 2:
                           day_phase = read_table("/adm/etc/nature/summer_wind");
                           break;
                     }
                     break;
                //autumn weather
                case "九月":
                case "十月":
                case "十一月":
                     switch(random(3))
                     {
                        case 0:
                           day_phase = read_table("/adm/etc/nature/autumn_rain");
                           break;
                        case 1:
                           day_phase = read_table("/adm/etc/nature/autumn_sun");
                           break;
                        case 2:
                           day_phase = read_table("/adm/etc/nature/autumn_wind");
                           break;
                     }
                     break;
                //winter weather
                case "十二月":
                case "一月":
                case "二月":
                     switch(random(3))
                     {
                        case 0:
                           day_phase = read_table("/adm/etc/nature/winter_rain");
                           break;
                        case 1:
                           day_phase = read_table("/adm/etc/nature/winter_sun");
                           break;
                        case 2:
                           day_phase = read_table("/adm/etc/nature/winter_wind");
                           break;
                     }
                     break;
                default:
                     day_phase = read_table("/adm/etc/nature/day_phase");
        }
        remove_call_out("update_day_phase");        
/*
        if ( uptime() > 172800 ) 
        {
           log_file("nosave/LASTCRASH", "System Reboot: "
                         + ctime(time()) + "\n");  

           auto_shutdown(1);
           return;
        }
*/
        init_day_phase();  
}

// This is called everyday noon by update_day_phase, defined in the
// "event_fun" field in /adm/etc/nature/day_phase

void event_noon()
{
        object *ob;
        int i, skill,con,con1,con2,con3;
        string get_month,ill,msg;
        get_month = CHINESE_D->chinese_month(TIME_TICK1);
        switch(get_month)
        {
                case "三月":
                case "四月":
                case "五月":
                     ill = "ill_kesou";
                     msg = HIG + "忽然喉头一阵痕痒，你感觉似乎要咳嗽了。\n" + NOR;
                     break;
                case "六月":
                case "七月":
                case "八月":
                     ill = "ill_zhongshu";
                     msg = HIG+"突然你胸臆之间一阵翻腾，你中暑了。\n" + NOR;
                     break;
                case "九月":
                case "十月":
                case "十一月":
                     ill = "ill_shanghan";
                     msg = HIG+"陡的你打了个冷战，头昏沉沉的，你得伤寒病了。\n"+NOR;
                     break;
                case "十二月":
                case "一月":
                case "二月":
                     ill = "ill_dongshang";
                     msg = HIG+"你肢体末端一阵僵直，看来你被冻伤了。\n"+NOR;
                     break;
        }
        if(random(2))
        {
                ill = "ill_fashao";msg = HIG+"你偶感风寒，竟而发起烧来。\n"+NOR;
        }
        ob = users();
        for(i=0; i<sizeof(ob); i++)
        {
                if( !environment(ob[i]) ) continue;
                if( !environment(ob[i])->query("outdoors") ) continue;
                if( ob[i]->query("age")==14 ) continue;
                con1 = ob[i]->query("qi");
                con2 = ob[i]->query("max_qi");
                (int)con = con1/con2*50;//形成第一个生病判断条件
                con3 = ob[i]->query("neili");
                con2 = ob[i]->query("max_neili");
                if( con2 == 0) con2 = 1;
                (int)con1 = con3/con2*50;//形成第二个生病判断条件
                if(random(con)+random(50)+random(con1)<25)
                {
                        ob[i]->apply_condition(ill, 10);
                        tell_object(ob[i], msg);
                }
        }
}

string outdoor_room_description()
{
        return "    " + day_phase[current_day_phase]["desc_msg"] + "。\n";
}
string outdoor_room_outcolor()
{
        return day_phase[current_day_phase]["outcolor"];
}

string game_time()
{
        return CHINESE_D->chinese_date(TIME_TICK1);
}

mapping *read_table(string file)
{
        string *line, *field, *format;
        mapping *data;
        int i, rn, fn;

        line = explode(read_file(file), "\n");
        data = ({});
        for(i=0; i<sizeof(line); i++) {
                if( line[i]=="" || line[i][0]=='#' ) continue;
                if( !pointerp(field) ) {
                        field = explode( line[i], ":" );
                        continue;
                }
                if( !pointerp(format) ) {
                        format = explode( line[i], ":" );
                        continue;
                }
                break;
        }

        for( rn = 0, fn = 0; i<sizeof(line); i++) {
                if( line[i]=="" || line[i][0]=='#' ) continue;
                if( !fn ) data += ({ allocate_mapping(sizeof(field)) });
                sscanf( line[i], format[fn], data[rn][field[fn]] );
                fn = (++fn) % sizeof(field);
                if( !fn ) ++rn;
        }
        return data;
}

mapping *query_day_phase() { return day_phase; }


int auto_shutdown(int flag)
{
    if( base_name(previous_object()) != "/cmds/adm/reboot"
        && base_name(previous_object()) != "/cmds/adm/shutdown" 
        && base_name(previous_object()) != NATURE_D )
    return 1;

    if (flag){
       reclaim_objects();

       message("vision", 
       RED "要当机了！放心，您的档案已经自动存储了！\n" NOR, users());

       shutdown(0);
    }
    return 1;
}
int query_dipan_check()
{
    return dipan_check;
}

void banghui_start(string *dirs)
{
        if(sizeof(dirs) < 1 ) return;
        dipan_check=1;

        if( current_area >= sizeof(dirs) )
        {
           remove_call_out("banghui_start");
           current_area = 0;
           dipan_check=0;
           return;
        }

        banghui_manage(dirs);

        remove_call_out("banghui_start");
        call_out("banghui_start",5,dirs);
        return;
}

void banghui_manage(string *dirs)
{
        object area,lp,npc,room,*ulist,*bh=({});
        string file,area_name,banghui,str;
        int k,bad,kaifa,jizhi,zhongcheng,area_money,bad_money,rest_money;
        mapping data;

        if( sizeof(dirs) < 1 ) return;
        file=dirs[current_area];
        current_area++;

        if(file[strlen(file)-2..strlen(file)] != ".o")
        return;

        if( sscanf(file,"%s.o",area_name) )
        {
            area=new("/banghui/obj/area");
            area->create(area_name);

            if( !stringp(area->query("banghui")) )
            {
                destruct(area);
                return;                   
            }  

            if( area->query("npc_room") )
            {
                room = find_object(area->query("npc_room"));
                if(!room)
                {
                   current_area--;
                   load_object(area->query("npc_room"));
                   destruct(area);
                   return;
                }
            }
            if( room && area->query("npc") &&
                objectp(npc=present(area->query("npc"),room)) &&
                npc->query("area") == area_name ) 
            {
                kaifa = npc->query("kaifa");
                jizhi = npc->query("jizhi");
                zhongcheng = npc->query("zhongcheng");
                kaifa = kaifa - random(10);
                jizhi = jizhi + random(20)-10;
                if( zhongcheng > npc->query("max_zhongcheng") )
                zhongcheng = npc->query("max_zhongcheng");                  
                zhongcheng = zhongcheng-random(3);   
                npc->set("zhongcheng",zhongcheng<10?10:zhongcheng);
                area->set("zhongcheng",zhongcheng<10?10:zhongcheng);
            } else
            {
                destruct(area);
                return;
            }

            if( random(kaifa) < jizhi/3 ) bad=1;
            else bad=0;

            area_money=area->query("money");
            if(!intp(area_money)) area_money=0;
            if( jizhi > 60 ) jizhi=60;
            if( jizhi < 6  ) jizhi=6;  
            if(!intp(kaifa) || kaifa<20 ) kaifa=20;

            if( bad )
            {
               if( jizhi && kaifa )
               {
                  bad_money= (kaifa+1)*jizhi*10000;
                  area_money -= bad_money;
               }
            } else
                  area_money+=(kaifa/2+random(kaifa/2)+1)*jizhi*10000;

            area->set("money",area_money);
            rest_money = area_money - 10000000;  
            if( rest_money > 0 )
            area->add("money",-rest_money);
            else rest_money=0;
            area->set("last_money",rest_money);  
            area->set("kaifa",kaifa);
            area->set("jizhi",jizhi);
            npc->set("jizhi",jizhi);
            npc->set("kaifa",kaifa);
            banghui = area->query("banghui");

            if( file_size("/data/guild/"+banghui+".o") == -1 )
            {
                   message("channel:rumor",HIM"【火云帮会】由于经营不善，"
                         +area->query("name")+"宣布脱离帮会"+"「"+banghui+"」"
                         +"的控制！\n"NOR,users()); 
                   area->delete("banghui");
                   area->set("money",0);
                   area->set("last_money",0);
                   area->delete("zhongcheng"); 
                   npc->delete("banghui");
                   npc->set("zhongcheng",11+random(20));
                   area->save();
                   destruct(area);
                   return;
            }
        } 

        if(stringp(banghui))
        {
            if( !bad )
                  message("channel:rumor",YEL"【火云帮会】"+area_name
                                      +"地盘收入良好。\n"NOR,users());
            else
            {
                   str=bad_weather[random(sizeof(bad_weather))];
                   str=replace_string(str,"$N",area_name);
                   message("channel:rumor",YEL"【火云帮会】"+str+
                      MONEY_D->money_str(bad_money)+"！\n"NOR,users());
            }

            lp=new("/banghui/obj/lingpai");
            lp->create(banghui);
            data=lp->query("area");
            lp->add("money",-2000000);
            lp->add("money",rest_money);
            lp->add("bang_check",1);

            if(lp->query("bang_check") == 1 )
            lp->set("bang_money",rest_money); 
            else lp->add("bang_money",rest_money);
            if( lp->query("bang_check") >= sizeof(keys(data)) ) 
            lp->set("bang_check",0); 

            if( lp->query("money") < -100000000 ) lp->set("bankrupt",1);

            if( objectp(npc) && ( area->query("money") < -10000000 || 
                lp->query("bankrupt") ) )
            {
                   message("channel:rumor",HIM"【火云帮会】由于经营不善，"
                         +area->query("name")+"宣布脱离帮会"+"「"+banghui+"」"
                         +"的控制！\n"NOR,users());

                   area->delete("banghui");
                   area->set("money",0);
                   area->set("last_money",0);
                   area->delete("zhongcheng");
                   npc->delete("banghui");
                   npc->set("zhongcheng",11+random(20)); 
                   data=lp->query("area");
                   if(! mapp(data)) data=([]);
                   map_delete(data,area_name);
                   lp->set("area",data);
                   data=lp->query("npc");
                   if(! mapp(data)) data=([]); 
                   map_delete(data,npc->query("id"));
                   lp->set("npc",data);
                   if( sizeof(keys(data)) < 1 && lp->query("bankrupt") )
                   {
                     message("channel:rumor",HIW"【火云帮会】由于经营不善，"
                     +"帮会"+"「"+banghui+"」"+"已无力维持，宣告破产！\n"NOR,users());
                     lp->delete("bankrupt");
                     lp->set("money",0);
                   }
                   lp->save();
                   destruct(lp);
                   area->save();
                   destruct(area);

                   return;
            }

             area->save();
             destruct(area);
             lp->save();
             destruct(lp);
        }

        return;
}

