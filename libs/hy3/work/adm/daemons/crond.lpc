#include <ansi.h>
#include <command.h>
#include <globals.h>
#include <net/daemons.h>
#include <net/macros.h>

int LAST_HARD_DIS= 0;
void init_cron();
void create()
{
        seteuid( ROOT_UID );
        init_cron();
}

int query_last_hard_dis()
{
        return LAST_HARD_DIS;
}

int set_last_hard_dis()
{
        LAST_HARD_DIS = time();
        return time();
}

void init_cron()
{
        mixed *local;
        local = localtime(time());

        if ( !((local[1])%40))
        {
         message("system", HIG"自动更新任务榜。\n"NOR, users()); 
         if (random(2))JOB_D->init_dynamic_quest();
          else JOB_D->init_dynamic_quest(1);
        }
        remove_call_out("init_cron");
        call_out("init_cron", 60);  
        return;
}

