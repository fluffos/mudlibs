          else
            switch (menpai) {
              case "武当派":
                if (exp > 10000000) {
                  if (shen >= 0)
                    return NOR "【" HIR " 天  师 " NOR "】";
                  else
                    return NOR "【" HIW "恶 天 师" NOR "】";
                }
                if (exp > 5000000)
                  return NOR "【" HIM " 国  师 " NOR "】";
                if (exp > 1000000)
