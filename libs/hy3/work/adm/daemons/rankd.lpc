    default:
      switch (wizhood(ob)) {
        case "(admin)":
          return NOR "【" BBLU HIW "火云总管" NOR "】";
        case "(arch)":
          return NOR "【" HIY "系统大巫" NOR "】";
        case "(wizard)":
