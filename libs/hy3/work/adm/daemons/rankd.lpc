// rankd.c
// 1996-02-15 dts ranking related to "shen"
//modified by macrohard@sdyx
#pragma save_binary

string query_rank(object ob) {
  mapping fam;
  int shen, exp;
  int budd;
  string set_title, menpai;

  exp = (int)ob->query("combat_exp");
  menpai = ob->query("family/family_name");
  shen = ob->query("shen");
  if (wizardp(ob) && ob->query("env/own_rank"))
    return NOR "【" HIW + ob->query("env/own_rank") + NOR " 】";
  if (ob->is_ghost())
    return NOR "【" HIB "孤魂野鬼" NOR "】";


  if ((fam = ob->query("family")) && fam["family_name"] == "少林派")
    budd = ob->query_skill("buddhism", 1);

  if ((int)ob->query("fight_rank") == 1) {
    if (strlen((string)ob->query("env/my_title")) == 2) {
      set_title = ob->query("env/my_title");
      return NOR "【" HIW "天下第一" + set_title + NOR " 】";
    } else
      return NOR "【" HIW "天下第一" NOR "】";
  }
  if ((int)ob->query("fight_rank") == 2) {
    if (strlen((string)ob->query("env/my_title")) == 2) {
      set_title = ob->query("env/my_title");
      return NOR "【" HIR "天下第二" + set_title + NOR " 】";
    } else
      return NOR "【" HIR "天下第二" NOR "】";
  }
  if ((int)ob->query("fight_rank") == 3) {
    if (strlen((string)ob->query("env/my_title")) == 2) {
      set_title = ob->query("env/title_race");
      return NOR "【" HIG "天下第三" + set_title + NOR " 】";
    } else
      return NOR "【" HIG "天下第三" NOR "】";
  }

  switch (ob->query("gender")) {
    case "女性":
      switch (wizhood(ob)) {
        case "(admin)":
          return NOR "【" HIW "九天玄女" NOR "】";
        case "(arch)":
          return NOR "【" HIY "系统大巫" NOR "】";
        case "(wizard)":
          return NOR "【" HIC "瑶池仙女" NOR "】";
        case "(immortal)":
          return NOR "【" CYN "梦幻精灵" NOR "】";
        default:
          if (((int)ob->query("PKS") > 50))
            return "【" HIB "饮血女魔" NOR "】";
          else if (exp >= 20000000 && shen >= 5000000)
            return HIW "【" HIR "火" HIC "云" HIY "至" HIB "尊" HIW "】" NOR;
          else if (exp >= 15000000 && shen >= 2000000)
            return HIW "【" HIR "火云" HIY "神话" HIW "】" NOR;
          else if (shen >= 5000000)
            return "【" HIC "火云天娇" NOR "】";
          else if (shen <= -5000000)
            return "【" HIW "嗜血女魔" NOR "】";
          else if ((int)ob->query("thief") > 10)
            return "【" HIW "女 惯 窃" NOR "】";
          else
            switch (menpai) {
              case "武当派":
                if (exp > 10000000) {
                  if (shen >= 0)
                    return NOR "【" HIY "武当" HIC "天师" NOR "】";
                  else
                    return NOR "【" HIR "女魔天师" NOR "】";
                }
                if (exp > 5000000)
                  return NOR "【" RED "女 国 师" NOR "】";
                if (exp > 1000000)
                  return NOR "【" HIW "女 " HIC "真 " HIW "人" NOR "】";
                if (exp > 500000)
                  return NOR "【" YEL "女大法师" NOR "】";
                if (exp > 300000)
                  return NOR "【" GRN "女 法 师" NOR "】";
                if (exp > 100000)
                  return NOR "【" CYN "女 道 长" NOR "】";
                if (exp > 25000)
                  return NOR "【" MAG "女 道 姑" NOR "】";
                if (exp > 10000)
                  return NOR "【" HIB "女 道 姑" NOR "】";
                if (exp > 5000)
                  return NOR "【" HIB " 女  冠 " NOR "】";
                return "【女 少 冠】";
              case "华山派":
                if (exp > 10000000) {
                  if (shen >= 0)
                    return NOR "【" HIW "惊" HIY "天" HIC "一" HIG "剑" NOR "】";
                  else
                    return NOR "【" HIW "惊" HIY "魔" HIC "一" HIG "剑" NOR "】";
                }
                if (exp > 5000000) {
                  if (shen >= 0)
                    return NOR "【" HIR "女 " HIW "剑 圣" NOR "】";
                  else
                    return NOR "【" HIM "女 " HIR "剑 魔" NOR "】";
                }
                if (exp > 1000000) {
                  if (shen >= 0)
                    return NOR "【" HIG "女 剑 仙" NOR "】";
                  else
                    return NOR "【" HIG "女 邪 剑" NOR "】";
                }
                if (exp > 500000)
                  return NOR "【" YEL "女 剑 痴" NOR "】";
                if (exp > 300000)
                  return NOR "【" HIB "女 剑 侠" NOR "】";
                if (exp > 100000)
                  return NOR "【" BLU "女大剑客" NOR "】";
                if (exp > 25000)
                  return NOR "【" RED "女 剑 客" NOR "】";
                if (exp > 10000)
                  return NOR "【" MAG "女大剑士" NOR "】";
                if (exp > 5000)
                  return NOR "【" MAG " 剑  士 " NOR "】";
                return "【女 剑 童】";

              case "丐帮":
                if (exp > 10000000)
                  return NOR "【" HIR "女副帮主" NOR "】" NOR;
                if (exp > 5000000)
                  return NOR "【" HIM "女大长老" NOR "】" NOR;
                if (exp > 1000000)
                  return NOR "【" HIM "女 长 老" NOR "】" NOR;
                if (exp > 500000)
                  return NOR "【" YEL "女传功使" NOR "】" NOR;
                if (exp > 300000)
                  return NOR "【" YEL "女执法使" NOR "】" NOR;
                if (exp > 100000)
                  return NOR "【" RED "女 神 丐" NOR "】" NOR;
                if (exp > 25000)
                  return NOR "【" RED "女小神丐" NOR "】" NOR;
                if (exp > 10000)
                  return HIW "【" GRN "女 乞 丐" NOR "】" NOR;
                if (exp > 5000)
                  return NOR "【" MAG "女小乞丐" NOR "】" NOR;
                return "【 叫 化 子 】";

              case "星宿派":
                if (exp > 1000000)
                  return HIW "【" GRN "女 魔 君" NOR "】" NOR;
              case "逍遥派":
                if (exp > 10000000)
                  return NOR "【" HIR "逍遥" HIW "护法" NOR "】";
                if (exp > 5000000)
                  return NOR "【" HIW "逍遥" HIC "尊者" NOR "】";
                if (exp > 1000000)
                  return NOR "【" MAG "逍遥" HIY "使者" NOR "】";
                if (exp > 100000)
                  return NOR "【" RED "逍遥" BLU "弟子" NOR "】";
              case "全真教":
                if (exp > 10000000)
                  return NOR "【" HIR "副 掌 教" NOR "】";
                if (exp > 5000000)
                  return NOR "【" HIY "全真剑圣" NOR "】";
                if (exp > 1000000)
                  return NOR "【" HIW "全真剑士" NOR "】";
                if (exp > 100000)
                  return NOR "【" HIC "全真剑客" NOR "】";
              case "古墓派":
                if (exp > 10000000)
                  return NOR "【" HIW "古墓" HIR "真君" NOR "】";
                if (exp > 5000000)
                  return NOR "【" HIY "古墓" HIC "隐士" NOR "】";
                if (exp > 1000000)
                  return NOR "【" HIC "古墓" HIY "剑客" NOR "】";
                if (exp > 100000)
                  return NOR "【" HIC "古墓" HIB "喽罗" NOR "】";
              case "灵鹫宫":
                if (exp > 10000000)
                  return NOR "【" HIR "灵鹫" HIW "副掌门" NOR "】";
                if (exp > 5000000)
                  return NOR "【" HIW "灵鹫使者" NOR "】";
                if (exp > 1000000)
                  return NOR "【" HIM "灵鹫侍剑" NOR "】";
                if (exp > 100000)
                  return NOR "【" RED "灵鹫弟子" NOR "】";
              case "峨嵋派":
                if (exp > 10000000)
                  return NOR "【" HIR "峨嵋" HIW "仙人" NOR "】";
                if (exp > 5000000)
                  return NOR "【" HIW "峨嵋师太" NOR "】";
                if (exp > 1000000)
                  return NOR "【" HIM "峨嵋剑侠" NOR "】";
                if (exp > 100000)
                  return NOR "【" RED "峨嵋弟子" NOR "】";
              case "桃花岛":
                if (exp > 10000000) {
                  if (shen >= 0)
                    return NOR "【" HIR "魔 见 愁" NOR "】";
                  else
                    return NOR "【" HIR " 狂  魔 " NOR "】";
                }
                if (exp > 5000000)
                  return NOR "【" CYN "桃花剑神" NOR "】";
                if (exp > 1000000)
                  return NOR "【" GRN "桃花剑士" NOR "】";
                if (exp > 500000)
                  return NOR "【" YEL "桃花剑客" NOR "】";
                if (exp > 300000)
                  return NOR "【" YEL "桃花门徒" NOR "】";
                if (exp > 100000)
                  return NOR "【" GRN "桃花喽罗" NOR "】";
                return "【风尘女子】" NOR;

              case "明教":
                if (exp > 10000000)
                  return NOR "【" HIR "女副教主" NOR "】";
                if (exp > 5000000)
                  return NOR "【" HIM "护教" HIR "法王" NOR "】";
                if (exp > 1000000)
                  return NOR "【" HIC "女总护法" NOR "】";
                if (exp > 500000)
                  return NOR "【" YEL "女 护 法" NOR "】";
                if (exp > 300000)
                  return NOR "【" YEL "女总堂主" NOR "】";
                if (exp > 100000)
                  return NOR "【" CYN "女副堂主" NOR "】";
                if (exp > 25000)
                  return NOR "【" CYN "女 旗 主" NOR "】";
                if (exp > 10000)
                  return NOR "【" MAG "女副旗主" NOR "】";
                if (exp > 5000)
                  return NOR "【" MAG "女 教 众" NOR "】";
                return "【  教  众  】";
              default:
                switch (ob->query("class")) {
                  case "bonze":
                    return "【 女  尼 】";
                  case "yishi":
                    return "【女 义 士】";
                  case "taoist":
                    return "【 女  冠 】";
                  case "bandit":
                    return "【女 飞 贼】";
                  case "dancer":
                    return "【" HIR "绝" HIB "色" HIY "舞" HIW "姬" NOR "】";
                  case "scholar":
                    return "【遥遥佳人】";
                  case "officer":
                    return "【 女  差 】";
                  case "fighter":
                    return "【" RED "风尘女子" NOR "】";
                  case "swordsman":
                    return "【" MAG "舞剑少女" NOR "】";
                  case "alchemist":
                    return "【女 方 士】";
                  case "shaman":
                    return "【女 巫 医】";
                  case "beggar":
                    return "【女叫花子】";
                  case "shiny":
                  case "huanu": return NOR "【" MAG "移花花奴" NOR "】";
                  case "yihuashinv": return NOR "【" MAG "移花" BLU "侍女" NOR "】";
                  case "chuanren": return NOR "【" HIR "移" HIY "花" HIC "传人" NOR "】";
                  return "【光明女使】";
                  default:
                    return NOR "【" MAG "芊芊民女" NOR "】";
                }
            }
