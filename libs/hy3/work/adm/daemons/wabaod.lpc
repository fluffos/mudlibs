#include <ansi.h>
#define TIME 600
inherit F_DBASE;
string get_long();
void insert_blank();
void init_xunbao();

string *DIRS = ({ "/d/baituo/",
  "/d/bhd/",
  "/d/city/",
  "/d/city2/",
  "/d/city3/",
  "/d/dali/",
  "/d/gaibang/",
  "/d/guanwai/",
  "/d/gumu/",
  "/d/heimuya/",
  "/d/huanhua/",
  "/d/huashan/",
  "/d/kunlun/",
  "/d/lingjiu/",
  "/d/mj/",
  "/d/mr/",
  "/d/quanzhen/",
  "/d/quanzhou/",
  "/d/shashou/",
  "/d/shaolin/",
  "/d/shenlong/",
  "/d/taohua/",
  "/d/tls/",
  "/d/village/",
  "/d/wudang/",
  "/d/xiaoyao/",
  "/d/xingxiu/",
  "/d/xuedao/",
  "/d/xueshan/",
});

void create() {
  seteuid(getuid());
  set("name", "寻宝精灵");
  set("channel_id", "寻宝精灵(xunbao)");
  set("id", "xunbao");
  CHANNEL_D->do_channel(this_object(), "sys", "寻宝系统已经启动。\n");
  init_xunbao();
}

void init_xunbao() {
  string *files, file;
  object *user, room;
  int k, i;

  user = users();
  for (i = 0; i < sizeof(user); i++)
    user[i]->delete_temp("xunbao");
  insert_blank();
  message("vision", HIB "\n【宝藏】" NOR HIC "武林野老(wulin yelao)：老夫夜观天象，又有异宝行将出土。\n\n" NOR, users());

  files = get_dir("/d/guanwai/");

  if (sizeof(files))
    for (k = 0; k < 10; k++) {
      file = files[random(sizeof(files))];
      if (file[strlen(file) - 2..strlen(file)] != ".lpc") continue;
      file = "/d/guanwai/" + file;
      if (!room = find_object(file))
        room = load_object(file);
      if (room && inherits(ROOM, room)) {
        if (random(2))
          room->add_temp("wayao1", 1);
        else
          room->add_temp("wayao2", 1);
        log_file("wabao", "****yao cao: " + file + "****\n");
      }
    }
  return;
}

void insert_blank() {
  string long, desc;
  int i, begin, lost, sep, left, tries;
  int *blanks;

  remove_call_out("init_xunbao");
  call_out("init_xunbao", TIME);
  /* bounded retry: get_long() can legitimately miss many times (and each
     miss may load an unrelated room), so don't spin forever on bad luck */
  long = "";
  for (tries = 0; tries < 50 && long == ""; tries++)
    long = get_long();
  if (long == "") return;

  begin = random((strlen(long) - 60) / 2) * 2;
  desc = long[begin..begin + 60];
  switch (random(11000) % 11) {
    case 0: case 1:
      lost = 10;
      break;
    case 2: case 3: case 4:
      lost = 9;
      break;
    case 5: case 6: case 7:
      lost = 8;
      break;
    case 8: case 9:
      lost = 7;
      break;
    case 10:
      lost = 6;
  }
  sep = 30 / lost;
  left = 30 - sep * lost;
  blanks = ({});
  for (i = 0; i < lost; i++)
    blanks += ({ (sep * i + random(sep)) * 2 });
  if (left > 4)
    blanks += ({ (30 - left + random(left)) * 2 });
  /* blanks[] is already ascending; apply highest offset first so each
     "■" replacement (which shrinks desc by one character under this
     driver's Unicode-aware strings) can't invalidate offsets still
     pending, which used to overrun desc and throw invalid ind2 */
  for (i = sizeof(blanks) - 1; i >= 0; i--)
    desc[blanks[i]..blanks[i] + 1] = "■";
  WABAO_D->set("desc", desc);
  return;
}

string get_long() {
  int i;
  string dir, file, *files, long, *lines;
  object room;
  dir = DIRS[random(sizeof(DIRS))];
  files = get_dir(dir);
  file = dir + files[random(sizeof(files))];
  if (!room = find_object(file)) if (!room = load_object(file)) return "";
  if (!inherits(ROOM, room)) return "";
  else {
    long = room->query("long");
    lines = explode(long, "\n");
    long = "";
    for (i = 0; i < sizeof(lines); i++) long += lines[i];
    if (strlen(long) < 60) return "";
    for (i = 0; i < strlen(long); i++) {
      if (long[i] < 128)
        return "";
    }
    WABAO_D->set("file", file);
    file = "\n*******************\n" + file + "\n";
    log_file("wabao", file);
    return long;
  }
}
