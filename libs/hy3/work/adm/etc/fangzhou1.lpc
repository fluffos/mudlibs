/*
       星际浪子 (方舟一号))

      make by Fan@wanxia  date:10/12/98       
*/

inherit NPC;
inherit F_SAVE;

#include <net/socket.h>

nosave int telnet_socket;
nosave mapping *rec = ({
  ([ "name": "江湖风云录",
    "addr": "202.103.252.4 6666",
    "language": "GB",
  ]),
  ([ "name": "侠客英雄传2",
    "addr": "202.116.9.59 8888",
    "language": "GB",
  ]),
  ([ "name": "四度空间",
    "addr": "140.113.5.151 7777",
    "language": "Big5",
  ]),

});
nosave mapping con_to = ([]);
nosave int in_putting = 0;
nosave string id;

void close_callback(int s);
string process_input(string str);
void read_callback(int s, mixed message);
void write_callback(int s, string message);
void close_callback(int s);
void select_connect(string arg);
void begin();

void create() {
  set_name("方舟", ({ "space" }));
  set("gender", "男性");
  set("long", "。\n");
  set("title", "星际浪子");
  set("age", 29);
  set("attitude", "heroism");
  set("generation", 0);
  set("no_die", 1);
  set("no_clean_up", 1);
  setup();

}


string query_save_file() {
  if (!stringp(id)) return 0;
  return sprintf(DATA_DIR "user/%c/%s", id[0], id);
}

int new_possess(string arg) {
  string uid;
  object me = this_player();
  uid = geteuid(me);
  if (this_object()->query_temp("possessed") || me->query_temp("possessed")) {
    write("什么？\n");
    return 1;
  }
  me->save();
  message_vision("$N化成一道光芒，被$n吸进体内。\n", me, this_object());
  set_name(me->query("name"), ({ uid }));
  if (SECURITY_D->get_wiz_level(me) > 3) {
    seteuid(uid);
    id = arg;
    this_object()->restore();
  }
  exec(this_object(), me);
  destruct(me);
  this_object()->set_temp("possessed", 1);
  this_object()->enable_player();
  call_out("begin", 1);
  return 1;
}

void init() {
  add_action("new_possess", "possess");
}

void remove() {
  close_callback(telnet_socket);
}

string process_input(string str) {
  if (!in_putting) return ::process_input(str);
  if (sscanf(str, ":%s", str) == 1) return ::process_input(str);
  if (stringp(str)) {
    if (interactive(this_object())) {
      if (con_to["language"] == "Big5")
        str = (string)LANGUAGE_D->GB2Big5(str);
    }
  }
  write_callback(telnet_socket, str);
  return "";
}

void read_callback(int s, mixed message) {
  if (con_to["language"] == "Big5")
    message = (string)LANGUAGE_D->Big52GB(message);
  write(NOR + BOLD + ">>" + NOR + message);
}

void write_callback(int s, string message) {
  int error;
  error = socket_write(telnet_socket, message + "\n");
  if (error < 0) {
    write("socket_write: " + socket_error(error) + "\n");
    close_callback(telnet_socket);
    call_out("begin", 1);
    return;
  }
}

void close_callback(int s) {
  write("第" + s + "条时光隧道已经关闭。\n");
  socket_close(s);
  in_putting = 0;
  call_out("begin", 1);
}
void begin() {
  int i;
  in_putting = 0;
  for (i = 0; i < sizeof(rec); i++)
    printf("\t %2d . %s (%s)\n", i, rec[i]["name"], rec[i]["language"]);

  write("\n\tx . 退出 \n\n\t 请选择:");
  input_to("select_connect");
}
void select_connect(string arg) {
  int i, error;
  if (!arg
    || sscanf(arg, "%d", i) != 1) {
    if (arg == "x") {
      command("quit");
      return;
    }
    begin();
    return;
  }
  if (i >= sizeof(rec)) { begin(); return; }
  con_to = rec[i];
  telnet_socket = socket_create(STREAM, "read_callback", "close_callback");
  if (telnet_socket < 0) {
    write("进入时光隧道发生麻烦: " + socket_error(telnet_socket) + "\n");
    begin();
    return;
  }
  write("你正奔向第" + telnet_socket + "条时光隧道....\n");

  error = socket_connect(telnet_socket, con_to["addr"], "read_callback", "write_callback");
  if (error < 0) {
    write(RED + "一个无形的旋涡: " + socket_error(error) + ",把你扯了回来...\n" + NOR);
    close_callback(telnet_socket);
    begin();
    return;
  }
  in_putting = 1;
}
