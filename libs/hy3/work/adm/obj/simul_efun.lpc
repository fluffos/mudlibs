// This must be after gender.c
#include "/adm/simul_efun/message.lpc"
#include "/adm/simul_efun/file.lpc"

varargs object snoop(object who, object target) {
  if (!target) return efun::snoop(who);
  if (!wizardp(who)) return 0;
  log_file("snoop", who->name() + " snoops " + target->name() +
    " at " + ctime(time()));
  return efun::snoop(who, target);
}

void shutdown(int etc) {
  if (base_name(previous_object()) != NATURE_D) return 0;
  else efun::shutdown(etc);
}
void destruct(object ob) {
  string err;

  if (ob) {
    if (previous_object())
      err = catch(ob->remove(geteuid(previous_object())));
    else
      err = catch(ob->remove(0));
    if (err) {
      if (userp(ob) && geteuid(previous_object()) != ROOT_UID)
        return;
    }
    efun::destruct(ob);
  }
}

// dump_socket_status(): the MudOS efun is gone from this driver; the same table, built from socket_status()
// (a driver without the sockets package -- the WASM build -- has no sockets to list: the table is its header only)
string dump_socket_status() {
  string ret = sprintf(
    "%-3s %-10s %-9s %-22s %s\n",
    "Fd",
    "State",
    "Mode",
    "Local Address",
    "Remote Address"
  );
#ifdef __PACKAGE_SOCKETS__
  {
    mixed *all = socket_status();
    int n;

    for (n = 0; n < sizeof(all); n++)
      if (arrayp(all[n]) && sizeof(all[n]) >= 5)
        ret += sprintf(
          "%-3d %-10s %-9s %-22s %s\n",
          all[n][0],
          all[n][1],
          all[n][2],
          all[n][3],
          all[n][4]
        );
  }
#endif
  return ret;
}

// crypt(): this driver's efun raises "Error in crypt(), check your salt" for a key longer than 255 bytes, so a long password typed at the login prompt left the
// connection at a bare prompt.  A key over the limit is cut (the same cut at every call, so the hashes still match); every ordinary password is passed on unchanged.
string crypt(string key, mixed salt) {
  if (strlen(key) > 255)
    key = key[0..254];
  while (sizeof(to_buffer(key)) > 255)            // the limit is in bytes, a CJK character takes three
    key = key[0..<2];
  return efun::crypt(key, salt);
}
