// MERCHANT JOB NPC yfeng
// Create by zeus@火云 Nov.19.1999

#include <ansi.h>

int give_job();

inherit NPC;

void create()
{
        set_name(HIY"胡子"NOR, ({ "edw"}) );
	set("title", HIW"商行老板 "NOR);
	set("gender", "男性" );
	set("age", 24);
	set("long",
		"这位就是商行的老板，可以向他要任务做吗！\n");
	set("attitude", "friendly");
	set("rank_info/respect", "老板");
	set("inquiry", ([
		"job":		(:give_job:),
		"炒卖货物":	(:give_job:),
	]) );
	setup();

        set("chat_chance", 10);
        set("chat_msg", ({
"胡子嚷道：“这袖子又去哪里偷懒了。”\n",
"胡子伸出右大姆指, 道：“在火云里干得活最多的自然是我胡子。”\n",
"胡子好奇地问：“火云里这么多妹妹，哪个妹妹好呢？”。\n",
"胡子叹息道，“可惜可惜，现在还没有谁能打死我！”\n",
"胡子神秘一笑, 道，“听说火云要新加一个世纪大城，到时肯定有好玩。”\n",
"胡子怒冲冲, 高声叫嚷，“非要打倒死袖子。”\n",
"胡子笑嘻嘻地说道：“袖子这家伙只会拿着个电转在地基里挖来挖去。”\n",
        }) );
}

void init()
{	
	object ob;

	::init();
	if (base_name(environment()) != query("startroom")) return;
	if( interactive(ob = this_player()) && visible(ob) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if (!ob || !present(ob, environment())) return;
	say( "胡子说：“这位" + RANK_D->query_respect(ob)	+ "，你是来这里做生意的吧。\n");
}


void relay_emote(object me,string arg)
{
	command(arg+" "+me->query("id"));
}

int give_job()
{
	object ob;
	object me;
	
	ob=this_player();
	me=this_object();
	
	tell_object(ob,JOB_OB("merchant/chaomai")->ask_job(me,ob));
	return 1;
}

int accept_object(object apper, object ob)
{
	object me = this_object();
	object pinju;
	
	if ( apper->query_temp("merchant/chaomai/now_money") <= 10000 )
	{
		command("club");
	    command("say TMD，砸了我的生意扣你的钱。");
		apper->add("balance",-10000);
		apper->delete_temp("merchant/chaomai");
		apper->delete_temp("job");
		apper->clear_condition("job_chaomai");
		return 1;
	}

	if ( !apper->query_temp("merchant/chaomai/given")){
		command("say 什么意思吗？\n");
		return 0;
	}
	if ( ob->query("id") != "check book" ){
		command("say 买卖做完了，支票本想不还，没这好事。");
		return 0;
	}

	if ( pinju=present("good check",apper) )
		destruct(pinju);

	command("grin");
    command("hehe "+apper->query("id"));
    command("say 不错，欢迎下次在来炒卖货物。");
    tell_object(apper,JOB_OB("merchant/chaomai")->give_gifts(apper));
    return 1;
}



void kill_ob(object ob)
{
    ob->die();
}
