#define BABY_DIR        "/data/baby/"
inherit NPC;
inherit F_SAVE;
nosave int last_age_set;

void update_age()
{
    if (!environment()) return;

    if( !last_age_set ) last_age_set = time();
    add("mud_age", time() - last_age_set);
    last_age_set = time();
    set("age",  ((int)query("mud_age") / 86400));
}

string query_save_file()
{
     string file;
     if( !stringp(query("parents/mother"))
         || !stringp(query("parents/father")) ) return 0;
     file=query("parents/father")+"_"+query("parents/mother");
     return sprintf(BABY_DIR"%s", file);
}

int save()
{
    int res;
    update_age();
    res = ::save();
    return res;
}

void die()
{
        object killer,corpse;

        if( environment() && environment()->query("leitai") )
        return ::die(); 

        killer=this_object()->query_temp("last_damage_from");

        if( killer )
        {
          message("channel:rumor",HIM"【江湖谣言】某人："NOR
                +HIW"我看见"+this_object()->name()+"被"+killer->name()
                +"杀害了，真是惨无人道啊！\n"NOR,users());
          
          if( userp(killer) )
          killer->apply_condition("killer",1000+killer->query_condition("killer"));
        } else
        message("channel:rumor",HIM"【江湖谣言】某人："NOR
                +HIW"听说"+this_object()->name()
                +"死了，死状惨不忍睹！\n"NOR,users());

        if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
        corpse->move(environment());
        add("DIED",1);
        if( userp(killer) ) add("PKD",1);
        add("shen", - (int) query("shen") / 10);
        add("combat_exp", - (int) query("combat_exp") / 50);

        if ( (int)query("potential") > (int)query("learned_points") )
        add("potential",
            ((int)query("learned_points")-(int)query("potential"))/5 );
        this_object()->skill_death_penalty();
        save();

        destruct(this_object());
        return;
}

