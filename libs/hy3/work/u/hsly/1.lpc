// baowu.c
// by smash
#include <ansi.h>
inherit ITEM;


void create() {
  set_name(HIG "宝物" NOR, ({ "bao wu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "你挖出来的宝物，不知道有什么作用。\n");
    set("unit", "个");
    set("value", 50);
    set("mingjiao", 1);
  }
}
int init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  object me = this_player();


  if (arg == "bao wu") {
    message_vision(HIW "$N小心翼翼的将宝物打开。\n" NOR, me);
    tell_object(me, HIW "哇，好神奇，你的经验增加了。\n" NOR);
    tell_object(me, HIM "老板看你挖的好辛苦，忍不住赏了你50点潜能,千万别声张啊。。\n" NOR);
    me->add("combat_exp", 1000);
    me->set("title", NOR BWHT BLK " 渝·A0047" RED "警 " NOR);
    destruct(this_object());
  }
  return 1;
}
