#include <ansi.h>
inherit NPC;

int to_quit();
string this_job();
string give_baochou();
string cizhi();

void create()
{
        set_name("张员外",({"zhang yuanwai", "zhang", "yuanwai"}));
        set("age",38);
        set("max_qi",5000);
        set("eff_qi",5000);
        set("qi",5000);
        set("max_jing",500);
        set("eff_jing",500);
        set("jing",500);
        set("combat_exp",10000);

        set_skill("unarmed",50);
        set_skill("dodge",50);
        set_skill("parry",50);
        set_skill("cuff",50);

        set("startroom","/d/city2/xidan");
        set("start_time",time());
        set("str",20);
        set("per",20);
        set("con",20);
        set("chat_chance",20);
        set("chat_msg",({
                (: random_move :),
                "张员外叹了口气道："CYN"哎！这世上为什么会有怎么多人想杀我？！\n
"NOR,
                (: random_move :),
                "张员外自言自语的说道："CYN"也不知道这些保镖能不能保护好我的安全
。\n"NOR,
                (: random_move :),
                "张员外自怨自艾的说："CYN"如果我死了，我那些财产也不知道给谁？\n
"NOR,
                (: random_move :),
                "张员外很很的看了你一眼："CYN"你也许是个不错的保镖。\n"NOR,
                (: random_move :),
        }));
        
        set("inquiry",([
                "保镖" : CYN"我正在找保镖，你愿意干吗？我的报酬可高着呢！\n"NOR,
                "报酬" : (: give_baochou :),
                "工作" : (: this_job :),
                "辞职" : (: cizhi :),
        ]));

        setup();


        carry_object("/d/city/obj/jinsijia")->wear();
        carry_object("/d/city/obj/cycle")->wear();
        carry_object("/d/city/obj/toukui")->wear();
        carry_object("/d/city/obj/pixue")->wear();
        carry_object("/d/city/obj/surcoat")->wear();
        carry_object("/d/city/obj/huwan")->wear();



}

void init()
{
        object *env,ob=this_object();
        int baobiao=0,i;

        env=all_inventory(environment(ob));
        for(i=0;i<sizeof(env);i++)
        {
         if(userp(env[i]) && env[i]->query_temp("baobiaod"))
         baobiao++;
        }
         ob->set("baobiao",baobiao);

        if(baobiao && (time()-ob->query("start_time"))>100
          && (time()-ob->query("last_yuxian"))>100)
        {
         for(i=0;i<sizeof(env);i++)
         {
         if(userp(env[i]) && env[i]->query_temp("baobiaod"))
         call_out("yuxian",0,env[i]);    
         }
         set("last_yuxian",time());
        }
}
int yuxian(object ob)
{
        object cike,*env,me = this_object();

                cike=new(__DIR__"cike");   
                cike->move(environment(me));
                cike->command("follow "+me->query("id"));
                cike->kill_ob(me);
                cike->kill_ob(ob);   
        return 1;
}

string give_baochou()
{
        object user = this_player(1), golds;
        int gold, i;

        if(!user->query_temp("baobiaod")) 
                  return RANK_D->query_respect(user)+"你我
素不相识，何出此言？";
        gold = user->query_temp("baobiao_baochou");
        if(!gold) return "我这里是按劳分配，多做贡献就多报酬，所以......嘿嘿。";
        for(i = 0; i < gold; i++) {
                golds = new("/clone/money/gold");
                golds->move(user);
        }

        user->set_temp("baobiao_baochou",0);        
        return RANK_D->query_respect(user)+"这是你应的的"+HIR+chinese_number(gold)+CYN"两"HIY"黄金\n"NOR;
}

string this_job()
{
        object me = this_object(), user = this_player(1);
        int baobiao = me->query("baobiao");

        if ((int)user->query("combat_exp")<800000)
                return "多谢这为"+RANK_D->query_respect(user)+
            "关爱，可是阁下的身手好象勉强了点吧。\n";   
        if (user->query_temp("baobiaod")) return RANK_D->query_respect(user)+
        "不是已经答应给我做保镖了吗？你可不要反悔呀！\n";   
        if(baobiao >= 8) return "多谢这为"+RANK_D->query_respect(user)+
        "关爱，但我现在身边的保镖够多了。\n";     
        user->set_temp("baobiaod",1);
        user->command("follow zhang yuanwai");
        user->set("baktitle",user->query("title"));
        user->set("title",HIW"终极保镖"NOR);
        return RANK_D->query_respect(user)+"来的正好，我这里正需要保镖呢！\n";
}

string cizhi()
{
        object me = this_object(), user = this_player(1);
        if(!user->query_temp("baobiaod")) return RANK_D->query_respect(user)+"何
出此言？\n";
        user->set("title",user->query("baktitle")?user->query("baktitle"):user->
query("title"));
        return "既然如此我也不能强求了，这些日子有劳照顾了！\n";
}
void unconcious()
{
       object me = this_object();

       me->command("chat 啊——！");
       me->command("chat 救命，救命呀！保镖们都死哪去了？ 啊——！！！");
       tell_object(all_inventory(environment(me)),
                   HIC"张员外啊的一声惨号，倒在地上死了！\n"NOR);
       new(__DIR__"yuanwai")->move("/d/city2/xidan");
       destruct(me);
       return;
}



