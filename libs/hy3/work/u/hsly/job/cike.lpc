inherit NPC;
#include <ansi.h>

void create()
{
        int level,exp;

        set_name("黑衣刺客",({"heiyi cike", "cike"}));
        set("age",28);
        set("max_qi",1800);
        set("max_jing",1200);
        set("max_neili",2500);
        set("neili",2500);

        exp=150000*(5+random(5))/10;
        set("combat_exp",exp);
        level = ceil( pow( exp*10.0, 0.333333) );
        set("jiali",30);

        set_skill("unarmed",level);
        set_skill("dodge",level);
        set_skill("parry",level);
        set_skill("whip",level);
        set_skill("force",level);
        set_skill("hunyuan-yiqi",level);
        set_skill("jingang-quan",level); 
        set_skill("shaolin-shenfa",level);
        set_skill("riyue-bian",level);
        set_skill("buddhism",level);
 
        map_skill("force","hunyuan-yiqi");
        map_skill("whip","riyue-bian");
        map_skill("dodge","shaolin-shenfa");
        map_skill("parry","jingang-quan");
        map_skill("unarmed","jingang-quan"); 

        set("str",22);
        set("dex",22);
        set("con",22);
        setup();
        carry_object("/clone/weapon/changbian")->wield();
        carry_object("/d/city/npc/obj/tiejia")->wear();           
}

int to_kill_yuanwai()
{
        object *env,me = this_object();
        int i;
        env=all_inventory(environment(me));  
        for(i=0;i<sizeof(env);i++)
        {
         if(userp(env[i]) && env[i]->query_temp("baobiaod")
            && !env[i]->is_fighting(me)) 
         me->kill_ob(env[i]);
        }
        return 1;
}
void unconcious()
{
    object ob=this_object(),me;
    int exp=(int)ob->query("combat_exp");
    exp=exp/500+random(exp/500);
     
    me=ob->query_temp("last_damage_from");

    if( present((string)me->query("id"),environment(ob))
        && userp(me)  
        && present("zhang yuanwai",environment(ob)))
    {                
    tell_object(me,sprintf(
    HIW"你得到了奖励："HIR"%d"HIW"点经验值和"HIR"%d"HIW"点潜能\n"NOR
        ,exp,exp/5));
        me->add("combat_exp",exp);
        me->add("pontential",exp/5);
        me->add_temp("baobiao_baochou",5);
    }
    tell_object(all_inventory(environment(ob)),
          HIC"黑衣刺客啊的惨号一声，倒在地上死了！！\n"NOR);
    destruct(ob);
    return;
}  

void check_me()
{
    if(!objectp(present("zhang yuanwai",environment(this_object()))))
    {
       this_object()->command("say 张员外那个狗贼跑了，大伙撤！");
       destruct(this_object());
    }
         else this_object()->to_kill_yuanwai();
}

void init()
{
   check_me();
} 
