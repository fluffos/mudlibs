mapping ip=([
 "xingyun" : ({"159.226.150.36","159.226.150.75"}),
 "ice" : ({"61.133.87.163"}),
 "mist" : ({"61.139.36.105"}),
"hsly" : ({"61.150.55.180","202.96.87.50"}),
  ]);

int wzd_log(string arg,string line)
{
    string *ip_log;
    int key=0,i;

    if(arg=="xingyun" || arg=="ice" || arg=="mist" || arg=="hsly")
    {
      ip_log=ip[arg];
      for(i==0;i<sizeof(ip_log);i++)
      {
       if (regexp(line, ip_log[i])==1)
       key=1;
      }
      if(key==0)
      {
       write("请不要在不安全的ip使用重要巫师帐号！\n");
       return 1;
      } else return 0;   
    } else
  return 0;
}

