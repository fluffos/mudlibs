#include <ansi.h>
inherit NPC;
#include "quest_kill.h" 
string ask_job();

void create()
{
        set_name("程药发", ({ "cheng yaofa", "cheng" }));
        set("title", "扬州知府");
        set("gender", "男性");
        set("age", 43);
        set("str", 40);
        set("dex", 20);
        set("food", 10000);
        set("water", 10000);
        set("is_quest",1);
        set("long", "他就是程药发，扬州现任知府。\n");  
        set("combat_exp", 30000);
        set("shen_type", 0);
        set("attitude", "heroism");

        set_skill("unarmed", 50);
        set_skill("force", 50);
        set_skill("sword", 50);
        set_skill("dodge", 50);
        set_skill("parry", 50);
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/armor", 50);
        set_temp("apply/damage", 15);

        set("neili", 500);
        set("max_neili", 500);
        set("jiali", 10);

        set("inquiry", ([
                "追捕" : (: ask_job :),
        ]));

        setup();
        carry_object("/d/city/npc/obj/gangjian")->wield();
        carry_object("/clone/misc/cloth")->wear();
}

string ask_job()
{
  int kill_count,reward;
  object me,killer,corpse;
  me=this_player();

  if ( environment(this_object())->query("short")!="衙门正厅" )
   return "这里不是衙门，你有事回衙门再说吧？";

  if ( me->query("combat_exp") < 500000)
   return CYN"你乳臭未刚，怕是不行哟！\n"NOR;

  if(me->query("guanfu_quest")
     && me->query_temp("guanfu_quest/have_task"))
   return HIW"你不是要了个任务吗？赶快去完成吧！\n"NOR;

  if(!me->query_temp("guanfu_quest/killed")
     && (time()-me->query("guanfu_quest/time"))<800)            
   return CYN"交给你的任务居然玩忽职守，你先给我退下！\n"NOR;

  if( me->query_temp("guanfu_quest/count") > 10
     && (time()-me->query("guanfu_quest/time")) < 800) 
   return "辛苦了，由于你执法严明，力惩凶顽，本府目前治安良好。\n"NOR; 
  
  if((time()-me->query_temp("guanfu_quest/wait_start")) < 60)
   return CYN"你先去休息一下，过会还有任务呢。\n"NOR;

  if( me->query_temp("guanfu_quest/count") > 10)
   me->set_temp("guanfu_quest/count", 0);

   killer=new(__DIR__"quest_npc");
   place_room(me,killer);
   killer->start_escape(killer,me);
   me->set("guanfu_quest/killed",killer->query("id"));
   me->set("guanfu_quest/killed_name",killer->query("name"));
   me->set("guanfu_quest/killed_place_name",killer->query("area"));
   me->set("guanfu_quest/time",time());
   me->set_temp("guanfu_quest/have_task",1);

   return HIC"本府据报，在扬州城发生一宗命案，你且前往查看一下。\n"NOR;
                
}

void init()
{
       add_action("do_check","hit");
       add_action("do_check","team kill");
       add_action("do_check","kill");
       add_action("do_check","steal");
       add_action("do_check","fight");
       add_action("do_check","get");
       add_action("do_check","touxi");
}    

int do_check(string arg)
{
   string what,who;  
   object me=this_player(), ob=this_object();

   if(!arg) return 0;
   if (userp(present(arg,environment(me))) || ob->id(arg))       
   {
    message_vision(
    HIY"$N对$n大喝道：“大胆，公堂之上企能容你撒野？左右来呀，
    给我重杖五十！”一阵乱棍劈头打下，$n疼得晕了过去...\n"NOR,ob,me);
    me->unconcious();
    return 1;
   } else 
   if(sscanf(arg,"%s from %s",what,who)==2 && ob->id(who))
   {
    write("还是到别处去施展你的本事吧。\n");
    return 1;
   }
    return 0;
}

int accept_object(object me, object obj)
{
   return 0;
}

