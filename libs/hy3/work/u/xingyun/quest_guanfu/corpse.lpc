#include <ansi.h>
inherit ITEM;

void create()
{        
     set_name(HIW"无名尸体"NOR, ({ "corpse" }));
     if (clonep())
               set_default_object(__FILE__);
     else
     {
         set("long", 
         "一具无名尸体，尸体上伤痕累累，据说官府正派人前来查看(chakan)。\n");
         set("unit", "具" );
         set("value", 100);
         set("no_get",1);
         set("no_put",1);
     }

     set("no_clean_up",1);
     set("checker","xingyun");
     setup();
}

void init()
{
    if( this_player()->query("id") == this_object()->query("checker"))
    add_action("do_check","chakan");
}

void start_decay()
{
   call_out("destroy_me",300,this_object());
}

int destroy_me(object ob)
{
   if(objectp(ob))
   {
    remove_call_out("destroy_me");
    destruct(ob);    
   }
   return 1;
}

