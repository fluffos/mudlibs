#include <ansi.h>
inherit ITEM;
void setup() {}

void init() {
  add_action("do_open", "open");
}

void create() {
  set_name(HIR "大礼包" NOR, ({ "da libao", "libao", "bag" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是节日大礼包哟，快打开(open)看看！\n");
  }
  set("no_drop", 1);
  set("no_give", 1);
  set("no_put", 1);
  set("no_get", 1);
  set("no_steal", 1);
  set("no_sell", 1);

  set("owner_id", this_player()->query("id"));
  set("owner", this_player()->query("name"));
  setup();
  call_out("check_owner", 1, this_object());
}

int do_open(string arg) {
  object me = this_player();
  int exp, i, pot, n1, n2, n3, n4;

  if (!id(arg))
    return notify_fail("你要打开什么？\n");

  exp = 50000 + random(50000);
  pot = 20000 + random(20000);
  n1 = random(2);
  n2 = random(3);
  n3 = random(6);
  n4 = random(6);

  message("channel:rumor", HIM "【谣言四起】" + me->query("name") +
    "(" + capitalize(me->query("id")) + ")" + ": 我得到了" +
    this_object()->query("owner") + "送的节日大礼包啰！\n" NOR, users());

  tell_object(me,
    HIY "火云录2000全体巫师组恭贺各位新老玩家节日快乐！谨致以节日"
    + "问候之礼品一份！\n" + "您得到了" + exp + "点经验，" + pot + "点潜能！\n" NOR);
  me->add("combat_exp", exp);
  me->add("potential", pot);
  if (n1)
    for (i = 0; i < n1; i++)
      new("/u/xingyun/biwu/obj/puti-zi")->move(this_player());

  if (n2)
    for (i = 0; i < n2; i++)
      new("/u/xingyun/biwu/obj/tianshan-xuelian")->move(this_player());

  if (n3)
    for (i = 0; i < n3; i++)
      new("/u/xingyun/biwu/obj/renshen")->move(this_player());

  if (n4)
    for (i = 0; i < n4; i++)
      new("/u/xingyun/biwu/obj/shouwu")->move(this_player());
  tell_object(me, BLINK + HIC "你身上好象一沉，多了点东西，快看看哟！\n" NOR);
  destruct(this_object());
  return 1;
}

int check_owner(object ob) {
  object me = this_player();

  if (ob->query("owner_id") != "xingyun") {
    message("channel:rumor", HIB "【谣言四起】天哪！" + me->query("name") +
      "(" + capitalize(me->query("id")) + ")" + "正在偷礼物！\n" NOR, users());
    destruct(this_object());
  } else
    return 1;
}
