// hong-pingguo.c 红苹果
#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR"红苹果"NOR, ({"hong pingguo", "pinguo", "apple"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "粒");
                set("long", "这是一粒通红的苹果，晶莹剔透，透着诱人的香气！\n");
                set("value", 5000000);
        }

        set("owner_id",this_player()->query("id"));
        set("owner",this_player()->query("name"));
        setup();
        call_out("check_owner",2,this_object());
}

int do_eat(string arg)
{
       object me=this_player();

       if (!id(arg))
       return notify_fail("你要吃什么？\n");

    message("channel:rumor", HIM"【谣言四起】"+me->query("name")+
"("+capitalize(me->query("id"))+")"+": 我偷吃了"+
this_object()->query("owner")+"给的一粒红苹果！\n"NOR,users());

       me->add("combat_exp",40000);
       me->add("potential",35000);
       destruct(this_object());
       return 1;
}

int check_owner(object ob)
{
     object me=this_player();

     if(ob->query("owner_id")!="hsly" 
        && ob->query("owner_id")!="xingyun")
      {
      message("channel:rumor", HIB"【谣言四起】天哪！"+me->query("name")+
"("+capitalize(me->query("id"))+")"+"正在偷苹果！\n"NOR,users());
      destruct(this_object());
      } else
      return 1;
}      


