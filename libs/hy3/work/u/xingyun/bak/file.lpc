string base_name(object ob)
{
        string file;
        if( sscanf(file_name(ob), "%s#%*d", file)==2 )
                return file;
        else
                return file_name(ob);
}

void log_file(string file, string text)
{
        write_file(LOG_DIR + file, text);
}    

private int valid(object obj,string filename)
{
    string euid;

    if (!obj)   return 0;
    euid=geteuid(obj);

    switch ( SECURITY_D->get_status(obj) ){
        case "(player)"     :   
        return 1;
        case "(immortal)"   :   return 0;
        case "(wizard)"     :
            if (sscanf(filename,"/u/"+euid+"/%*s"))
                return 1;
            write("警告：你只能操作属于自己目录下的文件。\n");
            return 0;
        case "(arch)"     :
            if (sscanf(filename,"/u/"+euid+"/%*s")
               ||sscanf(filename,"/d/%*s")
               ||sscanf(filename,"/kungfu/%*s")
               ||sscanf(filename,"/doc/%*s"))
                return 1;
            write("警告：你不能操作这些目录下的文件。\n");
            return 0;
        case "(admin)"      :   return 1;
    }
    return 0;
}

void ed(string filename)
{
    string str,cmd;
    object me,ob;

    me=this_player();
    ob=previous_object();

    str="On "+ctime(time())+"\n"+
       "This Player: "+me->query("name")+"("+me->query("id")+")\n"+
       "Previous Object: "+base_name(ob)+"\n";

    if ( valid(ob,filename)
         && sscanf(base_name(ob),"/cmds/%*s",cmd)==1) 
    { 
     str+="Edit file: "+filename+"\n"+
       "--------------------\n";
     log_file("trace/file/ed_file",str);

     return efun::ed(filename);
    } else
    {
     str+="Try to edit file: "+filename+"\n"+
       "--------------------\n";
     log_file("trace/file/try_ed_file",str);

     return;
    } 
}

int cp( string src, string dst )
{
    string str,cmd;
    object me,ob;

    me=this_player();
    ob=previous_object();

     str="On "+ctime(time())+"\n"+
       "This Player: "+me->query("name")+"("+me->query("id")+")\n"+
       "Previous Object: "+base_name(ob)+"\n";

    if ( valid(ob,dst)
         && sscanf(base_name(ob),"/cmds/%*s",cmd)==1) 
    { 
     str+="Cp file: "+src+" to "+dst+"\n"+ 
       "--------------------\n";
     log_file("trace/file/cp_file",str);

     return efun::cp(src,dst); 
    } else
    {
     str+="Try to cp file: "+src+" to "+dst+"\n"+
       "--------------------\n";
     log_file("trace/file/try_cp_file",str);

     return 0;
    } 
}

int rename( string src, string dst )   
{
    string str,cmd;
    object me,ob;

    me=this_player();
    ob=previous_object();

     str="On "+ctime(time())+"\n"+
       "This Player: "+me->query("name")+"("+me->query("id")+")\n"+
       "Previous Object: "+base_name(ob)+"\n";

    if ( !valid(ob,dst)
         || sscanf(base_name(ob),"/cmds/%*s",cmd)!=1)
    {
     str+="Try to mv file: "+src+" to "+dst+"\n"+
       "--------------------\n";   
     log_file("trace/file/try_mv_file",str);

     return 1;
    } else
    {
     str+="Mv file: "+src+" to "+dst+"\n"+
       "--------------------\n";
     log_file("trace/file/mv_file",str);

     return efun::rename(src,dst);
    }
}

int rm( string filename)
{
    string str,cmd;
    object me,ob;

    me=this_player();
    ob=previous_object();

     str="On "+ctime(time())+"\n"+
       "This Player: "+me->query("name")+"("+me->query("id")+")\n"+
       "Previous Object: "+base_name(ob)+"\n";

    if ( valid(ob,filename) 
         && sscanf(base_name(ob),"/cmds/%*s",cmd)==1)
    { 

     str+="Rm file: "+filename+"\n"+
       "--------------------\n";
     log_file("trace/file/rm_file",str);

     return efun::rm(filename);  
    } else
    {
     str+="Try to rm file: "+filename+"\n"+
       "--------------------\n";
     log_file("trace/file/try_rm_file",str);

     return 0;
    }
}

void cat(string file)
{
    if (file_size(file) < __LARGEST_PRINTABLE_STRING__)
            write(read_file(file));
        else
            write("文件“"+file+"”太长，请用more命令。\n");

}

void assure_file(string file)
{
        string path, *dir;
        int i;
        if( file_size(file)!=-1 ) return;
        seteuid(ROOT_UID);
        dir = explode(file, "/");
        dir = dir[0..sizeof(dir)-2];
        path = "/";
        for(i=0; i<sizeof(dir); i++) {
                path += dir[i];
                mkdir(path);
                path += "/";
        }
}

