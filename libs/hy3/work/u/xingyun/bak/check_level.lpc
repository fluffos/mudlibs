void check_level(object me) {
  mapping skill_status;
  string *sname;
  int level, i, exp, *skills;

  if (!interactive(me)) return;

  exp = (int)me->query("combat_exp");
  level = ceil(pow(exp * 10.0, 0.333333));

  if (me->query("age") < 20)
    return;

  if (!(skill_status = me->query_skills()))
    return;

  sname = keys(skill_status);
  skills = values(skill_status);

  for (i = 0; i < sizeof(skill_status); i++) {
    if (SKILL_D(sname[i])->type() != "knowledge"
      && sname[i] != "literate" && sname[i] != "taoism"
      && sname[i] != "mahayana" && sname[i] != "buddhism"
      && sname[i] != "mizong-xinfa")
      if (skills[i] > level)
        me->set_skill(sname[i], level);
  }
  return;
}
