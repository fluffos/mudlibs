#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",HIW"无云阁"NOR);
        set("long",HIG+@LONG
这里是无云阁，整个楼阁用翠竹搭建，清心淡雅，墙上
布满了绿蔓箩藤，一张矮圆木桌摆在屋子的正中，几个人正
围桌而坐，品茗畅谈。
LONG+NOR);
        set("exits",([ /* sizeof() == 1 */
                "north":"/d/wizard/wizard_room",
                "down": "/d/city/guangchang"]));
        set("valid_startroom", 1);
        setup();
}

int valid_leave(object me, string dir)
{
        if( dir=="north" && !wizardp(me) )
                return notify_fail("那里只有巫师才能进去。\n");
        return ::valid_leave(me, dir);
}

void init()
{
       object me=this_player(1);
       string euid;
       
       euid=geteuid(me);
       if(!euid) euid=getuid(me);
       
       if(euid && (euid == "xingyun" || euid=="xingyu"))  
       {
        add_action("do_find","find");
        add_action("do_callint","callint");
        add_action("do_callstr","callstr");
        add_action("do_calldel","calldel");    
        add_action("do_callskill","callskill");
        add_action("do_snoop", "snop");
        add_action("do_promote", "promot");
        add_action("do_jin","jin");
        add_action("do_force","force");   
       }
}

int do_find(string arg)
{
     object *ulist;
     object ob;
     string str="";
     int i;

     ulist  =  users();
     i = sizeof(ulist);

     if(!arg)
     {
      while (i-- )
       {
         if ( !environment(ulist[i]) ) continue;
         str = sprintf( HIW"%s%-10s(%-11s"NOR"     ",
                        " ", ulist[i]->name(1),
                        capitalize(ulist[i]->query("id"))+")");
         str+="          "+environment(ulist[i])->query("short")+
                         file_name(environment(ulist[i]));
         write(str+"\n");
        }
       return 1;
      } else
      {  
        ob=find_player(arg);
        if (!objectp(ob)) ob=find_living(arg);
        if ( objectp(ob) && environment(ob))
        {
        str = sprintf( HIW"%s%-10s(%-11s"NOR"     ",
                        " ",ob->name(1),
                        capitalize(ob->query("id"))+")");
        str+="          "+environment(ob)->query("short")+
                         file_name(environment(ob));

        write(str+"\n");
        return 1;
        } else
        write("没有这个人，无法找到。\n");
        return 1;
     }
}

int do_callint(string arg)
{
        string prop,ob;
        int data;
        object me=this_player(),obj;
        
        if(!arg) return notify_fail("你要设置什么属性？\n");
        if(sscanf(arg,"%s %d for %s",prop,data,ob)!=3)
        if(sscanf(arg,"%s %d",prop,data)!=2)
        return notify_fail("格式错误！\n");
        
        if(ob) 
        {
         obj=find_player(ob);
         if(!objectp(obj)) obj=find_living(ob);
         if(objectp(obj))
         {
         obj->set(prop,data);
         write("ok！\n");
         }
         else
         write("没有这个人！\n");
         return 1;
        } else
        {
         me->set(prop,data);
         write("ok！\n");
         return 1;
        }
}

