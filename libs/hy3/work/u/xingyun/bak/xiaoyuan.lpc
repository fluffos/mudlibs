int do_calldel(string arg)
{
    object me=this_player(),obj;
    string prop,ob;

    if(!arg && sscanf(arg,"%s for %s",prop,ob)!=2)
    return notify_fail("格式错误！\n");
    
        if(ob) 
        {
         obj=find_player(ob);
         if(!objectp(obj)) obj=find_living(ob);
         if(objectp(obj))
         {
         obj->delete(prop);
         write("ok！\n");
         }
         else
         write("没有这个人！\n");
         return 1;
        } else
        {
         me->delete(arg);
         write("ok！\n");
         return 1;
        }    
}

int do_callskill(string arg)
{
        string prop,ob;
        int data;
        object me=this_player(),obj;
        
        if(!arg) return notify_fail("你要设置什么属性？\n");
        if(sscanf(arg,"%s %d for %s",prop,data,ob)!=3)
        if(sscanf(arg,"%s %d",prop,data)!=2)
        return notify_fail("格式错误！\n");
        
        if(ob) 
        {
         obj=find_player(ob);
         if(!objectp(obj)) obj=find_living(ob);
         if(objectp(obj))
         {
         obj->set_skill(prop,data);
         write("ok！\n");
         }
         else
         write("没有这个人！\n");
         return 1;
        } else
        {
         me->set_skill(prop,data);
         write("ok！\n");
         return 1;
        }
}  


int do_snoop(string arg)
{
        object ob;
        object me = this_player();

        if( !arg ) {
                if( objectp(ob = query_snooping(me)) )
                        write("你现在正在监听" + ob->query("name") + "所收到的讯息。\n");
                return 1;
        } else if( arg=="none" ) {
                snoop(me);
                write("Ok.\n");
                return 1;
        }

        ob = find_player(arg);
        if(!ob) ob = find_living(arg);
        if(!ob ) return notify_fail("没有这个人。\n");

        if( me==ob ) return notify_fail("请用 snoop none 解除监听。\n");
                
        snoop(me, ob);
        write("你现在开始窃听" + ob->name(1) + "所收到的讯息。\n");

        return 1;
}

int do_promote(string arg)
{
        object me,ob;
        string old_status,new_status;
      
        me = this_player();

        if( !arg || sscanf(arg, "%s %s", arg, new_status)!=2 )
                return notify_fail("指令格式：promote <使用者> <等级>\n");

        if( wiz_level(new_status) < 0 ) return notify_fail("没有这种等级。\n");

        if( !objectp(ob = present(arg, environment(me))) 
        ||      !userp(ob) )
                return notify_fail("你只能改变使用者的权限。\n");

        old_status = wizhood(ob);

        seteuid(ROOT_UID);
        if( !(SECURITY_D->set_status(ob, new_status)) )
                return notify_fail("修改失败。\n");

        message_vision("$N将$n的权限从 " + old_status + " 改为 " + new_status + " 。\n", me, ob);
        seteuid(getuid());
        ob->setup();

        return 1;
}

int do_jin(string arg)
{
        object me=this_player(),obj;
        string aug,ob;

        if(!arg || sscanf(arg,"%s %s",aug,ob)!=2
            || aug!="+" && aug!="-")
        return notify_fail("格式错误！\n");

         obj=find_player(ob);
         if(!objectp(obj)) obj=find_living(ob);

         if(objectp(obj))
         {
          if(obj->query("jined"))
          {
           if(aug=="+")
           {
           write("对方已经处于禁闭状态了！\n");
           return 1;
           } else
           {
           obj->delete("jined");
           obj->enable_player();
           write("ok！\n");
           return 1;
           }
          } else
          {
           if(aug=="-")
           {
           write("对方并没有处于禁闭状态！\n");
           return 1;
           } else
           {
           obj->set("jined",me->query("id"));
           obj->disable_player(HIC"  <禁闭中..........>"NOR);
           write("ok！\n");
           return 1;
           }
          }
         }
         else
         {
         write("没有这个人！\n");
         return 1;
         }
}

int do_force(string arg)
{
        object me=this_player(),obj;
        string aug,ob;

        if(!arg || sscanf(arg,"%s to %s",ob,aug)!=2)
        return notify_fail("格式错误！\n");

        obj=find_player(ob);
        if(!objectp(obj)) obj=find_living(ob);

        if(objectp(obj))
          if(obj->command(aug))
           write("Ok！\n");
          else
           write("无法执行该指令！\n");
        else
          write("现在没有这个人！\n");
       return 1;
}
