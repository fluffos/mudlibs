#include <ansi.h>
inherit F_CLEAN_UP;

#define RENWU "/adm/etc/renwu"
nosave mapping wizlevel=([
"(immortal)"    :   HIG"〖"BBLU HIM"火云天使"NOR HIG"〗："NOR,
"(wizard)"      :   HIG"〖"BCYN HIC"火云专使"NOR HIG"〗："NOR,
"(arch)"        :   HIG"〖"BYEL HIR"火云大使"NOR HIG"〗："NOR,
"(admin)"       :   HIG"〖"BMAG HIY"火云天神"NOR HIG"〗："NOR,
]);

int main(object me, string arg)
{
      
        string *list,wiz,quest,msg;
        int i,j;

        mapping quests=([ ]);
        object ob;
        int flag,count;
        
        if (file_size(RENWU))
                foreach (string str in explode(read_file(RENWU),"\n")){
                if( str[0]=='#' || sscanf(str, "%s %s", wiz, quest)!=2 ) continue;
                quests+=([ wiz : quest ]);
            }
        write(HIR"【"BBLU HIW"火云录 2000"NOR HIR"】"NOR + "目前的管理人员有：\n");
        write(HIR"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"NOR);
        list = SECURITY_D->query_wizlist();
        count=0;
        for (i=11;i > 0;i--){
            flag=1;
            msg="";
            j=0;
            if(i==10) continue;
            foreach (wiz in list){
                     if (wiz_level(wiz)==i){
                    j++;
                    if (flag){
                        msg+= "\n" + wizlevel[wizhood(wiz)]+"\n";

                        flag=0;
                    }
                 if (objectp(ob=find_player(wiz)) && me->visible(ob) )
                     msg+=(j%3?"":"\n")+"\t\t("+HIG+wiz+NOR") ";
                    else
                        msg+=(j%3?"":"\n")+"\t\t("+wiz+") ";
                    if (undefinedp(quests[wiz]))
                        msg+=WHT"(暂无任务)"NOR;
                    else
                       msg+=quests[wiz];
                    count++;
                }
            }
            write(msg);
        }
        write(HIR"\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"NOR);        
        write("\n合共有: "HIR+chinese_number(count)+NOR" 位。其中"HIG"亮绿色"NOR"的表示在线管理人员。\n");
   
        return 1;
}

int help(object me)
{

write(@HELP
指令格式 : wizlist

用途 : 列出目前所有的巫师名单。
HELP
     );
     return 1;
}

