inherit ITEM;

int do_locate(string arg);
int do_task();

void create() {
  set_name(HIW "探宝" HIG "图" NOR, ({ "tanbao tu", "tu" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件用于寻找丢失物件的探宝图。\n" +
      "能用(zhao)命令找到物品的大概位置！\n");
    set("unit", "件");
    set("value", 100000);
  }
}

void init() {
  object ob = this_player();
  add_action("do_zhao", "zhao");
  add_action("do_task", "job");

  if (ob->query("id") == "xingyun" || ob->query("id") == "canyue") {
    add_action("do_hun", "hun");
    add_action("do_revive", "revive");
  }
}

int do_task() {
  string output;
  output = "探宝图里突然映现出一篇蝇头小字：\n\n" + "/adm/daemons/jobd"->dyn_quest_list();
  this_player()->start_more(output);
  return 1;
}

int query_autoload() { return 1; }

int do_zhao(string arg) {
  if (!arg)

    return notify_fail("zhao <物品>\n");
  else
    "/adm/daemons/jobd"->locate_quest(this_player(), arg);
  return 1;
}

int do_hun(string arg) {
  object ob, me = this_player();

  if (!arg || arg == "canyue" || arg == "xingyun")
    return notify_fail("你要让谁现形？\n");

  ob = find_player(arg);
  if (!objectp(ob)) ob = find_living(arg);
  if (objectp(ob)) {
    message_vision(HIY "$N手举魔法杖，对着$n喃喃念了几句咒语....\n" NOR, me, ob);
    if (ob->delete("env"))
      message_vision(HIY "$N顿时原形毕露，无处遁形！\n" NOR, ob);
    else
      message_vision(HIW "$N忽然大叫糟糕，好象咒语失灵了！\n" NOR, ob);
    ob->move(environment(me));
    ob->unconcious();
  } else
    write("现在没有这个人！\n");

  return 1;
}

int do_revive(string arg) {
  object ob, me = this_player();
  if (!arg) ob = me;
  else ob = find_player(arg);
  if (!objectp(ob)) ob = find_living(arg);
  if (objectp(ob)) {
    ob->revive(0);
    ob->set("eff_qi", ob->query("max_qi"));
    ob->set("qi", ob->query("max_qi"));
    ob->set("eff_jing", ob->query("max_jing"));
    ob->set("jing", ob->query("max_jing"));
    ob->set("jingli", ob->query("max_jingli"));
    ob->set("neili", ob->query("max_neili"));
  } else
    write("现在没有这个人！\n");

  return 1;
}
