#include <ansi.h>
inherit ITEM;
void create() {
  set_name(RED "仙笑歌" NOR, ({ "xxge" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "谱");
    set("material", "stone");
    set("long", RED "一谱仙笑歌\n" +
      HIW "上面写着那段著名的：" + RED "曾经有一段真诚的...\n" NOR);
  }

  setup();
}
