#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIW"无剑心法"NOR, ({ "wujianxinfa" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "个");
            set("material", "stone");
            set("long", "一本万梅山庄的武功秘籍。\n");
         set("skill", ([
                        "name":       "doomforce",        
                        "exp_required":  500000,           
                        "sen_cost":     30, 
                        "difficulty":   50,     
                        "max_skill":    49,             
                ]) );      
         }

    setup();
}
