// attribute.c
// From ES2
// Modified by Xiang for XKX (12/15/95)
#include <dbase.h>
#include <skill.h>
int query_str()
{
    int improve = query_skill("unarmed", 1) / 10;
    if ( query_skill("unarmed",1)
      || query_skill("strike", 1)
      || query_skill("finger", 1)
      || query_skill("cuff", 1)
      || query_skill("hand", 1)
      || query_skill("claw", 1))
    {
        if ( query_skill("strike", 1) >= improve * 10 )
            improve = (int)query_skill("strike", 1) / 10;
        if ( query_skill("finger", 1) >= improve * 10)
            improve = (int)query_skill("finger", 1) / 10;
        if ( query_skill("cuff", 1) >= improve * 10)
            improve = (int)query_skill("cuff", 1) / 10;
        if ( query_skill("hand", 1) >= improve * 10)
            improve = (int)query_skill("hand", 1) / 10;
        if ( query_skill("claw", 1) >= improve * 10)
            improve = (int)query_skill("claw", 1) / 10;
    }
    improve +=  (int)query("str");
    if( improve < (int)query_temp("apply/strength") * 2 )
        improve = improve * 3 / 2;
    else     improve +=  (int)query_temp("apply/strength");
    return improve;
}
int query_int()
{
    int improve;

    improve =  (int)query("int")+(int)query_skill("literate", 1) / 10;
    if( improve < (int)query_temp("apply/intelligence") * 2 )
        improve = improve * 3 / 2;
    else     improve +=  (int)query_temp("apply/intelligence");
    return improve;
}
int query_con()
{
    int improve;

    improve =  (int)query("con")+(int)query_skill("force", 1) / 10;
    if( improve < (int)query_temp("apply/constitution") * 2 )
        improve = improve * 3 / 2;
    else     improve +=  (int)query_temp("apply/constitution");
    return improve;
}
int query_dex()
{
    int i,improve;
    improve =  (int)query("dex")+(int)query_skill("dodge", 1) / 10;
    i=(this_object()->query_encumbrance()*100)/this_object()->query_max_encumbrance();
    if (i>50)
        improve -= (i-30)/10;
    if( improve < (int)query_temp("apply/dexerity") * 2 )
        improve = improve * 3 / 2;
    else     improve +=  (int)query_temp("apply/dexerity");
    return improve;        

}
int query_kar()
{
    return (int)query("kar")+ query_temp("apply/karma");
}
int query_per()
{
    return (int)query("per") + query_temp("apply/personality");
}
