// clean_up.c
// by Annihilator@ES2
int clean_up()
{
    object *inv;
    int i;
    if( !clonep() && this_object()->query("no_clean_up") ) return 1;
    if(interactive(this_object()) || this_object()->query("banghui")) return 1;
    // If we are contained in something, let environment do the clean
    // up instead of making recursive call. This will prevent clean-up
    // time lag.
    if(environment()) return 1;

    if( sscanf(base_name(this_object()),"/quest/%*s")
        && this_object()->query("no_clean_up") )
    return 1; 

    inv = all_inventory();
    for(i=sizeof(inv)-1; i>=0; i--)
    {
        if( sscanf(base_name(inv[i]),"/quest/%*s")
           && inv[i]->query("no_clean_up") )
           return 1; 
        if(interactive(inv[i]) || inv[i]->query("banghui")) return 1;
    }
    destruct(this_object());
    return 0;
}
