#include <ansi.h>
#include <mudlib.h>

inherit F_DBASE;
inherit F_SAVE;
inherit F_CLEAN_UP;

string filename;

string query_save_file() {
  return filename;
}

int main(object me, string arg) {
  mapping *notes, last_read_time;
  string *file;
  string myid;
  string msg = "";
  int num, i, j, k, l, m;

  file = get_dir("/data/board/");
  i = sizeof(file);
  if (!i) return 0;
  filename = resolve_path("/data/board/news_b.o");
  if (!restore()) return notify_fail("没有这个文件。\n");
  notes = query("notes");
  if (arg) {

    last_read_time = this_player()->query("board_last_read");
    myid = query("board_id");
    notes = query("notes");

    if (arg == "new" || arg == "next") {
      if (!mapp(last_read_time) || undefinedp(last_read_time[myid]))
        num = 1;
      else
        for (num = 1; num <= sizeof(notes); num++)
          if (notes[num - 1]["time"] > last_read_time[myid]) break;

    } else if (arg == "list all") {
      for (i = 0; i < sizeof(notes); i++) {
        msg += (sprintf("[%2d]",
          //                      notes[i]["time"] > last_time_read ? HIY"NEWS" : "NEWS",
          i + 1));
        msg += (sprintf("     %-=36s %18s (%s)\n",
          notes[i]["title"], notes[i]["author"],
          ctime(notes[i]["time"])[0..15]))[4..<0];
      }
      this_player()->start_more(msg);
      return 1;

    } else if (arg == "list") {
      if (!mapp(last_read_time) || undefinedp(last_read_time[myid]))
        for (i = 0; i < sizeof(notes); i++) {
          msg += (sprintf("[%2d]",
            i + 1));
          msg += (sprintf("     %-=36s %18s (%s)\n",
            notes[i]["title"], notes[i]["author"],
            ctime(notes[i]["time"])[0..15]))[4..<0];
        } else {
          for (num = 1; num <= sizeof(notes); num++)
            if (notes[num - 1]["time"] > last_read_time[myid]) break;
          if (num - 1 == sizeof(notes)) return notify_fail("从您上次退出到现在没有任何新闻。\n");
          for (i = num - 1; i < sizeof(notes); i++) {
            msg += (sprintf("[%2d]",
              i + 1));
            msg += (sprintf("     %-=36s %18s (%s)\n",
              notes[i]["title"], notes[i]["author"],
              ctime(notes[i]["time"])[0..15]))[4..<0];
          }
        }
      this_player()->start_more(msg);
      return 1;
    }







    else if (!sscanf(arg, "%d", num))
      return notify_fail("你要读第几条新闻？\n");


    if (num < 1 || num > sizeof(notes))
      return notify_fail("没有这条新闻。\n");
    num--;
    this_player()->start_more(sprintf(HIW "你现在正在阅读第%d条新闻\n" + HIC "标    题： %-36s \n" + HIY "作    者： %-18s\n" + HIG "发布时间： (%s)\n" NOR
      "-------------------------------------------------------------------------------\n",
      num + 1, notes[num]["title"], notes[num]["author"],
      ctime(notes[num]["time"])[0..15])
      +notes[num]["msg"]);

    // Keep track which post we were reading last time.
    if (!mapp(last_read_time))
      this_player()->set("board_last_read", ([ myid: notes[num]["time"] ]));
    else if (undefinedp(last_read_time[myid]) || notes[num]["time"] > last_read_time[myid])
      last_read_time[myid] = notes[num]["time"];

    return 1;
  }


  k = me->query("board_last_read/" + query("board_id"));

  for (l = 0, m = sizeof(notes) - 1; m >= 0; m--, l++)
    if (notes[m]["time"] <= k) break;
  write(CHINESE_MUD_NAME);
  if (sizeof(notes))
    write("共有" + chinese_number(sizeof(notes)) + "条新闻");
  else write("没有新闻");
  if (l) write("，" + chinese_number(l) + "条未读");
  write("。\n");
  write("用 news xx 去读你想读的新闻。\n");
  write("用 news list 可以看有多少条你没看的新闻。\n");
  write("用 news list all 可以看有多少条新闻。\n");
  return 1;
}
