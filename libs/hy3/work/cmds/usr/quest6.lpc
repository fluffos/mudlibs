//writed by xingyun,2001 6 26

#include <ansi.h>
inherit F_CLEAN_UP;
string time_period(int timep);
int main(object me) {
  int mark;
  mapping quest;
  string str, temp;
  int time;

  if (!(quest = me->query("haojie_quest")))
    return notify_fail(
      HIW "你并没有参加任何对抗武林浩劫的任务，想试一下吗？\n" NOR);

  str = HIB "\n====================================================="
    + "==========\n" NOR;

  str += HIR "            到目前为止，你通过武林浩劫任务共获得了：\n" NOR + HIW + chinese_number(quest["reward_exp"]) + NOR + HIR "点实战经验和" NOR + HIW + chinese_number(quest["reward_potential"]) + NOR + HIR "点潜能奖励！\n" NOR;

  if (me->query_temp("haojie")) {
    str += HIR "            在本次浩劫中，你已经获得了" + HIY + chinese_number(me->query_temp("haojie/reward_exp")) + HIR "点经验奖励！\n" NOR;

    temp = read_file("/quest/chousha/time_begin", 1, 1);
    time = atoi(temp);
    time = time + 3600 - time();
    if (time < 0) time = 0;
    str += HIW "            距离本次浩劫结束还有" + time_period(time) + "\n" NOR;
  }

  str += HIB "====================================================="
    + "==========\n" NOR;
  write(str);
  return 1;
}

string time_period(int timep) {
  int t, d, h, m, s;
  string time;
  t = timep;

  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;
  if (d)
    time = chinese_number(d) + "天";
  else
    time = "";
  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";

  return HIW + time + NOR;
}
