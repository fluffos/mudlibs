// exam.c (Ronger  11-98)
 
#include <ansi.h>
 
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
        object ob;
        mapping my,prop_list;
        string *prop,str;
        int i;

        if( !arg )
            return notify_fail("你要查看什么装备的情况？\n");

        if( !objectp(ob=present(arg,me)) )
            return notify_fail("你身上没有这样东西？\n");

        seteuid(getuid(me));

        if( ob->query("zizhi") && ob->query("owner_id") == me->query("id") )
        {
            if(!me->query("weapon"))
                return notify_fail("你还没有自制的武器。\n");
 
             my = me->query("weapon");
             printf(" 武器名称  ： %12s  打造时间 ： %s\n" , my["name"], my["time"]);
             printf(" 材    料  ： %12s  类    型 ： %s\n" , my["or"], my["type"]);
             printf(" 目前级别　： %d/%d\n" ,my["lv"], my["value"]);
         } else
        if( ob->query("armor_prop") && ob->query("owner_id") == me->query("id")) 
        { 
             prop_list = ob->query("armor_prop");
             str = ob->name()+HIR"拥有如下特殊属性：\n"NOR;
             prop = keys(prop_list);

             if( sizeof(prop) > 0 )
             for( i=0;i<sizeof(prop);i++)
             {
               str +=HIC"    "+prop[i]+":     "+prop_list[prop[i]]+"\n"NOR;
               ob->set("armor_prop/"+prop[i],(int)prop_list[prop[i]]);
             }
             write(str+"\n");
         } else
         write("该物品没有任何额外附加属性！\n");

         return 1;
}
 
int help(object me)
{
        write(@HELP
指令格式 : exam
 
这个指令可以显示你自制的武器的详细资料。

HELP
    );
    return 1;
}
