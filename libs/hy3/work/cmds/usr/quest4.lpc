//writed by xingyun,2001 6 26

#include <ansi.h>
inherit F_CLEAN_UP;
string time_period(int timep);
int main(object me, string arg)
{
        int nowtime = time();
        mapping quest;
        int timep,time;
        string msg,temp;

        if(!(quest =  me->query("chousha_quest")))
        return notify_fail(
               HIW"你并没有参加过任何江湖仇杀，想惹这个是非吗？\n"NOR);

        if(me->query_temp("chousha/fam"))
        {
        write(HIW"你现在的正卷身于对"+me->query_temp("chousha/fam")
             +"作战的江湖仇杀中。"NOR);
        write(HIW"在此次仇杀中，\n你已经获得了"NOR+HIR+chinese_number(me->query_temp("chousha/reward_exp"))
             +NOR+HIW"点实战经验！\n"NOR);        
        } else
        {
        msg="               ";

        temp=read_file("/quest/chousha/time_begin",1,1);
        time=atoi(temp);

        if(time)
        {
        timep=5400+time-nowtime;
        if(timep<0) timep=0;     
        msg+=HIG"距下次江湖仇杀还剩："NOR+HIW+time_period(timep)+"\n"NOR;
        } else
        msg+=HIG"目前无法预测距离下次江湖仇杀的剩余时间\n"NOR;

        write(
        HIB"===============================================================\n"NOR
       +HIG"               到目前为止，你通过江湖仇杀共获得了：\n"NOR
       +HIR+chinese_number(quest["reward_exp"])+NOR
       +HIG"点实战经验和"NOR+HIR+chinese_number(quest["reward_potential"])+NOR
       +HIG"点潜能奖励！\n"NOR+msg+
        HIB"===============================================================\n"NOR);
       }

        return 1;
}

string time_period(int timep)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;
        if(d) 
                time = chinese_number(d) + "天";
        else 
                time = "";
        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";

        return time;
}

int help(object me)
{
        write(@HELP
指令格式 : quest4  这个指令可以显示出你所参加的江湖仇杀情况。
HELP
        );
        return 1;
}

