//hp.c

#include <ansi.h>
 
inherit F_CLEAN_UP;
 
string status_color(int current, int max);
string status_neili(int color, int xi);

int main(object me, string arg)
{
        object ob;
        string shui,cide;
        mapping my;
        seteuid(getuid(me));

        if(!arg)
                ob = me;
        else
        {
           ob = present(arg, environment(me));
           if (!ob) ob = find_player(arg);
           if (!ob) ob = find_living(arg);
           if (!ob) return notify_fail("你要察看谁的状态？\n");

           if( !wizardp(me) )
           if ( !me->query("couple/child") || !ob->query("is_baby") 
                || me->query("couple/child") != ob->query("id") )
           return notify_fail("只有巫师能察看别人的状态。\n");  
        }

        my = ob->query_entire_dbase();
        if( my["water"] * 10 / (my["str"] + 10)  > 100 ) shui=HIG" 酒足 "NOR;
        else if( my["water"] * 10 / (my["str"] + 10)  > 90 ) shui=HIG" 正常 "NOR;
        else if( my["water"] * 10 / (my["str"] + 10)  > 60 ) shui=HIC" 微渴 "NOR;
        else if( my["water"] * 10 / (my["str"] + 10)  > 30 ) shui=HIC" 渴了 "NOR;
        else if( my["water"] * 10 / (my["str"] + 10)  > 10 ) shui=HIB" 极渴 "NOR;
        else shui=HIR" 缺水 "NOR;

        if( my["food"] * 10 / (my["str"] + 10)  > 100 ) cide=HIG" 饭饱 "NOR;
        else if( my["food"] * 10 / (my["str"] + 10)  > 90 ) cide=HIG" 正常 "NOR;
        else if( my["food"] * 10 / (my["str"] + 10)  > 60 ) cide=HIC" 微饿 "NOR;
        else if( my["food"] * 10 / (my["str"] + 10)  > 30 ) cide=HIC" 饿了 "NOR;
        else if( my["food"] * 10 / (my["str"] + 10)  > 10 ) cide=HIB" 饥饿 "NOR;
        else cide=HIR" 缺食 "NOR;
    printf(HIG "〖"+ MUD_NAME + "〗"HIB"个人档案:"HIY"%s [%s]\n"NOR,ob->name(),capitalize(ob->query("id")));
    printf(HIC"┏"HIC"───────────────────────────────────"HIC"┑\n"NOR)
;
      printf(HIC"┃"HIC"【 精 气 】 %s%4d/ %4d %s(%3d%%)" HIC "    【 精 力 】 %s%4d / %4d\t" HIC"        ┃\n" NOR,
                status_color(my["jing"], my["eff_jing"]), my["jing"], my["eff_jing"],
                status_color(my["eff_jing"], my["max_jing"]),   my["eff_jing"] * 100 / my["max_jing"],
                status_color(my["jingli"], my["max_jingli"]),   my["jingli"], my["max_jingli"],
                my["jiajing"] );
      printf(HIC"┃"HIC"【 气 血 】 %s%4d/ %4d %s(%3d%%)" HIC "    【 内 力 】 %s%4d / %4d (+%d)\t"+ NOR + HIC +"        ┃\n" NOR,
                status_color(my["qi"], my["eff_qi"]), my["qi"], my["eff_qi"],
                status_color(my["eff_qi"], my["max_qi"]), my["eff_qi"] * 100 / my["max_qi"],
                status_neili(my["neixi"], my["neixi"]), my["neili"], my["max_neili"],
                my["jiali"] );
      printf(HIC"┃"HIW"【 食 物 】 %s%4d/ %4d %s  " HIW "  【 饮 水 】 %s%4d/ %4d %s"HIC"        ┃\n" NOR,
        status_color(my["food"], (int)ob->max_food_capacity()),
        my["food"], (ob->max_food_capacity()),
        cide,
        status_color(my["water"], ob->max_water_capacity()),
        my["water"], (ob->max_water_capacity()),shui);
      printf(HIC"┃"HIW"【 潜 能 】  %s%6d      " HIW "        【 经 验 】  %s%d\t\t"HIC"        ┃\n" NOR,
        HIM,
        (int)ob->query("potential") - (int)ob->query("learned_points"),
        HIM,
        my["combat_exp"] );
      printf(HIC"┃"HIW"【潜能速度】 %s%5d/每小时 " HIW "       【经验速度】  %s%5d/每小时\t"HIC"        ┃\n" NOR,
        HIM,
        (int)ob->query("potential")/ (( (int)ob->query("mud_age")/3600+1) ),
        HIM,
        my["combat_exp"]/(((int)ob->query("mud_age")/3600)+1) );
       printf(HIC"┖"HIC"───────────────────────────────────"HIC"┙\n"NOR);
        return 1;
}

string status_neili(int color, int neixi)
{
        if( neixi == 0 ) return NOR;
        if( neixi == 1 ) return WHT;
        if( neixi == 2 ) return RED;
        if( neixi == 3 ) return HIG;
        if( neixi == 4 ) return HIC;
        if( neixi == 5 ) return HIW;
        if( neixi == 6 ) return HIR;
        if( neixi == 7 ) return NOR + BLINK;
        return RED;
}
 
string status_color(int current, int max)
{
        int percent;
 
        if( max>0 ) percent = current * 100 / max;
        else percent = 100;
        if( percent > 100 ) return HIC;
        if( percent >= 90 ) return HIG;
        if( percent >= 60 ) return HIC;
        if( percent >= 30 ) return YEL;
        if( percent >= 10 ) return HIR;
        return RED;
}
 
int help(object me)
{
        write(@HELP

指令格式 : hp
           hp <对象名称>                   (巫师专用)
 
这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。
 
see also : score
HELP
    );
    return 1;
}

