// create by connie
// list autoload object

int main()
{
        int nu1,nu2,i;
        object *ob1,*ob2;
        string msg,temp;
        msg = "\nAUTOLOAD物品列表：\n";
        
        ob1 = users();
        ob1 = filter_array(ob1,(: !wizardp($1) :));
        
        if(!arrayp(ob1)) return 0;
        
        for(nu1=0;nu1<sizeof(ob1);nu1++) {
                
                if(!objectp(ob1[nu1])) return 0;
                ob2 = all_inventory(ob1[nu1]);
                if(!arrayp(ob2)) return 0;
                
                        for(nu2=0;nu2<sizeof(ob2);nu2++) {
                                if(!objectp(ob2[nu2])) continue;
                                if(!ob2[nu2]->query_autoload() && sscanf(base_name(ob2[nu2]),"/u/%*s",temp)!=1 && !ob2[nu2]->query("unique"))
                                continue;

        if(ob2[nu2]->query("money_id") && sscanf(base_name(ob2[nu2]),"/u/%*s",temp)!=1)
                        continue;
                        msg+=ob2[nu2]->query("name")+"("+ob2[nu2]->query("id")+")此物正在"+ob1[nu1]->query("name")+"("+ob1[nu1]->query("id")+")手中。\n";
                        }
                }
                msg+= "\nOVER\n";     
                write(msg);

                return 1;
}
        

