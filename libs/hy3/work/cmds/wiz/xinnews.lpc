// xinnews.c

#include <ansi.h>

inherit F_CLEAN_UP;
int help(object me);
int main(object me, string arg) {
  if (!arg) return help(me);
  if (me->is_busy())
    return notify_fail("你正忙着呢.\n");

  shout(HIW + "【新闻】:" + "新闻更新" + "," + "请用news" + " " + arg + "查看" + "." + "\n" NOR);
  write(HIW + "你发布新闻：" + "新闻更新" + "请用news" + " " + arg + "查看" + "." + "\n" NOR);

  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : xinnews <新闻编号>
 
这个指令让你将 <新闻发布> 传送出去, 所有正在游戏中的人都
会听见你的话.
 
see also : tune
HELP
  );
  return 1;
}
