// cat.c
// Last modified by jjgod@FYTX. For fix security hole.

#include "/doc/help.h"

inherit F_CLEAN_UP;
int help();

int main(object me, string arg)
{
        string file,temp;

        seteuid(geteuid(me));
        if (!arg) return notify_fail("你想要显示那个档案?\n");
                file = resolve_path(me->query("cwd"), arg);
        if( file_size(file)<0 ) return notify_fail("没有这个档案。\n");

        if( !SECURITY_D->valid_read(file,me,"read_file") )         
            return notify_fail("你没有足够的权限查看这个文件！\n");

        write(read_file(file));
        return 1;
}

int help()
{
write(@HELP
指令格式 : cat <档案>

此指令可让你直接读取某档案之程序。
HELP
    );
    return 1;
}

