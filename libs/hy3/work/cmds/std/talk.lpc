inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  if (!arg) return notify_fail("你要和谁谈话？\n");
  if (!ob = present(arg, environment(me))) return notify_fail("这里并没有这个人！\n");
  if (!living(ob)) return notify_fail("显然" + ob->name(1) + "和你搭不上话！\n");
  if (userp(ob)) {
    message_vision("$N想好好的和" + ob->name(1) + "说上一会话\n", me);
    return 1;
  }
  if (!ob->query("yeer_rpg")) {
    string *topics, topic;
    topics = ({ "name", "here", "rumors", "marry", "food", "water", "money" });
    topic = topics[random(sizeof(topics))];
    INQUIRY_D->parse_inquiry(me, ob, topic);
    return 1;
  }
  ob->yeer_rpg(me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : talk <id>

这个指令可以让你和别人谈话。
 
HELP
  );
  return 1;
}
