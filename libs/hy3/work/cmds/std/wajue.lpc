// wajue.c
// by smash
#include <ansi.h>
inherit F_CLEAN_UP;
 
int main(object me, object ob)
{
        int t, time;
        object where = environment(me);
        t = time()-where->query_temp("wajue");
        time = where->query_temp("wajue1");
        
	
	if( me->is_busy() )
		return notify_fail("你上一个动作还没有完成！\n");
	
	if (!present("chu tou",me)) return notify_fail("你没有锄头，怎么挖掘呀？！\n");
  if ((int)me->query("jing") < 50)
                return notify_fail("你挖了半天,精力不够了！\n");
	
	if  (!environment(me)->query("outdoors"))
         return notify_fail("在房子里你也想挖宝？！\n");
	
	if (present("bao wu",me)) return notify_fail("你身上已经有宝物了，别太贪心呀!!\n");
	
        if( t <= time )
	
	return notify_fail("这里已经被人挖过了，一会儿再来吧!!\n");
	
	if (me->is_fighting())
                return notify_fail("现在正打的起劲，你怎么能去挖掘呢？!\n");
        
        if (random(10) <= 6 )
        {
                        printf(HIC"你拿出一把锄头，在地上挖了半天，什么也没有挖到。\n"NOR);
//                         me->start_busy(5); 
        t = (300 + random(10) );
        where->set_temp("wajue", time());    
        where->set_temp("wajue1", t);
     me->add("jing", -20);
                return 1;
        } else { 
        	
                        printf(HIC"你拿出一把锄头，在地上挖了半天，突然你觉得好象挖到了什么。\n"NOR);	
                        switch(random(15))
		     {
			case 0:
			   ob = new("/clone/baowu/1");
                           ob->move(me);
			   break;
			case 1:
			   ob = new("/clone/baowu/2");
                           ob->move(me);
			   break;
			case 2:
			   ob = new("/clone/baowu/3");
                           ob->move(me);
			   break;
		        case 3:
			   ob = new("/clone/baowu/4");
                           ob->move(me);
			   break;
                        case 4:
			   ob = new("/clone/baowu/5");
                           ob->move(me);
			   break;		     
		        case 5:
			   ob = new("/clone/baowu/6");
                           ob->move(me);
			   break;
		        case 6:
			   ob = new("/clone/baowu/7");
                           ob->move(me);
			   break;
		        case 7:
			   ob = new("/clone/baowu/8");
                           ob->move(me);
			   break;
		        case 8:
			   ob = new("/clone/baowu/9");
                           ob->move(me);
			   break;
		        case 9:
			   ob = new("/clone/baowu/10");
                           ob->move(me);
			   break;
		        case 10:
			   ob = new("/clone/baowu/11");
                           ob->move(me);
			   break;
		        case 11:
			   ob = new("/clone/baowu/12");
                           ob->move(me);
			   break;
		        case 12:
			   message_vision(HIW"哇，$N挖到了一个茅坑。\n"NOR, me);
		           tell_object(me,HIW"哇，你挖到了一个茅坑。\n"NOR);
			   break;
		        case 13:
			   message_vision(HIW"哇，$N挖到了一个大石头。\n"NOR, me);
		           tell_object(me,HIW"哇，你挖到了一个大石头。\n"NOR);
			   break;
                        case 14:
                           message_vision(HIW"哇，$N挖到了一个大西瓜。\n"NOR, me);
                           tell_object(me,HIW"哇，你挖到了一个大西瓜。\n"NOR);
                           ob = new("/clone/baowu/xigua");
                           ob->move(me);
                           break;
		     }
		    
	tell_object(me,HIW"由于你辛勤的挖掘，你发现了一个宝物。\n"NOR);
        tell_object(me,HIW"恭喜你啦！\n"NOR);	     
        me->start_busy(5); 
        t = ( 30 + random(10) ) * 100;
        where->set_temp("wajue", time());    
        where->set_temp("wajue1", t);          
     me->add("jing", -20);
                        return 1;
                }
}
 
