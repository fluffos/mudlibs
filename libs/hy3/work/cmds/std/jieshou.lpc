#include <ansi.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me)
{
	object evn,*ob;
	int i;
	string str;
	
	if(me->query("id") != me->query_temp("marks/biwu_name"))
		return 0;
		
	evn = environment(me);
	str = base_name(evn);
	me->set_temp("marks/where",str);
	message_vision("$N被接走去参加比武去了。\n", me);
	ob = all_inventory(me);
	for(i=0; i<sizeof(ob); i++)
		if( ob[i]->query_temp("block_msg/all"))
			if (ob[i]->move(environment(me)))
				if( ob[i]->is_character() )
					message_vision("$N将$n从背上放了下来，躺在地上。\n", me, ob[i]);
	me->move("/d/city/leitai");
	message_vision("$N身形一纵，来到了擂台之上。\n", me);
	
	me->set_temp("marks/biwu",1);
	me->set_temp("marks/wait_player",1);
	me->delete_temp("marks/biwu_name");

	return 1;
}
