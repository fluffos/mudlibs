//ROM dating

inherit ROOM;

void create() {
  set("short", "大厅");
  set("long", @LONG
    这里是『白驼山庄』的大厅，内部摆设极尽豪华，当中一张黑色檀木
条案，上面陈放着精美的花瓶和一些珍贵的瓷器，四壁挂满名家的字画.
LONG
  );
  set("valid_startroom", 1);

  set("exits", ([
    "north": "/d/baituo/liangong",
    "southdown": "/d/baituo/yuanzi",
  ]));

  set("objects", ([
    CLASS_D("btshan") + "/ouyangfeng": 1,
    "/d/baituo/npc/yahuan": 2,
    "/d/biwu/champion_bt": 1,
  ]));
  //        set("no_clean_up", 0);
  setup();

  "/clone/board/baituo_b"->foo();

  replace_program(ROOM);
}
