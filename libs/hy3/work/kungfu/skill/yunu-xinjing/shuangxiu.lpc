//玉女心经双修
//writed by xingyun, 2001.7.21

#include <ansi.h>

void remove_shuangxiu(object me, object target);
int exert(object me, object target) {
  if (!target)
    return notify_fail("你要和谁双修？\n");

  if (me->is_fighting() || target->is_fighting())
    return notify_fail("战斗中无法双修，会走火入魔的！\n");

  if (target->is_busy())
    return notify_fail("对方正忙着呢！\n");

  if (target == me)
    return notify_fail("有没有搞错和自己双修？\n");

  if (target->query("gender") == me->query("gender")
    || target->query("gender") == "无性"
    || me->query("gender") == "无性")
    return notify_fail("凭你们也可以双修，别出丑了！\n");

  if (me->query_skill("yunu-xinjing", 1) < 200
    || target->query_skill("yunu-xinjing", 1) < 200)
    return notify_fail("你们两人玉女心经造诣太浅，无法配合！\n");

  if ((int)me->query("max_neili") < 1000
    || (int)target->query("max_neili") < 1000)
    return notify_fail("你们二人的内力修为还不够。\n");

  if ((int)me->query("neili") < 500
    || (int)target->query("neili") < 500)
    return notify_fail("你们二人的真气不够。\n");

  if (target->query_skill_mapped("force") != "yunu-xinjing")
    return notify_fail(
      "对方好象没准备双修玉女心经哪，你一个人瞎起什么劲呀？\n");

  if (me->query("family/family_name") != "古墓派"
    || target->query("family/family_name") != "古墓派")
    return notify_fail("你们二人不同为古墓弟子，也想双修？\n");

  if (me->query_temp("armor/cloth") || target->query_temp("armor/cloth"))
    return notify_fail(
      "这样好象不行，你们还有人穿着东西，过会要热坏的！\n");

  if (me->query_temp("shuangxiu") || target->query_temp("shuangxiu"))
    return notify_fail("你们已经在双修中了！\n");

  message_vision(
    HIR "$N与$n盘膝对做，运起玉女心经，双手掌心相向，不一会儿，一股\n"
    + "热腾腾的蒸气从$N与$n头顶冒出.......\n", me, target);

  me->set_temp("shuangxiu", 1);
  target->set_temp("shuangxiu", 1);

  me->start_call_out(
    (: call_other, __FILE__, "remove_shuangxiu", me, target :), 20);

  me->start_busy(20 + random(10));
  target->start_busy(20 + random(10));

  me->add("neili", -200);
  target->add("neili", -200);

  return 1;
}

void remove_shuangxiu(object me, object target) {
  int reward_exp;

  if (me->query_temp("shuangxiu") && target->query_temp("shuangxiu")) {
    message_vision(
      HIY "过了许久$N和$n缓缓睁开双目，长长的吁出一口气，看来$N和$n对\n"
      + "玉女心经又有了新的领悟！\n" NOR, me, target);
    me->delete_temp("shuangxiu");
    target->delete_temp("shuangxiu");
    reward_exp = (int)me->query_skill("yunu-xinjing", 1) + (int)me->query_int();
    if (reward_exp > 600) reward_exp = 600;
    reward_exp = reward_exp + random(reward_exp);
    me->add("combat_exp", reward_exp / 10);

    if (me->query_skill("yunu-xinjing", 1)
      <= ceil(pow(me->query("combat_exp") * 10.0, 0.333333)))
      me->improve_skill("yunu-xinjing", reward_exp * 5);

    if (userp(target) || target->query("is_baby")) {
      reward_exp = (int)target->query_skill("yunu-xinjing", 1) + (int)me->query_int();
      if (reward_exp > 600) reward_exp = 600;
      reward_exp = reward_exp + random(reward_exp);
      target->add("combat_exp", reward_exp / 10);

      if (target->query_skill("yunu-xinjing", 1)
        <= ceil(pow(target->query("combat_exp") * 10.0, 0.333333)))
        target->improve_skill("yunu-xinjing", reward_exp * 5);
    }
  }

  return;
}
