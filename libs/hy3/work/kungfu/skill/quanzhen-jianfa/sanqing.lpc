// sanqing.c  一剑化三清

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon;
  string msg;
  int skill, i, n;

  skill = me->query_skill("quanzhen-jianfa", 1);

  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("「一剑化三清」只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你必须有一把剑才能使用「一剑化三清」！\n");
  if ((int)me->query("neili") < 300)
    return notify_fail("你的真气不够！\n");
  if (me->query_skill("tiangang-zhengqi", 1) < 120 &&
    me->query_skill("xiantian-gong", 1) < 120)
    return notify_fail(
      "你的天罡正气和先天功修为尚浅，无法运用「一剑化三清」绝技！\n");

  if (me->query_skill_mapped("force") != "tiangang-zhengqi" &&
    me->query_skill_mapped("force") != "xiantian-gong")
    return notify_fail(
      "你的天罡正气和先天功修为尚浅，无法运用「一剑化三清」绝技！\n");
  if ((int)me->query_skill(
    "sword",
    1
  ) < 120 || me->query_skill_mapped("sword") != "quanzhen-jianfa")
    return notify_fail("你的全真剑法还不到家，无法使用「一剑化三清」！\n");
  if (skill < 150) n = 2;
  else if (skill < 200) n = 3;
  else if (skill < 300) n = random(2) == 0 ? 4 : 5;
  else if (skill < 400) n = random(2) == 0 ? 7 : 8;
  else n = 10 + random(5);
  msg = HIG "$N大喝一声，剑招突变，手中" + weapon->query("name") + HIG "闪出点点光芒，一剑化出"
    +HIY + (n < 9 ? (n < 7 ? (n < 4 ? chinese_number(n) : "四、五") : "七、八") : "无数") + HIG + "剑，剑剑指向敌人要害！\n" NOR;
  message_vision(msg, me);
  me->add_temp("apply/dodge", skill / 6);
  me->add_temp("apply/attack", skill);
  for (i = 0; i < n; i++)
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  message_vision(
    HIY "$N一剑化三清剑法施展完毕，身法又迟缓了下来。\n" NOR, me);

  me->start_busy(2);
  me->add("neili", -300);
  me->add_temp("apply/attack", -skill);
  me->add_temp("apply/dodge", -skill / 6);
  return 1;
}
