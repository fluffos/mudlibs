// gonggui.c 全真剑法 同归剑法
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon;
        int skill;
        string msg;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("同归于尽只能对战斗中的对手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                        return notify_fail("你使用的武器不对。\n");

        if( (int)me->query_skill("quanzhen-jianfa", 1) < 135 )
                return notify_fail("你的全真剑法不够娴熟，不会使用「同归剑法」。\n");

        if ( me->query_skill("tiangang-zhengqi",1) < 100 &&
                             me->query_skill("xiantian-gong",1) < 100)
        return notify_fail(
                  "你的天罡正气和先天功修为尚浅，无法运用「同归剑法」！\n");  

       if( me->query_skill_mapped("force") != "tiangang-zhengqi" &&
                              me->query_skill_mapped("force") != "xiantian-gong")
        return notify_fail(
                  "你的天罡正气和先天功修为尚浅，无法运用「同归剑法」！\n");    

        if( me->query("max_qi") <= me->query("eff_qi")*2)
                return notify_fail("你还没受重伤，不要使用此剑法。\n");

        if( (int)me->query("neili") < 500  ) 
                return notify_fail("你的内力不够。\n");

        if( (int)me->query_temp("qzj_tong") ) 
                return notify_fail("你已经在运功中了。\n");

        msg = HIB+me->name()+HIB"左手捏一个剑决，右手握起" 
        + weapon->name() + "，拼着最后的力气，一式"HIR"「同归剑法」"HIB"，\n驭剑猛烈绝伦地冲向"+target->name()+HIB",意图与"+target->name()+HIB"同归一尽！\n"NOR;
        message_vision(msg, me, target);
        skill = (int)me->query_skill("quanzhen-jianfa", 1);
        me->add_temp("apply/attack", skill);
        me->add_temp("apply/dodge", -skill/6);
        me->add_temp("apply/damage",skill/2);
        me->set_temp("qzj_tong", skill);      
        me->add("neili",-500);      
        call_out("remove_effect",skill/4,me);
        return 1;
}

void remove_effect(object me)
{
        int pow;
        if(objectp(me) && me->query_temp("qzj_tong"))
        {
         pow = me->query_temp("qzj_tong");
         me->add_temp("apply/attack", -pow);
         me->add_temp("apply/dodge", pow/6);
         me->add_temp("apply/damage",-pow/2);
         me->delete_temp("qzj_tong");
         tell_object(me,HIW"你终于从同归剑法中清醒了过来。\n");
        }
        return;
}                  
