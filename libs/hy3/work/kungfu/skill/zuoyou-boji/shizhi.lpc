// bao.c  怀抱天下之「五指连心」
// Modified by Venus Oct.1997

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
    int damage;
    string msg;

    if( !target ) target = offensive_target(me);
    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「十指连心」只能对战斗中的对手使用。\n");

    if( (int)me->query_skill("zuoyou-boji", 1) < 100 )
        return notify_fail(WHT"你的左右搏击神功不够，还使不出「十指连心」。\n"NOR);

    if( (int)me->query("neili") < 300 )
        return notify_fail(WHT"你的内力不够，还使不出「十指连心」。\n"NOR);

        if( me->is_busy() )
                return notify_fail("你的动作还没有完成，不使用十指连心。\n");

    msg = HIC "$N低声呼吼，类似兽物在喉咙里咆哮一般，忽然身形变错起来。  \n"NOR;
     msg += HIC"$N陡然站定。$N的双手，忽然张开，然后慢慢屈起第一节手指，\n"NOR;
    msg += HIC"逐而又屈起了第二节手指，再一起屈起了第三节的手指，这时手掌已变成了：拳头！\n"NOR;
    msg +=HIW"只听$N叱喝道：“十指连心，双手化莲！\n\n\n"NOR;


    if (random(me->query_skill("force")) > target->query_skill("force")/20||
random(me->query("combat_exp")) > (int)target->query("combat_exp")/20 )
    {
        me->start_busy(1);
        damage = (int)me->query_skill("zuoyou-boji", 1);

        damage = 5000 + random(damage);

        target->start_busy(4);
        me->add("neili", -100);
        target->set("qi", damage);
          target->receive_wound("jing", damage);
        target->set("neili", damage);
        me->add("neili", 300);
      msg +=HIB"但见$n一声惨嚎,被$N巨大的拳头砸进泥潭！\n"NOR;

    } else
    {
        me->start_busy(1);
        msg += HIY"可是$p看破了$P的企图，闪身护头躲在了一边。\n"NOR;
    }
    message_vision(msg, me, target);

    if(userp(target)) target->fight_ob(me);
//    else if( !target->is_killing(me) ) target->kill_ob(me);
    return 1;
}
