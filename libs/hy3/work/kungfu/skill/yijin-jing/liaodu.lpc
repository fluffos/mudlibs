#include <ansi.h>

int exert(object me, object target) {
  int lvl, poison;
  string str;

  lvl = (int)me->query_skill("yijin-jing", 1);

  if (me->is_fighting())
    return notify_fail("战斗中不能逼毒。\n");

  if ((int)me->query_skill("yijin-jing", 1) < 100)
    return notify_fail("你的易筋经修为不够。\n");

  if ((int)me->query("neili") < 250)
    return notify_fail("你的真气不够。\n");

  if (!target) target = me;

  str = HIY "$N全身放松，坐下来开始给$n运功逼毒。\n" NOR;


  if (target->query_condition("hunyuan_hurt")) {
    poison = target->query_condition("hunyuan_hurt");
    poison = poison - random(lvl / 2);
    if (poison > 0) {
      str += HIY "过了一小会儿，$N脸上留下斗大的汗珠，$n身上的" NOR + HIR "混元无极" NOR + HIY "伤势好了小半.....\n" NOR;
      target->apply_condition("hunyuan_hurt", poison);
    } else {
      str += HIW "$N缓缓的呼出一口气，如释重负，看来$n身上的" NOR + HIR "混元无极" NOR + HIW "伤势已经全好了！\n" NOR;
      target->clear_condition("hunyuan_hurt");
    }
    me->start_busy(5 + random(5));
    me->add("neili", -200);
  } else if (target->query_condition("jy_poison")) {
    poison = target->query_condition("jy_poison");
    poison = poison - random(lvl / 2);
    if (poison > 0) {
      str += HIY "过了一小会儿，$N脸上留下斗大的汗珠，$n身上的" NOR + HIR "九阴白骨爪毒" NOR + HIY "解去了小半.....\n" NOR;
      target->apply_condition("jy_poison", poison);
    } else {
      str += HIW "$N缓缓的呼出一口气，如释重负，看来$n身上的" NOR + HIR "九阴白骨爪毒" NOR + HIW "已经毒性全解了！\n" NOR;
      target->clear_condition("jy_poison");
    }
    me->start_busy(5 + random(5));
    me->add("neili", -200);
  } else if (target->query_condition("xx_poison")) {
    poison = target->query_condition("xx_poison");
    poison = poison - random(lvl / 2);
    if (poison > 0) {
      str += HIY "过了一小会儿，$N脸上留下斗大的汗珠，$n身上的" NOR + HIR "星宿掌毒" NOR + HIY "解去了小半.....\n" NOR;
      target->apply_condition("xx_poison", poison);
    } else {
      str += HIW "$N缓缓的呼出一口气，如释重负，看来$n身上的" NOR + HIR "星宿掌毒" NOR + HIW "已经毒性全解了！\n" NOR;
      target->clear_condition("xx_poison");
    }
    me->start_busy(5 + random(5));
    me->add("neili", -200);
  } else if (target->query_condition("wudu_poison")) {
    poison = target->query_condition("wudu_poison");
    poison = poison - random(lvl / 2);
    if (poison > 0) {
      str += HIY "过了一小会儿，$N脸上留下斗大的汗珠，$n身上的" NOR + HIR "五毒之气" NOR + HIY "解去了小半.....\n" NOR;
      target->apply_condition("wudu_poison", poison);
    } else {
      str += HIW "$N缓缓的呼出一口气，如释重负，看来$n身上的" NOR + HIR "五毒之气" NOR + HIW "已经毒性全解了！\n" NOR;
      target->clear_condition("wudu_poison");
    }
    me->start_busy(5 + random(5));
    me->add("neili", -200);
  } else if (target->query_condition("ice_poison")) {
    poison = target->query_condition("ice_poison");
    poison = poison - random(lvl / 2);
    if (poison > 0) {
      str += HIY "过了一小会儿，$N脸上留下斗大的汗珠，$n身上的" NOR + HIR "寒冰掌毒" NOR + HIY "解去了小半.....\n" NOR;
      target->apply_condition("ice_poison", poison);
    } else {
      str += HIW "$N缓缓的呼出一口气，如释重负，看来$n身上的" NOR + HIR "寒冰掌毒" NOR + HIW "已经毒性全解了！\n" NOR;
      target->clear_condition("ice_poison");
    }
    me->start_busy(5 + random(5));
    me->add("neili", -200);
  } else {
    write("你试图用易筋经解毒，可是看不出中了什么毒！\n");
    return 1;
  }
  message_vision(str, me, target);
  return 1;
}
