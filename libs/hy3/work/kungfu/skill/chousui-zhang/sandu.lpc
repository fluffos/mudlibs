// sandu.c 抽髓掌散毒
// By xhh 2000.09

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);

  if (!me->is_fighting())
    return notify_fail("你不在战斗中。\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里不能攻击别人! \n");
  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("你使用了武器。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧ⅵ\n");

  if ((int)me->query_skill("huagong-dafa", 1) < 50)
    return notify_fail("你的化功大法不够娴熟，不能散毒。\n");

  if ((int)me->query_skill("beiming-zhenqi", 1) < 40)
    return notify_fail("你的北冥真气不够娴熟，不能散毒。\n");

  if ((int)me->query_skill("chousui-zhang", 1) < 40)
    return notify_fail("你的抽髓掌不够娴熟，不能散毒。\n");

  if ((int)me->query("neili", 1) < 400)
    return notify_fail("你的内力不够。\n");
  msg = MAG "$N把左掌缓缓抬起，掌心颜色由青变紫，冒出一缕缕寒气，随着大吼一声，手掌向$n猛拍过去。\n\n";
  if (random((int)me->query_skill("chousui-zhang", 1)) > random(target->query_skill("dodge"))) {
    me->start_busy(2);
    if ((int)target->query("combat_exp") < (int)me->query("combat_exp") / 2) {
      msg += BLU "$N一掌拍在$n胸口，不料$n内力太弱，$N反不能把毒气逼出去，功力受损。\n" NOR;
      me->add("neili", -200);
    } else {
      msg += BLU "$N一掌拍在$n胸口，待其运内力抵抗，顺势把周身毒气尽数逼进$n体内。\n" NOR;
      me->add("neili", -200);
      me->add("max_neili", -10);
      target->apply_condition("xx_poison", 1000);
      me->add("need_sandu", -1);
      target->start_busy(1 + random(2));
    }
  } else {
    me->start_busy(2);
    msg += HIY "$p赶紧向後跃开数丈，躲开$P的攻击。\n" NOR;
    me->add("neili", -200);
  }
  message_vision(msg, me, target);
  if (!target->is_fighting(me)) target->fight_ob(me);
  return 1;
}
