//fadai-shengong ONLY——YOU! 
//writed by xingyun 2001.9.12

#include <ansi.h>
inherit F_CLEAN_UP;

string *colour = ({ HIM, HIB, HIG, BLK, HIC, HIW, HIR, MAG, BLU, HIY });
string *song = ({
  "ON——LY YOU——！ 能伴我度过寂寞！",
  "ON——LY YOU——！ 能PK和杀魔！",
  "ON——LY YOU——！ 能保护我！",
  "叫怪物和玩家无法杀我！",
  "你本领最大，就是only you--！",
  "ON——LY YOU——！ 别怪我爱嘀咕！",
  "扛上菜刀，顶上锅盖，别怕死别颤抖！",
  "得经验我来，送死你去！",
  "拼全力为火云，牺牲也值得！",
  "南无阿弥陀佛！",
});

int exert(object me) {
  int skill;

  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力不够了。\n");

  if ((int)me->query("jingli") < 200)
    return notify_fail("你的精力不够了。\n");

  skill = me->query_skill("fadai-qigong", 1);

  if (skill < 120)
    return notify_fail("你的发呆气功等级不够，还不能歌唱。\n");

  if (me->query_temp("fadai/chang"))
    return notify_fail("你已经开始歌唱了，注意形象哦！。\n");

  message_vision(
    HIY "$N清了清嗓门，对众人说到：下面就由" + RANK_D->query_self(me)
    + "来为大家演唱一首——\n「" NOR + BLINK + HIB + RANK_D->query_self(me) + "的爱" NOR
    +HIY "」！还未等众人回过神来，$N已经开始开始了：\n" NOR, me);

  me->set_temp("fadai/chang", skill);
  call_out("yun_chang", 1, me);
  call_out("chang_over", 60, me);
  return 1;
}

int yun_chang(object me) {
  object *ob, *ilist, obj;
  string msg;
  int k, j, i, n;

  n = me->query_temp("fadai/song");

  if (!objectp(me) || !living(me)) {
    remove_call_out("yun_chang");
    return 1;
  }
  if (n == 0)
    msg = HIW "$N开始唱道：" NOR;
  else
    msg = HIW "$N继续唱道：" NOR;

  msg = msg + colour[n] + song[n] + BLINK "       裆！裆！裆！\n" NOR;
  message_vision(msg, me);

  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    if (!ob[i]->is_busy())
      ob[i]->start_busy(random(me->query_skill("force") / 80) + 1);
    ilist = all_inventory(ob[i]);

    if (random(me->query("kar")) < random(ob[i]->query("kar")) && random(2)) {
      for (j = 0; j < sizeof(ilist); j++) {
        if (ilist[j]->query("money_id") && random(2)) {
          message_vision(HIW "$N终于无法忍受，朝$n大叫道："
            +RANK_D->query_rude(me) + "还有完没完？噢噢——噢噢噢，"
            + "要下蛋呀？\n我靠——！一边骂着，随手将身上的" NOR
            +ilist[j]->query("name") + HIW "朝$n扔了过去！\n" NOR, ob[i], me);
          k = random(ilist[j]->query_amount() / 2 + 1);
          obj = new(base_name(ilist[j]));
          obj->set_amount(k);
          ilist[j]->set_amount(ilist[j]->query_amount() - k);
          obj->move(environment(ob[i]));
          break;
        } else continue;
      }
    }

  }

  me->add("neli", -30);
  me->add("jingli", -20);

  if (n == 9)
    return 1;

  me->add_temp("fadai/song", 1);
  call_out("yun_chang", 4, me);
  return 1;
}

int chang_over(object me) {

  if (objectp(me) && me->query_temp("fadai")) {
    me->delete_temp("fadai");
    return 1;
  }
}
