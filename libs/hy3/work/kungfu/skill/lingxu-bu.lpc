// lingxu-bu 凌虚步

inherit SKILL;

mapping *action = ({
([      "action" : "$n一式[1;35m「雪地莲花」[0m，身子掣忽一转，$N只觉的眼前一花，失去了目标。\n",
        "dodge"  : 40
]),
([      "action" : "$n一式[1;31m「一狐冲天」[0m，双脚点地，身子突然拔高了丈许，缓缓飘落在$N身后。\n",
        "dodge"  : 60
]),
([      "action" : "$n一式[33m「移行幻影」[0m，身行一晃，顿时无数条身影一下子出现在$N的面前。\n",
        "dodge"  : 80
]),
([      "action" : "$n一式[37m「狡兔三窟」[0m，飘然向后一退，躲开$N的凌厉攻势。\n",
        "dodge"  : 100
]),
([      "action" : "$n一式[1;30m「烟雨飘渺」[0m，身体急转，化为一道白光，虚幻不定的出现在$N的周围。\n",
        "dodge"  : 120
]),
});


int valid_enable(string usage)
{
        return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
        return 1;
}


