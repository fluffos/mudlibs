// sanqing.c  一剑化三清

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        object weapon, ob;
        string msg, string1;
        int count, skill, i, n;

        skill=me->query_skill("sword");
        if( me->query_temp("sanqing") )
                return notify_fail("你已经在使用「一剑化三清」了！\n");
        if( !me->is_fighting() )
                return notify_fail("「一剑化三清」只能在战斗中使用。\n");
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你必须有一把剑才能使用「一剑化三清」！\n");
        if( (int)me->query("neili") < 300 )
        return notify_fail("你的真气不够！\n");
        if( (int)me->query_skill("xiantian-qigong",1) < 60 ||    me->query_skill_mapped("force") != "xiantian-qigong")
                return notify_fail("你的先天功等级不够,无法运用「一剑化三清」！\n");
        if( (int)me->query_skill("sword",1) < 50 ||  me->query_skill_mapped("sword") != "quanzhen-jianfa")
        return notify_fail("你的全真剑法还不到家，无法使用「一剑化三清」！\n");
        if( skill<150 ) n=2;
        else if( skill<200 ) n=3;
        else if( skill<300 ) n=random(2)==0? 4:5;
        else if( skill<400 ) n=random(2)==0? 7:8;
        else n=10+random(5);
        msg = HIG "$N大喝一声，剑招突变，手中"+weapon->query("name")+HIG"闪出点点光芒，一剑化出"
        +HIY
        +(n<9? (n<7? (n<4? chinese_number(n):"四、五"):"七、八"):"无数")+HIG+"剑，剑剑指向敌人要害！\n" NOR;
        message_vision(msg,me);
        me->clean_up_enemy();
        ob = me->select_opponent();
        me->add_temp("apply/dodge", skill/3);
        me->add_temp("apply/attack", skill/3);
        for(i=0;i<n;i++)
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        me->set_temp("sanqing",1);
         me->add("neili", -100);
        if(!ob->is_fighting(me)) ob->fight_ob(me);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/3 :), 10);
        return 1;
}
void remove_effect(object me, int amount)
{
if ( (int)me->query_temp("sanqing") ) {
        me->add_temp("apply/attack", - amount);
        me->add_temp("apply/dodge", - amount);
        me->delete_temp("sanqing");
        tell_object(me, "你的「一剑化三清」运行完毕，剑法渐渐恢复正常。\n");}
}
