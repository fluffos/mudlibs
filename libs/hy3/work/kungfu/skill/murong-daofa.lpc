// murong-daofa.c 
// Gallop 99/04/27

inherit SKILL;

mapping *action = ({
  ([ "action": "$N挥舞$w，使出一招反两仪刀法的[1;34m「万劫不复」[0m，上劈下撩，左挡右开，齐齐罩向$n",
    "damage": 35,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N挥舞$w，使出慈悲刀中的[1;35m「张弓望的」[0m，上劈下撩，左挡右开，齐齐罩向$n",
    "damage": 35,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招胡家刀法的[36m「闭门铁扇」[0m，$w缓缓的斜着向$n推去 ",
    "damage": 40,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N使出一招火焰刀中的[1;34m「六道轮回」[0m，双手合十，当头劈向$n",
    "damage": 45,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N一招太极刀中的[1;33m「童子挂画」[0m，左右腿虚点，$w一提一收，平刃挥向$n的颈部",
    "damage": 35,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N贴地滑行，一招五虎断门刀之[5;31m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m，手中$w直撩去$n的裆部",
    "damage": 60,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N反转刀尖对准自己，一招修罗刀中的[5;1;33m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m，全身一个翻滚，$w向$n拦腰斩去",
    "damage": 40,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N就地一滚，使一招血刀的[1;31m「[5m[5m[0m血满地」[0m，手中$w卷向$n的大腿  ",
    "damage": 35,
    "damage_type": "割伤",
  ])
});

int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }

int valid_combine(string combo) { return combo == "murong-jianfa"; }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 35)
    return notify_fail("你的体力不够练慕容刀法。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "murong-daofa/" + action;
}
