// chan.c 打狗棒法「缠」字诀
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        object weapon;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
           return notify_fail("牵制攻击只能对战斗中的对手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
           || (string)weapon->query("skill_type") != "staff")
           return notify_fail("你使用的武器不对。\n");      

        if( target->is_busy() )
           return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

        if( (int)me->query_skill("dagou-bang", 1) < 100 )
            return notify_fail("你的打狗棒法不够娴熟，不会使用「缠」字诀。\n");

        if( (int)me->query_skill("huntian-qigong", 1) < 100 
            || me->query_skill_mapped("force") != "huntian-qigong" )
            return notify_fail("你的混天气功不够娴熟，不会使用「缠」字诀。\n");

        if( (int)me->query("neili") < 100 )
            return notify_fail("你现在内力不够，无法使用「缠」字诀。\n");

        msg=HIG"$N使出打狗棒法"HIR"「缠」"HIG"字诀，手中"+weapon->query("name")
           +HIG"攻势一转，顿时化为一团棒影飞舞\n缠绕于$n周身。\n"NOR; 
        if( random(me->query_skill("dagou-bang",1) ) >                            
                                target->query_skill("dodge",1)/4 )
        {
                msg += HIW"顿时$p被$P弄得头昏眼花，不知所措。\n" NOR;
                target->start_busy( (int)me->query_skill("dagou-bang",1) / 40 ); 
        } else 
        {
                me->start_busy(2);
                msg += HIC"可是$p看破了$P的企图，并没有上当。\n" NOR;
        }

        me->add("neili",-100);
        message_vision(msg, me, target);

        return 1;
}
