// chan.c 打狗棒法「缠」字诀
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        object weapon;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
           return notify_fail("獒口夺杖只能对战斗中的对手使用。\n");

        if ( objectp(weapon = me->query_temp("weapon")) )
           return notify_fail("你必须空手才能使用獒口夺杖。\n"); 

        if ( !objectp(weapon = target->query_temp("weapon")) )
           return notify_fail("对方手上什么也没有，你夺什么呀。\n");      

        if( (int)me->query_skill("dagou-bang", 1) < 150 )
           return notify_fail("你的打狗棒法不够娴熟，不会使用「缠」字诀。\n");

        if( (int)me->query_skill("huntian-qigong", 1) < 150 
            || me->query_skill_mapped("force") != "huntian-qigong" )
           return notify_fail("你的混天气功不够娴熟，不会使用「缠」字诀。\n");

        if( (int)me->query("neili") < 150 )
            return notify_fail("你现在内力不够，无法使用獒口夺杖。\n");

        msg=HIG"$N使出身法陡然加快，一瞬间已晃到了$n身前，一式"HIR"「獒口夺杖」"
             +HIG"，试图夺下\n$n手中的"NOR+weapon->query("name")+HIG"！\n"NOR; 

        if( random(me->query_skill("dagou-bang",1) ) >                          
                                target->query_skill("parry",1) / 5 )
        {
           msg += HIW"$p愕然间还未明白发生了何事，只觉手腕一麻，手中"
                  +"兵器竟然不翼而飞！！细看间，\n才发现$P正笑嘻嘻地看着$p，"
                  +"手里赫然是$p的"NOR+weapon->query("name")+HIW"。\n"NOR;
           weapon->equipped();
           weapon->move(me);

           if( (string)weapon->query("skill_type") == "staff" )
           weapon->wield();
        } else 
        {
                me->start_busy(4);
                msg += HIC"可是$p看破了$P的企图，并没有上当。\n" NOR;
        }

        message_vision(msg, me, target);
        me->add("neili",-150);
        return 1;
}

