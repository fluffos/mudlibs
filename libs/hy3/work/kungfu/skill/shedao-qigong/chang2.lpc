
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
    if( !target ) target = offensive_target(me);
    if( !target
    ||  !target->is_character()
    ||  !me->is_fighting(target) )
        return notify_fail("唱仙法只能在战斗中使用。\n");
    if( (int)me->query_skill("shedao-qigong", 1) < 120 )
        return notify_fail("你的蛇岛奇功不够娴熟，不会使用唱仙法。\n");
    if( (int)me->query_temp("chang") >= -1  )
        return notify_fail("你的前奏还没唱起来。\n");
    if( me->query("neili") / 3 > me->query("max_neili") )
        return notify_fail("你的内力太高了，再唱下去你控制不了。\n");
    message_vision(HIR "只听$N口中念念有词，顷刻之间内力大涨！\n" NOR, me);
    me->add_temp("apply/attack", - me->query_skill("shedao-qigong", 1)/10);
    me->add_temp("apply/defense", - me->query_skill("shedao-qigong", 1)/10);
    me->add_temp("chang", 1);
    me->add("neili", me->query_skill("shedao-qigong", 1));
    return 1;
}
