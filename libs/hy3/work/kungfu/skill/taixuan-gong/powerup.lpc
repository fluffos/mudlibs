// powerup.c
#include <ansi.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);
int exert(object me, object target) {
  int skill;
  if (target != me)
    return notify_fail("你只能用太玄神功提升自己的战斗力。\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够!");

  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("force");

  me->add("neili", -100);

  message_vision(
    HIC "$N一声清啸，全身衣袍象巨涛般向四面扩涨，霎时间一股猛烈无比的罡气充斥了$N全身.....\n" NOR, me);

  skill = skill + skill / 2;
  me->add_temp("apply/attack", skill);
  me->add_temp("apply/armor", skill / 2);
  me->add_temp("apply/defense", skill);
  me->set_temp("powerup", "taixuan");

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill / 2);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount) {
  if ((string)me->query_temp("powerup") == "taixuan") {
    me->add_temp("apply/attack", -amount);
    me->add_temp("apply/armor", -amount / 2);
    me->add_temp("apply/defense", -amount);
    me->delete_temp("powerup");
    tell_object(me, HIC "你的太玄神功运行完毕，将内力收回丹田。\n" NOR);
  }
  return;
}
