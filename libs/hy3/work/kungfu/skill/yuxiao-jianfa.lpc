int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 500)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("bibo-shengong", 1) < 150)
                return notify_fail("你的碧波神功火候太浅。\n");
        if ((int)me->query_skill("luoying-shenjian", 1) < 100)
                return notify_fail("你的落英神剑火候太浅。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("yuxiao-jianfa",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];

}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够练玉萧剑法。\n");
        me->receive_damage("qi", 30);
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
       object weapon;   
       if(objectp(weapon=me->query_temp("weapon"))
           && weapon->query("id_id") == "yu xiao"
           && me->query_skill_mapped("sword") == "yuxiao-jianfa")

       return damage_bonus;
}

string perform_action_file(string action)
{
        return __DIR__"yuxiao-jianfa/" + action;
}
