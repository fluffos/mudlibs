//heal.c
//daoxinshengong
//Made By Badbad

#include <ansi.h>

int exert(object me, object target)
{
    if( me->is_fighting() )
        return notify_fail("道心种魔大法是不能在战斗中运功，会走火入魔的！\n");
    if ((int)me->query_skill("daoxinshengong",1) < 35)
        return notify_fail("你的道心种魔大法还没到那样的等级！\n");
    if( (int)me->query("neili") < 100 )
        return notify_fail("你没有那么多的真气！\n");
    
    if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
        return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");

    write(HIR"你全身放松，眼睛微闭，暗地里运起道心种魔大法\n"NOR);
    message("vision",
            CYN + me->name() + "眼睛突然睁大，发出一种摄人心魂的眼光！\n"NOR,
            environment(me), me);

    me->set("eff_jing",me->query("max_jing"));
    me->set("eff_qi",me->query("max_qi"));
    me->set("eff_jingli",me->query("max_jingli"));
    me->add("force", -200);
    me->set("force_factor", 0);

    return 1;
}
