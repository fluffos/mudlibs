  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "十七！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "十八！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "十九！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "二十！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "二十一！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "二十二！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "二十三！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "二十四！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "二十五！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "二十六！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "二十七！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "二十八！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "二十九！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIR "三十！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIY "三十一！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIY "三十二！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIY "三十三！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIY "三十四！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIY "三十五！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIY "三十六！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  /*
        me->set("neili", 0);
        me->set("eff_jing", 0);
        me->set("eff_jingli", 0);
        me->set("eff_qi", 1);
        me->set("jing", 0);
        me->set("jingli", 0);
        me->set("qi", 1);
	me->set("food",0);
	me->set("water",0);
	me->unconcious();
//        if( me->is_fighting() ) me->start_busy(4);
*/

  return 1;
