//sha.c 杀字决

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int a_amount, int d_amount);

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, ob;
  int skill;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「杀」字决只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("「杀」字决必须用剑才能施展。\n");

  if ((int)me->query_skill("bisha-jian", 1) < 150)
    return notify_fail("你的「必杀剑」不够娴熟，不会使用「杀」字决。\n");

  //        if( (int)me->query("qi") > (int)me->query("max_qi") /10)
  //                return notify_fail("你还有到穷途末路，无法发挥必杀剑法的绝技。\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够。\n");

  skill = me->query_skill("zhenfeng-jian");
  msg = HIY "$N使出「必杀剑」中的绝技「杀」字决玩命的向$n连攻六六三十六剑！\n" NOR;
  message_vision(msg, me, target);

  if (living(target)) {
    if (!target->is_killing(me))
      target->kill_ob(me);
  }

  //        me->set("neili", 0);
  //        me->set("jing", 0);
  //        me->set("qi", 0);

  me->clean_up_enemy();
  ob = me->select_opponent();
  msg = HIC "一！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIC "二！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIC "三！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIC "四！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIC "五！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIC "六！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIC "七！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIC "八！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIC "九！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIC "十！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "十一！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "十二！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "十三！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "十四！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "十五！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  msg = HIB "十六！\n" NOR;
