// wudao.c 无刀

#include <ansi.h> 
inherit F_SSERVER;
 
int perform(object me,object target)
{
    string msg;
    object weapon;
    int skill, wound;

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「杀气腾腾」只能对战斗中的对手使用。\n");  

    skill = me->query_skill("qishen-dao",1);
    if( !(me->is_fighting() ))
        return notify_fail("「无刀」只能在战斗中使用。\n");
    if( skill < 150)
        return notify_fail("泣神刀的火厚不足, 你无法使出「无刀」！\n");
    if( me->query("neili") < 200 )
        return notify_fail("你的内力不够，无法运用「无刀」！\n");
 
    msg = HIC "$N使出泣神刀的无上绝学「无刀」, 顿时罡气逼人，\n";
    message_vision(msg, me, target);
    if ( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 )
 
    {
        if(userp(me))
            me->add("neili",-200);
        msg = "$n无法抵挡这无招的刀风，只觉得自己的内力正在一点一点地耗尽！\n" NOR;
        wound = -300 - random(200);
        if ( objectp(weapon = target->query_temp("weapon")))
                {
                        msg += "同时手腕一麻，手中";
                        msg += weapon->name();
                        msg += "脱手而出！\n" NOR;
                        weapon->move(environment(me));
                }
        if((int)target->query("neili") < wound)
            wound = target->query("neili");
        target->add("neili", wound);
        target->add("jing", wound / 5);
        target->start_busy(2);
        me->start_busy(2);
    }
    else
    {
        msg = "可是$n的看破了$N的企图，使$P的「刀风」没有起到作用。\n"NOR;
        me->start_busy(4);
    }
    message_vision(msg, me, target);
    return 1;
}

