// tie@fengyun
#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        string dodskill;
        int extra,exp1,exp2,i,oneneili=5,neili=0,damage;
        object weapon,ob;
        extra = me->query_skill("qishen-dao",1);
        
        if (!objectp(weapon = me->query_temp("weapon"))
               || (string)weapon->query("skill_type") != "blade")
        if (!objectp(weapon = me->query_temp("secondary_weapon"))
            || (string)weapon->query("skill_type") != "blade")
                      return notify_fail("你使用的武器不对。\n");

        for(i=1;i<=((int)(extra/40)<8? (int)(extra/40):8);i++)
        {oneneili*=2;
        neili+= oneneili;}
        if( (int)(extra/40)>8 ) neili+=1280*((int)(extra/40)-8);
        oneneili=5;
        if( (int)me->query("neili") < neili )
                return notify_fail("你的真气不够！\n");

        if( (int)me->query_skill("blade") < 150 ||
            me->query_skill_mapped("blade") != "qishen-dao")
                return notify_fail("你的「泣神刀法」还不到家，无法使用「杀气腾腾」！\n");
        if( (int)me->query_skill("wuji-shengong",1) < 100 ||    me->query_skill_mapped("force") != "wuji-shengong")
        return notify_fail("你的无极神功等级不够，无法使出「杀气腾腾」！\n");
        dodskill = (string) me->query_skill_mapped("dodge");
        if ( dodskill != "bugui-bufa")
                        return notify_fail("「杀气腾腾」需要不归步法的配合！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「杀气腾腾」只能对战斗中的对手使用。\n");
        weapon = me->query_temp("weapon");
        ob = target;
        if( !target->is_killing(me) ) target->kill_ob(me);
        exp1=me->query("combat_exp");exp2=ob->query("combat_exp");

        for( i=1;i<((int)(extra/40)<16? (int)(extra/40):16 ); i++ )
        {
        if(i==1) message_vision(HIY"$N神气贯通，将泣神刀法八式一气呵成！\n\n"HIR"第一式：面目全非！\n\n"NOR"$N手中"+weapon->query("name")+"斜指，一招「面目全非」，刀劲裹着刀锋，向$n撩去。\n\n" ,me,ob);
        else if(i==2) message_vision(HIR"第二式：家破人亡！\n\n"NOR"$N一招「家破人亡」，"+weapon->query("name")+"被右手反握，交叉挥动，连人卷成尖锥刀网，向$n直射而来。\n\n" NOR,me,ob);
        else if(i==3) message_vision(HIR"第三式：血海深仇！\n\n"NOR"$N展身虚步，提腰跃落，一招「血海深仇」，刀锋一卷，拦腰斩向$n。\n\n" NOR,me,ob);
        else if(i==4) message_vision(HIR"第四式：骨肉分离！\n\n"NOR"$N一招「骨肉分离」，"+weapon->query("name")+"大开大阖，自上而下划出一个闪电，直劈向$n。\n\n" NOR,me,ob);
        else if(i==5) message_vision(HIR"第五式：切肤之痛！\n\n"NOR"$N手中"+weapon->query("name")+"一沉，一招「切肤之痛」，双手持刃拦腰反切，砍向$n的胸口。\n\n" NOR,me,ob);
        else if(i==6) message_vision(HIR"第六式：天愁地惨！\n\n"NOR"$N一招「天愁地惨」，戾气冲天挥舞，人刀卷缠黑云，齐齐罩向$n。\n\n" NOR,me,ob);
        else if(i==7) message_vision(HIR"第七式：鬼哭神号！\n\n"NOR"$N一招「鬼哭神号」，左脚跃步落地，"+weapon->query("name")+"顺势往前，挟风声劈向$n。\n\n" NOR,me,ob);
        else if(i==8) message_vision(HIR"第八式：惊天泣神！\n\n"NOR"$N盘身驻地，一招「惊天泣神」，挥出一片流光般的刀影，向$n的全身涌去。\n\n" NOR,me,ob);
        else message_vision(HIR"最后一式：无式！\n\n"HIR"$N随随遍遍给了$n一刀。\n\n"NOR,me,ob);
        if(i<=8) oneneili*=2;
        if( random(exp1)>random(exp2)
            || random(me->query_skill("blade"))>ob->query_skill("dodge")/2 )
                {
                 damage = me->query_skill("blade")+me->query_skill("force");
                 damage = damage/2+random(damage/2);
                 ob->receive_damage("qi", damage/2,me);
                 ob->receive_wound("qi", damage/3,me);
                 me->add("neili",-oneneili);   
                message_vision(HIR"结果“噗嗤”一声，砍中了$n！\n\n"NOR,me,ob);
                }
        else me->add("neili",-oneneili);
        }
        me->start_busy(6);
        return 1;
}
