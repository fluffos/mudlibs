// 
#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
        HIY"只见$n身形一闪，$N眼前顿时出现了无数的影子，恍然间$n意见躲过了$N这一招。\n"NOR,
        HIC"但是$n突然腾空而起，闪在了一边。\n"NOR,
         HIW"$N突然发现$n的口中念念有词，觉得事情不妙，果然$n突然被消失在一阵烟雾中。\n"NOR,
        HIR"可是$n伸手扬出什么东西，$N顿时觉得眼前一黑，失去了准心。\n"NOR,
        MAG"却见$n突然消失，$N正大惑年解之际，觉得身后有阵阵杀气，$n不知什么时候意见到了$N的身后。\n"NOR,
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 45 )
                return notify_fail("你的体力太差了，不能练蟾蜍步法。\n");
        me->receive_damage("qi", 35);
        return 1;
}


