// jingang.c 金刚护体神功 
#include <ansi.h>
inherit F_CLEAN_UP;
int exert(object me) {
  int pow, skill1, skill2;

  skill1 = (int)me->query_skill("hunyuan-yiqi", 1);
  skill2 = (int)me->query_skill("buddhism", 1);

  if (!me->is_fighting())
    return notify_fail(
      "金刚不坏护体神功只能在战斗中使用。\n");

  if (me->query("gender") != "男性" || me->query("couple"))
    return notify_fail(
      "你已不是纯阳之体，已无法再运金刚不坏护体神功。\n");

  if (me->query("class") != "bonze")
    return notify_fail(
      "你不是佛门弟子，无法运金刚不坏护体神功。\n");

  if (me->query_temp("powerup"))
    return notify_fail("你已经在运功当中了。\n");

  if (skill1 < 250 || skill2 < 250)
    return notify_fail("你的混元一气功和禅宗心法等级不够。\n");

  if (me->query("max_neili") < 2000 || me->query("neili") < 1000)
    return notify_fail("你的内力不够。\n");

  pow = (skill1 - 100) * (skill2 - 200) / 100;

  message_vision(HIC "$N一声低吼，运起佛门金刚不坏护体神功，"
    + "全身犹如铜筋铁骨一般！\n" NOR, me);
  me->add("neili", -500);
  me->start_busy(2 + random(3));
  me->add_temp("apply/armor", pow);
  me->set_temp("powerup/jingang", pow);
  call_out("remove_effect", pow / 3, me);

  return 1;
}

void remove_effect(object me) {
  if (objectp(me) && me->query_temp("powerup/jingang")) {
    message_vision(HIW "$N金刚护体神功运行完毕，"
      + "全身又恢复了正常。\n" NOR, me);
    me->add_temp("apply/armor", -(int)me->query_temp("powerup/jingang"));
    me->delete_temp("powerup");
  }
  return;
}
