// bisha-jian.c 必杀剑
#include <ansi.h>
inherit SKILL;

mapping *action = ({
/*
([      "action" : HIY"$N使出必杀剑唯一招「毁灭」，简简单单给了$n一剑！"NOR,
        "force" : 100,
        "dodge" : -100,
        "damage" : 50,
        "skill_name" : "「毁灭」",
        "lvl"    : 100,
        "damage_type" : "刺伤"
]),
*/
([      "action" : HIY"$N使出必杀剑唯一招"+HIR+"「毁灭」"+HIY+"，简简单单给了$n一剑！"NOR,
        "force" : 100,
        "dodge" : -1,
        "damage" : 100,
        "skill_name" : HIR"「毁灭」"NOR,
        "lvl"    : 0,
        "damage_type" : "刺伤"
]),

});


int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 5000)
                return notify_fail("你的内力太弱，无法练「必杀剑」。\n");
        if ( (int)me->query("t") > 4 || (int)me->query("r") < 6  )
	        return notify_fail("由于天性不够「必杀剑」你永远学不了。\n");
        return 1;
}
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
/*
mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("bisha-jian",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];

}
*/
int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够练「必杀剑」。\n");
        if ((int)me->query("neili") < 50)
                return notify_fail("你的内力不够练「必杀剑」。\n");
        me->receive_damage("qi", 40);
        me->add("neili",-15);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"bisha-jian/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        if( damage_bonus < 100 ) return 0;

        if( random(damage_bonus/2) > victim->query_str() ) {
                victim->receive_wound("qi", (damage_bonus - 100) / 5 );
                return HIB "你听到「唰」一声轻响好似凉风吹过，忽然间$n血冒三丈，被剑气所伤！\n" NOR;
        }
}

