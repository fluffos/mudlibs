#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int count;

  if (!me->is_fighting())
    return notify_fail("「必杀斩」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_dex() < 20)
    return notify_fail("你的身法不够, 还不能使用这项绝技! \n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的真气不够！\n");


  msg = HIR "$N大开大阖，手中$W忽左忽右，一时间天地为之色变，正是" BLINK "" + HIW "必杀斩" + NOR + "\n" NOR;

  message_vision(msg, me);

  me->clean_up_enemy();
  ob = me->select_opponent();

  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

  me->add("neili", -300);

  return 1;
}
