// 
// yingfeng.c 迎风一刀斩
// by secret
 
#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
    string msg;
    object weapon, target;
        int skill, ap, dp;
        int neili_wound, qi_wound ;
    me->clean_up_enemy();
    target = me->select_opponent();
        skill = me->query_skill("cunzheng-daofa",1);
    if( !(me->is_fighting() ))
                return notify_fail("「迎风一刀斩」只能对战斗中的对手使用。\n");
 
      if( skill < 200)
                return notify_fail("你的「村正刀法」等级不够, 不能使出「迎风一刀斩」！\n");
    if( me->query("neili") < 300 )
                return notify_fail("你的内力不够，无法运功！\n");
 
        msg = HIC "$N突然收刀在胸，拼尽全力使出了"BLINK""+HIY+"「迎风一刀斩」"+NOR+"，向$n的头顶砍去。\n"NOR;
    message_vision(msg, me, target);
    ap = me->query("combat_exp") + skill * 400;
    dp = target->query("combat_exp") / 2;
    if( dp < 1 )
        dp = 1;
    if( random(ap) > dp )
    {
        if(userp(me))
            me->add("neili",-100);
                msg = HIG "$n只觉得眼前一黑，“哇”的一声喷出一口鲜血！\n"NOR;
        neili_wound = 100 + random(skill);
        if(neili_wound > target->query("neili"))
            neili_wound = target->query("neili");
        qi_wound = neili_wound / 5;
//                if(qi_wound > target->query("qi"))
//                        qi_wound = target->query("qi");
        target->add("neili", -neili_wound);
        target->add("qi", -qi_wound);
    target->add("eff_qi",-qi_wound);
        target->start_busy(2);
        me->start_busy(random(2));
    }
    else
    {
        msg = HIG "只见$n慌忙闪身，躲过了$N的必杀一击！\n"NOR;
        if(userp(me))
            me->add("neili",-100);
        me->start_busy(4);
    }
    message_vision(msg, me, target);
    return 1;
}

