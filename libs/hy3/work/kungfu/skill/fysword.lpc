// fy-sword.c
//written by kouga
inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N使出一招[37m「风满长空」[0m，手中的$w画了一道圆弧，向$n的$l刺来",
    "dodge": 100,
    "parry": -30,
    "damage": 150,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N左手轻轻拍出一掌，右手中的$w使出一招[31m「烈火腾云」[0m，斩向$n的$l",
    "dodge": -40,
    "parry": 150,
    "damage": 270,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N使出一招[36m「水到渠成」[0m，身形婉如流水，手中$w从天而降，斩向$n的$l",
    "dodge": 50,
    "damage": 60,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N使出一式的[37m「雷震四方」[0m对准$n的$l刺出一剑",
    "dodge": 200,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N将手中$w连晃几个虚招，一招[32m「草深雾泽」[0m向$n刺去",
    "dodge": 160,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N双手握剑，使出一招[35m「天目昭辉」[0m劈向$n的$l",
    "dodge": -100,
    "parry": 300,
    "damage": 140,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N手中剑轻轻一晃，$w化为一道电光，使出[33m「地老天荒」[0m刺向$n的$l",
    "dodge": 200,
    "parry": 200,
    "damage": 100,
    "damage_type": "刺伤"
  ]),
});
int valid_enable(string usage) {
  return (usage == "sword") || (usage == "parry");
}

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("fuliu-jian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}
int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练大旗风云剑法。\n");
  me->receive_damage("qi", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "fy-sword/" + action;
}
