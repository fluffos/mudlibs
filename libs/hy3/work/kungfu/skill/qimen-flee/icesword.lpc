#include <ansi.h>
inherit F_SSERVER;

void remove_effect(object me);
int conjure(object me, object target)
{
    object ob,*obj;
    int skill,damage,shield,time;

    if (!target) target = offensive_target(me);
    if (!target)
      return notify_fail("你要对谁使用"HIB"寒冰之剑魔法"NOR"？\n");     

    skill = me->query("spells/ice");
    if( skill < 1 )
      return notify_fail("你还没有掌握"HIB"寒冰之剑魔法"NOR"！\n");

    if( me->query_skill("qimen-flee",1) < 300 )
      return notify_fail("你的魔法修为不够！\n");

    if( me->query("jingli") < 500 )
      return notify_fail("你现在的法力不够使用"HIB"寒冰之剑魔法"NOR"！\n");
    if( me->query_temp("spells/conjure") )
      return notify_fail("你刚使用完法术，正在聚集法力！\n");
      
    damage = me->query_skill("qimen-flee",1) * skill;
    damage = damage/2 +random(damage/2);

    shield = target->query_temp("spells/shield");

    message_vision(HIB"$N口中喃喃念道：“水之精灵，请将你的力量借与你"
    +"忠实的信使，\n"+"让世界在你面前颤抖吧！——"BLINK+HIW"寒冰之剑"NOR+HIB"！”"
    +"嗖嗖之声不绝于耳，\n一枚枚寒冰之剑朝$n疾射而去！\n"NOR,me,target);

    if( random(me->query("combat_exp"))>target->query("combat_exp")/5)
    {
    if( shield == 0 )
    {
     message_vision(HIW"“哧”的一声，$N被冰剑连连击中，全身登时如"
     +"坠冰窟！\n"NOR,target);
     target->receive_damage("jing", damage/2,me);
     target->receive_wound("jing", damage/4,me);
    } else
    if( damage > shield )
    {
     message_vision(MAG"“哧”的一声，$N的魔法护盾被冰剑击穿，$N的全身不禁"
     +"泛起阵阵寒意！\n"NOR,target);
     damage=damage-shield;
     target->receive_damage("qi", damage/2,me);
     target->receive_wound("qi", damage/4,me);
     target->set_temp("spells/shield",0);
    } else
    {
     message_vision(HIC"“嘶嘶”声不绝，$N的魔法护盾尽数挡住了寒冰之剑攻击，"
     +"$N连呼侥幸！\n"NOR,target);
     target->set_temp("spells/shield",shield-damage);
    }
    } else
    message_vision(HIY"$N连忙提聚全身功力，将护体真气遍布周身，"
     +"任由冰剑“嘶嘶”掠耳而过！\n"NOR,target);  

    me->set_temp("spells/conjure","ice");
    me->start_busy(2);  
    time = 20 / skill;
    if(time < 5) time = 5;
    me->start_call_out( (: call_other, __FILE__, "remove_effect",me :), time);
    me->add("jingli",-200);
    if ( !target->is_killing(me) ) target->kill_ob(me);     
    return 1;
}

void remove_effect(object me)
{
   if(objectp(me) && me->query_temp("spells/conjure")=="ice")
   {
    me->delete_temp("spells/conjure");
    tell_object(me,MAG"你的魔力渐渐恢复了！\n"NOR);
   }
   return;
}

