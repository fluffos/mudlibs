#include <ansi.h>
inherit F_SSERVER;

void remove_effect(object me);
void ice_wind(object me,int num);

int conjure(object me, object target)
{
    int skill,time;

    skill = me->query("spells/ice")+me->query("spells/wind");

    if( me->query("spells/ice")<4 || me->query("spells/wind")<4 )
      return notify_fail(HIY"万神之雷"NOR"需要同时具备四级的"
             +"风之精灵和水之精灵魔法才能施用！\n");

    if( me->query_skill("qimen-flee",1) < 400 )
      return notify_fail("你的奇门五行法术修为不够！\n");

    if( me->query("jingli") < 1000 )
      return notify_fail("你现在的法力不够使用"HIW"万神之雷"NOR"！\n");
 
    if( me->query_temp("spells/conjure") )
      return notify_fail("你刚使用完法术，正在聚集法力！\n");

    message_vision(HIW"$N神情肃穆，满脸专注：“万物之精灵啊，请将你的力量借给你"
    +"忠实的信使吧，\n"+"让你的充斥了无穷力量的怒吼响彻天地吧！——"NOR+BLINK
    +HIY"万神之雷"NOR+HIW+"！$N全身开始发出\n阵阵夺目的光芒....\n"NOR,me);

    me->set_temp("spells/conjure","ice-wind");
    me->start_busy(5);

    time = 80 / skill;
    if(time <8 ) time = 8;
    me->start_call_out((:call_other,__FILE__,"ice_wind",me,skill/2:),time/2);
    me->start_call_out((:call_other,__FILE__,"remove_effect",me:),time);
    me->add("jingli",-1000);
    return 1;
}

void remove_effect(object me)
{
   if(objectp(me) && me->query_temp("spells/conjure")=="ice-wind")
   {
    me->delete_temp("spells/conjure");
    tell_object(me,MAG"你的魔力渐渐恢复了！\n"NOR);
   }
   return;
}

void ice_wind(object me,int num)
{
    int damage,skill,time,shield,i;
    object *env;

    skill = me->query("spells/ice")+me->query("spells/wind");
    if( num<=0 || !living(me) || environment(me)->query("no_fight"))
    {
     remove_call_out("ice_wind");
     return;
    }                         

    env=all_inventory(environment(me));
    for(i=0;i<sizeof(env);i++)
    {
     if( !env[i]->is_character() ) continue;
     if( env[i]->query("is_quest") && !me->is_fighting(env[i])) continue;
     if( userp(env[i]) && env[i]->query("age")<20 ) continue;

     damage = me->query_skill("qimen-flee",1) * skill;
     damage = damage/10 +random(damage/10);
     shield = env[i]->query_temp("spells/shield");

     if( shield == 0 )
     {
      tell_object(env[i],HIW"“喀嚓”一道雷电击中了你，你觉得双眼一阵眩晕，"
      +"两耳轰鸣不止！\n"NOR);
      env[i]->receive_damage("jing", damage/2,me);
      env[i]->receive_wound("jing", damage/4,me);
     } else
     if( damage > shield )
     {
      message_vision(MAG"“喀嚓”一声巨响，$N的魔法护盾无力再抵挡承受雷电，"
      +"登时被击穿一个大洞！\n"NOR,env[i]);
      damage=damage-shield;
      env[i]->receive_damage("qi", damage/2,me);
      env[i]->receive_wound("qi", damage/4,me);
      env[i]->set_temp("spells/shield",0);
    } else
    {
      tell_object(env[i],HIC"一道道雷电击来，你的魔法护盾立刻发挥作用，"
     +"将雷电劲数档于身外！\n"NOR);
      if(env[i]==me)
      env[i]->set_temp("spells/shield",shield-damage/2);
      else env[i]->set_temp("spells/shield",shield-damage);
    }
   if ( !env[i]->is_killing(me) ) env[i]->kill_ob(me);
   }
   num--;
   time = 80 / skill;
   if(time < 8) time = 8;
   call_out("ice_wind",time/2,me,num);
   return;
}

