#include <ansi.h>
inherit F_SSERVER;

void remove_effect(object me);
int conjure(object me, object target) {
  object ob, *obj;
  int skill, damage, shield, time;

  if (!target) target = offensive_target(me);
  if (!target)
    return notify_fail("你要对谁使用" HIR "火球攻击魔法" NOR "？\n");

  skill = me->query("spells/fire");
  if (skill < 1)
    return notify_fail("你还没有掌握" HIR "火球攻击魔法" NOR "！\n");

  if (me->query_skill("qimen-flee", 1) < 300)
    return notify_fail("你的魔法修为不够！\n");

  if (me->query("jingli") < 500)
    return notify_fail("你现在的法力不够使用" HIR "火球攻击魔法" NOR "！\n");

  if (me->query_temp("spells/conjure"))
    return notify_fail("你刚使用完法术，正在聚集法力！\n");

  damage = me->query_skill("qimen-flee", 1) * skill;
  damage = damage / 2 + random(damage / 2);

  shield = target->query_temp("spells/shield");

  message_vision(HIM "$N口中喃喃念道：“火之精灵，请将你的力量借给你"
    + "忠实的信使，\n" + "让他为你的光辉而战斗鼓舞吧！——" BLINK + HIR "火球攻击" NOR + HIM "！”"
    + "只见忽地一声，\n一颗火球径直朝$n飞去！\n" NOR, me, target);

  if (random(me->query("combat_exp")) > target->query("combat_exp") / 5) {
    if (shield == 0) {
      message_vision(HIR "“砰”的一声巨响，$N被火球击个正着，全身登时一片"
        + "焦黑！\n" NOR, target);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
    } else if (damage > shield) {
      message_vision(MAG "“砰”的一声巨响，$N的魔法护盾被火球击穿，登时被烧了个"
        + "焦头烂额！\n" NOR, target);
      damage = damage - shield;
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      target->set_temp("spells/shield", 0);
    } else {
      message_vision(HIC "“砰”的一声巨响，$N的魔法护盾挡住了火球攻击，"
        + "$N不由出了一身冷汗！\n" NOR, target);
      target->set_temp("spells/shield", shield - damage);
    }
  } else
    message_vision(HIY "$N连忙聚起全身真气，奋力一挡，竟将火球击飞！\n" NOR, target);

  me->set_temp("spells/conjure", "fire");
  me->start_busy(2);
  time = 20 / skill;
  if (time < 5) time = 5;
  me->start_call_out((: call_other, __FILE__, "remove_effect", me :), time);
  me->add("jingli", -200);
  if (!target->is_killing(me)) target->kill_ob(me);
  return 1;
}

void remove_effect(object me) {
  if (objectp(me) && me->query_temp("spells/conjure") == "fire") {
    me->delete_temp("spells/conjure");
    tell_object(me, MAG "你的魔力渐渐恢复了！\n" NOR);
  }
  return;
}
