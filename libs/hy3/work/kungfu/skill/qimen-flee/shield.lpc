#include <ansi.h>
inherit F_SSERVER;

void remove_effect(object me);
int conjure(object me, object target)
{
    object ob,*obj;
    int skill,shield,time;

    if (!target) target = me;

    skill = me->query("spells/wind");
    if( skill < 1 )
      return notify_fail("你还没有掌握"HIC"风之护盾"NOR"！\n");

    if( skill < 3 && target!=me)
      return notify_fail("你的"HIC"风之精灵"NOR"魔法等级还不足以对他人施用"HIC"风之护盾"NOR"！\n"); 

    if( me->query_skill("qimen-flee",1) < 300 )
      return notify_fail("你的奇门法术等级不够！\n");

    if( me->query("jingli") < 200 )
      return notify_fail("你现在的法力不够使用"HIC"风之护盾"NOR"！\n");

    if( me->query_temp("spells/conjure") )
      return notify_fail("你刚使用完法术，正在聚集法力！\n");

    if( target->query_temp("spells/shield") )
      return notify_fail("已经在使用"HIC"风之护盾"NOR"了！\n");

    shield = me->query_skill("qimen-flee",1) * 2 * skill;

    if( target==me )
    message_vision(HIG"$N口中喃喃念道：“风之精灵，请将你的力量借给你"
    +"忠实的信使，\n"+"保护他不受邪恶的伤害吧！——"BLINK+HIC"风之护盾"NOR+HIG"！”"
    +"一团青朦朦的雾气笼罩着$N的身体！\n"NOR,me);  
    else
    message_vision(HIG"$N口中喃喃念道：“风之精灵，请将你的力量借给你"
    +"忠实的信使，\n"+"保护他不受邪恶的伤害吧！——"BLINK+HIC"风之护盾"NOR+HIG"！”"
    +"一团青朦朦的雾气笼罩着$n的身体！\n"NOR,me,target);

    me->set_temp("spells/conjure","wind");
    target->set_temp("spells/shield",shield);
    me->start_busy(2);
    time = 20 / skill;
    if(time < 5) time = 5;
    me->start_call_out( (: call_other, __FILE__, "remove_effect",me :), time);
    me->add("jingli",-200);
    return 1;
}

void remove_effect(object me)
{
   if(objectp(me) && me->query_temp("spells/conjure")=="wind")
   {
    me->delete_temp("spells/conjure");
    tell_object(me,MAG"你的魔力渐渐恢复了！\n"NOR);
   }
   return;
}

