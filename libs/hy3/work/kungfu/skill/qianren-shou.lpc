// qianren-shou
#include <ansi.h>
inherit SKILL;

mapping *action = ({
([      "action" : "$N把气一提,左手向$n抓去.$n躲过这招.$N立刻使出"HBCYN"[千刃手]"NOR"中
的"BLINK""HIY"【扬】"NOR".$N向$n的后心轻轻一拍.\n",
        "force" : 120,
        "dodge" : -5,
        "damage" : 200,
        "lvl" : 0,
        "damage_type" : "内伤"
]),
([      "action" : "$N使出了"HBCYN"[千刃手]"NOR"中的"BLINK""HIC"【气海势】"NOR",$N右手向左一挥一道掌气排山
倒海般的扑向$n.",
        "force": 200,
        "parry": 20,
        "dodge": 100,
        "unarmed": 100,
        "damage" : 400,
        "lvl": 20,
        "damage_type": "淤伤"
]),
([      "action" : "$N把气运到手上,双掌瞬间变成了红色.$N使出"HBCYN"[千刃手]"NOR"中的必杀几绝
招"HIW"【"BLINK""HIY"天"HIR"地"HIG"共"HIC"灭"NOR""HIW"】"NOR"无数道白光飞向$n,$n顿时目瞪口呆",
        "force" : 220,
        "dodge" : 200,
        "parry" : 200,
        "unarmed" : 200,
        "damage" : 800,
        "lvl" : 100,
        "damage_type" : "划伤"
]),
});


int valid_enable(string usage) { return (usage == "hand") || (usage == "parry");}

int valid_combine(string combo) { return combo=="six-finger"; }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 100)
                return notify_fail("你的内力不够。\n");
//        if ((int)me->query_skill("wuzheng-xinfa", 1) < 20)
//                return notify_fail("你的无争心法火候不到。\n");
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	if( damage_bonus < 100 ) return 0;

	if( random(damage_bonus/2) > victim->query_str() )
	{
         victim->receive_wound("qi", (damage_bonus - 1000) / 2 );
		return HIR "你听到"BLINK"「嗤啦」"NOR""HIR"一声巨响，只见一个人影飞了出去! \n" NOR;
	}
}

mapping query_action(object me, object weapon)
{
        int i, level;
            level   = (int) me->query_skill("qianren-shou",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];

}

int practice_skill(object me)
{
        object weapon;

        if ((int)me->query("jing") < 50)
                return notify_fail("你的体力不够练千刃手。\n");
        me->receive_damage("jing", 30);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"qianren-shou/" + action;
}

