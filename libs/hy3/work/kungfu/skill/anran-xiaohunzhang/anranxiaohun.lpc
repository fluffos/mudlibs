// anranxiaohun.c  黯然消魂
//writed by xingyun

#include <ansi.h>
inherit F_SSERVER;

int perform(object me, object target)
{
        int damage,skill,ratio;
        string msg;   

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character()
            || !me->is_fighting(target) )
        return notify_fail("黯然消魂只能对战斗中的对手使用。\n");

        skill=(int)me->query_skill("anran-xiaohunzhang",1);

        if(skill<150)
        return notify_fail("你的黯然消魂掌不够娴熟，无法使用黯然消魂。\n");

        if( (int)me->query_skill("yunu-xinjing", 1) < 200)
        return notify_fail(
              "你的玉女心经修为甚浅，无法施展黯然消魂。\n"); 

        if( (int)me->query("neili") < 500 )
        return notify_fail("你现在内力太弱，不能使出黯然消魂。\n");    

        if(userp(me))
        {
        if(me->query("family/family_name")!="古墓派")
        return notify_fail("你不是古墓派弟子，不能使用黯然消魂！\n"); 

        if(!me->query("couple") || me->query("DIED")<2)
        return notify_fail("你孑然一身，从不知情为何物，又怎个黯然消魂？\n");
        }

        msg="$N嗟然长叹，黯然神伤，想到自己行将魂归于此，而心中爱侣"
        +"仍天隔一方，遥会无期，\n不禁潸然泪下，心中悲苦之极，恍若"
        +"已化为一具行尸走肉，再也不顾自身，若有若无\n地黯然一掌朝$n猛拍而去..... \n";

        ratio=me->query("max_qi")*100/me->query("eff_qi");
        if(ratio > 200) ratio=200;
        if(ratio <150) msg=RED+msg+NOR;
        else msg=HIB+msg+NOR;

        if(random(me->query("combat_exp"))>target->query("combat_exp")/4)
        {
        skill=skill+me->query_skill("yunu-xinjing",1);
        damage=skill+random(skill);
        msg=msg+HIR"$n猝然之间，被$N猛的一掌印在胸口，口中鲜血狂喷而出！\n"NOR;
        target->receive_damage("qi", damage*ratio/100,me);
        target->receive_wound("qi", damage*ratio*2/300,me);
        me->start_busy(2);
        target->start_busy(random(2)+1);
        } else
        {
        msg=msg+HIB"$n心中大骇，连忙连退十余步，才从$N割面刺骨的掌风中逃了开去！\n"NOR;
        me->start_busy(3);
        }

        me->add("neili", -damage/3);
        message_vision(msg, me, target);
        target->kill_ob(me);
        return 1;
}

