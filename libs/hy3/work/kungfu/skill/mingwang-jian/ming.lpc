//writed by xingyun
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, ob;
  int damage;
  string msg;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "sword")
      return notify_fail("你使用的武器不对。\n");

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("冥冥烈焰只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("mingwang-jian", 1) < 120)
    return notify_fail(
      "你的不动明王剑等级不够，不能用使出冥冥烈焰。\n");

  if ((int)me->query_skill("xiaowuxiang", 1) < 120
    || me->query_skill_mapped("force") != "xiaowuxiang")
    return notify_fail("你的小无相功等级不够，不能使出冥冥烈焰。\n");

  if ((int)me->query("neili") < 300)
    return notify_fail(
      "你现在内力太弱，不能使出冥冥烈焰。\n");

  if (target->is_busy())
    return notify_fail("对方正忙呢，加紧攻击吧。\n");

  msg = HIM "$N暗运小无相功，将内力注入手中利剑，竟荡起一阵阵红光，\n"
    + "扑天盖地地涌向惊呆的$n...\n" NOR;

  damage = me->query_skill("mingwang-jian", 1) + me->query_skill("sword", 1) / 2;
  damage = damage + me->query_skill("force", 1) / 2;
  damage = damage + me->query_skill("xiaowuxiang", 1);
  me->add("neili", -damage / 3);
  me->start_busy(2);

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 2
    || random(me->query_skill("force")) > target->query_skill("force") / 2) {
    msg += HIR "$p只觉一股热浪迎面扑鼻来，被压得无法呼吸！\n" NOR;
    target->start_busy(1 + random(me->query_skill("mingwang-jian", 1) / 50));
    target->receive_damage("qi", damage / 4, me);
    target->receive_wound("qi", damage / 2, me);
  } else {
    msg += HIY "$p连忙运功抵抗，总算顶住了$P的攻势！\n" NOR;
    me->start_busy(2);
  }
  message_vision(msg, me, target);

  return 1;
}
