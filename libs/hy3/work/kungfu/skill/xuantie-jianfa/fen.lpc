// 玉石俱焚 gong.c
//Write by godzilla 99.11.10

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon;
        int damage;
        string msg;

        if( !target )
        target = offensive_target(me);
        if( !target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail("「玉石俱焚」只能在战斗中使用。\n");
        if(userp(me) && (int)me->query("str") < 25 )
                return notify_fail("玄铁剑法关键在于一个“力”字，你臂力不够不能使用玉石俱焚！\n");
        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                        return notify_fail("你使用的武器不对。\n");
        if( (int)me->query("max_neili") < 1200 )
                return notify_fail("你现在内力不足，使不出玉石俱焚！\n");     
        if( (int)me->query("neili") < 1000 )
                return notify_fail("你现在内力不足，使不出玉石俱焚！\n");
        if( me->query_temp("xuantie-jianfa") )
                return notify_fail("你刚使完「玄铁剑法」的绝招，目前气血翻涌，无法再次运用！\n");
        msg = HIW "\n$N手中之剑叮呤不绝，一股真气围绕剑身，剑未出，气势已不可御，天下第一重招\n----「"+BLINK+HIR+"玉石俱焚"+NOR+HIW+"」已然出手，剑风犹如万马脱缰般的直逼$n而去！\n"NOR;        
        me->set_temp("xuantie-jianfa", 1);
         if (random((int)me->query("combat_exp")) > random(target->query("combat_exp") /2) )
        {                     
                damage = (int)me->query_skill("xuantie-jianfa", 1); 
                damage = damage*2 + random(damage*3);
                msg += HIR"$p被$P这一招攻得毫无还手之力，只听“哧”的一声，$p的鲜血已溅满全身！\n" NOR;
                message_vision(msg,me,target);
                call_out("perform2",0, me,target);
                call_out("remove_effect",10+300/me->query_con(), me); 
                target->receive_damage("qi", damage/3,me);
                target->receive_wound("qi", damage/2,me);
                me->start_busy(3);
                me->add("neili", -300);    
                } 
        else {
                me->start_busy(4);
                target->start_busy(2);
                me->add("neili", -200);
                msg +=HIY"$p忽然感觉到$P欲出剑的气势，竟无可比拟。当机立断，翻了出去。\n"NOR;
                message_vision(msg, me, target);
                call_out("remove_effect",10, me);
        }
        return 1;
}

int perform2(object me, object target)
{
        int damage;
        string msg;

        if( !objectp(me) || !objectp(target) ) return 1;

        msg = HIW "\n$N一剑未完，第二剑已经刺出，剑更快，气更盛，好一招玉石俱焚！\n"NOR;
         if(me->query_int()>= random(50))
        {
            
                me->start_busy(2);
                target->start_busy(3);
                me->add("neili", -300);
                damage = (int)me->query_skill("xuantie-jianfa", 1);                
                damage = damage*3 + random(damage*4);
                msg +=HIR"只听“哧”的一声，$n已经中招摇摇欲坠了！\n"NOR;
                message_vision(msg, me, target);
                damage += random(damage);
                target->receive_damage("qi", damage/3,me);
                target->receive_wound("qi", damage/2,me);
                }
                else
                {
                msg +=HIY"$n见剑气扑来，当机立断，立即翻了出去!\n"NOR;
                message_vision(msg, me, target);        
                me->start_busy(2);
                target->start_busy(1);
                me->add("neili", -200);
                }       
       return 1;
}

void remove_effect(object me)
{
        if (!me) 
        return;
        me->delete_temp("xuantie-jianfa");
        tell_object(me, HIR"\n你经过一段时间调气养息，又可以使用「玄铁剑法」的绝招了。\n"NOR); 
}

