int valid_enable(string usage) { return usage == "unarmed" || usage == "parry" || usage == "hand"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练移花手必须空手，得先放下你手里的东西。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力还不到火候，无法练移花手。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("yihua-hand", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了，去休息一会吧。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练移花手。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yihua-hand/" + action;
}
