  ([ "action": "$N一招「似实还虚」，左手直击突变虚招，右手从下穿出按向$n的腰部",
    "force": 150,
    "dodge": 20,
    "damage": 20,
    "lvl": 10,
    "skill_name": "似实还虚",
    "damage_type": "瘀伤"
  ]),
