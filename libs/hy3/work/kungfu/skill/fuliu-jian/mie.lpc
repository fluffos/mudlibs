// miejian.c  回风拂柳剑  (灭剑)
//writed by xingyun

#include <ansi.h>
inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  int damage, time;
  string msg;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("灭剑只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("fuliu-jian", 1) < 120)
    return notify_fail(
      "你的回风拂柳剑不够娴熟，不会使用「灭剑」。\n");

  if ((int)me->query_skill("linji-zhuang", 1) < 120
    || me->query_skill_mapped("force") != "linji-zhuang")
    return notify_fail(
      "你的临济十二庄等级不够，不能用内力使出灭剑。\n");

  if ((int)me->query("neili") < 300)
    return notify_fail(
      "你现在内力太弱，不能使出灭剑。\n");

  if (me->query_temp("perform/mie"))
    return notify_fail(
      "你刚用完灭剑，真气还未调匀，出不了灭剑！\n");

  msg = HIC "$N手中" NOR + weapon->query("name") + HIC "剑芒跃动，剑光暴长，"
    + "幻出死亡的色彩，剑尖渐渐逼近$n，\n$n看到漫天剑光，抽身后跃，只这"
    + "一刹，漫天剑影化为一剑直刺$n\n前胸，快捷无伦，只有一剑！\n" NOR;
  damage = me->query_skill("fuliu-jian", 1) + me->query_skill("sword", 1) / 2;
  damage = damage + me->query_skill("force", 1) / 2;
  damage = damage + me->query_skill("linji-zhuang", 1);
  damage = damage / 2 + random(damage / 2);

  me->add("neili", -damage / 3);
  me->start_busy(2);

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 2
    || random(me->query_skill("force", 1)) > target->query_skill("force", 1) / 2) {
    msg += HIC "$p根本没法躲避，一式「回风拂柳剑」的绝招「灭剑」端端正正"
      + "扎在了胸口！\n$p一低头，看见" NOR + weapon->query("name") + HIC "自胸口拔出！\n" NOR;
    target->start_busy(1 + random(3));
    target->receive_damage("jing", damage / 3, me);
    target->receive_wound("jing", damage / 2, me);
    target->receive_damage("qi", damage / 4, me);
    target->receive_wound("qi", damage / 2, me);
  } else {
    msg += HIY "$p轻轻一笑，微微一晃身形，避开了这一剑！\n" NOR;
    me->start_busy(2);
  }
  message_vision(msg, me, target);
  me->set_temp("perform/mie", 1);
  if (!target->is_killing(me))
    target->kill_ob(me);

  time = 360 / (int)me->query_con();
  call_out("start_next_perform", time, me);

  return 1;
}

void start_next_perform(object me) {
  if (objectp(me)) {
    tell_object(me,
      HIW "你真气运行一周天，翻腾不止的内息终于平静了下来。\n" NOR);
    me->delete_temp("perform/mie");
  }
  return;
}
