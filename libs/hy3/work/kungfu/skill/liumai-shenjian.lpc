// liumai-shenjian.c 六脉神剑
#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N侧身抬臂，右中指划了个半圈，一式[31m「中冲」[0m刺向$n的$l",
    "force": 320,
    "dodge": -5,
    "damage": 30,
    "lvl": 0,
    "skill_name": "[31m中冲[0m",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N左掌虚托，一式[36m「少冲」[0m，右手小指穿腋疾出，指向$n的胸前",
    "force": 380,
    "dodge": -5,
    "damage": 45,
    "lvl": 50,
    "skill_name": "[36m少冲[0m",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N俯身斜倚，左手半推，右手无名指一式[35m「关冲」[0m，向$n的$l划过",
    "force": 440,
    "dodge": -5,
    "damage": 55,
    "lvl": 100,
    "skill_name": "[35m关冲[0m",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一式[33m「少商」[0m，左掌护住丹田，右手大拇指斜指苍天，蓄势捺向$n的$l",
    "force": 520,
    "dodge": 1,
    "damage": 70,
    "lvl": 60,
    "lvl": 150,
    "skill_name": "[33m少商[0m",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N双掌平托胸前，左手食指一式[35m「商阳」[0m，指向$n的周身大穴",
    "force": 620,
    "dodge": 5,
    "damage": 100,
    "lvl": 200,
    "skill_name": "[35m商阳[0m",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N双目微睁，一式[36m「少商」[35m「商阳」[31m「中冲」[35m「关冲」[33m「少冲」[0m，双手幻化出千百个指影，一起刺向$n的$l",
    "force": 720,
    "dodge": 5,
    "damage": 200,
    "lvl": 300,
    "skill_name": "[36m少商[0m」「[35m商阳[0m」「[31m中冲[0m」「[35m关冲[0m」「[33m少冲[0m",
    "damage_type": "刺伤"
  ]),
});

int valid_enable(string usage) { return usage == "finger" || usage == "parry"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练六脉神剑必须空手。\n");
  if ((int)me->query_skill("kurong-changong", 1) < 300)
    return notify_fail("你的枯荣禅功火候不够，无法学六脉神剑。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，无法练六脉神剑。\n");
  if (me->query_skill("liumai-shenjian", 1) > 180)
    return notify_fail("你只能学到这里了，剩下的要靠自己练习了。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("liumai-shenjian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if (me->query("family/family_name") != "天龙寺")
    return notify_fail("六脉神剑只有天龙寺弟子可以练习。\n");
  if (me->query_skill("liumai-shenjian", 1) < 150)
    return notify_fail(
      "你现在六脉神剑还未到可以自行修炼的境界。\n");
  if ((int)me->query("qi") < 100)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 300)
    return notify_fail("你的内力不够练六脉神剑!\n");
  me->receive_damage("qi", 50);
  me->add("neili", -60);
  return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;

  if (random(me->query_con()) > victim->query_con() / 2
    && me->query("neili") > damage_bonus) {
    message_vision(
      HIW "你听到「吱啦」一声轻响，竟似是利剑划过的声音！\n" NOR, me);

    me->add("neili", -damage_bonus / 6);
    return (damage_bonus / 2 + random(damage_bonus));
  }
}

string perform_action_file(string action) {
  return __DIR__ "liumai-shenjian/" + action;
}
