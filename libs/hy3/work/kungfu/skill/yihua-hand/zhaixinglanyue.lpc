// zhaixinglanyue.c 摘星揽月
// 99-9-14 16:00

#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  string msg;
  object weapon, weapon2, target;
  int skill, dp, damage;

  me->clean_up_enemy();
  target = me->select_opponent();

  if ((int)me->query_temp("zhai"))
    return notify_fail("你正在夺别人的兵刃啊，还要夺什么？！\n");
  skill = me->query_skill("yihua-hand", 1);

  if (!(me->is_fighting()))
    return notify_fail("摘星揽月只能在战斗中夺取对手的兵器。\n");

  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("你必须空手才行。\n");

  if (!objectp(weapon2 = target->query_temp("weapon")))
    return notify_fail("对方没有兵刃，你夺个什么？\n");

  if (skill < 60)
    return notify_fail("你的移花手等级不够, 不能使用摘星揽月！\n");

  if (me->query_skill("mingyu-gong", 1) < 60)
    return notify_fail("你明玉功还不到家，使不出「摘星揽月」。\n");

  if (me->query("neili") < 60)
    return notify_fail("你的内力不够高，无法抢别人的兵器！\n");

  msg = HIB "$N双掌纷飞，招式曼妙，连连施出摘星妙手！\n";

  message_vision(msg, me);

  dp = target->query("combat_exp") / 2000;
  if (dp < 1)
    dp = 1;
  if (random(skill) > dp) {
    if (userp(me))
      me->add("neili", -60);
    msg = "$n只觉突有─般不可抗拒的力道引来，仿佛做梦般手中兵刃已到$N手中！\n" NOR;
    target->start_busy(2);
    weapon2->move(me);
    me->start_busy(1);
  } else {
    msg = "但是$n紧守门户，使得$N无从下手。\n" NOR;
    me->start_busy(3);
  }
  message_vision(msg, me, target);

  return 1;
}
