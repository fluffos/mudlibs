// lianquan 玉女素心剑法<<总决式>>
// By Kayin @ CuteRabbit 1999/3/16 new

#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  mapping myfam;
  string msg;
  object weapon;
  int skill, jing_cost;
  myfam = (mapping)me->query("family");
  skill = me->query_skill("meinu-quanfa", 1);
  jing_cost = (int)me->query("int") - 45;

  if ((!myfam || myfam["family_name"] != "古墓派"))
    return notify_fail("你不是古墓派弟子，不能使用总诀式练拳法。\n");

  if (me->is_fighting())
    return notify_fail("「总诀式」不能在战斗中演练。\n");

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练美女拳法必须空手。\n");

  if (me->query_skill("tianluo-diwang", 1) < 30)
    return notify_fail("你的天罗地网势火候不够，不能用总诀式练拳法.\n");

  if (!skill || (skill < 20))
    return notify_fail("你的美女拳法法等级不够, 不能用总诀式练！\n");

  if (me->query("neili") < 100)
    return notify_fail("你的内力不够，没有力气练玉女素心剑！\n");

  if (me->query("jing") < -jing_cost)
    return notify_fail("你现在太累了，无法集中精神演练美女拳法！\n");
  if ((int)me->query_skill("yunu-xinfa", 1) < (int)me->query_skill("yunu-jianfa", 1))
    return notify_fail("你的玉女心法修为不足以练美女拳法了。\n");

  msg = CYN "$N" CYN "演练了一套" HIM "美女拳法" NOR "。\n";
  message_vision(msg, me);

  me->add("neili", -20);
  me->add("jing", -jing_cost);
  me->add("qi", -15);
  me->improve_skill(
    "meinu-quanfa",
    ((int)me->query_skill("meinu-quanfa", 1) + ((int)me->query_skill("meinu-quanfa", 1) / 2))
  );

  msg = MAG "$P的「美女拳法」进步了！\n" NOR;
  me->start_busy(random(2));

  message_vision(msg, me);

  return 1;
}
