mapping *action = ({
  ([ "action": "$N力于指尖一招[34m「暗中使坏」[0m将$w射向$n的$l",
    "force": 50,
    "dodge": 0,
    "damage": 50,
    "skill_name": "暗中使坏",
    "lvl": 0,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N力于指尖一招[30m「无声无息」[0m将$w射向$n的$l",
    "force": 70,
    "dodge": 0,
    "damage": 30,
    "skill_name": "无声无息",
    "lvl": 100,
    "damage_type": "刺伤"
  ]),
  ([ "action": "忽然$N招式突变一招[31m「飞箭探喉」[0m一个$w直射$n的喉部",
    "force": 90,
    "dodge": 0,
    "damage": 150,
    "skill_name": "飞箭探喉",
    "lvl": 40,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一招[35m「大弓射雁」[0m将手中$w射向$n",
    "force": 90,
    "dodge": 0,
    "damage": 200,
    "skill_name": "大弓射雁",
    "lvl": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一招[37m「一石[36m二鸟」[0m分别将$w射向$n的$l和喉部",
    "force": 90,
    "dodge": 0,
    "damage": 250,
    "skill_name": "一石二鸟",
    "lvl": 100,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出[37m「[31m万[35m点[33m金[37m光[37m」[0m只见无数金光直射$n",
    "force": 120,
    "dodge": 0,
    "damage": 300,
    "skill_name": "万点金光",
    "lvl": 200,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N把全身之力运于指尖一招[0;5;36m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m将$w射向$n",
    "force": 300,
    "dodge": 0,
    "damage": 700,
    "skill_name": "百步穿杨",
    "lvl": 700,
    "damage_type": "刺伤"
  ]),
});

int valid_enable(string usage) {
  return usage == "throwing";
}

int valid_learn(object me) {
  if ((int)me->query_skill("throwing", 1) < 20)
    return notify_fail("你的基本暗器火候不够，无法学「唐门暗器」。\n");
  if ((int)me->query_skill("dodge", 1) < 50)
    return notify_fail("你的「基本轻功」火候不够，无法学「唐门暗器」。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练「唐门暗器」。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  int i, level;
  weapon = this_player()->query_temp("weapon");
  level = (int)me->query_skill("tangmen-anqi", 1);
  weapon->set_amount((int)weapon->query_amount() - 1);
  weapon->add("amount", -1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}
string perform_action_file(string action) {
  return __DIR__ "tangmen-anqi/" + action;
}
int practice_skill(object me) {
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练「唐门暗器」。\n");
  me->receive_damage("qi", 30);
  return 1;
}
