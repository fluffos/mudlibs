// hu.c 剑气护体
#include <ansi.h>
void remove_effect(object me, int a_amount, int d_amount);

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  int skill;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("剑气护体只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_skill("kuangfeng-jianfa", 1) < 30)
    return notify_fail("你的「狂风剑法」不够娴熟，不会使用剑气护体。\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query_temp("hu"))
    return notify_fail("你已经在运功\中了。\n");

  if ((int)me->query_skill("zhenfeng-xinfa", 1) < 100
    || me->query_skill_mapped("force") != "zhenfeng-xinfa")
    return notify_fail(
      "你震风心法修为不够，无法发挥狂风剑法的绝技。\n");

  skill = me->query_skill("kuangfeng-jianfa");
  msg = HIY "$N使出「狂风剑法」之剑气护体，瞬间周身剑气四散防御攻击。\n" NOR;
  message_vision(msg, me, target);

  me->add_temp("apply/attack", -skill / 4);
  me->add_temp("apply/dodge", skill / 2);
  me->set_temp("hu", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 3 :), skill / 4);

  me->add("neili", -100);
  if (me->is_fighting()) me->start_busy(1);

  return 1;
}

void remove_effect(object me, int a_amount, int d_amount) {
  me->add_temp("apply/attack", a_amount);
  me->add_temp("apply/dodge", -d_amount);
  me->delete_temp("hu");
  tell_object(me, HIY "你的剑气护体运行完毕，将内力收回丹田。\n");
}
