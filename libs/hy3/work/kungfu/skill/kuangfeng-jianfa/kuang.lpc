//狂风起兮云飞扬 kuang.c

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
void remove_effect(object me, int a_amount, int d_amount);
inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon,ob;
        int skill;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「狂风起兮云飞扬」只能在战斗中使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                return notify_fail("「狂风起兮云飞扬」必须用剑才能施展。\n");

        if( (int)me->query_skill("zhenfeng-xinfa",1) < 120
            || me->query_skill_mapped("force")!="zhenfeng-xinfa" )     
                return notify_fail("你的「狂风剑法」不够娴熟，不会使用「狂风起兮云飞扬」。\n");

        if( (int)me->query_skill("zhenfeng-xinfa",1) < 80
            || me->query_skill_mapped("force")!="zhenfeng-xinfa" )
            return notify_fail(
                   "你震风心法修为不够，无法发挥狂风剑法的绝技。\n");

        if( (int)me->query("neili") < 1000  ) 
                return notify_fail("你的内力不够。\n");

        skill = me->query_skill("kuangfeng-jianfa");
        msg = HIY "$N使出「狂风剑法」中的绝技「狂风起兮云飞扬」狂风般向$n刺出七剑！\n"NOR;
        message_vision(msg, me, target);

        me->add("neili", -400);

        ob = target;
        msg = HIC"狂！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = HIB"风！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = HIB"起！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = MAG"兮！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = MAG"云！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = WHT"飞！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg = WHT"扬！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

        if( me->is_fighting() ) me->start_busy(4);

        return 1;
}
