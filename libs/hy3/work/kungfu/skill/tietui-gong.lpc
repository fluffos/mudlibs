// tietui-gong.c  铁腿功

inherit SKILL;

mapping *action = ({
([      "action" : "$N使一招[37m「一腿惊天」[0m攻向$n的$l。",
        "force" : 150,
        "dodge" : 30,
        "skill_name" : "一腿惊天",
        "damage_type" : "外伤"
]),
([      "action" : "$N左腿虚晃$n的$l，忽的[1;30m「风云变换」[0m，灌足内力向$n的$l插去。",
        "force" : 250,
        "dodge" : 25,
        "skill_name" : "风云变换",
        "damage_type" : "外伤"
]),
([      "action" : "$N提腿转身，一招[1;33m「盘龙过江」[0m单腿扫向$n的软肋。",
        "force" : 300,
        "dodge" : 50,
        "skill_name" : "盘龙过江",
        "damage_type" : "外伤"
]),
([      "action" : "$N左腿单力，右腿变膝一式[1;36m「登峰探云」[0m击向$n的$n。",
        "force" : 320,
        "dodge" : 30,
        "skill_name" : "登峰探云",
        "damage_type" : "外伤"
]),
([      "action" : "$N施出[1;31m「风雨交加」[0m，双腿向下一压，运足真力，击向$n的$l。",
        "force" : 400,
        "dodge" : 45,
        "skill_name" : "风雨交加",
        "damage_type" : "外伤"
])
});

int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_learn(object me)
{
        if ((int)me->query_skill("yuxu-qigong", 1) < 30)
                return notify_fail("你的「昱旭气功」火候不够，无法学「铁腿功」。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练「铁腿功」必须空手。\n");
        if ((int)me->query("qi") < 30)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 20)
                return notify_fail("你的内力不够练「铁腿功」。\n");
        me->receive_damage("qi", 25);
        me->add("neili", -10);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"tietui-gong/" + action;
}

