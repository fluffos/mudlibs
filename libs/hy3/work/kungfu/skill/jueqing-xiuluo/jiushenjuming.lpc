// jiushenjuming.c (九神拘命)
// 99-9-11 14:25

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
    string msg, string1;
    int count;
 
        if( !me->is_fighting() )
            return notify_fail("「九神拘命」只能在战斗中使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                        return notify_fail("你使用的武器不对。\n");

        if((int)me->query_dex() < 30)
                return notify_fail("你的身法不够, 还不能使用这项绝技! \n");

        if((int)me->query_skill("mingyu-gong",1) < 120)
                return notify_fail("你的明玉功的火候还不到家, 不能使用这一绝技 !\n");

        if( (int)me->query_skill("sword") < 120 ||
            me->query_skill_mapped("sword") != "jueqing-xiuluo")
                return notify_fail("你的「绝情修罗剑」没有达到这个境界，现在还不能使出“九神拘命”！\n");

        if( (int)me->query("neili") < 500 )
                return notify_fail("你的真气不够！\n");


    msg = 
HIR "$N大开大阖，左手连连虚划，右手剑花点点，幻出九道剑气如电闪直击！\n" NOR;

        message_vision(msg, me);

        me->clean_up_enemy();
        ob = me->select_opponent();

        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);


        me->add("neili", -300);

    return 1;
}

