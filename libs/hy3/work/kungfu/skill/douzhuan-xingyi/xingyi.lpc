#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  int lvl;

  if (!me->is_fighting())
    return notify_fail("星移斗转只能在战斗中使用。\n");

  if ((int)me->query_skill("douzhuan-xingyi", 1) < 200)
    return notify_fail("你的星移斗转还未练成，不能使用！\n");

  if ((int)me->query_skill("parry", 1) < 200)
    return notify_fail("你的基本招架之法不够娴熟，不能使用星移斗转。\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你现在内力不足，不能使用星移斗转！\n");

  if (me->query_temp("yun/xingyi"))
    return notify_fail("你已经在使用星移斗转了！\n");

  if ((int)me->query_skill("shenyuan-gong", 1) < 200)
    return notify_fail("你的神元功火候不足，不能使用星移斗转！\n");

  if (me->query_skill_mapped("force") != "shenyuan-gong")
    return notify_fail("星移斗转需要神元功的配合！\n");

  if (me->query("family/family_name") != "姑苏慕容")
    return notify_fail("你不是姑苏慕容家传弟子，不会使用星移斗转！\n");

  message_vision(HIG "$N施展出姑苏慕容家传绝技——斗转星移，"
    + "全场游走，身手突然变得矫健异常！\n" NOR, me);

  me->add("neili", -250);
  me->start_busy(2);
  lvl = (int)me->query_skill("douzhuan-xingyi", 1);
  me->set_temp("yun/xingyi", 1);
  call_out("remove_effect", lvl / 2, me);

  return 1;
}

void remove_effect(object me) {
  if (!me || !objectp(me)) return;
  if (me->query_temp("yun/xingyi")) {
    message_vision(
      HIW "$N斗转星移功行完毕，略觉疲惫，不禁长嘘一口气。\n" NOR, me);

    me->set_temp("yun/xingyi", 0);
  }
  return;
}
