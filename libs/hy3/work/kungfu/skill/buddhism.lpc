// buddhism.c

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me) {
  //changed by xingyun,统一法术派别

  if ((int)me->query_skill("magic", 1))
    return notify_fail("哈哈！" + RANK_D->query_respect(me)
      + "既已钻研俗家修身养性之道，还学这个做甚？\n");

  if ((int)me->query_skill("taoism", 1))
    return notify_fail("哈哈！" + RANK_D->query_respect(me)
      + "既已钻研道学心法，还学这个做甚？\n");

  if (me->query("class") != "bonze")
    return notify_fail("哈哈！" + RANK_D->query_respect(me)
      + "不是我佛中人，怎么却来学禅宗心法？\n");

  if ((int)me->query("PKS") > 3)
    return notify_fail(
      "你屡犯僧家数戒，杀孽之心太重，无法修炼禅宗心法。\n");

  return 1;
}

int practice_skill(object me) {
  return notify_fail("禅宗心法只能靠学(learn)来提高。\n");
}
