// hu.c 剑气护体

#include <ansi.h>
inherit F_SSERVER;

void remove_effect(object me, int a_amount, int d_amount);
int perform(object me, object target) {
  object weapon;
  int skill;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("剑气护体只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_skill("zhenfeng-jianfa", 1) < 30)
    return notify_fail("你的「震风剑法」不够娴熟，不会使用剑气护体。\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query_temp("zfj-hu"))
    return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("zhenfeng-jian");
  msg = HIY "$N使出「震风剑法」之剑气护体，瞬间周身剑气四散防御你的攻击。\n" NOR;
  message_vision(msg, me, target);

  me->add_temp("apply/attack", -skill / 4);
  me->add_temp("apply/dodge", skill / 3);
  me->set_temp("zfj-hu", 1);

  me->start_call_out(
    (: call_other, __FILE__, "remove_effect", me, skill / 4, skill / 3 :),
    skill / 4
  );

  me->add("neili", -100);
  if (me->is_fighting()) me->start_busy(2);

  return 1;
}

void remove_effect(object me, int a_amount, int d_amount) {
  me->add_temp("apply/attack", a_amount);
  me->add_temp("apply/dodge", -d_amount);
  me->delete_temp("zfj-hu");
  tell_object(me, HIY "你的剑气护体运行完毕，将内力收回丹田。\n");
}
