// murong-jianfa.c 
// Gallop 99/04/27

inherit SKILL;

mapping *action = ({
([      "action" : "$N手中的$w一晃，使出华山剑法中[36m「苍松[1;36m迎客」[0m一式，直刺$n的$l",
        "damage" : 50,
        "damage_type" : "刺伤"
]),
([      "action":"$N合掌跌坐，一式达摩剑中的[37m「禅心[1;36m顿[1;37m自明」[0m，$w自怀中跃出，如疾电般射向$n的胸口",
        "damage": 45,
        "damage_type":  "刺伤"
]),
([      "action" : "$N一式伏魔剑中的[1;35m「劈地势」[0m，$w从上至下猛劈，剑锋直出，挟爆裂之声骤然斩向$n的$l",
        "damage" : 45,
        "damage_type" : "刺伤"
]),
([  "name":         "人面桃花",
        "action":       "$N舞动$w，一式落英剑法的[1;33m「人面[1;35m桃花」[0m，手中$w抖出几朵剑花挟着虎虎剑气刺向$n的$l",
        "damage":       50,
        "damage_type":  "刺伤"
]),
([      "action" : "$N飞身一跃，居高临下使出明王剑法中[1;31m「花雨[1;36m满天」[0m一招，顿时剑尖如雨刺向$n的$l  ",
        "skill_name" : "花雨漫天",
        "damage" : 45,
        "damage_type" : "刺伤",
]),
([      "action" : "$N一招太极剑中的[1;36m「顺水[1;32m推舟」[0m，$w自上而下划出一个大弧，平平地向$n的$l挥去。",
        "damage" : 45,
       "damage_type" : "刺伤"
]),
([      "action":"$N错步上前，使出天羽奇剑中[1;37m「闪电[1;31m惊虹」[0m一式，手中$w划出一道剑光劈向$n的$l",
        "damage": 40,
        "damage_type":  "刺伤"
]),
([      "action":"\n$N一式云龙剑中的[1;33m「志当[1;31m存[1;36m高远」[0m，纵身飘开数尺，运发剑气，手中$w遥摇指向$n的$l",
        "damage": 30,
        "damage_type":  "刺伤"
])
});

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_combine(string combo) { return combo=="murong-daofa"; } 

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 100)
                return notify_fail("你的内力不够。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("qi") < 35)
                return notify_fail("你的体力不够练慕容剑法。\n");
        me->receive_damage("qi", 30);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"murong-jianfa/" + action;
}
