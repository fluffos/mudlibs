int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
int valid_learn(object me) 
{
        object weapon;
        if (!objectp(weapon = me->query_temp("weapon"))        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if( (int)me->query("max_neili")<200)
                return notify_fail("你的内力太弱了，不能练玉女素心剑法.\n");
        if( (int)me->query_skill("yunu-xinjing",1)<30)
                return notify_fail("你的玉女心法修为不够，不能学习玉女素心剑法。\n");
        if( (int)me->query_skill("yunu-xinjing",1)<(int)me->query_skill("yunu-jianfa",1))
                return notify_fail("你的玉女心法修为不足以继续练玉女素心剑法了。\n"); 
        return 1; 
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");

        if ((int)me->query("qi") < 100)
        return notify_fail("你的体力不够练玉女剑法。\n");

        if( (int)me->query_skill("yunu-xinjing",1)
             < (int)me->query_skill("yunu-jianfa",1))
        return notify_fail("你的玉女心法修为不足以继续练玉女素心剑法了！\n");   
     
        me->receive_damage("qi", 80);
        return 1;
}

int valid_combine(string combo) { return combo=="yinsuo-jinling"; } 

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        object parter,weapon1;
        mapping hebi,hebi1;
        string msg;
        int pow=0;
        level   = (int) me->query_skill("yunu-jianfa",1);

        if ( me->query_temp("hebi")
         && objectp(parter=present(me->query_temp("hebi"),environment(me)))
         && (parter==me || ( objectp(weapon1=parter->query_temp("weapon"))
         && (string)weapon1->query("skill_type") == "sword"
         && parter->query_skill_mapped("sword") == "quanzhen-jianfa")))
        {
          hebi=action_hebi1[random(sizeof(action_hebi1))];   
          if(me==parter) msg=HIM+ hebi["action"]+HIM"，紧接着$N";
          else
         {
          msg =HIM + hebi["action"]+HIM"，紧接着"+parter->query("name");
          pow=50;
         }
          msg = msg + "配合一式全真剑法的\n"+action_hebi2[random(sizeof(action_hebi2))]
                  +HIM"，两剑合为一剑，一齐攻向$n的$l"NOR;

          hebi1=([
                 "action":   msg,
                 "force" :   hebi["force"]+pow*2,
                 "dodge" :   hebi["dodge"]+pow,
                 "damage":   hebi["damage"]+pow,
                 ]);

          return hebi1;
        } else
        {
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"]) 
         return action[NewRandom(i, 20, level/5)];
        }
}

string perform_action_file(string action)
{
        return __DIR__"yunu-jianfa/" + action;
}
