#include <ansi.h>

int exert(object me, object target)
{
        int lvl,lvl1,poison;
        string str;

        lvl=(int)me->query_skill("zixia-shengong",1);
        lvl1=(int)me->query_skill("ziyin-yin",1);

        if( me->is_fighting() )
        return notify_fail("战斗中不能运功疗伤。\n");

        if (lvl< 100)
        return notify_fail("你的紫霞神功修为不够。\n");

        if (lvl1 < 100)
        return notify_fail("你的紫氤吟修为不够。\n");

        if( (int)me->query("neili") < 500 ) 
        return notify_fail("你的真气不够。\n");

        if(!target) target=me;

        str=HIM"$N全身放松，坐下来开始给$n运功疗伤。" NOR;
        

        if(target->query_condition("hunyuan_hurt"))
        {
         poison=target->query_condition("hunyuan_hurt");
         poison=poison-random((lvl+lvl1)/10);
         if(poison>0)
         {
         str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，\n$n身上的"NOR
               +HIR"混元无极"NOR+HIM"伤势好了小半.....\n"NOR;
         target->apply_condition("hunyuan_hurt", poison);
         } else
         {
         str+=HIM"$N缓缓的呼出一口气，如释重负，\n看来$n身上的"NOR
              +HIR"混元无极"NOR+HIW"伤势已经全好了！\n"NOR;
         target->clear_condition("hunyuan_hurt");
         }
         me->start_busy(5+random(5));
         me->add("neili",-200);
         message_vision(str,me,target);
        } else   
        {
         write("对方没未身中混元无极伤势！\n");
        }
        return 1;
}


