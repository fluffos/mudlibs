// pojian.c 破剑式
//rewrited by xingyun 
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  object weapon, weapon2;
  int skill, ap, dp, damage;
  skill = me->query_skill("dugu-jiujian", 1);

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「破剑式」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if (!objectp(weapon2 = target->query_temp("weapon")))
    return notify_fail("对方没有使剑，你用不了「破剑式」。\n");
  if ((int)me->query_skill("zixia-shengong", 1) < 150)
    return notify_fail("你的紫霞神功造诣太浅，用不了「破剑式」。\n");

  if (skill < 120)
    return notify_fail("你的独孤九剑等级不够, 不能使用「破剑式」！\n");
  if (me->query("neili") < 150)
    return notify_fail("你的内力不够，无法运用「破剑式」！\n");

  msg = HIC "$N举剑画弧，默潜独孤九剑之「破剑式」, 绵绵剑意，漫天铺地袭向$n。\n";
  me->start_busy(2);
  damage = 10 + random(skill / 2);
  ap = me->query("combat_exp") + skill * skill * skill / 10;
  dp = target->query("combat_exp") * 3 / 4;
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    msg += "$n顿时觉得眼前一花，手腕一麻，手中";
    msg += weapon2->name();
    msg += "脱手而出！\n" NOR;

    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage, me);
    target->start_busy(skill / 25 + random(3));
    weapon2->move(environment(me));
  } else {
    msg += "可是$n看破了$N的剑路，立刻将手中" NOR + weapon2->name() + HIC "舞得风雨不透，\n使$N的「破剑式」没有起到作用。\n" NOR;
    me->start_busy(2);
  }

  me->add("neili", -150);
  message_vision(msg, me, target);
  return 1;
}
