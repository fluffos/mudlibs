// poqi.c 破气式
 
#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
    string msg;
    object weapon, target;
    int skill, ap, dp, neili_wound, qi_wound;
    skill = me->query_skill("dugu-jiujian",1);

    if( !target ) target=offensive_target(me);
    if( !target || !me->is_fighting(target))
        return notify_fail("「破气式」只能对战斗中的对手使用。\n"); 
 
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    if( skill < 150)
        return notify_fail("你的独孤九剑等级不够, 不能使用「破气式」！\n");
    if( me->query("neili") < 150 )
        return notify_fail("你的内力不够，无法运用「破气式」！\n");
   if((int)me->query_skill("zixia-shengong",1)<150)
   if((int)me->query_skill("zixia-shengong",1)<150)
      return notify_fail("你紫霞神功造诣太浅，不用「破气式」！\n");

    msg = HIC "$N潜运独孤九剑「破气式」，运气贯剑使其由利返钝，毫无花俏地直刺$n的丹田。\n";
    message_vision(msg, me, target);
 
    ap = me->query("combat_exp")+skill*skill*skill/10;
    dp = target->query("combat_exp")*3/4;
    if( dp < 1 )
        dp = 1;
    if( random(ap) > dp )
    {
        me->add("neili",-150);
        msg = "$N运起「破气式」, $n顿时觉得眼前一花，气海穴上微微一痛，\n";
        msg += "全身真气狂泄而出！\n" NOR;
        skill = skill+me->query_skill("sword",1)/2;
        neili_wound = skill*3 + random(skill*3);
        if(neili_wound > target->query("neili"))
            neili_wound = target->query("neili");
        qi_wound = neili_wound / 6;
        target->add("neili", -neili_wound);
        target->recieve_damage("qi", qi_wound/2,me);
        target->recieve_wound("qi", qi_wound/3,me); 
        target->start_busy(2);
    }
    else
    {
            me->add("neili",-100);
        msg = "可是$n看破了$N的企图，立刻守紧门户，几经艰难终于还招挡开。\n"NOR;
    }
    message_vision(msg, me, target);
    return 1;
}
