#include <ansi.h>
inherit F_SSERVER;

int perform(object me, object target)
{
        object weapon1,weapon2,enemy;
        int skill;

        enemy = offensive_target(me);

        if( !target ) target = me;
        if( target->is_fighting(me) ) target = me; 

        weapon1=me->query_temp("weapon");
        weapon2=target->query_temp("weapon");

        if( me->query("family/family_name")!="古墓派" 
            || me->query("gender")!="女性")
          return notify_fail(
                 "你不是古墓派小龙女的嫡传弟子，不会使用合壁！\n");

        if( me->query_temp("hebi"))
          return notify_fail("你已经在合壁了。\n");

        if( target->query_temp("hebi"))
          return notify_fail("对方已经在合壁中了。\n");

        if( me->query("jingli") < 200)
          return notify_fail("你的精力不够了。\n");

        if (target->query("jingli") < 200)
          return notify_fail("对方的精力不够了。\n");

        if( !me->is_fighting(enemy) || !target->is_fighting(enemy))
          return notify_fail("合壁只能在战斗中使用。\n");

        if ( target!=me && me->is_fighting(target))
          return notify_fail("你正在和对方打架，合壁干什么？\n");

        if( (int)me->query_skill("yunu-jianfa", 1) < 200 )
          return notify_fail("你的玉女剑法未到火候，如何会懂得合壁？\n");

        if( target==me )
        if( (int)me->query_skill("quanzhen-jianfa", 1) < 200 
            || me->query_skill("hubo",1)<200)
          return notify_fail("你没有领会左右互博和全真剑法，如何会懂得合壁？\n");

        if( (int)me->query_skill("yunu-xinjing", 1) < 200 )
          return notify_fail("你的玉女素心功未到火候，如何会有合壁的威力？\n");

        if (!weapon1 || weapon1->query("skill_type") != "sword"
            || me->query_skill_mapped("sword") != "yunu-jianfa")
          return notify_fail("你为使用玉女剑法，无法合壁。\n");

        if( target!=me)
        if (!weapon2 || weapon2->query("skill_type") != "sword"
            || target->query_skill_mapped("sword") != "quanzhen-jianfa")
          return notify_fail("对方并没有使用全真剑法，无法和你合壁。\n");

        if( target!=me && target->query("gender")!="男性")
          return notify_fail("你们？？？居然也想合壁，没那感情吧？\n");

        skill=(int)me->query_skill("yunu-jianfa",1);

        if( target==me )
        {
    message_vision(HIR"$N心分二用，双手各持一把"NOR+weapon1->query("name")
    +HIR"，熟练地划了个圆弧，\n左手使全真剑法，右手使玉女剑法，双剑合壁，威力"
    +"顿时倍增！\n"NOR,me);
         me->add("jingli",-200);
         me->set_temp("hebi",me->query("id"));
        } else
        {
    message_vision(HIM"$N向$n温柔地示意了一眼，$n会意地朝$N报以默契的一笑，"
    +"\n随即$N使出玉女剑法，$n使出全真剑法，两人双剑合壁，"
    +"威力顿时倍增！\n"NOR,me,target);
         me->add("jingli",-200);
         me->set_temp("hebi",target->query("id"));
         target->add("jingli",-200);
         target->set_temp("hebi",me->query("id"));
        }
      call_out("remove_effect",skill/3,me,target);
      return 1;
} 

void remove_effect(object me,object target)
{
     if(objectp(me))
     {
      tell_object(me,
      HIR"你双剑合壁剑法使完，不禁略感疲惫，当下气运周身。\n"NOR);
      me->delete_temp("hebi");
     }

     if(objectp(target) && target!=me)
     {
      tell_object(target,
      HIR"你双剑合壁剑法使完，不禁略感疲惫，当下气运周身。\n"NOR);
      target->delete_temp("hebi");
     }

     return;
}

