// roar.c 佛门狮子吼

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target)
{
        object *ob;
        int i, foo, skill, damage;

        if (me->query("family/family_name") != "明教")
           return notify_fail("你不是明教弟子，不能使用九阳神功。\n");

        if( ((int)me->query("neili") < 600 ) || ( (int)me->query_skill("jiuyang-force") < 20) )
                return notify_fail("你鼓足真气\"喵\"的吼了一声, 结果吓走了几只老鼠。\n");


        skill = me->query_skill("force");

        me->add("neili", -150);
        me->receive_damage("qi", 10);
        me->start_busy(2+random(3));
        message_vision(
                HIY "$N深深地吸一囗气，真力迸发，发出一声惊天动地的巨吼ⅵ\n" NOR, me);

        ob = all_inventory(environment(me));
        for(i=0; i<sizeof(ob); i++) {
                if( !living(ob[i]) || ob[i]==me ) continue;
                if( skill/2 + random(skill/2) < (int)ob[i]->query("con") * 2 ) continue;
                
                foo=(int)me->query("neili")/(100+(int)ob[i]->query("neili"));
                if(foo>3) foo=3;
                else if(foo=0) foo=1;
                damage=random(foo*skill/3)+skill;
                
                if( damage > 0 )
                {
                ob[i]->receive_damage("jing", damage);
                if( (int)ob[i]->query("max_neili") < skill * 2 )
                ob[i]->receive_wound("jing", damage);
                tell_object(ob[i], 
                 "你觉得眼前一阵金星乱冒，耳朵痛得像是要裂开一样ⅵ\n");
                }  

                if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);
                if( !me->is_killing(ob[i]) ) me->fight_ob(ob[i]);
        }

        return 1;
}

