//taishan-shibapan.c 泰山十八盘
#include <ansi.h>
inherit SKILL;

mapping *action = ({
([      "action" : "$N虚步提腰，一招「[1;36m云绕四方[0m」，手中$w轻轻颤动，一剑剑点向$n的$l",
        "force" : 60,
        "dodge" : 20,
        "parry" : 10,
        "damage" : 45,
        "lvl" : 0,
        "skill_name" : "「[1;36m云绕四方[0m」",
        "damage_type" : "刺伤"
]),
([      "action" : "$N向前跨上一步，左手剑诀，右手$w使出一式「[1;36m清山[1;35m独秀[0m」直刺$n的$l",
        "force" : 70,
        "dodge" : 15,
        "parry" : 10,
        "damage" : 60,
        "lvl" : 50,
        "skill_name" : "「[1;36m清山[1;35m独秀[0m」",
        "damage_type" : "刺伤"
]),
([      "action" : "$N身形往右一挫，左手剑诀，右手$w使出一式「[1;32m群峰[36m叠起[0m」刺向$n的$l",
        "force" : 80,
        "dodge" : 15,
        "parry" : 10,
        "damage" : 70,
        "lvl" : 100,
        "skill_name" : "「[1;32m群峰[36m叠起[0m」",
        "damage_type" : "刺伤"
]),
([      "action" : "$N双膝下沉，右手$w使出一式「[1;32m绿水[1;36m清山[0m」，由下而上疾刺$n的$l",
        "force" : 90,
        "dodge" : 15,
        "parry" : 10,
        "damage" : 90,
        "lvl" : 140,
        "skill_name" : "「[1;32m绿水[1;36m清山[0m」",
        "damage_type" : "刺伤"
]),
([      "action" : "$N一招[1;37m「[1;30m雾[37m绕[1;33m琼[1;31m峰[1;37m」[0m，$w自上而下划出一个大弧，平平地向$n的$l挥去",
        "force" : 100,
        "dodge" : 15,
        "parry" : 15,
        "damage" : 100,
        "lvl" : 190,
        "skill_name" : "[1;37m「[1;30m雾[37m绕[1;33m琼[1;31m峰[1;37m」[0m",
        "damage_type" : "刺伤"
]),


});


int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 300)
                return notify_fail("你的内力太弱，无法练「泰山十八盘」。\n");
        return 1;
}
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("taishan-shibapan",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];

}
int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力不够练「泰山十八盘」。\n");
        if ((int)me->query("neili") < 50)
                return notify_fail("你的内力不够练「泰山十八盘」。\n");
        me->receive_damage("qi", 30);
        me->add("neili",-15);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"taishan-shibapan/" + action;
}
