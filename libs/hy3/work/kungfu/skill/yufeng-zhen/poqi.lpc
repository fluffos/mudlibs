#include <ansi.h>
inherit F_SSERVER;

int perform(object me, object target) {
  int skill, neili_damage;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("金针破气只能在战斗中使用。\n");

  if (!((objectp(weapon = me->query_temp("weapon"))
    && (string)weapon->query("id") == "yufeng zhen")
    && !(objectp(weapon = me->query_temp("secondary_weapon"))
      && (string)weapon->query("id") == "yufeng zhen")))
    return notify_fail("你没用玉蜂针，不能使用金针破气绝招！\n");

  if ((int)me->query_skill("yufeng-zhen", 1) < 150)
    return notify_fail("你的玉蜂阵不够娴熟，不会使用金针破气。\n");

  if ((int)me->query_skill("yunu-xinjing", 1) < 150
    || me->query_skill_mapped("force") != "yunu-xinjing")
    return notify_fail("你的玉女心经不够娴熟，不会使用金针破气。\n");

  if ((int)me->query("neili") < 300)
    return notify_fail("你内力不够了。\n");

  skill = me->query_skill("yufeng-zhen", 1);

  me->add("neili", -150);
  message_vision(HIY "只听嗤嗤几声轻响，一道细细光芒从$N手中飞出，径自打"
    + "向$n丹田！\n" NOR, me, target);

  if (random(skill + me->query_skill("throwing", 1) / 2)
    > target->query_skill("dodge") / 3) {
    message_vision(
      RED "$N只觉得丹田气海穴一阵刺痛，全身真气狂泻而出！\n", target);
    target->receive_damage("qi", skill + random(skill), me);
    target->receive_wound("qi", skill, me);
    target->apply_condition("yufeng_poison", skill / 10
      +me->query_condition("yufeng_poison"));
    neili_damage = skill * 2 + random(skill * 2);
    if (neili_damage > target->query("neili"))
      target->set("neili", 0);
    else target->add("neili", -neili_damage);
    target->start_busy(random(skill / 60) + 1);
  } else {
    message_vision(HIY "可是$N看破了$n的企图，连忙护住丹田，"
      + "一伸手居然夹住了玉蜂针！\n", target, me);
    me->start_busy(2);
  }

  if (weapon)
    weapon->add_amount(-1);
  return 1;

  return 1;
}
