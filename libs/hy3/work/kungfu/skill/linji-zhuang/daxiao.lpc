// daxiao.c
//rewrited by xingyun

#include <ansi.h>
int exert(object me)
{
        int skill, qi;

        skill = (int)me->query_skill("linji-zhuang",1);

        if (me->query_temp("linji"))
                return notify_fail("你已经在运临济十二庄了！\n");

        if (me->query("gender") != "女性" || me->query("couple"))
                return notify_fail("你不是纯阴之体，不能运临济十二庄！\n");

        if( (int)me->query("neili") < 500)
                return notify_fail("你的内力不够运大小庄。\n");

        if( (int)me->query("jingli") < 500)
                return notify_fail("你的精力不够运大小庄。\n");
   
        if( skill < 150)
                return notify_fail("你的临济庄级别不够。\n");

        if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
                return notify_fail( "已经受伤过重，无法运功！\n");

        message_vision(
MAG"$N一声娇喝，运起“大小”二庄，真气直透九重，脸上神色\n一会变"NOR+
HIR"红"NOR+MAG"，一会变"NOR+HIC"青"NOR+MAG"，一会又变成"NOR+HIY"黄"NOR+
MAG"色，最后终于回复原来的脸色。\n只见$N脸上神采奕奕，似乎在瞬间已"+
"脱胎换骨一般。\n"NOR, me);  

        qi=skill*4+random(skill*4);
        me->add("neili",  -400);
        me->add("jingli", -400);
        me->add("eff_qi", qi);
        me->set_temp("linji/daxiao", qi);
        call_out("remove_effect",skill/2,me);
        return 1;
}

void remove_effect(object me)
{
       if(objectp(me) && me->query_temp("linji/daxiao"))
       {
       message_vision(
               HIW"$N全身真气逐渐消弥，身体渐渐恢复了正常.....\n"NOR, me );
       if(me->query("eff_qi")>me->query("max_qi"))
       me->set("eff_qi", me->query("max_qi"));
       me->delete_temp("linji");
       }
   return;     
}

