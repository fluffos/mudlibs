// fengyun.c
//rewrited by xingyun

#include <ansi.h>
int exert(object me) {
  int skill;
  int dex, def;

  skill = (int)me->query_skill("linji-zhuang", 1);

  if (me->query_temp("linji"))
    return notify_fail("你已经在运临济十二庄了！\n");

  if (me->query("gender") != "女性" || me->query("couple"))
    return notify_fail("你不是纯阴之体，不能运临济十二庄！\n");

  if ((int)me->query("neili") < 200)
    return notify_fail("你的内力不够运风云庄。\n");

  if ((int)me->query("jingli") < 100)
    return notify_fail("你的精力不够运风云庄。\n");

  if (skill < 90)
    return notify_fail("你的临济庄级别不够。\n");

  if ((int)me->query("eff_qi") < (int)me->query("max_qi") / 2)
    return notify_fail("已经受伤过重，无法运功！\n");

  message_vision(
    HIW "$N一声娇喝，运起“风云”二庄，顿时身轻如燕！\n" NOR, me);

  dex = skill / 15;
  def = skill / 2 + random(skill / 2);
  me->add_temp("apply/dexerity", dex);
  me->add_temp("apply/defense", def);
  me->set_temp("linji/fengyun", dex);
  me->set_temp("linji/def", def);
  call_out("remove_effect", skill / 2, me);
  return 1;
}
void remove_effect(object me) {
  if (objectp(me) && me->query_temp("linji/fengyun")) {
    message_vision(
      HIW "$N“风云庄”运功完毕，气运周身，凝神归一。\n" NOR, me);
    me->add_temp("apply/dexerity", -(int)me->query_temp("linji/fengyun"));
    me->add_temp("apply/defense", -(int)me->query_temp("linji/def"));
    me->delete_temp("linji");
  }
  return;
}
