#include <ansi.h>
int exert(object me)
{
        int skill;
        skill = (int)me->query_skill("linji-zhuang",1);

        if (me->query_temp("linji"))
                return notify_fail("你已经在运临济十二庄了！\n");

        if (me->query("gender") != "女性" || me->query("couple"))
                return notify_fail("你不是纯阴之体，不能运幽明庄！\n");

        if (me->query("family/family_name") != "峨嵋派")
                return notify_fail("你不是峨嵋弟子，不能运幽明庄！\n");

        if( (int)me->query_skill("linji-zhuang",1) < 180)
                return notify_fail("你的临济庄级别不够。\n");

        if( (int)me->query("eff_qi") < (int)me->query("max_qi") / 2 )
                return notify_fail( "已经受伤过重，无法运功！\n");

        if( (int)me->query("jing") < 200
         || (int)me->query("eff_jing") < 200
         || (int)me->query("jingli") < 200
         || (int)me->query("neili") < 200)
               return notify_fail( "你现在的体质修为不能运幽明庄！\n");

        message_vision(
BLU"$N双手合十，运起“幽明”二庄，$N的额头散发出阵阵阴气，渐渐罩住了
全身，$N的身影在空中若及若离，忽明忽暗，随后竟消失于无形.....\n"
NOR, me );

        me->set_temp("linji/youming", 1);
        me->add("neili",  -150);
        me->add("eff_jing",  -50 );
        me->add("jing", - 100);
        me->add("jingli", - 100);
        me->start_busy(10+random(10));
        me->set_ghost(1);
        call_out("remove_effect",skill/2,me);
        return 1;
}

void remove_effect(object me)
{
       if(objectp(me) && me->query_temp("linji/youming"))
       {
       message_vision(HIW"$N全身阴气逐渐消失，渐渐显露出身形....\n"
       NOR, me );
       me->delete_temp("linji");
       me->set_ghost(0);
       }
   return;
}



