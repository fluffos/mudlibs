// zhixin.c
// rewrited by xingyun

#include <ansi.h>

int exert(object me) {
  int skill, inte;
  skill = (int)me->query_skill("linji-zhuang", 1);

  if (me->query_temp("linji"))
    return notify_fail("你已经在运临济庄了！\n");

  if (me->query("gender") != "女性" || me->query("couple"))
    return notify_fail("你不是纯阴之体，不能运临济庄！\n");

  if (me->is_fighting())
    return notify_fail("战斗中无法运之心庄！\n");

  if ((int)me->query("jingli") < 100)
    return notify_fail("你的精力不够。\n");

  if ((int)me->query("neili") < 200)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query_skill("linji-zhuang", 1) < 60)
    return notify_fail("你的临济庄级别不够。\n");

  if ((int)me->query("eff_qi") < (int)me->query("max_qi") / 2)
    return notify_fail("已经受伤过重，无法运功！\n");

  message_vision(
    HIG "$N运起“之心”二庄，精神为之一振，两眼神采奕奕。\n" NOR, me);

  me->add("jingli", -100);
  me->add("neili", -200);
  inte = skill / 15;
  me->add_temp("apply/intelligence", inte);
  me->set_temp("linji/zhixin", inte);
  call_out("remove_effect", skill / 2, me);
  return 1;
}

void remove_effect(object me) {
  if (objectp(me) && me->query_temp("linji/zhixin")) {
    message_vision(
      HIW "$N“之心”庄运功完毕，长吁出一口气。\n" NOR, me);
    me->add_temp("apply/intelligence",
      -(int)me->query_temp("linji/zhixin"));
    me->delete_temp("linji");
  }
  return;
}
