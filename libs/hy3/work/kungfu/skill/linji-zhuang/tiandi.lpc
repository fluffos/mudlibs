// tiandi.c
// rewrited by xingyun

#include <ansi.h>

int exert(object me) {
  int skill, time;
  skill = (int)me->query_skill("linji-zhuang", 1);

  if (me->query_temp("linji"))
    return notify_fail("你已经在运临济庄了！\n");

  if (me->query("gender") != "女性" || me->query("couple"))
    return notify_fail("你不是纯阴之体，不能运临济庄！\n");

  if (me->is_fighting())
    return notify_fail("战斗中无法运天地庄！\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的真气不够。\n");

  if ((int)me->query_skill("linji-zhuang", 1) < 30)
    return notify_fail("你的临济庄级别不够。\n");

  if ((int)me->query("eff_qi") < (int)me->query("max_qi") / 2)
    return notify_fail("已经受伤过重，无法运功！\n");

  message_vision(
    MAG "$N坐了下来，五心向天，运起“天地”二庄，头顶淡紫色云雾缭绕不息...\n"
    NOR, me);

  me->add("max_jingli", random(1 + (int)skill / 30));
  me->add("neili", -100);
  me->set("jing", (int)me->query("eff_jing"));
  me->set("jingli", (int)me->query("max_jingli"));
  me->add("per", random(1 + (int)skill / 30));
  me->set_temp("linji/tiandi", 1);

  time = 12 - skill / 60;
  if (time < 0) time = 1;
  time = random(time) + 2;
  me->start_busy(time);
  if ((int)me->query("per") > 40)
    me->set("per", 40);
  call_out("remove_effect", time, me);
  return 1;
}

void remove_effect(object me) {
  if (objectp(me) && me->query_temp("linji/tiandi")) {
    message_vision(
      HIM "过了不久，$N的脸上亮出晶莹的颜色，缓缓睁开的眼里透出温润的光芒。\n"
      NOR, me);
    me->delete_temp("linji");
  }
  return;
}
