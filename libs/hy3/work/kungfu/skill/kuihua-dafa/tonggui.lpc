// gonggui.c  同归于尽

#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon;
        int skill;
        string msg;
        if( !target ) target = offensive_target(me);

        skill=(int)me->query_skill("kuihua-dafa",1);

        if( !target
        ||  !target->is_character()
        ||  !me->is_fighting(target) )
           return notify_fail("同归于尽只能对战斗中的对手使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
           || (string)weapon->query("skill_type") != "sword")
           return notify_fail("你使用的武器不对。\n");

        if( (int)me->query("neili") < 500  ) 
           return notify_fail("你的内力不够。\n");

        if( (int)me->query_skill("kuihua-dafa", 1) < 150 )
           return notify_fail("你的葵花大法不够娴熟，不会使用「同归于尽」。\n");

        if((int)me->query("max_qi")*3/5<(int)me->query("eff_qi"))
           return notify_fail("你还没受重伤，不要使用葵花大法。\n");

        msg=HIR"$N厉声尖叫到：“日出东方，唯我独尊！教主神功，天下无敌！”\n"
           +"话音未落，$N如发疯似地朝$n冲去，手中绣花针直刺$n咽喉！\n"HIR;

        if(random(me->query_con())>target->query_con()/4)
        {
        msg+=HIR"$n只觉得眼前一花，一股血箭从咽喉喷涌而出，全身经脉尽断...\n"NOR;
        target->receive_wound("qi", skill*4+random(skill*5),me);
        target->receive_damage("qi",skill*3+random(skill*4),me);     
        target->add("neili",-(skill*2+random(skill*2)));
        COMBAT_D->report_status(target);
        } else
        {
        msg+=HIY"$n一看大势不好，仓促间连退十余步，总算躲过了$N致命一击！\n"NOR;
        target->start_busy(2);
        }
        message_vision(msg,me,target);
        target->kill_ob(me);

        me->receive_damage("qi",skill+random(skill),me);
        me->receive_wound("qi", skill+random(skill),me);
        me->set("neili",0);
        me->start_busy(4);
        COMBAT_D->report_status(target);

        return 1;
}

