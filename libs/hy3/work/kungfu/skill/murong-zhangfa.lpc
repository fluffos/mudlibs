// murong-zhangfa.c 
// Gallop 99/04/27

inherit SKILL;

mapping *action = ({
([      "action" : "$N使一式般若掌之[37m「云断[1;32m秦岭[37m」[0m，右掌上引，左掌由后而上一个甩劈，斩向$n的$l",
        "damage": 40,
        "damage_type" : "瘀伤"
]),
([      "action" : "$N两掌一分，一式寒冰绵掌中的[1;30m「曾经[1;36m沧海」[0m，隐隐发出潮声，向$n横击过去",
        "damage": 40,
        "damage_type" : "瘀伤"
]),
([      "action" : "$N突地使出混元掌中[1;37m「[1;33m金[1;37m玉[1;31m满堂[1;37m」[0m一式，双掌挟着一阵风雷之势，猛地劈往$n的$l",
        "damage": 55,
        "damage_type" : "瘀伤"
]),
([      "action" : "$N双掌平挥，一招天山六阳掌的[1;35m「云霞[1;37m出[1;34m海曙」[0m击向$n",
        "damage" : 50,
        "damage_type" : "瘀伤"
]),
([      "action": "$N双掌平平提到胸前，神色沉重的缓缓使出降龙十八掌之[1;33m「亢龙[1;35m有悔」[0m推向$n的$l",
        "damage": 55,
        "damage_type": "瘀伤"
]),
([      "action": "$N将毒质运至右手，一招星宿毒掌中[34m「腐尸毒」[0m一招，阴毒无比地推向$n的$l",
        "damage": 40,
        "poison": 100,
        "damage_type": "瘀伤"
]),
([      "action" : "$N双掌血红，一式散花掌的[1;37m「冬卧[1;33m听[1;35m梅吟」[0m，幻成漫天梅花朵朵，雨点般向$n击去",
        "damage": 40,
        "damage_type" : "瘀伤"
])
});

int valid_enable(string usage) { return (usage == "strike") || (usage == "parry"); }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 100)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("xiaowuxiang", 1) < 20)
                return notify_fail("你的小无相神功火候太浅。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        object weapon;

        if ((int)me->query("qi") < 35)
                return notify_fail("你的体力不够练慕容掌法。\n");
        if ((int)me->query("neili") < 15)
                return notify_fail("你的内力不够练慕容掌法。\n");
        me->receive_damage("qi", 30);
        me->add("neili",-10);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"murong-zhangfa/" + action;
}
