// qijian.c  七剑下天山

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
        string msg;
        int i;

        if( !target ) target = offensive_target(me);  
        if( !target || !me->is_fighting(target) )
                return notify_fail("「七剑下天山」只能在战斗中使用。\n");
 
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("没有剑如何使用「七剑下天山」\n");

        if( (int)me->query("neili") < 200 )
                return notify_fail("你的真气不够！\n");
        if( (int)me->query("jing") < 200 )
                return notify_fail("你的精不够！\n");

        if( (int)me->query_skill("honghua-shengong",1) < 180 ||
             me->query_skill_mapped("force") != "honghua-shengong" )
        return notify_fail("你的红花神功修为不够。\n");

        if( (int)me->query_skill("sword") < 180 ||
            me->query_skill_mapped("sword") != "luohua-jian")
                return notify_fail("你的红花十三剑法还不到家，无法使用「七剑下天山」！\n");

        msg = HIW "$N凌神运气，蓦然使出「七剑下天山」，无形剑气破空袭向$n！\n" NOR;
        message_vision(msg, me,target);

        for( i=0; i < 7; i++ )
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        me->add("neili", -100);
        me->add("jing", -50);
        me->start_busy(2+random(2));

        return 1;
}
