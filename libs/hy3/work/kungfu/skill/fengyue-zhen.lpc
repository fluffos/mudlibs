// fengyue-zhen.c
//风月剑阵
#include <ansi.h>

inherit SKILL;

int valid_enable(string usage) { return usage == "array"; }

int form_array(object leader) {
  object *member, ob;
  int i, j, n;

  member = leader->query_team();
  if (sizeof(member) != 2)
    return notify_fail("风月剑阵共需两人，才可功防互补。\n");
  //      zjun
  j = sizeof(member);
  for (i = 0; i < j; i++) {
    ob = member[i];
    if (!ob || !living(ob) || !ob->is_character()) {
      return notify_fail("你想和谁组成剑阵?\n");
    }
    if (ob->query_temp("array/name")) {
      return notify_fail("已经组成剑阵了\n");
    }
    if (environment(leader) != environment(ob)) {
      return notify_fail("人数不够两人\n");
    }
  }
  n = leader->query_skill("spider-array", 1);
  for (i = 0; i < j; i++) {
    ob = member[i];
    ob->set_temp("array/name", "spider-array");
    ob->set_temp("array/level", n);
    ob->add_temp("apply/attack", n);
    //		if (!(ob->query_temp("apply/damage")))
    //		{
    //			ob->set_temp("apply/damage",n/5);
    //		} else {
    ob->add_temp("apply/damage", n);
    //		}
    ob->add_temp("apply/defense", n);
  }
  message_vision(HIG "$N和$n组成了「风月剑阵」！\n" NOR, leader);
  return 1;
}

//      zjun
int dismiss_array(object person) {
  int i, j, n;
  object *member, ob;

  member = person->query_team();
  j = sizeof(member);
  n = person->query_temp("array/level");
  for (i = 0; i < j; i++) {
    ob = member[i];
    ob->delete_temp("array/name");
    ob->delete_temp("array/level");
    ob->add_temp("apply/attack", -n);
    ob->add_temp("apply/damage", -n);
    ob->add_temp("apply/defense", -n);
    tell_object(ob, "剑阵解散了\n");
  }
}

int effective_level() { return 10; }

int learn_bonus() {
  return 0;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
