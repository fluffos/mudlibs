// jingsng.c 金刚拳 大金刚神通

#include <ansi.h>
inherit F_SSERVER;

void remove_effect(object me, int aamount, int damount);

int perform(object me, object target)
{
        int damage;     
        string msg;
        
        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
            || !me->is_fighting(target) )

        return notify_fail("「大金刚神通」只能在战斗中使用。\n");

        if( (int)me->query("neili") < 800 )
                return notify_fail("你的内力不够！\n");

        if( (int)me->query_skill("jingang-quan", 1) < 150)
                return notify_fail("你大金刚拳的修为不够，不能使用大金刚神通! \n");                

        if( (int)me->query_skill("hunyuan-yiqi", 1) < 150)
                return notify_fail("你的混元一气功的修为不够，不能使用大金刚神通! \n");

        if( (int)me->query_skill("cuff") < 150 )
                return notify_fail("你的拳法还不到家，无法使用大金刚神通！\n");
        
        if(me->query_temp("weapon"))
                return notify_fail("你不能使用武器！\n");

        if( me->query_skill_mapped("cuff") != "jingang-quan") 
                return notify_fail("你没有激发金刚拳，无法使用大金刚神通！\n");
        
        
        msg = HIR"$N使出大金刚拳的绝技「大金刚神通」，双拳一晃，猛地朝$n双耳击去！\n" NOR;
        
        damage=(int)me->query_skill("jingang-quan",1)*2+(int)me->query_skill("hunyuan-yiqi",1);
        damage=damage+random(damage/2);
        me->add("neili", -damage/2);
        
        if(random(me->query_str())>target->query_con()/3)
        {
        msg += HIR"$n只觉双耳嗡的一声巨响，犹如雷鸣一般，不禁哇地喷出一口鲜血！\n"NOR;
        target->receive_damage("qi", damage);
        target->receive_wound("qi", damage/2);
        me->start_busy(2);
        } else
        {
        msg += HIY"$n慌忙之中，连忙腾出双手，运气硬接$N的这记重拳，四拳相交，砰发出一声巨响！\n"NOR;
        me->start_busy(1+random(3));
        target->start_busy(1+random(3));
        }
    message_vision(msg, me, target);
     target->kill_ob(me);
     return 1;
}
        


