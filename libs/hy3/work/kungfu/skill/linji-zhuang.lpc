// linji-zhuang.c 峨嵋 临济十二庄
// create bye cuer
// modified by xingyun

inherit FORCE;
int valid_enable(string usage) {
  return usage == "force";
}
int valid_learn(object me) {
  int i, nf, ns, level;

  nf = (int)me->query_skill("force", 1);
  ns = (int)me->query("PKS");
  level = (int)me->query_skill("linji-zhuang", 1);


  if (me->query("gender") != "女性"
    || me->query("couple"))
    return notify_fail(
      "你非处女纯阴之体，不能修习临济十二庄。\n");

  if (nf < 20)
    return notify_fail(
      "你的基本内功火候还不够，无法领会临济十二庄。\n");

  if (level > 120 && (level + ns * 20) > 200)
    return notify_fail(
      "你的杀心过重，为师也只能教你这么多了，望好自为之。\n");

  if (me->query_skill("beiming-shengong", 1)
    || me->query_skill("jiuyang-shengong", 1)
    || me->query_skill("taiji-shengong", 1)
    || me->query_skill("wuji-shengong", 1)
    || me->query_skill("bibo-shengong", 1)
    || me->query_skill("hamagong", 1)
    || me->query_skill("huntian-qigong", 1)
    || me->query_skill("huagong-dafa", 1)
    || me->query_skill("guiyuan-dafa", 1)
    || me->query_skill("hunyuan-yiqi", 1)
    || me->query_skill("bahuang-gong", 1)
    || me->query_skill("xuantian-wuji", 1)
    || me->query_skill("shenhuo-shengong", 1)
    || me->query_skill("kurong-changong", 1)
    || me->query_skill("tiangang-zhengqi", 1))
    return notify_fail(
      "你不散了别派的内功，如何学我峨嵋的心法？\n");

  return 1;
}
int practice_skill(object me) {
  return notify_fail(
    "临济十二庄只能用学(learn)和在雷动坪修炼(shout)来增加熟练度。\n");
}
string exert_function_file(string func) {
  return __DIR__ "linji-zhuang/" + func;
}
