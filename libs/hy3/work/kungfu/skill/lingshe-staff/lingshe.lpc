//sanjue.c 
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg,msg1;
        int i;
         object weapon, weapon2;
        if( !target ) target = offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("「灵蛇三式」只能在战斗中对对手使用。\n");
        weapon = me->query_temp("weapon");
        if (!weapon || weapon->query("skill_type") != "staff"
           || me->query_skill_mapped("sword") != "lingshe-staff")
                return notify_fail("你必须使用铁杖才能使出「灵蛇三式」！\n");

        if( (int)me->query_skill("lingshe-staff", 1) < 80 )
                return notify_fail("你的灵蛇杖法不够娴熟，不会使用「灵蛇三式」。\n");

        if( (int)me->query_skill("hamagong", 1) < 60 )
                return notify_fail("你的蛤蟆功修为不够，不能使用「灵蛇三式」。\n");

        if( (int)me->query_dex() < 30 )
                return notify_fail("你的身法太低，不能使用「灵蛇三式」。\n");

        if (me->query_skill_mapped("force") != "hamagong")
                return notify_fail("你的内功等级不够，不能使用「灵蛇三式」。\n");

        if( (int)me->query("neili", 1) < 400 )
                return notify_fail("你现在内力太弱，不能使用「灵蛇三式」。\n");
        if((int)me->query("jingli",1)<200)
               return notify_fail("你现在精力太少，不能使用「灵蛇三式」。\n");
        i = (me->query_skill("lingshe-staff", 1)/10);
        msg = RED "$N双手挥舞蛇杖，但见两条碧鳞毒蟒蛇芯吞吐直奔$n面门。\n"NOR;
        msg1=HIY"$N一声长啸，身法渐渐缓慢下来。\n"NOR;
        me->add_temp("apply/strength", i);
        me->add_temp("apply/attack", i); 
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        me->add("neili", -200);
        me->start_busy(3);
        me->add_temp("apply/strength",-i);
        me->add_temp("apply/attack", -i); 
        
        if (!objectp(weapon2 = target->query_temp("weapon")))
            if ( random(me->query("str")) > (int)target->query("str") && me->query("combat_exp") > (int)target->query("combat_exp")/4*3 )
                  {
                        msg = HIY"$n一见碧鳞毒蟒巨牙狰狞，慌不达将手中";
                        msg += weapon2->name();
                        msg += "急急甩手丢了出去！\n" NOR;
                        me->add("neili", -150);
                        target->start_busy(2);
                        weapon2->move(environment(me));
                }

        else    {
                        me->add("neili",-50);
                        msg = HIY"可是$n看出了$N的企图，立刻手上加劲，将
" + weapon2->name() + "直点蛇头七寸，\n双方兵刃的碰在一起,“铛”的发出一声巨响\n"NOR;
                        me->start_busy(2);
                }
        message_vision(msg1, me,target);        
      return 1;
      
}
