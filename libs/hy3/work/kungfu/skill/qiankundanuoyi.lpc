int valid_learn(object me) {
  return notify_fail("乾坤大挪移只能通过读<<乾坤大挪移>>心法提高。\n");
}

int practice_skill(object me) {
  return notify_fail("乾坤大挪移只能通过读<<乾坤大挪移>>心法提高。\n");
}

string perform_function_file(string func) {
  return __DIR__ "qiankundanuoyi/" + func;
}

int is_reinpose(object me, object target) {
  if ((string)me->query("family/family_name") == "明教"
    && me->query_skill("qiankundanuoyi", 1) > 100
    && me->query_skill_mapped("force") == "jiuyang-force"
    && me->query_skill("jiuyang-force", 1) > 100
    && (int)me->query("max_neili") >= 1000
    && (int)me->query("neili") >= 500
    && me->query("combat_exp") / 3 > random(target->query("combat_exp") / 2))
    return 1;
  else
    return 0;
}

int reinpose(object me, object target, int damage) {
  int skill1, dam, ratio, skill2, rate;
  object *env = all_inventory(environment(me)), obj;
  obj = env[random(sizeof(env))];

  skill1 = (int)me->query_skill("qiankundanuoyi", 1);
  skill2 = (int)target->query_skill("force");

  ratio = skill1 + skill1 * 200 / skill2;
  rate = ratio / 100;
  if (rate < 1) rate = 1;
  rate = random(rate);
  if (rate > 10) rate = 10;
  if (rate < 2) {
    message_vision(
      HIG "$N暗运乾坤大挪移第二重心法，脸上忽" NOR + HIC "青" NOR + HIG "忽" NOR + HIR "红" NOR
      +HIG "，左牵右挪，顿使$n的攻势大为锐减！\n" NOR, me, target);

    damage = damage * 4 / 5 / (1 + rate);
    return damage;
  } else if (rate < 5 && living(obj) && obj != me && obj->query("id") != "gongping zi") {
    message_vision(
      BLU "$N暗运乾坤大挪移第四重心法，脸上忽" NOR + HIR "红" NOR + BLU "忽" NOR + MAG "紫" NOR
      +BLU "，竟将$n的攻击牵引到" + obj->query("name") + "身上！\n" NOR, me, target);

    obj->receive_damage("qi", damage, me);

    if (damage > (int)obj->query_temp("apply/armor"))
      obj->receive_wound("qi",
        damage - (int)obj->query_temp("apply/armor"), me);
    COMBAT_D->report_status(target, random(2));

    if (userp(me))
      obj->kill_ob(me);
    return 10;
  } else {
    message_vision(
      MAG "$N暗运乾坤大挪移第七重心法，脸上红、紫之色尽退，" NOR
      +MAG "竟将$n的攻击尽数返回到$n身上！\n" NOR, me, target);
    damage = damage * (100 + random(rate * 5)) / 100;
    target->receive_damage("qi", damage, me);

    if (damage > (int)target->query_temp("apply/armor"))
      target->receive_wound("qi",
        damage - (int)target->query_temp("apply/armor"), me);
    COMBAT_D->report_status(target, random(2));

    return 0;
  }
}
