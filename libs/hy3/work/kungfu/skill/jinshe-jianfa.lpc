int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

int valid_learn(object me) {
  return notify_fail("金蛇剑法只能通过读金蛇秘籍和练习来提高！\n");
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("jinshe-jianfa", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword"
    || weapon->query("id_id") != "jinshe jian")
    return notify_fail("没有金蛇剑，如何练习金蛇剑法？\n");

  if (me->query_skill("jinshe-jianfa", 1) < 120)
    return notify_fail("你的金蛇剑法造诣太浅，无法自行练习。\n");

  if ((int)me->query("qi") < 500)
    return notify_fail("你的体力不够，练不了金蛇剑法。\n");

  if ((int)me->query("neili") < 600)
    return notify_fail("以你现在的内力，无法练习如此深奥的剑法。\n");

  me->receive_damage("qi", 100);
  me->add("neili", -80);

  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  object weapon;
  if (objectp(weapon = me->query_temp("weapon"))
    && weapon->query("id_id") == "jinshe jian"
    && me->query_skill_mapped("sword") == "jinshe-jianfa")

    return damage_bonus;
}

string perform_action_file(string action) {
  return __DIR__ "jinshe-jianfa/" + action;
}
