int valid_enable(string usage)
{
        return (usage == "sword") || (usage == "parry");
}

int valid_learn(object me)
{
        mapping my_fam  = me->query("family");

        if( !my_fam || (string)my_fam["master_id"] !="feng qingyang")  
                return notify_fail("你不是风清扬的弟子，不能学习「独孤九剑」。\n");

        if ((int)me->query("max_neili") < 1000)
                return notify_fail("你的内力不够。\n");

        if ((int)me->query_skill("dugu-jiujian",1) > 180)
                return notify_fail("这套剑法我就教到这儿，以后就要靠你自己练了。\n");

        return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

string query_parry_msg(string limb)
{
        return parry_msg[random(sizeof(parry_msg))];
}

int practice_skill(object me)
{
        return notify_fail("独孤九剑只能通过[1;31m「总诀式」[0m来演练。\n");
}

string perform_action_file(string action)
{
        return __DIR__"dugu-jiujian/" + action;
}
