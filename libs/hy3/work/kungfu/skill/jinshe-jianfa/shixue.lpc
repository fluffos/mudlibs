//  金蛇噬血
//write by xingyun
#include <ansi.h>
inherit F_SSERVER;

int perform(object me, object target)
{
        object weapon;
        int damage;
        string msg;

        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
            || !me->is_fighting(target) )
        return notify_fail("「金蛇噬血」只能对战斗中的对手使用。\n");

        if( (int)me->query_skill("jinshe-jianfa", 1) < 120 )
        return notify_fail("你的金蛇剑法不够娴熟，不会使用「金蛇噬血」。\n");

        if( (int)me->query("neili") < 500 )
        return notify_fail("你现在内力太弱，不能使出「金蛇噬血」。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
           || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");

        msg=HIY"忽然$N手中"NOR+weapon->query("name")+HIY"金光大盛，"
            +"犹如千万条金蛇，向$n扑噬而来。\n$n顿时觉得四面八方都是$N"
            +"浮动的诡异身影......\n"NOR;

       if(random(me->query_skill("jinshe-jianfa",1)) >
                                 target->query_skill("dodge",1)/3)
       {     
        msg += HIR"$n心中大骇，顷刻间被噬得遍体鳞伤，浑身是血！\n"NOR;
        damage = me->query_skill("sword",1)/2;
        damage = me->query_skill("jinshe-jianfa",1);
        damage = damage + random(damage*2);
        if(weapon->query("id_id")=="jinshe jian")
        damage = damage*2;
        target->receive_damage("qi", damage/3,me);
        target->receive_wound("qi", damage/2,me);
        me->start_busy(1);    
        } else
        {
         msg += HIY"$n心中大骇，慌忙间连退十余步，总算逃过了噬血之苦！\n"NOR;
         me->start_busy(2);
        }
        message_vision(msg,me,target);
        me->add("neili",-damage/3);
        target->kill_ob(me);
        return 1;
}

