int valid_enable(string usage) { return usage == "claw" || usage == "parry"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练展爪功必须空手。\n");
  //	if ((int)me->query_skill("wangluo-jue", 1) < 25)
  //		return notify_fail("你的网络诀火候不够，无法学展爪功。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法学展爪功。\n");
  if ((int)me->query("str") < 24)
    return notify_fail("你的臂力太差，无法学展爪功。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object ob, object weapon) {
  int i, level;
  level = (int)ob->query_skill("zhanzhuagong", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练展爪功。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "zhanzhuagong/" + action;
}
