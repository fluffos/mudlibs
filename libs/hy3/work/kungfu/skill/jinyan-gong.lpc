// jinyan-gong.c 金燕功

inherit SKILL;

string *dodge_msg = ({
        "但是$n身形飘忽，一招[37m「穿云势」[0m拔地而起，举重若轻的避开这一击。\n",
        "$n身随意转，一式[37m「破雾势」[0m，全身化作无数虚影掠出丈外。\n",
        "$n身形往上一拔，一招[36m「开天势」[0m，腾空而起，避了开去。\n", 
        "$n气聚丹田，一招[32m「劈地势」[0m，身形急缩，躲开$N那致命一击。\n", 
        "$n身形往上一拔，一招[36m「推山势」[0m落在数尺之外。\n",
        "$n身形晃动，一招[34m「搅海势」[0m，全身化作无数虚影掠出丈外。\n",
        "$n真气荡漾，如雷霆般大喝一声，一招[33m「雷针势」[0m，身形极速后退。\n",
        "$n使出[35m「电箭势」[0m，身形如电般地躲开了$N这一招。\n",
        "$n身影微动，已经藉一招[31m「龙腾势」[0m轻轻闪过。\n",
        "$n腾空一跃，双脚向前一踢，一招[0;5;31m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m，躲开数尺。\n",
        "只见$n身影一晃，一式[0;5;31m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m早已避在七尺之外。\n",
        "可是$n使一招[30m「鹰飞势」[0m，身子轻轻飘了开去，早已绕到$N身後！\n",
});

int valid_enable(string usage)
{
        return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 40 )
                return notify_fail("你的体力太差了，不能练金燕功。\n");
        if (me->query_skill("jinyan-gong", 1) < 30)
                me->receive_damage("qi", 20);
        else if (me->query_skill("jinyan-gong", 1) < 60)
                me->receive_damage("qi", 40);
        else
                me->receive_damage("qi", 60);
        return 1;
}


