#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;
  if (!target) target = offensive_target(me);
  if (environment(me)->query("no_fight")) return notify_fail("凝血神抓只能在战斗中使用。\n");
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("凝血神抓只能对战斗中的对手使用。\n");
  if (me->query("family/family_name") != "云龙门") return notify_fail("凝血神抓只有云龙门弟子可以使用。\n");
  if ((int)me->query("neili") < 200)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query_skill("yunlong-zhua", 1) < 100)
    return notify_fail("你的云龙爪不够娴熟，不能使用凝血神爪。\n");
  msg = HIB "$N一声长笑，右手疾抓。$n猛感左足踝上陡紧，犹如铁箍一般箍住。紧跟着$N右手甩出，将$n往地下掷去。\n";
  me->start_busy(2);
  if (random((int)me->query_skill("yunlong-zhua", 1) * 2)
    > random(target->query_skill("dodge"))) {
    msg += HIB " 结果一声惨叫，$p被$N摔的" + HIR "血肉模糊！\n" NOR;
    damage = (int)me->query_skill("yunlong-xinfa", 1);
    damage = damage + (int)me->query_skill("yunlong-shengong", 1);
    damage = damage + (int)me->query_skill("yunlong-zhua", 1);
    damage = damage / 2 + random(damage);
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    target->apply_condition(
      "zhua_poison",
      random(me->query_skill("yunlong-zhua", 1) / 5) + 1 + target->query_condition("zhua_poison")
    );
    target->start_busy(random(2));
    me->add("neili", -damage / 4);
  } else {
    msg += HIM "$p臀部着地，身子却如在水面滑行，在地上直溜了出去，溜出数丈，腰一挺，靠墙站起。\n" NOR;
    me->start_busy(random(4));
  }
  message_vision(msg, me, target);
  return 1;
}
