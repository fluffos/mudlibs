#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([
    "action": "$N轻身而退，一招" HIM "『玉蜂飞影』" NOR "，手中$w化作一点寒芒射向$n",
    "damage": 50,
    "force": 120,
    "dodge": 40,
    "damage_type": "刺伤",
    "lvl": 0,
    "skill_name": "玉蜂飞影"
  ]),
  ([
    "action": "$N右手微向前一伸，使出" HIY "『群蜂戏舞』" NOR "，手里$w径直射向$n的双眼",
    "damage": 80,
    "force": 150,
    "dodge": 45,
    "damage_type": "刺伤",
    "lvl": 20,
    "skill_name": "群蜂戏舞"
  ]),
  ([
    "action": "$N一声轻啸，施展出" HIB "『穿花戏蝶』" NOR "，身形微动，手中$w竟然向上飞
起绕了个圈，随而迅速袭向$n的腰间",
    "damage": 120,
    "force": 180,
    "dodge": 50,
    "damage_type": "刺伤",
    "lvl": 40,
    "skill_name": "穿花戏蝶"
  ]),
  ([
    "action": "$N使一招" HIW "『锋芒毕现』" NOR "，突然纵身向后一个翻滚，就在快落地的
一瞬间，$n陡然发现几点寒光闪烁不定地袭向自己",
    "damage": 150,
    "force": 210,
    "dodge": 55,
    "damage_type": "扎伤",
    "lvl": 60,
    "skill_name": "锋芒毕现"
  ]),
  ([
    "action": "$N右手一挥，一招" MAG "『寻觅无音』" NOR "，$n明明看见$N手里的$w已射向
自己的胸前大穴，到了近处却突然转攻向自己的后心",
    "damage": 180,
    "force": 240,
    "dodge": 60,
    "damage_type": "刺伤",
    "lvl": 80,
    "skill_name": "寻觅无音"
  ])
});

int valid_enable(string usage) {
  return (usage == "throwing") || (usage == "parry");
}

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 400)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("yunu-xinjing", 1) < 120)
    return notify_fail("你的玉女心经火候太浅。\n");
  if ((int)me->query_skill("throwing", 1) < 100)
    return notify_fail("你的基本暗器火候太浅。\n");
  return 1;

}


string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("yufeng-zhen", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "throwing" || weapon->query("id") != "yufeng zhen")
    return notify_fail("你使用的武器不是玉蜂针。\n");
  if ((int)me->query_skill("yunu-xinjing", 1) < 120
    || me->query_skill_mapped("force") != "yunu-xinjing")
    return notify_fail("你的玉女心经火候太浅。\n");
  if ((int)me->query("qi") < 200)
    return notify_fail("你的体力不够，练不了玉蜂针。\n");
  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力不够，练不了玉蜂针。\n");
  me->receive_damage("qi", 100);
  me->add("neili", -100);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yufeng-zhen/" + action;
}
