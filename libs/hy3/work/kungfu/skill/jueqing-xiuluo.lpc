// jueqing-xiuluo.c 绝情修罗剑
// 99-9-11 13:53

inherit SKILL;

mapping *action = ({
  ([ "action": "$N一式「长恨绵绵」，纵身飘开数尺，运发剑气，手中$w遥摇指向$n的$l",
    "force": 150,
    "dodge": -5,
    "damage": 30,
    "lvl": 15,
    "skill_name": "长恨绵绵",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N纵身轻轻跃起，一式「碧血三溅」，剑光三点，直击$n的三处大穴",
    "force": 170,
    "dodge": 15,
    "damage": 35,
    "lvl": 25,
    "skill_name": "碧血三溅",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w中宫直进，一式「上下幽明」，连绵攻向$n的头部和腿部",
    "force": 220,
    "dodge": 15,
    "damage": 40,
    "lvl": 35,
    "skill_name": "上下幽明",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w上下连划，剑芒吞吐，一式「十殿轮回」，划向$n的$l",
    "force": 280,
    "dodge": 5,
    "damage": 50,
    "lvl": 40,
    "skill_name": "十殿轮回",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N双手合抱，手中$w逼出丈许雪亮剑芒，一式「魂归极乐」刺向$n的$l",
    "force": 350,
    "dodge": 5,
    "damage": 60,
    "lvl": 55,
    "skill_name": "魂归极乐",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N剑交左手，一式「永别修罗」，剑尖划出无数圆圈，隐隐夹带风雷之声攻向$n",
    "force": 400,
    "dodge": 5,
    "damage": 90,
    "lvl": 60,
    "skill_name": "永别修罗",
    "damage_type": "刺伤"
  ]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("mingyu-gong", 1) < 20)
    return notify_fail("你的明玉功修为还太浅。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("jueqing-xiuluo", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你得装备一把剑才对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够了，不能练绝情修罗剑。\n");
  me->receive_damage("qi", 25);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "jueqing-xiuluo/" + action;
}
