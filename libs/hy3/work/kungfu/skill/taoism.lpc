// taoism.c

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me) {
  int lvl;

  lvl = (int)me->query_skill("taoism", 1);

  if ((int)me->query("shen") < 0)
    return notify_fail("你的邪气太重，无法修炼道学心法。\n");

  if (me->query("gender") == "无性" && lvl > 39)
    return notify_fail("你刚听一会儿，便觉心智迷糊，原来你没有阳刚之气，无法领会里面的阴阳变化之道。\n");

  //changed by xingyun,统一法术派别

  if ((int)me->query_skill("magic", 1))
    return notify_fail("哈哈！" + RANK_D->query_respect(me)
      + "既已钻研俗家修身养性之道，还学这个做甚？\n");

  if ((int)me->query_skill("buddhism", 1))
    return notify_fail("哈哈！" + RANK_D->query_respect(me)
      + "既已钻研禅宗心法，还学这个做甚？\n");

  if (me->query("class") != "taoist")
    return notify_fail("哈哈！" + RANK_D->query_respect(me)
      + "不是道士，怎么却来学道家心法？\n");

  return 1;
}

int practice_skill(object me) {
  return notify_fail("道学心法只能靠学习来提高。\n");
}
