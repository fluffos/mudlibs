//han.c （喊）
#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target)
{
        object *ob;
        int i, skill, damage;

        if( (int)me->query("neili") < 300 )
                return notify_fail("你的内力不够。\n");

        if( environment(me)->query("no_fight") )
                return notify_fail("在这里不能攻击他人。\n");

        skill = me->query_skill("force");

        me->add("neili", -150);
        me->receive_damage("qi", 10);

        me->start_busy(5);
        message_vision(
                HIY "$N气沉丹田，运足真力，喊了一声：“震风武馆！威名远洋！”\n" NOR, me);

        ob = all_inventory(environment(me));
        for(i=0; i<sizeof(ob); i++) {
                if( !living(ob[i]) || ob[i]->query("is_quest") || ob[i]==me ) continue;
                if( skill/2 + random(skill/2) < (int)ob[i]->query("con") * 2 ) continue;
                
                damage = (skill -(int)ob[i]->query("max_neili") / 20) / 50;
                if( damage > 0 ) {
                        ob[i]->start_busy(damage);
                        tell_object(ob[i], "你听的他竟是当年名扬四海的“震风武馆”中人，心头不禁一乱！\n");
                }
                
                if( userp(ob[i]) ) ob[i]->fight_ob(me);
                else if( !ob[i]->is_killing(me) ) ob[i]->kill_ob(me);
        }
        me->start_busy(2+random(2));
        return 1;
}
