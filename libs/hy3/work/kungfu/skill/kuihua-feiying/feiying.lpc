#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「葵花飞影」只能对战斗中的对手使用。\n");

  if (objectp(weapon = me->query_temp("weapon"))
    && (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_skill("kuihua-feiying", 1) < 150)
    return notify_fail("你的葵花飞影术不够娴熟，不能用葵花神掌。\n");

  if ((int)me->query_skill("kuihua-xinfa", 1) < 160)
    return notify_fail("你的葵花心法不够娴熟，不能使用葵花神掌。\n");

  if (me->query_skill_prepared("finger") != "pixie-jian"
    || me->query_skill_mapped("sword") != "pixie-jian")
    return notify_fail("你还未准备辟邪剑法，无法使用葵花飞影绝技。\n");

  extra = (me->query_skill("kuihua-feiying", 1) +
    me->query_skill("kuihua-xinfa", 1)) / 100;

  if (extra > 10) extra = 10;

  me->add_temp("apply/attack", extra * 20);
  msg = HIR "$N运起［葵花心法］，眨眼间身行陡然加快，围绕着$n四下转动起来！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg += HIY "$N的人影变成了几个，．．．．\n" NOR;
  message_vision(msg, me, target);
  for (i = 0; i < extra; i++) {
    msg = BLINK + HIW "忽然，在$n的身旁出现一个人影，向$n攻了过去！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  }
  me->add("neili", -extra * 50);
  me->add_temp("apply/attack", -extra * 20);
  me->start_busy(4);
  return 1;
}
