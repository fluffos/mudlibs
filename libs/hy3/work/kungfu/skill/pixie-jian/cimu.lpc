// cimu.c辟邪剑法——刺目
//writed by xingyun

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int skill, damage, pow;

  skill = (int)me->query_skill("pixie-jian", 1);

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("刺目只能对战斗中的对手使用。\n");

  if ((string)me->query("gender") != "无性")
    return notify_fail("嘻嘻，你好象不是公公吧。\n");

  if (skill < 90)
    return notify_fail("你辟邪剑法不太熟练，不能使出「刺目」一式。\n");

  if ((int)me->query_skill("sword", 1) < 90)
    return notify_fail("你基本剑法不太熟练，不能使出「刺目」一式。\n");

  if ((int)me->query("neili") < 300)
    return notify_fail("你的内力不够，不能使出「刺目」一式。\n");

  if (target->query_temp("pixie/cimu"))
    return notify_fail("对方已经看不见了，加紧攻击吧。\n");


  msg = HIC "$N突然剑尖暴长，揉身而上，使出辟邪剑法「刺目」诀，身法\n" +
    "形同鬼魅，直刺$n双眼.....\n";

  if (random(skill) > (int)target->query_skill("dodge") / 2
    || random(me->query("combat_exp")) > target->query("combat_exp") / 2) {
    me->start_busy(random(2) + 1);
    msg += HIR "$p猝不及防，被$P刺个正着，双手掩面，痛极而呼！！\n" NOR;
    target->start_busy(3);
    damage = skill + random(skill / 2);

    target->receive_damage("qi", damage / 4, me);
    target->receive_wound("qi", damage / 2, me);
    pow = damage / 3;
    target->add_temp("apply/defense", -2 * pow);
    target->add_temp("apply/attack", -pow);
    target->set_temp("pixie/cimu", pow);
    message_vision(msg, me, target);
    tell_object(target,
      HIR "你只觉得双眼一阵刺痛，就什么也看不见了....\n" NOR);
    target->set_temp("block_msg/all", 1);
    call_out("remove_cimu", skill / 20, target);
  } else {
    msg += HIW "$p情急之中，也一剑朝被$P双眼刺去，险险化开了这招！！\n" NOR;
    message_vision(msg, me, target);
    me->star_busy(3);
  }
  me->add("neili", -damage / 3);
  return 1;
}

void remove_cimu(object ob) {
  int pow;

  if (objectp(ob) && ob->query_temp("pixie/cimu")) {
    pow = (int)ob->query_temp("pixie/cimu");
    ob->add_temp("apply/defense", 2 * pow);
    ob->add_temp("apply/attack", pow);

    ob->delete_temp("pixie");
    ob->delete_temp("block_msg/all");
    message_vision(HIR "$N抹掉了脸上的鲜血，终于能看见了。\n" NOR, ob);
  }
  return;
}
