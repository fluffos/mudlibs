#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([
    "action": "$N右手$w慢慢指出，突然间在空中一颤，发出嗡嗡之声，跟着便是
嗡嗡两剑，手中$w剑光暴长，向$n的$l刺去",
    "dodge": 50,
    "damage": 170,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N哟右手剑换到左手,右手出掌,左手舞剑,一阵剑光闪耀.无比的剑
        气直冲$n而去.",
    "dodge": 100,
    "damage": 200,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N右手握剑,直刺向$n.$n向左躲去,$N顺势横辟一剑," HIM "一道紫光闪过
        " NOR "$n" HIM "一时来不及躲闪." NOR,
    "dodge": 300,
    "damage": 350,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N直握剑,连刺$n的$s数十下.",
    "dodge": 50,
    "damage": 170,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;
  //   if( (string)me->query("gender") != "女性" )
  //   return notify_fail("九阴赤炼剑法是只有女子才能练的武功。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力不够，没有办法练燕荡剑法。\n");
  if ((string)me->query_skill_mapped("force") != "wujing")
    return notify_fail("燕荡剑法只有配合无经神功才能练。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 30
    || (int)me->query("neili") < 5)
    return notify_fail("你的内力或气不够，没有办法练习燕荡剑法。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -5);
  write("你按著所学练了一遍燕荡剑法。\n");
  return 1;
}

int valid_effect(object me, object weapon, string name, int skill) {}

string perform_action_file(string action) {
  return __DIR__ "yandang-sword/" + action;
}
