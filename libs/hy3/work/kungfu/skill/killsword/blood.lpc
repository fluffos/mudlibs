// jianzhang.c  舐血无影
// modified by drunk
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
        string msg;
 
        if( !me->is_fighting() )
                return notify_fail("「舐血无影」只能在战斗中使用。\n");
 
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("使用「舐血无影」必须拿着一把剑！\n");

        if( (int)me->query("neili") < 100 )
                return notify_fail("你的真气不够！\n");
        if( (int)me->query("jing") < 50 )
                return notify_fail("你的精不够！\n");

        if( (int)me->query_skill("sword") < 100 ||
            me->query_skill_mapped("sword") != "killsword")
                return notify_fail("你的杀手剑还不到家，无法使用舐血无影！\n");

        msg = HIY "$N使杀手剑之绝技「舐血无影」，身法陡然加快！\n" NOR;
        message_vision(msg, me);

        me->clean_up_enemy();
        ob = me->select_opponent();

        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

        me->add("neili", -100);
        me->add("jing", -50);
        me->start_busy(2+random(5));

        return 1;
}

