// liaoyuan.c 星火燎原

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  string msg, string1;
  object weapon, ob;
  int skill, ap, dp, neili_wound, qi_wound, count, i;

  me->clean_up_enemy();
  target = me->select_opponent();

  skill = me->query_skill("xingyi-zhang", 1);

  if (!(me->is_fighting()))
    return notify_fail("「星火燎原」只能对战斗中的对手使用。\n");

  if ((int)me->query_temp("liaoyuan")) return notify_fail("你已经在使用「星火燎原」这一慕容绝学了。\n");

  if (skill < 80)
    return notify_fail("你的星移掌掌握的不够娴熟, 无法使出「星火燎原」这一绝技！\n");

  if (me->query("neili") < 200)
    return notify_fail("你的内力不足，无法施展「星火燎原」！\n");

  if (me->query("max_neili") < 200)
    return notify_fail("你的内力修为尚浅，无法运用「星火燎原」！\n");

  msg = HIY "$N凌空越起,一招「星火燎原」,单掌推出，掌力浑厚无比，向$n的胸前直击而去。\n\n" NOR;
  message_vision(msg, me, target);

  ap = me->query_skill("strike") + skill;
  dp = target->query_skill("force");
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("neili", -100);
    msg = HIR "$n顿时觉得眼前一花，心中一凛,胸前一阵剧痛，全身乏力,即将摔倒在地！\n\n" NOR;

    neili_wound = 300 + random(skill);
    if (neili_wound > target->query("neili"))
      neili_wound = target->query("neili");

    qi_wound = neili_wound / 4;
    if (qi_wound > target->query("qi"))
      qi_wound = target->query("qi");

    target->add("neili", -neili_wound);
    target->add("qi", -qi_wound);
    target->add("eff_qi", -qi_wound);
    target->start_busy(2);
    me->start_busy(random(2));
  } else {
    if (userp(me))
      me->add("neili", -50);
    msg = "可是$n身法灵巧之极,一转一侧看,将来招尽数避开。\n\n" NOR;
    me->start_busy(3);
  }
  message_vision(msg, me, target);


  msg = HIC "$N身行诡异一转，陡然间急运内力至双掌之上，刹时间双掌不定向的推向$n周身！\n\n" NOR;
  msg += HIB "$n见$N双掌疾攻而至，惊诧间欲避不及！\n" NOR;
  if ((int)me->query_skill("force") >= (int)target->query_skill("force")) {
    target->start_busy(2);
  }
  if ((int)me->query_skill("force") < (int)target->query_skill("force")) {
    target->start_busy(random(2));
  }
  message_vision(msg, me, target);
  skill = me->query_skill("xingyi-zhang", 1) / 2;
  me->add_temp("apply/attack", skill);
  me->add_temp("apply/strike", skill);
  me->add_temp("apply/parry", skill);
  me->set_temp("liaoyuan", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), 2);

  me->clean_up_enemy();
  ob = me->select_opponent();
  COMBAT_D->do_attack(me, ob, 0);
  COMBAT_D->do_attack(me, ob, 0);
  COMBAT_D->do_attack(me, ob, 0);
  COMBAT_D->do_attack(me, ob, 0);
  COMBAT_D->do_attack(me, ob, 0);


  me->add("neili", -75);
  me->start_busy(2 + random(2));

  return 1;
}

void remove_effect(object me, int amount) {
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/strike", -amount);
  me->add_temp("apply/parry", -amount);
  me->delete_temp("liaoyuan");
  tell_object(me, HIG "你运功完毕，将内力收回丹田。\n" NOR);
}
