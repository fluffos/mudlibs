// liumai.c - 六脉归宗

#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int pow, i;
  string prepare;

  prepare = me->query_skill_prepared("finger");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("六脉归宗只能对战斗中的对手使用。\n");

  if (me->query_temp("weapon"))
    return notify_fail("你必须空手才可以使用六脉归宗。\n");

  if (me->query_skill("finger") < 200)
    return notify_fail("你在指法上的造诣不够，无法使用六脉归宗。\n");

  if (me->query_skill("dodge") < 200)
    return notify_fail("你在轻功上的造诣不够，无法使用六脉归宗。\n");

  if ((int)me->query_skill("kurong-changong", 1) < 200
    || me->query_skill_mapped("force") != "kurong-changong")
    return notify_fail("你的枯荣禅功造诣不够，无法使用六脉归宗。\n");

  if (me->query_skill("liumai-shenjian", 1) < 300)
    return notify_fail("你的六脉神剑造诣不够，无法使用六脉归宗。\n");

  if (me->query("max_neili") < 2000 || me->query("neili") < 800)
    return notify_fail("你的内力不够，无法施展六脉归宗！\n");

  if (prepare != "liumai-shenjian")
    return notify_fail("你现在没有准备使用这项技能！\n");

  message_vision(
    HIW "$N凌空跃起,使出了六脉神剑的最高绝技——「" NOR + HIR "六脉归宗" NOR + HIW "」！\n" NOR
    +BLINK "[31m「中冲」、[36m「少冲」、[35m「关冲」"
    + "[33m「少商」、[34m「商阳」、[30m「少泽」" NOR
    +HIW "\n六剑齐发，幻化成六道剑光疾射而出，一齐射向$n！！！\n" NOR, me, target);
  me->add("neili", -800);

  pow = (int)me->query_skill("liumai-shenjian", 1);
  pow = pow / 2 + random(pow);
  pow = pow / 6;
  if (pow > 100) pow = 100;
  for (i = 0; i < 6; i++) {
    me->add_temp("apply/attack", pow * 3);
    me->add_temp("apply/defense", pow * 2);
    COMBAT_D->do_attack(me, target, 0);
  }
  me->add_temp("apply/attack", -pow * 18);
  me->add_temp("apply/defense", -pow * 12);
  me->start_busy(4);

  return 1;
}
