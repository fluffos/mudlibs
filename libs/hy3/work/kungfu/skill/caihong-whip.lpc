  ([ "action": "$N手腕急振，一式「长虹贯日」，手中$w如枪直击，攻向$n的胸膛",
    "dodge": -10,
    "damage": 100,
    "lvl": 0,
    "skill_name": "长虹贯日",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N单臂一挥，一式「陨石烧空」，手中$w自下而上击向$n的腿部",
    "dodge": -20,
    "damage": 200,
    "lvl": 50,
    "skill_name": "陨石烧空",
    "damage_type": "淤伤"
  ]),
  ([ "action": "$N振臂一举，一式「南斗西沉」，手中$w如大石一砸，猛地向$n劈头打下",
    "dodge": -30,
    "damage": 300,
    "lvl": 80,
    "skill_name": "南斗西沉",
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N双手急舞，一式「火炽流金」，手中$w舞出满天幻影，排山倒海般扫向$n全身",
    "dodge": -40,
    "damage": 400,
    "lvl": 80,
    "skill_name": "火炽流金",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N忽的向前一跃，一式「流云无际」，手中$w分击$n左右",
    "dodge": -50,
    "damage": 500,
    "lvl": 90,
    "skill_name": "流云无际",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N力贯鞭梢，一式「浮云掩日」，手中$w浮云无形，排山倒海般扫向$n全身",
    "dodge": -60,
    "damage": 600,
    "lvl": 120,
    "skill_name": "浮云掩日",
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N如山而立，一式「七阳争辉」，手中$w分袭$n七处大穴",
