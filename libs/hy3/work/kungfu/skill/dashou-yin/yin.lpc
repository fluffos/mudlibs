#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("大手印「印字诀」只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("longxiang", 1) < 120)
    return notify_fail("你的龙象般若功不够娴熟，不会使用「印字诀」!\n");

  if ((int)me->query_skill("dashou-yin", 1) < 120)
    return notify_fail("你的大手印不够娴熟，不会使用「印字诀」!\n");

  if ((int)me->query_skill("lamaism", 1) < 120)
    return notify_fail("你的密宗心法不够娴熟，不会使用「印字诀」!\n");

  if ((int)me->query("neili", 1) < 500)
    return notify_fail("你现在内力太弱，不能使用「印字诀」!\n");

  msg = RED "$N一声大喝，手掌忽的变为一个硕大的血掌，刹时间满空血影，另人几欲\n"
    + "窒息，$n正在难受间，满空的血影已层层叠叠向$n罩来......\n" NOR;

  if (random(me->query_skill("dashou-yin", 1)) > target->query_skill("force", 1) / 4) {
    me->start_busy(random(2));
    target->start_busy(random(3));

    damage = me->query_skill("dashou-yin", 1) + me->query_skill("longxiang", 1) * 3 / 2;
    damage = damage * 2 / 3 + random(damage / 3);
    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 2);
    me->add("neili", -damage / 3);

    if (damage < 200)
      msg += HIC "结果$n与$N双掌相交，发出一声闷哼。\n" NOR;
    else if (damage < 400)
      msg += HIY "结果$n被$N以一掌印在右肩，「嘿」地一声退了两步。\n" NOR;
    else if (damage < 600)
      msg += MAG "结果$n被$N以一掌印在胸口，有如受到一记重锤，连退了五六步！\n" NOR;
    else
      msg += HIR "结果$n被$N的一掌印中后背，眼前一黑，口中鲜血狂砰而出！\n" NOR;
  } else {
    me->start_busy(random(4));
    me->add("qi", -(damage / 3));
    msg += HIG "可是$p看破了$P的漫天掌影，看准时机，反掌一击，直震得$P气血"
      + "翻腾不止。\n" NOR;
    me->add("neili", -200);
  }
  message_vision(msg, me, target);
  return 1;
}
