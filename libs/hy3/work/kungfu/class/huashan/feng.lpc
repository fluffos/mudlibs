inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  set_name("风清扬", ({ "feng qingyang", "feng" }));
  set("title", HIG "华山第十二代弟子" NOR);
  set("long",
    "他就是华山派剑宗第一高手——风清扬，一手独孤九剑天下无敌。\n");
  set("gender", "男性");
  set("age", 76);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 40);
  set("con", 30);
  set("dex", 30);

  set("qi", 5000);
  set("max_qi", 5000);
  set("jing", 5000);
  set("max_jing", 5000);
  set("neili", 8000);
  set("max_neili", 8000);
  set("jiali", 200);

  set("combat_exp", 6500000);
  set("score", 200000);

  set_skill("cuff", 460);
  set_skill("force", 500);
  set_skill("sword", 600);
  set_skill("dodge", 460);
  set_skill("ziyin-yin", 480);
  set_skill("zhengqi-jue", 480);
  set_skill("parry", 460);
  set_skill("strike", 460);
  set_skill("zixia-shengong", 480);
  set_skill("poyu-quan", 450);
  set_skill("dugu-jiujian", 500);
  set_skill("huashan-jianfa", 450);
  set_skill("hunyuan-zhang", 450);
  set_skill("huashan-shenfa", 450);
  set_skill("literate", 400);

  map_skill("cuff", "poyu-quan");
  map_skill("force", "zixia-shengong");
  map_skill("dodge", "huashan-shenfa");
  map_skill("strike", "hunyuan-zhang");
  map_skill("parry", "dugu-jiujian");
  map_skill("sword", "dugu-jiujian");
  prepare_skill("strike", "hunyuan-zhang");

  prepare_skill("cuff", "poyu-quan");


  create_family("华山派", 12, "弟子");

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.po" :),
    (: perform_action, "sword.poqi" :),
    (: perform_action, "sword.pozhang" :),
    (: perform_action, "strike.wuji" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}

void attempt_apprentice(object ob) {

  if ((string)ob->query("family/family_name") != "" &&
    (string)ob->query("family/family_name") != "华山派") {
    command("say " + RANK_D->query_respect(ob) + "既然已有名师指点，何必又来拜老朽呢？");
    return;
  }

  if (((int)ob->query_skill(
    "force",
    1
  ) < 200) || ((int)ob->query_skill("zixia-shengong", 1) < 200)) {
    command("say 我看" + RANK_D->query_respect(ob) + "的紫霞神功还没学到家吧。");
    return;
  }
  if (((int)ob->query_skill(
    "dodge",
    1
  ) < 200) || ((int)ob->query_skill("huashan-shenfa", 1) < 200)) {
    command("say 我看" + RANK_D->query_respect(ob) + "的华山身法还没学到家吧。");
    return;
  }

  if ((int)ob->query("shen") < 100000) {
    command("say 我华山派乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }

  if ((int)ob->query_con() < 40 || (int)ob->query_int() < 40) {
    command("say 练独孤九剑需要很高的悟性和根骨。");
    command("say " + RANK_D->query_respect(ob) +
      "资质和根骨都还无法让老夫满意。");
    return;
  }

  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "fighter")
    ob->set("class", "fighter");
  return;
}
