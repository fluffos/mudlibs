// ruanwei jia
#include <ansi.h> 
#include <armor.h>
inherit ARMOR;
inherit F_UNIQUE1;
void create()
{
      set_name( HIY"软猬甲"NOR,({ "ruanwei jia","jia", }) );
      set_weight(1000);
      if( clonep() )
                set_default_object(__FILE__);
        else
        {
                set("unit", "件");
                set("long", "一件轻飘飘的、生满尖锐倒刺的护甲。\n");
                set("id_id","ruanwei jia");
                set("unique",1);
                set("no_put",1);
                set("no_steal",1);
                set("replica_ob","/d/city/npc/obj/tiejia");
                set("material", "gold");
                set("value",200000);
                set("armor_prop/armor", 300);
        }
        setup();
}
