// rong.c 黄蓉
inherit NPC;
inherit F_MASTER;
string ask_chicken();
string ask_me();
void create() {
  set_name("黄蓉", ({ "huang rong", "huang", "rong" }));
  set("title", "桃花岛主独生爱女");
  set("gender", "女性");
  set("age", 18);
  set("long",
    "这是桃花岛主的独生女儿。由于岛主夫人早死，岛主对这个女儿备加疼爱。\n"
    "她生性跳脱飞扬，喜欢四处乱跑。\n");

  set("attitude", "peaceful");
  set("no_get", 1);
  set("str", 29);
  set("int", 30);
  set("per", 30);
  set("con", 120);
  set("dex", 120);
  set("qi", 4800);
  set("max_qi", 4800);
  set("jing", 4000);
  set("max_jing", 4000);
  set("neili", 8000);
  set("max_neili", 6000);
  set("max_jingli", 5000);
  set("combat_exp", 1500000);
  set("score", 0);
  set_skill("force", 200);
  set_skill("bibo-shengong", 200);
  set_skill("unarmed", 200);
  set_skill("luoying-zhang", 200);
  set_skill("dodge", 300);
  set_skill("anying-fuxiang", 300);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set_skill("luoying-shenjian", 200);
  set_skill("qimen-wuxing", 200);

  map_skill("force", "bibo-shengong");
  map_skill("unarmed", "luoying-zhang");
  map_skill("dodge", "anying-fuxiang");
  map_skill("sword", "luoying-shenjian");

  create_family("桃花岛", 2, "弟子");

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
  }));

  set("inquiry", ([
    "软猬甲": (: ask_me :),
    "叫化鸡": (: ask_chicken :)
  ]));

  setup();
  carry_object("/d/city/npc/obj/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
  carry_object(__DIR__ "obj/ruanwei_jia")->wear();
  carry_object(__DIR__ "obj/shudai")->wear();

}

void init() {
  object ob;
  mapping myfam;

  ::init();
  add_action("do_kiss", "kiss");
  if (interactive(ob = this_player()) && !is_fighting()) {
    myfam = (mapping)ob->query("family");
    if ((!myfam || myfam["family_name"] != "桃花岛") &&
      (!wizardp(ob))) {
      remove_call_out("saying");
      call_out("saying", 2, ob);
    }
  }

  remove_call_out("check_me");
  call_out("check_me", 2);
}

int do_kiss(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg != "rong")
    return 0;

  if ((string)ob->query("gender") == "男性")
    command("say 救命啊！救命啊！" + ob->query("name") + "要非礼我！\n");
  else
    message_vision("\n黄蓉对$N笑道：“好姐姐不要这样，我怕痒！”\n", ob);
  return 1;
}

void saying(object ob) {
  if (!ob || environment(ob) != environment())
    return;
  if ((string)ob->query("gender") == "男性")
    message_vision("\n黄蓉面现惊奇之色，打量了$N一眼，说到：“你是什么人，"
      "竟敢乱闯我的闺房？\n再不滚出去，看我怎么整你！”\n", ob);
  else
    message_vision("\n黄蓉看了看$N，说到：“好久没生人来过了，"
      "不知这位姐姐可有我靖哥哥的消息？\n", ob);
}

void attempt_apprentice(object ob) {
  command("say 我年纪这么小就收徒弟，岂不让人笑掉大牙！");
}

string ask_chicken() {
  if (this_player()->query_temp("marks/鸡", 1))
    return "你这个人怎么这么烦？老说车轱辘话！\n";
  else {
    say("蓉儿神往地说：叫化鸡可是杭州著名特产，我爹当年费了好大的劲才搞到了制作\n"
      "它的秘方。你问它来干什么？\n");
    this_player()->set_temp("marks/鸡", 1);
    return "你可以出去了。\n";
  }
}

string ask_me() {
  object me = this_player(), jia;

  if (!me->query("family/master_id")
    || me->query("family/master_id") != "huang yaoshi")
    return "要软猬甲啊，嘻嘻，就是不给你。\n";

  if (!objectp(jia = present("ruanwei jia", this_object())))
    return "你来晚了，软猬甲已经不在我身上了。\n";
  jia->move(me);
  return "好吧，这副软猬甲就先借你用啊，可别弄丢了哦！\n";
}

int check_me() {
  object me = this_object(), *env, huang, room;
  int i;

  env = all_inventory(environment(me));
  if (me->is_fighting()) {
    room = load_object("/d/taohua/dating");
    if (objectp(huang = present("huang yaoshi", room))) {
      command("chat " + "爹爹快来，有人在欺负蓉儿哪！！！");
      huang->command("go west");
    }
    if (objectp(huang = present("huang yaoshi", environment(me))))
      for (i = 0; i < sizeof(env); i++) {
        if (env[i] == me->query_temp("last_damage_from") && !huang->is_killing(env[i]) && env[i] != me) {
          huang->command("chat " + env[i]->query("name")
            + "，你这大胆狂徒，敢打伤我女儿，老夫要把你碎尸体万断！\n");
          huang->set_leader(env[i]);
          huang->kill_ob(env[i]);
        } else if (env[i]->is_fighting(me) && !env[i]->is_fighting(huang) && env[i] != me)
          huang->kill_ob(env[i]);
      }
  }

  remove_call_out("check_me");
  call_out("check_me", 2);

  return 1;
}
