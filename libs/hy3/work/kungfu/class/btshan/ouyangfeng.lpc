///ouyangfeng.c

#include <ansi.h>

inherit BH_NPC;
inherit F_MASTER;

void create()
{
        set_name("欧阳锋", ({ "ouyang feng", "ouyang", "feng" }));
        set("long", "他是白驼山庄主，号称“西毒”的欧阳锋。\n"
                   +"由于习练「九阴真经」走火入魔，已变得精\n"
                   +"神错乱，整日披头散发。\n");
        set("title", "老毒物");
        set("gender", "男性");
        set("age", 53);
        set("nickname", HIR "西毒" NOR);
        set("shen_type",-1);
        set("attitude", "peaceful");

        set("str", 30);
        set("int", 29);
        set("con", 30);
        set("dex", 28);
        set("max_jingli",10000); 
        set("qi", 12500);
        set("max_qi",12500);
        set("jing", 9000);
        set("max_jing", 9000);
        set("neili", 26000);
        set("max_neili", 25000);
        set("jiali", 250);

        set("combat_exp", 8500000);
        set("score", 200000);
        set("shen", -500000);
        set_skill("force", 460);
        set_skill("unarmed", 420);
        set_skill("dodge", 460);
        set_skill("sword", 450);
        set_skill("killsword", 450);
        set_skill("parry", 460);
        set_skill("duji", 430);
        set_skill("finger",460);
        set_skill("staff", 460);
        set_skill("hamagong", 480);
        set_skill("chanchu-bufa", 460);
        set_skill("shedu-qiqiao", 450);
        set_skill("lingshe-zhangfa", 460);
        set_skill("shexing-diaoshou", 460);
        set_skill("hand",460);
        map_skill("hand", "shexing-diaoshou");
        map_skill("force", "hamagong");
        map_skill("dodge", "chanchu-bufa");
        map_skill("sword", "killsword");
        map_skill("finger", "shedu-qiqiao");
        map_skill("parry", "lingshe-zhangfa");
        map_skill("staff", "lingshe-zhangfa");
        prepare_skill("finger", "shedu-qiqiao"); 
        create_family("白驼山",1, "开山祖师");
        set("chat_chance",2);
        set("chat_msg",({
         "欧阳锋自言自语道：何日白驼山才能重霸江湖呢…\n",
         "欧阳锋道：我儿欧阳克必能够重振白驼山雄风！\n",
         "欧阳锋道：江湖险恶，困难重重哪！\n",
        }));
            set("no_get",1);
      set("chat_chance_combat", 60);
      set("chat_msg_combat", ({
                 (: perform_action, "force.hama" :),
                 (: perform_action, "staff.shoot" :),
                 (: exert_function, "nizhuan" :), 
                 (: exert_function, "powerup" :),
                         }) ) ;

        setup();
        carry_object("/d/baituo/obj/shezhang")->wield();
        carry_object("/clone/misc/cloth")->wear();
        add_money("silver",50);
}

void init()
{
        object ob;

        ::init();

        ob = this_player();
         if((int)ob->query("shen")>=0&&ob->query("family/master_id")=="ouyang feng")
        {
                    command("chat "+ob->query("name")+"!你心慈手软，怎能做我邪派弟子，给我滚蛋。\n");
                  command("expell "+ ob->query("id"));
                    this_player()->set("title","白驼山" + RED + "弃徒" NOR);   
        }

}     

void attempt_apprentice(object ob)
{
  if((int)ob->query("combat_exp")<100000)
        {
          message_vision("欧阳锋对$N笑道：你的经验太低了,我还不能收你！\n",ob);
          return ;
         }
   message_vision("欧阳锋拍拍$N的头，微微点了点头。\n",ob);
   command("chat 我欧阳锋又多了个儿子，"+ ob->name() +"一定要让中原武林知道我们的厉害！");
   command("chat 哈哈哈哈！！！");
   command("recruit " + ob->query("id"));
   ob->set("title","白驼山少庄主");
   return;
}

