// bamboo_stick.c
#include <ansi.h>
#include <weapon.h>
inherit STAFF;
inherit F_UNIQUE1;
void create()
{
        set_name(HIG"玉竹杖"NOR, ({"yuzhu zhang", "zhang", "stick"}));
        set_weight(20000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根泛着淡淡青光的" + GRN "竹杖" NOR + "\n");
                set("value", 1000000);
                set("rigidity",300);  
                set("replica_ob","/d/city/npc/obj/zhubang"); 
                set("wield_neili", 300);
                set("wield_maxneili", 700);
                set("wield_str", 22);
                set("unique",1);
                set("no_put",1);
                set("material", "bamboo");
                set("wield_msg", "$N抽出一根青光闪闪的" + GRN "竹杖" NOR + "抓在手中。\n");
                set("unwield_msg", "$N把手中的" + GRN "玉竹杖" NOR + "插回腰中。\n");
        }
        set("id_id","yuzhu zhang");
        init_staff(300);
        setup();
}       
