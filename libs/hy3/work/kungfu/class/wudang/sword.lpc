// random_weapon.c
// create by Leonardo

#include <ansi.h>
#include <weapon.h>
inherit SWORD;

string type();

mapping *weapon=({
        ([
        "name"  :       HIB"残缺的",
        "extra" :       random(20)+1,
                ]),
        ([
        "name"  :       HIM"有瑕疵的",
        "extra" :       random(50)+1,
                ]),
        ([
        "name"  :       HIG"小巧的",
        "extra" :       random(100)+1,
                ]),
        ([
        "name"  :       HIC"精制的",
        "extra" :       random(150)+1,
                ]),
        ([
        "name"  :       HIY"无瑕的",
        "extra" :       random(200)+1,
                ]),
        ([
        "name"  :       HIW"完美的",
        "extra" :       random(300)+1,
                ]),
});



void create()   
{
        int i;
        i=random(6);
        set_name(weapon[i]["name"]+"剑"NOR,({"sword"}));
        set_weight(4000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("long","这是一把上古宝剑。\n");
        set("value",500000);
        set("treasure",1);
        set("material", "steel");
        set("rigidity",6);
        set("unit","把");
        set("sharpness",5);
        set("no_give",HIM"这是宝物，你怎可随便给人？"NOR);
        set("wield_msg",HIC"$N从腰中缓缓的拿出了古剑握在手中。\n"NOR);
        
        }
        init_sword(weapon[i]["extra"]);
        setup();
        
        
}
