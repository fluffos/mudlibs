void consider()
{
        int i, flag = 0;
        object *enemy;

        enemy = query_enemy() - ({ 0 });
        for(i=0; i<sizeof(enemy); i++) {
                if( !living(enemy[i]) ) continue;
                if( enemy[i]->query_temp("weapon") ) {
                        flag++;
                        if(     !query_temp("weapon") ) {
                                say(RED "\n张三丰说道：“既然" + RANK_D->query_respect(enemy[i]) + "使用兵刃，贫道空手接招未免不敬！”\n\n" NOR);
                                command("wield changjian");
                                break;
                        }
                }
        }
        if( !flag && query_temp("weapon") ) {
                if( sizeof(enemy) > 1 )
                        say(RED "\n张三丰说道：“嗯... 既然" + chinese_number(sizeof(enemy)) + "位都是空手，贫道理当奉陪！”\n\n" NOR);
                else
                        say(RED "\n张三丰说道：“既然" + RANK_D->query_respect(enemy[0]) + "不使兵刃，贫道自然奉陪！”\n\n" NOR);
                command("unwield changjian");
        }
}

string ask_me()
{
    object me=this_player(),jian;

    if(!me->query("family/master_id")
      || me->query("family/master_id")!="zhang sanfeng")  
    return "真武剑乃本派镇山之宝，贫道不便轻易相送。\n";
    if(!objectp(jian=present("zhenwu jian",this_object())))
    return "你来晚了，真武剑已经不在我身上了。\n";  
    jian->move(me);
    return "好吧，本派镇山之宝就暂时交给你掌管了！\n";
}

