// killer.c
// modified by xingyun
#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  string tem1, tem2, tem3, site;
  object ob;

  if (environment(me)) {
    site = file_name(environment(me));
    if (sscanf(site, "/%s/%s/%s", tem1, tem2, tem3) == 3
      && tem1 == "d" && tem2 == "city") {
      message_vision(
        HIW "突然天空中闪电交加，一个雷鸣般声音朝$N喝到：“杀人犯！扬州城\n" +
        "可不欢迎你，还是滚到去南疆吧！\n" NOR +
        HIR "只听砰的一声，$N被一脚踢出了扬州城，消失在天际间...\n" NOR, me);
      me->move("/d/xingxiu/nanjiang3");
    }
  }

  if (duration < 1) {
    tell_object(me, "官府不再通缉你了！\n");
    return 0;
  }
  if (duration == 3) {
    switch (random(3))  //随机产生一名巡捕
    {
      case 0: ob = new("/d/unpker/xunbu1"); shout(HIW "【官府通告】知府：本府已派出一般巡捕处理这次PK事件。\n" NOR); break;
      case 1: ob = new("/d/unpker/xunbu2"); shout(HIW "【官府通告】知府：本府已派出高级巡捕处理这次PK事件。\n" NOR); break;
      case 2: ob = new("/d/unpker/xunbu3"); shout(HIW "【官府通告】知府：本府已派出超级巡捕处理这次PK事件。\n" NOR); break;
    }
    ob->move(environment(me));
    ob->kill_ob(me);
    tell_object(me, HIW "巡捕突然出现在你的身后。\n" NOR);
  }

  me->apply_condition("killer", duration - 1);

  return CND_CONTINUE;
}
