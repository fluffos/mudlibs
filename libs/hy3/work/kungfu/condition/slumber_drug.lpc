// drunk.c
#include <condition.h>
#include <ansi.h>

inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
        int limit;

        if( duration < 1 ) return 0;      
        me->apply_condition("slumber_drug", duration - 1);       
        limit = me->query_con() + (int)me->query("max_neili") / 100;

        if( duration > limit
            &&        living(me) ) {
                tell_object(me,BLINK+HIY"忽然你只觉得一阵头晕目眩，神志开始迷糊起来.....\n"NOR);
                me->unconcious();
                me->apply_condition("slumber_drug",0);
                return 0;
        }

        if( duration > limit/2 ) {
                tell_object(me, HIY"你觉得脑中昏昏沉沉，心中空荡荡的，直想躺下来睡一觉。\n"NOR);
                message("vision", HIY+me->name() + "摇头晃脑地站都站不稳，显然是蒙汗药的药力发作了。\n"NOR,
                        environment(me), me);
        }
        return CND_CONTINUE;
}

string query_type(object me)
{
        return "poison";
}
