#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
    if( duration < 1 ) return 0;

    if( duration % 3 == 0 )
    if( !living(me) ) {
        message("vision", me->name() + "痛苦地哼了一声。\n", environment(me), me);
    }else {
        tell_object(me, HIY"忽然一阵奇痒传遍你的全身，你中的玉蜂针毒发作了！\n"NOR); 
        message("vision", me->name() 
        + "忽然蜷缩倒地，伸手在身上到处乱抓。\n",environment(me), me);
    }
    me->receive_wound("qi",15 + random(10));
    me->receive_wound("jing", 10);
    me->apply_condition("yufeng_poison", duration - 1);
    me->set_temp("die_for","中玉蜂针毒");
    me->delete_temp("last_damage_from");
    if( duration < 1 ) return 0;
    return CND_CONTINUE;
}

