#include <ansi.h>
inherit ITEM;


void create()
{
	set_name(HIR"极乐丹"NOR, ({ "jiledan" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else 
	{
		set("long", "这是淳于堡主对付女人用的玩意儿。\n");
		set("unit", "粒");
		set("weight", 50);
		set("value", 700);
	}
//	set_amount(1);
}

void init()
{
	add_action("do_pour", "pour");
}

int do_pour(string arg)
{
	string me, what;
	object ob;
	function f;

	if( !arg
	||	sscanf(arg, "%s in %s", me, what)!=2
	||	!id(me) )
		return 0;

	ob = present(what, this_player());
	if( !ob )
		return 0;
	if( !ob->query("liquid/remaining") )
		return 0;
	f = (: call_other, __FILE__, "drink_drug" :);
	ob->set("liquid/drink_func", bind(f, ob));
	ob->add("liquid/slumber_effect", 100);
	message_vision("$N将" + name() + "放入" + ob->name() 
		+ "中，摇晃了几下。\n", this_player());
//	add_amount(-1);
	return 1;
}

int drink_drug(object ob)
{
	this_player()->set("eff_sen",1);
	this_player()->set("eff_kee",1);
	this_player()->set("eff_gin",1);
	this_player()->unconcious();
	return 0;
}