//rewrited by xingyun

#include <ansi.h>
inherit NPC;
int get_level(int exp);
void seek_ob(object me);

void create() {
  set_name("蒙古箭手", ({ "menggu jianshou", "jianshou" }));
  set("gender", "男性");
  set("long", "这是一名蒙古神箭手，正警惕地监视着襄阳城的情况。\n");

  set("int", 30);
  set("str", 30 + random(10));
  set("con", 20 + random(5));
  set("dex", 20 + random(5));
  set("age", 20 + random(30));
  set("per", 15 + random(15));

  set("combat_exp", 1000000);
  set("max_qi", 3000);
  set("qi", query("max_qi"));
  set("max_jing", 2000);
  set("jing", query("max_jing"));
  set("max_neili", 5000);
  set("neili", query("max_neili"));
  set("max_jingli", 4000);
  set("jingli", query("max_neili"));

  set_skill("taiji-quan", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("sword", 100);
  set_skill("unarmed", 100);
  set_skill("taiji-jian", 100);
  set_skill("force", 100);
  set_skill("wudu-shengong", 100);
  set_skill("tiyunzong", 100);
  set_skill("arrow", 100);

  map_skill("sword", "taiji-jian");
  map_skill("force", "wudu-shengong");
  map_skill("parry", "taiji-quan");
  map_skill("unarmed", "taiji-quan");
  map_skill("dodge", "tiyunzong");

  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :),
  }));
  set("no_clean_up", 1);
  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

void change_ob(object me) {
  int level, exp;
  int lvl;

  exp = me->query("combat_exp") * 4 / (random(3) + 3);
  level = get_level(exp);
  level = level / 3 + random(level / 3);
  if (me->query_skill("arrow", 1) > level)
    level = me->query_skill("arrow", 1);
  level = level + (random(21) - 10) * level / 100;
  set_skill("taiji-quan", level);
  set_skill("dodge", level);
  set_skill("parry", level);
  set_skill("sword", level);
  set_skill("unarmed", level);
  set_skill("taiji-jian", level);
  set_skill("force", level);
  set_skill("wudu-shengong", level);
  set_skill("tiyunzong", level);
  set_skill("arrow", level);
  set_skill("lianzhu-arrow", level);
  map_skill("arrow", "lianzhu-arrow");
  map_skill("sword", "taiji-jian");
  map_skill("force", "wudu-shengong");
  map_skill("parry", "taiji-quan");
  map_skill("unarmed", "taiji-quan");
  map_skill("dodge", "tiyunzong");

  set("combat_exp", exp);
  set("max_qi", me->query("max_qi") * 2 / 3);
  if (query("max_qi") < 1200) set("max_qi", 1200);
  set("eff_qi", query("max_qi"));
  set("qi", query("max_qi"));
  set("max_jing", me->query("max_jing") / 2);
  if (query("max_jing") < 600) set("max_jing", 600);
  set("eff_jing", query("max_jing"));
  set("jing", query("max_jing"));
  set("max_neili", me->query("max_neili") * 2 / 3);
  set("neili", query("max_neili"));
  set("max_jingli", query("max_neili"));
  set("jingli", query("max_neili"));
  set("killer", me->query("id"));
  lvl = (query("str") + level / 10) / 10 - 1;
  if (lvl > 8) lvl = 8;
  carry_object("/quest/zhuzao/weapon/bow/bow" + lvl)->wield();
  call_out("seek_ob", 2, this_object());
  return;
}

int get_level(int exp) {
  int level = 0;
  do {
    level++;
  } while (level * level * level < (exp * 10));
  if (level > 60)
    return level - 60;
  else return 60;

}

void seek_ob(object me) {
  int step, i, num;
  string site_name;
  object bow, killer, room;

  killer = find_living(me->query("killer"));
  command("yun powerup");

  if (!killer || !environment(killer)) {
    remove_call_out("seek_ob");
    destruct(me);
    return;
  }

  room = environment(killer);
  if (!me->query("where")
    || !killer->query_condition("jobjianlou_limit")
    || !room->query("site")
    || room->query("site") != killer->query_temp("guo_jianlou/where")) {
    remove_call_out("seek_ob");
    destruct(me);
    return;
  }

  if (!killer->query_temp("netdead")) {
    bow = me->query_temp("weapon");
    step = environment(me)->query("step");

    if (living(me) && bow->query("is_bow") && step <= bow->query("dam") / 200) {
      num = me->query_skill("lianzhu-arrow", 1) / 100 + 1;
      if (random(10) > 2) num = 1;
      if (me->query("qi") > num * 400 && me->query("jing") > num * 100) {
        tell_object(all_inventory(room),
          HIB "你觉得一股猛烈的危机从" HIR "东面" HIW + chinese_number(step) + "箭地" HIB "外传来！\n" NOR);
        for (i = 0; i < num; i++)
          bow->do_shoot(me->query("killer"), me, bow, room, "west", step);
        if (num > 4) num = 4;
        me->start_busy(num * 2);
      } else
        tell_object(all_inventory(room),
          HIB "你觉得好象有人在" HIR "东面" HIW + chinese_number(step) + "箭地" HIB "外朝你这边窥视了一眼！\n" NOR);
    }
  }
  remove_call_out("seek_ob");
  call_out("seek_ob", 5, me);
  return;
}

void die() {
  object ob;
  ob = query_temp("last_damage_from");

  if (ob && userp(ob))
    if (ob->query_temp("guo_jianlou/start_job") == 1) {

      if (query("killer") == ob->query("id"))
        ob->add_temp("guo_jianlou/killed_mgb", query_str() / 5);
      else
        ob->add_temp("guo_jianlou/killed_mgb", 1);
      tell_object(ob, RED "一名蒙古弓箭手又丧命于你的利箭之下！\n" NOR);
    }
  destruct(this_object());
  return;
}
