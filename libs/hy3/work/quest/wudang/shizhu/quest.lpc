// By yfeng 14/10/99
// 南岩峰石柱加skills的quest
// skills: cuff、strike、hand、dodge、parry、sword 101-200 level
int mianbi_skill(object ob, string arg) {
  if (!arg) {
    message_vision("$N面对着石柱趺坐静思良久，白忙一场，一无所获。\n", ob);
    return 1;
  }
  if ((int)ob->query_skill("literate", 1) < 60)
    return notify_fail("你对石柱上每一个字都认识，可就是不知道说的什么。\n");
  if ((arg != "sword") && (arg != "cuff") && (arg != "strike") && (arg != "hand")
    && (arg != "dodge") && (arg != "parry") && (arg != "taoism"))
    return notify_fail("石柱上并未记载这种技能。\n");
  if (arg == "taoism")
    if (ob->query_skill("taoism", 1) < 120)
      return notify_fail("你对着石柱上的蝌蚪文字看了半天，结果什么都没看懂。\n");
  if (ob->query_skill("taoism", 1) > 180)
    return notify_fail("你对着石柱看了半天，觉得石柱上所载有关道学心法的内容还没有你自己领悟的高深。\n");
  else if (ob->query_skill(arg, 1) < 100)
    return notify_fail("你看来看去，觉得石柱所载有关" + to_chinese(arg) + "的内容太过高深，一时半会无法领悟。\n");
  if (ob->query_skill(arg, 1) > 200)
    return notify_fail("你的这项技能已比石柱所载有关内容高明了许多，不必再浪费时间领悟了。\n");
  if (ob->query("potential") < 1)
    return notify_fail("你的潜能不够了，无法领悟石柱的内容。\n");
  if (ob->query("jingli") < 20)
    return notify_fail("你太累了，现在无法领悟石柱内容。\n");
  if (ob->query("jing") < 10)
    return notify_fail("你现在精神不好，无法领悟石柱的内容。\n");
  message_vision("$N面对着石柱趺坐静思，良久，对" + to_chinese(arg) + "似有所悟。\n", ob);
  ob->improve_skill(arg, (2 + random(3)) * ob->query_int());
  ob->add("potential", -1);
  ob->receive_damage("jingli", 10);
  ob->receive_damage("jing", 5);
  return 1;
}
