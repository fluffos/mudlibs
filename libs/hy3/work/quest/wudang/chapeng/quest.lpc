// 茶棚要查的quest

#include <ansi.h>
#define DIR			"east"

// 敲桌子
int do_knock(object objPlayer, object objWaiter, object objRoom, string arg) {
  object objObj;

  if (!arg || (arg != "desk" && arg != "table"))
    return notify_fail("你要敲什么？\n");
  if (!objPlayer || !objRoom || (objRoom != environment(objPlayer))) return 0;
  if (!objWaiter || (environment(objPlayer) != environment(objWaiter)))
    return notify_fail("你敲了敲桌子，却还是没人理你。你突然感觉一陈失落。\n");
  if (!objPlayer->query_temp("marks/wudang/chapeng/sit"))
    return notify_fail("你敲了敲桌子，所有的人都回头愕然地看着你，"
      + "\n你突然感觉自己很愚蠢。\n");
  if (objPlayer->query_temp("marks/wudang/chapeng/served")) {
    message_vision(CYN "小翠不耐烦地对$N说道：刚给你上过茶你接着就要，" +
      "你是个饭桶不是啊?！\n" NOR, objPlayer);
    return 1;
  }

  message_vision("$N端坐在桌前，轻轻扣了下桌面，小翠一甩小辩，过来招呼。\n", objPlayer);

  switch (random(3)) {
    case 0:
      objObj = new(__DIR__ "obj/dawancha");
      objObj->move(objRoom);
      message_vision("小翠搬出个大茶壶来，将桌上的大碗茶倒满。\n", objPlayer);
      break;
    case 1:
      objObj = new(__DIR__ "obj/xiangcha");
      objObj->move(objRoom);
      message_vision("小翠拿出个绍兴小茶壶，沏了杯香茶，放在桌上。\n", objPlayer);
      break;
    case 2:
      objObj = new(__DIR__ "obj/mitao");
      objObj->move(objRoom);
      message_vision("小翠拿出一碟新鲜的水蜜桃，放在桌上。\n", objPlayer);
      break;
  }
  objPlayer->set_temp("marks/wudang/chapeng/served", 1);
  call_out("delete_servedmark", 10, objPlayer);

  return 1;
}

void delete_servedmark(object objPlayer) {
  if (objectp(objPlayer))
    objPlayer->delete_temp("marks/wudang/chapeng/served");
  return;
}

// 坐椅子
int do_sit(object objPlayer, object objRoom, string arg) {
  if (!objPlayer || !objRoom || (objRoom != environment(objPlayer)))
    return 0;
  if (!arg || (arg != "chair"))
    return notify_fail("你要坐什么上面？\n");
  if (objPlayer->query_temp("marks/wudang/chapeng/sit"))
    return notify_fail("你已经有了个座位了。\n");

  objPlayer->set_temp("marks/wudang/chapeng/sit", 1);
  return notify_fail("你找了个空位座下，等着上茶。\n");
}

//离开茶棚
int leave(object objPlayer, object objRoom, string dir) {
  if (!objPlayer || !objRoom || (objRoom != environment(objPlayer))) return 1;
  if ((dir == DIR)
    && (present("xiang cha", objPlayer) || present("mi tao", objPlayer))
    && present("xiao cui", environment(objPlayer)))
    return 0;
  objPlayer->delete_temp("marks/wudang/chapeng/sit");
  return 1;
}
