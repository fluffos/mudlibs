// By yfeng 14/10/99
// 南岩宫三清像可以拜，加正气0-5K
#include <ansi.h>

int bai_sanqing(object ob) {
  if (ob->query("shen") < 0)
    return notify_fail("你拜他们干什么？跟咱们不是一路的。\n");
  if (ob->query("shen") > 5000) {
    message_vision(HIC "$N对着三清像拜了几拜，结果觉得不满意，又拜了几拜，只听“咚”的一声，把头磕破了。\n" NOR, ob);
    ob->receive_damage("jingli", 30);
    return 1;
  }
  if (MONEY_D->player_pay(ob, 1000 + random(1000)) == 2) {
    message_vision(HIC "$N拜完三清像后，想捐点钱，结果翻了半天，也没找出一文钱。\n", ob);
    message_vision("$N的脸唰的一下红了起来。\n", ob);
    return 1;
  }
  ob->add("shen", random(200) + 200);
  ob->receive_damage("jingli", 3);
  return 1;
}
