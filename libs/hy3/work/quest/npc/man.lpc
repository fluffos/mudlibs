#include <ansi.h>
inherit NPC;
int ask_me();
void create() {
  set_name("无名居士", ({ "noname", "man" }));
  set("title", HIW "一代宗师" NOR);
  set("long",
    "他就是无名居士，没有人知道他的来历。\n"
    "如果你想做盟主，你可以问问他关于mengzhu的事.\n"
  );
  set("age", 57);
  set("class", "beggar");
  set("attitude", "friendly");
  set("str", 70);
  set("int", 40);
  set("con", 40);
  set("dex", 70);
  set("is_quest", 1);
  set("max_qi", 9999);
  set("max_jing", 9999);
  set("combat_exp", 3000000);
  set("score", 50000);
  set_skill("strike", 500);
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("literate", 200);

  set("inquiry", ([
    "mengzhu": (: ask_me :),
    "盟主": (: ask_me :),
  ]));
  setup();
}

int ask_me() {
  if (this_player()->query("combat_exp") < 1500000)
    tell_object(this_player(), "无名居士说道：你经验太低，想要做盟主，必死无疑！\n");
  else {
    tell_object(this_player(), "无名居士说道： 好吧，里面危险重重，千万别乱来，否则有生命危险。自己小心吧！\n");
    this_player()->move("/d/biwu/hole");
  }
  return 1;
}

void init() {
  add_action("do_identify", "identify");
  add_action("do_kill", "team kill");
  add_action("do_kill", "kill");
  add_action("do_kill", "hit");
  add_action("do_kill", "fight");
  add_action("do_kill", "touxi");
  add_action("do_kill", "steal");
  add_action("do_kill", "beg");
  add_action("do_kill", "persuade");
}

int do_identify(string arg) {
  object me = this_player(), ob, gold;
  string *prop = ({}), str, id;
  int *equip = ({});
  mapping prop_list;
  int i, num;

  if (!arg) return notify_fail("你要鉴定什么物品？\n");

  if (!objectp(ob = present(arg, me)))
    return notify_fail("你身上没有这样东西？\n");

  if (!ob->query("owner_id") || ob->query("owner_id") != me->query("id"))
    return notify_fail("你这个东西来得有点蹊跷，我可不敢给你鉴定！\n");

  if (!objectp(gold = present("gold", me)) || !gold->query("money_id") ||
    gold->value() < 100000)
    return notify_fail("你身上的钱不够了！\n");

  gold->add_amount(-10);

  if (!mapp(prop_list = ob->query("prop")))
    return notify_fail("这东西没有鉴定的必要！\n");

  prop = keys(prop_list);

  str = HIR "物品经过鉴定，拥有如下属性：\n" NOR;

  if (ob->query("equipped")) ob->unequip();
  if (sizeof(prop) > 0)
    for (i = 0; i < sizeof(prop); i++) {
      str += HIC "    " + prop[i] + ":     " + prop_list[prop[i]] + "\n" NOR;
      ob->set("armor_prop/" + prop[i], (int)prop_list[prop[i]]);
    }
  ob->set("value", ob->query("rate") * ob->query("value"));
  ob->delete("rate");
  ob->delete("prop");
  ob->setup();
  write(str + "\n");
  num = 0;
  id = geteuid(me);
  if (stringp(id)) {
    equip = me->query("equip/" + ob->query("armor_type"));
    if (!equip) equip = ({});

    if (sizeof(equip) > 0) {
      for (i = 0, num = 0; i <= sizeof(equip); i++) {
        num++;
        if (member_array(num, equip) == -1)
          break;
      }
    }

    if (num == 0) num = 1;
    ob->set("num", num);
    ob->save();
    equip += ({ num });
    me->set("equip/" + ob->query("armor_type"), equip);
    me->save();
  }
  return 1;
}

int do_kill(string arg) {
  string what, who;
  if (!arg) return 0;
  if (this_object()->id(arg)) {
    write("你不是我对手，不要送死了。\n");
    return 1;
  } else if (sscanf(arg, "%s from %s", what, who) == 2 && this_object()->id(who)) {
    write("还是到别处去施展你的本事吧。\n");
    return 1;
  }
  return 0;
}
