#include <ansi.h>

inherit ROOM;

void create()
{
         set("short", "火云山庄-游戏楼楼");
 	set("long", @LONG
								
    这里是火云山庄游戏楼。
LONG
	);

	// set("outdoors", "taishan");

 	set("exits", ([
                  "down"   : "/d/room/chat_room",
                  "enter"  : "/quest/game/01"
	]));

        set("objects", ([
                __DIR__"npc/master-wqa": 1,
 	]) );

	setup();

	// replace_program(ROOM);
}

int valid_leave(object me,string dir)
{
        if ( dir == "enter" ) {

/*		// Key: 1999-03-01 没必要
                tell_object(this_player(), "梦灵点了点头对你说道："
                        "“你想去火云山庄的梦幻时空吗？这里就是啊。”\n");
*/
                tell_object(this_player(), "火云神灵对你说："
                          "“记得用 go 向前走，用 who -d 查看，用 qt 回来啊。”\n\n");

                // this_player()->move("/d/wqa/01");

                // 以此为加入的标志
                this_player()->set_temp("wqa's room/flag", 1);
        }
        
        return ::valid_leave(me, dir);
}
