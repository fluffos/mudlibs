// linzhennan.c 林震南   
//writed by xingyun 2001.5.26
inherit NPC; 
#include <ansi.h>  
#include "biao.h"

string ask_biaodui();
string ask_yunbiao();
void create()
{
        set_name("林震南", ({ "lin zhennan", "lin"}));
        set("gender", "男性");
        set("age", 65);
        set("title", HIY"福威镖局总镖头"NOR);
        set("long", "他就是福威镖局总镖头－－林震南。\n");
        set("combat_exp", 30000);
        set("shen_type", 1);
        set("max_neili", 500);
        set("neili", 500);
        set("jiali", 10);
        set_skill("force", 40);
        set("per",19);
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_skill("parry", 50);
        set("inquiry", ([     
                "运镖" : (: ask_yunbiao :),
                "镖队" : (: ask_biaodui :),  
        ]) );

        set("no_clean_up",1);
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/damage", 15);
        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/misc/cloth")->wear();
}

string chinese_time(int t)
{
        int d, h, m, s;
        string time;
        s = t % 60;     t /= 60;
        m = t % 60;     t /= 60;
        h = t % 24;     t /= 24;
        d = t;
        if(d) time = chinese_number(d) + "天";
        else time = "";
        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";    
        time += chinese_number(s) + "秒";
        return time;
}

string ask_yunbiao()
{
    int time;
    object me,biaoche;
    mapping biao;

    me=this_player();

    if ( me->query_temp("quest_yunbiao/have_task"))
       return "你上次的镖还没送到呢，怎么又来了？\n"; 

    if ( me->query_temp("quest_yunbiao/finished_time")
        && (time()-me->query_temp("quest_yunbiao/finished_time"))<60)
       return RANK_D->query_respect(me)
               +"辛苦了，现在没有镖车要运，过会再来吧！\n";

    if( me->query("quest_yunbiao") 
        && !me->query_temp("quest_yunbiao/finished_time")
       && (time()-me->query("quest_yunbiao/start_time"))<600)
       return "你把我的镖弄哪里去啦？不是被人劫了吧？\n";

    if( me->query("combat_exp")<100000)
      return "运镖可是件危险的差使，还是练好了功夫再来吧！\n";    

    biao=yun_biao[random(sizeof(yun_biao))];
    time=biao["time"];
    me->set("quest_yunbiao/name",biao["name"]); 
    me->set("quest_yunbiao/file",biao["file"]); 
    me->set("quest_yunbiao/bonus",biao["bonus"]);  
    me->set("quest_yunbiao/time",biao["time"]); 
    me->set("quest_yunbiao/start_time",time());
    me->set_temp("quest_yunbiao/have_task",1);

    biaoche=new(__DIR__"biaoche");
    biaoche->set("time",time);
    biaoche->set("file",biao["file"]);      
    biaoche->start_escape_me();
    biaoche->set("owner",me->query("id"));
    biaoche->set("owner_name",me->query("name"));   

    if( !biaoche->move(environment(me)) )  
    biaoche->move(environment(me));

     message("channel:rumor",HIY"【镖局传闻】"+me->query("name")
     +"即将护送镖车起程前往"+biao["name"]+"！\n"NOR,users());  

     me->delete_temp("apply/short");
     me->set_temp("apply/short", 
       ({HIY"福威镖局镖头  "NOR+me->name()+"("+me->query("id")+")"})); 

    return HIW"请在"+chinese_time(time)+"内，将镖车运送到"
          +biao["name"]+"。\n一路多加小心，你还是趁早上路吧！\n"NOR;
}

string ask_biaodui()
{
    int time,i;
    object me,parter,biaoche,*team;
    mapping biao;

    me=this_player();

    if( !pointerp(team = me->query_team()))
       return "镖队需要人多一点才有保障，多叫些人手来吧！\n";

    i=sizeof(team);
    if(i>2) return "人多手杂，容易坏事！\n";
    if(i<2) return "镖队需要两个人才行！\n";
    if( objectp(team[0]) && objectp(team[1]))
    {
     if(team[0]==me) parter=team[1];
     else parter=team[0];
    }

    if( !objectp(parter) 
        || !present(parter->query("id"),environment(me)))
       return "还是约上你的同伴一起来吧！\n";

    if ( me->query_temp("quest_yunbiao/have_task"))
       return "你们上次的镖还没送到呢，怎么又来了？\n";

    if( me->query("quest_yunbiao")
        && !me->query_temp("quest_yunbiao/finished_time")
       && (time()-me->query("quest_yunbiao/start_time"))<600)
       return "你把我的镖队弄丢了，居然还有脸回来见我？\n";

    if( parter->query("quest_yunbiao")
        && !parter->query_temp("quest_yunbiao/finished_time")
       && (time()-me->query("quest_yunbiao/start_time"))<600)
       return "你找这样无能的同伴当帮手，我可不放心把镖队交给你！\n";

    if( me->query("combat_exp")<100000)
      return "运镖可是件危险的差使，还是练好了功夫再来吧！\n";

    if( parter->query("combat_exp")<100000)
      return "运镖可是件危险的差使，不要让你的同伴去送死了！\n";

    biao=yun_biao[random(sizeof(yun_biao))];
    time=biao["time"];
    me->set("quest_yunbiao/name",biao["name"]);
    me->set("quest_yunbiao/file",biao["file"]);
    me->set("quest_yunbiao/bonus",biao["bonus"]);
    me->set("quest_yunbiao/time",biao["time"]);
    me->set("quest_yunbiao/start_time",time());
    me->set_temp("quest_yunbiao/have_task",1);

    parter->set("quest_yunbiao/name",biao["name"]);
    parter->set("quest_yunbiao/file",biao["file"]);
    parter->set("quest_yunbiao/bonus",biao["bonus"]);
    parter->set("quest_yunbiao/time",biao["time"]);
    parter->set("quest_yunbiao/start_time",time());
    parter->set_temp("quest_yunbiao/have_task",1);

    biaoche=new(__DIR__"da_biaoche");
    biaoche->set("time",time);
    biaoche->set("file",biao["file"]);
    biaoche->start_escape_me();
    biaoche->set("owner",me->query("id"));
    biaoche->set("parter",parter->query("id"));
    biaoche->set("owner_name",me->query("name"));

    if( !biaoche->move(environment(me)) )  
    biaoche->move(environment(me));

    message("channel:rumor",HIY"【镖局传闻】"+me->query("name")
     +"率领的镖队即将起程前往"+biao["name"]+"！\n"NOR,users());

    me->delete_temp("apply/short");
    me->set_temp("apply/short",
    ({HIY"福威镖局镖头  "NOR+me->name()+"("+me->query("id")+")"}));

    parter->delete_temp("apply/short");
    parter->set_temp("apply/short",
    ({HIY"福威镖局镖师  "NOR+parter->name()+"("+parter->query("id")+")"}));

    return HIW"请在"+chinese_time(time)+"内，将镖队护送到"
          +biao["name"]+"。\n一路多加小心，你们还是趁早上路吧！\n"NOR;
}

