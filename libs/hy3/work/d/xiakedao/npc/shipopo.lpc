// shipopo.c 史婆婆
inherit NPC;
void create()
{
        set_name("史婆婆", ({ "shi popo","shi", "popo" }));
        set("title", "金乌派掌门人");
        set("gender", "女性");
        set("long", "她是雪山派掌门人白自在的妻子，虽说现在人已显得苍老，\n"
        "但几十年前提起“江湖一枝花”史小翠来，武林中却是无人不知。\n");
        set("age", 68);
        set("dex",200); 
        set("int", 30);
        set("str",200);
        set("con",200);
        set("qi", 50000);
        set("max_qi", 50000);
        set("jing", 20000);
        set("max_jing", 20000);
        set("neili", 400000);
        set("max_neili", 400000);  
        set("jiali",400);  

        set("shen_type", 1);
        set("combat_exp", 17500000);

        set_skill("force", 500);
        set_skill("dodge", 480);
        set_skill("blade", 500);
        set_skill("parry", 480);
        set_skill("unarmed", 500);
        set_skill("snowstep", 480);
        set_skill("snow-zhang", 500);
        set_skill("jinwu-blade", 480);
        set_skill("bingxue-xinfa", 500);

        map_skill("blade", "jinwu-blade");    
        map_skill("parry", "jinwu-blade");  
        map_skill("force", "bingxue-xinfa");
        map_skill("dodge", "snow-step");
        map_skill("unarmed", "snow-zhang"); 

        set("chat_chance_combat",60);
        set("chat_msg_combat",({
              (: perform_action,   "blade.jinwu" :),
              (: perform_action,   "unarmed.yanxue" :),
              (: exert_function,   "powerup" :)
        }));                                 

        add_temp("apply/attack", 500);
        add_temp("apply/defense", 500);
        add_temp("apply/damage", 500);   
        add_temp("apply/armor", 500); 

        setup();
        carry_object("/clone/weapon/gangdao")->wield();
        carry_object("/clone/misc/cloth")->wear();      
}

