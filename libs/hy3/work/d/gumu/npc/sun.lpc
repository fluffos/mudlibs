// sun.c 孙婆婆
#include "/quest/quest.h"

#include <ansi.h>

inherit NPC;

void create() {
  set_name("孙婆婆", ({ "sun popo", "sun" }));
  set("gender", "女性");
  set("age", 55);
  set("long",
    "这是一位慈祥的老婆婆，正看着你微微一笑。\n"
  );
  set("attitude", "friendly");

  set("qi", 3200);
  set("max_qi", 3200);
  set("jing", 1200);
  set("max_jing", 1200);
  set("neili", 4500);
  set("max_neili", 4500);
  set("jiali", 40);
  set("combat_exp", 1500000);

  set_skill("force", 210);
  set_skill("yunu-xinjing", 210);
  set_skill("sword", 210);
  set_skill("yunu-jianfa", 180);
  set_skill("dodge", 220);
  set_skill("yunu-shenfa", 210);   //玉女身法
  set_skill("parry", 220);
  set_skill("unarmed", 180);
  set_skill("meinu-quanfa", 180);    //美女拳法
  set_skill("literate", 100);

  map_skill("force", "yunu-xinjing");
  map_skill("sword", "yunu-jianfa");
  map_skill("dodge", "yunu-shenfa");
  map_skill("parry", "meinu-quanfa");
  map_skill("unarmed", "meinu-quanfa");

  create_family("古墓派", 2, "弟子");

  set("inquiry", ([
    "小龙女": "龙姑娘是我一手带大的，她从小没了父母，现在又独个儿住在这古墓里，唉..\n",
  ]));

  set("env/wimpy", 50);
  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("clone/misc/cloth")->wear();

}
