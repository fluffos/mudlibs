//xln.c 小龙女
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_suo();
string ask_zhen();
string ask_jiang();
void create() {
  set_name("小龙女", ({ "xiao longnu", "xiao", "longnu" }));
  set("title", "古墓侠侣");
  set("nickname", HIC "玉女素心" NOR);
  set("long", "她清丽异常，但也许是长居古墓之故，面色略白。\n");
  set("gender", "女性");
  set("age", 39);
  set("attitude", "friendly");
  set("per", 40);
  set("str", 24);
  set("dex", 23);
  set("con", 20);
  set("int", 24);
  set("shen", 20000);
  set_skill("sword", 450);
  set_skill("strike", 450);
  set_skill("quanzhen-jianfa", 200);
  set_skill("parry", 450);
  set_skill("hubo", 300);
  set_skill("force", 460);
  set_skill("dodge", 480);
  set_skill("sword", 450);
  set_skill("throwing", 350);
  set_skill("whip", 450);
  set_skill("meinu-quanfa", 420);
  set_skill("cuff", 450);
  set_skill("yunu-shenfa", 460);
  set_skill("yinsuo-jinling", 450);
  set_skill("literate", 420);
  set_skill("yunu-jianfa", 450);
  set_skill("yunu-xinjing", 450);
  set_skill("tianluo-diwang", 400);
  set_skill("yufeng-zhen", 400);

  map_skill("throwing", "yufeng-zhen");
  map_skill("strike", "tianluo-diwang");
  map_skill("force", "yunu-xinjing");
  map_skill("dodge", "yunu-shenfa");
  map_skill("cuff", "meinu-quanfa");
  map_skill("sword", "yunu-jianfa");
  map_skill("whip", "yinsuo-jinling");
  prepare_skill("cuff", "meinu-quanfa");
  set("jiali", 200);
  create_family("古墓派", 3, "女主人");
  set("combat_exp", 8000000);
  set("max_qi", 8000);
  set("max_jingli", 12000);
  set("jingli", 12000);
  set("max_jing", 6000);
  set("neili", 25000);
  set("max_neili", 20000);
  set("eff_jingli", 6000);

  set("inquiry", ([
    "杨过": "过儿是我夫君，我知道他很爱我，可一直呆在这真怕他会闷。",
    "李莫愁": "她是我师姐，不过我已经派人去清理门户了。", "钥匙": "嗯....这我可记不清楚，好象是放在古墓里面了吧。",
    "银索": (: ask_suo :),
    "玉蜂针": (: ask_zhen :),
    "玉蜂浆": (: ask_jiang :),
  ]));
  set("zhen_count", 2);
  setup();

  carry_object("/d/gumu/obj/yinsuo")->wield();
  carry_object("/d/gumu/obj/buxue1")->wear();
  carry_object("/d/gumu/obj/qun1")->wear();
}

void attempt_apprentice(object ob) {
  mapping fam = ob->query("family");
  if (!fam || fam["family_name"] != "古墓派") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if (ob->query("family/master_id")) {
    command("say " + RANK_D->query_respect(ob)
      + "已经另有名师了，还来找我做甚？\n");
    return;
  }
  if ((int)ob->query_skill("yunu-xinjing", 1) < 120) {
    command("say 我古墓武功内功是基础。");
    command("say " + RANK_D->query_respect(ob) + "是否还应该先在内功上多下点功夫？");
    return;
  }
  if ((int)ob->query_skill("sword", 1) < 100) {
    command("say 你剑法这么差，我教的你不一定学得会。");
    command("say " + RANK_D->query_respect(ob) + "是否还应该在剑法上多下点功夫？");
    return;
  }
  if (ob->query_int() < 32) {
    command("say 我的武功都要极高的悟性才能学会。");
    command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");
    command("say 这位" + RANK_D->query_respect(ob) + "的悟性还大有潜力可挖，还是请回吧。");
    return;
  }
  if (ob->query("gender") != "女性") {
    command("say 我可只收女徒，你去找我夫君试试吧。");
    return;
  }
  command("say 嗯，看你还是个学武的料，我就收下你吧！");
  command("recruit " + ob->query("id"));
  ob->set("title", "古墓派神雕侠侣传人");
  ob->set("class", "sworder");
}

string ask_suo() {
  object ob = this_player(), suo;
  mapping fam = ob->query("family");
  if (!fam || fam["family_name"] != "古墓派" || ob->query("family/master_name") != "小龙女")
    return RANK_D->query_respect(ob) + "，我已经多年未用银索了，也不知道放在何处了。";
  if (ob->query_skill("yinsuo-jinling", 1) < 100)
    return "这位" + RANK_D->query_respect(ob) + "，银索灵活异常，你是否应该把武功练高些？";

  if (!objectp(suo = present("yinsuo jinling", this_object())))
    return "你来晚了，银索已经不在我身上了！\n";
  else
    suo->move(ob);
  return "好吧，银索就先借你用了，记得还给我。";
}

string ask_zhen() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family"))
    || fam["family_name"] != "古墓派")
    return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
  if (present("yufeng zhen", this_player()))
    return "你身上已经有玉蜂针了，怎么又来要了？\n";
  ob = new("/d/gumu/obj/yfzhen.lpc");
  ob->move(this_player());
  return "你如此自愿为师门清理门户，不枉我平时一番栽培，这些玉蜂针你就拿去吧。";
}

string ask_jiang() {
  mapping fam;
  object ob, me = this_player();

  if (!(fam = me->query("family")) || fam["family_name"] != "古墓派")
    return RANK_D->query_respect(me) + "与本派素无来往，不知此话从何谈起？\n";

  if (present("yufeng jiang", me))
    return "你身上已经有玉蜂浆了，怎么又来要了？\n";

  ob = new("/d/gumu/obj/yufengjiang");
  ob->move(me);
  return "好吧，这瓶玉蜂浆就给你吧。\n";
}

void leave() {
  message("vision", name() + "失望的看了看，伤心的走了。\n", environment(), this_object());
  destruct(this_object());
}

void relay_whisper(object me, string msg) {
  if (query("owner_id") != me->query("id")) {
    message_vision((string)this_object()->query("name")
      + "对着$N冷哼了一声。\n", me);
    return;
  }

  message_vision((string)this_object()->query("name") + "对着$N点了点头。\n", me);
  if (msg) {
    remove_call_out("relaying");
    call_out("relaying", 1 + random(3), msg);
  }
}

void relaying(string msg) {
  command(msg);
}

void init() {
  object me = this_player();
  object owner;

  ::init();

  if ((string)this_object()->query("owner_id") == (string)me->query("id")) {
    this_object()->set_leader(me);
  }

  if (this_object()->query("owner_id") != 0) {
    owner = find_player((string)this_object()->query("owner_id"));
    if (!owner) owner = find_living((string)this_object()->query("owner_id"));
    if (!owner) {
      remove_call_out("leave");
      call_out("leave", 1);
    }
  }
}
