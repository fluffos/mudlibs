#include <ansi.h>;
inherit ITEM;
inherit F_FOOD;
void create() {
  set_name(HIY "玉蜂浆" NOR, ({ "yufeng jiang", "jiang" }));
  set_weight(25);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "瓶");
    set("long", "一瓶精制玉蜂浆，清香扑鼻。\n");
    set("value", 0);
    set("no_put", 1);
    set("food_remaining", 1);
    set("food_supply", 50);
    set("poison_count", 20);
    setup();
  }
}

void init() {
  add_action("do_use", "tu");
}

int do_use(string arg) {
  object me = this_player(), ob = this_object();

  if (!arg || (arg != "yufeng jiang" && arg != "jiang"))
    return 0;

  if (!ob->query("poison_count")) {
    write("玉蜂浆已经用完了！\n");
    destruct(ob);
    return 1;
  }

  if (!me->query_condition("yufeng_poison")) {
    write("你现在不需要玉蜂浆解毒。\n");
    return 1;
  }

  message_vision(HIY "$N仔细地将玉蜂浆涂在玉蜂蛰咬的伤口上，只觉得遍体"
    + "清凉，麻氧立止！\n" NOR, me);
  me->clear_condition("yufeng_poison");
  ob->add("poison_count", -1);
  return 1;
}
