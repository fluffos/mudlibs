#include <ansi.h>
#include <room.h>

int discmds();
inherit ROOM;

void create()
{
        set("short",HIB " 火云会议室 " NOR);
        set("long", 
  ""HIC"  这里便是火云录巫师组开会的地方，有很多决策都在这里经过讨"
""HIC"论而决定,\n 所有进程都在这里体现.看着眼前"HIM"“ 会议室”"NOR
""HIC"三个朱色大字，给人一种庄严的感觉，你不知不觉加快了脚步。"NOR"\n\n\n"
  "\n"HIY"                    ☆"HIM"      会          议           室          "HIY"☆"NOR"\n\n\n\n\n\n\n"
        );


         set("objects",([
            
           ]));
         set("exits",([
        "west" : __DIR__"wizard_room",
          ]));
         set("no_sleep", 1);
         set("valid_startroom",1);
         set("no_fight",1);
         set("no_steal",1);
         setup(); 
         call_other("/clone/board/wizard_j", "???"); 
                             
}

void init()
{
    if(!wizardp(this_player())) {
        "/cmds/std/look"->look_room(this_player(),this_object());
// this_player()->set("startroom", __FILE__);
       add_action("discmds",({"es","quit","goto","home","summon","kickout","dest","snoop","sleep","kill","fight","hit","chat","chat*","rumor","rumor*","tell","reply","to","new","new*"}));
        }
}

int discmds()
{
        tell_object(this_player(),"现在正在开会，你要去哪里?\n");
        return 1;

}

