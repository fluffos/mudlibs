inherit ROOM;

void create() {
  set("short", "湖边");
  set("long", @LONG

湖面绿波上飘着一叶小舟，一个绿衫少女手执双桨，缓缓划水而来，手里
正忙着采莲（lotus），口中唱着小曲，听那曲子是：“采莲南塘秋，莲花
过人头，低头弄莲子，莲子清如水。”湖中荷花是看不着了，但还留着一
塘绿油油的荷叶。湖对岸有个阁子，想要过去恐怕只有借助这一塘荷叶了。

LONG);

  set("item_desc", ([ /* sizeof() == 1 */
    "lotus": "荷花已经谢了，莲梗上孤零零的吊着莲蓬。
",
  ]));

  set("exits", ([ /* sizeof() == 1 */
  ]));

  setup();
}

void init() {
  add_action("do_cai", "cai");
  add_action("do_fly", "piao");
}

int do_cai(string arg) {
  object me = this_player();
  object m;

  if ((!arg) || !((arg == "lotus") || (arg == "lian")))
    return notify_fail("采什么？\n");
  message_vision("$N见那莲蓬诱人，便伸手去摘．\n", me);
  if (me->query("qi") < (int)(me->query("max_qi") / 3))
    return notify_fail("您先歇歇吧，别那么馋:)\n");

  else if (random(6) < 2) {
    message_vision("$N脚下一滑，扑通一声掉进了莲花池．\n", me);
    me->move(__DIR__ "hudi");
    return 1;
  } else if (me->query("gender") == "男性")
    return notify_fail("你突然意识到采莲不免有失英雄本色，不禁又把手缩了回来\n");
  else {
    if ((int)me->query_skill("moondance", 1) < 60) {
      me->improve_skill("moondance", 40 - me->query("str"));
      message_vision(
        "$N试着运用所学的轻功纵身跳上荷叶，发现不妙又敢紧跳了回来．\n", me);
      tell_object(me, "你领悟出一些暗影浮香的技巧。\n");
      this_player()->start_busy(1);
    } else {
      message_vision("$N双脚在莲叶上一点，身子轻轻在水上掠过，回来时手中已多了一只莲蓬。\n", me);
      if (sizeof(all_inventory(this_player())) > 30)
        tell_object(me, "可是你身上已经装不下了。\n");
      else {
        m = new(__DIR__ "obj/lianzi.lpc");
        m->move(this_player());
        this_player()->start_busy(1);
      }
    }
  }
  me->receive_damage("qi", 20);
  return 1;
}

int do_fly(string arg) {
  object me;
  me = this_player();
  if ((int)me->query_skill("anying-fuxiang", 1) < 80) {
    message_vision("$N念动真言，使开暗影浮香中的“燕子三抄水”，飞身踏入莲池中！
结果才迈开几步，就“扑通”一声掉进了水中。\n", me);
  } else {
    message_vision("
$N念动真言，使开暗影浮香中的“燕子三抄水”，飞身踏入莲池中！
只见$N轻轻踏着水波上的莲叶，以轻灵无比的身法，向莲池对岸的
飘飞而去。

\n", me);
    me->move("/d/taohua/hubian2");
    tell_room(environment(me), "莲池中飘来一条黑影，仔细一看原来是" + me->name() + "。
", ({ me }));
  }
  return 1;
}
