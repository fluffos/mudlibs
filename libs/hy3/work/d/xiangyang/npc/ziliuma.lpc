#include <ansi.h>
inherit NPC;
inherit F_RIDDING;

void create() {
  set_name(MAG "紫骝马" NOR, ({ "ziliu ma", "horse", "ma" }));
  set("race", "野兽");
  set("age", 3);

  set("combat_exp", 500000);
  set("long",
    "一匹高头大马，全身紫色的毛发，煞是温驯可爱。\n");

  set("limbs", ({ "头部", "身体", "蹄子", "尾巴" }));
  set("limbs", ({ "头部", "身体", "蹄子", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("str", 20 + random(10));
  set("con", 20 + random(5));
  set("dex", 20 + random(5));
  set("age", 20 + random(30));

  set_temp("apply/attack", 3);
  set_temp("apply/defense", 5);
  set_temp("apply/armor", 1);

  set("ride_prop/dodge", 40);
  set("ride_prop/defense", 40);
  set("ride_prop/defense", 40);

  set("no_get", 1);
  set("no_drop", 1);
  set("no_put", 1);

  set("chat_chance", 5);
  set("chat_msg", ({
    MAG "紫骝马轻轻甩着尾巴，一付温驯的样子。\n" NOR,
  }));

  setup();
}
