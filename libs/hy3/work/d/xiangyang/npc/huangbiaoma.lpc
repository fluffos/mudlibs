#include <ansi.h>
inherit NPC;
inherit F_RIDDING;   

void create()
{
        set_name(HIY"黄膘马"NOR, ({"huangbiao ma", "horse", "ma"}));
        set("race", "野兽");
        set("age", 3);

        set("combat_exp", 500000);
        set("long", 
                "一匹高头大马，全身毛发略带金黄，煞是可爱。\n");

        set("limbs", ({ "头部", "身体", "蹄子", "尾巴" }) );
        set("limbs", ({ "头部", "身体", "蹄子", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );

        set("str", 20+random(10));
        set("con", 20+random(5));
        set("dex", 20+random(5));
        set("age", 20+random(30));   
 
        set_temp("apply/attack", 3);
        set_temp("apply/defense", 5);
        set_temp("apply/armor", 1);

        set("ride_prop/dodge",40);
        set("ride_prop/defense",40);
        set("ride_prop/defense",40);

        set("no_get",1);
        set("no_drop",1);
        set("no_put",1);

        set("chat_chance", 5);
        set("chat_msg", ({
              YEL"黄膘马呼哧呼哧，不住打着响鼻。\n"NOR,
        }) );

        setup();
}

