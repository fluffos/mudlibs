// xiaoyaosan.c 三笑逍遥散
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(BLU "三笑逍遥散" NOR, ({ "sanxiao san", "san" }));
  set("long", "这就是三笑逍遥散，星宿三宝之一。\n");
  set_weight(10);
  set("unit", "份");
  set("no_get", 1);
  set("no_put", 1);
  set("no_drop", 1);
  setup();
}

void init() {
  add_action("do_take", "take");
  add_action("do_throw", "tan");

}

int do_take(string arg) {

  object me = this_player(), san;

  if (!arg || (arg != "san" && arg != "sanxiao san")) {
    tell_object(me, "你要捡起什么？\n");
    return 1;
  }

  if (!objectp(san = present("sanxiao san", environment(me)))) {
    tell_object(me, "你附近没有这样东西。\n");
    return 1;
  }

  if ((string)me->query("family/family_name") != "星宿派") {
    message_vision("$N拿起一份三笑逍遥散。\n", me);
    me->apply_condition("xys_poison", 10);
    destruct(san);
    return 1;
  } else {
    if (me->query_skill("huagong-dafa", 1) >= 70) {
      message_vision("$N大袖一卷，劲风过处，三笑逍遥散已尽数收入袖中。\n", me);

      san->move(me);
      return 1;
    } else
      return notify_fail("三笑逍遥散你也敢碰，活的不耐烦了呀！？\n");
  }

}

int do_throw(string arg) {
  string ob, who;
  object me = this_player();
  object target;
  object obj = this_object();

  if (!arg || sscanf(arg, "%s on %s", ob, who) != 2)
    return 0;
  if (obj != present(ob, me)) return 0;

  if (!objectp(target = present(who, environment(me))) || !target->is_character())
    return notify_fail("你想对谁使用三笑逍遥散？\n");

  if (target == me)
    return notify_fail("别这么想不开嘛。\n");

  if ((target->query("is_quest") || target->query("is_robber"))
    && !target->is_fighting(me))
    return notify_fail("那是江湖人物，别惹事生非了。\n");

  if (userp(target) && target->query("age") < 18)
    return notify_fail("人家还是孩子呢，别以大欺小。\n");

  if (me->is_busy())
    return notify_fail("你正忙着呢!\n");

  if (environment(me)->query("no_fight"))
    return notify_fail("这里不许战斗!\n");

  if (me->query("family/family_name") != "星宿派")
    return notify_fail("你不是星宿派弟子，不会使用三笑逍遥散。\n");

  if (me->query_skill("throwing", 1) < 150)
    return notify_fail("你还是先学学基本暗器吧。\n");

  if ((int)me->query("neili") < 2000)
    return notify_fail("你的内力不够摧迫逍遥三笑散毒！\n");


  if (random(me->query_skill("huagong-dafa", 1) + me->query_skill("beiming-zhenqi", 1)) * 2 / 3
    > random(target->query_skill("force", 1)))

  {
    tell_object(me, HIW "你不动声色，大袖微扬，潜运内力，将“逍遥三笑散”毒粉向"
      +target->name() + "挥去。\n" NOR);

    if (random((int)me->query("neili")) > (int)target->query("neili") / 4)
      target->apply_condition("xys_poison", 10);
    else {
      message_vision(HIM "$N大袖一挥，将“逍遥三笑散”毒粉"
        + "反向$n弹击回来。\n" NOR, target, me);
      me->apply_condition("xys_poison", 10);
    }
  } else {
    message_vision(BLU "$N潜运内力，将“逍遥三笑散”毒粉向$n弹了过去，"
      + "可是被$n闪身躲开了。\n" NOR, me, target);
    target->kill_ob(me);
  }

  me->start_busy(8 + random(6));
  me->add("neili", -120);
  destruct(obj);
  return 1;
}
