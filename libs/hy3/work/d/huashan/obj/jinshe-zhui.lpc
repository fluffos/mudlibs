#include <weapon.h>
#include <ansi.h>
inherit THROWING;
void create() {
  set_name(HIY "金蛇锥" NOR, ({ "jinshe zhui", "zhui" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把用黄金打造的金光闪闪的金蛇锥。\n");
    set("base_value", 10000);
    set("base_unit", "枚");
    set("base_weight", 1000);
    set("wield_msg", "$N从皮囊中掏出一把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n放回皮囊中。\n");
  }
  set_amount(12);
  init_throwing(50, 2);
  setup();
}
