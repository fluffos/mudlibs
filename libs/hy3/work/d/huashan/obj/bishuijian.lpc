// bishuijian.c
// for 岳灵珊
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
inherit F_UNIQUE1;
void create()
{
        set_name(HIG"碧水剑"NOR, ({ "bishuijian", "jian", "sword" }));
        set_weight(12000);         if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄"); 
                set("unique", 1);                set("long", "这是一口断金削铁的宝剑，它是岳灵珊十八岁生日时由\n"
                            "岳不群送给她作生日礼物的。\n");
                set("value", 800000);
                set("rigidity",200); 
                set("replica_ob","/d/city/npc/obj/changjian");
                set("no_steal",1);
                set("no_put",1);
                set("material", "steel");
                set("weapon_prop/personality", 15);
                set("wield_msg", "$N「唰」的一声抽出一柄寒光闪闪的$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
        }
        init_sword(300,2);
        setup();
}


