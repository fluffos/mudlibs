// 金蛇剑 writed by xingyun;
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;
void create() {
  set_name(HIY "金蛇剑" NOR, ({ "jinshe jian", "jian", "sword" }));
  set_weight(18000);

  if (violate_unique()) {
    write("你来迟了，" + query("name") + "已经被人拿走了！\n");
    create_replica();
    return;
  } else {
    if (clonep())
      set_default_object(__FILE__);
    else {
      set("unit", "柄");
      set("unique", 1);
      set("long", HIY +
        "这就是“金蛇郎君”夏雪宜当年威震江湖的金蛇剑了，剑身弯湾曲曲，\n
恍如一条游动的金蛇，剑间有两个倒钩，如同毒蛇的蛇芯，煞是诡异！\n");
      set("value", 800000);
      set("id_id", "jinshe jian");
      set("rigidity", 400);
      set("replica_ob", "/d/city/npc/obj/changjian");
      set("no_steal", 1);
      set("no_put", 1);
      set("material", "steel");
      set("wield_neili", 500);
      set("wield_maxneili", 1000);
      set("wield_str", 30);
      set("weapon_prop/personality", 15);
      set("wield_msg",
        HIY "只听「铮」地一声，$N手中已多了一柄寒光闪闪的——金蛇剑！\n" NOR);
      set("unwield_msg",
        HIW "$N「铮」地将手中的" HIY "金蛇剑" HIW "插回剑鞘。\n" NOR);
    }
    init_sword(400);
    setup();
  }
}
