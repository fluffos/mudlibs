#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("小铁盒", ({ "xiao tiehe","tiehe" })); 
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个一尺见方，一尺来高的铁盒子，入手
轻飘飘地，似是没有什么东西。\n");
                set("unit", "个" );
                set("value", 0);
                set("no_get",1);
        }

        setup();
}

void init()
{
        add_action("do_open","open");
}

int do_open(string arg)
{
        object me=this_player(),book,ob=this_object();

        if(!arg || arg!="xiao tiehe")
        return 0;

        message_vision(HIC"$N打开了小铁盒，这盒子一张笺上写道："
       +"「君是忠厚仁者，葬我骸骨，\n当酬以重宝秘术。大铁盒开启时有"
       +"毒箭射出，愈中书谱地图均假，上有剧毒，\n以惩贪欲恶徒。真者"
       +"在此小铁盒内。」几字。\n你得到了金蛇秘笈！\n\n"NOR,me);
        if(objectp(book=new(__DIR__"miji")))
        book->move(me);
        destruct(ob);
        return 1;
}

