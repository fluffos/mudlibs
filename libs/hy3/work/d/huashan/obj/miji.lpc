// 金蛇密笈 writed by xingyun;
#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name(HIC "金蛇密笈" NOR, ({ "jinshe miji", "miji" }));

  if (violate_unique()) {
    write("你来迟了，" + query("name") + "已经被人拿走了！\n");
    create_replica();
    return;
  } else {
    if (clonep())
      set_default_object(__FILE__);
    else {
      set("unit", "本");
      set("long", "这是一本金蛇郎君昔年所著的秘籍。\n");
      set("value", 0);
      set("no_get", 1);
      set("no_drop", 1);
      set("no_put", 1);
      set("no_sell", 1);
      set("no_steal", 1);
      set("unique", 1);
      set("replica_ob", "/clone/book/skin");
      set("material", "paper");
      set("skill", ([
        "name": "jinshe-jianfa",
        "exp_required": 1000000,
        "jing_cost": 20 + random(20),
        "difficulty": 20,
        "max_skill": 120
      ]));
    }
    setup();
  }
}
