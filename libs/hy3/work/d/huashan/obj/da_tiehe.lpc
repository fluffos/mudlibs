#include <ansi.h>
inherit ITEM;
void create() {
  set_name("大铁盒", ({ "da tiehe", "tiehe" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个两尺见方，一尺来高的铁盒子，入手
轻飘飘地，似是没有什么东西。\n");
    set("unit", "个");
    set("value", 0);
    set("no_get", 1);
  }

  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object me = this_player(), ob = this_object();

  if (!arg || arg != "da tiehe")
    return 0;

  message_vision(HIC "$N好奇心起，打开了大铁盒，这盒子竟浅得出奇，离底"
    + "仅有一寸，看来必有夹层。\n盒中只有一个信封，上书「得我盒者，开启"
    + "此盒」八字。\n" NOR, me);

  message_vision(HIC "$N用力扳开了铁盒子的夹层，忽然间数十支毒箭一齐射"
    + "出！你冥冥之中记起了\n「遇祸莫怨」几个字，眼前一黑，就什么也不知道"
    + "了......\n\n" NOR, me);
  me->die();
  destruct(ob);
  return 1;
}
