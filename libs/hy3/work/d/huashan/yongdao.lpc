inherit ROOM;

void create() {
  set("short", "山石");
  set("long", @LONG
    这是一块凸出在西峰绝壁上的山石，站在这儿正好可以够得着
绝壁上的那个小山洞。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "enter": __DIR__ "yongdao1",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_climb", "climb");
}

int do_climb(string arg) {
  object me = this_player(), room;

  if (!arg || arg != "up")
    return 0;

  room = load_object(__DIR__ "xifeng");

  if (!room->query("tied"))
    return notify_fail("山崖上的绳索已经被人解走了。 \n");

  message_vision("$N一手拉绳，“嗖”地一声窜了上去，"
    + "刹那间不见了影踪。\n", me);
  me->move(__DIR__ "xifeng");
  return 1;
}
