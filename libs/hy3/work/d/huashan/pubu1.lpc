// pubu.c

inherit ROOM;

void init();
int do_swim();

void create() {
  set("short", "练功室");
  set("long", @LONG
    这里是一处峡谷内部，四处空空的，真是一处练功的好地方啊！
你突发奇想。。。想到什么了呢？？？
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
  ]));
  set("objects", ([
    __DIR__ "npc/muren2": 4,
  ]));
  set("outdoors", "huashan");
  set("coor/x", 60);
  set("coor/y", 120);
  set("coor/z", 0);
  setup();
  set("resource/water", 1);
  set("no_clean_up", 0);


  set("coor/x", 60);
  set("coor/y", 120);
  set("coor/z", 0);
  setup();
  replace_program(ROOM);
}
void init() {
  add_action("do_swim", "swim");
}
int do_swim() {
  object me = this_player();
  message_vision("$N一个猛子扎入瀑布中．．．\n", me);
  me->move("/d/huashan/pubu");
  return 1;
}
