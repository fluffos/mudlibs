inherit ROOM;

void create()
{
        set("short", "金蛇洞");
        set("long", @LONG
    走出甬道，眼前豁然空阔，出现一个洞穴，便如是座石室。对面
石壁上斜倚着一副骷髅骨，骨头前面横七竖八的放着一些古怪形状的
暗器。石壁上有几百幅简陋的人形图画，尽头刻着十六个字：「重宝
秘术，付于有缘，入我门来，遇祸莫怨。」这十六个字旁，有个剑柄
凸出在石壁之上，似是一把剑插入了石壁，直至剑柄。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
                "south" : __DIR__"yongdao4",
        ]));

        set("objects", ([ /* sizeof() == 1 */
                __DIR__"obj/skeleton" :    1,
                __DIR__"obj/jinshe-zhui" :    1,   
        ]));     

        set("no_clean_up", 0);
        setup();
}

void init()
{
        add_action("do_dig","dig");
        add_action("do_ba", "ba");
        add_action("do_mai", "bury");
        add_action("do_mai", "mai");        
        add_action("do_mianbi","mianbi");
}

int do_dig(string arg)
{
        object me=this_player(),room=this_object();
        int flag;

        if( !arg || (arg!="keng" && arg!="hole"))
        return 0;

        if( room->query("hole") > 1)
        return notify_fail("坑早就挖好了，还挖什么呀？\n");

        room->add("hole",1);
        flag=room->query("hole");
        switch(flag)
        {
        case 1:
          message_vision("$N仔细得将骸骨移到一边，用手在泥土里挖了"
          +"一个坑，\n忽然$N好象碰到了一个铁盒。\n",me);

          new(__DIR__"obj/da_tiehe")->move(me); 
          break;

        case 2:
          message_vision("$N将铁盒放在一边，继续用手在泥土里挖了"
          +"一阵子，\n忽然$N又碰到了一个小铁盒。\n",me);

          new(__DIR__"obj/xiao_tiehe")->move(me); 
          break;

        default:
          break;

        }

        return 1;
}

int do_mai(string arg)
{
        object me=this_player(),ob,room=this_object();

        if( !arg || arg!="skeleton")
        return 0;

        if( room->query("hole") != 2)
        return notify_fail("坑都没挖好，怎么埋呀？\n");

        if(!objectp(ob=present("skeleton",room)))
        return notify_fail("这里好象除了你自己，没什么别的可以埋的了。\n");

        message_vision("$N仔细地将骸骨埋进土里，用手将土铺满，"
          +"并磕头拜了三拜。\n",me);
        destruct(ob);
        room->delete("hole");
        me->set_temp("jinshe/bai",1);
        return 1;
}

int do_ba(string arg)
{
        object me=this_player(),ob;

        if( !arg || (arg!="jian" && arg!="jinshe jian"))
        return 0;

        if( !me->query_temp("jinshe/bai"))
        return notify_fail("你握住剑柄，心中竟涌出一股不详的预感。\n");

        if( me->query("neili")<2000 || me->query("max_neili")<2000)
        return notify_fail("你握住剑柄，使尽吃奶的力气也把不出剑来。\n");

        message_vision("$N握住剑柄，猛地用力一拔，只听“嗖”的一声，"
          +"竟发现剑柄后果然\n连着一道金光闪闪剑身。\n",me);
        if(objectp(ob=new(__DIR__"obj/jinshe-jian")))
        ob->move(me);
        me->delete_temp("jinshe");
        return 1;
}

int do_mianbi()
{
       object me=this_player();

       if( me->query_skill("throwing",1) < 100
           || me->query("combat_exp") < 100000
           || me->query_int() < 30)
       {
        message_vision("$N看了一会石壁上的图案，可是一无所获。\n",me);
        return 1;
       }

       if( me->query_skill("jinshe-zhui",1) > 100 )
       return notify_fail("石壁上的图案对你来说已经没有什么帮助了！\n");

       message_vision("$N仔细的琢磨了一会儿石壁上的图形，似乎略有所得。\n",me);
       tell_object(me,HIY"你的金蛇锥法进步了！\n"NOR);
       me->improve_skill("jinshe-zhui",random(me->query_skill("throwing",1)/2
                                       +me->query_con())+1,0);
       return 1;
}

