inherit ROOM;

void create()
{
        set("short", "西峰");
        set("long", @LONG
    太华西峰－又名莲花峰，也叫芙蓉峰，峰顶有一块巨石，状如莲花，覆盖崖巅。
该处由此而得名.
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
                "northeast" : __DIR__"ziqitai",
        ]));
        set("no_clean_up", 0);
        setup();
}

void init()
{
       add_action("do_put","put");
       add_action("do_put","tie");
       add_action("do_jie","jie");
       add_action("do_jie","untie");
       add_action("do_climb","climb");
}

int do_put(string arg)
{
       object me=this_player(),room=this_object(),ob;

       if(!arg || arg!="rope")
       return 0;
       if(!objectp(ob=present("rope",me)))  
       return notify_fail("你身上没有绳索，怎么绑呀？\n");

       if(room->query("tied"))
       return notify_fail("山崖上已经系着一条绳索了？\n");

       message_vision("$N从怀里掏出一条长索，一端牢牢地绑在"
       +"山石之上，另一端抛下悬崖。\n",me);
       destruct(ob);
       room->set("tied",1);
       return 1;
}

int do_jie(string arg)
{
       object me=this_player(),room=this_object(),ob;

       if(!arg || arg!="rope")
       return 0;

       if(!room->query("tied"))
       return notify_fail("山崖上已经没有绳索了。\n");

       message_vision("$N你从山石上解下一条长索，把它收进怀里。\n",me);
       new("/d/city/obj/rope")->move(me);
       room->delete("tied");
       return 1;
}

int do_climb(string arg)
{
       object me=this_player(),room=this_object();

       if(!arg || arg!="down")
       return 0;

       if(!room->query("tied"))
       return notify_fail("什么？你想跳崖自杀啊？ \n");

       message_vision("$N一手拉绳，“波”地一声溜了下去，穿烟破雾，"
       +"刹那间不见了影踪。\n",me);
       me->move(__DIR__"yongdao");
       return 1;
}

