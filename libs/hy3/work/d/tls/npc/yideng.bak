#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
  set_name("一灯大师",({"yideng dashi","yideng","dashi"}));
    set("nickname", HIY "南帝" NOR );
    set("gender", "男性");
    set("age", 42);
    set("long", 
 "他就是天龙寺的开山祖师，当年由于淡泊名利，放弃了帝位，就出家来当了和尚，\n");
    set("attitude", "peaceful");
    set("str", 45);
    set("int", 40);
    set("con", 50);
    set("dex", 40);

    set("inquiry", ([
        "王重阳"   : "王真人才是当世第一高手，当年与老衲互换武功，就是为了要消灭妖孽。 \n",
        "六脉神剑谱" : "光读又有何用？哈哈哈...还是跟我好好学吧！！！\n",
        "拜师" :"我已经让枯荣去给我找弟子去了，你去找他问问好了。",
]));
        set("max_qi", 10000);
      set("qi",10000);
        set("jing", 5000);
        set("max_jing", 5000);
        set("neili", 10000);
        set("max_neili", 10000);
        set("jiali", 400);
        set("combat_exp", 4000000);
        set("score", 4000000);

    set_skill("force", 200);             
      set_skill("finger", 220);            
      set_skill("kurong-changong", 200);   
    set_skill("dodge", 200);             
    set_skill("duanjia-shenfa", 200);    
      set_skill("parry", 180);             
      set_skill("yiyang-zhi", 210);        
    set_skill("literate",200);
    set_skill("sword", 180); 
      set_skill("duanjia-jian", 180);     
      set_skill("liumai-shenjian", 220);
    map_skill("force"  , "kurong-changong");
    map_skill("sword", "duanjia-jian");
    map_skill("finger" , "liumai-shenjian");
    map_skill("dodge"  , "duanjia-shenfa");
    map_skill("parry"  , "yiyang-zhi");
      map_skill("finger","liumai-shenjian");
    prepare_skill("finger","liumai-shenjian");  

    setup();
    carry_object(__DIR__"obj/sengxie")->wear();
    carry_object(__DIR__"obj/sengrobe")->wear();

}

void init()
{
	object ob;

	::init();

	ob = this_player();

	if((int)ob->query("score") < 0 &&ob->query("family/master_id")=="yideng dashi")
	{
		command("chat "+ob->query("name")+"!你为人不忠不义，我岂能仍是你的师傅。\n");
		command("expell "+ ob->query("id"));
		this_player()->set("title","天龙寺" + RED + "弃徒" NOR);
	}
}

void attempt_apprentice(object ob)
{

     string new_name,name;
        if (ob->query("id") =="fozhu" ) {
           if((!ob->query("family") || ob->query("family")["family_name"]!="天龙寺"))
                {
                command("say 你不是天龙寺弟子，我不能教你。\n");
                 return ;
                }
             else if ((int)ob->query_skill("force", 1) < 200 
                    && (int)ob->query_skill("kurong-changong", 1) < 150 )
                    {
                        command("say 你的枯荣禅功还没学好。");
                        return ; 
                    }
                  else          
                     {
              message_vision("一灯接过佛珠，点点头:“枯荣总算给我找到个传人了，好...好...好！”\n",ob);
              message_vision("$N说道：“他叫我来的，没告诉我干嘛！。”\n",ob);   
              message_vision("一灯道:“我让他给我找个传人，好把当年王真人和我交换的武功传下去呀”\n",ob);
              command("say "+"听好了，"+RANK_D->query_respect(ob) +"我会把所有武功传授给你，你可要好好学！\n");
              command("recruit " + ob->query("id"));
              new_name = "兴" + name[2..3];
              ob->set("name", new_name);
              ob->set("family/generation", 5);
              command("say 从今以后你的法名叫做" + new_name + "，恭喜你荣升为天龙寺兴字辈弟子 !");
              return ;
           }
        return ;
}

}

