inherit CHAT_ROOM;

void create()
{
        set("short", "聊天室");
        set("long", @LONG

    这里是火云录聊天乐园。门前挂的牌子上很请晰地刻着一个大字“伍”。
在这里，时间被神仙的法力冻结了。任何人就算在这里呆上一千年，人间
也只是过了一天。
LONG
        );

        // set("outdoors", "center");

        set("exits", ([
                "out" : __DIR__"chat_room",
        ]) );                   

        ::create();

}

