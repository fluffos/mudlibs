inherit CHAT_ROOM;

void create()
{
        set("short", "聊天广场");
        set("long", @LONG
    这里是火云录聊天乐园。在这里，时间被神仙的法力冻结了。任何人
就算在这里呆上一千年，人间也只是过了一天。
LONG 
         );

         set("no_fight", "1"); 
         set("exits", ([
               "down" : "/d/city/wumiao",
               "west" : "/job/merchant/chaomai/shanghang",
                "1"    : __DIR__"chat_room_1",
                "2"    : __DIR__"chat_room_2",
                "3"    : __DIR__"chat_room_3",
                "4"    : __DIR__"chat_room_4",
                "5"    : __DIR__"chat_room_5",
                "6"    : __DIR__"chat_room_6",
                "7"    : __DIR__"chat_room_7",
                "8"    : __DIR__"chat_room_8",
                "9"    : __DIR__"chat_room_9",
                "0"    : __DIR__"chat_room_0",
        ])); 
         set("objects", ([
                "/d/city/npc/qianli" : 1,
        ]));    

          ::create();     
}
void init()
{

//      add_action("do_quit","quit");
        add_action("do_quit","exercise");
        add_action("do_quit","dazuo");
        add_action("do_quit","exert");
        add_action("do_quit","yun");
        add_action("do_quit","learn");
        add_action("do_quit","xue");
        add_action("do_quit","respirate");
        add_action("do_quit","tuna");
        add_action("do_quit","perform");
        add_action("do_quit","persuade");
        add_action("do_quit","quanjia");
        add_action("do_quit","practice");
        add_action("do_quit","lian");
        add_action("do_quit","study");
        add_action("do_quit","du");
        add_action("do_quit","teach");
        add_action("do_quit","jiao");
}
int do_quit(string arg)
{
        write("你不能在这里干这个。\n");
        return 1;
}

