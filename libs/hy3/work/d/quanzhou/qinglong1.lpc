// Room: /d/quanzhou/bamboo.c


#include <room.h>
inherit ROOM;


void create() {
  set("short", "青龙会大庭");
  set("long", @LONG
这是青龙会大庭,隐隐透出一股肃杀之气，据说这与黑木崖有密切往
来,房子角落仿佛有道小门。。
LONG
  );

  set("exits", ([
    "east": "/d/quanzhou/qinglong",
    "west": "/d/heimuya/didao1",
  ]));

  set("objects", ([
    "/d/heimuya/npc/xiang": 1,

  ]));
  create_door("west", "木门", "east");
  set("coor/x", -10);
  set("coor/y", 20);
  set("coor/z", 0);
  setup();

}

int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");
  if (me->query_temp("hmy_enter") && dir == "west")
    call_out("del_tmp", 1000, me);
  else {

    if ((!myfam || myfam["family_name"] != "日月神教") && dir == "west" &&
      objectp(present("xiang wentian", environment(me))))
      return notify_fail("向问天喝道：站住！你不是日月神教弟子，不得入内。\n");
  }

  return ::valid_leave(me, dir);
}
void del_tmp(object me) {
  if (objectp(me)) me->delete_temp("hmy_enter");
}
