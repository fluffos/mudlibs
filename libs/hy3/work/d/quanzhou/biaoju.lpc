#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "福威镖局" NOR);
  set("long", @LONG
        这里是福威镖局的大厅，几只太师椅一字排开，正中央坐着总镖头，手持
烟袋杆正在闭目沉思。墙上挂着几幅字画和一把宝剑。
LONG
  );

  set("exits", ([
    "east": __DIR__ "laozhai",
  ]));

  set("objects", ([
    __DIR__ "npc/linzhennan": 1,
  ]));
  setup();
}
