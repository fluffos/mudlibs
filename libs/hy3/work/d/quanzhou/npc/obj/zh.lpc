// buxiang

#include <weapon.h>
#include <ansi.h>
string query_autoload() { return 1 + "OK"; }

inherit SWORD;
inherit F_UNIQUE;

void create()
{
        set_name(YEL"铜板"NOR,({ "coin", "coin-money"}) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "文");
                set("no_steal_from", 1);
                set("value", 1);
                set("unique", 1);
                set("rigidity", 8);
                set("material", "steel");
                set("weapon_prop/parry", 5);
                set("weapon_prop/dodge", -10);
                set("treasure",1);
                set("wield_neili", 1500);
                set("wield_maxneili", 2000);
                set("wield_str", 32);
        }
        init_sword(1000);
        setup();
}
