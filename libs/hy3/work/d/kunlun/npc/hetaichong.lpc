// hetaichong.c (kunlun)
//By batman 00.1.4

inherit BH_NPC;
inherit F_MASTER;
string ask_me();
string ask_wugu();

void create() {
  set_name("何太冲", ({ "he taichong", "he" }));
  set("title", "昆仑派掌门");
  set("long",
    "他就是昆仑派掌门、名扬江湖的铁琴先生何太冲。\n"
    "只见铁琴先生何太冲年纪也不甚老，身穿黄衫，神情甚是飘逸，
气象冲和，俨然是名门正派的一代宗主。\n");
  set("gender", "男性");
  set("age", 44);
  set("attitude", "heroism");
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 40);

  set("max_qi", 4000);
  set("max_jing", 2000);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 120);
  set("combat_exp", 2000000);
  set("score", 40000);

  set_skill("literate", 200);
  set_skill("force", 180);
  set_skill("xuantian-wuji", 180);
  set_skill("dodge", 180);
  set_skill("kunlun-shenfa", 180);
  set_skill("hand", 180);
  set_skill("parry", 180);
  set_skill("sword", 180);
  set_skill("liangyi-jian", 180);
  set_skill("art", 150);

  map_skill("force", "xuantian-wuji");
  map_skill("dodge", "kunlun-shenfa");
  map_skill("parry", "liangyi-jian");
  map_skill("sword", "liangyi-jian");


  create_family("昆仑派", 4, "掌门");
  set("class", "taoist");

  set("inquiry",
    ([
      "丧门钉": (: ask_me :),
      "五姑": "唉！五姑也不知道得了甚么病。已叫了七八个算是有名的大夫来看过，连甚么病也说不上来，全身浮肿，一个如花似玉的人儿，肿得……唉，不用提了……",
      "治病": (: ask_wugu :),
    ]));

  set("weapon_count", 1);

  setup();
  carry_object("/clone/weapon/sword")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 0) {
    command("say 我昆仑乃是堂堂名门正派，" + RANK_D->query_respect(ob) +
      "的品德实在令人怀疑。");
    command("say " + RANK_D->query_respect(ob) +
      "还是先回去多做点善事吧。");
    return;
  }

  if (ob->query("appren_hezudao", 1) == 1) {
    command("say 前辈怎敢开这等玩笑，真是折杀做晚辈的了。");
    return;
  }

  if (ob->query_int() < 25) {
    command("say 我昆仑派非聪明才智之士不能学，你还是回去吧。");
    return;
  }

  if (ob->query("gender") != "男性") {
    command("say 我只收男弟子,你找我妻子斑淑娴去吧。");
    return;
  }

  command("say 既然" + RANK_D->query_respect(ob) +
    "慕昆仑派之名，千里而来，我昆仑派自当广纳天下英才。");
  command("recruit " + ob->query("id"));
}

string ask_me() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family"))
    || fam["family_name"] != "昆仑派")
    return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
  if (query("weapon_count") < 1)
    return "你来晚了，丧门钉已被你师兄拿走了。";
  add("weapon_count", -1);
  ob = new(__DIR__ "obj/sangmending.lpc");
  ob->move(this_player());
  return "这是我昆仑特制的丧门钉,你要好好使用。";
}

string ask_wugu() {
  object me, ob, room, obj, obj2;
  string name;
  me = this_player();
  ob = this_object();
  name = me->query("id");
  if (ob->is_fighting()) return "这位" + RANK_D->query_respect(me) + "，你没见我正忙着嘛？治病的事咱们稍后再说。";
  if (me->query("combat_exp") < 300000) return "你会治病？？我看不像，少来这里骗吃骗喝！";
  if (!(room = find_object("/d/kunlun/wugufang")))
    room = load_object("/d/kunlun/wugufang");
  if (!objectp(obj = present("wu gu", room)))
    obj = new("/d/mission/wugu/npc/wugu");
  if (obj->query("doctor")) {
    if (obj->query("doctor") == me->query("id")) return "你不去给五姑治病，在这里转什么？";
    else return "现在正有人在给五姑治病，" + RANK_D->query_respect(me) + "请稍侯片刻，若此人不行再请你瞧瞧。";
  }
  me->set_leader(ob);
  me->set_temp("marks/wugu1", 1);
  obj->move(room);
  if (!objectp(obj2 = present("shi bi", room)))
    obj2 = new("/d/mission/wugu/npc/shibi");
  obj2->move(room);
  obj->set("doctor", name);
  obj2->set("doctor", name);
  call_out("follow", 1, ob);
  return "原来这位" + RANK_D->query_respect(me) + "会治病，如此甚好，请随我来。";
}

int follow(object ob) {
  object me;
  string name;
  me = this_player();
  name = me->query("id");
  command("north");
  command("west");
  command("north");
  command("north");
  command("north");
  command("north");
  command("west");
  me->set_leader(0);
  command("say 你瞧瞧五姑的病情吧！何某还有本派事务要处理，少陪了！需要什么尽管吩咐侍婢们取去。");
  ob->move("/d/kunlun/sanshengtang");
  ob->set("doctor", name);
  message_vision("何太冲往东离开。\n", me);
  message("vision", "何太冲走了过来。\n", environment(), ob);
}
