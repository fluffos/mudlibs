#include <ansi.h>
inherit ITEM;
void init()
{
        add_action("do_use", "use");
}

void create()
{
        set_name(HIB"田七"NOR, ({"tian qi", "yao"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "味");
                set("long",
               "这是一味田七，是疗伤的好药材，可以用(use)于治疗外伤。\n");
                set("value", 10000);
        }
        setup();
}
     
int do_use(string arg)
{
        if( !arg || (arg!="tian qi" && arg!="yao") )
        return 0;

        if( this_player()->is_busy() )
                return notify_fail("你正忙着呢。\n");

        if ((int)this_player()->query("eff_qi") >
                             (int)this_player()->query("max_qi")/2 )
                return notify_fail("你没有受重伤，现在不需要使用田七。\n");
        else
        {
                this_player()->set("eff_qi", this_player()->query("max_qi"));
                message_vision("$N你服下一味"HIB"田七"NOR"，伤势好多了。\n",
                                this_player());
                destruct(this_object());
                return 1;
        }
}


