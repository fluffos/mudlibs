// yingxion.c 英雄剑
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE1;

void create() {
  set_name(HIR "英雄剑" NOR, ({ "yingx sword", "sword" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这把剑外观十分平凡，剑鞘古拙无光，却流露着一股异常感觉，
                使人一望就知道是一柄绝世神剑。\n");
    set("material", "steel");
    set("value", "300000");
    set("unique", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("rigidity", 200);
    set("replica_ob", "/d/city/npc/obj/changjian");
    set("wield_msg", HIR "只听「铮」的一声，英雄剑脱鞘飞出，自行跃入$N掌中。
瞬时天际间风云变色，电闪雷鸣，弥漫着一片无边杀意。\n" NOR);
    set("unwield_msg", HIW "英雄剑自$N掌中飞起，在半空中一转，「唰」地跃入刀鞘。\n" NOR);
  }
  init_sword(200);
  setup();
}
