#include <ansi.h>
inherit NPC;

void create() {
  set_name("疯老头", ({ "feng laotou", "feng", "laotou" }));
  set("long",
    "一个疯疯颠颠的老头，看来武功很高！\n");
  set("attitude", "aggressive");
  set("chat_msg", ({
    (: random_move :),
  }));
  set("age", 64);
  set("max_sen", 10000);
  set("sen", 10000);
  set("max_gin", 10000);
  set("gin", 10000);
  set("max_kee", 10000);
  set("kee", 10000);
  set("max_atman", 10000);
  set("atman", 10000);
  set("max_neili", 100000);
  set("neili", 100000);
  set("jiali", 1000);
  set("combat_exp", 1000000);

  set("cps", 100);
  set("spi", 100);
  set("int", 100);
  set("cor", 100);
  set("per", 100);
  set("kar", 100);
  set("str", 100);
  set("con", 100);

  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("unarmed", 100);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}
