// silk.c 丝衣

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIR "丝衣" NOR, ({ "silk" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("value", 10000);
  }
  setup();
}
