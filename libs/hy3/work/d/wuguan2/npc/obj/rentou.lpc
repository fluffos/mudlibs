inherit ITEM;
void create()
{
        set_name( "[31m张昱风的人头[0m", ({ "zyf poll"}));
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long","这是一颗[0;5;31m[5m[5m[5m[5m[5m[0m的人头。\n");
                set("value", 1); 
                set("material", "meat"); 
              }
}

