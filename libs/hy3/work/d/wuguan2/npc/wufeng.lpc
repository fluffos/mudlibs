// zhang-yufeng
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me();  //出师加入

void consider();

void create() {
  set_name("吴风", ({ "wu feng", "wu", "feng" }));
  set("long", "他就是吴风，看起来已经是风烛残年。而且双腿残废。 \n");
  create_family("狂风剑派", 1, "掌门人");
  set("attitude", "peaceful");
  set("age", 75);
  set("gender", "男性");
  set("shen_type", 1);
  set("chat_chance", 1);
  set("chat_msg", ({
    "吴风言到：“狂风剑法，举世无双。攻击式如狂风一般势不可挡！”\n",
  }));
  set("con", 30);
  set("dex", 30);
  set("int", 30);
  set("str", 30);
  set("per", 15);
  set("ker", 10);
  set("max_jing", 1000);
  set("max_neili", 30000);
  set("max_qi", 10000);
  set("jing", 1000);
  set("neili", 30000);
  set("qi", 10000);
  set("jiali", 300);
  set("shen", 20000);
  set("combat_exp", 2500000);

  set_skill("dodge", 150);
  set_skill("force", 200);
  set_skill("literate", 150);
  set_skill("parry", 180);
  set_skill("sword", 250);
  set_skill("unarmed", 180);
  set_skill("kuangfeng-jianfa", 250);
  set_skill("zhenfeng-xinfa", 150);
  set_skill("fyfy-zhang", 180);
  set_skill("zfwy-bu", 150);

  map_skill("force", "zhenfeng-xinfa");
  map_skill("dodge", "zfwy-bu");
  map_skill("parry", "kuangfeng-jianfa");
  map_skill("sword", "kuangfeng-jianfa");
  map_skill("unarmed", "fyfy-zhang");

  set("inquiry", ([
    "张昱风": "张昱风这个无耻小儿，当年竟然欺师灭主设计陷害老夫！！\n吴风摇了摇头说到：幸好老夫命大......\n",
    "狂风剑法": "狂风剑法是老夫自创绝技。攻击式如刮起的狂风一般势不可挡！\n",
    "震风剑法": "当年张昱风小儿学我几招剑法，就自创了震风剑法，不自量力的东西。\n",
    "拜师": "哦！想拜老夫为师？\n好！好！好！先提着张昱风小儿项上人头来。\n",
    "出师": (: ask_me: ),
    ])
  );

set("chat_chance_combat", 10);
set("chat_msg_combat", ({
  (: perform_action, "sword.kuang" :),
  (: perform_action, "sword.hu" :),
  (: exert_function, "recover" :),
}));

setup();

carry_object(__DIR__ "obj/cloth")->wear();
carry_object(__DIR__ "obj/canyijian")->wield();

}
void attempt_apprentice(object who) {
  if ((int)who->query_temp("bai_wufeng") == 1) {
    command("say 往事已成风，回来干什么？你还是走吧！\n");
    return;
  }


  if ((int)who->query_temp("killzyf") == 1) {
    command("chat 想不到你替老夫报了当年一剑之仇，老夫就将毕生武功都传于你！\n");
    command("recruit " + who->query("id"));
    who->set("title", "狂风剑派第二代关门弟子");
    who->set_temp("bai_wufeng", 1);
    return;
  }

  command("say 哦！想拜老夫为师？\n");
  command("say 好！好！好！先提着张昱风小儿项上人头来。\n");
  who->set_temp("go_kill_zyf", 1);

  return 0;
}

int accept_object(object who, object ob) {
  if ((int)who->query_temp("killzyf") == 1) {
    message_vision("吴风看了看$N，说道：往事已成风，你还是走吧！\n", ob);
    return 1;
  }

  if ((string)ob->query("id") == "zyf poll") {
    message_vision("吴风看了看$N送来的人头，仔细辨认了一阵，苦笑道：\n"
      "呵！呵！呵！张昱风小儿你也有今天。老天开眼啦！！！\n"
      "看你忠心耿耿，老夫就收下你这个弟子。\n", who);
    who->set_temp("killzyf", 1);
    return 1;
  }
  return 0;
}
//出师 by xyx

string ask_me() {
  object me, ob;

  me = this_object();
  ob = this_player();

  if ((string)me->query("family/family_name") != (string)ob->query("family/family_name")) {
    notify_fail(CYN "张三风说到：“" + RANK_D->query_respect(ob) + "并非老夫弟子，何出此言啊！”\n" NOR);
    return;
  }
  if (me->is_fighting()) {
    notify_fail(CYN "他正在战斗，不能接受出师的挑战！\n" NOR);
    return;
  }
  command("say 好！只要你能胜过我，你就可以出师了！\n");

  me->set("eff_qi", me->query("max_qi"));
  me->set("qi", me->query("max_qi"));
  me->set("jing", me->query("max_jing"));
  me->set("neili", me->query("max_neili"));

  fight_ob(ob);
  ob->fight_ob(me);
  remove_call_out("checking");
  call_out("checking", 1, me, ob);
}

int checking(object me, object ob) {

  object obj;
  int my_max_qi, his_max_qi;

  my_max_qi = me->query("max_qi");
  his_max_qi = ob->query("max_qi");
  if (me->is_fighting()) {
    if ((me->query("qi") * 100 / my_max_qi) <= 80)
      command("exert recover");

    call_out("checking", 1, me, ob);
    return 1;
  }

  if (!present(ob, environment())) return 1;

  if (((int)me->query("qi") * 100 / my_max_qi) <= 30) {
    me->set("eff_qi", me->query("max_qi"));
    me->set("qi", me->query("max_qi"));
    me->set("jing", me->query("max_jing"));
    me->set("neili", me->query("max_neili"));
    command("say 哈！哈！哈！真是江湖后浪推前浪！现在你已经出师了！\n");
    command("rumor " + ob->query("name") + "打败了自己的师傅！另谋出路去了！\n");
    ob->delete("family");
    ob->set("title", "普通百姓");
    return 1;
  }

  if (((int)ob->query("qi") * 100 / his_max_qi) < 50) {
    me->set("eff_qi", me->query("max_qi"));
    me->set("qi", me->query("max_qi"));
    me->set("jing", me->query("max_jing"));
    me->set("neili", me->query("max_neili"));
    command("say 看来你还得多加练习，下次再来吧！\n");
    return 1;
  }

  return 1;

}
