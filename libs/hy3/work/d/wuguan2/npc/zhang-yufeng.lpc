// zhang-yufeng
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("张清风", ( {"zhang qingfeng","zhang","qingfeng"} ) );
        set("nickname",HIR"仁剑"NOR);
        set("long","这就是在江湖上赫赫有名的震风武馆掌门人张昱风之弟。 \n" );
        create_family("震风武馆", 2 , "分舵主");
        set("attitude", "peaceful");
        set("age", 40);
        set("gender", "男性");
        set("shen_type", 1);

        set("con", 30);
        set("dex", 30);
        set("int", 30);
        set("str", 30);
	set("per", 28);
	set("ker", 30);
        set("max_jing", 1000);
        set("max_neili", 10000);
        set("max_qi", 3000);
        set("jing",1000);
        set("neili",10000);
        set("qi",3000);
        set("jiali", 100);
        set("shen", 20000);
        set("combat_exp", 1500000);

        set_skill("dodge", 150);
        set_skill("force", 150);
        set_skill("literate",120);
        set_skill("parry", 150);
        set_skill("sword", 150);
        set_skill("unarmed", 150);
        set_skill("zhenfeng-jianfa", 150);
        set_skill("zhenfeng-xinfa", 150);
        set_skill("fyfy-zhang", 150);
        set_skill("zfwy-bu", 120);

	map_skill("force", "zhenfeng-xinfa");
	map_skill("dodge", "zfwy-bu");
	map_skill("parry", "zhenfeng-jianfa");
	map_skill("sword", "zhenfeng-jianfa");
	map_skill("unarmed", "fyfy-zhang");

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "sword.feng" :),
		(: perform_action, "sword.hu" :),
		(: exert_function, "recover" :),
	}) );

        setup();

        carry_object(__DIR__"obj/jian")->wield();
        carry_object(__DIR__"obj/cloth")->wear();

}
void attempt_apprentice(object ob)
{
        mapping fam;
        if ((int)ob->query("shen") < 0) {
        command("say 我震风武馆乃是堂堂名门正派，对弟子要求极严。");
        command("say 在德行方面，" + RANK_D->query_respect(ob) +
        "是否还做得不够？");
        return;
        }
        command("say 好吧，我就收下你了,你可要为我们震风武馆争口气。");
        command("recruit " + ob->query("id"));
}
