//ling-xiaoer.c 凌宵儿
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("叶芝美", ( {"ling ziaoer","ling","xiaoer"} ) );
        set("long","她就是震风武馆分舵主张清风爱妻。\n" );
        set("attitude", "peaceful");
        set("age", 35);
        set("gender", "女性");

        set("con", 24);
        set("dex", 22);
        set("int", 27);
        set("str", 29);
	set("ker", 22);
	set("per", 30);
        set("max_jing", 100);
        set("max_neili", 3000);
        set("max_qi", 700);
        set("jing",100);
        set("neili",3000);
        set("qi",700);
        set("jiali", 30);

        set("combat_exp", 55000);

        set_skill("sword",  60);
        set_skill("dodge", 150);
        set_skill("force", 30);
        set_skill("literate",90);
        set_skill("parry", 40);
        set_skill("unarmed", 180);
        set_skill("zfwy-bu", 150);

	map_skill("dodge", "zfwy-bu");

        setup();

        carry_object(__DIR__"obj/silk")->wear();

}

