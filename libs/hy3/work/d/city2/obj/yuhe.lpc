inherit ITEM;
#include <ansi.h>
void create() {
  set_name(HIW "白玉匣" NOR, ({ "baiyu xia", "xia" }));
  set_max_encumbrance(100000);
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个一尺见方，一尺来高的白玉匣子，入手
似乎并不沉重，不知道里面装着什么东西。\n");
    set("unit", "个");
    set("value", 100);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_get", 1);
  }
}

int is_container() { return 1; }
