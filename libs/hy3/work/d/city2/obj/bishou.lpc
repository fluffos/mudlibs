// 匕首 writed by xingyun;
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;
void create() {
  set_name(BLK "匕首" NOR, ({ "bishou", "jian", "sword" }));
  set_weight(3000);

  if (violate_unique()) {
    write("你来迟了，" + query("name") + "已经被人拿走了！\n");
    create_replica();
    return;
  } else {
    if (clonep())
      set_default_object(__FILE__);
    else {
      set("unit", "柄");
      set("unique", 1);
      set("long", "细看那匕首，剑身如墨，无半点光泽。\n");
      set("value", 50000);
      set("rigidity", 500);
      set("material", "steel");
      set("no_drop", "这样东西不能离开你。\n");
      set("replica_ob", "/d/city/npc/obj/changjian");
      set("no_steal", 1);
      set("no_put", 1);
      set("material", "steel");
      set("wield_neili", 500);
      set("wield_msg",
        BLK "$N「唰」的一声抽出一柄$n" BLK "握在手中，只觉一股寒气扑面而来。\n");
      set("unwield_msg",
        BLK "$N将手中的$n" BLK "插回剑鞘，只听嗤的一声轻响。\n");
    }
    init_sword(300, 2);
    setup();
  }
}
