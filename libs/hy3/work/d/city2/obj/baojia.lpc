// 真丝宝甲 writed by xingyun;
#include <ansi.h>
#include <armor.h>
inherit ARMOR;
inherit F_UNIQUE;
void create() {
  set_name(HIY "真丝宝甲" NOR, ({ "bao jia", "jia" }));
  set_weight(3000);

  if (violate_unique()) {
    write("你来迟了，" + query("name") + "已经被人拿走了！\n");
    create_replica();
    return;
  } else {
    if (clonep())
      set_default_object(__FILE__);
    else {
      set("unit", "件");
      set("unique", 1);
      set("long", "这是一件真丝宝甲，质地极为坚韧。\n");
      set("value", 200000);
      set("material", "gold");
      set("no_drop", "这样东西不能离开你。\n");
      set("replica_ob", "/d/city/npc/obj/tiejia");
      set("no_steal", 1);
      set("no_put", 1);
      set("material", "steel");
      set("armor_prop/armor", 400);
    }
    setup();
  }
}
