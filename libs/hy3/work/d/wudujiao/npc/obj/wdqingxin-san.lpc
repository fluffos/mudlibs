#include <ansi.h>

inherit ITEM;

void create() {
  set_name("五毒清心散", ({ "wudu-qingxin san", "san" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("value", 1000);
  }
  setup();
}

int init() {
  add_action("do_eat", "eat");
}
int do_eat(string arg) {
  object me = this_player();
  int poison;

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  poison = (int)me->query_condition("wudu_poison");
  message_vision(HIB "$N吃下一包" + name() + "。\n" NOR, me);
  if (poison > 0) {
    if (poison < 101) {
      me->clear_condition("wudu_poison");
      message_vision("$N身上的毒气尽退，脸色看上去好多了。\n", me);
    } else {
      me->clear_condition("wudu_poison");
      me->apply_condition("wudu_poison", poison - 100);
      message_vision(RED "$N的脸色渐渐红润起来。\n" NOR, me);
    }
  } else
    tell_object(me,
      BLK "一股不知道是什么毒虫的气味冲了上来，简直另人作呕。\n" NOR);

  destruct(this_object());
  return 1;
}
