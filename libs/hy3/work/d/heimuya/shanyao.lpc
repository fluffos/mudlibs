inherit ROOM;

void create()
{
        set("short", "山腰");
        set("long", @LONG
这是一个陡峭的山腰，下面看不见底，很幸运，你没有摔死，看着黑
漆漆的山谷，听着凛冽的山风，还是打退堂鼓把，背后仿佛有个小洞，
不知是否有凶狠的野兽在里面.
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
  "enter" : __DIR__"shandong",
]));
        set("no_clean_up", 0);

        setup();
}

void init()
{
          add_action("do_jump", "jump");
}

int do_jump(string arg)
{
        object ob;
        int new_jing;
        ob = this_player();
        new_jing = random( ob->query("max_jing")*3 );
        if ( new_jing > ob->query("jing") ) new_jing = ob->query("jing") + 1;
        if( !arg || arg=="" ) return 0;
        if( arg != "down" )
                return notify_fail("你要跳下去？还想自杀？不要了把：P！\n");
        if( (ob->query("dex") < 20) && ((int)ob->query_skill("dodge")<30) )
                return notify_fail("以你现在的身手，跳下去只有死路一条！\n");
       message_vision("$N毫不考虑，一个纵身，跳了下去。\n", ob);
       environment(ob), ({ob});
       message_vision("$N空中变换身形，一个空翻，轻飘飘地落在地上！\n", ob);
       environment(ob), ob;  
       ob->add("jing", 0 - new_jing);
       ob->move("/d/heimuya/dashikuai");
       return 1;
}

