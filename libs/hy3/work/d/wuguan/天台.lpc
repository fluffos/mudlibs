// Room: /u/xyx/震风武馆/天台.c

inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "天台");
        set("long", @LONG
这个天台约八丈于宽。举目跳望，下面一片郁郁葱葱的松林，因为这里
很高，所以看不大清楚。但你知道一旦失足掉下去，一定摔成肉泥，最好少
呆为妙。
LONG
        );
        set("no_clean_up", 0);
        set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"走廊",
]));

        setup();
}
void init()
{
        add_action("do_jump","jump");
}

int do_jump(string arg)
{
        object ob;
        int new_jing;
        ob = this_player();
        new_jing = random( ob->query("max_jing")*3 );
        if ( new_jing > ob->query("jing") ) new_jing = ob->query("jing") + 1;
        if( !arg || arg=="" ) return 0;
        if( arg != "down" )
                return notify_fail("你要跳下去？不想活啦？\n");
        if( (ob->query("dex") < 20) && ((int)ob->query_skill("dodge")<30) )
                return notify_fail("你现在跳下去一定摔成肉泥！\n");
        tell_object(ob, HIR"你一闭眼心想“是死是活由天定了”把心一横向外跳了出去。\n"NOR);
        message("vision", HIR"只见" + ob->query("name") + "不小心脚一滑，掉下了悬崖。\n"NOR, environment(ob), ob);

        ob->add("jing", 0 - new_jing);
        ob->move(__DIR__"悬崖底");
        return 1;
}

