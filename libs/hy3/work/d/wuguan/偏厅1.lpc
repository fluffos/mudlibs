// Room: /u/xyx/震风武馆/偏厅1.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "偏厅");
  set("long", @LONG
这里是震风武馆偏厅，张昱风爱妻凌宵儿的卧室，撩开低垂的门帘出现
在你面前的是一个华丽的房间，房间名之内都是贵的桃木家具，看来昱风在
这儿花了不少心思的。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "大殿",
  ]));
  set("objects", ([ /* sizeof() == 2 */
    __DIR__ "npc/ling-xiaoer.lpc": 1,
    __DIR__ "npc/丫鬟": 2,
  ]));
  //      set("no_clean_up", 0);

  setup();
}
void init() {
  object ob;
  int shu;
  shu = random(30);

  if (interactive(this_player())) {
    if (shu != 1) return;
    message_vision(HIR "突然从房上跳下一条人影，你感到将有什么事情发生！\n\n" NOR, this_player());
    ob = new("/open/killer2");
    ob->move(this_object());

  }

}
