// suo.c 金枪锁喉

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  int damage;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「金枪锁喉」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_skill("zhenfeng-qiangfa", 1) < 100)
    return notify_fail("你的「震风枪法」够娴熟，不会使用「金枪锁喉」。\n");

  if ((int)me->query_skill("zhenfeng-xinfa", 1) < 30)
    return notify_fail("你的「震风心法」不够高，不会使用「金枪锁喉」。\n");

  if ((int)me->query("neili", 1) < 50)
    return notify_fail("你现在内力太弱，不能使用「金枪锁喉」。。\n");

  msg = CYN "$N手上加紧，对$n使出「震风枪法」的绝学「金枪锁喉」。企图锁住$n。\n" NOR;

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 2) {
    me->start_busy(3);
    target->start_busy(random(3));

    damage = (int)me->query_skill("zhenfeng-qiangfa", 1);

    damage = damage / 2 + random(damage);

    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage / 3);
    me->add("neili", -damage / 10);

    if (damage < 50) msg += HIY "结果$n挨了$N一枪，身上顿时出了一道血槽！\n" NOR;
    else if (damage < 100) msg += HIY "结果$n被$N枪上的内力一震，「嘿」地一声退了两步。\n" NOR;
    else if (damage < 150) msg += RED "结果$n虽然没被「金枪锁喉」锁住，但已被$N扎的像个血人相仿。\n" NOR;
    else {
      msg += HIR "结果$n一不留神，被$N一下锁住了喉咙…\n" NOR;
      target->remove_call_out("unconcious");
      target->unconcious();
      target->announce();
    }
  } else {
    me->start_busy(1);
    msg += CYN "$p身形连闪，虽然躲过了$P的「金枪锁喉」，但身上的衣服已被扎了十几个洞。\n" NOR;
  }
  message_vision(msg, me, target);
  target->kill_ob(me);
  return 1;
}
