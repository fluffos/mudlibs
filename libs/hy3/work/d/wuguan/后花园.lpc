// Room: /u/xyx/震风武馆/后花园.c

inherit ROOM;

void create()
{
        set("short", "后花园");
        set("long", @LONG
一个不大的花园但经营得很好，中心是数十盆牡丹组成的圆形花潭，几
只蝴碟偏偏起舞给整个花园锦上添花，花园周围是走廊，通往书房和饭厅。
LONG
        );
        set("no_clean_up", 0);
        set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"书房",
  "east" : __DIR__"饭厅",
  "north" : __DIR__"走廊",
  "south" : __DIR__"大殿",
]));

        setup();
        replace_program(ROOM);
}
int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");

        if ((!myfam || myfam["family_name"] != "震风武馆") && dir == "east" &&
                objectp(present("zhang cuishong", environment(me))))
           return notify_fail("张翠松：非武馆弟子，不得入内。\n");
                
        return ::valid_leave(me, dir);
}

