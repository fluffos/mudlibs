// zhang-yufeng
#include <ansi.h>
inherit BH_NPC;
int ask_me();
void create() {
  set_name("张昱风", ({ "zhang yufeng", "zhang", "yufeng" }));
  set("nickname", HIY "天剑" NOR);
  set("long", "这就是在江湖上赫赫有名的震风武馆掌门人。 \n");
  create_family("震风武馆", 2, "掌门人");
  set("attitude", "peaceful");
  set("age", 45);
  set("gender", "男性");
  set("shen_type", 1);
  set("no_drop", 1);

  set("food", 50000);
  set("water", 50000);
  set("con", 30);
  set("water", 50000);
  set("food", 50000);
  set("dex", 30);
  set("int", 30);
  set("str", 30);
  set("per", 28);
  set("ker", 30);
  set("max_jing", 1000);
  set("max_neili", 50000);
  set("max_qi", 35000);
  set("jing", 1000);
  set("neili", 50000);
  set("qi", 35000);
  set("jiali", 100);
  set("shen", 20000);
  set("combat_exp", 5500000);

  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("literate", 250);
  set_skill("parry", 350);
  set_skill("sword", 350);
  set_skill("unarmed", 320);
  set_skill("zhenfeng-jianfa", 320);
  set_skill("zhenfeng-xinfa", 320);
  set_skill("fyfy-zhang", 300);

  set_skill("zfwy-bu", 320);

  map_skill("force", "zhenfeng-xinfa");
  map_skill("dodge", "zfwy-bu");
  map_skill("parry", "zhenfeng-jianfa");
  map_skill("sword", "zhenfeng-jianfa");
  map_skill("unarmed", "fyfy-zhang");

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "sword.feng" :),
    //            (: perform_action, "sword.hu" :),
    (: exert_function, "recover" :),
  }));
  set("inquiry", ([
    "出师": (: ask_me :),
    "离馆": (: ask_me :),
    "退学": (: ask_me :),
    "chushi": (: ask_me :),
    "liguan": (: ask_me :),
    "tuixue": (: ask_me :),
  ]));

  setup();

  carry_object(__DIR__ "obj/jian")->wield();
  carry_object(__DIR__ "obj/jincan")->wear();
  carry_object(__DIR__ "obj/cloth")->wear();

}
void attempt_apprentice(object ob) {
  mapping fam;
  if ((int)ob->query("shen") < 0) {
    command("say 我震风武馆乃是堂堂名门正派，对弟子要求极严。在德行方面，" + RANK_D->query_respect(ob) + "是否还做得不够？");
    return;
  }
  command("say 好吧，我就收下你了,你可要为我们震风武馆争口气。");
  command("recruit " + ob->query("id"));
}

void die() {
  object tou;
  message_vision(HIR "\n$N口吐鲜血栽倒在地断气了。\n你挥剑将其身首异处！\n" NOR, this_object());
  tou = new(__DIR__ "obj/rentou");
  tou->move(environment(this_object()));
  return ::die();
}
int ask_me() {
  command("hehe");
  command("say 你只要交50两黄金就可以离馆了。");
  return 1;
}
int accept_object(object who, object ob) {

  who = this_player();
  if (who->query("family/master_name") != "张昱风") {
    command("say 在下与" + RANK_D->query_respect(who) + "从无来往这钱在下不能收。\n");
    return ::accept_object(who, ob);
  }
  if (ob->query("money_id") && ob->value() >= 500000) {
    command("say 好！数目对头！");
    command("say 现在开始就已经不是我武馆的弟子了！");
    //            log_file("player/" + killer->query("id") + ".txt",sprintf("\n%s岁时离开了武馆！\n",who->query("age"), who->query("family/master_name")));
    who->set("zhongcheng", 0);
    who->delete("family");
    who->set("title", "普通百姓");
    who->delete("class");
  }

  return 1;
}
