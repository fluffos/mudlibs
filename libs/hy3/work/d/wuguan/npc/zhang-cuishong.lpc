// zhang-cuishong
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("张翠松", ( {"zhang cuishong","zhang","cuishong"} ) );
        set("long","他就是震风武馆大弟子张翠松\n" );
        create_family("震风武馆", 3 , "弟子");
        set("attitude", "peaceful");
        set("age", 22);
        set("gender", "男性");
        set("con", 30);
        set("dex", 30);
        set("int", 30);
        set("str", 30);
	set("per", 20);
        set("max_jing", 300);
        set("max_neili", 1000);
        set("max_qi", 1000);
        set("jing",300);
        set("neili",1000);
        set("qi",1000);
        set("jiali", 100);

        set("combat_exp", 50000);

        set_skill("dodge", 60);
        set_skill("force", 60);
        set_skill("literate",40);
        set_skill("parry", 60);
        set_skill("sword", 60);
        set_skill("unarmed", 60);
        set_skill("zhenfeng-jianfa", 60);
        set_skill("zhenfeng-xinfa", 60);
        set_skill("fyfy-zhang", 60);
        set_skill("zfwy-bu", 60);

	map_skill("force", "zhenfeng-xinfa");
	map_skill("dodge", "zfwy-bu");
	map_skill("parry", "zhenfeng-jianfa");
	map_skill("sword", "zhenfeng-jianfa");
	map_skill("unarmed", "fyfy-zhang");

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "sword.feng" :),
		(: perform_action, "sword.hu" :),
		(: exert_function, "recover" :),
	}) );
        setup();

        carry_object(__DIR__"obj/jian")->wield();
        carry_object(__DIR__"obj/clone")->wear();

}

void attempt_apprentice(object ob)
{
        mapping fam;

        if ((int)ob->query("shen") < 0) {
        command("say 我震风武馆乃是堂堂名门正派，对弟子要求极严。在德行方面，" + RANK_D->query_respect(ob) + "是否还做得不够？");
//        command("say 在德行方面，" + RANK_D->query_respect(ob) +
//        "是否还做得不够？");
        return;
        }

        command("say 好吧，我就收下你了,你可要为我们震风武馆争口气。");
        command("recruit " + ob->query("id"));
}

