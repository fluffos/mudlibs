// zhang-yufeng
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("吴风", ({ "wu feng", "wu", "feng" }));
  set("long", "他就是吴风，看起来已经是风烛残年。而且双腿残废。 \n");
  create_family("狂风剑派", 1, "掌门人");
  set("attitude", "peaceful");
  set("age", 75);
  set("gender", "男性");
  set("shen_type", 1);
  set("chat_chance", 1);
  set("no_drop", 1);
  set("chat_msg", ({
    "吴风言到：“狂风剑法，举世无双。攻击式如狂风一般势不可挡！”\n",
    "吴风言到：“只可惜狂风剑法最后一招狂风肆虐我这一生也没参透！”\n。。。停顿。。。“只知道练成之后就可以天下无敌。。。。”\n",
  }));
  set("con", 30);
  set("dex", 30);
  set("int", 30);
  set("str", 30);
  set("per", 15);
  set("ker", 10);
  set("qi", 400000);
  set("food", 40000);
  set("water", 40000);
  set("max_qi", 400000);
  set("jing", 10000);
  set("max_jing", 10000);
  set("jingli", 10000);
  set("max_jingli", 10000);
  set("neili", 30000);
  set("max_neili", 30000);
  set("jiali", 100);

  set("combat_exp", 8000000);

  set_skill("dodge", 450);
  set_skill("force", 450);
  set_skill("literate", 350);
  set_skill("parry", 400);
  set_skill("sword", 450);
  set_skill("unarmed", 400);
  set_skill("kuangfeng-jianfa", 450);
  set_skill("zhenfeng-xinfa", 350);
  set_skill("fyfy-zhang", 400);
  set_skill("zfwy-bu", 400);

  map_skill("force", "zhenfeng-xinfa");
  map_skill("dodge", "zfwy-bu");
  map_skill("parry", "kuangfeng-jianfa");
  map_skill("sword", "kuangfeng-jianfa");
  map_skill("unarmed", "fyfy-zhang");

  set("inquiry", ([
    "张昱风": "张昱风这个无耻小儿，当年竟然欺师灭主设计陷害老夫！！\n吴风摇了摇头说到：幸好老夫命大......\n",
    "狂风剑法": "狂风剑法是老夫自创绝技。攻击式如刮起的狂风一般势不可挡！\n",
    "震风剑法": "当年张昱风小儿学我几招剑法，就自创了震风剑法，不自量力的东西。\n",
    "拜师": "哦！想拜老夫为师？\n好！好！好！先提着张昱风小儿项上人头来。\n",
  ]));

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: command("perform kuang") :),
    (: command("exert recover") :),
  }));

  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/canyijian")->wield();

}
void attempt_apprentice(object who) {
  if ((int)who->query("bai_wufeng") == 1) {
    command("say 往事已成风，回来干什么？你还是走吧！\n");
    return 0;
  }


  if ((int)who->query_temp("killzyf") == 1) {
    command("chat 想不到你替老夫报了当年一剑之仇，老夫就将毕生武功都传于你！\n");
    command("recruit " + who->query("id"));
    who->set("title", "狂风剑派第二代关门弟子");
    who->set("bai_wufeng", 1);
    return 0;
  }

  command("say 哦！想拜老夫为师？\n");
  command("say 好！好！好！先提着张昱风小儿项上人头来。\n");
  who->set_temp("go_kill_zyf", 1);

  return 0;
}

int accept_object(object who, object ob) {
  if ((int)who->query("killzyf") == 1) {
    message_vision("吴风看了看$N，说道：往事已成风，你还是走吧！\n", ob);
    return 0;
  }

  if ((string)ob->query("id") == "zyf poll") {
    message_vision("吴风看了看$N送来的人头，仔细辨认了一阵，苦笑道：\n"
      "呵！呵！呵！张昱风小儿你也有今天。老天开眼啦！！！\n"
      "看你忠心耿耿，老夫就收下你这个弟子。\n", who);
    who->set_temp("killzyf", 1);
    destruct(ob);
    return 0;

  }

}
