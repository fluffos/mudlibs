// /u/xyx/震风武馆/obj/cloth.c

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("练功服", ({ "cloth" }) );
        set_weight(3500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 10);
        }
        setup();
}

