//qiang.c

#include <weapon.h>
#include <ansi.h>

inherit DAGGER;

void create() {
  set_name("长枪", ({ "jin qiang", "jin", "qiang" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把普通的长枪。\n");
    set("value", 10000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声亮出一把的$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n收了起来。\n");
  }
  init_dagger(50);
  setup();
}
