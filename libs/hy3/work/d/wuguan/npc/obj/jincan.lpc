#include <armor.h>
#include <ansi.h>

inherit ARMOR;
//inherit CLOTH;

void create()
{
        set_name(HIY"金蚕宝甲"NOR, ({ "jincan","baojia" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "gold");
                set("long", "这是一件用数万条细如蚕丝的金线制成。\n");
                set("value", 100000);
                set("armor_prop/armor", 100);
        }
        setup();
}

