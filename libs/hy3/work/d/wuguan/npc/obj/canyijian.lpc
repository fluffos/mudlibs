// chanyijian.c 蝉翼剑
#include <weapon.h>
#include <ansi.h> 
inherit SWORD;
inherit F_UNIQUE1;  
void create()
{
        set_name(YEL"蝉翼剑"NOR, ({ "chanyi jian","jian" }));
        set_weight(2000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "这是一柄绝世宝剑，剑身薄如蝉翼。\n据说当此剑划过自己喉管时，自己根本感觉不到，当你发觉时你已经死了。\n");
                set("value", "300000");
                set("unique",1);
                set("no_put",1);
                set("no_steal",1);
                set("rigidity",300);
                set("replica_ob","/d/city/npc/obj/changjian");
                set("material", "steel");
                set("wield_msg", "$N「嗖」的一声不知从哪儿抽出一柄寒光四射的$n握在手中。\n");
                set("unwield_msg", "$N将手中的一挥$n消失得无影无踪。\n");
        }
        init_sword(400);
        setup();
}
