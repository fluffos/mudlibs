//ling-xiaoer.c 凌宵儿
#include <ansi.h>
inherit NPC;
void consider();
string ask_me();
void create()
{
        set_name("凌宵儿", ( {"ling ziaoer","ling","xiaoer"} ) );
        set("long","她就是震风武馆掌门人张昱风爱妻。\n" );
        set("attitude", "peaceful");
        set("age", 35);
        set("gender", "女性");

        set("con", 24);
        set("dex", 22);
        set("int", 27);
        set("str", 29);
	set("ker", 22);
	set("per", 30);
        set("max_jing", 100);
        set("max_neili", 3000);
        set("max_qi", 700);
        set("jing",100);
        set("neili",3000);
        set("qi",700);
        set("jiali", 30);

        set("combat_exp", 55000);

        set_skill("sword",  60);
        set_skill("dodge", 150);
        set_skill("force", 30);
        set_skill("literate",90);
        set_skill("parry", 40);
        set_skill("unarmed", 180);
        set_skill("zfwy-bu", 150);

	map_skill("dodge", "zfwy-bu");
	set("inquiry", ([
		"天书" : (: ask_me :),
		"tianshu" : (: ask_me :),
		"book" : (: ask_me :),
		"书" : (: ask_me :),
	]));
	set("book_count", 1);
        set_temp("greeting",0);//清除标志
        setup();

        carry_object(__DIR__"obj/silk")->wear();

}
string ask_me()
{
	object ob;
	
	if (query("book_count") < 1)
		return "你来晚了，天书不在此处。";

	return "好吧反正我也看不懂，为报答救命大恩，把“蒙面人A的尸体”给我，这本书归你了。";
}

void talk(int i)
{
    object ren;
    if (!ren=present("menmian ren",environment())){
       set_temp("greeting",0);
       return;
    }

    switch (i){
    case 1:
        remove_call_out("do_talk1");
        call_out("do_talk1", 7, ren);
        break;
    case 2:
        remove_call_out("do_talk2");
        call_out("do_talk2", 7, ren);
        break;
    case 3:
        command("say 这位大侠快救我！！");
        break;

     }
}
void do_talk1()
{
    object ren;
    if (!ren=present("menmian ren",environment())){
        set_temp("greeting",0);
        return;
    }
        command("say 啊！什……什么书啊字的！老娘不知道！");
        ren->do_talk(1);   
        return 0;
}
void do_talk2()
{
    object ren;
    if (!ren=present("menmian ren",environment())){
        set_temp("greeting",0);
        return;
    }
	message_vision("$N吓得连退数步\n\n",this_object());
        command("say 少说费话！死也不会交给你这种人！");
        ren->do_talk(2);
        return 0;
}
int accept_object(object who, object ob)
{

        if ( (string) ob->query("name") =="蒙面人B的尸体") 
	{
	add("book_count", -1);
	ob = new("/u/xyx/obj/book/bladebook");
	ob->move(this_player());
	command("say 大侠救命之恩，奴家此身难报，这书是你的了！");
	command("rumor "+this_player()->query("name")+"得到一本无字天书！");
        return 1;
        }

        return 0;
}

