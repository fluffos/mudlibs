#include <ansi.h>
inherit NPC;

void create() {
  set_name("疯老头", ({ "feng laotou", "feng", "laotou" }));
  set("long",
    "一个疯疯颠颠的老头，看来武功很高！\n");
  set("attitude", "aggressive");
  set("chat_msg", ({
    (: random_move :),
  }));
  set("age", 64);
  set("max_jing", 10000);
  set("jing", 10000);
  set("max_qi", 10000);
  set("qi", 10000);
  set("max_neili", 50000);
  set("neili", 100000);
  set("jiali", 1000);
  set("combat_exp", 10000000);
  set("pursuer", 1);

  set("cps", 100);
  set("spi", 100);
  set("int", 100);
  set("cor", 100);
  set("per", 100);
  set("kar", 100);
  set("str", 100);
  set("con", 100);

  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("unarmed", 500);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object("/u/xyx/obj/book/forcebook");
}
void init() {
  object me, ob;
  ::init();
  if (interactive(me = this_player())) {
    if (!(ob = present("xionghuang", this_player()))) {
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, me);
    }
  }
}
