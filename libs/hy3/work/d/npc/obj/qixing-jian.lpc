#include <ansi.h>
#include <weapon.h>
inherit SWORD;

void create() {
  set_name(HIW "七星" NOR "宝剑", ({ "qixing jian", "jian", "sword" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄传说中的上古神兵，据说此剑能吸收北斗七星精华而为几用，威力无穷。\n");
    set("value", 8000);
    set("material", "steel");
    set("weapon_prop/personality", 150);
    set("wield_msg", "$N「唰」的一声抽出一柄寒光闪闪的$n握在手中,刹那间四周充满了一股肃杀之气。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(200);
  setup();
}
