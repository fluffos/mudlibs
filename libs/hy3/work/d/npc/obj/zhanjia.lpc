#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name("英雄战甲", ({ "yingxiong zhanjia", "jia" }));
        set_weight(2000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是一件银光闪闪的宝甲，通体用天山雪蚕丝织成，坚韧无比
刀剑不能伤。\n");
                set("material", "cloth");
                set("unit", "件");
                set("value", 1000000);
                set("no_drop", "这样东西不能离开你。\n");
                set("no_sell", "这样东西不能离开你。\n");
                set("armor_prop/armor", 1000);
        }
        setup();
}

