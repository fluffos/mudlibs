#include <ansi.h>
inherit NPC;

int do_weapon();
object creat_weapon();

void create()
{
        set_name("欧冶子", ({ "ouye zi", "zi" }) );
        set("nickname", RED "赤心剑胆" NOR );
          set("title", "玄天派开山祖师" );
        set("gender", "男性" );
        set("age", 60);
        set("long",     
            "他头上包着头巾，三缕长髯飘洒胸前，面目清瘦但红晕有光，\n"
            "二目炯炯有神，烁烁闪着竟似是凛凛的剑光，浑身似乎都包围\n"
            "在一股剑气之中。\n");
        set("str", 25);
        set("dex", 20);
        set("con", 17);
        set("int", 30);
        set("shen_type", 0);
        set("max_neli",5000);
        set("jiali",50);

        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("claw",200);
        set_skill("jiuyin-baiguzhao",200);
        set_skill("force",150);
        set_skill("sword",150);
        set_skill("bibo-shengong",100);
        set_skill("luoying-shenjian",100);
        set_skill("parry",90);
        set_skill("anying-fuxiang",100);
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/damage",50);

//          create_family("玄天派",1,"弟子");

        set("combat_exp", 250000);
        set("score",0);
        
        map_skill("force","bibo-shengong");
        map_skill("parry","luoying-shenjian");
        map_skill("sword","luoying-shenjian");
        map_skill("claw","jiuyin-baiguzhao");
        map_skill("dodge","anying-fuxiang");

        
        set("attitude", "peaceful");
        
        set("inquiry", ([
            "铸剑"  : "铸剑可是件十分艰苦的事，要消耗人的精气和内力，你有决心和毅力吗？\n",
            "原料"  : "铸剑可用千年玄铁。。。你找到了我才能帮你铸剑。\n",
       ]) );
            set("no_get",1);
        setup();
        set("chat_chance", 3);
        set("chat_msg", ({
             "欧冶子抚剑而歌：巨阙神兵兮，人铸就。盖世宝剑兮，配英雄！\n",
             "欧冶子低头沉吟，似乎在思考什么。\n"
             "欧冶子叹了一口气：神兵配英雄，可英雄。。。。。。\n"
       }) );
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
}

void init()
{
        ::init();
        add_action("do_answer","answer");
        add_action("do_change_type","change_type");
        add_action("do_change_color","change_color"); 
        add_action("do_change_name","change_name");
}

int do_change_color(string arg)
{
        object me=this_player(),weapon,gold; 

        if( !me->query("weapon") )
             return notify_fail("你还没有自己的兵器，怎么改啊？\n");     

        if( !arg )
            return notify_fail("你要改变兵器为什么颜色？\n");

        if( strlen(arg) > 12 )
            return notify_fail("颜色字符太长了，选短一点！\n");

        if( !objectp(gold=present("gold",me)) || !gold->query("money_id") ||
           gold->value() < 1000000)
           return notify_fail("你身上的钱不够了！\n");

        gold->add_amount(-100);
        me->set("weapon/color",arg);
        me->save();
        UPDATE_D->check_user(me);
        write("改好了，请看看效果吧！\n");
        return 1;
}

int do_change_type(string arg)
{
        object me=this_player(),weapon;

        if( !me->query("weapon") )
             return notify_fail("你还没有自己的兵器，怎么改啊？\n");

        if( me->query("weapon/change_type") >= me->query("zhuanshi/times") )
             return notify_fail("你这辈子不能再改了，等下辈子吧！\n");

        if( !arg )
        {
              write("有以下几种类型可以选择，请选择中文类型：\n"+
              "     剑(jian)\n"+
              "     刀(dao)\n"+
              "     棍(gun)\n"+
              "     杖(staff)\n"+
              "     鞭(whip)\n");             
             return notify_fail("你要把自己的兵器改成什么类型？\n");
        }

        if( arg == me->query("weapon/type") )
             return notify_fail("你的兵器不是和原来同类型吗？\n");   
          
        switch (arg) {
          case "剑" :
                me->set("weapon/file","/d/npc/m_weapon/weapon/m_sword");
                break;
          case "刀" :
                me->set("weapon/file","/d/npc/m_weapon/weapon/m_blade");
                break;
          case "棍" :
                me->set("weapon/file","/d/npc/m_weapon/weapon/m_club");
                break;
          case "杖" :
                me->set("weapon/file","/d/npc/m_weapon/weapon/m_staff");
                break;
          case "鞭" :
                me->set("weapon/file","/d/npc/m_weapon/weapon/m_whip");
                break;

          default :
                message_vision(HIC "欧冶子一脸狐疑：改什么类型？\n" NOR,me);
                return notify_fail("欧冶子仔细的说：此事不可儿戏，请慎重！\n");
        }

        tell_object(me, "你将自己的兵器类型改成——"+HIR+arg+NOR+"\n");
        me->set("weapon/type",arg);
        me->add("weapon/change_type",1);
        me->save();
        UPDATE_D->check_user(me);
        return 1;
}

int do_change_name(string arg)
{
        object me=this_player(),weapon,gold; 
        string w_name,id;
        int i;

        if( !me->query("weapon") )
             return notify_fail("你还没有自己的兵器，怎么改啊？\n");     

        if( !arg )
            return notify_fail("想好名称及代号后再来改！\n");

        sscanf(arg ,"%s %s" ,w_name ,id);

        if( !w_name || !id)
            return notify_fail("使用 change_name <名字> <英文代号> 格式！\n");

        if( strlen(w_name) > 10 || strlen(id)> 10 )
            return notify_fail("名字太长了，选短点！\n");

        i = strlen(id);
        while(i--)
        if( id[i]<'a' || id[i]>'z' )
            return notify_fail("对不起，英文代号只能用英文字母。\n");

        if( !objectp(gold=present("gold",me)) || !gold->query("money_id") ||
           gold->value() < 1000000)
           return notify_fail("你身上的钱不够了！\n");

        gold->add_amount(-100);

        me->set("weapon/id",id);
        me->set("weapon/name",w_name);
        me->save();
        UPDATE_D->check_user(me);
        write("改好了，请看看效果吧！\n");
        return 1;
}

int accept_object(object who, object ob)
{       
        object *ilist;
        int i;

       if(!ob->query("money_id"))
       {
       if((who->query("weapon/make")) ){
                say("欧冶子一脸茫然：您已经有一把自造的武器了，还来干什么？难到不可手么？\n");
       call_out("destrory",0,ob);
                return 2;
        }
        switch ((string)ob->query("name") ) 
        {
                case "千年神木": 
                        who->set_temp("or",1);
                        who->set_temp("get_orc",1);
                        break;
                case "海底金母":
                        who->set_temp("or",2);
                        who->set_temp("get_orc",1);
                        break;
                case "寒丝羽竹": 
                        who->set_temp("or",3);
                        who->set_temp("get_orc",1);
                        break;
                default :
                        message("vision","这是什么！这不能用来打造兵器！",who);
                        return 2;
        }
        message("vision","欧冶子低头检视了一下手中的"+(string)ob->query("name")+
                        "点了点头说：\n",who);

        write("我这儿可以打造以下兵器：\n"+
              "     剑(jian)\n"+
              "     刀(dao)\n"+
              "     棍(gun)\n"+
              "     杖(staff)\n"+
              "     棰(hammer)\n"+
              "     鞭(whip)\n");               
        say("这位"+RANK_D->query_respect(who)+"要造什么兵器？决定了告诉我(answer)。\n");
        call_out("destrory",0,ob);
        return 2;
       }

        if (ob->value() >= 1000000)
        {
        if (!(int)who->query("weapon/make") || !who->query("weapon/file") )
         return notify_fail("您的兵器在下实在无能为力！\n");
         ilist=all_inventory(who);
         for(i=0;i<sizeof(ilist);i++)
         if(ilist->query("id") == who->query("weapon/id"))
         {
          write("你身上的兵器不是好好的吗？\n");
          return 0;
         }
         message_vision("$N看了看$n，叹了口气道：难得你如此诚心，我就再"
         +"给你造一把。\n", this_object(),who);

         call_out("make_weapon",10,ob,this_object(),who);
         return 1;
        } else
        {
         write("无功不受禄，我可不能收随便收人好处呀！\n");
         return 0;
        }
}

int do_answer(string arg)
{
        object me,w_or;
        me = this_player();
        if(!(me->query_temp("get_orc") ) ){
                write("你找到原料了吗？\n");
                return 0;
        }
        
        if(!arg){
           write("你要造什么兵器？\n");
          return 0;
        }
        message("vision",me->name()+"对欧冶子轻声说了几句。\n",environment(me), ({me}) );
        switch (arg) {
          case "jian" :
                me->add_temp("sword",1);
                write("带着原料去找侍剑吧!\n");
                message("vision","去吧！"+me->name()+"!\n",me);
                break;
          case "dao" :
                me->add_temp("blade",1);
                write("带着原料去找侍刀吧!\n");
                message("vision","去吧！"+me->name()+"!\n",me);
                break;
          case "gun" :
                me->add_temp("club",1);
                write("带着原料去找侍棍吧!\n");
                message("vision","去吧！"+me->name()+"!\n",me);
                break;
          case "staff" :
                me->add_temp("staff",1);
                write("带着原料去找侍杖吧!\n");
                message("vision","去吧！"+me->name()+"!\n",me);
                break;
          case "whip" :
                me->add_temp("whip",1);
                write("带着原料去找侍鞭吧!\n");
                message("vision","去吧！"+me->name()+"!\n",me);
                break;
          case "hammer" :
                me->add_temp("hammer",1);
                write("带着原料去找侍棰吧!\n");
                message("vision","去吧！"+me->name()+"!\n",me);
                break;

          default :
                message_vision(HIC "欧冶子一脸狐疑：什么兵器？\n" NOR,me);
                return notify_fail("欧冶子仔细的说：此事不可儿戏，请慎重!!\n");
        }
        switch ( me->query_temp("or") ) {
          case 1:
                w_or = new("/d/npc/m_weapon/tan/item/shenmu",1);
                w_or->move(me);
                message_vision(HIC "欧冶子给了$N一块千年神木\n" NOR, me);
                break;
          case 2:
                w_or = new("/d/npc/m_weapon/tan/item/jinmu",1);
                w_or->move(me);
                message_vision(HIC "欧冶子给了$N一块海底金母\n" NOR, me);
                break;
          case 3:
                w_or = new("/d/npc/m_weapon/tan/item/hanzhu",1);
                w_or->move(me);
                message_vision(HIC "欧冶子给了$N一块寒丝羽竹\n" NOR, me);
                break;
        }
        me->delete_temp("or");
        return 1;
}
void destrory(object ob)
{
      destruct(ob);
     return;
}

int make_weapon(object obj,object ob,object me)
{
   if(objectp(ob) &&objectp(me))
   if(present(me->query("id"),environment(ob)))
   {
    tell_object(me,HIY"过了一会儿，一名弟子满头大汗地跑过来，交给你一把"+me->query("weapon/name")+"。\n"
    +"欧野子朝你点点头，说道：东西在这里了，没事就请离开吧！\n"NOR);
    new(me->query("weapon/file"))->move(me);

    if( obj )
    destruct(obj);
    return 1;
   }
   return 0;
}

