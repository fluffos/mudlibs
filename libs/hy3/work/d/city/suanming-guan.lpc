#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", HIC"算命馆"NOR);
        set("long", @LONG
一家简陋的算命馆。看起来冷冷清清，算命先生正坐在书案前闭目养神。
案旁挑着一根竹竿，上头挂着一条布条(butiao)。
LONG
        );
        set("no_fight", 1);
        set("no_beg",1);
        set("item_desc", ([
                "butiao": @TEXT
本馆算命，童叟无欺，100两黄金一个，不二假，不赊帐。
TEXT
        ]) );
        set("objects", ([
                __DIR__"npc/huo" : 1,
        ]));

        set("exits", ([
                "north" : __DIR__"dangpu",
        ]));
        set("indoors", "city");
        setup();
        replace_program(ROOM);
}

