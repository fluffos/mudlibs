// feizei.c
//星星(lywin)2000/5/30为一个任务系统写此npc
//rewrited by xingyun

#include <ansi.h>
inherit NPC;
int get_level(int exp);  
void create()
{
  object me=this_player();
  int level,exp;

  exp=me->query("combat_exp")*2/(random(3)+3);
  level=get_level(exp); 

  set_skill("taiji-quan",level);
  set_skill("dodge", level);
  set_skill("parry", level);
  set_skill("sword", level);
  set_skill("unarmed", level);
  set_skill("taiji-jian", level);
  set_skill("force", level);
  set_skill("taiji-shengong", level);
  set_skill("tiyunzong", level);

  map_skill("sword", "taiji-jian");
  map_skill("force", "taiji-shengong");
  map_skill("parry", "taiji-quan");
  map_skill("unarmed", "taiji-quan");
  map_skill("dodge", "tiyunzong");

  set("combat_exp", exp);
  set("max_qi",me->query("max_qi")*2/5);
  set("qi",query("max_qi"));
  set("max_jing",me->query("max_jing")/2);
  set("jing",query("max_jing"));
  set("max_neili",me->query("max_neili")/2);
  set("neili",query("max_neili"));
  set("max_jingli",query("max_neili"));    
  set("jingli",query("max_neili"));    
  set("jiali",20);  

  set_name("小毛贼",({ "mao zei","zei" }) );
        set("title",HIY"飞天遁地"NOR);
        set("gender", "男性" );
        set("long", 
"这是无恶不做的小毛贼，背上有一个小小包裹，看样子是才偷了不少银子。\n");

        set("int", 30);
        set("str", 25);
        set("con", 25);
        set("dex", 25);
        set("killer", me->query("id"));       
        set("age", 10+random(30));
        set("per", 14+random(20));
        if( exp > 3000000)
        {
         set("chat_chance_combat", 30);
         set("chat_msg_combat", ({
                (: perform_action, "unarmed.zhen" :),
                (: perform_action, "sword.lian" :),
         }) );
        }
        if( exp > 6000000) set("family/family_name","武当派");
        setup();
        carry_object( __DIR__ "changjian")->wield();
        carry_object("/clone/cloth/cloth")->wear();
        add_money("silver", random(200));
        call_out("check_me", 1);  
}

int get_level(int exp)
{
  int level=0;
  do {
      level++;
     } while(level*level*level<(exp*10));

  return level-10;
}

int check_me()
{
    object me=this_object(),ob;

    if(!objectp(me) || !environment(me) )
    return 1;  

    if(!me->query("killer") 
       || !ob=present(me->query("killer"),environment(me)))
    {
     remove_call_out("check_me");
     call_out("escape_me",1,me);
    } else
    {
     if(!ob->is_fighting(me))
     kill_ob(ob);
     remove_call_out("check_me");
     call_out("check_me",3);

     return 1;
    }
}

void die()
{
   object ob=this_object();
   message_vision(HIC"小毛贼啊的一声惨号，倒地而死！\n"NOR,ob);
   remove_call_out("check_me"); 
   destruct(ob);
   return;
}

void escape_me(object me)
{
    destruct(me);
    return;
}     

