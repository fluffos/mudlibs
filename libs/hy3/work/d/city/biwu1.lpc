// biwu1.c

inherit ROOM;
void create() {
  set("short", "擂台进口");
  set("long", @LONG
        这里是去擂台的入口，从这里以可以听到时面
兵刃相见的声音了，你加快了脚步想进去看看.
LONG
  );
  set("no_new_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "up": __DIR__ "biwu2",
    "north": "/d/city/wumiao",
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  mixed *local;
  local = localtime(time());
  if (dir == "east" && (local[6] == 6 || local[6] == 0))
    return notify_fail("今天擂台坏了!\n");
  if (!userp(me) && dir == "east") return 0;
  return ::valid_leave(me, dir);
}
