// jinsijia.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIY "金丝甲" NOR, ({ "jinsi jia", "jia" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("no_beg", "1");
    set("no_steal", "1");
    set("no_drop", "1");
    set("value", 300000);
    set("material", "leather");
    set("armor_prop/armor", 100);
  }
  setup();
}
