// wineskin.c  酒袋
#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

void create()
{
         set_name(HIR"喜酒"NOR, ({"xijiu"}));
	set_weight(700);
	if (clonep())
		set_default_object(__FILE__);
	else {
                   set("long", "一瓶茅台酒。\n");
                 set("unit", "瓶");
                 set("value", 5000);
		set("max_liquid", 15);
	}

	// because a container can contain different liquid
	// we set it to contain wine at the beginning
	set("liquid", ([
		"type": "alcohol",
                 "name": "茅台酒",
		"remaining": 15,
		"drunk_apply": 3,
	]));
}
