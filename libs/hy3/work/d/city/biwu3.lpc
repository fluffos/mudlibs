// biwu3.c
// change by edward

inherit ROOM;
void create()
{
    set("short", "擂台");
    set("long", @LONG
        这里是扬州的比武擂台是为了大家在这比武用的。
        
LONG
    );
    set("exits", ([ /* sizeof() == 1 */
  "down" : __DIR__"biwu2",
]));
    set("no_new_clean_up", 0);
         set("no_die", 1);
    set("fight_room", __DIR__"biwu2");
    set("no_sleep_room",1);
    setup();
}
void relay_message(string msg)
{
    object look_fight_room;
   string *msgs;
    int i;
    if (!look_fight_room=find_object("/u/edward/biwu2"))
    look_fight_room=load_object("/u/edward/biwu2");
   msgs=explode(msg, "\n");
    for (i=0;i<sizeof(msgs);i++)
    if (strlen(msgs[i])>5)
    message("vision",NOR+"现场直播-->"+msgs[i]+"\n",look_fight_room);
}
int valid_leave(object me, string dir)
{
   if (me->is_fighting() && dir=="down")
        return notify_fail("临阵脱逃， sih！\n");
         return ::valid_leave(me, dir);
}

