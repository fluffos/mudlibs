int do_kiss(string arg)
{
        object usr, ob;
        usr = this_player();
        ob = this_object();
        if( environment(usr)->query("no_fight") ) return 0;
        if (!arg) return 0;
        if(!objectp(ob = present(arg, environment(ob)))) return 0;
        if( ob->query("name")=="丝丝" && !userp(ob)) {
                if( usr->query("name")!="尹天仇" && !userp(ob)) {
                        command( "rumor " + usr->query("name") + "企图调戏丝丝！\n" );
                        say(CYN"丝丝说道：姑奶奶我的便宜你也干占！！！\n\n"NOR);
                        say(HIW"只见丝丝有条不紊翻起衣袖，当场给了" + usr->query("name") + "一记响亮的耳光！\n\n"NOR);
                        usr->add("jing",-30);
                        command( "rumor 结果," + usr->query("name") + "给丝丝扇了个愉快的耳光！\n" );
                        return 1;
                }
                say(CYN"尹天仇轻轻地捧起丝丝的脸，给了她一个无限温柔的吻。\n\n"NOR);
                command( "xixi " + usr->query("id") );
                say(CYN"丝丝娇嘀嘀地对尹天仇说到：“老公我好喜欢你哦.....”\n"NOR);
                return 1;
        }
        return 0;
}

void relay_emote(object me,string arg)
{
        command(arg+" "+me->query("id"));
}
