inherit NPC;
#include <ansi.h>
inherit F_UNIQUE;

void consider();
void create()
{
        set_name("丝丝", ({"sisi"}));
        set("long",HIM"她生得沉鱼落雁，国色天香，世上少有的美人胚子。\n"NOR
+"他虽然年纪青但是江湖阅历不浅，别欺负他哦！\n"
);
        set("title", HIR"尹天仇爱妻"NOR);
        set("gender", "女性");
        set("age", 23);
//        set("attitude", "peaceful");

        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("qi", 200000);
        set("max_qi", 200000);
        set("max_jing", 20000);
        set("jing", 20000);
        set("neili", 100000);
        set("max_neili", 100000);
        set("combat_exp", 50000000);
        set("score", 1000);
        set("jiali",300);


        set_skill("force", 30);
        set_skill("dodge", 500);
        set_skill("sword", 500);
        set_skill("pixie-jian", 500); 
        set_skill("qiankun-danuoyi", 500); 
        set_skill("tiyunzong", 500);
        set_skill("unarmed", 30);
        set_skill("parry", 500);
        set_skill("taiji-shengong", 30);
        set_skill("taiji-quan", 30);

        map_skill("sword","pixie-jian");        
        map_skill("dodge","tiyunzong");
        map_skill("force","taiji-shengong");
        map_skill("unarmed","taiji-quan");
        map_skill("parry","qiankun-danuoyi");


        setup();

        carry_object("/clone/misc/cloth")->wear();
        carry_object("/d/city/obj/changjian")->wield();


}


void init()
{
        object ob;

        ::init();
        add_action("do_kill", "kill");
        add_action("do_touxi", "touxi");
        add_action("do_fight", "fight");
        add_action("do_hit", "hit");
        add_action("do_kiss", "kiss");
        add_action("do_kick", "kick");
        add_action("do_steal", "steal");
        add_action("do_slapslap", "slapslap");
        add_action("do_slap", "slap");

       if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)

{
        string myfamily;
        if( !ob || environment(ob) != environment() ) return;
        myfamily=getuid(ob);
        if( myfamily == "hsly" ) {
            switch( random(3) ) {
                case 1:
                  command("bow " + ob->query("id"));
                case 2:
                 say(CYN"丝丝娇声娇气的说：“老公你回来啦！你把人家想死了.....”\n"NOR);
                case 3:
                  command("jump " + ob->query("id"));
                case 4:
                  command("ppp " + ob->query("id"));
                  break;
            }
        }

        if( myfamily != "hsly" ){
            switch( random(3) ) {
                case 1:
                  command("bow " + ob->query("id"));
                case 2:
                 say(CYN"丝丝说到：“我老公没在，您有什么事吗？”\n"NOR);
                  break;
             }
         }


}

int do_kill(string arg)
{
        object usr, ob;
        usr = this_player();
        ob = this_object();
        if( environment(usr)->query("no_fight") ) return 0;
        if (!arg) return 0;
        if(!objectp(ob = present(arg, environment(ob)))) return 0;
        if( ob->query("name")=="丝丝" && !userp(ob)) {
                command( "chat 老公快来啊！" + usr->query("id") + "想杀了我！！！\n" );
                say(GRN"尹天仇的身影突然出现在一阵烟雾之中。\n"NOR);
                say(CYN"尹天仇说道：连我老婆你也敢碰？！！不知趣的东西！！！\n\n"NOR);
                say(HIR"只见尹天仇提起" + usr->query("name") + "的衣领噼里啪啦打了它几十个耳光！\n\n"NOR);
                usr->set("qi",-1);
                usr->set("jing",0);

                say(CYN"尹天仇说道：哼！给你小子一个教训！看你下次还敢不敢！\n"NOR);
                say(HIM"只见一阵烟雾过後，尹天仇的身影已经不见了。\n"NOR);
         usr->move("/d/death/gate");
                command( "rumor 听说" + usr->query("id") + "被人活活的抽耳光抽死了！！！真是可悲可叹啊！\n" );
                return 1;
        }
        return 0;
}
int do_touxi(string arg)
{
        object usr, ob;
        usr = this_player();
        ob = this_object();
        if( environment(usr)->query("no_fight") ) return 0;
        if (!arg) return 0;
        if(!objectp(ob = present(arg, environment(ob)))) return 0;
        if( ob->query("name")=="丝丝" && !userp(ob)) {
                command( "chat 老公快来啊！" + usr->query("id") + "想偷袭我！！！\n" );
                say(HIR"尹天仇的身影突然出现在一阵烟雾之中。\n"NOR);
                say(CYN"尹天仇说道：连我老婆你也敢偷袭？！！不知趣的东西！！！\n\n"NOR);
                say(HIR"只见尹天仇提起" + usr->query("name") + "的衣领噼里啪啦打了它几十个耳光！\n\n"NOR);
                usr->set("qi",-1);
                usr->set("jing",0);

                say(CYN"尹天仇说道：哼！给你小子一个教训！看你下次还敢不敢！\n"NOR);
                say(HIM"只见一阵烟雾过後，尹天仇的身影已经不见了。\n"NOR);
         usr->move("/d/death/gate");
                command( "rumor 听说" + usr->query("id") + "被人活活的抽耳光抽死了！！！真是可悲可叹啊！\n" );
                return 1;
        } 
        return 0;
}

int do_slap(string arg)
{
        object usr, ob;
        usr = this_player();
        ob = this_object();
        if( environment(usr)->query("no_fight") ) return 0;
        if (!arg) return 0;
        if(!objectp(ob = present(arg, environment(ob)))) return 0;
        if( ob->query("name")=="丝丝" && !userp(ob)) {
                command( "chat 老公快来啊！" + usr->query("id") + "他打我！！！\n" );
                say(HIR"尹天仇的身影突然出现在一阵烟雾之中。\n"NOR);
                say(CYN"尹天仇说道：连我老婆你也敢碰？！！不知趣的东西！！！\n\n"NOR);
                say(HIR"只见尹天仇提起" + usr->query("name") + "的衣领[啪]的一声扇了他一个响亮的耳光！\n\n"NOR);
                usr->set("qi",-1);
                usr->set("jing",0);

                say(CYN"尹天仇说道：哼！给你小子一个教训！看你下次还敢不敢！\n"NOR);
                say(HIM"只见一阵烟雾过後，尹天仇的身影已经不见了。\n"NOR);
                return 1;
        }
        return 0;
}

