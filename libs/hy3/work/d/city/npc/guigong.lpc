#include <ansi.h>
inherit NPC;

void create() {
  set_name("龟公", ({ "guigong" }));
  set("gender", "无性");
  set("age", 32);
  set("long", "一名丽春院龟公，逼良为娼，坏事做绝。");
  set("str", 65);
  set("dex", 35);
  set("con", 25);
  set("int", 25);
  set("shen_type", -1);

  set_skill("unarmed", 60);
  set_skill("force", 20);
  set_skill("dodge", 55);

  set("combat_exp", 95000);

  set("max_qi", 300);
  set("max_jing", 100);
  set("neili", 200);

  set("chat_chance", 5);
  set("chat_msg", ({
    "龟公嘿嘿笑到：这里的姑娘可都是我亲自调教的，保证客人们满意。\n",
    "龟公冷笑道：进了这可就由不得自各了，不干满个十年八载，谁也甭想跳出去。\n",
  }));

  setup();
  carry_object("/d/city/obj/pink_cloth")->wear();
}
