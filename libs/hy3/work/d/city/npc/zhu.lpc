// zhu.c 朱熹

inherit NPC;
inherit F_DEALER;
#include <ansi.h>

string * degree_desc = ({
       BLU "文盲" NOR,
       BLU "童生" NOR,
       BLU "秀才" NOR,
       CYN "举人" NOR,
       CYN "解元" NOR,
       CYN "贡士" NOR,
       CYN "会元" NOR,
       GRN "进士" NOR,
       GRN "探花" NOR,
       GRN "榜眼" NOR,
       GRN "状元" NOR,
       HIY "翰林院士" NOR,
       HIY "翰林硕士" NOR,
       HIY "翰林博士" NOR,
       HIY "翰林院编修" NOR,
       HIR "庶吉士" NOR,
       HIR "学士" NOR,
       HIR "内阁大学士" NOR,
       HIR "内阁首辅" NOR,
       MAG "文学大宗师" NOR,
       HIW "圣人" NOR,
});
string clear_degree(string arg); 
string ask_buy();
int ask_degree();
void create()
{
        set_name("朱熹", ({ "zhu xi", "zhu" }));
        set("long",
"朱先生被称为当世第一大文学家，肚子里的墨水比海还要深。\n");
        set("gender", "男性");
        set("age", 65);
        set("jing", 10000);
        set("max_jingli", 10000);
        set("jingli", 10000);
        set("no_get", 1);
        set_skill("literate",500);
        set_skill("magic",500);  
        set_skill("fadai", 80);
        set_skill("unarmed", 80);
        set_skill("dodge", 80);
        set_skill("parry", 80);
        set_temp("apply/attack", 80);
        set_temp("apply/defense", 80);
        set_temp("apply/damage", 20);

        set("combat_exp", 400000);
        set("shen_type", 1);
        set("inquiry", ([
            "学位" : (:ask_degree:),
            "买书" : (:ask_buy:),
            "书"   : "唉!书到用时方恨少。",
            "借书" : "借？你不还我到哪里找你？哼!",
        ]));
        set("vendor_goods", ({
                "/clone/book/lbook1",
                "/clone/book/lbook2",
                "/clone/book/fadaibook",
                "/clone/book/lbook3"
        }));
        setup();

        set("chat_chance", 3);
        set("chat_msg", ({
                "朱熹说道：普天之下，莫非王土；率土之滨，莫非王臣。\n",
                "朱熹说道：出家人，小过损益焉；无妄大过，未济咸困之。\n",
                "朱熹说道：大学之道，在明明德。在亲民，在止于至善。 \n",
                "朱熹说道：格物致知，诚意正心，修身齐家，治国平天下。\n",
        }) );
}

int recognize_apprentice(object ob)
{
        if (!(int)ob->query_temp("mark/朱"))
                return 0;
        ob->add_temp("mark/朱", -1);
        return 1;
}

int accept_object(object who, object ob)
{
        object me = this_player();
        if (!(int)who->query_temp("mark/朱"))
                who->set_temp("mark/朱", 0);
        if (ob->query("money_id") && ob->value() >= 1000) {
                message_vision("朱熹同意指点$N一些读书写字的问题。\n", who);
                who->add_temp("mark/朱", ob->value() / 50);
/*
        if( me->query_skill("literate", 1) > 21){
        tell_object(me,"你现在已有一定的文化知识,也可以自己读书深造了。\n");
        return 1;}
*/
                return 1;
         }
}

string ask_buy()
{
//      int i;
        return "我这可有不少读书人必读的书哟!\n";
//        i = (int)me->query_temp("ask_book");
}

void init()
{
        object me = this_player();
        add_action("do_list","list");
        if( me->query_skill("literate", 1) > 21)
        add_action("do_buy", "buy");
        return ;
}

int ask_degree()
{
        int lv;
        string degree;
        object ob = this_player();
        lv = (ob->query_skill("literate",1) / 30);
        if (lv >= sizeof(degree_desc)) lv = sizeof(degree_desc)-1; 
        if( lv <= ob->query("degree_ask") )
        {
         command("say "+ob->query("name")
               +"，要获得更高的学位，必须继续深造文学知识才可以啊！\n");
         return 1;
        }

        degree=degree_desc[lv];
        if (lv > 10)
          command("say 果然是长江后浪逐前浪啊，"+ob->query("name")
                            +"，我非常荣幸能有机会为你授学位! \n"); 
        else
          if (lv > 3)
          command("say "+ob->query("name")
               +"，呃，不错，有前途，很高兴授予学位给你，继续好好努力! \n"); 
        else
          command("say "+ob->query("name")+"，你那点墨水也好意思问? 随便给你个学位就算了! \n");

        if( ob->query("degree") )
        {
         if( ob->query("degree_jungong") )
         degree=HIM " ☆ " NOR+degree
              +HIM " ☆ " NOR+clear_degree(ob->query("degree"))+HIM " ☆ "NOR;
         else
         degree=HIM " ☆ " NOR+degree
               +clear_degree(ob->query("degree"))+HIM " ☆ " NOR;
        } else
         degree=HIM " ☆ " NOR+degree
              +HIM " ☆ " NOR;

        ob->add("meili",lv*100);
        ob->set("degree",degree);
        ob->set("degree_ask",lv+1);
        return 1;
}

string clear_degree(string arg)
{
        if( (strsrch(arg, BLU "文盲" NOR) >= 0) ||
            (strsrch(arg, BLU "童生" NOR) >= 0) ||
            (strsrch(arg, BLU "秀才" NOR) >= 0) ||
            (strsrch(arg, CYN "举人" NOR) >= 0) ||
            (strsrch(arg, CYN "解元" NOR) >= 0) ||
            (strsrch(arg, CYN "贡士" NOR) >= 0) ||
            (strsrch(arg, CYN "会元" NOR) >= 0) ||
            (strsrch(arg, GRN "进士" NOR) >= 0) ||
            (strsrch(arg, GRN "探花" NOR) >= 0) ||
            (strsrch(arg, GRN "榜眼" NOR) >= 0) ||
            (strsrch(arg, GRN "状元" NOR) >= 0) ||
            (strsrch(arg, HIY "翰林院士" NOR) >= 0) ||
            (strsrch(arg, HIY "翰林硕士" NOR) >= 0) ||
            (strsrch(arg, HIY "翰林博士" NOR) >= 0) ||
            (strsrch(arg, HIY "翰林院编修" NOR) >= 0) ||
            (strsrch(arg, HIR "庶吉士" NOR) >= 0) ||
            (strsrch(arg, HIR "学士" NOR) >= 0) ||
            (strsrch(arg, HIR "内阁大学士" NOR) >= 0) ||
            (strsrch(arg, HIR "内阁首辅" NOR) >= 0) ||
            (strsrch(arg, MAG "文学大宗师" NOR) >= 0) || 
            (strsrch(arg, HIW "圣人" NOR) >= 0) ||
            (strsrch(arg, HIM " ☆ " NOR) >= 0) ) 
          {
            arg = replace_string(arg, BLU "文盲" NOR,"");
            arg = replace_string(arg, BLU "童生" NOR,""); 
            arg = replace_string(arg, BLU "秀才" NOR,"");
            arg = replace_string(arg, CYN "举人" NOR,"");   
            arg = replace_string(arg, CYN "解元" NOR,"");
            arg = replace_string(arg, CYN "贡士" NOR,"");   
            arg = replace_string(arg, CYN "会元" NOR,"");
            arg = replace_string(arg, GRN "进士" NOR,"");   
            arg = replace_string(arg, GRN "探花" NOR,"");
            arg = replace_string(arg, GRN "榜眼" NOR,"");   
            arg = replace_string(arg, GRN "状元" NOR,"");
            arg = replace_string(arg, HIY "翰林院士" NOR,"");   
            arg = replace_string(arg, HIY "翰林硕士" NOR,"");
            arg = replace_string(arg, HIY "翰林博士" NOR,"");   
            arg = replace_string(arg, HIY "翰林院编修" NOR,"");
            arg = replace_string(arg, HIR "庶吉士" NOR,"");   
            arg = replace_string(arg, HIR "学士" NOR,"");
            arg = replace_string(arg, HIR "内阁大学士" NOR,"");   
            arg = replace_string(arg, HIR "内阁首辅" NOR,"");
            arg = replace_string(arg, MAG "文学大宗师" NOR,"");   
            arg = replace_string(arg, HIW "圣人" NOR,"");
            arg = replace_string(arg, HIM " ☆ " NOR,"");
          }
          return arg;
}

