//shizhe.c change by drunk 8/9/2000
#include <ansi.h>
inherit NPC;

string ask_me();
string ask_shiwu();
string ask_cjliwu();
void create() {
  set_name(HIG "火云欢迎使者" NOR, ({ "huoyun shizhe", "shizhe" }));
  set("gender", "女性");
  set("age", 19);
  set("food", 50000);
  set("water", 50000);
  set("attitude", "peaceful");
  set("title", HIM "天使" NOR);
  set("long", "她就是专门给新玩家礼物的使者。你可以ask shizhe about liwu\n");
  set("combat_exp", 150000000);
  set("qi", 50000);
  set("max_qi", 50000);
  set("str", 500);

  set("is_quest", 1);
  set("inquiry", ([
    "liwu": (: ask_me :),
    "礼物": (: ask_me :),
    "奖品": (: ask_me :),
  ]));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
void init() {
  add_action("do_helpfood", "helpfood");
  add_action("do_kill", "team kill");
  add_action("do_kill", "kill");
  add_action("do_kill", "hit");
  add_action("do_kill", "fight");
  add_action("do_kill", "touxi");
  add_action("do_kill", "steal");
  add_action("do_kill", "beg");
  add_action("do_kill", "persuade");
}

string ask_me() {
  object ob;
  ob = this_player();
  if (ob->query("liwu2"))
    return "欢迎来到火云录！";
  ob->set("liwu2", 1);
  CHANNEL_D->do_channel(
    this_object(),
    "chat",
    sprintf(NOR WHT "欢迎%s" NOR WHT "来到火云录，并得到了我给的" HIR "礼物" NOR WHT "了!" NOR, ob->query("name"))
  );
  CHANNEL_D->do_channel(
    this_object(),
    "es",
    sprintf(
      NOR WHT "欢迎" HIR "%s" NOR WHT "来到" HBCYN HIY "火云录2001" NOR HIR "(210.83.0.195 2000)" NOR WHT "，并得到了我给的" HIG "礼物" HIR "(十万EXP、POT，200级literate、300级force)" NOR WHT "了!" NOR,
      ob->query("name")
    )
  );
  command("say " + ob->name(1) + ",祝您在火云录玩的愉快！");
  command("chat " NOR HIY + ob->query("name") + NOR WHT ",祝您在火云录玩的愉快！" NOR);
  ob->add("combat_exp", random(100000));
  ob->add("potential", random(100000));
  if ((int)ob->query_skill("literate", 1) < 100)
    ob->set_skill("literate", 100);
  if ((int)ob->query_skill("force", 1) < 100)
    ob->set_skill("force", 100);
  ob->save();
  return ob->query("name") + "，您得到了您的礼物了，快叫您的朋友来这里找我领取礼物！\n";

}

int do_kill(string arg) {
  string what, who;
  if (!arg) return 0;
  if (this_object()->id(arg)) {
    write("你不是我对手，不要送死了。\n");
    return 1;
  } else if (sscanf(arg, "%s from %s", what, who) == 2 && this_object()->id(who)) {
    write("还是到别处去施展你的本事吧。\n");
    return 1;
  }
  return 0;
}

int do_helpfood(string arg) {
  object m, n, mm;
  message_vision("$N向火云录欢迎使者问道：神使，开饭了吗？\n", this_player());

  if ((int)this_player()->query("food") >= (int)this_player()->max_food_capacity() * 90 / 100)
    return notify_fail("火云录欢迎使者笑道：等开饭时再来吧！\n");

  if ((int)this_player()->query("water") >= (int)this_player()->max_water_capacity() * 90 / 100)
    return notify_fail("火云录欢迎使者笑道：等开饭时再来吧！\n");

  if ((present("kaoya", this_player())))
    return notify_fail("火云录欢迎使者笑道：你还没吃完呢，怎么又要？\n");

  if ((present("jiudai", this_player())))
    return notify_fail("火云录欢迎使者笑道：你还没吃完呢，怎么又要？\n");
  if ((present("jitui", this_player())))
    return notify_fail("火云录欢迎使者笑道：你还没吃完呢，怎么又要？\n");

  m = new("/d/city/npc/obj/jiudai");
  mm = new("/d/city/npc/obj/kaoya");
  n = new("/d/city/npc/obj/jitui");

  m->move(this_player());
  mm->move(this_player());
  n->move(this_player());

  message_vision("火云录欢迎使者对$N笑道：饿了吧，拿去吃吧。\n", this_player());
  return 1;
}

void die() {
  object xyx;
  message_vision(HIR "\n$N死掉了。\n" NOR, this_object());
  message_vision(
    HIB "\n可是在此同时$N" HIB "口中默念" HIC "『" RED "还魂咒" HIC "』" HIB "四周妖风阵阵，慢慢的$N" HIB "又站了起来。\n" NOR,
    this_object()
  );
  xyx = new("/d/city/npc/shizhe");
  command("heihei");
  xyx->move(environment(this_object()));
  destruct(this_object());
  return;
}
