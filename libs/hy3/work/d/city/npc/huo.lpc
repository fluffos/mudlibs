// huo-banxian
#include <ansi.h>
inherit NPC;
string ask_me();
void create()
{
        set_name("霍半仙", ( {"huo banxian","huo","banxian"} ) );
        set("nickname",HIY"算命先生"NOR);
        set("long","一位精瘦的算命先生，找他算命据说是百无一误。 \n" );
        set("attitude", "peaceful");
        set("age", 45);
        set("gender", "男性");
        set("food", 500);
        set("water", 500);
        set("con", 30);
        set("water", 500);
        set("food", 5000);
        set("dex", 30);
        set("int", 30);
        set("ker", 30);
        set("max_jing", 1000);
        set("max_neili", 50000);
        set("max_qi", 35000);
        set("jing",1000);
        set("neili",8000);
        set("qi",5000);
        set("jiali", 100);
        set("combat_exp", 500000);

        set("inquiry", ([
                "算命"  : (: ask_me :),
        ]));                 

        setup();
        carry_object("/clone/misc/cloth")->wear();
}

string ask_me()
{
        object me=this_player();
        int age1,age2;

        age1=(int)me->query("age_limit")-random(10);
        age2=(int)me->query("age_limit")+random(10);

        if(me->query_temp("fortune_tell/payed"))
        {
        me->delete_temp("fortune_tell/payed");
        return RANK_D->query_respect(me)
        +"，您的寿命大致是"+sprintf(HIW"%d ～ %d"NOR,age1,age2)+CYN"岁！\n"NOR; 
        }

        return "算一次命100两黄金，绝不赊帐，现付现算，童叟无欺！\n";
}

int accept_object(object who, object ob)
{
       if (ob->query("money_id") && ob->value() >= 1000000)
       {
        who->set_temp("fortune_tell/payed",1);
        return 1;
       } else
       return 0;
}       

