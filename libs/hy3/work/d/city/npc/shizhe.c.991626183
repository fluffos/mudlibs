#include <ansi.h>
inherit NPC;
string *msg = ({
        "新手多多help拉，如help news,help change,help renwu!n",
        "我们的主页地址是 http://61.133.87.170/mud,欢迎访问!n",
        "我们的奖励是10万EXP、POT，200级读书、300级基本内功!\n",
        "我们的论坛是 http://61.133.87.170/bbs,欢迎访问! 
        "欢迎您来火云录作客，我们的地址是 61.133.87.170 2000\n",
        });

string ask_me();
string ask_shiwu();
void create()
{
        set_name(HIG "火云欢迎使者" NOR, ({ "hyl shizhe","hyl","shizhe" }) );

        set("gender", "女性");
        set("age", 19);
        set("attitude", "peaceful");
        set("title", HIG"天使"NOR);
        set("long","她就是专门给新玩家礼物的使者。你可以ask shizhe about liwu\n");
        set("combat_exp", 150000000);
        set("qi", 50000);
        set("max_qi", 50000);
        set("str", 500);
        set("chat_chance", 3); 
        set("chat_msg", ({
              (: command("es " HIG"火云录重新开站，"HIB"IP:"HIR"61.133.87.170 "HIB"PORT:"HIR"2000 "HIG"请新老玩家相互转告。\n"NOR) :),
             (: command("es " HIW"火云录全新的开始，全新的任务。\n"NOR) :),
             (: command("es " HIY"火云录奖励十万EXP，200级读书，300级内功，一来就是高手。\n"NOR) :),
             }));
        set("inquiry", ([
                "liwu" : (: ask_me :),
        ]));
        setup();
        carry_object("/clone/misc/cloth")->wear();
}
void init()
{
        add_action("do_helpfood", "helpfood");
}
hehe

string ask_me()
{
        object ob;
        ob=this_player();
        if (ob->query("liwu2"))
                return "欢迎来到火云录！";
        ob->set("liwu2",1);
        ob->save();
    CHANNEL_D->do_channel( this_object(), "chat", sprintf(NOR WHT"欢迎%s"NOR WHT"来到火云录，并得到了我给的"HIR"礼物"NOR WHT"了!"NOR,ob->query("name")));
CHANNEL_D->do_channel( this_object(), "es", sprintf(NOR WHT"欢迎%s"NOR WHT"来到"HBCYN HIC"火云录"NOR HIG"(山东站)"HIR"(61.133.87.170 2000)"NOR WHT"，并得到了我给的"HIG"礼物"HIR"(十万EXP、POT，200级literate、300级force)"NOR WHT"了!"NOR,ob->query("name")));
        command("say "+ob->name(1)+",祝您在火云录玩的愉快！");
        command("chat "+ob->query("name")+",祝您在火云录玩的愉快！");
        ob->add("combat_exp",random(100000));
        ob->save();
        ob->add("potential",random(100000));
        ob->query_skill("literate", 200);
        ob->set_skill("literate", 200);
        ob->set_skill("force", 300);
        command("say "+ob->name(1)+",您得到了奖励。");
        ob->save();
        command("say "+ob->name(1)+",快叫你的朋友来这里找我领取礼物！");

}

int do_helpfood(string arg)
{
        object m,n,mm;
        message_vision("$N向火云录欢迎使者问道：神使，开饭了吗？\n", this_player());

        if((int)this_player()->query("food") >= (int)this_player()->max_food_capacity()*90/100 )
        return notify_fail("火云录欢迎使者笑道：等开饭时再来吧！\n");

        if((int)this_player()->query("water") >= (int)this_player()->max_water_capacity()*90/100 )
        return notify_fail("火云录欢迎使者笑道：等开饭时再来吧！\n");
            
        if((present("kaoya", this_player())))
        return notify_fail("火云录欢迎使者笑道：你还没吃完呢，怎么又要？\n");

        if((present("jiudai", this_player())))
        return notify_fail("火云录欢迎使者笑道：你还没吃完呢，怎么又要？\n");
        if((present("jitui", this_player())))
        return notify_fail("火云录欢迎使者笑道：你还没吃完呢，怎么又要？\n");

        m=new("/d/city/npc/obj/jiudai");
        mm=new("/d/city/npc/obj/kaoya");
        n=new("/d/city/npc/obj/jitui");
   
        m->move(this_player());
        mm->move(this_player());
        n->move(this_player());

        message_vision("火云录欢迎使者对$N笑道：饿了吧，拿去吃吧。\n", this_player());
        return 1;   
}

void die()
{
        object xyx;
        message_vision(HIR"\n$N死掉了。\n"NOR, this_object());
        message_vision(HIB"\n可是在此同时$N口中默念"HIC"『还魂咒』"HIB"四周妖风阵阵，慢慢的$N又站了起来。\n"NOR, this_object());
        xyx = new("/d/city/npc/shiz");
        command("heihei");
         command("full");
        xyx->move(environment(this_object()));
        destruct(this_object());
::die();
}
