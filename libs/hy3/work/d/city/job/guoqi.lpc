// 中秋月饼
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIR "国旗" NOR, ({ "guoqi", "qi" }));
  set("long", "这是五星红旗。 \n");
  set("unit", "面");
  set("weight", 10);
  set("value", 20);
}
void init() {

  set("no_put", 1);
  set("no_give", 1);
  set("no_get", 1);
  set("no_beg", 1);
  set("no_pawn", 1);
  set("no_drop", 1);
  set("no_buy", 1);
  set("no_sell", 1);
  set("no_steal", 1);
  add_action("do_hui", "hui");
}
int do_eat(string arg) {
  object ob;
  if (!id(arg)) return 0;
  if (living(this_player()) == 0) return 0;
  ob = this_player();

  ob->set("combat_exp", ob->query("combat_exp") + 10000);
  ob->set("potential", ob->query("potential") + 1000);
  message("channel:chat", "你挥舞五星红旗，振臂高呼：中华人民共和国万岁！！！\n");


  //write(HIG"你吃下一块月饼，心里美滋滋的！\n"NOR);
  destruct(this_object());
  return 1;
}
