// Room: /d/death/difu.c
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIB"地府"NOR);
        set("long", RED+@LONG
这里就是阴魂集聚的阴曹地府了，昏暗的火光忽明忽暗，猛然间，你听到
一声惨号，你抬头一看，只见一群牛头马面的鬼使正抬着一个什么东西往一油锅
里扔，你连忙掉头想跑，却迎面被两个不知从哪冒出来的鬼吏一把架了起来，迳
直往里走去，忽听堂上一声大喝，你连忙跪了下来。
LONG+NOR
);
        set("exits", ([ /* sizeof() == 4 */
                "south" :   __DIR__"duanhun",
        ]));

        set("objects", ([ /* sizeof() == 4 */
                  __DIR__"yanluo":      1,
        ]));      

        set("no_fly",1);
        set("indoors","city");
        set("no_fight",1);
        setup();

}

int valid_leave(object me, string dir)
{
        if( dir=="south" && !me->query_temp("difu/huanhun") )
                return notify_fail("牛头鬼吏一把按住了你，你动弹不得。\n");
        return ::valid_leave(me, dir);
}
