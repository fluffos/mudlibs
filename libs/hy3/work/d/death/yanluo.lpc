#include <ansi.h>
inherit NPC;

void create()
{
        set_name(HIR"阎罗王"NOR, ({ "yanluo wang", "wang" }) );

        set("long",
                "阎罗王的脸上没有任何表情，仿佛你在他眼中视若无物。\n");
        set("attitude", "peaceful");
        set("age", 1200);
        set("combat_exp", 10000000);
        set("max_jing", 100000);
        set("max_qi", 100000);
        set("max_neili",100000);
        set_skill("dodge", 500);
        set_skill("parry", 500);
        set_skill("unarmed", 500);
        set_temp("apply/armor", 500);
        set_temp("apply/damage", 500);
        setup();
        carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        object me=this_player();
        if( !me->query_temp("difu/huanhun") )
        {
        remove_call_out("greeting_ob");
        call_out("greeting_ob",2,me);
        }
}

int greeting_ob(object me)
{
       object ob=this_object();

       if(me->query("age_limit") > me->query("age"))
       {
       message_vision("$N"+HIB"疑惑的看了看$n：“你明明阳寿命未尽呀，怎么到地府"
       +"来了？\n"+"来人呀，把他送到酆都城门 ，让他还阳去吧！”\n"NOR,ob,me);
       me->move("/d/city/wumiao");
       me->delete_temp("linji");
       me->set_ghost(0);
       return 1;
       } else
       {
       message_vision("$N"+HIB"朝$n大喝一声：“"+me->query("name")
       +"，你可知罪？"+"你在阳间无恶不为，杀人无算！\n你已经欠下了"NOR+HIR
       +CHINESE_D->chinese_number(me->query("MKS")+me->query("PKS"))+HIB"条命"
       +"债，如此滔天罪行，本座岂能容你？来呀，左右\n给我架油锅，本座要亲自炸"
       +"一炸你这黑心之人！”\n"NOR,ob,me);
       me->set_temp("difu/punish",(me->query("MKS")+me->query("PKS"))/100+1);
       call_out("punish_ob",2,me);
       return 1;
       }
}

int punish_ob(object me)
{
       if(!me->query_temp("difu/punish"))
       {
        remove_call_out("punish_ob");
        message_vision(HIY"终于，已经半昏迷的$N被一群鬼吏从油锅里拉了出来，"
        +"拖回了堂前！\n"NOR,me);

        message_vision(HIB"阎罗王看看了看$N，冷冷地说到：“这回就这样吧，"
        +"如果来世再不知道悔改，\n就没这么简单了，还不快给我滚去投胎！\n"NOR,me);
        me->set_temp("difu/huanhun",1);
        return 1;
       } else
       {
        message_vision(HIR"只听一声吆喝，$N被一群鬼吏投入了滚滚的油锅之中，"
        +"顿时一阵阵刺骨剧痛传遍\n刺透了$N的全身，$N恨不能立刻就死了过去，"
        +"可偏偏神志还是那么清醒，$N忍不住\n大声呼号起来！一会儿$N又被拉了出"
        +"来....\n"NOR,me);

        message("channel:rumor",HIB"【阴曹地府】忽然，从阴曹地府内传出一阵"
        +HIR+me->query("name")+HIB"的惨号声，众人闻之心胆俱裂！\n"NOR,users());

        me->add_temp("difu/punish",-1);
        remove_call_out("punish_ob");
        call_out("punish_ob",10,me);
        return 1;
       }
}

