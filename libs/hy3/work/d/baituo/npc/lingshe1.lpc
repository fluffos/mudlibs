inherit NPC;
#include <ansi.h>

void create()
{
        set_name("灵蛇", ({ "ling she", "she", "ling" }) );
        set("race", "野兽");
        set("age", random(10));
        set("long", "只见它全身焕发灵气，头呈三角，行动异常灵活。\n");
        set("attitude", "peaceful");
        set("str", 20);
        set("cor", 20);
        set("limbs", ({ "头部", "身体", "七寸", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("combat_exp", 300000+random(50000));

        set_temp("apply/attack", 20+random(10));
        set_temp("apply/damage", 10+random(10));
        set_temp("apply/armor", 15+random(10));
        set_temp("apply/defence",20+random(10));
        setup();
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
        if( random(damage_bonus) > (int)victim->query_temp("apply/armor")
        && (int)victim->query_condition("snake_poison") < 20 ) {
           victim->apply_condition("snake_poison", 40);
        tell_object(victim, HIR "你觉得被咬中的地方一阵麻木！\n" NOR );
        }
        return 0;
}

void unconcious()
{
        this_object()->die();
}

void die()
{
        object ob,me=this_object(),master;
        message_vision(HIG"$N退缩回去，变得听话了\n"NOR, this_object());

        master=me->query_temp("last_damage_from");
        if( master && userp(master))
        {
         ob = new(__DIR__"lingshe2");
         ob->set("owner",master->query("id"));
         ob->move(environment(master));
        }
        destruct(me);
        return;
}

