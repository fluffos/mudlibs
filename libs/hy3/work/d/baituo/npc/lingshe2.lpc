inherit ITEM;
#include <ansi.h>
void create()
{
        set_name(HIR "灵蛇" NOR, ({"ling she","she"}));
        set("unit", "条");
        set("long", "这是一条带有灵性的小蛇，可以用来制造(make)灵蛇杖。\n");
        setup();
}

void init()
{
   if(this_player()->query("id") == this_object()->query("owner"))
   add_action("do_make","make");
}

int do_make(string arg)
{
   object me,weapon,*ilist;
   int i;

   me=this_player();
   if(!arg || arg!="she zhang")
   return notify_fail("你要用灵蛇来制造什么？\n");

   if(me->query_skill("hamagong",1)<200)
   return notify_fail("你的蛤蟆功等级不够，不能制造灵蛇杖！\n");

   if(me->query_skill("duji",1)<200)
   return notify_fail("你的毒技等级不够，不能制造灵蛇杖！\n");

   if((string)me->query("family/family_name")!="白驼山")
   return notify_fail("你不是白驼山弟子，不能制造灵蛇杖！\n");

   ilist=all_inventory(me);
   for(i=0;i<sizeof(ilist);i++)
   {
    if(ilist[i]->query("skill_type")=="staff")
    {
     weapon=ilist[i];
     break;
    }
   }
   
   if(weapon)
   {
    weapon->set("id","she zhang");
    weapon->set("name",MAG"灵蛇杖"NOR);
    weapon->set("long","一根灵蛇杖，杖头绕着一条小蛇，煞是恐怖！\n");
    destruct(this_object());
    return 1;
   } else
   return notify_fail("你必须找根钢杖类的兵器来在制造灵蛇杖！\n");
}    
