}
int look_living(object me, object obj)
{
	int age;
	string str, pro;
	mapping my_fam, fam;
	string desc;
	object ob;

	if( me!=obj && !wizardp(me))
		message("vision", me->name() + "正盯著你看，不知道打些什么主意。\n", obj);

	str = obj->long();
	pro = (obj==me) ? gender_self(obj->query("gender")) : gender_pronoun(obj->query("gender"));

	if(objectp(ob = obj->query_temp("is_riding")) && obj != me)
		str += sprintf("%s正骑在%s上，低头看着你。\n", pro, ob->name());

	if(obj->query("can_speak") && !obj->query("not_living"))
	{
		age = (int)obj->query("age");

		if(wizardp(obj))
			str += sprintf(HIW"此人谈吐不凡，仙风道骨，看起来绝非等闲之辈啊！\n"NOR,pro);

		else if(age < 10 )
			str += sprintf("%s看起来还不足十岁，只是个雪白粉嫩的小孩子。\n",pro);

		else if((string)obj->query("gender") == "男性")
		{
			if(age < 20 && age > 10)
				str += sprintf("%s看起来大概只有十多岁，是个青春少年郎。\n", pro);

			else if(age >= 20 && age < 30)
				str += sprintf("%s看起来大约二十多岁，已是身强力壮的年轻小伙了。\n", pro);

			else if(age >= 30 && age < 40 )
				str += sprintf("%s看起来已是中年了。\n", pro);

			else if(age >= 40 && age < 50)
				str += sprintf("%s看起来已是壮年了，一副身强力壮的样子。\n", pro);

			else if(age >= 50 && age < 70 )
				str += sprintf("%s头发花白，想必年过半百，已是不惑之年了。\n",pro);

			else if(age >= 70 )
				str += sprintf("%s白发苍苍，满脸皱纹，一副老态龙钟的样子。\n",pro);
		}
		else {

			if(age < 20 && age > 10)
				str += sprintf("%s看起来大概只有十多岁，是个含苞欲放的小姑娘。\n", pro);

			else if(age >= 20 && age < 30 )
				str += sprintf("%s看起来大约二十多岁，已是亭亭玉立的黄花大闺女了。\n", pro);

			else if(age >= 30 && age < 40 )
				str += sprintf("%s看起来已是中年了。\n", pro);

			else if(age >= 40 && age < 50 )
				str += sprintf("%s看起来已经四十来岁了，却仍然徐娘半老，风韵犹存。\n", pro);

			else if(age >= 50 && age < 70 )
				str += sprintf("%s头发花白，想必年过半百，已是不惑之年了。\n",pro);

			else if(age >= 70 )
				str += sprintf("%s白发苍苍，满脸皱纹，一副老态龙钟的样子。\n",pro);
		}

	}

	desc = description(obj);
	if (desc && desc != "")
		str += pro + desc;

	//check about wife and husband
	if((obj->parse_command_id_list())[0] == (string)me->query("marry/id"))
	{
		if( (string)me->query("gender")=="女性" )
		{
			str += sprintf("%s是你的丈夫。\n", pro);
		}
		else
		{
			str += sprintf("%s是你的妻子。\n", pro);
		}
	}

	if(me->is_brother(geteuid(obj)))
	{
		if((string)me->query("gender") == (string)obj->query("gender"))
			str += sprintf("%s是你的结拜兄弟。\n",pro);
		else
			str += sprintf("%s是你的八拜之交。\n",pro);
	}

	// If we both has family, check if we have any relations.
	if( obj!=me
	&&      mapp(fam = obj->query("family"))
	&&      mapp(my_fam = me->query("family"))
	&&      fam["family_name"] == my_fam["family_name"] ) {

		if( fam["generation"]==my_fam["generation"] ) {

			if( (string)obj->query("gender") == "男性" ||
				(string)obj->query("gender") == "无性")
				str += sprintf( pro + "是你的%s%s。\n",
					my_fam["master_id"] == fam["master_id"]? "": "同门",
					my_fam["enter_time"] > fam["enter_time"] ? "师兄": "师弟");
			else
				str += sprintf( pro + "是你的%s%s。\n",
					my_fam["master_id"] == fam["master_id"]? "": "同门",
					my_fam["enter_time"] > fam["enter_time"] ? "师姐": "师妹");
		} else if( fam["generation"] < my_fam["generation"] ) {
			if( my_fam["master_id"] == obj->query("id") )
				str += pro + "是你的师父。\n";
			else if( my_fam["generation"] - fam["generation"] > 1 )
				str += pro + "是你的同门长辈。\n";
			else if( fam["enter_time"] < my_fam["enter_time"] )
				str += pro + "是你的师伯。\n";
			else
				str += pro + "是你的师叔。\n";
		} else {
			if( fam["generation"] - my_fam["generation"] > 1 )
				str += pro + "是你的同门晚辈。\n";
			else if( fam["master_id"] == me->query("id") )
				str += pro + "是你的弟子。\n";
			else
				str += pro + "是你的师侄。\n";
		}
	}

	if (stringp(obj->query_temp("eff_status_msg")))
	{
		str += obj->query_temp("eff_status_msg") + "\n";
	} else

	if( obj->query("max_qi") )
		str += pro + COMBAT_D->eff_status_msg((int)obj->query("eff_qi")* 100 / (int)obj->query("max_qi")) + "\n";

	if(obj->is_corpse() && obj->query("kantou") == 1)
		str += sprintf("%s连头都被割走了。\n", pro);

	str += look_equiped(me, obj, pro);
	message("vision", str, me);
	return 1;
}

string look_equiped(object me, object obj, string pro)
{
        mixed *inv;
        string str;
        string subs;
        int i;
        int n;

        inv = all_inventory(obj);
        n = 0;

        str = "";
        subs = "";
        for (i = 0; i < sizeof(inv); i++)
        {
                switch (inv[i]->query("equipped"))
                {
                case "wielded":
                        n++;
                        subs = HIG "  □" NOR + inv[i]->short() + "\n" + subs;
                        break;

                case "worn":
                        n++;
                        subs += HIG "  □" NOR + inv[i]->short() + "\n";
                        break;

                default:
                        break;
                }
        }

        if (n)
                str += pro + "装备着：\n" + subs;

        if(playerp(obj) && !objectp(obj->query_temp("armor/cloth")))
        {
		str = pro + "一丝不挂，全身赤裸，什么也没有穿。\n" + str;
        }

        return str;
}

int look_room_item(object me, string arg)
{
	object env;
	mapping item, exits;

	if( !objectp(env = environment(me)) )
		return notify_fail("这里只有灰蒙蒙地一片，什麽也没有。\n");

	if( mapp(item = env->query("item_desc")) && !undefinedp(item[arg]) )
	{
		if( stringp(item[arg]) )
			write( convert_color( item[arg] ) );
		else if( functionp(item[arg]) )
			write( convert_color( (string)(*item[arg])(me) ) );

		return 1;
	}
	if( mapp(exits = env->query("exits")) && !undefinedp(exits[arg]) )
	{
		if( objectp(env = find_object(exits[arg])) )
			look_room(me, env,0);
		else
		{
			call_other(exits[arg], "???");
			look_room(me, find_object(exits[arg]),0);
		}
		return 1;
	}
	return notify_fail("你要看什么？\n");
}


int help (object me)
{
	write(@HELP
指令格式: look [<物品>|<生物>|<方向>]

这个指令让你查看你所在的环境、某件物品、生物、或是方向。

HELP
);
	return 1;
}
