// lurk.c

#include <ansi.h>

inherit F_CLEAN_UP;

mapping default_dirs = ([
	"north":        "北边",
	"south":        "南边",
	"east":         "东边",
	"west":         "西边",
	"northup":      "北边",
	"southup":      "南边",
	"eastup":       "东边",
	"westup":       "西边",
	"northdown":    "北边",
	"southdown":    "南边",
	"eastdown":     "东边",
	"westdown":     "西边",
	"northeast":    "东北面",
	"northwest":    "西北面",
	"southeast":    "东南面",
	"southwest":    "西南面",
	"up":           "上面",
	"down":         "下面",
	"enter":        "里面",
	"out":          "外面",
]);

void create() { seteuid(getuid()); }
int can_visible(object me,object obj);
int main(object me, string arg)
{
	string dest,dir;
	object env,obj;
	object plr,*ob;
	int result;
	int i, count = 0;
	object *f_obs;
	mixed flee;
	mapping exit;
	mapping my;

	if( !arg )
		return notify_fail("你要往哪个方向走？\n");

	if( me->over_encumbranced())
		return notify_fail("你的负荷过重，动弹不得。\n");

	if( me->is_busy() || me->query("doing"))
		return notify_fail("你的动作还没有完成，不能移动。\n");

	if( me->is_fighting())
		return notify_fail("你正在战斗，不能潜行。\n");

	if( me->query_temp("is_riding"))
		return notify_fail("骑着马还要潜行？\n");

	env = environment(me);

	if(!env)
		return notify_fail("你哪里也去不了。\n");

	my = me->query_entire_dbase();

	if(my["brawn"] <= 0)
		return notify_fail("你太累了，实在走不动了。\n");

	me->clean_up_enemy();

	f_obs = ({ });
	if(arrayp(ob = env->query_temp("guarded/" + arg)))
		f_obs += ob;


	if (sizeof(f_obs))
	{
		int fp, gp;
		int force_power;
		int target_power;
		object g_ob;

		fp  = (int)me->query_skill("dodge");
		fp += my["dex"] * 15;
		force_power = me->query_skill("force") + my["str"] * 2;
		if (flee = me->query_temp("success_flee"))
		{
			if (stringp(flee)) write(flee);
			f_obs = ({ });
		}
		foreach (g_ob in f_obs)
		{
			if (! g_ob) continue;
			if (! living(g_ob) || g_ob == me) continue;

			// calculate flee power & guard power
			gp  = g_ob->query_skill("dodge");
			gp += g_ob->query("dex", 1) * 15;

			if ((fp / 2 + random(fp)) < (gp * 3 / 4))
			{
				if (userp(g_ob))
				{
					target_power = g_ob->query_skill("force") + g_ob->query("str") * 2;
					if (force_power > target_power * 2)
					{
						message_vision("$N趁$n不备，偷偷的溜了过去。",me, g_ob);
					} else
					{
						me->start_busy(1);
						message_vision("$N想要偷偷的溜走，却被$n一把"
							       "拦住：慢着！想打我这儿过，没门！\n",
								me, g_ob);
						tell_object(me, "你被拦住了去路。\n");
					}
					return 1;
				}
			}
		}
	}
	me->delete_temp("success_flee");

	if( !mapp(exit = env->query("exits")) || undefinedp(exit[arg]) )
	{
		if( query_verb() == "go")
			my["brawn"]-=10;
		if( my["brawn"] < 0)
			my["brawn"]=0;
			notify_fail("你硬生生的往墙上撞去，这才发现这个方向并没有出路。\n");
		return 0;
	}

	notify_fail("那里你去不了。\n");

	result = env->valid_leave(me, arg);
	if (! objectp(me))
		return 1;

	if (! result) return 0;
	if (result < 0 || environment(me) != env)
		return 1;

	dest = exit[ arg ];
	if(!(obj = find_object(dest)))
		if(!objectp(obj=load_object(dest)))
		{
			log_file("go_error",sprintf("无法在[%s]找到[%s]，方向为[%s]。\n",
				base_name(environment(me)),dest,arg));
			CHANNEL_D->do_channel(find_object(SEC_OB),"debug",
				sprintf("无法在[%s]找到[%s]，方向为[%s]。\n",base_name(environment(me)),dest,arg));
				return notify_fail(WHT"发现错误连接而无法移动，请转告巫师。\n"NOR);
		}

	if((int)obj->query("force_room"))
	{
		for(i=0; i < sizeof(ob = all_inventory(obj));i++)
			if( living(ob[i]) && playerp(ob[i]))
				count++;
		if(count >= 3)
			return notify_fail("那里的人太多了，你怎么也挤不进去。\n");
	}

	if( me->is_ghost() && !obj->query("outdoors"))
		return notify_fail(HIB"一个身着盔甲的侍卫挡住了你的去路，恶狠狠的朝你喊道：你一个孤魂野鬼，\n"
			"那不是你能去的地方。\n"NOR);

	if(me->query_condition("killer"))
	{
		if((obj->query("no_fight") || obj->query("no_steal") ||  obj->query("sleep_room") ||
		    obj->query("playerhouse")) && !obj->query("parsion_room"))
			return notify_fail("官府还在通缉你，"+ obj->short()+"可不是你的避难所。\n");
	}

	if( !env->valid_leave(me, arg) )
		return 0;

	if( !undefinedp(default_dirs[arg]) )
		dir = default_dirs[arg];
	else
		dir = arg;

	me->remove_all_enemy(1);
	me->delete_temp("pending");

	if( arg != "north"     && arg != "south" &&
	    arg != "east"      && arg != "west" &&
	    arg != "northeast" && arg != "southeast" &&
	    arg != "northwest" && arg != "southwest")
		my["brawn"] -= 8;
	else
		my["brawn"] -= 4;

	foreach(plr in all_inventory(environment(me)))
	{
		if(plr == me) continue;
		if(!wizardp(me) && can_visible(me,plr))
		tell_object(plr,sprintf(WHT"你看到："NOR"%s轻手轻脚的往%s离开，样子十分诡异。\n",
			me->name(),dir));
	}
	me->move(dest);

	foreach(plr in all_inventory(environment(me)))
	{
		if(plr == me) continue;
		if(!wizardp(me) && can_visible(me,plr))
		tell_object(plr,sprintf(WHT"你看到："NOR"%s轻手轻脚，鬼鬼祟祟的走了过来。\n",
			me->name()));
	}
	if(environment(me) != env)
		all_inventory(env)->follow_me(me, arg);
		return 1;

}
int can_visible(object me,object obj)
{
	if(!playerp(obj))
		return 0;

	if(wizardp(obj))
		return 1;

	if((int)obj->query_dex() > (int)me->query_dex()
	|| (int)obj->query_skill("perception",1) > (int)me->query_skill("dodge",1))
		return 1;

	return 0;
}



int help(object me)
{
	write(@HELP

指令格式：lurk <方向>

你可以利用这个指令，偷偷摸摸的离开当前场景而不被他人发现。当然这
也必须看你的身法如何才是了。

HELP
	);
	return 1;
}
