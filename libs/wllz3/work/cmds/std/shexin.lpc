// shexin.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string dest, cmd;
	object env,ob;
	mapping fam;

	if(me != this_player()) 
		return 0;

	seteuid(getuid());

	env = environment(me);
	if(env->query("no_fight"))
		return notify_fail("这里禁止战斗。\n");

	if(me->is_busy())
		return notify_fail("你正忙着呢。\n");
	
	if(me->is_fighting())
		return notify_fail("战斗中慑心，你这不是找死吗？\n");

	if(!mapp(fam = me->query("family")) || fam["family_name"] != "雪山寺" )
		return notify_fail("只有雪山弟子才能行使慑心术！\n");

	if((int)me->query_skill("necromancy",1) < 120)
		 return notify_fail("你的降伏法还太浅薄了，没法行使慑心术。\n");

	if(!arg || sscanf(arg, "%s to %s", dest, cmd) != 2)
		return notify_fail("指令格式: shexin <某人> to <指令>\n");

	if(!objectp(ob = present(dest, environment(me))))
		return notify_fail("找不到" + dest + "。\n");

	if(!ob->is_character() || ob->query("not_living"))
		return notify_fail("这东西无法被慑心。\n");

	if(!playerp(ob))
		return notify_fail("你看了看这个人，没敢下手。\n");

	if(ob->query("doing"))
		return notify_fail("人家正在冥思修炼，你就别给人家添乱了。\n");

	if(wizardp(ob))
		return notify_fail("你不能慑心巫师。\n");

	if(ob->is_busy())
		return notify_fail(ob->name() +"正忙着呢。\n");

	if(ob->is_fighting())
		return notify_fail(ob->name() +"正在战斗中，你这不是找死吗？\n");

	message_vision("$N的一对眼睛半眯着，只如两道细缝，但细缝中莹然有光，眼神甚是清朗。\n"
		       "$n微觉不妥，要想转头避开$N的眼光，可是一双眼睛竟似被$N的目光吸住了，\n"
		       "不由自主的凝视着他。\n", me, ob);

	if(random(me->query_skill("necromancy",1)) < random(ob->query_skill("force")))
	{
		if(playerp(me) && playerp(ob) && ob->valid_attack() && me->valid_attack())
		{
			message_vision("突然$n猛地一阵清醒，于是，$n大喝一声：你活腻了，敢来对我施慑心术？\n", me, ob);
			ob->fight_ob(me);
		}
		else
		{
			message_vision("$n转过头来狠狠的瞪了$N一眼，说道：这里由不得你放肆，滚！\n",ob,me);
			write(HIR"\n糟糕！被发现了！！还是快走吧！！！\n\n"NOR);
		}
		me->start_busy(3);
		return 1;
	}

	if( random(me->query_skill("necromancy",1)) < random(ob->query_skill("perception",1)))
	{
		message_vision("只见$n运用听风辨器的技巧，一下子就摆脱了$N的控制！\n",me,ob);
		me->start_busy(3);
		return 1;
	}

	if (strsrch(cmd, "give ") >= 0)
	{
		message_vision("于是，$n迷迷糊糊也不知道是递了些什么给$N。\n", me, ob);
	}
	else
	if (strsrch(cmd, "go ") >= 0)
	{
		message_vision("结果，$n迷迷糊糊也不知道怎么回事就往前摸着走开了。\n", me, ob);
	}
	else
	if (strsrch(cmd, "follow ") >= 0)
	{
		message_vision("果然，$n迷迷糊糊地就跟在$N的屁股后面走了。\n", me, ob);
	}
	else
		return notify_fail("你只能慑心人家做：give、go和follow。\n");

	log_file("shexin_player", sprintf("[%s] %s shexin %s to %s\n",
		ctime(time()), geteuid(me), geteuid(ob), cmd));

	return ob->force_me(cmd);
}

int help(object me)
{
	write(@HELP

指令格式：shexin <某人> to <指令>

shexin sb to give sth to sb
shexin sb to follow sb
shexin sb to go <dir>

利用慑心术诱惑某人做把身上的东西给你, 或往那里离开，或者跟着你。
当然你必须是雪山派弟子，且有相当的降伏法修为。对方如果内功深厚，
而你学艺不精，必然也会招致以牙还牙。当心！
HELP);
	return 1;
}
