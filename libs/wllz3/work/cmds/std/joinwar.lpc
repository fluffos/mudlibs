//joinwar 参战

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me,string arg)
{
	mapping fam;
	int eff;
	string *list;
	
	if(me->is_busy())
		return notify_fail("你正忙着呢。\n");
	
	if(me->is_fighting())
		return notify_fail("你还是先把你的对手搞定了再说吧。\n");
	
	if(!mapp(fam = me->query("family")))
		return notify_fail("你还是先加入一个门派再说吧。\n");

	if(!WARFARE_D->is_war_family(fam["family_name"]))
		return notify_fail("你所属的门派既不是攻方，也不是守方，瞎搅和什么呀？\n");

	if(sizeof(list = WARFARE_D->query_player_list())
		&& member_array(me->query("id"),list) != -1)
		return notify_fail("你已经参加了门派攻防战，加油吧！\n");

	if(me->query_condition("joinwar"))
		return notify_fail("你已经参加了门派攻防战，加油吧！\n");

	if(me->query_override("die"))
		return notify_fail("你还是先把其他事情做完了再说吧。\n");

	eff = (int)me->query("eff_qi") * 100 / (int)me->query("max_qi");
	if( eff < 100)
		return notify_fail("你现在状态不佳，还是别去送死了。\n");
	
	eff = (int)me->query("eff_jing") * 100 / (int)me->query("max_jing");
	if( eff < 100)
		return notify_fail("你现在状态不佳，还是别去送死了。\n");
	
	write(HIC"你心想：门派声望，岂能容得他人所掠！于是投身到队伍中。\n"NOR);
	WARFARE_D->join_warfare(me);
	me->apply_condition("joinwar",600);
	return 1;
}

int help()
{
	write(@HELP

指令格式：joinwar

这个指令是让你在当发生门派攻防战的时候，加入到门派战的攻、防队伍
中。当你输入这个指令的时候，系统将自动送你到达战斗地点，如果你想
退出战斗，则输入 quit 即可，不过这将会降低你的江湖威望和江湖阅历
。
HELP );
	return 1;
}
