int main(mixed, mixed);
int help(mixed);

int main(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = environment(arg1);
    v2 = arg1->query_skill("linji-zhuang", 1);
    seteuid(getuid());
    if (v1->query("restrict_action")) {
        return notify_fail("这里不能做这件事情。\n");
    }
    if (arg1->query("family/family_name") != "峨嵋派") {
        return notify_fail("只有峨嵋派弟子才能通过静坐修行！\n");
    }
    if (environment(arg1)->query("no_fight") && (!arg1->is_scheme() || this_player(1))) {
        return notify_fail("这里太纷杂，你没法安心静坐。\n");
    }
    if (arg1->query("eff_jing") < 50) {
        return notify_fail("你受伤太重，没法静坐。\n");
    }
    if (arg1->query("jing") < v2 / 5) {
        return notify_fail("你的精力不足，无法进行静坐。\n");
    }
    if (arg1->is_busy()) {
        return notify_fail("你正忙着呢！\n");
    }
    if (arg1->is_fighting()) {
        return notify_fail("战斗中想静坐？你不要命啦！\n");
    }
    if (time() - arg1->query("jingzuo_time") < 120) {
        return notify_fail("你刚才静坐过，现在头脑一片空白。\n");
    }
    if (arg1->query_skill("mahayana", 1) < 40) {
        return notify_fail("你的大乘般涅磐功还太浅薄了，没法静心静坐。\n");
    }
    if (arg1->query_skill("linji-zhuang", 1) < 40) {
        return notify_fail("你的临济十二庄功还太浅薄了，没法静心静坐。\n");
    }
    write("你往床上盘膝一坐，开始静坐，不一会儿，你神游天外，物我两忘。\n");
    arg1->set_temp("block_msg/all", 1);
    message_vision("$N一躬身，坐在床上，闭目端念，静心打坐。\n", arg1);
    arg1->set("no_get", 1);
    arg1->set("no_get_from", 1);
    arg1->disable_player("<静坐中>");
    arg1->start_call_out(bind((: call_other, "/cmds/std/jingzuo.lpc", "wakeup", arg1, v1 :), arg1), v2 / 10 + random(30), arg1, v1);
    return 1;
}

void wakeup(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = arg1->query_skill("force");
    v4 = arg1->query_int() / 2;
    v3 = v4 + v1 / 10;
    v2 = v3 / 2 + random(20);
    arg1->receive_damage("jing", v1 / 5);
    arg1->receive_would("jing", v1 / 10);
    arg1->add_points(arg1, v3);
    arg1->add_exp(arg1, v2);
    if (random(50000) < 20) {
        arg1->add("score", 1);
        arg1->add("weiwang", 1);
    }
    message_vision("$N静坐完毕，缓缓睁眼，长长吐了一口气。\n", arg1);
    arg1->enable_player();
    arg1->set("jingzuo_time", time());
    arg1->delete_temp("block_msg/all");
    write("你静坐完毕，感到十分疲倦。\n");
    arg1->delete("no_get", 1);
    arg1->delete("no_get_from", 1);
    arg1->write_prompt();
    return;
}

int help(mixed arg) {
    write("\n指令格式：jingzuo <精点数>\n\n这个指令是峨嵋派弟子用以静坐修道的命令。\n\n");
    return 1;
}
