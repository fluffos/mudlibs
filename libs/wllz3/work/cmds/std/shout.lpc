// shout.c

inherit F_CLEAN_UP;

#include <ansi.h>

int main(object me, string arg)
{
	if(me->ban_say()) return 0;

	if(!arg || arg == "" )
		return notify_fail("你想要大叫什么？\n");

	if(!wizardp(me) && playerp(me))
	{
		if(me->query_condition("no_speak"))
			return notify_fail("你支支吾吾的，半天也说不出句话来。\n");

		if((int)me->query("mud_age") <= 345600 )
			return notify_fail("小孩子家，叫什么叫？\n");

		if((int)me->query("max_neili") < 2000)
			return notify_fail("你的内力修为不够，无法使用 shout 指令进行传话。\n");

		if((int)me->query("jingli") < 500 || (int)me->query("neili") < 600 ||
		   (int)me->query("brawn") < me->query("max_brawn") / 2)
			return notify_fail("你的状态不足以使用 shout 传话。\n");


		me->add("neili",- 600);
		me->add("jingli",- 500);
		me->add("brawn",- me->query("max_brawn") / 2);

		shout(sprintf(HIW"%s纵声长啸：%s\n"NOR,me->name(),arg));
		write(HIW+"你纵声长啸：" + arg + "\n"NOR);
	}
	else
	{
		shout(sprintf(HIW"%s纵声长啸：%s\n"NOR,me->name(),convert_color(arg)));
		write(HIW+"你纵声长啸："+ convert_color(arg) + NOR"\n"NOR);
	}
	return 1;
}
int help(object me)
{
	write(@HELP

指令格式 : shout <讯息>

这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都会听见你的话。
HELP
);
	return 1;
}
