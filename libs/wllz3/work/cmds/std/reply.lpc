// reply.c

#include <ansi.h>

inherit F_CLEAN_UP;

void create() {seteuid(getuid());}

int help(object me);

int main(object me, string arg)
{
	string target;
	object obj;
	string no_tell,can_tell,my_id;

	if(me->ban_say()) return 0;

	if(!arg || arg=="")
		return notify_fail("你要回答什么？\n");

	if(!stringp(target = me->query_temp("reply")))
		return notify_fail("刚才没有人和你说过话。\n");

	if(!wizardp(me) && me->query_condition("no_speak"))
		return notify_fail("你支支吾吾的，半天也说不出句话来。\n");

	obj = find_player(target);

	if(!obj || !environment(obj))
		return notify_fail("刚才和你说话的人现在无法听见你，或者已经离开游戏了。\n");

	if(!living(obj))
		return notify_fail(obj->name(2)+"现在无法听到你的话！\n");

	if(!interactive(obj) || obj->is_net_dead())
		return notify_fail("对方现在处于离线状态，无法接受你的信息！\n");

	my_id= me->query("id");
	no_tell = obj->query("env/no_tell");

	if(!wizardp(me) && !me->is_brother(obj->query("id"))
	&& (string)me->query("marry/id") != (string)obj->query("id")
	&& (no_tell == "all" || no_tell == "ALL" || is_sub(my_id, no_tell)))
	{
		can_tell = obj->query("env/can_tell");
		if (! is_sub(my_id, can_tell))
			return notify_fail("对方已经设置了 NO_TELL，看来是不想听你罗嗦啦！\n");
	}


	write(WHT"『私语』"+HIY "你回答" + obj->name(2) + "：" + arg + "\n" NOR);

	tell_object(obj, sprintf(WHT"『私语』"HIY + BEEP"%s回答你：%s\n"NOR,
		me->name(2), arg));

	if(obj->query("logd"))
		log_file("msg/"+ geteuid(obj),sprintf("[%s]\n%s REPLY：%s\n",
			ctime(time()),geteuid(me),arg));

	obj->set_temp("reply", me->query("id"));

	if(query_idle(obj)>120)
		write(sprintf(HIC"%s已经发呆了"HIY" %d "HIC"分钟，恐怕不会很"
		                 "快给你答复。\n"NOR,
				 obj->name(2),
				 query_idle(obj)/60));
	if(me->query("logd"))
		log_file("msg/"+ geteuid(me),sprintf("[%s]\nREPLY %s：%s\n",
			ctime(time()),geteuid(obj),arg));
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：reply <讯息>

你可以用这个指令和刚才用 tell 和你说话的使用者说话。

see also : tell
HELP
	);
	return 1;
}
