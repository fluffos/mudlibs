// run.c

#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	object ob,corpse;
	string msg;
	mapping prop;
	mapping map_to;
	string home;

	if( !arg ) return help(me);

	if( me->is_fighting())
		return notify_fail("你现在正在战斗！\n");

	if( me->is_busy() || me->query("doing"))
		return notify_fail("你现在正忙着呢。\n");

	if(!environment(me)->query("outdoors"))
		return notify_fail("这里空间太小，不能骑马！\n");

	if(me->query_temp("fangmu"))
		return notify_fail("你正在放牧！\n");

	if(!objectp(ob = me->query_temp("is_riding"))
		|| !present(ob,me))
		return notify_fail("你没有坐骑！\n");

	if(!mapp(prop = ob->query("horse_prop")))
		return notify_fail("你搞错了吧？怎么骑上了这个家伙？\n");

	if(arg == "home")
	{	
		if(!stringp(home = me->query("private_room/entry")))
			return notify_fail("你还没有房子呢，怎么回家？\n");

		map_to = ([]);
		map_to["room"] = home;
		map_to["name"] = me->query("private_room/name");
	}

	else
	if(!mapp(map_to = TRANS_D->query_trans_for(arg)))
		return notify_fail("你要到什么地方？\n");

	if( prop["life"] <= 0 )
		return notify_fail("你的"+ ob->name() +"已经累得不能动了！\n");


	if( stringp(msg = me->query("env/msg_mgo")) )
		message_vision( msg + "\n", me);
	else
		message_vision("$N跨上「$n"NOR"」，两腿一踢，$n带着$N直往"+ map_to["name"] +"奔去。\n",me,ob);

	me->move(map_to["room"]);

	if( stringp(msg = me->query("env/msg_mcome")) )
		message_vision(msg + "\n", me);
	else
		message_vision("突然一阵烈马的啼鸣，风沙飞扬之中，$N骑着「$n"NOR"」出现在人群中。\n", me,ob);

	prop["life"] -= 2;

	if( prop["life"] <= 0 )
	{
		if(ob->player_horse() && prop["max_life"] > 1)
		{
			tell_object(me,WHT"你的"+ ob->name() + WHT"由于劳累过度，生命力降低了。\n"NOR);
			prop["max_life"] -= 1;
			prop["loyalty"] -= 5;
			ob->save();
		}
		else
		{
			message_vision(ob->name() +"再也坚持不住，终于累死了。\n", me);
			me->delete_temp("is_riding");
			ob->delete_temp("ride_ob");
			if( ob->player_horse())
				me->delete("item/horse");
			corpse=new(CORPSE_OB);
			corpse->make_corpse(ob);
			destruct(ob);
			if(random(100) == 50)
			{
				message_vision("$N突然把持不住，重重的摔倒在地上。\n",me);
				me->unconcious();
			}
			return 1;
		}
	}
	if(prop["life"] <= 8)
	{
		tell_object(me,ob->name()+"已经显得很劳累了。\n" NOR);
	}

	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：run <地点代号>

利用坐骑到达某个地点。目前可以利用坐骑去的地方有：

桃源城		ty      大理		dl      佛山		fs
成都		cd      长安		ca      扬州		yz
北京		bj　　　泉州		qz　　　新疆		xj
昆明		km      衡阳城		hyc     灵州		lz
苏州		sz      杭州		hz      襄阳		xy
武功镇		wg      昆仑山		kl

注：如果地点代号为“home”，则代表快速骑马到自己的家门口，这个功
能只针对有自造房屋的玩家使用。

HELP);

	return 1;
}
