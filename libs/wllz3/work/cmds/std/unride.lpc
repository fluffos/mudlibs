// unride.c

#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	object obj;

	if( !arg )
		return help( me );

        if( me->is_busy() )
                return notify_fail("你上一个动作还没有完成！\n");

        if( me->is_fighting() )
                return notify_fail("你还在战斗中。\n");

	if( !objectp(obj = me->query_temp("is_riding")))
		return notify_fail("你没有骑任何坐骑。\n");

	obj->delete_temp("is_rided_by");
	me->delete_temp("is_riding");

	if(!obj->is_horse())
		obj->move(environment(me));

	if( stringp(obj->query("unride_msg")) )
		message_vision(convert_color(obj->query("unride_msg")), me, obj);
	else
		message_vision(YEL"$N一翻身，从「$n" YEL "」上跳了下来。\n"NOR,me,obj);

	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：unride <坐骑名称>

下马。

HELP
	);

	return 1;
}

