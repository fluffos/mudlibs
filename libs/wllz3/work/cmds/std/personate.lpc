//personate.c

#include <ansi.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object victim;
	int skill;
	string msg;

	if(!arg)
		return notify_fail("指令格式：personate | yirong <某人>\n");

	if(me->is_busy())
		return notify_fail("你现在正忙着呢。\n");

	if(me->is_fighting())
		return notify_fail("战斗中不能使用易容术。\n");

	if(arg == "none")
	{
		if(!me->query_temp("yirong"))
			return notify_fail("你还没有施展易容术。\n");

		write(HIC"你的易容术渐渐退去，变回了自己的模样。\n"NOR);
		tell_room(environment(me),me->name() +"的容貌渐渐变化，你仔细一看，原来是"+ me->name(1) +"。\n",({ me }));
		me->delete_temp("apply/name");
		me->delete_temp("apply/short");
		me->delete_temp("apply/id");
		me->delete_temp("apply/long");
		me->delete_temp("yirong");
		return 1;
	}

	if(me->query_temp("mask"))
		return notify_fail("你戴着面具，再变恐怕连你自己是谁都不知道了。\n");

	if(me->query_temp("yirong"))
		return notify_fail("你已经在运功中了。\n");

	if(!objectp(victim = present(arg, environment(me))) || !victim->is_character())
		return notify_fail("你要假装谁？\n");

	skill = (int)me->query_skill("bahuang-gong",1);

	if( skill < 120)
		return notify_fail("你的八荒六合神功不够娴熟，无法使用易容术。\n");

	if((int)me->query("jingli") < 200)
		return notify_fail("你的精力不足，无法施展易容术。\n");

	if((int)me->query("neili") < 500)
		return notify_fail("你的内力不足，无法运功施展易容术。\n");

	if( victim == me )
		return notify_fail("你要假装自己？\n");

	if(!victim->query("can_speak"))
		return notify_fail("你不能假装这种东西。\n");

	if(!wizardp(me) && wizardp(victim))
		return notify_fail("你不能假装巫师。\n");

	me->add("jingli",-200);
	me->add("neili",-500);

	write(sprintf(HIC"你开始施展易容术，假装%s。\n"NOR,victim->name()));

	msg = me->name(1) + "开始施展易容术，";

	if(random(200) > skill)
		msg = "可是什么用也没有。\n";
	else
	{
		msg +="转眼间变成了另外一个人。\n";
		me->set_temp("apply/name", ({ victim->name() }));
		me->set_temp("apply/short",({ victim->short()}));
		me->set_temp("apply/long", ({ victim->long() }));
		me->set_temp("yirong",1);
		write(HIW"\n成功了！你变成了"+ victim->name() +"的模样。\n\n"NOR);
	}
	tell_room(environment(me),msg,({ me }));
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：personate| yirong <某人>

易容术是灵鹫宫的绝技之一，需要 120 级的八荒六合神功才可以施展这种
绝技。当然，也需要 200 点的精力和 500 点的内力。

HELP
	);
	return 1;
}
