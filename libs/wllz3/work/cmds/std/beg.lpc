// beg.c

#include <ansi.h>
#include <config.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string what, who;
	object ob, victim,guard;
	mapping myfam, vtfam;
	int sp, dp;

	seteuid(getuid());

	if(playerp(me)
	&& (!mapp(myfam = me->query("family")) || myfam["family_name"] != "丐帮"))
		return notify_fail("只有乞丐才能乞讨！\n");

	if( environment(me)->query("no_beg") || environment(me)->query("no_fight"))
		return notify_fail("这里不是你叫化子能来讨饭的地方！\n");

	if(me->query_temp("pending/stealing") || me->query_temp("pending/donate"))
		return notify_fail("你正忙着其他事呢。\n");

	if(me->query_temp("pending/begging"))
		return notify_fail("你已经在向人家乞讨了！\n");

	if(me->is_busy())
		return notify_fail("你正忙着呢，没时间乞讨。\n");

	if( !arg || sscanf(arg, "%s from %s", what, who)!=2 )
		return notify_fail("指令格式：beg <物品> from <人物>\n");

	victim = present(who, environment(me));

	if( !victim || victim == me)
		return notify_fail("你想乞讨的对象不在这里。\n");

	if( !living(victim) || !objectp(victim))
		return notify_fail("你要向谁乞讨？\n");

	if(playerp(me))
	{
		if((vtfam = victim->query("family")) && vtfam["family_name"] == "丐帮" )
			return notify_fail("你不能向乞丐乞讨！\n");
	
		if( victim->query("no_beg"))
			return notify_fail("你不能向这个人乞讨。\n");

		if(!wizardp(me) && wizardp(victim))
			return notify_fail("你不能向巫师乞讨。\n");

		if(me->is_fighting())
			return notify_fail("一边打架一边要饭？你真是活腻了！\n");

		if(victim->is_fighting())
			return notify_fail(victim->name() + "正在打架，没空理你！\n");

		if(victim->is_busy())
			return notify_fail("人家正忙着，看来是没空理你的了。\n");
	}

	if(objectp(guard == victim->query_temp("recall_guard"))
		&& environment(guard) == environment(victim))
	{
		message_vision(HIY"$N挡在了$n的前面，怒喝道：死要饭，识相的快给我滚开！！\n"NOR,guard,me);
			return notify_fail("还是算了吧，那人看来可不是好惹的。\n");
	}

	if( !ob = present(what, victim) )
	{
		object *inv;
		inv = all_inventory(victim);
		if( !sizeof(inv) )
			return notify_fail( victim->name() + "身上看起来没有什麽让你感兴趣的东西。\n");
		ob = inv[random(sizeof(inv))];
	}

	if(ob->query("equipped") || ob->query("no_drop") 
		|| ob->is_container() || ob->is_book() || ob->valid_level())
		return notify_fail("这是那人的随身家伙，肯定不会给你。\n");

	sp = (int)me->query_skill("begging") + (int)me->query("level") + (int)me->query_kar() * 5;
	if( sp < 1 ) sp = 1;
	dp = (int)victim->query("level") + (victim->query_int() + victim->query_cor()) * 5;
	if( dp < 1 ) dp = 1;

	tell_object(me, "你装出可怜巴巴的样子，慢慢地向" + victim->name() + "走过去，伸出双手，想要"
			+ ob->query("unit") + ob->name() +"...\n\n");

	tell_object(victim, me->name() + "可怜巴巴地向你慢慢走过来，伸出手，说道：" + RANK_D->query_respect(victim) + "行行好，给我"
			+ ob->query("unit") + ob->name() + "吧 ...！\n\n");

	message("vision", me->name() + "披头散发的趴倒在地，装出一付可怜兮兮的样子，慢慢地向"
		+ victim->name() + "爬了过去，\n伸出双手，有气无力的说道："
		+ RANK_D->query_respect(victim) + "，行行好 ...可怜可怜我这个死叫化子吧 ...\n\n", environment(me), ({ me, victim}) );

	me->set_temp("pending/begging",1);
	call_out( "compelete_beg", 3, me, victim, ob, sp, dp);
	return 1;
}

private void compelete_beg(object me, object victim, object ob, int sp, int dp)
{
	int amount;
	object ob1;
	object where;
	object guard;

	if(!me || !environment(me)) return;

	me->delete_temp("pending/begging");

	where = environment(me);

	if (! objectp(ob) || ! living(me) || me->is_fighting())
		return;

	if(!victim || environment(victim) != environment(me) )
	{
		tell_object(me, "太可惜了，你要乞讨的人已经走了。\n");
		return;
	}

	if(environment(ob) != victim)
	{
		tell_object(me, "太可惜了，人家好像已经没有" + ob->name() + "了。\n");
		return;
	}

	if(objectp(guard == victim->query_temp("recall_guard"))
		&& environment(guard) == environment(victim))
	{
		message_vision(HIY"$N挡在了$n的前面，怒喝道：死要饭，识相的快给我滚开！！\n"NOR,guard,me);
		tell_object(me,"你一听，连忙战战兢兢的说道：大爷饶命，小的这就离开。\n");
		return;
	}

	if( living(victim) && (random(sp+dp) > dp) )
	{
		if(!ob)
		{
			tell_object(me, "看来还是走吧，这家伙身上已经没有多少油水可榨了。\n");
			return;
		}
		if ( ob->query("money_id") )
		{
			amount = ob->query_amount();
			if( amount < 5 )
			{
				tell_object(me, "看来还是走吧，这家伙身上已经没有多少油水可榨了。\n");
				return;
			}

			ob->set_amount(amount - amount/5);
			ob1=new("/clone/money/" + ob->query("money_id"));
			ob1->set_amount(amount/5);
			ob1->move(me,1);
		}

		if (sizeof(all_inventory(me)) >= MAX_ITEM_CARRIED)
		{
			tell_object(me, "你讨到一" + ob->query("unit") + ob->name()+ "，可是你身上的东西已经太多了，不得丢在地下。\n");
			ob->move(where);
			return;
		}

		if( !ob->move(me) )
		{
			ob->move(where);
			tell_object(me, "你讨到一" + ob->query("unit") + ob->name()+ "，可是对你而言太重了，不得丢在地下。\n");
			return;
		}

		tell_object(me, victim->name() + "低头想了一会，又看了看你，摇摇头，叹了口气，丢给你一"
				+ ob->query("unit") + ob->name() + "。\n");

		tell_object(victim, "你看着" +  me->name() +"的可怜样，叹了口气，丢给他一"
				+ ob->query("unit") + ob->name() + "。\n");
// 下面防止潜能和技能达无限增长

	if(me->can_improve_skill("begging"))
		me->improve_skill("begging", random(me->query("int")));

	if((int)me->query("potential") < 100)
		me->add_points(me,1);

	me->add_exp(me,1);

	if( random(sp) < dp/2 )
		message("vision", "你看到" + victim->name() + "冲着" + me->name() + "满脸不屑地摇摇头，"
			+ "丢给他一" + ob->query("unit")
			+ ob->name() + "！\n", environment(me), ({ me, victim }) );
		me->add("jing",-8);
		if(!me->is_busy()) me->start_busy(6);
	}
	else
	{
		if( random(sp) > dp/2 )
		{
			message_vision("$N狠狠地瞪了$n一眼，喝道：滚！$n吓了一跳，急忙扭头灰溜溜地走开了。\n",victim,me);
			if(!userp(me))
				me->random_move();
			me->add("begger",1);
			me->add("jing",-10);
			return;
		}
		if(!playerp(victim) && me->add_temp("beggar/"+ victim->name(1),1) > 3)
		{
			message_vision("$N对$n道：妈的，今天不让你瞧瞧"+ RANK_D->query_self_rude(victim) +"的厉害，"
			               "你是不知死活了！\n",victim,me);
			me->kill_ob(victim);
			victim->kill_ob(me);
			return;
		}
		else
		{
			if(random(10) >= 7)
			{
				message_vision(HIY"$N突然转过身来，对$n喝道：死要饭的，"+ RANK_D->query_self_rude(victim)+"烦着"
				               "哩！滚！\n"NOR,victim,me);
				me->receive_damage("jing",0);
				me->receive_damage("qi",0);
				me->unconcious();
			}
			else	               
				message_vision("$N扭过头去，对$n理都不理。\n",victim,me);
		}
		if(!me->is_busy())
			me->start_busy(3);
	}
	me->add("weiwang",-10);
}

int help(object me)
{
write(@HELP
指令格式 : beg <某物> from <某人>

HELP
	);
	return 1;
}
