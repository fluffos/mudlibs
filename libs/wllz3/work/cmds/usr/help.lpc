// help.c

#include <ansi.h>;

inherit F_CLEAN_UP;

#define DEFAULT_SEARCH_PATHS ({\
	"/doc/help/",\
	"/doc/family/",\
	"/doc/map/",\
	"/doc/skill/",\
	"/doc/efuns/",\
	"/doc/applies/",\
	})

string *default_search = DEFAULT_SEARCH_PATHS;

int main(object me, string arg)
{
	int i;
	string file,*search;

	if( !arg || arg =="") {
                if (file_size("/doc/help/topics") > 0)
                {
			me->start_more(convert_color(read_file("/doc/help/topics")));
                }
                else
                {
			write("没能找到帮助主题。\n");
                }
		return 1;
	}

	// Else, try if a command name is specified.
	seteuid(getuid());
	if( stringp(file = me->find_command(arg)) ) {
		notify_fail("有这个指令存在，但是并没有详细的说明文件。\n");
		return file->help(me);
	}

	// Search the individual search path first.
	if( pointerp(search = me->query("help_search_path")) ) {
		i = sizeof(search);
		while(i--) if( file_size(search[i] + arg)>0 ) {
			me->start_more( read_file(search[i] + arg) );
			return 1;
		}
	}

	// Support efun/lfun help with same name as other topics such as
	// ed() and ed command.
	sscanf(arg, "%s()", arg);

	// Finally, search the default search paths.
	if( pointerp(default_search) ) {
		i = sizeof(default_search);
		while(i--) if( file_size(default_search[i] + arg)>0 ) {
			me->start_more( convert_color(read_file(default_search[i] + arg)) );
			return 1;
		}
	}

	return notify_fail("没有针对这项主题的说明文件。\n");
}

int help(object me)
{
	write(@HELP
指令格式：help <主题>             例如：> help cmds
	  help <函数名称>()     例如：> help call_out()

这个指令提供你针对某一主题的详细说明文件，若是不指定主题，则提供
你有关主题的文件。
HELP
	);
	return 1;
}

