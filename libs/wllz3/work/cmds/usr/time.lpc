// time.c

#include <localtime.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	write("当前时间为："+ NATURE_D->game_time() + "。\n");
	if(wizardp(me))
	write(sprintf("系统时间戳：%d\n",time()));
	return 1;
}

int help(object me)
{
     write(@HELP

指令格式：显示现在的时辰。

HELP
	);

	return 1;
}
