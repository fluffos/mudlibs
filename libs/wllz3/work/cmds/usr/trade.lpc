// skills.c

#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);
int main(object me, string arg)
{
	mapping t;
	mapping info;
	string name,base;
	object obj,ob;
	object *obs,*inv;
	int num,value,j,i,amount;
	
	
	if(!arg)
		return help(me);

	if(sscanf(arg,"%s %d value %d",name,num,value) == 3)
	{
		if(!objectp(obj = present(name,me)))
			return notify_fail("你要寄售什么东西？\n");
		
		if(obj->query("no_sell"))
			return notify_fail("这件东西不能卖断。\n");
		
		if(!obj->query("value"))
			return notify_fail("这件东西一文不值。\n");
		
		if(!num)
			return notify_fail("你要出售多少"+ obj->name() +"。\n");
		
		i=0;
		foreach(ob in all_inventory(me))
		{
			if(ob->query("id") == obj->query("id"))
				i++;
		}
		
		if(i < num)
			return notify_fail("你没有那么多的"+ obj->name()+"。\n");
	
		if(!value)
			return notify_fail("你要将"+ obj->name() +"以多少价钱出售？\n");
		
		if(value < 100 || value > 100000000)
			return notify_fail("售价不得少于一两白银，最多不能超过一万两黄金。\n");
		
		me->set_temp("trade/sname",me->name(1));
		me->set_temp("trade/vname",obj->name(1));
		me->set_temp("trade/value",value);
		me->set_temp("trade/num",num);
		me->set_temp("trade/unit",obj->query("unit"));
		me->set_temp("trade/file",base_name(obj));
		me->set_temp("trade/vid",obj->query("id"));
		"/adm/daemons/traded"->map_trade_info(me);
		while(num--)
		{
			ob = present(name,me);
			destruct(ob);
		}
		me->delete_temp("trade");
		return 1;
	}
//	if(sscanf(arg,"buy %d with %d",num,amount) == 2)
//	{
		
}

int help(object me)
{
	write(@HELP
指令格式 : check|dating [<某人>]

这个指令可以让你打听别人所学过的技能。

你也可以指定一个和你有师徒关系的对象，用 skills|cha 可以查知对方的技能状况。

此命令为丐帮弟子专用，并需学习相应的技能。如果技能不高，那么
打听出来的可能会有一些出入。

HELP );
    return 1;
}
