// family.c
// Create by Robert 蝴蝶君

#include <ansi.h>

inherit F_CLEAN_UP;

int help (object me);

int sort_career(object ob1, object ob2)
{
	if (wizardp(ob1) && ! wizardp(ob2)) return -1;
	if (wizardp(ob2) && ! wizardp(ob1)) return 1;
	if (wizardp(ob1) && wizardp(ob2))
		return (int)SECURITY_D->get_wiz_level(ob2)
			- (int)SECURITY_D->get_wiz_level(ob1);

	return strcmp(ob2->query("career"), ob1->query("career"));
}

int main(object me, string arg)
{
	object *obs;
	object ob;
	string msg;
	
	if(!arg)
	{
		obs = filter_array(all_interactive(),(: stringp($1->query("career")) && !wizardp($1) :));
		obs = sort_array(obs, (: sort_career :));
	}
	else if(arg == "矿工" )
		obs = filter_array(all_interactive(),(: $1->query("career") == "矿工" 
							&& !wizardp($1) :));
	else if(arg == "歌姬" )
		obs = filter_array(all_interactive(),(: $1->query("career") == "歌姬" 
							&& !wizardp($1) :));
	else if(arg == "铸造师")
		obs = filter_array(all_interactive(),(: $1->query("career") == "铸造师" 
							&& !wizardp($1) :));
	else if(arg == "药理师")
		obs = filter_array(all_interactive(),(: $1->query("career") == "药理师" 
							&& !wizardp($1) :));
	else if(arg == "药剂师")
		obs = filter_array(all_interactive(),(: $1->query("career") == "药剂师" 
							&& !wizardp($1) :));
	else if(arg == "小偷")
		obs = filter_array(all_interactive(),(: $1->query("career") == "小偷" 
							&& !wizardp($1) :));
	else if(arg == "猎人")
		obs = filter_array(all_interactive(),(: $1->query("career") == "猎人" 
							&& !wizardp($1) :));
	else if(arg == "裁缝")
		obs = filter_array(all_interactive(),(: $1->query("career") == "裁缝" 
							&& !wizardp($1) :));
	else if(arg == "渔夫")
		obs = filter_array(all_interactive(),(: $1->query("career") == "渔夫" 
							&& !wizardp($1) :));
	else
		return notify_fail("查询失败，游戏中并没有你所指定的职业。\n");

	if(!sizeof(obs))
		return notify_fail("目前没有任何符合条件的玩家。\n");
	
	msg = WHT"目前游戏中已加入职业的玩家有：\n"
	      "----------------------------------------------------------------\n"NOR;
	foreach(ob in obs)
	{
		if(!ob->query("career"))
			continue;
		msg += sprintf("%-18s  "
			       "性别：%-4s   "
			       "职业：%-8s  "
			       "级别：%-8s\n",
			       ob->name(2),
			       ob->query("gender"),
			       ob->query("career"),
			       ob->is_member()? HIY"会员玩家"NOR: CYN"普通玩家"NOR);
	}
	msg += WHT"----------------------------------------------------------------\n"NOR;
	me->start_more(msg);
	return 1;
}

int help (object me)
{
	write(@HELP

指令格式：careers [职业]

这个指令是让你可以查阅在线玩家的职业，也可以指定职业查询。目前游
戏中的职业有：猎人、铸造师、药剂师、药理师、小偷、渔夫、裁缝、歌
姬、矿工。

HELP
	);
	return 1;
}
