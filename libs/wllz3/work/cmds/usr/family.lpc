// family.c
// Create by Robert 蝴蝶君

#include <ansi.h>

inherit F_CLEAN_UP;

int help (object me);

int sort_total(string id1,string id2,mapping info)
{
        if(info[id1] > info[id2])
        	return -1;

        if(info[id1] < info[id2])
                return 1;

        return info[id1] - info[id2];
}

int main(object me, string arg)
{
	mapping family;
	mapping info;
	string *status;
	string str,id;
	string fam;
	object obj;

	int t = time();

	if(!mapp(family = me->query("family")))
		return notify_fail("你目前还没有加入门派，无法查询门派信息。\n");

	if(me->is_busy())
		return notify_fail("你正忙着呢。\n");

	if(t - (int)me->query_temp("time/family") < 30 )
		return notify_fail("请不要滥用这个指令。\n");

	if(!arg)
	{
		info = FAMILY_D->query_family();

		if(!sizeof(info))
			return notify_fail("门派尚未统计信息，无法查询。\n");

		status = sort_array(keys(info),(: sort_total :),info);
		//strcmp
		//status = keys(info);
		str = WHT"目前所有门派状态如下：\n"
			 "----------------------------------------\n"NOR;
		foreach(fam in status)
			str += sprintf("%-8s声望：%-10d技能：%-10d\n",
				fam,info[fam],info[fam] / 100);
		str += WHT"----------------------------------------\n"NOR
			"共计 "+ sizeof(status) +" 个门派。\n";
		me->set_temp("time/family",t);
		me->start_more(str);
		return 1;
	}
	else if(arg == "?")
	{

		info = FAMILY_D->query_family_info(family["family_name"]);

		if(!sizeof(info))
			return notify_fail("门派尚未统计信息，无法查询。\n");

		status = keys(info);
		str = sprintf(WHT"目前「%s」所有人物如下：\n"
			 "------------------------------------------------------\n"NOR,
			 family["family_name"]);
		foreach(id in status)
		{
			str += sprintf("帐号：%-8s名称：%-8s等级：%-4d状态：%s\n",
				capitalize(id),
				info[id]["name"],
				info[id]["level"],
				objectp(obj = find_player(id))? HIG"在线"NOR: WHT"离线"NOR,
				);
		}
		str += WHT"------------------------------------------------------\n"NOR
			  "共计 "+ sizeof(status) +" 位玩家。\n";
		me->set_temp("time/family",t);
		me->start_more(str);
		return 1;

	}
	else return help(me);

}

int help (object me)
{
	write(@HELP

指令格式：family |?

这个指令是让你查询目前门派的相关信息。不加‘?’是显示所有门派的信
息。而加上‘?’，是显示你所在门派的人物信息。这个指令必须在你加入
门派之后才可以使用。

声望：这里是指你所在门派的总体声望，声望直接影响你所能够学习武功的
等级，每当你晋升一级，你所在门派的声望将提高一点。如果你门派的师父
被杀或师兄弟被杀，将被按照等级扣除声望。每个门派初始化声望为十万，
门派二十四小时将会自动增长 10 点声望。

技能：这里是门派支持的等级，技能等级直接被声望所控制，声望越高，你
的门派支持技能将会越高。

HELP
	);
	return 1;
}
