//coquet.c

#include <ansi.h>

inherit F_CLEAN_UP;
int help(object me);

int main(object me,string arg)
{
	object *obs;
	object env;
	object ob,usr,obj;
	string msg;
	int ap,dp;
	int flag;

	if(me->is_busy())
		return notify_fail("你正忙着呢。\n");

	if(me->is_fighting())
		return notify_fail("战斗中不能施展妩媚神功。\n");

	env = environment(me);

	if(env->query("restrict_action"))
		return notify_fail("你不能在这里施展妩媚神功。\n");

	if(env->query("no_fight"))
		return notify_fail("这里由不得你放肆。\n");

	if(!arg || arg == "")
	{
		if(me->query("career") != "歌姬")
		{
			if((int)me->query("jing") < 100)
				return notify_fail("你现在精神不佳，无法施展妩媚神功。\n");

			if((int)me->query("brawn") < 10)
				return notify_fail("你现在体力不佳，无法施展妩媚神功。\n");

			write("你开始施展妩媚神功。\n");
			if( me->query("gender") == "男性")
			{
				tell_room(env,me->name()+"摆出一副撩人的姿态，拼命的对着众人抛眉弄眼，扭捏造作，\n"
					"使得旁人不禁连连作呕。你不禁暗想：莫非，这就是传说中的“如花”？\n",({ me }));
				me->start_busy(5);
				me->add("jing",-100);
				me->add("brawn",- 10);
				return 1;
			 }
			 else if( me->query("gender") == "无性")
			 {
				tell_room(env,me->name()+"摆出一副撩人的姿态，婀娜多姿，万分温柔。可众人仔细一看\n"
					"忍不住唾骂道：我靠，做了太监也不安分。\n",({ me }));
				me->start_busy(3);
				me->add("jing",-100);
				me->add("brawn",- 10);
				return 1;
			 }
			 else
			 {
				tell_room(env,me->name()+"硬是装作一副温柔万分，小鸟伊人的样子，无奈动作生硬，十分勉强。\n",({ me }));
				me->start_busy(5);
				me->add("jing",-100);
				me->add("brawn",-10);
				return 1;
			 }
		}
		else
		{
			if((int)me->query_skill("coquet-skill") < 50)
				return notify_fail("以你现在的能力，不足以施展妩媚神功。\n");
			if((int)me->query("jing") < 500)
				return notify_fail("你现在精神状态太差，无法施展妩媚神功。\n");
			if((int)me->query("brawn") < 50)
				return notify_fail("你现在太累了，不适合施展妩媚神功。\n");
			if(!sizeof(obs = all_inventory(env)) || (sizeof(obs) -1) < 1)
				return notify_fail("这里一个鬼影都没有，你要献给谁看呀？\n");

			write("你开始施展妩媚神功。\n");
			switch(random(6))
			{
				case 0:
					msg = HIM + me->name() +"掏出一把楠木琴，盘腿坐下，手指轻抚琴弦，楠木琴立刻发出一阵动听\n"
					      "的旋律，乐声之中，一阵醉人的香氛飘散而起，更见"+ me->name() +"魅力四射，妩媚万分。\n"NOR;
					break;
				case 1:
					msg = HIC + me->name() +"拿出一把狼毫笔，唰唰唰的在墙上写了一些字，挥笔之间，顾盼生辉，\n"
					      "字迹更是苍劲有力，妙不可言，简直是出自于名家的手笔。\n"NOR;
					break;
				case 2:
					msg = HIW + me->name() +"步履轻盈，姿态端庄有礼的走到众人面前做了个揖，轻轻的说道：各位哥哥\n"
						 "小女子" + me->name()+"有礼了！\n"NOR;
					break;
				case 3:
					msg = HIM"一个宛如清泉的声音吟道：美人卷珠帘，深坐蹙蛾眉，但见泪痕湿，不知心恨谁。\n"
						 "众人循声望去，妙条的身段，洁白的脸颊，那正是当代佳人"+ me->name()+"。\n"NOR;
					break;
				case 4:
					msg = HIM + me->name() +"突然低头垂泪，泣泣声中却又吟道：云想衣裳花想容，春风拂槛露华浓，\n"
						 "若非群玉山头见，会向瑶台月下逢。\n"NOR;
					break;
				case 5:
					msg = HIY"一个妙条的身影从人群中走了过来，柔情无限的眼神轻轻的扫视了四周，\n"
						 "露出了一阵羞涩的微笑。你仔细一看，那正是传说中的当代才女"+ me->name() +"，\n"
						 "当她和你的眼神相触之时，脸颊竟飞起了一道红晕，更显娇媚。\n"NOR;
					break;
			}
			tell_room(env,msg,({ me }));
			foreach(ob in obs)
			{
				if(ob == me) continue;
				if(!living(ob) || !ob->query("can_speak")) continue;
				if((int)ob->query_cor() + (int)ob->query_int() >
				   (int)me->query_per() + (int)me->query_skill("coquet-skill",1) / 10)
					continue;
				if(ob->query("gender") != "男性")
					continue;
				if(ob->query_skill("buddhism",1)  < me->query_skill("coquet-skill",1)
				&& ob->query("class") == "bonze" )
				{
					tell_object(ob,HIR"你只觉得面红耳赤，心跳加速，慌忙默念心经：南无阿弥陀佛，"
						       "空即是色，色即是空！\n"NOR);
					if(!ob->is_busy())
						ob->start_busy(3);
					continue;
				}
				if(ob->is_fighting())
				{
					ob->remove_all_enemy(1);
					message_vision("$N突然收住招式，痴痴的看着$n，似乎完全丧失了斗志。\n",
						ob,me);
					continue;
				}
				switch(random(5))
				{
					case 0:
						message_vision("只见$N面红耳赤，浑身飙汗，似乎欲火焚身，于是......\n",ob);
						ob->force_me("remove all");
						break;
					case 1:
						message_vision("$N怔怔的看着$n，许久，只见鲜红的鼻血犹如山泉奔流，"
							       "哗啦啦的流了出来。\n",ob,me);
						if(ob->query("neili") > ob->query("max_neili") / 10)
							ob->set("neili",(int)ob->query("max_neili") / 10);
						break;
					case 2:
						message_vision("$N痴痴的看着$n，不禁感叹道：想不到人间竟有如此绝色佳人。\n",ob,me);
						break;
					case 3:
						usr = obs[random(sizeof(obs))];
						if(usr && usr != ob && usr != me)
							message_vision("$N怔怔的看着"+ me->name()+"，突然紧紧抱住身边的$n，一阵狂吻 . . . . \n",ob,usr);
						else
							message_vision("$N怔怔的看着$n，突然紧紧的抱住自己，一阵乱摸 . . . . \n",ob,me);
						break;
					case 4:
						message_vision("只见$N三魂不见了七魄，恍恍忽忽，痴痴的看着$n，不禁口水流了一地。\n",
							ob,me);
						break;
				}

				if(!ob->is_busy())
					ob->start_busy((int)me->query_skill("coquet-skill",1) / 60);
			}
		}
		return 1;
	}
	if(arg && sscanf(arg,"%s",arg) == 1)
	{

		if(me->query("career") != "歌姬")
			return notify_fail("你不会妩媚神功。\n");

		if(me->query("jing") < 200)
			return notify_fail("你现在精神不佳，不能施展妩媚神功。\n");

		if(me->query("brawn") < 40)
			return notify_fail("你现在体力不佳，不能施展妩媚神功。\n");

		if((int)me->query_skill("coquet-skill") < 50)
			return notify_fail("以你现在的能力，不足以施展妩媚神功。\n");

		if(!objectp( ob = present(arg,environment(me))))
			return notify_fail("你要对谁施展妩媚神功？\n");

		if(!living(ob) || !ob->is_character())
			return notify_fail("你要对谁施展妩媚神功？\n");

		if(wizardp(ob) && !wizardp(me))
			return notify_fail("你不能对巫师施展妩媚神功。\n");

		if(!ob->query("can_speak") || ob->query("not_living"))
			return notify_fail("你对"+ ob->name()+"施展妩媚神功，简直就是浪费表情。\n");

		if(ob->is_fighting())
			return notify_fail("对方正在战斗，哪有时间理你妩媚啊。\n");

		if(ob->is_busy())
			return notify_fail("对方正忙着呢，哪来的时间理你妩媚啊。\n");

		message_vision("$N开始对$n施展妩媚之技。\n",me,ob);
		switch(random(5))
		{
			case 0:
				msg = MAG"$N步履轻盈的走到$n面前，面带羞涩的问道：敢问这位"+ RANK_D->query_respect(ob)+"尊姓大名？\n"NOR;
				flag = 1;
				break;
			case 1:
				msg = MAG"$N轻轻的走近$n，突然左脚踩到了右脚右脚勾到了左脚，眼看就要摔倒了 ....。\n"NOR;
				flag = 2;
				break;
			case 2:
				msg = MAG"$N面露难色，又带几分羞涩的对$n说道：这位"+ RANK_D->query_respect(me)+"可否帮小女子一个忙？\n"NOR;
				flag = 3;
				break;
			case 3:
				msg = MAG"$N掏出楠木琴，纤纤玉指轻抚琴弦，轻柔的乐声和迷人的香氛一并飘起，不禁让人心醉。\n"NOR;
				flag = 4;
				break;
			case 4:
				msg = MAG"$N低头沉吟：燕草如碧丝，秦桑低绿枝，当君怀归日，是妾断肠时，\n"
				      "春风不相识，何事入罗帏。\n"NOR;
				flag = 5;
				break;
		}
		message_vision(msg,me,ob);
		ap = (int)me->query_skill("coquet-skill",1) / 5 + (int)me->query_per();
		dp = (int)ob->query_cor() + (int)ob->query_int();
		me->add("jing",-200);
		me->add("brawn",-30);
		me->start_busy(4 + random(2));
		if(ob->query("gender") != "男性")
		{
			message_vision(RED"$N回过头来，指着$n的脑门骂道：死狐狸精，给我滚远点。\n"NOR,ob,me);
			return 1;
		}
		if(random(ap) > dp / 3)
		{
			if(me->can_improve_skill("coquet-skill"))
				me->immprove_skill("coquet-skill",random(me->query_per()) + 1);
			if(ob->query("class") == "bonze"
			&& (int)ob->query_skill("buddhism",1) > (int)me->query_skill("coquet-skill",1))
			{
				message_vision("只见$N双手合十，闭上双眼默念心经，面对$n毫不动心。\n");
				me->start_busy(5);
				return 1;
			}
			if(flag == 1)
			{
				message_vision("$N痴痴的盯着$n道："+ RANK_D->query_self(ob) + ob->name() +"，这位姑娘有礼了。\n"
					       "说完，竟不自觉的牵住了$n的手，打算跟随$n一起走了。\n",ob,me);
				ob->set_leader(me);
				return 1;
			}
			if(flag == 2)
			{
				message_vision("$N迅速冲上前去，一把将$n扶起抱在怀里，问道：这位姑娘没事吧？\n"
					       "$n温柔的注视着$N，$N竟也看得如痴如醉 . . . .\n",ob,me);
				if(!ob->is_busy())
					ob->start_busy(ap / 40);
				return 1;
			}
			if(flag == 3)
			{
				obs = all_inventory(ob);
				if(!sizeof(obs))
				{
					message_vision("$N痴痴的看着$n，还没等$n开口，就想把身上所有值钱的东西\n"
						       "都塞给了$n，可惜囊中羞涩，未能如愿。\n",ob,me);
					return 1;
				}
				foreach(obj in obs)
				{
					if(!obj->query("money_id"))
						continue;
					if(obj->query("money_id"))
					{
						message_vision("$N痴痴的看着$n，还没等$n开口，就把身上的"+ obj->name() +"塞给了$n。\n",ob,me);
						if(ob->is_busy())
							ob->start_busy(0);
						ob->force_me("give "+ obj->query("id") +" to "+ me->query("id"));
						break;
					}
					else
					{
						message_vision("$N痴痴的看着$n，还没等$n开口，就想把身上所有值钱的东西\n"
							"都塞给了$n，可惜囊中羞涩，未能如愿。\n",ob,me);
						break;
					}
				}
				return 1;
			}
			if(flag == 4)
			{
				message_vision("$N目光大方异彩，对着$n连连拍手称绝：姑娘好琴艺，真乃是天籁绝音呀！\n",ob,me);
				if((int)ob->query("jing") > ap * 2)
					ob->receive_damage("jing",ap / 2);
				if((int)ob->query("qi") > ap * 2)
					ob->receive_damage("qi",ap / 2);
				else if(!ob->is_busy())
					ob->start_busy(ap / 40);
				return 1;
			}
			if(flag == 5)
			{
				message_vision("$N听得入神，不禁哈哈大笑道：妙，妙，妙啊！\n",ob,me);
				if(ob->add("neili",- ap) < 0)
					ob->set("neili",0);
				return 1;
			}
		}
		else
		{
			message_vision("可是$N对$n的所为根本不为所动，可见其定力何等高超。\n",ob,me);
			return 1;
		}
	}
	else return help(me);
}
int help(object me)
{
	write(@TEXT

指令说明：coquet		对在场的所有人施展妩媚神功
	  coquet [玩家id]	对指定的玩家施展妩媚神功

这种功能必须职业为歌姬的玩家才能发挥，发挥妩媚神功的时候必须具备
一定的体力和精力。如果对方的定力和智慧高超，你的妩媚神功将变得毫
无作用，反之，你的妩媚技巧和魅力达到一定的程度，可以让对方遭到你
的迷惑。
TEXT);
	return 1;
}