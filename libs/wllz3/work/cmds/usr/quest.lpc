#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	mapping q;
	object ob;

	seteuid(getuid());
	while(arg)
	{
		if(!objectp(ob = present(arg,environment(me))))
			return notify_fail("你要跟谁领取任务？\n");

		if(!ob->is_master())
			return notify_fail(ob->name()+"愣愣的看着你，似乎不明白你的意思。\n");

		if(!MISSION_D->valid_quest(ob,me))
			return notify_fail(ob->name()+"愣愣的看着你，似乎不明白你的意思。\n");

                if (! living(ob))
                        return notify_fail("你还是等" + ob->name() +
                                           "醒了再说吧！\n");

                if (me->is_fighting())
                        return notify_fail("专心打你的架！\n");

                if (me->is_busy())
                        return notify_fail("你还是有空了再和" + ob->name() +
                                           "谈这些问题吧！\n");

                if (ob->is_fighting())
                        return notify_fail("你还是等" + ob->name() +
                                           "打完架再说吧！\n");

                if (ob->is_busy())
                        return notify_fail(ob->name() +"正忙着呢，没功夫理你。\n");

		notify_fail(ob->name()+"对你呵呵一笑，显然不明白你的意思。\n");
		return ob->give_quest(me);

	}
	
	if(!mapp(q =  me->query("quest")))
	{
		write("你现在没有任何任务！\n");
		return 1;
	}

	if(q["from"] == "门派")
	{
		switch(q["type"])
		{
			case "kill":
				write(q["master_name"] +"(" + q["master_id"] +")给你的任务是去"
				     +q["where"] +"杀死"+ q["quest"] +"！\n");
				break;
			case "take":
				write(q["master_name"] +"(" + q["master_id"] +")让你去"+ q["where"] +"把"
				     + q["quest"] +"拿回来！\n");
				break;
		}
	}

	if(q["from"] == "官府")
	{
		switch(q["type"])
		{
			case "arrest":
				write("你现在的任务是前往"+ q["where"] +"捉拿通缉要犯"+ q["quest"] +"。\n");
				break;
			case "kill":
				write("你现在的任务是追杀狂徒"+ q["quest"] +"，据说此"
				      "人最近经常在"+ q["where"] +"出现。\n");
				break;
		}
	}

	if(q["from"] == "驿站")
		write("你现在的任务是将信送到"+ q["quest"] +"的手中。\n");

	if(q["from"] == "镖局")
		write("你现在的任务是护送"+ q["quest"] +"到"+ q["where"] +"去，一"
			"路保护他的安全。\n");

	if(q["from"] == "货行")
		write("你现在的任务是去"+ q["where"] +"，将一批"+ q["goods"] +"送到的"+ q["quest"] +"手中。\n");

	if(q["from"] == "药店")
		write("你现在的任务是去帮王通治采集一些"+ q["quest"] +"。\n");

	if((q["task_time"] - time()) < 0)
	{
		write("但是你已经没有足够的时间来完成它了。\n");
		return 1;
	}
	else if(!undefinedp(q["fail_time"]))
	{
		write("现在你已经没有必要再去完成它了。\n");
		return 1;
	}
	else
	{
		write("你务必在" + CHINESE_D->chinese_monthday(q["task_time"]) + "之"
	      	"前完成这个任务。\n");
		return 1;
	}
}

int help(object me)
{
	write(@HELP

这个指令是用来查阅你当前的任务，你也可以利用它来领取任务。

指令格式：quest			查阅当前任务
	  quest <师父 id>	领取门派任务

HELP);
	return 1;
}
