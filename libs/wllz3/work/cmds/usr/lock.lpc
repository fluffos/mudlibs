// version.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object env;

        env = environment(me);

        if(!env)
        	return notify_fail("你现在什么也干不了。\n");

	if(!env->query("no_fight") || !env->query("restrict_action"))
		return notify_fail("你必须找个安全一点的地方才能实现屏幕锁定功能。\n");

	if(!me->is_member())
		return notify_fail("对不起，只有会员才能使用这个功能。\n");

	me->set_temp("locked",1);
	write(CLR);
	write(HIY"你现在进入屏幕锁定状态，如果要解除锁定，请输入你的帐号密码：\n"NOR);
	input_to("check_password",1,me);
        return 1;
}
void check_password(string passwd,object me)
{
	object link_ob;
	string old_pass;

	link_ob = me->query_temp("link_ob");
	old_pass = link_ob->query("password");

	if( crypt(passwd, old_pass)!=old_pass )
	{
		write(HIR"密码错误，解除屏幕锁定失败。\n\n"NOR);
		write(HIY"你现在进入屏幕锁定状态，如果要解除锁定，请输入你的帐号密码：\n"NOR);
		input_to("check_password",1,me,);
		return;
	}
	write(HIC"\n解除屏幕锁定状态：成功！\n\n"NOR);
	me->delete_temp("locked");
	return;
}

int help(object me)
{
  write(@HELP

指令格式：lock

这个指令可以让你进入屏幕保护状态，当您离开电脑的时候，其他人将无
法对你的游戏帐号进行操作。

HELP
        );
        return 1;
}
