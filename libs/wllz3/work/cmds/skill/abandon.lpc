// abandon.c

inherit F_CLEAN_UP;

#define ENABLE_CMD	"/cmds/skill/enable"

void create(){ seteuid(getuid());}

int abandon_force(object me);

int main(object me, string arg)
{
	int skill_lvl;
	string skill;
	mapping map;

	if(!arg || arg == "")
		return notify_fail("你要放弃哪一项技能？\n");

	if(me->is_member() && !me->is_manage())
		return notify_fail("请先进入管理状态，再使用这个指令。\n");

	if(mapp(map = me->query_skill_map()))
	{
		// 如果放弃的是基本技能，如果该技能处于激发状态，先取消基本技能的激发
		if(!undefinedp(map[arg]))
		{
			me->map_skill(arg);
			if(arg == "force")
				me->start_call_out(bind((: call_other,__FILE__,"abandon_force",me:),me));
		}
		// 如果放弃的是已经激发的技能，取消其激发状态
		foreach(skill in keys(map))
		{
			if(!undefinedp(map[skill]) && map[skill] == arg)
			{
				ENABLE_CMD->main(me,skill + " none");
				if(skill == "force")
					me->start_call_out(bind((: call_other,__FILE__,"abandon_force",me:),me));
			}
		}
	}

	skill_lvl = me->query_skill(arg,1);

	if(!skill_lvl)
	{
		me->delete_skill(arg);
		write("Ok.\n");
		return 1;
	}

	if( !me->delete_skill(arg) )
		return notify_fail("你并没有学过这项技能。\n");

	write("你决定放弃继续学习" + to_chinese(arg) + "。\n");

	if((string)SKILL_D(arg)->know() == "shen_learn" )
		me->add("shen",- skill_lvl);

	me->reset_action();
	return 1;
}
int abandon_force(object me)
{
	write("你放弃了你所使用的内功心法，内力必须重新锻练。\n");
	me->set("max_neili",0);
	me->set("neili",0);
	return 1;
}

int help()
{
	write(@TEXT
指令格式：abandon|fangqi <技能名称>

放弃一项你所学过的技能，注意这里所说的「放弃」是指将这项技能从你人物
的资料中删除，如果你以后还要练，必须从０开始重练，请务必考虑清楚。如
果你放弃的是你所使用的内功心法，你的内力也必须重新锻炼。

这个指令使用的场合通常是用来删除一些「不小心」练出来的技能，由于每个
人有着不同的天赋，所修习的武功也不会相同。如果样样都学，到头来只会样
样不精。
TEXT
	);
	return 1;
}
