// finesse.c

#include <ansi.h>

int help(object me);

inherit F_CLEAN_UP;

mapping valid_types = ([
	"unarmed":      "拳脚",
	"sword":        "剑法",
	"blade":        "刀法",
	"stick":        "棒法",
	"staff":        "杖法",
	"hammer":       "锤法",
	"club" :        "棍法",
	"throwing":     "暗器",
	"force":        "内功",
	"parry":        "招架",
	"dodge":        "轻功",
	"magic":        "法术",
	"array":        "阵法",
	"spells":       "咒文",
	"whip":         "鞭法",
	"dagger":       "短兵",
	"finger":       "指法",
	"hand":         "手法",
	"cuff":         "拳法",
	"claw":         "爪法",
	"strike":       "掌法",
	"club":         "棍法",
	"spear":        "枪法",
	"leg":		"腿法",
	"axe":		"斧法",
]);

int main(object me,string arg)
{
	string skill,file;
	string *action;
	string msg;
	object ob;
	string id;

	if(me->is_busy())
		return notify_fail("你正忙着呢。\n");

	if(me->is_fighting())
		return notify_fail("临战抱佛脚已经来不及了，赶紧战斗吧。\n");

	if(me->query("jing") < 100)
		return notify_fail("你精力不济，无法施展。\n");

	if(!arg || sscanf(arg,"%s",skill) != 1)
		return help(me);

	if(!stringp(file = SKILL_D(skill)) ||
		file_size(file + ".lpc") <= 0)
			return notify_fail("你闭上眼睛想要冥思，可是脑子里竟是乱七八糟的东西。\n");

	if(valid_types[skill])
		return notify_fail(to_chinese(skill)+"属于基本武功，没有特殊技能。\n");

	if(!wizardp(me) && (int)me->query_skill(skill,1) < 50)
		return notify_fail("可能是修为尚浅，你默念"+ to_chinese(skill)+"的口诀，却毫无用处。\n");

	action = get_dir(SKILL_D(skill) + "/*.lpc");
	if(!sizeof(action))
	{
		write(sprintf("你默念%s的口诀，冥思苦想了半天，却一无所获。\n",
			to_chinese(skill)));
		return 1;
	}

	msg = "冥冥之中，你领悟到"+ to_chinese(skill) +"的特殊技能：\n"
	WHT"------------------------------------------------------"NOR;
	foreach( id in action)
	{
		if(!objectp(ob = find_object(SKILL_D(skill) + "/" + id)))
			ob = load_object(SKILL_D(skill) + "/" + id);
		if(!ob->help())
		{
			log_file("skill",sprintf("%O.c 没有提供详细介绍。\n",ob));
			continue;
		}
		if(wizardp(me) && wiz_level(me) > 4
		&& me->query("env/prompt") == "file_name")
			msg += sprintf(HIG"\n所属文件：%O.c\n"NOR,ob);
		else
			if(SKILL_D(skill)->is_force())
				msg += sprintf(HIY"\nexert %s\t"NOR,id[0..sizeof(id) - 3]);
			else
				msg += sprintf(HIY"\nperform %s\t"NOR,id[0..sizeof(id) - 3]);
		msg += convert_color(ob->help());
	}
	msg += WHT"------------------------------------------------------\n"NOR;
	me->start_more(msg);
	return 1;
}
int help(object me)
{
	write(@TEXT

指令格式：finesse <skill>

这个指令是让你从武学中领悟到施展技能外功的奥秘。
TEXT);
	return 1;
}