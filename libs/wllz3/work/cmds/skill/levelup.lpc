// conjure.c

#include <ansi.h>

inherit F_CLEAN_UP;

mapping valid_type =([
	"int": "悟性",
	"per": "魅力",
	"str": "臂力",
	"dex": "身法",
	"cor": "定力",
	"con": "体质",
	"kar": "运气",
	"spi": "灵性",
	"cou": "勇气",
]);

int help (object me);
int main(object me, string arg)
{
	int i;
	string type;
	mapping exp_cost;

	if(!mapp(exp_cost = me->query("exp_cost")))
		return notify_fail("你的数据出现缺漏，请和巫师联系。\n");

	if(exp_cost["points"] < 1)
		return notify_fail("你目前没有可分配点数。\n");

	if(!arg || sscanf(arg,"%s %d",type,i) != 2)
		return help(me);

	if( i < 1)
		return notify_fail(HIR"错误：每次分配点数至少为一点。\n"NOR);

	if( i > exp_cost["points"])
		return notify_fail(HIR"错误：你没有那么多的点数可进行分配。\n"NOR);

	if(undefinedp(valid_type[type]))
	{
		write(HIR"错误：你只能根据提示中的属性代码进行分配！\n"NOR);
		return help(me);
	}
	me->add(type,i);
	exp_cost["points"] -= i;
	write(sprintf(HIW"你的%s增加了 "HIY"%d "HIW"点。\n"NOR,valid_type[type],i));
	CHAR_D->setup_char(me);
	return 1;
}

int help (object me)
{
	write(@HELP

指令格式：levelup <属性> <点数>

这个指令是让你在升级的时候，自由分配自己的升级点数。你可以利用它
来增加你的各项属性，每次增长属性至少一点，最多不能超越你可分配的
属性点。分配之前请考虑清楚，属性一旦分配，将无法重新设置。

属性代号如下：

int 才智		per 魅力		spi 灵性
dex 身法		str 臂力		cor 定力
con 体质		kar 运气		cou 勇气

HELP
);
	return 1;
}
