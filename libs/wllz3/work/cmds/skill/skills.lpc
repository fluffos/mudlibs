// skills.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	mapping skl, lrn, map;
	string *sname, *mapped;
	string str;
	string skill;
	string *know_skill = ({ });
	string *special_skill = ({ });
	string *martial_skill = ({ });
	string *sponsor_skill = ({ });
	string *career_skill = ({ });

	seteuid(getuid());

	if(me->is_busy())
		return notify_fail("你正忙着呢。\n");

	if(!arg)
		ob = me;
	else
	{
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
		if (!ob) return notify_fail("你要察看谁的技能？\n");
		if(wizardp(ob)&& !wizardp(me))
			return notify_fail("你要察看谁的技能？\n");
	}
	if( ob!=me && !wizardp(me)
		&& !ob->is_apprentice_of(me)
		&& !me->is_apprentice_of(ob)
		&& ob->query("id") != me->query("marry/id")
		&& ob->query("father_id") != me->query("id")
		&& ob->query("mather_id") != me->query("id"))
			return notify_fail("只有巫师、师徒关系或有亲属关系的人能察看他人的技能。\n");

	skl = ob->query_skills();
	if(!sizeof(skl))
	{
		write( (ob==me ? "你" : ob->name()) + "目前并没有学会任何技能。\n");
		return 1;
	}
	sname  = sort_array( keys(skl), (: strcmp :) );
	str = (ob==me ? WHT"你" : WHT + ob->name()) + "目前共学会了"+ chinese_number(sizeof(skl))+"种技能\n"NOR;
	str += WHT"────────────────────────────────＝>\n"NOR;

	if( mapp(map = ob->query_skill_map()))
		mapped = values(map);
	if( !mapped )
		mapped = ({ });

	if( !mapp(lrn = ob->query_learned()))
		lrn = ([]);

	foreach(skill in sname)
	{
		if(SKILL_D(skill)->type() == "knowledge") know_skill += ({ skill });
		else if(SKILL_D(skill)->type() == "special" ) special_skill += ({ skill });
		else if(SKILL_D(skill)->type() == "sponsor" ) sponsor_skill += ({ skill });
		else if(SKILL_D(skill)->type() == "career" ) career_skill += ({ skill });
		else martial_skill += ({ skill });
	}

	if(sizeof(know_skill))
	{
		str += WHT"【知识技能】\n────────────────────────────────＝>\n"NOR;
		foreach(skill in know_skill)
			str += sprintf("%s%s%-34s" NOR CYN"等级"NOR" %3d  "CYN"下次升级"NOR" %6d "CYN"点\n"NOR,
					(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? HIM : "",
					(member_array(skill, mapped)==-1? "  ": HIY"□"NOR),
					to_chinese(skill) + "(" + skill + ")",
					skl[skill],(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? 0:
					((skl[skill]+1) * (skl[skill]+1)) - ((int)lrn[skill] -1));
		str += WHT"────────────────────────────────＝>\n"NOR;
	}
	if(sizeof(career_skill))
	{
		str += WHT"【职业技能】\n────────────────────────────────＝>\n"NOR;
		foreach(skill in career_skill)
			str += sprintf("%s%s%-34s" NOR CYN"等级"NOR" %3d  "CYN"下次升级"NOR" %6d "CYN"点\n"NOR,
					(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? HIM : "",
					(member_array(skill, mapped)==-1? "  ": HIY"□"NOR),
					to_chinese(skill) + "(" + skill + ")",
					skl[skill],(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? 0:
					((skl[skill]+1) * (skl[skill]+1)) - ((int)lrn[skill] -1));
		str += WHT"────────────────────────────────＝>\n"NOR;
	}

	if(sizeof(martial_skill))
	{
		str += WHT"【武学技能】\n────────────────────────────────＝>\n"NOR;
		foreach(skill in martial_skill)
			str += sprintf("%s%s%-34s" NOR CYN"等级"NOR" %3d  "CYN"下次升级"NOR" %6d "CYN"点\n"NOR,
					(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? HIM : "",
					(member_array(skill, mapped)==-1? "  ": HIY"□"NOR),
					to_chinese(skill) + "(" + skill + ")",
					skl[skill],(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? 0:
					((skl[skill]+1) * (skl[skill]+1)) - ((int)lrn[skill] -1));
		str += WHT"────────────────────────────────＝>\n"NOR;
	}
	if(sizeof(special_skill))
	{
		str += WHT"【特殊技能】\n────────────────────────────────＝>\n"NOR;
		foreach(skill in special_skill)
			str += sprintf("%s%s%-34s" NOR CYN"等级"NOR" %3d  "CYN"下次升级"NOR" %6d "CYN"点\n"NOR,
					(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? HIM : "",
					(member_array(skill, mapped)==-1? "  ": HIY"□"NOR),
					to_chinese(skill) + "(" + skill + ")",
					skl[skill],(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? 0:
					((skl[skill]+1) * (skl[skill]+1)) - ((int)lrn[skill] -1));
		str += WHT"────────────────────────────────＝>\n"NOR;
	}
	if(sizeof(sponsor_skill))
	{
		str += WHT"【自创技能】\n────────────────────────────────＝>\n"NOR;
		foreach(skill in sponsor_skill)
			str += sprintf("%s%s%-34s" NOR CYN"等级"NOR" %3d  "CYN"下次升级"NOR" %6d "CYN"点\n"NOR,
					(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? HIM : "",
					(member_array(skill, mapped)==-1? "  ": HIY"□"NOR),
					to_chinese(skill) + "(" + skill + ")",
					skl[skill],(lrn[skill] >= (skl[skill]+1) * (skl[skill]+1)) ? 0:
					((skl[skill]+1) * (skl[skill]+1)) - ((int)lrn[skill] -1));
		str += WHT"────────────────────────────────＝>\n"NOR;
	}
	me->start_more(str);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : skills|cha [<某人>]

这个指令可以让你(你)查询所学过的技能。

你也可以指定一个和你有师徒关系的对象或你的配偶，用 skills 可以查
知对方的技能状况。

巫师可以查询任何人或 NPC 的技能状况。

HELP
    );
    return 1;
}
