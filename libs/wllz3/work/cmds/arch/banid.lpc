// banid.c

#include <ansi.h>

int help(object me);

int main(object me, string arg)
{
        string id,*banid;
        mapping info;
        int ban_time;
        int time;

        if(!SECURITY_D->valid_grant(me,"(arch)"))
		return notify_fail("你无权使用这个指令。\n");

        if (!arg)
        {
        	info = BAN_D->ban_all_user();

        	if(!sizeof(info))
        		return notify_fail("本游戏目前没有禁止任何登陆用户。\n");

		banid = keys(info);
		foreach(id in banid)
        		write(sprintf("用户："CYN"%-8s"NOR" 解禁时间：%s%s \n"NOR,
        			id,info[id] > time()? CYN :HIR,
        			ctime(info[id])));
        }
        else
        	if (sscanf(arg, "+ %s %d", id,time) == 2)
        	{
                	if (id[sizeof(id)-1] == '*' || id[sizeof(id)-1] == '?' || id[sizeof(id)-1] == '+')
                        	write("不能禁止以 *, +, ? 结尾的ID。\n");
                	else
                	{
                        	if(ban_time = BAN_D->query_ban_user(id))
                        	{
                        		write(sprintf(CYN"%s "NOR"已经被禁止登陆，解禁时间为："CYN"%s\n"NOR,
                        			id,ctime(ban_time)));
                        		return 1;
				}

                        	BAN_D->map_ban_user(id,time);
                       		write(sprintf(CYN"%s "NOR"被禁止登陆 %s 天，解禁时间为："CYN"%s\n"NOR,
                      			id,chinese_number(time),
                      			ctime(BAN_D->query_ban_user(id))));
				return 1;

                	}
        }
        else if (sscanf(arg, "- %s", id) == 1)
        {
                if(!BAN_D->query_ban_user(id))
                	return notify_fail("这个 id 并没有被禁止登陆。\n");

                BAN_D->remove_ban_user(id);
               	write(sprintf("解禁成功，"CYN"%s"NOR" 可以继续使用了。\n",id));
               	return 1;
        }
        else help(me);

        return 1;

}

int help(object me)
{
        write(@HELP
指令格式：banid                   显示所有强行封闭的ID
          banid + <id> <time>     禁闭ID，并限定时间
          banid - <id>		  解禁ID

强行封闭一些ID，用于防止有人蓄意捣乱。

HELP);

        return 1;
}
