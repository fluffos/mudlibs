// banname.c
// Design By Robert 蝴蝶君 email:robert_st@sina.com

#include <ansi.h>

int help(object me);

int main(object me, string arg)
{
        string name,msg;
	mixed *info;
	int i;

        if (!arg)
        {
        	info = BAN_D->ban_all_name();
        	if(!sizeof(info))
        		return notify_fail("目前系统并没有禁止任何名字。\n");

		write("目前系统禁止使用的名字有：\n");
		for(i=0;i<sizeof(info);i++)
			write(sprintf(CYN"%s\n"NOR,info[i]));

		return 1;

        }
        else if (sscanf(arg, "+ %s", name) == 1) {
                if (name[sizeof(name)-1] == '*' || name[sizeof(name)-1] == '?' || name[sizeof(name)-1] == '+')
                        write("不能禁止以 *, +, ? 结尾的ID。\n");
                else
                {
                        if(msg = BAN_D->add_ban_name(name))
                        	write(msg);

                }
        }
        else if (sscanf(arg, "- %s", name) == 1)
        {
                if(msg = BAN_D->remove_ban_name(name))
                	write(msg);
        }
        else help(me);

        return 1;

}

int help(object me)
{
        write(@HELP
指令格式：banname                   显示所有强行封闭的中文名字
          banname +|- name          封闭／解封中文名字

强行封闭一些中文名字，用于防止有人蓄意捣乱。


HELP
        );

        return 1;
}
