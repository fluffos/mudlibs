// ban.c

#include <ansi.h>

int help(object me);

int main(object me, string arg)
{
        string site;
	string msg;
	mixed *info;
	int i;

        if (!arg)
        {
        	info = BAN_D->ban_all_ip();
        	if(!sizeof(info))
        		return notify_fail("系统目前没有禁止任何地址。\n");

        	write("系统目前禁止的网络地址有：\n");
        	for(i=0;i<sizeof(info);i++)
        	{
        		write(sprintf("%s\n",info[i]));
        	}
	}
        else if (sscanf(arg, "+ %s", site) == 1)
        {
                if (site[sizeof(site)-1] == '*' || site[sizeof(site)-1] == '?' || site[sizeof(site)-1] == '+')
                        write("不能禁止以 *, +, ? 结尾的地址。\n");
                else {
                        if(msg = BAN_D->add_ban_ip(site))
                        write(msg);
                }
        }
        else if (sscanf(arg, "- %s", site) == 1)
        {
                if(msg = BAN_D->remove_ban_ip(site))
                	write(msg);
        }
        else help(me);

        return 1;

}

int help(object me)
{
        write(@HELP
指令格式：ban                   显示所有强行封闭的地址
          ban +|- site          封闭／解封地址

强行封闭一些地址，用于防止有人蓄意捣乱。

关联信息：pass
HELP
        );

        return 1;
}
