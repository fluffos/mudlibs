// user list

inherit F_CLEAN_UP;

int main(object me,string arg)
{
	object *ob,usr;
	int i;

        if (! SECURITY_D->valid_grant(me, "(wizard)"))
                return 0;
	
	if(arg)
	{
		if(!objectp(usr = find_player(arg)))
			return notify_fail("没有这个玩家。\n");

		write(sprintf("%15s : %30s\n",usr->query("id"),
			file_name(usr)));
		return 1;
	}

	ob=users();	
	i = sizeof(ob);
	while (i--)
	{
		write(sprintf("%15s : %30s\n",ob[i]->query("id"),
		file_name(ob[i])));
	}
	return 1;
}

int help(object me)
{

write(@HELP

指令格式：ulist | ulist <id>

将线上所有玩家的文件编号码都显示出来，你也可以制定查询一个玩家的
文件编号码。

HELP
);
	return 1;
}
