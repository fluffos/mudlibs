// who1.c

inherit F_CLEAN_UP;

#include <ansi.h>

int main(object me, string arg)
{
	object where, ob, *ob_list;
	mapping dbase;
	string str;

	seteuid(getuid());

	ob_list = filter_array(children(USER_OB),(: userp :));
	ob_list = sort_array(users(), "sort_user", this_object());

	if(!arg)
	{
		str = HIG"玩家名称          等级精神       气血       精力       内力\n"NOR;
		str += "───────────────────────────────────────\n";
		foreach(ob in ob_list)
		{
			dbase = ob->query_entire_dbase();
			str += sprintf(WHT"%-18s"
				       RED"%-4d"
				       YEL"%5d/%-5d"
				       RED"%5d/%-5d"
				       YEL"%5d/%-5d"
				       RED"%5d/%-5d\n"NOR,
				ob->name(2),
				dbase["level"],
				dbase["jing"],
				dbase["max_jing"],
				dbase["qi"],
				dbase["max_qi"],
				dbase["jingli"],
				dbase["max_jingli"],
				dbase["neili"],
				dbase["max_neili"]);
		}
		str += "───────────────────────────────────────\n";
		str = sprintf("%s共有 %d 位使用者连线中。\n", str, sizeof(ob_list));
		me->start_more(str);
		return 1;
	}
	if(arg == "-1")
	{
		str = HIG"玩家名称           年龄  性别  等级     经验             潜能         神\n"NOR;
		str += "───────────────────────────────────────\n";
		foreach(ob in ob_list)
		{
			dbase = ob->query_entire_dbase();
			str += sprintf(WHT"%-18s"
				       RED"%-3d"
				       YEL"%-4s"
				       RED"%-3d  "
				       YEL"%7d/%-7d"
				       RED"%7d/%-7d  "
				       YEL"%d\n"NOR,
				       ob->name(2),
				       dbase["age"],
				       dbase["gender"],
				       dbase["level"],
				       dbase["exp_cost"]["exp"],
				       ob->level_exp_limit(),
				       dbase["potential"],
				       ob->max_potential(),
				       dbase["shen"]);
		}
		str += "───────────────────────────────────────\n";
		str = sprintf("%s共有 %d 位使用者连线中。\n", str, sizeof(ob_list));
		me->start_more(str);
		return 1;
	}
	if(arg == "-2")
	{
		str = HIG"玩家名称            存款    网络地址         所在     程序\n"NOR;
		str += "───────────────────────────────────────\n";
		foreach(ob in ob_list)
		{
			dbase = ob->query_entire_dbase();
			where = environment(ob);
			str += sprintf(WHT"%-18s"
				       RED"%-6d"
				       HIY"%-15s"NOR,
				       ob->name(2),
				       dbase["balance"] / 10000,
				       ob->query_temp("netdead")? "---------------":
				       query_ip_number(ob));
			if(where)
				str += sprintf("%s("HIC"%s"NOR")\n"NOR,
					where->short(),
					file_name(where));
			else
				str +="\n";
		}
		str += "───────────────────────────────────────\n";
		str = sprintf("%s共有 %d 位使用者连线中。\n", str, sizeof(ob_list));
		me->start_more(str);
		return 1;
	}
	if(arg == "-3")
	{
		str = HIG"玩家名称  臂力    才智    体质    魅力    运气    灵性    身法    定力    勇气\n"NOR;
		str += "───────────────────────────────────────\n";
		foreach(ob in ob_list)
		{
			dbase = ob->query_entire_dbase();
			str += sprintf(CYN"%-8s"
				       WHT"%-3d:%-3d "
				       CYN"%-3d:%-3d "
				       WHT"%-3d:%-3d "
				       CYN"%-3d:%-3d "
				       WHT"%-3d:%-3d "
				       CYN"%-3d:%-3d "
				       WHT"%-3d:%-3d "
				       CYN"%-3d:%-3d "
				       WHT"%-3d:%-3d \n"NOR,
				       dbase["id"],
				       dbase["str"],ob->query_str(),
				       dbase["int"],ob->query_int(),
				       dbase["con"],ob->query_con(),
				       dbase["per"],ob->query_per(),
				       dbase["kar"],ob->query_kar(),
				       dbase["spi"],ob->query_spi(),
				       dbase["dex"],ob->query_dex(),
				       dbase["cor"],ob->query_cor(),
				       dbase["cou"],ob->query_cou());
		}
		str += "───────────────────────────────────────\n";
		str = sprintf("%s共有 %d 位使用者连线中。\n", str, sizeof(ob_list));
		me->start_more(str);
		return 1;
	}
	if(arg == "-4")
	{
		str = HIG"玩家名称  攻击系数防御系数闪躲等级\n"NOR;
		str += "───────────────────────────────────────\n";
		foreach(ob in ob_list)
		{
			str += sprintf("%-8s  "
				       "%-10d "
				       "%-10d "
				       "%-5d \n",
				       ob->query("id"),
				       ob->query_temp("apply/attack"),
				       ob->query_temp("apply/dodge"),
				       ob->query_skill("dodge"));

		}
		str += "───────────────────────────────────────\n";
		str = sprintf("%s共有 %d 位使用者连线中。\n", str, sizeof(ob_list));
		me->start_more(str);
		return 1;
	}

}
int sort_user(object ob1, object ob2)
{
	if( wizardp(ob1) && !wizardp(ob2) ) return -1;
	if( wizardp(ob2) && !wizardp(ob1) ) return 1;
	if( wizardp(ob1) && wizardp(ob2) )
		return (int)SECURITY_D->get_wiz_level(ob2)
			- (int)SECURITY_D->get_wiz_level(ob1);

	return (int)ob2->query("level") - (int)ob1->query("level");

}
int help(object me)
{
	write(@HELP

指令格式：usrdata |usrdata [-1][-2][-3]

玩家信息查询。

HELP
	);
	return 1;
}

