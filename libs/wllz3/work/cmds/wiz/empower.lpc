//empower.c

#include <ansi.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me,string arg)
{
	object ob;
	string target;
	mapping info;
	string msg;

	if(!SECURITY_D->valid_grant(me,"(wizard)"))
		return notify_fail("你无权使用这个指令。\n");

	if(arg && sscanf(arg,"set %s",arg) == 1)
	{

		if(mapp(LOG_D->query_teacher(arg)))
			return notify_fail(arg +" 已经是游戏导师了。\n");

		ob = new(LOGIN_OB);
		ob->set("id",arg);
		if(!ob->restore())
		{
			destruct(ob);
			return notify_fail("没有这个玩家。\n");
		}
		LOG_D->map_add_teacher(ob->query("name"),arg);
		destruct(ob);
		write("玩家 "+ arg +" 已经授权为游戏导师了。\n");
		return 1;
	}

	if(arg && sscanf(arg,"del %s",arg) == 1)
	{
		if(!mapp(LOG_D->query_teacher(arg)))
			return notify_fail(arg +" 并不是游戏导师。\n");

		LOG_D->remove_teacher(arg);
		write("取消玩家 "+ arg +" 游戏导师权限成功。\n");
		return 1;
	}
	if(arg && arg == "check")
	{
		info = LOG_D->query_teacher();

		if(!sizeof(info))
			return notify_fail("游戏导师数据还没有创建，无法查询。\n");

		msg = "目前游戏中的游戏导师有：\n"
		      "--------------------------------------------------------------------\n";
		foreach(target in keys(info))
		{
			msg += sprintf("帐号：%-18s上任时间：%s状态：",
				info[target]["name"] + "("+ target +")",
				ctime(info[target]["time"])[0..15]);
			if(find_player(target))
				msg += HIG"在线\n"NOR;
			else
				msg += WHT"离线\n"NOR;
		}
		msg +="--------------------------------------------------------------------\n";
		write(msg);
		return 1;
	}

	else return help(me);
}
int help(object me)
{

	write(@HELP

指令格式：empower set <游戏 id> 	设置游戏导师
	  empower del <游戏 id> 	取消游戏导师
	  empower check			查询游戏导师

这个指令是让你设置游戏中的任意一位玩家成为游戏导师。你也可以通过
它来取消游戏导师权限。
HELP);
	return 1;
}
