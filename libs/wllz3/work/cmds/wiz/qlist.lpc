//qlist.c

inherit F_CLEAN_UP;

int sort_quest(object ob1, object ob2)
{
	if (wizardp(ob1) && ! wizardp(ob2)) return -1;
	if (wizardp(ob2) && ! wizardp(ob1)) return 1;
	if (wizardp(ob1) && wizardp(ob2))
		return (int)SECURITY_D->get_wiz_level(ob2)
			- (int)SECURITY_D->get_wiz_level(ob1);

	return strcmp(ob2->query("quest/from"), ob1->query("quest/from"));
}

int main(object me,string arg)
{
	object *obs;
	object ob;
	mapping q;
	string msg;

        if (! SECURITY_D->valid_grant(me, "(wizard)"))
                return 0;

        seteuid(getuid());

	obs = filter_array(all_interactive(),(: $1->query("quest") && !wizardp($1) :));
	obs = sort_array(obs, (: sort_quest :));

	if(!sizeof(obs))
		return notify_fail("游戏中还没有玩家在执行任务。\n");

	msg = "目前游戏中正在执行任务的玩家有：\n"
	      "帐号      来源  类型    所属门派  授予      任务          连续  有效时间    \n"
	      "-----------------------------------------------------------------------\n";
	foreach(ob in obs)
	{
		q = ob->query("quest");
		msg += sprintf("%-8s  "
		               "%-4s  "
		               "%-6s  "
		               "%-8s  "
		               "%-8s  "
		               "%-12s  "
		               "%-4d  "
		               "%-10s\n",
		               ob->query("id"),
		               q["from"],
		               q["type"],
		               ob->query("family/family_name"),
		               undefinedp(q["master_name"]) ? "不详":q["master_name"],
		               q["quest"],
		               ob->query_temp("counts"),
			       CHINESE_D->chinese_monthday(q["task_time"]));
	}
	msg += "-----------------------------------------------------------------------\n";
	msg += "共有 "+ sizeof(obs) +" 位玩家正在执行任务\n";
	write(msg);
	return 1;
}
int help(object me)
{
	write(@TEXT

指令格式：qlist

这个指令是让你查阅在线玩家的任务列表。

TEXT);
	return 1;
}