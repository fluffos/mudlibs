inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  int i, t;

  if (sscanf(arg, "%d", i)) {
    for (t = 0; t < i; t++) {
      write(sprintf("%d 57 = %d\n", t, t % 57));
    }
    return 1;
  }
}
int help(object me) {
  write(@TEXT

指令格式：decode

这个指令是用来从代码的 dbase 中输出源代码。
注意：这个指令只针对房间的格式来还原，输出后以‘.bak’为扩展名保
存。

TEXT);
  return 1;
}
