#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object usr,ob;
	object *obs;
	string ip;

	if(SECURITY_D->get_status(geteuid(me)) != "(admin)")
		return notify_fail("你无权使用这个指令。\n");
	
	if(!arg)
		return notify_fail("指令格式：dis <使用者 id> \n");
	
	if(!objectp(usr = find_player(arg)))
		return notify_fail("没有这个使用者。\n");
	
	if(!interactive(usr))
		return notify_fail("你只能强制连线用户处于断线状态。\n");

	if(usr->is_net_dead())
		return notify_fail("该使用者目前处于断线状态，无法强制断线。\n");
	
	seteuid(getuid());

	ip = query_ip_number(usr);
	foreach(ob in all_interactive())
	{
		if(query_ip_number(ob) != ip)
			continue;
		remove_interactive(ob);
	}

	if(!interactive(usr))
	tell_object(me,"Ok！\n");
	return 1;
}

int help(object me)
{
	write(@HELP

指令格式：dis

这个指令是让你对一些使用者进行强制断线，以便进行资料档处理等。

HELP
);
	return 1;
}
