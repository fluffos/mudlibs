// shutdown.c

#include <ansi.h>
#include <net/daemons.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string wiz_status;
	object *user, link_ob;
	int i;

	if( me != this_player(1) )
		return 0;

	if (! SECURITY_D->valid_grant(me, "(admin)"))
		return 0;

	if(!me->query_temp("pending/shutdown"))
	{
		write(HIW"如果你确定重新启动游戏，请再一次输入这个指令。\n"NOR);
		me->set_temp("pending/shutdown",1);
		return 1;
	}

	log_file("static/shutdown.log",
	       sprintf("%s shutdown game at %s \n",
			me->name(2),ctime(time())));

	message_system("游戏重新启动，请稍候再登录。");

	user = users();

	for(i=0; i<sizeof(user); i++)
	{
		if( !environment(user[i]) ) continue;
		user[i]->save();
		link_ob = user[i]->query_temp("link_ob");
		if( objectp(link_ob) ) link_ob->save();
		user[i]->save();
	}

	if( find_object(DNS_MASTER) )
		catch(DNS_MASTER->send_shutdown());

	shutdown(0);
	return 1;
}
int help (object me)
{
	write(@HELP
指令格式: shutdown

马上重新起动游戏。

HELP
);
	return 1;
}

