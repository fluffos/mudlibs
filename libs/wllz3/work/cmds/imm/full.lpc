// full.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me,string arg)
{
	object ob;

	if(!arg || wiz_level(me) < wiz_level("(wizard)"))
		ob = me;
	else if(arg)
	{
		if(!objectp(ob = find_player(arg)))
			return notify_fail("没有这个玩家！\n");
	}

	ob->set("eff_jing", (int)ob->query("max_jing"));
	ob->set("eff_qi",   (int)ob->query("max_qi"));
	ob->set("jing",     (int)ob->query("eff_jing"));
	ob->set("qi",       (int)ob->query("eff_qi"));
	ob->set("jingli",   (int)ob->query("max_jingli"));
	ob->set("neili",    (int)ob->query("max_neili"));
	ob->set("food",     (int)ob->max_food_capacity());
	ob->set("water",    (int)ob->max_water_capacity());
	ob->set("brawn",    (int)ob->query("max_brawn"));

	if(ob != me && !wizardp(ob))
	{
		CHANNEL_D->do_channel(find_object(SEC_OB),"sys",
			sprintf("%s将%s的状态恢复了。",me->name(2),ob->name(2)));
		log_file("static/FULL",sprintf("%s 将 %s 的状态恢复了[%s]。\n",
			me->name(2),ob->name(2),ctime(time())));
	}
	if(ob==me)
		write(HIG"你的状态重新恢复完毕！\n"NOR);
	else
	{
		write(HIG"你将"+ob->name()+"的状态重新恢复完毕！\n"NOR);
		tell_object(ob,HIG + me->name(1)+"将你的状态重新恢复完毕！\n"NOR);
	}
	return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : full

此指令可让你恢复所有的精气。
HELP
	);
	return 1;
}
