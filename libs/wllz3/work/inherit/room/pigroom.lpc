        return notify_fail("现在桌子上没坐满！\n");
    }
    if (pig_stage != 3) {
        return notify_fail("你想干什么？\n");
    }
    if (claimer == v2->query_temp("pigging_seat")) {
        return notify_fail("一次就够了！\n");
    }
    if (!arg) {
        if (claimer != "") {
            return notify_fail("claim yes|no ？\n");
        }
        agreed[claimer = v2->query_temp("pigging_seat")] = 1;
        write("你发出全收的要求！等待回音……\n");
        for (v1 = 0; v1 < 4; v1++) {
            if (seat[v1] != claimer) {
                tell_object(pl[seat[v1]], v2->query("name") + "认为他手中的牌都是大的了！\n" + refresh_str(v2->query_temp("pigging_seat")) + "请用 claim yes 通过，或者 claim no 否决。\n");
            }
        }
        return 1;
    }
    if (arg == "yes") {
        if (claimer == "") {
            return notify_fail("没有人想全收！\n");
        }
        if (!agreed[v2->query_temp("pigging_seat")]) {
            agreed[v2->query_temp("pigging_seat")] = 1;
            message_vision("$N同意$n的牌都是大的了！\n", v2, pl[claimer]);
            for (v1 = 0; v1 < 4; v1++) {
                if (agreed[seat[v1]] != 1) {
                    return 1;
                }
            }
            message_vision("$N的要求被通过了！！\n", pl[claimer]);
            after_claim();
            return 1;
        }
    }
    if (arg == "no") {
        if (claimer == "") {
            return notify_fail("没有人想全收！\n");
        }
        message_vision("$N否决了$n的要求！！\n继续出牌！\n", v2, pl[claimer]);
        claimer = "";
        for (v1 = 0; v1 < 4; v1++) {
            agreed[seat[v1]] = 0;
        }
        return 1;
    } else {
        return notify_fail("claim 什么？\n");
    }
}

int do_sit(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "north" && arg != "west" && arg != "south" && arg != "east") {
        return notify_fail("你想坐在哪里？\n");
    }
    if (server == v1) {
        return notify_fail("桌长不能换坐位！\n");
    }
    map_delete(pl, v1->query_temp("pigging_seat"));
    if (!objectp(pl[arg])) {
        if (!pl_count()) {
            pig_init();
            server = v1;
            write("你现在是桌长！\n");
            round_order = "/adm/daemons/pigd.lpc"->order_turn(dealer = arg);
        }
        pl[arg] = v1;
        v1->set_temp("pigging_seat", arg);
        message_vision("$N坐上了" + chinese_seat[arg] + "的位子。\n", v1);
        if (pl_count() == 3) {
            tell_room(this_object(), "现在是三缺一，你们只再需要一个玩家就可以开拱了！\n");
        }
        if (pl_count() == 4) {
            tell_room(this_object(), "好，人凑齐了！\n");
            deal_init();
        }
        return 1;
    } else {
        return notify_fail("这个位子上已经有人了！\n");
    }
}

int do_leave(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!v2->query_temp("pigging_seat", arg)) {
        return notify_fail("你现在没有在拱猪！\n");
    } else if (server == v2) {
        message_vision("桌长$N不想再拱下去了！\n", v2);
        server = 0;
        for (v1 = 0; v1 < 4; v1++) {
            if (objectp(pl[seat[v1]])) {
                message_vision("$N站了起来。\n", pl[seat[v1]]);
                pl[seat[v1]]->delete_temp("pigging_seat");
                map_delete(pl, seat[v1]);
            }
        }
        pig_stage = 0;
        return 1;
    } else {
        map_delete(pl, v2->query_temp("pigging_seat"));
        v2->delete_temp("pigging_seat");
        message_vision("$N不想再拱了，站了起来！\n", v2);
        return 1;
    }
}

void do_assign_cards() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = 0;
    for (v1 = 0; v1 < 13; v1++) {
        for (v2 = 0; v2 < 4; v2++) {
            cards[seat[v2]][v1] = newcards[v3++];
        }
    }
    for (v1 = 0; v1 < 4; v1++) {
        cards[seat[v1]] = sort_array(cards[seat[v1]], 1);
        tell_object(pl[seat[v1]], "/adm/daemons/pigd.lpc"->refresh(cards[seat[v1]], 0, 12));
        card_count[seat[v1]] = 13;
    }
}

int do_deal(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v4 = this_player();
    if (v4 != server) {
        return notify_fail("你不是桌长！\n");
    }
    if (pig_stage != 1 || pl_count() != 4) {
        return notify_fail("现在不能发牌！\n");
    }
    "/adm/daemons/pigd.lpc"->shuffle(oldcards, newcards, 2);
    for (v1 = 0; v1 < 13; v1++) {
        for (v2 = 0; v2 < 4; v2++) {
            cards[seat[v2]][v1] = newcards[v3++];
        }
    }
    for (v1 = 0; v1 < 4; v1++) {
        cards[seat[v1]] = sort_array(cards[seat[v1]], 1);
        tell_object(pl[seat[v1]], "你得到的牌为：\n" + "/adm/daemons/pigd.lpc"->refresh(cards[seat[v1]], 0, 12));
        card_count[seat[v1]] = 13;
    }
    tell_room(this_object(), "发完牌了，有谁要卖牌的没有？\n");
    tell_room(this_object(), "如果你卖完了牌，打一下 pass 。\n");
    bid_init();
    return 1;
}

int do_refresh(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("pigging_seat")) {
        return notify_fail("你没有在拱猪！\n");
    }
    if (pig_stage < 2 || card_count[v1->query_temp("pigging_seat")] < 1) {
        return notify_fail("你手上没有牌！\n");
    }
    tell_object(pl[v1->query_temp("pigging_seat")], "你手上有这些牌：\n" + refresh_str(v1->query_temp("pigging_seat")));
    return 1;
}

int do_bid(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    if (!v1->query_temp("pigging_seat")) {
        return notify_fail("你没有在拱猪！\n");
    }
    if (pig_stage != 2) {
        return notify_fail("现在不是卖牌的时候！\n");
    }
    if (!arg) {
        return notify_fail("你想卖什么？\n");
    }
    if ((v2 = "/adm/daemons/pigd.lpc"->is_validcard(arg)) == -1 || !"/adm/daemons/pigd.lpc"->has_card(cards[v1->query_temp("pigging_seat")], 0, 12, v2)) {
        return notify_fail("你手上没有这张牌！\n");
    }
    if (!(v3 = "/adm/daemons/pigd.lpc"->is_validbid(v2))) {
        return notify_fail("这张牌不能被卖！\n");
    }
    if (bid_flag & v3) {
        return notify_fail("这张牌已经被卖过了！\n");
    }
    bid_flag |= v3;
    switch (v3) {
    case 1:
        allow_playbid[0] = 0;
        break;
    case 2:
        allow_playbid[1] = 0;
        break;
    case 4:
        allow_playbid[2] = 0;
        break;
    case 8:
        allow_playbid[3] = 0;
        break;
    }
    message_vision("$N说道：我卖" + "/adm/daemons/pigd.lpc"->card_str(v2) + "！\n", v1);
    v4 = "";
    if (bidcard_str != "") {
        v4 = "，";
    }
    bidcard_str = "/adm/daemons/pigd.lpc"->card_str(v2) + "（" + v1->query("name") + "）" + v4 + bidcard_str;
    return 1;
}

int do_pass(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!v1->query_temp("pigging_seat")) {
        return notify_fail("你没有在拱猪！\n");
    }
    if (pig_stage != 2) {
        return notify_fail("你想干什么？\n");
    }
    if (passed[v1->query_temp("pigging_seat")] == 1) {
        return notify_fail("你已经停卖了！\n");
    }
    passed[v1->query_temp("pigging_seat")] = 1;
    message_vision("$N说道：我停卖！\n", v1);
    for (v2 = 0; v2 < 4; v2++) {
        if (!passed[seat[v2]]) {
            return 1;
        }
    }
    for (v2 = 0; v2 < 4; v2++) {
        passed[seat[v2]] = 0;
    }
    tell_room(this_object(), "全部停卖，开拱！！\n");
    tell_room(this_object(), "这把由" + pl[dealer]->query("name") + "先出。\n");
    play_init();
    return 1;
}

void after_play() {
    mixed v1;
    roundcard_count++;
    for (v1 = 0; v1 < 4; v1++) {
        if (card_count[seat[v1]] > 0) {
            tell_object(pl[seat[v1]], table_str(seat[v1]));
        }
    }
    if (roundcard_count > 3) {
        after_round();
    }
}

void after_winner(mixed arg) {
    mixed v1;
    message_vision("$N的" + "/adm/daemons/pigd.lpc"->card_str(roundcards[arg]) + "最大！\n", pl[arg]);
    for (v1 = 0; v1 < 4; v1++) {
        if ("/adm/daemons/pigd.lpc"->is_special(roundcards[seat[v1]])) {
            picks[arg][pick_count[arg]++] = roundcards[seat[v1]];
            if (roundcards[seat[v1]] == 10) {
                message_vision("$N得到了猪头！！\n", pl[arg]);
                dealer = arg;
            }
        }
    }
    picks[arg] = sort_array(picks[arg], 1);
}

void after_round() {
    mixed v1;
    allow_playbid[roundcards[round_order[0]] / 13] = 1;
    after_winner(v1 = "/adm/daemons/pigd.lpc"->card_cmp4(roundcards, roundcards[round_order[0]] / 13));
    round_init(v1);
    if (round_no++ == 12) {
        auto_play();
    }
}

void auto_play() {
    mixed v1;
    for (v1 = 0; v1 < 4; v1++) {
        roundcards[seat[v1]] = cards[seat[v1]][0];
    }
    roundcard_count = 4;
    for (v1 = 0; v1 < 4; v1++) {
        card_count[seat[v1]] = 0;
        tell_object(pl[seat[v1]], table_str(seat[v1]));
    }
    after_winner("/adm/daemons/pigd.lpc"->card_cmp4(roundcards, roundcards[round_order[0]] / 13));
    after_hand();
}

void after_hand() {
    mixed v1;
    mixed v2;
    v2 = "";
    for (v1 = 0; v1 < 4; v1++) {
        hscore[seat[v1]] = "/adm/daemons/pigd.lpc"->count_score(picks[seat[v1]], bid_flag);
        if (hscore[seat[v1]] == 1000) {
            v2 = seat[v1];
        }
        pl[seat[v1]]->add("pig_played", 1);
        pl[seat[v1]]->add("pig_score", hscore[seat[v1]]);
    }
    if (v2 == "") {
        for (v1 = 0; v1 < 4; v1++) {
            tscore[seat[v1]] += hscore[seat[v1]];
            if (tscore[seat[v1]] <= -1000) {
                pl[seat[v1]]->add("pig_head", 1);
            }
        }
    } else {
        for (v1 = 0; v1 < 4; v1++) {
            if (seat[v1] != v2) {
                pl[seat[v1]]->add("pig_head", 1);
            }
        }
    }
    for (v1 = 0; v1 < 4; v1++) {
        if (tscore[seat[v1]] <= -1000) {
            message_vision("$N是一头猪！\n", pl[seat[v1]]);
        }
    }
    for (v1 = 0; v1 < 4; v1++) {
        if (tscore[seat[v1]] <= -1000) {
            score_reset();
            break;
        }
    }
    deal_init();
}

int do_play(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v1 = this_player();
