    for (v1 = 0; v1 < 4; v1++) {
        for (v2 = 0; v2 < card_count[seat[v1]]; v2++) {
            if ("/adm/daemons/pigd.lpc"->is_special(cards[seat[v1]][v2])) {
                picks[claimer][pick_count[claimer]++] = cards[seat[v1]][v2];
            }
        }
    }
    after_hand();
}

int do_claim(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!v2->query_temp("pigging_seat")) {
        return notify_fail("你没有在拱猪！\n");
    }
