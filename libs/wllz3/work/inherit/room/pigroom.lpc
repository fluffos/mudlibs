    mixed v2;
    for (v1 = 0; v1 < roundcard_count; v1++) {
        if ("/adm/daemons/pigd.lpc"->is_special(roundcards[v1])) {
            picks[claimer][pick_count[claimer]++] = roundcards[v2];
