int do_post(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!arg) {
        return notify_fail("留言请指定一个标题。\n");
    }
    if (!wizardp(v2) && v2->query_skill("literate", 1) < 10) {
