    v1["author"] = v2->name(2);
    v1["author_id"] = v2->query("id");
    v1["time"] = time();
    if (v2->query("env/sign") && v2->query("env/use_sign")) {
        v1["author_discribe"] = v2->query("env/sign");
    }
    v2->edit((: done_post, v2, v1 :));
