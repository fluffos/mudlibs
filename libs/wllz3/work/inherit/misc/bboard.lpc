    v1--;
    v5->start_more(sprintf("编号：\e[1;33m%d\e[2;37;0m　作者：\e[1;37m%-18s\e[2;37;0m 时间：[%s]\n标题：\e[1;37m%s\e[2;37;0m\n────────────────────────────────────\n", v1 + 1, v2[v1]["author"], ctime(v2[v1]["time"]), v2[v1]["title"][0..65]) + v2[v1]["msg"] + (v2[v1]["author_discribe"] ? "\n\n--------------------------\n" + v2[v1]["author_discribe"] : ""));
