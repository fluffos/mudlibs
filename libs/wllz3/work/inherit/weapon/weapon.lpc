    if (!stringp(v3 = v1->query("levelup_msg"))) {
        switch (arg->query("attributive/att")) {
        case "金":
            v2 = environment(arg);
            v3 = sprintf("\e[1;33m一道耀眼的金光笼罩着%s\e[1;33m的%s，只见$N双手紧握%s\e[1;33m，那道金光，\n正是由%s\e[1;33m放射出来；杀气，霸气，锐气，都在此刻被掩盖。过了一会，金芒渐渐的有所收敛了。\n\e[2;37;0m", v2->short(), v2->query("outdoors") ? "天空" : "屋顶", v1->name(1), v1->name(1));
            break;
        case "水":
            v3 = sprintf("\e[1;36m只见$N手中%s\e[1;36m脱手而出，似惊弓之鸟，又似离弦之箭，绕着$N的四周\n急速飞旋，将$N整个人包围了起来。$N眼明手快，一把抓住%s\e[1;36m的%s柄，\n这才恢复了宁静。\n\e[2;37;0m", v1->name(1), v1->name(1), v1->query("type"));
            break;
        case "土":
            v3 = sprintf("\e[1;32m$N手中%s\e[1;32m突然发出一阵嗡嗡的嘶鸣，霎时间射出一道耀眼的青芒，直冲云霄。\n过来许久，随着嘶鸣渐渐低沉，%s\e[1;32m才恢复了平静。\n\e[2;37;0m", v1->name(1), v1->name(1));
            break;
        case "木":
            v3 = sprintf("\e[1;31m只见$N双手紧握%s柄，一道刺眼的血光慢慢的从%s柄贯穿而至%s梢，$N连忙运劲将它\n垂直插落地面，只听见“啪嗒啪嗒”的声响，地面上顷刻之间犹如龟裂般绽开了数\n道裂缝，尘土飞扬，落叶纷纷。\n\e[2;37;0m", v1->query("type"), v1->query("type"), v1->query("type"), v1->query("name"));
            break;
        case "火":
            v3 = sprintf("\e[1;33m只见$N手中%s\e[1;33m突然燃起一道火焰，犹如火龙一般冲天直上。那火龙来势凶猛，\n似在咆哮，似在怒号；只听$N低声说道：神%s归位。话音刚落，%s\e[1;33m“嗖”的一\n声，落到了$N跟前，一股霸气徐徐而升，让人望而生畏。\n\e[2;37;0m", v1->name(1), v1->query("type"), v1->name(1));
        }
