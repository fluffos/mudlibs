string ask_me() {
    mixed v1;
    v1 = this_player();
    if (!v1->query("pawn")) {
        return "你没有典当东西，哪来的当票啊？";
    }
    if (!present("pawn ticket", v1)) {
        command("nod " + v1->query("id"));
        clone_object("/clone/misc/pawn_ticket")->move(this_player());
        return "当票在这里，你拿去吧。";
    } else {
        command("? " + v1->query("id"));
        return "这位" + "/adm/daemons/rankd"->query_respect(v1) + "，你身上不是有当票了吗？";
    }
}
