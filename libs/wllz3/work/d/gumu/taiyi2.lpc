inherit "/inherit/room/room";
void create();
void init();
int do_climb(mixed);
int do_swim();

void create() {
    set("short", "太乙池");
    set("long", "你身在湖水里，只觉得湖水冰凉透骨。但见四周高峰环列，池面碧波\r\n荡漾，山光水影，风景贻人。这里原来是太乙池的东岸，太累的话，你可\r\n以爬(climb) 上岸。远远望去，西边的山峰之间似乎有一个大洞。想不想\r\n游(swim)过去看？\r\n");
    set("outdoors", "gumu");
    setup();
}

void init() {
    add_action("do_climb", "climb");
    add_action("do_swim", "swim");
}

int do_climb(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "up") {
        write("那个方向没法爬。\n");
        return 1;
    }
    message_vision("$N在太乙池中往岸上爬了上去。\n", v1);
    v1->move("/d/gumu/taiyi1");
    message_vision("$N从太乙池中爬了上去。\n", v1);
    return 1;
}

int do_swim() {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    v1->receive_damage("qi", 10);
    if (v1->can_improve_skill("jinyan-gong") && v1->query_skill("jinyan-gong", 1) < 51) {
        v1->improve_skill("jinyan-gong", v1->query_skill("jinyan-gong", 1));
    }
    message_vision("$N在太乙池中划了划水，用力游了起来。\n", v1);
    if (!v1->is_busy()) {
        v1->start_busy(random(3) + 1);
    }
    return 1;
}
