int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "" || arg != "shi") {
        return 0;
    }
    if (v1->query_skill("dodge", 1) < 50) {
        message_vision("$N往上一跃，企图跳上巨石，可是跳了半天，还是站在原地。\n", v1);
