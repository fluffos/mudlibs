    default:
        say("阿凡提大笑起来，说道：你说什么呀，牛头不对马嘴。\n" + v1->name() + "的脸被臊得通红。\n");
        return 1;
    }
    if (v1->query("level") > 10) {
        say("阿凡提大笑起来，说道：你还来骗经验呀。\n" + v1->name() + "的脸被臊得通红。\n");
        return 1;
    }
    if (v3 == v2) {
