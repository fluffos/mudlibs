    set("long", "这里是一片茂密的树林(wood)。旁边立着一张木牌(pai)。\r\n");
    set("exits", ([ "east" : "/d/baituo/shulin", "southwest" : "/d/baituo/caomeide" ]));
    set("outdoors", "baituo");
    set_temp("times", 5);
