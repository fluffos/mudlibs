void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (arg->query("family/family_name") == "白驼山派") {
        if (arg->query("qi") < 60) {
            message_vision("教练对着$N笑道：练功累吧？没关系，苦尽甘来嘛。\n", arg);
        } else {
            message_vision("教练对着$N夸道：你又来练功，精神可嘉！\n", arg);
        }
    }
}

