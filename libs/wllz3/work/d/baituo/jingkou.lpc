int do_jump(mixed);

void create() {
    set("short", "井口");
    set("long", "这是一口深不见底的深井，你正站在井口的一块石头上，井里一片漆黑\r\n，深不见底，静静的聆听，井底似乎还有一丝流水的声音。井壁上长满了青\r\n苔，有一根拳头粗的树藤垂向井底，你真想跳下去看个究竟。借着井外的光\r\n线，你隐隐约约的看到井壁上似乎刻着一些小字(zi)。\r\n");
    set("item_desc", ([ "zi" : "$HIG$以身淬毒，方能修炼绝世神功\r\n深井沼气，送你一路平步青天$NOR$\r\n" ]));
    setup();
}

void init() {
    add_action("do_jump", "jump");
}

int do_jump(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "up") {
        write("你用尽力气往上跳，只能看到井外，却怎么也跳不出深井。\n");
        if (objectp(v2 = find_object("/d/baituo/sheyuan"))) {
            "/cmds/std/look"->look_room(v1, v2);
            tell_room(v2, "\e[1;33m井里突然露出了半个脑袋，你仔细一看，竟是" + v1->name() + "。\n\e" + "[2;37;0m");
        }
        return 1;
    }
    if (arg == "down") {
        write("你深深的吸了一口气，闭上眼睛往井里跳了下去。\n");
        if (v1->query("family/family_name") != "白驼山派") {
            write("一股嗖嗖的冷风在你耳边呼啸而过，你跌进井底，却犹如跌下万丈深渊一般，身子\n一点都不受控制......\n");
            if (v1->query("max_neili") < 2000) {
                if (objectp(v2 = find_object("/d/baituo/jingdi"))) {
                    tell_room(v2, "一个身影从井口跳了下来，重重的摔在地上，你只听见一阵骨碎的声音。\n");
                }
                v1->move("/d/baituo/jingdi");
                v1->receive_damage("jing", 0);
                v1->receive_damage("qi", 0);
                v1->die();
                return 1;
            }
            if (v1->query_dex() < 60) {
                if (objectp(v2 = find_object("/d/baituo/jingdi"))) {
                    tell_room(v2, "一个身影从井口跳了下来，重重的摔在地上，你听到一阵“哎呀”的惨叫声。\n");
                }
                v1->move("/d/baituo/jingdi");
                v1->receive_damage("jing", 0);
                v1->receive_damage("qi", 0);
                v1->unconcious();
                return 1;
            }
        } else if (v1->query_dex() < 60) {
            write("这口井深不见底，你这么跳下去不是找死吗？\n");
            return 1;
        }
        if (objectp(v2 = find_object("/d/baituo/jingdi"))) {
            tell_room(v2, "一个身影从井口跳了下来，“扑通”一声的落在了深井之中。\n");
        }
        v1->move("/d/baituo/jingdi");
        v1->receive_damage("jing", 200);
        v1->receive_damage("qi", 200);
        write("你落在了一个深井之中，你暗自庆幸：好在这是一口水井，要不可得摔个半死。\n");
        return 1;
    }
