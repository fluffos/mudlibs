// 本文件由编译后的 .b 二进制程序反编译还原，原始源码未随档案发布。
// Decompiled from the compiled .b binary; the original source was not distributed.
inherit "/inherit/room/room";
int do_zui(mixed);
int do_halt(mixed);
void create();
void init();
int do_climb(mixed);
void comp_climb(mixed);
int do_exe(mixed);
void check_status(mixed);

void create() {
    set("short", "井底");
    set("long", "你落在了深井之中，只见那青紫色的井水异常平静，一股绿色的沼气\n徐徐向上升腾。一条绿色的青藤从井口直垂下来，泡在了井水之中。\n");
    setup();
}

void init() {
    add_action("do_exe", "exercise");
    add_action("do_exe", "dazuo");
    add_action("do_climb", "climb");
    remove_call_out("check_status");
    call_out("check_status", 10);
}

int do_climb(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (v1->is_busy()) {
        return 0;
    }
    if (arg == "teng" || arg == "藤") {
        if (v1->query("brawn") < 10) {
            write("你现在体力太弱，恐怕爬不上井口了。\n");
            return 1;
        }
        message_vision("$N双手紧抓青藤，脚步踏上井壁，慢慢的向上爬去。\n", v1);
        call_out("comp_climb", 10, v1);
        v1->start_busy(10);
        return 1;
    }
}

void comp_climb(mixed arg) {
    if (!arg || environment(arg) != this_object()) {
        return;
    }
    write("也不知道爬了多久，你费了九牛二虎之力，终于从井底爬了上来。\n");
    arg->move("/d/baituo/sheyuan");
    tell_room(environment(arg), "一个浑身青绿的家伙从井底爬了出来。\n", ({ arg }));
    return;
}

int do_exe(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->is_fighting()) {
        write("战斗中不能练内功，会走火入魔。\n");
        return 1;
    }
    if (v1->is_busy()) {
        write("你正忙着呢！\n");
        return 1;
    }
    if (!stringp(v1->query_skill_mapped("force"))) {
        write("你必须先用 enable 选择你要用的内功心法。\n");
        return 1;
    }
    if (v1->query_temp("weapon")) {
        write("你必须先放下兵器，才可以修炼内功心法。\n");
        return 1;
    }
    if (!arg) {
        v2 = 200;
    } else if (!sscanf(arg, "%d", v2)) {
        v2 = 200;
    }
    if (v2 < 200) {
        write("你最少要花 200 点「气」才能练功。\n");
        return 1;
    }
    if (v1->query("qi") < v2) {
        write("你现在的气太少了，无法产生内息运行全身经脉。\n");
        return 1;
    }
    if (v1->query("jing") * 100 / v1->query("max_jing") < 70) {
        write("你现在精神状况太差了，无法凝神专一！\n");
        return 1;
    }
    v1->set_short_desc("将身子浸泡在碧绿的井水之中，慢慢的运功打坐。");
    write("\e[1;32m你盘膝坐下，将身子浸泡在青沼之中，一股沼气钻进了你的鼻孔。\n\e[2;37;0m");
    v1->start_busy((: do_zui :), (: do_halt :));
    v1->set_temp("do_zui", 1);
    return 1;
}

int do_zui(mixed arg) {
    if (arg->query("jing") < 100) {
        arg->set_short_desc(0);
        write("你突感精力不足，连忙收功吸气，站了起来。\n");
        return 0;
    }
    if (arg->query("qi") < 100) {
        arg->set_short_desc(0);
        write("你突感气息不调，连忙回了一口气，站了起来。\n");
        return 0;
    }
    if (arg->query("neili") < 100) {
        arg->set_short_desc(0);
        write("你只觉内息已不足以抵挡深井的沼气，连忙收回内息站了起来。\n");
        return 0;
    }
    if (arg->query_skill_mapped("force") != "hamagong") {
        arg->set_shot_desc(0);
        write("一股浓烈的沼气熏得你差点晕了过去，你见不妙，连忙收功站了起来。\n");
        return 0;
    }
    write(random(6) == 5 ? "\e[1;32m一股悠悠的气息在你体内流动，贯穿你的四经八脉，你仔细一看，身上渐渐的变成绿色。\n\e[2;37;0m" : random(6) == 4 ? "\e[1;31m你只觉得一股燥热的气息在你身体的周围流动，身上的每一寸肌肤渐渐变成了红色。\n\e[2;37;0m" : random(6) == 3 ? "\e[1;35m一股冰寒的气息钻入你的脚底，迅速的流进你的中庭，你的腿部渐渐形成了紫色。\n\e[2;37;0m" : "\e[1;36m一股沼气在你身体的周边流动，从井底徐徐往上冒腾。\n\e[2;37;0m");
    if (random(2000) > arg->query_skill("force")) {
        arg->add("combat/in_poison", 1);
    }
    arg->receive_damage("jing", 100);
    arg->receive_damage("qi", 100);
    if (arg->add("neili", -10) < 0) {
        arg->set("neili", 0);
    }
    return 1;
}

int do_halt(mixed arg) {
    arg->set_short_desc(0);
    write("你深深了吸了一口气，从深井中站了起来。\n");
    arg->delete_temp("do_zui");
    return 1;
}

void check_status(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = all_inventory();
    v2 = sizeof(v1);
    if (v1) {
        for (v3 = 0; v3 < v2; v3++) {
            if (!v1[v3]->is_character() || v1[v3]->is_corpse()) {
                continue;
            }
            if (v1[v3]->query_temp("do_zui")) {
                continue;
            }
            if (environment(v1[v3]) != this_object()) {
                continue;
            }
            tell_object(v1[v3], "\e[1;32m你觉得头昏脑涨，想必是受了深井的沼气所影响，体力渐渐不支了！\n\e[2;37;0m");
            v1[v3]->receive_damage("jing", 50);
            v1[v3]->receive_damage("qi", 50);
            v1[v3]->add("brawn", -10);
            v1[v3]->delete_temp("last_damage_from");
            v1[v3]->set_temp("die_for", "身中毒沼之气而死。");
        }
        remove_call_out("check_status");
        call_out("check_status", 10);
    }
}
