    set("long", "这里是白驼山庄的蛇园。白驼山以毒名扬天下，最重要的毒质就来自\n毒蛇。这里遍地是蛇，墙上也巴着蛇，屋檐上也向下垂着蛇，树枝上也盘\n绕着蛇，不由你不心惊。园子的角落里有一口井，上面盖着一块大石(shi)\n，大石上面的盖着一层厚厚的尘土。\n");
    set("exits", ([ "south" : "/d/baituo/zhulin/exit" ]));
    set("outdoors", "baituo");
    set("objects", ([ "/d/shenlong/npc/jinshe" : random(5) + 1, "/d/shenlong/npc/dushe" : random(5) + 1, "/d/shenlong/npc/fushe" : random(5) + 1, "/d/shenlong/npc/qingshe" : random(5) + 1, "/d/fuzhou/npc/wubushe" : random(5) + 1 ]));
    set("item_desc", ([ "shi" : "石头上有一层厚厚的尘土，你仔细一看，中间有一个巴掌大的手印，这石\n头似乎人挪(nuo)开过。\n" ]));
    setup();
}

void init() {
    add_action("do_nuo", "nuo");
}

int do_nuo(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg != "石" && arg != "shi") {
        write("你要挪开什么？\n");
        return 1;
    }
    if (query_temp("opened")) {
        write("石头已经被移开了。\n");
        return 1;
    }
    if (v1->query("neili") < 3000) {
        message("vision", v1->name() + "使出吃奶的力气，双手紧紧的抱住盖在紧张的那块大石，\n可任凭" + v1->name() + "怎么弄，那石头还是动也不动的。\n", environment(v1), ({ v1 }));
        write("你使出吃奶的力气，想要搬动那石头，可急了半天那石头还是纹丝不动。\n");
        return 1;
    }
    if (v1->query("str") < 50) {
        message("vision", v1->name() + "使出浑身的力气，双手推住大石的边缘，企图将那石头推开一边，\n可不管怎么弄，那石头还是动也不动的。\n", environment(v1), ({ v1 }));
        write("你使出浑身解数，企图搬开那石头，可那石头象长了根似的，一动也不动的。\n");
        return 1;
    }
    write("你暗暗的调整内息，将内力运于双掌之中，用力的往那石头的两边轻轻一推。\n只听见轰隆隆的声响，那石头终于路开了一条缝。\n");
    message("vision", "只见" + v1->name() + "闭气凝神，将内劲运于双掌之中，突然向前一推，那石头\n随即发出轰隆隆的声响，露出了一条缝隙。\n", environment(v1), ({ v1 }));
    set("exits/down", "/d/baituo/jingkou");
    set_temp("opened", 1);
    call_out("auto_close", 4);
    return 1;
}

void auto_close() {
    tell_room(this_object(), "\e[37m一阵轻风吹过，那石头又发出轰隆隆的声响，把井口盖住了。\n\e[2;37;0m");
    delete("exits/down");
    delete_temp("opened");
    return;
}
