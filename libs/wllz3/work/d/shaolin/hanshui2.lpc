inherit "/inherit/room/room";
void create();
void init();
int do_yell(mixed);
int du_jiang();

void create() {
    set("short", "汉水北岸");
    set("long", "汉水北岸也是相当热闹，自北岸渡口往北，一条笔直的官道直通南阳\r\n。此地民风淳朴，路旁夹柳成阴，酒厮林立，且都有一面大大的「酒」旗\r\n迎风飘扬，蔚为壮观。也有不少小贩沿路叫买，语多难辨，却也令人盛情\r\n难却。\r\n");
    set("resource/water", 1);
    set("exits", ([ "north" : "/d/shaolin/nanyang", "east" : "/d/shaolin/matou2" ]));
    set("item_desc", ([ "river" : "近岸处有一叶小舟，也许喊(yell)一声船家就能听见。\n" ]));
    set("outdoors", "shaolin");
    setup();
}

void init() {
    add_action("do_yell", "yell");
    add_action("du_jiang", "dujiang");
}

int do_yell(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "boat") {
        arg = "船家";
    }
    if (v1->query("age") < 16) {
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n", v1);
    } else if (v1->query("neili") > 600) {
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传了出去。\n", v1);
    } else {
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n", v1);
    }
    if (arg == "船家") {
        "/adm/daemons/transd"->check_boat(base_name(this_object()));
        return 1;
    } else {
        message_vision("江面上远远传来一阵回声：“" + arg + "～～～”\n", v1);
    }
    return 1;
}

int du_jiang() {
    mixed v1;
    v1 = this_player();
    if (!living(v1)) {
        return 0;
    }
    if (v1->query_skill("dodge", 1) < 150) {
        return notify_fail("你的修为不够！\n");
    }
    tell_room(environment(v1), "\e[1;32m" + v1->name() + "捡起一段芦苇抛入水中，紧跟着飞身跃上芦苇，长袖飘飘，渡过了汉水。\n\e" + "[2;37;0m", ({ v1 }));
    write("你使出「一苇渡江」渡过了汉水。\n");
    v1->move("/d/shaolin/hanshui1");
    tell_room(environment(v1), "\e[1;32m只见" + v1->name() + "踩着一段芦苇从对岸过来，姿态潇洒地落在岸边。\n\e" + "[2;37;0m", ({ v1 }));
    return 1;
}
