inherit "/inherit/room/room";
void create();
void init();
int do_yell(mixed);
int du_jiang();

void create() {
    set("short", "汉水南岸");
    set("long", "面前是一条波涛翻滚的大江(river)。 浊流滚滚，万舟竞发。两岸渡\r\n船来来往往，江边一长溜摆满了鱼摊，渔家就将船泊在岸边，几个破萝支\r\n一块木板，板上摆满了活蹦乱跳的汉江鲤鱼。过去不远，是有名的老河口\r\n，不少过江客都在这里等待渡船摆渡。岸边竖立着一块牌子(sign)。\r\n");
    set("resource/water", 1);
    set("exits", ([ "south" : "/d/shaolin/yidao2", "east" : "/d/shaolin/matou1", "west" : "/d/shaolin/roadw4" ]));
    set("item_desc", ([ "river" : "江面上浊流滚滚，想(dujiang)渡江似乎并不是件易事呀！\r\n", "sign" : "$YEL$\r\n\t\t【汉水南岸】\r\n\t\t     |\r\n\t\t     |\r\n\t\t     |\r\n    【桃源之城】——————— 【钓鱼台】\r\n\r\n\r\n$NOR$\r\n" ]));
    set("outdoors", "shaolin");
    setup();
}

void init() {
    add_action("do_yell", "yell");
    add_action("du_jiang", "dujiang");
}

int do_yell(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "boat") {
        arg = "船家";
    }
    if (v1->query("age") < 16) {
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n", v1);
    } else if (v1->query("neili") > 500) {
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传了出去。\n", v1);
    } else {
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n", v1);
    }
    if (arg == "船家") {
        "/adm/daemons/transd"->check_boat(base_name(this_object()));
        return 1;
    } else {
        message_vision("江面上远远传来一阵回声：“" + arg + "～～～”\n", v1);
    }
    return 1;
}

int du_jiang() {
    mixed v1;
    v1 = this_player();
    if (!living(v1)) {
        return 0;
    }
    if (v1->query_skill("dodge", 1) < 150) {
        return notify_fail("你的轻功修为还不足，想跳江找死啊？\n");
    }
    tell_room(environment(v1), "\e[1;32m" + v1->name() + "捡起一段芦苇抛入水中，紧跟着飞身跃上芦苇，长袖飘飘，渡过了汉水。\n\e" + "[2;37;0m", ({ v1 }));
    write("你使出「一苇渡江」渡过了汉水。\n");
    v1->move("/d/shaolin/hanshui2");
    tell_room(environment(v1), "\e[1;32m只见" + v1->name() + "踩着一段芦苇从对岸过来，姿态潇洒地落在岸边。\n\e" + "[2;37;0m", ({ v1 }));
    return 1;
}
