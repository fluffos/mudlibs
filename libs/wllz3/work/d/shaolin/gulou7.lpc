inherit "/inherit/room/room";
string look_drum();
string look_out();
void create();
void init();
int do_hit(mixed);
int do_out(mixed);

void create() {
    set("short", "鼓楼七层");
    set("long", "这里就是鼓楼之顶。直入眼帘的便是一只大鼓。大鼓鼓身通红，似由\n白杨木箍成。两头包以水牛皮，用一匝大铜钉钉在鼓身边缘。鼓心有一圈\n白渍，看来是因为多次击打形成的。整个大鼓放在一个一人高的架子上，\n架子底层搁着两根大鼓槌。尽管山风吹人欲倒，谁都禁不住想要击一下鼓\n(drum)试试。往外看，有个很大的汉白玉窗台(out)，上面足可站一个人。\n旁边有张纸(paper)，好象写着些什么。\n");
    set("exits", ([ "down" : "/d/shaolin/gulou6" ]));
    set("item_desc", ([ "drum" : (: look_drum :), "out" : (: look_out :), "paper" : "经验不足者切勿跳楼，否则后果自负！\n" ]));
    set("objects", ([ "/kungfu/class/shaolin/qing-wen" : 1 ]));
    setup();
}

void init() {
    add_action("do_hit", "hit");
    add_action("do_out", "out");
}

int do_hit(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg != "drum") {
        return notify_fail("你要敲什麽？\n");
    }
    if (random(v1->query("kar")) < 5) {
        message_vision("$N一不小心敲到自己头上了。\n", v1);
        v1->add("qi", -10);
        v1->unconcious();
    } else {
        v2 = v1->query_entire_dbase();
        message_vision("$N敲了一下大鼓，『咚……』声音传遍整个寺庙。\n", v1);
        write("鼓声如迅雷般在你耳边炸响，你头脑中一片糊涂，全身摇摇欲坠，勉\n\n                      力支撑着不倒在地上。心中一个声音告诉你，得赶快离开这里，不然就没命了。\n");
        if (!random(2)) {
            if (v2["potential"] < 100) {
                v2["potential"] += 1;
            }
        } else if (v2["potential"] > 0) {
            v2["potential"] -= 1;
        }
    }
    return 1;
}

int do_out(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    v1->start_busy(5);
    v2 = v1->query_skill("dodge", 0) + random(5);
    v3 = 600 / v1->query("int");
    v4 = 500 / v1->query("int");
    if (v1->query("jing") < v3 || v1->query("qi") < v4) {
        v2 = 0;
    }
    message_vision("$N爬上窗台，一个纵身，跳了下去。\n", v1);
    v1->move("/d/shaolin/gulou");
    message_vision("只听『砰』地一声，$N从塔顶跳了下来。\n", v1);
    if (v2 < 50) {
        v1->die();
    } else if (v2 < 125) {
        v1->unconcious();
    } else {
        message_vision("$N已稳稳地站在地上。\n", v1);
        if (v2 > 175 && v1->query_skill("dodge", 1) < 200) {
            v1->improve_skill("dodge", v1->query_skill("dodge", 1) * 2);
        }
        v1->receive_damage("jing", v3);
        v1->receive_damage("qi", v4);
    }
    return 1;
}

string look_drum() {
    return "※※※※※※※※※※※※※※※※※※※※※※\n※※※※　　　　　　　　　　　　　　※※※※\n※※※※　　　　　佛语有曰：　　　　※※※※\n※※※※　　　　　　　　　　　　　　※※※※\n※※※※　『求一次菩萨，击一次鼓』　※※※※\n※※※※　　　　　　　　　　　　　　※※※※\n※※※※　　（ｈｉｔ　ｄｒｕｍ）　　※※※※\n※※※※　　　　　　　　　　　　　　※※※※\n※※※※※※※※※※※※※※※※※※※※※※\n";
}

string look_out() {
    return "这里是鼓楼顶层的窗台，从这里可以遥望整个少室山脉，\n以及高耸入云的嵩山。浮世烟尘，尽在眼底。据说在此地\n可以与天界诸佛直接交流，对禅修大有益处。\n";
}
