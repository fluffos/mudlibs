void create() {
    set("short", "八卦阵阵心");
    set("long", "这里就是洪荒古阵的中心。站在这里，才能看清楚四周的情形，只见\r\n周围暮蔼沉沉，云气弥漫，不见边际。一道道闪电如奔蛇般穿梭其间，发\r\n出阵阵闷雷。间夹着几声惨厉的哭叫声，与雷电着地的劈裂声混合在一起\r\n，整个场面说不出的诡异可惧。阵心正中处有一口深潭 (tan)，望之深不\r\n见底。\r\n");
    set("item_desc", ([ "tan" : "$CYN$\r\n深潭边的岩石上刻着四个巨大的古篆：“万古寒潭”，再有五个小字：“\r\n苍松子谨书”。潭边都是极硬的玄武岩，潭水澄碧透明，鱼虾不生。水面\r\n隐隐泛着一股幽幽的深绿色，走近便觉一股彻骨寒气扑面而来。粗看似乎\r\n只有几十丈深，仔细望下去却是越看越深，直如无底深渊一般！\r\n$NOR$\r\n" ]));
    set("exits", ([ "up" : "/d/shaolin/andao3" ]));
    setup();
}

void init() {
    add_action("do_enter", "enter");
}

int do_enter(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "tan") {
        if (present("pishui zhu", v1)) {
            message_vision("$N取出辟水灵珠，含在嘴里，轻轻一纵，跃入寒潭之中。\n", v1);
            v1->move("/d/shaolin/hantan1");
            message_vision("channel:rumor", "【武林传奇】某人：" + v1->name() + "口寒辟水灵珠，跃入寒谭之中了。\n\e" + "[2;37;0m", users());
            message("vision", "只听水面哗啦一声响，似乎有人也潜下水来。\n", environment(v1), ({ v1 }));
        } else {
            tell_object(v1, "你一跳入水中，只觉蚀骨寒气从全身无数个毛孔侵入，四肢几乎完全麻木，\n你拚着丹田中残余的一股内力，攀住潭边的岩石，急急忙忙地爬了出来！\n");
            message("vision", v1->name() + "下半身一浸入水中，立刻大叫一声，落汤鸡似地跳了出来！，\n", environment(v1), ({ v1 }));
        }
        return 1;
    }
}
