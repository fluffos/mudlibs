// 本文件由编译后的 .b 二进制程序反编译还原，原始源码未随档案发布。
// Decompiled from the compiled .b binary; the original source was not distributed.
inherit "/inherit/room/room";
string look_bell();
string look_out();
void create();
void init();
int do_knock(mixed);
int do_out(mixed);

void create() {
    set("short", "钟楼七层");
    set("long", "这里就是钟楼之顶。直入眼帘的便是那口大钟和一根悬挂空中的巨杵\n。细看大钟，整整有两丈来高，直径也有丈许。钟身似由青铜浇铸，上面\n满是密密麻麻的印文古篆，估计重逾数千斤。巨杵粗可合抱，丈把来长，\n一头裹以厚皮，正对着钟腰。尽管山风吹人欲倒，谁都禁不住想撞一下钟\n(bell)试试。往外看，有个很大的汉白玉窗台(out)，上面足可站一个人。\n旁边有张纸(paper)，好象写着些什么。\n");
    set("exits", ([ "down" : "/d/shaolin/zhonglou6" ]));
    set("item_desc", ([ "bell" : (: look_bell :), "out" : (: look_out :), "paper" : "经验不足者切勿跳楼，否则后果自负。\n" ]));
    set("objects", ([ "/kungfu/class/shaolin/qing-xiao" : 1 ]));
    setup();
}

void init() {
    add_action("do_knock", "knock");
    add_action("do_out", "out");
}

int do_knock(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "bell") {
        return notify_fail("你要敲什麽？\n");
    }
    v1->add("qi", -20);
    if (random(v1->query("kar")) < 25) {
        message_vision("$N一不小心敲到自己头上了。\n", v1);
        v1->unconcious();
    } else {
        message_vision("$N敲了一下大钟，『咣……』声音传遍整个寺庙。\n", v1);
        write("钟声如迅雷般在你耳边炸响，你头脑中一片糊涂，全身摇摇欲坠，勉力支\n撑着不倒在地上。心中一个声音告诉你，得赶快离开这里，不然就没命了。\n");
        if (!random(2)) {
            v1->add_exp(v1, 1);
        } else {
            v1->add_exp(v1, -1);
        }
    }
    return 1;
}

int do_out(mixed arg) {
    mixed v1;
    v1 = this_player();
    message_vision("$N爬上窗台，一个纵身，跳了下去。\n", v1);
    v1->move("/d/shaolin/zhonglou");
    if (!v1->is_busy()) {
        v1->start_busy(5);
    }
    message_vision("只听『砰』地一声$N从塔顶跳了下来。\n", v1);
    if (random(v1->query_kar()) < 30) {
        "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", "一个黑影从钟楼七层飞跃直下 ....");
        v1->unconcious();
    } else {
        message_vision("$N已稳稳地站在地上。\n", v1);
        if (v1->can_improve_skill("dodge") && v1->query_skill("dodge", 1) < 151) {
            v1->improve_skill("dodge", v1->query_int() + v1->query_kar());
        }
        v1->receive_damage("jing", 100);
        v1->receive_damage("qi", 100);
    }
    return 1;
}

