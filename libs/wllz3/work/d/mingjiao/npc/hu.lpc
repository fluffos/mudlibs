    set_name("胡青牛", ({ "hu qingniu", "hu" }));
    set("long", "他就是明教号称见死不救的胡青牛，据说他精通医理，可以起死回生。但\n他从不医教外人士。\n");
    set("gender", "男性");
    set("title", "\e[1;32m明教\e[2;37;0m教众");
    set("nickname", "蝶谷医仙");
    set("age", 50);
    set("class", "shaman");
    set("attitude", "peaceful");
