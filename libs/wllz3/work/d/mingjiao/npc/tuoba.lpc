    if (arg1->query("qi") * 100 / v2 <= 50) {
        command("say 青出於蓝胜於蓝，不愧是我明教的弟子！恭喜你了！");
        message_vision("$N交给$n一封推荐信。\n", arg1, arg2);
        arg2->set_temp("have_letter", 1);
