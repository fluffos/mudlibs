int do_mianbi(mixed);

void create() {
    set("short", "石柱");
    set("long", "这是南岩宫前的一根石柱，雕成龙形，自峭壁上横出，犹如飞龙在天\n。龙首刻一香炉，在此上香称为“上龙头香”，是香客的最大心愿。石柱\n仅粗如屋梁，旁无扶栏，前有白云缭绕，下有万丈深渊，稍一失足，即尸\n骨无存。\n");
    set("exits", ([ "northup" : "/d/wudang/nanyanfeng", "enter" : "/d/wudang/nanyangong" ]));
    set("outdoors", "wudang");
    setup();
}

void init() {
    add_action("do_mianbi", "face");
}

int do_mianbi(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg) {
        write("你面对着石柱趺坐静思良久，白忙一场，一无所获。\n");
        return 1;
    }
    if (v1->is_busy()) {
        write("你正忙着呢。\n");
        return 1;
    }
    if (v1->query_skill("taoism", 1) < 100) {
        write("你面对着石柱上满面蝌蚪文，没一个字认识。\n");
        return 1;
    }
    if (v1->query_skill("literate", 1) < 100) {
        write("你对石柱上每一个字都认识，就是不知道说的是什么。\n");
        return 1;
    }
    if (v1->query_skill("huagong-dafa", 1) || v1->query_skill("huntian-qigong", 1) || v1->query_skill("hunyuan-yiqi", 1) || v1->query_skill("linji-zhuang", 1) || v1->query_skill("xuantian-force", 1) || v1->query_skill("zixia-shengong", 1)) {
        write("你旁门杂学太多了，实在静不下心来面壁。\n");
        return 1;
    }
    if (arg == "liangyi-jian" || arg == "tiyunzong") {
        if (v1->query_skill(arg, 1) < 100) {
            write("你的" + to_chinese(arg) + "显然太低，无法领悟石柱内容。\n");
            return 1;
        }
        if (v1->query_skill(arg, 1) > 180) {
            write("你的" + to_chinese(arg) + "已经没必要读石柱内容了。\n");
            return 1;
        }
        if (!v1->can_improve_skill(arg) && arg != "literate") {
            write("你的实战经验不足，无法领悟石柱内容。\n");
            return 1;
        }
        if (v1->query("jing") < 20) {
            write("你太累了，现在无法领悟石柱内容。\n");
            return 1;
        }
        message_vision("$N面对着石柱趺坐静思，良久，对" + to_chinese(arg) + "似有所悟。\n", v1);
        v1->improve_skill(arg, random(v1->query("int") * 10));
        v1->add("jing", -5);
        if (!v1->is_busy()) {
            v1->start_busy(random(3) + 1);
        }
        return 1;
    }
}
