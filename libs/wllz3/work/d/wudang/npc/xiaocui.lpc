void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    say("小翠笑吟吟地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "请先入座，我这就给您上茶。\n");
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    if (query("tea_count") < 1) {
        return notify_fail("现在只剩大碗茶了。");
    }
    if (arg2->query("name") == "茶叶" || arg2->query("name") == "金项链") {
        if (arg2->query("name") == "金项链") {
            command("kiss " + arg1->query("id"));
            command("wear all");
        }
        if (arg1->query_temp("marks/sit")) {
            if (arg1->query_temp("tea_cup") > 0) {
                command("smile " + arg1->query("id"));
            } else {
                say("小翠作了个揖道：" + "/adm/daemons/rankd"->query_respect(arg1) + "请稍候，小女子这就给您换香茶。\n");
            }
            arg1->set_temp("tea_cup", 5);
            remove_call_out("serve_tea");
            call_out("serve_tea", 1, arg1);
        } else {
            arg1->set_temp("tea_cup", 5);
            say("小翠道了个万福：" + "/adm/daemons/rankd"->query_respect(arg1) + "请先入上座，小女子这就给您去泡香茶。\n");
        }
        return 1;
    }
    if (arg2->query("name") == "「女儿香」茶叶") {
        if (arg1->query_temp("marks/sit")) {
            command("dance " + arg1->query("id"));
        } else {
            message_vision("小翠引$N到窗边风景最好的桌边坐下．\n", arg1);
        }
        arg1->set_temp("tea_cup", 10);
        arg1->set_temp("marks/sit", 1);
        v1 = clone_object("/d/wudang/obj/nuerxiang");
        v1->move(arg1);
        add("tea_count", -1);
        return 1;
    }
    command("? " + arg1->query("id"));
    return 1;
}

void serve_tea(mixed arg) {
    mixed v1;
    mixed v2;
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (!arg->query_temp("marks/sit")) {
        return;
    }
    if (!objectp(v2 = environment())) {
        return;
    }
    if (arg->query_temp("tea_cup") <= 0 || query("tea-count") < 1) {
        v1 = clone_object("d/wudang/obj/dawancha");
        v1->move(v2);
        message_vision("小翠搬出个大茶壶来，将桌上的大碗茶倒满．\n", arg);
    } else {
        arg->add_temp("tea_cup", -1);
        v1 = clone_object("d/wudang/obj/xiangcha");
        add("tea_count", -1);
        v1->move(v2);
        message_vision("小翠拿出个绍兴小茶壶，沏了杯香茶，放在桌上．\n", arg);
    }
    v1 = clone_object("d/wudang/obj/mitao");
    v1->move(v2);
    message_vision("小翠拿出一碟新鲜的水蜜桃，放在桌上．\n", arg);
    return;
}
