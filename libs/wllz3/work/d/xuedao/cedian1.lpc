int do_watch() {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy()) {
        write("你正忙着呢。\n");
        return 1;
    }
    if (v1->query_skill("xuehai-mogong", 1) < 10) {
        write("你的血海魔功不够，看不懂上面刻的是什么。\n");
        return 1;
    }
    if (v1->query_skill("miexian-zhang", 1) > 40) {
        write("你的灭仙掌早就超越壁上所刻了。\n");
        return 1;
    }
    if (!v1->can_improve_skill("miexian-zhang")) {
        write("你的等级不足，无法领悟壁上的内容。\n");
        return 1;
    }
    if (v1->query("jing") < 20) {
        write("你太累了，现在无法领悟壁上的内容。\n");
        return 1;
    }
    message_vision("$N面对着壁上图案揣摩良久，有点感觉。\n", v1);
    v1->improve_skill("miexian-zhang", random(v1->query("int")));
    v1->receive_damage("jing", 15);
    if (!v1->is_busy()) {
        v1->start_busy(random(3) + 1);
    }
    return 1;
}

int valid_leave(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg1->query("family");
    if ((!v1 || v1["family_name"] != "血刀门") && arg2 == "up" && objectp(present("jiamu huofo", environment(arg1)))) {
        return notify_fail("宝象说道：你非血刀门弟子，不能入内。\n");
    }
    return ::valid_leave(arg1, arg2);
}
