inherit "/inherit/char/npc";
int accept_object(mixed, mixed);
int do_zhu(mixed);

void create() {
    set_name("侍鞭", ({ "shibian" }));
    set("long", "她头上包着天青色纱巾，一领天青色布袍，没有一丝褶皱。\n");
    set("nickname", "\e[1;35m鞭\e[2;37;0m");
    set("gender", "女性");
    set("age", 20);
    set("shen_type", 0);
    set("max_neli", 500);
    set("jiali", 50);
    set_skill("unarmed", 100);
    set_skill("dodge", 100);
    set_skill("force", 150);
    set_skill("sword", 150);
    set_skill("parry", 90);
    set_temp("apply/attack", 50);
    set_temp("apply/defense", 50);
    set_temp("apply/damage", 50);
    set("level", 40);
    set("score", 0);
    set("attitude", "peaceful");
    set("inquiry", ([ "造鞭" : "师傅命我帮助别人造鞭，但到现在也不见一个人影。谁要造鞭呢？\n", "原料" : "造鞭只能用寒丝羽竹。\n" ]));
    setup();
    carry_object("/clone/cloth/cloth")->wear();
}

void init() {
    add_action("do_zhu", "zhu");
}

int accept_object(mixed arg1, mixed arg2) {
    if (!arg1->query_temp("whip")) {
        command("say 师傅没有同意为你造鞭，您请回吧！");
        return 0;
    }
    arg1->delete_temp("whip");
    arg1->set_temp("m_whip", 1);
    switch (arg2->query("id")) {
    case "寒丝羽竹":
    case "han zhu":
        break;
    default:
        message("vision", "侍鞭疑道：这是什么！师傅说这不能用来打造长鞭！\n", arg1);
        return 0;
    }
    message("vision", "侍鞭低头检视了一下手中的" + arg2->query("name") + "点了点头说：那好！我们现在就开始铸鞭。\n", arg1);
    write("请这位" + "/adm/daemons/rankd"->query_respect(arg1) + "给鞭起名字吧！(zhu 鞭的名字)\n");
    return 1;
}

int do_zhu(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v3 = this_player();
    if (!v3->query_temp("m_whip")) {
        return 0;
    }
    if (v3->query("item/weapon")) {
        say("侍鞭一脸茫然：您已经有一把自造的武器了，还来干什么？难到不可手么？\n");
        return 1;
    }
    if (!arg || arg == "") {
        return notify_fail("侍鞭认真的说：想好鞭的名称及代号后在对我说。\n");
    }
    if (sizeof(arg) > 4 || sizeof(arg) < 1) {
        return notify_fail("侍鞭说道：兵器的名字必须为 1 到 4 个字。\n");
    }
    v4 = sizeof(arg);
    while (v4--) {
        if (arg[v4] <= 32) {
            return notify_fail("侍鞭说道：对不起，你的中文名字不能用控制字元。\n");
        }
        if (!is_chinese(arg[v4..v4])) {
            return notify_fail("侍鞭说道：对不起，请您用「中文」取名字。\n");
        }
    }
    v3->delete_temp("m_whip");
    v3->delete_temp("get_orc");
    v3->delete_temp("or");
    v1 = "寒丝羽竹";
    message_vision("$N沉吟了一会，对侍鞭悄声说了几句话。侍鞭点了点头。说：好吧！\n侍鞭回过身，转向身后的一个巨大的火炉，鼓动真气燃起了熊熊的大火。说：开始！\n$N双手握住一个巨大的铁锤，猛的向炉中渐渐红热起来的" + v1 + "挥去！\n只听得棚的一声巨响，锤头和" + v1 + "粘在了一起。\n$N只觉得掌心一热，浑身的血液似乎都沸腾了起来！\n一身精血胶合着汩汩的内气，源源不断的向炉中的" + v1 + "涌去！\n", v3);
    if (v3->query("qi") < v3->query("max_qi") || v3->query("jing") < v3->query("max_jing") || v3->query("neili") < v3->query("max_neili")) {
        message_vision("\e[1;31m\n\n突然$N觉得气血一阵翻涌，一口真气接不上来......\n\e[2;37;0m", v3);
        v3->set("neili", 0);
        v3->unconcious();
        return 1;
    }
    message_vision("\n只听咯的一声轻响，一柄巨鞭从炉中倏然跃起。化作一道青电猛的向$N的前胸刺来！！\n\e[2;37;0m", v3);
    say("\e[1;37m\n侍鞭见状大叫：神鞭初成，人血以祭！！闪开！\n\e[2;37;0m");
    message_vision("\e[1;37m$N只觉得眼前一花，一条白影迅捷无比的挡在了$N的身前。\n\n\e[1;31m巨鞭透胸穿出，侍鞭惨号一声，鲜血溅得你满脸都是！\n\e[1;31m侍鞭往后退开了几步，手捂着伤口，看起来侍鞭已经气息粗重了。\n\n\e[1;36m巨鞭又飞了起来，飞到半空，当的一声落回到地上。\n\n\e[2;37;0m\e[33m炉中的火灭了。一室的劲气化于无形，一切又归于沉寂......\n\n\e[2;37;0m", v3);
    v3->set("qi", 10);
    v3->set("jing", 10);
    v3->set("neili", 0);
    v3->set("item/weapon", 1);
    v2 = clone_object("/clone/item/weapon");
    v2->set_name(convert_color(arg) + "\e" + "[2;37;0m", ({ "my whip", "whip" }));
    v2->set("level", 1);
    v2->set("or", v1);
    v2->set("owner_id", geteuid(v3));
    v2->set("owner_name", v3->name(1));
    v2->set("type", "鞭");
    v2->set("time", "/adm/daemons/natured"->game_time());
    v2->save();
    v2->set_owner(v3->name(1), geteuid(v3));
    v2->set_up();
    v2->move(v3, 1);
    message_vision("\e[36m侍鞭摸起地上，带着斑斑血迹还有些烫手的巨鞭，说：鞭..已..成...，侍鞭的任务....也就完成了....\n侍鞭艰难的说：鞭....您...收好，我该走了....\n侍鞭刚说完，眉头一皱......\n\e[2;37;0m", v3);
    die();
    return 1;
}
