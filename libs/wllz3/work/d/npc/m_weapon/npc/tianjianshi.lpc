        break;
    case "blade":
    case "刀":
        v1->add_temp("blade", 1);
        write("欧冶子说道：你带着原料去找侍刀吧！\n");
        break;
    case "stick":
    case "棍":
        v1->add_temp("club", 1);
        write("欧冶子说道：你带着原料去找侍棍吧！\n");
        break;
    case "staff":
    case "杖":
        v1->add_temp("staff", 1);
        write("欧冶子说道：你带着原料去找侍杖吧！\n");
        break;
    case "hammer":
    case "锤":
        v1->add_temp("hammer", 1);
        write("欧冶子说道：你带着原料去找侍锤吧！\n");
        break;
    case "whip":
    case "鞭":
        v1->add_temp("whip", 1);
        write("欧冶子说道：你带着原料去找侍鞭吧！\n");
        break;
    case "axe":
    case "斧":
        v1->add_temp("axe", 1);
        write("欧冶子说道：你带着原料去找侍斧吧！\n");
        break;
    case "spear":
    case "枪":
        v1->add_temp("spear", 1);
        write("欧冶子说道：你带着原料去找侍枪吧！\n");
        break;
    default:
        message_vision("欧冶子一脸狐疑：什么兵器？\n", v1);
        return notify_fail("欧冶子仔细的说：此事不可儿戏，请慎重！！\n");
    }
    switch (v1->query_temp("or")) {
    case 1:
        v2 = clone_object("/d/npc/m_weapon/tan/item/shenmu", 1);
        v2->move(v1);
        message_vision("欧冶子给了$N一块千年神木。\n", v1);
        v1->delete_temp("get_orc");
        v1->delete_temp("or");
        v1->set_temp("have_orc", 1);
        break;
    case 2:
        v2 = clone_object("/d/npc/m_weapon/tan/item/jinmu", 1);
        v2->move(v1);
        message_vision("欧冶子给了$N一块海底金母。\n", v1);
        v1->delete_temp("get_orc");
        v1->delete_temp("or");
        v1->set_temp("have_orc", 1);
        break;
    case 3:
        v2 = clone_object("/d/npc/m_weapon/tan/item/hanzhu", 1);
        v2->move(v1);
        message_vision("欧冶子给了$N一块寒丝羽竹。\n", v1);
        v1->delete_temp("get_orc");
        v1->delete_temp("or");
        v1->set_temp("have_orc", 1);
