int do_weapon() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!v1->query("item/weapon")) {
        return notify_fail("欧冶子说道：你造过兵器吗？\n");
    }
    if (objectp(v3 = v1->query_temp("item/weapon"))) {
        say("欧冶子脸色一沉：您的武器不就在你手边么？还来干什么！\n");
        return 1;
    }
    if (v1->query_temp("condition")) {
        say("欧冶子脸色一沉：不是让你去拿" + v1->query_temp("condition") + "了么？还没拿到回来干嘛！\n");
        return 1;
    }
    if (!v1->query_temp("condition_ok")) {
        message_vision("欧冶子说道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "想要重新得到兵器？这不难。不过......你得帮我找到我要的东西。\n", v1);
        switch (random(5)) {
        case 0:
            message_vision("欧冶子顿了一会，又说道：拿到菩提子，再来吧！\n", v1);
            v1->set_temp("condition", "菩提子");
            break;
        case 1:
            message_vision("欧冶子顿了一会，又说道：给我叫化鸡，我就帮你！！\n", v1);
            v1->set_temp("condition", "叫化鸡");
            break;
        case 2:
            message_vision("欧冶子沉思了一会，又说道：嗯...你就拿黑木崖白虎堂令牌来换吧！！\n", v1);
            v1->set_temp("condition", "白虎堂令牌");
            break;
        case 3:
            message_vision("欧冶子顿了一会，又说道：....我想看看有名的手镯！\n", v1);
            v1->set_temp("condition", "手镯");
            break;
        case 4:
            message_vision("欧冶子说道：如果你能替我找到辟邪剑谱的话......\n", v1);
            v1->set_temp("condition", "辟邪剑谱");
            break;
        }
    } else {
        v1->delete_temp("condition_ok");
        v2 = clone_object("/clone/item/weapon");
        v2->set_owner(v1->name(1), v1->query("id"));
        v2->move(v1, 1);
        message_vision("$N给了$n一把" + v2->name() + "。\n", this_object(), v1);
    }
    return 1;
}

int do_change() {
    mixed v1;
    v1 = this_player();
    if (!v1->query("item/weapon")) {
        message_vision("$N对$n疑道：你有打造过兵器吗？\n", this_object(), v1);
        return 1;
    }
    message_vision("$N笑道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "要改兵器类型，你有二千两黄金吗？\n", this_object());
    v1->set_temp("change_weapon", 1);
    return 1;
}

int do_modify(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!v1->query_temp("changed") || !v1->query("item/weapon")) {
        return 0;
    }
    if (!objectp(v2 = v1->query_temp("item/weapon"))) {
        return notify_fail("欧冶子疑道：你不把你的兵器拿来，我怎么帮你改啊？\n");
    }
    if (!arg || arg == "") {
        return notify_fail("指令格式：改 （兵器类型）\n");
    }
    if (arg != "剑" && arg != "刀" && arg != "棍" && arg != "鞭" && arg != "锤" && arg != "杖" && arg != "斧" && arg != "枪") {
        return notify_fail("欧冶子说道：请输入你要修改的类型！（剑、刀、棍、鞭、锤、杖、枪、斧）\n");
    }
    if (arg == v2->query("type")) {
        return notify_fail("欧冶子疑道：你这不是送钱给我花吗？\n");
    }
    v2->set("type", arg);
    v2->uniquip();
    v2->save();
    v2->set_owner(v1->name(1), v1->query("id"));
    v1->delete_temp("change_weapon");
    v1->delete_temp("changed");
    message_vision("$N把" + v2->name() + "接过，转身就把它丢进火炉之中，几个大汉迅速把它\n从火炉里捞了出来，再重新打造。过了一会，一把新造的" + v2->name() + "就打好了。\n$N把" + v2->name() + "递给$n道：这把兵刃已经改好了，希望你以后好好使用它。\n", this_object(), v1);
    return 1;
}

int ask_kaifeng() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!v1->query("item/weapon") || !objectp(v2 = v1->query_temp("item/weapon"))) {
        command("say 开锋兵器需要集天时、地利、人和，你连独门的兵器都没有，就更别说开锋你的兵器了。");
        return 1;
    }
    if (v2->query("level") < 30) {
        command("say 你的兵器等级还不够，就算开锋了，也未能激发其灵性。");
        return 1;
    }
    if (v2->query("changed")) {
        command("say 这位" + "/adm/daemons/rankd"->query_respect(v1) + "的独门兵器是否可手呀？");
        return 1;
    }
    command("think");
    say(name() + "沉思了一会，说道：相传有一位著名的铁匠，隐居在绝缘之地，你可以到\n绝缘之地看看，若是有缘，或许他会答应你的。\n");
    v1->set_temp("ask_ouyezi", 1);
    return 1;
}

int ask_apply() {
    mixed v1;
    v1 = this_player();
    if (v1->query("career")) {
        if (v1->query("career") == "铸造师") {
            say(name() + "语重深长的说道：做一名出色的铸造师，必须有过人的毅力和勇气，打造\n一件绝世的兵器，是天下间所有铸造师的梦想。\n");
            return 1;
        }
        say(name() + "说道：行行出状元，如果你能掌握了职业的技巧，相信你一定能做得很出色。\n");
        return 1;
    }
    if (v1->query_temp("pending/apply_smith")) {
        tell_object(v1, name() + "说道：你若是考虑清楚了，请输入( \e" + "[1;37mapply\e" + "[2;37;0m )。\n");
        return 1;
    }
    message_vision("$N打量了$n一眼，问道：一名出色的铸造师需要过人的勇气与毅力，\n更要具有超凡的力量和吃苦的决心，莫非你对铸造师也感兴趣？\n", this_object(), v1);
    tell_object(v1, "\e[33m如果你想成为一名铸造师，请输入( \e[1;37mapply\e[2;37;0m\e[33m )指令，以后，你将具备\n铸造、加工兵器的能力，而这个能力将不是其他职业所能拥有的。\n\e[2;37;0m");
    v1->set_temp("pending/apply_smith", 1);
    return 1;
}

int do_apply() {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("pending/apply_smith")) {
        return 0;
    }
    if (!v1->is_member()) {
        say(name() + "摇了摇头，说道：对不起，这个职业只对会员开放。\n");
        return 1;
    }
    if (v1->query("level") < 20) {
        say(name() + "摇了摇头，说道：你的等级太低，不适合做铸造师。\n");
        return 1;
    }
    if (v1->query("gender") != "男性") {
        say(name() + "摇了摇头，说道：这种粗重活，一个女人家怎么做得了啊。\n");
        return 1;
    }
    if (v1->query("str") < 50) {
        say(name() + "摇了摇头，说道：一名出色的铸造师，需要具备过人的勇气与毅力，" + "/adm/daemons/rankd"->query_respect(v1) + "如此单薄，恐怕无法胜任这个职业。\n");
        return 1;
    }
    if (v1->query("cou") < 60) {
        say(name() + "摇了摇头，说道：一名出色的铸造师，需要具备过人的勇气与毅力，" + "/adm/daemons/rankd"->query_respect(v1) + "在勇气方面，看来还需多加锻炼才是。\n");
        return 1;
    }
    message_vision("$N轻轻的拍了拍$n的肩膀，说道：好，既然你对铸造如此感兴趣，老朽\n也不妨教你一些铸造方面的技巧，希望你以后能够做一名出色的铸造师。\n", this_object(), v1);
    v1->set("career", "铸造师");
    v1->set_skill("founding", 1);
    tell_object(v1, "\e[1;32m恭喜，你已经掌握了一级铸造技巧，你将具备加工，铸造兵器的能力。\n\e[2;37;0m");
    v1->delete_temp("pending/apply_smith");
    return 1;
}

int ask_apply_cou(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query("combat/apply-weapon")) {
        say("欧冶子对着你微微的点了点头，眼神中似乎已经告诉了你一些什么。\n");
        return 1;
    }
    if (stringp(v2 = v1->query_temp("ouyezi_want"))) {
        say("欧冶子诡异的笑道：我要的" + v2 + "，你可曾找到了？\n");
        return 1;
    }
    switch (arg) {
    case "御剑技巧":
        if (v1->query_skill("apply-sword", 1) < 600) {
            say("欧冶子说道：御剑最高境界在于人剑合一，心如剑，手中无剑，心中有剑。\n这位" + "/adm/daemons/rankd"->query_respect(v1) + "在御剑方面，可要多加努力才是啊。\n");
            return 1;
        }
        say("欧冶子说道：御剑最高境界在于人剑合一，心如剑，手中无剑，心中有剑。\n我听说最近江湖上出现了一把叫索命短剑的神兵，老朽却一直未能亲眼所见，\n这位" + "/adm/daemons/rankd"->query_respect(v1) + "若是能帮我寻得此剑，我可以教你御剑的精髓。\n");
        v1->set_temp("ouyezi_want", "\e[1;32m索命\e[2;37;0m\e[36m短剑\e[2;37;0m");
        return 1;
    case "御刀技巧":
        if (v1->query_skill("apply-blade", 1) < 600) {
            say("欧冶子说道：用刀之人，心魔是最难克服的障碍之一，倘若你不能以心智控制\n刀中的力量，那随时将被刀魔牵引。丧失心魔的刀客，是最恐怖的刀客。\n");
            return 1;
        }
        say("欧冶子说道：用刀之人，心魔是最难克服的障碍之一，倘若你不能以心智控制\n刀中的力量，那随时将被刀魔所牵引。丧失心魔的刀客，是最恐怖的刀客。\n最近传言江湖上出现了一把叫吸魂短刀的神兵，老朽却一直未能亲眼所见，\n实在可惜，倘若这位" + "/adm/daemons/rankd"->query_respect(v1) + "能帮我寻得此刀，我可以教你抑制刀魔的要诀。\n");
        v1->set_temp("ouyezi_want", "\e[1;34m吸魂\e[2;37;0m\e[36m短刀\e[2;37;0m");
        return 1;
    case "御镖技巧":
        if (v1->query_skill("apply-throwing", 1) < 600) {
