    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!v1->query_temp("get_orc")) {
        return notify_fail("欧冶子疑道：你找到原料了吗？\n");
    }
    if (!arg) {
        return notify_fail("欧冶子疑道：你要造什么兵器？\n");
    }
    if (!v1->is_member()) {
