int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg1->query_temp("change_weapon")) {
        if (arg2->query("money_id") && arg2->value() >= 20000000) {
            tell_object(arg1, this_object()->name() + "说道：请输入：改 （兵器类型）\n");
            arg1->set_temp("changed", 1);
            arg1->delete_temp("change_weapon");
            return 1;
        } else {
            tell_object(arg1, this_object()->name() + "说道：重新打造兵器一次要二千两黄金呢！\n");
            return 0;
        }
    }
    if (stringp(v1 = arg1->query_temp("ouyezi_want"))) {
        if (v1 == arg2->name(1)) {
            tell_object(arg1, "欧冶子眼神大发异彩，激动的说道：对，这，这就是我一直寻找的" + v1 + "。\n欧冶子接过" + v1 + "，又回头对你说道：你为老朽寻得所爱，老朽也绝不食言。\n");
            message_vision("$N开始对$n讲述对于兵器上的一些御用技巧。\n", this_object(), arg1);
            tell_object(arg1, "你听了欧冶子的讲解，对于御用兵器方面的领悟已有所提高。\n");
            arg1->set("combat/apply-weapon", 1);
            arg1->delete_temp("ouyezi_want");
            return 1;
        } else {
            tell_object(arg1, "欧冶子说道：你这是何故？我要你帮我找的可是" + v1 + "！\n");
            return 0;
        }
    }
    switch (arg2->query("name")) {
    case "叫化鸡":
    case "白虎堂令牌":
    case "辟邪剑谱":
    case "菩提子":
    case "手镯":
        if (arg1->query_temp("condition") != arg2->query("name")) {
            message_vision("欧冶子一愣：我对你说过我要这样东西么？\n", arg1);
            return 1;
        } else {
            arg1->delete_temp("condition");
            message_vision("欧冶子微笑着：很好很好！那我就帮你这一次吧！\n", arg1);
            arg1->set_temp("condition_ok", 1);
            do_weapon();
            return 1;
        }
    }
    if (arg1->query("weapon/make")) {
        say("欧冶子一脸茫然：您已经有一把自造的武器了，还来干什么？难到不可手么？\n");
        return 1;
    }
    if (arg1->query_temp("have_orc")) {
        say("欧冶子说道：你不是有原料了吗？\n");
        return 0;
    }
    switch (arg2->query("id")) {
    case "shen mu":
        arg1->set_temp("or", 1);
        arg1->set_temp("get_orc", 1);
        break;
    case "jin mu":
        arg1->set_temp("or", 2);
        arg1->set_temp("get_orc", 1);
        break;
    case "han zhu":
        arg1->set_temp("or", 3);
        arg1->set_temp("get_orc", 1);
        break;
    default:
        message("vision", "这是什么！这不能用来打造兵器！", arg1);
        return 1;
    }
    message("vision", "欧冶子低头检视了一下手中的" + arg2->query("name") + "点了点头说：\n", arg1);
    write(name() + "说道：我这儿可以打造以下兵器：剑(sword)、刀(blade)、棍(stick)、杖(staff)、\n锤(hammer)、鞭(whip)、斧(axe)、枪(spear)。这位" + "/adm/daemons/rankd"->query_respect(arg1) + "要造什么兵器？\n决定了告诉我(answer)。\n");
    return 1;
}

