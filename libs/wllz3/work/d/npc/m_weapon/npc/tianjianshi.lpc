    case "御杖技巧":
    case "御棍技巧":
    case "御枪技巧":
        if (v1->query_skill("apply-staff", 1) < 600 && v1->query_skill("apply-club", 1) < 600 && v1->query_skill("apply-spear", 1) < 600) {
            say("欧冶子说道：御杖之人，必须心神合一，这位" + "/adm/daemons/rankd"->query_respect(v1) + "在御杖方面还有待提高啊。\n");
            return 1;
        }
        say("欧冶子说道：御杖之人，必须心神合一，只有人与杖的配合，恐怕还未能达到最高的境界。\n据悉江湖上最近出现了一把叫日月杖的神兵，老朽却一直未能亲眼所见。\n倘若这位" + "/adm/daemons/rankd"->query_respect(v1) + "能帮我求得此神兵，老朽定将御杖的要诀传授于你。\n");
        v1->set_temp("ouyezi_want", "\e[1;37m日月\e[2;37;0m\e[33m杖\e[2;37;0m");
        return 1;
    case "用鞭技巧":
        if (v1->query_skill("apply-whip", 1) < 600) {
            say("欧冶子说道：用鞭之人，心灵手巧是其次，必须领悟以柔克刚的道理，才\n能使你手中的鞭绳灵活自如，发挥其真正的威力。\n");
            return 1;
        }
        say("欧冶子说道：用鞭之人，心灵手巧是其次，必须领悟以柔克刚的道理，才\n能使你手中的鞭绳灵活自如，发挥其真正的威力。据闻最近江湖上流传一\n叫风神鞭的宝物，老朽心宜已久，倘若这位" + "/adm/daemons/rankd"->query_respect(v1) + "能帮我寻得这件宝物，我定教你用鞭的真正奥妙。\n");
        v1->set_temp("ouyezi_want", "\e[1;34m风神\e[2;37;0m\e[33m鞭\e[2;37;0m");
