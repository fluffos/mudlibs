// yahuan.c 丫环

inherit NPC;

void create()
{
        set_name("丫环", ({ "ya huan", "ya" }));
        set("gender", "女性");
        set("age", 15);

        set("level",10);
        set("player_waiter",1);
        set_skill("dodge", 20);
        set_skill("unarmed", 20);
        set_temp("apply/attack",  10);
        set_temp("apply/defense", 10);
        set("shen_type", -1);
        setup();

        add_money("silver",3);
        carry_object("/clone/cloth/cloth")->wear();
}
