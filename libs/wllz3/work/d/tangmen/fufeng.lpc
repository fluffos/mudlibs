inherit "/inherit/room/room";
void create();
void init();
int do_yell(mixed);
int do_dujiang();

void create() {
    set("short", "扶风湖");
    set("long", "出了竹林，面前是一片平静的湖面(lake)，微风拂过，水面泛起鳞鳞\r\n波纹。远远望去，湖中水雾蒙蒙，隐约有一个小岛的影子。水域很宽望不\r\n到对岸。\r\n");
    set("outdoors", "tangmen");
    set("exits", ([ "west" : "/d/tangmen/feicui" ]));
    set("item_desc", ([ "lake" : "岸边有一座画舫，也许喊(yell)一声船家就能听见。\n" ]));
    setup();
}

void init() {
    add_action("do_yell", "yell");
    add_action("do_dujiang", "dujiang");
}

int do_yell(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "boat") {
        arg = "船家";
    }
    if (v1->query("neili") < 300) {
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n", v1);
    } else if (v1->query("neili") > 600) {
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传了出去。\n", v1);
    } else {
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n", v1);
    }
    if (arg == "船家") {
        "/adm/daemons/transd"->check_boat(base_name(this_object()));
        return 1;
    } else {
        message_vision("江面上远远传来一阵回声：“" + arg + "～～～”\n", v1);
    }
    return 1;
}

int do_dujiang() {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (v1->query_skill("dodge", 1) < 150) {
        return notify_fail("你的轻功太差，难道你想跳下去找死吗？\n");
    }
    message_vision("$N纵身而起，轻轻落在湖面上，身形如燕，轻轻渡过了湖面。\n", v1);
    v1->move("/d/tangmen/damen");
    tell_room(environment(v1), "一个身影从湖面上一跃而上，轻轻的落在了岸边。\n", ({ v1 }));
    write("\e[1;32m你来到了湖边，纵身跳上岸上，眼前就是唐家堡的大门了。\n\e[2;37;0m");
    return 1;
}
