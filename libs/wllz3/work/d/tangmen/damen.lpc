}

void init() {
    add_action("do_yell", "yell");
    add_action("do_dujiang", "dujiang");
}

int do_yell(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "boat") {
        arg = "船家";
    }
    if (v1->query("neili") < 300) {
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n", v1);
    } else if (v1->query("neili") > 600) {
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传了出去。\n", v1);
    } else {
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n", v1);
    }
    if (arg == "船家") {
        "/adm/daemons/transd"->check_boat(base_name(this_object()));
        return 1;
    } else {
        message_vision("江面上远远传来一阵回声：“" + arg + "～～～”\n", v1);
    }
    return 1;
}

int valid_leave(mixed arg1, mixed arg2) {
    mixed v1;
    if ((!mapp(v1 = arg1->query("family")) || v1["family_name"] != "唐门") && arg2 == "south" && objectp(present("di zi", environment(arg1)))) {
        return notify_fail("唐门弟子一把拦道：你不是唐门弟子，不得入内。\n");
    }
    return ::valid_leave(arg1, arg2);
}

int do_dujiang() {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (v1->query_skill("dodge", 1) < 150) {
        return notify_fail("你的轻功太差，跳下去不是找死吗？\n");
    }
    message_vision("$N纵身跃起，轻轻的落在了湖面上，身形如燕，轻轻渡过了湖面。\n", v1);
    v1->move("/d/tangmen/fufeng");
    tell_room(environment(v1), "一个身影从湖面上一跃而起，轻轻的落在了岸边。\n", ({ v1 }));
    write("\e[1;32m你来到了湖边，纵身跃上岸上。\n\e[2;37;0m");
    return 1;
}
