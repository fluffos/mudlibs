void create() {
    set("short", "唐家堡");
    set("long", "下了画舫，抬头一望，赫然见到“唐家堡”三个大字。你已经来到了\r\n神秘而声名显赫声名显赫的唐门。高大的门让你不由得不仰视，大门口是\r\n两个威武雄壮的铜狮，两旁是笔力遒劲的对联(distich)。\r\n");
    set("no_steal", 1);
