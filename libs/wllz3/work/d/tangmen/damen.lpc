    set("item_desc", ([ "distich" : "\e[1;33m\n百                   一\n\n年                   腔\n\n世                   热\n\n家                   血\n\n传                   可\n\n千                   快\n\n古                   意\n\n风                   恩\n\n流                   仇\n\e[2;37;0m" ]));
    set("outdoors", "tangmen");
