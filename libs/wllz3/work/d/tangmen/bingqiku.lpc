inherit "/inherit/room/room";
void create();
void init();
int do_da(mixed);
void finish_dazao(mixed);
int do_sheng(mixed);
void fire(mixed);

void create() {
    set("short", "兵器库");
    set("long", "这里是唐门的兵器库，里面整整齐齐堆放着各种各样的暗器及刀剑，\r\n唐门弟子可以在这儿取用。库里还有火炉和铁锤，可以自己升火打造(da)\r\n钢镖。旁边还挂着一个牌子(sign)，好象写着什么。\r\n");
    set("exits", ([ "north" : "/d/tangmen/changlang4", "west" : "/d/tangmen/xingtang", "east" : "/d/tangmen/xiaoxiao-lou" ]));
    set("item_desc", ([ "sign" : "\r\n打造(dazao biao)钢镖之前必须先行生火(sheng huo)。\r\n打造飞镖与基本暗器[throwing]的等级有关，等级越高，打造出来的飞镖\r\n杀伤力将是越大。\r\n\r\n" ]));
    set("objects", ([ "/d/tangmen/obj/gangbiao1" : 15, "/clone/weapon/bamboo_sword" : 2, "/clone/weapon/bamboo_blade" : 2, "/d/tangmen/obj/suozijia" : 1 ]));
    setup();
}

void init() {
    add_action("do_da", "dazao");
    add_action("do_sheng", "sheng");
}

int do_da(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "biao") {
        return notify_fail("你要打造什么？\n");
    }
    if (v1->query_temp("marks/镖")) {
        if (v1->query("jing") < 10) {
            return notify_fail("你已经太累了，休息一会儿再打吧。\n");
        }
        if (v1->query("neili") <= v1->query("str")) {
            return notify_fail("你的内力不够了。\n");
        }
        if (v1->query_temp("dazao")) {
            return notify_fail("你已经在打造钢镖了。\n");
        }
        v1->set_temp("dazao", 1);
        v1->receive_damage("jing", 5);
        v1->add("neili", -v1->query("str"));
        message_vision("$N挥起大铁锤，开始打造钢镖。\n", v1);
        call_out("finish_dazao", 3, v1);
        v1->start_busy(3);
        return 1;
    }
    write("火已经熄灭了，你还是把火生起来再说吧。\n");
    return 1;
}

void finish_dazao(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = arg->query_skill("throwing", 1);
    if (!arg) {
        return;
    }
    arg->delete_temp("dazao");
    message_vision("随着“叮当叮当”的敲打声，$N手中的数枚钢镖已经打造好了。\n", arg);
    v2 = clone_object("/d/tangmen/obj/gangbiao1");
    if (v1 && arg->query("family/family_name") == "唐门") {
        v2->set("weapon_prop/damage", v1);
    }
    v2->move(this_player());
    return;
}

int do_sheng(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "huo") {
        return notify_fail("你要干什么？\n");
    }
    if (v1->query_temp("marks/镖")) {
        write("火已经生着了。\n");
        return 1;
    }
    message_vision("$N往炉中添了些木炭，拿起风箱开始升火。\n", v1);
    message_vision("\e[1;31m炉火熊熊燃了起来。\n\e[2;37;0m", v1);
    this_player()->set_temp("marks/镖", 1);
    remove_call_out("fire");
    call_out("fire", 20, this_object());
    return 1;
}

void fire(mixed arg) {
    if (interactive(this_player())) {
        message("vision", "\e[1;33m只见炉火扑闪了几下，熄了。\n\e[2;37;0m", arg);
    }
    this_player()->delete_temp("marks/镖");
}
