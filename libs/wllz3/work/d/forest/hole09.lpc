    add_action("do_bo", "bo");
}

int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "床" || arg == "石床" || arg == "bed") {
        if (v1->query_temp("jump_bed")) {
            message_vision("$N站在石床上跳来跳去，十分滑稽。\n", v1);
            return 1;
        }
        message_vision("$N跳到石床上。\n", v1);
        v1->set_temp("jump_bed", 1);
        return 1;
    } else if (arg == "down") {
        if (!v1->query_temp("jump_bed")) {
            message_vision("$N站在山洞里跳来跳去，十分滑稽。\n", v1);
            return 1;
        }
        message_vision("$N从床上跳了下来。\n", v1);
        v1->delete_temp("jump_bed");
        return 1;
    }
}

int do_bo(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg == "" || !v1->query_temp("jump_bed")) {
        return 0;
    }
    if (arg == "草" || arg == "野草" || arg == "cao") {
        if (objectp(v2 = find_object("/d/forest/obj/stone_green")) || query("boed")) {
            return notify_fail("野草已经被拨开了。\n");
        }
        message_vision("$N拨开石床上的野草，发现了一块晶莹剔透的绿色石片。\n", v1);
        v2 = clone_object("/d/forest/obj/stone_green");
        v2->move(v1);
        set("boed", 1);
        "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s拿到了传说中的%s了！", v1->name(), v2->name() + "\e" + "[1;34m"));
        return 1;
    }
}

