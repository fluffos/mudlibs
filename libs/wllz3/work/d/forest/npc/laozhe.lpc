    set("title", "\e[1;33m隐居深山，不亦乐乎\e[2;37;0m");
    set("long", "一位清瘦的白发老者，年约七旬，却是鹤发童颜，深陷的眼睛里依然炯炯\n有神。\n");
    set("gender", "男性");
