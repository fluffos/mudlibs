    arg->delete_temp("give_stone_green");
    arg->delete_temp("ask_laozhe_weapon");
    arg->delete_temp("ask_ouyezi");
    v1->save();
    v1->set_owner(arg->name(1), arg->query("id"));
    v1->set("changed", 1);
    v1->add("rigidity", 1);
}
