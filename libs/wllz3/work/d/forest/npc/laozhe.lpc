void init() {
    mixed v1;
    if (interactive(v1 = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if ("/adm/daemons/natured"->is_night()) {
        message_vision("$N挥挥手道：夜深了，老朽要休息了，这位" + "/adm/daemons/rankd"->query_respect(arg) + "请回吧！\n", this_object(), arg);
        arg->move("/d/forest/outside02");
        tell_room(environment(arg), arg->name() + "被人从茅屋里赶了出来，吃了一顿闭门羹，模样十分狼狈。\n", ({ arg }));
    } else {
        message_vision("$N看了$n一眼，甚是惊讶的说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "可真是有缘人呀！请进，请进！\n", this_object(), arg);
    }
    return;
}

int ask_weapon() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!v1->query_temp("ask_ouyezi")) {
        return 0;
    }
    if ("/adm/daemons/natured"->is_night()) {
        message_vision("$N挥挥手道：夜深了，老朽要休息了，这位" + "/adm/daemons/rankd"->query_respect(v1) + "请回吧！\n", this_object(), v1);
        v1->move("/d/forest/outside02");
        tell_room(environment(v1), v1->name() + "被人从茅屋里赶了出来，吃了一顿闭门羹，模样十分狼狈。\n", ({ v1 }));
        return 1;
    }
    if (!v1->query("item/weapon") || !objectp(v2 = v1->query_temp("item/weapon"))) {
        command("say 这位" + "/adm/daemons/rankd"->query_respect(v1) + "没有自家的兵器，老朽是不会帮你开锋的。");
        return 1;
    }
    if (v2->query("changed")) {
        command("say 这位" + "/adm/daemons/rankd"->query_respect(v1) + "的武器莫非不合手？");
        return 1;
    }
    v1->set_temp("ask_laozhe_weapon", 1);
    command("say 兵刃开锋讲究天时、地利、人和。天地万物，相生相克，如果你能用\n“白玉”和“翡翠”加以调和。老朽可将你手中的兵刃变成一把举世无双的神器。");
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->query("name") == "\e[1;37m白玉残片\e[2;37;0m" || arg2->query("name") == "\e[1;32m翡翠残片\e[2;37;0m") {
        if (!arg1->query_temp("ask_laozhe_weapon")) {
            say("白发老者笑道：" + arg2->name() + "可是兵刃开锋时所需的材料之一，多谢这位" + "/adm/daemons/rankd"->query_respect(arg1) + "了。\n");
            return 1;
        }
        if (!arg1->query_temp("give_stone_green") && arg1->query_temp("give_stone_white") && arg2->query("name") != "\e[1;32m翡翠残片\e[2;37;0m") {
            say("白发老者说道：白玉已经有了，现在还缺翡翠，" + "/adm/daemons/rankd"->query_respect(arg1) + "还是快去将它找来吧！\n");
            return 0;
        }
        if (arg1->query_temp("give_stone_green") && !arg1->query_temp("give_stone_white") && arg2->query("name") != "\e[1;37m白玉残片\e[2;37;0m") {
            say("白发老者说道：翡翠已经有了，现在还缺白玉，" + "/adm/daemons/rankd"->query_respect(arg1) + "还是快去将它找来吧！\n");
            return 0;
        }
        if (arg2->query("name") == "\e[1;37m白玉残片\e[2;37;0m") {
            if (arg1->query_temp("give_stone_green")) {
                command("say 好！现在材料配齐了，开始吧！");
                kaifeng(arg1);
            } else {
                arg1->set_temp("give_stone_white", 1);
                say("白发老者赞道：嗯！这块" + arg2->name() + "洁白晶莹而不带任何瑕疵，绝对是配合镶嵌于兵器的好材料。\n");
            }
            return 1;
        }
        if (arg2->query("name") == "\e[1;32m翡翠残片\e[2;37;0m") {
            if (arg1->query_temp("give_stone_white")) {
                command("say 好！现在材料配齐了，开始吧！");
                kaifeng(arg1);
            } else {
                arg1->set_temp("give_stone_green", 1);
                say("白发老者赞道：嗯！这块" + arg2->name() + "青翠晶莹而不带任何瑕疵，绝对是配合镶嵌于兵器的好材料。\n");
            }
            return 1;
        }
    }
    command("shake");
    command("say 老朽不希罕这东西。");
    return 0;
}

void kaifeng(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = arg->query_kar();
    if (!arg || environment() != environment(arg)) {
        return;
    }
    if (!objectp(v1 = arg->query_temp("item/weapon")) || !present(v1->query("id"), arg)) {
        arg->delete_temp("give_stone_white");
        arg->delete_temp("give_stone_green");
        arg->delete_temp("ask_laozhe_weapon");
        arg->delete_temp("ask_ouyezi");
        message_vision("$N突然愣了一下，说道：你的武器呢？\n", this_object());
        return;
    }
    v1->unequip();
    message_vision("$N将$n手中的" + v1->name() + "接过，再将白玉残片和翡翠残片镶嵌在" + v1->name() + "之上。\n", this_object(), arg);
    message_vision("紧接着，只见白发老者手指" + v1->query("type") + "身，口中喃喃自语，默念着口诀：.x$@!7V . . . . \n", arg);
    message_vision("只见" + v1->name() + "越来越亮，" + v1->query("type") + "身散发出一阵耀眼的光芒 . . \n", arg);
    message_vision("过了半晌，一切终于恢复了平静，$N气喘吁吁的说道：祭祀完成，好好把握它的灵性吧！\n", this_object());
