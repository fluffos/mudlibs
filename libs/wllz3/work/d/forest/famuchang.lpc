//muchang.c 伐木场

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "山谷中的伐木场");
	set("long", @LONG
这是一个被连绵山川四面环绕的伐木场，伐木场的四周又是一片足有
二人高的木栅栏，几个汗流颊背、蓬头污垢的男子正在一起砍倒一颗大树
。几个凶神恶煞的壮汉，手持皮鞭，紧紧的盯着这些人的一举一动，时而
用皮鞭狠狠的抽打，时而破口大骂，惨不忍睹。
LONG
);
	set("exits", ([
		"north" : __DIR__"xiaowu",
		"west":  __DIR__"muchang-w",
		"east":  __DIR__"muchang-e",
		"south": __DIR__"muchang-s",
	]));

	set("no_fight",1);
	set("no_beg",1);
	set("no_steal",1);
	set("no_magic",1);
	set("no_sleep_room",1);
	set("objects", ([
                __DIR__"npc/jiangong":2,
                __DIR__"npc/ehan":1,
	]));
	setup();
}
void init()
{
	add_action("do_famu","famu");
}
int do_famu(string arg)
{
	object me;
	me = this_player();
	
	if(!me->query("combat/arrested"))
		return notify_fail("你心里直乐着：“义务劳动，真好。”\n");
	
	if(me->query("brawn") < 10)
		return notify_fail("你太累了，还是休息一会再说吧。\n");
	
	if(me->query("qi") < 100 || me->query("jing") < 100)
		return notify_fail("你现在精神太差了，可别把性命给搭上。\n");

	if(me->is_busy())
		return notify_fail("你正忙着呢。\n");
	
	if(me->is_fighting())
		return notify_fail("你正忙着呢。\n");
	
	me->start_busy(bind((: call_other,__FILE__,"compelete_famu",me :),me));
	return 1;
}
int compelete_famu(object me)
{
	object wood;

	if(!me)
		return 0;
	
	if(!environment(me) || environment(me) != this_object())
	{
		me->set_short_desc(0);
		return 0;
	}
	
	if(me->query("brawn") < 20)
	{
		write("你砍着砍着，觉得疲惫不堪，于是停下来休息一会。\n");
		me->set_short_desc(0);
		return 0;
	}
	
	if(me->query("qi") < 100 || me->query("jing") < 100)
	{
		write("你觉得身体不适，需要好好的休息一会。\n");
		me->set_short_desc(0);
		return 0;
	}
	
	if(!present("fu tou",me))
	{
		write("你摸摸后脑，疑道：怎么斧子不见了？\n");
		me->set_short_desc(0);
		return 0;
	}

	if(me->query_temp("working") > 10
	&& me->add_temp("working",1) % 20 == 1)
	{
		write("你费了九牛二虎之力，终于将树干上的木头砍了下来。\n");
		wood = new("/clone/misc/wood");
		wood->move(me,1);
		me->add("combat/arrestd",-1);
		me->set_short_desc(0);
		return 0;
	}
	
	me->add("brawn",-10);
	me->add("jing",-70);
	me->add("qi",-70);	
	write(random(100) % 12 == 1 ? "你手举斧子，使劲的朝树干上挥去，“啪嗒”一声，树干上留下一条深深的斧印。\n":
	      random(100) % 15 == 1 ? "你举起斧子，使出吃奶的劲，用力的朝树干上砍去。\n":
	      random(100) % 17 == 1 ? "恶汉指着你的脑袋，破口大骂：你个猪脑，动作给我利索点！\n":
	      random(100) & 19 == 1 ? "你拿着斧子，老老实实的做起了伐木的工作。\n":
	      "你举着斧子，做起了伐木的工作，动作倒也十分麻利。\n");
	return 1;
}