void create() {
    set("short", "房间");
    set("long", "这是一间布置成卧室模样的小房间，有张石床，床上摆着个小小的木\r\n头制成的摇篮，墙壁上悬着一个七弦琴，弦线都已经断了。\r\n");
    set("exits", ([ "south" : "/d/xiaoyao/shiji2" ]));
