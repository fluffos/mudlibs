void init() {
    add_action("do_han", "han");
}

int do_han(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg != "逍遥自在") {
        return notify_fail("你气运丹田，对着墙壁大喝一声：“" + arg + "！”，结果什么反应都没有。\n");
    }
    if (arg == "逍遥自在") {
        tell_object(v1, "你气运丹田，对着墙壁大喝一声：“逍遥自在！”\n");
        if (random(100) > 50 || mapp(v2 = v1->query("family")) && v2["master_name"] == "逍遥子") {
            message("vision", "过了一会儿，你只听到一阵轰隆隆的响声，出现了一道暗门。\n", v1);
            set("exits/down", "/d/xiaoyao/shishi4");
