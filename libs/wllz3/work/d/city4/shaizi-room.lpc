void game_result() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v4 = all_inventory();
    if (objectp(v1 = present(zhuang_id, this_object())) && living(v1)) {
        tell_room(this_object(), v1->query("name") + "大声宣布：结帐！\n");
        v3 = v1->query_temp("shaizi/point");
    } else {
        tell_room(this_object(), "庄家不知道跑到哪里去了。大家都赢了！\n");
        v3 = -1;
        zhuang_id = "no zhuang";
    }
    for (v2 = 0; v2 < sizeof(v4); v2++) {
        if (v4[v2]->query_temp("shaizi/bet_amount") > 0 && v4[v2]->query("id") != zhuang_id) {
            if (v4[v2]->query_temp("shaizi/point") > v3) {
                tell_room(this_object(), v4[v2]->query("name") + "赢了" + chinese_number(v4[v2]->query_temp("shaizi/bet_amount")) + "两银子。\n");
                total_bet -= v4[v2]->query_temp("shaizi/bet_amount") * 2;
                if (total_bet >= 0) {
                    pay_player(v4[v2], v4[v2]->query_temp("shaizi/bet_amount") * 2);
                } else {
                    tell_room(this_object(), "糟糕！有人在这里偷钱！" + v4[v2]->query("name") + "赢的钱拿不到了。\n");
                }
                continue;
            }
            tell_room(this_object(), v4[v2]->query("name") + "输了" + chinese_number(v4[v2]->query_temp("shaizi/bet_amount")) + "两银子。\n");
        }
    }
    if (v1 && total_bet > 0) {
        tell_room(this_object(), "剩下的" + chinese_number(total_bet) + "两银子都是庄家" + v1->query("name") + "的了。\n");
        pay_player(v1, total_bet);
        total_bet = 0;
    }
    for (v2 = 0; v2 < sizeof(v4); v2++) {
        if (v4[v2]->query_temp("shaizi")) {
            v4[v2]->delete_temp("shaizi");
        }
    }
    game_status = 0;
    total_bet = 0;
    remove_call_out("check_finish");
}

void pay_player(mixed arg1, mixed arg2) {
