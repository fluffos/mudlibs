        v2 = clone_object("/clone/money/gold");
        v2->set_amount(arg2 / 100);
        arg2 -= v2->query_amount() * 100;
        v2->move(arg1, 1);
    }
    v3 = clone_object("/clone/money/silver");
    v3->set_amount(arg2);
    if (arg2 > 0) {
        v3 = clone_object("/clone/money/silver");
        v3->set_amount(arg2);
        arg2 -= v3->query_amount();
        v3->move(arg1, 1);
    }
}

int pay_out(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = check_silver(arg1) - arg2;
    if (v1 < 0) {
        return 0;
    }
    v2 = present("1000-cash_money", arg1);
    v3 = present("gold_money", arg1);
    v4 = present("silver_money", arg1);
    if (v2) {
        destruct(v2);
    }
    if (v3) {
        destruct(v3);
    }
    if (v4) {
        destruct(v4);
    }
    if (v1 > 0) {
        pay_player(arg1, v1);
    }
    return 1;
}

int check_silver(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = present("1000-cash_money", arg);
    v2 = present("gold_money", arg);
    v3 = present("silver_money", arg);
    v4 = 0;
    if (v1) {
        v4 += v1->query_amount() * 1000;
    }
    if (v2) {
        v4 += v2->query_amount() * 100;
    }
    if (v3) {
        v4 += v3->query_amount();
    }
    return v4;
}

int do_look(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = all_inventory();
    if (arg == "table") {
        if (total_bet > 0) {
            write("现在的赌注总共是" + total_bet + "两银子。\n");
            for (v3 = 0; v3 < sizeof(v2); v3++) {
                if (v2[v3]->query_temp("shaizi/bet_amount") > 0) {
                    write(v2[v3]->query("name") + "：" + v2[v3]->query_temp("shaizi/bet_amount") + "两。\n");
                }
            }
        } else {
            write("现在还没有人下注。\n");
        }
        if (zhuang_id == "no zhuang") {
            write("目前还没有庄家。\n");
        } else if (objectp(v1 = present(zhuang_id, this_object())) && living(v1)) {
            write("目前的庄家是" + v1->query("name") + "(" + v1->query("id") + ")。\n");
        } else {
            write("庄家不知道跑到哪里去了。\n");
            zhuang_id = "no zhuang";
        }
        return 1;
    }
    return 0;
}
