void check_players() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_object();
    if (pl["black"]) {
        v1 = pl["black"];
        if (!objectp(v1) || !living(v1) || !present(v1, v3)) {
            map_delete(pl, "black");
            if (living(v1)) {
                v1->delete_temp("weiqi_seat");
            }
        }
    }
    if (pl["white"]) {
        v2 = pl["white"];
        if (!objectp(v2) || !living(v2) || !present(v2, v3)) {
            map_delete(pl, "white");
            if (living(v2)) {
                v2->delete_temp("weiqi_seat");
            }
        }
    }
    call_out("check_players", 3);
}

int do_sit(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->query_temp("weiqi_seat")) {
        return notify_fail("你已经坐着了。\n");
    }
    if (!arg || arg != "black" && arg != "white") {
        return notify_fail("你想玩黑棋还是白棋？\n");
    }
    if (objectp(pl[arg])) {
        return notify_fail("这个位子上已经有人了！\n");
    }
    pl[arg] = v1;
    v1->set_temp("weiqi_seat", arg);
    if (arg == "black") {
        message_vision("$N坐上了深色的石凳。\n", v1);
    } else {
        message_vision("$N坐上了浅色的石凳。\n", v1);
    }
    return 1;
}

int do_leave(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!v2->query_temp("weiqi_seat")) {
        return notify_fail("你没有在下棋。\n");
    }
    v1 = v2->query_temp("weiqi_seat");
    message_vision("$N不想再下了，站了起来。\n", v2);
    map_delete(pl, v1);
    v2->delete_temp("weiqi_seat");
    status = 3;
    return 1;
}

