    if (status == 7) {
        game[v1[0] * bsize + v2[0]] = 0;
        if (lastlastmove == "") {
            WQ_Started = 0;
            lastmove = "";
        } else {
            lastmove = lastlastmove;
        }
    }
    if (turn == "black") {
        turn = "white";
        if (lastmove != "") {
            tell_room(v4, "\n黑棋上一步走在了" + lastmove + "\n");
        }
    } else {
        turn = "black";
        if (lastmove != "") {
            tell_room(v4, "\n白棋上一步走在了" + lastmove + "\n");
        }
    }
    tell_room(v4, show_game());
    v5 = pl[turn];
    if (turn == "black") {
        tell_room(v4, "现在轮到黑方" + v5->name() + "走棋。\n");
    } else {
        tell_room(v4, "现在轮到白方" + v5->name() + "走棋。\n");
    }
    return 1;
}

int do_play(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v1 = allocate(1);
    v2 = allocate(1);
    v3 = this_player();
    v4 = environment(v3);
    v7 = 0;
    if (!v3->query_temp("weiqi_seat")) {
        return notify_fail("你是旁观者，怎么好意思瞎指挥？\n");
    }
    if (status == 3) {
        return notify_fail("还没新开一局棋呐。\n");
    }
    if (v3->query_temp("weiqi_seat") != turn) {
        return notify_fail("还没轮到你走棋。\n");
    }
    if (!translate_position(arg, v1, v2)) {
        return notify_fail("你要下在哪里？\n");
    }
    if (status == 7) {
        v6 = wuzi_rule(v1[0], v2[0]);
        if (v6 == -2) {
            return notify_fail("这个位置上已经有子了！\n");
        }
        if (v6 == 9) {
            v7 = 1;
        }
    } else {
        v6 = weiqi_rule(v1[0], v2[0]);
        if (v6 == -2) {
            return notify_fail("这个位置上已经有子了！\n");
        }
        if (v6 == -3) {
            return notify_fail("现在还没轮到你提劫！\n");
        }
        if (v6 == -4) {
            return notify_fail("这个位置是禁入点！\n");
        }
    }
    WQ_Started = 1;
    WQ_Undoed = 0;
    lastlastmove = lastmove;
    lastmove = arg;
    if (turn == "black") {
        tell_room(v4, "\n黑棋上一步走在了" + arg + "\n");
    } else {
        tell_room(v4, "\n白棋上一步走在了" + arg + "\n");
    }
    if (v7) {
        tell_room(v4, show_game());
        if (turn == "black") {
            message_vision("黑方$N胜。\n", v3);
        } else {
            message_vision("白方$N胜。\n", v3);
        }
        status = 3;
        return 1;
    }
    if (turn == "black") {
        turn = "white";
        v5 = pl["white"];
    } else {
        turn = "black";
        v5 = pl["black"];
    }
    tell_room(v4, show_game());
    if (turn == "black") {
        message_vision("现在轮到黑方$N走棋。\n", v5);
    } else {
        message_vision("现在轮到白方$N走棋。\n", v5);
    }
    return 1;
}
