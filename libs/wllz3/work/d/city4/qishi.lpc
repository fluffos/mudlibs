int do_undo() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v1 = allocate(1);
    v2 = allocate(1);
    v3 = this_player();
    v4 = environment(v3);
    if (!v3->query_temp("weiqi_seat")) {
        return notify_fail("你是旁观者，怎么好意思瞎指挥？\n");
    }
    if (status == 3) {
        return notify_fail("还没新开一局棋呐。\n");
    }
    if (status != 7) {
        return notify_fail("目前只提供五子棋的悔棋功能。\n");
    }
