void create() {
    set("short", "关帝庙");
    set("long", "这里是供奉一代武圣关羽的庙宇，正对大门的是一尊巨大的关羽金身\r\n塑像，只见他左手拈须，右手手执《春秋》，身后是肩扛青龙偃月刀的周\r\n仓。来关帝庙里上香的人为数众多，因此这里整天香火不断，烟雾缭绕。\r\n不少武林侠客也前来这里膜拜(mobai)，消除杀气。\r\n");
    set("exits", ([ "north" : "/d/city4/bingying1", "south" : "/d/city4/weststreet3" ]));
