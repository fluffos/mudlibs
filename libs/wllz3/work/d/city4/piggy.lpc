}

int do_meditate(mixed arg) {
    tell_object(this_player(), "请不要在拱猪房里修炼，谢谢。\n");
    return 1;
}

int do_get(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    sscanf(arg, "%s from %s", v2, v3);
    if (!v3) {
        v3 = arg;
    }
    if (v1 = present(v3, this_object())) {
        if (userp(v1)) {
            tell_object(this_player(), "请不要占别人的便宜，谢谢。\n");
            return 1;
        }
    }
    return 0;
}

