        }
        if (v5 < 4 && (v3 = sizeof(TABLE["south"]["sold"]))) {
            v5 += v3;
            v4 = v3;
            while (v3--) {
                v10["south"] += sold_display("south", v3, 1);
            }
            v10["south"] = treat_sold(v10["south"], v4);
        } else {
            v10["south"] = "　　　　　　　　";
        }
        if (v5 < 4 && (v3 = sizeof(TABLE["east"]["sold"]))) {
            v5 += v3;
            switch (v3) {
            case 1:
                v10["east"][1] = sold_display("east", 0, 0);
                break;
            case 2:
                v10["east"][1] = sold_display("east", 0, 0);
                v10["east"][2] = sold_display("east", 1, 0);
                break;
            case 3:
                v10["east"][0] = sold_display("east", 0, 0);
                v10["east"][1] = sold_display("east", 1, 0);
                v10["east"][2] = sold_display("east", 2, 0);
                break;
            case 4:
                v10["east"][0] = sold_display("east", 0, 0);
                v10["east"][1] = sold_display("east", 1, 0);
                v10["east"][2] = sold_display("east", 1, 0);
                v10["east"][3] = sold_display("east", 3, 0);
                break;
            }
        } else {
        }
        if (v5 < 4 && (v3 = sizeof(TABLE["west"]["sold"]))) {
            v5 += v3;
            switch (v3) {
            case 1:
                v10["west"][1] = sold_display("west", 0, 0);
                break;
            case 2:
                v10["west"][1] = sold_display("west", 0, 0);
                v10["west"][2] = sold_display("west", 1, 0);
                break;
            case 3:
                v10["west"][0] = sold_display("west", 0, 0);
                v10["west"][1] = sold_display("west", 1, 0);
                v10["west"][2] = sold_display("west", 2, 0);
                break;
            case 4:
                v10["west"][0] = sold_display("west", 0, 0);
                v10["west"][1] = sold_display("west", 1, 0);
                v10["west"][2] = sold_display("west", 1, 0);
                v10["west"][3] = sold_display("west", 3, 0);
                break;
            }
        } else {
        }
        v6 = sprintf(PIGSTATE_FULL, v8, v9["north"]["player"], v10["north"], v10["west"][0], v9["north"]["card"], v10["east"][0], v10["west"][1], v10["east"][1], v9["west"]["player"], v9["west"]["card"], v9["east"]["card"], v9["east"]["player"], v10["west"][2], v10["east"][2], v10["west"][3], v9["south"]["card"], v10["east"][3], v10["south"], v9["south"]["player"]);
    }
    return v6;
}

string treat_sold(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = "";
    switch (arg2) {
    case 4:
        v1 = arg1;
        break;
    case 3:
        v1 = "　" + arg1 + "　";
        break;
    case 2:
        v1 = "　　" + arg1 + "　　";
        break;
    case 1:
        v1 = "　　　" + arg1 + "　　　";
        break;
    }
    return v1;
}

string sold_display(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    v1 = "";
    v1 += SOLD[TABLE[arg1]["sold"][arg2]][0] == "m" ? (CARDS[NCARD[TABLE[arg1]["sold"][arg2]]]["status"] != "played" ? SCARD[TABLE[arg1]["sold"][arg2]] + CCARD[TABLE[arg1]["sold"][arg2]][0..1] : "○") + "\e" + "[2;37;0m" : CARDS[NCARD[TABLE[arg1]["sold"][arg2]]]["status"] == "played" ? "\e[32m□\e[2;37;0m" : "\e[32m■\e[2;37;0m";
    if (arg3) {
        v1 += "　";
    }
    return v1;
}

