string display_table(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    mixed v10;
    v9 = allocate_mapping(4);
    v10 = allocate_mapping(4);
    v10 = ([ "east" : ({ "　", "　", "　", "　" }), "north" : "", "west" : ({ "　", "　", "　", "　" }), "south" : "" ]);
    v9 = ([ "east" : ([ "card" : "　　　", "player" : "「空」" ]), "north" : ([ "card" : "　　　", "player" : "「空」" ]), "west" : ([ "card" : "　　　", "player" : "「空」" ]), "south" : ([ "card" : "　　　", "player" : "「空」" ]) ]);
    v1 = NUM;
