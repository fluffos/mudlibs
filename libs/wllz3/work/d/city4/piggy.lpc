    }
    if ((arg || TABLE["cond"] != "出牌") && !is_dir(arg)) {
        v6 = sprintf(PIGSTATE_SHORT, v8, v9["north"]["player"], v9["north"]["card"], v9["west"]["player"], v9["west"]["card"], v9["east"]["card"], v9["east"]["player"], v9["south"]["card"], v9["south"]["player"]);
    } else {
        if (v3 = sizeof(TABLE["north"]["sold"])) {
            v5 = v3;
            v4 = v3;
            while (v3--) {
                v10["north"] += sold_display("north", v3, 1);
            }
            v10["north"] = treat_sold(v10["north"], v4);
        } else {
