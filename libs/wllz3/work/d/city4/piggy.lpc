    while (v2--) {
        v1 += "\n" + CDIR[DIR[v2]] + "家" + TABLE[DIR[v2]]["player_name"] + "收了如下的牌：";
        v1 += check_collected(DIR[v2], "spade");
        v1 += check_collected(DIR[v2], "heart");
        v1 += check_collected(DIR[v2], "diamond");
        v1 += check_collected(DIR[v2], "club");
    }
    return v1 + "\n";
}

string look_hand() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    v2 = "";
