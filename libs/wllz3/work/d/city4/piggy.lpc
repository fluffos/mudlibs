int is_suit(mixed arg) {
    if (member_array(arg, SUIT) == -1) {
        return 0;
    }
    return 1;
}

int is_dir(mixed arg) {
    if (member_array(arg, DIR) == -1) {
        return 0;
    }
    return 1;
}

int is_empty(mixed arg) {
    if (TABLE[arg]["player_id"] == "no one") {
        return 1;
    }
    if (!present(TABLE[arg]["player_id"], HERE)) {
        TABLE[arg]["player_id"] = "no one";
        return 1;
    }
    return 0;
}

int is_my_card(mixed arg1, mixed arg2) {
    if (CARDS[arg2]["status"] != search_my_dir(arg1)) {
        return 0;
    }
    return 1;
}

object search_dir(mixed arg) {
    return present(TABLE[arg]["player_id"], HERE);
}

string card_suit(mixed arg) {
    mixed v1;
    v1 = capitalize(arg);
    switch (v1[0..0]) {
    case "S":
        return "spade";
    case "H":
        return "heart";
    case "D":
        return "diamond";
    case "C":
        return "club";
    default:
        return "花色错误：card_suit。\n";
    }
}

int card_rank(mixed arg) {
    mixed v1;
    v1 = sizeof(arg) - 1;
    switch (arg[v1..v1]) {
    case "2":
        return 2;
    case "3":
        return 3;
    case "4":
        return 4;
    case "5":
        return 5;
    case "6":
        return 6;
    case "7":
        return 7;
    case "8":
        return 8;
    case "9":
        return 9;
    case "t":
    case "T":
        return 10;
    case "J":
    case "j":
        return 11;
    case "q":
    case "Q":
        return 12;
    case "k":
    case "K":
        return 13;
    case "a":
    case "A":
        return 14;
    default:
        return notify_fail("无法理解输入的牌，" + arg + "。请重新输入。\n");
    }
}

int card_numb(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!(v3 = card_suit(arg)) || !(v2 = card_rank(arg))) {
        return notify_fail("函数错误：card_numb。\n");
    }
    switch (v3) {
    case "spade":
        v1 = 1;
        break;
    case "heart":
        v1 = 14;
        break;
    case "diamond":
        v1 = 27;
        break;
    case "club":
        v1 = 40;
        break;
    default:
        return notify_fail("函数错误：card_numb。\n");
    }
    return v1 + 15 - v2;
}

int is_sellable(mixed arg) {
    switch (arg) {
    case 3:
    case 14:
    case 30:
    case 44:
        return 1;
    default:
        return 0;
    }
}

int is_playable(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = search_my_dir(arg1);
    if (!is_my_card(arg1, arg2)) {
        tell_object(arg1, "对不起，" + CARDS[arg2]["name"] + "不在你手里。\n");
        return 0;
    }
    if (v1 == GAMEINFO["rlead"]) {
        if (!is_sellable(arg2)) {
            return 1;
        }
    }
    v2 = CARDS[arg2]["suit"];
    if (v2 != GAMEINFO["suit"] && search_suit(arg1, GAMEINFO["suit"])) {
        tell_object(arg1, "对不起，你手中还有" + CSUIT[GAMEINFO["suit"]] + "，不能出" + CARDS[arg2]["name"] + "。\n");
        return 0;
    }
    if (!GAMEINFO[CARDS[arg2]["suit"]] && is_sellable(arg2)) {
        if (SOLD[CARDS[arg2]["misc"]][0] == "m" && search_suit(arg1, GAMEINFO["suit"] == "" ? CARDS[arg2]["suit"] : GAMEINFO["suit"]) > 1) {
            tell_object(arg1, "对不起，明卖了的牌不能在本花色第一轮出。\n");
            return 0;
        }
    }
    return 1;
}

int in_table(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = NUM;
    v2 = arg->query("id");
    while (v1--) {
        if (v2 == TABLE[DIR[v1]]["player_id"]) {
            arg->set_temp("piggy/seating", DIR[v1]);
            return 1;
        }
        continue;
    }
    return 0;
}

string search_my_dir(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = NUM;
    v2 = arg->query("id");
    while (v1--) {
        if (v2 == TABLE[DIR[v1]]["player_id"]) {
            return DIR[v1];
        }
        continue;
    }
    return "none";
}

int do_sit(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!is_dir(arg)) {
        return notify_fail("请选择「east、north、south 或 west」。\n");
    }
    if (in_table(v1)) {
        return notify_fail("你已经在座了。请用「leave」站起来。\n");
    }
    if (!is_empty(arg)) {
        return notify_fail(search_dir(arg)->query("name") + "正在" + CDIR[arg] + "边坐着呢，你还是等空位吧。\n");
    }
    v1->set_temp("piggy/seating", arg);
    TABLE[arg]["player_id"] = v1->query("id");
    TABLE[arg]["player_name"] = v1->query("name");
    TABLE[arg]["status"] = "filled";
    if (all_have("players")) {
        TABLE["cond"] = "等发牌";
    }
    message_vision("$N坐入了" + CDIR[arg] + "边的空位。\n", v1);
    return 1;
}

int do_leave(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!in_table(v2)) {
        return notify_fail("对不起，你并没在拱猪桌边坐着。\n");
    }
    v1 = search_my_dir(v2);
    if (is_empty(v1) || search_dir(v1) != v2) {
        return notify_fail("函数错误：do_leave。请告诉酸黄瓜。\n");
    }
    v2->delete_temp("piggy/seating", v1);
    TABLE[v1]["status"] = "empty";
    TABLE[v1]["player_name"] = "「空」";
    TABLE[v1]["player_id"] = "no one";
    TABLE["cond"] = "等人";
    renew("all");
    message_vision("$N让出了" + CDIR[v1] + "边的位置，不打算拱下去了。\n", v2);
    return 1;
}

int do_deal(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v1 = NUM;
    v3 = this_player();
    v4 = search_my_dir(v3);
    v5 = ({ });
    if (v4 == "none") {
        v3->delete_temp("piggy/seating");
        return notify_fail("对不起，你没有入座，无法要求发牌。\n");
    }
    if (!all_have("players")) {
        return notify_fail("还没凑齐四个人，没法开牌局。\n");
    }
    if (TABLE[v4]["status"] == "asked_for_deal" && TABLE["cond"] == "等人") {
        while (v1--) {
            v6 = DIR[v1];
            if (TABLE[v6]["status"] != "asked_for_deal") {
                v5 += ({ TABLE[v6]["player_name"] });
            }
            continue;
        }
        v2 = sizeof(v5);
        switch (v2) {
        case 1:
            v7 = v5[0];
            break;
        case 2:
            v7 = v5[0] + "和" + v5[1];
            break;
        case 3:
            v7 = v5[0] + "、" + v5[1] + "和" + v5[2];
            break;
        default:
            tell_room(HERE, "函数错误：发牌。请告诉酸黄瓜。\n");
            break;
        }
        return notify_fail("对不起，" + v7 + "还没准备好呢。\n");
    }
    if (TABLE[v4]["status"] != "filled" || TABLE["cond"] != "等发牌") {
        return notify_fail("对不起，现在不是发牌的时候。\n");
    }
    TABLE[v4]["status"] = "asked_for_deal";
    message_vision("$N说道：我准备好了，发牌吧。\n", v3);
    if (all_have("req_deal")) {
        message_vision("\n大家都准备好了，由$N负责发牌。\n\n", v3);
        TABLE["cond"] = "等卖牌";
        deal_cards("east");
        deal_cards("north");
        deal_cards("west");
        deal_cards("south");
        if (!is_dir(GAMEINFO["rlead"])) {
            GAMEINFO["rlead"] = search_my_dir(v3);
        }
        tell_room(HERE, "请用「sell」卖牌，「pass」停卖。\n");
    }
    return 1;
}

int do_sell(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v1 = this_player();
    v4 = "a";
    if (!in_table(v1)) {
        return notify_fail("对不起，你并不在拱猪。\n");
    }
    if (TABLE["cond"] != "等卖牌") {
        return notify_fail("对不起，现在不能卖牌。\n");
    }
    v2 = search_my_dir(v1);
    if (TABLE[v2]["status"] == "passed") {
        return notify_fail("对不起，你已经决定停卖了。\n");
    }
    if (!arg) {
        return notify_fail("请用 sell [-m] <card> 来卖牌。\n");
    }
    if (sscanf(arg, "-%s %s", v4, v3) != 2) {
        v3 = arg;
    } else if (v4 != "m") {
        return notify_fail("对不起，只能选择 [-m]。\n");
    }
    if (!(v5 = card_numb(v3))) {
        return notify_fail("对不起，「" + v3 + "」并不是一张牌。\n");
    }
    v5--;
    if (!is_my_card(v1, v5)) {
        return notify_fail("对不起，" + CARDS[v5]["name"] + "不在你手里。\n");
    }
    if (!is_sellable(v5)) {
        return notify_fail("对不起，只能卖猪（黑桃Ｑ）、羊（方片Ｊ）、变压器（草花Ｔ）或血（红桃Ａ）。\n");
    }
    v3 = CARDS[v5]["misc"];
    SOLD[v3] = ({ v4, v2 = search_my_dir(v1) });
    if (member_array(v3, TABLE[v2]["sold"]) == -1) {
        TABLE[v2]["sold"] += ({ v3 });
    }
    tell_object(v1, "你决定" + (v4 == "a" ? "暗" : "明") + "卖" + CCARD[v3] + "。\n");
    return 1;
}

int do_claim(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v1 = this_player();
    v2 = search_my_dir(v1);
    v4 = NUM;
    v5 = CARDNO + 1;
    if (TABLE["cond"] != "出牌") {
        return notify_fail("对不起，现在并不在出牌。\n");
    }
    switch (arg) {
    case "all":
        if (v2 == CLAIM["claimer"]) {
            return notify_fail("你已经发出要求，请等别人的回音。\n");
        }
        if (CLAIM["claimer"] != "") {
            return notify_fail("已经有人发出要求了，请先否决。\n");
        }
        CLAIM[v2] = "yes";
        CLAIM["claimer"] = v2;
        v3 = "$N认为自己手中的牌都大了：\n";
        v3 += display_suit(v2, "spade");
        v3 += display_suit(v2, "heart");
        v3 += display_suit(v2, "diamond");
        v3 += display_suit(v2, "club");
        v3 += "\n请用「yes」表示同意，「no」表示反对。\n";
        message_vision(v3, v1);
        break;
    case "yes":
        if (CLAIM["dir"] == "yes") {
            return notify_fail("你已经同意了。\n");
        }
        if (!is_dir(CLAIM["claimer"])) {
            return notify_fail("对不起，没人要求摊牌。\n");
        }
        CLAIM[v2] = "yes";
        message_vision("$N摊牌道：我同意。\n", v1);
        if (all_have("agreed_claim")) {
            while (v4--) {
                if (TABLE[DIR[v4]]["card"]) {
                    TABLE[CLAIM["claimer"]]["collected"] += ({ TABLE[DIR[v4]]["card"] });
                    TABLE[CLAIM["claimer"]]["card"] = 0;
                }
            }
            while (v5--) {
                if (is_dir(CARDS[v5]["status"])) {
                    TABLE[CLAIM["claimer"]]["collected"] += ({ v5 });
                    CARDS[v5]["status"] = "played";
                    if (v5 == 3) {
                        tell_room(HERE, "\e[1;34m" + TABLE[CLAIM["claimer"]]["player_name"] + "吃了猪头！\n" + "\e" + "[2;37;0m");
                        PIG_OWNER = CLAIM["claimer"];
                    }
                }
                continue;
            }
            GAMEINFO["round"] = 13;
            finish_round();
        }
        break;
    case "no":
        if (!is_dir(CLAIM["claimer"])) {
            return notify_fail("对不起，没有人要求摊牌。\n");
        }
        message_vision("$N不同意，请继续打下去。\n", v1);
        while (v4--) {
            CLAIM[DIR[v4]] = "no";
        }
        CLAIM["claimer"] = "";
        break;
    default:
        return notify_fail("请用「all」表示你想全收，「yes」表示同意，「no」表示反对。\n");
        break;
    }
    return 1;
}

int do_pass(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    v2 = search_my_dir(v1);
    if (!in_table(v1)) {
        return notify_fail("对不起，你并不在拱猪。\n");
    }
    if (TABLE["cond"] != "等卖牌") {
        return notify_fail("对不起，现在不能卖牌或停卖。\n");
    }
    if (TABLE[v2]["status"] == "passed") {
        return notify_fail("你已经决定停卖了。\n");
    }
    TABLE[v2]["status"] = "passed";
    message_vision("$N说道：我停卖。\n", v1);
    if (all_have("pass")) {
        TABLE["cond"] = "出牌";
        GAMEINFO["round"] = 1;
        v3 = "\n大家都停卖了，";
        v3 += display_sell();
        v3 += "\n一切就绪，开拱！\n";
        v3 += "这把由" + TABLE[GAMEINFO["rlead"]]["player_name"] + "先出！\n\n";
        GAMEINFO["next"] = GAMEINFO["rlead"];
        tell_room(HERE, v3);
    }
    return 1;
}

int do_play(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!in_table(v1)) {
        return notify_fail("对不起，你并不在拱猪。\n");
    }
    if (!arg) {
        return notify_fail("请用 play <card> 出牌。\n");
    }
    if (TABLE["cond"] != "出牌") {
        return notify_fail("对不起，现在不能出牌。\n");
    }
    if (GAMEINFO["next"] != search_my_dir(v1)) {
        return notify_fail("对不起，现在不该你出牌。\n");
    }
    if (is_dir(CLAIM["claimer"])) {
        return notify_fail("对不起，请等到" + TABLE[CLAIM["claimer"]]["player_name"] + "的全收要求有结果后再出牌。\n");
    }
    if (!(v2 = card_numb(arg))) {
        return notify_fail("对不起，无法分辨 " + arg + "。\n");
    }
    v2--;
    if (!is_playable(v1, v2)) {
        return 1;
    }
    CARDS[v2]["status"] = "played";
    TABLE[GAMEINFO["next"]]["card"] = v2;
    if (GAMEINFO["next"] == GAMEINFO["rlead"]) {
        GAMEINFO["suit"] = CARDS[v2]["suit"];
    }
    if (!is_sellable(v2)) {
        message_vision("$N" + (CARDS[v2]["suit"] == GAMEINFO["suit"] ? "出" : "垫") + "了一张" + CARDS[v2]["name"] + "。\n", v1);
    } else if (SOLD[CARDS[v2]["misc"]][0] != "not") {
        message_vision("$N出" + (SOLD[CARDS[v2]["misc"]][0] == "m" ? "明" : "暗") + "卖的" + CARDS[v2]["name"] + "！\n", v1);
    } else {
        message_vision("$N" + (CARDS[v2]["suit"] == GAMEINFO["suit"] ? "出" : "垫") + "了一张" + CARDS[v2]["name"] + "。\n", v1);
    }
    if (all_have("cards")) {
        finish_round();
    } else {
        GAMEINFO["next"] = next_player(GAMEINFO["next"]);
    }
    if (is_dir(GAMEINFO["next"])) {
        tell_room(HERE, "下面该由" + TABLE[GAMEINFO["next"]]["player_name"] + "出牌。\n");
    }
    return 1;
}

object find_me(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = TABLE[arg]["player_id"];
    if (!(v1 = present(v2, HERE))) {
        tell_room(HERE, TABLE[arg]["player_name"] + "不在房间里！\n");
        tell_room(HERE, "清理房间中……\n");
        renew("all");
        tell_room(HERE, "请重新凑人！\n");
    }
    return v1;
}

int score_player(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    v2 = 0;
    v3 = TABLE[arg]["collected"];
    v4 = 13;
    v6 = 0;
    while (v4--) {
        v5 = v4 + 14;
        if (member_array(v5, v3) == -1) {
            continue;
        }
        v1 += CARDS[v5]["worth"];
        v3 -= ({ v5 });
        continue;
    }
    if (v1 == -20003) {
        v1 = 20000;
        v6 = 1;
    }
    if (SOLD["blood"][0] == "m") {
        v1 = v1 * 4;
    } else if (SOLD["blood"][0] == "a") {
        v1 = v1 * 2;
    }
    if (member_array(3, v3) != -1) {
        if (SOLD["pig"][0] == "m") {
            v2 = CARDS[3]["worth"] * 4;
        } else if (SOLD["pig"][0] == "a") {
            v2 = CARDS[3]["worth"] * 2;
        } else {
            v2 = CARDS[3]["worth"];
        }
        v3 -= ({ 3 });
        if (v6) {
            v1 = v1 - v2;
        } else {
            v1 += v2;
        }
    } else {
        v6 = 0;
    }
    if (member_array(30, v3) != -1) {
        v1 = v1 / 100 * 100;
        if (SOLD["sheep"][0] == "m") {
            v2 = CARDS[30]["worth"] * 4;
        } else if (SOLD["sheep"][0] == "a") {
            v2 = CARDS[30]["worth"] * 2;
        } else {
            v2 = CARDS[30]["worth"];
        }
        v3 -= ({ 30 });
        v1 += v2;
    } else {
        v6 = 0;
    }
    if (member_array(44, v3) != -1) {
        if (SOLD["doubler"][0] == "m") {
            v2 = 8;
        } else if (SOLD["doubler"][0] == "a") {
            v2 = 4;
        } else {
            v2 = 2;
        }
        v3 -= ({ 44 });
        if (!v1) {
            v1 = v2 * CARDS[44]["worth"] / 2;
        } else {
            v1 = v1 / 1000 * 1000;
            v1 = v1 * v2;
        }
    } else {
        v6 = 0;
    }
    if (v6) {
        FULL = arg;
    } else {
        FULL = "";
    }
    return v1 / 100;
}

string find_large() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v4 = NUM;
    v5 = 0;
    if (is_dir(CLAIM["claimer"])) {
        return CLAIM["claimer"];
    }
    v3 = GAMEINFO["rlead"];
    while (v4--) {
        v2 = CARDS[TABLE[v3]["card"]];
        v1 = CARDS[TABLE[DIR[v4]]["card"]];
        if (v1["misc"] == "pig") {
            v5 = 1;
        }
        if (v1["suit"] == GAMEINFO["suit"] && v1["rank"] > v2["rank"]) {
            v3 = DIR[v4];
        }
        continue;
    }
    v4 = NUM;
    while (v4--) {
        TABLE[v3]["collected"] += ({ TABLE[DIR[v4]]["card"] });
        continue;
    }
    if (v5) {
        PIG_OWNER = v3;
        tell_room(HERE, "\e[1;34m" + TABLE[v3]["player_name"] + "吃了猪头！\n\e" + "[2;37;0m");
    }
    return v3;
}

void finish_round() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    v1 = NUM;
    v2 = CARDNO;
    v5 = find_large();
    if (GAMEINFO["round"] == 13) {
        TABLE["cond"] = "算分";
        while (v2--) {
            if (CARDS[v2 + 1]["status"] != "played") {
                tell_room(HERE, "函数错误：finish_round。" + CARDS[v2 + 1]["name"] + "还没打过。\n");
            }
            continue;
        }
        score_player(PIG_OWNER);
        if (!is_dir(FULL)) {
            while (v1--) {
                v3 = score_player(DIR[v1]);
                v6 = find_me(DIR[v1]);
                v6->add("piggy/score", v3);
                v6->add("piggy/hand_played", 1);
                SCORING["hand"][DIR[v1]] += v3;
                if ((SCORING["sitting"][DIR[v1]] += v3) < LIMIT) {
                    PIGHEAD += ({ DIR[v1] });
                }
                continue;
            }
        } else {
            while (v1--) {
                (v6 = find_me(DIR[v1]))->add("piggy/hand_played", 1);
                if (FULL != DIR[v1]) {
                    PIGHEAD += ({ DIR[v1] });
                    continue;
                }
                v6->add("piggy/score", v3 = score_player(FULL));
                SCORING["hand"][FULL] += v3;
                SCORING["sitting"][FULL] += v3;
                continue;
            }
        }
        if (v4 = sizeof(PIGHEAD)) {
            while (v4--) {
                find_me(PIGHEAD[v4])->add("piggy/head_received", 1);
            }
        }
        tell_room(HERE, display_score());
        if (sizeof(PIGHEAD)) {
            all_have("given_head");
            renew("sitting");
        } else {
            renew("hand");
        }
        return;
    }
    GAMEINFO[GAMEINFO["suit"]]++;
    GAMEINFO["rlead"] = v5;
    GAMEINFO["next"] = v5;
    find_me(v5);
    tell_room(HERE, display_table(v5));
    renew("round");
    return;
}

string next_player(mixed arg) {
    switch (arg) {
    case "east":
        return "north";
    case "north":
        return "west";
    case "west":
        return "south";
    case "south":
        return "east";
    default:
        return "函数错误：next_player。\n";
    }
}

int deal_cards(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = CARDNO / 4;
    v2 = ([ ]);
    while (v1--) {
        v2 = CARDS[random(CARDNO) + 1];
        if (v2["status"] != "undealt") {
            v1++;
            continue;
        }
        v2["status"] = arg;
        continue;
    }
    display_cards(search_dir(arg));
    return 1;
}

