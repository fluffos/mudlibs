    v3 = search_my_dir(v1);
    v2 += "\n你手中的牌如下：\n";
    v2 += display_suit(v3, "spade");
    v2 += display_suit(v3, "heart");
    v2 += display_suit(v3, "diamond");
    v2 += display_suit(v3, "club");
    return v2 + "\n\n";
}

string look_note() {
    if (TABLE["cond"] == "等人") {
        return "纸上画着一个猪头，旁边的名字被人擦去了。下面是个表格，画得歪七扭八的。\n";
