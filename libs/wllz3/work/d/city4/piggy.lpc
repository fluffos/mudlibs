void create() {
    set("short", "拱猪房");
    set("long", "这间房子是专门为了拱猪用而设的，整间屋子都是用不去皮的松树搭\r\n成。一张石桌 (table)周围摆着四个石礅，桌面镶了一块大理石，摸上去\r\n极为光滑。四壁挂着长明灯，把屋子照得有如白昼。墙角里烧了一炉不知\r\n名的香，似乎颇有提神之效。香炉旁边挂着张告示(gaoshi)，上面写着这\r\n里的规矩；桌上有张小纸条(note)，上面草草的记着拱猪成绩。\r\n");
    set("exits", ([ "south" : "/d/city4/club3" ]));
    set("item_desc", ([ "table" : (: look_table :), "gaoshi" : (: read_rules :), "hand" : (: look_hand :), "collected" : (: look_collected :), "note" : (: look_note :) ]));
    set("no_clean_up", 1);
    set("no_fight", 1);
    set("no_magic", 1);
    setup();
}

