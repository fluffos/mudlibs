void renew(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = NUM;
    v2 = CARDNO;
    switch (arg) {
    case "round":
        GAMEINFO["round"]++;
        all_have("played_card");
        GAMEINFO["suit"] = "";
        break;
    case "hand":
        TABLE["cond"] = "等发牌";
        GAMEINFO["round"] = 0;
        GAMEINFO["suit"] = "";
        GAMEINFO["rlead"] = PIG_OWNER;
        GAMEINFO["next"] = "";
        CLAIM["claimer"] = "";
        SOLD = ([ "pig" : ({ "not" }), "blood" : ({ "not" }), "sheep" : ({ "not" }), "doubler" : ({ "not" }) ]);
        FULL = "";
        PIG_OWNER = "";
        while (v2--) {
            CARDS[v2 + 1]["status"] = "undealt";
        }
        while (v1--) {
            GAMEINFO[SUIT[v1]] = 0;
            CLAIM[DIR[v1]] = "no";
            TABLE[DIR[v1]]["card"] = 0;
            TABLE[DIR[v1]]["collected"] = ({ });
            TABLE[DIR[v1]]["sold"] = ({ });
            TABLE[DIR[v1]]["status"] = "filled";
            SCORING["hand"][DIR[v1]] = 0;
        }
        break;
    case "sitting":
        renew("hand");
        PIGHEAD = ({ });
        while (v1--) {
            SCORING["sitting"][DIR[v1]] = 0;
            SCORING["hand"][DIR[v1]] = 0;
        }
        break;
    case "all":
        renew("sitting");
        while (v1--) {
            if (TABLE[DIR[v1]]["player_id"] == "no one") {
                TABLE[DIR[v1]]["status"] = "empty";
            }
        }
        TABLE["cond"] = "等人";
        GAMEINFO["rlead"] = "";
        break;
    default:
        tell_room(HERE, "函数用法错误：renew。\n");
        break;
    }
    return;
}

int all_have(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = 1;
    v2 = NUM;
    switch (arg) {
    case "players":
        while (v2--) {
            if (TABLE[DIR[v2]]["player_name"] == "「空」" || !present(TABLE[DIR[v2]]["player_id"], HERE)) {
                v1 = 0;
            }
            continue;
        }
        break;
    case "played_card":
        while (v2--) {
            CARDS[TABLE[DIR[v2]]["card"]]["status"] = "played";
            TABLE[DIR[v2]]["card"] = 0;
            continue;
        }
        break;
    case "agreed_claim":
        while (v2--) {
            if (CLAIM[DIR[v2]] != "yes") {
                v1 = 0;
            }
            continue;
        }
        break;
    case "cards":
        while (v2--) {
            if (!TABLE[DIR[v2]]["card"]) {
                v1 = 0;
            }
            continue;
        }
        break;
    case "given_head":
        while (v2--) {
            v3 = find_me(DIR[v2]);
            v3->add("piggy/head_given", sizeof(PIGHEAD));
            continue;
        }
        break;
    case "req_deal":
        while (v2--) {
            if (TABLE[DIR[v2]]["status"] != "asked_for_deal") {
                v1 = 0;
            }
            continue;
        }
        break;
    case "pass":
        while (v2--) {
            if (TABLE[DIR[v2]]["status"] != "passed") {
                v1 = 0;
            }
            continue;
        }
        break;
    default:
        tell_room(HERE, "函数用法错误：all_have。\n");
        v1 = 0;
        break;
    }
    return v1;
}

string look_table() {
