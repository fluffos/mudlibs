            return 1;
        }
    } else if (arg == "north" || arg == "n") {
        if (objectp(v2 = present(n_id, this_object())) && living(v2)) {
            return notify_fail("北座已经有人了。\n");
        } else {
            n_id = v1;
            message_vision("$N坐上了北边的椅子。\n", v3);
            return 1;
        }
    } else if (arg == "south" || arg == "s") {
        if (objectp(v2 = present(s_id, this_object())) && living(v2)) {
            return notify_fail("南座已经有人了。\n");
        } else {
            s_id = v1;
            message_vision("$N坐上了南边的椅子。\n", v3);
            return 1;
        }
    } else {
        return notify_fail("你要坐哪边？\n");
    }
}

