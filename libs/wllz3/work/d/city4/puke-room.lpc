    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    v3 = this_player();
    v4 = v3->query("id");
    if (!game_status) {
        return notify_fail("拱猪还没开始。\n");
    }
    v5 = "no dir";
    if (v4 == e_id) {
        v5 = "e";
    } else if (v4 == w_id) {
        v5 = "w";
    } else if (v4 == n_id) {
        v5 = "n";
    } else if (v4 == s_id) {
        v5 = "s";
    } else {
        return notify_fail("你并没有加入拱猪。\n");
    }
    v6 = "你手头的牌有：\n";
    v2 = 0;
    for (v1 = 0; v1 < pai_size; v1++) {
        if (v1 == 13 || v1 == 26 || v1 == 39 || v1 == 52) {
            v6 += "\n";
            v2 = 0;
        }
        if (pai_state[v1] == v5) {
            v2++;
