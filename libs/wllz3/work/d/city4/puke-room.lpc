void create() {
    set("short", "拱猪房");
    set("long", "屋中间摆着一张看起来相当结实的大方桌(table)，桌边围着四\n把靠背木椅。东面墙上有一块大牌子(paizi)，西面墙上有一块小牌\n子(score)。\n");
    set("item_desc", ([ "paizi" : "\n\n拱猪规则：\n\n主要指令有：\n一，就坐(sit <n, s, e, w>)。\n二，开拱(start)。\n三，出牌(play <花色> <大小>)。\n　　花色有(hei, hong, cao, fang)或用(S/s, H/h, C/c, D/d)来代表。\n　　大小有(1, ..., 13)或用(A/a, J/j, Q/q, K/k)来代表(1, 11, 12, 13)。\n四，好牌亮相(double <zhu/z, yang/y, hong/h, bian/b>)。\n五，查自己的牌(my)。\n六，看桌面情况(look table)。\n七，看积分(look score)。\n八，退出拱猪(leave)。\n\n注意事项：\n一，要端正牌风，系统不揭发舞弊。\n二，每一盘必须在半小时内完成，否则取消重来。\n二，有任何bug请报告巫师。目前是测试阶段，可能还有不少错。\n\n\t\t\n" ]));
    set("exits", ([ "west" : "/d/city4/clubpoem" ]));
    set("no_fight", 1);
    set("no_magic", 1);
    set("no_clean_up", 1);
    setup();
}

void init() {
    add_action("do_sit", "sit");
    add_action("do_play", "play");
    add_action("do_double", "double");
    add_action("do_leave", "leave");
    add_action("do_start", "start");
    add_action("do_look", "look");
    add_action("do_my", "my");
}

string check_kind(mixed arg) {
    if (arg < 0) {
        return "none";
    } else if (arg < 13) {
        return "hei";
    } else if (arg < 26) {
        return "hong";
    } else if (arg < 39) {
        return "cao";
    } else if (arg < 52) {
        return "fang";
    } else if (arg == 52) {
        return "xwang";
    } else if (arg == 53) {
        return "dwang";
    } else {
        return "none";
    }
}

int check_rank(mixed arg) {
    mixed v1;
    if (arg < 0) {
        v1 = 0;
    } else if (arg < 52) {
        v1 = arg % 13 + 1;
        if (v1 == 1) {
            v1 = 14;
        }
    } else {
        v1 = arg + 1;
    }
    return v1;
}

int check_score(mixed arg) {
    mixed v1;
    if (pai_name[arg] == "【黑Ｑ】") {
        return pig_double * 100;
    }
    if (pai_name[arg] == "【方Ｊ】") {
        return yang_double * -100;
    }
    if (pai_name[arg] == "【草十】") {
        return -10;
    }
    if (check_kind(arg) != "hong") {
        return 0;
    }
    v1 = check_rank(arg);
    if (v1 < 5) {
        return 0;
    } else if (v1 <= 10) {
        return hong_double * 10;
    } else {
        return (v1 - 9) * 10 * hong_double;
    }
}

int convert_to_id(mixed arg1, mixed arg2) {
    if (arg1 == "xwang") {
        return 52;
    }
    if (arg1 == "dwang") {
        return 53;
    }
    if (arg2 == 14) {
        arg2 = 1;
    }
    if (arg1 == "hei") {
        return arg2 - 1;
    } else if (arg1 == "hong") {
        return arg2 + 12;
    } else if (arg1 == "cao") {
        return arg2 + 25;
    } else if (arg1 == "fang") {
        return arg2 + 38;
    } else {
        return 53;
    }
}

string chinese_dir(mixed arg) {
    if (arg == "east" || arg == "e") {
        return "东";
    } else if (arg == "west" || arg == "w") {
        return "西";
    } else if (arg == "south" || arg == "s") {
        return "南";
    } else if (arg == "north" || arg == "n") {
        return "北";
    } else if (arg == "up" || arg == "u") {
        return "上";
    } else if (arg == "down" || arg == "d") {
        return "下";
    } else if (arg == "left" || arg == "l") {
        return "左";
    } else if (arg == "right" || arg == "r") {
        return "右";
    } else {
        return "？";
    }
}

