void game_process() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v3 = 0;
    for (v2 = 0; v2 < pai_size; v2++) {
        if (pai_state[v2] == "t") {
            v3++;
        }
    }
    current_round_step = v3 % 4;
    if (!current_round_step && v3 != 0) {
        current_round_step = 4;
    }
    if (who_to_play == e_id) {
        current_round_ids[current_round_step] = e_last;
    } else if (who_to_play == w_id) {
        current_round_ids[current_round_step] = w_last;
    } else if (who_to_play == n_id) {
        current_round_ids[current_round_step] = n_last;
    } else if (who_to_play == s_id) {
        current_round_ids[current_round_step] = s_last;
    } else {
        tell_room(this_object(), "出问题了(set current ids)，叫巫师来吧。\n");
    }
    if (current_round_step == 1) {
        if (who_to_play == e_id) {
            current_round_kind = check_kind(e_last);
        } else if (who_to_play == w_id) {
            current_round_kind = check_kind(w_last);
        } else if (who_to_play == n_id) {
            current_round_kind = check_kind(n_last);
        } else if (who_to_play == s_id) {
            current_round_kind = check_kind(s_last);
        } else {
            tell_room(this_object(), "出问题了(set current kind)，叫巫师来吧。\n");
        }
    }
    if (current_round_step == 4) {
        who_to_play = get_next_player();
    } else if (who_to_play == e_id) {
        who_to_play = n_id;
    } else if (who_to_play == n_id) {
        who_to_play = w_id;
    } else if (who_to_play == w_id) {
        who_to_play = s_id;
    } else if (who_to_play == s_id) {
        who_to_play = e_id;
    } else {
        tell_room(this_object(), "出问题了(shift player)，叫巫师来吧。\n");
    }
    if (current_round_step) {
        v5 = "这一轮所出的牌：";
        for (v4 = 1; v4 <= current_round_step; v4++) {
            if (current_round_ids[v4] < pai_size) {
                v5 += pai_name[current_round_ids[v4]];
            }
        }
        v5 += "\n";
        tell_room(this_object(), v5);
    }
    if (v3 == pai_size) {
        call_out("game_finished", 1);
        return;
    }
    if (objectp(v1 = present(who_to_play, this_object())) && living(v1)) {
        tell_room(this_object(), "下面该" + v1->query("name") + "出牌了。\n");
    } else {
        tell_room(this_object(), "下一位出牌人跑了？\n");
    }
}

string get_next_player() {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = "t";
    v3 = "no one";
    if (pai_compare(e_last, w_last) > 0) {
        v1 = e_last;
    } else {
        v1 = w_last;
    }
    if (pai_compare(n_last, v1) > 0) {
        v1 = n_last;
    }
    if (pai_compare(s_last, v1) > 0) {
        v1 = s_last;
    }
    if (v1 == e_last) {
        v2 = "e";
        v3 = e_id;
    } else if (v1 == w_last) {
        v2 = "w";
        v3 = w_id;
    } else if (v1 == n_last) {
        v2 = "n";
        v3 = n_id;
    } else if (v1 == s_last) {
        v2 = "s";
        v3 = s_id;
    } else {
        tell_room(this_object(), "出问题了(get next player)，叫巫师来吧。\n");
    }
    if (check_score(e_last)) {
        pai_destination[e_last] = v2;
    }
    if (check_score(w_last)) {
        pai_destination[w_last] = v2;
    }
    if (check_score(n_last)) {
        pai_destination[n_last] = v2;
    }
    if (check_score(s_last)) {
        pai_destination[s_last] = v2;
    }
    tell_room(this_object(), chinese_dir(v2) + "家的" + pai_name[v1] + "最大。\n");
    if (pai_name[e_last] == "【黑Ｑ】" || pai_name[w_last] == "【黑Ｑ】" || pai_name[n_last] == "【黑Ｑ】" || pai_name[s_last] == "【黑Ｑ】") {
        tell_room(this_object(), "啊哈！猪上" + chinese_dir(v2) + "家去了。\n");
    }
    if (pai_name[e_last] == "【方Ｊ】" || pai_name[w_last] == "【方Ｊ】" || pai_name[n_last] == "【方Ｊ】" || pai_name[s_last] == "【方Ｊ】") {
        tell_room(this_object(), chinese_dir(v2) + "家得到了羊。\n");
    }
    return v3;
}

int pai_compare(mixed arg1, mixed arg2) {
    if (check_kind(arg1) == check_kind(arg2)) {
        return check_rank(arg1) - check_rank(arg2);
    }
    if (check_kind(arg1) == current_round_kind) {
        return 1;
    }
    if (check_kind(arg2) == current_round_kind) {
        return -1;
    }
    return 0;
}

void game_finished() {
    tell_room(this_object(), "这一局结束了。\n");
    calculate_score();
    show_table(1);
    game_reset();
}

void game_reset() {
    mixed v1;
    game_status = 0;
    e_id = "no one";
    w_id = "no one";
    n_id = "no one";
    s_id = "no one";
    who_to_play = "no one";
    e_last = pai_size;
    w_last = pai_size;
    n_last = pai_size;
    s_last = pai_size;
    current_round_kind = "none";
    current_round_step = 0;
    for (v1 = 0; v1 < sizeof(current_round_ids); v1++) {
        current_round_ids[v1] = 53;
    }
    cao_double = 1;
    hong_double = 1;
    pig_double = 1;
    yang_double = 1;
    for (v1 = 0; v1 < 54; v1++) {
        pai_state[v1] = "i";
        pai_destination[v1] = "i";
    }
}

void check_finish(mixed arg) {
    if (arg != game_id) {
        return;
    }
    if (!game_status) {
        return;
    }
    tell_room(this_object(), "这一盘一直完不成，只好取消重来了。\n");
    game_reset();
}

void calculate_score() {
    mixed v1;
    mixed v2;
    mixed v3;
    e_score = 0;
    w_score = 0;
    n_score = 0;
    s_score = 0;
    for (v1 = 0; v1 < pai_size; v1++) {
        if (pai_destination[v1] == "e") {
            e_score += check_score(v1);
            continue;
        }
        if (pai_destination[v1] == "w") {
            w_score += check_score(v1);
            continue;
        }
        if (pai_destination[v1] == "n") {
            n_score += check_score(v1);
            continue;
        }
        if (pai_destination[v1] == "s") {
            s_score += check_score(v1);
        }
    }
    v2 = convert_to_id("cao", 10);
    if (pai_destination[v2] = "e") {
        e_score *= cao_double * 2;
    } else if (pai_destination[v2] = "w") {
        w_score *= cao_double * 2;
    } else if (pai_destination[v2] = "n") {
        n_score *= cao_double * 2;
    } else if (pai_destination[v2] = "s") {
        s_score *= cao_double * 2;
    }
    v3 = pai_destination[convert_to_id("hong", 1)];
    for (v1 = 2; v1 <= 13; v1++) {
        if (pai_destination[convert_to_id("hong", v1)] != v3) {
            return;
        }
    }
    if (v3 == "e") {
        e_score = -e_score;
    } else if (v3 == "w") {
        w_score = -w_score;
    } else if (v3 == "n") {
        n_score = -n_score;
    } else if (v3 == "s") {
        s_score = -s_score;
    }
}

void show_table(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    if (!arg) {
        v5 = "东家：";
        if (objectp(v1 = present(e_id, this_object())) && living(v1)) {
            v5 += v1->query("name") + "；";
        } else {
            v5 += "暂缺；";
        }
        v5 += "南家：";
        if (objectp(v1 = present(s_id, this_object())) && living(v1)) {
            v5 += v1->query("name") + "；";
        } else {
            v5 += "暂缺；";
        }
        v5 += "西家：";
        if (objectp(v1 = present(w_id, this_object())) && living(v1)) {
            v5 += v1->query("name") + "；";
        } else {
            v5 += "暂缺；";
        }
        v5 += "北家：";
        if (objectp(v1 = present(n_id, this_object())) && living(v1)) {
            v5 += v1->query("name") + "\n\n";
        } else {
            v5 += "暂缺。\n\n";
        }
        if (game_status == 1) {
            if (current_round_step) {
                v5 += "这一轮所出的牌：";
                for (v4 = 1; v4 <= current_round_step; v4++) {
                    if (current_round_ids[v4] < pai_size) {
                        v5 += pai_name[current_round_ids[v4]];
                    }
                }
                v5 += "\n";
            }
            if (objectp(v1 = present(who_to_play, this_object())) && living(v1)) {
                v5 += "下面该" + v1->query("name") + "出牌。\n\n";
            } else {
                v5 += "下面该???出牌。\n\n";
            }
        }
        write(v5);
    }
    v3 = 0;
    v5 = "已出的牌有：\n";
    for (v2 = 0; v2 < pai_size; v2++) {
        if (v2 == 13 || v2 == 26 || v2 == 39 || v2 == 52) {
            v5 += "\n";
            v3 = 0;
        }
        if (pai_state[v2] == "t") {
            v3++;
            v5 += pai_name[v2];
            if (v3 == 7 && v2 != 12 && v2 != 25 && v2 != 38 && v2 != 51) {
                v3 = 0;
                v5 += "\n";
            }
        }
    }
    if (arg) {
        tell_room(this_object(), v5 + "\n\n");
    } else {
        write(v5 + "\n\n");
    }
    v6 = "东家所得牌：\n";
    v7 = "西家所得牌：\n";
    v8 = "北家所得牌：\n";
    v9 = "南家所得牌：\n";
    for (v2 = 0; v2 < 52; v2++) {
        if (pai_destination[v2] == "e") {
            v6 += pai_name[v2];
            continue;
        }
        if (pai_destination[v2] == "w") {
            v7 += pai_name[v2];
            continue;
        }
        if (pai_destination[v2] == "n") {
            v8 += pai_name[v2];
            continue;
        }
        if (pai_destination[v2] == "s") {
            v9 += pai_name[v2];
        }
    }
    if (arg) {
        tell_room(this_object(), v6 + "\n");
        tell_room(this_object(), v9 + "\n");
        tell_room(this_object(), v7 + "\n");
        tell_room(this_object(), v8 + "\n");
    } else {
        write(v6 + "\n");
        write(v9 + "\n");
        write(v7 + "\n");
        write(v8 + "\n");
    }
}

void show_score() {
    if (!game_id) {
        write("拱猪还没开张，没有任何分数。\n");
        return;
    }
    if (game_status == 1) {
        write("拱猪正在进行，这一局的分数还没出来。\n");
        write("上一局的结果是：\n");
    } else {
        write("最新战况：\n");
    }
    write("东家：" + sprintf("%d", e_score) + "分。\n");
    write("南家：" + sprintf("%d", s_score) + "分。\n");
    write("西家：" + sprintf("%d", w_score) + "分。\n");
    write("北家：" + sprintf("%d", n_score) + "分。\n");
}

int do_leave() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    v1 = v2->query("id");
    if (v1 != e_id && v1 != w_id && v1 != n_id && v1 != s_id) {
        return notify_fail("你并没有参加拱猪。\n");
    }
    if (v1 == e_id) {
        e_id = "no one";
    } else if (v1 == w_id) {
        w_id = "no one";
    } else if (v1 == n_id) {
        n_id = "no one";
    } else if (v1 == s_id) {
        s_id = "no one";
    }
    message_vision("$N说道：对不起，你们找人接替吧，我不玩了。\n", v2);
    return 1;
}

int do_double(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v5 = this_player();
    v3 = v5->query("id");
    if (v3 != e_id && v3 != w_id && v3 != n_id && v3 != s_id) {
        return notify_fail("你并没有参加拱猪。\n");
    }
    if (!game_status) {
        return notify_fail("拱猪还没开始。\n");
    }
    v2 = 0;
    for (v1 = 0; v1 < pai_size; v1++) {
        if (pai_state[v1] == "t") {
            v2++;
        }
    }
    if (v2) {
        return notify_fail("太晚了。\n");
    }
    if (!arg || arg != "zhu" && arg != "z" && arg != "yang" && arg != "y" && arg != "hong" && arg != "h" && arg != "bian" && arg != "b") {
        return notify_fail("你要亮什么？\n");
    }
    if (v3 == e_id) {
        v4 = "e";
    } else if (v3 == w_id) {
        v4 = "w";
    } else if (v3 == n_id) {
        v4 = "n";
    } else if (v3 == s_id) {
        v4 = "s";
    }
    if (arg == "zhu" || arg == "z") {
        if (pai_state[convert_to_id("hei", 12)] == v4) {
            pig_double = 2;
            message_vision("$N奸笑了几声：嘿嘿，我有猪，你们得小心点。\n", v5);
            return 1;
        } else {
            return notify_fail("你手头并没有猪。\n");
        }
    } else if (arg == "yang" || arg == "y") {
        if (pai_state[convert_to_id("fang", 11)] == v4) {
            yang_double = 2;
            message_vision("$N兴奋地叫道：我有羊！\n", v5);
            return 1;
        } else {
            return notify_fail("别做梦了。\n");
        }
    } else if (arg == "hong" || arg == "h") {
        if (pai_state[convert_to_id("hong", 1)] == v4) {
            hong_double = 2;
            message_vision("$N大声道：现在我宣布，红心提价！\n", v5);
            return 1;
        } else {
            return notify_fail("你没有红心尖。\n");
        }
    } else if (arg == "bian" || arg == "b") {
        if (pai_state[convert_to_id("cao", 10)] == v4) {
            cao_double = 2;
            message_vision("$N躲在一边偷偷直笑：变压器的油可是加满了！\n", v5);
            return 1;
        } else {
            return notify_fail("你还是先弄个变压器再说吧。\n");
        }
    }
    return 1;
}

int do_start() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = 0;
    v3 = this_player();
    v4 = v3->query("id");
    if (game_status == 1) {
        return notify_fail("拱猪已经开始了。\n");
    }
    if (v4 != e_id && v4 != w_id && v4 != n_id && v4 != s_id) {
        return notify_fail("你还没坐下来呢。\n");
    }
    if (!objectp(v2 = present(e_id, this_object()))) {
        v1++;
    }
    if (!objectp(v2 = present(w_id, this_object()))) {
        v1++;
    }
    if (!objectp(v2 = present(n_id, this_object()))) {
        v1++;
    }
    if (!objectp(v2 = present(s_id, this_object()))) {
        v1++;
    }
    if (v1 > 0) {
        return notify_fail("还得找" + chinese_number(v1) + "个人才能开拱。\n");
    }
    game_status = 1;
    game_id++;
    call_out("check_finish", 1800, game_id);
    message_vision("$N大声宣布：拱猪正式开始！\n", v3);
    send_pai();
    who_to_play = v4;
    tell_room(this_object(), "下面由" + v3->query("name") + "开牌。\n");
    message_vision("$N问道：有亮相的没有？没有我可出牌了！\n", v3);
    current_round_step = 1;
    return 1;
}

void send_pai() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v1 = pai_size;
    for (v6 = 0; v6 < pai_size; v6++) {
        v2 = 0;
        if (v6 < 13) {
            v3 = "e";
        } else if (v6 < 26) {
            v3 = "w";
        } else if (v6 < 39) {
            v3 = "n";
        } else if (v6 < pai_size) {
            v3 = "s";
        } else {
            v3 = "t";
        }
        v7 = random(v1);
        v5 = 0;
        for (v4 = 0; v4 < pai_size; v4++) {
            if (pai_state[v4] == "i") {
                if (v5 == v7) {
                    if (!v2) {
                        pai_state[v4] = v3;
                        v1--;
                        v2 = 1;
                    }
                }
                v5++;
            }
        }
    }
}

int do_look(mixed arg) {
    if (arg == "table") {
        show_table(0);
        return 1;
    } else if (arg == "score") {
        show_score();
        return 1;
    } else {
        return 0;
    }
}

