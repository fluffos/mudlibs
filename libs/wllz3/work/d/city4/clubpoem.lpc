            message_vision("茶博士摇了摇头：好象不对吧？\n", v1);
            v1->add_temp("poem/wrong", 1);
            if (v1->query_temp("poem/wrong") > 10) {
                poem_penalty(v1);
            }
        }
    } else {
        write("现在没有人裁判对错了．．． ：（\n");
    }
    return 1;
}

