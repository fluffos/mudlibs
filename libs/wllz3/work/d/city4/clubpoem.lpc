            break;
        case 2:
            message_vision("$N疑道：是不是“" + arg + "”呀？\n", v1);
            break;
        }
        arg = replace_string(arg, " ", "");
        arg = replace_string(arg, ",", "");
        arg = replace_string(arg, "，", "");
        if (arg == current && sizeof(current) > 2) {
            if (ans_curr == 1) {
                write("已经有人答中了这句诗了，等茶博士再出题吧。\n");
                return 1;
            }
            ans_curr = 1;
            index = length - 1;
            v1->set_temp("poem/index", poem_index);
            poem_reward(v1, current_all);
        } else if (arg == last && sizeof(last) > 2) {
            if (ans_last == 1) {
                write("已经有人答中了这句诗了，等茶博士再出题吧。\n");
                return 1;
