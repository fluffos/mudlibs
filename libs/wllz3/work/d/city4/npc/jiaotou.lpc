inherit "/inherit/char/npc";
int ask_reclusion();
int do_skills(mixed);
int recognize_apprentice(mixed);
int accept_object(mixed, mixed);
int do_reclusion();

void create() {
    set_name("教头", ({ "jiao tou", "master", "jiao" }));
    set("long", "他是武馆的教头。高大威猛，看起来好象身手不凡的样子。\n");
    set("attitude", "friendly");
    set("gender", "男性");
    set("age", 45);
    set("level", 70);
    set("shen_type", 1);
    set("env/wimpy", 30);
    set_skill("spear", 200);
    set_skill("chixie-qiang", 200);
    set_skill("unarmed", 200);
    set_skill("force", 200);
    set_skill("parry", 100);
    set_skill("dodge", 100);
    set_skill("perception", 100);
    set_skill("apply-sword", 600);
    set_skill("apply-blade", 600);
    set_skill("apply-spear", 600);
    set_skill("apply-staff", 600);
    set_skill("apply-whip", 600);
    set_skill("apply-club", 600);
    set_skill("apply-hammer", 600);
    set_skill("apply-throwing", 600);
    map_skill("spear", "chixie-qiang");
    map_skill("parry", "chixie-qiang");
    set("inquiry", ([ "学费" : "嗯....知识是无价的，不过如果你有心的话——只要十两银子。\n", "金盆洗手" : (: ask_reclusion() :), "退隐江湖" : (: ask_reclusion() :) ]));
    setup();
    carry_object("/clone/misc/cloth")->wear();
    carry_object("/clone/weapon/changqiang")->wield();
    add_money("silver", 10);
}

void init() {
    add_action("do_skills", "skills");
    add_action("do_skills", "cha");
    add_action("do_reclusion", "reclusion");
}

int do_skills(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!id(arg) || !v1->query_temp("mark/教头")) {
        return 0;
    }
    tell_object(v1, name() + "说道：你可以从我这里学习以下这些武功：\n\n");
    write("教头目前共学会了十五种技能\n────────────────────────────────＝>\n【知识技能】\n────────────────────────────────＝>\n  御刀技巧(apply-blade)             等级 600  下次升级 361202 点\n  御棍技巧(apply-club)              等级 600  下次升级 361202 点\n  御轮技巧(apply-hammer)            等级 600  下次升级 361202 点\n  御枪技巧(apply-spear)             等级 600  下次升级 361202 点\n  御杖技巧(apply-staff)             等级 600  下次升级 361202 点\n  御剑技巧(apply-sword)             等级 600  下次升级 361202 点\n  御镖技巧(apply-throwin"
            "g)          等级 600  下次升级 361202 点\n  用鞭技巧(apply-whip)              等级 600  下次升级 361202 点\n────────────────────────────────＝>\n【武学技能】\n────────────────────────────────＝>\n□赤蟹枪法(chixie-qiang)            等级 200  下次升级  40402 点\n  基本轻功(dodge)                   等级 100  下次升级  10202 点\n  基本内功(force)                   等级 200  下次升级  40402 点\n  基本招架(parry)                   等级 100  下次升级  10202 点\n  基本枪法(spear)                   等级 200  下次升级  40402 点\n  基本拳脚"
            "(unarmed)                 等级 200  下次升级  40402 点\n────────────────────────────────＝>\n【特殊技能】\n────────────────────────────────＝>\n  听风辨器(perception)              等级 100  下次升级  10202 点\n────────────────────────────────＝>\n");
    return 1;
}

int recognize_apprentice(mixed arg) {
    if (!arg->query_temp("mark/教头")) {
        say(this_object()->query("name") + "说道：咦？我不记得收过你这个学生啊....\n");
        return 0;
    }
    arg->add_temp("mark/教头", -1);
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    if (!arg1->query_temp("mark/教头")) {
        arg1->set_temp("mark/教头", 0);
    }
    if (arg2->query("money_id") && arg2->value() >= 1000) {
        say(this_object()->query("name") + "点了点头，说道：很好，" + "从今天起你随时可以来向我学习各种粗浅功夫。\n");
        arg1->add_temp("mark/教头", arg2->value() / 10);
        return 1;
    }
}

int ask_reclusion() {
    mixed v1;
    v1 = this_player();
    if (!v1->valid_attack()) {
        say(name() + "振振有词的说道：退隐江湖的时候，我们会发布通告，告知天下英雄。\n");
        return 1;
    }
    if (v1->query("mud_age") - v1->query("combat/valid_time") < 86400) {
        say(name() + "说道：你投身江湖还不足一年，怎么那么快就退隐江湖啦？\n");
        return 1;
    }
    if (v1->query("combat/ready_kill")) {
        say(name() + "说道：如何？我和你说的事，你做了吗？\n");
        return 1;
    }
    if (v1->query("combat/ready_reclusion")) {
        say(name() + "说道：给我五百两，我就帮你发下江湖帖，通告天下。\n");
        return 1;
    }
    if (v1->query("combat/good_task")) {
        message_vision("$N对$n大为赞赏：好！" + "/adm/daemons/rankd"->query_respect(v1) + "果然名不虚传。\n$N又道：我现在就帮你准备退隐江湖的一切费用。说完掐指一算，\n说道：一共需要五百两黄金，如果你准备好了，请输入 (\e" + "[1;37mreclusion\e" + "[2;37;0m)。\n", this_object(), v1);
        v1->delete("combat/good_task");
        v1->set("combat/ready_reclusion", 1);
        return 1;
    } else {
        say(name() + "振振有词的说道：要退隐江湖，你得先去做一件轰轰烈烈的大事。\n那我才可以帮你发下江湖帖，通告天下人。\n");
        say("\e[31m" + name() + "在你耳边悄悄说道：长安城外，有一伙强盗，经常进城里烧杀抢掠。\n为祸百姓，你去把他们的头子杀了。这样，既可造福百姓，又能帮你光荣退隐。\n\e" + "[2;37;0m");
        v1->set("combat/ready_kill", 1);
        tell_object(v1, "\e[1;36m你想想，" + name() + "的话未尝没有道理，于是决定动身前往长安城外，剿灭强盗。\n\e" + "[2;37;0m");
        return 1;
    }
}

int do_reclusion() {
    mixed v1;
    v1 = this_player();
    if (!v1->query("combat/ready_reclusion")) {
        return 0;
    }
    if (!"/adm/daemons/moneyd"->player_pay(v1, 5000000)) {
        message_vision("$N疑惑的看着$n道：你身上的钱，似乎还不够啊。\n", this_object(), v1);
        return 1;
    }
    message_vision("\e[1;33m$N点了点头，说道：好，江湖帖我已经帮你准备好了，我现在就帮\n你发出去。你从今天开始便退隐江湖，从此江湖一切恩怨与你无关！\n\e[2;37;0m", this_object());
    "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s金盆洗手，不问世事，从此退隐江湖！", v1->name()));
    v1->set("combat/status", 0);
    v1->delete("combat/ready_reclusion");
    return 1;
}
