    }
    arg->add_temp("marks/教书先生", -1);
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    if (!arg1->query_temp("marks/教书先生")) {
        if (arg2->value() >= 1000) {
            command("nod " + arg1->query("id"));
            command("say 很好，从今天起你随时可以来问我有关读书识字(literate)的任何问题。");
            arg1->add_temp("marks/教书先生", arg2->value() / 10);
            return 1;
        } else {
            command("hehe " + arg1->query("id"));
            command("say 你的诚意不够，这钱还是拿回去吧。");
            return 0;
        }
    } else {
        command("nod " + arg1->query("id"));
        command("say 哦，象你这麽有心的学生还真是不多见，好好努力将来必定前途无量，谢了。");
    }
    return 1;
}
