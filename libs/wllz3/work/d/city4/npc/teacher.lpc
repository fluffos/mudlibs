int recognize_apprentice(mixed arg) {
    if (!arg->query_temp("marks/教书先生")) {
        tell_object(arg, "\e[36m教书先生露出迷惑的表情。\n");
        tell_object(arg, "\e[36m教书先生说道：咦？我不记得收过你这个学生啊....\n\e[2;37;0m");
