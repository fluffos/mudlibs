        }
        if (!is_chinese(arg[v4..v4])) {
            return notify_fail("吴凡通说道：对不起，请您用「中文」取名字。\n");
        }
    }
    if ("/adm/daemons/moneyd"->player_pay(v2, 8000000) != 1) {
        return notify_fail("吴凡通摇了摇头，说道：客官，您还是先交了工钱再说吧？\n");
    }
    say(sprintf("吴凡通殷勤的说道：好好好，现在就让伙计帮你缝制，客官您稍等。说完\n将%s交给内堂的伙计，并吩咐道：你现在赶紧把这手套做好，客官在外\n头等着呢。约过了半盏茶功夫，只见内堂伙计捧出一双做工精致的%s，\n交到你手中。吴凡通说道：客官，这是您定做的手套，你可收好了。\n", v1["marther"], arg));
    v3 = clone_object("/clone/item/wrists");
    v3->set("name", arg);
    v3->set("owner_name", v2->name(1));
    v3->set("owner_id", v2->query("id"));
    v3->set("level", 1);
    v3->set("marther_name", v1["marther"]);
    v3->set("time", "/adm/daemons/natured"->game_time());
    v3->save();
    v3->set_owner(v2->name(1), v2->query("id"));
    v3->move(v2, 1);
    v2->delete_temp("wrists");
    v2->delete_temp("ready_made_wrists");
    v2->set("item/wrists", 1);
    message_vision("$N接过" + v3->name() + "，点点头满意的付了钱。\n", v2);
    return 1;
}

