            say("吴凡通说道：嗯。材料已经齐了，那现在就开始吧。客官打算给您\n的手套取个什么名字「\e[37mmake 手套名字\e[2;37;0m」？我让伙计们帮你缝上去。\n");
            v1->set_temp("ready_made_wrists", 1);
            return 1;
        }
    }
    v2 = ([ ]);
    v2["marther"] = v3[random(sizeof(v3))];
    v2["inlay"] = random(45) + 80;
    v1->set_temp("wrists", v2);
    say("吴凡通得意的笑道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "可真是识货啊，本店缝制的手套既轻巧，又\n坚韧；做工精致，独一无二。不过现在庄里的材料用完了，您要是急的话，\n就去找一些" + v2["marther"] + "来，价钱方面嘛，我就算便宜一些，800 两黄金。\n");
    return 1;
}

int do_make(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v2 = this_player();
    if (!v2->query_temp("ready_made_wrists")) {
        return 0;
    }
    if (!mapp(v1 = v2->query_temp("wrists"))) {
        return 0;
    }
    if (!arg || arg == "") {
        return notify_fail("吴凡通问道：您打算给手套取个什么名字？\n");
    }
    if (sizeof(arg) > 4 || sizeof(arg) < 1) {
        return notify_fail("吴凡通说道：你取的名字太长了，想一个短一点的吧。\n");
    }
