void create() {
    set_name("马夫", ({ "ma fu", "seller" }));
    set("long", "他是这里的马夫，正在细心的照料马匹。\n");
    set("attitude", "friendly");
    set("gender", "男性");
    set("age", 36);
    set("level", 20);
    set("shen_type", 1);
    set("env/wimpy", 30);
    set("inquiry", ([ "买马" : (: buy_horse :), "改名" : (: ask_change_name :), "卖马" : (: sell_horse :) ]));
    set("vendor_goods", ([ "/clone/horse/horse" : 1, "/clone/horse/horse_1" : 1, "/clone/horse/horse_2" : 1, "/clone/horse/horse_3" : 1, "/clone/horse/horse_4" : 1, "/clone/horse/horse_5" : 1 ]));
    setup();
    carry_object("/clone/cloth/cloth")->wear();
    add_money("silver", 1);
}

void init() {
    mixed v1;
