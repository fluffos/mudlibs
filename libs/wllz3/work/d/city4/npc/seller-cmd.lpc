    if (interactive(v1 = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
    add_action("do_vendor_list", "list");
    add_action("make_horse", "make");
    add_action("change_horse_name", "改");
    add_action("do_decide", "decide");
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    switch (random(1)) {
    case 0:
        say(this_object()->query("name") + "笑咪咪地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，想挑一匹快马吗？\n");
        break;
    }
}

int buy_horse() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = this_object();
    if (v1->query("item/horse")) {
        message_vision("$N疑惑道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "不是已经有你的坐骑吗？\n", v2);
        return 1;
    }
    if (!v1->is_member()) {
        message_vision("$N说道：对不起，只有会员才可以买马。\n", v2);
        return 1;
    }
    say("马夫慢条斯理的说道：本店现有中程马一匹，可日行百里，每匹 2000 两\n黄金。你若是要的话，就给钱吧！\n");
    v1->set_temp("ask_buy_horse", 1);
    return 1;
}

int make_horse(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (v1->query("item/horse")) {
        say("马夫疑道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "不是已经有你的坐骑吗？\n");
        return 1;
    }
    if (!v1->query_temp("make_horse_money")) {
        say("马夫疑道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "好象还没下定金呢？\n");
        return 1;
    }
    if (!arg || arg == "") {
        return notify_fail("马夫说道：你要给你的马匹起个什么名字？\n");
    }
    if (sizeof(arg) > 4 || sizeof(arg) < 1) {
        return notify_fail("马夫说道：你取的名字太长了，想一个短一点的吧。\n");
    }
    v3 = sizeof(arg);
    while (v3--) {
        if (arg[v3] <= 32) {
            return notify_fail("马夫说道：对不起，你的中文名字不能用控制字元。\n");
        }
        if (!is_chinese(arg[v3..v3])) {
            return notify_fail("马夫说道：对不起，请您用「中文」取名字。\n");
        }
    }
    if ("/adm/daemons/named.lpc"->invalid_new_name(arg)) {
        say("马夫摇了摇头，笑道：拿人家的名字来为你的坐骑命名？这可不行。\n马匹命名只能一次，你可要考虑清楚呀。\n");
        return 1;
    }
    message_vision("$N点了点头，笑道：好吧，这位" + "/adm/daemons/rankd"->query_respect(v1) + "请稍等，俺这就给您牵来。\n$N转身走进马房，不一会儿就牵出了一匹骏马。\n", this_object());
    v2 = clone_object("/clone/item/horse");
    v2->set("name", arg);
    v2->set("owner_name", v1->name(1));
    v2->set("owner_id", geteuid(v1));
    v2->set("horse_prop/brawn", 100);
    v2->set("horse_prop/max_life", 100);
    v2->set("horse_prop/loyalty", 75);
    v2->set("horse_prop/life", 100);
    v2->save();
    v2->set_owner(v1->name(1), geteuid(v1));
    v2->move(v1, 1);
    message_vision("$N得到了一匹" + arg + "\e" + "[2;37;0m。\n", v1);
    v1->set("item/horse", 1);
    v1->set_temp("item/horse", v2);
    v1->delete_temp("make_horse_money");
    v1->delete_temp("ask_buy_horse");
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    if (!arg1->query_temp("ask_buy_horse") && !arg1->query_temp("ask_change_horse_name")) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg1) + "没事拿钱给我花？这可真是太好了。");
        return 1;
    }
    if (arg2->query("money_id")) {
        if (arg1->query_temp("ask_buy_horse") && arg2->value() >= 20000000) {
            command("nod");
            command("say 那好吧，请先为你的马匹命名：make 马匹的中文名");
            arg1->set_temp("make_horse_money", 1);
            return 1;
        }
        if (arg1->query_temp("ask_change_horse_name") && arg2->value() >= 2000000) {
            command("nod");
            command("say 好吧，请输入：改 马匹的中文名字。");
            arg1->set_temp("give_change_horse_money", 1);
            return 1;
        }
    }
    command("say 你给我这个干什么？！");
    return 0;
}

