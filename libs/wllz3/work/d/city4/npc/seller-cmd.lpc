int sell_horse() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!v1->query("item/horse")) {
        say(name() + "说道：等等，我看看帐簿。说完，转身拿出一本小册子翻了翻，半天\n才对你说道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "，你可还没买马呢！\n");
