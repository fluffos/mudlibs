inherit "/inherit/room/room";
void create();
void init();
int do_enter(mixed);
void home(mixed);

void create() {
    set("short", "海滩");
    set("long", "这里就是神龙岛了。南边是一望无际的大海；往北则是一片灌木林。\r\n岛上的空气似乎又热又闷, 咸湿的海风中带着一股腥臭, 又夹杂了一缕奇\r\n特的花香, 闻起来十分怪异。海边泊着一艘大船(chuan)。\r\n");
    set("item_desc", ([ "chuan" : "这是灵蛇岛对外联系的大船。岛上的客人或弟子只要\n上船(enter)就可以回中原。\n" ]));
    set("exits", ([ "north" : "/d/shenlong/lin1" ]));
    set("outdoors", "shenlong");
    setup();
}

void init() {
    add_action("do_enter", "enter");
}

int do_enter(mixed arg) {
    mixed v1;
    if (!arg || arg != "chuan") {
        tell_object(this_player(), "你要 enter 哪儿？\n");
        return 1;
    }
    v1 = this_player();
    message_vision("船夫一见有人上船，忙叫了一声：开船喽！\n", v1);
    message_vision("船夫升起帆，船就向西方航行。\n", v1);
    v1->move("/d/shenlong/dahai");
    tell_object(v1, "\e[34m你在海上航行了很久很久.......\n\e[2;37;0m");
    call_out("home", 10, v1);
    return 1;
}

void home(mixed arg) {
    if (!arg || !environment(arg)->query("boat")) {
        return;
    }
    tell_object(arg, "大船终于抵达了中原的一个繁华城市。你走下船来。\n");
    arg->move("/d/city2/haigang");
}
