int force_open(mixed arg) {
    if (!objectp(arg)) {
        return 0;
    }
    if (arg->query_temp("person_inside") <= 0) {
        return 0;
    }
    arg->delete_temp("person_inside");
    set("exits/east", "/d/taohua/xiuxishi");
    arg->set("exits/west", "/d/taohua/siguoshi.lpc");
    message("vision", "外面突然响起粗重的脚步声，由远而近，到门前停了下来．．．\n梅超风啪地把门打开，伸个头进来，一脸狐疑：呆大半天了还不出去，搞什么鬼？\n", arg);
