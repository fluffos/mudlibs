void create() {
    set("short", "思过室");
    set("long", "这是桃花岛上供本门弟子闭门思过的地方。屋里仅仅放着一张床，显\n得空荡荡的。四面则是光秃秃的墙壁，看上去黑黝黝的，原来却是铁筑的\n。靠门的地方有一小洞，洞边放着一只碗。往东是一间不起眼的小屋，门\n上挂了个牌子「桃花轩」。\n");
    set("exits", ([ "west" : "/d/taohua/houyuan" ]));
    set("objects", ([ "/d/taohua/npc/mei" : 1 ]));
