}

int close_men() {
    mixed v1;
    if (!(v1 = find_object("/d/taohua/xiuxishi"))) {
        v1 = find_object("/d/taohua/xiuxishi", 1);
    }
    if (objectp(v1)) {
        delete("exits/east");
        message("vision", "门吱吱呀呀地自己合上了。\n", this_object());
        v1->delete("exits/west");
        message("vision", "门吱吱呀呀地自己合上了。\n", v1);
    } else {
        message("vision", "ERROR: men not found(close).\n", v1);
    }
}

int do_knock(mixed arg) {
    mixed v1;
    if (query("exits/east")) {
        return notify_fail("大门已经是开着了。\n");
    }
    if (!arg || arg != "door" && arg != "men") {
        return notify_fail("你要敲什么？\n");
