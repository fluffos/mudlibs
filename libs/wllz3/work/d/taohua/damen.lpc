    set("item_desc", ([ "diao" : "一对白雕正展翅欲飞。如果是桃花岛的弟子，\n骑上(ride)就可以飞到中原。\n" ]));
    set("objects", ([ "/d/taohua/npc/shitong" : 2, "/kungfu/class/taohua/feng" : 1, "/kungfu/class/taohua/master_taohua" : 1 ]));
    set("outdoors", "taohua");
    setup();
}

void init() {
    add_action("do_ride", "ride");
}

int do_ride(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (arg != "diao") {
        return 0;
    }
    v1 = v2->query("family");
    if (!v1 || v1["family_name"] != "桃花岛") {
        message_vision("$N一跃身跨上了白雕。只见白雕仰天长唳，突然猛然一颠......\n\e[1;31m结果$N摔了个鼻青脸肿！\n\e[2;37;0m看来白雕对$N并不感兴趣，它只认识桃花岛的弟子。\n", v2);
        v2->receive_damage("qi", 50);
        return 1;
    }
    if (query("sb_ride")) {
        return notify_fail("现在白雕正忙着,请过一会再乘坐！\n");
    }
    add("sb_ride", 1);
    message_vision("$N一跃身跨上了白雕。只见白雕仰天长唳，突然展翅高飞。\n\n但看一雕一人身形渐渐缩小，终至不见。\n", v2);
    v2->move("/d/taohua/lantian");
    tell_object(v2, "\e[36m\n你不断地飞呀飞，万水千山身下飘过 ......\n\n\e[2;37;0m");
    call_out("taohua", 3, v2);
    add("sb_ride", -1);
    return 1;
}

