void create() {
    set("short", "桃花山庄正门");
    set("long", "这里是桃花山庄的正门。门前疏落有致地种了几株桃花树，更显得此\n地主人对桃花的偏爱。门口站着两个小童看守大门。看来由于地处边远，\n人烟罕至，人们对山庄的防卫不是特别谨慎。门前有一对白雕(diao)。\n");
    set("outdoors", "taohua");
