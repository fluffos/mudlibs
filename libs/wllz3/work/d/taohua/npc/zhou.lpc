int jie_bai() {
    mixed v1;
    v1 = this_player();
    if (v1->query("gender") != "男性") {
        message_vision("老顽童上上下下打量了$N一番，说到：我生平不喜同两种人\n打交道：一是女人，二是太监。我看你还是趁早请罢！”\n", v1);
        return 1;
