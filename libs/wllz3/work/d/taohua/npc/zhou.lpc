    if (v1->query("attributive/att") != "土") {
        message_vision("老顽童摇了摇头，对$N说道：你我属性不合，去去去。\n", v1);
        return 1;
    }
    if (v1->query("shen") < -1000) {
        say("老顽童哼了一声说：就凭你这种恶人也配与我称兄道弟？！\n");
        return 1;
    }
    say("老顽童高兴地说：好！以后我们就是好兄弟了！\n");
    tell_object(v1, "\e[36m周伯通悄悄对你说：老哥哥有一套「双手互搏之术」和一路\n「空明拳」可以传给你作为见面礼哟！\n\e[2;37;0m");
    v1->set_temp("wantong/兄弟", 1);
    return 1;
}

