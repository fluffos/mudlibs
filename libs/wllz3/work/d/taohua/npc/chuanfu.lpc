int chu_hai() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query("family/family_name") == "桃花岛") {
        message_vision("老船夫一招手，叫来几个年轻船夫。\n", v1);
        message_vision("年轻船夫和$N上了船，一声「起锚」船就开走了，但老船夫却没上船......\n", v1);
        v2 = environment(v1);
        v1->move("/d/taohua/dahai");
        tell_object(v1, "\e[34m你在海上航行了很久很久.......\n\e[2;37;0m");
        call_out("goto_taohua", 10, v1);
        return 1;
    } else {
        message_vision("老船夫上上下下打量了$N一下：什么！出海？你不要命了？！\n老船夫又想了一下：不过...如果给我一两金子，或许可以考虑。\n", v1);
    }
    v1->set_temp("出海", 1);
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg1->query_temp("出海")) {
        message_vision("老船夫笑着对$N说：无功不受禄，您还是自己留着吧！\n", arg1);
        return 0;
    }
    if (arg2->query("money_id") && arg2->value() >= 10000) {
        message_vision("老船夫对$N说：好！救然这位" + "/adm/daemons/rankd"->query_respect(arg1) + "如此看得起我，\n那我也拼上这条破船，舍命陪君子便了！\n", arg1);
        this_player()->delete_temp("出海");
        message_vision("老船夫一招手，叫来几个年轻船夫。\n", arg1);
        message_vision("年轻船夫和$N上了船，一声「起锚」船就开走了，但老船夫却没上船......\n", arg1);
        v1 = environment(arg1);
        arg1->move("/d/taohua/dahai");
        tell_room(v1, "老船夫看船走了，掂着手里的金子笑了：去桃花岛？送死的事情我可不干。\n只可惜我那几个听话的船夫，要被那帮人给吃掉了。嘿嘿，哈哈！\n");
        tell_object(arg1, "\e[34m你在海上航行了很久很久.......\n\e[2;37;0m");
        call_out("goto_taohua", 10, arg1);
        return 1;
    } else {
        message_vision("老船夫皱眉对$N说：您给的也太少了吧？\n", arg1);
    }
    return 0;
}

void goto_taohua(mixed arg) {
    if (!arg) {
        return;
    }
    tell_object(arg, "大船终于停在了一个小岛边。你走下船来。\n");
    arg->move("/d/taohua/haitan");
}
