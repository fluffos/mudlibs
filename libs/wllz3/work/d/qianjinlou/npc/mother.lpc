void greeting(mixed arg) {
    if (!arg || environment() != environment(arg)) {
        return;
    }
    if (arg->query("gender") != "女性") {
        say(name() + "尖着嗓子往内喊：楼上的姑娘丫环们，快下来接客啦～～～\n");
