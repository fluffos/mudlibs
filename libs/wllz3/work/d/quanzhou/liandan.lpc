void create() {
    set("short", "练胆石");
    set("long", "这是立崖上的一方窄石(stone)， 正处风口。人立其上，但觉狂风撕\n扯，面如刀割，头晕目眩，摇摇欲坠。相传这是明朝抗倭英雄俞大猷少年\n时的练胆石，上有他题刻的「恩重如山」四个字。\n");
    set("exits", ([ "northwest" : "/d/quanzhou/mituo", "eastdown" : "/d/quanzhou/shanlu2" ]));
    set("item_desc", ([ "stone" : "只见窄石耸立在崖上，任狂风暴哮始终不倒，你不禁感叹造物之奇。\n" ]));
    set("outdoors", "quanzhou");
    setup();
}

void init() {
    add_action("do_climb", "climb");
    add_action("do_climb", "pa");
}

int do_climb(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "stone") {
        return 0;
    }
    if (v1->query_temp("marks/climb")) {
        return notify_fail("你还未从石上下来，着急什么？\n");
    }
    message_vision("$N颤颤惊惊地爬上练胆石，马上被风吹得东摇西摆，随时可能失足！\n", v1);
    if (random(v1->query_kar()) < 2) {
        message_vision("突然间狂风大作，$N一个支持不住，发出一声惨呼失足跌下练胆石！\n", v1);
        v1->receive_wound("qi", v1->query("max_qi") + 100, "被狂风吹落山石跌死了");
    } else if (random(v1->query_kar()) < 8 && v1->query_skill("dodge") < 30) {
        message_vision("突然间狂风大作，$N一个支持不住，发出一声惨呼失足跌下练胆石！\n", v1);
        v1->unconcious();
    } else if (random(v1->query_kar()) < 8) {
        message_vision("突然间狂风大作，$N被风吹得东摇西摆，随时可能失足跌下！\n", v1);
        v1->receive_damage("qi", 50, "被狂风吹落山石跌死了");
        v1->receive_damage("jing", 50, "被狂风吹落山石跌死了");
    }
    if (living(v1)) {
        v1->receive_damage("qi", 50, "被狂风吹落山石跌死了");
        v1->receive_damage("jing", 20, "被狂风吹落山石跌死了");
    }
    if (v1->query("potential") < 500 && random(5) == 1) {
        v1->add("potential", 1);
    }
    call_out("check", 1, v1);
    v1->set_temp("marks/climb", 1);
    return 1;
}

int check(mixed arg) {
    if (!arg->is_ghost() && living(arg)) {
        message_vision("$N一会儿便抵受不住，只好小心翼翼地爬了下来。\n", arg);
    } else {
        message_vision("$N发出一声凄历的惨呼，失足跌下练胆石！\n", arg);
    }
    arg->delete_temp("marks/climb");
    return 1;
}

int valid_leave(mixed arg1, mixed arg2) {
    if (arg1->query_temp("marks/climb")) {
        return notify_fail("你还未从石上下来呢！\n");
    }
    return ::valid_leave(arg1, arg2);
}
