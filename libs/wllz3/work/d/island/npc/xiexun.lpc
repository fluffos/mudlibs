int ask_for_dao() {
    mixed v1;
    v1 = this_player();
    command("shout");
    command("stare " + v1->name());
    command("say " + "/adm/daemons/rankd"->query_rude(v1) + "既然已知道屠龙刀在我手中，乖乖受死吧！\n");
    if (present("tulong dao", this_object())) {
        command("wield tulong dao");
    }
    kill_ob(v1);
    return 1;
}

int ask_for_book() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = clone_object("/clone/book/qs-jing");
    if (!v1->query_temp("xiexun_thank")) {
        command("grin " + v1->name());
        command("stare " + v1->name());
        command("say " + "/adm/daemons/rankd"->query_rude(v1) + "既然已知道七伤拳经在我手中，就尝尝七伤拳的厉害吧！");
        kill_ob(v1);
    } else if (v2 && query("give_book") > 0) {
        v2->move(v1);
        add("give_book", -1);
        command("say 谢某大仇已报，此生已再无牵挂，这本七伤拳经对我已无大用，" + "/adm/daemons/rankd"->query_respect(v1) + "若看得起，尽管取去无妨！");
        message_vision("谢逊给$N一本" + v2->query("name") + "。\n", v1);
        "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s得到了%s啦！", v1->name(1), v2->name(1)));
    } else {
        command("say 实在对不住，七伤拳经已经不在我这里了！");
    }
    return 1;
}

int accept_kill(mixed arg) {
    if (present("tulong dao", this_object())) {
        command("wield tulong dao");
    }
    kill_ob(arg);
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->query("name") == "\e[31m成昆的人头\e[2;37;0m" && arg1->query_temp("kill_chengkun")) {
        command("ah");
        command("shout");
        command("say " + "/adm/daemons/rankd"->query_respect(arg1) + "武功果然高明，使谢某报此血海深仇，若有所求，谢某肝脑涂地，在所不辞！\n");
        arg1->set_temp("xiexun_thank", 1);
        return 1;
    } else if (arg2->query("name") == "\e[31m成昆的人头\e[2;37;0m" && !arg1->query_temp("kill_chengkun")) {
        command("slap " + arg1->query("id"));
        command("say 老夫眼虽盲了，心却是不盲！");
        if (present("tulong dao", this_object())) {
            command("wield tulong dao");
        }
        kill_ob(arg1);
    }
}
