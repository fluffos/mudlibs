    v2 = 0;
    if (!query("fire_ready")) {
        return notify_fail("火侯未到！\n");
    }
    if (v1->query("neili") < 5000) {
        return notify_fail("你的内力不足！\n");
    }
    v3 = query("cure_s");
    v4 = query("cure_d");
    v5 = query("cure_n");
    if (wizardp(v1)) {
        printf("%d\t%d\t%d\t\n\n--------------------\n", v3, v4, v5);
    }
    for (v9 = 0; v9 < sizeof(drug_list); v9++) {
        v6 = drug_list[v9]["s"];
        v7 = drug_list[v9]["d"];
        v8 = drug_list[v9]["n"];
        if (wizardp(v1)) {
            printf("%d\t%d\t%d\t\n", v6, v7, v8);
        }
        if (v3 == v6 && v4 == v7 && v5 == v8) {
            set("drug", drug_list[v9]["file"]);
            v2 = drug_list[v9]["time"];
            break;
        }
    }
    message_vision("\e[1;36m$N暗运内功，将内力运至手掌，向青铜古鼎逼了过去，\n\e[2;37;0m", v1);
    message_vision("\e[1;31m\n$N不停的运功，一会儿已是满身大汗。\n\e[2;37;0m", v1);
    message_vision("\e[1;31m\n青铜古鼎里的药物随着$N不停的运功，散发出一阵阵浓浓的药味。\n\e[2;37;0m", v1);
    if (!v2) {
        v2 = 20;
    }
    if (v2 > 30) {
        v1->start_busy(v2 - random(5));
    } else {
        v1->start_busy(v2 / 2);
    }
    set("pending", 1);
    remove_call_out("finish");
    call_out("finish", v2, v1);
    return 1;
}

void finish(mixed arg) {
    mixed v1;
    v1 = this_object();
    if (arg->query("shen") > -10000 || arg->query_skill("wudu-xinfa", 1) < 180 || arg->query_skill("poison", 1) < 180) {
        arg->receive_damage("qi", 500);
        write("你的驭毒技能太低，反被散发了来的药性所伤。\n");
        return;
    } else {
        message_vision("\n\e[1;33m$N深吸一口气，停了下来。\n\e[2;37;0m", arg);
        arg->add("neili", -(1700 - random(500)));
        set("done", 1);
        set("pending", 0);
    }
}

