inherit "/inherit/room/room";
void create();
void init();
int do_yell(mixed);
int du_jiang();

void create() {
    set("short", "太湖");
    set("long", "太湖古称五湖，襟带三州，周行五百里，东南之水皆归于此。其时但\r\n见长天无波，放眼皆碧，七十二峰苍翠挺立于三万六千顷波涛之中，不觉\r\n令人心怀大畅。由此登船可前往太湖之中的归云庄。\r\n");
    set("outdoors", "guiyun");
    set("exits", ([ "north" : "/d/guiyun/shanlu1" ]));
    set("objects", ([ "/d/guiyun/npc/xiaolu" : 1 ]));
    setup();
}

void init() {
    add_action("do_yell", "yell");
    add_action("du_jiang", "dujiang");
}

int do_yell(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "boat") {
        arg = "船家";
    }
    if (v1->query("age") < 16) {
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n", v1);
    } else if (v1->query("neili") > 500) {
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传了出去。\n", v1);
    } else {
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n", v1);
    }
    if (arg == "船家") {
        "/adm/daemons/transd"->check_boat(base_name(this_object()));
        return 1;
    } else {
        message_vision("湖面上远远传来一阵回声：“" + arg + "～～～”\n", v1);
    }
    return 1;
}

int du_jiang() {
    mixed v1;
    v1 = this_player();
    if (!living(v1)) {
        return 0;
    }
    if (v1->query_skill("dodge") < 150) {
        return notify_fail("你的轻功修为太差，无法施展一苇渡江。\n");
    }
    tell_room(environment(v1), "\e[1;32m" + v1->name() + "捡起一段芦苇抛入水中，紧跟着飞身跃上芦苇，长袖飘飘，渡过了太湖。\n\e" + "[2;37;0m", ({ v1 }));
    write("你使出「一苇渡江」渡过了太湖。\n");
    v1->move("/d/guiyun/matou");
    tell_room(environment(v1), "\e[1;32m只见" + v1->name() + "踩着一段芦苇从对岸过来，姿态潇洒地落在岸边。\n\e" + "[2;37;0m", ({ v1 }));
    return 1;
}
