}

int do_ride() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_player();
    v1 = v3->query("family");
    if (!v1 || v1["family_name"] != "桃花岛") {
        message_vision("$N一跃身跨上了白雕。只见白雕仰天长唳，突然猛然一颠......\n\e[1;31m结果$N摔了个鼻青脸肿！\n\e[2;37;0m看来白雕对$N并不感兴趣，它只认识桃花岛的弟子。\n", v3);
