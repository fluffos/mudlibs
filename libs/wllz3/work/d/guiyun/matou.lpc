inherit "/inherit/room/room";
void create();
void init();
int do_yell(mixed);
int do_shang(mixed);
void rjinbing(mixed);
int du_jiang();

void create() {
    set("short", "码头");
    set("long", "这是一个在江南水乡极常见的码头，由粗糙的大青条石搭成。北面似\r\n乎有一个极大的庄院。靠岸停有一艘大渔船(ship)，大篷斜挂，风帆大张\r\n，看那样子不是为了出湖，倒象是征战用的。\r\n");
    set("outdoors", "guiyun");
    set("item_desc", ([ "ship" : "这是太湖水盗劫富济贫的战船。上去(shang ship)就出发。\n" ]));
    set("exits", ([ "north" : "/d/guiyun/damen" ]));
    setup();
}

void init() {
    add_action("do_yell", "yell");
    add_action("du_jiang", "dujiang");
    add_action("do_shang", "shang");
}

int do_yell(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "boat") {
        arg = "船家";
    }
    if (v1->query("age") < 16) {
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n", v1);
    } else if (v1->query("neili") > 500) {
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传了出去。\n", v1);
    } else {
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n", v1);
    }
    if (arg == "船家") {
        "/adm/daemons/transd"->check_boat(base_name(this_object()));
        return 1;
    } else {
        message_vision("湖面上远远传来一阵回声：“" + arg + "～～～”\n", v1);
    }
    return 1;
}

int do_shang(mixed arg) {
    mixed v1;
    if (!arg || arg != "ship") {
        write("你要 enter 哪儿？\n");
        return 1;
    }
    v1 = this_player();
    message_vision("船上群盗一见$N上船，忙叫了一声：首领来了，开船喽！杀金狗去！\n", v1);
    message_vision("船上升起帆，船就向湖中航行。\n", v1);
    v1->move("/d/guiyun/ship");
    tell_object(v1, "\e[36m你率船在湖上破浪前行，战旗猎猎.......\n\e[2;37;0m");
    call_out("rjinbing", 10, v1);
    return 1;
}

void rjinbing(mixed arg) {
    mixed v1;
    mixed v2;
    if (!(v1 = find_object("/d/guiyun/ship"))) {
        v1 = find_object("/d/guiyun/ship", 1);
    }
    if (!(v2 = find_object("/d/guiyun/jinship"))) {
        v2 = find_object("/d/guiyun/jinship", 1);
    }
    tell_object(arg, "战船在一阵阵喊杀声中撞上了另一艘大船。\n");
    v1->set("exits/out", "/d/guiyun/jinship");
    v2->set("exits/out", "/d/guiyun/ship");
}

int du_jiang() {
    mixed v1;
    v1 = this_player();
    if (!living(v1)) {
        return 0;
    }
    if (v1->query_skill("dodge") < 150) {
        return notify_fail("你的轻功修为太差，无法施展一苇渡江。\n");
    }
    tell_room(environment(v1), "\e[1;32m" + v1->name() + "捡起一段芦苇抛入水中，紧跟着飞身跃上芦苇，长袖飘飘，渡过了太湖。\n\e" + "[2;37;0m", ({ v1 }));
    write("你使出「一苇渡江」渡过了太湖。\n");
    v1->move("/d/guiyun/taihu");
    tell_room(environment(v1), "\e[1;32m只见" + v1->name() + "踩着一段芦苇从对岸过来，姿态潇洒地落在岸边。\n\e" + "[2;37;0m", ({ v1 }));
    return 1;
}
