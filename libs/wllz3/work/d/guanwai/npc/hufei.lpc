string ask_me() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (v2->query("shen") < 0) {
        v2->set_leader(v1);
        call_out("do_kill", 1, this_player());
    } else if (v2->query("shen") < 100000) {
        return "以你目前的作为是不能拿这把刀的。\n";
    } else if (v2->query("shen") > 100000) {
        if (query("baodao_count") > 0) {
            call_out("waiting", 0, v2, v1);
            add("baodao_count", -1);
            v1 = clone_object("/clone/equip/cwbdao");
            v1->move(v2, 1);
            "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s得到了%s\e[1;34m！", v2->name(), v1->name()));
            return " 好吧，这把闯王宝刀就赠与你，希望你好好利用它。";
        } else {
            return "你来晚了，现在这把刀已不在此处。";
        }
    }
}

void do_kill(mixed arg) {
    mixed v1;
    v1 = this_object();
    if (interactive(arg)) {
        command("say 你这恶贼竟敢打我宝刀的主意，给我纳命来！");
        v1->set_leader(arg);
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, arg);
    }
}

int accept_object(mixed arg1, mixed arg2) {
    if (!arg1 || environment(arg1) != environment()) {
        return 0;
    }
    if (!objectp(arg2)) {
        return 0;
    }
    if (!present(arg2, arg1)) {
        return notify_fail("你没有这件东西。");
    }
    if (arg2->query("id") == "yan ji") {
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg1) + "，如此大恩大德，在下实不知何以为报。");
        command("say 阎基，你这狗贼！想不到你也有今天！！");
        write("\e[1;31m\n胡斐手起刀落，将阎基剁为两段，阎基一声惨嚎，躺倒在了血泊之中！\n\e[2;37;0m");
        command("chat 哈哈！我终于为家父报仇血恨啦！！");
        arg1->set_temp("marks/hujiadaopu", 1);
    }
    return 1;
}

string ask_book() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!v2->query_temp("marks/hujiadaopu", 1)) {
        return "你说什么？\n";
    }
    if (v2->query("shen") < 10000) {
        return "刀谱落入宵小之手，难免是阎基第二。\n";
    } else if (v2->query("shen") > 100000) {
        if (query("book_count") > 0) {
            write("胡斐说着转身从阎基尸身上搜出一本破旧书本，递了给你。\n");
            call_out("waiting", 0, v2, v1);
            add("book_count", -1);
            v1 = clone_object("/clone/book/blade_book");
            v1->move(this_player());
            command("rumor " + v2->query("name") + "拿到胡家刀谱啦。");
            return "这本刀谱被这狗贼霸占多时了，现在就赠与你吧。";
        } else {
            return "你来晚了，现在刀谱已不在此处。";
        }
    }
}
