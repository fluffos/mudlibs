    set("exits", ([ "south" : "/d/jinshe/yongdao2" ]));
    set("objects", ([ "/d/jinshe/obj/jinshe-zhui" : 1, "/d/jinshe/obj/skeleton" : 1 ]));
    set("item_desc", ([ "map" : "石壁每个人形均不相同，举手踢足，似在练武。\n", "word" : "“重宝秘术，付与有缘，入我门来，遇祸莫怨。”\n" ]));
