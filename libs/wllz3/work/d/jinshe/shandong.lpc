void init() {
    add_action("do_think", "think");
    add_action("do_pull", "pull");
}

int do_pull(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (arg != "sword") {
        return 0;
    }
    if (query("sword_count") < 1) {
        return notify_fail("剑好象已经被人拔走了。\n");
    }
    if (this_player()->query("neili") < 1000) {
        message_vision("$N好奇心起，握住浚柄向外一拔，却是纹丝不动，竟似铸在石里一般。\n", v2);
        v2->add("neili", -10);
        return 0;
    }
    v1 = clone_object("/d/jinshe/obj/jinshe-jian");
    v1->move(v2);
    message_vision("$N紧紧握住浚柄，潜运内力，嗤的一声响，拔了出来，剑柄下果然连有剑身。\n", v2);
    v2->add("neili", -1000);
    add("sword_count", -1);
    return 1;
}

int do_think(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (arg != "map") {
        return 0;
    }
    v2 = v1->query_skill("jinshe-jian", 1);
    if (!v1->can_improve_skill("jinshe-jian")) {
        return notify_fail("你的实战经验不足，无法领悟石壁内容。\n");
    }
    if (v1->query("jing") < 20) {
        return notify_fail("你太累了，现在无法领悟石壁内容。\n");
    }
    if (v2 > 50) {
        return notify_fail("你觉得石壁内容太肤浅了。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    message_vision("$N面对着石壁静思良久，对金蛇剑法似有所悟。\n", v1);
    v1->improve_skill("jinshe-jian", random(v1->query("int") * 10));
    v1->receive_damage("jing", 5);
    if (!v1->is_busy()) {
        v1->start_busy(random(3) + 1);
    }
    return 1;
}
