int do_da(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "dai") {
        return notify_fail("什么？\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (v1->query("jing") < 40) {
        return notify_fail("你已经很累的了，先休息一下吧。\n");
    }
    v1->receive_damage("jing", random(40) * 1);
    message_vision("$N拼尽全力飞出几拳，打在沙袋上，沙袋左右晃了晃。\n", v1);
    if (v1->can_improve_skill("unarmed") && v1->query_skill("unarmed", 1) < 100) {
        v1->improve_skill("unarmed", v1->query("int"));
        write("你在拼命打袋当中若有所悟，似乎对基本拳脚有点心得。\n");
        v1->set_temp("stone_learned", 1);
    } else {
        write("你拼命地打来打去，却感觉不到任何进展。\n");
    }
    if (!v1->is_busy()) {
        v1->start_busy(random(3) + 1);
    }
