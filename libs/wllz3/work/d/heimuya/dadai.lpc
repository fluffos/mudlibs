int do_da(mixed);

void create() {
    set("short", "打袋室");
    set("long", "一间宽敞的房间，空荡荡的没有任何摆设，地下铺着不同大小的沙袋\n(dai)。\n");
    set("exits", ([ "west" : "/d/heimuya/liangongfang2" ]));
    set("item_desc", ([ "dai" : "这些沙袋由于经常有人在打袋练功(da)，显得非常平滑。\n" ]));
