int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "zhuang") {
        return notify_fail("什么？\n");
    }
    if (v1->query("jing") < 40) {
        return notify_fail("你已经很累的了，先休息一下吧。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    v1->receive_damage("jing", random(40) * 1);
    message_vision("$N纵身跃上了木桩，在木桩间高低来回地跳跃着。\n", v1);
    if (v1->query_skill("dodge", 1) < 51 && v1->can_improve_skill("dodge")) {
        v1->improve_skill("dodge", v1->query("int"));
