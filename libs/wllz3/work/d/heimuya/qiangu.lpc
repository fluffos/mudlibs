int do_study(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg != "stone") {
        return notify_fail("什么？\n");
    }
    if (v1->query_skill("literate", 1) < 1) {
        return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    v2 = v1->query_skill("unarmed", 1);
    v1->receive_damage("jing", 30);
    message_vision("$N正专心研读坪上的石头。\n", v1);
    if (!v1->can_improve_skill("unarmed")) {
        return notify_fail("也许是实战经验不足，你总是无法领会石砰上的文字。\n");
    }
    if (v1->can_improve_skill("unarmed") && v1->query_skill("unarmed", 1) < 101) {
        v1->improve_skill("unarmed", v1->query_int() + v2);
        write("你对着石坪上的「文字」琢磨了一回儿，似乎对基本拳脚有了心得。\n");
