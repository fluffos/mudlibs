inherit "/inherit/room/room";
void create();
void init();
int do_yell(mixed);
int du_jiang();

void create() {
    set("short", "长滩");
    set("long", "这片长滩不时有日月教教众乘船(chuang)往来，滩头插着一面日月教\n的旗帜，表明这里是日月教的所控制的，所以尽管江面上往来的船只很多\n，但是并没有船敢在这里停留，要过对岸只有靠日月教自己的船只了。\n");
    set("exits", ([ "east" : "/d/heimuya/shandao" ]));
    set("objects", ([ "/kungfu/class/riyue/huang" : 1 ]));
    set("outdoors", "riyue");
    setup();
}

void init() {
    add_action("do_yell", "yell");
    add_action("du_jiang", "dujiang");
}

int do_yell(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "boat") {
        arg = "船家";
    }
    if (v1->query("age") < 16) {
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n", v1);
    } else if (v1->query("neili") > 500) {
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传了出去。\n", v1);
    } else {
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n", v1);
    }
    if (arg == "船家") {
        "/adm/daemons/transd"->check_boat(base_name(this_object()));
        return 1;
    } else {
        message_vision("江面上远远传来一阵回声：“" + arg + "～～～”\n", v1);
    }
    return 1;
}

int du_jiang() {
    mixed v1;
    v1 = this_player();
    if (!living(v1)) {
        return 0;
    }
    if (v1->query_skill("dodge") < 150) {
        return notify_fail("你的轻功修为不够！\n");
    }
    tell_room(environment(v1), "\e[1;32m" + v1->name() + "捡起一段芦苇抛入水中，紧跟着飞身跃上芦苇，长袖飘飘，渡过了汉水。\n\e" + "[2;37;0m", ({ v1 }));
    write("你使出「一苇渡江」渡过了汉水。\n");
    v1->move("/d/heimuya/xingxingtan");
    tell_room(environment(v1), "\e[1;32m只见" + v1->name() + "踩着一段芦苇从对岸过来，姿态潇洒地落在岸边。\n\e" + "[2;37;0m", ({ v1 }));
    return 1;
}
