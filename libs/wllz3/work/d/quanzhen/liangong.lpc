int do_finger() {
    mixed v1;
    v1 = this_player();
    if (v1->query("jing") < 50) {
        return notify_fail("你现在精神不好。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    message_vision("$N伸指狠狠地点向沙袋，觉得指尖微微有些痛。\n", v1);
    if (v1->can_improve_skill("finger") && v1->query_skill("finger", 1) < 101) {
        v1->improve_skill("finger", v1->query_int());
        v1->receive_damage("jing", 50);
    } else {
        write("可是你点了半天，似乎一点用都没有。\n");
    }
    if (!v1->is_busy()) {
        v1->start_busy(random(3) + 1);
    }
    return 1;
}

