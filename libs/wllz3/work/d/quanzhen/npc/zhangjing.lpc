void attempt_apprentice(mixed arg) {
    command("say 好吧，我就收下你这个徒弟了。");
    command("recruit " + arg->query("id"));
}

string ask_me() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_player();
    if (!mapp(v1 = v3->query("family")) || v1["family_name"] != "全真教") {
        return "/adm/daemons/rankd"->query_respect(v3) + "与本教毫无瓜葛，你这话可叫我弄不明白了。";
    }
    if (query("book_count") < 1) {
        return "你来晚了，道德经已经被人取走了。";
    }
    if (v3->query_temp("get_daodejing-i")) {
        return "你不是已经拿了吗？";
    }
    add("book_count", -1);
    v2 = clone_object("/d/quanzhen/npc/obj/daodejing-i");
    v2->move(v3);
    v3->set_temp("get_daodejing-i", 1);
    "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("%s拿到道德经了。", v3->name()));
    return "好吧，这本「道德经」你拿回去好好研读，有看不懂的地方来问我。";
}

string ask_zhipu() {
    mixed v1;
    v1 = this_player();
    if (v1->query_temp("tmark/指") == 2) {
        v1->add_temp("tmark/指", 1);
        return "一阳指的指法谱向来就是由本教祖师亲自收存，从不外传。\n";
    } else {
        v1->set_temp("tmark/指", 0);
        return "听说一阳指是天下最王道的指法，我也没有见过。\n";
    }
}
