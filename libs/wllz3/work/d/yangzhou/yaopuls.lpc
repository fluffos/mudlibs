inherit "/inherit/room/room";
int compelete_work(mixed);
int halt_work(mixed);
void create();
void init();
int do_fenyao();

void create() {
    set("short", "药铺内室");
    set("long", "这是药铺的内室，密密麻麻的一个个小抽屉里，放的都是一些中草药\n。几个伙计正在忙着将手中的零散草药，分配(fenyao)到小抽屉里。只见\n边上贴着一张字条(sign)，上面似乎写着什么。\n");
    set("no_fight", 1);
    set("no_steal", 1);
    set("no_beg", 1);
    set("item_desc", ([ "sign" : "工作说明：\n\n使用 $WHT$fenyao$NOR$ 指令进行分药，如果想停下来休息，可以用$WHT$ halt $NOR$停止。\n\n" ]));
    set("exits", ([ "east" : "/d/yangzhou/yaopu" ]));
    setup();
}

void init() {
    add_action("do_fenyao", "fenyao");
}

int do_fenyao() {
    mixed v1;
    v1 = this_player();
    if (v1->query("brawn") <= 20) {
        return notify_fail("你太累了，别分错药了。\n");
    }
    if (v1->query_temp("fenyaoover")) {
        return notify_fail("你的药已经分完了，快去找老板要报酬吧。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你还忙着呢！\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("战斗中不能分药。\n");
    }
    if (!v1->query_temp("fenyaobegin")) {
        return notify_fail("人家又没请你，你来这里做什么？\n");
    }
    message_vision("$N将袖子一缅，开始小心的挑选药材。\n", v1);
    v1->set_short_desc("正在分药，忙得不可开交。");
    v1->add("brawn", -4);
    v1->start_busy((: compelete_work :), (: halt_work :));
    return 1;
}

int compelete_work(mixed arg) {
    if (!arg) {
        return 0;
    }
    if (environment(arg) != this_object()) {
        arg->set_short_desc(0);
        arg->delete_temp("fenyao_times");
        arg->delete_temp("fenyaobegin");
        return 0;
    }
    if (arg->add_temp("fenyao_times", 1) > random(10) + 10) {
        arg->set_short_desc(0);
        write("你终于完成了任务，人也累坏了，快找老板拿报酬去吧！\n");
        arg->set_temp("fenyaoover", 1);
        return 0;
    }
    if (arg->query("brawn") < 20) {
        arg->set_short_desc(0);
        write("你显然是太累了，不得不停下来休息一会。\n");
        return 0;
    }
    if (random(10) == 3) {
        write("你看着手上的药材，想了半天终于还是没有找到该放的地方。\n");
        arg->add("brawn", -10);
        arg->add_temp("fenyao_times", -1);
        return 1;
    }
    arg->add("brawn", -4);
    switch (random(5)) {
    case 1:
        write("你分的好仔细呀，还检查了一次。\n");
        break;
    case 2:
        write("你累的满头大汗，一不小心却分错了药。\n");
        break;
    case 3:
        write("你将药材仔细挑选，小心翼翼的放到抽屉里。\n");
        break;
    default:
        write("只见你随手一扔，药居然刚好扔进药箱，好运气呀。\n");
        break;
    }
    return 1;
}

int halt_work(mixed arg) {
    write("你停了下来，喘了口气。\n");
    arg->set_short_desc(0);
    return 1;
}
