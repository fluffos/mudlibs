void create() {
    set("short", "土地庙");
    set("long", "这是一间小小的庙宇，庙中神台上供奉的是传说中的土地公。庙里四\r\n壁已经被长年的香火熏得漆黑，连神台上的土地公塑像，也显得陈旧了许\r\n多。供桌上放着一些水果等供品，供桌的桌布(zhuobu)好像被人拉开了。\r\n");
    set("exits", ([ "south" : "/d/yangzhou/westroad3", "enter" : "/d/yangzhou/gbandao" ]));
    set("objects", ([ "/kungfu/class/gaibang/lu" : 1, "/kungfu/class/gaibang/peng" : 1 ]));
    create_door("enter", "小门", "out", 1);
    setup();
}

void init() {
    mixed v1;
    if (interactive(v1 = this_player())) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
    add_action("do_bo", "bo");
    add_action("do_enter", "enter");
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != this_object()) {
        return;
    }
    if (objectp(present("lu youjiao", environment(arg))) && objectp(present("peng youjing", environment(arg)))) {
        tell_object(arg, "两个乞丐坐在墙角边上，见你进来，抬头看了你一眼。\n");
    }
}

int do_bo(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "zhuobu") {
        return notify_fail("你要拨开什么？\n");
    }
    if (query("bo")) {
        return notify_fail("供桌的桌布已经被拨开了，你仔细一瞧，供桌下有一个黑漆漆的地洞，似\n乎可以(enter dong)进去。\n");
    }
    set("bo", 1);
    remove_call_out("close");
    call_out("close", 10);
    message_vision("$N拨开供桌的桌布，仔细一瞧，发现桌子下有一个黑漆漆的地洞。\n", v1);
    tell_object(v1, "地洞足有一个人大，你似乎可以(enter dong)进去看看。\n");
    return 1;
}

int do_enter(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "dong") {
        return 0;
    }
    if (!query("bo")) {
        return notify_fail("你想要找个洞钻进去，可是洞在哪？\n");
    }
    message("vision", v1->name() + "一弯腰往桌子地下的地洞里钻了进去。\n", environment(v1), ({ v1 }));
    v1->move("/d/gaibang/inhole");
    message("vision", v1->name() + "从洞口钻了进来。\n", environment(v1), ({ v1 }));
    return 1;
}

void close() {
    if (!query("bo")) {
        return;
    }
    tell_room(this_object(), "桌布又轻轻地垂了下去，慢慢的恢复了原样。\n");
    delete("bo");
}
