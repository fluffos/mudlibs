    } else {
        if (arg->query("class") == "bonze") {
            command("say 呦，" + "/adm/daemons/rankd"->query_respect(arg) + "也来光顾我们丽春院啊。");
            command("say 想当年我接过一个西藏喇嘛，他上床前一定要念经，一面念经，眼珠子就骨溜溜的瞧着我。");
        }
        if (arg->query("gender") == "女性") {
