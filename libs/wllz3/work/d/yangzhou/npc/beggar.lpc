void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (wizardp(arg)) {
        return;
    }
    if (playerp(arg) && arg->query("level") < 20) {
        return;
    }
    set_leader(arg);
    switch (random(10)) {
    case 0:
        command("beg gold from " + arg->query("id"));
        break;
    case 1:
        command("beg silver from " + arg->query("id"));
        break;
    case 2:
        command("beg thousand-cash from " + arg->query("id"));
        break;
    case 3:
        command("beg xi gua from " + arg->query("id"));
        break;
    case 4:
        command("beg horse from " + arg->query("id"));
        break;
    }
}

