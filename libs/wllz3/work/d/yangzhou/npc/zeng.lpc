    message_vision("$N给了$n一条丝绢和一根绣花针。\n", v2, v1);
    command("say 好吧，你就帮我做点针线活，东西都在这呢。");
    v1->set_temp("xiu_job", 1);
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (arg1->query_temp("xiu_job") && arg2->query("id") == "si juan") {
        if (!arg1->query_temp("xiu_job_finish")) {
