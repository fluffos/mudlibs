int job() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    v2 = this_object();
    if (v1->query("level") >= 10) {
        command("shake " + v1->query("id"));
        command("say " + "/adm/daemons/rankd"->query_respect(v1) + "德高望重，怎敢牢烦您呢？！");
        return 1;
    }
    if (v1->query_temp("xiu_job")) {
        command("? " + v1->query("id"));
        command("say 你的丝绢绣好了吗？");
        return 1;
    }
    if (v1->query("gender") != "女性") {
        command("faint");
        command("say 这种女人家的手艺恐怕不适合你做吧？");
        return 1;
