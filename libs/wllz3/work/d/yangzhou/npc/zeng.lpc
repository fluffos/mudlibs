            v2 += arg1->query_temp("xiu_finish") * 5;
            tell_object(arg1, "曾柔给了你一些实战经验和点潜能做为奖励。\n");
            if (arg1->add_exp(arg1, v2) && arg1->add_points(arg1, v2)) {
                v1 = clone_object("/clone/money/silver");
                v1->set_amount(random(5) + 5);
                v1->move(arg1, 1);
                message_vision("$N给了$n一些" + v1->name() + "。\n", this_object(), arg1);
            }
            arg1->delete_temp("xiu_job");
            arg1->delete_temp("xiu_finish");
            arg1->delete_temp("xiu_job_finish");
