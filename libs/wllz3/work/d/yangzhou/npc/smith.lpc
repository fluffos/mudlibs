        say("铁匠说道：让你到内堂里打铁，做的还熟手吗？\n");
        return 1;
    }
    command("nod " + v1->query("id"));
    tell_object(v1, "铁匠说道：那好吧，我这内堂存了好多的模子还没打好，你就来当我的下\n手，赶紧去把内堂里剩下的模子打好给我。\n");
    v1->set_temp("job_found/type", "打铁");
    return 1;
}

int ask_finish() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    if (!v1->query_temp("job_found")) {
        say("铁匠愣了愣，说道：我好像没请你帮我做事呀？\n");
        return 1;
    }
    if (!v1->query_temp("job_found/finish")) {
        say("铁匠问道：内堂里的模子，你可打好了？\n");
        return 1;
    }
    tell_object(v1, "铁匠走进内堂看了看，又走了出来，说道：好，做的很好。\n说完从怀里掏出了一些银两交给你道：喏，这是你的报酬。\n");
    v3 = v1->query("level");
    v3 += v1->query_temp("job_found/times") * 5;
    v4 = v1->query("level");
    v4 += v1->query_temp("job_found/times") * 2;
    if (v1->add_exp(v1, v3) && v1->add_points(v1, v4)) {
        v2 = clone_object("/clone/money/silver");
        v2->set_amount(random(5) + 5);
        v2->move(v1, 1);
        tell_object(v1, "你获得了一些白银作为奖励。 \n");
