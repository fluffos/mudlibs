int ask_job() {
    mixed v1;
    v1 = this_player();
    if (v1->query("level") >= 20) {
        say("铁匠说道：人往高处看，这位" + "/adm/daemons/rankd"->query_respect(v1) + "哪能一辈子在我这里打铁啊。\n");
        return 1;
    }
    if (v1->query("gender") == "女性") {
        say("铁匠说道：打铁这种粗重活，怎么适合" + "/adm/daemons/rankd"->query_respect(v1) + "你呢？\n");
        return 1;
