int accept_fight(mixed arg) {
    command("say 老夫久未和江湖人动手过招了，今日也不想破例。");
}

string ask_job() {
    mixed v1;
    v1 = this_player();
    if (v1->query_temp("ask_shiqingshan")) {
        return "唉，山贼一日不除，我一日寝食难安啊。";
    }
    if (v1->query("marks/史青山")) {
        return "多谢这位" + "/adm/daemons/rankd"->query_respect(v1) + "拔刀相助，解决了我一件难事，真是扬州百姓之福啊。";
    }
    v1->set_temp("ask_shiqingshan", 1);
    return "据巡城的官兵称，近日来有一群山贼聚集于扬州城外密林，打算不日之内进城烧杀抢掠。\n我虽为扬州守将，可惜城内兵将不多，单凭一人之力恐怕难以将这帮乱贼绳之以法。\n为今之计，唯有将其头子拿下，以瓦解这帮乱贼。\n";
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->query("name") == "\e[31m山贼头子的人头\e[2;37;0m" && arg1->query_temp("ask_shiqingshan") && arg2->query("killed_by") == arg1->query("id")) {
        message_vision("$N接过头颅一看，不禁喜道：这位" + "/adm/daemons/rankd"->query_respect(arg1) + "拔刀相助，解决了我一件难事，真是扬州百姓之福啊。\n", this_object());
        if (!arg1->query("marks/史青山")) {
            tell_object(arg1, "由于你智勇双全，擒贼先擒王，将城外的山贼一网打尽。\n");
            tell_object(arg1, "你的潜能增加了 1000 点，江湖威望也有所提高了。\n");
            arg1->add("learned_points", -1000);
            arg1->add("weiwang", 100);
            arg1->set("marks/史青山", 1);
            arg1->delete_temp("ask_shiqingshan");
            "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s(%s)帮史青山瓦解了扬州城外的山贼，得到了一些奖励。", arg1->name(), arg1->query("id")));
        }
        return 1;
    }
}
