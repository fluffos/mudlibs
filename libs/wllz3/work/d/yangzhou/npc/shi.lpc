    set("title", "扬州守将");
    set("gender", "男性");
    set("age", 33);
    set("long", "史青山曾经是武当山的俗家弟子，不知为何吃上了朝廷饭。\n");
    set("level", 25);
    set("shen_type", 1);
    set("attitude", "heroism");
