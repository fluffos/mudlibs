// 本文件由编译后的 .b 二进制程序反编译还原，原始源码未随档案发布。
// Decompiled from the compiled .b binary; the original source was not distributed.
inherit "/inherit/char/npc";
int ask_wu();
int ask_over();
int ask_working();
int ask_apply();
int accept_object(mixed, mixed);
int do_apply();

void create() {
    set_name("平一指", ({ "ping yizhi", "ping", "yizhi" }));
    set("title", "\e[1;33m杀人神医\e[2;37;0m");
    set("nickname", "\e[1;31m杀一人救一人\e[2;37;0m");
    set("gender", "男性");
    set("long", "他就是医术高超的「杀人神医」平一指。可是他性格古怪，不是什么人都医的。\n");
    set("age", 65);
    set("jing", 3000);
    set("max_jing", 3000);
    set("shen_type", 1);
    set("level", 30);
    set("attitude", "heroism");
    set_skill("unarmed", 80);
    set_skill("dodge", 80);
    set_skill("parry", 60);
    set_temp("apply/attack", 70);
    set_temp("apply/defense", 70);
    set_temp("apply/damage", 50);
    set("inquiry", ([ "何首乌" : (: ask_wu :), "job" : (: ask_working :), "报酬" : (: ask_over :), "finish" : (: ask_over :), "药理师" : (: ask_apply :) ]));
    setup();
    add_money("silver", 1);
    carry_object("/clone/cloth/cloth")->wear();
}

void init() {
    add_action("do_apply", "apply");
}

int ask_wu() {
    mixed v1;
    v1 = this_player();
    message_vision("平一指上上下下打量了$N一下：什么！何首乌？拿十两黄金来！\n", v1);
    v1->set_temp("何首乌", 1);
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg1->query_temp("何首乌")) {
        message_vision("平一指对$N说：医一人，杀一人，老夫不收钱！\n", arg1);
        return 0;
    }
    if (arg2->query("money_id") && arg2->value() >= 100000) {
        message_vision("平一指给了$N何首乌！\n", arg1);
        this_player()->delete_temp("何首乌");
        v1 = clone_object("/clone/yaowu/shouwu");
        v1->move(this_player());
    }
    return 1;
}

int ask_over() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    if (!v1->query_temp("fenyaobegin")) {
        command("say 我好象还没有给你工作吧？");
        return 1;
    }
    if (v1->query_temp("fenyaobegin") && !v1->query_temp("fenyaoover")) {
        command("say 你在说什么呀？你好象还没完成工作呢。");
        return 1;
    }
    message_vision("平一指笑着对$N说：“不错，不错！这是你应该得的报酬。”\n", v1);
    v3 = v1->query("level");
    v3 += v1->query_temp("fenyao_times") * 5;
    v4 = v1->query("level");
    v4 += v1->query_temp("fenyao_times") * 2;
    if (v1->add_exp(v1, v3) && v1->add_points(v1, v4)) {
        v2 = clone_object("/clone/money/silver");
        v2->set_amount(random(5) + 5);
        v2->move(v1, 1);
        tell_object(v1, "你获得了一些白银作为奖励。 \n");
    }
    v1->delete_temp("fenyaobegin");
    v1->delete_temp("fenyaoover");
    v1->delete_temp("fenyao_times");
    return 1;
}

int ask_working() {
    mixed v1;
    v1 = this_player();
    if (v1->query("level") < 10) {
        message_vision("平一指说道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "好象还很面生呀。\n", v1);
        return 1;
    }
    if (v1->query("level") >= 20) {
        message_vision("平一指对$N说道：“这位" + "/adm/daemons/rankd"->query_respect(v1) + "见笑了，小店劳烦不起。”\n", v1);
        return 1;
    }
    if (v1->query_temp("fenyaobegin")) {
        message_vision("平一指对$N说道：“你不是已经要了工作了，还不去干！”\n", v1);
        return 1;
    }
    if (v1->query("brawn") < 20) {
        message_vision("平一指对$N说道：算了吧，累成了这样还想工作，把药分错了会出人命的。\n", v1);
        return 1;
    }
    if (v1->query_temp("fenyaoover")) {
        message_vision("平一指说道：“哦？ 你连自己的工钱也不要？好吧，既然这样我也就不勉\n强你了。那你就到内室去帮我再分次药吧。”\n", v1);
        v1->delete_temp("fenyaoover");
        v1->delete_temp("fenyao_times");
        v1->set_temp("fenyaobegin", 1);
        return 1;
    }
    message_vision("平一指对$N说道：“好吧，那你就到内室去帮我分分药吧。”\n", v1);
    v1->set_temp("fenyaobegin", 1);
    return 1;
}

int ask_apply() {
    mixed v1;
    v1 = this_player();
    if (v1->query("career")) {
        if (v1->query("career") == "药理师") {
            if (!v1->query_skill("herbal-skill", 1) || v1->query_skill("herbal-skill", 1) < 1) {
                v1->set_skill("herbal-skill", 1);
            }
            if (v1->query_skill("herbal-skill", 1) >= 100) {
                say("平一指点了点头，说道：不错，以你现在的药理常识，可以晋升为药剂师了。\n");
                v1->set("career", "药剂师");
                tell_object(v1, "\e[1;32m恭喜，你的职业已经晋升为药剂师，你现在可以自己试试制作一些成药。\n\e[2;37;0m");
                return 1;
            }
            say("平一指说道：药理常识必须在经过研究才会有所突破，如果你的药理常识\n达到一百级，可以来这里找我，我再教你一些药剂调配的技巧。\n");
            return 1;
        }
        if (v1->query("career") == "药剂师") {
            say("平一指说道：你现在已经掌握了一定的药理常识，你可以自己尝试制作一些成药。\n");
            return 1;
        }
        say("平一指说道：每个职业都自己的特殊技能，而职业的应用也有所不同。\n");
        return 1;
    }
    if (v1->query_temp("pending/ask_apply")) {
        say("平一指说道：怎么样？考虑清楚了吗？\n");
        return 1;
    }
    say("平一指说道：莫非你对药理常识也有兴趣？\n");
    tell_object(v1, "\e[1;31m如果你想加入到药理师的职业，请输入(\e[1;37m apply \e[1;31m)，当你的药理常识达到\n一定的等级，就可以晋升为药剂师，自己制作成药。\n\e[2;37;0m");
    v1->set_temp("pending/ask_apply", 1);
    return 1;
}

int do_apply() {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("pending/ask_apply")) {
        return 0;
    }
    if (v1->query("level") < 20) {
        say("平一指摇了摇头，说道：你的等级太低，这事情还是以后再说吧。\n");
        return 1;
    }
    if (v1->query("int") < 50) {
        say("平一指摇了摇头，说道：你的悟性太低，不适合做药理师这个职业。\n");
        return 1;
    }
    if (v1->query("spi") < 50) {
        say("平一指摇了摇头，说道：你的灵性太差，不适合做药理师这个职业。\n");
        return 1;
    }
    say("平一指笑了笑，说道：那好吧，欢迎你加入药理师这个职业。我现在先\n教你一些药理常识，当你的药理常识达到一定的等级时，可以再来找我，\n我再教你一些制作成药。\n");
    tell_object(v1, "\e[1;32m恭喜，你已经成功加入了药理师的职业并掌握了一级药理常识。\n\e[2;37;0m");
    v1->set_skill("herbal-skill", 1);
    v1->set("career", "药理师");
    v1->delete_temp("pending/ask_apply");
    return 1;
}
