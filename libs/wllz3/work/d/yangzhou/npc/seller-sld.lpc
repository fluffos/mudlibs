inherit "/inherit/char/npc";
inherit "/feature/vendor";
int ask_me();
int ask_skill();
void greeting(mixed);
int do_apply();
int accept_object(mixed, mixed);

void create() {
    set_name("何通", ({ "he tong", "he", "seller" }));
    set("title", "石料店老板");
    set("long", "他是这家石料店的老板，身材魁梧，五大三粗，一看就知道是个粗人。\r\n");
    set("gender", "男性");
    set("attitude", "friendly");
    set("age", 53);
    set("level", 35);
    set("inquiry", ([ "采矿" : (: ask_skill() :), "采矿技巧" : (: ask_skill() :), "矿工" : (: ask_me() :) ]));
    set("vendor_goods", ([ "/clone/misc/moyle" : 1 ]));
    set_skill("dodge", 45);
    set_skill("parry", 45);
    set_skill("force", 45);
    set_skill("unarmed", 45);
    setup();
    carry_object("/clone/cloth/cloth")->wear();
}

void init() {
    mixed v1;
    if (interactive(v1 = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
    add_action("do_vendor_list", "list");
    add_action("do_apply", "apply");
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    say(name() + "迎了上来，问道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，是否选购石料？\n");
}

int ask_me() {
    mixed v1;
    v1 = this_player();
    if (v1->query("career")) {
        if (v1->query("career") == "矿工") {
            say(name() + "说道：你现在拥有开采矿石的能力，这些矿石可以用来铸造武器。\n");
            return 1;
        }
        command("say 不同的职业具备不同的能力，而这些能力是其他职业所没有的。");
        return 1;
    }
    if (v1->query("level") < 20) {
        command("say 你的等级太低，这事以后再说吧。\n");
        return 1;
    }
    if (v1->query_temp("pending/apply_dig")) {
        tell_object(v1, "\e[33m如果你想成为一名矿工，请输入( apply )，以后，你将拥有开采其他矿物的能力。\n\e[2;37;0m");
        return 1;
    }
    v1->set_temp("pending/apply_dig", 1);
    say(name() + "欣喜的说道：莫非这位" + "/adm/daemons/rankd"->query_respect(v1) + "对矿工这一职业也感兴趣？\n");
    tell_object(v1, "\e[33m如果你想成为一名矿工，请输入( apply )，以后，你将拥有开采其他矿物的能力。\n\e[2;37;0m");
    return 1;
}

int do_apply() {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("pending/apply_dig")) {
        return 0;
    }
    if (!v1->is_member()) {
        write("何通摇了摇头，说道：对不起，这个职业必须为本游戏会员才可以加入。\n");
        return 1;
    }
    if (v1->query("str") < 50) {
        write("何通摇了摇头，说道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "臂力太弱，不适合做矿工这种职业。\n");
        return 1;
    }
    if (v1->query("con") < 50) {
        write("何通摇了摇头，说道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "体质太差，不适合做矿工这种职业。\n");
        return 1;
    }
    tell_object(v1, "\e[37m恭喜，从现在开始，你的职业是矿工！你已经拥有了采集其他与众不同\n的矿石的能力。而这些矿石，可以用来铸造和锻造其他的道具。\n\e[2;37;0m");
    say(name() + "说道：如果还没有学会采矿技巧，我倒是可以先教你一级。\n");
    v1->set("career", "矿工");
    v1->delete_temp("pending/apply_dig");
    return 1;
}

int ask_skill() {
    mixed v1;
    v1 = this_player();
    if (v1->query("level") < 20) {
        say(name() + "说道：你的等级太差，不适合做这种粗重功夫。\n");
        return 1;
    }
    if (v1->query("str") < 50) {
        write("何通摇了摇头，说道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "臂力太弱，不适合采矿这种粗重活。\n");
        return 1;
    }
    if (v1->query("con") < 50) {
        write("何通摇了摇头，说道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "体质太差，不适合采矿这种粗重活。\n");
        return 1;
    }
    if (v1->query_skill("dig-skill", 1)) {
        say(name() + "说道：采矿技巧不能学习，只能在工作中增长。如果你的职业是矿工，\n将能够采集到一些铸造用的矿石。\n");
        return 1;
    }
    v1->set_skill("dig-skill", 1);
    tell_object(v1, "\e[1;32m恭喜！你学会了生活技能之一「采矿技巧」！\n\e[2;37;0m");
    say(name() + "说道：嗯，现在开始，你可以去采集一些矿产，如果你的职业是矿工，\n你将能够开采到一些铸造武器所用的矿石。\n");
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->is_ore()) {
        say(sprintf("何通接过%s瞧了瞧，点头说道：不错，这个我要了。\n", arg2->name(1)));
        "/adm/daemons/moneyd"->pay_player(arg1, arg2->query("value") * 80 / 100);
        tell_object(arg1, sprintf("何通给了你%s。\n", "/adm/daemons/moneyd"->price_str(arg2->query("value") * 80 / 100)));
        return 1;
    }
    say("何通疑道：你给我这个做什么？\n");
    return 0;
}
