int ask_me() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query("age") < 18) {
        command("say 怎么着？小孩子也要保护？你家大人跑哪去了呢？");
        return 1;
    }
    if (mapp(v2 = v1->query("my_guard"))) {
        if (!undefinedp(v2["dead"])) {
            v1->delete("my_guard");
            say("张镖头一脸惊讶的问道：什么？镖师竟也遇难了？唉，罢了罢了！\n");
            return 1;
        }
        if (v2["employ_time"] <= v1->query("mud_age")) {
            v1->delete("my_guard");
            say("张镖头翻了翻本子，说道：" + "/adm/daemons/rankd"->query_respect(v1) + "与我镖局的生意，已经到期了。\n");
            return 1;
        }
        say("张镖头得意洋洋的说道：我们扬威镖局的保镖，身手不凡，" + "/adm/daemons/rankd"->query_respect(v1) + "可满意呀？\n");
        return 1;
    }
    if (v1->query_temp("pending/ask_buy_guard")) {
        say("张镖头说道：" + "/adm/daemons/rankd"->query_respect(v1) + "考虑得怎么样了？要是考虑清楚了那得告诉我，请哪一\n级的镖师(\e" + "[1;37memploy 级别\e" + "[2;37;0m)，可别忘了带上钱呀。\n");
        return 1;
    }
    say("张镖头点了点头，说道：我们扬威镖局的镖师，个个身手不凡，武艺超群，\n不同的价钱，有不同的镖师；如果" + "/adm/daemons/rankd"->query_respect(v1) + "出得起高价，哪怕宗师级的镖头也\n给您请来。要是考虑清楚了那得告诉我，请哪一级的镖师(\e" + "[1;37memploy 级别\e" + "[2;37;0m)。\n");
    v1->set_temp("pending/ask_buy_guard", 1);
    return 1;
}

