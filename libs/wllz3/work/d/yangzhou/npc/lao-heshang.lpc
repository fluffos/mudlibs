void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    switch (random(2)) {
    case 0:
        if (arg->query("bellicosity") > 0) {
            say(this_object()->query("name") + "笑咪咪地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "脸上杀气太重，可要日诵佛经三百遍，好好悔过才是。\n");
        }
        break;
    case 1:
        if (sizeof(arg->query_killer())) {
            say(this_object()->query("name") + "笑咪咪地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "杀孽太重，可要日诵佛经三千遍，放下屠刀才是。\n");
        }
        break;
    }
}

string ask_me1() {
    mixed v1;
    v1 = this_player();
    message_vision("老和尚开始向$N讲解佛法的道理....\n", v1);
    if (v1->query("guilty")) {
        v1->delete("guilty");
    }
    if (v1->query("bellicosity") > 0) {
        if (v1->add("bellicosity", -v1->query("bellicosity") / 10) < 0) {
            v1->set("bellicosity", 0);
        }
        v1->start_busy(1);
        tell_object(v1, "你听完老和尚的讲解，心中似乎一片祥和。\n");
        tell_object(v1, "你的杀气降低了！\n");
        command("nod " + v1->query("id"));
        return "阿弥陀佛，善哉，善哉！";
    } else {
        command("hehe");
        return "这位" + "/adm/daemons/rankd"->query_respect(v1) + "一心向善，好人终有好报。";
    }
}

string ask_me2() {
    mixed v1;
    v1 = this_player();
    message_vision("老和尚开始向$N讲解佛法的道理....\n", v1);
    if (sizeof(v1->query_killer())) {
        tell_object(v1, "你听完老和尚的讲解，心中似乎一片祥和。\n");
        tell_object(v1, "你忘记了所有的仇家！\n");
        v1->remove_all_killer();
        command("nod " + v1->query("id"));
        return "阿弥陀佛，善哉，善哉！";
    } else {
        command("hehe");
        return "杀人是空，屠刀亦是空。";
    }
}
