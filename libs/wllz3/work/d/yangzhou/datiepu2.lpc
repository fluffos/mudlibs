        write("你忙活了半天，终于把\e[1;37m" + v1 + "\e" + "[2;37;0m打好了。\n");
        write("\e[1;31m你赶紧把\e[1;37m" + v1 + "\e" + "[1;31m放好，找铁匠交差去吧。\n\e" + "[2;37;0m");
        arg->set_temp("job_found/finish", 1);
        return 0;
    }
    arg->add("brawn", -8);
    write(random(5) > 1 ? "你一手拿着锤子，一手用钳子夹着烙铁，叮叮当当的敲打起来。\n" : random(5) > 2 ? "你看了看烧得通红的烙铁，是时候放进水缸里了。\n" : random(5) > 3 ? "你用钳子把水缸里的烙铁夹了起来，再放在锻台上继续敲打。\n" : random(5) > 4 ? "\e[37m你看着烙铁渐渐成型，心中不禁一阵喜悦。\n\e[2;37;0m" : "你举着锤子，正在吃力的打铁，不时用手擦了擦汗。\n");
    return 1;
}

int halt_work(mixed arg) {
    arg->set_short_desc(0);
    write("你放下锤子，停下来休息一会。\n");
    return 1;
}
