int do_found() {
    mixed v1;
    v1 = this_player();
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("你一边打架一边打铁？\n");
    }
    if (v1->query("jing") < 50) {
        return notify_fail("你现在精神不济，还是休息一下吧。\n");
    }
    if (v1->query("qi") < 50) {
        return notify_fail("你现在状态不好，还是休息一下吧。\n");
    }
    if (v1->query("brawn") < 20) {
        return notify_fail("你太累了，不适合做这种粗活。\n");
    }
    if (!v1->query_temp("job_found")) {
        return notify_fail("这是人家的东西，可不要乱搞哦。\n");
    }
    if (v1->query_temp("job_found/finish")) {
        return notify_fail("铁匠要你做的事已经做好了，还不赶紧去交差？\n");
    }
    write("你拿起锻造台边上的大铁锤，试着打造铁器。\n");
    v1->start_busy((: comp_work :), (: halt_work :));
    v1->set_short_desc("卷起袖管，挥着铁锤正在打铁。");
    return 1;
}

int comp_work(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = ({ "菜刀", "剪子", "榔头", "秤砣", "锄头", "铁盾" });
    if (arg->query("jing") < 20) {
        arg->set_short_desc(0);
        write("你太累了，于是停下来休息一会。\n");
        return 0;
    }
    if (arg->query("qi") < 20) {
        arg->set_short_desc(0);
        write("你累得上气不接下气，还是停下来休息一会。\n");
        return 0;
    }
    if (arg->query("brawn") < 20) {
        arg->set_short_desc(0);
        write("你体力不支，还是停下来休息一会。\n");
        return 0;
    }
    if (arg->add_temp("job_found/times", 1) > random(10) + 10) {
        v1 = v2[random(sizeof(v2))];
