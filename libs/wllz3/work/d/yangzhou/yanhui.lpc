    set("long", "这里是巫师用来招待上宾的宴会厅，每当喜庆节日，巫师们就会在这\n里设下鸿门宴，招待上宾以及天下群雄。只见宴会厅上气势宏伟，金壁辉\n煌。大厅四壁柱子上盘绕的金龙，散发着耀眼的金光。你脚踩着红色的地\n毯，直入眼帘的，就是大厅中间的那张圆形的大理石桌了。\n");
    set("exits", ([ "down" : "/d/yangzhou/zxlpath" ]));
    set("no_sleep_room", 1);
    setup();
    set("no_user", 1);
}

