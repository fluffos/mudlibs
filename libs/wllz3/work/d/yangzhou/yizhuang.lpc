    add_action("do_kneel", "kneel");
}

int do_look(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "zi") {
        return 0;
    }
    write(sprintf("你看了看棺木上的字，不禁吓了一身冷汗，只见棺木上写着：\n\e[1;34m\n%s，生于%s，卒于%s。\n\n\e[2;37;0m", v1->name(1), "/adm/daemons/chinesed"->chinese_date(v1->query("birthday")), "/adm/daemons/natured"->game_time()));
    return 1;
}

int do_kneel(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!arg || arg == "") {
        return notify_fail("你要拜祭谁？\n");
    }
    if (!objectp(v2 = find_player(arg))) {
        return notify_fail("你要拜祭谁？\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (v2 == v1) {
        return notify_fail("你跪了下来，心里默默的念着：天啊，让我早日脱离苦海，死了好了。\n");
    }
    if (!v2->is_ghost()) {
        return notify_fail("有没有搞错？活人你也要拜祭？\n");
    }
    if (!objectp(v3 = v1->query_temp("armor/cloth")) || v3->query("name") != "\e[33m麻服\e[2;37;0m") {
        return notify_fail("办丧事不穿麻服怎么行？\n");
    }
    write(sprintf("你跪在%s的灵前，默默念道：%s%s，你在天之灵，早日安息吧。\n", v2->name(1), v2->name(1), "/adm/daemons/rankd"->query_close(v2)));
    message("vision", v1->name() + "跪在了" + v2->name(1) + "的灵前，默默的拜祭着。\n", environment(v1), ({ v1 }));
    v1->set_temp("kneel_bye", v2);
    if (objectp(v2)) {
        tell_object(v2, "\e[1;32m阵阵仙乐飘起，仙乐背后，又是阵阵祝福，那声音听似熟悉又是陌生，\n你只觉心情舒畅，晦气渐渐消失了。\n\e[2;37;0m");
    }
    v1->start_busy(3);
    return 1;
}

int do_brun(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
