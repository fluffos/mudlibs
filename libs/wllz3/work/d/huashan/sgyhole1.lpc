void init() {
    add_action("do_break", "break");
}

int do_break(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!objectp(v1 = v2->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你一掌打在石壁，满手都是鲜血。\n");
    }
    message_vision("$N走到石壁前，拔出腰间所悬长剑，运劲向石壁刺了过去！\n", v2);
    if (v2->query("neili") < 200) {
