int do_mianbi() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = v1->query_skill("sword", 1);
    if (v2 < 20) {
        return notify_fail("你的基本剑法显然太低，无法领悟石壁内容。\n");
    }
    if (!v1->can_improve_skill("sword")) {
        return notify_fail("你的实战经验不足，无法领悟石壁内容。\n");
    }
    if (v1->query("jing") < 20) {
        return notify_fail("你太累了，现在无法领悟石壁内容。\n");
    }
    if (v2 > 101) {
        return notify_fail("你觉得石壁内容太肤浅了，再领悟下去也没有意义。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    message_vision("$N面对着石壁趺坐静思，良久，对基本剑法似有所悟。\n", v1);
    v1->improve_skill("sword", random(v1->query("int") * 10));
    v1->add("jing", -5);
    if (!v1->is_busy()) {
        v1->start_busy(random(3) + 1);
    }
    return 1;
}
