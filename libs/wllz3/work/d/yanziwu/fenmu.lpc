inherit "/inherit/room/room";
void create();
void init();
int do_ketou();

void create() {
    set("short", "坟场");
    set("long", "这里是慕容氏的坟场, 慕容氏死后都要被安葬这里,世世代代,无一例\r\n外。每到清明时分, 慕容后裔都要在这里祭祖。场中一座新坟格外引\r\n人住目, 那是慕容复之父慕容博之墓。\r\n");
    set("exits", ([ "west" : "/d/yanziwu/xiaojing1-4" ]));
    set("book_count", 1);
    setup();
}

void init() {
    if (!this_player()->query_temp("ketou_times")) {
        this_player()->set_temp("ketou_times", random(this_player()->query_skill("force", 1)) + 1);
    }
    add_action("do_ketou", "ketou");
}

int do_ketou() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->is_busy() || v1->is_fighting()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (!v1->query_temp("ketou_times")) {
        message_vision("$N磕头磕得晕了过去。\n", v1);
        v1->set_temp("ketou_times", random(v1->query_skill("force", 1)) + 1);
        v1->unconcious();
        return 1;
    }
    v1->add_temp("ketou_times", -1);
    message_vision("$N虔诚地跪下来，在墓碑面前磕头。\n", v1);
    if (random(30) == 10 && !present("force book", v1) && query("book_count") >= 1) {
        add("book_count", -1);
        v2 = clone_object("/d/yanziwu/npc/obj/neigong-book");
        v2->move(this_object());
        tell_object(v1, "突然你面前，啪地一声掉下一本内功心法！\n");
    }
    if (v1->query("jing") < 0) {
        write("你太累了，歇会再磕头吧！\n");
        return 1;
    }
    if (v1->query_skill("force", 1) >= 30 && v1->query_skill("force", 1) <= 100 && present("force book", v1)) {
        v1->receive_damage("jing", 20);
        v1->improve_skill("force", v1->query("int"));
        if (!random(5)) {
            tell_object(v1, "冥冥之中，你似乎觉得解决了你在内功方面的疑难。\n");
        }
    }
    return 1;
}
