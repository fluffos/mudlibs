inherit "/inherit/room/room";
void create();
int init();
int do_ta(mixed);
int do_jump(mixed);

void create() {
    set("short", "闺房");
    set("long", "这里是山庄庄主女儿的闺房，里面透着一股醉人的少女芳香，令你陶醉。\n在闺房的一角摆放着一张梳妆台，台上摆着一些女人用的胭脂粉和用来\n涂抹嘴唇的香粉，以及一瓶玉露。房屋的另一角摆放着一张闺床，一缕\n青纱低垂下来。墙上有一个窗户，一扇窗子(window)大敞着。\n");
    set("no_fight", 1);
    set("objects", ([ "/d/yanziwu/obj/paper" : 1 ]));
    set("item_desc", ([ "window" : "窗台上有一个小巧的脚印(sign)。\n", "sign" : "几只可爱的小脚印，看上去向一种美妙的步法，你不住想踏上去。\n" ]));
    set("exits", ([ "west" : "/d/yanziwu/c14-4" ]));
    setup();
}

int init() {
    add_action("do_ta", "ta");
    add_action("do_jump", "jump");
}

int do_ta(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!living(this_player()) || arg != "sign") {
        return 0;
    }
    if (v1->query_skill("dodge", 1) > 31) {
        return notify_fail("你踏上可爱的小脚印，但是已经无法提高你的基本轻功了。\n");
    }
    if (v1->query("jing") < 30) {
        v1->receive_damage("jing", 10);
        write("你太累了，已经抬不起脚了！\n");
        return 1;
    }
    v1->receive_damage("jing", random(25));
    message_vision("$N正在踏着窗台上的小脚印。\n", v1);
    write("你踏着小脚印，使你的基本轻功又进了一步。\n");
    v1->improve_skill("dodge", v1->query("int"));
    return 1;
}

int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (arg != "window") {
        return notify_fail("你要干什么？\n");
    }
    if (arg == "window") {
        write("你一纵身，从窗户跳了下去。\n");
        message("vision", v1->name() + "从窗户跳了下去。\n", environment(v1), ({ v1 }));
        v1->move("/d/yanziwu/ytyuan1");
        message("vision", v1->name() + "从墙上的窗户中跳了下来。\n", environment(v1), ({ v1 }));
    }
    return 1;
}
