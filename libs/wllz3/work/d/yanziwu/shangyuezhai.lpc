int do_wudao(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = this_player();
    v3 = v2->query_temp("weapon");
    if (!v3 || v3->query("skill_type") != "blade") {
        return notify_fail("你手中无刀，怎么练？\n");
    }
    v1 = v2->query_skill("blade", 1);
