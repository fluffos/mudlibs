void init() {
    add_action("do_break", "break");
    add_action("do_jump", "jump");
}

int do_break(mixed arg) {
    mixed v1;
    v1 = this_player()->query("neili");
    if (!arg || arg != "shi") {
        write("你要打碎什么的东西！\n");
        return 1;
    }
    message_vision("$N深吸一口气，双掌同时拍出。\n", this_player());
    if (v1 >= 200) {
        message_vision("$N只听一声“轰”的一声，$N把岩石震开了！发现有一个洞口。\n", this_player());
        set("exits/down", "/d/yanziwu/shandong");
        this_player()->set("neili", v1 - 200);
        remove_call_out("close");
        call_out("close", 5, this_object());
    } else {
        message_vision("$N大吼一声“开！”，结果什么也没发生。看来$N的内力不够强。\n", this_player());
        this_player()->set("neili", 0);
    }
    return 1;
}

void close(mixed arg) {
    message("vision", "岩石滚回了原位，又挡住了洞口。\n", arg);
    arg->delete("exits/down");
}

int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (arg != "shuichi") {
        return notify_fail("你要到那去？\n");
    }
    if (arg == "shuichi") {
        write("你纵身跃起跳回了水池边。\n");
        message("vision", v1->name() + "一纵身跳了过去。\n", environment(v1), ({ v1 }));
        v1->move("/d/yanziwu/shuichi");
        message("vision", v1->name() + "从水池中跳了过来。\n", environment(v1), ({ v1 }));
    }
    return 1;
}
