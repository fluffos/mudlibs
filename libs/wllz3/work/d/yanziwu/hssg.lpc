inherit "/inherit/room/room";
void create();
int init();
int do_kan(mixed);

void create() {
    set("short", "还施水阁");
    set("long", "这就是举世闻名的姑苏慕容的还施水阁，这里据说有很多武林人事向\n往以久的武功。只见墙上有一个书架子(shujia)，上面摆满了各种武籍。\n");
    set("exits", ([ "south" : "/d/yanziwu/jiabi" ]));
    set("item_desc", ([ "shujia" : "书架上各个门派的武功秘籍(miji)，你忍不住想拿起一本就翻看起来。\n" ]));
}

int init() {
    add_action("do_kan", "kan");
    add_action("do_kan", "du");
    add_action("do_kan", "yandu");
    add_action("do_kan", "lingwu");
    add_action("do_kan", "study");
}

int do_kan(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = v1->query_skill("douzhuanxingyi", 1);
    if (!living(this_player()) || arg != "miji") {
        return 0;
    }
    if (v1->query("family/master_name") != "慕容复") {
        return 0;
    }
    if (v1->query_skill("literate", 1) < 1) {
        return notify_fail("你是个文盲，先学点文化(literate)再领悟斗转星移吧。\n");
    }
    if (v1->query_skill("parry", 1) < 160) {
        return notify_fail("凭你现在的招架功夫，无法领悟斗转星移这么高深的武功。\n");
    }
    if (v2 < 200) {
        return notify_fail("你看了半天书架上的武功秘籍，结果对你来说太深奥了！\n");
    }
    if (v2 > 300) {
        return notify_fail("恭喜恭喜！你已经融会贯通了斗转星移的绝妙之处！\n");
    }
    if (v1->query("jing") < 30) {
        v1->receive_damage("jing", 10);
        write("你太累了，已经没有力气来领悟斗转星移了！\n");
        return 1;
    }
    if (v1->is_busy()) {
        write("你正忙着呢。\n");
        return 1;
    }
    if (!v1->can_improve_skill("douzhuangxinyi")) {
        return notify_fail("也许是等级太低，对秘籍上的武功你总是无法理解。\n");
    }
    v1->receive_damage("jing", random(50));
    message_vision("$N正在低头沉思有关斗转星移的种种疑难。\n", v1);
    write("你静静地钻研各家门派的武功秘籍，冥冥之中你的斗转星移又进了一步。\n");
    v1->improve_skill("douzhuanxingyi", v1->query_skill("parry"));
    if (!v1->is_busy()) {
        v1->start_busy(random(3) + 1);
    }
    return 1;
}
