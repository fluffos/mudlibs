inherit "/inherit/room/room";
void create();
void init();
int do_kan(mixed);
private void cutting(mixed);
private void end_cutting(mixed);

void create() {
    set("short", "树林");
    set("long", "这里是城郊的树林，这里的树木葱茏茂密，一进来就给人一种放松的\n感觉。有些树起码有百年以上的树龄。一棵数旁边竖着一块牌子(sign)，\n上面好象写了些什么。 \n");
    set("item_desc", ([ "sign" : "为了保持生态平衡，请不要乱砍乱伐！\n" ]));
    set("exits", ([ "east" : "/d/foshan/road14" ]));
    set("outdoors", "foshan");
    setup();
}

void init() {
    add_action("do_kan", "kan");
}

int do_kan(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->is_fighting()) {
        return notify_fail("一心不能二用！！\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢！！\n");
    }
    if (v1->query_temp("finish_famu")) {
        return notify_fail("你的任务已经完成了，回去交差吧！\n");
    }
    if (!arg || arg != "树") {
        return notify_fail("你要砍什么？\n");
    }
    if (v1->query("qi") < 20 || v1->query("jing") < 20) {
        return notify_fail("你太累了，小心身体要紧！\n");
    }
    if (v1->query_temp("cutting")) {
        return notify_fail("你正在砍树呢！\n");
    }
    if (!present("fu tou", v1)) {
        return notify_fail("没有斧头怎么砍呀？\n");
    }
    if (v1->query_temp("famu") <= 0) {
        return notify_fail("你想干吗？这里不允许你砍树的。\n");
    }
    v1->set_temp("cutting", 1);
    message_vision("$N挥起斧头，猛的往树干上砍去.....\n", v1);
    call_out("cutting", 1, v1);
    return 1;
}

private void cutting(mixed arg) {
    if (!arg) {
        return;
    }
    if (arg->query("kar") < random(15) + 10) {
        message_vision("\e[1;33m“啪”的一声，$N的斧头落在树干上，却被卡得紧紧的，拔不出来。\n\e[2;37;0m", arg);
        arg->start_busy(1);
        arg->add("qi", -random(5));
        arg->delete_temp("cutting");
        return;
    }
    if (arg->query("int") < random(15) + 15) {
        message_vision("\e[1;31m$N用力过猛，斧柄打到$N的手臂，一股酸痛.......\n\e[2;37;0m", arg);
        arg->add("jing", -random(10));
        arg->add("qi", -random(10));
        arg->delete_temp("cutting");
        return;
    }
    if (arg->query_temp("cuttimes") > random(10) + 8) {
        arg->set_temp("finish_famu", arg->query_temp("cuttimes"));
        arg->delete_temp("cutting");
        arg->delete_temp("cuttimes");
        call_out("end_cutting", 1, arg);
        return;
    }
    if (present(arg)) {
        message_vision("\e[1;33m“啪”的一声，$N斧头落在树干上，留下一道深深的口子。\n\e[2;37;0m", arg);
        arg->add("qi", -random(8));
        arg->add("jing", -random(8));
        arg->add_temp("cuttimes", 1);
        arg->delete_temp("cutting");
        return;
    }
}

private void end_cutting(mixed arg) {
    mixed v1;
    if (!arg) {
        return;
    }
    write("\e[1;37m只听见啪嗒一声，一块木头掉了出来。\n\e[2;37;0m");
    message_vision("$N花了九牛二虎之力，终于把树干砍了下来。\n", arg);
    v1 = clone_object("/clone/misc/wood");
    v1->move(arg);
    return;
}
