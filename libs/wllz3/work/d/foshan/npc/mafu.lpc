void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    say("马夫点头哈腰地说道：这位客官，是想到这里挑一匹好马吧？\n");
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg1->query_temp("is_riding")) {
        message_vision("马夫邹起眉头，说到：这位客倌您不正骑着马吗？\n", arg1);
        return 0;
