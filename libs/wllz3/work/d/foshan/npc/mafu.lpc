    if ("/adm/daemons/transd"->query_trans_info(arg)) {
        v2 = "/adm/daemons/transd"->query_trans_info(arg);
        v1->move(v2["room"]);
        tell_object(v1, sprintf("你骑着骏马，转眼之间，已经来到了%s。\n", v2["name"]));
        tell_room(environment(v1), "骏马一声嘶鸣，驮着一个身影出现在人群之中，仔细一看，那正是" + v1->name() + "。\n", ({ v1 }));
        v1->delete_temp("marks/horserent");
        return 1;
    } else {
        message_vision("马夫疑道：咦？莫非路线有误？请联系巫师。\n", this_object());
    }
