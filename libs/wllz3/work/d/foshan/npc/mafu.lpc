    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!v1->query_temp("marks/horserent")) {
        message_vision("马夫恶狠狠的对$N说道：没钱想坐马车？一边凉快去。\n", v1);
        return 1;
    }
    if (!arg || arg == "") {
        message_vision("马夫说道：客官想去哪？\n", this_object());
        return 1;
    }
    if (member_array(arg, run_trans) == -1) {
        message_vision("马夫摇摇头说道：本店没有 " + arg + " 这个路线。\n", this_object());
        return 1;
    }
