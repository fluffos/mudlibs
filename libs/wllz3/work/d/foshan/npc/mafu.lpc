        message_vision("马夫对$N说：好！这位" + "/adm/daemons/rankd"->query_respect(arg1) + "现在就出发吗？那就上马吧。\n", arg1);
        arg1->set_temp("marks/horserent", 1);
        return 1;
    } else {
        message_vision("马夫皱眉对$N说：您给的也太少了吧？\n", arg1);
    }
    return 1;
}

