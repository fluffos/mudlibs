inherit "/inherit/room/room";
void create();
void init();
int do_mobai();

void create() {
    set("short", "关帝庙");
    set("long", "这里是桃源城里的关帝庙，每逢正月十五，关帝庙里便是人头攒攒，\n进香拜关帝的人更是络绎不绝。只见关帝庙中有一个香案，一个红脸的菩\n萨端坐香案之上，他便是传说中的关帝老爷了。关帝庙两旁的墙壁已经被\n长年的香火熏得乌黑，可以看出，这里香火极为旺盛。旁边竖着一块牌子\n(sign)，好象写着什么。\n");
    set("exits", ([ "south" : "/d/center/roadn5" ]));
    set("objects", ([ "/d/center/npc/jinxiangke" : 4 ]));
    set("item_desc", ([ "sign" : "$MAG$\n\n心诚则灵！拜(mobai)关帝者，可化杀气为祥和！\n\n$NOR$\n" ]));
    set("restrict_action", 1);
    set("no_sleep_room", 1);
    set("no_fight", 1);
    set("no_magic", 1);
    set("no_spells", 1);
    set("no_steal", 1);
    set("no_beg", 1);
    setup();
}

void init() {
    add_action("do_mobai", "mobai");
}

int do_mobai() {
    mixed v1;
    v1 = this_player();
    if (v1->query("jing") <= 50) {
        return notify_fail("你的精不够。\n");
    }
    if (v1->query("bellicosity") < 1) {
        return notify_fail("你耳边似乎传来一个声音说道：心诚则灵！\n");
    }
    message_vision("$N虔诚地跪在关帝塑像前磕了个头。\n", v1);
    v1->receive_damage("jing", 50);
    if (v1->query("bellicosity") > 10) {
        v1->add("bellicosity", -(v1->query("bellicosity") / 5) - 1);
    } else {
        v1->set("bellicosity", 0);
    }
    write("\e[1;36m你的杀气降低了，心中一片祥和！\n\e[2;37;0m");
    return 1;
}
