inherit "/inherit/room/room";
int do_wash();
void curehimup(mixed);
void create();
void init();

int do_wash() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = random(60 - v1->query("con")) * 2;
    if (v2 <= 20) {
        v2 = 21;
    }
    if (v1->query_temp("be_wash") > random(10) + 10) {
        message_vision("\e[1;31m$N一声惊叫：“啊！”，不小心把皮搓破了。\n\e[2;37;0m", v1);
        v1->unconcious();
        v1->delete_temp("be_wash");
        return 1;
    }
    if (v1->query_temp("wash")) {
        if (query("women")) {
            message_vision("$N一边搓背，一边唱着：上冲冲下洗洗，左搓搓右揉揉，我家的浴缸，好好坐～\n", v1);
        } else {
            message_vision("$N一边搓背，一边唱着：洗白白，搓白白，我左搓右搓上搓下搓 . . . \n", v1);
        }
        v1->add_temp("be_wash", 1);
        return 1;
    }
    message_vision("\e[1;37m$N噗嗵一声跳进浴池，立刻激起一道水花。\n\e[2;37;0m", v1);
    tell_object(v1, "你感到全身无比的舒泰. . . .\n");
    v1->set_temp("wash", 1);
    call_out("curehimup", v2, v1);
    return 1;
}

void curehimup(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = arg->query("max_qi");
    v2 = arg->query("max_jing");
    if (arg && environment(arg) == this_object()) {
        tell_object(arg, "\e[1;37m过了好一阵子，你的精神已经恢复了！\n\e[2;37;0m");
        arg->set("eff_qi", v1);
        arg->set("eff_jing", v2);
        arg->set("qi", v1);
        arg->set("jing", v2);
        arg->delete_temp("wash");
    }
    return;
}

void create() {
    set("short", "枫叶泉");
    set("long", "枫叶泉是方圆五百里最著名的一口温泉。水温适中，泉水呈淡红，故\r\n而得名枫叶。它不但有去腐生肌的奇效，据说还有延年益寿的妙用。武林\r\n第一美人每天都以此泉水浣面（ｗａｓｈ），来保持她如花似玉的容貌。\r\n");
    set("exits", ([ "east" : "/d/center/bathhouse_f3" ]));
    set("objects", ([ "/d/center/npc/nude_lady" : 2 ]));
    set("women", 1);
    setup();
    create_door("east", "檀木门", "west", 1);
}

void init() {
    add_action("do_wash", "wash");
}

int valid_leave(mixed arg1, mixed arg2) {
    if (arg2 == "east" && arg1->query_temp("wash")) {
        return notify_fail("你还没泡完呢就想走？\n");
    }
    return 1;
}
