int do_skills(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!id(arg) || !v1->query_temp("mark/教头")) {
        return 0;
    }
    tell_object(v1, name() + "说道：你可以从我这里学习以下这些武功：\n\n");
    write("教头目前共学会了十五种技能\n────────────────────────────────＝>\n【知识技能】\n────────────────────────────────＝>\n  御刀技巧(apply-blade)             等级 600  下次升级 361202 点\n  御棍技巧(apply-club)              等级 600  下次升级 361202 点\n  御轮技巧(apply-hammer)            等级 600  下次升级 361202 点\n  御枪技巧(apply-spear)             等级 600  下次升级 361202 点\n  御杖技巧(apply-staff)             等级 600  下次升级 361202 点\n  御剑技巧(apply-sword)             等级 600  下次升级 361202 点\n  御镖技巧(apply-throwin"
            "g)          等级 600  下次升级 361202 点\n  用鞭技巧(apply-whip)              等级 600  下次升级 361202 点\n────────────────────────────────＝>\n【武学技能】\n────────────────────────────────＝>\n□赤蟹枪法(chixie-qiang)            等级 200  下次升级  40402 点\n  基本轻功(dodge)                   等级 100  下次升级  10202 点\n  基本内功(force)                   等级 200  下次升级  40402 点\n  基本招架(parry)                   等级 100  下次升级  10202 点\n  基本枪法(spear)                   等级 200  下次升级  40402 点\n  基本拳脚"
            "(unarmed)                 等级 200  下次升级  40402 点\n────────────────────────────────＝>\n【特殊技能】\n────────────────────────────────＝>\n  听风辨器(perception)              等级 100  下次升级  10202 点\n────────────────────────────────＝>\n");
    return 1;
}

int recognize_apprentice(mixed arg) {
    if (!arg->query_temp("mark/教头")) {
        tell_object(arg, name() + "说道：咦？我不记得收过你这个学生啊....\n");
        return 0;
    }
    arg->add_temp("mark/教头", -1);
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->query("money_id") && arg2->value() >= 1000) {
        tell_object(arg1, name() + "点了点头，说道：很好，" + "从今天起你随时可以来向我学习各种粗浅功夫。\n");
        arg1->add_temp("mark/教头", arg2->value() / 10);
        return 1;
    }
}
