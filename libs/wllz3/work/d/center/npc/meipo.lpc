    set("rank_info/respect", "老婆婆");
    set("attitude", "friendly");
    set("gender", "女性");
    set("age", 45);
    set("level", 20);
    set("env/wimpy", 50);
    set("inquiry", ([ "婚约" : "是啊....这里就可以缔结和解除婚约。" ]));
    setup();
    carry_object("/clone/cloth/cloth")->wear();
    carry_object("/clone/cloth/silver-clasp")->wear();
    add_money("silver", 20);
}

