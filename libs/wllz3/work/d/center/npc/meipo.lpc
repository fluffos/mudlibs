    }
    if (!objectp(v2 = present(v1->query_temp("marry/marry_id"), environment(v1))) || !find_player(v1->query_temp("marry/marry_id"))) {
        return notify_fail("媒婆说道：你的爱人现在离开了，婚礼只好中断。\n");
    }
    if (!arg) {
        return notify_fail("媒婆笑道：你乱拜什么呀？\n");
    }
    if (v1->query_temp("pending/pro") == 1 && arg != "天地" || v1->query_temp("pending/pro") == 2 && arg != "高堂" || v1->query_temp("pending/pro") == 3 && arg != v1->query_temp("marry/marry_name")) {
        return notify_fail("媒婆笑道：你乱拜什么呀？\n");
