        return 1;
    } else {
        switch (v1->query_temp("pending/pro")) {
        case 1:
            "/adm/daemons/channeld"->do_channel(this_object(), "chat", "一拜天地！\n");
            v1->add_temp("pending/pro", 1);
            return 1;
        case 2:
            "/adm/daemons/channeld"->do_channel(this_object(), "chat", "二拜高堂！\n");
            v1->add_temp("pending/pro", 1);
