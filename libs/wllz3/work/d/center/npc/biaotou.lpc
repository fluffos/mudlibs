int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (arg2->query("money_id")) {
        if (!mapp(v2 = arg1->query("quest")) || v2["from"] != "镖局") {
            command("say 这位" + "/adm/daemons/rankd"->query_respect(arg1) + "莫非是有要事委托？");
            return 0;
        }
        if (arg2->value() < 3000) {
            command("say 这位" + "/adm/daemons/rankd"->query_respect(arg1) + "未必也太小看我们镖局了吧？！");
            return 0;
        }
        if (arg1->query("quest")) {
            command("say 好吧，我让其他趟子手去做！你下去休息吧！");
            if (objectp(v1 = arg1->query("quest/obj"))) {
                destruct(v1);
            }
            if (arg1->query("weiwang") > 20) {
                arg1->add("weiwang", -20);
            }
            arg1->set("quest/fail_time", time() + 60);
            arg1->start_call_out((: call_other, "/d/center/npc/biaotou.lpc", "remove_quest", arg1 :), 60);
            arg1->delete_temp("counts");
            return 1;
        }
    }
    command("say 这位" + "/adm/daemons/rankd"->query_respect(arg1) + "莫非是有要事委托？");
    return 0;
}

void reset() {
    if (query("yudaiyan")) {
        delete("yudaiyan");
    }
}

void remove_quest(mixed arg) {
    if (!arg || !environment(arg)) {
        return;
    }
    tell_object(arg, "\e[1;37m你在镖局的任务已经由其他趟子手完成了。\n\e[2;37;0m");
    arg->delete("quest");
    return;
}
