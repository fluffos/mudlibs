string ask_job() {
    mixed v1;
    v1 = this_player();
    if (v1->query("marks/都大锦")) {
        return "多谢这位" + "/adm/daemons/rankd"->query_respect(v1) + "相救，解决了我们镖局的一件大事。";
    }
    if (v1->query_temp("ask_dudajin")) {
        return "请这位" + "/adm/daemons/rankd"->query_respect(v1) + "赶紧动身，将镖送到武当山去。";
    }
    if (query("yudaiyan")) {
        return query("yudaiyan") + "已经替我们镖局将俞岱岩俞大侠送走了，我也终于可以放心了！";
    }
    v1->set_temp("ask_dudajin", 1);
    say(this_object()->name() + "说道：这位" + "/adm/daemons/rankd"->query_respect(v1) + "，实不相瞒，前些日子我们镖局来了一个女扮男妆\n的人，送来了一个已经奄奄一息的人，要我们送到武当山去。老夫仔细一\n看那正是武当派的俞岱岩俞大侠，伤重之势，唯恐已经时日不久了。那人\n悬银五万两，将镖送到武当山去，否则杀光我们镖局上下所有人。可是，\n我们与武当派素无来深，唯恐武当派误会俞大侠是遭我龙门镖局的毒手......\n");
    return "要是这位" + "/adm/daemons/rankd"->query_respect(v1) + "能将镖银代我们送去，那在下真是感激不尽啊。";
}

string ask_biaoyin() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query("marks/都大锦") || !v1->query_temp("ask_dudajin")) {
        return "镖局目前尚无镖银可送，这位" + "/adm/daemons/rankd"->query_respect(v1) + "还是请回吧。";
    }
    if (v1->query_temp("get_biaoyin")) {
        return "那俞大侠就有劳" + "/adm/daemons/rankd"->query_respect(v1) + "替我送去了。";
    }
    say(this_object()->name() + "回头对两个趟子说道：把俞大侠抬出来。\n两个趟子手抱拳道：是！\n不一会儿，从内堂中抬出了一个奄奄一息的人。你仔细一看，那人正是武当派的俞岱岩。\n");
    v2 = clone_object("/d/center/npc/yudaiyan");
    v2->move(environment(v1));
    v2->unconcious();
    v1->set_temp("get_biaoyin", 1);
    v1->set_temp("get_yu", v2);
    set("yudaiyan", v1->name(1));
    return "这位" + "/adm/daemons/rankd"->query_respect(v1) + "，那俞大侠就有劳您照顾了。";
}

