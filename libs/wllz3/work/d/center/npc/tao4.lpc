void relay_emote(mixed arg1, mixed arg2) {
    if (!userp(arg1)) {
        return;
    }
    switch (arg2) {
    case "kick":
        if (random(10) < 5) {
            command("say 为什麽踢我？会痛耶！");
            break;
        }
    case "18mo":
    case "mo":
    case "hug":
    case "kiss":
    case "nocloth":
        if (arg1->query("gender") == "男性" || arg1->query("gender") == "无性") {
            command("say 这算啥，" + arg1->query("name") + "！我就喜欢这个调调儿！\n");
            command("say 谁想得到这" + "/adm/daemons/rankd"->query_rude(arg1) + "，竟然有龙阳之好。\n");
        } else {
            command("giggle");
            command("say 想不到" + arg1->query("name") + "自动把豆腐送上来了。再开心没有了！");
        }
        message_vision("$N摇了摇头，对$n幽幽叹道：唉，你这又是何苦呢？\n", this_object(), this_player());
    default:
        if (random(10) < 5) {
            command(arg2 + " " + arg1->query("id"));
        } else {
            drool();
        }
    }
}

