void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    switch (random(5)) {
    case 0:
        say(name() + "疑道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，你知道去桃源的路怎么走吗？\n");
        if (!arg->is_busy()) {
            arg->start_busy(random(3));
        }
        break;
    case 1:
        say(name() + "笑呵呵的问道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，你知道哪里可以存钱吗？\n");
        if (!arg->is_busy()) {
            arg->start_busy(random(3));
        }
        break;
    case 2:
        say(name() + "一把拉住你问道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，你知道这里的当铺在哪吗？\n");
        if (!arg->is_busy()) {
            arg->start_busy(random(3));
        }
        break;
    case 3:
        say(name() + "说道：" + "/adm/daemons/rankd"->query_respect(arg) + "，你知道哪有去扬州的马车吗？\n");
        if (!arg->is_busy()) {
            arg->start_busy(random(3));
        }
        break;
    case 4:
        say(name() + "疑道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，你知道这是哪吗？\n");
        if (!arg->is_busy()) {
            arg->start_busy(random(3));
        }
        break;
    }
}

