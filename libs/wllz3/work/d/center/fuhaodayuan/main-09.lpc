inherit "/inherit/room/room";
int compelete_wash(mixed);
int halt_work(mixed);
void create();
void init();
int do_xi(mixed);

void create() {
    set("short", "厨房");
    set("long", "这里是富豪大院的厨房，一个半人高的灶头筑在厨房的墙边。一个年\n越六旬的老者正在灶头边上做菜，看来是快到开饭的时候了，一股饭菜喷\n香扑鼻而来。厨房的西边角落里放着一张残旧的大木桌，上面放着一些碗\n筷还没有洗呢！\n");
    set("exits", ([ "west" : "/d/center/fuhaodayuan/main-07" ]));
    set("objects", ([ "/d/center/fuhaodayuan/npc/huotou" : 1 ]));
    setup();
}

void init() {
    add_action("do_xi", "xi");
}

int do_xi(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg != "碗") {
        return notify_fail("你要干什么？\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("边洗碗边打架？你是神仙呀？！\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢！！\n");
    }
    if (v1->query("brawn") < 20) {
        return notify_fail("你太累了，还是休息一下吧！\n");
    }
    if (v1->query_temp("wash_finish") >= 1) {
        return notify_fail("这里碗都洗干净了，快去交差吧！\n");
    }
    if (v1->query_temp("wash_job") != 1) {
        return notify_fail("人家又没有请你，你喜欢白干呀？\n");
    }
    message_vision("$N拿着一条抹布，轻轻的擦拭着瓷碗。\n", v1);
    v1->set_short_desc("手里拿着一条抹布，轻轻的擦拭着瓷碗。");
    v1->start_busy((: compelete_wash :), (: halt_work :));
    return 1;
}

int compelete_wash(mixed arg) {
    if (!arg) {
        return 0;
    }
    if (environment(arg) != this_object()) {
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->add_temp("job_times", 1) > random(5) + 10) {
        write("碗已经洗好了，你终于完成了任务，人也累坏了。\n");
        arg->set_short_desc(0);
        arg->set_temp("wash_finish", 1);
        return 0;
    }
    if (arg->query("brawn") < 20) {
        write("你实在累得不行了，于是停了下来，休息一会。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (random(50) == 25) {
        write("你一不小心，把手中的碗全部打翻了。\n");
        arg->add("brawn", -random(5));
        return 1;
    }
    if (random(100) > 60) {
        write("你一不小心，瓷碗跌落在地，应声碎做两半。\n");
        arg->add("brawn", -random(5));
        return 1;
    }
    write("你显得十分勤快，把瓷碗洗得干干净净。\n");
    arg->add("brawn", -2);
    return 1;
}

int halt_work(mixed arg) {
    write("你实在累得不行了，于是停了下来，休息一会。\n");
    arg->set_short_desc(0);
    return 1;
}
