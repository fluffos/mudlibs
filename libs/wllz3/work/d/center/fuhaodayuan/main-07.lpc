}

int do_sao(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1 != this_player(1)) {
        return 0;
    }
    if (!arg || arg != "地") {
        return notify_fail("你要干什么？\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("你正在战斗中！\n");
    }
    if (!present("sao ba", v1)) {
        return notify_fail("没有扫把怎么扫地呀？\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢！！\n");
    }
    if (v1->query("brawn") < 20) {
        return notify_fail("你太累了，还是休息一下吧！\n");
    }
    if (v1->query_temp("clean_finish") >= 1) {
        return notify_fail("这里已经打扫完了，快去交差吧！\n");
    }
    if (v1->query_temp("clean_job") != 1) {
        return notify_fail("人家又没有请你，你喜欢白干呀？\n");
    }
    message_vision("$N拿着扫把，仔细的打扫着这里的每一个角落。\n", v1);
    v1->set_short_desc("手里拿着扫把，仔细的打扫着这里的每一个角落。");
    v1->start_busy((: compelete_sao :), (: halt_work :));
    return 1;
}

int compelete_sao(mixed arg) {
    if (!arg) {
        return 0;
    }
    if (!arg || environment(arg) != this_object()) {
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->add_temp("job_times", 1) > random(5) + 10) {
        write("这里已经打扫干净了，你终于完成了任务，人也累坏了。\n");
        arg->set_temp("clean_finish", 1);
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->query("brawn") <= 20) {
        write("你觉得有点累了，于是停了下来，休息一会。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (random(50) == 25) {
        write("你把一堆树叶扫成一堆，谁知一阵狂风吹来，落叶漫天飞舞.....\n");
        arg->add("brawn", -random(5));
        return 1;
    }
    if (random(100) > 60) {
        write("你用力过猛，扫把头被你给甩了出来，不偏不倚还打在你的头上。\n");
        arg->add("brawn", -random(5));
        return 1;
    }
    write("只听见唰唰的声响，这里在你的打扫下，显得干净了许多。\n", arg);
    arg->add("brawn", -2);
    return 1;
}

int halt_work(mixed arg) {
    write("你实在累得不行了，于是停了下来，休息一会。\n");
    arg->set_short_desc(0);
    return 1;
