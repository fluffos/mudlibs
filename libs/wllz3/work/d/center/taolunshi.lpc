int do_join(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢！\n");
    }
    if (v1->query("jing") < 30) {
        return notify_fail("你现在精神不好，还是先别讨论了。\n");
    }
    if (v1->query("brawn") < 20) {
        return notify_fail("你体力不支，还是别讨论。\n");
    }
    if (v1->query("level") < 10) {
        return notify_fail("凭你这点功夫，就想和大家一起讨论？\n");
    }
    if (v1->query_skill("literate", 1) < 10) {
        return notify_fail("你还是个文盲，先去学点读书识字再说吧！\n");
    }
