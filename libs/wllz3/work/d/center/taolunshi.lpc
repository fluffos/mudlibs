    }
    write(random(5) == 2 ? "你和大家一起畅谈武林中的各种绝学，似乎有点心得。\n" : "你和大家一起讨论各路门派的奇门绝学，似乎有点心得。\n");
    arg->add("brawn", -5);
    arg->receive_damage("jing", 25);
