int compelete_join(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg) {
        return 0;
    }
    if (environment(arg) != this_object()) {
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->query("jing") < 10) {
        write("你觉得有点累了，于是停下来休息一会。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->query("brawn") < 20) {
        write("你觉得有点累了，于是停下来休息一会。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->add_temp("pending/with_join", 1) > 30) {
        write("你和大家讨论了很久，似乎收益不小。\n");
        arg->set_short_desc(0);
        arg->delete_temp("pending/with_join");
