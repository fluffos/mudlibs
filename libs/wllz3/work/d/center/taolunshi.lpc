        v2 = (random(v1) + 1) / 3 + 1;
        v3 = (random(v1) + 1) / 3 + 1;
        if (v2 > 50) {
            v2 = random(40) + 10;
        }
        if (v3 > 50) {
            v3 = random(40) + 10;
        }
        arg->add_points(arg, v3);
        arg->add_exp(arg, v2);
