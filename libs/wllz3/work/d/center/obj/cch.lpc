    }
    v1 = random(6);
    if (v4->query("num") == v1) {
        v1 = random(6);
    }
    v2 = "拿起骰子在手中摇了两摇, 掷出了一个：\n";
    v2 += tossText[6] + tossText[v1] + tossText[7];
    message_vision("$N" + v2, v3);
    if (v4->query("name1")) {
        if (v4->query("num") > v1) {
            v4->set("first", v4->query("name1"));
        } else {
            v4->set("first", v3->name());
        }
        message_vision(v4->query("first") + "使用红色棋子先行。\n", v3);
    }
    v4->set("num", v1);
    if (v4->query("name1")) {
        v4->set("name2", v3->name());
    } else {
        v4->set("name1", v3->name());
    }
    if (v4->query("id1")) {
        v4->set("id2", v3->query("id"));
    } else {
        v4->set("id1", v3->query("id"));
    }
    return 1;
}

