// 本文件由编译后的 .b 二进制程序反编译还原，原始源码未随档案发布。
// Decompiled from the compiled .b binary; the original source was not distributed.
inherit "/inherit/room/room";
int compelete_work(mixed);
int halt_work(mixed);
void create();
void init();
int do_tang(mixed);

void create() {
    set("short", "后堂");
    set("long", "这里是布庄的后堂，后堂靠边的墙上，堆满了存货的一些布匹。由于\r\n后堂比较潮湿，布匹摸上去上去有些湿漉漉的感觉。几个伙计正在旁用熨\r\n斗，将布匹铺平熨(tang)干。\r\n");
    set("no_fight", 1);
    set("no_steal", 1);
    set("no_beg", 1);
    set("exits", ([ "north" : "/d/center/buzhuang" ]));
    setup();
}

void init() {
    add_action("do_tang", "tang");
}

int do_tang(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("gongzuo/yunbu")) {
        return notify_fail("你现在没有熨布的工作。\n");
    }
    if (!arg || arg != "布匹") {
        return notify_fail("你要熨烫什么？\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢！\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("你怎么能边打架边做事？\n");
    }
    if (v1->query("brawn") < 20) {
        return notify_fail("你太累了，休息一下再做吧。\n");
    }
    if (v1->query("qi") < 20) {
        return notify_fail("你现在气力不济，还是休息一下再做吧。\n");
    }
    if (v1->query_temp("gongzuo/finish")) {
        return notify_fail("布匹已经熨好了，快把熨好的布交回去吧！\n");
    }
    message_vision("$N拿起熨斗，慢慢地在布匹上来回移动 . . . \n", v1);
    v1->set_short_desc("手里拿着熨斗，小心翼翼的熨着布匹。");
    v1->start_busy((: compelete_work :), (: halt_work :));
    return 1;
}

int compelete_work(mixed arg) {
    mixed v1;
    if (!arg) {
        return 0;
    }
    if (environment(arg) != this_object()) {
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->add_temp("gongzuo/times", 1) > random(10) + 10) {
        v1 = clone_object("/d/center/obj/bu");
        v1->set_temp("work_by", arg);
        v1->move(arg, 1);
        arg->set_temp("gongzuo/finish", 1);
        arg->set_short_desc(0);
        write("布匹在熨烫下逐渐平整，你将布匹叠好后放在一边。\n");
        return 0;
    }
    if (arg->query("brawn") < 20 || arg->query("qi") < 20) {
        write("你觉得有点累了，于是停下来休息一会。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (random(10) > 7) {
        write("\e[31m你在蒸气缭绕之中逐渐开始漫不经心，只听得“哧”的一声你的手被熨斗碰了一下。\n\e[2;37;0m");
        arg->receive_damage("qi", 10);
    } else {
        write("只见布匹上冒了出一道白色的蒸气，显得平整了许多。\n");
    }
    return 1;
}

int halt_work(mixed arg) {
    write("你觉得有些累了，于是停了下来休息一会。\n");
    arg->set_short_desc(0);
    return 1;
}
