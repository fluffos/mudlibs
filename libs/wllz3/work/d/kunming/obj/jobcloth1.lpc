inherit "/inherit/item/item";
int compelete_cuo(mixed);
int halt_work(mixed);
void create();
void init();
int do_jin(mixed);
int do_cuo(mixed);
int do_pao(mixed);
void owner_is_killed();

void create() {
    set_name("\e[33m脏衣服\e[2;37;0m", ({ "zang yifu", "zang", "yifu", "cloth" }));
    set("long", "这是一件脏衣服，你可以将它拿去河边浸湿(jin)，然后搓一搓(cuo)，如\r\n果干净了就泡两下(pao)衣服就干净了。\r\n");
    set("jobnum", 0);
    set_weight(2000);
    if (clonep()) {
        set_default_object("/d/kunming/obj/jobcloth1.lpc");
    } else {
        set("material", "cloth");
        set("unit", "件");
        set("no_drop", "扔掉它是会挨骂的，还是算了吧。\n");
        set("no_give", "这么脏兮兮的东西，给人不怕笑话吗？。\n");
    }
    setup();
}

void init() {
    if (environment() == this_player()) {
        add_action("do_jin", "jin");
    }
    add_action("do_cuo", "cuo");
    add_action("do_pao", "pao");
}

int do_jin(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    v1 = this_object();
    if (!v2->query_temp("wash_job")) {
        return notify_fail("人家又没请你，你喜欢白干啊？\n");
    }
    if (!environment(v2)->query("kunming_job")) {
        return notify_fail("这个地方没有水，怎么洗衣服？\n");
    }
    if (v2->is_busy()) {
        return notify_fail("你上一个动作还没有完成。\n");
    }
    if (v1->query("jobnum") == 1) {
        return notify_fail("脏衣服已经浸湿了，开始搓吧。\n");
    }
    if (v1->query("jobnum") == 2) {
        return notify_fail("脏衣服已经搓好了，还是泡泡吧。\n");
    }
    if (v2->query("brawn") < 20) {
        return notify_fail("你已经累了，还是歇会吧。\n");
    }
    message_vision("$N将脏衣服打开，放到溪水里认真的一点点浸湿了。\n", v2);
    v1->set("jobnum", 1);
    v2->add("brawn", -2);
    return 1;
}

int do_cuo(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("wash_job")) {
        return notify_fail("人家又没请你，你喜欢白干啊？\n");
    }
    if (!environment(v1)->query("kunming_job")) {
        return notify_fail("这个地方没法洗衣服。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你上一个动作还没有完成。\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("战斗中不能做这件事情。\n");
    }
    if (v1->query("brawn") < 20) {
        return notify_fail("你已经累了，还是歇会吧。\n");
    }
    if (query("jobnum") == 2) {
        return notify_fail("脏衣服已经搓好了，还是泡泡吧。\n");
    }
    if (!query("jobnum")) {
        return notify_fail("脏衣服还没浸湿就搓了起来，想把衣服搓破啊？\n");
    }
    message_vision("$N将脏衣服放到石头上费力的搓了起来，一下、两下。\n", v1);
    v1->set_short_desc("正蹲在小溪旁搓洗衣服。");
    v1->start_busy((: compelete_cuo :), (: halt_work :));
    v1->add("brawn", -2);
    return 1;
}

int compelete_cuo(mixed arg) {
    if (!arg) {
        return 0;
    }
    if (environment() != arg) {
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->query("brawn") <= 20) {
        write("你实在累得不行了，于是停了下来，休息一会。\n");
        return 0;
    }
    if (arg->add_temp("job_time", 1) > random(8) + 15) {
        write("你将衣服搓了几下，拿起来看了看，好像干净了。\n");
        set("jobnum", 2);
        arg->set_short_desc(0);
        return 0;
    }
    arg->add("brawn", -2);
    write("你将脏衣服放到石头上费力的搓了起来，一下、两下。\n");
    return 1;
}

int halt_work(mixed arg) {
    write("你觉得有点累了，于是停下来休息一会。\n");
    arg->set_short_desc(0);
    return 1;
}

int do_pao(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v3 = this_player();
    v2 = this_object();
    if (!v3->query_temp("wash_job")) {
        return notify_fail("人家又没请你，你喜欢白干啊？\n");
    }
    if (!environment(v3)->query("kunming_job")) {
        return notify_fail("这个地方没法洗衣服。\n");
    }
    if (v3->is_busy()) {
        return notify_fail("你上一个动作还没有完成。\n");
    }
    if (!v2->query("jobnum") || v2->query("jobnum") == 1) {
        return notify_fail("衣服没洗就要泡，着什么急呀。\n");
    }
    if (v3->query("brawn") < 20) {
        return notify_fail("你已经累了，还是歇会吧。\n");
    }
    v1 = random(100);
    if (v1 < 15) {
        tell_object(v3, "\e[1;37m你一不小心，衣服居然随溪水跑了，唉，算是白洗了。\n\e[2;37;0m");
        v3->set_temp("jobcloth", 3);
        destruct(v2);
    } else {
        tell_object(v3, "你将洗好的衣服泡了泡，这件衣服就洗完了，应该可以拿回去交差了。\n");
        v3->set_temp("jobcloth", 2);
        v4 = clone_object("/d/kunming/obj/jobcloth2");
        v4->move(v3);
        destruct(v2);
    }
    v3->add("brawn", -2);
    return 1;
}

void owner_is_killed() {
    destruct(this_object());
}
