// 本文件由编译后的 .b 二进制程序反编译还原，原始源码未随档案发布。
// Decompiled from the compiled .b binary; the original source was not distributed.
inherit "/inherit/char/npc";
int ask_me();
int ask_job();
int accept_object(mixed, mixed);
int do_make(mixed);

void create() {
    set_name("念慈", ({ "nian ci", "ci" }));
    set("long", "她是这家防具店的老板念慈，年纪轻轻，脸上总是带着一种关爱的笑容。\n");
    set("gender", "女性");
    set("attitude", "friendly");
    set("rank_info/respect", "姑娘");
    set("inquiry", ([ "定制" : (: ask_me :), "防具" : "我们这里各式各样的防具都有，还可以定制你喜爱的服饰呢！", "定制防具" : (: ask_me :), "制作" : (: ask_me :), "job" : (: ask_job :), "工作" : (: ask_job :) ]));
    setup();
    carry_object("/clone/cloth/cloth")->wear();
    add_money("silver", 20);
}

void init() {
    add_action("do_make", "制作");
    add_action("do_make", "make");
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    if (arg2->query("money_id")) {
        if (!arg1->is_member()) {
            command("sahke");
            command("say 对不起，只有会员才可以自造防具。");
            return 0;
        }
        if (arg1->query("armor/make")) {
            command("say " + "/adm/daemons/rankd"->query_respect(arg1) + "已经有防具了，就不用再给钱了。");
            return 0;
        }
        if (arg1->query_temp("ask_make_armor") && arg2->value() >= 5000000) {
            command("nod");
            command("say 那好吧，请输入你定制的防具名称。make (防具中文名)");
            arg1->set_temp("give_make_paid", 1);
            return 1;
        }
        command("say 这点钱，还抵不上我们的布料和工费呢？！");
        return 0;
    } else if (arg2->query("name") == "干净衣服") {
        if (arg1->query_temp("jobcloth") != 2) {
            command("hmm");
            command("say 你不愿意干就不要干，拿别人洗好的衣服来交差，这又何必呢？。");
            return 1;
        } else {
            command("say 多谢，多谢，辛苦了，你去休息休息吧。");
            v2 = arg1->query("level");
            v2 += arg1->query_temp("job_time") * 2;
            v1 = arg1->query("level");
            v1 += arg1->query_temp("job_time") * 5;
            tell_object(arg1, "由于你帮念慈做好了工作，得到了一些奖励。\n");
            if (arg1->add_exp(arg1, v1) && arg1->add_points(arg1, v2)) {
                tell_object(arg1, "你还获得了一些银两做为报酬！\n");
                v3 = random(5) + 1;
                v4 = clone_object("/clone/money/silver");
                v4->set_amount(v3);
                v4->move(arg1, 1);
            }
            arg1->delete_temp("jobcloth");
            arg1->delete_temp("wash_job");
            arg1->delete_temp("job_time");
            return 1;
        }
    } else if (arg2->query("name") == "破衣服") {
        if (arg1->query_temp("jobcloth") != 3) {
            command("say 真是的，不知道又是谁丢的。");
            command("thank " + arg1->query("id"));
            return 1;
        } else {
            command("say 你也真是的，连洗衣服都洗不好！");
            arg1->delete_temp("jobcloth");
            arg1->delete_temp("wash_job");
            return 1;
        }
    } else {
        command("say 你给我这个干什么?");
        return 0;
    }
}

int ask_me() {
    mixed v1;
    v1 = this_player();
    if (v1->query("item/armor")) {
        command("say " + "/adm/daemons/rankd"->query_respect(v1) + "不是已经有了防具了吗？");
        return 1;
    }
    if (!v1->query_temp("give_make_paid")) {
        command("say 要定制防具可要交钱的，一件服饰要 500 两黄金。");
        v1->set_temp("ask_make_armor", 1);
        return 1;
    } else {
        command("say 请输入你定制的防具名称。make (防具中文名)");
        return 1;
    }
    return 0;
}

int do_make(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!v1->query_temp("give_make_paid")) {
        return 0;
    }
    if (!arg || arg == "") {
        return notify_fail(name() + "说道：请输入你定制的衣服名称。make (衣服中文名)\n");
    }
    if (sizeof(arg) > 4 || sizeof(arg) < 1) {
        return notify_fail(name() + "说道：衣服的名字必须为 1 到 4 个中文字。\n");
    }
    v3 = sizeof(arg);
    while (v3--) {
        if (arg[v3] <= 32) {
            return notify_fail(name() + "说道：对不起，你的中文名字不能用控制字元。\n");
        }
        if (!is_chinese(arg[v3..v3])) {
            return notify_fail(name() + "说道：对不起，请您用「中文」取名字。\n");
        }
    }
    message_vision("$N从柜子里拿出一包针线和一缎布匹，开始为$n缝制" + arg + "。\n不到一盏茶功夫，一件做工精致的" + arg + "便缝制好了。\n", this_object(), v1);
    v1->set("item/armor", 1);
    v2 = clone_object("/clone/item/armor");
    v2->set("name", arg);
    v2->set("owner_name", v1->name(1));
    v2->set("owner_id", v1->query("id"));
    v2->set("level", 1);
    v2->save();
    v2->set_owner(v1->name(1), v1->query("id"));
    v2->move(v1, 1);
    v1->delete_temp("give_make_paid");
    message_vision("$N把" + arg + "交到$n手中，说道：你现在可以用其他宝石、甲片来提高\n" + arg + "的坚韧度，如果出现损坏，你可以拿到我这里或其他成衣店里缝补。\n如果你喜欢，还可以购买一些染色剂，为你的" + arg + "染上你喜欢的颜色。\n", this_object(), v1);
    return 1;
}

int ask_job() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query("level") < 10) {
        command("shake");
        command("say 你是新来的，我这里的衣服那么贵重，怎么放心让你洗呢？");
        return 1;
    } else if (v1->query("level") >= 20) {
        command("shake " + v1->query("id"));
        command("say " + "/adm/daemons/rankd"->query_respect(v1) + "现在武功高强，这些活应该让下人去做吧？");
        return 1;
    } else if (v1->query_temp("jobcloth") == 1 || v1->query_temp("jobcloth") == 2) {
        command("hmm");
        command("say 有工作还来要，真是一个不安分的家伙。");
        return 1;
    } else if (v1->query_temp("jobcloth") == 3) {
        command("sigh");
        command("say 衣服丢了就算了吧,这里还有一件,你去洗洗吧。");
        v1->set_temp("jobcloth", 1);
        v2 = clone_object("/d/kunming/obj/jobcloth1");
        v2->move(v1, 1);
        return 1;
    }
    v1->set_temp("jobcloth", 1);
    v1->set_temp("wash_job", 1);
    v2 = clone_object("/d/kunming/obj/jobcloth1");
    v2->move(v1, 1);
    command("say 你愿意帮我们下人干活真是太好了。");
    command("say 这里有一些脏衣服，你拿到东门的小溪边去洗洗吧！");
    return 1;
}
