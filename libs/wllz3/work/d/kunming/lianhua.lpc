    add_action("do_jump", "jump");
}

int do_jump(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = v1->query_skill("dodge");
    if (!arg || arg == "") {
        return 0;
    }
    if (arg != "down" && arg != "ting") {
        return 0;
    }
    switch (arg) {
    case "down":
        message("vision", v1->name() + "向下跳去。\n", environment(v1), ({ v1 }));
        if (v2 < 30) {
            v1->move("/d/kunming/shijianchi");
            message("vision", "只啪的一大声，一个人从上面掉了下来，摔了个四荤五素。\n", environment(v1), ({ v1 }));
            v1->unconcious();
        } else {
            v1->move("/d/kunming/shijianchi");
            message("vision", "只见人影一闪" + v1->name() + "从上面跳了下来。\n", environment(v1), ({ v1 }));
            message("vinson", "你纵身向下一跳，稳稳的落在试剑池中间。\n", v1);
        }
        break;
    case "ting":
        if (v2 < 60) {
            return notify_fail("你的轻功还不足以跳过去！\n");
        } else {
            message("vision", v1->name() + "向望峰亭跃了过去。\n", environment(v1), ({ v1 }));
            v1->move("/d/kunming/wfting");
            message("vinson", "你纵身一跳，只觉身子轻飘飘的飞了出去！睁眼一看，已落在望峰亭上。 \n", v1);
        }
        break;
    }
    return 1;
}
