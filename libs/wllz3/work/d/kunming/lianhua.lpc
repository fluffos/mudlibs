    set("item_desc", ([ "zi" : "$CYN$\t\t     \r\n\t~~~~~~~~\r\n\t~      ~ \r\n\t~  天  ~ \r\n\t~      ~ \r\n\t~  下  ~ \r\n\t~      ~ \r\n\t~  第  ~   \r\n\t~      ~   \r\n\t~  一  ~   \r\n\t~      ~   \r\n\t~  奇  ~   \r\n\t~      ~   \r\n\t~  观  ~ \r\n\t~      ~    \r\n\t~~~~~~~~ $NOR$\r\n", "shi" : "\t \r\n\t 攀 登 直 欲 夺 天 工，\r\n\t 一 顶 凌 云 挈 众 峰；\r\n\t 不 是 猱 升 挥 汗 水，\r\n\t 何 来 双 手 抚 晴 空。\r\n\t \r\n", "tang" : "一个深不见底的水潭，名曰：剑池。池中有一石，名曰：试剑石。\r\n", "ting" : "一个小亭子，名为：望峰亭。建在一座独峰上，四周都是峭壁，无法攀登\r\n，如果要过去的话，只有从这里跳了！\r\n" ]));
