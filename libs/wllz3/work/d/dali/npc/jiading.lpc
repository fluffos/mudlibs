int ask_me() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_object();
    v2 = this_player();
    if (v2->query_skill("kurong-changong", 1) < 30) {
        command("say 你想当家臣，再练几年功夫去。\n");
        return 1;
    }
    if (stringp(v1 = v2->query("dali_title")) && (strsrch(v1, "大理镇南王府家奴") >= 0 || strsrch(v1, "大理镇南王府婢女") >= 0)) {
        v2->set_temp("fight_ok", 1);
        command("say 好，既然如此想切磋，那就看你的本事如何了。");
        return 1;
    } else {
        command("say 只有家奴或婢女才能升家臣。");
        return 1;
    }
}

int accept_fight(mixed arg) {
    mixed v1;
    v1 = this_object();
    if (!arg->query_temp("fight_ok")) {
        return 0;
    }
    remove_call_out("checking");
    call_out("checking", 1, v1, arg);
    arg->delete_temp("fight_ok");
    return 1;
}

int checking(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = arg1->query("max_qi");
    v2 = arg2->query("max_qi");
    if (arg1->is_fighting()) {
        call_out("checking", 2, arg1, arg2);
        return 1;
    }
    if (!present(arg2, environment())) {
        return 1;
    }
    if (arg1->query("qi") * 100 / v1 <= 50) {
        command("say 青出於蓝胜於蓝，不愧是大理段家的好弟子！恭喜你了！\n");
        command("say 你已经可以胜任大理家臣！\n");
        upgrade_title(arg2, "大理镇南王府家臣");
        return 1;
    }
    if (arg2->query("qi") * 100 / v2 < 50) {
        command("say 看来" + "/adm/daemons/rankd"->query_respect(arg2) + "还得多加练习，方能在大理段家诸多弟子中出人头地！\n");
        return 1;
    }
    return 1;
}

void upgrade_title(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg2 + clear_title(arg1->query("dali_title"));
    arg1->set("dali_title", v1);
}

string clear_title(mixed arg) {
    if (strsrch(arg, "大理镇南王府家奴") >= 0 || strsrch(arg, "大理镇南王府婢女") >= 0) {
        arg = replace_string(arg, "大理镇南王府婢女", "");
        arg = replace_string(arg, "大理镇南王府家奴", "");
    }
    return arg;
}
