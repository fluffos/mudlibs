    set("age", 32);
    set("gender", "男性");
    set("attitude", "peaceful");
    set("level", 15);
    set("shen_type", 1);
    set("inquiry", ([ "狩猎" : "嗯，狩猎既能强身健体，狩猎来的皮草还可以做衣服卖钱。", "狩猎技巧" : (: ask_me :) ]));
