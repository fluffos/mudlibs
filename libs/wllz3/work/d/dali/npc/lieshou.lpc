void init() {
    add_action("do_apply", "apply");
}

int ask_me() {
    mixed v1;
    v1 = this_player();
    if (v1->query("career")) {
        if (v1->query("career") == "猎人") {
            if (v1->query_skill("hunt-skill", 1) < 1) {
                v1->set_skill("hunt-skill", 1);
                tell_object(v1, "\e[1;32m恭喜，你已经掌握了一级狩猎技巧。\n\e[2;37;0m");
            }
            say(name() + "说道：这门技巧我只能带你入门，其他的经验还是要靠你在狩猎过程中增长。\n");
            return 1;
        }
        say(name() + "语重声长的说道：每一种职业都有它特殊的能力，狩猎不但可以强身\n健体，有时候还会有意外收获。\n");
        return 1;
    }
    if (v1->query("level") < 20) {
        command("say 你的等级太低，这事以后再说吧。\n");
        return 1;
    }
    say(name() + "眉开眼笑的说道：怎么，你对狩猎也有兴趣吗？那先加入我们这一行列吧。\n");
    tell_object(v1, "\e[33m如果你想加入猎人这个行列，请输入：\e[37mapply hunt\e[33m，以后你将具备捕杀\n动物的能力，并可以获取其资源，而这将是其他职业不具备的优势。\n\e[2;37;0m");
    v1->set_temp("pending/apply_hunt", 1);
    return 1;
}

int do_apply() {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("pending/apply_hunt")) {
        return 0;
    }
    if (v1->query("str") < 50) {
        command("say 你的力量太差，依我看猎人这种职业不适合你。");
        return 1;
    }
    if (v1->query("dex") < 40) {
        command("say 看你身手笨拙，猎人这种职业可不适合你。");
        return 1;
    }
    if (v1->query("cou") < 30) {
        command("say 身为猎人，勇气和胆量最为重要，似乎你的勇气还不够。");
        return 1;
    }
    if (!v1->is_member()) {
        command("say 抱歉，只有本游戏会员才可以加入这个职业。");
        return 1;
    }
    message_vision("$N拍了拍$n的肩膀，说道：好，欢迎你加入我们狩猎的行列。\n", this_object(), v1);
    tell_object(v1, "\e[1;32m恭喜，从今天起，你正式成为一名猎人。你可以开始狩猎并获取资源。\n不过，你必须先学一点狩猎技巧。\n\e[2;37;0m");
    v1->set("career", "猎人");
    v1->delete_temp("pending/apply_hunt");
    return 1;
}
