int ask_kiss() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (query("id") != "shuang er") {
        sscanf(query("id"), "%s's shuang er", v2);
        if (v1->query("id") == v2) {
            if (random(10) < 1) {
                say(query("name") + "满脸羞得通红，垂下头来，缓缓的点了点头.\n");
            } else {
                say(query("name") + "啊的一声，一下子跳将开去，说：不嘛，不要！\n");
