int do_tao(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg != "foxiang") {
        return notify_fail("你要掏什么？\n");
    }
    if (v1->query_temp("marks/爬")) {
        message_vision("$N伸手在佛像耳朵里掏了掏。\n", v1);
        if (v1->query_condition("get_key") > 0) {
            v1->add("qi", -50);
            return notify_fail("你掏了半天，什么也没有，看来是被人取走了。\n");
        }
        switch (random(5)) {
        case 0:
            message_vision("$N掏了一会儿，取出一件小小物事来。\n", v1);
            message_vision("$N跃下地来，对着火光一看，却是一枚小钥匙。\n", v1);
            v2 = clone_object("/d/city2/obj/jinyaos");
            v1->apply_condition("get_key", 200);
            v2->move(v1);
            break;
        default:
            message_vision("$N伸手掏了一会儿，什么也没掏到。\n", v1);
            break;
        }
        return 1;
    }
    return notify_fail("你够不着。\n");
}

int do_qiao(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg != "brick") {
        return notify_fail("你要撬什么？\n");
    }
    if (v1->query_temp("marks/移")) {
        if (!objectp(v2 = v1->query_temp("weapon"))) {
            return notify_fail("不用家伙恐怕不行吧！\n");
        }
        message_vision("$N拔出兵刃，将一块方砖撬起。\n", v1);
        message("vision", "登时露出一块铁板来，板上有个拉环，环下有个锁孔(lock)。\n", environment(v1));
        v1->set_temp("marks/撬", 1);
        return 1;
    } else {
        message_vision("$N胡乱撬开几块砖，结果什么也没发现。\n", v1);
    }
    return 1;
}

int do_unlock(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!arg || arg != "lock") {
        return notify_fail("你要开什么？\n");
    }
    if (!this_player()->query_temp("marks/撬")) {
        return notify_fail("锁在哪儿啊？\n");
    }
    if (!(v1 = present("jin", this_player()))) {
        message_vision("$N猛地一拉铁环，蓦听的飕的一声，一枝机弩从下面射了出来，正中$N胸口。\n", v2);
        v2->die();
        return 1;
    }
    message_vision("$N将金钥匙轻轻插下，只听喀的一声，锁已打开。\n", v2);
    if (query("getbook")) {
        return notify_fail("你失望地发现书已经被人取走了。\n");
    }
    message_vision("$N伸手进去，摸出一包事物，却是个包袱，打开一看，\n正是一部《四十二章经》。$N忍不住啃了一声。\n", v2);
    v1 = clone_object("/d/city2/obj/book14_5");
