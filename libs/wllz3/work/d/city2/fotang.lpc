    "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说了吗？%s拿到%s了！", v2->name(), v1->name()));
    return 1;
}

int valid_leave(mixed arg1, mixed arg2) {
    arg1->delete_temp("marks/爬");
    arg1->delete_temp("marks/移");
    arg1->delete_temp("marks/撬");
