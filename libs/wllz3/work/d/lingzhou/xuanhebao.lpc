}

void init() {
    add_action("do_yell", "yell");
}

int do_yell(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!arg || arg == "") {
        return 0;
    }
    if (arg == "boat") {
        arg = "船家";
    }
    if (v1->query("age") < 16) {
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n", v1);
    } else if (v1->query("neili") > 500) {
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传了出去。\n", v1);
    } else {
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n", v1);
    }
    if (arg == "船家") {
        "/adm/daemons/transd"->check_boat(base_name(this_object()));
        return 1;
    } else {
        message_vision("风浪中远远传来一阵回声：“" + arg + "～～～”\n", v1);
    }
    return 1;
}
