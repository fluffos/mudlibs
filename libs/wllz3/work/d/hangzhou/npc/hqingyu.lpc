inherit "/inherit/char/npc";
string ask_per();
string change_name();
int check_legal_name(mixed);
void changeing(mixed);
void greeting(mixed);
int accept_object(mixed, mixed);
int do_name(mixed);

string *banned_name = ({ "你", "我", "他", "她", "它", "爸", "妈", "操", "干", "测试", "使用者", "扑", "爷", "奶", "婆", "叔", "姨", "爹", "做爱", "色狼", "交", "嫖", "强奸", "调戏", "尝试", "性", "的", "妓", "哥", "姐", "哈", "嘻", "呵", "巫师", "天神", "神仙", "大圣", "大帝", "天帝", " ", "武林列传3 ", code_name() });

void create() {
    set_name("胡庆余", ({ "hu qingyu", "hu", "qingyu" }));
    set("title", "药店老板");
    set("long", "他是这家药店的老板，除了高超的医术之外，私底下还帮人家做一些其他\n的事情，比如：改名、整容。不过收费当然是非常昂贵的了。\n");
    set("gender", "男性");
    set("age", 40);
    set("level", 25);
    set("inquiry", ([ "整容" : (: ask_per :), "改名" : (: change_name :), "费用" : "嘿嘿，不多，一次二百两而已！" ]));
    setup();
    carry_object("/clone/cloth/cloth")->wear();
    add_money("silver", 20);
}

void init() {
    mixed v1;
    if (interactive(v1 = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
    add_action("do_name", "改");
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    switch (random(1)) {
    case 0:
        say("胡庆余笑咪咪地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，进来随便看看吧。\n");
        break;
    }
}

string change_name() {
    mixed v1;
    v1 = this_player();
    v1->set_temp("ask_name", 1);
    return "你要改名换姓？！这好办，每次二千两黄金就给你改！";
}

string ask_per() {
    mixed v1;
    v1 = this_player();
    if (v1->query("per") > 50) {
        return "你的容貌简直无人可比，老夫帮不了你了。";
    }
    command("look " + v1->query("id"));
    command("say 太可怜了，长得这个样子.....");
    command("whisper " + v1->query("id") + "  整容一次须给二百两黄金，你付得起吗？嘿嘿！");
    v1->set_temp("ask_per", 1);
    return "天下没有不要钱的午餐，你可要慎重考虑哟！";
}

int accept_object(mixed arg1, mixed arg2) {
    arg1 = this_player();
    if (arg1->query_temp("ask_per")) {
        if (arg2->query("money_id") && arg2->value() >= 2000000) {
            tell_object(arg1, "胡庆余说道：好好！请稍等一会！\n");
            arg1->set_temp("give_per_money", 1);
            changeing(arg1);
            return 1;
        }
    }
    if (arg1->query_temp("ask_name")) {
        if (arg2->query("money_id") && arg2->value() >= 20000000) {
            tell_object(arg1, "胡庆余低头沉思了一会儿，说道：好吧，那您想取个什么样的名字呢？\n");
            tell_object(arg1, "请您自己输入：改 新的中文名字\n");
            arg1->set_temp("fee_paid", 1);
            return 1;
        }
    }
    command("say 哎呀！可真是谢谢你了！");
    return 1;
}

void changeing(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (arg->query_temp("give_per_money") && arg->query_temp("ask_per")) {
        message_vision("胡庆余拿出一罐紫红色的胭脂，轻轻的往$N脸上抹去。\n", arg);
        arg->delete_temp("give_per_money");
        arg->delete_temp("ask_per");
        arg->add("per", 1);
        tell_object(arg, "\e[1;32m你只觉得脸上一阵麻痹过后，又舒服了许多......\n\e[2;37;0m");
        tell_object(arg, "\e[1;36m你的魅力增加了，你现在的魅力值是" + chinese_number(arg->query("per")) + "点！\n\e" + "[2;37;0m");
        return;
    }
}

int do_name(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = this_player();
    v3 = v2->query("name");
    v1 = sizeof(arg);
    if (sizeof(arg) < 1 || sizeof(arg) > 4) {
        return notify_fail("胡庆余一脸遗憾的说道：对不起，你的中文名字必须是 1 到 4 个中文字。\n");
    }
    while (v1--) {
        if (arg[v1] <= 32) {
            return notify_fail("胡庆余摇了摇头，说道：对不起，你的中文名字不能用控制字元。\n");
        }
        if (!is_chinese(arg[v1..v1])) {
            return notify_fail("胡庆余遗憾的说道：对不起，请您用「中文」取名字。\n");
        }
    }
    for (v1 = 0; v1 < sizeof(banned_name); v1++) {
        if (strsrch(arg, banned_name[v1]) == -1) {
            continue;
        }
        return notify_fail("胡庆余严肃的说：对不起，这种名字会造成其他人的困扰。\n");
    }
    if (!v2->query_temp("fee_paid")) {
        return notify_fail("胡庆余笑道：想改名字必须先给钱的哦！\n");
    }
    if (!arg || arg == " ") {
        return notify_fail("胡庆余说道：改名字要这样打：改 <新名字> \n");
    }
    if (v3 == arg) {
        return notify_fail("胡庆余惊讶的说道：您的钱是不是想送给我？\n");
    }
    if (arg == "胡庆余") {
        return notify_fail("胡庆余笑道：莫非您是喜欢在下的名字？\n");
    }
    if ("/adm/daemons/named.lpc"->invalid_new_name(arg)) {
        return notify_fail("胡庆余摇了摇头说：这个名字已经有人使用了，想个别的吧。\n");
    }
    "/adm/daemons/named.lpc"->remove_name(v3, v2->query("id"));
    "/adm/daemons/channeld"->do_channel(this_object(), "chat", sprintf("%s从今日起已经改名为「%s」，大家以后可别认错了人啦！......", v2->name(), arg));
    v2->delete_temp("fee_paid");
    v2->delete_temp("ask_name");
    v2->set("name", arg);
    "/adm/daemons/named.lpc"->map_name(v2->query("name"), v2->query("id"));
    return 1;
}
