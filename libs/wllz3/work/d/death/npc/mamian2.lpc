void init() {
    add_action("do_accept", "accept");
}

int accept_object(mixed arg1, mixed arg2) {
    message_vision("$N对$n怪叫一声：在阳间做亏心事了吧！\n", this_object(), arg1);
    return 1;
}

int ask_accept(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query("die_for_want")) {
        return 0;
    }
    if (!v1->query("die_for_player")) {
        return 0;
    }
    if (v1->query_temp("no_accept_money")) {
        tell_object(v1, "\e[37m马面冷冷的看了你一眼，扭过头去理都不理你。\n\e[2;37;0m");
        return 1;
    }
    if (v1->add_temp("ask_accept", 1) == 3) {
        v2 = v1->query("level") * 95000;
        v2 = v2 * 3 / 2;
        tell_object(v1, sprintf("\e[37m马面四周瞧了瞧，甚是神秘的靠在你耳边说道：俗话说有钱能使鬼推磨，\n这里有些无宿的孤魂野鬼，死了没人送葬，落了个不得轮回投胎，你要是\n阳间有人可以帮你送钱来，我倒也可以帮你想想办法，给你找个替死鬼，\n既让你免去劳役之苦尽早还阳，又可以帮那些穷鬼找个安家的主。至于这\n卖命钱嘛，至少得\e[1;33m%s\e[2;37;0m\e[37m才行。\n\n\e[2;37;0m", "/adm/daemons/moneyd"->price_str(v2)));
        tell_object(v1, "\e[37m马面又道：你若是考虑清楚了，可得尽快告诉我(\e[1;32maccept\e[2;37;0m\e[37m)。\n\e[2;37;0m");
        return 1;
    }
    if (arg == "钱") {
        say("\e[37m马面清了清嗓子，一本正经的说道：钱什么钱？有钱了不起啊。\n\e[2;37;0m");
    } else if (arg == "替死鬼") {
        say("\e[37m马面顿了顿，说道：这里只有恶鬼穷鬼吊死鬼冤鬼无头鬼，没什么替死鬼。\n\e[2;37;0m");
    }
    return 1;
}

int do_accept() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query_temp("ask_accept") < 3) {
        return 0;
    }
    v2 = v1->query("level") * 95000;
    v2 = v2 * 3 / 2;
    tell_object(v1, "\e[37m马面诡异的点了点头，悄声说道：你等等，我帮你上阳间查查。\n\n\e[2;37;0m\e[1;37m话音刚落，“咻”的一声消失了。\n\n\e[2;37;0m");
    if (v2 > v1->query("balance")) {
        tell_object(v1, sprintf("\e[37m过了一会，只见马面怒气冲冲的出现在你的面前，说道：你不也是个穷鬼，\n爷儿我查过了，你在阳间不过才\e[1;33m%s\e[2;37;0m\e[37m。\n\e[2;37;0m", "/adm/daemons/moneyd"->price_str(v1->query("balance"))));
        v1->delete_temp("ask_accept");
        v1->set_temp("no_accept_money", 1);
        return 1;
    }
    tell_object(v1, "\e[37m马面满面春风的飘了过来，拍了拍衣兜，悄声说道：一切如愿，小的现在\n就送您去判官那，您准备还阳吧。说完，唤来一顶轿子让你坐上，几个小\n鬼很快的把你送到了地藏殿。\n\n\e[2;37;0m");
    v1->delete_temp("ask_accept");
    v1->delete("die_for_player");
    v1->add("balance", -v2);
    v1->move("/d/death/dizang");
    return 1;
}

int is_ghost() {
    return 1;
}
