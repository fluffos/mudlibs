    set_name("\e[1;37m马面\e[2;37;0m", ({ "mamian" }));
    set("gender", "男性");
    set("age", 25);
    set("title", "\e[1;37m枷铐\e[2;37;0m");
    set("str", 36);
    set("cor", 24);
    set("cps", 11);
    set("per", 27);
    set("int", 27);
    set("agi", 30);
    set_temp("apply/astral_vision", 1);
    set("attitude", "peaceful");
    set("inquiry", ([ "替死鬼" : (: ask_accept, "替死鬼" :), "钱" : (: ask_accept, "钱" :) ]));
    set("long", "马面人身，全身青紫的鬼怪\n");
