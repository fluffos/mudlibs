// TIE @ FY3

#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name(HIR"蜡烛"NOR, ({ "la zhu","fire" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一根火苗闪烁的大红蜡烛，发出微弱的光芒。\n");
                set("unit", "根");
                set("value", 30);
                set("food_remaining",5);
                set("food_supply", 40);
                set("food_brawn",60);
                set("eat_msg",WHT"$N把$n"NOR WHT"吹熄，放到嘴里津津有味的咬了一口。\n"NOR);
                set("finish_msg",WHT"$N三两口就把$n"NOR WHT"给啃了下去，剩下一把竹杆。\n"NOR);
        }
        setup();
}
int is_ghost_food() { return 1;}
