// TIE @ FY3

#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name(YEL"香"NOR, ({ "xiang","smoke" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一根燃烧着的香，冒着徐徐清烟。\n");
                set("unit", "根");
                set("value", 15);
                set("food_remaining", 3);
                set("food_supply", 100);
                set("food_brawn",40);
                set("eat_msg",WHT"$N抓起一把$n"WHT"，放到鼻子边上，狠狠的吸了一口。\n"NOR);
                set("finish_msg",WHT"$N猛的吸了一口气，只见$n"WHT"发出嗤嗤声响，很快就烧完了。\n"NOR);
        }
        setup();
}
int is_ghost_food() { return 1;}
