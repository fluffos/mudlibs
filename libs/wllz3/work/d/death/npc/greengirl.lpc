}

int ask_job() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!v1->is_ghost()) {
        say("\e[1;34m绿珠说道：你一个大活人不去阳间好好做人，跑来我这里干什么？\n\e[2;37;0m");
        return 1;
    }
    if (v1->query("revive_now")) {
        say("\e[1;34m绿珠幽幽的说道：你不是要投胎了吗，怎么跑我这里来了？\n\e[2;37;0m");
        return 1;
    }
    if (v1->query("combat/ghost_job") < 1) {
        say("\e[1;34m绿珠说道：好，见你有洗心革面之心，我就饶恕你的罪孽，你回阳间去吧。\n记得可要行善积德，方可多添福禄。\n\e[2;37;0m");
        message("vision", "\e[37m绿珠说完，手指轻轻一点，一道白色的光芒罩向" + v1->name() + "，随着一阵仙乐飘起，\n" + v1->name() + "渐渐的消失在白芒之中。\n\e" + "[2;37;0m", environment(v1), ({ v1 }));
        write("\e[1;37m\n一阵飘逸的仙乐轻轻的传入耳间，你只觉得精神气爽，心平如镜，前世的纷争，\n情爱，痛苦，快乐，渐渐的都抛之脑后，你昏昏沉沉的，只觉得身子轻轻飘起，接\n着什么都不知道了。\n\e[2;37;0m");
        v1->reincarnate();
        v2 = all_inventory(v1);
        for (v3 = 0; v3 < sizeof(v2); v3++) {
            destruct(v2[v3]);
        }
        v1->set_temp("block_msg/all", 1);
        v1->move(revive_loc[random(sizeof(revive_loc))]);
        v1->set("startroom", base_name(environment(v1)));
        v1->delete_temp("block_msg");
        write("\e[1;36m你慢慢的睁开眼睛，发现你已经回到了阳间，先前的发生的事情已经毫无印象。\n\e[2;37;0m");
        return 1;
    }
    if (v1->query_temp("ask_ghost_job")) {
        command("? " + v1->query("id"));
        write("\e[1;34m绿珠说道：你这懒鬼，连鬼都不好好做，难道你想永不超生，继续留在这里吗？\n\e[2;37;0m");
        return 1;
    }
    write("\e[1;34m绿珠幽幽的说道：车崩狱恶鬼日渐增多，全因战车损耗太大，不足使用。\n姑且绕你车裂之刑，罚你到车崩狱劳役，望你能静思己过，来世做个善人。\n\e[2;37;0m");
    v1->set_temp("ask_ghost_job/type", "车崩");
    return 1;
}

