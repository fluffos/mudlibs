inherit "/inherit/room/room";
int do_work(mixed);
int do_halt(mixed);
void create();
void init();
int do_repair(mixed);

void create() {
    set("short", "车崩狱");
    set("long", "恰似战国时候的五马分尸，也称车裂，育两种，一种是将罪犯四肢套\r\n在五辆车车辕上，然后众车背到而驰，一种是以千斤战车碾轧人身，就算\r\n铁打金刚也会分成数段。此刑在人间早以废除不用，不想在地狱尚能一见\r\n，此刑酷烈，想来此间犯人的罪必大到极点。一群小鬼正手持木锤，蹲在\r\n一旁修理(repair)战车，不时被牛头怒骂，抽打。再往下又是一类犯人了\r\n，又当如何呢？\r\n");
    set("exits", ([ "up" : "/d/death/zhuidao", "down" : "/d/death/hanbing" ]));
    set("objects", ([ "/d/death/npc/niutou" : 1 ]));
    set("death", 1);
    set("no_fight", 1);
    set("no_beg", 1);
    set("no_steal", 1);
    set("no_magic", 1);
    setup();
}

void init() {
    add_action("do_repair", "repair");
}

int do_repair(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!v1->is_ghost()) {
        return notify_fail("牛头一声大喝：喂喂喂，哪来的家伙，竟敢在我这里捣乱。\n");
    }
    if (!v1->query("combat/ghost_job")) {
        return notify_fail("牛头甚是不解的看着你，道：哪来的死鬼，还不回去投胎，跑这里混日子？\n");
    }
    if (!v1->query_temp("ask_ghost_job")) {
        return notify_fail("牛头恶狠狠的盯着你：少跟我搅和，你可是来试试车裂之刑？\n");
    }
    if (v1->query_temp("ask_ghost_job/type") != "车崩") {
        return notify_fail("牛头粗里粗气的喝道：没有绿珠姑娘的刑令，你怎可以在这里劳役？\n");
    }
    if (v1->query_temp("ask_ghost_job/finish")) {
        return notify_fail("牛头很不耐烦的说道：快到绿珠姑娘那报道去，别碍了大爷干活。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("牛头狠狠的抽了你一鞭子，骂道：作鬼了还三心二意，给我好好的干。\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("牛头狠狠的抽了你一鞭子，骂道：作鬼了还三心二意，给我好好的干。\n");
    }
    v1->start_busy((: do_work :), (: do_halt :));
    v1->set_short_desc("手持木榔头，蹲在一边修理战车。");
    write("你挥起榔头，蹲下来试着修理战车。\n");
    return 1;
}

int do_work(mixed arg) {
    mixed v1;
    if (arg->query("qi") < 0) {
        arg->set_short_desc(0);
        write("你气力不加，累了个半死，只得停下来休息一会。\n");
        return 0;
    }
    if (arg->query("jing") < 0) {
        arg->set_short_desc(0);
        write("你精不济，还是停一下再说吧。\n");
        return 0;
    }
    if (arg->query("brawn") < 0) {
        arg->set_short_desc(0);
        write("你体力不支，还是停下来休息一会吧。\n");
        return 0;
    }
    v1 = arg->query("level");
    v1 /= 3;
    if (v1 > 50) {
        v1 = 50;
    }
    if (v1 < 30) {
        v1 = 30;
    }
    if (arg->add_temp("ask_ghost_job/times", 1) >= v1) {
        arg->set_temp("ask_ghost_job/times", 0);
        arg->set_temp("ask_ghost_job/finish", 1);
        write("你默默的蹲着修理战车，过了许久，终于把战车修好了。\n");
        arg->set_short_desc(0);
        return 0;
    }
    arg->add("jing", -arg->query("jing") / 10);
    arg->add("qi", -arg->query("qi") / 10);
    arg->add("brawn", -5);
    write(random(9) == 8 ? "\e[37m随着轰隆隆的一阵巨响，一个恶鬼被五辆战车拉开了数块，当真是\e[31m碎尸万段\e[37m，惨不忍睹。\n\e[2;37;0m" : random(8) == 7 ? "牛头挥起铁鞭，往你身上狠狠的抽了一鞭子，喝道：给我好好的干！\n" : random(7) == 6 ? "\e[37m一个五花大绑的恶鬼被小鬼们抬了过来，用战车将他绑了起来。\n\e[2;37;0m" : random(6) == 5 ? "你一不留神，榔头敲在你的手指上，一股钻心的疼痛痛得你忍不住喊了出来。\n牛头和小鬼们见你这狼狈样，竟哈哈大笑了起来。\n" : random(5) == 4 ? "你把战车的轮子拆了下来，把木钉子敲了进去，给轮子加固。\n" : random(4) == 3 ? "你站了身来，将车把子敲了敲，又敲了一颗木钉子进去。\n" : random(3) == 2 ? "你拿起一根木头固定在战车的栅栏上，紧接着又敲上木钉，将栅栏加固。\n" : "“啪嗒啪嗒”，你敲打着战车的底板，试着将它修好。\n");
    return 1;
}

int do_halt(mixed arg) {
    write("你放下榔头，停下来休息一会。\n");
    arg->set_short_desc(0);
    return 1;
}
