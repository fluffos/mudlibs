nosave int total = 100000;

void create() {
    set("short", "高昌石壁");
    set("long", "一堵足有五个人高的石壁堵在你的面前，石壁上刻满了一些密密麻麻\r\n的文字。看似梵文，却又不是。石壁的那头，不时传来一阵阵咔哒咔哒的\r\n声响，好像石壁那端又是另外的一番天地。\r\n");
    set("exits", ([ "southeast" : "/d/migong/gaochangmigong/level1/exit" ]));
}

void init() {
    add_action("do_break", "pi");
}

int do_break(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!arg || arg == "") {
        return notify_fail("你要劈什么？\n");
    }
    if (arg == "石壁" || arg == "shibi") {
        if (query("breaked")) {
            return 0;
        }
        if (v1->query("neili") < 200) {
            return notify_fail("你的内力不足，无法劈开石壁。\n");
        }
        if (!objectp(v2 = v1->query_temp("weapon"))) {
            message_vision("$N挥掌就往石壁上劈去，“乓”的一声过后，石壁依然纹丝不动。\n", v1);
            v1->add("neili", -200);
            return 1;
        }
        if (v2->query("weapon_prop/damage") < 100) {
            message_vision("\e[1;33m$N挥起" + v2->name() + "\e" + "[1;33m往石壁上劈去，只听见“啪”的一声，" + v2->name() + "\e" + "[1;33m应声断开两截。\n\e" + "[2;37;0m", v1);
            v2->unequip();
            v2->set("name", "\e[1;33m断掉的" + v2->name() + "\e" + "[2;37;0m");
            v2->set("value", 0);
            v2->set("weapon_prop", 0);
            v2->move(environment(v1));
            v1->add("neili", -200);
            return 1;
        }
        if (total > 0) {
            message_vision("\e[1;33m$N默运内力，挥起" + v2->name() + "\e" + "[1;33m就往石壁上砍去，" + v2->name() + "\e" + "[1;33m砍在石壁上，擦出星点火花。\n\e" + "[2;37;0m", v1);
            total -= v2->query("weapon_prop/damage");
            v1->add("neili", -200);
            return 1;
        } else {
            message_vision("石壁轰隆隆的发出一阵巨响，应声崩塌，尘土飞扬，$N拨开尘土，发现了另外的一条出路。\n", v1);
            set("exits/north", "/d/migong/gaochangmigong/level2/entry");
            set("breaked", 1);
            v1->add("neili", -200);
            return 1;
        }
    }
    return 0;
}

