void create() {
    set("short", "瀑布");
    set("long", "你猛听得水声响亮，轰轰隆隆，便如潮水大至一般，抬头一看，只见\n一条大瀑布(pubu)，犹如银河倒悬，从高崖上垂直直泻而来。下面是万丈\n悬崖(xuanya)，云雾弥漫，望不到尽头！\n");
    set("exits", ([ "northdown" : "/d/xiakedao/road4" ]));
