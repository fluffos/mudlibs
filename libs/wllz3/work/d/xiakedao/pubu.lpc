void init() {
    add_action("do_jump", "jump");
    add_action("do_plump", "plump");
}

int do_jump(mixed arg) {
    mixed v1;
    v1 = this_player()->query_skill("dodge", 1);
    if (!arg || arg != "pubu") {
        write("不要在这里乱跳！\n");
        return 1;
    }
    message_vision("$N在瀑布前站定，深呼一口气，突然跃起。\n", this_player());
    if (v1 >= 80) {
        message_vision("只见$N脚尖一点地，身子轻飘飘的跃进瀑布之中。\n", this_player());
        this_player()->move("/d/xiakedao/yongdao1");
    } else if (v1 >= 50) {
        message_vision("只见$N使出全身的力量，身子再空中摇摇惶惶，终于落在瀑布里面。\n", this_player());
        this_player()->move("/d/xiakedao/yongdao1");
    } else {
        message_vision("只见$N高高跃起，还差很远呢! \n", this_player());
    }
    return 1;
}

int do_plump(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = random(v1->query("max_qi") * 3);
    if (v2 > v1->query("qi")) {
        v2 = v1->query("qi") + 1;
    }
    if (!arg || arg != "down") {
        write("你要跳什么呀？\n");
        return 1;
    }
    tell_object(v1, "\e[1;31m你不加思索，纵身跳下了悬崖。\n\e[2;37;0m");
    message("visoin", "\e[2;37;0m只见" + v1->query("name") + "纵身跳下了悬崖。\n\e" + "[2;37;0m", environment(v1), v1);
    if (random(v1->query("kar")) < 15 && v1->query_skill("dodge", 1) < 30) {
        v1->die();
        return 1;
    }
    v1->add("qi", -v2);
    v1->move("/d/xiakedao/yadi");
    return 1;
}
