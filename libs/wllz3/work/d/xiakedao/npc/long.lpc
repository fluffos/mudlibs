void attempt_apprentice(mixed arg) {
    message_vision("龙岛主拍拍$N的头，微微摇了摇头。\n", arg);
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (arg2->query("name") != "赏善铜牌") {
        message_vision("我不需要这件东西。\n", this_player());
        return 0;
    }
    if (arg2->query_temp("own") != arg1->query("name")) {
        message_vision("这不是你的牌子。", this_player());
        return 0;
    }
    command("say  原来是 " + arg1->query("name") + "大侠" + "欢迎光临本岛。");
    v1 = clone_object("/d/xiakedao/obj/labazhou");
    v1->move(arg1);
    command("say 这是本岛特产腊八粥，外边可不易喝到，其中最主要的一味是<断肠蚀骨腐心草>，瞧" + "/adm/daemons/rankd"->query_respect(arg1) + "也是有缘之人，快乘热喝，这样效力方著。");
    message_vision("龙岛主给了你一碗腊八粥", arg1);
    if (arg1->query_temp("zhou") == 2) {
        command(" say 看来居士福缘深厚，有机会一睹武林绝技，请进吧！");
        arg1->set_temp("zhou", 0);
        message_vision("只听得一阵隆隆的响声由远及近。\n", this_player());
        message_vision("只见岛主身后的石板缓缓移了开来，露出一条长长的甬道。\n", this_player());
        environment(arg1)->set("exits/enter", "/d/xiakedao/mishi");
        v2 = environment(arg1);
        remove_call_out("close");
        call_out("close", 15, v2);
        v3 = clone_object("/d/xiakedao/obj/key");
        message_vision("这是我身后石门的钥匙，也是侠客岛上的凭证，希望你妥善保管，不可随意丢弃，更不可交付他人，离岛时应与归还。\n", arg1);
        v3->move(arg1);
        return 1;
    }
    arg1->set_temp("zhou", 1);
    return 1;
}

void close(mixed arg) {
    message("vision", "轰隆隆的响声响过之后，石板又合上了。\n", arg);
    arg->delete("exits/enter");
}
