int do_enter(mixed arg) {
    mixed v1;
    if (!arg || arg != "boat") {
        tell_object(this_player(), "你要 enter 哪儿？\n");
        return 1;
    }
    v1 = this_player();
    message_vision("船夫一见有人上船，忙叫了一声：开船喽！\n", v1);
    message_vision("船夫升起帆，船就向北方航行。\n", v1);
