void write(mixed arg) {
    if (this_player()) {
        message("write", arg, this_player());
    } else if (previous_object()) {
        message("write", arg, previous_object());
    } else {
        efun::write(arg);
    }
}

varargs void say(mixed arg1, mixed arg2) {
    if (living(previous_object())) {
        message("say", arg1, environment(previous_object()), previous_object());
    } else if (this_player()) {
        message("say", arg1, environment(this_player()), this_player());
    }
}

nomask varargs void printf(mixed *arg...) {
    mixed v1;
    mixed v2;
    v1 = arg[1..];
    v2 = sprintf(arg[0], v1...);
    write(v2);
}

void tell_object(mixed arg1, mixed arg2) {
    if (arg1) {
        message("tell_object", arg2, arg1);
    }
}

varargs void tell_room(mixed arg1, mixed arg2, mixed arg3) {
    if (arg1) {
        message("tell_room", arg2, arg1, arg3);
    }
}

void shout(mixed arg) {
    message("shout", arg, users(), this_player());
}

void message_system(mixed arg) {
    message("system", "\e[1;37m【系统公告】" + arg + "\n\e" + "[2;37;0m", users(), 0);
}

void other_message(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    v1 = filter(users(), (: !$1->query("env/no_other_msg") :));
    if (!arg1) {
        arg1 = "\e[1;33m";
    }
    message("other_msg", arg1 + "【" + arg2 + "】" + clean_color(arg3) + "\n\e" + "[2;37;0m", v1, 0);
}

int notify_fail(mixed arg) {
    if (this_player()) {
        this_player()->set_temp("notify_fail", arg);
        return efun::notify_fail("\e[256D\e[K" + arg);
    } else {
        return 0;
    }
}

string query_fail_msg() {
    return this_player()->query_temp("notify_fail");
}

void create() {
    seteuid(getuid());
    write("simul_efun 成功加载！\n");
}
