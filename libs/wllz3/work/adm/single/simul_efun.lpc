string code_name() {
    return get_config(0);
}

int atoi(mixed arg) {
    mixed v1;
    if (!stringp(arg) || !sscanf(arg, "%d", v1)) {
        return 0;
    }
    return v1;
}

string itoa(mixed arg) {
    return sprintf("%d", arg);
}

string space(mixed arg) {
    return sprintf("%" + itoa(arg) + "s", "");
}

int is_sub(mixed arg1, mixed arg2) {
    if (!arg2 || !arg1) {
        return 0;
    }
    return strsrch("," + arg2 + ",", "," + arg1 + ",") != -1;
}

string add_sub(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg1 || is_sub(arg1, arg2)) {
        return arg2;
    }
    v1 = explode(arg1, ",");
    v1 -= ({ "" });
    for (v2 = 0; v2 < sizeof(v1); v2++) {
        if (!is_sub(v1[v2], arg2)) {
            if (!arg2 || arg2 == "") {
                arg2 = v1[v2];
                continue;
            }
            arg2 += "," + v1[v2];
        }
    }
    return arg2;
}

string remove_sub(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg2 || arg2 == arg1) {
        return 0;
    }
    v1 = explode(arg2, ",") - ({ "" });
    v2 = explode(arg1, ",");
    v1 -= v2;
    if (!sizeof(v1)) {
        return 0;
    }
    arg2 = implode(v1, ",");
    return arg2;
}

string chinese_number(mixed arg) {
    return "/adm/daemons/chinesed"->chinese_number(arg);
}

string to_chinese(mixed arg) {
    return "/adm/daemons/chinesed"->chinese(arg);
}

int is_chinese(mixed arg) {
    mixed v1;
    if (sizeof(arg) < 1) {
        return 0;
    }
    // FluffOS strings are Unicode: test CJK code points, not GBK byte pairs
    for (v1 = 0; v1 < sizeof(arg); v1++) {
        if (arg[v1] < 0x4e00 || arg[v1] > 0x9fff) {
            return 0;
        }
    }
    return 1;
}

void cat(mixed arg) {
    if (previous_object()) {
        seteuid(geteuid(previous_object()));
    } else {
        seteuid("Root");
    }
    efun::write(read_file(arg));
}

void log_file(mixed arg1, mixed arg2) {
    seteuid("Root");
    write_file("/log/" + arg1, arg2);
}

void assure_file(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (file_size(arg) != -1) {
        return;
    }
    seteuid("Root");
    v2 = explode(arg, "/");
    if (arg[sizeof(arg) - 1] != 47) {
        v2 = v2[0..sizeof(v2) - 2];
    }
    v1 = "/";
    for (v3 = 0; v3 < sizeof(v2); v3++) {
        v1 += v2[v3];
        mkdir(v1);
        v1 += "/";
    }
    v2 = 0;
}

string base_name(mixed arg) {
    mixed v1;
    if (sscanf(file_name(arg), "%s#%*d", v1) == 2) {
        return v1;
    } else {
        return file_name(arg);
    }
}

string skill_dir(mixed arg) {
    if (file_size("/kungfu/skill/" + arg + ".lpc") > 0) {
        return "/kungfu/skill/";
    } else {
        return "/kungfu/special/";
    }
}

int file_lines(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = 65536;
    for (v2 = v1 / 2; v2; v2 /= 2) {
        if (read_file(arg, v1, 1)) {
            v1 += v2;
            continue;
        }
        v1 -= v2;
    }
    return v1 - 1;
}

