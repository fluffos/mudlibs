int color_len(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = 0;
    for (v1 = 0; v1 < sizeof(arg); v1++) {
        if (arg[v1] == "\e"[0]) {
            while (v2++, (arg[v1] < 65 || arg[v1] > 122 || arg[v1] > 90 && arg[v1] < 97) && v1 < sizeof(arg)) {
                v1++;
            }
        }
    }
    return v2;
}

string append_color(mixed arg1, mixed arg2) {
    arg1 = replace_string(arg1, "$N", "$N" + arg2);
    arg1 = replace_string(arg1, "$n", "$n" + arg2);
    arg1 = replace_string(arg1, "$w", "$w" + arg2);
    return arg1;
}

string gender_self(mixed arg) {
    switch (arg) {
    case "女性":
        return "你";
        break;
    default:
        return "你";
    }
}

string gender_pronoun(mixed arg) {
    switch (arg) {
    case "中性神":
        return "他";
        break;
    case "男性":
        return "他";
        break;
    case "无性":
        return "他";
        break;
    case "女性":
        return "她";
        break;
    case "雄性":
    case "雌性":
        return "它";
        break;
    default:
        return "它";
    }
}

string npc_name(mixed arg) {
    switch (arg) {
    case "女性":
    case "f":
    case "F":
        return "/adm/daemons/rnamed"->query_Fname();
        break;
    case "男性":
    case "无性":
    case "m":
    case "M":
        return "/adm/daemons/rnamed"->query_Mname();
        break;
    default:
        return "无名";
    }
}

int is_root(mixed arg) {
    if (stringp(arg)) {
        return "/adm/obj/securityd"->get_status(arg) == "(admin)";
    }
    if (objectp(arg)) {
        if (geteuid(arg) == "Root") {
            return 1;
        }
        return "/adm/obj/securityd"->get_status(geteuid(arg)) == "(admin)";
    }
    return 1;
}

varargs int getoid(mixed arg) {
    mixed v1;
    if (!arg) {
        arg = previous_object();
    }
    sscanf(file_name(arg), "%*s#%d", v1);
    return v1;
}

string file_owner(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (arg[0] != 47) {
        arg = "/" + arg;
    }
    if (sscanf(arg, "/u/%s/%s/%s", v3, v1, v2) == 3) {
        return v1;
    }
    return 0;
}

string domain_file(mixed arg) {
    mixed v1;
    if (sscanf(arg, "/d/%s/%*s", v1)) {
        return v1;
    }
    return "Root";
}

string creator_file(mixed arg) {
    mixed v1;
    v1 = explode(arg, "/") - ({ 0 });
    switch (v1[0]) {
    case "adm":
        if (arg == "/adm/single/simul_efun") {
            return "MudOS";
        } else {
            return "Root";
        }
    case "cmds":
        return "Root";
    case "u":
        if (sizeof(v1) >= 3) {
            return v1[1];
        }
    case "d":
        return "Domain";
    case "clone":
        return "Clone";
    case "feature":
        return "Feature";
    case "kungfu":
        return "Kungfu";
    case "inherit":
        return "Inherit";
    default:
        return "Unknow";
    }
}

string author_file(mixed arg) {
    mixed v1;
    if (sscanf(arg, "/u/%*s/%s/%*s", v1)) {
        return v1;
    }
    return "Root";
}

object get_object(mixed arg) {
    mixed v1;
    if (v1 = find_object(arg)) {
        return v1;
    }
    return find_object(arg, 1);
}

void destruct(mixed arg) {
    if (arg) {
        if (previous_object()) {
            arg->remove(geteuid(previous_object()));
        } else {
            arg->remove(0);
        }
    }
    efun::destruct(arg);
}

int exec(mixed arg1, mixed arg2) {
    if (!arg2 || !arg1) {
        return 0;
    }
    if (!previous_object()) {
        return 0;
    }
    if (!is_root(previous_object())) {
        log_file("static/security", sprintf("%s  %s(%s) want to exec (%s)%s to (%s)%s on %s.\n", efun::ctime(time()), base_name(previous_object()), this_player(1) ? geteuid(this_player(1)) : "???", arg2->name(), geteuid(arg2), arg1->name(), geteuid(arg1), efun::ctime(time())));
        return 0;
    }
    arg2->remove_interactive();
    return efun::exec(arg1, arg2);
}

varargs object snoop(mixed arg1, mixed arg2) {
    if (!previous_object()) {
        return 0;
    }
    if (!is_root(previous_object())) {
        log_file("static/security", sprintf("%s  %s(%s) want to snoop %s with %s.\n", efun::ctime(time()), base_name(previous_object()), this_player(1) ? geteuid(this_player(1)) : "???", arg2 ? geteuid(arg2) : "null", geteuid(arg1)));
        return 0;
    }
    if (!objectp(arg2)) {
        return efun::snoop(arg1);
    } else {
        return efun::snoop(arg1, arg2);
    }
}

object query_snooping(mixed arg) {
    if (!previous_object()) {
        return 0;
    }
    if (!is_root(previous_object())) {
        log_file("static/security", sprintf("%s  %s(%s) want to query_snooping of %s.\n", efun::ctime(time()), base_name(previous_object()), this_player(1) ? geteuid(this_player(1)) : "???", geteuid(arg)));
        return 0;
    }
    return efun::query_snooping(arg);
}

object query_snoop(mixed arg) {
    if (!previous_object()) {
        return 0;
    }
    if (!is_root(previous_object())) {
        log_file("static/security", sprintf("%s  %s(%s) want to query_snoop of %s.\n", efun::ctime(time()), base_name(previous_object()), this_player(1) ? geteuid(this_player(1)) : "???", geteuid(arg)));
        return 0;
    }
    return efun::query_snoop(arg);
}

void shutdown(mixed arg) {
    if (!previous_object()) {
        return;
    }
    if (!is_root(previous_object())) {
        log_file("static/security", sprintf("%s  %s(%s) want to shutdown mud.\n", efun::ctime(time()), base_name(previous_object()), this_player(1) ? geteuid(this_player(1)) : "???"));
        return;
    }
    return efun::shutdown(arg);
}

string user_cwd(mixed arg) {
    return "/u/" + arg;
}

string user_path(mixed arg) {
    return user_cwd(arg) + "/";
}

string resolve_path(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg1) {
        arg1 = "/";
    }
    if (!arg2 || arg2 == ".") {
        return arg1;
    }
    if (arg2 == "here" && this_player()) {
        return file_name(environment(this_player())) + ".lpc";
    }
    if (arg2 == "~" || arg2 == "~/") {
        arg2 = user_path(getuid(this_player()));
    }
    if (sscanf(arg2, "~/%s", v3)) {
        arg2 = user_path(getuid(this_player())) + v3;
    } else if (sscanf(arg2, "~%s", v3)) {
        arg2 = user_path(v3);
    } else if (arg2[0] != 47) {
        if (arg1[sizeof(arg1) - 1] != 47) {
            arg2 = arg1 + "/" + arg2;
        } else {
            arg2 = arg1 + arg2;
        }
    }
    v2 = explode(arg2, "/");
    for (v1 = 0; v1 < sizeof(v2); v1++) {
        if (v2[v1] == "..") {
            if (sizeof(v2) > 2) {
                v2 = v2[0..v1 - 2] + v2[v1 + 1..sizeof(v2) - 1];
                v1 -= 2;
                continue;
            }
            v2 = v2[2..sizeof(v2) - 1];
            v1 = 0;
        }
    }
    arg2 = "/" + implode(v2, "/");
    if (arg2 == "//") {
        arg2 = "/";
    }
    return arg2;
}

string wizhood(mixed arg) {
    return "/adm/obj/securityd"->get_status(arg);
}

int wiz_level(mixed arg) {
    return "/adm/obj/securityd"->get_wiz_level(arg);
}

nomask string ctime(mixed arg) {
    if (!intp(arg)) {
        return "";
    }
    if (arg < 0) {
        arg = 0;
    }
    return efun::ctime(arg);
}

int playerp(mixed arg) {
    return arg->is_player();
}

object *users() {
    return filter(children("/clone/user/user"), (: playerp :));
}

object *all_interactive() {
    return efun::users();
}

private int filter_player(mixed arg1, mixed arg2) {
    if (clonep(arg1) && getuid(arg1) == arg2) {
        return 1;
    }
}

object find_player(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (v1 = efun::find_player(arg)) {
        return v1;
    }
    v2 = filter(children("/clone/user/user"), (: filter_player :), arg);
    switch (v3 = sizeof(v2)) {
    case 0:
        return 0;
    case 1:
        return v2[0];
    default:
        log_file("log", sprintf("error find %d players(%s)\n", sizeof(v2), arg));
        error("The player(" + arg + ") has existed in the world.\n");
        return v2[0];
    }
    for (v3--; v3 >= 0; v3--) {
        if (!environment(v2[v3])) {
            efun::destruct(v2[v3]);
            continue;
        }
        if (!v2[v3]->query_temp("user_setup")) {
            destruct(v2[v3]);
        }
    }
    v2 -= ({ 0 });
    v3 = sizeof(v2);
    switch (v3 = sizeof(v2)) {
    case 1:
    default:
        return v2[0];
    case 0:
        return 0;
    }
}

varargs void message_vision(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    mixed v10;
    if (!arg2) {
        return;
    }
    v3 = arg2->is_fighting() ? clean_color(arg2->name()) : arg2->name();
    v1 = arg2->query("gender");
    if (!v3 || !v1) {
        return;
    }
    v5 = replace_string(arg1, "$P", gender_self(v1));
    v5 = replace_string(v5, "$N", gender_self(v1));
    v7 = replace_string(arg1, "$P", v3);
    v7 = replace_string(v7, "$N", v3);
    if (arg3) {
        v4 = arg3->is_fighting() ? clean_color(arg3->name()) : arg3->name();
        v2 = arg3->query("gender");
        v6 = replace_string(arg1, "$P", gender_pronoun(v1));
        v6 = replace_string(v6, "$p", gender_self(v2));
        v6 = replace_string(v6, "$N", v3);
        v6 = replace_string(v6, "$n", gender_self(v2));
        message("vision", v6, arg3);
        v5 = replace_string(v5, "$p", gender_pronoun(v2));
        v5 = replace_string(v5, "$n", v4);
        v7 = replace_string(v7, "$p", v4);
        v7 = replace_string(v7, "$n", v4);
    }
    message("vision", v5, arg2);
    message("vision", v7, environment(arg2), ({ arg2, arg3 }));
    if (environment(arg2) && mapp(v8 = environment(arg2)->query("revive_room"))) {
        foreach (v9 in keys(v8)) {
            if (!(v10 = find_object(v8[v9]))) {
                continue;
            }
            efun::tell_room(v10, "\e[1;37m\n你看到：\e[2;37;0m" + v7, ({ arg2, arg3 }));
            break;
        }
    }
}

