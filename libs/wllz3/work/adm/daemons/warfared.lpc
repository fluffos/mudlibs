nosave string *start_msg = ({ "/adm/daemons/natured"->game_time("year") + "，吴三桂引清兵入关，烧杀抢掠，无恶不作，生灵涂炭。\n", "灭三桂，逐清兵，还我大好河山，成了武林中人最为关注的大事之一。\n", "可是，在这群雄并起的年代，各大派一直各扫门前雪，谁做带头人，一直争执不下。\n", "经过了武林盟主与众掌门商议之后决定，以谋略、武斗来推举“天下第一派”。\n", "这个消息很快的传遍了整个武林，平静已久的江湖，荡开了阵阵的波澜。\n", "而蓄谋已久的好事之徒也纷纷出动，四处散播流言，挑拨离间，江湖中谣言四起，人心惶惶。\n", "\e[1;31m虚荣\e[2;37;0m\e[37m与\e[1;34m贪婪\e[2;37;0m\e[37m渐渐的被唤醒，权衡正派和魔教的界线已经消失了。\n", "一场充满着血腥的武林浩劫一触即发，此刻的局面却是：\e[1;31m天下大乱！\n\e[2;37;0m" });
string *top_family;
nosave int starttime;
nosave int attacktime;
nosave string *playerlist;
mapping scheme;
string NO1_family;
string attack_fam;
nosave int attack_total;
nosave string *attacker;
string guard_fam;
nosave int guarder_total;
nosave string *guarder;

string query_save_file() {
    return "/data/warfared";
}

void create() {
    seteuid(getuid());
    set("channel_id", "战争系统");
    restore();
}

void remove() {
    save();
}

string *query_player_list() {
    return playerlist;
}

string query_top_family() {
    return NO1_family;
}

string attack_family() {
    return attack_fam;
}

string guard_family() {
    return guard_fam;
}

mapping *query_scheme() {
    if (!mapp(scheme)) {
        return 0;
    }
    return keys(scheme);
}

int is_war_family(mixed arg) {
    return attack_fam == arg || guard_fam == arg;
}

void reset_score() {
    attack_fam = 0;
    guard_fam = 0;
    attack_total = 0;
    guarder_total = 0;
    attacker = 0;
    guarder = 0;
    attacktime = 0;
    scheme = 0;
    playerlist = 0;
}

int sort_total(mixed arg1, mixed arg2, mixed arg3) {
    if (arg3[arg1] > arg3[arg2]) {
        return -1;
    }
    if (arg3[arg1] < arg3[arg2]) {
        return 1;
    }
    return arg3[arg1] - arg3[arg2];
}

string *get_top_family() {
    mixed v1;
    mixed v2;
    if (!find_object("/adm/daemons/familyd")) {
        find_object("/adm/daemons/familyd", 1);
    }
    if (!find_object("/adm/daemons/familyd")) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "Daemon 'FAMILY_D' 没有找到。");
        return 0;
    }
    v1 = "/adm/daemons/familyd"->query_family();
    if (!sizeof(v1)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "获取十大门派数据错误。");
        return 0;
    }
    top_family = sort_array(keys(v1), (: sort_total :), v1);
    "/adm/daemons/channeld"->do_channel(this_object(), "sys", "十大门派数据获取完毕！");
    v2 = sizeof(top_family);
    while (v2--) {
        top_family -= ({ top_family[v2] });
        if (v2 <= 10) {
            break;
        }
    }
    return top_family;
}

void play_message(mixed arg1, mixed arg2) {
    if (!stringp(arg1)) {
        arg1 = "\e[1;31m【门派挑战】\e[2;37;0m";
    }
    message("family", arg1 + "\e" + "[37m" + arg2 + "\e" + "[2;37;0m", all_interactive());
}

void start_message(mixed arg) {
    if (stringp(attack_fam) || stringp(guard_fam)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "系统已经处于攻防状态，无法再进行呼叫。");
        return;
    }
    play_message("\e[1;31m【门派挑战】\e[2;37;0m", start_msg[arg]);
    if (++arg < sizeof(start_msg)) {
        call_out("start_message", 3, arg);
        return;
    } else {
        call_out("ready", 10);
    }
}

void ready() {
    mixed v1;
    reset_score();
    if (!pointerp(top_family) || sizeof(top_family) < 1) {
        get_top_family();
    }
    if (!sizeof(top_family)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "十大门派数据两次获取失败，门派战斗系统终止。");
        return;
    }
    attack_fam = top_family[random(sizeof(top_family))];
    top_family -= ({ attack_fam });
    guard_fam = top_family[random(sizeof(top_family))];
    top_family -= ({ guard_fam });
    "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("系统挑选出攻方：%s，守方：%s", attack_fam, guard_fam));
    starttime = time();
    play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("听说十大门派之一的%s，%s发起了对%s的攻击。\n", attack_fam, sizeof(top_family) == 8 ? "率先" : "也", guard_fam));
    v1 = sprintf("\a\e[1;32m\n这是你的师尊命人送来的一封信，只见上面写着：\n\n天下第一派攻防战在即，据悉%s不日之内将攻打我派，徒\n儿见信后速返我派%s处，与众师兄弟共抗%s，捍卫我派尊严！\n\n                 师，%s字\n\n\e[2;37;0m", attack_fam, query_stage(guard_fam)["short"], attack_fam, "/adm/daemons/natured"->game_time("weather"));
    v1 += "\e[1;37m如果你想加入这场战斗，请输入 joinwar 。\n\e[2;37;0m";
    recall_player(guard_fam, v1);
    v1 = sprintf("\a\e[1;36m\n这是你的师尊命送来的一封信，只见上面写着：\n\n天下第一派攻防战在即，你拜师多时，今已是你为我派鞠躬尽瘁\n之日，徒儿见信后，速往%s与各师兄弟会合，攻下%s！\n\n                 师，%s字\n\n\e[2;37;0m", query_stage(guard_fam)["short"], guard_fam, "/adm/daemons/natured"->game_time("weather"));
    v1 += "\e[1;37m如果你想加入这场战斗，请输入 joinwar 。\n\e[2;37;0m";
    recall_player(attack_fam, v1);
    if (undefinedp(family[guard_fam])) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("无法从门派列表中获取%s的方案，攻防战终止。", guard_fam));
        return;
    }
    if (!mapp(scheme = family[guard_fam])) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "获取的防守方方案错误。");
        return;
    }
    guarder_total = sizeof(scheme);
    call_out("release_attacker", 60);
}

void recall_player(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!stringp(arg1) || !stringp(arg2)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "无门派指向或无信息字串，信息播放失败。");
        return;
    }
    v1 = filter(all_interactive(), (: $1->query("family") :));
    foreach (v2 in v1) {
        if (v2->query("family/family_name") != arg1) {
            continue;
        }
        message("vision", sprintf("一个%s弟子急急忙忙的跑了过来，将一封书信交给了%s。\n", arg1, v2->name()), environment(v2), ({ v2 }));
        tell_object(v2, arg2);
    }
    return;
}

mixed query_stage(mixed arg) {
    if (stringp(arg)) {
        if (undefinedp(family_stage[arg])) {
            "/adm/daemons/channeld"->do_channel(this_object(), "sys", "没有找到门派 " + arg + " 的入口。");
            return 0;
        } else {
            return family_stage[arg];
        }
    } else {
        return family_stage;
    }
}

int query_guarder_total() {
    return guarder_total;
}

void release_attacker() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    mixed v10;
    mixed v11;
    foreach (v9 in keys(scheme)) {
        if (mapp(v1 = scheme[v9])) {
            break;
        }
    }
    v3 = find_object(v1["path"]);
    if (!objectp(v3)) {
        v3 = find_object(v1["path"], 1);
    }
    if (!objectp(v5 = present(v1["id"], v3))) {
        v5 = find_object(v1["id"]);
    }
    if (!objectp(v5) || !environment(v5)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("没有找到防守方对象%s，重新制定攻击者。", v1["id"]));
        map_delete(scheme, v9);
        call_out("check_status", 1);
        return;
    }
    if (environment(v5)) {
        if (!pointerp(guarder)) {
            guarder = ({ v5 });
        } else {
            guarder += ({ v5 });
        }
    }
    v6 = v5->query("level") / 10 - 1;
    if (v6 > 10) {
        v6 = 12;
    }
    if (v6 < 5) {
        v6 = 5;
    }
    if (v6 > 10) {
        v8 = "十多名";
    } else {
        v8 = "数十名";
    }
    v2 = query_stage(guard_fam);
    attacktime += 1;
    switch (random(5)) {
    case 1:
        play_message("\e[1;33m【小道消息】\e[2;37;0m", sprintf("听说%s%s%s出现了%s%s弟子，似乎正在打%s的主意。\n", guard_fam, v2["short"], attacktime == 1 ? "" : "又", v8, attack_fam, v5->name(1)));
        break;
    case 2:
        play_message("\e[1;33m【小道消息】\e[2;37;0m", sprintf("%s的%s聚集了%s%s弟子，行动神秘，甚是诡异。\n", guard_fam, v2["short"], v8, attack_fam));
        break;
    case 3:
        play_message("\e[1;34m【攻防密函】\e[2;37;0m", sprintf("%s出现了%s神秘人，听说是冲着%s来的。\n", guard_fam, v8, v5->name(1)));
        break;
    case 4:
        play_message("\e[1;36m【飞鸽传书】\e[2;37;0m", sprintf("探子报：%s%s出现了%s%s弟子，打算进攻%s。\n", guard_fam, v2["short"], v8, attack_fam, environment(v5)->short()));
        break;
    default:
        play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("%s%s弟子赶到了%s的%s，打算对%s发起攻击。\n", v8, attack_fam, guard_fam, v2["short"], environment(v5)->short()));
        break;
    }
    v7 = v5->query("level");
    v7 = v7 / 3 + random(v7);
    if (v7 > v5->query("level")) {
        v7 = v5->query("level") + 10;
    }
    for (v11 = 0; v11 < v6; v11++) {
        attack_total++;
        v4 = clone_object("/clone/npc/attacker");
        v4->move(v2["file"]);
        if (!pointerp(attacker)) {
            attacker = ({ v4 });
        } else {
            attacker += ({ v4 });
        }
        v4->set("level", v7);
        if (attack_fam == "慕容世家" || attack_fam == "大理段家" || attack_fam == "白驼山派" || attack_fam == "灵鹫宫" || attack_fam == "唐门") {
            v4->create_family(attack_fam, 30 - v7 / 10, "传人");
        } else {
            v4->create_family(attack_fam, 30 - v7 / 10, "弟子");
        }
        v4->set("attack_target", v5->query("id"));
        v4->set("attack_family", guard_fam);
        v4->set("path", v1["path"]);
        "/adm/daemons/npcd"->full_init(v4);
        "/adm/daemons/chard"->setup_char(v4);
        if (objectp(v10 = v4->query_temp("weapon")) && (random(100) % 11 == 1 || random(20) == 10)) {
            v10->set_temp("daub/poison/name", "无名剧毒");
            v10->set_temp("daub/poison/id", v4->query("id"));
            v10->set_temp("daub/poison/remain", v4->query_skill("force"));
            v10->set_temp("daub/poison/level", v4->query("level"));
            v10->set_temp("daub/who_id", v4->query("id"));
            v10->set_temp("daub/poison_type", "poison");
            v10->set_temp("daub/poison_name", "无名剧毒");
            v10->set_temp("daub/who_name", v4->name(1));
            v4->set("have_bonus", 1);
        }
        v4->ready();
        if (random(100) % 12 == 1) {
            v4->random_move();
        }
    }
    map_delete(scheme, v9);
    call_out("check_status", 60);
    save();
    restore();
}

mixed *query_guarder(mixed arg) {
    mixed v1;
    if (!sizeof(guarder)) {
        return 0;
    }
    guarder -= ({ 0 });
    switch (arg) {
    case 1:
        v1 = filter(guarder, (: !playerp($1) :));
        return v1;
    case 2:
        v1 = filter(guarder, (: playerp($1) :));
        return v1;
    default:
        return guarder;
    }
}

mixed *query_attacker(mixed arg) {
    mixed v1;
    if (!sizeof(attacker)) {
        return 0;
    }
    attacker -= ({ 0 });
    switch (arg) {
    case 1:
        v1 = filter(attacker, (: !playerp($1) :));
        return v1;
    case 2:
        v1 = filter(attacker, (: playerp($1) :));
        return v1;
    default:
        return attacker;
    }
}

void check_status() {
    mixed v2;
    mixed v3;
    mixed v4;
    if (!mapp(scheme) || !sizeof(scheme)) {
        if (sizeof(query_attacker(1))) {
            call_out("check_status", 30);
            return;
        }
        play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("经过了%s的激战，%s与%s一战终告结束 ......\n", "/adm/daemons/chinesed"->chinese_day(time() - starttime), attack_fam, guard_fam));
        play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("在这一次激战中，%s共调遣了%s名弟子进攻%s，为数%s次。\n", attack_fam, chinese_number(attack_total), guard_fam, chinese_number(attacktime)));
        play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("%s也不甘示弱，近%s名弟子团结一致，奋勇作战。\n", guard_fam, chinese_number(guarder_total)));
        v2 = sizeof(query_guarder(1));
        v4 = "/adm/daemons/familyd"->query_family(guard_fam);
        v3 = "/adm/daemons/familyd"->query_family(attack_fam);
        if (guarder_total == v2) {
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;33m哪知%s弟子有勇有谋，齐心合力，在这次战役中力挫%s。\n\e[2;37;0m", guard_fam, attack_fam));
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;33m由于%s一役，%s声名大震，江湖声望提高了 %d 点。\n\e[2;37;0m", attack_fam[0..3] + guard_fam[0..3], guard_fam, v4 / 8));
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;31m%s败北而归，劳民伤财，得不偿失，江湖声望降低了 %d 点。\n\e[2;37;0m", attack_fam, v3 / 4));
            "/adm/daemons/familyd"->map_family_score(guard_fam, v4 / 8);
            "/adm/daemons/familyd"->map_family_score(attack_fam, -v3 / 4);
            "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("存活率：%d/%d。", v2, guarder_total));
            check_family(guard_fam);
            return;
        } else if (v2 > guarder_total / 2) {
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;31m%s遭到%s顽强抵抗，久攻不下，不得不撤销了进攻。\n\e[2;37;0m", attack_fam, guard_fam));
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;31m%s败北而回，由此江湖声望降低了 %d 点，%s的江湖声望提高了 %d 点。\n\e[2;37;0m", attack_fam, v3 / 4, guard_fam, v3 / 5));
            "/adm/daemons/familyd"->map_family_score(guard_fam, v3 / 5);
            "/adm/daemons/familyd"->map_family_score(attack_fam, -v3 / 4);
            "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("存活率：%d/%d。", v2, guarder_total));
            check_family(attack_fam);
            return;
        } else if (v2 > guarder_total / 3) {
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;31m%s伤亡惨重，元气大伤，%s内一片狼藉 ......\n", guard_fam, guard_fam));
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;33m而%s虽是获胜，却始终未能将其攻下%s，两派打成平手，不分胜负！\n", attack_fam, guard_fam));
            "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("存活率：%d/%d。", v2, guarder_total));
            top_family += ({ attack_fam });
            top_family += ({ guard_fam });
            check_family(attack_fam);
            return;
        } else if (v2 > guarder_total / 5) {
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;31m%s死的死，逃的逃，%s内横尸遍野，一片狼藉 ......\n", guard_fam, guard_fam));
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;33m%s大获全胜，众弟子敲锣打鼓，凯旋而归，此次战役终告结束 ......\n", attack_fam));
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;33m%s的江湖声望提高了 %d 点，%s的江湖声望降低了 %d 点。\n", attack_fam, v4 / 6, guard_fam, v4 / 4));
            "/adm/daemons/familyd"->map_family_score(guard_fam, -v4 / 4);
            "/adm/daemons/familyd"->map_family_score(attack_fam, v4 / 6);
            "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("存活率：%d/%d。", v2, guarder_total));
            check_family(attack_fam);
            return;
        } else {
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;31m%s华而不实，徒有虚名，在这次战役中无一幸免，惨遭灭门。\n\e[2;37;0m", guard_fam));
            play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;31m%s声名狼藉，江湖声望降低了 %d 点。\n\e[2;37;0m", guard_fam, v4 / 3));
            "/adm/daemons/familyd"->map_family_score(guard_fam, -v4 / 3);
            "/adm/daemons/familyd"->map_family_score(attack_fam, v4 / 3);
            "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("存活率：%d/%d。", v2, guarder_total));
            check_family(attack_fam);
            return;
        }
    } else if (sizeof(query_attacker(1))) {
        call_out("check_status", 30);
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "系统延迟，等待进攻方NPC消失。");
    } else {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "系统发布下一轮攻击者。");
        release_attacker();
    }
}

void check_family(mixed arg) {
    mixed v1;
    if (!stringp(arg)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "没有定义 family，检查十大门派失败。");
        return;
    }
    if (!sizeof(top_family)) {
        if (!objectp(v1 = find_living("wulin mengzhu"))) {
            v1 = find_object("wulin mengzhu", 1);
        }
        NO1_family = arg;
        play_message("\e[1;31m【诏告天下】\e[2;37;0m", sprintf("%s：%s武学渊博精深，造诣非凡，掌门与门人更是团结一致，同心同德。\n", v1->name(1), arg));
        play_message("\e[1;31m【诏告天下】\e[2;37;0m", sprintf("%s：本盟主现在宣布，%s晋升为武林天下第一派。\n", v1->name(1), arg));
        clean_up_user(attack_fam);
        clean_up_user(guard_fam);
        reset_score();
        save();
        return;
    }
    clean_up_user(attack_fam);
    clean_up_user(guard_fam);
    top_family += ({ arg });
    reset_score();
    save();
    return;
}

void join_warfare(mixed arg) {
    mixed v1;
    mixed v2;
    if (!mapp(v1 = arg->query("family"))) {
        return;
    }
    if (sizeof(playerlist) && member_array(arg->query("id"), playerlist) != -1) {
        return;
    }
    arg->set_override("unconcious", (: call_other, "/adm/daemons/warfared.lpc", "check_out" :));
    arg->set_override("die", (: call_other, "/adm/daemons/warfared.lpc", "check_out" :));
    arg->set_override("quit", (: call_other, "/adm/daemons/warfared.lpc", "check_quit" :));
    arg->set_temp("backup/killer", arg->query_killer());
    arg->set_temp("backup/want", arg->query_want());
    arg->set("backup/condition", arg->query_condition());
    arg->clear_condition();
    if (v1["family_name"] == attack_fam) {
        if (!pointerp(attacker)) {
            attacker = ({ arg });
        } else {
            attacker += ({ arg });
        }
        "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("听说%s的%s加入了进攻队伍！", v1["family_name"], arg->name(1)));
    } else if (v1["family_name"] == guard_fam) {
        if (!pointerp(guarder)) {
            guarder = ({ arg });
        } else {
            guarder += ({ arg });
        }
        "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("听说%s的%s加入了防守的阵列。", v1["family_name"], arg->name(1)));
    }
    if (!pointerp(playerlist)) {
        playerlist = ({ arg->query("id") });
    } else {
        playerlist += ({ arg->query("id") });
    }
    v2 = query_stage(guard_fam);
    arg->move(v2["file"]);
    tell_object(arg, "\e[1;36m你来到了" + v2["short"] + "，大战在即，快做好准备吧！！\n\e" + "[2;37;0m");
    return;
}

private void restore_status(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    arg->delete_override("unconcious");
    arg->delete_override("die");
    arg->delete_override("surrender");
    arg->delete_override("quit");
    arg->remove_all_enemy(1);
    arg->remove_all_killer();
    arg->clear_condition();
    arg->receive_damage("qi", 0);
    arg->apply_killer(arg->query_temp("backup/killer"));
    arg->apply_want(arg->query_temp("backup/want"));
    v1 = arg->query("backup/condition");
    arg->delete("backup/condition");
    arg->delete_temp("block_msg/all");
    arg->delete_temp("last_damage_from");
    if (!mapp(v1)) {
        return;
    }
    v2 = keys(v1);
    for (v3 = 0; v3 < sizeof(v2); v3++) {
        arg->apply_condition(v2[v3], v1[v2[v3]]);
    }
}

int check_out(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = arg->query_entire_dbase();
    v3["eff_qi"] = v3["max_qi"];
    v3["eff_jing"] = v3["max_jing"];
    v3["qi"] = v3["max_qi"];
    v3["jing"] = v3["max_jing"];
    play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;35m听说%s的%s不幸战败，被抓去了做苦工！\n\e[2;37;0m", arg->query("family/family_name"), arg->name(1)));
    v1 = all_inventory(arg);
    foreach (v2 in v1) {
        if (v2->query("no_drop")) {
            continue;
        }
        if (v2->query("id") == "steel armor") {
            continue;
        }
        v2->move(environment(arg));
    }
    tell_object(arg, "\e[1;31m\n突然，一股强烈的掌风从你后方袭来，你正想躲避，已是不及；那掌风重\n重的劈中了你的后脑，你眼前一黑，像堆烂泥似的摔倒在地....\n\n\e[2;37;0m\e[1;37m迷迷糊糊之中，只听见一老一少的声音，那少年说道：师叔，我看这厮个头\n还行，就让他去后山帮咱们师兄弟们砍柴挑水吧？\n\n\e[2;37;0m\e[1;37m那老者也不做声，半天才“嗯”了一句，随即走开了。\n\n\e[2;37;0m");
    restore_status(arg);
    if (member_array(arg, guarder) != -1) {
        guarder -= ({ arg });
    }
    if (member_array(arg, attacker) != -1) {
        attacker -= ({ arg });
    }
    if (!living(arg)) {
        arg->revive();
    }
    tell_object(arg, "\e[1;33m醒来时，你发现早已身处一片树林之中 .......\n\n\e[2;37;0m");
    arg->move("/adm/parsion/famuchang");
    arg->set("combat/arrested", arg->query("level") * 3 / 2);
    arg->apply_condition("war_arrested", 1000);
    return 1;
}

int check_quit(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = ({ "/d/center/guangchang", "/d/yangzhou/guangchang", "/d/dali/center", "/d/xiangyang/guangchang" });
    tell_object(arg, "\e[1;31m\n你眼看形势不利，心想：三十六计走为上策，于是转身拔腿就跑！\n谁知一急，左脚踩住了右脚，右脚绊住了左脚，扑通一声摔倒在地。\n\n\e[2;37;0m");
    restore_status(arg);
    play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;35m听说%s的%s丢盔弃甲，落荒而逃了。\n\e[2;37;0m", arg->query("family/family_name"), arg->name(1)));
    v1 = v2[random(sizeof(v2))];
    arg->move(v1);
    message("vision", "\e[1;36m只见" + arg->name(1) + "慌慌张张的跑了过来，扑通一声摔倒在地。\n\e" + "[2;37;0m", environment(arg), ({ arg }));
    tell_object(arg, sprintf("\e[1;32m你临阵退缩，虽然保住了性命，可是你的门派却.....\n你的江湖威望下降了 %d 点。\n你的江湖阅历下降了 %d 点。\n\e[2;37;0m", arg->query("weiwang") / 5, arg->query("score") / 10));
    arg->add("weiwang", -arg->query("weiwang") / 5);
    arg->add("score", -arg->query("score") / 10);
    return 1;
}

void clean_up_user(mixed arg) {
    mixed v1;
    mixed v2;
    if (!stringp(arg)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", "没有门派字符串，无法清理玩家保护标志。");
        return;
    }
    v1 = filter(all_interactive(), (: $1->query("family") :));
    foreach (v2 in v1) {
        if (v2->query("family/family_name") != arg) {
            continue;
        }
        if (!v2->query_condition("joinwar")) {
            continue;
        }
        restore_status(v2);
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("玩家%s的保护状态清理完毕。", v2->name(2)));
        continue;
    }
    return;
}

int give_bonus(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = ({ "/clone/warfare/blood-throwing", "/clone/warfare/dragon-sword", "/clone/warfare/ice-blade", "/clone/warfare/kill-staff", "/clone/warfare/special-hammer", "/clone/warfare/special-whip", "/clone/warfare/wuzhuima", "/clone/warfare/longju", "/clone/foe/militia/bronze-blade", "/clone/foe/militia/bronze-club", "/clone/foe/militia/bronze-hammer", "/clone/foe/militia/bronze-staff", "/clone/foe/militia/bronze-sword" });
    v2 = clone_object(v1[random(sizeof(v1))]);
    if (v2->move(arg)) {
        "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("赋予%s一%s%s。", arg->name(2), v2->query("unit"), v2->name(2)));
    } else {
        destruct(v2);
    }
    return 1;
}
