                } else if (arg->query_skill("pixie-jian", 1) >= 400) {
                    return "\e[1;35m【东厂档头】\e[2;37;0m";
                } else if (arg->query_skill("pixie-jian", 1) >= 300) {
                    return "\e[1;35m【东厂千户】\e[2;37;0m";
                } else if (arg->query_skill("pixie-jian", 1) >= 200) {
                    return "\e[1;35m【东厂百户】\e[2;37;0m";
                } else if (arg->query_skill("pixie-jian", 1) >= 150) {
                    return "\e[1;35m【东厂太监】\e[2;37;0m";
                } else if (arg->query_skill("pixie-jian", 1) >= 100) {
                    return "\e[1;35m【 太  监 】\e[2;37;0m";
                } else if (arg->query_skill("pixie-jian", 1) >= 50) {
                    return "\e[1;35m【九品太监】\e[2;37;0m";
                } else {
                    return "\e[1;35m【 小太监 】\e[2;37;0m";
                }
            default:
                if (arg->query("marry")) {
                    if (v4 < 30) {
                        return "【青年男子】";
                    } else if (v4 < 50) {
                        return "【中年男子】";
                    } else {
                        return "【 老头儿 】";
                    }
                }
                if (v5 > 2) {
                    if (v4 < 50) {
                        return "【花花公子】";
                    }
                    return "【 老色鬼 】";
                }
                if (v5) {
                    if (v4 < 50) {
                        return "【 鳏  夫 】";
                    }
                    return "【 老鳏夫 】";
                }
                if (v4 < 18) {
                    return "【 少  年 】";
                } else if (v4 < 30) {
                    return "【青年男子】";
                } else if (v4 < 50) {
                    return "【中年男子】";
                } else {
                    return "【 老处男 】";
                }
            }
        }
    }
}

string query_respect(mixed arg) {
    mixed v1;
    mixed v2;
    if (stringp(v2 = arg->query("rank_info/respect"))) {
        return v2;
    }
    if (arg->query("race") != "人类") {
        return arg->name();
    }
    v1 = arg->query("age");
    if (arg->query_skill("beauty") > 30) {
        v1 -= (arg->query_skill("beauty") - 30) / 5;
    }
    switch (arg->query("gender")) {
    case "女性":
    case "雌性":
        switch (arg->query("class")) {
        case "bonze":
            if (v1 < 20) {
                return "小师太";
            }
            return "师太";
        case "taoist":
            if (v1 < 20) {
                return "小仙姑";
            }
            return "仙姑";
        default:
            if (v1 < 20) {
                return "小姑娘";
            }
            if (v1 < 50) {
                return "姑娘";
            }
            return "婆婆";
        }
    default:
        switch (arg->query("class")) {
        case "bonze":
            if (v1 < 20) {
                return "小师父";
            }
            return "大师";
        case "lama":
            if (v1 < 50) {
                return "大师父";
            }
            return "上人";
        case "taoist":
            if (v1 < 20) {
                return "道兄";
            }
            return "道长";
        case "fighter":
        case "swordsman":
            if (v1 < 20) {
                return "小老弟";
            }
            if (v1 < 50) {
                return "壮士";
            }
            return "老前辈";
        case "eunuch":
            return "公公";
        default:
            if (v1 < 20) {
                return "小兄弟";
            }
            if (v1 < 50) {
                return "壮士";
            }
            return "老爷子";
        }
    }
}

