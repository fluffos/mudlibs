string query_close(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (objectp(arg1)) {
        if (!arg2) {
            v1 = this_player()->query("age");
        } else {
            v1 = arg1->query("age");
        }
        if (!arg2) {
            v2 = arg1->query("age");
        } else {
            v2 = arg2;
        }
    }
    if (!arg3) {
        v3 = arg1->query("gender");
    } else {
        v3 = arg3;
    }
    switch (v3) {
    case "女性":
    case "雌性":
        if (v2 - v1 >= 14) {
            return "姑姑";
        }
        if (v1 - v2 >= 14) {
            return "侄女";
        }
        if (v1 > v2) {
            return "贤妹";
        }
        return "姐姐";
        break;
    default:
        if (v2 - v1 >= 14) {
            return "叔叔";
        }
        if (v1 - v2 >= 14) {
            return "侄子";
        }
        if (v1 > v2) {
            return "贤弟";
        }
        return "哥哥";
    }
}

string query_self_close(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (objectp(arg1)) {
        if (!arg2) {
            v1 = this_player()->query("age");
        } else {
            v1 = arg1->query("age");
        }
        if (!arg2) {
            v2 = arg1->query("age");
        } else {
            v2 = arg2;
        }
    }
    if (arg2) {
        v3 = arg1->query("gender");
    } else {
        v3 = this_player()->query("gender");
    }
    switch (v3) {
    case "女性":
    case "雌性":
        if (v1 - v2 >= 14) {
            return "姑姑我";
        }
        if (v2 - v1 >= 14) {
            return "侄女我";
        }
        if (v1 > v2) {
            return "姐姐我";
        }
        return "小妹我";
        break;
    default:
        if (v1 - v2 >= 14) {
            return "叔叔我";
        }
        if (v2 - v1 >= 14) {
            return "小侄我";
        }
        if (v1 > v2) {
            return "愚兄我";
        }
        return "小弟我";
    }
}
