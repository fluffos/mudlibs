        call_out("start_vendor", 15);
        time += 1;
    } else if (time <= 3) {
        v1 = sprintf("拍卖%s的一%s%s，%s第%s次！", v6, v4, v5 + "\e" + "[1;33m", "/adm/daemons/moneyd"->price_str(now_value), chinese_number(time));
        call_out("start_vendor", 15);
