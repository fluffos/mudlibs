int valid_sell(mixed arg) {
    if (arg->is_character() || arg->query("no_pawn") || arg->query("no_get") || arg->query("no_drop") || arg->query("ownermake") || arg->query("money_id") || arg->query("no_steal") || arg->query("no_get_from") || arg->query("no_beg") || arg->is_food() || arg->is_liquid() || !arg->query("value") || (arg->query("weapon_prop") || arg->query("armor_prop")) && arg->query("consistence") < 100) {
