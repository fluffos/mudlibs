    }
    if (undefinedp(v1["cor"])) {
        v1["cor"] = v1["level"] + random(30);
    }
    if (undefinedp(v1["cou"])) {
        v1["cou"] = v1["level"] + random(30);
    }
    if (v1["max_brawn"] < 200) {
        v1["max_brawn"] = 200;
    }
    if (undefinedp(v1["brawn"])) {
        v1["brawn"] = v1["max_brawn"];
    }
    if (undefinedp(v1["max_jing"])) {
        if (v1["age"] <= 3) {
            v1["max_jing"] = 50;
        } else if (v1["age"] <= 10) {
            v1["max_jing"] = (v1["age"] - 3) * 30 + 50;
        } else if (v1["age"] <= 60) {
            v1["max_jing"] = (v1["age"] - 10) * 5 + 260;
        } else {
            v1["max_jing"] = v1["max_jing"] = v1["age"] - 60 + 510;
        }
    }
    if (undefinedp(v1["max_qi"])) {
        if (v1["age"] <= 10) {
            v1["max_qi"] = 100;
        } else if (v1["age"] <= 30) {
            v1["max_qi"] = (v1["age"] - 10) * 30 + 100;
        } else {
            v1["max_qi"] = v1["max_qi"] = (v1["age"] - 30) * 10 + 700;
        }
    }
    if (!arg->query_weight()) {
