    return 0;
}

int do_bonus(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    if (!mapp(v1 = arg->query("quest"))) {
        return 0;
    }
    if (v1["task_time"] - time() > 0) {
        tell_object(arg, "\e[1;33m你在规定的时间内完成了任务，获得了任务奖励。\n\e[2;37;0m");
        v2 = v1["exp"] + arg->query("level") + arg->query_temp("counts");
        v3 = (v1["pot"] + arg->query("level") + arg->query_temp("counts")) / 2;
        if (arg->add_exp(arg, v2) && arg->add_points(arg, v3)) {
            v4 = clone_object("/clone/money/silver");
            v4->set_amount(random(3) + 1);
            v4->move(arg, 1);
            arg->add("weiwang", (v2 + v3) / 5);
            arg->add("score", 1);
        }
        arg->add_temp("counts", 1);
        extra_bonus(arg);
        arg->delete("quest");
        return 1;
    } else {
        tell_object(arg, "\e[1;31m你完成了任务，可惜已经超过了规定的时间。\n\e[2;37;0m");
        arg->add("weiwang", -50);
        arg->delete("quest");
        return 1;
    }
