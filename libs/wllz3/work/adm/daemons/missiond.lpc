int give_quest(mixed arg1, mixed arg2) {
    mixed v3;
    if (arg2->query("level") < 20) {
        tell_object(arg2, arg1->name() + "说道：以你现在的级别，让你去闯荡江湖未必过于冒险。\n你还是先把基本功练好了再说吧！\n");
        return 1;
    }
    v3 = arg2->query("quest");
    if (mapp(v3)) {
        if (v3["from"] != "门派") {
            tell_object(arg2, arg1->name() + "对你摇了摇头，说道：你不是去帮" + v3["from"] + "办事了吗？把事情办好了再说吧。\n");
            return 1;
        }
        if (!undefinedp(v3["fail_time"]) && v3["fail_time"] - time() > 0) {
            tell_object(arg2, arg1->name() + "说道：我的事已经交给其他人去做了，你先去休息一下再说吧！\n");
            return 1;
        }
        if (v3["task_time"] - time() > 0) {
            tell_object(arg2, arg1->name() + "说道：我吩咐的事，你做的怎么样啦？\n");
            return 1;
        }
        tell_object(arg2, arg1->name() + "说道：好吧，我就再给你一次机会。\n");
        arg2->receive_damage("qi", arg2->query("qi") / 100, arg1);
        arg2->delete("quest");
        arg2->start_busy(1);
        return 1;
    }
    if (create_quest(arg1, arg2)) {
        tell_object(arg2, reply_player(arg1, arg2));
        return 1;
    }
}

