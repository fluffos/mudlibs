        arg->add_exp(arg, v2);
        v2 = (v1 - 1) * 10;
        arg->add_points(arg, v2);
        v3 = v1 / 5;
        if (v3 > 5) {
            v3 = random(5) + 1;
        }
        "/adm/daemons/familyd"->map_family_score(arg->query("family/family_name"), v3);
        if (v1 > 400) {
