    }
    if (arg1[0] == 109 || arg1[0] == 77) {
        arg3->set("gender", "男性");
    } else if (arg1[0] == 102 || arg1[0] == 70) {
        arg3->set("gender", "女性");
    } else {
        write("对不起，您只能选择男性(\e[1;36mm\e[2;37;0m)或女性(\e[1;35mf\e[2;37;0m)的角色：");
        input_to("get_gender", arg2, arg3);
        return;
    }
    log_file("newbie", sprintf("[%s]新玩家 %s[%s]来自[%s]\n", ctime(time()), arg3->name(1), arg3->query("id"), query_ip_number(arg2)));
    init_new_player(arg3);
    enter_world(arg2, arg3);
}

object make_body(mixed arg) {
    mixed v1;
    seteuid(getuid());
    v1 = clone_object("/clone/user/user");
    if (!v1) {
        write("现在可能有巫师正在修改使用者物件的程式，请稍候再试。\n");
        destruct(arg);
    }
    seteuid(arg->query("id"));
    export_uid(v1);
    export_uid(arg);
    seteuid(getuid());
    v1->set("id", arg->query("id"));
    v1->set_name(arg->query("name"), ({ arg->query("id") }));
    return v1;
}

private void init_new_player(mixed arg) {
    arg->set("title", "平民百姓");
    arg->set("birthday", time());
    arg->set("potential", 100);
    arg->set("food", arg->max_food_capacity());
    arg->set("water", arg->max_water_capacity());
    arg->set("exp_cost/points", 30);
    arg->set("exp_cost/exp", 0);
    arg->set("channels", ({ "chat", "rumor", "dealer", "party", "master", "banghui", "frds", "tt", "sos", "teach" }));
    arg->set("balance", 1000);
    arg->set("env/prompt", "time");
    arg->set("env/wimpy", 60);
    arg->set("valid_attack", "无效");
    "/adm/daemons/named.lpc"->map_name(arg->query("name"), arg->query("id"));
    message("channel:chat", "\e[1;37m【奇幻异象】\e[1;35m东面的天空中亮起一片紫红色的云彩，又一个新生命降生凡间。\n\e[2;37;0m", users());
}

varargs void enter_world(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    if (!is_root(previous_object())) {
        return;
    }
    if (arg2->query("name") != arg1->query("name")) {
        "/adm/daemons/named.lpc"->remove_name(arg1->query("name"), arg1->query("id"));
        "/adm/daemons/named.lpc"->map_name(arg2->query("name"), arg2->query("id"));
        arg1->set("name", arg2->query("name"));
    }
    arg2->set_temp("link_ob", arg1);
    arg1->set_temp("body_ob", arg2);
    arg2->set("registered", arg1->query("registered"));
    if (interactive(arg1)) {
        exec(arg2, arg1);
    }
    write("\n目前权限：" + wizhood(arg2) + "\n");
    if (arg2->query("mud_age") < 1) {
        write("─────────────────────────────────\n新手须知：\n\n您好，新玩家！请先阅读相关游戏规则。使用 \e[1;37mhelp\e[0m 查阅帮助信息！\n请访问我们的游戏主页『\e[1;37mhttp://www.cnmud.com\e[0m』，从中得到帮助。\n─────────────────────────────────\n");
        write(motd);
        write("\e[1;32m\n恭喜！游戏角色创建成功，您现在可以使用 \e[1;37mlevelup \e[1;32m指令进行属性分配。\n在分配之前，请用\e[1;37m help levelup \e[1;32m查看相关指令，属性一旦分配成功，将无\n法改变。您目前可分配点数为：\e[1;37m 30 \e[1;32m 点。\n\n\e[2;37;0m");
        input_to("come_in", arg2);
    } else {
        write(motd2);
        v1 = clone_object("/clone/user/login");
        v1->set("id", arg2->query("id"));
        v1->restore();
        write(sprintf("您上次光临本站是在 %s 从 %s 连接。", ctime(v1->query("last_on")), v1->query("last_from")));
        destruct(v1);
    }
    arg2->setup();
    arg2->save();
    arg2->set("last_save", time());
    arg1->save();
    "/adm/daemons/updated"->check_user(arg2);
    if (!arg3) {
        if (arg2->is_ghost()) {
            v2 = "/d/death/gate.lpc";
            arg2->move("/d/death/gate.lpc");
        } else if (arg2->query_condition("parsion")) {
            v2 = "/d/xingbu/qiushi1";
            arg2->move("/d/xingbu/qiushi1");
        } else if (!stringp(v2 = arg2->query("startroom")) || file_size(v2 + ".lpc") < 0) {
            v2 = place[random(sizeof(place))];
            arg2->move(v2);
        } else if (!catch {
    find_object(v2, 1);
}) {
            arg2->move(v2);
        } else {
            arg2->move("/d/center/inn.lpc");
            v2 = "/d/center/inn.lpc";
            arg2->set("startroom", "/d/center/inn.lpc");
        }
        tell_room(v2, arg2->query("name") + "连线进入这个世界。\n", ({ arg2 }));
    }
    "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("%s%s由(%s)连线进入。", wizardp(arg2) ? "\e[1;37m" : "", arg2->name(2), query_ip_name(arg2)));
    arg2->set_temp("login/level", arg2->query("level"));
    arg2->set_temp("login/time", time());
    "/adm/daemons/newsd"->prompt_user(arg2);
    "/adm/daemons/toptend"->top_checkplayer(arg2);
    "/adm/daemons/logd"->user_login();
    arg2->check_brother_online();
    if ((arg2->query("qi") < 0 || arg2->query("jing") < 0) && living(arg2)) {
        arg2->unconcious();
    }
    if (arg2->is_want_now()) {
        "/cmds/std/want"->check_status(arg2);
    }
}

varargs void reconnect(mixed arg1, mixed arg2, mixed arg3) {
    arg2->set_temp("link_ob", arg1);
    arg1->set_temp("body_ob", arg2);
    exec(arg2, arg1);
    arg2->reconnect();
    if (!arg3) {
        tell_room(environment(arg2), arg2->query("name") + "重新连线回到这个世界。\n", ({ arg2 }));
    }
    "/adm/daemons/channeld"->do_channel(this_object(), "sys", sprintf("%s由(%s)重新连线进入。", arg2->query("name"), query_ip_name(arg2)));
}

int check_legal_id(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = sizeof(arg);
    if (sizeof(arg) < 3 || sizeof(arg) > 8) {
        write("对不起，你的英文名字必须是 3 到 8 个英文字母。\n");
        return 0;
    }
    while (v1--) {
        if (arg[v1] < 97 || arg[v1] > 122) {
            write("对不起，你的英文名字只能用英文字母。\n");
            return 0;
        }
    }
    if (file_size("/data/config/banned_ids") >= 0) {
        v2 = explode(read_file("/data/config/banned_ids"), "\n");
    } else {
        v1 = sizeof(v2);
        while (v1--) {
            write_file("/data/config/banned_ids", v2[v1] + "\n", 0);
        }
    }
    for (v1 = 0; v1 < sizeof(v2); v1++) {
        if (strsrch(arg, v2[v1]) == -1) {
            continue;
        }
        write("对不起，这种英文名字会造成其他人的困扰。\n");
        return 0;
    }
    return 1;
}

int check_legal_name(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = sizeof(arg);
    if (sizeof(arg) < 1 || sizeof(arg) > 4) {
        write("对不起，你的中文名字必须是 1 到 4 个中文字。\n");
        return 0;
    }
    while (v1--) {
        if (arg[v1] <= 32) {
            write("对不起，你的中文名字不能用控制字元。\n");
            return 0;
        }
        if (!is_chinese(arg[v1..v1])) {
            write("对不起，请您用「中文」取名字。\n");
            return 0;
        }
    }
    for (v1 = 0; v1 < sizeof(v2); v1++) {
        if (strsrch(arg, v2[v1]) == -1) {
            continue;
        }
        write("对不起，这种名字会造成其他人的困扰。\n");
        return 0;
    }
    return 1;
}

object find_body(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (objectp(v1 = find_player(arg))) {
        return v1;
    }
    v2 = children("/clone/user/user");
    for (v3 = 0; v3 < sizeof(v2); v3++) {
        if (clonep(v2[v3]) && getuid(v2[v3]) == arg) {
            return v2[v3];
        }
    }
    return 0;
}

int set_wizlock(mixed arg) {
    if (wiz_level(this_player(1)) <= arg) {
        return 0;
    }
    if (geteuid(previous_object()) != "Root") {
        return 0;
    }
    wiz_lock_level = arg;
    return 1;
}

int set_lock(mixed arg) {
    mud_lock = arg;
    return 1;
}

int can_login(mixed arg) {
    if (arg < wiz_lock_level) {
        return 0;
    }
    return 1;
}

int check_legal_password(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v2 = 0;
    v3 = 0;
    v1 = sizeof(arg2);
    if (sizeof(arg2) < 6) {
        write("对不起，你的密码必须最少六个字符。\n");
        return 0;
    }
    v4 = arg1->query("id");
    if (strsrch(v4, arg2) != -1 || strsrch(arg2, v4) != -1) {
        write("对不起，你的密码和你的英文名字太象了。\n");
        return 0;
    }
    while (v1--) {
        if (arg2[v1] <= 90 && arg2[v1] >= 65) {
            v2++;
        }
        if (arg2[v1] <= 122 && arg2[v1] >= 97) {
            v3++;
        }
    }
    if (!v2 || !v3 || v2 + v3 == sizeof(arg2)) {
        write("您的密码必须包含\e[1;31m大写\e[2;37;0m和\e[1;31m小写英文字母\e[2;37;0m以及\e[1;31m其它字符\e[2;37;0m，例如：Mud-123。\n");
        return 0;
    }
    return 1;
}
