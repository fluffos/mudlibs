    if (!stringp(v4 = arg3->query_temp("daub/poison_type"))) {
        return;
    }
    if (!v1["remain"]) {
        return;
    }
    if (arg1->query_temp("armor/hands")) {
        return;
    }
    v2 = allocate_mapping(4);
    v2["level"] = v1["level"] * 7 / 10 + 1;
    v2["id"] = v1["id"];
    v2["name"] = v1["name"];
    v2["duration"] = 1;
    if (v1["remain"] > v1["level"]) {
        v1["remain"] -= v1["level"];
    } else {
        arg3->delete_temp("daub");
    }
    v3 = "\e[1;32m\n突然$N觉得浑身有些麻痒";
    if (v1["id"] == arg1->query("id")) {
        if (!arg1->query_temp("has_announce/defense1")) {
            arg1->set_temp("has_announce/defense1", 1);
            arg1->start_call_out(bind((: call_other, "/adm/daemons/combatd.lpc", "clear_announce", arg1 :), arg1), 15);
            v3 += "。\n\e[2;37;0m\e[1;36m$N默一运功，冷笑两声：“好你个" + "/adm/daemons/rankd"->query_rude(arg2) + "，居然在我面前卖弄" + "/adm/daemons/rankd"->query_self_rude(arg2) + "的毒药！把你衣服上的毒药都还给我！”\n\e" + "[2;37;0m";
        } else {
            v3 += "，不过$N并没有在意。\n\e[2;37;0m";
        }
        set_ahinfo(v3);
        return;
    }
    if (v1["level"] < arg1->query_skill("poison", 1)) {
        if (!arg1->query_temp("has_announce/defense2")) {
            arg1->set_temp("has_announce/defense2", 1);
            arg1->start_call_out(bind((: call_other, "/adm/daemons/combatd.lpc", "clear_announce", arg1 :), arg1), 15);
            v3 += "。\n\e[2;37;0m\e[1;36m$N呼吸数次，嘿然冷笑道：“雕虫小技，也敢出来献丑？你在衣衫上淬毒我就怕你了？”\n\e[2;37;0m";
        } else {
            v3 += "，不过$N显然并没有把它放在心上。\n\e[2;37;0m";
        }
        set_ahinfo(v3);
        return;
    }
    if (v1["level"] < arg1->query_skill("force") / 2) {
        if (!arg1->query_temp("has_announce/defense3")) {
            arg1->set_temp("has_announce/defense3", 1);
            arg1->start_call_out(bind((: call_other, "/adm/daemons/combatd.lpc", "clear_announce", arg1 :), arg1), 15);
            v3 += "。\n\e[2;37;0m\e[1;37m$N深吸一口气，哈哈长笑道：“你居然在衣衫上淬毒，这些下三滥的手段也敢到我面前卖弄？”\n\e[2;37;0m";
        } else {
            v3 += "，不过$N看起来似乎并无大碍。\n\e[2;37;0m";
        }
        set_ahinfo(v3);
        return;
    }
    arg1->affect_by(v4, v2);
    v3 += "，看来有些不妙。\n\e[2;37;0m";
    if (v1["level"] < arg1->query_skill("force")) {
        v3 += "\e[1;32m$N深深吸一了口气，面目凝重，手中的攻势陡然一紧。\n\e[2;37;0m";
        set_ahinfo(v3);
        return;
    }
    v3 += "\e[1;31m$N脚步一个跄踉，攻势顿缓，神色难看之极。\n\e[2;37;0m";
    arg1->start_busy(random(2) + 1);
    set_ahinfo(v3);
    return;
}

void clear_announce(mixed arg) {
    if (!objectp(arg)) {
        return;
    }
    arg->delete_temp("has_announce");
}
