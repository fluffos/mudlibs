string eff_status_msg(mixed arg) {
    if (arg == 100) {
        return "\e[1;32m看起来气血充盈，并没有受伤。\e[2;37;0m";
    }
    if (arg > 95) {
        return "\e[1;32m似乎受了点轻伤，不过光从外表看不大出来。\e[2;37;0m";
    }
    if (arg > 90) {
        return "\e[1;33m看起来可能受了点轻伤。\e[2;37;0m";
    }
    if (arg > 80) {
        return "\e[1;33m受了几处伤，不过似乎并不碍事。\e[2;37;0m";
    }
    if (arg > 60) {
        return "\e[1;33m受伤不轻，看起来状况并不太好。\e[2;37;0m";
    }
    if (arg > 40) {
        return "\e[31m气息粗重，动作开始散乱，看来所受的伤著实不轻。\e[2;37;0m";
    }
    if (arg > 30) {
        return "\e[31m已经伤痕累累，正在勉力支撑著不倒下去。\e[2;37;0m";
    }
    if (arg > 20) {
        return "\e[31m受了相当重的伤，只怕会有生命危险。\e[2;37;0m";
    }
    if (arg > 10) {
        return "\e[1;31m伤重之下已经难以支撑，眼看就要倒在地上。\e[2;37;0m";
    }
    if (arg > 5) {
        return "\e[1;31m受伤过重，已经奄奄一息，命在旦夕了。\e[2;37;0m";
    }
    return "\e[31m受伤过重，已经有如风中残烛，随时都可能断气。\e[2;37;0m";
}

string status_msg(mixed arg) {
    if (arg == 100) {
        return "\e[1;32m看起来充满活力，一点也不累。\e[2;37;0m";
    }
    if (arg > 95) {
        return "\e[1;32m似乎有些疲惫，但是仍然十分有活力。\e[2;37;0m";
    }
    if (arg > 90) {
        return "\e[1;33m看起来可能有些累了。\e[2;37;0m";
    }
    if (arg > 80) {
        return "\e[1;33m动作似乎开始有点不太灵光，但是仍然有条不紊。\e[2;37;0m";
    }
    if (arg > 60) {
        return "\e[1;33m气喘嘘嘘，看起来状况并不太好。\e[2;37;0m";
    }
    if (arg > 40) {
        return "\e[31m似乎十分疲惫，看来需要好好休息了。\e[2;37;0m";
    }
    if (arg > 30) {
        return "\e[31m已经一副头重脚轻的模样，正在勉力支撑著不倒下去。\e[2;37;0m";
    }
    if (arg > 20) {
        return "\e[31m看起来已经力不从心了。\e[2;37;0m";
    }
    if (arg > 10) {
        return "\e[1;31m摇头晃脑、歪歪斜斜地站都站不稳，眼看就要倒在地上。\e[2;37;0m";
    }
    return "\e[31m已经陷入半昏迷状态，随时都可能摔倒晕去。\e[2;37;0m";
}

varargs void report_status(mixed arg1, mixed arg2) {
    if (arg2) {
        message_vision("「$N" + eff_status_msg(arg1->query("qi") * 100 / arg1->query("max_qi")) + "」\n", arg1);
    } else {
        message_vision("「$N" + status_msg(arg1->query("qi") * 100 / arg1->query("max_qi")) + "」\n", arg1);
    }
}

