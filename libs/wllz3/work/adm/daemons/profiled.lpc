    }
}

void make_profile(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = keys(command_log);
    sorting_by = arg;
    if (!stringp(arg)) {
        v2 = sort_array(v2, 1);
    } else {
        v2 = sort_array(v2, "sort_entry", this_object());
