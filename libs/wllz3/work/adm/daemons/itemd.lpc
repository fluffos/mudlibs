void reduce_consistence(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = arg->query("stable");
    if (v1 < 2) {
        return;
    }
    v2 = arg->query("consistence");
    if (random(v1) > (100 - v2) / 12) {
        return;
    }
    if (arg->add("consistence", -1) > 0) {
        return;
    }
    arg->set("consistence", 0);
    if (environment(arg)) {
        tell_object(environment(arg), "\e[1;32m你的" + arg->name() + "\e" + "[1;32m已经彻底损坏了。\n\e" + "[2;37;0m");
    }
    if (arg->query("ownermake") && arg->query("level") > 1) {
        arg->add("level", -1);
    }
    arg->unequip();
}

void equip_setup(mixed arg) {
