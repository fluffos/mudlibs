    if (undefinedp(v2["consistence"])) {
        v2["consistence"] = 100;
    }
    if (!undefinedp(v2["weapon_prop"])) {
        if (arg->query("ownermake")) {
            v2["courage"] = v2["weapon_prop"]["damage"] / 5;
        } else {
            v2["courage"] = v2["weapon_prop"]["damage"] / 4;
        }
    }
    if (undefinedp(v2["attributive"])) {
        v2["attributive"] = att[random(sizeof(att))];
    }
    if (undefinedp(arg->query("stable"))) {
        switch (arg->query("material")) {
        case "cloth":
            v1 = 6;
            break;
        case "paper":
            v1 = 4;
            arg->set("no_repair", "这东西我可没法修理。\n");
            break;
        case "bone":
            v1 = 8;
            arg->set("no_repear", "修理这个？可别拿我寻开心。\n");
            break;
        case "bamboo":
        case "wood":
            v1 = 10;
            arg->set("no_repair", "这东西我咋修理？\n");
            break;
        case "stone":
            v1 = 20;
            arg->set("no_repair", "这个坏了就坏了，可修不了。\n");
            break;
        case "copper":
            v1 = 40;
            break;
        case "silver":
            v1 = 40;
            break;
        case "iron":
            v1 = 45;
            break;
        case "gold":
            v1 = 50;
            break;
        case "steel":
            v1 = 75;
            break;
        default:
            v1 = 100;
            break;
        }
        if (!arg->is_item_make()) {
            v1 /= 2;
        }
        arg->set("stable", v1);
    }
}

void killer_reward(mixed arg1, mixed arg2, mixed arg3) {
    mixed v3;
    mixed v5;
    if (!arg1 || !arg2) {
        return;
    }
    if (!arg2->query("can_speak")) {
        return;
    }
    if (userp(arg2)) {
        arg3->add("status/PKS", 1);
    } else {
        arg3->add("status/MKS", 1);
    }
    if (arg3->query("status/MKS") > 1 && arg3->query("status/MKS") % 50 == 1) {
        message_vision("\e[1;34m冥冥之中，从$N手中的" + arg3->name() + "\e" + "[1;34m传来一股迫人的杀气，令人不安。\n\e" + "[2;37;0m", arg1);
    }
