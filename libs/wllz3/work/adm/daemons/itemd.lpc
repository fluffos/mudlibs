    }
    tell_object(arg, v5);
    v12->move(arg, 1);
    return;
}

int raze_item(mixed arg1, mixed arg2) {
    if (previous_object() && getuid(previous_object()) != "Unknow" && getuid(previous_object()) != "Domain") {
        return 0;
    }
    if (arg2 != base_name(arg1) + ".lpc") {
        return 0;
    }
    rm(arg2);
    return 1;
}
