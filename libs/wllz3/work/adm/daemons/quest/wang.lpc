void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    switch (random(2)) {
    case 0:
        say(query("name") + "笑咪咪地说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，可要买什么药？\n");
        break;
    case 1:
        say(query("name") + "笑咪咪地拱了拱手，说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，请进请进。\n");
        break;
    }
}

int ask_yaofang() {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("zg_mark")) {
        command("say 老朽不才，医术平平，开不出什么药方。");
        return 1;
    }
    command("say " + "/adm/daemons/rankd"->query_respect(v1) + "要问什么药的方子，尽管说吧。");
    return 1;
}

