int ask_job() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    if (v1->query("career") != "药理师" && v1->query("career") != "药剂师") {
        tell_object(v1, "王通治说道：依我看，这位" + "/adm/daemons/rankd"->query_respect(v1) + "还是先去学点药理常识再说。\n");
        return 1;
    }
    if (v1->query_skill("herbal-skill", 1) < 1) {
        tell_object(v1, "王通治说道：依我看，这位" + "/adm/daemons/rankd"->query_respect(v1) + "还是先掌握一些药理常识再说吧。\n");
        return 1;
    }
    if (mapp(v2 = v1->query("quest"))) {
        if (v2["from"] != "药店") {
            tell_object(v1, "王通治说道：你不是在帮" + v2["from"] + "做事吗？先把事情完成了再说吧。\n");
            return 1;
        }
        if (v2["task_time"] > time()) {
            tell_object(v1, "王通治说道：我不是叫你去帮我采集一些" + v2["quest"] + "了吗？\n");
            return 1;
        }
        if (v2["fail_time"] > time()) {
            tell_object(v1, "王通治说道：你还是一会再来吧，" + v2["quest"] + "已经有人去帮你找了。\n");
            return 1;
        }
        tell_object(v1, "王通治说道：那好吧，这次你可要好好把握时间了。\n");
        v1->delete("quest");
    }
    v3 = time() / 236 + 2;
    v3 = v3 * 236;
    v4 = v1->query_skill("herbal-skill", 1);
    if (v4 < 100) {
        v2 = "/quest/herb/gurb"->query_quest();
    } else {
        v2 = "/quest/herb/officinal"->query_quest();
    }
    if (v4 > v1->query("level")) {
        v4 = v1->query("level") - 20;
    }
    if (v4 < 30) {
        v4 = 30;
    }
    v4 = v4 + random(v4) / 10 + v1->query_temp("counts");
    v1->set("quest/quest", v2["quest"]);
    v1->set("quest/from", v2["from"]);
    v1->set("quest/type", v2["type"]);
    v1->set("quest/base", v2["base"]);
    v1->set("quest/exp", v4);
    v1->set("quest/pot", v4 / 2);
    v1->set("quest/task_time", v3);
    if (v2["type"] == "take") {
        tell_object(v1, sprintf("王通治说道：你来得正好，前些日子有家药馆在我这里订购了些%s，\n可惜店里已经卖完了，你现在赶紧去帮我摘一些%s，赶在%s\n之前回来，不然咱店里的招牌可就不保了。\n", v2["quest"], v2["quest"], "/adm/daemons/chinesed"->chinese_monthday(v3)));
    } else {
        tell_object(v1, sprintf("王通治说道：你来得正好，店里的%s刚好卖完了，你赶紧去内堂炼制\n一些出来，事不宜迟，赶紧进去吧。\n", v2["quest"]));
    }
    return 1;
}

int cleanup_quest(mixed arg) {
    if (!arg || !environment(arg)) {
        return 0;
    }
    if (!mapp(arg->query("quest"))) {
        return 0;
    }
    tell_object(arg, sprintf("\e[1;37m听说王通治要的%s\e[1;37m已经找到了。\n\e[2;37;0m", arg->query("quest/quest")));
    arg->delete("quest");
    return 1;
}
