        if (v1["from"] != "药店") {
            tell_object(arg1, "王通治一脸狐疑的盯着你说道：你给我这东西做什么？\n");
            return 0;
        }
        if (arg2->name(1) != v1["quest"]) {
            tell_object(arg1, "王通治邹了邹眉头，说道：药材这方面我可是行家，这是" + arg2->name(1) + "，不是" + v1["quest"] + "。\n");
            return 0;
        }
        if (base_name(arg2) != v1["base"]) {
            tell_object(arg1, "王通治摇了摇头说道：这不是我要的东西。\n");
            return 0;
        }
        if (time() - v1["task_time"] > 0) {
            tell_object(arg1, "王通治满脸怨气的埋怨道：你怎么现在才送来，我的招牌险些让人拆了。\n");
            arg1->delete("quest");
            return 1;
        }
        if (arg2->query("from") != arg1->query("id")) {
            tell_object(arg1, "王通治骂道：小小事情也让人代劳，真是个懒鬼。\n");
            arg1->delete("quest");
            return 1;
        }
        if (arg2->query("time") < time()) {
            tell_object(arg1, "王通治摇了摇头，说道：唉，这" + arg2->name() + "已经变质了。\n");
            arg1->delete("quest");
            return 1;
        }
        tell_object(arg1, "王通治眉开眼笑的说道：好，做的好！接过" + arg2->name() + "转身就投进了药柜子里。\n");
        tell_object(arg1, "\e[1;37m由于你成功的帮王通治找到了" + v1["quest"] + "\e" + "[1;37m，得到了一些奖励。\n\e" + "[2;37;0m");
        if (arg1->add_exp(arg1, v1["exp"]) && arg1->add_points(arg1, v1["pot"])) {
