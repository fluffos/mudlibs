    mixed v2;
    if (arg2->query("money_id")) {
        if (arg2->value() >= 10000) {
            command("say 既承" + "/adm/daemons/rankd"->query_respect(arg1) + "重金之惠，有何疑问尽管说出，我是知无不言，言无不尽。\n");
            arg1->set_temp("zg_mark", 1);
            return 1;
        } else if (arg2->value() >= 3000) {
            if (arg1->query("quest/from") != "药店") {
                tell_object(arg1, "王通治说道：你想打听药方？至少也得给个一两黄金吧？\n");
                return 0;
            }
            if (arg1->query("quest/fail_time") - time() > 0) {
