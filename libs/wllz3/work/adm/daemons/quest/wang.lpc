    } else {
    }
    if (arg == "yx-wan") {
        command("whisper " + v2 + " " + "川贝一钱，枸枳子一包，菊梗一钱，加水煎熬就可制成。");
    }
    if (arg == "yj-dan") {
        command("whisper " + v2 + " " + "荷叶一张，菊梗一钱，加水熬干就可制成。");
    }
    if (arg == "qx-san") {
        switch (random(2)) {
        case 0:
            command("whisper " + v2 + " " + "雄黄一钱，以巴豆为清泻剂，加水熬干就可制成。");
            break;
        case 1:
            command("whisper " + v2 + " " + "菊梗两钱，以巴豆为清泻剂，加水熬干就可制成。");
            break;
        }
    } else {
    }
    if (arg == "she-yao") {
        switch (random(2)) {
        case 0:
            command("whisper " + v2 + " " + "牛黄一钱，雄黄一钱，加水熬干就可制成。");
            break;
        case 1:
            command("whisper " + v2 + " " + "牛黄一钱，菊梗两钱，加水熬干就可制成。");
            break;
        }
    } else {
    }
    if (arg == "bc-dan") {
        switch (random(2)) {
        case 0:
            command("whisper " + v2 + " " + "藏红花一钱，生地两钱，加水熬干就可制成。");
            break;
        case 1:
            command("whisper " + v2 + " " + "藏红花一钱，穿山甲一只，加水熬至成型即可。");
            break;
        }
    } else {
    }
    v1->delete_temp("zg_mark");
