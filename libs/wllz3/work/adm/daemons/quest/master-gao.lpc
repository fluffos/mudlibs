}

int do_quest() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query("level") < 50) {
        reply_user(v1, "这位" + "/adm/daemons/rankd"->query_respect(v1) + "一心为朝廷办事虽然精\n神可佳，可惜经验尚浅，恐怕难以担此大任！\n");
        return 1;
