    if (v1->query("level") >= 100) {
        reply_user(v1, "/adm/daemons/rankd"->query_respect(v1) + "大名如雷灌耳，本官岂敢劳烦您呢？\n");
        return 1;
    }
    if (mapp(v2 = v1->query("quest"))) {
        if (v2["from"] != "官府") {
            reply_user(v1, "这位" + "/adm/daemons/rankd"->query_respect(v1) + "还有要事在身，还是等一下再说吧。\n");
            return 1;
        }
        if (v2["task_time"] > time()) {
            reply_user(v1, "嗯，我吩咐你去做的事情怎么样了？\n");
            return 1;
        }
        if (v2["fail_time"] > time()) {
            reply_user(v1, "任务有别的人去做了，你等一下再来吧。\n");
            return 1;
        } else {
            reply_user(v1, "唉，好吧，我就再给你一次机会。\n");
            v1->receive_damage("qi", 100);
            if (v1->query("quest")) {
                v1->delete("quest");
            }
            if (v1->query_temp("arrest")) {
                v1->delete_temp("arrest");
            }
        }
    }
    if (create_event(v1)) {
        v2 = v1->query("quest");
    } else {
        reply_user(v1, "咦？任务创建失败，请速和巫师联系。\n");
        return 1;
    }
    if (v2["type"] == "kill") {
        reply_user(v1, sprintf("据闻一名为%s的狂徒在%s烧杀抢掠，连伤数条\n人命。你务必在%s之前将他捉拿归案。如有违抗者：杀无赦！\n", v2["quest"], v2["where"], "/adm/daemons/chinesed"->chinese_monthday(v2["task_time"])));
    } else {
        reply_user(v1, sprintf("接报本府通缉要犯%s在最近在%s附近出没，你务\n必在%s之前将他捉拿归案，以待发落。切记不可将他杀死。\n", v2["quest"], v2["where"], "/adm/daemons/chinesed"->chinese_monthday(v2["task_time"])));
    }
    return 1;
}

