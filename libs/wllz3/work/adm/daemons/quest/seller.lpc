int do_quest() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query("level") < 20) {
        reply_user(v1, "送货这差事走南闯北，相当辛苦，依我看这位" + "/adm/daemons/rankd"->query_respect(v1) + "还未能胜任呀。");
        return 1;
    }
    if (v1->query("level") >= 50) {
        reply_user(v1, "/adm/daemons/rankd"->query_respect(v1) + "经验丰富，应该多到江湖上闯荡，怎能在此屈就呢？");
        return 1;
    }
    if (mapp(v2 = v1->query("quest"))) {
        if (v2["from"] != "货行") {
            reply_user(v1, "你不是正为" + v2["from"] + "办事吗？怎可三心二意？");
            return 1;
        }
        if (v2["task_time"] > time()) {
            reply_user(v1, v2["quest"] + "要的" + v2["goods"] + "，你给送去了吗？");
            return 1;
        }
        if (v2["fail_time"] > time()) {
            reply_user(v1, v2["quest"] + "的" + v2["goods"] + "已经有人送去了，你待会再来吧。");
            return 1;
        } else {
            reply_user(v1, "唉，好吧，我就再相信你一次。");
            v1->receive_damage("qi", 100);
            if (v1->query("quest")) {
                v1->delete("quest");
            }
        }
    }
    if (create_event(v1)) {
        v2 = v1->query("quest");
    } else {
        reply_user(v1, "咦？任务创建失败，请速和巫师联系。");
        return 1;
    }
    reply_user(v1, sprintf("前些日子有个叫%s的在我这订了些%s，还没来得及\n送去，你就帮我跑一趟，赶在%s之前把它送到%s去。", v2["quest"], v2["goods"], "/adm/daemons/chinesed"->chinese_monthday(v2["task_time"]), v2["where"]));
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2->query("money_id")) {
        if (!mapp(v1 = arg1->query("quest")) || v1["from"] != "货行") {
