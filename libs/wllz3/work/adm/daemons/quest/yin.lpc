    if (!arg || environment(arg) != environment()) {
        return;
    }
    switch (random(2)) {
    case 0:
        say("殷大迎上前来，问道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，可是要买皮料？\n");
        break;
    case 1:
        say("殷大笑冷冷的看了看你，说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，可是有皮料卖我啊？\n");
        break;
    }
}

