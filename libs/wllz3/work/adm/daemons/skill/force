int valid_enable(string usage)
{
	return usage == "force";
}

int valid_learn(object me)
{
	if((int)me->query_skill("force", 1) < 50)
		return notify_fail("你的基本内功火候不足，无法领悟这种高深的内功。\n");

	if((int)me->query_skill("force",1) < (int)me->query_skill(info["name"],1)
	&&  me->query("id") != info["master_id"])
		return notify_fail("你的基本内功火候不足，无法领悟这种高深的内功。\n");

	return 1;
}
