    switch (arg3) {
    case "name":
        message_vision("\e[36m$N向$n问道：敢问" + "/adm/daemons/rankd"->query_respect(arg2) + "尊姓大名？\n\e" + "[2;37;0m", arg1, arg2);
        return 1;
    case "here":
