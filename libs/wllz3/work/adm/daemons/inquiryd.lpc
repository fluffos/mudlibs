        return 1;
    case "marry":
        message_vision("\e[36m$N笑呵呵的向$n问道：敢问这位" + "/adm/daemons/rankd"->query_respect(arg2) + "是否婚配？\n\e" + "[2;37;0m", arg1, arg2);
