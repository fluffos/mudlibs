int reply_ask(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = arg1->query("quest");
    if (!arg1->query_temp("ask_quest_money")) {
        tell_object(arg1, arg2->name() + "对你嘿嘿一笑道：客官，来我这里买消息？可是要收钱的呀！！\n");
        arg1->set_temp("ask_quest", 1);
        arg1->receive_damage("jing", 10);
        return 1;
    }
    if (objectp(v2 = v1["obj"]) && environment(v2)) {
        v3 = environment(v2)->query("short");
        switch (random(5)) {
        case 1:
            message_vision("$N凑到$n耳边悄悄的说了一些话。\n");
            tell_object(arg1, arg2->name() + "在你耳边悄声说道：我听说在" + v1["where"] + v3 + "有个叫" + v2->name(1) + "的，不知从哪来了一本" + v1["quest"] + "。\n听说可以习得盖世武功，客官有兴趣的话可以去他那里看看。\n");
            break;
        case 2:
            message_vision("$N凑到$n耳边悄悄的说了一些话。\n");
            tell_object(arg1, arg2->name() + "附在你耳边说道：我听几个剑客说，有个叫" + v2->name(1) + "的高手，偷到了一本" + v1["quest"] + "。\n能够从" + arg1->query("family/family_name") + "偷到秘籍，想必身手一定非常了得。\n");
            break;
        case 3:
            tell_object(arg1, arg2->name() + "想了想说道：好象最近" + v1["where"] + "来了一个叫" + v2->name(1) + "的" + v2->query("title") + "，样子看起来怪怪的。\n");
            break;
        default:
            tell_object(arg1, arg2->name() + "摇了摇头道：最近没听说有什么消息，客官您可有新鲜事可告诉我呢？\n");
            break;
        }
    } else {
        tell_object(arg1, arg2->name() + "摇了摇头道：最近没听说有什么消息，客官您可有新鲜事可告诉我呢？\n");
    }
    arg1->delete_temp("ask_quest_money");
    arg1->receive_damage("jing", 10);
    return 1;
}
