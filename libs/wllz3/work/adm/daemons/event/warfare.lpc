//warfare.c 事件：门派攻防战

void create() { seteuid(ROOT_UID); }

#define REBOOT_CMDS     "/cmds/arch/reboot"

// 开始创建事件
void create_event()
{
        // 一个星期后的凌晨七点钟开始
        EVENT_D->at_after(0,0,1,-21);
}
// 事件触发
void trigger_event()
{       
        WARFARE_D->start_message(0);
        create_event();
}
