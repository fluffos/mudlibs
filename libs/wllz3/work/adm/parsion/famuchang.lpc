    set("short", "山谷中的伐木场");
    set("long", "这是一个被连绵山川四面环绕的伐木场，伐木场的四周又是一片足有\r\n二人高的木栅栏，几个汗流颊背、蓬头污垢的男子正在一起砍倒一颗大树\r\n。几个凶神恶煞的壮汉，手持皮鞭，紧紧的盯着这些人的一举一动，时而\r\n用皮鞭狠狠的抽打，时而破口大骂，惨不忍睹。\r\n");
    set("exits", ([ "north" : "/adm/parsion/xiaowu", "west" : "/adm/parsion/muchang-w", "east" : "/adm/parsion/muchang-e", "south" : "/adm/parsion/muchang-s" ]));
    set("objects", ([ "/clone/misc/futou" : 5 ]));
    set("no_fight", 1);
    set("no_beg", 1);
    set("no_steal", 1);
    set("no_magic", 1);
    set("no_sleep_room", 1);
    set("parsion_room", 1);
    setup();
}

void init() {
    add_action("do_famu", "famu");
}

int do_famu(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!v1->query("combat/arrested")) {
        return notify_fail("你心里直乐着：“义务劳动，真好。”\n");
    }
    if (v1->query("brawn") < 10) {
        return notify_fail("你太累了，还是休息一会再说吧。\n");
    }
    if (v1->query("qi") < 100 || v1->query("jing") < 100) {
        return notify_fail("你现在精神太差了，可别把性命给搭上。\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢。\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("你正忙着呢。\n");
    }
    write("你抡起沉甸甸的斧头，用劲的往树干上砍去......\n");
    v1->set_short_desc("全身赤裸，手持斧头，正在伐木。");
    v1->start_busy((: compelete_famu :), (: do_halt :));
    return 1;
}

int compelete_famu(mixed arg) {
    mixed v1;
    if (!arg) {
        return 0;
    }
    if (!environment(arg) || environment(arg) != this_object()) {
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->query("brawn") < 20) {
        write("你砍着砍着，觉得疲惫不堪，于是停下来休息一会。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->query("qi") < 100 || arg->query("jing") < 100) {
        write("你觉得身体不适，需要好好的休息一会。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (!present("fu tou", arg)) {
        write("你摸摸后脑，疑道：怎么斧子不见了？\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->add_temp("working", 1) > 25) {
        write("你费了九牛二虎之力，终于将树干上的木头砍了下来。\n");
        v1 = clone_object("/clone/misc/wood-1");
        v1->move(arg, 1);
        arg->delete_temp("working");
        arg->set_short_desc(0);
        return 0;
    }
    arg->add("brawn", -10);
    arg->add("jing", -70);
    arg->add("qi", -70);
    write(random(100) % 12 == 1 ? "你手举斧子，使劲的朝树干上挥去，“啪嗒”一声，树干上留下一条深深的斧印。\n" : random(100) % 15 == 1 ? "你举起斧子，使出吃奶的劲，用力的朝树干上砍去。\n" : random(100) % 17 == 1 ? "\e[31m恶汉指着你的脑袋，破口大骂：你个猪脑，动作给我利索点！\n\e[2;37;0m" : random(100) & 19 == 1 ? "你拿着斧子，老老实实的做起了伐木的工作。\n" : "你举着斧子，做起了伐木的工作，动作倒也十分麻利。\n");
    return 1;
}

int do_halt(mixed arg) {
    write("你放下斧头，停下来休息一会。\n");
    arg->set_short_desc(0);
    return 1;
}
