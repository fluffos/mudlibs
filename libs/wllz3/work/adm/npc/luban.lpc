string query_save_file() {
    return "/data/npc/luban";
}

void greeting(mixed arg) {
    if (!objectp(arg) || environment(arg) != environment()) {
        return;
    }
    if (wizardp(arg) && wiz_level(arg) > 3) {
        if (query("form") && sizeof(query("form")) >= 1) {
            message_vision("鲁班对$N道，来的正好，我这里有些单子正要处理呢。\n", arg);
            tell_object(arg, "\e[1;32m鲁班告诉你：请用\e[1;37mlist\e[1;32m察看，\e[1;37mtype\e[1;32m显示详细信息，\e[1;37magree\e[1;32m注册，\e[1;37mreject\e[1;32m拒绝，\e[1;37mdelete\e[1;32m删除表单。\n\e[2;37;0m");
        } else {
            message_vision("鲁班对$N点点头，道：公输班正在授课，不及远迎，失礼了！\n", arg);
        }
        return;
    } else if (query("form/" + arg->query("id"))) {
        switch (query("form/" + arg->query("id") + "/status")) {
        case "申请":
            luban_say("巫师还没有查阅你的申请，要向查看你提交的表单可以用show，如果想修改可以问我。\n");
            break;
        case "拒绝":
            luban_say("你的申请被拒绝了，你可以用show查看详情，如果想修改可以问我。\n");
            break;
        case "同意":
            luban_say("你的申请已经被批准了，缴纳现金即可建房，查看详情请用show，如果想修改可以问我。\n");
            break;
        }
    } else if (arg->query_temp("contract/luban")) {
        message_vision("鲁班对$N笑道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，刚才怎么谈着谈着就走了？如是有意，咱们继续谈嘛。\n", arg);
    } else {
        switch (random(3)) {
        case 0:
            message_vision("鲁班对$N说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，可是想建个房子？\n", arg);
            break;
        case 1:
            message_vision("鲁班对$N笑道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，行走江湖，若是没有个落脚之处怎么行啊！\n", arg);
            break;
        case 2:
            message_vision("鲁班对$N一拱手，说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，很久没见啊，别来无恙？\n", arg);
            break;
        }
    }
}

int recognize_apprentice(mixed arg) {
    if (arg->query_temp("mark/鲁班")) {
        message_vision("鲁班对$N说：好，你既然有心学，我就教你一点吧。\n", arg);
    }
    arg->set_temp("mark/鲁班", 1);
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2->query("id") == "key" && arg2->query("item_make")) {
        if (mapp(arg1->query("private_room"))) {
            message_vision("$N疑惑的看着$n问道：你的房子不要了吗？不要的话就把它拆了吧。\n", this_object(), arg1);
            return 0;
        }
        message_vision("鲁班点点头，收下了" + arg2->query("name") + "。\n", arg1);
        if (!mapp(arg1->query("private_room")) && arg2->query("key_master") == arg1->query("id")) {
            if (file_size("/data/room/" + arg1->query("id") + "/key.lpc")) {
                rm("/data/room/" + arg1->query("id") + "/key.lpc");
            }
        }
        return 1;
    }
    if (arg2->query("图纸")) {
        if (mapp(arg1->query("private_room"))) {
            message_vision("鲁班呵呵笑道：莫非你有一处住房还是不够？\n", arg1);
            return 0;
        }
        arg1->delete("private_room");
        if (query("form/" + arg1->query("id"))) {
            message_vision("鲁班笑道：慌甚！你不是已经提交了申请么？可以用show察看申请。\n", arg1);
            return 0;
        }
        if (arg1->query_temp("contract/luban")) {
            message_vision("鲁班疑惑的对$N说道：干什么？刚才不是给过我了么？若是有什么想法，可以改日再谈(stop)。\n", arg1);
            return 0;
        }
        if (!arg2->query("draw")) {
            message_vision("鲁班看了一下，对$N说道：你给我一张白纸干什么？你要是不会就和我学学绘画技巧(drawing)吧。\n", arg1);
            return 0;
        }
        if (arg2->query("draw") < 30) {
            message_vision("鲁班接过图纸，看了半天，问$N道：你这画的是什么东西？你要是不会跟我学学绘画技巧(drawing)。\n", arg1);
            return 0;
        }
        if (arg2->query("draw") < 80) {
            message_vision("鲁班接过图纸看了看，对$N笑道：画的还行，马马虎虎吧。\n", arg1);
        } else {
            message_vision("鲁班看了看$N给的图纸图纸，喝彩道：神了，真是有天赋啊！\n", arg1);
        }
        v1 = get_object(arg2->query("position"));
        if (!objectp(v1)) {
            message_vision("鲁班仔细看了看，叹了口气说道：那个地方现在好像已经不存在了...\n", arg1);
            return 0;
        }
        if (!v1->query("recordable_room")) {
            message_vision("鲁班仔细看了看，不禁皱了皱眉，对$N说道：那个地方好像不能建房吧...\n", arg1);
            return 0;
        }
        arg1->set_temp("contract/luban/position", arg2->query("position"));
        quest_user(arg1);
        return 1;
    }
    if (arg2->query("money_id") && mapp(query("form/" + arg1->query("id")))) {
        if (query("form/" + arg1->query("id") + "/status") != "同意") {
            message_vision("鲁班摇摇头，对$N道：巫师还没有批准你的申请，你先请回吧。\n", arg1);
            return 0;
        }
        if (arg2->value() < query("form/" + arg1->query("id") + "/value")) {
            message_vision("鲁班接过钱掂了掂，对$N呵呵笑道：这钱似乎不够吧？\n", arg1);
            return 0;
        }
        create_room(arg1);
        return 1;
    }
    if (arg2->query("money_id")) {
        if (arg1->query_temp("contract/luban/questing") != "quest_desc") {
            message_vision("鲁班微微一笑，对$N道：干什么这么客气？我不收无功之禄。\n", arg1);
            return 0;
        }
        if (arg2->value() < 50000) {
            message_vision("鲁班嘿然冷笑，对$N道：五两黄金你都吝惜？哼哼，就算是天神亲临，我也不打折扣。\n", arg1);
            return 0;
        }
        message_vision("鲁班满意的对$N说道：很好，我就给你记录在案，若是有了消息，一定通知你。\n", arg1);
        record_contract(arg1);
        arg1->delete_temp("contract");
        return 1;
    }
    message_vision("鲁班摆摆手，对$N道：你还是自己留着吧，我可用不着。\n", arg1);
    return 0;
}

int ask_me() {
    mixed v1;
    v1 = this_player();
    if (mapp(v1->query("private_room"))) {
        message_vision("鲁班点点头，对$N说道：怎么样，住得可满意？若是不满意，可以找我重建哦。\n", v1);
        return 1;
    }
    message_vision("鲁班微一叹气，说道：想江湖儿女，一剑纵横，快意恩仇，驰骋天下，若是没有个落脚之处，\n怎生得了？或隐身于闹市，或遁迹于险川，你若有意，何不画张图纸给我，若是地点合适，你\n且挑个满意的样式，我给你建个住房。今生今世，不再惧那风雨。\n", v1);
    return 1;
}

int ask_paper() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (is_busy()) {
        write("鲁班正忙着呢，没功夫理你...\n");
        return 1;
    }
    message_vision("鲁班点点头，对$N说道：很好，你拿这份图纸，到了想要建房的地点，画下来拿回给我看看。\n", v1);
    v2 = clone_object("/d/room/obj/paper");
    if (objectp(v2)) {
        message_vision("鲁班翻了翻，找到一张图纸，递给了$N。\n", v1);
        v2->move(v1);
    } else {
        message_vision("鲁班翻了半天也没找到，不禁一呆，说道：怎么回事，没有了？你去找巫师问问吧！\n", v1);
    }
    start_busy(4);
    return 1;
}

int ask_drawing() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    v1 = v2->query_skill("drawing", 1);
    message_vision("鲁班对$N说道：要想画张好点的图纸，不会点绘画技巧是不行的，没\n有人天生就会作画，都得学习，你若有意，不妨和我学学。\n", v2);
    if (v1 < 30) {
        message_vision("你现在的绘画技巧可太差了。\n", v2);
    } else if (v1 < 80) {
        message_vision("你现在的绘画技巧也算是马马虎虎了。\n", v2);
    } else {
        message_vision("当然了，你现在的水平是相当不错了。\n", v2);
    }
    return 1;
}

int ask_demolish() {
    mixed v1;
    v1 = this_player();
    if (v1->query_temp("contract/luban")) {
        message_vision("鲁班对$N说：你不是要建房么，怎么还没建好就要拆房了？真是未雨绸缪啊！\n", v1);
        return 1;
    }
    if (query("form/" + v1->query("id"))) {
        message_vision("鲁班哼了一声，对$N道：你的房子还没见到渣呢！你要是不想建了，就撤消(withdraw)申请算了。\n", v1);
        return 1;
    }
    if (!mapp(v1->query("private_room"))) {
        message_vision("鲁班哈哈大笑，对$N道：拆屋？你还没有呢，拆什么拆！乱拆别人的屋子可是犯法的！\n", v1);
        return 1;
    }
    if (v1->query_temp("demolish_room")) {
        message_vision("鲁班对$N说：你要是真的想拆屋，就请下决心(demolish)！\n", v1);
        return 1;
    }
    message_vision("鲁班睁大了眼睛，奇怪的看着$N，过了良久才说：你若是真到要拆屋，就下决心吧(demolish)！\n", v1);
    v1->set_temp("demolish_room", 1);
    return 1;
}

int ask_rebuild() {
    mixed v1;
    v1 = this_player();
    if (!mapp(v1->query("private_room"))) {
        message_vision("鲁班摇摇头，对$N说：你还没有房子呢，谈什么重建！\n", v1);
        return 1;
    }
    message_vision("鲁班叹了口气，对$N说：你若是要重建，得先拆房！\n", v1);
    return 1;
}

int ask_key() {
    mixed v1;
    v1 = this_player();
    if (is_busy()) {
        write("鲁班正忙着呢，没空理你...\n");
        return 1;
    }
    if (!mapp(v1->query("private_room"))) {
        message_vision("鲁班看了半天，才对$N说：没有房子你要钥匙干什么？\n", v1);
        return 1;
    }
    if (present("key of " + v1->query("id"), v1)) {
        message_vision("鲁班疑惑的看着$N说：你不是已经有钥匙了吗？\n", v1);
        return 1;
    }
    clone_object("/data/room/" + v1->query("id") + "/key")->move(v1);
    message_vision("鲁班拿出一把钥匙，对$N说：诺，这是钥匙，收好了！\n", v1);
    start_busy(4);
    return 1;
}

int ask_desc() {
    luban_say("描述信息可以使用颜色，并且可以分行，但是最多不能超过160个汉字：\r\n\r\n颜色的规则：\r\n$BLK$ - 黑色\t\t$NOR$ - 恢复正常颜色\r\n$RED$ - 红色\t\t$HIR$ - 亮红色\r\n$GRN$ - 绿色\t\t$HIG$ - 亮绿色\r\n$YEL$ - 土黄色\t\t$HIY$ - 黄色\r\n$BLU$ - 深蓝色\t\t$HIB$ - 蓝色\r\n$MAG$ - 浅紫色\t\t$HIM$ - 粉红色\r\n$CYN$ - 蓝绿色\t\t$HIC$ - 天青色\r\n$WHT$ - 浅灰色\t\t$HIW$ - 白色\r\n\r\n换行：\r\n只要在描述信息中添加一个\\n就可以。比如：“这是一间小院。\\n院子边上的墙很矮。”\r\n实际看到的描述使这个样子的：\r\n这是一间小院。\r\n院子边上的墙很矮。\r\n\r\n说明：\r\n系统自动会在描述字符串的尾端加一个 $NOR$ 和 \\n"
            "。因此描述最好不要以\\n结束，以免\r\n空行太多。另外，系统会自动的规范你输入的描述信息，因此你不需要在描述信息前面添\r\n加段落起始的空格，同时也不需要在一个段落内部插入\\n以实现换行，对于过长的段落系\r\n统会自动的添加换行符。\r\n\r\n\r\n");
    return 1;
}

int ask_modify() {
    mixed v1;
    v1 = this_player();
    if (!mapp(query("form/" + v1->query("id"))) && v1->query_temp("contract/luban/questing") != "quest_desc") {
        message_vision("鲁班摇摇头，对$N说：你只有描述时或是提交了申请以后才用得着修改。\n", v1);
        return 1;
    }
    message_vision("鲁班点点头，对$N说：你可以修改你提交的申请中的各种信息：\n\n你可以通过以下指令修改房屋的各种信息：\n\e[1;37mchangename \e[2;37;0mname : 修改房屋的中文名字。\n\e[1;37mchangeid   \e[2;37;0mid   : 修改房屋的英文代号。\n\e[1;37mchangetype \e[2;37;0mtype : 修改房屋的类型。\n\e[1;37mchangedesc \e[2;37;0mroom desc : 修改某间房屋的描述。\n", v1);
    return 1;
}

void luban_say(mixed arg) {
    mixed v1;
    v1 = this_player();
    message("vision", "鲁班对" + v1->query("name") + "嘀嘀咕咕说了些话。\n", environment(v1), ({ v1 }));
    write("鲁班说道：" + arg);
}

void user_say() {
    mixed v1;
    message("vision", v1->query("name") + "对鲁班嘀嘀咕咕说了些话。\n", environment(v1), ({ v1 }));
}

int do_stop() {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("contract/luban")) {
        message_vision("鲁班一脸傻样......\n", v1);
        return 1;
    }
    v1->delete_temp("contract/luban");
    message_vision("鲁班对$N点点头，说道：既然如此，改日再谈也不妨。\n", v1);
    return 1;
}

int do_answer(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = v1->query_temp("contract/luban/questing");
    if (!v2) {
        return 0;
    }
    switch (v2) {
    case "quest_name":
        check_name(v1, arg);
        break;
    case "quest_id":
        check_id(v1, arg);
        break;
    case "quest_type":
        check_type(v1, arg);
        break;
    default:
        write("没人问你问题，你想回答什么？\n");
    }
    return 1;
}

int do_desc(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (v1->query_temp("contract/luban/questing") != "quest_desc") {
        return 0;
    }
    if (arg) {
        if (sscanf(arg, "%s %s", v2, v3) != 2) {
            v2 = arg;
            v3 = 0;
        }
    } else {
        show_desc(v1->query("id"), 0);
        return 1;
    }
    record_desc(v1, v2, v3);
    return 1;
}

int do_show(mixed arg) {
    show_desc(this_player()->query("id"), arg);
    return 1;
}

int do_changename(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    v2 = v1->query("id");
    if (mapp(query("form/" + v2))) {
        v3 = query("form/" + v2 + "/" + "position");
        if (!check_legal_name(arg, v3)) {
            return 1;
        }
        luban_say("好吧，就改成" + arg + "这个名字吧！\n");
        set("form/" + v2 + "/" + "name", arg);
        set("form/" + v2 + "/" + "status", "申请");
        save();
        return 1;
    } else if (v1->query_temp("contract/luban/questing") != "quest_desc") {
        return 0;
    }
    if (check_legal_name(arg, v1->query_temp("contract/luban/position"))) {
        v1->set_temp("contract/luban/name", arg);
        luban_say("好吧，就改成" + arg + "这个名字吧！\n");
    }
    return 1;
}

int do_changeid(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = v1->query("id");
    if (mapp(query("form/" + v2))) {
        if (!check_legal_id(arg)) {
            return 1;
        }
        luban_say("行啊，就改成" + arg + "这个房屋代号吧！\n");
        set("form/" + v2 + "/" + "id", arg);
        set("form/" + v2 + "/" + "status", "申请");
        save();
        return 1;
    } else if (v1->query_temp("contract/luban/questing") != "quest_desc") {
        return 0;
    }
    if (check_legal_id(arg)) {
        v1->set_temp("contract/luban/id", arg);
        luban_say("行啊，就改成" + arg + "这个房屋代号吧！\n");
    }
    return 1;
}

int do_changetype(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    v3 = v1->query("id");
    if (mapp(query("form/" + v3))) {
        if (!(v4 = check_legal_type(arg))) {
            write("找不到这种类型的房屋，所以没有改变房屋的类型。\n");
            return 1;
        }
        set("form/" + v3 + "/" + "room", v4["name"]);
        v2 = v4["value"];
        if (wizardp(v1)) {
            v2 = 0;
        }
        set("form/" + v3 + "/" + "value", v2);
        set("form/" + v3 + "/" + "descs", ([ ]));
        set("form/" + v3 + "/" + "status", "申请");
        save();
        luban_say("换一种房型也行，不过请你填写新的描述(changedesc)。\n");
        return 1;
    } else if (v1->query_temp("contract/luban/questing") != "quest_desc") {
        return 0;
    }
    if (!check_type(v1, arg)) {
        write("没有改变房屋类型。\n");
    }
    return 1;
}

int do_changedesc(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    v2 = v1->query("id");
    if (mapp(query("form/" + v2))) {
        if (!arg || arg == "") {
            return notify_fail("请按照正确格式输入：changedesc room_name description\n");
        }
        if (sscanf(arg, "%s %s", v3, v4) != 2) {
            v3 = arg;
            v4 = 0;
        }
        modify_desc_in_form(v2, v3, v4);
        set("form/" + v2 + "/" + "status", "申请");
        save();
        return 1;
    } else if (v1->query_temp("contract/luban/questing") != "quest_desc") {
        return 0;
    }
    do_desc(arg);
    return 1;
}

int do_finish() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    v2 = v1->query_temp("contract/luban/room/value");
    if (v1->query_temp("contract/luban/questing") != "quest_desc") {
        return 0;
    }
    show_desc(v1->query("id"), 0);
    v3 = "金临拨拉拨拉算盘，慢条斯理的对$N说道：要造这样的房子，少说也得" + chinese_number(v2 / 10000) + "两黄金，不二价！\n";
    if (wizardp(v1)) {
        v3 += "鲁班对金临喝道：不得无理！此乃上届仙人...嘿嘿，到时意思意思就算了吧。\n";
    }
    v3 += "鲁班略一沉吟，然后说道：你看看有没有什么问题么？若是没有，请先交五两黄金的定金。\n";
    message_vision(v3, v1);
    return 1;
}

int do_withdraw() {
    mixed v1;
    v1 = this_player();
    if (v1->query_temp("contract/luban")) {
        do_stop();
        return 1;
    }
    if (!query("form/" + v1->query("id"))) {
        message_vision("鲁班一脸茫然......对$N说道：现在你好像没有提交的申请吧！\n", v1);
        return 1;
    }
    if (v1->query_temp("decide_withdraw")) {
        message_vision("鲁班对$N说道：你若是要撤消申请，就请下决定(decide)！\n", v1);
        return 1;
    }
    switch (query("form/" + v1->query("id") + "/status")) {
    case "申请":
        luban_say("可惜，你怎么这就反悔了？\n");
        break;
    case "同意":
        luban_say("哎呀！真是可惜，巫师都同意了，你怎么打退堂鼓了？\n");
        break;
    case "拒绝":
        luban_say("唉！没能被批准也别就打退堂鼓么，看看怎么回事再说么。\n");
        break;
    }
    message_vision("鲁班叹了口气，对$N说道：既然如此，此事也不必勉强，如果你想好了，就下决定(decide)吧！\n", v1);
    v1->set_temp("decide_withdraw", 1);
    return 1;
}

int decide_withdraw() {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("decide_withdraw")) {
        return 0;
    }
    v1->delete_temp("decide_withdraw");
    delete("form/" + v1->query("id"));
    save();
    message_vision("鲁班摇摇头，掏出一个账本，翻了翻，不知道划掉了什么东西。\n", v1);
    return 1;
}

int do_demolish() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v3 = this_player();
    if (!v3->query_temp("demolish_room")) {
        return 0;
    }
    v3->delete_temp("demolish_room");
    if (!v3->query("private_room")) {
        return 0;
    }
    if (!mapp(v3->query("private_room"))) {
        write("错误的数据已经被删除！\n");
        v3->delete("private_room");
        return 1;
    }
    v1 = check_legal_type(v3->query("private_room/type"));
    if (mapp(v1)) {
        seteuid(getuid());
        v2 = keys(v1["files"]);
        for (v5 = 0; v5 < sizeof(v2); v5++) {
            rm(to_player(v3->query("id"), v1["files"][v2[v5]]));
        }
    }
    v4 = get_object(v3->query("private_room/position"));
    if (!objectp(v4)) {
        write("建房的地点已经找不到了！删除了有关房屋的信息。\n");
        v3->delete("private_room");
        return 1;
    }
    v4->demolish_room(v3->query("private_room/name"));
    v4->save();
    v3->delete("private_room");
    message_vision("鲁班点点头，对$N说：好了，剩下的事情我会办妥的！把钥匙给我，然后你就可以走了。\n", v3);
    return 1;
}

void show_desc(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    mixed v10;
    mixed v11;
    mixed v12;
    mixed v13;
    mixed v14;
    mixed v15;
    mixed v16;
    v6 = this_player();
    v15 = "";
    if (mapp(query("form/" + arg1))) {
        v14 = "form/" + arg1 + "/";
        v12 = query(v14 + "type");
        for (v3 = 0; v3 < sizeof(room_example); v3++) {
            if (room_example[v3]["type"] == v12) {
                v1 = room_example[v3]["files"];
                break;
            }
        }
        if (!mapp(v1)) {
            write("你申请的房屋类型(" + v12 + ")已经不存在了，请和巫师联系。\n");
            return;
        }
        v2 = query(v14 + "descs");
        v12 = query(v14 + "room") + "(" + v12 + ")";
        v11 = query(v14 + "name") + "(" + query(v14 + "id") + ")";
        v4 = query(v14 + "value");
        v13 = query(v14 + "position");
        v16 = query(v14 + "wizard");
        switch (query(v14 + "status")) {
        case "申请":
            v15 = "巫师还没有查阅这份申请。";
            break;
        case "拒绝":
            v15 = v16 + "已经拒绝了这份申请！";
            if (query(v14 + "memo") != "无") {
                v15 += "\n原因是：" + query(v14 + "memo");
            }
            break;
        case "同意":
            v15 = v16 + "已经同意了这份申请！";
            break;
        }
        if (this_player()->query("id") == arg1) {
            if (query(v14 + "status") == "同意") {
                v15 += "\e[1;37m\n你现在可以建造房屋了。如果这时修改了房屋的信息，就要得到巫师的再次批准。\e[2;37;0m";
            } else if (query(v14 + "status") == "拒绝") {
                v15 += "\e[1;31m\n你现在最好修改房屋的信息以获得巫师的批准，否则请撤消申请。\e[2;37;0m";
            }
            v15 += "\n你可以撤消(withdraw)你提交的申请。";
        }
    } else if (objectp(v7 = present(arg1, environment(this_object()))) && v7->query_temp("contract/luban/questing") == "quest_desc") {
        v1 = v7->query_temp("contract/luban/room/files");
        v2 = v7->query_temp("contract/luban/descs");
        v12 = v7->query_temp("contract/luban/room/name");
        v12 += "(" + v7->query_temp("contract/luban/room/type") + ")";
        v11 = v7->query_temp("contract/luban/name") + "(" + v7->query_temp("contract/luban/id") + ")";
        v4 = v7->query_temp("contract/luban/value");
        v13 = v7->query_temp("contract/luban/position");
    } else {
        luban_say("呵呵，这位好像还没有打算建房子吧。\n");
        return;
    }
    v8 = get_object(v13);
    if (!objectp(v8)) {
        write("你申请的建造房屋的地方(" + v13 + ")已经不存在了，请和巫师联系!\n");
        return;
    }
    v16 = "好，你看看吧：\n这里选用的是" + v12 + "这种类型的房屋。\n" + "它的名字是" + v11 + "，将建筑在" + v8->query("short");
    if (wizardp(v6) && wiz_level(v6) > 3) {
        v16 += "(" + v13 + ")";
    }
    v16 += "。\n";
    luban_say(v16);
    v10 = keys(v1);
    v5 = 0;
    for (v3 = 0; v3 < sizeof(v1); v3++) {
        v8 = get_object(v1[v10[v3]]);
        if (!objectp(v8)) {
            write("找不到示例的房屋" + v10[v3] + "，请和巫师联系。\n");
            continue;
        }
        if (!arg2 || arg2 == "" || v8->query("short") == arg2 || v10[v3] == arg2) {
            v9 = sort_desc(v2[v10[v3]]);
            write("\e[37m────────────────────────────────────────\n\e[2;37;0m");
            write("\e[1;37m关于" + v8->query("short") + "(" + v10[v3] + ")" + "\e" + "[1;37m" + "的描述：\n\n" + "\e" + "[2;37;0m");
            if (!v9) {
                v9 = "现在还没有输入描述信息，使用系统缺省的描述信息。如下：\n\n";
                v9 += sort_desc(v8->query("default_long"));
            }
            write(v9 + "\n");
            v5++;
        }
    }
    if (!v5) {
        write("但是这里没有" + arg2 + "这个房间，请用show查看所有的房间！\n");
        return;
    }
    write("\e[37m────────────────────────────────────────\n\e[2;37;0m");
    write("描述就是上面列出的这些内容。\n");
    if (!v4) {
        v15 += "\n建造这些房间不需要花费任何银两。";
    } else {
        v15 += "\n建造这些房间需要花费\e[1;33m" + chinese_number(v4 / 10000) + "两黄金。\e" + "[2;37;0m";
    }
    write(v15 + "\n");
    return;
}

int quest_user(mixed arg) {
    message_vision("鲁班对$N说道：好，来，咱们仔细谈谈！\n", arg);
    luban_say("先告诉我你想建的房子叫什么名字(answer name)。\n你若是不想谈了(stop)，告诉我也无妨。\n");
    arg->set_temp("contract/luban/questing", "quest_name");
    return 1;
}

int quest_info(mixed arg) {
    message_vision("鲁班对$N说道：好，看来你喜欢" + arg->query_temp("contract/luban/room/name") + "这种样式的。\n", arg);
    luban_say("你可以为你的房间添加你喜欢的描述，格式是：desc 房间名称 描述。当\r\n然你也可以使用原有的描述，如果你想看看你输入的情况，可以用show来察看。若一\r\n切都输入好了以后键入finish或是ok就可以了。如果想修改输入的房屋名字，代号，\r\n类型的信息可以向我询问<修改>的方法。\r\n\r\n举个描述的例子：“desc 小院 这里是一间别致的小院。”这样就给小院添加了一行\r\n描述。如果想取消小院的描述可以键入：“desc 小院”就可以了。\r\n\r\n描述还可以使用颜色，可以多行，具体细节可以问我 <规则>。这里要需要注意的是：\r\n系统自动会在描述字符串的尾端加一个 $NOR$ 和 \\n。因此描述不要以\\n结束，以免\r\n空行太多。另外，系统会自动的"
            "规范你输入的描述信息，因此你不需要在描述信息前\r\n面添加段落起始的空格，同时也不需要在一个段落内部插入\\n以实现换行，对于过长\r\n的段落系统会自动的添加换行符。\r\n\r\n另外，在描述的字符串内部不要输入空格，跳格，这些输入都会被抹掉。\r\n");
    arg->set_temp("contract/luban/questing", "quest_desc");
    arg->delete_temp("contract/luban/descs");
    arg->set_temp("contract/luban/descs", ([ ]));
    return 1;
}

int check_name(mixed arg1, mixed arg2) {
    if (!arg2 || arg2 == "") {
        luban_say("你怎么不说话？要是不想谈了(stop)，明说就是！\n");
        return 0;
    }
    if (arg2 == "stop") {
        do_stop();
        return 0;
    }
    if (!check_legal_name(arg2, arg1->query_temp("contract/luban/position"))) {
        return 0;
    }
    arg1->set_temp("contract/luban/name", arg2);
    luban_say("请确定你的房屋的代号(3到10个英文字母)，考虑好了就回答我(answer id)。\n");
    arg1->set_temp("contract/luban/questing", "quest_id");
    return 1;
}

int check_id(mixed arg1, mixed arg2) {
    if (!arg2 || arg2 == "") {
        luban_say("你怎么不说话？要是不想谈了(stop)，明说就是！\n");
        return 0;
    }
    if (arg2 == "stop") {
        do_stop();
        return 0;
    }
    if (!check_legal_id(arg2)) {
        return 0;
    }
    arg1->set_temp("contract/luban/id", arg2);
    luban_say("你想要哪种样式的住房(answer type)? 若是不太清楚，你可以到附近的小院一观。\n");
    arg1->set_temp("contract/luban/questing", "quest_type");
    return 1;
}

int check_type(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg2 || arg2 == "") {
        luban_say("你想要哪种样式的住房(answer type)？若是不太清楚，你可以到附近的小院一观。\n");
        return 0;
    }
    if (arg2 == "stop") {
        do_stop();
        return 0;
    }
    if (!(v1 = check_legal_type(arg2))) {
        luban_say("你要的样式真稀奇，我这现在还没有。看清楚了再告诉我。\n");
        return 0;
    }
    arg1->set_temp("contract/luban/room", v1);
    v2 = arg1->query_temp("contract/luban/room/value");
    if (wizardp(arg1)) {
        v2 = 0;
    }
    arg1->set_temp("contract/luban/value", v2);
    quest_info(arg1);
    return 1;
}

int check_legal_name(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = sizeof(arg1);
    if (sizeof(arg1) < 2 || sizeof(arg1) > 8) {
        write("对不起，你房屋的名字必须是 2 到 8 个中文字。\n");
        return 0;
    }
    while (v2--) {
        if (arg1[v2] <= 32) {
            write("对不起，你的房屋名字不能用控制字元。\n");
            return 0;
        }
        if (!is_chinese(arg1[v2..v2])) {
            write("对不起，请您用「中文」取名字。\n");
            return 0;
        }
    }
    v1 = get_object(arg2);
    if (!objectp(v1)) {
        return 1;
    }
    if (v1->exist_room(arg1)) {
        luban_say("对不起，据我所知，那里已经有一个住房叫这个名字了！请另外起一个名字。\n");
        return 0;
    }
    return 1;
}

int check_legal_id(mixed arg) {
    mixed v1;
    v1 = sizeof(arg);
    if (sizeof(arg) < 3 || sizeof(arg) > 10) {
        write("对不起，你房屋的代号必须是 3 到 10 个英文字母。\n");
        return 0;
    }
    while (v1--) {
        if ((arg[v1] < 65 || arg[v1] > 90) && (arg[v1] < 97 || arg[v1] > 122)) {
            write("对不起，你房屋的代号必须用英文字母。\n");
            return 0;
        }
    }
    return 1;
}

mixed check_legal_type(mixed arg) {
    mixed v1;
    for (v1 = 0; v1 < sizeof(room_example); v1++) {
        if (room_example[v1]["type"] == arg || room_example[v1]["name"] == arg) {
            return room_example[v1];
        }
    }
}

object get_object(mixed arg) {
    mixed v1;
    if (!arg || arg == "") {
        return 0;
    }
    if (!(v1 = find_object(arg))) {
        v1 = find_object(arg, 1);
    }
    return v1;
}

int record_desc(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    if (!(arg3 = obey_description(arg3))) {
        return 0;
    }
    v1 = arg1->query_temp("contract/luban/room/files");
    v2 = arg1->query_temp("contract/luban/descs");
    v5 = keys(v1);
    for (v3 = 0; v3 < sizeof(v5); v3++) {
        v4 = get_object(v1[v5[v3]]);
        if (v4->query("short") == arg2 || v5[v3] == arg2) {
            if (!arg3 || arg3 == "") {
                write("你没有输入描述" + arg2 + "的信息，将使用系统缺省的描述信息。\n");
                write("缺省的描述信息如下：\n" + sort_desc(v4->query("default_long")));
                map_delete(v2, v5[v3]);
            } else {
                v2[v5[v3]] = arg3;
                write("你描述了" + v4->query("short") + "。\n");
            }
            return 1;
        }
    }
    write("没有找到" + arg2 + "，请查证再输入描述信息。\n");
    return 0;
}

void record_contract(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = arg->query("id");
    if (!mapp(query("form"))) {
        delete("form");
    }
    set("form/" + v1 + "/" + "player", arg->query("name"));
    set("form/" + v1 + "/" + "name", arg->query_temp("contract/luban/name"));
    set("form/" + v1 + "/" + "id", arg->query_temp("contract/luban/id"));
    set("form/" + v1 + "/" + "room", arg->query_temp("contract/luban/room/name"));
    set("form/" + v1 + "/" + "type", arg->query_temp("contract/luban/room/type"));
    set("form/" + v1 + "/" + "position", arg->query_temp("contract/luban/position"));
    set("form/" + v1 + "/" + "value", arg->query_temp("contract/luban/value"));
    set("form/" + v1 + "/" + "time", time());
    set("form/" + v1 + "/" + "status", "申请");
    set("form/" + v1 + "/" + "wizard", "无");
    set("form/" + v1 + "/" + "memo", "无");
    v2 = arg->query_temp("contract/luban/descs");
    set("form/" + v1 + "/" + "descs", v2);
    save();
}

int modify_desc_in_form(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    if (!(arg3 = obey_description(arg3))) {
        return 0;
    }
    if (!(v1 = check_legal_type(query("form/" + arg1 + "/" + "type")))) {
        write("这种房屋的类型已经不存在了，所以没有改变房屋的描述，请和巫师联系。\n");
        return 1;
    }
    v2 = v1["files"];
    v3 = query("form/" + arg1 + "/" + "descs");
    v6 = keys(v2);
    for (v4 = 0; v4 < sizeof(v6); v4++) {
        v5 = get_object(v2[v6[v4]]);
        if (v5->query("short") == arg2 || v6[v4] == arg2) {
            if (!arg3 || arg3 == "") {
                write("你没有输入描述" + arg2 + "的信息，将使用系统缺省的描述信息。\n");
                write("缺省的描述信息如下：\n" + sort_desc(v5->query("default_long")));
                map_delete(v3, v6[v4]);
            } else {
                v3[v6[v4]] = arg3;
                write("你重新描述了" + v5->query("short") + "。\n");
            }
            return 1;
        }
    }
    write("没有找到" + arg2 + "，所以没有修改描述信息。请查证再修改描述信息。\n");
    return 0;
}

string obey_description(mixed arg) {
    if (sizeof(arg) > 330) {
        luban_say("你的描述也太长了吧...\n");
        return 0;
    }
    if (!arg || arg == "") {
        return "";
    }
    arg = replace_string(arg, "\"", "'");
    arg = replace_string(arg, "\\n", "\n");
    arg = replace_string(arg, "\t", "");
    arg = replace_string(arg, " ", "");
    arg = replace_string(arg, "$BLK$", "\e[30m");
    arg = replace_string(arg, "$RED$", "\e[31m");
    arg = replace_string(arg, "$GRN$", "\e[32m");
    arg = replace_string(arg, "$YEL$", "\e[33m");
    arg = replace_string(arg, "$BLU$", "\e[34m");
    arg = replace_string(arg, "$MAG$", "\e[35m");
    arg = replace_string(arg, "$CYN$", "\e[36m");
    arg = replace_string(arg, "$WHT$", "\e[37m");
    arg = replace_string(arg, "$HIR$", "\e[1;31m");
    arg = replace_string(arg, "$HIG$", "\e[1;32m");
    arg = replace_string(arg, "$HIY$", "\e[1;33m");
    arg = replace_string(arg, "$HIB$", "\e[1;34m");
    arg = replace_string(arg, "$HIM$", "\e[1;35m");
    arg = replace_string(arg, "$HIC$", "\e[1;36m");
    arg = replace_string(arg, "$HIW$", "\e[1;37m");
    arg = replace_string(arg, "$NOR$", "\e[2;37;0m");
    arg = arg + "\e" + "[2;37;0m";
    return arg;
}

int do_list(mixed arg) {
    if (!exist_form()) {
        return 1;
    }
    if (!arg || arg == "" || arg == "all" || arg == "全部" || arg == "所有") {
        show_apply();
        show_agree();
        show_reject();
        show_old();
        return 1;
    }
    switch (arg) {
    case "new":
    case "apply":
    case "申请":
        show_apply();
        return 1;
    case "agree":
    case "批准":
    case "同意":
        show_agree();
        return 1;
    case "否决":
    case "不批准":
    case "没批准":
    case "reject":
        show_reject();
        return 1;
    case "old":
    case "旧":
        show_old();
        return 1;
    }
    write("list的使用说明：\nlist all   : 显示所有的表单。\nlist apply : 显示申请的表单。\nlist agree : 显示巫师已经批准的表单。\nlist reject : 显示巫师已经否决的表单。\nlist old   : 显示过期很久的表单。\n\n");
    return 1;
}

int do_type(mixed arg) {
    mixed v1;
    mixed v2;
    if (!wizardp(this_player()) || wiz_level(this_player()) < 3) {
        write("你无权察看表单中的描述信息！\n");
        return 1;
    }
    if (!arg || arg == "") {
        return notify_fail("type player_id room_name\n");
    }
    if (sscanf(arg, "%s %s", v1, v2) != 2) {
        v1 = arg;
        v2 = "";
    }
    show_desc(v1, v2);
    return 1;
}

void show_brief(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = query("form/" + arg);
    if (!v1 || !mapp(v1)) {
        return;
    }
    v2 = sprintf("%10s  %10s  %10s  %6s", arg, v1["player"], ctime(v1["time"])[0..9], v1["type"]);
    switch (v1["status"]) {
    case "申请":
        v2 += "\e[1;37m";
        break;
    case "同意":
        v2 += "\e[1;33m";
        break;
    case "拒绝":
        v2 += "\e[1;31m";
        break;
    }
    v2 += "  " + v1["status"] + "\e" + "[2;37;0m" + "  ";
    v3 = v1["wizard"];
    v4 = v1["memo"];
    if (!stringp(v3) || v3 == "无" || v3 == "") {
        v3 = "----------";
    }
    if (!stringp(v4) || v4 == "无" || v4 == "") {
        v4 = "------";
    }
    v2 += sprintf("%10s  %s\n", v3, v4);
    write(v2);
    return;
}

int exist_form() {
    if (!mapp(query("form")) || sizeof(query("form")) < 1) {
        write("现在并没有任何表单。\n");
        return 0;
    }
    if (!wizardp(this_player()) || wiz_level(this_player()) < 3) {
        write("你无权处理表单。\n");
        return 0;
    }
    return 1;
}

int do_agree(mixed arg) {
    if (!exist_form()) {
        return 1;
    }
    if (!arg || arg == "" || !query("form/" + arg)) {
        return notify_fail("你要操作谁的表单？\n");
    }
    if (query("form/" + arg + "/status") == "同意") {
        write("已经有其他巫师批准此表单了。\n");
        return 1;
    }
    set("form/" + arg + "/status", "同意");
    set("form/" + arg + "/wizard", this_player()->query("name"));
    set("form/" + arg + "/memo", "无");
    write("你批准了" + query("form/" + arg + "/player") + "(" + arg + ")的申请。\n");
    save();
    return 1;
}

int do_reject(mixed arg) {
    mixed v1;
    mixed v2;
    if (!exist_form()) {
        return 1;
    }
    if (!arg || arg == "") {
        return notify_fail("你要操作谁的表单？\n");
    }
    if (sscanf(arg, "%s %s", v1, v2) != 2) {
        v1 = arg;
        v2 = "无";
    }
    if (!query("form/" + v1)) {
        return notify_fail("你要操作谁的表单？\n");
    }
    if (v2 == "无") {
        write("你可以添加备注信息(reject player 备注信息)，说明拒绝的理由。\n");
    }
    set("form/" + v1 + "/status", "拒绝");
    set("form/" + v1 + "/wizard", this_player()->query("name"));
    set("form/" + v1 + "/memo", v2);
    write("你已经拒绝了" + query("form/" + v1 + "/player") + "(" + v1 + ")的申请。\n");
    save();
    return 1;
}

int do_delete(mixed arg) {
    if (!exist_form()) {
        return 1;
    }
    if (!arg || arg == "" || !query("form/" + arg) && arg != "old") {
        return notify_fail("你要操作谁的表单？\n");
    }
    if (query("form/" + arg + "/status") == "申请") {
        return notify_fail("你不能删除一个申请后还没有处理的表单。\n");
    }
    write("" + query("form/" + arg + "/player") + "(" + arg + ")提交的表单被删除了。\n");
    delete("form/" + arg);
    save();
    return 1;
}

void show_apply() {
    show_brief_list("申请", "\e[1;37m以下是玩家提交的申请的表单\e[2;37;0m");
}

void show_agree() {
    show_brief_list("同意", "\e[1;33m以下是巫师已经批准申请的表单\e[2;37;0m");
}

void show_reject() {
    show_brief_list("拒绝", "\e[1;31m以下是被巫师拒绝申请的表单\e[2;37;0m");
}

void show_old() {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!exist_form()) {
        return;
    }
    v2 = 0;
    v3 = keys(query("form"));
    for (v1 = 0; v1 < sizeof(v3); v1++) {
        if (query("form/" + v3[v1] + "/time") - time() > 1296000) {
            if (!v2) {
                write("\e[33m-------------------------------------------------------------------------------\n\e[2;37;0m");
                write("\e[1;36m以下是玩家提交了很久的表单：\n\e[2;37;0m");
                show_brief_title();
            }
            v2++;
            show_brief(v3[v1]);
        }
    }
    if (v2) {
        write("共有" + v2 + "张比较陈旧的表单。\n");
    }
}

void show_brief_list(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!exist_form()) {
        return;
    }
    v2 = 0;
    v3 = keys(query("form"));
    for (v1 = 0; v1 < sizeof(v3); v1++) {
        if (arg1 == "" || query("form/" + v3[v1] + "/status") == arg1) {
            if (!v2) {
                write("\e[33m-------------------------------------------------------------------------------\n\e[2;37;0m");
                write(arg2 + "\n");
                show_brief_title();
            }
            v2++;
            show_brief(v3[v1]);
        }
    }
    if (v2) {
        write("共有" + v2 + "张表单。\n");
    }
}

void show_brief_title() {
    write("申请者代号  申请者姓名  申请的时间  房  型  状态  注册的巫师  备   注\n");
}

void create_room(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    mixed v10;
    mixed v11;
    mixed v12;
    mixed v13;
    mixed v14;
    mixed v15;
    mixed v16;
    mixed v17;
    mixed v18;
    mixed v19;
    mixed v20;
    mixed v21;
    mixed v22;
    arg = this_player();
    if (!objectp(arg)) {
        return;
    }
    v3 = arg->query("id");
    v11 = "";
    if (!mapp(query("form/" + v3))) {
        return;
    }
    v20 = "form/" + v3 + "/";
    v4 = query(v20 + "type");
    for (v18 = 0; v18 < sizeof(room_example); v18++) {
        if (room_example[v18]["type"] == v4) {
            v1 = room_example[v18]["files"];
            break;
        }
    }
    if (!mapp(v1)) {
        write("你申请的房屋类型(" + v4 + ")已经不存在了，请和巫师联系。\n");
        return;
    }
    v2 = query(v20 + "descs");
    v4 = query(v20 + "room");
    v5 = query(v20 + "name");
    v6 = query(v20 + "id");
    v9 = query(v20 + "position");
    v13 = keys(v1);
    v7 = query(v20 + "player");
    v8 = "key of " + v3;
    v17 = get_object(v9);
    if (!objectp(v17)) {
        write("你建房的地点已经不存在了，请和巫师联系！\n");
        return;
    }
    v10 = v17->query("short");
    for (v18 = message("vision", "\e[1;33m鲁班拍拍手，说道：弟子们，生意来了！赚金子银子的时候到了！！！\n\e[2;37;0m\e[33m霎时天昏地暗，你只觉得眼前模模糊糊，什么也看不清楚，浑然不知道发生了什么事情。\n\e[2;37;0m", environment(this_object())); v18 < sizeof(v13); v18++) {
        if (file_size(v1[v13[v18]]) <= 0) {
            write("缺少文件:" + v1[v13[v18]] + "，不能生成房屋，请和巫师联系。\n");
            v19 = v18 - 1;
            while (v19 >= 0) {
                rm(to_player(v3, v1[v13[v19]]));
                v19--;
            }
            return;
        }
        v12 = explode(read_file(v1[v13[v18]]), "\n");
        v21 = 0;
        v22 = 0;
        v14 = to_player(v3, v1[v13[v18]]);
        v15 = "// File(" + to_player(v3, v1[v13[v18]]) + ")" + " of " + v3 + "'s room\n// Create by LUBAN which written by Robert\n";
        for (v19 = 0; v19 < sizeof(v12); v19++) {
            if (strsrch(v12[v19], "LONG") != -1) {
                v21 = !v21;
                if (!v21) {
                    v16 = v2[v13[v18]];
                    if (!v16 || v16 == "") {
                        v17 = get_object(v1[v13[v18]]);
                        v16 = v17->query("default_long");
                    }
                    v16 = replace_string(v16, "ROOM_POSITION", v10);
                    v16 = sort_desc(v16);
                    v15 += "\tset (\"long\", @LONG\n" + v16 + "LONG\n";
                }
                continue;
            }
            if (v21) {
                continue;
            }
            if (strsrch(v12[v19], "/**/") != -1) {
                continue;
            }
            v12[v19] = replace_string(v12[v19], "//**", "");
            if (v12[v19][0..1] == "//") {
                continue;
            }
            if (strsrch(v12[v19], "/d/room/xiaoyuan") != -1) {
                v11 = v14;
            }
            v12[v19] = replace_string(v12[v19], "ROOM_KEY", v8);
            v12[v19] = replace_string(v12[v19], "ROOM_OWNER", v7);
            v12[v19] = replace_string(v12[v19], "ROOM_NAME", v5);
            v12[v19] = replace_string(v12[v19], "ROOM_ID", v6);
            v12[v19] = replace_string(v12[v19], "ROOM_POSITION", v10);
            v12[v19] = replace_string(v12[v19], "/d/room/xiaoyuan", v9);
            if (v12[v19] == "") {
                v22++;
            } else {
                v22 = 0;
            }
            if (v22 > 1) {
                continue;
            }
            v15 += v12[v19] + "\n";
        }
        if (v21) {
            write("文件:" + v1[v13[v18]] + "格式错误，LONG不匹配，不能生成房屋，请和巫师联系。\n");
            v19 = v18 - 1;
            while (v19 >= 0) {
                rm(to_player(v3, v1[v13[v19]]));
                v19--;
            }
            return;
        }
        seteuid(getuid());
        rm(v14);
        assure_file(v14);
        write_file(v14, v15);
        v15 = "";
    }
    if (!v11 || v11 == "") {
        message("vision", "\n过了一会，鲁班和众弟子踉踉跄跄的赶了回来。\n鲁班苦着脸说：这是怪事，居然找不到入口！你去问问巫师究竟是怎么搞的！\n", environment(this_object()));
        v19 = v18 - 1;
        while (v19 >= 0) {
            rm(to_player(v3, v1[v13[v19]]));
            v19--;
        }
        return;
    }
    v17 = get_object(v9);
    if (!v17->create_room(v5, v11)) {
        message("vision", "\n过了一会，鲁班和众弟子踉踉跄跄的赶了回来。\n鲁班一脸霉样，苦着脸说：真邪门了，那里居然还有个名字一样的房子，结果我们被人扁了回来！\n奶奶的头，我公输班活了一千多年还是头次听闻这种事！\n", environment(this_object()));
        v19 = v18 - 1;
        while (v19 >= 0) {
            rm(to_player(v3, v1[v13[v19]]));
            v19--;
        }
        return;
    }
    message("vision", "\n须臾，鲁班和众弟子已然归来。\n鲁班喜道：呵呵，房屋建好了，一切顺利，恭喜恭喜！\n", environment(this_object()));
    v17->save();
    reload_object(v17);
    v14 = "/data/room/" + v3 + "/key.lpc";
    v15 = "// File(" + v14 + ")" + " of " + v3 + "'s key\n// Create by LUBAN which written by Doing Lu\n";
    v15 += "\r\ninherit ITEM;\r\n#include <ansi.h>\r\n\r\nstring query_autoload() { return \"1\"; }\r\n\r\nvoid autoload(string param)\r\n{\r\n}\r\n\r\n\r\nvoid create()\r\n{\r\n\tset_name(YEL \"KEY_NAME\" NOR, ({\"key\", \"KEY_ID\"}));\r\n\tset_weight(10);\r\n\tif (clonep())\r\n\t\tset_default_object(__FILE__);\r\n\telse {\r\n\t\tset(\"long\", \"KEY_DESCRIPTION。\\n\");\r\n\t\tset(\"unit\", \"把\");\r\n\t\tset(\"no_pawn\", 1);\r\n\t\tset(\"item_make\", 1);\r\n\t\tset(\"value\",0);\r\n\t\tset(\"no_steal\",1);\r\n\t\tset(\"no_get\",1);\r\n\t\tset(\"no_beg\",1);\r\n\t\tset(\"no_put\",1);\r\n\t\tset(\"key_master\",\"KEY_MASTER\");\r\n\t}\r\n}\r\n";
    v16 = "一把用来开启" + v5 + "(" + v6 + ")的钥匙。\n";
    v15 = replace_string(v15, "KEY_DESCRIPTION", v16);
    v15 = replace_string(v15, "KEY_NAME", arg->query("name") + "家的钥匙");
    v15 = replace_string(v15, "KEY_ID", v8);
    v15 = replace_string(v15, "KEY_MASTER", arg->query("id"));
    seteuid(getuid());
    rm(v14);
    assure_file(v14);
    write_file(v14, v15);
    v17 = clone_object(v14);
    message_vision("鲁班拿出一把钥匙，对$N说：诺，这是钥匙，收好了！若是丢了可以到我这里再配一把。\n", arg);
    v17->move(arg);
    delete("form/" + v3);
    save();
    arg->set("private_room/build", 1);
    arg->set("private_room/position", v9);
    arg->set("private_room/entry", v11);
    arg->set("private_room/name", v5);
    arg->set("private_room/id", v6);
    arg->set("private_room/type", v4);
    arg->save();
    return;
}

string to_player(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    sscanf(arg2, "/d/room/%s/%s", v1, v2);
    return "/data/room/" + arg1 + "/" + v2;
}

string sort_desc(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    v4 = 63;
    v1 = "";
    v3 = 4;
    v5 = sizeof("\n");
    v6 = 0;
    if (!arg || arg == "") {
        return 0;
    }
    v2 = sizeof(arg);
    while (v2 + v3 > v4 && v2 > 0) {
        while (v3 < v4) {
            if (arg[0] >= 128) {
                v1 += arg[0..1];
                arg = arg[2..v2 - 1];
                v2 -= 2;
                v3 += 2;
                continue;
            }
            if (arg[0] >= 32) {
                v1 += arg[0..0];
                arg = arg[1..v2 - 1];
                v2--;
                v3++;
                continue;
            }
            break;
        }
        if ((arg[0..0] == "。" || arg[0..0] == "！" || arg[0..0] == "；" || arg[0..0] == "，" || arg[0..0] == "：") && v3 < v4 + 2) {
            v1 += arg[0..1];
            arg = arg[2..v2 - 1];
            v2 -= 2;
            v3 += 2;
        }
        if ((arg[0] == 46 || arg[0] == 33 || arg[0] == 59 || arg[0] == 44 || arg[0] == 58) && v3 < v4 + 2) {
            v1 += arg[0..0];
            arg = arg[1..v2 - 1];
            v2--;
            v3++;
        }
        if (v3 >= v4) {
            v1 += "\n";
            v3 = 0;
        }
        if (arg[0..sizeof("\n") - 1] == "\n") {
            if (v3) {
                v1 += "\n";
            }
            v1 += "    ";
            arg = arg[v5..v2 - 1];
            v2 -= v5;
            v3 = 4;
        }
        if (arg[0] == 27) {
            while (arg[v6] != 109) {
                v6++;
            }
        }
        if (v6 > 0) {
            v1 += arg[0..v6];
            arg = arg[v6 + 1..v2 - 1];
            v2 -= v6 + 1;
            continue;
        }
    }
    if (v2 >= v5 && arg[v2 - v5..v2 - 1] != "\n") {
        arg += "\n";
    }
    v1 += arg;
    return v1;
}
