    v2->move(v3);
    "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s得到了「周天图」！", v3->name()));
    return "好吧，这本「周天图」你拿回去好好钻研。";
}

