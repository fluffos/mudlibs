void attempt_apprentice(mixed arg) {
    if (arg->query("gender") != "男性") {
        command("say 我不收女徒弟。\n");
        return;
    }
    if (arg->query("family/family_name") != "血刀门") {
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "既非本门弟子，还是请回吧！");
        return;
    }
    if (arg->query("shen") > -100000) {
        command("say 你是不是向着侠义道，连杀人都不会！");
        return;
    }
    if (arg->query_skill("xuehai-mogong", 1) < 400) {
        command("say 入我血刀门，修习血海魔功是首要的。");
        return;
    }
    command("haha");
    command("recruit " + arg->query("id"));
}

