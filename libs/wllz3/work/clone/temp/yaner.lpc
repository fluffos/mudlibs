inherit "/inherit/char/npc";
int ask_job();
void greeting(mixed);
int do_apply();
int accept_object(mixed, mixed);

void create() {
    set_name("燕儿", ({ "yan er", "yan" }));
    set("gender", "女性");
    set("title", "\e[1;35m念亲郎\e[2;37;0m");
    set("age", 20);
    set("level", 200);
    set("attitude", "peaceful");
    set("per", 10);
    set("inquiry", ([ "中秋节" : (: ask_job :), "玉哥" : "玉哥是我爱郎，唉，日子难挨，可苦了玉哥了。" ]));
    set_skill("unarmed", 600);
    set_skill("dodge", 600);
    set_skill("parry", 600);
    set_skill("force", 600);
    set_temp("apply/dodge", 600);
    set_temp("apply/damage", 600);
    set_temp("apply/unarmed_damage", 600);
    setup();
    carry_object("/clone/cloth/female3-cloth")->wear();
}

void init() {
    mixed v1;
    if (interactive(v1 = this_player()) && v1->query("gift/data") != "中秋佳节" && !v1->query("marks/燕儿")) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
        add_action("do_apply", "apply");
    }
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    say("燕儿面路难色，脸上挂着一行泪珠。\n");
    return;
}

int do_apply() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (v1->query("gift/data") == "中秋佳节" || v1->query("marks/燕儿")) {
        return 0;
    }
    if (v1->query("level") < 20) {
        return 0;
    }
    if (v1->query_temp("special_quest/ask_yaner")) {
        say("燕儿问道：玉哥眼下就在扬州，" + "/adm/daemons/rankd"->query_respect(v1) + "可有将秋衣送到玉哥手中？\n");
        return 1;
    }
    if (sizeof(all_inventory(v1)) > 30) {
        write("你身上的物品太多了，万一丢了人家的东西可怎么办？\n");
        return 1;
    }
    say("燕儿焦虑的说道「眼下秋天将至，秋意渐浓，不知道玉哥可有添衣。我这\n里有一件为玉哥缝制的秋衣，你帮我送到玉哥那去吧，玉哥眼下就在扬州。」\n");
    v2 = clone_object("/clone/temp/qiuyi");
    v2->move(v1, 1);
    v1->set_temp("special_quest/ask_yaner", 1);
    tell_object(v1, "你得到了一件精制的秋衣。\n");
    return 1;
}

int ask_job() {
    mixed v1;
    v1 = this_player();
    if (v1->query("level") < 20) {
        return 0;
    }
    if (v1->query("gift/data") == "中秋佳节" || v1->query("marks/燕儿")) {
        say("燕儿说道：「好人自有好报，多谢这位" + "/adm/daemons/rankd"->query_respect(v1) + "热心相助！」\n");
        return 1;
    }
    if (v1->query_temp("special_quest/ask_yaner")) {
        say("燕儿问道「玉哥眼下就在扬州，" + "/adm/daemons/rankd"->query_respect(v1) + "可有将秋衣送到玉哥手中？」\n");
        return 1;
    }
    say("燕儿看了看你，眼圈一红，慢慢说道「中秋佳节，我和玉郎却分隔两地。\n眼下秋意渐浓，这位" + "/adm/daemons/rankd"->query_respect(v1) + "可否帮我送一件秋衣给玉哥？」\n");
    tell_object(v1, "\e[1;31m如果你愿意帮她这个忙，那么请输入\e[1;37m apply \e[1;31m吧。\n\e[2;37;0m");
    return 1;
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->id("yue bing") && arg2->name() == "\e[1;33m月饼\e[2;37;0m") {
        if (arg1->query_temp("special_quest/ask_yaner") && arg1->query_temp("special_quest/ask_yuge") && !arg1->query("gift/data", "中秋佳节") && !arg1->query("marks/燕儿")) {
            say("燕儿喜出望外，接过月饼紧紧抱在怀里，说道「多谢这位" + "/adm/daemons/rankd"->query_respect(arg1) + "，玉哥\n果然还没有忘记我，我一定会等他回来的。」\n");
            arg1->set_temp("special_quest/finish", 1);
            arg1->set("marks/燕儿", 1);
            return 1;
        }
        return 0;
    }
}
