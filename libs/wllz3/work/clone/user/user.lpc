// user.c

#include <ansi.h>
#include <origin.h>
#include <user.h>
#include <command.h>

inherit CHARACTER;
inherit F_AUTOLOAD;
inherit F_SAVE;

nosave int net_dead;                    // 标志：是否断开了连接
nosave int user_say = 0;                // 一定时间以内玩家做的say-action
nosave int user_command = 0;            // 一定时间以内玩家发送的命令
nosave int at_time = 0;                 // 在什么时间计算的
nosave int ban_to = 0;                  // 在什么时间解禁玩家
nosave int attach_flag = 0;             // 是否正在和系统联络
nosave int idtime = 0;
nosave int craze = 0;   // 愤怒

#define MAX_COMMAND_ONE_SECTION         40
#define MAX_SAY_ONE_SECTION             5
#define BAN_SAY_PERIOD                  60

nosave int last_age_set;

int is_player() { return clonep(); }
int is_net_dead() { return net_dead || !interactive(this_object()); }

void create() {
  ::create();
  set_name("使用者物件", ({ "user object", "user", "object" }));
}

void terminal_type(string term_type) {
  set_temp("terminal_type", term_type);
  message("system", "终端机型态设定为 " + term_type + "。\n", this_object());
}
int is_member() {
  /*
	if(INFO_D->query_user_time(query("id")))
		return 1;
	*/
  return 1;
}

void reset() {
  if ((int)query("potential") < 100)
    add("potential", 1);

  if ((int)query("thief") > 0)
    add("thief", -1);
}
// This is used by F_SAVE to determine the filename to save our data.
string query_save_file() {
  string id;

  id = geteuid();
  if (!id) id = getuid();
  if (!stringp(id)) return 0;
  return sprintf(DATA_DIR "user/%c/%s", id[0], id);
}
mixed set(string idx, mixed para) {
  if (idx == "name" && clonep(this_object()) &&
    geteuid(this_object())) {
    NAME_D->change_name(this_object(), para, 1);
    return para;
  } else
    return ::set(idx, para);
}
int save() {
  int res;

  save_autoload();
  res = ::save();
  clean_up_autoload();            // To save memory
  return res;
}

// This function updates player's age, called by heart_beat()

void update_age() {
  object ob;

  ob = this_object();

  if (!environment()) return;

  if (interactive(ob) && ob->query("env/idle")
    && query_idle(ob) > 300) {
    int skill = (int)ob->query_skill("idle-force", 1);
    if (idtime > (skill + 1) * (skill + 1)) {
      set_skill("idle-force", skill + 1);
      tell_object(ob, HIY "你的「发呆神功」进步了！\n" NOR);
      idtime = 0;
    } else idtime += 1;
  }

  if (environment(ob)->query("chat_room")) {
    last_age_set = time();
    return;
  }
  if (!last_age_set) last_age_set = time();
  add("mud_age", time() - last_age_set);
  last_age_set = time();
  set("age", 14 + (int)query("age_modify") + ((int)query("mud_age") / 86400));

}
void setup() {
  object link_ob;

  if (objectp(link_ob = query_temp("link_ob")))
    set_temp("terminal_type", link_ob->query_temp("terminal_type"));

  // We want set age first before new player got initialized with
  // random age.
  update_age();

  ::setup();
  restore_autoload();

  if (query("doing"))
    CLOSE_D->continue_doing(this_object());

}
private void user_dump(int type) {
  switch (type) {
    case DUMP_NET_DEAD:
      if (environment()) {
        tell_room(environment(), query("name") + "断线超过 "
          +NET_DEAD_TIMEOUT / 60 + " 分钟，自动退出这个世界。\n");
      }
      catch(command("quit"));
      if (this_object() && !query("doing")) {
        QUIT_CMD->force_quit(this_object());
      }
      break;

    case DUMP_IDLE:
      if (environment() && environment()->is_chat_room())
        return;
      if (wizardp(this_object()))
        return;

      tell_object(this_object(), "对不起，您已经发呆超过 " + IDLE_TIMEOUT / 60 + "分"
        "钟了，请下次再来。\n");
      tell_room(environment(), name(1) + "似乎明白了些什么，恍然大悟：哦，"
        "原来是这样子。\n", ({ this_object() }));

      command("quit");
      if (this_object() && !query("doing")) {
        QUIT_CMD->force_quit(this_object());
      }
      break;
    default:
      return;
  }
}

// net_dead: called by the gamedriver when an interactive player loses
// hir network connection to the mud.
private void net_dead() {
  object link_ob;

  this_object()->remove_interactive();

  if (!query("doing"))
    set_heart_beat(0);

  if (objectp(link_ob = query_temp("link_ob"))) {
    if (link_ob->query_temp("ip_number")) {
      link_ob->set("last_on", time());
      link_ob->set("last_from",
        link_ob->query_temp("ip_number"));
      link_ob->save();
    }
    destruct(link_ob);
  }

  net_dead = 1;

  if (userp(this_object()) && !query("doing")) {
    call_out("user_dump", NET_DEAD_TIMEOUT, DUMP_NET_DEAD);
    tell_room(environment(), query("name") + "断线了。\n", this_object());
    CHANNEL_D->do_channel(this_object(), "sys", "断线了。");
    if (!is_fighting())
      remove_all_enemy(1);
  } else {
    if (environment())
      message("vision", name() + "离线了。\n",
        environment(), ({ this_object() }));
  }
}
// reconnect: called by the LOGIN_D when a netdead player reconnects.
void reconnect() {
  object link_ob;

  if (objectp(link_ob = query_temp("link_ob")))
    set_temp("terminal_type", link_ob->query_temp("terminal_type"));

  set_heart_beat(1);
  net_dead = 0;
  remove_call_out("user_dump");
  tell_object(this_object(), "重新连线完毕。\n");
  set_temp("last_reconnect", time());
}

int accept_fight(object ob) {
  if (query_temp("pending/fight") == ob)
    return 1;

  tell_object(this_object(), YEL "如果你愿意和对方进行比试，请你也对" +
    ob->name() + "(" + (string)ob->query("id") + ")" +
    "下一次 fight 指令。\n" NOR);

  tell_object(ob, YEL "由于对方是由玩家控制的人物，你必须等对方同意才" +
    "能进行比试。\n" NOR);

  return 0;
}

int accept_hit(object ob) {
  message_vision("$N大喝道：" + ob->name() + "，你要干什么？\n",
    this_object(), ob);
  return 1;
}

int accept_kill(object ob) {
  if (is_killing(ob))
    return 1;

  tell_object(this_object(), HIR "如果你要和" + ob->name() +
    "性命相搏，请你也对这个人(" + (string)ob->query("id") +
    ")下一次 kill 指令。\n" NOR);
  return 1;
}

int accept_ansuan(object who) {
  command(random(2) ? "say 嗯！怎么..." : "say 啊！不好！");
  return 1;
}

int accept_touxi(object who) {
  switch (random(2)) {
    case 0:
      message_vision("$N大吃一惊，叫道：“好你个" +
        RANK_D->query_rude(who) + "！真不要脸！”\n",
        this_object(), who);
      break;

    default:
      message_vision("$N仓皇之间，不及说话，只得接下$n"
        "这一招。\n", this_object(), who);
      break;
  }

  return 1;
}
int is_want_now() {
  mapping info;

  if (mapp(info = LOG_D->query_want(query("id")))
    && info["want_time"] > time())
    return 1;
}

int valid_attack() {
  if (is_want_now())
    return 1;

  if (environment() && environment()->query("pk_room", 1))
    return 1;

  if (query("family") && WARFARE_D->is_war_family(query("family/family_name")))
    return 1;

  if (query("combat/status"))
    return 1;

  if (query("level") < 50)
    return 0;

  if (!interactive() && query("doing"))
    return 0;

  return 1;
}
int is_teacher() {
  if (mapp(LOG_D->query_teacher(query("id"))))
    return 1;
  return 0;
}

int query_craze() { return craze; }

// 最大的愤怒气息

int query_max_craze() {
  switch (query("attributive/att")) {
    case "金":
      return 4000;

    case "木":
      return 3500;

    case "水":
      return 2500;

    case "火":
      return 7000;

    case "土":
      return 5000;
    default:
      return 0;
  }
}
// 愤怒效果

int anger_bonus() {
  int amount;

  amount = query("spi") + query("str");
  amount /= 2;

  switch (query("attributive/att")) {
    case "金":
      return 400 + amount;
    case "木":
      return 350 + amount;
    case "水":
      return 250 + amount;
    case "火":
      return 700 + amount;
    case "土":
      return 500 + amount;
    default:
      return 0 + amount;
  }
}

int improve_craze(int amount) {
  int limit;

  if (amount < 0)
    error("error: improve_craze amount to be less than 0\n");

  limit = query_max_craze();
  craze += amount;
  if (craze > limit) {
    amount += limit - craze;
    craze = limit;
  }
  return amount;
}

// 消耗愤怒，返回消耗的有效值
int cost_craze(int n) {
  if (n < 0)
    error("error: improve_craze amount to be less than 0\n");

  if (n > craze) {
    n = craze;
    craze = 0;
  } else
    craze -= n;
  return n;
}
int is_most_craze() {
  return (craze > 0) && (craze >= query_max_craze());
}

int reject_command() {
  int t;

  if (!this_object()) return 0;
  if (wizardp(this_object())) return 0;

  t = time() & 0xFFFFFFFE;
  if (at_time != t) {
    at_time = t;
    user_command = 1;
    user_say = 0;
  } else
    user_command++;

  if (user_command > MAX_COMMAND_ONE_SECTION)
    return 1;

  return 0;
}
int ban_say() {
  int t;

  if (!this_object()) return 0;
  if (wizardp(this_object())) return 0;

  t = time() & 0xFFFFFFFE;
  if (query_temp("ban_times") > 4) {
    write("由于你一再的滥用指令，系统不再接受你任何指令了。\n");
    command("quit");
  }
  if (ban_to > t) {
    notify_fail("系统禁止你送出信息，请于" + chinese_number(ban_to - t) + "秒钟以后再尝试。\n");
    return 1;
  }
  if (at_time != t) {
    at_time = t;
    user_say = 1;
    user_command = 0;
  } else
    user_say++;

  if (user_say > MAX_SAY_ONE_SECTION) {
    add_temp("ban_times", 1);
    ban_to = t + BAN_SAY_PERIOD * query_temp("ban_times");
    CHANNEL_D->do_channel(find_object(MASTER_OB), "rumor",
      "听说" + query("name") + "因为太罗嗦，被人堵住了嘴。");
    notify_fail("由于你发布的信息太多，因此系统暂时禁止你发出信息。\n");
    return 1;
  }

  return 0;
}
int is_attach_system() {
  return attach_flag;
}
// start attaching
int attach_system() {
  attach_flag = 1;
}

// stop, deatched
int detach_system() {
  attach_flag = 0;
}

int max_neili() {
  int spi;

  spi = query_spi();

  if (query("breakup"))
    return query_skill("force") + spi * 100;
  else
    return query_skill("force") + spi * 60;
}
int max_jingli() {

  mapping my;
  object ob;
  int max_jingli;

  ob = this_object();
  my = ob->query_entire_dbase();

  if (mapp(my["family"])
    && ((my["family"]["family_name"] == "逍遥派" && (int)ob->query_skill("beiming-shengong", 1) >= 120)
      || (my["family"]["family_name"] == "日月神教" && (int)ob->query_skill("xixing-force", 1) >= 120)
      || (my["family"]["family_name"] == "星宿派" && (int)ob->query_skill(
        "huagong-dafa",
        1
      ) >= 120))) {
    max_jingli = ((int)ob->query("spi") + (int)ob->query_con()) * 30;
  } else {
    if ((int)ob->query_skill("buddhism", 1)) max_jingli = (int)ob->query_skill("buddhism", 1) * 10;
    else if ((int)ob->query_skill("taoism", 1)) max_jingli = (int)ob->query_skill("taoism", 1) * 10;
    else if ((int)ob->query_skill(
      "lamaism",
      1
    )) max_jingli = (int)ob->query_skill("lamaism", 1) * 10;
    else if ((int)ob->query_skill(
      "mahayana",
      1
    )) max_jingli = (int)ob->query_skill("mahayana", 1) * 10;
    else if ((int)ob->query_skill("poison", 1)) max_jingli = (int)ob->query_skill("poison", 1) * 10;
    else max_jingli = 0;
  }
  if (query("breakup"))
    max_jingli += (int)ob->query("spi") * 15;

  return max_jingli;
}
int max_potential() {
  if (query("level") < 30)
    return query("level") * 1000;
  else if (query("level") < 60)
    return query("level") * 2000;
  else if (query("level") < 90)
    return query("level") * 3000;
  else if (query("level") < 120)
    return query("level") * 4000;
  else if (query("level") < 150)
    return query("level") * 5000;
  else
    return query("level") * 6000;
}
int level_exp_limit() {
  int inworld;

  inworld = (int)query("inworld");

  if (query("level") < 50)
    return query("level") * (query("level") + 3 + inworld) * 150;
  else if (query("level") < 100)
    return query("level") * (query("level") + 6 + inworld) * 150;
  else if (query("level") < 150)
    return query("level") * (query("level") + 9 + inworld) * 150;
  else
    return query("level") * (query("level") + 15 + inworld) * 150;
}
int levelup_check() {
  if (query("level") < 100)
    return 1;

  if (level_exp_limit() > query("exp_cost/exp"))
    return 1;

  if (query("level") % 10 == 9
    && (int)query("combat/magic") < (int)query("level"))
    return 0;

  return 1;
}
int add_exp(object ob, int exp) {
  mapping exp_cost;
  mapping family;
  mapping fac;

  if (!ob || !environment(ob)) return 0;

  exp_cost = ob->query("exp_cost");

  if (exp_cost["points"] > 0) {
    write(HIR "由于升级点尚未完全分配，经验增长失败！\n" NOR);
    return 1;
  }

  if (!levelup_check()) {
    write(HIR "魔由心生，阁下心魔作祟，必须抑制心魔，方可继续修炼。\n" NOR);
    return 1;
  }

  if (exp_cost["exp"] += exp) {
    if (!levelup_check()) {
      write(HIR "魔由心生，阁下心魔作祟，必须抑制心魔，方可继续修炼。\n" NOR);
      return 1;
    }
    write(sprintf("你的经验%s了" HIW " %d " NOR "点。\n",
      (exp > 0) ? "增长" : "损失", exp));
  }
  if (exp_cost["exp"] >= level_exp_limit()) {
    ob->add("level", 1);

    write(HIG "\n恭喜阁下武功修为更晋一层，获得属性分配点四点。\n\n"
      "请使用 " HIW "levelup" HIG " 指令进行分配。\n" NOR);
    exp_cost["points"] += 4;
    exp_cost["exp"] = 0;

    if (mapp(family = ob->query("family"))) {
      FAMILY_D->map_family_score(family["familiy_name"], 1);
      FAMILY_D->map_family_info(family["familiy_name"], ob);
    }
    if (mapp(fac = ob->query("faction"))) {
      FACTION_D->remove_faction_info(fac["faction_name"], ob);
      FACTION_D->map_faction_info(fac["faction_name"], ob, fac["identity"]);
    }
  }
  return 1;
}
int add_points(object ob, int points) {
  mapping my;

  my = query_entire_dbase();

  if (!ob || !environment(ob))
    return 0;

  if (query("exp_cost/points") > 0) {
    write(HIR "由于升级点尚未完全分配，潜能增长失败！\n" NOR);
    return 0;
  }

  if (my["potential"] >= max_potential()) {
    write(HIR "由于潜能满足上限，增长失败。\n" NOR);
    return 0;
  }

  if (!levelup_check()) {
    write(HIR "魔由心生，阁下心魔作祟，必须抑制心魔，方可继续修炼。\n" NOR);
    return 1;
  }

  if (my["potential"] += points) {
    if (!levelup_check()) {
      write(HIR "魔由心生，阁下心魔作祟，必须抑制心魔，方可继续修炼。\n" NOR);
      return 1;
    }
    write(sprintf("你的潜能%s了" HIW " %d " NOR "点。\n",
      (points > 0) ? "增长" : "损失", points));

  }
  return 1;
}
void edit_file(string file) {
  ed(file);
}

int is_brother(string id) {
  mapping brother;
  object me;

  me = this_object();

  if (!mapp(brother = me->query("brother")))
    return 0;

  if (undefinedp(brother[id]))
    return 0;
  else
    return 1;
}

int check_brother_online() {
  mapping brother;
  object me, obj;
  string *brolist;
  string id;

  me = this_object();

  if (!mapp(brother = query("brother")))
    return 0;

  brolist = keys(brother);
  foreach (id in brolist) {
    if (objectp(obj = find_player(id)))
      tell_object(obj, sprintf(HIM "【江湖好友】" NOR + WHT "阁下结拜兄弟%s已经来到游戏中。\n" NOR,
        name(1)));
  }
  return 1;
}
int brother_exit() {
  mapping brother;
  object obj;
  string *brolist;
  string id;

  if (!mapp(brother = query("brother")))
    return 0;

  brolist = keys(brother);
  foreach (id in brolist) {
    if (objectp(obj = find_player(id)))
      tell_object(obj, sprintf(HIM "【江湖好友】" NOR + WHT "阁下结拜兄弟%s已经离开游戏了。\n" NOR,
        name(1)));
  }
  return 1;
}
// 获知门派支持技能等级

int family_valid_level(string skill) {
  mapping fam;
  int level;

  // 如果没有门派，技能只能达到100级
  if (!query("family")) {
    if (query_skill(skill, 1) >= 50) {
      write(HIR "由于你尚未加入门派，技能最高只能达到 50 级。\n" NOR);
      return 0;
    }
    return 1;
  }
  if (mapp(fam = query("family"))
    && intp(level = FAMILY_D->query_family(fam["family_name"])))
    if (level / 100 < (int)query_skill(skill, 1)) {
      write(sprintf(HIR "由于所属门派声望不足，你的「%s」只能达到 %d 级。\n" NOR,
        to_chinese(skill), level / 100,));
      return 0;
    } else
      return 1;
}
int valid_learn_force(string skill) {
  string *sname;
  mapping skills;
  string skill_name;

  // 如果不是内功，则不加过滤直接允许
  if (!SKILL_D(skill)->valid_enable("force"))
    return 1;

  if (SKILL_D(skill)->special_skill())
    return 1;

  skills = query_skills();

  // 如果没有学过武功，则不加过滤直接允许
  if (!sizeof(skills))
    return 1;

  sname = keys(skills);
  foreach (skill_name in sname) {
    if (skill == skill_name)
      continue;
    if (SKILL_D(skill_name)->valid_enable("force")
      && !SKILL_D(skill_name)->valid_comp(skill)
      && !SKILL_D(skill_name)->special_skill()) {
      write(sprintf(HIR "「%s」与你的内功相克相斥，将会引致心性大乱，内力尽溃。\n" NOR,
        to_chinese(skill)));
      return 0;
    }
  }
  return 1;
}
// 每一种季节传来的反映
int apply_for_season() {
  string att;
  string season;

  season = NATURE_D->query_season();
  att = query("attributive/att");

  if (att == "土")
    return 3;

  if (season == "春" && att == "木")
    return 6;

  if (season == "夏" && att == "火")
    return 4;

  if (season == "秋" && att == "金")
    return 5;

  if (season == "冬" && att == "水")
    return 8;
}
int is_scheme() {
  return query("doing");
}
int is_manage() {
  return query("manage");
}
