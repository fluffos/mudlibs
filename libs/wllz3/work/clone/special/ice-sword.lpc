// shortsword.c 长剑

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(HIC "冰魄" NOR, ({ "bing po", "ice sword", "jian" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄天青色的长剑，剑身通透泛出阵阵寒光，你不禁打了一个冷颤。\n");
    set("value", 1000);
    set("material", "steel");
    set("wield_msg", HIC "一阵寒意袭上心头，只见$N「唰」的一声抽出一柄$n" HIC "握在手中。\n" NOR);
    set("unwield_msg", HIC "$N将手中的$n" HIC "插回剑鞘，寒意渐渐退去。\n" NOR);
  }
  init_sword(100);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp;

  if (me->query("neili") < 200)
    return 0;

  if (me->query("attributive/att") != "水")
    return 0;

  ap = me->query_skill("sword");
  ap += me->query_skill("apply-sword", 1);
  dp = victim->query_skill("dodge");

  if (random(ap) > dp / 3 && (int)me->query("neili") > 500) {
    message_combatd(HIC "只见$N手中冰魄泛出一道寒气，那寒气似乎犹如旋风，倾刻包住$n的身体。\n"
      HIW "$n闪躲不及，被那道寒气裹住，动弹不得。\n" NOR, me, victim);
    tell_object(victim, HIY "你只觉得浑身冰冷击骨，浑身肌肤象被千刀万剐似的，剧烈疼痛。\n" NOR);
    victim->receive_damage("jing", 600, me);
    victim->receive_wound("jing", 400, me);
    if (!victim->is_busy())
      victim->start_busy(2);
    me->add("neili", -200);
  }
}
