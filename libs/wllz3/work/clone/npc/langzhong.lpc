inherit "/inherit/char/npc";
string ask_me();
int accept_object(mixed, mixed);
void finish_doctor();
int is_fighter();

void create() {
    set_name(npc_name("男性"), ({ "lang zhong", "dorctor" }));
    set("title", "江湖郎中");
    set("long", "他是一个四处行医的江湖郎中。\n");
    set("attitude", "friendly");
    set("gender", "男性");
    set("age", random(10) + 30);
    set("level", 20);
    set("env/wimpy", 30);
    set_skill("unarmed", 60);
    set_skill("parry", 60);
    set_skill("dodge", 60);
    set("chat_chance", 10);
    set("chat_msg", ({ (: random_move :) }));
    set("inquiry", ([ "治病" : (: ask_me :) ]));
    setup();
    carry_object("/clone/cloth/gua-cloth")->wear();
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->value() >= 1000) {
        message_vision("$N对$n点了点头，说道：好吧，让我帮你看看。\n", this_object(), arg1);
        arg1->set_temp("give_doctor_money", 1);
        remove_call_out("finish_doctor");
        call_out("finish_doctor", 3, arg1);
    } else {
        command("say 这点儿钱就想让我帮你看病？你也太不够诚意了吧？");
        return 0;
    }
    return 1;
}

string ask_me() {
    mixed v1;
    v1 = this_player();
    if (v1->query("eff_qi") == v1->query("max_qi") && v1->query("eff_jing") == v1->query("max_jing")) {
        return "你又没病，来找我干什么？";
    }
    if (!v1->query_condition("ill_shanghan") && !v1->query_condition("ill_fashao") && !v1->query_condition("ill_keshou") && !v1->query_condition("ill_dongshang") && !v1->query_condition("ill_zhongshu")) {
        return "我只能医治一些伤寒，中暑的小病，其他的，只能另请高明了。";
    }
    if (!v1->query_temp("give_doctor_money")) {
        return "要治病？一次十两银子。";
    }
}

void finish_doctor() {
    mixed v1;
    v1 = this_player();
    if (v1->query_condition("ill_shanghan")) {
        v1->apply_condition("ill_shanghan", 0);
    }
    if (v1->query_condition("ill_fashao")) {
        v1->apply_condition("ill_fashao", 0);
    }
    if (v1->query_condition("ill_keshou")) {
        v1->apply_condition("ill_keshou", 0);
    }
    if (v1->query_condition("ill_dongshang")) {
        v1->apply_condition("ill_dongshang", 0);
    }
    if (v1->query_condition("ill_zhongshu")) {
        v1->apply_condition("ill_zhongshu", 0);
    }
    v1->set("eff_qi", v1->query("max_qi"));
    v1->set("qi", v1->query("eff_qi"));
    v1->set("eff_jing", v1->query("max_jing"));
    v1->set("jing", v1->query("eff_jing"));
    message_vision("$N说道：好了，这位" + "/adm/daemons/rankd"->query_respect(v1) + "可要多保重身体才是。\n", this_object());
    return;
}

int is_fighter() {
    return 1;
}
