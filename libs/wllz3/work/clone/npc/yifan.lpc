        arg1->remove_killer(arg2);
        arg2->interrupt_me();
        arg1->interrupt_me();
        arg2->set_leader(arg1);
        arg2->delete("chat_chance");
        arg2->set("qi", arg2->query("max_qi"));
        arg2->set("eff_qi", arg2->query("max_qi"));
        arg2->set("eff_jing", arg2->query("max_jing"));
        arg2->set("jing", arg2->query("max_jing"));
