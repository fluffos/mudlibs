int create_by(mixed arg) {
    mixed v1;
    mixed v2;
    if (stringp(arg)) {
        v1 = find_player(arg);
    } else if (objectp(arg) && playerp(arg)) {
        v1 = arg;
    }
    if (!mapp(v2 = v1->query("my_guard"))) {
        return 0;
    }
    if (undefinedp(v2["name"])) {
        v1->set("my_guard/name", name(1));
    }
    if (undefinedp(v2["id"])) {
        v1->set("my_guard/id", query("id"));
    }
    if (undefinedp(v2["nick"])) {
        v1->set("my_guard/nick", nick[random(sizeof(nick))]);
    }
    set("family/family_name", v2["family"]);
    set("level", v2["level"]);
    set("env/wimpy", v2["wimpy"]);
    set("attitude", v2["attitude"]);
    set("nickname", v2["nick"]);
    set("master_id", v1->query("id"));
    set_name(v2["name"], ({ v2["id"] }));
    "/adm/daemons/npcd"->full_init(this_object());
    "/adm/daemons/chard"->setup_char(this_object());
    set_temp("owner", v1);
    set_temp("owner_id", v1->query("id"));
    if (!query_heart_beat()) {
        set_heart_beat(1);
    }
    if (environment() != environment(v1)) {
        move(environment(v1));
    }
    message_vision("$N对着$n一抱拳，恭恭敬敬的说道：在下" + name() + "，愿效犬马之劳，听从主子吩咐。\n", this_object(), v1);
    v1->set_temp("recall_guard", this_object());
    force_me("guard " + v1->query("id"));
    force_me("follow " + v1->query("id"));
    switch (v2["attitude"]) {
    case "killer":
        set("title", "\e[1;31m" + v1->name(1) + "的贴身保镖\e" + "[2;37;0m");
        break;
    case "heroism":
        set("title", "\e[1;36m" + v1->name(1) + "的护卫\e" + "[2;37;0m");
        break;
    case "friendly":
        set("title", "\e[37m" + v1->name(1) + "的帮手\e" + "[2;37;0m");
        break;
    }
    return 1;
}

int auto_perform() {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!(v1 = query("my_perform"))) {
        return 0;
    }
    v2 = v1[random(sizeof(v1))];
    v3 = query_attack_skill();
    return (skill_dir(v3) + v3)->perform_action(this_object(), v2);
}

void leave() {
    message("vision", name() + "急急忙忙地走开了。\n", environment(), this_object());
    destruct(this_object());
}

