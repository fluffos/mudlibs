int accept_hit(mixed arg) {
    if (arg->query("id") == query("master_id")) {
        write("你不能攻击保护你的人。\n");
        return 0;
    }
    if (query("attitude") == "killer") {
        command("say 哼，找死找到这里来了，" + "/adm/daemons/rankd"->query_self_rude(this_object()) + "手正痒呢！");
        kill_ob(arg);
        set_leader(arg);
        if (!arg->is_busy()) {
            arg->start_busy(random(3) + 2);
        }
        return 1;
    }
}

