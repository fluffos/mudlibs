string query_save_file() {
    return "/data/baby/" + query("id");
}

void create() {
    if (!restore()) {
        set_name("玩家的小孩", ({ "baby" }));
        set("gender", "男性");
        set("long", "玩家的孩子，长得十分可爱。\n");
        set("age", 1);
        set("player_baby", 1);
        set("chat_chance", 2);
        set("chat_msg", ({ (: random_move :) }));
        set("max_qi", 100);
        set("qi", 100);
        set("jing", 100);
        set("max_jing", 100);
        setup();
    } else {
        set("father_name", query("father_name"));
        set("mather_name", query("mather_name"));
        set("mather_id", query("mather_id"));
        set("father_id", query("mather_id"));
        set("per", query("per"));
        set("con", query("con"));
        set("kar", query("kar"));
        set("int", query("int"));
        set("dex", query("dex"));
        set("spi", query("spi"));
        set("str", query("str"));
        set("cor", query("cor"));
        set("gender", query("gender"));
        set_name(query("name"), ({ query("id") }));
        setup();
        save();
        set_heart_beat(1);
    }
    carry_object("/clone/cloth/cloth")->wear();
}

void update_age() {
    if (!environment()) {
        return;
    }
    if (environment(this_object())->query("chat_room")) {
        last_age_set = time();
        return;
    }
    if (!last_age_set) {
        last_age_set = time();
    }
    add("mud_age", time() - last_age_set);
    last_age_set = time();
    set("age", query("age_modify") + 1 + query("mud_age") / 86400);
}

void init() {
    mixed v1;
    if (interactive(v1 = this_player())) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
    add_action("do_name", "name");
    add_action("do_try", "try");
    add_action("do_let", "let");
    add_action("do_bao", "bao");
    add_action("do_babysave", "babysave");
    add_action("do_ask", "ask");
    add_action("do_babynick", "babynick");
    add_action("do_babytitle", "babytitle");
}

void greeting(mixed arg) {
    mixed v1;
    v1 = this_object();
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (arg->query("name") == v1->query("father_name")) {
        say(v1->name() + "抬起头，天真的望了" + arg->query("name") + "一眼，甜甜的叫道：爹！爹！\n");
        command("cat " + arg->query("id"));
        return;
    } else if (arg->query("name") == v1->query("mather_name")) {
        say(v1->name() + "抬起头，天真的望了" + arg->query("name") + "一眼，甜甜的叫道：娘！娘\n");
        command("cat " + arg->query("id"));
        return;
    }
}

int do_bao(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!id(arg)) {
        return 0;
    }
    if (environment(v1) != environment()) {
        return 0;
    }
    if (environment(this_object()) == v1) {
        return notify_fail("孩子不正在你的身上吗？\n");
    }
    message_vision("$N一把将$n抱了起来，$n「呵呵」的甜甜一笑。\n", this_player(), this_object());
    if (v1->query("id") == this_object()->query("father_id")) {
        message_vision("\e[1;35m$n甜甜一笑，给了$N轻轻的一个吻，亲切的叫了声：爹～～。\n\e[2;37;0m", v1, this_object());
    } else if (v1->query("id") == this_object()->query("mather_id")) {
        message_vision("\e[1;35m$n象只小猫一般钻到$N怀里撒娇，甜甜的叫了声：娘～～。\n\e[2;37;0m", v1, this_object());
    }
    this_object()->move(this_player());
    return 1;
}

int do_babysave(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->query("id") != this_object()->query("father_id") && v1->query("id") != this_object()->query("mather_id")) {
        return notify_fail("你没有权利将这个孩子进行存档！\n");
    }
    this_object()->save();
    write(this_object()->name() + "存档完毕！\n");
    return 1;
}

int do_babynick(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (v1->query("id") != query("father_id") && v1->query("id") != query("mather_id")) {
        return notify_fail("你没有权利给这个孩子设置绰号。\n");
    }
    if (!arg) {
        return notify_fail("你要给孩子取什么绰号？\n");
    }
    if (sizeof(arg) > 36) {
        return notify_fail("绰号长度太长了，还是想一个简短而响亮的绰号吧！\n");
    }
    if (arg == "none") {
        this_object()->delete("nickname");
        write(this_object()->query("name") + "的绰号删除成功！\n");
        return 1;
    } else {
        this_object()->set("nickname", convert_color(arg) + "\e" + "[2;37;0m");
        write(this_object()->query("name") + "的绰号设置完成！\n");
        return 1;
    }
}

