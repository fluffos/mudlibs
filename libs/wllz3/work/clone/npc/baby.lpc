int heal_up() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_object();
    v2 = this_player();
    if (v2->query("gender") == "男性") {
        v3 = "爹";
    } else {
        v3 = "娘";
    }
    if (random(5) == 2) {
        if (base_name(environment(v1)) != v1->query("startroom") && !present(query("father_id"), environment(v1)) && !present(query("mather_id"), environment(v1)) && environment(v1) && v1->is_character() && environment()) {
            if (environment(v1)->query("id") != v1->query("father_id") && environment(v1)->query("id") != v1->query("mather_id") && environment(v1)->is_character() && living(environment(v1))) {
                "/adm/daemons/channeld"->do_channel(v1, "chat", sprintf("爹、娘，你们在哪里？%s不知道要把我带哪去！", environment(v1)->query("name")));
                return 1;
            } else if (!environment(v1)->is_character() && environment(v1)->query("exits")) {
                command("wuwu");
                command("say 爹、娘，你们在哪里呀？" + query("name") + "迷路了. . . ");
                "/adm/daemons/channeld"->do_channel(v1, "rumor", sprintf("有人发现%s正在%s徘徊，好象已经迷路了。", v1->name(1), environment(v1)->query("short")));
                return 1;
            }
        }
        if (v1->query("food") < 10 || v1->query("water") < 10) {
            command("cry");
            command("say 爹、娘，" + query("name") + "饿了. . . ");
            return 1;
        }
    }
    update_age();
    return ::heal_up() + 1;
}

int accept_object(mixed arg1, mixed arg2) {
    arg1 = this_player();
    command("smile");
    if (arg1->query("name") != this_object()->query("father_name") && arg1->query("name") != this_object()->query("mather_name")) {
        command("answer " + arg1->query("id") + " 多谢" + "/adm/daemons/rankd"->query_close(arg1) + "！");
    } else {
        command("face " + arg1->query("id"));
    }
    return 1;
}

int accept_fight(mixed arg) {
    command("wuwu");
    command("say 爹爹娘亲快来呀，有人欺负我！\n");
    return 0;
}

int do_ask(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    if (!arg || sscanf(arg, "%s about %s", v2, v3) != 2 || v2 != query("id")) {
        return 0;
    }
    message_vision("\e[36m$N向$n打听有关『\e[1;32m" + v3 + "\e" + "[2;37;0m" + "\e" + "[36m』的消息。\n\e" + "[2;37;0m", v1, this_object());
    if (v3 == "你爸爸" || v3 == "你爹" || v3 == "你爸爸是谁？" || v3 == "你爸？") {
        command("smile " + v1->query("id"));
        command("answer " + v1->query("id") + " 我爹就是大名鼎鼎的" + query("father_name") + "了！我爹的武功好棒的哦！");
        return 1;
    }
    if (v3 == "你妈妈" || v3 == "你娘" || v3 == "你妈妈是谁？" || v3 == "你娘？") {
        command("xixi " + v1->query("id"));
        command("answer " + v1->query("id") + " 我娘就是" + query("mather_name") + "呀！我娘对我可好了。");
        return 1;
    }
    if (v3 == "你是谁生的？" || v3 == "你是谁的孩子？" || v3 == "谁家的孩子") {
        command("?");
        command("answer " + v1->query("id") + " 我是" + query("father_name") + "和" + query("mather_name") + "的孩子呀！");
        return 1;
    }
    if (v3 == "你多大？" || v3 == "多大？" || v3 == "几岁？" || v3 == "你今年几岁？") {
        command("think");
        command("answer " + v1->query("id") + " 我今年已经" + chinese_number(query("mud_age") / 86400 + 1) + "岁了！");
        return 1;
    }
    if (v3 == "性别") {
        if (query("gender") == "男性") {
            command("answer " + v1->query("id") + " 我是男孩子啊，你看不出来吗？");
        } else {
            command("answer " + v1->query("id") + " 我是女孩子，你看不出来吗？");
        }
        return 1;
    }
    if (v3 == "你家在哪？" || v3 == "你家呢？" || v3 == "家在哪？") {
        command("answer " + v1->query("id") + " 我不告诉你！");
        command("face");
        return 1;
    }
    if (v3 == "叫爸爸！" || v3 == "叫爹？" || v3 == "叫爹") {
        if (v1->query("id") != query("father_id") && v1->query("id") != query("mather_id")) {
            if (v1->query("gender") != "女性") {
                command("answer " + v1->query("id") + " 叔叔，你很喜欢做我爸爸吗？");
                return 1;
            } else {
                command("answer " + v1->query("id") + " 叔叔，你为什么对爸爸那么感兴趣？");
                return 1;
            }
        } else if (v1->query("id") == query("mather_id")) {
            command("?");
            command("answer " + v1->query("id") + " 娘，你为什么要我管你叫爹呢？");
            return 1;
        }
        command("answer " + v1->query("id") + " 爹！");
        return 1;
    }
    if (v3 == "叫妈妈！" || v3 == "叫娘？" || v3 == "叫娘") {
        if (v1->query("id") != query("mather_id") && v1->query("id") != query("father_id")) {
            if (v1->query("gender") != "男性") {
                command("answer " + v1->query("id") + " 阿姨，你很喜欢做我妈妈吗？");
                return 1;
            } else {
                command("answer " + v1->query("id") + " 叔叔，你为什么对我娘那么感兴趣？");
                return 1;
            }
        } else if (v1->query("id") == query("father_id")) {
            command("?");
            command("answer " + v1->query("id") + " 爹，你为什么要我管你叫娘呢？");
            return 1;
        }
        command("answer " + v1->query("id") + " 娘！");
        return 1;
    }
    if (v3 == "叫舅舅" || v3 == "叫叔叔" || v3 == "叫伯伯") {
        if (v1->query("id") == query("father_id")) {
            command("answer " + v1->query("id") + " 爸爸，你不要我了吗？");
        } else if (v1->query("id") == query("mather_id")) {
            command("answer " + v1->query("id") + " 妈妈，你这是怎么了？为什么要我" + v3 + "？");
        } else if (v1->query("gender") == "女性") {
            command("answer " + v1->query("id") + " 阿姨，你为什么要我" + v3 + "呢？");
        } else {
            v4 = v3;
            v4 = replace_string(v4, "叫", "");
            command("bow");
            command("answer " + v1->query("id") + " " + v4 + "好呀！");
        }
        return 1;
    }
    if (v3 == "叫阿姨" || v3 == "叫婶婶" || v3 == "叫姑姑") {
        if (v1->query("id") == query("mather_id")) {
            command("answer " + v1->query("id") + " 娘，你不要我了吗？");
        } else if (v1->query("id") == query("father_id")) {
            command("answer " + v1->query("id") + " 爸爸，你这是怎么了？为什么要我" + v3 + "？");
        } else if (v1->query("gender") != "女性") {
            command("answer " + v1->query("id") + " 叔叔，你为什么要我" + v3 + "呢？");
        } else {
            v4 = v3;
            v4 = replace_string(v4, "叫", "");
            command("bow");
            command("answer " + v1->query("id") + " " + v4 + "好呀！");
        }
        return 1;
    }
}

int do_try(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    v2 = this_object();
    if (v2->query("father_id") != v1->query("id") && v2->query("mather_id") != v1->query("id")) {
        return notify_fail("你只能带自己的孩子出去。\n");
    }
    if (!id(arg)) {
        return notify_fail("你只能带自己的孩子出去玩。\n");
    }
    if (v2->query_temp("sleeping")) {
        return notify_fail("你没见孩子睡着了吗？\n");
    }
    if (!environment() || !present(this_object(), environment(v1))) {
        return notify_fail("孩子都不知道跑哪里去了，还不快去找找？\n");
    }
    if (v1->query("gender") == "男性") {
        v3 = "爹";
    } else {
        v3 = "娘";
    }
    message_vision("$N说道：宝宝乖，" + v3 + "带你出去玩哦！\n", v1);
    message_vision("$N高兴的跳了起来，笑道：好呀！" + v3 + "真好。\n", v2);
    message_vision("$N牵着$n的小手，决定带$n出去逛逛街，$n乐得露出了两个小酒窝。\n", v1, v2);
    v2->set_leader(v1);
    return 1;
}

int do_let(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_object();
    v1 = this_player();
    if (v2->query("father_id") != v1->query("id") && v2->query("mather_id") != v1->query("id")) {
        return notify_fail("你只能控制你的孩子的一切行动。\n");
    }
    if (!present(v2, environment(v1))) {
        return notify_fail("你的孩子已经不知道跑哪里去了。\n");
    }
    if (!arg || arg == "") {
        return notify_fail("你要你的孩子做什么动作？\n");
    }
    command(arg);
    return 1;
}

void afterdie_func(mixed arg) {
    mixed v1;
    if (arg) {
        "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s和%s的孩子%s，被%s杀死了。", query("father_name"), query("mather_name"), query("name"), arg->name(1)));
    } else {
        "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s和%s的孩子%s不幸夭折了。", query("father_name"), query("mather_name"), query("name")));
    }
    if (objectp(v1 = find_player(query("mather_id")))) {
        v1->set("baby/die", 1);
        v1->save();
        tell_object(v1, sprintf("\e[1;33m一阵撕心裂肺的伤感袭上心头，你的孩子%s%s了！\n\e[2;37;0m", query("name"), objectp(arg) ? "被" + arg->name(1) + "杀死" : "不幸夭折"));
    }
    if (objectp(v1 = find_player(query("father_id")))) {
        tell_object(v1, sprintf("\e[1;33m一阵撕心裂肺的伤感袭上心头，你的孩子%s%s了！\n\e[2;37;0m", query("name"), objectp(arg) ? "被" + arg->name(1) + "杀死" : "不幸夭折"));
    }
    rm(this_object()->query_save_file());
}

void reset() {
    save();
}
