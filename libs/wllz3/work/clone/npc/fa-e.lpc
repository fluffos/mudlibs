        return 1;
    }
    if (!present(arg2, environment())) {
        return 1;
    }
    if (query("qi") * 100 / v1 <= 30) {
        command("say 佩服佩服，看来我的担子可以交卸了，恭喜你成为武林罚恶使者！");
        command("chat 哈哈哈，到底是长江後浪推前浪，一代新人换旧人！");
