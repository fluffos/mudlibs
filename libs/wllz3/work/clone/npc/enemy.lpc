int heal_up() {
    mixed v1;
    if (!(v1 = environment(this_object()))) {
        return 0;
    }
    if (!is_fighting() && time() >= query("back_time")) {
        call_out("leave", 1);
        return 1;
    }
    if (v1->query("no_fight")) {
        random_move();
    }
    return ::heal_up() + 1;
}

int create_form_who(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!arg1 || !environment(arg1)) {
        return 0;
    }
    v2 = arg1->query("level");
    switch (arg2) {
    case "easy":
        set("level", v2 / 2);
        break;
    case "median":
        set("level", v2);
        break;
    case "hard":
        set("level", v2 + 10);
        break;
    default:
        set("level", v2 + 5);
        break;
    }
    if (random(10) == 5) {
        create_family(arg1->query("family/family_name"), random(5) + 3, "弟子");
    } else {
        v1 = "/adm/daemons/npcd"->random_family();
        create_family(v1, random(5) + 3, "弟子");
    }
    set("back_time", time() + 280);
    set("killer", arg1->name(1));
    set_temp("apply/attack", arg1->query_dex());
    set_temp("apply/defense", arg1->query_dex() / 2);
    if (arg1->query("family/family_name") == "唐门") {
        set_temp("apply/dodge", arg1->query_int());
    } else {
        set_temp("apply/dodge", arg1->query_str());
    }
    "/adm/daemons/npcd"->full_init(this_object());
    return 1;
}

void leave() {
    message("vision", name() + "急急忙忙地走开了。\n", environment(), this_object());
    destruct(this_object());
}
