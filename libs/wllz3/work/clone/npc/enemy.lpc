int set_title(mixed arg) {
    if (arg->is_good()) {
        set("shen_type", -1);
    } else if (arg->is_bad()) {
        set("shen_type", 1);
    } else {
        set("shen_type", 0);
    }
    set("title", titles[random(sizeof(titles))]);
    return 1;
}

