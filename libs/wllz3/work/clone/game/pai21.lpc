int c21(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v3 = 0;
    v4 = 0;
    for (v1 = 0; v1 < arg[0]; v1++) {
        v2 = pai_number(arg[v1 + 1]);
        if (v2 == 14) {
            v4++;
            v2 = 11;
        } else {
            v2 = v2 > 10 ? 10 : v2;
        }
        v3 += v2;
    }
    while (v3 > 21 && v4 > 0) {
        v3 -= 10;
        v4--;
    }
    return v3;
}

