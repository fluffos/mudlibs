int pick_out() {
    mixed v1;
    mixed v2;
    if (remain > 0) {
        remain--;
        v1 = remain;
        v2 = pai_on_desk[v1];
        pai_on_desk[v1] = -1;
        return v2;
    } else {
        msg(0, 0, "没有牌了");
        return -1;
    }
}

int pick_in(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = player_hand[arg1];
    v1 = v2[0];
    v1++;
    v2[v1] = arg2;
    v2[0]++;
    return 1;
}

object get_player(mixed arg) {
    if (stringp(player[arg])) {
        return find_player(arg);
    }
}

int is_playing(mixed arg) {
    mixed v2;
    v2 = arg->query("id");
    if (stringp(player[v2])) {
        return 1;
    }
    return 0;
}

int sizeof_pai(mixed arg) {
