int do_reset(mixed arg) {
    if (arg == "counter") {
        if (!is_playing(this_player())) {
            return notify_fail("你都不玩牌啊！\n");
        }
        msg(this_player(), 0, "$N复位计数器了。\n");
        counter = ([ ]);
        return 1;
    }
    if (!this_object()->id(arg)) {
        return 0;
    }
    return reset_all();
}

int do_restart(mixed arg) {
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩，开始什么啊！\n");
    }
    if (!has_start) {
        return notify_fail("游戏还没有开始。\n");
    }
    if (sizeof(player)) {
        msg(this_player(), 0, "$N开始新的一轮牌局了。\n\n");
    }
    reset_pai();
    restore_player_data();
    msg(0, 0, "在开始游戏之前(play)，请各位洗牌(xipai)。\n");
    return 1;
}

int do_join(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (has_start) {
        return notify_fail("牌局已经开始，不能加入了。\n");
    }
    if (is_playing(v1)) {
        return notify_fail("你已经参加了。\n");
    }
    player[v1->query("id")] = "yes";
    player_hand[v1->query("id")] = allocate(52);
    msg(v1, 0, "$N加入牌局了。\n");
    return 1;
}

int do_start(mixed arg) {
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩，开始什么啊！\n");
    }
    if (has_start) {
        return notify_fail("牌局已经开始了。\n");
    }
    has_start = 1;
    msg(this_player(), 0, "$N开始了牌局。\n\n");
    auto_order();
    msg(0, 0, "在开始游戏之前(play)，请各位洗牌(xipai)。\n");
    return 1;
}

int do_xipai(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩，洗什么牌啊！\n");
    }
    v6 = pai_on_desk;
    v2 = remain;
    v3 = v2;
    for (v1 = 0; v1 < v2; v1++) {
        v4 = random(v3);
        v5 = v6[v3 - 1];
        v6[v3 - 1] = v6[v4];
        v6[v4] = v5;
        v3--;
    }
    msg(this_player(), 0, "$N洗了洗桌面的牌。\n");
    return 1;
}

int do_chupai(mixed arg) {
    mixed v2;
    mixed v4;
    mixed v6;
    mixed v7;
    mixed v9;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!who_play) {
        who_play = this_player()->query("id");
    }
    if (who_play != this_player()->query("id")) {
        return notify_fail("还没有轮到到你啊。\n");
    }
    v4 = 0;
    if ((v6 = pick_out()) == -1) {
        return 0;
    }
    if (!pick_in(this_player()->query("id"), v6)) {
        return 0;
    }
    msg(this_player(), 0, "$N摸了一张" + id_to_pai(v6) + "。\n");
    v4 = 1;
    v7 = player_hand[this_player()->query("id")];
    v2 = c21(v7);
    msg(this_player(), 0, "$N手上有\e[1;33m" + v2 + "点\e" + "[2;37;0m了。\n");
    if (v2 > 21) {
        do_pass("\e[1;31m爆了！！！\e[2;37;0m\n");
        return 1;
    }
    v9 = get_player(player[who_play]);
    if (v9) {
        who_play = player[who_play];
        do_nextone("");
    }
    return 1;
}

int do_view(mixed arg) {
    mixed v1;
    mixed v2;
    if (arg == "" || !arg) {
        arg = this_player()->query("id");
    } else {
        v2 = arg;
    }
    v1 = player_hand[arg];
    if (!v1) {
        return notify_fail("牌局没有这个玩家。\n");
    }
    if (v2) {
        write(v2 + "：");
    }
    write(view_pai(arg) + "\n");
    return 1;
}

