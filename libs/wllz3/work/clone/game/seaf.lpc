                v5 = v12[v1][4];
                fire_x[0] = v4;
                fire_y[0] = v5;
                v12[v1][3] = 0;
                v12[v1][4] = 0;
                v15[v4 - 1][v5 - 1][1] = 1;
                v3 = which_ship(v13, v4, v5);
                v6 = 1;
            }
            if (!v13[v1][0] && v13[v1][3]) {
                v4 = v13[v1][3];
                v5 = v13[v1][4];
                fire_x[1] = v4;
                fire_y[1] = v5;
                v13[v1][3] = 0;
                v13[v1][4] = 0;
                v14[v4 - 1][v5 - 1][1] = 1;
                v2 = which_ship(v12, v4, v5);
                v6 = 1;
            }
            if (v2 >= 0) {
                v11 = "\e[5m\e[1;33m" + v9 + "的船被击沉了。\n\e" + "[2;37;0m";
                v12[v2][0] = 1;
                if (v12[v2][3]) {
                    v4 = v12[v2][3];
                    v5 = v12[v2][4];
                    v12[v2][3] = 0;
                    v12[v2][4] = 0;
                    v15[v4 - 1][v5 - 1][1] = v12[v2][5];
                }
            }
            if (v3 >= 0) {
                if (!v11) {
                    v11 = "";
                }
                v11 = v11 + "\e" + "[5m\e" + "[1;33m" + v10 + "的船被击沉了。\n\e" + "[2;37;0m";
                v13[v3][0] = 1;
                if (v13[v3][3]) {
                    v4 = v13[v3][3];
                    v5 = v13[v3][4];
                    v13[v3][3] = 0;
                    v13[v3][4] = 0;
                    v14[v4 - 1][v5 - 1][1] = v13[v3][5];
                }
            }
            if (v6) {
                break;
            }
        }
    }
    if (v6) {
        msg(0, 0, "\e[5m\e[1;31m\n~~~~~ 攻击！！ ~~~~~\n\e[2;37;0m");
        if (v11) {
            msg(0, 0, v11);
        }
        display(0);
        remove_call_out("fire_it");
        call_out("fire_it", 4);
    } else {
        v7 = 0;
        v8 = 0;
        for (v1 = 0; v1 < 10; v1++) {
            if (!v12[v1][0]) {
                v7++;
            }
            if (!v13[v1][0]) {
                v8++;
            }
        }
        if (!v7 || !v8) {
            game_mode = 3;
            if (!v7) {
                if (!v8) {
                    who_win = -1;
                } else {
                    who_win = 1;
                }
            } else {
                who_win = 2;
            }
            display(0);
            msg(0, 0, "\e[1;31m\n\n 所有战斗结束了，使用(start)重新开始。\n\e[2;37;0m");
        } else {
            msg(0, 0, sprintf("\e[1;36m\n该回合攻击结束...\n%s(%d) VS %s(%d)\n\e[2;37;0m", v9, remain_ship(v9), v10, remain_ship(v10)));
            before_fire();
        }
    }
}

int do_visitor(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    if (!arg) {
        return notify_fail("visit [-]玩家ID\n");
    }
    if (sscanf(arg, "-d %s", v1) == 1) {
        v4 = 1;
    } else {
        v4 = 0;
        v1 = arg;
    }
    v2 = this_player();
    if (is_playing(v2)) {
        v3 = present(v1, environment(this_object()));
        if (!v3) {
            return notify_fail("这里没有这个玩家啊？\n");
        }
        if (v4) {
            if (!is_visitor(v3, v2->query("id"))) {
                return notify_fail("不是你的观战者了。\n");
            }
            msg(v2, v3, "$N不再允许$n观看$N的战况。\n");
            visitor[v2->query("id")] = visitor[v2->query("id")] - ({ v3->query("id") });
        } else {
            if (is_visitor(v3, v2->query("id"))) {
                return notify_fail("已经是你的观战者了。\n");
            }
            msg(v2, v3, "$N让$n观看$N的战况。\n");
            if (!visitor[v2->query("id")]) {
                visitor[v2->query("id")] = ({ v3->query("id") });
            } else {
                visitor[v2->query("id")] += v3->query("id");
            }
        }
    } else {
        if (v4) {
            return notify_fail("？？？？\n");
        }
        v3 = get_player(v1);
        if (!v3) {
            return notify_fail("没有这个玩家在玩啊？\n");
        }
        msg(v2, v3, "$N希望成为$n的观战者。\n");
        tell_object(v3, "接受使用[visit " + v2->query("id") + "]。\n");
    }
    return 1;
}

int do_rplace(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_start || game_mode != 0) {
        return notify_fail("现在不是布置船只的时候。\n");
    }
    v4 = get_ship(this_player()->query("id"));
    v5 = get_table(this_player()->query("id"));
    for (v1 = 0; v1 < 10; v1++) {
        if (!v4 || !v5) {
            return notify_fail("access date fail\n");
        }
        if (!v4[v1][1]) {
            v2 = random(9) + 1;
            v3 = random(9) + 1;
            if (v5[v2 - 1][v3 - 1][0] != 1) {
                v4[v1][1] = v2;
                v4[v1][2] = v3;
                v5[v2 - 1][v3 - 1][0] = 1;
            }
        }
    }
    display(player_id(this_player()->query("id")));
    return 1;
}

int do_help(mixed arg) {
    this_player()->start_more("海战棋使用方法:\r\n——[开始游戏]———————————————\r\n帮助命令：helpboard\r\n加入命令：join　　　　　加入游戏\r\n开始命令：start 　　　　开始游戏\r\n重置命令：reset board 　结束游戏\r\n\r\n——[船只布置]———————————————\r\n放置船只：place X坐标 Y坐标\r\n取消放置：unplace X坐标 Y坐标\r\n随机放置：rplace\r\n放置结束：finish\r\n\r\n——[火力布置]———————————————\r\n放置火力：fire X坐标 Y坐标\r\n取消放置：unfire X坐标 Y坐标\r\n放置结束：finish\r\n\r\n——[观战命令]———————————————\r\n观战命令：visit [-d] 玩家ID\r\n\t\t邀请其它玩家观看你的游戏"
            "。\r\n\t\t加参数 -d 表示删除该玩家的观看资格。\r\n\r\n——[游戏规则]———————————————\r\n该游戏是两人游戏。\r\n分为准备和战斗阶段两个阶段。\r\n\r\n在准备阶段，各人把自己的船放置于自己的\r\n棋盘上。当各人都准备好以后，进入战斗阶\r\n段。\r\n\r\n在战斗阶段，各人决定攻击的位置。每一艘\r\n船有 1次攻击机会。在完成攻击设置以后，\r\n进入战斗状态。系统根据双方的攻击设置进\r\n行攻击，当攻击位置上有敌方船，则可以把\r\n对方该船击毁。被击毁的船丧失攻击能力。\r\n\r\n在所有攻击结束以后，重新进入攻击设置。\r\n如此循环，直到一方的船全部被击毁。\r\n\r\n游戏开始时候，每人有10艘船。\r\n最后谁的船最先" "被全部消灭掉，谁为输者。\r\n\r\n——————————————————————\r\n\t\t\tmake by 猫部猫(Catyboy) v1.0\r\n");
    return 1;
}
