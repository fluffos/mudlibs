void create() {
    set_name("海战棋", ({ "sea board", "board", "seaf" }));
    set_weight(1);
    if (clonep()) {
        set_default_object("/clone/game/seaf.lpc");
    } else {
        set("unit", "副");
        set("long", "这是一副海战棋，使用方法请使用(helpboard)命令。\n");
        set("value", 1);
        set("material", "wood");
    }
    reset_game(1);
    setup();
}

