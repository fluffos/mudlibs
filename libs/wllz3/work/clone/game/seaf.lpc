    v4 += "　１２３４５６７８９　　　１２３４５６７８９\n";
    for (v6 = 0; v6 < 9; v6++) {
        v4 = v4 + numbers[v6 + 1];
        for (v5 = 0; v5 < 9; v5++) {
            v3 = v1[v5][v6];
            if (game_mode == 2 && v5 == fire_x[v8] - 1 && v6 == fire_y[v8] - 1) {
                v4 += "\e[5m\e[1;33m" + cell_status[v3[0]][v3[1]] + "\e" + "[2;37;0m";
                continue;
            }
            v4 += cell_status[v3[0]][v3[1]];
        }
        v4 = v4 + "　　" + numbers[v6 + 1];
        for (v5 = 0; v5 < 9; v5++) {
            v3 = v2[v5][v6];
            if (game_mode == 2 && v5 == fire_x[v9] - 1 && v6 == fire_y[v9] - 1) {
                v4 += cell_status[v3[0] + 2][v3[1]];
                continue;
            }
            v4 += cell_status[v3[0] + 2][v3[1]];
