        v5 = is_visitor(arg1, arg2);
    }
    if (v5) {
        v1 = build_board(arg2);
        tell_object(arg1, v1);
        return 1;
    }
    return 0;
}

void start_game() {
    has_start = 1;
    game_mode = 0;
    who_win = 0;
    msg(0, 0, "开始游戏\n");
    display(0);
}

int before_fire() {
    game_mode = 1;
    player_action = ([ ]);
    msg(0, 0, "\n\n\e[1;36m！！！进入战备状态！！！\e[2;37;0m\n\n");
    display(0);
}

int start_fire() {
    player_action = ([ ]);
    msg(0, 0, "\n\n\e[1;31m！！！开始战斗状态！！！\e[2;37;0m\n\n");
    game_mode = 2;
    fire_x = ({ 0, 0 });
    fire_y = ({ 0, 0 });
    remove_call_out("fire_it");
    call_out("fire_it", 2);
}

void init() {
    add_action("do_help", "helpboard");
    add_action("do_reset", "reset");
    add_action("do_start", "start");
    add_action("do_join", "join");
    add_action("do_view", "view");
    add_action("do_visitor", "visit");
    add_action("do_finish", "finish");
    add_action("do_place", "place");
