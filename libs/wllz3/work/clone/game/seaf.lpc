                    v3 += "使用[\e[1;33munfire X坐标 Y坐标\e[2;37;0m]取消设置\n";
                    break;
                case 3:
                    v3 = "战斗结束了。\n战况：";
                    if (who_win == -1) {
                        v3 += "和手";
                    } else if (who_win == v4) {
                        v3 += "\e[1;33m胜利了\e[2;37;0m";
                    } else {
                        v3 += "\e[47;1m\e[30m失败了\e[2;37;0m";
                    }
                    break;
                }
