}

int do_reset(mixed arg) {
    if (!this_object()->id(arg)) {
        return 0;
    }
    if (!is_playing(this_player())) {
        if (get_player2(1) || get_player2(2)) {
            return notify_fail("你都不玩啊！\n");
        }
    }
    if (reset_game(1)) {
        msg(this_player(), 0, "$N重置了游戏。\n");
    }
    return 1;
}

int do_start(mixed arg) {
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    reset_game(0);
    start_game();
    return 1;
}

int do_view(mixed arg) {
    if (!is_playing(this_player())) {
        if (!arg) {
            return notify_fail("你都不玩啊！\n");
        }
        if (!is_visitor(this_player(), arg)) {
            return notify_fail("你不能够看" + arg + "的棋，可以使用[visit " + arg + "]命令成为" + arg + "的观众。\n");
        }
    }
    if (!arg) {
        arg = this_player()->query("id");
    }
    if (!view_board(this_player(), arg)) {
        return notify_fail("？？？\n");
    }
    return 1;
}

int do_join(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (has_start) {
        return notify_fail("游戏已经开始，不能加入了，请使用(reset)命令重置。\n");
    }
    if (is_playing(v1)) {
        return notify_fail("你已经参加了。\n");
    }
    player[v1->query("id")] = sizeof(player) + 1;
    msg(v1, 0, "$N加入游戏了。\n");
    if (sizeof(player) == 2) {
        start_game();
    }
    return 1;
}

int do_place(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_start || game_mode != 0) {
        return notify_fail("现在不是布置船只的时候。\n");
    }
    if (!arg || sscanf(arg, "%d %d", v2, v3) != 2) {
        return notify_fail("place X坐标 Y坐标\n");
    }
    if (v2 < 1 || v2 > 9) {
        return notify_fail("X坐标错误\n");
    }
    if (v3 < 1 || v3 > 9) {
        return notify_fail("Y坐标错误\n");
    }
    v6 = this_player()->query("id");
    v4 = get_ship(v6);
    v5 = get_table(v6);
    if (!v4 || !v5) {
        return notify_fail("access date fail\n");
    }
    if (v5[v2 - 1][v3 - 1][0] == 1) {
        return notify_fail("该处已经布置了船只\n");
    }
    for (v1 = 0; v1 < 10; v1++) {
        if (!v4[v1][1]) {
            v4[v1][1] = v2;
            v4[v1][2] = v3;
            v5[v2 - 1][v3 - 1][0] = 1;
            break;
        }
    }
    if (v1 == 10) {
        return notify_fail("你已经没有空余的船只可以布置了。\n");
    } else {
        display(player_id(v6));
        if (!remain_place(v6)) {
            tell_object(this_player(), "\n使用[Finish]结束布置船只。\n");
        }
    }
    return 1;
}

int do_unplace(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    if (game_mode) {
        return notify_fail("现在不是布置船只的时候。\n");
    }
    if (!arg || sscanf(arg, "%d %d", v2, v3) != 2) {
        return notify_fail("unplace X坐标 Y坐标\n");
    }
    if (v2 < 1 || v2 > 9) {
        return notify_fail("X坐标错误\n");
    }
    if (v3 < 1 || v3 > 9) {
        return notify_fail("Y坐标错误\n");
    }
    v4 = get_ship(this_player()->query("id"));
    v5 = get_table(this_player()->query("id"));
    if (!v4 || !v5) {
        return notify_fail("access date fail\n");
    }
    for (v1 = 0; v1 < 10; v1++) {
        if (v4[v1][1] == v2 && v4[v1][2] == v3) {
            v4[v1][1] = 0;
            v4[v1][2] = 0;
            v5[v2 - 1][v3 - 1][0] = 0;
            display(player_id(this_player()->query("id")));
            break;
        }
    }
    if (v1 == 10) {
        return notify_fail("该位置没有布置船只。\n");
    }
    return 1;
}

int do_finish(mixed arg) {
    mixed v4;
    mixed v5;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!(!game_mode || game_mode == 1)) {
        return notify_fail("？？？\n");
    }
    v5 = this_player()->query("id");
    v4 = get_ship(v5);
    if (!v4) {
        return notify_fail("access date fail\n");
    }
    if (!game_mode) {
        if (remain_place(v5)) {
            return notify_fail("还有船只没有布置\n");
        }
    } else if (game_mode == 1) {
        if (remain_fire(v5)) {
            return notify_fail("还有火力没有布置\n");
        }
    }
    if (!game_mode) {
        msg(this_player(), 0, "$N的船只布置完成\n");
    } else if (game_mode == 1) {
        msg(this_player(), 0, "$N的火力布置完成\n");
    }
    player_action[this_player()->query("id")] = 1;
    if (sizeof(player_action) == 2) {
        if (!game_mode) {
            before_fire();
        } else if (game_mode == 1) {
            start_fire();
        }
    }
    return 1;
}

int do_fire(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    if (game_mode != 1) {
        return notify_fail("现在不是布置火力的时候。\n");
    }
    if (!arg || sscanf(arg, "%d %d", v2, v3) != 2) {
        return notify_fail("place X坐标 Y坐标\n");
    }
    if (v2 < 1 || v2 > 9) {
        return notify_fail("X坐标错误\n");
    }
    if (v3 < 1 || v3 > 9) {
        return notify_fail("Y坐标错误\n");
    }
    v6 = this_player()->query("id");
    v4 = get_ship(v6);
    v5 = get_table(enemy_id(v6));
    if (!v4 || !v5) {
        return notify_fail("access date fail\n");
    }
    if (v5[v2 - 1][v3 - 1][1]) {
        return notify_fail("该处已经布置了火力\n");
    }
    for (v1 = 0; v1 < 10; v1++) {
        if (!v4[v1][0] && !v4[v1][3]) {
            v4[v1][3] = v2;
            v4[v1][4] = v3;
            v4[v1][5] = v5[v2 - 1][v3 - 1][1];
            v5[v2 - 1][v3 - 1][1] = 2;
            break;
        }
    }
    if (v1 == 10) {
        return notify_fail("你已经没有空余的火力可以布置了。\n");
    } else {
        display(player_id(v6));
        if (v1 + 1 == 10) {
            tell_object(this_player(), "\n使用[Finish]结束布置火力。\n");
        }
    }
    return 1;
}

