            return msg(0, 0, "有玩家缺场了，请重新开始游戏(reset qi)。\n");
        }
        if (v2 != v1) {
            msg(v2, v1, "$N对$n说道：到你了。\n");
        } else {
            msg(v2, 0, "$N对自己说道：到我啦！\n");
        }
    } else {
        v1 = get_cur_player();
        msg(0, v1, "到$n了。\n");
    }
    return 1;
}

void next_one() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = 0;
    if (cur_se == 6) {
        v3 = cur_player;
    } else {
        v3 = cur_player < 4 ? cur_player + 1 : 1;
    }
    cur_se = 0;
    cur_qi = 0;
    shadow_qi = 0;
    has_jump = 0;
    v2 = 0;
    for (v2 = 0; v2 < 4; v2++) {
        for (v1 = 0; v1 < 4; v1++) {
            if (qizi[v3 - 1][v1][0] != 3) {
                if (v3 == cur_player) {
                    msg(get_cur_player(), 0, "$N投到六点，奖励一次。\n");
                } else {
                    cur_player = v3;
                    do_next("");
                }
                return;
            }
        }
        v3 = v3 < 4 ? v3 + 1 : 1;
    }
}

int toss(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v6 = cur_player;
    v1 = build_qi(arg1);
    v7 = 0;
    for (v5 = 0; v5 < 4; v5++) {
        switch (qizi[v6 - 1][v5][0]) {
        case 0:
            if (member_array(arg2, wake_point) != -1) {
                if (v3) {
                    v3 = sprintf("%s|%c", v3, v5 + 97);
                } else {
                    v3 = sprintf("出机 move %c", v5 + 97);
                }
                v7 = 1;
            }
            break;
        case 1:
        case 2:
        case 4:
            if (v4) {
                v4 = sprintf("%s|%c", v4, v5 + 97);
            } else {
                v4 = sprintf("移动 move %c", v5 + 97);
            }
            v7 = 1;
            break;
        case 3:
            break;
        default:
            msg(0, 0, "\n错误飞机状态！！！\n");
            break;
        }
    }
    v2 = sprintf("%d点\n", arg2);
    if (v3) {
        v2 = sprintf("%s%s\n", v2, v3);
    }
    if (v4) {
        v2 = sprintf("%s%s\n", v2, v4);
    }
    if (v7) {
        tell_object(arg1, v1);
        tell_object(arg1, v2);
    } else {
        next_one();
    }
    return 1;
}

int do_toss(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_player();
    if (!(v2 = is_playing(v3))) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_start) {
        return notify_fail("游戏还没有开始了。\n");
    }
    if (cur_se) {
        return notify_fail("不是投色子的时候。\n");
    }
    if (!cur_player || v3->query("id") != player[cur_player - 1]) {
        return notify_fail("还没有开始到你了。\n");
    }
    msg(v3, 0, "$N拿起色子在手中摇了两摇。\n");
    v1 = random(6) + 1;
    show_se(v1);
    cur_se = v1;
    toss(v3, v1);
    return 1;
}

string extra_long() {
    mixed v1;
    mixed v3;
    v1 = this_player();
    v3 = "\n" + build_qi(v1);
    return v3;
}

int do_reset(mixed arg) {
    if (!this_object()->id(arg)) {
        return 0;
    }
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    reset_game(1);
    msg(this_player(), 0, "$N重置了游戏。\n");
    return 1;
}

int do_start(mixed arg) {
    mixed v1;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    for (v1 = 0; v1 < sizeof(player); v1++) {
        if (!player[v1]) {
            break;
        }
    }
    switch (v1) {
    case 2:
        player[2] = player[0];
        player[3] = player[1];
        break;
    case 4:
        break;
    default:
        return notify_fail("游戏人数只能是2人 或者 4人。\n");
        break;
    }
    reset_game(0);
    has_start = 1;
    cur_player = 1;
    msg(this_player(), 0, "$N开始游戏了\n");
    msg(get_cur_player(), 0, "$N首先投色。\n");
    return 1;
}

int do_view(mixed arg) {
    write(build_qi(this_player()));
    return 1;
}

int do_join(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (has_start) {
        return notify_fail("游戏已经开始，不能加入了，请使用(reset)命令重置。\n");
    }
    if (is_playing(v2)) {
        return notify_fail("你已经参加了。\n");
    }
    for (v1 = 0; v1 < sizeof(player); v1++) {
        if (!player[v1]) {
            player[v1] = v2->query("id");
            msg(v2, 0, "$N加入游戏了。\n");
            if (v1 == 3) {
                msg(0, 0, "请使用(start)命令开始游戏。\n");
            }
            return 1;
        }
    }
    return notify_fail("人数已满\n");
}

void show_qi() {
    mixed v1;
    v1 = build_qi(0);
    msg(0, 0, "\n\n" + v1);
}

void put_down(mixed arg) {
    mixed v1;
    v1 = qi2ge(arg);
    if (v1) {
        v1[3] = arg[3];
        v1[4] = arg[4];
    }
}

void pick_out(mixed arg) {
    mixed v1;
    v1 = qi2ge(arg);
    if (v1 && v1[3] == arg[3] && v1[4] == arg[4]) {
        v1[3] = 0;
        v1[4] = 0;
    }
}

int check_finish() {
    mixed v1;
    mixed v2;
    for (v1 = 0; v1 < 4; v1++) {
        for (v2 = 0; v2 < 4; v2++) {
            if (qizi[v1][v2][0] != 3) {
                return 0;
            }
        }
    }
    return 1;
}

int reach(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = qi2ge(arg);
    if (v1[3]) {
        if (v1[3] == arg[3]) {
            msg(get_cur_player(), 0, "$N和自己的飞机相遇，前进一步。\n");
            call_out("jump_to", 0, arg, 1);
            return 1;
        } else {
            v2 = ge2qi(v1);
            msg(get_cur_player(), qi2player(v2), "\e[5m\e[1;31m\n$N击毁了$n的飞机！！！\n\n\e[2;37;0m");
            return_base(v2[3], v2[4]);
        }
    } else {
        switch (v1[2]) {
        case 0:
            if (arg[3] == v1[0] && !has_jump) {
                msg(get_cur_player(), 0, "$N的飞机进行跳跃...\n");
                call_out("jump_to", 0, arg, 4);
                return 1;
            }
            break;
        case 3:
            if (arg[3] == v1[0] && !has_jump) {
                msg(get_cur_player(), 0, "\e[1;33m\n$N的飞机进行超级跳跃！\n");
                v2 = ge2qi(v1);
                if (v2) {
                    msg(get_cur_player(), qi2player(v2), "\e[5m\e[1;31m\n$N击毁了$n的飞机！！！\n\n\e[2;37;0m");
                    return_base(v2[3], v2[4]);
                }
                call_out("jump_to", 0, arg, 12);
                return 1;
            }
            break;
        case 4:
            msg(get_cur_player(), 0, "$N的一架飞机到终点了。\n");
            return_base(arg[3], arg[4]);
            arg[0] = 3;
            if (check_finish()) {
                return 1;
            }
            next_one();
            return 1;
        default:
            break;
        }
    }
    put_down(arg);
    next_one();
    return 1;
}

int jump_to(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    has_jump = 1;
    for (v1 = 0; v1 < arg2; v1++) {
        v5 = qi2ge(arg1);
        v4 = v5[1];
        v2 = 0;
        v3 = 0;
        if (v4 & 1) {
            v2--;
        }
        if (v4 & 2) {
            v2++;
        }
        if (v4 & 4) {
            v3--;
        }
        if (v4 & 8) {
            v3++;
        }
        arg1[1] += v2;
        arg1[2] += v3;
    }
    show_qi();
    reach(arg1);
    return 1;
}

int move_qi(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    switch (arg1[0]) {
    case 0:
        if (member_array(arg2, wake_point) == -1) {
            return notify_fail("不能移动该棋子。\n");
        }
        arg1[0] = 1;
        pick_out(arg1);
        v7 = arg1[3];
        for (v1 = 0; v1 < 4; v1++) {
            v2 = player_ready[v7 - 1][v1][0];
            v3 = player_ready[v7 - 1][v1][1];
            if (!board[v3][v2][3]) {
                arg1[1] = v2;
                arg1[2] = v3;
                v1 = 5;
            }
        }
        put_down(arg1);
        msg(get_cur_player(), 0, "$N准备出动一架飞机。\n");
        next_one();
        return 1;
    case 1:
        arg2--;
        v2 = player_start[cur_player - 1][0];
        v3 = player_start[cur_player - 1][1];
        pick_out(arg1);
        arg1[0] = 2;
        arg1[1] = v2;
        arg1[2] = v3;
        if (!arg2) {
            show_qi();
            reach(arg1);
        } else if (!move_qi(arg1, arg2)) {
            return 0;
        }
        break;
    case 2:
        pick_out(arg1);
        arg2--;
        v8 = qi2ge(arg1);
        if (v8[2] == 1 && arg1[3] == v8[0]) {
            switch (v8[0]) {
            case 1:
                v6 = 1;
                break;
            case 2:
                v6 = 4;
                break;
            case 3:
                v6 = 2;
                break;
            case 4:
                v6 = 8;
                break;
            }
        } else {
            v6 = v8[1];
        }
        v4 = 0;
        v5 = 0;
        if (v6 & 1) {
            v4--;
        }
        if (v6 & 2) {
            v4++;
        }
        if (v6 & 4) {
            v5--;
        }
        if (v6 & 8) {
            v5++;
        }
        arg1[1] += v4;
        arg1[2] += v5;
        v8 = qi2ge(arg1);
        if (!arg2) {
            show_qi();
            reach(arg1);
        } else {
            if (v8[2] == 4) {
                arg1[0] = 4;
            }
            if (!move_qi(arg1, arg2)) {
                return 0;
            }
        }
        break;
    case 4:
        v8 = qi2ge(arg1);
        v6 = v8[1];
        v4 = 0;
        v5 = 0;
        if (v6 & 1) {
            v4--;
        }
        if (v6 & 2) {
            v4++;
        }
        if (v6 & 4) {
            v5--;
        }
        if (v6 & 8) {
            v5++;
        }
        arg1[1] -= v4;
        arg1[2] -= v5;
        arg2--;
        if (!arg2) {
            arg1[0] = 2;
            show_qi();
            reach(arg1);
        } else if (!move_qi(arg1, arg2)) {
            return 0;
        }
        break;
    case 3:
        return notify_fail("不能移动该棋子。\n");
    default:
        msg(0, 0, "\n错误飞机状态！！！\n");
        break;
    }
    return 1;
}

int do_move(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v3 = this_player();
    if (!(v1 = is_playing(v3))) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_start) {
        return notify_fail("游戏还没有开始了。\n");
    }
    if (!cur_se) {
        return notify_fail("是投色子的时候。\n");
    }
    if (!cur_player || v3->query("id") != player[cur_player - 1]) {
        return notify_fail("还没有开始到你了。\n");
    }
    if (!arg) {
        return notify_fail("你要移动哪个棋子啊(a|b|c|d)？\n");
    }
    v2 = 0;
    if (arg == "a") {
        v2 = 1;
    }
    if (arg == "b") {
        v2 = 2;
    }
    if (arg == "c") {
        v2 = 3;
    }
    if (arg == "d") {
        v2 = 4;
    }
    if (!v2) {
        return notify_fail("你要移动哪个棋子啊(a|b|c|d)\n");
    }
    v4 = qizi[cur_player - 1][v2 - 1];
    cur_qi = v4;
    shadow_it(v4);
    if (!move_qi(v4, cur_se)) {
        return 0;
    }
    return 1;
}

mixed t(mixed arg1, mixed arg2) {
    return board[arg1][arg2];
}

int do_help(mixed arg) {
    this_player()->start_more("飞行棋使用方法:\r\n——[开始游戏]———————————————\r\n帮助命令：helpqi\r\n加入游戏：join　　　　　\r\n开始游戏：start\r\n重置游戏：reset qi\r\n\r\n——[游戏命令]———————————————\r\n　摇色子：toss\r\n查看情况：view\r\n移动棋子：move a|b|c|d\r\n催促玩家：next\r\n\r\n——[游戏规则]———————————————\r\n普通的飞行棋。\r\n\r\n——————————————————————\r\n");
    return 1;
}
