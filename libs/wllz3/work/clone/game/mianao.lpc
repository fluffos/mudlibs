int move(mixed arg1, mixed arg2) {
    if (!environment(this_object())) {
        return ::move(arg1, arg2);
    }
    if (environment(this_object())->query("id") == "hongdou") {
        if (userp(arg1)) {
            arg1->delete("env");
            tell_object(arg1, "\e[36m呵呵，这可是土豆的贴身宝贝，:PP 怎么能给你呢。*_^  \n\e[2;37;0m");
            return 0;
        } else {
            return 0;
        }
    }
    return ::move(arg1, arg2);
}

