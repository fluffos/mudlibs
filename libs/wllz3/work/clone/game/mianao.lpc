        this_player()->delete_temp("apply/name");
        this_player()->delete_temp("apply/short");
        this_player()->delete_temp("apply/long");
        write("你恢复了本来面目！\n");
        return 1;
    }
    if (!objectp(v1 = present(arg, environment(this_player()))) || !living(v1)) {
        return notify_fail("你想装扮谁？\n");
    }
    write("你开始装扮" + v1->name() + "。 \n");
    this_player()->set_temp("apply/name", ({ v1->name() }));
    this_player()->set_temp("apply/short", ({ v1->short() }));
    this_player()->set_temp("apply/long", ({ v1->long() }));
    return 1;
}

