    add_action("do_history", "history");
}

int do_toss(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    if (!is_playing(v1)) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_start) {
        return notify_fail("游戏还没有开始了。\n");
    }
    if (has_guess) {
        return notify_fail("已经开始猜色子了。\n");
    }
    if (player_toss[v1->query("id")] >= 5) {
        return notify_fail(sprintf("你已经摇过%d次了。\n", 5));
    }
    toss(v1);
    player_toss[v1->query("id")]++;
    msg(v1, 0, "$N拿起色子在手中摇了两摇。\n");
    view_se(v1, 0);
    if (v3 = visitor[v1->query("id")]) {
        for (v4 = 0; v4 < sizeof(v3); v4++) {
            v2 = get_player(v3[v4]);
            if (v2) {
                view_se(v1, v2);
            }
        }
    }
    return 1;
}

int do_reset(mixed arg) {
    mixed v1;
    mixed v2;
    if (!this_object()->id(arg)) {
        return 0;
    }
    if (!is_playing(this_player())) {
        v2 = keys(player);
        for (v1 = 0; v1 < sizeof(v2); v1++) {
            if (get_player(v2[v1])) {
                return notify_fail("你都不玩啊！\n");
            }
        }
    }
    reset_game(1);
    msg(this_player(), 0, "$N重置了游戏。\n");
    return 1;
}

int do_start(mixed arg) {
    mixed v1;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    if (sizeof(player) < 2) {
        return notify_fail("至少要两个人才能玩。\n");
    }
    if (!arg || sscanf(arg, "%d", v1) != 1) {
        v1 = 0;
    } else if (v1 < 1 || v1 > 6) {
        return notify_fail(sprintf("start [色子数目]  *注意* 色子数目必须>1并且<=%d\n", 6));
    }
    start_game(v1);
    return 1;
}

int do_view(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!is_playing(v1)) {
        if (arg && (v2 = get_player(arg))) {
            if (!is_visitor(v1, arg)) {
                v2 = 0;
            }
        }
        if (!v2) {
            return notify_fail("你都不玩啊！\n");
        }
    } else {
        v2 = v1;
    }
    view_se(v2, v1);
    return 1;
}

int do_join(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (has_start) {
        return notify_fail("游戏已经开始，不能加入了，请使用(reset)命令重置。\n");
    }
    if (is_playing(v1)) {
        return notify_fail("你已经参加了。\n");
    }
    player[v1->query("id")] = allocate(se_num);
    toss(v1);
    msg(v1, 0, "$N加入游戏了。\n");
    return 1;
}

int do_next(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!is_playing(v2)) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_guess) {
        return notify_fail("还没有开始猜色子了。\n");
    }
    if (!cur_player) {
        return notify_fail("现在是谁猜啊？\n");
    }
    v1 = get_cur_player();
    if (!v1) {
        return msg(0, 0, "有玩家缺场了，请重新开始游戏(start)。\n");
    }
    if (v2 != v1) {
        msg(v2, v1, "$N对$n说道：到你了。\n");
    } else {
        msg(v2, 0, "对自己说道：到我啦！\n");
    }
    tell_object(v1, for_guess_msg());
    return 1;
}

int do_guess(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v5 = this_player();
    if (!is_playing(v5)) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_guess) {
        return notify_fail("还没有开始猜色子了。\n");
    }
    v4 = get_cur_player();
    if (v4 != v5) {
        return notify_fail("还没有到你猜了。\n");
    }
    if (!arg || sscanf(arg, "%d %d", v1, v2) != 2) {
        return notify_fail("guess 色子数目 色子点数\n");
    }
    if (v1 < sizeof(player) || v2 > 6 || v2 <= 0) {
        return notify_fail(sprintf("色子数目必须>=%d，色子点数必须>0并且<=6\n", sizeof(player)));
    }
    v3 = 1;
    if (last_player) {
        if (v1 > cur_amount) {
            v3 = 1;
        } else if (v1 == cur_amount) {
            if (v2 > cur_point) {
                v3 = 1;
            } else {
                v3 = 0;
            }
        } else {
            v3 = 0;
        }
    }
    if (!v3) {
        return notify_fail("色子数目或者色子点数必须比前一位玩家大。\n");
    }
    last_player = v5->query("id");
    cur_amount = v1;
    cur_point = v2;
    if (v2 == 1) {
        has_guess_one = 1;
    }
    cur_player = player_follow[last_player];
    msg(v5, 0, sprintf("$N(%s)说道：%d个%d\n", v5->query("id"), v1, v2));
    if (history) {
        history = history + ({ sprintf("%-20s：%d个%d", v5->query("name") + "(" + v5->query("id") + ")", v1, v2) });
    } else {
        history = ({ sprintf("%-20s：%d个%d", v5->query("name") + "(" + v5->query("id") + ")", v1, v2) });
    }
    do_next("");
    return 1;
}

void add_counter(mixed arg1, mixed arg2) {
    counter[arg1] = counter[arg1] + arg2;
}

int show_all_se(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    mixed v10;
    mixed v11;
    if (!last_player) {
        return 0;
    }
    v8 = get_player(last_player);
    if (!v8 || !arg) {
        return 0;
    }
    has_guess = 0;
    v1 = keys(player);
    v9 = 0;
    v10 = "";
    for (v3 = 0; v3 < sizeof(v1); v3++) {
        if (get_player(v1[v3])) {
            v2 = player[v1[v3]];
            v10 = sprintf("%s%12s：", v10, v1[v3]);
            v11 = "";
            v6 = 0;
            for (v4 = 0; v4 < se_num; v4++) {
                v10 = sprintf("%s%d", v10, v2[v4]);
                v5 = v2[v4];
                if (v5 == 1 && !has_guess_one) {
                    v5 = cur_point;
                }
                if (v5 == cur_point) {
                    v9++;
                    v6++;
                    v11 = sprintf("%s%d", v11, v2[v4]);
                }
            }
            if (v6 == se_num) {
                v11 = v11 + " 围色+1";
                v9++;
            }
            v10 = v10 + "||" + v11 + "\n";
        }
    }
    v10 = sprintf("%s%s猜有\e[1;36m%d\e[2;37;0m个%d，", v10, v8->query("name"), cur_amount, cur_point);
    v10 = sprintf("%s现在有\e[1;36m%d\e[2;37;0m个%d\n\n", v10, v9, cur_point);
    msg(0, 0, v10);
    if (arg->query("id") == cur_player) {
        v7 = 1;
    } else {
        v7 = 2;
    }
    if (v9 < cur_amount) {
        add_counter(arg->query("id"), v7);
        add_counter(v8->query("id"), -v7);
        msg(v8, arg, "\e[5m\e[1;33m$N被$n拆穿了大话！！！\n\n\e[2;37;0m");
        who_lost = last_player;
    } else {
        add_counter(arg->query("id"), -v7);
        add_counter(v8->query("id"), v7);
        msg(arg, 0, "\e[5m\e[1;33m$N判断错误了！！！\n\n\e[2;37;0m");
        who_lost = arg->query("id");
    }
    start_game(0);
}

int do_dahua(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!arg) {
        msg(v2, 0, "$N一扁嘴嘟囔道：“大话精，大话精...”\n");
        return 1;
    }
    if (!is_playing(v2)) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_guess || !last_player) {
        return notify_fail("还没有开始猜色子了。\n");
    }
    v1 = get_player(last_player);
    if (v1 == v2) {
        return notify_fail("自己不相信自己。\n");
    }
    if (last_player != arg) {
        return notify_fail("不是他最后猜色子了。\n");
    }
    msg(v2, v1, "\e[1;36m\n$N对$n说道：我不相信！！！\n\e[2;37;0m");
    show_all_se(v2);
    return 1;
}

int do_finish(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    if (!is_playing(v1)) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_start) {
        return notify_fail("游戏还没有开始了。\n");
    }
    if (has_guess) {
        return notify_fail("已经开始猜色子了。\n");
    }
    player_deal[v1->query("id")] = 1;
    msg(v1, 0, "$N准备好了。\n");
    if (sizeof(player_deal) == sizeof(player)) {
        has_guess = 1;
        msg(0, 0, "\n猜色子开始\n");
        if (who_lost) {
            cur_player = who_lost;
        }
        who_lost = 0;
        if (!cur_player) {
            cur_player = v1->query("id");
        }
        if (v2 = get_cur_player()) {
            msg(v2, 0, "$N说道：由我先猜！！！\n");
            tell_object(v2, for_guess_msg());
        } else {
            msg(0, 0, "缺少了" + cur_player + "，不能进行游戏，请重新开始(start)\n");
        }
    }
    return 1;
}

int do_history(mixed arg) {
    if (!history) {
        tell_object(this_player(), "没有历史资料。\n");
    } else {
        tell_object(this_player(), implode(history, "\n") + "\n");
    }
    return 1;
}

int do_showc(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!counter) {
        return 0;
    }
    v2 = keys(player);
    v1 = "计数表(Scoreboard)\n－－－－－－－－－－－－－－－－－\nID　　　　　　　　分数\n－－－－－－－－－－－－－－－－－\n";
    for (v3 = 0; v3 < sizeof(v2); v3++) {
        if (get_player(v2[v3])) {
            v1 = sprintf("%s%-14s%10d\n", v1, v2[v3], counter[v2[v3]]);
        }
    }
    v1 += "－－－－－－－－－－－－－－－－－\n";
    msg(0, 0, v1);
    return 1;
}

int do_visitor(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    if (!arg) {
        return notify_fail("visit [-d] 玩家ID\n");
    }
    if (sscanf(arg, "-d %s", v1) == 1) {
        v4 = 1;
    } else {
        v4 = 0;
        v1 = arg;
    }
    v2 = this_player();
    if (is_playing(v2)) {
        v3 = present(v1, environment(this_object()));
        if (!v3) {
            return notify_fail("这里没有这个玩家啊？\n");
        }
        if (v4) {
            if (!is_visitor(v3, v2->query("id"))) {
                return notify_fail("不是你的观战者。\n");
            }
            msg(v2, v3, "$N不再允许$n观看$N的战况。\n");
            visitor[v2->query("id")] = visitor[v2->query("id")] - ({ v3->query("id") });
        } else {
            if (is_visitor(v3, v2->query("id"))) {
                return notify_fail("已经是你的观战者了。\n");
            }
            msg(v2, v3, "$N让$n观看$N的战况。\n");
            if (!visitor[v2->query("id")]) {
                visitor[v2->query("id")] = ({ v3->query("id") });
            } else {
                visitor[v2->query("id")] += v3->query("id");
            }
        }
    } else {
        if (v4) {
            return notify_fail("？？？？\n");
        }
        v3 = get_player(v1);
        if (!v3) {
            return notify_fail("没有这个玩家在玩啊？\n");
        }
        msg(v2, v3, "$N希望成为$n的观战者。\n");
        tell_object(v3, "接受使用[visit " + v2->query("id") + "]。\n");
    }
    return 1;
}

int do_help(mixed arg) {
    this_player()->start_more("大话色使用方法:\r\n——[开始游戏]———————————————\r\n帮助命令：helpse\r\n加入命令：join　　　　　加入游戏\r\n开始命令：start 　　　　开始游戏\r\n重置命令：reset se\t\t结束游戏\r\n\r\n——[游戏前命令]———————————————\r\n　摇色子：toss\r\n查看色子：view [玩家ID]\r\n准备结束：finish 或者 deal\r\n\r\n——[游戏命令]———————————————\r\n拆穿大话：dahua 玩家ID\r\n猜测色子：guess 色子数量 色子点数\r\n　　　　　或者 g 色子数量 色子点数\r\n催促玩家：next\r\n\r\n——[其它命令]———————————————\r\n　计数器：showc\r\n猜测日志：history\r\n\r\n——[旁观命"
            "令]———————————————\r\n观战命令：visit [-d] 玩家ID\r\n\t\t邀请其它玩家观看你的游戏。\r\n\t\t加参数 -d 表示删除该玩家的观看资格。\r\n\r\n——[游戏规则]———————————————\r\n建设中...\r\n\r\n——————————————————————\r\n\t\t\tmake by 猫部猫(Catyboy) v1.0\r\n");
    return 1;
}
