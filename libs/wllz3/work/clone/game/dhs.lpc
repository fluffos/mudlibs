void msg(mixed arg1, mixed arg2, mixed arg3) {
    if (arg1) {
        message_vision(arg3, arg1, arg2);
    } else {
        tell_room(environment(this_object()), arg3, 0);
    }
}

object get_player(mixed arg) {
    mixed v1;
    v1 = find_player(arg);
    if (!v1 || environment(v1) != environment(this_object())) {
        return 0;
    }
    return v1;
}

object get_cur_player() {
    return get_player(cur_player);
}

int is_playing(mixed arg) {
    mixed v1;
    v1 = arg->query("id");
    if (undefinedp(player[v1])) {
        return 0;
    }
    return 1;
}

mixed get_se(mixed arg) {
    return se_text[arg];
}

void create() {
    set_name("大话色台", ({ "da hua se desk", "se", "desk", "dhs" }));
    set_weight(1);
    if (clonep()) {
        set_default_object("/clone/game/dhs.lpc");
    } else {
        set("unit", "张");
        set("long", "这是一张大话色台，玩家可以在上面玩大话色，使用方法请使用(helpse)命令。\n");
        set("value", 1);
        set("material", "wood");
    }
    se_total = 5;
    reset_game(1);
    setup();
}

string for_other_msg(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = "";
    if (has_guess && last_player) {
        v1 = get_player(last_player);
        if (v1) {
            v2 = sprintf("%s\n%s(%s)猜色子数为：%d个%d\n", v2, v1->query("name"), v1->query("id"), cur_amount, cur_point);
            if (v1 != arg) {
                v2 = v2 + "如果你不相信，可以拆穿大话(\e" + "[1;33mdahua " + v1->query("id") + "\e" + "[2;37;0m)\n";
            }
        }
    }
    return v2;
}

string for_guess_msg() {
    mixed v1;
    v1 = "";
    if (has_guess && last_player) {
        v1 = v1 + for_other_msg(0) + "否则";
    }
    v1 = v1 + "你的猜测是(\e" + "[1;33mguess 色子数目 色子点数\e" + "[2;37;0m)？\n";
    if (has_guess && last_player) {
        v1 = v1 + "注意：\e" + "[1;36m色子数目或者色子点数必须比前一位玩家大。\n\e" + "[2;37;0m";
    }
    return v1;
}

int is_visitor(mixed arg1, mixed arg2) {
    if (!get_player(arg2)) {
        return 0;
    }
    if (!visitor[arg2] || member_array(arg1->query("id"), visitor[arg2]) == -1) {
        return 0;
    }
    return 1;
}

string build_se(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    if (!arg) {
        return "";
    }
    v2 = "";
    if (v1 = player[arg->query("id")]) {
        for (v5 = 0; v5 < 5; v5++) {
            v3 = "";
            for (v4 = 0; v4 < sizeof(v1); v4++) {
                v6 = v1[v4];
                v3 = v3 + se_text[v6][v5] + "　";
            }
            v2 = v2 + v3 + "\n";
        }
        if (has_guess && last_player) {
            v2 = v2 + for_other_msg(arg);
        }
    }
    return v2;
}

void toss(mixed arg) {
    mixed v1;
    mixed v2;
    if (!arg) {
        return;
    }
    if (v2 = player[arg->query("id")]) {
        for (v1 = 0; v1 < sizeof(v2); v1++) {
            v2[v1] = random(6) + 1;
        }
    }
    player[arg->query("id")] = sort_array(v2, 1);
}

int auto_order() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v2 = keys(player);
    player_follow = ([ ]);
    v3 = "";
    for (v1 = 0; v1 < sizeof(v2); v1++) {
        if (get_player(v2[v1])) {
            if (!v4) {
                v4 = v2[v1];
            }
            if (v3 == "") {
                v3 = v2[v1];
                continue;
            }
            player_follow[v3] = v2[v1];
            v3 = v2[v1];
        }
    }
    player_follow[v3] = v4;
    return 1;
}

int reset_game(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (arg) {
        has_start = 0;
    }
    has_guess = 0;
    se_num = se_total;
    cur_point = 0;
    cur_amount = 0;
    cur_player = 0;
    has_guess_one = 0;
    last_player = 0;
    if (arg) {
        who_lost = 0;
    }
    if (arg) {
        player = ([ ]);
    }
    player_deal = ([ ]);
    player_toss = ([ ]);
    player_follow = ([ ]);
    if (arg) {
        visitor = ([ ]);
    }
    if (arg) {
        counter = ([ ]);
    }
    history = 0;
    if (!arg) {
        v2 = keys(player);
        for (v1 = 0; v1 < sizeof(v2); v1++) {
            if (v3 = get_player(v2[v1])) {
                player[v2[v1]] = allocate(se_num);
                toss(v3);
                continue;
            }
            map_delete(player, v2[v1]);
        }
        auto_order();
    }
    return 1;
}

string extra_long() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    if (sizeof(player) > 0) {
        v3 = keys(player);
        v2 = "******************************************\n";
        for (v4 = 0; v4 < sizeof(v3); v4++) {
            v1 = get_player(v3[v4]);
            if (v1) {
                v2 = v2 + v1->short() + "\n";
            }
        }
        v2 += "******************************************\n";
    }
    return v2;
}

int view_se(mixed arg1, mixed arg2) {
    if (arg1) {
        if (arg2) {
            tell_object(arg2, build_se(arg1));
        } else {
            tell_object(arg1, build_se(arg1));
        }
    }
    return 1;
}

void start_game(mixed arg) {
    if (arg > 1 && arg <= 6) {
        se_total = arg;
    }
    reset_game(0);
    has_start = 1;
    msg(0, 0, "开始游戏了\n");
}

