mixed *get_pais(mixed arg) {
    mixed v1;
    if (arg == "desk") {
        return allpai;
    }
    if (arg == "desk2") {
        return expai;
    }
    if (sscanf(arg, "%s hand", v1) == 1) {
        if (get_player(v1)) {
            return pai_hand[v1];
        }
    }
    if (sscanf(arg, "%s out", v1) == 1) {
        if (get_player(v1)) {
            return pai_out[v1];
        }
    }
    if (sscanf(arg, "%s save", v1) == 1) {
        if (get_player(v1)) {
            return pai_save[v1];
        }
    }
    if (sscanf(arg, "%s hide", v1) == 1) {
        if (get_player(v1)) {
            return pai_hide[v1];
        }
    }
    return 0;
}

object get_player(mixed arg) {
    if (stringp(player[arg])) {
        return find_player(arg);
    }
}

int is_playing(mixed arg) {
    mixed v2;
    v2 = arg->query("id");
    if (stringp(player[v2])) {
