        }
    }
    if (sscanf(arg, "%s save", v2) == 1) {
        v1 = get_player(v2);
        if (v1) {
            return v1->name() + "身边";
        }
    }
    if (sscanf(arg, "%s hide", v2) == 1) {
        v1 = get_player(v2);
        if (v1) {
            return v1->name() + "隐藏";
        }
    }
    return "???";
}

int sizeof_pai(mixed arg) {
    return arg ? arg[0] : 0;
}

int valid_show(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (!has_start) {
        return 1;
    }
    if (sscanf(arg2, "%s %s", v1, v2) == 2) {
        if (arg1->query("id") == v1) {
            return 1;
        }
        if (v2 == "out") {
            return 1;
        }
        if (v2 == "save") {
            return 1;
        }
    }
    return 0;
}

string view_pai(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v3;
    mixed v5;
    mixed v6;
    v1 = get_pais(arg2);
    if (!v1) {
        return 0;
    }
    if (!sizeof_pai(v1)) {
        return "没有牌。";
    }
    if (valid_show(arg1, arg2)) {
        v5 = "";
        for (v3 = 0; v3 < v1[0]; v3++) {
            v6 = id_to_pai(v1[v3 + 1]);
            v5 += v6 + " ";
        }
        return v5;
    } else {
        return sizeof_pai(v1) + "张牌";
    }
}

int do_nextone(mixed arg) {
    mixed v1;
    mixed v2;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩牌啊！\n");
    }
    if (!who_play) {
        return notify_fail("现在是谁出牌啊？\n");
    }
    v2 = who_play;
    v1 = get_player(v2);
    if (!v1) {
        return notify_fail("没有设置好顺序。请参阅帮助。\n");
    }
    if (this_player()->query("id") != v2) {
        msg(this_player()->name() + "对" + v1->name() + "说道：到你了。\n");
    } else {
        msg(this_player()->name() + "对自己说道：到我啦！\n");
    }
    return 1;
}

int do_shunxu(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg) {
        return notify_fail("没有指定的人？\n");
    }
    v2 = explode(arg, "->");
    v3 = "";
    for (v1 = 0; v1 < sizeof(v2); v1++) {
        if (get_player(v2[v1])) {
            if (v3 == "") {
                v3 = v2[v1];
            } else {
                msg(v3 + "->" + v2[v1] + "\n");
                player[v3] = v2[v1];
                v3 = v2[v1];
            }
            continue;
        }
        return notify_fail(v2[v1] + "没有加入牌局啊！\n");
    }
    return 1;
}

int do_removej(mixed arg) {
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    do_movepai("JB from desk to desk2");
    do_movepai("JS from desk to desk2");
    return 1;
}

int do_pass(mixed arg) {
    mixed v1;
    mixed v3;
    mixed v5;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩牌啊！\n");
    }
    if (who_play != this_player()->query("id")) {
        return notify_fail("还没有到你啊！\n");
    }
    if (!arg) {
        arg = "ＰＡＳＳ！！";
    }
    msg(this_player()->name() + "说道：" + arg + "\n");
    v1 = who_play;
    who_play = player[who_play];
    if (mode == "21") {
        v3 = keys(player);
        for (v5 = 0; v5 < sizeof(v3); v5++) {
            if (player[v3[v5]] == v1) {
                player[v3[v5]] = player[v1];
            }
        }
        player[v1] = "";
        if (player[who_play] == "") {
            msg("大家都不要了。\n");
            finish_21();
            return 1;
        }
    }
    do_nextone("");
    return 1;
}

int do_now(mixed arg) {
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩牌啊！\n");
    }
    if (!arg) {
        return notify_fail("格式：now who\n");
    }
    if (get_player(arg)) {
        who_play = arg;
    }
    do_nextone("");
    return 1;
}

int do_end(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩牌啊！\n");
    }
    if (!has_start) {
        return notify_fail("游戏还没有开始啊！\n");
    }
    if (mode == "21") {
        return 1;
    }
    if (mode == "8") {
        v1 = get_pais(this_player()->query("id") + " hand");
        if (!v1 || sizeof_pai(v1) != 0) {
            return notify_fail("还没有摆完啊！\n");
        }
        msg(this_player()->name() + "说道：摆完牌了！！\n");
        if (player[this_player()->query("id")] != "F") {
            player[this_player()->query("id")] = "F";
            player_counter++;
        }
        if (player_counter == sizeof(player)) {
            v2 = keys(player);
            for (v3 = 0; v3 < sizeof(v2); v3++) {
                do_movepai("1+1+1+1+1+1+1+1 from " + v2[v3] + " hide to " + v2[v3] + " out");
            }
        }
    } else {
        msg(this_player()->name() + "说道：出完牌了！！\n");
        who_play = "完了";
    }
    return 1;
}

string id_to_pai(mixed arg) {
    mixed v1;
    mixed v2;
    if (arg < 0) {
        return "\e[1;31m???\e[2;37;0m";
    }
    if (arg == 52) {
        return "\e[1;33m小鬼\e[2;37;0mJS";
    }
    if (arg >= 53) {
        return "\e[1;33m大鬼\e[2;37;0mJB";
    }
    v1 = arg / 13;
    v2 = arg - v1 * 13;
    return suit_str[v1] + suit_char[v1] + rank_str[v2];
}

int pai_to_id(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = -1;
    v2 = -1;
    v3 = arg[0..0];
    v4 = arg[1..sizeof(arg) - 1];
    if (v3 == "J") {
        return v4 == "S" ? 52 : 53;
    }
    if (v3 == suit_char[0]) {
        v1 = 0;
    }
    if (v3 == suit_char[1]) {
        v1 = 1;
    }
    if (v3 == suit_char[2]) {
        v1 = 2;
    }
    if (v3 == suit_char[3]) {
        v1 = 3;
    }
    if (v1 == -1) {
        return -1;
    }
    if (sscanf(v4, "%d", v2) != 1) {
        if (v4 == "J") {
            v2 = 11;
        }
        if (v4 == "Q") {
            v2 = 12;
        }
        if (v4 == "K") {
            v2 = 13;
        }
        if (v4 == "A") {
            v2 = 14;
        }
        if (v2 == -1) {
            return -2;
        }
    }
    v2 -= 2;
    return v1 * 13 + v2;
}

void msg(mixed arg) {
    tell_room(environment(this_object()), arg, 0);
}

void auto_order() {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = keys(player);
    v3 = "";
    for (v1 = 0; v1 < sizeof(v2); v1++) {
        v3 += v2[v1] + "->";
    }
    v3 += v2[0];
    do_shunxu(v3);
    msg("如果顺序不合适请使用order命令重新设置。\n");
}

int do_setmode(mixed arg) {
    mixed v1;
    v1 = 0;
    if (!arg) {
        return notify_fail("setmode [模式] 请参照帮助。\n");
    }
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩牌啊！\n");
    }
    if (!has_start) {
        return notify_fail("游戏还没有开始啊。\n");
    }
    if (mode) {
        if (mode == "21" && arg == "auto") {
            mode2 = "auto";
            msg("进入自动模式。\n");
            return 1;
        }
        if (arg == "man" && mode == "21") {
            mode2 = 0;
            msg("进入手动模式。\n");
            return 1;
        }
        return notify_fail("已经进入了模式，请使用reset pai重置。\n");
    }
    mode = arg;
    if (mode == "8") {
        v1 = 1;
        msg("\e[1;31m进入8张模式。\n\e[2;37;0m");
        has_start = 0;
        do_removej("");
        has_start = 1;
    }
    if (mode == "21") {
        v1 = 1;
        msg("\e[1;31m进入21点模式。\n\e[2;37;0m");
        has_start = 0;
        do_removej("");
        has_start = 1;
        auto_order();
        save_player_data();
    }
    if (mode == "d2") {
        v1 = 1;
        msg("\e[1;31m进入锄大2模式。\n\e[2;37;0m");
        has_start = 0;
        do_removej("");
        has_start = 1;
        auto_order();
    }
    if (!v1) {
        mode = 0;
        return notify_fail("现在不支持该模式\n");
    }
    return 1;
}

int do_showc(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = keys(counter);
    v1 = "计数表(Scoreboard)\n－－－－－－－－－－－－－－－－－\nID　　　　　　　　分数\n－－－－－－－－－－－－－－－－－\n";
    for (v3 = 0; v3 < sizeof(v2); v3++) {
        v1 = sprintf("%s%-14s%10d\n", v1, v2[v3], counter[v2[v3]]);
    }
    v1 += "－－－－－－－－－－－－－－－－－\n";
    tell_room(environment(this_player()), v1, 0);
    return 1;
}

void press_counter(mixed arg1, mixed arg2) {
    counter[arg1] = counter[arg1] + arg2;
}

int do_press(mixed arg) {
    mixed v1;
    mixed v2;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩牌啊！\n");
    }
    if (sscanf(arg, "%s %d", v1, v2) != 2) {
        return notify_fail("格式：press id number。如：press catyboy 10\n");
    }
    press_counter(v1, v2);
    do_showc("");
    return 1;
}

int do_removec(mixed arg) {
    mixed v1;
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩牌啊！\n");
    }
    if (!arg || sscanf(arg, "%s", v1) != 1) {
        return notify_fail("格式：removec id\n");
    }
    map_delete(counter, v1);
    do_showc("");
    return 1;
}

int do_paipai2(mixed arg) {
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩啊！\n");
    }
    if (!has_start) {
        return notify_fail("游戏还没有开始。\n");
    }
    if (mode == "8") {
        do_paipai("8");
    }
    return 1;
}

int do_daopai(mixed arg) {
    if (!is_playing(this_player())) {
        return notify_fail("你都不玩，开始什么啊！\n");
    }
    if (!has_start) {
        return notify_fail("游戏还没有开始。\n");
    }
    do_movepai("1 from desk to desk /h");
    return 1;
}

mapping t() {
    return player;
}

mapping t2() {
    return player_data;
}

int pai_number(mixed arg) {
    if (arg == 52) {
        return 15;
    }
    if (arg == 53) {
        return 16;
    }
    return arg - arg / 13 * 13 + 2;
}

int pai_color(mixed arg) {
    if (arg >= 52) {
        return 5;
    }
    return arg / 13 + 1;
}

void save_player_data() {
    mixed v1;
    mixed v2;
    v1 = keys(player);
    for (v2 = 0; v2 < sizeof(v1); v2++) {
        player_data[v1[v2]] = player[v1[v2]];
    }
}

void restore_player_data() {
    mixed v1;
    mixed v2;
    v2 = keys(player_data);
    for (v1 = 0; v1 < sizeof(v2); v1++) {
        player[v2[v1]] = player_data[v2[v1]];
    }
}

int sort_21(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    sscanf(arg1, "%s:%d", v3, v1);
    sscanf(arg2, "%s:%d", v3, v2);
    if (v1 == v2) {
        return 0;
    }
    if (v1 > 21 && v2 > 21) {
        return v1 < v2 ? -1 : 1;
    }
    if (v1 > 21) {
        v1 = -1;
    }
    if (v2 > 21) {
        v2 = -1;
    }
    return v1 > v2 ? -1 : 1;
}

void finish_21() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    mixed v8;
    mixed v9;
    mixed v10;
    mixed v11;
    v1 = keys(player);
    v2 = allocate(sizeof(player));
    for (v7 = 0; v7 < sizeof(v1); v7++) {
        v4 = v1[v7];
        v2[v7] = v4 + ":" + c21(get_pais(v4 + " out"));
    }
    v3 = sort_array(v2, "sort_21", this_object());
    v11 = -1;
    v5 = "结果\n－－－－－－－－－－－－－－－－－\nID　　　　　　　　点数       得分\n－－－－－－－－－－－－－－－－－\n";
    for (v7 = 0; v7 < sizeof(v3); v7++) {
        sscanf(v3[v7], "%s:%d", v6, v10);
        if (v10 != v11) {
            v9 = sizeof(v3) - v7 - 1;
            v11 = v10;
        }
        if (!v7) {
            v8 = v10;
        }
        if (v10 == v8) {
            v5 += "\e[1;33m";
        }
        if (v10 > 21) {
            v5 += "\e[1;31m";
            v9 = 0;
        }
        v5 = sprintf("%s%-14s%5d%12d\n", v5, v6, v10, v9);
        v5 += "\e[2;37;0m";
        if (mode2 == "auto") {
            press_counter(v6, v9);
        }
    }
    v5 += "－－－－－－－－－－－－－－－－－\n";
    msg(v5);
    who_play = 0;
}
