inherit "/inherit/item/item";
void create();
void init();
int do_move(mixed);
int do_dian(mixed);
void fire_over(mixed, mixed);

void create() {
    set_name("灯笼", ({ "deng long" }));
    set_weight(80);
    if (clonep()) {
        set_default_object("/clone/misc/fire.lpc");
    } else {
        set("long", "这是用于夜晚照路的灯笼，到了晚上就可以点(dian)着了。\n");
        set("unit", "支");
        set("value", 100);
    }
    setup();
}

void init() {
    if (environment() == this_player()) {
        add_action("do_dian", "dian");
    }
    add_action("do_move", "drop");
    add_action("do_move", "put");
}

int do_move(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = this_object();
    if (id(arg)) {
        if (v2->query("light")) {
            remove_call_out("fire_over");
        }
        if (v1->query_temp("light")) {
            v1->set_temp("light", 0);
        }
        return 0;
    }
}

int do_dian(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    v2 = this_object();
    v3 = 120;
    if (!arg || arg == "") {
        return notify_fail("你要点着什么？\n");
    }
    if (id(arg)) {
        if (v2->query("light")) {
            return notify_fail("灯笼已经点燃了。\n");
        }
        if (v2->query("light_times") > 1) {
            return notify_fail("这把灯笼已经点不着了。\n");
        }
        tell_room(environment(v1), v1->name() + "点燃了灯笼，一蓬火光一闪，四周顿时亮了起来。\n", ({ v1 }));
        write("你点燃了灯笼，一蓬火光一闪，四周顿时亮了起来。\n");
        v2->add("light_times", 1);
        v2->set("light", 1);
        v2->set("value", 0);
        v2->set("name", "\e[1;33m点燃的灯笼\e[2;37;0m");
        v1->set_temp("light", 1);
        call_out("fire_over", v3, v1, v2);
        return 1;
    }
}

void fire_over(mixed arg1, mixed arg2) {
    if (!arg1 || !arg2) {
        return;
    }
    tell_object(arg1, "\e[1;33m幽幽的，你手中的灯笼火光终于熄灭了！\n\e[2;37;0m");
    arg2->set("light", 0);
    arg1->set_temp("light", 0);
    arg2->set("name", "灯笼");
}
