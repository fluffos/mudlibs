inherit "/inherit/item/item";
int compelete_work(mixed);
int halt_work(mixed);
void create();
void init();
int do_xiu(mixed);
void owner_is_killed();

void create() {
    set_name("\e[35m粉红丝绢\e[2;37;0m", ({ "si juan", "juan", "si" }));
    set_weight(100);
    if (clonep()) {
        set_default_object("/clone/misc/juan.lpc");
    } else {
        set("long", "这是一条什么图案都没有的粉红丝绢。绣(xiu)上一些图案，一定非常好看。\r\n");
        set("unit", "条");
        set("value", 0);
        set("material", "cloth");
        set("no_get", 1);
        set("no_get_from", 1);
        set("no_steal", 1);
        set("no_sell", 1);
        set("no_put", 1);
        set("no_beg", 1);
    }
    setup();
}

void init() {
    if (environment() == this_player()) {
        add_action("do_xiu", "xiu");
    }
}

int do_xiu(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!id(arg)) {
        return notify_fail("你要绣什么？\n");
    }
    if (v1->is_busy()) {
        return notify_fail("你正忙着呢！\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("你正在战斗中！\n");
    }
    if (v1->query("gender") != "女性") {
        return notify_fail("这是女人家的手艺，你抢什么呀？\n");
    }
    if (!v1->query_temp("xiu_job")) {
        return notify_fail("人家没请你刺绣，你就省点力气吧！\n");
    }
    if (v1->query("brawn") <= 20) {
        return notify_fail("你太累了，还是休息一会再说吧。\n");
    }
    if (v1->query("jing") < 20 || v1->query("qi") < 20) {
        return notify_fail("你太累了，还是休息一会再说吧。\n");
    }
    if (v1->query_temp("xiu_job_finish")) {
        return notify_fail("终于把丝绢绣好了，快去交(give)个曾柔吧！\n");
    }
    write("你心灵手巧，拿起针线往丝绢上小心翼翼的刺去。\n");
    v1->set_short_desc("心灵手巧，手中绣花针不停穿梭，正在绣丝绢。");
    v1->start_busy((: compelete_work :), (: halt_work :));
    return 1;
}

int compelete_work(mixed arg) {
    if (!arg) {
        return 0;
    }
    if (environment() != arg) {
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->query("brawn") < 20 || arg->query("jing") < 20 || arg->query("qi") < 20) {
        write("你觉得有点累，实在做不下去了，于是停下来休息一会。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->add_temp("xiu_finish", 1) > random(8) + 10) {
        write("一条绣着戏水鸳鸯的丝绢终于做了，你满意的看了看，决定将它交给曾柔。\n");
        arg->set_short_desc(0);
        arg->set_temp("xiu_job_finish", 1);
        return 0;
    }
    switch (random(5)) {
    case 1:
        write("绣花针慢慢的穿过丝绢，你显得得心应手。\n");
        break;
    case 2:
        write("\e[31m你突然一分神，绣花针刺到了指尖，你忍不住尖叫了声：哎呀，好疼哟！\n\e[2;37;0m");
        arg->add("jing", -10);
        arg->add("qi", -10);
        break;
    case 3:
        write("你小心翼翼的把丝绢翻了翻，依据纹路将绣花针刺了进去。\n");
        break;
    default:
        write("真是心灵手巧，你照着丝绢上的图案，有条有理的做着刺绣。\n");
        break;
    }
    arg->add("brawn", -2);
    return 1;
}

int halt_work(mixed arg) {
    write("你觉得有些累了，于是停下来休息一会。\n");
    arg->set_short_desc(0);
    return 1;
}

void owner_is_killed() {
    destruct(this_object());
}
