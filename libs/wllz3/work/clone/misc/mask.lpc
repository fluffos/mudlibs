inherit "/inherit/item/item";
void create();
void init();
int do_pretend(mixed);

void create() {
    set_name("面具", ({ "mian ju", "mask" }));
    if (clonep()) {
        set_default_object("/clone/misc/mask.lpc");
    } else {
        set_weight(3000);
        set("unit", "个");
        set("long", "这似乎是一个由人皮制成的面具。\n");
    }
    setup();
}

void init() {
    if (environment() == this_player()) {
        add_action("do_pretend", "pretend");
    }
    add_action("do_pretend", "ban");
}

int do_pretend(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!arg) {
        return notify_fail("你想假装谁？\n");
    }
    if (arg == "none" || arg == "cancel") {
        if (!v2->query_temp("mask")) {
            return notify_fail("你没有假装任何人。\n");
        }
        v2->delete_temp("apply/name");
        v2->delete_temp("apply/id");
        v2->delete_temp("apply/short");
        v2->delete_temp("apply/long");
        message_vision("$N从脸上取下了一个人皮面具。\n", v2);
        return 1;
    }
    if (v2->query_temp("yirong")) {
        return notify_fail("你正在施展易容术呢。\n");
    }
    if (!objectp(v1 = present(arg, environment(v2))) || !living(v1) || v1->query("race") != "人类" || wizardp(v1)) {
        return notify_fail("你想假装谁？\n");
    }
    write("你开使假装" + v1->name() + "。\n");
    message_vision("$N戴上了一个精功制成的人皮面具。\n", v2);
    v2->set_temp("apply/name", ({ v1->name() }));
    v2->set_temp("apply/short", ({ v1->short() }));
    v2->set_temp("apply/long", ({ v1->long() }));
    set_temp("owner", v2);
    return 1;
}

int move(mixed arg) {
    mixed v1;
    if (v1 = query_temp("owner")) {
        v1->delete_temp("apply/name");
        v1->delete_temp("apply/short");
        v1->delete_temp("apply/long");
        delete_temp("owner");
    }
    return ::move(arg);
}
