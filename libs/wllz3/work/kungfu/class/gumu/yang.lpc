void attempt_apprentice(mixed arg) {
    if (arg->query("gender") != "男性") {
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "请回去吧，我不收女弟子的。");
        return;
    }
    if (arg->query_int() < 55) {
        command("say 依我看" + "/adm/daemons/rankd"->query_respect(arg) + "的资质还不够高？");
        return;
    }
    if (arg->query("attributive/att") != "金") {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "命格似乎并不适合修炼古墓派的武功。");
        return;
    }
    command("smile");
    command("say 很好，" + "/adm/daemons/rankd"->query_respect(arg) + "多加努力，他日必定有成。\n");
    command("recruit " + arg->query("id"));
    arg->set("class", "swordsman");
}

