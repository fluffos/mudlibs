void attempt_apprentice(mixed arg) {
    if (arg->query_int() < 50) {
        command("say 我古墓新派的功夫最讲一个悟字，你的资质不够。");
        return;
    }
    if (arg->query_skill("yunv-xinfa", 1) < 300) {
        command("say 你的玉女心法火候不足，难以领略更高深的武功。");
        return;
    }
    command("say 好吧，看你也是性情中人，我就收下你这个徒弟了。");
    command("recruit " + arg->query("id"));
}

string ask_yunv() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_player()->query_skill("yunv-xinfa", 1);
    if (!(v1 = this_player()->query("family")) || v1["family_name"] != "古墓新派") {
        return "/adm/daemons/rankd"->query_respect(this_player()) + "与本派毫无瓜葛，何以问起本派的心经？";
    }
    if (!v3 || v3 < 55) {
        return "/adm/daemons/rankd"->query_respect(this_player()) + "的玉女心法火候不足，我不能将玉女心经交给你";
    }
    if (query("book_count") < 1) {
        return "你来晚了，本派的玉女心经已经被人取走了。";
    }
    add("book_count", -1);
    v2 = clone_object("/clone/book/yunvjing2");
    v2->move(this_player());
    "/adm/daemons/channeld"->do_channel(this_object(), "rumor", sprintf("%s拿到玉女心经啦！", this_player()->name(1)));
    return "好吧，这本「玉女心经」你拿回去好好研读。";
}

