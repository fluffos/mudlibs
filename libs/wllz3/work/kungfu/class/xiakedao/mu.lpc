            return 1;
        } else if (query_temp("bu")) {
            message_vision("\n木岛主见是赏善罚恶簿，对$N摇头道：赏善罚恶簿我有了。\n", arg1);
            return 0;
        } else {
            message("vision", "木岛主看见赏善罚恶簿，大喜道：现在只差腐心草了。\n", environment(arg1));
            set_temp("bu", 1);
            return 1;
        }
    }
    if (arg2->query("id") == "fuxin cao") {
        if (arg1->query("kar") <= random(15) + 15) {
            message_vision("木岛主摇头道：我看小兄弟今生于此无缘。\n", arg1);
            return 1;
        } else if (query_temp("bu")) {
            message_vision("\n木岛主见是腐心草，大喜道：恭喜这位小兄弟了！\n", arg1);
            v1 = clone_object("/d/xiakedao/obj/zhou");
            v1->move(arg1);
            delete_temp("cao");
            delete_temp("bu");
            "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s拿到了%s啦！", arg1->name(), v1->name(2)));
            return 1;
        } else if (query_temp("cao")) {
            message_vision("\n木岛主见是腐心草，对$N摇头道：腐心草我已经有了。\n", arg1);
            return 0;
        } else {
            message("vision", "木岛主看见腐心草，大喜道：现在只差赏善罚恶簿了。\n", environment(arg1));
            set_temp("cao", 1);
