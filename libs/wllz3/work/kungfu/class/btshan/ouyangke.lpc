void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (arg->query("gender") == "女性") {
        switch (random(3)) {
        case 0:
            command("hug " + arg->query("id"));
            break;
        case 1:
            command("kiss " + arg->query("id"));
            break;
        case 2:
            command("pat1 " + arg->query("id"));
            break;
        }
    } else {
        say("欧阳克叹了一口气说：大漠真是寂寞，无敌真是寂寞，没有女人的日子，绝对的寂寞呀。\n");
    }
    return;
}

void attempt_apprentice(mixed arg) {
    if (arg->query("family/family_name") == "白驼山派") {
        if (arg->query("level") < 15) {
            command("say 你的等级太低，我还不能收你。继续努力吧。");
        } else {
            command("say 嗯，那从今天开始，你就跟着我要好好的学。");
            command("recruit " + arg->query("id"));
        }
        return;
    }
}

int accept_fight(mixed arg) {
    if (arg->query("gender") == "女性") {
        message_vision("欧阳克摆摆手说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，我怎能欺负女孩子呢！\n", arg);
        return 0;
    }
    if (arg->query("family/family_name") == "白驼山派") {
        if (arg->query("level") < 50) {
            return notify_fail("欧阳克笑道：你不是我对手，还是去练几年再吧。！\n");
        }
    }
    message_vision("欧阳克一拱手说道：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，在下领教了。\n", arg);
    return 1;
}
