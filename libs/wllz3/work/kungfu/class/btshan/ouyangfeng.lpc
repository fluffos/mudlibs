    map_skill("hand", "shexing-diaoshou");
    prepare_skill("strike", "hamagong");
    create_family("白驼山派", 1, "开山祖师");
    set("chat_chance", 5);
    set("chat_msg", ({ "欧阳锋道：江湖险恶，困难重重哪！\n", "欧阳锋语重心长的说道：踏遍江湖，要寻找一个根骨奇佳的人真不容易。\n", "欧阳锋突然对天长叹：莫非，我蛤蟆功的推天式就此失传了吗？\n" }));
    set("chat_chance_combat", 60);
