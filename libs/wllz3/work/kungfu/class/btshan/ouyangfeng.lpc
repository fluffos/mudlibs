void attempt_apprentice(mixed arg) {
    if (!arg->query("ouyangfeng_son")) {
        if (arg->query("level") < 60) {
            command("say 你的经验太低了,我还不能收你！");
            return;
        }
        if (arg->query("shen") > -100000) {
            command("say 白驼山庄向来不与正派人士交往，这位" + "/adm/daemons/rankd"->query_respect(arg) + "还是请回吧！");
            return;
        }
    }
    command("say 好！好！我就收下你吧！");
    command("recruit " + arg->query("id"));
    if (arg->query("ouyangfeng_son")) {
        arg->set_title("\e[1;31m欧阳锋的义子\e[2;37;0m");
    }
    return;
}

void init() {
    mixed v1;
    ::init();
    if (interactive(v1 = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
    add_action("do_callname", "jiao");
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (arg->query("int") > con && arg->query("con") > con && arg->query("age") < 20 && arg->query("gender") == "男性" && !arg->query("ouyangfeng_son") && arg->name() == "杨过" && arg->query("attributive/att") == "金") {
        message_vision("$N用一种赞许的眼神看了看$n，说道：这位小兄弟真是乖\n巧，若你叫(jiao 爸爸)我一声爸爸，我便传你武功。\n", this_object(), arg);
        arg->set_temp("oyf_son", 1);
        return;
    } else if (arg->query("ouyangfeng_son")) {
        message_vision("$N亲切的看了看$n，说道：好儿子，看望爸爸来了？\n", this_object(), arg);
        return;
    }
}

int do_callname(mixed arg) {
    mixed v1;
    mixed v2;
    v2 = this_object();
    v1 = this_player();
    if (!v1->query_temp("oyf_son")) {
        return 0;
    }
    if (!arg || arg == "") {
        return notify_fail("你要叫什么？\n");
    }
    if (arg == "爸爸") {
        message_vision("$N恭恭敬敬的对$n叫了一声：爸爸！！\n", v1, v2);
        if (v1->query("ouyangfeng_son")) {
            message_vision("$n亲切的拍拍$N的头，赞许的说道：嗯，好儿子！\n", v1, v2);
            return 1;
        } else if (v1->query_temp("oyf_son")) {
            message_vision("\e[1;37m$n脸上一喜，哈哈大笑的应了一声：嗯，我的好儿子！\n\e[2;37;0m", v1, v2);
            "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s认贼做父，做了%s的义子。", v1->name(1), v2->name()));
            v1->set("ouyangfeng_son", 1);
            message_vision("$N轻轻的拍了拍$n的肩膀。\n", v1, v2);
            tell_object(v1, "\e[1;37m你只觉一股真气从欧阳锋的掌心传了过来，直奔你的气海、丹田、天灵。\n紧接另一股真气又顺着悬枢穴直贯灵台。你觉得浑身颤抖，脑子里稀里糊涂的....\n\e[2;37;0m");
            v1->unconcious();
            v1->set_temp("block_msg/all", 0);
            tell_object(v1, "\e[1;32m欧阳锋在你耳边轻轻的说道：推天式是我蛤蟆功的真髓所在，你可要多加领悟。\n\e[2;37;0m");
            v1->set_temp("block_msg/all", 1);
            return 1;
        } else {
            message_vision("$n疑惑的瞧了瞧$N，说道：你是我哪个时候生的儿子啊？\n", v1, v2);
            return 1;
        }
    }
    message_vision("$N对$n叫了一声：" + arg + "。\n可是$n对$N就是不理不采。\n", v1, v2);
    return 1;
}

void reset() {
    con = random(35) + 25;
}

void afterdie_func(mixed arg) {
    if (arg->query("ouyangfeng_son")) {
        tell_object(arg, "\e[1;31m你大逆不道，竟然杀死自己的义父，你的江湖威望降低了。\n\e[2;37;0m");
        arg->set("weiwang", 0);
        arg->delete("ouyangfeng_son");
        "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s那禽兽不如的东西，尽将自己的义父%s杀死了。", arg->name(1), name()));
    }
}
