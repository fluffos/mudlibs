void attempt_apprentice(mixed arg) {
    if (arg->query("class") != "bonze") {
        command("say 阿弥陀佛！贫尼不收俗家弟子。施主若想学艺可去找我俗家师妹。");
        return;
    }
    if (arg->query("gender") != "女性") {
        command("say 阿弥陀佛！贫尼不收男弟子。施主若想学艺可去找我俗家师妹。");
        return;
    }
    if (arg->query("shen") < 10000) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "你行侠仗义之事还做的不够。");
        return;
    }
    if (arg->query_skill("mahayana", 1) < 200) {
        command("say 依我看，你的大乘涅磐功的修为好象还不够啊！");
        return;
    }
    command("say 阿弥陀佛，善哉！善哉！好吧，我就收下你了。");
    command("say 希望你能以慈悲之心，以智慧之力，努力行善，济度众生。");
    command("recruit " + arg->query("id"));
}

string ask_for_join() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = v1->query("family");
    if (!v2 || v2["family_name"] != "峨嵋派") {
        return "你和峨嵋没有渊源，贫尼不敢给你剃度。";
    }
    if (v1->query("class") == "bonze") {
        return "阿弥陀佛！出家人不打诳语。你已经不是俗家人了。";
    }
    if (v1->query("gender") != "女性") {
        return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，可去少林寺受戒。";
    }
    v1->set_temp("pending/join_bonze", 1);
    command("say 阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。");
    return "记住，一旦出了家，是不能还俗的，否则将会受到惩罚。";
}

int do_kneel() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    v2 = ({ "灵", "文", "静", "清", "道" });
    if (!v1->query_temp("pending/join_bonze")) {
        return 0;
    }
    message_vision("$N双手合十，恭恭敬敬地跪了下来。\n$n看着$N说道：好吧，你就在本庵修行吧。\n\n$n伸出手掌，在$N头顶轻轻地摩挲了几下，将$N的头发尽数剃去。\n\n", v1, this_object());
    v3 = v1->query("name");
    v4 = v2[random(sizeof(v2))] + v3[0..1];
    command("say 尘缘已尽，从今以后你的法名叫做" + v4 + "，望你抛弃一切红尘世俗，静心修行。");
    command("chat " + v3 + "削发为尼，在峨嵋山修行，取法名" + v4 + "。");
    command("smile");
    v1->set("marks/old_name", v3);
    v1->delete_temp("pending/join_bonze");
    v1->set("byname", v4);
    v1->set("class", "bonze");
    v1->set("K_record", v1->query("PKS") + v1->query("MKS"));
    v1->set("shen_record", v1->query("shen"));
    return 1;
}
