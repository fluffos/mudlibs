void attempt_apprentice(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = arg->query("name");
    if (!(v1 = arg->query("family")) || v1["family_name"] != "峨嵋派") {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "与本派素无来往，不知此话从何谈起？");
        return;
    }
    if (arg->query("class") != "bonze") {
        command("say 阿弥陀佛！贫尼不收俗家弟子。");
        return;
    }
    if (arg->query_skill("mahayana", 1) < 400 || arg->query_skill("linji-zhuang", 1) < 400) {
        command("say 依我看，你的大乘涅磐功和临济十二庄的修为好象还不够啊！");
        return;
    }
    if (arg->query("shen") < 100000) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "你行侠仗义之事还做的不够。");
        return;
    }
    if (arg->query("class") == "bonze") {
        v2 = arg->query("name");
        v3 = "静" + v2[2..3] + "师太";
        arg->set("byname", v3);
        command("say 从今以后你的法名叫做" + v3 + "，恭喜你成为峨嵋第四代弟子！");
        command("chat 恭喜" + arg->name() + "成为峨嵋派第四代弟子，取法号：" + v3 + "。");
    }
    command("say 阿弥陀佛，善哉！善哉！好吧，我就收下你了。");
    command("say 希望你能以慈悲之心，以智慧之力，努力行善，济度众生。");
    command("recruit " + arg->query("id"));
}

string ask_for_quit() {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = v1->query("family");
    if (!v2 || v2["family_name"] != "峨嵋派") {
        return "你和峨嵋没有渊源，贫尼不敢给你还俗。\n";
    }
    if (v1->query("class") != "bonze") {
        return "阿弥陀佛！出家人不打诳语。你已经是俗家人了。\n";
    }
    v1->set_temp("pending/quit_bonze", 1);
    command("say 阿弥陀佛！善哉！善哉！你一心要还俗，我也不挽留。");
    command("say 我将废去你部分武功。请跪下(kneel)听宣。");
    return "如果不愿还俗的，就安心在此修炼吧。\n";
}

string ask_me() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!mapp(v3 = v1->query("family")) || v3["family_name"] != "峨嵋派") {
        return "这位" + "/adm/daemons/rankd"->query_respect(v1) + "与我峨嵋派素无来往，何来大乘涅磐功一说？";
    }
    if (query("book_give") < 1) {
        return "你来晚了，大乘涅磐功已经被其他人拿走了。";
    }
    "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s拿到大乘涅磐功啦！", v1->name()));
    add("book_give", -1);
    v2 = clone_object("/clone/book/mahayana");
    v2->move(v1);
    return "好吧！这本大乘涅磐功你就拿去好好学习。";
}
