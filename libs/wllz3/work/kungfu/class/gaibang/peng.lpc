int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = this_object();
    v2 = v1->query("family");
    if (!v2 || v2["family_name"] != "丐帮") {
        return notify_fail("你哪里来的青竹令？\n");
    }
    if (arg1->query_temp("have_cloth") && present("po bu", arg1)) {
        command("say 你不是已经有破布么？");
        return 0;
    }
    if (!arg1->query("beggarlvl") && arg1->query("level") <= 15 || arg1->query("beggarlvl") == 1 && arg1->query("level") <= 35 || arg1->query("beggarlvl") == 2 && arg1->query("level") <= 65 || arg1->query("beggarlvl") == 3 && arg1->query("level") <= 85 || arg1->query("beggarlvl") == 4 && arg1->query("level") <= 105 || arg1->query("beggarlvl") == 5 && arg1->query("level") <= 125 || arg1->query("beggarlvl") == 6 && arg1->query("level") <= 145 || arg1->query("beggarlvl") == 7 && arg1->query("level") <= 165 || arg1->query("beggarlvl") == 8 && arg1->query("level") <= 185) {
        command("say 就你那点脓水？我看就算了吧。\n");
        return 1;
    }
    if (!arg1->query("beggarlvl") && v1->query("title") == "丐帮一袋弟子" || arg1->query("beggarlvl") == 1 && v1->query("title") == "丐帮二袋弟子" || arg1->query("beggarlvl") == 2 && v1->query("title") == "丐帮三袋弟子" || arg1->query("beggarlvl") == 3 && v1->query("title") == "丐帮四袋弟子" || arg1->query("beggarlvl") == 4 && v1->query("title") == "丐帮五袋弟子" || arg1->query("beggarlvl") == 5 && v1->query("title") == "丐帮六袋弟子" || arg1->query("beggarlvl") == 6 && v1->query("title") == "丐帮七袋弟子" || arg1->query("beggarlvl") == 7 && v1->query("title") == "丐帮八袋弟子" || arg1->query("beggarlvl") == 8 && v1->query("title") == "丐帮九袋长老") {
        if (arg2->query("id") == "qingzhu ling" && !arg1->query_temp("have_cloth")) {
            arg1->set_temp("fight_ok", 1);
            command("say 好，既然已有青竹令，那就看你的运气了。\n");
            return 1;
        }
    }
    command("smile");
    command("say 升袋当然只升不降。跳升也是不行的。");
    command("say 这东西给你还是自己留着吧。");
