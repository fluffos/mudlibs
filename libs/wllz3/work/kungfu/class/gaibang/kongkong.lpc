void init() {
    mixed v1;
    if (interactive(v1 = this_player()) && !is_fighting()) {
        remove_call_out("stealing");
        call_out("stealing", 1, v1);
    }
    add_action("do_apply", "apply");
}

void stealing(mixed arg) {
    mixed v1;
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (mapp(v1 = arg->query("family")) && v1["family_name"] == "丐帮" || arg->query_skill("taoism", 1) > 30 || arg->query_int() > 30) {
        return;
    }
    switch (random(5)) {
    case 0:
        command("hehe " + arg->query("id"));
        command("beg all from " + arg->query("id"));
        command("buy jitui");
        break;
    case 1:
        command("grin " + arg->query("id"));
        command("steal silver from " + arg->query("id"));
        command("eat jitui");
        break;
    case 2:
        command("hi " + arg->query("id"));
        command("steal gold from " + arg->query("id"));
        command("drink jiudai");
        break;
    case 3:
        command("pat " + arg->query("id"));
        command("beg all from " + arg->query("id"));
        command("eat jitui");
        break;
    case 4:
        command("ppp " + arg->query("id"));
        command("beg all from " + arg->query("id"));
        command("drink jiudai");
        break;
    }
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->query("money_id") && arg2->value() >= 1) {
        command("smile");
        command("say 多谢啦！其实我还是有点钱的，这次只不过试试你罢了！");
        command("give 10 silver to " + arg1->query("id"));
    } else {
        command("shake");
        command("say 这种东西鬼才要！滚一边去！");
        command("give " + arg2->query("id") + " to " + arg1->query("id"));
    }
    return 1;
}

int accept_fight(mixed arg) {
    command("say " + "/adm/daemons/rankd"->query_respect(arg) + "饶命！小的这就离开！\n");
}

int ask_me() {
    mixed v1;
    v1 = this_player();
    if (v1->query("career")) {
        command("say 嘿，小偷也是一种职业，劫富济贫的小偷叫义盗，杀人越货的才叫大盗！");
        return 1;
    }
    if (v1->query("career") == "小偷") {
        command("say 记得可不要做伤天害理的事情，坏了自己的名气。");
        return 1;
    }
    if (v1->query_temp("pending/apply_steal")) {
        command("say 考虑清楚了嘛？一旦加入这种职业可是无法改变的。");
        return 1;
    }
    command("say 好家伙，你也想做小偷啊，那就输入(apply steal)吧。");
    v1->set_temp("pending/apply_steal", 1);
    return 1;
}

int do_apply(mixed arg) {
    mixed v1;
    v1 = this_player();
    if (!v1->query_temp("pending/apply_steal")) {
        return 0;
    }
    if (arg == "steal") {
        write("\e[31m你忍不住诱惑，终于加入了小偷的行列，从今天开始，你可以劫富济贫，行侠仗义了！\n\e[2;37;0m");
        command("pat " + v1->query("id"));
        v1->set("career", "小偷");
        v1->delete_temp("pending/apply_steal");
        return 1;
    }
    return 0;
}
