void attempt_apprentice(mixed arg) {
    if (arg->query("str") < 55) {
        command("say 我们丐帮的武艺一向以刚猛为主，" + "/adm/daemons/rankd"->query_respect(arg) + "臂力太弱，似乎不宜学丐帮的功夫？");
        return;
    }
    if (arg->query_skill("begging", 1) < 200) {
        command("say 叫化绝活乃是丐帮的得意功夫，依我看这位" + "/adm/daemons/rankd"->query_respect(arg) + "似乎还不够啊！");
        return;
    }
    command("say 好吧，希望" + "/adm/daemons/rankd"->query_respect(arg) + "能勤练武艺，将来在江湖中闯出一番作为。");
    command("recruit " + arg->query("id"));
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = this_object();
    v2 = v1->query("family");
    if (!v2 || v2["family_name"] != "丐帮") {
        return notify_fail("你哪里来的青竹令？\n");
    }
    if (arg1->query_temp("have_cloth") && present("po bu", arg1)) {
        command("say 你不是已经有破布么？");
