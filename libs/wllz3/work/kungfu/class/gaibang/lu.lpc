int accept_fight(mixed arg) {
    mixed v1;
    v1 = this_object();
    if (!arg->query_temp("fight_ok")) {
        return 0;
    }
    remove_call_out("checking");
    call_out("checking", 1, v1, arg);
    arg->delete_temp("fight_ok");
    return 1;
}

int checking(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = arg1->query("max_qi");
    v3 = arg2->query("max_qi");
    if (arg1->is_fighting()) {
        call_out("checking", 2, arg1, arg2);
        return 1;
    }
    if (!present(arg2, environment())) {
        return 1;
    }
    if (arg1->query("qi") * 100 / v2 <= 50) {
        command("say 大爷今天心情好，算你运气。拿这块破布找简长老去！\n");
        message_vision("$N交给$n一块破布。\n", arg1, arg2);
        arg2->set("newtitle", arg1->query("title"));
        arg2->set_temp("have_cloth", 1);
        v1 = clone_object("/kungfu/class/gaibang/obj/po-bu");
        v1->move(arg2);
        return 1;
    }
    if (arg2->query("qi") * 100 / v3 < 50) {
        command("say 看来" + "/adm/daemons/rankd"->query_respect(arg2) + "想升袋？也不看看自家长了几根毛 !\n");
        return 1;
    }
    return 1;
}
