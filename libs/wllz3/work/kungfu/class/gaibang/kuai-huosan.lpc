void attempt_apprentice(mixed arg) {
    if (arg->query("shen") < 0) {
        command("say 丐帮在江湖中一向行侠仗义，从不和邪魔歪道之人打交道！");
        return;
    }
    command("say 好吧，希望你能好好学习本门武功，将来为丐帮争一口气！");
    command("recruit " + arg->query("id"));
    arg->set("class", "beggar");
}

int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = this_object();
    v2 = v1->query("family");
    if (!v2 || v2["family_name"] != "丐帮") {
