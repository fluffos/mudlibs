void attempt_apprentice(mixed arg) {
    if (arg->query_str() < 35 || arg->query_con() < 35) {
        command("say 当叫化子需要能吃苦耐劳，依我看" + "/adm/daemons/rankd"->query_respect(arg) + "的资质似乎不适合当叫化子？");
        return;
    }
    if (this_player()->query_temp("jiahuoji")) {
        command("haha");
        command("say 想不到你小小年纪，心思却很细，就跟当年的蓉儿一样！好吧，我就收下你！\n");
        command("recruit " + arg->query("id"));
        if (arg->query("class") != "beggar") {
            arg->set("class", "beggar");
        }
    } else {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "各项条件都不错，只可惜老叫化现在没力气收徒……");
        return;
    }
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->query("food_supply") <= 0) {
        return 0;
    }
    if (arg2->query("id") != "jiaohua ji") {
        command("say 老叫化对" + arg2->query("name") + "没什么兴趣……");
        return 0;
    }
    if (query("food") >= max_food_capacity() - arg2->query("food_supply")) {
        command("say 老叫化现在饱得很。");
        return 0;
    }
    command("say 啊……这正是我想吃的叫化鸡呀！");
    command("eat ji");
    command("smile");
    arg1->set_temp("jiahuoji", 1);
    return 1;
}

