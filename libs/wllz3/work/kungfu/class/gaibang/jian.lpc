    mixed v1;
    v1 = this_object();
    if (arg1->query_temp("have_cloth") && present("po bu", arg1)) {
        command("say 既然升袋，就当牢记帮规，为民除害！");
        message_vision("$N把破布钉在$n的破衣服上，俨然一个新口袋。\n", v1, arg1);
        arg1->delete_temp("have_cloth");
        arg1->set("title", arg1->query("newtitle"));
        if (arg1->query("title") == "丐帮一袋弟子") {
            arg1->set("beggarlvl", 1);
        }
        if (arg1->query("title") == "丐帮二袋弟子") {
