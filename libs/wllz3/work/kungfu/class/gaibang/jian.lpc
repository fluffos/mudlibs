void init() {
    mixed v1;
    mixed v2;
    ::init();
    if (interactive(v1 = this_player()) && !is_fighting()) {
        v2 = v1->query("family");
        if ((!v2 || v2["family_name"] != "丐帮") && !wizardp(v1)) {
            remove_call_out("saying");
            call_out("saying", 2, v1);
        }
    }
}

void saying(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    message_vision("\n简长老看了$N一眼，冷冷地说到：“洪帮主他老人家说我不该随意责打丐帮弟子，\n你又不属我丐帮，我打你总可以吧？”\n说完右腿一抬，$N顺势应了一招青城派的「屁股向后，平沙落雁式」－－叭叽\n\n", arg);
    remove_call_out("kicking");
    call_out("kicking", 1, arg);
}

void kicking(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    arg->move("/d/yangzhou/tudimiao");
    message("vision", "只听“嘭”地一声，紧接着" + arg->query("name") + "从小门里飞了出来，屁股上有一个清楚的鞋印。\n", environment(arg), arg);
}

void attempt_apprentice(mixed arg) {
    command("say 老夫不收徒弟，" + "/adm/daemons/rankd"->query_respect(arg) + "还是请回吧。");
}

string ask_me() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_player();
    if (!(v1 = v3->query("family")) || v1["family_name"] != "丐帮") {
        return "/adm/daemons/rankd"->query_respect(v3) + "与本派素无来往，不知此话从何谈起？";
    }
    if (v3->query("level") < 50) {
        return "你的实战经验不足，还未到资格挑战你的同门大师兄呢！\n";
    }
    v2 = clone_object("/kungfu/class/gaibang/obj/qingzhu-ling");
    v2->move(v3);
    message_vision("$N获得一面青竹令。\n", v3);
    return "好吧，凭这面青竹令，你可自由向你的同门大师兄挑战。";
}

