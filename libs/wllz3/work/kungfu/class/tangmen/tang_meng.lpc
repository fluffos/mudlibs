}

void attempt_apprentice(mixed arg) {
    if (arg->query("shen") < 10000) {
        command("say 我收徒最注重德行！");
        command("say 在德行方面，" + "/adm/daemons/rankd"->query_respect(arg) + "是否还做得不够？");
        return;
    }
    if (arg->query_str() < 25) {
        command("say 我虽然用的是暗器。");
        command("say 但是我的霹雳镖要求有很强的臂力。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "在力量上还需要多下功夫。");
        return;
    }
    if (arg->query_skill("biyun-xinfa", 1) < 200) {
        command("say 唐门虽然以暗器为主，但还是要辅以内力。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "是否还应该在碧云心法上多下点功夫？");
        return;
    }
    if (arg->query_int() < 25) {
        command("say 唐门历来注重弟子的文学修为。");
        command("say 本派功夫要能熟练运用，必须能体会其中所含深远意境，悟性差了是不行的。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "的悟性还大有潜力可挖，还是请回吧。");
        return;
    }
    command("say 哈哈哈，我就收下你，记住以后要在江湖行侠仗义喔！");
    command("recruit " + arg->query("id"));
}
