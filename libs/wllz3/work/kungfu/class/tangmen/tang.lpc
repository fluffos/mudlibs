void attempt_apprentice(mixed arg) {
    if (arg->query_skill("biyun-xinfa", 1) < 400) {
        command("say 唐门虽然以暗器为主，但还是要辅以内力。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "是否还应该在碧云心法上多下点功夫？");
        return;
    }
    if (arg->query_int() < 35) {
        command("say 唐门历来注重弟子的文学修为。");
        command("say 本派功夫要能熟练运用，必须能体会其中所含深远意境，悟性差了是不行的。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "的悟性还大有潜力可挖，还是请回吧。");
        return;
    }
    command("chat 哈哈哈哈！！！！");
    command("chat 唐门又多了一个得力人才，真是可喜可贺。");
    command("recruit " + arg->query("id"));
    return;
}

string ask_me() {
    mixed v1;
    v1 = this_player();
    if (v1->query_temp("marks/闹")) {
        command("say 你想帮唐方那个死丫头打探消息吗？看我不劈了你");
        command("hit " + v1->query("id"));
        return "看来老太婆非得教训你一下不可。\n";
    }
    if (v1->query_temp("marks/萧")) {
        command("angry " + this_player()->query("id"));
        command("say 难道你想像萧秋水一样来个大闹唐门吗？\n");
        command("heng " + this_player()->query("id"));
        command("say 唐方那个死丫头！\n");
        this_player()->set_temp("marks/闹", 1);
        v1->delete_temp("marks/萧");
        return "萧秋水已被我关起来了！她别想再见到这个混小子了！\n";
    } else {
        return "瓜娃子，你说啥子？老太婆听不懂哦！\n";
    }
}
