    carry_object("/clone/misc/cloth")->wear();
    carry_object("/clone/misc/shoe")->wear();
}

void init() {
    add_action("do_recopy", "recopy");
}

int do_recopy(mixed arg1, mixed arg2) {
    arg1 = this_object();
    arg2 = this_player();
    if (arg1->query("winner") != arg2->query("id")) {
        return notify_fail("你无权更新本门师兄！\n");
    }
    if (time() - query("recopy_time") < 600) {
        return notify_fail("你刚刚才更新过，这么快又要更新了？\n");
    }
    set("recopy_time", time());
    do_clone(arg1, arg2);
    return 1;
}

int accept_fight(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_object();
    if (v1->query("winner") == arg->query("id")) {
        return notify_fail("你跟你自己打什么架？！\n");
    }
    if (v1->query("family/family_name") != arg->query("family/family_name")) {
        return notify_fail("你不是" + v1->query("family/family_name") + "弟子，不能向" + v1->name() + "挑战。\n");
    }
    if (wizardp(arg)) {
        return notify_fail("你是巫师，不能挑战掌门师兄。\n");
    }
    if (arg->query("betrayer")) {
        return notify_fail(v1->name() + "说道：你这背信弃义的家伙，没资格向我挑战。\n");
    }
    if (arg->query("level") < v1->query("level")) {
        return notify_fail("就凭你这微末得道行就想挑战掌门师兄？\n");
    }
    if (objectp(v2 = arg->query_temp("weapon"))) {
        return notify_fail("挑战掌门大师兄必须空手！难道你想杀人不成！？\n");
    }
    if (v1->is_fighting()) {
        return notify_fail("已经有人正在挑战掌门大师兄了！\n");
    }
    v1->set("eff_qi", v1->query("max_qi"));
    v1->set("qi", v1->query("max_qi"));
    v1->set("jing", v1->query("max_jing"));
    v1->set("neili", v1->query("max_neili"));
    remove_call_out("checking");
    call_out("checking", 1, v1, arg);
    return 1;
}

