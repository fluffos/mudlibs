        return 1;
    }
    return 1;
}

int do_copy(mixed arg1, mixed arg2) {
    seteuid(getuid());
    arg1->add("generation", 1);
    arg1->set("name", arg2->query("name"));
    arg1->set("title", arg2->query("family/family_name") + "第" + chinese_number(arg1->query("generation")) + "代掌门大师兄");
    arg2->set("title", arg1->query("family/family_name") + "第" + chinese_number(arg1->query("generation")) + "代掌门大师兄\e" + "[2;37;0m");
    remove_call_out("do_clone");
    call_out("do_clone", 0, arg1, arg2);
    return 1;
}

