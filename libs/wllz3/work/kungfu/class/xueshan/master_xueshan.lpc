        call_out("checking", 1, arg1, arg2);
        return 1;
    }
    if (!present(arg2, environment())) {
        return 1;
    }
    if (arg1->query("qi") * 100 / v1 <= 50) {
        command("say 果然厉害，恭喜你成为当今掌门大师兄！\n");
        command("chat 哈哈哈，到底是长江後浪推前浪，一代新人换旧人！\n");
