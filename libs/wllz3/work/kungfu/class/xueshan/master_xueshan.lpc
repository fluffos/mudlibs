    mixed v1;
    mixed v2;
    v1 = arg1->query("max_qi");
    v2 = arg2->query("max_qi");
    if (arg1->is_fighting(arg2)) {
        if (arg1->query("qi") * 100 / v1 <= 80) {
            command("exert recover");
