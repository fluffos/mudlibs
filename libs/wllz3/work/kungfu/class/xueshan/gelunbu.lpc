void init() {
    mixed v1;
    if (interactive(v1 = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (!arg->query_temp("作法事")) {
        return;
    }
    if (arg->query_temp("作法事") && arg->query_skill("lamaism", 1) > 50) {
        message_vision("葛伦布急急忙忙吩咐小喇嘛们往祭坛里填柴，倒酥油。\n\n", arg);
        message_vision("\e[1;31m$N点燃了祭坛中的木柴与酥油，熊熊烈火冲天而起。\n", arg);
        message_vision("\e[1;34m一丝魂魄升出祭坛，冉冉而起。魂魄受$N佛法感召，徘徊不去。\n", arg);
        message_vision("\e[31m$N端起颅钵吸进一口水，「噗」的一声猛地朝那熊熊火焰喷将过去。\n", arg);
        message_vision("\e[1;36m$N盘腿打坐，神光内蕴，口中念念有辞，渐渐有一丝魂魄在$N面前凝聚成形。\n", arg);
        message_vision("\e[1;32m魂魄越聚越多，竟然呈出人形！$N手指人形，口念真言，指引往生之路。\n", arg);
        message_vision("\e[1;37m$N手持法铃，边走变摇，高声诵读密传经咒。突然大喝一声。声似雷霆。\n", arg);
        message_vision("\e[1;33m大院里光芒四起，一声巨响过后，又恢复了平静。超度完毕。\n\e[2;37;0m", arg);
        arg->add_exp(arg, arg->query_skill("lamaism") * random(1) + 1);
        arg->add("shen", arg->quest_skill("lamaism"));
        arg->delete_temp("法事");
        arg->delete_temp("作法事");
        tell_object(arg, "你做完法事，心中感受到一阵阵安详的气息，心情舒畅了许多。\n");
        tell_object(arg, "你的经验和名望都有所增加了。\n");
    } else {
        message_vision("\e[1;31m\n$N不知道哪里找了个菜鸟煞有介事地来超度，看来是白忙了。\n\e[2;37;0m", arg);
        arg->delete_temp("作法事");
        arg->delete_temp("法事");
    }
}

void attempt_apprentice(mixed arg) {
    if (arg->query("gender") != "男性") {
        command("say 修习密宗内功需要纯阳之体。");
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "还是请回吧！");
        return;
    }
    command("say 我就传你一些武功吧！");
    command("recruit " + arg->query("id"));
    if (arg->query("class") != "lama") {
        arg->set("title", "雪山派俗家弟子");
    }
}

string ask_fashi() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (environment(this_object())->query("short") != "雪山寺山门") {
        return "这里正在做法事，你没看见麽？";
    }
    if (!(v1 = v2->query("family")) || v1["family_name"] != "雪山寺") {
        return "你是那里跳出来的毛虫，也能做个屁法事？";
    }
    if (v2->query_skill("lamaism", 1) < 50) {
        return "你的密宗心法还早得很呢，没法让你开坛做法事。";
    }
    v2->set_temp("法事", 1);
    return "这位上人是要给哪位施主做法事呀？";
}

int accept_object(mixed arg1, mixed arg2) {
    if (!arg1->query_temp("法事") && arg1->query("family/family_name") != "雪山派") {
        message_vision("葛伦布笑着对$N说：这种臭东西给我有什么用，您还是自己留着吧！\n", arg1);
        return 0;
    }
    if (arg2->query("id") == "corpse") {
        message_vision("葛伦布笑着对$N说：那我们去祭坛吧！\n", arg1);
        arg1->set_temp("作法事", 1);
        arg1->delete_temp("法事");
        command("go north");
        command("go west");
        command("go south");
        return 1;
    } else {
        message_vision("葛伦布对$N说：这种东西还能做法事？直接埋了省事。\n", arg1);
    }
    return 0;
}
