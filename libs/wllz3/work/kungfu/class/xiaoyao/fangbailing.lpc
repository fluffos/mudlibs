string ask_me() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!mapp(v3 = v1->query("family")) || v3["family_name"] != "逍遥派") {
        return "这位" + "/adm/daemons/rankd"->query_respect(v1) + "与我派素无来往，何来棋谱相赠一说？";
    }
    if (query("book_count") < 1) {
        return "你来晚了，棋谱我已经赠送给别入了。";
    }
    add("book_count", -1);
    command("say 好吧，那我就把它送给你了。\n");
    message_vision("\e[1;33m范百龄微笑着从怀中拿出了一本书，交了给$N。\n\e[2;37;0m", v1);
    v2 = clone_object("/clone/book/hand_book");
    v2->move(v1, 1);
    "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s得到了%s。", v1->name(), v2->name()));
    return "这本棋谱可千万不要随便给别人。\n";
}

void attempt_apprentice(mixed arg) {
    if (arg->query_dex() < 20) {
        command("say 我派凌波微步是以身法为主，你的身法太差，不适合修炼我派武功。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "的基本轻功是否还应该有所提高啊？");
        return;
    }
    if (arg->query_int() < 20) {
        command("say 我逍遥派武功最重视“逍遥”二字，何谓“逍遥”，这只能靠你自己去领悟。");
        command("say 但是" + "/adm/daemons/rankd"->query_respect(arg) + "的悟性似乎还有待提高啊。");
        return;
    }
    command("nod");
    command("say 好好，我就收下你吧！");
    command("recruit " + arg->query("id"));
    arg->set("class", "scholar");
}
