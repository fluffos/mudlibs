    }
    if (arg->query_skill("lingboweibu", 1) < 400) {
        command("say 本派的凌波微步最讲究身法，依我看" + "/adm/daemons/rankd"->query_respect(arg) + "的身法似乎还不够啊。");
        return;
    }
