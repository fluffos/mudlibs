void attempt_apprentice(mixed arg) {
    if (arg->query("gender") != "女性") {
        command("say 你找死啊！");
        return;
    }
    if (arg->query_skill("bahuang-gong", 1) < 400) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "是否还应该多练练八荒六合唯我独尊功？");
        return;
    }
    if (arg->query_con() < 70) {
        command("say 本门功法极为难练，依我看这位" + "/adm/daemons/rankd"->query_respect(arg) + "的根骨似乎还不够啊！");
        return;
    }
    command("say 那好吧！希望你日后能勤练武艺！否则我绝不饶你！");
    command("recruit " + arg->query("id"));
    if (arg->query("class") != "dancer") {
        arg->set("class", "dancer");
    }
    return;
}
