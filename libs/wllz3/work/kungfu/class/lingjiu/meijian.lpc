void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (arg->query("family/family_name") == "灵鹫宫") {
        message_vision("梅剑冲着$N点点头，微微笑了笑。\n", arg);
        return;
    }
    if (!arg->query("family/family_name")) {
        message_vision("梅剑冲着$N微笑说：你是来拜师的吧，拜我吧。\n", arg);
        return;
    }
}

void attempt_apprentice(mixed arg) {
    if (arg->query("gender") == "女性") {
        command("say 好吧，我就收下你了。");
        command("recruit " + arg->query("id"));
        if (arg->query("class") != "dancer") {
            arg->set("class", "dancer");
        }
        return;
    } else {
        command("say 灵鹫宫不收男弟子，这位" + "/adm/daemons/rankd"->query_respect(arg) + "还是请回吧！");
        return;
    }
}
