void attempt_apprentice(mixed arg) {
    if (arg->query("family/family_name") != "慕容世家") {
        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "与我慕容世家毫无瓜葛，何来拜师一说？");
