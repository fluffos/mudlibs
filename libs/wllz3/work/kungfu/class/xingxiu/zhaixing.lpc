void attempt_apprentice(mixed arg) {
    if (arg->query_skill("zhaixinggong", 1) < 300) {
        command("say 摘星功是星宿派的独门绝技之一，依我看，你的摘星功还未到火候呀！");
        return;
    }
    command("say 好吧，我就收下你了。");
    command("recruit " + arg->query("id"));
    set("class", "fighter");
}

string ask_me() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_player();
    if (!(v1 = v3->query("family")) || v1["family_name"] != "星宿派") {
        return "/adm/daemons/rankd"->query_respect(v3) + "与本派素无来往，不知此话从何谈起？";
    }
    if (query("dan_count") < 1) {
        return "你来晚了，没有炼心弹了。";
    }
    add("dan_count", -1);
    v2 = clone_object("/d/xingxiu/obj/lianxindan");
    v2->move(v3, 1);
    "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s得到了%s\e[1;34m！！", v3->name(), v2->name()));
    return "这些练心弹够你用的了吧。";
}

