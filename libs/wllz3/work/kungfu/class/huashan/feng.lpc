void attempt_apprentice(mixed arg) {
    if (arg->query("betrayer")) {
        command("say 依我看" + "/adm/daemons/rankd"->query_respect(arg) + "好象拜过别派的师傅？想来你也不适合学独孤九剑？");
        return;
    }
    if (arg->query("mud_age") - arg->query("feng_dietime") < 259200) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "你好象原来是我的徒弟麽？");
        return;
    }
    if (arg->query("family/family_name") != "华山剑派") {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "既然已有名师指点，何必又来拜老朽呢？");
        return;
    }
    if (arg->query_skill("sword", 1) < 200 || arg->query_skill("huashan-sword", 1) < 200) {
        command("say 我看" + "/adm/daemons/rankd"->query_respect(arg) + "的华山剑法还没学到家吧。");
        return;
    }
    if (arg->query_skill("force", 1) < 200 || arg->query_skill("huashan-neigong", 1) < 200) {
        command("say 我看" + "/adm/daemons/rankd"->query_respect(arg) + "的华山内功还没学到家吧。");
        return;
    }
    if (arg->query_skill("dodge", 1) < 200 || arg->query_skill("feiyan-huixiang", 1) < 200) {
        command("say 我看" + "/adm/daemons/rankd"->query_respect(arg) + "的飞燕回翔还没学到家吧。");
        return;
    }
    if (arg->query_skill("literate", 1) < 100) {
        command("say 我看" + "/adm/daemons/rankd"->query_respect(arg) + "的读书识字还没学到家吧。");
        return;
    }
    if (arg->query("shen") < 150000) {
        command("say 我华山剑派乃是堂堂名门正派，对弟子要求极严。");
        command("say 在德行方面，" + "/adm/daemons/rankd"->query_respect(arg) + "是否还做得不够？");
        return;
    }
    if (arg->query("kar") < 48) {
        command("say 依我看" + "/adm/daemons/rankd"->query_respect(arg) + "的资质似乎不适合学我独孤九剑？");
        return;
    }
    command("say 好吧，我就收下你了。");
    command("recruit " + arg->query("id"));
    if (arg->query("class") != "swordsman") {
        arg->set("class", "swordsman");
    }
}
