void attempt_apprentice(mixed arg) {
    if (arg->query("family") && arg->query("family/family_name") != "华山剑派") {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "既然已有名师指点，何必又来拜老朽呢？");
        return;
    }
    if (arg->query_skill("force", 1) < 150 || arg->query_skill("zixia-shengong", 1) < 150) {
        command("say 我看" + "/adm/daemons/rankd"->query_respect(arg) + "的紫霞神功还没学到家吧。");
        return;
    }
    if (arg->query_skill("dodge", 1) < 150 || arg->query_skill("feiyan-huixiang", 1) < 150) {
        command("say 我看" + "/adm/daemons/rankd"->query_respect(arg) + "的飞燕回翔还没学到家吧。");
        return;
    }
    if (arg->query("shen") < 50000) {
        command("say 我华山剑派乃是堂堂名门正派，对弟子要求极严。");
        command("say 在德行方面，" + "/adm/daemons/rankd"->query_respect(arg) + "是否还做得不够？");
        return;
    }
    if (arg->query("spi") < 25) {
        command("say 依我看" + "/adm/daemons/rankd"->query_respect(arg) + "灵性不足，恐怕难以习得气宗要领啊！");
        return;
    }
    command("say 好吧，我就收下你了。");
    command("recruit " + arg->query("id"));
    if (arg->query("class") != "swordman") {
        arg->set("class", "swordman");
    }
}
