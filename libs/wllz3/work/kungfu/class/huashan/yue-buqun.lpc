void attempt_apprentice(mixed arg) {
    if (query("apprentice_available")) {
        if (find_call_out("do_recruit") != -1) {
            command("say 慢著，一个一个来。");
        } else {
            do_recruit(arg);
        }
    } else {
        command("say 老夫今天已经收了三个弟子，不想再收徒了。");
    }
}

void do_recruit(mixed arg) {
    if (arg->query_int() < 20) {
        command("say 我华山剑派以剑法为主，依我看" + "/adm/daemons/rankd"->query_respect(arg) + "不适合于学剑法。");
    } else if (arg->query_skill("sword", 1) < 30) {
        command("say 我华山剑派以剑法为主，依我看" + "/adm/daemons/rankd"->query_respect(arg) + "在剑法方面还须多加练习才是。");
    } else {
        command("say 好，好，好，很好。");
        command("recruit " + arg->query("id"));
    }
}

int recruit_apprentice(mixed arg) {
    if (::recruit_apprentice(arg)) {
        add("apprentice_availavble", -1);
    }
}

