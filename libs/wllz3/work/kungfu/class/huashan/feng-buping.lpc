void attempt_apprentice(mixed arg) {
    if (query("apprentice_available")) {
        if (find_call_out("do_recruit") != -1) {
            command("say 慢著，一个一个来。");
        } else {
            call_out("do_recruit", 0, arg);
        }
    } else {
        command("say 老夫今天已经收了三个弟子，不想再收徒了。");
    }
}

void do_recruit(mixed arg) {
    if (arg->query("int") < 25) {
        command("say 我华山剑派以剑法为主，依我看" + "/adm/daemons/rankd"->query_respect(arg) + "不适合于学剑法。");
        return;
    }
    if (arg->query_skill("sword", 1) < 150) {
        command("say 我华山剑派以剑法为主，依我看" + "/adm/daemons/rankd"->query_respect(arg) + "的剑法还不到家啊！");
        return;
    }
    if (arg->query_skill("huashan-sword", 1) < 150) {
        command("say 狂风剑法是由华山剑法演练，依我看" + "/adm/daemons/rankd"->query_respect(arg) + "的华山剑法还不到家啊！");
        return;
    } else {
        command("say 好，我就收下你吧！");
        command("recruit " + arg->query("id"));
    }
}

int recruit_apprentice(mixed arg) {
    if (::recruit_apprentice(arg)) {
        arg->set("title", "华山剑宗第十四代弟子");
    }
    arg->set("class", "swordsman");
    add("apprentice_availavble", -1);
}

void reset() {
    set("apprentice_available", 3);
