        command("say 这位" + "/adm/daemons/rankd"->query_respect(arg) + "你还是找我夫君去吧。");
    } else {
        command("say 微笑道：好，好，只要你用心学，他日必有成就。");
        command("recruit " + arg->query("id"));
        arg->set("class", "swordsman");
    }
}

