void attempt_apprentice(mixed arg) {
    if (arg->query_int() < 20) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "天资欠聪，难学得我这一身武功。");
        return;
    }
    if (arg->query_dex() < 20) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "身手不捷，还是另求高师吧。");
        return;
    }
    if (arg->query("shen") > -5000) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "我日月教乃邪魔外道，你们这些伪君子我们不耻为伍。");
        return;
    }
    if (arg->query_skill("dodge", 1) < 100) {
        command("say 习武之人，最主要练好基本功。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "是否还应该在基本招架上多下点功夫？");
        return;
    }
    command("say 好吧，本座就收下你了，今后就跟着本座好好地干。");
    command("recruit " + arg->query("id"));
}

string ask_me() {
    mixed v1;
    mixed v2;
    if (!(v1 = this_player()->query("family")) || v1["family_name"] != "日月神教") {
        return "/adm/daemons/rankd"->query_respect(this_player()) + "与本教素无来往，不知此话从何谈起？";
    }
    if (query("book_count") < 1) {
        return "你来晚了，黑木令不在我处。";
    }
    add("book_count", -1);
    v2 = clone_object("/d/heimuya/npc/obj/heimuling");
    v2->move(this_player());
    return "\e[1;33m此牌限时一日，可不能随便交给别人，你好自为知吧。\e[2;37;0m";
}

void reset() {
    if (query("book_count") < 1) {
        set("book_count", 1);
    }
}
