void attempt_apprentice(mixed arg) {
    if (arg->query_int() < 30) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "走开走开，我不想和傻瓜说话。");
        return;
    }
    if (arg->query_dex() < 25) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "身手不捷，还是另求高师吧。");
        return;
    }
    if (arg->query("shen") > -50000) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "你还不够心狠手辣，我还不能收你。");
        return;
    }
    if (arg->query_skill("dodge", 1) < 300) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "基本闪躲好象还不够啊？");
        return;
    }
    command("say 哈哈！ 那我就收下你吧。");
    command("recruit " + arg->query("id"));
}

int accept_fight(mixed arg) {
    command("say 既然这位" + "/adm/daemons/rankd"->query_respect(arg) + "要比武的话，就莫怪我杀你了！");
    command("say 看我吸心大法.......");
    command("chat 几经风沙武艺深，奈何到头费长身...唉！又一个送死的来了！");
    kill_ob(arg);
    return 1;
}

string ask_me() {
    mixed v1;
    mixed v2;
    if (!(v1 = this_player()->query("family")) || v1["family_name"] != "日月神教") {
        return "/adm/daemons/rankd"->query_respect(this_player()) + "与本教素无来往，不知此话从何谈起？";
    }
    if (query("book_count") < 1) {
        return "你来晚了，吸星大法密籍不在我处。";
    }
    add("book_count", -1);
    v2 = clone_object("/d/heimuya/npc/obj/xxdafa");
    v2->move(this_player());
    "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s拿到吸星大法啦！", this_player()->name()));
    return "\e[1;33m你拿去吧，早日练成魔功，光大日月。\e[2;37;0m";
}

void init() {
    mixed v1;
    v1 = this_player();
    if ((v1->query("shen") >= 0 || v1->query("score") < 0) && v1->query("family/master_id") == "ren woxing") {
        command("say " + v1->query("name") + "！黑木崖不要你这没用的东西。\n");
        command("hit " + v1->query("id"));
    }
}
