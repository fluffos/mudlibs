int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2->query("name") == "金创药" || arg2->query("name") == "\e[1;33m金创药\e[2;37;0m") {
        message_vision("向问天对$N说到：谢谢你了，我这封书信给你上黑木崖行个方便。\n", arg1);
        v1 = clone_object("/d/heimuya/npc/obj/shuxin");
        v1->move(arg1);
        message("channel:rumor", "\e[1;34m【武林传奇】某人：" + arg1->name() + "拿到向问天书信啦！\n\e" + "[2;37;0m", users());
        return 1;
    }
}

void attempt_apprentice(mixed arg) {
    if (arg->query_int() < 25) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "天资欠聪，难学得我这一身武功。");
        return;
    }
    if (arg->query_dex() < 25) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "身手不捷，还是另求高师吧。");
        return;
    }
    if (arg->query_str() < 25) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "臂力不够，请走吧。");
        return;
    }
    if (arg->query_skill("dodge", 1) < 200) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "基本闪躲好象还不够啊？");
        return;
    }
    if (arg->query("shen") > -10000) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "我日月教乃邪魔外道，你们这些伪君子我们不耻为伍。");
        return;
    }
    command("say 好吧，本座就收下你了，今后就跟着本座好好地干。");
    command("recruit " + arg->query("id"));
}
