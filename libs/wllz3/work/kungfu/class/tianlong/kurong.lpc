    } else {
        say("\n枯荣大师说道：恭喜你闯过了六脉剑阵！ \n");
        if (query("book_count")) {
            add("book_count", -1);
        }
        v1 = clone_object("/clone/book/six_book");
        v1->move(this_player());
        command("好吧，这本「六脉神剑谱」你就拿去吧。说着惨然一笑。\n");
        "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("%s获得了六脉神剑谱啦！！", this_player()->name()));
    }
