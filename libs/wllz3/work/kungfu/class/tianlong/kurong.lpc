int ask_me() {
    if (this_player()->query_temp("marks/find_temp") && this_player()->query_temp("marks/ask_temp3")) {
        say("枯荣看了" + this_player()->name() + "一眼，说道：\n这位施主果然聪明，施主若能胜过老衲就可得到六脉神剑谱。\n");
        return 1;
    }
}

int accept_fight(mixed arg) {
    mixed v1;
    v1 = this_object();
    if (arg->query_temp("marks/find_temp") && arg->query_temp("marks/ask_temp3") && !arg->query_temp("fight_with_me")) {
        say(arg->name() + "对枯荣说：好吧，那我就同你切搓几招吧，点到为止。\n");
        arg->set_temp("fight_with_me", 1);
        remove_call_out("checking");
        call_out("checking", 1, v1, arg);
        return 1;
    } else {
        return 0;
    }
}

