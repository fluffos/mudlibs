int do_back(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    message("vision", "\n枯荣大师挥了挥手，回身步入摩尼堂。\n", environment(arg));
    if (!(v2 = find_object("/d/tianlongsi/banruotai"))) {
        v2 = find_object("/d/tianlongsi/banruotai", 1);
    }
    v2->set("exits/north", "/d/tianlongsi/doushuai");
    v2->set("exits/south", "/d/tianlongsi/munitang");
    if (!(v2 = find_object("/d/tianlongsi/baodian"))) {
        v2 = find_object("/d/tianlongsi/baodian", 1);
    }
    if (!(v3 = find_object("/d/tianlongsi/munitang"))) {
        v3 = find_object("/d/tianlongsi/munitang", 1);
    }
    objectp(v1 = present("ben yin", v3));
    v1->move(v2);
    arg->delete("assigned_fighter");
    arg->set("fighttime", time());
    this_object()->move("/d/tianlongsi/munitang");
    return 1;
}

string ask_join() {
    mixed v1;
    v1 = this_player();
    if (v1->query("class") == "bonze") {
        return "阿弥陀佛！你我同是出家人，何故跟贫僧开这等玩笑？\n";
    }
    if (v1->query("gender") != "男性") {
        return "阿弥陀佛！善哉！善哉！女施主若真心皈依我佛，可去后山庵里受戒。\n";
    }
    v1->set_temp("pending/join_bonze", 1);
    return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。\n";
}

int do_kneel() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (!v1->query_temp("pending/join_bonze")) {
        return 0;
    }
    message_vision("$N双手合十，恭恭敬敬地跪了下来。\n\n$n说偈道：\n“一微尘中入三昧，成就一切微尘定，而彼微尘亦不增，于一普现难思刹。”\n手掌提起，$N满头乌发尽数落下，头顶光秃秃地更无一根头发，便是用剃刀来剃亦无这等干净。\n\n", v1, this_object());
    v2 = v1->query("name");
    v3 = "本" + v2[0..1];
    command("say 从今以后你的法名叫做" + v3 + "。");
    command("smile");
    v1->delete_temp("pending/join_bonze");
    v1->set("byname", v3);
    v1->set("class", "bonze");
    v1->set("K_record", v1->query("PKS") + v1->query("MKS"));
    v1->set("shen_record", v1->query("shen"));
    v1->set("shen", 0);
    return 1;
}

void attempt_apprentice(mixed arg) {
    if (arg->query("gender") != "男性") {
        command("say 阿弥陀佛！女施主呀，贫僧可不敢开这等玩笑啊。");
        return;
    }
    if (arg->query("class") != "bonze") {
        command("say 阿弥陀佛！贫僧不收俗家弟子。");
        return;
    }
    if (arg->query_skill("kurong-changong", 1) < 150) {
        command("say 你内功修为还不到火候，进天龙寺也是徒劳。\n");
        return;
    }
    command("say 阿弥陀佛，善哉！善哉！");
    command("recruit " + arg->query("id"));
}

void reset() {
    this_object()->delete("fighttime");
}
