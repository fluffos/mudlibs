        return 1;
    }
    if (!present(arg2, environment())) {
        return 1;
    }
    if (arg1->query("qi") * 100 / v2 <= 50) {
        say("枯荣说：施主身手果然不凡，老衲佩服。六脉神剑谱是没有的了，这本一阳指诀你先拿去吧。\n");
        v1 = clone_object("/clone/book/sun_book");
        v1->move(arg2);
        "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("%s获得一阳指诀了！！", this_player()->name()));
        message_vision("$N交给$n一本书。\n", arg1, arg2);
        return 1;
    }
    if (arg2->query("qi") * 100 / v3 < 50) {
        say("枯荣双手合十道：尘缘一切自心起，施主请回吧。\n");
        message_vision("$N对枯荣大师恭恭敬敬地磕了一个头，离开牟尼堂。\n", arg2);
        arg2->move("/d/tianlongsi/banruotai");
