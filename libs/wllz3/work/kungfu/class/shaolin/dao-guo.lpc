void init() {
    mixed v1;
    mixed v2;
    v1 = this_object();
    ::init();
    if (objectp(v2 = present("mu ren", environment()))) {
        remove_call_out("repairing_1");
        call_out("repairing_1", 5, v1, v2);
    }
}

int repairing_1(mixed arg1, mixed arg2) {
    if (!present(arg2, environment())) {
        return 1;
    }
    command("say 是这个木人吧？ 唔，我来瞧瞧！ 你在边上呆着，看能帮我什么忙。");
    remove_call_out("repairing_2");
    call_out("repairing_2", random(3) + 2, arg1, arg2);
    return 1;
}

int repairing_2(mixed arg1, mixed arg2) {
    if (!present(arg2, environment())) {
        return 1;
    }
    if (arg2->query("damaged")) {
        message_vision("\e[32m\n道果禅师对着木人瞧了一会，又试着扳动木人的四肢和脑袋，嘴里喃喃念叨着什么。\n\n\e[2;37;0m", arg1);
        remove_call_out("repairing_3");
        call_out("repairing_3", random(2) + 2, arg1, arg2);
    } else {
        command("say 这木人好端端地又没坏！ 还大老远地拖着我过来！");
        command("follow none");
        message_vision("\e[32m\n道果禅师气鼓鼓地走了。\n\e[2;37;0m", arg1);
        arg1->move("/d/shaolin/guangchang3");
        remove_call_out("do_back");
        call_out("do_back", random(15), arg1);
    }
    return 1;
}

int repairing_3(mixed arg1, mixed arg2) {
    command("say 唔，原来如此，我来修修看吧！");
    message_vision("\e[32m\n他接着从怀里掏出一大堆工具来，打开木人的身体，摆弄了几下。\n\n\e[2;37;0m", arg1);
    remove_call_out("repairing_4");
    call_out("repairing_4", random(3) + 3, arg1, arg2);
    return 1;
}

int repairing_4(mixed arg1, mixed arg2) {
    if (!random(2)) {
        command("say 好，修好了！");
        arg2->delete("damaged");
        arg2->set("fight_times", 0);
        message_vision("\e[32m\n木人的身体吱吱地扭动了几下，恢复了正常站立的姿态。\n\n\e[2;37;0m", arg1);
    } else {
        message_vision("\e[32m\n道果禅师叹了口气，说道：看来不行，这木人损坏得太厉害了，没法子修了！\n\e[2;37;0m", arg1);
    }
    command("say 好，那我走了！");
    command("wave");
    command("follow none");
    message_vision("\e[32m\n道果禅师走了出去。\n\e[2;37;0m", arg1);
    arg1->move("/d/shaolin/guangchang3");
    remove_call_out("do_back");
    call_out("do_back", random(15), arg1);
    return 1;
}

int do_back(mixed arg) {
    arg->move("/d/shaolin/twdian");
    return 1;
}

string ask_me() {
    mixed v1;
    mixed v2;
    v2 = this_player();
    if (!(v1 = v2->query("family")) || v1["family_name"] != "少林派") {
        return "/adm/daemons/rankd"->query_respect(v2) + "与本派素无来往，不知此话从何谈起？";
    }
    command("say 木人打坏了是吧？ 好吧，我跟你去看看。");
    command("follow " + v2->query("id"));
    return "我们走罢！\n";
}
