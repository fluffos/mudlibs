int accept_object(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_object();
    v2 = v1->query("family");
    v3 = arg1->query("family");
    if (arg1->query_temp("have_letter") && present("tuijian xin1", arg1)) {
        command("say 怎麽样，你拿我的推荐信去拜师了吗？");
        return 0;
    }
    if (arg2->query("id") == "damo ling" && v3["generation"] == v2["generation"] + 1 && !arg1->query_temp("have_letter")) {
        arg1->set_temp("fight_ok", 1);
        command("say 好，既然已得到方丈许可，我们就来验证一下武功。");
        return 1;
    }
    command("smile");
    command("say 这东西给我可没有什麽用。");
    command("give " + arg2->query("id") + " to " + v1->query("id"));
    return 0;
}

int accept_fight(mixed arg) {
    mixed v1;
    v1 = this_object();
    if (!arg->query_temp("fight_ok")) {
        return 0;
    }
    remove_call_out("checking");
    call_out("checking", 1, v1, arg);
    arg->delete_temp("fight_ok");
    return 1;
}

int checking(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    v2 = arg1->query("max_qi");
    v3 = arg2->query("max_qi");
    if (arg1->is_fighting()) {
        call_out("checking", 2, arg1, arg2);
        return 1;
    }
    if (!present(arg2, environment())) {
        return 1;
    }
    if (arg1->query("qi") * 100 / v2 <= 50) {
        command("say 青出於蓝胜於蓝，不愧是少林寺的佳弟子 ! 恭喜你了 !\n");
        message_vision("$N交给$n一封推荐信。\n", arg1, arg2);
        arg2->set_temp("have_letter", 1);
        v1 = clone_object("/d/shaolin/obj/tuijianxin-1");
        v1->move(arg2, 1);
        return 1;
    }
    if (arg2->query("qi") * 100 / v3 < 50) {
        command("say 看来" + "/adm/daemons/rankd"->query_respect(arg2) + "还得多加练习，方能在少林诸多弟子中出人头地 !\n");
        return 1;
    }
    return 1;
}

void attempt_apprentice(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_object();
    v3 = v1->query("family");
    if (!(v2 = arg->query("family")) || v2["family_name"] != "少林派") {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "与本派素无来往，不知此话从何谈起？");
        return;
    }
    if (arg->query("class") != "bonze" && v2["family_name"] == "少林派") {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "是俗家弟子，不能在寺内学艺。");
        return;
    }
    if (!v2["generation"]) {
        command("say 阿弥陀佛！贫僧就收下你做我的弟子了。");
        command("recruit " + arg->query("id"));
        return;
    }
    if (v2["generation"] == v3["generation"] + 1) {
        command("say " + v2["master_name"] + "的徒弟怎麽跑到我这儿来了，哈哈哈！");
        command("recruit " + arg->query("id"));
    }
    if (v2["generation"] <= v3["generation"]) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "，贫僧哪里敢当！");
        return;
    }
    return;
}
