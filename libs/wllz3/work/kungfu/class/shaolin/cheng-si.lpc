        call_out("checking", 2, arg1, arg2);
        return 1;
    }
    if (!present(arg2, environment())) {
        return 1;
    }
    if (arg1->query("qi") * 100 / v2 <= 50) {
        command("say 青出於蓝胜於蓝，不愧是少林寺的佳弟子！恭喜你了！\n");
        message_vision("$N交给$n一封推荐信。\n", arg1, arg2);
        arg2->set_temp("have_letter", 1);
        v1 = clone_object("/d/shaolin/obj/tuijianxin-4");
