string ask_for_join() {
    mixed v1;
    v1 = this_player();
    if (v1->query("class") == "bonze") {
        return "阿弥陀佛！你我同是出家人，何故跟贫僧开这等玩笑？\n";
    }
    if (v1->query("gender") != "男性") {
        return "阿弥陀佛！善哉！善哉！女施主若真心皈依我佛，可去后山庵里受戒。\n";
    }
    v1->set_temp("pending/join_bonze", 1);
    return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。\n";
}

int do_kneel() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    v2 = ({ "虚", "空", "明", "净" });
    if (!v1->query_temp("pending/join_bonze")) {
        return 0;
    }
    message_vision("$N双手合十，恭恭敬敬地跪了下来。\n\n$n伸出手掌，在$N头顶轻轻地摩挲了几下，将$N的头发尽数剃去。\n\n", v1, this_object());
    v3 = v1->query("name");
    v4 = v2[random(sizeof(v2))] + v3[0..1];
    command("say 从今以后你的法名叫做" + v4 + "。");
    command("smile");
    v1->delete_temp("pending/join_bonze");
    v1->set("byname", v4);
    v1->set("class", "bonze");
    v1->set("K_record", v1->query("PKS"));
    v1->set("shen_record", v1->query("shen"));
    v1->set("shen", 0);
    return 1;
}

