    if (arg->query("gender") != "女性") {
        command("say 我只收女弟子。");
        return;
    }
    if (arg->query("shen") < 100000) {
        command("say 我大理段氏向来行侠仗义，您请回吧！");
        return;
    }
    if (strsrch(v1, "大理镇南王府") >= 0) {
        command("say 很好，既然入我门来就得终身为奴供我驱使。");
        command("recruit " + arg->query("id"));
        arg->set("dali_title", v1);
    } else {
        command("say 你是何人，如此大胆，假冒我府中厮仆！");
        return;
    }
}
