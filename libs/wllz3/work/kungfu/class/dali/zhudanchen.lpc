int ask_for_toushen() {
    mixed v1;
    v1 = this_player();
    if (v1->query("gender") == "无性") {
        command("say 公公？我们府里不收公公。");
        return 1;
    }
    if (v1->query_str() < 40) {
        command("say 这位" + "/adm/daemons/rankd"->query_respect(v1) + "这么文弱，怎么能在府里承值？");
        return 1;
    }
    command("say 这位" + "/adm/daemons/rankd"->query_respect(v1) + "就委屈你先在府里听用吧。\n");
    v1->set("dali_title", "大理镇南王府家奴");
    return 1;
}

int ask_me() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_object();
    v2 = this_player();
    if (v2->query_skill("kurong-changong", 1) < 200) {
        command("say 你想当卫士，再练几年功吧。");
        return 1;
    }
    v1 = v2->query("dali_title");
    if (strsrch(v1, "大理镇南王府家臣") >= 0) {
        v2->set_temp("fight_ok", 1);
        command("say 好，既然如此想切磋，那就看你的本事如何了。");
        return 1;
    } else {
        command("say 只有家臣才能升卫士。");
        return 1;
    }
}

int accept_fight(mixed arg) {
    mixed v1;
    v1 = this_object();
    if (!arg->query_temp("fight_ok")) {
        return 0;
    }
    remove_call_out("checking");
    call_out("checking", 1, v1, arg);
    arg->delete_temp("fight_ok");
    return 1;
}

int checking(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = arg1->query("max_qi");
    v2 = arg2->query("max_qi");
    if (arg1->is_fighting()) {
        call_out("checking", 2, arg1, arg2);
        return 1;
    }
    if (!present(arg2, environment())) {
        return 1;
    }
    if (arg1->query("qi") * 100 / v1 <= 50) {
        command("say 青出於蓝胜於蓝，不愧是大理段家的好弟子！恭喜你了！\n");
        command("say 你的已经可以胜任大理卫士！");
        upgrade_title(arg2, "\e[1;36m大理镇南王府卫士\e[2;37;0m");
        return 1;
    }
    if (arg2->query("qi") * 100 / v2 < 50) {
        command("say 看来" + "/adm/daemons/rankd"->query_respect(arg2) + "还得多加练习，方能在大理段家诸多弟子中出人头地！");
        return 1;
    }
    return 1;
}

void upgrade_title(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg2 + clear_title(arg1->query("dali_title"));
    arg1->set("dali_title", "\e[1;36m" + v1 + "\e" + "[2;37;0m");
}

string clear_title(mixed arg) {
    if (strsrch(arg, "大理镇南王府家臣") >= 0) {
        arg = replace_string(arg, "大理镇南王府家臣", "");
    }
    return arg;
}

void attempt_apprentice(mixed arg) {
    if (arg->query("dali_title") != "大理镇南王府家奴") {
        command("shake " + this_player()->query("id"));
        command("say 我早已投身大理为臣，不再涉足江湖俗务，不能收徒了。");
        return;
    }
    if (arg->query("shen") < 0) {
        command("say 我大理段氏向来不与您这种黑道人物打交道，您请回吧！");
        return;
    }
    if (arg->query("betrayer")) {
        command("say 我大理段府从不和江湖人士打交道。");
        return;
    }
    command("say 很好，很好。既已入府，便当尽忠报主，这条性命也就不是自己的了。");
    command("recruit " + arg->query("id"));
    if (arg->query("gender") == "男性") {
        arg->set("dali_title", "大理镇南王府家丁");
    } else {
        arg->set("dali_title", "大理镇南王府婢女");
    }
}
