void attempt_apprentice(mixed arg) {
    mixed v1;
    v1 = arg->query("dali_title");
    if (arg->query_skill("kurong-changong", 1) < 200) {
        command("say 你的本门内功心法太低了，还是努努力先提高一下吧。");
        return;
    }
    if (arg->query("shen") < 100000) {
        command("say 我大理段氏向来行侠仗义，您请回吧！");
        return;
    }
    if (arg->query("family/family_name") == "大理段家") {
        command("say 很好，既然入我门来就得终身为奴供我驱使。");
        command("recruit " + arg->query("id"));
        arg->set("dali_title", v1);
    } else {
        command("say 你是何人，如此大胆，假冒我府中厮仆！");
        return;
    }
}

int ask_me() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_object();
    v2 = this_player();
    if (v2->query_skill("kurong-changong", 1) < 200) {
        command("say 你的武功恐怕是不能胜任武将的薪俸，再练几年功夫吧。\n");
        return 1;
    }
    v1 = v2->query("dali_title");
    if (strsrch(v1, "大理镇南王府卫士") >= 0) {
        v2->set_temp("fight_ok", 1);
        command("say 好，既然如此想切磋，那就看你的本事如何了。\n");
        return 1;
    } else {
        command("say 只有卫士才能升武将。\n");
        return 1;
    }
}

int accept_fight(mixed arg) {
    mixed v1;
    v1 = this_object();
    if (!arg->query_temp("fight_ok")) {
        return 0;
    }
    remove_call_out("checking");
    call_out("checking", 1, v1, arg);
    arg->delete_temp("fight_ok");
    return 1;
}

int checking(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = arg1->query("max_qi");
    v2 = arg2->query("max_qi");
    if (arg1->is_fighting()) {
        call_out("checking", 2, arg1, arg2);
        return 1;
    }
    if (!present(arg2, environment())) {
        return 1;
    }
    if (arg1->query("qi") * 100 / v1 <= 50) {
        command("say 青出於蓝胜於蓝，不愧是大理段家的好弟子！恭喜你了！\n");
        command("say 你的已经可以胜任大理武将！\n");
        upgrade_title(arg2, "大理镇南王府武将");
        return 1;
    }
    if (arg2->query("qi") * 100 / v2 < 50) {
        command("say 看来" + "/adm/daemons/rankd"->query_respect(arg2) + "还得多加练习，方能在大理段家诸多弟子中出人头地！\n");
        return 1;
    }
    return 1;
}

void upgrade_title(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg2 + clear_title(arg1->query("dali_title"));
    arg1->set("dali_title", v1);
}

string clear_title(mixed arg) {
    if (strsrch(arg, "大理镇南王府卫士") >= 0) {
        arg = replace_string(arg, "大理镇南王府卫士", "");
    }
    return arg;
}
