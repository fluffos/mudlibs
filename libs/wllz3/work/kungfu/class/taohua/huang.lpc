    if (this_player()->query_skill("music", 1) < 120) {
        return "我桃花岛弟子都是文雅之人，这位" + "/adm/daemons/rankd"->query_respect(this_player()) + "的五音十二律还需要多多研究呀。";
    }
    add("get_yuxiao", -1);
