void attempt_apprentice(mixed arg) {
    if (arg->query_skill("literate", 1) < 60) {
        command("say 你的学问太低了,还是努努力先提高一下吧!");
        return;
    }
    if (arg->query("shen") > 0) {
        command("say 我神龙教与世隔绝，向来不与您这种白道人物打交道，您请回吧！");
        return;
    }
    command("say 很好，很好。");
    command("recruit " + arg->query("id"));
}

string ask_me() {
    mixed v1;
    mixed v2;
    mixed v3;
    v3 = this_player();
    if (!(v1 = v3->query("family")) || v1["family_name"] != "神龙教") {
        return "/adm/daemons/rankd"->query_respect(v3) + "与本教素无来往，不知此话从何谈起？";
    }
    if (query("book_count") < 1) {
        return "你来晚了，本教的秘籍不在此处。";
    }
    add("book_count", -1);
    if (!random(2)) {
        v2 = clone_object("/clone/book/shoufa");
    } else {
        v2 = clone_object("/clone/book/bufa");
    }
    v2->move(v3);
    "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s得到了%s。", v3->name(), v2->name()));
    return "好吧，这本「" + v2->query("name") + "」你拿回去好好钻研。";
}
