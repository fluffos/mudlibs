            set("qk_trigger", 1);
        }
    }
    return 1;
}

void attempt_apprentice(mixed arg) {
    if (arg->query("party/party_name") != "\e[1;32m明教\e[2;37;0m") {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "与本教素无来往，不知此话从何谈起？");
        return;
    } else {
        command("party 本法王又得一可塑之才，真是可喜可贺！");
        command("say 恭喜你荣升为明教护法！");
        command("recruit " + arg->query("id"));
    }
}
