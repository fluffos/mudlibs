void init() {
    mixed v1;
    if (interactive(this_player()) && this_player()->query_temp("fighting")) {
        "/adm/daemons/combatd"->do_attack(this_object(), this_player(), query_temp("weapon"));
        this_player()->add_temp("beat_count", 1);
    }
    if (interactive(v1 = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
}

void greeting(mixed arg) {
    if (!arg || environment(arg) != environment()) {
        return;
    }
    if (arg->query("shen") < -50000) {
        command("say 邪魔歪道！受死吧！");
        command("wield yitian jian");
        this_object()->kill_ob(arg);
    } else if (arg->query("shen") < -5000) {
        command("say 魔从心起，于武学不利，其道必诛，劝君放下屠刀，立地成佛。");
    } else if (arg->query("shen") < -100) {
        command("say 这位朋友，人行江湖，言行当正，切务走进邪魔歪道。");
    } else if (arg->query("shen") >= 0) {
        command("say 光明正道任人走，劝君多加保重。");
    } else if (arg->query("shen") > 100000) {
        command("say 大侠在上，受无忌一礼，" + "/adm/daemons/rankd"->query_respect(arg) + "它日必为武林翘楚。");
    }
    return;
}

void attempt_apprentice(mixed arg) {
    if (arg->query("int") < 20) {
        command("say 你的悟性太低了，不适合学习我的功夫。");
        return;
    }
    if (arg->query("gender") == "无性") {
        command("say 你阳气不足，习我功夫恐将走火如魔。");
        return;
    }
    if (arg->query("shen") <= 200000) {
        command("say 你应当多作些行侠仗义的事，以修身心。");
        return;
    }
    if (arg->query_skill("jiuyang-shengong", 1) < 200) {
        command("say 你的九阳神功还未到火候，无法再学习上乘的武功！");
        return;
    }
    command("say 好，我就收下你这位好徒弟！");
    command("say 你的职司就是本教的光明使者。");
    command("recruit " + arg->query("id"));
    return;
}

int accept_fight(mixed arg) {
    if (arg->query("level") < 50 && arg->query("shen") > 0) {
        command("say 武林中人最忌争强斗狠，你不是我的对手，回去吧。\n");
        return 0;
    }
    return 1;
}

