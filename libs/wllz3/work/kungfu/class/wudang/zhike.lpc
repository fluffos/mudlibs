void init() {
    mixed v1;
    if (interactive(v1 = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, v1);
    }
    add_action("do_volunteer", "volunteer");
}

void greeting(mixed arg) {
    mixed v1;
    if (!arg || environment() != environment(arg)) {
        return;
    }
    v1 = arg->query("family");
    if (!v1 || v1["family_name"] != "武当派") {
        say("知客道长笑咪咪地说：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，欢迎到武当来，进来喝杯茶，歇歇腿吧。\n");
    } else {
        say("知客道长笑咪咪地说：这位" + "/adm/daemons/rankd"->query_respect(arg) + "，一路辛苦了。\n");
    }
    return;
}

void attempt_apprentice(mixed arg) {
    if (arg->query("guarded") < 1) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "你对我武当派尽了多少心力，有几分忠心呢？");
        return;
    }
    if (arg->query("shen") < 0) {
        command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
        command("say 在德行方面，" + "/adm/daemons/rankd"->query_respect(arg) + "是否还做得不够？");
        return;
    }
    command("say 好吧，贫道就收下你了。");
    command("recruit " + arg->query("id"));
}

int do_volunteer() {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (v1->query_temp("in_guard")) {
        return notify_fail("知客道长对你说：你专心守好山门，别想打两份工。\n");
    }
    v2 = users();
    v3 = sizeof(v2);
    while (v3 > 0) {
        if (v2[v3 - 1]->query_temp("in_guard")) {
            return notify_fail("知客道长对你说：已经有人守山门了，你一会再来吧。\n");
        }
        v3--;
    }
    tell_room(environment(v1), v1->query("name") + "开始在武当山门值守。\n");
    v1->set("guard", "\e[1;32m山门守卫\e[2;37;0m");
    v1->set_temp("in_guard", 1);
    v1->save();
    remove_call_out("end_guard");
    call_out("end_guard", 120, v1);
    remove_call_out("clone_meng");
    call_out("clone_meng", 30, v1);
    return 1;
}

void clone_meng(mixed arg) {
    mixed v1;
    if (arg) {
        tell_room(environment(arg), "山下突然冲上来一伙蒙面大汉。\n");
        v1 = clone_object("/d/wudang/npc/mengmian.lpc");
        v1->move("/d/wudang/xuanyuegate");
        call_out("clone_meng", 100, arg);
    }
}

void end_guard(mixed arg) {
    if (arg) {
        arg->delete("guard");
        arg->add("guarded", 1);
        arg->add_exp(arg, 10);
        arg->add_points(arg, 5);
        arg->delete_temp("in_guard");
        arg->save();
        remove_call_out("clone_meng");
        tell_room(environment(arg), arg->query("name") + "在武当山门值守期已满。\n");
        tell_object(arg, "你在武当山门值守期已满。\n");
    }
}

void die() {
    mixed v1;
    mixed v2;
    v1 = users();
    for (v2 = 0; v2 < sizeof(v1); v2++) {
        v1[v2]->delete_temp("in_guard");
    }
    ::die();
}
