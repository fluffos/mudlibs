    create_family("武当派", 5, "弟子");
    set("chat_chance", 2);
    set("chat_msg", ({ "知客道长说道：我武当地灵人杰，香火鼎盛，普天下的人都来朝拜敬香。\n", "知客道长说道：玄岳门乃武当出入门户，我等一定要精心守卫(volunteer)，不可丝毫懈殆。\n" }));
