void attempt_apprentice(mixed arg) {
    if (arg->query("guarded") < 5) {
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "你对我武当派尽了多少心力，有几分忠心呢？");
        return;
    }
    if (arg->query_skill("taiji-shengong", 1) < 400) {
        command("say 我武当派乃内家武功，最重视内功心法。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "是否还应该在太极神功上多下点功夫？");
        return;
    }
    if (arg->query_skill("taoism", 1) < 400) {
        command("say 我武当派乃道家武功，高深的武功离不开道学心法。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "是否还应该多读读道德经？");
        return;
    }
    if (arg->query("shen") < 200000) {
        command("say 学武之人，德义为先，功夫的高低倒还在其次，未练武，要先学做人。");
        command("say 在德行方面，" + "/adm/daemons/rankd"->query_respect(arg) + "是否还做得不够？");
        return;
    }
    if (arg->query_int() < 30) {
        command("say 我武当派武功全从道藏悟出。");
        command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");
        command("say " + "/adm/daemons/rankd"->query_respect(arg) + "的悟性还大有潜力可挖，还是请回吧。");
        return;
    }
    command("chat 哈哈哈哈！！！！");
    command("chat 想不到老道在垂死之年，又觅得一个可塑之才，真是可喜可贺。");
    command("recruit " + arg->query("id"));
}

string ask_zhang() {
    mixed v1;
    v1 = this_player();
    if (v1->query("marks/张三丰")) {
        return "多谢这位" + "/adm/daemons/rankd"->query_respect(v1) + "为岱岩寻来了黑玉断续膏。";
    }
    if (v1->query_temp("ask_zhangsanfeng")) {
        return "希望你能早日寻得黑玉断续膏，为岱岩解除痛苦。";
    }
    v1->set_temp("ask_zhangsanfeng", 1);
    return "岱岩自从参加赛刀大会回来之后，就被人打伤，至今仍旧半身不隧，唯有\n我天天为他传以真气续命。听说汝阳王府的赵敏有一种疗伤圣药“黑玉断续膏”，\n可以治好岱岩的伤，可是我从未和汝阳王府的人打交道 .....";
}

int accept_object(mixed arg1, mixed arg2) {
    if (arg2->query("name") == "\e[1;30m黑玉断续膏\e[2;37;0m" && arg1->query_temp("ask_zhangsanfeng") && arg2->query("give_to") == arg1 && arg1->query_temp("fight_win_zhao") > 1) {
        message_vision("$N连忙道谢：多谢这位" + "/adm/daemons/rankd"->query_respect(arg1) + "，岱岩的病有的救了。\n", this_object());
        if (!arg1->query("marks/张三丰")) {
            tell_object(arg1, "由于你替张三丰找到了黑玉断续膏，治好了俞岱岩的伤。\n");
            tell_object(arg1, "你的潜能增加了 2000 点，江湖威望也有所提高了。\n");
            arg1->add("learned_points", -2000);
            arg1->add("weiwang", 100);
            arg1->set("marks/张三丰", 1);
            arg1->delete_temp("ask_zhangsanfeng");
            arg1->delete_temp("fight_win_zhao");
            "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说%s(%s)替张三丰找到了黑玉断续膏，得到了一些奖励。", arg1->name(), arg1->query("id")));
        }
        return 1;
    }
}

