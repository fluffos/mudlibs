int valid_enable(mixed arg) {
    return arg == "hand" || arg == "parry";
}

int valid_combine(mixed arg) {
    return arg == "tanzhi-shentong";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练兰花拂穴手必须空手。\n");
    }
    if (arg->query_skill("bibo-shengong", 1) < 20) {
        return notify_fail("你的碧波神功火候不够，无法学兰花拂穴手。\n");
    }
    if (arg->query("max_neili") < 200) {
        return notify_fail("你的内力太弱，无法练兰花拂穴手。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("lanhua-shou", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练兰花拂穴手必须空手。\n");
    }
    if (arg->query("qi") < 30) {
        return notify_fail("你的体力太低了，无法练兰花拂穴手。\n");
    }
    arg->receive_damage("qi", 25);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/lanhua-shou/" + arg;
}
