int valid_enable(mixed arg) {
    return arg == "parry" || arg == "finger";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练六脉神剑必须空手。\n");
    }
    if (arg->query_skill("kurong-changong", 1) < 10) {
        return notify_fail("你的基本内功火候不够，无法学六脉神剑。\n");
    }
    if (arg->query("max_neili") < 300) {
        return notify_fail("你的内力太弱，无法练六脉神剑。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("liumai-shenjian");
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练六脉神剑必须空手。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 80) {
        return notify_fail("你的内力不够练六脉神剑!\n");
    }
    arg->receive_damage("qi", 40);
    arg->add("neili", -70);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/liumai-shenjian/" + arg;
}

mixed hit_ob(mixed arg1, mixed arg2, mixed arg3) {
    if (arg3 < 100) {
        return 0;
    }
    if (arg1->query_temp("weapon") || arg1->query_temp("secondary_weapon")) {
        return 0;
    }
    if (arg1->query_skill("liumai-shenjian", 1) > 100 && arg1->query_skill("kurong-changong", 1) > 100 && arg1->query("neili") > 150) {
        arg1->add("neili", -150);
    }
    return ([ "msg" : "\e[1;35m只听见到“嗤”的一声轻响，$N挥出一道剑气，向$n弹射而去！\n\e[2;37;0m", "damage" : arg3 > 3000 ? 3000 : arg3 * 2 ]);
}
