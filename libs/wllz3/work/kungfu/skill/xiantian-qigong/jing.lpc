int exert(mixed arg1, mixed arg2) {
    if (arg1->is_fighting()) {
        return notify_fail("战斗中疗精？找死吗？\n");
    }
    if (arg1->query_skill("xiantian-qigong", 1) < 50) {
        return notify_fail("你的先天神功修为还不够。\n");
    }
    if (arg1->query("neili") < 50) {
        return notify_fail("你的真气不够。\n");
    }
    if (arg2->query("eff_jing") < arg2->query("max_jing") / 2) {
        return notify_fail(arg2 == arg1 ? "你" : arg2->name() + "的精损伤太多，只怕一运真气便有生命危险！\n");
    }
    if (arg2->query("eff_jing") >= arg2->query("max_jing")) {
        return notify_fail(arg2 == arg1 ? "你" : arg2->name() + "现在精神良好，不需要疗伤！\n");
    }
    if (arg2 == arg1) {
        message_vision("\e[1;37m$N头上冒出屡屡热气，精神看起来好多了。\n\e[2;37;0m", arg1);
    } else {
        message_vision("\e[1;37m$N与$n双双盘膝而坐，$N将双掌贴于$n的后背，徐徐的将内劲传入$n的体内。\n\e[1;33m过了一会，$n头上冒出屡屡热气，精神看起来好多了。\n\e[2;37;0m", arg1, arg2);
    }
    arg2->receive_curing("jing", arg1->query_skill("xiantian-qigong", 1) / 2 + 40);
    arg1->add("neili", -50);
    arg1->set("jiali", 0);
    arg1->start_busy(4);
    return 1;
}

