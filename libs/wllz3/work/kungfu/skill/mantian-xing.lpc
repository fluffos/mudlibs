int valid_enable(mixed arg) {
    return arg == "throwing" || arg == "dodge" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "throwing") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query_skill("force", 1) < 20) {
        return notify_fail("你的内功心法火候不够，无法学满天星。\n");
    }
    if (arg->query_skill("dodge", 1) < 20) {
        return notify_fail("你的轻功火候不够，无法领悟满天星。\n");
    }
    if (arg->query_dex() < 25) {
        return notify_fail("你的身法不够灵巧，无法领悟满天星。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("mantian-xing", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

string query_dodge_msg(mixed arg) {
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "throwing") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("qi") < 30) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 30) {
        return notify_fail("你的内力不够练满天星。\n");
    }
    arg->receive_damage("qi", 30);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/mantian-xing/" + arg;
}
