int valid_learn(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = arg->query_skill("huagong-dafa", 1);
    v2 = 1;
    if (v1 <= 100) {
        for (v3 = 1; v3 < v1 / 10; v3++) {
            v2 *= 2;
        }
    }
    if (arg->query("gender") == "无性" && v1 > 49) {
        return notify_fail("你无根无性，阴阳不调，难以领会高深的化功大法。\n");
    }
    if (arg->query_skill("force", 1) < 10) {
        return notify_fail("你的基本内功火候不足，不能学化功大法。\n");
    }
    if (v1 <= 100) {
        if (v1 > 10 && -arg->query("shen") < v2 * 100) {
            return notify_fail("学化功大法，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
        }
    } else if (-arg->query("shen") < (v1 - 100) * 1000 + 51200) {
        return notify_fail("学化功大法，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
    }
    return 1;
}

