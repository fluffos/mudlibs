int valid_learn(mixed arg) {
    mixed v1;
    if (!arg->query("is_zongshi")) {
        return notify_fail("你还不是武林宗师，不能学习宗师武功。\n");
    }
    if (arg->query("max_neili") < 5000) {
        return notify_fail("你的内力修为不够，没有办法练断魂枪。\n");
    }
    if (!(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "spear") {
        return notify_fail("你必须先找一把枪才能练枪法。\n");
    }
    if (arg->query_skill("xuanming-shenzhang", 1) || arg->query_skill("dugu-jianqi", 1) || arg->query_skill("ningxue-shenzhua", 1)) {
        return notify_fail("你怎么身兼多种宗师武功呢？\n");
    }
    return 1;
}

int valid_enable(mixed arg) {
    return arg == "spear" || arg == "parry";
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("duanhun-qiang", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query("qi") < 30 || arg->query("neili") < 30) {
        return notify_fail("你的内力或气不够，没有办法练习断魂枪。\n");
    }
    arg->receive_damage("qi", 30);
    arg->add("neili", -30);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/duanhun-qiang/" + arg;
}

string query_parry_msg(mixed arg) {
    if (arg) {
        return parry_msg[random(sizeof(parry_msg))];
    }
}
