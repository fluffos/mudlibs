    }
    v1 = arg1->query_skill("force");
    arg1->add("neili", -200);
    arg1->receive_damage("qi", 0);
    message_vision("\e[1;33m$N运起天魔大法，全身骨骼叻嘞作响，肌肉贲张，体形暴涨近半，全身发出金色豪光。\n\e[2;37;0m", arg1);
