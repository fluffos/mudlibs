inherit "/inherit/skill/force";
int valid_enable(mixed);
int practice_skill(mixed);
string exert_function_file(mixed);
mapping exercise_msg(mixed);
int valid_comp(mixed);

int valid_enable(mixed arg) {
    return arg == "force";
}

int valid_learn(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v1 = arg->query_skill("buddhism", 1);
    v2 = arg->query_skill("force", 1);
    v3 = arg->query_skill("hunyuan-yiqi", 1);
    v4 = arg->query_skill("yijinjing", 1);
    v5 = arg->query("guilty");
    if (v3 < 100) {
        return notify_fail("你的混元一气太低，无法学习易筋经神功！\n");
    }
    if (arg->query("marry")) {
        return notify_fail("你已经破了色戒，无法再学习易筋经神功！\n");
    }
    if (arg->query("gender") != "男性") {
        return notify_fail("你非童男之体，不能练习易筋经神功。\n");
    }
    if (v1 < 100 && v1 <= v4) {
        return notify_fail("你的禅宗心法修为不够，无法领会更高深的易筋经神功。\n");
    }
    if (v2 < 10) {
        return notify_fail("你的基本内功火候还不够，无法领会易筋经神功。\n");
    }
    if (v5 > 0) {
        return notify_fail("你屡犯僧家数戒，无法领会更高深的易筋经神功。\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    return notify_fail("易筋经神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(mixed arg) {
    return "/kungfu/skill/yijinjing/" + arg;
}

mapping exercise_msg(mixed arg) {
    return ([ "status_msg" : "脸上红光隐现，气象庄严。", "start_my_msg" : "你五心向天，排除一切杂念，内息顺经脉缓缓流动。\n", "start_other_msg" : arg->name() + "五心向天，一会工夫，从口鼻处缓缓吐出白气，白气越吐越浓，渐渐笼罩了全身。\n", "halt_msg" : "$N长出一口气，将内息急速退了回去，站了起来。\n", "end_my_msg" : "你将内息走了个小周天，流回丹田，收功站了起来。\n", "end_other_msg" : "只见笼罩" + arg->name() + "的白气渐渐消散，又从口鼻处吸了回去。\n", "heal_msg" : "\e[1;33m$N双手合什，盘膝而坐，口中念起“往生咒”，开始运功疗伤。\n\e[2;37;0m", "heal_finish_msg" : "\e[1;33m$N缓缓站起，只觉全身说不出的舒服畅快，便道：“善哉！善哉！本门筋经当真是天下绝学！”\n\e[2;37;0m", "heal_unfinish_msg" : "$N吐出瘀血，缓缓站起，但脸色苍白，看来还有伤在身。\n",
            "heal_halt_msg" : "$N一声：“阿弥陀佛”双袖挥动，压下内息，站起身来。\n" ]);
}

int valid_comp(mixed arg) {
    return arg == "hunyuan-yiqi" || arg == "jiuyang-shengong";
}
