int valid_learn(mixed arg) {
    mixed v1;
    if (arg->query("gender") != "女性") {
        return notify_fail("玉女金针十三剑是只有女子才能练的武功。\n");
    }
    if (arg->query("max_neili") < 50) {
        return notify_fail("你的内力不够，没有办法练玉女金针十三剑。\n");
    }
    if (arg->query_skill_mapped("force") != "zixia-shengong") {
        return notify_fail("玉女金针十三剑必须配合紫霞神功才能练。\n");
    }
    if (!(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你必须先找一把剑才能练剑法。\n");
    }
    return 1;
}

