    if (arg3 < 100) {
        return 0;
    }
    if (arg1->query_temp("weapon") || arg1->query_temp("secondary_weapon")) {
        return 0;
    }
    if (random(arg1->query_skill("liuyang-zhang", 1)) > 100 && (arg1->query_skill("beiming-shengong", 1) > 100 || arg1->query_skill("bahuang-gong", 1) > 100) && arg1->query("neili") > 200) {
