int valid_enable(mixed arg) {
    return arg == "axe" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "axe") {
        return notify_fail("练断云斧手中必须有一把斧头。\n");
    }
    if (arg->query_skill("force", 1) < 20) {
        return notify_fail("你的内功心法火候不够，无法学断云斧。\n");
    }
    if (arg->query("max_neili") < 150) {
        return notify_fail("你的内力太弱，无法练断云斧。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("duanyun-fu", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "axe") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 20) {
        return notify_fail("你的内力不够练断云斧。\n");
    }
    arg->receive_damage("qi", 25);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/duanyun-fu/" + arg;
}
