string *dodge_msg = ({ "$n一个「\e[35m比翼双飞\e[2;37;0m」，随着$N的攻势飘起，从容躲过这一招。\n", "$n使出一招「\e[35m巧燕穿云\e[2;37;0m」，猛然纵起丈余，结果$N扑了个空。\n", "$n身形一摇，幻出几个人影，一招「\e[1;34m望穿秋水\e[2;37;0m」躲过了$N的攻势。\n", "$n一招「\e[34m飞鸟投林\e[2;37;0m」纵身跃起，倏忽已落至$N身后。\n", "$n左一摇，右一晃，一招「\e[35m紫燕呢喃\e[2;37;0m」已轻松闪过。\n" });

int valid_enable(mixed arg) {
    return arg == "dodge";
}

int valid_learn(mixed arg) {
    if (arg->query_skill("dodge", 1) <= arg->query_skill("yan-shuangfei", 1)) {
