    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "blade") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练慈悲刀。\n");
    }
    arg->receive_damage("qi", 25);
    return 1;
}
