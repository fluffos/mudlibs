int valid_enable(mixed arg) {
    return arg == "finger" || arg == "parry";
}

int valid_combine(mixed arg) {
    return arg == "xingyi-zhang";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练参合指必须空手。\n");
    }
    if (arg->query_skill("shenyuan-gong", 1) < 15) {
        return notify_fail("你的神元功火候不够，无法学参合指。\n");
    }
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力太弱，无法练参合指。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action);
    while (v1--) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("canhe-zhi", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练参合指必须空手。\n");
    }
    if (arg->query("jing") < 30) {
        return notify_fail("你的精力太低了。\n");
    }
    if (arg->query("neili") < 20) {
        return notify_fail("你的内力不够练参合指。\n");
    }
    arg->receive_damage("jing", 20);
    arg->add("neili", -8);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/canhe-zhi/" + arg;
}

