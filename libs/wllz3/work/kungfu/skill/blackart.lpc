inherit "/inherit/skill/skill";
int valid_enable(mixed);
string cast_spell_file(mixed);
string scribe_spell_file(mixed);
int practice_skill(mixed);

string type() {
    return "martial";
}

int valid_enable(mixed arg) {
    return arg == "spells";
}

int valid_learn(mixed arg) {
    if (arg->query_skill("taoism") < arg->query_skill("blackart") / 2) {
        return notify_fail("你的道家学说修为不够，无法领悟更高深的茅山术。\n");
    }
    return 1;
}

string cast_spell_file(mixed arg) {
    return "/kungfu/skill/blackart/" + arg;
}

string scribe_spell_file(mixed arg) {
    return "/kungfu/skill/blackart/" + arg;
}

int practice_skill(mixed arg) {
    mixed v1;
    mixed v2;
    if (v1 = arg->query_temp("mind_bug")) {
        return notify_fail("你的魂魄还没有全部收回，赶快杀死你的" + v1->name() + "吧！\n");
    }
    if (arg->query("jingli") < 10) {
        return notify_fail("你的精力不够。\n");
    }
    if (arg->query("jing") < 30) {
        return notify_fail("你的精神无法集中。\n");
    }
    arg->add("jingli", -10);
    arg->receive_damage("jing", 30);
    write("你闭目凝神，神游物外，开始修习天师道术中的法术....\n");
    if (random(arg->query("jing")) < 5) {
        v2 = random(arg->query_skill("spells", 1));
        if (v2 < 10) {
            v1 = clone_object("/clone/npc/mind_bug");
        } else {
            v1 = clone_object("/clone/npc/mind_beast");
        }
        write("可是你心思一乱，变出了一只面目狰狞的" + v1->name() + "！\n");
        v1->move(environment(arg));
        v1->kill_ob(arg);
        arg->fight(v1);
        arg->set_temp("mind_bug", v1);
        v1->set("owner", arg->query("id"));
        return notify_fail("\e[1;33m你的魂魄正被" + v1->name() + "缠住，快把它除掉吧！\n\e" + "[2;37;0m");
    } else {
        return 1;
    }
}
