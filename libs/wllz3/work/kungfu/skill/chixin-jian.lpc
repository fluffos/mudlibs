int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("练痴心情长剑手中必须有剑。\n");
    }
    if (arg->query_skill("force", 1) < 15 && arg->query_skill("beiming-shengong", 1) < 15) {
        return notify_fail("你的内功心法火候不到，无法学习痴心情长剑。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("chixin-jian", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你的武器不对。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练痴心情长剑。\n");
    }
    arg->receive_damage("qi", 25);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/chixin-jian/" + arg;
}
