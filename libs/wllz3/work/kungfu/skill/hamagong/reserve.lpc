    if (arg1->query_skill("hamagong", 1) < 120) {
        return notify_fail("你的蛤蟆功不够娴熟，不会经脉倒转。\n");
    }
    if (arg1->query("neili") < arg1->query("max_neili") / 20) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query_temp("hmg_dzjm")) {
        return notify_fail("你已经倒转经脉了。\n");
    }
    if (arg1->query("qi") < 1500) {
        return notify_fail("你现在气血失调，不能经脉倒转。\n");
    }
    v1 = arg1->query_skill("hamagong", 1);
    message_vision("\e[1;34m$N忽地双手撑地倒立，逆运经脉，顿时内息暗生，功力大增。\n\e[2;37;0m", arg1);
    arg1->add_temp("apply/attack", -v1 / 3);
    arg1->add_temp("apply/dodge", v1 / 2);
    arg1->set_temp("hmg_dzjm", 1);
    if (arg1->query("ouyangfeng_son")) {
        arg1->receive_damage("qi", 1000);
        arg1->set("neili", arg1->query("max_neili") * 3);
    }
    arg1->start_call_out((: call_other, "/kungfu/skill/hamagong/reserve.lpc", "remove_effect", arg1, v1 / 3, v1 / 2 :), v1);
    arg1->add("neili", -arg1->query("max_neili") / 20);
    if (arg1->is_fighting()) {
        arg1->start_busy(5);
    }
    return 1;
}

void remove_effect(mixed arg1, mixed arg2, mixed arg3) {
    if (!arg1) {
        return;
    }
    if (arg1->query_temp("hmg_dzjm")) {
        arg1->add_temp("apply/attack", arg2);
        arg1->add_temp("apply/dodge", -arg3);
        arg1->delete_temp("hmg_dzjm");
        message_vision("\e[1;33m$N双手一撑，一跃而起，将内力收回丹田。\n\e[2;37;0m", arg1);
    }
}

