int perform(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    if (!arg2) {
        arg2 = offensive_target(arg1);
    }
    if (!arg2 || !arg2->is_character() || !arg1->is_fighting(arg2) || !living(arg2)) {
        return notify_fail("蛤蟆功绝招只能对战斗中的对手使用。\n");
    }
    if (arg1->query_skill("hamagong", 1) < 150) {
        return notify_fail("你的蛤蟆功还不够熟练，不能使用蛤蟆绝招对敌！\n");
    }
    if (objectp(arg1->query_temp("weapon"))) {
        return notify_fail("你必须空手才能使用「蛤蟆功」！\n");
    }
    if (arg1->query_skill_mapped("force") != "hamagong") {
        return notify_fail("你的内功中无此功夫。\n");
    }
    if (arg1->query_skill_mapped("strike") != "hamagong") {
        return notify_fail("你必须先将蛤蟆功运用于掌法之中才行。\n");
    }
    if (arg1->query("max_neili") < 1500) {
        return notify_fail("你现在内力不足，使不出蛤蟆功的绝招！\n");
    }
    if (arg1->query("neili") < 400) {
        return notify_fail("你现在内力不足，使不出蛤蟆功的绝招！\n");
    }
    if (arg1->query_skill("strike", 1) < 150) {
        return notify_fail("你的掌法不够娴熟，使不出蛤蟆功的绝招！\n");
    }
    if (arg1->query_str() < 60) {
        return notify_fail("你的力量太小，使不出用蛤蟆绝招！\n");
    }
    if (arg1->query_temp("hmg_hama")) {
        return notify_fail("你刚使完「蛤蟆功」绝招，目前气血翻涌，无法再次运用！\n");
    }
    arg1->clean_up_enemy();
    v3 = "\e[34m$N身子蹲下，左掌平推而出，使的正是$N生平最得意的「蛤蟆功」绝招，掌风直逼$n而去！\n\e[2;37;0m";
    arg1->set_temp("hmg_hama", 1);
    if (random(arg1->query_skill("force")) > arg2->query_skill("force") / 4) {
        arg1->start_busy(1);
        if (!arg2->is_busy()) {
            arg2->start_busy(1);
        }
        arg1->add("neili", -200);
        arg1->add("jingli", -20);
        v1 = arg1->query_skill("force");
        v1 = v1 * 2 + random(v1);
        if (arg1->query("neili") > arg2->query("neili") * 2) {
            v1 += random(v1);
        }
        arg2->receive_damage("qi", v1, arg1);
        arg2->receive_wound("qi", v1 / 2, arg1);
        v2 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v3 += damage_msg(v1, "内伤");
        v3 += "「$n" + eff_status_msg(v2) + " 」\n";
        call_out("perform2", 0, arg1, arg2, v2);
    } else {
        arg1->start_busy(2);
        if (!arg2->is_busy()) {
            arg2->start_busy(1);
        }
        arg1->add("neili", -100);
        tell_object(arg2, "\e[1;33m你但觉一股微风扑面而来，风势虽然不劲，然已逼得自己呼吸不畅，知道不妙，连忙跃开数尺。\n\e[2;37;0m");
        v4 = arg2->query_skill_mapped("dodge");
        if (!v4) {
            v4 = "dodge";
        }
        v3 += (skill_dir(v4) + v4)->query_dodge_msg(arg2, 1);
    }
    call_out("remove_effect", arg1->query_con() / 2, arg1);
    message_combatd(v3, arg1, arg2);
    return 1;
}

int perform2(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg1) {
        return 0;
    }
    if (!living(arg2)) {
        return notify_fail("对手已经不能再战斗了。\n");
    }
    if (!arg2 || environment(arg2) != environment(arg1)) {
        return notify_fail("你待要再发一掌，却对手已经不在了！\n");
    }
    if (arg1->query("neili", 1) < 500) {
        return notify_fail("你待要再发一掌，却发现自己的内力不够了！\n");
    }
    arg1->clean_up_enemy();
    v2 = "\e[34m\n$N左掌劲力未消，右掌也跟着推出，功力相叠，「蛤蟆功」掌风排山倒海般涌向$n！\n\e[2;37;0m";
    if (random(arg1->query_skill("force")) > arg2->query_skill("force") / 4 && arg1->query_skill("hamagong", 1) > 200) {
        arg1->start_busy(1);
        if (!arg2->is_busy()) {
            arg2->start_busy(1);
        }
        arg1->add("neili", -300);
        arg1->add("jingli", -30);
        v1 = arg1->query_skill("force");
        v1 = v1 * 3 + random(v1) * 2;
        if (arg1->query("neili") > arg2->query("neili") * 2) {
            v1 += random(v1);
        }
        arg2->receive_damage("qi", v1, arg1);
        arg2->receive_wound("qi", v1 / 2, arg1);
        arg3 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v2 += damage_msg(v1, "内伤");
        v2 += "「$n" + eff_status_msg(arg3) + " 」\n";
        call_out("perform3", 0, arg1, arg2, arg3);
    } else {
        arg1->start_busy(4);
        arg1->add("neili", -200);
        tell_object(arg2, "\e[1;33m你喘息未定，又觉一股劲风扑面而来，连忙跃开数尺，狼狈地避开。\n\e[2;37;0m");
        v3 = arg2->query_skill_mapped("dodge");
        if (!v3) {
            v3 = "dodge";
        }
        v2 += (skill_dir(v3) + v3)->query_dodge_msg(arg2, 1);
    }
    message_combatd(v2, arg1, arg2);
    return 1;
}

int perform3(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg1) {
        return 0;
    }
    if (!living(arg2)) {
        return notify_fail("对手已经不能再战斗了。\n");
    }
    if (!arg2 || environment(arg2) != environment(arg1)) {
        return notify_fail("你待要再发一掌，却对手已经不在了！\n");
    }
    if (arg1->query("neili", 1) < 700) {
        return notify_fail("你待要再发一掌，却发现自己的内力不够了！\n");
    }
    arg1->clean_up_enemy();
    v2 = "\e[34m\n$N双腿一登，双掌相并向前猛力推出，$n连同身前方圆三丈全在「蛤蟆功」劲力笼罩之下！\n\e[2;37;0m";
    if (random(arg1->query_skill("force")) > arg2->query_skill("force") / 3 && arg1->query_skill("hamagong", 1) > 149) {
        arg1->start_busy(3);
        if (!arg2->is_busy()) {
            arg2->start_busy(random(2) + 1);
        }
        arg1->add("neili", -400);
        arg1->add("jingli", -40);
        v1 = arg1->query_skill("hamagong", 1);
        v1 = v1 * 5 + random(v1) * 2;
        if (arg1->query("neili") > arg2->query("neili") * 2) {
            v1 += random(v1);
        }
        arg2->receive_damage("qi", v1, arg1);
        arg2->receive_wound("qi", v1 / 2, arg1);
        arg3 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v2 += damage_msg(v1, "瘀伤");
        v2 += "「$n" + eff_status_msg(arg3) + "」\n";
    } else {
        arg1->start_busy(4);
        if (!arg2->is_busy()) {
            arg2->start_busy(1);
        }
        arg1->add("neili", -300);
        arg2->add("jingli", -100);
        tell_object(arg2, "\e[1;33m你用尽全身力量向右一纵一滚，摇摇欲倒地站了起来，但总算躲开了这致命的一击！\n\e[2;37;0m");
        v3 = arg2->query_skill_mapped("dodge");
        if (!v3) {
            v3 = "dodge";
        }
        v2 += (skill_dir(v3) + v3)->query_dodge_msg(arg2, 1);
    }
    message_combatd(v2, arg1, arg2);
    return 1;
}

void remove_effect(mixed arg) {
    if (!arg) {
        return;
    }
    arg->delete_temp("hmg_hama");
    tell_object(arg, "\e[1;36m\n你经过一段时间调气养息，又可以使用「蛤蟆功」绝招了。\n\e[2;37;0m");
}

string help() {
    return "$HIG$【蛤蟆功】$NOR$\r\n\r\n技能等级：蛤蟆功\t150\r\n\t  基本掌法\t150\r\n内力要求：400/1500\r\n属性要求：力量\t\t60\r\n其他要求：蛤蟆功达到一定等级，可以发挥二段攻击\r\n";
}
