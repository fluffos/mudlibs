int exert(mixed, mixed);
void remove_effect(mixed, mixed);
string help();

int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 != arg1) {
        return notify_fail("你只能提升自己的战斗力。\n");
    }
    if (arg1->query("neili") < arg1->query("max_neili") / 20) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query_temp("powerup") || arg1->query_temp("shift")) {
        return notify_fail("你已经在运功中了。\n");
    }
    if (arg1->query_temp("jingang")) {
        return notify_fail("你的全部功力都运在大金刚拳上了。\n");
    }
    if (arg1->query_temp("zuida")) {
        return notify_fail("你内息翻滚在八仙醉打中，一时提不起易筋经神功。\n");
    }
    v1 = arg1->query_skill("force");
    if (v1 < 150) {
        return notify_fail("你的内功修为不足，无法提升战力。\n");
    }
    if (arg1->query_skill("yijinjing", 1) < 150) {
        return notify_fail("你的易筋经神功修为不足，无法提升战力。\n");
    }
    message_vision("\e[1;31m$N舌尖一咬，喷出一口鲜血，运起易筋经神功已将全身潜力尽数提起！\n\e[2;37;0m", arg1);
    arg1->add_temp("apply/attack", v1);
    arg1->add_temp("apply/dodge", v1);
    arg1->set_temp("powerup", 1);
    arg1->add("neili", -300);
    arg1->start_call_out((: call_other, "/kungfu/skill/yijinjing/powerup.lpc", "remove_effect", arg1, v1 :), v1);
    if (arg1->is_fighting()) {
        arg1->start_busy(3);
    }
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    arg1->add_temp("apply/attack", -arg2);
    arg1->add_temp("apply/dodge", -arg2);
    arg1->delete_temp("powerup");
    tell_object(arg1, "\e[1;36m你的易筋经神功运行完毕，将内力收回丹田。\n\e[2;37;0m");
}

string help() {
    return "$HIG$【提升战力】$NOR$\r\n\r\n技能等级：易筋经神功\t150\r\n\t  基本内功\t150\r\n内力要求：1/5\r\n";
}
