int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "throwing") {
        return notify_fail("你必须先找一些飞镖之类的东西才能练暗器。\n");
    }
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力不够，没有办法练寒星八打。\n");
    }
    return 1;
}

int valid_enable(mixed arg) {
    return arg == "throwing" || arg == "parry";
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("hanxing-bada", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "throwing") {
        return notify_fail("你必须先找一些飞镖之类的东西才能练暗器。\n");
    }
    if (arg->query("qi") < 30 || arg->query("neili") < 3) {
        return notify_fail("你的内力或气不够，没有办法练习寒星八打。\n");
    }
    arg->receive_damage("qi", 30);
    arg->add("neili", -3);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/hanxing-bada/" + arg;
}
