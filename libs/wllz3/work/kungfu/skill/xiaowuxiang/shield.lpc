int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg1->query_temp("huti")) {
        return notify_fail("你已经在运功中了。\n");
    }
    if (arg1->query("neili") < 300) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query_skill("xiaowuxiang", 1) < 40) {
        return notify_fail("你的小无相功修为不够。\n");
    }
    if (arg1->query_skill("force", 1) < 100) {
        return notify_fail("你的内功修为不够，无法运用神功护体。\n");
    }
    v1 = arg1->query_skill("force");
    arg1->add("neili", -300);
    message_vision("\e[1;37m$N双手平举过顶，运起小无相功，全身笼罩在劲气之中！\n\e[2;37;0m", arg1);
    arg1->add_temp("apply/armor", v1);
    arg1->set_temp("huti", 1);
    arg1->start_call_out((: call_other, "/kungfu/skill/xiaowuxiang/shield.lpc", "remove_effect", arg1, v1 :), v1);
    if (arg1->is_fighting()) {
        arg1->start_busy(2);
    }
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    arg1->add_temp("apply/armor", -arg2);
    arg1->delete_temp("huti");
    tell_object(arg1, "你的小无相功运行完毕，将内力收回丹田。\n");
}

