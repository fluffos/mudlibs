int valid_enable(mixed arg) {
    return arg == "strike" || arg == "parry";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练昆仑掌必须空手。\n");
    }
    if (arg->query_skill("xuantian-force", 1) < 100) {
        return notify_fail("你的玄天无极功火候不够，无法练昆仑掌。\n");
    }
    if (arg->query("max_neili") < 800) {
        return notify_fail("你的内力修为不够，无法练昆仑掌。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("kunlun-zhang", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练昆仑掌必须空手。\n");
    }
    if (arg->query("jing") < 50) {
        return notify_fail("你的精神太差了。\n");
    }
    if (arg->query("neili") < 20) {
        return notify_fail("你的内力不够练昆仑掌。\n");
    }
    arg->receive_damage("jing", 30);
    arg->add("neili", -10);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/kunlun-zhang/" + arg;
}
