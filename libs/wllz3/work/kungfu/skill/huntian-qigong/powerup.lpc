int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 != arg1) {
        return notify_fail("你只能用混天气功来提升自己的战斗力。\n");
    }
    if (arg1->query("neili") < arg1->query("max_neili") / 20) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query_skill("force", 1) < 100) {
        return notify_fail("你的内功修为不足，无法使用混天气功加力。\n");
    }
    if (arg1->query_skill("huntian-qigong", 1) < 100) {
        return notify_fail("你的混天气功修为不足，无法运功加力。\n");
    }
    if (arg1->query_temp("powerup")) {
        return notify_fail("你已经在运功中了。\n");
    }
    v1 = arg1->query_skill("force");
    arg1->add("neili", -arg1->query("max_neili") / 20);
    arg1->receive_damage("qi", 0);
    message_vision("\e[1;31m$N微一凝神，运起混天气功，全身骨节发出一阵爆豆般的声响！\n\e[2;37;0m", arg1);
    arg1->add_temp("apply/attack", v1 / 3);
    arg1->add_temp("apply/dodge", v1 / 3);
    arg1->set_temp("powerup", 1);
    arg1->start_call_out((: call_other, "/kungfu/skill/huntian-qigong/powerup.lpc", "remove_effect", arg1, v1 / 3 :), v1);
    if (arg1->is_fighting()) {
        arg1->start_busy(3);
    }
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    if (arg1->query_temp("powerup")) {
        arg1->add_temp("apply/attack", -arg2);
        arg1->add_temp("apply/dodge", -arg2);
        arg1->delete_temp("powerup");
        tell_object(arg1, "\e[36m你的混天气功运行完毕，将内力收回丹田。\n\e[2;37;0m");
    }
}

