int valid_enable(mixed arg) {
    return arg == "throwing" || arg == "parry";
}

int valid_learn(mixed arg) {
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg->query_skill("biyun-xinfa", 1) < 20) {
        return notify_fail("你的碧云心法火候不够。\n");
    }
    if (arg->query_skill("biye-wu", 1) < 20) {
        return notify_fail("你的碧叶随风舞火候太浅。\n");
    }
    return 1;
}

