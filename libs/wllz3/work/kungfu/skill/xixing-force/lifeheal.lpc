int exert(mixed, mixed);
string help();

int exert(mixed arg1, mixed arg2) {
    if (!arg2 || arg2 == arg1) {
        return notify_fail("你要用真气为谁疗伤？\n");
    }
    if (arg1->query("max_neili") < 350) {
        return notify_fail("你的内力修为不够。\n");
    }
    if (arg1->query("neili") < 150) {
        return notify_fail("你的真气不够。\n");
    }
    if (arg1->query_skill("xixing-force", 1) < 70) {
        return notify_fail("你的吸星大法修为不足，无法运功疗伤。\n");
    }
    if (arg2->query("eff_qi") >= arg2->query("max_qi")) {
        return notify_fail("对方现在状态良好，不需要运功疗伤。\n");
    }
    if (arg2->query("eff_qi") < arg2->query("max_qi") / 5) {
        return notify_fail(arg2->name() + "已经受伤过重，经受不起你的真气震荡！\n");
    }
    message_vision("\e[1;33m$N运用吸心大法，缓缓地将自己的真气输入$n体内....\n过了不久，$N额头上冒出豆大的汗珠，$n吐出一口瘀血，脸色看起来好多了。\n\e[2;37;0m", arg1, arg2);
    arg2->receive_curing("qi", arg1->query_skill("force") / 3 + 10);
    if (arg2->query("qi") > arg2->query("eff_qi")) {
        arg2->set("qi", arg2->query("eff_qi"));
    }
    arg1->add("neili", -150);
    arg1->set("jiali", 0);
    return 1;
}

string help() {
    return "$HIG$【运功疗伤】$NOR$\n\n技能等级：吸星大法\t70\n内力修为：150/350\n";
