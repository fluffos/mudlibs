int valid_enable(mixed arg) {
    return arg == "unarmed" || arg == "parry" || arg == "strike";
}

int valid_learn(mixed arg) {
    if (arg->query("gender") != "男性") {
        return notify_fail("只有男性才可以学习这种武功。\n");
    }
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练黯然销魂掌必须空手。\n");
    }
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力不够。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("xiaohun-zhang", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 5, v2 / 5)];
        }
        v1--;
    }
}

mixed hit_ob(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    if (arg3 < 100) {
        return 0;
    }
    if (objectp(arg1->query_temp("weapon"))) {
        return 0;
    }
    if (intp(v1 = arg1->query_skill("xiaohun-zhang", 1)) && v1 > 200) {
        return ([ "msg" : "\e[36m$N一招「穷途末路」闪身到$n身旁，左掌举到胸前平推而出，接着右掌斜斜劈向$n。\n\e[2;37;0m", "damage" : arg1->query_temp("anran") ? v1 * 10 : v1 * 2, "dodge" : 100, "force" : 100 ]);
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练黯然销魂掌必须空手。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练黯然销魂掌。\n");
    }
    arg->receive_damage("qi", 35);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/xiaohun-zhang/" + arg;
}
