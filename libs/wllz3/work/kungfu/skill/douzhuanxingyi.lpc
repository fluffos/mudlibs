inherit "/inherit/skill/force";
int valid_enable(mixed);
int practice_skill(mixed);
string exert_function_file(mixed);
string valid_comp(mixed);

int valid_enable(mixed arg) {
    return arg == "force";
}

int valid_learn(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = arg->query_skill("shenyuan-gong", 1);
    v2 = arg->query_skill("douzhuanxingyi", 1);
    if (arg->query("gender") == "无性" && v2 > 49) {
        return notify_fail("你无根无性，阴阳不调，难以领会高深的斗转星移大法。\n");
    }
    if (arg->query("family/family_name") != "慕容世家") {
        return notify_fail("只有慕容世家的弟子才可以学习斗转星移。\n");
    }
    if (arg->query_skill("force") < 10) {
        return notify_fail("你的基本内功火候不够，无法研习高深的内功。\n");
    }
    if (v1 < v2) {
        return notify_fail("你必须以修炼神元功来为斗转星移做基础。\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
