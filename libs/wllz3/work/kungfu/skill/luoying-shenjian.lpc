int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你必须先找一把剑才能学习剑法。\n");
    }
    if (arg->query_skill("bibo-shengong", 1) < 30) {
        return notify_fail("你的碧波神功火候还不够。\n");
    }
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力不够，不能练落英神剑。\n");
    }
    return 1;
}

int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry";
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
