int valid_enable(mixed arg) {
    return arg == "blade" || arg == "parry";
}

int valid_combine(mixed arg) {
    return arg == "miexian-zhang";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "blade") {
        return notify_fail("你手中无刀，如何领会血刀的精髓？\n");
    }
    if (arg->query("max_neili") < 50) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg->query_skill("xuehai-mogong", 1) < 20) {
        return notify_fail("你的血海魔功火候太浅。\n");
    }
    return 1;
}

