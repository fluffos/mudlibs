int valid_enable(mixed arg) {
    return arg == "cuff" || arg == "parry";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练大金刚拳必须空手。\n");
    }
    if (arg->query_skill("hunyuan-yiqi", 1) < 10) {
        return notify_fail("你的混元一气功火候不够，无法学大金刚拳。\n");
    }
    if (arg->query("max_neili") < 50) {
        return notify_fail("你的内力太弱，无法练大金刚拳。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("jingang-quan", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练大金刚拳必须空手。\n");
    }
    if (arg->query("qi") < 30) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 20) {
        return notify_fail("你的内力不够练大金刚拳。\n");
    }
    arg->receive_damage("qi", 30);
    arg->add("neili", -10);
    return 1;
}

mixed hit_ob(mixed arg1, mixed arg2, mixed arg3) {
    if (arg3 < 100) {
        return 0;
    }
    if (arg1->query_temp("weapon") || arg1->query_temp("secondary_weapon")) {
        return 0;
    }
    if (arg1->query_skill("jingang-quan", 1) > 100 && arg1->query("neili") > 300 && random(arg1->query("neili")) > arg2->query("max_neili")) {
        arg1->add("neili", -200);
        return ([ "msg" : "\e[1;33m只听到“嘣”的一声巨响，金刚拳猛的打中$n的胸口，$n吐了一口鲜血！\n\e[2;37;0m", "damage" : arg3 * 2 ]);
    }
}

