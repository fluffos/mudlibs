int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 != arg1) {
        return notify_fail("你只能用玉女心法来提升自己的战斗力。\n");
    }
    if (arg1->query("neili") < arg1->query("max_neili") / 20) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query_temp("powerup")) {
        return notify_fail("你已经在运功中了。\n");
    }
    if (arg1->query_skill("force", 1) < 100) {
        return notify_fail("你的内功修为不足，无法利用神功加力。\n");
    }
    if (arg1->query_skill("yunv-xinfa", 1) < 100) {
        return notify_fail("你的玉女心法还不够精熟。\n");
    }
    v1 = arg1->query_skill("force");
    arg1->add("neili", -100);
    arg1->receive_damage("qi", 0);
    message_vision("\e[1;36m$N脸色微微一沉，双掌向外一分，姿势曼妙，如一朵\e[1;37m白玉兰花\e[1;36m盛开在初冬的寒风中！\n\e[2;37;0m", arg1);
    arg1->add_temp("apply/attack", v1 / 2);
    arg1->add_temp("apply/dodge", v1 / 2);
    arg1->set_temp("powerup", 1);
    arg1->start_call_out((: call_other, "/kungfu/skill/yunv-xinfa/powerup.lpc", "remove_effect", arg1, v1 / 2 :), v1 / 2);
    if (arg1->is_fighting()) {
        arg1->start_busy(3);
    }
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    arg1->add_temp("apply/attack", -arg2);
    arg1->add_temp("apply/dodge", -arg2);
    arg1->delete_temp("powerup");
    tell_object(arg1, "\e[1;35m你的玉女心法运行完毕，将内力收回丹田。\n\e[2;37;0m");
}

string help() {
    return "$HIG$【提升战力】$NOR$\r\n\r\n技能等级：玉女心法\t100\r\n\t  基本内功\t100\r\n内力要求：1/5\r\n";
