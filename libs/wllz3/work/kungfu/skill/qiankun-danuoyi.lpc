inherit "/inherit/skill/skill";
int valid_enable(mixed);
string query_parry_msg(mixed);
string query_dodge_msg(mixed);
int practice_skill(mixed);
int valid_comp(mixed);

string *parry_msg = ({ "$N一招击在$n身上，却被$n暗运乾坤大挪移，将内力尽数移入地下。\n", "$n轻轻一带，$N发现自己招数回击过来，吓得往后倒退几步。\n", "$n手臂回转，在$N手肘下轻轻一推，$N招数落空。\n", "$n右手伸出，在$N手腕上轻轻一拉，$N收势不住，直往前扑去。\n", "$n身形不动，$N一招击下，有如石沉大海，不觉呆住了。\n", "$n左牵右引，$N如身处漩流，连续转了好几个圈。\n", "$n双手回圈，$N只觉得前面好象有一堵墙，再也攻不进去。\n", "$n轻轻一转，$N一招击在地上，只打得尘土飞扬。\n" });
string *dodge_msg = ({ "$N一招击在$n身上，却被$n暗运乾坤大挪移，将内力尽数移入地下。\n", "$n轻轻一带，$N发现自己招数回击过来，吓得往后倒退几步。\n", "$n手臂回转，在$N手肘下轻轻一推，$N招数落空。\n", "$n右手伸出，在$N手腕上轻轻一拉，$N收势不住，直往前扑去。\n", "$n身形不动，$N一招击下，有如石沉大海，不觉呆住了。\n", "$n左牵右引，$N如身处漩流，连续转了好几个圈。\n", "$n双手回圈，$N只觉得前面好象有一堵墙，再也攻不进去。\n", "$n轻轻一转，$N一招击在地上，只打得尘土飞扬。\n" });

int valid_enable(mixed arg) {
    return arg == "parry" || arg == "dodge";
}

string query_parry_msg(mixed arg) {
    return parry_msg[random(sizeof(parry_msg))];
}

string query_dodge_msg(mixed arg) {
    return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(mixed arg) {
    mixed v1;
    v1 = arg->query_skill("qiankun-danuoyi", 1);
    if (arg->query("gender") == "无性" && v1 > 40) {
        return notify_fail("你先天不足，再学下去难免走火入魔。\n");
    }
    if (arg->query_skill("force", 1) < 100) {
        return notify_fail("你的基本内功不足，不能学习乾坤大挪移。\n");
    }
    if (arg->query("max_neili", 1) < 1500) {
        return notify_fail("你的内力修为不足，不能学习乾坤大挪移。\n");
    }
    if (arg->query_skill("force", 1) < v1) {
        return notify_fail("你的基本内功火候还不够，小心走火入魔！\n");
    }
    if (v1 < 250) {
        return notify_fail("你的乾坤大挪移火候不足，还不能以学习来加以提高。\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    return notify_fail("乾坤大挪移只能通过读<<乾坤大挪移>>心法提高。\n");
}

int valid_comp(mixed arg) {
