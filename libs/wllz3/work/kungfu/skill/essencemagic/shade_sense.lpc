int conjure(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg1->query_skill("essencemagic", 1);
    if (v1 < 120) {
        return notify_fail("你的八识神通还不够娴熟，不能使用隐识神通。\n");
    }
    if (arg1->query("jingli") < v1) {
        return notify_fail("你的精力不够！\n");
    }
    if (arg1->query("jing") <= v1) {
        return notify_fail("你的精神不够！\n");
    }
    if (arg1->query_temp("essencemagic")) {
        return notify_fail("你已经施展隐识神通了。\n");
    }
    message_vision("\e[37m$N凝神提气，一团白茫茫的迷雾顷刻之间将整个人笼罩了起来．．．\n\e[2;37;0m", arg1);
    arg1->add("jingli", -v1);
    arg1->receive_damage("jing", v1);
    if (arg1->query_skill("essencemagic", 1) < random(arg1->query_skill("magic", 1))) {
        write("你因为不够熟练而失败了。\n");
        if (arg1->is_fighting()) {
            arg1->start_busy(3);
        }
        return 1;
    }
    arg1->clean_up_enemy();
    arg1->dismiss_team();
    arg1->set_temp("essencemagic", 1);
    arg1->add_temp("apply/dexerity", v1 / 6);
    arg1->add_temp("apply/defense", v1 / 6);
    arg1->start_call_out((: call_other, "/kungfu/skill/essencemagic/shade_sense.lpc", "remove_effect", arg1, v1 / 6 :), v1 / 2);
    if (arg1->is_fighting()) {
        arg1->start_busy(2);
    }
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    arg1->add_temp("apply/dexerity", -arg2);
    arg1->add_temp("apply/defense", -arg2);
    arg1->delete_temp("essencemagic");
    tell_object(arg1, "你的隐识失效了。\n");
}

