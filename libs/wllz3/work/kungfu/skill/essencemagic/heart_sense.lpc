        return notify_fail("你的精力不够！\n");
    }
    if (arg1->query("jing") <= 50) {
        return notify_fail("你的精神不够！\n");
    }
    arg1->add("jingli", -100);
    arg1->receive_damage("jing", 50);
    message_vision("\e[1;33m$N一手放在$n的天灵盖上, 一手贴在$n的后心, 闭上眼睛缓缓低吟...\n\e[2;37;0m", arg1, arg2);
