    if (v1 < 120) {
        return notify_fail("你的八识神通还不够娴熟，无法使用心识神通。\n");
    }
    if (!arg2 || !arg2->is_character()) {
        return notify_fail("你要对谁使用心识神通？\n");
    }
    if (arg1->is_fighting()) {
        return notify_fail("战斗中不能使用心识神通！\n");
    }
    if (arg2->is_corpse()) {
        return notify_fail("你想把" + arg2->name(1) + "救醒，可惜已经太晚了。\n");
    }
