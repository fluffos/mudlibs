    if (arg1->is_fighting()) {
        return notify_fail("战斗中无法使用冥识神通！\n");
    }
    if (v1 < 150) {
        return notify_fail("你的八识神通不够娴熟，还不能使用冥识神通。\n");
    }
    if (arg1->query("jingli") < 100) {
        return notify_fail("你的精力不够！\n");
    }
    if (arg1->query("jing") <= 100) {
        return notify_fail("你的精气不够！\n");
