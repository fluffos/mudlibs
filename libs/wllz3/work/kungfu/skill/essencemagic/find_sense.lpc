        return notify_fail("冥识神通使用错误！\n");
    }
    write("你要对谁使用冥识神通(请键入欲寻找目标的 id)？\n");
    input_to((: call_other, "/kungfu/skill/essencemagic/find_sense.lpc", "select_target", arg1 :));
    return 1;
}

void select_target(mixed arg1, mixed arg2) {
