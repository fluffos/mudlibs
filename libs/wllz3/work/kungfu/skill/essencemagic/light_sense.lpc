        arg3 = (arg1->query_spi() + arg3) * 3 / 2;
    }
    arg2->receive_damage("jing", arg3, arg1);
    arg2->receive_wound("jing", arg3 / 2, arg1);
    arg2->receive_damage("qi", arg3 * 2, arg1);
    arg2->receive_wound("qi", arg3, arg1);
    if (userp(arg1) && userp(arg2) && !arg2->is_want_kill(arg1->query("id"))) {
        arg1->want_kill(arg2);
    }
    if (!arg2->is_fighting(arg1) && !arg1->is_fighting(arg2)) {
        arg1->kill_ob(arg2);
        arg2->fight_ob(arg1);
    }
    return 1;
}

