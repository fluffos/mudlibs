inherit "/inherit/skill/force";
int valid_enable(mixed);
int practice_skill(mixed);
string exert_function_file(mixed);
int valid_comp(mixed);

int valid_enable(mixed arg) {
    return arg == "force";
}

int valid_learn(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = arg->query_skill("kuihua-xinfa", 1);
    v2 = 1;
    if (v1 <= 100) {
        for (v3 = 1; v3 < v1 / 10; v3++) {
            v2 *= 2;
        }
    }
    if (arg->query("gender") != "无性") {
        return notify_fail("学习葵花心法必须先挥刀自宫。\n");
    }
    if (arg->query_skill("force", 1) < 10) {
        return notify_fail("你的基本内功火候不足，不能学葵花心法。\n");
    }
    if (v1 <= 100) {
        if (v1 > 10 && -arg->query("shen") < v2 * 100) {
            return notify_fail("学葵花心法，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
        }
    } else if (-arg->query("shen") < (v1 - 100) * 1000 + 51200) {
        return notify_fail("学葵花心法，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
    }
    if (arg->query_skill("buddhism", 1) || arg->query_skill("taoism", 1)) {
        return notify_fail("你练了秃驴牛鼻子们的心法，还学葵花心法做什麽！\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    return notify_fail("葵花心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(mixed arg) {
    return "/kungfu/skill/kuihua-xinfa/" + arg;
}

int valid_comp(mixed arg) {
