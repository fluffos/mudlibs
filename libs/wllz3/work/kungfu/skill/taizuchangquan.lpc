        return notify_fail("你的紫霞神功火候不够，无法学太祖长拳。\n");
    }
    if (arg->query("max_neili") < 50) {
        return notify_fail("你的内力太弱，无法练太祖长拳。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
