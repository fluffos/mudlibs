int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 != arg1) {
        return notify_fail("你只能用五毒神功提升自己的战斗力。\n");
    }
    if (arg1->query("neili") < arg1->query("max_neili") / 20) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query_temp("powerup")) {
        return notify_fail("你已经在运功中了。\n");
    }
    if (arg1->query_skill("wudu-shengong", 1) < 60) {
        return notify_fail("你的五毒神功修为不足，无法施展神功加力。\n");
    }
    if (arg1->query_skill("force", 1) < 60) {
        return notify_fail("你的内功修为不足，无法施展神功加力。\n");
    }
    v1 = arg1->query_skill("wudu-shengong", 1);
    v1 += arg1->query_skill("force");
    arg1->add("neili", -200);
    arg1->receive_damage("qi", 0);
    message_vision("\e[1;35m$N潜运内力，体内真气灌顶，顿时脸色发紫，眼睛泛起阵阵杀气！\n\e[2;37;0m", arg1);
    arg1->add_temp("apply/attack", v1 / 2);
    arg1->add_temp("apply/dodge", v1 / 2);
    arg1->set_temp("powerup", 1);
    arg1->start_call_out((: call_other, "/kungfu/skill/wudu-shengong/powerup.lpc", "remove_effect", arg1, v1 / 2 :), v1 / 2);
    if (arg1->is_fighting()) {
        arg1->start_busy(3);
    }
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    if (arg1->query_temp("powerup")) {
        arg1->add_temp("apply/attack", -arg2);
        arg1->add_temp("apply/dodge", -arg2);
        arg1->delete_temp("powerup");
        tell_object(arg1, "\e[37m你的五毒神功运行完毕，缓缓将内力收回丹田。\n\e[2;37;0m");
    }
}

