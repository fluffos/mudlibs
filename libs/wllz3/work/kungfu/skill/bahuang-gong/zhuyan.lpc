    }
    if (!environment(arg)->query("sleep_room")) {
        return notify_fail("修炼驻颜之术还是到休息室去吧！\n");
    }
    if (arg->query("neili") < 1000) {
        return notify_fail("你的内力不够！\n");
    }
    if (arg->query("jing") <= 100) {
        return notify_fail("你的精神不够了！\n");
    }
    if (arg->query("qi") < 500) {
        return notify_fail("你的气血不够！\n");
    }
    if (arg->query_skill("bahuang-gong", 1) < 400) {
        return notify_fail("你的八荒六合神功还很粗浅，无法领会驻颜之术！\n");
    }
    if (v2 <= 30) {
        return notify_fail("你现在还年轻呢，这些事情以后再说吧！\n");
    }
    arg->add("qi", -100);
    arg->add("neili", -300);
    arg->receive_damage("jing", 80);
    message_vision("\e[1;35m$N盘膝座下，闭上眼睛，开始修炼驻颜之术。\n\e[2;37;0m", arg);
    arg->start_call_out((: call_other, "/kungfu/skill/bahuang-gong/zhuyan.lpc", "remove_effect", arg :), v1 / 100);
    arg->set_temp("zhuyan", 1);
    arg->start_busy(v1 / 100);
    return 1;
}

