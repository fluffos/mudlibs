inherit "/inherit/skill/skill";
int valid_enable(mixed);
mapping query_action(mixed, mixed);
string query_dodge_msg(mixed);
int practice_skill(mixed);
string perform_action_file(mixed);

mapping *action = ({ ([ "action" : "只见$n左一步，右一步，轻而易举的躲过$N这一招。\n", "dodge" : 20 ]), ([ "action" : "但是$n身形一动，从不可思义的角度转过身来，避开了$N的攻击。\n", "dodge" : 40 ]), ([ "action" : "然而$n却不退反进，脚下步点变幻莫测，反使$N的攻势全部落空。\n", "dodge" : 60 ]), ([ "action" : "但是$n身形飘忽，忽前忽后，忽左忽右，让$N无法下手。\n", "dodge" : 80 ]), ([ "action" : "可是$n身随意转，脚步微变，人竟已在三丈之外，闪过了这一招。\n", "dodge" : 100 ]), ([ "action" : "只见$n左一步，右一步，身形犹如一道清风，转眼间$n已经闪到数丈之外。\n", "dodge" : 120 ]), ([ "action" : "但见$n化做几道身影，围绕着$N连转数圈，反使$N眼花缭乱，阵脚大乱。\n", "dodge" : 140 ]) });

int valid_enable(mixed arg) {
    return arg == "dodge" || arg == "move";
}

int valid_learn(mixed arg) {
    return 1;
}

mapping query_action(mixed arg1, mixed arg2) {
    return action[random(sizeof(action))];
}

string query_dodge_msg(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = this_player();
    v2 = query_action(v1, 0);
    return v2["action"];
}

int practice_skill(mixed arg) {
    if (arg->query("qi") < 40) {
        return notify_fail("你的体力太差了，不能练凌波微步。\n");
    }
    arg->receive_damage("qi", 30);
    return 1;
}

