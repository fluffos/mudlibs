int valid_enable(mixed arg) {
    return arg == "unarmed" || arg == "parry" || arg == "strike";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练降龙十八掌必须空手。\n");
    }
    if (arg->query_skill("huntian-qigong", 1) < 20) {
        return notify_fail("你的混天气功火候不够，无法练降龙十八掌。\n");
    }
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力太弱，无法练降龙十八掌。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("xianglong-zhang", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 5, v2 / 5)];
        }
        v1--;
    }
}

mixed hit_ob(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = arg1->query_skill("xianglong-zhang", 1);
    if (arg1->query_temp("weapon") || arg1->query_temp("secondary_weapon")) {
        return 0;
    }
    if (random(v1) > 200) {
        return ([ "msg" : "\e[1;33m$N深深吸了口气，大吼一声，把降龙十七掌的精华融于双掌之中，刹那间\n只看到狂风大作，飞沙走石，天地为之变色....\n\e[2;37;0m", "damage" : v1 * 2 ]);
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练习降龙十八掌时必须空手。\n");
    }
    if (arg->query("qi") < 40) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 10) {
        return notify_fail("你的内力不够练降龙十八掌。\n");
    }
    arg->receive_damage("qi", 30);
    arg->add("neili", -5);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/xianglong-zhang/" + arg;
}

string query_parry_msg(mixed arg) {
    if (arg) {
        return (skill_dir("parry") + "parry")->query_parry_msg(arg);
    } else {
        return parry_msg[random(sizeof(parry_msg))];
    }
}
