int valid_learn(mixed arg) {
    mixed v1;
    if (arg->query_skill("throwing", 1) < 20) {
        return notify_fail("如果弓箭不熟，怎能在激战中上箭开弓射敌？\n");
    }
    if (arg->query("max_neili") < 50) {
        return notify_fail("你的内力不够，拉不开弓！\n");
    }
    if (!(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "throwing") {
        return notify_fail("手中无弓箭怎能领悟师父所教？\n");
    }
    return 1;
}

mapping query_action(mixed arg) {
    mixed v1;
    if (!arg) {
        arg = this_object();
    }
    v1 = arg->query_skill("throwing", 1) / 15;
    if (v1 > sizeof(action)) {
        v1 = sizeof(action);
    }
    return action[random(v1)];
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

int valid_enable(mixed arg) {
    return arg == "throwing";
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "throwing") {
        return notify_fail("没有弓箭如何练准头？\n");
    }
    if (arg->query("qi") < 40 || arg->query("neili") < 10) {
        return notify_fail("你的体力不足，拉不开弓！\n");
    }
    arg->receive_damage("kee", 30);
    arg->add("neili", -5);
    write("你弯弓搭箭，一箭射中红心！");
    return 1;
}

void throw_weapon(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    if (objectp(arg3)) {
        if (arg3->query_amount() == 1) {
            arg3->unequip();
            tell_object(arg1, "\n你的" + arg3->query("name") + "用完了！\n");
        }
        arg3->add_amount(-1);
    }
}
