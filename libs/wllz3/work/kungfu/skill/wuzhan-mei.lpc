int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("学习五展梅时手中必须有剑。\n");
    }
    if (arg->query("max_neili") < 300) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg->query_skill("biyun-xinfa", 1) < 60) {
        return notify_fail("你的碧云心法太浅。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("wuzhan-mei", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 5, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练五展梅。\n");
    }
    arg->receive_damage("qi", 20);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/wuzhan-mei/" + arg;
}
