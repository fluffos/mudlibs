int perform(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg2) {
        arg2 = offensive_target(arg1);
    }
    if (!arg2 || !arg1->is_fighting(arg2) || !arg2->is_fighting(arg1)) {
        return notify_fail("「四季散花」只能在战斗中对对手使用。\n");
    }
    if (arg1->query_temp("weapon")) {
        return notify_fail("你必须空手使用「四季散花」！\n");
    }
    if (arg1->query_skill("sanhua-zhang", 1) < 120) {
        return notify_fail("你的散花掌不够娴熟，不能使用「四季散花」！\n");
    }
    if (arg1->query_skill("yijinjing", 1) < 120) {
        return notify_fail("你的易筋经内功等级不够，不能使用「四季散花」！\n");
    }
    if (arg1->query_str() < 50) {
        return notify_fail("你的臂力不够强，不能使用「四季散花」！\n");
    }
    if (arg1->query("max_neili") < 800) {
        return notify_fail("你的内力太弱，不能使用「四季散花」！\n");
    }
    if (arg1->query("neili") < 300) {
        return notify_fail("你的内力太少了，无法使用出「四季散花」！\n");
    }
    if (arg1->query_skill_mapped("strike") != "sanhua-zhang") {
        return notify_fail("你现在无法使用「四季散花」进行攻击。\n");
    }
    if (arg1->query("jingli") < 50) {
        return notify_fail("你的精力不足，无法使用「四季散花」进行攻击。\n");
    }
    if (arg1->query("jiali") < 120) {
        return notify_fail("你的加力太弱，无法使用「四季散花」进行攻击。\n");
    }
    v2 = arg1->query_skill("sanhua-zhang", 1) + arg1->query_skill("yijinjing", 1);
    v2 += arg1->query_skill("buddhism", 1) + arg1->query_str();
    v2 = v2 * arg1->query("jiali") / 60;
    switch (random(4)) {
    case 0:
        v1 = "\e[1;32m$N突然面带微笑，手掌微张，掌中涌出一股劲风，恍忽是一片片嫩绿\n的「芳草」，直向$n的面颊飞去！\n\e[2;37;0m";
        v2 = v2 / 3 + random(v2);
        break;
    case 1:
        v1 = "\e[35m只听$N“哎呀”一声，身行象前跌去，突然一道蓝光闪现，破空之声\n中几朵\e[37m「清兰」\e[35m向$n的胸前飞去！\n\e[2;37;0m";
        v2 = v2 / 2 + random(v2);
        break;
    case 2:
        v1 = "\e[1;33m突然$N双手莫念经文，$n忽然觉得眼前人影如山，忽而排山倒海，\n忽而忽而高山流水，觉得一切都在离$n远去，跟着一股醉人的「秋菊」\n清香扑鼻而来。。。\n\e[2;37;0m";
        v2 = v2 / 2 + random(v2 / 2);
        break;
    case 3:
        v1 = "\e[1;37m突然$N大吼一声，顿时把$n吓了一个激灵，之间$N在眉宇之间布满了\n一层薄霜，双目冷冷的瞪着$n，接着僧袍一卷，一朵朵绽开的\e[1;35m「寒梅」\e[1;37m\n向$n满面扑来！\n\e[2;37;0m";
        v2 = v2 + random(v2 / 2);
        break;
    }
    if (random(arg1->query_skill("dodge")) > arg2->query_skill("dodge") / 4) {
        arg1->start_busy(3);
        arg2->receive_damage("qi", v2, arg1);
        arg2->receive_wound("qi", v2 / 3, arg1);
        arg1->add("neili", arg1->query_temp("nl"));
        arg1->add("jingli", -50);
        v3 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v1 += damage_msg(v2, "内伤");
        v1 += "「$n" + eff_status_msg(v3) + " 」\n";
    } else {
        arg1->start_busy(4);
        arg1->add("neili", -(random(100) + 100));
        arg1->add("jingli", -25);
        v1 += "\e[36m可是$p一个巧云翻身，远远的躲了开去。\n\e[2;37;0m";
    }
    message_combatd(v1, arg1, arg2);
    return 1;
}

