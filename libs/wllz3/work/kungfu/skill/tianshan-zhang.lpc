string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("tianshan-zhang", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int valid_enable(mixed arg) {
    return arg == "staff" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "staff") {
        return notify_fail("练习天山杖法手中必须有杖。\n");
    }
    if (arg->query_skill("huagong-dafa", 1) < 50) {
        return notify_fail("你的化功大法太弱，无法学习天山杖法。\n");
    }
    if (arg->query("max_neili") < 80) {
        return notify_fail("你的内力不够。\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "staff") {
        return notify_fail("练习天山杖法手中必须有杖。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练天山杖法。\n");
    }
    arg->receive_damage("qi", 25);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/tianshan-zhang/" + arg;
