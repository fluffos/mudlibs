int exert(mixed, mixed);
string help();

int exert(mixed arg1, mixed arg2) {
    if (!arg2) {
        return notify_fail("你要用真气为谁疗伤？\n");
    }
    if (arg1->is_fighting() || arg2->is_fighting()) {
        return notify_fail("战斗中无法运功疗伤！\n");
    }
    if (arg2 == arg1) {
        return notify_fail("你没有为自己疗伤的能力！\n");
    }
    if (arg1->query_skill("longxiang", 1) < 60) {
        return notify_fail("你的龙象般若功修为不够，无法运功疗伤。\n");
    }
    if (arg2->query("eff_qi") >= arg2->query("max_qi")) {
        return notify_fail("对方现在不需要疗伤。\n");
    }
    if (arg1->query("max_neili") < 300) {
        return notify_fail("你的内力修为不够。\n");
    }
    if (arg1->query("neili") < 150) {
        return notify_fail("你的真气不够。\n");
    }
    if (arg2->query("eff_qi") < arg2->query("max_qi") / 5) {
        return notify_fail(arg2->name() + "已经受伤过重，经受不起你的真气震荡！\n");
    }
    message_vision("\e[1;33m$N坐了下来运起内功，将手掌贴在$n背心，缓缓地将真气输入$n体内....\n过了不久，$N额头上冒出豆大的汗珠，$n吐出一口瘀血，脸色看起来红润多了。\n\e[2;37;0m", arg1, arg2);
    arg2->receive_curing("qi", arg1->query_skill("force") / 3 + 10);
    if (arg2->query("qi") > arg2->query("eff_qi")) {
        arg2->set("qi", arg2->query("eff_qi"));
    }
    arg1->add("neili", -150);
    arg1->set("jiali", 0);
    arg1->start_busy(5);
    if (!arg2->is_busy()) {
        arg2->start_busy(5);
    }
    return 1;
}

