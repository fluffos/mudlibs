    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query("jing") < 30) {
        return notify_fail("你的精太低了。\n");
    }
    if (arg->query("neili") < 20) {
        return notify_fail("你的内力不够练玄天无情指。\n");
    }
    arg->receive_damage("jing", 30);
    arg->add("neili", -10);
    return 1;
}
