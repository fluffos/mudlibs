    v1 = arg->query_skill("wudu-shengong", 1);
    v2 = 1;
    if (v1 <= 100) {
        for (v3 = 1; v3 < v1 / 10; v3++) {
            v2 *= 2;
        }
    }
    if (arg->query_skill("force", 1) < 10) {
