        return notify_fail("你的内力还不够强劲，不能传功给别人。\n");
    }
    if (arg2->query_skill("shenghuo-shengong", 1) < 130) {
        return notify_fail("对方的圣火神功等级不够，不能接受你所传的功力。\n");
    }
    v1 = arg1->query_skill("force") / 3;
    arg1->add("neili", -400);
    arg1->receive_damage("qi", 150);
    arg1->receive_damage("jing", 150);
    message_vision("\e[1;31m\n$N将手掌贴在$n背心大穴上，脸上\e[31m红光\e[1;31m时隐时显，将功力传给$n！\n\n\e[2;37;0m", arg1, arg2);
