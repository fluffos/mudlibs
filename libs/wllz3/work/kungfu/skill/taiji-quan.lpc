string *parry_msg = ({ "$p眼见$P$w攻到，当即使出一招「揽雀尾」，右脚实，左脚虚，运起\n“挤”字诀，粘连粘随，右掌已搭住$P左腕，横劲发出。$N身不由主\n的向前一冲，跨出两步，方始站定。\n", "不料$p双手一圈，如抱太极，一股雄浑无比的力道组成了一个旋涡，只\n带得$P在原地急转七八下。\n", "$p「双风贯耳」，连消带打，双手成圆形击出，随即左圈右圈，一个圆\n圈跟着一个圆圈，大圈、小圈、平圈、立圈、正圈、斜圈，一个个太极\n圆圈发出，登时便套得$P跌跌撞撞，身不由主的立足不稳。\n", "$p使出一招「云手」，左手高，右手低，一个圆圈已将$P$w套住。\n", "$p觉气息微窒，当下一招「斜飞势」，将$P$w引偏。\n", "$p吸一口气，体内真气流转，右掌挥出，一拒一迎，将$P的力道尽行碰了回去。\n", "$p双掌一翻，使出一招「云手」，双掌柔到了极处，空明若虚，将$P$w\n的急劲尽数化去。\n",
        "$p当即双掌一扬，迎着$w接去，待得手掌与$P$w将触未触之际，施出「揽\n雀尾式」，将$w轻轻拢住，脚下“金鸡独立式”，左足关地，右足悬空，\n全身急转，宛似一枚陀螺。\n", "就在这电光石火的一瞬之间，$p身子一弓，正是「白鹤亮翅」的前半招，$P的劲力登时落空。\n" });

int valid_enable(mixed arg) {
    return arg == "unarmed" || arg == "parry" || arg == "cuff";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练太极拳必须空手。\n");
    }
    if (arg->query("family/family_name") != "明教" && arg->query_skill("taiji-shengong", 1) < 20) {
        return notify_fail("你的太极神功火候不够，无法学太极拳。\n");
    }
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力太弱，无法练太极拳。\n");
    }
    return 1;
}

mixed valid_damage(mixed arg1, mixed arg2, mixed arg3, mixed arg4) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    if (arg2->query_skill("taiji-quan", 1) < 100 || !living(arg2) || arg2->query_temp("weapon")) {
        return 0;
    }
    v4 = arg1->query_skill("count", 1);
    v2 = arg1->query_skill("force") + v4;
    v3 = arg2->query_skill("parry", 1) / 2 + arg2->query_skill("taiji-quan", 1);
    if (v2 / 2 + random(v2) < v3) {
        v1 = ([ "damage" : -arg3 ]);
        switch (random(3)) {
        case 0:
            v1 += ([ "msg" : "\e[1;36m$n\e[1;36m面含微笑，双手齐出，划出了一个圆圈，竟然让$N\e[1;36m的攻击全不着力。\n\e[2;37;0m" ]);
            break;
        case 1:
            v1 += ([ "msg" : "\e[1;36m$n\e[1;36m左右格档，使出四两拨千斤的手法，化解$N\e[1;36m的攻势于无形。\n\e[2;37;0m" ]);
            break;
        default:
            v1 += ([ "msg" : "\e[1;36m$n\e[1;36m慢慢出拳\e[1;36m，动作虽然缓慢，却让$N\e[1;36m感到浑身粘滞，甚不舒畅。\n\e[2;37;0m" ]);
            break;
        }
        return v1;
    } else if (v4 >= 100) {
        switch (random(3)) {
        case 0:
            v1 = "\e[1;33m$n\e[1;33m面含微笑，双手齐出，划出了一个圆圈，然而$N\e[1;33m理也不理，随手挥招直入，进袭$n\e[1;33m！\n\e[2;37;0m";
            break;
        case 1:
            v1 = "\e[1;33m$n\e[1;33m左右格档，使出四两拨千斤的手法，可是$N\e[1;33m攻势却是变化无方，不遵循常理。\n\e[2;37;0m";
            break;
        default:
            v1 = "\e[1;33m$n\e[1;33m慢慢出拳\e[1;33m，动作缓慢却让$N\e[1;33m感到粘滞，可是$N\e[1;33m立刻变化节奏，出奇招快速进击$n\e[1;33m！\n\e[2;37;0m";
            break;
        }
        "/adm/daemons/combatd"->set_bhinfo(v1);
    }
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("taiji-quan", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 5, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练太极拳必须空手。\n");
    }
    if (arg->query("qi") < 30) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 20) {
        return notify_fail("你的内力不够练太极拳。\n");
    }
    arg->receive_damage("qi", 25);
    arg->add("neili", -10);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/taiji-quan/" + arg;
}

string query_parry_msg(mixed arg) {
    if (!arg) {
        return parry_msg[random(sizeof(parry_msg))];
    }
}
