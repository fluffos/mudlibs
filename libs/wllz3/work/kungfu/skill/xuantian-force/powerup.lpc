        return notify_fail("你已经不能再提升战力了。\n");
    }
    if (arg1->query_skill("xuantian-force", 1) < 100) {
        return notify_fail("你的玄天无极神功修为不足，无法运功加力。\n");
    }
    if (arg1->query_skill("force", 1) < 100) {
        return notify_fail("你的内功修为不足，无法运功加力。\n");
    }
    if (arg1->query("neili") < arg1->query("max_neili") / 20) {
        return notify_fail("你的内力不够。\n");
    }
    v1 = arg1->query_skill("xuantian-force", 1);
    if (v1 < 80) {
        return notify_fail("你的玄天无极还不够娴熟。\n");
    }
    arg1->add("neili", -arg1->query("max_neili") / 20);
    arg1->receive_damage("qi", 0);
    message_vision("\e[1;31m$N长吸一口气，运起玄天无极已将全身潜力尽数提起！\n\e[2;37;0m", arg1);
