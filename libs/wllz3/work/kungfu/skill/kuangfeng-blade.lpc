int valid_enable(mixed arg) {
    return arg == "blade" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "blade") {
        return notify_fail("练狂风刀法手中必须有刀。\n");
    }
    if (arg->query("max_neili") < 300) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg->query_skill("force", 1) < 60) {
        return notify_fail("你的内功心法火候太浅。\n");
    }
    if (arg->query_skill("dodge", 1) < 60) {
        return notify_fail("你的轻功火候太浅。\n");
    }
    if (arg->query_dex() < 25) {
        return notify_fail("你的身法还不够灵活。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
