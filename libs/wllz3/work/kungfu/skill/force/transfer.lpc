int exert(mixed, mixed);

int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg2 || arg2 == arg1 || !living(arg2)) {
        return notify_fail("你要将真气传给谁？\n");
    }
    if (arg1->query_skill_mapped("force") != arg2->query_skill_mapped("force")) {
        return notify_fail(arg2->name() + "所使用的内功和你不同。\n");
    }
    if (arg1->query("neili") <= arg1->query("max_neili")) {
        return notify_fail("你的真气不足。\n");
    }
    v1 = arg1->query("neili") - arg1->query("max_neili");
    if (v1 / 2 < 1) {
        return notify_fail("你的真气不足。\n");
    }
    arg1->add("neili", -v1 / 2);
    message_vision("$N将手掌贴在$n背心，运气将体内真气传送过去。\n", arg1, arg2);
    if (random(v1 / 3) > arg1->query_skill("force")) {
        return notify_fail("你失败了。\n");
    }
    if (arg2->query("neili") > arg2->query("max_neili") * 20) {
        tell_object(arg2, "\e[31m你只觉一股内力在你体内乱窜，无法控制内息的流动！\n");
        return notify_fail("你失败了。\n");
    }
    arg2->add("neili", v1 / 3);
    tell_object(arg2, "\e[1;33m你觉得一股热气从" + arg1->name() + "的手掌传了过来。\n\e" + "[2;37;0m");
    write("你成功了。\n");
    if (arg2->query("neili") >= arg2->query("max_neili") * 2) {
        arg2->set("neili", arg2->query("max_neili") * 2);
        tell_object(arg2, "你体内的内力太多啦。\n");
    }
    return 1;
}
