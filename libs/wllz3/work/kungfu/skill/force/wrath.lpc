int exert(mixed, mixed);
int wrathing(mixed);
int halt_wrath(mixed);

int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 != arg1) {
        return notify_fail("你只能激励自己的斗志。\n");
    }
    if (arg1->is_fighting()) {
        return notify_fail("难道你已经没有战斗意志了嘛？\n");
    }
    if (arg1->query_skill("force") < 50) {
        return notify_fail("你的内功修为不足以用真气激励斗志。\n");
    }
    if (arg1->query("max_neili") < 1000) {
        return notify_fail("你的内力修为尚浅，无法使用真气激励斗志。\n");
    }
    v1 = arg1->anger_bonus();
    if (arg1->query("neili") + 100 <= v1) {
        return notify_fail("你的内力不足以激发斗志。\n");
    }
    if (arg1->is_most_craze()) {
        return notify_fail("你现在斗志蓬勃，不需要再激励斗志。\n");
    }
    message_vision("$N盘膝而坐，企图运用真气激发自己的斗志。\n", arg1);
    arg1->start_busy((: call_other, "/kungfu/skill/force/wrath.lpc", "wrathing" :), (: call_other, "/kungfu/skill/force/wrath.lpc", "halt_wrath" :));
    arg1->set_short_desc("盘膝而坐，一道道真气徐徐自丹田涌入头顶。");
    return 1;
}

int wrathing(mixed arg) {
    mixed v1;
    v1 = arg->anger_bonus();
    if (arg->query("neili") + 100 <= v1) {
        write("你只觉内力渐渐消退，全身疲软，于是猛吸了口气，站了起来。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->query("qi") < 400) {
        write("你只觉真气不续，于是猛吸了口气，站了起来。\n");
        arg->set_short_desc(0);
        return 0;
    }
    if (arg->is_most_craze()) {
        write("\e[1;36m你只觉斗志蓬勃，浑身充满了力量，即刻便站了起来，想找人较量一番。\n\e[2;37;0m");
        arg->set_short_desc(0);
        return 0;
    }
    write(random(5) == 2 ? "\e[31m你只觉体内气血翻腾，犹如一团怒火在你心中不停燃烧。\n\e[2;37;0m" : "\e[36m你觉得浑身充满了力量，反复思索之间，只觉自己武功造诣大增。\n\e[2;37;0m");
    if (arg->add("neili", -v1) < 0) {
        arg->set("neili", 0);
    }
    arg->add("qi", -100);
    arg->improve_craze(v1);
    return 1;
}

int halt_wrath(mixed arg) {
    if (!arg) {
        return 0;
    }
    write("你猛的吸了口气，突然站了起来。\n");
    arg->set_short_desc(0);
    return 1;
}
