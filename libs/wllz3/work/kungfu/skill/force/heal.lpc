int exert(mixed, mixed);
int healing(mixed);
int halt_healing(mixed);

int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg1->is_fighting()) {
        return notify_fail("战斗中运功疗伤？找死吗？\n");
    }
    if (arg1->is_busy()) {
        return notify_fail("你现在正忙着呢。\n");
    }
    v1 = arg1->query_skill_mapped("force");
    if (!stringp(v1)) {
        return notify_fail("你要运用哪一门内功心法进行疗伤？\n");
    }
    if (arg1->query_skill(v1, 1) < 20) {
        return notify_fail("你的" + to_chinese(v1) + "修为还不够。\n");
    }
    if (arg1->query("eff_qi") < arg1->query("max_qi") / 2) {
        return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
    }
    if (arg1->query("eff_qi") >= arg1->query("max_qi")) {
        return notify_fail("你现在体力充沛，无需再进行疗伤了。\n");
    }
    message_vision("\e[1;37m$N全身放松，坐下来开始运功疗伤。\n\e[2;37;0m", arg1);
    arg1->set_temp("pending/healing", 1);
    arg1->set_short_desc("正坐在地下运功疗伤。");
    arg1->start_busy((: call_other, "/kungfu/skill/force/heal.lpc", "healing" :), (: call_other, "/kungfu/skill/force/heal.lpc", "halt_healing" :));
    return 1;
}

int healing(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = arg->query_skill_mapped("force");
    if (playerp(arg)) {
        v2 = arg->query("max_qi") / 80;
    } else {
        v2 = arg->query("max_qi") / 50;
    }
    if (!stringp(v1)) {
        tell_object(arg, "你一时难以定夺如何运用内力，只好先暂停疗伤。\n");
        arg->set_temp("pending/healing", 0);
        arg->set_short_desc(0);
        message_vision("$N叹了口气，摇摇晃晃的站了起来。\n", arg);
        return 0;
    }
    if (arg->query("eff_qi") < arg->query("max_qi")) {
        if (arg->query("neili") < v2 * 2) {
            tell_object(arg, "你觉得真气不济，难以在经脉中继续运转疗伤。\n");
            arg->set_temp("pending/healing", 0);
            arg->set_short_desc(0);
            message_vision("$N叹了口气，摇摇晃晃的站了起来。\n", arg);
            return 0;
        }
        v3 = arg->query_con();
        arg->receive_curing("qi", v2 + v3);
        arg->add("neili", -v2 * 2);
        switch (random(10)) {
        case 0:
            tell_object(arg, "你运用" + to_chinese(v1) + "沿着诸大穴慢慢运转，疗解伤痛。\n");
            break;
        case 1:
            tell_object(arg, "你将内力纳入丹田，再上行冲顶，透泥宫，顿觉精神爽快。\n");
            break;
        case 2:
            tell_object(arg, "你将内力运入四肢百赅，复又回收丹田，伤势痊愈不少。\n");
            break;
        }
        return 1;
    }
    arg->set_short_desc(0);
    arg->delete_temp("pending/healing");
    message_vision("\e[1;33m$N\e[1;33m运功完毕，吐出一口瘀血，脸色看起来好多了。\n\e[2;37;0m", arg);
    return 0;
}

int halt_healing(mixed arg) {
    tell_object(arg, "你将真气收回丹田，微微喘息，站了起来。\n");
    tell_room(environment(arg), arg->name() + "猛的吸一口气，突然站了起来。\n", arg);
    arg->set_temp("pending/healing", 0);
    arg->set_short_desc(0);
    if (arg->query("neili") > 100) {
        arg->add("neili", -100);
    } else {
        arg->set("neili", 0);
    }
    return 1;
}
