int exert(mixed, mixed);

int exert(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (arg2 != arg1) {
        return notify_fail("你只能用内功恢复自己的精力。\n");
    }
    v2 = arg1->query("eff_jing") - arg1->query("jing");
    if (v2 < 10) {
        return notify_fail("你现在精力充沛。\n");
    }
    if (arg1->query("neili") < 20) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query_skill("force", 1) < 10) {
        return notify_fail("你的内功不足，无法恢复精力。\n");
    }
    v1 = v2 * 100 / arg1->query_skill("force");
    v1 = v1 * 30 / arg1->query_con();
    if (v1 < 20) {
        v1 = 20;
    }
    if (arg1->query("neili") < v1) {
        v2 = v2 * arg1->query("neili") / v1;
        v1 = arg1->query("neili");
    }
    arg1->add("neili", -v1);
    arg1->receive_heal("jing", v2);
    if (arg1->is_fighting()) {
        message_vision("\e[33m$N深深吸了几口气，精神看起来好多了。\n\e[2;37;0m", arg1);
        arg1->start_busy(1);
    } else {
        write("\e[33m你深深吸了几口气，精神看起来好多了。\n\e[2;37;0m");
    }
    return 1;
}
