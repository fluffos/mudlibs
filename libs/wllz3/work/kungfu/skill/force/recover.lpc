int exert(mixed, mixed);

int exert(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (arg1 != arg2) {
        return notify_fail("你只能用内功调匀自己的气息。\n");
    }
    if (arg1->query("neili") < 20) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query("eff_qi") < arg1->query("max_qi") / 2) {
        return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
    }
    v2 = arg1->query("eff_qi") - arg1->query("qi");
    if (v2 < 10) {
        return notify_fail("你现在气息充沛。\n");
    }
    v1 = v2 * 100 / arg1->query_skill("force");
    v1 = v1 * 30 / arg1->query_con();
    if (v1 < 20) {
        v1 = 20;
    }
    if (arg1->query("neili") < v1) {
        v2 = v2 * arg1->query("neili") / v1;
        v1 = arg1->query("neili");
    }
    arg1->add("neili", -v1);
    arg1->receive_heal("qi", v2);
    if (arg1->is_fighting()) {
        message_vision("\e[37m$N深深吸了几口气，脸色看起来好多了。\n\e[2;37;0m", arg1);
        arg1->start_busy(1);
    } else {
        write("\e[37m你深深的吸了口气，脸色看起来好多了。\n\e[2;37;0m");
    }
    return 1;
}
