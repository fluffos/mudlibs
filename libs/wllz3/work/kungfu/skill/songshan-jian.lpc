int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry";
}

int valid_learn(mixed arg) {
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg->query_skill("songshan-qigong", 1) < 20) {
        return notify_fail("你的嵩山气功火候太浅。\n");
    }
    if (arg->query_skill("songyang-zhang", 1) < 20) {
        return notify_fail("你的大嵩阳神掌火候太浅。\n");
    }
    return 1;
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("songshan-jian", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("jingli") < 50) {
        return notify_fail("你的体力不够练嵩山剑法。\n");
    }
    arg->receive_damage("jingli", 35);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/songshan-jian/" + arg;
}
