int perform(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    if (!arg2) {
        arg2 = offensive_target(arg1);
    }
    if (!arg2 || !arg2->is_character() || !arg1->is_fighting(arg2)) {
        return notify_fail("你只能在战斗中对对手进行弹射。\n");
    }
    v5 = arg1->query_skill("tanzhi-shentong", 1);
    if (v5 < 200) {
        return notify_fail("你的弹指神通不够娴熟，无法进行弹射。\n");
    }
    if (arg1->query_skill("bibo-shengong", 1) < 200) {
        return notify_fail("你的弹指神通不够娴熟，无法进行弹射。\n");
    }
    if (!objectp(v2 = arg1->query_temp("weapon"))) {
        return notify_fail("你必须装备暗器才能进行弹射。\n");
    }
    if ((v4 = v2->query_amount()) < v5 / 20) {
        return notify_fail("你掏了掏背囊，发现里面的暗器已经不够了！\n");
    }
    if (arg1->query("neili") < 450) {
        return notify_fail("你的内力不够，无法进行弹射。\n");
    }
    arg1->clean_up_enemy();
    v1 = "\e[1;37m$N双手在背囊里一抓，抓出" + "/adm/daemons/chinesed"->chinese_number(v5 / 20) + v2->query("base_unit") + v2->query("name") + "\e" + "[1;37m来，运用指力朝$n弹了出去。\n\e" + "[2;37;0m";
    v3 = v5 * 2 + arg1->query_skill("bibo-shengong", 1);
    v3 += random(v3);
    if (random(arg1->query_dex()) > arg2->query_dex() / 4) {
        v1 += "\e[1;31m$n躲闪不及，“噗噗”地几声，被几道暗器击中！\n\e[2;37;0m";
        arg2->receive_damage("qi", v3 / 3, arg1);
        arg2->receive_wound("qi", v3 / 2, arg1);
        v6 = arg2->query("qi") * 100 / arg2->query("max_qi");
        v1 += "「$n" + eff_status_msg(v6) + "」\n";
    } else {
        v1 += "\e[1;36m$n吓得赶忙抱头团身，万分狼狈地向旁边一滚，方才堪堪地躲了过去。\n\e[2;37;0m";
    }
    message_combatd(v1, arg1, arg2);
    arg1->add("neili", -350);
    arg1->start_busy(3);
    if (v4 == v5 / 20) {
        v2->unequip();
        tell_object(arg1, "你的" + v2->query("name") + "用完了！\n");
        destruct(v2);
    }
    v2->add_amount(-(v5 / 20));
    return 1;
}

