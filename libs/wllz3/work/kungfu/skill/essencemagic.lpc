inherit "/inherit/skill/skill";
int valid_enable(mixed);
string conjure_magic_file(mixed);

string type() {
    return "martial";
}

int valid_enable(mixed arg) {
    return arg == "magic";
}

int valid_learn(mixed arg) {
    if (arg->query_skill("lamaism") < 10 || arg->query_skill("lamaism") <= arg->query_skill("essencemagic")) {
        return notify_fail("你的密宗心法修为还不够高深，无法学习八识神通。\n");
    }
    if (arg->query("family/family_name") != "雪山寺") {
        return notify_fail("非雪山寺弟子，不能学习八识神通。\n");
    }
    return 1;
}

