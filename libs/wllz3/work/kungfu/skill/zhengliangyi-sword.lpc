int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        if (!objectp(v1 = arg->query_temp("secondary_weapon")) || v1->query("skill_type") != "sword") {
            return notify_fail("你必须先找把剑才能学剑法。\n");
        }
    }
    if (arg->query_skill("sword", 1) <= arg->query_skill("zhengliangyi-sword", 1)) {
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
