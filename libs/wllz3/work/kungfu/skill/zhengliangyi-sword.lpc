            v1 = action[NewRandom(v2, 20, v3 / 5)];
            break;
        }
        v2--;
    }
    v1["dodge"] = -(v3 * 2);
    v1["attack"] = v3 / 2;
    v1["damage"] = v3;
    return v1;
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练正两仪剑法。\n");
    }
    arg->receive_damage("qi", 25);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/zhengliangyi-sword/" + arg;
