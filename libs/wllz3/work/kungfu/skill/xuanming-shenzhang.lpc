int valid_enable(mixed arg) {
    return arg == "unarmed" || arg == "parry" || arg == "strike";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练玄冥神掌必须空手。\n");
    }
    if (!arg->query("is_zongshi")) {
        return notify_fail("以你目前的能力，恐怕难以理会玄冥神掌当中的精髓。\n");
    }
    if (arg->query("max_neili") < 5000) {
        return notify_fail("你的内力太弱，无法练玄冥神掌。\n");
    }
    if (arg->query_skill("duanhun-qiangfa", 1) || arg->query_skill("dugu-jianqi", 1) || arg->query_skill("ningxue-shenzhua", 1)) {
        return notify_fail("你怎么身兼多种宗师武功呢？\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

