    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("xuanming-shenzhang", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

mixed hit_ob(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    if (arg3 < 100) {
        return 0;
    }
    if (arg1->query_temp("weapon") || arg1->query_temp("secondary_weapon")) {
        return 0;
    }
    if (intp(v1 = arg1->query_skill("xuanming-shenzhang", 1)) && v1 > 200) {
        return ([ "msg" : "\e[1;32m$N突然一声暴喝，双手骤然之间泛起一道青绿之光，五指迅速扩散而开，\n猛然间带着一股阴寒无比之气，朝$n胸口攻去。\n\e[2;37;0m", "damage" : arg3 * 3, "poison" : "xuanming_poison", "poison_lv" : 200 ]);
