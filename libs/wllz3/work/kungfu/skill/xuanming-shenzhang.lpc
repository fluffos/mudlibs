int practice_skill(mixed arg) {
    if (arg->query("qi") < 100) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 100) {
        return notify_fail("你的内力不够练玄冥神掌。\n");
    }
    if (!arg->query("is_zongshi")) {
        return notify_fail("以你目前的能力，恐怕难以理会玄冥神掌当中的精髓。\n");
    }
    arg->receive_damage("qi", 100);
    arg->add("neili", -50);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/xuanming-shenzhang/" + arg;
}
