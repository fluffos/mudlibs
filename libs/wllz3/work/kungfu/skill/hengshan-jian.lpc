mapping *action = ({ ([ "action" : "$N提起$w，划了个半圈，斜斜向$n$l刺去", "force" : 120, "dodge" : 40, "damage" : 30, "damage_type" : "刺伤" ]), ([ "action" : "$N突然间将$w交左手，反手刺出", "force" : 140, "dodge" : 35, "damage" : 35, "damage_type" : "刺伤" ]) });

