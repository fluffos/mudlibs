inherit "/feature/clean_up";
void remove_effect(mixed, mixed);
int exert(mixed, mixed);
string help();

int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 != arg1) {
        return notify_fail("你只能用碧波神功提升自己的战斗力。\n");
    }
    if (arg1->query("neili") < arg1->query("max_neili") / 20) {
        return notify_fail("你的内力不够！");
    }
    if (arg1->query_skill("force", 1) < 100) {
        return notify_fail("你的内功修为不足，无法使用这种内功。\n");
    }
    if (arg1->query_skill("bibo-shengong", 1) < 100) {
        return notify_fail("你的碧波神功修为不足，无法使用这种内功。\n");
    }
    if (arg1->query_temp("powerup")) {
        return notify_fail("你已经在运功中了。\n");
    }
    v1 = arg1->query_skill("force");
    arg1->add("neili", -arg1->query("max_neili") / 20);
    arg1->receive_damage("qi", 0);
    message_combatd("\e[1;31m$N舌尖一咬，喷出一口鲜血，运起碧波神功已将全身潜力尽数提起！\n\e[2;37;0m", arg1);
    arg1->add_temp("apply/attack", v1 / 3);
    arg1->add_temp("apply/dodge", v1 / 3);
    arg1->set_temp("powerup", 1);
    arg1->add("bellicosity", 100);
    arg1->start_call_out((: call_other, "/kungfu/skill/bibo-shengong/powerup.lpc", "remove_effect", arg1, v1 / 3 :), v1);
    if (arg1->is_fighting()) {
        arg1->start_busy(3);
    }
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (arg1->query_temp("powerup")) {
        arg1->add_temp("apply/attack", -arg2);
        arg1->add_temp("apply/dodge", -arg2);
        arg1->delete_temp("powerup");
        tell_object(arg1, "你的碧波神功运行完毕，将内力收回丹田。\n");
    }
}

