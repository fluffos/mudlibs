int exert(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    if (environment(arg1)->query("no_fight")) {
        return notify_fail("这里禁止战斗！\n");
    }
    if (!objectp(v2 = present("yuxiao", arg1))) {
        return notify_fail("你手中无萧，如何吹奏碧海潮生？\n");
    }
    if (arg1->query("neili") < arg1->query("max_neili") / 20) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query_skill("music", 1) < 140) {
        return notify_fail("你连五音十二律都没学好，更不用说吹奏碧海潮声了。\n");
    }
    if (arg1->query_skill("bibo-shengong", 1) < 140) {
        return notify_fail("你的碧波神功的修为还不够，无法吹奏碧海潮生曲。\n");
    }
    v5 = arg1->query_skill("force");
    arg1->add("neili", -arg1->query("max_neili") / 20);
    arg1->receive_damage("qi", 10);
    if (!arg1->is_busy()) {
        arg1->start_busy(5);
    }
    message_combatd("\e[1;33m$N将箫凑到嘴边，幽幽咽咽的吹奏起“碧海潮生曲”来，曲调如泣如述，柔糜万端。\n\e[2;37;0m", arg1);
    v1 = all_inventory(environment(arg1));
    foreach (v3 in v1) {
        if (!living(v3) || v3 == arg1) {
            continue;
        }
        if (!v3->query("can_speak") || v3->query("not_living")) {
            continue;
        }
        if (playerp(v3) && (!arg1->valid_attack() || !v3->valid_attack())) {
            continue;
        }
        if (playerp(v3) && !v3->is_want_kill(arg1)) {
            arg1->want_kill(v3);
        }
        if (!v3->is_killing(arg1->query("id"))) {
            v3->fight_ob(arg1);
        }
        if (!arg1->is_killing(v3)) {
            arg1->fight_ob(v3);
        }
        if (v5 / 2 + random(v5) < (v3->query_con() + v3->query_cor()) * 2) {
            continue;
        }
        if (random(arg1->query("level")) < v3->query("level") / 3) {
            continue;
        }
        v6 = v5 + arg1->query_skill("music", 1) - v3->query_skill("force") / 3;
        v6 += random(v6);
        if (v6 > 0) {
            v4 = "\e[1;37m$n只觉得一股深厚的内劲犹如无数排山巨浪，迎面扑来 . . . . . .\n\e[2;37;0m";
            if (random(arg1->query("max_neili")) > v3->query("max_neili") / 4) {
                v4 += "\e[1;37m那股内劲直闯$n的体内，$n脸色一变，“哇”的一声吐出了一口鲜血。\n\e[2;37;0m";
                v3->receive_wound("jing", v6, arg1);
                v7 = v3->query("jing") * 100 / v3->query("max_jing");
                v4 += "「$n" + eff_status_msg(v7) + "」\n\n";
            } else {
                v4 = "\e[1;36m\n哪知$n内功深厚，运气凝神，碧海潮生曲丝毫不觉任何威力。\n\n\e[2;37;0m";
            }
        }
        message_combatd(v4, arg1, v3);
    }
    return 1;
}

