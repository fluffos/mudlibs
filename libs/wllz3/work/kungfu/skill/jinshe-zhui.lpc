int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "throwing") {
        return notify_fail("你必须先找一些暗器才能练金蛇锥法。\n");
    }
    if (arg->query("max_neili") < 500) {
        return notify_fail("你的内力不够，没有办法练金蛇锥法。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

int valid_enable(mixed arg) {
    return arg == "throwing";
}

mapping query_action(mixed arg1, mixed arg2) {
    return action[random(sizeof(action))];
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "throwing") {
        return notify_fail("你必须先找一些暗器才能练金蛇锥法。\n");
    }
    if (arg->query("qi") < 30 || arg->query("neili") < 500) {
        return notify_fail("你的内力或气不够，没有办法练习金蛇锥法。\n");
    }
    arg->receive_damage("qi", 30);
    arg->add("neili", -30);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/jinshe-zhui/" + arg;
}
