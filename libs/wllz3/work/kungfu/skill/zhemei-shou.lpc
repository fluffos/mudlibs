int valid_enable(mixed arg) {
    return arg == "unarmed" || arg == "parry" || arg == "hand";
}

int valid_combine(mixed arg) {
    return arg == "liuyang-zhang";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练天山折梅手必须空手。\n");
    }
    if (arg->query("max_neili") < 50) {
        return notify_fail("你的内力太弱，无法练天山折梅手。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("zhemei-shou", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (objectp(arg->query_temp("weapon"))) {
        return notify_fail("练习天山折梅手必须空手。\n");
    }
    if (arg->query("qi") < 30) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 20) {
        return notify_fail("你的内力不够练天山折梅手。\n");
    }
    arg->receive_damage("qi", 25);
    arg->add("neili", -10);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/zhemei-shou/" + arg;
}

int double_attack() {
    mixed v1;
    v1 = this_player();
    if (v1->query_skill("zhemei-shou", 1) > 150 && (v1->query_skill("beiming-shengong", 1) > 150 || v1->query_skill("bahuang-gong", 1) > 150)) {
        return 1;
    }
}
