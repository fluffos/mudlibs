inherit "/inherit/skill/force";
int valid_enable(mixed);
int practice_skill(mixed);
string exert_function_file(mixed);
int valid_comp(mixed);

int valid_enable(mixed arg) {
    return arg == "force";
}

int valid_learn(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = arg->query_skill("xixing-force", 1);
    v2 = 1;
    if (v1 <= 100) {
        for (v3 = 1; v3 < v1 / 10; v3++) {
            v2 *= 2;
        }
    }
    if (arg->query_skill("force", 1) < 10) {
        return notify_fail("你的基本内功火候不足，不能学吸星大法。\n");
    }
    if (arg->query_skill("force", 1) < arg->query_skill("xixing-force", 1)) {
        return notify_fail("你的基本内功修为太差，无法再修炼更高一层的吸星大法了。\n");
    }
    if (v1 <= 100) {
        if (v1 > 10 && -arg->query("shen") < v2 * 100) {
            return notify_fail("学吸星大法，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
        }
    } else if (-arg->query("shen") < (v1 - 100) * 1000 + 51200) {
        return notify_fail("学吸星大法，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    return notify_fail("吸星大法只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(mixed arg) {
    return "/kungfu/skill/xixing-force/" + arg;
}

