int valid_enable(mixed arg) {
    return arg == "unarmed" || arg == "parry";
}

int valid_combine(mixed arg) {
    return arg == "luoying-zhang";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练习旋风扫叶腿必须空手。\n");
    }
    if (arg->query_skill("bibo-shengong", 1) < 15) {
        return notify_fail("你的碧波神功火候不够，无法学旋风扫叶腿。\n");
    }
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力太弱，无法练旋风扫叶腿。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("xuanfeng-leg", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (objectp(arg->query_temp("weapon"))) {
        return notify_fail("练习旋风扫叶腿必须空手。\n");
    }
    if (arg->query("qi") < 30) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 20) {
        return notify_fail("你的内力不够练旋风扫叶腿。\n");
    }
    arg->receive_damage("qi", 20);
    arg->add("neili", -1);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/xuanfeng-leg/" + arg;
}
