int valid_enable(mixed arg) {
    return arg == "dagger" || arg == "parry";
}

int valid_learn(mixed arg) {
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力不够，没有办法练石鼓打穴笔法。\n");
    }
    if (arg->query_skill_mapped("force") != "wuzheng-xinfa") {
        return notify_fail("石鼓打穴笔法需配合无争心法。\n");
    }
    if (arg->query_skill("wuzheng-xinfa", 1) < 20) {
        return notify_fail("你的无争心法火候不够，还不能学习石鼓打穴笔法!\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("shigu-bifa", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "bi") {
        return notify_fail("你必须先找一对判官笔才能学习石鼓打穴笔法。\n");
    }
    if (arg->query("qi") < 30 || arg->query("neili") < 3) {
        return notify_fail("你的内力或气不够，没有办法练习石鼓打穴笔法。\n");
    }
    arg->receive_damage("qi", 20);
    arg->add("neili", -10);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/shigu-bifa/" + arg;
