inherit "/inherit/skill/skill";
mapping query_action(mixed, mixed);
int valid_enable(mixed);
string query_dodge_msg(mixed);
int practice_skill(mixed);
string perform_action_file(mixed);

mapping *action = ({ ([ "action" : "$p吸一口气，猛地里双脚一撑，提身而起。\n", "dodge" : 5 ]), ([ "action" : "危急中$p提一口真气，双臂急振，上窜丈余。\n", "dodge" : 10 ]), ([ "action" : "$p向后纵出，便如头大鸟一般，稳稳的飞出数丈之外。\n", "dodge" : 15 ]), ([ "action" : "$p当即纵身高跃，一转一折，轻轻巧巧的落在一旁。\n", "dodge" : 20 ]), ([ "action" : "但$p变招奇速，右足向前踢出，身子已然腾起，轻轻巧巧的跨过了$P。\n", "dodge" : 25 ]), ([ "action" : "$p一声清啸，拔身而起，在半空中轻轻一个转折，飘然落在丈许之外。\n", "dodge" : 30 ]), ([ "action" : "陡然间$p身形拔起，在空中急速盘旋，连转四个圈子，愈转愈高，又是一个转折，\n轻轻巧巧的落在数丈之外。\n", "dodge" : 35 ]) });

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = sizeof(action);
    v2 = arg1->query_skill("tiyunzong");
    if (v2 < 60) {
        v1--;
    }
    if (v2 < 50) {
        v1--;
    }
    if (v2 < 40) {
        v1--;
    }
    return action[random(v1)];
}

