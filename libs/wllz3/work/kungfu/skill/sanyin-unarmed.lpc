    }
    if (arg->query_skill("unarmed", 1) < 30) {
        return notify_fail("你的基本拳脚火候不够，无法学三阴掌。\n");
    }
    if (arg->query_skill("unarmed", 1) <= arg->query_skill("yunlong-shou", 1)) {
        return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
    }
    return 1;
}

