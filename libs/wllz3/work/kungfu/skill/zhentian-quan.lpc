int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练「震天拳」必须空手。\n");
    }
    if (arg->query_skill("xuantian-force", 1) < 25) {
        return notify_fail("你的「玄天无极功」火候不够，无法学「震天拳」。\n");
    }
    if (arg->query("max_neili") < 50) {
        return notify_fail("你的内力太弱，无法练「震天拳」。\n");
    }
    return 1;
}

