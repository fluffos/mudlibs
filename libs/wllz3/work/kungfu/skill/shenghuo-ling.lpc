    }
    return action[random(sizeof(action))];
}

int valid_learn(mixed arg) {
    mixed v1;
    v1 = arg->query_skill("qiankun-danuoyi", 1);
    if (arg->query("gender") == "无性" && v1 > 49) {
        return notify_fail("你先天不足，再学下去难免走火入魔。\n");
    }
    if (arg->query("max_neili") < 50) {
        return notify_fail("就这么点内力还想学圣火令法？\n");
    }
    if (arg->query_skill("shenghuo-shengong", 1) < 20) {
        return notify_fail("你的圣火神功火候还不够，学不了圣火令法！\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练圣火令法。\n");
    }
    arg->receive_damage("qi", 40);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/shenghuo-ling/" + arg;
