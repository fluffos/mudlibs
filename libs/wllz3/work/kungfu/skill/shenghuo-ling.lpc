int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry" || arg == "blade" || arg == "staff" || arg == "club";
}

mapping query_action(mixed arg1, mixed arg2) {
    if (random(arg1->query_skill("sword", 1)) > 60 && arg1->query_skill("shenghuo-shengong", 1) > 60 && arg1->query("neili") > 100 && arg2->query("id") == "shenghuo ling") {
        arg1->add("neili", -100);
