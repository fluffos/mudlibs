int valid_enable(mixed arg) {
    return arg == "blade" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "blade") {
        return notify_fail("练金乌刀法手中必须有刀。\n");
    }
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg->query_skill("jiuyang-shengong") < 10) {
        return notify_fail("你的九阳神功修为不够，无法学习金乌刀法。\n");
    }
    return 1;
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("jinwu-daofa", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 >= action[v1 - 1]["lvl"]) {
            return action[random(v1)];
        }
        v1--;
    }
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "blade") {
        return notify_fail("练金乌刀法手中必须有刀。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练金乌刀法。\n");
    }
    arg->receive_damage("qi", 30);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/jinwu-daofa/" + arg;
