mapping *action = ({ ([ "action" : "$N左手轻轻一抹，向$n的$l拍去", "damage" : 180, "damage_type" : "瘀伤" ]), ([ "action" : "$N右手一提，插向$n的$l", "damage" : 220, "damage_type" : "瘀伤" ]) });

