inherit "/inherit/skill/force";
int valid_enable(mixed);
int practice_skill(mixed);
string exert_function_file(mixed);
int valid_comp(mixed);

int valid_enable(mixed arg) {
    return arg == "force";
}

int valid_learn(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = arg->query_skill("xiantian-qigong", 1);
    v2 = 1;
    if (v1 <= 100) {
        for (v3 = 1; v3 < v1 / 10; v3++) {
            v2 *= 2;
        }
    }
    if (arg->query("gender") == "无性") {
        return notify_fail("你无根无性，阴阳不调，难以修行玄门正宗的先天气功。\n");
    }
    if (arg->query("class") == "bonze") {
        return notify_fail("/adm/daemons/rankd"->query_respect(arg) + "欲修我道家玄门气功，怎又去入了佛门？\n");
    }
    if (arg->query_skill("force", 1) < 10) {
        return notify_fail("你的基本内功火候还不够。\n");
    }
    if (v1 <= 100) {
        if (v1 > 10 && arg->query("shen") < v2 * 100) {
            return notify_fail("你的侠义正气太低了。\n");
        }
    } else if (arg->query("shen") < (v1 - 100) * 1000 + 51200) {
        return notify_fail("你的侠义正气太低了。\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    return notify_fail("先天气功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(mixed arg) {
    return "/kungfu/skill/xiantian-qigong/" + arg;
}

