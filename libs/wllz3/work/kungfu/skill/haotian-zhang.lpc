int valid_enable(mixed arg) {
    return arg == "strike" || arg == "parry" || arg == "unarmed";
}

int valid_combine(mixed arg) {
    return arg == "sun-finger" || arg == "chunyang-quan";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练昊天掌必须空手。\n");
    }
    if (arg->query_skill("xiantian-qigong", 1) < 10) {
        return notify_fail("你的先天气功火候不够，无法学昊天掌。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("haotian-zhang", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 5, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练昊天掌必须空手。\n");
    }
    if (arg->query("qi") < 30) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 20) {
        return notify_fail("你的内力不够练昊天掌。\n");
    }
    arg->receive_damage("qi", 25);
    arg->add("neili", -10);
    return 1;
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/haotian-zhang/" + arg;
}
