    }
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "whip") {
        return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
