int valid_enable(mixed arg) {
    return arg == "whip" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (arg->query("max_neili") < 200) {
        return notify_fail("你的内力不足，没有办法练云龙鞭法, 多练些内力再来吧。\n");
    }
