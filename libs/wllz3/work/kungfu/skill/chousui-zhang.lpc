int valid_enable(mixed arg) {
    return arg == "strike" || arg == "unarmed" || arg == "parry";
}

int valid_combine(mixed arg) {
    return arg == "sanyin-wugongzhao";
}

int valid_learn(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练抽髓掌必须空手。\n");
    }
    if (arg->query_skill("huagong-dafa", 1) < 10) {
        return notify_fail("你的化功大法火候不够，无法练抽髓掌。\n");
    }
    if (arg->query("max_neili") < 60) {
        return notify_fail("你的内力太弱，无法练抽髓掌。");
    }
    return 1;
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("chousui-zhang", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query_temp("weapon") || arg->query_temp("secondary_weapon")) {
        return notify_fail("练抽髓掌必须空手。\n");
    }
    if (arg->query("qi") < 30) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 8) {
        return notify_fail("你的内力不够练抽髓掌。\n");
    }
    if (arg->query_skill("chousui-zhang", 1) < 50) {
        arg->receive_damage("qi", 20);
    } else {
        arg->receive_damage("qi", 30);
    }
    arg->add("neili", -5);
    return 1;
}

mixed hit_ob(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    if (arg1->query_temp("weapon") || arg1->query_temp("secondary_weapon")) {
        return 0;
    }
    if (intp(v1 = arg1->query_skill("huagong-dafa", 1)) && random(v1) > 50 && arg1->query("neili") > 200) {
        arg1->add("neili", -200);
    }
    return ([ "poison" : "xx_poison", "poison_lv" : 30 ]);
}

string perform_action_file(mixed arg) {
    return "/kungfu/skill/chousui-zhang/" + arg;
}
