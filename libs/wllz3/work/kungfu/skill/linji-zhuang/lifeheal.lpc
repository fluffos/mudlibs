        return notify_fail("你要用真气为谁疗伤？\n");
    }
    if (arg2 == arg1) {
        return notify_fail("你无法为自己疗伤。\n");
    }
    if (arg1->is_fighting() || arg2->is_fighting()) {
        return notify_fail("战斗中无法运功疗伤！\n");
    }
    if (arg1->query_skill("linji-zhuang", 1) < 100) {
        return notify_fail("你的临济十二庄修为不够，无法运功疗伤。\n");
    }
    if (arg1->query("max_neili") < 100) {
        return notify_fail("你的内力修为不够。\n");
    }
    if (arg1->query("neili") < 100) {
        return notify_fail("你的真气不够。\n");
    }
    if (arg2->query("eff_qi") >= arg2->query("max_qi") || arg2->query("eff_jing") >= arg2->query("max_jing")) {
        return notify_fail("对方现在状态良好，不需要疗伤。\n");
    }
    if (arg2->query("eff_qi") < arg2->query("max_qi") / 5) {
        return notify_fail(arg2->name() + "已经受伤过重，经受不起你的真气震荡！\n");
    }
    message_vision("\e[1;33m$N坐了下来运起内功，将手掌贴在$n背心，缓缓地将真气输入$n体内....\n\n过了不久，$N额头上冒出豆大的汗珠，$n吐出一口瘀血，脸色看起来红润多了。\n\e[2;37;0m", arg1, arg2);
    arg2->receive_curing("qi", arg1->query_skill("force") / 2 + 10);
    arg2->receive_curing("jing", arg1->query_skill("force") / 2 + 10);
    if (arg2->query("qi") > arg2->query("eff_qi")) {
        arg2->set("qi", arg2->query("eff_qi"));
    }
    if (arg2->query("jing") > arg2->query("eff_jing")) {
        arg2->set("jing", arg2->query("eff_jing"));
    }
