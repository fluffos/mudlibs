int exert(mixed, mixed);
string help();

int exert(mixed arg1, mixed arg2) {
    if (arg1->is_fighting()) {
        return notify_fail("你无法在战斗中运用临济十二庄。\n");
    }
    if (arg1->is_busy()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg1->query_skill("linji-zhuang", 1) < 40) {
        return notify_fail("你的临济十二庄修为还不够。\n");
    }
    if (arg1->query("neili") < 30) {
        return notify_fail("你的真气不够。\n");
    }
    if (arg1->query("family/family_name") != "峨嵋派") {
        return notify_fail("可能缺乏师长指点，你运起临济十二庄，可是武功却毫无丁点长进。\n");
    }
    if (arg1->query("eff_qi") >= arg1->query("max_qi") && arg1->query("eff_jing") >= arg1->query("max_jing")) {
        return notify_fail("你没有受伤。\n");
    }
    if (arg1->query("eff_qi") < arg1->query("max_qi") / 2) {
        return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
    }
    write("\e[1;33m你习地而做，默念临济十二庄「天地」诀，运起临济十二庄功开始疗伤。\n\e[2;37;0m");
    message_vision("\e[1;37m只见$N吐出一口瘀血，脸色看起来好多了。\n\e[2;37;0m", arg1);
    if (arg1->query("eff_qi") < arg1->query("max_qi")) {
        arg1->receive_curing("qi", arg1->query_skill("force") / 5 + 10);
    }
    if (arg1->query("eff_qi") > arg1->query("max_qi")) {
        arg1->set("eff_qi", arg1->query("max_qi"));
    }
    if (arg1->query("eff_jing") < arg1->query("max_jing")) {
        arg1->receive_curing("jing", arg1->query_skill("force") / 5 + 10);
    }
    if (arg1->query("eff_jing") > arg1->query("max_jing")) {
        arg1->set("eff_jing", arg1->query("max_jing"));
    }
    arg1->add("neili", -30);
    arg1->set("jiali", 0);
    arg1->start_busy(2);
    return 1;
}

