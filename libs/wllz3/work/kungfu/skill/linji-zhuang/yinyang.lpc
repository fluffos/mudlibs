int exert(mixed);
void remove_effect(mixed, mixed);
string help();

int exert(mixed arg) {
    mixed v1;
    mixed v2;
    v1 = arg->query_skill("linji-zhuang");
    v2 = v1 * 3 / 2;
    if (arg->is_fighting()) {
        return notify_fail("你无法在战斗中运用临济十二庄。\n");
    }
    if (arg->is_busy()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg->query_skill("linji-zhuang", 1) < 120) {
        return notify_fail("你的临济十二庄修为还不够。\n");
    }
    if (arg->query("family/family_name") != "峨嵋派") {
        return notify_fail("可能缺乏师长指点，你运起临济十二庄，可是武功却毫无丁点长进。\n");
    }
    if (arg->query("neili") < 150) {
        return notify_fail("你的真气不够。\n");
    }
    if (arg->query_temp("yun_yinyang")) {
        return notify_fail("你正在运用临济十二庄的「阴阳」字决！\n");
    }
    write("\e[1;37m你暗运阴阳两庄，吸取阴阳两气，聚精成力，顿觉气力倍增。\n\e[2;37;0m", arg);
    message_vision("\e[1;37m只见$N稍显疲乏，但转瞬间便精神抖擞。\n\e[2;37;0m", arg);
    arg->add("max_jingli", v2);
    arg->add("jingli", v2);
    arg->add_temp("apply/spirituality", arg->query("spi") / 5);
    arg->add_temp("apply/constitution", arg->query("con") / 5);
    arg->set_temp("yun_yinyang", 1);
    arg->add("neili", -150);
    arg->start_call_out((: call_other, "/kungfu/skill/linji-zhuang/yinyang.lpc", "remove_effect", arg, v2 :), v1 * 3 / 2);
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    arg1->add("max_jingli", -arg2);
    arg1->add("jingli", -arg2);
    arg1->add_temp("apply/spirituality", -arg1->query("spi") / 5);
    arg1->add_temp("apply/constitution", -arg1->query("con") / 5);
    arg1->delete_temp("yun_yinyang");
    tell_object(arg1, "\e[1;31m你的临济十二庄「阴阳」字决运功完毕，看起来你脸色好多了。\n\e[2;37;0m");
}

string help() {
    return "$HIG$【阴阳诀】$NOR$\n\n技能等级：临济十二庄\t120\n内力要求：150\n";
