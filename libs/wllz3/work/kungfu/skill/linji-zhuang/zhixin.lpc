int exert(mixed arg) {
    mixed v1;
    if (arg->is_fighting()) {
        return notify_fail("你无法在战斗中运用临济十二庄。\n");
    }
    if (arg->query_temp("yun_zhixin")) {
        return notify_fail("你正在运用临济十二庄的「之心」字决！\n");
    }
    if (arg->query_skill("linji-zhuang", 1) < 60) {
        return notify_fail("你的临济十二庄修为还不够。\n");
    }
    if (arg->query("family/family_name") != "峨嵋派") {
        return notify_fail("可能缺乏师长指点，你运起临济十二庄，可是武功却毫无丁点长进。\n");
    }
    if (arg->query("neili") < 60) {
        return notify_fail("你的真气不够。\n");
    }
    write("\e[35m你微一凝神，运动之心两庄，去浊气出体外，收清气入心中，只觉灵\n台清明，领悟力有所增加。\n\e[2;37;0m", arg);
    message_vision("\e[35m只见$N微一凝神，吞吐几口长气，一对眼眸灵动晶亮，神采弈弈。\n\e[2;37;0m", arg);
    v1 = arg->query_int();
    arg->add_temp("apply/intelligence", v1 / 6);
    arg->set_temp("yun_zhixin", 1);
    arg->add("neili", -60);
    arg->start_call_out((: call_other, "/kungfu/skill/linji-zhuang/zhixin.lpc", "remove_effect", arg, v1 / 6 :), arg->query_skill("literate", 1) * 2);
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    arg1->add_temp("apply/intelligence", -arg2);
    arg1->delete_temp("yun_zhixin");
    tell_object(arg1, "\e[1;31m你体内已积过多浊气，似乎领悟力又归于寻常。\n\e[2;37;0m");
}

string help() {
    return "$HIG$【知心诀】$NOR$\n\n技能等级：临济十二庄\t60\n内力要求：60\n";
