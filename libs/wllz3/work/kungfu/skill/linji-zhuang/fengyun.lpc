int exert(mixed arg) {
    mixed v1;
    if (arg->is_fighting()) {
        return notify_fail("你无法在战斗中运用临济十二庄。\n");
    }
    if (arg->query_temp("yun_fengyun")) {
        return notify_fail("你正在运用临济十二庄的「风云」字决！\n");
    }
    if (arg->is_busy()) {
        return notify_fail("你正忙着哪！\n");
    }
    if (arg->query_skill("linji-zhuang", 1) < 90) {
        return notify_fail("你的临济十二庄修为还不够。\n");
    }
    if (arg->query("family/family_name") != "峨嵋派") {
        return notify_fail("可能缺乏师长指点，你运起临济十二庄，可是武功却毫无丁点长进。\n");
    }
    if (arg->query("neili") < 90) {
        return notify_fail("你的真气不够。\n");
    }
    write("\e[35m你暗运风云两庄，心思浮云飘空之悠闲缓慢，默想狂风荡地之迅速紧\n急一股丹田热气分注四肢百骸，但觉身手敏捷了许多。\n\e[2;37;0m", arg);
    message_vision("\e[35m只见$N微闭双眼，身旁凝起一圈白雾，瞬息间一股旋风卷过，身形又复清晰。\n\e[2;37;0m", arg);
    v1 = arg->query_dex();
    arg->add_temp("apply/dexerity", v1 / 5);
    arg->set_temp("yun_fengyun", 1);
    arg->add("neili", -90);
    arg->start_call_out((: call_other, "/kungfu/skill/linji-zhuang/fengyun.lpc", "remove_effect", arg, v1 / 5 :), arg->query_skill("dodge", 1) * 2);
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    arg1->add_temp("apply/dexerity", -arg2);
    arg1->delete_temp("yun_fengyun");
    tell_object(arg1, "\e[1;31m你风云行功已久，略觉步履沉重了一些。\n\e[2;37;0m");
}

