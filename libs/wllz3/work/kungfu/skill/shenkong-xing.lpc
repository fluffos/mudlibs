mapping *action = ({ ([ "action" : "$n默念忿怒咒，一式「誓言空」，一个筋斗从$N头上一翻而过，跳到$P身后。\n", "dodge" : 15 ]), ([ "action" : "$n作舞立姿，忽左而右，脚踩「莲空」步，从$N的腋下穿到$P身後，绕过$N这一招。\n", "dodge" : 30 ]), ([ "action" : "$n微笑中後退两步，身子一顿，一式「大安空」，跨腿朝边上一跳，$N一招击在空处。\n", "dodge" : 45 ]), ([ "action" : "$n一式「佛空」，身子一侧，信步往左一踏，$N的进攻一下失去了方向，招数被化於无形。\n", "dodge" : 60 ]), ([ "action" : "$n结跏趺坐，双手往$N肩上一按，一式「金刚空」跃起数尺，飘然落到一旁。\n", "dodge" : 75 ]), ([ "action" : "$n一式「心空」，身形似有似无、若隐若现，$N这一招似乎击中$n，似乎又打在空处，浑不着力。\n", "dodge" : 90 ]) });

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v1 = sizeof(action);
    v2 = arg1->query_skill("shenxingkong", 1);
    if (v2 < 50) {
        v1--;
    }
    if (v2 < 40) {
        v1--;
    }
    if (v2 < 30) {
        v1--;
    }
    return action[random(v1)];
}

int valid_enable(mixed arg) {
