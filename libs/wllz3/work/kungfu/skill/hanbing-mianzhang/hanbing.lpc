int perform(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    mixed v3;
    if (!arg2) {
        arg2 = offensive_target(arg1);
    }
    if (!arg2 || !arg2->is_character() || !arg1->is_fighting(arg2)) {
        return notify_fail("寒冰真气只能在战斗中使用。\n");
    }
    if (arg1->query_temp("weapon")) {
        return notify_fail("你必须空手才能使用寒冰真气。\n");
    }
    if (arg1->query_skill("hanbing-mianzhang", 1) < 150) {
        return notify_fail("你的寒冰绵掌修为不够。\n");
    }
    if (arg1->query_skill("force", 1) < 150) {
        return notify_fail("你的基本内功修为不够。\n");
    }
    if (arg1->query_skill_mapped("force") != "jiuyang-shengong") {
        return notify_fail("你没有运用九阳神功呢！\n");
    }
    if (arg1->query_skill_mapped("strike") != "hanbing-mianzhang") {
        return notify_fail("你没有运用寒冰绵掌！\n");
    }
    if (arg1->query("max_neili") <= 1500) {
        return notify_fail("你的内力修为不够！\n");
    }
    if (arg1->query("neili") <= 500) {
        return notify_fail("你的内力不够！\n");
    }
    v1 = "\e[1;34m$N将已修练了十余年的“寒冰真气”注于食指之上，拚着大耗内力，手指一伸，飞点$n的胸口！\n\e[2;37;0m";
    arg1->add("neili", -350);
    if (random(arg1->query_dex()) > arg2->query_dex() * 6 / 11) {
        arg1->add("max_neili", -(random(3) + 1));
        v1 += "\e[37m结果$n促不及防，被$P一指点在胸前大穴上！\n\e[2;37;0m";
        if (arg1->query_skill("hanbing-mianzhang", 1) < arg2->query_skill("hanbing-mianzhang", 1) * 2) {
            v1 += "\e[1;31m$N一指点在$n胸口，不料$p竟然也练有寒冰真气，看来$N这指是无效了。\n\e[2;37;0m";
            tell_object(arg2, "\e[1;33m你只觉一股寒气袭胸，立即全力运功，竟然抗住了寒气的侵袭！\n\e[2;37;0m");
        } else {
            v1 += "\e[1;34m$N一指点在$n胸口，待其运内力抵抗，将寒毒顺着$p的“天池穴”直逼$p的体内。\n\e[2;37;0m";
            tell_object(arg2, "\e[1;37m你只觉一股寒气袭胸，立即全力运功，不料一瞬之间，寒气已将你全身冻僵！\n\e[2;37;0m");
            arg2->receive_damage("qi", arg1->query_skill("strike"), arg1);
            arg2->receive_wound("jing", arg1->query_skill("hanbing-mianzhang", 1), arg1);
            arg2->apply_condition("cold_poison", arg1->query_skill("hanbing-mianzhang", 1) * 2);
            v3 = arg2->query("qi") * 100 / arg2->query("max_qi");
            v1 += damage_msg(arg1->query_skill("strike"), "内伤");
            v1 += "「$n" + eff_status_msg(v3) + "」\n";
        }
    } else {
        v2 = arg2->query_skill_mapped("dodge");
        if (!v2) {
            v2 = "dodge";
        }
        v1 += "\e[37m" + (skill_dir(v2) + v2)->query_dodge_msg(arg2, 1) + "\e" + "[2;37;0m";
    }
    message_combatd(v1, arg1, arg2);
    arg1->start_busy(random(3) + 2);
    return 1;
}

string help() {
    return "$HIG$【寒冰绵掌】$NOR$\n\n技能等级：基本内功\t150\n\t  寒冰绵掌\t150\n内力要求：500/1500\n";
