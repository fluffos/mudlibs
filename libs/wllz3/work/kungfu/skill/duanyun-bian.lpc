int valid_enable(mixed arg) {
    return arg == "whip" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "whip") {
        return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
    }
    if (arg->query("max_neili") < 500) {
        return notify_fail("你的内力不足，没有办法练断云鞭法，多练些内力再来吧。\n");
    }
    if (arg->query_skill("xiantian-qigong", 1) < 50) {
        return notify_fail("你的先天气功火候太浅。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
