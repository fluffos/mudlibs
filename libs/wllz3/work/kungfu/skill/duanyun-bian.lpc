}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "whip") {
        return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
    }
    if (arg->query("jing") < 50) {
        return notify_fail("你的精力不够练断云鞭法。\n");
    }
    arg->receive_damage("jing", 10);
    return 1;
}

string perform_action_file(mixed arg) {
