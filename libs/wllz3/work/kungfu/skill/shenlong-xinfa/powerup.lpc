string help();

int exert(mixed arg1, mixed arg2) {
    mixed v1;
    if (arg2 != arg1) {
        return notify_fail("你只能用神龙心法提升自己的战斗力。\n");
    }
    if (arg1->query_temp("powerup")) {
        return notify_fail("你已经在运功中了。\n");
    }
    if (arg1->query_skill("shenlong-xinfa", 1) < 100) {
        return notify_fail("你的神龙心法修为太差，无法运用神功加力。\n");
    }
    if (arg1->query_skill("force", 1) < 100) {
        return notify_fail("你的内功修为不够，无法运用神功加力。\n");
    }
    if (arg1->query("neili") < arg1->query("max_neili") / 20) {
        return notify_fail("你的内力不够！");
    }
    v1 = arg1->query_skill("force");
    arg1->add("neili", -arg1->query("max_neili") / 20);
    arg1->receive_damage("qi", 0);
    message_vision("\e[1;35m$N舌尖一咬，喷出一口紫血，顿时一股内力直贯双臂！\n\e[2;37;0m", arg1);
    arg1->add_temp("apply/attack", v1 / 3);
    arg1->add_temp("apply/dodge", v1 / 3);
    arg1->set_temp("powerup", 1);
    arg1->start_call_out((: call_other, "/kungfu/skill/shenlong-xinfa/powerup.lpc", "remove_effect", arg1, v1 / 3 :), v1);
    if (arg1->is_fighting()) {
        arg1->start_busy(3);
    }
    return 1;
}

void remove_effect(mixed arg1, mixed arg2) {
    if (!arg1) {
        return;
    }
    if (arg1->query_temp("powerup")) {
        arg1->add_temp("apply/attack", -arg2);
        arg1->add_temp("apply/dodge", -arg2);
        arg1->delete_temp("powerup");
        tell_object(arg1, "你的神龙心法运行完毕，将内力收回丹田。\n");
    }
}

string help() {
    return "$HIG$【神功加力】$NOR$\n\n技能等级：神龙心法\t100\n\t  基本内功\t100\n内力要求：1/5\n";
