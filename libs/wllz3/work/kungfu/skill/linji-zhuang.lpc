inherit "/inherit/skill/force";
int valid_enable(mixed);
int practice_skill(mixed);
string exert_function_file(mixed);
mapping exercise_msg(mixed);

int valid_enable(mixed arg) {
    return arg == "force";
}

int valid_learn(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    v3 = arg->query_skill("force", 1);
    v4 = arg->query_skill("linji-zhuang", 1);
    v2 = arg->query_skill("mahayana", 1);
    v5 = arg->query("guilty");
    if (arg->query("marry")) {
        return notify_fail("你已经破了色戒，无法再学习临济十二庄！\n");
    }
    if (arg->query("gender") != "女性") {
        return notify_fail("你非处女之体，不能练习临济十二庄。\n");
    }
    if (arg->query("class") != "bonze" && v1 > 29) {
        return notify_fail("你不是尼姑，学不了高深的临济十二庄。\n");
    }
    if (v2 <= v4 && v4 <= 120) {
        return notify_fail("你的大乘涅磐功修为不够，无法领会更高深的临济十二庄。\n");
    }
    if (v3 < 10) {
        return notify_fail("你的基本内功火候还不够，无法领会临济十二庄。\n");
    }
    if (v5 > 0) {
        return notify_fail("你屡犯僧家数戒，无法领会更高深的临济十二庄。\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    return notify_fail("临济十二庄只能用学(learn)的来增加熟练度。\n");
}

void skill_improved(mixed arg) {
    switch (arg->query_skill("linji-zhuang", 1)) {
    case 30:
        tell_object(arg, "\e[1;32m你天地庄练成了！\n\e[2;37;0m");
        break;
    case 60:
        tell_object(arg, "\e[1;32m你之心庄练成了！\n\e[2;37;0m");
        break;
    case 90:
        tell_object(arg, "\e[1;32m你龙鹏庄练成了！\n\e[2;37;0m");
        break;
    case 120:
        tell_object(arg, "\e[1;32m你风云庄练成了！\n\e[2;37;0m");
        break;
    case 150:
        tell_object(arg, "\e[1;32m你大小庄练成了！\n\e[2;37;0m");
        break;
    case 180:
        tell_object(arg, "\e[1;32m你幽冥庄练成了！\n\e[2;37;0m");
        break;
    }
}

string exert_function_file(mixed arg) {
    return "/kungfu/skill/linji-zhuang/" + arg;
}

mapping exercise_msg(mixed arg) {
    return ([ "status_msg" : "脸上红光隐现，双手搭落在膝盖上。", "start_my_msg" : "\e[1;31m你席地而坐，五心向天，脸上红光时隐时现，内息顺经脉缓缓流动。\n\e[2;37;0m", "start_other_msg" : "\e[35m" + arg->name() + "席地而坐，五心向天，脸上红光时隐时现。\n\e" + "[2;37;0m", "halt_msg" : "\e[1;37m$N长出一口气，将内息急速退了回去，站了起来。\n\e[2;37;0m", "end_my_msg" : "\e[1;36m你将内息走了个小周天，流回丹田，收功站了起来。\n\e[2;37;0m", "end_other_msg" : "\e[1;31m不一会儿" + arg->name() + "便神采弈弈地站了起来。\n\e" + "[2;37;0m" ]);
}
