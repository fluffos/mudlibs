int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你必须先找一把剑才能练剑法。\n");
    }
    if (arg->query("neili") < 50) {
        return notify_fail("你的内力不够，没有办法练嵩山剑法。\n");
    }
    return 1;
}

int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry";
}

mapping query_action(mixed arg1, mixed arg2) {
