int valid_enable(mixed arg) {
    return arg == "sword" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("练习武当剑法时手中必须有剑。\n");
    }
    if (arg->query("max_neili") < 10) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg->query_skill("force", 1) < 20) {
        return notify_fail("你的内功火候太浅。\n");
    }
    if (arg->query_skill("unarmed", 1) < 20) {
        return notify_fail("你的基本拳脚火候太浅。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
        if (arg >= action[v1]["lvl"]) {
            return action[v1]["skill_name"];
        }
        v1--;
    }
}

mapping query_action(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    v2 = arg1->query_skill("wudang-jian", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "sword") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("qi") < 20) {
        return notify_fail("你的体力不够练武当剑法。\n");
    }
    arg->receive_damage("qi", 10);
    return 1;
}

string query_parry_msg(mixed arg) {
    if (!arg || arg->query("skill_type") != "sword") {
        return (skill_dir("parry") + "parry")->query_parry_msg(arg);
    } else {
        return replace_string(parry_msg[random(sizeof(parry_msg))], "$W", arg->name());
    }
}
