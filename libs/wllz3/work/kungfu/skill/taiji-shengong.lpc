inherit "/inherit/skill/force";
int valid_enable(mixed);
int practice_skill(mixed);
string exert_function_file(mixed);
mapping exercise_msg(mixed);

int valid_enable(mixed arg) {
    return arg == "force";
}

int valid_learn(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = arg->query_skill("taiji-shengong", 1);
    v2 = 1;
    if (v1 <= 100) {
        for (v3 = 1; v3 < v1 / 10; v3++) {
            v2 *= 2;
        }
    }
    if (arg->query("gender") == "无性" && v1 > 49) {
        return notify_fail("你无根无性，阴阳不调，难以领会高深的太极神功。\n");
    }
    if (arg->query("class") == "bonze") {
        return notify_fail("太极神功讲究阴阳调合，有违佛家六根清净之意，" + "/adm/daemons/rankd"->query_respect(arg) + "欲修此功，已是罪过。\n");
    }
    if (arg->query_skill("force", 1) < 10) {
        return notify_fail("你的基本内功火候还不够。\n");
    }
    if (v1 <= 100) {
        if (v1 > 10 && arg->query("shen") < v2 * 100) {
            return notify_fail("你的侠义正气太低了。\n");
        }
    } else if (arg->query("shen") < (v1 - 100) * 100 + 51200) {
        return notify_fail("你的侠义正气太低了。\n");
    }
    return 1;
}

int practice_skill(mixed arg) {
    return notify_fail("太极神功只能用学(learn)的来增加熟练度。\n");
