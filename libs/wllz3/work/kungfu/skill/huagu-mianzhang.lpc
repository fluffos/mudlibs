    mixed v2;
    v2 = arg1->query_skill("huagu-mianzhang", 1);
    v1 = sizeof(action);
    while (v1 > 0) {
        if (v2 > action[v1 - 1]["lvl"]) {
            return action[NewRandom(v1, 20, v2 / 5)];
        }
        v1--;
    }
}

int practice_skill(mixed arg) {
    if (arg->query("qi") < 30) {
        return notify_fail("你的体力太低了。\n");
    }
    if (arg->query("neili") < 8) {
        return notify_fail("你的内力不够练化骨绵掌。\n");
    }
    if (arg->query_skill("jiuyin-baiguzhao", 1) < 60) {
        arg->receive_damage("qi", 15);
    } else {
        arg->receive_damage("qi", 30);
    }
    arg->add("neili", -5);
    return 1;
}

