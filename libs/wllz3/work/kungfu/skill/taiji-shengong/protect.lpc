int exert(mixed arg1, mixed arg2) {
    mixed v1;
    mixed v2;
    if (arg2 != arg1) {
        return notify_fail("护体真气只能用来保护你自己。\n");
    }
    if (arg1->query("neili") < 100) {
        return notify_fail("你的内力不够。\n");
    }
    if (arg1->query_temp("protect")) {
        return notify_fail("你已经在运功中了。\n");
    }
    if (arg1->query_skill("taiji-shengong", 1) < 80) {
        return notify_fail("你的太极神功修为不足，无法施展护体真气。\n");
    }
    v1 = arg1->query_skill("taiji-shengong");
    v2 = arg1->query_skill("force");
    arg1->add("neili", -100);
    message_vision("\e[1;37m$N气沉丹田，深吸了一口气，太极神功的护体真气。$N顿时衣袖鼓风飘起，便如风帆一般！\n\e[2;37;0m", arg1);
    arg1->set_temp("protect", v1);
    arg1->start_call_out((: call_other, "/kungfu/skill/taiji-shengong/protect.lpc", "remove_effect", arg1 :), v2);
    if (arg1->is_fighting()) {
        arg1->start_busy(3);
    }
    return 1;
}

void remove_effect(mixed arg) {
    if (!arg) {
        return;
    }
    if (arg->query_temp("protect")) {
        arg->delete_temp("protect");
        message_vision("$N的太极神功运行完毕，缓缓地将内力收回了丹田。\n", arg);
    }
}

