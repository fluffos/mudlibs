        return notify_fail("你的碧云心法火候不够，无法学碧叶随风舞。\n");
    }
    if (arg->query("max_neili") < 100) {
        return notify_fail("你的内力太弱，无法练碧叶随风舞。\n");
    }
    return 1;
}

