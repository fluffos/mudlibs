}

int practice_skill(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "whip") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练天魔日月鞭法。\n");
    }
    arg->receive_damage("qi", 5);
    return 1;
}

string perform_action_file(mixed arg) {
