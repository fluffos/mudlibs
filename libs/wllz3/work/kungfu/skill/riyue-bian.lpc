int valid_enable(mixed arg) {
    return arg == "whip" || arg == "parry";
}

int valid_learn(mixed arg) {
    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "whip") {
        return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
    }
    if (arg->query("max_neili") < 200) {
        return notify_fail("你的内力不足，没有办法练天魔日月鞭法, 多练些内力再来吧。\n");
    }
    if (arg->query_skill("tianmo-dafa", 1) < 50 && arg->query("family/family_name") != "少林派") {
        return notify_fail("你的天魔大法火候太浅。\n");
    }
    return 1;
}

string query_skill_name(mixed arg) {
    mixed v1;
    v1 = sizeof(action) - 1;
    while (v1 >= 0) {
