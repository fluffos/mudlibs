    mixed v1;
    if (!objectp(v1 = arg->query_temp("weapon")) || v1->query("skill_type") != "blade") {
        return notify_fail("你使用的武器不对。\n");
    }
    if (arg->query("qi") < 50) {
        return notify_fail("你的体力不够练风雷刀法。\n");
    }
    arg->receive_damage("qi", 30);
    return 1;
}
