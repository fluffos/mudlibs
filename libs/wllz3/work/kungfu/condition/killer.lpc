int update_condition(mixed, mixed);

int update_condition(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = environment(arg1);
    if (arg2 < 1) {
        return 0;
    }
    arg1->apply_condition("killer", arg2 - 1);
    if (arg2 == 1) {
        "/adm/daemons/channeld"->do_channel(find_object("/adm/single/master"), "rumor", sprintf("听说官府已经放弃追捕%s了！", arg1->name()));
    } else {
