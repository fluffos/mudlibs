void create()
{
        seteuid(getuid());
        set("channel_id", "频道精灵");
}
varargs int do_channel(object me, string verb, string arg, int emote)
{
        object *ob;
        string *tuned_ch, who;
        int is_player;
        string arg_bk,self_emote,last_arg;
        string msg;
        self_emote=arg;

// 先检测是否使用频道 emote

        if( verb[sizeof(verb)-1] == '*') {
                emote = 1;
                verb = verb[0..<2];
        }

        is_player = playerp(me);
        if(channels[verb] && is_player && ! wizardp(me))
        {
                if( me->ban_say()) return 0;
                if((int)me->query("mud_age") < 900)
                        return notify_fail("你必须于注册十五分钟后才可以使用公聊频道进行聊天。\n"
                                "在这个时间里，请先看["HIG"help"NOR"]系统帮助文件，了解本游戏的运作。\n");

                if(me->query_condition("no_speak"))
                        return notify_fail("你支支吾吾的，半天也说不出句话来。\n");

                if( verb == "master" && !wizardp(me) && !(int)me->query("is_zongshi"))
                        return notify_fail("以你现在的能力还不能使用宗师频道。\n");

                if( verb == "gm" && (!wizardp(me) || wiz_level(me) < 5))
                        return notify_fail("你无权使用这个频道。\n");

                if( verb == "teach" && !me->is_teacher())
                        return notify_fail("你不是游戏导师，不能使用这个频道。\n");
        }

// 确定存在这个频道

        if( !mapp(channels) || undefinedp(channels[verb]) ) return 0;

        if(channels[verb] && !wizardp(me) && userp(me))
        {
                if((int)me->query("chblk/all"))
                        return notify_fail("你的所有频道都被关闭了。\n");

                if((int)me->query("chblk/"+ verb))
                        return notify_fail("你的"+ channels[verb]["name"] +"频道被系统关闭了！\n");

                if(channels[verb]["block"])
                        return notify_fail(channels[verb]["name"]+"频道被系统完全关闭了！\n");

                if(me->is_scheme())
                {
                        if (me->query("jing") < 100)
                                return notify_fail("你现在的精神不济，等一会儿吧。\n");
                        me->add("jing", -50);
                }

                if(channels[verb]["anonymous"])
                {
                        if( me->query("jing") < 50)
                                return notify_fail("你已经没有精力散布谣言了。\n");
                        me->receive_damage("jing",50);
                }
        }

// Check if this channel support emote message.
        if( emote && undefinedp(channels[verb]["msg_emote"])  )
        {
                write("对不起，这个频道不支持 emote 。\n");
                return 1;
        }
// Now we can be sure it's indeed a channel message:
        if (!stringp(arg) || arg == "" || arg == " ") arg = "....";

        if (userp(me) && me->ban_say(1)) return 0;

        if(userp(me))
        {
                if (time() - me->query_temp("last_use_channel") < 4)
                {
                        if (me->query_temp("last_message") == arg)
                                return notify_fail("请不要在短期内使用频道"
                                                   "发布重复的信息。\n");
                        me->set_temp("last_message", arg);
                } else
                {
                        me->set_temp("last_message", arg);
                        me->set_temp("last_use_channel", time());
                }

                switch (channels[verb]["only"])
                {
                        case "wiz":
                                if (wiz_level(me) < 2)
                                        return 0;
                                break;

                        case "faction":
                                if (!me->query("faction/faction_name"))
                                        return notify_fail("你还是先加入一个帮派再说吧。\n");
                                break;

                        case "family":
                                if (!me->query("family/family_name"))
                                        return notify_fail("你还是先加入一个门派再说吧。\n");
                                break;

                        case "friends":
                                if(!sizeof(me->query("brother")))
                                        return notify_fail("你目前还没有任何结拜兄弟。\n");
                                break;
                        case "marry":
                                if(!me->query("marry"))
                                        return notify_fail("你目前尚未婚配，无法使用这个频道。\n");
                                break;

                        case "member":
                                if(!me->is_member())
                                        return notify_fail("你不是游戏会员，不能使用这个频道。\n");
                                break;
                        case "team":
                                if(!pointerp(me->query_team()))
                                        return notify_fail("你必须先加入队伍，才可以使用这个频道。\n");
                                break;

                }

                tuned_ch = me->query("channels");
                if( !pointerp(tuned_ch) )
                        me->set("channels", ({ verb }) );
                else if( member_array(verb, tuned_ch)==-1 )
                        me->set("channels", tuned_ch + ({ verb }) );
        }

        if( emote  && me->is_character())
        {
                string vb, emote_arg, id, mud;

                if( sscanf(arg, "%s %s", vb, emote_arg)!= 2 )
                {
                        vb = arg;
                        emote_arg = "";
                }

                if( channels[verb]["intermud_emote"] && sscanf(emote_arg, "%s@%s", id, mud)==2 ) {
                        REMOTE_Q->send_remote_q(mud, verb, me->query("id"), id, vb);
                        write("网路讯息已送出，请稍候。\n");
                        return 1;
        }

        arg = EMOTE_D->do_emote(me, vb, emote_arg, 3);

        if( verb == "rumor")
                arg = EMOTE_D->do_emote(me, vb, emote_arg, 2,
                                        random(10) >= 8 ? me->name(2):
                                        channels[verb]["anonymous"],
                                        channels[verb]["msg_color"]);
        else
                arg = EMOTE_D->do_emote(me, vb, emote_arg, 1,
                                        0, channels[verb]["msg_color"]);

                if (!arg && emote == 2)
                        arg = (channels[verb]["anonymous"] ?
                                channels[verb]["anonymous"] : me->name()) + vb + "\n";

                if (! arg)
                        return 0;

        }


        // Make the identity of speaker.
        if( channels[verb]["anonymous"] )
        {
                if(random(10) > 8 && playerp(me))
                        who = me->name(2);
                else
                        who = channels[verb]["anonymous"];
        }

        else if(is_player || !stringp(who = me->query("channel_id")))
        {
                if (me->name()!=me->name(1) && emote)
                        do_channel(this_object(),"sys",
                                sprintf("%s扮%s！", me->name(2),me->name()));
                who = me->name(2);
        }

        ob = all_interactive();
        if (stringp(channels[verb]["only"]))
                ob = filter_array(ob, (: filter_listener :),
                                   channels[verb]["only"], me);

        if( emote )
        {
                string localmsg;
                string ecol=channels[verb]["msg_color"];

                if (!stringp(arg)) return 0;
                localmsg = arg;

                if ( channels[verb]["msg_emote"] )
                        localmsg = remove_addresses(arg, 0); // 98-1-22 14:30

                if( channels[verb]["omit_address"] )
                        localmsg = remove_addresses(arg, 1);
                else if( channels[verb]["intermud_emote"] )
                        localmsg = remove_addresses(arg, 0);

                if(!stringp(localmsg)) return 0;
                msg = sprintf(channels[verb]["msg_emote"],
                              sprintf(localmsg, ecol, ecol, ecol));
        } else
                msg = sprintf(channels[verb]["msg_speak"], who, arg);

        if (channels[verb]["anonymous"] && userp(me))
        {
                do_channel(this_object(), "sys",
                           sprintf("%s(%s)正在向 %s 频道发出信息。",
                              me->query("name"), me->query("id"), verb));
        }

        if(verb == "gm")
        {
                shout(msg + BEEP);
                tell_object(me,msg + BEEP);
        }
        else
                if(playerp(me) && wizardp(me))
                        message("channel:" + verb,convert_color(msg) + NOR,ob);
                else
                        message("channel:" + verb,msg,ob);

        if( !undefinedp(channels[verb]["intermud"]) && me->is_character())
        {
                channels[verb]["intermud"]->send_msg(
                channels[verb]["channel"], me->query("id"), me->name(1),arg, emote,
                channels[verb]["filter"] );
        }

        if( arrayp(channels[verb]["extra_listener"]) )
        {
                channels[verb]["extra_listener"] -= ({ 0 });
                if( sizeof(channels[verb]["extra_listener"]) )
                        channels[verb]["extra_listener"]->relay_channel(me, verb, arg);
        }

        return 1;
}

int filter_listener(object ppl, string only, object me)
{
        // Don't bother those in the login limbo.
        if (! environment(ppl)) return 0;

        switch (only)
        {
                case "wiz":
                        return (wiz_level(ppl) >= 2);

                case "family":
                        return (wizardp(ppl) || ppl->query("family/family_name") == me->query("family/family_name"));

                case "faction":
                        return (wizardp(ppl) || ppl->query("faction/faction_name") == me->query("faction/faction_name"));

                case "master":
                        return (wizardp(ppl) || ppl->query("is_master") || me == ppl);

                case "friends":
                        return (wizardp(ppl) || ppl->is_brother(geteuid(me)) || me == ppl);

                case "marry":
                        return (wizardp(ppl) || ppl->query("marry/id") == me->query("id") || me == ppl);

                case "member":
                        return (wizardp(ppl) || ppl->is_member() || me == ppl);

                case "team":
                        return (wizardp(ppl) || member_array(ppl,me->query_team()) == 1 || me == ppl);
        }

        return 1;
}

string remove_addresses(string msg, int all)
{
        int i;
        mixed tmp;
        string pattern;
        if(!stringp(msg)) return msg;
        if( all )
        pattern = "[(][A-Za-z]+@[a-zA-Z]+[0-9]+[.]?[)]";
        else
        pattern = "[(][A-Za-z]+@"+Mud_name()+"[)]";

        tmp = reg_assoc(msg, ({pattern}), ({1}));

        if(!arrayp(tmp)) return msg;
        msg = "";
        for(i=0; i< sizeof(tmp[0]); i++)
        if( tmp[1][i] == 0 ) msg += tmp[0][i];
        return msg;
}
// 设置rumor、chat频道开关
int set_block(string channel, int d)
{
        if(channel)
                channels[channel] += ([ "block": d ]);
        return 1;
}
mapping query_channels()
{
        return channels;
}
void register_relay_channel(string channel)
{
        object ob;
        ob = previous_object();
        if( undefinedp(channels[channel]) || !ob) return;
        if( arrayp(channels[channel]["extra_listener"]))
        {
                if( member_array(ob, channels[channel]["extra_listener"]) >=0 ) 
                        return;
                channels[channel]["extra_listener"] += ({ ob });
        }
        else 
                channels[channel]["extra_listener"] = ({ ob });
}
