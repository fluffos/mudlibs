// channeld.c

#pragma optimize
#pragma save_binary

#include <ansi.h>
#include <net/dns.h>
#include <net/macros.h>

inherit F_DBASE;

string remove_addresses(string, int all);
int filter_listener(object ppl, string only, object me);

