// warfared.c
// 门派攻防系统

#include <ansi.h>
#include <localtime.h>
#include "familylist.h"

string *familylist;

inherit F_DBASE;

void create()
{
	seteuid(getuid());
	set("channel_id","门派挑战精灵");
	set_heart_beat(1);
}
void heart_beat()
{
	mixed lt;
	int ti;

	seteuid(ROOT_UID);
	lt = localtime(time());
	if( lt[LT_HOUR] == 8 && lt[LT_MIN] <= 2)
		start_warfare();
	else
		set_heart_beat(1);
}

int sort_total(string id1,string id2,mapping info)
{
        if(info[id1] > info[id2])
        	return -1;

        if(info[id1] < info[id2])
                return 1;

        return info[id1] - info[id2];
}

void get_topten_family()
{
	mapping info;

	info = FAMILY_D->query_family();
	info = allocate_mapping(10);
	familylist = sort_array(keys(info),(: sort_total :),info);
}
string query_list()
{
	return familylist;
}
//void start_warfare()


mapping query_family(string family)
{
	return family_list[family];
}