void set_skill(mixed arg1, mixed arg2) {
    if (!find_object(skill_dir(arg1) + arg1) && file_size(skill_dir(arg1) + arg1 + ".lpc") < 0) {
        error("F_SKILL: No such skill (" + arg1 + ")\n");
    }
    if (!mapp(skills)) {
        skills = ([ arg1 : arg2 ]);
    } else {
        skills[arg1] = arg2;
    }
}

int delete_skill(mixed arg) {
    if (mapp(skills)) {
        map_delete(skills, arg);
        if (mapp(learned)) {
            map_delete(learned, arg);
            return undefinedp(learned[arg]);
        }
        return undefinedp(skills[arg]);
    }
}

varargs void map_skill(mixed arg1, mixed arg2) {
    if (!arg2 && mapp(skill_map)) {
        map_delete(skill_map, arg1);
        return;
    }
    if (!find_object(skill_dir(arg1) + arg1) && file_size(skill_dir(arg1) + arg1 + ".lpc") < 0) {
        error("F_SKILL: No such skill (" + arg1 + ")\n");
    }
    if (!mapp(skills) || undefinedp(skills[arg2])) {
        return;
    }
    if (!mapp(skill_map)) {
        skill_map = ([ arg1 : arg2 ]);
    } else {
        skill_map[arg1] = arg2;
    }
}

varargs void prepare_skill(mixed arg1, mixed arg2) {
    if (!arg2 && mapp(skill_prepare)) {
        map_delete(skill_prepare, arg1);
        return;
    }
    if (!find_object(skill_dir(arg1) + arg1) && file_size(skill_dir(arg1) + arg1 + ".lpc") < 0) {
        error("F_SKILL: No such skill (" + arg1 + ")\n");
    }
    if (!mapp(skills) || undefinedp(skills[arg2])) {
        return;
    }
    if (!mapp(skill_prepare)) {
        skill_prepare = ([ arg1 : arg2 ]);
    } else {
        skill_prepare[arg1] = arg2;
    }
}

string query_skill_mapped(mixed arg) {
    if (mapp(skill_map) && !undefinedp(skill_map[arg])) {
        return skill_map[arg];
    }
}

string query_skill_prepared(mixed arg) {
    if (mapp(skill_prepare) && !undefinedp(skill_prepare[arg])) {
        return skill_prepare[arg];
    }
}

varargs int query_skill(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg2) {
        v1 = query_temp("apply/" + arg1);
        if (mapp(skills)) {
            v1 += skills[arg1] / 2;
            if (mapp(skill_map)) {
                v1 += skills[skill_map[arg1]];
            }
        }
        return v1;
    }
    if (mapp(skills) && !undefinedp(skills[arg1])) {
        return skills[arg1];
    }
    return 0;
}

