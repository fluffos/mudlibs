int skill_death_penalty() {
    mixed v1;
    mixed v2;
    if (!mapp(skills)) {
        return 0;
    }
    v1 = keys(skills);
    if (!mapp(learned)) {
        for (v2 = 0; v2 < sizeof(v1); v2++) {
            skills[v1[v2]]--;
            if (skills[v1[v2]] < 0) {
                map_delete(skills, v1[v2]);
            }
        }
    } else {
        for (v2 = 0; v2 < sizeof(v1); v2++) {
            if (learned[v1[v2]] > (skills[v1[v2]] + 1) * (skills[v1[v2]] + 1) / 2) {
                map_delete(learned, v1[v2]);
                continue;
            }
            skills[v1[v2]]--;
            if (skills[v1[v2]] < 0) {
                map_delete(skills, v1[v2]);
            }
        }
    }
    if (mapp(skill_map)) {
        skill_map = 0;
    }
    return 1;
}

int skill_expell_penalty() {
    mixed v1;
    mixed v2;
    if (!mapp(skills)) {
        return 1;
    }
    v2 = keys(skills);
    for (v1 = 0; v1 < sizeof(v2); v1++) {
        if (file_size(skill_dir(v2[v1]) + v2[v1] + ".lpc") < 0) {
            delete_skill(v2[v1]);
            continue;
        }
        if ((skill_dir(v2[v1]) + v2[v1])->type() != "martial" && (skill_dir(v2[v1]) + v2[v1])->type() != "special" || (skill_dir(v2[v1]) + v2[v1])->type() == "sponsor") {
            continue;
        }
        if ((skill_dir(v2[v1]) + v2[v1])->valid_enable("parry") || (skill_dir(v2[v1]) + v2[v1])->valid_enable("dodge") || (skill_dir(v2[v1]) + v2[v1])->valid_enable("throwing") || (skill_dir(v2[v1]) + v2[v1])->valid_enable("force") || (skill_dir(v2[v1]) + v2[v1])->valid_enable("spells") || (skill_dir(v2[v1]) + v2[v1])->valid_enable("magic") || (skill_dir(v2[v1]) + v2[v1])->valid_enable("leg") || (skill_dir(v2[v1]) + v2[v1])->valid_enable("hand") || (skill_dir(v2[v1]) + v2[v1])->valid_enable("strike") || (skill_dir(v2[v1]) + v2[v1])->valid_enable("cuff") || (skill_dir(v2[v1]) + v2[v1])->type() == "special") {
            delete_skill(v2[v1]);
            continue;
        }
        if (query_skill(v2[v1], 1) >= 100) {
            set_skill(v2[v1], 100);
        }
    }
    skill_map = 0;
    skill_prepare = 0;
}

int can_improve_skill(mixed arg) {
    mixed v1;
    mixed v2;
    if (!find_object(skill_dir(arg) + arg) && file_size(skill_dir(arg) + arg + ".lpc") < 0) {
        error("F_SKILL: No such skill (" + arg + ")\n");
    }
    if (!this_object()->family_valid_level(arg)) {
        return 0;
    }
    if (!this_object()->valid_learn_force(arg)) {
        return 0;
    }
    switch ((skill_dir(arg) + arg)->type()) {
    case "knowledge":
        return 1;
    case "technic":
        return 1;
    case "poison":
    case "martial":
        v1 = query_skill(arg, 1);
        v2 = this_object()->query("level");
        if (v1 > v2 * 3) {
            write("\e[1;31m由于人物等级不足，技能增长失败。\n\e[2;37;0m");
            return 0;
        }
        return 1;
    default:
        return 1;
    }
}

varargs void improve_skill(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    if (!find_object(skill_dir(arg1) + arg1) && file_size(skill_dir(arg1) + arg1 + ".lpc") < 0) {
        error("F_SKILL: No such skill (" + arg1 + ")\n");
    }
    if (!mapp(skills)) {
        skills = ([ ]);
    }
    if (undefinedp(skills[arg1])) {
        skills[arg1] = 0;
    }
    v1 = this_object()->query("spi");
    if (sizeof(learned) > v1) {
        arg2 /= sizeof(learned) - v1;
    }
    if (!arg2) {
        arg2 = 1;
    }
    if (!mapp(learned)) {
        learned = ([ arg1 : arg2 ]);
    } else {
        learned[arg1] += arg2;
    }
    if ((!arg3 || !userp(this_object())) && learned[arg1] > (skills[arg1] + 1) * (skills[arg1] + 1)) {
        skills[arg1]++;
        learned[arg1] = 0;
        tell_object(this_object(), "\e[1;33m你的「" + to_chinese(arg1) + "」进步了！\n\e" + "[2;37;0m");
        (skill_dir(arg1) + arg1)->skill_improved(this_object());
    }
}

void delete_all_skills() {
    skills = 0;
    learned = 0;
    skill_map = 0;
    this_object()->reset_action();
}
