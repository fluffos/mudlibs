        if (v2["master_id"] == v1->query("id")) {
            arg->add("weiwang", -10000);
        } else {
            arg->add("weiwang", -1000);
        }
        if (arg->query("weiwang") < 0) {
            arg->set("weiwang", 0);
        }
    }
