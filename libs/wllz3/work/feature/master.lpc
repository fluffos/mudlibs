int prevent_learn(mixed arg1, mixed arg2) {
    mixed v1;
    if (!arg1->is_apprentice_of(this_object()) && mapp(v1 = arg1->query("family")) && v1["family_name"] == query("family/family_name") && v1["generation"] > query("family/generation")) {
