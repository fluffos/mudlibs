        return 1;
    }
}

void attempt_detach(mixed arg) {
    if (!arg->is_apprentice_of(this_object())) {
        command("say 这事应该去找你师父去。");
        return;
    }
    command("sigh");
    command("say 好吧！既然你要走，就把你学到的武功留下！");
    arg->skill_expell_penalty();
    arg->unconcious();
    message_vision("$N将手掌粘在$n的背后，喃喃自语，不知道在说些什么。\n", this_object(), arg);
    "/adm/daemons/familyd"->remove_family_info(arg->query("family/family_name"), arg->query("id"));
    "/adm/daemons/familyd"->map_family_score(arg->query("family/family_name"), -arg->query("level"));
    arg->add("detach/" + arg->query("family/family_name"), 1);
    arg->delete("family");
    arg->delete("class");
    arg->delete("byname");
    arg->set("shen", 0);
    arg->set("weiwang", arg->query("weiwang") / 2);
    arg->set("score", arg->query("score") / 2);
    if (arg->query("max_neili") > arg->max_neili()) {
        arg->set("max_neili", arg->max_neili());
    }
    if (arg->query("max_jingli") > arg->max_jingli()) {
        arg->set("max_jingli", arg->max_jingli());
    }
    arg->set("title", "平民百姓");
}

