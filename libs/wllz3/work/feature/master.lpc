        "/adm/daemons/warfared"->remove_target(v1->name(1));
        if (sizeof(v1->query_enemy()) > 3) {
            "/adm/daemons/warfared"->play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;35m听说%s%s%s寡不敌众，终于战死在%s！\n", v3["family_name"], v3["title"], v1->name(1), environment(v1)->short()));
        } else if (sizeof(v1->query_enemy()) > 2) {
            "/adm/daemons/warfared"->play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;35m听说那%s的%s甚是英勇，在%s将%s的%s%s杀死了！\n", v2["family_name"], arg->name(1), environment(v1)->short(), v3["family_name"], v3["title"], v1->name(1)));
        } else {
