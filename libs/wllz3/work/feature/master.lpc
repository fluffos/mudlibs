        }
        if (arg->query("family") && v2["family_name"] != "/adm/daemons/warfared"->attack_family()) {
            arg->add("vendetta/" + v1->query("id"), 1);
            "/adm/daemons/warfared"->play_message("\e[1;31m【门派挑战】\e[2;37;0m", sprintf("\e[1;35m听说%s的%s趁机搅了这趟混水，被%s列入了门派公敌。\n", v2["family_name"], arg->name(1), v3["family_name"]));
        }
    } else if (v1->is_good()) {
