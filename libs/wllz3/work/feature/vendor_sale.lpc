int heal_up() {
    if (close_time < time() + 60) {
        new_owner();
    }
    return ::heal_up() + 1;
}

int do_bid(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    mixed v6;
    mixed v7;
    v4 = this_player();
    notify_fail("指令格式：bid <amount> < gold | silver > \n");
    if (!arg) {
        return 0;
    }
    if (sscanf(arg, "%d %s", v2, v3) != 2) {
        return 0;
    }
    if (v3 == "gold") {
        v2 *= 10000;
    } else if (v3 == "silver") {
        v2 *= 100;
    } else {
        return 0;
    }
    if (v2 < 1) {
        return 0;
    }
    if (!bid) {
        v1 = minimum_bid;
    } else {
        v1 = bid;
        if (v1 > 10000) {
            v1 += v1 / 10;
        } else {
            v1 += 1000;
        }
    }
    v1 = v1 / 100 * 100;
    if (v2 < v1) {
        return notify_fail("你至少需要出" + price_string(v1) + "。\n");
    }
    if (v4->query("balance") < v2) {
        return notify_fail("你的存款里没有这么多钱。\n");
    }
    v6 = environment(this_object());
    if (base_name(v6) != this_object()->query("startroom")) {
        v7 = this_object()->query("name");
    } else {
        v7 = v6->query("short");
    }
    if (bidder) {
        pay_back(bidder, bid);
        if (getuid(v4) != bidder) {
            v5 = find_player(bidder);
            if (v5) {
                tell_object(v5, "你计划购买" + v7 + "失败了！\n");
            }
        }
    }
    if (close_time < time() + 120) {
        close_time += 60;
    }
    v4->add("balance", -v2);
    v4->save();
    bidder = v4->query("id");
    bidder_name = v4->query("name");
    bidder_long = v4->long();
    bid = v2;
    save();
    seteuid(getuid());
    message_vision("$N出价" + price_string(v2) + "收购" + v7 + "！\n", v4);
    return 1;
}

int pay_back(mixed arg1, mixed arg2) {
    mixed v1;
    v1 = find_player(arg1);
    if (v1) {
        v1->add("balance", arg2);
        if (!v1->save()) {
            log_file("shop_log", "Failed to return " + arg2 + " coin to " + arg1 + "\n");
            return 0;
        }
        log_file("shop_log", "pay " + arg2 + " to " + arg1 + "\n");
        return 1;
    } else {
        v1 = "/adm/daemons/updated"->load_player(arg1);
        if (!v1->restore()) {
            log_file("shop_log", "因读取资料档失败而无法将 " + arg2 + " 文钱存入 " + arg1 + " 这个帐号。\n");
            destruct(v1);
            return 0;
        } else {
            "/adm/daemons/chard"->setup_char(v1);
            v1->setup();
            "/adm/daemons/updated"->check_user(v1);
            v1->add("balance", arg2);
            if (!v1->save(1)) {
                log_file("shop_log", "因存档失败而无法将 " + arg2 + " 文钱存入 " + arg1 + " 这个帐号。\n");
                destruct(v1);
                return 0;
            }
            log_file("shop_log", "成功付出 " + arg2 + " 文钱给 " + arg1 + "。\n");
            "/adm/daemons/updated"->global_destruct_player(v1, 1);
            return 1;
        }
    }
}

int do_deposit(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (getuid(v1) != owner_id) {
        return notify_fail("只有店主才能用这个命令。\n");
    }
    notify_fail("指令格式：deposit <amount> < gold | silver >\n");
    if (!arg) {
        return 0;
    }
    if (sscanf(arg, "%d %s", v3, v2) != 2) {
        return 0;
    }
    if (v2 == "gold") {
        v3 *= 10000;
    } else if (v2 == "silver") {
        v3 *= 100;
    } else {
        return 0;
    }
    if (v3 < 10000) {
        return notify_fail("一次至少要一两金子。\n");
    }
    if (v1->query("balance") < v3) {
        return notify_fail("你的存款里没有这么多钱。\n");
    }
    v1->add("balance", -v3);
    v1->save();
    deposit += v3;
    save();
    write("现在共有" + price_string(deposit) + "预付金。\n");
    return 1;
}

int do_setprice(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    v1 = this_player();
    if (getuid(v1) != owner_id) {
        return notify_fail("只有店主才能用这个命令。\n");
    }
    notify_fail("指令格式：set_price <ratio> \n定价范围为：1 到 100倍。\n");
    if (!arg) {
        return 0;
    }
    if (sscanf(arg, "%d", v2) != 1) {
        return 0;
    }
    if (v2 < 1 || v2 > 100) {
        return 0;
    }
    if (v2 < 10 && deposit < 1) {
        return notify_fail("你的定价少于成本，必须先付定金(deposit)。\n");
    }
    price_ratio = v2;
    save();
    if (v2 < 10) {
        message_vision("$N决定将所有物品" + chinese_number(v2) + "折出售。\n", v1);
    } else if (v2 == 10) {
        message_vision("$N决定所有物品按原价出售。\n", v1);
    } else {
        v3 = chinese_number(v2 / 10);
        v2 = v2 - v2 / 10 * 10;
        if (v2) {
            v3 += "点" + chinese_number(v2);
        }
        message_vision("$N决定所有物品按原价的" + v3 + "倍出售。\n", v1);
    }
    return 1;
}

int do_status(mixed arg) {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    v1 = this_player();
    if (!close_time) {
        close_time = time() + 86400;
        save();
    }
    v3 = close_time - time();
    if (v3 < 60) {
        new_owner();
    } else {
        v2 = v3 / 3600;
        if (v2) {
            v4 = chinese_number(v2) + "小时";
        } else {
            v4 = "";
        }
        v2 = (v3 - v2 * 3600) / 60;
        if (v2) {
            v4 += chinese_number(v2) + "分钟";
        }
        write("投标获胜者将于" + v4 + "后成为新店主。\n");
    }
    if (bidder) {
        write("当前最高投标是" + bidder_name + "[" + bidder + "]：" + price_string(bid) + "\n");
    } else {
        write("目前还没有人投标。\n");
    }
    write("昨日盈利：" + price_string(last_profit) + "\n");
    if (wizardp(v1) || getuid(v1) == owner_id) {
        write("\n盈利　　　：" + price_string(profit) + "\n");
        write("剩余预付金：" + price_string(deposit) + "\n");
        write("价格指数　：" + price_ratio + "\n");
    }
    return 1;
}

void new_owner() {
    mixed v1;
    mixed v2;
    mixed v3;
    mixed v4;
    mixed v5;
    close_time = time() + 86400;
    if (owner_id) {
        v1 = profit + deposit;
        if (v1 > 0) {
            pay_back(owner_id, v1);
        }
        v2 = find_player(owner_id);
        v5 = "你的店主(" + name(1) + ")任期结束，结余" + price_string(v1) + "已存入你的户头。\n";
        v5 += "其中盈利" + price_string(profit) + "，剩余预付金 " + price_string(deposit) + "。\n";
        if (v2) {
            tell_object(v2, v5);
        }
        v4 = ([ "from" : name(1) + "(" + query("id") + ")", "title" : name(1) + "：帐目结算", "to" : owner_id, "time" : time(), "status" : "N", "text" : v5 ]);
        seteuid(getuid());
        v3 = clone_object("/clone/misc/mailbox");
        v3->set_owner("vendor_sale");
        v3->send_mail(owner_id, v4, 1);
        destruct(v3);
    }
    if (bidder) {
        owner_id = bidder;
        owner_name = bidder_name;
        owner_long = bidder_long;
        set_new_owner(owner_id, owner_name, owner_long);
    } else {
        owner_id = 0;
        owner_name = 0;
        owner_long = 0;
        set_default_owner();
    }
    last_profit = profit;
    profit = 0;
    deposit = 0;
    bidder = 0;
    bidder_name = 0;
    bid = 0;
    price_ratio = 10;
    save();
}

void set_new_owner(mixed arg1, mixed arg2, mixed arg3) {
    mixed v1;
    mixed v2;
    set_temp("apply/name", ({ arg2 }));
    if (pointerp(v2 = query("shop_id"))) {
        v2 = ({ v2[0] + " " + arg1 }) + v2;
    } else {
        v2 = ({ "boss " + arg1, "boss" });
    }
    set_temp("apply/id", v2);
    set_temp("apply/long", ({ arg3 }));
    if (stringp(v1 = query("shop_title"))) {
        v1 += " ";
    } else if (stringp(v1 = query("title"))) {
        v1 += " ";
    } else {
        v1 = query("name") + " ";
    }
    v1 += arg2 + "[" + capitalize(v2[0]) + "]";
    set_temp("apply/short", ({ v1 }));
}

void set_default_owner() {
    delete_temp("apply/name");
    delete_temp("apply/id");
    delete_temp("apply/short");
    delete_temp("apply/long");
}

void reload(mixed arg) {
    ::reload(arg);
    if (owner_id) {
        set_new_owner(owner_id, owner_name, owner_long);
    }
}

string query_save_file() {
    mixed v1;
    v1 = query_save_name();
    if (!stringp(v1)) {
        return 0;
    }
    return sprintf("/data/npc/boss/%s", v1);
}
