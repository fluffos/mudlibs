void sleep() {
    mixed v1;
    v1 = this_object();
    if (!living(v1)) {
        return;
    }
    if (v1->query_temp("sleeping") == 1) {
        return;
    }
    v1->set_temp("sleeping", 1);
    v1->remove_all_enemy(0);
    v1->clear_written();
    v1->disable_player(" <沉睡中.zzZZ>");
    v1->set("jing", 10);
    v1->set("qi", 10);
    set_temp("block_msg/all", 1);
    call_out("wakeup", random(10) + 10, v1);
    return;
}

varargs void wakeup(mixed arg) {
    if (!arg || !environment(arg)) {
        return;
    }
    if (environment()->is_character()) {
        arg->move(environment(environment()));
    }
    arg->delete_temp("sleeping");
    arg->enable_player();
    arg->write_prompt();
    arg->set("qi", arg->query("eff_qi"));
    arg->set("jing", arg->query("eff_jing"));
    arg->set("jingli", arg->query("max_jingli"));
    if (arg->query("max_brawn") > arg->query("brawn")) {
        arg->add("brawn", arg->query("max_brawn") / 4);
        if (arg->query("brawn") > arg->query("max_brawn")) {
            arg->set("brawn", arg->query("max_brawn"));
        }
    }
    if (arg->query("max_neili") > arg->query("neili")) {
        arg->add("neili", (arg->query("max_neili") - arg->query("neili")) / 5);
    }
    if (arg->query("neili") > arg->query("max_neili") * 2) {
        arg->set("neili", arg->query("max_neili") * 2);
    }
    delete_temp("block_msg/all");
    message_vision("$N一觉醒来，活动了几下筋骨，整个人看起来精神了很多。\n", arg);
    return;
}
