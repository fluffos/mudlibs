dbase (["exits":(["east":"/d/room/road",]),"no_clean_up":0,"item_desc":(["xiaoyuan":"那里好像有：绿茵阁	东方居	风神殿	龙穴          十八禁夜总会。",]),"recordable_room":1,"old_long":"这里是桃源山庄里一片绿草地，草地上三两步可见一片花丛，鲜花盛放，更引来了一些蜜蜂和蝴蝶在花丛中飞舞。这里幽静而典雅，实在是居住的好地方。",])
