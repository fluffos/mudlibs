#include <room.h>

inherit PRIVATE_ROOM;

void create()
{
	set("short","马厩");
	set ("long", @LONG
一所喂养马匹，供马匹休息的马厩，马厩门口有一个水槽，供应着清
水饮马所用。一个中年男子手里拿着钉耙，正在清理马厩里的干草。
LONG
);
	set("item_desc", ([
		"paizi"   : "雀巢 - 孔雀王\n",
	]));

	set("exits", ([
		"east":  __DIR__"room2",
	]));
	set("playerhouse",1);
	setup();
}
void init()
{
	add_action("do_fangmu","yinma");
}
int do_fangmu(string arg)
{
	object me,horse;
	me = this_player();
	
	if(!arg || arg == "")
		return notify_fail("马夫疑道：您想饮哪匹马？\n");
	
	if(!objectp(horse = present(arg,me)))
		return notify_fail("马夫疑道：你要放牧什么？\n");
	
	if(!horse->is_horse() && !horse->player_horse())
		return notify_fail("马夫疑道：您想放牧什么呀？\n");
	
	if(horse->query("horse_prop/life") >= horse->query("horse_prop/max_life"))
		return notify_fail("马夫摇了摇头道：这马儿状态良好，再休息可会发胖的。\n");
	
	if(me->is_busy())
		return notify_fail("马夫说道：您先把手上的事情忙完再说吧。\n");
	
	if(me->is_fighting())
		return notify_fail("马夫说道：哇～大战马厩可会把马儿吓跑的。\n");
	
	me->start_busy(5);
	write("马夫说道：您先歇着，我先替您帮马儿洗洗澡，再喂饱它。\n");
	write(sprintf("马夫说完，从你手中接过缰绳，把%s拉进了马厩，唧哩呱啦的忙活开了。\n",horse->name()));
	write("过了一会，只见马夫从马厩里走了出来，将缰绳交回你的手中。\n");
	horse->set("horse_prop/life",horse->query("horse_prop/max_life"));
	return 1;
}
