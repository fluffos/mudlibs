#include <room.h>
inherit PRIVATE_ROOM;

void create()
{
	set("short","客厅");
	set ("long", @LONG
无心斋主会客的地方[2;37;0m
LONG
);
	set("playerhouse",1);
	set("exits", ([
		"south" : __DIR__"xiaoyuan",
		"west"  : __DIR__"room2",
	]));
	set("key", "key of tanger");
	set("owner", "唐歌");
	create_door("south", "木门", "north", DOOR_CLOSED);
	setup();
}
