#include <room.h>

inherit PRIVATE_ROOM;

void create()
{
	set("short","小院");
	set ("long", @LONG
这里是无心斋主的小院[2;37;0m
LONG
);
	set("item_desc", ([
		"paizi"   : "无心斋 - 唐歌\n",
	]));

	set("key", "key of tanger");
	set("owner", "唐歌");
	set("exits", ([
		"out" : "/d/room/road_e",
		"north" : __DIR__"room1",
	]));
	set("playerhouse",1);
	set("outdoors","playerroom");
	set("valid_startroom", 1);
	create_door("north", "木门", "south", DOOR_CLOSED);
	setup();
}
