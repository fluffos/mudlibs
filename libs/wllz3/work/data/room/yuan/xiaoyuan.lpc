#include <room.h>

inherit PRIVATE_ROOM;

void create()
{
	set("short","大院");
	set ("long", @LONG
这是一所十分典雅的大院，院中种满了各式各样的名贵花草，争奇斗
艳，十分美丽。院子西面有一座假山，怪石嶙峋，十分逼真。假山边上有
一口水池，池水清澈见底，十分清爽。只见正门上方，一块硕大的牌匾上
龙飞凤舞的书着“[1;33m天上人间[2;37;0m”四个大字。[2;37;0m
LONG
);
	set("item_desc", ([
		"paizi"   : "天上人间 - 小璇\n",
	]));

	set("key", "key of yuan");
	set("owner", "小璇");
	set("exits", ([
		"out" : "/d/room/road_5e",
		"north" : __DIR__"room1",
	]));
	set("playerhouse",1);
	set("resource/water", 1);
	set("outdoors","playerroom");
	set("valid_startroom", 1);
	create_door("north", "木门", "south", DOOR_CLOSED);
	setup();
}
