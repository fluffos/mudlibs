inherit PRIVATE_ROOM;

void create()
{
        set("short","练功房");
        set ("long", @LONG
这是位于卧室内间，主人家的练功房。主人每个月都会在这里闭关半
个月。练功房里打扫得十分干净，角落里有一张八仙桌子，桌上放着一些
干粮和茶水，以供主人闭关时使用。
LONG
);
        set("playerhouse",1);
        set("biguan_room",1);
        set("no_fight",1);
        set("no_steal",1);
        set("no_magic",1);
        set("exits", ([
                "south": __DIR__"room4",
        ]));
        set("objects",([
                "/d/dali/npc/obj/huotui": 2,
                "/clone/fruit/xigua": 2,
                "/d/dali/npc/obj/puercha": 2,
                "/clone/fruit/xiangjiao":1,
        ]));
