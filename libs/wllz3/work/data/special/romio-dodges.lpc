//romio-dodges
//force.c

#include <ansi.h>
#include <combat.h>

inherit SKILL;

mapping info = ([
	"master_id":	"romio",	// 技能创造者 id
	"master_name":	"罗蜜欧",	// 技能创造者名字
	"type":		"dodge",	// 技能类型
	"name":		"romio-dodges",	// 技能名称
	"time":		"天朝九百五十年冬二月十六日十时",   // 技能创造游戏时间
	"cnname":	"凌波大步",	// 技能中文名字
]);

mapping *action =({ 
	([ /* sizeof() == 2 */
  "action" : "$n从怀里掏出一瓶＂镪水＂，趁$N不注意，往$N的眼睛泼去！
",
  "dodge" : 24,
]),
	([ /* sizeof() == 2 */
  "action" : "$n飘来飘去，象个鬼魂一样，绕着$N飘了好多圈。
",
  "dodge" : 58,
]),
	([ /* sizeof() == 2 */
  "action" : "$N陷入眼花缭乱之中，大喊：救命呀~变态呀~色狼呀~
",
  "dodge" : 116,
]),
	([ /* sizeof() == 2 */
  "action" : "$N脱下裤子，想要以自己的色相来迷惑$n，可惜$n却不屑一顾。
",
  "dodge" : 174,
]),
	([ /* sizeof() == 2 */
  "action" : "$n丢下一叠美金，哪知$N见钱眼开，命也不要，蹲下来捡起钱来。
",
  "dodge" : 232,
]),
	([ /* sizeof() == 2 */
  "action" : "$n突然大喊：快看呀，美女呀，$N连忙四处张望，被$n欺骗了。
",
  "dodge" : 291,
]),
	([ /* sizeof() == 2 */
  "action" : "$n从怀里掏出一瓶＂镪水＂，趁$N不注意，往$N的眼睛泼去！
",
  "dodge" : 349,
]),
	([ /* sizeof() == 2 */
  "action" : "$N和$n两个人僵持了很久，显然$N拿$n一点办法都没有！
",
  "dodge" : 407,
]),
	([ /* sizeof() == 2 */
  "action" : "$n如闪电一般的绕着$N快速的转了数圈，$N被转得头昏眼花。
",
  "dodge" : 465,
]),
});

int valid_enable(string usage)
{
	return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) { return 1; }

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

string query_dodge_msg(string limb)
{
	object me = this_player();
	mapping action;

	action = query_action(me,0);

	return action["action"];
}

int practice_skill(object me)
{

	if((int)me->query("dodge",1) < 100)
		return notify_fail("你的轻功基础太差，无法练习这种高深的身法。\n");

	if( (int)me->query("qi") < 40 )
		return notify_fail("你的体力太差了，无法练习"+ info["cnname"] +"。\n");

	me->receive_damage("qi", 30);
	return 1;
}
// 学习难度
int learn_hard() { return 3;}
// 技能类型
string type() { return "sponsor"; }
// 信息查询
mapping query_info() { return info;}
