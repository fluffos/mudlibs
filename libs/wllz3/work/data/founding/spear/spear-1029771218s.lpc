// spear.c 该武器由蝴蝶君(Robert)于Mon Aug 19 23:33时创造

#include <ansi.h>
#include <weapon.h>

inherit SPEAR;

void create()
{
	
	set_name("[1;36m六合[2;37;0m[1;37m钩镰枪[2;37;0m",({ "goulian qiang","spear",}));
	set_weight(16000);
	if(clonep())
		set_default_object(__FILE__);
	else
	{
		set("unit","把");
		set("value",this_object()->is_shroff() ? 1000:0);
		set("material","iron");
		set("attributive","土");
		set("weapon_prop/personality",8);
		set("wield_msg", "$N掣出一杆$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n反别身后。\n");
	}
	init_spear(182);
	setup();
}
int is_founding() { return 1;}
void remove()
{
	string file;
	file = base_name(this_object()) +".lpc";
	if(!this_object()->is_shroff())
		ITEM_D->raze_item(this_object(),file);

	::remove();
}

int is_shroff() { return 1;}
