// blade.c 该武器由明搜(Soushen)于Sat Mar  1 00:05时创造

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
	
	set_name("[1;34m寻魂[2;37;0m[1;37m精钢刀[2;37;0m",({ "jinggang dao","blade",}));
	set_weight(13000);
	if(clonep())
		set_default_object(__FILE__);
	else
	{
		set("unit","把");
		set("value",this_object()->is_shroff() ? 2000:0);
		set("material","nitre");
		set("attributive","水");
		set("weapon_prop/constitution",9);
		set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");
	}
	init_blade(4);
	setup();
}
int is_founding() { return 1;}
void remove()
{
	string file;
	file = base_name(this_object()) +".lpc";
	if(!this_object()->is_shroff())
		ITEM_D->raze_item(this_object(),file);

	::remove();
}

int is_shroff() { return 1;}
