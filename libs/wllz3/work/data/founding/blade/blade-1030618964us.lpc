// blade.c 该武器由八爪鱼(Zoys)于Thu Aug 29 19:02时创造

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
	
        set_name("[1;33m双龙[2;37;0m[1;34m宝刀[2;37;0m",({ "bao dao","blade",}));
        set_weight(18000);
        if(clonep())
                set_default_object(__FILE__);
        else
        {
                set("unit","把");
                set("value",this_object()->is_shroff() ? 1000:0);
                set("material","iron");
                set("attributive","水");
                set("weapon_prop/intelligence",4);
                set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");
        }
        init_blade(304);
        setup();
}
int is_founding() { return 1;}
void remove()
{
        string file;
        file = base_name(this_object()) +".lpc";
        if(!this_object()->is_shroff())
                ITEM_D->raze_item(this_object(),file);

        ::remove();
}

int is_shroff() { return 1;}
