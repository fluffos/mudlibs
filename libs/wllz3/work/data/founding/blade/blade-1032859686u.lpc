// blade.c 该武器由蝴蝶君(Robert)于Tue Sep 24 17:28时创造

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
	
        set_name("[1;33m龙纹[2;37;0m[1;33m金刀[2;37;0m",({ "jin dao","blade",}));
        set_weight(17000);
        if(clonep())
                set_default_object(__FILE__);
        else
        {
                set("unit","把");
                set("value",this_object()->is_shroff() ? 2000:0);
                set("material","copper");
                set("attributive","木");
                set("weapon_prop/dexerity",7);
                set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");
        }
        init_blade(185);
        setup();
}
int is_founding() { return 1;}
void remove(mixed euid)
{
        string file;
        file = base_name(this_object()) +".lpc";
        if(!this_object()->is_shroff())
                ITEM_D->raze_item(this_object(),file);

        ::remove(euid);
}
