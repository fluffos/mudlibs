// blade.c 该武器由明搜(Soushen)于Wed Feb 26 21:41时创造

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
	
	set_name("[1;34m追魂[2;37;0m[1;37m大刀[2;37;0m",({ "da dao","blade",}));
	set_weight(12000);
	if(clonep())
		set_default_object(__FILE__);
	else
	{
		set("unit","把");
		set("value",this_object()->is_shroff() ? 2000:0);
		set("material","nitre");
		set("attributive","火");
		set("weapon_prop/constitution",0);
		set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插入腰间的刀鞘。\n");
	}
	init_blade(39);
	setup();
}
int is_founding() { return 1;}
void remove(mixed euid)
{
	string file;
	file = base_name(this_object()) +".lpc";
	if(!this_object()->is_shroff())
		ITEM_D->raze_item(this_object(),file);

	::remove(euid);
}

int is_shroff() { return 1;}
