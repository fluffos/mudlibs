// sword.c 该武器由古木(Gumu)于Sun Jul 20 09:11时创造

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
	
	set_name("[1;32m夺命[2;37;0m[1;36m长剑[2;37;0m",({ "chang jian","sword",}));
	set_weight(13000);
	if(clonep())
		set_default_object(__FILE__);
	else
	{
		set("unit","把");
		set("value",this_object()->is_shroff() ? 2000:0);
		set("material","copper");
		set("attributive","金");
		set("weapon_prop/spirituality",9);
		set("wield_msg","$N「唰」的一声拔出一把$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n放了下来。\n");
	}
	init_sword(31);
	setup();
}
int is_founding() { return 1;}
void remove()
{
	string file;
	file = base_name(this_object()) +".lpc";
	if(!this_object()->is_shroff())
		ITEM_D->raze_item(this_object(),file);

	::remove();
}

int is_shroff() { return 1;}
