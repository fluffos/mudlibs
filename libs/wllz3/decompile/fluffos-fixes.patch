+  if (file_size(file) < 0)
+    return notify_fail("没有这个档案。\n");
+  if (!read_file(file)) {
+    me->set("cwf", file);
+    return tail_big(file, line);
+  }
+  me->set("cwf", file);
+  write(implode(explode(read_file(file), "\n")[<line..], "\n"));
+  write("\n");
+  return 1;
+}
+
+// Too big for read_file(): show the last lines of the final 8K, starting after
+// a newline so the cut never splits a UTF-8 character. (MudOS had a tail() efun.)
+int tail_big(string file, int line) {
+  int size = file_size(file), start = size > 8192 ? size - 8192 : 0;
+  string text, *lines;
+
+  if (catch(text = read_bytes(file, start, size - start)) || !stringp(text))
+    return notify_fail("无法读取这个档案。\n");
+  if (start > 0 && strsrch(text, "\n") >= 0)
+    text = text[strsrch(text, "\n") + 1..];
+  lines = explode(text, "\n");
+  if (sizeof(lines) > line) lines = lines[<line..];
+  write(implode(lines, "\n") + "\n");
+  return 1;
+}
+
+int help(object me) {
+  write("指令格式：tail <文件名> | <行数>。\n");
+  return 1;
+}
