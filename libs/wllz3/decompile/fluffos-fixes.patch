+int tail_big(string, int);
+int main(object me, string arg) {
+  string file, fileName;
+  int line;
+
+  if (!arg || arg == "")
+    return help(me);
+
+  if (sscanf(arg, "%s %d", fileName, line) != 2) {
+    fileName = arg;
+    line = 20;
+  }
+  if (fileName == "here") file = base_name(environment(me)) + ".lpc";
+  else
+    file = resolve_path(me->query("cwd"), fileName);
