#include <ansi.h>
inherit ROOM;

string *specialsk=({
        "constitution","ironskin","lucky","energy","agile","intellect","defense",
        "hatred","health","might","power","spirituality","greedy",

                });

int do_mobai(string arg);
void create ()
{
        set ("short", "黄金圣殿");
        set ("long",
             @LONG
     p                  p         p
    /\     p      p    /\        /\
   /__\   /\_____/\   /__\      /__\
   |. |_=_|. . . .|_=_=_=_=_=_=_|. |
   |. |. .|  ___  |. . . . . . .|. |    雅典娜与此执法。
   |. |   | |   | |             |. |
 __|__|___|_|___|_|_____________|__|__
/          /   /                      \


LONG);

   set("no_steal", 1);

        set("exits", ([
        "down"  :       __DIR__"topalace3",        
        ]));

        set("objects", 
        ([ //sizeof() == 1
__DIR__"npc/ydn" : 1,    
        ]));
        setup();
}
void init()
{
	
// add_action("do_mobai","mobai"); 
	
}
int do_mobai(string arg)
{ 	
	string msg;
	object baoshi;
	object ydn;
	object who = this_player();
	if(arg != "yadian na"&&arg!="na") return 0;
	if(!objectp(ydn = present("yadian na",environment(who)))) return 0;
	if(!userp(who)) return 0;
	if(who->query("2004eurocup_gift")) return 0;
	
	message_vision(CYN"$N趴在地下，对着雅典娜膜拜个不停，必恭必敬的说道：黑，真黑，比黑夜里飞的乌鸦还黑。\n"NOR,who);
	message_vision(CYN"雅典娜拍着$N的肩膀，笑得嘴都合不起来了，马屁拍的真不错，哦也阿衡，"NOR+HIY"We Are The Champion~~~\n"NOR,who);
	tell_object(who,HIR"你骗到了10万潜能，一颗黄宝石和一级特殊技能。\n"NOR);
	who->add("potential",100000);
	
	   for(int i=0;i<10;i++)
	   {
		    msg=specialsk[random(sizeof(specialsk))];
		    if(who->query("special_skill/"+msg)) continue;
		    
		   
		    who->set("special_skill/"+msg,1);
	   	   break;
   	  }
	baoshi = new("/d/baoshi/obj/wx_y");
	baoshi->move(who);
	who->set("2004eurocup_gift",1);
	return 1;
	
	
}
