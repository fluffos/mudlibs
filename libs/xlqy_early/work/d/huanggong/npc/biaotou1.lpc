#include "ansi.h"

inherit NPC; 
int reset_status();
void leave();
void set_skills(int level,int value,object who);
 string *lname = ({
"赵","钱","孙","李","周","吴","郑","王",});
void create()
{
    object ob;
    set_name(lname[random(8)]+"镖头", ({ "biao tou" }) );
    set("gender", "男性" );
    set("age", 30);
    set("combat_exp", 100000);
    set("attitude", "friendly");
    set("chat_chance", 5);
    set("arrive",0);
    set("chat_chance_combat",50);
    set("chat_msg_combat", ({
        name()+"大喊道：“不好了，有人劫镖!”\n",
              }) );
        
    setup();
    carry_object(__DIR__"obj/cloth")->wear();
    switch(random(9))
    	{
    		case 0:
    		 carry_object("/d/obj/weapon/blade/blade")->wield();
    		 break;
    		 case 1:
    		 carry_object("/d/obj/weapon/fork/gangcha")->wield();
    		 break;
    		 case 2:
    		 carry_object("/d/obj/weapon/hammer/hammer")->wield();
    		 break;
    		 case 3:
    		 carry_object("/d/obj/weapon/sword/changjian")->wield();
    		 break;
    		 case 4:
    		 carry_object("/d/obj/weapon/spear/changqiang")->wield();
    		 break;
    		 case 5:
    		 carry_object("/d/obj/weapon/staff/tiezhang")->wield();
    		 break;
    		 case 6:
    		 carry_object("/d/obj/weapon/stick/bintiegun")->wield();
    		 break;
    		 case 7:
    		 carry_object("/d/obj/weapon/axe/bigaxe")->wield();
    		 break;
}  
}  
void init()
{    
	
	
}
void invocation(object who,int level)
{
	int value=who->query("hubiao/value");
        
	remove_call_out("leave");
	call_out("leave",600);	
        set("owner", who);
       
        set_skills(level,value,who);
        reset_status();
        return;
}
int reset_status()
{
        object owner,env;
        int n;
         object *inv,robber;
        owner= query("owner");
	
        if(!query("owner"))
        {
                message_vision("$N撒腿就跑。\n", this_object());
                destruct( this_object());
                return 1;
        }
inv=all_inventory(environment());
      
       if(!present(owner,environment(this_object())))
     
  	{  
  		 robber=present("robber",environment(this_object()));
  		if(robber)
  		{
  		 
		return 1;
		}
	}
		
	if(query("arrive"))
	 return 1;	
        if(!present(owner->query("id"), environment(this_object())))
            {
             env=environment(owner);
             this_object()->move(env);
            
            }
            
        call_out("reset_status", 3);
        return 1;
}
int heal_up()
{
        object ob;
           if(query("eff_kee")*100<query("max_kee")*80)
        {
        	command("surrender");
        	command("eat yao");
        	command("exert recover");
        	if(ob=(present("robber",environment())))
        	   kill_ob(ob);
        }
        if(query("eff_sen")*100<query("max_sen")*80)
        {
        	command("surrender");
        	command("eat dan");
        	command("exert refresh");
        	if(ob=(present("robber",environment())))
        	   kill_ob(ob);
        }	
        if(query("kee")*100<query("max_kee")*70)
        {
        	command("surrender");
        	command("exert recover");
        	if(ob=(present("robber",environment())))
        	   kill_ob(ob);
        }
         if(query("sen")*100<query("max_sen")*70)
        {
        	command("surrender");
        	command("exert refresh");
        	if(ob=(present("robber",environment())))
        	   kill_ob(ob);
        }
     
        return ::heal_up() + 1;
}
void set_skills(int level, int value,object who)
{
	int *levels, max_level;
	int dx,exp;
	int kee,sen;
	 mapping skill=who->query_skills();
         int i=sizeof(skill);
         if(i>0) 
         {
		levels=values(skill);
		max_level=levels[0];
		while(i--)
		 { // find out victim's maximum level
		    if(levels[i]>max_level)
			max_level=levels[i];
		}
	        max_level=(max_level*0.8);
	        max_level=(int)max_level;

	    } else max_level=1;
	exp=who->query("combat_exp")*0.7+random(who->query("combat_exp")*0.2);
	dx=who->query("daoxing")*0.7;
	kee=1300*(level+1)+random(250*value)+300;
	sen=1000*(level+1)+random(200*value)+200;
	set("kee",kee);
        set("max_kee",kee);
         set("eff_kee",kee);
        set("sen",sen);
        set("max_sen",sen);
        set("eff_sen",sen);
        
        set("combat_exp",exp);
        set("daoxing",dx);
	set_skill("blade", 10+max_level+5*value+random(10*level));
	set_skill("hammer", 10+max_level+5*value+random(10*level));
	set_skill("sword", 10+max_level+5*value+random(10*level));
	set_skill("fork", 10+max_level+5*value+random(10*level));
	set_skill("dodge", 15+max_level+7*value+random(12*level));
	set_skill("spear", 10+max_level+5*value+random(10*level));
	set_skill("stick", 10+max_level+5*value+random(10*level));
	set_skill("parry", 10+max_level+5*value+random(10*level));
	set_skill("unarmed", 15+max_level+7*value+random(12*level));
	set_skill("staff", 10+max_level+5*value+random(10*level));
	set_skill("axe", 10+max_level+5*value+random(10*level));
	set_skill("force",5+max_level+3*value+random(5*level));
	
	set_skill("shaolin-force",5+max_level+3*value+random(5*level));
	map_skill("force","shaolin-force");
	
	set("force", 120+1000*level+200*value);
	set("max_force", 120+500*level+200*value);
	set("force_factor", query_skill("force")/2);
	
	 carry_object("/d/obj/drug/jinchuang")->set_amount(level+2*random(value));
         carry_object("/d/obj/drug/hunyuandan")->set_amount(level+2*random(value));     
} 
void die()
{
	message_vision("$N一溜烟跑得没影了。\n",this_object());
	destruct(this_object());
	
}
void unconcious()
{
	message_vision("$N一溜烟跑得没影了。\n",this_object());
	destruct(this_object());
	
}
void leave()
{
        object me=this_object();
        if(me->is_fighting() || me->is_busy())
        return;
          if(this_object())
           {
	        if(environment())
		{
	          message("vision",HIB + name() + 
	                  "不知所踪。\n" NOR,environment());
		}
        destruct(this_object());
        return;
      }
        remove_call_out("leave");
        call_out("leave",60);
        leave();
}
