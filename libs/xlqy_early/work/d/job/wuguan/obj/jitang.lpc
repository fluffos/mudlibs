#include <ansi.h>

inherit ITEM;

int do_drink(string arg);
void create()
{
        set_name(CYN "鸡汤"NOR, ({ "ji tang","tang"}));
	set_weight(5000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "碗");
                set("long", 
"一碗满满的鸡汤，香气四逸，你真想偷偷的喝上几口。\n");
		set("value", 1000);
	}

        set("remaining", 4);
        set("drink_supply", 50);
    
	
	setup();
}

void init()
{
	add_action("do_drink", "drink");
}


int do_drink(string arg)
{
	
    if( !this_object()->id(arg) ) return 0;
    if( this_player()->is_busy() )
        return notify_fail("你上一个动作还没有完成。\n");
    if(   (int)this_player()->query("water")
       >= (int)this_player()->max_water_capacity() )
     return notify_fail("你已经喝太多了，再也灌不下一滴水了。\n");

    set("value", 0);
    this_player()->add("water", (int)query("drink_supply"));
    
    if( this_player()->is_fighting() ) this_player()->start_busy(2);

    add("remaining", -1);
	if ( query("remaining") )
	{
   		 message_vision("$N偷偷端起大碗，咕咚咕咚的喝了几口鸡汤。\n", this_player());
	} else 
	{ 
   		 message_vision("$N意犹未尽，偷偷端起大碗，把剩下的鸡汤喝的干干净净。\n", this_player());
		
		destruct(this_object());
	}

	return 1;
}


