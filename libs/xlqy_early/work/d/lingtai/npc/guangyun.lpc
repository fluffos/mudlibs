inherit NPC_FANGCUN;

void create() {
  ::create();

  set("long", "方寸山三星洞第三代弟子中的杰出人物．\n");

  set("age", 43);

  set("per", 30);
  set("int", 30);
  set("str", 25);

  set("combat_exp", 250000);
  set("daoxing", 400000);

  create_family("方寸山三星洞", 3, "首徒");

  ::generate_me(0, 80, 80, 3, 0, 50, "广筠子", ({ "guang yunzi", "guang" }), 0);

  carry_object("/d/lingtai/obj/daoguan")->wear();
  carry_object("/d/lingtai/obj/cloth")->wear();
  carry_object("/d/lingtai/obj/bang")->wield();
}
