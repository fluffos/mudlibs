inherit NPC_FANGCUN;

void create()
{
    ::create();

    set("long", "方寸山三星洞第四代弟子中的杰出人物。在场边转来转去发些牢骚。\n");

    set("age", 33);

    set("per", 30);
    set("int", 30);
	set("str", 25);

    set("combat_exp", 80000);
    set("daoxing", 100000);

    create_family("方寸山三星洞", 4, "弟子");

    ::generate_me(0, 50, 50, 3, 0, 50, "云霄", ({"yun xiao", "yun"}), 0);
	set("title", "道长");

    carry_object("/d/lingtai/obj/daoguanq")->wear();
    carry_object("/d/lingtai/obj/cloth")->wear();
    carry_object("/d/lingtai/obj/bang")->wield();
}

void init()
{
    object ob;

    ::init();

    set("chat_chance", 10);
    set("chat_msg", ({
        "云霄打了个喷嚏．\n",
        "云霄上上下下打量了你几眼。\n",
        "云霄哼了一声。\n"
    }) );
}

