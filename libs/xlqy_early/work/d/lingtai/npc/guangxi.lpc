inherit NPC_FANGCUN;

void create()
{
    ::create();

    set("long", "一个看起来慈眉善目的道士，正拿着一本经书读着．\n");

    set("age", 53);

    set("per", 30);
    set("int", 30);
	set("str", 25);

    set("combat_exp", 180000);
    set("daoxing", 250000);

    create_family("方寸山三星洞", 3, "弟子");

    ::generate_me(0, 80, 80, 3, 0, 50, "广羲子", ({"guang xizi", "guang"}), 0);

    carry_object("/d/lingtai/obj/cloth")->wear();
    carry_object("/d/lingtai/obj/daoguan")->wear();
}

