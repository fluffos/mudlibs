inherit NPC_FANGCUN;

void create()
{
    ::create();

    set("long", "方寸山三星洞第四代弟子中的杰出人物．\n");

    set("age", 33);

    set("per", 30);
    set("int", 30);
	set("str", 25);

    set("combat_exp", 70000);
    set("daoxing", 100000);

    create_family("方寸山三星洞", 4, "弟子");

    ::generate_me(0, 40, 40, 3, 0, 50, "云静", ({"yun jing", "yun"}), 0);
	set("title", "道长");

    carry_object("/d/lingtai/obj/daoguanq")->wear();
    carry_object("/d/lingtai/obj/cloth")->wear();
    carry_object("/d/lingtai/obj/bang")->wield();
}

