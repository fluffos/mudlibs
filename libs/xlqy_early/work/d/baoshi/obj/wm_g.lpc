#include <ansi.h>
#include "build_gold.h"
inherit ITEM;

void create() {
  set_name(BLINK "" HIG "完美的绿宝石" NOR, ({ "Perfected baoshi", "baoshi", "shi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_sell", 1);
    set("unit", "颗");
    set("color", "g");  //HIr
    //          set("no_get",1);
    set("no_put", 1);
    set("no_sell", 1);
    set("is_baoshi", 1);
    set("long", HIG "一块绿油油的石头，看起来平凡无奇，偶尔霞光溢彩，也是一闪即逝。\n" NOR);
  }
  setup();
}

void init() {
  if (environment(this_object()) == this_player()) {
    add_action("do_enchase", "enchase");
    add_action("do_enchase", "inset");
  }
}

int do_enchase(string arg) {
  object in_obj;
  string item;
  string types;
  int rd, inset_num;
  object me = this_player();
  object ob = this_object();

  if (!arg) return notify_fail("你要干什么？\n");
  if (sscanf(arg, "%s", item) != 1) return notify_fail("你要把宝石镶嵌到什么上？\n");
  if (!objectp(in_obj = present(item, me))) return notify_fail("你身上没有这样东西。\n");
  if (in_obj->query("equipped"))
    return notify_fail("你必须放下这样东西才能镶嵌宝石。\n");
  if (in_obj->query("no_zm") || in_obj->query_unique())
    return notify_fail("这件装备不能镶嵌宝石。\n");

  if (!mapp(in_obj->query("armor_prop")) && !mapp(in_obj->query("weapon_prop")))
    return notify_fail("只能镶嵌在防具和武器上!\n");
  if (!in_obj->is_diablo_ob())
    return notify_fail("宝石蕴涵的魔力太大，这件物品承受不了!\n");
  if (!in_obj->query("diablo_prop/can_inset"))
    return notify_fail("这件物品属性和宝石相冲，不能镶嵌!\n");
  if (in_obj->query("diablo_ob_autoloaded"))
    return notify_fail("暂不提供自动加载物品的镶嵌!\n");
  if (((int)me->query("potential") - (int)me->query("learned_points")) < 1999)
    return notify_fail("你的潜能不足，无法镶嵌!\n");
  if (me->query("max_mana") < 4840)
    return notify_fail("你的法力不足，无法激发出宝石蕴涵的能量!\n");
  if (me->query("max_force") < 4840)
    return notify_fail("你的内力不足，无法激发出宝石蕴涵的能量!\n");
  inset_num = in_obj->query("inset_num");  // 嵌了几个了
  if (!inset_num) inset_num = 1;
  else inset_num = inset_num + 1;

  if (inset_num > in_obj->query("diablo_prop/can_inset"))
    return notify_fail(in_obj->query("name") + "上已经镶嵌了太多东西了!\n");

  me->add("maximum_force", -24);
  me->add("max_force", -24);
  me->add("maximum_mana", -24);
  me->add("max_mana", -24);
  if (!in_obj->query("weapon_prop/damage"))   //防具
  {

    message_vision(CYN "$N手捧$n，" NOR + CYN "激发出内力和法力交汇注入其中!\n" NOR, me, ob);

    tell_room(
      environment(me),
      HIG "只见" + ob->name() + HIG "发出一团妖艳的绿光,环绕在" + in_obj->query("name") + HIG "的周围 \n" NOR
    );
    types = in_obj->query("armor_type");


    if (types == "amulet" || types == "neck" || types == "finger") {
      in_obj->add("diablo_prop/add_force", 36 + random(12));
      in_obj->add("diablo_prop/add_max_force", 720 + random(120));
      in_obj->add("diablo_prop/regenerate_force", 36 + random(24));
    } else {
      in_obj->add("diablo_prop/sub_mu", 36 + random(12));
      in_obj->add("diablo_prop/sub_max_mu", 720 + random(120));
      in_obj->add("diablo_prop/force_vs_damage", 480 + random(120));
    }
    in_obj->add("diablo_prop/armor", 12 + random(12));
    message_vision(CYN "" + in_obj->query("name") + CYN "散出耀眼夺目的绿光！\n" NOR, me);

    me->add("potential", -1999);
    in_obj->set_weight(in_obj->query_weight() + 1);

    in_obj->set("inset_num", inset_num);
    in_obj->set("no_sell", 1);

    in_obj->save();

    destruct(ob);
    return 1;
  } else {
    //武器
    message_vision(CYN "$N手捧$n，" NOR + CYN "激发出内力和法力交汇注入其中!\n" NOR, me, ob);
    tell_room(
      environment(me),
      HIG "只见" + ob->name() + HIG "发出一团妖艳的绿光,环绕在" + in_obj->query("name") + HIG "的周围 \n" NOR
    );


    in_obj->add("diablo_prop/add_mu", 36 + random(12));
    in_obj->add("diablo_prop/add_max_mu", 480 + random(480));
    in_obj->add("diablo_prop/damage", 12 + random(12));
    in_obj->add("diablo_prop/combat_blood_force", 720 + random(240));
    message_vision(CYN "" + in_obj->query("name") + CYN "散出耀眼夺目的绿光！\n" NOR, me);

    me->add("potential", -1999);
    in_obj->set_weight(in_obj->query_weight() + 1);
    in_obj->set("no_sell", 1);
    in_obj->set("inset_num", inset_num);

    in_obj->save();

    destruct(ob);
    return 1;
  }



  return notify_fail("你镶嵌宝石失败了!\n");
}
