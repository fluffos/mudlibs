#include <ansi.h>
#include "build_gold.h"
inherit ITEM;

void create() {
  set_name(BLINK "" HIY "无瑕的黄宝石" NOR, ({ "Flawless baoshi", "baoshi", "shi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_sell", 1);
    set("unit", "颗");
    set("color", "y");  //HIr
    //       set("no_get",1);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_give", 1);
    set("is_baoshi", 1);
    set("long", HIY "一块发着闪闪金光的宝石,晶莹剔透，纯净神秘，传说是女娲用来补天的原料之一。\n" NOR);
  }
  setup();
}

void init() {
  if (environment(this_object()) == this_player()) {
    add_action("do_enchase", "enchase");
    add_action("do_enchase", "inset");
  }
}

int do_enchase(string arg) {
  object in_obj;
  string item;
  string types;
  int rd, inset_num;
  object me = this_player();
  object ob = this_object();

  if (!arg) return notify_fail("你要干什么？\n");
  if (sscanf(arg, "%s", item) != 1) return notify_fail("你要把宝石镶嵌到什么上？\n");
  if (!objectp(in_obj = present(item, me))) return notify_fail("你身上没有这样东西。\n");
  if (in_obj->query("equipped"))
    return notify_fail("你必须放下这样东西才能镶嵌宝石。\n");
  if (in_obj->query("no_zm") || in_obj->query_unique())
    return notify_fail("这件装备不能镶嵌宝石。\n");

  if (!mapp(in_obj->query("armor_prop")) && !mapp(in_obj->query("weapon_prop")))
    return notify_fail("只能镶嵌在防具和武器上!\n");

  if (in_obj->is_diablo_ob() && !in_obj->query("diablo_prop/can_inset"))
    return notify_fail("这件物品属性和宝石相冲，不能镶嵌!\n");
  if (in_obj->is_diablo_ob() && in_obj->query("diablo_ob_autoloaded"))
    return notify_fail("暂不提供自动加载物品的镶嵌!\n");

  if (((int)me->query("potential") - (int)me->query("learned_points")) < 1200)
    return notify_fail("你的潜能不足，无法镶嵌!\n");
  if (me->query("max_mana") < 3240)
    return notify_fail("你的法力不足，无法激发出宝石蕴涵的能量!\n");
  if (me->query("max_force") < 3240)
    return notify_fail("你的内力不足，无法激发出宝石蕴涵的能量!\n");
  inset_num = in_obj->query("inset_num");  // 嵌了几个了
  if (!inset_num) inset_num = 1;
  else inset_num = inset_num + 1;
  if (in_obj->is_diablo_ob()) {
    if (inset_num > in_obj->query("diablo_prop/can_inset"))
      return notify_fail(in_obj->query("name") + "上已经镶嵌了太多东西了!\n");
  } else if (inset_num > 5) return notify_fail(in_obj->query("name") + "上已经镶嵌了太多的东西了!\n");
  me->add("maximum_force", -12);
  me->add("max_force", -12);
  me->add("maximum_mana", -12);
  me->add("max_mana", -12);
  if (!in_obj->query("weapon_prop/damage"))   //防具
  {

    message_vision(CYN "$N手捧$n，" NOR + CYN "激发出内力和法力交汇注入其中!\n" NOR, me, ob);

    tell_room(
      environment(me),
      HIY "只见" + ob->name() + HIY "蓬的一声炸了开来,一团金粉扬扬撒撒的落在" + in_obj->query("name") + HIY "的周围 \n" NOR
    );
    types = in_obj->query("armor_type");


    if (in_obj->is_diablo_ob()) {
      if (types == "amulet" || types == "neck" || types == "finger") {
        in_obj->add("diablo_prop/magic_find", 240 + random(120));
        in_obj->add("diablo_prop/sub_max_spells_all", 540 + random(540));
        in_obj->add("diablo_prop/add_max_spells_all", 660 + random(660));
        in_obj->add("diablo_prop/sub_spells_all", 6 + random(4));
        in_obj->add("diablo_prop/add_spells_all", 9 + random(6));
      } else {
        in_obj->add("diablo_prop/defense", 4 + random(4));
        in_obj->add("diablo_prop/sub_phy", 5 + random(5));

        in_obj->add("diablo_prop/sub_max_phy", 180 + random(120));
      }

      message_vision(CYN "" + in_obj->query("name") + CYN "散出耀眼夺目的金光!\n" NOR, me);
    } else {
      in_obj->add("armor_prop/parry", 3 + random(4));
      in_obj->add("armor_prop/unarmed", 3 + random(4));
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加稳定了！\n" NOR, me);
    }
    me->add("potential", -1200);
    in_obj->set_weight(in_obj->query_weight() + 1200);

    in_obj->set("inset_num", inset_num);
    in_obj->set("no_sell", 1);
    in_obj->set("no_give", 1);
    in_obj->add("inset_y", inset_num);  //装备y
    if (!in_obj->is_diablo_ob()) in_obj->set("name", HIY + in_obj->query("name") + NOR);
    if (!in_obj->query("old_long")) in_obj->set("old_long", in_obj->query("long"));
    in_obj->set(
      "long",
      in_obj->query("old_long") + "上面嵌上了" HIW + chinese_number(inset_num) + "颗宝石\n" NOR
    );
    in_obj->save();
    if (!in_obj->is_diablo_ob() && check_baoshi(in_obj) == 1) build_armor(me, in_obj);
    destruct(ob);
    return 1;
  } else {
    //武器
    message_vision(CYN "$N手捧$n，" NOR + CYN "激发出内力和法力交汇注入其中!\n" NOR, me, ob);
    tell_room(
      environment(me),
      HIY "只见" + ob->name() + HIY "蓬的一声炸了开来,一团金粉扬扬撒撒的落在" + in_obj->query("name") + HIY "的周围 \n" NOR
    );

    if (in_obj->is_diablo_ob()) {
      in_obj->add("diablo_prop/add_phy", 6 + random(9));
      in_obj->add("diablo_prop/attack", 6 + random(8));
      in_obj->add("diablo_prop/add_max_phy", 240 + random(120));
      in_obj->add("diablo_prop/add_skill_damage", 2 + random(2));
      in_obj->add("diablo_prop/damage", 6 + random(6));
      message_vision(CYN "" + in_obj->query("name") + CYN "散出耀眼夺目的金光！\n" NOR, me);
    } else {
      in_obj->add("weapon_prop/damage", 12 + random(12));
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加灵气活现了！\n" NOR, me);
    }
    me->add("potential", -1200);
    in_obj->set_weight(in_obj->query_weight() + 1200);
    in_obj->set("no_sell", 1);
    in_obj->set("no_give", 1);
    in_obj->set("inset_num", inset_num);
    in_obj->add("inset_y", inset_num);  //装备y
    if (!in_obj->is_diablo_ob()) in_obj->set("name", HIY + in_obj->query("name") + NOR);
    if (!in_obj->query("old_long")) in_obj->set("old_long", in_obj->query("long"));
    in_obj->set(
      "long",
      in_obj->query("old_long") + "上面嵌上了" HIW + chinese_number(inset_num) + "颗宝石\n" NOR
    );
    in_obj->save();
    if (!in_obj->is_diablo_ob() && check_baoshi(in_obj) == 1) build_weapon(me, in_obj);
    destruct(ob);
    return 1;
  }



  return notify_fail("你镶嵌宝石失败了!\n");
}
