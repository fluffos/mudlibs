void do_sanqing()
{
	object me = this_object();
	object a,b,c;
	object target;
	
	if(!random(3)&&me->query("mana") > 1000&&me->query("force") > 1000&&me->is_fighting()&&!me->query_temp("jinzhou"))
	{
		message_vision("\n$N长啸一声，五行真气直冲天灵，施展出太乙无上心法——"+BLINK+HIW"『一气化三清』\n"NOR,me);
		me->add("mana",-800);
		me->add("force",-800);
		a =new("/d/quest/dajiu/npc/sanqing");
		a->invocation(me,0);
		a->move(environment(me));
		a->set_temp("invoker",me);
		a->add_temp("apply/damage",1+random(100));
		a->set_temp("combat/bless",1+random(9));
		a->add_temp("apply/sub_max_armor",3600); 
	        a->add_temp("apply/sub_max_defense",3600); 
	        a->add_temp("apply/combat_double_damage",3600); 
	        a->add_temp("apply/combat_ignore_armor",3600);
	        a->add_temp("apply/sub_max_phy",3600);
                a->add_temp("apply/add_max_phy",3600);
                a->add_temp("apply/add_max_spells_all",3600);
                a->add_temp("apply/sub_max_spells_all",3600);
		target = me->select_opponent();
		if(target&&!userp(target))
		     target = me->select_opponent();
		if(target)
		{
		     a->kill_ob(target);
		     a->command("perform damoyange");
		     a->command("perform damoyange on "+target->query("id"));
	
		}
		destruct(a);
		
		b =new("/d/quest/dajiu/npc/sanqing");
		b->invocation(me,1);
		b->move(environment(me));
		b->set_temp("invoker",me);
		b->add_temp("apply/damage",1+random(100));
		b->set_temp("combat/bless",1+random(9));
		b->add_temp("apply/sub_max_armor",3600); 
	        b->add_temp("apply/sub_max_defense",3600); 
	        b->add_temp("apply/combat_double_damage",3600); 
	        b->add_temp("apply/combat_ignore_armor",3600);
	        b->add_temp("apply/sub_max_phy",3600);
                b->add_temp("apply/add_max_phy",3600);
                b->add_temp("apply/add_max_spells_all",3600);
                b->add_temp("apply/sub_max_spells_all",3600);
	     
		target = me->select_opponent();
		if(target&&!userp(target))
		     target = me->select_opponent();
		if(target)
		{
		     b->kill_ob(target);
		     b->command("perform juejian");
		     b->command("perform juejian on "+target->query("id"));
	
		}
		destruct(b);
		c =new("/d/quest/dajiu/npc/sanqing");
		c->invocation(me,2);
		c->move(environment(me));
		c->set_temp("invoker",me);
		c->add_temp("apply/damage",1+random(100));
		c->set_temp("combat/bless",1+random(9));
		c->add_temp("apply/sub_max_armor",3600); 
	        c->add_temp("apply/sub_max_defense",3600); 
	        c->add_temp("apply/combat_double_damage",3600); 
	        c->add_temp("apply/combat_ignore_armor",3600);
	        c->add_temp("apply/sub_max_phy",3600);
                c->add_temp("apply/add_max_phy",3600);
                c->add_temp("apply/add_max_spells_all",3600);
                c->add_temp("apply/sub_max_spells_all",3600);
	     
		target = me->select_opponent();
		if(target&&!userp(target))
		     target = me->select_opponent();
		if(target)
		{
		     c->kill_ob(target);
		     c->command("perform fuhu");
		     c->command("perform fuhu on "+target->query("id"));
	
		}
		destruct(c);
		me->start_busy(1);
        }
        else if(!random(3))
        {
        	command("cast wuxing");
        }
 	
 	remove_call_out ("do_sanqing");  
  	call_out ("do_sanqing",random(3)+3);  
}
void init() 
{ 
    
  ::init(); 
  
   add_action("do_no", ({"fight","kill","steal","ji","throw"}) ); 
  add_action("do_cast","cast");
  add_action("do_perform","perform");
   add_action("do_hun","hun");
    add_action("do_block","",1);    
} 
int do_hun()
{
	return 1;
}

int do_no(string arg) 
{ 
	  object who = this_player(); 
	  object me = this_object(); 
	  
	  if (userp(who)&&who->query_temp("dajiu/mark")!= query("mark")) 
	   { 
	        command("hate "+who->query("id"));
	        return 1; 
	   }  
	 
	  
	  return 0; 
} 
 
 
int do_cast(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     
        if (userp(who)&&who->query_temp("dajiu/mark")!= query("mark")) 
	    { 
	        command("hate "+who->query("id"));
	        return 1; 
	    }  
	 
     if (sscanf(arg, "%s", cast_id) == 1)
        if(cast_id=="qiankun" || cast_id=="zhuang"  || cast_id=="huanying")
          { command("flip "+who->query("id"));
       return 1;}  
       else 
    if (sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
     
      if(cast_id=="qiankun" || arg=="qiankun" || cast_id=="zhuang" || arg=="zhuang" || cast_id=="huanying" || arg=="huanying")
      {
       	 command("caidao "+who->query("id"));
       	  return 1;
       }
    
      
} 
int do_perform(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     
        if (userp(who)&&who->query_temp("dajiu/mark")!= query("mark")) 
	    { 
	        command("pai "+who->query("id"));
	        return 1; 
	    }  
	
	   if(sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
	  {
	  
		   if(cast_id=="dodge.xukong"||cast_id=="huifeng"||cast_id=="huadie")
		  {   command("pai "+who->query("id"));
		      return 1;
		
		     }
	}
	else  if(sscanf(arg, "%s", cast_id) == 1)
	  {
	  	 if(cast_id=="dodge.xukong"||cast_id=="huifeng"||cast_id=="huadie")
		{
		     command("pai "+who->query("id"));
		      return 1;
		
		}
		  else return 0;
	  	
	  }
  	else return 0;
    
      
} 
int do_copy(object me,int maxpot)
{
        int i,j;
        int imm;
        object ob;
        ob = this_object();
        i=maxpot;
        i = i +i/5+ random(i/5);
        if( i < 100) i = 100;
        ob->set("mark",me->query_temp("dajiu/mark"));
        
        ob->set("combat_exp", (ob->query("team_exp")*3/2+random(ob->query("team_exp"))/2 ));
        ob->set("daoxing", (me->query("daoxing")*3/2+random(me->query("daoxing"))/2 ));
      
        ob->set_skill("force", i);
        ob->set_skill("music", i);
        ob->set_skill("zouxiao", i);
        ob->set_skill("blade", i);
        ob->set_skill("kugu-blade", i);
        ob->set_skill("wuxing-quan", i);
        ob->set_skill("zhenyuan-force", i);
        ob->set_skill("dodge", i);
        ob->set_skill("baguazhen", i);
        ob->set_skill("parry", i);
        ob->set_skill("spells", i);
        ob->set_skill("taiyi", i);
        ob->set_skill("unarmed", i);

        map_skill("spells", "taiyi");
        map_skill("force", "zhenyuan-force");
        map_skill("parry", "kugu-blade");
        map_skill("unarmed", "wuxing-quan");
        map_skill("music", "zouxiao");
        map_skill("dodge", "baguazhen");
        if(i > 200)
        ob->set("skill_level/music","expert");
        if(i > 300)
        ob->set("skill_level/music","master");
         if(i > 600)
        ob->set("skill_level/music","grandmaster");
        ob->set("max_kee", 9000+i*40+random(i*25)); 
        ob->set("max_sen", 9000+i*40+random(i*25)); 
        ob->set("max_force", 4000+i*24); 
        ob->set("max_mana", 4000+i*24); 
  
        set("force_factor", i);
        set("mana_factor", i);
       
       	ob->set("eff_gin", query("max_gin"));
	ob->set("eff_kee", query("max_kee"));
	ob->set("eff_sen", query("max_sen"));
	ob->set("gin", query("max_gin"));
	ob->set("kee", query("max_kee"));
	ob->set("sen", query("max_sen"));
	ob->set("force", 2*query("max_force"));
	ob->set("mana", 2*query("max_mana"));
     
        ob->delete_temp("wuxing/init_done");
	WUXING_D->init_user_wuxing(this_object()); 

	ob->add_temp("apply/armor",750+i/2+random(i/2));
	ob->add_temp("apply/damage",210+random(i/3));
	ob->set_temp("combat/bless",4+random(4));
	ob->set_temp("combat/lucky",4+random(4));
     ob->set_temp("wzg_set",1);
        ob->add_temp("apply/parry_block_attack",3600); 
       ob->add_temp("apply/sub_max_defense",3600); 
         ob->add_temp("apply/sub_max_phy",3600);
        ob->add_temp("apply/add_max_phy",3600);
        ob->add_temp("apply/add_max_spells_all",3600);
        ob->add_temp("apply/sub_max_spells_all",3600);
         imm = random(4);
         if(imm == 0)
         	ob->set_temp("apply/immune_jin",1);
         else if(imm == 1)
            ob->set_temp("apply/immune_mu",1);
       else if(imm == 2)
            ob->set_temp("apply/immune_shui",1);  
       else if(imm == 3)
         	ob->set_temp("apply/immune_huo",1);      
     
      if(random(2))
    	    ob->set_temp("apply/immune_magic",1);   
    	 else 
    	    ob->set_temp("apply/sub_phy",9999);        
	
	ob->reset_action();

//  call_out ("do_sanqing",1+random(3));
	call_out("do_back",600+random(120),ob);
        return 1;
}
void penalty(object me)
{
	object jing,fan,xiang,bian;
	if(!me) return;
	if(me->query_temp("dajiu/mark")!= query("mark"))	return;
	if(!me->query_condition("mjb_busy"))	return;
	fan=present("dingyao fan",me);
	xiang=present("baibao xiang",me);
	bian=present("dashen bian",me);
        message_vision(HIY" 突然半空中一只大手一把抓住$N,一下子就不见了\n"NOR,me);
       
        me->add("dajiu/exp",-me->query("combat_exp")/3200);
        me->add("dajiu/dx",-me->query("daoxing")/3200);
        me->add("combat_exp",-me->query("combat_exp")/3200);
        me->add("daoxing",-me->query("daoxing")/3200);	
        me->add("dajiu/die",1);
        me->delete_temp("dajiu");
        me->clear_condition();
       me->delete("dajiu_busy");
        me->remove_ride();
        me->move("/d/wiz/entrance");
        message_vision(HIY"姜子牙盯着$N,摇了摇头说:看来你的修行不够,不可担当大任。说完伸手在$N顶门一拍\n"NOR,me);
       jing = query("jing");
	if(jing)
	  destruct(jing); 
       if(fan) 
      	 destruct(fan);
        if(xiang) 
      	 destruct(xiang);
      	if(bian) 
      	 destruct(bian);
	me->unconcious();
	 me->set("eff_kee",me->query("max_kee"));
        me->set("eff_sen",me->query("max_sen"));
        me->set("kee",me->query("max_kee")/3);
        me->set("sen",me->query("max_sen")/3);
}
int do_back(object me)
{         
	  object *team;
	  int count;
	  team = me->query("team");
	   count = sizeof(team);             
	  tell_room(environment(me), me->query("name")+"趁大家不注意，偷偷地离开了。\n", ({me}));	
	  tell_room(environment(me), HIY "恶悍妇已经逃掉了，任务失败了！\n" NOR, ({me}));
	   if(team)
	   {
	   	for(int pp = 0;pp <count;pp++)
		penalty(team[pp]);	
	}
	  destruct(me); 
	  return 1;
}


void heart_beat() 
{  
	object me = this_object();
	object sword,*team;
	int i,j,count;
	if(!environment(me))
	   return ;
	team = me->query("team");
	command("wield all");
	command("wear all");

       
        if (query("eff_kee")<query("max_kee"))
        {
        	if(is_fighting())
	        if (present("jinchuang yao",me))
	        {
	        	command("eat yao");
		        command("eat yao");
	       
	        }
       
        }
         if (query("eff_sen")<query("max_sen"))
        {
	        if (present("hunyuan dan",me))
	        {
if(random(2))
	        	command("surrender");
	        	command("eat dan");
		        command("eat dan");
		        
	       
	        }
        }
        if (me->query("kee") < me->query("eff_kee")*5/10&&
	    me->query("force") > 0)
	   {
		   command("exert recover");
	 
	   }
	if (me->query("sen") < me->query("eff_sen")*5/10&&
	    me->query("force") > 0)
	   {
         if(random(2))
	   	 command("surrender");
	  	 command("exert refresh");
	  
	   }
       
        if (query("force")<300&&query("mana")> 300)
        {
	        command("cast transfer");
       
 	}
 
    if (!(sword=present("zhuxiao", me)))
   	{
	   	sword=new("/d/obj/weapon/xiao/zhuxiao.lpc");
	   	sword->move(me);
	   	command("wield zhuxiao");
	}
	if(team)
      count = random(sizeof(team));
      if(team[count]&&team[count]->query_temp("dajiu/mark")==query("mark")&&environment(team[count])==environment(me))
    	  me->kill_ob(team[count]);
         	
   ::heart_beat();
 
}   
void unconcious()
{
   die();
}     
void die() 
{    
       
        object yao;
        object gift;
         object me=query_temp("last_damage_from");
         message_vision (CYN"\n$N眼露凶光道:  老娘我还会回来的......\n"NOR,this_object()); 
         yao=new("/d/obj/drug/guo");
         yao->move(environment(this_object()));
         gift=new("/d/quest/dajiu/obj/qiankun");
	 gift->set("mark",this_object()->query("mark"));
	 gift->set("team",this_object()->query("team"));
	 gift->set("combat_exp",this_object()->query("team_exp"));
	 gift->set("jing",this_object()->query("jing"));
	 gift->move(this_object());

         if(me)
         {  
         	if(!userp(me)||me->query_temp("dajiu/mark")==query("mark"))
	      {
		      	if(userp(me))
		      {	
		      
		      	this_object()->set("is_diablo_npc",1);
			this_object()->set("magic_find",200+random(200));
			DIABLO_D->diablo_drop(this_object(),me);
			me->add_temp("dajiu/killed",500+random(500));
			me->add("faith",1);
			me->add("weiwang",1);
		      }
		::die();
	     }
	      else
	 {
	 	command("escape "+this_object()->query("id"));
	 	this_object()->move("/obj/void");
	 	destruct(this_object());
	 
	}	
	 }	
	 else
	 {
	 	command("die1 "+this_object()->query("id"));
	 	this_object()->move("/obj/void");
	 	destruct(this_object());
	 
	}		
	
}

int do_block(string arg)
{
    object me=this_object();
    object who=this_player();
    string verb=query_verb();
    int t;
        
    if(!userp(who)) return 0;
      
  if( who->query_temp("dajiu/mark")!= me->query("mark")) return 0;
       
    if(verb!="go" &&
            verb!="fly" &&
            !(environment() && environment()->query("exits/" + verb)))
        return 0;
    
    t= random(4);
   
    if (t==1) {
        
        message_vision("$n乘$N一个不注意，急忙溜了过去。\n",me,who);
        return 0;
    }
   
        message_vision("$N身形一晃拦在$n面前，阴笑道：现在想跑来不急了,老娘花园正缺花肥呢！\n\n",me,who);
        tell_object(who,me->name()+"堵住了你！\n");
if(!who->is_busy())
who->start_busy(random(2));
        return 1;
} 
