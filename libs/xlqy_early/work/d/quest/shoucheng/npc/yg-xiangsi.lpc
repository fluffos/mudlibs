inherit __DIR__"guai.lpc";

int do_yue();
void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        if (level==1) guai_value = max_value+max_value/12; 
        else if (level==2) guai_value = max_value+max_value/10; 
        else guai_value = max_value+max_value/8; 
        create_family("蜀山剑派", 3, "弟子");
        if(random(2))
       	 set("gender","女性");
       	
        set_skill("hunyuan-zhang", guai_value+random(16));
        set_skill("sevensteps", guai_value+random(16));
        set_skill("sword", guai_value+random(16));
        set_skill("canxin-jian", guai_value+random(16));
         set_skill("yujianshu", guai_value+random(16));
          set_skill("mindsword", guai_value+random(16));
        set_skill("zixia-shengong", guai_value+random(16));
        set_skill("literate", 180);
        set_skill("whip", guai_value+random(16));
        set_skill("yirubian", guai_value+random(16));
        
        set_skill("taoism", guai_value+20+random(16));
        map_skill("spells", "taoism");
        map_skill("force", "zixia-shengong");
        map_skill("unarmed", "hunyuan-zhang");
        map_skill("parry", "canxin-jian");
        map_skill("sword", "canxin-jian");
        map_skill("dodge", "sevensteps");
  	  map_skill("whip", "yirubian");
        set("force_factor", query_skill("force")/2);
        set("mana_factor", query_skill("spells")/2);
         if(guai_value > 200)
        	{ set("skill_level/sword","expert");
        	set("skill_level/whip","expert");
        	
        }
          if(guai_value > 300)
              { 	 set("skill_level/sword","master");      
               set("skill_level/whip","master");      
                  
        }
           if(guai_value > 300)
              { 	 set("skill_level/sword","grandmaster");      
               set("skill_level/whip","grandmaster");      
                  
        }
        carry_object("/d/obj/armor/jinjia.lpc")->wear();
        carry_object("/d/npc/obj/sword.lpc")->wield();
         carry_object("/d/npc/obj/whip.lpc");
        set("chat_chance_combat", 85);
          set("chat_msg_combat", ({
		(: perform_action, "sword","xiangsi" :),
		(: exert_function, "zhanqi" :),
		(: do_yue :),
		
         }) );
          set("shushan/ask_zuidao_go",1);       
    
}
int do_yue()
{
	
	object me = this_object();
	me->command("perform xiangsi");
	me->command("unwield sword");
	me->command("wield whip");
	me->command("perform yue");
	me->command("unwield whip");	
	me->command("wield sword");
	return 1;
}

