inherit __DIR__ "guai.lpc";

int do_tian();
void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);
  create_family("将军府", 3, "弟子");

  if (level == 1) guai_value = max_value + max_value / 8;
  else if (level == 2) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  set_skill("changquan", guai_value + random(16));
  set_skill("yanxing-steps", guai_value + random(16));
  set_skill("axe", guai_value + random(16));
  set_skill("sanban-axe", guai_value + random(16));
  set_skill("lengquan-force", guai_value + random(16));
  set_skill("literate", 180);
  set_skill("baguazhou", guai_value + 20 + random(16));
  map_skill("spells", "baguazhou");
  map_skill("force", "lengquan-force");
  map_skill("unarmed", "changquan");
  map_skill("axe", "sanban-axe");
  map_skill("parry", "sanban-axe");
  map_skill("dodge", "yanxing-steps");

  set("force_factor", query_skill("force") / 2);
  set("mana_factor", query_skill("spells", 1));
  if (guai_value > 200)
    set("skill_level/axe", "expert");
  if (guai_value > 300)
    set("skill_level/axe", "master");
  if (guai_value > 600)
    set("skill_level/axe", "grandmaster");
  carry_object("/d/obj/armor/jinjia.lpc")->wear();
  carry_object("d/npc/obj/axe.lpc")->wield();
  set("chat_chance_combat", 85);
  set("chat_msg_combat", ({
    (: perform_action, "axe", "sanban" :),
    (: perform_action, "unarmed", "zhiqi" :),
    (: exert_function, "haste" :),
    (: do_tian :),
  }));
}


int do_tian() {

  object me = this_object();
  me->command("unwield axe");
  me->command("perform zhiqi");
  me->command("wield axe");
  me->command("perform sanban");
  return 1;


}
