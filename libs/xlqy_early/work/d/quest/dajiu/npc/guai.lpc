string invocation(object me, int level) {
  object guai, env;
  guai = this_object();
  copy_status(me, level);

  set("mark", me->query_temp("dajiu/mark"));


}

void copy_status(object me, int level) {
  mapping me_skill;
  int *skill_value, max_value, i;

  me_skill = me->query_skills();
  i = sizeof(me_skill);
  if (i > 0) {
    skill_value = values(me_skill);
    max_value = skill_value[0];
    while (i--) {  // 找出玩家skill最大值 
      if (skill_value[i] > max_value)
        max_value = skill_value[i];
    }
  } else max_value = 1;
  set("npcstart", time() + 900 + random(900));
  set_skills(max_value, level);

  set_hp_status(me, level);
  delete_temp("wuxing/init_done");
  WUXING_D->init_user_wuxing(this_object());
}

void set_skills(int max_value, int level) {
  object guai = this_object();
  int guai_value;

  if (level == 1)

    guai_value = max_value + max_value / 21;
  else if (level == 2)

    guai_value = max_value + max_value / 18;
  else

    guai_value = max_value + max_value / 15;

  set_skill("unarmed", guai_value + random(13));
  set_skill("dodge", guai_value + random(13));
  set_skill("parry", guai_value + random(13));
  set_skill("force", guai_value + random(13));
  set_skill("spells", guai_value + 13 + random(13));
}


void set_hp_status(object me, int level) {
  int max_kee, max_sen, skill_force, skill_mana, exp, daoxing;
  max_kee = me->query("max_kee");
  max_sen = me->query("max_sen");
  skill_force = query_skill("force");
  skill_mana = query_skill("spells");
  exp = me->query("combat_exp");
  daoxing = me->query("daoxing");

  if (level > 1) {
    max_kee = max_kee * 6 / 5;
    max_sen = max_sen * 6 / 5;
  }
  set("max_force", skill_force * (9 + level));
  set("force", skill_force * (18 + level));
  set("force_factor", skill_force / 2);
  set("mana_factor", query_skill("spells", 1) / 2);
  if (exp < 800000) {
    set("max_kee", max_kee * 9 / 8);
    set("eff_kee", max_kee * 9 / 8);
    set("max_sen", max_sen * 9 / 8);
    set("eff_sen", max_sen * 9 / 8);
    set("kee", max_kee * 9 / 8);
    set("sen", max_sen * 9 / 8);
    set("max_mana", skill_mana * 5);
    set("mana", skill_mana * 12);
    set("combat_exp", exp + exp / 18 + random(exp / 18));
    set("daoxing", daoxing + daoxing / 21);
    set_temp("apply/armor", 120);
    set_temp("apply/damage", 25);
    set_temp("combat/bless", 1 + random(level + 1));
    set_temp("combat/lucky", 1 + random(level + 1));
    set_temp("apply/sub_max_armor", 600);  // ignore 12% target's armor
    set_temp("apply/sub_max_defense", 400);  //ignore 6% target's defense

  }

  else if (exp < 2000000) {
    set("max_kee", max_kee * 4 / 3);
    set("eff_kee", max_kee * 4 / 3);
    set("max_sen", max_sen * 4 / 3);
    set("eff_sen", max_sen * 4 / 3);
    set("kee", max_kee * 4 / 3);
    set("sen", max_sen * 4 / 3);
    set("max_mana", skill_mana * 6);
    set("mana", skill_mana * 14);
    set("combat_exp", exp + exp / 15 + random(exp / 15));
    set("daoxing", daoxing + daoxing / 18);
    set_temp("apply/armor", 180);
    set_temp("apply/damage", 36);
    set_temp("combat/bless", 1 + random(level + 1));
    set_temp("combat/lucky", 1 + random(level + 1));
    set_temp("apply/sub_max_armor", 900);  // ignore 12% target's armor
    set_temp("apply/sub_max_defense", 600);  //ignore 6% target's defense

  } else if (exp < 5000000) {
    set("max_kee", max_kee * 3 / 2);
    set("eff_kee", max_kee * 3 / 2);
    set("max_sen", max_sen * 3 / 2);
    set("eff_sen", max_sen * 3 / 2);
    set("kee", max_kee * 3 / 2);
    set("sen", max_sen * 3 / 2);
    set("max_mana", skill_mana * 8);
    set("mana", skill_mana * 16);
    set("combat_exp", exp + exp / 12 + random(exp / 12));
    set("daoxing", daoxing + daoxing / 15);
    set_temp("apply/armor", 240);
    set_temp("apply/damage", 60);
    set_temp("combat/bless", 1 + random(level + 1));
    set_temp("combat/lucky", 1 + random(level + 1));
    set_temp("apply/sub_max_armor", 1200);  // ignore 12% target's armor
    set_temp("apply/sub_max_defense", 900);  //ignore 6% target's defense

  }

  else if (exp < 7500000) {
    set("max_kee", max_kee * 2);
    set("eff_kee", max_kee * 2);
    set("max_sen", max_sen * 2);
    set("eff_sen", max_sen * 2);
    set("kee", max_kee * 2);
    set("sen", max_sen * 2);
    set("max_mana", skill_mana * 11);
    set("mana", skill_mana * 22);
    set("combat_exp", exp + exp / 8 + random(exp / 8));
    set("daoxing", daoxing + daoxing / 12);
    set_temp("apply/armor", 360);
    set_temp("apply/damage", 108);
    set_temp("combat/bless", level + random(level));
    set_temp("combat/lucky", level + random(level));
    set_temp("apply/sub_max_armor", 1800);  // ignore 18% target's armor
    set_temp("apply/sub_max_defense", 1400);  //ignore 10% target's defense

  }

  else if (exp < 10000000) {
    set("max_kee", max_kee * 5 / 2);
    set("eff_kee", max_kee * 5 / 2);
    set("max_sen", max_sen * 5 / 2);
    set("eff_sen", max_sen * 5 / 2);
    set("kee", max_kee * 5 / 2);
    set("sen", max_sen * 5 / 2);
    set("max_mana", skill_mana * 13);
    set("mana", skill_mana * 27);
    set("combat_exp", exp + exp / 6 + random(exp / 6));
    set("daoxing", daoxing + daoxing / 9);
    set_temp("apply/armor", 520);
    set_temp("apply/damage", 166);
    set_temp("combat/bless", level + random(2 * level));
    set_temp("combat/lucky", level + random(2 * level));
    set_temp("apply/sub_max_armor", 2500);
    set_temp("apply/sub_max_defense", 1900);

  } else if (exp < 14000000) {
    set("max_kee", max_kee * 4);
    set("eff_kee", max_kee * 4);
    set("max_sen", max_sen * 4);
    set("eff_sen", max_sen * 4);
    set("kee", max_kee * 4);
    set("sen", max_sen * 4);
    set("max_mana", skill_mana * 16);
    set("mana", skill_mana * 32);
    set("combat_exp", exp + exp / 4 + random(exp / 4));
    set("daoxing", daoxing * 6 / 5);
    set_temp("apply/armor", 640);
    set_temp("apply/damage", 199);
    set_temp("combat/bless", 2 * level + random(level));
    set_temp("combat/lucky", 2 * level + random(level));
    set_temp("apply/sub_max_armor", 3000);
    set_temp("apply/sub_max_defense", 2400);
    if (!random(3)) set_temp("apply/immune_jin", 1);
    if (!random(3)) set_temp("apply/immune_mu", 1);
    if (!random(3)) set_temp("apply/immune_shui", 1);
    if (!random(3)) set_temp("apply/immune_huo", 1);
    add_temp("apply/sub_max_phy", 1500);
    add_temp("apply/sub_phy", 250);
    set("chat_chance_combat", 90);

  } else if (exp < 20000000) {
    set("max_kee", max_kee * 5);
    set("eff_kee", max_kee * 5);
    set("max_sen", max_sen * 5);
    set("eff_sen", max_sen * 5);
    set("kee", max_kee * 5);
    set("sen", max_sen * 5);
    set("max_mana", skill_mana * 18);
    set("mana", skill_mana * 36);
    set("combat_exp", exp + exp / 3 + random(exp / 3));
    set("daoxing", daoxing * 3 / 2);
    set_temp("apply/armor", 720);
    set_temp("apply/damage", 255);
    set_temp("combat/bless", 2 * level + random(2 * level));
    set_temp("combat/lucky", 2 * level + random(2 * level));
    set_temp("apply/sub_max_armor", 3600);
    set_temp("apply/sub_max_defense", 2900);
    if (!random(2)) set_temp("apply/immune_jin", 1);
    if (!random(2)) set_temp("apply/immune_mu", 1);
    if (!random(2)) set_temp("apply/immune_shui", 1);
    if (!random(2)) set_temp("apply/immune_huo", 1);
    add_temp("apply/sub_max_phy", 2200);
    add_temp("apply/sub_phy", 360);
    set("chat_chance_combat", 95);

  } else {
    set("max_kee", max_kee * 7);
    set("eff_kee", max_kee * 7);
    set("max_sen", max_sen * 7);
    set("eff_sen", max_sen * 7);
    set("kee", max_kee * 7);
    set("sen", max_sen * 7);
    set("max_mana", skill_mana * 21);
    set("mana", skill_mana * 42);
    set("combat_exp", exp + exp / 3 + random(exp / 3));
    set("daoxing", daoxing * 2);
    set_temp("apply/armor", 900);
    set_temp("apply/damage", 320);
    set_temp("combat/bless", 3 * level + random(3 * level));
    set_temp("combat/lucky", 3 * level + random(3 * level));
    set_temp("apply/sub_max_armor", 4800);
    set_temp("apply/sub_max_defense", 3800);
    set_temp("apply/immune_jin", 1);
    set_temp("apply/immune_mu", 1);
    set_temp("apply/immune_shui", 1);
    set_temp("apply/immune_huo", 1);
    add_temp("apply/sub_max_phy", 3300);
    add_temp("apply/sub_phy", 500);
    set("chat_chance_combat", 95);

    if (!random(5)) set_temp("apply/immune_magic", 1);
    else if (!random(10)) set_temp("apply/immune_phy", 1);
  }


}
void init() {
  object me = this_object();
  object who = this_player();
  int type;
  int t = query("npcstart");
  ::init();
  add_action("do_no", ({ "fight", "kill", "steal", "ji", "throw" }));
  add_action("do_cast", "cast");
  add_action("do_perform", "perform");
  add_action("do_block", "", 1);

  if (t && time() > (t + 300)) {
    remove_call_out("leave");
    call_out("leave", 1);
    return;
  }

  if (t && time() > t) {
    remove_call_out("_leave");
    call_out("_leave", 300);
  }
  if (!living(this_object())) return;
  if (!living(who)) return;
  //  call_out("follow",150);    
}
int do_no(string arg) {
  object who = this_player();
  object me = this_object();

  if (userp(who) && who->query_temp("dajiu/mark") != query("mark")) {
    message_vision(CYN "$N说道：要是怕死就快滚！\n" NOR, me);
    return 1;
  }

  else if (!userp(who) && who->query("id") != "lao guai") {
    if (objectp(who->query_temp("invoker")))
      who = who->query_temp("invoker");
    else return 1;
    if (who->query_temp("dajiu/mark") != query("mark")) {
      message_vision(CYN "$N说道：要是怕死就快滚！\n" NOR, me);
      return 1;
    }

  } else if (!userp(who) && who->query("id") == "lao guai")
    return 0;

  me->kill_ob(who);
  return 0;
}


int do_cast(string arg) {

  string cast_id, cast_name;
  object me = this_object();
  object who = this_player();
  if (!arg) return 0;

  if (userp(who) && who->query_temp("dajiu/mark") != query("mark")) {
    message_vision(CYN "$N说道：要是怕死就快滚！\n" NOR, me);
    return 1;
  }
  /*
	  else if(!userp(who)&&who->query("id")!= "lao guai")
	  {
		  if(objectp(who->query_temp("invoker")))
				who=who->query_temp("invoker");
		   else return 1;
		   if (who->query_temp("dajiu/mark")!= query("mark")) 
		    { 
		        message_vision(CYN"$N说道：要是怕死就快滚！\n"NOR,me); 
		        return 1; 
		    }  	
	  	
	   }
         else if(!userp(who)&&who->query("id") == "lao guai")
       	 	return 0;
*/
  if (sscanf(arg, "%s", cast_id) == 1)
    if (cast_id == "qiankun" || cast_id == "zhuang" || cast_id == "huanying") {
      tell_object(who, "老怪对你说到：长得丑不是你得错！但出来吓人就不对了。\n");
      return 1;
    } else if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2)

      if (cast_id == "qiankun" || arg == "qiankun" || cast_id == "zhuang" || arg == "zhuang" || cast_id == "huanying" || arg == "huanying")

      {
        tell_object(who, "老怪对你冷笑了一声，有种就放马过来吧，瞎折腾啥啊！\n");
        return 1;
      }


}
int do_perform(string arg) {

  string cast_id, cast_name;
  object me = this_object();
  object who = this_player();
  if (!arg) return 0;

  if (userp(who) && who->query_temp("dajiu/mark") != query("mark")) {
    message_vision(CYN "$N说道：要是怕死就快滚！\n" NOR, me);
    return 1;
  }
  /*
	  else if(!userp(who)&&who->query("id")!= "lao guai")
	  {
		  if(objectp(who->query_temp("invoker")))
				who=who->query_temp("invoker");
		   else return 1;
		   if (who->query_temp("dajiu/mark")!= query("mark")) 
		    { 
		        message_vision(CYN"$N说道：要是怕死就快滚！\n"NOR,me); 
		        return 1; 
		    }  	
	  	
	   }
       	 else if(!userp(who)&&who->query("id") == "lao guai")
       	 	return 0;
*/
  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2) {

    if (cast_id == "dodge.xukong") {
      tell_object(who, "老怪对你冷笑了一声，有种就放马过来吧，瞎折腾啥啊！\n");
      return 1;

    }
  } else if (sscanf(arg, "%s", cast_id) == 1) {
    if (cast_id == "dodge.xukong") {
      tell_object(who, "老怪对你冷笑了一声，有种就放马过来吧，瞎折腾啥啊！\n");
      return 1;

    } else return 0;

  } else return 0;


}
int heal_up() {

  object me = this_object();

  int i, j;

  if (me->query("kee") < me->query("max_kee") * 5 / 10 &&
    me->query("force") > 0) {

    command("exert recover");

  }
  if (me->query("sen") < me->query("max_sen") * 5 / 10 &&
    me->query("force") > 0) {
    command("exert refresh");
  }

  if (query("eff_kee") < query("max_kee")) {
    if (is_fighting())
      if (present("jinchuang yao", me)) {
        command("eat yao");
        command("eat yao");
        command("eat yao");

      } else {
        command("exert heal");
        command("exert heal");
        command("exert heal");

      }
  }

  if (query("eff_sen") < query("max_sen")) {
    if (present("hunyuan dan", me)) {
      command("eat dan");
      command("eat dan");
      command("eat dan");

    }
  }
  if (query("force") < 300 && query("mana") > 300)
    command("cast transfer");


  return ::heal_up() + 1;

}


void unconcious() {
  die();
}

void die() {
  object yao;
  object me = query_temp("last_damage_from");
  message_vision(CYN "\n$N喊:  兄弟，我扛不住了，先走了，唉，早知道就不当妖怪了......\n" NOR, this_object());
  yao = new("/d/obj/drug/guo");
  yao->move(environment(this_object()));
  if (me && me->query_temp("dajiu/mark") == query("mark")) {
    this_object()->set("is_diablo_npc", 1);
    this_object()->set("magic_find", 150 + random(150));
    DIABLO_D->diablo_drop(this_object(), me);
    //	me->add_temp("dajiu/killed",100*query("count")+query("level")*50);
  }
  load_object("/obj/empty");
  this_object()->move("/obj/empty");
  destruct(this_object());
}



void destruct_ob(object ob) {
  destruct(ob);
}

void kill_ob(object ob) {
  object me = this_object();
  //     if (me->query("level")>1) 
  //         me->set_leader(ob); 
  ::kill_ob(ob);
}
void _leave() {
  object me = this_object();
  if (me->is_fighting() || me->is_busy())
    return;
  leave();
}

void leave() {
  if (this_object()) {
    if (environment()) {
      message("vision", HIB + name() +
        "大笑三声，身子一晃，变成一股青烟散去了。\n" NOR, environment());
    }
    destruct(this_object());
  }
  return;
}


int do_block(string arg) {
  object me = this_object();
  object who = this_player();
  string verb = query_verb();
  int t;

  // wizardp(who) && 

  if (!userp(who)) return 0;


  if (who->query_temp("dajiu/mark") != me->query("mark")) return 0;

  if (verb != "go" &&
    verb != "fly" &&
    !(environment() && environment()->query("exits/" + verb)))
    return 0;

  t = random(4);

  if (t == 1) {

    message_vision("$n乘$N一个不注意，急忙溜了过去。\n", me, who);
    return 0;
  }

  message_vision("$N一伸手拦在$n面前，高声叫道：\n" +
    " 小样，现在想跑来不急了,拿命来吧！\n\n", me, who);
  tell_object(who, me->name() + "一把拦住了你！\n");
  if (!who->is_busy())
    who->start_busy(random(2));
  return 1;
}
