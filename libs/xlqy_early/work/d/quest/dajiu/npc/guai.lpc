void setname() {
  int i;
  string name;
  i = random(sizeof(names));
  name = names[i] + (random(2) ? "老精" : "老怪");

  set_name(name, ({ "lao guai", "guai" }));
  set("title", HIB "魑魅魍魉" NOR);
}

