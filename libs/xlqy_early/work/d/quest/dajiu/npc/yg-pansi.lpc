inherit __DIR__"guai.lpc";


void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        if (level==1) guai_value = max_value+max_value/12; 
        else if (level==2) guai_value = max_value+max_value/10; 
        else guai_value = max_value+max_value/8; 
        create_family("盘丝洞", 3, "弟子");
        set_skill("lanhua-shou", guai_value+random(16));
        set_skill("jiuyin-xinjing", guai_value+random(16));
        set_skill("whip", guai_value+random(16));
        set_skill("yinsuo-jinling", guai_value+random(16));
        set_skill("yueying-wubu", guai_value+random(16));
        set_skill("literate", 180);
        set_skill("pansi-dafa", guai_value+20+random(16));
            set_skill("unarmed", guai_value+random(16));
          set_skill("parry", guai_value+random(16));
              set_skill("spells", guai_value+random(16));
          set_skill("force", guai_value+random(16));
        map_skill("spells", "pansi-dafa");
        map_skill("force", "jiuyin-xinjing");
        map_skill("unarmed", "lanhua-shou");
        map_skill("parry", "yinsuo-jinling");
        map_skill("whip", "yinsuo-jinling");
        map_skill("dodge", "yueying-wubu");
       
        set("force_factor", query_skill("force")/3);
        set("mana_factor", query_skill("spells")/2);
           if(guai_value > 200)
        	 set("skill_level/whip","expert");
          if(guai_value > 300)
               	 set("skill_level/whip","master"); 
         if(guai_value > 600)
               	 set("skill_level/whip","grandmaster");     
        set("chat_chance_combat", 75);
          set("chat_msg_combat", ({
		(: perform_action, "whip","tian" :),
		(: perform_action, "whip","wang" :),
		(: cast_spell, "ziqi" :),
		(: perform_action, "unarmed","fengwei" :),
        }) );
                
        carry_object("/d/obj/armor/jinjia.lpc")->wear();
        carry_object("/d/npc/obj/whip.lpc")->wield();
}

