inherit __DIR__"guai.lpc";


void set_skills(int max_value, int level)
{
        int guai_value;
        object weapon;
         object me = this_object();
        ::set_skills(max_value, level);
        create_family("火云洞", 3, "弟子");

        if (level==1) guai_value = max_value+max_value/8;
        else if (level==2) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;
       
       		 set_skill("literate", 180);
    		set_skill("stick", guai_value+random(50));
		set_skill("dali-bang",guai_value+random(50));
		set_skill("huomoforce",guai_value+random(50));
		set_skill("pingtian-dafa",guai_value+random(50));
		set_skill("moyun-shou",guai_value+random(50));
		set_skill("moshenbu",guai_value+random(50));
		map_skill("force", "huomoforce");
		  map_skill("unarmed", "moyun-shou");
		  map_skill("dodge", "moshenbu");
		  map_skill("spells", "pingtian-dafa");
		  map_skill("parry", "dali-bang");
		  map_skill("stick", "dali-bang");
	
        set("force_factor", query_skill("force")/2);
        set("mana_factor", query_skill("spells",1));
         if(guai_value > 200)
        {	 	  set("skill_level/stick","expert");
	
	  	 
	  	}
          if(guai_value > 300)
               	 {
               	 		  set("skill_level/stick","master");
	  	
	  	}   
	   if(guai_value > 550)
               	 {
               	 		  set("skill_level/stick","grandmaster");
	  	
	  	}       
      

        set("chat_chance_combat", 75);
        set("chat_msg_combat", ({
		(: perform_action, "stick", "lianying" :),
		(: perform_action, "stick", "shenli" :),
		(: perform_action, "unarmed", "zhangxinlei" :),
//		 (: cast_spell, "sanmei" :),
		  (: cast_spell, "zhuang" :),
		        }) );
		        
		    weapon=new("/d/obj/weapon/stick/xiangmo");
        weapon->move(me);
        command("wield all");
}



