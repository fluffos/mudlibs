// pao.c
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name(HIR"大红白鹤绛绡衣"NOR, ({"dao pao", "pao", "cloth"}));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_type", "cloth");
                set("armor_prop/armor", 20);
                set("armor_prop/dodge", 20);
                set("armor_prop/spells",20);
             }
}

