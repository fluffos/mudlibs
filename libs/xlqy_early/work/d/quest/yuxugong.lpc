inherit ROOM;

void create()
{
	set("short", "玉虚宫");
	set("long", @LONG
                
    这里就是昆仑山玉虚宫拿阐教道法元始天尊掌教之处。只见
只见元始天尊端坐九龙沉香辇，馥馥香烟，氤氲偏地。正是：提
炉对对烟生雾，羽扇分开白鹤朝,旁边有白鹤童子侍候。
LONG);
  set("exits", ([
        "out" : __DIR__"qinglg",
        
      ]));
	        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/ystz" : 1,
                __DIR__"npc/xiantong" : 1,
        ]));

       set("no_fight",1);
       set("no_magic",1);
       set("no_get",1);
       set("no_steal",1);
       set("no_put",1);

  setup();
  
}
void init()
{
    add_action("do_no", "kill");
    add_action("do_no", "fight");
    add_action("do_no", "get");
    add_action("do_no", "put");
    add_action("do_no", "cast");
    add_action("do_no", "exert");
    add_action("do_no", "perform");
    add_action("do_no", "ti");
    add_action("do_no", "steal");
    add_action("do_drop", "drop");
}

int do_no()
{
   tell_object(this_player(),"不得无礼。\n");
   return 1;
}


int do_drop(string arg)
{
   object me=this_player();
   object obj;
   
   if( !arg ) return 0;
      
   if( !objectp(obj = present(arg, me)) )
          {  tell_object(me,"你身上没有这样东西。\n");
             return 1;
          }
  
   if ( me->query("xian/kind") != "擒")
          {  tell_object(me,"元始天尊对你说道：“不要在这里乱丢垃圾。”\n");
             return 1;
          }
          
    if( !obj->is_character() )
           {  tell_object(me,"元始天尊对你说道：“不要在这里乱丢垃圾。”\n");
             return 1;
          }
               
    else {    if( obj->is_corpse() )
                   {  tell_object(me,"元始天尊对你说道：“不要在这里乱丢垃圾。”\n");
                      return 1;
                   }
                   
    	      if( obj != me->query("xian/guai") )
                   {   tell_object(me,"元始天尊对你说道：“我没有叫你擒此怪回来。”\n");
                       return 1;
                   }
          
               call_out ("accomplish",2,me,obj);
               return 0;
          }
}      

void accomplish(object me, object obj)
{
      if(!living(obj))
	{tell_room(this_object(),"几个仙童把"+obj->name()+"押了下去。\n\n");
         obj->reward(me);
	 destruct (obj);
	 me->set("xian/accomplish",1);
	 me->set("xian/end_time",time());
	 me->delete("xian/get");
        }
       else return;
}


