#include <ansi.h>

inherit NPC;

int give_gift (object me);

void create()
{
    set_name(HIG"小老头"NOR, ({ "xiao laotou", "laotou"}) );
    set("gender", "男性" );
    set("long", HIY"慈眉善目,穿着一袭青衫，颇有些仙风道骨的气度！\n"NOR);
    set("age", 10000);
    set("title", HIC"发礼物的"NOR);

    set("str", 50);
    set("int", 40);
    set("per", 40);

    set("max_kee", 8000);
    set("kee", 8000);
    set("max_sen", 8000);
    set("sen", 8000);

    set("daoxing", 10000000);

    set("force", 10000);
    set("mana", 10000);
    set("max_force", 10000);
    set("max_mana", 10000);
    set("force_factor", 500);
    set("mana_factor", 400);

    set_skill("buddhism", 400);
    set_skill("spells", 400);
    set_skill("literate", 400);
    map_skill("spells", "buddhism");

    set("inquiry", ([
        "name" : "小老儿是来发礼物的。",
        "gift":   (: give_gift :),
        "liwu":   (: give_gift :),
        "礼物":   (: give_gift :),
        ]));

    setup();
}

int give_gift (object me)
{
    object gift;
    object who = this_player();
    string *basic = ({"unarmed", "dodge", "force", "parry", "sword", "spells", "literate"});
    int count = sizeof(basic);

    if ( who->query("newbie_gift") == 1 )
    {
        message_vision(RED"你已经要过一次了，不可以太贪心！\n"NOR, me, who);
        return 1;
    }

    who->add("combat_exp", 1000000);
    who->add("daoxing", 1000000);
    who->add("potential", 1000000);

    count = sizeof(basic);
    for ( int i = 0; i < count; i++ )
    {
        who->set_skill(basic[i], 100);
    }

    who->set_skill("eye-sword", 100);
    who->set_skill("changchun-gong", 100);

    who->map_skill("force", "changchun-gong");
    who->map_skill("spells", "changchun-gong");
    who->map_skill("sword", "eye-sword");
    who->map_skill("parry", "eye-sword");
    who->map_skill("dodge", "eye-sword");
    who->map_skill("unarmed", "eye-sword");

    who->add("newbie_gift", 1);

    tell_object(who, HIY"请先到亭台水榭使用TTSX恢复满状态!\n"NOR);
    tell_object(who, HIY"你还可以去要新手套装，开始守城吧!\n"NOR);

    return 1;
}

