void init()
{
    add_action("do_up", "levelup");	
    add_action("do_cost", "levelcost");	
}

int do_up()
{
    return LEVEL_D->player_levelup(this_player());
}

int do_cost(string arg)
{
    return LEVEL_D->levelup_cost(this_player(), arg);
}

