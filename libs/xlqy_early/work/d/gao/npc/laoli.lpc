// by bugbug & alading @ 缥缈水云间, 2003-4-5
// /d/gao/npc/laoli.c

inherit F_VENDOR_SALE;

string ask_me();  //定义ask_me
int do_gu(string arg);
int do_dapi(string arg);
int do_cuihuo(string arg);
void reward(object me);

void create() {
  set_name("老李", ({ "laoli", "tiejiang", "li" }));  //以下为人物设置
  set("title", "铁匠铺老板");
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 53);
  set("long", "铁匠正用铁钳夹住一块红热的铁块放进炉中。\n");

  set("chat_chance", 3);
  set("chat_msg", ({
    name() + "一脚踢在小学徒的屁股上，嚷道：偷懒没工钱的！\n",
    name() + "对小学徒嚷道：你给我滚！我要换个徒弟！\n",
  }));

  set("combat_exp", 400);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "blade": "/d/gao/obj/blade",
    "sword": "/d/gao/obj/sword",
    "dagger": "/obj/example/dagger",
  ]));

  set("inquiry", ([
    "工作": (: ask_me :),
    "job": (: ask_me :),
  ]));

  setup();
  add_money("silver", 20);
  carry_object("/d/gao/obj/magua")->wear();
  carry_object("/d/obj/weapon/hammer/hammer")->wield();


}

void init()  //定义动作
{
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
  add_action("do_gu", "gu");
  add_action("do_dapi", "dapi");
  add_action("do_cuihuo", "cuihuo");

}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(1)) {
    case 0:
      say(name() + "大声说道：这位" +
        RANK_D->query_respect(ob)
        + "，要买铁器还是打短工？\n");
      break;
  }
}

int accept_fight(object me) {
  command("say 练练也好，也好！\n");
  return 1;
}


string ask_me() {
  object *inv;
  object me = this_player();

  if (me->query("combat_exp") > 100000)  //检查EXP是否大于500
    return "让您老干这个未免屈尊了吧？";

  if (me->query("kee") < 40)  //检查气
    return "你还是歇会儿吧！要是出了人命我可承担不起。";

  if (me->query_temp("smith/gu"))  //检查标记
    return "让你鼓风箱，你怎么还磨蹭(gu)？";

  if (me->query_temp("smith/dapi"))
    return "叫你打的坯你打了没有(dapi)？";

  if (this_object()->query_temp("work_people") > 5)
    return "我这里的人手已经足够啦。\n";
  this_object()->add_temp("work_people", 1);

  switch (random(3))  //随机分配三个工作
  {
    case 0:
      me->set_temp("smith/gu", 1);
      return "好！你帮我鼓一会儿风箱(gu)。";

    case 1:
      me->set_temp("smith/dapi", 1);
      return "这样吧，你帮我打一下坯吧(dapi)！";

    case 2:
      me->set_temp("smith/cuihuo", 1);
      return "去帮我把这些刚出炉的淬一下火(cuihuo)。";
  }
}

int do_gu(string arg) {
  object me = this_player();

  if (me->is_busy())
    return notify_fail("你现在正忙。\n");

  if (!me->query_temp("smith/gu")) {
    message_vision("$n刚偷偷的拉起鼓风机，鼓了几阵风。就听见$N对$n大喝道：滚开，乱搞什么。\n",
      this_object(), me);
    return 1;
  }

  message_vision("$n拉起鼓风机拼命鼓了起来，$N看了点了点头。\n",
    this_object(), me);
  me->start_busy(1);
  call_out("reward", 5 + random(5), me);
  return 1;
}

int do_dapi(string arg) {
  object me = this_player();

  if (me->is_busy())
    return notify_fail("你现在正忙。\n");

  if (!me->query_temp("smith/dapi")) {
    message_vision("$n拿起几块生铁，在手里掂了掂。就听见$N对$n大喝道：放下，乱搞什么。\n",
      this_object(), me);
    return 1;
  }

  message_vision("$n拿着锤子对刚出炉的火热的生铁用力敲打着，"
    "$N“嗯”了一声，看上去有些满意。\n",
    this_object(), me);
  me->start_busy(1);
  call_out("reward", 5 + random(5), me);
  return 1;
}

int do_cuihuo(string arg) {
  object me = this_player();

  if (me->is_busy())
    return notify_fail("你现在正忙。\n");

  if (!me->query_temp("smith/cuihuo")) {
    message_vision("$n刚抄起一个打造好的坯子，就听见$N对$n大喝道：放下，别给我搞坏了。\n", this_object(), me);
    return 1;
  }

  message_vision("$N用铁钳抄起一块火红的坯子，伸进了水池，“哧”的一声轻烟四冒。\n", me);
  me->start_busy(1);
  call_out("reward", 5 + random(5), me);
  return 1;
}

void reward(object me)  //工作结束，分配奖赏，移除标记
{
  object coin;

  if (!me) return;
  me->delete_temp("smith/gu");
  me->delete_temp("smith/dapi");
  me->delete_temp("smith/cuihuo");

  this_object()->add_temp("work_people", -1);
  coin = new("/obj/money/silver");
  coin->set_amount(1);
  coin->move(this_player());
  message_vision("$N对$n道：这是给你的工钱。\n",
    this_object(), me);
  if (me->query("combat_exp") < 50000) {
    me->add("potential", 1);
    me->add("combat_exp", 1 + random(5));
  }
  me->receive_damage("kee", 30);
  me->start_busy(10 + random(5));
  me->set("renwu/laoli", 1);
}
