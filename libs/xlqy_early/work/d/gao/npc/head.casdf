#include <ansi.h>
inherit NPC;

void create()
{
       set_name("夏鹏展", ({"xia pengzhan", "xia"}));
       set("title", "清风寨强盗头领");
       
set("long","夏鹏展原是长安城中一名捕头，因贼性难改，落草作了强盗．
使一路雁歌刀法，手中雁云刀阴狠无比．\n");
       set("gender", "男性");
        set("age", 37);
      set("str", 28);
       set("attitude", "aggressive");
       set_skill("blade",80);
        set_skill("parry", 80);
	set_skill("dodge", 80);
	set_skill("unarmed", 80);
	set_skill("yange-blade", 60);
	set_skill("yanxing-steps", 60);
	map_skill("dodge", "yanxing-steps");
	map_skill("blade", "yange-blade");
	map_skill("parry", "yange_blade");
       set("max_kee", 1200);
	set("bellicosity", 5000);
       set("max_sen", 1100);
       set("force", 1250);
       set("max_force", 1100);
       set("force_factor", 50);
       set("combat_exp", 150000);
       set("dead",0);
setup();
carry_object("/d/obj/weapon/blade/yanblade")->wield();
carry_object("/d/obj/armor/yinjia")->wear();
carry_object("/d/obj/book/parry_book");
carry_object("/obj/dust");
add_money("silver", 50);
}
void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_ask","ask");
}

void greeting(object ob)
{
	if(!query("dead")){
        if( !ob || !present(ob, environment(this_object())) ) return;
        say( "夏鹏展喝道：那里来的" + RANK_D->query_rude(ob) +
"，我看你不想活了！\n");
			 }
}
void die()
{
  object who=this_player();
  object me = this_object();
  object ob = query_temp("last_damage_from");
  object killer=query_temp("my_killer");
  object last =query_temp("last_killed_by");
  string faint=query_temp("last_fainted_from");
  if(!ob)
  {
  
    	  ::die();
    	  
    	  return;	
  	
}
  if(!ob->query("baobiao/去夺镖旗"))
    	{
    	 
    	  
    	  ::die();
    	  
    	  return;
    	}
  if(ob->query("baobiao/夺回镖旗"))
  	{::die();
  	 
  	 return;
  	}
  if(faint && ob) {
      if(faint!=ob->query("id"))
      		{
      		    ::die();
      		   
      		      return;
      		}
      	}
      if(!last) last=ob;
 	 else if(last!=ob)
  	{::die();return;}
  
   message_vision(CYN"夏鹏展“噗咚”跪倒在地，连声哀求：别杀我，别杀我。我上有八十岁的老娘，下有未满月的孩儿。\n
劫镖的事不是我们干的，不是我们干的啊，镖银我们一文没拿，饶小的一条狗命吧。\n"NOR,who);
  
   ob->set_temp("baobiao/kill_xia",1);
   ob->remove_killer(this_object());
 
   me->set("attitude","peaceful");
   me->set("dead",1);
   me->set("bellicosity", 0);
   me->set("eff_kee",1);
   me->set("kee",1);
   me->set("eff_sen",1);
   me->set("sen",1);	
   me->remove_all_killer();
  
		
}
int do_ask(string arg)
{
	object biaoqi;
	object who=this_player();
	object me=this_object();
	string askwho,askwhat;
	
	if(!who->query_temp("baobiao/kill_xia"))
	      return 0;
        if(!arg)
	  return 0;
	sscanf(arg,"%s about %s",askwho,askwhat);
	
	if(askwhat!="biaoqi"&&askwhat!="biao qi"&&askwhat!="五花翎旗"&&askwhat!="镖旗")
	  return 0;
	if(askwho!="xia pengzhan"&&askwho!="xia")
	  return 0;
	message_vision("$N喝道：交出振远镖局的五花翎旗，我饶你一条狗命。\n",who);
	message_vision("$N抖抖嗦嗦的将五花翎旗交给$n,一溜烟的跑了。\n",me,who);
	biaoqi=new("/d/baobiao/obj/biaoqi");
	biaoqi->move(who);
	biaoqi->set("owner_id",who->query("id"));
	
	destruct(me);
	return 1;
	
}
void unconcious ()
{
  object ob = query_temp("last_damage_from");

  if(!ob->query("baobiao/去夺镖旗"))
      {
      	::unconcious();
      	return;
}
  if(ob->query("baobiao/夺回镖旗"))
    {
    	 ::unconcious();
    	 return;
    	}
  die ();
}