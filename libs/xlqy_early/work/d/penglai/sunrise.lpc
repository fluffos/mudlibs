inherit ROOM;
#include <room.h>
#include <ansi.h>
#include <localtime.h>
int check_date();
void create ()
{
  set ("short", "观日岩");
  set ("long", @LONG

只见一块平坦的巨石向前突出，形成一块三面凌空的危岩，游人多在这里
观看日出。向四外看白云似海，在你的脚下流淌，云海茫茫中隐约可见一
座座琼楼玉宇。凉风习习，让人心情十分的舒畅。
LONG);
  set("exits", ([ 
  "south" : __DIR__"yashang",
  "northeast" : "/d/12gong/toby1",
]));
  set("outdoors", 1);
  setup();
}
void init()
{
     
}   
int do_watch(string arg)
{
	object who;
	
	who = this_player();
	
	return 1;	
	
	
}
int check_date()
{
	mixed *local;
	int month,day;
	local = localtime(time()*60);
	month = local[LT_MON]+1;
	day = local[LT_MDAY] + (local[LT_HOUR]>23? 1 : 0);
	
	if(month == 3&&day == 21)
		return 1;
	else if(month == 6&&day == 21)
		return 1;
	else if(month == 9&&day == 21)
		return 1;
	else if(month == 12&&day == 21)
		return 1;
	else return 0;
}        
int check_time()
{
	mixed *local;
	int time;
	local = localtime(time()*60);
	time = (local[LT_HOUR]%24)/2;
	return 1;
	
}


