inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "约瑟河畔");
  set("long", @LONG

约瑟河起源于那可那鲁山脉，向南流到沙罗尼亚近郊的绝望之谷，
约瑟河的河水流动缓慢，就像湖泊一样安静，你几乎听不到任何
水流的声音，河岸两边都是青青草地，往南则是一片山陵地带。
LONG);

  set("exits",
    ([
      "north": __DIR__ "sprite_road6",
      "south": __DIR__ "yuese_shanlu1",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
