#include <armor.h>

inherit SHIELD;

void create()
{
        set_name("饭盆", ({ "fan pen","pen","shield" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("material", "iron");
		  set("value", 0);               
                set("armor_prop/armor",1);
        }
        setup();
}


