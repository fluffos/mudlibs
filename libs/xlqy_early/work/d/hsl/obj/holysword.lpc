//holysword.c

#include <weapon.h>
#include <dbase.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit SWORD;

int do_wield(string);
int do_unwield(string);
object offensive_target(object me);

void create()
{
   set_name(HIW"圣剑  希鲁达"NOR, ({"holy sword", "jian", "sword","xiluda"}));
   set_weight(2000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("long", "起初，混乱神卡额斯开天辟地时创造的第一把兵器。\n");
     set("value", 100000000);
     set("material", "silver");
     set("no_sell",1);
 //    set("no_get",1);
     set("no_give",1);
     set("no_zm",1);
     set("no_drop",1);
     set("is_monitored",1);
     set("replace_file", "/d/hsl/obj/jiguangsword.lpc");
   }
   init_sword(100);
   setup();
}

void init()
{
	add_action("do_wield","wield");
       add_action("do_unwield","unwield");
}

int do_wield(string arg)
{
	object me = this_player();
       object sword = this_object();
       string msg;

       if( arg!= "all" && arg!= "holy sword" && arg!="sword" && arg!="jian")
       	return notify_fail("你要装备什么？\n");
       msg = HIW"$N拔出圣剑，刹那间一道眩目的白光冲天而起，光耀整个大地！\n"NOR;
       sword->set("wield_msg",msg);
       remove_call_out("holyswordconditions");
       call_out("holyswordconditions", 5+random(4), me, sword);
       return 0;
}

int do_unwield(string arg)
{
	object me = this_player();
       object sword = this_object();
       string msg;

       if( arg!= "all" && arg!= "holy sword" && arg!="sword" && arg!="jian")
       	return notify_fail("你要卸除什么？\n");
       msg = HIW"$N收回圣剑，圣光消失无形。\n"NOR;
	sword->set("unwield_msg",msg);
       remove_call_out("holyswordconditions");
       return 0;
}

object offensive_target(object me)
{
        int sz;
        object *enemy;
        enemy = me->query_enemy();
        if( !enemy || !arrayp(enemy) ) return 0;
        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;
        if( sz > 0 ) return enemy[random(sz)];
        else return 0;
}


void holyswordconditions(object who, object ob)
{
	object target;
       int myexp, tarexp;
       string msg;
       target = offensive_target(who);

       if( who ->is_fighting() && target)
       {
             if(!target)  return;
             if(! present( target, environment(who)))
             		return;
             myexp = (int)who->query("combat_exp") + (int)who->query("daoxing");
             tarexp = (int)target->query("combat_exp") + (int)target->query("daoxing");

             if(random(myexp) >random(tarexp))
             		return;
             if(!random(6) )
             {
              	who->set("eff_kee",who->query("max_kee"));
              	who->set("eff_sen",who->query("max_sen"));
              	who->set("kee",who->query("max_kee"));
              	who->set("sen",who->query("max_sen"));
              	if(!who->is_busy())
              		who->start_busy(1+random(2));
              	msg = HIW"圣剑  希鲁达忽然发出万千华光笼罩着$N，$N的状态完全恢复了！\n"NOR;
             		message_vision(msg ,who);
              }
        }
        call_out("holyswordconditions",4+random(5),who,ob);
}
         





