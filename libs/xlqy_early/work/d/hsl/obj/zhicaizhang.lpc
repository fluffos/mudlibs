//zhicai zhang.c

#include <weapon.h>
#include <ansi.h>
inherit STAFF;
inherit F_UNIQUE;

void create() {
  set_name(HIR "制裁者之杖" NOR, ({ "zhicai zhang", "staff", "zhang" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "一根拥有强大魔力的法杖。\n");
    set("value", 100000000);
    set("no_sell", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_zm", 1);
    set("material", "silver");
    set("wield_msg", HIR "$N拿出一根制裁者之杖握在手中，一股强大的神秘威慑力充斥四周。\n" NOR);
    set("unwield_msg", HIR "$N放下手中的制裁者之杖，空气一下缓和了起来。\n" NOR);
    set("weapon_prop/spells", 50);
    set("is_monitored", 1);
    set("replace_file", "/d/hsl/obj/shenglingzhang.lpc");
  }
  init_staff(100);
  setup();

}
