//guarderstaff.c
//一般玩家无法拿到

#include <weapon.h>
#include <ansi.h>
inherit STAFF;

void create()
{
   set_name(HIC"守护者之杖"NOR, ({"guarder staff", "staff", "zhang"}));
   set_weight(5000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "根");
     set("long", "妖精族长老赠与雪拉的法杖。\n");
     set("value", 100000000);
     set("no_sell",1);
     set("no_get",1);
     set("no_drop",1);
     set("no_zm",1);
     set("material", "silver");
     set("wield_msg", HIC"$N拿出一根充满神奇魔力的法杖握在手中，霎时周身魔光护体。\n"NOR);
     set("unwield_msg", HIC"$N放下手中的守护者之杖，护体魔光渐渐消逝。\n"NOR);
     set("weapon_prop/spells",50);
     set("weapon_prop/armor",50);
     set("weapon_prop/dodge",50);
     set("is_monitored",1);
   }
   init_staff(100);
   setup();
  
}

