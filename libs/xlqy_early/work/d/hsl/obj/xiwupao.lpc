#include <armor.h>

inherit CLOTH;

void create() {
  set_name("夕雾之袍", ({ "xiwu pao", "xiwu", "pao", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 10000);
    set("armor_prop/dodge", 5);
    set("armor_prop/armor", 10);
  }
  setup();
}
