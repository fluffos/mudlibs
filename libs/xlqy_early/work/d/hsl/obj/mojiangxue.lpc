#include <armor.h>

inherit BOOTS;

void create() {
  set_name("魔将之靴", ({ "mojiang xue", "xue", "shoes" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("material", "cloth");
    set("value", 0);
    set("armor_prop/dodge", 6);
    set("armor_prop/spells", 2);
  }
  setup();
}
