//glorysword.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;

void create()
{
   set_name(HIY"辉煌之器"NOR, ({"glory sword", "jian", "sword"}));
   set_weight(15000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("unique", 1);
     set("no_drop",1);
     set("no_get",1);
     set("no_zm",1);
     set("no_sell",1);
     set("no_give",1);
     set("long", "象征着光荣与辉煌的幻世神兵：辉煌之器。\n");
     set("value", 10000000);
     set("material", "iron");
     set("wield_msg", HIY"$N从背后拔出幻世神兵辉煌之器，霎时无上的荣光笼罩周身！\n"NOR);
     set("unwield_msg", HIY"$N将辉煌之器插回背后，荣光顿时消失无形。\n"NOR);
     set("weapon_prop/courage", 10);
     set("weapon_prop/composure",20);
     set("is_monitored",1);
   }
   init_sword(150);
   setup();
  
}

