// chuanyunarrow

#include <weapon.h>

inherit ARCHERY;

void create() {
  set_name("穿云箭", ({ "chuanyun arrow", "arrow", "jian", "chuanyun", "chuanyun jian", }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "琥的随身兵器穿云箭，据说能一直射到天上的云彩中。\n");
    set("unit", "壶");
    set("base_unit", "枝");
    set("base_weight", 20);
    set("base_value", 0);
  }
  set_amount(20);
  init_archery(40);
  setup();
}
