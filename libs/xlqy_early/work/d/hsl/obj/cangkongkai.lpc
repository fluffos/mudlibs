#include <armor.h>

inherit ARMOR;

void create()
{
        set_name("苍空之铠", ({ "cangkong kai","armor","kai","cangkong" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "silver");
		  set("value", 0);               
                set("armor_prop/armor",20);
        }
        setup();
}


