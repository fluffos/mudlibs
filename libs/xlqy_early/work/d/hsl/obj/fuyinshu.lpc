//fuyinshu.c

#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create()
{
        set_name(HIY"福音之书"NOR, ({"fuyin shu", "shu","fuyin"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
    else  {
           set("unit", "本");
           set("unique", 1);
           set("long", "发着神秘的金色光彩的一本旧书。\n");
           set("no_sell", 1);
           set("no_give",1);
           set("no_drop",1);
           set("no_get",1);
        }
    setup();
}



