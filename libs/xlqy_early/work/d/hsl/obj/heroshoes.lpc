//heroshoes.c

#include <armor.h>
#include <ansi.h>

inherit BOOTS;

void create() {
  set_name(HIC "英雄之靴" NOR, ({ "hero shoes", "xue", "shoes" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("material", "cloth");
    set("value", 20000);
    set("no_sell", 1);
    set("armor_prop/dodge", 20);
    set("armor_prop/armor", 10);
  }
  setup();
}
