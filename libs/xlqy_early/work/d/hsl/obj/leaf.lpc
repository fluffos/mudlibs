//leaf.c


#include <ansi.h>

inherit COMBINED_ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
       
    set("no_drop",1);
    set("no_sell",1);
  }
  add_action("do_eat", "eat");
}

void create()
{
  set_name( HIG "世界树之叶" NOR , ({"leaf","shuye"}));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
   set("base_unit","片");
    set("unit", "些");
    set("long", "一片取自奥林匹斯山雅格丽丝世界树的神奇树叶。\n");
    set("value", 400000);
    set("drug_type", "补品");
  }
  set_amount(1);

  setup();
}

int do_eat(string arg)
{
  object me = this_player();
  if (arg!="leaf" && arg!="shuye")	return 0;
  
  if( me->is_busy() ) return notify_fail("你正忙着呢！\n");
  if( me->is_fighting()) return notify_fail("你正在打架，没工夫！\n");

  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));
  me->set("eff_gin", (int)me->query("max_gin"));
  me->set("gin", (int)me->query("max_gin"));
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("mana", (int)me->query("max_mana")*2);
  me->set("force", (int)me->query("max_force")*2);
  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());
  message_vision(HIG "$N将世界树之叶小心翼翼地放入口中，顿时一股来自
神之国度的无上灵气氤氲环绕，$N刹那间全身状态完全饱满！\n" NOR, me);
  add_amount(-1);
  // destruct(this_object());
  return 1;
}


