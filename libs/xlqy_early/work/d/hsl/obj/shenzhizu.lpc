#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("神之足", ({ "shenzhizu","shoes","shoe" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("material", "silver");
		  set("value", 0);               
                set("armor_prop/dodge",5);
                set("armor_prop/spells",5);
        }
        setup();
}


