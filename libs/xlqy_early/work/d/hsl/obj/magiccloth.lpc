//magiccloth.c

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("魔法师之袍", ({ "magic cloth","cloth","pao"}) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
		  set("value", 5000);               
                set("armor_prop/spells", 3);
                set("armor_prop/armor",10);
        }
        setup();
}


