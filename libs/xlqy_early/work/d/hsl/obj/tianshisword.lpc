//tianshisword.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
   set_name("魔剑  天逝", ({"tianshi sword", "jian", "sword","tianshi"}));
   set_weight(5000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("long", "一柄周身暗红色的利剑。\n");
     set("value", 10000);
     set("material", "steel");
     set("wield_msg", "一道暗红色的剑光掠过，只见$N已抽出一柄魔剑握于手中。\n");
     set("unwield_msg", "$N将魔剑插回腰间。\n");
   }
   init_sword(70);
   setup();
  
}

