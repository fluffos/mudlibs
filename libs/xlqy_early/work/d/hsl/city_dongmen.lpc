inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","克莱恩城东门");
  set ("long", @LONG

这里就是克莱恩城的东门，克莱恩城是法鲁西翁大陆上
最大的城市，它有着豪华的建筑、星罗棋布的商店和摩
肩接踵的人流。由于战事紧张，为了防止拉尔斯帝国的
残留勇士混入城内作乱，最近东门只许出城不许入城。
LONG);

  set("exits", 
  ([  
         "west":__DIR__"city_street4",
         "east":__DIR__"republic_road3",
  ]));

  
  set("objects", 
  ([ 
   "/d/hsl/npc/cityguarder" : 2,
  ]));

     
 set("outdoors", "hsl");
 set("no_clean_up", 0);
    
 setup();
 
}

int valid_leave(object me, string dir)
{
        if (dir == "west" ) 
        if (objectp(present("city guarder", environment(me)))) 
                return notify_fail("卫兵喝道：“只许出城，不许入城！”\n");
        return 1;
 }


