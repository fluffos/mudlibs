// 作者：tonii@飘渺水云间，2003-5-3于浙大，修改请保留此行。
// ROOM: /d/hsl/palacesite

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "众神的宫殿遗址");
  set("long", @LONG

在魔神战争以前，这儿是著名的众神的宫殿，宫殿建筑豪华、
风格绮丽，而最为奇特的是宫殿与奥林匹斯山有着某种神秘
的灵之流动，妖精族的人们相信这儿就是众神的一个驿站。
另有传说这儿隐藏着许多远古时代的神兵利器，正是这些神兵
赋予了宫殿神奇的力量。无论往事如何，经历过魔神战争的
大劫难后的宫殿，如今已是陈旧零乱不堪，毫无灵气可言。
经上说：不是神背弃了人，而是人背弃了神。今日，虔诚如你，
还应不应该在这儿继续昨日未完的祈祷(pray)呢？

LONG);

  set("exits",
    ([
      "out": __DIR__ "sprite_path4",
    ]));


  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_pray", "pray");
}

int do_pray() {
  object me, yilina, weapon;
  me = this_player();
  if (objectp(present("yilina", environment(me))))
    return notify_fail("女神不就在你面前吗？还祈祷什么！\n");
  if (me->query_temp("pray"))
    return notify_fail("你必须歇会儿才好集中精神祈祷！\n");
  if (me->query("mana") < 2500)
    return notify_fail("你的法力太低，无法与天界相通信息！\n");
  message_vision(HIC "$N双手置于胸前，默默地祈祷神灵出现…………\n" NOR, me);
  me->set_temp("pray", 1);
  call_out("deletepray", 5, me);
  me->add("mana", -random(1000));
  if (random(me->query("spi") + 10) < 20)
    return notify_fail("你祈祷了半天，结果没有任何反应！\n");
  if (me->query("family/family_name") != "幻世魔导" && random(2) == 1)
    return notify_fail("你祈祷了半天，结果没有任何反应！\n");
  yilina = new("/d/hsl/npc/master/yilina");
  yilina->move(environment(me));
  message_vision(HIW "一道圣洁的白光一闪，$N的面前出现了一位美丽而忧伤的女神！\n" NOR, me);
  weapon = yilina->query_temp("weapon");
  if (weapon->query("id") == "zhicai zhang" && me->query("family/family_name") == "幻世魔导"
    && random(me->query("kar") + 10) > 20)
    call_out("givezhang", 3, yilina, me, weapon);
  return 1;
}

int deletepray(object me) {
  me->delete_temp("pray");
  return 1;
}

int givezhang(object yilina, object me, object weapon) {
  object weapon2;
  yilina->command("say 既然我们有缘，这根法杖就赠与" + RANK_D->query_respect(me) + "吧！
望你能时刻体察神之旨意，代神实行赏罚！\n");
  message_vision("伊丽娜拿出一根充满强大魔力的" + HIR "制裁者之杖" NOR + "给了$N\n", me);
  weapon->move(me);
  weapon2 = new("/d/hsl/obj/shenglingzhang");
  weapon2->move(yilina);
  yilina->command("wield all");
  return 1;
}
