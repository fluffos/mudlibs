inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","墓内密室");
  set ("long", @LONG

墓中一个小小的石室，却是那种一直窒息着你的诅咒力量之来源，
但这种力量似乎并不是石室本身散发的，而是…………
LONG);

  set("exits", 
  ([  
         "southwest": __DIR__"jiluo_tomb2",
  ]));
      
set("no_clean_up", 0);
    
setup();
 
}

void init() {
  object* blade;
  object darkblade;
  if (present("darkblade",this_object())) return;
  blade=children(__DIR__"obj/darkblade");

  if (sizeof(blade)>1) return;
  darkblade=new(__DIR__"obj/darkblade");
  darkblade->move(this_object());
}






