inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "大路");
  set("long", @LONG

一条东西向延伸的大官道，路面宽广整洁，来往的人却并不多。往西
是人迹罕至的范特希雪山，道路已经逐渐变得狭窄起来。
LONG);

  set("exits",
    ([
      "east": __DIR__ "eroad1",
      "west": __DIR__ "epath1",
    ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
