inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "龙之息火山北麓");
  set("long", @LONG

这儿就是人迹罕至的龙之息火山北麓，从山脚往上望去，火山
并不高，但却充满神秘的气息，谁也不知道上去后将会有什么
样的命运等待着你。有一块方正的石头上好像歪歪扭扭地刻着
几个字（words），吸引着你凑过去看一看。
LONG);

  set("item_desc",
    ([
      "words": "火山中有可怕的" + HIR "红" NOR + HIB "蓝" NOR + HIG "绿" NOR + MAG "紫" NOR + "龙，大家当心！\n       ——一个有幸捡回条命的探险者。\n",
    ]));

  set("exits",
    ([
      "north": __DIR__ "seashore",
      "southup": __DIR__ "volcano2",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
