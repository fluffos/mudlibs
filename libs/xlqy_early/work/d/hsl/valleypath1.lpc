inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "入谷小径");
  set("long", @LONG

这是通往回音之谷的山间小径，它的另一端连接利鲁玛山地的
中心地带。一路流水淙淙、莺歌燕舞，景色相当迷人。
LONG);

  set("exits",
    ([
      "west": __DIR__ "echovalley",
      "south": __DIR__ "liluma_mountain6",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
