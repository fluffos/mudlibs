// 作者：tonii@飘渺水云间，2003-5-2于浙大，修改请保留此行。
// ROOM: /d/hsl/liluma_cliff

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "高崖");
  set("long", @LONG

一个向外突兀的悬崖，风呼呼地吹得人摇摇欲坠。如果再往下一
望，整个人似乎足不沾地，令你立刻两脚发软，头晕眼花。据说
500年前曾有个妖精失恋后在此跳崖，结果在半空中被一位超帅
的翼人GG相救，最后两人厮守了一生。又传说此后在此跳崖的最
后都没死，而且得到了永恒的爱情。不过，你可千万别试哦！！
LONG);

  set("exits",
    ([
      "west": __DIR__ "liluma_mountain5",
    ]));

  set("objects",
    ([
      "/d/hsl/npc/master/leite": 1,
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}

init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object me;
  string msg;
  me = this_player();
  if (!arg || (arg != "cliff" && arg != "悬崖" && arg != "xuanya" && arg != "高崖" && arg != "gaoya" && arg != "down"))
    return notify_fail("你要往哪儿跳？\n");
  if (me->query("gender") == "男性")
    msg = HIC "$N固执地以为山崖下面有个PPMM正等着呢，就义无返顾地跳了下去！\n\n" NOR;
  else
    msg = HIM "$N固执地以为山崖下面有个SSGG正等着呢，就义无返顾地跳了下去！\n\n" NOR;
  message_vision(msg, me);
  tell_object(me, HIR "天底下哪会真的有这等好事？于是傻乎乎的你活活摔死了！\n\n" NOR);
  message_vision("$N死了。\n", me);
  call_out("joke", 3, me);
  return 1;
}

int joke(object me) {
  tell_object(me, HIW "开个玩笑: )不过还是提醒你千万别再拿自己的生命冒险了！\n" NOR);
  return 1;
}
