// ROOM: /d/hsl/shanding.c

inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "范特希雪山山顶");
  set("long", @LONG

这儿是范特希雪山的山顶，极寒的狂风夹杂着雪粒子咆哮着。从
这儿往远处望去，白云尽在脚底，使人不由平生了几分豪情壮志。
LONG);

  set("exits",
    ([
      "eastdown": __DIR__ "epathup3",
      "westdown": __DIR__ "wpathup3",
    ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
