// ROOM: /d/hsl/sprite_road6

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "草原大道");
  set("long", @LONG

一条笔直而干净的大道，经常有人类或是妖精的马车驶过。
路的两旁是一望无际的大草原，沿着这条大道往南可以到达
约瑟河畔。
LONG);

  set("exits",
    ([
      "north": __DIR__ "sprite_road5",
      "south": __DIR__ "yuese_riverside",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);

}
