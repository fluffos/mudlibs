inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "草原大道");
  set("long", @LONG

一条笔直而干净的大道，经常有人类或是妖精的马车驶过。
往西不远处，连绵起伏的大片绿色山林，就是妖精族的聚居
地亚雷比斯，
LONG);

  set("exits",
    ([
      "east": __DIR__ "sprite_road2",
      "west": __DIR__ "sprite_path1",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
