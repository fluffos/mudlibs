void create() {
  set("short", "泥泞小路");
  set("long", @LONG

这是通往两栖部落的小路，由于常年降水以及湿度很大的空气
条件，这儿的路都是泥泞不堪，走得时候必须小心翼翼，以防
泥水溅到鞋上。
LONG);

  set("exits",
    ([
      "north": __DIR__ "island_path1",
      "south": __DIR__ "liangqi_street1",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

