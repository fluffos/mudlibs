inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "利鲁玛山地北部");
  set("long", @LONG

利鲁玛山地是一片绵延几百里的大山脉，这儿是利马鲁山地的
北部。从这儿往北，就是回音之谷，谷中有法鲁西翁大陆上最
著名的瀑布尼布鲁瀑布。往南则是几乎找不到道路的大片大片
的山林。
LONG);

  set("exits",
    ([
      "north": __DIR__ "valleypath1",
      "southup": __DIR__ "liluma_mountain5",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);

}
