// ROOM: /d/hsl/volcano_inner

inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","悬崖间");
  set ("long", @LONG

在悬崖间居然有这样一块巨石，石上正好能够站立一个人。而在
齐额高的地方，插有一柄全身没入山崖之中的巨剑，只露出剑柄，
虽然剑身已不可见，但其散发出的一种无上辉煌与荣耀的力量吸
引着你一定要将它拔（ba）出来!
LONG);

  set("exits", 
  ([  
  	  "down" : __DIR__"volcano_inner",
  ]));

       
  set("outdoors", "hsl");
  set("no_clean_up", 0);
    
 setup();

}

void init(object me)
{
       add_action("do_ba","ba");

}

int do_ba(string arg)
{
	object me, sword;
       object* glorysword;
	me = this_player();
       if ( !arg||(arg != "sword"&&arg != "jian"&&arg != "巨剑"&&arg !="剑"&&arg!="辉煌之器"&&arg!="glory sword")) 
              return notify_fail("你要拔什么？\n");
	if(me->is_busy())
		return notify_fail("你正忙着呢！\n");

       message_vision(HIC"$N猛吸一口气，用尽全身力量想把剑拔出来！\n"NOR, me);
	
       glorysword = children(__DIR__"obj/glorysword");
       if( sizeof(glorysword) >1 )
             return notify_fail(YEL"你用力过猛，差点栽了一跤！\n原来剑已被人拔去，只剩剑的幻魂在此，显现出剑的形状！\n"NOR);
	if( me->query_str()<110  || random(me->query_kar())<20)
       {
             message_vision(YEL"$N用了吃奶的劲还是没能把剑拔下来！\n"NOR, me);
             me->start_busy(3);
        }     
       else {
             message_vision(HIY" $N大喝一声，把剑拔了下来，顿时无上的荣光笼罩全身！\n"NOR, me);
             sword = new (__DIR__"obj/glorysword");
             sword->move(me);
        }
       return 1;
} 


