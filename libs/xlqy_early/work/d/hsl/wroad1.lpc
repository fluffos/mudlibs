inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "大路");
  set("long", @LONG

一条东西向延伸的大官道，路面宽广整洁，来往的人却并不多。往东
通往一个未知的神秘世界，往西就是人迹罕至的范特希雪山。
LONG);

  set("exits",
    ([
      "west": __DIR__ "hsl_start",
      "east": __DIR__ "wroad2",
    ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
