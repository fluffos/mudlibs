inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name(HIW "阿阿" NOR, ({ "npc tonii", "tonii" }));
  set("long", "幻世大陆的缔造者，飘渺水云间的小混混阿阿。\n");
  set("title", HIC "创 世 者 " NOR);
  set("rank_info/respect", "先生");
  set("gender", "男性");
  set("age", 25);
  set("attitude", "peaceful");
  set("per", 99);
  set("looking", "长得真是帅呆了！酷毙了！");
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("combat_exp", 25000);
  set("daoxing", 25000);
  set_skill("literate", 200);
  set_skill("talk", 200);
  map_skill("literate", "talk");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: command("perform huche") :),
  }));

  set("inquiry", ([
    "name": "我叫阿阿，第一个阿是阿阿的阿，第二个阿还是阿阿的阿",
    "here": "这儿就是幻世大陆——法鲁西翁大陆。",
  ]));


  setup();

  carry_object("/d/hsl/obj/fanpen")->wear();
  carry_object("/d/hsl/obj/fanshao")->wield();
}
