#include <ansi.h>

inherit NPC;

void create()
{
  set_name("酒客", ({ "jiu ke" }) );
  set("gender", "男性");
  set("long","正在酒店中一边喝酒一边畅谈的顾客。\n");
  set("age", 20+random(40));
  set("per",10+random(20));
  set("combat_exp", 1000);
  set("attitude", "peaceful");
  set("max_kee", 200);
  set("max_gin", 200);

  setup();

  carry_object("/obj/cloth")->wear();
  
}



