//cityarmorshop_boss.c

inherit F_VENDOR_SALE;

void create()
{
        reload("cityarmorshop_boss");
        set_name("凯文", ({"boss kaiwen", "boss","kaiwen"}));
        set("title", "防具店老板");
        set("gender", "男性");
        set("age", 30);
        set("long", "克莱恩城防具店的老板。");
        set("combat_exp", 10000);
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_skill("parry", 50);

        set("vendor_goods", ([
                "magiccloth":"/d/hsl/obj/magiccloth.lpc",
                "fighterarmor":"/d/hsl/obj/fighterarmor.lpc",
        ]) );

        setup();
        carry_object("/d/obj/cloth/choupao")->wear();

}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
		call_out("greeting",1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say( name()+"抱歉地说：“小店的货几乎被抢购一空，没几样了！\n真不好意思，我们很快会进新货的！”\n");
                        break;
        }
}


