// hu.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void re_rank(object);

void create() {
  set_name("琥", ({ "hu" }));
  set("long", "拥有敏锐观察力的一流神射手琥，他是雷欧纳德的铁杆兄弟。\n");
  set("title", HIB "神 射 手" NOR);
  set("rank_info/respect", "英雄");
  set("gender", "男性");
  set("age", 25);
  set("class", "hsl_might");
  set("attitude", "heroism");
  set("per", 30);
  set("looking", "有着人类的外貌，却长着兽人强健野蛮的身躯，\n眼光掠过，如同闪电般凌厉。");
  set("max_kee", 2500);
  set("max_sen", 1500);
  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 150);
  set("max_mana", 1500);
  set("mana", 1500);
  set("mana_factor", 76);
  set("combat_exp", 2000000);
  set("daoxing", 500000);
  set_skill("literate", 100);
  set_skill("unarmed", 150);
  set_skill("dodge", 180);
  set_skill("parry", 160);
  set_skill("archery", 200);
  set_skill("spells", 100);
  set_skill("windspells", 100);
  set_skill("starforce", 200);
  set_skill("force", 200);
  set_skill("xukong-steps", 150);
  map_skill("spells", "windspells");
  map_skill("force", "starforce");
  map_skill("dodge", "xukong-steps");
  set("inquiry", ([
    "name": "我就是琥，找我有什么事？",
    "here": "这儿是皇家骑士团的休息室。",
    "雷欧纳德": "雷是我的好兄弟。",
  ]));


  create_family("幻世勇者", 1, "弟子");
  setup();

  carry_object("/d/hsl/obj/shiyantoujin")->wear();
  carry_object("/d/hsl/obj/chuanyunarrow")->wield();
}

void attempt_apprentice(object ob) {
  command("say 我目前不收徒，这位" + RANK_D->query_respect(ob) + "还是去另拜高明吧！\n");
  return;
}
