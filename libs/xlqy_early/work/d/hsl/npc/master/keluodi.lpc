// keluodi.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void re_rank(object);
string ask_mieyao();
string ask_for_leave();

void create() {
  set_name("克罗蒂", ({ "keluodi" }));
  set("long", "克罗蒂原先是妖精王手下的四魔将之一，后来在萨鲁司海岸一役中加入了缇娜一行，\n她是一位兼具剑法和魔法的优秀魔剑士。\n");
  set("title", HIR "四魔将之一" NOR);
  set("rank_info/respect", "女英雄");
  set("gender", "女性");
  set("age", 20);
  set("class", "hsl_magic");
  set("attitude", "heroism");
  set("per", 25);
  set("looking", "有着女性少有的坚强果敢的气质，一张秀气的脸上写满了自信与勇气。");
  set("max_kee", 2500);
  set("max_sen", 2000);
  set("force", 2600);
  set("max_force", 2600);
  set("force_factor", 130);
  set("max_mana", 2100);
  set("mana", 2100);
  set("mana_factor", 106);
  set("combat_exp", 2500000);
  set("daoxing", 1000000);
  set_skill("literate", 100);
  set_skill("unarmed", 120);
  set_skill("dodge", 150);
  set_skill("parry", 200);
  set_skill("sword", 200);
  set_skill("darksword", 200);
  set_skill("spells", 140);
  set_skill("wanxi-spells", 140);
  set_skill("wanxi-force", 180);
  set_skill("force", 160);
  set_skill("charmingdance", 150);
  set_skill("shenfa-quan", 120);
  map_skill("unarmed", "shenfa-quan");
  map_skill("spells", "wanxi-spells");
  map_skill("force", "wanxi-force");
  map_skill("parry", "darksword");
  map_skill("dodge", "charmingdance");
  map_skill("sword", "darksword");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: command("perform xuhuang") :),
    (: command("perform huaqi") :),
    (: command("perform shihun") :),
  }));
  set("inquiry", ([
    "name": "你好，我是克罗蒂，找我有什么事？",
    "here": "这儿是黄昏之丘。",
    "神谕": (: ask_mieyao :),
    "leave": (: ask_for_leave :),
  ]));


  create_family("幻世魔导", 1, "弟子");
  setup();

  carry_object("/d/hsl/obj/mojiangxue")->wear();
  carry_object("/d/hsl/obj/tianshisword")->wield();
}

void init() {
  //add_action("do_kneel","kneel");
  add_action("do_agree", "agree");
}

void attempt_apprentice(object ob) {
  ob = this_player();
  if (ob->query("gender") == "男性") {
    command("say 这位" + RANK_D->query_respect(ob) + "，幻世魔导不收男弟子，你还是去拜雷欧纳德他们吧！\n");
    return;
  }
  if (ob->query("int") + ob->query("spi") <= 45 && ob->query("family/family_name") != "幻世魔导") {
    command("say 以这位" + RANK_D->query_respect(ob) + "的资质，不适合入我魔导之门，请回吧！\n");
    return;
  }
  command("smile");
  command("say 很好，今天开始" + RANK_D->query_respect(ob) + "你就跟着我学习吧。");
  command("recruit " + ob->query("id"));
  re_rank(ob);
  ob->save();
  return;
}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "hsl");
}

void re_rank(object ob) {
  int exp;
  exp = (int)ob->query("daoxing");
  if (exp < 300000) {
    ob->set("title", "女 剑 士 ");
    return;
  } else if (exp < 1000000) {
    ob->set("title", "灵 剑 师 ");
    return;
  } else {
    ob->set("title", HIR "圣 灵 剑 使 " NOR);
    return;
  }
}

string ask_mieyao() {
  object who = this_player();

  if ((string)who->query("family/family_name") == "幻世魔导") {
    command("smile " + who->query("id"));
    return "/d/obj/mieyao"->query_yao(who);
  }
  return ("非我门人,何故来此?\n");
}

string ask_for_leave() {
  object me = this_player();

  if (me->query("family/family_name") == "幻世魔导") {
    command("say 要走的终归要走，我不会留你，但是有点要说明：");
    me->set_temp("betray", 1);
    return ("脱离师门要需要有一定惩罚，你可愿意(agree)？");
  }

  return ("你问我干嘛？\n");
}

int do_agree(string arg) {
  if (this_player()->query_temp("betray")) {
    message_vision("$N答道：弟子愿意。\n\n", this_player());
    command("say 你走吧，自己保重！");
    this_player()->add("betray/count", 1);
    this_player()->add("betray/hsl_magic", 1);
    this_player()->set("combat_exp", this_player()->query("combat_exp") * 80 / 100);
    this_player()->set("daoxing", this_player()->query("daoxing") * 80 / 100);
    if (this_player()->query_skill("sanchen-staff")) {
      this_player()->delete_skill("sanchen-staff");
      this_player()->map_skill("staff");
    }

    if (this_player()->query_skill("wanxi-spells")) {
      this_player()->delete_skill("wanxi-spells");
      this_player()->map_skill("spells");
    }

    this_player()->delete("family");
    this_player()->delete("class");
    this_player()->delete("faith");
    this_player()->set("title", "普通百姓");
    this_player()->set_temp("betray", 0);
    this_player()->save();
    command("say 江湖风波，善恶无形，好自为之。。。\n");
    return 1;
  }
}
