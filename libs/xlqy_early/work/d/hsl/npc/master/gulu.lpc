// gulu.c

inherit NPC;
#include <ansi.h>

void create() {
  set_name("咕噜", ({ "gulu" }));
  set("long", "生活在沼泽中的变种生物咕噜，因为雷欧纳德搭救了它，便加入了雷的一行。\n");
  set("title", HIG "变种魔物 " NOR);
  set("rank_info/respect", "魔神");
  set("gender", "男性");
  set("age", 110);
  set("attitude", "heroism");
  set("looking", "是个长着两个大钳子，浑身绿色的球状怪物。
据说它使用的武功是充满玄机与奥义的神罚拳（shenfa-quan）。");
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 50);
  set("max_mana", 500);
  set("mana", 500);
  set("mana_factor", 25);
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("shenfa-quan", 220);
  set_skill("spells", 100);
  set_skill("force", 200);
  map_skill("unarmed", "shenfa-quan");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: command("perform shencai") :),
  }));
  set("inquiry", ([
    "name": "咕噜～～咕噜～～",
    "here": "咕噜～～咕噜～～",
  ]));
  setup();
}


int recognize_apprentice() {
  string familyname = this_player()->query("family/family_name");
  if (familyname != "幻世魔导" && familyname != "幻世勇者")
    return notify_fail("咕噜“咕噜～咕噜”叫了几声，摇晃了几下身子，似乎不愿意教你！\n");
  return 1;
}
