// hao.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void re_rank( object );

void create()
{
       set_name("嚎", ({"hao"}));
       set("long", "勇猛无比的兽人族英雄嚎\n");
       set("title", HIR"兽 神 "NOR);
       set("rank_info/respect", "英雄");
       set("gender", "男性");
       set("age", 25);
	set("class", "hsl_might");
       set("attitude", "heroism");
       set("per", 30);
	set("looking", "长着一张野兽的脸，极端凶神恶煞，\n身材亦异常高大威猛，似乎普通刀枪都难以对它造成伤害。");
       set("max_kee", 4000);
       set("max_sen", 1500);
       set("force", 2700);
       set("max_force", 2700);
       set("force_factor", 135);
       set("max_mana", 1200);
       set("mana", 1200);
       set("mana_factor", 61);
       set("combat_exp", 2500000);
       set("daoxing", 400000);
		set_skill("literate", 60);
		set_skill("unarmed",180);
		set_skill("dodge", 150);
		set_skill("parry", 180);
		set_skill("axe", 200);
		set_skill("ghostaxe", 200);
		set_skill("spells", 80);
		set_skill("windspells", 80);
		set_skill("starforce", 180);
		set_skill("force", 180);
		set_skill("xukong-steps", 120);
      set_skill("shenfa-quan", 180);
       map_skill("unarmed", "shenfa-quan");
	map_skill("spells", "windspells");
	map_skill("force", "starforce");
	map_skill("parry", "ghostaxe");
	map_skill("dodge", "xukong-steps");
	map_skill("axe", "ghostaxe");
	set("chat_chance_combat", 60);
       set("chat_msg_combat", ({
		(: command("perform destroy") :),
		(: command("perform roar") :),
        }) );
       set("inquiry", ([
	"name": "我就是嚎，找我有什么事？",
	"here": "你自己看看就知道了。",
	]));


create_family("幻世勇者", 1, "弟子");
setup();

        carry_object("/d/hsl/obj/cangkongkai")->wear();
        carry_object("/d/hsl/obj/shengyanaxe")->wield();
}

void attempt_apprentice(object ob)
{	ob=this_player();
       if( ob->query("gender") == "女性"){
             command("say 这位" + RANK_D->query_respect(ob) +"，幻世勇者不收女弟子，你还是去拜缇娜她们吧！\n");
             return;
       }
       if( ob->query("str") < 25 && ob->query("family/family_name")!="幻世勇者"){
             command("say 这位" + RANK_D->query_respect(ob) +"力量太小，不宜跟我学功夫，你另投其他门派吧！\n");
             return;
       }
	command("smile");
       command("say 很好，今天开始" + RANK_D->query_respect(ob) + "你就跟着我学吧。");
       command("recruit " + ob->query("id") );
       re_rank(ob);
       ob->save();
	return;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "hsl");
}

void re_rank(object ob)
{
      int exp; 
      exp = (int)ob->query("combat_exp"); 
      if( exp < 300000 ) { 
           ob->set("title","冲 锋 者 "); 
           return ; 
      }
      else if ( exp < 1000000 ) {
           ob->set("title","狂 战 士 ");
           return;
      }
      else {
           ob->set("title",HIR"神 勇 战 将 "NOR);
           return;
      }
}




