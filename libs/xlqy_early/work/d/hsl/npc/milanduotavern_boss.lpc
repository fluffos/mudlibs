// milanduotavern_boss.c

inherit F_VENDOR_SALE;

void create()
{
       reload("milanduotavern_boss");
       set_name("李飞白", ({"boss li", "boss","li"}));
       set("long", "酒馆的老板，他原是大唐御厨，后不知什么原因来到这个西方的国度。\n");
       set("gender", "男性");
	set("title", "酒馆老板");
	set("combat_exp", 5000);
       set("age", 45);
       set("attitude", "friendly");
       set_skill("unarmed", 40);
        set("vendor_goods", ([
                "jiudai": "/d/ourhome/obj/hdjiudai",
                "gourou": "/d/ourhome/obj/gourou",
                "jitui": "/d/ourhome/obj/jitui",
		"huasheng": "/d/ourhome/obj/huasheng",
        ]) );

	setup();
       add_money("silver", 2);
       carry_object("/d/obj/cloth/choupao")->wear();

}
void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(1) ) {
                case 0:
                        say( name()+"笑咪咪地说道：这位" +
RANK_D->query_respect(ob)
                                + "，进来喝两盅吧。\n");
                        break;
	}
}

