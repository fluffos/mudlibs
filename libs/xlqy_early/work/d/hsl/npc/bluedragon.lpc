//bluedragon.c

inherit NPC;
#include <ansi.h>

void create()
{
        set_name(HIB"蓝 龙 "NOR, ({ "green dragon", "dragon" }) );
        set("family/family_name","幻世魔导");
        set("race", "野兽");
        set("gender", "雄性");
        set("age", 2000);
        set("long", 
"这是一条来自海底最深处的巨龙\n");
        
        set("str", 40);
        set("max_kee", 2000);
        set("max_sen", 2000);
        set("max_mana",2000);
        set("mana",3000);
        set("mana_factor",100);
        set("max_force",2000);
        set("force",2000);
        set("force_factor",50);
        set_skill("unarmed",300);
        set_skill("dodge",300);
        set_skill("parry",300);
        set_skill("spells",150);
        set_skill("wanxi-spells",150);
        map_skill("spells","wanxi-spells");
        set("attitude", "aggressive");
        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );
        set("chat_chance_combat", random(50));
        set("chat_msg_combat", ({
        (: command( "cast water") :)
        }) );

        set("combat_exp", 500000+random(500000));
        set("daoxing",500000+random(500000));

        setup();
}



