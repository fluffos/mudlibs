// yuannian_bosy.c

inherit NPC;

void create() {
  set_name("怨念集合体", ({ "yuannian body", "body", "yuannian" }));
  set("gender", "不明");
  set("age", random(20) + 20);
  set("str", 30);
  set("long", "万千怨念与诅咒的意志集合体。\n");
  set("class", "youling");
  set("family/family_name", "阎罗地府");
  set("combat_exp", 4500000);
  set("daoxing", 4500000);
  set("attitude", "heroism");
  set_skill("unarmed", 350);
  set_skill("jinghun-zhang", 250);
  set_skill("force", 350);
  set_skill("tonsillit", 250);
  set_skill("dodge", 350);
  set_skill("ghost-steps", 250);
  set_skill("parry", 350);
  set_skill("spells", 350);
  set_skill("gouhunshu", 250);
  map_skill("unarmed", "jinghun-zhang");
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  map_skill("dodge", "ghost-steps");
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("force", 8000);
  set("max_force", 8000);
  set("force_factor", 250);
  set("max_mana", 8000);
  set("mana", 8000);
  set("mana_factor", 250);
  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: command("cast gouhun") :),
    (: command("cast inferno") :),
  }));
  if (random(2))
    set_temp("apply/sub_phy", 8888);
  else set_temp("apply/sub_max_spells_all", 8888);
  setup();
  carry_object("/d/hsl/obj/leaf");
  //      carry_object("/d/hsl/obj/leaf");
}
