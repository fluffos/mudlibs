inherit NPC;
#include <ansi.h>

void create() {
  set_name("克里欧司", ({ "king keliousi", "king", "keliousi" }));
  set("long", "他就是魔神战争时的大英雄克里欧司，现在是沃斯菲塔共和国的元首。\n");
  set("title", HIY "妖 精 王 " NOR);
  set("rank_info/respect", "英雄");
  set("gender", "男性");
  set("age", 550);
  set("attitude", "heroism");
  set("per", 30);
  set("looking", "双目炯炯有神，周身散发着一片令人震慑的盖世英气！");
  set("max_kee", 5000);
  set("max_sen", 5000);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 100);
  set("max_mana", 5000);
  set("mana", 5000);
  set("mana_factor", 100);
  set("combat_exp", 3000000);
  set("daoxing", 5000000);
  set_skill("literate", 200);
  set_skill("unarmed", 200);
  set_skill("dodge", 250);
  set_skill("parry", 250);
  set_skill("staff", 250);
  set_skill("sanchen-staff", 250);
  set_skill("spells", 300);
  set_skill("wanxi-spells", 300);
  set_skill("wanxi-force", 250);
  set_skill("force", 250);
  set_skill("xukong-steps", 250);
  set_skill("shenfa-quan", 200);
  map_skill("unarmed", "shenfa-quan");
  map_skill("spells", "wanxi-spells");
  map_skill("force", "wanxi-force");
  map_skill("dodge", "xukong-steps");
  map_skill("staff", "sanchen-staff");
  map_skill("parry", "sanchen-staff");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: command("perform fengmo") :),
    (: command("cast hufa") :),
    (: command("cast fire") :),
    (: command("cast water") :),
  }));

  set("inquiry", ([
    "name": "我就是克里欧司。",
    "here": "这是我的行政院",
    "雷欧纳德": "这孩子是个人才，可惜不识时务。",
    "缇娜": "哼，亡国公主，有如蝼蚁！",
  ]));


  setup();

  carry_object("/d/hsl/obj/dadipao")->wear();
  carry_object("/d/hsl/obj/shenglingzhang")->wield();
}
