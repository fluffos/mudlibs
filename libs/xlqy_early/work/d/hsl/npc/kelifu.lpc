//kelifu.c

#include <ansi.h>

inherit F_VENDOR_SALE;

void create() {
  set_name("克里夫", ({ "businessman kelifu", "kelifu", "businessman" }));
  set("gender", "男性");
  set("title", "商人");
  set("long", "一名经常奔波于那可那鲁和拉尔斯之间做生意的商人，
他为人精明且贪财，如果你愿意给点钱的话，也许他会把通行证卖给你。\n");
  set("age", 20 + random(40));
  set("per", 10 + random(20));
  set("combat_exp", 1000);
  set("attitude", "peaceful");
  set("max_kee", 200);
  set("max_gin", 200);

  setup();

  carry_object("/obj/cloth")->wear();

}

int accept_object(object who, object ob) {
  int value;
  object pass;
  if (ob->query("money_id") && (value = ob->value()) >= 2000) {
    tell_object(who, name() +
      "嘿嘿一笑，说：看你挺有诚意的份上，我就先把通行证借给你用用吧！\n");
    pass = new("/d/hsl/obj/pass");
    pass->move(who);
    take_money(value, 2000);
    return 1;
  }
  return 0;
}
