// moqishi.c

inherit NPC;

void create()
{
        set_name("魔骑士", ({ "mo qishi", "qishi" }));
        set("gender", "男性");
        set("age", random(20) + 20);
        set("str", 30);
        set("long", "妖精王秘密训练的部队，谁也不知道他们的使命究竟是什么。\n");
        set("combat_exp", 500000);
        set("attitude", "heroism");

        set_skill("unarmed", 200);
        set_skill("force", 200);
        set_skill("sword", 200);
        set_skill("dodge", 200);
        set_skill("parry", 200);
        set_skill("spells",200);
	 set("max_kee", 1200);
	 set("max_sen", 1200);
        set("force", 1000); 
        set("max_force", 1000);
        set("force_factor", 50);
	 set("max_mana", 1000);
	 set("mana", 1000);
	 set("mana_factor", 51);
        setup();
        carry_object("/d/hsl/obj/westsword")->wield();
        carry_object("/d/hsl/obj/fighterarmor")->wear();
}



