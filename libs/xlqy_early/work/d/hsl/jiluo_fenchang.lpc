// ROOM: /d/hsl/jiluo_fenchang

inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","幽暗坟场");
  set ("long", @LONG

这儿是冀罗的坟场，坟场四面被山围住，高大的树木遮挡了阳
光，所以这儿显得幽暗。冀罗的人们死后都会被埋葬在这里，
世世代代已经经历了几千年，据说这儿充满了一种诅咒的力量，
使鬼魂不会收到外界神灵侵害，然而有识之士指出，这种诅咒
的力量来源可能是坟场中隐藏着某种终极神器。话虽可信，然
而谁又敢一个墓碑一个墓碑地搜索（search）呢？
LONG);

  set("exits", 
  ([  
         "south": __DIR__"jiluo_path9",
  ]));

       
 set("outdoors", "hsl");
 set("no_clean_up", 0);
    
 setup();

}

void init()
{
    add_action("do_search","search");
    add_action("do_move", "move");
}

int do_search( string arg )
{
      object me;
      me = this_player();
      if (!arg || (arg!="mubei"&&arg!="墓碑"))
            return notify_fail("你要搜什么？\n");
      if( me->is_busy())
            return notify_fail("你正忙着呢！\n");
      if( me->query_temp("findmubei"))
            return notify_fail("你刚才不是已经找到那个墓碑了吗？不用再搜了！\n");
      message_vision(CYN"胆大的$N看到了一个诡异的墓碑，便仔细对它搜索了一番！\n"NOR, me);
      me->start_busy(3);
      if( random(10)!=1)
           call_out("fail", 3, me);
      else
           call_out("success", 3, me);
      return 1;
}

int do_move( string arg )
{
      object me, tomb;
      me = this_player();
      if (!arg || (arg!="mubei"&&arg!="墓碑"))
            return notify_fail("你要移开什么？\n");
      
      if( !me->query_temp("findmubei"))
             return 0;
  //  me->delete_temp("findmubei");

      if( !(tomb = find_object(__DIR__"jiluo_tomb1")) )
             tomb = load_object(__DIR__"jiluo_tomb1");

      if( tomb = find_object(__DIR__"jiluo_tomb1") ) 
      {
             set("exits/down", __DIR__"jiluo_tomb1");
             message_vision(HIC"$N用力推动墓碑，结果“轰”地一声墓碑自动移开了，露出一个地下入口！\n"NOR, me);
             message("vision", HIC"头顶的墓碑被人从上面推开了……\n"NOR, tomb );
             tomb->set("exits/out", __DIR__"jiluo_fenchang");
	      call_out("close_down", 10);
	}      
      return 1;
}

int fail( object me )
{              
    message_vision(YEL"$N里里外外观察了个仔细，没发现任何可疑之处，却累得腰酸背痛！\n"NOR, me);
    me->add("kee",-(100-me->query_kar()));
    me->add("sen",-(100-me->query_kar()));
    return 1;
}

int success( object me )
{
    tell_object(me, HIC"你突然发觉这个墓碑好像可以移开（move）。\n"NOR);
    me->set_temp("findmubei",1);
    return 1;
}

void close_down()
{
        object tomb;
        message("vision", HIC"墓碑又自动移回原位，掩盖了入口。\n"NOR, this_object() );
        if( tomb = find_object(__DIR__"jiluo_tomb1")) 
        {
              message("vision", HIC"墓碑又自动移回原位，遮盖了头顶的出口。\n"NOR, tomb);
              tomb->delete("exits/out");
        }
        delete("exits/down");
}


