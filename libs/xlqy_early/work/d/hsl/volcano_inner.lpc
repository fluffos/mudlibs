// 作者：tonii@飘渺水云间，2003-4-29于浙大，修改请保留此行。
// ROOM: /d/hsl/volcano_inner

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "龙之息火山内部");
  set("long", @LONG

龙之息火山的内部。到处是悬崖峭壁，道路极度崎岖不平。同时，
这儿有着令人眩晕的高温，而异常干燥的空气也令你口干舌燥、
难以忍受。而最为竦人的是，这里有着若干只凶恶无比的巨龙，
据说它们守卫着一样传说的神器。这个神器究竟在哪？它在那些
怪石嶙峋的山崖间吗？
LONG);

  set("exits",
    ([
      "west": __DIR__ "volcano2",
    ]));

  set("objects",
    ([
      "/d/hsl/npc/reddragon": 1,
      "/d/hsl/npc/greendragon": 1,
      "/d/hsl/npc/bluedragon": 1,
      "/d/hsl/npc/purpledragon": 1,
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}

void init(object me) {
  me = this_player();
  me->set("water", 0);
  message_vision(HIR "炎热干燥的空气使你迅速进入脱水状态！\n" NOR, me);
  add_action("do_climb", "climb");

}

int do_climb(string arg) {
  object me;
  me = this_player();
  if (!arg || (arg != "xuanya" && arg != "cliff" && arg != "悬崖" && arg != "崖" && arg != "山崖"))
    return notify_fail("你要爬哪儿？\n");
  if (me->is_busy())
    return notify_fail("你很忙，爬什么呀！\n");
  if (objectp(present("dragon", environment(me))))
    return notify_fail("你如何敢在凶恶的巨龙眼皮底下爬山崖呢？！\n");

  message_vision(HIC "$N向上一纵，手脚并用抠着山石的缝隙向上爬去……\n" NOR, me);
  me->start_busy(3);

  if ((int)me->query("kee") < 500 || (int)me->query("sen") < 500) {
    call_out("fail", 3, me);
    return 1;
  }

  if ((int)me->query_skill("dodge", 1) + (int)me->query_skill("unarmed", 1) <= 150) {
    call_out("fail", 3, me);
    return 1;
  }

  call_out("success", 3, me);
  return 1;

}

int success(object me) {
  me->move("/d/hsl/volcano_cliff");
  me->receive_damage("kee", 400);
  me->receive_damage("sen", 400);
  message_vision("$N成功地爬到了山崖间的一块巨石上。\n", me);
  return 1;
}

int fail(object me) {

  tell_object(me, "你手上一个不稳，从崖上掉了下来……\n");
  tell_room(environment(me), me->name() + "晃悠悠的从崖上掉了下来。\n", ({ me, me }));
  //   me->unconcious();
  me->start_busy(2);
  return 1;
}
