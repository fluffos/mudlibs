// ROOM: /d/hsl/liluma_mountain

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "利鲁玛山地");
  set("long", @LONG

利鲁玛山地是一片绵延几百里的大山脉，这儿是翼族人的天下。
人类或是妖精来到这片山中，便会觉得万难行走：这儿根本没
有任何道路，只能在树丛、灌木和岩石中披荆斩棘前行；而翼
族人则丝毫不会受此困扰，那一对长在背上的翅膀使得整个蓝
天都成了它们的道路。
LONG);

  set("exits",
    ([
      "northup": __DIR__ "liluma_mountain2",
      "south": __DIR__ "nakenalu_border",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
