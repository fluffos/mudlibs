void create() {
  set("short", "山路");
  set("long", @LONG

一条弯弯曲曲的山路，一头连接大官道，一头则通往白雪皑皑的范特
希雪山，道路虽然有些坡度，但还算好走。
LONG);

  set("exits",
    ([
      "east": __DIR__ "eroad2",
      "west": __DIR__ "epath2",
    ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);
  setup();
}
