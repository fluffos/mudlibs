// 作者：tonii@飘渺水云间，2003-4-29于浙大，修改请保留此行。
// ROOM: /d/hsl/geer_shandao2

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "戈尔山道");
  set("long", @LONG

一条通往自由都市米兰多的山间小道，山道间凉风习习，两旁树木
郁郁葱葱，令人心旷神怡。不过据说近来有盗贼在山道间出没，相
信附近就有它们的巢穴，来往的人可都要小心一些。山道一侧不远
处的山崖下，有一丛特别茂盛的茅草(grass)，不过谁也没去注意
过它。
LONG);

  set("item_desc",
    ([
      "grass": "一丛长得比人还高的茅草，你可以拨（push）开它们看看。\n",
    ]));

  set("exits",
    ([
      "southwest": __DIR__ "milanduo_esub",
      "southeast": __DIR__ "geer_shandao1",
    ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_push", "push");
  add_action("do_zuan", ({ "zuan", "enter" }));
}

int do_push(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "grass") return 0;
  write("你轻轻拨开茅草，发现一个幽深的山洞（hole），山洞里隐隐有灯光闪动！\n");
  me->set_temp("marks/push", 1);
  return 1;
}

int do_zuan(string arg) {
  object me;
  me = this_player();
  if (!me->query_temp("marks/push")) return 0;
  if (arg != "hole") return 0;
  message_vision(HIR "$N明知里面可能有危险，还是壮着胆子进去探个究竟！\n" NOR, me);
  me->move(__DIR__ "cave_zoudao");
  return 1;
}
