// ROOM: /d/hsl/stillforest_start

inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","菲纳斯河畔");
  set ("long", @LONG

菲纳斯河，一条静静流淌千年的长河，它发源于利马鲁山地，
向东南一直流入巴瀚纳海。拉而斯王国的人民就是在这条河
流两旁种植、放牧、建设家园。战争过后的菲纳斯河两畔已
不再像往昔能见到无边的绿色庄稼和成群的牛羊，而是呈现
出一种悲壮的荒凉。
LONG);

  set("exits", 
  ([  
  	"northeast" : __DIR__"desolatecity",
       "southwest": __DIR__"stillforest_end",
  ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);
    
 setup();
 replace_program(ROOM);

}



