inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "洞内走道");
  set("long", @LONG

洞窟内狭长而幽暗的走道，走道的尽头有着昏黄的灯光，似乎还
有人影在晃动，也隐约可以听到嘻笑怒骂的声音。
LONG);

  set("exits",
    ([
      "north": __DIR__ "thiefcave",
      "out": __DIR__ "geer_shandao2",
    ]));

  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);

}
