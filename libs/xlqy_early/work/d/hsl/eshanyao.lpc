inherit ROOM;

#include <ansi.h>

void create ()
{
  set ("short","范特希雪山东山腰");
        set ("long", @LONG

这儿是范特希雪山的山腰，由于地势的增高，温度已经比较低，
周围的树木基本上都是针叶型的耐寒植物，也因为这个缘故，山
上的野兽和毒物并不多，行人所要抗争的主要还是严寒和陡峭的
山势。这儿出现一条西北方向的岔路，沿着水平方向延伸，而向
上攀登的道路更加狭窄和陡峭了，几乎已成垂直之势。
LONG);

        set("exits", 
        ([ 
		"eastdown" : __DIR__"epath4",
              "northwest" : __DIR__"ewpath1",
              "westup": __DIR__"epathup1",
         ]));

       set("outdoors", "hsl");
	set("no_clean_up", 0);
       setup();
}

int valid_leave(object me, string dir)
{
	  me = this_player();
	  if (dir == "westup")
	  {
	  	  me->add("kee",-100);
	  	  tell_object(me, HIW"你攀登着陡峭的山崖，又离山顶近了一步，不过真是累极了！\n\n"NOR);
	  }
	  return 1;
}



