// ROOM: /d/hsl/jiluo_tomb1

inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","墓中通道");
  set ("long", @LONG

这是墓中的一条通道，通向黑咕隆咚的深处，而令人窒息的诅咒
之力量在这儿越发加强，任凭多胆大的人都觉得有些毛骨悚然。
LONG);

  set("exits", 
  ([  
         "north": __DIR__"jiluo_tomb2",
  ]));

 set("no_clean_up", 0);
    
 setup();

}

void init()
{
      add_action("do_move", "move");
}

int do_move( string arg )
{
      object me, outside;
      me = this_player();
      if (!arg || (arg!="mubei"&&arg!="墓碑"))
            return notify_fail("你要移开什么？\n");

    //  me->delete_temp("findmubei");

      if( !(outside = find_object(__DIR__"jiluo_fenchang")) )
             outside = load_object(__DIR__"jiluo_fenchang");

      if( outside = find_object(__DIR__"jiluo_fenchang") ) 
      {
             set("exits/out", __DIR__"jiluo_fenchang");
             message_vision(HIC"$N用力推动头顶的墓碑，结果“轰”地一声墓碑自动移开了，露出一个出口！\n"NOR, me);
             message("vision", HIC"墓碑被人从外面推开了……\n"NOR, outside );
             outside->set("exits/down", __DIR__"jiluo_tomb1");
	      call_out("close_down", 10);
	}      
      return 1;
}

void close_down()
{
        object outside;
        message("vision", HIC"墓碑又自动移回原位，遮盖了头顶的出口。\n"NOR, this_object() );
        if( outside = find_object(__DIR__"jiluo_fenchang")) 
        {
              message("vision", HIC"墓碑又自动移回原位，掩盖了入口。\n"NOR, outside);
              outside->delete("exits/down");
        }
        delete("exits/out");
}


