inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "利鲁玛山间小道");
  set("long", @LONG

难得山间有这样一条称不上是道路的羊肠小径，曲曲折折地向前
延伸。这大约是前赴后继往那可那鲁运送货物的商人们用脚踩出
来的。
LONG);

  set("exits",
    ([
      "northdown": __DIR__ "liluma_mountain6",
      "southdown": __DIR__ "liluma_mountain4",
      "east": __DIR__ "liluma_cliff",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);

}
