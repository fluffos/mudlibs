// ROOM: /d/hsl/volcano2

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "龙之息火山");
  set("long", @LONG

这儿就是萨尔克岛上著名的龙之息火山，山中的空气十分炎热
干燥，就连山上的石头也是热乎乎的，坐久了身上就会长出热
疮来。尤其是东面的火山内部，有一股股异常燥热的空气流涌
出来，情形十分怪异。
LONG);

  set("exits",
    ([
      "northdown": __DIR__ "volcano1",
      "south": __DIR__ "volcano3",
      "east": __DIR__ "volcano_inner",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}

int valid_leave(object me, string dir) {
  int myexp;
  me = this_player();
  myexp = me->query("combat_exp") + me->query("daoxing");
  if (dir == "east" && myexp < 1000000)
    return notify_fail(HIR "火山内部十分危险，以你现在的水平还是不要去送死了！\n" NOR);
  return 1;
}
