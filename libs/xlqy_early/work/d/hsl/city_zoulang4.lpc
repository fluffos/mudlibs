inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","走廊");
  set ("long", @LONG

通往皇宫深处的走廊，两侧的墙内点着通宵不灭的蜡烛，即
使在夜里这儿也光明一片。前面是一间贵宾室。
LONG);

  set("exits", 
  ([  
         "north": __DIR__"city_guibinshi",
         "south":__DIR__"city_zoulang3",
  ]));

  
  set("objects", 
  ([ 
   "/d/hsl/npc/guibinshiguarder" : 2,
  ]));

       
 set("no_clean_up", 0);
    
 setup();

}

int valid_leave(object me, string dir)
{
        if (dir == "north" ) 
        if (objectp(present("guarder", environment(me)))) 
                return notify_fail("卫士喝道：“贵宾室重地，闲杂人等不得入内！”\n");
        return 1;
 }




