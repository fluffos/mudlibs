// flying @ 缥缈水云间

#include <skill.h>
#include <ansi.h>
#include <combat.h>

inherit NPC;
int teach_sui();
int give_ring();
void create() {
  set_name("紫风", ({ "flying" }));
  set("gender", "男性");
  set("title", "");
  set("age", 23);
  set("long", "他斜靠在大石上，边听着动人的箫声边喝着自制的美酒。\n");

  set("attitude", "peaceful");
  set("class", "dragon");
  set("combat_exp", 70000000);
  set("daoxing", 70000000);
  set("kee", 70000);
  set("max_kee", 70000);
  set("sen", 70000);
  set("max_sen", 70000);
  set("force", 60000);
  set("max_force", 30000);
  set("mana", 60000);
  set("max_mana", 30000);
  set("force_factor", 300);
  set("mana_factor", 300);
  set("str", 100);
  set("per", 22);
  set("lg/wuxing", 1);
  set("leidong", 1);
  set("pini", 1);
  set("sui", 1);
  set("family/family_name", "东海龙宫");
  set("inquiry", ([
    "风之翼": (: give_ring :),
    "虽千万人吾往矣": (: teach_sui :),
    "无极渡元": "嗯，这个我可不会，你问我妻子幻儿吧！",
    "五气朝元": "嗯，这个我可不会，你问我妻子幻儿吧！",
    "群疗术": "嗯，这个我可不会，你问我妻子幻儿吧！",
  ]));

  set_skill("spells", 600);
  set_skill("seashentong", 600);
  set_skill("force", 600);
  set_skill("dragonforce", 600);
  set_skill("fork", 600);
  set_skill("fengbo-cha", 600);
  set_skill("dodge", 600);
  set_skill("parry", 600);
  set_skill("dragonstep", 600);
  set_skill("unarmed", 600);
  set_skill("dragonfight", 600);

  map_skill("spells", "seashentong");
  map_skill("force", "dragonforce");
  map_skill("fork", "fengbo-cha");
  map_skill("parry", "fengbo-cha");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  set("skill_level/unarmed", "grandmaster");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "freez" :),
    (: cast_spell, "water" :),
    (: perform_action, "unarmed", "long" :),
    (: perform_action, "unarmed", "pini" :),
    (: exert_function, "zhenshen" :),
    (: exert_function, "wuxing" :)

  }));



  setup();


  carry_object("/d/sea/obj/baipao.lpc")->wear();
  carry_object("/d/sea/obj/shoes.lpc")->wear();


}

void init() {

  ::init();

  add_action("do_qk", ({ "kill", "fight" }));

}
int give_ring() {

  object me = this_player();
  object ring, tempob;
  if (me->query("lg/getring") == 1) {
    message_vision("紫风说道：我好像给过你一枚戒指了吧.\n", me);
    tempob = present("ring", me);
    if (tempob) {
      command("dao");
      message_vision("紫风说道：你不是带在身上吗!\n", me);
      return 1;
    } else {
      message_vision("紫风皱眉道：碎了是吗。。。让我看看。。。\n", me);
      if (!me->query("lg/repaired"))
        me->set("lg/repaired", 1);
      else
        me->add("lg/repaired", 1);
      if (me->query("lg/repaired") < 81) {

        message_vision("紫风说道：还好能修补好，以后小心一点。\n", me);
        ring = new("/d/sea/obj/ring.lpc");
        ring->move(me);
        return 1;
      } else {
        command("sigh");
        message_vision("紫风说道：修不好了。\n", me);
        command("shrug");
        return 1;
      }
    }
  }
  return 0;

}
int do_qk(string arg) {

  string cast_id, cast_name;
  object who = this_player();
  object me = this_object();

  if (!arg) return 0;
  if (sscanf(arg, "%s", cast_id) == 1)
    if (cast_id == "flying" || cast_id == "huaner") {
      me->set("kee", 70000);
      me->set("eff_kee", 70000);
      me->set("sen", 70000);
      me->set("eff_sen", 70000);
      me->set("force", 60000);
      me->set("max_force", 30000);
      me->set("mana", 60000);
      me->set("max_mana", 30000);
      me->fight_ob(who);
      who->fight_ob(me);
      return 0;
    }

}

int teach_sui() {
  object me = this_player();
  object ring, tempob;
  string msg;
  //me->set("ask_end",0);	

  if (this_player()->query("family/family_name") == "东海龙宫") {
    if (me->query("sui") == 1) {
      command("dao");
      message_vision("紫风说道：你不是会了吗？\n", me);
    } else if (me->query("emei/killdragon") != 1)
      command("say 咦,你是怎么进来的？");
    else if (!me->query("lg/getring")) {

      command("say 想不到今日又见故人弟子，也是有缘，我送一枚戒指给你。");
      ring = new("/d/sea/obj/ring.lpc");
      ring->move(me);
      me->set("lg/getring", 1);
    } else if ((me->query("pini") != 1 && (string)me->query("gender") == "男性") || (me->query("fengwu") != 1 && (string)me->query("gender") == "女性"))
      command("say 你基础还不够扎实，我想教你也是有心无力。");
    else if (me->query("betray/count"))
      command("say 我最讨厌薄情寡义之徒，你快滚吧！");
    else if (me->query("divorced"))
      command("say 我最恨负心薄幸之人，快滚！");
    else if ((int)me->query_int() < 40)
      command("say 这门武功最重悟性，你恐怕。。。");
    else if ((int)me->query("faith") < 3600)
      command("say 你对龙宫贡献似乎还不够吧！");
    else if (me->query("skill_level/unarmed") != "grandmaster")
      command("say 你对拳法的领悟尚未达到境界，体会不到虽千万人吾往矣的精髓！");
    else if (me->query("str") < 30 && !me->query("wuming/pass"))  //flying
      command("say 你手无缚鸡之力，实在不适合练这门武功。");
    else if (me->query("cor") < 20 && !me->query("wuming/pass"))
      command("say 若无虽千万人吾往矣的气概，还是不要学的好。");

    else {
      if (random(60) < 13) {
        if (time() - (int)me->query("ask_end") < 3600) {
          command("flop");
          command("say 你怎么就回来了？");
        } else {
          command("say 想不到不问江湖十年，我们龙宫就出了像你这样的后起之秀，真是难得！");
          command("say 【虽千万人吾往矣】乃是重意而不中形，招数朴实却适合以一敌多，你日后细细揣摩，便知此言不虚。");
          me->set("sui", 1);
          me->add("potential", 1000 + random(700));
          me->add("daoxing", 5000 + random(3000));
          me->add("combat_exp", 5000 + random(3000));
          msg = HIM + me->name() + "机缘巧合之下竟学会了" NOR + HIC "「虽千万人吾往矣」" + HIM "，从此武功晋入先天之境。";
          message("channel:chat", HIM "【紫幻小筑】紫风：" + msg + "\n" NOR, users());

        }
      } else {
        if (time() - (int)me->query("ask_end") < 3600) {
          command("flop");
          command("say 你怎么就回来了？");
        } else {
          command("scowl");
          command("say 时机尚未成熟，你下次再来吧！");
          me->set("ask_end", time());
        }
      }
    }

  } else {
    if (me->query("lg/getring") == 1) {
      message_vision("紫风说道：我好像给过你一枚戒指了吧.\n", me);
      tempob = present("ring", me);
      if (tempob) {
        command("dao");
        message_vision("紫风说道：你不是带在身上吗!\n", me);
      } else {
        message_vision("紫风皱眉道：碎了是吗。。。让我看看。。。\n", me);
        if (!me->query("lg/repaired"))
          me->set("lg/repaired", 1);
        else
          me->add("lg/repaired", 1);
        if (me->query("lg/repaired") < 81) {

          message_vision("紫风说道：还好能修补好，以后小心一点。\n", me);
          ring = new("/d/sea/obj/ring.lpc");
          ring->move(me);
        } else {
          command("sigh");
          message_vision("紫风说道：修不好了。\n", me);
          command("shrug");
        }
      }
    } else {
      if (me->query("emei/killdragon") != 1) {
        command("say 咦,你是怎么进来的？");
        return;
      }
      command("hmm");
      command("say 没经掌门同意，我岂能把龙宫绝学传给外人？");
      command("say 不过我们相见就是缘分，我送一枚戒指给你。");
      command("say 你可别小看这枚戒指，其中妙处你日后自知。");
      ring = new("/d/sea/obj/ring.lpc");
      ring->move(me);
      me->set("lg/getring", 1);
    }
  }
  return 1;
}
