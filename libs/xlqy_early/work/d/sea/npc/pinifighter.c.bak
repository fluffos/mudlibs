// flying @ 缥缈水云间

#include <skill.h>
#include <ansi.h>
inherit NPC;

void create()
{
  set_name("龙宫铁卫",({"fighter","pinifighter"}));
  set("gender", "男性");
  set("title", "龙宫");
  set("age", 37);
  set("long", "    \n东海龙王身边的三十六铁卫之一,平时不爱说话,其实论武功乃是罕见的高手。\n");

  set("attitude", "peaceful");
  set("class", "dragon");
  set("combat_exp", 3000000);
  set("daoxing", 3000000);
  set("kee", 7000);
  set("max_kee", 7000);
  set("sen", 7000);
  set("max_sen", 7000);
  set("force", 5000);
  set("max_force", 5000);
  set("mana",5000);
  set("max_mana", 5000);
  set("force_factor", 100);
  set("mana_factor", 150);
  set("str", 50);
  set("leidong",1);
  set("pini",1);
  set("family/family_name","东海龙宫");

  set_skill("spells", 250);
  set_skill("seashentong", 250);
  set_skill("force", 250);
  set_skill("dragonforce", 250);
  set_skill("fork", 250);
  set_skill("fengbo-cha", 250);
  set_skill("dodge", 250);
  set_skill("parry", 250);
  set_skill("dragonstep", 250);
  set_skill("unarmed", 250);
  set_skill("dragonfight", 250);

map_skill("spells", "seashentong");
map_skill("force", "dragonforce");
map_skill("fork", "fengbo-cha");
map_skill("parry", "dragonfight");
map_skill("dodge", "dragonstep");
map_skill("unarmed", "dragonfight");
  set("inquiry", ([
]));
  set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: cast_spell, "freez" :),
                (: cast_spell, "water" :),
                (: perform_action, "unarmed", "long" :),
                (: exert_function, "zhenshen" :),

        }) );



setup();


carry_object("/d/obj/armor/jinjia")->wear();
carry_object("/d/city/npc/obj/shoes.c")->wear();


}


int accept_fight(object who)
{
  object me=this_object();
  who=this_player();

  

  if(who->query("lg/pinifight")==1)
     {
      message_vision("铁卫对$N一抱拳：请!\n", who);
      me->set("kee", 7000);
      me->set("max_kee", 7000);
      me->set("sen", 7000);
      me->set("max_sen", 7000);
      me->set("force", 5000);
      me->set("max_force", 5000);
      me->set("mana", 5000);
      me->set("max_mana", 5000);
      me->fight_ob(who);
      who->fight_ob(me);
      remove_call_out("check_result");
      call_out("check_result", 1, me, who);  
      return 1;
     }
  else
    {
     message_vision("铁卫看了$N一眼,又转过头去.\n", who);
     return 0;
    }
}

int check_result(object me, object who)
{
  int my_max_kee, his_max_kee;
  
  if (! who)  return 1;
  if (environment(who)!=environment(me))  return 1;
  my_max_kee  = me->query("max_kee");
  his_max_kee = who->query("max_kee");

  if (me->is_fighting())
  {
    call_out("check_result",1, me, who);
    return 1;
  }


  if (((int)me->query("kee")*100/(1+my_max_kee)) <= 30 )
  {
   message_vision ("$N哈哈笑道：果然是英雄出少年,在下认输了！\n",me);
   who->set("lg/pinifight",0);
   who->set("lg/piniwin",1);
   message_vision ("$N赶紧躬身道: 前辈承让了！\n",who);
   me->command("haha");
   message_vision ("$N朝敖广一躬身,退下了。\n",me);
   destruct(me);
   return 1;
  }

  if (( (int)who->query("kee")*100/his_max_kee)<=30)
  {
    message_vision ("$N对$n摇头道：可惜可惜,你资质虽好,却疏于练习！\n",me,who);
    message_vision ("$N叹了一声，转身离开了。\n",me);
    //who->command("loser");
    who->set("lg/pinifight",0);
    destruct(me);
    return 1;
  }


  return 1;  
}



