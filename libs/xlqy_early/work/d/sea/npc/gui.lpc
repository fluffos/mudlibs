// changed by flying
inherit NPC;
int give_me(object ob);
int ask_zhu(object me);


void create()
{
       set_name("龟八斗", ({"gui badou", "gui"}));

	set("long","海底的大才子，以才智过人著称，并且会画金龙符。\n");
       	set("gender", "男性");
       	set("age", 56);
        set("title", "军师");
        set("per", 10);
        set("max_kee", 1000);
        set("max_sen",700);
       	set("attitude", "peaceful");
       	set_skill("unarmed",100);
       	set_skill("dodge",100);
        set_skill("parry", 100);
       	set_skill("literate",100);
	set_skill("force", 100);
	set_skill("spells", 100);
        set("combat_exp", 200000);
  set("daoxing", 500000);

	set("force", 400);
	set("force_factor",20);
	set("max_force", 400);
	set("mana", 400);
	set("max_mana", 400);
	set("mana_factor", 20);
	
        set("inquiry", ([
                "金龙符": (: give_me :),
                "fu": (: give_me :),
                "定海珠": (: ask_zhu :),
        ]) );


        setup();
        add_money("silver", 20);
       carry_object("/d/gao/obj/magua")->wear();

}

void init()
{
	::init();
	set("chat_chance", 10);
        set("chat_msg", ({
        "龟八斗自言自语道：定海珠竟被偷了，这。。。这可如何是好？\n",
        "龟八斗长长地叹了口气。\n"
	}));
	
}

int give_me(object ob)
{
        object who, me;
        who=this_player();
        me=this_object();

        if( (string)who->query("family/family_name")!="东海龙宫" ) {
                message_vision("$N斜斜地瞟了$n一眼，说：此不足为外人道也！\n", me, who);
                return 1;
        }
	if ((int)me->query("number") >= 10)
		return notify_fail("龟八斗把手一伸，今天写太多了，明儿个再说吧！\n");

                ob=new("/d/sea/obj/fu");
                ob->move(who);
		me->add("number",1);

		message_vision("$N拿出张符纸来，画出金龙，递给了$n。\n", me, who);
                return 1;
}

int ask_zhu(object me)
{	//object me=this_player();
	command("sigh");
	if(this_player()->query("family/family_name") == "东海龙宫" )
	{message_vision("龟八斗偷偷地看了看四周，又叹了口气！\n", me);
	command("say 我们龙宫的至宝定海珠被偷了！此事如果龙王知晓，只怕。。。");
	command("say 据说有人在背阴巷见到可疑地人，不知。。。");
	this_player()->set("lg/findzhu",1);
	
	}
	else
	{command("kick");
	command("say 你是哪位?");}
	return 1;
}

int accept_object(object me, object ob)
{
  object glove;
  
  if ((string)ob->query("id")!="dinghaizhu") {
    command("say 这是什么？你给我干吗？");
    return 0;
  }
  else {
    if (query_temp("received_zhu")==1) {
      command("thank "+ me->query("id"));
      command("say 多谢了。但这颗恐怕是假的。");
      command("say "+RANK_D->query_respect(me) +"这份善心，在下心领了。");
      add_temp("received_zhu", 1);
      return 0;
    }
    else {
        if(query_temp("received_zhu")<1 || !query_temp("received_zhu")) {
          command("great " + me->query("id"));
          command("say 这位" + RANK_D->query_respect(me) + "！实在太感谢了！");
          command("say 我也没什么可谢的。我年少时游历江湖因缘际会，得到一副银丝手套，可以辟百毒，现在就送给你。");
         add_temp("received_zhu", 1);
         glove=new("/d/sea/obj/shoutao.lpc");
         glove->move(me);
   	  return 1;
        }
        command("say 多谢"+RANK_D->query_respect(me)+"的好意，不过在下已经找回定海珠了。");
        return 0;
    }
  }
}