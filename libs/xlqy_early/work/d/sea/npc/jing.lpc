#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int give_me(object ob);
int find_yao();
int delete_ask(object ob);
int create_pai(object ob);

void create() {
  set_name("鲸无敌", ({ "jing wudi", "jing" }));

  set("long", "身高八丈，膀大腰圆．号称东海第一勇士。
水族需有他发的腰牌才能自由出入于水晶宫中。\n");
  set("gender", "男性");
  set("age", 56);
  set("title", "将军");
  set("per", 10);
  set("str", 35);
  set("con", 30);
  set("int", 20);
  set("max_kee", 1500);
  set("max_sen", 1000);
  set("attitude", "heroism");
  set("combat_exp", 700000);
  set("daoxing", 200000);

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("hammer", 150);
  set_skill("parry", 150);
  set_skill("force", 100);
  set_skill("spells", 100);
  set_skill("seashentong", 50);
  set_skill("dragonforce", 50);
  set_skill("dragonstep", 50);
  set_skill("literate", 50);
  set_skill("dragonfight", 50);
  map_skill("unarmed", "dragonfight");
  set_skill("huntian-hammer", 150);
  map_skill("hammer", "huntian-hammer");
  map_skill("parry", "huntian-hammer");
  map_skill("force", "dragonforce");
  map_skill("dodge", "dragonstep");
  map_skill("spells", "seashentong");
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 40);
  set("mana", 800);
  set("max_mana", 800);
  set("mana_factor", 40);
  set("have", 3);

  create_family("东海龙宫", 2, "水族");
  set("inquiry", ([
    "腰牌": (: give_me :),
    "pai": (: give_me :),
    "雷动九天": (: find_yao :),
    "凤舞九天": (: find_yao :),
  ]));

  setup();
  carry_object("/d/ourhome/obj/ironarmor")->wear();
  carry_object("/d/obj/weapon/hammer/bahammer")->wield();
  carry_object("/d/sea/obj/pai");
  remove_call_out("create_pai");
  call_out("create_pai", 920, this_object());
}

void init() {
  ::init();
  set("chat_chance", 20);
  set("chat_msg", ({
    "鲸无敌道：十年前我们龙宫有个弟子紫风，练成了龙宫的最高心法【虽千万人吾往矣】，可惜。。。！\n",
    "鲸无敌叹道: 可惜十年前就不知所终。。。龙王好像知道一点他的消息。\n",
    "鲸无敌叹道: 不知紫风现在在哪里，好久没人陪我喝酒了。。。\n",
  }));

}

void attempt_apprentice(object ob) {
  command("look " + ob->query("id"));
  command("nod");
  command("recruit " + ob->query("id"));
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "dragon");
}

int give_me(object ob) {
  object who, me, pai;
  int i;

  who = this_player();
  me = this_object();
  pai = new("/d/sea/obj/pai");

  if ((string)who->query("family/family_name") != "东海龙宫") {
    if ((int)who->query_temp("pending/ask_time") >= 3) {
      message_vision("$N突然跳起，恶狠狠的瞪着$n说：看来你是不想活了！\n", me, who);
      command("kill " + who->query("id"));
      return 1;
    }
    message_vision("$N斜斜地瞟了$n一眼，说：此不足为外人道也！\n", me, who);
    who->add_temp("pending/ask_time", 1);
    return 1;
  } else {

    if ((int)who->query("combat_exp") + (int)who->query("daoxing") < 300) {
      command("baobao " + who->query("id"));
      return 1;
    }
    if ((int)who->query("jing_time") > time()) {
      message_vision("$N摇了摇头：你刚才不是已经要过了吗？\n", me);
      return 1;
    }
    if (objectp(present("yao pai", who))) {
      message_vision("$N很疑惑地看着你说到：你身上不是已经有了吗。\n", me);
      return 1;
    }
    if ((int)me->query("have")) {
      command("nod " + who->query("id"));
      message_vision(CYN "$N拿出一只腰牌给$n。\n" NOR, me, who);
      me->add("have", -1);
      pai->set("obj_owner", who->query("id"));
      pai->move(who);

      who->add_temp("pending/ask_time", 1);
      //                who->set("jing_time",time()+300);	 //alading  2002-11-17
      i = 1500 - who->query("combat_exp") / 1000;
      if (i < 300) i = 300;
      who->set("jing_time", time() + i);

      return 1;
    }
  }
  message_vision("$N对$n无奈的一伸手，说：今日腰牌已发完了，明日再来领吧。\n", me, who);
  return 1;
}


int create_pai(object ob) {
  ob->set("have", 3);
  remove_call_out("create_pai");
  call_out("create_pai", 920, ob);
  return 1;
}

int find_yao() {
  object me = this_player();
  if (this_player()->query("family/family_name") == "东海龙宫" && (string)me->query("gender") == "男性" && (int)me->query("max_force") > 1200) {
    if (me->query("leidong") == 1 && me->query("lg/qdone") == 1)
      message_vision("鲸无敌疑惑道:你不是问过了吗?\n", me);
    else {
      command("sigh");
      command("cry");
      command("say 龙王旧日的寒毒又发作了，也不知还能熬几天？");
      command("say 据我所知，只有大雪山的无影神毒可以以毒攻毒。只是要得到这雪山至宝，谈何容易！");
      this_player()->set("lg/findyao", 1);
      this_player()->set("lg/qdone", 0);
    }
  } else if (this_player()->query("family/family_name") == "东海龙宫" && (string)me->query("gender") == "女性") {
    message_vision("鲸无敌皱眉道:雷动九天这门武功至阳至刚,恐怕不适合你练习.\n", me);
    message_vision("鲸无敌想了想又道:紫云公主有一套" HIC "凤舞九天" NOR "的武功,另得其妙,你不妨去试试.\n", me);
  } else {
    command("kick");
    command("say 烦着呢，别理我！");
  }
  return 1;
}

int accept_object(object me, object ob) {
  object yao;
  string msg;

  if (me->query("leidong"))
    return notify_fail("你已经完成过这个任务了\n");  //既然已经完成，就不要再送东西了。

    //判断id是否为wuyingdu,可能会导致bug，譬如说自制物品，player(fixed)
    //判断不够详细，需要在这个物品中加入属性以此来判断唯一性。
    if ((string)ob->query("id") != "wuyingdu") {
      command("say 这是什么？你给我干吗？");
      return 0;
    }
  //这里判断比较混乱。不知所云。
  //如果要判断成为只要接受过药的话那么改成为if (query_temp("received_yao"))即可。
  //后面的add_temp("received_yao", 1);可以考虑去掉。
  if (query_temp("received_yao") == 1) {
    command("thank " + me->query("id"));
    command("say 多谢了。但这毒恐怕是假的。");
    command("say " + RANK_D->query_respect(me) + "这份善心，在下心领了。");
    add_temp("received_yao", 1);
    return 0;
  }
  if (query_temp("received_yao") < 1 || !query_temp("received_yao")) {
    command("spank " + me->query("id"));
    add_temp("received_yao", 1);
    command("say 我这就将这套雷动九天传授给你，希望你善用之！");
    me->set("leidong", 1);
    msg = HIM + me->name() + "学会了" NOR + HIC "「雷动九天」" + HIM "，从此武功跨入一个新的境界。";
    message("channel:chat", HIM "【龙海龙宫】鲸无敌：" + msg + "\n" NOR, users());
    return 1;
  }
  command("say 多谢" + RANK_D->query_respect(me) + "的好意，不过在下已经有无影神毒了。");
  return 0;
}
