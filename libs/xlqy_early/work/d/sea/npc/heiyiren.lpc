#include <ansi.h> 
inherit NPC;

void create()
{
  set_name(BLU"黑衣人"NOR, ({"heiyi ren", "heiyi", "ren"}));
  set ("long", @LONG
一身夜行衣的打扮，神情有些慌张，大概刚做过什么亏心事。
LONG);
 
  set("title", HIW"妙手空空"NOR);
  set("gender", "男性");
  set("age", 43);
  set("str", 45);
  set("per", 15);
  set("int", 30);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 300000);
  set_skill("spear", 100);
  set_skill("force", 100);
  set_skill("dodge", 100);
  set_skill("stick", 100);
  set_skill("stealing", 200);
  set_skill("literate", 180);
  set_skill("dali-bang", 100);
  set_skill("huoyun-qiang", 100);
  set_skill("parry", 100);
  set_skill("unarmed", 100);
set_skill("wuyue-spear", 100);
set_skill("spells", 100);
set_skill("pingtian-dafa", 100);
  set_skill("moshenbu", 100);
  set_skill("huomoforce", 100);
  set_skill("moyun-shou", 100);
map_skill("force", "huomoforce");
map_skill("spells", "pingtian-dafa");
  map_skill("unarmed", "moyun-shou");
  map_skill("spear", "wuyue-spear");
  map_skill("parry", "wuyue-spear");
  map_skill("stick", "dali-bang");
  map_skill("dodge", "moshenbu");
  set("max_sen", 1300);
  set("max_kee", 1300);
set("force", 1500);
set("max_force", 1500);
set("mana",1500);
set("max_mana",1500);
set("daoxing",300000);
set("force_factor", 50);
set("mana_factor", 70);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
                (: perform_action, "spear", "buhui" :),
                (: perform_action, "unarmed", "zhangxinlei" :),
  }) );
  
  

 
  create_family("火云洞", 3, "蓝");
  setup();
 
carry_object("/d/city/npc/obj/spear")->wield();
carry_object("/d/sea/obj/cloth")->wear();
carry_object("/d/sea/obj/map");

}

void init()
{
        object ob;

        ::init();
        set("chat_chance", 10);
        set("chat_msg", ({
            "黑衣人往怀中摸了摸，轻轻的嘘了一口气。\n", 
                (: random_move :)
        }) );
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        
}
 
int accept_fight(object me)
{
  command("say 老子没空！\n");
  return 0;
}

void unconcious() 
{ 
   die(); 
} 



void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;

        switch( random(1) ) {
                case 0:
                        say( "黑衣人警觉地看了你一眼。\n");
                        break;
                case 1:
                        command ("sneer " + ob->query("id") );
                        break;
                

        }

}
