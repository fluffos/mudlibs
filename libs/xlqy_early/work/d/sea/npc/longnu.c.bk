int fightmoon()
{	
	object me=this_player();
 	command("tan");
	if(this_player()->query("family/family_name") == "东海龙宫" && (int)me->query("max_force") > 1200)
	{if(me->query("fengwu") == 1 && me->query("lg/qdone") ==1)
	  message_vision("龙女疑惑道:你不是问过了吗?\n", me);
	  else
	{message_vision("龙女幽幽的叹了口气！\n", me);
	command("say 我现在没有心情...");
	command("say 我去年和百花仙子比武输了，今年说好让徒弟再比一场，你替我去好吗？");
	me->set_temp("princess_answer",1);
	tell_object(me,"\n请answer 好或者不好。\n");}
	//this_player()->set("lg/fightmoon",1);
	}
	else
	{command("heng");
	command("say 我好像不认识你。。。");}
	return 1;
}

int do_answer(string arg)
{
  object who;

  who = this_player();

  if (! who->query_temp("princess_answer"))
    return notify_fail("什么？\n");

  if (!arg)
    return notify_fail("你要回答什么？\n");

  who->set_temp("princess_answer",0);
  message_vision("$N答道："+arg+"\n", who);
  if (arg == "好")
    go_to_fight (who);
  else if (arg == "不好")
    //fight_player (who);
    message_vision ("龙女对$N皱起眉头。\n",who);
  else
    message_vision ("龙女对$N说道：你说什么呢？\n",who);
  return 1;
}

void go_to_fight (object who)
{
  string msg;
  message_vision ("龙女高兴地说:你既然愿意，就去蓬莱找百花仙子ask fight吧！\n",who);
  who->set("lg/qdone",0);
  who->save();
  
} 

int accept_object(object me, object ob)
{
  string msg;
  
  if ((string)ob->query("id")!="moonletter") {
    command("say 这是什么？你给我干吗？");
    return 0;
  }
  else
    if(ob->query("owned")!=me->query("id"))
    {command("say 你怎么拿别人的东西？");
    return 0;}
  else  
    if(me->query("fengwu") == 1)
    {command("say 凤舞九天你不是已经学过了吗？");
    return 0;}	//alading add 2003-5-28  消除无限给letter的bug
  
  else {
    
          command("jump");
          command("kiss " + me->query("id"));
          command("say 这位" + RANK_D->query_respect(me) + "！实在太感谢了！");
          if((string)me->query("gender")=="女性")
          {command("say 我这套凤舞九天走至阴至柔地路子,最适合女子习练,现在传给你,希望你好自为之!");
          me->add("potential",1000+random(1000));
          me->add("daoxing",5000+random(3000));
          me->add("combat_exp",5000+random(3000));
          me->set("fengwu",1);
          msg=HIM+me->name()+"学会了"NOR+HIC"「凤舞九天」"+HIM"，从此武功跨入一个新的境界。";
                      message("channel:chat",HIM"【龙海龙宫】龙女："+msg+"\n"NOR,users());
          }
          else
          {me->add("potential",1000+random(1000));
          me->add("daoxing",5000+random(3000));
          me->add("combat_exp",5000+random(3000));
          me->set("fengwu",1);
          }
         return 1;
        
  }
}