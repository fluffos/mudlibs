#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("夜行衣", ({"black cloth", "cloth"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("long", "一件漆黑的布袍，一丝杂色也没有，看来是专门用来做些夜间勾当的．\n");
                set("unit", "件");
                set("value", 20000);
                set("armor_prop/armor", 10);

        }
        setup();
}


