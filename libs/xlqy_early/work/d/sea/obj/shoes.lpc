#include <armor.h>
#include <ansi.h>

inherit BOOTS;


void create()
{
	set_name(HIC "疾风" NOR, ({ "shoes" }) );
	set_weight(900);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "。  \n");
		set("material", "cloth");
                set("no_put",1);
                set("no_sell",1);
                set("no_give",1);
                set("no_drop",1);
		set("unit", "双");
		set("armor_prop/armor", 70 );
                set("armor_prop/dodge", 50 );
	}
	setup();
}



