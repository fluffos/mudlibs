#include <armor.h>

inherit HANDS;

void create()
{
        set_name(HIC"银丝手套"NOR, ({ "gloves" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("material", "silk");
		set("value", 7000000);
		set("no_steal",1);

                set("no_drop", "如此宝物再世难求啊。\n");

                set("no_give", "这种稀世之宝怎么能轻易送人呢?\n");

                set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");
                set("glove", 1);
                set("armor_prop/armor", 10);
        }
        setup();
}


