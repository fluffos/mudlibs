#include <armor.h>
#include <ansi.h>

inherit DIABLO_OB;

void create() {
  set("diablo_fixed/antique_stat", 1);
  set("name", HIB "蟒皮护肩" NOR);
  //        set_name(""HIG"古物之戒指"NOR"",({""HIG"Antique ring"NOR"","ring"}));
  set("id", "shoulder");
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("armor_prop/armor", 1);
    set("armor_type", TYPE_SHOULDER);
    set("diablo_prop/armor", 1200);
    set("diablo_prop/sub_max_phy", 10000);
    set("level", 9);
    set("no_drop", 1);
    set("no_copy", 1);
    set("no_zm", 1);
    set("no_get", 1);
    set("no_sell", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_diablo_rename", 1);
    set("identification", 1);

    //	set("diablo_ob_autoloaded",1);
  }
  setup();
}
