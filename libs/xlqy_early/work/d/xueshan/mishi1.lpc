//by flying

inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "密室");
  set("long", @LONG

一间密室，有点阴冷，据说雪山的各种毒大多藏在这里。
LONG);


  set("exits", ([
    "east": __DIR__ "restroom",

  ]));
  set("no_clean_up", 0);
  setup();
}
void init()

{

  add_action("do_search", "search");

}

int do_search(string arg)

{


  object zhu, gloves;
  object me = this_player();

  if (!arg) {

    if (!random(5) && me->query("lg/findyao") && me->query("lg/qdone") == 0) {

      message_vision("在房间中$N细细搜索，突然$N发现有只箱子有点奇怪。\n", this_player());
      if (gloves = present("gloves", me)) {
        message_vision("$N小心翼翼的将它打开，果然装着无影神毒。$N忙不迭将它取出。\n", this_player());

        zhu = new("/d/xueshan/obj/wuyingdu");

        zhu->move(this_player());
        me->set("lg/qdone", 1);
        me->set("lg/findyao", 0);
        if (!this_player()->query("lg/getyao")) {
          this_player()->set("lg/getyao", 1);
          this_player()->add("potential", 300 + random(500));
          this_player()->add("daoxing", 2000 + random(2000));
          this_player()->add("combat_exp", 2000 + random(2000));

        }
      } else
        message_vision("$N看了看箱子，却不敢动手。\n", this_player());

      return 1;

    }

  }

  return notify_fail("你在房间中细细摸索，却甚麽都没发现。\n");

}
