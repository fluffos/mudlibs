#include <room.h>
inherit ROOM;

void create() {
  set("short", "休息室");
  set("long", @LONG

这里是雪山弟子平时休息的地方。屋中央有一张大石桌，上面摆
着一些水果点心。边上还有两个里间。其中靠南的一间门上挂着
一张牌子(paizi)。而墙上则乱七八糟地写满了字。
西面是扇铁门，你隐约觉得里面透出一股极深的寒气。
LONG);

  set("item_desc", ([ "paizi": "女弟子卧房，男子严禁入内。\n", ]));
  //for look something.

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "girlroom",
      "north": __DIR__ "boyroom",
      "east": __DIR__ "shanpo",
      //"west" : __DIR__"mishi1",
    ]));

  set("objects",
    ([  //sizeof() == 1
    "/d/obj/misc/seat": 2,
      "/d/obj/misc/table": 1,
      "/d/xueshan/npc/xunshi": 2,
    ]));

  //	set("valid_startroom", 1);

  set("outdoors", "xueshan");
  //create_door("west", "铁门", "east", DOOR_CLOSED);


  setup();

  "/obj/board/xueshan_b"->foo();
}




int valid_leave(object me, string dir) {
  if (dir == "south" && objectp(present("xunshi", environment(me)))) {
    if (me->query("gender") == "男性") {
      return notify_fail("冰谷巡使喝道：女弟子卧房，男子严禁入内！\n");
    }
  } else {
    return ::valid_leave(me, dir);
  }
  return 1;
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object me, key, nroom;

  me = this_player();

  if (!arg || arg != "door")
    return notify_fail("你要打开什么？\n");

  //    if( !(key = present("huangtong key", me) && key->query("id")=="huangtong key") ) 
  key = present("xueshan key", me);
  if (!key || key->query("id") != "xueshan key")
    return notify_fail("你没有开这道门的钥匙。\n");

  //now we are ready to open...

  if (!(nroom = find_object(__DIR__ "mishi1")))
    nroom = load_object(__DIR__ "mishi1");

  if (nroom = find_object(__DIR__ "mishi1")) {
    set("exits/west", __DIR__ "mishi1");
    message_vision("$N把钥匙插在锁孔里拧了半天，终于把锁打开了,一阵寒气扑面而来。\n", me);
    nroom->set("exits/south", __DIR__ "restroom");
    //me->set_temp("used_huangtong_key", 1);
    destruct(key);
    call_out("close_door", 600);
  }
  return 1;

}
