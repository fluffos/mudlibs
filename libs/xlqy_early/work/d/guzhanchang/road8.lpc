void init() {
  add_action("do_accept", "accept");
  add_action("do_accept", "bian"); add_action("do_cast", "cast"); add_action("do_fly", "fly");
}
int do_accept() {
  object who = this_player();
  message_vision("此乃天界，岂容你乱来？\n", who);
  return 1;

}
int valid_leave(object me, string dir) {
  object a;
  if (wizardp(me)) return 1;

  if (dir == "north" && me->query("9sky/ba") != "done") {
    if (objectp(a = present("shouhuzhe", environment(me))) && living(a))
      return notify_fail("守护者好象不愿让你过去！\n");
    return ::valid_leave(me, dir);
  }

  return 1;
}
void alternative_die(object me) {
  if (userp(me)) {
    message_vision("天空突然升出一只大脚，一脚将$N踢飞了。\n", me);
    me->add("daoxing", -me->query("daoxing") / 222);
    me->add("combat_exp", -me->query("combat_exp") / 222);
    me->set("eff_kee", me->query("max_kee") / 3);
    me->set("kee", me->query("max_kee") / 3);
    me->set("eff_sen", me->query("max_sen") / 3);
    me->set("sen", me->query("max_sen") / 3);
    me->move("/d/city/center");
    me->unconcious();

    tell_room(environment(me), "半空中，" + me->query("name") + "倒栽葱的直坠下来。\n");
    return;
  } else {
    if (me->query("id") == "shouhuzhe")
      me->die();
    else {
      me->move("/obj/void");
      destruct(me);
    }




  }
}
