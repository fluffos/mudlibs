#include <ansi.h>;
inherit NPC;
#include "star.h"
string* msg =({
	HIW"根骨是人物与生俱来的体质，或者说是生命力。\n"NOR,
	HIR"根骨越好，习武自然事半功倍。\n"NOR,
	HIC"所以资质驽钝无妨，但根骨一定要佳！\n"NOR,
	HIY"据说根骨佳的人对于药物的抗力比较强——包括毒药和补药。\n"NOR,
}); 
int do_sheshen();
void create()
{
        set_name("依天神龙", ({ "shouhuzhe", "shouhu zhe", "zhe" }) );
        set("gender", "男性" );
	set("long",
		"守护第四重天的守护者----四海龙王依天神龙\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("family/family_name","东海龙宫");
  set("cor", 30);
  set("cps", 40);
  set("kar", 40);
  set("int", 40);
  set("con", 100);
  set("spi", 40);
  set("title", "守护者");
  set("combat_exp", 9800000);
  set("daoxing", 9800000);
  set("max_sen", 18000);
  set("max_kee", 18000);
  set("force", 12000); 
  set("max_force", 6000);
  set("force_factor", 300);
  set("max_mana", 6000);
  set("mana", 12000);
  set("mana_factor", 300);
set("class","dragon");		
  set("no_arrest",1);
                set_skill("literate", 450);
       set_skill("unarmed", 450);
       set_skill("dodge", 450);
       set_skill("force", 450);
       set_skill("parry", 450);
       set_skill("fork", 450);
       set_skill("spells", 450);
       set_skill("seashentong", 450);
       set_skill("dragonfight", 450);
       set_skill("dragonforce", 450);
       set_skill("fengbo-cha", 450);
       set_skill("dragonstep", 450);
       map_skill("spells", "seashentong");
       map_skill("unarmed", "dragonfight");
       map_skill("force", "dragonforce");
       map_skill("fork", "fengbo-cha");
       map_skill("parry", "fengbo-cha");
       map_skill("dodge", "dragonstep");
       
       set("skill_level/fork","grandmaster");
	set("skill_level/unarmed","grandmaster");
	 set("skill_level/spells","grandmaster");
	  set_temp("apply/feedback_damage",6000);
	 set_temp("apply/damage",360);
  set_temp("apply/armor",640);  
	  set("pini",1);
       set("chat_chance_combat", 75);
       set("chat_msg_combat", ({
                (: cast_spell, "hufa" :),
                (: perform_action, "fork", "fengbo" :),
                (: perform_action, "unarmed", "sheshen" :),
								(: do_sheshen :),
                }) );

	setup();
        carry_object("/d/npc/obj/fork")->wield();
   carry_object("/d/npc/obj/armor")->wear();
}

int do_sheshen()
{
	
	object me = this_object();
	me->command("perform fengbo");
	me->command("unwield fork");
	me->command("perform pini");
	me->command("wield fork");
	return 1;

}

void init()
{
     	object ob;
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
       } 
        add_action("do_none","ji");
        add_action("do_cast","cast");
        add_action("do_perform","perform");
        
        add_action("do_none","hun");
}
void greeting(object who)
{
	if(who->query_temp("9sky/start"))
		tell_object(who,HIW"依天神龙晃晃手中神叉，言道：让老夫来考较考较你的根骨。\n"NOR);	
}
int do_none()
{
        object me = this_object();
        message_vision("此乃天界，岂容你乱来？\n",me);
        return 1;
} 

int do_cast(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	 
     if (sscanf(arg, "%s", cast_id) == 1)
        if(cast_id=="chuqiao"||cast_id=="jieti"|| cast_id=="jiushen")
          {   message_vision("此乃天界，岂容你乱来？\n",who);
       return 1;}  
       else 
    if (sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
     
      if(cast_id=="jieti" || arg=="jieti" || cast_id=="jiushen" || arg=="jiushen" )
      {
       	 message_vision("此乃天界，岂容你乱来？\n",who);
       	  return 1;
       }
    
      
} 
int do_perform(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	
	   if(sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
	  {
	  
		   if(cast_id=="fall"|| cast_id=="huadie"|| cast_id=="huifeng")
		  {   message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		     }
	}
	else  if(sscanf(arg, "%s", cast_id) == 1)
	  {
	  	 if(cast_id=="fall"|| cast_id=="huadie"|| cast_id=="huifeng")
		{
		     message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		}
		  else return 0;
	  	
	  }
  	else return 0;
    
      
} 

void die()
{

             object ob = query_temp("last_damage_from");
	  object killer=query_temp("my_killer");
	  object last =query_temp("last_killed_by");
	  string faint=query_temp("last_fainted_from");
	 if(!ob)
	  {
	  
	    	 this_object()->move("/obj/void");
	    	 destruct(this_object());
	    	  
	    	  return;	
	  	
	}
	if(environment(ob)->query("short")!= "第四重天入口处")
	{
		 this_object()->move("/obj/void");
	    	 destruct(this_object());
		return;	
		
	}
  if(!ob->query_temp("9sky/start"))
    	{
    	 
    	  
    	  this_object()->move("/obj/void");
	    	 destruct(this_object());
    	  
    	  return;
    	}

  if(faint && ob) {
      if(faint!=ob->query("id"))
      		{
      		     this_object()->move("/obj/void");
	    	 destruct(this_object());
      		   
      		      return;
      		}
      	}
      if(!last) last=ob;
 	 else if(last!=ob)
  	{ this_object()->move("/obj/void");
	    	 destruct(this_object());return;}


        if((ob&&ob->query("9sky/san")=="done") && (ob&&ob->query("9sky/si")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIY+"【九重天】天极(Tian ji):"+ob->name()+
        "闯过了四重·楼兰天\n"NOR,users());
        ob->set("9sky/si","done");
        ob->add("9sky/number",1);
         ob->add("daoxing", 44000);
         ob->add("con",1);
           ob->save();
         tell_object(ob,"你赢得了四十四年道行,你的根骨增加了一点！");

        }
        this_object()->move("/obj/void");
	    	 destruct(this_object());
}
 varargs int receive_damage(string type, int damage, mixed who, string d_type) 
{ 
      if(who&&objectp(who))
      {
      	if(random(who->query_con()) < 15||random(who->query_con()) > 35)
      	{
      		tell_object(who,msg[random(sizeof(msg))]);
      		damage = damage/3;
      	}
      }
        return ::receive_damage(type,damage,who,d_type); 
     
 } 
varargs int receive_wound(string type, int damage, mixed who, string d_type) 
 { 
        
      if(who&&objectp(who))
      {
      if(random(who->query_con()) < 15||random(who->query_con()) > 35)
      	{
      		damage = damage/3;
      	}	
      }
       return ::receive_wound(type,damage,who,d_type); 
   
} 

