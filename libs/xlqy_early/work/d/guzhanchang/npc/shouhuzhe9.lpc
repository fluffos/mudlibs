#include <ansi.h>;
inherit NPC;
#include "star.h"

string* msg =({
	HIW"你终于到了这里，经过了力量智慧胆识定力博爱福缘灵性的考验。\n"NOR,
	HIR"忠诚，不仅仅是忠于自己的师门，更重要的是要忠于自己心中的理念。\n"NOR,
	HIC"自信，就是相信自己可以。\n"NOR,
	HIY"是的，要成为宗师，还需要对忠诚和自信进行考验。\n"NOR,
	HIG"请谨记，忠诚，而不是愚忠；自信，而不是自负。\n"NOR,
}); 
int do_pili();
void create()
{
        set_name("孙行者", ({ "shouhuzhe", "shouhu zhe", "zhe" }) );
        set("gender", "男性" );
	set("long",
		"守护第九重天的守护者----斗战胜佛孙行者\n"
	);
  set("str", 100);
  set("per", 130);
 	set("age", 16);
  set("cor", 100);
  set("cps", 100);
  set("kar", 100);
  set("int", 100);
  set("con", 100);
  set("spi", 100);
  set("title", "守护者");
  set("combat_exp", 13968132);
  set("daoxing", 13248000);
  set("max_sen", 24000);
  set("max_kee", 24000);
  set("family/family_name","方寸山三星洞");

  set("force", 21000); 
  set("max_force", 12000);
  set("force_factor", 500);
  set("max_mana", 12000);
  set("mana", 21000);
  set("mana_factor", 500);
set("class","taoist");		
             
       set_skill("unarmed", 550+random(50));
       set_skill("dodge", 550+random(50));
       set_skill("parry", 550+random(50));
        set_skill("stick", 550+random(50));
       set_skill("spells", 550+random(50));
        set_skill("dao", 550+random(50));
        set_skill("puti-zhi", 550+random(50));
        set_skill("wuxiangforce", 550+random(50));
        set_skill("force", 550+random(50));
        set_skill("qianjun-bang", 550+random(50));
        set_skill("jindouyun", 550+random(50));
        map_skill("spells", "dao");
	map_skill("unarmed", "puti-zhi");
	map_skill("force", "wuxiangforce");
	map_skill("stick", "qianjun-bang");
	map_skill("parry", "qianjun-bang");
