	map_skill("sword", "liangyi-sword");
	
	set("skill_level/stick","grandmaster");
	
	
	set_temp("apply/combat_ignore_armor",4500);
//	set_temp("apply/feedback_damage",6000);
//	set_temp("apply/parry_block_attack",6000);
	set_temp("apply/combat_double_damage",4500);
