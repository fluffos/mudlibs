inherit NPC;

#include <ansi.h>
int big_blowing();
void create()
{
	 set_name("僵尸", ({ "jiang shi", "shi" }) );
	 set("gender", "雄性");
	 set("age", 1500);
	 set("long",
	"这是古战场的僵尸，身带剧毒，小心别惹它 ！\n");
	 set("str", 48);
	 set("cor", 52);
	 set("cps", 44);
	 set("max_kee", 15000);
	 set("max_gin", 15000);
	 set("max_sen", 15000);
	 set("force",4500);
	 set("max_force",4500);
	 set("mana",6000);
	 set("max_mana",4500);
	 set("force_factor",100);
	 set_skill("parry",320+random(50));
	 set_skill("dodge",320+random(50));
	 set_skill("lingfu-steps",320+random(50));
	 set_skill("unarmed",320+random(50));
	 set_skill("jinghun-zhang",320+random(50));
	 map_skill("unarmed","jinghun-zhang");
	 map_skill("parry","jinghun-zhang");
	        map_skill("dodge","lingfu-steps");
	 set("attitude", "aggressive");
	 set("combat_exp", 3500000+random(1500000));
	  set("chat_chance_combat", 50);
 	 set("chat_msg_combat", ({
                (: big_blowing :),
               
                }) );
	 setup();
	 set_temp("apply/immune_mu",1);
   set_temp("apply/add_max_mu",20000);
   set_temp("apply/add_mu",200);
	 set_temp("apply/master_mu",3000);
}
void init()
{
	if(interactive(this_player()))
		this_object()->kill_ob(this_player());	
	
call_out("dest",900);
	
	
}
void dest()
{
if(this_object()->is_fighting())
call_out("dest",100);
else destruct(this_object());
}
int big_blowing()
{
	int i ;
	object	me = this_object();
	object who = me->select_opponent();
	if(!who)	return 0;
	if(me->query("mana") < 700) 	return 0;
	if(me->is_busy()) 	return 0;
	message_vision(HIG"$N嘿嘿怪笑几声，张口吐出一股绿烟。\n"NOR,me);
	me->add("mana",-600);
	if(random(100) > 60)
	{
		i = random(4);
		if(i == 0)
		{
			who->receive_damage("kee", 100+who->query("kee")/10);
			who->receive_wound("kee", random(100)+who->query("kee")/10);
			message_vision(HIG"$N一个不慎，吸了一口绿烟，只觉得全身血脉不畅难受之极！\n"NOR,who);	
		}
		else if(i == 1)
		{
			who->receive_damage("sen", 100+who->query("sen")/10);
			who->receive_wound("sen", random(100)+who->query("sen")/10);
			message_vision(HIG"$N一个不慎，吸了一口绿烟，只觉得头晕脑热眼冒金星！\n"NOR,who);	
		}
		else if(i == 2)
		{
			who->add("force", -100-who->query("force")/10);
			if(who->query("force") < 0)
				who->set("force",0);
			message_vision(HIG"$N一个不慎，吸了一口绿烟，只觉得全身经脉不畅内力似乎凝固一般！\n"NOR,who);		
		}
		else 
		{
			who->add("mana", -100-who->query("mana")/10);
			if(who->query("mana") < 0)
				who->set("mana",0);
			message_vision(HIG"$N一个不慎，吸了一口绿烟，只觉得头皮一阵阵发麻，法力运转大受影响！\n"NOR,who);
		}
		
	}
	return 1;
	
}

