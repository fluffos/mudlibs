inherit NPC;
#include <ansi.h>
int big_blowing();
void create()
{
 set_name("鬼王", ({ "gui wang", "gui" }) );
 set("gender", "雄性");
 set("age", 1500);
 set("long",
"这是古战场最老，也是最凶狠的一个鬼，被称为鬼王 ！\n");
 set("str", 48);
 set("cor", 52);
 set("cps", 48);
 set("max_kee", 32000);
 set("max_gin", 32000);
 set("max_sen", 32000);
 set("force",12000);
 set("max_force",6000);
 set("mana",10000);
 set("max_mana",5000);
 set("force_factor",400);
 set_skill("parry",350+random(100));
 set_skill("dodge",350+random(100));
 set_skill("lingfu-steps",350+random(100));
 set_skill("unarmed",350+random(100));
 set_skill("jinghun-zhang",350+random(100));
 map_skill("unarmed","jinghun-zhang");
 map_skill("parry","jinghun-zhang");
 map_skill("dodge","lingfu-steps");
 set("attitude", "aggressive");
 set("combat_exp", 7000000+random(1200000));
  set("chat_chance_combat", 75);
  set("chat_msg_combat", ({
                (: big_blowing :),
               
                }) );
                
 setup();
  set_temp("apply/sub_max_phy",8000);
 set_temp("apply/sub_max_spells_all",8000);
  set_temp("apply/sub_max_jin",8000);
 set_temp("apply/immune_mu",1);
  set_temp("apply/sub_max_shui",8000);
 set_temp("apply/sub_max_huo",8000);
 set_temp("apply/add_max_mu",8000);
 set_temp("apply/add_mu",300);
 set_temp("apply/master_mu",8000);
 
 carry_object("/obj/money/gold")->set_amount(50);

}
int big_blowing()
{
	object guard,who;
	
	object	me = this_object();
	if(me->query("mana") < 800) 	return 0;
	if(me->is_busy()) 	return 0;
	if(random(2))
		guard = new(__DIR__"jiangshi2");
	else guard = new(__DIR__"kulou2");
	guard->move(environment(me));
	who = me->select_opponent();
//	if(who) guard->kill_ob(who);
	message_vision(HIB"$N嗬嗬的低吼了几声，眼中蓝光一闪，伸手一挥，一具"+guard->name()+"从地底冒了出来。\n"NOR,me);
	me->add("mana",-800);
	me->start_busy(1+random(2));
	return 1;
	
}
void unconcious()
{
	die();
}
void die()
{
	object ob = query_temp("last_damage_from");
	object me = this_object();
	if(random(100) < 75)
	{
		 set("max_kee", 24000);
		  set("eff_kee", 24000);
		   set("kee", 24000);
		 set("max_sen", 24000);
		  set("eff_sen", 24000);
		   set("sen", 24000);
		 set("force",8000);
		 set("max_force",6000);
		 set("mana",8000);
		 set("max_mana",5000);
		 set("force_factor",400);	
	message_vision(BLINK+BLU"$N眼中蓝光大涨，朝天嘶吼：“想灭我~~~`没那么容易！”\n"NOR,me);	
	}
	else
	{
		if(ob)
		{	
			message_vision(BLINK+RED"$N“啊”的一声惨叫，胸腔慢慢碎裂而开，冲天的烈焰从中冒出！”\n"NOR,me);
			if(random(100) > 75)
			{
				message_vision("$N躲闪不及，瞬间被烈焰完全吞没！”\n"NOR,ob);
				ob->set("eff_kee",ob->query("eff_kee")/2);
				ob->add("kee",-ob->query("eff_kee")/2);
				ob->set("eff_sen",ob->query("eff_sen")/2);
				ob->add("sen",-ob->query("eff_sen")/2);
			//	ob->unconcious();
			}
		}
			
		::die();	
	}
	
	
	
}