#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create()
{
    set_name(HIW "夹克" NOR, ({"jack", "jiake"}));
    set("long","\n名牌夹克，既保暖又透气\n");
    set_weight(100);
    if( clonep() )
	set_default_object(__FILE__);
    else {
	set("unit", "件");
	set("no_get",1);
	set("no_give",1);
	set("value",0);
	set("material", "cloth");
	set("armor_prop/armor", 300);
    }
    setup();
}
