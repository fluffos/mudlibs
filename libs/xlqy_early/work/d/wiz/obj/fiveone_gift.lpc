#include <ansi.h>

inherit ITEM;
inherit F_AUTOLOAD;

int do_xishi();
int do_feel();
void create() {
  set_name(HIR "五·一" + HIY "劳模奖章" NOR, ({ "Worker medal", "medal" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIY "一枚金质的劳模奖章。\n你可以选择bite来增加自己劳动潜力，也可以选择hang来增强自身劳动素质!" NOR);
    set("unit", "颗");
    set("weight", 100);
    set("value", 0);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_steal", 1);

    set("no_sell", "奖章怎么能卖呢！");
  }
  setup();

}

void init() {
  add_action("do_xishi", "bite");
  add_action("do_feel", "hang");
}
int do_xishi() {
  object who = this_player();
  if (this_object()->query("owner_id") != who->query("id")) {
    tell_object(who, "这好像不是你的东西吧...");
    this_object()->move("/obj/void");
    destruct(this_object());
    return 1;
  }
  message_vision(HIY "$N拿起手中的" NOR + this_object()->name() + HIY "咬了咬，大声叫道：金的，纯金的！\n" NOR, who);
  who->add("combat_exp", 30000 + random(20000));
  who->add("potential", 10000 + random(5000));
  tell_object(who, HIW "向奋斗在mud第一线的泥鳅们致以节日的问候！\n" NOR);
  this_object()->move("/obj/void");
  destruct(this_object());
  return 1;

}
int query_autoload() {

  return 1;
}
int do_feel() {
  object baoshi;
  object who = this_player();
  if (this_object()->query("owner_id") != who->query("id")) {
    tell_object(who, "这好像不是你的东西吧...");
    this_object()->move("/obj/void");
    destruct(this_object());
    return 1;
  }

  message_vision(HIC "$N将手中的" NOR + this_object()->name() + HIC "挂在胸前，大声说道：劳动最光荣！\n" NOR, who);
  tell_object(who, HIW "向奋斗在mud第一线的泥鳅们致以节日的问候！\n" NOR);
  who->add("attribute_point", 1 + random(3));

  this_object()->move("/obj/void");
  destruct(this_object());
  return 1;

}
