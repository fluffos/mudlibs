#include <armor.h>
#include <ansi.h>
inherit ARMOR;
void create() {
  set_name(HIB "牛仔裤" NOR, ({ "jean", "niuzaiku" }));
  set("long", "\nFUN牌牛仔裤。\n");
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 0);
    set("no_get", 1);
    set("no_give", 1);
    set("material", "cloth");
    set("armor_prop/armor", 300);
  }
  setup();
}
