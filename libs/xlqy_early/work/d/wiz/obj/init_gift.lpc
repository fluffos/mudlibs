#include <ansi.h>

inherit ITEM;
inherit F_AUTOLOAD;

int do_xishi();
int do_feel();
void create()
{
        set_name(MAG"仙石之魄"NOR, ({ "stone spirit","spirit" }) );
        set("long",
HIM"一颗笼罩在氤氲紫气中的小球，是仙石灵魄所幻化。\n你可以选择draw来获得经验值."NOR);
        set("unit", "颗");
        set("weight", 100);
        set("value", 0);
        set("no_drop",1);
        set("no_get",1);
        set("no_give",1);
        set("no_steal",1);
        set("no_put",1);
       
        set("no_sell","如此宝物怎可以价来估算！" );
  setup();
}

void init ()  
{   
  add_action ("do_xishi", "draw");
//  add_action("do_feel","feel");
  call_out ("destroy_book", 3600);
}
int do_xishi()
{
	object who = this_player();
	if(this_object()->query("owner_id")!=who->query("id"))
	{
		tell_object(who,"这好像不是你的东西吧...");
		this_object()->move("/obj/void");
		destruct(this_object());
		return 1;	
	}
	message_vision(HIY"$N手中的"NOR+this_object()->name()+HIY"突然化做万道霞光，悉数注入$N天灵之中！\n"NOR,who);
	who->add("combat_exp",54600);
	who->add("daoxing",3260);
	who->add("potential",12345);
	tell_object(who,HIG"你觉得全身懒洋洋的，却又说不出的舒坦..\n"NOR);
	this_object()->move("/obj/void");
	destruct(this_object());
	return 1;

}
int query_autoload()
{

    return 1;
    }
int do_feel()
{
	object baoshi;
	object who = this_player();
	if(this_object()->query("owner_id")!=who->query("id"))
	{
		tell_object(who,"这好像不是你的东西吧...");
		this_object()->move("/obj/void");
		destruct(this_object());
		return 1;	
	}
	if(random(2))
	{
		message_vision(HIR"$N手中的"NOR+this_object()->name()+HIR"突然散出万道红光，凌空绕$N飞舞三周，落入$N手中！\n"NOR,who);
		baoshi = new("/d/baoshi/obj/wx_r.lpc");		
		baoshi->set("no_give",1);
		baoshi->set("no_get",1);
		baoshi->set("can_putin_box",1);
		baoshi->set("can't_putin_fog",1);
	}
	else if(random(2))
	{
		message_vision(HIC"$N手中的"NOR+this_object()->name()+HIC"突然散出万道青光，凌空绕$N飞舞三周，落入$N手中！\n"NOR,who);
		baoshi = new("/d/baoshi/obj/wx_c.lpc");	
		baoshi->set("no_give",1);
		baoshi->set("no_get",1);
		baoshi->set("can_putin_box",1);
		baoshi->set("can't_putin_fog",1);
	}
	else if(random(2))
	{
	message_vision(HIB"$N手中的"NOR+this_object()->name()+HIB"突然散出万道蓝光，凌空绕$N飞舞三周，落入$N手中！\n"NOR,who);
	baoshi = new("/d/baoshi/obj/wx_b.lpc");		
	baoshi->set("no_give",1);	
	baoshi->set("no_get",1);
	baoshi->set("can_putin_box",1);
	baoshi->set("can't_putin_fog",1);
	}
	else 
	{
		message_vision(HIG"$N手中的"NOR+this_object()->name()+HIG"突然散出万道绿光，凌空绕$N飞舞三周，落入$N手中！\n"NOR,who);
		baoshi = new("/d/baoshi/obj/wx_g.lpc");		
		baoshi->set("no_give",1);
		baoshi->set("no_get",1);
		baoshi->set("can_putin_box",1);	
		baoshi->set("can't_putin_fog",1);
	}
	
	baoshi->move(who);
	this_object()->move("/obj/void");
	destruct(this_object());
	return 1;
	
}
void destroy_book()
{
        message_vision("呼的一下，" + (string)this_object()->query("name") + "不见了。\n", environment(this_object()));
        destruct(this_object());
}
