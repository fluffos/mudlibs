inherit NPC;
#include <ansi.h>
string *first_name = ({ "乌云仙", "金光仙", "金牙仙", "龟灵圣母", "火灵圣母", "多宝道人" });
void give_fabao(object who);
void create() {
  string name;
  name = first_name[random(sizeof(first_name))];
  set("title", "截教门人");
  set_name(name, ({ "mo" }));
  set("race", "人类");
  set("age", 3000);
  set("long", "妖魔，你可以试着降伏他(xiang)。\n");
  set("str", 30);
  set("cor", 30);
  set("max_force", 3000);
  set("mana", 4000);
  set("force", 4000);
  set("max_mana", 3000);
  set("force_factor", 100);
  set("mana_factor", 150);
  set("max_kee", 3000);
  set("max_sen", 3000);
  set("verbs", ({ "bite", "claw" }));
  create_family("方寸山三星洞", 2, "第子");
  set("combat_exp", 2500000 + random(1000000));
  set("daoxing", 5000000);

  set_skill("dodge", 180 + random(50));
  set_skill("puti-zhi", 180 + random(50));
  set_skill("unarmed", 180 + random(50));
  set_skill("parry", 180 + random(50));
  set_skill("jindouyun", 180 + random(50));
  set_skill("force", 200);
  set_skill("wuxiangforce", 200);
  set_skill("sword", 180 + random(50));
  set_skill("liangyi-sword", 180 + random(50));
  set_skill("dao", 200);
  set_skill("spells", 200);

  map_skill("force", "wuxiangforce");
  map_skill("parry", "liangyi-sword");
  map_skill("sword", "liangyi-sword");
  map_skill("dodge", "jindouyun");
  map_skill("unarmed", "puti-zhi");
  map_skill("spells", "dao");
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: cast_spell, "light" :),
    (: cast_spell, "thunder" :),
    (: cast_spell, "dingshen" :),
    (: cast_spell, "fenshen" :)
  }));
  set_temp("apply/damage", 50);
  set_temp("apply/armor", 150);
  set_weight(500000);
  setup();
  carry_object("/d/zhuxian/obj/jia")->wear();

  carry_object("/d/zhuxian/obj/sword")->wield();
}


void init() {
  ::init();
  add_action("do_dou", "xiang");
}

int do_dou() {
  object me, who;
  me = this_object();
  who = this_player();

  if (me->is_fighting())
    return notify_fail("慢慢来，不要急。\n");
  message_vision("$N对$n大喊一声：看招！\n\n", who, me);
  me->kill_ob(who);
  who->kill_ob(me);
  //        COMBAT_D->do_attack(me, who, query_temp("weapon"));
  me->set("owner", who->query("id"));
  return 1;
}
void die() {
  string owner;
  object owner_ob;

  owner = query("owner");

  if (!owner) return ::die();  // added by mon.

  owner_ob = find_player(owner);

  if (owner_ob && (object)query_temp("last_damage_from") == owner_ob) {
    owner_ob->add_temp("mark/人", 1);
    owner_ob->add_temp("mark/仙", 1);
    message_vision("$N起个云头，将身一纵跳在半空，一拱手道：你家大爷我这就去也！。\n", this_object());
    //               give_fabao(owner_ob);                
    destruct(this_object());
    return;
  }
  ::die();
}

