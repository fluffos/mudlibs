#include <ansi.h>
#include <weapon.h>
inherit SWORD;
inherit F_UNIQUE;
int do_amalgamation();
void create()
{
        set_name( HIR "诛仙剑" NOR, ({ "zhuxian jian", "jian", "sword" }) );
        set_weight(7000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",
                        
"诛仙剑\n"
);
                set("value", 0);
                set("material", "steel");
                set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入腰间的剑鞘。\n");
        }
       set("no_sell", 1);
       set("no_drop", 1);
       set("no_put",1);
       set("no_give",1);
       init_sword(120);
       setup();

}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        int damage;
        pro = (int) victim->query("mana");
        dam = (int) me->query("mana");

        damage = (int) me->query("force_factor");
        if(dam/2 > random(pro))
        {
        victim->receive_damage("sen",damage);
        return HIR "诛仙剑闪出妖异的红光。\n" NOR;
        }
}
int init()
{
     
        unique::init();
        add_action("do_amalgamation", "combine");
        return 1;
}
int do_amalgamation()
{
        
        object zx,xx,jx,lx;
        object who = this_player();
        object shengzhu;
	object wuchen;
        if(who->is_fighting())
           return notify_fail("你正打仗呢！想死啊！\n");
        if(who->is_busy())
           return notify_fail("你正忙着呢!\n");
        if(!zx = present("zhuxian jian",who))
           return notify_fail("你还缺少"+HIG "诛仙剑" NOR +"呢!怎么合壁呢?\n");
        if(!xx = present("xianxian jian",who))
           return notify_fail("你还缺少"+HIB "陷仙剑" NOR +"呢!怎么合壁呢?\n");
        if(!jx = present("juexian jian",who))
           return notify_fail("你还缺少"+HIY "绝仙剑" NOR +"呢!怎么合壁呢?\n");
        if(!lx = present("luxian jian",who))
           return notify_fail("你还缺少"+HIW "戮仙剑" NOR +"呢!怎么合壁呢?\n");
        if(!shengzhu = present("sheng lingzhu",who))
           return notify_fail("你还缺少"+HIW "圣灵珠" NOR +"呢!怎么合壁呢?\n");   
           
if ((zx->query("equipped")!="wielded") && (xx->query("equipped")!="wielded") && (jx->query("equipped")!="wielded") && (lx->query("equipped")!="wielded") && (shengzhu->query("equipped")!="worn"))
{        
        message_vision(HIW"$N把四把宝剑放在一起，剑尖皆指向圣珠。只见圣珠缓缓转动，渐渐宝光大盛，直冲云霄！\n
俄顷，圣珠发出红黄蓝绿四色强光分指四剑，隐隐有风雷之声！\n
又待片刻，圣珠呼的一暗，只见四剑冲天飞起合体为一散发出万道霞光！\n"NOR,who);

        message("channel:rumor",RED+"【谣言】某人："+who->query("name")+"拿到"+NOR+HIW+"无尘剑"+NOR+RED+"了！\n"+NOR,users() );
        
         if(wuchen = new("/d/zhuxian/obj/wuchen"))
                 wuchen->move(who);
        destruct(shengzhu);
        destruct(lx);
        destruct(xx);
        destruct(jx);
        destruct(this_object());
        return 1;
} 
}

