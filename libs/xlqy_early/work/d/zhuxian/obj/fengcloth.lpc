#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create() {
  set_name(HIW "仙衣" NOR, ({ "xian yi", "yi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 0);
    set("material", "cloth");
    set("armor_prop/armor", 80);
    set("armor_prop/sub_max_mu", 1000);
    set("armor_prop/dodge", 30);
    set("armor_prop/spells", 10);
  }
  setup();
}
