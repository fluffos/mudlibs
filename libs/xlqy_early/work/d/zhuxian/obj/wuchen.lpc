#include <ansi.h>
#include <weapon.h>
inherit SWORD;
inherit F_UNIQUE;
void create()
{
        set_name( HIW "无尘剑" NOR, ({ "wuchen jian", "jian", "sword" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",
                        
"当年元始天尊纵横四海时用的宝剑，剑身通体竟是透明，只有五彩毫光隐隐流动。\n"
);
                set("value", 0);
                set("material", "steel");
             
                set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入腰间的剑鞘。\n");
        }
           set("weapon_prop/sword", 24);
	        set("weapon_prop/spells",12);
	         set("weapon_prop/force",12);
	          set("weapon_prop/parry",12);
	        set("weapon_prop/strength", 12);
    set("weapon_prop/damage", 250);
       set("no_sell", 1);
       set("no_drop", 1);
       set("no_put",1);
       set("no_give",1);
       init_sword(180);
       setup();

}

mixed hit_ob(object me, object victim, int damage_bonus)
{
     
   
   string msg;
   int pro;
   int dam;
   pro = (int) victim->query("mana");
   dam = (int) me->query("mana");
   if(dam*2/3 > random(pro))
   {
	   damage_bonus = 99+me->query("mana_factor");
	   victim->receive_damage("sen", damage_bonus,victim,"magic");
	   victim->receive_wound("sen", damage_bonus*2/3,victim);
  }
    pro = (int) victim->query("force");
   dam = (int) me->query("force");
   if(dam*2/3 > random(pro))
   {
	   damage_bonus = 99+me->query("force_factor");
	   victim->receive_damage("kee", damage_bonus,victim,"phy");
      	   victim->receive_wound("kee", damage_bonus*2/3,victim);
   }
   msg = HIW"无尘剑五彩毫光猛然四射，刹时风雨雷电齐至，山崩地裂！\n"NOR;
   msg += HIC "结果$n躲避不及，被雷电劈个正着，又被地火烧得皮焦骨烂。\n
被山石砸得皮破血流，还被风迷了双眼，又被水浇个透心凉，肌肤尽裂。\n" NOR;
   pro = (int) victim->query_skill("dodge");
   dam = (int) me->query_skill("sword");
   if(dam/2 > random(pro))
        victim->start_busy(3);
       
       return msg;

} 
           


