inherit ROOM;                                                        
#include "bancast.h"

void create ()
{
  set ("short", "绝仙门内" );   
  set ("long", @LONG   
这里前後有门有户，杀气森森，阴风飒飒。
边上隐约又是一层，似为“绝仙阙”。
LONG);
    set("exits", ([ 
               "west" : __DIR__"juexian2",
               "east" : __DIR__"juexian2",
               "north" : __DIR__"juexian2",
               "south" : __DIR__"juexianque",
                  ]));
    set("objects", ([ 
		__DIR__"npc/mobing" : 4,
                  ]));
                   set("no_burn",1);
                   set("no_alert",1);
    setup();
}

void init() 
{
  add_action("do_quit", "quit");  add_action("do_sleep", "sleep");
  add_action("do_ji", banned_action);
  add_action("do_cast",({"cast","burn"}));
}

int valid_leave(object me, string dir)
{
        object a;
   if (dir) {
                if(objectp(a=present("mo bing", environment(me))) && living(a) )
        return notify_fail("截教门人一把拦住你道：进来了还想走？ \n");
        }   
        return ::valid_leave(me, dir);
}
