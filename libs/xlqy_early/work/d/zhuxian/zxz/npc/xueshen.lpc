inherit NPC;
#include <ansi.h>
int do_daodao();
void create() {
  set_name("雪神", ({ "xue shen", "xueshen", "shen" }));
  set("gender", "男性");
  set("attitude", "aggressive");
  set("combat_exp", 13000000 + random(3000000));
  set("daoxing", 13330000);
  create_family("大雪山", 2, "弟子");
  set("title", "截教门人");

  set("age", 2000);
  set("per", 30);
  set("str", 40);
  set("int", 30);
  set("cor", 40);
  set("cps", 40);
  set("con", 30);
  set("kar", 30);
  set("spi", 30);
  set("max_kee", 18000);
  set("max_sen", 18000);
  set("force", 18000);
  set("max_force", 6000 + random(2000));
  set("max_mana", 6000 + random(2000));
  set("mana", 12000 + random(4000));
  set("mana_factor", 300 + random(100));
  set("force_factor", 300 + random(100));
  set("bellicosity", 500);
  set("no_arrest", 1);
  set_skill("unarmed", 400 + random(100));
  set_skill("cuixin-zhang", 400 + random(100));
  set_skill("dodge", 400 + random(100));
  set_skill("xiaoyaoyou", 400 + random(100));
  set_skill("parry", 400 + random(100));
  set_skill("sword", 400 + random(100));
  set_skill("bainiao-jian", 400 + random(100));
  set_skill("blade", 400 + random(100));
  set_skill("bingpo-blade", 400 + random(100));
  set_skill("throwing", 400 + random(100));
  set_skill("force", 400 + random(100));
  set_skill("ningxie-force", 400 + random(100));
  set_skill("literate", 400 + random(100));
  set_skill("spells", 400 + random(100));
  set_skill("dengxian-dafa", 400 + random(100));
  map_skill("spells", "dengxian-dafa");
  map_skill("force", "ningxie-force");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("sword", "bainiao-jian");
  map_skill("blade", "bingpo-blade");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("throwing", "bainiao-jian");
  map_skill("parry", "bainiao-jian");

  set("skill_level/throwing", "grandmaster");
  set("skill_level/sword", "grandmaster");
  set("skill_level/blade", "grandmaster");
  set("skill_level/dodge", "master");
  set("chat_chance_combat", 88);
  set("chat_msg_combat", ({
    (: cast_spell, "juanbi" :),
    (: do_daodao :),
    (: cast_spell, "hufa" :),
    (: perform_action, "blade", "hgz" :),
    (: perform_action, "blade", "ningxie" :),
    (: perform_action, "unarmed", "cuixin" :),
  }));
  set_temp("apply/armor", 640);
  set_temp("apply/damage", 180);
  set_temp("apply/armor_vs_force", 300);
  set_temp("apply/defense", 120);
  set_temp("apply/strength", 120);
  set_temp("apply/combat_ignore_armor", 5000);
  set_temp("combat/bless", 3 + random(7));
  set_temp("combat/lucky", 3 + random(7));
  set_weight(1000000);
  setup();
  carry_object("/d/npc/obj/qin");
  carry_object("/d/npc/obj/blade")->wield();
  carry_object("/d/npc/obj/armor")->wear();
}

void kill_ob(object ob) {
  object me = this_object();
  object jiaozhu;
  object where = environment(me);

  jiaozhu = present("tongtian jiaozhu", where);

  if (me->query("no_move"))
    me->delete_temp("no_move");
  if (me->query("kee") < me->query("eff_kee") - 500)
    command("exert recover");
  set_temp("my_killer", ob);
  ::kill_ob(ob);

  if (jiaozhu && !jiaozhu->is_fighting())
    jiaozhu->kill_ob(ob);

}
void die() {
  object ob = query_temp("my_killer");
  object baoshi;

  if (ob) {
    ob->add_temp("mark/zhuxian", 3);
    ob->add("faith", 1 + random(3));
    ob->add("weiwang", 1 + random(5));
    if (random(2)) {
      switch (random(5)) {
        case 0:
          baoshi = new("/d/baoshi/obj/no_r");
          break;
        case 1:
          baoshi = new("/d/baoshi/obj/no_c");
          break;
        case 2:
          baoshi = new("/d/baoshi/obj/no_g");
          break;
        case 3:
          baoshi = new("/d/baoshi/obj/no_b");
          break;
        case 4:
          if (random(ob->query("combat_exp")) > 6000000)
            baoshi = new("/d/baoshi/obj/no_y");
          else
            baoshi = new("/d/baoshi/obj/no_c");
          break;
      }
      baoshi->move(ob);
      message("channel:rumor", RED + "【谣言】某人：" + ob->query("name") + "拿到了一块闪闪发亮的"
        +baoshi->query("name") + " \n" + NOR, users());
    }
  }

  message_vision(HIM "$N大喝一声：我去也。\n" NOR, this_object());
  destruct(this_object());
  return;
}

int do_daodao() {

  object me = this_object();
  me->command("unwield blade");
  me->command("wield sword");
  me->command("perform fengwu");
  me->command("unwield sword");
  me->command("wield blade");
  me->command("perform hgz");

  return 1;

}
