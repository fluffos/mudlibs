inherit NPC;
#include <ansi.h>

void create()
{
	int flag;
  set_name("火神", ({"huo shen", "huoshen", "shen"}));
  set("gender", "男性");
  set("attitude", "aggressive");
  set("combat_exp", 13000000+random(3000000));
  set("daoxing", 13330000);
  create_family("火云洞", 2, "弟子");
  set("title","截教门人");  

  set("age", 2000);
  set("per", 30);
  set("str", 40);
  set("int", 30);
  set("cor", 40);
  set("cps", 40);
  set("con", 30);
  set("kar",30);
  set("spi",30);
  set("max_kee", 18000);
  set("max_sen", 18000);
  set("force", 18000);
  set("max_force", 6000+random(2000));
  set("max_mana", 6000+random(2000));
  set("mana",12000+random(4000));
  set("mana_factor",300+random(100));  
  set("force_factor",300+random(100)); 
  set("bellicosity",500);
  set("no_arrest",1);
  if(random(2))
  {
  	flag = 1;
  set_skill("literate", 400+random(100));   
  set_skill("spells", 400+random(100));
  set_skill("force", 400+random(100));
  set_skill("unarmed", 400+random(100));
  set_skill("parry", 400+random(100));
  set_skill("dodge", 400+random(100));
  set_skill("spear", 400+random(100));
  
  set_skill("huomoforce", 400+random(100));  
  set_skill("pingtian-dafa", 400+random(100));  
  set_skill("moshenbu", 400+random(100));
  set_skill("moyun-shou", 400+random(100));
  set_skill("wuyue-spear", 400+random(100));
  
  map_skill("dodge", "moshenbu");
  map_skill("unarmed", "moyun-shou");
  map_skill("spells", "pingtian-dafa");
  map_skill("force", "huomoforce");
  map_skill("spear", "wuyue-spear");
  map_skill("parry", "wuyue-spear");
  
         set("chat_chance_combat", 88);
         set("chat_msg_combat", ({
        (: cast_spell, "sanmei" :),
        (: perform_action, "spear", "buhui" :),
        (: perform_action, "spear", "fengchan" :),        
        (: perform_action, "unarmed", "zhangxinlei" :),      
       }));
       
       
        
}
else
{
	 set_skill("literate", 400+random(100));   
	  set_skill("spells", 400+random(100));
	  set_skill("force", 400+random(100));
	  set_skill("unarmed", 400+random(100));
	  set_skill("parry", 400+random(100));
	  set_skill("dodge", 400+random(100));
	  set_skill("stick", 400+random(100));
	  
	  set_skill("huomoforce", 400+random(100));  
	  set_skill("pingtian-dafa", 400+random(100));  
	  set_skill("moshenbu", 400+random(100));
	  set_skill("moyun-shou", 400+random(100));
	  set_skill("dali-bang", 400+random(100));
	  
	  map_skill("dodge", "moshenbu");
	  map_skill("unarmed", "moyun-shou");
	  map_skill("spells", "pingtian-dafa");
	  map_skill("force", "huomoforce");
	  map_skill("stick", "dali-bang");
	  map_skill("parry", "dali-bang");
	  
	         set("chat_chance_combat", 85);
	         set("chat_msg_combat", ({
	        (: cast_spell, "sanmei" :),
	        (: perform_action, "stick", "shenli" :),
	        (: perform_action, "stick", "lianying" :),        
	        (: perform_action, "unarmed", "zhangxinlei" :),      
	       }));
	       
	      
	
}
        set_temp("apply/armor", 640);
        set_temp("apply/damage",180);
        set_temp("apply/armor_vs_force",300);
        set_temp("apply/defense", 120);
        set_temp("apply/strength",150);
        set_temp("combat/bless",3+random(7));
	    set_temp("combat/lucky",3+random(7));
     
       set("skill_level/spear","grandmaster");
       set("skill_level/stick","grandmaster");
       set_temp("apply/feedback_damage",3000+random(2000));

        set_weight(1000000);
        setup();
      if(random(3))
	  {if(flag)
	       	carry_object("/d/npc/obj/spear")->wield();
	       else
		carry_object("/d/npc/obj/stick")->wield();
	}
	        carry_object("/d/npc/obj/armor")->wear();        
	
	   
}

void kill_ob (object ob)
{
  object me = this_object();
  object jiaozhu;
  object where = environment (me);
  
  jiaozhu = present ("tongtian jiaozhu", where);

  if (me->query("no_move"))
  	me->delete_temp("no_move");
  if (me->query("kee") < me->query("eff_kee")-500)
  	command("exert recover");	
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  
  if (jiaozhu && !jiaozhu->is_fighting() )
    jiaozhu->kill_ob(ob);

}

// tomcat mod
void die()
{
    object ob = query_temp("my_killer");
    object baoshi;
    
    if(ob)
    {
	ob->add_temp("mark/zhuxian", 3);
//	ob->add("faith",1+random(3));
	ob->add("weiwang",1+random(5));
	if( random(2) )
	{
		switch( random(5) )
		{		
	    		case 0:
	    			baoshi = new("/d/baoshi/obj/no_r"); 
	    			break;
	    		case 1:
	    			baoshi = new("/d/baoshi/obj/no_c"); 
	    			break;
	    		case 2:
	    			baoshi = new("/d/baoshi/obj/no_g"); 
	    			break;
	    		case 3:
	    			baoshi = new("/d/baoshi/obj/no_b"); 
	    			break;
	    		case 4:
	    			if( random(ob->query("combat_exp")) > 6000000 )
	    				baoshi = new("/d/baoshi/obj/no_y"); 
	    			else
	    				baoshi = new("/d/baoshi/obj/no_r");
				break;
		}		
		baoshi->move(ob);
		message("channel:rumor",RED+"【谣言】某人："+ob->query("name")+"拿到了一块闪闪发亮的"
			+baoshi->query("name")+" \n"+NOR,users() );
	}
    }
    
    message_vision(HIM"$N大喝一声：我去也。\n"NOR,this_object());
    destruct(this_object());
    return;
}
