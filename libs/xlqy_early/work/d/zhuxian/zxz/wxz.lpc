// by bugbug & alading @ 缥缈水云间, 2003-4-5
inherit ROOM;
#include "bancast.h"

void create() {
  set("short", "万仙阵前");
  set("long", @LONG   
诗有云：
                万仙恶阵列出隈，飒飒寒风劈颈吹
                片片祥光笼斗柄，纷纷杀气透灵台
                鱼龙此际分真伪，玉石从今尽脱胎
                多少修持中此劫，三尸斩去五云开

正是：一团怪雾，几阵寒风；彩霞笼五色金光，瑞云起千丛艳色！
但见，阵门紧闭，门上画有硕大的一个太极图，图中两尾太极鱼宛如
活的一般直欲脱门而出。阴阳两眼不时透出万道霞光！
LONG);
  set("exits", ([
    "south": __DIR__ "lupeng",
  ]));
  set("no_burn", 1);
  set("longzhu", 0);
  set("shengzhu", 0);
  setup();
}

void init() {
  add_action("do_quit", "quit"); add_action("do_sleep", "sleep");
  add_action("do_ji", banned_action);
  add_action("do_cast", ({ "cast", "burn" }));
  add_action("do_hold", "hold");
  add_action("do_inset", "inset");
}
int do_hold(string arg) {
  object what, me;
  me = this_player();
  if (me->query_temp("hold")) {
    tell_object(me, "你手中已经持有东西了！\n");
    return 1;
  }
  if (!arg) {
    tell_object(me, "你要把啥东西持在手中啊？！\n");
    return 1;
  }
  if (arg != "long zhu" && arg != "sheng lingzhu") {
    tell_object(me, "你没事持个什么乱七八糟的东西啊！\n");
    return 1;
  }
  if (!what = present(arg, me)) {
    tell_object(me, "你身上没那个玩意！\n");
    return 1;
  }

  me->set_temp("hold", what);
  message_vision("$N从怀中掏出一颗" + what->query("name") + "持在手中。\n", me);
  return 1;

}
int do_inset(string arg) {
  object what, me;
  string ids;
  me = this_player();
  if (!me->query_temp("hold")) {
    tell_object(me, "你手中没东西啊，塞什么塞！\n");
    return 1;
  }
  what = me->query_temp("hold");
  if (!objectp(what)) {
    tell_object(me, "糟糕，你手中的东西哪里去了？\n");
    me->delete_temp("hold");
    return 1;
  }
  if (!arg) {
    tell_object(me, "你要把手中的东西塞到哪里？\n");
    return 1;
  }
  if (arg != "yin" && arg != "yang") {
    tell_object(me, "你要把手中的东西塞到哪里？\n");
    return 1;
  }
  if (me->query("mana") < 7200) {
    tell_object(me, "你现在法力不足！\n");
    return 1;
  }
  ids = what->query("id");
  if (arg == "yin") {
    if (ids == "long zhu") {
      tell_object(me, "此物性阴,相冲！\n");
      return 1;
    } else {
      message_vision(
        "$N将手中的" + what->query("name") + "高举过头，驱动法力缓缓的将" + what->query("name") + "驭入阴鱼眼中。\n",
        me
      );
      this_object()->set("shengzhu", 1);
    }
  }
  if (arg == "yang") {
    if (ids == "sheng lingzhu") {
      tell_object(me, "此物性阳,相冲！\n");
      return 1;
    } else {
      message_vision(
        "$N将手中的" + what->query("name") + "高举过头，驱动法力缓缓的将" + what->query("name") + "驭入阳鱼眼中。\n",
        me
      );
      this_object()->set("longzhu", 1);
    }
  }
  me->add("mana", -7200);
  me->delete_temp("hold"); destruct(what);
  if (this_object()->query("shengzhu") && this_object()->query("longzhu")) {
    message_vision("突的阵门向两旁分开！\n", me);
    set("exits", ([
      "south": __DIR__ "lupeng",
      "enter": __DIR__ "wxz/liangyi",
    ]));
  }

  return 1;
}
void reset() {
  set("exits", ([
    "south": __DIR__ "lupeng",
  ]));
  set("longzhu", 0);
  set("shengzhu", 0);
  ::reset();
}
