// by flying @ 缥缈水云间


inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "幽谷");
  set("long", HIC + @LONG
    
    小溪中间一块光滑的大石头。好像可以jump back。
LONG + NOR);


  set("exits", ([
    //"south"   : __DIR__"gukou",


  ]));


  set("objects", ([
    "/d/sea/npc/flying": 1,
    "/d/sea/npc/huaner": 1,
  ]));



  set("outdoors", 1);

  setup();
}

void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object ob;
  int new_sen;
  ob = this_player();
  new_sen = random(ob->query("max_sen") * 3);
  if (new_sen > ob->query("sen")) new_sen = ob->query("sen") + 1;
  if (ob->is_busy())
    return 0;
  if (!arg || arg == "") return 0;
  if (arg != "back")
    return notify_fail("你想要干什么啊？\n");

  tell_object(ob, HIR "你轻轻一跃，跳回了岸边。\n" NOR);
  message("vision", NOR "只见" + ob->query("name") + "轻轻一跃，跳回了岸边。\n" NOR, environment(ob), ob);
  ob->move(__DIR__ "xiaogu");
  return 1;
}
