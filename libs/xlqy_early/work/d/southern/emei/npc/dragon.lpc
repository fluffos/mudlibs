#include <ansi.h>

inherit NPC;
int begin_chasing();
void create() {
  set_name(HIR "赤炎金猊兽" NOR, ({ "dragon", "shou" }));
  set("long", HIR "赤炎金猊兽原本就是火族图腾神兽，凶厉无匹，因而当时才被列入大荒十大凶兽.
以当时火族赤帝及三十余位高手之力，方能将其降伏，凶焰之炽远非寻常妖兽可以比拟。\n" NOR);
  set("age", 40000);
  set("attitude", "peaceful");

  set("color", HIR);
  set("gender", "男性");
  set("title", HIG "十大神兽" NOR);
  set("str", 40);
  set("int", 40);
  set("per", 20 + random(5));
  set("con", 30);
  set("max_kee", 7000);
  set("max_sen", 7000);
  set("combat_exp", 15000000);
  set("daoxing", 15000000);
  set("water", 5000);
  set("food", 5000);
  set("force", 12000);
  set("max_force", 12000);
  set("mana", 12000);
  set("max_mana", 12000);
  set("force_factor", 250);
  set("mana_factor", 300);

  set("eff_dx", 800000);
  set("nkgain", 800);

  set_skill("unarmed", 250);
  set_skill("force", 250);
  set_skill("dodge", 250);
  set_skill("parry", 250);
  set_skill("spells", 250);
  set_skill("dragon", 300);
  set_skill("dragonforce", 250);
  set_skill("dragon", 300);
  set_skill("seashentong", 250);
  map_skill("dodge", "dragon");
  map_skill("unarmed", "dragon");
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("parry", "dragon");
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
    (: exert_function, "refresh" :),

  }));

  set_temp("apply/attack", 100);
  set_temp("apply/damage", 100);
  set_temp("apply/armor", 500);
  set_temp("apply/defence", 300);




  setup();

}

void kill_ob(object ob) {
  set_temp("no_return", 1);
  set_temp("my_killer", ob);
  call_out("check", 1);
  ::kill_ob(ob);
}

void check() {
  object ob = this_object();
  object me = query_temp("my_killer");

  ob->clear_condition();

  if (!me) return;

  if (!present(me, environment())) {
    remove_call_out("check");
    return;
  }

  switch (random(3)) {
    case 0:
      {

        message_vision(HIC "$N昂首咆哮,一道赤红火球怒射而出！\n", ob);

        if (random(2) == 1) {
          message_vision(HIR "$N一时躲闪不及，被烧了个正着！\n" NOR, me);
          me->add("eff_kee", -query("max_kee") / 9);
          me->add("kee", -query("max_kee") / 9);
          me->add("eff_sen", -query("max_sen") / 9);
          me->add("sen", -query("max_sen") / 9);
        } else
          message_vision(HIG "$N一个急转，躲开这夺命一击！\n" NOR, me);
      }
      break;


  }


  remove_call_out("check");
  call_out("check", 2 + random(3));
}

void die() {
  object ob = query_temp("my_killer");
  object me = this_object();
  this_object()->clear_condition();


  set("eff_kee", 7000);
  set("eff_gin", 7000);
  set("eff_sen", 7000);
  set("kee", 7000);
  set("gin", 7000);
  set("sen", 7000);
  set("force", 12000);
  set("mana", 12000);


  if (random(25) > 19) {
    if (environment())
      message("sound", HIR "赤炎金猊兽" NOR + "缓缓得消失在你眼前。\n\n", environment());
    ob->set("emei/killdragon", 1);
    this_player()->remove_all_killer();
    ob->remove_all_killer();
    destruct(me);

  } else {
    if (environment())
      message("sound", HIR "赤炎金猊兽" NOR + "一声怒吼，又向你扑来。\n\n", environment());
  }

}

void unconcious() {
  die();
}
