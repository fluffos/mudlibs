inherit ROOM;
inherit __DIR__ "ground3";

void full(object);

#include "ground.h"

void create() {
  set("short", "赛场");
  set("long", @LONG

赛场四周是高高的贵宾观礼台，十丈见方的场地上整整齐齐地
铺着一圈彩色玛瑙石，架着香烟袅绕的四个巨大金银铜铁鼎，
场地中间是软松的皮绒织锦毯。

LONG);

  set("exits", ([
    "westup": __DIR__ "west",
    "eastup": __DIR__ "east",
    "northup": __DIR__ "north",
    "southup": __DIR__ "south",
  ]));
  set("objects", ([
    __DIR__ "npc/wei": 1,
    __DIR__ "npc/siguan": 2,
  ]));
  set("no_quit", 1);
  set("no_flee", 1);
  set("broadcast", 1);
  set("no_alert2", 1);
  set("alternative_die", 1);
  setup();
}

void init() {
  object who = this_player();

  if (wizardp(who)) {
    init0();
    init1();
    init2();
    init3();
    call_out("hinting", 1, who);
  }
  add_action("do_fight", "fight");
  add_action("do_fight", "kill");
  // add_action ("do_zhua","zhua");
}

int check_fighters(object who, object ob) {
  object *inv = all_inventory(environment(who));
  object wei = present("wei zheng", environment(who));
  string names = "";
  int i = sizeof(inv);

  if (ob == wei)
    return 0;

  while (i--) {
    if (inv[i] == who || inv[i] == ob || inv[i] == wei)
      continue;
    if (inv[i]->is_fighting())
      names += inv[i]->name();
  }
  if (names != "") {
    //    message_vision ("$N对$n说道：这场上"+names+"等正在拚死厮杀，请稍候片刻！\n",wei,who);
    message("channel:chat", HIW + "【 魏 征 】：这场上" + names + "等正在拚死厮杀，请稍候片刻！\n" + NOR, users());

    return 0;
  }
  if (!userp(who) || !userp(ob))
    return 1;
  call_out("wait_and_announce", 1, who, ob);
  return 1;
}

void wait_and_announce(object who, object ob) {
  mapping match = this_room()->query("match");
  int step;
  string name0, name1, names;

  if (!match)
    return;
  step = match["step"];
  if (step != STEP_FIGHT)
    return;
  if (!who || !ob)
    return;
  name0 = who->query("name");
  name1 = ob->query("name");
  if (strcmp(name0, name1) > 0)
    names = name0 + name1;
  else
    names = name1 + name0;
  if (match["fighters"] == names)
    return;

  match["fighters"] = names;
  announce(name0 + "与" + name1 + "水陆大会生死相搏！\n");
  //  full(who);
  //  full(ob);
  //bugbug,2002-4-18
}

int do_fight(string arg) {
  object who = this_player();
  object ob;

  if (!arg)
    return 0;
  ob = present(arg, environment(who));
  if (!ob)
    return 0;
  if (!check_fighters(who, ob))
    return 1;
  //  ob->start_busy(1);
  // who->start_busy(1);
  "/cmds/std/kill"->main(who, arg);
  return 1;
}

void hinting(object who) {
  tell_object(who, "\n");
  tell_object(who, "◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇\n");
  tell_object(who, "◇大会分筹备、比赛、结束等阶段，不同阶段有不同命令。◇\n");
  tell_object(who, "◇使用命令时请注意是否有其他巫师也在此设置比赛数据。◇\n");
  tell_object(who, "◇　　　　　　　　　　　　　　　　　　　　　　　　　◇\n");
  tell_object(who, "◇请您随时使用 ? 或 what 来查询您可以使用的命令。 　◇\n");
  tell_object(who, "◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇◇\n");
  tell_object(who, "\n");
}

//bugbug,2002-4-18
void full(object me) {
  int force, mana;
  force = (int)me->query("max_force");
  mana = (int)me->query("max_mana");
  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("max_kee"));
  me->set("eff_sen", me->query("max_sen"));
  me->set("sen", me->query("max_sen"));
  me->set("force", force * 2);
  me->set("mana", mana * 2);
  if (me->query_temp("no_move")) me->delete_temp("no_move");
  if (me->query_temp("no_cast")) me->delete_temp("no_cast");
  if (me->query_temp("fengmo")) me->delete_temp("fengmo");
  if (me->query_temp("jinzhou")) me->delete_temp("jinzhou");
  if (me->query_temp("biqi")) me->delete_temp("biqi");

  me->clear_condition();
  me->start_busy(5);
  tell_object(me, "你的状态被巫师恢复成最佳，五秒之后即可出招!!!\n");

  return;
}
int do_zhua(string arg) {
  object me;
  object whoa, whob;
  object yaoa, dana;
  object yaob, danb;
  string a, b;
  int max;
  me = this_player();
  if (!environment(me)) return 0;
  if (!wizardp(me)) return notify_fail("You are not allowed to use this cmds!\n");
  if (!arg) return notify_fail("Please enter player's id!\n");
  printf("zhua whoa whob\n");
  sscanf(arg, "%s %s", a, b);
  if (!whoa = find_player(a))
    return notify_fail("没这个人啊!\n");
  if (!whob = find_player(b))
    return notify_fail("没这个人啊!\n");
  whoa->move(environment(me));
  whob->move(environment(me));
  message_vision(
    "$N手中的水陆大会会旗一挥~~~~~~` \n" + whoa->query("name") + "和" + whob->query("name") + "被请了过来！\n",
    this_player()
  );

  max = whoa->query("max_sen");
  whoa->set("eff_sen", max);
  whoa->set("sen", max);
  max = whoa->query("max_gin");
  whoa->set("force", 2 * me->query("max_force"));
  whoa->set("eff_gin", max);
  whoa->set("mana", 2 * me->query("max_mana"));
  whoa->set("gin", max);
  max = whoa->query("max_kee");
  whoa->set("eff_kee", max);
  whoa->set("kee", max);
  max = whoa->max_food_capacity();
  whoa->set("food", max);
  max = whoa->max_water_capacity();
  whoa->set("water", max);
  whoa->clear_condition();
  me->command("get yao from " + whoa->query("id"));
  me->command("get yao from " + whoa->query("id"));
  me->command("get dan from " + whoa->query("id"));
  me->command("get dan from " + whoa->query("id"));

  max = whob->query("max_sen");
  whob->set("eff_sen", max);
  whob->set("sen", max);
  max = whob->query("max_gin");
  whob->set("force", 2 * me->query("max_force"));
  whob->set("eff_gin", max);
  whob->set("mana", 2 * me->query("max_mana"));
  whob->set("gin", max);
  max = whob->query("max_kee");
  whob->set("eff_kee", max);
  whob->set("kee", max);
  max = whob->max_food_capacity();
  whob->set("food", max);
  max = whob->max_water_capacity();
  whob->set("water", max);
  whob->clear_condition();
  me->command("get yao from " + whob->query("id"));
  me->command("get yao from " + whob->query("id"));
  me->command("get dan from " + whob->query("id"));
  me->command("get dan from " + whob->query("id"));

  yaoa = new("/d/obj/drug/jinchuang");

  yaoa->set_amount(10);
  yaoa->move(whoa);
  dana = new("/d/obj/drug/hunyuandan");
  dana->set_amount(10);
  dana->move(whoa);

  yaob = new("/d/obj/drug/jinchuang");

  yaob->set_amount(10);
  yaob->move(whob);
  danb = new("/d/obj/drug/hunyuandan");
  danb->set_amount(10);
  danb->move(whob);

  whoa->command("kill " + whob->query("id"));
  whob->command("kill " + whoa->query("id"));

  whoa->start_busy(3);
  whob->start_busy(3);
  tell_object(whoa, "比武马上开始，准备出招！\n");
  tell_object(whob, "比武马上开始，准备出招！\n");
  message(
    "channel:chat",
    HIW + "【水陆大会 】：" + whoa->query("name") + "和" + whob->query("name") + "，水陆大会生死相搏！\n" + NOR,
    users()
  );

  return 1;

}
