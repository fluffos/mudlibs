// sleepy专用照片

#include <ansi.h>
inherit ITEM;

void create() {
  string str, desc, name;
  set_name("堕红尘的照片", ({ "Sleepy's photo", "photo" }));
  name = "堕红尘";
  desc = "堕红尘躲在一边幸灾乐祸地笑。\n";
  desc += "广寒宫传人";
  desc += YEL + "从六品 飞骑尉" + NOR;
  desc += "「";
  desc += RED + "我来自杀了，处理后事，欢迎大家来吃我，味美量又足" + NOR;
  desc += "」堕红尘(Sleepy) ";
  desc += HIC + "<输入文字中>。\n" + NOR;
  desc += "她看起来约三十多岁。\n";
  desc += "她" + CYN + "俏脸生春，妙目含情，轻轻一笑，不觉让人怦然心动。" + NOR;
  desc += "\n她身上带着：\n";
  desc += "  " + HIC + "□" + YEL + "绣花小鞋" + "(Shoes)\n" + NOR;
  desc += "  " + HIC + "□" + HIG + "轻纱长裙" + "(Skirt)\n\n" + NOR;
  desc += "黯世帝梵摄于丙寅年八月五日申时三刻。\n";
  str = sprintf("%s的照片\n\n    %s\n", name, desc);
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("value", 100);
    set("long", str);
    set("no_get", 1);
    set("no_sell", 1);

  }
  setup();
}

void init() {
  add_action("do_sign", "sign");
}

int do_sign(string arg) {
  object me = this_player();
  string str;

  if (arg != "photo") return 0;
  //if (query("name")!=me->query("name")+"的照片")
  //     return notify_fail("禁止在别人的照片上乱涂乱画！\n");

  message_vision("$N犹豫了一下，长叹道: 伊人今安在! ,潸然泪下，就此罢笔。\n", me);

  return 1;
}
