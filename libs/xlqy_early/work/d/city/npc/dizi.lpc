// dizi.c

inherit NPC;

void create()
{
	int skill;

	set_name("武馆弟子", ({ "wuguan dizi", "dizi", "trainee" }) );
	set("gender", "男性" );
	set("age", 18+random(10));
	set("long", "你看到一位身材高大的汉子，正在辛苦地操练着。\n");

	set("combat_exp",4000);

    set("eff_kee", 100000);
    set("eff_gin", 100000);
    set("eff_sen", 100000);
    set("kee", 100000);
    set("gin", 100000);
    set("sen", 100000);
    set("force", 10000);
    set("mana", 10000);

	set_skill("dodge", 10);
	set_skill("unarmed", 10);

	setup();
	carry_object("/d/obj/cloth/linen")->wear();
}

void die()
{
  if (environment())
    message("sound", "\n\n如来缓缓一点头：佛法无边！\n\n", environment());

  set("eff_kee", 100000);
  set("eff_gin", 100000);
  set("eff_sen", 100000);
  set("kee", 100000);
  set("gin", 100000);
  set("sen", 100000);
  set("force", 10000);
  set("mana", 10000);
}

void unconcious()
{
  die ();
}

