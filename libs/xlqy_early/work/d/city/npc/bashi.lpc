int ask_name();

inherit F_VENDOR_SALE;
// inherit NPC;
void create() {
  object yaopai;

  set_name("耍把式的", ({ "shua bashi", "man" }));
  set("gender", "男性");
  set("age", 16);

  set("long", "一个街头巷尾耍把式的汉子。\n");
  set("combat_exp", 50000);
  set("attitude", "peaceful");
  set_skill("unarmed", 120);
  set_skill("dodge", 120);
  set_skill("parry", 110);

  set("per", 11);
  set("max_kee", 150);

  set("vendor_goods", ([
    "gaoyao": "/d/obj/drug/gaoyao",
    //                "bonnet": "/u/just/obj/bonnet",
    "xiangyan": "/d/obj/drug/xiangyan",
    "haomao": "/d/obj/magic/hnone",
    //                "huicheng": "/u/just/obj/huicheng",
  ]));


  setup();
  carry_object("/d/obj/cloth/linen")->wear();
  set("chat_chance", 60);
}

void init() {
  add_action("do_vendor_list", "list");
}
