//by gamer@88 
inherit ROOM;
#include <ansi.h>

int do_arrest(string arg);
void create() {
  set("short", "长安府大堂");
  set("long", @LONG

这里是长安府大堂，平日里，官员们就在这里审理案件，
发布法令，抓拿犯人。大堂正中一块牌匾高悬。众衙役手
持水火棍肃立两旁。狗头铡、虎头铡、龙头铡威风凛凛,杀
气腾腾。果然是国法无情，官威如山！

LONG);



  set("exits",
    ([
      "east": __DIR__ "tianjiantai",
    ]));

  set("objects",
    ([  //sizeof() == 1

    ]));

  set("no_clean_up", 0);
  setup();

}
void init() {
  add_action("do_arrest", "arrest");
}
int do_arrest(string arg) {

  string msg, arrest_ob, item;
  int ap, dp, success;
  int leadership, strategy, office, gold;
  int self_busy;
  object target;
  object me = this_player();

  object victim;
  if (!arg)
    return notify_fail("你发布对谁的通缉令？\n");
  if (sscanf(arg, "%s", arrest_ob) != 1) return notify_fail("你发布对谁的通缉令？\n");
  if (me->is_busy())
    return notify_fail("别着急，官要有官威，处理好手头上的事再说。\n");
  if ((string)me->query("family/family_name") != "将军府") {
    message_vision("几个衙役乱棒将$N打出，喝道：大胆草民也敢在此喧哗！\n", me);
    me->receive_damage("kee", 500);

    if (me->query("kee") < 0) {
      me->set("kee", 0);
      me->unconcious();
    }
    me->move("/d/city/tianjiantai");
    return 1;
  }
  if (me->query("office_number") < 500) {
    message_vision("几个衙役乱棒将$N打出，喝道：芝麻小官也想在此开堂问案？\n", me);
    me->receive_damage("kee", 300);

    if (me->query("kee") < 0) {
      me->set("kee", 0);
      me->unconcious();
    }
    me->move("/d/city/tianjiantai");
    return 1;
  }
  gold = 1 + me->query("combat_exp") / 1000000;
  gold = 20000 * gold;
  if (me->query("balance") < gold)
    return notify_fail("师爷咳嗽了两声，道：大人....上次行动的饷银还没发呢。\n");
  leadership = me->query_skill("leadership", 1);
  strategy = me->query_skill("strategy", 1);
  if (leadership > 300) leadership = 300;
  if (time() - me->query_temp("arrest_time") < 360 - leadership) {
    return notify_fail("师爷走了过来，说道：还没到开堂的时候呢，大人你先休息休息吧。\n");

  }

  if (me->query_temp("arrest_number") > 5 + strategy / 50) {
    me->set_temp("arrest_time", time());
    me->delete_temp("arrest_number");
    return notify_fail("师爷走了过来，说道：大人，该退堂了，休息休息再审案吧。\n");
  }

  if (!objectp(target = find_living(arrest_ob)) || !environment(target)) {
    tell_room(environment(me), "\n几个捕快跑过过来，跪禀道：启奏大人，找不到这个人！\n" NOR);
    return 1;
  }
  if (wizardp(target))
    return notify_fail(target->query("name") + "马上过来打你pp了！\n");
  if (environment(target) == environment(me))
    return notify_fail(target->query("name") + "不是已经逮捕归案了嘛！\n");


  if (me->query("force") < 666)
    return notify_fail("师爷从一旁走了过来，说道：大人请先消消气，调理一下内息。\n");
  if (me->query("sen") < 333)
    return notify_fail("师爷从一旁走了过来，说道：大人请先定定神。\n");
  if (me->query("kee") < 333)
    return notify_fail("师爷从一旁走了过来，说道：大人多多保重身体。\n");
  message_vision(
    HIB "\n$N惊堂木一拍，扬手掷下令牌，怒发冲冠喝道：" + HIB "左右人等，速去将" + target->query("name") + "逮捕归案！\n",
    me
  );
  if (!me->query_temp("arrest_number"))
    message(
      "channel:chat",
      RED "【天下通缉令】" + HIW + me->query("name") + "(" + me->query("id") + ")" + HIC "：" HIR + target->query("name") + NOR + HIC "罪大恶极，即刻逮捕归案，以正国法！\n" NOR,
      users()
    );

  msg = HIY "\n几个捕快应声而去。\n" NOR;
  message_vision(msg, me);

  me->add("force", -400);
  me->add("balance", -gold / 2);
  me->receive_damage("sen", 200);
  me->receive_damage("kee", 200);
  me->add_temp("arrest_number", 1);
  success = 1;

  ap = me->query_skill("leadership", 1);
  ap = ap * ap * ap / 10;
  ap += (int)me->query("combat_exp");

  office = me->query("office_number");
  ap = ap / 2000;
  ap = ap * office;

  if (wizardp(me)) {
    printf("%d\n", ap);
  }
  dp = target->query("combat_exp");
  dp = dp + random(dp / 2);
  if (wizardp(me)) {
    printf("%d\n", dp);
  }
  if (random(ap + dp) < dp) success = 0;

  ap = strategy;
  ap = ap * ap * ap / 10;
  ap = ap + random(ap);
  ap = ap / 2100 * office;
  dp = (int)target->query_skill("dodge", 1);
  dp = dp * dp * dp / 10;

  if (wizardp(me)) {
    printf("%d\n", ap);


    printf("%d\n", dp);
  }
  if (random(ap + dp) < dp) success = 0;


  if (environment(target)->query("no_fight")) {
    msg = "不一会儿，捕快跑了回来，跪禀道：大人恕罪，" + HIR + target->query("name") + NOR + "十分狡猾，藏匿在安全区，属下无法拿其归案！\n" NOR;
    message_vision(msg, me);
    return 1;
  }
  if (environment(target)->query("no_burn")) {
    msg = "不一会儿，捕快跑了回来，跪禀道：大人恕罪，" + HIR + target->query("name") + NOR + "已到无法管辖的范围了，属下无法拿其归案！\n" NOR;
    message_vision(msg, me);
    return 1;
  }


  if (target->query("no_arrest")) {
    msg = "不一会儿，捕快跑了回来，跪禀道：大人恕罪，" + HIR + target->query("name") + NOR + "神通广大，属下不可能拿其归案。\n" NOR;
    message_vision(msg, me);
    return 1;
  }
  if (success == 1) {
    me->set_temp("arrest_time", time());
    me->delete_temp("arrest_number");

    tell_room(
      environment(target),
      HIY "几个捕快突然跑了过来，一扬手中铁链说道：" + target->query("name") + "，你的事犯了，跟我们走一趟吧！\n" NOR
    );
    tell_room(environment(target), HIR "捕快们合力擒住" + target->query("name") + "，套上镣铐头枷押送回衙。\n" NOR);

    target->move(environment(me));
    msg = "不一会儿，捕快押着五花大绑的$n往地上一推，说道：启禀大人，犯人" + HIR + target->query("name") + NOR + "带到！\n" NOR;
    message_vision(msg, me, target);
    me->add("balance", -gold);
    if (random(me->query("combat_exp")) * 2 < target->query("combat_exp")) {
      message_vision(HIR "突然$N用了挣了几下，身上绳索铁链尽断!$n不禁大吃一惊！\n" NOR, target, me);
      me->kill_ob(target);
      target->kill_ob(me);
      target->start_busy((int)(strategy / 50) + 1);
      self_busy = random(30 - me->query("cps"));
      if (self_busy < 1) self_busy = 1;
      if (self_busy > 5) self_busy = 5;

      me->start_busy(random(self_busy) + 1);
      return 1;
    }
    message_vision(HIW "$N喝道：" + target->query("name") + "，你可知罪！\n" NOR, me);
    message_vision(HIR "$N说道：" + RANK_D->query_self_rude(target) + "何罪之有！\n" NOR, target);
    me->kill_ob(target);
    target->kill_ob(me);
    target->start_busy(random((int)(strategy / 50)) + 2);
    me->start_busy(random(2));
    return 1;


  }
  tell_room(
    environment(target),
    HIY "几个捕快突然跑了过来，一扬手中铁链说道：" + target->query("name") + "，你的事犯了，跟我们走一趟吧！\n" NOR
  );
  tell_room(environment(target), HIR + target->query("name") + "冷笑一声，打的捕快们哭爹喊娘，仓惶逃离。\n" NOR);

  msg = "不一会儿，捕快跑了回来，跪禀道：大人恕罪，" + HIR + target->query("name") + NOR + "拒捕，属下难以拿其归案！\n" NOR;
  message_vision(msg, me);
  me->start_busy(random(2));

  return 1;

}
