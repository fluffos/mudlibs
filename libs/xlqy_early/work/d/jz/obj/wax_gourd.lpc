inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("冬瓜", ({"dong gua","wax gourd", "chinese watermelon"}));
    set_weight(80);
    if (clonep())
	set_default_object(__FILE__);
    else {
	set("long", "胖乎乎的新鲜冬瓜。\n");
	set("unit", "个");
	set("value", 120);
	set("food_remaining", 3);
	set("food_supply", 35);
    }
}


