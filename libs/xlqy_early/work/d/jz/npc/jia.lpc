inherit F_VENDOR_SALE;
void create()
{
    reload("jia");

    set_name("贾老板", ({"jia laoban", "jia", "laoban"}));
    set("title","瓜果店老板");
    set("gender","男性");

    set("per",30);
    set("age", 32);
    set("long","看上去很精明的中年老板。\n");
    set("attitude", "peaceful");
    set("combat_exp", 15000);
    set("daoxing",15000);	
    set_skill("dodge", 30);
    set("vendor_goods", ([
	"dong gua":"/d/jz/obj/wax_gourd",
	"yinxing": "/d/jz/obj/yinxing",
      ]));
    setup();
    carry_object("/d/obj/cloth/linen")->wear();
    add_money("coin", 100);
}
void init()
{
    object ob;
    ::init();
    add_action("do_vendor_list", "list");

}

