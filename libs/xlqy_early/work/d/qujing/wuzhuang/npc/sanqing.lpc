inherit NPC; 
 
#include <ansi.h> 
void copy_status(object me, int level);
void set_skills(int max_value, int level);
void set_hp_status(object me, int level);
void create() 
{         
        set_name("三清",({ "sanqing"}));
        create_family("五庄观", 1, "祖师");
        set("age", 100+random(80)); 
        set("gender", random(2)?"男性":"女性"); 
        set("attitude", "heroism"); 
        set("per", 40); 
        set("str", 40); 
        set("cor", 40); 
        set("con", 40); 
        set("int", 40); 
        set("spi", 40); 
        set("cps", 40); 
        set("kar", 40); 
        set("max_gin", 1000); 
        set("food", 10000); 
        set("water", 10000); 
        set_weight(30000); 
        set("no_steal",1); 
        set("no_arrest",1); 
       

 	set_temp("wuxing/init_done",1);   
 	setup(); 
} 
 
 
void invocation(object me, int level) 
{ 
        object guai,env;         
        guai=this_object(); 
        copy_status(me, level); 
  
} 
 
void copy_status(object me, int level) 
{ 
	int max_value = me->query_skill("taiyi",1);
if(me->query_temp("wzg_set")) max_value += max_value/3;
         set_skills(max_value, level); 
         set_hp_status(me,level); 
        delete_temp("wuxing/init_done");
	WUXING_D->init_user_wuxing(this_object());       
}          
           
void set_skills(int max_value, int level) 
{ 
        object guai=this_object();        
        int guai_value; 
 guai_value = max_value*2/3+random(max_value/3);
        if(level == 0)
        {
        	set("name",HIC"上清者天"NOR);
	        set_skill("unarmed", guai_value+random(16)); 
	        set_skill("dodge", guai_value+random(16)); 
	        set_skill("parry", guai_value+random(16)); 
	        set_skill("force", guai_value+random(16)); 
	        set_skill("spells", guai_value+20+random(16)); 
	        set_skill("wuxing-quan", guai_value+random(16));
	        set_skill("baguazhen", guai_value+random(16));
	        set_skill("blade", guai_value+random(16));
	        set_skill("yange-blade", guai_value+random(16));
	        set_skill("zhenyuan-force", guai_value+random(16));
	        set_skill("literate", 180);
	        set_skill("taiyi", guai_value+20+random(16));
	        map_skill("spells", "taiyi");
	        map_skill("force", "zhenyuan-force");
	        map_skill("unarmed", "wuxing-quan");
	        map_skill("blade", "yange-blade");
	        map_skill("parry", "yange-blade");
	        map_skill("dodge", "baguazhen");
      
              if(guai_value > 200)
        	 set("skill_level/blade","expert");
              else if(guai_value > 300)
               	 set("skill_level/blade","master"); 
set("force_factor", query_skill("force")/3);
        	set("mana_factor", query_skill("spells",1));
        	carry_object("/d/npc/obj/blade.lpc")->wield();
        	guai->reset_action();
	
	}
	else if(level ==1)
	{
		set("name",HIY"中清者人"NOR);
		 set_skill("unarmed", guai_value+random(16)); 
	        set_skill("dodge", guai_value+random(16)); 
	        set_skill("parry", guai_value+random(16)); 
	        set_skill("force", guai_value+random(16)); 
	        set_skill("spells", guai_value+20+random(16)); 
	        set_skill("wuxing-quan", guai_value+random(16));
	        set_skill("baguazhen", guai_value+random(16));
	        set_skill("sword", guai_value+random(16));
	        set_skill("sanqing-jian", guai_value+random(16));
	        set_skill("zhenyuan-force", guai_value+random(16));
	        set_skill("literate", 180);
	        set_skill("taiyi", guai_value+20+random(16));
	        map_skill("spells", "taiyi");
	        map_skill("force", "zhenyuan-force");
	        map_skill("unarmed", "wuxing-quan");
	        map_skill("sword", "sanqing-jian");
	        map_skill("parry", "sanqing-jian");
	        map_skill("dodge", "baguazhen");
      
              if(guai_value > 200)
        	 set("skill_level/sword","expert");
              else if(guai_value > 300)
               	 set("skill_level/sword","master"); 
set("force_factor", query_skill("force")/3);
        	set("mana_factor", query_skill("spells",1));
		carry_object("/d/npc/obj/sword.lpc")->wield();
        	guai->reset_action();
		
	}
	else if(level ==2)
	{
		set("name",HIB"下清者地"NOR);
		 set_skill("unarmed", guai_value+random(16)); 
	        set_skill("dodge", guai_value+random(16)); 
	        set_skill("parry", guai_value+random(16)); 
	        set_skill("force", guai_value+random(16)); 
	        set_skill("spells", guai_value+20+random(16)); 
	        set_skill("wuxing-quan", guai_value+random(16));
	        set_skill("baguazhen", guai_value+random(16));
	        set_skill("staff", guai_value+random(16));
	        set_skill("fumo-zhang", guai_value+random(16));
	        set_skill("zhenyuan-force", guai_value+random(16));
	        set_skill("literate", 180);
	        set_skill("taiyi", guai_value+20+random(16));
	        map_skill("spells", "taiyi");
	        map_skill("force", "zhenyuan-force");
	        map_skill("unarmed", "wuxing-quan");
	        map_skill("staff", "fumo-zhang");
	        map_skill("parry", "fumo-zhang");
	        map_skill("dodge", "baguazhen");
      
              if(guai_value > 200)
        	 set("skill_level/staff","expert");
              else if(guai_value > 300)
               	 set("skill_level/staff","master"); 
set("force_factor", query_skill("force")/3);
        	set("mana_factor", query_skill("spells",1));
		carry_object("/d/npc/obj/staff.lpc")->wield();
        	guai->reset_action();
		
	}
}        
 
 
void set_hp_status(object me, int level) 
{    
		set("kee",3000);
		set("max_kee",3000);
		set("eff_kee",3000);
		set("sen",3000);
		set("max_sen",3000);
		set("eff_sen",3000);
		set("force",2*me->query("max_force"));
		set("max_force",me->query("max_force"));
		set("mana",2*me->query("max_mana"));
		set("max_mana",me->query("max_mana"));
		
set("combat_exp", me->query("combat_exp")*2/3+random(me->query("combat_exp")/3));
                set("daoxing", me->query("daoxing")); 
                set_temp("apply/armor", me->query_skill("spells")); 
set_temp("apply/damage",  me->query_skill("taiyi",1)/3+random(me->query_skill("taiyi",1)*2/3));
  set_temp("apply/attack",  me->query_skill("taiyi",1)/9);
} 
