#include <ansi.h>;
inherit ITEM;
inherit F_FOOD;

void create()
{
  set_name(HIC"喜鹊"NOR, ({"xique"}));
  set_weight(60);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", @LONG
一只能呼朋引伴的喜鹊，正在叽叽喳喳叫个不停。
如果你能捉(zhuo)到许多这样的喜鹊，就可以搭出一座鹊桥来。

LONG);
    set("no_drop", "喜鹊丢了可就再也抓不回来了。\n");
    set("no_give", "喜鹊可不是能随便给人的。\n");
    set("no_sell", "当铺不收这种东西。\n");
    set("no_get", "喜鹊扑楞了几下翅膀,飞走了。\n");
    set("unit", "只");
    set("value", 0);
    set("food_remaining", 5);
    set("food_supply", 30);
  }
}

