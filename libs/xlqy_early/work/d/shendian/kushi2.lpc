#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIC "天神台三层" NOR);
  set("long", @LONG

这里是天神台上的其中一个阁楼。众神常在此处修炼法力。

LONG);
  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "kushi1",
  ]));
  set("meditate_more_effect", 1);
  set("no_quit", 1);
  set("no_flee", 1);
  set("alternative_die", 1);
  set("outdoors", 1);
  setup();
}
void init() {
  add_action("do_dazuo", ({ "mingsi", "meditate" }));
}

int do_dazuo() {
  object who = this_player();
  if (!who->query("9sky/all")) {
    tell_object(who, "你从何处来？\n");
    who->move("/d/city/kezhan");
    return 1;
  }
  return 0;
}

void alternative_die(object me) {
  object ob;
  ob = me->query_temp("last_damage_from");
  if (!ob)
    return;

  if (!userp(ob)) {
    destruct(ob);
    return;
  }
  if (!userp(me)) {
    destruct(me);
    return;
  }
}
