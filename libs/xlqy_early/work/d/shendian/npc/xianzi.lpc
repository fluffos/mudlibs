#include <ansi.h>

inherit NPC;
void create() {
  set_name(HIW "凌波仙子" NOR, ({ "lingbo xianzi", "xianzi" }));
  set("gender", "女性");
  set("long", "容貌瑞丽，国色天姿，宛然如蕊宫仙子临凡\n");
  set("age", 25);
  set("title", HIC "天山神女" NOR);
  set("attitude", "heroism");
  set("str", 50);
  set("int", 40);
  set("per", 40);
  set("max_kee", 8000);
  set("kee", 8000);
  set("max_sen", 8000);
  set("sen", 8000);
  set("combat_exp", 25000000);
  set("daoxing", 75000000);
  set("force", 10000);
  set("mana", 10000);
  set("max_force", 10000);
  set("max_mana", 10000);
  set("force_factor", 400);
  set("mana_factor", 400);
  set("eff_dx", 4500000);
  set("nkgain", 1500);

  set_skill("lotusforce", 400);
  set_skill("moonforce", 400);
  set_skill("zhenyuan-force", 400);
  set_skill("wuxiangforce", 400);
  set_skill("dragonforce", 400);
  set_skill("jiuyin-xinjing", 400);
  set_skill("ningxie-force", 400);
  set_skill("huomoforce", 400);
  set_skill("lengquan-force", 400);
  set_skill("zixia-shengong", 400);
  set_skill("huntian-qigong", 400);
  set_skill("tonsillit", 400);
  set_skill("starforce", 400);
  set_skill("wanxi-force", 400);

  set_skill("force", 350);

  map_skill("force", "moonforce");
  set("inquiry", ([
    "name": "小女子乃逍遥派祖师。",
  ])
  );
  setup();
  carry_object("/d/moon/obj/luoyi")->wear();
}
int recognize_apprentice(object ob) {
  if (ob->query("faith") < (ob->query("betray/count") + 1) * 600)
    return notify_fail("你还需要为门派多做些事情！\n");
  if (ob->query_skill(
    ob->query_skill_mapped("force"),
    1
  ) - ob->query_temp("apply/add_all_skill") < 350
    || ob->query_skill("force", 1) - ob->query_temp("apply/add_all_skill") < 360)
    return notify_fail("你的内功底子太差，学好了再来吧！\n");
  if (!(int)ob->query_temp("mark/人"))
    return notify_fail(HIW "你先去十绝阵练练再来学吧！\n" NOR);

  ob->add_temp("mark/人", -1);

  return 1;
}
