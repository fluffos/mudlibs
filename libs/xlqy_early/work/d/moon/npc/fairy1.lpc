inherit NPC_MOON;

void create() {
  ::create();

  set("long",
    "翩若惊鸿，婉若游龙，荣曜秋菊，华茂春松。仿佛兮若
轻云之蔽月，飘摇兮若流风之回雪。远而望之，皎若太阳
升朝霞。迫而察之，灼若芙渠出绿波。\n");

  set("title", "月宫舞仙");
  set("age", 18);

  set("per", 30);
  set("int", 30);
  set("combat_exp", 100000);
  set("daoxing", 50000);

  carry_object("/d/obj/cloth/luoyi")->wear();
  carry_object("/d/obj/weapon/sword/snow_sword")->wield();

  ::generate_me(0, 100, 100, 3, 0, 0, "菊影", ({ "shade", "juying", "fairy" }), 0);
}
