inherit NPC_MOON;

void create()
{
    ::create();

    set("long",
"其披罗衣之璀粲兮，珥瑶碧之华琚。戴金翠之首饰，缀明珠以耀躯。践
远游之文履，曳雾绡之轻裾。微幽兰之芳蔼兮，步踟蹰于山隅。\n");

    set("title", "月宫伺女");
    set("age", 18);

    set("per", 30);
    set("int", 30);
    set("combat_exp", 100000);
    set("daoxing", 50000);

    carry_object("/d/obj/cloth/luoyi")->wear();
    carry_object("/d/obj/weapon/sword/snow_sword")->wield();

    ::generate_me(0, 100, 100, 3, 0, 0, "锄药",({"chu yao","chu yao", "fairy"}), 0);
}

