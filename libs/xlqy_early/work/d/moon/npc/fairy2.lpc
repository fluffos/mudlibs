inherit NPC_MOON;

void create()
{
    ::create();

    set("long",
"其珠翠之辉辉兮，满额鹅黄。出没花间兮，宜嗔宜喜；徘徊池上兮，
若飞若扬。蛾眉颦笑兮，将言而未语；莲步乍移兮，欲止而欲行。\n");

    set("title", "月宫舞仙");
    set("age", 18);

    set("per", 30);
    set("int", 30);
    set("combat_exp", 100000);
    set("daoxing", 50000);

    carry_object("/d/obj/cloth/luoyi")->wear();
    carry_object("/d/obj/weapon/sword/snow_sword")->wield();

    ::generate_me(0, 100, 100, 3, 0, 0, "茗烟",({"ming yan","fairy", "girl"}), 0);
}

