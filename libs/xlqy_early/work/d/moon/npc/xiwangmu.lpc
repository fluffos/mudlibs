inherit NPC_MOON;

#include <ansi.h>

int ask_sword();
string avenge();

void create() {
  ::create();

  set("long", "西华至妙生伊川，穆王八骑访昆仑。\n");

  set("age", 100);

  set("per", 30);
  set("int", 30);

  set("combat_exp", 5000000);
  set("daoxing", 5000000);

  create_family("月宫", 3, "弟子");

  carry_object("/d/obj/cloth/tianyi.lpc")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
  carry_object("/d/ourhome/obj/shoes")->wear();

  ::generate_me(0, 1500, 1500, 3, 0, 90, "西王母", ({ "xi wangmu", "xi", "wangmu", "master" }), 0);

  set("rank_info/respect", "老太太");

  set("inquiry", ([
    "传言": (: ask_sword :),
    "复仇": (: avenge :),
  ]));
}

int go_next(object me) {
  object room;

  if (!me) {
    return 0;
  }

  if (!(room = find_object("/d/ourhome/honglou/dreamland/dreamland"))) {
    room = load_object("/d/ourhome/honglou/dreamland/dreamland");
  }

  if (objectp(room)) {
    message_vision("$N在$n的法力的笼罩下消失了\n", me, this_object());
    me->move(room);
  }

  return 1;
}

int confirm_me() {
  object me = this_player();

  if (me->query_temp("qingsuo/ask_xi")) {
    me->delete_temp("qingsuo/ask_xi");
    me->set_temp("qingsuo/confirm_xi", 1);
    command("sigh");
    message_vision("$N说道，既然如此，我就助你一臂之力吧。\n", this_object());
    call_out("go_next", 3, me);
    return 1;
  }

  return 0;
}

int ask_sword() {
  object me = this_player();

  if (me->query_temp("qingsuo/ask_girl")) {
    me->delete_temp("qingsuo/ask_girl");

    if (present("sheng lingzhu", me)) {
      me->set_temp("qingsuo/ask_xi", 1);
      command("pat " + me->query("id"));
      message_vision("$N说道" + "：这位" + RANK_D->query_respect(me) + ",你真的决定要一探究竟吗？(yes/no)\n",
        this_object(), me);
      add_action("confirm_me", "yes");
      return 1;
    }

    command("sigh " + me->query("id"));
    return 1;
  }

  return 0;
}

string avenge() {
  object who = this_player(), killer, where;
  string killid;

  if ((string)who->query("family/family_name") != "月宫") {
    return ("你不是本派弟子，生死与我何干？");
  }

  if (who->query("faith") < 1000) {
    return ("你在本门名望还不够，还需多加努力才行。");
  }

  if (who->query("avenge/mud_age") >= who->query("death/mud_age")) {
    return ("老身未闻死讯");
  }

  killid = who->query("kill/last_killer");
  killer = find_living(killid);

  if (!killer || !userp(killer)) {
    return ("这个嘛，老身还得想一想");
  }

  command("say 老身这就去为你抱仇。");
  who->set("avenge/mud_age", who->query("mud_age"));
  where = environment(who);

  tell_room(where, "只见西王母向空中一指：\n");
  tell_room(where, "护法天尊何在，速去将" + killer->query("name") + "抓来。\n");
  tell_room(environment(killer), "空中伸出一只大手将" + killer->query("name") + "抓走了。\n");

  killer->move(where);
  tell_room(where, killer->query("name") + "被从空中扔了下来。\n");

  command("say 大胆妖孽，胆敢杀害我月宫弟子。");
  this_object()->kill_ob(killer);

  return "拿命来。";
}

void attempt_apprentice(object ob) {
  if ((string)ob->query("family/family_name") == "月宫") {
    if (((int)ob->query("combat_exp") < 100000)) {
      command("say " + RANK_D->query_respect(ob) + "的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
      return;
    }
  }

  ::attempt_apprentice(ob);
  return;
}

int accept_fight(object me) {
  return 0;
}
