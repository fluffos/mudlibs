inherit FAMILYMASTER;

void create()
{
    ::create();

    set_name("麻姑", ({"ma gu"}));
    set("gender", "女性");
    set("age", 35);

    set("title","月宫管家");
    set("long", "麻姑在月宫可是里里外外一把手。\n");

    set("combat_exp", 5000);
    set("daoxing", 5000);

    set("attitude", "peaceful");

    set("per", 15);

    carry_object("/d/ourhome/obj/pink_cloth")->wear();
    carry_object("/d/ourhome/obj/shoes")->wear();

    set_inquiry("灭妖");

    create_family("月宫", 5, "蓝");

    set("path", "moon");

    setup();
}

