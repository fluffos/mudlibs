inherit NPC_MOON;

void create()
{
    ::create();

    set("long", "她乃是桂树采天地之精华化成，后拜嫦娥为师．\n");

    set("age", 20);

    set("per", 30);
    set("int", 30);

    set("combat_exp", 200000);
    set("daoxing", 200000);

    create_family("月宫", 6, "弟子");

    carry_object("/d/moon/obj/luoyi")->wear();

    ::generate_me(0, 100, 100, 3, 0, 0, "月奴", ({"yue nu", "yuenu", "yue"}), 0);
}

