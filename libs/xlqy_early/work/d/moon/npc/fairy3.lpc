inherit NPC_MOON;

void create() {
  ::create();

  set("long",
    "其仿佛兮若轻云之蔽月，飘摇兮若流风之回雪。远而望之，皎若
太阳升朝霞。迫而察之，灼若芙渠出绿波。\n");

  set("title", "月宫伺女");
  set("age", 18);

  set("per", 30);
  set("int", 30);
  set("combat_exp", 100000);
  set("daoxing", 50000);

  carry_object("/d/obj/cloth/luoyi")->wear();
  carry_object("/d/obj/weapon/sword/snow_sword")->wield();

  ::generate_me(0, 100, 100, 3, 0, 0, "抱琴", ({ "bao qin", "fairy", "girl" }), 0);
}
