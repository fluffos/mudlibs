inherit NPC_MOON;

void create()
{
    ::create();

    set("long",
"西王母的大弟子。早年因帮助丈夫盗取西王母之灵药而\n与其师势成水火。后得和解并邀西王母出掌月宫一门。\n");

    set("title", "月宫主人");
    set("age", 20);

    set("per", 30);
    set("int", 30);

    set("combat_exp", 800000);
    set("daoxing", 800000);

    create_family("月宫", 4, "弟子");

    carry_object("/d/moon/obj/luoyi")->wear();
    carry_object("/d/moon/obj/feijian")->wield();

    ::generate_me(0, 1000, 1000, 3, 0, 90, "嫦娥", ({"chang e", "change", "chang", "master"}), 0);
}

void attempt_apprentice(object ob)
{
    if ( (int)ob->query("per") < 22 )
    {
        command("shake");
        command("say 以我看这位" + RANK_D->query_respect(ob) + "的资质并不适于跳舞，还是另请高就吧。\n");
        return;
    }

    ::attempt_apprentice(ob);
    return;
}

