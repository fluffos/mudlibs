inherit NPC_MOON;

void create() {
  ::create();

  set("long",
    "玉兔仙原本只是嫦娥的宠物，因吃了嫦娥掉在地上的灵药而成人形。玉兔
因灵药之事被王母罚去捣药，久而久之竟颇通药道。\n");

  set("age", 20);

  set("per", 30);
  set("int", 30);

  set("combat_exp", 200000);
  set("daoxing", 200000);

  create_family("月宫", 6, "弟子");

  carry_object("/d/moon/obj/luoyi")->wear();

  ::generate_me(0, 100, 100, 3, 0, 0, "玉兔", ({ "yu tu", "rabbit", "jade rabbit" }), 0);
}
