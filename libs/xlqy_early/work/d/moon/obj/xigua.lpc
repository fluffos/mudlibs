#include <ansi.h>

//xigua.c
//by efflux

inherit ITEM;

void create() {
  set_name("西瓜", ({ "xi gua", "gua", "watermelon" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一块消暑解渴的西瓜！\n" +
      HIG
      "######" HIR "#########################" GRN "######\n" +
      "###" NOR + GRN "@@@" HIG "#" HIR "#######################" GRN "##" NOR + GRN "@@" HIG "###\n" +
      " ###" NOR + GRN "@@" HIG "##" HIR "#####################" GRN "#/" NOR + GRN "@@" HIG "###\n" +
      " =##." NOR + GRN "@@" HIG "#" HIR "####################" GRN "#=" NOR + GRN "@@@" HIG "###\n" +
      "  /#+" NOR + GRN "@@@" HIG "+#" HIR "################" GRN "##" NOR + GRN "@@@@" HIG ",##\n" +
      "  .##," NOR + GRN "@@@@" HIG "/#" HIR "#############" GRN "#=" NOR + GRN "@@@@" HIG "/##\n" +
      "   +##-" NOR + GRN "@@@@@@" HIG "/#" HIR "#######" GRN "#:." NOR + GRN "@@@@@" HIG ",##\n" +
      "     ##/" NOR + GRN "@@@@@@@@" HIG "-===-" NOR + GRN "@@@@@@@" HIG ":###\n" +
      "      ./####-" NOR + GRN "@@@@@@@@@" HIG ".,=:####\n" +
      "         ./+###############/\n" NOR
    );
    set("unit", "块");
    set("value", 25);
    set("remaining", 3);
  }
  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me;
  me = this_player();

  if (!id(arg) || !present("xi gua", me))
    return 0;
  if (!this_object()->id(arg)) return 0;
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
  if (!query("remaining"))
    return notify_fail(name() + "已经没什么好吃的了。\n");

  if ((int)me->query("food") >= (int)me->max_food_capacity() ||
    (int)me->query("water") >= (int)me->max_water_capacity())
    return notify_fail("你已经吃得太饱了，再也吃不下一口西瓜了。\n");

  set("value", 0);
  me->add("water", 30);
  me->add("food", 30);
  me->add("potential", 100000);

  if (this_player()->is_fighting()) this_player()->start_busy(2);

  add("remaining", -1);
  if (!query("remaining")) {
    if ((int)me->query("food") < (int)me->max_food_capacity() * 2 / 3 &&
      (int)me->query("water") < (int)me->max_water_capacity() * 2 / 3)
      message_vision("$N将剩下的西瓜吃得干干净净，差点连西瓜皮也吃下肚子。\n", me);
    else
      message_vision("$N将剩下的西瓜吃得干干净净，觉得消暑又解渴。\n", me);
    destruct(this_object());
  } else if ((int)me->query("food") < (int)me->max_food_capacity() / 3 &&
    (int)me->query("water") < (int)me->max_water_capacity() / 3)
    message_vision("$N拿起西瓜，狼吞虎咽地吃了起来，西瓜籽乱飞！\n", me);
  else {
    if ((int)me->query("food") < (int)me->max_food_capacity() * 2 / 3 &&
      (int)me->query("water") < (int)me->max_water_capacity() * 2 / 3)
      message_vision("$N拿起西瓜，大口大口地吃了起来。\n", me);
    else
      message_vision("$N拿起西瓜津津有味地咬了几口。\n", me);
  }
  return 1;
}
