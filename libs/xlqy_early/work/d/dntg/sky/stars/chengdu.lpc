#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name(HIR"宇文成都"NOR, ({ "star chengdu", "chengdu", "cheng du" }));
        set("title",BLINK HIW"柳土星官"NOR);
        set("long", 
BLINK HIC "锦官城内一剑客,府南河旁斩妖魔。\n");
        set("gender", "男性");
        set("age", 77);
        set("attitude", "peaceful");
        set("str", 30);
        set("int", 40);
        set("con", 30);
        set("per", 30);
        set("kee", 1822);
        set("max_kee", 1822);
        set("sen", 1446);
        set("max_sen", 1446);
        set("force", 8000);
        set("max_force", 4763);
        set("mana", 8000);
        set("max_mana", 4455);
        set("force_factor", 235);
        set("mana_factor", 222);

        set("combat_exp", 10843109);
        set("daoxing", 6940000);

        set_skill("force", 348);
        set_skill("dodge", 440);
        set_skill("parry", 441);
        set_skill("whip", 286);
        set_skill("unarmed",402);
set_skill("fumozhang",402);
set_skill("sevensteps",440);
set_skill("zixia-shengong",303);
set_skill("yirubian",442);
        set_skill("literate", 195);
        set_skill("taoism",313);
        set_skill("canxin-jian",329);
        set_skill("mindsword",421);
        map_skill("spells", "taoism");
map_skill("force", "zixia-shengong");
map_skill("unarmed", "fumozhang");
map_skill("dodge", "sevensteps");
map_skill("parry", "yirubian");
map_skill("whip", "yirubian");
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: exert_function, "recover" :),
(: perform_action, "whip","snake" :),
                (: exert_function, "powerup" :),
        }) );
        setup();
       carry_object("/obj/cloth")->wear();
carry_object("/d/obj/weapon/whip/snakewhip")->wield();
}
void attempt_apprentice(object me)
{
me =this_player();
/* if ( !((string)me->query("gender")=="女性"))
		{
        command("shake");
        command("say 我只收女徒，这位" +
 RANK_D->query_respect(me) + "还是另请高就吧。\n");
           return ;
} */
if (me->query("nyj/shushan") != "done")
{
command("say 我现在还在担心着灵儿妹子……");
return;
}
command("pat "+me->query("id"));
command("say 既然" + RANK_D->query_respect(me) +"心向蜀山，那我只好收你为徒。\n");
command("recruit " + me->query("id") );
        return ;
}




