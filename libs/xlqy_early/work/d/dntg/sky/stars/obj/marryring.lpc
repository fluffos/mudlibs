#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create() {
  set_name(HIB "冷月凝霜" NOR, ({ "marryring" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "结婚钻戒。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}
