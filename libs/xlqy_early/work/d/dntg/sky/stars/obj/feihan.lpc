#include <armor.h>
#include <ansi.h>

inherit WRISTS;

void create() {
  set_name(HIC "雪舞飞寒" NOR, ({ "feihan" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "幕");
    set("long", "雪舞飞寒。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}
