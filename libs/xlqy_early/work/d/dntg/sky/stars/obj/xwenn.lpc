#include <armor.h>
#include <ansi.h>

inherit NECK;

void create() {
  set_name(HIR "相思红豆" NOR, ({ "xwenn" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗相思红豆寄托了我对翎儿的无限思念。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}
