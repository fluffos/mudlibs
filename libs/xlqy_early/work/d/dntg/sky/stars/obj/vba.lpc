#include <armor.h>
#include <ansi.h>

inherit WRISTS;

void create()
{
  set_name("成都之梦", ({ "vba" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
  set("long", "博爱的天堂。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}

