#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
        set_name(HIG "小楼一夜听春雨" NOR, ({"rain"}));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "幅");
                set("long", "春雨潇潇，独上小楼，一夜听雨，愁满心头。\n");
                set("value", 0);
                set("material", "steel");
              set("keenness", 50);
        }
        init_blade(10);
        setup();
}


