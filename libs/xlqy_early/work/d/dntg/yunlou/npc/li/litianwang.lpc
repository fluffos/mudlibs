inherit NPC;
inherit F_MASTER;

string *list = ({ "yg-putuo", "yg-moon", "yg-wzg", "yg-shushan", "yg-hyd",
  "yg-fangcun", "yg-hell", "yg-jjf", "yg-pansi",
  "yg-dragon", "yg-xueshan",
  "yg-wudidong",
});

