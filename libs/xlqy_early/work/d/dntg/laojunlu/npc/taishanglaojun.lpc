#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
  set_name("太上老君",({"taishang laojun","laojun","dao"}));
  set("gender", "男性");
  set("age", 55);
  set("long", "    \n太上老君。\n");
  set("title", HIC"清虚上人"NOR);
  set("attitude", "peaceful");
  set("class", "taoist");
  set("combat_exp", 4000000);
  set("daoxing", 6000000);
  

   set_skill("unarmed", MAX_SKILL_LEVEL+100);
   set_skill("wuxing-quan", MAX_SKILL_LEVEL+100);
   set_skill("dodge", MAX_SKILL_LEVEL+100);
   set_skill("baguazhen", MAX_SKILL_LEVEL+100);
   set_skill("music", MAX_SKILL_LEVEL+100);
   set_skill("parry", MAX_SKILL_LEVEL+100);
   set_skill("sword", MAX_SKILL_LEVEL+100);
   set_skill("sanqing-jian", MAX_SKILL_LEVEL+100);
   set_skill("staff", MAX_SKILL_LEVEL+100);
   set_skill("fumo-zhang", MAX_SKILL_LEVEL+100);
   set_skill("hammer", MAX_SKILL_LEVEL+100);
   set_skill("kaishan-chui", MAX_SKILL_LEVEL+100);
   set_skill("blade", MAX_SKILL_LEVEL+100);
   set_skill("yange-blade", MAX_SKILL_LEVEL+100);
   set_skill("force", MAX_SKILL_LEVEL+100);
   set_skill("zhenyuan-force", MAX_SKILL_LEVEL+100);
   set_skill("literate", 250);
   set_skill("spells", MAX_SKILL_LEVEL+100);
   set_skill("taiyi", MAX_SKILL_LEVEL+100);
   map_skill("spells", "taiyi");
   map_skill("force", "zhenyuan-force");
   map_skill("unarmed", "wuxing-quan");
   map_skill("sword", "sanqing-jian");
   map_skill("dodge", "baguazhen");
   map_skill("staff", "fumo-zhang");
   map_skill("blade", "yange-blade");
   map_skill("hammer", "kaishan-chui");

   set("max_kee", 4500);
   set("max_sen", 4500);
   set("force", 5000);
   set("max_force", 2500);
   set("mana", 7000);
   set("max_mana", 3500);   
   set("force_factor", 200);
   set("mana_factor", 200);

   set("chat_chance_combat", 90);
   set("chat_msg_combat", 
   ({
     (: cast_spell, "zhenhuo" :),
   }) );

  create_family("五庄观", 1, "祖师");

  set("inquiry", ([
  "here"   : "这里就是兜率宫，你来这里干什么？",
]));


setup();

carry_object("/d/lingtai/obj/cloth")->wear();

}


void init()
{
  object who;

  ::init();
  if( interactive(who = this_player()) && !is_fighting() ) 
    {
     remove_call_out("greeting");
     call_out("greeting", 1, who);
    }
}


void greeting(object who)
{
  object me = this_object();
//  object who = this_player();
  if (who->query("dntg/laojunlu")=="allow")
    {
    me->command("kick");
	who->set("dntg/laojunlu","allow");
    me->command("chat 大事不好！"+who->query("name")+"从八卦炉中逃出来了！");
    remove_call_out("leave_laojunlu");
    call_out("leave_laojunlu", 1, who);  
    } 
}

int leave_laojunlu(object who)
{
    message_vision("$N怒火上撞，一脚踢翻老君炉，断喝一声：待我杀到天庭，夺了那昏君的宝座！。\n", who);
    who->move("/d/dntg/sky/tongmingdian");
}


void attempt_apprentice(object ob)
{


if (ob->query("obstacle/number") < 34) {
 command("say 这位" + RANK_D->query_respect(ob) + "拜我为师，要先先历尽取
经劫难！\n");
 command("sigh");
 return;
}

if( (string)ob->query("class")=="dao" )
     command("say 好，好！道仙本一家。\n");
  

   if( (string)ob->query("family/family_name")=="五庄观" )
   {
     if( (int)ob->query("family/generation") > 2   )
     {
        command("say 你不是镇元的弟子呀。\n");
        command("shrug");
     }
     else 
     {
        if( (int)ob->query("daoxing") >= 1000000 && (int)ob->query_skill("taiyi", 1) >=200 )
        {
          command("nod ");
          command("say 好把既然这位" + RANK_D->query_respect(ob) + "是镇元老友的弟子，我就收下你了！\n");
          command("recruit " + ob->query("id") );
        }
        else
        {
          command("say 有心上进是不错，不过还是要循序渐进。\n");
        }
     }
   }

   else
   {
     command("nod");
     command("say 这位" + RANK_D->query_respect(ob) + "，本门讲究长幼之礼，尊卑之分。一下让你成为二代弟子恐人心不服。\n");
   }

   return;
}

int recruit_apprentice(object ob)
{
   if( ::recruit_apprentice(ob) )
     ob->set("class", "xian");
}


