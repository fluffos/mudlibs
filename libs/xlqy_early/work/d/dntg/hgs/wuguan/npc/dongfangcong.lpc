#include <ansi.h>
inherit NPC;
int do_skills(string arg);
void create()
{

        set_name("东方聪", ({ "dongfang cong", "dongfang", "cong"}) );
        set("gender", "男性" );
        set("age", 22);
        set("long", "东方聪是馆主的大儿子，正教一些徒弟武艺。\n可以用skills查看师父的技能，用ask <id> about all打听某事。\n");
        set("combat_exp", 60000);
	set("title", "武馆教头");
	set_skill("stick", 70);
	set_skill("parry", 70);
        set_skill("dodge", 50);
        set_skill("unarmed", 70);
	set_skill("force", 50);
	set_skill("shaolin-force",50);
        setup();
        set("inquiry", ([
	        "name": "我是东方聪，我爹是这里的当家，想和我学功夫吗？先入武馆吧。\n",
                "here": "这便是傲来国最有名的武馆了，来学艺的人很多呢。\n",
				
        ]));		
        add_money("silver", 1+random(20));
        carry_object("/d/obj/cloth/choupao")->wear();
}

int recognize_apprentice()
{
	if(!this_player()->query("wuguan/join") )
	return notify_fail("东方聪笑道：教不教你，你去问爹。\n");
//	if(this_player()->query("wuguan/job_success",1) < 100)
//	  return notify_fail("东方聪笑道：你多为武馆做些贡献，我就教。\n");
//	if(this_player()->query_temp("wuguan/job_success",1) < 10)
//	  return notify_fail("东方聪笑道：你去为武馆做点事再来吧。\n"); 
	return 1;
}
void init()
{
	
	add_action("do_skills","skills");
}
int do_skills(string arg)
{
	if(!this_player()->query("wuguan/join") )
		return 0;
	if(arg!="dongfang"&&arg!="dongfang cong"&&arg!="cong")
		return 0;
	if(wizardp(this_player()))
		return 0;
	tell_object(this_player(),"东方聪目前所掌握的"+HIR"六"NOR+"项技能是：\n");
	tell_object(this_player(),WHT"┏━━━━━━━━━━━━━"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"WHT"━━━━━━━━━━━━━┓\n"NOR);
        tell_object(this_player(),CYN"  基本轻功 (dodge)                         - "HIB"身形灵动"NOR+"   50/    0\n");
        tell_object(this_player(),CYN"  内功心法 (force)                         - "HIY"渐入佳境"NOR+"   50/    0\n");
        tell_object(this_player(),CYN"  拆招卸力之法 (parry)                     - "YEL"半生不熟"NOR+"   70/    0\n");
        tell_object(this_player(),CYN"  少林硬气功 (shaolin-force)               - "HIB"略知一二"NOR+"   50/    0\n");
        tell_object(this_player(),CYN"  基本棍法 (stick)                         - "YEL"半生不熟"NOR+"   70/    0\n");
        tell_object(this_player(),CYN"  扑击格斗之技 (unarmed)                   - "YEL"半生不熟"NOR+"   70/    0\n");
        tell_object(this_player(),WHT"┗━━━━━━━━━━━━━ "HIR"华 中 站"WHT" ━━━━━━━━━━━━━┛\n"NOR);
	
	return 1;
	
}	
