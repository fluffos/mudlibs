// zongguan.c 东方博玉
// By yfeng,kittt
//modified by gamer@88

#include <ansi.h>
inherit NPC;

int ask_join();
int leave_wg();

void init();


void create()
{

        set_name("东方博玉", ({ "dongfang boyu", "dongfang", "boyu"}) );
        set("gender", "男性" );
	set("per", 23);
        set("age", 50);
        set("long", "东方博玉是东方武馆的馆主，手上很有两下功夫。
城里的少年莫不以做他的徒弟为荣。\n");
        set("combat_exp", 120000);
	set("title", "武馆馆主");
	set("max_kee", 1500);
	set("max_force", 600);
	set("force", 600);
	set("force_factor", 30);
	set_skill("parry", 90);
        set_skill("dodge", 90);
        set_skill("unarmed", 90);
	set_skill("force", 90);
	set_skill("shaolin-force",60);
//        carry_object("/d/obj/cloth/choupao")->wear();
	set("inquiry", ([
	        "name": "老夫东方博玉，是这里的当家。\n",
                "here": "这便是傲来国最有名的武馆了，来学艺的人很多呢。\n",
		
                "入武馆":	(: ask_join:),
                "join":		(: ask_join :),
		"job" :		"去问管家吧。\n",
		"辞行":   	(: leave_wg:),
		"leave":	(: leave_wg:),
		
        ]));		
 
	setup();
        carry_object("/d/obj/cloth/choupao")->wear();
}

int ask_join()
{
	object me;

	me = this_player();

	if((me->query("wuguan/join")))
	{
		message_vision(
		CYN+"东方博玉对着$N说道：这位"+RANK_D->query_respect(me)+"已是本武馆的一员了，开什么玩笑。\n"+NOR,me);
		return 1;
	}
	if(me->query("age")>17)
	{
		message_vision(
		CYN+"东方博玉对着$N说道：这位"+RANK_D->query_respect(me)+"你年纪太大了，另投明师去吧。\n"+NOR,me);
		return 1;
	} 
		
	if((me->query("combat_exp"))>60000)
	  {
		message_vision(
		CYN+"东方博玉对着$N说道：这位"+RANK_D->query_respect(me)+"你已有根基，无须在我武馆锻炼了。\n"+NOR,me);
		return 1;
	} 
	me->set("wuguan/join",1);
//	me->set("newbie/learn", 1);
	me->save();
	message_vision(
CYN+"东方博玉笑道：正好我们这里最近招收江湖新手，"+RANK_D->query_respect(me)+"看起来资质还不错，就在我们这里干吧。\n"+NOR,me);
	message_vision(CYN"东方博玉对$N说道：从现在起你可以"NOR+HIY"(ask guanjia about job)"NOR+CYN"为武馆做些贡献。也可以向我儿子女儿学点功夫。\n"NOR,me);
	message_vision(CYN"东方博玉说道：你去向管家报个道吧"NOR+HIC"(ask guanjia about register)。\n"NOR,me);
	return 1;
}

int leave_wg()
{
	object boyu,me;

	me=this_player();
	
	if(!me->query("wuguan/join"))
	{
		message_vision(
"东方博玉对$N说道：你本来就不是本武馆的人，在这里起什么哄。\n",me);
		return 1;
	}
	if (me->query("wuguan/job"))
	{
		message_vision("东方博玉对$N一瞪眼：想走也得先把你手头的活干完!\n",me);
		return 1;
	}	
	if(me->query("age")>17&&me->query("combat_exp")<50000)
	{
		message_vision(
	"东方博玉叹了口气，说道：老夫没有把你调教好，是老夫的责任，你还是到江湖上去历练历练，另择明师吧。\n",me);
	me->move("/d/dntg/hgs/wuguan/school1");
	me->delete("wuguan");
	me->delete_temp("wuguan");
	
	me->save();
	message_vision(HIB"$N背起行囊，走出了武馆，踏上茫茫江湖路。\n"NOR,me);
	return 1;
	}
	if(me->query("combat_exp")<50000)
	{
		message_vision("东方博玉沉吟一下，说道：你江湖经验尚浅，我不放心你去呀。\n",me);
		return 1;
	}
	
	message_vision(
"东方博玉点点头，微笑道：你来武馆也有些时日了，是该到江湖上去历练历练，闯荡一番了。\n",me);
	me->move("/d/dntg/hgs/wuguan/school1");
	me->delete("wuguan");
	me->delete_temp("wuguan");
	
	me->save();
	message_vision(HIW"$N背起行囊，走出了武馆，从此海阔凭鱼跃，天高任鸟飞～～～\n"NOR,me);
	return 1;
}

