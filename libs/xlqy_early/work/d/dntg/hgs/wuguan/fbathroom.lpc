#include <ansi.h>
inherit ROOM;
#include <room.h>
void create() {
  set("short", "温泉池");
  set("long", @LONG

水池中的水微微的冒着热气，池面上漂浮着一些玫瑰和茉莉花瓣，这里的
水是引自花果山上的天然温泉，据说当年紫霞仙子曾在那里沐浴过（ｗａｓｈ）。
LONG
  );
  set("exits", ([
    "north": __DIR__ "fclothroom",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  setup();

}
void init() {
  add_action("do_jump", "wash");
}
int do_jump() {
  object me;
  int wait;
  me = this_player();
  if (me->query_temp("jumpinpool")) {

    tell_object(me, "你已经在泉水中沐浴啦。\n");
    return 1;
  }
  me->add_temp("jumpinpool", 1);
  wait = random(60 - (int)me->query("con") - (int)me->query("kar"));
  if (wait < 5) wait = 5;
  me->start_busy(wait);
  message_vision("$N缓步走入泉水中．\n", me);
  tell_object(me, "你感到全身无比的舒泰．．\n");
  me->set("wuguan/washtime", time());
  //    remove_call_out("curehimup");
  call_out("curehimup", wait, me);

  return 1;
}

void curehimup(object me) {
  int gin, kee, sen;
  if (!me) return;
  kee = (int)me->query("max_kee");
  sen = (int)me->query("max_sen");
  if (me && environment(me) == this_object()) {
    message_vision(HIR "$N的精气神全恢复了！\n" NOR, me);
    me->set("eff_kee", kee);
    me->set("eff_sen", sen);
    me->set("kee", kee);
    me->set("sen", sen);
    if (!random(30)) me->delete_temp("jumpinpool");
  }
  return;
}
int valid_leave(object ob, string dir) {
  if (dir == "north") {

    ob->delete_temp("jumpinpool");
  }
  return ::valid_leave(ob, dir);
}
