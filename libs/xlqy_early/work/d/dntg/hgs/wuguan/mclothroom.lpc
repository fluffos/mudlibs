#include <ansi.h>
inherit ROOM;
#include <room.h>
void create() {
  set("short", "男更衣室");
  set("long", @LONG

房间里似乎有种酸酸的味道。一群光屁股的男孩子嘻嘻哈哈的
说着话，吹嘘着自己今天工作如何如何了得。
LONG
  );
  set("exits", ([
    "south": __DIR__ "zoulang1",
    "north": __DIR__ "mbathroom",
  ]));

  setup();

}

int valid_leave(object ob, string dir) {
  if (dir == "south") {
    message_vision("$N拿起旁边架子上的毛巾，胡乱的擦着身上的水。\n", ob);
    message_vision("$N三下五除二的穿好衣物，向外走去。\n", ob);

  }
  return ::valid_leave(ob, dir);
}
