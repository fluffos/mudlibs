#include <ansi.h>
inherit NPC;

int do_buy(string arg);
int do_list(object who);
int do_say(string arg);
int ask_sea();
int accept_object(object who,object obj);
void destroying(object obj);
void pass_sea(object who);

void start_wind(object who);
void start_wind2(object who);
void start_wind3(object who);
int start_baduo(object who);
int end_baduo(object who);
void no_wind(object who);
void no_wind2(object who);
void no_wind3(object who);
void boat_crash(object who);
void boat_crash2(object who);
void boat_crash3(object who);
void boat_crashed(object who);
void success_end(object who);
void fail_end(object who);
void fail_end2(object who);
int do_ba(string arg);
void check_user(object who);


int heshang_ask(object who);



void create()
{
        set_name("渔夫", ({"yu fu","fisher"}));
        set("age", 45);
        set("str",30);
        set("gender", "男性");
        set("long",
"一个经年在海上打鱼的渔夫，饱经风霜。\n");
        set("attitude", "peaceful");

        set("combat_exp", 50000);
        set_skill("unarmed", 40);
        set_skill("dodge", 50);
        set_skill("parry", 40);
        set_skill("fork", 60);
        set_skill("force", 40);
        set("chat_chance", 3);
        set("fish",0);
        set("chat_msg", ({
"渔夫喃喃自语道：唉，真想再看看海那边的花花世界啊！\n",
"渔夫神秘兮兮道：据说海底有座大的宫殿，里面还住着龙王，到处是奇珍异宝。\n",
"渔夫得意洋洋说道：今天出海捕到不少鱼，还有一条金色的鲤鱼！纯金色的！这可是稀罕物！一辈子也不一定能见到一条！\n",
"渔夫吆喝道：卖鱼了噢，瞧一瞧看一看啊，刚出海打的鱼，价格便宜，童叟无欺。\n",
"渔夫骄傲的说道：整个傲来国只有我到过海那边。\n",
"渔夫笑道：小虎子他爹病重，他一个人上了仙灵岛，据说是见到了仙女，给了他灵丹妙药，他爹病一下子就好了。\n",


}) );
 	set("inquiry", ([
	        "name": "我生下来就没了爹妈，也没个名没个姓的，年青时候大伙叫我海大哥，现在老啦，都叫我海大伯了。\n",
                "here": "这里是傲来国，我在这里打了一辈子鱼了。\n",
		"rumor": "听说..傲来武馆最近闹鬼啊...!\n",
		"出海":   	(: ask_sea:),
		"过海":		(: ask_sea:),
		
        ]));		
        setup();
	add_money("silver", 1+random(3));
        carry_object("/d/obj/weapon/fork/fork")->wield();
        carry_object("/d/obj/cloth/linen")->wear();
}
void init()
{ 
//	::init();
	object me;
	
	me=this_player();
	if(!living(this_object()))
	 return ;
	 if(me->query_temp("marks/passing_sea"))
	  return;
  	add_action("do_list", "list");
	add_action("do_buy","buy");
	add_action("do_ba","ba");
	add_action("do_say","say");
	call_out("greeting",1,me);
}
int do_buy(string arg)
{
	object who;
	object ob;
	string buywhat,fromwho;
	ob=this_object();
	who=this_player();
	if(!arg)
	 return notify_fail("你要买什么？\n");
	 sscanf(arg,"%s from %s",buywhat,fromwho);
	 if(who->query_temp("marks/passing_sea"))
	   return notify_fail(CYN"渔夫说道：现在哪里来的鱼卖给你啊！\n"NOR);
	if(buywhat=="fish")
	   return notify_fail(CYN"渔夫说道：哎哟，你来晚一步，今天打的鱼都卖光了。\n"NOR);
	if(buywhat=="li yu")
	{
		if(ob->query("fish"))
		{
			message_vision(CYN"渔夫笑道：哎哟，对不住，你来晚一步，那条金丝鲤鱼已经有人买去啦。\n"NOR,who);
			return 1;	
			
		}
		if(who->query("passsea/save_liyu"))
		{
			message_vision(CYN"渔夫笑道：这条鲤鱼可不能再卖给你了。\n"NOR,who);
			return 1;	
				
		}
		if(who->query_temp("marks/confirm_nobuy"))
		{
		   message_vision(HIC"渔夫说道：你不买拉倒，何必多言。\n"NOR,who);
		   return 1;
		
		}
		if(who->query_temp("marks/confirm_buy"))
		{
		   message_vision(HIC"渔夫说道：一手交钱(give 1 gold to yu fu)，一手交货。你怎么这么磨蹭的。\n"NOR,who);
		   return 1;
		
		}
		
		message_vision(CYN"渔夫说道：这位"+RANK_D->query_respect(who)+"真的想买这条金色鲤鱼？一两黄金不还价啊。(say yes/no)\n"NOR,who);
		who->set_temp("marks/ask_liyu",1);
		
		return 1;    	
	}   
	
	
}
int do_say(string arg)
{
	object who=this_player();
	if(!who->query_temp("marks/ask_liyu"))
		return 0;
	if(!arg)
	   return 0;
	 if(arg!="yes"&&arg!="no")
	    return 0;
	if(arg=="yes")
	  {
	  	if(who->query_temp("marks/confirm_nobuy"))
		{
		   message_vision(CYN"渔夫说道：你不是说不买嘛，我还不卖呢。\n"NOR,who);
		   return 1;
		
		}
	  	message_vision(HIW"$N说道："+RANK_D->query_self(who)+"愿意买这条鲤鱼。\n"NOR,who);
	  	message_vision(CYN"渔夫大喜道：好好好，一手交钱(give 1 gold to yu fu)，一手交货。\n"NOR,who);
	  	who->set_temp("marks/confirm_buy",1);
	  	return 1;
	}
	if(arg=="no")
	{
		message_vision(HIW"$N说道：这么贵啊，你自己留着烤了吃吧！\n"NOR,who);
		message_vision(CYN"渔夫哼了声，说道：总有人识货的。\n"NOR,who);
	  	who->set_temp("marks/confirm_nobuy",1);
	  	who->set_temp("marks/confirm_buy",0);
	  	who->delete_temp("marks/confirm_buy");
	  	return 1;	
	}
	return 0;
	
}
int do_list(object who)
{
	who=this_player();
	tell_object(who,"你可以购买下列这些东西：\n");
	tell_object(who,CYN"鲤鱼"NOR+"(fish)           : 20两银子\n");
	tell_object(who,HIY"金丝鲤鱼"NOR+"(li yu)       : 1两黄金\n");
	return 1;

		
}
void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	if(environment()->query("short")!="傲来国西海岸") return;
	if(!living(ob)) return;
	if(!userp(ob)) return;
	message_vision("渔夫笑道：这位"+RANK_D->query_respect(ob)+"你想买鱼嘛？\n",ob);
	return ;
}

int ask_sea()
{
	object who;
	object ob;
	object room;
	object seashore;
	object *inv;
	who=this_player();
	ob=this_object();
	if(!userp(who)) return 0;
	if(who->query("passsea/pass_sea")=="done")
	{
		if(who->is_busy())
		 {
		 	 tell_object(who,"你现在正忙着呢！\n");
		 	 return 1;
		
		 }
		 
		 if(environment(who)->query("short")!="傲来国西海岸")
		  {
		 	 tell_object(who,CYN"渔夫笑道：海在哪啊？\n"NOR);
		 	 return 1;
		
		 }
	message_vision(HIW"渔夫笑道：是你啊，我这就送你过海。\n"NOR,who);
		
	 if( !(seashore = find_object("/d/changan/eastseashore")) )
            seashore = load_object("/d/changan/eastseashore");
            message_vision(HIY"渔夫带着$N上船。刹那间，轻舟已过汪洋大海。\n"NOR,who);
            who->move(seashore);
		return 1;
	
	
	
	}
	if(who->query("real_age") > 19)
	{
		if(who->is_busy())
		 {
		 	 tell_object(who,"你现在正忙着呢！\n");
		 	 return 1;
		
		 }
		 
		 if(environment(who)->query("short")!="傲来国西海岸")
		  {
		 	 tell_object(who,CYN"渔夫笑道：海在哪啊？\n"NOR);
		 	 return 1;
		
		 }
		message_vision(HIW"渔夫磨了磨牙，道：得了，我送你过海吧。\n"NOR,who);
			
		 if( !(seashore = find_object("/d/changan/eastseashore")) )
	            seashore = load_object("/d/changan/eastseashore");
	            message_vision(HIY"渔夫带着$N上船。刹那间，轻舟已过汪洋大海。\n"NOR,who);
	            who->move(seashore);
			return 1;	
			
	}
	if(who->query_skill("dodge",1)<20)
	{
		message_vision(CYN"$N打量了$n几眼，摇头道：你下盘虚浮，出了海一个浪头恐怕就会打你落水。\n"NOR,ob,who);
		return 1;	
		
	}
	if(who->query_skill("unarmed",1)<20)
	{
		message_vision(CYN"$N打量了$n几眼，摇头道：你手无缚鸡之力，出了海一个浪头恐怕就会打你落水。\n"NOR,ob,who);
		return 1;	
		
	}
/*	if(who->query("wuguan/join"))
	 {
	 	message_vision(CYN"$N上上下下打量了$n几眼，笑道：你是东方武馆的人吧，我可不敢随便送你出海。\n"NOR,ob,who);
		return 1;
	}
	if(who->query("combat_exp")<50000)
	{
		message_vision(CYN"$N打量了$n几眼，摇头道：你经验不足，出海恐怕凶多吉少啊。\n"NOR,ob,who);
		return 1;	
	}
*/
	if(who->query_temp("marks/passing_sea"))
	{
		message_vision(CYN"渔夫磨了磨牙，说道：我们现在不正在过海嘛。\n"NOR,who);
		return 1;	
		
	}
	
	who->set_temp("marks/ask_sea",1);
	if(!who->query_temp("marks/paid"))
	{
		message_vision(CYN"$N笑道：要出海是吗？那可危险的紧，拿性命搏的事情，您就付五两黄金吧。\n"NOR,ob);
		return 1;	
	}
	inv=all_inventory(who);
	for(int i=0;i<sizeof(inv);i++)
	{
		if(inv[i]->is_character())
		{	message_vision(CYN"渔夫说道：我这渔船小，容不下更多的人了。\n"NOR,who);
			return 1;
		}
	}
	message_vision(CYN"渔夫说道：请随我上船吧。\n"NOR,who);
	if(who->is_busy())
	{
		tell_object(who,"你现在正忙着呢。\n");
		return 1;
	}
	
	 if( !(room = find_object("/d/dntg/hgs/boat")) )
            room = load_object("/d/dntg/hgs/boat");
        if( room = find_object("/d/dntg/hgs/boat") ) 
        {
           message_vision("$N跟着渔夫轻巧的跳上了渔船。\n",who);
           who->move(room);
           ob->move(room);
           
           who->set_temp("marks/passing_sea",1);
           who->delete_temp("marks/paid");
           who->delete_temp("marks/ask_sea");
           message_vision(HIR"渔夫吼道：坐稳抓牢，扬帆出海喽!\n"NOR,who);
           ob->command("mobai");
           ob->delete("greeting");
           ob->set("chat_chance", 0);
           ob->set_temp("no_return",1);
           remove_call_out("pass_sea");
           call_out("pass_sea",10,who);
        
        	
        }
         else
             message("vision", "糟糕，渔船不见了。\n", this_object() );
         	
	return 1;		
}
void check_user(object who)
{
	object room;
	object *inv;
	
	if(who->query("kee")<1||who->query("sen")<1)
	{
		inv=all_inventory(who);
		for(int j=0;j<sizeof(inv);j++)
		{
			destruct(inv[j]);
		}
	
	
		who->unconcious();
		if( !(room = find_object("/d/changan/aolaiws")) )
          	room = load_object("/d/changan/aolaiws");
          	who->move(room);
          	who->delete_temp("marks");
          	message_vision("潮水将一个人冲了上岸。\n",who);
  		remove_call_out();
        	this_object()->delete_temp("no_return");
        	destruct(this_object());
        	return; 	
			
	}
	return ;
	
}
void pass_sea(object who)
{
	int nature;
	object ob;
	ob=this_object();
	message_vision(HIW"渔船渐行渐远，傲来海岸慢慢聚成一条白线，终至不见。\n"NOR,who);
	remove_call_out("start_wind");
	call_out("start_wind",7,who);
	
	
}


void start_wind(object who)
{
	
	object ob;
	ob=this_object();
	message_vision(HIY"海面上渐渐刮起了风，波浪起伏，你觉得胃有些不舒服，头也有点晕。\n"NOR,who);
	who->receive_damage("kee",40+random(20));
	who->receive_damage("sen",30+random(10));
	check_user(who);
	
	remove_call_out("start_wind2");
	call_out("start_wind2",9,who);
	
	
}
void start_wind2(object who)
{
	
	object ob;
	ob=this_object();
		
	message_vision(HIC"风越来越大，一道道大浪不时向小船卷来，小船在波浪中左右颠簸，桅杆嘎吱嘎吱的响着。\n"NOR,who);
	
	
	if(random(who->query_skill("dodge",1))<15)
	{
	  message_vision(HIG"一个大浪“哗”的冲了过来，将你浇了个透心凉，你吓了一大跳，手没抓牢，差点摔进海里！\n"NOR,who);
	  who->receive_damage("kee",60+random(30));
	  who->receive_damage("sen",45+random(20));
	  check_user(who);
	   
	remove_call_out("start_wind3");
	call_out("start_wind3",13,who);
	return;
	}
	 message_vision(HIR"一个大浪“哗”的冲了过来，将你浇了个透心凉，你虽吓了一跳，手还是牢牢地抓着船弦！\n"NOR,who);
	 who->receive_damage("kee",50+random(25));
	 who->receive_damage("sen",40+random(15));
	 check_user(who);
	 
	remove_call_out("start_wind3");
	call_out("start_wind3",13,who);
	
	
}

void start_wind3(object who)
{
	
	object ob;
	ob=this_object();
	
	
	message_vision(HIB"狂风怒吼，巨浪咆哮，小船在茫茫汪洋之中时而被掀上丈高浪尖，时而被抛入深深浪谷。\n"NOR,who);
	
	if(random(who->query_skill("dodge",1))<25)
	{
	  message_vision(HIR"你像一个布娃娃一样，在船舱中甩来甩去，浑身上下青一块紫一块，肚中犹如翻江倒海一般，忍不住“哇”的一声吐开了。\n"NOR,who);
	  who->receive_damage("kee",70+random(50));
	  who->receive_damage("sen",45+random(30));
	  check_user(who);
	   
	 message_vision(HIY"渔夫吼道：过来帮我把住舵"+HIC"(ba 舵)"NOR+HIY"，我要落帆！\n"NOR,who);
	 who->set_temp("marks/baduo",1);
	 who->set_temp("marks/try_baduo",0);
	 
	remove_call_out("boat_crashed");
	call_out("boat_crashed",15,who);
	  return;
	}
	 message_vision(HIR"你被颠的七荤八素，幸好有点功夫根底，虽然额头被撞了个大包，有点晕头晕脑的，其他地方问题却不大。\n"NOR,who);
	 who->receive_damage("kee",60+random(40));
	 who->receive_damage("sen",40+random(25));
	 check_user(who);
	 
	 message_vision(HIY"渔夫吼道：过来帮我把住舵"+HIC"(ba 舵)"NOR+HIY"，我要落帆！\n"NOR,who);
	 who->set_temp("marks/baduo",1);
	 who->set_temp("marks/try_baduo",0);
	 ///////////你不去ba舵，那没什么好说的，不是死就是晕。
	remove_call_out("boat_crashed");
	call_out("boat_crashed",20,who);
}
int do_ba(string arg)
{
	object who=this_player();
	
	if(!who->query_temp("marks/baduo"))	
	   return 0;
	 if(!arg)
	   return notify_fail(HIR"把住舵！！！\n"NOR);
	if(arg!="舵")
	   return notify_fail(HIR"把住舵！！！\n"NOR);
	if(who->query_temp("marks/baduo_success"))
	    return notify_fail("你牢牢的把住手中的舵。\n");
	if(who->is_busy())
	    return notify_fail("你现在正忙着呢！\n");
	
	
	if(random(who->query("cor"))<15)      //check cor ...
	{
		message_vision(HIB"$N虽然想过去，但已被这惊涛骇浪吓的心胆俱裂，再也挪不开半步。\n"NOR,who);
		 message_vision(HIR"渔夫吼道：快来把住舵"+HIC"(ba 舵)！！\n"NOR,who);
		 who->add_temp("marks/try_baduo",1);
		 who->start_busy(1);            //防止#n ...
		 who->receive_damage("sen",10+random(5));
		 check_user(who);
		if(random(who->query("cor"))>8)       ///give cor =10 a chance
		{
			message_vision(HIR"渔夫大吼道：今天就要被你这个"+RANK_D->query_rude(who)+"害死了！\n"NOR,who);
			message_vision(HIW"你心中不知如何又生出勇气，一咬牙，纵身向船尾扑去。\n"NOR,who);
			
			remove_call_out("start_baduo");
			call_out("start_baduo",2,who);
			return 1;	
		}
		
		return 1;
			
	} 
	message_vision(HIW"虽然巨浪滔天，你心中却无丝毫惧意，一个箭步冲向船尾。\n"NOR,who);
	who->add_temp("marks/try_baduo",1);
	who->start_busy(2);
	
	remove_call_out("start_baduo");  
	call_out("start_baduo",2,who);
	return 1;
	
}
int start_baduo(object who)
{
	if((who->query_str()+who->query_skill("unarmed",1)/10+random(who->query("cps")))<35+random(7))
	{
		message_vision("你一把抓住了舵，但觉手中一股大力传来，虎口已然震裂，人也被甩了出去，头铛的一下撞在船舷上，差点晕了过去！\n",who);
		who->start_busy(2);
	 	who->receive_damage("kee",50+random(20));
		who->receive_damage("sen",30+random(15));
		check_user(who);
		 message_vision(HIR"渔夫吼道：快来把住舵"+HIC"(ba 舵)！！\n"NOR,who);

		return 1;
	}
	message_vision("你一把抓住了舵，但觉手中一股大力传来，双臂巨震！你将舵旁绳子牢牢系在腰间，运起全身气力，死死抓牢船舵！\n",who);
//	who->receive_damage("kee",65+random(50));
//	who->receive_damage("sen",20+random(20));
	who->start_busy(15);
	
	who->set_temp("marks/baduo_success",1);
	check_user(who);
	remove_call_out("end_baduo");
	call_out("end_baduo",3,who);	
	return 1;
}
int end_baduo(object who)
{
	if(who->query_temp("marks/try_baduo")>4)
	{
		message_vision(HIY"渔夫见你把好了舵，赶紧过去收帆，可惜为时已晚，只听得“咯”的一声，桅杆已然被狂风吹断！\n",who);
		message_vision(HIB"渔夫喟然长叹一声，说道：听天由命吧。\n",who);
		who->delete_temp("marks/baduo");
	/*	if(random(who->query("kar"))<2)  ///// 死人总是痛苦的。。尤其是新手。。降低吧。。
		{
		 message_vision(HIR"一股巨浪如墙一样向船推来。你像断了线的风筝一样被甩出去，消失在惊涛骇浪之中。\n"NOR,who);
		 who->unconcious();
		 who->delete_temp("last_damage_from");
       		 who->set_temp("death_msg","掉进汪洋大海淹死了。");
       		 who->delete_temp("marks");
       		 who->move("/obj/void");
           	 who->die();
        	 who->save();
        	 remove_call_out();
        	 destruct(this_object());
        	 return 1;
		}
	*/	
		// rp ...here...
		if(random(10)>8)
		{
		   remove_call_out("no_wind3");
		   call_out("no_wind3",13,who);
		   return 1;
		}
		//既然已经把舵了，那么再给成功的机会。
		remove_call_out("boat_crash");
		call_out("boat_crash",13,who);
		return 1;	
	}
	message_vision(HIY"渔夫见你把好了舵，赶紧过去收帆，谢天谢地，帆总算降了下来，船也平稳了许多。\n"NOR,who);
	
	if(random(who->query("kar"))<5) /////////very bad rp..
	{
		//   printf("very bad rp a\n");
		   remove_call_out("boat_crash");
		   call_out("boat_crash",13,who);
		   return 1;	
	}
	 remove_call_out("no_wind3");
	 call_out("no_wind3",13,who);
	 return 1;

}
void boat_crash(object who)
{
	message_vision(MAG"惊涛骇浪之中居然隐隐约约传来一阵美妙的歌声，宛如仙乐，你不禁沉醉了，几乎忘了自己身处险地。\n"NOR,who);
	message_vision(HIW"渔夫脸色登时变得如一张白纸，说道：那是海妖在歌唱，附近就是魔鬼礁。天亡我也！\n"NOR,who);
	message_vision("说话间，小船向一堆杂乱无章的巨石礁冲了过去。\n",who);
	remove_call_out("boat_crash2");
	call_out("boat_crash2",9,who);
		
	
}
void boat_crash2(object who)
{
	
	message_vision(HIY"生死的问题是这样的：如果波浪把船冲到石头上，它就会在上面碰碎，那就完了；\n"NOR,who);
	message_vision(HIC"要是波浪在船碰着石头以前退回来、回浪就会把船带走，船就得救了。就是这么简单，生或者死。\n"NOR,who);
	message_vision(HIB"一个无情的海浪冲了过来。它冲到船底下，把船举起来，狠狠的向巨石甩去。\n"NOR,who);
	 remove_call_out("boat_crash3");
	 call_out("boat_crash3",13,who);

	
}
void boat_crash3(object who)
{
	object room;
	object *inv;
	
	if(random(2))      // just .. 1 ,0, live or die
	{
	message_vision(HIW"浪头是从船底下过去的。\n"NOR,who);
	message_vision(HIR"巨浪撞击在岩石上发出震耳欲聋的声音，“哗”的一声倒卷回来。\n"NOR,who);
	message_vision(HIW"回浪将小船带走了。\n"NOR,who);
	 remove_call_out("no_wind3");
	 call_out("no_wind3",9,who);
	 return ;
	}
	message_vision(HIW"浪头将船顶了起来，直向着巨石扑去。\n"NOR,who);
	message_vision(HIR"“砰”的一声，小船被巨石撞了个粉碎。你像断了线的风筝一样被甩出去，消失在惊涛骇浪之中。\n"NOR,who);
	inv=all_inventory(who);
	for(int j=0;j<sizeof(inv);j++)
	{
		destruct(inv[j]);
	}

        message_vision("你死死的抱住一块船板。又一个巨浪向你扑了过来。\n",who);
        if((who->query("passsea/save_liyu")=="success")&&(random(5)))
         {
         	who->unconcious();
         	if( !(room = find_object("/d/sea/girl3")) )
          	room = load_object("/d/sea/girl3");
          	who->delete_temp("marks");
       		who->set_temp("mark/sleep_in_bed",1);
       		who->move(room);
        	
       		message_vision("巡海夜叉七手八脚的扛了一个人过来。\n",who);
          	remove_call_out("fail_end");
          	call_out("fail_end",5,who);
          	return ;
        }	
	else{	who->unconcious();
         	if( !(room = find_object("/d/changan/aolaiws")) )
          	room = load_object("/d/changan/aolaiws");
          	who->move(room);
          	who->delete_temp("marks");
          	message_vision("潮水将一个人冲了上岸。\n",who);
  		remove_call_out();
        	destruct(this_object());
        	return ;
        	
        }
}
