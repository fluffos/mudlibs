       		who->move(room);
        	
       		message_vision("巡海夜叉七手八脚的扛了一个人过来。\n",who);
          	remove_call_out("fail_end");
          	call_out("fail_end",5,who);
          	return ;
        }	
	else{	who->unconcious();
         	if( !(room = find_object("/d/changan/aolaiws")) )
          	room = load_object("/d/changan/aolaiws");
          	who->move(room);
          	who->delete_temp("marks");
          	message_vision("潮水将一个人冲了上岸。\n",who);
  		remove_call_out();
        	destruct(this_object());
        	return ;
        	
        }
}
void fail_end(object who)
{
	
	object *inv;
	object env;
	object princess;

	
	env=environment(who);
	inv=all_inventory(who);
	for(int j=0;j<sizeof(inv);j++)
	{
		destruct(inv[j]);
	}
	if (!princess=present("long nu",env))
	{
     	princess=new("/d/sea/npc/longnu");
     	princess->move(env);
  	}
  	who->delete_temp("mark/sleep_in_bed");
  	who->revive();
  	who->start_busy(10);
  	remove_call_out("fail_end2");
  	call_out("fail_end2",3,who);
  	
}
void fail_end2(object who)
{
	object money;
	int i;
	message_vision(MAG"紫云公主笑道：你醒来了呀。幸好巡海夜叉及时发现了你，父王用神通法力将你救活了。\n"NOR,who);
  	message_vision(HIW"紫云公主微笑道：我就是你放生的那条金色鲤鱼。你这也是善有善报:)\n"NOR,who);
  	message_vision("紫云公主说道：从龙宫出去，就可以到南瞻部洲大唐国了。你也可以留在龙宫之中随我学习武艺"+HIY"(bai longnu)。\n"NOR,who);
	if(who->query("passsea/pass_sea")=="done")
	   return;
	i = random(500);
 	who->delete_temp("marks");
  	who->set("passsea/pass_sea","done");
  	who->add("combat_exp",i+10000);
 	who->add("potential",i+3000);
 	who->add("attribute_point",1);
 	money=new("/obj/money/gold");
 	money->set_amount(20+random(5));
 	money->move(who);
	message("channel:chat",MAG"【漂洋过海】"+HIY"紫云公主(long nu)："+who->query("name")+"好人好报，龙宫上下助他到达[1;37m南瞻部洲大唐国！\n"NOR,users());
  	tell_object (who,"你获得了一万多点武学和三千多点潜能以及二十多两黄金！你的属性点数增加了一点！\n");
  	tell_object(who,CYN"龙女说道：以后你要到大唐，就问渔夫过海"+HIY"(ask yu fu about 过海)"NOR+CYN"；要是想到傲来，就在东海边"+HIC"(yell 过海)。\n"NOR);

  	who->save();
  		
  	remove_call_out();
  	destruct(this_object());
}
void no_wind3(object who)
{

	message_vision(HIC"狂风不再怒吼，巨浪也渐渐低下了头，你不禁长出了一口气。\n"NOR,who);
	who->receive_heal("kee",20+random(10));
	who->receive_heal("sen",10+random(5));			
	remove_call_out("no_wind2");
	call_out("no_wind2",13,who);
}
void no_wind2(object who)
{

	message_vision(HIB"风渐渐平息下来，微风习习，浪花朵朵，你觉得心情十分舒畅。\n"NOR,who);
	who->receive_heal("kee",40+random(20));
	message_vision(HIM"茫茫大海中居然传来若有若无的歌声，让你心旷神怡，这难道是传说中的美人鱼在歌唱？\n"NOR,who);
	who->receive_heal("sen",20+random(15));			
	remove_call_out("no_wind");
	call_out("no_wind",9,who);
}
void no_wind(object who)
{
	
	message_vision(HIW"海面上波光嶙嶙，柔和的海风轻轻扑打你的脸庞，你深深呼吸了一口略带咸味的空气，忍不住放声高歌~~\n"NOR,who);
	who->receive_heal("kee",60+random(40));
	message_vision(MAG"一群海鸟从前方飞过，远处渐渐出现一条细细的白线，越来越清晰，那里就是南瞻部洲，大唐国的东海岸！\n"NOR,who);
	who->receive_heal("sen",30+random(20));	
	remove_call_out("success_end");
	call_out("success_end",7,who);
	
}
void success_end(object who)
{
	object room;
	int i;
	object money;
	message_vision(HIY"越来越近越来越近了，你看到了岸边摇曳的椰子树，看到了岸上来来往往的人群，看到了美好的未来在向你招手。\n"NOR,who);
	message_vision(CYN"渔夫一声吆喝：靠岸喽。"+RANK_D->query_respect(who)+"请上岸吧。\n"NOR,who);
	 if( !(room = find_object("/d/changan/eastseashore")) )
            room = load_object("/d/changan/eastseashore");
        who->move(room);
	message_vision(HIC"$N从船上跳到岸边。\n",who);
	
	if(who->query("marks/pass_sea")=="done")
	{	this_object()->delete_temp("no_return");
  		destruct(this_object());
	   	return;
	}
	i = random(1000);
 	who->delete_temp("marks");
  	who->set("passsea/pass_sea","done");
  	who->add("combat_exp",i+10000);
 	who->add("potential",i+3000);
 	who->add("attribute_point",1);
 	money=new("/obj/money/gold");
 	money->set_amount(25+random(5));
 	money->move(who);
	message("channel:chat",MAG"【漂洋过海】"+HIY"渔夫(yu fu)："+who->query("name")+"不畏生死，历经千辛万苦到达[1;37m南瞻部洲大唐国！\n"NOR,users());
  	tell_object (who,"你获得了一万多点武学和三千多点潜能以及二十多两黄金！你的属性点数增加了一点！\n");
  	tell_object(who,CYN"渔夫说道：以后你要到大唐，就问我过海"+HIY"(ask yu fu about 过海)"NOR+CYN"；要是想到傲来，就在东海边"+HIC"(yell 过海)。\n"NOR);
  	who->save();	
  	this_object()->delete_temp("no_return");
  	destruct(this_object());
}
int accept_object(object who,object obj)
{
	
	object ob;
	object fish;
	int value = obj->value();
	ob=this_object();
	who=this_player();
	if(who->query_temp("marks/confirm_buy"))
	{
	if (value == 0)
	  {
	    command("bite");
	    return notify_fail(CYN"渔夫说道：这个...\n"NOR);
	 }
	 else if( value >= 10000 )
	  {
		message_vision(HIY"$N，说道：这是您的金丝鲤鱼，请拿好。\n"NOR,this_object());
		ob->set("fish",1);
		fish=new("/d/dntg/hgs/npc/obj/goldfish");
		fish->move(who);
		who->delete_temp("marks/confirm_buy");
		who->delete_temp("marks/ask_liyu");
		who->start_busy(2);
		remove_call_out("heshang_ask");
		call_out("heshang_ask",1,who);
		return 1;
	}
	return 0;
	}
	
	 if(who->query_temp("marks/passing_sea"))
	 {
		message_vision(CYN"$N喝道：别打扰我掌舵，乖乖的坐好！\n"NOR,ob);
		return 0;	
	
	}
	if(!who->query_temp("marks/ask_sea"))
	 {
	  	message_vision(CYN"$N笑道：无功不受禄，你这是干什么啊。\n"NOR,ob);
		return 0;	
	}
	if (value == 0)
	  {
	    command("bite");
	    return notify_fail("渔夫说道：这个...\n");
	 }
	 else if( value >= 50000 )
	  {
		message_vision(CYN"$N一咬牙，说道：好，今天老儿我就赚这个搏命钱了。\n"NOR,this_object());
		who->set_temp("marks/paid",1);
		call_out("destroying",1,obj);
		return 1;
	}
	return 0;
}
int heshang_ask(object who)
{
	object room;
	object heshang;
	if(!present("heshang",environment(who)))
	  {
	  	heshang=new("/d/dntg/hgs/npc/heshang");
	  	heshang->move(environment(who));
	}
	who->start_busy(20);
	message_vision(CYN"和尚走了过来，拦住$N，说道：阿弥陀"+RANK_D->query_respect(who)+"，那条鱼吃不得的……\n"NOR,who);
	message_vision(CYN"渔夫说道：咦，和尚你来凑什么热闹？\n"NOR,who);
	message_vision(HIW"和尚笑吟吟的：这可不是一条鲤鱼，这是……，不知这位施主肯否将鱼送给我"+HIR"(answer 愿意/不愿意)。\n"NOR,who);
	who->set_temp("marks/heshang_asked",1);
	return 1;
}


void destroying(object obj)
{
	destruct(obj);
	return;
}
void reset()
{
        if(query("fish")) {
                add("fish",1);
                if (query("fish")>4) set("fish",0);
        }
}      