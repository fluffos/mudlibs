        */
        message_vision("你死死的抱住一块船板。又一个巨浪扑了过来!\n",who);
        ////////////降低概率了，惩罚嘛
        if((who->query("passsea/save_liyu")=="success")&&(random(5)))
         {
         	who->unconcious();
