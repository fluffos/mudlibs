#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "金丝鲤鱼" NOR, ({ "li yu", "fish", "yu" }));

  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long",
      "一条浑身金色的鲤鱼,正睁着眼睛可怜巴巴的望着你。\n");
    set("no_sell", "掌柜的说道：这玩意活蹦乱跳的，我这没法保管！\n");
    set("value", 0);

    set("no_put", 1);
    set("no_give", "这可是花大价钱买来的，才不随便送人呢。\n");

  }
  setup();
}
