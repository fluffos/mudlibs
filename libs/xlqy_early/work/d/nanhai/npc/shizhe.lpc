inherit NPC_PUTUO;

void create() {
  ::create();

  set("long", @LONG
南海观音座前净瓶使者。
LONG);

  set("age", 20);

  set("per", 30);
  set("int", 30);

  set("combat_exp", 100000);
  set("daoxing", 200000);

  create_family("南海普陀山", 4, "弟子");

  ::generate_me(0, 80, 80, 3, 0, 0, "净瓶使者", ({ "shizhe" }), 0);

  add_money("silver", 50);
  carry_object("/d/nanhai/obj/jingping");
  carry_object("/obj/cloth")->wear();

  set("title", "南海观音侍从");
}
