inherit NPC_PUTUO;

void create()
{
    ::create();

    set("long", "一位年轻的僧人，脸上总是带着热情的笑容。\n他负责在此迎接前来参禅进香的客人。\n");

    set("age", 30);

    set("per", 30);
    set("int", 30);

    set("combat_exp", 100000);
    set("daoxing", 200000);

    create_family("南海普陀山", 4, "弟子");

    ::generate_me(0, 60, 60, 3, 0, 0, "和尚", ({ "heshang", "bonze" }), 0);

    add_money("silver", 20);
    carry_object("/d/nanhai/obj/sengpao")->wear();
}

