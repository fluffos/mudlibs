// guanyin.c 惠岸行者
// By Dream Dec. 20, 1996
#include <ansi.h>

inherit NPC_PUTUO;

string skill_lvl();
int improve(string arg);

string ask_for_partner();
string ask_mieyao();
string ask_cancel();

void create() {
  ::create();

  set("long", @LONG
李天王二太子木叉，南海观音大徒弟惠岸行者。
LONG);

  set("age", 25);

  set("per", 30);
  set("int", 30);

  set("combat_exp", 750000);
  set("daoxing", 750000);

  create_family("南海普陀山", 3, "弟子");

  ::generate_me(0, 120, 120, 3, 0, 0, "惠岸行者", ({ "huian xingzhe", "huian", "xingzhe" }), 0);
  set("title", "观音首徒");
  set("rank_info/self", "贫僧");

  carry_object("/obj/money/gold");
  carry_object("/d/nanhai/obj/sengpao")->wear();
  carry_object("/d/nanhai/obj/budd_staff")->wield();
}

void unconcious() {
  die();
}

void die() {
  set("max_kee", 5000);
  set("kee", 5000);
  set("max_gin", 4600);
  set("gin", 4600);
  set("max_sen", 5000);
  set("sen", 5000);
  set("force", 2000);
  set("max_force", 1000);
  set("max_mana", 1000);
  set("mana", 2000);
  set("eff_kee", 5000);
  set("eff_gin", 4600);
  set("eff_sen", 5000);
  return;
}
