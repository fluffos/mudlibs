inherit NPC_PUTUO;

void create() {
  ::create();

  set("long", @LONG
黑熊怪本是山间野兽，不知从哪里学到一身好本领。
后遇见南海观音，被南海观音收为徒弟。
LONG);

  set("age", 30);

  set("attitude", "heroism");
  set("per", 9);
  set("rank_info/self", "黑熊");
  set("rank_info/rude", "熊怪");

  set("combat_exp", 30000);
  set("daoxing", 50000);

  create_family("南海普陀山", 4, "弟子");

  ::generate_me(0, 60, 60, 3, 0, 0, "黑熊怪", ({ "bear monster", "bear", "monster" }), 0);
  set("title", "南海观音之徒");

  add_money("silver", 20);
  carry_object("/d/nanhai/obj/sengpao")->wear();
}
