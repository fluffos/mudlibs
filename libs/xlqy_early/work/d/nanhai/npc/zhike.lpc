// zhike.c 知客僧// By Dream Dec. 20, 1996

inherit NPC_PUTUO;

#include <ansi.h>

void create() {
  ::create();

  set("long", "一位年轻的僧人，脸上总是带着热情的笑容。\n他负责在此迎接前来参禅进香的客人。\n");

  set("age", 25);

  set("per", 30);
  set("int", 30);

  set("combat_exp", 5000);
  set("daoxing", 10000);

  create_family("南海普陀山", 5, "弟子");

  ::generate_me(0, 30, 30, 3, 0, 0, "知客僧", ({ "zhike seng", "seng" }), 0);

  add_money("silver", 20);
  carry_object("/d/nanhai/obj/sengpao")->wear();
}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting() && !ob->query("env/invisibility")) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object()))) {
    return;
  }

  say("知客僧热情地说道：这位" + RANK_D->query_respect(ob) + "，欢迎来到南海普陀山！\n");
}
