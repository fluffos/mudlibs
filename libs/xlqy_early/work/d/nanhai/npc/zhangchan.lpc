inherit NPC_PUTUO;

void create()
{
    ::create();

    set("long", "一位年轻的僧人，脸上总是带着热情的笑容。\n他负责在此迎接前来参禅进香的客人。\n");

    set("age", 35);

    set("per", 30);
    set("int", 30);

    set("combat_exp", 10000);
    set("daoxing", 60000);

    create_family("南海普陀山", 5, "弟子");

    add_money("silver", 20);
    carry_object("/d/nanhai/obj/sengpao")->wear();

    ::generate_me(0, 30, 30, 3, 0, 0, "掌禅僧", ({ "zhangchan seng", "seng" }), 0);
}

