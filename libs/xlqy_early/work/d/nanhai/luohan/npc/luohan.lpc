inherit NPC_PUTUO;

string *first_name = ({ "降龙",
    "伏虎",
    "清静",
    "接引",
    "归真",
    "金刚",
    "精进",
    "功德",
    "旃檀",
    "光明",
    "贤善",
    "庄严",
    "智慧",
    "日月",
    "妙音",
    "须弥",
    "金身",
    "广力"
});

string *name_words = ({"罗汉"});

void create()
{
    string name;

    name = first_name[ID];
    name+= name_words[random(sizeof(name_words))];

    ::create();

  	set("long", "南海观音座下十八罗汉。\n");

    set("age", 25);

    set("per", 30);
    set("int", 30);

    set("combat_exp", 2000000);
    set("daoxing", 2000000);

    create_family("南海普陀山", 5, "弟子");

    ::generate_me(0, 300, 300, 3, 0, 0, name, ({"luo han", "luohan"}), 0);
	set("rank_info/self", "贫僧");
    set("title", "十八罗汉");

	carry_object("/d/nanhai/obj/sengpao")->wear();
	carry_object("/d/nanhai/obj/budd_staff")->wield();
}

