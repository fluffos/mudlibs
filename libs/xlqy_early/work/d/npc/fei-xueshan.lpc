// tomcat

inherit __DIR__ "fei.lpc";



void set_skills() {
  object me = this_object();
  object weapon;

  int j;
  j = 200 + random(150);
  create_family("大雪山", 2, "弟子");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("blade", j + random(15));
  me->set_skill("bingpo-blade", j + random(15));
  me->set_skill("xiaoyaoyou", j + random(15));
  me->set_skill("dengxian-dafa", j + random(15));
  me->set_skill("ningxie-force", j + random(15));
  me->set_skill("cuixin-zhang", j + random(15));

  me->map_skill("force", "ningxie-force");
  me->map_skill("blade", "bingpo-blade");
  me->map_skill("parry", "bingpo-blade");
  me->map_skill("spells", "dengxian-dafa");
  me->map_skill("dodge", "xiaoyaoyou");
  me->map_skill("unarmed", "cuixin-zhang");

  set("skill_level/unarmed", "master");
  set("skill_level/dodge", "master");
  set("skill_level/force", "master");
  set("skill_level/spells", "master");
  set("skill_level/parry", "master");
  set("skill_level/blade", "master");




  me->delete_temp("wuxing/init_done");
  WUXING_D->init_user_wuxing(me);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "blade", "hgz" :),
    (: cast_spell, "juanbi" :),
    (: exert_function, "ningxie" :),
    (: exert_function, "mohu" :),
    (: perform_action, "blade", "ningxie" :),
    (: perform_action, "unarmed", "cuixin" :),
  }));
  weapon = new("/d/obj/weapon/blade/jindao");
  weapon->move(me);
  command("wield all");
}
