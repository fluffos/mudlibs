inherit NPC;

#include <ansi.h>
int big_blowing();
void create()
{
         set_name("僵尸", ({ "jiang shi", "shi" }) );
         set("gender", "雄性");
         set("age", 300);
         set("long",
        "这是乱葬岗的僵尸，身带剧毒，小心别惹它 ！\n");
         set("str", 26);
         set("cor", 42);
         set("cps", 12);
         set("max_kee", 2500);
         set("max_gin", 2500);
         set("max_sen", 2500);
         set("force",1500);
         set("max_force",1500);
         set("mana",2000);
         set("max_mana",2000);
         set("force_factor",40);
         set_skill("parry",120+random(50));
         set_skill("dodge",120+random(50));
         set_skill("lingfu-steps",120+random(50));
         set_skill("unarmed",120+random(50));
         set_skill("yinfeng-zhua",120+random(50));
         map_skill("unarmed","yinfeng-zhua");
         map_skill("parry","yinfeng-zhua");
                map_skill("dodge","lingfu-steps");
         set("attitude", "aggressive");
         set("combat_exp", 444444+random(111111));
          set("chat_chance_combat", 30);
         set("chat_msg_combat", ({
                (: big_blowing :),
               
                }) );
         setup();
          
}
void init()
{
        if(interactive(this_player()))
                this_object()->kill_ob(this_player());  
        
        
        
}
int big_blowing()
{
        int i ;
        object  me = this_object();
        object who = me->select_opponent();
        if(!who)        return 0;
        if(me->query("mana") < 800)     return 0;
        if(me->is_busy())       return 0;
        message_vision(HIG"$N嘿嘿怪笑几声，张口吐出一股绿烟。\n"NOR,me);
        me->add("mana",-600);
        if(random(100) > 60)
        {
                i = random(4);
                if(i == 0)
                {
                        who->receive_damage("kee", 50+who->query("kee")/15);
                        who->receive_wound("kee", random(50)+who->query("kee")/15);
                        message_vision(HIG"$N一个不慎，吸了一口绿烟，只觉得全身血脉不畅难受之极！\n"NOR,who);   
                }
                else if(i == 1)
                {
                        who->receive_damage("sen", 50+who->query("sen")/15);
                        who->receive_wound("sen", random(50)+who->query("sen")/15);
                        message_vision(HIG"$N一个不慎，吸了一口绿烟，只觉得头晕脑热眼冒金星！\n"NOR,who);       
                }
                else if(i == 2)
                {
                        who->add("force", -80-who->query("force")/10);
                        if(who->query("force") < 0)
                                who->set("force",0);
                        message_vision(HIG"$N一个不慎，吸了一口绿烟，只觉得全身经脉不畅内力似乎凝固一般！\n"NOR,who);           
                }
                else 
                {
                        who->add("mana", -80-who->query("mana")/10);
                        if(who->query("mana") < 0)
                                who->set("mana",0);
                        message_vision(HIG"$N一个不慎，吸了一口绿烟，只觉得头皮一阵阵发麻，法力运转大受影响！\n"NOR,who);
                }
                
        }
        return 1;
        
}

