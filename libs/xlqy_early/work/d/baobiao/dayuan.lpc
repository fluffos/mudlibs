#include <room.h>
inherit ROOM;

void create()
{
        set("short", "镖局大院");
        set("long", @LONG

院子非常的大，却无一颗树木。据说是为了防止有人利用树丛隐蔽来劫镖。
趟子手、镖师们平常时候都在此处练习武艺，因此地上的砖磨的坑坑洼洼
的。北面是镖局的大厅，东面是一条弯弯曲曲的碎石小路通向一个拱门。
LONG
        );

        set("exits", ([
        "south" : __DIR__"gate",
        "north" : __DIR__"hall",
        ]));

        set("objects", ([
	//sizeof() == 2
                __DIR__"npc/huyuan" : 1,
                __DIR__"npc/guanjia":1,
        ]));

        setup();
}
