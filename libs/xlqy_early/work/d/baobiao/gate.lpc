
inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","镖局大门");
        set ("long", @LONG

这里便是振远镖局的大门口，此刻却是大门紧闭，十分的冷清。门口的一对石狮子
有些年头了，显得有些破败。正对门是一颗大樟树，枝叶繁茂，树下有些石桌石凳。
平常时候，镖局的趟子手们在树下谈笑闲聊，下棋打牌。此刻却冷冷清清，空无一
人。门口上方挂着镖局的招牌(sign),上面的字闪闪发光。
LONG);

	 set("item_desc", (["sign" : @TEXT
上面写着龙飞凤舞的四个金字:振远镖局。
TEXT ]));
        set("exits", 
        ([ //sizeof() == 1
		"south" : "/d/eastway/wangnan5",
                
        ]));

        set("objects", 
        ([ 
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
	setup();
//	replace_program(ROOM);
}
void init()
{
 	add_action("do_open","open");
	add_action("do_knock","knock");
}
int do_open(string arg)
{	
	object who=this_player();
	if(!arg||arg!="door")
	 { tell_object(who,"你要打开什么?\n");
	   return 1;
	  }
	tell_object(who,"随随便便去开人家的门，不好吧!\n");
	return 1;
}
int do_knock()
{
	
	object me=this_player();
	string myrespect=(string)RANK_D->query_respect(me);

	if(me->query_temp("baobiao/萧萧推荐"))
	{
  	message_vision("$N拾起门上的大铜环扣了扣门。\n",me);
	message_vision("只听“吱”的一声，大门被拉开了一条缝。\n", me);
	message_vision("一个家丁打扮的人探出头来看了看。\n", me);
	message_vision("家丁道：噢？是萧大小姐请你来的？请进，请进。\n",me);
	message_vision("家丁将$N请了进去。\n",me);
	me->move(__DIR__"dayuan");
	return 1;

	}
	if(me->query("baobiao/成功结局"))
	   {
	   	
       		message_vision("$N拾起门上的大铜环扣了扣门。\n",me);
		message_vision("只听“吱”的一声，大门被拉开了一条缝。\n", me);
  		message_vision("一个家丁打扮的人探出头来看了看。\n", me);
		message_vision("家丁道：啊，是"+myrespect+"您啊，请进，请进。\n", me);
		message_vision("家丁点头哈腰的将$N请了进去。\n",me);
		me->move(__DIR__"dayuan");
		return 1;
  		}
		message_vision("$N拾起门上的大铜环扣了扣门。\n",me);
	   	message_vision("只听“吱”的一声，大门被拉开了一条缝。\n", me);
 		message_vision("一个家丁打扮的人探出头来看了看。\n", me);
  		message_vision("家丁道：对不起了，这位"+myrespect+"，总镖头暂时不见外人。\n", me);
  		message_vision("说罢，家丁关上了大门。\n",me);
  		return 1;
}

 
