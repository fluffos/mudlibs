#include <ansi.h>

inherit ITEM;

void create() {
  set_name("回执", ({ "receipt" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("long", "一张回执，上面有振远镖局的大红印章，是顾主取回镖物的凭证。\n");
    set("unit", "张");
    set("value", 0);
    set("no_put", "快拿去向镖局交差吧！\n");
    set("no_sell", "快拿去向镖局交差吧！\n");
    //	set("no_give","快拿去向镖局交差吧！\n");
    set("no_get", 1);
    set("no_drop", "快拿去向镖局交差吧！\n");

  }
  setup();
}
