
#include <ansi.h>

inherit ITEM;

void create()
{
set_name("红货", ({"honghuo"}));
        set_weight(100);
        if(clonep())
                set_default_object(__FILE__);
        else {

        set("long","一份红货，上面贴有振远镖局的大红封条，价值不菲。\n");
        set("unit", "份");
        set("value", 0);
        set("no_put","快拿去向堂主交差吧！\n");
        set("no_sell","快拿去向堂主交差吧！\n");
//      set("no_give","快拿去向堂主交差吧！\n");
        set("no_get",1);
        set("no_drop","快拿去向堂主交差吧！\n");
        
        }
        setup();
}

