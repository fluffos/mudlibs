
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("镖单", ({"paper"}));
	set_weight(100);
	if(clonep())
    		set_default_object(__FILE__);
  	else {

        set("long","一张顾主写着目的地的镖单，上面还有顾主的签名和手印。\n");
        set("unit", "张");
        set("value", 0);
	set("no_put",1);
	set("no_sell",1);
	
	}
	setup();
}

string long()
{
	if(stringp(query("desc")))
		return "一张顾主写着目的地的镖单，上面还有顾主的签名和手印。\n"+
		"只见上面写着：\n"+query("position")+"\n"+
		query("desc");
}

