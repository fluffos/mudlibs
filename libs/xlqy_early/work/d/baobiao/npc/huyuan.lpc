// asdf 2003.08.20

#include <ansi.h>

inherit NPC;
int ask_jiebiao();

string *story = ({
  "刘二牛说道：“前些日子，镖局接道一笔生意，听说还是大内的主顾。”\n",
  "“一共十多个大箱子，看起来价值不菲。萧副总镖头不敢怠慢，决定亲自押送。”\n",
  "“我们振远镖局四个字在江湖上也是响当当的，黑白两道都给我们几分面子。”\n",
  "“未曾想到，镖车路过高家庄打尖的时候，出来一伙强人劫镖！”\n",
  "说到这里，刘二牛咽了咽嘴中的唾沫，面露恐惧之色，回想起当时惨烈的场景。\n",
  "“当时小的吃坏了东西，闹肚子，正在茅房出恭，听到外面传来打斗之声。”\n",
  "“小的往外望去，一伙蒙面人正和兄弟们厮杀混战。”\n",
  "“那些强人武艺看起来也不甚高明，比我们总镖头更是差远了。”\n",
  "“小的正打算出去助战的时候，天上突然飞下几个人影。”\n",
  "“小的根本没有看清他们出手，兄弟们就纷纷倒地不起，总镖头也受伤不轻。”\n",
  "“小的当时脚就软了，大气也不敢出一口。”\n",
  "刘二牛用颤抖的声音说道：“他们不是人，是鬼，是妖”。\n",
  "“一个白衣人口中念了几句什么，死去的兄弟纷纷都变成僵尸站起来，向总镖头扑过去。”\n",
  "“还有人变身成一头大象，伸出长鼻子去卷副总镖头。”\n",
  "“副总镖头眼看就要遭害，他老人家掏出一张符纸，咬破手指在上面画了几下，突然就消失的无影无踪。”\n",
  "“小的看那伙人劫了镖车后渐渐远去了，才偷偷从茅厕溜了出来，趁着天黑回到镖局。”\n",
  "“小的回来的时候，镖局四周都是官兵，据说是镖主来过了。”\n",
  "“那伙强人看起来像是高家庄附近清风寨的，那伙小毛贼我也曾遇到过，绝对不会有那么厉害的高手在。”\n",
  "“小的知道的也就这么些了，希望上天保佑，能早日找回失镖。”\n"
});
nosave int step = 0;
void create() {

  set_name("刘二牛", ({ "liu erniu", "liu", "huyuan", "erniu" }));
  set("gender", "男性");
  set("title", "护院");
  set("str", 25);
  set("age", 40 + random(10));
  set("attitude", "peaceful");
  set("combat_exp", 40000);
  set("daoxing", 40000);
  set_skill("unarmed", 40);
  set_skill("dodge", 50);
  set_skill("parry", 40);
  set("max_kee", 500);
  set("max_sen", 400);
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 10);
  set("mana_facotr", 5);
  set("max_mana", 30);
  set("mana", 30);
  setup();
  carry_object("/d/obj/cloth/magua")->wear();
  set("inquiry", ([
    "劫镖": (: ask_jiebiao :),
    "jiebiao": (: ask_jiebiao :),
    "总镖头": "我们镖局的总镖头就是大名鼎鼎的萧振远萧老英雄,他老人家有个儿子萧升，女儿萧萧，在长安也是赫赫有名。\n",
    "萧振远": "萧振远就是我们镖局的总镖头。不过如今他老人家已经退休了，现在镖局管事的是萧升大少爷。\n",
    "name": "小的名叫刘二牛，在镖局有些年头了。\n",
    "here": "这里是萧振远萧老英雄开的振远镖局，在长安说得上是家喻户晓啊，西域各地也有我们的分局。\n",
    "振远镖局": "振远镖局开创二十多年，在江湖上也略有薄名，五花翎旗所到之处，黑白两道的朋友无不卖我们几分面子。\n",
    "镖局": "振远镖局开创二十多年，在江湖上也略有薄名，五花翎旗所到之处，黑白两道的朋友无不卖我们几分面子。\n",
    "五花翎旗": "那是我们振远镖局的镖旗。\n",
    "萧萧": "那是我们总镖头的女儿，镖局的副总镖头，人长的漂亮，武功也很好，还在长安城中心开了家兵器铺。\n",
    "萧升": "他是总镖头的长子，现在镖局实际管事的就是他了。为人豪爽仗义，对待下属更是没的说，唉。。可惜。。\n",
    "保镖": "这个啊，最近我们镖局有点事，暂时停止保镖生意。\n",

  ]));
  setup();
}
int accept_object(object who, object ob) {
  object me = this_object();
  int value = ob->value();
  if (value == 0) {
    command("bite");
    return notify_fail("刘二牛说到，这个...\n");
  } else if (value >= 5000) {
    command("dance");
    say("刘二牛说道:今天一定能把昨晚上输的都赚回来！这位" + RANK_D->query_respect(who) + ",您有什么吩咐尽管说。\n");
    who->set_temp("baobiao/huilu", 1);
    call_out("destruct_me", 1, ob);

    return 1;
  }
  command("hmm");
  call_out("destruct_me", 1, ob);

  return 1;

}

int accept_fight(object me) {
  command("say 萧总镖头不许我们和外人动手\n");
  return 0;
}
int ask_jiebiao() {
  object who = this_player();
  if (!who->query_temp("baobiao/huilu")) {
    message_vision("刘二牛懒洋洋的看了$N一眼，转过头去。\n", who);
    message_vision("刘二牛伸出左手，五根手指头搓了搓。\n", who);
    return 1;
  }
  if (!who->query_temp("baobiao/letter")) {
    command("sigh");
    message_vision("刘二牛说道：不是小的不愿意说，实在是此事关系重大，不能对外人道也。\n", who);
    command("sorry");
    return 1;

  } else {

    who->set("baobiao/story", 1);
    message_vision("“这位" + RANK_D->query_respect(who) + "既然是萧大小姐所请，小的必定知无不言，言无不尽。”\n", who);
    command("sigh");
    call_out("tell_story", 2, who, 0);
    return 1;
  }






}

int heal_up() {

  if (environment() && !is_fighting()) {
    if (random(5) > 3) {
      if (objectp(present("zhang", environment(this_object())))) {
        switch (random(6)) {
          case 0:
            command("say 老张,又打瞌睡呢?昨晚是不是...");
            command("grin zhang");
            break;
          case 1:
            command("say 奶奶的,昨晚上又输光了!");
            command("bbtang liu");
            break;
          case 2:
            command("say 萧大小姐长的还挺漂亮的...可惜..");
            command("moon");
            break;
          case 3:
            command("say 唉，不知道萧大小姐能不能请到高手相助啊。");
            command("sigh");
            break;
          case 4:
            command("say 劫镖的据说是清风寨的强人.当时真是九死一生啊!");
            command("mobai liu");
            break;
          case 5:
            command("say 老张,最近手头紧,您能不能...");
            command("beg zhang");
            break;
        }
      }
    }
  }
  return ::heal_up() + 1;
}
void destruct_me(object ob) {
  destruct(ob);
}
void tell_story(object who, int step) {

  tell_object(who, CYN + story[step] + NOR);
  if (step < sizeof(story) - 1) {
    step++;
    call_out("tell_story", 2, who, step);

  }

}
