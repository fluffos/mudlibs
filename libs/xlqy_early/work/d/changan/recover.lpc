#include <ansi.h>
inherit ROOM;

int block_cmd(string args) {
  string verb;
  verb = query_verb();

  if (verb == "bian"
    || verb == "xiudao"
    || verb == "exert"
    || verb == "drop"
    || verb == "cut"
    || verb == "ti") {
    return 1;
  }

  return 0;
}

void create() {
  set("short", HIW "亭台水榭" NOR);
  set("long", @LONG

这是新加入西行之旅的修行者们的乐园。他们在这里可以祈祷以得到
天神的恩赐，用以恢复精神和气血。神牌上有几个小字(words)。
LONG);

  set("item_desc", ([ "words": "可以在此恢复精神和气血。TTSX，就可以恢复！", ]));

  set("exits", ([  //sizeof() == 1
  "up": "/d/changan/southseashore",
  ]));

  set("no_time", 1);
  set("no_fight", 1);
  set("no_wear", 1);
  set("no_magic", 1);
  set("freeze", 1);

  set("no_clean_up", 0);

  setup();
}


void init() {
  add_action("do_TTSX", "TTSX");
}

int do_TTSX(string arg) {
  object me;

  me = this_player();

  me->set("food", me->max_food_capacity());
  me->set("water", me->max_water_capacity());

  me->set("max_force", (int)me->query_max_force());
  me->set("max_mana", (int)me->query_max_mana());
  me->set("max_atman", (int)me->query_max_atman());

  me->set("force", 2 * (int)me->query("max_force"));
  me->set("mana", 2 * (int)me->query("max_mana"));
  me->set("atman", 2 * (int)me->query("max_atman"));

  me->set("force_factor", me->query_max_enforce());
  me->set("mana_factor", me->query_max_enchant());
  me->set("lingli_factor", me->query_max_jialing());

  CHAR_D->setup_char(me);

  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("eff_kee"));

  me->set("eff_sen", me->query("max_sen"));
  me->set("sen", me->query("eff_sen"));

  me->set("eff_gin", me->query("max_gin"));
  me->set("gin", me->query("eff_gin"));

  message_vision(HIY "$N顿时感到神清气爽！\n" NOR, me);

  return 1;
}
