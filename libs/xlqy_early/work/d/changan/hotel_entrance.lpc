#include <room.h>
inherit ROOM;
inherit "/d/wiz/no_get.lpc";

void create()
{
    set("short","宾馆大堂");
    set("long", @LONG

这里是情人宾馆的大堂。大堂里，时不时有一对对的情侣进出。
正对面是服务台，一位服务员正在柜台后面低头查帐。柜台后
的墙上挂着宾馆的价目牌(paizi)。

LONG
    );

    set("exits", ([
	"enter": __DIR__"lover_hotel",
	"east": "/d/changan/office",
	"west": "/d/changan/hotel_anmo",
      ]));
    set("objects", ([ /* sizeof() == 1 */
	"/d/changan/npc/waitress" : 1,
      ]));
    set("item_desc",([
    "paizi"   : "住宿每位三两黄金；本店新增按摩服务(anmo)，开张伊始，免费酬宾\n"]));
    create_door("enter", "房间门", "out", DOOR_CLOSED);
    set("no_fight", 1);
    set("no_magic", 1);
    setup();
}
int valid_leave(object me, string dir)
{
    if ( !me->query_temp("hotel/rent_paid") && dir == "enter" )
	return notify_fail("服务员朝你丢了个白眼：怎么，不付钱也想享受？没门！。\n");
    return ::valid_leave(me, dir);
}


