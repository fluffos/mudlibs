//by tanpot 2003_5_22
inherit F_VENDOR_SALE;
int random_go(object me, string *dirs);
void create() {
  reload("waitress");
  set_name("服务员", ({ "waitress", "fuwuyuan" }));
  set("shop_id", ({ "waitress", "fuwuyuan" }));
  set("shop_title", "服务员");
  set("gender", "女性");
  set("combat_exp", 1000);
  set("age", 22);
  set("per", 22);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 10);
  set("max_price", 20);
  set("vendor_goods", ([
    "jiudai": "/d/moon/obj/jiudai",
  ]));
  set("inquiry", ([
    "name": "我？当然是宾馆服务员杨水饺了，连我都不认识，没去过小乐惠啊你，哼！",
    "here": "你是猪头啊？不要告诉我你不知道情人宾馆是什么地方哦！",
    "避孕套": "你真下流！",
    "tanpot": "哦~~西游记第一大好人阿，真的，不骗你。",
  ]));
  if (clonep()) CHANNEL_D->register_relay_channel("rumor");
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
  add_money("silver", 10);
}
int accept_object(object who, object ob) {
  int value;
  if (ob->query("money_id") && (value = ob->value()) >= 3000) {
    tell_object(who, name() + "看着手上的钱，眉花眼笑的说道：请好好享受把。\n");
    who->set_temp("hotel/rent_paid", 1);
    take_money(value, 3000);
    return 1;
  }
  return 0;
}
