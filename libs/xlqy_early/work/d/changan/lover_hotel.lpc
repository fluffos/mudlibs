// 搞笑&学习用
//room...
//make love & fun
#include <room.h>
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "情人宾馆");
  set("long", @LONG

这是一个让人感到舒适的房间。有着干净而明亮的落地窗，紫色的窗帘。房间里，电视机
DVD影碟机，洗手间，一应俱全。
往窗外看去，可看到静静流淌的泾水河和两岸的垂柳。你不禁感叹，真是个惬意的所在。
房间的正中央是一张水床(用bed,gobed,gosleep上床)。你不禁一阵心跳，看来今天会
有一个美好的夜晚了。

LONG);
  set("exits",
    ([  //sizeof() == 1
    "out": __DIR__ "hotel_entrance",
    ]));
  create_door("out", "房间门", "enter", DOOR_CLOSED);
  set("no_fight", 1);
  set("item_desc", ([ "bed": "一张看起来很舒适的水床(gosleep,gobed,bed)。\n", ]));
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("do_bed", "gosleep");
  add_action("do_bed", "gobed",);
  add_action("do_bed", "bed");
}
int do_bed() {
  object me;
  me = this_player();
  message_vision(HIY "$N脱掉睡衣，轻轻钻入了被窝。\n\n" NOR, me);
  me->move(__DIR__ "water_bed");
  message_vision(HIY "\n水床轻轻一颤，$N钻了进来。\n" NOR, me);
  return 1;
}
int valid_leave(object me, string dir) {
  me->delete_temp("rent_paid");
  return ::valid_leave(me, dir);
}
