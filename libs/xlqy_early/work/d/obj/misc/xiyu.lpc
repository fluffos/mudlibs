#include <armor.h>
#include <ansi.h>

inherit FINGER;

void create()
{
	set_name(HIC"雨水之戒"NOR, ({ "rain ring", "jiezhi", "ring" }));
	set("weight", 400);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("value", 200000);
		set("no_sell",1);
	//	set("no_give",1);
		set("no_drop",1);
		set("no_get",1);
		set("can_putin_box",1);
		set("replace_file", __DIR__"xiyu");
		set("long",HIC"这是一枚神秘的戒指。能够给你带来好运。\n"NOR);
		set("material", "gold");
		set("armor_prop/armor", 20);
		set("armor_prop/karma", 3);
		set("armor_prop/personality",3);
}
	
	setup();
	
}
