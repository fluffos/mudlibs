// leizhu.c 泪珠
// last updated by xueyi 8.8.2002
//modified by gamer@88
#include <armor.h>
#include <ansi.h>

inherit F_UNIQUE;
inherit HEAD;

void create() {
  set_name(HIW "泪珠之盔" NOR, ({ "tear kui", "leizhu", "kui" }));
  set("weight", 400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("value", 200000);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_get", 1);

    set("long", HIW "这是一顶神秘的头盔，能带给你无尽的智慧。\n" NOR);
    set("material", "gold");
    set("armor_prop/armor", 30);
    set("armor_prop/intelligence", 5);
    set("armor_prop/personality", 5);
  }
  set("is_monitored", 1);
  setup();
}
int init() {

  unique::init();
  if (userp(this_player()) && !query("had_called")) {
    set("had_called", 1);
    remove_call_out("self_dest");
    call_out("self_dest", 9600 + random(600));
  }

  return 1;
}
void self_dest() {
  object ob;
  object env = environment(this_object());
  if (env)
    tell_object(env, HIY "只见呼的一声,泪珠之盔消失在天边！\n");
  if (userp(env)) {
    ob = new("/d/obj/misc/yanlei");
    ob->move(env);

  }
  destruct(this_object());
}
