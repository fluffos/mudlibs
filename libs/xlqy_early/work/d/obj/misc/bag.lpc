inherit ITEM;

void create() {
  set_name("布袋", ({ "bag" }));
  set_weight(500);
  set_max_encumbrance(2147483000);
  set_max_items(5000);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "口");
    set("long", "这是一口很特殊的布袋，可以装非常多的东西。\n");
    set("value", 50);
    set("no_put", 1);
  }
}

int is_container() {
  return 1;
}
