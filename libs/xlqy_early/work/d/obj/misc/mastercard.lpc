#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIY "一卡通信用卡" NOR, ({ "master card", "card" }) );
    set_weight(15);

    set("value", 10000000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_put", 1);

    if ( clonep() ) 
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("unit", "张");
        set("long", "
                                招商信用卡(Master card)   
                ※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※
                ※                 您可以使用如下命令：                             ※
                ※     取钱：    命令格式：withdraw <数量> <货币单位>               ※
                ※     存钱：    命令格式：deposit  <数量> <货币单位>               ※
                ※     查询余额：命令格式：bank                                     ※
                ※     钱币兑换：命令格式：convert <数量> <货币种类> to <货币种类>  ※
                ※     转账：    命令格式：zhuanzhang <数量> <货币种类> to <对方id> ※
                ※     洪荒西游的通用信用卡，代表着你在本站的信誉。                 ※
                ※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※
            ");
    }
}

int query_autoload()
{
    return 1;
}

void init() 
{
    add_action("do_bank", "bank");
    add_action("do_convert", "convert");
    add_action("do_deposit", "deposit");
    add_action("do_withdraw", "withdraw");
    add_action("do_transfer", "zhuanzhang");
}

int do_bank()
{
    return MONEY_D->do_bank(this_player());
}

int do_deposit(string arg)
{
    return MONEY_D->do_deposit(this_player(), arg);
}

int do_withdraw(string arg)
{
    return MONEY_D->do_withdraw(this_player(), arg);
}

int do_convert(string arg)
{
    return MONEY_D->do_convert(this_player(), arg);
}

int do_transfer(string arg)
{
    return MONEY_D->do_transfer(this_player(), arg);
}

