#include <armor.h>
#include <ansi.h>

inherit WAIST;
inherit F_UNIQUE;
void create() {

  set_name(HIR "战神腰带" NOR, ({ "warlord waist", "waist" }));
  set("weight", 400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 200000);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_get", 1);

    set("long", HIG "这是一件神秘的腰带，能带给你无穷的力量。\n" NOR);
    set("material", "gold");
    set("armor_prop/armor", 50);
    set("armor_prop/strength", 15);


  }
  set("is_monitored", 1);
  setup();
}
int init() {

  unique::init();
  if (userp(this_player()) && !query("had_called")) {
    set("had_called", 1);
    remove_call_out("self_dest");
    call_out("self_dest", 9600 + random(600));
  }

  return 1;
}
void self_dest() {
  object ob;
  object env = environment(this_object());
  if (env)
    tell_object(env, HIR "只见呼的一声,战神腰带消失在天边！\n" NOR);
  if (userp(env)) {
    ob = new("/d/obj/misc/hero");
    ob->move(env);

  }
  destruct(this_object());
}
