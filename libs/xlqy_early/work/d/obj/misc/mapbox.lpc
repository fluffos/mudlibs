void create() {
  set_name(HIG "地图盒" NOR, ({ "map box", "map_box", "box" }));
  set_weight(20);
  set_max_encumbrance(1200);
  if (clonep()) {
    object ob;
    ob = new("/d/obj/magic/bishuizhou");
    ob->move(this_object());
    ob = new("/d/obj/misc/xueshan-map");
    ob->move(this_object());
    ob = new("/d/penglai/npc/obj/ditu");
    ob->move(this_object());
    set_default_object(__FILE__);
  } else {
    set("unit", "个");
    set("no_sell", 1);
    set("long", "这是一只专门用来装地图的宝盒,你可以(get map from box)从里面得到地图。\n");
    set("value", 10000);
  }
}

int is_container() { return 1; }
