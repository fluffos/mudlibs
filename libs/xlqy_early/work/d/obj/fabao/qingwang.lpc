#include <ansi.h>

inherit ITEM;

void self_destruct()
{
    object who = query("owner");

    if ( who && who->query_temp("qingwang") )
    {
        who->delete_temp("qingwang"); 
    }

    destruct(this_object());
}

void create()
{
    set_name("情网", ({"qing wang"}));     
    set("env/invisibility", 1);
    set_weight(10000000);
    seteuid(getuid());

    if ( clonep() )
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("unit", "张");
        set("no_sell", 1);
        set("no_get", 1);
        set("no_give", 1);
        set("no_drop", 1);
        set("expired", 0);
    }    

    setup();
}

void init() 
{
    object target = query("target");
    object me = this_object();

    if ( !target )
    {
        self_destruct();
        return;
    }

    if ( this_player() == query("target") ) 
    {
        add_action("do_cast",({"surrender", "cast", "perform", "exert"}));
    }

    if ( time() > query_temp("time_expired") )
    {
        self_destruct();
    }

    call_out("check_fight", 1, me, target);
}

int check_fight(object me, object target)
{
    object who = query("owner");

    if ( !target || !who)
    {
        self_destruct();
        return 0;
    }

    if ( !living(target) || !present(target, environment(who)) || time() > query_temp("time_expired"))
    {
        remove_call_out("check_fight");
        self_destruct();

        return 1;
    }

    call_out("check_fight", 1, me, target);

    return 1;
}

int do_cast() 
{
    object me = this_player();
    object who = query("owner");
    object weapon = query("weapon");

    if  ( !me || !who || !weapon || time() > query_temp("time_expired") || who->query_temp("weapon") != weapon )
    {
        self_destruct();
    }

    if ( me == query("target") )
    {
        tell_object(me, MAG"你略一运功，眼前立刻出现了那条熟悉的身影，剪不断，理还乱，搅得你心烦气燥。\n"NOR);
        return 1;
    }

    return 0;
}

