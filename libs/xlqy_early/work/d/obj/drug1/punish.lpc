#include <ansi.h>
inherit SKILL;

inherit COMBINED_ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
       
    set("no_drop","这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create()
{
  set_name( HIY "惩罚丹" NOR , ({"punish dan", "dan"}));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
   set("base_unit","颗");
    set("unit", "些");
    set("long", "一颗金黄色的丹丸，用来惩罚非法玩家的。\n");
      set("value", 400000);
    set("drug_type", "补品");
  }
  set_amount(1);

  setup();
}

int do_eat(string arg)
{
  mapping me_skill;
  object me;
  int lv,i,size;
  string *strs;

	me = this_player();	
  if (arg!="dan" && arg!="punish dan")	return 0;

  me->add_maximum_force( -(int)me->query("max_force")/10 );
  me->add_maximum_mana( -(int)me->query("max_mana")/10 );
  
  me->set("combat_exp", (int)me->query("combat_exp")/100*80);
  me->set("daoxing", (int)me->query("daoxing")/100*80);
	
	me_skill = me->query_skills();
	strs = keys(me_skill);
	size =sizeof(me_skill);
	for (i = 0; i < size; i++)
  	{
  		lv = me->query_skill(strs[i],1);
  		if( lv >10 )
    			me->set_skill(strs[i],lv/10*9);
  	}
	
  message_vision(HIG "$N轻轻掰开一颗惩罚丹很不情愿地送入嘴中，一时间黑云笼罩！\n" NOR, me);
  tell_object(me, "\n你突然觉得身上缺了什么东西…\n");
  add_amount(-1);
  me->save();
  // destruct(this_object());
  return 1;
}


