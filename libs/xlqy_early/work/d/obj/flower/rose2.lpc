#include <ansi.h>

inherit F_SAVE;
inherit COMBINED_ITEM;

void create() {
  set_name(HIR "野蔷薇" NOR, ({ "rose", "meigui" }));
  set("unit", "把");
  set("base_weight", 10);
  set("long", "一把野生的玫瑰花。\n");
  set("base_unit", "朵");
  set("material", "flower");
  set_amount(20 + random(20));
  set("value", 10);
  setup();
}
