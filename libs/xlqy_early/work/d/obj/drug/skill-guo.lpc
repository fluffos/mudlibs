#include <ansi.h>

inherit ITEM;

int do_eat(string);
string give_reward(object me);
void init();

void init()
{
      if(this_player()==environment())
        add_action("do_eat", "touch");
}

void create()
{
  set_name(BLK"技能石" NOR, ({"jineng stone", "", "stone"}));
       set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "一颗黑幽幽的石头，外面看不出有啥古怪，抚摸一下能感觉到里面神秘的能量。\n");
                  set("no_put",1);
                  set("no_get",1);
                  set("no_give",1);
                  set("no_sell",1);
        }
  
        set("is_monitored",1);
        setup();
}

int do_eat(string arg)
{
        int howmany;

        object me = this_player();
  
        if (!id(arg)) return notify_fail("你要抚摸什么？\n");
        
                                give_reward(me);
        destruct(this_object());

        return 1;
}
string give_reward(object me) {
  mapping skill=me->query_skills();
  string *skillnames;
  string selected,msg;
  int level, inc=1,pot;

  if (!skill) return "none";

  skillnames=keys(skill);
  if(sizeof(skillnames) < 1)
   return "none";
  selected=skillnames[random(sizeof(skillnames))];

  level=skill[selected];
if (level < 1) return "none";
  if(level<120) {
      inc=0;
  } else if(level<210) {
      inc=random(2);
  } else if(level<350) {
      inc=random(3);
  } else {
      inc=random(4);
  }

  if(1) {
    me->set_skill(selected,level+1);
    tell_object(me,"你得到了一级"+ to_chinese(selected) + "。\n");
    msg="听说"+HIR+ me->query("name")+ NOR+HIC"得到了技能石的神秘能量，得到一级"+HIW+to_chinese(selected)+NOR+HIM+"！\n"+NOR;
                                CHANNEL_D->do_channel(this_object(),"rumor",msg);
    return selected;
  }
else
  return "none";
}


