//qin.c

#include <weapon.h>

inherit QIN;

void create()
{
	set_name("木琴", ({"muqin","qin"}) );
	set_weight(6000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "具");
		set("material", "wood");
		set("long", "这是一具用上好的梧桐木做的古琴。\n");
		set("value", 500);
		set("wield_msg", "$N拿出一具$n，调了调琴弦。\n");
		set("unwield_msg", "$N放下手中的$n。\n");
		set("music_type","qin");
	}
	init_qin(25, TWO_HANDED);
	setup();
}

