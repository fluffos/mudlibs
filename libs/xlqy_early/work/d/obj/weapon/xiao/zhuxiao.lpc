//竹箫 gamer@88

#include <weapon.h>

inherit XIAO;

void create() {
  set_name("竹箫", ({ "zhuxiao", "xiao" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("material", "bamboo");
    set("long", "一根青翠的竹箫。\n");
    set("value", 500);
    set("wield_msg", "$N拿出一根$n，放在唇边。\n");
    set("unwield_msg", "$N放下手中的$n。\n");

  }
  init_xiao(25, TWO_HANDED);
  setup();
}
