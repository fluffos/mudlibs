#include <ansi.h>
inherit ITEM;

void create() {
  set_name(MAG "盘丝大法卷轴" NOR, ({ "magic scroll", "scroll" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是张魔法卷轴，运用灵力可以驱动它释放出盘丝大法的威力(wuzhishan)。\n");
    set("unit", "卷");
    set("value", 5000);
    set("fashu", "pansi-dafa");
    set("cast_item/wuzhishan", 1);

  }
  setup();
}
