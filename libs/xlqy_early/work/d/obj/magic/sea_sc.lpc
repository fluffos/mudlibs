#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIC "碧海神通卷轴" NOR, ({ "magic scroll", "scroll" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是张魔法卷轴，运用灵力可以驱动它释放出碧海神通的威力(water,freez)。\n");
    set("unit", "卷");
    set("value", 5000);
    set("fashu", "seashentong");
    set("cast_item/freez", 1);
    set("cast_item/water", 1);

  }
  setup();
}
