#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIC"登仙大法卷轴"NOR, ({"magic scroll", "scroll"}));
 set_weight(100);
 if( clonep() )
             set_default_object(__FILE__);
       else {
 set("long","这是张魔法卷轴，运用灵力可以驱动它释放出登仙大法的威力(juanbi)。\n");
 set("unit", "卷");
 set("value", 5000);
 set("fashu","dengxian-dafa");
 set("cast_item/juanbi",1);

  }
  setup();
}
