#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIB "道家仙法卷轴" NOR, ({ "magic scroll", "scroll" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是张魔法卷轴，运用灵力可以驱动它释放出道家仙法的威力(light,thunder,preservation)。\n");
    set("unit", "卷");
    set("value", 5000);
    set("fashu", "dao");
    set("cast_item/light", 1);
    set("cast_item/thunder", 1);
    set("cast_item/preservation", 1);
  }
  setup();
}
