#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIM"月宫神通卷轴"NOR, ({"magic scroll", "scroll"}));
 set_weight(100);
 if( clonep() )
             set_default_object(__FILE__);
       else {
 set("long","这是张魔法卷轴，运用灵力可以驱动它释放出月宫神通的威力(arrow,huimeng)。\n");
 set("unit", "卷");
 set("value", 5000);
 set("fashu","moonshentong");
 set("cast_item/arrow",1);
set("cast_item/huimeng",1);
  }
  setup();
}
