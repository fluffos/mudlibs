#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("八歧战衣", ({"cloth"}));
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
     set("long",
"用血红色的毛皮制成，上面还镶了一道金边。．\n");
                set("material", "cloth");
                set("unit", "件");
                set("value", 400);
                set("armor_prop/armor", 105);

        }
        setup();
}


