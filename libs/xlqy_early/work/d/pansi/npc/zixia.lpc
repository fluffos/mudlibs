#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_love();
string skill_lvl();
int improve(string arg);
int sword_gm();
int xlqy_quest();
int ask_sword();

void create() {
  set_name(HIM "紫霞仙子" NOR, ({ "zixia xianzi", "zixia", "xianzi", "master" }));
  set("long", "她就是盘丝洞的开山祖师,传说她是佛祖的一棵灯芯。随佛祖修道悟
真,后来思凡下界占了花果山一处洞府,开山立派,传授门徒。\n");
  set("title", HIB "盘丝大仙" NOR);
  set("gender", "女性");
  set("age", 20);
  set("class", "xian");
  set("attitude", "friendly");
  set("rank_info/respect", "小姑娘");
  set("cor", 30);
  set("per", 40);
  set("max_kee", 4500);
  set("max_gin", 800);
  set("max_sen", 4500);
  set("force", 5000);
  set("max_force", 3000);
  set("force_factor", 125);
  set("max_mana", 2500);
  set("mana", 5000);
  set("mana_factor", 250);
  set("combat_exp", 3000000);
  set("daoxing", 4000000);
  set_skill("literate", MAX_SKILL_LEVEL - 20);
  set_skill("unarmed", MAX_SKILL_LEVEL);
  set_skill("dodge", MAX_SKILL_LEVEL);
  set_skill("force", MAX_SKILL_LEVEL + 20);
  set_skill("parry", MAX_SKILL_LEVEL);
  set_skill("sword", MAX_SKILL_LEVEL);
  set_skill("spells", MAX_SKILL_LEVEL);
  set_skill("whip", MAX_SKILL_LEVEL + 20);
  set_skill("pansi-dafa", MAX_SKILL_LEVEL + 20);
  set_skill("lanhua-shou", MAX_SKILL_LEVEL);
  set_skill("jiuyin-xinjing", MAX_SKILL_LEVEL);
  set_skill("chixin-jian", MAX_SKILL_LEVEL);
  set_skill("qin", MAX_SKILL_LEVEL);
  set_skill("yueying-wubu", MAX_SKILL_LEVEL);
  set_skill("yinsuo-jinling", MAX_SKILL_LEVEL);
  map_skill("spells", "pansi-dafa");
  map_skill("unarmed", "lanhua-shou");
  map_skill("force", "jiuyin-xinjing");
  map_skill("sword", "chixin-jian");
  map_skill("parry", "yinsuo-jinling");
  map_skill("dodge", "yueying-wubu");
  map_skill("whip", "yinsuo-jinling");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "wuzhishan" :),
    (: cast_spell, "ziqi" :)
  }));
  set("inquiry", ([
    "爱神": (: ask_love :),

    "剑意": (: sword_gm :),
    "缘分": ( : xlqy_quest :),
      "有缘" : ( : xlqy_quest :),
        "紫青宝剑" : (: ask_sword :),
        "紫青剑" : (: ask_sword :),
        "青索剑" : "那是我姐姐青霞仙子的护身宝剑。\n",
        "紫郢剑" : "那是我的护身宝剑，如今却不知下落。\n",

      ])); create_family(
    "盘丝洞",
    1,
    "红"
  ); setup(); carry_object("/d/obj/cloth/tianyi.lpc")->wear(); carry_object("/d/obj/weapon/sword/qinghong")->wield();  //     carry_object("/d/pansi/obj/ziqing.lpc")->wield();
  //      carry_object("/d/pansi/obj/baohe.lpc");
  carry_object("/d/ourhome/obj/shoes")->wear(); }
    void init()
    {}
    void attempt_apprentice(object ob)
    {

      if ((string)ob->query("family/family_name") == "盘丝洞") {
        if (((int)ob->query("combat_exp") < 1000000)) {
          command("say " + RANK_D->query_respect(ob) +
            "的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
          return;
        }
        command("pat " + ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) +
          "多加努力，他日帮我杀了那个臭猴子。\n");
        command("recruit " + ob->query("id"));
        ob->set("title", "花果山盘丝大仙护法");
        ob->set("class", "xian");
        return;
      }
      command("shake");
      command("say " + RANK_D->query_respect(ob) +
        "还是先去学些基础功夫吧。\n");
      return;
    }
    int accept_fight(object me)
    {
      return 0;
    }

    int ask_love()
    {
      object ob = this_player();
      if (ob->query("family/family_name") != "盘丝洞") {
        command("say 你又不是盘丝洞的，学它做什么?");
        return 1;
      }
      if (ob->query("family/master_name") != this_object()->query("name")) {
        command("say 你又不是我的徒弟，谁管你！");
        return 1;
      }
      if (!ob->query("pansi/love_master")) {
        ob->set("pansi/love_master", 1);
        command("say 这一招爱神，是为师多年修炼所悟，应该可以帮你保命的！");
        ob->set("pansi/ask_zixia_go", 1);
        return 1;
      } else {
        command("say 这一招爱神，我不是已经传给你了吗?");
        return 1;
      }
    }

    int sword_gm()
    {

      object who = this_player();
      object me = this_object();

      if (!userp(who))
        return 0;
      if (who->query("skill_level/sword") == "grandmaster") {
        message_vision(CYN "$N笑了笑，摇了摇头，道：你还未堪破么？\n" NOR, me);
        return 1;

      }

      if (!who->query("skill_level/sword")) {
        message_vision(CYN "$N幽幽的叹了口气，道：你虽手中有剑，心中却无剑，更何提『剑意』二字？\n" NOR, me);
        return 1;

      }
      if (who->query("skill_level/sword") == "expert") {
        message_vision(CYN "$N幽幽的叹了口气，道：你虽已是心剑之境，却还拘泥于剑器，至于剑意之境，更是休提。\n" NOR, this_object());
        return 1;

      }
      if (who->query_skill("sword", 1) < 350) {

        message_vision(CYN "$N笑了笑，摇了摇头道：你现在无法堪破剑意之境。\n" NOR, this_object());
        return 1;
      }
      if (who->query("family/family_name") != "月宫" && who->query("family/family_name") != "盘丝洞" && who->query("family/family_name") != "蜀山剑派" && who->query("family/family_name") != "陷空山无底洞") {
        message_vision(CYN "$N笑了笑，摇了摇头道：你现在无法堪破剑意之境。\n" NOR, this_object());
        return 1;

      }
      if (!LEVEL_D->check_ob_for_level(who, "grandmaster")) {
        tell_object(who, "你对门派的的贡献似乎不够啊。。。\n" NOR);
        return 1;

      }

      message_vision(CYN "$N道：要达到剑意之境却也不难，只要你我有缘，我自然助你一臂之力。\n" NOR, this_object());

      who->set("upgrade/sword_gm", 1);
      return 1;

    }
    int xlqy_quest()
    {
      object who = this_player();
      object me = this_object();
      if (!userp(who))
        return 0;

      if (who->query("legends/xlqy")) {
        if (who->query("legends/xlqy") == "success") {
          message_vision(CYN "$N轻轻一笑道：有缘千里来相会。\n" NOR, me);

          return 1;
        } else {

          command("sigh2");
          return 1;

        }

      }
      if (who->query_temp("legends/xlqy_start")) {

        message_vision(CYN "$N道：快去寻回紫青宝剑吧。\n" NOR, this_object());

        return 1;
      }
      message_vision(CYN "$N" + CYN "说道：我和我姐姐青霞仙子本是佛祖的一根灯芯，生生世世纠缠不清。\n" NOR, this_object());
      message_vision(
        CYN "$N" + CYN "幽幽叹了口气，道：当年我思凡下界寻找我的缘分，立下誓言，谁能拔出紫青宝剑，谁就与我有缘。\n" NOR,
        this_object()
      );
      message_vision(CYN "我姐姐怨我有辱师门，我又拿走了她的青索剑，一路追杀我至此。后来...\n" NOR, this_object());
      message_vision(CYN "经月光宝盒一战后，我身受重伤，失去紫青剑。青索剑被我姐姐所取回，紫郢剑却不知所踪。\n" NOR, this_object());
      message_vision(CYN "你若能助我找回紫青剑，我自当有所报答^_^\n" NOR, this_object());

      who->set_temp("legends/xlqy_start", 1);
      return 1;

    }
    int ask_sword()
    {

      message_vision(CYN "紫青宝剑是我姐姐青霞的青索剑和我的紫郢剑所合。\n" NOR, this_object());
      message_vision(CYN "青索剑现在我姐姐手中，我姐姐脾气不太好，你去讨剑要多加小心些。\n" NOR, this_object());
      message_vision(CYN "紫郢剑却不知去处。当年我身负重伤，是灵山佛祖救了我，佛祖他老人家法力无边，也许能推算出紫郢剑的下落。\n" NOR, this_object());
      return 1;

    }
