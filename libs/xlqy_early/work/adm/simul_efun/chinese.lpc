string chinese_number(int i)
{
    return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
    return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
    // AGENTS.md §15h: this driver's strings are UTF-8 native, so str[0] is
    // a Unicode codepoint (e.g. 0x4e2d for 中), not a raw GBK lead byte --
    // the original "str[0] > 160 && str[0] < 255" GBK-byte-range check
    // (which also required a 2-byte-wide slice, strlen(str)>=2) never
    // matches real Chinese text under UTF-8. Check the CJK Unified
    // Ideographs block on a single character instead.
    if ( strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff )
    {
        return 1;
    }

    return 0;
}

