// file.c
#include <ansi.h>

void cat(string file) {
  write(read_file(file));
}

void assure_file(string file) {
  string path, *dir;
  int i, count;

  if (file_size(file) != -1) {
    return;
  }

  seteuid(ROOT_UID);

  dir = explode(file, "/");
  dir = dir[0..sizeof(dir) - 2];
  path = "/";

  count = sizeof(dir);
  for (i = 0; i < count; i++) {
    path += dir[i];
    mkdir(path);
    path += "/";
  }
}

void log_file(string file, string text) {
  assure_file(LOG_DIR + file);
  write_file(LOG_DIR + file, text);
}

string base_name(object ob) {
  string file;

  if (sscanf(file_name(ob), "%s#%*d", file) == 2) {
    return file;
  } else {
    return file_name(ob);
  }
}

// tail() was an efun of the MudOS this archive ran on and is not one here: the last 10 lines of a file, as `cmds/*/tail.lpc` expects.
void tail(string file) {
  string content, *lines;
  int start;

  content = read_file(file);
  if (!stringp(content))
    return;
  lines = explode(content, "\n");
  start = sizeof(lines) - 10;
  if (start < 0)
    start = 0;
  write(implode(lines[start..], "\n") + "\n");
}
