#pragma optimize

#include "/adm/simul_efun/atoi.lpc"
#include "/adm/simul_efun/chinese.lpc"
#include "/adm/simul_efun/gender.lpc"
#include "/adm/simul_efun/object.lpc"
#include "/adm/simul_efun/path.lpc"
#include "/adm/simul_efun/wizard.lpc"

// This must be after gender.c
#include "/adm/simul_efun/message.lpc"
#include "/adm/simul_efun/file.lpc"

private int system_type = SYSTEM_32BIT;

void create() {
  int temp = 2147483648;

  temp++;

  if (0 < temp) {
    system_type = SYSTEM_64BIT;
  } else {
    system_type = SYSTEM_32BIT;
  }

  seteuid(getuid());

  write("simul_efun loaded successfully.\n");
}

int system_type() {
  return system_type;
}

varargs mixed system_call(mixed func_64, mixed func_32, mixed args_64, mixed args_32) {
  switch (system_type) {
    case SYSTEM_64BIT:
      if (!functionp(func_64)) {
        return args_64;
      }
      return evaluate(func_64, args_64);
      break;
    case SYSTEM_32BIT:
    default:
      if (!functionp(func_32)) {
        return args_32;
      }
      return evaluate(func_32, args_32);
      break;
  }

  return 0;
}

int system_maxmoney() {
  return (int)system_call(0, 0, 9223372036000000000, 2000000000);
}

int system_maxpotential() {
  return (int)system_call(0, 0, 9223372036000000000, 2000000000);
}

int system_maxint() {
  return (int)system_call(0, 0, 9223372036000000000, 2147483000);
}

int system_maxexp() {
  return (int)system_call(0, 0, 9223372036000000000, 2147483000);
}

int system_maxdx() {
  return (int)system_call(0, 0, 9223372036000000000, 2147483000);
}

// dump_socket_status(): the MudOS efun is gone from this driver; the same table, built from socket_status()
// (a driver without the sockets package -- the WASM build -- has no sockets to list: the table is its header only)
string dump_socket_status() {
  string ret = sprintf(
    "%-3s %-10s %-9s %-22s %s\n",
    "Fd",
    "State",
    "Mode",
    "Local Address",
    "Remote Address"
  );
#ifdef __PACKAGE_SOCKETS__
  {
    mixed *all = socket_status();
    int n;

    for (n = 0; n < sizeof(all); n++)
      if (arrayp(all[n]) && sizeof(all[n]) >= 5)
        ret += sprintf(
          "%-3d %-10s %-9s %-22s %s\n",
          all[n][0],
          all[n][1],
          all[n][2],
          all[n][3],
          all[n][4]
        );
  }
#endif
  return ret;
}
