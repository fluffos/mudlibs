#include <ansi.h>
inherit NPC;

string method = "
具体指令如下：
降低天赋：subtract <arg>
增加天赋：add <arg>

选择特技：choose <arg> 
查看已有特技和天赋：state
决定接受：finalize

这里的 <arg> 是特技的缩写：

乘风踏云:agile    镇蕴七星:constitution     护体神功:defense     
聚魄还虚:energy   饕餮转世:greedy           战气冲霄:hatred
内敛乾坤:health   罡睿神慧:intellect        铜皮铁骨:ironskin
福星高照:lucky    狂暴铁拳:might            天神降世:power
灵蕴天成:spirituality

膂力：str    胆识：cor    悟性：int    灵性：spi;
定力：cps    容貌：per    根骨：con    福缘：kar
";
string *gift_name = ({ "agile", "constitution", "defense", "energy",
  "greedy", "hatred", "health", "intellect", "ironskin", "lucky", "might", "power", "spirituality" });

string *tianfu_name = ({ "kar", "con", "per", "cps", "spi", "int", "cor", "str", });
mapping points = ([]);
mapping gift = ([
  "str": "膂力",
  "cor": "胆识",
  "int": "悟性",
  "spi": "灵性",
  "cps": "定力",
  "per": "容貌",
  "con": "根骨",
  "kar": "福缘",
]);
int total = 0;
int credit = 0;
string ask_for_leave();

void create() {
  set_name(HIW "转世轮回菩萨" NOR, ({ "lunhui pusa", "pusa" }));
  set("gender", "女性");
  set("age", 25);
  set("title", HIY "眼望世间虚缈，空、无、灭" NOR);
  set("long", HIG "\n\n佛祖如来身边掌管转世轮回的大智、无我菩萨\n\n" NOR);
  set("combat_exp", 1000000000);
  set("daoxing", 1000000000);

  set("attitude", "peaceful");
  set("per", 40);
  set("max_kee", 20000);
  set("max_gin", 20000);
  set("max_sen", 20000);
  set("inquiry", ([  //
  "轮回转世": (: ask_for_leave :),
    "投胎": (: ask_for_leave :),
  ]));
  setup();
  carry_object("/d/ourhome/obj/pink_cloth")->wear();
  carry_object("/d/ourhome/obj/shoes")->wear();
}

void init() {
  add_action("do_agree", "agree");
  add_action("do_choose", "choose");
  add_action("do_state", "state");
  add_action("do_finalize", "finalize");
  add_action("do_add", "add");
  add_action("do_subtract", "subtract");
}

string ask_for_leave() {
  object me = this_player();

  if (me->query("zuansheng/mark")) {
    command("say " + HIG + "沧海桑田，无望无我，你可愿意抛弃你的一切的一切，破红尘，忘自我，离师判门，你愿意否？" + NOR);
    return "请选择：" + HIR + "agree\n" + NOR;
  } else {
    return ("你现在转世轮回有如沧海小舟，无济于事。\n");
  }
}

int do_choose(string arg) {
  string sp1, sp2;
  object who = this_player();

  if (!who->query("zuansheng/mark")) {
    return notify_fail("你从何处来？\n");
  }

  if (!who->query_temp("zuansheng/choose")) {
    command("say " + HIG + "沧海桑田，无望无我，你可愿意抛弃你的一切的一切，破红尘，忘自我，离师判门，你愿意否(agree)？" + NOR);
    return 1;
  }

  //  if( !arg || sscanf(arg, "%s and %s", sp1, sp2)!=2 )
  if (!arg || sscanf(arg, "%s", sp1) != 1) {
    // return notify_fail("指令格式：choose <arg1> and <arg2>,比如: choose agile and health\n");
    return notify_fail("指令格式：choose <arg1> 比如: choose agile \n");
  }

  if (member_array(sp1, gift_name) == -1) {
    return notify_fail(sp1 + "不是一项特技请重新选择！\n");
  }
  // else if(member_array(sp2,gift_name)==-1)
  //  return notify_fail(sp2+"2不是一项特技请重新选择！\n");
  else  // { tell_object(who,HIW"你选择了："+sp1+"和"+sp2+"两个特技。确定请finalize\n"NOR);
  {
    tell_object(who, HIW "你选择了：" + sp1 + "这个特技。确定请finalize，如果要修改属性请先subtract再add\n" NOR);
    who->set_temp("zuansheng/sp1", sp1);
    //  who->set_temp("zuansheng/sp2",sp2);
    who->set_temp("zuansheng/choose", 2);
    return 1;
  }
}

int do_state(string arg) {
  string msg;
  int ttt;
  mapping ss;
  string skill;
  object who = this_player();
  int i = sizeof(tianfu_name);

  if (!who->query("zuansheng/mark")) {
    return notify_fail("你从何处来？\n");
  }

  if (!who->query_temp("zuansheng/choose")) {
    command("say " + HIG + "沧海桑田，无望无我，你可愿意抛弃你的一切的一切，破红尘，忘自我，离师判门，你愿意否(agree)？" + NOR);
    return 1;
  }

  if (!mapp(ss = who->query("special_skill")) || !sizeof(ss)) {
    return notify_fail("你现在好像什么特技都不会哦，请联系巫师。\n");
  }

  msg = "你现在会以下这些特技：\n";
  foreach (skill in keys(ss)) {
    if (file_size(SPECIAL_D(skill) + ".lpc") < 0) {
      write("不存在技能：" + skill + "\n");
      continue;
    }
    msg += SPECIAL_D(skill)->name() + "(" YEL + skill + NOR ")\n";
  }

  msg += "\n\n你目前的天赋如下：\n\n";
  while (i--) {
    ttt = who->query(tianfu_name[i]) + points[tianfu_name[i]];
    msg += gift[tianfu_name[i]] + "：[" + ttt + "]";

    if (i == 4) {
      msg += "\n";
    } else {
      msg += "\t";
    }
  }
  msg += "\n";

  write(msg);
  return 1;
}

int do_finalize(string arg) {
  string sp1, sp2;
  int exp;
  int i = sizeof(tianfu_name), count;
  object who = this_player();

  if (!who->query("zuansheng/mark")) {
    return notify_fail("你从何处来？\n");
  }

  if (!who->query_temp("zuansheng/choose")) {
    command("say " + HIG + "沧海桑田，无望无我，你可愿意抛弃你的一切的一切，破红尘，忘自我，离师判门，你愿意否(agree)？" + NOR);
    return 1;
  } else if (who->query_temp("zuansheng/choose") == 1) {
    tell_object(who, method);
    tell_object(who, HIW "请增加一项自己的特技！\n" NOR);
    return 1;
  }

  sp1 = who->query_temp("zuansheng/sp1");
  sp2 = who->query_temp("zuansheng/sp2");
  exp = who->query("zuansheng/exp");
  who->delete("zuansheng");
  who->delete_temp("zuansheng");
  who->set("special_skill/" + sp1, 1);
  //  who->set("special_skill/"+sp2,1);
  who->add("gain_more_reward", 1000);
  who->add("attribute_point", exp * 2 / 5);
  who->add("potential", 50000);
  //        who->set("title", HIW"转世轮回"+ HIY"空有一切似云烟"NOR);

  while (i--) {
    if (!count = points[tianfu_name[i]]) {
      continue;
    }

    who->add("gift_adjust/" + tianfu_name[i], count);
    who->add(tianfu_name[i], count);

    if (count >= 0) {
      tell_object(who, YEL "你的" + gift[tianfu_name[i]] + "被增加了" +
        chinese_number(points[tianfu_name[i]]) +
        "点！\n" NOR);
    } else {
      tell_object(who, YEL "你的" + gift[tianfu_name[i]] + "被减少了" +
        chinese_number(-points[tianfu_name[i]]) +
        "点！\n" NOR);
    }

    continue;
  }

  command("say 你现在极限无量！恭喜你重新修行，提高你的自身能力，去吧...\n");
  command("chat 所有一切众生类摄。若卵生若胎生若湿生若化生。若有色若无色。若有想若无想。若非有想若非无想。乃至众生界及假名说。\n");
  command("chat 不应生住法心。不应生住非法心。不应生有所住心。何以故。若心有住则为非住故。\n");
  command("chat 轮回转世空空荡去，世间万物终有一度，" + who->query("name") + "破红尘之身，化世俗凡念，心归我佛，轮回转世了。\n");

  who->set("startroom", "/d/ourhome/xiaoting");
  who->save();
  who->move("/d/ourhome/xiaoting");
  who->save();

  /*
    log_file("users/lunhui",
    sprintf("%s-%s have %s type %d mete at %s.\n", 
    getuid(who), who->name(), mete_type,who->query("opinion/mete"),
    time())); 
    */

  call_out("reset", 1);
  return 1;
}

int do_agree(string arg) {
  object who = this_player();

  if (!who->query("zuansheng/mark")) {
    return notify_fail("你从何处来？\n");
  }

  message_vision("$N说道：“红尘漫漫，弟子欲轮回转世，欲望红尘，再入红尘深似海”。\n\n", who);
  message_vision("$N点点头说道：“既是如此，你有一个机会可以增加自己的特技。\n", this_object());

  tell_object(who, method);
  who->set_temp("zuansheng/choose", 1);

  return 1;
}

int do_subtract(string arg) {
  object me = this_player();

  if (!me->query("zuansheng/mark")) {
    return notify_fail("你从何处来？\n");
  }

  if (!me->query_temp("zuansheng/choose")) {
    command("say " + HIG + "沧海桑田，无望无我，你可愿意抛弃你的一切的一切，破红尘，忘自我，离师判门，你愿意否(agree)？" + NOR);
    return 1;
  }

  if (!arg) {
    return notify_fail("请选择你要降低的天赋。 (state)\n");
  }

  if (arg != "str"
    && arg != "cor"
    && arg != "int"
    && arg != "spi"
    && arg != "cps"
    && arg != "per"
    && arg != "con"
    && arg != "kar") {
    return notify_fail("这个 " + arg + " 不是一项天赋。\n");
  }

  if ((me->query(arg) + points[arg]) <= 10) {
    return notify_fail("你不能将一项天赋降低到十点以下。(state)\n");
  }

  credit++;
  total += 1;
  points[arg] -= 1;
  tell_object(me, "你决定降低一点" + gift[arg] + "！你现在还有" + chinese_number(total) + "点潜能可以分配。\n");

  return 1;
}

int do_add(string arg) {
  object me = this_player();

  if (!this_player()->query_temp("zuansheng/choose")) {
    return 0;
  }

  if (!arg) {
    return notify_fail("请选择你要增加的天赋。 (state )\n");
  }

  if (member_array(arg, tianfu_name) == -1) {
    return notify_fail("这个 " + arg + " 不是一项天赋。\n");
  }

  if (total <= 0) {
    return notify_fail("你目前无天赋点可用，请用 state 查你现在的选择。\n");
  }

  if ((me->query(arg) + points[arg]) >= 30) {
    return notify_fail("你不能将一项天赋增加到三十点以上。(state)\n");
  }

  total -= 1;
  points[arg] += 1;
  tell_object(me, "你决定增加一点" + gift[arg] + "！你现在还有" + chinese_number(total) + "点潜能可以分配。\n");

  return 1;
}

void reset() {
  total = 0;
  credit = 0;
  points = ([]);
}
