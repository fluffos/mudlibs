//获得伤害提示
string damage_msg(int ratio, string type) {
  mapping my_damagemsg;
  string str;
  int flag = 0;
  int step = 0;
  int index = 0;

  if (0 >= ratio) {
    return "结果只是造成轻微伤害。\n";
  }

  switch (type) {
    case "擦伤":
    case "抓伤":
    case "割伤":
      my_damagemsg = my_damagemsg1;
      break;

    case "砍伤":
    case "劈伤":
      my_damagemsg = my_damagemsg2;
      break;

    case "枪伤":
    case "刺伤":
      my_damagemsg = my_damagemsg3;
      break;

    case "筑伤":
      my_damagemsg = my_damagemsg4;
      break;

    case "掌伤":
    case "拳伤":
    case "瘀伤":
      my_damagemsg = my_damagemsg5;
      break;

    case "撞伤":
    case "砸伤":
      my_damagemsg = my_damagemsg6;
      break;

    case "震伤":
    case "内伤":
      my_damagemsg = my_damagemsg7;
      break;

    case "鞭伤":
    case "抽伤":
      my_damagemsg = my_damagemsg8;
      break;

    case "神伤":
      my_damagemsg = my_damagemsg9;
      break;

    default:
      if (!type) {
        type = "伤害";
      }
      my_damagemsg = my_damagemsg10;
      flag = 1;
  }

  //造成50%的伤害就是最严重的描述了
  step = 50 / sizeof(my_damagemsg);
  index = ratio / step;
  if (index >= sizeof(my_damagemsg)) {
    index = sizeof(my_damagemsg) - 1;
  }

  if (0 == flag) {
    return my_damagemsg[index];
  } else {
    return my_damagemsg[index] + type + "！\n";
  }
}

string eff_status_msg(int ratio) {
  if (ratio == 100) {
    return HIG "看起来气血充盈，并没有受伤。" NOR;
  }
  if (ratio > 95) {
    return HIG "似乎受了点轻伤，不过光从外表看不大出来。" NOR;
  }
  if (ratio > 90) {
    return HIY "看起来可能受了点轻伤。" NOR;
  }
  if (ratio > 80) {
    return HIY "受了几处伤，不过似乎并不碍事。" NOR;
  }
  if (ratio > 60) {
    return HIY "受伤不轻，看起来状况并不太好。" NOR;
  }
  if (ratio > 40) {
    return HIR "气息粗重，动作开始散乱，看来所受的伤着实不轻。" NOR;
  }
  if (ratio > 30) {
    return HIR "已经伤痕累累，正在勉力支撑着不倒下去。" NOR;
  }
  if (ratio > 20) {
    return HIR "受了相当重的伤，只怕会有生命危险。" NOR;
  }
  if (ratio > 10) {
    return RED "伤重之下已经难以支撑，眼看就要倒在地上。" NOR;
  }
  if (ratio > 5) {
    return RED "受伤过重，已经奄奄一息，命在旦夕了。" NOR;
  }

  return RED "受伤过重，已经有如风中残烛，随时都可能断气。" NOR;
}

string status_msg(int ratio) {
  if (ratio == 100) {
    return HIG "看起来充满活力，一点也不累。" NOR;
  }
  if (ratio > 95) {
    return HIG "似乎有些疲惫，但是仍然十分有活力。" NOR;
  }
  if (ratio > 90) {
    return HIY "看起来可能有些累了。" NOR;
  }
  if (ratio > 80) {
    return HIY "动作似乎开始有点不太灵光，但是仍然有条不紊。" NOR;
  }
  if (ratio > 60) {
    return HIY "气喘嘘嘘，看起来状况并不太好。" NOR;
  }
  if (ratio > 40) {
    return HIR "似乎非常疲惫，看来需要好好休息了。" NOR;
  }
  if (ratio > 30) {
    return HIR "已经一副头重脚轻的模样，正在勉力支撑着不倒下去。" NOR;
  }
  if (ratio > 20) {
    return HIR "看起来已经力不从心,马上要支持不住了。" NOR;
  }
  if (ratio > 10) {
    return RED "摇头晃脑、歪歪斜斜地站都站不稳，眼看就要倒在地上。" NOR;
  }

  return RED "已经陷入半昏迷状态，随时都可能摔倒晕去。" NOR;
}

//report_shen messages
string sen_status_msg(int ratio) {
  if (ratio == 100) {
    return HIG "看起来头脑清醒，一点也不迷糊。" NOR;
  }
  if (ratio > 90) {
    return HIG "拍了拍自己的脑袋，似乎有点不太得劲。" NOR;
  }
  if (ratio > 80) {
    return HIY "看起来有些迷糊了。" NOR;
  }
  if (ratio > 60) {
    return HIY "的确有点迷糊了，但还辨得出东西南北。" NOR;
  }
  if (ratio > 40) {
    return HIR "两眼发直，口角流涎，神智开始混乱。" NOR;
  }
  if (ratio > 20) {
    return HIR "迷迷糊糊，摇摇晃晃，已经辨不出东西南北了。" NOR;
  }
  if (ratio > 10) {
    return RED "神智已经处在极度混乱中,再也支持不住了。" NOR;
  }

  return RED "心智已经完全迷失，随时都有可能背过气去。" NOR;
}

int calc_random(int value) {
  return value * 4 / 5 + random(value / 5);
}

void report_keesen(object ob, object who) {
  if (!ob || !who) {
    return;
  }

  tell_object(who, sprintf
    (HIC "冥冥之中，你似乎感应到%s的武学有%d，道行有%s，\n\t气血有%d/%d(%d%%)，精神有%d/%d(%d%%)，\n\t内力有%d/%d(+%d)，法力有%d/%d(+%d)\n" NOR,
      ob->name(),
      calc_random(ob->query("combat_exp")),
      chinese_daoxing(calc_random(ob->query("daoxing"))),
      calc_random(ob->query("kee")),
      calc_random(ob->query("eff_kee")),
      calc_random(ob->query("eff_kee") * 100 / ob->query("max_kee")),
      calc_random(ob->query("sen")),
      calc_random(ob->query("eff_sen")),
      calc_random(ob->query("eff_sen") * 100 / ob->query("max_sen")),
      calc_random(ob->query("force")),
      calc_random(ob->query("max_force")),
      calc_random(ob->query("force_factor")),
      calc_random(ob->query("mana")),
      calc_random(ob->query("max_mana")),
      calc_random(ob->query("mana_factor"))
    )
  );
}

varargs void report_status(object ob, int effective, object who, string type) {
  if (!who || !type || !ob) {
    return;
  }

  if (effective) {
    message_vision(
      "( $N" + eff_status_msg((int)ob->query("eff_" + type) * 100 / (1 + (int)ob->query("max_" + type))) + " )\n",
      ob,
      who
    );
  } else {
    message_vision(
      "( $N" + status_msg((int)ob->query(type) * 100 / (1 + (int)ob->query("max_" + type))) + " )\n",
      ob,
      who
    );
  }

  if (who && userp(who) && who != ob && who->query("env/status_test") && !random(3)) {
    report_keesen(ob, who);
  }
}

//根据用户的转世、级别和exp，计算战斗因子
private int _reborn_power(object ob) {
  //每次转世增加60%的power，即影响命中
  int power = ob->query_reborn_times() * 60;

  power += FAMILY_D->query_combat_attack(ob, power);

  if (1 > power) {
    power = 1;
  }

  return power;
}

private int _level_power(object ob) {
  int power = 0;
  int level = ob->query("level");
  int step = XIUXIAN_D->query_xiuxian_step();

  if (0 == level) {
    return 1;
  }

  //每个大境界增加30%的power，小境界增加5%的power，即影响命中
  power = (level / step) * 30 + (level % step) * 5;

  power += FAMILY_D->query_combat_attack(ob, power);

  if (1 > power) {
    power = 1;
  }

  return power;
}

private int _exp_power(object ob) {
  //从本级起始exp开始，分为100档，每档增加1%的power，即影响命中
  int i, exp;
  int level = ob->query("level");
  int power = LEVEL_D->query_level_need_exp(level + 1) - LEVEL_D->query_level_resv_exp(level);

  power /= 100;

  if (0 >= power) {
    return 0;
  }

  exp = ob->query("combat_exp");
  if (exp <= LEVEL_D->query_level_need_exp(level + 1)) {
    exp = exp - LEVEL_D->query_level_resv_exp(level);
  } else {
    exp = LEVEL_D->query_level_need_exp(level + 1) - LEVEL_D->query_level_resv_exp(level);
  }

  i = exp / power;
  if (0 != exp % power) {
    i++;
  }

  i += FAMILY_D->query_combat_attack(ob, i);

  if (1 > i) {
    i = 1;
  }

  return i;
}

private int _dx_power(object ob) {
  //从本级起始exp开始，分为100档，每档增加1%的power，即影响命中
  int i, exp;
  int level = ob->query("level");
  int power = LEVEL_D->query_level_need_dx(level + 1) - LEVEL_D->query_level_resv_dx(level);

  power /= 100;

  if (0 >= power) {
    return 0;
  }

  exp = ob->query("daoxing");
  if (exp <= LEVEL_D->query_level_need_dx(level + 1)) {
    exp = exp - LEVEL_D->query_level_resv_dx(level);
  } else {
    exp = LEVEL_D->query_level_need_dx(level + 1) - LEVEL_D->query_level_resv_dx(level);
  }

  i = exp / power;
  if (0 != exp % power) {
    i++;
  }

  i += FAMILY_D->query_combat_attack(ob, i);

  if (1 > i) {
    i = 1;
  }

  return i;
}

mapping exp_power(object attacker, object target, int usage) {
  int exp;
  int level;
  int reborn;
  object watch;
  string msg;

  if (SKILL_USAGE_ATTACK == usage) {
    watch = attacker;
  } else {
    watch = target;
  }

  exp = _exp_power(watch);
  level = _level_power(watch);
  reborn = _reborn_power(watch);

  if (attacker && (string)attacker->query("env/combat") == "verbose") {
    msg = sprintf(GRN "[%s] reborn: %d level: %d exp: %d\n" NOR, watch->query("id"),
      reborn, level, exp);
    tell_object(attacker, msg);
  }

  if (target && (string)target->query("env/combat") == "verbose") {
    if (!msg) {
      msg = sprintf(GRN "[%s] reborn: %d level: %d exp: %d\n" NOR, watch->query("id"),
        reborn, level, exp);
    }
    tell_object(target, msg);
  }

  return ([
    "exp": exp,
    "level": level,
    "reborn": reborn,
  ]);
}

mapping dx_power(object attacker, object target, int usage) {
  int exp;
  int level;
  int reborn;
  object watch;
  string msg;

  if (SKILL_USAGE_ATTACK == usage) {
    watch = attacker;
  } else {
    watch = target;
  }

  exp = _dx_power(watch);
  level = _level_power(watch);
  reborn = _reborn_power(watch);

  if (attacker && (string)attacker->query("env/combat") == "verbose") {
    msg = sprintf(GRN "[%s] reborn: %d level: %d dx: %d\n" NOR, watch->query("id"),
      reborn, level, exp);
    tell_object(attacker, msg);
  }

  if (target && (string)target->query("env/combat") == "verbose") {
    if (!msg) {
      msg = sprintf(GRN "[%s] reborn: %d level: %d dx: %d\n" NOR, watch->query("id"),
        reborn, level, exp);
    }
    tell_object(target, msg);
  }

  return ([
    "dx": exp,
    "level": level,
    "reborn": reborn,
  ]);
}

int _skill_power(object ob, string skill, int usage) {
  int power = ob->query_skill(skill) / 1000;

  power = power * power / 1000 * power;

  if (SKILL_USAGE_ATTACK == usage) {
    //攻击和胆识加成
    power += ob->query_temp("apply/attack") + random(ob->query_temp("apply/courage"));
  } else {
    //防御和定力加成
    power += ob->query_temp("apply/defense") + random(ob->query_temp("apply/composure"));
  }

  if (power < 1) {
    power = 1;
  }

  return power;
}

mapping skill_power(object attacker, object target, string skill, int usage) {
  int power;
  int exp;
  int level;
  int reborn;
  object watch;
  string msg;

  if (SKILL_USAGE_ATTACK == usage) {
    watch = attacker;
  } else {
    watch = target;
  }

  power = _skill_power(watch, skill, usage);
  exp = _exp_power(watch);
  level = _level_power(watch);
  reborn = _reborn_power(watch);

  if (attacker && (string)attacker->query("env/combat") == "verbose") {
    msg = sprintf(GRN "[%s] reborn: %d level: %d exp: %d skill: %d\n" NOR, watch->query("id"),
      reborn, level, exp, power);
    tell_object(attacker, msg);
  }

  if (target && (string)target->query("env/combat") == "verbose") {
    if (!msg) {
      msg = sprintf(GRN "[%s] reborn: %d level: %d exp: %d skill: %d\n" NOR, watch->query("id"),
        reborn, level, exp, power);
    }
    tell_object(target, msg);
  }

  return ([
    "skill": power,
    "exp": exp,
    "level": level,
    "reborn": reborn,
  ]);
}

mapping spells_power(object attacker, object target, int usage) {
  int skill;
  int exp;
  int level;
  int reborn;
  object watch;
  string msg;

  if (SKILL_USAGE_ATTACK == usage) {
    watch = attacker;
  } else {
    watch = target;
  }

  skill = _skill_power(watch, "spells", usage);
  exp = _dx_power(watch);
  level = _level_power(watch);
  reborn = _reborn_power(watch);

  if (attacker && (string)attacker->query("env/combat") == "verbose") {
    msg = sprintf(GRN "[%s] reborn: %d level: %d dx: %d spells: %d\n" NOR, watch->query("id"),
      reborn, level, exp, skill);
    tell_object(attacker, msg);
  }

  if (target && (string)target->query("env/combat") == "verbose") {
    if (!msg) {
      msg = sprintf(GRN "[%s] reborn: %d level: %d dx: %d spells: %d\n" NOR, watch->query("id"),
        reborn, level, exp, skill);
    }
    tell_object(target, msg);
  }

  return ([
    "skill": skill,
    "dx": exp,
    "level": level,
    "reborn": reborn,
  ]);
}

varargs mapping cast_power(object attacker, object target, int usage) {
  return spells_power(attacker, target, usage);
}

varargs mapping combat_power(object attacker, object target, string skill, int usage) {
  mapping power;

  if ("spells" == skill) {
    power = cast_power(attacker, target, usage);
  } else {
    power = skill_power(attacker, target, skill, usage);
  }

  return power;
}

int if_hit(mapping ap, mapping pp) {
  int sub_defense;
  int i, count;
  mapping power = ([
    0: "reborn",
    1: "level",
    2: "exp",
    3: "dx",
    4: "skill",
  ]);

  count = sizeof(power);

  for (i = 0; i < count; i++) {
    if (undefinedp(ap[power[i]]) || undefinedp(pp[power[i]])) {
      continue;
    }

    sub_defense = pp[power[i]];
    if (2 <= sub_defense) {
      sub_defense = sub_defense / 2 + random(sub_defense / 2);  //攻方有利
    }

    if (random(ap[power[i]] + sub_defense) >= sub_defense) {
      return 1;
    }
  }

  return 0;
}

int perform_hit(mapping ap, mapping pp) {
  return if_hit(ap, pp);
}

int cast_hit(mapping ap, mapping pp) {
  return if_hit(ap, pp);
}

string power_str(mapping powermap) {
  int i, count;
  string result = "";
  mapping power = ([
    0: "reborn",
    1: "level",
    2: "exp",
    3: "dx",
    4: "skill",
  ]);

  count = sizeof(power);

  for (i = 0; i < count; i++) {
    if (undefinedp(powermap[power[i]])) {
      continue;
    }

    result += " {" + power[i] + ":" + powermap[power[i]] + "}";
  }

  return result;
}

private int power_valid(string type) {
  string *ignore_power = ({ "reborn", "level" });

  return (-1 == member_array(type, ignore_power));
}

mapping power_add(mapping power, int mod) {
  int i, count;
  string *dpkeys;

  dpkeys = keys(power);
  count = sizeof(dpkeys);
  for (i = 0; i < count; i++) {
    if (!power_valid(dpkeys[i])) {
      continue;
    }
    power[dpkeys[i]] += mod;
    if (power[dpkeys[i]] < 1) {
      power[dpkeys[i]] = 1;
    }
  }

  return power;
}

mapping power_mul(mapping power, int mod) {
  int i, count;
  string *dpkeys;

  dpkeys = keys(power);
  count = sizeof(dpkeys);
  for (i = 0; i < count; i++) {
    if (!power_valid(dpkeys[i])) {
      continue;
    }
    power[dpkeys[i]] *= mod;
    if (power[dpkeys[i]] < 1) {
      power[dpkeys[i]] = 1;
    }
  }

  return power;
}

mapping power_div(mapping power, int mod) {
  int i, count;
  string *dpkeys;

  dpkeys = keys(power);
  count = sizeof(dpkeys);
  for (i = 0; i < count; i++) {
    if (!power_valid(dpkeys[i])) {
      continue;
    }
    power[dpkeys[i]] /= mod;
    if (power[dpkeys[i]] < 1) {
      power[dpkeys[i]] = 1;
    }
  }

  return power;
}

mapping power_percentadd(mapping power, int mod) {
  int i, count;
  string *dpkeys;

  dpkeys = keys(power);
  count = sizeof(dpkeys);
  for (i = 0; i < count; i++) {
    if (!power_valid(dpkeys[i])) {
      continue;
    }
    power[dpkeys[i]] += power[dpkeys[i]] / 100 * mod;
    if (power[dpkeys[i]] < 1) {
      power[dpkeys[i]] = 1;
    }
  }

  return power;
}

mapping power_random(mapping power) {
  int i, count;
  string *dpkeys;

  dpkeys = keys(power);
  count = sizeof(dpkeys);
  for (i = 0; i < count; i++) {
    if (!power_valid(dpkeys[i])) {
      continue;
    }
    power[dpkeys[i]] = random(power[dpkeys[i]]);
    if (power[dpkeys[i]] < 1) {
      power[dpkeys[i]] = 1;
    }
  }

  return power;
}

string can_dodge(
  object me,
  object victim,
  mapping ap,
  mapping action,
  string limb,
  string attack_skill,
  mapping my,
  mapping your
) {
  int sub_defense;
  mapping dp;
  int mod_val;
  string dodge_skill;
  mapping victim_action;
  string dodgemsg, msg;

  sub_defense = me->query_temp("apply/sub_defense") + me->query_temp("apply/sub_max_defense") * victim->query_temp("apply/defense") / 10000;

  //技能特效，减对方的apply/defense..
  victim->add_temp("apply/defense", -sub_defense);
  dp = combat_power(me, victim, "dodge", SKILL_USAGE_DEFENSE);
  victim->add_temp("apply/defense", sub_defense);

  if (living(victim)) {
    dodge_skill = victim->query_skill_mapped("dodge");
  } else {
    dodge_skill = 0;
  }

  mod_val = 0;
  if (dodge_skill) {
    victim_action = SKILL_D(dodge_skill)->query_action();
    if (victim_action && victim_action["dodge_power"]) {
      mod_val = victim_action["dodge_power"];
    }
  }

  if (action["dodge"]) {
    mod_val += action["dodge"];
  }

  mod_val = mod_val / 2 + random(mod_val / 2);
  power_percentadd(dp, mod_val);

  if (victim->is_busy()) {
    power_div(dp, 3);
  }

  sub_defense = if_hit(ap, dp);

  if ((string)me->query("env/combat") == "verbose") {
    msg = sprintf(GRN "ATTACK：%s，DEFNSE：%s，AP：%s，DP：%s，Mod：%d，Dodged：%d\n" NOR,
      me->query("id"), victim->query("id"), power_str(ap), power_str(dp), mod_val, sub_defense);
    tell_object(me, msg);
  }
  if (victim != me && (string)victim->query("env/combat") == "verbose") {
    if (!msg) {
      msg = sprintf(GRN "ATTACK：%s，DEFNSE：%s，AP：%s，DP：%s，Mod：%d，Dodged：%d\n" NOR,
        me->query("id"), victim->query("id"), power_str(ap), power_str(dp), mod_val, sub_defense);
    }
    tell_object(victim, msg);
  }

  if (0 < sub_defense) {
    return 0;
  }

  if (action["bedodged_msg"]) {
    dodgemsg = action["bedodged_msg"];
  } else {
    if (!dodge_skill) {
      dodge_skill = "dodge";
      dodgemsg = SKILL_D(dodge_skill)->query_dodge_msg(limb);
    } else {
      if (victim_action && victim_action["dodge_action"]) {
        dodgemsg = victim_action["dodge_action"];
      } else {
        dodgemsg = SKILL_D(dodge_skill)->query_dodge_msg(limb);
      }
    }
  }

  if ((!userp(victim) || !userp(me))
    && random(your["sen"] * 100 / your["max_sen"] + your["int"] * your["cps"]) > 150) {
    your["combat_exp"] += 1;
    victim->improve_skill("dodge", 1);
  }

  // This is for NPC only. NPC have chance to get exp when fail to hit.
  if (!userp(me)) {
    if (random(my["int"]) > 15) {
      my["combat_exp"] += 1;
    }

    me->improve_skill(attack_skill, random(my["int"]));
  }

  if (dodgemsg) {
    return dodgemsg;
  }

  return "";
}

string can_parry(
  object me,
  object victim,
  mapping ap,
  mapping action,
  string limb,
  string attack_skill,
  mapping my,
  mapping your
) {
  int sub_defense;
  mapping pp;
  object weapon = me->query_temp("weapon");
  string parry_skill;
  mapping victim_action;
  int mod_val;
  string parrymsg, msg;

  sub_defense = me->query_temp("apply/sub_defense") + me->query_temp("apply/sub_max_defense") * victim->query_temp("apply/defense") / 10000;

  if (victim->query_temp("weapon")) {
    victim->add_temp("apply/defense", -sub_defense);
    pp = combat_power(me, victim, "parry", SKILL_USAGE_DEFENSE);
    victim->add_temp("apply/defense", sub_defense);

    if (!weapon) {
      power_mul(pp, 2);
    }

    parry_skill = victim->query_skill_mapped("parry");
  } else {
    if (weapon) {
      pp = ([]);
    } else {
      victim->add_temp("apply/defense", -sub_defense);
      pp = combat_power(me, victim, "unarmed", SKILL_USAGE_DEFENSE);
      victim->add_temp("apply/defense", sub_defense);
    }

    parry_skill = victim->query_skill_mapped("unarmed");
  }

  mod_val = 0;
  if (parry_skill) {
    victim_action = SKILL_D(parry_skill)->query_action(victim, victim->query_temp("weapon"));
    if (victim_action && victim_action["parry_power"]) {
      mod_val = victim_action["parry_power"];
    }
  }

  if (action["parry"]) {
    mod_val += action["parry"];
  }

  if (mod_val < 0) {
    mod_val = 0;
  }

  mod_val = mod_val / 2 + random(mod_val / 2);
  power_percentadd(pp, mod_val);

  if (victim->is_busy()) {
    power_div(pp, 3);
  }

  sub_defense = if_hit(ap, pp);

  if ((string)me->query("env/combat") == "verbose") {
    msg = sprintf(GRN "ATTACK：%s，DEFNSE：%s，AP：%s，PP：%s，Mod：%d，Parried：%d\n" NOR,
      me->query("id"), victim->query("id"), power_str(ap), power_str(pp), mod_val, sub_defense);
    tell_object(me, msg);
  }
  if (victim != me && (string)victim->query("env/combat") == "verbose") {
    if (!msg) {
      msg = sprintf(GRN "ATTACK：%s，DEFNSE：%s，AP：%s，PP：%s，Mod：%d，Parried：%d\n" NOR,
        me->query("id"), victim->query("id"), power_str(ap), power_str(pp), mod_val, sub_defense);
    }
    tell_object(victim, msg);
  }

  if (0 < sub_defense) {
    return 0;
  }

  if (action["beparryed_msg"]) {
    parrymsg = action["beparryed_msg"];
  } else {
    if (!parry_skill) {
      parry_skill = "parry";
    }
    // change to SKILL_D(parry_skill) after added parry msg to those
    // martial arts that can parry.
    parrymsg = SKILL_D(parry_skill)->query_parry_msg(weapon);
    if (!parrymsg) {
      parrymsg = SKILL_D("parry")->query_parry_msg(weapon);
    }
  }

  if ((!userp(victim) || !userp(me))
    && random(your["sen"] * 100 / your["max_sen"] + your["int"] * your["cps"]) > 150) {
    your["combat_exp"] += 1;
    victim->improve_skill("parry", 1);
  }

  if (parrymsg) {
    return parrymsg;
  }

  return "";
}

int get_mydamage(
  object me,
  mapping action,
  int damage_bonus,
  mapping my,
  mapping your,
  int attack_type
) {
  int damage = me->query_temp("apply/damage");
  int bless;
  int defense_factor;

  if (action) {
    switch (action["damage_kind"]) {
      case "sen":
        damage += (my["spi"] + my["per"]) * 25;
        break;
      case "gin":
        damage += (my["cps"] + my["int"]) * 25;
        break;
      case "kee":
      default:
        damage += (my["con"] + my["str"]) * 25;
        break;
    }
  } else {
    damage += (my["con"] + my["str"]) * 25;
  }

  damage += damage / REBORN_D->query_max_reborns(me) * 5 * me->query_reborn_times();
  damage += my["max_force"] / 3;
  damage += my["level"] * my["level"] * 5;

  //让npc厉害些..
  if (userp(me)) {
    damage = damage / 2 + random(damage / 3 * 2);
  } else {
    damage = damage / 4 * 3 + random(damage / 3);
  }

  if (100 > damage) {
    damage = 100;
  }

  //一般来说，招式都有个最大和最小的伤害，如果受到祝福，那么一直能造成最大伤害
  //如果被诅咒，则一直为最小伤害，否则取其中间数
  if (action && action["min_damage"] && action["max_damage"]) {
    if (me->query_temp("combat/bless"))  // from -10 to 10
    {
      bless = random(13 + me->query_temp("combat/bless"));
      if (me->query_temp("combat/bless") >= 10) {
        bless = 10 + random(13);
      }
      if (me->query_temp("combat/bless") <= -10) {
        bless = random(3);
      }

      if (me->query_temp("combat/bless") > 0) {
        if (bless > 18) {
          damage += (int)(damage / 100 * (me->query_temp("apply/add_skill_maxdamage") + me->query_temp("apply/add_skill_damage") + action["max_damage"]));
        } else if (bless > 15) {
          damage += (int)(damage / 110 * (1 + (me->query_temp("apply/add_skill_maxdamage") + me->query_temp("apply/add_skill_damage") + action["max_damage"])));
        } else if (bless > 10) {
          damage += (int)(damage / 120 * (1 + (me->query_temp("apply/add_skill_maxdamage") + me->query_temp("apply/add_skill_damage") + action["max_damage"])));
        } else {
          damage += damage / 100 * (me->query_temp("apply/add_skill_damage") + action["min_damage"] + random((me->query_temp("apply/add_skill_maxdamage") + action["max_damage"]) - action["min_damage"] + 1));
        }
      } else {
        if (bless < 2) {
          damage += (int)(damage / 120 * (me->query_temp("apply/add_skill_damage") + action["min_damage"]));
        } else if (bless < 5) {
          damage += (int)(damage / 110 * (me->query_temp("apply/add_skill_damage") + action["min_damage"]));
        } else if (bless < 7) {
          damage += (int)(damage / 100 * (me->query_temp("apply/add_skill_damage") + action["min_damage"]));
        } else {
          damage += damage / 100 * (me->query_temp("apply/add_skill_damage") + action["min_damage"] + random((me->query_temp("apply/add_skill_maxdamage") + action["max_damage"]) - action["min_damage"] + 1));
        }
      }
    }
  } else if (action && action["damage"]) {
    damage += damage / 100 * (me->query_temp("apply/add_skill_damage") + action["damage"]);
  } else {
    damage += damage / 100 * me->query_temp("apply/add_skill_damage");
  }

  if (damage_bonus > 0) {
    damage += (damage_bonus + random(damage_bonus)) / 2;
  }
  if (damage < 0) {
    damage = 0;
  }

  if (attack_type == TYPE_QUICK) {
    damage = damage * 4 / 5;
  }

  return damage;
}

mapping get_mydmgbonus(object me, object victim, mapping action, mapping my, string attack_skill) {
  string force_skill;
  mixed foo;
  string forcemsg = "";
  string martial_skill;
  int damage_bonus = me->query_str();
  object weapon = me->query_temp("weapon");

  // Let force skill take effect.
  if (my["force_factor"] && (my["force"] > my["force_factor"])) {
    damage_bonus += my["force_factor"];

    if (force_skill = me->query_skill_mapped("force")) {
      foo = SKILL_D(force_skill)->hit_ob(me, victim, damage_bonus, my["force_factor"]);
      if (stringp(foo)) {
        forcemsg = foo;
      } else if (intp(foo)) {
        damage_bonus += foo;
      }
    }
  }

  if (action["force"]) {
    damage_bonus += action["force"] * damage_bonus / 100;
  }

  if (martial_skill = me->query_skill_mapped(attack_skill)) {
    foo = SKILL_D(martial_skill)->hit_ob(me, victim, damage_bonus);
    if (stringp(foo)) {
      forcemsg += foo;
    } else if (intp(foo)) {
      damage_bonus += foo;
    }
  }

  // Let weapon or monster have their special damage.
  if (weapon) {
    foo = weapon->hit_ob(me, victim, damage_bonus);
    if (stringp(foo)) {
      forcemsg += foo;
    } else if (intp(foo)) {
      damage_bonus += foo;
    }
  } else {
    foo = me->hit_ob(me, victim, damage_bonus);
    if (stringp(foo)) {
      forcemsg += foo;
    } else if (intp(foo)) {
      damage_bonus += foo * 3 / 4;
    }
  }

  return ([ damage_bonus: forcemsg ]);
}

#define LIMIT_EFFECT_PERCENT 7500
#define MAX_EFFECT_PERCENT 10000

mapping make_damage(object me, object victim, string type, int damage) {
  int sub_armor;
  int ignore_armor;
  int parry_effect;
  int wounded = 0;
  object weapon = me->query_temp("weapon");

  damage = special_combat_effect(me, victim, weapon, damage);

  if (0 >= damage) {
    return ([ 0: 0 ]);
  }

  damage = victim->receive_damage(type, damage, me, "phy");

  if (0 >= damage) {
    return ([ 0: 0 ]);
  }

  ////忽视盔甲特技。
  sub_armor = (int)me->query_temp("apply/sub_armor") + (int)me->query_temp("apply/sub_max_armor") * victim->query_temp("apply/armor") / MAX_EFFECT_PERCENT;
  if (sub_armor > victim->query_temp("apply/armor")) {
    sub_armor = 1 + victim->query_temp("apply/armor") * 3 / 4;
  }

  ignore_armor = me->query_temp("apply/combat_ignore_armor");
  if (ignore_armor > LIMIT_EFFECT_PERCENT) {
    ignore_armor = LIMIT_EFFECT_PERCENT;
  }

  parry_effect = victim->query_temp("combat/dodge_vs_effect");
  if (parry_effect > LIMIT_EFFECT_PERCENT) {
    parry_effect = LIMIT_EFFECT_PERCENT;
  }

  if (ignore_armor) {
    if (random(MAX_EFFECT_PERCENT) < ignore_armor) {
      if (random(MAX_EFFECT_PERCENT) < parry_effect) {
        if ((int)victim->query_temp("apply/armor") >= sub_armor) {
          sub_armor = (int)victim->query_temp("apply/armor") - sub_armor;
        } else {
          sub_armor = 0;
        }
        if (damage > sub_armor) {
          victim->receive_wound(type, damage - sub_armor, me);
          wounded = 1;
        }
      } else {
        victim->receive_wound(type, damage, me);  //恐怖！
        if (weapon) {
          message_combatd(
            HIW "$N手中的" NOR + HIY + weapon->name() + HIW "，竟然完全击溃了$n的盔甲防御！\n" NOR,
            me,
            victim,
            "",
            "basic_effect"
          );
        } else {
          message_combatd(HIW "$N竟然空手击溃了$n的盔甲防御！！\n" NOR, me, victim, "", "basic_effect");
        }
        wounded = 1;
      }
    } else {
      if ((int)victim->query_temp("apply/armor") >= sub_armor) {
        sub_armor = (int)victim->query_temp("apply/armor") - sub_armor;
      } else {
        sub_armor = 0;
      }
      if (random(damage) > sub_armor) {
        victim->receive_wound(type, damage - sub_armor, me);
        wounded = 1;
      }
    }
  } else if (me->is_killing(victim) || weapon) {
    if ((int)victim->query_temp("apply/armor") >= sub_armor) {
      sub_armor = (int)victim->query_temp("apply/armor") - sub_armor;
    } else {
      sub_armor = 0;
    }
    if (random(damage) > sub_armor) {
      victim->receive_wound(type, damage - sub_armor, me);
      wounded = 1;
    }
  }

  return ([ damage: wounded ]);
}


string get_attackskill(object weapon) {
  string attack_skill;

  if (objectp(weapon)) {
    if (weapon->query("use_apply_skill")) {
      //化剑为锤等
      attack_skill = weapon->query("apply/skill_type");
    } else {
      attack_skill = weapon->query("skill_type");
    }
  } else {
    attack_skill = "unarmed";
  }

  return attack_skill;
}

mapping get_myaction(object me) {
  mapping action;

  action = me->query("actions");
  if (!mapp(action)) {
    me->reset_action();
    action = me->query("actions");

    if (!mapp(action)) {
      CHANNEL_D->do_channel(
        this_object(),
        "sys",
        sprintf("%s(%s): bad action = %O", me->name(1), me->query("id"), me->query("actions", 1))
      );
      return 0;
    }
  }

  return action;
}

varargs int get_mydamage_direct(object me, object target, string skill, int type) {
  mapping bonus;
  int damage_bonus, damage;

  bonus = get_mydmgbonus(me, target, get_myaction(me), me->query_entire_dbase(), skill);
  damage_bonus = keys(bonus)[0];
  damage = get_mydamage(
    me,
    get_myaction(me),
    damage_bonus,
    me->query_entire_dbase(),
    target->query_entire_dbase(),
    type
  );

  return damage;
}

// do_attack()
//
// Perform an attack action. This function is called by fight() or as an
// interface for some special utilize in quests.
//      
varargs int do_attack(object me, object victim, object weapon, int attack_type) {
  mapping my, your, action, victim_action;
  string limb, *limbs, result, fail_hit_msg, hit_ob_msg;
  string attack_skill, martial_skill;
  mapping ap;
  int damage = RESULT_DAMAGE, damage_bonus;
  int my_defense, wounded = 0;
  string defensemsg;

  me->add_temp("flooding/hits", 1);  //流控，防止出招过多

  if (!environment(me)->valid_fight()) {
    message_vision("$N和$n各自退了一步，收住了招。\n", me, victim);
    me->remove_enemy(victim);
    victim->remove_enemy(me);
    return 0;
  }

  if (environment(me) != environment(victim)) {
    me->remove_enemy(victim);
    victim->remove_enemy(me);
    return 0;
  }

  if (0 < (damage = FAMILY_D->special_attack(me, victim))) {
    return damage;
  }

  my = me->query_entire_dbase();
  your = victim->query_entire_dbase();

  //获得自己的动作描述
  action = get_myaction(me);
  if (!action) {
    return 0;
  }

  if (action["name"]) {
    me->set_temp("action_name", action["name"]);
  }
  result = "\n" + action["action"] + "！\n";

  if (!action["damage_kind"]) {
    action["damage_kind"] = "kee";
  }

  //获得自己的攻击武功
  attack_skill = get_attackskill(weapon);
  if (attack_skill) {
    martial_skill = me->query_skill_mapped(attack_skill);
  }

  //获得对方的被攻击部位
  limbs = victim->query("limbs");
  if (!limbs || !arrayp(limbs) || 0 >= sizeof(limbs)) {
    limb = "丹田";
  } else {
    limb = limbs[random(sizeof(limbs))];
  }

  //获取攻击力因子
  ap = combat_power(me, victim, attack_skill, SKILL_USAGE_ATTACK);

  if (random(2)) {
    //是否被dodge躲闪
    if (defensemsg = can_dodge(me, victim, ap, action, limb, attack_skill, my, your)) {
      result += defensemsg;
      damage = RESULT_DODGE;
    }
  } else {
    //是否被parry招架
    if (defensemsg = can_parry(me, victim, ap, action, limb, attack_skill, my, your)) {
      result += defensemsg;
      damage = RESULT_PARRY;
    }
  }

  //成功命中
  if (RESULT_DODGE != damage && RESULT_PARRY != damage) {
    victim_action = get_mydmgbonus(me, victim, action, my, attack_skill);

    damage_bonus = keys(victim_action)[0];
    result += values(victim_action)[0];

    damage = get_mydamage(me, action, damage_bonus, my, your, attack_type);

    victim_action = make_damage(me, victim, action["damage_kind"], damage);

    damage = keys(victim_action)[0];
    wounded = values(victim_action)[0];

    if (0 < damage) {
      if (martial_skill) {
        result += SKILL_D(martial_skill)->attack_action(me, action["action"]);
      }

      if (action["hit_ob_msg"]) {
        result += action["hit_ob_msg"];
      } else {
        //本次攻击造成的伤害描述
        result += damage_msg(
          damage * 100 / victim->query("max_" + action["damage_kind"]),
          action["damage_type"]
        );
      }
    }
  }

  result = replace_string(result, "$l", limb);
  if (objectp(weapon)) {
    result = replace_string(result, "$w", weapon->name());
  } else if (stringp(action["weapon"])) {
    result = replace_string(result, "$w", action["weapon"]);
  } else if (stringp(me->query_temp("temp_weapon"))) {
    result = replace_string(result, "$w", me->query_temp("temp_weapon"));
  } else {
    result = replace_string(result, "$w", "真气");
  }

  if (objectp(victim->query_temp("weapon"))) {
    result = replace_string(result, "$W", victim->query_temp("weapon")->name());
  }

  if (0 < damage) {
    message_combatd(result, me, victim, "");
  } else {
    if (((string)me->query("env/brief_message") != "YES"
      && (string)victim->query("env/brief_message") != "YES")) {
      message_combatd(result, me, victim, "");
    }

    if (martial_skill) {
      fail_hit_msg = SKILL_D(martial_skill)->fail_hit(me, victim);
      if (stringp(fail_hit_msg)) {
        message_combatd(fail_hit_msg, me, victim, "");
      }
    }
  }

  if (0 < damage) {
    report_status(victim, wounded, me, action["damage_kind"]);

    if (martial_skill) {
      hit_ob_msg = SKILL_D(martial_skill)->hit_ob_msg(me, victim);
      if (stringp(hit_ob_msg)) {
        message_combatd(hit_ob_msg, me, victim, "");
      }
    }

    if (victim->is_busy()) {
      victim->interrupt_me(me);
    }

    if ((!me->is_killing(your["id"])) && (!victim->is_killing(my["id"]))) {
      // fight until one side's kee is < 50%
      if (victim->query("kee") < victim->query("max_kee") * 50 / 100 || victim->query("sen") < victim->query("max_sen") * 50 / 100) {
        me->remove_enemy(victim);
        victim->remove_enemy(me);
        message_combatd(winner_msg[random(sizeof(winner_msg))], me, victim, "");
      }
    }
  }

  if (functionp(action["post_action"])) {
    evaluate(action["post_action"], me, victim, weapon, damage);
  }

  if (damage > 0 && attack_type != TYPE_QUICK &&
    me->query_temp("perf_quick") && me->is_fighting(victim)) {
    //连击特效
    if (me->query_temp("perf_quick/msg")) {
      message_combatd(CYN + me->query_temp("perf_quick/msg") + NOR, me, victim, "");
    } else {
      message_combatd(CYN + "$N得势不饶人，对$n展开连续攻击。" + NOR, me, victim, "");
    }
    me->delete_temp("perf_quick");

    return do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
  } else {
    me->delete_temp("perf_quick");
  }

  if (attack_type == TYPE_REGULAR
    && damage < 1
    && victim->query_temp("guarding")) {
    victim->set_temp("guarding", 0);

    //根据定力判断反击
    if (random(my["cps"]) < my["cps"] / 8) {
      my_defense = me->query_temp("apply/defense");
      message_combatd("$N一击不中，露出了破绽！\n", me, victim, "");
      me->add_temp("apply/defense", -13 - my_defense / 5);
      do_attack(victim, me, victim->query_temp("weapon"), TYPE_QUICK);
      me->add_temp("apply/defense", 13 + my_defense / 5);
    } else {
      my_defense = victim->query_temp("apply/attack");
      message_combatd("$N见$n攻击失误，趁机发动攻击！\n", victim, me, "");
      victim->add_temp("apply/attack", 8 + my_defense / 5);
      do_attack(victim, me, victim->query_temp("weapon"), TYPE_RIPOSTE);
      victim->add_temp("apply/attack", -8 - my_defense / 5);
    }
  }

  return damage;
}

varargs int perform_attack(object me, object victim, object weapon) {
  return do_attack(me, victim, weapon, TYPE_PERFORM);
}

//	fight()
//
//	This is called in the attack() defined in F_ATTACK, which handles fighting
//	in the heart_beat() of all livings. Be sure to optimize it carefully.
//
void fight(object me, object victim) {
  object ob;

  if (!living(me)) {
    return;
  }

  if (me->query_temp("netdead")) {
    //自己断线后不能再攻击
    return;
  }

  if (victim->query_temp("netdead")) {
    if (member_array(me, victim->query_netdead_enemy()) == -1) {
      //不能对断线者发起攻击，但已经处于战斗状态的可以继续
      return;
    }
  }

  if (!me->visible(victim)
    && (int)me->query_skill(
      "spells",
      1
    ) / 2 + random((int)me->query_skill(
      "spells",
      1
    ) / 2) < (int)victim->query_skill(
      "spells",
      1
    ) / 3 + random((int)victim->query_skill("spells", 1) * 2 / 3)) {
    //看不到对方，平招不能攻击
    return;
  }

  //modified by bugbug,2001.1
  //修改yinshen

  // If victim is busy or unconcious, always take the chance to make an attack.
  // added: if victim is in "no_move", similar to "is_busy".
  if (victim->is_busy() || victim->query_temp("no_move") || !living(victim)) {
    me->set_temp("guarding", 0);

    if (!victim->is_fighting(me)) {
      victim->fight_ob(me);
    }

    if (0 < do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK)) {
      victim->delete_temp("kill_msg");
      victim->delete_temp("kill_file");
    }
  } else if ((random((int)victim->query_cps()) < ((int)me->query_cor() + (int)me->query("bellicosity") / 50))) {
    // Else, see if we are brave enough to make an aggressive action.
    me->set_temp("guarding", 0);

    if (!victim->is_fighting(me)) {
      victim->fight_ob(me);
    }

    if (0 < do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR)) {
      victim->delete_temp("kill_msg");
      victim->delete_temp("kill_file");
    }
  } else if (!me->query_temp("guarding")) {
    // Else, we just start guarding.
    me->set_temp("guarding", 1);
    message_combatd(guard_msg[random(sizeof(guard_msg))], me, victim, "");
    return;
  } else {
    return;
  }
}

//	auto_fight()
//
//	This function is to start an automatically fight. Currently this is
//	used in "aggressive", "vendetta", "hatred", "berserk" fight.
//
void auto_fight(object me, object obj, string type) {
  // Don't let NPC autofight NPC.
  if (!userp(me) && !userp(obj)) {
    return;
  }

  if (wizardp(me) || wizardp(obj)) {
    return;
  }

  // Because most of the cases that we cannot start a fight cannot be checked
  // before we really call the kill_ob(), so we just make sure we have no 
  // aggressive callout wating here.
  if (me->query_temp("looking_for_trouble")) {
    return;
  }

  me->set_temp("looking_for_trouble", 1);

  // This call_out gives victim a chance to slip trough the fierce guys.
  call_out("start_" + type, 0, me, obj);
}

//杀气太高，叫杀
void start_berserk(object me, object obj) {
  int bellicosity;

  return;

  if (!me) {
    return;  // Are we still exist( not becoming a corpse )?
  }

  me->set_temp("looking_for_trouble", 0);

  if (!obj) {
    return;
  }

  if (wizardp(me) || wizardp(obj)) {
    return;
  }

  if (me->is_fighting(obj)    // Are we busy fighting?
  || !living(me)       // Are we capable for a fight?
  || environment(me) != environment(obj)  // Are we still in the same room?
  || !environment(me)->valid_fight()  // Are we in a peace room?
  ) {
    return;
  }

  bellicosity = (int)me->query("bellicosity");
  message_vision("$N用一种异样的眼神扫视着在场的每一个人。\n", me);

  if ((int)me->query("force") > (random(bellicosity) + bellicosity) / 2) {
    return;
  }

  if (random(bellicosity) > (int)me->query("score")
    && !wizardp(obj) && obj->query_realadult()) {
    // auto kill, mark my_killer_list. -- mon 9/23/98
    if (userp(me) && userp(obj)) {
      set_my_killer_list(me, obj);
    }

    message_vision("$N对着$n喝道：" + RANK_D->query_self_rude(me) + "看你实在很不顺眼，去死吧。\n", me, obj);
    me->kill_ob(obj);
  } else {
    message_vision(
      "$N对着$n喝道：喂！" + RANK_D->query_rude(obj) + "，" + RANK_D->query_self_rude(me) + "正想找人打架，陪我玩两手吧！\n",
      me,
      obj
    );
    me->fight_ob(obj);
  }
}

//复仇
void start_hatred(object me, object obj) {
  if (!me) {
    return;  // Are we still exist( not becoming a corpse )?
  }

  me->set_temp("looking_for_trouble", 0);

  if (!obj) {
    return;
  }

  if (wizardp(me) || wizardp(obj)) {
    return;
  }

  if (me->is_fighting(obj)    // Are we busy fighting?
  || !living(me)       // Are we capable for a fight?
  || environment(me) != environment(obj)  // Are we still in the same room?
  || !environment(me)->valid_fight()  // Are we in a peace room?
  ) {
    return;
  }

  // We found our hatred! Charge!
  message_vision(catch_hunt_msg[random(sizeof(catch_hunt_msg))], me, obj);
  me->kill_ob(obj);
}

