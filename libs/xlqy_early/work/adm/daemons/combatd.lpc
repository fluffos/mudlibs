//自己具有攻击性
void start_aggressive(object me, object obj) {
  if (!me) {
    return;  // Are we still exist( not becoming a corpse )?
  }

  me->set_temp("looking_for_trouble", 0);

  if (!obj) {
    return;
  }

  if (wizardp(me) || wizardp(obj)) {
