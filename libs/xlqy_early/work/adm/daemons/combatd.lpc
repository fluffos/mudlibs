// This function is to announce the special events of the combat.
// This should be moved to another daemon in the future.
void announce(object ob, string event, string msg) {
  switch (event) {
    case "dead":
      message_vision("\n$N死了。\n\n", ob);
      break;
    case "unconcious":
      message_vision("\n$N脚下一个不稳，跌在地上一动也不动了。\n\n", ob);
      break;
    case "revive":
      message_vision("\n$N慢慢睁开眼睛，清醒了过来。\n\n", ob);
      break;
    case "death_rumor":
      CHANNEL_D->do_channel(this_object(), "rumor", msg);
      break;
  }
}

void killer_rkmsg(object killer, object victim) {
  string rkmsg;
  string str;
  object weapon;
  string killfile = victim->query_temp("kill_file");
  string killmsg;

  if (killfile && (killmsg = killfile->query_desc(killer, victim))) {
    CHANNEL_D->do_channel(this_object(), "rumor", killmsg);
    return;
  }

  killmsg = victim->query_temp("kill_msg");

  if (killmsg) {
    switch (killmsg) {
      case "slash":
        rkmsg = "斩";
        break;
      case "slice":
        rkmsg = "砍";
        break;
      case "chop":
        rkmsg = "劈";
        break;
      case "hack":
        rkmsg = "劈";
        break;
      case "thruse":
        rkmsg = "刺";
        break;
      case "pierce":
        rkmsg = "刺";
        break;
      case "wave":
        rkmsg = "鞭";
        break;
      case "whip":
        rkmsg = "抽";
        break;
      case "impale":
        rkmsg = "戳";
        break;
      case "rake":
        rkmsg = "筑";
        break;
      case "bash":
        rkmsg = "砸";
        break;
      case "crush":
        rkmsg = "砸";
        break;
      case "slam":
        rkmsg = "挫";
        break;
      case "throw":
        rkmsg = "射";
        break;
      case "shoot":
        rkmsg = "射";
        break;
      case "play":
        rkmsg = "迷";
        break;
      case "special_msg":  //特殊的攻击
        rkmsg = killer->query_temp("special_msg");
        killer->delete_temp("special_msg");
        break;
      default:
        rkmsg = killmsg;
        break;
    }
  }

  weapon = killer->query_temp("kill_weapon");

  if (weapon && rkmsg) {
    str = victim->name(1) + "在" + MISC_D->find_place(environment(killer)) + "被" + killer->name(1) + "用" HIY + weapon->name() + HIM + rkmsg + "死了。";
  } else if (rkmsg && !weapon) {
    str = victim->name(1) + "在" + MISC_D->find_place(environment(killer)) + "被" + killer->name(1) + "用一招" + HIW "“" + rkmsg + "”" + HIM "送去了阎罗地府。";
  }
  /*else if ( weapon && !rkmsg )
    {
        str = victim->name(1) + "在" + MISC_D->find_place(environment(killer))
            + "被" + killer->name(1) + "用"HIY + weapon->name() + HIM"送去了阎罗地府。";
    }
    else
    {
        str = victim->name(1) + "在" + MISC_D->find_place(environment(killer))
            + "被" + killer->name(1) + "杀死了。";
    }*/
  if (str) {
    CHANNEL_D->do_channel(this_object(), "rumor", str);
  }

  return;
}

void killer_reward(object killer, object victim) {
  int bls = 0;
  string vmark;

  //获取谣言信息
  killer_rkmsg(killer, victim);

  if (userp(victim)) {
    if (userp(killer)) {
      killer->add("PKS", 1);
      bls = 10;  //增加杀气
    } else {
      victim_penalty(victim);
    }
  } else {
    if (userp(killer)) {
      killer->add("MKS", 1);
      bls = 1;  //增加杀气
    }
  }

  killer->add("bellicosity", bls);

  if (stringp(vmark = victim->query("vendetta_mark"))) {
    //家族、门派仇杀
    killer->add("vendetta/" + vmark, 1);
  }

  victim->give_reward(victim, killer);

  if (userp(killer)) {
    killer->save();
  }

  if (userp(victim)) {
    victim->save();
  }
}

void victim_penalty(object victim) {
  int combat_exp_loss = (int)victim->query("combat_exp") / 60;
  int dx_loss = (int)victim->query("daoxing") / 60;

  victim->clear_condition();

  victim->set("bellicosity", 0);

  victim->set("death/mud_age", victim->query("mud_age"));
  victim->set("death/combat_exp_loss", combat_exp_loss);
  victim->set("death/dx_loss", dx_loss);
  log_file(
    "death",
    victim->query("id") + " lost " + combat_exp_loss + " exp points and " + dx_loss + " dx points.\n"
  );

  victim->add("combat_exp", -combat_exp_loss);
  victim->add("daoxing", -dx_loss);
  victim->delete("vendetta");

  if (random((int)victim->query("kar")) < (int)victim->query("kar") / 5) {
    victim->set("death/skill_loss", 1);
    victim->skill_death_penalty();
  } else {
    victim->set("death/skill_loss", 0);
  }

  victim->save();
}

string chinese_daoxing(int gain) {
  int year, day, hour;
  string str;

  year = gain / 1000;
  day = (gain - year * 1000) / 4;
  hour = (gain - year * 1000 - day * 4) * 3;
  str = "";
  if (year) {
    str = str + chinese_number(year) + "年";
  }
  if (day) {
    str = str + chinese_number(day) + "天";
  }
  if (hour) {
    str = str + chinese_number(hour) + "时辰";
  }

  return str;
}

int check_family(string fam) {
  if (fam && !undefinedp(family[fam])) {
    return family[fam];
  } else {
    return 0;
  }
}

//the following functions are for performs...weiqi
//copy and modified from spelld.c

int attacking_perform_success(object attacker, object target, string skill, int success_adj) {
  mixed ap, dp;

  ap = COMBAT_D->skill_power(attacker, target, skill, SKILL_USAGE_ATTACK);
  dp = COMBAT_D->skill_power(attacker, target, "parry", SKILL_USAGE_DEFENSE);

  return (0 < COMBAT_D->perform_hit(ap, dp));
}

int attacking_perform_damage(object attacker, object target, int damage_adj) {
  int a_neili, d_neili, damage;

  if (damage_adj < 50) {
    damage_adj = 50;
  } else if (damage_adj > 200) {
    damage_adj = 200;
  }

  //will use current neili...but do not allow it exceeds 2 time of the max.
  a_neili = attacker->query("force");
  if (a_neili > 2 * attacker->query("max_force")) {
    a_neili = 2 * attacker->query("max_force");
  }

  d_neili = target->query("force");
  if (d_neili > 2 * target->query("max_force")) {
    d_neili = 2 * target->query("max_force");
  }

  //neili and qi. weaker than cast here...
  damage = (a_neili - d_neili) / 30 + random(attacker->query("eff_kee") / 30) - random(target->query("eff_kee") / 30);

  //mana_factor, here the attacker has some advantage.
  //the damage_adj higher, the better for attacker.
  damage += (3 * damage_adj / 200)  //weaker than cast here...
  * (attacker->query("force_factor") - random(target->query("force_factor")));

  //for backfire, we need let it be serious...
  if (damage < 0) {
    damage = damage - target->query("force_factor");
  }
  //here increase the damage, since previously it's included in random()

  damage = damage * damage_adj / 100;  //last damage scaled again.

  //finally, we need let the force level useful...
  //the setting is, at enabled level 200, the damage will double.
  if (damage > 0) {
    damage += (damage * (int)attacker->query_skill("force")) / 200;
  } else if (damage < 0) {
    damage += (damage * (int)target->query_skill("force")) / 200;
  }

  return damage;
}

void attacking_perform(
  object attacker,
  object target,
  string skill,  //the level of skill used to attack.
  int success_adj,
  int damage_adj,  //default value is 100 for this 2 parameters.
  string damage_type,  //must be "shen"/"sen", "qi"/"kee" or "both"(default)
  string msg_init,
  string msg_success,
  string msg_fail,
  string msg_backfire_init,
  string msg_backfire_success) {
  int damage;
  mapping victim_action;

  //first, show the initial message...
  message_perform(msg_init, attacker, target);

  //calculate if the casting can happen...
  if (attacking_perform_success(attacker, target, skill, success_adj) == 0) {
    message_perform(msg_fail, attacker, target);

    //let the target kill attacker.
    target->kill_ob(attacker);
    return;
  }

  victim_action = get_mydmgbonus(
    attacker,
    target,
    get_myaction(attacker),
    attacker->query_entire_dbase(),
    skill
  );
  damage = keys(victim_action)[0];

  damage = get_mydamage(
    attacker,
    get_myaction(attacker),
    damage,
    attacker->query_entire_dbase(),
    target->query_entire_dbase(),
    TYPE_PERFORM
  );

  if (damage > 0)  //attacker hit target
  {
    message_perform(msg_success, attacker, target);
    SPELL_D->apply_damage(attacker, target, to_int(damage), damage_type, msg_success);
  } else if (damage < 0)  //backfire
  {
    message_perform(msg_backfire_init, attacker, target);
    SPELL_D->apply_damage(
      target,
      attacker,
      -to_int(damage / 2 + random(damage) / 3),
      damage_type,
      msg_backfire_success
    );
  } else {
    message_perform(HIB "结果正好被$n以内力逼住，谁也没有吃亏。\n" NOR, attacker, target);
  }

  target->kill_ob(attacker);

  return;
}

int do_attack_damage(object me, object victim, object weapon)  //调动此函数，相当于直接打中敌人，敌人一样会受到伤害
{
  mapping my, your, action;
  string result;
  string attack_skill /* 有bug */, force_skill, martial_skill;
  mixed foo;
  int damage, damage_bonus, defense_factor;

  my = me->query_entire_dbase();
  your = victim->query_entire_dbase();

  action = get_myaction(me);
  if (!action) {
    return 0;
  }

  damage = me->query_temp("apply/damage");
  damage = (damage + random(damage)) / 2;

  if (action["damage"]) {
    damage += action["damage"] * damage / 100;
  }

  //取得me用什么兵器的数据   
  attack_skill = get_attackskill(weapon);

  damage_bonus = me->query_str();

  // Let force skill take effect.
  if (my["force_factor"] && (my["force"] > my["force_factor"])) {
    if (force_skill = me->query_skill_mapped("force")) {
      foo = SKILL_D(force_skill)->hit_ob(me, victim, damage_bonus, my["force_factor"]);
      if (stringp(foo)) {
        result += foo;
      } else if (intp(foo)) {
        damage_bonus += foo;
      }
    }
  }

  if (action["force"]) {
    damage_bonus += action["force"] * damage_bonus / 100;
  }

  if (martial_skill = me->query_skill_mapped(attack_skill)) {
    foo = SKILL_D(martial_skill)->hit_ob(me, victim, damage_bonus);
    if (stringp(foo)) {
      result += foo;
    } else if (intp(foo)) {
      damage_bonus += foo;
    }
  }

  // Let weapon or monster have their special damage.
  if (weapon) {
    foo = weapon->hit_ob(me, victim, damage_bonus);
    if (stringp(foo)) {
      result += foo;
    } else if (intp(foo)) {
      damage_bonus += foo;
    }
  } else {
    foo = me->hit_ob(me, victim, damage_bonus);
    if (stringp(foo)) {
      result += foo;
    } else if (intp(foo)) {
      damage_bonus += foo * 3 / 4;
    }
  }

  if (damage_bonus > 0) {
    damage += (damage_bonus + random(damage_bonus)) / 2;
  }
  if (damage < 0) {
    damage = 0;
  }

  // Let combat exp take effect
  defense_factor = your["combat_exp"];
  while (random(defense_factor) > my["combat_exp"]) {
    damage -= damage / 3;
  }

  damage = victim->receive_damage("kee", damage, me, "phy");

  if ((me->is_killing(victim) || weapon)
    && random(damage) > (int)victim->query_temp("apply/armor")) {
    // We are sure that damage is greater than victim's armor here.
    victim->receive_wound("kee", damage - (int)victim->query_temp("apply/armor"), me);
  }

  return damage;
}


void free_from_whip(object target) {
  if (target) {
    target->delete_temp("no_move");
  }

  return;
}

void remove_curse(object target) {
  if (target) {
    target->add_temp("combat/bless", 44);
  }

  return;
}

void remove_unlucky(object target) {
  if (target) {
    target->add_temp("combat/lucky", 44);
  }

  return;
}

int special_effect_percent(object me, string special) {
  int suck_kee = me->query_temp(special);

  if (suck_kee && suck_kee > LIMIT_EFFECT_PERCENT) {
    suck_kee = LIMIT_EFFECT_PERCENT;
  } else {
    suck_kee = 0;
  }

  return suck_kee;
}

int special_combat_effect(object me, object victim, object weapon, int damage) {
  int suck_kee;
  string weaponname = (weapon && weapon->name()) ? weapon->name() : "掌心";

  weaponname = HIY + weaponname + NOR;

  reset_eval_cost();

  //吸内力
  suck_kee = special_effect_percent(me, "apply/sub_opp_force");
  if (0 < suck_kee && (random(MAX_EFFECT_PERCENT) < suck_kee || wizardp(me))
    && (random(MAX_EFFECT_PERCENT) >= suck_kee && !wizardp(victim))) {
    message_combatd(
      HIB "$N手中的" NOR + weaponname + HIB "击中$n，$n只觉丹田处一阵剧痛，" + HIY + damage + HIB + "点内力狂泻而出。\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
    if (victim->query("force") > damage) {
      victim->add("force", -damage);
    } else {
      victim->set("force", 0);
    }

    if (!random(13)) {
      victim->add("maximum_force", -13);
      victim->add("max_force", -13);
    }
  }

  //no_move
  suck_kee = special_effect_percent(me, "apply/whip_opp");
  if (0 < suck_kee && !victim->query_temp("no_move")
    && (random(MAX_EFFECT_PERCENT) < suck_kee || wizardp(me))
    && (random(MAX_EFFECT_PERCENT) >= victim->query_temp("combat/dodge_vs_effect") && !wizardp(victim))) {
    suck_kee = 5 + random(5);
    message_combatd(
      HIY "$N手中的" NOR + weaponname + HIY "如灵蛇般活跃，将$n缠绕的造成" + suck_kee + "点手忙脚乱！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
    victim->set_temp("no_move", 1);
    call_out("free_from_whip", suck_kee, victim);
  }

  //busy
  suck_kee = special_effect_percent(me, "apply/stun_opp");
  if (0 < suck_kee && !victim->is_busy()
    && (random(MAX_EFFECT_PERCENT) < suck_kee || wizardp(me))
    && (random(MAX_EFFECT_PERCENT) >= victim->query_temp("combat/dodge_vs_effect") && !wizardp(victim))) {
    suck_kee = 2 + random(2);
    message_combatd(
      HIR "$N一招击中$n，力贯" NOR + weaponname + HIR "，$n只觉得一阵眩晕，眼冒" + HIY + suck_kee + HIR + "朵金星！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
    victim->start_busy(suck_kee);
  }

  ///回伤
  suck_kee = special_effect_percent(victim, "apply/feedback_damage");
  if (0 < suck_kee && random(2) && living(victim)) {
    suck_kee = damage / MAX_EFFECT_PERCENT * suck_kee;
    me->receive_damage("kee", suck_kee, victim);
    me->receive_wound("kee", random(suck_kee), victim);
    message_combatd(
      BLINK + HIR "$N击中了$n，却不料被$n所回伤" + HIY + suck_kee + BLINK + HIR + "!!!\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
  }

  //双倍伤害
  suck_kee = special_effect_percent(me, "apply/combat_double_damage");
  if (0 < suck_kee && (random(MAX_EFFECT_PERCENT) < suck_kee)
    && (random(MAX_EFFECT_PERCENT) >= victim->query_temp("combat/dodge_vs_effect") && !wizardp(victim))) {
    damage += damage;
    message_combatd(
      HIM "$N凝神聚力，竟然施展出会心一击，造成双倍" + HIY + damage + HIM + "点伤害！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
  }

  //免伤
  suck_kee = special_effect_percent(victim, "combat/parry_block_attack");
  suck_kee += special_effect_percent(victim, "apply/parry_block_attack");
  if (suck_kee > LIMIT_EFFECT_PERCENT) {
    suck_kee = LIMIT_EFFECT_PERCENT;
  }
  if (random(MAX_EFFECT_PERCENT) < suck_kee && random(me->query("attack")) < random(victim->query("defense"))) {
    message_combatd(
      BLINK + HIW "\n突然间，$n" + HIW "仿佛与天地融为一体，" + HIW "$N的攻击完全失效！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
    damage = 0;
  }

  if (0 >= damage) {
    return 0;
  }

  //内力盾
  suck_kee = special_effect_percent(victim, "combat/force_vs_damage");
  suck_kee += special_effect_percent(victim, "apply/force_vs_damage");
  if (suck_kee > LIMIT_EFFECT_PERCENT) {
    suck_kee = LIMIT_EFFECT_PERCENT;
  }
  if (0 < suck_kee && random(2) && living(victim)) {
    message_combatd(HIG "$n运丹田之气散向四肢百骸，全身肌肤如铁，抵抗$N这一击！" NOR, me, victim, "", "basic_effect");

    if (victim->query("force") > suck_kee * damage / MAX_EFFECT_PERCENT) {
      suck_kee = damage / MAX_EFFECT_PERCENT * suck_kee;
      victim->add("force", -suck_kee / 2 - random(suck_kee / 2));
    } else {
      suck_kee = victim->query("force");
      victim->set("force", 0);
    }
    damage -= suck_kee;
    message_combatd(
      HIG "$n运用内力抵抗" + HIY + suck_kee + HIG + "点伤害！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
  }

  if (0 >= damage) {
    return 0;
  }

  //法力盾
  suck_kee = special_effect_percent(victim, "combat/spells_vs_damage");
  suck_kee += special_effect_percent(victim, "apply/spells_vs_damage");
  if (suck_kee > LIMIT_EFFECT_PERCENT) {
    suck_kee = LIMIT_EFFECT_PERCENT;
  }
  if (0 < suck_kee && random(2) && living(victim)) {
    message_combatd(HIB "$n法力激荡，浑身竟发出幽幽蓝光，抵抗$N这一击！\n" NOR, me, victim, "", "basic_effect");

    if (victim->query("mana") > suck_kee * damage / MAX_EFFECT_PERCENT) {
      suck_kee = damage / MAX_EFFECT_PERCENT * suck_kee;
      victim->add("mana", -suck_kee / 2 - random(suck_kee / 2));
    } else {
      suck_kee = victim->query("mana");
      victim->set("mana", 0);
    }
    damage -= suck_kee;
    message_combatd(
      HIB "$n运用法力抵抗" + HIY + suck_kee + HIB + "点伤害！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
  }

  if (0 >= damage) {
    return 0;
  }

  //吸血
  suck_kee = special_effect_percent(me, "apply/combat_blood_kee");
  if (0 < suck_kee && !random(3)) {
    suck_kee = damage / MAX_EFFECT_PERCENT * suck_kee;

    if (me->query("kee") >= me->query("max_kee")) {
      if (me->query("kee") > (int)me->query("max_kee") * 1.3) {
        suck_kee = 0;
      }
      me->add("kee", suck_kee);
    } else {
      me->receive_curing("kee", suck_kee / 2 + random(suck_kee / 2));
      suck_kee /= 2;
      me->add("kee", suck_kee);
    }

    message_combatd(
      HIR "$N觉得$n的" + HIY + suck_kee + HIR + "点气血源源不断的从" NOR + weaponname + HIR "传来！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
  }

  //吸内力
  suck_kee = special_effect_percent(me, "apply/combat_blood_force");
  if (0 < suck_kee && !random(3)) {
    suck_kee = damage / MAX_EFFECT_PERCENT * suck_kee;
    suck_kee = suck_kee / 2 + random(suck_kee / 2);

    if (me->query("force") > (int)me->query("max_force") * 21 / 10) {
      suck_kee = 0;
    }
    me->add("force", suck_kee);

    message_combatd(
      HIG "$N觉得$n的" + HIY + suck_kee + HIG + "点内力源源不断的从" NOR + weaponname + HIG "传来！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
  }

  //吸法力
  suck_kee = special_effect_percent(me, "apply/combat_blood_mana");
  if (0 < suck_kee && !random(3)) {
    suck_kee = damage / MAX_EFFECT_PERCENT * suck_kee;
    suck_kee = suck_kee / 2 + random(suck_kee / 2);

    if (me->query("mana") > (int)me->query("max_mana") * 21 / 10) {
      suck_kee = 0;
    }
    me->add("mana", suck_kee);

    message_combatd(
      HIB "$N觉得$n的" + HIY + suck_kee + HIB + "点法力源源不断的从" NOR + weaponname + HIB "传来！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );
  }

  //诅咒，减对方祝福
  suck_kee = special_effect_percent(me, "apply/sub_bless");
  if (random(MAX_EFFECT_PERCENT) < suck_kee && victim->query_temp("combat/bless") > -10) {
    message_combatd(
      RED "$N的" NOR + weaponname + RED "对$n发出诅咒一击！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );

    victim->add_temp("combat/bless", -1);
  }

  //厄运，减对方幸运
  suck_kee = special_effect_percent(me, "apply/sub_lucky");
  if (random(MAX_EFFECT_PERCENT) < suck_kee && victim->query_temp("combat/lucky") > -10) {
    message_combatd(
      YEL "$N的" NOR + weaponname + YEL "对$n发出厄运一击！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );

    victim->add_temp("combat/lucky", -1);
  }

  //万千诅咒，强力减对方祝福
  suck_kee = special_effect_percent(me, "apply/combat_cruse");
  if (random(MAX_EFFECT_PERCENT) < suck_kee && victim->query_temp("combat/bless") > -10) {
    message_combatd(
      RED "$n被$N的" NOR + weaponname + RED "所伤，受到万千怨魂的无尽诅咒！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );

    victim->add_temp("combat/bless", -44);
    call_out(
      "remove_curse",
      me->query_spi() + me->query_kar() - victim->query_spi() - victim->query_kar(),
      victim
    );
  }

  //无尽厄运，强力减对方幸运
  suck_kee = special_effect_percent(me, "apply/combat_unlucky");
  if (random(MAX_EFFECT_PERCENT) < suck_kee && victim->query_temp("combat/lucky") > -10) {
    message_combatd(
      YEL "$n被$N的" NOR + weaponname + YEL "所伤，受到无尽厄运所扰！\n" NOR,
      me,
      victim,
      "",
      "basic_effect"
    );

    victim->add_temp("combat/lucky", -44);
    call_out(
      "remove_unlucky",
      me->query_spi() + me->query_kar() - victim->query_spi() - victim->query_kar(),
      victim
    );
  }

  return damage;
}

varargs int start_fengmo(object who, int duration, int force) {
  if (!force && who->query_temp("fengmo")) {
    return 0;
  }

  if (0 >= duration) {
    return 0;
  }

  who->set_temp("fengmo", 1);
  who->apply_hb_condition("fengmo", duration);

  return duration;
}

