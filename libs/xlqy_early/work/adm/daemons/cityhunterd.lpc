void tell_story(int step);
void tell_story2(int step);
void tell_story3(int step);

void ready_to_start() {
  tell_story(0);
  call_out("start_story", 60);  //间隔时间
}

void create() {
  seteuid(ROOT_UID);
  set("channel_id", "攻城精灵");
  set("id", "city hunter");
  CHANNEL_D->do_channel(this_object(), "sys", "攻城系统已经启动。");

  ready_to_start();
}

int clean_up() {
  return 1;
}

object query_running_hunter() {
  return running_story;
}

void start_story(string name) {
  string where, which;
  object room, guai;
  mapping places;
  int many;
  int gsy = 0;

  CHANNEL_D->do_channel(this_object(), "sys", "攻城系统开始选择地点。");

  if (random(100) > 10) {
    where = place[random(sizeof(place))];
  } else {
    tell_story3(0);
    //call_out("start_story", 3600 + random(1800));
    return;
  }

  CHANNEL_D->do_channel(this_object(), "sys", "攻城地点是在" + where + "。");

  switch (where) {
    case "baoxiang":
      placename = "宝象国";
      places = baoxiang;
      many = 3 + random(3);
      break;
    case "chechi":
      placename = "车迟国";
      places = chechi;
      many = 5 + random(5);
      break;
    case "nuerguo":
      placename = "女儿国";
      places = nuerguo;
      many = 3 + random(3);
      break;
    case "jisaiguo":
      placename = "祭赛国";
      places = jisaiguo;
      many = 2 + random(3);
      break;
    case "zhuzi":
      placename = "朱紫国";
      places = zhuzi;
      many = 4 + random(4);
      break;
    case "biqiu":
      placename = "比丘国";
      places = biqiu;
      many = 4 + random(4);
      break;
    case "fengxian":
      placename = "凤仙郡";
      places = fengxian;
      many = 2 + random(3);
      break;
    case "yuhua":
      placename = "玉华县";
      places = yuhua;
      many = 2 + random(3);
      break;
    case "tianzhu":
      placename = "天竺国";
      places = tianzhu;
      many = 6 + random(6);
      break;
    case "jinping":
    default:
      placename = "金平府";
      places = jinping;
      many = 2 + random(3);
      break;
  }

  if (!gsy) {
    message(
      "channel:chat",
      "\n" + HIY "【雁门边关】" + HIM "探子(tan zi)：" + HIG "报~~~~~！妖怪们似乎往" + HIR + placename + NOR + HIG "方向去了！\n" NOR,
      users()
    );
  }

  if (!gsy) {
    tell_story2(0);
  }

  if (!gsy) {
    message(
      "channel:chat",
      "\n" + HIR "【" + placename + "】" + HIY "妖怪来袭，其势汹汹，望天朝大唐派人来援，感恩涕淋！！\n" NOR,
      users()
    );
  }

  printf("the place is %O\n", places);
  /*     for(int i=0;i<sizeof(places);i++)
         {    which="room"+i;
             if( !(room = find_object(where[which])) )
                    room = load_object(where[which]);
            
            for(int j=0;j<many;j++)
                {    guai=new("/d/obj/npc/city-guai.lpc");
                guai->move(room);
                guai->init();    
            }
    }
        */
  //           call_out("start_story",7200+random(3600));

}


void announce(object me, int flag) {
  if (!flag) {
    message(
      "channel:chat",
      HIB "【魑魅魍魉】" + HIR + me->name() + HIC "(yao guai)：" + HIY "哇~~~~~~~~呜~~~~~~~~呜，郁闷啊，又没吃到人肉！\n" NOR,
      users()
    );
  } else {
    message(
      "channel:chat",
      HIB "【魑魅魍魉】" + HIR + me->name() + HIC "(yao guai)：" + HIY "哇~~~~哈~~~~~哈~~~~~~~~哈哈，人肉真是香啊！\n" NOR,
      users()
    );
  }
}

void tell_story(int step) {
  message("channel:chat", story[step], users());
  if (step < sizeof(story) - 1) {
    step++;
    call_out("tell_story", 3, step);
  }
}

void tell_story2(int step) {
  message("channel:chat", story2[step], users());
  if (step < sizeof(story2) - 1) {
    step++;
    call_out("tell_story2", 3, step);
  }
}

void tell_story3(int step) {
  message("channel:chat", story3[step], users());
  if (step < sizeof(story3) - 1) {
    step++;
    call_out("tell_story3", 3, step);
  }
}
