string *test(int kind, string type, int level) {
  if (undefinedp(EQUIP_CONFIG[kind])) {
    return 0;
  }
  if (undefinedp(EQUIP_CONFIG[kind][type])) {
    return 0;
  }

  return EQUIP_CONFIG[kind][type][level];
}

