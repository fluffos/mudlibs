string query_desc(object obj) {
  string msg;
  mapping result;
  int i, count;
  string *props;
  int type;

  msg = "级别: " + obj->query("level") + "\n";
  msg += "孔数: " + obj->query(PROP_ROOT + "/" + PROP_HOLE) + "\n";

  if ("weapon" == obj->query("equip_type")) {
    type = KIND_WEAPON;
  } else if ("armor" == obj->query("equip_type")) {
    type = KIND_ARMOR;
  } else {
    type = KIND_JEWELRY;
  }

  result = obj->query(PROP_ROOT + "/" + PROP_NODE);
  if (result) {
    count = sizeof(result);
    props = keys(result);

    msg += "=========\n";
    for (i = 0; i < count; i++) {
      msg += EQUIP_PROP[props[i]][type]["desc"] + ": " + obj->query(PROP_ROOT + "/" + PROP_NODE + "/" + props[i]);
    }
  }

  result = obj->query(PROP_ROOT + "/" + PROP_VALID);
  if (result) {
    count = sizeof(result);
    props = keys(result);

    msg += "\n装备要求:\n";
    for (i = 0; i < count; i++) {
      if ("daoxing" == props[i]) {
        msg += "道行: " + COMBAT_D->chinese_daoxing(obj->query(PROP_ROOT + "/" + PROP_VALID + "/" + props[i]));
      } else {
        msg += "武学: " + obj->query(PROP_ROOT + "/" + PROP_VALID + "/" + props[i]);
      }

      msg += "\n";
    }
  }

  return msg;
}

int check_valid(object obj, object who) {
  int i, count;
  mapping require;
  string *need;

  if (!obj->query(PROP_ROOT)) {
    return 0;
  }

  if (!obj->query(PROP_ROOT + "/" + PROP_VALID)) {
    return 1;
  }

  require = obj->query(PROP_ROOT + "/" + PROP_VALID);
  count = sizeof(require);
  need = keys(require);

  for (i = 0; i < count; i++) {
    if (who->query(need[i]) < require[need[i]]) {
      return 0;
    }
  }

  return 1;
}

