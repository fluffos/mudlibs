object generate_medicine(int grade, int level) {
  object obj;
  int amount;

  if (grade <= GRADE_MAX / 3) {
    if (0 == random(2)) {
      obj = new("/d/obj/drug/jinchuang");
    } else {
      obj = new("/d/obj/drug/hunyuandan");
    }
    amount = grade + random(2 * level);
    obj->set_amount(amount);
  } else if (grade <= GRADE_MAX / 3 + 1) {
    switch (random(3)) {
      case 0:
        obj = new("/d/city/obj/xjdan");
        break;

      case 1:
        obj = new("/d/obj/drug1/xbw");
        break;

      default:
        obj = new("/d/obj/drug/guo");
        break;
