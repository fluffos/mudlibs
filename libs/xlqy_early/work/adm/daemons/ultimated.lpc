object create_ultimate_other(int grade, int level) {
  string type;
  int i = random(100);

  if (50 > i) {
    type = TYPE_MONEY;
  } else if (i <= 85) {
    type = TYPE_MEDICINE;
  } else {
    type = TYPE_SPIRITSTONE;
  }

  return evaluate(all_items[type], grade, level); ;
}

object create_ultimate_ob(int kind, string *wuxing, int grade, int level) {
  object obj;

  switch (kind) {
    case KIND_WEAPON:
      obj = create_ultimate_weapon(wuxing, grade, level);
      if (obj) {
        set_hole(obj, 8 + random(11));
      }
      break;

    case KIND_ARMOR:
      obj = create_ultimate_armor(wuxing, grade, level);
      if (obj) {
        set_hole(obj, 8 + random(11));
      }
      break;

    case KIND_JEWELRY:
      obj = create_ultimate_jewelry(wuxing, grade, level);
      if (obj) {
        set_hole(obj, 8 + random(11));
      }
      break;

    case KIND_OTHER:
    default:
      obj = create_ultimate_other(grade, level);
      break;
  }

  return obj;
}

void drop(object npc, object user, int npc_level) {
  int dropkind = random(KIND_MAX);
  int obj_level = GRADE_UNIQUES;
  object obj;
  string *wuxing = ({ TYPE_PHY });

  obj = create_ultimate_ob(dropkind, wuxing, obj_level, npc_level);
  if (!obj) {
    return;
  }

  obj->set("grade", obj_level);
  obj->set("level", npc_level);
  obj->set("identification", 1);

  obj->move(user);

  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    HIR + user->query("name") + HIM "得到一" + obj->query("unit") + HIM "传说中的" + NOR + obj->query("name") + NOR "！\n"
  );
  CHANNEL_D->do_channel(
    this_object(),
    "sys",
    user->query("name") + "得到一" + obj->query("unit") + obj->name() + HIC "「品级:" + obj_level + "，等级:" + npc_level + "」\n"
  );
}

void ultim_drop(object npc, object user) {
  int npc_level;

  npc_level = npc->query("level");

  drop(npc, user, npc_level);
}

mapping query_config() {
  return EQUIP_CONFIG["spells"];
}

object generate_money(int grade, int level) {
  object obj;
  int amount;

  if (grade <= GRADE_MAX / 3) {
    obj = new("/obj/money/silver");

    amount = random(9 * level + 9 * grade) + level * level * 2 + grade * level + grade * grade;
    if (150 < amount) {
      amount = 140 + random(30);
    }
    if (0 >= amount) {
      amount = 40 + random(30);
    }

    obj->set_amount(amount);
  } else if (grade <= GRADE_MAX * 2 / 3) {
    obj = new("/obj/money/gold");

    amount = random(9 * level + 9 * grade) + level * level * 2 + grade * level + grade * grade;
    amount = 1 + amount / 20 + random(amount / 20);
    if (30 < amount) {
      amount = 25 + random(10);
    }
    if (0 >= amount) {
      amount = 10 + random(10);
    }

    obj->set_amount(amount);
  } else if (grade <= GRADE_MAX * 8 / 9) {
    obj = new("/obj/money/thousand-cash");
    amount = 2 + random(level);
    obj->set_amount(amount);
  } else {
    obj = new("/obj/money/tenthousand-cash");
    amount = 1 + random(level / 3);
    obj->set_amount(amount);

  }

  return obj;
}

