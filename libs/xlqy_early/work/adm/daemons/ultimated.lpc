object create_ultimate_weapon(int grade, int level) {
  object obj;
  string type = all_weapons[random(sizeof(all_weapons))];

  obj = new("/obj/ultimate/weapons/" + type + ".lpc");

  if (!obj) {
    return 0;
  }

  set_valid_weapon(obj, grade, level);

  set_weapons_prop(obj, type, grade, level);

  return obj;
}

int is_jewelry(string type) {
  return (-1 != member_array(type, all_jewelry));
}

void set_armors_prop(object obj, string type, int kind, int level) {
  int effect;
  string content;

  if (kind > 1) {
    if (!random(1 + kind + kind / 2)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = get_effect_value(content, kind, 1 + level / 2);
      set_defect(obj, content, effect);
    }

    if (!random(13)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = get_effect_value(content, kind, 1 + level / 2);
      set_defect(obj, content, effect);
    }

    if (!random(26)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = get_effect_value(content, kind, 1 + level / 2);
      set_defect(obj, content, effect);
    }

    if (!random(39)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = get_effect_value(content, kind, 1 + level / 2);
      set_defect(obj, content, effect);
    }
  }

  switch (type) {
    case TYPE_ARMOR:
      set_content(obj, "armor", (12 + level + random(level + 1)) * kind);
      set_content(
        obj,
        "rigidity",
        180 + random(level + kind + level * level + kind * kind + level * kind)
      );
      break;

    case TYPE_BOOTS:
      set_content(obj, "armor", (1 + level + random(level)) * kind);
      set_content(
        obj,
        "rigidity",
        93 + random(level + kind + level * level + kind * kind + level * kind)
      );
      break;

    case TYPE_CLOTH:
      set_content(obj, "armor", (3 + level + random(level)) * kind);
      set_content(
        obj,
        "rigidity",
        150 + random(level + kind + level * level + kind * kind + level * kind)
      );
      break;

    case TYPE_HANDS:
      set_content(obj, "armor", (1 + level + random(level)) * kind);
      set_content(
        obj,
        "rigidity",
        100 + random(level + kind + level * level + kind * kind + level * kind)
      );
      break;

    case TYPE_NECK:
      set_content(obj, "armor", (1 + random(level)) * kind);
      set_content(
