void set_valid_armor_x(object obj, int grade, int level) {
  string valid;
  int power;

  if (random(4)) {
    valid = valid_equip_armor[random(sizeof(valid_equip_armor))];
  } else {
    valid = valid_equip_all[random(sizeof(valid_equip_all))];
  }

  power = get_vaild_value(valid, grade, level);
  set_valid(obj, valid, power);
}

void set_valid_armor(object obj, int grade, int level) {
  int power;

  set_valid_armor_x(obj, grade, level);

  if (!random(5)) {
    set_valid_armor_x(obj, grade, level);
  }

  if (!random(10)) {
    set_valid_armor_x(obj, grade, level);
  }

  if (!random(15)) {
    set_valid_armor_x(obj, grade, level);
  }

  if (random(2)) {
    power = get_vaild_value("daoxing", grade, level);
    set_valid(obj, "daoxing", power);
  } else if (random(2)) {
    power = get_vaild_value("combat_exp", grade, level);
    set_valid(obj, "combat_exp", power);
  } else {
    power = get_vaild_value("level", grade, level);
    set_valid(obj, "level", power);
  }
}

object create_ultimate_armor(int grade, int level) {
  object obj;
  string type = all_armors[random(sizeof(all_armors))];

  obj = new("/obj/ultimate/armors/" + type + ".lpc");

  if (!obj) {
    return 0;
  }

  set_valid_armor(obj, grade, level);

  set_armors_prop(obj, type, grade, level);

  return obj;
}

void set_valid_jewelry_x(object obj, int grade, int level) {
  string valid;
  int power;

  if (random(4)) {
    valid = valid_equip_jewelry[random(sizeof(valid_equip_jewelry))];
  } else {
    valid = valid_equip_all[random(sizeof(valid_equip_all))];
  }

  power = get_vaild_value(valid, grade, level);
  set_valid(obj, valid, power);
}

void set_valid_jewelry(object obj, int grade, int level) {
  int power;

  set_valid_jewelry_x(obj, grade, level);

  if (!random(5)) {
    set_valid_jewelry_x(obj, grade, level);
  }

  if (!random(10)) {
    set_valid_jewelry_x(obj, grade, level);
  }

  if (random(2)) {
    power = get_vaild_value("daoxing", grade, level);
    set_valid(obj, "daoxing", power);
  } else if (random(4)) {
    power = get_vaild_value("combat_exp", grade, level);
    set_valid(obj, "combat_exp", power);
  } else {
    power = get_vaild_value("level", grade, level);
    set_valid(obj, "level", power);
  }
}

object create_ultimate_jewelry(int grade, int level) {
  object obj;
  string type = all_jewelry[random(sizeof(all_jewelry))];

  obj = new("/obj/ultimate/jewelry/" + type + ".lpc");

  if (!obj) {
    return 0;
  }

  set_valid_jewelry(obj, grade, level);

  set_armors_prop(obj, type, grade, level);

  return obj;
}

object generate_money(int grade, int level) {
  object obj;
  int amount;

  if (grade <= GRADE_MAX / 3) {
    obj = new("/obj/money/silver");

    amount = random(9 * level + 9 * grade) + level * level * 2 + grade * level + grade * grade;
    if (150 < amount) {
      amount = 140 + random(30);
    }
    if (0 >= amount) {
      amount = 40 + random(30);
    }

    obj->set_amount(amount);
  } else if (grade <= GRADE_MAX * 2 / 3) {
    obj = new("/obj/money/gold");

    amount = random(9 * level + 9 * grade) + level * level * 2 + grade * level + grade * grade;
    amount = 1 + amount / 20 + random(amount / 20);
    if (30 < amount) {
      amount = 25 + random(10);
    }
    if (0 >= amount) {
      amount = 10 + random(10);
    }

    obj->set_amount(amount);
  } else if (grade <= GRADE_MAX * 8 / 9) {
    obj = new("/obj/money/thousand-cash");
    amount = 2 + random(level);
    obj->set_amount(amount);
  } else {
    obj = new("/obj/money/tenthousand-cash");
    amount = 1 + random(level / 3);
    obj->set_amount(amount);

  }

  return obj;
}

object generate_medicine(int grade, int level) {
  object obj;
  int amount;

  if (grade <= GRADE_MAX / 3) {
    if (0 == random(2)) {
      obj = new("/d/obj/drug/jinchuang");
    } else {
      obj = new("/d/obj/drug/hunyuandan");
    }
    amount = grade + random(2 * level);
    obj->set_amount(amount);
  } else if (grade <= GRADE_MAX / 3 + 1) {
    switch (random(3)) {
      case 0:
        obj = new("/d/city/obj/xjdan");
        break;

      case 1:
        obj = new("/d/obj/drug1/xbw");
        break;

      default:
        obj = new("/d/obj/drug/guo");
        break;
    }
  } else if (grade <= GRADE_MAX / 3 + 2) {
    switch (random(4)) {
      case 0:
        obj = new("/d/obj/drug/mihoutao");
        break;

      case 1:
        obj = new("/d/obj/drug/biou");
        break;

      case 2:
        obj = new("/d/obj/drug/jiaoli");
        break;

      default:
        obj = new("/d/obj/drug/huozao");
        break;
    }
  } else if (grade <= GRADE_MAX * 2 / 3) {
    switch (random(3)) {
      case 0:
        obj = new("/d/obj/drug/hongdou");
        break;

      case 1:
        obj = new("/d/obj/drug1/datao");
        break;

      default:
        obj = new("/d/obj/xisuidan");
        break;
    }
  } else if (grade <= GRADE_MAX * 2 / 3 + 1) {
    switch (random(3)) {
      case 0:
        obj = new("/d/obj/drug1/jzhhd");
        break;

      case 1:
        obj = new("/d/obj/clone/gift/bingtang");
        break;

      default:
        obj = new("/d/obj/clone/gift/lingzhi");
        break;
    }
  } else if (grade <= GRADE_MAX * 2 / 3 + 2) {
    switch (random(2)) {
      case 0:
        obj = new("/d/obj/drug/renshen-guo");
        break;

      default:
        obj = new("/d/obj/drug/skill-guo");
        break;
    }
  } else {
    switch (random(3)) {
      case 0:
        obj = new("/d/obj/shenliwan");
        break;

      case 1:
        obj = new("/d/obj/xiandan");
        break;

      default:
        obj = new("/d/obj/unknowdan");
        break;
    }
  }

  return obj;
}

object create_ultimate_other(int grade, int level) {
  string type;
  int i = random(100);

  if (50 <= i) {
    type = TYPE_MONEY;
  } else if (i <= 85) {
    type = TYPE_MEDICINE;
  } else {
    type = TYPE_SPIRITSTONE;
  }

  return evaluate(all_items[type], grade, level); ;
}

object create_ultimate_ob(int kind, int grade, int level) {
  object obj;

  switch (kind) {
    case KIND_CHARM:
      obj = create_ultimate_charm(grade, level);
      break;

    case KIND_WEAPON:
      obj = create_ultimate_weapon(grade, level);
      if (obj) {
        set_hole(obj, (kind + 2) / 2);
      }
      break;

    case KIND_ARMOR:
      obj = create_ultimate_armor(grade, level);
      if (obj) {
        set_hole(obj, (kind + 2) / 2);
      }
      break;

    case KIND_JEWELRY:
      obj = create_ultimate_jewelry(grade, level);
      if (obj) {
        set_hole(obj, (kind + 2) / 2);
      }
      break;

    case KIND_OTHER:
    default:
      obj = create_ultimate_other(grade, level);
      break;
  }

  return obj;
}

void drop(object npc, object user, int obj_level, int npc_level) {
  int dropkind = random(KIND_MAX);
  object obj;

  obj = create_ultimate_ob(dropkind, obj_level, npc_level);
  if (!obj) {
    return;
  }

  obj->set("grade", obj_level);
  obj->set("level", npc_level);
  obj->set("no_put", 1);

  obj->move(user);

  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    HIR + user->query("name") + HIM "得到一" + obj->query("unit") + HIM "传说中的" + NOR + obj->query("name") + NOR "！\n"
  );
  CHANNEL_D->do_channel(
    this_object(),
    "sys",
    user->query("name") + "得到一" + obj->query("unit") + obj->name() + HIC "「品级:" + obj_level + "，等级:" + npc_level + "」\n"
  );
}

void ultim_drop(object npc, object user) {
  int npc_level, obj_level;

  obj_level = random(GRADE_MAX);
  npc_level = random(13);

  drop(npc, user, obj_level, npc_level);
}

#else

#define MAX_USER_LEVEL 600

#define KIND_OTHER          0
#define KIND_WEAPON         1
#define KIND_ARMOR          2
#define KIND_JEWELRY        3
#define KIND_CHARM          5
#define KIND_MAX            4

#define GRADE_CRUDE         1
#define GRADE_CRACKED       2
#define GRADE_LOW_QUALITY   3
#define GRADE_NORMAL        4
#define GRADE_GOOD          5
#define GRADE_SUPERIOR      6
#define GRADE_RARE          7
#define GRADE_UNIQUES       8
#define GRADE_SET           9
#define GRADE_MAX           GRADE_SET

#define VTYPE_ABS   "abs"   //绝对值
#define VTYPE_PER   "per"   //万分比

#define USAGE_INC   "inc"   //加成属性
#define USAGE_DEC   "dec"   //不好的属性
#define USAGE_REQ   "req"   //装备要求

#define TYPE_ATTR   "attr"      //影响人物属性
#define TYPE_STATUS "status"    //影响人物状态
#define TYPE_PHY    "phy"       //物理装备
#define TYPE_SPELLS "spells"    //法术装备
#define TYPE_RESIST "resist"    //五行抗
#define TYPE_JIN    "jin"       //金
#define TYPE_MU     "mu"        //木
#define TYPE_SHUI   "shui"      //水
#define TYPE_HUO    "huo"       //火
#define TYPE_TU     "tu"        //土
#define TYPE_SKILL  "skill"     //影响技能

#define TYPE_MONEY          "money"         //钱
#define TYPE_MEDICINE       "medicine"      //丹药
#define TYPE_SPIRITSTONE    "spiritstone"   //灵石

#define PROP_ROOT       "ulti_root" //神兵总入口

#define PROP_IS_SET     "is_set"    //是否套装

#define PROP_DEFECT     "obj_defect"    //神兵附加属性，负面效果
#define PROP_NODE       "obj_prop"      //神兵附加属性，有益用户
#define PROP_VALID      "obj_valid"     //神兵附加属性，装备要求
#define PROP_FIXED      "obj_fixed"     //神兵套装属性

#define PROP_HOLE       "hole"      //孔数
#define PROP_TYPE       "type"      //类型

//盔甲类型
private string *all_armors = ({
  TYPE_ARMOR,
  TYPE_BOOTS,
  TYPE_CLOTH,
  TYPE_HANDS,
  TYPE_SHIELD,
  TYPE_SURCOAT,
  TYPE_WRISTS,
  TYPE_WAIST,
  TYPE_HEAD,
  TYPE_SHOULDER
});
//首饰类型
private string *all_jewelry = ({ TYPE_NECK, TYPE_AMULET, TYPE_RING });
//武器类型
private string *all_weapons = ({ TYPE_AXE, TYPE_BLADE, TYPE_DAGGER, TYPE_FORK, TYPE_HAMMER, TYPE_MACE, TYPE_QIN, TYPE_RAKE, TYPE_SPEAR, TYPE_STAFF,
  TYPE_STICK, TYPE_SWORD, TYPE_THROWING, TYPE_WHIP, TYPE_XIAO });
//其他物品
private mapping all_items = ([
  TYPE_MONEY: (: call_other, __FILE__, "generate_money" :),
  TYPE_MEDICINE: (: call_other, __FILE__, "generate_medicine" :),
  TYPE_SPIRITSTONE: (: call_other, __FILE__, "generate_spiritstone" :),
]);

mapping EQUIP_PROP = ([
  "damage": ([
    KIND_WEAPON: ([
      "min_level": 0,
      "max_level": MAX_USER_LEVEL,
      "type": TYPE_PHY,
      "desc": "物理杀伤力",
      "value": (: call_other, __FILE__, "get_weapon_damage" :),
      "vtype": VTYPE_ABS,
      "usage": USAGE_INC,
    ]),
  ]),
  "armor": ([
    KIND_ARMOR: ([
      "type": TYPE_PHY,
      "desc": "盔甲保护力",
      "value": (: call_other, __FILE__, "get_armor_armor" :),
      "vtype": VTYPE_ABS,
      "usage": USAGE_INC,
    ]),
    KIND_JEWELRY: ([
      "type": ({ TYPE_PHY, TYPE_SPELLS }),
      "desc": "盔甲保护力",
      "value": (: call_other, __FILE__, "get_jewelry_armor" :),
      "vtype": VTYPE_ABS,
      "usage": USAGE_INC,
    ]),
  ]),
]);

mapping EQUIP_CONFIG = ([]);

void generate() {
  int i, j, k, m;
  int count = sizeof(EQUIP_PROP);
  string *all_prop = keys(EQUIP_PROP);
  string prop;
  int *all_kind;
  int kind, count2, count3;
  int min_level, max_level;
  string type;
  string *types;

  for (i = 0; i < count; i++) {
    prop = all_prop[i];
    all_kind = keys(EQUIP_PROP[prop]);

    count2 = sizeof(all_kind);
    for (j = 0; j < count2; j++) {
      kind = all_kind[j];
      type = 0;
      types = 0;

      if (stringp(EQUIP_PROP[prop][kind]["type"])) {
        type = EQUIP_PROP[prop][kind]["type"];
      } else if (arrayp(EQUIP_PROP[prop][kind]["type"])) {
        types = EQUIP_PROP[prop][kind]["type"];
      } else {
        continue;
      }
      if (undefinedp(EQUIP_PROP[prop][kind]["min_level"])) {
        min_level = 0;
      } else {
        min_level = EQUIP_PROP[prop][kind]["min_level"];
      }
      if (undefinedp(EQUIP_PROP[prop][kind]["max_level"])) {
        max_level = MAX_USER_LEVEL;
      } else {
        max_level = EQUIP_PROP[prop][kind]["max_level"];
      }

      if (type) {
        if (undefinedp(EQUIP_CONFIG[kind])) {
          EQUIP_CONFIG[kind] = ([]);
        }
        if (undefinedp(EQUIP_CONFIG[kind][type])) {
          EQUIP_CONFIG[kind][type] = ([]);
        }

        for (k = min_level; k <= max_level; k++) {
          if (undefinedp(EQUIP_CONFIG[kind][type][k])) {
            EQUIP_CONFIG[kind][type][k] = ({ prop });
          } else {
            EQUIP_CONFIG[kind][type][k] += ({ prop });
          }
        }
      }

      if (types) {
        count3 = sizeof(types);

        for (m = 0; m < count3; m++) {
          type = types[m];

          if (undefinedp(EQUIP_CONFIG[kind])) {
            EQUIP_CONFIG[kind] = ([]);
          }
          if (undefinedp(EQUIP_CONFIG[kind][type])) {
            EQUIP_CONFIG[kind][type] = ([]);
          }

          for (k = min_level; k <= max_level; k++) {
            if (undefinedp(EQUIP_CONFIG[kind][type][k])) {
              EQUIP_CONFIG[kind][type][k] = ({ prop });
            } else {
              EQUIP_CONFIG[kind][type][k] += ({ prop });
            }
          }
        }
      }
    }
  }
}

void create() {
  seteuid(getuid());
  set("name", "天降神兵");
  set("id", "ultimated");
  generate();
}

void set_hole(object ob, int hole) {
  if (!ob) {
    return;
  }

  ob->set(PROP_ROOT "/" PROP_HOLE, hole);
  ob->set("diablo_prop/can_inset", hole);
}

void set_valid(object ob, string content, mixed value) {
  if (!ob) {
    return;
  }

  ob->set(PROP_ROOT "/" PROP_VALID "/" + content, value);
}

void set_valid_weapon(object obj, int grade, int level) {
  int power;

  if (random(2)) {
    power = LEVEL_D->query_level_need_exp(level);
    power = power / 2 + random(power / 2);
    if (0 < power) {
      set_valid(obj, "combat_exp", power);
    }
  }

  if (random(2)) {
    power = LEVEL_D->query_level_need_dx(level);
    power = power / 2 + random(power / 2);
    if (0 < power) {
      set_valid(obj, "daoxing", power);
    }
  }
}

int get_weapon_damage(string type, int grade, int level) {
  int base = 10000;

  return base + grade * base + (level / 100) * base;
}

void set_weapons_prop(object obj, string *wuxing, string type, int grade, int level) {
  string kind;
  int count = sizeof(wuxing);
  int i;
  mixed result;
  string *prop;
  int j, count2;

  for (i = 0; i < count; i++) {
    kind = wuxing[i];

    if (undefinedp(EQUIP_CONFIG[KIND_WEAPON])) {
      continue;
    }
    if (undefinedp(EQUIP_CONFIG[KIND_WEAPON][kind])) {
      continue;
    }
    if (undefinedp(EQUIP_CONFIG[KIND_WEAPON][kind][level])) {
      continue;
    }

    prop = EQUIP_CONFIG[KIND_WEAPON][kind][level];
    if (!prop || 0 >= sizeof(prop)) {
      continue;
    }

    count2 = sizeof(prop);

    for (j = 0; j < count2; j++) {
      if (undefinedp(EQUIP_PROP[prop[j]])) {
        continue;
      }
      if (undefinedp(EQUIP_PROP[prop[j]][KIND_WEAPON])) {
        continue;
      }
      if (undefinedp(EQUIP_PROP[prop[j]][KIND_WEAPON]["value"])) {
        continue;
      }

      if (functionp(EQUIP_PROP[prop[j]][KIND_WEAPON]["value"])) {
        result = evaluate(EQUIP_PROP[prop[j]][KIND_WEAPON]["value"], kind, grade, level);
      } else {
        result = EQUIP_PROP[prop[j]][KIND_WEAPON]["value"];
      }

      obj->set(PROP_ROOT + "/" + PROP_NODE + "/" + prop[j], result);
      if ("damage" == prop[j]) {
        obj->set("weapon_prop/damage", result);
      }
    }
  }
}

object create_ultimate_weapon(string *wuxing, int grade, int level) {
  object obj;
  string type = all_weapons[random(sizeof(all_weapons))];

  obj = new("/obj/ultimate/weapons/" + type + ".lpc");

  if (!obj) {
    return 0;
  }

  set_valid_weapon(obj, grade, level);

  set_weapons_prop(obj, wuxing, type, grade, level);

  return obj;
}

