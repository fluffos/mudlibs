#pragma optimize
#pragma save_binary

inherit    F_DBASE;

#include <ansi.h>
#include <command.h>
#include <globals.h>
#include <net/daemons.h>
#include <net/macros.h>
#include <obstacle.h>

#define    ZXDIR    "/d/quest/zxzz/"
//去掉怪兽系统
//#define FILE "/d/obj/npc/emery.lpc"

int LAST_HARD_DIS= 0;

string *families = ({
    "乌鸡国",    "宝象国",    "天竺国",    "女儿国",
    "玉华县",    "金平府",    "五庄观",    "祭赛国",
    "钦法国",    "比丘国",    "朱紫国",    "车迟国",
    "高老庄",    "江洲国",
});

void init_cron();
void zxzz_start();
void qujing();
int set_last_hard_dis();

nosave int flag = 0;

void create()
{
    seteuid( ROOT_UID );
    set("channel_id", "正邪之争");
    set("id", "zxzz");
    CHANNEL_D->do_channel(this_object(), "sys", "正邪之争任务开始......");
    set_heart_beat(300);
    set_last_hard_dis();
}

int query_last_hard_dis()
{
    return LAST_HARD_DIS;
}

int set_last_hard_dis()
{
    LAST_HARD_DIS = time();
    return time();
}

int clean_up()
{
    return 1;
}

private void heart_beat()
{
    remove_call_out("init_cron");
    call_out("init_cron", 1);
}

void init_cron()
{
    mixed *local;

    local = localtime(time());

    if ( !((local[1]) % 30) )
    {
        message("channel:chat", HIR"【太平盛世】："HIY"自动更新仙侣奇缘任务榜。\n"NOR, users());
        if ( random(5) )
        {
            TASK_D->init_dynamic_quest();
        }
        else
        {
            TASK_D->init_dynamic_quest(1);
        }

        remove_call_out("qujing");
        call_out("qujing", 10 + random(10));
    }

    /*if(!((local[1])%20))
    {
        remove_call_out("zxzz_start");
        call_out("zxzz_start",1);
    }*/
}

void qujing()
{
    int k;
    object ts,where;

    k = random(sizeof(families));
    ts = find_living("tang sanzang");
    
    if ( ts )
    {
        where = environment(ts);
    }

    if ( !ts || !where )
    {                 
        ts = new(ZXDIR"npc/ts");
        ts->set("target", families[k]);
        ts->invocation(k);
        message("zxzz",HIW"【如来佛祖】"HIG"：哈哈!听说唐三藏师徒已经来到"
            + families[k] + "了，相信不久就会到达灵山了。\n"NOR, users());
    }
    else
    {
        CHANNEL_D->do_channel(this_object(), "sys", "唐僧已存在,西天取经任务发布取消！\n");
    }
}

void zxzz_start()
{
    int k;
    object tdzz, hsmw, zxzz, jobnpc;
    
    k = random(sizeof(families));
    tdzz = find_living("tiandi zhizun");
    hsmw = find_living("hunshi mowang");

    if ( tdzz && environment(tdzz) )
    {
        zxzz = tdzz;
    }
    if ( hsmw && environment(hsmw) )
    {
        zxzz = hsmw;
    }

    if ( !zxzz )
    {
        if ( flag == 0 )
        {
            jobnpc = new(ZXDIR"tdzz");
            jobnpc->set("target", families[k]);
            jobnpc->invocation(k);
            message("zxzz", HIR"【正邪之争】"HIW"天地至尊："HIG"此次" + families[k] + "之行必能取天地正气以惩世间妖孽。\n"NOR, users());
            flag = 1;
        }
        else
        {
            jobnpc = new(ZXDIR"hsmw");
            jobnpc->set("target", families[k]);
            jobnpc->invocation(k);
            message("zxzz", HIR"【正邪之争】"HIW"混世魔王："HIG"" + families[k] + "果然是个修炼的好地方，各位魔道弟子注意护法。\n"NOR,users());
            flag=0;    
        }
    }
    else
    {
        CHANNEL_D->do_channel(this_object(), "sys", "任务npc已存在,正邪之争任务发布取消！\n");    
    }
}
