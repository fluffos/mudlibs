#include <ansi.h>

#define COIN_PER_SILVER 100
#define SILVER_PER_GOLD 100
#define GOLD_PER_CASH 10
#define CASH_PER_TENCASH 10

int gold_to_coin(int gold) {
  return gold * SILVER_PER_GOLD * COIN_PER_SILVER;
}

string money_str(int amount) {
  // returns a chinese string of `amount` of money
  string output;

  if (amount / 10000) {
    output = chinese_number(amount / 10000) + "两" HIY "黄金" NOR;
    amount %= 10000;
  } else {
    output = "";
  }

  if (amount / 100) {
    output = output + chinese_number(amount / 100) + "两" HIW "白银" NOR;
    amount %= 100;
  }
  if (amount) {
    return output + chinese_number(amount) + "文" YEL "铜板" NOR;
  }

  return output;
}

string price_str(int amount) {
  // returns a chinese string of `amount` of money
  string output;

  if (amount < 1) {
    amount = 1;
  }

  if (amount / 10000) {
    output = chinese_number(amount / 10000) + "两黄金";
    amount %= 10000;
  } else {
    output = "";
  }

  if (amount / 100) {
    if (output != "") {
      output += "又" + chinese_number(amount / 100) + "两白银";
    } else {
      output = chinese_number(amount / 100) + "两白银";
    }

    amount %= 100;
  }

  if (amount) {
    if (output != "") {
      return output + "又" + chinese_number(amount) + "文铜板";
    } else {
      return chinese_number(amount) + "文铜板";
    }
  }

  return output;
}

int query_balance(object me) {
  if (me->query("money_count")) {
    return system_maxmoney();
  }

  return me->query("balance");
}

int add_coin(object me, int value) {
  string name;
  int balance;
  int result = 0;
  int i;
  int max = system_maxmoney();

  if (0 == value) {
    return result;
  }

  while (0 < value) {
    balance = me->query("balance");

    if (max - balance >= value) {
      result += value;
      me->add2("balance", value);
      return result;
    }

    value -= (max - balance);
    result += (max - balance);
    me->add2("money_count", 1);
    me->set("balance", 0);
  }

  while (0 > value) {
    balance = me->query("balance");

    if (balance >= -value) {
      result += value;
      me->add2("balance", value);
      return result;
    }

    if (0 < me->query("money_count")) {
      result += -balance;
      value += balance;
      me->set("balance", max);
      me->add2("money_count", -1);
    } else {
      result += -balance;
      me->set("balance", 0);
      return result;
    }
  }

  return result;
}

int add_silver(object me, int value) {
  return add_coin(me, value * COIN_PER_SILVER) / COIN_PER_SILVER;
}

int add_gold(object me, int value) {
  return add_silver(me, value * SILVER_PER_GOLD) / SILVER_PER_GOLD;
}

int add_cash(object me, int value) {
  return add_gold(me, value * GOLD_PER_CASH) / GOLD_PER_CASH;
}

int add_tencash(object me, int value) {
  return add_cash(me, value * CASH_PER_TENCASH) / CASH_PER_TENCASH;
}

int pay_player(object who, int amount) {
  int v;
  int result = amount;
  object ob;

  seteuid(getuid());

  if (amount < 1) {
    amount = 0;
  }

  ob = new("/obj/money/gold");
  if (v = amount / ob->query("base_value")) {
    ob->set_amount(v);
    if (!(ob->move(who))) {
      ob->move(environment(who));
    }

    amount %= ob->query("base_value");
  } else {
    destruct(ob);
  }

  ob = new("/obj/money/silver");
  if (v = amount / ob->query("base_value")) {
    ob->set_amount(v);
    if (!(ob->move(who))) {
      ob->move(environment(who));
    }

    amount %= ob->query("base_value");
  } else {
    destruct(ob);
  }

  if (v = amount) {
    ob = new("/obj/money/coin");
    ob->set_amount(v);
    if (!(ob->move(who))) {
      ob->move(environment(who));
    }
  }

  return result;
}

int player_pay(object who, int amount) {
  object g_ob, s_ob, c_ob;
  int gc, sc, cc, left;

  seteuid(getuid());

  if (g_ob = present("gold", who)) {
    gc = g_ob->query_amount();
  } else {
    gc = 0;
  }

  if (s_ob = present("silver", who)) {
    sc = s_ob->query_amount();
  } else {
    sc = 0;
  }

  if (c_ob = present("coin", who)) {
    cc = c_ob->query_amount();
  } else {
    cc = 0;
  }

  if (cc + sc * 100 + gc * 10000 < amount) {
    if (present("thousand-cash", who)) {
      return 2;
    } else {
      return 0;
    }
  } else {
    left = cc + sc * 100 + gc * 10000 - amount;
    gc = left / 10000;
    left = left % 10000;
    sc = left / 100;
    cc = left % 100;

    if (g_ob) {
      g_ob->set_amount(gc);
    } else {
      sc += (gc * 100);
    }

    if (s_ob) {
      s_ob->set_amount(sc);
    } else if (sc) {
      s_ob = new("/obj/money/silver");
      s_ob->set_amount(sc);
      s_ob->move(who);
    }

    if (c_ob) {
      c_ob->set_amount(cc);
    } else if (cc) {
      c_ob = new("/obj/money/coin");
      c_ob->set_amount(cc);
      c_ob->move(who);
    }

    return 1;
  }
}

int do_bank(object me) {
  if (system_type() == SYSTEM_64BIT) {
    write("潜能: " + me->query("potential_count") + "*" + system_maxpotential() + " + " + chinese_number(me->query("potential")) + "\n");
    write("存款: " + me->query("money_count") + "*" + system_maxmoney() + " + " + money_str(me->query("balance")) + "\n");
  } else {
    write("潜能: " + me->query("potential_count") + "*" + system_maxpotential() + " + " + me->query("potential") + "\n");
    write("存款: " + me->query("money_count") + "*" + system_maxmoney() + " + " + me->query("balance") + "\n");
  }

  return 1;
}

int do_deposit(object me, string arg) {
  string what;
  int amount;
  object what_ob;

  if (!arg || sscanf(arg, "%d %s", amount, what) != 2) {
    return notify_fail("命令格式：deposit <数量> <类型>\n");
  }

  if (amount <= 0) {
    return notify_fail("请输入合理数量。\n");
  }

  if (me->is_busy()) {
    return notify_fail("你现在正忙着呢...。\n");
  }

  what_ob = present(what + "_money", me);
  if (!what_ob) {
    return notify_fail("你身上没有带这种钱。\n");
  }
  if ((int)what_ob->query_amount() < amount) {
    return notify_fail("你带的" + what_ob->query("name") + "不够。\n");
  }

  if (10000000 / what_ob->query("base_value") < amount) {
    return notify_fail("mudos不支持，每次只能存一千两黄金\n");
  }

  amount = add_coin(me, amount * what_ob->query("base_value"));

  if (0 < amount) {
    message_vision(sprintf("$N拿出%s，存进了银行账户。\n", money_str(amount)), me);

    amount /= what_ob->query("base_value");

    if ((int)what_ob->query_amount() == amount) {
      destruct(what_ob);
    } else {
      what_ob->add_amount(-amount);
    }
  }

  me->save();

  return 1;
}

int do_withdraw(object me, string arg) {
  int amount;
  string what;

  if (!arg || sscanf(arg, "%d %s", amount, what) != 2) {
    return notify_fail("命令格式：withdraw <数量> <货币单位>\n");
  }

  if (amount <= 0) {
    return notify_fail("请输入合理数量。\n");
  }

  if (me->is_busy()) {
    return notify_fail("你现在正忙着呢...。\n");
  }

  if (file_size("/obj/money/" + what + ".lpc") < 0) {
    return notify_fail("你想取出什么钱？\n");
  }
  what = "/obj/money/" + what;

  if (10000000 / what->query("base_value") < amount) {
    return notify_fail("mudos不支持，每次只能取一千两黄金\n");
  }

  amount = -add_coin(me, -amount * what->query("base_value"));

  if (0 < amount) {
    amount = pay_player(me, amount);

    if (0 < amount) {
      message_vision(sprintf("$N从银行账户里取出%s。\n", money_str(amount)), me);
    }
  }

  me->save();

  return 1;
}

int do_convert(object me, string arg) {
  string from, to;
  int amount, bv1, bv2;
  object from_ob, to_ob;

  if (!arg || sscanf(arg, "%d %s to %s", amount, from, to) != 3) {
    return notify_fail("指令格式：convert <数量> <货币种类> to <货币种类>\n");
  }

  if (me->is_busy()) {
    return notify_fail("你现在正忙着呢...。\n");
  }

  from_ob = present(from + "_money", me);
  to_ob = present(to + "_money", me);
  if (!to_ob && file_size("/obj/money/" + to + ".lpc") < 0) {
    return notify_fail("你想兑换哪一种钱？\n");
  }

  if (!from_ob) {
    return notify_fail("你身上没有这种货币。\n");
  }
  if (amount < 1) {
    return notify_fail("兑换货币一次至少要兑换一个。\n");
  }

  if ((int)from_ob->query_amount() < amount) {
    return notify_fail("你身上没有那么多" + from_ob->query("name") + "。\n");
  }

  bv1 = from_ob->query("base_value");
  if (!bv1) {
    return notify_fail("这种东西不值钱。\n");
  }

  if (10000000 / bv1 < amount) {
    return notify_fail("mudos不支持，每次只能兑换一千两黄金\n");
  }

  bv2 = to_ob ? to_ob->query("base_value") : call_other("/obj/money/" + to, "query", "base_value");

  if (bv1 < bv2) {
    amount -= amount % (bv2 / bv1);
  }
  if (amount == 0) {
    return notify_fail("这些" + from_ob->query("name") + "的价值太低了，换不起。\n");
  }

  if (!to_ob) {
    to_ob = new("/obj/money/" + to);
    if (!(to_ob->move(me))) {
      return 0;
    }
    to_ob->set_amount(amount * bv1 / bv2);
  } else {
    to_ob->add_amount(amount * bv1 / bv2);
  }

  message_vision(sprintf("$N从身上取出%s，换成%s。\n",
    money_str(amount * bv1),
    money_str(amount * bv1 / bv2)),
    me);
  if ((int)from_ob->query_amount() == amount) {
    destruct(from_ob);
  } else {
    from_ob->add_amount(-amount);
  }

  me->save();

  return 1;
}

int do_transfer(object me, string arg) {
  string from, to;
  int amount, bv;
  object from_ob, to_ob;

  if (!arg || sscanf(arg, "%d %s to %s", amount, from, to) != 3) {
    return notify_fail("指令格式：convert <数量> <货币种类> to <对方id>\n");
  }

  from_ob = me;
  to_ob = present(to, environment(from_ob));

  if (!from_ob || !to_ob) {
    return notify_fail("人都不在这里，如何转账...。\n");
  }

  if (from_ob->is_busy()) {
    return notify_fail("你现在正忙着呢...。\n");
  }

  if (file_size("/obj/money/" + from + ".lpc") < 0) {
    return notify_fail("你想转账哪一种钱？\n");
  }

  if (amount < 1) {
    return notify_fail("兑换货币一次至少要兑换一个。\n");
  }

  bv = ("/obj/money/" + from)->query("base_value");

  if (amount > system_maxmoney() / bv) {
    return notify_fail("一次最多转账" + money_str(system_maxmoney()) + "。\n");
  }

  amount *= bv;

  if (from_ob->query_balance() < amount) {
    return notify_fail("你的存款不够。\n");
  }

  amount = add_coin(to_ob, amount);
  amount = add_coin(from_ob, -amount);
  amount = -amount;

  message_vision(sprintf("$N给$n转账%s。\n", money_str(amount)), from_ob, to_ob);

  return 1;
}
