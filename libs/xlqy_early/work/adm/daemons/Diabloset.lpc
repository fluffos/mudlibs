      ob->set("id", RED "Perish " + ob->query("id") + NOR);
      ob->set("diablo_fixed/perish_stat", 1);



      break;
    case "destory_stat":  // add weapon damage & skill damage
      ob->set("name", RED "毁灭之" + ob->query("name") + NOR);
      ob->set("id", RED "Destory " + ob->query("id") + NOR);
      ob->set("diablo_fixed/destory_stat", 1);

      break;
    case "extinguish_stat":  // add weapon damage & skill damage
      ob->set("name", RED "灭绝之" + ob->query("name") + NOR);
      ob->set("id", RED "Extinguish " + ob->query("id") + NOR);
      ob->set("diablo_fixed/extinguish_stat", 1);

      break;
    case "force_vs_damage":
      ob->set("name", HIG "力场之" + ob->query("name") + NOR);
      ob->set("id", HIG "ForceShield " + ob->query("id") + NOR);
      ob->set("diablo_fixed/force_vs_damage", 1);

      break;
    case "mana_vs_damage":
      ob->set("name", HIB "能量之" + ob->query("name") + NOR);
      ob->set("id", HIB "ManaShield " + ob->query("id") + NOR);
      ob->set("diablo_fixed/mana_vs_damage", 1);

      break;

  }

}

void set_fixed_prop(object ob, string type) {

  switch (type) {
    case "weapon":
      ob->set("diablo_prop/damage", 75 + random(45));
      break;
    case "armor":
      ob->set("diablo_prop/armor", 80 + random(30));
      break;
    case "boots":
      ob->set("diablo_prop/armor", 40 + random(40));

      break;
    case "cloth":
      ob->set("diablo_prop/armor", 50 + random(20));
      break;
    case "hands":
      ob->set("diablo_prop/armor", 25 + random(20));
      break;
    case "shield":
      ob->set("diablo_prop/armor", 60 + random(10));
      break;
    case "surcoat":
      ob->set("diablo_prop/armor", 50 + random(50));
      break;
    case "wrists":
      ob->set("diablo_prop/armor", 30 + random(15));
      break;
    case "waist":
      ob->set("diablo_prop/armor", 35 + random(15));
      break;
    case "head":
      ob->set("diablo_prop/armor", 50 + random(20));
      break;
    case "shoulder":
      ob->set("diablo_prop/armor", 40 + random(20));
      break;
    case "neck":
      ob->set("diablo_prop/armor", 20 + random(15));
      break;
    case "amulet":
      ob->set("diablo_prop/armor", 5 + random(10));
      break;
    case "finger":
      ob->set("diablo_prop/armor", 15 + random(15));
      break;

  }
  ob->set("diablo_prop/rigidity", 150 + random(100));
  ob->set("identification", 1);
  ob->set("is_diablo_set", 1);
  ob->set("level", 9);

}
