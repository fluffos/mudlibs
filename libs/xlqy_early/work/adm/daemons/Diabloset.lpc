});
string *aarmors = ({ "neck", "amulet", "finger" });
string *weapons = ({ "axe", "blade", "dagger", "fork", "hammer", "mace", "qin", "rake", "spear", "staff",
  "stick", "sword", "throwing", "whip", "xiao" });

