        case "wealth_stat":  // add magic find & kar
          {

            ob->set("diablo_prop/karma", 3);
            ob->set("diablo_prop/magic_find", 1000);
            break;
          }
        case "fortune_stat":  // add magic find & kar
          {

            ob->set("diablo_prop/karma", 5);
            ob->set("diablo_prop/magic_find", 2000);
            break;
          }
        case "antique_stat":  // add magic find & kar
          {

            ob->set("diablo_prop/karma", 10);
            ob->set("diablo_prop/magic_find", 3000);
            break;
          }
        case "Regrowth_kee":
          {
            ob->set("diablo_fixed/Regrowth_kee", 1);
            ob->set("diablo_prop/regenerate_kee", 50);
            break;
          }
        case "Regenerate_kee":
          {
            ob->set("diablo_fixed/Regenerate_kee", 1);
            ob->set("diablo_prop/regenerate_kee", 100);
            break;
          }

        case "Revive_kee":
          {
            ob->set("diablo_fixed/Revive_kee", 1);
            ob->set("diablo_prop/regenerate_kee", 150);
            break;
          }
          //////////////////////////
        case "Regrowth_sen":
          {
            ob->set("diablo_fixed/Regrowth_sen", 1);
            ob->set("diablo_prop/regenerate_sen", 50);
            break;
          }
        case "Regenerate_sen":
          {

            ob->set("diablo_fixed/Regenerate_sen", 1);
            ob->set("diablo_prop/regenerate_sen", 100);
            break;
          }
        case "Revive_sen":
          {
            ob->set("diablo_fixed/Revive_sen", 1);
            ob->set("diablo_prop/regenerate_kee", 150);
            break;
          }
        case "Regrowth_force":
          {
            ob->set("diablo_fixed/Regrowth_force", 1);
            ob->set("diablo_prop/regenerate_force", 30);
            break;
          }
        case "Regenerate_force":
          {

            ob->set("diablo_prop/regenerate_force", 70);
            break;
          }

        case "Revive_force":
          {

            ob->set("diablo_prop/regenerate_force", 100);
            break;
          }
        case "Regrowth_mana":
          {
            ob->set("diablo_prop/regenerate_mana", 30);
            break;
          }
        case "Regenerate_mana":
          {
            ob->set("diablo_prop/regenerate_mana", 70);
            break;
          }


        case "Revive_mana":
          {
            ob->set("diablo_prop/regenerate_mana", 100);
            break;
          }
        case "perish_stat":  // add weapon damage & skill damage
          {
            ob->add("diablo_prop/damage", 15);
            ob->set("diablo_prop/add_skill_damage", 5);

            break;
          }
        case "destory_stat":  // add weapon damage & skill damage
          {
            ob->add("diablo_prop/damage", 20);
            ob->set("diablo_prop/add_skill_damage", 10);
            break;
          }
        case "extinguish_stat":  // add weapon damage & skill damage
          {
            ob->add("diablo_prop/damage", 30);
            ob->set("diablo_prop/add_skill_damage", 15);
            break;
          }
        case "force_vs_damage":
          {
            ob->set("diablo_prop/force_vs_damage", 1000);
            break;
          }
        case "mana_vs_damage":
          {
            ob->set("diablo_prop/mana_vs_damage", 1000);
            break;


          }
      }

    }
  }

}
