void check_fixed_prop(object ob);
void set_fixed_prop(object ob, string type);
void set_fixed_effect(object ob, string content);
void set_fixed_effect2(object ob, string content);
void set_fixed_effect3(object ob, string content);
varargs object drop(string typess, string subtype, string props);
void create() {
  seteuid(getuid());
  set("name", "暗黑精灵");
  set("id", "diabloset");

}
varargs object drop(string typess, string subtype, string props) {
  object obj;
  string temp_str, types, content;
  int i = random(91);


  if (i > 55) temp_str = "armors";
  else if (i > 20) temp_str = "weapons";
  else temp_str = "others";
  if (typess) temp_str = typess;

  //	if(obj_level==SET) //套装
  if (1) {

    if (1) {
      switch (temp_str) {
        case "armors":
          {

            types = armors[random(sizeof(armors))];
            if (subtype) types = subtype;
            obj = new("/obj/diablo_ob/armors/" + types + ".lpc");
            content = effect_fixed_armor[random(sizeof(effect_fixed_armor))];
            if (props) content = props;
            set_fixed_prop(obj, types);
            set_fixed_effect(obj, content);
            check_fixed_prop(obj);

            break;
          }
        case "weapons":
          {
            types = weapons[random(sizeof(weapons))];
            if (subtype) types = subtype;
            obj = new("/obj/diablo_ob/weapons/" + types + ".lpc");
            content = effect_fixed_weapon[random(sizeof(effect_fixed_weapon))];
            if (props) content = props;

            temp_str = "weapon";
            set_fixed_prop(obj, temp_str);
            if (types == "dagger")
              obj->set("diablo_prop/damage", 24 + random(36));
            set_fixed_effect(obj, content);

            check_fixed_prop(obj);


            break;
          }
        case "others":
          {
            types = aarmors[random(sizeof(aarmors))];
            if (subtype) types = subtype;
            obj = new("/obj/diablo_ob/armors/" + types + ".lpc");
            content = effect_fixed_amuring[random(sizeof(effect_fixed_amuring))];
            if (props) content = props;

            set_fixed_prop(obj, types);
            set_fixed_effect(obj, content);

            check_fixed_prop(obj);


            break;
          }

      }



    } else {


      /*		dir_path="/obj/diablo_ob/set/"+temp_str+"/"+npc_level+"";
		file_name=random_file(dir_path);
		file_full_name=dir_path+"/"+file_name;
		//判断是否存在file
		if (file_size(file_full_name) <0) 
		{
			message_vision(file_full_name,npc);
			return ;
		}
		obj=new(file_full_name);*/

    }
    return obj;
  }

}


void check_fixed_prop(object ob) {
  int flag;
  mapping prop;
  string *type;
  if (ob->query("weapon_prop/damage"))
    flag = 1;
  else flag = 0;

  if (!mapp(prop = ob->query("diablo_fixed")) || sizeof(prop) < 1)
    return;
  else {

    type = keys(prop);
    for (int i = 0; i < sizeof(type); i++) {


      switch (type[i]) {
        case "shine_stat":  //add 8 stat 2
          {

            ob->set("diablo_prop/karma", 2);
            ob->set("diablo_prop/strength", 2);
            ob->set("diablo_prop/courage", 2);
            ob->set("diablo_prop/intelligence", 2);
            ob->set("diablo_prop/composure", 2);
            ob->set("diablo_prop/spirituality", 2);
            ob->set("diablo_prop/constitution", 2);
            ob->set("diablo_prop/personality", 2);

            break;
          }
        case "holy_stat":         //add 8 stat 5
          {

            ob->set("diablo_prop/karma", 5);
            ob->set("diablo_prop/strength", 5);
            ob->set("diablo_prop/courage", 5);
            ob->set("diablo_prop/intelligence", 5);
            ob->set("diablo_prop/composure", 5);
            ob->set("diablo_prop/spirituality", 5);
            ob->set("diablo_prop/constitution", 5);
            ob->set("diablo_prop/personality", 5);
            break;
          }
        case "glory_stat":         //add 8 stat 3
          {

            ob->set("diablo_prop/karma", 3);
            ob->set("diablo_prop/strength", 3);
            ob->set("diablo_prop/courage", 3);
            ob->set("diablo_prop/intelligence", 3);
            ob->set("diablo_prop/composure", 3);
            ob->set("diablo_prop/spirituality", 3);
            ob->set("diablo_prop/constitution", 3);
            ob->set("diablo_prop/personality", 3);
            break;
          }
        case "cold_attack":  //add shui & max shui
          {

            if (flag) {
              ob->set("diablo_prop/add_max_shui", 500);
              ob->set("diablo_prop/add_shui", 10);
            } else {
              ob->set("diablo_prop/sub_max_shui", 300);
              ob->set("diablo_prop/sub_shui", 15);
            }
            break;
          }
        case "frost_attack":
          {

            if (flag) {
              ob->set("diablo_prop/add_max_shui", 1000);
              ob->set("diablo_prop/add_shui", 20);
            } else {
              ob->set("diablo_prop/sub_max_shui", 500);
              ob->set("diablo_prop/sub_shui", 25);
            }
            break;
          }
        case "icy_attack":
          {

            if (flag) {
              ob->set("diablo_prop/add_max_shui", 1500);
              ob->set("diablo_prop/add_shui", 25);
            } else {
              ob->set("diablo_prop/sub_max_shui", 1000);
              ob->set("diablo_prop/sub_shui", 30);
            }
            break;
          }
        case "bizzard_attack":
          {

            if (flag) {
              ob->set("diablo_prop/add_max_shui", 2000);
              ob->set("diablo_prop/add_shui", 30);
            } else {
              ob->set("diablo_prop/sub_max_shui", 1500);
              ob->set("diablo_prop/sub_shui", 35);
            }
            break;
          }

        case "bolt_attack":
          {

            if (flag) {
              ob->set("diablo_prop/add_max_jin", 500);
              ob->set("diablo_prop/add_jin", 15);
            } else {
              ob->set("diablo_prop/sub_max_jin", 300);
              ob->set("diablo_prop/sub_jin", 15);
            }
            break;
          }
        case "lightning_attack":
          {

            if (flag) {
              ob->set("diablo_prop/add_max_jin", 1000);
              ob->set("diablo_prop/add_jin", 25);
            } else {
              ob->set("diablo_prop/sub_max_jin", 500);
              ob->set("diablo_prop/sub_jin", 25);
            }
            break;
          }
        case "thunder_attack":
          {

            if (flag) {
              ob->set("diablo_prop/add_max_jin", 1500);
              ob->set("diablo_prop/add_jin", 35);
            } else {
              ob->set("diablo_prop/sub_max_jin", 1000);
              ob->set("diablo_prop/sub_jin", 35);
            }
            break;
          }
        case "thunderstorm_attack":
          {

            if (flag) {
              ob->set("diablo_prop/add_max_jin", 2000);
              ob->set("diablo_prop/add_jin", 45);
            } else {
              ob->set("diablo_prop/sub_max_jin", 1500);
              ob->set("diablo_prop/sub_jin", 45);
            }
