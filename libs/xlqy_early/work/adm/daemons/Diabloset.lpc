              ob->set("diablo_prop/sub_mu", 15);
            }
            break;
          }
          //////////////////////////////////
        case "Leech_attack":  // suck kee & add kee
          {


            ob->set("diablo_prop/add_kee", 150);
            ob->set("diablo_prop/combat_blood_kee", 500);

            break;
          }
        case "Locust_attack":
          {


            ob->set("diablo_prop/add_kee", 250);
            ob->set("diablo_prop/combat_blood_kee", 1000);
            break;
          }
        case "Lamprey_attack":
          {


            ob->set("diablo_prop/add_kee", 400);
