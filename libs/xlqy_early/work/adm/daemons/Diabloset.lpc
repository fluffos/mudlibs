            break;
          }
        case "Wraith_attack":
          {

            ob->set("diablo_prop/add_mana", 350);
            ob->set("diablo_prop/combat_blood_mana", 1500);
            break;
          }
        case "imp_attack":  // suck force & add force
          {

            ob->set("diablo_prop/add_force", 100);
            ob->set("diablo_prop/combat_blood_force", 300);
            break;
          }
        case "demon_attack":
          {

            ob->set("diablo_prop/add_force", 150);
            ob->set("diablo_prop/combat_blood_force", 500);
            break;
          }
        case "Devil_attack":
          {

            ob->set("diablo_prop/add_force", 200);
            ob->set("diablo_prop/combat_blood_force", 1000);
            break;
          }
          /////////////////////////////////////////////		
        case "unicorn_stat":  //add str & huo attack or add str & huo defense
          {

            if (flag) {
              ob->set("diablo_prop/strength", 20);
              ob->set("diablo_prop/add_huo", 20);
              ob->set("diablo_prop/sub_shui", -15);
            } else {
              ob->set("diablo_prop/strength", 20);
              ob->set("diablo_prop/sub_huo", 20);
              ob->set("diablo_prop/sub_shui", -15);

            }
            break;
          }
        case "phenix_stat":
          {

            if (flag) {
