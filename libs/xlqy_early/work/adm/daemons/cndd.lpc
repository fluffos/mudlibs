// condition.c

#include <condition.h>

// Pre-existing bug: every function below that touches hb_conditions
// (update_hb_condition/apply_hb_condition/query_hb_condition/
// clear_hb_condition -- a per-object heartbeat-condition store, parallel
// to the me->query_temp("conditions") dbase-backed one above but keyed
// on this_object()'s own state instead) uses it with NO declaration
// anywhere in the file at all (confirmed absent in the raw pre-conversion
// archive too, not something the conversion pipeline dropped) --
// "Undefined variable 'hb_conditions'" at every use site. Declaring it
// once here as a real global resolves every call site consistently.
nosave mapping hb_conditions;

// AGENTS.md §8b: clear_condition() (below) calls clear_hb_condition()
// before that function's own definition appears later in this same file
// -- "Undefined function clear_hb_condition" without a forward
// declaration, even though it's a completely ordinary same-file call.
nomask varargs void clear_hb_condition(string cnd);

mapping update_cond_x(object me, mapping conditions) {
  mixed *cnd, err;
  int i, flag, update_flag;
  object cnd_d;

  if (!me) {
    return 0;
  }

  if (!mapp(conditions) || 0 >= (i = sizeof(conditions))) {
    return 0;
  }

  cnd = keys(conditions);
  update_flag = 0;
  while (i--) {
    cnd_d = find_object(CONDITION_D(cnd[i]));
    if (!cnd_d) {
      //使用 call_other(filename, "???")  或是在 ??? 处填入任意不存在的方法函式名称，则只会载入物件
      err = catch(call_other(CONDITION_D(cnd[i]), "???"));
      cnd_d = find_object(CONDITION_D(cnd[i]));

      if (err || !cnd_d) {
        log_file("condition.err", sprintf("Failed to load condition daemon %s, removed from %O\nError: %s\n",
          CONDITION_D(cnd[i]), this_object(), err));
        if (mapp(conditions)) {
          map_delete(conditions, cnd[i]);
        }

        continue;
      }
    }

    flag = call_other(cnd_d, "update_condition", me, conditions[cnd[i]]);
    if (!(flag & CND_CONTINUE)) {
      if (mapp(conditions)) {
        map_delete(conditions, cnd[i]);
      }
    }

    update_flag |= flag;
  }

  if (!sizeof(conditions)) {
    conditions = 0;
  }

  me->set_temp("cond_flag", update_flag);

  return conditions;
}

int update_fixed_cond(object me) {
  mapping conditions;
  int update_flag = 0;

  me->delete_temp("cond_flag");
  conditions = update_cond_x(me, me->query("conditions"));
  update_flag |= me->query_temp("cond_flag");
  me->set("conditions", conditions);

  return update_flag;
}

int update_temp_cond(object me) {
  mapping conditions;
  int update_flag = 0;

  me->delete_temp("cond_flag");
  conditions = update_cond_x(me, me->query_temp("conditions"));
  update_flag |= me->query_temp("cond_flag");
  me->set_temp("conditions", conditions);

  return update_flag;
}

int update_condition(object me) {
  int update_flag = 0;

  update_flag |= update_fixed_cond(me);
  update_flag |= update_temp_cond(me);

  return update_flag;
}

void apply_condition(object me, string cnd, mixed info) {
  mapping conditions;

  if (!me || !cnd) {
    return;
  }

  conditions = me->query("conditions");

  if (!mapp(conditions)) {
    conditions = ([ cnd: info ]);
  } else {
    conditions[cnd] = info;
  }

  me->set("conditions", conditions);
}

void apply_temp_cond(object me, string cnd, mixed info) {
  mapping conditions;

  if (!me || !cnd) {
    return;
  }

  conditions = me->query_temp("conditions");

  if (!mapp(conditions)) {
    conditions = ([ cnd: info ]);
  } else {
    conditions[cnd] = info;
  }

  me->set_temp("conditions", conditions);
}

mixed query_condition(object me, string cnd) {
  mapping conditions;

  if (!me || !cnd) {
    return 0;
  }

  conditions = me->query("conditions");

  if (!mapp(conditions) || undefinedp(conditions[cnd])) {
    return 0;
  }

  return conditions[cnd];
}

mixed query_temp_cond(object me, string cnd) {
  mapping conditions;

  if (!me || !cnd) {
    return 0;
  }

  conditions = me->query_temp("conditions");

  if (!mapp(conditions) || undefinedp(conditions[cnd])) {
    return 0;
  }

  return conditions[cnd];
}

mapping query_entire_conditions(object me) {
  if (!me) {
    return 0;
  }

  return me->query("conditions");
}

mapping query_entire_temp_cond(object me) {
  if (!me) {
    return 0;
  }

  return me->query_temp("conditions");
}

varargs void clear_condition(object me, string cnd) {
  mixed *thiscnd, err;
  int i;
  object cnd_d;
  // pre-existing bug: `conditions` was used throughout this function
  // with no declaration/fetch at all (a compile error, "Undefined
  // variable 'conditions'") -- every sibling function in this same
  // file (query_entire_conditions() above, update_cond_x()'s own
  // parameter) fetches the same value via me->query_temp("conditions"),
  // so this is the same, unambiguous fix, not a guess.
  mapping conditions;

  if (!me) {
    return;
  }

  conditions = me->query_temp("conditions");

  if (!mapp(conditions) || !(i = sizeof(conditions))) {
    return;
  }

  if (cnd && undefinedp(conditions[cnd])) {
    return;
  }

  if (cnd) {
    cnd_d = find_object(CONDITION_D(cnd));
    if (!cnd_d) {
      //使用 call_other(filename, "???")  或是在 ??? 处填入任意不存在的方法函式名称，则只会载入物件
      err = catch(call_other(CONDITION_D(cnd), "???"));

      cnd_d = find_object(CONDITION_D(cnd));

      if (err || !cnd_d) {
        log_file("condition.err", sprintf("Failed to load condition daemon %s, removed from %O\nError: %s\n",
          CONDITION_D(cnd), this_object(), err));
        if (mapp(conditions)) {
          map_delete(conditions, cnd);
        }
        cnd_d = 0;
      }
    }

    if (cnd_d) {
      call_other(cnd_d, "clear_condition", this_object(), conditions[cnd]);
    }
  } else {
    thiscnd = keys(conditions);
    while (i--) {
      cnd_d = find_object(CONDITION_D(thiscnd[i]));
      if (!cnd_d) {
        //使用 call_other(filename, "???")  或是在 ??? 处填入任意不存在的方法函式名称，则只会载入物件
        err = catch(call_other(CONDITION_D(thiscnd[i]), "???"));

        cnd_d = find_object(CONDITION_D(thiscnd[i]));

        if (err || !cnd_d) {
          log_file("condition.err", sprintf("Failed to load condition daemon %s, removed from %O\nError: %s\n",
            CONDITION_D(thiscnd[i]), this_object(), err));
          if (mapp(conditions)) {
            map_delete(conditions, thiscnd[i]);
          }

          continue;
        }
      }

      call_other(cnd_d, "clear_condition", this_object(), conditions[thiscnd[i]]);
    }
  }

  if (!sizeof(conditions)) {
    conditions = 0;
  }

  if (!cnd) {
    conditions = 0;
  } else if (mapp(conditions)) {
    map_delete(conditions, cnd);
  }

  clear_hb_condition(cnd);
}

nomask void clear_conditions_by_type(string required_type) {
  object cnd_d;
  int i;
  string cnd_type;
  mixed *cnd, err;
  // Same pre-existing bug as clear_condition() above: `conditions` used
  // with no declaration. This function has no `me` parameter (unlike
  // clear_condition()), so it operates on this_object()'s own store.
  mapping conditions = this_object()->query_temp("conditions");

  if (!mapp(conditions) || !(i = sizeof(conditions))) {
    return;
  }
  cnd = keys(conditions);

  while (i--) {
    cnd_d = find_object(CONDITION_D(cnd[i]));
    if (!cnd_d) {
      err = catch(call_other(CONDITION_D(cnd[i]), "???"));
      cnd_d = find_object(CONDITION_D(cnd[i]));

      if (err || !cnd_d) {
        log_file(
          "condition.err",
          sprintf(
            "Failed to load condition daemon %s, removed from %O\nError: %s\n",
            CONDITION_D(cnd[i]),
            this_object(),
            err
          )
        );
        if (mapp(conditions)) {
          map_delete(conditions, cnd[i]);
        }
        continue;
      }
    }

    cnd_type = call_other(cnd_d, "query_type", this_object());
    if (cnd_type == required_type) {
      map_delete(conditions, cnd[i]);
    }
  }
}

nomask int update_hb_condition() {
  mixed *cnd, err;
  int i, flag, update_flag;
  object cnd_d;

  if (!mapp(hb_conditions) || !(i = sizeof(hb_conditions))) {
    return 0;
  }

  cnd = keys(hb_conditions);
  update_flag = 0;
  while (i--) {
    cnd_d = find_object(CONDITION_D(cnd[i]));
    if (!cnd_d) {
      //使用 call_other(filename, "???")  或是在 ??? 处填入任意不存在的方法函式名称，则只会载入物件
      err = catch(call_other(CONDITION_D(cnd[i]), "???"));

      cnd_d = find_object(CONDITION_D(cnd[i]));

      if (err || !cnd_d) {
        log_file("condition.err", sprintf("Failed to load condition daemon %s, removed from %O\nError: %s\n",
          CONDITION_D(cnd[i]), this_object(), err));
        if (mapp(hb_conditions)) {
          map_delete(hb_conditions, cnd[i]);
        }

        continue;
      }
    }

    flag = call_other(cnd_d, "update_condition", this_object(), hb_conditions[cnd[i]]);
    if (!(flag & CND_CONTINUE)) {
      if (mapp(hb_conditions)) {
        map_delete(hb_conditions, cnd[i]);
      }
    }

    update_flag |= flag;
  }

  if (!sizeof(hb_conditions)) {
    hb_conditions = 0;
  }

  return update_flag;
}

nomask void apply_hb_condition(string cnd, mixed info) {
  if (!mapp(hb_conditions)) {
    hb_conditions = ([ cnd: info ]);
  } else {
    hb_conditions[cnd] = info;
  }
}

nomask mixed query_hb_condition(string cnd) {
  if (!mapp(hb_conditions) || undefinedp(hb_conditions[cnd])) {
    return 0;
  }

  return hb_conditions[cnd];
}

nomask varargs void clear_hb_condition(string cnd) {
  mixed *thiscnd, err;
  int i;
  object cnd_d;

  if (!mapp(hb_conditions) || !(i = sizeof(hb_conditions))) {
    return;
  }

  if (cnd && undefinedp(hb_conditions[cnd])) {
    return;
  }

  if (cnd) {
    cnd_d = find_object(CONDITION_D(cnd));
    if (!cnd_d) {
      //使用 call_other(filename, "???")  或是在 ??? 处填入任意不存在的方法函式名称，则只会载入物件
      err = catch(call_other(CONDITION_D(cnd), "???"));

      cnd_d = find_object(CONDITION_D(cnd));

      if (err || !cnd_d) {
        log_file("condition.err", sprintf("Failed to load condition daemon %s, removed from %O\nError: %s\n",
          CONDITION_D(cnd), this_object(), err));
        if (mapp(hb_conditions)) {
          map_delete(hb_conditions, cnd);
        }
        cnd_d = 0;
      }
    }

    if (cnd_d) {
      call_other(cnd_d, "clear_condition", this_object(), hb_conditions[cnd]);
    }
  } else {
    thiscnd = keys(hb_conditions);
    while (i--) {
      cnd_d = find_object(CONDITION_D(thiscnd[i]));
      if (!cnd_d) {
        //使用 call_other(filename, "???")  或是在 ??? 处填入任意不存在的方法函式名称，则只会载入物件
        err = catch(call_other(CONDITION_D(thiscnd[i]), "???"));

        cnd_d = find_object(CONDITION_D(thiscnd[i]));

        if (err || !cnd_d) {
          log_file("condition.err", sprintf("Failed to load condition daemon %s, removed from %O\nError: %s\n",
            CONDITION_D(thiscnd[i]), this_object(), err));
          if (mapp(hb_conditions)) {
            map_delete(hb_conditions, thiscnd[i]);
          }

          continue;
        }
      }

      call_other(cnd_d, "clear_condition", this_object(), hb_conditions[thiscnd[i]]);
    }
  }

  if (!cnd) {
    hb_conditions = 0;
  } else if (mapp(hb_conditions)) {
    map_delete(hb_conditions, cnd);
  }
}
