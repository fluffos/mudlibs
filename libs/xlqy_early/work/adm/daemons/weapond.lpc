        if( objectp(weapon) && damage >0)
        {
            ap = me->query_skill("music",1);
            dp = victim->query_skill("literate",1);
            
        }
    */
}

void throw_weapon(object me, object victim, object weapon, int damage) {
  if (objectp(weapon)) {
    if ((int)weapon->query_amount() == 1) {
      weapon->unequip();
      tell_object(me, "\n你的" + weapon->query("name") + "用完了！\n\n");
    }
    weapon->add_amount(-1);
  }
}

void slash_weapon(object me, object victim, object weapon, int damage) {
  object ob;
  int wap, wdp;

  if (objectp(weapon) && damage == RESULT_PARRY && ob = victim->query_temp("weapon")) {
    ob = victim->query_temp("weapon");
    wap = weapon->query("weapon_prop/damage") + weapon->query("diablo_prop/damage") + (int)me->query("str");
    wdp = ob->query("weapon_prop/damage") + ob->query("diablo_prop/damage") + (int)victim->query("str");

    if ((wap / 2 + random(wap / 2)) > wdp) {
      break_equip(me, victim, ob);
    }
  }
}

void bash_weapon(object me, object victim, object weapon, int damage) {
  object ob;
  int wap, wdp;

  if (objectp(weapon)
    && damage == RESULT_PARRY
    && ob = victim->query_temp("weapon")) {
    wap = (int)weapon->weight() / 500 + (int)weapon->query("rigidity") + (int)me->query("str");
    wdp = (int)ob->weight() / 500 + (int)ob->query("rigidity") + (int)victim->query("str");
    wap = random(wap);

    if (wap > 2 * wdp) {
      break_equip(me, victim, ob);
    } else if (wap > wdp) {
      message_vision("$N只觉得手中" + ob->name() + "一震，险些脱手！\n",
        victim);
      //    ob->add("rigidity",-2-random(4));
      //    weapon->add("rigidity",-random(3));    
    } else if (wap > wdp / 2) {
      break_equip(me, victim, ob);
    } else {
      message_vision("$N的" + weapon->name() + "和$n的" + ob->name()
        + "相击，冒出点点的火星。\n", me, victim);
      //    ob->add("rigidity",-1-random(3));
      //    weapon->add("rigidity",-random(2));
    }
  }
}

void check_weapon(object who, object weapon) {
  if (weapon->is_diablo_ob()) {
    if (weapon->query("diablo_prop/rigidity") < 1) {
      message_vision("$N的" + weapon->name() + "不能再使用了！\n", who);
      weapon->unequip();

      who->reset_action();
    }
  } else if (weapon->query("rigidity") < 1) {
    break_equip(who, who, weapon);
  }
}

void check_armor(object who, object armor) {
  if (armor->is_diablo_ob()) {
    if (armor->query("diablo_prop/rigidity") < 1) {
      message_vision("$N的" + armor->name() + "已是千创百孔，无法再装备了！\n", who);
      armor->unequip();
    }
  } else if (armor->query("rigidity") < 1) {
    break_equip(who, who, armor);
  }
}

void break_equip(object me, object target, object obj) {
  if (!obj) {
    return;
  }

  if (obj->is_diablo_ob() || obj->is_ultimate_ob()) {
    message_perform(HIW "只见一道耀眼的光芒，$N身上的" + obj->name() + HIW "抵挡住了这一击！\n" NOR, target);
    return;
  }

  message_perform(HIW "只听见「啪」地一声，$N身上的" + obj->name() + HIW "已被一招击的粉碎！\n" NOR, target);

  obj->unequip();
  obj->set("no_get", 1);
  obj->set("value", 0);
  obj->set("name", "碎裂的" + obj->query("name"));
  obj->set("weapon_prop", 0);
  obj->set("armor_prop", 0);
  obj->move(environment(target));

  target->reset_action();

  call_out("remove_broken_cloth", random(30) + 30, obj);
}

void remove_broken_cloth(object obj) {
  if (obj && environment(obj)) {
    tell_object(environment(obj), "一阵微风吹过，" + obj->name() + "化为片片尘土，消失不见了。\n");
    destruct(obj);
  }
}
