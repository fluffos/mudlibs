#include <ansi.h>

private mapping flood_cfg = ([
  "perform": ([  //period秒内，最多接收max条该命令，数量记录在用户的flooding/count内，时间记录在flooding/time内
  "count": "attack_cmds",
    "max": 6,
    "period": 3,
    "time": "attack_time",
    "hits": 50,
  ]),
  "cast": ([
    "count": "attack_cmds",
    "max": 6,
    "period": 3,
    "time": "attack_time",
    "hits": 30,
  ]),
]);

void create() {}

int process_command(object me, string command) {
  mapping cmd_cfg;

  return 1;
  if (me->query("job/xunbao/asked") && !random(10)) {
    return 0;
  }

  if (!command || !me || (userp(me) && wizardp(me))) {
    return 1;
  }

  if (undefinedp(flood_cfg[command])) {
    return 1;
  }

  if (0 >= flood_cfg[command]["max"] && undefinedp(flood_cfg[command]["hits"])) {
    return 1;
  }

  if (!me->query_temp("flooding/" + flood_cfg[command]["count"])) {
    me->set_temp("flooding/" + flood_cfg[command]["count"], 1);
    me->set_temp("flooding/hits", 0);
    me->set_temp("flooding/have_prompt", 0);
    me->set_temp("flooding/" + flood_cfg[command]["time"], time());
    return 1;
  }

  if (me->query_temp("flooding/" + flood_cfg[command]["time"]) + flood_cfg[command]["period"] < time()) {
    me->set_temp("flooding/" + flood_cfg[command]["count"], 1);
    me->set_temp("flooding/hits", 0);
    me->set_temp("flooding/have_prompt", 0);
    me->set_temp("flooding/" + flood_cfg[command]["time"], time());
    return 1;
  }

  me->add_temp("flooding/" + flood_cfg[command]["count"], 1);

  if (0 < flood_cfg[command]["max"] && me->query_temp("flooding/" + flood_cfg[command]["count"]) > flood_cfg[command]["max"]) {
    if (!me->query_temp("flooding/have_prompt")) {
      me->set_temp("flooding/have_prompt", 1);
      tell_object(me, HIR "你连招" + command + "用的太多，对方已经产生戒备!\n" NOR);
    }
    return 0;
  }

  if (0 < flood_cfg[command]["hits"] && me->query_temp("flooding/hits") >= flood_cfg[command]["hits"]) {
    if (!me->query_temp("flooding/have_prompt")) {
      me->set_temp("flooding/have_prompt", 1);
      tell_object(me, HIR "你连续攻击太多，让对方喘息一下吧!\n" NOR);
    }
    return 0;
  }

  return 1;
}
