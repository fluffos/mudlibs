void create()
{
    seteuid(getuid());
    set("name", "技能等级精灵");
    set("id", "leveld");    

    setup_level();
}

int init_level_32(int level)
{
    return level * level * level * 1000;
}

int sub_level_exp_32(int level)
{
    if ( 100 > level )
    {
        return 0;
    }

    return init_level_32(100) / 10 * 9;
}

