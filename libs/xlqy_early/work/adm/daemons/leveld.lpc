private void setup_level()
{
    int maxgrade;
    int i, j;

    system_call((: call_other, __FILE__, "config_level_64" :), 
        (: call_other, __FILE__, "config_level_32" :));

    levelup_need[0] = ([
        "exp":  0,
        "dx":   0,
        "resv_exp": 0,
        "resv_dx":  0,
        "skills_lvl":   0,
        "reward_exp_per_job":   0,
        "reward_dx_per_job":    0,
        "reward_qn_per_job":    0,
        "upgrade_time": 0,
        "skills_init":  0,
    ]);

    maxgrade = sizeof(levelup_cfg);

    for ( j = 0; j < maxgrade; j ++ )
    {
        for ( i = levelup_cfg[j]["min_level"]; i <= levelup_cfg[j]["max_level"]; i++ )
        {
            max_level++;
            levelup_need[i] = ([]);

            //计算级别i升级所需要的exp和dx
            if ( functionp(levelup_cfg[j]["exp_per_lvl"]) )
            {
                levelup_need[i]["exp"] = evaluate(levelup_cfg[j]["exp_per_lvl"], i);
            }
            else if ( intp(levelup_cfg[j]["exp_per_lvl"]) )
            {
                levelup_need[i]["exp"] = levelup_need[i - 1]["resv_exp"] + levelup_cfg[j]["exp_per_lvl"]
                    + levelup_cfg[j]["exp_per_lvl"] / 10000 * (i - levelup_cfg[j]["min_level"] + 1) * levelup_cfg[j]["added_req_per_lvl"]
                    + levelup_cfg[j]["exp_per_lvl"] / 10000 * (int)((i - levelup_cfg[j]["min_level"] + 1) / levelup_cfg[j]["lvl_per_reborn"]) * levelup_cfg[j]["added_req_per_reborn"];
            }
            else
            {
                error("leveld invalid config exp_per_lvl.\n");
                continue;
            }

            levelup_need[i]["dx"] = levelup_need[i]["exp"];

            //计算级别i升级后所剩下的exp和dx
            if ( functionp(levelup_cfg[j]["sub_per_lvl"]) )
            {
                levelup_need[i]["resv_exp"] = levelup_need[i]["exp"] - evaluate(levelup_cfg[j]["sub_per_lvl"], i);
            }
            else if ( intp(levelup_cfg[j]["sub_per_lvl"]) )
            {
                levelup_need[i]["resv_exp"] = levelup_need[i]["exp"] - (levelup_need[i]["exp"] - levelup_need[i - 1]["resv_exp"]) / 10000 * levelup_cfg[j]["sub_per_lvl"];
            }
            else
            {
                error("leveld invalid config sub_per_lvl.\n");
                continue;
            }

            if ( (0 < levelup_cfg[j]["lvl_per_reborn"]) && (0 == i % levelup_cfg[j]["lvl_per_reborn"]) )
            {
                if ( functionp(levelup_cfg[j]["sub_per_reborn"]) )
                {
                    levelup_need[i]["resv_exp"] -= levelup_need[i]["exp"] - evaluate(levelup_cfg[j]["sub_per_reborn"], i);
                }
                else if ( intp(levelup_cfg[j]["sub_per_reborn"]) )
                {
                    levelup_need[i]["resv_exp"] -= (levelup_need[i]["exp"] - levelup_need[i - 1]["resv_exp"]) / 10000 * levelup_cfg[j]["sub_per_reborn"];
                }
                else
                {
                    error("leveld invalid config sub_per_reborn.\n");
                    continue;
                }
            }

            levelup_need[i]["resv_dx"] = levelup_need[i]["resv_exp"];

            //计算级别i转世所需要的技能等级
            if ( 0 == levelup_cfg[j]["lvl_per_reborn"] )
            {
                levelup_need[i]["skills_lvl"] = 1000;
                levelup_need[i]["skills_init"] = 0;
            }
            else if ( 0 == (i - 1) % levelup_cfg[j]["lvl_per_reborn"] )
            {
                levelup_need[i]["skills_lvl"] = levelup_need[i - 1]["skills_lvl"] + levelup_cfg[j]["skills_add_per_reborn"];
                levelup_need[i]["skills_init"] = levelup_need[i - 1]["skills_lvl"];
            }
            else
            {
                levelup_need[i]["skills_lvl"] = levelup_need[i - 1]["skills_lvl"];
                levelup_need[i]["skills_init"] = levelup_need[i - 1]["skills_init"];
            }

            //计算级别i每个任务的基本奖励exp和dx
            if ( 0 == levelup_cfg[j]["lvl_per_reborn"] )
            {
                levelup_need[i]["reward_exp_per_job"] = 0;
            }
            else
            {
                levelup_need[i]["reward_exp_per_job"] = levelup_cfg[j]["basic_reward_exp"] 
                    + levelup_cfg[j]["basic_reward_exp"] / 10000 * (i - levelup_cfg[j]["min_level"] + 1) * levelup_cfg[j]["added_reward_exp_per_lvl"]
                    + levelup_cfg[j]["basic_reward_exp"] / 10000 * (int)((i - levelup_cfg[j]["min_level"] + 1) / levelup_cfg[j]["lvl_per_reborn"]) * levelup_cfg[j]["added_reward_exp_per_reborn"];
            }

            levelup_need[i]["reward_dx_per_job"] = levelup_need[i]["reward_exp_per_job"];

            //计算级别i的升级时间
            if ( 0 == levelup_need[i]["reward_exp_per_job"] || 0 == levelup_cfg[j]["jobs_per_hour"] )
            {
                levelup_need[i]["upgrade_time"] = 0;
            }
            else
            {
                levelup_need[i]["upgrade_time"] = (levelup_need[i]["exp"] - levelup_need[i - 1]["resv_exp"]) / levelup_need[i]["reward_exp_per_job"] / levelup_cfg[j]["jobs_per_hour"];
            }

            //计算级别i每个任务的基本奖励qn
            if ( 0 == levelup_need[i]["upgrade_time"] || 0 == levelup_cfg[j]["jobs_per_hour"] )
            {
                levelup_need[i]["reward_qn_per_job"] = 0;
            }
            else
            {
                levelup_need[i]["reward_qn_per_job"] = 
                    levelup_cfg[j]["skills_add_per_reborn"] / levelup_cfg[j]["lvl_per_reborn"] * levelup_cfg[j]["pot_per_skill"] * levelup_cfg[j]["skills_need"]
                    / levelup_need[i]["upgrade_time"] / levelup_cfg[j]["jobs_per_hour"];
            }
        }
    }

    maxgrade = sizeof(levelup_cfg);
    for ( i = 0, j = 0; j < maxgrade; i++, j++ )
    {
        potential_cfg[i] = ([]);
        if ( 0 == levelup_cfg[j]["lvl_per_reborn"] )
        {
            potential_cfg[i]["min_skill"] = 0;
            potential_cfg[i]["max_skill"] = 1000;
            potential_cfg[i]["pot_per_skill"] = 0;
        }
        else
        {
            potential_cfg[i]["min_skill"] = potential_cfg[i - 1]["max_skill"] + 1;
            potential_cfg[i]["max_skill"] = potential_cfg[i - 1]["max_skill"]
                + (levelup_cfg[j]["max_level"] + 1 - levelup_cfg[j]["min_level"]) / levelup_cfg[j]["lvl_per_reborn"] * levelup_cfg[j]["skills_add_per_reborn"];
            potential_cfg[i]["pot_per_skill"] = levelup_cfg[j]["pot_per_skill"];
        }
    }
}

mapping query_potential_cfg()
{
    return potential_cfg;
}

int query_skill_need_pot(int level)
{
    int i, count;

    count = sizeof(potential_cfg);

    for ( i = 0; i < count; i++ )
    {
        if ( level >= potential_cfg[i]["min_skill"]
            && level <= potential_cfg[i]["max_skill"] )
        {
            return potential_cfg[i]["pot_per_skill"];
        }
    }

    return system_maxpotential();
}

int query_level_max()
{
    return max_level;
}

int query_level_need_exp(int level)
{
    //升级到level所需要的exp
    return 0 <= level && level <= max_level ? levelup_need[level]["exp"] : 0;
}

int query_level_resv_exp(int level)
{
    //升级到level后所剩下的exp
    return 0 <= level && level <= max_level ? levelup_need[level]["resv_exp"] : 0;
}

int query_level_need_dx(int level)
{
    //升级到level所需要的dx
    return 0 <= level && level <= max_level ? levelup_need[level]["dx"] : 0;
}

int query_level_resv_dx(int level)
{
    //升级到level后所剩下的dx
    return 0 <= level && level <= max_level ? levelup_need[level]["resv_dx"] : 0;
}

int query_level_init_skill(int level)
{
    //进入本转时的初始skill等级
    return 0 <= level && level <= max_level ? levelup_need[level]["skills_init"] : 0;
}

int query_level_need_skill(int level)
{
    //level级时，转世所需要的skill等级
    return 0 <= level && level <= max_level ? levelup_need[level]["skills_lvl"] : 0;
}

int query_max_skills()
{
    return query_level_need_skill(query_level_max());
}

int query_level_jobreward_exp(int level)
{
    //level级时，每个任务的平均奖励exp
    return 0 <= level && level <= max_level ? levelup_need[level]["reward_exp_per_job"] : 0;
}

int query_level_jobreward_dx(int level)
{
    //level级时，每个任务的平均奖励dx
    return 0 <= level && level <= max_level ? levelup_need[level]["reward_dx_per_job"] : 0;
}

int query_level_jobreward_qn(int level)
{
    //level级时，每个任务的平均奖励qn
    return 0 <= level && level <= max_level ? levelup_need[level]["reward_qn_per_job"] : 0;
}

int query_level_upgrade_time(int level)
{
    //级别level的升级时间
    return 0 <= level && level <= max_level ? levelup_need[level]["upgrade_time"] : 0;
}

//是否给予属性点数和技能点数
int query_ob_add_skpoint(int lv)  
{
    return lv;
}

int query_ob_add_attpoint(int lv)  
{
    return lv;
}

int query_ob_upgrade_gold(int lv)
{
    int gold;

    lv = lv + 1;

    gold = lv + lv * lv / 4;

    return gold;
}

int query_ob_upgrade_level(object ob) //判断user是否够升级条件.
{
    int level, ob_dx, ob_exp;
    int dx, exp, gold;

    if ( !living(ob) )
    {
        return 0;
    }

    level = ob->query("level");    
    ob_dx = ob->query("daoxing");
    ob_exp = ob->query("combat_exp");

    exp = query_level_need_exp(level + 1);
    dx = query_level_need_dx(level + 1);

    if ( ob_dx < dx )
    {
        tell_object(ob, "你的道行不够，需要达到" + COMBAT_D->chinese_daoxing(dx) + "!\n");
        return 0;
    }

    if ( ob_exp < exp ) 
    {
        tell_object(ob, "你的经验值不够，需要达到" + exp + "点经验值才能升到下一级！\n");
        return 0;
    }

    gold = query_ob_upgrade_gold(level);
    gold = MONEY_D->gold_to_coin(gold);
    if ( ob->query_balance() < gold )
    {
        tell_object(ob, "你的存款不够,需要" + MONEY_D->money_str(gold) + "！\n");
        return 0;    
    }

    return 1;
}

string query_ob_skill_level(object me, string skill_type) //得到character skill_type技能的等级。
{
    if ( !me )
    {
        return 0;
    }

    if ( member_array(skill_type, all_basic_skills) == -1 )
    {
        return "不存在此基本技能或这个技能目前没有等级之分！\n";
    }

    return me->query("skill_level/" + skill_type);
}

string query_max_skill_level()
{
    return "greatmaster";
}

string set_ob_skill_level(object me, string skill_type, string level)
{
    if ( !me )
    {
        return 0;
    }

    if ( member_array(skill_type, all_basic_skills) == -1 )
    {
        return "不存在此基本技能或这个技能目前没有等级之分！\n";
    }

    return me->set("skill_level/" + skill_type, level);
}

int check_skill_for_level(object who, string skill, string level)
{
    int index = 0;

    if ( undefinedp(all_levels[level]) || member_array(skill, all_basic_skills) == -1 )
    {
        return 0;
    }

    index = (int)all_levels[level]["index"];

    if ( 0 == index )
    {
        return 1;
    }

    if ( 1 == index )
    {
        if ( who->query_skill(skill, 1) < query_level_need_skill(50) )
        {
            write("" + query_level_need_skill(50) + "\n");
            return 0;
        }
        else
        {
            return 1;
        }
    }

    if ( who->query_skill(skill, 1) < query_level_need_skill(50 + (index - 1) * 100) )
    {
        write("" + query_level_need_skill(50 + (index - 1) * 100) + "\n");
        return 0;
    }

    return 1;
}

int check_ob_for_level(object who, string level)
{
    int count;
    int index = 0;

    if ( undefinedp(all_levels[level]) )
    {
        return 0;
    }

    index = (int)all_levels[level]["index"];

    count = who->query("betray/count");

    if ( 2 > index )
    {
        return 1;
    }

    if ( (int)who->query("faith") < 5000 * index )
    {
        return 0;
    }

    if ( (int)who->query("weiwang") < 5000 * index )
    {
        return 0;
    }

    return 1;
}

int query_level_index(string level)
{
    if ( undefinedp(all_levels[level]) )
    {
        return 0;
    }

    return all_levels[level]["index"];
}

int query_max_level_index()
{
    return 10;
}

string query_level_name(string level)
{
    if ( undefinedp(all_levels[level]) )
    {
        return "";
    }

    return all_levels[level]["name"];
}

string query_level_name_color(string level)
{
    if ( undefinedp(all_levels[level]) )
    {
        return NOR"      "NOR;
    }

    if ( 2 > all_levels[level]["index"] )
    {
        return HIY"(" + all_levels[level]["name"] + ")"NOR;
    }

    if ( 5 > all_levels[level]["index"] )
    {
        return HIM"(" + all_levels[level]["name"] + ")"NOR;
    }

    return HIW"(" + all_levels[level]["name"] + ")"NOR;
}

void expell_ob_level_penalty(object who) //判师惩罚，扣一级
{
    mapping level;
    string *skill, *levels, item;
    int index;

    if ( !mapp(level = who->query("skill_level")) )
    {
        return;
    }

    skill = keys(level);

    for ( int i = 0; i < sizeof(skill); i++ )
    {
        item = level[skill[i]];

        if ( undefinedp(all_levels[level]) || 0 == (index = (int)all_levels[item]["index"]) )
        {
            who->delete("skill_level/" + skill[i]);
            continue;
        }

        index--;

        levels = keys(all_levels);
        for ( int j = 0; j < sizeof(all_levels); j++ )
        {
            if ( index == (int)all_levels[levels[j]]["index"] )
            {
                who->set("skill_level/" + skill[i], levels[j]);
                break;
            }
        }
    }
}

int query_skill_level(object ob, string skill, int level)
{
    int index = query_level_index(ob->query("skill_level/" + skill));

    if ( 0 > index )
    {
        index = 0;
    }

    return level * (10 + index) / 20;
}

int if_basicskill(string skill)
{
    return (-1 != member_array(skill, all_basic_skills));
}

string *query_basicskill()
{
    return all_basic_skills;
}

int can_apprentice(object me)
{
    return (100 <= me->query("level"));
}

varargs int player_levelup(object me, int force)
{
    int level, gold, att, skill;

    level = me->query("level");

    if ( query_ob_upgrade_level(me) )
    {
        if ( !force )
        {
            gold = query_ob_upgrade_gold(level + 1);
            gold = gold * 10000;
        }

        att = query_ob_add_attpoint(level + 1);
        skill  = query_ob_add_skpoint(level + 1);

        tell_object(me, HIR"你已升到" + HIW + to_chinese(level + 1) + NOR + HIR"级，你的属性点数增加了" + MAG + to_chinese(att) + NOR + HIR"点，你的技能点数增加了" + MAG + to_chinese(skill) + NOR + HIR"点！\n"NOR);

        if ( !force )
        {
            me->add_coin(-gold);
        }

        me->add("level", 1);
        level = me->query("level");

        me->add("combat_exp", -(query_level_need_exp(level) - query_level_resv_exp(level)));
        me->add("daoxing", -(query_level_need_dx(level) - query_level_resv_dx(level)));

        me->add("attribute_point", att);
        me->add("skills_point", skill);

        me->set("xiuxian_title", XIUXIAN_D->query_xiuxian_title(me));

        me->save();

        return 1;
    }
    else
    {
        tell_object(me, HIY"你升级的条件不够，请用(levelcost 等级)查看升级条件！\n"NOR);
    }

    return 1;
}

int levelup_cost(object me, string arg)
{
    int level, exp, gold, dx;

    if ( !arg )
    {
        tell_object(me, HIY"请输入一个数字!\n"NOR);
        return 1;
    }

    sscanf(arg, "%d", level);

    if ( query_level_max() < level )
    {
        return 1;
    }

    if ( 0 < level )
    {
        gold = query_ob_upgrade_gold(level);
        gold = gold * 10000;
        exp = query_level_need_exp(level);
        dx = query_level_need_dx(level);

        tell_object(me, HIY"升级到" + HIC + to_chinese(level) + NOR + HIY"级，需要经验值达到"
            + HIC + exp + NOR + HIY"，需要道行达到" + HIC + COMBAT_D->chinese_daoxing(dx) + NOR 
            + HIY"，需要缴纳存款" + HIC + MONEY_D->money_str(gold) + "!\n"NOR);
    }

    return 1;
}

