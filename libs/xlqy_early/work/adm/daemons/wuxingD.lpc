/*
金，主攻则破甲，主防则反伤，且金系功法大开大合输出较高，但出招频率会降低
木，主攻则夺人生气，主防则回生，且木系功法易困人，但自身灵动也略逊
水，主攻则闭气，主防则降对方出招数量，且水系功法分散伤害效果显著，但伤害输出略逊
火，主攻则增加招式威力和出招频率，主防则增加格挡和躲闪频率，且火系功法能够持续召唤天火刑罚，但先天防御不足
土，主攻则短时封魔，主防则减伤，且土系功法输出也较高，但自身躲闪不足
*/

#include <ansi.h>
#include <wuxing.h>

#define WUXING_RESTRAIN     "restrain"      //克制这些五行
#define WUXING_ASSIST       "assist"        //相生这些五行
#define WUXING_RESTRAINED   "restrained"    //被这些五行克制
#define WUXING_ASSISTED     "assisted"      //被这些五行相生

//五行生克关系
private mapping WUXING_RELATION = ([
  WUXING_JIN: ([
    "name": "金",
    WUXING_RESTRAIN: WUXING_MU,  //克制这些五行
    WUXING_ASSIST: WUXING_SHUI,  //相生这些五行
    WUXING_RESTRAINED: WUXING_HUO,  //被这些五行克制
    WUXING_ASSISTED: WUXING_TU,  //被这些五行相生
  ]),
  WUXING_MU: ([
    "name": "木",
    WUXING_RESTRAIN: WUXING_TU,  //克制这些五行
    WUXING_ASSIST: WUXING_HUO,  //相生这些五行
    WUXING_RESTRAINED: WUXING_JIN,  //被这些五行克制
    WUXING_ASSISTED: WUXING_SHUI,  //被这些五行相生
  ]),
  WUXING_SHUI: ([
    "name": "水",
    WUXING_RESTRAIN: WUXING_HUO,  //克制这些五行
    WUXING_ASSIST: WUXING_MU,  //相生这些五行
    WUXING_RESTRAINED: WUXING_TU,  //被这些五行克制
    WUXING_ASSISTED: WUXING_JIN,  //被这些五行相生
  ]),
  WUXING_HUO: ([
    "name": "火",
    WUXING_RESTRAIN: WUXING_JIN,  //克制这些五行
    WUXING_ASSIST: WUXING_TU,  //相生这些五行
    WUXING_RESTRAINED: WUXING_SHUI,  //被这些五行克制
    WUXING_ASSISTED: WUXING_MU,  //被这些五行相生
  ]),
  WUXING_TU: ([
    "name": "土",
    WUXING_RESTRAIN: WUXING_SHUI,  //克制这些五行
    WUXING_ASSIST: WUXING_JIN,  //相生这些五行
    WUXING_RESTRAINED: WUXING_MU,  //被这些五行克制
    WUXING_ASSISTED: WUXING_HUO,  //被这些五行相生
  ]),
  WUXING_NONE: ([
    "name": "无",
    WUXING_RESTRAIN: 0,  //克制这些五行
    WUXING_ASSIST: 0,  //相生这些五行
    WUXING_RESTRAINED: 0,  //被这些五行克制
    WUXING_ASSISTED: 0,  //被这些五行相生
  ]),
  WUXING_ALL: ([
    "name": "五行",
    WUXING_RESTRAIN: 0,  //克制这些五行
    WUXING_ASSIST: 0,  //相生这些五行
    WUXING_RESTRAINED: 0,  //被这些五行克制
    WUXING_ASSISTED: 0,  //被这些五行相生
  ]),
]);

mixed random_wuxing() {
  mixed *all_wuxing = keys(WUXING_RELATION);

  return all_wuxing[random(sizeof(all_wuxing))];
}

string wuxing_name(string wuxing) {
  if (!wuxing || undefinedp(WUXING_RELATION[wuxing])) {
    return "无";
  }

  return WUXING_RELATION[wuxing]["name"];
}

varargs int query_total_damage(object ob, object victim, int init_damage, string type, string kind)  // ob is attacker,vic is be atked
{
  return init_damage;
}
