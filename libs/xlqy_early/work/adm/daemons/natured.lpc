// This is called everyday noon by update_day_phase, defined in the
// "event_fun" field in /adm/etc/nature/day_phase

int online_user()
{
    int i, ppl_cnt, count;
    object *usr = users();

    count = sizeof(usr);
    for ( i = 0; i < count; i++ )
    {
        if ( !environment(usr[i]) )
        {
            continue;
        }
        ppl_cnt++;
    }

    return ppl_cnt;
}

