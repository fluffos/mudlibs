            && objectp(badguy = new("/quest/feizei/feizei")) )
        {
            badguy->move(room);
        }
        message("channel:chat", HIW"【大唐告示】"HIY + "祭赛国"HIR + "今夜有飞贼横行，良民百姓请闭门不出，切莫自误！\n"NOR, users() );
    }

    if ( random(12) == 10 )
    {
        if ( objectp(room = load_object("/d/qujing/wuji/nstreet")) 
            && objectp(badguy = new("/quest/feizei/feizei")) )
        {
            badguy->move(room);
        }
        message("channel:chat", HIW"【大唐告示】"HIY + "乌鸡国"HIR + "今夜有飞贼横行，良民百姓请闭门不出，切莫自误！\n"NOR, users() );
    }

    if ( random(12) == 11 )
    {
        if ( objectp(room = load_object("/d/qujing/tianzhu/maodian")) 
            && objectp(badguy = new("/quest/feizei/feizei")) )
        {
            badguy->move(room);
        }
        message("channel:chat", HIW"【大唐告示】"HIY + "天竺"HIR + "今夜有飞贼横行，良民百姓请闭门不出，切莫自误！\n"NOR, users() );
    }

    if ( random(12) == 0 )
    {
        if ( objectp(room = load_object("/d/qujing/yuhua/dayuan")) 
            && objectp(badguy = new("/quest/feizei/feizei")) )
        {
            badguy->move(room);
        }
        message("channel:chat", HIW"【大唐告示】"HIY + "玉华县"HIR + "今夜有飞贼横行，良民百姓请闭门不出，切莫自误！\n"NOR, users() );
    }
}

void event_afternoon()
{
    object *ob_list;
    int i, count;

    ob_list = children("/quest/feizei/yaoguai");

    count = sizeof(ob_list);
    for ( i = 0; i < count; i++ )
    {
        if(environment(ob_list[i]))
        {
            message_vision("$N说道：今天吃了不少鲜活人肉,我闪！\n", ob_list[i]);
            destruct(ob_list[i]);
        }
    }
}

void event_dawn()
{
    object *ob_list;
    int i, count;
    int money, ok;

    ob_list = children("/quest/feizei/feizei");

    count = sizeof(ob_list);
    for ( i = 0; i < count; i++ )
    {
        if ( environment(ob_list[i]) )
        {
            message_vision("$N笑道：天亮了，东西也到手了，我闪！\n", ob_list[i]);
            destruct(ob_list[i]);
        }
    }
                
    money = 10 + random(90);
    ok="/adm/daemons/money"->move_money(money);
}

void event_noon()
{
    object *ob;
    int i, skill, count;

    ob = users();

    count = sizeof(ob);
    for ( i = 0; i < count; i++ )
    {
        if ( !environment(ob[i]) )
        {
            continue;
        }

        if ( !environment(ob[i])->query("outdoors") )
        {
            continue;
        }

        if ( !ob[i]->query("mana") )
        {
            continue;
        }

        if ( !(skill = ob[i]->query_skill("spells", 1) ) )
        {
            tell_object(ob[i], "你觉得一阵晕眩，好像有一股能量从身上被人吸走了。\n");
            ob[i]->set("mana", 0);
            ob[i]->receive_damage("sen", 0);
        }
        else if ( skill < 36 )
        {
            tell_object(ob[i], "随着太阳升到天空的正中央，你觉得你的法力开始消失了。\n");
            ob[i]->set("mana", (int)ob[i]->query("mana") * skill / 36 );
        }
    }
}

string outdoor_room_description()
{
    return "    " + sprintf(day_phase[current_day_phase]["desc_msg"], month_desc[current_month]) + "。\n";
}

string game_time()
{
    return CHINESE_D->chinese_date(TIME_TICK1);
}

int game_hour_time()
{
    mixed *local;

    local = localtime(time() * 60);

    return local[2];
}

int game_month_time()
{
    mixed *local;

    local = localtime(time() * 60);

    return local[4];
}

mapping *read_table(string file)
{
    string *line, *field, *format;
    mapping *data;
    int i, rn, fn, count;

    line = explode(read_file(file), "\n");
    data = ({});

    count = sizeof(line);
    for ( i = 0; i < count; i++ )
    {
        if ( line[i] == "" || line[i][0] == '#' )
        {
            continue;
        }

        if ( !pointerp(field) )
        {
            field = explode( line[i], ":" );
            continue;
        }

        if ( !pointerp(format) )
        {
            format = explode( line[i], ":" );
            continue;
        }

        break;
    }

    count = sizeof(line);
    for ( rn = 0, fn = 0; i < count; i++)
    {
        if ( line[i] == "" || line[i][0] == '#' )
        {
            continue;
        }

        if ( !fn )
        {
            data += ({ allocate_mapping(sizeof(field)) });
        }

        sscanf( line[i], format[fn], data[rn][field[fn]] );

        fn = (++fn) % sizeof(field);

        if ( !fn )
        {
            ++rn;
        }
    }

    return data;
}

mapping *query_day_phase() { return day_phase; }

//////////////////////////////////////////////////////////////////////////////
//Checking Section .
//bugbug,2002-3-12
/////////////////////////////////////////////////////////////////////////////
int check_player(object player)
{
    do_check_player_1(player);
    do_check_player_2(player);
    return 1;
}

int do_check_player_1(object me)
{
    object* inv;
    int living_time;

    inv = all_inventory(me);

    foreach ( object temp in inv )
    {
        if ( temp->query_unique() && !temp->query("series_no")
            && !temp->query("last_appear") )
        {
            temp->set("last_appear", time());
        }

        living_time = 13400;
        if ( temp->query("living_time") )
        {
            living_time = (int)temp->query("living_time");
        }

        if ( temp->query_unique() && !temp->query("series_no")//非自造法宝。 
            && temp->query("last_appear") + living_time < time() )
        {
            call_out("bug_self_dest", 1, temp, me);
        }
    }

    return 1;
}

int do_check_player_2(object me)
{
    if ( wizardp(me) )
    {
        return 1;
    }

    if ( me->query_temp("apply/damage")  > 2400 
        || me->query_temp("apply/attack")  > 1600
        || me->query_temp("apply/defense") > 1600
        || me->query_temp("apply/armor")   > 6000 
        )
    {
        //me->move("/d/wiz/punish");
        //tell_object(me, "你可能使用了攻防bug,请和巫师联系！否则后果自负\n");
    }
}

void bug_self_dest(object ob,object me)
{
    tell_object(me, ob->query("name") + "消失了！\n" );

    if ( ob->query("equipped") )
    {
        ob->unequip();
    }

    ob->move("/cmds/std/quitroom");
    destruct(ob);
}
