void create() {
  seteuid(getuid());

  /*if ( !restore() && !mapp(family) )
    {
        family = ([]);
    }*/

  set("name", "鸿蒙尊者");
  set("id", "familyd");

  generate_effect();
}

string query_family_path(string family) {
  if (!family || undefinedp(ALL_FAMILYS[family])) {
    string *all_fam = keys(ALL_FAMILYS);

    family = all_fam[random(sizeof(all_fam))];
  }

  return ALL_FAMILYS[family]["name"];
}

mapping job_master(string my_fam) {
  if (!my_fam || undefinedp(ALL_FAMILYS[my_fam])) {
    string *all_fam = keys(ALL_FAMILYS);

    my_fam = all_fam[random(sizeof(all_fam))];
  }

  return ALL_FAMILYS[my_fam];
}

int remove() {
  //save();
  return 1;
}

int family_relation(string your_fam, string my_fam) {
  if (!my_fam || undefinedp(ALL_FAMILYS[my_fam])) {
    string *all_fam = keys(ALL_FAMILYS);

    my_fam = all_fam[random(sizeof(all_fam))];
  }

  if (!your_fam || undefinedp(ALL_FAMILYS[your_fam])) {
    string *all_fam = keys(ALL_FAMILYS);

    your_fam = all_fam[random(sizeof(all_fam))];
  }

  return ALL_FAMILYS[your_fam] * ALL_FAMILYS[my_fam];
}

int family_type(string my_fam) {
  if (!my_fam || undefinedp(ALL_FAMILYS[my_fam])) {
    string *all_fam = keys(ALL_FAMILYS);

    my_fam = all_fam[random(sizeof(all_fam))];
  }

  return ALL_FAMILYS[my_fam]["type"];
}

string query_save_file() {
  return DATA_DIR + "familyd";
}

int set_relation(string my_fam, mapping relation) {
  if (!my_fam || undefinedp(ALL_FAMILYS[my_fam])) {
    string *all_fam = keys(ALL_FAMILYS);

    my_fam = all_fam[random(sizeof(all_fam))];
  }

  family[my_fam] = relation;
  //save();
  return 1;
}

int add_family_enemy(string my_fam, string name, int score) {
  if (undefinedp(family[my_fam])) {
    family[my_fam] = ([ name: score ]);
  }

  if (!undefinedp(family[my_fam][name])) {
    family[my_fam][name] += score;
  } else {
    family[my_fam] += ([ name: score ]);
  }

  //save();
  return 1;
}

int remove_family_enemy(string my_fam, string name) {
  if (undefinedp(family[my_fam])) {
    return 0;
  } else if (!undefinedp(family[my_fam][name])) {
    map_delete(family[my_fam], name);
    //save();
    return 1;
  } else {
    return 0;
  }
}

int is_family_enemy(string my_fam, string name) {
  if (undefinedp(family[my_fam])) {
    return 0;
  } else if (!undefinedp(family[my_fam][name]) && family[my_fam][name] > 100) {
    return 1;
  } else {
    return 0;
  }
}

int query_enemy_quantity(string my_fam, string name) {
  if (undefinedp(family[my_fam])) {
    return 0;
  } else if (!undefinedp(family[my_fam][name])) {
    return family[my_fam][name];
  } else {
    return 0;
  }
}

mapping query_relation(string my_fam) {
  if (!undefinedp(family[my_fam])) {
    return family[my_fam];
  } else {
    return ([]);
  }
}

int deal_family_relation(object victim, object killer) {
  mapping my_family, your_family;

  int c_score, y_relation, m_relation;
  string my_fam, your_fam, my_id, your_id, declare;

  string *sname;
  int i;

  your_id = killer->query("id");

  if (your_family = killer->query("family")) {
    your_fam = your_family["family_name"];
    my_id = victim->query("id");

    if (!undefinedp(family[your_fam]) &&
      !undefinedp(family[your_fam][my_id])) {
      killer->add("daoxing", (victim->query("daoxing") / 100));
      declare = sprintf("%s杀死本门仇敌%s，真乃大快人心。\n",
        killer->name(1), victim->name(1));
      message("channel:chat", GRN + ALL_FAMILYS[your_fam]["annoucer"] + declare + NOR, users());
      map_delete(family[your_fam], my_id);
      return 1;
    }

    if (my_family = victim->query("family")) {
      my_fam = my_family["family_name"];
      c_score = victim->query("faith");

      if (my_fam == your_fam) {
        killer->add("daoxing", -(victim->query("daoxing") / 100));
        if (c_score > 30) {
          declare = sprintf("%s不可再屠戮本门师兄弟，切不可窝里反！。\n", killer->name(1));
          message("channel:chat", GRN + ALL_FAMILYS[your_fam]["annoucer"] + declare + NOR, users());
        }
        return 1;
      } else {
        if (userp(killer)) {
          add_family_enemy(my_fam, your_id, c_score);
        }

        if (y_relation = family_relation(your_fam, my_fam)) {
          if (y_relation == FAMILY_ENEMY) {
            killer->add("daoxing", (victim->query("daoxing") / 100));
            killer->add("relation/" + my_fam, c_score / 100);
            sname = keys(ALL_FAMILYS);
            if (c_score > 30) {
              declare = sprintf("%s杀死了本门对头%s的%s，功德无量也！\n",
                killer->name(1), my_fam, victim->name(1));
              message(
                "channel:chat",
                GRN + ALL_FAMILYS[your_fam]["annoucer"] + declare + NOR,
                users()
              );
            }
          } else if (y_relation == FAMILY_FRIEND) {
            killer->add("daoxing", (victim->query("daoxing") / 100));
            killer->add("relation/" + my_fam, -c_score / 100);
            if (c_score > 30) {
              declare = sprintf("本门弟子应该与%s的弟子和睦相处，不应互相杀戮。\n",
                my_fam);
              message(
                "channel:chat",
                GRN + ALL_FAMILYS[your_fam]["annoucer"] + declare + NOR,
                users()
              );
            }
          }
        }
        if (m_relation = family_relation(my_fam, your_fam)) {
          if (m_relation == FAMILY_ENEMY) {
            declare = sprintf("本门与%s势不两立，弟子们要切记仇恨啊！\n",
              your_fam);
          } else {
            declare = sprintf("本门%s被%s的%s杀死了，同门弟子皆应以报仇为己任！\n",
              victim->name(1), your_fam, killer->name(1));
          }

          message("channel:chat", GRN + ALL_FAMILYS[your_fam]["annoucer"] + declare + NOR, users());
        }
        return 1;
      }
    } else {
      return 0;
    }
  } else if (my_family = victim->query("family")) {
    my_fam = my_family["family_name"];
    c_score = victim->query("faith");

    if (userp(killer)) {
      add_family_enemy(my_fam, your_id, c_score);
    }
    killer->add("relation/" + my_fam, c_score / 100);
    declare = sprintf("本门弟子被%s杀死了。\n", killer->name(1));
    message("channel:chat", GRN + ALL_FAMILYS[your_fam]["annoucer"] + declare + NOR, users());
    return 1;
  } else {
    return 0;
  }
}

void clear_all_family_relation(string id) {
  int i;
  string *familys = keys(ALL_FAMILYS);
  int count = sizeof(familys);

  for (i = 0; i < count; i++) {
    if (undefinedp(family[familys[i]]) ||
      undefinedp(family[familys[i]][id])) {
      continue;
    }
    map_delete(family[familys[i]], id);
  }
}

//根据门派，增加状态，如加血、加内力等效果
void family_status_effect(object ob) {
  mapping all_effect;
  string *effect_keys;
  string *effect_type;
  int i, j;
  int count;
  int count2;

  if (!ob || !ob->query_family()) {
    return;
  }

  if (undefinedp(ALL_FAMILYS[ob->query_family()])) {
    return;
  }

  all_effect = (__DIR__ "family/" + query_family_path(ob->query_family()))->query_status_effect(ob);
  if (!all_effect) {
    return;
  }

  effect_type = keys(all_effect);
  count = sizeof(effect_type);
  for (j = 0; j < count; j++) {
    effect_keys = keys(all_effect[effect_type[j]]);
    count2 = sizeof(effect_keys);
    if ("dbase" == effect_type[j]) {
      for (i = 0; i < count2; i++) {
        if (intp(all_effect[effect_type[j]][effect_keys[i]])) {
          //write("add " + effect_keys[i] + " " + all_effect[effect_type[j]][effect_keys[i]] + "\n");
          ob->add(effect_keys[i], all_effect[effect_type[j]][effect_keys[i]]);
        } else if (stringp(all_effect[effect_type[j]][effect_keys[i]])) {
          ob->set(effect_keys[i], all_effect[effect_type[j]][effect_keys[i]]);
        }
      }
    } else if ("temp" == effect_type[j]) {
      for (i = 0; i < count2; i++) {
        if (intp(all_effect[effect_type[j]][effect_keys[i]])) {
          //write("addtemp " + effect_keys[i] + " " + all_effect[effect_type[j]][effect_keys[i]] + "\n");
          ob->add_temp(effect_keys[i], all_effect[effect_type[j]][effect_keys[i]]);
        } else if (stringp(all_effect[effect_type[j]][effect_keys[i]])) {
          ob->set_temp(effect_keys[i], all_effect[effect_type[j]][effect_keys[i]]);
        }
      }
    }
  }
}

varargs mixed query_combat_attack(object ob, mixed attack) {
  string family;
  mixed result;
  mixed wuxing;
  mixed fam_wx;

  if (!ob || !(family = ob->query_family())) {
    return 0;
  }

  if (undefinedp(ALL_FAMILYS[family])) {
    return 0;
  }

  result = (__DIR__ "family/" + query_family_path(family))->query_combat_attack(ob, attack);

  if (random(100) > 100 && 1 < ANIMA_D->room_wuxing_bonus(environment(ob))) {
    wuxing = ANIMA_D->room_wuxing_type(environment(ob));
    fam_wx = (__DIR__ "family/" + query_family_path(family))->query_wuxing(ob);

    if (WUXING_NONE != wuxing && (wuxing == fam_wx || WUXING_ALL == fam_wx || WUXING_ALL == wuxing)) {
      ANIMA_D->use_room_wuxing(environment(ob), 1);
      wuxing = WUXING_D->wuxing_name(wuxing);
      message_combatd(HIY "空气中弥漫着浓郁的" + wuxing + "元气，$N的命中大幅提高。\n" NOR, ob, 0, "");
    }
  }

  return result;
}

varargs int query_attack_damage(object ob, object victim, int init_damage, string type, string kind)  // ob is attacker,vic is be atked
{
  int damage = init_damage;

  if (!ob || !ob->query_family()) {
    return damage;
  }

  if (undefinedp(ALL_FAMILYS[ob->query_family()])) {
    return damage;
  }

  damage = (__DIR__ "family/" + query_family_path(ob->query_family()))->query_damage_effect(
    ob,
    victim,
    damage,
    type,
    kind
  );

  return damage;
}

varargs int query_defense_damage(
  object ob,
  object victim,
  int init_damage,
  string type,
  string kind
)  // ob is attacker,vic is be atked
{
  int damage = init_damage;

  if (!victim || !victim->query_family()) {
    return damage;
  }

  if (undefinedp(ALL_FAMILYS[victim->query_family()])) {
    return damage;
  }

  damage = (__DIR__ "family/" + query_family_path(victim->query_family()))->query_behit_effect(
    ob,
    victim,
    damage,
    type,
    kind
  );

  return damage;
}

string cannot_improve_skill(object ob, string skill) {
  if (!ob || !ob->query_family()) {
    return 0;
  }

  if (undefinedp(ALL_FAMILYS[ob->query_family()])) {
    return 0;
  }

  return (__DIR__ "family/" + query_family_path(ob->query_family()))->cannot_improve_skill(
    ob,
    skill
  );
}

varargs int query_total_damage(object ob, object victim, int init_damage, string type, string kind)  // ob is attacker,vic is be atked
{
  int damage = init_damage;

  if (!ob->query_temp("family/query_damage")) {
    ob->set_temp("family/query_damage", 1);

    //攻方
    damage = query_attack_damage(ob, victim, damage, type, kind);

    //守方
    damage = query_defense_damage(ob, victim, damage, type, kind);

    ob->delete_temp("family/query_damage");
  }

  return damage;
}

int special_attack(object me, object target) {
  int damage = 0;

  if (!me || !me->query_family()) {
    return 0;
  }

  if (undefinedp(ALL_FAMILYS[me->query_family()])) {
    return 0;
  }

  if (!me->query_temp("family/query_damage")) {
    me->set_temp("family/query_damage", 1);
    damage = (__DIR__ "family/" + query_family_path(me->query_family()))->special_attack(
      me,
      target
    );
    me->delete_temp("family/query_damage");
    return damage;
  } else {
    return 0;
  }
}

void family_give_equip(object ob) {
  if (!ob || !ob->query_family()) {
    return;
  }

  if (undefinedp(ALL_FAMILYS[ob->query_family()])) {
    return;
  }

  (__DIR__ "family/" + query_family_path(ob->query_family()))->family_give_equip(ob);
}

private int *all_jzeffect;
//忽略的特效，含有这些特效的招式，NPC不会使用
private int ignore_jzeffect = JZ_ESCAPE + JZ_PUSH + JZ_PEACE + JZ_SUICIDE;
private int ignore_jzeffect2 = JZ_CURE;

string random_class() {
  string *all_class = keys(ALL_FAMILYS);

  return all_class[random(sizeof(all_class))];
}

int *get_effect() {
  return all_jzeffect;
}

int is_ignoreeffect(int effect) {
  if (0x40000000 & effect) {
    return (effect == (effect & ignore_jzeffect2));
  } else {
    return (effect == (effect & ignore_jzeffect));
  }
}

private void generate_effect() {
  int i;

  all_jzeffect = allocate(30);
  all_jzeffect[0] = 0x00000001;
  for (i = 1; i < 30; i++) {
    all_jzeffect[i] = all_jzeffect[i - 1] * 2;
    //write("effect " + i + " " + all_jzeffect[i] + "\n");
  }
}

