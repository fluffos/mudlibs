void full_skills(object me, string menpai, int max_level) {
  mapping mp_skills;
  mapping sk_juezhao;
  string pfmflag;
  string *flagarray;
  mapping flagop;
  string *jzarray;
  int count, i;
  int set_level = 0;
  string *all_menpai = keys(ALL_FAMILYS);

  count = sizeof(all_menpai);
  for (i = 0; i < count; i++) {
    if (menpai == ALL_FAMILYS[all_menpai[i]]["name"]) {
      break;
    }
  }

  if (i >= count) {
    tell_object(me, "没有这个门派。\n");
    return;
  }

  set_level = max_level;

  me->set_skill("unarmed", set_level);
  me->set_skill("dodge", set_level);
  me->set_skill("parry", set_level);
  me->set_skill("force", set_level);
  me->set_skill("spells", set_level);

  me->set("skill_level/unarmed", LEVEL_D->query_max_skill_level());
  me->set("skill_level/dodge", LEVEL_D->query_max_skill_level());
  me->set("skill_level/parry", LEVEL_D->query_max_skill_level());
  me->set("skill_level/force", LEVEL_D->query_max_skill_level());
  me->set("skill_level/spells", LEVEL_D->query_max_skill_level());

  //获得该门派对应的mapping
  mp_skills = ("/adm/daemons/family/" + menpai)->query_family_cfg();
  if (!mp_skills) {
    return;
  }

  //是否有需要设置的绝招标志
  pfmflag = mp_skills[INDEX_PFMFLAG];
  if (pfmflag) {
    //多组标志，可以;进行分隔
    flagarray = explode(pfmflag, ";");
    count = sizeof(flagarray);

    while (count) {
      count--;
      if (!flagarray[count] || "" == flagarray[count]) {
        continue;
      }

      //每组标志和值以:分隔
      jzarray = explode(flagarray[count], ":");
      if (2 != sizeof(jzarray)) {
        me->set(jzarray[0]);
      } else {
        me->set(jzarray[0], jzarray[1]);
      }
    }
  }

  //是否有需要设置的技能
  sk_juezhao = mp_skills[INDEX_SKILLS];
  if (sk_juezhao) {
    flagarray = keys(sk_juezhao);
    count = sizeof(flagarray);
    //所有技能
    while (count) {
      count--;
      //设置特殊技能等级
      me->set_skill(flagarray[count], set_level);

      flagop = sk_juezhao[flagarray[count]];

      if (flagop[INDEX_BASICSKILL]) {
        //设置基本技能等级，并完成激发
        me->set_skill(flagop[INDEX_BASICSKILL], set_level);
        me->set("skill_level/" + flagop[INDEX_BASICSKILL], LEVEL_D->query_max_skill_level());
        me->map_skill(flagop[INDEX_BASICSKILL], flagarray[count]);
      }
    }
  }
}

void full_me(object me) {
  me->set("food", 10000);
  me->set("water", 10000);
  me->set("max_force", (int)me->query_max_force());
  me->set("max_mana", (int)me->query_max_mana());
  me->set("max_atman", (int)me->query_max_atman());
  me->set("force", 2 * (int)me->query("max_force"));
  me->set("mana", 2 * (int)me->query("max_mana"));
  me->set("atman", 2 * (int)me->query("max_atman"));
  me->set("force_factor", me->query_max_enforce());
  me->set("mana_factor", me->query_max_enchant());
  me->set("lingli_factor", me->query_max_jialing());

  return;
}

int if_basicskill(string skill) {
  return LEVEL_D->if_basicskill(skill);
}

void family_chat(object who, string declare) {
  if (undefinedp(ALL_FAMILYS[who->query_family()])) {
    CHANNEL_D->do_channel(this_object(), "rumor", declare);
  } else {
    set("name", ALL_FAMILYS[who->query_family()]["annoucer"]);
    set("id", ALL_FAMILYS[who->query_family()]["annid"]);
    CHANNEL_D->do_channel(this_object(), "chat", declare);
    set("name", "鸿蒙尊者");
    set("id", "familyd");
  }
}

int can_apprentice(object player, object me) {
  return !undefinedp(ALL_FAMILYS[me->query_family()]);
}
