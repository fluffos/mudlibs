    case JZ_SELFNOMOVE:
      return "自己有可能no move";
    case JZ_KEEWOUND:
      return "气血上限攻击";
    case JZ_SENWOUND:
      return "精神上限攻击";
    case JZ_HEAL:
      return "疗伤";
    case JZ_NOMOVE:
      return "对方no move";
    case JZ_FENGMO:
