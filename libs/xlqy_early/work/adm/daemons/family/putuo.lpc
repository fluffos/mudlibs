]);

mapping query_family_cfg() {
  return family_config;
}

mapping query_status_effect(object ob) {
  int personality = (int)ob->query_skill("spells") / 1000 - 1;

  if ("buddhism" != ob->query_skill_mapped("spells")) {
    return 0;
  }

  if (personality < 0) {
    personality = 0;
  }

  personality = 30 - personality;
  if (personality < 10) {
    personality = 10;
  }
  if (personality > 30) {
    personality = 30;
  }

  ob->add_temp("apply/max_mana", -ob->query_temp("family_apply/max_mana"));
  ob->set_temp("family_apply/max_mana", ob->query_char_force() / 100 * (40 - personality));

  ob->set_temp("family_apply/max_kee", -(int)(ob->query("max_kee") / 100 * personality));

  ob->set_temp("family_apply/max_sen", (int)(ob->query("max_sen") / 100 * (40 - personality)));

  return ([
    "dbase":
    ([
      "max_kee": (int)ob->query_temp("family_apply/max_kee"),
      "max_sen": (int)ob->query_temp("family_apply/max_sen"),
    ]),
    "temp":
    ([
      "apply/max_mana": ob->query_temp("family_apply/max_mana"),
    ]),
  ]);
}

varargs int query_damage_effect(
  object ob,
  object victim,
  int init_damage,
  string type,
  string kind
) {
  return init_damage;
}

varargs int query_behit_effect(
  object ob,
  object victim,
  int init_damage,
  string type,
  string kind
) {
  return init_damage;
}

varargs int query_combat_attack(object ob, mixed attack) {
  return 0;
}

void leave_family(object ob) {
  if (ob->query_skill("buddhism")) {
    ob->delete_skill("buddhism");
    ob->map_skill("spells");
  }
}

string cannot_improve_skill(object ob, string skill) {
  if ("spells" != skill && "buddhism" != skill) {
    if (ob->query_skill(skill, 1) * 2 >= ob->query_skill("buddhism", 1)) {
      return "你的【大乘佛法】不够深入。\n";
    }
  }

  return 0;
}

void family_give_equip(object ob) {
  object weapon;

  weapon = new("/d/city/npc/obj/staff");
  if (!weapon->move(ob)) {
    destruct(weapon);
  }

  weapon = new("/d/obj/weapon/spear/yinqiang");
  if (!weapon->move(ob)) {
    destruct(weapon);
  }

  weapon = new("/d/obj/weapon/hammer/hammer");
  if (!weapon->move(ob)) {
    destruct(weapon);
  }
}

void carry_jinguzhou(object who) {
  who->carry_object("/d/nanhai/obj/jingu" + (random(3) + 1));
}

int special_attack(object me, object target) {
  string *use_cast = ({ "bighammer", "jinguzhou", "puducanoe" });

  if (random(100) < 100) {
    return 0;
  }

  SKILL_D("buddhism")->cast_spell_file(use_cast[random(sizeof(use_cast))])->cast(me, target);

  return 1;
}

mixed query_wuxing(object who) {
  return WUXING_JIN;
}
