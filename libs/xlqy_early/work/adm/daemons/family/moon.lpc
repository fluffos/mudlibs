mapping query_family_cfg() {
  return family_config;
}

mapping query_status_effect(object ob) {
  int personality = (int)ob->query_skill("moonshentong") / 1000 - 1;

  if ("moonshentong" != ob->query_skill_mapped("moonshentong")) {
    return 0;
  }

  if (personality < 0) {
    personality = 0;
  }

  personality = 30 - personality;
  if (personality < 10) {
    personality = 10;
  }
  if (personality > 30) {
    personality = 30;
  }

  ob->add_temp("apply/dodge", -(int)ob->query_temp("family_apply/dodge"));
  ob->set_temp("family_apply/dodge", (int)(ob->query_skill("dodge") / 100 * (40 - personality)));

  ob->set_temp("family_apply/max_kee", -(int)(ob->query("max_kee") / 100 * personality));

  ob->set_temp("family_apply/max_sen", (int)(ob->query("max_sen") / 100 * (40 - personality)));

  return ([
    "dbase":
    ([
      "max_kee": (int)ob->query_temp("family_apply/max_kee"),
      "max_sen": (int)ob->query_temp("family_apply/max_sen"),
    ]),
    "temp":
    ([
      "apply/dodge": (int)ob->query_temp("family_apply/dodge"),
    ]),
  ]);
}

varargs int query_damage_effect(
  object ob,
  object victim,
  int init_damage,
  string type,
  string kind
) {
  int duration;

  if ("moonshentong" != ob->query_skill_mapped("spells") || ob->is_busy() || ob->query("sen") <= init_damage * 50) {
    return init_damage;
  }

  if (!victim->query_condition("outmind")
    && 0 < SPELL_D->attacking_cast_success(ob, victim, 180)) {
    duration = 5 + random(5);
    message_family(HIW "$N" HIW "默运冰心决，一股寒气迎面扑向$n"
      HIW "，四周登时雪花飘飘，造成" + duration + "点魂伤。\n" NOR, ob, victim);
    victim->set("outmind_ob", ob);
    victim->apply_condition("outmind", duration);

    return init_damage + random(init_damage / 2);
  }

  return init_damage;
}

varargs int query_behit_effect(
  object ob,
  object victim,
  int init_damage,
  string type,
  string kind
) {
  int yourpower = (int)ob->query_skill("spells");
  int mypower = (int)victim->query_skill("spells");

  if ("moonshentong" != victim->query_skill_mapped("spells") || victim->is_busy() || "sen" == type || victim->query("sen") <= init_damage * 50) {
    return init_damage;
  }

  if (mypower / 3 > random(yourpower)) {
    mypower *= 5;
    mypower = mypower / 2 + random(mypower / 2);

    if (mypower > init_damage / 3) {
      mypower = init_damage / 3;
    }

    message_family(
      HIM "$N面色一红，别具神韵，不觉之中，有" + HIY + mypower + HIM + "点伤害被强大心神化解。\n" NOR,
      victim,
      ob
    );

    victim->receive_damage("sen", mypower * 2);
    return init_damage - mypower;
  }

  return init_damage;
}

varargs int query_combat_attack(object ob, mixed attack) {
  return 0;
}

void leave_family(object ob) {
  if (ob->query_skill("moonshentong")) {
    ob->delete_skill("moonshentong");
    ob->map_skill("moonshentong");
  }

  if (ob->query_skill("snowsword")) {
    ob->delete_skill("snowsword");
    ob->map_skill("sword");
  }
}

string cannot_improve_skill(object ob, string skill) {
  if ("spells" != skill && "moonshentong" != skill) {
    if (ob->query_skill(skill, 1) * 2 >= ob->query_skill("moonshentong", 1)) {
      return "你的【月宫仙法】不够深入。\n";
    }
  }

  return 0;
}

void family_give_equip(object ob) {
  object weapon;

  weapon = new("/d/obj/weapon/sword/snow_sword");
  if (!weapon->move(ob)) {
    destruct(weapon);
  }

  weapon = new("/d/obj/weapon/blade/yangdao");
  if (!weapon->move(ob)) {
    destruct(weapon);
  }

  weapon = new("/d/obj/weapon/whip/jueqingwhip");
  if (!weapon->move(ob)) {
    destruct(weapon);
  }
}

int special_attack(object me, object target) {
  string *use_cast = ({ "bighammer", "jinguzhou", "puducanoe" });

  if (random(100) < 100) {
    return 0;
  }

  SKILL_D("buddhism")->cast_spell_file(use_cast[random(sizeof(use_cast))])->cast(me, target);

  return 1;
}

mixed query_wuxing(object who) {
  return WUXING_SHUI;
}
