mapping query_family_cfg() {
  return family_config;
}

mapping query_status_effect(object ob) {
  int personality = (int)ob->query_skill("force") / 1000 - 1;

  if ("jiuyin-xinjing" != ob->query_skill_mapped("force")) {
    return 0;
  }

  if (personality < 0) {
    personality = 0;
  }

  personality = 30 - personality;
  if (personality < 10) {
    personality = 10;
  }
  if (personality > 30) {
    personality = 30;
  }

  ob->add_temp("apply/max_force", -ob->query_temp("family_apply/max_force"));
  ob->set_temp("family_apply/max_force", ob->query_char_force() / 100 * (40 - personality));

  ob->set_temp("family_apply/max_kee", ob->query("max_kee") / 100 * personality);

  ob->set_temp("family_apply/max_sen", -ob->query("max_sen") / 100 * (40 - personality));

  return ([
    "dbase":
    ([
      "max_kee": ob->query_temp("family_apply/max_kee"),
      "max_sen": ob->query_temp("family_apply/max_sen"),
    ]),
    "temp":
    ([
      "apply/max_force": ob->query_temp("family_apply/max_force"),
    ]),
  ]);
}

varargs int query_damage_effect(
  object ob,
  object victim,
  int init_damage,
  string type,
  string kind
) {
  object weapon = ob->query_temp("weapon");
  mapping ap, dp;

  if ("jiuyin-xinjing" != ob->query_skill_mapped("force") || ob->is_busy() || ob->query("kee") <= init_damage * 50) {
    return init_damage;
  }

  if (!weapon || "stick" != weapon->query("skill_type") || "qingxia-jian" != ob->query_skill_mapped("stick")) {
    return init_damage;
  }

  ap = COMBAT_D->skill_power(ob, victim, "force", SKILL_USAGE_ATTACK);
  dp = COMBAT_D->skill_power(ob, victim, "force", SKILL_USAGE_DEFENSE);

  if (0 < COMBAT_D->if_hit(ap, dp) && !random(4)) {
    ob->set_temp("perf_quick/msg",
      HIW "$N" HIW "默运无极心法，手中" HIR + weapon->query("name") + HIW "劈头盖脑向$n抡去。\n" NOR);
  }

  return init_damage;
}

varargs int query_behit_effect(
  object ob,
  object victim,
  int init_damage,
  string type,
  string kind
) {
  int yourpower = (int)ob->query_skill("force");
  int mypower = (int)victim->query_skill("force");
  mapping ap, dp;

  if ("jiuyin-xinjing" != victim->query_skill_mapped("force") || victim->is_busy() || victim->query("force") <= init_damage / 2 + random(init_damage / 2)) {
    return init_damage;
  }

  if (mypower / 3 > random(yourpower)) {
    ap = COMBAT_D->skill_power(ob, victim, "force", SKILL_USAGE_ATTACK);
    dp = COMBAT_D->skill_power(ob, victim, "force", SKILL_USAGE_DEFENSE);

    if (0 >= COMBAT_D->perform_hit(COMBAT_D->power_mul(ap, 5), COMBAT_D->power_mul(dp, 3))) {
      switch (random(3)) {
        case 0:
          message_family(HIG "$N轻轻一拨，$n招式向旁边稍微歪了一下。\n" NOR, victim, ob);
          break;

        case 1:
          message_family(HIG "$N轻轻一拨，$n顿时觉得内力逆转，力道向着自己的身体直撞过去！\n" NOR, victim, ob);
          message_family("$n一个懒驴打滚，灰头土脸的躲开了。\n", victim, ob);
          break;

        default:
          message_family(HIG "$N轻轻一拨，$n顿时觉得内力逆转，力道向着自己的身体直撞过去！\n" NOR, victim, ob);
          message_family("但$n早有准备，结果$N连边都没沾上。\n", victim, ob);
          break;
      }
      return 0;
    }

    message_family(HIG "$N轻轻一拨，$n顿时觉得内力逆转，力道向着自己的身体直撞过去！\n" NOR, victim, ob);
    COMBAT_D->perform_attack(victim, ob, victim->query_temp("weapon"));

    return init_damage;
  }

  return init_damage;
}

varargs int query_combat_attack(object ob, mixed attack) {
  return 0;
}

void leave_family(object ob) {
  if (ob->query_skill("pansi_dafa")) {
    ob->delete_skill("pansi_dafa");
    ob->map_skill("spells");
  }

  if (ob->query_skill("jiuyin-xinjing")) {
    ob->delete_skill("jiuyin-xinjing");
    ob->map_skill("sword");
  }
}

string cannot_improve_skill(object ob, string skill) {
  if ("force" != skill && "jiuyin-xinjing" != skill) {
    if (ob->query_skill(skill, 1) * 2 >= ob->query_skill("jiuyin-xinjing", 1)) {
      return "你的【无极心法】不够深入。\n";
    }
  }

  return 0;
}

void family_give_equip(object ob) {
  object weapon;

  weapon = new("/d/obj/weapon/sword/snow_sword");
  if (!weapon->move(ob)) {
    destruct(weapon);
  }

  weapon = new("/d/obj/weapon/stick/bintiegun");
  if (!weapon->move(ob)) {
    destruct(weapon);
  }
}

int special_attack(object me, object target) {
  string *use_cast = ({ "bighammer", "jinguzhou", "puducanoe" });

  if (random(100) < 100) {
    return 0;
  }

  SKILL_D("buddhism")->cast_spell_file(use_cast[random(sizeof(use_cast))])->cast(me, target);

  return 1;
}

mixed query_wuxing(object who) {
  return WUXING_HUO;
}
