int query_xiuxian_step()
{
    return (int)XIUXIAN_STEP;
}

string query_xiuxian_title(object who)
{
    int step;

    if ( !who )
    {
        step = 0;
    }
    else
    {
        step = who->query("level") / 10;
    }

    if ( step >= sizeof(all_level) )
    {
        step = sizeof(all_level) - 1;
    }

    return all_level[step];
}

