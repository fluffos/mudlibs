void set_weapons_prop(object obj, string types, int kind, int level) {
  int effect;
  int lvl_content;
  string content;
  int flag;
  if (kind > 1) {
    kind--;
    if (!random(2 + kind + (kind + 1) / 2)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = set_diablo_effect(content, kind + 1, 1 + level / 2);
      obj->set("diablo_bad/" + content, effect);
    }

    if (!random(13)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = set_diablo_effect(content, kind + 1, 1 + level / 2);
      obj->set("diablo_bad/" + content, effect);
    }
    if (!random(26)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = set_diablo_effect(content, kind + 1, 1 + level / 2);
      obj->set("diablo_bad/" + content, effect);
    }
    if (!random(39)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = set_diablo_effect(content, kind + 1, 1 + level / 2);
      obj->set("diablo_bad/" + content, effect);
    }
    if (obj->query("diablo_bad/rigidity")) {
      obj->add("diablo_prop/rigidity", -obj->query("diablo_bad/rigidity"));
      obj->delete("diablo_bad/rigidity");
    }
    kind++;
  }
  switch (kind) {
    case CRUDE:
      if (types == "dagger")
        obj->set("diablo_prop/damage", 1 + 2 * level + random(level + 1));  //max is 
        else
          obj->set("diablo_prop/damage", 10 + 2 * level + random(2 * level + 1));  //max is 
          obj->set("identification", 1);
      obj->set("name", BLU "黑木" + obj->query("name") + NOR);
      if (!random(36)) {

        if (random(3))
          content = effect_one_weapon[random(sizeof(effect_one_weapon))];
        else
          content = effect_one_all[random(sizeof(effect_one_all))];

        effect = set_diablo_effect(content, kind, level);

        obj->add("diablo_prop/" + content, effect);

      }

      break;
    case CRACKED:
      if (types == "dagger")
        obj->set("diablo_prop/damage", 5 + 2 * level + random(2 * level + 1));  //max is 
        else
          obj->set("diablo_prop/damage", 25 + 2 * level + random(2 * level + 1));  //max is 
          obj->set("identification", 1);
      obj->set("name", HIB "青铜" + obj->query("name") + NOR);

