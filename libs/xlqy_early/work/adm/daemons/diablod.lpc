void create() {
  seteuid(getuid());
  set("name", "暗黑精灵");
  set("id", "diablod");

}
void diablo_drop(object npc, object user) {
  int npc_exp, npc_dx, npc_total, npc_level;
  int user_exp, user_dx, user_kar, user_total;
  int obj_level = 1;  //装备等级
  int user_success;  //成功机率
  int user_kar_and_success;
  int npc_mf;
  if (!npc) return;
  if (!userp(user)) return;
  if (!npc->query("is_diablo_npc")) return;
  //获得npc属性
  npc_exp = npc->query("combat_exp");
  npc_dx = npc->query("daoxing");
  npc_mf = npc->query("magic_find");  //以万为基数
  npc_total = npc_exp + npc_dx;  //把武学和道行相加.用于判断掉出装备的等级
  //获得user属性
  user_exp = user->query("combat_exp");
  user_dx = user->query("daoxing");
  user_total = user_exp + user_dx;
  user_kar = user->query_kar() * 100;              //以万为基数

  user_success = user->query_temp("apply/magic_find");  //以万为基数
  user_kar_and_success = user_success + user_kar;
  if (user->query("special_skill/greedy"))
    user_kar_and_success += user_success / 4;       //给饭桶加个用处...

    npc_total = npc_total / 1000;
  npc_total = 2 * npc_total + random(npc_total * 30);   //增加弹性..
  ///装备的等级分为13级，只和npc有关
  if (npc_total / 1000 < 15)
    npc_level = 1;
  else if (npc_total / 1000 < 30)
    npc_level = 2;
  else if (npc_total / 1000 < 54)
    npc_level = 3;
  else if (npc_total / 1000 < 90)
    npc_level = 4;
  else if (npc_total / 1000 < 144)
    npc_level = 5;
  else if (npc_total / 1000 < 216)
    npc_level = 6;
  else if (npc_total / 1000 < 360)
    npc_level = 7;
  else if (npc_total / 1000 < 540)
    npc_level = 8;
  else if (npc_total / 1000 < 750)
    npc_level = 9;
  else if (npc_total / 1000 < 1100)
    npc_level = 10;
  else if (npc_total / 1000 < 1560)
    npc_level = 11;
  else if (npc_total / 1000 < 2100)
    npc_level = 12;
  else npc_level = 13;


  //判断是否应该掉出装备.
  if (1) {
    //装备的种类分为x种，只和user的magic find有关。嗯和npc的mf也应该有关！
    //都是白板的时候,success最多=4000/10+random(4000)/10 ,800左右
    //npc_mf大概从1-200左右 0.0001---0.2 8-1600
    //mf为20000的时候,success=4000,40-8000
    //mf为50000,100-20,000
    int success = user_kar_and_success / 10 + random(user_kar_and_success / 10);
    success = success / 5 + random(success * npc_mf / 100);
    success = success * NPC_MFRATE / 100;  //可以用定义的值来调节drop率，spank..
    if (wizardp(user))
      tell_object(user, "the success is " + success + "\n");
    if (success > 97 + random(1337940)) obj_level = UNIQUES;
    else if (success > 61 + random(718520)) obj_level = RARE;
    else if (success > 29 + random(500000)) obj_level = SET;
    else if (success > 13 + random(233470)) obj_level = SUPERIOR;

    else if (success > 11 + random(135620)) obj_level = GOOD;
    else if (success > 7 + random(63790)) obj_level = NORMAL;
    else if (success > 3 + random(37540)) obj_level = LOW_QUALITY;
    else if (success > 1 + random(18600)) obj_level = CRACKED;
    else obj_level = CRUDE;
    obj_level = UNIQUES;
    drop(npc, user, obj_level, npc_level);

  }
}

void drop(object npc, object user, int obj_level, int npc_level) {

  object env;
  object obj;
  string temp_str, types, content;
  string dir_path;  //存放物品文件的目录名
  string file_name;
  string file_full_name;
  int i;
  env = environment(npc);
  if (!env) return;
  i = 1 + random(100);
  if (i > 55) temp_str = "armors";
  else if (i > 20) temp_str = "weapons";
  else temp_str = "others";                     //碎宝石，药品，钱币等..

  if (obj_level == SET)  //套装
  {
    if (npc_level > 3) {
      obj = "/adm/daemons/Diabloset"->drop();
      if (!obj->move(user))
        obj->move(env);
      message_vision(GRN + "从$N身上掉了出来一" + obj->query("unit") + obj->name() + "\n" + NOR, npc);
      if (!wizardp(user))
        CHANNEL_D->do_channel(
          this_object(),
          "rumor",
          HIR + user->query("name") + NOR + HIM "得到一" + obj->query("unit") + NOR + HIM "传说中的" + NOR + obj->query("name") + NOR "！\n"
        );
      return;
    } else
      obj_level = SUPERIOR;
  }
  if (obj_level > 5)  // 6,7,8
  {
    i = 13 - obj_level;
    if (random(i) == 1)         //高品级高几率
    {
      obj = "/adm/daemons/Diablocharm"->drop(obj_level);
      if (!obj->move(user))
        obj->move(env);
      message_vision(GRN + "从$N身上掉了出来一" + obj->query("unit") + obj->name() + "\n" + NOR, npc);
      CHANNEL_D->do_channel(this_object(), "sys", user->query("name") + "得到一个神符。\n");
      if (obj_level == 8)
        if (!wizardp(user))
          CHANNEL_D->do_channel(
            this_object(),
            "rumor",
            HIR + user->query("name") + NOR + HIM "得到一" + obj->query("unit") + NOR + HIM "传说中的顶级" + NOR + obj->query("name") + NOR "！\n"
          );
      return;

    }
  }


  if (temp_str == "others") {
    temp_str = items[random(sizeof(items))];

    obj = drop_diablo_items(temp_str, obj_level, npc_level);
    if (obj) {
      if (!obj->move(user))
        obj->move(env);

      message_vision(GRN + "从$N身上掉了出来" + obj->name() + ",$n眼疾手快一把抓在怀里。\n" + NOR, npc, user);
    }
    return;
  } else {

    obj = create_diablo_ob(temp_str, obj_level, npc_level);
    obj->set("kind", obj_level);
    obj->set("level", npc_level);
    //obj->set("no_put",1);
    if (obj) {
      if (obj_level > 4) {
        if (obj_level == 5) {
          if (!random(25))
            obj->set("diablo_fixed/" + effect_menpai_set[random(sizeof(effect_menpai_set))], 1);
        } else if (obj_level == 6) {
          if (!random(18))
            obj->set("diablo_fixed/" + effect_menpai_set[random(sizeof(effect_menpai_set))], 1);
        } else if (obj_level == 7) {
          if (!random(12))
            obj->set("diablo_fixed/" + effect_menpai_set[random(sizeof(effect_menpai_set))], 1);
        } else if (obj_level == 8) {
          if (!random(8))
            obj->set("diablo_fixed/" + effect_menpai_set[random(sizeof(effect_menpai_set))], 1);
        }
        if (!obj->move(user))
          obj->move(env);
      } else
        obj->move(env);

    }
    message_vision(GRN + "从$N身上掉了出来一" + obj->query("unit") + obj->name() + "\n" + NOR, npc);
    CHANNEL_D->do_channel(this_object(), "sys", user->query("name") + "得到一" + obj->query("unit")
      +obj->name() + "" HIC "「品级:" + obj_level + "，等级:" + npc_level + "」\n");
    if (obj_level == UNIQUES && !wizardp(user))
      CHANNEL_D->do_channel(this_object(), "rumor", HIR + user->query("name") + NOR + HIM "得到一" + obj->query("unit") + NOR
        +obj->query("name") + NOR "\n");
    return;
  }
}
object drop_diablo_items(string type, int kind, int level) {
  object obj;
  int amount;

  switch (type) {
    case "money":
      {
        if (kind == CRUDE || kind == CRACKED || kind == LOW_QUALITY)  //silver
        {
          obj = new("/obj/money/silver");
          amount = random(9 * level + 9 * kind) + level * level * 2 + kind * level + kind * kind;
          if (amount > 150) amount = 140 + random(30);
          obj->set_amount(amount);
        } else if (kind == NORMAL || kind == GOOD || kind == SUPERIOR)  //gold
        {
          obj = new("/obj/money/gold");
          amount = random(9 * level + 9 * kind) + level * level * 2 + kind * level + kind * kind;
          amount = 1 + amount / 20 + random(amount / 20);
          if (amount > 30) amount = 25 + random(10);
          obj->set_amount(amount);
        } else if (kind == RARE || kind == SET) {

          obj = new("/obj/money/thousand-cash");

          amount = 2 + random(level);
          obj->set_amount(amount);

        } else if (kind == UNIQUES) {

          obj = new("/obj/money/tenthousand-cash");
          amount = 1 + random(level / 3);
          obj->set_amount(amount);

        } else obj = new("/obj/money/coin");

      }
      break;
    case "medicine":
      if (kind == CRACKED || kind == LOW_QUALITY)  //yao or dan
      {
        amount = random(2);
        if (amount == 0)
          obj = new("/d/obj/drug/jinchuang");
        else if (amount == 1)
          obj = new("/d/obj/drug/hunyuandan");
        amount = kind + random(2 * level);
        obj->set_amount(amount);
      } else if (kind == NORMAL)  //jzhhd or xingjun dan 
      {
        amount = random(3);
        if (amount == 0)
          obj = new("/d/city/obj/xjdan");
        else if (amount == 1)
          obj = new("/d/obj/drug1/xbw");
        else obj = new("/d/obj/drug/guo");
      } else if (kind == GOOD) {
        if (random(2))
          obj = new("/d/obj/drug/mihoutao");
        else if (random(2))
          obj = new("/d/obj/drug/biou");
        else if (random(2))
          obj = new("/d/obj/drug/jiaoli");
        else if (random(2))
          obj = new("/d/obj/drug/huozao");
      } else if (kind == SUPERIOR) {
        if (random(2))
          obj = new("/d/obj/drug/hongdou");
        else if (random(2))
          obj = new("/d/obj/drug1/datao");
        else obj = new("/d/obj/xisuidan");
      } else if (kind == RARE) {
        if (random(2))
          obj = new("/d/obj/drug1/jzhhd");
        else if (random(2))
          obj = new("/d/obj/clone/gift/bingtang");

        else obj = new("/d/obj/clone/gift/lingzhi");
      } else if (kind == SET) {
        if (random(2))
          obj = new("/d/obj/shenliwan");
        else if (random(2))
          obj = new("/d/obj/xiandan");
        else if (random(2))
          obj = new("/d/obj/unknowdan");

      } else if (kind == UNIQUES)  //rsg 
      {
        if (random(2)) obj = new("/d/obj/drug/renshen-guo");
        else obj = new("/d/obj/drug/skill-guo");

      } else {
        obj = new("/obj/money/silver");
        obj->set_amount(10 + random(10));
      }

      break;
    case "baoshi":
      if (kind == CRACKED || kind == LOW_QUALITY)  // sl r c
      {
        if (random(2))
          obj = new("/d/baoshi/obj/sl_r");
        else obj = new("/d/baoshi/obj/sl_c");

      } else if (kind == NORMAL)  //sl g b
      {
        if (random(3)) {
          if (random(2))
            obj = new("/d/baoshi/obj/sl_g");
          else obj = new("/d/baoshi/obj/sl_b");
        } else {
          if (random(2))
            obj = new("/d/baoshi/obj/sl_r");
          else obj = new("/d/baoshi/obj/sl_c");
        }

      } else if (kind == GOOD)  //sl y xc r c
      {
        if (random(3)) {
          if (random(2))
            obj = new("/d/baoshi/obj/sl_y");
          else if (random(2))
            obj = new("/d/baoshi/obj/xc_r");
          else obj = new("/d/baoshi/obj/xc_c");
        } else {
          if (random(2))
            obj = new("/d/baoshi/obj/sl_g");
          else obj = new("/d/baoshi/obj/sl_b");
        }



      } else if (kind == SUPERIOR)  //xc g b
      {
        if (random(3)) {
          if (random(2))
            obj = new("/d/baoshi/obj/xc_g");
          else obj = new("/d/baoshi/obj/xc_b");
        } else {
          if (random(2))
            obj = new("/d/baoshi/obj/sl_y");
          else if (random(2))
            obj = new("/d/baoshi/obj/xc_r");
          else obj = new("/d/baoshi/obj/xc_c");
        }

      } else if (kind == RARE)  // xc y no r c
      {

        if (random(3)) {
          if (random(2))
            obj = new("/d/baoshi/obj/xc_y");
          else if (random(2))
            obj = new("/d/baoshi/obj/no_r");
          else obj = new("/d/baoshi/obj/no_c");
        } else {
          if (random(2))
            obj = new("/d/baoshi/obj/xc_g");
          else obj = new("/d/baoshi/obj/xc_b");
        }

      } else if (kind == SET)  // no g b
      {

        if (random(3)) {
          if (random(2))
            obj = new("/d/baoshi/obj/no_g");
          else obj = new("/d/baoshi/obj/no_b");
        } else {
          if (random(2))
            obj = new("/d/baoshi/obj/xc_y");
          else if (random(2))
            obj = new("/d/baoshi/obj/no_r");
          else obj = new("/d/baoshi/obj/no_c");
        }


      } else if (kind == UNIQUES)  //no y ,wx r c
      {

        if (random(3)) {
          if (random(2))
            obj = new("/d/baoshi/obj/no_y");
          else if (random(2))
            obj = new("/d/baoshi/obj/wx_r");
          else obj = new("/d/baoshi/obj/wx_c");
        } else {
          if (random(2))
            obj = new("/d/baoshi/obj/no_g");
          else obj = new("/d/baoshi/obj/no_b");
        }

      } else obj = new("/obj/money/gold");
      break;


  }

  return obj;



}
string random_file(string dir_path) {
  mixed *file;
  int j;
  file = get_dir(dir_path + "/*.lpc", -1);
  if (!sizeof(file)) return "";
  j = random(sizeof(file));
  return file[j][0];
}

object create_diablo_ob(string type, int kind, int level) {
  object obj;
  string types;
  string valid;
  int power;
  int flag;
  flag = 0;
  switch (type) {
    case "armors":
      {
        if (random(13) > 9) {
          types = aarmors[random(sizeof(aarmors))];
          flag = 1;
        } else
          types = armors[random(sizeof(armors))];
        obj = new("/obj/diablo_ob/armors/" + types + ".lpc");

        if (flag) {
          flag = 0;
          if (random(4))
            valid = valid_equip_amuring[random(sizeof(valid_equip_amuring))];
          else valid = valid_equip_all[random(sizeof(valid_equip_all))];

          power = set_vaild_equip(valid, kind, level);
          obj->set("diablo_valid/" + valid, power);

          if (!random(5)) {

            if (random(4))
              valid = valid_equip_amuring[random(sizeof(valid_equip_amuring))];
            else valid = valid_equip_all[random(sizeof(valid_equip_all))];

            power = set_vaild_equip(valid, kind, level);
            obj->set("diablo_valid/" + valid, power);
          }
          if (!random(10)) {

            if (random(4))
              valid = valid_equip_amuring[random(sizeof(valid_equip_amuring))];
            else valid = valid_equip_all[random(sizeof(valid_equip_all))];

            power = set_vaild_equip(valid, kind, level);
            obj->set("diablo_valid/" + valid, power);
          }
          if (random(2)) {
            power = set_vaild_equip("daoxing", kind, level);
            obj->set("diablo_valid/daoxing", power);
          } else if (random(4)) {
            power = set_vaild_equip("combat_exp", kind, level);
            obj->set("diablo_valid/combat_exp", power);
          } else {
            power = set_vaild_equip("level", kind, level);
            obj->set("diablo_valid/level", power);
          }
        } else {
          if (random(3))
            valid = valid_equip_armor[random(sizeof(valid_equip_armor))];
          else valid = valid_equip_all[random(sizeof(valid_equip_all))];

          power = set_vaild_equip(valid, kind, level);
          obj->set("diablo_valid/" + valid, power);
          if (!random(5)) {
            if (random(4))
              valid = valid_equip_armor[random(sizeof(valid_equip_armor))];
            else valid = valid_equip_all[random(sizeof(valid_equip_all))];

            power = set_vaild_equip(valid, kind, level);
            obj->set("diablo_valid/" + valid, power);
          }
          if (!random(10)) {
            if (random(4))
              valid = valid_equip_armor[random(sizeof(valid_equip_armor))];
            else valid = valid_equip_all[random(sizeof(valid_equip_all))];

            power = set_vaild_equip(valid, kind, level);
            obj->set("diablo_valid/" + valid, power);
          }
          if (!random(15)) {
            if (random(4))
              valid = valid_equip_armor[random(sizeof(valid_equip_armor))];
            else valid = valid_equip_all[random(sizeof(valid_equip_all))];

            power = set_vaild_equip(valid, kind, level);
            obj->set("diablo_valid/" + valid, power);
          }


          if (random(2)) {
            power = set_vaild_equip("daoxing", kind, level);
            obj->set("diablo_valid/daoxing", power);
          } else if (random(2)) {
            power = set_vaild_equip("combat_exp", kind, level);
            obj->set("diablo_valid/combat_exp", power);
          } else {
            power = set_vaild_equip("level", kind, level);
            obj->set("diablo_valid/level", power);
          }
        }
        set_armors_prop(obj, types, kind, level);

        break;
      }
    case "weapons":
      {
        types = weapons[random(sizeof(weapons))];
        obj = new("/obj/diablo_ob/weapons/" + types + ".lpc");

        if (!random(7)) {
          power = set_vaild_equip("skill_level", kind, level);
          if (power == 1)
            obj->set("diablo_valid/skill_level", "expert");
          else if (power == 2)
            obj->set("diablo_valid/skill_level", "master");
          else if (power > 2) {
            if (!random(4))
              obj->set("diablo_valid/skill_level", "grandmaster");
            else obj->set("diablo_valid/skill_level", "master");
          }

          if (types == "dagger")
            obj->delete("diablo_valid/skill_level");

        }
        if (!random(5)) {

          power = set_vaild_equip("skill", kind, level);
          obj->set("diablo_valid/skill", power);

          if (types == "dagger")
            obj->delete("diablo_valid/skill");
        }
        if (random(4))
          valid = valid_equip_weapon[random(sizeof(valid_equip_weapon))];
        else valid = valid_equip_all[random(sizeof(valid_equip_all))];

        power = set_vaild_equip(valid, kind, level);
        obj->set("diablo_valid/" + valid, power);
        if (!random(5)) {
          if (random(4))
            valid = valid_equip_weapon[random(sizeof(valid_equip_weapon))];
          else valid = valid_equip_all[random(sizeof(valid_equip_all))];

          power = set_vaild_equip(valid, kind, level);
          obj->set("diablo_valid/" + valid, power);
        }
        if (!random(10)) {
          if (random(4))
            valid = valid_equip_weapon[random(sizeof(valid_equip_weapon))];
          else valid = valid_equip_all[random(sizeof(valid_equip_all))];

          power = set_vaild_equip(valid, kind, level);
          obj->set("diablo_valid/" + valid, power);
        }
        if (!random(15)) {
          if (random(4))
            valid = valid_equip_weapon[random(sizeof(valid_equip_weapon))];
          else valid = valid_equip_all[random(sizeof(valid_equip_all))];

          power = set_vaild_equip(valid, kind, level);
          obj->set("diablo_valid/" + valid, power);
        }


        if (random(2)) {
          power = set_vaild_equip("daoxing", kind, level);
          obj->set("diablo_valid/daoxing", power);
        } else if (random(2)) {
          power = set_vaild_equip("combat_exp", kind, level);
          obj->set("diablo_valid/combat_exp", power);
        } else {
          power = set_vaild_equip("level", kind, level);
          obj->set("diablo_valid/level", power);
        }
        set_weapons_prop(obj, types, kind, level);
        break;
      }

    default:
      obj = new("/d/obj/armor/shoupi.lpc");
  }
  obj->add("diablo_prop/can_inset", 20 + (kind + 2) / 2);
  return obj;
}



void set_armors_prop(object obj, string type, int kind, int level) {
  int effect;
  int lvl_content;
  string content;
  int flag;

  if (kind > 1) {
    kind--;
    if (!random(2 + kind + (kind + 1) / 2)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = set_diablo_effect(content, kind + 1, 1 + level / 2);
      obj->set("diablo_bad/" + content, effect);
    }

    if (!random(13)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = set_diablo_effect(content, kind + 1, 1 + level / 2);
      obj->set("diablo_bad/" + content, effect);
    }
    if (!random(26)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = set_diablo_effect(content, kind + 1, 1 + level / 2);
      obj->set("diablo_bad/" + content, effect);
    }
    if (!random(39)) {
      content = effect_bad_all[random(sizeof(effect_bad_all))];
      effect = set_diablo_effect(content, kind + 1, 1 + level / 2);
      obj->set("diablo_bad/" + content, effect);
    }
    if (obj->query("diablo_bad/rigidity")) {
      obj->add("diablo_prop/rigidity", -obj->query("diablo_bad/rigidity"));
      obj->delete("diablo_bad/rigidity");
    }
    kind++;
  }

  switch (type) {

    case "armor":
      {
        switch (kind) {

          case CRUDE:
            obj->set("diablo_prop/armor", 12 + level + random(level + 1));  //38

            break;
          case CRACKED:
            obj->set("diablo_prop/armor", 24 + level + random(level + 1));  //50
            break;
          case LOW_QUALITY:
            obj->set("diablo_prop/armor", 32 + level + random(2 * level + 1));  //71

            break;
          case NORMAL:
            obj->set("diablo_prop/armor", 44 + 2 * level + random(2 * level + 1));  //96

            break;
          case GOOD:
            obj->set("diablo_prop/armor", 56 + 2 * level + random(3 * level + 1));  //120

            break;
          case SUPERIOR:
            obj->set("diablo_prop/armor", 75 + 3 * level + random(3 * level + 1));  //144	

            break;

          case RARE:
            obj->set("diablo_prop/armor", 93 + 4 * level + random(4 * level + 1));  //182

            break;

          case UNIQUES:
            obj->set("diablo_prop/armor", 111 + 5 * level + random(5 * level + 1));  //220

            break;

        }
        obj->set(
          "diablo_prop/rigidity",
          180 + random(level + kind + level * level + kind * kind + level * kind)
        );
      }
      break;
    case "boots":
      {
        switch (kind) {
          case CRUDE:
            obj->set("diablo_prop/armor", 1 + level + random(level));
            break;
          case CRACKED:
            obj->set("diablo_prop/armor", 5 + level + random(level));
            break;
          case LOW_QUALITY:
            obj->set("diablo_prop/armor", 8 + level + random(2 * level));

            break;
          case NORMAL:
            obj->set("diablo_prop/armor", 13 + 2 * level + random(2 * level));

            break;
          case GOOD:
            obj->set("diablo_prop/armor", 22 + 2 * level + random(3 * level));

            break;
          case SUPERIOR:
            obj->set("diablo_prop/armor", 31 + 3 * level + random(3 * level));

            break;

          case RARE:
            obj->set("diablo_prop/armor", 45 + 3 * level + random(4 * level));

            break;

          case UNIQUES:
            obj->set("diablo_prop/armor", 66 + 4 * level + random(5 * level));  //151

            break;

        }
        obj->set(
          "diablo_prop/rigidity",
