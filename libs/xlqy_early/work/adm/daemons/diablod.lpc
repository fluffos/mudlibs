          content = effect_three_weapon[random(sizeof(effect_three_weapon))];
        else if (random(2))
          content = effect_three_all[random(sizeof(effect_three_all))];

        else {
          content = effect_three_weapon_more[random(sizeof(effect_three_weapon_more))];
          kind = kind - 1;
          flag = 1;

        }
        effect = set_diablo_effect(content, kind, level);
        if (flag) {
          flag = 0;
          kind++;
        }
        obj->add("diablo_prop/" + content, effect);

      }
      if (!random(18)) {

        if (random(3))
          content = effect_three_weapon[random(sizeof(effect_three_weapon))];
        else if (random(2))
          content = effect_three_all[random(sizeof(effect_three_all))];

        else {
          content = effect_three_weapon_more[random(sizeof(effect_three_weapon_more))];
          kind = kind - 1;
          flag = 1;

        }
        effect = set_diablo_effect(content, kind, level);
        if (flag) {
          flag = 0;
          kind++;
        }
        obj->add("diablo_prop/" + content, effect);

      }
      if (!random(15)) {

        if (random(3))
          content = effect_three_weapon[random(sizeof(effect_three_weapon))];
        else if (random(2))
          content = effect_three_all[random(sizeof(effect_three_all))];

        else {
          content = effect_three_weapon_more[random(sizeof(effect_three_weapon_more))];
          kind = kind - 1;
          flag = 1;

        }
        effect = set_diablo_effect(content, kind, level);
        if (flag) {
          flag = 0;
          kind++;
        }
        obj->add("diablo_prop/" + content, effect);

      }
      if (random(3))
        content = effect_four_weapon[random(sizeof(effect_four_weapon))];
      else if (random(2))
        content = effect_four_all[random(sizeof(effect_four_all))];
      else {
        content = effect_four_weapon_more[random(sizeof(effect_four_weapon_more))];
        kind = kind - 1;
        flag = 1;

      }
      effect = set_diablo_effect(content, kind, level);
      if (flag) {
        flag = 0;
        kind++;
      }
      obj->add("diablo_prop/" + content, effect);
      if (!random(36)) {

        if (random(3))
          content = effect_four_weapon[random(sizeof(effect_four_weapon))];
        else if (random(2))
          content = effect_four_all[random(sizeof(effect_four_all))];
        else {
          content = effect_four_weapon_more[random(sizeof(effect_four_weapon_more))];
          kind = kind - 1;
          flag = 1;

        }
        effect = set_diablo_effect(content, kind, level);
        if (flag) {
          flag = 0;
          kind++;
        }
        obj->add("diablo_prop/" + content, effect);

      }

      break;

  }
  obj->set(
    "diablo_prop/rigidity",
    250 + random(level + kind + level * level + kind * kind + level * kind)
  );
  if (types == "dagger") {
    if (obj->query("diablo_prop/skill_eff"))
      obj->delete("diablo_prop/skill_eff");
    if (obj->query("diablo_prop/add_skill"))
      obj->delete("diablo_prop/add_skill");


  }
}
string choose_bad_effect() {

  string effect;

  effect = effect_bad_all[random(sizeof(effect_bad_all))];
  return effect;

}
string choose_diablo_effect(string type, int kind) {
  string effect;
  switch (kind) {
    case 1:
      if (type == "armor") {
        if (random(3))
          effect = effect_one_armors[random(sizeof(effect_one_armors))];
        else
          effect = effect_one_all[random(sizeof(effect_one_all))];

      } else if (type == "amulet") {
        if (random(3))
          effect = effect_one_amuring[random(sizeof(effect_one_amuring))];
        else
          effect = effect_one_all[random(sizeof(effect_one_all))];

      } else if (type == "weapon") {
        if (random(3))
          effect = effect_one_weapon[random(sizeof(effect_one_weapon))];
        else
          effect = effect_one_all[random(sizeof(effect_one_all))];

      }
      return effect;
      break;
    case 2:
      if (type == "armor") {
        if (random(3))
          effect = effect_two_armors[random(sizeof(effect_two_armors))];
        else
          effect = effect_two_all[random(sizeof(effect_two_all))];

      } else if (type == "amulet") {
        if (random(3))
          effect = effect_two_amuring[random(sizeof(effect_two_amuring))];
        else
          effect = effect_two_all[random(sizeof(effect_two_all))];

      } else if (type == "weapon") {
        if (random(3))
          effect = effect_two_weapons[random(sizeof(effect_two_weapons))];
        else
          effect = effect_two_all[random(sizeof(effect_two_all))];

      }
      return effect;
      break;
    case 3:
      if (type == "armor") {
        if (random(3))
          effect = effect_three_armor[random(sizeof(effect_three_armor))];
        else
          effect = effect_three_all[random(sizeof(effect_three_all))];

      } else if (type == "amulet") {
        if (random(3))
          effect = effect_three_amuring[random(sizeof(effect_three_amuring))];
        else
          effect = effect_three_all[random(sizeof(effect_three_all))];

      } else if (type == "weapon") {
        if (random(3))
          effect = effect_three_weapon[random(sizeof(effect_one_weapon))];
        else
          effect = effect_three_all[random(sizeof(effect_three_all))];

      }
      return effect;
      break;
    case 4:
      if (type == "armor") {
        if (random(3))
          effect = effect_four_armors[random(sizeof(effect_four_armors))];
        else
          effect = effect_four_all[random(sizeof(effect_four_all))];

      } else if (type == "amulet") {
        if (random(3))
          effect = effect_one_amuring[random(sizeof(effect_one_amuring))];
        else
          effect = effect_four_all[random(sizeof(effect_four_all))];

      } else if (type == "weapon") {
        if (random(3))
          effect = effect_four_weapon[random(sizeof(effect_four_weapon))];
        else
          effect = effect_four_all[random(sizeof(effect_four_all))];

      }
      return effect;
      break;


  }
  return "none";

}
int set_vaild_equip(string content, int kind, int level) {
  if (kind < 3)
    return 0;
  switch (content) {
    case "strength":
      return 10 + 2 * kind + level / 2 + random(2 * level);
      break;

    case "karma":
      return 10 + kind + level + random(kind + level / 2);
      break;
    case "courage":
    case "composure":
      return 10 + level * 3 / 2 + random(2 * kind);
      break;
    case "spirituality":
    case "constitution":
      return 10 + kind * 3 / 2 + random(level + kind);
      break;
    case "personality":
      return 10 + kind + random(kind + level);
      break;
    case "intelligence":
      return 10 + kind + random(level + kind);
      break;
    case "eff_strength":
      return 20 + kind * kind + random(level * level * level / 3 + kind * kind * kind / 10);
      break;
    case "eff_intelligence":
      return 12 + 3 * kind + random(2 * level);
      break;

    case "eff_karma":
      return 12 + 2 * kind + random(3 * level);
      break;
    case "eff_courage":
    case "eff_composure":
      return 12 + level * 3 + random(3 * kind);
      break;
    case "eff_spirituality":
    case "eff_constitution":
      return 12 + kind * 3 + random(2 * level);
      break;
    case "eff_personality":
      return 12 + kind + random(kind + 2 * level);
      break;
    case "skill":
      return level * 25 + random(kind * 15 + level * level * level / 10 + level * kind * kind / 5);
      break;
    case "skill_level":
      return kind / 6 + random(level / 2);
      break;
    case "dodge":
      return level * 25 + random(kind * 15 + level * level * level / 10 + level * kind * kind / 5);
      break;
    case "eff_dodge":
      return level * level * 3 + random(kind * kind * kind / 2 + level * kind * 3);
      break;
    case "daoxing":
      return kind * kind * 5000 + level * level * level * 10000 + random(level * level * level * 3000);
      break;
    case "combat_exp":
      return kind * kind * 5000 + level * level * level * 10000 + random(level * level * level * 10000);
      break;
    case "level":
      return 5 + kind + level * (level + 1) / 4 + random(kind + level);
      break;

  }

  return 1;


}
int set_diablo_effect(string content, int kind, int level) {
  kind = kind + 1;
  level = level + 1;
  switch (content) {

    case "personality":
      return 1 + kind * kind / 10 + random(level / 2 + 1);
      break;
    case "spirituality":
      return 1 + kind * kind / 15 + random(level / 2 + 1);
      break;
    case "karma":
      return 1 + kind * kind / 15 + random(level / 2 + 1);
      break;
    case "constitution":
      return 1 + kind * kind / 15 + random(level / 2 + 1);
      break;
    case "strength":
      return level + kind * kind / 10 + random(kind + 1);
      break;
    case "courage":
      return kind + level * level / 10 + random(level + 1);
      break;
    case "composure":
      return kind + level * level / 10 + random(level + 1);
      break;
    case "intelligence":
      return 1 + random(kind / 2 + level / 3);
      break;
    case "add_all_stat":
      return random(kind) + random(level / 2) + 1;
      break;
      //装备基本属性类
    case "magic_find":
      return 88 * kind + 88 * random(level + 1) + random(level * level * 9 + kind * kind * 5);
      break;
    case "low_condition":
      return 500 + random(2000);
      break;
    case "can_inset":
      return 1 + random(kind / 2);
      break;

    case "rigidity":
      return 5 * kind + random(5 * level + 1 + kind * kind);
      break;
      //人物属性类
    case "add_kee":
    case "add_sen":
      return level * level / 3 + kind * kind + random(level + 1 + kind + level * kind / 2);
      break;
    case "add_kee_sen":
      return level * kind / 3 + random(level * level / 3 + kind * kind / 2 + level + kind);
      break;
    case "add_force":
    case "add_mana":
      return level * level / 3 + kind * kind + random(level + 1 + kind + level * kind / 2);
      break;
    case "add_force_mana":
      return kind + level + random(level * level + kind * kind / 3 + 1 + level * kind / 2);
      break;
    case "add_max_kee":
    case "add_max_sen":
      return kind * kind * kind + kind * 45 + random(level * 88 + level * level * kind);
      break;
    case "add_max_kee_sen":
      return level * 88 + level * level * kind + random(kind * kind * kind + kind * 44);
      break;
    case "add_max_force":
    case "add_max_mana":
      return kind * 88 + kind * level * kind + random(level * level * level + level * 44);
      break;
    case "add_max_force_mana":
      return level * level * level + level * 44 + random(kind * 88 + kind * level * kind);
      break;
      //技能类
    case "armor":
      return 2 * kind + random(level + 1 + level * kind / 2);
      break;
    case "dodge":
      return kind * kind / 6 + random(2 * level + 1 + 2 * kind);
      break;
    case "parry":
      return kind * kind / 6 + random(2 * level + 1 + 2 * kind);
      break;
    case "skill_eff":
      return level + 2 * kind + kind * kind / 6 + random(level + 1);
      break;
    case "add_all_skill_eff":
      return kind + random(level * level / 12 + level + 1);
      break;
    case "force":
    case "spells":
      return 1 + kind * kind / 6 + random(level * level / 12 + 2 * level + kind);
      break;
    case "add_skill":
      return 1 + level * level / 12 + random(level + 2 * kind);
      break;
    case "add_all_skill":
      return 1 + random(kind + (level + 1) / 2);
      break;
      //战斗基本属性
    case "damage":
      return kind * random(10) + kind * kind / 6 + random(level + level * level / 5);
      break;
    case "defense":
      return 1 + level * level / 10 + kind * kind / 5 + random(level + 2 * kind);
      break;

    case "attack":
      return 1 + kind * kind / 10 + level * level / 5 + random(kind + 2 * level);
      break;
    case "add_skill_damage":
      return kind + random(level);
      break;
    case "add_skill_maxdamage":
      return level + random(kind * 2);
      break;
    case "sub_bless":
    case "sub_lucky":
      return kind * kind * 10 + level * level * 5 + random(level * kind * kind + kind * level * level);
      break;
    case "sub_defense":
      return kind * kind / 5 + random(level * level / 3 + level * kind);
      break;
    case "sub_armor":
      return 10 * kind + level * level + random(kind * kind + kind * level);
      break;
    case "sub_max_defense":
      return kind * 100 + kind * kind * 5 + random(level * 100 + level * level * 5);
      break;
    case "sub_max_armor":
      return level * 100 + level * level * 5 + random(kind * 100 + kind * kind * 5);
      break;
    case "sub_opp_phy":
      return kind * kind / 5 + random(level * level / 3 + level * kind);
      break;
    case "sub_opp_maxphy":
      return kind * 100 + kind * kind * 5 + random(level * 100 + level * level * 5);
      break;

    case "add_lucky":
      return 1 + random(kind / 2);
      break;
    case "add_bless":
      return 1 + random(kind / 2);
      break;
    case "combat_cruse":
    case "combat_unlucky":
      return kind * 200 + random(level * 100);
      break;
      //五行属性
    case "add_jin":
      return kind + random(kind * kind + level * kind + level + level * level);
      break;
    case "add_mu":
      return kind + kind * kind / 5 + random(level * level);
      break;
    case "add_shui":
      return kind + kind * kind / 3 + random(level * kind);
      break;
    case "add_huo":
      return kind * kind + random(level + kind);
      break;
    case "add_phy":
      return level * level / 3 + random(level * kind + kind * kind);
      break;
    case "add_spells_kee":
    case "add_spells_sen":
      return kind * 7 + level * level + random(level * kind / 2);
      break;
    case "add_spells_all":
      return kind * 5 + level * level + random(level * kind / 2);
      break;
    case "low_resist_all":
      return kind * kind / 3 + level * level / 8 + random(level * kind + 1);
      break;
    case "sub_jin":
      return kind * 5 + random(kind * kind + level + level * kind);
      break;
    case "sub_mu":
      return level * 5 + random(level * level + kind + level * kind);
      break;
    case "sub_shui":
      return kind * 5 + random(level * level + level + level * kind);
      break;
    case "sub_huo":
      return level * 5 + random(kind * kind + kind + level * kind);
      break;
    case "sub_phy":
      return kind * 3 + random(level + 2 * level * kind);
      break;
    case "sub_spells_kee":
    case "sub_spells_sen":
      return level * 3 + kind * kind + random(level * kind);
      break;
    case "sub_spells_all":
      return level * 2 + kind * kind + random(level * kind);
      break;
    case "add_max_jin":
      return kind * 100 + random(kind * kind * 10 + level * level * 10 + level * kind * 7);
      break;
    case "add_max_mu":
      return kind * 100 + kind * kind * 5 + random(level * level * 5 + level * kind * 3);
      break;
    case "add_max_shui":
      return kind * 100 + kind * kind * 7 + random(level * level * 7 + level * kind * 5);
      break;
    case "add_max_huo":
      return kind * 100 + kind * kind * 10 + level * level * 10 + random(level * kind * 5);
      break;
    case "add_max_spells_kee":
    case "add_max_spells_sen":
      return kind * kind * kind + level * level * level + random(level * 50 + kind * 100 + level * kind * 3);
      break;
    case "add_max_spells_all":
      return kind * kind * kind / 2 + level * level * level / 2 + random(level * 50 + kind * 100 + level * kind);
      break;
    case "high_resist_all":
      return level * 20 + kind * 50 + kind * kind * kind + level * level * 2 + random(level * kind);
      break;

    case "sub_max_jin":
      return level * 50 + kind * 100 + random(kind * kind * 7 + level * level * 7 + level * kind * 5);
      break;
    case "sub_max_mu":
      return level * 50 + kind * 100 + kind * kind * 3 + random(level * level * 3 + level * kind * 2);
      break;
    case "sub_max_shui":
      return level * 50 + kind * 100 + kind * kind * 5 + random(level * level * 5 + level * kind * 3);
      break;
    case "sub_max_huo":
      return level * 50 + kind * 100 + kind * kind * 7 + level * level * 7 + random(level * kind * 3);
      break;
    case "sub_max_spells_sen":
    case "sub_max_spells_kee":
      return kind * kind * level + level * level * kind + random(level * 100 + kind * 100 + level * kind * 3);
      break;
    case "sub_max_spells_all":
      return kind * kind * level + level * level * kind + random(level * 100 + kind * 100 + level * kind);
      break;

    case "add_max_phy":
      return level * 100 + kind * kind * 5 + random(kind * 100 + level * level * 5);
      break;
    case "sub_max_phy":
      return kind * 50 + level * level * 2 + random(level * 50 + kind * kind * 2);
      break;
      //五行效果类
    case "master_jin":
    case "master_mu":
    case "master_shui":
    case "master_huo":
      return level * 100 + kind * kind * 5 + random(kind * 100 + level * level * 5);
      break;
    case "master_resist_jin":
    case "master_resist_mu":
    case "master_resist_shui":
    case "master_resist_huo":
      return kind * 100 + level * kind * 5 + random(level * 100 + level * kind * 5);
      break;
      //战斗效果类	
    case "combat_blood_kee":
    case "combat_blood_force":
    case "combat_blood_mana":
      return kind * 100 + kind * kind * 5 + random(level * 100 + level * level * 5);
      break;
    case "combat_double_damage":
      return level * level * level + kind * 100 + random(kind * kind * kind + 10 * level * kind);
      break;
    case "combat_ignore_magic":
    case "combat_ignore_armor":
      return kind * kind * kind + level * 100 + random(level * level * level + 10 * level * kind);
      break;
    case "combat_ignore_phy":
      return kind * kind * 5 + level * 50 + random(level * level * level + 5 * level * kind);
      break;
    case "combat_hit_kee":
    case "combat_hit_sen":
      return 300 + level * 30 + random(level * 50);
      break;
    case "feedback_damage":
      return level * level * 3 + kind * kind * 5 + random(level * 50 + kind * 50);
      break;
      //人物等级类
    case "add_armor_by_level":
      return 2 + level / 3 + random(kind);
      break;
    case "add_max_armor_by_level":
      return 100 + random(kind * 100 + level * 50);
      break;
    case "add_weapondam_by_level":
      return 2 + (kind + 1) / 3 + random((level + 1) / 2);
      break;
    case "add_attack_by_level":
      return 1 + level / 3 + random((kind + 1) / 3);
      break;
    case "add_defense_by_level":
      return 1 + level / 3 + random((kind + 1) / 3);
      break;
    case "add_magic_by_level":
      return 1 + (kind * kind / 20) + random((level + 1) / 2);
      break;
    case "add_huo_by_level":
      return 1 + (level + 1) / 2 + random(kind / 2);
      break;
    case "add_mu_by_level":
      return 1 + (level + 1) / 4 + random((kind + 1) / 4);
      break;
    case "add_shui_by_level":
      return 1 + (level + 1) / 3 + random((kind + 1) / 3);
      break;
    case "add_jin_by_level":
      return 1 + random((level + 1) / 3 + kind);
      break;
    case "add_max_magic_by_level":
      return kind * kind * kind / 2 + random(kind * kind * kind + level * level * level) / 2;
      break;
    case "add_max_huo_by_level":
      return kind * kind * kind + random(level * level * level);
      break;
    case "add_max_mu_by_level":
      return kind * kind * kind + random(level * level * level);
      break;
    case "add_max_shui_by_level":
      return kind * kind * kind + random(level * level * level);
      break;
    case "add_max_jin_by_level":
      return 100 + random(kind * kind * kind + level * level * level);
      break;

    case "sub_magic_by_level":
      return (kind * kind / 8) + random(level);
      break;
    case "sub_huo_by_level":
      return level * 3 / 2 + random(kind);
      break;
    case "sub_mu_by_level":
      return (level + 1) / 2 + random(kind + 1);
      break;
    case "sub_shui_by_level":
      return (level + 1) + random(kind);
      break;
    case "sub_jin_by_level":
      return (level + 1) + random(2 * kind);
      break;
    case "sub_max_magic_by_level":
      return kind * kind * kind / 2 + random(kind * kind * kind + level * level * level) / 2;
      break;
    case "sub_max_huo_by_level":
      return kind * kind * kind + random(level * level * level);
      break;
    case "sub_max_mu_by_level":
      return kind * kind * kind + random(level * level * level);
      break;
    case "sub_max_shui_by_level":
      return kind * kind * kind + random(level * level * level);
      break;
    case "sub_max_jin_by_level":
      return 100 + random(kind * kind * kind + level * level * level);
      break;
    case "magic_find_by_level":
      return kind * kind + level * level / 3 + random(kind * kind + level * level);
      break;
    case "add_kee_by_level":
    case "add_sen_by_level":
      return kind + (level + 1) / 2 + random(kind * level);
      break;
    case "add_force_by_level":
    case "add_mana_by_level":
      return kind + level / 3 + random(kind * kind);
      break;
    case "force_by_level":
    case "spells_by_level":
      return (kind + 1) / 3 + random(level / 3);
      break;
    default:
      return 1;
  }


}
