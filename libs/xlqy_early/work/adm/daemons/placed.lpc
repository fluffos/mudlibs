private int _random_place(object me, object owner) {
  int i, j, k;
  object newob;
  mixed *file, exit;
  string dirs;

  if (!sizeof(dirs1)) {
    return 0;
  }

  i = random(sizeof(dirs1));
  dirs = keys(dirs1)[i];

  file = get_dir(dirs + "/*.lpc", -1);
  if (!sizeof(file)) {
    return 0;
  }

  for (k = 0; k < 30; k++) {
    j = random(sizeof(file));
    if (file[j][1] <= 0) {
      continue;
    }

    newob = load_object(dirs + "/" + file[j][0]);
    if (!newob) {
      continue;
    }

    if (!newob->valid_fight()
      || newob->query("no_mieyao")
      || !(exit = newob->query("exits"))
      || sizeof(exit) < 1
      || !newob->query("outdoors")) {
      continue;
    }

    if (me->move(newob)) {
      owner->set_temp("guai/place", dirs1[dirs]);
      owner->set_temp("guai/location", dirs + "/" + file[j][0]);
      me->set_temp("guai/place", dirs1[dirs]);
      me->set_temp("guai/location", dirs + "/" + file[j][0]);
      message_vision("$N走了过来。\n", me);
      return 1;
    }
  }

  return 0;
}

int random_place(object me, object owner, int maxplace) {
  int i;

  for (i = 0; i < maxplace; i++) {
    if (0 != _random_place(me, owner)) {
      return 1;
    }
  }

  return 0;
}

private mapping _random_npc() {
  int i, j, k;
  object newob;
  mixed *file, exit;
  object targetnpc, env;
  mapping result = ([]);
  string dirs;

  if (!sizeof(dirs1)) {
    write("1\n");
    return 0;
  }

  i = random(sizeof(dirs1));    // pick up one directory
  dirs = keys(dirs1)[i];

  file = get_dir(dirs + "/*.lpc", -1);
  if (!sizeof(file)) {
    write("2\n");
    return 0;
  }

  for (k = 0; k < 30; k++) {  // try 30 times
    j = random(sizeof(file));

    if (file[j][1] <= 0) {
      continue;
    }

    result["where"] = dirs + "/" + file[j][0];
    newob = load_object(result["where"]);
    if (!newob) {
      continue;
    }
    if (!newob->valid_fight()
      || !(exit = newob->query("exits"))
      || sizeof(exit) < 1
      || !newob->query("outdoors")) {
      continue;
    }

    targetnpc = first_inventory(newob);
    while (targetnpc) {
      if (living(targetnpc) && targetnpc->is_character()
        && !userp(targetnpc) && !targetnpc->query("taskguai")
        && !targetnpc->query("invoker") && "人类" == targetnpc->query("race")
        && !targetnpc->query("current_player")) {
        break;
      }

      targetnpc = next_inventory(targetnpc);
    }

    if (!targetnpc) {
      continue;
    }

    result["env"] = environment(targetnpc);
    result["targetnpc"] = targetnpc;

    return result;
  }

  return 0;
}

mapping random_npc(int maxnpc) {
  int i;
  mapping result;

  for (i = 0; i < maxnpc; i++) {
    if (result = _random_npc()) {
      return result;
    }
  }

  return 0;
}
