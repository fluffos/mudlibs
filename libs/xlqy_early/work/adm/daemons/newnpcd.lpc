void set_period(object me, int period);
int query_period(object me);
int query_lastcmd(object me);
mapping query_jzeffect(object me);
int query_maxattack(object me);
void set_maxattack(object me, int attack);

private nosave string *my_title = ({
  "魑魅魍魉", "花天酒地", "酒肉穿肠过", "无法无天", "藐视众生", "低调奢华", "高富帅", "屌丝", "穷途末路"
});

//定义自己使用绝招的顺序，数字越小，优先级越高
private nosave mapping my_jzeffect = ([
  //绝招效果      使用概率
  0: ({ JZ_BUSY, 50 }),
  1: ({ JZ_FENGMO, 50 }),
  2: ({ JZ_JINZHOU, 50 }),
  3: ({ JZ_WEAPON, 50 }),
  4: ({ JZ_EQUIP, 50 }),
  5: ({ JZ_POWERUP, 50 }),
  6: ({ JZ_HELPER, 50 }),
  7: ({ JZ_KEEWOUND, 50 }),
  8: ({ JZ_SENWOUND, 50 }),
  9: ({ JZ_GINWOUND, 50 }),
  10: ({ JZ_KEECHE, 50 }),
  11: ({ JZ_SENCHE, 50 }),
  12: ({ JZ_GINCHE, 50 }),
  13: ({ JZ_KEEPHY, 50 }),
  14: ({ JZ_SENPHY, 50 }),
  15: ({ JZ_GINPHY, 50 }),
  16: ({ JZ_BIQI, 50 }),
  17: ({ JZ_FORCE, 50 }),
  18: ({ JZ_MANA, 50 }),
  19: ({ JZ_ATMAN, 50 }),
  20: ({ JZ_NOMOVE, 50 }),
  21: ({ JZ_CONDITION, 50 }),
  22: ({ JZ_GROUP, 50 }),
]);

private string generate_color() {
  string *color_for = ({
    HIB,
    HIG,
    HIY,
    HIM,
    HIC,
    HIW,
    BLK,
    RED,
    GRN,
    YEL,
    BLU,
    MAG,
    CYN,
    WHT,
    ""
  });
  string *color_back = ({
    HBRED,
    HBGRN,
    HBYEL,
    HBBLU,
    HBMAG,
    HBCYN,
    HBWHT,
    BBLK,
    BGRN,
    BYEL,
    BBLU,
    BMAG,
    BCYN,
    ""
  });

  if (random(2)) {
    return color_for[random(sizeof(color_for))] + color_back[random(sizeof(color_back))];
  }

  return BLINK + color_for[random(sizeof(color_for))] + color_back[random(sizeof(color_back))];
}

private string generate_title() {
  return generate_color() + my_title[random(sizeof(my_title))] + NOR;
}

void setup_basic(object who) {
  who->set_name("妖怪", ({ "yao guai" }));
  if (random(2)) {
    who->set("gender", "男性");
  } else {
    who->set("gender", "女性");
  }

  who->set("age", 20 + random(80));
  who->set("class", "yao");
  who->set("race", "人类");
  who->set("attitude", "heroism");

  who->set("max_force", 1000);
  who->set("max_mana", 1000);
  who->set("max_atman", 1000);
  who->set("force", 2 * who->query("max_force"));
  who->set("mana", 2 * who->query("max_mana"));
  who->set("atman", 2 * who->query("max_atman"));

  who->set("combat_exp", 200000);
  who->set("daoxing", 200000);

  who->set("limbs", ({
    "头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂",
    "右臂", "左爪", "右爪", "腰间", "小腹", "前腿", "后腿",
    "前爪", "后爪" }));

  who->set("food", 10000);
  who->set("water", 10000);
  who->set_weight(30000);

  who->set("no_steal", 1);
  who->set("env/no_accept", "YES");
}

int random_move(object me) {
  if (me) {
    return NPC_D->random_move(me);
  }

  return 1;
}

private void select_weapon(object me, string type) {
  string weaponfile;
  object weapon;

  switch (type) {
    case "sword":
      weaponfile = "/d/obj/weapon/sword/changjian";
      break;
    case "stick":
      weaponfile = "/d/obj/weapon/stick/bang";
      break;
    case "rake":
      weaponfile = "/d/obj/weapon/rake/rake";
      break;
    case "whip":
      weaponfile = "/d/obj/weapon/whip/whip";
      break;
    case "blade":
      weaponfile = "/d/obj/weapon/blade/blade";
      break;
    case "spear":
      weaponfile = "/d/obj/weapon/spear/yinqiang";
      break;
    case "staff":
      weaponfile = "/d/city/npc/obj/staff";
      break;
    case "hammer":
      weaponfile = "/d/obj/weapon/hammer/hammer";
      break;
    case "force":
    case "spells":
    case "dodge":
    case "unarmed":
    case "parry":
    case "":
      return;
    default:
      LOG_ERROR("ERROR weapon " + type + "!\n");
      return;
  }

  weapon = me->carry_object(weaponfile);

  if (weapon) {
    weapon->wield();
#ifdef NEWNPC_DEBUG
    tell_room(environment(), me->query("name") + "变出了" + HIR + weapon->query("name") + NOR "。\n");
#endif
  }

  return;
}

void full_me(object me) {
  me->set("food", 10000);
  me->set("water", 10000);
  me->set("max_force", (int)me->query_max_force());
  me->set("max_mana", (int)me->query_max_mana());
  me->set("max_atman", (int)me->query_max_atman());
  me->set("force", 2 * (int)me->query("max_force"));
  me->set("mana", 2 * (int)me->query("max_mana"));
  me->set("atman", 2 * (int)me->query("max_atman"));
  me->set("force_factor", me->query_max_enforce());
  me->set("mana_factor", me->query_max_enchant());
  me->set("lingli_factor", me->query_max_jialing());

  return;
}

private void do_attack(object me, string cmd) {
  me->command(cmd);
  me->add("current_attack", 1);
}

private void juezhao_help(object me, string skill) {
  mapping skillsmap = me->query_temp("maporigin");
  string *helper;
  int i, count;

  me->map_skill("parry", skill);

  if (!undefinedp(skillsmap[skill]) && !undefinedp(skillsmap[skill][INDEX_HELPCMD])) {
    helper = explode(skillsmap[skill][INDEX_HELPCMD], ";");
    count = sizeof(helper);

    for (i = 0; i < count; i++) {
#ifdef NEWNPC_DEBUG
      me->command("say 准备" + helper[i] + "!");
#endif
      me->command(helper[i]);
    }
  }
}

private int select_juezhao(object me, int effect, object target) {
  mapping skillsmap = me->query_temp("maptouse/" + effect);
  string *effskills;
  string useskill;
  string *effjuezhao;
  string usejuezhao;
  object *inv;
  int i, count;
  object weapon;
  mapping skillcfg;

  if (!skillsmap || 0 >= sizeof(skillsmap)) {
    return 1;
  }

#ifdef NEWNPC_DEBUG
  me->command("say 我要" + NPCSCHOOL_D->get_effectname(effect));
#endif

  effskills = keys(skillsmap);
  useskill = effskills[random(sizeof(effskills))];
  effjuezhao = keys(skillsmap[useskill]);
  usejuezhao = effjuezhao[random(sizeof(effjuezhao))];

  juezhao_help(me, useskill);

#ifdef NEWNPC_DEBUG
  me->command("say 哈哈，选择" + useskill + "的" + usejuezhao + "用于" + NPCSCHOOL_D->get_effectname(effect) + "!");
#endif

  skillcfg = me->query_temp("maporigin/" + useskill);
  if (!undefinedp(skillcfg[INDEX_JUEZHAO]) &&
    !undefinedp(skillcfg[INDEX_JUEZHAO][usejuezhao]) &&
    !undefinedp(skillcfg[INDEX_JUEZHAO][usejuezhao][INDEX_PREPARE])) {
    if (stringp(skillcfg[INDEX_JUEZHAO][usejuezhao][INDEX_PREPARE])) {
      effskills = explode(skillcfg[INDEX_JUEZHAO][usejuezhao][INDEX_PREPARE], ";");
      count = sizeof(effskills);
      for (i = 0; i < count; i++) {
#ifdef NEWNPC_DEBUG
        me->command("say 不过要先" + effskills[i] + "!");
#endif
        me->command(effskills[i]);
      }
    } else if (functionp(skillcfg[INDEX_JUEZHAO][usejuezhao][INDEX_PREPARE])) {
      evaluate(skillcfg[INDEX_JUEZHAO][usejuezhao][INDEX_PREPARE], me);
    }
  }

  if (!undefinedp(skillcfg[INDEX_BASICSKILL])) {
    me->map_skill(skillcfg[INDEX_BASICSKILL], useskill);

    inv = all_inventory(me);
    weapon = me->query_temp("weapon");
    if ("unarmed" == skillcfg[INDEX_BASICSKILL]) {
      if (weapon) {
        me->command("unwield " + weapon->query("id"));
      }

      do_attack(me, "perform " + usejuezhao);
    } else if ("force" == skillcfg[INDEX_BASICSKILL]) {
      do_attack(me, "exert " + usejuezhao);
    } else if ("spells" == skillcfg[INDEX_BASICSKILL]) {
      do_attack(me, "cast " + usejuezhao);
    } else if ("dodge" == skillcfg[INDEX_BASICSKILL]) {
      do_attack(me, "perform dodge." + usejuezhao);
    } else {
      if (weapon) {
        me->command("unwield " + weapon->query("id"));
      }

      count = sizeof(inv);
      for (i = 0; i < count; i++) {
        if (inv[i]->query("skill_type") == me->query_temp("maporigin/" + useskill)[INDEX_SKILLWEAPON]) {
          me->command("wield " + inv[i]->query("id"));
          break;
        }
      }
      if (i >= count) {
        select_weapon(me, me->query_temp("maporigin/" + useskill)[INDEX_SKILLWEAPON]);
      }

      do_attack(me, "perform " + usejuezhao);
    }
  }

  if (JZ_HEAL == effect) {
    me->command("exert recover");
    me->command("exert refresh");
    //TODO: 待处理
    if (target) {
      me->command("kill " + target->query("id"));
    }
  }

  if (!undefinedp(skillcfg[INDEX_JUEZHAO]) &&
    !undefinedp(skillcfg[INDEX_JUEZHAO][usejuezhao]) &&
    !undefinedp(skillcfg[INDEX_JUEZHAO][usejuezhao][INDEX_POSTACT])) {
    effskills = explode(skillcfg[INDEX_JUEZHAO][usejuezhao][INDEX_POSTACT], ";");
    count = sizeof(effskills);
    for (i = 0; i < count; i++) {
#ifdef NEWNPC_DEBUG
      me->command("say 然后还要" + effskills[i] + "!");
#endif
      me->command(effskills[i]);
    }
  }
}

int random_attack(object me) {
  object target;
  int *juezhao;
  int i, count, effect;
  mixed con;
  mapping my_jzeffect;

  if (!me->is_fighting() || !living(me) || (query_period(me) > (time() - query_lastcmd(me)))) {
    return 1;
  }

  full_me(me);

  if (me->is_busy()) {
    return 1;
  }

  target = offensive_target(me);
  if (!target) {
    return 1;
  }

  if (((int)me->query("kee") * 100 / (int)me->query("max_kee")) <= 50
    || ((int)me->query("sen") * 100 / (int)me->query("max_sen")) <= 50
    || ((int)me->query("gin") * 100 / (int)me->query("max_gin")) <= 50) {
    select_juezhao(me, JZ_HEAL, target);
  }

  me->set("current_attack", 0);

  my_jzeffect = query_jzeffect(me);
  i = sizeof(my_jzeffect);
  for (count = 0; count < i; count++) {
    if (me->is_busy() || me->query("current_attack") >= query_maxattack(me)) {
      break;
    }

    if (random(100) >= (int)(my_jzeffect[count][1])) {
      continue;
    }

    effect = 0;

    switch (my_jzeffect[count][0]) {
      case JZ_BUSY:
        if (!target->is_busy()) {
          effect = my_jzeffect[count][0];
        }
        break;
      case JZ_WEAPON:
        if (target->query_temp("weapon")) {
          effect = my_jzeffect[count][0];
        }
        break;
      case JZ_KEEPHY:
        effect = my_jzeffect[count][0];
        break;
      case JZ_KEECHE:
        effect = my_jzeffect[count][0];
        break;
      case JZ_FORCE:
        if (0 < target->query("force") || 0 < target->query("max_force")) {
          effect = my_jzeffect[count][0];
        }
        break;
      case JZ_MANA:
        if (0 < target->query("mana") || 0 < target->query("max_mana")) {
          effect = my_jzeffect[count][0];
        }
        break;
      case JZ_CONDITION:
        con = target->query_entire_conditions();
        if (!con || !mapp(con)) {
          effect = my_jzeffect[count][0];
        }
        break;
      case JZ_ESCAPE:
        break;
      case JZ_EQUIP:
        //TODO: 待处理
        break;
      case JZ_SENPHY:
        effect = my_jzeffect[count][0];
        break;
      case JZ_SENCHE:
        effect = my_jzeffect[count][0];
        break;
      case JZ_POWERUP:
        //TODO: 待处理
        effect = my_jzeffect[count][0];
        break;
      case JZ_HELPER:
        effect = my_jzeffect[count][0];
        break;
      case JZ_KILL:
        break;
      case JZ_SELFBUSY:
        break;
      case JZ_SELFNOMOVE:
        break;
      case JZ_KEEWOUND:
        effect = my_jzeffect[count][0];
        break;
      case JZ_SENWOUND:
        effect = my_jzeffect[count][0];
        break;
      case JZ_HEAL:
        effect = my_jzeffect[count][0];
        break;
      case JZ_NOMOVE:
        if (!target->is_busy() && !target->query_temp("no_move")) {
          effect = my_jzeffect[count][0];
        }
        break;
      case JZ_FENGMO:
      case JZ_BIQI:
      case JZ_JINZHOU:
        if (!target->is_busy()) {
          effect = my_jzeffect[count][0];
        }
        break;
      case JZ_PUSH:
      case JZ_PEACE:
        break;
      case JZ_GROUP:
        effect = my_jzeffect[count][0];
        break;
      case JZ_GINPHY:
        effect = my_jzeffect[count][0];
        break;
      case JZ_GINCHE:
        effect = my_jzeffect[count][0];
        break;
      case JZ_ATMAN:
        if (0 < target->query("atman") || 0 < target->query("max_atman")) {
          effect = my_jzeffect[count][0];
        }
        break;
      case JZ_GINWOUND:
        effect = my_jzeffect[count][0];
        break;
      default:
        break;
    }

    if (0 < effect) {
      select_juezhao(me, effect, target);
    }
  }

  me->set("lastcmd_time", time());

  return 1;
}

private int generate_skill(int skilllvl, int level, int ratio) {
  if (0 == level || 0 == ratio) {
    return skilllvl;
  }

  if (ratio <= skilllvl) {
    return skilllvl + skilllvl / ratio * level;
  } else {
    return skilllvl + skilllvl * level / ratio;
  }
}

private void set_skills(object me, object who, int level, int ratio, string menpai, int max_level) {
  object weapon;
  mapping mp_skills;
  mapping sk_juezhao;
  string pfmflag;
  string *flagarray;
  mapping flagop;
  mapping juezhao;
  string *jzarray;
  int count, count2, effect, i, j;
  int *sk_level;
  int set_level = 0;
  string *basic = LEVEL_D->query_basicskill();

  set_level = generate_skill(max_level, level, ratio);

  count = sizeof(basic);
  for (i = 0; i < count; i++) {
    if (!SKILL_D(basic[i])->query_npc_ignore()) {
      me->set_skill(basic[i], set_level);
    }
    LEVEL_D->set_ob_skill_level(me, basic[i], LEVEL_D->query_max_skill_level());
  }

  //获得该门派对应的mapping
  mp_skills = ("/adm/daemons/family/" + FAMILY_D->query_family_path(menpai))->query_family_cfg();
  if (!mp_skills) {
    LOG_ERROR("ERROR MENPAI " + menpai + "!\n");
    return;
  }

  me->set("family/family_name", menpai);

  //是否有需要设置的绝招标志
  pfmflag = mp_skills[INDEX_PFMFLAG];
  if (pfmflag) {
    //多组标志，可以;进行分隔
    flagarray = explode(pfmflag, ";");
    count = sizeof(flagarray);

    while (count) {
      count--;
      if (!flagarray[count] || "" == flagarray[count]) {
        LOG_ERROR("ERROR empty flag for " + menpai + "!\n");
        continue;
      }

      //每组标志和值以:分隔
      jzarray = explode(flagarray[count], ":");
      if (2 > sizeof(jzarray)) {
        me->set(jzarray[0], 1);
      } else {
        me->set(jzarray[0], jzarray[1]);
      }
    }
  }

  //是否有需要设置的技能
  sk_juezhao = mp_skills[INDEX_SKILLS];
  if (sk_juezhao) {
    me->set_temp("maporigin", sk_juezhao);

    flagarray = keys(sk_juezhao);
    count = sizeof(flagarray);
    //所有技能
    while (count) {
      reset_eval_cost();
      count--;
      if (who && SKILL_D(flagarray[count])->query_npc_ignore()) {
        flagop = sk_juezhao[flagarray[count]];

        if (flagop[INDEX_BASICSKILL]) {
          //设置基本技能等级，并完成激发
          LEVEL_D->set_ob_skill_level(
            me,
            flagop[INDEX_BASICSKILL],
            LEVEL_D->query_max_skill_level()
          );
          me->map_skill(flagop[INDEX_BASICSKILL], flagarray[count]);
        }
      } else {
        //设置特殊技能等级
        me->set_skill(flagarray[count], set_level);

        flagop = sk_juezhao[flagarray[count]];

        if (flagop[INDEX_BASICSKILL]) {
          //设置基本技能等级，并完成激发
          me->set_skill(flagop[INDEX_BASICSKILL], set_level);
          LEVEL_D->set_ob_skill_level(
            me,
            flagop[INDEX_BASICSKILL],
            LEVEL_D->query_max_skill_level()
          );
          me->map_skill(flagop[INDEX_BASICSKILL], flagarray[count]);
        }
      }

      if (flagop[INDEX_SKILLWEAPON]) {
        //变武器
        select_weapon(me, flagop[INDEX_SKILLWEAPON]);
      }

      juezhao = flagop[INDEX_JUEZHAO];
      if (juezhao) {
        //获取所有绝招效果
        sk_level = NPCSCHOOL_D->get_effect();

        jzarray = keys(juezhao);
        j = sizeof(jzarray);

        while (j) {
          j--;
          effect = (int)(juezhao[jzarray[j]][INDEX_JZEFFECT]);
          max_level = (int)(juezhao[jzarray[j]][INDEX_JZEFFECT2]);
          max_level &= 0x3FFFFFFF;

          count2 = sizeof(sk_level);
          for (i = 0; i < count2; i++) {
            if ((0 < effect) && !NPCSCHOOL_D->is_ignoreeffect(effect)) {
              if (effect & sk_level[i]) {
                pfmflag = "maptouse/" + sk_level[i] + "/" + flagarray[count] + "/" + jzarray[j];
                me->set_temp(pfmflag, 1);
              }
            }

            if ((0 < max_level) && !NPCSCHOOL_D->is_ignoreeffect(max_level)) {
              if (max_level & sk_level[i]) {
                pfmflag = "maptouse/" + (sk_level[i] | 0x40000000) + "/" + flagarray[count] + "/" + jzarray[j];
                me->set_temp(pfmflag, 1);
              }
            }
          }
        }
      }
    }
  }
}

private void full_skills(object me, object who, int level, int ratio, string menpai) {
  int count, max_level;
  mapping skill;
  string *sk_name;
  int sk_level;

  if (!who) {
    //没有who，表示直接设置npc的技能
    set_skills(me, who, 0, 0, menpai, level);
    return;
  }

  skill = who->query_skills();
  count = sizeof(skill);
  if (0 < count) {
    sk_name = keys(skill);
    sk_level = 1;
    max_level = 1;

    while (count) {
      count--;
      sk_level = who->query_skill(sk_name[count], 1);

      //literate等不参与计算的技能，直接设置等级
      if (SKILL_D(sk_name[count])->query_npc_ignore()) {
        me->set_skill(sk_name[count], generate_skill(sk_level, level, ratio));
        continue;
      }

      //找出对方的最高技能
      if (sk_level > max_level) {
        max_level = sk_level;
      }
    }
  } else {
    max_level = 100;
  }

  set_skills(me, who, level, ratio, menpai, max_level);

  return;
}

void setname(object me, string name, string *id) {
  me->set_name(name, id);
  me->set_living_name(id[0]);
}

void setup_again(object me) {
  me->set("max_force", (int)me->query_max_force());
  me->set("max_mana", (int)me->query_max_mana());
  me->set("max_atman", (int)me->query_max_atman());

  me->set("force_factor", me->query_max_enforce());
  me->set("mana_factor", me->query_max_enchant());
  me->set("lingli_factor", me->query_max_jialing());

  me->delete("max_kee");
  me->delete("max_sen");
  me->delete("max_gin");

  me->setup();

  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("eff_kee"));

  me->set("eff_sen", me->query("max_sen"));
  me->set("sen", me->query("eff_sen"));

  me->set("eff_gin", me->query("max_gin"));
  me->set("gin", me->query("eff_gin"));
}

private void copy_status(object me, object who, int level, int ratio, string menpai) {
  int origin, combat_exp;
  string *gift_name = ({ "age", "kar", "con", "per", "cps", "spi", "int", "cor", "str" });
  int count = sizeof(gift_name);

  if (!who) {
    //没有who，则直接设置npc的数据
    setup_again(me);
    return;
  }

  me->set("owner", who);
  me->set("taskguai", 1);

  if (0 > level || 0 > ratio) {
    me->set_reborn_times(who->query_reborn_times() + who->query_reborn_times() * level / ratio);
    me->set("level", who->query("level") + who->query("level") * level / ratio);
  } else {
    me->set_reborn_times(who->query_reborn_times());
    me->set("level", who->query("level"));
  }

  origin = (int)who->query("combat_exp");
  if (0 >= ratio) {
    combat_exp = origin;
  } else if (ratio <= origin) {
    combat_exp = origin + origin / ratio * level;
  } else {
    combat_exp = origin + origin * level / ratio;
  }
  me->set("combat_exp", combat_exp);

  origin = (int)who->query("daoxing");
  if (0 >= ratio) {
    combat_exp = origin;
  } else if (ratio <= origin) {
    combat_exp = origin + origin / ratio * level;
  } else {
    combat_exp = origin + origin * level / ratio;
  }
  me->set("daoxing", combat_exp);

  while (count) {
    count--;

    origin = (int)who->query(gift_name[count]);
    if (0 >= ratio) {
      combat_exp = origin;
    } else if (ratio <= origin) {
      combat_exp = origin + origin / ratio * level;
    } else {
      combat_exp = origin + origin * level / ratio;
    }
    me->set(gift_name[count], combat_exp);
  }

  setup_again(me);
}

varargs void generate_me(
  object me,
  object who,
  int level,
  int ratio,
  string menpai,
  int chance,
  int combatchance,
  string name,
  string *id,
  int userflag
) {
  object medicine;

  if (!menpai) {
    menpai = "月宫";
  }

  //带上金疮药
  medicine = me->carry_object("/d/obj/drug/jinchuang");
  if (medicine) {
    medicine->set_amount(10);
  }

  //设置NPC的名称和id
  if (1 == userflag) {
    setname(me, who->query("name") + "的" + name,
      ({ who->query("id") + " " + id[0] }));
  } else {
    setname(me, name, id);
  }

  //设置技能
  full_skills(me, who, level, ratio, menpai);
  reset_eval_cost();

  //设置武学、道行、属性
  copy_status(me, who, level, ratio, menpai);

  //设置个人状态
  full_me(me);
  reset_eval_cost();

  set_period(me, 3);
  set_maxattack(me, 6);

  me->set("chat_chance", chance);
  me->set("chat_msg", ({
    (: call_other, __FILE__, "random_move", me :),
  }));

  me->set("chat_chance_combat", (int)combatchance);
  me->set("chat_msg_combat", ({
    (: call_other, __FILE__, "random_attack", me :),
  }));

  //设置上次攻击时间
  me->set("lastcmd_time", time());
}

int query_period(object me) {
  return me->query("attack_period");
}

int query_lastcmd(object me) {
  return me->query("lastcmd_time");
}

int query_maxattack(object me) {
  return me->query("max_attack");
}

mapping query_jzeffect(object me) {
  return my_jzeffect;
}

void set_period(object me, int period) {
  me->set("attack_period", period);
  me->set("lastcmd_time", time());
}

void set_maxattack(object me, int attack) {
  me->set("max_attack", attack);
}

#define MAX_OPPENENT 4
int return_home(object me, object home) {
  object *enemy_list;
  int i, flag = 0;

  // Are we at home already?
  if (!me || !environment(me) || environment(me) == home) {
    return 1;
  }

  // Are we able to leave?
  if (!living(me)
    || me->query_temp("no_return")) {
    return 0;
  }

  //added by mon. 7/17/97
  // modified by tool
  if (me->is_fighting()) {
    enemy_list = me->query_enemy();
    for (i = 0; i < sizeof(enemy_list); ++i) {
      if (!enemy_list[i]) {
        continue;
      }

      if (sizeof(enemy_list[i]->query_enemy()) > MAX_OPPENENT) {
        message("vision", "\n" + me->name() + "纵身向后一跃，拱手道：阁下武艺不凡，佩服，佩服！咱们后会有期！\n\n",
          environment(me), me);
        enemy_list[i]->remove_killer(me);
        me->remove_enemy(enemy_list[i]);
        flag = 1;
        break;
      }
    }

    if (!flag) {
      return 0;
    }
  }

  // Leave for home now.
  message("vision", me->name() + "急急忙忙地离开了。\n", environment(me), me);

  return me->move(home);
}
