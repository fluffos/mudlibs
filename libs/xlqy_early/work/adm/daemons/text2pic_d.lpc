varargs string Display(
  string str,
  int size,
  string fill,
  string bg,
  string fcolor,
  string bgcolor
) {
  int offset;
  int *mask = ({ 0x80, 0x40, 0x20, 0x10, 0x8, 0x4, 0x2, 0x1 });
  int scale;
  string char;
  string *out;

  if (!size) {
#ifdef AUTO_SIZE
    size = AUTO_SIZE;
#else
    error("TEXT to PIC need size\n");
#endif
  }

  out = allocate(size);
  out = map_array(out, (: $1 = "" :));
  size *= 2;

  if (!fill || sizeof(fill) != sizeof(bg)) {
    fill = DEFAULT_FILL;
  }

  if (!fcolor) {
    fcolor = DEFAULT_FCOLOR;
  }

  if (!bg || sizeof(fill) != sizeof(bg)) {
    bg = DEFAULT_BG;
  }

  if (!bgcolor) {
    bgcolor = DEFAULT_BGCOLOR;
  }

  for (int k = 0; k < sizeof(str); k++) {
    if (mask[0] & str[k]) {
      offset = size * ((atoi(sprintf(
        "%d",
        str[k]
      )) - 0xA1) * 94 + atoi(sprintf("%d", str[k + 1])) - 0xA1);
      char = read_bytes(HZK + (size / 2), offset, size);
      k++;
      scale = 2;
    } else {
      offset = str[k] * (size / 2);
      char = read_bytes(ASC + (size / 2), offset, (size / 2));
      scale = 1;
    }

    if (!sizeof(char)) {
      error("TEXT to PIC can't read bytes from character lib\n");
    }

    for (int i = 0; i < sizeof(char); i++) {
      for (int j = 0; j < 8; j++) {
        if (mask[j] & char[i]) {
          out[i / scale] += fcolor + fill;
        } else {
          out[i / scale] += bgcolor + bg;
        }
      }
    }

    for (int i = 0; i < sizeof(out); i++) {
      out[i] = replace_string(out[i], fill + fcolor + fill, fill + fill);
      out[i] = replace_string(out[i], bg + bgcolor + bg, bg + bg);
    }
  }

  return implode(out, "\n") + NOR;
}

mapping random_string() {
  int size = output_size[random(sizeof(output_size))];
  string forefill, backfill;
  string forecolor, backcolor;
  string content;
  int i, j;
  mapping result = ([]);

  if (random(3)) {
    forefill = output_fill[random(sizeof(output_fill))];

    for (i = 0; i < 30; i++) {
      backfill = output_fill[random(sizeof(output_fill))];

      if (forefill != backfill) {
        break;
      }
    }
  }

  if (random(3)) {
    forecolor = output_color[random(sizeof(output_color))];

    for (i = 0; i < 30; i++) {
      backcolor = output_color[random(sizeof(output_color))];

      if (forecolor != backcolor) {
        break;
      }
    }

    backcolor = NOR + backcolor;

    if (!random(3)) {
      forecolor = BLINK + forecolor;
    }
  }

  if (random(3)) {
    i = 1 + random(9);
    if (1000 > i && !random(4)) {
      i = i * 10 + 1 + random(9);
    }
    if (1000 > i && !random(4)) {
      i = i * 10 + 1 + random(9);
    }

    if (random(3)) {
      j = 1 + random(9);
      if (1000 > j && !random(4)) {
        j = j * 10 + 1 + random(9);
      }
      if (1000 > j && !random(4)) {
        j = j * 10 + 1 + random(9);
      }

      switch (random(5)) {
        case 0:
          content = "" + i + "+" + j;
          i += j;
          result["rand_str"] = "" + i;
          break;

        case 1:
          content = "" + i + "-" + j;
          if (i >= j) {
            i -= j;
            result["rand_str"] = "" + i;
          } else {
            j -= i;
            result["rand_str"] = "-" + j;
          }
          break;

        case 2:
          content = "" + i + "x" + j;
          i *= j;
          result["rand_str"] = "" + i;
          break;

        case 3:
          while (i < 100) {
            i = i * 10 + 1 + random(9);
          }
          while (j > 100) {
            j = j / 10;
          }
          content = "" + i + "/" + j;
          i /= j;
          result["rand_str"] = "" + i;
          break;

        default:
          while (i < 100) {
            i = i * 10 + 1 + random(9);
          }
          while (j > 100) {
            j = j / 10;
          }
          content = "" + i + "%" + j;
          i %= j;
          result["rand_str"] = "" + i;
          break;
      }
    } else {
      i = i * 10 + 1 + random(9);
      if (1000000 > i && !random(4)) {
        i = i * 10 + 1 + random(9);
      }
      if (1000000 > i && !random(4)) {
        i = i * 10 + 1 + random(9);
      }
      content = "" + i;
      result["rand_str"] = content;
    }
  } else {
    content = answer_str[random(sizeof(answer_str))];

    if (3 > sizeof(content) && !random(4)) {
      content += answer_str[random(sizeof(answer_str))];
    }
    if (3 > sizeof(content) && !random(4)) {
      content += answer_str[random(sizeof(answer_str))];
    }

    result["rand_str"] = content;
    size = 16;
  }

  result["output"] = "/adm/daemons/text2pic_d"->Display(
    content,
    size,
    forefill,
    backfill,
    forecolor,
    backcolor
  );

  return result;
}
