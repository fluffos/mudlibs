//modified from glass.c

inherit EQUIP;

void create() {
  set_name("新一代增强型战斗力探测器", ({ "detector", "glass", "device" }));
  set_weight(300);
  set("unit", "个");
  set("long",
    "这是来自「七龙珠」的战斗力探测器，你可以用它来探测(detect)别人\n"
    "的全面战斗力状况。\n");
  set("value", 500);
  set("type", "misc");
  set("apply", ([
    "头部": 0,
  ]));
}

void init() {
  add_action("do_detect", "detect");
}

int do_detect(string arg) {
  object ob, weapon;
  int sk;
  string attack_skill;

  if (arg) {
    ob = present(arg, environment(this_player()));
  } else {
    ob = this_player()->query_opponent();
  }

  if (!ob) {
    return notify_fail("你要探测谁的战斗力？\n");
  }

  weapon = ob->query_temp("weapon");
  if (weapon) {
    if (weapon->query("use_apply_skill")) {
      attack_skill = weapon->query("apply/skill_type");
    } else {
      attack_skill = weapon->query("skill_type");
    }
  } else {
    attack_skill = "unarmed";
  }

  sk = ob->query_skill(attack_skill);

  printf("探测器显示%s的武学是：%d\n",
    ob->query("name"),
    (int)ob->query("combat_exp"));
  printf("探测器显示%s的道行是：%d\n",
    ob->query("name"),
    (int)ob->query("daoxing"));
  printf("探测器显示%s的当前攻击技能有效等级是：%d\n",
    ob->query("name"), sk);
  printf("探测器显示%s的dodge有效等级是：%d\n",
    ob->query("name"), ob->query_skill("dodge"));
  printf("探测器显示%s的parry有效等级是：%d\n",
    ob->query("name"), ob->query_skill("parry"));
  printf("探测器显示%s的当前气血和精神分别是：%d 和 %d\n",
    ob->query("name"), ob->query("kee"), ob->query("sen"));
  printf("探测器显示%s的当前内力和法力分别是：%d 和 %d\n",
    ob->query("name"), ob->query("force"), ob->query("mana"));

  return 1;
}
