#include <armor.h>

inherit "/obj/diablo_ob/diablo_set";

void create() {
  set_name("盾", ({ "shield" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "wood");
    set("unit", "面");
    set("armor_prop/armor", 5);
    set("armor_type", TYPE_SHIELD);
  }
  setup();
}
