#include <armor.h>

inherit "/obj/diablo_ob/diablo_set";

void create() {
  set_name("项链", ({ "necklace" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "silver");
    set("unit", "条");
    set("armor_prop/armor", 1);
    set("armor_type", TYPE_NECK);
  }
  setup();
}
