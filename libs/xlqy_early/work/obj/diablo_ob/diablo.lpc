int check_valid(object equip,object user)
{
        mapping valids;
        string type;
        int low;
        if(equip->query("skill_type"))
                type = equip->query("skill_type");
low = -equip->query("diablo_prop/low_condition");
low = 0;
        
        if( mapp( valids = equip->query("diablo_valid") ) ) 
        {
                string *val=keys(valids);
                for(int i=0;i<sizeof(val);i++)
                {
                        switch(val[i])
                        {
                        case "karma":
                                if(user->query("kar")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "eff_karma":
                                if(user->query_kar()<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "strength":
                                if(user->query("str")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                case "courage":
                                if(user->query("cor")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "eff_strength":
                                if(user->query_str()<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "eff_courage":
                                if(user->query_cor()<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "dodge":
                                if(user->query_skill("dodge",1)<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "eff_dodge":
                                if(user->query_skill("dodge")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "composure":
                                if(user->query("cps")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                 case "eff_composure":
                                if(user->query_cps()<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "constitution":
                                if(user->query("con")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;          
                        case "eff_constitution":
                                if(user->query_con()<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;                       
                        break;
                        case "intelligence":
                                if(user->query("int")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "eff_intelligence":
                                if(user->query_int()<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "spirituality":
if(user->query("spi")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                case "eff_spirituality":
 if(user->query_spi()<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                case "personality":
 if(user->query("per")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "eff_personality":
if(user->query_per()<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "daoxing":
                                if(user->query("daoxing")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "combat_exp":
                                if(user->query("combat_exp")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "level":
                                if(user->query("level")<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;
                        case "skill_level":
                                {
                                        if(valids[val[i]] == "expert")
                                        {       if(!user->query("skill_level/"+type))
                                                        return 0;       
                                        }
                                        else if(valids[val[i]] == "master")
                                        {       if(!user->query("skill_level/"+type)||user->query("skill_level/"+type) == "expert")
                                                        return 0;       
                                        }
                                        else if(valids[val[i]] == "grandmaster")
                                        {       if(user->query("skill_level/"+type)!= "grandmaster")
                                                        return 0;       
                                        }
                                }
                        break;
                        case "skill":
                                if(user->query_skill(type,1)<(valids[val[i]]-valids[val[i]]*low/10000))
                                        return 0;       
                        break;

                        }
                        
                        
                }
        }
        
        return 1;

}
