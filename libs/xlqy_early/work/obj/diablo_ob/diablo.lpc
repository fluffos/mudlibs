#include <ansi.h>
#include <dbase.h>
int enable_sets_prop(string content,int num,object player); //必须有num，否则bug
int disable_sets_prop(string content,int num,object player);
string query_desc(object ob)
{
string msg,temp,pp;
        mapping prop;
        string *type;
        int year,day,hour;
        int flag;
        string str;
        msg="";
        if(ob->query("desc"))
        msg+=ob->query("desc")+"\n";
        temp = CYN"★★★★★★★★★★★★★★"NOR+ob->query("name")+NOR+"("+ob->query("id")+")"+CYN"★★★★★★★★★★★★★★★\n\n"NOR;
        msg +=temp;
        
        flag = 0 ;
        if(ob->query("is_diablo_set"))
        {
                temp = HIG"\n                            固定属性装备\n\n"+NOR;
                 msg += temp;
                temp = HIY"★"NOR+MAG"基本属性："NOR;
                msg += temp;
                if(ob->query("weapon_prop/damage"))
                {       temp = "                武器杀伤力:"+HIC+ob->query("diablo_prop/damage")+NOR+"\n";
                        flag = 1;
                }
                else if(ob->query("armor_prop/armor"))
                        temp = "                盔甲保护力:"+HIC+ob->query("diablo_prop/armor")+NOR+"\n";
                
                msg += temp;
                temp = HIY"★"NOR+MAG"附加属性："NOR;
                msg += temp;
                if(!mapp(prop=ob->query("diablo_fixed"))|| sizeof(prop) < 1)
                        msg +=HIR"              见鬼，怎么可能没附加属性，请联系巫师！\n"NOR;
                else {  
                        type=keys(prop);
                        for(int i=0;i<sizeof(type);i++)
                        {


                                switch(type[i])
                                {
                                                
                                        case "cold_attack":
                                                {
                                                        if(flag)
                                                                msg+="          增加冰系攻击："+HIC+"(5％)+10 "+NOR+"\n";
                                                        else 
                                                                msg+="          增加冰系防御："+HIC+"(3％)+15  "+NOR+"\n";
                                                        break;
                                                }
                                        case "frost_attack":
                                                {
                                                        if(flag)
                                                                msg+="          增加冰系攻击："+HIC+" (10％)+20 "+NOR+"\n";
                                                        else 
                                                                msg+="          增加冰系防御："+HIC+"(5％)+25"+NOR+"\n";
                                                        break;
                                                }
                                        case "icy_attack":
                                                {
                                                        if(flag)
                                                                msg+="          增加冰系攻击："+HIC+"(15％)+25 "+NOR+"\n";
                                                        else 
                                                                msg+="          增加冰系防御："+HIC+"(10％)+30 "+NOR+"\n";
                                                        break;
                                                }
                                        case "bizzard_attack":
                                                {
                                                        if(flag)
                                                                msg+="          增加冰系攻击："+HIC+"(20％)+30"+NOR+"\n";
                                                        else 
                                                                msg+="          增加冰系防御："+HIC+"(15％)+35"+NOR+"\n";
                                                        break;
                                                }
                                        case "bolt_attack":
                                                {
                                                        if(flag)
                                                                msg+="          增加电系攻击："+HIC+"(5％)+15 "+NOR+"\n";
                                                        else 
                                                                msg+="          增加电系防御："+HIC+"(3％)+15         "+NOR+"\n";
                                                        break;
                                                }
                                        case "lightning_attack":
                                                {
                                                        if(flag)
                                                                msg+="          增加电系攻击："+HIC+" (10％)+25         "+NOR+"\n";
                                                        else 
