                }       
                if(type[i] =="add_lucky")
                {
                        
                        user->add_temp("combat/lucky",-diablo[type[i]]);        
                        equip->add_temp("diablo_effect/lucky",-diablo[type[i]]);
                }               

                }
        }
        
        user->save();
    
}
