                        user->add("eff_sen",-equip->query_temp("diablo_effect/add_max_sen"));
                        user->add("max_sen",-equip->query_temp("diablo_effect/add_max_sen"));
                        user->add("sen",-equip->query_temp("diablo_effect/add_max_sen"));
                        
                        user->add("diablo_effect/add_max_sen",-equip->query_temp("diablo_effect/add_max_sen"));
                        equip->delete_temp("diablo_effect/add_max_sen");
                        
                }
                 if(type[i]=="add_max_force")
                 {
                        user->add("max_force",-equip->query_temp("diablo_effect/add_max_force"));
                        user->add("force",-equip->query_temp("diablo_effect/add_max_force"));
                
                        user->add("diablo_effect/add_max_force",-equip->query_temp("diablo_effect/add_max_force"));
                        equip->delete_temp("diablo_effect/add_max_force");
                }
                  if(type[i]=="add_max_mana")
                 {
                        user->add("max_mana",-equip->query_temp("diablo_effect/add_max_mana"));
                        user->add("mana",-equip->query_temp("diablo_effect/add_max_mana"));
                
                        user->add("diablo_effect/add_max_mana",-equip->query_temp("diablo_effect/add_max_mana"));
                        equip->delete_temp("diablo_effect/add_max_mana");
                }
                 if(type[i] =="add_bless")
                {
                        
                        user->add_temp("combat/bless",-equip->query_temp("diablo_effect/bless"));       
                        equip->delete_temp("diablo_effect/bless");
                }       
                if(type[i] =="add_lucky")
                {
                        
                    user->add_temp("combat/lucky",-equip->query_temp("diablo_effect/lucky"));      
                        equip->delete_temp("diablo_effect/lucky");
                }       
                user->add_temp("apply/"+type[i],diablo[type[i]]);       
                
          }
        }
 }
int check_set(object obj,object player,int equip) //put to diablo.c
{
        mapping prop;
        string *type,content;
        int num;
        if(!mapp(prop=obj->query("diablo_fixed"))|| sizeof(prop) < 1)
                return 0;
        else    type=keys(prop);
                content = type[0]; //has only one prop
                
        if(equip == 1) //equip the obj
        {
                player->add_temp("diablo_sets/"+content,1);
                num = player->query_temp("diablo_sets/"+content);
								enable_sets_prop( content, num, player);
                
        }
        else if(equip == -1) //unequip the obj
        {
                num = player->query_temp("diablo_sets/"+content);
								player->add_temp("diablo_sets/"+content,-1); 
								disable_sets_prop( content, num, player);
        }
}
int enable_sets_prop(string content,int num,object player) //必须有num，否则bug
{
       "/obj/diablo_ob/diablo2"->enable_sets_prop(content,num,player);
}
int disable_sets_prop(string content,int num,object player)
{

                
"/obj/diablo_ob/diablo2"->disable_sets_prop(content,num,player);
}
