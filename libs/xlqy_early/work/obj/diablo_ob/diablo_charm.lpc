#include <ansi.h>

inherit ITEM;



void create() {
  set_name(HIY "神符" NOR, ({ "charm" }));
  set_weight(10);
  set("value", 0);
  set("unit", "枚");
  set("charm/id", 1);
  set("identification", 1);
  setup();
}

string long() {
  string msg = "随机装备\n";

  return msg + "/obj/diablo_ob/diablo"->query_desc(this_object());
}


int is_diablo_ob() { return 1; }
int move(object ob) {
  object me = environment();
  if (!::move(ob)) return 0;
  if (me && me->is_character()) {
    catch("/obj/diablo_ob/diablo"->disable(this_object(), me));

  }
  if (ob && ob->is_character()) {
    catch("/obj/diablo_ob/diablo"->enable(this_object(), ob));
  }
  return 1;
}
