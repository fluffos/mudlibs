#include <weapon.h>

inherit DIABLO_OB;

void create()
{
	set_name("琴", ({"muqin","qin"}) );
	set_weight(6000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "具");
		set("material", "wood");
	//	set("long", "这是一具用上好的梧桐木做的古琴。\n");
		set("value", 0);
		set("wield_msg", "$N拿出一具$n，调了调琴弦。\n");
		set("unwield_msg", "$N放下手中的$n。\n");
		set("music_type","qin");
	}
	set("weapon_prop/damage", 1);
	set("flag", TWO_HANDED );
	set("skill_type", "music");
	
/*	if( !query("actions") ) {
		set("actions", (: call_other, WEAPON_D, "query_action" :) );
		set("verbs", ({ "play"}) );
	}
*/	
	setup();
}

