#include <weapon.h>

inherit DIABLO_OB;

void create()
{
        set_name("叉", ({ "fork" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 0);
                set("material", "iron");
        //        set("long", "一柄锋利的钢叉。\n");
                set("wield_msg", "$N抄起一柄$n，还拿衣服擦了擦叉尖。\n");
        }
       set("weapon_prop/damage", 1);
	set("flag",  POINTED);
	set("skill_type", "fork");
/*	if( !query("actions") ) {
		set("actions", (: call_other, WEAPON_D, "query_action" :) );
		set("verbs", ({ "thrust", "pierce" }) );
	}
	*/
        setup();
}


