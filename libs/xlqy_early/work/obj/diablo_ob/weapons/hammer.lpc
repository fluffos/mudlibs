#include <weapon.h>

inherit DIABLO_OB;

void create()
{
        set_name("锤", ({ "hammer" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
          //      set("long", "这是一把沈重的铁锤，打造的相当坚实。\n");
                set("value", 0);
                set("material", "iron");
                set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }
        set("weapon_prop/damage", 1);
	set("flag", TWO_HANDED );
	set("skill_type", "hammer");
/*	if( !query("actions") ) {
		set("actions", (: call_other, WEAPON_D, "query_action" :) );
		set("verbs", ({ "bash", "crush", "slam" }) );
	}
	*/
        setup();
}


