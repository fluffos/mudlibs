
#include <armor.h>
#include <ansi.h>

inherit DIABLO_OB;

void create()
{
  set_name( HIY " 日"HIW"月"+HIM"之"HIG"铠 "NOR, ({"riyue-armor","armor"}));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else  {
  set("long",HIY"一套金制的铠甲,上面镶嵌着五彩的宝石,烁烁生辉。 \n"NOR);
  set("value",60000000);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",6);
  set("is_diablo_set",1);
  set("unit","套");
  set("material", "异类金属");
  set("armor_prop/armor", 150);
  set("diablo_set/swk",1);
 
  set("diablo_prop/constitution", 10);
  set("diablo_prop/courage", 10);
  set("diablo_prop/parry", 100);
  set("armor_type", TYPE_ARMOR);
  set("wear_msg", "$N穿上一套 " HIY "日"HIW"月"HIM"之"HIG"铠"NOR" 其四射的芒光足以与日月争辉......\n");
  set("unequip_msg", "$N脱下了 " HIY "日"HIW"月"HIM"之"HIG"铠"NOR);
  }
  setup();
}

void init() 
{
if(this_player()==environment())
 { add_action("do_combine", "combine");
  add_action("do_combine","hebing");
}
}

int do_combine()
{
        int i,j1=0,j2=0,j3=0,j4=0,j5=0,j6=0;
	object obj,me, *inv;
	object k1,k2,k3,k4,k5,k6;
	
	object* obj_list;
	me = this_player();
	inv = all_inventory(me);
      
                for(i=0; i<sizeof(inv); i++)
                {
			if(inv[i]->query("id") == "riyue-armor")   {j1 = 1; k1 = inv[i];}
                        if(inv[i]->query("id") == "sky-boots")     {j2 = 1; k2 = inv[i];}
                        if(inv[i]->query("id") == "phoenix'wings-head")   {j3 = 1; k3 = inv[i];}
                        if(inv[i]->query("id") == "xuanlan-zixia")     {j4 = 1; k4 = inv[i];}
                        if(inv[i]->query("id") == "warlord waist")   {j5 = 1; k5 = inv[i];}
                        if(inv[i]->query("id") == "jingu bang")     {j6 = 1; k6 = inv[i];}
                        
		}
		
		if(j1&&j2&&j3&&j4&&j5&&j6)
		{
		if(k1->query("equipped")||k2->query("equipped")||k3->query("equipped")||k4->query("equipped")||k5->query("equipped")||k6->query("equipped"))
			return notify_fail("你必须放下所有组件才能进行合成！\n");
			
		message_vision(HIW"                $N身上的"HIY "金箍棒" NOR"，"+HIY " 日"HIW"月"+HIM"之"HIG"铠 "NOR"，" HIW"藕丝步云履"NOR"，"HIM"凤翅紫金冠"NOR"，"MAG "绚烂紫霞"NOR"，"HIR"战神腰带"NOR+HIY"\n
		散发出耀眼光芒，化作六道辉光绕着$N全身不停的盘旋，横空一声霹雳，$N的身影消失无形，\n
		众人定睛再看时，只见$N浑身上下霞光万丈、瑞气千条，手持金箍棒遥指苍天，傲立苍穹云端！\n"NOR, me);
		
				
		        me->add("daoxing",100000);
		        me->add("combat_exp",100000);
		        me->add("potential",10000);
		      
			
		        obj = new("/obj/diablo_ob/set/combine/swk-set.lpc");
		        obj->move(me);
		        tell_object(me,"恭喜你组成战神套装，你获得了一百年道行、十万武学和一万潜能！\n");
		        CHANNEL_D->do_channel(this_object(),"rumor",HIW+me->query("name")+HIM"得到了传说中的"HIR"战神套装！"NOR"\n");
		       
		        
			destruct(k2);
			destruct(k3);
			destruct(k4);
			destruct(k5); 
			destruct(k1);
			
		        

		}
		else
        		tell_object(me,"你身上的物品不足以组成战神套装！\n");   
		return 1;
	
}