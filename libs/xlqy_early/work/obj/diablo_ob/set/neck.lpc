

#include <armor.h>
#include <ansi.h>

inherit NECK;

void create()
{
  set_name(HBCYN HIY" 流星之光 "NOR, ({ "liuxing-start", "start", "neck" })); 
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
  set("long",HIB"一个有着流星之光的珠子,每当夜晚降临的时候,珠中便会有流星的光华流转不停。 \n"NOR);
  set("value",60000000);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",1);
  set("unit","颗");
  set("material", "gem");
  set("Fmaterial", "gem");
  set("armor/max_armor", 20);
  set("armor_prop/armor", 20);
  set("armor_prop/personality", 1);
  set("armor_prop/courage", 1);
  set("armor_prop/spells", 20);
  set("wear_msg", "$N将心爱的 "HBCYN HIY" 流星之光 "NOR
" 从怀里掏了出来,顿时周围闪烁出流星的光华,绕着$N流转不停......\n");
  set("unequip_msg", "$N将心爱的 "HBCYN HIY" 流星之光 "NOR" 小心地揣进了怀里,星光顿敛。\n");
  }
  setup();
}


