#include <ansi.h>
inherit NPC;

void set_skills(object who,mapping dbase);
int reset_status();

string chinese_daoxing(int gain);
string status_color(int current, int max);

void create()
{ 
      	set_name(HIB"地狱"HIR"魔卫"NOR, ({ "golem"}) );
	set("long", "聚死灵之气驱动魔力物品召唤而出的傀儡。\n");
        set("attitude", "heroism");
        set("no_arrest",1); 
        set("max_atman", 1000);
        set("atman", 1000);
        set("max_mana", 100);
        set("age",10000);
        set("max_gin",2000);
        set("gin",2000);
        set("eff_gin",2000);
        set("mana", 100); 
        set("str", 40);
        set("cor", 30);
        set("cps", 25); 
        set("kar",40);
        set("combat_exp", 80000);
        set_temp("wuxing/init_done",1);
        create_family("阎罗地府", 3, "弟子");
       
call_out("check_owner",900);
        setup(); 
      
} 
void init()
{
	
	add_action("do_order","order");
	add_action("do_heal","heal");
	add_action("do_skills","skgolem");
	add_action("do_checkhp","hpgolem");
		
}
void check_owner()
{
 if(query("owner"))
call_out("check_owner",900);
else
destruct(this_object());
}
int do_skills()
{
	
	object ob,me;
	mapping skl, lrn, map;
	string *sname, *mapped;
	string skill_lv;
	int i;
	
	me=this_player();
	ob=this_object();
		
	if(query("owner")!=me)
		return 0;
		
	skl = ob->query_skills();
	if(!sizeof(skl)) {
		write( ob->name() + "目前并没有学会任何技能。\n");
		return 1;
	}
	i=sizeof(skl);
	write( ob->name() +"目前所掌握的"+HIR""+chinese_number(i)+""NOR+"项技能是：\n\n");
	sname  = sort_array( keys(skl), (: strcmp :) );
	printf(NOR WHT"┏━━━━━━━━━━━━━━━━"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"NOR WHT"━━━━━━━━━━━━━━━━┓\n"NOR,);
	map = ob->query_skill_map();
	if( mapp(map) ) mapped = values(map);
	if( !mapped ) mapped = ({});

	lrn = ob->query_learned();
	if( !mapp(lrn) ) lrn = ([]);
	
	for(i=0; i<sizeof(skl); i++) {
		if(ob->query("skill_level/"+sname[i])=="expert")
			skill_lv=HIY"(专家)"NOR;
		else if (ob->query("skill_level/"+sname[i])=="master")
			skill_lv=HIM"(大师)"NOR;
		else if (ob->query("skill_level/"+sname[i])=="grandmaster")
			skill_lv=HIW"(宗师)"NOR;
		else skill_lv=NOR"      "NOR;
		printf(CYN"%s%s%-40s"  " - %-10s  %-5s  %4d/%5d\n"NOR, 
			(lrn[sname[i]] >= (skl[sname[i]]+1) * (skl[sname[i]]+1)) ? HIM : "",
			(member_array(sname[i], mapped)==-1? "  ": HIR"☆"NOR+HIY""),
			to_chinese(sname[i]) + " (" + sname[i] + ")",
			SKILL_D(sname[i])->level_description(skl[sname[i]]),skill_lv,
			skl[sname[i]], (int)lrn[sname[i]],
		);
	}
	        printf(NOR WHT"┗━━━━━━━━━━━━━━━"HIR" 浙 大 站 "NOR WHT"━━━━━━━━━━━━━━━━┛\n"NOR);
	write("\n");
	return 1;	
	
	
}

int do_checkhp()
{
	
  	object ob,me;
        mapping my;
        int dao,x,i;
        string str;
        
        ob=this_object();
        me=this_player();
        
        if(query("owner")!=me)
		return 0;
		
       my = ob->query_entire_dbase();

        printf(NOR CYN"┏━━━━━━━━━━━━━━"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"NOR CYN"━━━━━━━━━━━━━━┓\n"NOR,);
        printf(NOR CYN"┃"NOR WHT" 个人状态"NOR CYN" 姓 名："NOR WHT"%-12s "NOR CYN" 性别："NOR WHT"%-10s "NOR CYN"I D："NOR WHT"%-13s"NOR CYN"┃\n"NOR,ob->name(),ob->query("gender"),"["+capitalize(ob->query("id"))+"]");
        printf(NOR CYN"┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n"NOR);
        printf(NOR CYN"┃"NOR WHT"〖 气血 〗%s%7-d/%8-d%s[%3d%%]"NOR,status_color(to_int(my["kee"]),to_int(my["eff_kee"])),to_int(my["kee"]),to_int(my["eff_kee"]),status_color(to_int(my["eff_kee"]),to_int(my["max_kee"])),to_int(my["eff_kee"])*100/to_int(my["max_kee"]));
        printf(NOR WHT"  〖 内力 〗%s%7-d/%7-d(+%4d)"NOR CYN"┃\n"NOR,status_color(to_int(my["force"]),to_int( my["max_force"])), to_int(my["force"]), to_int(my["max_force"]),to_int(my["force_factor"]));
        printf(NOR CYN"┃"NOR WHT"〖 心神 〗%s%7-d/%8-d%s[%3d%%]"NOR,status_color(to_int(my["sen"]),to_int(my["eff_sen"])),to_int(my["sen"]),to_int(my["eff_sen"]),status_color(to_int(my["eff_sen"]),to_int(my["max_sen"])),to_int(my["eff_sen"])*100/to_int(my["max_sen"]));
        printf(NOR WHT"  〖 法力 〗%s%7-d/%7-d(+%4d)"NOR CYN"┃\n"NOR,status_color(to_int(my["mana"]), to_int(my["max_mana"])), to_int(my["mana"]), to_int(my["max_mana"]),my["mana_factor"]);
   //     printf(NOR CYN"┃"NOR WHT"〖 精力 〗%s%7-d/%8-d%s[%3d%%]"NOR,status_color(to_int(my["gin"]),to_int(my["eff_gin"])),to_int(my["gin"]),to_int(my["eff_gin"]),status_color(to_int(my["eff_gin"]),to_int(my["max_gin"])),to_int(my["eff_gin"])*100/to_int(my["max_gin"]));
   //     printf(NOR WHT"  〖 灵力 〗%s%7-d/%7-d(+%4d)"NOR CYN"┃\n"NOR,status_color(to_int(my["atman"]), to_int(my["max_atman"])), to_int(my["atman"]), to_int(my["max_atman"]),my["atman_factor"]);
        if(my["food"]*100/ob->max_food_capacity()>100) str=HIC+"很饱";
        else if(my["food"]*100/ob->max_food_capacity()>90) str=HIG+"正常";
        else if(my["food"]*100/ob->max_food_capacity()>60) str=HIY+"缺食";        
		else if(my["food"]*100/ob->max_food_capacity()>30) str=CYN+"缺食";
        else if(my["food"]*100/ob->max_food_capacity()>10) str=HIR+"缺食";
        else str=RED+"饥饿";
        printf(NOR CYN"┃"NOR WHT"〖 食物 〗%s%7-d/%7-d [%4s%s]"NOR,status_color(my["food"], ob->max_food_capacity()),
        my["food"], ob->max_food_capacity(),str,status_color(my["food"], ob->max_food_capacity()));
        printf(NOR WHT"  〖 武学 〗%s%18-d    "NOR CYN"┃\n"HIG,HIY,(int)ob->query("combat_exp"));        
        if(my["water"]*100/ob->max_water_capacity()>100) str=HIC+"很饱";
        else if(my["water"]*100/ob->max_water_capacity()>90) str=HIG+"正常";
        else if(my["water"]*100/ob->max_water_capacity()>60) str=HIY+"缺水";
        else if(my["water"]*100/ob->max_water_capacity()>30) str=CYN+"缺水";
        else if(my["water"]*100/ob->max_water_capacity()>10) str=HIR+"缺水";
        else str=RED+"饥渴";
         printf(NOR CYN"┃"NOR WHT"〖 饮水 〗%s%7-d/%7-d [%4s%s]"NOR,status_color(my["water"], ob->max_water_capacity()),
        my["water"], ob->max_water_capacity(),str,status_color(my["water"], ob->max_water_capacity()));
        printf(NOR WHT"  〖 潜能 〗%s%14-d "NOR CYN"       ┃\n"NOR,HIG,(int)ob->query_potential());
        printf(NOR CYN"┃"NOR WHT"〖 官职 〗%s%21-d "NOR,HIG,(int)ob->query("office_number"));
        printf(NOR WHT"  〖 杀气 〗%s%20-d "NOR CYN" ┃\n"HIG,HIR,(int)ob->query("bellicosity"));
	
		dao=(int)ob->query("daoxing");       
        printf(NOR CYN"┃"NOR WHT"〖 道行 〗%s%52-s    "NOR CYN"┃\n"NOR,HIM,chinese_daoxing(dao));    
		if (ob->query("degree"))
		{
		printf(NOR CYN"┃"NOR WHT"〖 官拜 〗%s%52-s                  "NOR CYN"┃\n"NOR,HIW,ob->query("degree"));
        printf(NOR CYN"┗━━━━━━━━━━━━━━"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"NOR CYN"━━━━━━━━━━━━━━┛\n"NOR);
		}
		else
		{
		printf(NOR CYN"┃"NOR WHT"〖 官拜 〗%s%52-s    "NOR CYN"┃\n"NOR,HIW,"未入仕途");
        printf(NOR CYN"┗━━━━━━━━━━━━━━"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"NOR CYN"━━━━━━━━━━━━━━┛\n"NOR);

		}
       	str = HIY;
  
       printf(NOR CYN"┃"NOR HIW"  〖 等级 〗   "NOR "%s%3d"NOR ,str,ob->query("level"));
       printf(NOR CYN""NOR MAG"    〖 属性点数 〗 "NOR WHT"%3d"NOR ,ob->query("attribute_point")-ob->query("attributed_point"));
       printf(NOR CYN""NOR MAG"  〖 技能点数 〗 "NOR WHT"%3d"NOR CYN"      ┃\n"NOR ,ob->query("skills_point")-ob->query("skillsed_point"));
       printf(NOR CYN"┗━━━━━━━━━━━━━━"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"NOR CYN"━━━━━━━━━━━━━━┛\n"NOR);
 
        printf("\n");   
        return 1;	
	
	
	
}
int do_heal()
{
	object who=this_player();
	if(query("owner")!=who)
		return 0;
	if(who->query("mana")<444)
		{		
			tell_object(who,"你的法力不足！\n");
			return 1;
		
		}
	if(who->is_busy())
		{		
			tell_object(who,"你现在正忙着呢！\n");
			return 1;
		
		}
	who->add("mana",-250);
	this_object()->receive_curing("kee",100);
	this_object()->receive_heal("kee",100);
	this_object()->receive_curing("sen",100);
	this_object()->receive_heal("sen",100);
	tell_object(who,this_object()->name()+HIB"眼中蓝光一闪而逝！\n"NOR);
	who->start_busy(1);
	return 1;
}
int heal_up()
{
int i,mana;
	object *enemy;
        object who,env;
        if(!objectp(env = environment(this_object())))
        	return 1;
if(env->query("no_time")) return 1;
        who=query("owner");
        if(who)
        {
        if(query("eff_kee")<query("max_kee"))
        {
        	if(who->query("force")>444)
        	{
        		who->add("force",-200);
        		this_object()->receive_curing("kee",100);
        		
        	}
        
        }
        if(query("kee")<query("eff_kee"))
        {
        	if(who->query("force")>444)
        	{
        		who->add("force",-200);
        		this_object()->receive_heal("kee",100);
        		command("exert recover");
        	}
        
        }
         if(query("eff_sen")<query("max_sen"))
        {
        	if(who->query("mana")>444)
        	{
        		who->add("mana",-200);
        		this_object()->receive_curing("sen",100);
        		
        	}
        
        }
        if(query("sen")<query("eff_sen"))
        {
        	if(who->query("mana")>444)
        	{
        		who->add("mana",-200);
        		this_object()->receive_heal("sen",100);
        		command("exert refresh");
        	}
        
        } 
        if(who->query("mana")>250)
{
mana = -350+who->query_skill("gouhunshu",1);
if(mana > 0) mana =0;
who->add("mana",mana);
        if(this_object()->query("force")<query("max_force"))
        	this_object()->add("force",100);
        if(this_object()->query("mana")<query("max_mana"))
        	this_object()->add("mana",100);
        	
       }
        message_vision("$N"+HIR"眼中红光一闪而逝！\n"NOR,this_object());
     if(who->query("mana") < 50)
       {
	       	this_object()->receive_wound("kee",144+random(44));
	       	this_object()->receive_wound("sen",144+random(44));
	       	this_object()->add("force",-144-random(44));
	       	if(this_object()->query("force") < 0)
	       				this_object()->set("force",0);
	       	this_object()->add("mana",-144-random(44));
	       	  	if(this_object()->query("mana") < 0)
	       				this_object()->set("mana",0);
	}
         enemy = who->query_enemy();
        if(enemy)
        {
	        i = sizeof(enemy);
	        while(i--) {
	                if( enemy[i] && living(enemy[i]) ) {
	                        kill_ob(enemy[i]);
	                        if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
	                        else enemy[i]->kill_ob(this_object());
	                }
	        }
	}  
	}
	else
        {
                
                destruct( this_object());
                return 1;
        }
        return ::heal_up() + 1;
} 


void invocation(object who,mapping diablo_dbase)
{
        int i,level;
        object *enemy;
         
        
        level=who->query_skill("gouhunshu",1);
if(who->query_temp("hell_set")) level +=level/2;
        
        set("str",12+level/16+random(level/16));
       
        set_skills(who,diablo_dbase); 
   
        enemy = who->query_enemy();
        if(enemy)
        {
	        i = sizeof(enemy);
	        while(i--) {
if( enemy[i] && living(enemy[i])&&environment(enemy[i]) == environment(this_object()) )
{
	                        kill_ob(enemy[i]);
	                        if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
	                        else enemy[i]->kill_ob(this_object());
	                }
	        }
	}
       
        
       reset_status();
}
void set_skills(object who,mapping diablo)
{
	
	int level;
	int kee,sen,force,mana;
	int max_kee,max_sen,max_force,max_mana;
	string  *type;
	mapping skl;
	int j,w;
	string *sname;
	object me,weapon;
	
	me=this_object();
	
	level=who->query_skill("gouhunshu",1)/150;
	kee=who->query("max_kee");
	sen=who->query("max_sen");
	force=who->query("max_force");
	mana=who->query("max_mana");
	
	kee=kee;
	sen=sen;
	kee = kee*(level+1)/2;
	sen = sen*(level+1)/2;
	set("kee",kee);
        set("max_kee",kee);
        set("eff_kee",kee);
        set("sen",sen);
        set("max_sen",sen);
        set("eff_sen",sen);
        set("max_force",force);
        set("force",2*force);
        set("max_mana",mana);
        set("mana",2*mana);
            
        set("daoxing", who->query("daoxing"));
        set("combat_exp", who->query("combat_exp"));
        
        set_temp("apply/damage", 12*(level+1));
        set_temp("apply/armor", 28*(level+1));
        
        level=who->query_skill("gouhunshu",1);
if(!who->query("skill_level/spells"))
        level = level*3/4;
else if(who->query("skill_level/spells") == "expert")
 level = level*4/5;
 else if(who->query("skill_level/spells") == "master")
level = level*5/6;
 else if(who->query("skill_level/spells") == "grandmaster")
level = level;
        w=random(5);
        if(who->query("summon/family"))
        {
        	if(who->query("summon/family")=="阎罗地府")
        		w=0;
        	else 	if(who->query("summon/family")=="火云洞")
        		w=1;	
        	else 	if(who->query("summon/family")=="陷空山无底洞")
        		w=2;	
        	else 	if(who->query("summon/family")=="大雪山")
        		w=3;	
        	else 	if(who->query("summon/family")=="盘丝洞")
        		w=4;	
             	else w=0;
        }
	
        switch(w)
	{ 
	case 0:
	    {
	        set_skill("unarmed", level+random(10));
		set_skill("whip", level+random(10));
		set_skill("hellfire-whip",level+random(10));
		set_skill("dodge", level+random(10));
		set_skill("parry", level+random(10));
		set_skill("literate", level+random(10));
		set_skill("spells", level+random(10));
		set_skill("force", level+random(10));
		set_skill("tonsillit", level+random(10));
		set_skill("ghost-steps", level+random(10));
		set_skill("gouhunshu", level+random(10));
		set_skill("jinghun-zhang", level+random(10));
		set_skill("kusang-bang", level+random(10));
		set_skill("zhuihun-sword",level+random(10));
		set_skill("sword", level+random(10));
		set_skill("stick", level+random(10));
		map_skill("force", "tonsillit");
		  map_skill("unarmed", "jinghun-zhang");
		  map_skill("dodge", "ghost-steps");
		  map_skill("spells", "gouhunshu");
		  map_skill("parry", "hellfire-whip");
		  map_skill("whip", "hellfire-whip");
		   map_skill("sword", "zhuihun-sword");
		    map_skill("stick", "kusang-bang");
		 
	  	 delete_temp("wuxing/init_done");
	  	 set("family/family_name","阎罗地府");
	  	  WUXING_D->init_user_wuxing(this_object());
	  	   set("skill_level/sword","expert");
	  	 set("skill_level/stick","expert");
	  	 set("skill_level/whip","expert");
	  	 if(level > 320)
	  	 {
	  	 	 set("skill_level/sword","master");
	  	 set("skill_level/stick","master");
	  	 set("skill_level/whip","master");
	  	}
	  	if(level > 640)
	  	 {
	  	 	 set("skill_level/sword","grandmaster");
	  	 set("skill_level/stick","grandmaster");
	  	 set("skill_level/whip","grandmaster");
	  	}
	  	 weapon=carry_object("/d/obj/weapon/whip/longsuo");
	  	 weapon->set("no_sell",1);
	  	
	  	 weapon->wield();
	  	}
	  	break;
	  	 	case 1:
	        {
	        set_skill("unarmed", level+random(10));
		set_skill("spear", level+random(10));
		set_skill("dali-bang",level+random(10));
		set_skill("dodge", level+random(10));
		set_skill("parry", level+random(10));
		set_skill("literate", level+random(10));
		set_skill("spells", level+random(10));
		set_skill("force", level+random(10));
		set_skill("huomoforce", level+random(10));
		
		set_skill("pingtian-dafa", level+random(10));
		set_skill("wuyue-spear", level+random(10));
		set_skill("stick", level+random(10));
		set_skill("moyun-shou",level+random(10));
		set_skill("huoyun-qiang", level+random(10));
		set_skill("moshenbu", level+random(10));
		map_skill("force", "huomoforce");
		  map_skill("unarmed", "moyun-shou");
		  map_skill("dodge", "moshenbu");
		  map_skill("spells", "pingtian-dafa");
		  map_skill("parry", "wuyue-spear");
		  map_skill("stick", "dali-bang");
		 map_skill("spear", "wuyue-spear");	
		 delete_temp("wuxing/init_done");	 
		  set("skill_level/spear","expert");
	  	 set("skill_level/stick","expert");
	  	 set("skill_level/unarmed","expert");
	  	 
	  	   weapon=carry_object("/d/obj/weapon/spear/jinqiang");
	  	 weapon->set("no_sell",1);
	  	
	  	 weapon->wield();
	  	 set("family/family_name","火云洞");
	  	  WUXING_D->init_user_wuxing(this_object());
	  	 set("name",HIR"火云"HIB"魔卫"NOR);
	  	  if(level > 320)
	  	 {
	  	 	 set("skill_level/spear","master");
	  	 set("skill_level/stick","master");
	  	 set("skill_level/unarmed","master");
	  	}
	  	if(level > 640)
	  	 {
	  	 	 set("skill_level/spear","grandmaster");
	  	 set("skill_level/stick","grandmaster");
	  	 set("skill_level/unarmed","grandmaster");
	  	}
	  	
	  	}
	  	break;
	  	 	case 2:
	        {
	        set_skill("unarmed", level+random(10));
		set_skill("sword", level+random(10));
		set_skill("qixiu-jian",level+random(10));
		set_skill("dodge", level+random(10));
