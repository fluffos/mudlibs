void die()
{
	object me=query("owner");
	if(environment(me)->query("short") == "赛场")
		::die();
		else
		{
        message_vision("\n$N化为一道青烟而去。\n", this_object());
        if(me)
        { me->delete("summon");
         me->save();        }
        destruct(this_object());
}
}

void unconcious()
{
             die();
}
int do_order(string msg)
{
	string what,what2,obb;
	object me=this_player();
	
	if(me!=query("owner"))
		return 0;
	if(!msg)
	{
		tell_object(me,"你要让魔卫做什么？\n");
		return 1;
       }
	if(msg =="stay here")
        {
        	 message_vision("\n$N对$n说道：呆着别乱跑。\n",me, this_object());
        	this_object()->set_temp("stay_stat",1);
        	this_object()->command("follow none");
        	return 1;	
        } 
        if(msg == "gogogo")
        { 
        	message_vision("\n$N对$n说道：跟我走。\n",me, this_object());
        	this_object()->delete_temp("stay_stat");
        	this_object()->set_leader(me);
        	 call_out("reset_status", 3);
        	return 1;	
        }
       
	if(msg=="cast jieti")
	{
		command("shake");
		return 1;
		}
	if(msg=="exert charm")
	{
		command("shake");
		return 1;
		}
	sscanf(msg,"%s on %s",what,obb);

	if(what=="cast jieti")
	{
		command("shake");
		return 1;
	}
	sscanf(msg,"%s %s %s",what,what2,obb);
	
	what+=what2;
	
	if(what=="exertcharm")
	{
		command("shake");
		return 1;
	}
	sscanf(msg,"%s %s",what,what2);
	
	if(what=="chat"||what=="sldh"||what=="es"||what=="rumor"||what=="xyj"||
		what=="tell"||what=="follow"||what=="apprentice"||what=="recruit")
	
             	   return 0;
          
        if (msg)
        {
        	
            tell_room(environment(me),me->name()+"悄声在"+this_object()->name()+"耳边说了些什么。\n",me);
 		tell_object(me,"\n你对"+this_object()->name()+"说道："+msg+"\n");
               command (msg);
                return 1;
        }
}

void relaying (string msg)
{
        command (msg);
}

int reset_status()
{
        object owner,env;
        int n;
        
        owner= query("owner");

        if(  !query("owner"))
        {
                
                destruct( this_object());
                return 1;
        }
	if(!living(this_object()))
	{
	 call_out("reset_status", 3);
        return 1;	
		
	}
	if(query_temp("stay_stat"))
		return 1;
        if(!present(owner->query("id"), environment(this_object())))
            {env=environment(owner);
             this_object()->move(env);
             message_vision("$N走了过来。\n",this_object());
            }
            
        call_out("reset_status", 3);
        return 1;
}

string status_color(int current, int max)
{
        int percent;
        if( max>0 ) percent = current * 100 / max;
        else percent = 100;
        if( percent > 100 ) return HIC;
        if( percent >= 90 ) return HIG;
        if( percent >= 60 ) return HIY;
        if( percent >= 30 ) return CYN;
        if( percent >= 10 ) return HIR;
        return RED;
}


string chinese_daoxing(int gain) {
            int year,day,hour;
             string str;

             year=gain/1000;
             day=(gain-year*1000)/4;
             hour=(gain-year*1000-day*4)*3;
             str="";
             if(year) str=str+chinese_number(year)+"年";
             if(day) str=str+chinese_number(day)+"天";
             if(hour) str=str+chinese_number(hour)+"时辰";
             if(gain==0) str="未入道途";
             return str;
}
