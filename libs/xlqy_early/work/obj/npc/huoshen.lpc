#include <ansi.h>

inherit JOBNPC;

void do_atk();
void create() {
  int flag;
  set_name(HIR "火神" NOR, ({ "huo shen", "shen" }));
  set("long", HIR "浑身笼罩在火焰中的火神" NOR);
  create_family("火云洞", 3, "弟子");
  set("title", HIR "火之魂" NOR);
  set("age", 99);
  set("max_kee", 6000);
  set("max_sen", 6000);
  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);

  set("str", 40);
  set("cor", 40);
  set("cps", 40);
  set("spi", 40);
  set("int", 40);
  set("con", 40);
  set("kar", 40);
  set("per", 1);

  set("combat_exp", 3500000);
  set("daoxing", 2000000);

  if (random(2)) {
    flag = 1;
    set_skill("literate", 200 + random(50));
    set_skill("spells", 200 + random(50));
    set_skill("force", 200 + random(50));
    set_skill("unarmed", 200 + random(50));
    set_skill("parry", 200 + random(50));
    set_skill("dodge", 200 + random(50));
    set_skill("spear", 200 + random(50));

    set_skill("huomoforce", 200 + random(50));
    set_skill("pingtian-dafa", 200 + random(50));
    set_skill("moshenbu", 200 + random(50));
    set_skill("moyun-shou", 200 + random(50));
    set_skill("wuyue-spear", 200 + random(50));

    map_skill("dodge", "moshenbu");
    map_skill("unarmed", "moyun-shou");
    map_skill("spells", "pingtian-dafa");
    map_skill("force", "huomoforce");
    map_skill("spear", "wuyue-spear");
    map_skill("parry", "wuyue-spear");

    set("chat_chance_combat", 88);
    set("chat_msg_combat", ({
      (: cast_spell, "niushi" :),
      (: do_atk :),
      (: perform_action, "spear", "buhui" :),
      (: perform_action, "spear", "fengchan" :),
      (: perform_action, "unarmed", "zhangxinlei" :),
    }));
  } else {
    set_skill("literate", 200 + random(50));
    set_skill("spells", 200 + random(50));
    set_skill("force", 200 + random(50));
    set_skill("unarmed", 200 + random(50));
    set_skill("parry", 200 + random(50));
    set_skill("dodge", 200 + random(50));
    set_skill("stick", 200 + random(50));

    set_skill("huomoforce", 200 + random(50));
    set_skill("pingtian-dafa", 200 + random(50));
    set_skill("moshenbu", 200 + random(50));
    set_skill("moyun-shou", 200 + random(50));
    set_skill("dali-bang", 200 + random(50));

    map_skill("dodge", "moshenbu");
    map_skill("unarmed", "moyun-shou");
    map_skill("spells", "pingtian-dafa");
    map_skill("force", "huomoforce");
    map_skill("stick", "dali-bang");
    map_skill("parry", "dali-bang");

    set("chat_chance_combat", 85);
    set("chat_msg_combat", ({
      (: cast_spell, "niushi" :),
      (: do_atk :),
      (: perform_action, "stick", "shenli" :),
      (: perform_action, "stick", "lianying" :),
      (: perform_action, "unarmed", "zhangxinlei" :),
    }));
  }

  set_weight(1000000);
  setup();

  if (random(3)) {
    if (flag) {
      carry_object("/d/npc/obj/spear")->wield();
    } else {
      carry_object("/d/npc/obj/stick")->wield();
    }
  }

  carry_object("/d/npc/obj/armor")->wear();
}

void do_atk() {
  object *enemy, target, *inv, ob;

  enemy = this_object()->query_enemy();

  if (sizeof(enemy) > 0) {
    target = enemy[random(sizeof(enemy))];
    if (random(2)) {
      message_vision(HIR "\n$N呼的一声从嘴里喷出数道神火直冲$n而去！\n" NOR, this_object(), target);
      if (!random(3)) {
        target->receive_damage(
          "kee",
          this_object()->query("force") / 10 + random(this_object()->query("force") / 10),
          this_object(),
          "huo"
        );
        message_vision(HIR "\n$N躲闪不及被烧的焦头烂额！\n" NOR, target);
      } else {
        message_vision(HIR "\n$N纵身躲过。\n" NOR, target);
      }
    } else {
      inv = all_inventory(target);
      if (sizeof(inv) > 0) {
        message_vision(HIR "\n$N呼的一声从嘴里喷出数道神火直冲$n而去！\n" NOR, this_object(), target);
        if (!random(3)) {
          ob = inv[random(sizeof(inv))];
          message_vision(HIR "\n$N虽侥幸躲过，身上的$n却被烧掉了！\n" NOR, target, ob);
          ob->move(environment(this_object()));
          destruct(ob);
        } else {
          message_vision(HIR "\n$N纵身躲过。\n" NOR, target);
        }
      }
    }
  }
}

void invocation(object who) {
  int i, level;
  object *enemy;
  object me = this_object();

  message("vision", HIR "蓬的一声，$N面前冲天火光一闪，一位浑身赤焰的人飘了出来！\n" NOR, who);
  this_object()->set_temp("invoker", who);

  level = NPC_D->get_skill_level(who);
  if (level < 250) {
    NPC_D->set_npc_hp(this_object(), who, 80 + random(50));
    NPC_D->full_hp_status(this_object());
    me->add_temp("apply/attack", 100);
    me->add_temp("apply/defense", 100);
    me->add_temp("apply/armor", 250);
    me->set_temp("apply/damage", 250);
    me->set_temp("apply/strength", 100);
    me->set("force_factor", 200);
    me->set("mana_factor", 200);
  } else {
    STATU_D->set_npc_skill(me, level, "火云洞");
    me->delete_temp("apply");
    me->delete("skill_level");
    me->delete_temp("wuxing/init_done");

    NPC_D->set_npc_hp(me, who, 80 + random(50));
    NPC_D->full_hp_status(me);
    WUXING_D->init_user_wuxing(this_object());
    me->set("force_factor", 400);
    me->set("mana_factor", 400);
    me->add_temp("apply/attack", 100);
    me->add_temp("apply/defense", 100);
    me->add_temp("apply/armor", 250);
    me->set_temp("apply/damage", 250);
    me->set_temp("apply/strength", 100);
    reset_eval_cost();
  }

  enemy = who->query_enemy();
  i = sizeof(enemy);

  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);

      if (userp(enemy[i])) {
        enemy[i]->fight_ob(this_object());
      } else {
        enemy[i]->kill_ob(this_object());
      }
    }
  }
  set_leader(who);
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }

  return ::heal_up() + 1;
}

void leave() {
  message_vision(HIR "\n$N消失在一团火光中......\n", this_object());
  destruct(this_object());
}

void die() {
  object me = this_object();
  message_vision(HIR "\n$N消失在一团火光中......\n", me);
  destruct(this_object());
}

void unconcious() {
  die();
}
