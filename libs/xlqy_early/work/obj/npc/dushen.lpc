#include <ansi.h>

inherit JOBNPC;

void do_atk();
void create() {
  int flag;

  set_name(HIG "毒神" NOR, ({ "du shen", "shen" }));
  set("long", HIG "浑身笼罩在毒瘴绿光中的毒神" NOR);
  create_family("阎罗地府", 3, "弟子");
  set("title", HIG "毒之精" NOR);
  set("age", 99);
  set("max_kee", 6000);
  set("max_sen", 6000);
  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);

  set("str", 40);
  set("cor", 40);
  set("cps", 40);
  set("spi", 40);
  set("int", 40);
  set("con", 40);
  set("kar", 40);
  set("per", 1);

  set("combat_exp", 3500000);
  set("daoxing", 2000000);

  if (1) {
    flag = 1;
    set_skill("unarmed", 200 + random(50));
    set_skill("whip", 200 + random(50));
    set_skill("hellfire-whip", 200 + random(50));
    set_skill("dodge", 200 + random(50));
    set_skill("parry", 200 + random(50));
    set_skill("literate", 200 + random(50));
    set_skill("spells", 200 + random(50));
    set_skill("force", 200 + random(50));
    set_skill("tonsillit", 200 + random(50));
    set_skill("ghost-steps", 200 + random(50));
    set_skill("gouhunshu", 200 + random(50));
    set_skill("jinghun-zhang", 200 + random(50));
    set_skill("kusang-bang", 200 + random(50));
    set_skill("zhuihun-sword", 200 + random(50));
    set_skill("sword", 200 + random(50));
    set_skill("stick", 200 + random(50));
    map_skill("force", "tonsillit");
    map_skill("unarmed", "jinghun-zhang");
    map_skill("dodge", "ghost-steps");
    map_skill("spells", "gouhunshu");
    map_skill("parry", "hellfire-whip");
    map_skill("whip", "hellfire-whip");
    map_skill("sword", "zhuihun-sword");
    map_skill("stick", "kusang-bang");

    set("chat_chance_combat", 88);
    set("chat_msg_combat", ({
      (: cast_spell, "gouhun" :),
      (: do_atk :),
      (: perform_action, "whip", "ldlh" :),
      (: perform_action, "whip", "three" :),
      (: perform_action, "whip", "lunhui" :),
      (: perform_action, "unarmed", "wuchang" :),
    }));
  }

  set_weight(1000000);
  setup();

  carry_object("/d/npc/obj/whip")->wield();
  carry_object("/d/npc/obj/armor")->wear();
}

void do_atk() {
  object *enemy, target, *inv, ob;
  enemy = this_object()->query_enemy();

  if (sizeof(enemy) > 0) {
    target = enemy[random(sizeof(enemy))];

    message_vision(HIG "\n$N" + HIG "呼的一声从嘴中吐出一蓬绿瘴直冲$n而去！\n" NOR, this_object(), target);
    if (!random(3)) {
      target->receive_damage(
        "kee",
        this_object()->query("force") / 10 + random(this_object()->query("force") / 10),
        this_object(),
        "mu"
      );
      message_vision(HIG "\n$N躲闪不及被熏的天晕地转！\n" NOR, target);

      if (!random(4)) {
        target->apply_condition("fearness_poison", 22);
        target->set("wuxing_poison/fearness_poison", 99 + random(11));
      } else if (!random(3)) {
        target->apply_condition("stoner_poison", 22);
        target->set("wuxing_poison/stoner_poison", 99 + random(11));
      } else if (!random(2)) {
        target->apply_condition("weakness_poison", 22);
        target->set("wuxing_poison/weakness_poison", 99 + random(11));
      } else {
        target->apply_condition("illness_poison", 22);
        target->set("wuxing_poison/illness_poison", 99 + random(11));
      }
    } else {
      message_vision(HIG "\n$N纵身躲过。\n" NOR, target);
    }
  }
}

void invocation(object who) {
  int i, level;
  object *enemy;
  object me = this_object();

  message("vision", HIG "$N面前突然花香四溢，一位浑身绿气的人悄然而至。\n" NOR, who);
  this_object()->set_temp("invoker", who);
  level = NPC_D->get_skill_level(who);

  if (level < 250) {
    NPC_D->set_npc_hp(this_object(), who, 80 + random(50));
    NPC_D->full_hp_status(this_object());
    me->add_temp("apply/attack", 100);
    me->add_temp("apply/defense", 100);
    me->add_temp("apply/armor", 250);
    me->set_temp("apply/damage", 250);
    me->set_temp("apply/strength", 100);
    me->set("force_factor", 200);
    me->set("mana_factor", 200);
  } else {
    STATU_D->set_npc_skill(me, level, "阎罗地府");
    me->delete_temp("apply");
    me->delete("skill_level");
    me->delete_temp("wuxing/init_done");

    NPC_D->set_npc_hp(me, who, 80 + random(50));
    NPC_D->full_hp_status(me);
    WUXING_D->init_user_wuxing(this_object());
    me->set("force_factor", 400);
    me->set("mana_factor", 400);
    me->add_temp("apply/attack", 100);
    me->add_temp("apply/defense", 100);
    me->add_temp("apply/armor", 250);
    me->set_temp("apply/damage", 250);
    me->set_temp("apply/strength", 100);
    reset_eval_cost();
  }

  enemy = who->query_enemy();
  i = sizeof(enemy);

  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);

      if (userp(enemy[i])) {
        enemy[i]->fight_ob(this_object());
      } else {
        enemy[i]->kill_ob(this_object());
      }
    }
  }
  set_leader(who);
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }

  return ::heal_up() + 1;
}

void leave() {
  message_vision(HIG "\n$N消失在一团绿瘴中......\n", this_object());
  destruct(this_object());
}

void die() {
  object me = this_object();
  message_vision(HIG "\n$N消失在一团绿瘴中......\n", me);
  destruct(this_object());
}

void unconcious() {
  die();
}
