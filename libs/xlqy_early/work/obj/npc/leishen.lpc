#include <ansi.h>

inherit JOBNPC;

void do_atk();

void create() {
  int flag;

  set_name(HIB "雷神" NOR, ({ "lei shen", "shen" }));
  set("long", HIB "浑身笼罩在幽幽蓝光中的雷神" NOR);
  create_family("方寸山三星洞", 3, "弟子");
  set("title", HIB "雷之魄" NOR);
  set("age", 99);
  set("max_kee", 6000);
  set("max_sen", 6000);
  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);

  set("str", 40);
  set("cor", 40);
  set("cps", 40);
  set("spi", 40);
  set("int", 40);
  set("con", 40);
  set("kar", 40);
  set("per", 1);

  set("combat_exp", 3500000);
  set("daoxing", 2000000);

  if (1) {
    flag = 1;
    set_skill("literate", 200 + random(50));
    set_skill("spells", 200 + random(50));
    set_skill("force", 200 + random(50));
    set_skill("unarmed", 200 + random(50));
    set_skill("parry", 200 + random(50));
    set_skill("dodge", 200 + random(50));
    set_skill("stick", 200 + random(50));

    set_skill("wuxiangforce", 200 + random(50));
    set_skill("dao", 200 + random(50));
    set_skill("jindouyun", 200 + random(50));
    set_skill("puti-zhi", 200 + random(50));
    set_skill("qianjun-bang", 200 + random(50));

    map_skill("dodge", "jindouyun");
    map_skill("unarmed", "puti-zhi");
    map_skill("spells", "dao");
    map_skill("force", "wuxiangforce");
    map_skill("fork", "qianjun-bang");
    map_skill("parry", "qianjun-bang");

    set("chat_chance_combat", 88);
    set("chat_msg_combat", ({
      (: cast_spell, "dingshen" :),
      (: do_atk :),
      (: perform_action, "stick", "leiting" :),
      (: perform_action, "stick", "qiankun" :),
      (: perform_action, "stick", "pili" :),
      (: perform_action, "stick", "wu" :),
      (: perform_action, "unarmed", "nianhua" :),
    }));
  }
  set_weight(1000000);
  setup();

  carry_object("/d/npc/obj/stick")->wield();
  carry_object("/d/npc/obj/armor")->wear();
}

void remove_jinforce_effect(object target) {
  if (target) {
    target->delete_temp("biqi");
  }

  return;
}

void remove_jinmana_effect(object target) {
  if (target) {
    target->delete_temp("jinzhou");
  }

  return;
}

void remove_jinpfm_effect(object target) {
  if (target) {
    target->delete_temp("fengmo");
  }

  return;
}

void do_atk() {
  object *enemy, target, *inv, ob;

  enemy = this_object()->query_enemy();

  if (!random(4)) {
    this_object()->command("perform pili");
    this_object()->command("perform qiankun");
    this_object()->command("perform wu");
    return;
  }

  if (sizeof(enemy) > 0) {
    target = enemy[random(sizeof(enemy))];

    if (random(2)) {
      message_vision(HIB "\n$N" + HIB "呼的一声从指尖挥出数道霹雳直冲$n而去！\n" NOR, this_object(), target);
      if (!random(3)) {
        target->receive_damage(
          "kee",
          this_object()->query("force") / 10 + random(this_object()->query("force") / 10),
          this_object(),
          "jin"
        );
        message_vision(HIB "\n$N躲闪不及被劈的天晕地转！\n" NOR, target);
      } else {
        message_vision(HIB "\n$N纵身躲过。\n" NOR, target);
      }
    } else {
      message_vision(HIB "\n$N" + HIB "呼的一声从指尖挥出数道霹雳直冲$n而去！\n" NOR, this_object(), target);
      if (!random(3)) {
        if (!random(3) && !target->query_temp("biqi")) {
          message_vision(HIB "\n$N躲闪不及,天灵被劈的麻飕飕的难以运用内力！\n" NOR, target);
          target->set_temp("biqi", 1);
          call_out("remove_jinforce_effect", 5 + random(5), target);
        } else if (random(2) && !target->query_temp("jinzhou")) {
          message_vision(HIB "\n$N躲闪不及,天灵被劈的麻飕飕的难以运用法力！\n" NOR, target);
          target->set_temp("jinzhou", 1);
          call_out("remove_jinmana_effect", 5 + random(5), target);
        } else if (!target->query_temp("fengmo")) {
          message_vision(HIB "\n$N躲闪不及,天灵被劈的麻飕飕的难以运用外功！\n" NOR, target);
          target->set_temp("fengmo", 1);
          call_out("remove_jinpfm_effect", 5 + random(5), target);
        } else {
          message_vision(HIB "\n$N纵身躲过。\n" NOR, target);
        }
      } else {
        message_vision(HIB "\n$N纵身躲过。\n" NOR, target);
      }
    }
  }
}

void invocation(object who) {
  int i, level;
  object *enemy;
  object me = this_object();

  message("vision", HIB "轰的一声，$N面前电闪雷鸣，一位浑身蓝光的人闪了出来！\n" NOR, who);
  this_object()->set_temp("invoker", who);

  level = NPC_D->get_skill_level(who);
  if (level < 250) {
    NPC_D->set_npc_hp(this_object(), who, 80 + random(50));
    NPC_D->full_hp_status(this_object());
    me->add_temp("apply/attack", 100);
    me->add_temp("apply/defense", 100);
    me->add_temp("apply/armor", 250);
    me->set_temp("apply/damage", 250);
    me->set_temp("apply/strength", 100);
    me->set("force_factor", 200);
    me->set("mana_factor", 200);
  } else {
    STATU_D->set_npc_skill(me, level, "方寸山三星洞");
    me->delete_temp("apply");
    me->delete("skill_level");
    me->delete_temp("wuxing/init_done");

    NPC_D->set_npc_hp(me, who, 80 + random(50));
    NPC_D->full_hp_status(me);
    WUXING_D->init_user_wuxing(this_object());
    me->set("force_factor", 400);
    me->set("mana_factor", 400);
    me->add_temp("apply/attack", 100);
    me->add_temp("apply/defense", 100);
    me->add_temp("apply/armor", 250);
    me->set_temp("apply/damage", 250);
    me->set_temp("apply/strength", 100);
    reset_eval_cost();
  }

  enemy = who->query_enemy();
  i = sizeof(enemy);

  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);

      if (userp(enemy[i])) {
        enemy[i]->fight_ob(this_object());
      } else {
        enemy[i]->kill_ob(this_object());
      }
    }
  }

  set_leader(who);
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }

  return ::heal_up() + 1;
}

void leave() {
  message_vision(HIB "\n$N消失在一团蓝光中......\n", this_object());
  destruct(this_object());
}
void die() {
  object me = this_object();
  message_vision(HIB "\n$N消失在一团蓝光中......\n", me);
  destruct(this_object());
}

void unconcious() {
  die();
}
