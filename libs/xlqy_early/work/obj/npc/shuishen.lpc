#include <ansi.h>

inherit JOBNPC;

void do_atk();
void create()
{
    int flag;
    set_name( HIC "水神" NOR, ({ "shui shen","shen"}) );
    set("long",HIC"浑身笼罩在水雾中的水神"NOR);
             create_family("东海龙宫", 3, "弟子");
             set("title",HIC"水之灵"NOR);
    set("age", 99);
    set("max_kee", 6000);
    set("max_sen", 6000);
    set("max_force", 5000);
    set("force", 10000);
    set("max_mana", 5000);
    set("mana", 10000);

    set("str", 40);
    set("cor", 40);
    set("cps", 40);
    set("spi", 40);
    set("int", 40);
    set("con", 40);
    set("kar", 40);
    set("per", 1);

    set("combat_exp", 3500000);
    set("daoxing", 2000000);

    if ( 1 )
    {
        flag = 1;
        set_skill("literate", 200+random(50));   
        set_skill("spells", 200+random(50));
        set_skill("force", 200+random(50));
        set_skill("unarmed", 200+random(50));
        set_skill("parry", 200+random(50));
        set_skill("dodge", 200+random(50));
        set_skill("fork", 200+random(50));

        set_skill("dragonforce", 200+random(50));  
        set_skill("seashentong", 200+random(50));  
        set_skill("dragonstep", 200+random(50));
        set_skill("dragonfight", 200+random(50));
        set_skill("fengbo-cha", 200+random(50));

        map_skill("dodge", "dragonstep");
        map_skill("unarmed", "dragonfight");
        map_skill("spells", "seashentong");
        map_skill("force", "dragonforce");
        map_skill("fork", "fengbo-cha");
        map_skill("parry", "fengbo-cha");
  
        set("chat_chance_combat", 88);
        set("chat_msg_combat", ({
            (: cast_spell, "freez" :),
            (: do_atk :),
            (: perform_action, "fork", "fengbo" :),
            (: perform_action, "unarmed", "pini" :),        
            (: perform_action, "unarmed", "leidong" :),  
            (: perform_action, "unarmed", "sheshen" :),            
        }));
    }

    set("pini",1);
    set("leidong",1);
    set_weight(1000000);
    setup();

    if ( random(3) )
    {
        carry_object("/d/npc/obj/fork")->wield();
    }
    carry_object("/d/npc/obj/armor")->wear();        
}

void do_atk()
{
    object *enemy,target,ob;

    enemy = this_object()->query_enemy();

    if ( sizeof(enemy) > 0 )
    {
        target = enemy[random(sizeof(enemy))];

        if ( random(2) )
        {
            message_vision (HIC"\n$N"+HIC"呼的一声从嘴里喷出一道寒柱直冲$n而去！\n"NOR,this_object(),target);
            if ( !random(3) )
            {
                target->receive_damage("kee",this_object()->query("force")/10+random(this_object()->query("force")/10),this_object(),"shui");
                message_vision (HIC"\n$N躲闪不及被冻的浑身哆嗦！\n"NOR,target);
            }
            else
            {
                message_vision (HIC"\n$N纵身躲过。\n"NOR,target);
            }
        }
        else
        {
            message_vision (HIC"\n$N"+HIC"呼的一声从嘴里喷出一道寒柱直冲$n而去！\n"NOR,this_object(),target);
            if ( !random(3) )
            {
                message_vision (HIC"\n$N躲闪不及被冻的一动也不能动！\n"NOR,target);
                if ( !target->is_busy() )
                {
                    target->start_busy(2 + random(3));
                }
            }
            else
            {
                message_vision (HIC"\n$N纵身躲过。\n"NOR,target);
            }
        
        }
    }
}

void invocation(object who)
{
    int i,level;
    object *enemy;
    object me = this_object();

    message_vision(HIC "哗的一声，$N面前水雾弥漫，一位浑身水气的人走了出来！\n" NOR,who);
    this_object()->set_temp("invoker",who);
    level = NPC_D->get_skill_level(who);

    if ( level< 250 )
    {
        NPC_D->set_npc_hp(this_object(),who, 80+random(50));
        NPC_D->full_hp_status(this_object());
        me->add_temp("apply/attack", 100);
        me->add_temp("apply/defense", 100);
        me->add_temp("apply/armor", 250);
        me->set_temp("apply/damage", 250);
        me->set_temp("apply/strength", 100);
        me->set("force_factor",200);
        me->set("mana_factor",200);
    }
    else
    {
        STATU_D->set_npc_skill(me, level, "东海龙宫");
        me->delete_temp("apply");
        me->delete("skill_level");
        me->delete_temp("wuxing/init_done");

        NPC_D->set_npc_hp(me, who, 80+random(50));
        NPC_D->full_hp_status(me);
        WUXING_D->init_user_wuxing(this_object());
        me->set("force_factor",400);
        me->set("mana_factor",400);
        me->add_temp("apply/attack", 100);
        me->add_temp("apply/defense", 100);
        me->add_temp("apply/armor", 250);
        me->set_temp("apply/damage", 250);
        me->set_temp("apply/strength", 100);
        reset_eval_cost();
    }    

    enemy = who->query_enemy();
    i = sizeof(enemy);

    while ( i-- )
    {
        if ( enemy[i] && living(enemy[i]) )
        {
            kill_ob(enemy[i]);

            if ( userp(enemy[i]) )
            {
                enemy[i]->fight_ob(this_object());
            }
            else
            {
                enemy[i]->kill_ob(this_object());
            }
        }
    }

    set_leader(who);
}

int heal_up()
{
    if ( environment() && !is_fighting() )
    {
        call_out("leave", 1);
        return 1;
    }

    return ::heal_up() + 1;
}

void leave()
{
    message_vision (HIC"\n$N消失在一团水雾中......\n",this_object());
    destruct(this_object());
}
void die ()
{
    object me = this_object();
    message_vision (HIC"\n$N消失在一团水雾中......\n",me);
    destruct(this_object());  
}

void unconcious()
{
   die();
}

