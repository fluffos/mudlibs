// 幻世魔导mm们的护法：使用魔法攻击的炽焰鸟


#include <ansi.h>

inherit NPC;

void create() {
  set_name(HIR "炽焰鸟" NOR, ({ "firebird" }));
  set("family/family_name", "幻世魔导");
  set("age", 20);
  set("race", "野兽");
  set("long", "全身永远燃烧着炽烈火焰的神鸟。\n");
  set("str", 15);
  set("cor", 30);
  set("con", 30);
  set("cps", 30);
  set("spi", 30);
  set("int", 30);
  set_temp("apply/damage", 25);
  set_temp("apply/armor", 50);
  set("max_kee", 1200);
  set("max_sen", 1200);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 10);
  set("mana", 1000);
  set("max_mana", 1000);
  set("mana_factor", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("spells", 50);
  set_skill("wanxi-spells", 50);
  map_skill("spells", "wanxi-spells");
  set("combat_exp", 100000);
  set("daoxing", 100000);
  set("limbs", ({ "头部", "身体", "左爪", "尾巴", "肚皮", "右爪", "翅膀", "脖颈" }));
  set("verbs", ({ "bite", "claw" }));
  set_weight(500000);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "fire" :),
    (: cast_spell, "final" :),
  }));
  set_temp("wuxing/init_done", 1);   //防止在setup中初始化错误的五行属性..
  setup();
}

void copy_status(object me, object ob) {
  me->set_skill("dodge", (int)ob->query_skill("dodge", 1));
  me->set_skill("parry", (int)ob->query_skill("parry", 1));
  me->set_skill("spells", (int)ob->query_skill("spells", 1));
  me->set_skill("wanxi-spells", (int)ob->query_skill("wanxi-spells", 1));

  me->set("combat_exp", ob->query("combat_exp"));
  me->set("daoxing", ob->query("daoxing"));
  me->set("mana", ob->query("mana"));
  me->set("max_mana", ob->query("max_mana"));
  me->set("mana_factor", ob->query("mana_factor"));
  me->delete_temp("wuxing/init_done");
  WUXING_D->init_user_wuxing(me);
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIR + name() + "张开燃烧着火焰的双翅，掠空而去，转瞬间便消失在了天际!\n"
    NOR, environment(), this_object());
  destruct(this_object());
}

void invocation(object who) {
  int i;
  object *enemy;

  object me = this_object();

  copy_status(me, who);

  message("vision", HIR "天际出现一团炽烈的火焰，迅速由远及近，炽焰鸟飞来了!\n" NOR, environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);

  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);

      if (userp(enemy[i])) {
        enemy[i]->fight_ob(this_object());
      } else {
        enemy[i]->kill_ob(this_object());
      }
    }
  }
}
