#include <ansi.h>

inherit EQUIP;

nosave mapping weapon_type = ([
  "axe": ({ "chop", "slice", "hack" }),
  "blade": ({ "slash", "slice", "hack", "chop" }),
  "dagger": ({ "pierce", "thrust" }),
  "fork": ({ "thrust", "pierce" }),
  "hammer": ({ "bash", "crush", "slam" }),
  "mace": ({ "impale", "bash", "crush", "slam" }),
  "sword": ({ "slash", "slice", "thrust", "pierce" }),
  "staff": ({ "bash", "crush", "slam", "pierce", "impale" }),
  "stick": ({ "bash", "crush", "slam" }),
  "whip": ({ "whip", "wave" }),
  "spear": ({ "thrust", "impale", "pierce" }),
  "xiao": ({ "play" }),
  "qin": ({ "play" }),
]);

void create() {
  seteuid(0);
  if (!query("name")) {
    set_name("远古装备", ({ "ultimate equip" }));
  }
}

string long() {
  string msg = "随机装备\n";

  if (!ULTIMATE_D->query_identified(this_object())) {
    return msg + RED "这样东西还没有鉴定。\n" NOR;
  }

  return ULTIMATE_D->query_desc(this_object());
}

void setup() {
  if (query("skill_type")) {
    set("actions", (: call_other, WEAPON_D, "query_action" :));

    if (!undefinedp(weapon_type[query("skill_type")])) {
      set("verbs", weapon_type[query("skill_type")]);
    }
  }

  if (!query("apply/actions")) {
    set("apply/actions", (: call_other, WEAPON_D, "query_apply_action" :));
    set("apply/verbs", ({ "shoot" }));
  }

  set_name(query("name"), ({ query("id") }));
}

int is_ultimate_ob() {
  return 1;
}

int valid_equip(object me) {
  int can;

  if (!objectp(me)) {
    return 0;
  }

  if (!ULTIMATE_D->query_identified(this_object()) && !wizardp(me)) {
    return 0;
  }

  can = ULTIMATE_D->check_valid(this_object(), me);

  if (!can) {
    return 0;
  }

  return 1;
}

int wield() {
  object me = environment();

  if (!objectp(me)) {
    return 0;
  }

  if (!valid_equip(me)) {
    return notify_fail("你目前无法装备这样东西。\n");
  }

  if (!::wield()) {
    return 0;
  }

  catch(ULTIMATE_D->equip(this_object(), me));
  catch(ULTIMATE_D->check_set(this_object(), me, 1));

  return 1;
}

int wear() {
  object me = environment();

  if (!objectp(me)) {
    return 0;
  }

  if (!valid_equip(me)) {
    return notify_fail("你目前无法装备这样东西。\n");
  }

  if (!::wear()) {
    return 0;
  }

  catch(ULTIMATE_D->equip(this_object(), me));
  catch(ULTIMATE_D->check_set(this_object(), me, 1));

  return 1;
}

int unequip() {
  object me = environment();

  if (!::unequip()) {
    return 0;
  }

  catch(ULTIMATE_D->unequip(this_object(), me));
  catch(ULTIMATE_D->check_set(this_object(), me, -1));

  return 1;
}

int is_diablo_ob() {
  return 1;
}
