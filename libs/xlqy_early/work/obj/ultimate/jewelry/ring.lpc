#include <armor.h>

inherit ULTIMATE_JEWELRY;

void create()
{
    set_name("戒指", ({"ring"}));
    set_weight(500);

    if ( clonep() )
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("material", "iron");
        set("unit", "枚");
        set("armor_prop/armor", 1);
        set("armor_type", TYPE_RING);
    }

    ::create();

    setup();
}

