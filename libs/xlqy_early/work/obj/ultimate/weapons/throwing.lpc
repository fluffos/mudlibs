#include <weapon.h>

inherit ULTIMATE_WEAPON;

void create() {
  set_name("翎", ({ "ling" }));
  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "支");
    set_weight(50);
    set("value", 0);
  }

  set("weapon_prop/damage", 1);
  seteuid(getuid());

  if (clonep(this_object())) {
    return;
  }

  set("skill_type", "throwing");

  /*    if( !query("actions") ) {
    set("actions", (: call_other, WEAPON_D, "query_action" :));
    set("verbs", ({ "throw" }) );
    }
    */
  ::create();

  setup();
}
