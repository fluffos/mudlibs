#include <weapon.h>

inherit ULTIMATE_WEAPON;

void create() {
  set_name("杖", ({ "staff", "zhang" }));
  set_weight(4000);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "把");
    set("value", 0);
    set("material", "iron");
    set("wield_msg", "$N拿出一把$n，握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  set("weapon_prop/damage", 1);
  set("flag", LONG);
  set("skill_type", "staff");

  /*    if( !query("actions") ) {
        set("actions", (: call_other, WEAPON_D, "query_action" :) );
        set("verbs", ({ "bash", "crush", "slam", "pierce", "impale" }) );
    }
    */

  ::create();

  setup();
}
