#include <weapon.h>

inherit ULTIMATE_WEAPON;

void create() {
  set_name("耙", ({ "rake" }));
  set_weight(8000);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "柄");
    set("value", 0);
    set("material", "iron");
    set("wield_msg", "$N抄起一柄$n，在头上挥舞了一圈。\n");
  }

  set("weapon_prop/damage", 1);
  set("flag", EDGED);
  set("skill_type", "rake");

  /*    if( !query("actions") ) {
    set("actions", (: call_other, WEAPON_D, "query_action" :) );
    set("verbs", ({ "rake", "strike", "bash" }) );
    }
    */

  ::create();

  setup();
}
