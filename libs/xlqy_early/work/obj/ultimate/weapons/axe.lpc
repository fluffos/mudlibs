#include <weapon.h>

inherit ULTIMATE_WEAPON;

void create()
{
    set_name("斧", ({ "axe"}) );
    set_weight(6000);

    if ( clonep() )
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("unit", "把");
        set("material", "steel");
        set("value", 0);
        set("wield_msg", "$N拿出一把$n，握在手中当作武器。\n");
        set("unwield_msg", "$N放下手中的$n。\n");
    }

    set("weapon_prop/damage", 1);
    set("flag", (int)TWO_HANDED | EDGED);
    set("skill_type", "axe");

/*
    if( !query("actions") ) {
            set("actions", (: call_other, WEAPON_D, "query_action" :) );
            set("verbs", ({ "chop", "slice", "hack" }) );
    }
*/

    ::create();

    setup();
}

