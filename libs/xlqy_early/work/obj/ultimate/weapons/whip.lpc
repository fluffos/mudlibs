#include <weapon.h>

inherit ULTIMATE_WEAPON;

void create() {
  set_name("鞭", ({ "whip" }));
  set_weight(1000);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "条");
    set("value", 0);
  }

  set("weapon_prop/damage", 1);
  set("flag", LONG);
  set("skill_type", "whip");

  /*    if( !query("actions") ) {
    
    set("verbs", ({ "whip","wave" }) );
    set("actions", (: call_other, WEAPON_D, "query_action" :) );
}
*/
  ::create();

  setup();
}
