#include <weapon.h>

inherit ULTIMATE_WEAPON;

void create() {
  set_name("剑", ({ "sword" }));
  set_weight(5000);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "柄");
    set("value", 0);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }

  set("weapon_prop/damage", 1);
  set("flag", EDGED);
  set("skill_type", "sword");

  /*    if( !query("actions") ) {
        set("actions", (: call_other, WEAPON_D, "query_action" :) );
        set("verbs", ({ "slash", "slice", "thrust", "pierce" }) );
    }
    */

  ::create();

  setup();
}
