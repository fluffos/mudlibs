#include <armor.h>

inherit ULTIMATE_ARMOR;

void create()
{
    set_name("盔", ({"head"}));
    set_weight(1000);

    if ( clonep() )
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("material", "iron");
        set("unit", "个");
        set("armor_prop/armor", 1);
        set("armor_type", TYPE_HEAD);
    }

    ::create();

    setup();
}

