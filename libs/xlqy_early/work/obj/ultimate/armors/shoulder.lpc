#include <armor.h>

inherit ULTIMATE_ARMOR;

void create() {
  set_name("护肩", ({ "shoulder" }));
  set_weight(1500);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("material", "bronze");
    set("unit", "副");
    set("armor_prop/armor", 1);
    set("armor_type", TYPE_SHOULDER);
  }

  ::create();

  setup();
}
