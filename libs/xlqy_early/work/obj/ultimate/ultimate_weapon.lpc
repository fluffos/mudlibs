#include <ansi.h>

inherit ULTIMATE_OB;

void create()
{
    set("equip_type", "weapon");
    ::create();
}

mixed hit_ob(object me, object victim, int bonus)
{
    int max, ef;
    object wa;

    wa = this_object();

    if ( !wa->query("weapon_prop/damage") )
    {
        return 0;
    }

    if(wa->query("diablo_prop/combat_hit_kee"))
    {
        if(!random(4))
        {
            ef = wa->query("diablo_prop/combat_hit_kee");
            max = victim->query("max_kee");
            ef = 1+ef*max/10000;

            victim->receive_wound("kee",ef,me);
            message_vision(BLINK+HIR"$N手中的"+wa->query("name")+BLINK+HIR"突然霞光一闪，直冲$n！\n"NOR,me,victim);
        }
    }

    if(wa->query("diablo_prop/combat_hit_sen"))
    {
        if ( !random(4))
        {
            ef = wa->query("diablo_prop/combat_hit_sen");
            max = victim->query("max_sen");
            ef = 1+ef*max/10000;

            victim->receive_wound("sen",ef,me);
            message_vision(BLINK+HIM"$N手中的"+wa->query("name")+BLINK+HIM"突然霞光一闪，直冲$n！\n"NOR,me,victim);
        }
    }

    return 0;
}

