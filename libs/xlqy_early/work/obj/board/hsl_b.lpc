inherit BULLETIN_BOARD;

void create() {
  set_name("幻世大陆留言板", ({ "board" }));
  set("location", "/d/hsl/hsl_start");
  set("board_id", "hsl_b");
  set("long", "这是一个供人留言记事的留言板。\n");
  setup();
  set("capacity", 200);
  replace_program(BULLETIN_BOARD);
}
