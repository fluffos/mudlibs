#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

string give_reward(object me);

void create() {
  set_name(HIG "粽子" NOR, ({ "zongzi" }));
  set_weight(100);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("long", HIG "一个香喷喷的粽子，包它的粽子叶泛出一股清香，抓紧时间吃噢，要不然会坏的。\n" NOR);
    set("unit", "个");
    set("no_give", 1);
    set("no_get", 1);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("value", 100);
    set("food_remaining", 3);
    set("food_supply", 50);
  }
}

void init() {
  if (this_player() == environment()) {
    add_action("do_eat", "eat");
  }

  call_out("dest", 3600);
}

int do_eat(string arg) {
  if (arg != this_object()->query("id")) {
    return 0;
  }

  message_vision("$N张开血盘大口，嗷呜一下把粽子吞下了肚。\n", this_player());

  this_player()->set("food", (int)this_player()->max_food_capacity() * 2);
  this_player()->set("water", (int)this_player()->max_water_capacity());

  give_reward(this_player());
  give_reward(this_player());

  this_player()->add("daoxing", 1000);
  this_player()->add("combat_exp", 1000);
  this_player()->add("potential", 500);

  this_object()->move("/obj/void");
  remove_call_out("dest");
  call_out("dest", 1);

  return 1;
}

void dest() {
  if (environment(this_object())) {
    tell_object(environment(this_object()), "粽子腐烂变质了...\n");
  }

  destruct(this_object());
}

string give_reward(object me) {
  mapping skill = me->query_skills();
  string *skillnames;
  string selected, msg;
  int level;

  if (!skill) {
    return "none";
  }

  skillnames = keys(skill);
  if (sizeof(skillnames) < 1) {
    return "none";
  }

  selected = skillnames[random(sizeof(skillnames))];
  level = skill[selected];
  if (level < 1) {
    return "none";
  }

  me->set_skill(selected, level + 1);

  tell_object(me, "你得到了一级" + to_chinese(selected) + "。\n");
  msg = "听说" + HIR + me->query("name") + NOR + HIG "吃端午粽子，得到一级" + HIW + to_chinese(selected) + NOR + HIG + "！\n" + NOR;

  if (!wizardp(me)) {
    CHANNEL_D->do_channel(this_object(), "rumor", msg);
  }

  return selected;
}
