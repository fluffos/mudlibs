#include <ansi.h>
inherit ITEM;

string give_reward(object me);

void create() {
  set_name(HIW "+团队之星" NOR, ({ "Teamgeista" }));
  set_weight(100);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("long", HIW "世界杯的比赛用球，还等什么呢，大伙都等你开球呢。\n" NOR);
    set("unit", "个");
    set("no_give", 1);
    set("no_get", 1);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("value", 100);
    set("food_remaining", 3);
    set("food_supply", 50);
  }
}

void init() {
  if (this_player() == environment()) {
    add_action("do_eat", "kick");
  }

  call_out("dest", 3600);
}

int do_eat(string arg) {
  if (arg != this_object()->query("id")) {
    return 0;
  }

  message_vision("$N熟练的用手拍了拍球，抡起腿一脚踢向球去。\n", this_player());

  give_reward(this_player());

  this_player()->add("daoxing", 1000);
  this_player()->add("combat_exp", 1000);
  if (this_player()->query_skill("dodge", 1) < 100) {
    this_player()->add("potential", 20000);
  } else if (this_player()->query_skill("dodge", 1) < 200) {
    this_player()->add("potential", 15000);
  } else if (this_player()->query_skill("dodge", 1) < 300) {
    this_player()->add("potential", 8000);
  } else {
    this_player()->add("potential", 3000);
  }

  this_object()->move("/obj/void");
  remove_call_out("dest");
  call_out("dest", 1);

  return 1;
}

void dest() {
  if (environment(this_object()) && userp(environment(this_object()))) {
    if (!random(3)) {
      message_vision("只见$N飞起一脚，却一不小心踢到了地上，痛得是呲牙咧嘴。\n", environment(this_object()));
    } else if (!random(3)) {
      message_vision("只见$N飞起一脚，将皮球踢的踪迹不见，过了一会只见几片鸟毛飘了下来。\n", environment(this_object()));
    } else if (random(2)) {
      message_vision("只见$N飞起一脚，将皮球踢的踪迹不见，到了晚上，人们突然发现天上多了一个月亮。\n", environment(this_object()));
    } else if (random(2)) {
      message_vision("只见$N飞起一脚，将皮球踢的踪迹不见，过了半月，只见天崩地裂原来是把太阳给踢下来了。\n", environment(this_object()));
    } else {
      message_vision(
        "只见$N飞起一脚，将皮球踢的踪迹不见，突然$N变成了一个三岁娃娃，原来皮球速度太快造出了一个黑洞导致时空错乱了。\n",
        environment(this_object())
      );
    }
  }

  destruct(this_object());
}

string give_reward(object me) {
  mapping skill = me->query_skills();
  string *skillnames;
  string selected, msg;
  int level;

  if (!skill) {
    return "none";
  }

  skillnames = keys(skill);
  if (sizeof(skillnames) < 1) {
    return "none";
  }

  selected = skillnames[random(sizeof(skillnames))];
  level = skill[selected];
  if (level < 1) {
    return "none";
  }

  me->set_skill(selected, level + 1);

  tell_object(me, "你得到了一级" + to_chinese(selected) + "。\n");
  msg = "听说" + HIR + me->query("name") + NOR + HIW "为世界杯开球，得到一级" + HIW + to_chinese(selected) + NOR + HIG + "！\n" + NOR;

  if (!wizardp(me)) {
    CHANNEL_D->do_channel(this_object(), "rumor", msg);
  }

  return selected;
}
