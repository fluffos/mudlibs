#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

string give_reward(object me);
void create() {
  set_name(HIG "技能丹" NOR, ({ "jinengdan" }));
  set_weight(100);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("long", HIG "一颗神秘莫测的仙丹，似乎对修行很有帮助。\n" NOR);
    set("unit", "个");
    set("no_get", 1);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("value", 100);
    set("food_remaining", 3);
    set("food_supply", 50);
  }
}

void init() {
  if (this_player() == environment()) {
    add_action("do_eat", "eat");
  }
}

int do_eat(string arg) {
  if (arg != this_object()->query("id")) {
    return 0;
  }

  message_vision("$N张开血盘大口，嗷呜一下把仙丹塞到牙缝里去了\n", this_player());

  this_player()->set("food", (int)this_player()->max_food_capacity() * 2);
  this_player()->set("water", (int)this_player()->max_water_capacity());

  give_reward(this_player());

  this_object()->move("/obj/void");
  destruct(this_object());

  return 1;
}

string give_reward(object me) {
  mapping skill = me->query_skills();
  string *skillnames;
  string selected, msg;
  int level;

  if (!skill) {
    return "none";
  }

  skillnames = keys(skill);
  if (sizeof(skillnames) < 1) {
    return "none";
  }

  selected = skillnames[random(sizeof(skillnames))];
  level = skill[selected];
  if (level < 1) {
    return "none";
  }

  me->set_skill(selected, level + 1);

  tell_object(me, "你得到了一级" + to_chinese(selected) + "。\n");
  msg = "听说" + HIR + me->query("name") + NOR + HIG "吃技能丹，得到一级" + HIW + to_chinese(selected) + NOR + HIG + "！\n" + NOR;

  if (!wizardp(me)) {
    CHANNEL_D->do_channel(this_object(), "rumor", msg);
  }

  return selected;
}
