// autoload.c

string *autoload;

void clean_up_autoload() {
  autoload = 0;
}

void save_autoload() {
  object *inv;
  int i, j, count;
  mixed param;

  inv = all_inventory();
  autoload = allocate(sizeof(inv));

  count = sizeof(inv);

  for (i = 0, j = 0; i < count; i++) {
    if (!(param = inv[i]->query_autoload())) {
      continue;
    }
    autoload[j] = base_name(inv[i]);
    if (stringp(param)) {
      autoload[j] += ":" + param;
    }
    j++;
  }

  autoload = autoload[0..j - 1];
}

void restore_autoload() {
  int i, count = 0;
  object ob;
  string file, param, err;

  if (!pointerp(autoload)) {
    return;
  }

  count = sizeof(autoload);
  for (i = 0; i < count; i++) {
    if (sscanf(autoload[i], "%s:%s", file, param) != 2) {
      file = autoload[i];
      param = 0;
    }

    err = catch(ob = new(file));

    if (err || !ob || (file[0..2] == "/u/" && !wizardp(this_object()))) {
      write("你觉得似乎失落了什么重要的东西，最好通知一下巫师。\n");
      log_file(
        "AUTOLOAD",
        sprintf(
          "Fail to autoload %s of %s, error %s on %s\n",
          file,
          this_object()->query("id"),
          err,
          ctime(time())
        )
      );
      continue;
    }

    export_uid(ob);

    ob->wear();
    ob->set("owner_id", this_object()->query("id"));
    ob->autoload(param);
    ob->move(this_object());
  }

  {
    object user, cloth;

    user = this_object();

    if (user->query("gender") == "女性") {
      cloth = new("/obj/loginload/skirt.lpc");
      cloth->move(user);
      cloth->wear();
      cloth = new("/obj/loginload/shoes.lpc");
      cloth->move(user);
      cloth->wear();
    } else {
      cloth = new("/obj/loginload/linen.lpc");
      cloth->move(user);
      cloth->wear();
    }
  }

  clean_up_autoload();        // To save memory.
}
