// attribute.c
//modified by gamer@88 2004.02

//　　力 量 影响角色的普通攻击力和负重量上限--------------------------str
//　　根 骨 影响角色的五行防御力和生命恢复速度------------------------con
//　　胆 识 影响角色的命中率------------------------------------------cor
//　　定 力 影响角色的躲避率------------------------------------------cps
//　　幸 运 影响角色的获得经验值的速度，影响受伤几率------------------kar
//　　魅 力 和npc打交道时，hmm       ---------------------------------per
//　　灵 性 影响角色的五行攻击力和精气恢复速度------------------------spi
//    悟 性 影响角色学习的速度和效率 ---------------------------------int
//	   等 级 影响角色的气血精神，攻击防御等...
//			
#include <dbase.h>
#include <skill.h>

int query_str() {
  return (int)query("str") + (int)query("force_factor") + query_temp("apply/strength") + query("gift_modify/str");
}

int query_cor() {
  int final = (int)query("cor") + query_temp("apply/courage") + query("gift_modify/cor");

  if ((int)query_skill("unarmed", 1) > 30) {
    final += ((int)query_skill("unarmed", 1) - 30) / 15;
  }

  return final;
}

int query_int() {
  int final;

  final = (int)query("int") + query_temp("apply/intelligence") + query("gift_modify/int");

  if ((int)query_skill("literate", 1) > 20) {
    final += ((int)query_skill("literate", 1) - 20) / 10;
  }

  if (final > 100 && !query("skill_level/literate")) {
    final = 100;
  }

  final += LEVEL_D->query_level_index(query("skill_level/literate")) * 100;

  if (this_object()->can_special("intellect")) {
    final += 100;
  }

  return final;
}

int query_spi() {
  int final;

  final = (int)query("spi") + query_temp("apply/spirituality") + query("gift_modify/spi");

  if ((int)query_skill("spells", 1) > 20) {
    final += ((int)query_skill("spells", 1) - 20) / 10;
  }

  return final;
}

int query_cps() {
  int final = (int)query("cps") + query_temp("apply/composure") + query("gift_modify/cps");

  if ((int)query_skill("parry", 1) > 30) {
    final += ((int)query_skill("parry", 1) - 30) / 15;
  }

  return final;
}

int query_per() {
  int final = (int)query("per") + query("gift_modify/per") + query_temp("apply/personality");

  if ((int)query_skill("dodge", 1) > 60) {
    final += ((int)query_skill("dodge", 1) - 60) / 30;
  }

  return final;
}

int query_con() {
  int final;

  final = (int)query("con") + query_temp("apply/constitution") + query("gift_modify/con");

  if ((int)query_skill("force", 1) > 20) {
    final += ((int)query_skill("force", 1) - 20) / 10;
  }

  return final;
}

int query_kar() {
  int final, don, effect;

  don = (int)query("donation") / 1000000;
  don = ((int)(sqrt(1 + 8 * don)) - 1) / 2;
  don = (int)floor(don);
  final = to_int(don);
  effect = final;
  final += (int)query("kar") + query_temp("apply/karma") + query("gift_modify/kar");

  effect = final - 20 + random(10);
  if (effect < 10) {
    effect = 10;
  }
  if (effect > 80) {
    effect = 75 + random(15);
  }
  if (query("age") >= 18 && query("special_skill/lucky") && !query_temp("set_lucky")) {
    set_temp("gain_more_reward", effect * 30);
    set_temp("set_lucky", 1);
  }

  return final;
}
