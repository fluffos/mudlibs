inherit NEWNPC;

#include <ansi.h>

string *names = ({
  "狮驼岭妖怪",
  "流沙河妖怪",
  "无底洞妖怪",
  "平顶山妖怪",
  "通天河妖怪",
  "小西天妖怪",
  "无底洞妖怪",
  "火云洞妖怪",
  "碧波潭妖怪",
  "金兜山妖怪",
});

void leave();

void create() {
  ::create();
}

void generate_me(object who, int level, int period) {
  ::generate_me(
    who,
    -5,
    10,
    FAMILY_D->random_class(),
    0,
    0,
    names[random(sizeof(names))],
    ({ "yao guai", "guai" }),
    1
  );
  ::set_period(period);

  set("long", "来凡间吃人的妖怪。\n");
  set("gender", "男性");
  set("title", "先遣部队");
  set("attitude", "peaceful");

  set("sxy", 1);

  remove_call_out("leave");
  call_out("leave", 120);
}

void leave() {
  if (this_object()) {
    if (environment()) {
      command("say 嘿嘿，这么久没人敢来，看来是怕了我了。。。\n");
      message("vision", HIB + name() + " 打个呼哨，驾着阵狂风去了。\n\n" NOR, environment());
    }

    destruct(this_object());
  }

  return;
}

void die() {
  object killer = query_temp("last_damage_from");

  remove_call_out("leave");

  if (killer && killer->query("job/xue/step") && query("sxy") && query("owner") == killer
    && environment(this_object()) == environment(killer) && living(killer)) {
    killer->add("job/xue/gong", 1);

    MONITOR_D->report_job_msg(killer->name(1) + "(" + killer->query("id") + ")杀死了" + query("name") + "，获得一点功绩！\n");

    message_vision("$N杀死了一个来凡间吃人的妖怪，$N的功绩提高了！\n", killer);
  }

  destruct(this_object());
}
