inherit NEWNPC;

#include <ansi.h>

void create() {
  ::create();

  set_name("试招弟子", ({ "wuguan dizi" }));
  set("taskguai", 0);
}

void init() {
  add_action("do_family", "menpai");
  add_action("do_combat", "combat");
  add_action("do_level", "level");
  add_action("do_kill", "kill");
  add_action("do_kill", "cast");
  add_action("do_kill", "perform");
  add_action("do_kill", "steal");
  add_action("do_kill", "ji");
}

int do_family(string arg) {
  object who = this_player();

  if ("" == arg || !arg) {
    tell_object(who, "可用门派: 南海普陀山 方寸山三星洞 月宫\n");
  } else if ("none" == arg) {
    delete("myfamily");
  } else {
    set("myfamily", arg);
  }

  return 1;
}

int do_combat(string arg) {
  object who = this_player();
  int ind;

  if ("" == arg || !arg || sscanf(arg, "%d", ind) != 1 || ind < 0 || ind > 100) {
    tell_object(who, "可用范围: 0-100\n");
  } else {
    set("mycombat", ind);
  }

  return 1;
}

int do_level(string arg) {
  object who = this_player();
  int ind;

  if ("" == arg || !arg || sscanf(arg, "%d", ind) != 1 || ind < 0 || ind > 100) {
    tell_object(who, "可用范围: 0-100\n");
  } else {
    set("testlvl", ind);
  }

  return 1;
}

void generate_me(object who, int level, int period, string name, string *id) {
  if (query("myfamily")) {
    ::generate_me(who, level, level, query("myfamily"), 0, (int)query("mycombat"), name, id, 0);
  } else {
    ::generate_me(who, level, level, who->query_family(), 0, (int)query("mycombat"), name, id, 0);
  }
  ::set_period(period);
  set("taskguai", 0);
}

void kill_ob(object ob) {
  object me = this_object();
  object *inv;
  int i, count;

  inv = all_inventory(me);
  count = sizeof(inv);

  for (i = 0; i < count; i++) {
    if (0 < inv[i]->query("weapon_prop/damage") && inv[i]->query("skill_type")) {
      inv[i]->unequip();
      destruct(inv[i]);
    } else if (mapp(inv[i]->query("armor_prop")) && inv[i]->query("armor_type")) {
      inv[i]->unequip();
      destruct(inv[i]);
    }
  }

  generate_me(ob, 0, (int)query("testlvl"), "测试人物", ({ "wuguan dizi" }));

  ::kill_ob(ob);
}

void die() {
  object killer = query_temp("last_damage_from");

  this_object()->set("is_diablo_npc", 1);
  this_object()->set("magic_find", 250000);

  //DIABLO_D->diablo_drop(this_object(), killer);
  ULTIMATE_D->ultim_drop(this_object(), killer);

  ::die();
}

void unconcious() {
  die();
}

int do_kill(string arg) {
  object who = this_player();

  if (id(arg) && is_fighting() && query("owner") && who != query("owner")) {
    tell_object(who, "我还有正事，不能随意动武!\n");
    return 1;
  }

  return 0;
}
