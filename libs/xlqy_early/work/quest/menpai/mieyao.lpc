int add_new_yao(object me);

void create() {
  seteuid(getuid());
}

string query_yao(object me) {
  mapping secmieyao;

  if (mapp(secmieyao = me->query("job/menpai")) && "asked" == secmieyao["step"]) {
    if (me->query("mud_age") >= secmieyao["mudage"]
      && me->query("mud_age") - secmieyao["mudage"] < 300) {
      return ("不是让你去杀了" + secmieyao["place"] + "的" + secmieyao["name"] + "(" + secmieyao["id"] + ")么？\n");
    } else {
      write(me->name(1) + ", 你真是没用，我再给你一次机会！\n");
      if (me->query_temp("job/menpai/ob") && living(me->query_temp("job/menpai/ob"))) {
        destruct(me->query_temp("job/menpai/ob"));
      }
      me->delete("job/menpai/step");
      me->delete_temp("menpai/level");
    }
  }

  if (mapp(secmieyao) && "done" == secmieyao["step"]
    && (me->query("mud_age") - secmieyao["mudage"]) >= 0
    && (me->query("mud_age") - secmieyao["mudage"]) < 120) {
    return ("辛苦你了，你还是先下去休息一下吧！\n");
  }

  if (9 <= me->query_temp("menpai/level")) {
    me->set_temp("menpai/level", 1);
  } else {
    me->add_temp("menpai/level", 1);
  }

  if (0 == add_new_yao(me)) {
    me->delete("job/menpai/step");
    return "创建任务怪失败，请联系巫师!\n";
  }

  me->set("job/menpai/step", "asked");
  me->set("job/menpai/mudage", me->query("mud_age"));
  secmieyao = me->query("job/menpai");
  if (secmieyao["type"] == "xian") {
    return ("现有" + secmieyao["name"] + "(" + secmieyao["id"] + ")在" + secmieyao["place"] + "为非作歹，\n你马上去灭了他，以尽除妖灭魔的义务！\n");
  } else {
    return ("现在" + secmieyao["name"] + "(" + secmieyao["id"] + ")出现在" + secmieyao["place"] + "一带，\n你马上去灭了他，打击他们的气焰！\n");
  }
}

int add_new_yao(object me) {
  string type;
  string sname;

  string *yaoname;
  int index, i, j;
  mapping secmieyao;
  object yao;

  if (0 > FAMILY_D->family_type(me->query_family())) {
    type = "mo";
    yaoname = xianname;
  } else {
    type = "xian";
    yaoname = guainame;
  }

  index = random(sizeof(yaoname) / 2) * 2;

  secmieyao = ([ "type": type ]);
  secmieyao += ([ "id": yaoname[index + 1] ]);

  sname = "得道 " + yaoname[index];
  i = me->query_temp("menpai/level");
  if (i < 1) {
    i = 1;
  }
  if (i > 9) {
    i = 9;
  }

  secmieyao += ([ "name": sname ]);

  yao = new(__DIR__ "yao0");
  if (!yao) {
    write("生成随机怪失败。\n");
    return 0;
  }

  if (0 == RANDPLACE_D->random_place(yao, me, 10)) {
    write("生成随机地点失败。\n");
    destruct(yao);
    return 0;
  }

  me->set("job/menpai", secmieyao);

  yao->generate_me(me, i, 3, secmieyao["name"], ({ secmieyao["id"] }));

  me->set_temp("job/target", yao);
  me->set_temp("job/menpai/ob", yao);  //便于取消时销毁花仙

  me->set("job/menpai/place", me->query_temp("guai/place"));
  me->set("job/menpai/location", me->query_temp("guai/location"));

  return 1;
}
