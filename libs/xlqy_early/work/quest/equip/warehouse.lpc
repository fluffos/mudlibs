inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIW "武器装备库" NOR);
  set("long", @LONG
这里是洪荒西游的武器装备库，墙上(wall)挂满了各式各样的兵器盔甲。
请先用open命令打开自己的仓库，用close命令关闭。
LONG);
  set("exits",
    ([  //sizeof() == 1
    "out": "/d/city/droproom",
    ]));

  set("no_fight", 1);
  set("no_magic", 1);
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_open", "open");
  add_action("do_close", "close");
  add_action("do_rename", "rename");
}

int do_open(string arg) {
  object me = this_player();
  object equipman;

  if (!(equipman = present(me->query("id") + " equipman", environment(me)))) {
    equipman = new("/quest/equip/npc/equipman");
  }

  if (!equipman) {
    tell_object(me, "你的仓库出错了，请与巫师联系。\n");
    return 1;
  }

  equipman->set_owner(me);

  if (!equipman->move(environment(me))) {
    tell_object(me, "你的仓库没法移动，请与巫师联系。\n");
    return 1;
  }

  tell_object(me, "你的仓库已经打开了。\n");
  tell_object(me,
    "look weapons    查看武器。\n"
    "look armors     查看盔甲。\n"
    "look baoshis    查看宝石。\n"
    "look charms     查看神符。\n");

  return 1;
}

int do_close(string arg) {
  object me = this_player();

  tell_object(me, "你的仓库已经关闭了。\n");

  return 1;
}

int do_rename(string arg) {
  object me, ob;
  string item, msg;

  me = this_player();

  if (!arg) {
    return notify_fail("你要给什么取个名字？\n");
  }

  if (sscanf(arg, "%s %s", item, msg) != 2) {
    return notify_fail("格式为rename <物品id> <名字>。\n");
  }

  if (!(ob = present(item, me))) {
    return notify_fail("你身上没这样东西啊。\n");
  }

  if (!ob->is_ultimate_ob() && !ob->is_diablo_ob()) {
    return notify_fail("不能给这样东西改名！\n");
  }

  if (ob->query("autoloaded")) {
    tell_object(me, "这样东西不能再更改名字了。\n");
    return 1;
  }

  msg += "$NOR$";

  msg = replace_color(msg, 1);

  me->add("sen", -10);

  if (strlen(msg) > 60) {
    return notify_fail("名字也太长了点吧！\n");
  }

  ob->set("name", msg);
  ob->set("have_set_name", 1);
  write("ＯＫ！\n");

  return 1;
}
