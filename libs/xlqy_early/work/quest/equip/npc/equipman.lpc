inherit F_CLEAN_UP;
inherit NEWSAVE;
inherit F_MOVE;
inherit F_NAME;

#define MAX_SIZE_WEAPON 100
#define MAX_SIZE_ARMOR 100
#define MAX_SIZE_CHARM 100
#define MAX_SIZE_BAOSHI 100

mapping weapons;
mapping armors;
mapping charms;
mapping baoshi;

void setup() {
  seteuid(getuid());
}

void create() {
  ::create();
  set_name("装备仓库", ({ "admin equipman" }));
  set_savepath("equip");
  remove_call_out("leave");
  call_out("leave", 900);

  setup();
}

string query_save_file() {
  string id;
  string *filename;

  id = query("id", 1);

  if (!id) {
    id = geteuid();
  }
  if (!id) {
    id = getuid();
  }
  if (!stringp(id)) {
    return 0;
  }

  filename = explode(id, " ");

  return sprintf(query("save_path") + "%c/%s", id[0], filename[0]);
}

void set_owner(object who) {
  set("owner", who);
  set_name(who->name(1) + "的装备仓库", ({ who->query("id") + " equipman" }));

  if (file_size(query_save_file() + __SAVE_EXTENSION__) <= 0) {
    this_object()->save();
  }

  restore();
  delete("env/invisibility");
  set("env/hide", 1);
}

void init() {
  add_action("do_pick", "pick");
  add_action("do_put", "put");
  add_action("do_look", "look");
}

mapping query_weapon() {
  return weapons;
}

void look_weapon(object who) {
  int count, i;
  string msg = "";

  if (!weapons || 0 >= (count = sizeof(weapons))) {
    tell_object(who, "你的武器库还是空的。\n");
    return;
  }

  count = sizeof(weapons);

  for (i = 1; i <= MAX_SIZE_WEAPON; i++) {
    if (weapons[i] && weapons[i]["name"]) {
      msg += "" + i + "、" + weapons[i]["name"] + "\n";
    }
  }

  who->start_more(msg);
}

void look_armor(object who) {
  int count, i;
  string msg = "";

  if (!armors || 0 >= (count = sizeof(armors))) {
    tell_object(who, "你的盔甲库还是空的。\n");
    return;
  }

  count = sizeof(armors);

  for (i = 1; i <= MAX_SIZE_ARMOR; i++) {
    if (armors[i] && armors[i]["name"]) {
      msg += "" + i + "、" + armors[i]["name"] + "\n";
    }
  }

  who->start_more(msg);
}

void look_charm(object who) {
  int count, i;
  string msg = "";

  if (!charms || 0 >= (count = sizeof(charms))) {
    tell_object(who, "你的神符库还是空的。\n");
    return;
  }

  count = sizeof(charms);

  for (i = 1; i <= MAX_SIZE_CHARM; i++) {
    if (charms[i] && charms[i]["name"]) {
      msg += "" + i + "、" + charms[i]["name"] + "\n";
    }
  }

  who->start_more(msg);
}

int do_look(string arg) {
  object me = this_player();

  switch (arg) {
    case "weapons":
      look_weapon(me);
      return 1;
      break;

    case "armors":
      look_armor(me);
      return 1;
      break;

    case "charms":
      look_charm(me);
      return 1;
      break;

    case "baoshi":
      return 1;
      break;

    default:
      break;
  }

  return 0;
}

void put_weapon(object me, object obj) {
  int i = 0;

  if (weapons && sizeof(weapons) >= MAX_SIZE_WEAPON) {
    tell_object(me, "你的武器库已经满了。\n");
    return;
  }

  if (weapons) {
    for (i = 0; i < MAX_SIZE_WEAPON; i++) {
      if (undefinedp(weapons[i + 1])) {
        break;
      }
    }

    if (i >= MAX_SIZE_WEAPON) {
      tell_object(me, "你的武器库已经满了。\n");
      return;
    }

    obj->set("files", base_name(obj) + ".lpc");
    weapons += ([ i + 1: obj->query_entire_dbase() ]);
  } else {
    obj->set("files", base_name(obj) + ".lpc");
    weapons = ([ i + 1: obj->query_entire_dbase() ]);
  }

  tell_object(me, "你将" + obj->query("name") + "放进武器库。\n");
  destruct(obj);

  this_object()->save();
}

