int do_put(string arg) {
  object me = this_player();
  object obj;

  if (!arg) {
    return 0;
  }

  if (!(obj = present(arg, me))) {
    return 0;
  }

  if (!obj->is_ultimate_ob() && !obj->is_diablo_ob()) {
    return 0;
  }

  if (obj->query("autoloaded")) {
    return 0;
  }

  if (mapp(obj->query("weapon_prop"))) {
    put_weapon(me, obj);
    return 1;
  }

  if (mapp(obj->query("armor_prop"))) {
    put_armor(me, obj);
    return 1;
  }

  if (obj->query("charm/id")) {
    put_charm(me, obj);
    return 1;
  }

  return 0;
}

void pick_weapon(object me, int index) {
  int i, count;
  object obj;
  mapping dbase;
  string *prop;

  if (!weapons || undefinedp(weapons[index]) || undefinedp(weapons[index]["files"]) || undefinedp(weapons[index]["name"])) {
    tell_object(me, "你没有这个武器。\n");
    return;
  }

  obj = new(weapons[index]["files"]);

  if (!obj) {
    tell_object(me, "复制失败，联系巫师。\n");
    return;
  }

  dbase = weapons[index];
  prop = keys(dbase);

  for (i = 0; i < sizeof(prop); i++) {
    obj->set(prop[i], dbase[prop[i]]);
  }

  if (!obj->move(me)) {
    obj->move(environment(me));
  }

  map_delete(weapons, index);

  tell_object(me, "你从武器库取出" + obj->query("name") + "。\n");

  this_object()->save();
}

