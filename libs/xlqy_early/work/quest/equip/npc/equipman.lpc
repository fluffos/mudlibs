int do_pick(string arg) {
  object me = this_player();
  string type;
  int index;
  object obj;

  if (!arg) {
    return 0;
  }

  if (sscanf(arg, "%s %d", type, index) != 2) {
    tell_object(me, "命令格式pick weapon 1等\n");
    return 0;
  }

  switch (type) {
    case "weapon":
      pick_weapon(me, index);
      return 1;
      break;

    case "armor":
      pick_armor(me, index);
      return 1;
      break;

    case "charm":
      pick_charm(me, index);
      return 1;
      break;

    case "baoshi":
      break;

    default:
      break;
  }

  return 0;
}

void leavel() {
  object me = this_object();
  object owner;

  remove_call_out("leave");

  if (!me) {
    return;
  }

  owner = me->query("owner");
  if (!owner) {
    destruct(me);
    return;
  }

  if (environment(me) != environment(owner)) {
    destruct(me);
    return;
  }

  call_out("leave", 900);
}
