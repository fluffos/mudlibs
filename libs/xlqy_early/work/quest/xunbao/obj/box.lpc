inherit ITEM;

void create()
{
    set_name("铁盒", ({ "deposit box", "box" }) );
    set_weight(1);
    set_max_encumbrance(1000000);

    if ( clonep() )
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("unit", "只");
        set("value", 1);
    }

    set("max_items", 20);
}

void init()
{
    add_action("do_get", "get");
}

int do_get(string arg)
{
    string obj, from;

    if ( sscanf(arg, "%s from %s", obj, from) == 2 )
    {
        if ( id(from) )
        {
            if ( environment(this_object()) != this_player() )
            {
                tell_object(this_player(), "盒子都不在身上，怎么拿东西?\n");
                return 1;
            }
            else
            {
                set("value", 0);
            }
        }
    }

    return 0;
}

int is_container()
{
    return 1;
}

