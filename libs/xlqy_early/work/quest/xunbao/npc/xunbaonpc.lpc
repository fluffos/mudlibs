#include "ansi.h"

inherit JOBMASTER;

#define MAX_HUIFU   3

string *quests;

int work_me();
int delete_ask(object me);
int start_job(object me);
int test_huifu(object me);

void create()
{
    string file;

    set_name("神秘人", ({"shenmi ren"}));
    set("title", HIY + BCYN "【多宝天尊】" NOR);
    set("gender", "男性" );
    set("age", 33);
    set("int", 30);
    set("per", 25);
    set("combat_exp", 500000000);
    set("daoxing", 800000000);

    set("attitude", "friendly");
    set_skill("unarmed", 60);
    set_skill("dodge", 50);
    set_skill("parry", 50);
    set_skill("spells", 100);
    set_skill("baguazhou", 100);
    set_skill("literate", 50);
    set_skill("sword", 60);  
    set_skill("changquan", 50);  

    map_skill("spells", "baguazhou");
    map_skill("unarmed", "changquan");

    set("per", 30);
    set("max_kee", 400);
    set("max_gin", 400);
    set("max_sen", 400);
    set("force", 450);
    set("max_force", 300);
    set("force_factor", 10);
    set("mana", 6000);
    set("max_mana", 3000);
    set("mana_factor", 100);

    seteuid(getuid());

    set("inquiry", ([
        "寻宝": (: work_me :),
        "取消": (: delete_ask :),
        "测试": (: test_huifu :),
    ]));

    file = read_file("/quest/xunbao/obj/dynamic_quest");      
    quests = explode(file, "\n");

    setup();
    add_money("silver", 5);
    carry_object("/d/obj/cloth/baguapao")->wear();
    carry_object("/d/obj/weapon/sword/taomujian")->wield();
}

void confirm_again(object who)
{
    mapping result;

    if ( MAX_HUIFU < who->query_temp("job/xunbao/huifu") )
    {
        tell_object(who, "想利用bug?\n");
        return;
    }

    result = "/adm/daemons/text2pic_d"->random_string();

    who->set_temp("job/xunbao/answer", result["rand_str"]);
    who->add_temp("job/xunbao/huifu", 1);

    tell_object(who, "请输入以下汉字、数字、或运算结果，注意小数位直接舍去。\n");
    tell_object(who, result["output"] + "\n");
    add_action("do_huifu", "huifu");
}

void give_reward(object who, int times)
{
    int level = who->query("level");
    mapping reward = ([]);
    int i;
    int exp, dx, pot, money;

    if ( 1 >= times )
    {
        i = 1 + random(3);
    }
    else if ( 2 >= times )
    {
        i = 1 + random(2);
    }
    else
    {
        i = 1;
    }

    reward["combat_exp"] = LEVEL_D->query_level_jobreward_exp(level) * i;
    reward["daoxing"] = LEVEL_D->query_level_jobreward_dx(level) * i;
    reward["potential"] = LEVEL_D->query_level_jobreward_qn(level) * i;
    reward["gold"] = i * 50;
    reward["job"] = "xunbao";

    reward = GIFT_D->gift_bonus(who, reward);

    exp = (int)reward["combat_exp"];
    dx = (int)reward["daoxing"];
    pot = (int)reward["potential"];
    money = (int)reward["gold"];

    message_vision(CYN"$N对$n说道：该奖励你" + exp + "点武学及道行，" + pot + "点潜能，" + money + "两黄金。\n"NOR, this_object(), who);
    MONITOR_D->report_job_msg(who->name() + "(" + who->query("id") + ")寻获秘宝，奖励" + exp + "点武学及" + COMBAT_D->chinese_daoxing(dx) + "道行，" + pot + "点潜能，" + money + "两黄金。\n");
}

int do_huifu(string arg)
{
    object me = this_player();

    if ( MAX_HUIFU < me->query_temp("job/xunbao/huifu") )
    {
        tell_object(me, "想利用bug?\n");
        return 1;
    }

    if ( !arg || "" == arg )
    {
        tell_object(me, "回答错误。\n");
        return 1;
    }

    if ( "cancel" == arg )
    {
        confirm_again(me);
        return 1;
    }

    if ( arg != me->query_temp("job/xunbao/answer") )
    {
        if ( MAX_HUIFU <= me->query_temp("job/xunbao/huifu") )
        {
            me->set_temp("job/xunbao/huifu", MAX_HUIFU + 1);
            me->delete_temp("job/xunbao/answer");
            tell_object(me, "连续回答错误，真可惜!\n");
            return 1;
        }
        else
        {
            confirm_again(me);
            return 1;
        }
    }

    give_reward(me, me->query_temp("job/xunbao/huifu"));

    me->set_temp("job/xunbao/huifu", MAX_HUIFU + 1);
    me->delete_temp("job/xunbao/answer");
    tell_object(me, "回答正确!\n");

    this_object()->set("is_diablo_npc", 1);
    this_object()->set("magic_find", 1 + 200);
    DIABLO_D->diablo_drop(this_object(), me);

    this_object()->set("is_diablo_npc", 1);
    this_object()->set("magic_find", 1 + 200);
    DIABLO_D->diablo_drop(this_object(), me);

    this_object()->set("is_diablo_npc", 1);
    this_object()->set("magic_find", 1 + 200);
    DIABLO_D->diablo_drop(this_object(), me);

    return 1;
}

int test_huifu(object me)
{
    object who = this_player();

    if ( !wizardp(who) )
    {
        return 1;
    }

    who->set_temp("job/xunbao/huifu", 0);
    confirm_again(who);

    return 1;
}

int accept_object(object who, object ob)
{
    if ( ob->query("id") != who->query("job/xunbao/objid") )
    {
        write(HIW"这是你的东西吗?\n"NOR);
        return 0;
    }
    if ( ob->query("name") != who->query("job/xunbao/objname") )
    {
        write(HIW"这是你的东西吗?\n"NOR);
        return 0;
    }
    if ( ob->query("owner_name") != who->query("id") )
    {
        write(HIW"这是你的东西吗?\n"NOR);
        return 0;
    }

    who->add("count/xunbao", 1);

    write(HIW"你已为" + this_object()->query("name") + "寻找了 " + who->query("count/xunbao") + " 个宝贝了。\n"NOR);

    who->set("job/xunbao/finished", time() + 3 + random(8));
    who->delete("job/xunbao/asked");
    who->delete("job/xunbao/cancelled");

    who->set_temp("job/xunbao/huifu", 0);
    confirm_again(who);

    return 1;
}

int work_me()
{
	object me;

	me = this_player();

    if ( me->query("job/xunbao/asked") )
    {
        message_vision("$N说道：" + me->query("name") + "，不是让你去给我把" + me->query("job/xunbao/objname") + "拿回来吗?\n", this_object());
        return 1;
    }

    if ( time() < (int)me->query("job/xunbao/cancelled") )
    {
        message_vision("$N说道：" + me->query("name") + "，你刚刚任务失败，还是休息休息吧。\n", this_object());
        return 1;
    }

    if ( time() < (int)me->query("job/xunbao/finished") )
    {
        message_vision("$N说道：" + me->query("name") + "，你刚刚完成任务，还是休息休息吧。\n", this_object());
        return 1;
    }

    if ( 0 == start_job(me) )
    {
        message_vision("$N说道：" + me->query("name") + "，目前还没有任务，你等会再来吧。\n", this_object());
        return 1;
    }

	write(HIW"你已为寻宝大使袁天罡寻找了 " + me->query("count/xunbao") + " 个宝贝了。\n"NOR);

	message_vision("$N说道：" + me->query("name") + "，" + me->query("job/xunbao/owner") +"的" + me->query("job/xunbao/objname") + 
	    "(" + me->query("job/xunbao/objid") + ")目前流落在 " + me->query("job/xunbao/place") + 
	    " 的 " + me->query("job/xunbao/npcname") + "(" + me->query("job/xunbao/npcid") + 
	    ") 身上，请这位" + RANK_D->query_respect(me) + "在 " + chinese_number(me->query("job/xunbao/time")) + " 分钟内去将之寻来与吾。。。\n", this_object());

    return 1;
}

int start_job(object me)
{
    string file = quests[random(sizeof(quests) / 2) * 2];
    object item;
    object box;
    object newnpc;
    mapping npc;

    item = new(file);
    if ( !item )
    {
        write("NO OBJECT\n");
        return 0;
    }

    box = new("/quest/xunbao/obj/box");
    if ( !box )
    {
        write("NO BOX\n");
        destruct(item);
        return 0;
    }

    if ( !item->move(box) )
    {
        write("NO PUT\n");
        destruct(item);
        destruct(box);
        return 0;
    }

    if ( !(npc = RANDPLACE_D->random_npc(10)) )
    {
        write("NO NPC\n");
        destruct(item);
        destruct(box);
        return 0;
    }

    newnpc = npc["targetnpc"];
    me->set("job/xunbao/where", npc["where"]);
    me->set("job/xunbao/place", MISC_D->find_place(npc["env"]));
    me->set("job/xunbao/npcname", newnpc->query("name"));
    me->set("job/xunbao/npcid", newnpc->query("id"));
    me->set("job/xunbao/time", 3 + random(20));
    me->set("job/xunbao/asked", 1);

    box->set_name(me->name() + "的铁盒", ({me->query("id") + "'s deposit box", "deposit box", "box"}));
    box->set("owner_name", me->query("id"));
    box->move(newnpc);

    COMBAT_D->start_xunbao(newnpc, 5 * 60, 1);

    me->set("job/xunbao/owner", item->query("owner_name"));
    me->set("job/xunbao/objname", item->query("name"));
    me->set("job/xunbao/objid", item->query("id"));
    item->set("owner_name", me->query("id"));

    return 1;
}

int delete_ask(object ob)
{
    object me = this_player();

    if ( !me->query("job/xunbao/asked") )
    {
        write("你没有任务。\n");
        return 1;
    }

    me->delete("job/xunbao/asked");
    me->delete("job/xunbao/finished");
    me->set("job/xunbao/cancelled", time() + 10 + random(8));

    write("你真是没用。\n");

    return 1;
}

