inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "山道");
  set("long", @LONG

彩霞山原名落凤山，相传古时一头五色彩凤落在此地，化成此山。
后由于来此的人发现此山在落日时分美丽异常，犹如彩霞笼罩，又被人改为彩霞山。
LONG);

  set("outdoors", "changan");

  set("exits", ([
    "northup": __DIR__ "shandao3",
    "southdown": __DIR__ "shandao1",
    "west": __DIR__ "sihaitang",
    "east": __DIR__ "wairentang",
  ]));

  setup();
}
