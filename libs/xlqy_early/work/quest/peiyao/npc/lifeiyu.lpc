inherit NEWNPC; 

#include <ansi.h>

void create()
{
    set_name("厉师兄", ({"li feiyu", "li shixiong"}));
    set("long",
        "一张原本冷酷的面容因痛苦拧成了一团，嘴角不停地往外流着白沫。\n"
        "很明显这位厉师兄已经疼痛的神智不清了。\n");

    set("gender", "男性");
    set("age", 18);
    set("int", 38);
    set("kee", 1000);
    set("max_kee", 1000);
    set("sen", 1000);
    set("max_sen", 1000);
    set("shen_type", 1);

    set("combat_exp", 500000);
    set("attitude", "heroism");

    set_skill("unarmed", 1000);
    set_skill("dodge", 80);
    set_skill("parry", 1000);
    set_skill("changchun-gong", 500);
    set_skill("force", 500);
    set_skill("eye-sword", 1000);
    set_skill("sword", 1000);

    map_skill("force", "changchun-gong");
    map_skill("sword", "eye-sword");
    map_skill("dodge", "eye-sword");
    map_skill("parry", "eye-sword");
    map_skill("unarmed", "eye-sword");

    set("pub_master", 1);

    set_temp("apply/attack", 70);
    set_temp("apply/defense", 70);
    set_temp("apply/damage", 50);

    setup();
    carry_object("/d/obj/cloth/choupao")->wear();
}

int accept_object(object me, object ob)
{
    object who;
	me = this_object();
    who = this_player();

    if ( ob->query("id") != "yao fen" 
        || ob->query("name") != HIG"无名药粉"NOR
        || ob->query("owner") != who )
    {
        command("say 什么东西，找死啊！\n");
		return 1;
	}	

    if ( !who->query("newbie/lifeiyu") )
    {
        who->set("newbie/lifeiyu", 1);
    }
    call_out("destroy", 1, ob);
    command("love " + who->query("id"));

	return 1;
}

void destroy(object ob)
{
    destruct(ob);
    return;
}

