inherit JOBMASTER; 

#include <ansi.h>

private int ask_job();

void create()
{
    set_name("墨大夫", ({"mo daifu", "mo", "doctor"}));
    set("title", HIG "七玄门" NOR);
    set("nickname", HIR "妙手回春" NOR);
    set("long",
        "这人六十余岁，长的高高瘦瘦，面皮焦黄，\n"
        "却留有一头长到披肩的白发，他一边走一边不停\n"
        "的恭着身子咳嗽，看他咳嗽的辛苦样子，似乎他\n"
        "随时都有倒下的可能，令人十分担心。\n");

    set("gender", "男性");
    set("age", 65);
    set("int", 38);
    set("kee", 1000);
    set("max_kee", 1000);
    set("sen", 1000);
    set("max_sen", 1000);
    set("shen_type", 1);

    set("combat_exp", 500000);
    set("attitude", "heroism");

    set("pub_master", 1);

    set_skill("literate", 1000);
    set_skill("unarmed", 80);
    set_skill("dodge", 80);
    set_skill("parry", 60);
    set_skill("changchun-gong", 500);
    set_skill("force", 500);

    map_skill("force", "changchun-gong");

    set_temp("apply/attack", 70);
    set_temp("apply/defense", 70);
    set_temp("apply/damage", 50);

    set("inquiry", ([
        "配药"   : (: ask_job :),
        "工作"   : (: ask_job :),
        "job"    : (: ask_job :),
    ]));

    setup();
    carry_object("/d/obj/cloth/choupao")->wear();
}

private int ask_job()
{
    object me;
    object *obs;

    me = this_player();

    if ( userp(me) && !me->query("newbie/xue") )
    {
        tell_object(me, "不知所谓。\n");
        return 1;
    }

    if ( me->query_temp("job/peiyao") )
    {
        tell_object(me, "让你干的活你干完了么？\n");
        return 1;
    }

    if ( userp(me) && !wizardp(me) )
    {
        if ( 101 <= me->query("level") )
        {
            tell_object(me, "让你干这活，也太屈就你了吧。\n");
            return 1;
        }
        else if ( 100 == me->query("level") )
        {
            if ( LEVEL_D->query_level_need_exp(101) <= me->query("combat_exp") 
                && LEVEL_D->query_level_need_dx(101) <= me->query("daoxing") )
            {
                tell_object(me, "bug没了，您老就消停会儿吧。\n");
                return 1;
            }
        }
        else
        {
            if ( 1000000000 <= me->query("combat_exp") || 1000000000 <= me->query("daoxing") )
            {
                tell_object(me, "就你这点微末道行，老夫鄙视你。\n");
                return 1;
            }
        }
    }

    if ( userp(me) && !wizardp(me) && (100000000 > me->query("combat_exp") && 100000000 > me->query("daoxing")) )
    {
        tell_object(me, "就凭你就这点能力，我看你连药臼都端不起来！\n");
        return 1;
    }

    if ( 5 > me->query("kee") )
    {
        tell_object(me, "你还是先歇歇吧，万一累出人命来我可负担不起。\n");
        return 1;
    }

    me->set_temp("job/peiyao/working", 1);

    tell_object(me, "好，你就帮我配药(peiyao)吧！喏，就这几味。\n");
    return 1;
}

int prevent_learn(object me, string skill)
{
    if ( "literate" != skill && "changchun-gong" != skill )
    {
        tell_object(me, "这项技能不能传授给你。\n");
        return 1;
    }

    if ( !me->query("newbie/xue") )
    {
        tell_object(me, "你是怎么混进我门内的。\n");
        return 1;
    }

    if ( 1000 <= me->query_skill(skill, 1) )
    {
        tell_object(me, "别开玩笑了，堂堂仙人还不耻下问。\n");
        return 1;
    }

    return 0;
}

