inherit NEWNPC; 

#include <ansi.h>

void create()
{
    set_name("蒙面人", ({"mengmian ren", "zhang tie"}));
    set("long",
        "绝对服从命令、体力惊人。\n"
        "从不开口说话、没有丝毫感情，虽然尚不知他武功怎样，但绝不会太弱。\n");

    set("gender", "男性");
    set("age", 18);
    set("int", 38);
    set("kee", 1000);
    set("max_kee", 1000);
    set("sen", 1000);
    set("max_sen", 1000);
    set("shen_type", 1);

    set("combat_exp", 500000);
    set("attitude", "heroism");

    set_skill("unarmed", 1000);
    set_skill("dodge", 80);
    set_skill("parry", 1000);
    set_skill("changchun-gong", 500);
    set_skill("force", 500);

    map_skill("force", "changchun-gong");

    set_temp("apply/attack", 70);
    set_temp("apply/defense", 70);
    set_temp("apply/damage", 50);

    setup();
    carry_object("/d/obj/cloth/choupao")->wear();
}

