#include <ansi.h>

inherit PERSONAL_ITEM;

void create() {
  set_name(HIG "无名药粉" NOR, ({ "yao fen", "yaofen" }));
  set_weight(350);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("long", "专门缓解抽髓丸疼痛的无名药粉，赶紧给厉师兄送过去吧。\n");
    set("unit", "堆");
  }

  ::create();
  set("no_give", 0);
  set("no_drop", 0);

  setup();
}
