#define MAX_WAIT_TIME 900
#include <ansi.h>
inherit NPC;
int ask_job();
int cancel_me();
void create() {
  set_name(CYN "丹臣子" NOR, ({ "danchen zi", "zi", "danchen" }));
  set("gender", "男性");
  create_family("东海龙宫", 3, "弟子");
  set("long", "峨眉山首徒\n");
  set("age", 50);
  set("title", HIR "峨眉山首徒" NOR);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 30);
  set("max_kee", 6100);
  set("kee", 6100);
  set("max_sen", 5100);
  set("sen", 5100);
  set("combat_exp", 15000000);
  set("daoxing", 45000000);
  set("force", 10000);
  set("mana", 10000);
  set("max_force", 6000);
  set("max_mana", 6000);
  set("force_factor", 300);
  set("mana_factor", 200);
  set("eff_dx", 4500000);
  set("nkgain", 1500);
  set_skill("unarmed", 280);
  set_skill("dragonfight", 280);
  set_skill("parry", 280);
  set_skill("dodge", 280);
  set_skill("dragonstep", 280);
  set_skill("fork", 280);
  set_skill("fengbo-cha", 280);
  set_skill("force", 280);
  set_skill("dragonforce", 280);
  set_skill("spells", 280);
  set_skill("seashentong", 280);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("dodge", "dragonstep");
  map_skill("parry", "fengbo-cha");
  map_skill("fork", "fengbo-cha");
  map_skill("unarmed", "dragonfight");
  /*set("inquiry", ([
             "name" : "在下乃峨眉山白眉道人首徒,丹臣子是也。",
             "十劫难" : (: ask_job :),
             "job" : (: ask_job :),
             "fangqi": (: cancel_me :),
	     "cancel": (: cancel_me :),
                        ]) );*/
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "sheshen" :),
    (: cast_spell, "freez" :),
    (: cast_spell, "water" :),
  }));
  setup();
  carry_object("/obj/tianlong");
  carry_object("/d/obj/armor/jinjia")->wear();
}
int ask_job() {
  object ghost, me;
  int t;
  me = this_player();
  if (!userp(me))
    return 0;
  if (!me->query("jienan")) {
    call_out("start_job", 1, me);
    return 1;
  }
  if ((int)me->query("jienan/start") + MAX_WAIT_TIME > time()) {
    write("你先下去休息吧!\n");
    return 1;
  }
  if ((t = (int)me->query("jienan/start")) && (!(int)me->query("jienan/done"))) {
    if (t <= time() && time() < t + 3600) {
      command("ah");
      command("say 这么快就回来了?\n");
      return 1;
    }
  }
  me->delete("jienan/start");
  call_out("start_job", 1, me);
  return 1;
}
int start_job(object me) {
  string where;
  object ghost;
  int dx;
  if (environment(me) != environment()) return 1;

  /*    dx=(me->query("daoxing")+me->query("combat_exp"))/2;
	if( dx>25000000  )
	{
	       tell_object(me,"你现在不适合这项任务。\n");
                return 1;
    }        */  //  alading 添加 01.11

  if (me->query("jienan/start")) return 1;
  me->set("jienan/done", 0);
  ghost = new(__DIR__ "lg-yao");
  where = ghost->invocation(me, 7);

  message_vision("$N说道：" + HIW "三界劫难又起！\n" NOR, this_object());
  message_vision("$N对$n说道：" + HIR "" + where + "" NOR + "出现，"
    + "快去探察！\n"
    , this_object(), me);
  me->set("jienan/start", time());
  return 1;
}
int cancel_me() {
  object me = this_player();
  int exp, exp_reward;
  exp = (me->query("combat_exp") + me->query("daoxing")) / 2;
  if (exp < 3000)
    return notify_fail("你的武学不够了!\n");
  if (exp < 30000) {
    exp_reward = 500 + exp / 60;
  } else if (exp < 1200000) {
    exp_reward = 1000 + exp / 600;
  } else if (exp < 7500000) {

    exp_reward = 2000 + exp / 6000;
  } else {

    exp_reward = 3500;   // append by alading
  }
  exp_reward = exp_reward * 1.5;
  if (!me->query("jienan/start") ||
    me->query("jienan/done"))

  {
    command("qi");
    command("say 你有劫难？\n");
    return 1;
  }

  if (me->query("sjn_cancel") + MAX_WAIT_TIME > time()) {
    write("你再去找找？\n");
    return 1;
  }
  if ((int)me->query("jienan/start") + MAX_WAIT_TIME / 3 > time()) {
    write("你刚要过任务，还是再去找找吧！\n");  //append by bugbug.
    return 1;
  }
  command("shrug");
  command("say 好吧，接受惩罚，重头开始。\n");
  me->set("sjn_cancel", time());
  me->add("combat_exp", -exp_reward);
  tell_object(me, "你被扣掉了 " + HIY "" + chinese_number(exp_reward)
    + "" NOR + " 点武学经验！\n");
  me->set("jienan/done", 1);
  me->set_temp("jienan/num", 1);
  me->set("jienan/start", 1);
  return 1;
}
