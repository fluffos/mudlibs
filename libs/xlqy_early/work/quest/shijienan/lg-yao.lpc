int cast_chance(int level) {
  int chance;

  chance = 15 + level * 2;
  if (chance > 70)
    chance = 70;
  return chance;
}

void create() {
  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :)
  }));

  set("chat_chance_combat", 5);
  set("name", "test");
  set("age", 20 + random(80));
  set("class", "yao");
  if (!random(10))
    set_weight(1000000);
  if (!random(10))
    set("no_arrest", 1);
  set("combat_exp", 3000);
  set("attitude", "heroism");
  set_skill("unarmed", 10);
  set_skill("jinghun-zhang", 10);
  map_skill("unarmed", "jinghun-zhang");
  set_skill("dodge", 10);
  set_skill("ghost-steps", 10);
  map_skill("dodge", "ghost-steps");
  set_temp("apply/armor", 25);
  set_temp("wuxing/init_done", 1);   //防止在setup中初始化错误的五行属性..
  set("limbs", ({
    "头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂",
    "右臂", "左爪", "右爪", "腰间", "小腹", "前腿", "后腿",
    "前爪", "后爪" }));
  setup();
}

void set_skills(int j, int level) {
  object ob = this_object();
  object weapon;

  ob->set("title", "龙宫怪物");
  create_family("东海龙宫", 3, "弟子");
  ob->set_skill("unarmed", j);
  ob->set_skill("dodge", j);
  ob->set_skill("parry", j);
  ob->set_skill("force", j);
  ob->set_skill("spells", j);

  ob->set_skill("fork", j + random(15));
  ob->set_skill("fengbo-cha", j + random(15));
  ob->set_skill("hammer", j + random(15));
  ob->set_skill("huntian-hammer", j + random(15));
  ob->set_skill("dragonstep", j + random(15));
  ob->set_skill("dragonfight", j + random(15));
  ob->set_skill("dragonforce", j + random(15));
  ob->set_skill("seashentong", j + random(15));

  ob->map_skill("force", "dragonforce");
  ob->map_skill("fork", "fengbo-cha");
  ob->map_skill("hammer", "huntian-hammer");
  ob->map_skill("parry", "huntian-hammer");
  ob->map_skill("spells", "seashentong");
  ob->map_skill("dodge", "dragonstep");
  ob->map_skill("unarmed", "dragonfight");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: cast_spell, "freez" :),
    (: exert_function, "roar" :),
    (: exert_function, "shield" :),
    (: perform_action, "unarmed", "sheshen" :),
  }));
  ob->delete_temp("wuxing/init_done");
  WUXING_D->init_user_wuxing(ob);
  if (random(2))
    weapon = new("/d/obj/weapon/hammer/jingua");
  else
    weapon = new("/d/obj/weapon/fork/gangcha");
  weapon->move(ob);
  carry_object("/d/obj/cloth/shoupiqun")->wear();
  command("wield all");
}

void copy_status(object me, object ob, int lv) {
  int j, lvl, k, m;
  object qm = new("/d/changan/npc/qianmian.lpc");
  int base = 20;

  lvl = lv + base - 2;

  if (qm) {
    mapping skill = ob->query_skills();
    int i = sizeof(skill);
    int *level, max_level;
    int max_sen, max_kee, nl, fl;

    if (i > 0) {
      level = values(skill);
      max_level = level[0];
      while (i--) {  // find out victim's maximum level
        if (level[i] > max_level)
          max_level = level[i];
      }
      max_level = max_level * lvl / base;

    } else max_level = 1;

    qm->copy_status(this_object(), ob, lvl);
    destruct(qm);

    k = (query("daoxing") + query("combat_exp")) / 2;
    for (m = 1; m < 300; m = m + 10) {
      if (m * m * m / 10 > k) break;
    }
    m = m * lvl / base / 3;
    if (max_level < m) max_level = m;
    set_skills(max_level, lv);
    // skill level will be set to the maximum level
    // of the player.

    nl = ob->query("max_force");
    fl = ob->query("max_mana");
    max_sen = query("max_sen") / 2 + random(query("max_sen") / 2);
    max_kee = query("max_kee") / 2 + random(query("max_kee") / 2);
    set("force", nl * 2);
    set("mana", fl * 2);
    set("max_force", nl);
    set("max_mana", fl);
    add("eff_sen", max_sen);
    add("eff_kee", max_kee);
    add("sen", max_sen);
    add("kee", max_kee);
    add("max_sen", max_sen);
    add("max_kee", max_kee);

  } else {  // sth goes wrong.
    leave();
    return;
  }


  set("force_factor", query_skill("force") / 2);
  set("mana_factor", query_skill("spells") / 3);

  set("daoxing", (query("daoxing") * 2 + query("combat_exp")) / 3);
}

int random_place(object me, string *dirs) {
  int i, j, k;
  object newob;
  mixed *file, exit;

  if (!sizeof(dirs)) return 1;

  i = random(sizeof(dirs));    // pick up one directory

  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file)) return 1;

  for (k = 0; k < 30; k++) {  // try 20 times
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          newob->query("no_mieyao") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1)
          continue;

        if (me->move(newob)) {
          message_vision("$N走了过来。\n", me);
          return 1;
        }
      }
    }
  }

  return 0;
}

void _leave() {
  object me = this_object();

  // if in fighting, then don't disappear.
  if (me->is_fighting() || me->is_busy())
    return;
  leave();
}

string invocation(object who, int level) {
  object me = this_object();
  copy_status(me, who, level);
  return _invocation(who, level);
}

string _invocation(object who, int level) {
  object me = this_object(), env;
  string *dirs;
  int exp, i, lvl;
  string where, long;

  dirs = dirs1;

  set_name(
    HIR "" + who->query("name") + "" NOR + HIW "的" + HIC "龙宫判将" NOR,
    ({ who->query("id") + " panjiang", "panjiang" })
  );
  set_living_name(who->query("id") + " panjiang");
  set("owner", who->query("id"));
  set("owner_ob", who);
  long = "一头" + name() + "，修练了有" + chinese_number((query("daoxing") / 1000 / 10) * 10) + "多年道行。它";
  set("long", long + "通体透出一丝仙气。\n");
  me->set("stay_time", time() + 1800);

  if (!random_place(me, dirs)) {
    leave();
    return 0;
  }

  env = environment(me);
  where = me->query("name") + "(" + capitalize(me->query("id")) + ")";
  if (env)
    where += "在" + MISC_D->find_place(env);
  return where;
}

void leave() {
  if (this_object()) {
    if (environment())
      message("vision", HIB + name() +
        "身子一晃，变成一股青烟散去了。\n" NOR, environment());
    this_object()->move("/obj/empty");
    call_out("leave2", 5);
  }
  return;
}

void leave2() {
  if (this_object()) {
    destruct(this_object());
  }
}
void init() {
  object me = this_object();
  object who = this_player();
  string type;
  int t = query("stay_time");

  ::init();

  // if overtime too long, then destroy. mon 7/14/99
  if (t && time() > (t + 800)) {
    remove_call_out("leave");
    call_out("leave", 1);
    return;
  }

  if (t && time() > t) {
    remove_call_out("_leave");
    call_out("_leave", 300);
  }

  if (!userp(this_player())) return;
  if (!living(this_object())) return;


  if (query("owner") == this_player()->
    query("id")) {
    if (!announced) {
      message_vision("$N看见$n，大叫一声：哈哈，送上门来的肉！\n",
        this_object(), who);
      announced = 1;
    }
    kill_ob(this_player());
    if (random(4) > 2)
      set_leader(who);
    this_player()->kill_ob(this_object());

    remove_call_out("check_room");
    call_out("check_room", 2);
  }
}
void check_room() {
  object me = this_object();
  object env = environment(me);

  if (!living(me)) return;
  if (env && (env->query("no_fight") ||
    env->query("no_magic"))) {
    random_move();
  }
}

void unconcious() {
  if (query("kee") < 0 || query("sen") < 0) die();
  else ::unconcious();
}

void die() {
  string owner;
  string skill;
  object owner_ob, spri, map;
  object me = this_object();
  string str;
  string msg;
  int max_kee, max_sen;

  owner = query("owner");
  max_kee = query("max_kee");
  max_sen = query("max_sen");
  // write("kee " + other_kee + ", sen " +other_sen+ "\n");
  if ((other_sen > max_sen / 2) || (other_kee > max_kee / 2)) {
    message_vision("$N死了。\n", this_object());

  } else {
    if (stringp(owner) && objectp(owner_ob = find_player(owner))) {
      if (environment(owner_ob) == environment() && living(owner_ob)) {
        message_vision(death_msg[random(sizeof(death_msg))],
          owner_ob, this_object());
        spri = new(__DIR__ "obj/lgspirit");
        spri->set("owner", owner_ob->query("id"));
        spri->move(owner_ob);
        message_vision("$N得到了：" + HIB "龙宫精神.\n" NOR, owner_ob);
        message_vision(HIY "啪，$N听见似乎有什么东西掉在了地上！\n" NOR, owner_ob);

        give_item(owner_ob, owner_ob->query_kar());

        map = new(__DIR__ "obj/jn-map");
        map->set("owner", owner_ob->query("id"));
        map->move(environment(owner_ob));
        owner_ob->set_temp("jienan/num", 2);
      } else {
        message_vision("$N死了。\n", this_object());
      }
    }
  }
  destruct(this_object());
}
varargs int receive_wound(string type, int damage, object who) {
  string owner = query("owner");

  if (who && who->query("id") != owner && userp(who)) {
    if (damage > 0) {
      switch (type) {
        case "kee": other_kee += damage; break;
        case "sen": other_sen += damage; break;
      }
    }
  }
  return ::receive_wound(type, damage, who);
}

varargs int receive_damage(string type, int damage, object who, string kind) {
  string owner = query("owner");

  if (who && who->query("id") != owner && userp(who)) {
    if (damage > 0) {
      switch (type) {
        case "kee": other_kee += damage; break;
        case "sen": other_sen += damage; break;
      }
    }
  }
  return ::receive_damage(type, damage, who, kind);
}
