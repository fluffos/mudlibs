inherit JOBMASTER;

#include <ansi.h>

int report_huaxian();

void create() {
  set_name("太乙救苦天尊", ({ "jiuku tianzun" }));
  set("gender", "男性");
  set("long", "东极青华大帝又称太乙救苦天尊。\n"
    "太乙救苦天尊有“寻声救苦天尊”、“十方救苦天尊”等号，简称救苦天尊。\n"
    "相传其为玉皇大帝二侍者之一，配合玉帝统御万类。\n"
    "由青玄上帝神化而来，誓愿救度一切众生，所以炁化救苦天尊以度世。\n"
    "你可以向他打听关于搭救(dajiu)/保护(baohu)/放弃(cancel)的事情。\n");
  set("age", 40);
  set("title", HIY + BCYN "【十方救苦】" NOR);

  set("str", 40);
  set("int", 30);
  set("con", 30);
  set("spi", 30);
  set("per", 30);

  set("class", "xian");
  set("attitude", "heroism");

  set("combat_exp", 1500000);
  set("daoxing", 2000000);

  set("max_kee", 20000);
  set("max_sen", 20000);
  set("force", 5000);
  set("max_force", 3000);
  set("force_factor", 150);
  set("mana", 5000);
  set("max_mana", 3000);
  set("mana_factor", 150);

  set("eff_dx", 600000);
  set("nkgain", 600);

  set_skill("unarmed", 170);
  set_skill("dodge", 400);
  set_skill("parry", 170);
  set_skill("sword", 180);
  set_skill("force", 170);
  set_skill("spells", 170);
  set_skill("changquan", 170);
  set_skill("liangyi-sword", 180);
  set_skill("baguazhou", 170);
  set_skill("moshenbu", 170);
  set_skill("lengquan-force", 170);

  map_skill("unarmed", "changquan");
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("sword", "liangyi-sword");
  map_skill("parry", "liangyi-sword");
  map_skill("dodge", "moshenbu");

  set("chat_chance", 1);
  set("chat_msg", ({
    name() + "说道：哎。。近期下界妖怪淫乱，哪位大仙可愿去搭救花仙？\n",
  }));

  set("inquiry", ([
    "花仙子": (: report_huaxian: ),
    "huaxian" : (: report_huaxian: ),
    ]
  )
);

seteuid(getuid());

setup();

carry_object("/d/obj/armor/jinjia")->wear();
carry_object("/d/sky/obj/zhanyaojian")->wield();
}

void init() {
  add_action("do_task", "baohu");
  add_action("do_task", "dajiu");
  add_action("do_cancel", "cancel");
}

int do_task() {
  object me = this_player();
  object guai, xie;
  int level, i;
  int tt;
  string where, msg;

  me->command("say 最近可有妖怪为害花仙？");

  if (userp(me) && me->query("level") < 101) {
    tell_object(me, "你的修为不够，练好了再来！\n");
    return 1;
  }

  if ("done" == me->query("job/dajiu/step")) {
    if ((tt = (int)me->query("job/dajiu/start")) && tt <= time() && time() < tt + 20) {
      message_vision("$N座下莲台一阵光芒闪烁，说道: 花仙已搭救,你还是等等再来。\n", this_object(), me);
      return 1;
    }
  }

  if (me->query("job/dajiu/fail"))  //花仙死掉了
  {
    if ((tt = (int)me->query("job/dajiu/start")) && tt <= time() && time() < tt + 20) {
      tell_object(me, "你任务失败了，等等再来吧！\n");
      return 1;
    }

    me->delete("job/dajiu/fail");
  }

  if ("asked" == me->query("job/dajiu/step")) {
    tell_object(me, "花仙等着搭救呢，快快起程！\n");
    return 1;
  }

  //确定任务等级
  level = me->query_temp("dajiu/level");
  level++;
  if (level < 1) {
    level = 1;
  }
  if (level > 9) {
    level = 9;
  }

  me->set_temp("dajiu/level", level);

  guai = new(__DIR__ "huaxian");

  where = guai->invocation(me, level);
  if (!where) {
    me->delete("job/dajiu/step");
    tell_object(me, "创建任务怪失败，请联系巫师!\n");
    return 1;
  }

  message_vision(CYN "$N对$n说道：现在有" + where + "附近被妖怪掳去，已经快不行了，你去搭救她吧。\n" NOR, this_object(), me);

  me->set_temp("job/target", guai);
  me->delete("job/dajiu/killer");
  me->set("job/dajiu/where", where);
  me->set("job/dajiu/start", time());

  me->set("job/dajiu/id", guai->query("id"));
  me->set("job/dajiu/name", guai->query("name"));

  me->set_temp("protect/prevent_die", this_object());
  me->set_temp("job/dajiu/die", 0);

  me->set_temp("job/dajiu/ob", guai);  //便于取消时销毁花仙
  me->set("job/dajiu/step", "asked");

  xie = new(__DIR__ "shoes.lpc");
  xie->move(me);

  message_vision("$N变出一双水晶鞋。\n $N给$n一双水晶鞋。\n", this_object(), me);

  MONITOR_D->report_system_msg(me->name(1) + "(" + me->query("id") + ")接到了一个搭救" + guai->name() + "的任务！\n");

  return 1;
}

int do_cancel() {
  object me = this_player();
  object guai;
  int tt;

  me->delete_temp("protect/prevent_die");

  if (!me->query("job/dajiu/step") || "done" == me->query("job/dajiu/step")) {
    tell_object(me, "你没有任务在身。\n");
    return 1;
  }

  if ((tt = (int)me->query("job/dajiu/start"))) {
    if (tt <= time() && time() < tt + 300) {
      message_vision("$N对$n说道：时辰未到，不可放弃。\n", this_object(), me);
      return 1;
    } else {
      me->command("say 这个任务弟子恐怕无能为力搭救。");
      message_vision(CYN "$N对$n说道：好吧，那我另派神仙搭救吧。\n" NOR, this_object(), me);

      me->delete("job/dajiu/fail");
      me->delete("job/dajiu/start");
      me->delete("job/dajiu/step");

      guai = me->query_temp("job/dajiu/ob");
      if (living(guai)) {
        destruct(guai);
      }
      me->delete_temp("job/dajiu");

      return 1;
    }
  }

  return 1;
}

int report_huaxian() {
  tell_object(
    this_player(),
    sprintf("" + query("name") + "告诉你：一共搭救了  %d  个花仙。\n", this_player()->query("coung/dajiu"))
  );
  return 1;
}

int player_die(object who, object killer) {
  if (!killer || !killer->query("owner") || !objectp(killer->query("owner"))
    || killer->query("owner") != who) {
    return 0;
  }

  if (who->query_temp("job/dajiu/die") < 3) {
    int level = who->query("level");
    int exp = LEVEL_D->query_level_jobreward_exp(level) / 10;
    int dx = LEVEL_D->query_level_jobreward_dx(level) / 10;

    message_vision(BLINK + YEL "突然天空中散出一道圣光，笼罩住$N全身。\n" NOR, who);

    who->recover_me();

    who->add("count/dajiu_exp", -exp);
    who->add("count/dajiu_dx", -dx);

    who->add("combat_exp", -exp);
    who->add("daoxing", -dx);

    who->start_busy(1);

    who->add("count/dajiu_die", 1);
    who->add_temp("job/dajiu/die", 1);

    return 1;
  }

  who->add_temp("job/dajiu/die", 1);
  message_vision(HIY + query("name") + "盯着$N,摇了摇头说:看来你的修行不够,不可担当大任。说完伸手在$N顶门一拍\n" NOR, who);

  return 0;
}
