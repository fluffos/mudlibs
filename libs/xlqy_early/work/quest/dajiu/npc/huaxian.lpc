inherit NEWNPC;

#include <ansi.h>

void _leave();
void leave();

string *names = ({
    "花仙",
    "太阳花仙",
    "玫瑰花仙",
    "杜鹃花仙",
    "白牡丹仙",
    "白莲花仙",
    "樱花仙",
    "狗尾巴花仙",
    "红梅花花仙",
    "风信子花仙",
    "黑郁金香花仙",
    "康乃馨花仙",
    "满天星花仙",
    "夜来香花仙",
    "桃花花仙",
    "梨花花仙",
    "紫荆花花仙",
    "石竹花仙",
    "杏花花仙",
    "紫丁香花仙",
    "芙蓉花仙",
    "蔷薇花仙",
    "秋海棠花仙",
    "石榴花花仙",
    "紫藤花仙",
    "情花仙",
    "黄牡丹花仙",
    "灰狐狸",
    "火百合花仙",
    "紫兰花仙",
});

void create()
{        
    ::create();

    set_temp("apply/armor", 100000);
    set_temp("apply/defense", 100000);
    set_temp("apply/dodge", 100000);

    carry_object("/d/obj/cloth/tianyi.lpc")->wear();
    carry_object("/d/quest/dajiu/pifeng.lpc")->wear();
    carry_object("/d/ourhome/obj/shoes.lpc")->wear();
}

void generate_me(object who, int level, int period)
{
    ::generate_me(who, level * 10, 100, "月宫", 0, 100, names[random(sizeof(names))] + (random(2) ? "女" : "妃"), ({"hua xian"}), 1);
    ::set_period(period);

    set("gender", "女性");
    set("attitude", "friendly");

    set_weight(30000);

    set("class", "xian");

    set("env/no_accept", 0);
}

string invocation(object who, int level)
{
    string where;

    set("dajiu/level", level);
    generate_me(who, level, 3);

    where = query("name");

    if ( 0 == RANDPLACE_D->random_place(this_object(), who, 10) )
    {
        destruct(this_object());
        return 0;
    }

    where += "在" + who->query_temp("guai/place");

    remove_call_out("_leave");
    call_out("_leave", 300);

    return where;
}

void init()
{
    object me = this_object();
    object who = this_player();
    int type;

    ::init();

    if ( !living(me) )
    {
        return;
    }

    if ( !living(who) )
    {
        return;
    }

    add_action("do_no", ({"ji", "bian"}));
    add_action("do_block", "", 1);   
    add_action("do_baohu", "baohu");
    add_action("do_baohu", "dajiu");
    add_action("do_healup", "heal");
}

int do_healup()
{
    object who = this_player();
    object ob = this_object();

    if ( ob->query("kee") > (ob->query("max_kee") - 20) )
    {
        message_vision("$N说了声谢谢!\n$N气色不错。\n", ob);
        return 1;
    }

    if ( who->query("kee") < 300 || who->query("force") < 1000 )
    {
        tell_object(who, "你气色更差！\n");
        return 1;
    }

    who->add("force", -300);
    ob->add("kee", ob->query("max_kee") / 100);

    message_vision("$N受到了$n的真气灌入!\n$N的气色看起来好多了。\n", ob, who);

    return 1;
}
 
int do_no(string arg)
{
    object who = this_player();
    object me = this_object();

    message_vision("$N鬼鬼遂遂不知想干什么，$n警惕的盯着$N。\n", who, me);

    return 1;
}

int do_baohu()
{
    object me = this_player();
    object ob2 = this_object();
    object ob, killer1, killer2, killer3;
    string where, where1, where2;

    if ( me != owner() )
    {
        message_vision(CYN"$N对$n说道：你不是我等的那个人。哎。。。。\n"NOR, ob2, me);
        random_move();
        return 1;
    }

    if ( me->is_busy() )
    {
        return notify_fail("你正忙着呢。\n");
    }

    me->command("say 我来也，救人一命，胜造七级浮屠。");

    ob2->command("wield all");  

    if ( "asked" != me->query("job/dajiu/step") )
    {
        return 1;
    }

    killer1 = new(__DIR__"laoguai");
    killer1->invocation(me, ob2);

    killer2 = new(__DIR__"laoguai");
    killer2->invocation(me, ob2);

    killer3 = new(__DIR__"laoguai");
    killer3->invocation(me, ob2);

    me->set_temp("job/dajiu/killer1", killer1);
    me->set_temp("job/dajiu/killer2", killer2);
    me->set_temp("job/dajiu/killer3", killer3);

    ob2->set_temp("job/dajiu/killer1", killer1);
    ob2->set_temp("job/dajiu/killer2", killer2);
    ob2->set_temp("job/dajiu/killer3", killer3);

    me->delete("job/dajiu/killer");

    killer1->move(environment(ob2));
    message_vision ("\n" + killer1->query("name") + "突然跳了出来......\n", me);
    killer2->move(environment(ob2));
    message_vision ("\n" + killer2->query("name") + "突然跳了出来......\n", me);
    killer3->move(environment(ob2));
    message_vision ("\n" + killer3->query("name") + "突然跳了出来......\n", me);

    ob2->kill_ob(killer1);
    ob2->kill_ob(killer1);
    ob2->kill_ob(killer1);

    killer1->kill_ob(ob2);
    killer2->kill_ob(ob2);
    killer3->kill_ob(ob2);

    me->set("job/dajiu/step", "dajiued");

    return 1;
}

int accept_object(object who, object ob)
{
    object guai, me;
    string str;
    int level;
    int guailevel;
    mapping reward = ([]);
    int exp, dx, pot, money;

    guai = this_object();
    me = this_player();

    if ( me != owner() )
    {
        message_vision(CYN"$N对$n说道：你不是我等的那个人。\n"NOR, guai, me);
        return 0;
    }

    if ( "killed" != me->query("job/dajiu/step"))
    { 
        message_vision(CYN"$N对$n说道：我还没脱险，别磨磨蹭蹭，动作快点。\n"NOR, guai, me);
        return 0;
    }

    if ( ob->name() != "水晶鞋" || ob->query("id") != "shuijing xie" )
    {
        message_vision(CYN"$N对$n说道：这是什么玩意儿，快带我回家。\n"NOR, guai, me);
        return 0;
    }

    me->add("count/dajiu", 1);
    me->delete_temp("protect/prevent_die");

    level = me->query("level");
    guailevel = guai->query("dajiu/level");

    reward["combat_exp"] = LEVEL_D->query_level_jobreward_exp(level) + LEVEL_D->query_level_jobreward_exp(level) / 100 * (guailevel - 1);
    reward["daoxing"] = LEVEL_D->query_level_jobreward_dx(level) + LEVEL_D->query_level_jobreward_dx(level) / 100 * (guailevel - 1);
    reward["potential"] = LEVEL_D->query_level_jobreward_qn(level) + LEVEL_D->query_level_jobreward_qn(level) / 100 * (guailevel - 1);
    reward["gold"] = guailevel * 50;
    reward["job"] = "dajiu";

    reward = GIFT_D->gift_bonus(me, reward);

    exp = (int)reward["combat_exp"];
    dx = (int)reward["daoxing"];
    pot = (int)reward["potential"];
    money = (int)reward["gold"];

    str = "" + chinese_number(exp) + "点武学、" + COMBAT_D->chinese_daoxing(dx) + "道行、" 
        + chinese_number(pot) + "点潜能、" + chinese_number(money) + "两黄金";

    tell_object (me, "\n你赢得了" + str + "的奖励！\n");

    guai->command("kiss6 " + me->query("id"));

    message_vision(CYN"$N对$n道了万福说道：谢谢你搭救了我！。\n"NOR, guai, me);
    message_vision(CYN"$N对$n说完，穿上水晶鞋蹭了蹭，消失了！。\n"NOR, guai, me);

    me->set("job/dajiu/step", "done");

    call_out("destruct_ob", 1, ob);

    message("channel:rumor", HIG"【太乙救苦天尊】：" + me->name() + HIG"搭救" + query("name") + "成功，赢得了" + str + "！\n"NOR, users());

    MONITOR_D->report_job_msg(me->name(1) + "(" + me->query("id") + ")搭救" + query("name") + "成功，赢得了" + str + "！\n");

    return 1;
}

void destruct_ob(object ob)
{
    object guai;

    guai = this_object();

    if ( ob )
    {
        destruct(ob);
    }

    destruct(guai);
}

void die ()
{
    object ob = owner();
    object me = this_object();

    if ( ob )
    {
        ob->delete_temp("protect/prevent_die");
        message_vision(CYN"$N对$n说道：你武功太烂了，害死我，你。。。。这个。。天。杀的。。，$N气绝身亡了。\n"NOR, me, ob);

        ob->set("job/dajiu/fail", 1);
        ob->set("job/dajiu/start", time());
    }

    leave();
}

void unconcious()
{
    die();
}

void _leave()
{
    object me = this_object();

    remove_call_out("_leave");

    if ( me && me->is_fighting() )
    {
        call_out("_leave", 300);
        return;
    }

    leave();
}

void leave()
{
    object ob;

    if ( this_object() )
    {
        if(environment())
        {
            message("vision", HIB + name() + "化为地上的一朵鲜花。\n" NOR, environment());
        }

        if ( owner() )
        {
            owner()->delete_temp("protect/prevent_die");
        }

        if ( ob = this_object()->query_temp("job/dajiu/killer1") )
        {
            ob->leave();
        }
        if ( ob = this_object()->query_temp("job/dajiu/killer2") )
        {
            ob->leave();
        }
        if ( ob = this_object()->query_temp("job/dajiu/killer3") )
        {
            ob->leave();
        }

        destruct(this_object());
    }

    return;
}

int do_block(string arg)
{
    object me = this_object();
    object who = this_player();
    string verb = query_verb();
    int t;

    if ( !userp(who) || who != owner() )
    {
        return 0;
    }

    if ( verb != "go" && verb!="fly" && !(environment() && environment()->query("exits/" + verb)) )
    {
        return 0;
    }

    t = random(2);

    if ( t == 1 )
    {
        message_vision("$n不管$N死活，撒手跑了。\n", me, who);
        return 0;
    }

    message_vision("$N一伸手拦在$n面前，高声叫道：\n" + " 死妖怪，还不来救我，我要死了。\n\n", me, who);
    tell_object(who, me->name() + "一把拦住了你！\n");
    return 1;
}

