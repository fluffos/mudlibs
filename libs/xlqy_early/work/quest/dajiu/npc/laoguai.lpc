inherit NEWNPC;
 
#include <ansi.h>

void _leave(); 
void leave(); 

string *names = ({ 
    "狐狸", 
    "黑熊", 
    "狗熊", 
    "白熊", 
    "蝎子", 
    "蜈蚣", 
    "花豹", 
    "斑马", 
    "黑狮", 
    "黄狮", 
    "豺狼", 
    "老虎", 
    "狮子", 
    "黄狮", 
    "白狮", 
    "花豹", 
    "山豹", 
    "草豹", 
    "大雕", 
    "马猴", 
    "猕猴", 
    "猿猴", 
    "灰狼", 
    "野猪", 
    "马鹿", 
    "白鹿", 
    "灰鹿", 
    "黑鹿", 
    "花狐狸", 
    "白狐狸", 
    "灰狐狸", 
    "猩猩", 
    "狒狒", 
    "水牛", 
    "牦牛", 
    "野牛", 
    "白鼠", 
    "灰鼠", 
    "黑蚂蚁", 
    "蚂蚁", 
    "白蚁", 
}); 

void create() 
{
    ::create();
} 

void generate_me(object who, object huaxian, int period)
{
    set("dajiu/level", huaxian->query("dajiu/level"));

    ::generate_me(who, huaxian->query("dajiu/level") * 2, 100, FAMILY_D->random_class(), 0, 
        huaxian->query("dajiu/level") * 3, names[random(sizeof(names))] + (random(2) ? "老精" : "老怪"), ({"lao guai", "guai"}), 1);
    ::set_period(period);

    set_weight(30000);
    set("dajiu/huaxian", huaxian);

    call_out("_leave", 600);
}

void invocation(object who, object huaxian) 
{
    generate_me(who, huaxian, 3);
}

void init() 
{ 
    ::init(); 

    add_action("do_no", ({"fight", "kill", "steal", "cast", "ji", "throw", "perform"}) ); 
}

int do_no(string arg)
{
    object who = this_player(); 
    object me = this_object(); 

    if ( who != owner() && who->query_temp("invoker") != owner() && who != query("dajiu/huaxian") && who->query("id") != query("id") )
    {
        message_vision(CYN"$N对$n说道：你不怕死就滚！。\n"NOR, me, who);
        return 1;
    }

    if ( who == owner() && !me->is_fighting(who) )
    {
        me->kill_ob(who);
    }

    return 0;
} 

void heart_beat() 
{
    object guai = this_object();
    object huaxian;
    object env;

    if ( !owner() || owner()->query("job/dajiu/fail")
        || !(huaxian = query("dajiu/huaxian")) || !(env = environment(huaxian)) )
    {
        _leave();
        return;
    }

    if ( environment(guai) != env )
    {
        move(env);
    }

    ::heart_beat();   
}        
 
void unconcious() 
{ 
    die(); 
} 

void die() 
{
    object killer = query_temp("last_damage_from");
    object me = owner();

    if ( killer == me || killer == query("dajiu/huaxian") )
    {
        me->add("job/dajiu/killer", 1);

        if ( (int)me->query("job/dajiu/killer") >= 3 )
        { 
            me->set("job/dajiu/step", "killed");
        }

        this_object()->set("is_diablo_npc", 1);
        this_object()->set("magic_find", 1 + 20 * (1 + this_object()->query("dajiu/level")));
        DIABLO_D->diablo_drop(this_object(), killer);
    }

    message_vision (CYN"\n$N喊:  兄弟，我们完了......\n"NOR, this_object());

    leave();
} 

void _leave()
{
    object me = this_object();

    remove_call_out("_leave");

    if ( me && me->is_fighting() )
    {
        call_out("_leave", 300);
        return;
    }

    leave();
} 

void leave() 
{
    if ( this_object() )
    {
        if ( environment() )
        {
            message("vision",HIB + name() + "身子一晃，变成一股青烟散去了。\n" NOR, environment());
        }
        destruct(this_object());
    }

    return;
}

