#include <condition.h>
#include <ansi.h>

int update_condition(object me, int duration)
{
    object attacker;

    if ( !me->is_fighting()
        || !living(me)
        || duration <= 1 )
    {
        message_vision(HIG"\n$N感觉自己又可以随意活动了！\n"NOR, me);
        me->delete_temp("no_move");
        return 0;
    }

    me->apply_hb_condition("nomove", duration - 1);

    return CND_CONTINUE;
}

void clear_condition(object me, int duration)
{
    me->delete_temp("no_move");
}

