// 失魂状态无法出招、无法移动、无法打坐疗伤。有稳固魂魄能力者概率免疫
//这个设定只有方寸、普陀有能力做到免疫，其心法根基最深
//另外，将军府有兵阵情况下可以免疫，没有则不能 武圣有武道意志情况下可以免疫
//以及一些特殊法宝
//蜀山剑法有特殊的技能破除这种状态
/*
建议把失魂状态和月宫的迷魂都弄成一个伤害类型：魂伤
合并考虑魂伤状态效果：无法出招、无法移动、无法打坐疗伤等
这是基本的效果
是否设定有额外的神伤害，就看你的设计
比如勾魂术有额外的神伤，迷魂可能就没有
魂伤我这样设计，属于单独考虑的属性
发出一个魂伤类法术，首先计算成功率，这是技能本身的成功率
成功后，根据魂伤免疫苏醒，决定其受到的神伤害，以及受到的特效影响
另外把妖法的特效也设定为半失魂状态，效果只有原版一般
免疫加权10仅受伤害，不产生魂伤状态效果。加权0产生魂伤状态效果，加权5受到一半魂伤状态效果
*/

#include <condition.h>
#include <ansi.h>

int update_condition(object me, int duration) {
  object attacker;
  int effect;

  if (!(attacker = me->query("outmind_ob"))
    || !me->is_fighting(attacker)
    || environment(me) != environment(attacker)
    || !living(attacker) || !living(me)
    || duration <= 0) {
    message_vision(HIB "$N一个激灵，终于回过神来。\n" NOR, me);
    return 0;
  }

  if (0 >= SPELL_D->attacking_cast_success(attacker, me, 180)) {
    me->apply_condition("outmind", duration - 1);
    return CND_CONTINUE;
  }

  switch (random(5)) {
    case 0:
      effect = 400 + random(200);
      me->receive_wound("sen", effect);
      message_vision(HIR "$N觉得四肢麻木，身体中的" + effect + "点元神正一点点的流失。\n" NOR, me);
      break;

    case 1:
      effect = 1 + random(3);
      COMBAT_D->start_fengmo(me, effect);
      message_vision(HIB "$N只觉得全身气血翻涌，" + effect + "秒内无法再运用外功。\n" NOR, me);
      break;

    case 2:
      effect = 1 + random(3);
      COMBAT_D->start_jinzhou(me, effect);
      message_vision(HIY "$N只觉得全身气血翻涌，" + effect + "秒内无法再运用法力。\n" NOR, me);
      break;

    case 3:
      effect = 1 + random(3);
      COMBAT_D->start_biqi(me, effect);
      message_vision(HIG "$N只觉得全身气血翻涌，" + effect + "秒内无法再运用内力。\n" NOR, me);
      break;

    default:
      if (!me->is_busy()) {
        effect = 1 + random(3);
        me->start_busy(effect);
        message_vision(HIW "$N觉得四肢麻木，受到" + effect + "点忙乱。\n" NOR, me);
      }
      break;
  }

  if (duration <= 1) {
    message_vision(HIB "$N一个激灵，终于回过神来。\n" NOR, me);
    return 0;
  }

  me->apply_condition("outmind", duration - 1);

  return CND_CONTINUE;
}
