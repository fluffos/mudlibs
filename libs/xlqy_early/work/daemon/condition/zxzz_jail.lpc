#include <login.h>
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
   object where = environment(me);
   if(!where) return 0; 
   
   if( duration < 1 && where->query("short")=="天地玄境") 
   {
   	 if(me->query("origin_room"))
   	 {
   	 	 me->move(me->query("origin_room"));
   	 	 me->delete("origin_room");
   	 	 message("vision",me->name()+"从半空中飘然而降....\n",environment(me),me);
   	 }
   	 else
   	 {
   	 	 me->move("/d/ourhome/xiaoting");
   	 	 message("vision",me->name()+"从半空中飘然而降....\n",environment(me),me);
   	 }
   	 tell_object(me,"你终于从天地玄境中重新回到了世间。\n");
   	 
   	 if(me->query("start_room"))
   	 {
   	 	 me->set("startroom",me->query("start_room"));
   	 	 me->delete("start_room");
   	 	 me->save();
   	 }
   	 else
   	 {
   	 	 me->set("startroom","/d/ourhome/xiaoting");
   	 	 me->save();
   	 }
   	 return 0;
   }
   
   me->apply_condition("zxzz_jail",duration-1);
  
   return CND_CONTINUE;
}

