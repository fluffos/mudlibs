#include <ansi.h>

int update_condition(object me, int duration) {
  int damage, mu, effect;
  if (time() < me->query("dajiu_busy") && !living(me))  //dajiu
  {
    me->apply_condition("fearness_poison", duration);
    return 1;
  }
  damage = me->query("wuxing_poison/fearness_poison");
  if (damage < 50)
    damage = 50;
  mu = me->receive_damage("sen", damage / 5);
  me->receive_wound("sen", mu);
  mu = me->receive_damage("kee", damage / 5);
  me->receive_wound("kee", mu);
  if (me->query("force") > damage / 2)
    me->add("force", -damage / 2);
  else me->set("force", 0);
  if (me->query("mana") > damage / 2)
    me->add("mana", -damage / 2);
  else me->set("mana", 0);
  effect = 1 + random(7);
  me->add_temp("apply/courage", -effect);
  me->add_temp("wuxing_poison/fearness_point", effect);
  me->set_temp("death_msg", HIG "中五行毒之恐惧而毙。\n" NOR);
  me->apply_condition("fearness_poison", duration - 1);
  if (duration > 0)
    tell_object(me, HIG "你所受五行毒之恐惧发作了！\n" NOR);
  if (duration < 1) {
    me->delete_temp("wuxing_poison/fearness_point");
    me->delete("wuxing_poison/fearness_poison");
    return 0;
  }
  return 1;
}
