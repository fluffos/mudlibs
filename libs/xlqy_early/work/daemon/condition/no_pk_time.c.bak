#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{

        object env=environment(me);
	
	if(env) {
	    if(!env->query("no_fight") && !env->query("no_magic"))
	     {
	     	  me->apply_condition("no_pk_time", duration - 1);
	     	  if(random(2))
	     	  {
		     	  tell_object(me,"一阵阴风吹过，你隐约听到有人幽幽的喊到：还命来...还命来～～～\n");
		     	  me->set_temp("death_msg",RED"被冤魂索命，惊恐而毙。\n"NOR);
		     	  me->receive_wound("sen",144+me->query("sen")/12);
		     	   if(me->is_busy()) me->start_busy(me->query_busy()+random(3));
		     	  else me->start_busy(random(3));
	     	}
	     
	     }
	     else
	     {
	     	
	     	  tell_object(me,"一阵阴风吹过，你隐约听到有人幽幽的喊到：还命来...还命来～～～\n");
		   me->receive_wound("sen",144+me->query("sen")/8);
	     	  me->set_temp("death_msg",RED"被冤魂索命，惊恐而毙。\n"NOR);
	     }
	    // can't hide in safe room to count hours.
	}

//	write("PK:"+duration+":"+me->query_condition("no_pk_time")+"\n");

	if( duration < 1 ) return 0;

	return CND_CONTINUE;
}

// mon 8/1/98
// this condition can't be cleared.
int no_clear_condition() {return 1;}


