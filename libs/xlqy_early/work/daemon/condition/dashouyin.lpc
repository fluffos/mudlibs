#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  int damage, p;
  string msg;

  damage = me->query_condition("dashouyin") / 5 + 2;
  damage += me->query_con();

  tell_object(me, "突然你感觉胸口疼痛异常，刚才被如来神掌拍中的肋骨处好象要裂开了似的，鲜血也从口中喷了出来！\n");
  tell_room(
    environment(me),
    HIR + me->name() + "突然一言不发，双手捂胸，蹬蹬磴倒退了数步，接着哇得一声吐出口鲜血来！\n" NOR,
    ({ me })
  );

  me->receive_damage("kee", damage);
  me->receive_wound("kee", damage / 2);
  COMBAT_D->report_status(me, 1, me, "kee");

  me->set_temp("death_msg", "寒毒发作死了。\n");
  me->apply_condition("dashouyin", duration - 1);

  if (duration < 1) {
    return 0;
  }

  return CND_CONTINUE;
}
