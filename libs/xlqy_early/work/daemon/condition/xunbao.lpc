#include <condition.h>
#include <ansi.h>

int update_condition(object me, int duration)
{
    object attacker;

    if ( duration <= 1 )
    {
        me->delete_temp("xunbao");
        return 0;
    }

    me->apply_condition("xunbao", duration - 1);

    return CND_CONTINUE;
}

void clear_condition(object me, int duration)
{
    me->delete_temp("xunbao");
}

