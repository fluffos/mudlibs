//xiangsi.c
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  int damage_kee, damage_sen;
  object where = environment(me);
  if (duration < 1) return 0;
  if (time() < me->query("dajiu_busy") && !living(me))  //dajiu
  {
    me->apply_condition("xiangsi", duration);
    return 1;
  }
  if (!where) return 0;
  if (!living(me)) {
    message("vision", HIR "" + me->name() + "身中情毒，痛苦的按着胸口．\n" NOR, environment(me), me);
  } else {
    tell_object(me, HIR "情毒发作了。\n" NOR);
    message("vision", HIR "" + me->name() + "身中情毒，痛苦的按着胸口．\n" NOR, environment(me), me);
  }
  me->set_temp("death_msg", HIM "情毒发作而亡。\n" NOR);
  damage_kee = me->query("kee") / 10;
  damage_sen = me->query("sen") / 15;
  if (damage_kee < 1) damage_kee = 1;
  if (damage_sen < 1) damage_sen = 1;
  me->receive_wound("kee", damage_kee / 2 + random(damage_kee / 2));

  me->receive_wound("sen", damage_sen / 2 + random(damage_sen / 2));

  if (!me->is_busy()) me->start_busy(1);
  me->apply_condition("xiangsi", duration - 1);

  if (duration < 1) return 0;
  return CND_CONTINUE;
}
