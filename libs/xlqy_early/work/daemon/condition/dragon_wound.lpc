#include <ansi.h>
#include <condition.h>
#include "/daemon/skill/eff_msg.h";
int update_condition(object me, int duration)
{

      int damage, p;
object whoo;
      string msg;
      
if(time() < me->query("dajiu_busy")&&!living(me)) //dajiu
{
me->apply_condition("dragon_wound", duration);
return 1;
}
      damage = me->query_condition("dragon_wound");
      if(damage>0)
      {tell_object(me, "突然你感觉丹田一阵疼痛，内力好像凝滞了一般，鲜血也从口中喷了出来！\n");
      tell_object(me, "你中龙形搏击的内伤开始发作了!\n");
      tell_room(environment(me), HIR + me->name()+"突然一言不发，脸色惨白，稍顷哇得一声吐出口鲜血来！\n" NOR,({ me }));
if(objectp(whoo =me->query_temp("last_damage_from")))
{
 me->receive_damage("kee", damage,whoo);
 me->receive_wound("kee", damage/2);
}
else
{
      me->receive_damage("kee", damage);
      me->receive_wound("kee", damage/2);
}
      p = (int)me->query("kee")*100/(int)me->query("max_kee");
      msg = "( $N"+eff_status_msg(p)+" )\n";
      if(living(me)) 
             message_vision(msg, me);}
 
	  me->set_temp("death_msg","内伤发作死了。\n");
      me->apply_condition("dragon_wound", me->query_condition("dragon_wound")-1);
	  if( duration < 1 ) return 0;
   return 1;
}



