#include <condition.h>
#include <ansi.h>

int update_condition(object me, int duration) {
  object attacker;

  if (!me->is_fighting()
    || !living(me)
    || duration <= 1) {
    message_vision(HIG "\n$N感觉自己又回忆起那些绝技了！\n" NOR, me);
    me->delete_temp("fengmo");
    return 0;
  }

  me->apply_hb_condition("fengmo", duration - 1);

  return CND_CONTINUE;
}

void clear_condition(object me, int duration) {
  me->delete_temp("fengmo");
}
