// health.c 内敛乾坤
// Created by Vin 26/8/2001

#include <ansi.h>

inherit F_CLEAN_UP;

string name() { return WHT "内敛乾坤" NOR; }

int perform(object me, string skill)
{
	int count;
	
	if(me->query("age")<18)
		return notify_fail("你还未成年，不能使用特殊技能 ^_^\n");
	 if (me->query_temp("special_skill/health", 1))
                return notify_fail("你已经尽力激发自己的体力了。\n");
 	if(me->query_temp("init_max_kee"))
        	count =me->query_temp("init_max_kee")/2;
       else 
       	{
       			
       		me->set_temp("init_max_kee",me->query("max_kee"));
       		count =me->query_temp("init_max_kee")/2;
       			
       	}
	me->set("max_kee",me->query("max_kee")+count);
	me->set("eff_kee",me->query("eff_kee")+count);
	me->set("kee",me->query("kee")+count);
       
   	 message_vision(WHT "$N" WHT "凝神聚气，感应到大地传给自己的力量。\n" NOR, me);
        me->receive_damage("kee", 40 + random(40));
        me->set_temp("special_skill/health", 1);
       
   	me->start_call_out((: call_other, __FILE__, "remove_effect", me,
			      count :), 360 + random(30));

        return 1;
}

void remove_effect(object me, int count)
{
        me->delete_temp("special_skill/health", 1);

        me->set("max_kee",me->query("max_kee")-count);
	if(me->query("eff_kee")>count)                                             //modified by sky: 防止晕时remove_effect造成万家死亡
		me->set("eff_kee",me->query("eff_kee")-count);
	else
		me->set("eff_kee",10);
	if(me->query("kee")>count)
		me->set("kee",me->query("kee")-count);
	else
		me->set("kee",10);
	
        tell_object(me, "大地赐予你的力量已经失去，你全身松懈下来，。\n");
}
