#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage, damage_sen, damage_kee, wounded;
  mixed ap, dp;

  if (!target) {
    return notify_fail("你要对谁施展这一招？\n");
  }

  limit_status["force"] = 25 + (int)me->query("force_factor");
  limit_status["kee"] = 500;

  limit_skills["baihua-zhang"] = 80;

  if (!can_perform(me)) {
    return 0;
  }

  me->add("force", -25 - (int)me->query("force_factor"));
  me->receive_damage("kee", 100);
  msg = HIC
    "\n$N微微一笑，身子凌空而起，洒下漫天花雨，一时花香缭绕\n" +
    "$n只觉周身都被花影罩住了，一时竟然不知如何招架，更不用说躲闪了！\n" NOR;

  ap = COMBAT_D->combat_power(me, target, "unarmed", SKILL_USAGE_ATTACK);
  dp = COMBAT_D->combat_power(me, target, "parry", SKILL_USAGE_DEFENSE);

  if (0 >= COMBAT_D->perform_hit(ap, dp)) {
    msg += HIC "谁知$n竟险中求胜，长袖一摆，已将所有花瓣打落！\n\n" NOR;
    message_perform(msg, me, target);
  } else {
    damage = COMBAT_D->get_mydamage_direct(me, target, "unarmed", TYPE_PERFORM);
    damage += me->query("force_factor") - target->query("force_factor");

    damage_sen = damage + random(damage * 2);
    damage_kee = damage_sen + random(damage_sen / 2);

    msg += HIM "这些花瓣看似柔弱无力，却如疾风骤雨般射向$n，" + HIW + chinese_number(damage_sen) + HIM + "片花瓣深深的嵌入肉里！\n" NOR;

    target->receive_damage("sen", damage_sen, me);
    target->receive_damage("kee", damage_kee, me);

    wounded = 0;
    damage = me->query("force_factor");
    if (damage / 2 + random(damage / 2) > random(target->query("force_factor"))) {
      wounded = 1;
      target->receive_wound("sen", damage_sen / 2, me);
      target->receive_wound("kee", damage_kee / 2, me);
    }

    me->improve_skill("baihua-zhang", 1, 1);

    message_perform(msg, me, target);

    COMBAT_D->report_status(target, wounded, me, "kee");
    COMBAT_D->report_status(target, wounded, me, "sen");
  }

  become_enemy(me, target);

  return 3 + random(2);
}

string skill_name(object me, object target, string skill) {
  return "天女散花";
}

string query_desc(object me, object target) {
  return target->name() + HIM "被" NOR + me->name() + HIM "用广寒宫秘传" NOR + HIC "「天女散花」" + HIM "打死了，据说尸体上竟然嵌入无数花瓣！\n" NOR;
}
