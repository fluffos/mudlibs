#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage;
  mixed ap, dp;
  int extra;
  object weapon;

  if (!target) {
    return notify_fail("你要对谁施展这一招？\n");
  }

  limit_status["force"] = 1000;
  limit_status["kee"] = 500;

  limit_skills["baihua-zhang"] = 75;
  limit_skills["moonforce"] = 150;
  limit_skills["moondance"] = 150;
  limit_skills["snowsword"] = 150;

  if (!can_perform(me)) {
    return 0;
  }

  extra = me->query_skill("baihua-zhang", 1) * 2;

  me->add_temp("apply/attack", extra / 10);
  weapon = me->query_temp("weapon");

  msg = HIR "$N使出百花掌中的不传绝技［飞扬四季］，一招连环四式向$n攻出！\n" NOR;
  msg += HIG "\n~~~ 百花迎春 ~~~~ ！" NOR;
  msg += HIG "$N双掌翻飞, 宛如片片花瓣,夹杂着绵绵的劲力,层层拍向$n！\n" NOR;
  message_perform(msg, me, target);

  COMBAT_D->perform_attack(me, target, weapon);

  ap = COMBAT_D->exp_power(me, target, SKILL_USAGE_ATTACK);
  ap = COMBAT_D->power_mul(ap, 3);
  ap = COMBAT_D->power_random(ap);
  dp = COMBAT_D->exp_power(me, target, SKILL_USAGE_DEFENSE);

  msg = HIG "伴随着片片飞花,$n的眼前出现了翠绿的春季景色..." NOR;
  if (0 < COMBAT_D->perform_hit(ap, dp)) {
    msg += HIB "\n$n被掌法产生的幻象所迷惑,显得目光呆滞...,伴随着啊的一声惨叫, 一股蓝气从$n顶门喷涌而出！\n" NOR;

    target->receive_wound("sen", extra, me);
    COMBAT_D->report_status(target, 1, me, "sen");
    me->receive_heal("sen", extra);
  } else {
    msg += HIB "\n$n似乎看透了这一切,闭目调息,不为情形所迷惑...\n" NOR;
  }
  message_perform(msg, me, target);

  msg = HIC "\n~~~ 仲夏晚风 ~~~~ ！" NOR;
  msg += HIC "$N变探出一掌, 划出一道美丽的弧线, 恰似柔柔微风, 击向$n！\n" NOR;
  message_perform(msg, me, target);

  COMBAT_D->perform_attack(me, target, weapon);

  msg = HIG "伴随着柔柔的微风,$n的眼前出现了斑斓的夏季景色..." NOR;
  if (0 < COMBAT_D->perform_hit(ap, dp)) {
    msg += HIR "\n$n被掌法产生的幻象所迷惑,显得两眼迷茫...， 伴随着重重的一声闷哼，一股血气从顶门喷涌而出！\n" NOR;

    target->receive_wound("kee", extra, me);
    COMBAT_D->report_status(target, 1, me, "kee");
    me->receive_heal("kee", extra);
  } else {
    msg += HIB "\n$n似乎看透了这一切,转过脸去,不为情形所迷惑...\n" NOR;
  }
  message_perform(msg, me, target);

  msg = HIY "\n~~~ 深秋雾幻 ~~~~ ！" NOR;
  msg += HIY "$N腾空跃起, 身行变幻不定, 道道掌影, 无懈可击的击向$n！\n" NOR;
  message_perform(msg, me, target);

  COMBAT_D->perform_attack(me, target, weapon);

  msg = HIG "伴随着不定的雾岚,$n的眼前出现了金黄的秋季景色..." NOR;
  if (0 < COMBAT_D->perform_hit(ap, dp)) {
    msg += HIC "\n$n被掌法产生的幻象所迷惑,显得心神涣散....，伴随着野兽般的长啸， 一股青气从$n顶门喷涌而出！\n" NOR;

    target->receive_wound("sen", extra, me);
    COMBAT_D->report_status(target, 1, me, "sen");
    me->receive_heal("sen", extra);
  } else {
    msg += HIB "\n$N似乎看透了这一切,屏气凝神,不为情形所迷惑...\n" NOR;
  }
  message_perform(msg, me, target);

  msg = HIW "\n~~~ 飘雪寒冬 ~~~~ ！" NOR;
  msg += HIW "$N气运丹田, 双掌推出,无穷霸气化做片片飞雪,将$n罩在无尽内力中！\n" NOR;
  message_perform(msg, me, target);

  COMBAT_D->perform_attack(me, target, weapon);

  msg = HIG "伴随着纷飞的雪花,$n的眼前出现了苍茫的冬季景色..." NOR;
  if (0 < COMBAT_D->perform_hit(ap, dp)) {
    msg += MAG "\n$n被掌法产生的幻象所迷惑,显得浑身发抖....，伴随牙齿碰撞的声音，一股紫气从$n顶门喷涌而出！\n" NOR;

    target->receive_wound("kee", extra, me);
    COMBAT_D->report_status(target, 1, me, "kee");
    me->receive_heal("kee", extra);
  } else {
    msg += HIB "\n$n似乎看透了这一切,驻念于心,不为情形所迷惑...\n" NOR;
  }
  message_perform(msg, me, target);

  me->add("force", -300);
  me->add_temp("apply/attack", -extra / 10);

  return 5;
}

string skill_name(object me, object target, string skill) {
  return "飞扬四季";
}

string query_desc(object me, object target) {
  return me->name() + HIM "竟然使出百花掌绝学" NOR + HIC "「飞扬四季」" + HIM "，据说" + target->name() + "一直沉浸在无边美景当中，无法自拔！\n" NOR;
}
