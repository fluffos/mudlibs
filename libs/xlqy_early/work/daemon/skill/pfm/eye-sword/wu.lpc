#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon;
  int count;
  int lvl;
  int i;

  if (!wizardp(me) && me->query_family()) {
    return notify_fail("修仙之人，还用这种凡人剑法？\n");
  }

  if (!target || !me->is_fighting(target)) {
    return notify_fail("群魔乱舞只能对战斗中的对手使用。\n");
  }

  if (objectp(weapon = me->query_temp("weapon")) &&
    (string)weapon->query("skill_type") != "sword") {
    return notify_fail("你没有装备剑，不能用这一招。\n");
  }

  if (me->query_skill_mapped("force") != "changchun-gong") {
    return notify_fail("你并没有使用长春功，无法使用此绝招！\n");
  }

  if ((int)me->query("force") < 300) {
    return notify_fail("你的真气不够，无法施展群魔乱舞！\n");
  }

  if ((lvl = (int)me->query_skill("eye-sword", 1)) < 100) {
    return notify_fail("你的眨眼剑法火候不够，无法施展群魔乱舞！\n");
  }

  msg = HIR "$N" HIR "一声长吟，身形变得奇快无比，接连向$n"
    HIR "攻出数招！\n" NOR;

  i = 3;
  if (lvl / 2 + random(lvl) > (int)target->query_skill("parry") || !living(target)) {
    msg += HIR "$n" HIR "只觉得眼前一花，发现四周都是$N"
      HIR "的身影，不由暗生惧意，接连后退。\n" NOR;
    count = (lvl + (int)me->query_skill("force", 1)) / 2;
    me->add_temp("apply/attack", count);
    i += random(3);
  } else {
    msg += CYN "$n" CYN "见$N" CYN "身法好快，哪里"
      "敢怠慢，连忙打起精神小心应对。\n" NOR;
    count = 0;
  }

  message_combatd(msg, me, target, "");

  me->add("force", -i * 20);

  while (i--) {
    if (!me->is_fighting(target)) {
      break;
    }

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM);
  }

  me->add_temp("apply/attack", -count);

  return 1 + random(2);
}

string skill_name(object me, object target, string skill) {
  return "群魔乱舞";
}

string query_desc(object me, object target) {
  return target->name() + HIM "被" + me->name() + HIM "用七玄门绝技「群魔乱舞」杀死了，体无完肤！\n" NOR;
}
