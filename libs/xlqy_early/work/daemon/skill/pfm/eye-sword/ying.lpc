#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  object weapon;
  string name;
  int count;
  int lvl;
  int i;

  if (!wizardp(me) && me->query_family()) {
    return notify_fail("修仙之人，还用这种凡人剑法？\n");
  }

  if (!target || !me->is_fighting(target)) {
    return notify_fail("鬼影只能对战斗中的对手使用。\n");
  }

  if (objectp(weapon = me->query_temp("weapon")) &&
    (string)weapon->query("skill_type") != "sword") {
    return notify_fail("你没有装备剑，不能用这一招。\n");
  }

  if (me->query_skill_mapped("force") != "changchun-gong") {
    return notify_fail("你并没有使用长春功，无法使用此绝招！\n");
  }

  if ((int)me->query("force") < 100) {
    return notify_fail("你的真气不够，无法施展鬼影！\n");
  }

  if ((lvl = (int)me->query_skill("eye-sword", 1)) < 100) {
    return notify_fail("你的眨眼剑法火候不够，无法施展鬼影！\n");
  }

  if (weapon) {
    name = weapon->name();
  } else {
    name = "真气";
  }

  msg = HIR "\n$N" HIR "冷笑一声，如鬼魅般飘向$n，身法快得不可思议!"
    HIR "手中的" + name + HIR "或点，或刺，或劈，\n刹时间已向$n周身上下连攻数剑!\n\n"
    HIC "$n根本无法看清剑招的来路，当下方寸大乱" HIC "!\n" NOR;

  message_combatd(msg, me, target, "");

  count = me->query_skill("eye-sword", 1);

  me->add_temp("apply/attack", count);

  for (i = 0; i < 5; i++) {
    if (!me->is_fighting(target)) {
      break;
    }

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_PERFORM);
  }

  me->add_temp("apply/attack", -count);

  return 1 + random(2);
}

string skill_name(object me, object target, string skill) {
  return "鬼影";
}

string query_desc(object me, object target) {
  return target->name() + HIM "被" + me->name() + HIM "用七玄门绝技「鬼影」杀死了，体无完肤！\n" NOR;
}
