// 作者： tonii@ 缥缈水云间, 2003-4-22于浙大，修改请保留此行。
//【天雷猛袭剑】之【慌雨斩】
//同时伤对方气血和精神

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
 int ap,dp,dp2;
int l;
int lv1;
string msg;
 int i,damage;
 int time,time1,time2;
 object weapon;
 
 if( !target ) target = offensive_target(me);
 if( !target
 || !target->is_character()
 || !me->is_fighting(target) )
    return notify_fail("独孤九剑只能对战斗中的对手使用。\n");

 time1 =(int)me->query_skill("NO.1_skill",1) / 5;
 if (time1>15) time1=15;
 time2=random(3);
 time=time1+time2;
 ap=me->query_skill("sword");
 ap=ap*ap*ap/1200;
 ap+=(int)me->query("combat_exp")/100;
ap=ap/10;
 dp=(int)target->query_skill("dodge")/2+(int)target->query_skill("parry")/2;
 dp=dp*dp*dp/1200;
 dp+=(int)target->query("combat_exp")/100;
 dp2=target->query_cps();
 dp2=dp2*dp2*dp2/10;
 dp+=dp2;
dp=dp/10;

 for(i=0;i<time;i++)
 {
  //每剑的命中率大约为2/5左右
 message_vision(HIG"运起独孤九剑，剑芒暴涨，剑气四溢，让人喘不过气来！\n"NOR, me, target);
 if(random(ap+dp)>3)
 {
    message_vision(HIW"$n只见漫天剑雨扑面而来，完全不知如何招架！\n"NOR, me, target);

    damage=50+(int)random(me->query_skill("NO.1_skill",1)*50);
//    damage=damage*8/10;
    target->receive_damage("kee",damage,me,"phy");
    target->receive_wound("kee",random(damage),me);
    target->receive_damage("sen",damage,me,"phy");
    target->receive_wound("sen",random(damage),me);
    COMBAT_D->report_status(target, 0);
    COMBAT_D->report_sen_status(target);
 }
 else 
    message_vision(HIY"$n奋不顾身，反向剑锋迎了过去，居然将其化解。\n"NOR, me, target);
 }
  msg = HIR"$N忽感神灵之佑护，丹田之气直冲脑门，$n在撼人的剑雨中忽然目瞪口呆，\n"NOR;
  msg+= HIY"$N得势不饶人，鬼魅般飘到了$n身后，撑起一脚直抵$n后心，\n"NOR;
  msg+= HIW"$n还没有回过神来，已经被摔了个狗吃屎，呆坐在了地上\n"NOR;
  message_vision(msg, me, target);
  target->start_busy(3+random(2));
if( !target->is_fighting(me) ) {
  if( living(target) ) {
     if( userp(target) ) target->fight_ob(me);
      else target->kill_ob(me);
  }
}
 me->add("force",-200);
me->add("mana",-100);

return 0;
}

