
// by jame @ 秋千雅阁, 2005-8-25
// 风云九剑

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me,object target)
{
        string msg;
        string str;
        string level;
        int delay,mysword,damage,exp_target,exp_mine;
        object weapon,ob; 

        mysword=(int)me->query_skill("NO.1_skill",1);
        exp_mine      = (int)me->query("combat_exp");
        exp_target    = (int)target->query("combat_exp");
        msg           =  "";

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［风云九剑］只能对战斗中的对手使用。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一柄剑才行。\n");

        if(!wizardp(me))
                return notify_fail(HIR"「风云九剑」"+NOR"只有巫师才能使用！\n");

        if(mysword<100)
                return notify_fail("你的第一神功修为不够深，无法使用[风云九剑]。\n");

        if((int)me->query("force")<500)
                return notify_fail("你的内力不够. \n");

        me->add("force",-500);
        me->recieve_damage("kee",2);
        message_vision(HIC"$N轻轻一笑，左臂伸出，左右连划了九个圆圈!!\n$N默用"NOR+HIR"第一神功"NOR+HIB",虚而又实，使出了"NOR+HIY""+BLINK"「风云九剑」"NOR+HIW"！！\n"NOR,me,target);

        message_vision(MAG"$N运剑如风，剑光霍霍中反攻$n的$l，尝试逼$n自守，剑招似是"+NOR+HIG""+BLINK"「伏魔剑」"NOR+HIC"的「龙吞式」。\n" NOR,me,target);
                if(exp_mine>(int)(exp_target/1000)) 
        {
                damage= exp_mine/exp_target*100+random(100);
                if(damage<120)damage = 120;
                if(damage>300)damage = 300;
                target->receive_damage("kee", me->query("eff_kee")*damage/80 , me);
                target->receive_wound ("kee" ,me->query("eff_sen")*damage/100, me);
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        }
                else 
                {
        msg = HIC"$n看准来势，轻轻一跳，躲了开去。\n\n"NOR;
        message_vision(msg, me, target);
        }
        message_vision(HIC"$N剑随身转，续而刺出十九剑，竟然是华山"+NOR+HIG""+BLINK"「玉女十九剑」"NOR+HIC"，但奇的是这十九剑便如一招，手法之快，直是匪夷所思。\n"NOR,me,target);
                if(exp_mine>(int)(exp_target/1000)) 
        {
                damage= exp_mine/exp_target*100+random(100);
                if(damage<130)damage = 130;
                if(damage>300)damage = 300;
                target->receive_damage("kee", me->query("eff_kee")*damage/80 , me);
                target->receive_wound ("kee" ,me->query("eff_sen")*damage/100, me);
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        }
                else 
                {
        msg = HIC"$n却心静如水，丝毫不显慌乱，见招拆招，瓦解了$N这无声的攻势。\n\n"NOR;
        message_vision(msg, me, target);
                }


        message_vision(HIY"$N突然使出青城派松风剑法的「鸿飞冥冥」，可是方位却有所偏差，$w对着$n一绞，企图突破$n的攻势！ \n" NOR,me,target);
                if(exp_mine>(int)(exp_target/1000)) 
        {
                damage= exp_mine/exp_target*100+random(100);
                if(damage<140)damage = 140;
                if(damage>300)damage = 300;
                target->receive_damage("kee", me->query("eff_kee")*damage/80 , me);
                target->receive_wound ("kee" ,me->query("eff_sen")*damage/100, me);
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        }
                else 
                {
        msg = HIC"$n似乎看透了这招，不退反进，化解了这招。\n\n"NOR;
        message_vision(msg, me, target);
                }

        level = me->query("skill_level/sword");
        if(level="grandmaster")
        me->start_busy(0);
        else if(level="master")
        me->start_busy(random(2));
        else if(level="expert")
        me->start_busy(random(4));
        else
        me->start_busy(2+random(2));
                return 1;

}
