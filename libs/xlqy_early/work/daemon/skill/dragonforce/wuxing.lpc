// neilisuck.c

#include <ansi.h>

inherit SSERVER;
int exert(object me, object target) {
  int sp, dp;

  if (target == me)
    target = offensive_target(me);

  if (environment(me)->query("no_fight"))
    return notify_fail("这里不能攻击别人! \n");

  if (!objectp(target))
    return notify_fail("你要对谁用？\n");

  if (me->query_temp("sucked"))
    return notify_fail("你刚刚用过！\n");

  if ((int)me->query_skill("dragonforce", 1) < 50)
    return notify_fail("你的龙神心法功力不够，不能使用似水无形！\n");



  if ((int)me->query("force", 1) < 100)
    return notify_fail("你的内力不够，不能使用龙神心法。\n");

  if ((int)me->query("force") > 2 * (int)me->query("max_force"))
    return notify_fail("你的内力已太多，不能吸取了。\n");

  if ((int)target->query("max_force") <= 0)
    return notify_fail(target->name() + "没有任何内力！\n");

  if ((int)target->query("force") < 60)
    return notify_fail(target->name() +
      "已经内力涣散，你已经无法从他体内吸取任何内力了！\n");

  message_vision(
    HIM "$N一声大喝，右掌直出，拍向$n！\n\n" NOR,
    me, target);

  if (living(target)) {
    if (!target->is_killing(me->query("id")))
      target->kill_ob(me);
  }

  sp = me->query_skill("force") + me->query_skill("dodge") + me->query_skill("unarmed", 1) / 2;
  dp = target->query_skill("force") + target->query_skill("dodge") + target->query_skill(
    "parry",
    1
  ) / 3;

  me->set_temp("sucked", 1);

  if ((random(sp) > random(dp / 2))) {
    tell_object(target, HIR "你顿时觉得好像身陷无形的流水中一般,受到一股极大的漩力,内力源源而出！\n" NOR);
    tell_object(me, HIG "你觉得" + target->name() + "的内力自手掌源源不绝地流了进来。\n" NOR);

    target->add(
      "force",
      -1 * ((int)me->query_skill("force") + target->query("force_factor", 1) * 2)
    );
    if (target->query("force") < 1)
      target->set("force", 0);
    me->add("force", (int)me->query_skill("force") + target->query("force_factor", 1) * 2);

    me->start_busy(1 + random(3));
    target->start_busy(1);

    call_out("del_sucked", 4 + random(4), me);
  } else {
    message_vision(HIY "可是$p看破了$P的企图，机灵地闪了开去。\n" NOR, me, target);
    me->start_busy(2);
    call_out("del_sucked", 7, me);
  }

  return 1;
}

void del_sucked(object me) {

  if (me && me->query_temp("sucked"))
    me->delete_temp("sucked");
}
