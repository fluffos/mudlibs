inherit NEWSKILL;

int query_npc_ignore() {
  return 1;
}

string type() {
  return "martial";
}

int valid_enable(string usage) {
  return usage == "makeup";
}

string cannot_improve(object me) {
  if (me->query_skill("lunar", 1) >= me->query_skill("makeup", 1)) {
    return "你的驻颜术太过稀松平常了吧。\n";
  }

  return 0;
}
