// leadership.c

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

string level_description(int level) {
  int grade;
  string *level_desc = ({
    BLU "初出茅庐" NOR,
    BLU "默默无闻" NOR,
    HIB "小有名气" NOR,
    HIB "左右逢源" NOR,
    YEL "一鸣惊人" NOR,
    YEL "家喻户晓" NOR,
    HIY "声名远播" NOR,
    HIY "名动四方" NOR,
    CYN "四海闻名" NOR,
    HIC "扬名宇内" NOR,
    HIW "隐姓埋名" NOR,
  });

  grade = level / 30;

  if (grade >= sizeof(level_desc))
    grade = sizeof(level_desc) - 1;
  return level_desc[grade];
}
int valid_learn(object me) {

  if (me->query("office_number") >= 2000)
    return 1;
  if (me->query("office_number") < me->query_skill("leadership", 1) * 5)
    return notify_fail("你的官职没有到那个品级，领略不到御人的手段。\n");
  return 1;
}
