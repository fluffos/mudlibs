#include <ansi.h>

inherit NEWSKILL;

int query_npc_ignore()
{
    return 1;
}

string type()
{
    return "martial";
}

string level_description(int level)
{
    int grade;
    string *level_desc = ({
        BLU "东施效颦" NOR,
        BLU "其貌不扬" NOR,
        BLU "眉清目秀" NOR,
        BLU "薄有姿色" NOR,
        HIB "亭亭玉立" NOR,
        HIB "秀外惠中" NOR,
        HIB "粉妆玉琢" NOR,
        YEL "我见犹怜" NOR,
        YEL "出水芙蓉" NOR,
        YEL "玉貌花容" NOR,
        HIY "千娇百媚" NOR,
        HIY "绰约多姿" NOR,
        HIY "闭月羞花" NOR,
        CYN "沉鱼落雁" NOR,
        CYN "国色天香" NOR,
        CYN "天生丽质" NOR,
        HIC "倾国倾城" NOR,
        HIC "貌若天仙" NOR,
        HIC "冰肌玉骨" NOR,
        HIW "仙姿佚貌" NOR
    });

	grade = level / 1000;

	if ( grade >= sizeof(level_desc) )
	{
		grade = sizeof(level_desc) - 1;
	}

	return level_desc[grade];
}

void skill_improved(object me)
{
    int level = me->query_skill("makeup", 1);

    if ( 0 == level % 1000 )
    {
        me->add("per", 1);
        tell_object(me, "你对镜自照，只觉艳丽无方。\n");
    }
}

