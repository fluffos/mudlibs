inherit FORCE;

#include <ansi.h>

int query_npc_ignore() {
  return 1;
}

int valid_enable(string usage) {
  return usage == "force" || "spells" == usage;
}

int valid_learn(object me) {
  return 1;
}

int practice_skill(object me) {
  return notify_fail(HIR "【长春功】" NOR "乃是仙家秘诀，只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {
  //return CLASS_D("houyao") + "/mihou-force/" + func;
  return 0;
}
