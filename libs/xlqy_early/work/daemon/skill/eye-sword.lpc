int valid_learn(object me)
{
    object ob;

    if ( (int)me->query("max_force") < 50 )
    {
        return notify_fail("你的内力不够，没有办法练眨眼剑法。50\n");
    }

    if ( 1000 <= me->query_skill("eye-sword", 1) )
    {
        return notify_fail("新手剑法，练来何用。\n");
    }

    return 1;
}

int valid_enable(string usage)
{
    return usage == "sword" || usage == "parry" || usage == "dodge" || usage == "unarmed";
}

mapping query_action(object me, object weapon)
{
    return ::query_action(me, weapon, "eye-sword");
}

int practice_skill(object me)
{
    if ( !wizardp(me) && 1000 <= me->query_skill("eye-sword", 1) )
    {
        return notify_fail("新手剑法，练来何用。\n");
    }

    return ::practice_skill(me, 30, 0, 3, "eye-sword");
}

string perform_action_file(string func)
{
    return __DIR__"pfm/eye-sword/" + func;
}

