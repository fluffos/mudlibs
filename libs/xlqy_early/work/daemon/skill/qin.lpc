mapping *actions = ({
    ([
        "action":		"$N用$w往$n的$l直戳过去",
        "damage_type":	"刺伤",
        "dodge":		-10,
        "parry":		-10,
        "damage_tpye" : "impale",
    ]),
});

int valid_enable(string usage)
{
    return (usage == "literate") || (usage == "music");
}

int practice_skill(object me)
{
    object weapon;
    int skill1, skill2;

    skill1 = (int)me->query_skill("qin",1);
    skill2 = (int)me->query_skill("music",1);

    if ( !objectp(weapon = me->query_temp("weapon")) ||
        (string)(weapon->query("skill_type")) != "music"||(string)(weapon->query("music_type")) != "qin" )
    {
        return notify_fail("手中无琴，如何抚弹呀？ :)\n");
    }

    if ( skill1 > 300 && skill1 > skill2 )
    {
        return notify_fail("你的技艺已达超群脱俗，没有很好的音律乐理做根底，练已经很难领悟到弹奏的技巧了！\n");
    }

    return ::practice_skill(me, 50, 50, 100, "qin", "你轻拨琴弦，弹奏了一曲『高山流水』。\n");
}

mapping query_action(object me, object weapon) 
{
    weapon = me->query_temp("weapon");

    if ( (string)(weapon->query("music_type")) != "qin" )
    { 
        return actions[0];
    }

    return ::query_action(me, weapon, "qin");
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int howlong;
    object weapon;

    weapon = me->query_temp("weapon");     

    if ( (!weapon) ||(string)(weapon->query("music_type")) != "qin" )
    {
        return 0;
    }

    if ( (string)me->query_family() != "盘丝洞" )
    {
        return 0;
    }

    if ( victim->query_temp("no_move") )
    {
        return 0;
    }

    if ( (int)me->query_skill("music", 1) > 300 && random(3) ) //人间绝响。。。
    {
        message_combatd(HIG"$N听得如此美妙仙乐、空灵之音，心中又是惊讶又是欢喜，呆呆的望着$n，竟然忘了自己在战斗之中！\n"NOR, victim, me);
        howlong = 1 + (int)me->query_skill("music") / 50;
        if ( howlong > 20 )
        {
            howlong = 20;
        }
        howlong = howlong / 2 + random(howlong);
        COMBAT_D->start_nomove(victim, howlong);
        return 0;	
    }
    else if ( ((int)me->query_skill("music", 1) / 2) > random((int)victim->query_skill("force", 1)))
    {
        message_combatd(HIG"$N听得如此美妙仙乐、空灵之音，心中又是惊讶又是欢喜，呆呆的望着$n，竟然忘了自己在战斗之中！\n"NOR, victim, me);
        howlong = 1 + (int)me->query_skill("music") / 50;
        if ( howlong > 20 )
        {
            howlong = 20;
        }
        howlong = howlong / 2 + random(howlong);
        COMBAT_D->start_nomove(victim, howlong);
        return 0;	            
    }

    return 0;
}

string perform_action_file(string func)
{
    return CLASS_D("pansi") + "/qin/" + func;
}

