inherit SSERVER;

int exert(object me, object target) {
  int diff, neilineed;

  if (target != me) {
    target = me;
  }

  limit_status["force"] = 20;

  limit_skills["force"] = 20;

  if (!can_perform(me)) {
    return 0;
  }

  diff = me->query("eff_sen") - me->query("sen");
  neilineed = diff * 50 / (int)me->query_skill("force");
  if (neilineed < 1) {
    return notify_fail("你现在精神饱满，不需吸气。\n");
  }

  if (neilineed > me->query("force")) {
    neilineed = me->query("force");
  }

  diff = (int)me->query_skill("force") / 50 * neilineed;

  if (me->can_special("spirituality")) {
    diff += diff / 2;
  }

  me->receive_heal("sen", diff);
  me->add("force", -neilineed);

  message_exert("$N略一凝神，吸了口气，精神看起来清醒多了。\n", me);

  //if( me->is_fighting() ) me->start_busy(1);

  return 1;
}
