#include <ansi.h>

inherit SSERVER;

int exert(object me, object target)
{
    int skill;

    if ( target != me )
    {
        target = me;
    }

    limit_status["force"] = 100;
    limit_status["sen"] = 300;
    limit_status["kee"] = 300;

    limit_skills["force"] = 100;

    if ( !can_cast(me) )
    {
        return 0;
    }

    if ( (int)target->is_busy() )
    {
        return notify_fail("你正忙着呢。\n");
    }

    if ( (int)target->is_fighting() )
    {
        return notify_fail("你正忙着呢。\n");
    }

    me->set("bellicosity", 0);
    me->clear_all_condition();
    me->add("force", -100);

    me->receive_damage("sen", 100);

    message_exert(HIC"$N盘膝坐下，双眼微闭，运起反五行摄气诀压制心中的杀气。。。\n" NOR, me);

    return 3 + random(3);
}

