//last updated by bugbug 2002.1.31
//出家人慈悲为怀，busy为主 :)

#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    string msg;
    int extra, damage;
    object weapon;
    mixed mydh, hisdh, mydh2;

    if  ( !target )
    {
        return notify_fail("［大势将至］只能对战斗中的对手使用。\n");
    }

    limit_status["force"] = 500;
    limit_status["sen"] = 200;
    limit_status["kee"] = 100;

    limit_skills["bighammer"] = 100;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    if ( me->is_busy() )
    {
        return notify_fail("你现在没空！！\n");
    }

    extra = me->query_skill("bighammer",1) ;

    me->add("force", -200);
    me->receive_damage("sen", 50);
    me->receive_damage("kee", 50 + random(50));

    weapon = target->query_temp("weapon");

    mydh = COMBAT_D->cast_power(me, target, SKILL_USAGE_ATTACK);
    hisdh = COMBAT_D->cast_power(me, target, SKILL_USAGE_DEFENSE);

    message_perform(HIR "\n$N身形立定口诵佛号，$n只觉得一种巨大的压力扑面而来！\n" NOR, me, target);

    mydh2 = COMBAT_D->power_mul(mydh, 4);
    mydh2 = COMBAT_D->power_div(mydh2, 5);

    if ( 0 < COMBAT_D->cast_hit(mydh2, hisdh) )	
    {
        damage = SPELL_D->get_mydamage_direct(me, target);

        mydh2 = COMBAT_D->power_div(mydh, 5);

        if ( 0 < COMBAT_D->cast_hit(mydh2, hisdh) ) 
        {
            // 4/5中的 1/5
            message_perform(HIR "\n$n不堪重压，身子象要爆开一般，奇痛无比！波的喷出一口鲜血！\n " NOR, me, target);

            if ( damage > target->query("kee") * 2 / 3 )
            {
                damage = target->query("kee") * 2 / 3; 
            }
        }
        else
        {
            mydh2 = COMBAT_D->power_div(mydh, 2);

            if ( 0 < COMBAT_D->cast_hit(mydh2, hisdh) ) 
            {
                message_perform(HIR "\n$n暗运内力向抗，但还是喷出一口鲜血！\n " NOR, me, target);

                if ( damage > target->query("kee") / 2 )
                {
                    damage = target->query("kee") / 2;
                }
            }
            else
            {
                message_perform(HIY "\n$n受到轻微的震伤!\n" NOR, me, target);

                if ( damage > target->query("kee") / 3 )
                {
                    damage = target->query("kee") / 3;
                }
            }
        }

        target->receive_damage("kee", damage, me, "magic");
        target->receive_wound("kee", damage / 3);
        COMBAT_D->report_status(target, 1, me, "kee");

        mydh2 = COMBAT_D->power_div(hisdh, 6);
        if ( 0 < COMBAT_D->cast_hit(COMBAT_D->power_random(mydh), mydh2) ) 
        {
            if ( weapon )
            {
                message_perform(HIR "\n$n眼见大势已去，放下手中兵器" NOR, me, target);
                weapon->unequip();
            }
            message_perform(HIR "\n$n被$N的佛法感化，跪倒在地已经忘记了自己还在战斗之中！\n\n" NOR, me, target);

            damage = random(extra / 30);
            if ( damage > 6 )
            {
                damage = 6;
            }

            target->start_busy(4 + damage);
        }
    }
    else 
    {
        //1/5概率
        message_perform(HIB "\n$n暗运内力，逼回了这股劲风！\n" NOR, me, target);
    }

    me->improve_skill("bighammer", 1, 1);

    return 3 + random(4);
}

string skill_name(object me, object target, string skill)
{
    return "大势将至";
}

