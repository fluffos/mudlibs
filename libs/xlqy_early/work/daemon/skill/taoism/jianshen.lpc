#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
   string msg;
   int damage=0, ap, dp, chance,lv;

   if( !target ) target = offensive_target(me);

   if( !target
   ||   !target->is_character()
   ||   target->is_corpse()
   ||   target==me)
     return notify_fail("你要对谁施「剑神」？\n");
    if(me->query("family/family_name")!="蜀山剑派")
                return notify_fail("你不是蜀山弟子，不能使用这项技能！\n");

   if((int)lv=me->query_skill("taoism", 1) < 50 )
     return notify_fail("你的天师仙法火候不够，哪可能呼唤出「剑神」！\n");

   if((int)me->query("mana") < 125+(int)me->query("mana_factor") )
     return notify_fail("你的法力不够，呼唤出「剑神」恐怕也没有什么用！\n");

   if((int)me->query("force") < 100 )
     return notify_fail("你的内力不够，无法将「剑神」呼唤出来。\n");
	
   if((int)me->query_skill("yujianshu",1)<100)
	   return notify_fail("你的御剑术太差了，无法使出剑神。\n");

   if((int)me->query_skill("mindsword",1)<100)
	   return notify_fail("你的桃花剑太差了，无法使出剑神。\n");

   if((int)me->query("sen") < 10 )
     return notify_fail("你现在神智不清！\n");

   me->add("mana", -125-(int)me->query("mana_factor"));
   me->add("force", -100);
   me->receive_damage("sen", 10);

   if( random(me->query("max_mana")) < 50 ) 
   {
     write("这一次好象不灵。\n");
     return 1;
   }
   msg = HIC "$N口中念念有辞，突然天空中出现「剑神」的身影！成千上万把灵剑向$n飞去！\n" NOR;
   message_vision(HIY"\n

                            "HIW"‘"HIC"～剑     神～"HIW"’\n"NOR"
                                      "WHT"██"NOR"
                                       "RED"█"NOR"
                               "WHT"██    "RED"█    "WHT"██"NOR"
                                "RED"█     "RED"█     "RED"█"NOR"
                         "WHT"██   "RED"█  "CYN"◢██◣  "RED"█   "WHT"██"NOR"
                          "RED"█    "RED"█   "HIY"｜朝｜"NOR"   "RED"█    "RED"█"NOR"
                   "WHT"██   "RED"█  "CYN"◢█◣ "HIY"｜阳｜"NOR" "CYN"◢█◣  "RED"█   "WHT"██"NOR"
                    "RED"█    "RED"█  "HIC"｜冬｜ "HIY" ◣◢  "HIM"｜夕｜"NOR"  "RED"█    "RED"█"NOR"
                    "RED"█  "CYN"◢█◣"HIC"｜阳｜ "HIY" ██  "HIM"｜阳｜"NOR""CYN"◢█◣  "RED"█"NOR"
                    "RED"█  "HIW"｜艳｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜暖｜"NOR"  "RED"█"NOR"
                  "CYN"◢█◣"HIW"｜阳｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜阳｜"NOR""CYN"◢█◣"NOR"
                  "HIR"｜烈｜"HIW"｜  ｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜残｜"NOR"
	          "HIR"｜阳｜"HIW"｜  ｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜阳｜"NOR"
	          "HIR"｜  ｜"HIW"｜  ｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜  ｜"NOR"
                  "HIR"｜  ｜"HIW"｜  ｜"HIC"｜  ｜ "HIY" ██  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜  ｜"NOR"
                  "HIR"｜  ｜"HIW"｜  ｜"HIC"｜  ｜  "HIY"◥◤  "HIM"｜  ｜"HIG"｜  ｜"HIB"｜  ｜"NOR"
	          "HIR"｜  ｜"HIW"｜  ｜"HIC"｜  ｜        "HIM"｜  ｜"HIG"｜  ｜"HIB"｜  ｜"NOR"
		  "HIR"｜  ｜"HIW"｜  ｜"HIC" ＼／         "HIM" ＼／ "HIG"｜  ｜"HIB"｜  ｜"NOR"
		  "HIR"｜  ｜"HIW"｜  ｜                    "HIG"｜  ｜"HIB"｜  ｜"NOR"
		  "HIR"｜  ｜ "HIW"＼／                     "HIG" ＼／ "HIB"｜  ｜"NOR"
		  "HIR"｜  ｜                                "HIB"｜  ｜"NOR"
 		   "HIR"＼／                                 "HIB" ＼／"NOR"
\n"NOR,me);

   
   ap = me->query("combat_exp")/2+lv*lv/10*lv;
 dp = target->query("combat_exp")*3/4;
   chance = (int)(random(ap*2+dp/5) / (dp+ap)* 100 );//dianel, 2006-9-19 for overflow

   if( chance > 150 )
	   chance = 150;
if(me->query_temp("shushan_set")) chance += chance/2;
   if( chance > 66 ) 
   {
        damage = chance * 7 +150;
        damage +=(int)me->query("mana_factor")-random((int)target->query("mana_factor"));
		if(userp(target))
damage-=chance*3;
        msg += HIC "结果$n身中"+chinese_number(chance)+"剑！\n" NOR;
        target->receive_wound("kee", damage, me);
        me->improve_skill("taoism", 1, 1);
        //add rumor
        /*if (target->query("eff_kee")<0 || !living(target))  
                          {str=NOR+YEL+target->name()+HIM"被"NOR+HIY+me->name()+HIM"用"HIW"大雪山"HIB"绝学"HIY"Ⅱ"HIR" 鳳"HIM" 舞"HIG" 九"HIC" 天 "HIY"Ⅱ"HIM"给杀死了!据说"+target->name()+"皮开肉绽难以入目!";
                          message("channel:rumor",HIM"【大鹏明王】某人："+str+"\n"NOR,users());
                         }*/
        if(target->query("eff_kee")<0 && random(10)>6 ||!living(target))  
          	{
          	  string str;
          	  str=NOR+HIM+target->name()+"被"NOR+HIY+me->name()+HIM"用"HIY"蜀山剑派"HIW"绝学"HIC"Ⅱ"+" 剑神 "+"Ⅱ"HIM"给灭了!据说"+target->name()+"身上有"+HIR" "+chinese_number(chance)+HIM"个窟窿!";
                  message("channel:rumor",HIM"【蜀山剑派】某人："+str+"\n"NOR,users());
                 }
                         
     }
     else if ( chance > 33 ) 
     {
        damage = chance * 5 + 200 ;
        msg += HIC "结果$n被"+chinese_number(chance)+"剑擦伤！\n" NOR;
		if(userp(target))
 damage-=chance*3;
        target->receive_wound("kee", damage, me);
        me->improve_skill("taoism", 1, 1);
     } 
   else
     msg += "但是被$n全躲开了。\n";

   message_vision(msg, me, target);
   if( damage > 0 ) COMBAT_D->report_status(target, 1);
   else if( damage < 0 ) COMBAT_D->report_status(me);

   if( !target->is_fighting(me) ) 
   {
     if( living(target) ) 
     {
        if( userp(target) ) target->fight_ob(me);
        else target->kill_ob(me);
     }
     me->kill_ob(target);
   }

   me->start_busy(1+random(3));
   return 1+random(4);
}

string skill_name(object me, object target, string skill)
{
    return "剑神";
}

