#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  object weapon;

  if (!target) {
    return notify_fail("你要对谁施展这一招「绝情四剑」？\n");
  }

  if (!me->is_fighting()) {
    return notify_fail("「绝情四剑」只能在战斗中使用！\n");
  }

  limit_status["max_force"] = 500;
  limit_status["force"] = 500;
  limit_status["sen"] = 250;

  limit_skills["snowsword"] = 120;

  if (!can_perform(me, "月宫")) {
    return 0;
  }

  weapon = me->query_temp("weapon");
  message_perform(HIW "\n$N运足精神，抖手刺出一剑，" + weapon->query("name") + "化作四道光芒直射$n!\n" NOR, me, target);
  message_perform(HIR "\n$N一式「马嵬坡下泥土中，不见玉颜空死处」，脚踏「巽」位！\n" NOR, me, target);
  COMBAT_D->perform_attack(me, target, weapon);

  message_perform(HIG "\n$N一式「楼阁玲珑五云起，其中绰约多仙子」，占住「兑」位！\n" NOR, me, target);
  COMBAT_D->perform_attack(me, target, weapon);

  message_perform(HIC "\n$N一式「在天愿作比翼鸟，在地愿为连理枝」，连踏「乾」「坤」二位！\n" NOR, me, target);
  COMBAT_D->perform_attack(me, target, weapon);

  message_perform(HIB "\n$N一式「天长地久有时尽，此恨绵绵无绝期」，由「坤」向「乾」疾退！\n" NOR, me, target);
  COMBAT_D->perform_attack(me, target, weapon);

  me->receive_damage("sen", 100);
  me->add("force", -200);

  become_enemy(me, target);

  return 2 + random(2);
}

string skill_name(object me, object target, string skill) {
  return "绝情四剑";
}
