#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  object weapon;
  int damage;
  string msg;
  mixed ap, pp;

  if (!target || !me->is_fighting(target)) {
    return notify_fail("「天女散花」只能对战斗中的对手使用。\n");
  }

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword") {
    return notify_fail("你使用的武器不对。\n");
  }

  limit_status["max_force"] = 500;
  limit_status["force"] = 300;

  limit_skills["snowsword"] = 100;
  limit_skills["moonforce"] = 100;

  if (!can_perform(me, "月宫")) {
    return 0;
  }

  msg = CYN "$N凝神息气，手腕疾抖，挽出千万个剑花，铺天盖地飞向$n。\n" NOR;

  ap = COMBAT_D->exp_power(me, target, SKILL_USAGE_ATTACK);
  pp = COMBAT_D->exp_power(me, target, SKILL_USAGE_DEFENSE);
  pp = COMBAT_D->power_div(pp, 2);

  if (0 >= COMBAT_D->perform_hit(
    ap,
    pp
  ) || (random(me->query_skill("sword")) > target->query_skill("parry") / 2)) {
    target->start_busy(random(4) + 1);

    damage = COMBAT_D->get_mydamage(
      me,
      0,
      0,
      me->query_entire_dbase(),
      target->query_entire_dbase(),
      TYPE_PERFORM
    );
    damage += (int)me->query_skill("moonforce", 1);
    damage += (int)me->query_skill("snowsword", 1);
    damage += (int)me->query_skill("sword", 1) / 2;

    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    me->add("force", -200);

    msg += HIR "只见$N剑花聚为一线，穿向$n,\n$n只觉一股热流穿心而过，喉头一甜，鲜血狂喷而出！\n" NOR;

    message_perform(msg, me, target);

    COMBAT_D->report_status(target, 1, me, "kee");
  } else {
    msg += CYN "可是$p猛地向前一跃,跳出了$P的攻击范围。\n" NOR;
    me->add("force", -100);
    message_perform(msg, me, target);
  }

  if (!target->is_fighting(me)) {
    target->fight_ob(me);
  }

  return 4 + random(4);
}

string skill_name(object me, object target, string skill) {
  return "天女散花";
}
