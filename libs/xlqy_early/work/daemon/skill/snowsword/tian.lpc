#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  object weapon;
  string str;
  int snowsword, moonforce, moondance, ini_damage_apply, times, damage;
  string desc_msg = "";
  int sword_level;
  int forcefactor;

  snowsword = (int)me->query_skill("snowsword", 1);
  moonforce = (int)me->query_skill("moonforce", 1);
  moondance = (int)me->query_skill("moondance", 1);

  if (!target) {
    return notify_fail("你要对谁施展「漫天飞雪」？\n");
  }

  limit_status["force"] = 400;

  limit_skills["moondance"] = 50;
  limit_skills["moonforce"] = 50;
  limit_skills["snowsword"] = 50;

  if (!can_perform(me, "月宫")) {
    return 0;
  }

  if (!me->is_fighting()) {
    return notify_fail("「漫天飞雪」只能在战斗中使用！\n");
  }

  weapon = me->query_temp("apply/weapon");
  if (!weapon) {
    weapon = me->query_temp("weapon");
  }
  if (!weapon) {
    return notify_fail("没剑怎么能使「漫天飞雪」？\n");
  }

  sword_level = (int)(snowsword / 50);

  forcefactor = me->query("force_factor");

  me->add("force", -100);

  if (sword_level <= 1) {
    desc_msg = "";
  } else {
    desc_msg = chinese_number(sword_level);
  }

  if (sword_level > 9) {
    desc_msg = "百";
  }

  ini_damage_apply = me->query_temp("apply/damage");

  message_perform(HIW "\n$N轻叱一声，脚尖一点，身体急速上旋，在半空中一个折腰。同时手腕轻抖，剑光闪动幻作漫天飞雪卷向$n。\n" NOR, me, target);

  damage = 1;

  //前三剑
  message_perform(HIC "\n$N同时使出风回雪舞剑的前三招，在半空中压向$n。\n" NOR, me, target);

  me->set_temp("snowsword_perform", 5);
  me->set("force_factor", 0);

  me->set(
    "force_factor",
    moonforce / 10 * (1 + LEVEL_D->query_level_index(LEVEL_D->query_ob_skill_level(me, "sword")))
  );

  damage = COMBAT_D->perform_attack(me, target, weapon);

  if (damage < 1) {
    me->add_temp("apply/damage", 800);
  }

  me->delete_temp("snowsword_perform");

  damage = COMBAT_D->perform_attack(me, target, weapon);

  if (damage < 1) {
    me->add_temp("apply/damage", 800);
  } else {
    me->set_temp("apply/damage", ini_damage_apply);
  }

  me->set_temp("snowsword_perform", 6);

  damage = COMBAT_D->perform_attack(me, target, weapon);

  if (snowsword > 1200 && moonforce > 1200 && moondance > 1200) {
    message_perform(HIC "\n$N身体斜斜向上飘出，也不回头，反手就刺出了两招。\n" NOR, me, 0);
    me->add("force", -100);

    if (damage < 1) {
      me->add_temp("apply/damage", 1200);
    } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }

    me->set_temp("snowswrd_perform", 7);

    damage = COMBAT_D->perform_attack(me, target, weapon);

    if (damage < 1) {
      me->add_temp("apply/damage", 1200);
    } else {
      me->set_temp("apply/damage", ini_damage_apply);
    }

    me->set_temp("snowsword_perform", 8);

    damage = COMBAT_D->perform_attack(me, target, weapon);

    me->set_temp("apply/damage", ini_damage_apply);
  }

  if (!weapon->query_unique() || LEVEL_D->query_ob_skill_level(
    me,
    "sword"
  ) == LEVEL_D->query_max_skill_level()) {
    //最后两剑
    if (snowsword > 2000 && moonforce > 2000 && moondance > 2000) {
      message_perform(HIC "\n$N斜斜一再个翻身，长剑幻作千百支冰箭，夹着一股寒风扑向$n。\n" NOR, me, target);
      me->add("force", -120);

      if (damage < 1) {
        me->add_temp("apply/damage", 2000);
      } else {
        me->set_temp("apply/damage", ini_damage_apply);
      }

      me->set_temp("snowsword_perform", 9);

      damage = COMBAT_D->perform_attack(me, target, weapon);

      if (damage < 1) {
        me->add_temp("apply/damage", 5000);
      } else {
        me->set_temp("apply/damage", ini_damage_apply);
      }

      me->set_temp("snowsword_perform", 10);

      damage = COMBAT_D->perform_attack(me, target, weapon);
    }
  }

  me->set("force_factor", forcefactor);
  me->delete_temp("snowsword_perform");
  me->set_temp("apply/damage", ini_damage_apply);

  become_enemy(me, target);

  me->set_temp("pfmdesc/tian", desc_msg);

  return 4 + random(4);
}

string skill_name(object me, object target, string skill) {
  return "漫天飞雪";
}

string query_desc(object me, object target) {
  return target->name() + HIM "被" + me->name() + HIM "用月宫绝招「漫天飞雪」杀死了。听说尸体上有" + me->query_temp("pfmdesc/tian") + "十多道深可见骨的伤痕！\n" NOR;
}
