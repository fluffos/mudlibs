#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) {
    return notify_fail("你要对谁施展这一招「逍遥一笑」？\n");
  }

  if (!me->is_fighting()) {
    return notify_fail("「逍遥一笑」只能在战斗中使用！\n");
  }


  limit_status["max_force"] = 800;
  limit_status["force"] = 500;
  limit_status["sen"] = 200;

  limit_skills["snowsword"] = 100;

  if (!can_perform(me)) {
    return 0;
  }

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  message_perform(HIW "\n" + HIY "$N轻叹道：" + HIW "朝闻道，夕死可亦，酒也乐逍 " + HIY "突然诡昧的一笑\n" +
    NOR "\n" + HIY "                    对着$n一连发出三道杀手！\n" NOR, me, target);

  me->set_temp("snowsword_perform", 2);
  COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

  me->set_temp("snowsword_perform", 5);
  COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

  me->set_temp("snowsword_perform", 6);
  COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

  me->receive_damage("sen", 100);
  me->add("force", -100);

  become_enemy(me, target);

  return 1 + random(2);
}

string skill_name(object me, object target, string skill) {
  return "逍遥一笑";
}
