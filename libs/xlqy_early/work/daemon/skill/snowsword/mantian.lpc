#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
    string msg;
    int i, j, z;
    object weapon;

    j = me->query_skill("snowsword", 1);
    z = me->query_skill("baihua-zhang", 1);

    weapon = me->query_temp("weapon");
    if ( !target )
    {
        return notify_fail("「满天飞雪」只能在战斗中对对手使用。\n");
    }

    if ( !weapon || weapon->query("skill_type") != "sword" )
    {
        return notify_fail("你必须在使用剑时才能使[满天飞雪」！\n");
    }

    limit_status["force"] = 500;
    limit_status["max_force"] = 1500;

    limit_skills["moondance"] = 120;
    limit_skills["moonforce"] = 120;
    limit_skills["snowsword"] = 120;
    limit_skills["baihua-zhang"] = 120;
    limit_skills["unarmed"] = 120;
    limit_skills["force"] = 150;

    if ( !can_perform(me) )
    {
        return 0;
    }

    if ( (int)me->query_str() < 50 )
    {
        return notify_fail("你的膂力还不够强劲，使不出「满天飞雪」绝技。50\n");
    }

    msg = HIM "$N使出月宫不传之密「漫天飞雪」，身行顿时急若风回，轻灵似雪舞！\n" NOR;
    if ( weapon )
    {
        msg += HIR"\n$N手中" + weapon->query("name") + "连划数剑，逼出道道金光，剑光中$N化身为二，掌剑齐出，直指$n！\n\n"NOR;
    }

    message_perform(msg, me, target);

    COMBAT_D->perform_attack(me, target, weapon);

    message_perform(HBGRN"\n$N潜运圆月神功，内劲飘忽不定，打出一股阴阳内旋之力！\n"NOR, me, target);
    me->reset_action();
    COMBAT_D->perform_attack(me, target, weapon);

    message_perform(HBYEL"\n$N潜运圆月神功，身法忽呼飘渺，异常灵动，微风拂面，乱剑已至！\n"NOR, me, target);
    me->reset_action();
    COMBAT_D->perform_attack(me, target, weapon);

    message_perform(HBRED"\n$N潜运圆月神功，内劲贯穿六脉，拳如钢铸，奔如速雷，行如电闪！\n"NOR, me, target);
    me->delete_temp("weapon");
    me->reset_action();
    COMBAT_D->perform_attack(me, target, 0);

    message_perform(HBMAG"\n$N潜运圆月神功，身法忽呼飘渺，异常灵动，微风拂面，乱剑已至！\n"NOR, me, target);
    me->set_temp("weapon", weapon);
    me->reset_action();
    COMBAT_D->perform_attack(me, target, weapon);

    me->add("force", -100);

    return 1 + random(3);
}

string skill_name(object me, object target, string skill)
{
    return "漫天飞雪";
}

