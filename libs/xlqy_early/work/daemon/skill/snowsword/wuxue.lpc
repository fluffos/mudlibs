#include <ansi.h>

inherit F_DBASE;
inherit FAMILYSKILL;

void remove_effect_wuxue(object me,int amount);
 
int perform(object me, object target)
{
    int skill_sword, skill_dodge, dodge_amount;

    if ( me->query_skill_mapped("dodge") != "moondance" )
    {
        return notify_fail("你还没有施展冷月凝香舞呢。\n");
    }

    limit_status["force"] = 50;

    limit_skills["moondance"] = 100;
    limit_skills["moonforce"] = 120;
    limit_skills["snowsword"] = 100;

    if ( !can_perform(me, "月宫") )
    {
        return 0;
    }

    skill_dodge = me->query_skill("moondance", 1);

    if ( me->query_skill_mapped("force") != "moonforce" )
    {
        return notify_fail("舞雪必须配合圆月心法才能使用。\n");
    }

    skill_sword = me->query_skill("sword");

    me->add("force", -100);
    message_perform(
        HIW"$N略一提气，运起轻功，拔剑起舞。只见$N足不沾地，手中剑越舞越快，逐渐幻做一团白雾，满堂滚动。\n" NOR, me, 0);

    dodge_amount = (int)skill_dodge * (4 + random(2)) / 12; 
    dodge_amount = dodge_amount * 8 / 10;

    me->add_temp("apply/dodge", dodge_amount);

    set_using(me, __FILE__);
    call_out("remove_effect_using", (int)skill_sword / 5, me, dodge_amount);

    return 1;
}

void remove_effect_using(object me, int amount)
{
    if ( me )
    {
        me->add_temp("apply/dodge", -(int)amount);

        message_perform(
            HIW"$N渐感气力不支，不得不放慢脚步，放缓剑招。\n"NOR, me);

        ::remove_effect_using(me, __FILE__);
    }
}

string skill_name(object me, object target, string skill)
{
    return "舞雪";
}

