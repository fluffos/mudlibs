#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  mixed ap, dp;

  if (!target) {
    return notify_fail("你想对谁施展这一招「雪舞飞寒」？\n");
  }
  if (!me->is_fighting()) {
    return notify_fail("「雪舞飞寒」只能在战斗中使用！\n");
  }

  limit_status["force"] = 300;
  limit_status["max_force"] = 500;

  limit_skills["parry"] = 50;
  limit_skills["dodge"] = 50;
  limit_skills["moondance"] = 50;
  limit_skills["snowsword"] = 50;
  limit_skills["sword"] = 50;
  limit_skills["moonforce"] = 50;
  limit_skills["force"] = 50;

  if (!can_perform(me)) {
    return 0;
  }

  message_perform(MAG "$N对$n妩媚的一笑，$n顿时看的呆如目鸡，这时$N挥动着手中的利剑直刺敌人的胸部。\n\n" NOR, me, target);

  ap = COMBAT_D->combat_power(me, target, "sword", SKILL_USAGE_ATTACK);
  dp = COMBAT_D->combat_power(me, target, "parry", SKILL_USAGE_DEFENSE);

  if (0 < COMBAT_D->perform_hit(ap, dp)) {
    me->delete("env/brief_message");
    target->delete("env/brief_message");

    message_perform(HIC "$n正看得入迷呆在那里不知所错时，$N已经看准时机狠狠的刺了一剑。 \n" NOR, me, target);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

    message_perform(HIY "$n依然呆呆的不动，$N看准时机又是狠狠的刺了一剑。 \n" NOR, me, target);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

    message_perform(HIG "$n已恢复了正常,可是身体却依然麻木无法移动，$N趁机又向$n飞快的刺了一剑。 \n" NOR, me, target);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

    me->add("force", -150 + random(50));
  } else {
    message_perform(HIR "$n看破了$N这招,并不为所动，步伐轻盈的向后跳了一步躲开了这一击。\n" NOR, me, target);
    me->add("force", 50 + random(50));
    me->delete("env/brief_message");
    target->delete("env/brief_message");
  }

  return 1 + random(2);
}

string skill_name(object me, object target, string skill) {
  return "雪寒飞舞";
}
