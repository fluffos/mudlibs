#include <ansi.h>

inherit SSERVER;

void post_cuixin(object,object,object,int);
int perform(object,object);
int perform(object me, object target)
{
	int level,extra,exp_mine,exp_target;

    mapping cuixin= 
	([
       "force": 250,
       "dodge" : -100,
       "parry" : -30,
       "damage_type" : "瘀伤",
       "action" :  HIG "$N双掌直拍向$n胸前，掌风中居然夹杂着阵阵寒气。" NOR,
       "post_action" : (: post_cuixin :),
    ]);

     if(me->query("family/family_name")!="大雪山")
           return notify_fail("你哪里偷来的武功？\n");


	if( !me->is_fighting() )
		return notify_fail("“摧心一掌”要在战斗中才能使用! \n");

	if( !target ) target = offensive_target(me);

    if( !target
		||	!target->is_character()
        ||  target->is_corpse()
        ||  target==me)
                return notify_fail("你要对谁使用“摧心一掌”？\n");

      if ( me->query_temp("no_perform")+4 > time() )
                return notify_fail("凤舞九天已使你短期内内力难继！\n");

	if( level = me->query_skill("cuixin-zhang",1) < 60 )
		return notify_fail("你的摧心掌等级太低了！\n");

	if( extra = me->query_skill("ningxie-force",1) < 60 )
		return notify_fail("你的冰谷凝血功太差了!\n");

	if( me->query("force") < 300 )
		return notify_fail("你的内力不够！\n");

	if( me->query("sen")  < 100 )
		return notify_fail("你的精神不够！\n");

	me->add("force",-200);
	me->add("sen",-30);

	message_vision(HIB "\n$N手形一变,暗运凝血神功，向$n发出致命一击！\n" NOR,me,target);
	
	exp_mine=me->query("combat_exp");
	exp_target=target->query("combat_exp");
	if( random(exp_target) < exp_mine )
	{		
	//Special attack
    me->set("actions",cuixin);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->reset_action();
	me->start_busy(random(3)+1);
	}
	else
	{
	//Normal attack
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	me->start_busy(1);
	}
	return 1;
}

void post_cuixin(object me,object target,object weapon, int damage)
{
	if(!target)
		return;

	if( damage > 0 )
	{
		message_vision(HIW "一阵寒气直逼$N,$N不禁打了一个哆嗦!\n" NOR,target);
		if( !target->is_busy() )
			target->start_busy(1+random(2));
		target->receive_damage("sen",me->query_skill("ningxie-force",1)/2+50);
		COMBAT_D->report_sen_status(target);
	}
}

