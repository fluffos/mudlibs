//wzg tianlai.c
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
        object *enemy;
         int count,lv;
        int level;
        int damage;
	int bonus=0;
		
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「天籁之音」？\n");

      bonus=(int)me->query_skill("music",1)/5;
      level=(int)me->query_skill("zouxiao",1);
      enemy=me->query_enemy();
       count=sizeof(enemy);
	if(!me->is_fighting())
                return notify_fail("「天籁之音」只能在战斗中使用！\n");

    if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

	if((int)me->query("force") < 500 )
		return notify_fail("你的内力不足！\n");

    if((int)me->query("sen") < 500 )
		return notify_fail("你的精神不足，没法子施用外功！\n");
    
    if((int)me->query_skill("baguazhen",1) < 100)
		return notify_fail("你的八卦九宫修为太差，恐怕吹的合不了节拍！\n");
    if((int)me->query_skill("music") < 150)
		return notify_fail("你的音律修为太差，奏出来的恐怕不是天籁之音！\n");

	if( me->query_temp("no_perform")>time())
		return notify_fail("绝招多用就不灵了。\n");
	lv=1;
   if(me->query("skill_level/music")=="expert")
   	lv=2;
   else if(me->query("skill_level/music")=="master")
   	lv=3;
   else if (me->query("skill_level/music")=="grandmaster")
   	lv=4;

    me->delete("env/brief_message");
	target->delete("env/brief_message");
       weapon = me->query_temp("weapon");
    message_vision(MAG"\n$N暗踩九宫八卦方位，激战中竟怡然自得吹奏"NOR+weapon->name()+MAG"，仿若天籁之音！\n"NOR,me);
		
		me->add_temp("apply/attack",bonus);
		me->add_temp("apply/defense",-bonus/2);
		me->add_temp("apply/damage",bonus/5);
     for(int i=0; i <2+(int)level/140;i++)
	{
           if (level > 140 && i > 1) //added by dogdog, give a wish to them
           {
            message_vision(MAG"\n$N激战中灵感突至，又谱一心曲，怡然自得。。\n"NOR,me);
                me->add_temp("apply/attack",((int)level/140)*bonus/4);
                me->add_temp("apply/damage",((int)level/140)*bonus/5);
                me->add_temp("apply/defense",-((int)level/140)*bonus/3);
              }
	      	
	      	  damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
         if (level > 140 && i > 1)
           {
            me->add_temp("apply/attack",-((int)level/140)*bonus/4);
           me->add_temp("apply/damage",-((int)level/140)*bonus/5);
           me->add_temp("apply/defense",((int)level/140)*bonus/3);
           }
             if (wizardp(me)){//added by dogdog
            tell_object(me,target->name());
             tell_object(me,sprintf("damage:%d",damage));
            tell_object(me,enemy[0]->name());
             }
	     	  if(damage)
	      	  {
	      	  for(int j=0;j<count;j++)
	      	  {
	      	  	if(target!=enemy[j]&&target->query("combat_exp")>random(enemy[j]->query("combat_exp")))
	      	  	{	enemy[j]->receive_damage("sen",damage*lv/4);
	      	  		enemy[j]->receive_wound("sen",random(damage*lv/4));		
	      	  		enemy[j]->set_temp("last_damage_from",me);
	      	  		COMBAT_D->report_sen_status(enemy[j], 0);
               if (wizardp(me)){//added by dogdog
                    tell_object(me,"in kill it");
                     }
	      	  	}
	      	  }
	      	}
	      	
	      	  		
	}

		me->add_temp("apply/attack",-bonus);
		me->add_temp("apply/damage",-bonus/5);
		me->add_temp("apply/defense",bonus/2);
	
        me->receive_damage("sen", 100);
        me->add("force", -100);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
   if (target->query("eff_kee")<0 || !living(target)) 
   {
   string str=target->name()+"被音乐所陶醉，在"+me->name()+"的箫声中安然死去。。。";
   message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
  me->set_temp("no_move",1);
  me->set_temp("no_perform",time()+random(3)+5);
  call_out("remove_no_move",3,me);
  return 1;
}

void remove_no_move(object me) 
{
  if (me) me->delete_temp("no_move");
}

