// rulai jienan-zhi perform如来神掌
// lestat 2001

#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    string msg, dodge_skill;
    int damage, p;
    object armor;
    mixed ap, dp;

    if ( !target || !me->is_fighting(target) || !living(target) )
    {
        return notify_fail("「如来神掌」只能在战斗中对对手使用。\n");        
    }

    limit_status["max_force"] = 1200;
    limit_status["force"] = 800;
    limit_status["kee"] = 200;

    limit_skills["lotusforce"] = 100;
    limit_skills["unarmed"] = 100;
    limit_skills["jienan-zhi"] = 100;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    if ( (int)me->query_str() < 24 )
    {
        return notify_fail("你的先天臂力不够强，不能使用「如来神掌」！\n");
    }

    if ( objectp(me->query_temp("weapon")) )
    {
        return notify_fail("你必须空手使用「如来神掌」！\n");
    }

    message_perform(HIR"\n$N突然面色怪异，低声默念佛门真言，双臂骨节一阵爆响，猛然腾空而起，伸手向$n胸前按去，好一式"HIY"「如来神掌」"BLU"！\n"NOR, me, target);

    ap = COMBAT_D->combat_power(me, target, "unarmed", SKILL_USAGE_ATTACK);
    dp = COMBAT_D->combat_power(me, target, "parry", SKILL_USAGE_DEFENSE);

    if ( 0 < COMBAT_D->perform_hit(ap, dp) )
    {
        if ( objectp(armor = target->query_temp("armor/cloth"))
            && armor->query("armor_prop/armor") < damage )
        {
            message_perform(HIY"只见这斗大的掌印正好印在$N的$n"HIY"上，越变越大，竟将它震得粉碎，裂成一块块掉在地上！\n"NOR, target, armor);
            break_equip(me, target, armor);
        }
        message_perform(RED"$n只觉得霍的胸口一阵剧痛，已经被$N拍中了前胸！\n"NOR, me, target);

        if ( !target->query_condition("dashouyin"))
        {
            p = 1 + (me->query_str());
            if ( 30 < p )
            {
                p = 30;
            }
            target->apply_condition("dashouyin", p);
        }

        damage = COMBAT_D->get_mydamage_direct(me, target, "unarmed", TYPE_PERFORM);

        target->receive_damage("kee", damage,  me); 
        target->receive_wound("kee", damage/2, me);
        if ( damage > target->query("max_force") / 1000 )
        {
            damage = target->query("max_force") / 1000;
        }
        target->add("force", -damage);
        COMBAT_D->report_status(target, 1, me, "kee");

        if ( (int)target->query("force") < 0 )
        {
            target->set("force", 0);
            message_perform(HIR"$n一口鲜血狂喷而出！\n"NOR, me, target);
        }

        me->add("force", -me->query("force_factor"));
    }
    else
    {
        dodge_skill = target->query_skill_mapped("dodge");
        if ( !dodge_skill )
        {
            dodge_skill = "dodge";
        }
        message_perform(SKILL_D(dodge_skill)->query_dodge_msg(target, 1), me, target);
    }

    return 5 + random(2);
}

string skill_name(object me, object target, string skill)
{
    return "如来神掌";
}

