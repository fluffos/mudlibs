#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    string msg;
    int damage;
    mixed ap, dp;

    if ( !target )
    {
        return notify_fail("你要对谁施展「佛祖拈花」？\n");
    }

    limit_status["force"] = 50 + (int)me->query("force_factor");
    limit_status["kee"] = 200;

    limit_skills["jienan-zhi"] = 100;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    me->add("force", -50 - (int)me->query("force_factor"));
    me->receive_damage("kee", 100);

    msg = HIG
        "\n$N面露诡异笑容，将右手三指拢入袖中，做拈花状\n"+
        "$n感到事态不妙，一时间不知所以，只觉三道劲风扑面而来，连忙闪避！\n" NOR;

    ap = COMBAT_D->combat_power(me, target, "unarmed", SKILL_USAGE_ATTACK);
    dp = COMBAT_D->combat_power(me, target, "parry", SKILL_USAGE_DEFENSE);

    if ( 0 >= COMBAT_D->perform_hit(ap, dp) )
    {
        msg += HIC "好在$n躲的及时，指风拂面而过，无甚大碍！\n\n"NOR;
        message_perform(msg, me, target);
    }
    else
    {
        damage = COMBAT_D->get_mydamage_direct(me, target, "unarmed", TYPE_PERFORM);

        msg += HIC "这三道指风看似柔弱无力，却如疾风将$n的气，神，内力尽数散去！\n" NOR;

        target->receive_wound("sen", damage, me);
        target->receive_wound("kee", damage, me);
        target->add("force", -damage / 10);

        COMBAT_D->report_status(target, 1, me, "kee");
        COMBAT_D->report_status(target, 1, me, "sen");

        me->improve_skill("jienan-zhi", 1, 1);
        message_perform(msg, me, target);
    }

    become_enemy(me, target);

    return 8 + random(4);
}

string skill_name(object me, object target, string skill)
{
    return "佛祖拈花";
}

