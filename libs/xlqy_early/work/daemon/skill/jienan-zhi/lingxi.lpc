#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    mixed ap, dp;
    int damage;

    if ( !target )
    {
        return notify_fail("你要对谁施展这一招「灵犀指」？\n");
    }

    if ( !me->is_fighting() )
    {
        return notify_fail("「灵犀指」只能在战斗中使用！\n");
    }

    limit_status["max_force"] = 1000;
    limit_status["force"] = 600;
    limit_status["sen"] = 500;

    limit_skills["jienan-zhi"] = 150;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    message_vision(HIY"\n$N心悟佛法，灵犀所至，缓缓伸出右手食指向$n凌空一点，一股阳和的气流向$n直逼过去。\n\n"NOR,me,target);

    ap = COMBAT_D->combat_power(me, target, "unarmed", SKILL_USAGE_ATTACK);
    dp = COMBAT_D->combat_power(me, target, "parry", SKILL_USAGE_DEFENSE);

    if ( 0 < COMBAT_D->perform_hit(ap, dp) )
    {
        damage = COMBAT_D->get_mydamage_direct(me, target, "unarmed", TYPE_PERFORM);

        message_perform(HIR"只听见「嗤」的一声轻响，$N右手食指已经在$n身上戳出一个血窟窿。\n\n"NOR, me, target);
        target->receive_wound("sen", damage, me);
        target->receive_wound("kee", damage, me);

        COMBAT_D->report_status(target, 1, me, "kee");
        COMBAT_D->report_status(target, 1, me, "sen");

        if ( !random(3) )
        {
            message_perform(HIY"$N的指力正正打在$n的穴道上，$n登时浑身酸麻动弹不得。\n"NOR, me, target);
            target->start_busy(4 + random(3));
        }
    }	 
    else
    {
        message_perform(HIC"$N识得厉害，连忙使一个鹞子翻身躲开了！\n"NOR, target);
    }

    me->add("force", -50);
    me->receive_damage("sen", 50);

    return 10 + random(4);
}

string skill_name(object me, object target, string skill)
{
    return "灵犀指力";
}

string query_desc(object me, object target)
{
    return target->name() + HIM"被" + me->name() + "的" + NOR + HIY"灵犀指力" + NOR + HIM"打中死穴，登时七孔流血而死。\n";
}

