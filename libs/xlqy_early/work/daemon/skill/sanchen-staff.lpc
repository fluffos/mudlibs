int valid_enable(string usage) {
  return usage == "staff" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  mapping *m_actions;
  m_actions = me->query("skill_sanchen-staff");
  if (me->query("skill_sanchen-staff") == 0)
    return action[random(sizeof(action))];
  if (random(4) == 1)
    return m_actions[random(sizeof(m_actions))];
  else
    return action[random(sizeof(action))];
}

int valid_learn(object me) {
  object ob;

  if ((string)me->query("gender") != "女性")
    return notify_fail("三辰恒舞杖法只适合女子使用!!\n");

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法学习三辰恒舞杖法。\n");

  if ((string)me->query_skill_mapped("force") != "wanxi-force")
    return notify_fail("三辰恒舞杖法必须配合万息集气术才能学习。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "staff")
    return notify_fail("你必须先找一根杖才能学习杖法。\n");

  return 1;
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习三辰恒舞杖法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著师父所授诀窍练了一遍三辰恒舞杖法。\n");
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("hsl/hsl_magic") + "/sanchen-staff/" + func;
}


void skill_improved(object me) {
  int m_skill = me->query_skill("sanchen-staff", 1);

  if (m_skill > 200 && m_skill % 10 == 0) {
    tell_object(me, HIW "你对三辰恒舞杖法的领悟加深了，你的三辰恒舞杖法进入了一个新的境界！\n" NOR);
    if (random(me->query("kar")) < 20) {
      tell_object(me, HIW "然而你的心中居然产生了一种失落感！\n" NOR);
      return;
    }
    if (random(me->query("int")) < 20) {
      tell_object(me, HIW "然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n" NOR);
      return;
    }
    tell_object(me, HIW "你突然福至心灵，对三辰恒舞杖法领悟出了一招新的用法！\n" NOR);
    tell_object(me, "请为这招取一个名字：");
    input_to((: call_other, __FILE__, "name_skill", me :));
  }
  return;
}

void name_skill(object me, string arg) {
  mapping *m_actions;
  mapping m_act = ([]);
  int content;
  string msg;

  m_actions = me->query("skill_sanchen-staff");
  if (!pointerp(m_actions)) m_actions = ({});

  content = me->query("str") + 2 * me->query_skill("unarmed", 1) / 10;
  m_act += ([ "damage": content ]);
  content = -me->query("spi");
  m_act += ([ "dodge": content ]);
  content = -me->query("cps");
  m_act += ([ "parry": content ]);
  content = me->query("con") + me->query_skill("force", 1) / 10;
  m_act += ([ "force": content ]);
  m_act += ([ "damage_type": "砸伤" ]);

  if (!arg || arg == " ") arg = "三辰恒舞杖法必杀技" + chinese_number(sizeof(m_actions) + 1);
  m_act += ([ "name": arg ]);
  msg = skill_head[random(sizeof(skill_head))] + BLINK + HIM "「" + arg + "」" NOR + skill_tail[random(sizeof(skill_tail))];
  m_act += ([ "action": msg ]);
  m_actions += ({ m_act });
  me->set("skill_sanchen-staff", m_actions);
}

mixed hit_ob(object me, object target, int damage_bonus) {
  int ap, dp, i, amount;
  string str;
  if (random(me->query_skill("spells")) < 100)
    return 0;
  ap = me->query_skill("spells");
  dp = target->query_skill("spells");
  amount = (me->query_skill("spells") + me->query_skill("staff")) / 20;
  if (ap / 3 > random(dp)) {
    message_vision(
      HIM "\n$N手中" + me->query_temp("weapon")->query("name") + "轻轻划过，便有万千琉璃洒满虚空,七彩光雨纷纷飘落。\n" NOR,
      me
    );
    str = HIC "$n在这如花花大千世界美妙的光雨中，却蓦然发现自己孑然独立其中，\n霎时";
    switch (random(3)) {
      case 0:
        i = target->query_temp("sanchen-staff_curse");
        if (i < 3) {
          switch (i) {
            case 0:
              str += "感觉分外的孤独与无助，斗志消退了三分！\n" NOR;
              break;
            case 1:
              str += "感觉分外的孤独与无助，斗志消退了六分！\n" NOR;
              break;
            case 2:
              str += "感觉分外的孤独与无助，斗志消退了九分！\n" NOR;
              break;
            default:
          }
          target->add_temp("apply/attack", -amount);
          target->add_temp("apply/dodge", -amount);
          target->set_temp("sanchen-staff_curse", ++i);
          target->start_call_out(
            (: call_other, __FILE__, "remove_effect", target, amount :),
            30 + amount / 2
          );
        } else
          str += "感觉分外的孤独与无助，斗志消退了九分！\n";
        break;
      case 1:
        i = target->query_temp("sanchen-staff_curse");
        if (i < 3) {
          switch (i) {
            case 0:
              str += "感觉分外的寂寞与空虚，斗志消退了三分！\n" NOR;
              break;
            case 1:
              str += "感觉分外的寂寞与空虚，斗志消退了六分！\n" NOR;
              break;
            case 2:
              str += "感觉分外的寂寞与空虚，斗志消退了九分！\n" NOR;
              break;
            default:
          }
          target->add_temp("apply/attack", -amount);
          target->add_temp("apply/dodge", -amount);
          target->set_temp("sanchen-staff_curse", ++i);
          target->start_call_out(
            (: call_other, __FILE__, "remove_effect", target, amount :),
            30 + amount / 2
          );
        } else
          str += "感觉分外的寂寞与空虚，斗志消退了九分！\n" NOR;
        break;
      case 2:
        str += "悲伤与绝望之情涌塞心口，颤巍巍而无力战斗！\n" NOR;
        if (!target->is_busy()) target->start_busy(1 + random(2));
    }
    message_vision(str, me, target);
  }
  return 0;
}

void remove_effect(object ob, int amount) {
  int i = ob->query_temp("sanchen-staff_curse");
  if (!ob) return;
  if (i <= 0) return;
  ob->add_temp("apply/attack", amount);
  ob->add_temp("apply/dodge", amount);
  ob->set_temp("sanchen-staff_curse", --i);
  //     message_vision("作用消退到了第"+i+"层。\n",ob);
  ob->start_call_out((: call_other, __FILE__, "remove_effect", ob, amount :), 30 + amount / 2);
}
