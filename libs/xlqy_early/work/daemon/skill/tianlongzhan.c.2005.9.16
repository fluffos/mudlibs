int valid_learn(object me)
{
        object ob;

    if( (int)me->query("max_force") < 350 )
                return notify_fail("你的内力不够，不能学天龙斩，多练些内力再来吧。\n");
    if ((int)me->query_skill("tianlongzhan",1)>=((int)me->query("tianlongzhan/zhengqi_point")*2))
	    return notify_fail("你的天地正气已经到了极限！\n");
    if (!(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "blade" )
                return notify_fail("你必须先找一把刀才能学刀法。\n");
        return 1;
}

int practice_skill(object me)
{
        object ob;
        
	if( (int)me->query_skill("tianlongzhan",1) > (int)me->query_skill("blade",1)
		|| (int)me->query_skill("tianlongzhan",1) < 320 )
		return notify_fail("以你目前的刀法修为，练是不能提高天龙斩的。\n");
    if ((int)me->query_skill("tianlongzhan",1)>=((int)me->query("tianlongzhan/zhengqi_point")*3))
	    return notify_fail("你的天地正气已经到了极限！\n");
        if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "blade" )
                return notify_fail("你必须先找一把刀才能练刀法。\n");	
	if( (int)me->query("kee") < 30   ||   (int)me->query("force") < 30 )
		return notify_fail("你的内力或气不够,没有办法练习天龙刀法。\n");
		
	me->receive_damage("kee", 30);
   	me->add("force", -5);
  	write("你按着所学练了一遍天龙刀法.\n");
   return 1;
}

int valid_enable(string usage)
{
        return usage=="blade"||usage=="parry"||usage=="dodge";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

string query_parry_msg(object weapon)
{
	return action[random(sizeof(action))]["parry_msg"];
}
string query_dodge_msg(string limb)
{
	return action[random(sizeof(action))]["dodge_msg"];
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	
         object ob;
         int damage;
          if ((ob = me->query_temp("weapon"))&&(string)ob->query("id") == "tianlong zhan" )
          {
         	damage = me->query("tianlongzhan/zhengqi_point")*me->query("spi")/3; 	
        	damage = damage/2+random(damage/2);
        	damage = damage*victim->query("eff_kee")/victim->query("max_kee");
        	if(damage > 9999)	damage = 9999+random(2);
      	
         	victim->receive_damage("kee",damage);
         	victim->receive_damage("sen",damage);
         	victim->receive_wound("kee",damage/3);
         	victim->receive_wound("sen",damage/3);
   		message_vision(ob->query("name")+"霞光一闪，化做青龙直扑"+victim->query("name")+"！\n",me);
   		
        }
        else if ((ob = me->query_temp("weapon"))&&(string)ob->query("id") == "tianlong dao" )
          {
         	damage = me->query("tianlongzhan/zhengqi_point")*me->query("spi")/4; 	
        	damage = damage/2+random(damage/2);
        	damage = damage*victim->query("eff_kee")/victim->query("max_kee");
        	if(damage > 6666)	damage = 6666+random(5);
      	
         	victim->receive_damage("kee",damage);
         	victim->receive_damage("sen",damage);
         	victim->receive_wound("kee",damage/3);
         	victim->receive_wound("sen",damage/3);
   		message_vision(ob->query("name")+"霞光一闪，化做青龙直扑"+victim->query("name")+"！\n",me);
   		
        }
}


string perform_action_file(string func)
{
	return CLASS_D("emei") + "/tianlongzhan/"+func;
}

