#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;
  mixed ap, dp;

  if (!target) {
    return notify_fail("你要对谁施展这一招？\n");
  }

  if (!me->is_fighting()) {
    return notify_fail("「断发」只能在战斗中使用！\n");
  }

  limit_status["max_force"] = 300;
  limit_status["force"] = 300;
  limit_status["sen"] = 100;

  limit_skills["xuanhu-blade"] = 100;

  if (!can_perform(me)) {
    return 0;
  }

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  message_perform(HIC "\n$N一声长吟，刀光笼罩天宇，漫天青光缓缓撒落，缠绵恨意，至此断绝！\n" NOR, me, target);

  ap = COMBAT_D->exp_power(me, target, SKILL_USAGE_ATTACK);
  ap = COMBAT_D->power_mul(ap, 3);
  ap = COMBAT_D->power_div(ap, 4);
  dp = COMBAT_D->exp_power(me, target, SKILL_USAGE_DEFENSE);
  dp = COMBAT_D->power_random(dp);

  if (0 < COMBAT_D->perform_hit(ap, dp)) {
    damage = COMBAT_D->get_mydamage(
      me,
      0,
      0,
      me->query_entire_dbase(),
      target->query_entire_dbase(),
      TYPE_PERFORM
    );
    message_perform(HIW "\n$n望着刀光，心绪如波，无数缠绵往事涌上心头，不由心底一酸，心神荡漾，三魂六魄都丢光了!\n" NOR, me, target);
    target->receive_damage("sen", damage, me, "magic");
    target->receive_wound("sen", damage / 2, me);
    COMBAT_D->report_status(target, 1, me, "sen");
    damage = 1;
  } else {
    message_perform(HIG "\n$n一声长啸，拔地而起，从刀光中挣脱出来，点点青光顿时消失！\n" NOR, me, target);
    damage = 2;
  }

  me->receive_damage("sen", 50);
  me->add("force", -100);

  return damage + random(2);
}

string skill_name(object me, object target, string skill) {
  return "断发";
}
