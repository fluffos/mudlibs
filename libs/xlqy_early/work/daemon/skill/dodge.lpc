// dodge.c
#include <ansi.h>

inherit NEWSKILL;

string *dodge_msg = ({
  "但是和$p$l偏了几寸。\n",
  "但是被$p机灵地躲开了。\n",
  "但是$n身子一侧，闪了开去。\n",
  "但是被$p及时避开。\n",
  "但是$n已有准备，不慌不忙地躲开。\n",
});

string query_dodge_msg() {
  return dodge_msg[random(sizeof(dodge_msg))];
}

string level_description(int level) {
  int max_level;
  int grade;
  string *level_desc = ({
    BLU "笨手笨脚" NOR,
    BLU "步伐轻盈" NOR,
    BLU "身形灵动" NOR,
    BLU "身轻如燕" NOR,
    HIB "旱地拔葱" NOR,
    HIB "草上可飞" NOR,
    HIB "蜻蜓点水" NOR,
    HIB "飞檐走壁" NOR,
    CYN "八步赶蝉" NOR,
    CYN "一苇渡江" NOR,
    CYN "神影百变" NOR,
    CYN "凌波微步" NOR,
    HIC "疾若飞鸿" NOR,
    HIC "踏雪无痕" NOR,
    HIC "登萍度水" NOR,
    HIC "来去如风" NOR,
    HIW "追云赶月" NOR,
    HIW "一泻千里" NOR,
    HIW "移形换影" NOR,
    HIW "凌空渡虚" NOR,
  });

  max_level = LEVEL_D->query_max_skills() * 2 / 3 / sizeof(level_desc);

  grade = level / max_level;

  if (grade >= sizeof(level_desc)) {
    grade = sizeof(level_desc) - 1;
  }

  return level_desc[grade];
}

string perform_action_file(string action) {
  return "/daemon/class/pfm/dodge/" + action;
}
