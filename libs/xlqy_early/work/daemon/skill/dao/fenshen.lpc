#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target)
{
    int fenshen_time;
    object soldier;

    if ( !me->is_fighting() )
    {
        return notify_fail("只有战斗中才能使用分身法！\n");
    }

    limit_status["mana"] = 500;
    limit_status["max_mana"] = 200;
    limit_status["sen"] = 50;

    limit_skills["spells"] = 100;

    if ( !can_cast(me, "方寸山三星洞") )
    {
        return 0;
    }

    fenshen_time = 60 + (30 - (int)me->query_skill("spells") / 10);
    if ( fenshen_time < 45 )
    {
        fenshen_time = 45;
    }

    if ( (int)me->query("mana") < 4 * (int)me->query_skill("spells") )
    {
        return notify_fail("你的法力不够了！\n");
    }

    message_cast("$N喃喃地念了几句咒语。\n", me);

    if ( random(me->query("max_mana")) < 200 )
    {
        me->add("mana", -(int)me->query_skill("spells"));
        me->receive_damage("sen", 10);
        message_cast("但是什么也没有发生。\n", me);
        return 1;
    }

    me->add("mana", -4 * (int)me->query_skill("spells"));
    me->receive_damage("sen", 40);

    seteuid(getuid());

    soldier = new("/obj/npc/jiashen");
    soldier->move(environment(me));
    soldier->invocation(me);

    return fenshen_time;
}

string skill_name(object me, object target, string skill)
{
    return "分身术";
}

