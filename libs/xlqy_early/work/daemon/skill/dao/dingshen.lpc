#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target)
{
    string msg;
    mixed ap, dp;
    int howlong;

    if ( !target )
    {
        return notify_fail("你想把谁定住？\n");
    }

    limit_status["mana"] = 500;
    limit_status["sen"] = 10;

    limit_skills["spells"] = 100;

    if ( !can_cast(me, "方寸山三星洞") )
    {
        return 0;
    }

    if ( target->query_temp("no_move") )
    {
        return notify_fail(target->query("name") + "已经动弹不得了！\n");
    }

    me->add("mana", -500);
    me->receive_damage("sen", 10);

    msg = HIC"$N口中念了句咒文，朝$n一指，大喝一声：定！\n"NOR;

    ap = COMBAT_D->cast_power(me, target, SKILL_USAGE_ATTACK);
    dp = COMBAT_D->cast_power(me, target, SKILL_USAGE_DEFENSE);

    ap = COMBAT_D->power_add(ap, (int)me->query("mana"));
    dp = COMBAT_D->power_add(dp, (int)target->query("mana"));

    if ( 0 < COMBAT_D->cast_hit(ap, dp) )
    {
        msg +=  HIR "结果$n手足僵硬，果然动弹不得！\n" NOR;

        howlong = 15 + random((me->query_skill("spells") -100));
        if ( howlong > 60 )
        {
            howlong = 60;
        }
        COMBAT_D->start_nomove(target, howlong);
    }	    
    else
    {
        msg +=  HIR "结果$n被吓了一跳！\n" NOR;	
    } 

    message_cast(msg, me, target);

    if ( living(target) )
    {
        target->kill_ob(me);
    }

    return 3 + random(5);
}

string skill_name(object me, object target, string skill)
{
    return "定身术";
}

