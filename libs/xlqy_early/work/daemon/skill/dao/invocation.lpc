#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target)
{	
    int invocation_time;
    object soldier;

    if ( !me->is_fighting() )
    {
        return notify_fail("只有战斗中才能召唤天将！\n");
    }

    limit_status["mana"] = 150;
    limit_status["sen"] = 80;

    limit_skills["spells"] = 100;
    limit_skills["dao"] = 60;

    if ( !can_cast(me, "方寸山三星洞") )
    {
        return 0;
    }

    invocation_time = 60 + (200 - (int)me->query_skill("spells"));
    if ( invocation_time < 30 )
    {
        invocation_time = 30;
    }

    message_cast("$N喃喃地念了几句咒语。\n", me);

    me->add("mana", -150);
    me->receive_damage("sen", 80);

    if ( random(me->query("max_mana")) < 250 )
    {
        message_cast("但是什么也没有发生。\n");
        return 1;
    }

    seteuid(getuid());

    soldier = new("/obj/npc/heaven_soldier");
    soldier->move(environment(me));
    soldier->invocation(me);

    return invocation_time;
}

string skill_name(object me, object target, string skill)
{
    return "召唤天将";
}

