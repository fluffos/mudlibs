#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

void end_cast(object me, object target);
void cast_person(object me, object target);

// AGENTS.md §15aa-shaped ordering bug: this file defines its OWN 2-arg
// (object,object) override of remove_effect_using, but cast_person()
// (below) calls it before that definition would otherwise appear. A
// plain forward *declaration* here was NOT enough to fix the binding --
// this driver still bound the call to the INHERITED std/sserver.lpc
// version (object me, string file) until the real function body was
// moved up before its first caller, so the actual definition (not just
// a prototype) has to appear first, same trap as §15aa/§8b.
void remove_effect_using(object me, object target) {
  if (!me) {
    return;
  }

  me->set("env/invisibility", 0);

  message_cast(HIC "\n半空中金云渐渐消散了，露出了$N的身影。\n" NOR, me);

  if (target) {
    target->clear_condition("nomove");
  }

  if (environment(me)->query("oldlong")) {
    environment(me)->set("long", environment(me)->query("oldlong"));
    environment(me)->delete("oldlong");
  }

  remove_call_out("cast_person");

  ::remove_effect_using(me, __FILE__);
}

int cast(object me, object target) {
  string msg;
  int howlong;

  if (!target) {
    return notify_fail("你要对谁施展太极图？\n");
  }

  limit_status["mana"] = 2000;
  limit_status["sen"] = 500;

  limit_skills["dao"] = 250;

  if (!can_cast(me, "方寸山三星洞")) {
    return 0;
  }

  me->add("mana", -1500);
  me->receive_damage("sen", 300);
  if (random(me->query("max_mana")) < 500) {
    write("你失败了！\n");
    return 1;
  }

  msg = HIC "\n$N口中念了句咒文，大喝一声：呔！。。。太极无形！。。。\n只见空中金云陡起，并迅速弥漫开来，将$N的身形隐去。\n" NOR;
  message_cast(msg, me, target);

  me->set("env/invisibility", 1);

  howlong = me->query_skill("spells") / 5;
  if (howlong > 60) {
    howlong = 60;
  }

  cast_person(me, target);

  set_using(me, __FILE__);
  call_out("remove_effect_using", howlong, me, target);

  if (!environment(me)->query("oldlong")) {
    environment(me)->set("oldlong", environment(me)->query("long"));
    environment(me)->set("long", environment(me)->query("oldlong") + "\n半空中弥漫着金色的云彩，一切景色都很模糊。\n\n");
  }

  become_enemy(me, target);

  return 3 + random(5);
}

void cast_person(object me, object target) {
  mapping ap, dp;
  int damage;
  string msg;

  if (!me || !target || environment(target) != environment(me) || !me->is_fighting(target)) {
    remove_call_out("cast_person");
    remove_call_out("remove_effect_using");
    // Correctly binds to this file's own local override (see the
    // forward declaration above) now that it's declared before use.
    remove_effect_using(me, target);
    return;
  }

  if (target) {
    target->clear_condition("nomove");
  }

  if (random(2)) {
    msg = HIC "\n半空中金云翻腾，走出一位尖头鹰鼻的雷公，左手执斧，右手提锥。斧锥相击，在$n的头顶炸起一片响雷！\n" NOR;

    ap = COMBAT_D->cast_power(me, target, SKILL_USAGE_ATTACK);
    dp = COMBAT_D->cast_power(me, target, SKILL_USAGE_DEFENSE);

    ap = COMBAT_D->power_add(ap, (int)me->query("mana"));
    dp = COMBAT_D->power_add(dp, (int)target->query("mana"));

    if (0 < COMBAT_D->cast_hit(ap, dp)) {
      damage = (int)me->query("max_mana") + random((int)me->query("eff_sen"));
      damage -= random((int)target->query("eff_sen") + (int)target->query("max_mana"));
      damage += (int)me->query("mana_factor") - random((int)target->query("mana_factor"));

      //here we can see if 2 players are at same status, the attacker has higher chance.
      if (damage > 0) {
        msg += HIR "\n$n被雷声震的眼冒金星，心神不定，差点跌倒在地！\n" NOR;
        target->apply_condition("nomove");
        //finally damage also depends on enabled spells level.
        target->receive_damage("sen", damage / 4, me);
        target->receive_wound("sen", damage / 8, me);
        COMBAT_D->report_status(target, 1, me, "sen");
      } else {
        msg += "\n谁知$n毫无反应，依旧一心一意地和$N战斗。\n";
      }
    } else {
      msg += "\n谁知$n毫无反应，依旧一心一意地和$N战斗。\n";
    }
    message_cast(msg, me, target);
  } else {
    msg = HIC "\n半空中金云翻腾，走出一位容貌秀雅的电母，双手各持一枚铜镜。铜镜相转，忽的闪出一道金光射向$n！\n" NOR;

    ap = COMBAT_D->cast_power(me, target, SKILL_USAGE_ATTACK);
    dp = COMBAT_D->cast_power(me, target, SKILL_USAGE_DEFENSE);

    ap = COMBAT_D->power_add(ap, (int)me->query("mana"));
    dp = COMBAT_D->power_add(dp, (int)target->query("mana"));

    if (0 < COMBAT_D->cast_hit(ap, dp)) {
      damage = (int)me->query("max_mana") + random((int)me->query("eff_sen"));
      damage -= random((int)target->query("eff_sen") + (int)target->query("max_mana"));
      damage += (int)me->query("mana_factor") - random((int)target->query("mana_factor"));

      //here we can see if 2 players are at same status, the attacker has higher chance.
      if (damage > 0) {
        msg += HIR "\n结果「嗤」地一声，金光从$n身上透体而过，\n拖出一条长长的血箭，直射到两三丈外的地下！\n" NOR;
        target->apply_condition("nomove");

        //finally damage also depends on enabled spells level.
        target->receive_damage("kee", damage / 6, me);
        target->receive_wound("kee", damage / 10, me);
        COMBAT_D->report_status(target, 1, me, "kee");
      } else {
        msg += "\n但是被$n躲开了。\n";
      }
    } else {
      msg += "\n但是被$n躲开了。\n";
    }
    message_vision(msg, me, target);
  }

  call_out("cast_person", 5, me, target);
}

string skill_name(object me, object target, string skill) {
  return "太极图";
}
