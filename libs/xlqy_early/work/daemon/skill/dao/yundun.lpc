#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target)
{
    if ( me->is_fighting() && !target )
    {
        return notify_fail("没什么事别乱跑！\n");
    }

    limit_status["mana"] = 50;
    limit_status["sen"] = 50;

    limit_skills["dao"] = 30;

    if ( !can_cast(me, "方寸山三星洞") )
    {
        return 0;
    }

    if ( me->is_busy() )
    {
        return notify_fail("你正忙着呢！\n");
    }

    me->add("mana", -25);
    me->receive_damage("sen", 20);

    if ( random((int)me->query("max_mana")) < 13 )
    {
        tell_object(me,"天气晴朗，万里无云啊！\n");
        return 5 + random(5);
    }

    if ( me->is_fighting() )
    {
        if ( random((int)me->query("max_mana")) >(int)target->query("max_mana") / 2 )
        {
            message_cast(HIW"只见$N一个跟头跳起，一去二三里，离地四五丈，硬生生逃过一劫！\n"NOR, me);

            switch ( random(4) )
            {
                case 0:
                    me->move("/d/lingtai/lantao2");
                    break;
                case 1:
                    me->move("/d/lingtai/gate1");
                    break;
                case 2:
                    me->move("/d/lingtai/jingtang");
                    break;
                default:
                    me->move("/d/lingtai/houyuan");
                    break;
            }

            tell_room(environment(me),
                HIY"菩提老祖怒吼一声，你这小子，不学好，尽在外面给我丢脸！把" + me->query("name") + "从空中掼了下来，" + me->query("name") + "一下子摔得晕头转向……\n"NOR, ({me, me}) );
        }
        else
        {
            message_cast(HIW"$N想踏云而去，不料没踩牢，跌了个七荤八素。\n"NOR, me);
        }
    }
    else
    {
        message_cast(HIW"只见$N一个跟头跳起，一去二三里，离地四五丈，踏云而去也！\n"NOR, me);

        switch ( random(4) )
        {
            case 0:
                me->move("/d/lingtai/lantao2");
                break;
            case 1:
                me->move("/d/lingtai/gate1");
                break;
            case 2:
                me->move("/d/lingtai/jingtang");
                break;
            default:
                me->move("/d/lingtai/houyuan");
                break;
        }

        tell_room(environment(me),
            HIY"菩提老祖怒吼一声，你这小子，不学好，尽在外面给我丢脸！把" + me->query("name") + "从空中掼了下来，" + me->query("name") + "一下子摔得晕头转向……\n"NOR, ({me, me}) );
    }

    return 5 + random(5);
}

string skill_name(object me, object target, string skill)
{
    return "踏云乘风";
}

