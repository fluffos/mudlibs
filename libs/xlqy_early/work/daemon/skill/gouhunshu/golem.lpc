#include <ansi.h>
inherit SSERVER;

int cast(object me, string target) {
  object golem, ob;
  mapping dbase;

  if (me->query("family/family_name") != "阎罗地府")
    return notify_fail("你不是地府弟子，不能使用这项技能！\n");
  if (me->query_skill("gouhunshu", 1) < 150)
    return notify_fail("你还没学会召唤魔卫！\n");
  if (!target)
    return notify_fail("你要将什么物品召唤为魔卫？\n");
  if (!(ob = present(target, me)))
    return notify_fail("你要将什么物品召唤为魔卫？\n");
  if (!ob->is_diablo_ob())
    return notify_fail("这件物品毫无魔力，无法召唤出魔卫！\n");
  if (!ob->query("identification"))
    return notify_fail("你还不了解这件物品的特性，怎么召唤！\n");
  if (ob->query("kind") < 6)
    return notify_fail("这件物品魔力不足，无法召唤出魔卫！\n");
  if (ob->query("diablo_ob_autoloaded"))
    return notify_fail("这件物品不能召唤出魔卫！\n");
  if (!userp(me))
    return notify_fail("#^#$%@$@%#@$@#$！\n");
  if ((int)me->query("mana") < 1000)
    return notify_fail("你的法力不足！\n");

  if ((int)me->query("sen") < 333)
    return notify_fail("你的精神无法集中！\n");

  message_vision(HIB "$N喃喃地念了几句咒语。\n\n" NOR, me);

  me->add("mana", -500);

  if (random(me->query("max_mana")) < 20) {
    message("vision", "但是什么也没有发生。\n", environment(me));
    return 1;
  }
  if (me->query("summon/diablo_npc")) {
    golem = me->query("summon/diablo_npc");
    if (objectp(golem) && environment(golem))
      golem->die();

  }
  dbase = ob->query("diablo_prop");

  seteuid(getuid());
  golem = new("/obj/npc/hell_golem");
  golem->move(environment(me));
  golem->invocation(me, dbase);
  golem->set("title", ob->query("name"));
  golem->set_temp("invoker", me);

  message_vision(HIB "$N说道：感谢你，我的主人，将我从封印中释放，我将永远追随你保护你！\n" NOR, golem);
  me->set("summon/diablo_npc", golem);
  me->set("summon/npc_prop", dbase);
  me->set("summon/title", golem->query("title"));
  me->set("summon/family", golem->query("family/family_name"));
  me->save();
  me->start_busy(2 + random(2));
  destruct(ob);
  return 13 + random(13);
}
