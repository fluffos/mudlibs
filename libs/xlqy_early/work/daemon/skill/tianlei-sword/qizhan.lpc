//【天雷猛袭剑】之【气刃斩】
//初期好用，后期嘛……grin~~

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void qizhan_ok(object);

int perform(object me, object target) {
  int damage;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「气刃斩」？\n");
  if (me->query("family/family_name") != "幻世勇者")
    return notify_fail("非幻世勇者不能使用此项技能！\n");

  if (!me->is_fighting())
    return notify_fail("「气刃斩」只能在战斗中使用！\n");
  if ((int)me->query("max_force") < 300)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("tianlei-sword", 1) < 30)
    return notify_fail("你的天雷猛袭剑不够熟练，使用这一招会有困难！\n");
  if (me->query_temp("no_tianlei-sword_qizhan") > time())
    return notify_fail("你先歇口气再发招吧！\n");
  me->set_temp("no_tianlei-sword_qizhan", time() + 4);

  message_vision(HIW "\n$N调动全身的气息，御气于剑，向$n发出一招「气刃斩」！\n" NOR, me, target);
  //比较固定的伤害，随等级变化不大
  damage = 300 + random(100) + (int)me->query_skill("sword") / 4;
  damage = damage * 8 / 10;
  if (random((int)target->query("combat_exp")) < (int)me->query("combat_exp") * 2 / 3) {
    message_vision(HIR "\n$n躲闪不及，肩口被剑光穿过！\n" NOR, me, target);
    target->receive_damage("kee", damage, me, "phy");
    target->receive_wound("kee", damage / 5, me);
    COMBAT_D->report_status(target);
  } else {
    message_vision(HIG "\n$n经验十分老道，轻轻一格，身子斜斜飘开，便完全躲开了剑光！\n" NOR, me, target);
    me->start_busy(2);
  }
  me->add("force", -80);
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  return 1;
}

void remove_no_move(object me) {
  if (me) me->delete_temp("no_move");
}

string skill_name(object me, object target, string skill) {
  return "气刃斩";
}
