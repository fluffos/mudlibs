//【天雷猛袭剑】之【孤月斩】
//化解对方法力

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void moon_ok(object);

int perform(object me, object target) {
  int damage, ap, dp;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「孤月斩」？\n");
  if (me->query("family/family_name") != "幻世勇者")
    return notify_fail("非幻世勇者不能使用此项技能！\n");

  if (!me->is_fighting())
    return notify_fail("「孤月斩」只能在战斗中使用！\n");
  if (target->query("mana") <= 0)
    return notify_fail("对方已经丧失法力了！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 800)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("tianlei-sword", 1) < 100)
    return notify_fail("你的天雷猛袭剑不够熟练，使用这一招会有困难！\n");
  if (me->query_temp("no_tianlei-sword_moon") > time())
    return notify_fail("孤月斩不能连续使用！\n");
  me->set_temp("no_tianlei-sword_moon", time() + 5);

  message_vision(CYN "\n$N面对法力强大的$n，使出一招世上罕见的奇招" + HIW "「孤月斩」" NOR + CYN "！
剑光掠出一道如弯月的弧形光芒，直射$n！\n" NOR, me, target);

  //相同水平命中率为3/4左右
  damage = (int)me->query_skill("tianlei-sword", 1);
  damage = 8 * (damage + random(damage));
  damage = damage * 8 / 10;
  ap = (int)me->query("combat_exp");
  dp = (int)target->query("daoxing");
  if (random(ap + dp) > dp / 2) {
    message_vision(MAG "\n$n并未放在心上，大意之下，被月形光芒穿透身体，
才猛地发觉自己的法力已被奇迹般地化解甚多！\n" NOR, me, target);
    target->add("mana", -damage);
    if (target->query("mana") < 0)
      target->set("mana", 0);
  } else {
    message_vision(HIG "\n$n不知此招底细，连忙同时催动内力和法力，
汇聚成一道七彩神光，撞向剑光……剑光消失无形！\n" NOR, me, target);
  }
  me->add("force", -200);
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->start_busy(random(3));
  return 1;
}
