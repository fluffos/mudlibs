// 作者： tonii@ 缥缈水云间, 2003-4-22于浙大，修改请保留此行。
//【天雷猛袭剑】之强力绝招【黄龙闪】
//攻击对方气血，并削弱对方内力

#include <ansi.h>
#include <combat.h>
inherit SSERVER;


int perform(object me, object target) {
  int damage, ap, dp;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「皇龙闪」？\n");
  if (me->query("family/family_name") != "幻世勇者")
    return notify_fail("非幻世勇者不能使用此项技能！\n");

  if (!me->is_fighting())
    return notify_fail("「皇龙闪」只能在战斗中使用！\n");
  if ((int)me->query("max_force") < 1500)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 300)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("tianlei-sword", 1) < 120)
    return notify_fail("你的天雷猛袭剑不够熟练，尚未领悟到这个绝招\n");
  if (me->query_temp("no_tianlei-sword_shan") > time())
    return notify_fail("「皇龙闪」消耗内力巨大，得歇歇再用，否则对身体不利！\n");
  me->set_temp("no_tianlei-sword_shan", time() + 5);

  message_vision(HIW "$N怒吼一声，集全身力量于剑身，发出天雷猛袭剑中至刚至猛的强力绝招：\n"
    +BLINK "" + "「" + HIY "皇龙闪" + BLINK "" + HIW "」" NOR + HIW "，顿时一股汹涌的剑气裹着纯正雄厚的内力向$n奔袭过去！\n" NOR, me, target);
  damage = (int)me->query_skill("tianlei-sword", 1) + (int)me->query("force_factor");
  damage = damage * 6 / 5 + random(damage) * 6 / 5 + 200;
  damage = damage * 8 / 10;
  if (damage > 1500)
    damage = damage + (damage - 1500) / 2;
  ap = 2 * (int)me->query_skill("sword");
  dp = (int)target->query_skill("parry") + (int)target->query_skill("force");
  if (random(ap + dp) > dp * 2 / 3) {
    message_vision(HIR "\n$n哪里见过如此雄浑壮阔的剑气，仓惶之下躲避不及，
身上多处受到重创，元气也被大大削弱了！\n" NOR, me, target);
    target->receive_damage("kee", damage, me, "phy");
    target->receive_wound("kee", damage / 2, me);
    damage = (damage + random(damage)) * 6 / 5;
    target->add("force", -damage);
    if (target->query("force") < 0)
      target->set("force", 0);
    COMBAT_D->report_status(target);
    me->start_busy(1 + random(3));
    target->start_busy(1 + random(2));
  } else {
    message_vision(HIG "\n$n不闪不避，凭借雄厚的内力抵御，飞身向前，
以拼命之势孤注一掷，$N不敢与其两败俱伤，只能硬生生地撤回了攻势！\n" NOR, me, target);
    me->start_busy(2);
  }
  me->add("force", -200 - me->query("force_factor"));
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  return 1;
}

string skill_name(object me, object target, string skill) {
  return "皇龙闪";
}
