// powerup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill, howlong, skills;
  if (me->query("family/family_name") != "火云洞")
    return notify_fail("当心玩火自焚！\n");

  skill = me->query_skill("huomoforce", 1);

  if (skill > 350) skill = 350;         // no more than 30%
  skill += skill * me->query_temp("hyd_set") / 2;
  howlong = me->query_skill("force");
  howlong += howlong * me->query_temp("hyd_set") / 2;
  if (target != me)
    return notify_fail("你只能对自己用烈火神盾。\n");

  if ((int)me->query("force") < skill * 2)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("huomo/feedbacking"))
    return notify_fail("你已经在运功中了。\n");
  if (me->query("kee") < 150)
    return notify_fail("你的气血不足！\n");
  me->add("force", -skill);
  me->receive_damage("kee", 100);

  message_vision(
    HIR "$N丹田气涌,全身笼罩在一团火焰之中！\n" NOR, me);

  me->add_temp("apply/feedback_damage", 1000 + skill * 10);
  me->add_temp("apply/armor", skill / 2);
  me->set_temp("huomo/feedbacking", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill * 10 :), howlong);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount) {
  if (!me) return;
  me->delete_temp("huomo/feedbacking");
  me->add_temp("apply/armor", -amount / 20);
  me->add_temp("apply/feedback_damage", -amount - 1000);

  tell_object(me, "火焰慢慢又回到你的身体里去了。\n");
}
