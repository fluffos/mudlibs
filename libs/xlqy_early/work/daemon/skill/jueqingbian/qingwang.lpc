#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  string msg;
  mixed ap, ap2, dp;
  int howlong;

  if (!target) {
    return notify_fail("你想对谁使情网？\n");
  }

  if (!weapon = me->query_temp("weapon")) {
    return notify_fail("你没拿鞭子，拿什么织网啊？\n");
  }

  if (target->query_temp("fengmo") || target->query_temp("biqi") || target->query_temp("jinzhou")) {
    return notify_fail(target->query("name") + "已经陷入悲剧了！\n");
  }

  limit_status["force"] = 500;
  limit_status["sen"] = 10;

  limit_skills["spells"] = 100;
  limit_skills["moonshentong"] = 100;
  limit_skills["jueqingbian"] = 100;

  if (!can_perform(me)) {
    return 0;
  }

  me->add("force", -200);
  me->receive_damage("sen", 10);

  msg = HIB "$N催动法力，将手中" + weapon->query("name") + HIB "舞成一团，化做一张大网，向$n当头罩来。\n" NOR;

  ap = COMBAT_D->combat_power(me, target, "whip", SKILL_USAGE_ATTACK);
  ap2 = COMBAT_D->combat_power(me, target, "spells", SKILL_USAGE_ATTACK);
  dp = COMBAT_D->combat_power(me, target, "spells", SKILL_USAGE_DEFENSE);

  if (0 < COMBAT_D->perform_hit(ap, dp) || 0 < COMBAT_D->perform_hit(ap2, dp)) {
    msg += HIB "$n脑子里一片混乱，鬼使神差般突然发呆，甚至忘记了躲闪，被情网当头罩住。\n" NOR;

    howlong = random((me->query_skill("spells") - 100)) + 1;
    if (howlong > 20) {
      howlong = 20;
    }

    switch (random(3)) {
      case 0:
        target->start_fengmo(howlong);
        break;

      case 1:
        target->start_biqi(howlong);
        break;

      default:
        target->start_jinzhou(howlong);
        break;
    }
  } else {
    msg += HIG "$n神智清醒，不为情所困，轻轻向旁一跃，躲过了情网的袭击。\n" NOR;

    if (living(target)) {
      target->kill_ob(me);
    }
  }

  message_perform(msg, me, target);

  return 5 + random(4);
}

string skill_name(object me, object target, string skill) {
  return "情网";
}
