#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    object weapon;
    string msg;

    if ( !target )
    {
        return notify_fail("你要对谁施展这一招「三无三不手」？\n");
    }

    if ( !me->is_fighting(target) )
    {
        return notify_fail("「三无三不手」只能在战斗中使用\n");
    }

    limit_status["max_force"] = 1000;
    limit_status["force"] = 500;
    limit_status["sen"] = 50;

    limit_skills["moonshentong"] = 120;
    limit_skills["moonforce"] = 10;
    limit_skills["whip"] = 120;
    limit_skills["jueqingbian"] = 120;
    limit_skills["moondance"] = 100;

    if ( !can_perform(me, "月宫") )
    {
        return 0;
    }

    me->delete("env/brief_message");
    target->delete("env/brief_message");

    msg = HIC"\n问世间情为何物?直叫人生死相许!$N心中一阵酸楚,鞭法忽然变得灵动异常!\n" NOR;
    message_perform(msg, me, target);

    if ( (int)me->query_skill("jueqingbian", 1) > 1800 )
    {
        message_perform(HIW"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
        me->set_temp("jueqingbian_perform", 12);
        COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

        message_perform(MAG"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
        me->set_temp("jueqingbian_perform", 13);
        COMBAT_D->perform_attack(me, target, me->query_temp("weapon")); 

        message_perform(HIW"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
        me->set_temp("jueqingbian_perform", 14);
        COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

        message_perform(MAG"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
        me->set_temp("jueqingbian_perform", 15);
        COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

        message_perform(HIW"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
        me->set_temp("jueqingbian_perform", 16);
        COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

        message_perform(MAG"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
        me->set_temp("jueqingbian_perform", 17);
        COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
    }
    else
    {
        if ( (int)me->query_skill("jueqingbian",1) > 1500 )
        {
            message_perform(HIW"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
            me->set_temp("jueqingbian_perform", 12);
            COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

            message_perform(HIY"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
            me->set_temp("jueqingbian_perform", 13);
            COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

            message_perform(HIR"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
            me->set_temp("jueqingbian_perform", 14);
            COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

            message_perform(HIG"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
            me->set_temp("jueqingbian_perform", 15);
            COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
        }
        else
        {
            message_perform(YEL"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
            me->set_temp("jueqingbian_perform", 12);
            COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

            message_perform(CYN"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
            me->set_temp("jueqingbian_perform", 13);
            COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

            message_perform(MAG"刷的一声,$n好象感觉到一阵微风从耳边吹过\n"NOR, me, target);
            me->set_temp("jueqingbian_perform", 14);
            COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
        }
    }

    me->delete_temp("jueqingbian_perform");
    me->add("force", -100);

    become_enemy(me, target);

    return 4 + random(2);
}

string skill_name(object me, object target, string skill)
{
    return "三无三不手";
}

