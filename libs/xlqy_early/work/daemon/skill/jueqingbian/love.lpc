#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  object weapon, tar_weapon, invoker;
  int damage, level;
  int success, ap2, dp2;
  mixed ap, dp;
  string msg;
  int count, a_attack, a_damage;

  if (!target) {
    return notify_fail("你要攻击谁？\n");
  }

  if (!me->is_fighting()) {
    return notify_fail("你们没有在打架！\n");
  }

  limit_status["max_force"] = 1000;
  limit_status["force"] = 500;
  limit_status["sen"] = 100;

  limit_skills["moonshentong"] = 120;
  limit_skills["moonforce"] = 120;
  limit_skills["whip"] = 120;
  limit_skills["jueqingbian"] = 120;

  if (!can_perform(me, "月宫")) {
    return 0;
  }

  level = (int)me->query_skill("jueqingbian", 1);
  level += (int)me->query_skill("moonshentong", 1);
  level += (int)me->query_skill("whip", 1);
  level += (int)me->query_skill("moonforce", 1);
  level = (int)level / 200 + 1;
  if (level > 3) {
    level = 3 + random(level - 2);
  }
  if (level > 7) {
    level = 4 + random(5);
  }

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  tar_weapon = target->query_temp("weapon");
  weapon = me->query_temp("weapon");
  invoker = target->query_temp("invoker");

  msg = HIM "\n              厚地高天,堪叹古今情不尽； 痴男怨女,可怜风月债难偿！\n";
  message_perform(msg, me, target);

  msg = HIY "\n$N使出了『绝情鞭法』的精髓－－－－\n" BLINK + HIY "                              『" HIG "情思" HIB "·" HIR "情痴" HIB "·" HIW "情恨" HIY "』\n" NOR + MAG "只见$N随歌而舞，幻为月影斑斑，散作暗香浮动，手中的" + weapon->name() + MAG "洒出漫天鞭影，向$n攻去！\n\n" NOR;
  message_perform(msg, me, target);

  message_perform(BLINK + HIG "\n                                    『情思』\n" NOR, me, target);
  msg = HIG "                     衣带渐宽终不悔" HIB "－－－－ " HIY "为伊消得人憔悴！\n" NOR;
  message_perform(msg, me, target);

  count = me->query("per");
  if (!me->query("married") && !me->query("divorced"))  //嗯，待字闺中
  {
    count = count * 2;
  }
  count = count / 10 * 8;

  a_attack = count;
  a_damage = count / 2;

  me->add_temp("apply/attack", a_attack);
  me->add_temp("apply/damage", a_damage);

  COMBAT_D->perform_attack(me, target, weapon);

  me->add_temp("apply/attack", -a_attack);
  me->add_temp("apply/damage", -a_damage);

  message_perform(BLINK + HIR "\n                                    『情痴』\n" NOR, me, target);
  msg = HIR "                     金风玉露一相逢" HIB "－－－－" HIM "便胜却人间无数！\n" NOR;
  message_perform(msg, me, target);

  count = me->query("kar");
  if (me->query("married"))  //嗯，嫁了
  {
    count = count * 2;
  }

  a_attack = count;
  a_damage = count / 2;

  me->add_temp("apply/attack", a_attack);
  me->add_temp("apply/damage", a_damage);

  COMBAT_D->perform_attack(me, target, weapon);

  me->add_temp("apply/attack", -a_attack);
  me->add_temp("apply/damage", -a_damage);

  message_perform(BLINK + HIW " \n                                   『情恨』\n" NOR, me, target);
  msg = HIW "                     多情自古伤离别" HIB "－－－－" HIC "更那堪，冷落清秋节！\n" NOR;
  message_perform(msg, me, target);

  count = me->query("cps");  //嘿嘿....
  if (me->query("divorced"))  //嗯，离了
  {
    count = count * 2;
  }

  a_attack = count;
  a_damage = count / 2;

  me->add_temp("apply/attack", a_attack);
  me->add_temp("apply/damage", a_damage);

  COMBAT_D->perform_attack(me, target, weapon);

  me->add_temp("apply/attack", -a_attack);
  me->add_temp("apply/damage", -a_damage);

  if (LEVEL_D->query_level_index(LEVEL_D->query_ob_skill_level(me, "whip"))
    >= LEVEL_D->query_level_index(LEVEL_D->query_max_skill_level()) - 1) {
    success = 1;
    ap = COMBAT_D->combat_power(me, target, "whip", SKILL_USAGE_ATTACK);
    dp = COMBAT_D->combat_power(me, target, "parry", SKILL_USAGE_DEFENSE);
    if (0 >= COMBAT_D->perform_hit(ap, dp)) {
      success = 0;
    }

    ap2 = (int)me->query_per() * 12;
    dp2 = (int)target->query_cps() * 12;

    if ((success && random(ap2 + dp2) > dp2) || wizardp(me)) {
      message_perform(
        "\n" HIG "情思绵绵，" HIR "情痴深深，" HIW "情恨切切，" NOR + "$n想起昨日种种，不由魂断神伤！\n" NOR,
        me,
        target
      );

      for (int times = 0; times < 1 + random(level); times++) {
        target->set_temp("invoker", me);
        COMBAT_D->perform_attack(target, target, tar_weapon);
        target->set_temp("invoker", invoker);
      }

      target->start_busy(1);
    }

    message_perform(HIB "\n曲已终，月影散，唯有暗香仍盈袖，莫道不销魂！\n" NOR, me, target);
  }

  //下面设为月宫的最终级别pfm，不封上限，必中，
  if (LEVEL_D->query_level_index(LEVEL_D->query_ob_skill_level(me, "whip"))
    >= LEVEL_D->query_level_index(LEVEL_D->query_max_skill_level())) {
    if (!random(4) || wizardp(me)) {
      message_perform(HIC "\n纵然夏日炎，风霜险，积雪千年，也要等到那春到人间\n" NOR, me, target);
      message_perform(HIC "明知情思牵，情愁添，情火难遣，也要坚持这一身冷艳\n" NOR, me, target);

      damage = COMBAT_D->get_mydamage(
        me,
        0,
        0,
        me->query_entire_dbase(),
        target->query_entire_dbase(),
        TYPE_PERFORM
      );
      damage += (int)me->query_skill("whip", 1) / 10;
      damage = damage / 2 + random(damage / 2);
      damage = damage / 10 * 8;

      if (me->is_fighting() && target->is_fighting() && environment(me) == environment(target)) {
        target->receive_damage("sen", damage, me);
        target->receive_wound("sen", 1 + random(damage), me);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", 10 + random(damage), me);

        if (!target->is_busy()) {
          target->start_busy(1 + random(level));
        }

        COMBAT_D->report_status(target, 1, me, "kee");
        COMBAT_D->report_status(target, 1, me, "sen");
      }
    }
  }

  become_enemy(me, target);

  return 5 + level;
}

string skill_name(object me, object target, string skill) {
  return "爱有尽时";
}
