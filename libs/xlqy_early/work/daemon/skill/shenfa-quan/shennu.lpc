//【神罚拳】之【神怒】

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void shan_ok(object);

int perform(object me, object target) {
  int weapon, i;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「神怒」？\n");
  return notify_fail("这个Perform尚未实现！\n");
}
