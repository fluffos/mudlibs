// literate.c

#include <ansi.h>

inherit SKILL;

int query_npc_ignore() {
  return 1;
}

string type() { return "knowledge"; }

string level_description(int level) {
  int max_level;
  int grade;
  string *level_desc = ({
    BLU "一字不识" NOR,
    BLU "学童开蒙" NOR,
    BLU "初通文理" NOR,
    BLU "略知一二" NOR,
    HIB "照本宣科" NOR,
    HIB "知书达理" NOR,
    HIB "文采斐然" NOR,
    HIB "格物致知" NOR,
    YEL "博学多才" NOR,
    YEL "高才硕望" NOR,
    YEL "饱学鸿儒" NOR,
    YEL "出口成章" NOR,
    HIY "字字珠玑" NOR,
    HIY "才高八斗" NOR,
    HIY "学富五车" NOR,
    CYN "卓然大家" NOR,
    CYN "通古博今" NOR,
    HIC "学贯古今" NOR,
    HIC "一代文宗" NOR,
    HIW "浩然正气" NOR,
  });

  max_level = LEVEL_D->query_max_skills() * 2 / 3 / sizeof(level_desc);

  grade = level / max_level;

  if (grade >= sizeof(level_desc)) {
    grade = sizeof(level_desc) - 1;
  }

  return level_desc[grade];
}
