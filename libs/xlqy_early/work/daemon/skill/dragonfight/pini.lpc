//by flying@飘渺水云间

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
#include "/daemon/skill/eff_msg.h";

int def;
int is_drunk(object);
int perform6(object me, object target);
int perform7(object me, object target);
int perform8(object me, object target);

int perform(object me, object target) {
  string msg;
  int damage, p, time, i, j, k, extra;
  int damage_bonus, target_bonus, wound;
  object *enemy;
  int count;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail("龙行天下之「睥睨天下」只能在战斗中使用。\n");
  if (me->query("family/family_name") != "东海龙宫")
    return notify_fail("非龙宫弟子不能用龙行天下之「睥睨天下」！\n");
  if ((string)me->query("gender") != "男性")
    return notify_fail("这招至阳至刚，非男性不能用！\n");

  if ((int)me->query_skill("dragonfight", 1) > 199 && me->query("pini") == 1)     //new perform
  {
    if (!target) target = offensive_target(me);
    if (!target
      || !target->is_character()
      || !me->is_fighting(target))
      return notify_fail("不在战斗中，怎么使用龙行天下之「睥睨天下」？\n");
    if ((me->query("family/family_name") != "东海龙宫") && (!wizardp(me)))
      return notify_fail("你非我龙王弟子，怎能使用龙宫绝招?\n");
    if ((int)me->query("max_force") < 1000)
      return notify_fail("你的内功太差。\n");
    if ((int)me->query("force") < 1000)
      return notify_fail("你的内力不足！\n");
    if ((int)me->query("sen") < 500)
      return notify_fail("你的精神不足，没法子施用外功！\n");
    if (time() - me->query_temp("lxtx_end") < 7)
      return notify_fail("龙行天下之「睥睨天下」不能用得这么频繁！\n");
    me->set_temp("lxtx_end", time());
    me->add("force", -(500 + me->query("force_factor")));
    msg = HIY "$N深吸了一口气，突然跨上一步，右手探出抓向$n胸口。正是龙宫绝学「睥睨天下」的起手式。\n" NOR;
    msg += HIW "这招本化自潜龙勿用，看似平平，但似快而慢，实是威力巨大。\n" NOR;
    damage_bonus = (int)me->query_skill("unarmed");
    target_bonus = (int)target->query_skill("dodge");
    if (random(damage_bonus) > random(target_bonus * 2 / 3)) {
      //me->start_busy(1);
      //if(!target->is_busy())
      //target->start_busy(1);
      damage = 150 + (damage_bonus + random(damage_bonus));

      if (me->query_temp("lg_set")) damage += damage / 2;
      if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
      wound = damage - (int)target->query_temp("apply/armor");
      msg += HIR "$n躲闪不及，被$N抓住胸口，手臂振处，已被摔将出去。 \n" NOR;
      target->set_temp("last_damage_from", me);
      target->receive_damage("kee", damage, me);
      if (wound > 0) target->receive_wound("kee", wound, me);
      p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
      msg += COMBAT_D->damage_msg(damage, "内伤");
      msg += "( $n" + eff_status_msg(p) + " )\n";
    } else {
      msg += GRN "$n识得厉害，身形连闪，方才躲开了。\n" NOR;
      me->start_busy(1);
    }
    message_vision(msg, me, target);
    //call_out("perform6", 1, me, target);   
    perform6(me, target);

    return 1;
  } else

    return notify_fail("你还没学会用龙行天下之「睥睨天下」！\n");
}




int is_drunk(object me) {
  int limit = me->query("con") * 6 + (int)me->query("max_force") / 50;
  int duration = me->query_condition("drunk");
  if (duration > limit / 10) return 1;
  return 0;
}



int perform6(object me, object target) {
  string msg;
  int damage, p, time, i, j, k, extra;
  int damage_bonus, target_bonus, wound;
  object *enemy;
  int count;
  object weapon;
  //weapon = me->query_temp("weapon");  
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if (environment(me) != environment(target))
    return notify_fail("你想隔山打牛？\n");

  msg = HIY "$N冷笑一声，左手虚探，右手早就点向$n的肋部。\n" NOR;
  msg += HIW "$n惊魂未定，未及考虑，双手急分，一手护住自己肋部，一掌拍向$N前胸。\n" NOR;
  msg += HIC "$N眼看就要中招，突然左足踢出，竟是后发先至。\n" NOR;
  damage_bonus = (int)me->query("combat_exp");
  target_bonus = (int)target->query("combat_exp");
  if (damage_bonus / 2 + random(damage_bonus * 2 / 3) > random(target_bonus)) {
    //me->start_busy(1);
    //if(!target->is_busy())
    //target->start_busy(1);
    damage_bonus = (damage_bonus / 5000 + random(1500)) / 40;
    damage = 150 + (damage_bonus + random(damage_bonus));

    if (me->query_temp("lg_set")) damage += damage / 2;
    if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
    wound = random(damage - (int)target->query_temp("apply/armor"));
    msg += HIR "$n提气收腹，腰间仍然中了一脚，一个踉跄险些跌倒。 \n" NOR;
    target->set_temp("last_damage_from", me);
    target->receive_damage("kee", damage, me);
    if (wound > 0) target->receive_wound("kee", wound, me);
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += COMBAT_D->damage_msg(damage, "内伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
  } else {
    msg += GRN "$n闷哼一声，竟硬生生地横移开两寸，这才侥幸躲过这招。\n" NOR;
    me->start_busy(1);
  }
  message_vision(msg, me, target);
  //call_out("perform7", 1, me, target);   
  perform7(me, target);
  return 1;
}

int perform7(object me, object target) {
  string msg;
  int damage, p, time, i, j, k, extra, neili;
  int damage_bonus, target_bonus, wound;
  object *enemy;
  int count;
  object weapon;
  //weapon = me->query_temp("weapon");  
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if (environment(me) != environment(target))
    return notify_fail("你想隔山打牛？\n");

  msg = HIY "$N大喝道：着，挥掌凌空拍出，掌力疾吐，便如有一道无形的兵刃，击向$n胸口。\n" NOR;
  msg += HIW "这掌飘飘拍来，显然蕴有浑厚内力，$n不敢怠慢，回掌招架。两人内力相激，各自凝了凝神。\n" NOR;
  msg += HIC "$N赞道，好功夫。手中确是丝毫不慢，内力激荡，彭湃而出。\n" NOR;
  damage_bonus = (int)me->query_skill("force", 1);
  target_bonus = (int)target->query_skill("force", 1);
  neili = (int)me->query("max_force") / 500;
  for (i = 0; i * i <= neili; i++);
  if (i < 3)
    i = 3;
  if (!is_drunk(me))
    i = 3;
  if (wizardp(me)) tell_object(me, sprintf(GRN "i: %d\n" NOR, i));
  if (random(damage_bonus) * 3 / 4 + damage_bonus / 4 > random(target_bonus / 2)) {
    //me->start_busy(1);
    //if(!target->is_busy())
    //target->start_busy(1);
    damage = 150 + (damage_bonus + random(damage_bonus)) * (i - 2);

    if (me->query_temp("lg_set")) damage += damage / 2;
    if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
    wound = random(damage - (int)target->query_temp("apply/armor"));
    msg += HIR "$n登时抵受不住，噔噔噔退出三步，只觉内息紊乱，脸色惨白，显然受了内伤。 \n" NOR;
    target->set_temp("last_damage_from", me);
    target->receive_damage("kee", damage, me);
    if (wound > 0) {
      target->receive_wound("kee", wound, me);
      target->apply_condition(
        "dragon_wound",
        (int)target->query_condition("dragon_wound") + 10 + wound / 5
      );
    }
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += COMBAT_D->damage_msg(damage, "内伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
  } else {
    msg += GRN "$n暴喝一声，疾催内力，两人堪堪打了个平手。\n" NOR;
    me->start_busy(1);
  }
  message_vision(msg, me, target);
  //call_out("perform8", 1, me, target);   
  perform8(me, target);
  return 1;
}

int perform8(object me, object target) {
  string msg;
  int damage, p, time, i, j, k, extra, exp;
  int damage_bonus, target_bonus, wound;
  object *enemy;
  int count;
  object weapon;
  //weapon = me->query_temp("weapon");  
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if (environment(me) != environment(target))
    return notify_fail("你想隔山打牛？\n");

  //msg = HIY "$N虽是恶斗狠杀，但对敌人攻来的一招一式，却仍是凝神注视，心意丝毫不乱。\n" NOR;//萧峰的描述
  msg = HIY "只见一轮快攻过后，$n已经有点手忙脚乱。$N当即大步迈出，左手一划，右手呼的一掌,便向$n击去.\n" NOR;
  msg += HIW "$N出掌之时，与$n相距尚有十五六丈，但说到便到，力自掌生之际，两个相距已不过七八丈.\n" NOR;
  msg += HIW "$N一掌既出,又是一招“飞龙在天”，后掌推前掌，双掌力道并在一起，排山倒海的压将过来.\n" NOR;
  msg += HIC "只一瞬之间,$n便觉气息窒滞，对方掌力竟如怒潮狂涌，势不可当.\n" NOR;
  damage_bonus = (int)me->query_skill("unarmed", 1);
  target_bonus = (int)target->query_skill("unarmed", 1);
  exp = (int)me->query("combat_exp") / 800000;
  for (i = 0; i * i <= exp; i++);
  if (i < 2)
    i = 2;
  if (!is_drunk(me))                              //by flying at 2003.7.19
    i = 2;
  if (wizardp(me)) tell_object(me, sprintf(GRN "i: %d\n" NOR, i));
  if (random(damage_bonus) * 2 / 3 + damage_bonus / 3 > random(target_bonus / 2)) {
    //me->start_busy(1);
    //if(!target->is_busy())
    //target->start_busy(1);
    if (random(4) == 1 && is_drunk(me))                               //flying 2003.6.14
    {
      damage = 150 + (damage_bonus + random(damage_bonus)) * 2 * (i - 1);
      if (me->query_temp("lg_set")) damage += damage / 2;
      if (wizardp(me)) tell_object(me, sprintf(GRN "drunk damage: %d\n" NOR, damage));
      wound = random(damage - (int)target->query_temp("apply/armor") / 2) * 2;
    } else {
      damage = 150 + (damage_bonus + random(damage_bonus)) * (i - 1);
      if (me->query_temp("lg_set")) damage += damage / 2;
      if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
      wound = random(damage - (int)target->query_temp("apply/armor") / 2);
    }
    msg += HIR "$n不敢正面直撄其锋，右掌斜斜挥出，和$N掌力偏势一触，但觉右臂酸麻，胸中气息登时沉浊.喉头微微一甜。\n" NOR;
    target->set_temp("last_damage_from", me);
    target->receive_damage("kee", damage, me);
    if (wound > 0) {
      target->receive_wound("kee", wound, me);
      target->apply_condition(
        "dragon_wound",
        (int)target->query_condition("dragon_wound") + 10 + wound / 5
      );
    }
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += COMBAT_D->damage_msg(damage, "内伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
  } else {
    msg += GRN "$n一沾即走，乘势纵出三丈之外，竖掌当胸，以防后招。\n" NOR;
    me->start_busy(1);
  }
  message_vision(msg, me, target);
  if (random(4) == 1 && is_drunk(me)) {
    me->start_busy(1);
    if (!target->is_busy())
      target->start_busy(1);
    call_out("perform9", 1, me, target);
  } else
    me->start_busy(random(2) + 1);
  return 1;
}

int perform9(object me, object target) {
  string msg, str;
  int damage, p, time, i, j, k, extra, neili;
  int damage_bonus, target_bonus, wound, me_cor;
  object *enemy;
  int count;
  object weapon;
  //weapon = me->query_temp("weapon");  
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if (environment(me) != environment(target))
    return notify_fail("你想隔山打牛？\n");

  msg = HIY "$N本已力尽，谁知酒意上涌，内力激荡，竟呼的一掌，向$n击去。\n" NOR;
  msg += HIC "这招朴实无华，隐隐已有反朴归真的气度。\n" NOR;
  damage_bonus = (int)me->query_kar();
  target_bonus = (int)target->query_kar();
  me_cor = (int)me->query("cor");
  neili = (int)me->query("max_force") / 700;
  for (i = 0; i * i * i <= neili; i++);
  if (i < 2)
    i = 2;
  if (random(damage_bonus) + random(me_cor) > random(target_bonus / 2)) {
    //me->start_busy(1);
    if (!target->is_busy())
      target->start_busy(1);
    damage_bonus *= 7;
    damage = 150 + (damage_bonus + random(damage_bonus)) * 3 * (i - 1);
    if (me->query_temp("lg_set")) damage += damage / 2;
    if (me->query_temp("lg_set")) damage += damage / 2;
    if (wizardp(me)) tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
    wound = damage - (int)target->query_temp("apply/armor");
    msg += HIR "$n心存惧意，待要招架，掌力已及面门，登时被击飞出数丈之外。 \n" NOR;
    target->set_temp("last_damage_from", me);
    target->receive_damage("kee", damage, me);
    if (wound > 0) {
      target->receive_wound("kee", wound, me);
      target->apply_condition(
        "dragon_wound",
        (int)target->query_condition("dragon_wound") + 10 + wound / 5
      );
    }
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += COMBAT_D->damage_msg(damage, "内伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
  } else {
    msg += GRN "$n凝运内力，双掌齐出，堪堪接下这招。\n" NOR;
    me->start_busy(2);
  }
  message_vision(msg, me, target);
  if (target->query("kee") < 0 || !living(target)) {
    str = me->name() + "借烈酒之力，竟然使出了「" HIW "睥睨天下" NOR + HIM "」的最后一招。" + target->name() + "惊惶之下，被震断心脉而死！\n" NOR;
    message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());   //2003.7.1 by flying
  }
  return 1;
}
