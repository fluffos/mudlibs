#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    string msg;
    mixed myexp, hisexp;
    object weapon;
    int effect;

    if ( !target )
    {
        return notify_fail("你要对谁施展这一招「阴字诀」？\n");
    }

    limit_status["sen"] = 100;
    limit_status["force"] = 150;
    limit_status["max_force"] = 500;

    limit_skills["liangyi-sword"] = 100;

    if ( !can_perform(me, "方寸山三星洞") )
    {
        return 0;
    }

    if ( me->is_busy() )
    {
        return notify_fail("你现在没空！！\n");
    }

    if ( target->is_busy() )
    {
        return notify_fail(target->name() + "已经手忙脚乱了，你使的再漂亮也不会注意到。\n");
    }

    me->add("force", -100);
    me->receive_damage("sen", 100);

    weapon = target->query_temp("weapon");

    myexp = COMBAT_D->exp_power(me, target, SKILL_USAGE_ATTACK);
    hisexp = COMBAT_D->exp_power(me, target, SKILL_USAGE_DEFENSE);

    if ( weapon )
    {
        myexp = COMBAT_D->power_mul(myexp, 5);
        myexp = COMBAT_D->power_div(myexp, 8);
    }
    else
    {
        myexp = COMBAT_D->power_mul(myexp, 2);
        myexp = COMBAT_D->power_div(myexp, 3);
    }

    message_perform(HIB "\n\n$N使出一式两仪剑法中的［阴字诀］，手中" + (me->query_temp("weapon"))->name() +
        "抖出无数大大小小剑圈，将$n越缠越紧，逼的$n一阵手忙脚乱！\n\n" NOR, me, target);

    if ( 0 < COMBAT_D->perform_hit(myexp, hisexp) )
    {
        effect = LEVEL_D->query_level_index(LEVEL_D->query_ob_skill_level(me, "sword"));
        effect = LEVEL_D->query_max_level_index() - effect;

        if ( !random(effect) && weapon )
        {
            break_equip(me, target, weapon);
        }

        target->start_busy(4 + random(3));
    }
    else 
    {
        message_perform(HIB "\n$n不为所惑，站了个马步，凝神拆招！\n" NOR, me, target);
    }

    me->improve_skill("liangyi-sword", 1, 1);

    return 1 + random(2);
}

string skill_name(object me, object target, string skill)
{
    return "阴字诀";
}

