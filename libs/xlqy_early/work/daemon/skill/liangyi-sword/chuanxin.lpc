#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  string msg;
  mixed myexp, hisexp;
  object weapon;

  if (!target) {
    return notify_fail("你要对谁施展这一招「穿心剑」？\n");
  }

  limit_status["sen"] = 100;
  limit_status["force"] = 1000;
  limit_status["max_force"] = 500;

  limit_skills["liangyi-sword"] = 60;
  limit_skills["wuxiangforce"] = 60;

  if (!can_perform(me, "方寸山三星洞")) {
    return 0;
  }

  if (!me->query_temp("weapon")) {
    return notify_fail("掌中无剑，怎能用穿心剑!\n");
  }

  myexp = COMBAT_D->exp_power(me, target, SKILL_USAGE_ATTACK);
  hisexp = COMBAT_D->exp_power(me, target, SKILL_USAGE_DEFENSE);

  msg = WHT "\n$N一声长笑，随空斜斜刺出毫无章法的一剑!\n$n一楞之间,那剑却快如闪电的刺向$n的心脏!!\n\n" NOR;
  message_perform(msg, me, target);

  if (0 < COMBAT_D->perform_hit(myexp, hisexp)) {
    msg = HIR "\n只听$n一声惨嚎,$N的剑已经穿心而过!!\n" NOR;
    message_perform(msg, me, target);
    target->start_busy(1 + random(2));
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
  } else {
    msg = HIR "\n$n就地一滚，闪过这毒辣的穿心一剑。\n" NOR;
    message_perform(msg, me, target);
  }

  me->add("force", -100);

  return 3 + random(3);
}

string skill_name(object me, object target, string skill) {
  return "穿心剑";
}
