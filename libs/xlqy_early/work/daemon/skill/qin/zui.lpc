#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int check(object me, object weapon,object where,int lv);
int checking(object me,object weapon,object where,int lv);
int calculate_damage(object me, object target, int base_damage, int damge_bonus);
int go_sleep(object target);
string *play_msg=({
HIB"$N曲调突转，缓缓的变得柔靡万端，恰如昆岗凤鸣，深闺私语。\n" NOR,
HIY"但听得琴声连绵不断，越来越是明彻，忽高忽低，愈变愈奇，实在美妙之极，柔媚之音萦绕耳际。\n" NOR,
HIG"$N奏到清羽之音，只听得琴声越拔越高，愈弹愈是回肠荡气。\n"NOR,
HIM"琴声忽高忽低，忽前忽後，忽焉在西，倏尔在南，似乎有十多人伏在四周，此起彼伏的奏琴戏弄一般。\n" NOR,
HIR"琴声情致飘忽，缠绵宛转，便似一个女子一会儿叹息，一会儿呻吟，一会儿又软语温存、柔声叫唤。\n"NOR,//180 music
CYN"琴声调子陡变，似浅笑，似低诉，柔靡万端。\n" NOR,//210 music
HIC"曲调比适才更加勾魂引魄，柔媚宛转，轻轻细细的耍了两个花腔。\n"NOR,//240 music
HIW"琴声忽停，四下阒无声息，一音袅袅，曲终音歇。\n" NOR,
BLINK+MAG"琴韵突又响起。曲调柔和之至，宛如朝露暗润花瓣，晓风低拂柳梢。\n\n\n"NOR,             //必杀，哈
});
string *hit_msg=({
"$N心头一荡，脸上不自禁的露出微笑，只感全身热血沸腾，就只想手舞足蹈的乱动一番，方才舒服。\n",
"$N听了片刻琴声，自制之力渐失，不由自主的婆娑起舞......\n",
"$N觉得全身飘飘欲仙，脸上露出迷惘而满足的神情，情不自禁的手舞足蹈起来......\n",
"但听得琴声流转，$N再也忍耐不住，跟著箫声翩翩起舞......\n",
});
string *miss_msg=({
"总算$N功力精湛，心头尚有一念清明，硬生生把伸出去挥袖舞蹈的手缩了回来。\n",
"$N盘膝坐在地下，低头行功，奋力抵御琴声的引诱。\n",
"$N刚想随着琴声伸手踢足，立时惊觉，潜运内息，竭力镇摄心神。\n",
"$N盘膝而坐，数次身子已伸起尺许，终于还是以极大的定力坐了下来。\n",
});
int perform(object me)
{
      string msg;
 	object *enemy,where,weapon;
 	 int count,lv;
 //	if(!wizardp(me))
//	return 0;
 	if(me->query("family/family_name")!="盘丝洞")
               return notify_fail("非盘丝洞不能使用此项技能！\n");

        if(!me->is_fighting())
                return notify_fail("「醉生梦死」只能在战斗中使用！\n");
                
          if(me->query_temp("QIN/play_zui"))
                return notify_fail("你正在弹奏「醉生梦死」曲。\n");   
                    
        if( me->query_skill("music",1) < 180)
               return notify_fail("你的音律乐理等级不够，尚未领悟到这个绝招！\n");
         if( me->query_skill("qin",1) < 180)
               return notify_fail("你的琴艺等级不够，尚未领悟到这个绝招！\n");
         if( me->query_skill("pansi-dafa",1) < 150)
               return notify_fail("你的盘丝大法修为不够，尚未领悟到这个绝招！\n");
          if( me->query_skill("jiuyin-xinjing",1) < 150)
               return notify_fail("你的九阴心经等级不够，尚未领悟到这个绝招！\n");
        if(me->query("kee")<333)
               return notify_fail("你的体力太差了，不能使用「醉生梦死」！\n");
          if(me->query("sen")<333)
               return notify_fail("你的精神太差了，不能使用「醉生梦死」！\n");
        if(me->query("force")<666)
               return notify_fail("你的内力不够，无法发出「醉生梦死」！\n");
        if(me->query("mana")<666)
               return notify_fail("你的法力不够，无法发出「醉生梦死」！\n");
        if(me->query_temp("no_pansi_zuitime")>time())
			return notify_fail("你不能连续使用「醉生梦死」！\n");
	
	        lv=1;
	   if(me->query("skill_level/music")=="expert")
	   	lv=2;
	   else if(me->query("skill_level/music")=="master")
	   	lv=3;
	   else if (me->query("skill_level/music")=="grandmaster")
	   	lv=4;
	me->set_temp("no_pansi_zuitime",time()+random(5)+24/lv);
      me->add("force", -100);
     
      me->set_temp("QIN/play_zui",1);
      me->set_temp("no_move",1);  
      where=environment(me);
      weapon = me->query_temp("weapon");

        message_vision(MAG"\n$N微微一笑，俯首调了调"+weapon->name()+MAG"弦，盘腿就地而坐，开始弹奏「醉生梦死」曲。\n\n\n"NOR, me);
        message_vision(HIC"突然之间，半空中如破竹，如击玉，发了几声，接着悠悠扬扬，飘下一阵清亮柔和的古琴声来。\n"NOR,me);
      // call_out("check", 1, me, weapon,where,lv);
       check(me,weapon,where,lv);
      
        return 1;
}


int check(object me, object weapon,object where,int lv)
{
        string msg;
        object wep;
        object *enemy,nowwhere;
 	int i,count;
 	 
       enemy=me->query_enemy();
       count=sizeof(enemy);
       nowwhere=environment(me);
       i=me->query_temp("QIN/play_zui");
       
        if (!me) return 1;
        if(!me->query_temp("QIN/play_zui")) return 1;

        if(!living(me) ){

		me->delete_temp("no_move");
        me->delete_temp("QIN/play_zui");
           return 1;
        }
        if(nowwhere!=where)
        {
		if( !me->is_busy() ) me->start_busy(2+random(2));	

	   	me->delete_temp("no_move");
          me->delete_temp("QIN/play_zui");
           return 1;	
        	
        }
         if(!me->is_fighting())
         {
       
			 tell_object(me,"四下并无敌人，无需再弹奏醉生梦死曲了。\n");
		if( !me->is_busy() ) me->start_busy(2+random(3));	

	   	  me->delete_temp("no_move");
          me->delete_temp("QIN/play_zui");

           return 1;		
        }
	   	
      
        if(!objectp(wep = me->query_temp("weapon")) || wep->query("skill_type") != "music"){
           if(!wep)msg = HIY"$N手中古琴已失，无法继续弹奏醉生梦死曲，众人不禁长舒了口气。\n"NOR;
           else  msg = HIY"$N突然亮出"+wep->name()+HIY"停止弹奏醉生梦死曲，漫天魔音顿时消散，众人都长舒了一口气！\n"NOR;
          
         message_vision(msg, me);
		if( !me->is_busy() ) me->start_busy(2+random(3));	

	   	  me->delete_temp("no_move");
          me->delete_temp("QIN/play_zui");

           return 1;
           } 
     
        if(wep != weapon){
           message_vision(HIY"$N换了具古琴，曲子顿失连贯，无法继续弹奏下去，魔音威力骤减！\n"NOR,me);

		if( !me->is_busy() ) me->start_busy(2+random(3));	

	   	  me->delete_temp("no_move");
          me->delete_temp("QIN/play_zui");
    
              return 1;
              }
          
         
       if (userp(me) && (me->query_skill_mapped("force") != "jiuyin-xinjing" || me->query_skill_mapped("music") != "qin"|| me->query_skill_mapped("spells") != "pansi-dafa")){
          tell_object(me,"你使用的功夫和醉生梦死的境界相孛，无法继续弹奏下去！\n");

		if( !me->is_busy() ) me->start_busy(2+random(3));	

	   	  me->delete_temp("no_move");
          me->delete_temp("QIN/play_zui");

           return 1;
           }   
       if(i==1||i==3||i==5||i==7)
       {
	       if( me->query("force") <= me->query_skill("qin", 1)/2 ){
	           message_vision(HIY"$N弹奏的速度越来越慢，魔音威力大减，原来是真气不足了！\n"NOR,me);
	           
		 me->set_temp("QIN/play_zui",9);
		   
		   checking(me, weapon,nowwhere,lv);

			   return 1;
	           }    
	        
        }
         if(i==2||i==4||i==6||i==8)
       {   
	       if( me->query("mana") <= me->query_skill("qin", 1)/2 ){
	           message_vision(HIY"$N弹奏的速度越来越慢，魔音威力大减，原来是法力不足了！\n"NOR,me);
	           
		 me->set_temp("QIN/play_zui",9);
		   
		   checking(me, weapon,nowwhere,lv);

			   return 1;
	           } 
	      
        }    
          
       if(!me->is_busy() ){
 			 if(me->query_temp("QIN/play_zui")<5&&me->query_temp("QIN/play_zui")>0)
 				 me->add_temp("QIN/play_zui",1);
 			 else if(me->query_skill("music",1)>210&&me->query_temp("QIN/play_zui")==5)
	 			me->add_temp("QIN/play_zui",1);
			 else if(me->query_skill("music",1)>240&&me->query_temp("QIN/play_zui")==6)
	 			me->add_temp("QIN/play_zui",1);
			 else if(me->query_skill("music",1)>280&&me->query_temp("QIN/play_zui")==7)
	 			me->add_temp("QIN/play_zui",1);
			else me->set_temp("QIN/play_zui",9);
 			 checking(me, weapon,nowwhere,lv);
 			
          }
       else {
	// call_out("check", 1, me, weapon,where,lv);
	 check(me, weapon,where,lv);
       }
       return 1;
}       


int checking(object me,object weapon,object where,int lv)
{
	
        string msg;
        object *enemy;
        int count,i;
        int cost,success,base_damage,damage,bonus,armor;
        
        int ap, ap2, dp, dp2, pp;
		int myforce,mymana,yourforce,qin,music;

	 enemy=me->query_enemy();
         count=sizeof(enemy);
         i=me->query_temp("QIN/play_zui");
         cost = 24*i;
          
       
        
        base_damage=(10+lv)*i;
       
        qin=me->query_skill("qin",1);
        music=me->query_skill("music",1);

        success=0;
        
        
      if(i<9)
      {  
	      	me->add("force", -cost);
	        me->add("mana",-cost);
	      	 message_vision(play_msg[i-2],me);
	        for(int j=0;j<count;j++)
	        {
	               
			if(!living(enemy[j]))           //it can't listen your music after all....
					continue;
			if(!enemy[j])	continue;
			if(environment(enemy[j]) != environment(me))	continue;
			myforce=me->query("max_force");
			mymana=me->query("max_mana");
			yourforce=enemy[j]->query("max_force");

			ap = qin;
			ap = (ap/10 * ap) * ap/100;
			ap += (int)me->query("combat_exp")/100;
			dp = enemy[j]->query("combat_exp")/100;
			ap2=COMBAT_D->skill_power(me, "music", SKILL_USAGE_ATTACK)/100;
			dp2=COMBAT_D->skill_power(enemy[j],"dodge", SKILL_USAGE_DEFENSE)/110;
		//	dp2/=3;			  
			pp=COMBAT_D->skill_power(enemy[j],"parry", SKILL_USAGE_DEFENSE)/110;
		//	pp/=2;		
			if (dp < 1) dp = 1;
			if(pp<1)  pp=1;
		if(wizardp(me)||wizardp(enemy[j]))
		{
			printf("the resa is %d\n",ap+dp+ap2+dp2);
			
			printf("the resa is %d\n",dp+dp2);
			printf("the resa is %d\n",ap2+pp);
			printf("the resa is %d\n",pp);
			
		}
		
	       	if( random(ap+dp+ap2+dp2)>(dp+dp2)&&random(ap2+pp)>pp)
					success=2;
	        	else if(random(myforce/2+mymana/3)>random(yourforce/2)) success=1;
 				else success=0;
	        	bonus=0;
	        	bonus=me->query("per")-random(enemy[j]->query("cps"))+me->query_spi()-random(enemy[j]->query_con());
	        	if( bonus < 5 )	bonus=5;
	        	bonus=bonus*(qin/36+12);
	        	bonus=bonus*lv/7;
	        	bonus+=me->query_temp("apply/damage")/3+random(me->query_temp("apply/damage")/3);
	        	
	        	damage=calculate_damage(me,enemy[j],base_damage,bonus);
		       	armor=enemy[j]->query("mana_factor")/2+random(enemy[j]->query("mana_factor")*2/3);
	        	
	        	
				
				if(success==2&&damage>0){          
		         
			          msg = hit_msg[random(sizeof(hit_msg))];
			          message_vision(msg,  enemy[j]);
			          enemy[j]->receive_damage("sen", damage,me,"magic");
					  enemy[j]->add_temp("QIN/hited",2);
			          if(random(damage)>armor)
			       		  enemy[j]->receive_wound("sen",damage-armor,me);
			        
			       COMBAT_D->report_sen_status( enemy[j]); 
				if(!enemy[j]->is_busy()) enemy[j]->start_busy(1+random(2));   
		          }
		        else if(success==1){ 
		        
			          msg = miss_msg[random(sizeof(miss_msg))];
			         
			          message_vision(msg,  enemy[j]);
			           
			                 enemy[j]->add("force",-damage/4- random(damage/4));
				         if( enemy[j]->query("force")<0)  enemy[j]->set("force",0);
				        
				          enemy[j]->add("mana",-damage/4- random(damage/4));
				         if( enemy[j]->query("mana")<0)  enemy[j]->set("mana",0);
				     	
				  enemy[j]->add_temp("QIN/hited",1);
				  if(!enemy[j]->is_busy()) enemy[j]->start_busy(random(2));
	          }
		         else {
		          msg ="$N宁定心神，心中一片空明，不着片尘，任你琴声再荡，听来只与海中波涛、树梢风响一般无异。\n";
		          message_vision(msg,  enemy[j]);	
	         
		        }
		}
	//   call_out("check", 1, me, weapon,where,lv);
		check(me, weapon,where,lv);
	}  
	  else if(i==9)
	  {
	      	 message_vision(play_msg[7],me);
			 
			 
		for(int j=0;j<count;j++)
		{
			
			if(!living(enemy[j]))	continue;
			if(!enemy[j])	continue;
					if(enemy[j]->query_temp("QIN/hited")>9)
					{
					   if(!enemy[j]->is_busy())
		         			enemy[j]->start_busy(1+random(3));
					   msg=HIY"$N不由得心驰神醉，失魂落魄的呆立在一旁。\n"NOR;
					  message_vision(msg,  enemy[j]);	

					}
				enemy[j]->delete_temp("QIN/hited");
		 }
	       
	 if(me->query_skill("music")>300&&random(me->query_kar())>36&&!random(360/lv)||wizardp(me))
	        {
	        		
				message_vision(HIG "\n$N脸上露出恐惧之色，"+ weapon->query("name")+ HIG"竟然不听使唤，刹那间魔音大震！\n\n\n"NOR,me);
				message_vision(play_msg[8],me);	
				 for(int j=0;j<count;j++)
				{
				if(!enemy[j])	continue;
				
				  enemy[j]->receive_damage("sen", enemy[j]->query("max_force")/2+enemy[j]->query("max_mana")/2,me);
				  enemy[j]->receive_wound("sen",enemy[j]->query("max_force")/2+enemy[j]->query("max_mana")/2,me);
			     	 call_out("go_sleep",3,enemy[j]);   
			  	 COMBAT_D->report_sen_status( enemy[j]); 	
				}
				
				me->delete_temp("no_move");
				if( !me->is_busy() ) me->start_busy(3);	
				me->delete_temp("QIN/play_zui");
	      		  return 1;	
	        }	
	       
	        	me->delete_temp("no_move");
	        	if( !me->is_busy() ) me->start_busy(2+random(3));	
	        	me->delete_temp("QIN/play_zui");
	        	return 1;
	      	
  
        }   
       return 1;
}       
int calculate_damage(object me, object target, int base_damage, int damage_bonus)
{
	int damage;
	int myexp, youexp;
	
	damage=base_damage+damage_bonus/5+random(damage_bonus)*base_damage/81;
	
	damage+=me->query("force_factor")/2+me->query("mana_factor")/2-random(target->query("force_factor"));
	myexp=me->query("combat_exp");
	youexp=target->query("combat_exp");
	while(random(youexp/2)>myexp) {
		damage-=damage/3;	
		youexp /= 2;
	}
	if (wizardp(me) ||wizardp(target))
		tell_object(me, sprintf(HIC "damage: %d\n" NOR, damage));
	if(damage < 0) damage = 0;
	damage=damage*8/10;
	return damage;
}
int go_sleep(object target)
{
	string msg;
	 msg =  HIM"\n$N"+HIM"听不多时，眼皮便越来越沉重，虽竭力凝神，却终是难以抗拒睡魔，不久眼皮合拢，再也睁不开来。\n"NOR;
	 if(!target)	return 1;
	 if(!living(target))	return 1;
	            	message_vision(msg,target);
	            	
		         target->set_temp("force_sleep",1);
	  		if(target->is_fighting()) target->command_function("surrender");
	  		
	  		if (!target->command("sleep")) 
	  	{	message_vision(HIM"\n$N"+HIM"晃了晃脑袋，似乎清醒了不少，终于又把眼睛睁开了，全身却酸软无力。\n"NOR,target);
			target->start_busy(5+random(5));	      
		}
	           	target->delete_temp("force_sleep");	
	
	return 1;
}


