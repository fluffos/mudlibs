#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
    mapping con;
    string *conlist;
    string level, name;
    int effect;

    if ( !target || !target->is_character() || target->is_corpse() )
    {
        //return notify_fail("你想替谁解除五行之毒？\n");
        target = me;
    }

    limit_status["mana"] = 1000;
    limit_status["sen"] = 300;
    limit_status["kee"] = 300;

    limit_skills["spells"] = 100;

    if ( !can_cast(me) )
    {
        return 0;
    }

    if ( (int)target->is_busy() )
    {
        return notify_fail("人家正忙着呢。\n");
    }

    if ( (int)target->is_fighting() )
    {
        return notify_fail("人家正忙着呢。\n");
    }

    con = target->query_entire_conditions();

    if ( !mapp(con) )
    {
        return notify_fail(target->name() + "并未受到任何五行之毒。\n");
    }

    if ( random((int)me->query_skill("spells")) < 13 )
    {
        message_cast( HIY "$N突然脸色苍白，似乎体力不支，竟呕出一口血来……\n"NOR, me );
        me->add("maximum_mana", -3);
        me->add("max_mana", -3);   
        return 5 + random(5);
    }

    conlist = keys(con);
    for ( int i = 0; i < sizeof(conlist); i++ )
    {
        level = conlist[i];

        switch ( level )
        {
            case "illness_poison":
                effect = target->query_temp("wuxing_poison/illness_point");
                target->add_temp("apply/attack", effect);
                target->add_temp("apply/defense", effect);
                target->delete_temp("wuxing_poison/illness_point");
                name = "五行毒之疾病";
                break;

            case "weakness_poison":
                effect = target->query_temp("wuxing_poison/weakness_point");
                target->add_temp("apply/attack", effect);
                target->add_temp("apply/strength", effect);
                target->delete_temp("wuxing_poison/weakness_point");
                name = "五行毒之虚弱";
                break;

            case "madness_poison":
                effect = target->query_temp("wuxing_poison/madness_point");
                target->add_temp("apply/attack", effect);
                target->add_temp("apply/defense", effect);
                target->delete_temp("wuxing_poison/madness_point");
                effect = target->query_temp("wuxing_poison/madness_str");
                target->add_temp("apply/strength", -effect);
                target->delete_temp("wuxing_poison/madness_str");
                name = "五行毒之疯狂";
                break;

            case "fearness_poison":
                effect = target->query_temp("wuxing_poison/fearness_point");
                target->add_temp("apply/courage", effect);
                target->delete_temp("wuxing_poison/fearness_point");
                name = "五行毒之恐惧";
                break;

            case "curse_poison":
                effect = target->query_temp("wuxing_poison/sub_bless");
                target->add_temp("combat/bless", effect);
                target->delete_temp("wuxing_poison/sub_bless");
                name = "五行毒之诅咒";
                break;

            case "unlucky_poison":
                effect = target->query_temp("wuxing_poison/sub_lucky");
                target->add_temp("combat/lucky", effect);
                target->delete_temp("wuxing_poison/sub_lucky");
                name = "五行毒之厄运";
                break;

            case "stoner_poison":
                effect = target->query_temp("wuxing_poison/stoner_point");
                target->add_temp("apply/dodge", effect);
                target->add_temp("apply/parry", effect);
                target->delete_temp("wuxing_poison/stoner_point");
                name = "五行毒之虚石化";
                break;

            default:
                continue;
                break;
        }

        message_cast(HIM"$N俯首闭目，十指虚合做兰花状，默运神通，脸上渐渐散发出圣洁的光芒！\n" NOR, me);

        tell_object(target, WHT"你沐浴在那柔和如皎月光芒下，觉得心中和平喜乐，渐渐的神游物外...\n"NOR);
        tell_object(target, HIG"你所受的" + name + "已经消除了！\n"NOR);

        target->clear_condition(level);
        //target->set_temp("force_sleep", 1);
        //target->command_function("sleep");
        //target->delete_temp("force_sleep");

        me->add("mana", -360);

        /*if ( me->is_fighting() )
        {
            me->start_busy(3);
        }*/

        return 5 + random(5); 
    }   

    return notify_fail(target->name() + "并未受到任何五行之毒。\n");
}

