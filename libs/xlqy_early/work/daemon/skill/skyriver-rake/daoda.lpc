#include <ansi.h>
#include <combat.h> 

inherit F_DBASE;
inherit FAMILYSKILL;
 
int perform(object me, object target)
{
    int skill;
    mixed ap, dp;
    int success;
    int mydodge, hedodge;
    object weapon = me->query_temp("weapon"); 

    if ( !me->is_fighting() )
    {
        return notify_fail("没事你抱着耙子乱窜干嘛？\n");
    }

    if ( !target )
    {
        return notify_fail("你要吓唬谁？\n");
    }

    limit_status["sen"] = 100;
    limit_status["force"] = 300;
    limit_status["max_force"] = 500;

    if ( !can_perform(me, "方寸山三星洞") )
    {
        return 0;
    }

    if ( target->is_busy() )
    {
        return notify_fail("对方已经自顾不暇啦，你就不要吓唬人家了。\n");
    }

    skill = me->query_skill("rake");       
    mydodge = me->query_skill("dodge");
    hedodge = target->query_skill("dodge"); 

    if ( skill< 150 )
    {
        return notify_fail("你握耙子手还不够稳，施展不出倒打一耙。\n");
    }

    me->add("force", -200);

    message_perform(HIY"激战之中，$N突然倒扛起手中的" + weapon->name() + HIY"哼哧哼哧准备开溜！\n"NOR, me);

    ap = COMBAT_D->skill_power(me, target, "rake", SKILL_USAGE_ATTACK);
    dp = COMBAT_D->skill_power(me, target, "parry", SKILL_USAGE_DEFENSE);

    ap = COMBAT_D->power_mul(ap, me->query("cor"));
    ap = COMBAT_D->power_div(ap, 15);

    dp = COMBAT_D->power_mul(dp, me->query("cps"));
    dp = COMBAT_D->power_div(dp, 40);

    if ( 0 < COMBAT_D->perform_hit(ap, dp) || random(13) == 6 )
    {
        message_perform("$N一愣之下，以为有机可乘，撒步上前追去！\n", target, me);
        message_perform(HIR"$N倒拖钉耙，突的反身一击，打了$n一个大大的措手不及！\n"NOR, me, target);

        target->start_busy(3 + random(2));

        me->add_temp("apply/sub_max_armor", skill * 5);
        me->add_temp("apply/sub_max_defense",skill * 5);	
        me->add_temp("apply/damage", skill / 5);	

        COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

        me->add_temp("apply/sub_max_armor", -skill * 5);
        me->add_temp("apply/sub_max_defense", -skill * 5);	
        me->add_temp("apply/damage", -skill / 5);	
    }
    else 
    {
        message_perform("$N早已识破$n的诡计，身形一晃拦在了$n的面前，让$n欲攻不能，欲退不得！\n", target, me);
    }

    return 3 + random(3);
}

string skill_name(object me, object target, string skill)
{
    return "倒打一耙";
}

