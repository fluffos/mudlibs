inherit SKILL;

string *dodge_msg = ({
        "$n不进不退，身形只是微微一转，顿然成风而过从$N身边掠过。\n",
        "可是$N眼前一花，居然连$n的影子都找不着了。\n原来$n从你头上飘过，到了你的后方。\n",
        "$n右脚踏了个追风步，双腿一抖，顿时腾空而起，居然从$N头顶越了过去。\n",
        "$n左足一顿，身形垂下，好象在地上钻洞一班，神不知鬼不觉的站在了$N身后。\n",
        "但是$n不慌不忙，身子如行云流水般往后一飘...再一飘，早避到了五尺开外。\n",
        "可是$n腰身微耸，顺势一掌按在有力无力之处，\n便如沾在$N这招上的一团轻絮，悠闲自得地将其化解。\n",
  });

int valid_enable(string usage)
{
        return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
        if( (int)me->query("max_force") < 0 )
                return notify_fail("你的内力不够，没有办法学追风步。\n");

        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30)
                return notify_fail("你现在太虚弱，练追风步当心摔死。\n");
        if((int)me->query("force") < 3 )
                return notify_fail("你现在内力不够，不能御风而起。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        return 1;
}

