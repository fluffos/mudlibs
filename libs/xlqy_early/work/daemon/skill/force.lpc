#include <ansi.h>

inherit NEWSKILL;

int valid_learn(object me) {
  return 1;
}

string exert_function_file(string func) {
  return __DIR__ "force/" + func;
}

string level_description(int level) {
  int max_level;
  int grade;
  string *level_desc = ({
    BLU "堪堪得气" NOR,
    BLU "若有若无" NOR,
    BLU "初窥门径" NOR,
    HIB "初窥堂奥" NOR,
    HIB "登堂入室" NOR,
    HIB "渐入佳境" NOR,
    YEL "气息悠长" NOR,
    YEL "生生不绝" NOR,
    YEL "英华内敛" NOR,
    YEL "通关在即" NOR,
    HIY "豁然贯通" NOR,
    HIY "隔山打牛" NOR,
    HIY "排山倒海" NOR,
    CYN "生死玄关" NOR,
    CYN "阴阳互济" NOR,
    CYN "举世无双" NOR,
    HIC "震古铄今" NOR,
    HIC "臻入化境" NOR,
    HIC "见神不坏" NOR,
    HIW "深不可测" NOR,
  });

  max_level = LEVEL_D->query_max_skills() * 2 / 3 / sizeof(level_desc);

  grade = level / max_level;

  if (grade >= sizeof(level_desc)) {
    grade = sizeof(level_desc) - 1;
  }

  return level_desc[grade];
}
