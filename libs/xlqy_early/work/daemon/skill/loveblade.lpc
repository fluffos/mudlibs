// darksword 【暗黑蚀魂剑】
// 给雪拉炫耀炫耀的技能

inherit SKILL;
#include <ansi.h>


mapping *action = ({
  ([ "action":
    "$N手中$w发出幽幽的暗红色光芒，接着一道灼热的剑气直射$n，正是一招" + RED "「魔焰气」" NOR,
    "dodge": 0,
    "parry": -10,
    "damage": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手中$w发出幽幽的湖蓝色光芒，接着一道冰凉的剑气直射$n，正是一招" + BLU "「鬼幽流」" NOR,
    "dodge": 0,
    "parry": -10,
    "damage": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N一招" + MAG "「十邪散魂」" NOR + "，$w上怨念密布，剑体未到，已闻诅咒",
    "dodge": 0,
    "parry": 0,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N一招" + RED "「千魔蚀日」，" NOR + "$w所到之处，顿时一片昏暗，$n猛地发觉剑尖已到$l",
    "dodge": -10,
    "parry": -10,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手中$w急颤，使出" + HIB "「魔天降临」" NOR + "，$w幻作一片黑云，从$n头顶压落",
    "dodge": 0,
    "parry": 0,
    "damage": 30,
    "damage_type": "砍伤"
  ]),
  ([ "action":
    "$N一晃手中$w，连发三道弧形剑气，朝$n疾飞而去，这招名曰" + HIY "「镇魂之歌」" NOR,
    "dodge": -10,
    "parry": -10,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N使出暗黑蚀魂剑的至强招式" + HIR "「天诛地灭」" NOR + "，\n手中$w裹着一股无所不摧的力量，直袭$n",
    "dodge": 0,
    "parry": -10,
    "damage": 50,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N使出暗黑蚀魂剑的至杀招式" + HIR "「无尽黑夜」" NOR + "，手中$w如带有万千魔魂，\n黑暗顿时笼罩$n的全身",
    "dodge": -20,
    "parry": -20,
    "damage": 40,
    "damage_type": "刺伤"
  ]),
});


int valid_enable(string usage) {
  return usage == "blade" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法学习暗黑蚀魂剑。\n");

  if ((string)me->query_skill_mapped("force") != "wanxi-force")
    return notify_fail("暗黑蚀魂剑必须配合万息集气术才能学习。\n");

  if ((string)me->query_skill_mapped("spells") != "wanxi-spells")
    return notify_fail("暗黑蚀魂剑必须配合万息降临法才能学习。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能学习剑法。\n");

  return 1;
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习暗黑蚀魂剑。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著师父所授诀窍练了一遍暗黑蚀魂剑。\n");
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("hsl/hsl_magic") + "/darksword/" + func;
}
