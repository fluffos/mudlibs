// by bugbug & alading @ 缥缈水云间, 2003-4-5
//Cracked by Roath

//Ansi 99.12
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int ap, dp, damage, chance;
  string msg;
  string lv, lvv;
  object weapon;

  lv = me->query("skill_level/sword");
  lvv = me->query("skill_level/dodge");
  if (!target) target = offensive_target(me);
  weapon = me->query_temp("weapon");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「断水无痕」？\n");

  if (!me->is_fighting())
    return notify_fail("「断水无痕」只能在战斗中使用！\n");
  if (me->query("family/family_name") != "蜀山剑派")
    return notify_fail("不是蜀山的不能用「断水无痕」！\n");
  if (me->query("shushan/duanshui_master") != 1)
    return notify_fail("你还没领会「断水无痕」！\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 300)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("shushan-jianfa", 1) < 100)
    return notify_fail("你的蜀山剑法修为还不够，使用这一招会有困难！\n");


  msg = BLINK + HIY "\n$N手腕晃动如疾风，以砍断三千尺飞流的速度，直逼$n！\n" NOR;
  ap = me->query_skill("sword") / 10;
  ap = ap * ap * ap / 5;
  dp = target->query("combat_exp") / 100;

  chance = (random(ap + dp) * 100 / dp);
  if (me->query_temp("shushan_set")) chance += chance / 2;

  if (wizardp(me) && me->query("env/combat") == (string)"verbose")
    tell_object(me, sprintf("chance:%d,ap:%d,dp:%d\n", chance, ap, dp));

  if (target->is_busy()) chance *= 2;
  if (chance > 40) {
    damage = me->query_skill("sword") + me->query("force_factor");
    damage += random(damage);
    if (lv) {
      damage = damage + damage / 5;
    }



    if (damage > 1200) damage = 1150 + random(75);
    if (me->query_temp("shushan_set")) damage += damage / 2;
    target->receive_damage("kee", damage, me, "phy");
    if (!(weapon->query("shushan_zhangmen")))
      target->receive_wound("kee", damage / 2 + random(damage / 2), me);
    if (weapon->query("shushan_zhangmen"))
      target->receive_wound("kee", damage, me);
    msg += HIY "结果$n被$N的「断水无痕」拦腰而过！\n" NOR;
    message_vision(msg, me, target);
    if (damage > 0) COMBAT_D->report_status(target);
    if (lv && lvv) {
      msg = BLINK + HIC "\n漫天剑式未消，$N手腕一转，手中剑直刺$n！\n" + NOR;
      if (chance > 65) {
        damage = me->query_skill("sword") + me->query("force_factor");
        damage += random(damage);
        if (damage > 1500) damage = 1450 + random(75);
        if (me->query_temp("shushan_set")) damage += damage / 2;
        target->receive_damage("kee", damage, me, "phy");
        if (!(weapon->query("shushan_zhangmen")))
          target->receive_wound("kee", damage / 2 + random(damage / 2), me);
        if (weapon->query("shushan_zhangmen"))
          target->receive_wound("kee", damage, me);
        msg += HIC "结果$n又被$N刺了个透心凉！\n" NOR;
        message_vision(msg, me, target);
        if (damage > 0) COMBAT_D->report_status(target);
        if (lv == "master" && lvv == "master" || lv == "grandmaster" && lvv == "master" || lv == "grandmaster" && lvv == "grandmaster") {
          msg = BLINK + HIW "\n$N在空中轻轻巧巧一个转身，手中剑自下而上反撩$n！\n" NOR;
          if (chance > 90) {
            damage = me->query_skill("sword") + me->query("force_factor");
            damage += random(damage * 2);
            if (damage > 2100) damage = 2050 + random(120);
            if (me->query_temp("shushan_set")) damage += damage / 2;
            target->receive_damage("kee", damage, me, "phy");
            if (!(weapon->query("shushan_zhangmen")))
              target->receive_wound("kee", damage / 2 + random(damage / 2), me);
            if (weapon->query("shushan_zhangmen"))
              target->receive_wound("kee", damage, me);
            msg += HIW "结果$n闪无可闪避无可避，被$N从头到脚划了开去！\n" NOR;
            message_vision(msg, me, target);
            if (damage > 0) COMBAT_D->report_status(target);
          } else {
            msg += "$n心中神智未灭，急忙收腹吸气，滋啦一声，衣服被划了道大口子。\n" NOR;
            message_vision(msg, me, target);
          }
        }
      } else {
        msg += "危难之中，$n将腰一拧，堪堪闪开那一刺。\n" NOR;
        message_vision(msg, me, target);
      }
    }
  }

  else {
    msg += "但是被$n躲开了。\n" NOR;
    message_vision(msg, me, target);
    if (damage > 0) COMBAT_D->report_status(target);

  }
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->add("force", -150 - me->query("force_factor"));
  me->start_busy(2);
  return 1;
}
