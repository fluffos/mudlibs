#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  string msg;
  mixed myexp, yourexp;
  int lvl;

  if (!target) {
    return notify_fail("你要对谁施展这一招「惊魔一指」？\n");
  }

  limit_status["sen"] = 100;
  limit_status["force"] = 300;
  limit_status["max_force"] = 1000;

  limit_skills["puti-zhi"] = 100;

  if (!can_perform(me, "方寸山三星洞")) {
    return 0;
  }

  if (objectp(me->query_temp("weapon"))) {
    return notify_fail("你必须空手才能施用惊魔一指!!\n");
  }

  if (target->is_busy()) {
    return notify_fail(target->query("name") + "已经动弹不得了！\n");
  }
  myexp = COMBAT_D->exp_power(me, target, SKILL_USAGE_ATTACK);
  yourexp = COMBAT_D->exp_power(me, target, SKILL_USAGE_DEFENSE);
  lvl = (int)me->query_skill("puti-zhi", 1) / 30;
  if (10 < lvl) {
    lvl = 10;
  }

  msg = HIC "\n$N脸色忽转肃穆,右手中指缓缓点出,正是惊天地,泣鬼神的惊魔一指!!\n" NOR;

  if (0 < COMBAT_D->perform_hit(myexp, yourexp)) {
    message_perform(msg + "\n", me, target);
    msg = HIG "$n只觉一股劲力直透肩井穴,登时全身一麻,动弹不得!!\n" NOR;
    message_perform(msg, me, target);
    target->start_busy(1 + random(lvl));
  } else {
    message_perform(msg + "\n", me, target);
    msg = HIY "可是$n似乎看破了$N的企图,险险躲过了这一招!!\n" NOR;
    message_perform(msg, me, target);
  }

  me->add("force", -150);

  return 2 + random(2);
}

string skill_name(object me, object target, string skill) {
  return "惊魔一指";
}
