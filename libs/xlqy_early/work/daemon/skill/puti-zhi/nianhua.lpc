#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    string msg;
    int extra;
    object weapon;

    if ( !target )
    {
        return notify_fail("你要对谁施展这一招「拈花三指」？\n");
    }

    limit_status["sen"] = 100;
    limit_status["force"] = 1000;
    limit_status["max_force"] = 500;

    limit_skills["puti-zhi"] = 160;

    if ( !can_perform(me, "方寸山三星洞") )
    {
        return 0;
    }

    if ( !me->is_fighting() )
    {
        return notify_fail("「拈花三指」只能在战斗中使用！\n");
    }

    extra = me->query_skill("unarmed");
    extra = extra * 8 / 10;

    me->add("force_factor", extra / 6);
    me->add_temp("apply/attack", extra / 6);
    me->add_temp("apply/strength", extra / 6);

    weapon = me->query_temp("weapon");

    msg = HIY  "$N使出「拈花三指」，一招连环三式向$n攻出！\n" NOR;
    message_perform(msg, me, target);

    msg = HIY  "\n左一拳！\n" NOR;
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
    message_perform(msg, me, target);
    msg = HIY  "\n右一拳！\n" NOR;
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
    message_perform(msg, me, target);
    msg = HIY  "\n中间再加一拳！！\n" NOR;
    COMBAT_D->perform_attack(me,target, me->query_temp("weapon"));
    message_perform(msg, me, target);

    me->add_temp("apply/attack", -extra / 6);
    me->add_temp("apply/strength", -extra / 6);
    me->add("force_factor", -extra / 6);

    COMBAT_D->start_nomove(me, 3);

    return 3 + random(2);
}

string skill_name(object me, object target, string skill)
{
    return "拈花三指";
}

