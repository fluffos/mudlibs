// by gamer
#include <ansi.h>

inherit FAMILYSKILL;

void remove_effect(object me, int amount, int effect);

int cast(object me, object target) {
  int skill, effect;

  me = this_player();

  if (!target) {
    target = me;
  }

  limit_status["mana"] = 1000;
  limit_status["kee"] = 300;
  limit_status["sen"] = 300;

  limit_skills["buddhism"] = 100;

  if (!can_cast(me, "南海普陀山")) {
    return 0;
  }

  if ((int)target->query_temp("in_regenerate")) {
    tell_object(me, target->name() + "已经受到诸天神佛庇佑了!\n");
    return 1;
  }

  skill = me->query_skill("spells");

  me->add("mana", -800);
  me->receive_damage("kee", 30);
  me->receive_damage("sen", 30);

  message_cast(HIY "$N默念佛法祈祷，一道金光从天而降，$n沐浴在诸天神佛庇佑中。\n" NOR, me, target);

  if (target != me) {
    skill = skill / 2 + random(skill / 2);
  }

  target->set_temp("in_regenerate", 1);

  effect = LEVEL_D->query_level_index(LEVEL_D->query_ob_skill_level(me, "spells"));

  switch (effect) {
    case 1:
      target->add_temp("apply/regenerate_kee", skill / 3);
      break;

    case 2:
      target->add_temp("apply/regenerate_kee", skill / 3);
      target->add_temp("apply/regenerate_sen", skill / 3);
      break;

    case 3:
      target->add_temp("apply/regenerate_kee", skill / 3);
      target->add_temp("apply/regenerate_sen", skill / 3);
      target->add_temp("apply/regenerate_force", skill / 5);
      break;

    case 4:
      target->add_temp("apply/regenerate_kee", skill / 3);
      target->add_temp("apply/regenerate_sen", skill / 3);
      target->add_temp("apply/regenerate_force", skill / 5);
      target->add_temp("apply/regenerate_mana", skill / 5);
      break;

    case 5:
      target->add_temp("apply/regenerate_kee", skill / 3);
      target->add_temp("apply/regenerate_sen", skill / 3);
      target->add_temp("apply/regenerate_force", skill / 4);
      target->add_temp("apply/regenerate_mana", skill / 4);
      break;

    case 6:
      target->add_temp("apply/regenerate_kee", skill / 3);
      target->add_temp("apply/regenerate_sen", skill / 3);
      target->add_temp("apply/regenerate_force", skill / 3);
      target->add_temp("apply/regenerate_mana", skill / 3);
      break;

    default:
      target->add_temp("apply/regenerate_kee", skill / 3);
      break;
  }

  call_out("remove_effect", skill, target, skill, effect);

  return 5 + random(5);
}

void remove_effect(object me, int amount, int effect) {
  if (!me) {
    return;
  }

  me->delete_temp("in_regenerate");

  switch (effect) {
    case 1:
      me->add_temp("apply/regenerate_kee", -amount / 3);
      break;

    case 2:
      me->add_temp("apply/regenerate_kee", -amount / 3);
      me->add_temp("apply/regenerate_sen", -amount / 3);
      break;

    case 3:
      me->add_temp("apply/regenerate_kee", -amount / 3);
      me->add_temp("apply/regenerate_sen", -amount / 3);
      me->add_temp("apply/regenerate_force", -amount / 5);
      break;

    case 4:
      me->add_temp("apply/regenerate_kee", -amount / 3);
      me->add_temp("apply/regenerate_sen", -amount / 3);
      me->add_temp("apply/regenerate_force", -amount / 5);
      me->add_temp("apply/regenerate_mana", -amount / 5);
      break;

    case 5:
      me->add_temp("apply/regenerate_kee", -amount / 3);
      me->add_temp("apply/regenerate_sen", -amount / 3);
      me->add_temp("apply/regenerate_force", -amount / 4);
      me->add_temp("apply/regenerate_mana", -amount / 4);
      break;

    case 6:
      me->add_temp("apply/regenerate_kee", -amount / 3);
      me->add_temp("apply/regenerate_sen", -amount / 3);
      me->add_temp("apply/regenerate_force", -amount / 3);
      me->add_temp("apply/regenerate_mana", -amount / 3);
      break;

    default:
      me->add_temp("apply/regenerate_kee", -amount / 3);
      break;
  }

  tell_object(me, "你所沐浴的圣光消失了!\n");

  return;
}
