// heal.c
#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target)
{
    if ( me->is_fighting() )
    {
        return notify_fail("战斗中运功疗伤？找死吗？\n");
    }

    limit_status["mana"] = 50;
    limit_status["eff_sen"] = (int)me->query("max_sen") / 2;

    if ( !can_cast(me, "南海普陀山") )
    {
        return 0;
    }

    write( HIW "你全身放松，盘腿而座，开始神游物外。\n" NOR);
    message_cast(HIW "$N盘腿而座，开始神游物外。不久吐出一口浊气，精神看起来好多了。\n"NOR, me);

    me->receive_curing("sen", 10 + (int)me->query_skill("spells") / 5 );

    me->add("mana", -50);

    return 1;
}

