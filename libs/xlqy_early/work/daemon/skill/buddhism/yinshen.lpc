// yinshen.c 隐身术

#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me) {
  int howlong;
  int spell;

  limit_status["mana"] = 2 * (int)me->query_skill("spells");
  limit_status["sen"] = 50;

  limit_skills["buddhism"] = 100;

  if (!can_cast(me, "南海普陀山")) {
    return 0;
  }

  spell = me->query_skill("spells") / 2 + me->query_skill("buddhism");

  if ((int)me->query("env/invisibility")) {
    return notify_fail("你还在隐身中，现在不需要用！\n");
  }

  message_cast("$N喃喃地念了几句咒语。\n", me);

  if (random(me->query("max_mana")) < 200) {
    me->add("mana", -(int)me->query_skill("spells"));
    me->receive_damage("sen", 10);
    message_cast("但是什么也没有发生。\n");
    return 5 + random(5);
  }

  me->add("mana", -2 * (int)me->query_skill("spells"));
  me->receive_damage("sen", 20);

  howlong = 15 + random((me->query_skill("spells") - 100));
  if (120 < howlong) {
    howlong = 120;
  }

  call_out("free", howlong, me, howlong);

  me->set_temp("yinshentime", howlong + (int)me->query_temp("yinshentime"));

  me->set("env/invisibility", 1);
  me->set_temp("no_heal_up/yinshen", 1);

  message_cast(HIW "\n只见一道白光闪过，$N踪迹皆无。\n\n" NOR, me);

  return 5 + random(5);
}

void free(object user, int howlong) {
  if (!user) {
    return;
  }

  if (!user->query("env/invisibility")) {
    return;
  }

  if (user->query_temp("yinshentime") > howlong) {
    user->add_temp("yinshentime", -howlong);
    call_out("free", user->query_temp("yinshentime"), user, user->query_temp("yinshentime"));
    return;
  }

  user->delete_temp("yinshentime");
  user->set("env/invisibility", 0);
  user->delete_temp("no_heal_up/yinshen");

  message_cast(HIW "\n白光闪过之后，$N又现出了身形。\n\n" NOR, user);

  return;
}
