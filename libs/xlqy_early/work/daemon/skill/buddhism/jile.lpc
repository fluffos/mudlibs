#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target)
{
    int i;
    string where;
    string msg;

    limit_status["mana"] = 150;
    limit_status["sen"] = 150;

    limit_skills["buddhism"] = 25;

    if ( !can_cast(me, "南海普陀山") )
    {
        return 0;
    }

    if ( me->is_busy() )
    {
        return notify_fail("你正忙着呢！\n");
    }

    me->add("mana", -80);
    me->receive_damage("sen", 50);

    msg = HIY"$N口中吟唱到：如来者，无所从来，亦无所去！若见诸相非相，即见如来！\n"NOR;
    msg += HIY"一时间，祥云霭霭，佛光普照，$N乘祥云飘然而去...\n"NOR;

    i = random(6);
    if (i == 0) where = "/d/nanhai/chaoyindong";
    else if(i==1) where = "/d/nanhai/guangchang";
    else if(i==2) where = "/d/nanhai/restroom";
    else if(i==3) where = "/d/nanhai/zhaifang";
    else if(i==4) where = "/d/nanhai/road4";
    else where = "/d/nanhai/zhulin0";

    if ( me->is_fighting() )
    {
        if ( random((int)me->query("max_mana")) > (int)target->query("max_mana") / 2 )
        {
            message_cast(msg, me);
            me->move(where);
            tell_room(environment(me),
                HIY"忽然平地祥云腾起，佛光普照，" + me->query("name") + "施施然从中而出。\n"NOR, ({me, me}) );
        }
        else
        {
            message_cast(HIM"$N喃喃地眯着小老鼠眼念了几句，但显然心不在蔫，结果什么都没有发生。\n"NOR, me);
        }
    }
    else
    {
        message_cast(msg, me);
        me->move(where);
        tell_room(environment(me), HIY"忽然平地祥云腾起，佛光普照，" + me->query("name") + "施施然从中而出。\n"NOR, ({me, me}) );
    }

    return 5 + random(5);
}

string skill_name(object me, object target, string skill)
{
    return "往生极乐";
}

