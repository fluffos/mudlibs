#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target)
{
    object *team;
    int count = 0, i;

    team = me->query_team();
    count = sizeof(team);

    if ( 0 == count )
    {
        return 1;
    }

    limit_status["force"] = 50;
    limit_status["mana"] = 500;

    if ( !can_cast(me, "南海普陀山") )
    {
        return 0;
    }

    message_cast("$N化五行之气为己方所用，大家顿觉身体又充满力量。\n", me);

    for ( i = 0; i < count; i++ )
    {
        if ( team[i] && environment(team[i]) == environment(me) )
        {
            team[i]->receive_curing("kee", 15 + (int)me->query_skill("buddhism") / 3 );
        }
    }

    me->add("force", -50);
    me->add("mana", -500);

    return 1 + random(2);
}

