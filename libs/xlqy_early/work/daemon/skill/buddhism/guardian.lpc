#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, string target)
{	
    object guardian, ob;

    limit_status["sen"] = 333;
    limit_status["mana"] = 1000;

    limit_skills["buddhism"] = 150;

    if ( !can_cast(me, "南海普陀山") )
    {
        return 0;
    }

    if ( !target )
    {
        return notify_fail("你要将什么物品召唤为神使？\n");
    }

    if ( !(ob = present(target, me)) )
    {
        return notify_fail("你要将什么物品召唤为神使？\n");
    }

    //if(!ob->is_diablo_ob())
    //return notify_fail("这件物品毫无魔力，无法召唤出神使！\n");
    //if(!ob->query("identification"))
    //return notify_fail("你还不了解这件物品的特性，怎么召唤！\n");
    //if(ob->query("kind") < 6)	
    //return notify_fail("这件物品魔力不足，无法召唤出神使！\n");
    //if(ob->query("diablo_ob_autoloaded"))
    //return notify_fail("这件物品不能召唤出神使！\n");

    message_cast(HIB"$N喃喃地念了几句咒语。\n\n"NOR, me);

    me->add("mana", -500);

    if ( random(me->query("max_mana")) < 20 )
    {
        message_cast("但是什么也没有发生。\n");
        return 1;
    }

    if ( me->query("summon/guardian") )
    {
        guardian = me->query("summon/guardian");

        if ( objectp(guardian) && environment(guardian) )
        {
            guardian->die();
        }
    }

    seteuid(getuid());

    guardian = new("/obj/npc/putuo_guardian");
    guardian->move(environment(me));
    guardian->invocation(me, ob);

    message_cast(HIY"$N说道：你的虔诚感动了上天，将我幻化为形，我将永远伴随你保护你！\n"NOR, guardian );

    me->set("summon/guardian", guardian);
    me->set("summon/title", guardian->query("title"));
    me->set("summon/family", guardian->query_family());
    me->save();

    destruct(ob);

    return 13 + random(13);
}

