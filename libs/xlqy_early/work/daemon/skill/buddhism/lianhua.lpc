#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

void remove_effect(object me, int amount);

int cast(object me)
{
    int skill;

    me = this_player();

    limit_status["mana"] = 300;
    limit_status["kee"] = 300;
    limit_status["sen"] = 300;

    limit_skills["buddhism"] = 50;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    if ( (int)me->query_temp("anti_magic") ) 
    {
        return notify_fail("你已经在运功中了。\n");
    }

    skill = me->query_skill("spells");

    me->add("mana", -100);
    me->receive_damage("kee", 30);
    me->receive_damage("sen", 30);

    message_cast(HIC"$N微一凝神，背后幻出一朵白莲，五色毫光闪现。\n" NOR, me);

    me->set_temp("anti_magic", skill);

    call_out("remove_effect", (int)skill, me, skill / 3);

    return 3;
}

void remove_effect(object me, int amount)
{
    if ( !me )
    {
        return;
    }

    me->delete_temp("anti_magic");

    tell_object(me, "你身后的白莲渐渐隐去了。\n");

    ::remove_effect_using(me, __FILE__);
}

string skill_name(object me, object target, string skill)
{
    return "莲花护体";
}

