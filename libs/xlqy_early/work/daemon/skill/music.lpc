#include <ansi.h>

inherit NEWSKILL;

string level_description(int level) {
  int max_level;
  int grade;
  string *level_desc = ({
    BLU "一窍不通" NOR,
    BLU "五音不全" NOR,
    HIB "粗通音律" NOR,
    HIB "下里巴人" NOR,
    YEL "出谷黄莺" NOR,
    YEL "清越悠扬" NOR,
    HIY "荡气回肠" NOR,
    HIY "阳阿薤露" NOR,
    HIM "余音绕梁" NOR,
    HIM "不知肉味" NOR,
    HIR "正始之音" NOR,
    HIR "黄钟大吕" NOR,
    MAG "高山流水" NOR,
    MAG "阳春白雪" NOR,
    CYN "箫韶九成" NOR,
    CYN "曲高和寡" NOR,
    HIC "不同凡响" NOR,
    HIC "人间绝唱" NOR,
    HIC "钧天广乐" NOR,
    HIC "天籁之音" NOR,
  });

  max_level = LEVEL_D->query_max_skills() * 2 / 3 / sizeof(level_desc);

  grade = level / max_level;

  if (grade >= sizeof(level_desc)) {
    grade = sizeof(level_desc) - 1;
  }

  return level_desc[grade];
}

int valid_learn(object me) {
  if (me->query_skill("literate", 1) < 10) {
    return notify_fail("你大字都不认识几个，如何识得韵脚曲谱呢！\n");
  }

  if (me->query_skill("literate", 1) > 140) {
    return 1;
  }

  if (me->query_skill("literate", 1) < me->query_skill("music", 1)) {
    return notify_fail("你的文学修为不够，无法领会到更深的乐理知识。\n");
  }

  return 1;
}
