// xian.c  云龙三现
#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  object weapon;
  int damage;
  string msg;
  mixed ap, dp;

  if (!target || !me->is_fighting(target)) {
    return notify_fail("[1;33m神龙三现只能对战斗中的对手使用。[1;0m\n");
  }

  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "staff") {
    return notify_fail("你使用的武器不对。\n");
  }

  limit_status["sen"] = 500;
  limit_status["force"] = 1500;
  limit_status["max_force"] = 500;

  limit_skills["lotusforce"] = 120;
  limit_skills["lunhui-zhang"] = 120;

  if (!can_perform(me, "南海普陀山")) {
    return 0;
  }

  msg = MAG "只见$N微微一笑，猛吸一口气,欲使出聚气驭杖绝技攻击$n。\n" NOR;

  if (!target->is_killing(me)) {
    target->kill_ob(me);
  }

  ap = COMBAT_D->combat_power(me, target, "force", SKILL_USAGE_ATTACK);
  dp = COMBAT_D->combat_power(me, target, "force", SKILL_USAGE_DEFENSE);

  if (0 < COMBAT_D->perform_hit(ap, dp)) {
    target->start_busy(random(2));

    damage = COMBAT_D->get_mydamage_direct(me, target, "staff", TYPE_PERFORM);

    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage * 2 / 3, me);
    COMBAT_D->report_status(target, 1, me, "kee");

    msg += HIY "$N手中禅杖幻作一条金龙,腾空而起,倏的罩向$n,\n$n只觉一股大力铺天盖地般压来,登时眼前一花，两耳轰鸣,哇的喷出一口鲜血！！\n" NOR;
  } else {
    msg += CYN "可是$p猛地向前一跃,跳出了$P的攻击范围。\n" NOR;
  }

  message_perform(msg, me, target);
  me->add("force", -200);

  return 2 + random(2);
}

string skill_name(object me, object target, string skill) {
  return "神龙三现";
}
