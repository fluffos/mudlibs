//Cracked by Roath
//evil...........2000.4.16
#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  string msg;
  int extra, i;
  object weapon;

  if (!target) {
    return notify_fail("［降龙伏虎］只能对战斗中的对手使用。\n");
  }

  limit_status["sen"] = 500;
  limit_status["force"] = 200;
  limit_status["max_force"] = 500;

  limit_skills["lunhui-zhang"] = 200;
  limit_skills["lotusforce"] = 100;

  if (!can_perform(me, "南海普陀山")) {
    return 0;
  }

  if ((string)me->query_skill_mapped("force") != "lotusforce") {
    return notify_fail("降龙伏虎必须以莲台心法为底子。\n");
  }

  weapon = me->query_temp("weapon");
  extra = me->query_skill("lunhui-zhang", 1) / 10 + me->query_skill("staff", 1) / 10;

  msg = HIY "$N身型闪动，地面随之起伏一降狂风，手中" + weapon->name() + "也有如狂风暴雨般地向$n卷来！" NOR;

  message_perform(msg, me, target);

  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);

  for (i = 6; i <= 9; i++) {
    me->set_temp("lunhui-zhang_perform", i);
    COMBAT_D->perform_attack(me, target, weapon, TYPE_REGULAR);
  }

  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);

  me->add("force", -extra * 5);

  me->delete_temp("lunhui-zhang_perform");

  return 3 + random(2);
}

string skill_name(object me, object target, string skill) {
  return "降龙伏虎";
}
