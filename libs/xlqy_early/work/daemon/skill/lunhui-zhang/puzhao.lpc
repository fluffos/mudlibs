//佛光谱照 by yushu 2001.2
#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    object obj;
    object weapon;
    mixed ap, dp;
    int damage;

    if ( !target )
    {
        return notify_fail("你要对谁施展这一招「佛光普照」？\n");
    }

    if ( !me->is_fighting() )
    {
        return notify_fail("「佛光普照」只能在战斗中使用！\n");
    }

    limit_status["sen"] = 500;
    limit_status["force"] = 500;
    limit_status["max_force"] = 500;

    limit_skills["lotusforce"] = 80;
    limit_skills["lunhui-zhang"] = 150;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    weapon = me->query_temp("weapon");

    message_perform(HIY"\n$N口中念动《金刚经》：\n"NOR,me,target);
    message_perform(HIY"\n生死炽燃，苦恼无量，发大乘心，普济一切。\n"NOR, me, target);
    message_perform(HIY"\n愿代众生，受无量苦，令诸众生，毕竟大乐。\n"NOR, me, target);
    message_perform(HIW"\n高举手中的"+weapon->query("name")+HIW"砸向$n。\n"NOR, me, target);

    ap = COMBAT_D->combat_power(me, target, "staff", SKILL_USAGE_ATTACK);
    dp = COMBAT_D->combat_power(me, target, "dodge", SKILL_USAGE_DEFENSE);

    if ( 0 < COMBAT_D->perform_hit(ap, dp) )
    {
        message_perform(HIR"$N躲闪不及，被打个正着！\n"NOR, target);

        damage = COMBAT_D->get_mydamage_direct(me, target, "staff", TYPE_PERFORM);

        target->receive_damage("sen", damage, me);
        target->receive_damage("kee", damage, me);

        COMBAT_D->report_status(target, 0, me, "kee");
        COMBAT_D->report_status(target, 0, me, "sen");

        if ( !random(3) && target->query_temp("weapon") )
        {
            obj = target->query_temp("weapon");
            break_equip(me, target, obj);
        }

        return 1 + random(5);
    }
    else
    {
        message_perform(HIC"却被$N躲开了！\n"NOR, target);
        me->add("force", -200);
        me->receive_damage("sen", 100);
        target->kill_ob(me);

        return 1 + random(5);
    }
}

string skill_name(object me, object target, string skill)
{
    return "佛光普照";
}

