#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{       
    string msg = "";
    string level;
    string str;
    int damage, wound;
    object weapon = me->query_temp("weapon");

    if ( !target )
    {
        return notify_fail("你要对谁施展「普度众生」？\n");
    }

    if ( !me->is_fighting() )
    {
        return notify_fail("「普度众生」只能在战斗中使用！\n");
    }

    limit_status["sen"] = 300;
    limit_status["force"] = 300;
    limit_status["max_force"] = 500;

    limit_skills["lotusforce"] = 80;
    limit_skills["lunhui-zhang"] = 80;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    if ( me->query_skill_mapped("force") != "lotusforce" )
    {
        return notify_fail("「普度众生」必须以莲台心法为底子！\n");
    }

    message_perform(HIY"$N气沉丹田，犹如金刚浑身发金光，招转佛门正宗绝招「普度众生」，向$n连续发动进攻！\n"NOR, me, target);

    me->add("force", -150);
    me->add("sen", -50);

    me->set("lunhui-zhang_perform", 6);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

    me->set("lunhui-zhang_perform", 7);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

    me->set("lunhui-zhang_perform", 8);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

    me->set("lunhui-zhang_perform", 9);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

    message_perform(HIW"$N低吟“阿弥陀佛！”「普度众生」用功完毕，身上淡淡的金光慢慢隐去.\n"NOR, me, target);
    message_perform(msg, me, target);

    return 2 + random(2);
}

string skill_name(object me, object target, string skill)
{
    return "普度众生";
}

string query_desc(object me, object target)
{
    return target->name() + "被" + HIG"" + me->name() + "" + HIM"用佛门绝招"NOR + HIY"「普度众生」"NOR + HIM"杀死了,听说尸体被打成一团肉泥！\n";
}

