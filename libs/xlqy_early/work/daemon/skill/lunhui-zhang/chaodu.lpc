#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    string msg;
    int extra;

    if ( !target ||	!me->is_fighting(target) )
    {
        return notify_fail("超生渡化只能对战斗中的对手使用。\n");
    }

    limit_status["force"] = 100;

    limit_skills["lunhui-zhang"] = 50;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    me->add("force", -100);

    msg = HIR "$N缓缓说道:佛曰,以杀止杀!我今天就大开杀戒.代表佛来惩罚你们这些顽恶之徒!\n" NOR;
    message_perform(msg, me, target);
    msg =  HIY "天理循环，报应不爽！\n"NOR;
    message_perform(msg, me, target);
    me->set_temp("lunhui-zhang_perform", 0);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
    msg =  HIC "天网恢恢，疏而不漏！\n"NOR;
    message_perform(msg, me, target);
    me->set_temp("lunhui-zhang_perform",3 );
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
    msg =  HIG "放下屠刀，立地成佛！\n"NOR;
    message_perform(msg, me, target);
    me->set_temp("lunhui-zhang_perform", 5);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
    msg =  HIW "$n好象已经到了极乐世界．．．．\n"NOR;
    message_perform(msg, me, target);
    COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
    me->delete_temp("lunhui-zhang_perform");

    return 10;
}

string skill_name(object me, object target, string skill)
{
    return "超生渡化";
}

