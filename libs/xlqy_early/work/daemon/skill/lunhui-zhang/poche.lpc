// laoniupoche.c 轮回杖法「老牛破车」式，为天下第一慢招
// by tianlin 2001.7.1,修改
#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    object weapon;
    string msg;
    int i, attack_time;
    mixed ap, dp;

    if ( !target || !me->is_fighting(target) )
    {
        return notify_fail("「老牛破车」只能对战斗中的对手使用。\n");
    }

    if ( !objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "staff" )
    {
        return notify_fail("你使用的武器不对。\n");
    }

    limit_status["sen"] = 500;
    limit_status["force"] = 100;
    limit_status["max_force"] = 500;

    limit_skills["lunhui-zhang"] = 80;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    msg = HIY "$N使出轮回杖法的「老牛破车」一式，时间猛然一滞，周围一切都变慢了。\n";

    ap = COMBAT_D->combat_power(me, target, "staff", SKILL_USAGE_ATTACK);
    dp = COMBAT_D->combat_power(me, target, "parry", SKILL_USAGE_DEFENSE);

    ap = COMBAT_D->power_random(ap);
    dp = COMBAT_D->power_div(dp, 20);

    if ( 0 < COMBAT_D->perform_hit(ap, dp) )
    {
        attack_time = 2 + random((int)me->query_skill("lunhui-zhang", 1) / 30);
        if ( attack_time > 8 )
        {
            attack_time = 8;
        }

        me->add_temp("apply/attack", (int)me->query_skill("lunhui-zhang", 1) / 10);
        msg += CYN " 结果$n被$N的招式带的慢了下来！\n" NOR;
        message_perform(msg, me, target);
        msg = "$N趁机一连向$n发出" + chinese_number(attack_time) + "招\n";
        message_perform(msg, me, target);

        for ( i = 0; i < attack_time; i++ )
        {
            message_perform(HIY + BLINK"第" + chinese_number(i + 1) + "杖。\n"NOR, me, target);
            COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
        }

        me->add_temp("apply/attack", -(int)me->query_skill("lunhui-zhang", 1) / 10);

        me->add("force", -100);
    }
    else
    {
        msg += "可是$n看破了$N的企图，并没有上当。\n" NOR;
        message_perform(msg, me, target);
    }

    return 3 + random(2);
}

string skill_name(object me, object target, string skill)
{
    return "老牛破车";
}

