#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  object weapon;
  int damage;
  mixed ap, dp;
  string dodge_skill;

  if (!target) {
    return notify_fail("你要攻击谁？\n");
  }

  limit_status["sen"] = 500;
  limit_status["force"] = 200;
  limit_status["max_force"] = 800;

  limit_skills["lunhui-zhang"] = 60;
  limit_skills["buddhism"] = 60;

  if (!can_perform(me, "南海普陀山")) {
    return 0;
  }

  if (!me->is_fighting()) {
    return notify_fail("你们没有在打架！\n");
  }

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  weapon = me->query_temp("weapon");

  message_perform(
    HIY "\n$N口诵佛号，将全身功力注入手中" + weapon->name() + NOR + HIY "顿时间霞光四射，照得$n睁不开眼！\n\n" NOR,
    me,
    target
  );

  ap = COMBAT_D->combat_power(me, target, "staff", SKILL_USAGE_ATTACK);
  dp = COMBAT_D->combat_power(me, target, "parry", SKILL_USAGE_DEFENSE);

  if (0 < COMBAT_D->perform_hit(ap, dp)) {
    message_perform(RED "$n只觉得霍的胸口一阵剧痛，已经被$N拍中了前胸！\n" NOR, me, target);

    damage = COMBAT_D->get_mydamage_direct(me, target, "staff", TYPE_PERFORM);

    target->receive_damage("kee", damage, me, "magic");
    target->receive_wound("kee", damage, me, "magic");

    me->receive_damage("sen", 100);
    me->add("force", -200);

    COMBAT_D->report_status(target, 1, me, "kee");
  } else {
    dodge_skill = target->query_skill_mapped("dodge");
    if (!dodge_skill) {
      dodge_skill = "dodge";
    }
    message_perform(SKILL_D(dodge_skill)->query_dodge_msg(target, 1), me, target);
  }

  become_enemy(me, target);

  return 2 + random(3);
}

string skill_name(object me, object target, string skill) {
  return "我入地狱";
}
