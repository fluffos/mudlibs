#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target) {
  string msg;
  mixed ap, dp;
  int howlong;

  if (!target) {
    return notify_fail("你想迷谁的魂？\n");
  }

  limit_status["mana"] = 200;
  limit_status["sen"] = 10;

  limit_skills["spells"] = 100;
  limit_skills["moonshentong"] = 60;

  if (!can_cast(me, "月宫")) {
    return 0;
  }

  if (target->query_temp("no_move")) {
    return notify_fail(target->query("name") + "已经魂不守舍，呆若木鸡了！\n");
  }

  me->add("mana", -200);
  me->receive_damage("sen", 10);

  msg = HIC "$N低头轻声念了句咒文，又抬起头来朝$n妩媚地一笑！\n" NOR;

  ap = COMBAT_D->cast_power(me, target, SKILL_USAGE_ATTACK);
  dp = COMBAT_D->cast_power(me, target, SKILL_USAGE_DEFENSE);

  ap = COMBAT_D->power_add(ap, (int)me->query("per") / 2 + me->query_per() / 2);
  dp = COMBAT_D->power_add(dp, (int)target->query_per());

  if (0 < COMBAT_D->cast_hit(ap, dp)) {
    msg += HIR "$n神不守舍地看着$N，怜香惜玉之心由然而起，竟然忘了自己在战斗之中。\n" NOR;

    howlong = random((me->query_skill("spells") - 100)) + 1;
    if (howlong > 20) {
      howlong = 20;
    }

    COMBAT_D->start_nomove(target, howlong);
  } else {
    msg += HIR "$n鄙夷地看了$N一眼，毫不为所动！\n" NOR;
    if (living(target)) {
      target->kill_ob(me);
    }
  }

  message_cast(msg, me, target);

  return 4 + random(4);
}

string skill_name(object me, object target, string skill) {
  return "迷魂术";
}
