#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target)
{
    string msg;
    mixed ap, dp;

    if ( !target )
    {
        return notify_fail("你想咒谁入梦？\n");
    }

    limit_status["mana"] = 400;
    limit_status["sen"] = 20;

    limit_skills["spells"] = 180;
    limit_skills["moonshentong"] = 120;

    if ( !can_cast(me, "月宫") )
    {
        return 0;
    }

    if ( !living(target) )
    {
        return notify_fail("有这个必要吗？\n");
    }

    me->add("mana", -400);
    me->receive_damage("sen", 20);

    msg = HIM
        "$N凝视着$n的双眼，温柔地拍着$n的头，在$n耳边轻声唱着：“小宝宝，快睡觉。。。”\n"
        + "$n顿时觉得神倦眼困，全身无力。\n"NOR;

    ap = COMBAT_D->cast_power(me, target, SKILL_USAGE_ATTACK);
    dp = COMBAT_D->cast_power(me, target, SKILL_USAGE_DEFENSE);

    if ( target->is_fighting() )
    {
        dp = COMBAT_D->power_div(dp, 3);
    }

    if ( 0 < COMBAT_D->cast_hit(ap, dp) )
    {
        msg +=  HIM"$n不知不觉的哈欠连连，眼皮沉重，终于支持不住，合上了双眼。\n"NOR;
        message_cast(msg, me, target);

        target->set_temp("force_sleep",1);
        if ( target->is_fighting() )
        {
            target->command_function("surrender");
        }
        if ( !target->command("sleep") )
        {
            message_cast(HIM"\n$n晃了晃脑袋，似乎清醒了不少，又把眼睛睁开了。\n"NOR, me, target);
        }
        target->delete_temp("force_sleep");
        return 1 + random(2); 
    }       

    msg += HIM"$n忽觉不妥，大喝一声，双目一张，精光四射！$N猝不及防，吓了一跳！\n" NOR;  
    message_cast(msg, me, target);

    if ( living(target) )
    {
        target->kill_ob(me);
    }

    return 5 + random(5);
}

string skill_name(object me, object target, string skill)
{
    return "回梦大法";
}

