#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int cast(object me, object target) {
  if (me->is_fighting() && !target) {
    return notify_fail("没什么事别乱跑！\n");
  }

  limit_status["mana"] = 50;
  limit_status["sen"] = 50;

  limit_skills["moonshentong"] = 30;

  if (!can_cast(me, "月宫")) {
    return 0;
  }

  if (me->is_busy()) {
    return notify_fail("你正忙着呢！\n");
  }

  me->add("mana", -25);
  me->receive_damage("sen", 20);

  if (random((int)me->query("max_mana")) < 13) {
    tell_object(me, "今天天气不好，月亮没出来...\n");
    return 5 + random(5);
  }

  if (!me->is_fighting() || random((int)me->query("max_mana")) > (int)target->query("max_mana") / 2) {
    message_cast(HIW "$N散出满天的花瓣,等到花瓣落尽,身影已然消失在花影中！\n" NOR, me);

    switch (random(4)) {
      case 0:
        me->move("/d/moon/ontop2");
        break;
      case 1:
        me->move("/d/moon/courtyard");
        break;
      case 2:
        me->move("/d/moon/lotuspond");
        break;
      default:
        me->move("/d/moon/wangmu_room");
        break;
    }

    tell_room(
      environment(me),
      HIM "五彩花瓣纷纷洒洒的从空飘落，" + me->query("name") + "施施然从中而出。\n" NOR,
      ({ me, me })
    );
  } else {
    message_cast(HIM "$N洒出漫天花瓣，却被狂风吹得七零八落。\n" NOR, me);
  }

  return 5 + random(5);
}

string skill_name(object me, object target, string skill) {
  return "幻花化影";
}
