//【神罚拳】
//搞笑

inherit SKILL;

#include <ansi.h>

mapping *action = ({
  ([ "action": "$N本似心不在焉，突然怒目圆睁，一招" + HIG "「神之觉醒」" NOR + "闪电般地攻向$n的$l",
    "dodge": -10,
    "parry": -10,
    "force": 50,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N拳飞如雨，招招似有还无，空气中弥漫着悲哀的气氛，令$n也受感染，
动作不由慢了下来，这招正是" + MAG "「神之悲泣」" NOR,
    "dodge": -20,
    "parry": -20,
    "force": 50,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N怒吼一声，头发根根直竖，疾步向前，右拳迅速而凶猛地
朝$n的$l猛砸过去，这招名曰" + HIY "「神之震怒」" NOR,
    "dodge": -5,
    "parry": -5,
    "force": 80,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N突然停止进攻，抱拳于胸，积蓄全身力量，朝地面猛击下去，
刹时，地面出现一道丈余深的裂缝，朝$n闪电般地延伸过去，
裂缝中涌出强大的撕裂性气流，朝$n席卷而去，这招就是" + HIR "「神之碎裂」" NOR,
    "dodge": -5,
    "parry": -5,
    "force": 100,
    "damage_type": "擦伤",
  ]),
  ([ "action": "$N使出神罚拳的至高招数" + HIM "「神之狂舞」" NOR + "，霎那间身形幻化为无数个人形，
飞舞于$n的身旁，$n不由得眼花缭乱，便在这一刻，
$N瞅准时机，向着$n的$l作出致命一击！" NOR,
    "dodge": -20,
    "parry": -30,
    "force": 100,
    "damage_type": "瘀伤",
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练神罚掌必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("sen", 30);
  me->add("force", -10);

  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("hsl/hsl_might") + "/shenfa-quan/" + func;
}
