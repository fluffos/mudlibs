}

int valid_learn(object me) {
  object ob;

  if ((string)me->query("gender") != "女性") {
    return notify_fail("风回雪舞剑只有女子才能学习!!\n");
  }

  if ((int)me->query("max_force") < 50) {
    return notify_fail("你的内力不够，没有办法练风回雪舞剑法。50\n");
  }

  if ((string)me->query_skill_mapped("force") != "moonforce") {
    return notify_fail("风回雪舞剑法必须配合昆仑山玉女峰的圆月心法才能练。\n");
  }

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword") {
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  }

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return ::query_action(me, weapon, "snowsword");
}

int practice_skill(object me) {
  return ::practice_skill(me, 30, 0, 3, "snowsword");
}

string perform_action_file(string func) {
  return __DIR__ "snowsword/" + func;
}

void skill_improved(object me) {
  ::skill_improved(me, "snowsword", "刺伤");
}
