// by gamer
#include <ansi.h>

inherit F_CLEAN_UP;


void remove_haste(object me,int atk);

int exert(object me, object target)
{
	int skill,effect,atk;
	int fatigue;
	string level;
	me=this_player();
	if( !target ) target = me;

	
	if( (int)me->query_skill("lengquan-force", 1) < 120 )
		return notify_fail("你的冷泉神功修为不足。\n");
	if(me->query("family/family_name")!="将军府")
                return notify_fail("你非将军府弟子，不懂得「急攻快打」的奥妙！\n");
        if( (int)me->query("force") < 1000 )     
                return notify_fail("你的内力不够。\n");
	if( (int)me->query("kee") < 300 )
		return notify_fail("你的气血不足。\n");
	if( (int)me->query("sen") < 300 )
		return notify_fail("你的精神不足。\n");
        if( (int)target->query_temp("in_haste") ) 
        {
              	tell_object(me,target->name()+"已经受到「急攻快打」的影响了!\n");
              	  return 1;
         }
         message_vision(HIR"$N运起冷泉心法，双手隐隐约约散出若有质却无形的红光，轻抚$n天灵。\n" NOR, me,target); 
	 tell_object(target,HIG"你觉得全身活泼泼、暖洋洋，充满了劲力！\n" NOR); 
	
		skill = me->query_skill("force");
if(me->query_temp("jjf_set")) skill+=skill/2;
		me->add("force", -360);
	        me->receive_damage("kee", 120);
		me->receive_damage("sen", 120);
    
	        level = me->query("skill_level/force");
	        effect = 4;
		if(level == "expert")
			 effect = 3;
		
		else if(level == "master")
			 effect = 2;	
		
		else if(level == "grandmaster")
			 effect = 1;	
		if(target != me)
			effect++;
		target->set_temp("in_haste", effect);	
		atk = me->query_skill("lengquan-force",1);
		atk = atk/40;
		atk = atk*(5-effect);
		if(atk > 80) atk = 80+random(10);
		target->add_temp("apply/strength",atk);
		target->set_temp("in_haste_strength",atk);
		skill = skill*(6-effect)/3;
		skill = skill/2+random(skill/2);
		
	        target->start_call_out( (: call_other, __FILE__, "remove_haste", target, atk :), skill);
		
		if(target->query_temp("in_fatigue"))
		{
			fatigue =  target->query_temp("in_fatigue_attack");
			 target->delete_temp("in_fatigue");
		        target->delete_temp("in_fatigue_temp");
		        target->delete_temp("in_fatigue_attack");
		        target->add_temp("apply/attack",fatigue);
		        tell_object(target, "你所受到的「疲劳缓攻」被消除了!\n");	
		
		}
			
		if(me->is_fighting()) me->start_busy(3);	
	
        return 1;
}

void remove_haste(object me,int atk)
{
	if(!me) return;
	if(me->query_temp("in_haste"))
        {
	        me->delete_temp("in_haste");
	        me->delete_temp("in_haste_temp");
	        me->delete_temp("in_haste_strength");
	        me->add_temp("apply/strength",-atk);
	        tell_object(me, "你所受到的「急攻快打」效果消失了!\n");
	
	}
}


