int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够,没有办法学习丧神鬼斧。\n");

  if ((string)me->query_skill_mapped("force") != "starforce")
    return notify_fail("丧神鬼斧必须配合辰星灵云壁才能学习。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "axe")
    return notify_fail("你必须先找一把斧子才能学习斧术。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "axe" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  if (me->query_skill("axe") < 300)
    return action[random(sizeof(action) - 2)];
  else if (me->query_skill("axe") < 500)
    return action[random(sizeof(action) - 1)];
  else return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够,没有办法练习丧神鬼斧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按着所学练了一遍丧神鬼斧。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("hsl/hsl_might") + "/ghostaxe/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  if (random(me->query_skill("ghostaxe", 1) < 200)) return 0;
  if (damage_bonus < 100) return 0;

  if (random(damage_bonus / 2) > (victim->query_str() / 3 + victim->query_temp("apply/armor") / 5)) {
    victim->receive_wound("kee", damage_bonus / 3);
    switch (random(3)) {
      case 0: return HIY "$n被漫天斧影所震伤！\n" NOR;
      case 1: return HIY "$N劲力一吐，一道弧光从$w中冲出击中$n的$l！\n" NOR;
      case 2: return HIY "$N暴喝一声，$w上光芒大盛直逼$n！\n" NOR;
    }
  }

}
