// by flying @ 缥缈水云间
#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int exert(object me, object target) {
  if (!target || !userp(target) || target->is_corpse() || target == me) {
    return notify_fail("你要替谁疗内伤？\n");
  }

  if (!target->query_condition("dragon_wound")) {
    return notify_fail("他根本不需要你的帮助！\n");
  }

  if (me->is_fighting() || target->is_fighting()) {
    return notify_fail("战斗中无法运功疗伤！\n");
  }

  limit_status["force"] = (int)me->query("max_force") + 300;

  limit_skills["lotusforce"] = 100;

  if (!can_exert(me, "南海普陀山")) {
    return 0;
  }

  message_exert(HIY "$N盘膝坐下,调匀内息，双掌抵住$n背部两处大穴，将内力源源送入。\n\n" NOR,
    me, target);

  if (random(me->query_skill("lotusforce", 1) - 80) > 10) {
    target->clear_condition("dragon_wound");
    message_exert(HIY "良久，$N轻轻嘘了一口气，站了起来。\n" NOR, me, target);
  } else {
    message_exert(HIY "$N突然脸色苍白，似乎心力有所不及，竟吐出一口血来……\n" NOR, me, target);
  }

  target->receive_cuiring("kee", 10 + (int)me->query_skill("force") / 3);
  me->add("force", -150);

  return 1;
}
