#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int exert(object me, object target)
{
    object *team;
    int count = 0, i;

    team = me->query_team();
    count = sizeof(team);
    if ( 0 == count )
    {
        return 1;
    }

    limit_status["force"] = 500;
    limit_status["mana"] = 50;

    if ( !can_exert(me, "南海普陀山") )
    {
        return 0;
    }

    message_exert("$N潜运莲台心法,双掌合十,低眉肃容,隐有普渡众生之意。众人只觉得一股祥和的内力涌来,顿时四体舒泰.\n", me);

    for ( i = 0; i < count; i++ )
    {
        if ( team[i] && environment(team[i]) == environment(me) )
        {
            team[i]->receive_curing("kee", 15 + (int)me->query_skill("lotusforce") / 5 );
        }
    }

    me->add("force", -500);
    me->add("mana", -50);

    return 1 + random(3);
}

