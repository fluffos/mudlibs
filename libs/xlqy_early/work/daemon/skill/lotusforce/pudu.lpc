// by jame @ 秋千雅阁
#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int exert(object me, object target)
{
    if ( !target || !userp(target) || target->is_corpse() || target == me )
    {
        return notify_fail("你要替谁疗伤？\n");
    }

    if ( !target->query_condition("hell_zhua") )
    {
        return notify_fail("他根本不需要你的帮助！\n");
    }

    if ( me->is_fighting() || target->is_fighting() )
    {
        return notify_fail("战斗中无法运功疗伤！\n");
    }

    limit_status["force"] = (int)me->query("max_force") + 300;

    limit_skills["lotusforce"] = 100;

    if ( !can_exert(me, "南海普陀山") )
    {
        return 0;
    }

    message_exert(HIY "$N盘膝坐下,调匀内息，双掌抵住$n背部两处大穴，将内力源源送入。\n\n"NOR, me, target );
    target->clear_condition("hell_zhua");
    message_exert(HIY "良久，$N轻轻嘘了一口气，站了起来。\n"NOR, me, target );
    tell_object(target, HIG"你的内伤基本治好了，再发作一次就会自然痊愈，不必担心！\n");

    me->add("force", -150);
    return 1;
}

