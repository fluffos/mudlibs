#include <ansi.h>

inherit NEWSKILL;

int valid_learn(object me) {
  return 1;
}

string cast_spell_file(string spell) {
  return __DIR__ "spells/" + spell;
}

string level_description(int level) {
  int max_level;
  int grade;
  string *level_desc = ({
    BLU "初具法力" NOR,
    BLU "略晓变化" NOR,
    BLU "降龙伏虎" NOR,
    HIB "腾云驾雾" NOR,
    HIB "神出鬼没" NOR,
    HIB "预知祸福" NOR,
    YEL "妙领天机" NOR,
    YEL "逆天改命" NOR,
    YEL "呼风唤雨" NOR,
    HIY "负海担山" NOR,
    HIY "包罗万象" NOR,
    HIY "翻天覆地" NOR,
    CYN "移星换斗" NOR,
    CYN "偷天换日" NOR,
    CYN "随心所欲" NOR,
    HIC "变换莫测" NOR,
    HIC "无中生有" NOR,
    HIC "道法自然" NOR,
    HIC "法力无边" NOR,
    HIW "开天辟地" NOR,
  });

  max_level = LEVEL_D->query_max_skills() * 2 / 3 / sizeof(level_desc);

  grade = level / max_level;

  if (grade >= sizeof(level_desc)) {
    grade = sizeof(level_desc) - 1;
  }

  return level_desc[grade];
}

string type() {
  return "spells";
}
