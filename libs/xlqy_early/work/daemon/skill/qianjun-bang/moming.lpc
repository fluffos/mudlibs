#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  mixed ap, dp;
  int time;

  if (!target) {
    return notify_fail("你要对谁施展这一招「霹雳三打」？\n");
  }

  limit_status["sen"] = 500;
  limit_status["force"] = 500;
  limit_status["max_force"] = 500;

  limit_skills["qianjun-bang"] = 150;

  if (!can_perform(me, "方寸山三星洞")) {
    return 0;
  }

  if (target->is_busy()) {
    return notify_fail("看来你的动作难以使对方迷茫。\n");
  }

  message_perform(WHT "$N手中兵器荡出层层烟雾，朦朦胧胧，将$n罩了起来。$n仿佛看到了自己的过去，陷入了无限的回忆中去！\n\n" NOR, me, target);

  ap = COMBAT_D->combat_power(me, target, "stick", SKILL_USAGE_ATTACK);
  dp = COMBAT_D->combat_power(me, target, "parry", SKILL_USAGE_DEFENSE);

  time = (int)me->query_skill("qianjun-bang", 1) / 4;
  if (time > 10) {
    time = 10;
  }
  if (time < 3) {
    time = 3;
  }

  if (0 < COMBAT_D->perform_hit(ap, dp)) {
    message_perform(HIC "$n呆呆的站立着，一种若有所失的感觉涌上心头，顿时忘了自己还在战斗中！\n" NOR, me, target);
    target->start_busy(3 + random(time));
  } else {
    message_perform(HIC "不料$n很快从回忆中解脱出来，重新投入战斗！\n" NOR, me, target);
  }

  become_enemy(me, target);

  return 2 + random(3);
}

string skill_name(object me, object target, string skill) {
  return "若有所失";
}
