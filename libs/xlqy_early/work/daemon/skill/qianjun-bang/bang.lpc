#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  if (!target) {
    return notify_fail("你要对谁施展这一招「棒打乾坤」？\n");
  }

  limit_status["sen"] = 250;
  limit_status["force"] = 300;
  limit_status["max_force"] = 300;

  limit_skills["qianjun-bang"] = 50;

  if (!can_perform(me, "方寸山三星洞")) {
    return 0;
  }

  if (!me->is_fighting()) {
    return notify_fail(HIR "「" HIY "棒打乾坤" HIR "」" NOR "只能在战斗中使用！\n");
  }

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  message_perform(HIC "\n$N运足了内力，对着$n使出了一招" HIR "「" HIY "棒打乾坤" HIR "」" NOR "！\n" NOR, me, target);

  me->set_temp("qianjun-bang_perform", 5);
  COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

  me->set_temp("qianjun-bang_perform", 7);
  COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

  me->delete_temp("qianjun-bang_perform");

  me->receive_damage("sen", 100);
  me->add("force", -100);

  become_enemy(me, target);

  COMBAT_D->start_nomove(me, 3, 1);

  return 3 + random(5);
}

string skill_name(object me, object target, string skill) {
  return "棒打乾坤";
}
