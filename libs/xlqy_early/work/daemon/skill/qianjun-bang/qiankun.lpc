#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  int damage, flag;

  if (!target) {
    return notify_fail("你要对谁施展这一招「乾坤一棒」？\n");
  }

  limit_status["sen"] = 500;
  limit_status["force"] = 1000;
  limit_status["max_force"] = 1000;

  if (150 > (int)me->query_kar()) {
    limit_skills["qianjun-bang"] = 150 - (int)me->query_kar();
  }

  if (!can_perform(me, "方寸山三星洞")) {
    return 0;
  }

  if (!me->is_fighting()) {
    return notify_fail("「乾坤一棒」只能在战斗中使用！\n");
  }

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  message_perform(HIC "\n$N运足精神，一个高跳在空，使出了「乾坤一棒」的绝技！\n" NOR, me);

  me->set_temp("qianjun-bang_perform", 7);
  damage = COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));

  flag = LEVEL_D->query_level_index(LEVEL_D->query_ob_skill_level(me, "stick"));
  flag = LEVEL_D->query_max_level_index() - flag;

  if (0 < damage && flag && random(flag)) {
    message_perform(HIG "\n$N一招乾坤一击得手，直砸的$n全身气血翻涌，经脉中内息乱窜！\n\n" NOR, me, target);

    if (!target->is_busy()) {
      target->start_busy(random(2));
    }

    target->receive_damage("kee", target->query("kee") / 12, me);
    target->receive_wound("kee", 1 + random(target->query("kee") / 12), me);

    target->add("force", -target->query("force") / 12);

    COMBAT_D->report_status(target, 1, me, "kee");
  }

  me->delete_temp("qianjun-bang_perform");

  me->receive_damage("sen", 100 + random(100));
  me->add("force", -200);

  COMBAT_D->start_nomove(me, 3, 1);

  become_enemy(me, target);

  return 4 + 10 - random(flag);
}

string skill_name(object me, object target, string skill) {
  return "乾坤一棒";
}
