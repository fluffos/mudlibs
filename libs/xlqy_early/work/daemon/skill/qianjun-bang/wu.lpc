#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

#include "/daemon/skill/eff_msg.h";

int def;
int perform2(object me, object target);
int perform3(object me, object target);
int perform4(object me, object target);

int perform(object me, object target) {
  object weapon1;
  string msg;
  int damage, time, p;
  mixed ap, dp;

  if (!target) {
    return notify_fail("你要对谁施展这一招「神猴狂舞」？\n");
  }

  limit_status["sen"] = 500;
  limit_status["force"] = 600;
  limit_status["max_force"] = 1200;

  limit_skills["stick"] = 150;
  limit_skills["qianjun-bang"] = 150;
  limit_skills["dodge"] = 120;
  limit_skills["force"] = 150;

  if (!can_perform(me, "方寸山三星洞")) {
    return 0;
  }

  if (!(weapon1 = me->query_temp("weapon")) || (string)weapon1->query("skill_type") != "stick") {
    return notify_fail("你以为你是谁？没棒也发神猴狂舞！\n");
  }

  msg = HIY "\n$N使出方寸山绝技「神猴狂舞」，身法陡然加快！\n" NOR;

  ap = COMBAT_D->exp_power(me, target, SKILL_USAGE_ATTACK);
  dp = COMBAT_D->exp_power(me, target, SKILL_USAGE_DEFENSE);

  if (COMBAT_D->perform_hit(ap, dp) >= 0) {
    msg += HIY "\n$N忽然猛一吸气，抡棒回舞，向$n轻轻地劈出。" NOR;

    if ((me->query_str() / 2 + random(me->query_str() / 2)) > random(target->query_str())) {
      msg += HIC "\n但见$n大喝一声，愈以内力克制，结果$n只挡住开始两招，就无法再维持澎湃的乱舞。\n\n" NOR;

      damage = COMBAT_D->get_mydamage(
        me,
        0,
        0,
        me->query_entire_dbase(),
        target->query_entire_dbase(),
        TYPE_PERFORM
      );
      damage += (int)me->query_skill("qianjun-bang", 1);
      damage = damage + random(damage);
      def = (int)target->query_temp("apply/armor_vs_force");
      damage -= damage * def / 3000;
      damage = damage * 8 / 10;
      target->receive_damage("kee", damage, me);
      me->add("force", -(damage / 4));

      message_perform(msg, me, target);
      COMBAT_D->report_status(target, 0, me, "kee");

      if (me->query_skill("stick", 1) > 179) {
        perform2(me, target);
      }
    } else {
      msg += HIC "\n初时似乎出手不重，但其波浪状的棍影后浪击前浪，一浪高过一浪，连绵不尽！\n\n" NOR;
      message_perform(msg, me, target);
      for (p = 0; p < 2 + random(2); p++) {
        COMBAT_D->perform_attack(me, target, me->query_temp("weapon"));
      }
      if (random(me->query_skill("qianjun-bang", 1) + me->query_skill("stick", 1)) > 179) {
        perform2(me, target);
      }
    }

    target->start_busy(1);

  } else {
    me->add("force", -200);
    msg += HIG "可是$p伏地一滚，躲开了对手的攻击。\n\n" NOR;
    message_perform(msg, me, target);

    if (me->query_skill("qianjun-bang", 1) > 199 && me->query_skill("stick", 1) > 199) {
      perform2(me, target);
    }
  }

  return 3 + random(4);
}

// 第二击
int perform2(object me, object target) {
  int damage;
  string msg, weapon, force_skill, force_skill_name;

  if (!living(target)) {
    return notify_fail("对手已经不能再战斗了。\n");
  }
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target)) {
    return notify_fail("「神猴狂舞现在没对手了呀。\n");
  }

  weapon = me->query_temp("weapon");

  force_skill = target->query_skill_mapped("force");
  if (!force_skill) {
    force_skill_name = "基本内功";
  } else {
    force_skill_name = to_chinese(force_skill);
  }

  if ((int)me->query("force", 1) < 300) {
    return notify_fail("你待要再出第二击，却发现自己的内力不够了！\n");
  }

  if (random(5) > 3) {
    msg = HIC "\n但见$N倒拖兵器,突然一个仰身,大喝一声,募的绕身回劈,$n眼前一黑!!\n" NOR;
  } else {
    msg = HIG "\n但见$N倒拖兵器,突然狂啸一声,抡棍横扫,声势刚烈,$n早已吓慌了手脚!!\n" NOR;
  }
  message_perform(msg, me, target);

  if (random(me->query("max_force")) > random(target->query("max_force") / 2)) {
    msg = CYN "$n惊骇之下，" NOR + HIR + force_skill_name + NOR + CYN "顿时破绽百出，$n根本无从招架！\n\n" NOR;
    target->start_busy(1);

    damage = COMBAT_D->get_mydamage(
      me,
      0,
      0,
      me->query_entire_dbase(),
      target->query_entire_dbase(),
      TYPE_PERFORM
    );
    damage += (int)me->query_skill("qianjun-bang", 1);
    damage = damage + (int)me->query_skill("force", 1);
    damage = damage + random(damage);
    def = (int)target->query_temp("apply/armor_vs_force");
    damage -= damage * def / 3000;
    damage = damage * 8 / 10;

    target->receive_damage("kee", damage, me);
    message_perform(msg, me, target);
    COMBAT_D->report_status(target, 0, me, "kee");

    if (me->query_skill("qianjun-bang", 1) > 239) {
      perform3(me, target);
    }
  } else {
    me->add("force", -200);
    msg = WHT "可是$p料敌之先,抢攻几招，反逼$N连连后退。\n\n" NOR;
    message_perform(msg, me, target);

    if (me->query_skill("qianjun-bang", 1) > 259 && me->query_skill("stick", 1) > 259) {
      perform3(me, target);
    }
  }

  return 1;
}


int perform3(object me, object target) {
  int damage;
  string msg, weapon, force_skill, force_skill_name, *limbs;

  if (!living(target)) {
    return notify_fail("对手已经不能再战斗了。\n");
  }
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target)) {
    return notify_fail("「神猴狂舞现在没对手了呀。\n");
  }

  weapon = me->query_temp("weapon");

  force_skill = target->query_skill_mapped("force");

  if (!force_skill) {
    force_skill_name = "基本内功";
  } else {
    force_skill_name = to_chinese(force_skill);
  }

  if ((int)me->query("force", 1) < 1000) {
    return notify_fail("你待要再出最后一击，却发现自己的内力不够了！\n");
  }

  if (random(5) > 2) {
    msg = HIC "\n$N一声咆哮，兵器竟然脱手飞出，如游龙般翱翔青宇，破空射向$n的左肩！\n" NOR;
    msg += HIC "$n大吃一惊，但见$N空手猱身而上，双手擒拿点拍，攻势凌厉之极!\n" NOR;
  } else {
    msg = HIG "\n$N长啸一声，一式「天地鹤翔」，腾空飞起，全身迸出无数道棍影，弥漫天际！\n" NOR;
  }
  message_perform(msg, me, target);

  if (random(me->query_skill("stick")) > random(target->query_skill("dodge") / 3 * 2)) {
    msg = CYN "$n慌乱中已经来不及运起" NOR + HIR + force_skill_name + NOR + CYN ",$N抡起就是一棒\n\n" NOR;
    target->start_busy(1);
    damage = COMBAT_D->get_mydamage(
      me,
      0,
      0,
      me->query_entire_dbase(),
      target->query_entire_dbase(),
      TYPE_PERFORM
    );
    damage += (int)me->query_skill("unarmed", 1);
    damage = damage + (int)me->query_skill("force", 1);
    def = (int)target->query_temp("apply/armor_vs_force");
    damage -= damage * def / 3000;
    damage = damage * 8 / 10;

    target->receive_damage("kee", damage, me);
    me->add("force", -(damage / 4));

    limbs = target->query("limbs");
    msg = replace_string(msg, "$l", limbs[random(sizeof(limbs))]);
    msg = replace_string(msg, "$w", weapon->name());

    message_perform(msg, me, target);
    COMBAT_D->report_status(target, 0, me, "kee");
  } else {
    me->add("force", -200);
    msg = HIC "可是$p一个反身,轻轻躲过$N凌厉的进攻。\n" NOR;
    message_perform(msg, me, target);
  }

  me->add("force", -500);

  return 1;
}

string skill_name(object me, object target, string skill) {
  return "神猴狂舞";
}
