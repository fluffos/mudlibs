#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  object weapon, ob;
  int j, skill;
  string msg;

  if (!target) {
    return notify_fail("你要对谁施展这一招「盘龙八式」？\n");
  }

  limit_status["sen"] = 500;
  limit_status["force"] = 2000;

  limit_skills["qianjun-bang"] = 120;

  if (!can_perform(me, "方寸山三星洞")) {
    return 0;
  }

  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "stick") {
    return notify_fail("「盘龙八式」必须用棍棒才能施展。\n");
  }

  skill = me->query_skill("qianjun-bang", 1);
  target->start_busy(2);
  target->add_temp("apply/dodge", -skill * 2);
  target->add_temp("apply/parry", -skill * 2);

  msg = HIG "$N跳至空中，手中的$n" + HIG "好似" + HIY "盘龙出沧海" + HIG "顿时化作无数条影子。\n" NOR;
  message_perform(msg, me, weapon);

  me->add_temp("apply/attack", skill);
  me->add_temp("apply/damage", skill);

  for (j = 1; j <= 8; j++) {
    msg = HIR "满天棍影中，$N砸出第" + HIY + chinese_number(j) + HIR + "棍。\n" NOR;
    message_perform(msg, me, weapon);
    COMBAT_D->perform_attack(me, target, weapon);
  }

  me->add("force", -1500);

  me->add_temp("apply/attack", -skill);
  me->add_temp("apply/damage", -skill);
  target->add_temp("apply/parry", skill * 2);
  target->add_temp("apply/dodge", skill * 2);

  return 8 + random(4);
}

string skill_name(object me, object target, string skill) {
  return "盘龙八式";
}
