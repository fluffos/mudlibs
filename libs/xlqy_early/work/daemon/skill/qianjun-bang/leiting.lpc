#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target) {
  string msg;
  mixed myexp, yourexp;
  int mystr, yourstr, mylv, yourlv;
  object weapon;

  if (!target) {
    return notify_fail("你要对谁施展这一招「雷霆一击」？\n");
  }

  limit_status["sen"] = 500;
  limit_status["force"] = 1000;
  limit_status["max_force"] = 1000;

  limit_skills["qianjun-bang"] = 80;

  if (!can_perform(me, "方寸山三星洞")) {
    return 0;
  }

  weapon = me->query_temp("weapon");

  if (!weapon || weapon->query("skill_type") != "stick") {
    return notify_fail("你必须在使用兵器时才能使[雷霆一击」！\n");
  }

  weapon = target->query_temp("weapon");

  if (!objectp(weapon)) {
    return notify_fail("你的对手没有用兵器！\n");
  }

  myexp = COMBAT_D->exp_power(me, target, SKILL_USAGE_ATTACK);
  yourexp = COMBAT_D->exp_power(me, target, SKILL_USAGE_DEFENSE);

  mystr = (int)me->query("str");
  yourstr = (int)target->query("str");
  mylv = (int)me->query_skill("stick");
  yourlv = (int)target->query_skill("dodge") + 1;

  if (random(yourstr) < mystr / 7
    || COMBAT_D->perform_hit(myexp, yourexp) >= 0
    || random(yourlv) < mylv / 7
  )  //相同状态下,不中概率为 5/6*5/6*5/6 ~=0.5787
  //如果对手没有dodge,hmm,consider...
  {
    break_equip(me, target, weapon);
    target->start_busy(2);
  } else {
    msg = YEL "结果$n看破了$N的企图轻巧地躲过，而$N用力过度，闹了个手忙脚乱。\n" NOR;
    message_perform(msg, me, target);
    COMBAT_D->do_attack(target, me, weapon, TYPE_REGULAR);
  }

  me->add("force", -100);

  return 2 + random(3);
}

string skill_name(object me, object target, string skill) {
  return "雷霆一击";
}
