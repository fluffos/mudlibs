#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    object weapon = me->query_temp("weapon");
    int cost = me->query_skill("qianjun-bang", 1) / 2;
    mixed ap, dp;

    if ( !target )
    {
        return notify_fail("你要对谁施展这一招「霹雳三打」？\n");
    }

    limit_status["sen"] = 500;
    limit_status["force"] = 500;
    limit_status["max_force"] = 700;

    limit_skills["qianjun-bang"] = 100;

    if ( !can_perform(me, "方寸山三星洞") )
    {
        return 0;
    }

    if ( !living(target) )
    {
        return notify_fail("这人本来就不能动,还用什么大圣醉酒？\n");
    }

    if ( !weapon || weapon->query("skill_type") != "stick" )
    {
        return notify_fail("你手中没有棒子，如何使得「大圣醉酒」字诀？\n");
    }

    if ( target->is_busy() )
    {
        return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");
    }

    if ( me->query_skill_mapped("stick") != "qianjun-bang" )
    {
        return notify_fail("你现在无法使用「大圣醉酒」。\n");
    }

    if ( userp(me) )
    {
        if ( (int)me->query_skill("wuxiangforce", 1) < 100 )
        {
            return notify_fail("你的无相神功修为不够，不能把手中兵器化作「大圣醉酒」。\n");
        }
        if ( me->query_skill_mapped("force") != "wuxiangforce")
        {
            return notify_fail("你所用的内功与千钧棒法意气相悖！\n");
        }
    }

    me->add("force", -cost);
    me->add("mana", -10);

    message_perform(CYN"\n$N默运无相神功,但见手中从" + weapon->name() + CYN"招呼过来，中间有强烈的酒味，在空中着一圈圈漂着，"
        "久久不散，突然只见天上有一条条大棒向$n砸下！\n\n"NOR, me, target);

    ap = COMBAT_D->exp_power(me, target, SKILL_USAGE_ATTACK);
    dp = COMBAT_D->exp_power(me, target, SKILL_USAGE_DEFENSE);

    if ( 0 < COMBAT_D->perform_hit(ap, dp) )
    {
        message_perform(HIW"$n一不留神被砸个正着，当时目瞪口呆。\n"NOR, me, target);
        target->start_busy(3);
    }
    else
    {
        message_perform(HIY"可是$p看破了$P的企图，并没有上当。\n" NOR, me, target);
    }

    return 3 + random(3);
}

string skill_name(object me, object target, string skill)
{
    return "大圣醉酒";
}

