#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int perform(object me, object target)
{
    object weapon;
    int bonus = 0;
    int damage, flag;	

    if ( !target )
    {
        return notify_fail("你要对谁施展这一招「霹雳三打」？\n");
    }

    limit_status["sen"] = 500;
    limit_status["force"] = 500;
    limit_status["max_force"] = 500;

    limit_skills["qianjun-bang"] = 100;

    if ( !can_perform(me, "方寸山三星洞") )
    {
        return 0;
    }

    if ( !me->is_fighting() )
    {
        return notify_fail("「霹雳三打」只能在战斗中使用！\n");
    }

    bonus = (int)me->query_skill("qianjun-bang", 1) / 3;

    flag = LEVEL_D->query_level_index(LEVEL_D->query_ob_skill_level(me, "stick"));
    weapon = me->query_temp("weapon");

    me->delete("env/brief_message");
    target->delete("env/brief_message");

    message_perform(HIC"\n$N运足精神，身形一转，霹雳间连续向$n攻出了三招！\n"NOR, me, target);

    me->add_temp("apply/attack", bonus);
    me->add_temp("apply/defense", -bonus/2);
    me->add_temp("apply/damage", bonus/2);
    me->set_temp("qianjun-bang_perform", 4);

    if ( !userp(me) )
    {
        flag ++;
    }

    damage = COMBAT_D->perform_attack(me, target, weapon);
    flag = LEVEL_D->query_max_level_index() - flag;

    if ( damage > 0 && !random(flag) && weapon )
    {
        message_vision(HIR"\n\n$N一击得手，力贯" + weapon->name() + "直砸的$n全身气血翻涌，眼冒金星，经脉中内息乱串！\n\n"NOR, me, target);
        if ( !target->is_busy() )
        {
            target->start_busy(random(2));
        }

        target->receive_damage("kee", target->query("kee") / 12, me);
        target->receive_damage("sen", target->query("sen") / 24, me);

        target->receive_wound("kee", 1 + random(target->query("kee") / 12), me);

        target->add("force", - target->query("force") / 12);

        COMBAT_D->report_status(target, 1, me, "kee");
        COMBAT_D->report_status(target, 0, me, "sen");
    }

    me->set_temp("qianjun-bang_perform", 1);  
    damage = COMBAT_D->perform_attack(me, target, weapon);

    if ( damage > 0 && !random(flag) && weapon )
    {
        message_vision(HIR"\n\n$N一击得手，力贯" + weapon->name() + "直砸的$n全身气血翻涌，眼冒金星，经脉中内息乱串！\n\n"NOR, me, target);
        if ( !target->is_busy() )
        {
            target->start_busy(random(2));
        }

        target->receive_damage("kee", target->query("kee") / 12, me);
        target->receive_damage("sen", target->query("sen") / 24, me);

        target->receive_wound("kee", 1 + random(target->query("kee") / 12), me);

        target->add("force", - target->query("force") / 12);

        COMBAT_D->report_status(target, 1, me, "kee");
        COMBAT_D->report_status(target, 0, me, "sen");
    }

    me->set_temp("qianjun-bang_perform", 6);
    damage = COMBAT_D->perform_attack(me, target, weapon);

    if ( damage > 0 && !random(flag) && weapon )
    {
        message_vision(HIR"\n\n$N一击得手，力贯" + weapon->name() + "直砸的$n全身气血翻涌，眼冒金星，经脉中内息乱串！\n\n"NOR, me, target);
        if ( !target->is_busy() )
        {
            target->start_busy(random(2));
        }

        target->receive_damage("kee", target->query("kee") / 12, me);
        target->receive_damage("sen", target->query("sen") / 24, me);

        target->receive_wound("kee", 1 + random(target->query("kee") / 12), me);

        target->add("force", - target->query("force") / 12);

        COMBAT_D->report_status(target, 1, me, "kee");
        COMBAT_D->report_status(target, 0, me, "sen");
    }

    me->add_temp("apply/attack", -bonus);
    me->add_temp("apply/defense", bonus / 2);
    me->add_temp("apply/damage", -bonus / 2);
    me->delete_temp("qianjun-bang_perform");

    me->receive_damage("sen", 100);
    me->add("force", -100);

    become_enemy(me, target);

    COMBAT_D->start_nomove(me, 4, 1);

    return random(4) + 4;
}

string skill_name(object me, object target, string skill)
{
    return "霹雳三打";
}

