#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int exert(object me, object target)
{
    string msg;
    int skill, damage;

    if ( !target )
    {
        return notify_fail("你要对谁施展这一招「貘虎之齿」？\n");
    }

    limit_status["force"] = 400;

    if ( !can_exert(me, "方寸山三星洞") )
    {
        return 0;
    }

    if ( !me->is_fighting() )
    {
        return notify_fail("貘虎之齿只能在战斗中使用！\n");
    }

    skill = me->query_skill("force");

    msg = HIR"$N突然脸色一变，现出一个虎形，又尖又长的利齿向$n的颈部刺去！\n";
    me->receive_damage("kee", 50);
    me->add("force", -100);

    if ( (int)me->query_int()  > (int)target->query_int() / 2 + random((int)target->query_int() / 2) )
    {
        damage = COMBAT_D->get_mydamage(me, 0, 0, me->query_entire_dbase(), target->query_entire_dbase(), TYPE_EXERT);
        damage += skill - random((int)target->query("max_force") / 10);

        if ( damage > 0 )
        {
            msg += "(只见一片肉血飞扬，$n的颈部被咬出一个血洞！)\n\n" NOR;
            target->receive_wound("kee", damage, me);
            COMBAT_D->report_status(target, 1, me, "kee");
            me->add("bellicosity", damage / 4);
        }
        else
        {
            msg += "结果连皮都没划破！\n" NOR;
        }
    }
    else
    {
        msg += "结果被$n躲开了！\n" NOR;
    }

    message_exert(msg, me, target);

    return 1;
}

