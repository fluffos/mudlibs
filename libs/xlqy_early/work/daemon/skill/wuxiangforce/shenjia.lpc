#include <ansi.h>

inherit FAMILYSKILL;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if (target != me) {
    target = me;
  }

  limit_status["kee"] = 50;
  limit_status["sen"] = 50;
  limit_status["force"] = 100;

  if (!can_exert(me, "方寸山三星洞")) {
    return 0;
  }

  skill = me->query_skill("force");

  me->add("force", -100);

  me->receive_damage("kee", 30);
  me->receive_damage("sen", 30);

  message_exert(HIR "$N微一凝神，运起无极心法，顿时身上像穿了神甲一般!\n" NOR, me);

  me->add_temp("apply/armor", skill / 3);

  set_using(me, __FILE__);
  call_out("remove_effect_using", skill, me, skill / 3);

  return 3;
}

void remove_effect_using(object me, int effect) {
  if (!me) {
    return;
  }

  me->add_temp("apply/armor", -(int)effect);

  message_exert("$N的无极心法运行一周天完毕，神甲渐渐消去了。\n", me);

  ::remove_effect_using(me, __FILE__);
}

string skill_name(object me, object target, string skill) {
  return "神甲";
}
