//【妖华红莲舞】之【百花缭乱】
// 使对手no_move

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int ap, dp, ap2, dp2;
  int howlong;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「百花缭乱」只有在战斗中才能使用。\n");
  if (me->query("family/family_name") != "幻世魔导")
    return notify_fail("非幻世魔导不能用「百花缭乱」！\n");
  if (me->query_skill("charmingdance", 1) < 60)
    return notify_fail("你的妖华红莲舞等级太低了，不能使用「百花缭乱」！\n");

  if (me->query_temp("no_perform") > time())
    return notify_fail("你现在不能使用绝招！\n");

  if (me->query("force") < 200)
    return notify_fail("你的内力不够了！\n");

  if (target->query_temp("no_move"))
    return notify_fail("对方已经眼花缭乱了！\n");

  if (me->query_temp("no_charmingdance_flower") > time())
    return notify_fail("你不能连续使用「百花缭乱」！\n");
  me->set_temp("no_charmingdance_flower", time() + 6 + random(6));


  ap = ((int)me->query_skill("charmingdance", 1)) * 3 / 2;
  ap = ap * ap * ap / 1000 + me->query("combat_exp") / 200 + me->query("daoxing") / 200;
  dp = ((int)target->query_skill(target->query_skill_mapped("dodge"), 1)) * 3 / 2;
  dp = dp * dp * dp / 1000 + target->query("combat_exp") / 100;
  ap2 = me->query_kar() + me->query_skill("spells", 1);
  dp2 = target->query_cps();

  message_vision("\n$N突然越舞越快，身形幻化为千百朵红花，在$n身旁交错飞舞\n\n", me, target);

  if (random(4 * ap + dp) > dp && random(ap2 + dp2) > dp2) {
    message_vision(HIR "$N顿时眼花缭乱，呆呆地无所适从！\n" NOR, target);
    target->set_temp("no_move", 1);
    howlong = random((me->query_skill("charmingdance", 1) - 50) / 2) + 6;
    if (howlong > 45) howlong = 45;
    call_out("free", howlong, target);
    me->set_temp("no_perform", time() + 3);
  } else {
    message_vision(HIG "$N镇定自若，依靠听觉分辨真伪，继续战斗！\n" NOR, target, me);
    me->start_busy(2);
  }
  me->add("force", -150);
  target->kill_ob(me);
  return 1;
}

void free(object target) {
  if (target) {
    target->delete_temp("no_move");
    // 还是去掉message，使机器人更难做点，grin~~
    //     message_vision(HIC "$N终于慢慢恢复了清醒！\n" NOR ,target);
  }
  return;
}
