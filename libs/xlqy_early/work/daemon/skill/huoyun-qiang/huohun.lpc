//火魂

#include <ansi.h>
#include <combat.h>

inherit FAMILYSKILL;

int remove_ansi(object target, object me, int damage, int enhance);

int perform(object me, object target)
{       
    int damage, howlong, enhance;
    object weapon = me->query_temp("weapon");
    mapping action;

    if ( !target )
    {
        return notify_fail("你要攻击谁？\n");
    }

    limit_status["force"] = 500;
    limit_status["sen"] = 500;

    limit_skills["huoyun-qiang"] = 80;
    limit_skills["force"] = 100;

    if ( !can_perform(me, "南海普陀山") )
    {
        return 0;
    }

    if ( !target->is_fighting(me) )
    {
        return notify_fail("只有在战斗中才可以使用「火魂」！\n");
    }

    me->add("force", -200);
    me->add("sen", -100);

    message_perform(HIR"$N突然用手在自家鼻子上锤了两拳，口中喷出火来，手中"NOR + weapon->name() +
        HIR"顿时间红光上涌，焚天炙地，神龙吐信般飞速向$n舞来。\n"NOR, me, target);

    howlong = me->query_skill("spear") / 5;
    enhance = me->query_skill("force") / 2;

    //Here,modified!
    me->add_temp("apply/attack", enhance);  
    damage = me->query_skill("huoyun-qiang", 1) / 2;
    if ( damage > 100 )
    {
        damage = 100;
    }

    action = copy(me->query("actions"));
    damage = action["damage"] * damage / 20;
    me->add_temp("apply/damage", damage);
    me->set("actions", action);
    COMBAT_D->perform_attack(me, target, weapon);
    me->reset_action();

    me->add_temp("apply/attack", -enhance);
    me->add_temp("apply/damage", -damage);
    //End of first enhance
    //============================================================

    //Start of second enhance
    enhance = enhance / 3;
    damage = damage / 3;

    me->add_temp("apply/attack", enhance);
    me->add_temp("apply/damage", damage);
    //bugbug,2002-3-30

    set_using(me, __FILE__);

    call_out("remove_ansi", howlong, target, me, damage, enhance);

    return 1 + random(2);
}

int remove_ansi(object target, object me, int damage, int enhance)
{
    object here;
    string arg;

    if ( !me )
    {
        return 1;
    }

    here = environment(me);

    me->add_temp("apply/attack", -enhance);
    me->add_temp("apply/damage", -damage);

    arg = "$N的脸色渐渐的恢复了正常";
    if ( me->is_fighting(target) )
    {
        arg += "，攻势也缓和了许多";
    }

    message_perform(arg + "！\n", me);

    ::remove_effect_using(me, __FILE__);

    return 1;
}

string skill_name(object me, object target, string skill)
{
    return "火魂";
}

