//【丧神鬼斧】之【兽神怒号】
//攻击对方全部四项指标

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  int damage, ap, dp;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「兽神怒号」？\n");
  if (me->query("family/family_name") != "幻世勇者")
    return notify_fail("非幻世勇者不能使用此项技能！\n");

  if (!me->is_fighting())
    return notify_fail("「兽神怒号」只能在战斗中使用！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 300)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("ghostaxe", 1) < 100)
    return notify_fail("你的丧神鬼斧不够熟练，尚未领悟到这个绝招\n");
  if (me->query_temp("no_ghostaxe_roar") > time())
    return notify_fail("你刚刚吼叫过，不能连续吼叫！\n");
  me->set_temp("no_ghostaxe_roar", time() + 7);


  message_vision(HIR "$N使出丧神鬼斧的绝招：「兽神怒号」！$N突然面向苍穹，
引颈长啸，声震四野，百兽纷纷逃窜，甚至连植物也簌簌发抖！\n" NOR, me, target);
  damage = (int)me->query_skill("ghostaxe", 1) + me->query("force_factor");
  damage = damage / 2 + random(damage);
  damage = 1.3 * damage;

  ap = me->query_skill("axe") + me->query_skill("force");
  ap = ap * ap * ap / 9600;
  ap += (int)me->query("combat_exp") / 100;
  dp = target->query_skill("spells") + target->query_skill("force");
  dp = dp * dp * dp / 9600;
  dp += (int)target->query("combat_exp") / 100;

  //相同水平，成功率1/2

  if (me->query_temp("bianshen"))
    ap *= 2;
  //变身后成功率大大增加

  if (me->query_temp("might_set")) {
    ap += ap / 2;
    damage += damage / 2;
  }
  if (random(ap + dp) > dp) {
    message_vision(RED "\n$n被如此巨大的吼声吓破了胆，感觉五脏六腑都翻腾了起来！\n" NOR, me, target);
    target->receive_damage("kee", damage, me, "phy");
    target->receive_wound("kee", damage / 2, me);
    target->receive_damage("sen", damage, me, "phy");
    target->receive_wound("sen", damage / 2, me);
    target->add("force", -(damage + random(damage)));
    target->add("mana", -(damage + random(damage)));
    if (target->query("force") < 0)
      target->set("force", 0);
    if (target->query("mana") < 0)
      target->set("mana", 0);
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);

    me->set_temp("no_move", 1);
    call_out("remove_no_move", 2 + random(3), me);
  } else {
    message_vision(HIG "\n$n汇聚周身内力与法力，同$N的吼声相抗衡，
吼声渐渐消退，$n毫发未损！\n" NOR, me, target);
    me->start_busy(2 + random(2));
  }
  me->add("force", -200 - me->query("force_factor"));
  return 1;
}

void remove_no_move(object me) {
  if (me) me->delete_temp("no_move");
}

string skill_name(object me, object target, string skill) {
  return "兽神怒号";
}
