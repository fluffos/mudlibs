//作者：tonii@飘渺水云间，2003-4-25于浙大，修改请保留此行。
//【丧神鬼斧】之【兽神变身】
//提高自身能力，可以装备武器，但不能更换，也不能使用cast和perform
//修改的相关文件有：std/skill.c和cmds/std/unwield.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount, int flag);

int perform(object me, object target) {
  int skill;
  object weapon;
  string lv;
  int flag;

  if (me->query("family/family_name") != "幻世勇者")
    return notify_fail("非幻世勇者不能使用此项技能！\n");

  skill = me->query_skill("ghostaxe", 1);
  if (target && target != me)
    return notify_fail("你只能对自己使用兽神变身！\n");
  if (skill < 50)
    return notify_fail("你的丧神鬼斧不够熟练，尚未领悟到这个绝招。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("kee") < 150)
    return notify_fail("你的气血不足。\n");
  if ((int)me->query("sen") < 150)
    return notify_fail("你的精神不足。\n");
  if ((int)me->query_temp("bianshen"))
    return notify_fail("你已经变身了。\n");
  if ((int)me->query_temp("bianshen_2"))
    return notify_fail("你已经变身了。\n");
  weapon = me->query_temp("weapon");
  if ((string)weapon->query("skill_type") != "axe")
    return notify_fail("兽神变身是丧神鬼斧的绝招。\n");
  lv = me->query("skill_level/axe");

  //      if ( skill>=300 ) skill=300;
  if (me->query_temp("might_set")) skill += skill / 2;

  me->add("force", -300);
  me->receive_damage("kee", 50);
  me->receive_damage("sen", 50);

  message_vision(
    HIR "$N一声咆哮，身体突然猛的增长变厚，两眼冒着血红的光芒！\n" NOR, me);

  me->set_temp("No_Unwield", 1);

  me->add_temp("apply/armor", skill / 3);
  me->add_temp("apply/damage", skill / 3);
  me->add_temp("apply/attack", skill / 3);
  me->add_temp("apply/strength", skill / 3);

  me->add_temp("apply/add_phy", skill / 3);
  me->set_temp("bianshen", 1);
  if (lv) {
    me->add_temp("apply/add_max_phy", skill * 5);  // 300 add 15%
    flag = 1;
  }
  if (lv == "master" || lv == "grandmaster") {
    me->delete_temp("bianshen");
    me->set_temp("bianshen_2", 1);

    me->add_temp("apply/combat_ignore_armor", skill * 5);  // 300 add 15%
    flag = 2;
  }
  if (lv == "grandmaster") {
    me->add_temp("apply/combat_double_damage", skill * 5);  // 300 add 15%
    flag = 3;
  }

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 3, flag :), skill);

  if (me->is_fighting()) me->start_busy(1 + random(3));

  return 1;
}

void remove_effect(object me, int amount, int flag) {
  me->add_temp("apply/armor", -amount);
  me->add_temp("apply/damage", -amount);
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/strength", -amount);
  me->add_temp("apply/add_phy", -amount);

  me->delete_temp("No_Unwield");
  me->delete_temp("bianshen");
  me->delete_temp("bianshen_2");

  if (flag == 3)
    me->add_temp("apply/combat_double_damage", -amount * 15);
  if (flag >= 2)
    me->add_temp("apply/combat_ignore_armor", -amount * 15);
  if (flag >= 1)
    me->add_temp("apply/add_max_phy", -amount * 15);

  tell_object(me, "你的变身效果慢慢退去，身体也渐渐复原了。\n");
  return;
}
