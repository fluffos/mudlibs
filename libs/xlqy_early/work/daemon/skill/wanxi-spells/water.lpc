// water.c 【极零裂冻破】
// 伤害对方精神
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {

  if (me->query("family/family_name") != "幻世魔导")
    return notify_fail("非幻世魔导不能使用此项技能！\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「极零裂冻破」？\n");

  if ((int)me->query("mana") < 100 + (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -25 - (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 50) {
    write("你一不小心，念错了咒语。\n");
    return 1;
  }


  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    120,
    //success adjustment
    120,
    //damage adjustment
    "sen",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIC "\n「极零裂冻破」" NOR + HIY "！
只见$N口中念了句咒文，召唤出世界尽头的极寒之水，向着$n奔涌过去！\n" NOR,
    //initial message
    HIR "\n极寒之水瞬间将$n包围，$n被冻得精神恍惚！\n" NOR,
    //success message
    HIC "结果$N的法力不足，极寒之水到了半路便失去方向，流入地下。\n" NOR,
    //fail message
    HIC "但是水势被$n以法力反激，反向$N奔涌回去！\n" NOR,
    //backfire initial message
    HIR "结果极寒之水反将$n包围，$n被冻得精神恍惚！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  me->start_busy(1 + random(2));
  target->kill_ob(me);
  return 3 + random(3);
}

string skill_name(object me, object target, string skill) {
  return "极零裂冻破";
}
