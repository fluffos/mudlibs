inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object who, string arg) {
  object me;
  object where = environment(who);

  if (!arg || !where || !(me = present(arg, where)) || !me->query("ride/msg")) {
    return notify_fail("你想骑什么？\n");
  }

  return me->mount(who);
}

int help(object me) {
  write(@HELP
指令格式 : mount <坐骑名称>

这个指令可以让你骑到坐骑身上。

HELP
  );
  return 1;
}
