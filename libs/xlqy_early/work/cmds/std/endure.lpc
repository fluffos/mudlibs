// by gamer@88 
// endure.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int pts, max_endure = me->query_skill("magic") / 4;

  if (arg == "max" || arg == "half" || arg == "little") {
    if (arg == "max")
      pts = max_endure;
    if (arg == "half")
      pts = max_endure / 2;
    if (arg == "little")
      pts = max_endure / 4;
  } else {
    if (!arg || (arg != "none" && !sscanf(arg, "%d", pts)))
      return notify_fail("指令格式：endure <使出几成灵力伤敌>|none\n");
  }

  if (!me->query_skill_mapped("magic"))
    return notify_fail("你必须先 enable 一种魔法。\n");

  if (arg == "none")
    me->delete("atman_factor");
  else {
    if (pts < 0 || pts > (int)me->query_skill("magic") / 2)
      return notify_fail("你只能用 none 表示不运灵力，或数字表示每一击用几点灵力。\n");
    me->set("atman_factor", pts);
  }

  write("Ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: endure<使出几点内力伤敌>|none
 
这个指令让你指定每次击中敌人时，要发出几点灵力伤敌。

endure none 则表示你不使用灵力。 

SEE ALSO : enable, enchant,enforce
HELP
  );
  return 1;
}
