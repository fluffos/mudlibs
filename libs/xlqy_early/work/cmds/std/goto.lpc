#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  if (!me)  //|| !me->query("can_goto") )
  {
    return 0;
  }

  return "/cmds/eld/goto"->main(me, arg);
}

int help(object me) {
  write(@HELP
指令格式 : goto [-i] <目标>

这个指令会将你传送到指定的目标. 目标可以是一个living 或房间
的档名. 如果目标是living , 你会被移到跟那个人同样的环境.
如果有加上 -i 参数且目标是 living, 则你会被移到该 living 的
的 inventory 中.

HELP
  );
  return 1;
}
