inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object who, string arg)
{
    object me;
    object where = environment(who);

    if ( !arg || !where || !(me = present(arg, where)) || !me->query("ride/msg"))
    {
        return notify_fail ("你想从什么上下来？\n");
    }

    return me->dismount(who);
}

int help(object me)
{
    write(@HELP
指令格式 : mount <坐骑名称>

这个指令可以让你从坐骑上下来。

HELP
);
  return 1;
}

