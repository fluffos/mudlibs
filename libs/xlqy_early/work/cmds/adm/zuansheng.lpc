#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {

  object obj;
  int exp;  //M为单位
  string msg;
  if (me != this_player(1)) return 0;
  if (wiz_level(me) < wiz_level("(admin)"))
    return notify_fail("你没有这种权力。\n");

  if (!arg || sscanf(arg, "%s for %d", arg, exp) != 2)
    return notify_fail("指令格式：zhuansheng <使用者> for <经验值>,such as zhuansheng asdf for 20\n");
  obj = find_player(arg);
  if (!obj)
    return notify_fail("没有这个玩家或者不在线。\n");
  else if (!me->query_temp("zhuansheng_action/" + arg)) {
    me->set_temp("zhuansheng_action/" + arg, 1);
    tell_object(me, HIR "确定？“" + arg + "”请再输入一遍！\n" NOR);
  } else {

    me->delete_temp("zhuansheng_action/" + arg);
    // message("shout", HIW"神力将"+obj->name()+"转入轮回隧道\n"NOR, users());
    obj->move("/d/wiz/zuansheng");

    obj->set("zuansheng/mark", 1);
    obj->set("zuansheng/exp", exp);

  }
  return 1;
}
