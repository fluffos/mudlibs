#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me,string arg)
{
        string msg;
object *ob;
ob = children(USER_OB);
for(int i  =0;i < sizeof(ob);i++)
{
if( (string)SECURITY_D->get_status(ob[i]) == "(admin)" ) 
continue;
 seteuid(ROOT_UID);
if(environment(ob[i])) {
tell_object(ob[i], RED "自己保重吧ⅵ \n " NOR );
ob[i]->save();
}
 destruct(ob[i]);
        if (
ob[i] ) write("你无法把"+arg+"踢出去。\n" );
        else  write("你把"+arg+"踢出去。\n" );
}
        return 1;
}




