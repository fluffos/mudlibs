inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string family;
	int level;
	object ob;

	if( me != this_player() ) return 0;

	me = this_player();

	if( !arg || sscanf(arg, "%s to %d", family, level) != 2 )
		return notify_fail("指令格式: fullskills <门派> to <等级>\n");
    FAMILY_D->full_skills(me, family, level);
    write("Ok.\n");
	return 1;
}

int help(object me)
{
	write(@Help
 指令格式: qiangpo <某人> to <指令>

 强迫某人做某事, 但你的巫师等级必须比对方高。
Help
	);
	return 1;
}


