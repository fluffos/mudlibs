#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object ob;
    int i;

    seteuid(getuid(me));

    if ( !arg )
    {
        ob = me;
    }
    else if ( wizardp(me) )
    {
        ob = present(arg, environment(me));
        if ( !ob )
        {
            ob = find_player(arg);
        }
        if ( !ob )
        {
            ob = find_living(arg);
        }
        if ( !ob )
        {
            return notify_fail("您要察看谁的状态？\n");
        }
    } 
    else
    {
        return notify_fail("只有巫师才可以察看别人的状态。\n");
    }

    if ( system_type() == SYSTEM_64BIT )
    {
        write("存款: " + ob->query("money_count") + "*" + system_maxmoney() + " + " + MONEY_D->money_str(ob->query("balance")) + "\n");
    }
    else
    {
        write("存款: " + ob->query("money_count") + "*" + system_maxmoney() + " + " + ob->query("balance") + "\n");
    }

    return 1;
}

int help(object me)
{
    write(@HELP
指令格式 : money
           money <对象名称>                   (巫师专用)
 
这个指令可以显示你(你)或指定对象(含怪物)的金钱余额。
HELP
    );
    return 1;
}

