//gamer@88 200403
#include <ansi.h>
inherit F_CLEAN_UP;
void add_gift(string arg,object me,string gift);

string *gift_name=({ "kar", "con", "per", "cps", "spi", "int", "cor", "str", });
mapping gift=([
	"str"		: "膂力",
	"cor"		: "胆识",
	"int"		: "悟性",
	"spi"		: "灵性",
	"cps"		: "定力",
	"per"		: "容貌",
	"con"		: "根骨",
	"kar"		: "福缘",
]);
int main(object me, string arg)
{
    if(me->is_busy())	return notify_fail("你正忙着呢...\n");
    if(me->query("attribute_point")-me->query("attributed_point") <= 0)	
    	return notify_fail("你的属性点数不足！\n");
    if (!arg) return notify_fail("请选择你要增加的天赋，参见help attribute。\n");
    if(arg != "str"
    && arg != "cor"
    && arg != "int"
    && arg != "spi"
    && arg != "cps"
    && arg != "per"
    && arg != "con"
    && arg != "kar")
	return notify_fail("这个 "+arg+" 不是一项天赋，请参见help attribute。\n");
    //me->start_busy(1);
    printf("确实要增加"+gift[arg]+"吗？(y/n)\n"); 		
    input_to( (: add_gift :), me,arg);
    return 1;

}
void add_gift(string arg,object me,string gifts)
{
	if(!arg) return;
	if(arg!="y"&&arg!="yes")
		return ;
	me->add(gifts,1);
	me->add("attributed_point",1);
	printf("你的"+gift[gifts]+"增加了一点！\n"); 	
	return ;
}
int help(object me)
{
        write(@HELP
指令格式 : attribute <天赋>

膂力：str    胆识：cor    悟性：int    灵性：spi
定力：cps    容貌：per    根骨：con    福缘：kar

这个指令可以将你积攒的属性点数增加到某个天赋上去。
 
see also : help attributes,help research,help gifts
HELP
    );
    return 1;
}