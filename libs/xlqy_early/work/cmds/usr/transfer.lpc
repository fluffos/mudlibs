// by theone 2005-9-17
//transfer.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int trsf,exp,dx,dif;

	dx=me->query("daoxing");
	exp=me->query("combat_exp");
	dif=exp-dx;

	if(dif<3000000)
		return notify_fail("你的道行和武学差距不是太多，不需要转换！\n");

	if(exp<5000000)
		return notify_fail("你的武学还没达到能转换的程度！\n");

	if(!arg)
		trsf=100000;
            else{
	           if( !sscanf(arg, "%d", trsf) ) 
			return notify_fail("指令格式：transfer<转换的武学点数>\n");
	}

	if( ( (exp-trsf)-(dx+trsf*8/10) )<3000000)
			return notify_fail("你不能一次转换这么多！\n");


	if(trsf<1000)  return notify_fail("最少转换1000点!\n");

	me->add("combat_exp",-trsf);
	me->add("daoxing",trsf*8/10);

	write("OK.\n");

	return 1;

}

int help (object me)
{
	write(@HELP
指令格式: transfer <要转化成道行的武学点数>
 
这个指令让你将武学转化为道行，消除由于不注意平衡任务造成的武学道行的不平衡。
当然有一些条件，而且10点武学转化为8点道行，即1w武学可转化为8年道行。

HELP
	);
	return 1;
}

