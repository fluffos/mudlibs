#include <ansi.h>
#include <skill.h>
#include "/cmds/std/valid_kill.h";
#define CONJ_D(x) ("/daemon/conjure/"+ x)

inherit F_CLEAN_UP;

string *gm = ({ "buddhism", "taiyi", "dao", "pingtian-dafa", "taoism",
  "seashentong", "yaofa", "gouhunshu", "moonshentong", "dengxian-dafa", "pansi-dafa" });
string *master = ({ "dao", "pingtian-dafa", "taoism", "seashentong", "yaofa",
  "gouhunshu", "moonshentong", "dengxian-dafa", "pansi-dafa" });
string *expert = ({ "taoism", "seashentong", "yaofa", "gouhunshu",
  "moonshentong", "dengxian-dafa", "pansi-dafa" });
string *normal = ({ "dengxian-dafa", "pansi-dafa" });

void destruct_flag(object me);
// conjure scroll as bighammer on guai
// conjure scroll as heal

int main(object me, string arg) {
  string spells, scr, spl, trg, fashu, slvl;
  object target, scroll;
  int level, nocast;

  seteuid(getuid());
  if (me->query("family/family_name") != "幻世魔导")
    return 0;
  if (me->query_skill("wanxi-spells", 1) < 100)
    return notify_fail("你的万息降临法修为不足！\n");
  spells = me->query_skill_mapped("spells");
  if (!spells)
    return notify_fail("你请先用 enable 指令选择你要使用的咒文系。\n");
  else if (spells != "wanxi-spells")
    return notify_fail("你所学法术没这种功能。\n");

  if ((int)me->query_temp("no_conjure") == 1)
    return notify_fail("你现在不能用魔法！\n");
  if ((int)me->query_temp("jinzhou") == 1)
    return notify_fail("你正处于禁咒状态中！\n");

  if (me->is_busy())
    return notify_fail("( 你上一个动作还没有完成，不能念咒文。)\n");

  if (!wizardp(me) && environment(me)->query("no_magic"))
    return notify_fail("这里不准念咒文。\n");

  if (!arg) return notify_fail("指令格式：conjure <卷轴> as <法术名称> [on <目标>]\n");

  if (sscanf(arg, "%s as %s on %s", scr, spl, trg) == 3) {
    scroll = present(scr, me);
    if (!scroll) return notify_fail("你身上没有这个卷轴啊。\n");

    target = present(trg, environment(me));
    if (!target) target = present(trg, me);
    if (!target) return notify_fail("这里没有 " + trg + "。\n");

    if (target->query("taskguai")) {
      if (target->query("owner") && me != target->query("owner"))
        return notify_fail(target->query("name") + "瞪了你一眼，你连忙把念了一半的咒语吞回肚子。\n");
    }


    if (!valid_kill(me, target, 0)) return 0;

    //add by yudian for prevent pk

    set_to_killer(me, target);
    if (me->query("combat_exp") < 500000 && userp(target))
      return notify_fail("自己功夫没练好就想杀人？\n");

    if (me->query("daoxing") < 200000 && userp(target))
      return notify_fail("自己功夫没练好就想杀人？\n");

    if (userp(target) && target->query("age") < 18)
      return notify_fail("本站暂时保护新手。\n");


    if (userp(me) && userp(target) &&
      target->query_temp("netdead"))
      return notify_fail("对方正在断线中，不能对其施法。\n");
  } else if (sscanf(arg, "%s as %s", scr, spl) == 2) {

    scroll = present(scr, me);
    if (!scroll) return notify_fail("你身上没有这个卷轴啊。\n");
    target = 0;

  } else return notify_fail("指令格式：conjure <卷轴> as <法术名称> [on <目标>]\n");

  if (!scroll->query("fashu")) return notify_fail("这是什么玩意？也能用来放法术？\n");
  fashu = scroll->query("fashu");
  slvl = me->query("skill_level/spells");
  if (!slvl && member_array(fashu, normal) == -1)
    return notify_fail("你现在的法术等级尚不足驱动这个卷轴\n");
  if (slvl == "expert" && member_array(fashu, expert) == -1)
    return notify_fail("你现在的法术等级尚不足驱动这个卷轴\n");
  if (slvl == "master" && member_array(fashu, master) == -1)
    return notify_fail("你现在的法术等级尚不足驱动这个卷轴\n");
  if (!scroll->query("cast_item/" + spl))
    return notify_fail("该卷轴没这个法术啊。。。\n");

  if (!slvl) level = 5;
  if (slvl == "expert") level = 6;
  if (slvl == "master") level = 8;
  if (slvl == "grandmaster") level = 9;

  spl = replace_string(spl, " ", "_");
  spells = fashu + "/" + spl;

  me->set_temp("special_spells", fashu);
  message_vision(
    BLINK + HIW "只见$N从怀中掏出一张" + scroll->query("name") + BLINK + HIW "，将灵力注入到其中！\n" NOR,
    me
  );
  nocast = (int)call_other(CONJ_D(spells), "cast", me, target, level);

  me->delete_temp("special_spells");
  scroll->move("/obj/void");
  call_out("dest_sc", 1, scroll);
  if (nocast) {
    me->set_temp("no_conjure", 1);
    me->set_temp("no_move", 1);
    call_out("destruct_flag", nocast, me);
    return 1;
  }
  return 0;
}



void destruct_flag(object me) {
  if (me) {
    me->delete_temp("no_conjure");
    me->delete_temp("no_move");
  }

}

void dest_sc(object sc) {
  if (sc) destruct(sc);
}
int help(object me) {
  write(@HELP
指令格式：conjure <卷轴> as <法术名称> [on <目标>]

HELP
  );
  return 1;
}
