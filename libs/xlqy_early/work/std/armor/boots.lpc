// boots.c

#include <armor.h>

inherit EQUIP;

void setup()
{
    if ( clonep(this_object()) )
    {
        return;
    }

    set("rigidity", 120 + random(50));
    set("armor_type", TYPE_BOOTS);

    if ( !query("armor_apply/dodge")
        && weight() > 3000 )
    {
        set("armor_prop/dodge", -weight() / 3000 );
    }
}

