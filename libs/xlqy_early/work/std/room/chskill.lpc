inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "练功室");
  set("long", @LONG

这是一个石室，隐约可以感觉到四周是坚硬的石壁(bi)，石洞内
干干净净，一尘不染。可以使用命令: menpai combat level分别
设置对方的门派、出绝招频率和级别。halt结束战斗。
LONG);

  set("exits", ([
    "out": "/d/city/kezhan",
  ]));
  set("objects",
    ([  //sizeof() == 1
    "/quest/tester/tester": 1,
    ]));

  set("alternative_die", 1);

  setup();
}

void init() {
  add_action("do_halt", "halt");
}

int do_halt() {
  object me = this_player();

  if (!me->is_fighting()) {
    return notify_fail("你现在并没有在战斗。\n");
  }

  me->remove_all_killer();
  message_vision("$N用巫师的神力停止了这场打斗。\n", me);
  write("Ok.\n");
  return 1;
}

void alternative_die(object who) {
  if ("wuguan dizi" == who->query("id")) {
    who->recover_me();
  }
}
