inherit NEWSKILL;

#include <ansi.h>

int valid_enable(string usage)
{
    return usage == "spells";
}

int practice_skill(object me)
{
    return notify_fail("法术技能只能向师父学，或是从运用(cast)中增加熟练度。\n");
}

int valid_learn(object me, string name)
{
    if ( (int)me->query_skill("spells", 1) < 10 
        || (int)me->query_skill("spells", 1) <= (int)me->query_skill(name, 1) )
    {
        return notify_fail("你的法术修为还不够高深，无法学习" + to_chinese(name) + "。\n");
    }

    return 1;
}

string type()
{
    return "spells";
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
    int damage;
    int kee = (int)me->query("kee");

    me->add("mana", -factor);
    if ( 0 > me->query("mana") )
    {
        me->set("mana", 0);
    }
    damage = (int)me->query("mana") / 20 + factor - (int)victim->query("mana") / 25;

    if ( damage < 0 )
    {
        if ( random(victim->query_skill("spells")) > me->query_skill("spells") / 2 )
        {
            damage = -damage;
            me->receive_damage( "kee", damage * 2 );
            me->receive_wound( "kee", damage );

            if ( damage * 60 < kee )
            {
                return "$N受到$n的法力反震，闷哼一声。\n";
            }
            else if ( damage * 40 < kee )
            {
                return "$N被$n以法力反震，「嘿」地一声退了两步。\n";
            }
            else if ( damage * 20 < kee )
            {
                return "$N被$n以法力一震，胸口有如受到一记重击，连退了五六步！\n";
            }
            else
            {
                return "$N被$n的法力一震，眼前一黑，身子向后飞出丈许！！\n";
            }
        }

        if ( damage_bonus + damage < 0 )
        {
            return -damage_bonus;
        }

        return damage;
    }

    damage -= victim->query_temp("apply/armor_vs_spells");
    if ( damage_bonus + damage < 0 )
    {
        return -damage_bonus;
    }

    if ( random(me->query_skill("spells")) < damage )
    {
        return damage;
    }

    return 0;
}

