inherit NEWSKILL;

#include <ansi.h>

int valid_enable(string usage)
{
    return usage == "force";
}

int practice_skill(object me)
{
    return notify_fail("内功心法只能向师父学，或是从运用(exert)中增加熟练度。\n");
}

mapping query_heal_cfg()
{
    return 0;
}

int exert_heal(object me)
{
    int minforce = 50;
    int mineffkee = 2;
    int subforce = 50;
    int curekee = me->query("max_kee") / 20;
    int submana = 50;
    int curesen = me->query("max_kee") / 20;
    int subatman = 50;
    int curegin = me->query("max_kee") / 20;
    string msg = "$N坐下来运功疗伤，脸上一阵红一阵白，不久，吐出一口瘀血，脸色看起来好多了。";

    mapping force_cfg;

    if ( me->is_fighting() )
    {
        return notify_fail("战斗中运功疗伤？找死吗？\n");
    }

    if ( (int)me->query("force") < minforce )
    {
        return notify_fail("你的真气不够。\n");
    }

    if ( (int)me->query("eff_kee") * mineffkee < (int)me->query("max_kee") )
    {
        return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
    }

    write( HIW "你全身放松，坐下来开始运功疗伤。\n" NOR);
    if ( mapp(force_cfg = query_heal_cfg()) && !undefinedp(force_cfg["desc"]) )
    {
        msg = force_cfg["desc"];
    }
    message_combatd(HIW + msg + "\n"NOR, me, 0, "");

    me->receive_curing("kee", curekee );
    me->add("force", -subforce);

    me->receive_curing("sen", curesen );
    me->add("mana", -submana);

    me->receive_curing("gin", curegin );
    me->add("atman", -subatman);

    return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
    int damage;
    int kee = (int)me->query("kee");

    me->add("force", -factor);
    if ( 0 > me->query("force") )
    {
        me->set("force", 0);
    }

    damage = (int)me->query("force") / 20 + factor - (int)victim->query("force") / 25;

    if ( damage < 0 )
    {
        if ( !me->query_temp("weapon")
            && random(victim->query_skill("force")) > me->query_skill("force") / 2 )
        {
            damage = -damage;
            me->receive_damage( "kee", damage * 2 );
            me->receive_wound( "kee", damage );

            if ( damage * 60 < kee )
            {
                return "$N受到$n的内力反震，闷哼一声。\n";
            }
            else if ( damage * 40 < kee )
            {
                return "$N被$n以内力反震，「嘿」地一声退了两步。\n";
            }
            else if ( damage * 20 < kee )
            {
                return "$N被$n以内力一震，胸口有如受到一记重击，连退了五六步！\n";
            }
            else
            {
                return "$N被$n的内力一震，眼前一黑，身子向后飞出丈许！！\n";
            }
        }

        if ( damage_bonus + damage < 0 )
        {
            return -damage_bonus;
        }

        return damage;
    }

    damage -= victim->query_temp("apply/armor_vs_force");
    if ( damage_bonus + damage < 0 )
    {
        return -damage_bonus;
    }

    if ( random(me->query_skill("force")) < damage )
    {
        return damage;
    }

    return 0;
}

