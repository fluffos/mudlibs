inherit NEWNPC;

#include <ansi.h>

void create()
{
    ::create();
}

void generate_me(object who, int level, int ratio, int period, int chance, int combatchance, string name, string *id, int userflag)
{
    ::generate_me(who, level, ratio, "方寸山三星洞", chance, combatchance, name, id, userflag);
    ::set_period(period);
    set("taskguai", 0); 
    set("gender", "男性" );
    set("class", "taoist");
    set("attitude", "friendly");
    set("rank_info/respect", "道长");
    set("shen_type", 1);
}

void attempt_apprentice(object ob)
{
    command("pat " + ob->query("id"));
    command("say 好，希望" + RANK_D->query_respect(ob) + "多加努力，把我们方寸山三星洞发扬光大。\n");
    command("recruit " + ob->query("id") );
    return;
}

int recruit_apprentice(object ob)
{
    if ( ::recruit_apprentice(ob) )
    {
        ob->set("class", "taoist");
    }
}

