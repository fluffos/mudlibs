inherit F_DBASE;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_BACKUP;

#define NEWSAVE_PATH    DATA_DIR"newnpc/"

void create()
{
    set("save_path", NEWSAVE_PATH);
}

void set_savepath(string savepath)
{
    if ( '/' != savepath[strlen(savepath) - 1] )
    {
        set("save_path", DATA_DIR + savepath + "/");
    }
    else
    {
        set("save_path", DATA_DIR + savepath);
    }
}

// This is used by F_SAVE to determine the filename to save our data.
string query_save_file()
{
    string id;

    id = query("id", 1);

    if ( !id )
    {
        id = geteuid();
    }
    if ( !id )
    {
        id = getuid();
    }
    if ( !stringp(id) )
    {
        return 0;
    }

    return sprintf(query("save_path") + "%c/%s", id[0], id);
}

// save(1) will only save player data, do not touch autoload.
// used by /feature/vendor_sale.
// normal save should use save() or save(0).
// mon 5/12/98
int save(int raw)
{
    int res;

    if ( !raw )
    {
        save_autoload();
    }
    res = ::save();
    if ( !raw )
    {
        clean_up_autoload();        // To save memory
    }
    return res;
}

int restore()
{
    string file;

    if ( stringp(file = this_object()->query_save_file()) )
    {
        return restore_object(file);
    }

    return 0;
}

int backup()
{
    int res;

    save_autoload();
    res = ::backup();
    clean_up_autoload();        // To save memory
    return res;
}

void self_destroy()
{
    if ( this_object() )
    {
        destruct(this_object());
    }
}

void purge()
{
	seteuid(getuid());

	rm( query_save_file() + __SAVE_EXTENSION__ );
}

