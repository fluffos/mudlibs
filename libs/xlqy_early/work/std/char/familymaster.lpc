inherit JOBMASTER;

#include <ansi.h>

void re_rank(object who);
void rank_player(object who);
string ask_mieyao(object who);
string expell_me(object who);
string ask_equip(object who);
int ask_research();
int ask_chskill();

void set_inquiry(string askjob) {
  set("inquiry", ([
    askjob: (: ask_mieyao :),
    "job": (: ask_mieyao :),
    "leave": (: expell_me :),
    "装备": (: ask_equip :),
    "闭关": (: ask_research :),
    "试招": (: ask_chskill :),
  ]));
}

int ask_research() {
  object me = this_player();

  if (me->query_family() != this_object()->query_family()) {
    message_vision("$N非我门人!\n", me);
    return 1;
  }

  me->move("/d/" + query("path") + "/research.lpc");

  return 1;
}

int ask_chskill() {
  object me = this_player();
  int i;
  string path;
  object newob;
  object targetnpc;

  if (me->query_family() != this_object()->query_family()) {
    message_vision("$N非我门人!\n", me);
    return 1;
  }

  for (i = 1; i < 11; i++) {
    path = "/d/" + query("path") + "/practice" + i;
    newob = load_object(path);
    if (!newob) {
      continue;
    }

    targetnpc = first_inventory(newob);
    while (targetnpc) {
      if (userp(targetnpc)) {
        break;
      }

      targetnpc = next_inventory(targetnpc);
    }

    if (targetnpc) {
      continue;
    }

    me->move(path);
    break;
  }

  if (i >= 11) {
    tell_object(me, "练功房已满!\n");
  }

  return 1;
}

void init() {
  ::init();
  rank_player(this_player());
  add_action("do_agree", "agree");
}

int can_recruit(object who) {
  return 1;
}

void attempt_apprentice(object who) {
  object me = this_object();

  who = this_player();

  if (who->query_family() != me->query_family()) {
    command("shake");
    command("say 我不收外门弟子，" + RANK_D->query_respect(who) + "还是另寻他人吧！\n");
    return;
  }

  if (0 == can_recruit(who)) {
    return;
  }

  command("smile");
  command("say 很好，" + RANK_D->query_respect(who) + "多加努力，他日必定有成。\n");
  command("recruit " + who->query("id"));

  return;
}

string expell_me(object who) {
  object me = this_object();

  who = this_player();

  if (who->query_family() != me->query_family()) {
    return "我不知道。\n";
  }

  command("say 你既是执意出师，为师却有几句话说。");
  who->set_temp("betray", who->query_family());

  return ("既是要出师，却需受门规惩罚，你可愿意(agree)?");
}

void betray_punish(object who) {
  return;
}

int do_agree(string arg) {
  object me = this_object();
  object who = this_player();

  if (who->query_temp("betray") != who->query_family()) {
    return 0;
  }

  message_vision("$N答道：弟子愿意。\n\n", who);
  who->delete_temp("betray");
  who->add("betray/count", 1);
  who->add("betray/" + who->query_family(), 1);

  command("say 既是池浅容不下蛟龙，你这就速速离开吧！");

  who->set("combat_exp", who->query("combat_exp") / 100 * 80);
  who->set("daoxing", who->query("daoxing") / 100 * 80);

  ("/adm/daemons/family/" + FAMILY_D->query_family_path(who->query_family()))->leave_family(who);

  who->delete("family");
  who->delete("class");
  who->delete("faith");
  who->delete("weiwang");

  LEVEL_D->expell_ob_level_penalty(who);

  who->set("title", "普通百姓");
  who->set("faith", 0);
  who->save();

  command("say 江湖风波，善恶无形，好自为之。。。\n");

  return 1;
}

string job_msg() {
  return "";
}

string ask_mieyao(object who) {
  object me = this_object();
  string result;

  who = this_player();

  if (who->query_family() != me->query_family()) {
    return (who->name(1) + "，你是怎么混进来的?\n");
  }

  if (userp(who) && who->query("level") < 101) {
    return (who->name(1) + "，你的修为不够，练好了再来！\n");
  }

  if ("" != job_msg()) {
    tell_room(environment(me), me->query("name") + job_msg());
  }

  result = "/quest/menpai/mieyao"->query_yao(who);

  if (who->query("job/menpai") && "asked" == who->query("job/menpai/step")) {
    MONITOR_D->report_job_msg(who->name(1) + "(" + who->query("id") + ")接到了一个门派任务，"
      +who->query("job/menpai/name") + "(" + who->query("job/menpai/id")
      + ")在" + who->query("job/menpai/place") + "！\n");
  }

  return who->name(1) + "，" + result;
}

void re_rank(object who) {}

void rank_player(object who) {
  object me = this_object();

  who = this_player();

  if (who->query_family() != me->query_family()) {
    return;
  }

  re_rank(who);
}

string ask_equip(object who) {
  object me = this_object();

  who = this_player();

  if (who->query_family() != me->query_family()) {
    return (who->name(1) + "，你是怎么混进来的?\n");
  }

  FAMILY_D->family_give_equip(who);

  return (who->name(1) + "，拿去吧。\n");
}
