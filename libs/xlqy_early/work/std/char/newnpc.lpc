inherit NPC;
inherit F_MASTER;

#include <ansi.h>
#include "school.h"

void create() {
  if (clonep()) {
    set_default_object(__FILE__);
  }

  NEWNPC_D->setup_basic(this_object());

  ::create();

  setup();
}

object owner() {
  return query("owner");
}

int random_move() {
  return NEWNPC_D->random_move(this_object());
}

void full_me() {
  NEWNPC_D->full_me(this_object());

  return;
}

void setup_again() {
  NEWNPC_D->setup_again(this_object());

  return;
}

varargs void generate_me(
  object who,
  int level,
  int ratio,
  string menpai,
  int chance,
  int combatchance,
  string name,
  string *id,
  int userflag
) {
  NEWNPC_D->generate_me(
    this_object(),
    who,
    level,
    ratio,
    menpai,
    chance,
    combatchance,
    name,
    id,
    userflag
  );

  return;
}

int query_period() {
  return NEWNPC_D->query_period(this_object());
}

int query_lastcmd() {
  return NEWNPC_D->query_lastcmd(this_object());
}

int query_maxattack() {
  return NEWNPC_D->query_maxattack(this_object());
}

void set_period(int period) {
  NEWNPC_D->set_period(this_object(), period);
  return;
}

void set_maxattack(int attack) {
  NEWNPC_D->set_maxattack(this_object(), attack);
  return;
}
