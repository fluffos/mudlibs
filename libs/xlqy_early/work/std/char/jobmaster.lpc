inherit NEWNPC;

#include <ansi.h>

int do_kill(string arg);

void create()
{
    set("per", 30);
    set("int", 30);
    set("str", 30);
    set("cps", 30);

    set("max_kee", 1100);
    set("max_gin", 1100);
    set("max_sen", 1100);

    set("force", 2300);
    set("max_force", 1200);
    set("force_factor", 80);
    set("max_mana", 1200);
    set("mana", 2300);
    set("mana_factor", 60);

    set("combat_exp", 800000);
    set("daoxing", 120000);

    set("eff_dx", 250000);
    set("nkgain", 400);

    set("jobmaster", 1);
}

void init ()
{
    add_action("do_kill", "kill");
    add_action("do_kill", "steal");
    add_action("do_kill", "ji");
}

int accept_fight(object me)
{
    tell_object(me, "我还有正事，不能随意动武!\n");
    return 0;
}

int do_kill(string arg)
{
    object who = this_player();

    if ( id(arg) )
    {
        tell_object(who, "我还有正事，不能随意动武!\n");
        return 1;
    }

    return 0;
}

varargs int receive_damage(string type, int damage, object who, string kind)
{
    return 0;
}

varargs int receive_wound(string type, int damage, object who)
{
    return 0;
}

void kill_ob (object ob)
{
    return;
}

void die()
{
    this_object()->recover_me();
}

void unconcious()
{
    die();
}

int return_home()
{
    if ( !this_object()->query("home") )
    {
        this_object()->set("home", environment());
        return 0;
    }

    return NEWNPC_D->return_home(this_object(), this_object()->query("home"));
}

void heart_beat()
{
    return_home();

    ::heart_beat();
    set_heart_beat(HEART_BEAT_TICK);
}

