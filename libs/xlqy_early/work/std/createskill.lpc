#include <ansi.h>

inherit NEWSKILL;

string* skill_head = ({});
string* skill_tail = ({});

varargs mapping query_action(object me, object weapon, string createname)
{
    mapping* m_actions;
    int index;

    if ( createname && (index = me->query_temp(createname + "_perform")) )
    {
        return specify_action(me, weapon, index);
    }

    if ( !createname || !stringp(createname) || !(m_actions = me->query("skill_" + createname)) 
        || 0 >= sizeof(m_actions) || random(4) )
    {
        return ::query_action(me, weapon);
    }

    return m_actions[random(sizeof(m_actions))];
}

void skill_improved(object me, string skill, string type)
{
    int m_skill = me->query_skill(skill, 1);

    if ( m_skill > 200 && m_skill % 10 == 0 )
    {
        tell_object(me, HIW"你对" + to_chinese(skill) + "的领悟加深了，你的" + to_chinese(skill) + "进入了一个新的境界！\n"NOR);
        if ( random(me->query("kar")) < 20 )
        {
            tell_object(me, HIW"然而你的心中居然产生了一种失落感！\n"NOR);
            return;
        }

        if ( random(me->query("int")) < 20 )
        {
            tell_object(me, HIW"然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
            return;
        }

        tell_object(me, HIW"你突然福至心灵，对" + to_chinese(skill) + "领悟出了一招新的用法！\n"NOR);
        tell_object(me, "请为这招取一个名字：");
        input_to( (: call_other, SKILL_D(skill), "name_skill", me, skill, type:));
    }

    return;
}

void setup_skill_head()
{
}

void name_skill(object me, string skill, string type, string arg)
{
    mapping* m_actions;
    mapping m_act = ([]);
    int content;
    string msg;

    m_actions = me->query("skill_" + skill);
    if ( !pointerp(m_actions) )
    {
        m_actions = ({});
    }

    content = me->query("str") + 2 * me->query_skill("unarmed", 1) / 10;
    m_act += (["damage" : content]);

    content = -me->query("spi");
    m_act += (["dodge" : content]);

    content = -me->query("cps");
    m_act += (["parry" : content]);

    content = me->query("con") + me->query_skill("force", 1) / 10;
    m_act += (["force" : content]);

    m_act += (["damage_type" : type]);

    if ( !arg || arg == "" || arg == " " )
    {
        arg = to_chinese(skill) + "必杀技" + chinese_number(sizeof(m_actions) + 1);
    }
    m_act += (["name" : arg]);

    if ( 0 >= sizeof(skill_head) || 0 >= sizeof(skill_tail) )
    {
        setup_skill_head();
    }

    msg= skill_head[random(sizeof(skill_head))] + BLINK + HIM"「" + arg + "」"NOR
        + skill_tail[random(sizeof(skill_tail))];
    m_act += (["action" : msg]);
    m_actions += ({m_act});
    me->set("skill_" + skill, m_actions);
}

