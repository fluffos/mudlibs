//物品叠加
//edit by rock

#include <ansi.h>

int main(object me,string arg)
{
	object item,*inv;
	int size,i,index = 0;
	string fileName,*file,fileName_2,*file_2;

	if(!arg) return notify_fail("你要叠加什么？\n");

	item = present(arg,me);
	if(!item) return notify_fail("你身上没有这个东西。\n");
	if(!item->query("mosaic_index")) return notify_fail("这件东西不能叠加。\n");

	inv = all_inventory(me);
	size = sizeof(inv);

	fileName_2 = file_name(item);
	file_2 = explode(fileName_2,"#");
	if(!file_2[0]) return notify_fail("物品是父类，无法叠加。\n");

	if(item->query_temp("diejia"))
	{
		item->delete_temp("diejia");
		return notify_fail("取消了叠加该物品。\n");
	}
	item->set_temp("diejia",1);

	//检查相同物品
	for(i=0;i<size;i++)
	{
		fileName = file_name(inv[i]);
		file = explode(fileName,"#");
		
		if(inv[i]->query_temp("diejia")) continue;
		
		if(file[0] && (file[0] == file_2[0]))
		{
			item->add("mosaic_index",inv[i]->query("mosaic_index"));
			item->delete_temp("diejia");
			if(item->query("id") == "christmas guo")
			{
				item->set("name",sprintf(BLINK+HIR"%s个圣诞松果"NOR,chinese_number(to_int(item->query("mosaic_index")))));
			}
			destruct(inv[i]);
			return notify_fail("叠加成功。\n");
		}
	}
	return notify_fail("没有可叠加的物品。\n");
}