// dodge.c
#include <ansi.h>

inherit F_CLEAN_UP;

//void arrive(object, string, string);

int main(object me, string arg)
{
	object ob1;
	object where = environment(me);
	string destin, destch, dodgemsg;
	mapping exit;
	int busytime;
	int cutjingli;

	if( !stringp(me->query_skill_mapped("dodge")) )
		return notify_fail("你必须先用 enable 选择你要用的轻功。\n");

	if( me->query_skill("dodge", 1) < 10 ) 
		return notify_fail("你的基本轻功还不够，无法施展轻功。\n");

	if( me->query_skill("dodge") < 15 ) 
		return notify_fail("你的轻功火侯还不够，无法施展轻功。\n");

	if ((int)me->query("neili") < 50)
		return notify_fail("你的内力不够，无法施展轻功。\n");

	if( !arg ) 
		return notify_fail("你想去哪里？\n");

	if( !mapp(exit = where->query("exits")) ) {
		 if( query_verb()=="dodge")
         return notify_fail("这里没有出路。\n");
	else
		  return 1;
	}

	if( me->is_busy() )
                return notify_fail("你的动作还没有完成，不能移动。\n");

    if (me->query("job/description") == "守卫山门" && objectp(present("zhike daozhang", environment(me))))
               return notify_fail(HIG"\n你不想做这份工了吗？如果不想做了就先放弃吧！\n"NOR);

	//if (where->query("sleep_room") ||  environment(me)->query("no_fight"))
    //    return notify_fail("这里地方太小，无法施展轻功。\n");

	if  (!environment(me)->query("outdoors"))
                return notify_fail("这里地方太小无法施展轻功，到大街上去试试吧。\n");

	if( me->is_ghost() ) {
		message_vision(HIW"\n\n忽然之间白无常不知从哪里冒了出来，白无常对着$N大声喝道：天堂有路你不走，地狱无门你自投。\n\n"+NOR, me );
		message_vision(HIW"\n\n白无常伸出长长的爪子在$N脑后轻轻的拍了一下。\n\n"+NOR, me );	
		me->unconcious();
		//message_vision("白无常拎起昏迷不醒的$N在一阵白雾中消失得无影无踪。\n\n", me );
		me->move("/d/death/gate");
		//me->move("/d/shaolin/shanmen");
		//
		CHANNEL_D->do_channel(me, "rumor", sprintf("%s已经被白无常捉拿归案。", me->query("name")));
		return 1;
	}

	if( me->query_condition("hz_job") ) 
		 return notify_fail("岳不群掌门人有令：不许俺们巡山弟子出山！\n");

   if( me->is_fighting() )
		 return notify_fail("你正在战斗中！请先停止战斗再施展轻功。\n");

	if( me->is_busy() ) 
		 return notify_fail("你现在正忙着，暂时还不能施展轻功。\n");

	 if( me->over_encumbranced() )
         return notify_fail("你的负荷过重已经动弹不得，怎能施展轻功？\n");

	 if( me->query("jingli") < me->query("max_jingli")/5 )
        return notify_fail("你已经精疲力尽，动弹不得。\n");

     if(!where) 
		 return notify_fail("你哪里也去不了。\n");

	if( me->query("rided")) 
		return notify_fail("你现在骑着马，要施展轻功请先下马。\n");

	 if( present( "biao che", environment(me) )  && me->query_temp("riding") )
                        return notify_fail("你正坐在镖车上呢！\n");

	if(me->query_temp("cannot_move"))
                        if(me->query_temp("cannot_move_msg"))
                                return notify_fail(me->query_temp("cannot_move_msg")+"\n");
                        else
                                return notify_fail("你现在不能移动。\n");


	if( arg == "wudang" || arg == "武当" || arg == "wd"  ) {
		destin = "/d/wudang/shanmen";
		destch = "武当";
	} else if( arg == "shaolin" || arg == "少林" || arg == "sl") {
		destin = "/d/shaolin/shanmen";
		destch = "少林";
	} else if( arg == "yangzhou" || arg == "扬州" || arg == "yz" ) {
		destin = "/d/city/kedian";
		destch = "扬州";
	} else if( arg == "xingxiu" || arg == "星宿"  || arg == "xx" ) {
		destin = "/d/xingxiu/xxh2";
		destch = "星宿海";
	} else if( arg == "shenlong" || arg == "神龙" || arg == "塘沽" || arg == "slj" ) {
		destin = "/d/beijing/tanggu";
		destch = "塘沽口";
	} else if( arg == "quanzhou" || arg == "泉州" || arg == "qz" ) {
		destin = "/d/quanzhou/zhongxin";
		destch = "泉州";
        } else if( arg == "mingjiao" || arg == "明教" || arg == "mj" ) {
                destin = "/d/mingjiao/westroad1";
                destch = "明教";
	} else if( arg == "huashan" || arg == "华山" || arg == "hs" ) {
		destin = "/d/huashan/yunu";
		destch = "华山";
	} else if( arg == "taishan" || arg == "泰山" || arg == "ts" ) {
		destin = "/d/taishan/wudafu";
		destch = "泰山";
	} else if( arg == "emei" || arg == "峨嵋" || arg == "em" ) {
		destin = "/d/emei/baoguomen";
		destch = "峨嵋山";
	} else if( arg == "xueshan" || arg == "雪山" || arg == "xs" ) {
		destin = "/d/xueshan/shanmen";
		destch = "大雪山";
	} else if( arg == "dali" || arg == "大理" || arg == "dl" ) {
		destin = "/d/dali/wangfu1";
		destch = "大理国"; 
	} else if( arg == "xixia" || arg == "西夏" || arg == "xxg" ) {
		destin = "/d/xixia/oldwall";
		destch = "西夏国";
	} else if( arg == "hangzhou" || arg == "杭州" || arg == "hz" ) {
		destin = "/d/hangzhou/kedian";
		destch = "杭州";
	} else if( arg == "lanzhou" || arg == "兰州" || arg == "lz" ) {
		destin = "/d/qilian/lanzhou";
		destch = "兰州";
	} else if( arg == "foshan" || arg == "佛山" || arg == "fs" ) {
		destin = "/d/foshan/ngate";
		destch = "佛山";
	} else if( arg == "zhongnanshan" || arg == "zhongnan" || arg == "终南山" || arg == "zns" ) {
		destin = "/d/zhongnan/shenheyuan";
		destch = "终南山";
	} else if( arg == "dongbei" || arg == "东北" || arg == "changbai" || arg == "长白山" || arg == "db" ) {
		destin = "/d/changbai/jishi";
		destch = "东北";
	} else if( arg == "gumu" || arg == "古墓" || arg == "gm" ) {
		destin = "/d/gumu/gumu";
		destch = "古墓";
	} else if( arg == "beijing" || arg == "北京" || arg == "bj" ) {
		destin = "/d/beijing/changanjie";
		destch = "北京";
	} else if( arg == "lingjiu" || arg == "灵鹫" || arg == "lj" ) {
		destin = "/d/lingjiu/jian";
		destch = "灵鹫";
	} else if( arg == "taohua" || arg == "桃花岛" || arg == "thd" ) {
		destin = "/d/taohua/haitan";
		destch = "桃花岛";
	} else if( arg == "guiyun" || arg == "归云庄" || arg == "gyz" ) {
		destin = "/d/taihu/taihu";
		destch = "归云庄";
	} else if( arg == "baituo" || arg == "白驼山庄" || arg == "bt" ) {
		destin = "/d/xingxiu/btgate";
		destch = "白驼山庄";
	} else {
		write("那边的路不太适合施展轻功。\n");
		return 1;
	}

	dodgemsg = me->query_skill_mapped( "dodge" );

	if ((int)me->query_skill("dodge") < 100)
	{
	message_vision(YEL"\n\n$N用意将丹田之气往上引提，施展出了"+to_chinese(dodgemsg)+"中飞檐走壁的轻身功夫。"+NOR+YEL+"\n\n只见$N屏气凝神用劲全身，纵身一跃朝着"+destch+"方向狂奔而去！"+NOR+"\n\n", me);
	tell_room(environment(me), "一阵风沙过后一切又都恢复了平静。\n\n", me);
	}
	else if ((int)me->query_skill("dodge") < 200)
		{
	message_vision(HIG"\n\n$N微微将丹田之气往上引提，立时觉得身体飘逸，身轻似燕。这正是"+to_chinese(dodgemsg)+"中飞檐走壁的轻身功夫。"+NOR+HIG+"\n\n只见$N纵身一跃，以一种极为飘逸的身形朝着"+destch+"方向飞奔而去！"+NOR+"\n\n", me);
	tell_room(environment(me), "一阵轻风过后一切又都恢复了平静。\n\n", me);
	} else {
	    message_vision(MAG"\n\n$N似有意无意间将丹田之气往上微微引提，顿时身形化作七八个$N。这正是传说中"+to_chinese(dodgemsg)+"的飞檐走壁之绝顶轻功。"+NOR+MAG+"\n\n只见$N轻轻一跃，身形犹如鬼魅般朝着四面八方疾飞而去！"+NOR+"\n\n", me);
	    tell_room(environment(me), "一阵微风过后一切又都恢复了平静。\n\n", me);
	}


/*
	ob1 = new("/clone/room/dodge_room.lpc");
	me->move(ob1);
	busytime = 500/(int)me->query_skill("dodge");
	if (busytime>25) busytime = 25;
	if (busytime<5) busytime = 5;
	me->start_busy(busytime + 1); 
	remove_call_out("arrive");
	call_out("arrive",  busytime, me, destin, destch);

        return 1;
}

void arrive(object me, string destin, string destch) 
{
	*/
	
	cutjingli = 500/(int)me->query_skill("dodge");
	if ( cutjingli < 10) cutjingli = 10;
	if( me ) me->move(destin);
	me->add("jingli", - cutjingli );
	me->add("neili", - 50 );
	me->start_busy(2); 
    if( me->query("jingli") <= 0 ) {
		me->set("jingli", 0);
		me->unconcious();
		message_vision(RED"\n\n$N一路跌跌撞撞来到了"+destch+"，由于体内真气不济$N一头栽倒在地口吐白沫晕死了过去。\n\n"+NOR, me );
		return 1;
	}
    if( me->query("jingli") <= 50 ||  me->query("neili") <= 50 ) {
		message_vision(HIR"\n\n$N一路跌跌撞撞走了过来，由于体内真气不足险些摔倒在地。\n\n"+NOR, me );
		message_vision(HIR"慌乱中$N定神一看！哦，原来已经到了"+destch+"。\n\n"+NOR, me );
		return 1;
	}
	if ((int)me->query_skill("dodge") < 100)
	{
	message_vision(YEL"\n\n也许是连续赶路的原因$N觉得真气有些不畅，于是$N放慢了脚步慢慢停了下来。\n\n"+NOR, me );
	message_vision(YEL"$N张眼四处看了看，然后自言自语的说了声：哦，"+destch+"到了。\n\n"+NOR, me );
	return 1;
	}
	else if ((int)me->query_skill("dodge") < 200)
		{
	message_vision(HIG"\n\n$N施展独门轻功脚底生风、一路飞奔，片刻间便来到了"+destch+"。\n\n"+NOR, me );
	return 1;
	} else {
		message_vision(MAG"\n\n$N施展绝顶轻功身形飘逸、神情悠闲自若，转眼便来到了"+destch+"。\n\n"+NOR, me );
		message_vision(MAG"$N轻嘘一声，丹田之气内敛，以一个美妙之极的姿势轻落于地。\n\n"+NOR, me );
	 return 1;
	}
	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : dodgel <地点简称>
 
这个指令可以让你施展轻功迅速到达目的地。
	扬州 : yangzhou, 扬州, yz
	武当 : wudang, 武当, wd
	少林 : shaolin, 少林, sl
	星宿 : xingxiu, 星宿, xx
	神龙 : shenlong, 神龙, 塘沽, slj
	泉州 : quanzhou, 泉州, qz
	华山 : huashan, 华山, hs
	泰山 : taishan, 泰山, ts
	大理 : dali, 大理, dl
	西夏 : xixia, 西夏, xxg
	杭州 : hangzhou, 杭州, hz
	兰州 : lanzhou, 兰州, lz
	佛山 : foshan, 佛山, fs
	东北 : dongbei, 东北, changbai, 长白山,db
	北京 : beijing, 北京, bj
	古墓 : gumu, 古墓, gm
	大雪山 : xueshan, 雪山, xs
	灵鹫宫 : lingjiu, 灵鹫, lj
	峨嵋山 : emei,峨嵋, em
	终南山 : zhongnanshan, zhongnan, 终南山, zns
	桃花岛 : taohua, 桃花岛, thd
	归云庄 : guiyun, 归云庄, gyz
	白驼山 : baituo, 白驼山庄, bt
HELP
    );
    return 1;
}

