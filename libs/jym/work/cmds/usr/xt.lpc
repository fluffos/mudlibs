inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;  //me=this_player();
  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  }
  if (query_heart_beat(ob)) {
    //write("现在你的心跳正常!!\n");
    printf("现在%|8s的心跳正常!\n", (string)ob->query("name"),);
  } else {
    ob->set_heart_beat(1);
    ob->set_temp("netdead", 0);
    write("恢复心跳完闭!!\n");
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: reheat <玩家的 ID>

这个指令是用来恢复玩家心跳。

HELP
  );
  return 1;
}
