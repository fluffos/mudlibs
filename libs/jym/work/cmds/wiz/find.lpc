//查找物品主人
//2008 9.22

#include <ansi.h>

int main(object me, string id) {
  object find_ob, where;
  object *objs;
  string name, file_name, objs_name, where_name;
  int i, size, index;

  if (!id) return notify_fail("指令格式：find <父类文件存放位置>\n");

  find_ob = find_object(id);
  if (!find_ob) find_ob = find_living(id);
  if (!find_ob) find_ob = find_player(id);

  if (!find_ob) {
    return notify_fail("江湖上没有该物品。\n");
  }

  file_name = file_name(find_ob);
  objs = children(file_name);
  size = sizeof(objs);

  if (size) {
    for (i = 0; i < size; i++) {
      index = 0;
      tell_object(me, sprintf("物品:%O", objs[i]));

      objs_name = objs[i]->query("name");
      if (objs_name) {
        tell_object(me, sprintf(" 中文名:%s", objs_name));
        index++;
      }

      where = environment(objs[i]);
      if (where && where_name = where->query("name")) {
        tell_object(me, sprintf("所处位置:%s\n", where_name));
        index++;
      }

      if (!index) {
        tell_object(me, "所处位置没有中文名。\n");
      }
    }
  }
  return 1;
}
