// reboot.c

#include <login.h>
#include <ansi.h>

int main(object me, string arg) {
  string wiz_status;
  object npc;

  if (me != this_player(1)) return 0;

  wiz_status = SECURITY_D->get_status(me);
  if (wiz_status != "(admin)" && wiz_status != "(arch)")
    return notify_fail("只有 (arch) 以上的巫师才能重新启动" + MUD_NAME + "\n");

  message("system",
    HIW "\t\t【金墉梦】将在五分钟后重新启动！请尽快存档(save)！\n\n" NOR,
    users());
  call_out("countdown", 60, 5);

  return 1;
}

private void countdown(int min) {
  int i, size;
  object *list;

  min--;
  if (min) {
    message("system",
      HIR "\t\t【金墉梦】将在" + chinese_number(min) + "分钟后重新启动！请尽快存档(save)！\n\n" NOR,
      users());
    call_out("countdown", 60, min);
  } else {
    message("system", HIW "\t\t【金墉梦】重新启动，放心您的档案已储存。\n" NOR, users());
    list = children(USER_OB);
    size = sizeof(list);
    for (i = 0; i < size; i++) {
      if (!list[i]) continue;
      //迫使玩家脱掉所有衣服
      "/cmds/std/remove"->main(list[i], "all");
      list[i]->save();
    }
    call_out("do_shutdown", 1);
  }
}

private void do_shutdown() {
  shutdown(0);
}

int help(object me) {
  write(@HELP
指令格式: reboot
 
重新起动游戏, 系统会开始倒数计时, 五分钟後重新起动。
 
HELP
  );
  return 1;
}
