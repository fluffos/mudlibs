dbase (["location":"/d/city/wumiao","no_get":1,"board_id":"wumiao_b","name":"武庙告示板","id":"board","notes":({(["title":"丐帮升袋调整","msg":"丐帮升袋调整为无须bihua player,只需要简长老那里拿到青竹令后找和你同袋数的npc 比划(bihua)就可以了。","time":1167371417,"author":"明老(muder)",]),(["title":"岳小玫任务调整","msg":"yuejob 减少npc出生地点为80个以内，增加了单次job报酬，同时增加了单次job时间必须在60秒以外才能接下一次job","time":1167827603,"author":"明玄(muder)",]),(["title":"增加faq用户指令","msg":"新手可以输入faq查看新手faq帮助指南，本帮助指南将不断更新。","time":1167910696,"author":"明玄(muder)",]),(["title":"华山风清阳收徒条件和逐徒条件调整的通知","msg":"post 华山风清阳收徒条件 修改为必须为风清阳已收弟子少于20人华山风清阳逐徒条件 修改为作为风清阳弟子后死亡3次即被风清阳驱逐出师门成为普通百姓作为风清阳弟子掌握了本mud的至高武功承担一点风险也是应当的。如果你接受不了作为风清阳弟子后死亡3次即被风清阳驱逐出师门成为普通百姓的后果，那请你bai feng前三思！","time":1167969233,"author":"明玄(muder)",]),(["title":"调整 福威镖局 运镖和劫镖报酬","msg":"调整 福威镖局 运镖和劫镖报酬单次任务报酬4000 exp保底, 7000上限","time":1167980543,"author":"明玄(muder)",]),(["title":"离线挂机scheme 无法存档的bug已经修复","msg":"离线挂机scheme 无法存档的bug已经修复有需要使用此功能的请先help scheme 或 help guaji","time":1168051218,"author":"明玄(muder)",]),(["title":"开放 trigger 服务器端触发指令","msg":"开放 trigger 服务器端触发指令详细请见 help trigger","time":1168052395,"author":"明玄(muder)",]),(["title":"雪山派调整法事job","msg":"雪山派调整法事job 遍照雪海(Tong gang) 初始 三十二斛酥油(Su you)addoil xs dizi","time":1168054677,"author":"明玄(muder)",]),(["title":"峨嵋派峨嵋剑法(emei-jian)调整的通知","msg":"当峨嵋剑法(emei-jian)等级大于150级 并且拥有和装备依天剑后峨嵋剑法的普通攻击伤害将接受到原有普通攻击伤害20%的加成当峨嵋剑法(emei-jian)等级大于150级 并且拥有和装备依天剑后峨嵋剑法的pfm juejian攻击伤害将接受到原有攻击伤害15%的加成addoil emei dizi","time":1168082498,"author":"明玄(muder)",]),(["title":"归云庄的正厅(大厅)见黄药师的调整通知","msg":"归云庄的正厅(大厅)见黄药师的机会改为福缘>=20 同时也和force,dodge,strike,qimen-dunjia有效等级,你的exp相关","time":1168228673,"author":"博览会(muder)",]),(["title":"镖局任务调整完毕，正式开放","msg":"rt","time":1168601022,"author":"博览会(muder)",]),(["title":"关于biaoju job的补充","msg":"biaoju job 连续成功完成 100次任务后会有一个比较厉害的npc来抢劫此npc copy你max qi 50% 和 max nei 的60%, 全部技能是他自己exp 上限的40 -50%为什么说是厉害的npc? 因为此npc 会pfm 而且是杀神龙教人物。另外再次调整压镖过程中产生rob的密度，产生rob的密度恢复到gf xkx站点水平。rob 踢骡子的机率更改为1/300","time":1168652429,"author":"博览会(muder)",]),(["title":"关于转生","msg":"1转 需要exp >= 450w 转生后清除所有数据同时增加所有单项先天属性15点，大于45者则45封顶，重生后join 门派获得30w exp 和相关skills neili jingli2转 需要exp >= 570w 转生后清除所有数据同时增加所有单项先天属性12点，大于57者则57封顶，重生后join 门派获得30w exp 和相关skills neili jingli3转 需要exp >= 670w 转生后清除所有数据同时增加所有单项先天属性10点，大于67者则67封顶，重生后join 门派获得30w exp 和相关skills neili jingli4转 需要exp >= 750w 转生后清除所有数据同时增加所有单项先天属性8点，大于75者则75封顶，重生后join 门派获得30w exp 和相关skills neili jingli5转 需要exp >= 800w 转生后清除所有数据同时增加所有单项先天属性5点，大于80者则80封顶，重生后join 门派获得30w exp 和相关skills neili jingli","time":1168696278,"author":"博览会(muder)",]),(["title":"镖局任务报酬和失败再接任务间隔时间的调整","msg":"镖局任务报酬 为 最低1600 最高 3200 一次失败再接任务间隔时间调整为10分钟-20分钟 等待时间和失败无关，改为10分钟-20分钟随机选择！不过角色下线仍然不增加累计时间","time":1168829344,"author":"博览会(muder)",]),(["title":"桃花岛试剑厅调整的通知","msg":"桃花岛试剑厅新增加shijian 指令可以查看当前已获得的剑意条件为 桃花弟子，须装备竹剑，指令: shijian","time":1168840869,"author":"博览会(muder)",]),(["title":"桃花岛yuxiao-jian剑意调整的通知","msg":"玉箫剑法 (yuxiao-jian)  在桃花岛试剑厅练习获得剑意的次数减少一半addoil taohua dizi","time":1168841024,"author":"博览会(muder)",]),(["title":"新增加sholin 燃木刀法的通知","msg":"新增加sholin 燃木刀法 已及其perform xianfo","time":1169448291,"author":"博览会(muder)",]),(["title":"调整自制兵器被击落后拥有者可以再次get","msg":"rt","time":1169453481,"author":"博览会(muder)",]),(["title":"调整自制兵器为攻击力超过100以后可以斩断一般兵器","msg":"rt","time":1169455470,"author":"博览会(muder)",]),(["title":"关于调整ftb_job 收益的通知","msg":"为了最大程度的鼓励手动玩家，先对ftb_job收益做以下调整单次任务完成exp 收益为xkx原始数据的4倍(以前为3倍)单次任务完成exp 收益最高封顶为5000","time":1169711105,"author":"博处会(muder)",]),(["title":"全面下调半路劫匪能力的通知","msg":"鉴于jym目前大部分玩家都是du book到250的读书写字,而抢匪是copy最高技能。现经过研究决定让抢匪只能拥有与玩家同等技能条件，还大家一个公平的游戏环境。","time":1169723754,"author":"博处会(muder)",]),(["title":"终南山冰洞风洞调整的通知","msg":"终南山冰洞风洞调整技能上限为500","time":1170329181,"author":"王老吉(muder)",]),(["title":"关于华山派技能调整的通知","msg":"华山派zixia-gong开放yun zixia提升huashan-jianfa 200级后的攻击力，同时增加气宗yun zixia后huashan-jianfa的auto pfm目前仅测试阶段，如有bug会陆续调整，此次修改非最终决定。","time":1170749573,"author":"博览会(muder)",]),(["title":"fj 测试性开放","msg":"不想做fj的可以set family_job 要事在身,不过必须完成当前fj任务f