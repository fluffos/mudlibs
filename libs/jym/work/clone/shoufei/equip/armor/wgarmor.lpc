#include <armor.h>
#include <ansi.h>
inherit ARMOR;

// 函数：所属类别
int query_xy() { return 1; }

// 函数：构造处理
void create() {
  set_name("无根铠", ({ "wgarmor" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("level", 1);            //装备等级
    set("unit", "件");           //量词
    set("material", "armor");
    set("value", 2500);             //价值
    set("armor_prop/armor", 100);  //物理防御
    set("armor_prop/pp", 0);     //法术防御
    set("armor_prop/hp", 220);     //气血
    set("armor_prop/mp", 70);     //内力
  }
  set("exp", 520000);           //限制经验
  set("max_lasting", 100);   //耐久度

  setup();

  set("gender", "无性");    //限制性别
}

int query_autoload() {
  return 1;                //下线是否保存
}

#include "/clone/shoufei/equip/long/armor.h"
