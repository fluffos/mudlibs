#include <ansi.h>
inherit ITEM;

void create()
{
	set_name("聚灵丹", ({"juling dan"}));
//        set_color("$HIG$");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一颗吸收了些许灵气的神奇丹药，不可食用，但能助人重或新生。\n");
		set("unit", "粒");
		set("base_value", 10000 );
		set("base_unit", "颗");
		set("base_weight", 333);
	}
}

int query_autoload()
{
       return 1;
}
