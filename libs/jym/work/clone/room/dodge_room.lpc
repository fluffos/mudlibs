inherit ITEM;

void create() {
  set_name("施展轻功赶路中", ({ "da che", "che", "carriage" }));
  //set_color("$HIY$");
  set_weight(3000000);
  set_max_encumbrance(5000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", @LONG

施展轻功赶路中 - 

你施展轻功越走越快，路边的美丽景致亦无暇欣赏，一心只想着早些到达目的地，渐渐的你融入了忘我的境地……

LONG
    );

    set("amount", 30);
  }
  setup();
}






