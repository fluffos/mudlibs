#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name( BLU"夜行衣"NOR, ({ "yexing yi", "cloth" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("value", 300);
                set("material", "leather");
                set("armor_prop/armor", 10);
        }
        setup();
}

