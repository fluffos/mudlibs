// zizhuxiao.c 紫竹箫
// zzh 改自玉箫

#include <weapon.h>
#include <ansi.h>
// #include "/clone/unique/special_weapon.h"

inherit F_UNIQUE;
inherit SWORD;

void create()
{
        set_name(HIY"紫竹箫"NOR, ({ "zizhu xiao", "xiao" }) );
        set_weight(2000);
//	set_color(HIY);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "支");
                set("value", 7000);
		  set("rigidity", 1500);
                set("material", "steel");
		  set("no_save",1);
                set("shape", "flute");
                set("long", 
		"一支由四年生紫竹精制而成的萧,管身成浅黄色，雕有细腻而逼真的山水、花草和鸟兽等各种纹饰。\n");
                set("wield_msg",  "$N伸手从背后抽出一支$n。\n");
                set("unwield_msg",  "$N将$n插到领後。\n" NOR);
                set("unequip_msg",  "$N将$n插到领後。\n" NOR);
        }
	init_sword(80);
        setup();
	::create();
}
#include "/d/taohua/obj/flute.h"
#include "/d/taohua/obj/music.h"
