//Cracked by Roath
// yitian-jian.c

#include <ansi.h>
#include <weapon.h>
inherit F_UNIQUE;
inherit SWORD;
#include "/clone/unique/special_weapon.h"
void create() {
  set_name(HIC "飞烟宝剑" NOR, ({ "feiyan jian", "feiyan", "sword" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "一柄天青色四尺五寸长的上古宝剑，古木剑鞘上用金丝镶着两条飞舞的轻烟。\n");
    set("value", 10000);
    set("material", "steel");
    set("rigidity", 2000);
    set("wield_msg",
      HIC "只见蓝光一闪，$N的手中已经多了一柄$n，" + HIC + "幽幽一声～铛～栩栩的回荡在你耳边 !\n" NOR);
    set("unwield_msg", HIG "$N将手中的$n插入腰间的剑鞘。\n" NOR);
    set("unequip_msg", HIG "$N将手中的$n插入腰间的剑鞘。\n" NOR);
  }

  init_sword(150);
  setup();
  ::create();
}
