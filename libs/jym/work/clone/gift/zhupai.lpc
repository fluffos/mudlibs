// bingtang.c 猪排

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
	set_name(HIR"猪排"NOR, ({"zhu pai", "zhupai", "pai"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "盘");
		set("long", "这是一盘肥得流油的猪排，闻一下，香~~。\n");
		set("value", 0);
		set("no_drop",1);
	}
	setup();
}

int do_eat(string arg)
{
	if (!id(arg))
	return notify_fail("你要吃什么？\n");

	this_player()->add("combat_exp", 4000);
	this_player()->add("potential",1000);
	this_player()->add("max_neili",30);
	this_player()->set( "water", this_player()->max_food_capacity() * 10 );
	this_player()->set( "food",  this_player()->max_water_capacity() * 10 );
	message_vision(HIR"新年快乐！恭喜发财！\n\n"NOR, this_player());
	message_vision(HIR"在新的一年里金庸梦祝福你学习进步、工作顺利、心想事成、万事如意、祝大家快快乐乐过猪年、猪年全家幸福，好运常在！\n\n"NOR, this_player());
	message_vision("$N吃下一块巨大的猪排，只觉得自己又变利害了一些 ！\n", this_player());
	destruct(this_object());
	return 1;
}

