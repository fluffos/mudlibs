// bingtang.c 冰糖葫芦

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR"月饼"NOR, ({"bingtang hulu", "mooncake", "yue bing", "yue", "bing"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "串");
                set("long", "这是一个武林人士梦寐以求的超级月饼，据说吃一个可得2000经验，10000潜能。\n");
		set("value", 0);
		set("no_drop",1);
	}
	setup();
}

int do_eat(string arg)
{
	if (!id(arg))
	return notify_fail("你要吃什么？\n");

        this_player()->add("combat_exp", 10000);
        this_player()->add("potential",10000);
        message_vision("$N吃下一个月饼，你得到了10000经验和10000潜能 !\n", this_player());
	destruct(this_object());
	return 1;
}

