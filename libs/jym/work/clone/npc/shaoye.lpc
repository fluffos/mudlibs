//Cracked by Kafei
// shaoye.c	翔少爷 (registrator)

inherit NPC;
inherit F_UNIQUE;

void create()
{
	seteuid(getuid());

	set_name("翔少爷", ({ "xiang shaoye", "xiang", "shaoye" }));
	set("title", "侠客行报名处处长" );
	set("gender", "男性" );
	set("age", 21);
      	set("long","他长的白白胖胖，成天堆着一付笑脸，像中了六合彩似的。\n");
	set("attitude", "heroism");

	set("str", 50);
	set("con", 50);
	set("int", 50);
	set("dex", 50);

	set("max_qi", 500);
	set("eff_qi", 500);
	set("qi", 500);
	set("max_jing", 300);
	set("jing", 300);
	set("neili", 500);
	set("max_neili", 500);
	set("jiali", 40);
	set("shen_type", 0);

	set("no_clean_up",1);


	set_temp("iambusy", 0);

	setup();
}

void init()
{
	add_action("do_register", "register");
	add_action("do_kill", "kill");
}

int check_register(object ob)
{
	if (!ob->is_character())
		return 0;
	if (!ob->query("id"))
		return notify_fail("你的代号是什么？\n");
	if (!ob->query("name"))
		return notify_fail("你的中文名字是什么？\n");
	if (!ob->query("gender"))
		return notify_fail("你的性别是什么？\n");
	return 1;
}

int do_register(string arg)
{
	object ob;
	string pass;
	
	if (this_object()->query_temp("iambusy"))
		return notify_fail("别急别急，一个一个来……\n");
		
	if (!check_register(this_player()))
		return 0;
	if (!arg)
		return notify_fail("您的电子邮件地址是什么？\n");
	if (strsrch(arg, "@") == -1) 
                return notify_fail("电子邮件地址需要是 id@address 的格式。\n");
	if (strsrch(arg, " ") != -1)
		return notify_fail("电子邮件地址不对！\n");
	if (!(ob = this_player()->query_temp("link_ob")))
		return notify_fail("您的帐号出了些问题，速向巫师求救。\n");
	this_object()->set_temp("iambusy", 1);
	REGI_D->register_char(this_player()->query("id"), arg);
	this_object()->set_temp("iambusy", 0);
	return 1;
}

int do_kill()
{
	object ob;
	int i;

	command("say 还没出世就想死啊？");
	command("sigh");

	return 1;
}
