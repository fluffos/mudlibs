inherit BULLETIN_BOARD;
#include <ansi.h>

void create() {
  set_name(HIG "富贵竹" NOR, ({ "board" }));
  set("location", "/u/yefeng/workroom");
  set("board_id", "yefeng_b");
  set("long", "由于主人懒得浇水,它长得并不茂盛，一半都干枯了,另一半却绿意盎然,倒象是练了枯荣神功！\n");
  setup();
  set("capacity", 200);
}
