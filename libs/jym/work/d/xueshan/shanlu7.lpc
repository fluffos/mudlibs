//Cracked by Roath
// Summer 9/25/96
#include "room.h"

inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
这里是靠近川西的崇山峻岭，怪石嶙峋。再往东去就是川西边缘了。
往西有一座雪山高耸入云。路边上有一个大雪坑(hollow)，而在大雪坑
的不远处有一排足迹(zuji)通向不远处的怪石群里。
LONG
  );
  set("exits", ([
    "northdown": __DIR__ "shanlu6",
    "westup": __DIR__ "shankou",
    "eastdown": "/d/emei/chuanxi2",
  ]));
  set("item_desc", ([
    "hollow": "一个雪坑，似乎可以跳(jump)下去。\n",
    "zuji": "一排零乱的足迹，追寻(scan)着足迹似乎可以到怪石群里。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/liu": 1,
  ]));

  set("cost", 3);
  setup();
  set("outdoors", "qilian-shan");
}
void init() {
  add_action("do_jump", "jump");
  add_action("do_scan", "scan");
}
int do_jump(string arg) {
  int i;
  object me, *ob;
  me = this_player();

  if (!arg || arg == "") return 0;

  if (arg == "hollow") {
    message_vision("$N刚想往下跳，脚在雪地上一滑，卞叽一下摔到坑底。\n", me);
    message("vision",
      me->name() + "脚下一滑，卞叽一下摔不见了。\n",
      environment(me), ({ me }));
    ob = all_inventory(environment(me));
    for (i = 0; i < sizeof(ob); i++) {
      if (ob[i]->query("rider") == me)
        ob[i]->delete("rider");
      me->delete("rided");
    }
    me->move("/d/qilian/underxs");
    message("vision",
      me->name() + "突然卞叽一声从上面摔到坑里。\n", environment(me), ({ me }));
    return 1;
  }
}

int do_scan(string arg) {
  object me = this_player();

  if (!arg || arg != "zuji")
    return notify_fail("什么？\n");

  message_vision("$N仔细查看着雪地上的脚印，过了一会儿$N决定顺着脚印到怪石群里去看个究竟。\n", me);
  me->move("/d/npc/m_weapon/liandaoshi");
  message("vision", me->name() + "沿着足迹慢慢的走到怪石群里去了。\n", environment(me), ({ me }));
  return 1;
}
