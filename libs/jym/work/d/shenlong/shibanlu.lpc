#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "青石板路");
        set("long", @LONG
一条幽静的青石板路，一头通向大厅，一头通向竹林，路旁放着几盆花卉
，开着菊花、蔷薇等，煞是艳丽。
LONG
        );
        set("outdoors", "shenlong");
        set("exits", ([
                "south" : __DIR__"zhulin1",
                "north" : __DIR__"zhulin2",
                "east" : __DIR__"yaofang",
                "west" : __DIR__"huofang",
        ]));

        set("cost", 1);

        setup();
        replace_program(ROOM);
}

