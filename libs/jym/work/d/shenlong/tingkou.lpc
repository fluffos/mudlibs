
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "大厅口");
	set("long", @LONG
这是大厅的门口，向内可进入神龙教的大厅，门口
站着许多神龙教的教徒，全副武装，警惕地注视四周，
从厅内依稀传来一个浑厚的声音，似乎里面正在召开什
么重要会议。
LONG
	);

	set("valid_startroom",1);
	set("exits", ([
		"north" : __DIR__"changlang1",
                "out" : __DIR__"fengding",
	]));

	set("objects", ([
       "/d/shenlong/npc/nandizi" : 1,
       "/d/shenlong/npc/nvdizi" : 1,
	]));
	set("cost", 1);

	set("no_clean_up",0);
	setup();
        "/clone/board/shenlong_b"->foo();
}

int valid_leave(object me, string dir)
{
	mapping myfam = (mapping)me->query("family");
        object *inv;
        int haveguarder;

	if( !(me->query("sg/spy") || me->query("family/family_name") == "神龙教") && dir == "north" ) {
                inv = all_inventory(this_object());
                for(int i = 0; i < sizeof(inv); i++ )
                        if( inv[i]->query("family/family_name") == "神龙教" || inv[i]->query("sg/spy") ) {
                                 haveguarder++;
                                 if( living(inv[i]) ) inv[i]->kill_ob(me);
                        }

                if( haveguarder > 0 )
		        return notify_fail("你也太目中无人了吧，这儿还有人守着呢。\n");
         }

	 return ::valid_leave(me, dir);
}
// 神龙教更新武功专用系统
void init()
{
	mapping fam;
	object me = this_player();

	if( !mapp(fam = me->query("family")) ) return;

	if( fam["family_name"] == "神龙教" && me->query_skill("jinshe-chanshenshou", 1) > 0) {
		tell_object(me, HIC "\n\n" +
				"你好，由于系统更新目前金蛇缠身手(Ｊｉｎｓｈｅ－ｃｈａｎｓｈｅｎｓｈｏｕ)\n" +
				"将变更为神龙幻影指(Ｈｕａｎｙｉｎｇ－ｚｈｉ)，如果你愿意的话，系统将自动更改，\n" + 
				"请键入“ｙｅｓ”进行改变（请不要重复输入ｙｅｓ以免出现问题）。\n\n" NOR);
	
		add_action("do_yes", "yes");
	}


}

int do_yes()
{
	mapping learned; 

	object me = this_player();
	learned = me->query_learned();

	me->set_skill("huanying-zhi", me->query_skill("jinshe-chanshenshou", 1));
	me->improve_skill("finger", learned["hand"]);
	if( me->query_skill("huanying-zhi", 1) > 1)  me->map_skill("finger", "huanying-zhi");
	me->map_skill("jinshe-chanshenshou");
	me->delete_skill("jinshe-chanshenshou");

	tell_object(me, HIG "\n你的技能更新完毕！\n" NOR);	
	tell_object(me, NOR BLINK HIY "\n如有问题，请保留Ｌｏｇ并且立刻向巫师报告。或者发Ｅ－Ｍａｉｌ：ａｗｅｉ＿ｇｕｏ＠ｓｉｎａ．ｃｏｍ\n\n" NOR);	


	return 1;
}

