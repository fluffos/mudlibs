inherit ROOM;
#include <ansi.h>;


void create() {
  set("short", "大厅");
  set("long", @LONG
你来到了一个大厅之中，这厅硕大无朋，足可容得下千人之众，一群群少
男少女分五色站好，每个队列之前都站着一个头目。
LONG
  );
  set("outdoors", "shenlong");

  set("exits", ([
    "north": __DIR__ "shibanlu",
    "south": __DIR__ "zoulang",
    "east": __DIR__ "changlang",
    "west": __DIR__ "liangongfang",
  ]));
  set("objects", ([
    "/d/shenlong/npc/chi": 1,
    "/d/shenlong/npc/bai": 1,
    "/d/shenlong/npc/hei": 1,
    "/d/shenlong/npc/huang": 1,
    "/d/shenlong/npc/qing": 1,
  ]));
  set("cost", 3);
  setup();
  //	replace_program(ROOM);
}
