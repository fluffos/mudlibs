#include <ansi.h>
#include <armor.h>

inherit NECK;

void create() {
  set_name(HIW "水晶项链" NOR, ({ "necklace", "lace" }));
  set("weight", 500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一串以水晶做成的项链，水晶是纯洁的象征，让人感觉它晶莹剔透。\n");
    set("unit", "串");
    set("value", 5000);
    set("material", "amber");
    set("armor_prop/armor", 3);
  }
  setup();
}
