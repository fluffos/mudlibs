// 宝箱

#include <ansi.h>
inherit ITEM;

void create() {
    set_name(HIY"宝箱"NOR, ({"bao xiang"}));
    set_weight(100);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "只");
        set("long", "这只是大清战船上面的宝箱，不知道里面放着什么。\n");
        set("material", "steel");
        set("value", 100);
        set("no_get", 1);
        set("baowu",1);
   }
}

void init() {

    add_action("do_open", "open");
}

int do_open(string arg) 
{
    object ob = this_object(), baowu, me=this_player();

    if ( !arg || arg != "bao xiang" )
        return notify_fail("你要将什么打开？\n");

    if( me->is_busy() )return notify_fail("还在忙着呢！\n") ;
    if( ob->query("baowu") < 1 ) return notify_fail("宝箱里是空的！\n") ;
 
   
    if (me->query_temp("apply/karma") < 23 || me->query_temp("apply/karma") == 23)
 
    {
            message_vision(HIR"$N打开"NOR"$n，"NOR HIR"突然"NOR"$n"NOR HIR"中发出一阵毒烟，$N吓的昏了过去！\n"NOR, me,ob);
            me->unconcious();
            ob->set("baowu",0);
            return 1;

    }
    if (random(10) == 2) {baowu = new(__DIR__"badan");}
    if (random(10) == 3) {baowu = new(__DIR__"gold");}
    if (random(10) == 4) {baowu = new(__DIR__"hook");}
    if (random(10) == 5) {baowu = new(__DIR__"earring");}
    if (random(10) == 6) {baowu = new(__DIR__"ring");}
    if (random(10) == 7) {baowu = new(__DIR__"stick");}
    if (random(10) == 8) {baowu = new(__DIR__"staff");}
    if (random(10) == 9) {baowu = new(__DIR__"necklace");}
    if (random(10) == 0) {baowu = new(__DIR__"blade");}
    if (random(10) == 1) {baowu = new(__DIR__"sword");}
    if (random(10) == 10) {baowu = new(__DIR__"huoqiang");}

    if (random(5) == 1) 
{     
     message_vision("$N打开"HIY"宝箱"NOR"，发现里面是一些$n。\n", me,baowu);
     message_vision("$N刚刚要将$n收了起来，一不小心$n掉到海里面了。\n", me,baowu);
     me->start_busy(2 + random(1));
     ob->set("baowu",0);
     return 1;
}
    
     baowu->move(me);
     baowu->set_amount(10);
     message_vision("$N打开"HIY"宝箱"NOR"，发现里面是一些$n。\n", me,baowu);
     message_vision("$N赶紧将$n收了起来。\n", me,baowu);
     me->start_busy(2 + random(1));
     ob->set("baowu",0);
     return 1;
    


}
