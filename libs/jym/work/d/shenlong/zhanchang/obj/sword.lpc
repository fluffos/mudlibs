


#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
	set_name("巨剑", ({ "ju jian", "jian", "sword" }));
	set_weight(8000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄剑刃非常宽的剑，可以砍可以刺，剑刃上泛着金色的光茫。\n");
		set("value", 400);
		set("material", "steel");
		set("wield_msg", "$N「呜」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
	}
	init_sword(45);
	setup();
}
