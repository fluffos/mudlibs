#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create() {
  set_name(HIW "水晶耳饰" NOR, ({ "earring" }));
  set("weight", 50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("value", 3000);
    set("long", "一对罗刹国进贡中国皇帝的水晶做坠的耳饰，散发着耀眼的光彩。\n");
    set("material", "amber");
    set("armor_prop/armor", 2);
    set("female_only", 1);
  }
  setup();
}
