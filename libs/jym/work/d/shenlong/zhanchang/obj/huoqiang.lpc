#include <weapon.h>
#include <ansi.h>

inherit STAFF;

void create() {
  set_name(HIR "飞天神火毒龙枪" NOR, ({ "long qiang", "qiang", "gun" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把身用铜铁铸造，管长1尺3，装弹一枚，管安长柄，上有枪锋。敌远可发弹射敌，敌至则以枪锋格斗。\n");
    set("value", 450);
    set("zidan", 1);
    set("material", "steel");
    set("wield_msg", "$N从背后将$n握在手中，左右看了看。\n");
    set("unwield_msg", "$N将手中的$n放在背后。\n");
  }
  init_staff(35);
  setup();
}

void init() {
  add_action("do_shoot", "shoot");
}

int do_shoot(string arg) {
  object me = this_player();
  object victim, weapon;
  string str, msg;
  if (!arg)
    return notify_fail("你要对谁开枪？\n");

  victim = present(arg, environment(me));

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("id") != "long qiang")
    return notify_fail("什么？\n");

  if (!victim)
    return notify_fail("这里并无此人！\n");

  if (query("zidan") < 1)
    return notify_fail("飞天神火毒龙枪里面已经没有子弹了。\n");

  if (!living(victim))
    return notify_fail("这不是活物！\n");

  if (me->is_busy())
    return notify_fail("你前一个动作还没有做完。\n");

  if (victim == me) return notify_fail("何必多此一举？\n");

  if (random(5) == 3) {
    message_vision(HIR "\n$N左手拖着飞天神火毒龙枪，瞄准着$n。\n" NOR, me, victim);
    message_vision(HIC "\n$N右手食指一拉飞天神火毒龙枪上的扳机，只听到一声巨响，飞天神火毒龙枪走火了。\n" NOR, me, victim);
    add("zidan", -1);

    me->receive_wound("qi", 3000, "被" + me->query("name") + "杀死了");
    message_vision(NOR "\n结果只听见$N一声惨嚎，碎裂的子弹已在$N的身体上肆虐，鲜血溅了$N一脸！！\n" NOR, me, victim);
    str = COMBAT_D->status_msg((int)me->query("qi") * 100 / (int)me->query("max_qi"));
    message_vision("($N" + str + ")\n", me);
    return 1;
  }

  if (environment(me)->query("no_fight"))
    return notify_fail("在这里不能攻击他人。\n");

  message_vision(HIR "\n$N左手拖着飞天神火毒龙枪，瞄准着$n。\n" NOR, me, victim);
  message_vision(RED "\n$N右手食指一拉飞天神火毒龙枪上的扳机，一枚子弹从飞天神火毒龙枪射出，朝$n打去。\n" NOR, me, victim);
  add("zidan", -1);
  if (random(me->query("combat_exp")) > (int)victim->query("combat_exp") / 2) {

    victim->receive_wound("qi", 3000, "被" + me->query("name") + "杀死了");
    message_vision(NOR "\n结果只听见$n一声惨嚎，子弹已在$n的胸口穿出，鲜血溅了$n一脸！！\n" NOR, me, victim);
    str = COMBAT_D->status_msg((int)victim->query("qi") * 100 / (int)victim->query("max_qi"));
    message_vision("($N" + str + ")\n", victim);

    if (!victim->is_killing(me->query("id")))
      victim->kill_ob(me);
  } else {
    message_vision(HIM "但是$N发现了子弹的来路，急忙躲开了！\n" NOR, victim);
    if (!victim->is_killing(me->query("id")))
      victim->kill_ob(me);
  }
  return 1;
}
