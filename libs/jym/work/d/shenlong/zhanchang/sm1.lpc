#include <ansi.h>
#include "localtime.h"
inherit ROOM;

string long_desc();

string day_event() { return NATURE_D->outdoor_room_event(); }

void setup() {}
void create() {
  set("short", HIG "草原战场" NOR);
  set("long", (: long_desc :));

  set("exits", ([


  ]));
  set("cost", 5);
  //        set("outdoors", "shenlong");
  set("guanchao", 1);
  setup();
}

string long_desc() {
  object me = this_player();

  int t;  // time of the day in minutes
  mixed local;
  string desc;

  desc = "一片望不到边际的大草原，天空中偶尔有一只老鹰飞过。\n\n";

  local = localtime(time() * 60);
  t = local[2] * 60 + local[1];


  if (t >= 400 && t < 600) {
    desc += HIR "    一轮红日袅袅升起，一道道微白的光在东方云层闪现，\n" NOR;
    desc += HIG "放眼四顾，四周草木青翠欲滴，繁花似锦，是个罕见的美景之地。\n" NOR;
    desc += NOR BLINK HIR "远处不时传来炮弹的轰鸣声，震得大地不停的颤动。\n" NOR;

  } else if ((t >= 630 && t < 720) || (t >= 840 && t < 1080)) {
    desc += HIG "放眼四顾，四周草木青翠欲滴，繁花似锦，是个罕见的美景之地。\n" NOR;
    desc += NOR BLINK HIR "远处传来的炮弹的轰鸣声渐渐变小了。\n" NOR;
  } else if (t >= 720 && t < 840) {
    if (this_player()->query("kar") > random(30)) {
      desc += HIG "放眼四顾，四周草木青翠欲滴，繁花似锦，是个罕见的美景之地。\n" NOR;
      desc += NOR BLINK HIR "远处传来的炮弹的轰鸣声已经渐渐停止了。\n" NOR;
    } else
      desc += NATURE_D->outdoor_room_description();
  } else if ((t >= 1260 && t < 1440) || (t >= 0 && t < 300)) {
    desc += HIB "这里黑黝黝一片，忽而中心一点、两点带红色的火光\n" NOR;
    desc += NOR BLINK HIR "只见一个极大的火球正在向着你旁边的地方飞去，只听见一声巨响。\n" NOR;


  }

  else
    desc += NATURE_D->outdoor_room_description();

  return desc;
}
