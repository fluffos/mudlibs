#include <ansi.h>
inherit NPC;
//inherit F_VENDOR;
inherit F_DEALER;

void create() {
  set_name("南怀仁", ({ "nan huairen", "nan" }));
  set("title", "外国商人");
  set_color("$HIG$");
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 75);
  set("long",
    "他是比利时人，是耶稣会教士，来中国传教的。\n");
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/damage", 15);

  set("combat_exp", 40000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    __DIR__ "drug/yaocai1",
    __DIR__ "drug/yaocai2",
    __DIR__ "drug/yaocai3",
    __DIR__ "drug/yaocai4",
    __DIR__ "drug/yaocai5",
    __DIR__ "drug/yaocai6",
    __DIR__ "drug/yaocai7",
    __DIR__ "drug/yaocai8",
    __DIR__ "drug/yaocai9",
    __DIR__ "drug/yaocai10",
    __DIR__ "drug/yaocai11",
    __DIR__ "drug/yaocai12",
    __DIR__ "drug/yaobo",

  }));

  setup();
  set("chat_chance", 3);
  carry_object("/d/city/obj/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
