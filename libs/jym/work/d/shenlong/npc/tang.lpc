
// Pingguo

#include <ansi.h>
#include <dbase.h>
inherit NPC;
inherit F_DEALER;
string ask_manufacture();
string ask_cure();
string ask_shulian();

void create()
{
	set_name("汤若望", ({ "tang ruowang", "tang" }));
	set("title", "通玄教师");
       set_color("$HIG$");
	set("long", "一个日耳曼人是耶稣会教士，来中国传教的。\n");
	set("gender", "男性");
	set("age", 75);
        set("max_jing", 2000);
        set("max_qi", 2000);
	set_skill("literate", 500);
            set_skill("cure", 500);
            set_skill("manufacture", 500);

	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_temp("apply/attack", 140);
	set_temp("apply/defense", 140);
	set_temp("apply/damage", 30);

	set("combat_exp", 40000);
	set("shen_type", 1);

	set("inquiry", ([
		"医疗提升" : (:ask_cure:),
		"制造提升" : (:ask_manufacture:),
		"熟练度" : (:ask_shulian:),
        

	]));

	setup();

	set("chat_chance", 3);
       carry_object("/d/city/obj/cloth")->wear();

}

string ask_manufacture()
{

     object me = this_player();

     string title,title_manufacture,newtitle;
     int index,level;

        title = me->query("title");

         title_manufacture = me->query_temp("manufacture");

         if( title_manufacture){
				return "你已经有称号了怎么还想要？\n";
	  }

     	if (title) {
       		index = strsrch(title,"★");
		if (index>1) 
			title = title[0..(index-1)];
  		else if (index!=-1)
			return ("你的称号太怪，我没法改。\n");
	}	
	me->set("title",title);

	level = me->query_skill("manufacture",1);
	if (level < 1 )
		newtitle = HIM"『学徒』"NOR;
	else if (level < 100)
		newtitle = HIM"『学徒』"NOR;
        else if (level < 200)
                newtitle = HIB"『铁匠』"NOR;
	else newtitle = HIR"『技圣』"NOR;


	if (title && title!="") title = title+"★" + newtitle;
	else title = newtitle;
	me->set("title", title);

	title = title + " " + me->query("name") + 
		"(" + capitalize(me->query("id")) + ")";

       me->set_temp("manufacture", 1);

            command("chat* congra");   
       command("chat " + me->name() + "的铸造之术已经注册技能成为" + newtitle + "！");      

	return "Good Good，你现在是一名"+newtitle+"了。\n";
       
}

string ask_cure()
{

     object me = this_player();

     string title,title_cure,newtitle;
     int index,level;

     	title = me->query("title");
  
          title_cure = me->query_temp("cure");


           if( title_cure){
				return "你已经有称号了怎么还想要？\n";
	  }
     	
             if (title) {
       		index = strsrch(title,"★");
		if (index>1) 
			title = title[0..(index-1)];
  		else if (index!=-1)
			return ("你的称号太怪，我没法改。\n");
	}	



	me->set("title",title);

	level = me->query_skill("cure",1);
	if (level < 1 )
		newtitle = HIM"『学徒』"NOR;
	else if (level < 100)
		newtitle = HIM"『学徒』"NOR;
        else if (level < 200)
                newtitle = HIB"『大夫』"NOR;
	else newtitle = HIR"『神医』"NOR;


	if (title && title!="") title = title+"★" + newtitle;
	else title = newtitle;
	me->set("title", title);
	title = title + " " + me->query("name") + 
		"(" + capitalize(me->query("id")) + ")";

        me->set_temp("cure", 1);
            
            command("chat* congra");    
       command("chat " + me->name() + "的医疗之术已经注册技能成为" + newtitle + "！");    

	return "Good Good，你现在是一名"+newtitle+"了。\n";

}

string ask_shulian()
{
	object ob, who=this_player();

	return "现在"+RANK_D->query_respect(who)+"所在的铁匠工作，已经积累了大约为"+chinese_number(who->query("manufacture/trust"))+"点的熟练度 ，当铁匠工作熟练度达到一百点时可以制作特殊兵器。";
}

