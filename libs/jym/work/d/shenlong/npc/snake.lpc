

inherit NPC_TRAINEE;

void create()
{
switch( random(9) )
        {
        case 0:
        set_name("毒蛇", ({ "du she", "snake" }) );

        set("long","一种普通的毒蛇，但是被咬了也不舒服。\n");


        break;

        case 1:
        set_name("眼镜蛇", ({ "yanjing she", "snake" }) );

        set("long","一种三角形脑袋的蛇，剧毒，因背后的花纹很像眼睛，所以名为眼镜蛇。\n");

        break;

        case 2:
        set_name("响尾蛇", ({ "xiangwei she","snake" }) );

        set("long","一种尾巴会沙沙做响的蛇，剧毒，并且很凶猛。\n");

        break;
        
        case 3:
        set_name("银环蛇", ({ "yinhuan she", "snake" }) );
        set("long","身体的花纹呈环状，并且颜色雪白，故名银环蛇。\n");



        break;
 
        case 4:
        set_name("金环蛇", ({ "jinhuan she", "snake" }) );
        set("long","身体的花纹呈环状，并且颜色金光闪闪，故名金环蛇。\n");




        break;

        case 5:
        set_name("七步蛇", ({ "qibu she", "snake"}) );

        set("long","传说被这种蛇咬到，走不出七步就会毒发身亡。\n");


                break;
        case 7:
        set_name("毒蟒", ({ "du mang","snake" }) );
        set("long","身体巨大，而且毒性十分强，遇到者多半成为它腹中之物。\n");

                
        break;
        
        case  8:
        set_name("双头蛇", ({ "shuangtou she", "snake" }) );
        set("long","一种变异的蛇类，它尾巴上的花纹也如同一只蛇头，用来吸引敌人注意力。\n");


        break;
        
        
        default:
        set_name("赤眼青丝蛇", ({ "qingsi she", "snake" }) );
        set("long","身体十分细长，全身花纹成丝状，通体翠绿，眼睛在夜晚发出红光，是众毒蛇中最厉害的。\n");

        break;
        }

        set("race", "蛇类");
        set("age", 4);
        set("attitude", "peaceful");

        set("msg_fail", "$n冲$N嘶地一吐舌头");
        set("msg_succ", "$n嘶嘶做响，蛇头随着$N的手动了起来");
        set("msg_trained","$n悄无声息地游到$N的脚下不动了");
        set("auto_follow",0);
        set("wildness", 50);

        set("str", 30);
        set("cor", 30);
        set("combat_exp", 1000);

        set_temp("apply/attack", 300);
        set_temp("apply/damage", 200);
        set_temp("apply/armor", 300);

        setup();
}

void init()
{

        object ob;
        ::init();
        if (interactive(ob = this_player()) 
            && !environment()->query("no_fight")
            && random(ob->query_kar() + ob->query_per()) < 30)
        {
                remove_call_out("kill_ob");
                call_out("kill_ob", 1, ob); 

        }       

}
void die()
{
        object ob;
        ob = new(DRUG_D("shedan"));
        ob->move(environment(this_object()));
        destruct(this_object());
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	victim->apply_condition("snake_poison", 50 + me->query("snake_poison") +
		victim->query_condition("snake_poison"));
	if (me->query("bite_busy")) victim->start_busy(2);
}

#include "snake_perform.h"