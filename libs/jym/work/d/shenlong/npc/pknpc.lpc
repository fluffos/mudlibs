
// pingguo
// Pk npc 
#include <ansi.h>
inherit NPC;
#include "/d/shenlong/npc/npcname.h"
#include "/kungfu/class/shenlong/auto_perform.h"
int auto_perform();


void create()
{
        set_random_name();
        set("title", HIW"神龙教杀手"NOR );
        set("gender", "男性" );
        set("age", 32);
        set("str", 23);
        set("dex", 30);
        set("con", 23);
        set("int", 23);
	 set("shenlong/jueming", 2);
        set("shen_type", -1);

        set("max_qi", 300);
        set("max_jing", 100);
        set("neili", 200);
        set("max_neili", 200);
        set("jiali", 200);
        set("no_refresh", 1);
        create_family("神龙教", 3 , "杀手");
                  set("chat_chance_combat", 90);
                  set("chat_msg_combat", ({
                         (: auto_perform :),
                  }) );

        set("inquiry", ([
            "神龙教" : "违抗神龙教者，杀无赦！",

        ]));

        setup();
        carry_object("/clone/armor/tiejia")->wear();


}
void init()
{
	object *inv, victim = this_player(), me = this_object();
	mapping skill_status;
	string *sname;
	int i, max = 0, max1, j;
	if ( !living(me)) return;


	if ( me->query("kill_player") == victim->query("id") && present(victim, environment(me))) {
//		me->kill_ob(victim);
//		victim->kill_ob(me);
//		message_vision( "$n对着$N大吼：敢跟我们神龙教做对，老子奉黄龙使之命，跟你不死不休！\n", victim, me );
		me->set_leader(victim);
		remove_call_out("checking");
		call_out("checking", 1, me, victim);
		return;
	}
	

	if ( !objectp(victim) ) {
		destruct(me);
		return;
	}

	if ( !me->query_temp("said") ) {
//	     switch( random(2) )
//	     {
//		case 0:
			command("exert powerup");
			command("exert recover");
			command("exert poison");
//			command("sneer" );
//			break;
//		case 1:
//			command("exert powerup");
//			command("exert recover");
//			command("exert poison");
//			command( "say 老子奉黄龙使之命，跟你不死不休！" );
//			break;
//	     }
	     me->set_temp("said", 1);


	if ( !me->query_temp("victim") ) {
		me->set_temp("victim", victim->query("id"));
		me->set("pursuer", 1);
        	me->set("vendetta/authority", 1);
        	me->set("bellicosity", 10000);
		me->set_temp("fought", 1);
		me->kill_ob(victim);
		victim->kill_ob(me);
		remove_call_out("checking");
		call_out("checking", 1, me, victim);
	} 
	else if( present(me->query_temp("victim"),environment(me))
	&& !me->is_fighting() && me->query_temp("copied") ) {
		me->kill_ob(victim);
		victim->kill_ob(me);
		me->set_leader(victim);
		remove_call_out("checking");
		call_out("checking", 1, me, victim);
		}
	else if( me->query("kill_player") == victim->query("id") ) {
		me->kill_ob(victim);
		victim->kill_ob(me);
		me->set_leader(victim);
		remove_call_out("checking");
		call_out("checking", 1, me, victim);
		}
	
	}  

}


void do_back()
{
                object ob, me = this_object();
                ob = this_player();
                command("chat 哼，"+ob->query("name")+"不过如此！");
                command("chat 任何违抗神龙教者，杀无赦！！");

                message_vision("$N匆匆忙忙离开了。\n", this_object());
                destruct(me);
}

void self_leave() 
{

                object me = this_object();
                message_vision("$N冷笑一声急急忙忙地离开了。\n", this_object());
                destruct(me);

}



int checking(object me, object victim)
{
	object room;
	if ( !me ) return 1;

    

	room = environment(victim);
	if ( !living(me)) {
		remove_call_out("checking");
		call_out("checking", 1, me, victim);
		return 1;
	}
	if ( me->query("kill_player") == victim->query("id")  && !me->is_fighting() && present(victim, environment(me))) {
		me->kill_ob(victim);
		victim->kill_ob(me);
		me->set_leader(victim);
		remove_call_out("checking");
		call_out("checking", 1, me, victim);
		return 1;
	}


	if ( victim->is_ghost() ) {
		
//		command("emote 用剑在尸体上面刺出：“违抗神龙教者杀无赦”");
		command("chat 哼，任何想要违抗神龙教的人听着，"+victim->query("name")+"的下场就是你们的下场！");
		command("chat* kick corpse");
//		command("get all from corpse");
		command("get corpse");
              message_vision("$N冷笑一声急急忙忙地离开了。\n", this_object());
              move("/d/shenlong/dating");
		command("drop corpse");
		command("say 报告黄龙使，我已经完成任务，就此告辞。");
		command("bye yin jin");
              message_vision("$N冷笑一声急急忙忙地离开了。\n", this_object());
              destruct(me);
		return 1; 
	}

	if ( !me->is_fighting() && present(victim, environment(me)) ) {
		me->kill_ob(victim);
		victim->kill_ob(me);
		message_vision( "$n对着$N大吼：跑？没那么容易！\n", victim, me );
		me->set_leader(victim);
		remove_call_out("checking");
		call_out("checking", 1, me, victim);
		return 1;
	}
	else if ( !me->is_fighting() ) {
		remove_call_out("destruct_me");
		call_out("destruct_me", 1, me, victim);
		return 1;
	}

	remove_call_out("checking");
	call_out("checking", 1, me, victim);
	return 1;
}

int checking2(object me, object victim)
{
	object room;

	room = environment(victim);
	
	if(wizardp(victim)) 
		command("tell pingguo 你在"+room->query("short")+"，我在"+environment(me)->query("short")+"。");

	if (me->is_busy() || me->is_fighting() || !living(me)) {
		remove_call_out("checking2");
		call_out("checking2", 1, me, victim);
		return 1;
	}
	else if ( room != environment(me) && me->query("kill_player") == victim->query("id") 
	&& !victim->is_ghost() ) {
		if(wizardp(victim))
			command("tell pingguo 该前往"+room->query("short")+"。");
		message_vision(me->name() + "急急忙忙地离开了。\n", me );
		me->move(room);
		message_vision(me->name() + "快步走了过来。\n", me);
		call_out("checking2", 1, me, victim);

		return 1;
	}
	call_out("checking2", 1, me, victim);

	return 1;
}

int accept_fight(object victim)
{
	object me = this_object();
	if ( me->query_temp("victim") && victim->query("combat_exp") > me->query("combat_exp") ) {
		 command( "say 滚开！大爷没功夫和你瞎闹！" );
		 return 0;
	}
	else {
		command( "say 阴曹地府又多你一条孤魂野鬼！" );
		me->set("kill_player",victim->query("id"));
		call_out("checking2", 1, me, victim);
		me->set_temp("fought", 1);
		me->kill_ob(victim);
		remove_call_out("checking");
		call_out("checking", 1, me, victim);

		return 1;
	}
}

int accept_kill(object victim)
{
	object me = this_object();

		command( "say 阴曹地府又多你一条孤魂野鬼！" );
		me->set("kill_player",victim->query("id"));
		call_out("checking2", 1, me, victim);
		me->set_leader(victim);
		remove_call_out("checking");
		call_out("checking", 1, me, victim);
	

	return 1;
}



