// npc
// 教众

inherit NPC;
#include <ansi.h>
#include "jz_perform.h"
int ask_job();

void create()
{
	set_name("教众", ({ "jiao zhong", "jiaozhong" }));
       set_color("$WHT$");
       set("title", "神龙教教众");
	set("long", "他看起来二十出头，身板结实，双目有神，是神龙教的一个教众。\n");
	set("gender", "男性");
       set("attitude", "peaceful");
	set("age", 25);
	set("shen", -80000);
       
	set_skill("force", 10);
  	set_skill("dulong-dafa", 10);
	set_skill("dodge", 10);
	set_skill("lingshe-shenfa", 10);
	set_skill("poison", 10);
	set_skill("huanying-zhi", 10);
	set_skill("sword", 10);
      	set_skill("medicine", 10);
	set_skill("strike", 10);
	set_skill("hook", 10);
	set_skill("ruyi-gou", 10);
	set_skill("huagu-mianzhang", 10);
	set_skill("finger", 10);
  	set_skill("literate", 10);

	map_skill("force", "dulong-dafa");
	map_skill("sword", "huanying-zhi");
	map_skill("dodge", "lingshe-shenfa");
	map_skill("parry", "huanying-zhi");
	map_skill("finger", "huanying-zhi");
	map_skill("strike", "huagu-mianzhang");
	map_skill("hook", "ruyi-gou");

	prepare_skill("finger", "huanying-zhi");
	prepare_skill("strike", "huagu-mianzhang");

	set("inquiry", ([
		"地点" : (:ask_job:),
	]));
	create_family("神龙教", 4, "教众");
                  set("chat_chance_combat", 90);
                  set("chat_msg_combat", ({
                         (: auto_perform :),
                  }) );

	setup();

	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/hook")->wield();

}

int start_check(object me)
{
		call_out("leave", 1200, me);
		call_out("check", 1, me);
}

void init()
{
	::init();

	add_action("do_recognize", "arrest");
       add_action("do_attack", "attack");
       add_action("do_stop", "stop");
       add_action("do_follow", "gensui");
	add_action("do_dai", "bang");


}
void leave(object me)
{
	string killer = me->query_temp("my_killer");
	object bangzhong = this_object();

	if (query("recognized") && objectp(present(me, environment(bangzhong)))) {
	command("addoil "+bangzhong->query("job_master"));
	call_out("leave", 60, me);
	}

	else if(objectp(present(me, environment(bangzhong)))){
	message_vision("$N说道：你怎么那么笨？找那么久还没找到"+query("find_job_name")+"看来还是算了。\n"NOR,bangzhong);
	command("sigh");
	message_vision("$N急急忙忙地离开了。\n"NOR,bangzhong);
	destruct(bangzhong);
	}

	else {
	message_vision("$N急急忙忙地离开了。\n"NOR,bangzhong);
	destruct(bangzhong);
	}

	return;
}

void check(object me)
{
	string killer = me->query_temp("my_killer");
	object bangzhong = this_object();

	if(!me->query("find_job"))
	{
	command("bye "+me->query("id"));
	message_vision("$N急急忙忙地离开了。\n"NOR,bangzhong);
	destruct(bangzhong);
	}

	else if(me->is_ghost() )
	{
	command("ah");
	command("cry corpse");
	command("grpfight "+me->query_temp("my_killer"));
	command("kill "+me->query_temp("my_killer"));
	}
	else call_out("check", 1, me);
}

int do_recognize(string arg)
{
	object me, ob, bangzhong, where, weapon, xiashu;
	mapping skill_status;
	string *sname;
	int i ,num, level = 0, s_level, j, gain, exp, ob_exp, rate;

	me = this_player();
	exp = me->query("combat_exp");

	bangzhong = this_object();
	if( query("job_master") != me->query("id"))
		return 0;
	if( query("recognized"))
		return notify_fail("敌人已经动手了，还不快点干掉敌人！\n");
	if( !living(bangzhong) )
		return notify_fail("你得先把教众弄醒再说。\n");
	if( !arg )
		return notify_fail("你要教众抓谁？\n");
	if(!objectp(ob = present(arg, environment(this_player()))))
		return notify_fail("这里没有这个人。\n");
	if(ob->query("job_victim"))
		return notify_fail(ob->name()+"已经动手了！\n");
	if(ob == me)
		return notify_fail("抓你自己？疯啦？？\n");
	if(ob == bangzhong)
		return notify_fail("要教众抓自己？\n");
	if(ob->query("family/family_name") == "神龙教")
		return notify_fail("内讧了？\n");
	if( me->is_busy() || me->is_fighting() )
		return notify_fail("你正忙着呢。\n");
	if( bangzhong->is_busy() || bangzhong->is_fighting() )
		return notify_fail( "教众正忙着呢。\n");
	if(environment(me)->query("no_fight"))
		return notify_fail("这里不能抓人。\n");


	me->start_busy(1);

	message_vision("$N对着"+ob->name()+"喝道：“你个叛徒，今日落在我的手里，看你怎么猖獗”！\n",me,ob);
	where = environment(ob);

	if (ob->query("job_target") == me->query("id") 
	&& ob->query("name") == query("find_job") )
	{
	if( !living(ob) )
	ob->revive();
	command("nod");
	command("slap "+ob->query("id"));
	command("说你呢！ ");

	ob->interrupt_me();
	ob->set("real_face",1);
	set("recognized",1);

	{
	ob->set("long",ob->query("real_long"));
	if(ob->query("real_title"))
	ob->set("title",ob->query("real_title"));
	ob->clear_condition();
	ob->set("shen_type", -1);
	
	if ( mapp(skill_status = me->query_skills()) ) {
		skill_status = me->query_skills();
		sname = keys(skill_status);

		for(i=0; i<sizeof(skill_status); i++) {
			if ( skill_status[sname[i]] > level ) level = skill_status[sname[i]];
		}
		
		level = (int)level*4/5 + 1;
		s_level = (int)level*21/20;

		rate = random(3)+9;

		ob->set("combat_exp", exp*rate/10 + random(exp/100) );
		ob_exp = ob->query("combat_exp");

		ob->set("job_victim", me->query("id"));

		
		ob->set("gain", 50 + level);
		gain = ob->query("gain");
		if(gain>300) gain=300;

		if(exp <  100000) 
			gain = gain + random(level/2);
		else if(exp <  500000)
			gain = gain + random(level/3);
		else if(exp < 1000000)
			gain = gain + random(level/4);
		else if(exp < 3000000)
			gain = gain + random(level/5);
		else gain = gain + random(level/8);

		ob->set("gain_exp", gain);
		ob->set("gain_pot", gain/4 +random(gain/10));
		ob->set("shen",ob_exp/10);
		
		if(ob_exp < 1000000) {
		ob->add("gain_exp", random(5)+10);
		ob->add("gain_pot", random(5)+1);
		}
		else if(ob_exp < 2000000) {
		ob->add("gain_exp", random(5)+15);
		ob->add("gain_pot", random(5)+5);
		}
		else if(ob_exp < 3000000) {
		ob->add("gain_exp", random(5)+20);
		ob->add("gain_pot", random(5)+10);
		}
		else {
		ob->add("gain_exp", random(5)+25);
		ob->add("gain_pot", random(5)+15);
		}


		ob->set("max_qi", me->query("max_qi")*9/10);
		ob->set("eff_qi", me->query("max_qi")*9/10);
		ob->set("max_jing", me->query("max_jing")*9/10);
		ob->set("eff_jing", me->query("max_jing")*9/10);
		ob->set("qi", ob->query("max_qi"));
		ob->set("jing", ob->query("max_jing")*9/10);
		ob->set("jiali", me->query("jiali")/2);
		if ( me->query("max_neili") > 0 ) {
			ob->set("max_neili", level*30);
			if(ob->query("max_neili") > me->query("max_neili") )
				ob->set("max_neili", me->query("max_neili")+level );
		}
		else ob->set("max_neili", 500);
		
		if ( me->query("max_jingli") > 0 ) {
			ob->set("max_jingli", me->query("max_jingli")*9/10);
		}
		else ob->set("max_jingli", 500);
		ob->set("neili", ob->query("max_neili"));
		ob->set("jingli", ob->query("max_jingli"));
		ob->set("no_sing", 1);
		ob->set_skill("dodge", level);
		ob->set_skill("parry", level );
		ob->set_skill("force", level);
		
	switch (ob->query("real_menpai")) {
	case "huashan" :
	ob->set_name("令狐无极", ({"linghu wuji", "huashan dizi" ,"dizi"}) );
	ob->set_skill("blade", s_level);
	ob->set_skill("sword", s_level);
	ob->set_skill("cuff", s_level);
	ob->set_skill("strike", s_level);
	ob->set_skill("huashan-jianfa", level);
	ob->set_skill("liangyi-dao", level);
	ob->set_skill("tiyunzong", s_level);
	ob->set_skill("zixia-gong", level);
	ob->set_skill("pishi-poyu", level);
	ob->set_skill("hunyuan-zhang", level);
	ob->set_skill("ziyin-yin", level);
	ob->set_skill("zhengqi-jue", level);

	ob->map_skill("force", "zixia-gong");
	ob->map_skill("dodge", "tiyunzong");
	ob->map_skill("parry", "huashan-jianfa");
	ob->map_skill("strike", "hunyuan-zhang");
	ob->map_skill("cuff", "pishi-poyu");
	ob->map_skill("sword", "huashan-jianfa");
	ob->map_skill("blade", "liangyi-dao");
	ob->prepare_skill("cuff", "pishi-poyu");
	ob->prepare_skill("strike", "hunyuan-zhang");
	ob->set("real_message", HIG"令狐无极哈哈大笑道："+RANK_D->query_rude(me)+"原来是神龙教弟子，今日"+RANK_D->query_self_rude(ob)+"，要为民除害，看招！\n"NOR);
{
	num = 2+random(4);
	message_vision(HIG"令狐无极喝道：来人那！突然出现"+chinese_number(num)+"个弟子，"+chinese_number(num+1)+"人向$N围攻过来！\n"NOR, me, ob);
		    for (i=0; i<num; i++) {
		xiashu = new("/d/shenlong/npc/bz_bangzhong");
		xiashu->set("combat_exp", exp/2 + random(exp/1000) );
		xiashu->set("rank_info/rude", "臭贼");
		xiashu->set("max_qi", ob->query("max_qi")/2);
		xiashu->set("eff_qi", ob->query("max_qi")/2);
		xiashu->set("max_jing", ob->query("max_jing")/2);
		xiashu->set("eff_jing", ob->query("max_jing")/2);
		xiashu->set("qi", xiashu->query("max_qi"));
		xiashu->set("jing", xiashu->query("max_jing"));
		xiashu->set("jiali", ob->query("jiali")/2);
		xiashu->set("max_neili", ob->query("max_neili")/2);
		xiashu->set("max_jingli", ob->query("max_jingli")/2);
		xiashu->set("neili", xiashu->query("max_neili"));
		xiashu->set("jingli", xiashu->query("max_jingli"));

		xiashu->set_skill("hunyuan-yiqi", level*3/4);
		xiashu->set_skill("tangshi-jian", level*3/4);
		xiashu->set_skill("tiyunzong", level*3/4);
		xiashu->set_skill("taiji-dao", level*3/4);
		xiashu->set_skill("jiuyin-zhao", level*3/4);
		xiashu->set_skill("claw", level*3/4);
		xiashu->set_skill("force", level*3/4);
		xiashu->set_skill("parry", level*3/4);
		xiashu->set_skill("dodge", level*3/4);
		xiashu->set_skill("sword", level*3/4);

		xiashu->map_skill("force", "hunyuan-yiqi");
		xiashu->map_skill("sword", "tangshi-jian");
		xiashu->map_skill("dodge", "tiyunzong");
		xiashu->map_skill("parry", "tangshi-jian");
		xiashu->map_skill("claw", "jiuyin-zhao");
		xiashu->prepare_skill("claw", "jiuyin-zhao");
		xiashu->add_money("silver", 20+random(50));

		xiashu->move(environment(me));
		
		xiashu->kill_ob(me);
		xiashu->start_check(ob);
		xiashu->set_leader(ob);
		me->fight_ob(xiashu);
		ob->add("gain_exp", random(10)+20);
		ob->add("gain_pot", random(5)+5);
		}
	}

	ob->add("gain_exp", random(10)+30);
	ob->add("gain_pot", random(5)+20);
	ob->add_money("gold", random(2));
	if(random(3) == 1)  weapon=new("/clone/weapon/gangdao");
	else if(random(3) == 1) weapon=new("/clone/weapon/changjian");
	
		break;
		
	case "wudang" :
	ob->set_name("幻虚", ({"huan xu", "wudang dizi", "dizi"}) );
	ob->set_skill("sword", s_level);
	ob->set_skill("cuff", s_level);
	ob->set_skill("taiji-shengong", s_level);
	ob->set_skill("taiji-jian", s_level);
	ob->set_skill("tiyunzong", level);
	ob->set_skill("taiji-quan", s_level);
	ob->set_skill("taoism", level);
	ob->set_skill("literate", level);
	ob->map_skill("force", "taiji-shengong");
	ob->map_skill("parry", "taiji-jian");
	ob->map_skill("cuff", "taiji-quan");
	ob->map_skill("dodge", "tiyunzong");
	ob->map_skill("sword", "taiji-jian");
	ob->prepare_skill("cuff", "taiji-quan");
	ob->set("real_message", HIG"幻虚狠狠地说道：贫道今日要打开杀戒了，"+RANK_D->query_rude(me)+"，看招！\n"NOR);
{
	num = 2+random(4);
	message_vision(HIG"幻虚喝道：来人那！突然出现"+chinese_number(num)+"个弟子，"+chinese_number(num+1)+"人向$N围攻过来！\n"NOR, me, ob);
		    for (i=0; i<num; i++) {
		xiashu = new("/d/shenlong/npc/bz_bangzhong");
		xiashu->set("combat_exp", exp/2 + random(exp/1000) );
		xiashu->set("rank_info/rude", "臭贼");
		xiashu->set("max_qi", ob->query("max_qi")/2);
		xiashu->set("eff_qi", ob->query("max_qi")/2);
		xiashu->set("max_jing", ob->query("max_jing")/2);
		xiashu->set("eff_jing", ob->query("max_jing")/2);
		xiashu->set("qi", xiashu->query("max_qi"));
		xiashu->set("jing", xiashu->query("max_jing"));
		xiashu->set("jiali", ob->query("jiali")/2);
		xiashu->set("max_neili", ob->query("max_neili")/2);
		xiashu->set("max_jingli", ob->query("max_jingli")/2);
		xiashu->set("neili", xiashu->query("max_neili"));
		xiashu->set("jingli", xiashu->query("max_jingli"));

		xiashu->set_skill("hunyuan-yiqi", level*3/4);
		xiashu->set_skill("tangshi-jian", level*3/4);
		xiashu->set_skill("tiyunzong", level*3/4);
		xiashu->set_skill("taiji-dao", level*3/4);
		xiashu->set_skill("jiuyin-zhao", level*3/4);
		xiashu->set_skill("claw", level*3/4);
		xiashu->set_skill("force", level*3/4);
		xiashu->set_skill("parry", level*3/4);
		xiashu->set_skill("dodge", level*3/4);
		xiashu->set_skill("sword", level*3/4);
		xiashu->set_skill("blade", level*3/4);


		xiashu->map_skill("force", "hunyuan-yiqi");
		xiashu->map_skill("sword", "tangshi-jian");
		xiashu->map_skill("dodge", "tiyunzong");
		xiashu->map_skill("parry", "tangshi-jian");
		xiashu->map_skill("claw", "jiuyin-zhao");
		xiashu->prepare_skill("claw", "jiuyin-zhao");
		xiashu->add_money("silver", 20+random(50));

		xiashu->move(environment(me));
		
		xiashu->kill_ob(me);
		xiashu->start_check(ob);
		xiashu->set_leader(ob);
		me->fight_ob(xiashu);
		ob->add("gain_exp", random(10)+20);
		ob->add("gain_pot", random(5)+5);
		}
	}

	ob->set("jiali", 0);
	ob->set("str", 27+random(4));
	ob->carry_object("/clone/anqi/feibiao")->set_amount(2+random(3));
	if(random(3) != 0) weapon=new("/clone/weapon/changjian");
		break;
		
	case "emei" :
	ob->set_name("周湄娘", ({"chou meiniang", "emei dizi", "dizi"}) );
	ob->set_skill("claw", s_level+20);
	ob->set_skill("cuixin-zhang", s_level);
	ob->set_skill("dodge", level);
	ob->set_skill("emei-jian", s_level+20);
	ob->set_skill("strike", s_level);
	ob->set_skill("force", s_level);
	ob->set_skill("jiuyin-zhao", s_level);
	ob->set_skill("sword", s_level);
	ob->set_skill("zhutian-bu", s_level);
	ob->set_skill("mahayana", s_level);
	ob->set_skill("persuading", s_level);
	ob->set_skill("parry", s_level);

	ob->map_skill("sword","emei-jian");
	ob->map_skill("dodge","zhutian-bu");
	ob->map_skill("strike","cuixin-zhang");
	ob->map_skill("force", "linji-zhuang");
	ob->map_skill("claw", "jiuyin-zhao");
	ob->map_skill("parry", "emei-jian");
	ob->prepare_skill("strike", "jiuyin-zhao");
	ob->prepare_skill("strike", "cuixin-zhang");

	ob->add("gain_exp", -20);
	ob->add("gain_pot", -20);
	ob->add_money("silver", 20+random(31));
	ob->set("real_message", HIG"吃了一惊，抽出兵器对着$N杀了过来！\n"NOR);
{
	num = 2+random(4);
	message_vision(HIG"周湄娘喝道：来人那！突然出现"+chinese_number(num)+"个弟子，"+chinese_number(num+1)+"人向$N围攻过来！\n"NOR, me, ob);
		    for (i=0; i<num; i++) {
		xiashu = new("/d/shenlong/npc/bz_bangzhong");
		xiashu->set("combat_exp", exp/2 + random(exp/1000) );
		xiashu->set("rank_info/rude", "臭贼");
		xiashu->set("max_qi", ob->query("max_qi")/2);
		xiashu->set("eff_qi", ob->query("max_qi")/2);
		xiashu->set("max_jing", ob->query("max_jing")/2);
		xiashu->set("eff_jing", ob->query("max_jing")/2);
		xiashu->set("qi", xiashu->query("max_qi"));
		xiashu->set("jing", xiashu->query("max_jing"));
		xiashu->set("jiali", ob->query("jiali")/2);
		xiashu->set("max_neili", ob->query("max_neili")/2);
		xiashu->set("max_jingli", ob->query("max_jingli")/2);
		xiashu->set("neili", xiashu->query("max_neili"));
		xiashu->set("jingli", xiashu->query("max_jingli"));

		xiashu->set_skill("hunyuan-yiqi", level*3/4);
		xiashu->set_skill("tangshi-jian", level*3/4);
		xiashu->set_skill("tiyunzong", level*3/4);
		xiashu->set_skill("taiji-dao", level*3/4);
		xiashu->set_skill("jiuyin-zhao", level*3/4);
		xiashu->set_skill("claw", level*3/4);
		xiashu->set_skill("force", level*3/4);
		xiashu->set_skill("parry", level*3/4);
		xiashu->set_skill("dodge", level*3/4);
		xiashu->set_skill("sword", level*3/4);

		xiashu->map_skill("force", "hunyuan-yiqi");
		xiashu->map_skill("sword", "tangshi-jian");
		xiashu->map_skill("dodge", "tiyunzong");
		xiashu->map_skill("parry", "tangshi-jian");
		xiashu->map_skill("claw", "jiuyin-zhao");
		xiashu->prepare_skill("claw", "jiuyin-zhao");
		xiashu->add_money("silver", 20+random(50));

		xiashu->move(environment(me));
		
		xiashu->kill_ob(me);
		xiashu->start_check(ob);
		xiashu->set_leader(ob);
		me->fight_ob(xiashu);
		ob->add("gain_exp", random(10)+20);
		ob->add("gain_pot", random(5)+5);
		}
	}

	if(random(2) != 1) weapon=new("/clone/weapon/changjian");
		break;
		
	case "shaolin" :
	ob->set_name("渡痴", ({"du chi", "shaolin dizi", "dizi"}) );
	ob->set_skill("blade", s_level);
	ob->set_skill("sword", s_level);

	ob->set_skill("buddhism", level);
	ob->set_skill("damo-jian", s_level);
	ob->set_skill("xiuluo-dao", s_level);
	ob->set_skill("jingang-quan", s_level);
	ob->set_skill("shaolin-shenfa", level);
