int do_dai(string arg)
{
	object me, ob, bangzhong, where, weapon;
	int job_exp, job_pot;
	string shou;
	me = this_player();
	bangzhong = this_object();

	if( query("job_master") != me->query("id"))
		return 0;
	if( !living(bangzhong) )
		return notify_fail("嗯....你得先把教众弄醒再说。\n");
	if( !arg )
		return notify_fail("你要教众带走谁？\n");
	if(!objectp(ob = present(arg, environment(this_player()))))
		return notify_fail("这里没有这个人。\n");
	if(ob == me)
		return notify_fail("那么懒？还要人家背你回去？\n");
	if(ob == bangzhong)
		return notify_fail("要教众带走自己？\n");
	if(ob->query("job_victim") != me->query("id"))
		return notify_fail("你无法确定"+ob->name()+"是不是你要收拾的对象。\n");
	if( me->is_busy() || me->is_fighting() )
		return notify_fail("你正忙着呢。\n");
	if( bangzhong->is_busy() || bangzhong->is_fighting() )
		return notify_fail( "教众正忙着呢。\n");



	job_exp = ob->query("gain_exp");
	job_pot = ob->query("gain_pot");

	if (me->query("shenlong/rank")>1)
	{
	job_exp = (ob->query("gain_exp")*3/2);
	job_pot = (ob->query("gain_pot")*3/2);
       }

	if(job_exp > 1000) job_exp = 1000+random(40);
	if(job_pot > 300) job_exp = 300+random(30);


       if(ob->query("job_victim") == me->query("id") && !living(ob)){
		message_vision(HIW"$N说到：“将这个"+ob->name()+"给我绑好了带回去！”\n"NOR,me,ob);
		command("congra "+getuid(me));
              if(ob->query_temp("last_damage_from") == me) {
		message_vision(HIC"教众用绳索将$n绑的跟个粽子一样！\n"NOR,me,ob);
		message_vision(CYN"教众说到：“恭喜阁下将这小子擒获。这下教主更加信赖您了”！\n"NOR,me,ob);

		me->add("combat_exp",job_exp);
		me->add("potential",job_pot);
              me->add("shenlong/gonglao",100);
              if ( me->query("potential") > me->query("max_potential") )
              me->set("potential", me->query("max_potential"));
		}

	message_vision("教众将这个被五花大绑的"+ob->name()+"扶了起来背在背上，说道：“我先将这家伙带回去了。”\n",me,ob);
	command("wave "+getuid(me));

	me->set("job_ok",1);
	me->set("job_over",1);


		if(me->query_temp("not_me")) {
		log_file("test/shou_job",
		sprintf("%s(%s) failed to get %d Combat_Exp and %d Potential from %s on %s\n", 
		me->name(), me->query("id"), job_exp, job_pot, ob->name(), ctime(time())));
		me->delete_temp("not_me");
		}
		else {
              tell_object(me,BRED+HIY"你的经验增加"+job_exp+"点。\n"NOR);
              tell_object(me,BRED+HIY"你的神龙教功劳增加了100点。\n"NOR);
		log_file("test/shou_job",
		sprintf("%s(%s) got %d Combat_Exp and %d Potential from %s on %s\n", 
		me->name(), me->query("id"), job_exp, job_pot, ob->name(), ctime(time())));

		}
		
	destruct(ob);
	destruct(bangzhong);
	}
	else tell_object(me,"你得先打昏"+ob->name()+"才行！\n");

	return 1;
}

string ask_job()
{
	object me;
	me = this_player();

	if( me->query("id") == "pingguo" )
	{
		tell_object(me,"您好苹果，此人目前在"+query("job_region")+""+query("job_room")+"附近！\n");
	}
	else return 0;
}

int do_attack(string arg)
{
	object me, bz, ob;
	me = this_player();
	bz = this_object();
	if( query("job_master") != me->query("id"))
       return 0;
	if( !arg )
		return notify_fail("你要教众攻击谁？\n");
	if(!objectp(ob = present(arg, environment(this_player()))))
		return notify_fail("这里没有这个人。\n");
       if (ob->query("race") != "人类" )
	{
	command("?");
	command("say 你是不是有神经病？");
	return 1;
	}

	if(ob == me)
		return notify_fail("自杀？\n");
	if(ob == bz)
		return notify_fail("无法让教众攻击自己！\n");
//       if(ob->query("job_victim") == me->query("id") && !living(ob)){
 	message_vision(HIR"$N声嘶力竭地对着$n叫道：对"+ob->name()+HIR"这样的混蛋还讲什么江湖道义，大伙并肩子上啊！\n\n"NOR,me,ob);
       message_vision(HIC"教众高声喝道：“听从$N吩咐！”"+ob->name()+HIC"拿命来吧！\n"NOR,me,ob);
       bz->kill_ob(ob);
       ob->kill_bz(bz);
       return 1;
}
int do_stop(string arg)
{
	object me, bz, ob;
	me = this_player();
	bz = this_object();
	if( query("job_master") != me->query("id"))
       return 0;
	if( !arg )
		return notify_fail("你要让谁停止？\n");
	if(!objectp(ob = present(arg, environment(this_player()))))
		return notify_fail("这里没有这个人。\n");
	if(ob == me)
		return notify_fail("要自己停止你可以输入(Ｈａｌｔ)！\n");
	if(ob == bz)
 	message_vision(HIG"$N高声说到：“停手，看看人家要说什么？”！\n\n"NOR,me,ob);
       message_vision(HIG"教众高声喝道：“听从$N吩咐！”！\n"NOR,me,ob);
       ob->remove_all_killer();
       return 1;
}

int do_follow(string arg)
{
	object me, bz, ob;
	me = this_player();
	bz = this_object();
	if( query("job_master") != me->query("id"))
       return 0;
	if( !arg )
		return notify_fail("你要教众跟随谁？\n");
	if(!objectp(ob = present(arg, environment(this_player()))))
		return notify_fail("这里没有这个人。\n");
       if (ob->query("race") != "人类" )
	{
	command("?");
	command("say 你是不是有神经病？");
	return 1;
	}

	if(ob == me) {
              message_vision(HIG"$N高声说到：“跟我来！”！\n\n"NOR,me,ob);
	       message_vision(HIG"教众高声喝道：“听从$N吩咐！”！\n"NOR,me,ob);
		command("follow "+getuid(me));
		command("ok "+getuid(me));
		return 1;
			}
	if(ob == bz)
       return notify_fail("无法让教众跟随教众。\n");
              message_vision(HIG"$N高声说到：“跟着$n去，看看此人有何企图！”！\n\n"NOR,me,ob);
	       message_vision(HIG"教众高声喝道：“听从$N吩咐！”！\n"NOR,me,ob);
		command("follow "+getuid(ob));
       return 1;
}