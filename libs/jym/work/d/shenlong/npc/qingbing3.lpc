inherit NPC;


void create()
{
	set_name("清兵", ({
		"qing bing",
		"bing",
	}));
	set("long",
		"一个自以为是的清兵。\n"
	);

	set("gender", "男性");
	set("attitude", "aggressive");
	set("no_get", "清兵对你而言太重了。");

	set("age", 20);
	set("shen_type", 1);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 20);

       set("max_qi", 9555);
       set("max_jing", 9000);
       set("max_jingli", 9000);
       set("eff_jingli", 9000);
       set("jingli", 9000);
       set("jing", 9000);
	set("neili", 9000);
	set("max_neili", 6000);

	set("combat_exp", 800000);
	

	set_skill("force", 200);
	set_skill("linji-zhuang", 200);
	set_skill("dodge", 200);
	set_skill("zhutian-bu", 200);
	set_skill("strike", 200);
	set_skill("jinding-zhang", 200);
	set_skill("parry", 200);
	set_skill("mahayana", 200);
	set_skill("persuading", 200);
	set_skill("finger", 200);
	set_skill("tiangang-zhi", 200);
	set_skill("sword", 200);
	set_skill("emei-jian", 200);
	set_skill("blade", 200);
	set_skill("yanxing-dao", 200);

	map_skill("force", "linji-zhuang");
	map_skill("sword", "emei-jian");
	map_skill("dodge", "zhutian-bu");
	map_skill("strike", "jinding-zhang");
	map_skill("parry", "emei-jian");
	map_skill("finger", "tiangang-zhi");
	map_skill("blade", "yanxing-dao");
       prepare_skill("strike", "jinding-zhang");
       prepare_skill("finger", "tiangang-zhi");

       create_family("峨嵋派", 5, "弟子");

	setup();

	switch( random(3) )
	{
		case 0:
			carry_object("/clone/weapon/gangzhang")->wield();
			break;
		case 1:
			carry_object("/clone/weapon/gangdao")->wield();
			break;
		case 2:
			carry_object("/clone/weapon/gangjian")->wield();
			break;
	}

            carry_object("/clone/armor/tiejia")->wear();

}


void init()
{
	object ob = this_player();
	
	::init();

	if (interactive(ob))
	{
		command("say 乱闯兵船者！杀无赦！");
		remove_call_out("kill_ob");
        	command("unwield gangzhang");
		command("exert fengyun");
		command("jiali 50");
		command("kill "+ob->query("id")); 
		command("perform jue "+ob->query("id"));
		command("perform huanying "+ob->query("id"));
		command("perform puzhao "+ob->query("id"));

	}       
}


