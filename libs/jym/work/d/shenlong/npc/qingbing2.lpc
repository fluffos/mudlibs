inherit NPC;
#include "/d/shenlong/npc/auto_huashan.h"

void create()
{
	set_name("清兵", ({
		"qing bing",
		"bing",
	}));
	set("long",
		"一个自以为是的清兵。\n"
	);

	set("gender", "男性");
	set("attitude", "aggressive");
	set("no_get", "清兵对你而言太重了。");

	set("age", 20);
	set("shen_type", 1);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 20);

       set("max_qi", 9555);
       set("max_jing", 9000);
       set("max_jingli", 9000);
       set("eff_jingli", 9000);
       set("jingli", 9000);
       set("jing", 9000);
	set("neili", 9000);
	set("max_neili", 6000);

	set("combat_exp", 800000);
	

	set_skill("force", 200);
	set_skill("zixia-gong", 200);
	set_skill("dodge", 200);
	set_skill("huashan-shenfa", 200);
	set_skill("strike", 200);
	set_skill("hunyuan-zhang", 200);
	set_skill("parry", 200);
	set_skill("zhengqi-jue", 200);
	set_skill("ziyin-yin", 200);
	set_skill("cuff", 200);
	set_skill("pishi-poyu", 200);
	set_skill("sword", 200);
	set_skill("huashan-jianfa", 200);
	set_skill("blade", 200);
	set_skill("liangyi-dao", 200);


	map_skill("force", "zixia-gong");
	map_skill("blade", "liangyi-dao");
	map_skill("dodge", "huashan-shenfa");
	map_skill("strike", "hunyuan-zhang");
	map_skill("parry", "liangyi-dao");
	map_skill("cuff", "pishi-poyu");
	map_skill("sword", "huashan-jianfa");
       prepare_skill("strike", "hunyuan-zhang");
       prepare_skill("cuff", "pishi-poyu");

       create_family("华山派", 5, "弟子");

	setup();

	switch( random(3) )
	{
		case 0:
			carry_object("/clone/weapon/gangdao")->wield();
			break;
		case 1:
			carry_object("/clone/weapon/gangzhang")->wield();
			break;
		case 2:
			carry_object("/clone/weapon/gangjian")->wield();
			break;
	}
            carry_object("/clone/armor/tiejia")->wear();
            carry_object("/d/shenlong/zhanchang/obj/huoqiang");
}


void init()
{
	object ob = this_player();
	
	::init();

	if (interactive(ob))
	{
		command("say 乱闯兵船者！杀无赦！");
		remove_call_out("kill_ob");
		command("exert zixia");
        	command("unwield gangzhang");
		command("kill "+ob->query("id")); 
		command("perform sanshen "+ob->query("id")); 
		command("perform jianzhang "+ob->query("id")); 
		command("perform leidong "+ob->query("id")); 
		command("perform wuji "+ob->query("id")); 

	}       
}


