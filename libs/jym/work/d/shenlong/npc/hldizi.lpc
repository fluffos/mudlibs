#include <ansi.h>
inherit NPC;
int do_kill(string arg);
int do_start();
int do_stop();
int jobid = 1;
nosave int this_job = 0;
void create()
{
  set_name("黑龙门弟子", ({ "di zi", "dizi" }));
  set("long",
      "一个黑龙门镇守要道的弟子。\n"
      "他三十多岁，体格强健，似乎武功不错。\n");
  set("gender", "男性");
  set("age", 35);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 30);
  set("int", 10);
  set("con", 30);
  set("dex", 35);
        
  set("max_qi", 19000);
  set("qi", 19000);
  set("max_jing", 19500);
  set("neili", 19000);
  set("max_neili", 19000);
  set("jiali", 100);
  set("combat_exp", 500000);
  set("score", 3000);

  set_skill("force", 300);
  set_skill("dulong-dafa", 300);
  set_skill("dodge", 300);
  set_skill("lingshe-shenfa", 300);
  set_skill("blade", 300);
  set_skill("qilin-dao", 300);
  set_skill("medicine",300);
  set_skill("poison",300);

  set_skill("parry", 300);


  map_skill("force", "dulong-dafa");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("parry", "qilin-dao");
  map_skill("blade", "qilin-dao");

  create_family("神龙教", 4, "弟子");

        

  set("inquiry", 
      ([
        "清兵" : "哼，这些清兵杀了咱们不少弟兄，一定要报仇。",
        "敌人" : "敌人？反抗神龙教的都是敌人。",
        "看守" : "哎，不知道教主什么时候才派人来这里看守。",
        "功劳" : "功劳越大，在神龙教的地位就越高。",
        "name" : "哈哈！我就是一个看守要道的弟子，我的名字不足挂齿。",
        "here" : "这里是进入神龙岛的三个要道之一，一定要防止清兵进入。",
        "rumors" : "听说最近教主找寻一些经书，不知道有什么用。",
        ]));
                                

  set("chat_chance", 5);



  setup();
  carry_object("/d/shenlong/zhanchang/obj/blade")->wield();
  carry_object("/clone/misc/cloth")->wear();

}

int accept_kill(object obj)
{
        if (obj->is_killing(this_object()) ) return 1;
        command("menpai* 报告：黑龙门所镇守的要道有敌人入侵，大家多加小心！");
}

void die()
{
  object ob;
  ob = this_player();
  this_job = 0;
  ob->delete("job/start");
  ob->add("shenlong/gonglao",-500);
  add_temp("stock", -1);
  command("menpai* corpse");
  message_vision("\n$N急急忙忙地离开了。\n", this_object());
  message_vision(HIR"这次坚守失败，下次努力吧！\n"NOR,this_object());
  ob->move("/d/shenlong/beach");
  destruct(this_object());
}

void init()
{

  add_action("do_start", "command");
  add_action("do_start", "命令");
  add_action("do_start", "开始");
  add_action("do_start", "start");
  add_action("do_start", "镇守");
  add_action("do_stop", "abandon");
  add_action("do_stop", "fangqi");

}

int do_start()
{
  int exp;
  object ob, blk, obj=this_object();
  ob = this_player();
  exp =  ob->query("combat_exp",1);
  if ( ob->is_busy() || ob->is_fighting() )
    {
      tell_object(ob, "你现在正忙着！\n");
      return 1;
    }           
   if(!present("heilong ling", this_player()))

   return notify_fail("无凭无据，如何让弟子听从你的吩咐？\n");

  message_vision(WHT"$N拿出腰间的黑龙令，对弟子说道：“我等奉教主之命，来到此处镇守要道！”。\n"NOR, ob);

  if ( ob->query("job/start") )
    {
      command("say 你不是正在镇守要道么？");
      return 1;
    }

  if (query_temp("stock") > 0)
    {
      command("say 此地已经有人镇守了。");
      return 1;
    }

  add_temp("stock", 1);
  ob->set("job/start", "1");
  message_vision(HIC"弟子接过$N手上的黑龙令看了看，然后还给$N。\n"NOR, ob);
  message_vision(HIC"弟子点了点头说道：“你等先在此地巡逻，记住一定要用尽全力镇守此地”。\n"NOR, ob);
  command("menpai 我教黑龙副使"+ob->query("name")+"率领属下镇守沙滩。"); 

  this_job = 1; 
  blk=new("/d/shenlong/npc/hlblkdizi");
  blk->move("/d/shenlong/beach");
  obj->set("combat_exp",exp);
  call_out("robber", 30, ob);
  return 1;
}

void robber(object obj)
{
  int i ,num;
  object ob,robber;
  ob = this_player();
  num = 4+random(1);
  message_vision(HIW"\n突然从沙滩上那边冲过来"+chinese_number(num)+"个清兵！手上拿着兵器，看起来气势汹汹！\n"NOR, ob);
  ob->set_temp("herb_victim", 1);
  for (i=0; i<num; i++)
{
  robber=new("/d/shenlong/npc/sl_npc");
  robber->move("/d/shenlong/haitan2");
  robber->kill_ob(ob);
  ob->kill_ob(robber);
}
  call_out("robber2", 120, ob);

}

void robber2(object obj)
{
  int i ,num;
  object ob,robber;
  ob = this_player();
  num = 5+random(2);
  message_vision(HIW"\n突然从沙滩上那边冲过来"+chinese_number(num)+"个清兵！手上拿着兵器，看起来气势汹汹！\n"NOR, ob);
  ob->set_temp("herb_victim", 1);
  for (i=0; i<num; i++)
{
  robber=new("/d/shenlong/npc/sl_npc");
  robber->move("/d/shenlong/haitan2");
  robber->kill_ob(ob);
  ob->kill_ob(robber);
}
  call_out("robber3", 120, ob);

}
void robber3(object obj)
{
  int i ,num;
  object ob,robber;
  ob = this_player();
  num = 5+random(3);
  message_vision(HIW"\n然从沙滩上那边冲过来"+chinese_number(num)+"个清兵！手上拿着兵器，看起来气势汹汹！\n"NOR, ob);
  ob->set_temp("herb_victim", 1);
  for (i=0; i<num; i++)
{
  robber=new("/d/shenlong/npc/sl_npc");
  robber->move("/d/shenlong/haitan2");
  robber->kill_ob(ob);
  ob->kill_ob(robber);
}
  call_out("finish_job", 120, ob);

}

void finish_job(object me,object obj)

{
  object ling, ob, *ob2;
  int exp, exp2, i;
  ob = this_player();
  ling = present("heilong ling", ob);
  if ( (this_job) )
  {
  message_vision(HIY"只见神龙岛上红旗飘扬，一个教众跑了过来！\n"NOR, ob);
  message_vision(HIY"教众对$N说道：“教主恭喜黑龙副使凯旋归来！”\n"NOR, ob);
  exp = 400+random(200);
  exp2 = exp/2;
  ob->add("combat_exp", exp);
  ob->add("shenlong/gonglao", 200);
  tell_object(ob,HIG"\n这次坚守你获得一些经验！\n"NOR);
  tell_object(ob,HIG"\n这次坚守你获得两百点神龙功劳！\n"NOR);

//  tell_object(ob,HIG"\n你的每个下属获得一些经验！\n"NOR);
//  tell_object(ob,HIG"\n你的每个下属获得一百点神龙功劳！\n"NOR);
  ob->delete("job/start");
  add_temp("stock", -1);
  
  ob2 = all_inventory(environment(me));

  for(i=0; i<sizeof(ob2); i++) {
  if( !living(ob2[i]) || ob2[i]==me ) continue;

  if (ob2->query_temp("shenlong/share黑龙",1))
 {
			tell_object(ob2[i], HIG"\n你获得一些经验！\n"NOR);
			tell_object(ob2[i], HIG"\n你获得一百点神龙功劳！\n"NOR);
			ob2->add("combat_exp", exp2);
			ob2->add("shenlong/gonglao", 100);  
 }

 message_vision(HIY"$N将黑龙令交给弟子，然后走了出去。”\n"NOR, ob);
// ob->move("/d/shenlong/beach");
 ob->delete_temp("shenlong/ling");
 destruct(ling);
 ob2->delete_temp("shenlong/share黑龙");
  this_job = 0;
}
}

}

int do_stop()

{
  object ob,ling;
  ob = this_player();
  ling = present("heilong ling", ob);

  if (!ob->query("job/start") )
    {
      return 1;
    }
  message_vision(HIY"$N决定放弃这次坚守！\n"NOR, ob);
  this_job = 0;
  ob->delete("job/start");
  ob->add("shenlong/gonglao",-500);
  ob->move("/d/shenlong/beach");
  ob->delete_temp("shenlong/ling");
  destruct(ling);       
  add_temp("stock", -1);
  return 1;
}
