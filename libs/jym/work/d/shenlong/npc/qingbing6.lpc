inherit NPC;


void create()
{
	set_name("清兵", ({
		"qing bing",
		"bing",
	}));
	set("long",
		"一个自以为是的清兵。\n"
	);

	set("gender", "男性");
	set("attitude", "aggressive");
	set("no_get", "清兵对你而言太重了。");

	set("age", 20);
	set("shen_type", 1);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 20);

       set("max_qi", 9555);
       set("max_jing", 9000);
       set("max_jingli", 9000);
       set("eff_jingli", 9000);
       set("jingli", 9000);
       set("jing", 9000);
	set("neili", 9000);
	set("max_neili", 6000);

	set("combat_exp", 800000);
	

	set_skill("force", 200);
	set_skill("huntian-qigong", 200);
	set_skill("dodge", 200);
	set_skill("xiaoyaoyou", 200);
	set_skill("strike", 200);
	set_skill("xianglong-zhang", 200);
	set_skill("hand", 200);
	set_skill("shexing-diaoshou", 200);
	set_skill("parry", 200);
	set_skill("staff", 200);
	set_skill("fengmo-zhang", 200);
	set_skill("stick", 200);
	set_skill("dagou-bang", 200);


	map_skill("force", "huntian-qigong");
	map_skill("staff", "fengmo-zhang");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("strike", "xianglong-zhang");
	map_skill("parry", "dagou-bang");
	map_skill("hand", "shexing-diaoshou");
	map_skill("stick", "dagou-bang");

       prepare_skill("strike", "xianglong-zhang");
       prepare_skill("hand", "shexing-diaoshou");

       create_family("丐帮", 5, "弟子");

	setup();

	switch( random(3) )
	{
		case 0:
			carry_object("/clone/weapon/gangzhang")->wield();
			break;
		case 1:
			carry_object("/clone/weapon/zhubang")->wield();
			break;
		case 2:
			carry_object("/clone/weapon/gangjian")->wield();
			break;
	}

            carry_object("/clone/armor/tiejia")->wear();

}


void init()
{
	object ob = this_player();
	
	::init();

	if (interactive(ob))
	{
		command("say 乱闯兵船者！杀无赦！");
		remove_call_out("kill_ob");

        	command("unwield sword");
		command("exert powerup");
		command("exert shengang");

		command("kill "+ob->query("id")); 
		command("perform leiting "+ob->query("id"));

		command("perform fengmo");
		command("perform chanshen "+ob->query("id"));
		command("perform duo "+ob->query("id"));
		command("perform feng "+ob->query("id"));
		command("perform chan "+ob->query("id"));




	}       
}


