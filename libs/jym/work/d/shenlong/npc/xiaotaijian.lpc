
//小太监

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("小太监", ({ "xiao taijian", "taijian", "gonggong" }) );
	set("gender", "无性" );
	set("age", 22);
	set("long",
		"这是一位小太监，忙忙碌碌的不知道要去做什么。\n");
	set("combat_exp", 100);
	set("attitude", "friendly");
	set("rank_info/respect", "小公公");


       set("chat_chance", 2); 
       set("chat_msg", ({ (: random_move :) })); 


	setup();

                   carry_object("/clone/misc/taijian_cloth")->wear(); 
                   
}

int accept_kill(object obj)
{
	if (obj->is_killing(this_object()) ) return 1;
        command("chat 杀人了！ " + obj->name() + "这个" + RANK_D->query_rude(obj
) + "要抢秘旨！");
        command("say 杀人了！ " + obj->name() + "这个" + RANK_D->query_rude(obj
) + "要杀我！");
}


 void die() 
     { 
             object ob, corpse, killer; 
      
             if( !living(this_object()) ) revive(1); 
             clear_condition(); 
      
             if( objectp(killer = query_temp("last_damage_from")) ) { 
                     ob = new("/d/shenlong/obj/mizhi"); 
                     ob->move(environment()); 
                     message_vision(HIR"\n$N伸手从衣袋中拿出什么东西，想要撕碎。\n"NOR, this_object()); 
                     message_vision(HIR"\n突然从$N手中掉下一" + ob->query("unit") + ob->name() + "。\n"NOR, this_object()); 
             } 
          
             COMBAT_D->announce(this_object(), "dead"); 
             if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) ) 
             corpse->move(environment()); 
             remove_all_killer(); 
             all_inventory(environment())->remove_killer(this_object()); 
      
             dismiss_team(); 
             destruct(this_object()); 
     } 



     int random_move() 
     { 
             mapping exits, doors; 
             string *dirs, dir; 
             object me=this_object(); 
      
             if (is_fighting() || is_busy() || !living(me)) 
                  return 0; 
      
             if (!me->query("steps")) { 
                  remove_call_out("destroying"); 
                  call_out("destroying",600,me); 
             } 
      
             if (me->query("steps")>=25) { 
                  remove_call_out("destroying"); 
                  call_out("destroying",1,me); 
                  return 0; 
             } 
      
             me->add("steps",1); 
      
             if (!objectp(environment())  
                  || !mapp(exits = environment()->query("exits"))  
             || query("jingli") < query("max_jingli") / 2 ) 
                  return 0; 
      
             dirs = keys(exits); 
      
             if (this_object()->query("race") == "人类" 
                  && mapp(doors = environment()->query_doors())) 
                  dirs += keys(doors); 
      
             if (sizeof(dirs) == 0) return 0; 
             dir = dirs[random(sizeof(dirs))]; 
      
      
             command("go " + dir); 
             return 1; 
     } 

     void destroying(object me) 
     { 
             message_vision("$N看了看四周，若无其事地离开了。\n",me); 
             destruct(me); 
             return; 
     } 
