// 秘旨
#include "ansi.h"

inherit ITEM;

void setup()
{}



void create()
{
	set_name(HIW "秘旨" NOR, ({ "mi zhi", "mizhi", "xin"}));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else
	{
		set("unit", "封");
		set("long", "这是一封皇帝给韦小宝的秘旨，上面画着许多的图画，看你的脑袋疼。\n");
		set("value", 5000);
		set("no_steal", 1);
		set("material", "paper");
	}

}
