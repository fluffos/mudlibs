// book

inherit ITEM;

void create() {
  set_name("『王叔和脉经』", ({ "medicine book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本学习治疗的书籍。\n");
    set("value", 200);
    set("material", "paper");
    set("skill", ([
      "name": "medicine",  // name of the skill
      "exp_required": 0,   // minimum combat experience required
      // to learn this skill.
      "jing_cost": 80,   // jing cost every time study this
      "difficulty": 20,   // the base int to learn this skill
      // modify is jing_cost's (difficulty - int)*5%
      "max_skill": 200   // the maximum level you can learn
      // from this object.
    ]));
  }
}
