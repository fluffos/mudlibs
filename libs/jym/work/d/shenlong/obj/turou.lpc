inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("烤兔子肉", ({ "tu rou", "tuzi rou" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块神龙岛上的野兔肉，烤的是外焦里嫩。\n");
    set("unit", "块");
    set("value", 150);
    set("food_remaining", 3);
    set("food_supply", 60);
    //		set("drink_supply", 50);

  }
}
