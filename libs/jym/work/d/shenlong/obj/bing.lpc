inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("咸鱼饼子", ({ "bing", "xianyu bing" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一张用咸鱼和玉米面做成的饼，有着咸鱼的味道，并且很解饿。\n");
    set("unit", "张");
    set("value", 150);
    set("food_remaining", 3);
    set("food_supply", 60);
    //		set("drink_supply", 50);

  }
}
