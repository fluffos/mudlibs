#include <ansi.h>
inherit ITEM;

void setup() {}
void create() {
  set_name(HIG "树" NOR, ({ "tree" }));
  set_weight(200000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一棵水缸一样粗的参天大树，树上树叶繁茂，但是树干上隐约有一些掌印，不知道是谁印上去的。你可以用这棵树进行散功(sangong)\n");
    set("unit", "棵");
    set("material", "steal");
  }
  setup();
}

void init() {

  add_action("do_strike", "sangong");
}


int do_strike(string arg) {
  int lvl;
  object ob, me = this_player();

  lvl = (int)me->query_skill("huagu-mianzhang", 1);

  if (lvl < 200 || me->query("hgmz_sangong") * 100 > lvl - 200)
    return notify_fail("你暂时不用散功。\n");

  if (arg != "tree")
    return notify_fail("什么？。\n");

  if ((int)me->query("neili") < 1000 || me->query("jingli") < 500)
    return notify_fail("你身体状态不好，强行散功可能会导致受伤。\n");

  message_vision(
    HIY "$N将" NOR HIB "「化骨棉掌」" NOR "" HIY "凝聚于右手，汇集全身之力猛地对准树干打去，将体内的化骨之毒全部推入树内。\n" NOR,
    me
  );
  message_vision(HIG "大树剧烈地晃动了几下。\n" NOR, me);

  me->add("hgmz_sangong", 1);
  me->set("neili", 0);
  me->set("jingli", 100);
  ob = this_object();
  message_vision(HIW "只听一声巨响，大树竟然断成两截，可见掌力之猛。\n" NOR, me);
  me->delete_skill("huagu-mianzhang");
  message_vision(CYN "$N将化骨棉掌全部功力散去。\n" NOR, me);

  destruct(ob);
  return 1;

}
