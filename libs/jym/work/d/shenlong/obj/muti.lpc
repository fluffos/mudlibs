//Pingguo

#include <weapon.h>

inherit HAMMER;

void create()
{
		  set_name("木梯", ({ "mu ti", "ti" }) );
		  set_weight(1000);
		  if( clonep() )
					 set_default_object(__FILE__);
		  else {
					 set("unit", "架");
					 set("long", "这是一架木制的梯子。\n");
                set("value", 50);
                set("material", "iron");
                set("wield_msg", "$N拿出一架$n，握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(5);
		  setup();
}

init()
{
	object me = this_player();
	 if ( me->query("id",1)!="xu xueting" && !wizardp(me)) {
		set("no_drop",  "这么有用的东西怎么能扔了呢。\n");
		set("no_steal", "这个东西你偷不到。\n");
		}
}
