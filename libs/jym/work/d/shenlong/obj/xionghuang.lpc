// xionghuang.c 雄黄
// ywz 08/31/96
// Pingguo
#include <ansi.h>

inherit ITEM;

int do_eat(string);
int do_nian(string);
//void init();

void init()
{
        add_action("do_nian", "nian");
        add_action("do_eat", "eat");
}

void create()
{
	set_name(YEL "雄黄" NOR, ({"xionghuang", "huang"}));
        set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
		set("unit", "块");
		set("long", "这是一块雄黄，看上去黄澄澄的。\n");
		set("value", 500);
        }

        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
		return notify_fail("你要吃什么？\n");

	return notify_fail("这东西太大了，无法吃下去。\n");

        return 1;
}


int do_nian(string arg)
{
        object obj, me;

        if (!arg || (arg != "雄黄" && arg != "xionghuang"))

                return notify_fail("你要碾什么？\n");

        me = this_player();

        message_vision(YEL"$N小心翼翼地将雄黄放在掌心中碾碎！\n"NOR,me); 
        obj = new("/d/shenlong/obj/xionghuang2");
        obj->move(me);
        destruct(this_object());
        return 1;
}

