//Pingguo
//神龙教-面罩，可以察看功劳

#include <armor.h>
#include <ansi.h>
#include <command.h>
inherit HEAD;

int query_autoload() {return 1;}

void do_copy(object, object);
void do_flee(object);
int eff_fam(object);


void create()
{
        set_name("面罩", ({ "mianzhao", "mask" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", 
                        "这是个神龙教特有的黑布头套，能把整个脑袋套起来，只露出两个眼睛。\n"
                        "这个面罩是神龙教的特征，丢失以后可以去胖头陀那里领取。\n"
                        "可以使用<check>指令来察看本人，和任何身边神龙教弟子在教中的地位。\n");
                set("material", "cloth");
                set("armor_prop/armor", 20);
                set("value", 10);
                set("no_get", "这样东西不能离开那儿。\n");
                set("no_drop", "这样东西不能离开你。\n");
        }

        setup();
}

void init()
{
        add_action("do_wear", "wear");
        add_action("do_remove", "remove");
        add_action("do_check", "check");
        add_action("do_check", "察看");
        add_action("do_join", "join");
        add_action("do_join", "参加");



}

int do_wear(string arg)
{
        if (!arg || (arg != "mianzhao" && arg != "mask" && arg != "all") ) return 0;

        this_player()->set_temp("apply/name",  ({"蒙面人"}));
        this_player()->set_temp("apply/short", ({"蒙面人(Mengmian ren)"}));
        this_player()->set_temp("apply/long",  ({"一个黑布蒙面，神秘兮兮的家伙。\n"}));

        return 0;
}

int do_remove(string arg)
{
        if (!arg || (arg != "mianzhao" && arg != "mask" && arg != "all") ) return 0;

        this_player()->delete_temp("apply/name");
        this_player()->delete_temp("apply/short");
        this_player()->delete_temp("apply/long");
      

        return 0;
}




int do_check(string arg)
{
object me = this_player(),ob;
string zhiwei;
int rank;
mapping fam;

if( !arg ) 
{
rank = me->query("shenlong/rank");

        if (rank < 2 )
                zhiwei = "教众";
        else if (rank < 3)
                zhiwei = "香主";
        else zhiwei = "护法";

write(HIW"\n─────────────────────────\n"NOR);
write(HIR"你目前在神龙教功劳是: "NOR HIY "〖" +chinese_number(me->query("shenlong/gonglao"))+ "〗"NOR HIR"点\n"NOR);
write(HIR"你目前在神龙教的职位是: "NOR HIW "〖" +  zhiwei + "〗\n"NOR);
write(HIR"你目前已经交给教主: "NOR HIC "〖" +chinese_number(me->query("shenlong/give_42jing"))+ "〗"NOR HIR"本四十二章经\n"NOR);
write(HIR"你目前的权利值: "NOR HIG "〖" +chinese_number(me->query("shenlong/quanli"))+ "/一千〗"NOR HIR"点\n"NOR);
write(HIW"─────────────────────────\n"NOR);

return 1;
}

if( !(ob = present(arg, environment(me)))
||	!living(ob)
||	!ob->is_character()
||	ob==me )
return notify_fail("你想察看谁的功劳？\n");

if ( (!( fam= ob->query("family")) || fam["family_name"] != "神龙教"))
return notify_fail("你无法察看非神龙教弟子！\n");

if(!userp(ob) )
return notify_fail("你只能察看玩家的功劳。\n");

rank = ob->query("shenlong/rank");

        if (rank < 2 )
                zhiwei = "教众";
        else if (rank < 3)
                zhiwei = "香主";
        else zhiwei = "护法";


write(HIW"\n─────────────────────────\n"NOR);
write(HIR"姓名: " NOR WHT "〖"+ ob->query("name") + NOR "(" WHT + ob->query("id") + NOR ")" WHT "〗\n"NOR);
write(HIR"年龄: " NOR WHT "〖"+ chinese_number(ob->query("age")) + "〗"NOR HIR"岁\n"NOR);
write(HIR"师傅: " NOR WHT "〖" + ob->query("family/master_name") + "〗\n"NOR);
write(HIW"─────────────────────────\n"NOR);
write(HIR"此人目前在神龙教功劳是: "NOR HIY "〖" +chinese_number(ob->query("shenlong/gonglao"))+ "〗"NOR HIR"点\n"NOR);
write(HIR"此人目前在神龙教的职位是: "NOR HIW "〖" +  zhiwei + "〗\n"NOR);
write(HIW"─────────────────────────\n"NOR);


return 1;
}

int do_join()
{
object me;
string title;
me = this_player();

if (me->query_temp("shenlong/team/qinglong"))

{

title = HIC"神龙教隶属青龙门教众"NOR + " " + me->query("name") + 
              "(" + capitalize(me->query("id")) + ")";;
me->set_temp("apply/short", ({title}));
write(HIC"〖这次战斗，你隶属于青龙门〗\n"NOR);
me->delete_temp("shenlong/team/qinglong");
me->set_temp("shenlong/share青龙",1);
return 1;

}
else if (me->query_temp("shenlong/team/huanglong"))
{

title = HIY"神龙教隶属黄龙门教众"NOR + " " + me->query("name") + 
              "(" + capitalize(me->query("id")) + ")";;
me->set_temp("apply/short", ({title}));
write(HIY"〖这次战斗，你隶属于黄龙门〗\n"NOR);
me->delete_temp("shenlong/team/huanglong");
me->set_temp("shenlong/share黄龙",1);

return 1;

}
else if (me->query_temp("shenlong/team/heilong"))
{

title = WHT"神龙教隶属黑龙门教众"NOR + " " + me->query("name") + 
              "(" + capitalize(me->query("id")) + ")";;
me->set_temp("apply/short", ({title}));
write(WHT"〖这次战斗，你隶属于黑龙门〗\n"NOR);
me->delete_temp("shenlong/team/heilong");
me->set_temp("shenlong/share黑龙",1);

return 1;

}
else if (me->query_temp("shenlong/team/chilong"))
{

title = HIR"神龙教隶属赤龙门教众"NOR + " " + me->query("name") + 
              "(" + capitalize(me->query("id")) + ")";;
me->set_temp("apply/short", ({title}));
write(HIR"〖这次战斗，你隶属于赤龙门〗\n"NOR);
me->delete_temp("shenlong/team/chilong");
me->set_temp("shenlong/share赤龙",1);

return 1;

}
else return notify_fail("你目前没有可以加入的队伍。\n");
return 1;
}
