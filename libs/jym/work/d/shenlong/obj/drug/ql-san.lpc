#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIY"清螺健步散"NOR, ({ "ql-san" }) );
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", 
"这是刚刚提炼出来的清螺健步散这个东西可以卖(Sellto)给其他需要的人。\n");
                set("unit",  "些");
                set("value",  100000000);
//                set("no_drop", "这样东西不能离开你。\n");
                set("no_give", "这样东西不能离开你。\n");
                set("no_steal", "这样东西你不能偷的。\n");
//                set("no_get", "丹药遇到土地久无法拿出来了。\n");
                set("shenlong_drug", 1);


        }
        setup();
}

void init()

{
	add_action("do_sell", "sellto");
}

int do_sell(string arg)
{
	object me, exp, obj, addexp, addpot, ob;
	me = this_player();
	obj = this_object();
       
        if (me->query("family/family_name") != "神龙教") {
                write("你不是神龙教弟子，哪里来着这种药！\n");
                return 1;       
        }
      
	if( !arg )
              return notify_fail("你要把东西卖给谁？\n");

	if(!objectp(ob = present(arg, environment(me))))
		return notify_fail("这里没有这个人。\n");

       if( !living(ob) )
              return notify_fail("你还是等此人醒来后再说吧。\n");
   
       if(ob->query("family/family_name") == "神龙教")
		return notify_fail("这个东西的效果神龙教的都知道，卖不出去的。\n");


       if (ob->query("race") != "人类" )
       	return notify_fail("你只能把东西卖给人类。\n");

       if( userp(ob) )
                return notify_fail("玩家不会出好价钱的。\n");

       if( ob->query("combat_exp")*3 < me->query("combat_exp")*2 )
                return notify_fail("此人江湖阅历经历的风雨太少，估计没那么多钱。\n");


       message_vision(CYN"$N提著小竹篮，背著小扁担，对着$n叫卖:“祖传仙药，包治百病，一帖就灵 !”。\n"NOR, me, ob);
       message_vision("$N满面笑容说道：" + chinese_number(ob->query("combat_exp")/100) + "两金子，您看看如何？。\n", ob);
       message_vision("$N高高兴兴地将" + obj->query("unit") + obj->name() + "交给$n。\n", me, ob);
       message_vision("$N痛快地说到：“稍候我会把钱送到您教的胖尊者手里的！\n", ob);
       

       me->add("shenlong/gonglao",5);
       me->add("combat_exp", 30);
       me->add("potential", 10);
       if ( me->query("potential") > me->query("max_potential") )
{
       me->set("potential", me->query("max_potential"));
       tell_object(me,BRED+HIY"由于成功地卖出了" + obj->query("unit") + obj->name() + "。\n"NOR);
       tell_object(me,BRED+HIY"你的潜能满了无法增加。\n"NOR);
       tell_object(me,BRED+HIY"你的经验增加60点。\n"NOR);
       tell_object(me,BRED+HIY"你的神龙教功劳增加了5点。\n"NOR);
       destruct(obj);
       return 1;
}
       tell_object(me,BRED+HIY"由于成功地卖出了" + obj->query("unit") + obj->name() + "。\n"NOR);
       tell_object(me,BRED+HIY"你的潜能增加了10点。\n"NOR);
       tell_object(me,BRED+HIY"你的经验增加30点。\n"NOR);
       tell_object(me,BRED+HIY"你的神龙教功劳增加了5点。\n"NOR);
       me->start_busy(2);

       destruct(obj);
       
       return 1;

}
