// pingguo
// 忍者三宝-忍者服装
#include <armor.h>

inherit CLOTH;
#include <ansi.h>;
void create() {
  set_name(HIB "忍者服" NOR, ({ "renzhe fu", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "套");
    set("long", "这是一套十分神秘的忍者套装。\n");
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("no_drop", "这样东西不能离开你。\n");
  }
  setup();
}

void init() {
  add_action("do_wear", "wear");
  add_action("do_remove", "remove");
}

int do_wear(string arg) {
  if (!arg || (arg != "renzhe fu" && arg != "cloth")) return 0;

  this_player()->set_temp("apply/name", ({ HIY "忍者" NOR }));
  this_player()->set_temp("apply/short", ({ HIY "忍者(Ren zhe)" NOR }));
  this_player()->set_temp("apply/long", ({ "一个日本忍者。\n" }));

  return 0;
}

int do_remove(string arg) {
  if (!arg || (arg != "renzhe fu" && arg != "cloth")) return 0;

  this_player()->delete_temp("apply/name");
  this_player()->delete_temp("apply/short");
  this_player()->delete_temp("apply/long");

  return 0;
}
