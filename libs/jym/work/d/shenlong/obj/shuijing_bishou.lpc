// 随身匕首
// 神龙弟子随身携带
#include <weapon.h>
inherit SWORD;
inherit F_AUTOLOAD;
int query_autoload() { return 1; }
#include <ansi.h>;
void create() {
  set_name(HIC "水晶匕首" NOR, ({ "shuijing bishou", "sword" }));
  set_weight(80);
  set_max_encumbrance(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄短小的匕首，通体透明，是神龙教的信物。\n");
    set("value", 150);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声从靴子里面抽出一把短小的$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回靴子中。\n");
  }
  init_sword(15);
  setup();
}
