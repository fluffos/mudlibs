//碎雄黄

inherit PILL;
#include <ansi.h>;
int cure_ob(string);


void create() {
  set_name(YEL "碎雄黄" NOR, ({ "sui xionghuang", "xionghuang" }));
  set("unit", "些");
  set("long", "这是一些已经碾碎的雄黄粉末。\n");
  set("value", 200);
  set("medicine", 1);
  setup();
}




void init() {
  add_action("do_pour", "pour");
}

int cure_ob(object me) {
  message_vision("$N吃下一些" + name() + "。\n", me);
  if ((int)me->query_condition("snake_poison") > 10) {
    me->apply_condition("snake_poison", (int)me->query_condition("snake_poison") - 5);
  }

  destruct(this_object());
  return 1;
}
int effect_in_liquid(object ob) {

  if ((int)this_player()->query_condition("snake_poison") > 1) {
    tell_object(this_player(), YEL "你感觉口中辛辣无比，但是被蛇咬过的伤口渐渐恢复了知觉。\n" NOR);
    this_player()->start_busy(2);
    this_player()->apply_condition(
      "snake_poison",
      (int)this_player()->query_condition("snake_poison") - 4
    );
  }
  return 0;
}
