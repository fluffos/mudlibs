inherit F_CLEAN_UP;

#include <armor.h>
#include <ansi.h>
#include <command.h>
inherit WAIST;

void create() {
  set_name(HIR "赤龙令" NOR, ({ "chilong ling", "ling" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "steel");
    set("long", "这是一块精致的令牌，上面画着一条龙，看起来栩栩如生。
----------------------------------------------
使用方法：
slscore：  察看有多少队员。
slwith：   请神龙教教众加入你所在的门。
----------------------------------------------\n");
    set("unit", "块");
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("value", 50);
    set("armor_prop/armor", 1);
    set("wear_msg", "$N从怀里面将$n取了出来，挂在腰上。\n");
    set("unremove_msg", "$N将腰上的$n摘了下来放在怀里。\n");
  }
  setup();
}
void init() {
  if (this_player() == environment())
    add_action("do_score", "slscore");
  add_action("do_with", "slwith");
}

int do_score(string arg) {
  object *t, me;
  me = this_player();

  if (!pointerp(t = me->query_team()))
    return notify_fail("你还没有找到加入你赤龙门的教众呢。\n");
  write(HIR "目前你所率领的赤龙门教众有：\n  " + implode(t->name(1), "\n  ") + "。\n" NOR);
  return 1;
}

int do_with(string arg) {
  object me, ob;
  string title;
  mapping fam;
  me = this_player();
  if (!arg) {
    return notify_fail("你想邀请谁加入？\n");
    return 1;
  }
  if (!(ob = present(arg, environment(me)))
    || !living(ob)
    || !ob->is_character()
    || ob == me)
    return notify_fail("你想邀请谁加入？\n");

  if ((!(fam = ob->query("family")) || fam["family_name"] != "神龙教"))
    return notify_fail("你无法将非神龙教弟子加入赤龙门！\n");

  if (!userp(ob))
    return notify_fail("无法将npc加入赤龙门。\n");


  if (me->have_team_member(ob))
    return notify_fail(ob->name(1) + "已经是你的队伍成员了。\n");

  message_vision("$N邀请$n纳入赤龙门。\n", me, ob);
  tell_object(ob, YEL "这次战斗你是否愿意成为赤龙门的教众，帮助赤龙门副使完成任务。\n" NOR);
  tell_object(ob, YEL "如果愿意参加请输入（参加 或者 join）。\n" NOR);

  me->set_temp("pending/team", ob);

  ob->set_temp("shenlong/team/chilong", 1);
  me->add_team_member(ob);
  return 1;
}
