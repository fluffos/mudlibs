

#include "ansi.h"

inherit ITEM;

void create()
{
        set_name(HIR "血书" NOR, ({ "xue shu", "paper" }));
        set("weight", 10);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long","

老夫晚年独闯神龙，■■竟身困陷阱，无法脱身。全身纵有无敌之术，怎
奈这小小陷阱。老夫年轻时，深■华山武功精髓，杀大奸大■之人无数。
老夫身上带有绳■，只因■■■■，后生小辈如寻到，可顺绳索■出。
如有幸逃出此监牢，忘汝等行侠仗义。

华山独孤■云

\n");
                set("unit", "张");
                set("material", "wood");
        }
        setup();
}       