// 夜风(YeFeng) 2009.1

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "长廊");
        set("long", @LONG
蜿蜒的长廊好像没有尽头一般，周围挂满了树叶、青藤，边上有许多小石
凳可供人休息。一些凳子上面三三两两地坐了许多神龙教的弟子，正在七嘴八
舌地谈论着什么。
LONG
        );
        set("cost", 1);
        set("outdoors", "shenlong");

        set("exits", ([
                "west": __DIR__"dating",
                "east": __DIR__"changlang2",
                 "south": __DIR__"bailongmen",
                 "north": __DIR__"chilongmen",
        ]));

        set("objects", ([
                "/kungfu/class/shenlong/fang" : 1,
        ]));

        setup();
}
