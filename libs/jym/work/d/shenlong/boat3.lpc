inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIR "炮船甲板" NOR);
  set("long", @LONG
此船乃水师主力，身高大，首昂尾翘，航行迅速，不惧风浪。
树三桅，主桅高四丈，船长二十丈，舱五层，船面设楼高如城，
可容三百余人，配红夷炮八门，千斤佛郎机四十门。      
LONG);

  set("outdoors", "shenlong");
  set("exits", ([
    "north": __DIR__ "boat4",
    "south": __DIR__ "boat2",
    "down": __DIR__ "boat6",
  ]));
  set("objects", ([
    "/d/shenlong/npc/qingbing6": 1,
    "/d/shenlong/npc/qingbing4": 1,
    "/d/shenlong/npc/qingbing5": 1,
  ]));
  set("cost", 1);
  setup();
}
