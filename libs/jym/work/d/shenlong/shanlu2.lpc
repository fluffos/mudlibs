// 夜风(YeFeng) 2009.1

inherit ROOM;
#include <ansi.h>
void create()
{
		  set("short","山路");

		  set("long",@LONG
顺着山路前进，四周围都是十分茂盛的树林，偶尔树叶有一些颤动，可能
是小猴子之类的动物。
LONG);

		  set("exits",([ "northup" : __DIR__"shanlu3",
                               "southdown" : __DIR__"shanlu1",
							 ])
			  );
	  set("cost",2);
	  set("outdoors", "shenlong");

		  setup();

}


int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");

        if (!myfam || myfam["family_name"] != "神龙教")
{       
        if( random((int)me->query_skill("dodge")) <= 100) 
        {

                message_vision(HIR"$N一不小心脚下踏了个空！\n"NOR, me);
                me->move(__DIR__"xianjing");
                message("vision", HIR"只见" + me->query("name") + "掉入陷阱！\n"NOR, environment(me), me);
        return notify_fail(HIR"... 啊 ... ... ... 。\n"NOR);
        }
}
        return ::valid_leave(me, dir);
}