#include <ansi.h>

inherit HARBOR;

void create()
{
        set("short", "海岸");
        set("long", @LONG
这是神龙岛的出海口，浪花拍打着礁石，发出阵阵响声，海面上一群群海
鸥『欧欧..』地叫着，不时有鱼儿跃出海面，溅起层层的浪花。边上有艘大船
(chuan)， 船上坐着几个船夫打扮的人，乘船可渡过大海到达海的另一端。东
面是神龙岛的海滩。
LONG
        );

        set("outdoors", "shenlong");
        set("no_fight", "1");
        set("no_steal", "1");
        set("no_sleep_room", "1");

        set("exits", ([
                "east" : __DIR__"haitan",
                "north" : __DIR__"haitan2",
                "south" : __DIR__"haitan1",

        ]));

        set("item_desc", ([
                "chuan" : "这是一艘海船，可载人渡海，但是船家在平时也用它来捕鱼。\n",
        ]));

        set("objects", ([
	     "/d/shenlong/npc/yufu2" : 1, 
        ]));

        set("island", "神龙岛");
        set("shape", "出现一片陆地。");
        set("navigate/locx", 30);
        set("navigate/locy", 20);

        set("cost", 3);

        setup();
}
void init()
{
        add_action("do_exercise",  "exercise");
        add_action("do_exercise",  "dazuo");
        add_action("do_exercise",  "respirate");
        add_action("do_exercise",  "tuna");
}

int do_exercise(string arg)
{
        object me = this_player();
        tell_object(me, "这里过于吵闹，你无法静下心来调息！\n");
        return 1;
}

int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");

        if (objectp(present("chilong dizi", environment(me))) ) {
                
        if (dir == "south" ) 
           return notify_fail("弟子说道：我弟子正在里面奋勇搏杀，请勿入内！”。\n");
        }

        if (objectp(present("heilong dizi", environment(me))) ) {
                
        if (dir == "north" ) 
           return notify_fail("弟子说道：我弟子正在里面奋勇搏杀，请勿入内！”。\n");
        }                
        return ::valid_leave(me, dir);
}

