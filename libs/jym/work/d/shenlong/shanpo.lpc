// 夜风(YeFeng) 2009.1

#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "山坡");
        set("long", @LONG
这是一个山坡，通向北方的一座山峰，坡很陡，轻功不好的人爬起来就更
加费力。突然间，你看见树上、草上、路上，东一条，西一条全是毒蛇，可怕
极了！
LONG
        );
	set("cost", 6);
        set("outdoors", "shanfeng");

        set("exits", ([
		"northup" : __DIR__"shanfeng",
		"southdown" : __DIR__"shanxi2",
        ]));

        setup();
}

