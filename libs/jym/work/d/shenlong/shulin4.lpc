// 夜风(YeFeng) 2009.1

inherit ROOM;

void create()
{
        set("short","树林");

        set("long",@LONG
这是一片茂密的树林，无数枝叶在风中摇摆，发出奇异的响声。树上盘绕
着各种各样的蛇，只见那蛇头成三角形，地上有不少的尸骨，空气中散发着阵
阵腐败的气味。
LONG);

        set("exits",([ "northwest" : __DIR__"shulin1",
                        "north" : __DIR__"shulin2",
                        "east" : __DIR__"shulin7",
                      ])
			  );
	  set("cost",2);
	  set("outdoors", "shenlong");

        setup();

}



