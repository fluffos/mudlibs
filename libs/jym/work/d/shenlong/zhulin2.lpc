// 夜风(YeFeng) 2009.1

#include <ansi.h>
inherit ROOM;
int do_open(string);
void create()
{
        set("short", "竹林");
        set("long", @LONG
这儿是一片密实的竹林，光线暗淡，你一不小心就会被脚下的枝条绊个跟
头。附近似乎有轻微的沙沙声，好象是海风吹过又好象是虫子爬过，你觉得有
点不对劲，但又说不出是什么。
LONG
        );

        set("outdoors", "shenlong");
        set("exits", ([
                "north" : __DIR__"qianlong",
                "south" : __DIR__"shibanlu",

        ]));
        set("objects", ([
//                CLASS_D("shenlong")+"/zhangdanyue" : 1
]));

        set("cost", 1);

        setup();
}


void init()
{

	add_action("do_open", "open");
}

int do_open(string arg)
{
	object me;
	object *inv;
	int i;
	me=this_player();

	if (arg=="bamboo" && me->query("family/master_id")=="hong antong")
	{
		inv=all_inventory(me);
		for(i=0; i<sizeof(inv); i++)
		{
			if (userp(inv[i])) return notify_fail("你负重太大了，无法进入竹林小道。\n");
			if (inv[i]->query("id")=="corpse") return notify_fail("带着尸体去领悟？！\n");
		}
		tell_object(me, "你轻轻旋转竹林中的一棵竹子，突然竹林又多出一条小路。\n");
		tell_object(me, "你顺着小路来到一片更为宽广的竹林。\n");
		me->move("/d/shenlong/mishi.lpc");
		return 1;
	}
	return 0;
}
