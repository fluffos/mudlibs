// YeFeng 2009.1

inherit ROOM;

void create()
{
	set("short", "药房");
        set("long", @LONG
这是陆大夫的药房，靠墙放了许多柜子 （guizi），抽屉中放满了许多中
草药，陆大夫常在这儿给岛上的众人抓药、诊治。你可以在这儿向陆大夫要一
些雄黄以避免岛上的毒蛇侵扰。
LONG
        );
        set("item_desc", ([
        "guizi" : "一面墙的柜子，柜子上面放了好多好多的小瓶子。\n",
        ]));
		set("no_fight", "1");
		set("no_steal", "1");
		set("no_sleep_room", "1");

		set("exits", ([
                "west" : __DIR__"shibanlu",
        ]));

	set("objects", ([
                CLASS_D("shenlong")+"/lu" : 1,
                CLASS_D("shenlong")+"/lu2" : 1]));
	set("cost", 1);

        setup();
        replace_program(ROOM);
}






