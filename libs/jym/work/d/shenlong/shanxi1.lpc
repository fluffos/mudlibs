inherit FERRY;

void create() {
  object room;

  set("short", "山溪");
  set("long", @LONG
沿山溪而行，溪水淙淙，草木清新，颇感心旷神怡。往西是一条蜿蜒的山
路，向东眺望，便是一道宽广的山路。

   近岸处有一叶小舟，也许喊(yell)一声船家就能听见。
LONG
  );

  set("exits", ([
    "west": __DIR__ "shanlu4",
  ]));


  set("resource/water", 1);
  set("outdoors", "shenlong");
  set("objects", ([
    CLASS_D("shenlong") + "/liuyan": 1,
  ]));
  set("cost", 2);

  set("name", "溪");
  set("boat", __DIR__ "duchuan");
  set("opposite", __DIR__ "shanxi2");

  setup();
}
