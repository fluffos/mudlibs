#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "山峰");
        set("long", @LONG
此峰高约百米，路宽仅一米，而登山之路则在其山脊之上，两侧脊坡光滑
挺拔，其下悬崖深邃，云涛隐伏。
LONG
        );
	set("cost", 6);
        set("outdoors", "shenlong");

        set("exits", ([
		"northup" : __DIR__"fengding",
                "southdown" : __DIR__"shanpo",
        ]));



        setup();
}

