#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "海滩");
        set("long", @LONG
但见岸上树木苍翠，长长的海滩望不到尽头，尽是雪白的细沙，四处一片
寂静，听不见一点声音，西面是大海，东面仿佛有一座山峰，两旁是望不到尽
头的海滩。
LONG
        );

	set("exits", ([

		"north" : __DIR__"beach",
		"east" : __DIR__"shulin1",
		"south" : __DIR__"haitan",

        ]));
        set("objects", ([
            "/d/shenlong/npc/cldizi" : 1,
            "/kungfu/class/shenlong/hesheng.lpc" : 1,
        ]));
	set("cost", 2);

        setup();
}



int valid_leave(object me, string dir) {
    object ob;


    if ( me->query("job/start") )
              if (objectp(present("di zi", environment(me)))) 
                      return notify_fail("你现在正在镇守要道，如果要离开请放弃(abandon)，你会损失一些神龙教功劳！\n"); 
              else             
              { 
                      message_vision("$N看形势不妙，急急忙忙溜走了。\n", me);          
       
                      me->delete("job/start");
                      me->add("shenlong/gonglao",-500);
              } 

        return ::valid_leave(me, dir);
}


void init()
{

        add_action("do_quit", "quit");
        add_action("do_make", "da");
        add_action("do_make", "make");


}



int do_quit()

{
        write("这里目前无法退出游戏。\n");
        return 1;
}

int do_make(string arg)
{
        object room, me;

        if( !arg || arg=="" )
                return 0;

        if( arg=="qiao" && !present("mu ti", this_player()))
                return notify_fail("没有木梯，怎么搭桥？\n");

        if( arg=="qiao" && !query("exits/west") )
        {
                message_vision( 
                "$N将木梯慢慢地和船身连接起来……\n"
                "搭成一条木梯。\n", this_player());

                set("exits/west", __DIR__"boat2");
                if( room = find_object(__DIR__"boat2") ) 
                {
                        room->set("exits/east", __FILE__);
                        message("vision", "只见一支木板将船和岸连接起来。\n",
                                room );
                }
                remove_call_out("close_passage");
                call_out("close_passage", 5);
                return 1;
        }
        return 0;
}

void close_passage()
{
        object man1, man2, man3, man4, room, *ob;
        int i;

        if( !query("exits/west") )
                return;

        if( room = find_object(__DIR__"boat2") ) {

                message("vision", 
        "只听咔，嚓一声响，接着碎掉的木梯掉了下来。\n"
        "船上的人将木梯砍断了。\n", room );
        }
        delete("exits/west");
}
