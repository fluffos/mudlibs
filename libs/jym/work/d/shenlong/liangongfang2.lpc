inherit ROOM;
int do_lian(string arg);
void create() {
  set("short", "练功房");
  set("long", @LONG
这里是神龙教秘密的练功房，地下整整齐齐放着几个蒲团，几位神龙教长老
正盘膝坐在上面练功。墙壁上画着一些神龙教基本的武功，好像是一个人在
点穴。你不禁也想练习一下（lian finger）。北面是女厢房。
LONG
  );
  set("exits", ([
    "south": __DIR__ "wuqiku",
    "west": __DIR__ "zhulin1",
    "north": __DIR__ "shuifang2",
  ]));
  set("objects", ([
    __DIR__ "obj/tree": 3,
  ]));
  set("cost", 0);

  setup();
}

int valid_leave(object me, string dir) {
  if (me->query("gender") == "男性" && dir == "north" && !wizardp(me))
    return notify_fail("看清楚点，那是女厢房！\n");

  return ::valid_leave(me, dir);
}
void init() {

  add_action("do_lian", "lian");
}


int do_lian(string arg) {
  object me = this_player();
  int check;
  if (!arg)
    return notify_fail("你只能练习用 enable 指定的特殊技能。\n");
  if (arg != "finger")
    return notify_fail("你只能练习用 enable 指定的特殊技能。\n");


  if ((int)me->query("qi") < 26 || me->query("jingli") < 30)
    return notify_fail("你浑身没力，看来要去休息休息了。\n");
  me->receive_damage("qi", 25);
  me->receive_damage("jingli", 25);

  message_vision("$N一边看着墙上的点穴图，一边练习基本指法的运用。\n", me);

  check = (int)me->query_skill(
    "finger",
    1
  ) * (int)me->query_skill("finger", 1) * (int)me->query_skill("strike", 1);
  if (check > (int)me->query("combat_exp") * 10) {
    write("你看一会，发现自己没有什么进步，看来该去弄点实战经验了。\n");
    return 1;
  }

  if ((int)me->query_skill("finger", 1) >= 101) {
    write("你已经可以熟练的记住穴位了。\n");
    return 1;
  }

  me->improve_skill("finger", me->query("int") + me->query("con"));
  return 1;
}
