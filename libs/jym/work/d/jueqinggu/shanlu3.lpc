inherit ROOM;
#include <ansi.h>
int do_pa(string arg);

void create()
{
        set("short","山路");

        set("long",@LONG
这是一条险峻崎岖的山路，山路贴着石璧凿出，怕只容一人可过，形
势极为险峻。往远处望去。群山环绕，列於脚下，百里美景尽收眼底，顿
时令人豪气陡声，想要长啸一声。再往东上是一片陡峭的崖壁，看来轻功
一般的人是很难攀爬(panpa)上去。
LONG);

        set("exits",([ 
			//"westdown" : __DIR__"entrance",
						"northdown" : __DIR__"shanlu4",
                        "southdown" : __DIR__"shanlu2",
                      ])
           );
	  set("cost",3);
	  set("outdoors", "jqg");

      setup();

 //     replace_program(ROOM);
}

void init()
{
        add_action("do_pa", "panpa");
}

int do_pa(string arg)
{
        object me;

        me=this_player();
        if (me->is_busy() || me->is_fighting())
                return notify_fail("你正忙着哪！\n");
        if ( !arg || arg != "up" )
                return notify_fail("你要往哪爬？\n");
//        if (!me->query_temp("mark/bang"))
//                return notify_fail("你想跳崖自杀么？直接跳下去吧！\n");
       if((int)me->query_skill("dodge",1) < 100 )  
			return notify_fail("崖壁过于陡峭，以你目前的轻功修为很难攀爬上去。\n"); 

        message_vision(HIG"$N颤颤噤噤地爬了上去。\n"NOR, me);
        me->move(__DIR__"dcy");
//        me->add_temp("tengacc",-1);
        tell_room(environment(me), me->name() + "从下面颤颤噤噤地爬了上来。\n", ({ me }));
//        me->delete_temp("mark/bang");
        return 1;
}