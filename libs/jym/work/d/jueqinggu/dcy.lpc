// Room: /u/dubei/u/gumu/jqg/dcy
// by dubei
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "断肠崖");
  set("long", @LONG

这里是绝情谷后山峰顶，人迹鲜至，站到崖前，俯视深谷，但见灰雾茫茫。也
许应该仔细看看(look ya)这里的山崖。

LONG
  );

  //	set("exits", ([
  //               "southdown" : __DIR__"shanlu3",
  //	]));


  set("outdoors", "jqg");
  setup();

}
void init() {
  add_action("do_look", "look");
  add_action("do_jump", "jump");
  add_action("do_pa", "panpa");
}
int do_look(string arg) {
  if (!arg || arg == "" || arg != "ya") return 0;
  write(
    "你仔细打量四周。发现在不远处有一块突出来的峭壁(qiaobi)，可以勉强容身。\n"
  );
  this_player()->set_temp("jqg_look1", 1);
  return 1;

}
int do_jump(string arg) {
  object me;
  me = this_player();
  if (arg != "qiaobi") return 0;
  if (!arg) return 0;
  if (!me->query_temp("jqg_look1"))
    return notify_fail("你要往那里跳？\n");

  if (!living(me)) return 0;
  if ((int)me->query_encumbrance() * 100 / (int)me->query_max_encumbrance() >= 50)
    return notify_fail("你身上负重太多，无法跳过去。\n");

  if ((int)me->query_skill("dodge", 1) < 100)
    return notify_fail("以你目前的轻功修为，无法跳过去。\n");
  message_vision("$N纵身向前面的峭壁跳了过去。\n", me);
  me->move(__DIR__ "duanchang");
  tell_room(environment(me), me->name() + "从断肠崖跳了过来。\n", ({ me }));
  me->delete_temp("jqg_look1");
  return 1;
}

int do_pa(string arg) {
  object me;

  me = this_player();
  if (me->is_busy() || me->is_fighting())
    return notify_fail("你正忙着哪！\n");
  if (!arg || arg != "down")
    return notify_fail("你要往哪爬？\n");

  if ((int)me->query_skill("dodge", 1) < 100) {
    message_vision(HIR "$N向崖下爬去，忽然一个失手，直摔了下去。。\n" NOR, me);
    tell_room(environment(me), "\n崖下传来一声大叫：『啊¨¨¨』\n", me);
    me->move(__DIR__ "shanlu3");
    tell_room(environment(me), me->name() + "从山崖上面重重的摔了下来。\n", ({ me }));
    me->receive_wound("qi", 300, "掉下断肠崖摔得粉身碎骨了");
  } else {
    message_vision(HIG "$N颤颤噤噤地爬了下去。\n" NOR, me);
    me->move(__DIR__ "shanlu3");

    tell_room(environment(me), me->name() + "从上面颤颤噤噤地爬了下来。\n", ({ me }));
  }
  return 1;
}
