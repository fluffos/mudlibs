// duanchang.c

#include <ansi.h>
#include <room.h>
inherit ROOM;
/*
你来到山峰腰部的一处峭壁，岩壁上不知是谁刻得有几行大字（dazi），
自此向上，数十丈光溜溜的寸草不生，终年云雾环绕，天风猛烈，便飞鸟也甚
难在峰顶停足。山崖旁边就是一道深渊（shenyuan）。悬崖边上长着一棵老松
树（song）斜斜的探出崖边。
*/

void init()
{
        add_action("do_jump","jump");   
		add_action("do_tihui","tihui");   
}

void create()
{
        set("short",YEL"峭壁"NOR);
        set("long", @LONG
你来到山峰腰部的一处峭壁，岩壁上不知是谁刻得有几行大字（dazi），
自此向上，数十丈光溜溜的寸草不生，终年云雾环绕，天风猛烈，便飞鸟也甚
难在峰顶停足。看了岩壁上所书的大字你好似体会到了扬过与小龙女当日分离
与日后重逢时的感受。
LONG);
        set("item_desc", ([
        "dazi": HIY"                             
            ※※※※※※※※※※※※※※※※※※
            ※※※※　                  ※※※※
            ※※※※    十 六 年 后，   ※※※※
            ※※※※                    ※※※※
            ※※※※    在 此 相 会，   ※※※※
            ※※※※                    ※※※※
            ※※※※    夫 妻 情 深，   ※※※※
            ※※※※                    ※※※※
            ※※※※    勿 失 信 约。　 ※※※※ 
            ※※※※　                  ※※※※
            ※※※※※※※※※※※※※※※※※※\n"NOR,
        "shenyuan":HIB"你从渊口向下望去，但见渊中云雾缭绕，黑幽幽的深不见底。\n"NOR,
        "song": HIG"一棵老松树，盘枝交错，斜探着枝桠深入云霄。\n"NOR,
        ]));

        set("outdoors", "jqg");

        setup();
}

int do_jump(string arg)
{
       object me;
       me = this_player(); 
       if (arg != "back" ) return 0;
       if (!arg ) return 0;        
       if (!living(me)) return 0;
         message_vision("$N纵身向断肠崖跳了回去。\n", me);
         me->move(__DIR__"dcy");
         tell_room(environment(me), me->name() + "从峭壁跳了过来。\n", ({ me }));
         return 1;
}

int do_tihui(string arg)
{
	object me = this_player();
	int lovingness_lvl;
	
	if ( !arg )	return notify_fail( "什么？\n");
	if ( arg != "dazi" ) return notify_fail( "你要看什么？\n");

	if ( me->is_busy() ) return notify_fail("你正忙着呢！\n");
	if( me->is_fighting() ) return notify_fail("你已经在战斗中了，学一点实战经验吧。\n");

	if ( (int)me->query_skill("literate", 1) < 1) {
		write("你连字都不认识呀，还事先学点文化(literate)吧。\n");
		return 1;
	}

//	if ( me->query("gender") !="女性" && me->query("family/family_name") != "古墓派" ) {
	if ( me->query("family/family_name") != "古墓派" ) {
		write("十 六 年 后， 在 此 相 会，夫 妻 情 深，勿 失 信 约。\n");
		return 1;
	}

	if ((int)me->query("jing") < 30 || me->query("jingli") < 30 ){
        write("你累了，还是歇息一下吧。\n");
		return 1;
	}

	me->receive_damage("jing", 20 ,"过度疲劳致死");
	me->receive_damage("jingli", 20 ,"过度疲劳致死");

	message_vision("$N对着岩壁的大字看了许久，不自觉的感叹了一声：唉，问世间情为何物，只教人生死相许……\n", me);

	lovingness_lvl = (int)me->query_skill("lovingness",1);
	if ( lovingness_lvl > 360 )
		write("你的双宿双飞已经掌握得很好了，再也无法从这里感悟爱情的力量。\n");
	else if (lovingness_lvl * lovingness_lvl * lovingness_lvl > (int)me->query("combat_exp") * 10)
		write ("你的实战经验不足，无法从这里感悟爱情的力量。\n");
	else {
		me->improve_skill("lovingness", me->query_int() + random(100));
		write("你似乎领悟了一些双宿双飞的感受。\n");
	}
	
	if ( query("count") < 20 ) add("count",1);
	else {
		me->start_busy(1);
		set("count",0);
	}
	return 1;
}