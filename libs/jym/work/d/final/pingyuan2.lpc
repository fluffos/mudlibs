void create()
{
	set("short", "平原");
	set("long", @LONG
	一块广阔的平原,大的一眼望不到边,据说
平原的另一头是天云派的根据地。
LONG
	);
	set("cost", 1);
	set("outdoors", "muder");
	set("exits", ([ 
        "east" : __DIR__"pingyuan3",
		"west" : __DIR__"pingyuan"+(random(4)+1),
        "north" : __DIR__"pingyuan"+(random(4)+1),
		"south" : __DIR__"pingyuan"+(random(4)+1),
                      ]));
	set("no_clean_up", 0);
        set("objects", ([
		__DIR__"npc/dandinghe" : 3,
		]));

	setup();
        replace_program(ROOM);
}

