// finalxkx
// final
#include <ansi.h>;
inherit ROOM;

void create()
{
		set("short", "小店睡房");
		set("long", 
"这里是东北平原一个小店的睡房,布置很简单,几张床平铺在屋角,
窗台上的"+HIC"风铃"NOR+"(fengling)铃铃铃的响着,窗户外面是一望无际的平原山
峦。看来小店的主人也别有情趣。\n"
        );

        set("item_desc",([
                "fengling" : HIC"一个精致的风铃,一阵风吹过,风铃响起来
风铃被风吹的乱响,但声音却是如此的平静,像是对人的一种思念
你隐约看见风铃上写的字(word)。\n"NOR,
				"word" : HIM"
		~~~~~~~~~~~"+HIW"
		章鹏何时归。"HIM+"


		   "+RED"爱你的"HIG+"萌"+HIM"
		~~~~~~~~~~~\n"NOR,
        ]));//备注 这里没用 只是为我喜欢的人而作的:p 

        set("sleep_room", 1);
        set("no_fight", 1);
        set("cost", 2);

         set("exits", ([
                "north" : __DIR__"xiaodian",
        ]));
        setup();
        replace_program(ROOM);
}
