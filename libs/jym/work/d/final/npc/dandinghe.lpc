#include <ansi.h>

inherit NPC;

void create() {
  set_name(HIW "丹顶鹤" NOR, ({ "danding he", "he" }));
  set("race", "飞禽");
  set("age", 1);
  set_skill("dodge", 30);
  set("long", "一只只有东北平原才有的丹顶鹤，洁白的羽毛,
漂亮极了,它正在看着你呢。\n");
  set("attitude", "peaceful");

  //      set("limbs", ({ "头部", "身体", "翅膀", "爪子", "尾巴" }) );
  //      set("verbs", ({ "bite", "claw" }) );

  set("combat_exp", 800);
  set_temp("apply/attack", 3);
  set_temp("apply/defense", 5);
  set_temp("apply/armor", 2);

  setup();
  set("chat_chance", 4);
  set("chat_msg", ({
    "丹顶鹤飞来飞去。\n",
    "丹顶鹤低头喝水。\n",
    "乌鸦在你眼前飞上飞下。\n",
  }));
}
