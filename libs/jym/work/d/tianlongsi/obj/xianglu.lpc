#include <ansi.h>

inherit ITEM;

void create() {
  set_name("香炉", ({ "xiang lu", "lu" }));
  set_weight(3000);
  set_max_encumbrance(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一个庙里常见的香炉，用来让善男信女们插香进愿。\n");
    set("value", 1000);
    set("material", "gold");
    set("no_get", 1);
    set("no_drop", 1);
    set("amount", 30);
  }
  setup();
}
