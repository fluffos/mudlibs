inherit NPC;

void create() {
  set_name("明苦", ({
    "ming ku",
    "ku",
    "shami",
  }));
  set("long",
    "他是一位未通世故的少年和尚，脸上挂着天真的稚笑。\n"
  );

  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");

  set("age", 13);
  set("shen_type", 1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("max_qi", 2000);
  set("max_jing", 1500);
  set("neili", 3000);
  set("max_neili", 3000);
  set("combat_exp", 800000);
  set("score", 1);

  set_skill("force", 200);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);


  setup();
  carry_object("/clone/armor/seng-cloth")->wear();
}
