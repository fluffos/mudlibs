inherit ROOM;

void create() {
  set("short", "鹞子翻身");
  set("long", @LONG
    此这里又是华山极险之处。其路凿于倒坎悬崖上，下视唯见寒索垂于
凌空，不见路径。游人至此，须面壁挽索，以脚尖探寻石窝，交替而下。
其中几步须如鹰鹞一般、左右翻转身体才可通过。
LONG
  );

  set("exits", ([
    "northwest": __DIR__ "chaoyang",
    "southeast": __DIR__ "gufeng",
  ]));


  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
