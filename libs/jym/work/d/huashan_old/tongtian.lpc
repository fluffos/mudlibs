inherit ROOM;

void create() {
  set("short", "通天门");
  set("long", @LONG
    走过几百级石阶，忽然眼前出现一个花岗岩的石门。此处视野辽阔，
松绿竹翠，杜鹃含笑竞芳，周围风景如画。仰脸西望，群峰竞秀。回头
望向来路，烟云缭绕的半空中云台峰若隐若现，恍惚之间你觉得有些不
知身在何处。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "northdown": __DIR__ "canglong",
    "south": __DIR__ "nantian",
  ]));

  set("objects", ([
    __DIR__ "npc/s-houzi": 1,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
