inherit ROOM;

void create() {
  set("short", "西岳庙");
  set("long", @LONG
    西岳庙是供奉西岳大帝华山神的庙宇，在华山以北约十里。此庙坐北
朝南，庙门正对华山。庙中正是西岳华山神白帝少昊之塑像，只见他身服
白素之袍，头戴太初九旒之冠，佩开天通真之印，端的是英俊潇洒。庙中
有五凤楼，登楼望华山，五峰历历在目。
LONG
  );

  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "wuliguan",
  ]));

  set("objects", ([
    //
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
}
