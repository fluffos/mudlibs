inherit ROOM;

void create() {
  set("short", "青柯坪");
  set("long", @LONG
    走过崎岖的十八盘，穿过云门，就到了青柯坪。此处乃是一个山间的
小盆地，地势略为平坦开阔，素有“四望群峰绕，千盘一路通”之称。庙
宇建筑萃集，有东、西道院通仙观，以及梅花、雪花等岩壁石洞。从青柯
坪向东便到“回心石”。 
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "northdown": __DIR__ "shaluo",
    "eastup": __DIR__ "huixin",
    "southwest": __DIR__ "tongxian",
  ]));

  set("objects", ([
    __DIR__ "npc/haoke": 1,
    __DIR__ "npc/youke": 1,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
