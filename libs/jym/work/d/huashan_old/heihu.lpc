inherit ROOM;

void create() {
  set("short", "黑虎岭");
  set("long", @LONG
    山路旁一棵高大的松树，传说东汉一个和尚在这棵松树上看到一只威
风凛凛的黑色老虎，此处因此得名。山中峡谷嶙峋丘壑纵横，松柏繁茂，
溪水潺湍。攀登山颠极目远眺，只见灞水如黛东骊苍翠，给人以步入仙
境之感。
LONG
  );
  set("exits", ([
    "southup": __DIR__ "laojun",
    "west": __DIR__ "fuwei",
  ]));


  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 2);
  setup();
}
