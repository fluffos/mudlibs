inherit ROOM;

void create()
{
        set("short", "沉香劈山");
	set("long", @LONG
    这里便是传说中沉香劈山救母的地方。旁有巨石高一丈余，长数丈，
拦腰裂为三段，如同斧劈。石下与峰头形成空洞，仅可容一人伏身爬入。
进洞仰卧上观，可见顶端凹凸不平，正是一妇人躺卧后留下的痕迹，腹乳
压痕清晰可辨。石旁有一铁制巨斧(fu)。
LONG
        );

        set("exits", ([ 

		"east" : __DIR__"lianhua",
	]));

	set("objects", ([
        ]));

        set("no_clean_up", 0);
        set("outdoors", "huashan" );

	set("cost", 2);
        setup();
        replace_program(ROOM);
}
 
