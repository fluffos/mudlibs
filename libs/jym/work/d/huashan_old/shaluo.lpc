inherit ROOM;

void create() {
  set("short", "莎萝坪");
  set("long", @LONG
    踏过累累石涧，由山径蜿蜒而上，就来到了莎萝坪。南面一条迂回盘
旋的山道，称作「十八盘」，通往山上。这里看上去平缓无奇，却时时让
人感到有压抑的感觉，抬头四望，已看不到什么，原来已经置身于华山之
中了。
LONG
  );

  set("exits", ([ /* sizeof() == 2 */
    "northwest": __DIR__ "shimen",
    "southup": __DIR__ "qingke",
  ]));

  set("objects", ([
    CLASS_D("huashan") + "/buyou": 1,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
