inherit ROOM;

void create()
{
        set("short", "迎阳门");
	set("long", @LONG
    这里是朝阳峰脚下，乃是观日出必经之处，故称“迎阳”。一旁依山
势建有小楼阁，三面临空，极尽别致。楼上北可观二仙龛洞桥奇景，南可
览三公山、三凤山之秀。洞前地势平坦开阔，是连接东、南、西三峰的交
汇空间，颇具川道特色，游人多喜在这里悠闲散步，以松驰峰巅控险的紧
张情绪。
LONG
        );

        set("exits", ([ /* sizeof() == 2 */
  		"west" : __DIR__"nantian",
  		"eastup" : __DIR__"chaoyang",
		"southwest" :__DIR__"ziqi",
	]));

	set("objects", ([
		__DIR__"npc/youke" : 2,
        ]));

        set("no_clean_up", 0);
        set("outdoors", "huashan" );

	set("cost", 2);
        setup();
        replace_program(ROOM);
}
 
