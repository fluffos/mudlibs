void create() {
  set("short", "仙人桥");
  set("long", @LONG
    惊心动魄的过了百尺峡，现在终于可以喘一口气。这里山势平坦得多，
乃是一座宽宽的大石桥，几乎可容纳数十人。因吕洞宾在此点化何仙姑成
仙而得名。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "fuwei",
    "south": __DIR__ "juxian",
    "westdown": __DIR__ "baichi",

  ]));

  set("objects", ([
    __DIR__ "npc/youke": 2,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
