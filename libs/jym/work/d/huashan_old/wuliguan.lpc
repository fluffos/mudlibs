inherit ROOM;

void create() {
  set("short", "五里关");
  set("long", @LONG
    继续往前走，路途尚且平坦，这里是华山第一道关口，距离山脚大约
五里，因此得名。仰头向山上望去，只见云雾缭绕，似乎还有很长的路要
走。周围有文人墨客的题字匾额，年深日久，很多已经不甚清楚。
LONG
  );

  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "path1",
    "south": __DIR__ "maonv",
    "east": __DIR__ "shanhong",
    "north": __DIR__ "xiyuemiao",
  ]));

  set("objects", ([
    //
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
