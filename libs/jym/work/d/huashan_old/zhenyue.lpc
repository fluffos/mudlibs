#include <ansi.h>;
inherit ROOM;

void create()
{
        set("short", "镇岳宫");
	set("long", @LONG
    镇岳宫依西峰东麓而筑，随崖就势，构筑独特。宫前地势平坦，四周
奇峰耸天，苍松挺翠，繁花布锦，瑶草结环，是一处环境幽美的所在。院
内正中有一玉井(jing)，旁边有用来绞水的井架，看上去还是很结实。墙
角有一个破烂古旧的石碑(shibei)。
LONG
        );
        set("exits", ([ /* sizeof() == 3 */
  		"southeast" : __DIR__"lianhua",
  		"northwest" : __DIR__"juling",
	]));
  set("item_desc",([
                "jing" : "向下望去，黑洞洞的什么也看不清。\n"NOR,
				"shibei" : HIC"
		~~~~~~~~~~~"+HIW"
		章鹏何时归。"HIM+"


		   "+RED"爱你的"HIG+"萌"+HIM"
		~~~~~~~~~~~\n"NOR,
        ]));
	set("objects", ([
		__DIR__"npc/youke" : 2
    	]));

        set("no_clean_up", 0);
        set("outdoors", "xx" );

	set("cost", 1);
        setup();

}
void init()
{
	add_action("do_jump", "jump");
	add_action("do_bang", "bang");
	add_action("do_climb", "climb");
}
int do_jump(string arg)
{
	object me = this_player();

	if (!arg || arg != "jing" ) return 0;

        if(me->is_busy())
                {
                tell_object(me,"你现在正忙着呢！\n");
                return 0;
		} {    
		message_vision("$N纵身往井中跳下！", me);
		me->move(__DIR__"jing");
		message("vision", me->name() + "纵身从井上跳了过来。\n", 		environment(me), ({me}) );
		message_vision("你从井上跳下来，脑袋朝下狠狠摔在地上!\n", me);
		me->set_temp("last_damage_from", "跳井自杀了。");
		me->die();
		message("vision", "\n", environment(me));
	}
	return 1;
}
int do_bang(string arg)
{
	object me = this_player();

	if ( !arg || arg == "" ) return 0;

	if ( arg == "jia" ) {
		if ( !present("sheng zi", me) )
			write("什么？\n");
		else {
			message_vision("$N将绳子仔细地绑在架子上。\n", me);
			me->set_temp("bangd", 1);
		}

		return 1;
	}

	return 0;
}
int do_climb(string arg)
{
	object me = this_player();

	if ( arg && arg != "down" )
		return notify_fail("什么？\n");

	if(me->query_encumbrance() * 10 / me->query_max_encumbrance() > 10/100)
		return notify_fail("你负重太多，身子腾挪不开。\n");

	if ( !me->query_temp("bangd") )
		return notify_fail("没有东西支撑你怎么爬呀？\n");
	else
	{
	message_vision("$N拉着绳子开始往井里爬。\n", me);
	message("vision", me->name()+"一会儿便消失在井里了。\n", environment(me), ({me}) );
	tell_object(me, "你顺着绳子向井里爬下去！\n");
	me->move(__DIR__"jing");
	message("vision", me->name()+"由井上爬了下来。\n", environment(me), ({me}) );
	me->delete_temp("bangd");
	}

	return 1;
}
