inherit ROOM;

void create() {
  set("short", "孤峰");
  set("long", @LONG
    此处便是有名的下棋亭所在，宋太祖曾在此与陈抟老祖赌棋，输掉
了华山。这里天宇如洗，山空谷静，万籁俱寂，只有清风徐徐吹来，山
峦隐隐如黛。端的是怡情养性的绝妙所在。
LONG
  );

  set("exits", ([
    "northwest": __DIR__ "fanshen",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
