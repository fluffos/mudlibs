inherit ROOM;

void create()
{
        set("short", "老君洞");
	set("long", @LONG
    古称老子骑牛过函谷关，曾在华山炼制金丹，故华山各处都有老君遗
留的痕迹，这里路东崖壁有一小石洞，大小仅可容一人蹲坐，洞内原供奉
老君琉璃彩像一尊。游人到此多要拜上一拜。
LONG
        );

        set("exits", ([
  		"northeast" : __DIR__"bizhao",
		"west"	:__DIR__"luoyan",
	]));

        set("no_clean_up", 0);
        set("outdoors", "huashan" );

	set("cost", 2);
        setup();
        replace_program(ROOM);
}
 
