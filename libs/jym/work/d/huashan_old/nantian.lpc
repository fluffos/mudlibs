inherit ROOM;

void create() {
  set("short", "南天门");
  set("long", @LONG
    峰岩险峻陡峭，如刀劈斧剁一般。在山巅石子中有一大丫口，左边直
立着一块巨石，右边是山脊。那丫口上面，又横着一块扁石，如同门楣一
样。《说铃》记述：“南峰下有峡曰天门，西出当南峰之背。”
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "northdown": __DIR__ "tongtian",
    "east": __DIR__ "yingyang",
    "west": __DIR__ "wushang",
  ]));

  set("objects", ([
    __DIR__ "npc/s-houzi": 1,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
