inherit ROOM;

void create() {
  set("short", "避诏崖");
  set("long", @LONG
   这里东西两岩相对而出，中间形成槽沟。东岩前倾悬空如覆，岩壁布
满石窝状蜂巢。岩腹间凿一长方形石穴。洞口通西岩架独木桥，抽去独木
则无法进入洞中。洞额镌刻“避诏岩”三字，相传是陈抟手书。避诏崖在
宋代前本是籍籍无名，自陈抟老祖在此躲避朝廷征诏之后，方成为一景。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "laojundong",
  ]));

  set("objects", ([
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
