  set("short", "百尺峡");
  set("long", @LONG
    这里是登山第二道险关。两壁高耸，亦十分陡峭，岩壁两侧设有铁索
以作扶拦。你全身心集中脚下，不敢仰望，更不敢俯视。山缝中间夹有一
块从天而降的巨石，上刻“惊心石”三个大字，所有人必须从石下小路穿
过，确实惊心动魄。有人到这里便已吓得大哭，再也无法前进。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "northdown": __DIR__ "qianchi",
    "eastup": __DIR__ "xianrenqiao",
  ]));
  set("objects", ([
    //	__DIR__"npc/youke" : 2,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 4);
  setup();
  replace_program(ROOM);
}
