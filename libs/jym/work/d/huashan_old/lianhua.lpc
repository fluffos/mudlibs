inherit ROOM;

void create() {
  set("short", "莲花峰");
  set("long", @LONG
    这里便是华山西峰，峰巅有巨石形状好似花瓣，古代文人多称其为莲
花瓣、芙蓉峰。你在这里极目远眺，只见四周群山起伏，云霞四披，周野
屏开，黄渭曲流，置身其中若入仙乡神府，万种俗念一扫而空。南崖有山
脊长约百丈，石色苍黛，好似一条屈缩的巨龙，人称屈岭，或小苍龙岭。
旁边的石壁上刻有诗句(poem)，下面却没有署名。
LONG
  );

  set("exits", ([
    "northwest": __DIR__ "zhenyue",
    "east": __DIR__ "jintian",
    "west": __DIR__ "chenxiang",
    "south": __DIR__ "cuiyun",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
}
