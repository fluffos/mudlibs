// zhenyue.c
// final@hl 再自己单机mud更新
// 目的是为了个人用，禁止用来架站
// 如果有问题请mail kies9999@sina.com
// 或者http://finalmud.126.com
#include <ansi.h>;
inherit ROOM;
int do_use(string);
void create()
{
        set("short", "井底");
	set("long", @LONG
   井底黑乎乎的，什么也看不清。
LONG
        );
        set("exits", ([ "up" : __DIR__"zhenyue",
	]));


	set("cost", 1);
        setup();
}
void init()
{
        add_action("do_use", "use");
}


int do_use(string arg)
{
        object me;
        me = this_player();

        if( !arg || arg=="" ) return 0;
        if (!present("fire", me))  return 0;
        if( arg=="fire" ) {
             write(
             "你点燃了火折，发现右面有一条道，不知道通往哪里。\n"
             );	
             this_player()->set_temp("marks/finalxuelian", 1);
			 set("exits/right", __DIR__"mud");
             return 1;
       }

}
