inherit ROOM;

void create() {
  set("short", "长空栈道");
  set("long", @LONG
    长空栈道是华山险中之险。栈道依危崖凿出，宽仅二尺许。崖隙间横
贯铁棍，形如凌空悬梯，游人须挽索逐级而下，称之“鸡下架”。向西为
下段，在峭壁上凿出石孔，楔进石桩，石桩之间架木椽三根，游人需脚踏
木椽横向移动。李攀龙《太华山记》中记述：“栈虽有铜柱铁索拦护，然
阔不盈尺。”
LONG
  );

  set("exits", ([
    "northeast": __DIR__ "ziqi",
    "southwest": __DIR__ "luoyan",
  ]));


  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
}
