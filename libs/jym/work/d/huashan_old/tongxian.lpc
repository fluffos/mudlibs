inherit ROOM;

void create()
{
        set("short", "通仙观");
	set("long", @LONG
    华山乃道教昌盛的地方，这里便是一个小小的道观，也无甚特别之处。
很多游客都在此借住。观中安静清爽，次日登山也不会错过观日出，不失
为一个理想的下榻之所。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  		"northeast" : __DIR__"qingke",
	]));

        set("objects", ([
		__DIR__"npc/youke" : 3,
        ]));

        set("no_clean_up", 0);
        set("outdoors", "xx" );

	set("cost", 5);
        setup();
}
 
int valid_leave(object me, string dir)
{
        if (dir == "southup") {
		me->add("jing", -30);
		me->add("jingli", -30);
	}
	return 1;
}	
