inherit ROOM;

void create() {
  set("short", "擦耳崖");
  set("long", @LONG
    这里一边是悬崖绝壁，一边是万丈深渊。人行到此，身体紧贴崖面，
唯恐下坠，往往使崖壁擦耳。有诗曰：逋客时时属耳垣，倚天翠壁亦可
言。欲知悬径欹危甚，看我青苔一面痕。擦耳崖题刻甚多，有“道法自
然”、“涧壑烟霞”、“千里烟云”、“灵峰耸翠”等。过擦耳崖，前
有一巨石，上题“卧牛石”三字，传说老君的青牛开通犁沟之后曾卧此
休息。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "southwest": __DIR__ "husun",
    "eastup": __DIR__ "yuntai",
  ]));

  set("objects", ([
    //	"/d/village/npc/poorman" : 1,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
