inherit ROOM;

void create() {
  set("short", "落雁峰");
  set("long", @LONG
    这是华山最高主峰，也是五岳最高峰，古人尊称“华山之首”。登上
南峰绝顶，顿感天近咫尺，星斗可摘。举目环视，但见群山起伏，苍苍莽
莽，黄河渭水如丝如缕，漠漠平原如帛如绵，尽收眼底。宋代名相寇准到
此，写下“只有天在上，更无山与齐。举头红日近，俯首白云低”。峰顶
另有一块巨石，上面似乎也刻有诗句(poem)。
LONG
  );

  set("exits", ([
    "northeast": __DIR__ "changkong",
    "east": __DIR__ "laojundong",
    "south": __DIR__ "yangtian",
    "west": __DIR__ "jintian",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
}
