inherit ROOM;

void create() {
  set("short", "回心石");
  set("long", @LONG
    继续向东，忽见路旁一块巨石，上书“回心石”三个大字，此时便是一
块界碑，将华山之路一分为二，提醒游客们头上面临的将是万丈陡崖，没胆
量的人，该回心转意了。呼呼的山风毫无遮拦地吹着汗涔涔的身子，叫人不
敢稍作停留，只好拖着酸疼的双腿继续攀登。　
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "westdown": __DIR__ "qingke",
    "southup": __DIR__ "qianchi",
  ]));

  set("objects", ([
    //
  ]));

  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 5);
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "southup") {
    me->add("jing", -30);
    me->add("jingli", -30);
  }
  return 1;
}
