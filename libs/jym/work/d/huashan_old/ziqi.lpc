inherit ROOM;

void create() {
  set("short", "紫气台");
  set("long", @LONG
    江得符的《华山记》中记述：菖蒲池西南二仙龛，龛北紫气台。这是
一个宽阔的平台，四围古松高大茂密，环境清静幽雅，从这里看出去，脚
下云雾翻滚，颇为壮观。
LONG
  );

  set("exits", ([
    "northeast": __DIR__ "yingyang",
    "southwest": __DIR__ "changkong",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
