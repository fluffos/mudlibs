inherit ROOM;

void create()
{
        set("short", "巨灵足");
	set("long", @LONG
    莲花峰靠西处，有一石窝，像似足迹，长三尺，深两寸，刻有“巨灵
足”三字。传说是巨灵神留下的足迹，但与东峰巨灵掌对比之下，实在是
小得可怜了。古人评说：“窃谓力能劈山，其足迹仅如此之微，不能载其
形乎。且东峰掌形，自峰端达峰，假使所传果然，则如彼之大手，而配于
如此之小足，有是理耶。”
LONG
        );

        set("exits", ([ 
		"west" : __DIR__"west",
		"southeast" : __DIR__"zhenyue",
		"northwest" :__DIR__"sheshen",
	]));

        set("no_clean_up", 0);
        set("outdoors", "huashan" );

	set("cost", 2);
        setup();
        replace_program(ROOM);
}
 
