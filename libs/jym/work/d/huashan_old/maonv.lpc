inherit ROOM;

void create() {
  set("short", "毛女洞");
  set("long", @LONG
    一路蜿蜒行来，只见路旁有一暗洞。民间相传，秦始皇的宫女玉姜为
逃避殉葬，来此隐居，天长日久，身长白毛，后人称此洞为毛女洞。向那
洞中望去，似乎黑沉沉地也看不到什么。
LONG
  );

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "wuliguan",
    "southup": __DIR__ "shimen",
  ]));

  set("objects", ([
    //
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
