void create() {
  set("short", "云台峰");
  set("long", @LONG
    云台峰之高虽不及其他几峰，但山势峥嵘，三面悬绝，只有一岭南通，
传说贺志真曾带领两个徒弟在此打洞修行。每每洞成后都让给他人。二徒
认为师父无真才实学，故砍断了系于师父腰间的绳子，仓皇逃下山去。当
二徒行至千尺幢时，却又与迎面而来的师父碰个满怀，二徒急忙跪倒下拜，
自此诚心上山修行。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "westdown": __DIR__ "chaeryan",
    "east": __DIR__ "zhenwu",
  ]));

  set("objects", ([
    //	"/d/village/npc/poorman" : 1,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 2);
  setup();
