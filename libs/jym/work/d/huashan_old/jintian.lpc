inherit ROOM;

void create() {
  set("short", "金天宫");
  set("long", @LONG
    金天宫又称白帝祠，是华山主峰上祭祀华山神的主庙。始建于魏太武
年间。其大殿全为大片铁瓦，内塑神像，院前大门边还建有钟鼓楼。这里
大片松林，枝高叶茂。清代诗人王友旦到此后随做诗：“探幽凌绝境，谒
帝陟层巅。赤日岩中出，清流树梢悬。文窗陈俎豆，绣供错烽烟”。很多
虔诚的香客们在院中烧香磕头，许愿还愿。
LONG
  );

  set("exits", ([
    "east": __DIR__ "luoyan",
    "west": __DIR__ "lianhua",
  ]));

  set("objects", ([ "/d/huashan/npc/xiangke": 1,
    "d/huashan/npc/daoshi": 1,
    "d/huashan/obj/qiantong": 1,
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
}
