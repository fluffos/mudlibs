inherit ROOM;

void create() {
  set("short", "石门");
  set("long", @LONG
    向上已经来到石门，这里向北隐约可望见渭河、泾水和黄河。向南便
是莎萝坪。陡峭的山势逐渐显露锋芒，开始没有了平路可走。山回路转，青
石台阶鳞次栉比，尽管凉风阵阵，颇有寒意，但你还是一身身的出汗。
LONG
  );

  set("exits", ([ /* sizeof() == 2 */
    "northdown": __DIR__ "maonv",
    "southeast": __DIR__ "shaluo",
  ]));

  set("objects", ([
    //
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
  replace_program(ROOM);
}
