inherit ROOM;

void create() {
  set("short", "翠云宫");
  set("long", @LONG
    翠云宫依崖就势而筑。外廊明柱，雕梁画栋，镂花门窗，看起来秀丽
典雅。其中内供奉的是众星之母斗姥神位，只见她慈眉善目，头戴星环，
左揽金乌，右拥玉兔，又感觉极为神秘。
LONG
  );

  set("exits", ([
    "north": __DIR__ "lianhua",
    "southup": __DIR__ "fengding",
  ]));

  set("objects", ([
  ]));

  set("no_clean_up", 0);
  set("outdoors", "huashan");

  set("cost", 2);
  setup();
}
