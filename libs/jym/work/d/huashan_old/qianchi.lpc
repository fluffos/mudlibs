inherit ROOM;

void create() {
  set("short", "千尺幢");
  set("long", @LONG
   千尺幢有石梯三百余阶，盘旋于悬崖峭壁之上，游人需手握铁索，手
足并用，沿陡峭的山路攀登，千尺悬崖令人望而生畏。其间，崖壁陡峭，
头顶只见一线天光，惊险绝伦。出口名曰“天井”，为“太华咽喉”。
若用铁板盖上，则上下无路可走。 　　
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "northdown": __DIR__ "huixin",
    "southup": __DIR__ "baichi",
  ]));

  set("objects", ([
    __DIR__ "npc/haoke": 1
  ]));

  set("no_clean_up", 0);
  set("outdoors", "xx");

  set("cost", 5);
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "southup") {
    me->add("jing", -30);
    me->add("jingli", -30);
  }
  return 1;
}
