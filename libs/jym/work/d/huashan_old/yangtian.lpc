inherit ROOM;

void create()
{
        set("short", "仰天池");
	set("long", @LONG
    站在池畔，仰望青天若在咫尺，你不禁慨叹造物之鬼斧神工。池为岩
石上一天然石凹，呈不规则形，深约三尺，池水宽四尺，水色清澈，略呈
绿色。此池水涝不盈溢，旱不耗竭，为华山之谜。又因池距太上老君洞相
近，传说太上老君常汲此水炼制金丹，故又称池为太乙池、太上泉。
LONG
        );

        set("exits", ([

		"north"	:__DIR__"luoyan",
	]));

        set("no_clean_up", 0);
        set("outdoors", "huashan" );

	set("cost", 2);
        setup();
        replace_program(ROOM);
}
