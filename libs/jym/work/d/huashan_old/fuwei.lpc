inherit ROOM;

void create()
{
        set("short", "俯渭崖");
	set("long", @LONG
    这是一个小小的峰头。峰顶部约十丈见方，站立岩上，向北远眺，黄
河、渭水如丝如缕，远接天际。前后不时有一些轻功高强的江湖人士不假
思索地一掠而过，引得游客们阵阵惊叹。
LONG
        );
        set("exits", ([ 
			"east" : __DIR__"heihu",
  		"west" : __DIR__"xianrenqiao",
		"north" : __DIR__"qunxian",
	]));

        set("no_clean_up", 0);
        set("outdoors", "xx" );

	set("cost", 2);
        setup();
        replace_program(ROOM);
}
 
