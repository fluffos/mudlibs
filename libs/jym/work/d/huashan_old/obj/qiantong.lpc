#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("签筒", ({"qian tong", "tong"}));
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long",
			"一个求签用的的签筒。\n");
				 set("no_get", "这样东西不能离开那儿。\n");
                set("material", "steel");
		set("value", 100);
        }
}
