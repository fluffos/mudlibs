inherit ROOM;

void create()
{
        set("short", "华岳仙掌");
	set("long", @LONG
    这是一个天然造化的一面手掌形石纹，高约三丈，五指分明。此为关
中八景第一景。每逢晴朗的早晨，掌印如镀赤金，巍然矗立，观者无不叹
为观止。传说上古时候，首阳山同华山连年干旱，河神巨灵悲悯人间疾苦
就手推华山，脚踏首阳山，使地轴折断，山脊裂绝，一山移而为两，河水
从两山之间奔驰东去。从此留下巨灵神推山的手印。
LONG
        );

        set("exits", ([ 
  		"west" : __DIR__"chaoyang",
	]));

	set("objects", ([
		__DIR__"npc/youke" : 2,
		"/d/village/npc/poorman" :2,
        ]));

        set("no_clean_up", 0);
        set("outdoors", "huashan" );

	set("cost", 2);
        setup();
        replace_program(ROOM);
}
 
