//记录所有任务系统数据

#include <ansi.h>

inherit F_SAVE;
inherit ITEM;

int START_JOB_SYSTEM;

int query_job_start()
{
	restore();
	return START_JOB_SYSTEM;
}
void set_job_start()
{
	restore();
	START_JOB_SYSTEM=1;
	save();
}
void set_close_start()
{
	restore();
	START_JOB_SYSTEM=0;
	save();
}

void create()
{
//	 set_name("任务产生器",  ({"job_produce"}));
	seteuid(getuid());
}

string query_save_file()
{
        return "/data/job_system/job_challenge"; 
}
