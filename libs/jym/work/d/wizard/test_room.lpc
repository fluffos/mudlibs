// welcome.c
// modified by lisser, 10/4/2001

#include <room.h>
#include <ansi.h>
inherit ROOM;

int do_nohelp(object me);

void create() {
  set("short", HIC "天堂" NOR);
  set("long", "欢迎来到【金庸梦】，如果你是一个对金庸梦很熟的人请键入" HIR "down" NOR "，到
【金庸梦】的世界去闯荡冒险吧！如果你是新手，请使用" HIY "help" NOR "指令熟悉这里的
新环境。在里面还有很多的基本知识让你学习，快去(enter)学习吧。

        输入" HIY " help newbie " NOR "指令，立刻回答你满脑子的疑问！
			
");

  set("exits", ([ /* sizeof() == 2 */
    //		"enter" : __DIR__"welcome2",
    "down": "/d/city/kedian",
    //		"xkd" : "/d/xiakedao/shatan",
  ]));
  set("objects", ([
    __DIR__ "npc/shizhe": 1,
  ]));

  //	set("valid_startroom", "1");
  set("no_fight", 1);
  set("no_steal", "1");
  set("no_sleep_room", "1");

  setup();
}

void init() {
  add_action("do_nohelp", "nohelp");
}

int do_nohelp(object me) {
  me = this_player();
  if (me->query("newbie") != "yes")
    return notify_fail("什么？\n");

  CHANNEL_D->do_channel(
    me,
    "rumor",
    sprintf("听说来了一个叫" + me->name(1) + "的人，他谢绝了金庸先生的帮助要只身独闯江湖了！\n", me->name(1))
  );
  me->delete("newbie", "yes");
  return notify_fail("金庸把伸出的手缩了回去接着说道：好吧！那我也不勉强你了，还请一路多保重！\n");
}
int valid_leave(object me, string dir) {
  object *inv;

  int i;
  inv = all_inventory(me);


  if (me->query("newbie") != "yes") {
    me->set("startroom", "/d/city/kedian");
    return 1;
  }
  if (dir == "down" || dir == "enter") {
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->is_character())
        return notify_fail("你不能带着其他玩家离开这里。\n");
    }

    return notify_fail("金庸伸手一拦说道：你真的不需要我的帮助吗？" + HBRED + HIW "如果真的不需要帮助请输入：nohelp\n" NOR);
  }
  return ::valid_leave(me, dir);
}
