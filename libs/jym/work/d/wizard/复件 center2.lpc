#include <ansi.h>
inherit F_SAVE;
inherit ROOM;

#define JOB_DIR "/clone/obj/challenge/"
int do_challenge(string arg);
int ask_exp(string arg);
int query_job_start();
int START_JOB_SYSTEM;

nosave mapping family_master_place = ([
  "武当派": "/d/wudang/xiaoyuan",
  "星宿派": "/d/xingxiu/riyuedong",
  "华山派": "/d/huashan/buwei1",
  "桃花岛": "/d/taihu/shufang",
  "丐帮": "/d/gaibang/gbxiaowu",
  "峨嵋派": "/d/emei/hz_back",
  "白驼山庄": "/d/baituo/lingshege",
  "全真教": "/d/zhongnan/dadian",
  "密宗": "/d/xueshan/angqian2",
  "大理段氏": "/d/dali/wangfu8",
  "少林派": "/d/shaolin/fzlou2",
  "灵鹫宫": "/d/lingjiu/men3",
  "古墓派": "/d/gumu/houtang",
]);

void create() {
  set("short", "挑战控制室");
  set("long", @LONG
这里是侠客行门派挑战控制室。门派挑战控制室从这里开启。
LONG);

  set("exits", ([
    "east": __DIR__ "wizard_room" ]));

  set("valid_startroom", 1);
  set("no_fight", "1");
  set("no_refresh", 1);
  set("cost", 0);

  setup();

  //remove_call_out("do_start");
  //		call_out("do_start", 5);
  seteuid(getuid());


  //      replace_program(ROOM);
}
void init() {
  object me = this_player();
  //	seteuid(getuid()); 

  if (wizhood(me) == "(player)")
    me->move("/d/death/death.lpc");

  add_action("do_start_system", "job_start");
  add_action("do_close_system", "job_stop");
  add_action("do_challenge", "challenge");
  add_action("do_stops", "job_stops");



}

int do_run() {
  //if (query("job_start"))
  //	if(job_data->query_job_start())
  //	{
  //message("channel:chat", HIR"$N阴笑道：天亮了，今晚收获可真不小。哈哈，老子先撤了！\n"NOR,users() );
  do_challenge(0);
  remove_call_out("do_run");
  call_out("do_run", 500);
  //	}

  return 1;
}

int do_start_system() {
  object job_data, job_system;
  if (!wizardp(this_player()))
    return notify_fail("你还没有获得神仙的法力，无法开启主动性任务系统。\n");


  if (!job_data = find_object(JOB_DIR + "challenge_data.lpc"))
    job_data = new(JOB_DIR + "challenge_data.lpc");
  if (!objectp(job_data)) return notify_fail("数据库程序编译出错。\n");
  job_data->restore();

  if (!find_object(JOB_DIR + "challenge_system"))
    if (!load_object(JOB_DIR + "challenge_system"))
      return notify_fail("challenge_system编译出错。\n");

  if (job_data->query_job_start())
    return notify_fail("任务系统已经开启。\n");

  job_data->set_job_start();

  return notify_fail("开启任务系统。\n");

  return 1;
}

int do_close_system() {
  object job_data, job_system;
  if (!wizardp(this_player()))
    return notify_fail("你还没有获得神仙的法力，无法关闭主动性任务系统。\n");


  if (!job_data = find_object(JOB_DIR + "challenge_data.lpc"))
    job_data = new(JOB_DIR + "challenge_data.lpc");
  if (!objectp(job_data)) return notify_fail("数据库程序编译出错。\n");
  job_data->restore();

  if (!find_object(JOB_DIR + "challenge_system"))
    if (!load_object(JOB_DIR + "challenge_system"))
      return notify_fail("challenge_system编译出错。\n");

  if (!job_data->query_job_start())
    return notify_fail("任务系统已经关闭。\n");

  job_data->set_close_start();
  remove_call_out("do_run");
  return notify_fail("关闭任务系统。\n");
}

int do_start() {
  if (query_job_start()) return notify_fail("任务正在运行。\n");
  restore();
  START_JOB_SYSTEM = 1;
  save();
  remove_call_out("do_run");
  call_out("do_run", 5);
  return notify_fail("任务开始。\n");
}

int do_stop() {
  if (!query_job_start()) return notify_fail("任务没有运行。\n");
  restore();
  START_JOB_SYSTEM = 0;
  save();
  remove_call_out("do_run");
  return notify_fail("任务停止。\n");
}

int do_stops() {
  object *ob_list, ob;
  int i;
  ob_list = children("/task/challenge/challenger.lpc");
  for (i = 0; i < sizeof(ob_list); i++)
    if (environment(ob_list[i])) {
      message("channel:chat", ob_list[i]->query("name") + "阴笑道：哈哈，老子先撤了！\n" NOR, users());
      ob = ob_list[i];
      ob->remove_call_out("self_destruct");
      ob->call_out("self_destruct", 5);
      //		destruct(ob);
    }
  delete("job_start");
  remove_call_out("do_run");
  return notify_fail("任务中止。\n");
}

int do_challenge(string arg) {
  string *menpai_list = ({
    "huashan", "shaolin", "wudang", "emei", "gaibang", "lingjiu",
    "baituo", "xueshan", "xingxiu", "taohua", "gumu" });

  string *sex_list = ({ "男性", "女性" });

  object ob, room;
  string ob_menpai, tz_menpai, tz_room, sex, chenhu;
  string name, nun_name;
  int exp, i = 0;

  //if (!stringp(arg)) 
  if (!arg || arg == "")
    tz_menpai = menpai_list[random(sizeof(menpai_list))];
  else tz_menpai = arg;

  sex = sex_list[random(sizeof(sex_list))];

  exp = ask_exp(CHINESE_D->chinese_menpai(tz_menpai));
  if (exp < 150000) exp = 150000;
  if (exp > 150000 && exp < 300000) exp = 300000;
  if (exp > 300000 && exp < 600000) exp = 600000;
  if (exp > 600000 && exp < 1200000) exp = 1200000;
  if (exp > 1200000 && exp < 2400000) exp = 2400000;
  if (exp > 2400000 && exp < 4800000) exp = 4800000;
  if (exp > 4800000) exp = 6000000;
  //if (exp <10000) return 0;
  //		tz_room = load_object(family_master_place[family]);
  //		tz_room = "/d/city/guangchang";
  //        if(objectp(room=load_object(tz_room)) && 
  if (objectp(ob = new("/task/challenge/challenger.lpc"))) {
    ob->set("gender", sex);
    ob_menpai = NPC_D->set_npc(ob, 0, exp, 90);
    while (ob_menpai == tz_menpai) {
      i++;
      tz_menpai = menpai_list[random(sizeof(menpai_list))];
      if (i > 10) break;
    }
    if (ob_menpai == "shaolin" || ob_menpai == "xueshan" && sex == "女性") {
      ob->set("gender", "男性");
      NPC_D->generate_cn_name(ob);
    }
    if (ob_menpai == "emei" || ob_menpai == "gumu" || ob_menpai == "lingjiu" && sex == "男性") {
      ob->set("gender", "女性");
      NPC_D->generate_cn_name(ob);
    }

    NPC_D->ob_menpai_newname(ob, ob_menpai);
    //
    ob_menpai = CHINESE_D->chinese_menpai(ob_menpai);
    tz_menpai = CHINESE_D->chinese_menpai(tz_menpai);
    ob->set("nickname", HIR "打遍" + tz_menpai + "无敌手" NOR);
    ob->set("tz_menpai", tz_menpai);
    room = load_object(family_master_place[tz_menpai]);
    ob->move(room);


    message("vision", ob->name(1) + "快步走了过来.\n", environment(ob), ob);
    message("channel:chat", HIW "【挑战】" + ob_menpai + ob->name(1) + "，号称打遍" + tz_menpai
      + "无敌手！今日坐镇" + tz_menpai + "『" + room->query("short") + "』挑战" + tz_menpai + "各位高手！\n\n" NOR, users());
    //		    message("channel:chat",HIC"【闲聊】"+ob->name(1)+"("+ob->query("id")+")："
    //				+tz_menpai+"有高手吗？哈，哈，哈！不怕死的来啊！！\n\n"NOR,users());
  }

  return 1;
}

int ask_exp(string arg) {
  object where, ob, obj, *ob_list;
  string msg, name;
  int i, exp = 0;

  if (!arg) return 0;

  ob_list = users();

  for (i = 0; i < sizeof(ob_list); i++) {
    where = environment(ob_list[i]);
    if (ob_list[i]->query("combat_exp") > exp
      //		&& !wizardp(ob_list[i])
      && where
      && strsrch(file_name(where), "/d/") >= 0) {
      if ((string)ob_list[i]->query("family/family_name") == arg) {
        obj = ob_list[i];
        exp = obj->query("combat_exp");
      }

    }
  }

  if (!obj) return 0;

  return exp;
}

string query_save_file() {
  return __DIR__ + "job_challenge";
}

int query_job_start() {
  restore();
  return START_JOB_SYSTEM;
}
