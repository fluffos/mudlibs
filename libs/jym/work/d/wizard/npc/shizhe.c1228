		me->set("dali/employee",1);
		me->set("dali/trust",300);
		me->set("shen",10000);

		me->set_temp("title", me->query("title"));
		me->create_family("大理段家", 16, "弟子");
		me->set("family/master_name","金庸");
		me->set("family/master_id","jin yong");

		me->set("title", me->query_temp("title"));
		me->delete_temp("title");

		chat_me(menpai, me);
