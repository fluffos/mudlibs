#include <ansi.h>

#define give_exp 30000 //设置新手奖励获得的初始exp
#define skill_Percentage 90 //获得的skill上限的百分比例如：90 = 90%
#define pot_Percentage 100
#define neili_Percentage 90
#define jingli_Percentage 90
#define literates 200 //读书写字等级

inherit NPC;
#include "/d/welcome/npc/shizhe.h";

string ask_me();
int ask_menpai (string* message);
int do_join(string menpai);
int chat_me(string menpai, object me);
int update_player(object me);
int do_clear_attrib(object me);
int do_clear_skill(object me);

void create()
{
        set_name("转档使者", ({ "shi zhe", "shizhe" }) );
         set("nickname", HIY"想转档先找wiz恢复exp再来！"NOR);
		 set_color("$YEL$");
        set("gender", "男性" );
        set("age", 68);
 set("long", YEL"这位是〖金庸梦〗的使者，向他打听“帮助”，他会带给您想不到的惊喜。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 1000000);
        set("str", 30);
        set("dex", 30);
        set("con", 30);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
        set("max_neili", 100000);
        set("score", 100000);

        set("inquiry", ([
			             "华山派"   :  (: ask_menpai, hs:),
			             "丐帮"   :  (: ask_menpai, gb:),
			             "全真教"   :  (: ask_menpai, qz:),
			             "武当派"   :  (: ask_menpai, wd:),
			             "少林派"   :  (: ask_menpai, sl:),
                         "峨眉派"   :  (: ask_menpai, em:),
						 "密宗"   :  (: ask_menpai, mz:),
			             "星宿派"   :  (: ask_menpai, xx:),
			             "白驼山庄"   :  (: ask_menpai, bt:),
                         "桃花岛"   :  (: ask_menpai, th:),
						 "大理段氏"   :  (: ask_menpai, dl:),
						 "普通百姓"   :  (: ask_menpai, bx:),
			             "帮助"   :  (: ask_me :),

        ]));
        setup();
}

void init()
{
        object ob;
        ob = this_player();     
        ::init();
		add_action("do_join", "join");
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }

}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() || ob->query("newbie") != "yes") return;
command("whisper " + ob->query("id") + " "HIW"欢迎光临本ＭＵＤ，本人现在将助你一臂之力．\n"
+NOR+"	 想了解各大门派请输入"+HBRED+HIW"(ask jin about 门派名称) 或 (help menpai)\n"
+NOR+"	 现在本ＭＵＤ所有的门派分别是：\n"
+NOR+"	 丐帮(gaibang)、全真教(quanzhen)、武当派(wudang)、华山派(huashan)\n"
+NOR+"	 密宗(xueshan)、星宿派(xingxiu)、白驼山庄(baituo)、桃花岛(taohua)\n"
+NOR+"	 少林派(shaolin)、峨眉派(emei)、大理段氏(dali)、灵鹫宫(lingjiu)\n"
+NOR+"	 加入喜欢的门派请输入"+HBRED+HIW"(join 门派中文名称) 或 (join 门派拼音)\n"NOR);

}

string ask_me()
{
	object me = this_player () ;

   if( me->query("newbie") != "yes") return "对不起，你已经不是新人了。我帮助不了你什么！\n";
command("whisper " + me->query("id") + " "HIW"欢迎光临本ＭＵＤ，本人现在将助你一臂之力．\n"
+NOR+"	 想了解各大门派请输入"+HBRED+HIW"(ask jin about 门派名称) 或 (help menpai)\n"
+NOR+"	 现在本ＭＵＤ所有的门派分别是：\n"
+NOR+"	 丐帮(gaibang)、全真教(quanzhen)、武当派(wudang)、华山派(huashan)\n"
+NOR+"	 密宗(xueshan)、星宿派(xingxiu)、白驼山庄(baituo)、桃花岛(taohua)\n"
+NOR+"	 少林派(shaolin)、峨眉派(emei)、大理段氏(dali)、灵鹫宫(lingjiu)\n"
+NOR+"	 加入喜欢的门派请输入"+HBRED+HIW"(join 门派中文名称) 或 (join 门派拼音)\n"NOR);

    return "还有什么需要我帮忙的吗？\n";
 
}

int ask_menpai (string* message)
{	int count, total;
	total = sizeof(message);
	for (count = 0; count < total; count++)
	{	command(message[count]);
	}
	return 1;
}

int do_join(string arg)
{
	int exp, pot, level, max, maxneili, maxjingli;
	string ttt, menpai;
	object weapon;
	object me = this_player () ;

	if (me->query("newbie") != "yes")
		return notify_fail("什么？\n");

	if (!arg)
		return notify_fail("	 现在本ＭＵＤ所有的门派分别是：\n"
+NOR+"	 丐帮(gaibang)、全真教(quanzhen)、武当派(wudang)、华山派(huashan)\n"
+NOR+"	 密宗(xueshan)、星宿派(xingxiu)、白驼山庄(baituo)、桃花岛(taohua)\n"
+NOR+"	 少林派(shaolin)、峨眉派(emei)、大理段氏(dali)、灵鹫宫(lingjiu)\n"
+NOR+"	 加入喜欢的门派请输入"+HBRED+HIW"(join 门派中文名称) 或 (join 门派拼音)\n"NOR);

//		level = 60;
//		exp = level * level * level / 10;
		if ((int)me->query("combat_exp") > 200000 && me->query("hytoxkx") != "over")
		{
			exp = (int)me->query("combat_exp");
			me->set("hytoxkx", "over");
			me->set("mud_age",400000);
			do_clear_attrib(me);
			do_clear_skill(me);
		}
		else{
			write("什么？\n");
			return 1;
//			exp = give_exp;
		}
		level = to_int(pow(to_float(exp) * 10.0, 0.333333)) * skill_Percentage / 100;

	switch(arg) {
		case "wudang": menpai = "武当派"; break;
		case "xingxiu": menpai = "星宿派"; break;
		case "huashan": menpai = "华山派"; break;
		case "taohua": menpai = "桃花岛"; break;
		case "gaibang": menpai = "丐帮"; break;
		case "emei": menpai = "峨嵋派"; break;
		case "baituo": menpai = "白驼山庄"; break;
		case "quanzhen": menpai = "全真教"; break;
		case "xueshan": menpai = "密宗"; break;
		case "dali": menpai = "大理段氏"; break;
		case "shaolin": menpai = "少林派"; break;
		case "lingjiu": menpai = "灵鹫宫"; break;
		case "gumu": menpai = "古墓派"; break;

			default:
				menpai = arg;
		}

    switch (menpai){
    case "华山派":
		me->set_skill("huashan-jianfa", level);
        me->set_skill("huashan-shenfa", level);
        me->set_skill("zixia-gong", level);
	    me->set_skill("hunyuan-zhang", level);
		me->set_skill("pishi-poyu", level);
		me->set_skill("cuff", level);
		me->set_skill("sword", level);
		me->set_skill("strike", level);
		me->set_skill("zhengqi-jue", level);
 
        me->map_skill("force", "zixia-gong");
        me->map_skill("dodge", "huashan-shenfa");
        me->map_skill("parry", "huashan-jianfa");
        me->map_skill("strike", "hunyuan-zhang");
        me->map_skill("sword", "huashan-jianfa");
		me->map_skill("cuff", "pishi-poyu");
        
        me->prepare_skill("strike", "hunyuan-zhang");
		me->prepare_skill("cuff", "pishi-poyu");

		me->create_family("华山派", 14, "弟子");
		me->set("family/master_name","金庸");
		me->set("family/master_id","jin yong");
		me->set("shen", 10000);
		me->set("title", "金庸嫡传华山派小剑侠");
	    chat_me(menpai, me);

	break;
    case "峨嵋派":
		me->set_skill("emei-jian", level);
		me->set_skill("jinding-zhang", level);
		me->set_skill("tiangang-zhi", level);
		me->set_skill("linji-zhuang", level);
		me->set_skill("zhutian-bu", level);
		me->set_skill("persuading", level);
		me->set_skill("sword", level);
	    me->set_skill("mahayana", level);    

		me->set_skill("sword", level);
		me->set_skill("strike", level);
		me->set_skill("finger", level);

		me->map_skill("force", "linji-zhuang");
		me->map_skill("sword", "emei-jian");
		me->map_skill("strike", "jinding-zhang");
		me->map_skill("dodge", "zhutian-bu");
		me->map_skill("parry", "emei-jian");
		me->map_skill("finger", "tiangang-zhi");

        me->prepare_skill("strike", "jinding-zhang");
		me->prepare_skill("finger", "tiangang-zhi");

		me->create_family("峨嵋派", 5, "弟子");
		me->set("family/master_name","金庸");
		me->set("family/master_id","jin yong");
		me->set("shen", 10000);
		me->set("emei", 1);
		me->set("title", "金庸嫡传峨嵋派俗家弟子");
		chat_me(menpai, me);
	break;
    case "武当派":
        me->set_skill("taiji-shengong", level);
        me->set_skill("taiji-jian", level);
        me->set_skill("tiyunzong", level);
		me->set_skill("taiji-quan", level);
		me->set_skill("sword", level);
		me->set_skill("taoism", level);
		me->set_skill("cuff", level);
 
        me->map_skill("force", "taiji-shengong");
        me->map_skill("parry", "taiji-jian");
		me->map_skill("cuff", "taiji-quan");
        me->map_skill("dodge", "tiyunzong");
        me->map_skill("sword", "taiji-jian");
        
        me->prepare_skill("cuff", "taiji-quan");
		me->create_family("武当派", 4, "弟子");
		me->set("class", "taoist");
		me->set("family/master_name","金庸");
		me->set("family/master_id","jin yong");
		me->set("wudang/offerring", me->query("age")*2);
		me->set("shen", 30000);
		me->set("title", "金庸嫡传武当派小牛鼻子");
		chat_me(menpai, me);
	break;
    case "少林派":
		if (me->query("gender")=="女性")
		   return notify_fail("对不起，少林派不收女弟子！\n");

        me->set_skill("buddhism", level);

		me->set_skill("cuff", level);
