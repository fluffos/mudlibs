		me->set_skill("yizhi-chan", level);
		me->set_skill("nianhua-zhi", level);
		me->set_skill("cibei-dao", level);
		me->set_skill("xiuluo-dao", level);
		me->set_skill("fumo-jian", level);
//		me->set_skill("damo-jian", level);
		me->set_skill("zui-gun", level);
		me->set_skill("weituo-gun", level);
		me->set_skill("pudu-zhang", level);
		me->set_skill("wuchang-zhang", level);
//		me->set_skill("riyue-bian", level);
		me->set_skill("hunyuan-yiqi", level);
		me->set_skill("shaolin-shenfa", level);
	
		me->map_skill("force", "hunyuan-yiqi");
		me->map_skill("dodge", "shaolin-shenfa");
		me->map_skill("cuff", "luohan-quan");
		me->map_skill("strike", "sanhua-zhang");
		me->map_skill("hand", "qianye-shou");
		me->map_skill("claw", "longzhua-gong");
		me->map_skill("finger", "yizhi-chan");
		me->map_skill("blade", "cibei-dao");
		me->map_skill("sword", "fumo-jian");
		me->map_skill("club", "weituo-gun");
		me->map_skill("staff", "pudu-chang");
		me->map_skill("parry", "cibei-dao");

		me->prepare_skill("hand", "qianye-shou");
		me->prepare_skill("claw", "longzhua-gong");

		me->create_family("少林派", 41, "弟子");
		me->set("family/master_name","金庸");
		me->set("family/master_id","jin yong");
		me->set("shen", 10000);

		me->set("title", "金庸嫡传少林派俗家弟子");

		chat_me(menpai, me);
	break;

    case "丐帮":
        me->set_skill("liuhe-dao", level);
        me->set_skill("xiaoyaoyou", level);
        me->set_skill("huntian-qigong", level);
		me->set_skill("shexing-diaoshou", level);
		me->set_skill("checking", level); 
		me->set_skill("digging", level); 
		me->set_skill("hand", level); 
