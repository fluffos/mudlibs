int chat_me(string menpai, object me)
 {
  //       if (!me->query("newbie"))
  //              return "呵呵～年轻人，做人要厚道！";
          me->delete("newbie", "yes");
		  CHANNEL_D->do_channel(me, "chat", sprintf("在下承蒙金庸先生帮助，现已加入"
			+menpai+"！即日起开始行走江湖，还望各位武林同道今后多多关照！\n", me->name(1)));

		  command("whisper " + me->query("id") + " "HIW"现在我已经给你帮助了。\n\n"
			+NOR"	"+HBRED+HIW"(查看状态请输入：hp) (查看技能请输入：skills) (施展轻功请：help dodge)\n");

		  return notify_fail(HIW"只见"+NOR+YEL+"金庸"+NOR+HIW"伸手往半空一指，突然天空中一道"
			+HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！\n"NOR);
}

int update_player(object ob)
{
	object env, link_ob, me;
	int max;

	env = environment(ob);

	// First, create the new body.
	link_ob = ob->query_temp("link_ob");
	me = LOGIN_D->make_body(link_ob);
	if (!me) return 0;

	// Save the data and exec the player to his/her link object.
	ob->save();
	exec(link_ob, ob);
	destruct(ob);

	// Restore new body and exec to it via enter_world in LOGIN_D
	me->restore();
	LOGIN_D->enter_world(link_ob, me, 1);

	write("身体更新完毕。\n\n");
	me->move(env);
	me->write_prompt();
	max = me->query("max_jing");
	me->set("eff_jing",max);
	me->set("jing",max);
	max = me->query("max_qi");
	me->set("eff_qi",max);
	me->set("qi",max);
	max = me->query("max_neili");
	me->set("neili",max);
	max = me->query("max_jingli");
	me->set("jingli",max);
	max = me->max_food_capacity();
	me->set("food",max * 10);
	max = me->max_water_capacity();  
	me->set("water",max * 10);
	me->set("startroom","/d/city/kedian");

	return 1;
}

