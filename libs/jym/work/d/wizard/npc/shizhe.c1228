		me->set_skill("blade", level);
		me->set_skill("strike", level);
		me->set_skill("xianglong-zhang", level);
 
        me->map_skill("force", "huntian-qigong");
        me->map_skill("dodge", "xiaoyaoyou");
        me->map_skill("parry", "liuhe-dao");
        me->map_skill("blade", "liuhe-dao");
        me->map_skill("hand", "shexing-diaoshou");
		me->map_skill("strike", "xianglong-zhang");
        
        me->prepare_skill("strike", "xianglong-zhang");

		me->create_family("丐帮", 20, "弟子");
		me->set("family/master_name","金庸");
		me->set("family/master_id","jin yong");
		me->set("title", "金庸嫡传丐帮一袋弟子");

		chat_me(menpai, me);
	break;
    case "白驼山庄":
        me->set_skill("hamagong", level);
        me->set_skill("lingshe-zhang", level);
		me->set_skill("chanchubu", level);
		me->set_skill("poison", level);
		me->set_skill("training",level);
		me->set_skill("strike", level);
 
        me->map_skill("force", "hamagong");
        me->map_skill("dodge", "chanchubu");
        me->map_skill("parry", "lingshe-zhang");
        me->map_skill("strike", "hamagong");
        me->map_skill("staff", "lingshe-zhang");

		me->set("shen",-10000);
        
        me->prepare_skill("strike", "hamagong");
		me->create_family("白驼山", 4 , "弟子");
		me->set("family/master_name","金庸");
		me->set("family/master_id","jin yong");
		
		if (me->query("gender") == "男性") ttt = "家丁";
		else  if (me->query("gender") == "女性") ttt = "婢女";
		me->set("title", "金庸嫡传白驼山庄" + ttt);

		chat_me(menpai, me);
	break;

    case "桃花岛":
        me->set_skill("bitao-xuangong", level);
        me->set_skill("luoying-shenfa", level);
		me->set_skill("luoying-shenjian", level);
		me->set_skill("qimen-dunjia", level);
		me->set_skill("canglang-bian", level);
		me->set_skill("lanhua-fuxue", level);
		me->set_skill("music", level);
		me->set_skill("whip", level);
