		me->set("class", "lama");
		me->set("shen",-10000);

		me->create_family("雪山派", 13, "弟子");
		me->set("family/master_name","金庸");
		me->set("family/master_id","jin yong");
		me->set("title", "金庸嫡传密宗小喇嘛");

		chat_me(menpai, me);
	break;

    case "全真教":
        me->set_skill("xiantian-gong", level);
        me->set_skill("jinyangong", level);
        me->set_skill("cuff", level);
        me->set_skill("chunyang-quan", level);
        me->set_skill("strike", level);
