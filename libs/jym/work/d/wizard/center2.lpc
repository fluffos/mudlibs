#include <ansi.h>

inherit ROOM;

#define JOB_DIR "/clone/obj/challenge/"
#define CHALLENGE "/clone/obj/challenge/challenge_produce.lpc"

string show_word();

void create()
{
        set("short", "挑战控制室");

        set("long", @LONG
这里就是「侠客行」门派挑战控制室。刚粉刷过的四周墙壁上挂着过往巫师
的画像。屋子的正中央放着一张楠木桌，上面摆着一本书，书上面写着几行金光
闪闪的小字(gold word)。
LONG );

//		set("outdoors", "挑战控制室");
        set("exits", ([
        "east" : __DIR__"wizard_room" ]));

		set ("item_desc", ([
				"gold word" : (: show_word :),
				]));

        set("valid_startroom", 1);
        set("no_fight", "1");
        set("no_refresh",1);
        set("cost", 0);
		 
        setup();


//      replace_program(ROOM);
}

string show_word()
{
	return HIW"门派挑战控制说明：\n"NOR
		HIC"\t命令\t\t\t解释\n"NOR
		HIY"\tstart_system\t\t"NOR+HIG"启动门派挑战系统\n"NOR
		HIY"\tclose_system\t\t"NOR+HIG"启动门派挑战系统\n"NOR
		HIY"\tchallenge\t\t"NOR+HIG"发布一次门派挑战\n"NOR

		HIR"\n\n\t\t\t\t\t\慎用\n"NOR
		;
}

void init()
{
        object me = this_player();
	//	seteuid(getuid()); 

        if (wizhood(me) == "(player)")
                me->move("/d/death/death.lpc");

	add_action("do_start_system", "start_system");
	add_action("do_close_system", "close_system");
	add_action("do_challenge", "challenge");
	add_action("do_stops", "job_stops");



}

int do_start_system()
{
	object job_data,job_system;
	if(!wizardp(this_player()))
			return notify_fail ("你还没有获得神仙的法力，无法开启门派挑战系统。\n");
	
	
	if(!job_data=find_object(JOB_DIR+"challenge_data.lpc"))
		job_data=new(JOB_DIR+"challenge_data.lpc");
	if(!objectp(job_data)) return notify_fail ("数据库程序编译出错。\n");
	job_data->restore();

	if(!find_object(JOB_DIR+"challenge_system"))
		if(!load_object(JOB_DIR+"challenge_system"))
			return notify_fail ("challenge_system编译出错。\n");

		if(job_data->query_job_start())
			return notify_fail ("任务系统已经开启。\n");

	job_data->set_job_start();
	log_file( "test/challenge_set",
		this_player()->query("name")+
		"("+this_player()->query("id")+")将门派挑战系统开启"+
		" on " 	+ ctime(time()) + "。\n" );
	CHANNEL_D->do_channel(this_object(), "rumor", "听说最近江湖中出现了一些专爱追逐名利的武林高手。");
	CHANNEL_D->do_channel(this_player(), "sys", "我将门派挑战系统开启了。\n");

	return 1;
}

int do_close_system()
{
	object job_data,job_system;
	if(!wizardp(this_player()))
			return notify_fail ("你还没有获得神仙的法力，无法关闭主动性任务系统。\n");
	
	
	if(!job_data=find_object(JOB_DIR+"challenge_data.lpc"))
		job_data=new(JOB_DIR+"challenge_data.lpc");
	if(!objectp(job_data)) return notify_fail ("数据库程序编译出错。\n");
	job_data->restore();

	if(!find_object(JOB_DIR+"challenge_system"))
		if(!load_object(JOB_DIR+"challenge_system"))
			return notify_fail ("challenge_system编译出错。\n");

		if(!job_data->query_job_start())
			return notify_fail ("任务系统已经关闭。\n");

	job_data->set_close_start();
	log_file( "test/challenge_set",
		this_player()->query("name")+
		"("+this_player()->query("id")+")将门派挑战系统关闭"+
		" on " 	+ ctime(time()) + "。\n" );
	CHANNEL_D->do_channel(this_player(), "sys", "我将门派挑战系统关闭了。\n");
	return 1;
}

int do_challenge(string arg)
{
	string *menpai_list = ({
    "huashan", "shaolin", "wudang", "emei", "gaibang", "lingjiu", "dali",
    "baituo", "xueshan", "xingxiu", "taohua", "gumu", "quanzhen"  });

	object me;
	me=this_player();

	if(this_player()->query("id")!="muder")
			return notify_fail ("任务控制系统目前只能由高级巫师来控制。\n");
	if(!wizardp(me))
			return notify_fail ("你还没有获得神仙的法力，无法控制这里。\n");

	if (!arg)
		return notify_fail ("格式：challenge <门派拼音>。\n");

	if (member_array(arg, menpai_list) != -1 )
	{
		CHALLENGE->produce_challenge(arg);
		return notify_fail ("挑战产生成功。\n");
	}
	return notify_fail ("格式：challenge <门派拼音>。\n");

}

int do_stops()
{
	object *ob_list, ob;
	int i;
	ob_list = children("/task/challenge/challenger.lpc");
                for(i=0; i<sizeof(ob_list); i++) 
		if(environment(ob_list[i]))
		{
			message("channel:chat", ob_list[i]->query("name")+"阴笑道：哈哈，老子先撤了！\n"NOR,users() );
			ob = ob_list[i];
			ob->remove_call_out("self_destruct");
			ob->call_out("self_destruct", 5);
	//		destruct(ob);
                }
	delete("job_start");
	remove_call_out("do_run");
	return notify_fail ("任务中止。\n");
}
