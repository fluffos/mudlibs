#include <ansi.h>
#define CHAMPION_FILE "/log/champion_gb.lpc"//每个门派的记录
inherit NPC;
void loadall(object me);
string id1;
void find(string id);
void changeshape(object winner);
int ask_me();

void create() {
  string info, name, id, file;
  set_name("大弟子", ({ "dizi" }));
  setup();
  info = read_file(CHAMPION_FILE);
  if (info && sscanf(info, "%s %s %s", file, id, name) == 3) {
    restore_object(file);
    set_name(name, ({ id }));
    create_family("丐帮", 40, "弟子");
    delete("env");
    set("attitude", "aggressive");
    set("title", HIY "丐帮掌门大弟子" NOR);
    set("inquiry", ([
      "ling": (: ask_me :),
    ]));
    set("no_kill", 1);
    set("no_get", 1);
    reset_action();
    delete_temp("already_loaded");
    loadall(this_object());

  }
}
int ask_me() {
  object zheng;
  if (this_object()->query("id") == this_player()->query("id")
    && !present("ling", this_player())) {
    zheng = new(__DIR__ "obj/ling");
    zheng->move(this_player());
    message_vision("掌门大弟子$N给了$n一面令牌。\n", this_object(), this_player());
    return 1;
  } else {
    command("say 你要令牌做什么？");
    return 1;
  }
  return 1;
}

void lose_enemy(object winner) {
  remove_call_out("changeshape");
  call_out("changeshape", 2, winner);
  return;
}
void changeshape(object winner)     //给玩家拷贝
{
  string winner_file;
  object zheng;
  string name, id, nick;
  winner_file = winner->query_save_file();
  CHANNEL_D->do_channel(this_object(), "chat",
    sprintf("%s从现在开始是丐帮新的掌门大弟子了！！ \n",   //每个门派的弟子提示
    winner->name(1)));
  write_file(CHAMPION_FILE, sprintf("%s %s %s",
    winner_file, winner->query("id"), winner->query("name")), 1);
  restore_object(winner_file);
  name = winner->query("name");
  id = winner->query("id");
  set_name(name, ({ id }));
  nick = winner->query("nickname");
  delete("env");
  set("attitude", "aggressive");
  reset_action();
  delete_temp("already_loaded");
  loadall(this_object());
  set("title", HIY "丐帮掌门大弟子" NOR);       //每个npc的别称
  set("nickname", nick);
  zheng = new(__DIR__ "obj/ling");
  find(id);
  zheng->move(winner);
  message_vision("掌门大弟子给了$N一面令牌。\n", winner);  //每个门派给的东西

  this_object()->set("no_kill", 1);
  this_object()->set_temp("no_kill", 1);


  return;
}

void loadall(object me) {
  int MAX = 3;
  string name, id, *created;
  int i, j;
  object thing, *inv;
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    destruct(inv[i]);
  }

  id = me->query("id");
  created = get_dir(DATA_DIR + "login/" + id[0..0] + "/" + id + "/");
  for (j = 0; (j < sizeof(created) && j < (MAX + 1)); j++)
    if (sscanf(created[j], "%s.lpc", name) == 1) {
      thing = new(DATA_DIR + "login/" + id[0..0] + "/" + id +
        "/" + name + ".lpc");
      if (thing->move(me)) {
        thing->wield();
        thing->wear();
      }
    }
  me->reset_action();
  me->set_temp("already_loaded", 1);
  return;
}
void init() {

  if (!query_temp("already_loaded")) {
    loadall(this_object());
    return;
  }
  add_action("do_set", "setleve");

  remove_call_out("do_kill");
  call_out("do_kill", 1);
}
int accept_fight(object me) {
  if ((string)this_player()->query("family/family_name") != "丐帮")
    return notify_fail("只有同门弟子才能争夺大弟子之位！\n");

  if (objectp(this_player()->query_temp("weapon")))
    return notify_fail("请放下武器，点到为止。\n");

  command("say 好，你打败我就可以成为掌门大弟子！");
  return 1;

}
void die() {
  object ob;
  if (!ob = query_temp("last_damage_from"))
    ob = this_player(1);
  this_object()->revive();
  this_object()->reincarnate();
  this_object()->remove_all_enemy();
  ob->remove_all_enemy();
  this_object()->set_temp("da_dizi", 1);
  command("say 身手不错，你已经打败我了!");
  command("say 我需要五十万的经验来掌握你的技能。");
  command("say 如果你要接任掌门弟子之职,请用setleve指令。");
  //      return;
}
void find(string id) {
  object *ulist, *ilist;
  object ob;
  int i, j;
  ulist = users();
  i = sizeof(ulist);
  while (i--) {
    if (present("gbling", ulist[i])) {
      ilist = all_inventory(ulist[i]);
      j = sizeof(ilist);
      while (j--) {
        ob = ilist[j];
        if (ob->query("id") == "ling") {
          destruct(ob);
        }
      }
      message_vision(HIY "$N身上的令牌不翼而飞了。\n" NOR, ulist[i]);
    }
  }
}

int do_set(string arg) {
  object ob;

  if (!ob = query_temp("last_damage_from"))
    ob = this_player(1);

  if (!ob) return;
  if (this_player() != ob) return notify_fail("什么？\n");

  if (!this_object()->query_temp("da_dizi")) return notify_fail("什么？\n");

  if (this_player()->query("combat_exp") > 1000000) {
    message_vision(
      "$N确定要用掉自己五十万的经验传授于他吗？是" + HIR + "(yes)" + NOR + " 否" + HIR + "(none)" + NOR,
      this_player()
    );
    add_action("do_yes", "yes");
    add_action("do_no", "none");
  } else {
    message_vision(
      HIR + "$N用尽全身力气，想要把平生所学传授于$n。结果毫无起色，可能是$n悟性太差。\n" + NOR,
      this_player(),
      this_object()
    );
    this_player()->add("jing", -50);
    this_player()->add("jingli", -20);
    this_object()->delete_temp("da_dizi");
  }
  return 1;
}

int do_yes() {
  object ob;

  if (!ob = query_temp("last_damage_from"))
    ob = this_player(1);

  if (!ob) return;

  ob->add("combat_exp", -500000);
  ob->save();
  ob->start_busy(10);
  message_vision(HIY + "$N把经验尽数提起，慢慢地把平生所学传授于给了$n。\n" + NOR, ob, this_object());
  message_vision(HIR + "$N只觉得自己经验和武功丧失了不少。\n" + NOR, ob, this_object());
  this_player()->delete_temp("da_dizi");
  changeshape(ob);
  return 1;
}

int do_no() {
  this_object()->delete_temp("da_dizi");
  return notify_fail("你决定放弃担任掌门弟子。\n");
}

int accept_kill(object me) {
  object ob;
  if (!ob = query_temp("last_damage_from"))
    ob = this_player(1);
  this_object()->reincarnate();
  this_object()->remove_all_enemy();
  ob->remove_all_enemy();
  if ((string)this_player()->query("family/family_name") != "丐帮")
    return notify_fail("只有丐帮弟子才能争夺大弟子之位！\n");
}
int do_kill() {
  set("title", HIY "丐帮掌门大弟子" NOR);
  this_object()->set("no_kill", 1);
  return 1;
}
