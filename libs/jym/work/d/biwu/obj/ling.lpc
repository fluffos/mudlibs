// ling.c 令牌
#include <armor.h>
#include <ansi.h>
inherit HANDS;
void create() {
  set_name(HIY "令牌" NOR, ({ "btling" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一块掌门大弟子的令牌。你可以召唤(zhao)护卫来保护自己。\n");
    set("no_put", 1);
    set("no_get", 1);
    set("armor_prop/intelligence", 2);
    set("armor_prop/strength", 2);
    set("armor_prop/karey", 2);
    set("armor_prop/percao", 2);
    set("armor_prop/dexerity", 2);
    set("armor_prop/constitution", 2);
    set("no_drop", 1);
    set("rigidity", 100);
    set("material", "steel");

  }
  setup();
}
void init() {
  this_object()->set_name(HIY + this_player()->query("name") +
    "的令牌" NOR, ({ "ling" }));
  add_action("do_zhao", "zhao");
  add_action("do_huifu", "heal");

}
int do_zhao() {
  object dizi, me;
  int exp;
  me = this_player();
  if ((int)me->query_temp("number") > 0)
    return notify_fail("你最多只能召唤一名随身弟子。\n");
  if (me->query("jing") < 100)
    return notify_fail("你精不够。\n");
  if (!me->is_fighting())
    return notify_fail("好象没有人要杀你！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙得不得了，还有心思召唤你的弟子？\n");
  exp = (int)me->query("combat_exp");
  me->receive_damage("jing", 100);
  dizi = load_object(__DIR__ "dizi.lpc");
  dizi->move(environment(me));
  dizi->invocation(me, (exp));
  dizi->set("possessed", me);
  dizi->set_name(HIY + this_player()->query("name") + "的随身弟子" + NOR, ({ "dizi" }));
  me->add_temp("number", 1);
  me->remove_all_killer();
  message_vision(CYN "\n$N发出号令，召唤身边的弟子来保护自己！\n" NOR, me);
  message_vision(CYN "\n$N的弟子随着号令声而来！\n" NOR, me);
  return 1;
}
int do_huifu() {
  object dizi, me;
  int exp;
  me = this_player();
  if ((int)me->query_temp("number") > 0)
    return notify_fail("你最多只能召唤一名随身弟子。\n");



  if (me->query("combat_exp") < 100000)
    return notify_fail("你经验不足，无法召唤你的弟子。\n");

  exp = (int)me->query("combat_exp");
  dizi = load_object(__DIR__ "dizi.lpc");
  dizi->move(environment(me));
  dizi->invocation(me, (exp));
  dizi->set("possessed", me);
  dizi->set_name(HIY + this_player()->query("name") + "的随身弟子" + NOR, ({ "dizi" }));
  me->add_temp("number", 1);
  message_vision(CYN "\n$N发出号令，召唤身边的弟子来保护自己！\n" NOR, me);
  message_vision(CYN "\n$N的弟子随着号令声而来！\n" NOR, me);
  message_vision(HIY "\n弟子喂$N服下一颗药丸。\n" NOR, me);
  message_vision(HIY "$N凭借自己的经验使药效散至全身。\n" NOR, me);
  message_vision(HIR "$N的伤势痊愈了！\n" NOR, me);
  me->add("combat_exp", -random(10000));
  me->reincarnate();
  return 1;
}
void owner_is_killed() {
  destruct(this_object());
}
int query_autoload() {
  return 1;
}
