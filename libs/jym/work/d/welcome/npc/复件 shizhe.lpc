#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name("金庸", ({ "jin yong", "jin" }));
  set("nickname", HIY "我已经老了！" NOR);
  set_color("$YEL$");
  set("gender", "男性");
  set("age", 68);
  set("long", YEL "这位是〖金庸梦〗的使者，向他打听“帮助”，他会带给您想不到的惊喜。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("max_neili", 100000);
  set("score", 100000);

  set("inquiry", ([
    "帮助": (: ask_me :),
    "新手奖励": (: ask_me :),
    "gift": (: ask_me :)
  ]));
  setup();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment() || ob->query("newbie") != "yes") return;
  command("whisper " + ob->query("id") + " " HIW "欢迎光临本ＭＵＤ" + HIR + "(ask jin about 帮助) " + NOR + HIW + "本人将助你一臂之力．" NOR);
  //   command("es " + HIC"欢迎光临〖笑红尘II〗,IP: 202.114.203.100 Port: 5555 \n"NOR);
}

string ask_me() {
  object me = this_player();
  mapping fam;

  if (!me->query("newbie"))
    return "呵呵～年轻人，做人要厚道！";
  else {
    me->delete("newbie", "yes");
    me->set("eff_qi", 300);
    me->set("qi", 300);
    me->add("max_neili", 400);
    me->add("neili", 400);
    me->add("potential", 90000);
    me->add("food", 1000);
    me->add("water", 10000);
    me->add("combat_exp", 100000);

    me->set_skill("force", 100);
    me->set_skill("dodge", 60);
    me->set_skill("parry", 60);
    //				me->set_skill("unarmed", 60);
    me->set_skill("literate", 100);
    me->set_skill("liuxing-bu", 10);
    me->map_skill("dodge", "liuxing-bu");
    CHANNEL_D->do_channel(me, "chat", sprintf("在下%s现已得到金庸的帮助和奖励！即日起开始行走江湖了！", me->name(1)));
    return WHT "欢迎光临" NOR + HIR "本ＭＵＤ" WHT "，在下金庸，可助您行走江湖！" NOR "\n"
      HIW "突然天空中一道" HIM "七" HIY "彩" HIR "霞" HIC "光" HIW "笼罩四方，转瞬即逝！" NOR;
  }
}
