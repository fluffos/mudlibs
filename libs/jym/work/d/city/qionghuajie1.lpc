inherit ROOM;

void create() {
  set("short", "琼花街");
  set("long", @LONG
这条街是用碎石子铺成的，好像没有什么富贵人家。巡捕、衙役也很少到这
来，只有几个卖花的小女孩叫嚷着走来走去。这里没有南北集市那样热闹，不远
的东面好像人头攒动，拿斗的、拿布袋的，正围着一家铺子大声吆喝。东边是一
些卖水果的摊子，西南边是北集市。
LONG
  );
  set("outdoors", "city");

  set("exits", ([
    "southwest": __DIR__ "beidajie1",
    "east": __DIR__ "qionghuajie2",
  ]));

  set("objects", ([
    __DIR__ "npc/girl": 2,
  ]));

  set("cost", 1);
  setup();
}
