//Cracked by Roath
// qiguoji.c

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(MAG"黛玉水"NOR, ({"daiyu shui", "water", "shui" }));
	set_weight(200);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "著名的黛玉牌洗脸水，传说有神奇功效。\n");
		set("unit", "瓶");
		set("value", 420000);
		set("remaining", 20);
		set("drink_supply", 180);
		set("food_supply", 150);
	}
}

void init()
{
	add_action("do_drink", "drink");
}

int do_drink(string arg)
{
	if (arg!="daiyu shui" && arg!="water" && arg!="shui") return 0;
	if (this_player()->is_busy())
		return notify_fail("你上一个动作还没有完成。\n");

	if ((int)this_player()->query("water")
		>= (int)this_player()->max_water_capacity() * 10 )
		return notify_fail("你已经喝得太多了，再也灌不下一滴水了。\n");
	if ((int)this_player()->query("food")
		>= (int)this_player()->max_food_capacity() * 10 )
		return notify_fail("你已经吃得太多了，再也撑不下任何东西了。\n");

	set("value", 0);
	this_player()->add("water", (int)query("drink_supply"));
	this_player()->add("food", (int)query("food_supply"));

	if( this_player()->is_fighting() ) this_player()->start_busy(2);

	add("remaining", -1);
	if (query("remaining")) {
		message_vision("$N从怀里摸出一瓶黛玉牌洗脸水打开瓶盖嗅了嗅，立时似有种神游太虚的感觉浮现。\n",this_player());
	}
	else {
		message_vision("$N从怀里摸出一瓶黛玉牌洗脸水打开瓶盖嗅了嗅接着又摇了摇，似乎瓶子已经是空的了。\n",this_player());
		destruct(this_object());
	}
	return 1;
}
