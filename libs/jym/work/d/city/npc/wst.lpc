int ask_level()

{	int comexp, answer, i;
	object me = this_player();
	
	comexp = me->query("combat_exp");
	comexp = comexp * 10;
	for(i=0;comexp>i*i*i;i++)
	answer = i + 1;
	tell_object(me, ""HIC"万事通"NOR"说道：你目前的最高等级上限是"+ HIG + chinese_number(answer) + NOR +"级\n");
	return 1;
}

