// yayi.c  官府衙役
#include <ansi.h>
inherit NPC;
#include "npc_skills_attrib_setup.h"
string *family_list = ({ "武当派", "全真派", "华山派", "大理段家", "少林派", "峨嵋派" });
void remove_cantmove(object me);
void create() {
  set_name("燕捕头", ({ "yan butou", "butou", "xiaoliu" }));
  set_color("$YEL$");
  set("gender", "男性");
  set("age", 25);

  set("long", "这人真名叫做燕小六，是一个带有浓重天津口音的衙门捕头。\n");
  set("combat_exp", 75000);
  set("shen_type", 1);
  set_skill("unarmed", 40);
  set_skill("dodge", 90);
  set("inquiry", ([
    "工作": "那还不简单？你只要有胆量把广场的文书揭下来(jie wenshu)，然后把目标杀了就可以。",
  ]));
  set("chat_chance", 3);
  set("chat_msg", ({
    "燕捕头小声嘀咕道：“常听人说武林之中藏龙卧虎，也不知道是真是假？”\n",
    "燕捕头朗声说道：“各路英雄，本城目前悬赏捉拿江洋大盗，望各位能协助官府，惩治凶徒。”\n",

  }));
  setup();
  carry_object(__DIR__ "obj/yayifu")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) &&
    (int)ob->query_condition("killer")) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
  add_action("do_dodge", "dodge");
}

int accept_fight(object me) {
  command("say 小的有公务在身，不能与你过招。\n");
  return 0;
}

int accept_kill(object me) {
  command("say 大胆刁民敢在这里撒野！来人啊，将此刁民给我拿下！\n");
  me->apply_condition("killer", 100);
  remove_call_out("kill_ob");
  call_out("kill_ob", 1, this_player());
  return 1;
}
//////////add by wzfeng/////////////////////////////////
void kill_ob(object me) {
  int exp, i, k;
  object *inv;
  string family;
  if (me->query("id") != query("kill_player")) {
    set("kill_player", me->query("id"));
    inv = all_inventory(this_object());
    if (sizeof(inv))
      for (i = 0; i < sizeof(inv); i++)
        destruct(inv[i]);
    exp = me->query("combat_exp");
    Set_Npcattrib(20, 10,
      me->query("max_qi"), me->me("max_qi") / 10,
      me->query("max_jing"), me->query("max_jing") / 10,
      me->query("max_jingli"), me->query("max_jingli") / 10,
      me->query("max_neili"), me->query("max_neili") / 10,
      exp, exp / 10);
    exp = query("combat_exp");
    for (i = 0; (i * i * i / 10) < exp; i++);
    i = i * 7 / 8;
    k = sizeof(family_list);
    command("fangqi all");
    family = family_list[random(k)];
    skills_setup(random(2), i, 0, family);
    set("chat_chance_combat", 99);
    me->set_temp("cannot_move", 1);
    me->set_temp("cannot_move_msg", "你被" + this_object()->query("name") + "攻势所逼，无法移动半步\n");
    remove_call_out("remove_cantmove");
    call_out("remove_cantmove", 1 + random(1), me);
  }


  ::kill_ob(me);

}
void remove_cantmove(object me) {
  if (!me) return;
  me->delete_temp("cannot_move_msg");
  me->delete_temp("cannot_move");
}

int do_dodge() {
  object me = this_player();
  int use;
  use = me->query_temp("use_dodge");
  me->set_temp("use_dodge", use + 1);
  if (me->query_temp("use_dodge") < 10) {
    command("pat " + me->query("id"));
    command("say " + me->query("name") + "我严重警告你，这里是官府重地严禁使用轻功行走！以后别再老子面前耍酷。\n");
    return 1;
  } else {
    command("grin " + me->query("id"));
    command("say " + me->query("name") + "这是你自找的啊，别怪老子不客气了。来人啊，把这小子给我轰出扬州城！\n");
    message_vision(CYN "只听$n一声大喊，立时冲过来几个捕快架着$N一路小跑，一会儿$N就被捕快赶出了扬州城。\n\n" + NOR, me, this_object());
    me->move("/d/shaolin/hanshui1");
    return 1;
  }
}
