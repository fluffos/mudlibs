//Cracked by Roath
// liumangtou.c 流氓头

inherit NPC;
void greeting(object ob);
int accept_object(object who, object ob);
void create() {
  set_name("流氓头", ({ "liumang tou", "liumang", "liu" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "他长得奸嘴猴腮的，一看就不像是个好人。\n");

  set("combat_exp", 7000);
  set("shen_type", -1);
  set("attitude", "heroism");

  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set("chat_chance", 10);
  set("chat_msg", ({
    "流氓头唱道: 漂亮姑娘你请留步～～让我多看你一眼～～\n",
    "流氓头色迷迷地看着过往的小姑娘，不时的咽着口水。\n",
    "流氓头把纸扇一展，转过身去，深情地吟道：红颜知己最难得～～\n",
  }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if ((string)ob->query("gender") == "女性") {
    switch (random(3)) {
      case 0: command("rose " + (string)ob->query("id")); break;
      case 1: command("kiss " + (string)ob->query("id")); break;
      case 2: command("love " + (string)ob->query("id")); break;
    }

  } else
    say("流氓头叹了一口气说：这位" + RANK_D->query_respect(ob) +
      ",你要是能给我弄一个女人来就好了。\n");
  return;
}

int accept_object(object who, object ob) {
  object obn;
  if (!who || environment(who) != environment()) return 0;
  if (!objectp(ob)) return 0;

  if (!present(ob, who)) { say("你没有这件东西。\n"); return 0; }

  if ((string)ob->query("gender") != "女性") {
    say("流氓头不需要这件东西。\n"); return 0;
  }
  if (environment(this_object())->query("short") == "丽春院") {
    say("流氓头已经有女人了。\n"); return 0;
  }
  if ((int)ob->query("age") < 18) {
    say("流氓头大惊失色道：未成年少女我怎敢要！\n"); return 0;
  }
  if ((int)ob->query("age") > 40) {
    say("流氓头轻蔑地一笑道：这种老古董还是留给你自己吧！\n"); return 0;
  }


  obn = new("/clone/money/silver");
  obn->set_amount(30);
  obn->move(who);
  message_vision("流氓头一把把" + ob->query("name") + "揽在怀里，对$N说这点银子是你的辛苦费，
              咱回头见。\n说完，就携着" + ob->query("name") + "往丽春院奔去...\n", who);
  move("/d/city/lichunyuan");
  call_out("destroying", 0, ob);
  return 1;
}

void destroying(object ob) {
  if (!ob) return;
  if (!userp(ob)) {
    if (ob) destruct(ob);
  }
}
