       map_skill("dodge", "tiyunzong");
       map_skill("finger", "qianzhu-wandu");
       map_skill("parry", "qianzhu-wandu");
       prepare_skill("finger", "qianzhu-wandu");
     

       set("inquiry", ([
//               "秘籍" : (: ask_me :),
               "袁承志" : "教主一直挂怀着他，好久没有音信了。",
               "含沙射影" : "它是天下最毒辣的暗器。",
                
       ]));

//       wupin = random(2)?"/u/dubei/miaojiang/obj/txjdd":"/clone/weapon/blade";

       setup();
       carry_object(random(2)?"/d/miaojiang/obj/txjdd" : HERB_D("heshouwu"));
