       set("age", 36);
       set("attitude", "friendly");
       set("shen", -8000);
       set("str", 29);
       set("int", 27);
       set("con", 26);
       set("dex", 26);
        
       set("max_qi", 1500);
       set("max_jing", 1500);
       set("neili", 2000);
       set("max_neili", 2000);
       set("jiali", 100);
     set("combat_exp", 300000);
 
       set_skill("force", 150);
        set_skill("wudu-xinfa", 150);
       set_skill("dodge", 150);
      
       set_skill("tiyunzong", 260);
       set_skill("finger", 350);
       set_skill("qianzhu-wandu", 360);
       set_skill("parry", 340);
