#include <armor.h>
#include <ansi.h>

inherit CLOTH;
inherit F_SAVE;

int armor_level,armor_add = 100;

void create()
{
//        restore();
        set_name(HIY "真丝宝甲" NOR, ({ "bao jia", "jia" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "这是一件由黄金真丝编织而成的盔甲，据说曾被满洲第一勇士敖拜所拥有。锻造成功率100%\n");
                set("no_drop","宝物是扔/卖不了的，也不能给别人。");
                set("value", 50000);
                set("material", "gold");
                set("armor_prop/armor", 130);
        }
        setup();
}

void init()
{
	add_action("do_check","checkjia");
}

int do_check()
{
	object me = this_player();
	object ob = this_object();
	int ob_level = ob->query("armor_prop/armor");

	if(armor_add >= 20)
	{
		armor_level = (armor_add*5)/50;
		armor_level =  armor_level+ob_level;
		armor_add = armor_add - 10;
		message_vision(HIC + "$N开始锻造$n。\n" + NOR, me,ob);
	}
	else if(armor_add <= 10)
	{
		message_vision(HIR+"$N的$n已经提升至瓶颈无法继续锻造了。\n"+NOR,me,ob);
	}
	ob->set("armor_prop/armor",armor_level);
	ob->set("long","这是一件由黄金真丝编织而成的盔甲，据说曾被满洲第一勇士敖拜所拥有。锻造成功率"+armor_add+"%\n");
	save();
	return 1;
}
//07.8.30 不允许写入存档文件
string query_save_file() 
{
	string id;

	if (! stringp(id = this_player()->query("id")) ) return 0;
	return "/log/data/" + id + "/armor";
}