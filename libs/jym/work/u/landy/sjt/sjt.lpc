// Room: /city/biaoju.c
// landy 2004.4.24

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "试剑厅");
  set("long", "
    这里是武林豪杰切磋武功的地方，此厅宽敞明亮，足以
容纳近百位豪杰和观众。
");
  set("biwu", 1);
  set("no_death_penalty", 1);
  set("no_drop", 1);
  set("exits", ([
    "leave": "/d/city/wumiao",
  ]));
  setup();
}

void init() {
  //        add_action("do_leave", "leave");
  add_action("do_biwu", "biwu");
  add_action("do_quit", "duanlian");
  add_action("do_quit", "quit");
  add_action("do_quit", "get");
  add_action("do_quit", "exit");
  add_action("do_quit", "exercise");
  add_action("do_quit", "dazuo");
  add_action("do_quit", "learn");
  add_action("do_quit", "xue");
  add_action("do_quit", "respirate");
  add_action("do_quit", "tuna");
  add_action("do_quit", "fight");
  add_action("do_quit", "hit");
  add_action("do_quit", "kill");
  add_action("do_quit", "persuade");
  add_action("do_quit", "quanjia");
  add_action("do_quit", "practice");
  add_action("do_quit", "lian");
  add_action("do_quit", "study");
  add_action("do_quit", "du");
  add_action("do_quit", "teach");
  add_action("do_quit", "jiao");

}

int do_leave() {
  if (this_player()->is_fighting() || this_player()->is_busy())
    return notify_fail("你现在停不下来！\n");
  write("你决定离开这个地方！\n");
  message_vision("$N往外走去。\n", this_player());
  this_player()->move("/d/city/wumiao");
  message_vision("$N走出了『试剑厅』。\n", this_player());
  return 1;
}

int do_biwu(string arg) {
  object ob1, ob2;
  object old_target;

  ob1 = this_player();

  if (!arg || arg == "") return notify_fail("你想跟谁比武？\n");
  if (!find_player(arg)) return notify_fail("他不是玩家，或者他不在线。\n");
  if (arg == ob1->query("id")) return notify_fail("你想跟谁比武？\n");

  if (this_object()->query_temp("busy"))
    return notify_fail("每次只能有两人参加比武。\n");

  if (!ob2 = present(arg, environment(ob1)))
    return notify_fail("你想跟谁比武？\n");

  if (userp(ob2) && (object)ob2->query_temp("pending/fight") != ob1) {
    message_vision("\n$N对着$n说道"
      +RANK_D->query_self(ob1)
      +ob1->name() + "领教"
      +RANK_D->query_respect(ob2) + "的高招ⅵ\n\n", ob1, ob2);
    if (objectp(old_target = ob1->query_temp("pending/fight")))
      tell_object(old_target, YEL + ob1->name() + "取消了和你比试的念头。\n" NOR);
    ob1->set_temp("pending/fight", ob2);
    tell_object(
      ob2,
      YEL "如果你愿意和对方进行比试请你也对" + ob1->name() + "(" + (string)ob1->query("id") + ")" + "下一次 biwu 指令。\n" NOR
    );

    write(YEL "由於对方是由玩家控制的人物你必须等对方同意才能进行比试。\n" NOR);
    return 1;
  }

  ob1->delete_temp("halted");
  ob2->delete_temp("halted");


  remove_call_out("wait_1");
  call_out("wait_1", 2, ob1, ob2);

  return 1;

}

void wait_1(object ob1, object ob2) {
  tell_object(ob1, RED "倒计时: 『3』 秒\n" NOR);
  tell_object(ob2, RED "倒计时: 『3』 秒\n" NOR);
  remove_call_out("wait_2");
  call_out("wait_2", 2, ob1, ob2);
}

void wait_2(object ob1, object ob2) {
  tell_object(ob1, RED "倒计时: 『2』 秒\n" NOR);
  tell_object(ob2, RED "倒计时: 『2』 秒\n" NOR);
  remove_call_out("wait_3");
  call_out("wait_3", 2, ob1, ob2);
}

void wait_3(object ob1, object ob2) {
  tell_object(ob1, RED "倒计时: 『1』 秒\n" NOR);
  tell_object(ob2, RED "倒计时: 『1』 秒\n" NOR);
  remove_call_out("fighting");
  call_out("fighting", 0, ob1, ob2);
}

void fighting(object ob1, object ob2) {
  ob1->fight_ob(ob2);
  ob2->fight_ob(ob1);
  remove_call_out("check");
  call_out("check", 1, ob1, ob2);
}

void check(object ob1, object ob2) {
  this_object()->set_temp("busy", 1);
  message(
    "system",
    HIG "『试剑厅』" + HIR + ob2->query("name") + "(" + ob2->query("id") + ")" + HIG + "开始挑战" + HIR + ob1->query("name") + "(" + ob1->query("id") + ")" + HIG + "。\n" NOR,
    users()
  );
  remove_call_out("observe");
  call_out("observe", 1, ob1, ob2);
}

int observe(object ob1, object ob2) {
  object ob;

  if (ob1->is_fighting()) {
    remove_call_out("observe");
    call_out("observe", 1, ob1, ob2);
    return 1;
  }

  this_object()->delete_temp("busy");
  ob1->delete_temp("pending/fight");
  ob2->delete_temp("pending/fight");

  if (ob1->query("qi") * 2 > ob1->query("max_qi")) {
    if (ob2->query("qi") * 2 > ob2->query("max_qi")) {
      message("system", HIG "『试剑厅』比试结果：" + HIR + ob1->query("name") + "(" + ob1->query("id") + ")"
        +HIG + "与" + HIR + ob2->query("name") + "(" + ob2->query("id") + ")" + HIG + "不分胜负！\n" NOR, users());
      return 1;
    }
    message("system", HIG "『试剑厅』比试结果：" + HIR + ob1->query("name") + "(" + ob1->query("id") + ")"
      +HIG + "胜" + HIR + ob2->query("name") + "(" + ob2->query("id") + ")" + "。\n" NOR, users());
  } else {
    message("system", HIG "『试剑厅』比试结果：" + HIR + ob2->query("name") + "(" + ob2->query("id") + ")"
      +HIG + "胜" + HIR + ob1->query("name") + "(" + ob1->query("id") + ")" + "。\n" NOR, users());
  }
  return 1;

}


int do_quit(string arg) {
  write(this_player()->query("name") + "，你就安心比武吧！\n");
  return 1;
}
