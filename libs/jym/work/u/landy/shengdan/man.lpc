// 宝石商人
#include <ansi.h>
inherit NPC;

//函数声明
int do_give();

void create() {
  set_name(HIY "圣诞老人" NOR, ({ "christmas man" }));

  set("gender", "男性");
  set("title", HIR "新年快乐" NOR);
  set("long", "一位满脸堆笑的圣诞老人。\n");
  set("no_kill", 1);
  set("no_fight", 1);
  set("no_get", 1);

  set("inquiry", ([
    "圣诞松果": (: do_give :),
  ]));

  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

int do_give() {
  object me, item, obj;

  me = this_player();
  item = present("christmas guo", me);

  if (!item || item->query("mosaic_index") < 66) {
    tell_object(me, "你的松果数量不足哦，需要六百六十个以上才行。\n");
    return 1;
  }

  destruct(item);

  if (obj = new("/clone/shoufei/lingdan1")) {
    obj->move(me);
    tell_object(me, HIY "你获得了聚灵丹。\n" NOR);
    return 1;
  }
  tell_object(me, "聚灵丹制造失败请联系Wiz。\n");
  return 1;
}
