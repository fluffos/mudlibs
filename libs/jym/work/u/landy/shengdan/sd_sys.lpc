//圣诞树系统文件
//2008.12.23

inherit F_DBASE;

//定义宏
#define JOB_TREE "/u/landy/shengdan/tree"

//全局变量
int is_open = 0;

//函数声明
void jump(); //心跳
void add_tree();

//圣诞树出现地点
mapping maps=([
0  : "/d/baituo/dating.lpc",
1  : "/d/taishan/daizong.lpc",
2  : "/d/city/guangchang.lpc",
3  : "/d/lingjiu/damen.lpc",
4  : "/d/shaolin/guangchang1.lpc",
5  : "/d/wudang/sanqingdian.lpc",
6  : "/d/shaolin/hanshui1.lpc",
7  : "/d/xingxiu/xxh2.lpc",
8  : "/d/huashan/square.lpc",
9  : "/d/xueshan/dadian.lpc",
10 : "/d/taihu/nanxun.lpc",
11 : "/d/city/duchang.lpc",
12 : "/d/quanzhou/zhongxin.lpc",
13 : "/d/city/guangchang",
14 : "/d/quanzhou/chengtian.lpc",
15 : "/d/quanzhou/weiyuan.lpc",
16 : "/d/gaibang/ml1.lpc",
17 : "/d/qilian/lanzhou.lpc",
18 : "/d/city/qionghuajie1.lpc",
19 : "/d/huashan/buwei1.lpc",
20 : "/d/taishan/zhangren.lpc",
]);

//初始化
void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "圣诞老人");
        set("id","christmas man");
        jump();
}

//活动开关
int check_job(int index)
{	
	is_open = index;

	//活动开启
	if(index)
	{
		CHANNEL_D->do_channel( this_object(), "sys","圣诞节活动已经开启。\n");
		add_tree();
		return 1;
	}
	else
	{
		CHANNEL_D->do_channel( this_object(), "sys","圣诞节活动已经关闭。\n");
		return 0;
	}
}

void add_tree()
{
	object tree,map_obj;
	int rand,size;
	string path;

	//活动处于关闭期间。
	if(!is_open) return;

	if(tree = new(JOB_TREE))
	{
		size = sizeof(maps);
		rand = random(size);
		path = maps[rand];
		
		//如果地图没有载入，就载入地图。
		if(!map_obj = find_object(path)) map_obj = load_object(path);

		tree->move(map_obj);
		CHANNEL_D->do_channel( this_object(), "chat", sprintf("在『%s』又发现了一颗圣诞树，希望大家帮忙把松果采集回来。\n",map_obj->query("short")));
	}
}

//心跳
void jump()
{
	add_tree();
	call_out("jump",1+random(240));
}
