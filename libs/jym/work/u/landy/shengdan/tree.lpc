//圣诞树
//2008.12.23

#include <ansi.h>

inherit ITEM;

#define SG "/u/landy/shengdan/songguo"

void create()
{
	set_name(BLINK+HIR"圣诞树"NOR, ({ "christmas tree","tree"}) );
	if (clonep())
		set_default_object(__FILE__);
	else
	{
		set("unit", "棵");
		set("no_get",1);
		set("index",1+random(10));
	}
	call_out("dest_obj",240);
	setup();
}

void dest_obj()
{
	destruct(this_object());
}

void init()
{
	add_action("do_zhai","zhai"); 
}

int do_zhai()
{
	object item,ob,me,guo;
	int rand;
	string name;
	
        rand = random(100+random(650));
	ob = this_object();
	me = this_player();
	
	if(me->is_busy())
	{
		tell_object(me,"你现在很忙，无法采摘圣诞松果。\n");
		return 1;
	}
	if(ob->query("index") < 1)
	{
		tell_object(me,"松果已经被采完了。\n");
		return 1;
	}
	if(rand < 10)
	{
		guo = present("christmas guo",me);
		if(!guo)
		{
			if(item = new(SG))
			{
				item->set("name",BLINK+HIR"一个圣诞松果"NOR);
				item->set("mosaic_index",1);
				item->move(me);
				ob->add("index",-1);
				me->start_busy(random(5));
				tell_object(me,HIY"你摘到了一个松果。\n"NOR);
				return 1;
			}
		}
		else
		{
			if(guo->query("amount"))
			{
				guo->set("mosaic_index",guo->query("amount"));
				guo->delete("amount");
			}
			else guo->add("mosaic_index",1);
			name = chinese_number(to_int(guo->query("mosaic_index")));
			guo->set("name",sprintf(BLINK+HIR"%s个圣诞松果"NOR,name));
			tell_object(me,HIY"你摘到了一个松果。\n"NOR);
			return 1;
		}
	}
	else
	{
		tell_object(me,"只差一步就摘到了，加油，加油。\n");
		me->start_busy(random(5));
		return 1;
	}
}
