//Cracked by rock
// exproom.c 经验转换房
// 2009.10.1

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "转换室");
	set("long", @long
这里是方便大家把经验转换为潜能，或者互换的房间。
经验转换潜能说明：10点经验兑换1点潜能。
潜能转换经验说明：1点潜能兑换10点经验。

经验转换潜能相关指令：topot<点数>
潜能转换经验相关指令：toexp<点数>
long
	);
	set("exits", ([
		"north" : "/d/wizard/guest_room",
	]));
	setup();

}

void init()
{
	add_action("do_exp", "topot");
	add_action("do_pot", "toexp");
}

int do_exp(string index)
{
	object me;
	int flag;
	int exp;
	int pot,del_exp;
	
	 me = this_player();
	 flag = to_int(index);
	 exp = me->query("combat_exp");
	
	if(!me || !flag) return 0;

        if(exp < 100000)
	{
                tell_object(me,"对不起你的经验太少不能转换。\n");
		return 0;
	}
        if(exp < flag)
        {
                tell_object(me,"对不起你没有那么多经验。\n");
                return 0;
        }
	if(flag < 10)
	{
		tell_object(me,"请输入10以上的整数。\n");
		return 0;
	}
	if(pot >= me->query("max_potential"))
	{
		tell_object(me,"潜能已经达到上限，无法转换。\n");
		return 0;
	}
	pot = flag/10;
	del_exp = (flag/10)*10;
	
	tell_object(me,sprintf(HIY"本次转换了%d点经验为%d点潜能。\n"NOR,del_exp,pot));
	me->add("combat_exp",-del_exp);
	if(((int)me->query("potential") + pot) >= me->query("max_potential")) me->set("potential",me->query("max_potential"));
	else me->add("potential",pot);
	return 1;
}

int do_pot(string index)
{
	object me = this_player();
	int flag = to_int(index);
	int pot = me->query("potential");
	int exp,del_pot;
	
	if(!me || !flag) return 0;
	
	if(pot < 1)
	{
		tell_object(me,"你的潜能不够本次转换。\n");
		return 0;
	}
	if(flag < 1)
	{
		tell_object(me,"请输入1以上的整数。\n");
		return 0;
	}
        if(me->query("combat_exp") < 100000)
        {
                tell_object(me,"你经验太少不能转换。\n");
                return 0;
        }
    if(me->query("potential") < flag)
    {
                        tell_object(me,"你的潜能没有那么多。\n");
        return 0;
    }
	
	exp = flag*10;
        del_pot = flag;

	tell_object(me,sprintf(HIY"本次转换了%d点潜能为%d点经验。\n"NOR,del_pot,exp));
	me->add("potential",-del_pot);
        me->add("combat_exp",exp);
        me->add("temp_exp",exp);
	return 1;
}
