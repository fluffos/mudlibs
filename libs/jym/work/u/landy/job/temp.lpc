#include <armor.h>
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(RED "续命八丹" NOR, ({"xuming badan", "badan", "dan"}));
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                                set("long", "一件金黄色长袍，普通的任务物品。\n");
                set("unit", "颗");
set("no_drop", "任务物品不能丢弃。\n");
set("no_get", "任务物品不能送人。\n");
set("no_put", "任务物品不能存放在那里面。\n");

                        }
        setup();
}

void init()
{
add_action("do_team","full");
}

int do_team(string arg)
{
        object me;
        me=this_player();

        me->set("qi",me->query("max_qi"));
        me->set("jing",me->query("max_jing"));
        me->set("jingli",me->query("max_jingli"));
        me->set("neili",me->query("max_neili"));

return 1;
}


void owner_is_killed()
{
       destruct(this_object());
}
int query_autoload()
{
       return 1;
}

