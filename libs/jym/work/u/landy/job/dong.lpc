#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
set("short", "山洞");
    set("long", @LONG
时则是越向里面温度越高，山洞四周石壁一片通红，就象是进到了一个大火炉中
一样。
LONG
    );
    set("long1", @LONG
一个比较狭窄的山间石缝,顺着那石缝走了不远,前面出现了一片亮光,石缝的尽头
是一个很大的山洞。
LONG
    );
    set("long2", @LONG
山洞看起来并不大,大约十丈方圆。水潭正在山洞的中央,一些垂直而下的山藤在水
潭表面不高的地方。
LONG
    );
    set("long3", @LONG
只见山洞里到处红彤彤的只是不知光线从哪里来,山洞的四壁上还有许多洞口也是
红彤彤的,也不知通向哪里。
LONG
    );

    set( "item_desc", ([
         "south":     "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
         "north":     "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
         "west" :     "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
         "east" :     "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
         "southeast": "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
         "southwest": "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
         "northeast": "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
         "northwest": "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
         "down": "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
         "up": "从这里望去，远处一片昏暗，还是什么都看不见.....\n",
        ]) );

setup();
}

void init()
{
    object obj;
    object me,room,ob;
     int i,b,c;
b = random(2000);
c = random(50);
        me = this_player();

    add_action("do_exit","save");
    add_action("do_exit","follow");
    add_action("do_exit","quit");
    add_action("do_exit","give");
//    add_action("do_exit","kill");
    add_action("do_exit","halt");
    add_action("do_exit","hit");
    add_action("do_exit","throw");
    add_action("do_exit","fight");
    add_action("do_quit","leave");
    add_action("do_get","get");
remove_call_out("shenshou_die");
call_out("shenshou_die",120);
    if ( !room = find_object(__DIR__"dong") )
          room = load_object(__DIR__"dong");

if (me->query_temp("shenshou") && me->query_temp("shenshou") != "done")
{
for(i=0;i<1;i++)
{
        if (random(250) <2)
        {
ob= load_object ("/u/landy/job/npc/qlong.lpc");
                ob->move("/u/landy/job/dong");
        }
        else if (random(125) <2)
        {
ob= load_object ("/u/landy/job/npc/youzai.lpc");
                ob->move("/u/landy/job/dong");
        }
}

         if ( random(2) > 0 )
         {
            set("exits", ([ 
        "west"      : __FILE__,
        "southeast" : __FILE__,
        ]));
         }
         else
         if ( random(4) > 2 )
         {
                 set( "exits", ([
         "south":     __FILE__,
         "north":     __FILE__,
         "up" :     __FILE__,
         "southeast": __FILE__,
         "northwest": __FILE__,
        ]) ); 
         }

          else
         if ( random(6) > 4 )
         {
                 set( "exits", ([
         "south":     __FILE__,
         "down": __FILE__,
         "northwest": __FILE__,
        ]) ); 
         }
         else
         {
                 set( "exits", ([
         "south":     __FILE__,
         "north":     __FILE__,
         "west" :     __FILE__,
         "east" :     __FILE__,
         "up": __FILE__,
         "southwest": __FILE__,
        ]) ); 
         }

        if ( random(6) >4 )
        {
                room->set("short","洞内");
                room->set("long", (string)room->query("long") );
        }
        else
    if ( random(4) >2 )
        {
                 room->set("short","山洞");
         room->set("long", (string)room->query("long1") );
        }
    else 
    if (random(2) >0 )
        {
                 room->set("short","山洞深处");
         room->set("long", (string)room->query("long2") );
        }
    else 
    room->set("long", (string)room->query("long3") );
}
if (b < c && !this_player()->is_fighting())
{
remove_call_out("shenshou_enter");
call_out("shenshou_enter",1);
}

//else
//{
//           set( "exits", ([
//         "leave" : "/d/city/wumiao.lpc" ]) );
//}
}

/*
void reset() //不更新
{}
*/
int shenshou_enter()
{
remove_call_out("shenshou_die");
this_player()->move(__DIR__"dongxue");
write(HIR+"突然山洞塌方，一块巨石堵住了出口。\n"+NOR);
return 1;
}

int do_exit(string arg)
{
        write("远处传来一阵怪叫，吓得你半死！\n");
        return 1;
}
int do_quit(string arg)
{
object ob;
ob = this_player();
if( ob->is_fighting() || ob->is_busy())
return notify_fail("你现在停不下来！\n");
if( ob->query_temp("shenshou") && ob->query_temp("shenshou") != "done")
return notify_fail("领队怎么可以临阵脱逃！\n");
    write("你决定离开这个地方！\n");
this_player()->move("/d/city/wumiao.lpc");
return 1;
}
int do_get(string arg)
{
if(arg == "qing long")
{
write("什么？\n");
return 1;
}
}

int shenshou_die()
{
if (objectp(present(this_player())) && !this_player()->is_fighting())
{
message_vision(HIY"\n\n青龙一个"+BLINK+HIG"龙腾四海"+NOR+HIY"跃上高空，一道黄光从天空射向$N。\n"NOR,this_player());
this_player()->receive_wound("qi", 9000000, "被青龙震死了");
return 1;
}
return 1;
}
