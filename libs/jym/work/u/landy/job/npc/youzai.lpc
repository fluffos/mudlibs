void create() {
  mapping believe;
  believe = data[random(sizeof(data))];

  set_name(
    surname[random(sizeof(surname))] + firstname[random(sizeof(firstname))],
    ({ believe["id"] })
  );
  set("gender", believe["gender"]);
  set("age", believe["age"]);
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));
  set("per", 24);
  set("str", 26);
  set("con", 30);
  set("dex", 900);
  set("int", 999);

  set("neili", 180000);
  set("max_neili", 180000);
  set("jiali", 10);
  set("max_qi", believe["max_qi"]);
  set("qi", believe["max_qi"]);
  set("max_jing", 800000);
  set("jing", 800000);
  set("combat_exp", believe["combat_exp"]);
  set("shen_type", 1);

  set_skill("jiuyin-baiguzhao", believe["skills_leve"]);
  set_skill("claw", believe["skills_leve"]);
  set_skill("force", believe["skills_leve"]);
  set_skill("parry", believe["skills_leve"]);
  set_skill("dodge", believe["skills_leve"]);
  set_skill("luoying-shenfa", believe["skills_leve"]);
  map_skill("claw", "jiuyin-baiguzhao");
  map_skill("parry", "jiuyin-baiguzhao");
  map_skill("dodge", "luoying-shenfa");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "claw.shenzhua" :),
    (: perform_action, "claw.shenzhua" :),
  }));

  setup();
}

void init() {
  this_object()->kill_ob(this_player());
  this_player()->kill_ob(this_object());
  this_player()->start_busy(random(10));
}

void die() {
  object corpse;
  object where = environment(this_object());

  message_vision(HIR "\n$N惨叫一声。\n" NOR, this_object());
  message_vision("$N迅速的逃开了！\n\n", this_object());
  //corpse = CHAR_D->make_corpse(this_object());
  //corpse->move(where);
  destruct(this_object());
}
