// old.c 老人
//edit by landy
//5007.5.22

inherit NPC;
#include <ansi.h>
#include <mudlib.h>

object leader, member1, member2;

int ask_job();

void create() {
  set_name("老人", ({ "lao ren", "old men", "old", "man" }));
  set("long",
    "一位普通的老人,眼神呆呆的,象是失明的样子,不过他会说很多故事。\n");
  set("gender", "男性");
  set("age", 65);
  set("no_get", 1);
  set_skill("literate", 300);

  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_temp("apply/attack", 80);
  set_temp("apply/defense", 80);
  set_temp("apply/damage", 20);

  set("combat_exp", 400000);
  set("shen_type", 1);
  set("inquiry", ([
    "神兽": (: ask_job :),
  ]));

  setup();

  set("chat_chance", 3);
  set("chat_msg", ({
    "老人说道：来了这么些神兽，要祸害人间喽。\n",
    "老人说道：唉，这天上的神仙日子也不一定好过啊。\n",
    "老人说道：你不相信我吗？\n",
  }));
}


int ask_job() {
  int lv;
  object me, ob, member1, member2;
  object *inv;

  me = this_player();
  inv = all_inventory(environment(me));

  if (me->query_skill("force") < 100) {
    command("say 你的经验太低，无法号令高手前来降妖除魔阿!");
    return 1;
  }
  if (me->query_temp("shenshou") == "done") {
    me->set("shoutime", uptime());
    if (me->query("shenshou") > 60) {
      me->set("potential", me->query("max_potential"));
      message_vision(
        "恭喜$N完成了" + me->query("shenshou") + "次任务，并且获得了" + me->query("max_potential") + "点潜能。\n",
        me
      );
      me->set("shenshou", 0);
      return 1;
    }

    command("say 果然英雄出少年,幸好有你展妖除魔!");
    me->delete_temp("shenshou");
    me->delete_temp("shenshou_skill");
    me->delete_temp("shenshou_member1");
    me->delete_temp("shenshou_member2");
    this_object()->delete("bus");
    me->add("shenshou", 1);
    CHANNEL_D->do_channel(this_object(), "rumor", sprintf("听说%s的队伍完成了挑战。", me->name()));
    message_vision("在$N的领导下成功除灭了妖魔，得到" + me->query("shenshou") + "积分。\n", me);
    return 1;
  }

  if (this_object()->query("bus")) {
    command("say 已经有一队人赶过去了，请您稍候再来。");
    command("say 我也在此守候多时了，不知道是凶是吉。");
    command("say 再等几个时辰老夫便去探探究竟。");
    remove_call_out("old_dest");
    call_out("old_dest", 1200);
    return 1;
  }


  if (me->query_temp("shenshou_skill")) {
    if (!me->query_temp("shenshou_member1") || !me->query_temp("shenshou_member2")) {
      message_vision("老人对$N说：关乎到人间的安危，你这样去太草率了！\n", me);
      return 1;
    } else

    if (objectp(present(me->query_temp("shenshou_member1")))
      && objectp(present(me->query_temp("shenshou_member2")))) {
      member1 = present(me->query_temp("shenshou_member1"));
      member2 = present(me->query_temp("shenshou_member2"));
      if (present("pao", member1) && present("pao", member2)) {
        message_vision("老人对$N说：奇怪你们到底谁是头？\n", me);
        return 1;
      }

      if ((this_player()->query("shoutime") - uptime()) > 600)
        this_player()->set("shoutime", uptime() - 300);

      if ((this_player()->query("shoutime") + 300) > uptime()) {
        message_vision("老人对$N说：你们辛苦了，休息一下。\n", me);
        return 1;
      }
      command("say 那好吧，我告诉你怎么到那里！");
      message_vision("老人对着$N窃窃私语。\n", me);
      tell_object(inv, "你们顺着老人告诉你的方向一直往前走。\n");
      me->move("/u/landy/job/dong");
      member1->move("/u/landy/job/dong");
      member2->move("/u/landy/job/dong");
      this_object()->set("bus", 1);
      CHANNEL_D->do_channel(this_object(), "rumor", sprintf("听说%s的队伍开始挑战神兽任务了。", me->name()));
      return 1;
    } else {
      message_vision("老人对$N说：关乎到人间的安危，你这样去太草率了！\n", me);
      return 1;
    }

  } else if (!present("pao", this_player())) {
    command("say 那我给你讲讲吧，那天我去山洞取我多年前藏的宝藏，
          顺着我当时的路线走，突然遇到了怪物，吓得我连滚 
          带爬的逃了出来，还算运气好，不然今天，我们就不 
          会在此相遇了。");

    command("say 我老了，腿脚不灵便，不能和你一起去除这祸害了，
          我送你件宝贝，你再去找两个帮手，我想这样会安全
          些吧！我在这里静候佳音。");

    ob = new("/u/landy/job/obj/pao");
    ob->move(this_player());

    message_vision("老人给了$N一件战袍！\n", me);
    return 1;
  }

  if (present("pao", this_player())) {
    message_vision("老人对$N说：是来把将军袍还给我的吗？\n", me);
    return 1;
  }

}
int old_dest() {
  object me;
  me = this_object();
  command("say 我也在此守候多时了，不知道是凶是吉。");
  command("say 等老夫先去探探究竟。");
  message_vision("$N往北走了出去。\n", this_object());
  destruct(me);
  return 1;
}
