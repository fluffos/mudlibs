// pao.c
//
// edit by landy 2007.5.21

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIY "将军袍" NOR, ({ "pao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件金黄色长袍，普通的任务物品。\n");
    set("unit", "件");
    set("no_drop", "任务物品不能丢弃。\n");
    set("no_get", "任务物品不能送人。\n");
    set("no_put", "任务物品不能存放在那里面。\n");
    set("material", "pao");
    set("armor_prop/armor", 10);
    set("wear_msg", HIY "只听「哗」的一声，$N展开一件金光闪闪的将军袍披在身上。
\n" NOR);
    set("remove_msg", HIY "$N将将军袍从身上脱了下来。\n" NOR);
  }
  setup();
}

void init() {
  //object me=this_player();

  //if((string)me->query_temp("material") == "pao")
  add_action("do_team", "group");
  add_action("do_cut", "groupkick");
}

int do_team(string arg) {
  object me, ob, obj;
  string id1, id2;

  int skills;
  me = this_player();
  skills = me->query_skill("force");
  id1 = me->query_temp("shenshou_member1");
  id2 = me->query_temp("shenshou_member2");
  me->set_temp("shenshou_skill", skills);
  me->set_temp("shenshou", "qilin");

  if (!arg || arg == 0) return notify_fail("指令格式:group <id> [list] [none] [yes]\n");
  if (!find_player(arg)) return notify_fail("他不是玩家，或者他不在线。\n");
  if (arg == "list") {
    if (id1 == 0) { id1 = "请添加成员。"; }
    if (id2 == 0) { id2 = "请添加成员。"; }
    tell_object(me, "队伍里有:\n" + me->query("id") + "\n\n" +
      id1 + "\n\n" +
      id2 + "\n");
    return 1;
  }
  if (arg == "none") {
    me->set("group", 1);
    return notify_fail("你拒绝加入别人的队伍。\n");
  }
  if (arg == "yes") {
    me->delete("group");
    return notify_fail("你接受其他队伍的邀请。\n");
  }
  if (!ob = present(arg, environment(me))) return notify_fail("没有这个人。\n");
  if (ob->query("id") == me->query("id")) return notify_fail("就你一个人？\n");
  if ((me->query("combat_exp") - ob->query("combat_exp")) > 1000000) return notify_fail("经验值相差太大。\n");
  if (ob->query("id") == me->query_temp("shenshou_member1")
    || ob->query("id") == me->query_temp("shenshou_member2"))
    return notify_fail("他在队伍中。\n");
  if (me->query_temp("shenshou_member1") && me->query_temp("shenshou_member2"))
    return notify_fail("队伍人数已到上限。\n");
  if (ob->query("combat_exp") > me->query("combat_exp"))
    return notify_fail("你无法带领如此一位高手。\n");

  if (!me->query_temp("shenshou_member1") && me->query_temp("shenshou_member1") != 1) {
    if (ob->query_temp("shenshou"))
      return notify_fail("组队失败。\n");
    if (present("pao", ob))
      return notify_fail("组队失败。\n");
    if (ob->query("group"))
      return notify_fail("他拒绝加入你的队伍。\n");
    ob->set_leader(me);
    me->set_temp("shenshou_member1", arg);
    message_vision("$N决定把$n加进队伍。\n", me, ob);
    return 1;
  }
  if (!me->query_temp("shenshou_member2") && me->query_temp("shenshou_member2") != 1) {
    obj = this_object();
    if (ob->query_temp("shenshou"))
      return notify_fail("组队失败。\n");
    if (present("pao", ob))
      return notify_fail("组队失败。\n");
    if (ob->query("group"))
      return notify_fail("他拒绝加入你的队伍。\n");
    ob->set_leader(me);
    me->set_temp("shenshou_member2", arg);
    message_vision("$N决定把$n加进队伍。\n", me, ob);
    destruct(obj);
    return 1;
  }

}
int do_cut(string arg) {
  object me, ob;
  me = this_player();

  if (!arg || arg == 0) return notify_fail("指令格式:groupkick <id>\n");
  if (!ob = present(arg, environment(me))) return notify_fail("你暂时无法把他踢出队伍。\n");
  if (ob->query("id") == me->query("id")) {
    me->delete_temp("shenshou_member1");
    me->delete_temp("shenshou_member2");
    me->delete_temp("shenshou_skill");
    me->delete_temp("shenshou");
    message_vision(HIC + "$N把队伍解散了。\n" + NOR, me);
    return 1;
  }

  if (ob->query("id") == me->query_temp("shenshou_member1")) {
    me->delete_temp("shenshou_member1");
    ob->set_leader(0);
    message_vision("$N决定把$n踢出队伍。\n", me, ob);
    return 1;
  }

  if (ob->query("id") == me->query_temp("shenshou_member2")) {
    me->delete_temp("shenshou_member2");
    ob->set_leader(0);
    message_vision("$N决定把$n踢出队伍。\n", me, ob);
    return 1;
  }
  if (ob->query("id") != me->query_temp("shenshou_member1")
    || ob->query("id") != me->query_temp("shenshou_member2")
    || ob->query("id") != me->query("id"))
    return notify_fail("你队伍中没有这个人。\n");
}
