// dongxue.c
// edit by landy

#include <ansi.h>
#include <command.h>
inherit ROOM;

void create()
{
        set("short", "狭窄的洞穴");
        set("long",
"这里很狭窄，拥挤的让人喘不过气来，必须另寻出路。
"+HIR"请用 exit <出口> 寻找出路"+NOR"\n"
        );
    set("exits", ([
    ]));
        setup();
}

void init()
{
    object room;
int exit,i,b,c;
exit = random(5000);
i = random(2000);
b = random(30);
if ( !room = find_object(__DIR__"dongxue") )
room = load_object(__DIR__"dongxue");

c = (exit+i)*b;
this_player()->set_temp("shouexit",c);
room ->set("exits",([ exit+"加"+i+"乘"+b+"的答案" : __DIR__"dongxue",]));
    add_action("do_quit","exit");
remove_call_out("shenshou_die");
call_out("shenshou_die",120);
}

int do_quit(string arg,int c)
{
if(!arg || arg == 0 ) return notify_fail("指令格式:exit <出口>\n");
if(sscanf(arg, "%d", c) && c == this_player()->query_temp("shouexit"))
{
this_player()->move(__DIR__"dong");
return 1;
}
else {
return notify_fail("这个方向没有出路。\n");
}
return 1;
}

int shenshou_die()
{
if (objectp(present(this_player())) && !this_player()->is_fighting())
{
message_vision(HIY"\n\n青龙一个"+BLINK+HIG"龙腾四海"+NOR+HIY"跃上高空，一道黄光从天空射向$N。\n"NOR,this_player());
//environment(this_player())->receive_damage("qi", 500, "被青龙咬死了");
this_player()->receive_wound("qi", 9000000, "被青龙震死了");
return 1;
}
return 1;
}
