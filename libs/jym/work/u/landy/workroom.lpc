#include <ansi.h>
inherit ROOM;
string look_photo();

void create()
{

set("short",BLINK"系统医生的家"NOR);
set("long",
"想不到一个玩家的我会成为巫师，想不到成为巫师后却只有
我独自消沉。这是一种宿命的空虚。忽然之间你所熟悉的一切已
不再是那么完美了。所有的一切似乎已经和你情同末路，空荡荡
的江湖，我不禁自问jan呢?youlong呢?他们像流星般在一瞬间消
失了,我的一切消失了。"HIC"衣带渐宽终不悔,为伊消得人憔悴。"NOR"为何
我还一直对MUD恋恋不忘?每当狗狗寂寞的时候总会看看桌上的照
片(photo)。
\n");

set("item_desc", ([
"photo" : (: look_photo :),
 ]));

set("objects", ([
//__DIR__"job/npc/old" : 1,
]));
set("exits", ([
"down" : "/d/city/guangchang",
]));

set("valid_startroom", 1);
setup();
}

string look_photo()
{
return
"
→→→→→→→→→→→→→→→→→→→→→→→→→→→→→
　     每当系统医生寂寞的时候总是会看看这幅照片。
←←←←←←←←←←←←←←←←←←←←←←←←←←←←←
"HIC"【桃花山庄正厅】 - "NOR"
    这里是桃花山庄的正厅。整个大厅十分宽阔。厅中挂满了各种
名家的书法真迹。但最显眼的则是正中挂的一幅对联：

            "BLU"桃花影落飞神剑
            碧海潮生按玉箫"NOR"

字体遒劲挺拔，气势宏伟。
    "HIG"这里明显的"+ HIC"【出口】"+ HIG"是west、north、south、up 和  east。"NOR"
  丐帮第十八代弟子「"YEL"【龙门客栈】"+ CYN"伙计"NOR"」"HIG"帅哥"NOR"(showmoney)
  桃花岛第二代弟子「"YEL"【龙门客栈】"+ HIY"打手"NOR"」"HIC"冰河"NOR"(binghe)
  逍遥派第二代弟子「"YEL"【龙门客栈】"+ MAG"掌柜"NOR"」"HIM"宇多田光"NOR"(landy)
  桃花岛弟子留言板(Board) [ 56 张留言 ]
  桃花岛主「"HIY"东邪"NOR"」黄药师(Huang yaoshi)
>
→→→→→→→→→→→→→→→→→→→→→→→→→→→→→
\n";
}
