#include <ansi.h>

inherit ROOM;


void create()
{
	set("short",HIG"擂台"NOR);
	set ("long", @LONG
用来比试武艺的擂台，正前方竖着一排兵器架，台下围满了
热闹的人。
    旁边一个牌子上写着   伤残自治，本处概不负责。
LONG);
	set("invalid_startroom", 1);
  set("biwu_death",1);


		  set("exits", ([
					 "down":__DIR__"kantai",
		  ]));
           set("objects", ([  
//                 "/u/jerry/npc/dashi" : 1,
        ]));

		setup();
}

void init()
{
	add_action("do_disable", "throw");
	add_action("do_disable", "halt");
        add_action("do_disable", "get");
        add_action("do_disable", "drop");
}

int do_disable(string arg)
{
	tell_object(this_player(), "不能在擂台上这样。\n");
	return 1;//notify_fail("不允许在擂台上这样！\n");;
}

int valid_leave(object me, string dir)
{

	if( dir=="down" ) {
		 if (me->is_fighting())
		 return notify_fail("不准溜！\n");
	}

	return ::valid_leave(me, dir);

}
