#include <ansi.h>
inherit NPC;
void create()
{
    set_name("负神之王", ({ "hushen" }));
    set("long", "他是负神之王。\n");
    set("gender", "男性");
    set("age", 53);
        set("shen_type", 0);
    set("attitude", "peaceful");
    set("str", 10);
    set("int", 10);
    set("con", 10);
    set("dex", 10);
    set("qi", 100);
    set("max_qi", 100);
    set("jing", 100);
    set("max_jing",100);
     set("neili",100);
    set("max_neili", 100);
    set("jiali", 1);
    set("combat_exp", 1000);
        create_family("白驼山派",100, "弟子");

    setup();
    
}

