inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("雅典娜", ({ "jsl"}));
        set("long",
        "她是一位白发苍苍的老尼，是峨嵋派第一代大弟子，她脸上冷冰冰，毫无表情。\n");

        set("gender", "女性");
        set("age", 28);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 130);
        set("int", 128);
        set("con", 130);
        set("dex", 130);

        set("qi", 40000);
                set("max_qi", 50000);
        set("jing", 3000);
                set("max_jing",30000);
                set("neili",45000);
        set("max_neili", 40000);
        set("jiali", 600);

        set("combat_exp", 20000000);
        set("score", 300000);

        set_skill("beauty", 1120);
        set_skill("literate", 500);
        set_skill("mahayana", 1120);
        set_skill("persuading", 1120);
        set_skill("claw", 1120);
        set_skill("dodge", 1120);
        set_skill("finger", 1120);
        set_skill("force", 1120);
        set_skill("parry", 1120);
        set_skill("strike", 1120);
        set_skill("sword", 1120);
        set_skill("throwing", 1120);
        set_skill("whip", 1120);
        set_skill("cuixin-zhang", 1120);
        set_skill("emei-jian", 1120);
        set_skill("feiyu-bian", 1120);
        set_skill("jinding-zhang", 1120);
        set_skill("jiuyin-zhao", 1120);
        set_skill("linji-zhuang", 1120);
        set_skill("tiangang-zhi", 1120);
        set_skill("zhutian-bu", 1120);

        map_skill("whip","feiyu-bian");
        map_skill("sword","emei-jian");
        map_skill("strike","cuixin-zhang");
        map_skill("claw","jiuyin-zhao");
        map_skill("dodge","zhutian-bu");
        map_skill("finger","tiangang-zhi");
        map_skill("parry","emei-jian");
        map_skill("force","linji-zhuang");


        create_family("峨嵋派", 2, "大弟子");
        setup();
                                carry_object("/clone/weapon/changjian")->wield();
                                carry_object("/d/city/obj/cloth")->wear();
  }
