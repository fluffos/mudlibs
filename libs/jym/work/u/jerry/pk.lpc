#include <ansi.h>
#include <net/dns.h>
inherit ITEM;
#define IDLE 600
void init() {
  add_action("do_gift", "gift");
}
void create() {
  set_name(HIB "耗子的电击棒" NOR, ({ "Jerry is god" }));
  set_weight(1000);
  set("unit", "个");

  setup();
}
int do_gift(string arg) {
  int count;
  object me, ob;
  string target, gift_file;
  me = this_player();
  if (!arg) return notify_fail("gift 派礼物给在线玩家，命令格式： gift </路径/../目标文件名> <数量>\n\n");
  if (sscanf(arg, "%s %d", target, count) != 2) target = arg;
  gift_file = target + ".lpc";
  if (file_size(gift_file) == -1) return notify_fail("找不到文件" + gift_file + "。\n");
  foreach (object player in users()) {
    if (!environment(player) || player->query_temp("netdead")) continue;
    ob = new(target);
    if (count > 1 && ob->query("base_unit")) ob->set_amount(count);
    ob->move(player);
    tell_object(
      player,
      HIW + "\n福\n\n星\n\n高\n\n照\n" + me->query("name") + "悄悄地在你耳边说道：\n\n" + HIW + "亲哥哥一下，哥哥给你礼物！\n只听见“啵”的一声，你甜甜的亲了" + me->query("name") + "一口！\n" + me->query("name") + "坏坏一笑：真乖，喏，哥哥给你礼物！\n\n突然你手中多了" + ob->name() + NOR + "！\n\n"
    );
  }
  return 1;
}
