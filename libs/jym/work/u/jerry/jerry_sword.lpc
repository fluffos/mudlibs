#include <combat.h> 
#include <ansi.h>
void remove_broken(object ob);

void weapon_material(object me,object target)
{
        string wo, oo, wn, on,  woF, ooF;
        int wm, om, wmF, omF, ws, os, wd, od, qq;

        object ob=target->query_temp("weapon");
        object weapon=me->query_temp("weapon");

        if( !weapon || !ob ) return;

        //如果未给定材质和锋利度，由以下来给定所以都未给定的
        //状态下，武器的初始值给定在300 的值，若能够拿最好的
        //武器，是可以直接砍断对方的武器。
        if( !weapon->query("material") )
        weapon->set("material","iron");
        if( !weapon->query("Fmaterial") )
        weapon->set("Fmaterial","iron");

        if( !ob->query("material") )
        ob->set("material","iron");
        if( !ob->query("Fmaterial") )
        ob->set("Fmaterial","iron");

        //以下取得原来的名称
        if( !weapon->query("bname") ) {
        wn = weapon->query("name");
        weapon->set("bname",wn);
        }
        if( !ob->query("bname") ) {
        on = ob->query("name");
        ob->set("bname",on);
        }
        //以下是武器的材质    
        wo = weapon->query("material");
        oo = ob->query("material");
        woF = weapon->query("Fmaterial");
        ooF = ob->query("Fmaterial");
        if( !woF) woF = wo;
        if( !ooF) ooF = oo;
/**************************************************************************************************/

        switch(wo) {
        case "异类金属":          wm=150;  break;
        case "crimsonsteel": wm=100;  break;//丹金
        case "blacksteel":   wm=90;   break;//玄铁
        case "gem":          wm=80;   break;//宝石
        case "gold":         wm=70;   break;//金
        case "silver":       wm=60;   break;//银
        case "steel":        wm=50;   break;//钢
        case "brass":        wm=45;   break;//黄铜
        case "copper":       wm=40;   break;//铜
        case "iron":         wm=35;   break;//铁
        case "wood":         wm=30;   break;//木
        case "bone":         wm=25;   break;//骨
        case "bamboo":       wm=20;   break;//竹子
        case "leather":      wm=15;   break;//皮革
        case "fur":          wm=10;   break;//毛皮
        case "cloth":        wm=5;    break;//布
        default:             wm=1;    break;
        }

        switch( woF) {
        case "异类金属":          wmF=150;  break;
        case "crimsonsteel": wmF=100;  break;//丹金
        case "blacksteel":   wmF=90;   break;//玄铁
        case "gem":          wmF=80;   break;//宝石
        case "gold":         wmF=70;   break;//金
        case "silver":       wmF=60;   break;//银
        case "steel":        wmF=50;   break;//钢
        case "brass":        wmF=45;   break;//黄铜
        case "copper":       wmF=40;   break;//铜
        case "iron":         wmF=35;   break;//铁
        case "wood":         wmF=30;   break;//木
        case "bone":         wmF=25;   break;//骨
        case "bamboo":       wmF=20;   break;//竹子
        case "leather":      wmF=15;   break;//皮革
        case "fur":          wmF=10;   break;//毛皮
        case "cloth":        wmF=5;    break;//布
        default:             wmF=1;    break;
        }

        switch(oo) {
        case "异类金属":          om=150;  break;
        case "crimsonsteel": om=100;  break;//丹金
        case "blacksteel":   om=90;   break;//玄铁
        case "gem":          om=80;   break;//宝石
        case "gold":         om=70;   break;//金
        case "silver":       om=60;   break;//银
        case "steel":        om=50;   break;//钢
        case "brass":        om=45;   break;//黄铜
        case "copper":       om=40;   break;//铜
        case "iron":         om=35;   break;//铁
        case "wood":         om=30;   break;//木
        case "bone":         om=25;   break;//骨
        case "bamboo":       om=20;   break;//竹子
        case "leather":      om=15;   break;//皮革
        case "fur":          om=10;   break;//毛皮
        case "cloth":        om=5;    break;//布
        default:             om=1;    break;
        }

        switch(ooF) {
        case "异类金属":          omF=150;  break;
        case "crimsonsteel": omF=100;  break;//丹金
        case "blacksteel":   omF=90;   break;//玄铁
        case "gem":          omF=80;   break;//宝石
        case "gold":         omF=70;   break;//金
        case "silver":       omF=60;   break;//银
        case "steel":        omF=50;   break;//钢
        case "brass":        omF=45;   break;//黄铜
        case "copper":       omF=40;   break;//铜
        case "iron":         omF=35;   break;//铁
        case "wood":         omF=30;   break;//木
        case "bone":         omF=25;   break;//骨
        case "bamboo":       omF=20;   break;//竹子
        case "leather":      omF=15;   break;//皮革
        case "fur":          omF=10;   break;//毛皮
        case "cloth":        omF=5;    break;//布
        default:             omF=1;    break;
        }
/**************************************************************************************************/

        //以下是武器的锋利度
        ws = weapon->query("sharp");
        os = ob->query("sharp");
        
        if( !ws) ws = wmF;
        if( !os) ws = omF;

        //武器的等级用(材质)*(锋利度)来定义
//        wd = (wm+wmF) * ws;
        wd = wm * ws;
        if( wd > 1000 ) wd=1000;
//        od = (om+omF) * os;
        od = om * os;
        if( od > 1000 ) od=1000;
        qq = random( wd-od );
/**************************************************************************************************/

        //强制设定只要差距大于850，就直接砍断对方的武器，机率设在1/3左右
        if( random(10) > 7 && (wd - od > 850) ) {
        if( !ob->query("no_break") ) {
        message_vision(BLINK HIW"$N的"+weapon->name()+BLINK HIW"「唰」地一声，把$n"HIW"的"+
        ob->name()+BLINK HIW"削成两段！\n"NOR, me, target);
        ob->unequip();
        ob->move(environment(target));
        ob->set("name", "(断毁两段)" + ob->query("name"));

        if(ob->query("keep_this"))
        ob->delete("keep_this");
        if(ob->query("keepto"))
        ob->delete("keepto");

        ob->set("value", 0);
        ob->set("liquid", 0);
        ob->set("weapon_prop/damage",0);
        ob->set("weapon_prop", 0);
        ob->set("no_weapon", 1);
        target->reset_action();
        remove_call_out("remove_broken");
        call_out("remove_broken", random(60)+30,ob);
        }
        }else{
        //在这个范围内，因为武器等级差距甚大，所以会有较大的机会伤害对方武器
        //差距愈大，对方武器愈有机会受损 (0.67 - 0.3 )之间
        if( qq > 280 && (wd-od < 850 && wd-od > 400) ) {
        if( !ob->query("no_break")) {
          ob->unequip();
          message_vision(HIR"$N的"+weapon->name()+HIR"把$n"HIR"的"+ob->name()+HIR
"重重的磕出了一个严重的缺口！\n"NOR,me,target);
        if( wizardp(target) ) {
          message_vision(HIG"武器攻击有效值：$N"+wd+"，$n"+od+"。\n"NOR,me,target);
        }
          ob->add("bad",1);
                ob->add("lost_prop",2);

                if(ob->query("keep_this"))
                ob->delete("keep_this");
                if(ob->query("keepto"))
                ob->delete("keepto");

            if( ob->query("weapon_prop/damage") == 1 )
            ob->set("name", HIR"(极尽崩碎的)"NOR + ob->query("bname"));
            if( ob->query("weapon_prop/damage") == 2 )
            ob->set("name", HIR"(极尽崩碎的)"NOR + ob->query("bname"));
            if( ob->query("bad") == (int)ob->query("max_weapon")/3 )
            ob->set("name", "(严重损坏的)" + ob->query("bname"));
            if( ob->query("bad") == (int)ob->query("max_weapon")/4 )
            ob->set("name", "(残破不堪的)" + ob->query("bname"));
            if( ob->query("bad") == (int)ob->query("max_weapon")/5 )
            ob->set("name", "(不堪使用的)" + ob->query("bname"));
            if( ob->query("bad") == (int)ob->query("max_weapon")/6 )
            ob->set("name", "(崩碎多处的)" + ob->query("bname"));
            if( ob->query("bad") == (int)ob->query("max_weapon")/7 )
            ob->set("name", "(尚堪使用的)" + ob->query("bname"));
            if( ob->query("bad") == (int)ob->query("max_weapon")/8 )
            ob->set("name", "(多处裂痕的)" + ob->query("bname"));
            if( ob->query("bad") == (int)ob->query("max_weapon")/9 )
            ob->set("name", "(小有裂痕的)" + ob->query("bname"));
            if( ob->query("bad") == (int)ob->query("max_weapon")/9 )
            ob->set("name", "(轻微裂痕的)" + ob->query("bname"));
            if( ob->query("bad") == (int)ob->query("max_weapon")/10 )
            ob->set("name", "(轻微缺口的)" + ob->query("bname"));
            if( ob->query("bad") == 2 )
            ob->set("name", "(轻微受损的)" + ob->query("bname"));
            if( ob->query("weapon_prop/damage") >=2 ) {
            ob->add("weapon_prop/damage",-2);
            ob->wield();
            }else{
        message_vision(HIW"$n"HIW"的"+ob->name()+HIW"再也承受不住攻击完全断毁了！\n"NOR,me,target);
                ob->move(environment(target));
                ob->set("name", WHT"(完全断毁的)"NOR + ob->query("bname"));
                if(ob->query("keep_this"))
                ob->delete("keep_this");
                if(ob->query("keepto"))
                ob->delete("keepto");
                ob->set("value", 0);
                ob->set("liquid", 0);
                ob->set("weapon_prop", 0);
                ob->set("weapon_prop/damage",0);
                ob->set("no_weapon", 1);
                target->reset_action();
                remove_call_out("remove_broken");
                call_out("remove_broken", random(60)+30,ob);
                }
                }
          }else{
        // 武器等级差距较小，但仍然能伤害对方的武器
        // 差距愈大，对方武器愈有机会受损 (0.625 - 0.25)之间
            if( qq > 150 && (wd-od < 400 && wd-od > 200) ) {
        if( !ob->query("no_break")) {
            ob->unequip();
            message_vision(HIY"$N"HIY"的"+weapon->name()+HIY"把$n"HIY"的"+ob->name()+HIY
"轻轻的磕砍出了一个小缺口!\n"NOR,me,target);
        if( wizardp(target) ) {
          message_vision(HIG"武器攻击有效值：$N"+wd+"，$n"+od+"。\n"NOR,me,target);
        }

                if(ob->query("keep_this"))
                ob->delete("keep_this");
                if(ob->query("keepto"))
                ob->delete("keepto");

                ob->add("lost_prop",1);
              if( ob->query("weapon_prop/damage") ==  1 )
              ob->set("name", HIR"(极尽崩碎的)"NOR + ob->query("bname"));
              if( ob->query("weapon_prop/damage") ==  2 )
              ob->set("name", HIR"(极尽崩碎的)"NOR + ob->query("bname"));
              if( ob->query("lost_prop") ==  (int)ob->query("max_weapon")/3 )
              ob->set("name", "(严重损坏的)" + ob->query("bname"));
              if( ob->query("lost_prop") ==  (int)ob->query("max_weapon")/4)
              ob->set("name", "(残破不堪的)" + ob->query("bname"));
              if( ob->query("lost_prop") ==  (int)ob->query("max_weapon")/5 )
              ob->set("name", "(不堪使用的)" + ob->query("bname"));
              if( ob->query("lost_prop") ==  (int)ob->query("max_weapon")/6 )
              ob->set("name", "(崩碎多处的)" + ob->query("bname"));
              if( ob->query("lost_prop") ==  (int)ob->query("max_weapon")/7 )
              ob->set("name", "(尚堪使用的)" + ob->query("bname"));
              if( ob->query("lost_prop") ==  (int)ob->query("max_weapon")/8 )
              ob->set("name", "(多处裂痕的)" + ob->query("bname"));
              if( ob->query("lost_prop") ==  (int)ob->query("max_weapon")/9 )
              ob->set("name", "(小有裂痕的)" + ob->query("bname"));
              if( ob->query("lost_prop") ==  (int)ob->query("max_weapon")/9 )
              ob->set("name", "(轻微裂痕的)" + ob->query("bname"));
              if( ob->query("lost_prop") ==  (int)ob->query("max_weapon")/10 )
              ob->set("name", "(轻微缺口的)" + ob->query("bname"));
              if( ob->query("lost_prop") == 1 )
              ob->set("name", "(轻微受损的)" + ob->query("bname"));
            if( ob->query("weapon_prop/damage") > 0 ) {
              ob->add("weapon_prop/damage",-1);
              ob->wield();
              }else{
              message_vision(HIW"$n"HIW"的"+ob->name()+HIW"再也承受不住攻击碎裂断毁了！\n"NOR,me,target);
              ob->move(environment(target));
              ob->set("name", WHT"(碎裂断毁的)"NOR + ob->query("bname"));
                if(ob->query("keep_this"))
                ob->delete("keep_this");
                if(ob->query("keepto"))
                ob->delete("keepto");

              ob->set("value", 0);
                ob->set("liquid", 0);
                ob->set("weapon_prop", 0);
              ob->set("weapon_prop/damage",0);
                ob->set("no_weapon", 1);
              target->reset_action();
                remove_call_out("remove_broken");
                call_out("remove_broken", random(60)+30,ob);
                }
              }
            }else{
                //以下武器等级相当，所以不再会伤害对方武器
              if( qq > 75 && (wd-od < 200 && wd-od > 100) ) {
              message_vision(HIG"$n"HIG"只觉得手中"HIY+ob->name()+HIG"被"HIW+weapon->name()+HIG
"一震，险些脱手飞出!\n"NOR,me,target);
                  }else{
                    if( qq > 25 && (wd-od < 100 && wd-od > 50) ) {
                message_vision(HIW"$N"HIW"的"HIY+weapon->name()+HIW"和$n"HIG"的"HIW+ob->name()+HIW
"相击，冒出点点的"HIR"火星\n"NOR,me,target);
                }else{
                  if( random(10) > 5 && (wd == od) ) {
                  message_vision(HIM"$N"HIM"的"HIY+weapon->name()+HIM"和$n"HIM"的"HIW+ob->name()+HIM
"相击，发出响亮清脆的声音。\n"NOR,me,target);
                  }
                }
              }
            }
          }
        }
}

void remove_broken(object ob)
{
        if(ob && environment(ob)) {
            tell_object(environment(ob),"一阵微风吹过，"+ob->name()+"化为片片碎屑，消失不见了。\n");
        destruct(ob);
        }
}