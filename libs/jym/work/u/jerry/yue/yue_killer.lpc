// Code of ShenZhou
// npc: /d/city/npc/ftb_killer.c
// Chu 2/10/99

#include <ansi.h>
inherit NPC;

//#include "/task/yuejob/auto_perform.h"
#include <npc/auto_perform.h>

string ask_cike();
int ask_move();

void create() {
  set_name("一个男人", ({ "male", "nanren" }));
  set("title", HIM "采花贼" NOR);
  set("long", "这只是一个男人而已。\n");
  set("age", 32);
  set("str", 23);
  set("dex", 30);
  set("con", 23);
  set("int", 23);
  set("shen_type", -1);

  set("max_qi", 300);
  set("max_jing", 100);
  set("neili", 200);
  set("max_neili", 200);

  set("no_refresh", 1);

  set("chat_chance", 10);
  set("chat_msg", ({
    "嘿嘿，丽春院的小妞真够劲~~昨晚弄得老子腿都软了！\n",
    "岳小玫你知道吧？这娘们身材真好，要能让大爷上一次就算死了也值得！\n",
    (: random_move :)
  }));

  set("inquiry", ([
    "漂亮美眉": "嘿嘿，漂亮美眉是用来看的吗？",
    "岳小玫": (: ask_move :),
    "采花贼": (: ask_cike :)
  ]));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));

  setup();
  //carry_object("/clone/armor/beixin")->wear();
  remove_call_out("self_destruct");
  call_out("self_destruct", 1200);

  carry_object("/clone/armor/beixin")->wear();

}

void self_destruct() {
  object me = this_object();
  message("vision", name(1) + "急急忙忙地离开了。\n", environment(me), me);
  destruct(me);
}

void die() {
  mixed killer;
  int kar, exp, pot, over_time;

  killer = query_temp("last_damage_from");
  if (stringp(killer)) killer = (object)find_player((string)killer);
  if (objectp(killer)) {
    if (killer->query("id") == query("player_name")) {
      kar = killer->query("kar");
      kar = (kar * 2 + random(kar)) / 2;
      over_time = 60 - (time() - (int)killer->query("noask/yuejob_next"));
      if (over_time < 1) over_time = 1;
      exp = 300 + kar + over_time * 3;
      pot = exp * 80 / 100;

      //1%得到julingdan
      if (random(1000) == 1) {
        this_player()->carry_object("/clone/shoufei/lingdan1");
        write("您意外获得了聚灵魂丹。");
        JOB_GIFTD->job_gift(killer, ([ "combat_exp": exp, "potential": pot ]),
          ([ "job_name": "yuejob", "job_name_cn": "杀采花贼", "job_time_limit": 30, ]));
        killer->delete("yuejob");
        killer->delete_temp("yue_name");
      } else {
        JOB_GIFTD->job_gift(killer, ([ "combat_exp": exp, "potential": pot, ]),
          ([ "job_name": "yuejob", "job_name_cn": "杀采花贼", "job_time_limit": 30, ]));
        killer->delete("yuejob");
        killer->delete_temp("yue_name");
      }

    }
  }
  ::die();
}

string ask_cike() {
  object player = this_player();
  if (query("player_name") == player->query("id")) {
    return "老子怎么越看越觉得你像是个采花贼呢?";
  } else {
    return "青天白日的, 哪里有什么采花贼? 真是笑话.";
  }
}

int ask_move() {
  object player, room;
  mapping exits;
  string *dirs;

  player = this_player();
  if (query("player_name") == player->query("id")) {
    room = environment(this_object());
    exits = room->query("exits");
    dirs = keys(exits);
    command("say 好家伙，真来了啊，好怕怕啊。");
    command("go " + dirs[random(sizeof(dirs))]);
    return 1;
  } else {
    return 0;
  }
}
