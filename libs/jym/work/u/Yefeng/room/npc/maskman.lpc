inherit NPC;

void create()
{
        set_name("蒙面人", ({ "mengmian ren","ren","mengmian" }) );
	set("gender", "男性");
	set("age", 25+random(25));
	set("long",
                "他一身正气！\n");
	set("combat_exp", 5000);
        set("shen_type", 500);
	set("attitude", "heroism");
	set("wimpy", 30);

	set("chat_chance", 5);
	set("chat_msg", ({
	}) );

	setup();

	carry_object("/clone/misc/cloth")->wear();
	add_money("silver", random(10));
}

