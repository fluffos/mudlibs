  set("short", HIW "\n\n            天     帝     雷     庭" NOR);
  set("long", HIR "\n\n"
    " \t灭                              亡\n"
    " \t魑                              牛\n"
    " \t魅                              鬼\n"
    " \t魍                              蛇\n"
    " \t魉                              神\n\n"
  );
  set("exits", ([
    "out": "/d/city/guangchang",
  ]));

