int ask_job(object me)
{
	int i, myexp, rebirth_num;
	int needexp;
	object *inv, link_ob;
	object job_data;

	me = this_player();

	rebirth_num = me->query("rebirth");
	if (rebirth_num >= 5) //重生次数
	{
		write(HIR"\n你已经无法再获得重生了！\n"NOR);
		return 1;
	}

	switch (rebirth_num){
		case 0:
			needexp = 4500000;
		break;
		case 1:
			needexp = 5700000;
		break;
		case 2:
			needexp = 6700000;
		break;
		case 3:
			needexp = 7500000;
		break;
		case 4:
			needexp = 8000000;
		break;
	}

	if (needexp < 4500000) 
			needexp = 4500000;

	myexp = me->query("combat_exp");
	if (myexp < needexp)
	{
		write(HIR"\n你的实战经验不够无法获得重生！\n"NOR);
		return 1;
	}
//开始了
	if( me->query("family/master_id")=="feng qingyang" )
		CHAR_D->break_relation(this_object());

	//清除fj数据
	if(!job_data=find_object("/clone/obj/job/job_data"))
			job_data=new("/clone/obj/job/job_data");
	job_data->detract_job_data(me->query("name"));
	job_data->save();

	MARRY_D->break_marriage(me); //离婚

	do_clear_attrib(me);

	do_clear_skill(me); //清除武功

	do_set_attrib(me); //设置重生后的属性

	inv =  all_inventory(me);
	for (i = 0; i < sizeof(inv); i++)
		destruct(inv[i]);
//		DROP_CMD->do_drop(me, inv[i]);

//	CHANNEL_D->do_channel( this_object(), "rumor",sprintf("听说%s(%s)已经重获新生、投胎转世了。", me->name(),me->query("id")));
	CHANNEL_D->do_channel(this_object(), "chat", sprintf("%s，今日老僧便助你打通生死玄关吧！\n\n", me->name(), this_object()->name(1)));
	CHANNEL_D->do_channel( this_object(), "rumor",sprintf("听说%s(%s)已经打通生死玄关重获新生、投胎转世去了。\n", me->name(),me->query("id")));

	tell_object(me,HIR"你已经获得了重生，请重新登陆！\n"NOR);
	me->save();
//    "/cmds/usr/quit"->main(me);
	"/cmds/adm/qout.lpc"->slow_quit(me);

    return 1;
}

int do_clear_attrib(object user)
{
	mapping my, myd; 
	string *sname;
	int i, temp;
	string *no_clear_list = ({
		"actions",
		"id",
		"race",
		"default_actions",
		"registered",
		"name",
		"channels",
		"env",
		"str",
		"int",
		"con",
		"dex",
		"kar",
		"per",
		"gender",
		"language",
		"rebirth",
	});

	user =this_player();

	my = user->query_entire_dbase();
	sname = keys(my);

	temp = sizeof(my);
	for (i = 0; i < temp; i++)
		if ( member_array(sname[i], no_clear_list) == -1 )
				map_delete(my, sname[i]);

	my["max_qi"] = 200;
	my["max_jing"] = 200;
	my["eff_qi"] = 100;
	my["eff_jingli"] = 0;
	my["max_jingli"] = 200;
	my["max_neili"] = 200;
	my["jiali"] = 0;
	my["jiajin"] = 1;
	my["food"] = 300;
	my["water"] = 300;
	my["month"] = 1;

	my["MKS"] = 0;
	my["PKS"] = 0;
	my["shen"] = 0;
	my["death_count"] = 0;
	my["shen_type"] = 0;
	my["betrayer"] = 0;
	my["balance"] =1000000;
	my["title"] ="普通百姓";
	my["quest_exp"] = 140;
	my["mud_age"] =400000;
    my["birthday"] = time();
	my["behavior_exp"] = 0;
	my["combat_exp"] = 1000;
    my["potential"] = 99;
    my["newbie"] = "yes";
	my["xkd/hosted"] = 1;
	my["pighead"] = 0;

	my["startroom"] = "/d/welcome/welcome";
	return 1;

}

int do_clear_skill(object me)
{
	mapping skill_status;
	int i,temp;
	string *sname;
	object ring;
//	me = this_player();


	me->clear_condition();
	if (mapp(skill_status = me->query_skills()))//判断自己是否有功夫，如有将用这个函数全部删除
	{
		skill_status = me->query_skills();
		sname = keys(skill_status);//传回所有自己的功夫阵列

		temp = sizeof(skill_status);
		for (i = 0; i < temp; i++)
		me->delete_skill(sname[i]);//删除自己所有功夫
	}

	me->map_skill("unarmed");
	me->map_skill("hammer");
	me->map_skill("blade");
	me->map_skill("stick");
	me->map_skill("staff");
	me->map_skill("club");
	me->map_skill("throwing");
	me->map_skill("parry");
	me->map_skill("dodge");
	me->map_skill("kick");
	me->map_skill("axe");
	me->map_skill("whip");	
	me->map_skill("finger");
	me->map_skill("hand");	
	me->map_skill("cuff");	
	me->map_skill("claw");	
	me->map_skill("strike");	
	me->map_skill("force");
	me->map_skill("sword");

	me->prepare_skill("unarmed");
	me->prepare_skill("hammer");
	me->prepare_skill("blade");
	me->prepare_skill("stick");
	me->prepare_skill("staff");
	me->prepare_skill("club");
	me->prepare_skill("throwing");
	me->prepare_skill("parry");
	me->prepare_skill("dodge");
	me->prepare_skill("kick");
	me->prepare_skill("axe");
	me->prepare_skill("whip");	
	me->prepare_skill("finger");
	me->prepare_skill("hand");	
	me->prepare_skill("cuff");	
	me->prepare_skill("claw");	
	me->prepare_skill("strike");	
	me->reset_action();
	return 1;
}

int do_set_attrib(object me)
{
	int rebirthNUM;
	int add_attrib;
	int basic_attrib = 15;
//	me = this_player();

	rebirthNUM = me->query("rebirth");
	if (rebirthNUM >= 5) return 1;

	switch (rebirthNUM){
		case 0:
			basic_attrib = 45;
			add_attrib = 15;
		break;
		case 1:
			basic_attrib = 57;
			add_attrib = 12;
		break;
		case 2:
			basic_attrib = 67;
			add_attrib = 10;
		break;
		case 3:
			basic_attrib = 75;
			add_attrib = 8;
		break;
		case 4:
			basic_attrib = 80;
			add_attrib = 5;
		break;
	}
	me->set("rebirth", rebirthNUM + 1);

	if ( me->query("per") + add_attrib > basic_attrib)
		me->set("per",basic_attrib);
	else me->set("per",me->query("per") + add_attrib);

	if ( me->query("str") + add_attrib > basic_attrib)
		me->set("str",basic_attrib);
	else me->set("str",me->query("str") + add_attrib);

	if ( me->query("dex") + add_attrib > basic_attrib)
		me->set("dex",basic_attrib);
	else me->set("dex",me->query("dex") + add_attrib);

	if ( me->query("int") + add_attrib > basic_attrib)
		me->set("int",basic_attrib);
	else me->set("int",me->query("int") + add_attrib);

	if ( me->query("con") + add_attrib > basic_attrib)
		me->set("con",basic_attrib);
	else me->set("con",me->query("con") + add_attrib);

	if ( me->query("kar") + add_attrib > basic_attrib)
		me->set("kar",basic_attrib);
	else me->set("kar",me->query("kar") + add_attrib);

	if (me->query("gender") =="无性")
	{
		me->set("gender", "男性");
	}
	return 1;
}