#include <ansi.h>

inherit NPC;
string ask_me();
void create() {
  set_name("金庸", ({ "jin yong", "jin" }));
  set("title", HIR "金庸梦春节特派大使" NOR);
  set("nickname", HIM "祝大家新年好！" NOR);
  set_color("$YEL$");
  set("gender", "男性");
  set("age", 68);
  set("long", YEL "这位是〖金庸梦〗的使者，向他打听“新年好”，他会带给您一份新年的惊喜。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 1000000);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("max_neili", 100000);
  set("score", 100000);

  set("inquiry", ([
    "新年好": (: ask_me :),

  ]));
  setup();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}

void greeting(object ob) {
  if (!ob || environment(ob) != environment() || ob->query("猪年")) return;
  command("newyear " + ob->query("id"));
}

string ask_me() {
  int exp;
  object me = this_player();

  if (!me->query("猪年")) {
    exp = random(4) * 10000;
    exp += 90000;
    me->set("猪年", 1);
    me->add("combat_exp", exp);
    me->add("potential", exp / 2);
    me->set("water", me->max_water_capacity() * 10);
    me->set("food", me->max_food_capacity() * 10);
    command("slogan2");
    write("\n" YEL + "金庸" + NOR + HIW "话音刚落，突然天空中一道"
      +HIM "七" HIY "彩" HIR "霞" HIC "光" HIW "笼罩四方，转瞬即逝！\n\n" NOR);
    return "祝各位" + HIR + "新年好！" + NOR + "\n";
  }

  command("newyear " + me->query("id"));
  return "新年好，新年好。\n";
}
