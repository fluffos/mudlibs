//#pragma optimize all

#include <ansi.h>
//#include <localtime.h>

inherit F_DBASE;

void auto_save(int duration);

void create()
{
	seteuid(getuid());
	set("name", "内存精灵");
	set("channel_id", "内存精灵");
	set("id", "autosave");

	CHANNEL_D->do_channel( this_object(), "sys", "自动存盘已经启动。\n");

	remove_call_out("auto_save");
	call_out("auto_save", 10, 0);
}

void auto_save(int duration)
{
	int i,hp,mp,pp;
	object *ob, link_ob;
	string id, *alpha =
 ({ "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m",
    "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z" });

	seteuid(getuid());

	ob=users();
	i=sizeof(ob);
	while(i--) {
		id = (string) ob[i]->query("id");
		if (!id) continue;

		if( id[0..0] != alpha[2*duration] &&
		    id[0..0] != alpha[2*duration+1] )   continue;

		if(!environment(ob[i]) )        continue;
		if( !objectp(link_ob = ob[i]->query_temp("link_ob")) )  continue;

		if(hp = ob[i]->query_temp("apply/hp")) ob[i]->add("max_qi",-hp);
		if(mp = ob[i]->query_temp("apply/mp")) ob[i]->add("max_neili",-mp);
//		pp = ob[i]->query_temp("apply/pp");

		link_ob->save();
		ob[i]->save();

        	if(hp) ob[i]->add("max_qi",hp);
        	if(mp) ob[i]->add("max_neili",mp);

                tell_object(ob[i],HIG "【系统】提示：您的资料已自动存盘了。\n" NOR);
	}
	CHANNEL_D->do_channel( this_object(), "sys",
	                       sprintf("系统自动清除 " + reclaim_objects() + " 个变数。\n"));
	duration ++;
	if(duration >= sizeof(alpha)/2 )        duration = 0;

       remove_call_out("auto_save");
	call_out("auto_save", 480+random(120), duration); //轮一次的时间是35*13
}