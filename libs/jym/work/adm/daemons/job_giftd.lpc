// ------------------------------------------------------------
// 标准 job 奖励物件。此物件提供标准函数，让整个MUD里的任何需要对玩家进行奖励
// 的程序统一调用，以获得加成、削减等统一的过滤。此外，加上统一的 log，以备查询。
// 统一了这个功能之后，可以实现很多效果，例如：
// ◆特别的宝物能够让你的收益提高；
// ◆频繁地做同一任务会导致收益下降；
// ◆特定的日子可以对玩家进行奖励；
// ◆统一地调整收益的幅度；
// ◆………………其它。
// job_giftd.c   by naihe 05-5-18 17:13 for 神州
// ------------------------------------------------------------
// 附加说明：
// 1、放置于 /adm/daemons/ 下，以保证建立 /log/ 下目录时的权限。
// 2、需要定义全局宏： JOB_GIFTD
// 3、不能 clean_up 。
// ------------------------------------------------------------

#include <ansi.h>

// ---[ 变量 ]-------------------------------------------------
#define              LOG_FILE_PATH                     "job_gift/"  // log 文件位置

#define              NO_ALL_GIFT                            0            // 定义为 1 时，不进行任何奖励！给特殊的情况需要备用。默认0
#define              NO_TIME_MODIFY                     0            // 定义为 1 时，不进行任务时间上的修正。建议不使用。默认0
#define              STD_GIFT_LIMIT                     0            // 定义为 1 时，只能奖励 std_gift_cname 里的类型。默认0

#define              SPECIAL_OBJ_ADD_ALL              1            // 定义为 1 时，允许任何特殊物件进行奖励加成。默认1
#define              SPECIAL_OBJ_ADD_TYPE       1            // 加成方式。
                                                 // 1：所有身上携带的可以加成的数值允许累加，包括增加及减少。
                                                 // 0：不允许累加，但取最高值，只算增加的。
#define              GIFT_MODIFY_ALL         0            // 定义为 1 时，对所有奖励进行最终的强制调整。默认1

// 单独设置是否允许物件对某种 dbase data 进行加成。(定义 SPECIAL_OBJ_ADD_ALL 非零时有效)
// 物件加上函数： mapping query_job_gift_add() ，返回例如：([ "combat_exp":10 ]) 就是增加 10% 的EXP收益。
mapping special_obj_add = ([ 
       "combat_exp" : 1,       // 在定义了 SPECIAL_OBJ_ADD_ALL 的情况下，
                        //   允许物件对 combat_exp 这个 dbase data 进行加成。
                        //   具体加成的幅度，看 obj 设置而定。
       "potential"  : 1,   // 道理同上
       "menpai_zc"  : 1,   // 道理同上
       "shenzhou/pts": 1,  // 道理同上
	   "gf_job": 1,
	   "quest_exp": 1,
]);
// 单独设置是否允许系统对某种 dbase data 进行最终的调整。(定义 GIFT_MODIFY_ALL 非零时有效)
mapping gift_modify_percent = ([
       "combat_exp" : 100,       // 在定义了 GIFT_MODIFY_ALL 的情况下，
                           //   最终对 combat_exp 这个 dbase data 进行一个强制调整。
                           //   而这里设置的数字，即调整的百分率。例如 50 则只能获得一半奖励，200 就是两倍奖励。
       "potential"  : 100, // 道理同上
       "menpai_zc"  : 100, // 道理同上
       "shenzhou/pts": 100,// 道理同上
	   "gf_job": 100,
	   "quest_exp": 100,
]);
// 标准奖励数据的中文描述。
mapping std_gift_cname = ([
       "combat_exp" : "实战经验值",
       "potential"  : "潜能点",
       "menpai_zc"  : "门派忠诚点",
       "shenzhou/pts": "神州贡献度",
	   "gf_job": "官府贡献度",
	   "quest_exp": "江湖阅历",
]);
// ------------------------------------------------------------
int create_path( string id );

void create()
{
       seteuid( ROOT_UID );
}

int tell_msg( object usr, string msg )
{
       if( !usr || !msg )
              return 0;
       tell_object( usr, msg );
       return 1;
}

// 标准函数。
// 传入参数的标准：
// usr -> 奖励对象
// gift -> 奖励的内容，例如：([ "combat_exp": 230, "sdfsdfs": 343, ]) 即表示对这两项 dbase data 分别奖励。
// info -> 相关信息，必须三个项目：
//         1、(string) "job_name" 任务标记，例如： hs-xunshan
//         2、(string) "job_name_cn" 任务描述，例如：巡山
//         3、(int) "job_time_limit" 任务时间限制，例如： 50 表示两次奖励间需要间隔至少50秒，否则削弱收益。
int job_gift( object usr, mapping gift, mapping info )
{
       object *inv, ob, ob_tmp;
       string *key, job_name, job_name_cn, msg, log_msg, id;
       int i, k, last_gift_time, job_time_limit, add, add_percent;
       int get_gift;
       mixed m;

       // 丢失玩家的时候不予处理。
       if( !usr || !userp(usr) )
              return 0;
       // 如果设置不执行任何奖励，或丢失奖励数据时，则无奖励。
       if( NO_ALL_GIFT
              || !gift || !sizeof(gift) || !sizeof( (key=keys(gift)) ) 
              || !info || !sizeof(info)
              || !(job_name = info[ "job_name" ])
              || !(job_name_cn = info[ "job_name_cn" ])
              || (job_time_limit = info[ "job_time_limit" ]) < 10
              )
              return tell_msg( usr, HIY"你完成这次任务，没有得到任何奖励。\n"NOR );
       // 获得了基本各类参数。包括：job id，job 中文名字，job 时间限制等等。
       
       //---------------------------------------------------------------
       // 那么下面开始进行奖励。
       // 如果允许对完成任务时间的记录进行奖励调整，则执行调整。
       if( !NO_TIME_MODIFY )
       {
              // 玩家上次被这个 job 奖励的时间。
              last_gift_time = usr->query("job_gift_time/lt_" + job_name );
              // 进行判断。如果本次时间 - 上次时间不足限制时间，那么做得太快了。下调 1/10 的收益。
              if( (time() - last_gift_time) < job_time_limit )
              {
                     usr->add( "job_gift_cut/lt_" + job_name, 1 );
                     if( usr->query( "job_gift_cut/lt_" + job_name) > 9 )
                            usr->set( "job_gift_cut/lt_" + job_name, 9 );
              }
              else
              {
                     // 否则，恢复 1/10 的收益。
                     usr->add( "job_gift_cut/lt_" + job_name, -1 );
                     if( usr->query( "job_gift_cut/lt_" + job_name) < 0 )
                            usr->set( "job_gift_cut/lt_" + job_name, 0 );
              }
       }
       usr->set( "job_gift_time/lt_" + job_name, time() );
       // 接下来，对 gift 里定义的每一个数据奖励到玩家数据中去。
       for(msg = "", log_msg = "", i=sizeof(key)-1;i>=0;i--)
       {
              // 我们当然只对有改变的项目进行处理。
              if( (add=gift[key[i]]) == 0 )
                     continue;
              // 如果只能奖励标准数据，而此项数据不符合，则略过。
              if( STD_GIFT_LIMIT && !(std_gift_cname[ key[i] ]) )
                     continue;
              // 好，可以奖励此项数据。只要有一项以上，则改变一个标记。
              get_gift = 1;
              // 首先，根据玩家对此项任务的时间限制进行奖励调整。
              if( !NO_TIME_MODIFY && usr->query( "job_gift_cut/lt_" + job_name) )
              {
                     add -= add / 10 * usr->query("job_gift_cut/lt_" + job_name);
              }
              // 来，看看有没有可以加成奖励的宝物！当然，要定义了允许加成的标记。
              if( SPECIAL_OBJ_ADD_ALL && special_obj_add[ key[i]] )
              {
                     // 定义为方式一时，可以累加加成。
                     if( SPECIAL_OBJ_ADD_TYPE )
                     {
                            inv = all_inventory(usr);
                            if( inv && (k=sizeof(inv)) )
                            {
                                   // 统计加成数据。
                                   add_percent = 0;
                                   for( k--; k>=0; k-- )
                                   {
                                          m = inv[k]->query_job_gift_add();
                                          if( !m || !mapp(m) || !sizeof(m) || !m[ key[i] ] )
                                                 continue;
                                          tell_msg( usr, sprintf(
                                                 "%s你身上的%s%s忽然发出一阵光芒！奖励的%s额外%s了！\n"NOR,
                                                 m[key[i]] > 0 ? HIW : HIY,
                                                 inv[k]->query("name"),
                                                 m[key[i]] > 0 ? HIW : HIY,
                                                 std_gift_cname[key[i]] ? std_gift_cname[key[i]] : key[i],
                                                 m[key[i]] > 0 ? "增加" : "减少",
                                                 ));
                                          add_percent += m[ key[i] ];
                                   }
                            }
                     }
                     else  // 否则取最高值。
                     {
                            inv = all_inventory(usr);
                            if( inv && (k=sizeof(inv)) )
                            {
                                   // 统计加成数据。
                                   add_percent = 0;
                                   for( k--; k>=0; k-- )
                                   {
                                          m = inv[k]->query_job_gift_add();
                                          if( !m || !mapp(m) || !sizeof(m) || m[ key[i] ] < 1 )
                                                 continue;
                                          // 取最大的增加率。
                                          if( m[key[i]] > add_percent )
                                          {
                                                 ob_tmp = inv[k];
                                                 add_percent = m[ key[i] ];
                                          }
                                   }
                                   if( add_percent && ob_tmp )
                                   {
                                          tell_msg( usr, sprintf(
                                                 HIG"你身上的%s"HIG"忽然发出一阵光芒！奖励的%s额外增加了！\n"NOR,
                                                 ob_tmp->query("name"),
                                                 std_gift_cname[key[i]] ? std_gift_cname[key[i]] : key[i],
                                                 ));
                                   }
                            }
                     }
              }
              // ok。获得了加成幅度 add_percent 。那么现在修正 add 。
              add = add + (add * add_percent / 100);
              // ok。修正了此 add 。再进行最终的修正；当然，需要定义了 GIFT_MODIFY_ALL 。
              if( GIFT_MODIFY_ALL && gift_modify_percent[ key[i] ] )
              {
                     add = add * gift_modify_percent[ key[i] ] / 100;
              }
              // 完成！把这个奖励加给玩家。
              usr->add( key[i], add );

              // 记录准备报告的信息，以及准备 log 的信息。
              msg += sprintf( "%s点%s%s",
                     chinese_number( add ), std_gift_cname[key[i]] ? std_gift_cname[key[i]] : key[i],
                     i!= 0 ? "、" : "" );
              log_msg += sprintf( "(%s:%d) ", key[i], add, );
       }
       // 所有奖励完成，报告信息。
       tell_msg( usr, sprintf( "\n"+CYN+"由于成功的完成了%s的任务，你被奖励：\n%s。\n"NOR,
                     job_name_cn, msg ));
		if (usr->query("potential") > usr->query("max_potential"))
			{
				usr->set("potential", usr->query("max_potential"));
				tell_msg( usr, sprintf( HIY"请注意，你所能存储的潜能已经到了最大值！\n"NOR));
			}
       usr->save();
       id = getuid(usr);
       if( file_size( LOG_DIR + LOG_FILE_PATH ) != -2 )
              mkdir( LOG_DIR + LOG_FILE_PATH );
       if( file_size( LOG_DIR + LOG_FILE_PATH + "all_job/" ) == -2
              || mkdir( LOG_DIR + LOG_FILE_PATH + "all_job/" ) )
       {
              log_file( LOG_FILE_PATH + "all_job/" + job_name,
                            sprintf( "[%s] %s 获得：%s。\n",
                                    ctime(time()), id, log_msg ));
       }
       if( create_path( id ) )
       {
              log_file( LOG_FILE_PATH + id[0..0] + "/" + id + "_job", 
                            sprintf( "[%s] 任务：%s(%s) 获得：%s。\n",
                                  ctime(time()), job_name_cn, job_name, log_msg));
       }
       return 1;
}

int create_path( string id )
{
       if( !id )
              return 0;
       if( file_size( LOG_DIR + LOG_FILE_PATH + id[0..0] + "/" ) == -2
              ||  mkdir( LOG_DIR + LOG_FILE_PATH + id[0..0] + "/" ) )
       {
                     return 1;
       }
       return 0;
}
