#include <ansi.h>

inherit F_SSERVER;
//void attack_1();
//void attack_2();
//void attack_3();
//void finish();
int perform(object me, object target) {
  object weapon;
  int level, busytime, j;
  int i = me->query_skill("huashan-jianfa", 1);
  int d = me->query_skill("force", 1);
  int rebirth = me->query("rebirth");
  d = (1 + random(rebirth)) * d;

  busytime = 5 - rebirth;
  if (busytime > 3) busytime = 3;

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target) || !living(target)
    || environment(target) != environment(me))
    return notify_fail(MAG "夺命连环三仙剑" NOR "只能对战斗中的对手使用。\n");


  if ((!this_player()->query("family") || this_player()->query("family/family_name") != "华山派") && (!wizardp(this_player())))
    return notify_fail("你不是华山派弟子，不会使用" MAG "夺命连环三仙剑" NOR "。\n");
  if (me->query_temp("sanxian", 1))
    return notify_fail("你正在使用夺命连环三仙剑！\n");

  if (me->query("rebirth") < 1)
    return notify_fail("你只能在获得重生后才可使用夺命连环三仙剑！\n");

  if ((int)me->query_skill("huashan-jianfa", 1) < 200)
    return notify_fail("你的剑法还未练成，不能使用" HIG "夺命连环三仙剑" NOR "！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "huashan-jianfa")
    return notify_fail("你手里没有剑，无法使用" MAG "夺命连环三仙剑" NOR "！\n");

  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力修为不够，不能使用" MAG "夺命连环三仙剑" NOR "！\n");
  if ((int)me->query("neili") < 600)
    return notify_fail("你现在真气不足，不能使用" MAG "夺命连环三仙剑" NOR "！\n");
  if ((int)me->query("jingli") < 500)
    return notify_fail("你现在精力不足，不能使用" MAG "夺命连环三仙剑" NOR "！\n");
  if ((int)me->query_skill("sword", 1) < 200)
    return notify_fail("你的基本剑法不够娴熟，不能在剑招中使用" HIG "夺命连环三仙剑" NOR "。\n");

  level = me->query_skill("sword") / 75;

  message_vision(MAG "\n$N长啸一声，使出平生绝技，连环三招，正是华山剑宗绝学“夺命连环三仙剑”！\n" NOR, me, target);

  target->add_temp("apply/parry", -i);
  target->add_temp("apply/dodge", -i * 2);

  me->add("neili", -300);
  me->add("jingli", -100);
  me->add_temp("apply/attack", i / 2);
  me->add_temp("apply/damage", d / 4);
  me->add_temp("sanxian", 1);
  for (j = 0; j < 3; j++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  }
  me->start_busy(1 + random(busytime));
  me->add_temp("apply/attack", -i / 2);
  me->add_temp("apply/damage", -d / 4);
  if (living(target)) {
    target->add_temp("apply/parry", i);
    target->add_temp("apply/dodge", i * 2);
  }
  me->start_call_out((: call_other, __FILE__, "remove_effect", me :), 5);
  return 1;
}

int remove_effect(object me) {
  me->delete_temp("sanxian");
  message_vision(MAG "\n$N吸了一口气，将内力收回丹田，剑招也恢复正常！\n\n" NOR, me);
  return 0;
}
