//sanqing.c 「借花献佛」

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;
int remove_effect(object me);

int perform(object me, object target)
{
	string weapon;
	int skill, att;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「借花献佛」只能对战斗中的对手使用。\n");

	if( me->query_temp("xianfo",1) )
		return notify_fail("你已在使用「借花献佛」！\n");

	if( me->query_skill_mapped("force") != "hunyuan-yiqi" )
		return notify_fail("你所用的并非混元一气功，无法施展「借花献佛」！\n");

	if( me->query_skill("hunyuan-yiqi", 1) < 100 )
		return notify_fail("你的混元一气功火候未到，无法施展「借花献佛」！\n");

	if( me->query_skill("buddhism",1) < 100 )
		return notify_fail("你的佛法修为不足，使不出「借花献佛」绝技！\n");

	if( me->query_skill("ranmu-daofa",1) < 135 )
		return notify_fail("你的燃木刀法修为不足，还不会使用「借花献佛」！\n");

	if( me->query_skill("blade",1) < 100 )
		return notify_fail("你的基本刀法修为不足，还不会使用「借花献佛」！\n");

	skill =  ( me->query_skill("ranmu-daofa")
		+ me->query_skill("force") ) / 5;

	if( me->query("neili") <= skill*3 )
		return notify_fail("你的内力不够使用「借花献佛」！\n");
	if( me->query("jingli") <= skill )
		return notify_fail("你的精力不够使用「借花献佛」！\n");
	if( me->query("jing") <= skill )
		return notify_fail("你的精不够使用「借花献佛」！\n");

	weapon = me->query_temp("weapon");

	me->set_temp("apply/speed", me->query_temp("apply/speed",1)+skill*2);

	att = skill;
	if ( att < 45) att = 45;
	if (att >200 ) att = 200;

	me->set_temp("apply/attack", me->query_temp("apply/attack",1)+att);

	me->set_temp("apply/dodge", skill*3/2);
	me->set_temp("apply/parry", skill*3/2);

	if( me->query_skill("blade") < 203 )
		message_vision(HIR "$N双掌夹刀合十，猛宣一声佛号，将内力逼至"+(me->query_temp("weapon"))->query("name")+HIR"刀锋，刀锋立时红如赤碳，夹杂着一股热浪$N对着$n一阵连砍，正好是五五二十五刀！\n\n" NOR, me, target);
	else if( me->query_skill("blade") < 300 )
		message_vision(HIR "$N双掌夹刀合十，猛宣一声佛号，将内力逼至"+(me->query_temp("weapon"))->query("name")+HIR"刀锋，刀锋立时红如赤碳，夹杂着一股热浪$N对着$n一阵连砍，正好是六六三十六刀！\n\n" NOR, me, target);
	else if( me->query_skill("blade") < 400 )
		message_vision(HIR "$N双掌夹刀合十，猛宣一声佛号，将内力逼至"+(me->query_temp("weapon"))->query("name")+HIR"刀锋，刀锋立时红如赤碳，夹杂着一股热浪$N对着$n一阵连砍，正好是七七四十九刀！\n\n" NOR, me, target);
	else if( me->query_skill("blade") < 500 )
	{
		message_vision(HIR "$N双掌夹刀合十，猛宣一声佛号，将内力逼至"+(me->query_temp("weapon"))->query("name")+HIR"刀锋，刀锋立时红如赤碳，夹杂着一股热浪$N对着$n一阵连砍，正好是八八六十四刀！\n\n" NOR, me, target);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	}
	else
	{
		message_vision(HIR "$N狂宣一声佛号，将内力逼至"+(me->query_temp("weapon"))->query("name")+HIR"刀锋，刀锋立时红如赤碳，夹杂着一股热浪$N对着$n一阵连砍，正好是九九八十一刀，刀光便如火内莲花一般！\n\n" NOR, me, target);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	}

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
//	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

	me->add("neili", -skill*3 );
	me->add("jingli", -skill );
	me->add("jing", -skill );
	me->set_temp("xianfo",1);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me :),30 );
	return 1;
}

int remove_effect(object me)
{
	me->set_temp("apply/speed", 0);
	me->set_temp("apply/attack", 0);
	me->set_temp("apply/dodge", 0);
	me->set_temp("apply/parry", 0);
	me->delete_temp("xianfo");

	if( me->is_fighting() )
		message_vision(HIR "\n$N吸了一口气，将内力收回丹田，招式也恢复正常！\n\n" NOR, me);

	return 0;
}


