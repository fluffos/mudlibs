//yanxue.c  「烟雪春梅」
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「" HIY "烟雪春梅" NOR "」只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("bingxue-xinfa", 1) < 100)
    return notify_fail("你的冰雪心法火候不够，使不出「" HIY "烟雪春梅" NOR "」。\n");

  if ((int)me->query_skill("snow-zhang", 1) < 100)
    return notify_fail("你的飞雪映梅掌不够熟练，不会使用「" HIY "烟雪春梅" NOR "」。\n");

  if ((int)me->query("neili") < 700)
    return notify_fail("你的内力修为还不够高。\n");

  message_vision(HIW "$N冰雪心法运转一周天，全身只觉一股寒气蒸腾欲出,清啸一声,飞身而上,施展出「" HIY "烟雪春梅" HIW "」，
双手一搓一放,一股凝人气血的狂飙向$n铺天盖地席卷而去。\n" NOR, me, target);

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3 || target->is_busy()) {
    target->start_busy(3);
    damage = (int)me->query_skill("snow-zhang", 1) + (int)me->query_skill("bingxue-xinfa", 1);
    damage = damage + random(damage);
    target->receive_damage("qi", damage * 3);
    target->receive_wound("qi", damage);
    me->add("neili", -400);
    message_vision(
      HIR "$n只见漫天青气席卷而来,躲无可躲,卒一接触,便被震的七窍流血,如断线风筝向后飘去。\n" NOR,
      me,
      target
    ); COMBAT_D->report_status(target);
  } else {
    me->start_busy(2 + random(1));
    message_vision(HIM "可是$p看破了$P的企图，轻轻地闪在了一边。\n" NOR, me, target);
  }
  me->start_perform(4, "「" HIY "烟雪春梅" NOR "」");
  if (!target->is_fighting(me)) target->fight_ob(me);
  return 1;
}
