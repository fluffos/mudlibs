// Pingguo
// 毒龙大法 神龙教内功 
#include <ansi.h>

inherit FORCE;
#include "/kungfu/skill/force_list.h"

string check() { return "force"; }

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i, k = 0, nb, nk, lvl = (int)me->query_skill("dulong-dafa", 1);

  skl = this_player()->query_skills();
  sname = sort_array(keys(skl), (: strcmp :));

  if (me->query_skill("this_skill") > 99) {
    for (i = 0; i < sizeof(skl); i++)
      if (SKILL_D(sname[i])->check() == "force") k++;
    if (k >= 5) return notify_fail("你的毒龙大法还不够精湛，无法同时拥有五种内功！。\n");
  }

  nb = (int)me->query_skill("medicine", 1);
  nk = (int)me->query_skill("dulong-dafa", 1);

  if (me->query("gender") == "无性" && lvl > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会高深的毒龙大法。\n");

  if ((int)me->query_skill("force", 1) < 20)
    return notify_fail("你的基本内功火候还不够。\n");

  if (nb < 200 && nb <= nk)
    return notify_fail("你的药理学不够，无法领会更高深的毒龙大法。\n");

  return 1;
}

int practice_skill(object me) {
  if (me->query_skill("dulong-dafa", 1) < 120)
    return notify_fail("你的毒龙大法修为不够，只能用学(learn)的来增加熟练度。\n");
  if (me->query_temp("weapon"))
    return notify_fail("练习毒龙大法必须空手才能有所提高。\n");
  if ((int)me->query("jing") < 200)
    return notify_fail("你的精神不好，无法练习毒龙大法。\n");
  if ((int)me->query("jingli") < 200)
    return notify_fail("你的精力不够练习毒龙大法。\n");
  if ((int)me->query("neili") < 200)
    return notify_fail("你的内力不够练习毒龙大法。\n");
  if ((int)me->query("potential") < 1)
    return notify_fail("你的潜能不够，无法领悟更高深的毒龙大法！\n");

  me->add("neili", -40);
  me->receive_damage("jingli", 30, "精力透支过度死了");
  me->receive_damage("jing", 10, "精力透支过度死了");
  if (random(10) == 1) me->add("potential", -1);
  return 1;
}


string exert_function_file(string func) {
  return __DIR__ "dulong-dafa/" + func;
}
mapping curing_msg(object me) {
  return ([
    "apply_short": me->name() + "坐在地上运转" CYN "【毒龙大法】" NOR "，调匀气息。",
    "start_self": YEL "你潜运内力，将" NOR CYN "【毒龙大法】" YEL "运转周身，调匀气息。\n" NOR,
    "start_other": CYN "只见" + me->name() + "闭目坐下，口中念念有词。\n" NOR,
    "finish_self": YEL "你只觉体内" NOR CYN "【毒龙大法】" YEL "运转正常，将真气还合丹田，站起身来。\n" NOR,
    "finish_other": me->name() + "惨白的脸色渐渐恢复正常，站起身来。\n",
    "unfinish_self": "你渐感真气不足，体内说不出的难受，不得不将在体内搬运的内息收回。\n",
    "unfinish_other": me->query("eff_qi") < me->query("max_qi") * 3 / 4 ?
    "猛地里" + me->name() + "口一张，“哇”喷出几口鲜血。\n" :
    "猛地里" + me->name() + "口一张，“哇”吐出口紫黑瘀血。\n",
  ]);
}
