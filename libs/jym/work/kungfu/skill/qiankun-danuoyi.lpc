/*张无忌听到风声，知道这一掌真力充沛，非同小可，有意试一试他的内力，右掌回转，硬
碰硬的接了他这掌，左足这才着地。霎时之间，苦头陀掌上真力源源催至。张无忌运起乾
坤大挪移心法中第七层功夫，将他掌力渐渐积蓄，突然间大喝一声，反震出去，便如一座
大湖在山洪爆发时储满了洪水，猛地里湖堤崩决，洪水急冲而出，将苦头陀送来的掌力尽
数倒回。*/

#include <ansi.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
  YEL "$n身体滑如游鱼，在间不容发之际避开$N这一招。\n" NOR,
  YEL "但见$n四下转动，越奔越快，如风如火，似雷似电，足不点地的凌空飞行一般。\n" NOR,
  YEL "$n施展挪移乾坤心法，一声清啸，拔身而起，在半空中轻轻一个转折，飘然落在丈许之外。\n" NOR,
  YEL "陡然间$n身形拔起，在空中急速盘旋，连转四个圈子，愈转愈高，又是一个转折，轻轻巧巧得落在数丈之外。\n" NOR,
  YEL "$n右手后挥，拨开了袭至的$w，左手乾坤大挪移心法一提一送，身随劲起，嗖的一声，身子直冲上天。\n" NOR,
});

string *parry_msg = ({
  HIM "那知$n跟著微转，一股柔和的劲力送出，将$N击向$n的一招直荡了开去。\n" NOR,
  HIM "$n挪移乾坤，从中牵引，$N这招在中途转了方向，使了个空。\n" NOR,
  HIM "$n右手五指犹如抚琴鼓瑟，忽挑忽捻，忽弹忽拔，上身半点不动，片刻间将$N的这招力道尽数卸了。\n" NOR,
  HIM "却见$N这一招将要及$n，$n右手五指轻拂，$N招数竟然转向，从$n身侧斜了过去，相距虽不过三寸，这一招终于全然使了个空。\n" NOR,
  HIM "$n动也不动，待$N这招使到，内力斜引，将$N的力道挪移卸了开去。$N只觉犹似入了水中，更无半点着力处。\n" NOR,
});

string *move_msg = ({
  HIG "\n$n向左踏出两步，右手挥出，一股劲风扑向$N的后心，这一招的方位时刻，拿捏得恰到好处，$N身不由主，出招陡然转了方向！\n" NOR,
  HIG "\n$n左手护胸，右手五指犹如抚琴鼓瑟，忽挑忽捻，忽弹忽拨，上身半点不动，片刻间将$N的招数尽数引开！\n" NOR,
  HIG "\n$n左手牵，右手引，乾坤大挪移心法牛刀小试，$N的招式已然转向！\n" NOR,
  HIG "\n$n身子微转，一股柔和的劲力送出，将$N击向$n的一招直荡了开去。\n" NOR,
  HIG "\n$n动也不动，待$N这招使到，内力斜引，将$N的力道挪移卸了开去。$N只觉犹似入了水中，这一招更不知击向何处！\n" NOR,
});

int valid_enable(string usage) {
  return (usage == "parry") || (usage == "dodge") || (usage == "move");
}

string query_dodge_msg() {
  return dodge_msg[random(sizeof(dodge_msg))];
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

int valid_learn(object me) {
  if (me->query_skill("qiankun-danuoyi", 1) > 249)                             //by zzh
    return 1;

  return notify_fail("乾坤大挪移只能通过研习《乾坤大挪移心法》和学习来提高。\n");
}
int practice_skill(object me) {
  int qkdny_cost;
  if (me->query_skill("qiankun-danuoyi", 1) < 500)
    return notify_fail("你的乾坤大挪移功力还不够，必须先通过研习《乾坤大挪移心法》或者学习来提高。\n");
  if (me->query_skill("force", 1) < 150)
    return notify_fail("你的基本内功火侯还不够，练不了乾坤大挪移。\n");
  if ((int)me->query("max_neili") < 2000)
    return notify_fail("你的内力不够雄厚, 练不了乾坤大挪移。\n");
  if ((int)me->query("jingli") < 50 || (int)me->query("jing") < 50 || (int)me->query("neili") < 100)
    return notify_fail("你的体力太差了，先歇息一会儿。\n");
  if (me->query_skill("jiuyang-shengong", 1) < 30)
    qkdny_cost = 3500 / me->query_skill("force", 1);
  else qkdny_cost = 2000 / me->query_skill("jiuyang-shengong", 1);
  me->receive_damage("jingli", qkdny_cost);
  me->receive_damage("jing", qkdny_cost);
  qkdny_cost = qkdny_cost / 2;
  me->add("neili", -qkdny_cost);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "qiankun-danuoyi/" + action;
}

int is_special() {
  return 1;
}

mixed hit_by(object me, object victim, int damage) {

  object victim2, *all, *all1, room;
  int ap, dp, i, level;
  object weapon = me->query_temp("weapon");
  mapping prepare;
  string attack_skill, result, name;

  if ((level = victim->query_skill("qiankun-danuoyi", 1)) < 150
    || victim->query("neili") < 100
    || victim->query("jingli") < 100
    || !living(victim))
    return damage;
  dp = COMBAT_D->skill_power(victim, "dodge", SKILL_USAGE_DEFENSE);
  if (victim->query_skill_mapped("parry") == "qiankun-danuoyi")
    dp += COMBAT_D->skill_power(victim, "parry", SKILL_USAGE_DEFENSE);
  ap = COMBAT_D->skill_power(me, "dodge", SKILL_USAGE_DEFENSE);
  prepare = me->query_skill_prepare();
  if (!prepare)
    prepare = ([]);
  if (objectp(weapon))
    attack_skill = weapon->query("skill_type");
  else switch (sizeof(prepare)) {
    case 0: attack_skill = "unarmed"; break;
    case 1: attack_skill = (keys(prepare))[0]; break;
    case 2: attack_skill = (keys(prepare))[me->query_temp("action_flag")]; break;
  }

  ap += COMBAT_D->skill_power(me, attack_skill, SKILL_USAGE_ATTACK);
  ap /= 100;
  dp /= 200;

  if (random(ap + 3 * dp) > ap) {
    room = environment(victim);
    all = all_inventory(room);
    all1 = allocate(sizeof(all));
    victim2 = all[random(sizeof(all))];
    while (!living(victim2) || victim2->query("id") == victim->query("id") || !victim2->is_fighting(victim)) {
      victim2 = all[random(sizeof(all))];
    }
    result = move_msg[random(sizeof(move_msg))];
    message_vision(result, me, victim);
    name = victim2->query("name");
    if (wizardp(victim))
      tell_object(victim, "挪移目标是：" + name + "\n" NOR);
    victim->add("jingli", -80);
    victim->add("neili", -100);
    return ([ "result": "", "damage": damage, "victim": victim2 ]);
  } else if (random(ap + 5 * dp) > ap) {
    victim->add("jingli", -80);
    victim->add("neili", -50);
    result = parry_msg[random(sizeof(parry_msg))];
    damage = 0;
    return ([ "result": result, "damage": damage ]);
  }

  else return damage;
}
