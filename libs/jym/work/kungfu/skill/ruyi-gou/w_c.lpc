//五彩神龙
// hook perform

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;
int second_hit(object me, object target);

int perform(object me, object target)
{
	string weapon;
	object weapon1;
	int    lvl1, lvl2,busy_time, amount;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「五彩神龙」只能对战斗中的对手使用。\n");

	weapon1 = me->query_temp("weapon");
        if( !objectp(weapon1) || weapon1->query("skill_type") != "hook" )
                return notify_fail("你手中无钩，如何使得「五彩神龙」？\n");

	if( me->query_skill_mapped("force") != "dulong-dafa" )
		return notify_fail("你所用的并非毒龙大法，无法施展「五彩神龙」！\n");

	if( (int)me->query_temp("juding") )
		return notify_fail("你正在使用「子胥举鼎」无法同时施展「五彩神龙」！\n");

	if((lvl1=me->query_skill("dulong-dafa")) < 60 )
		return notify_fail("你的毒龙大法火候未到，无法施展「五彩神龙」！\n");

       if( me->query("neili") <= 300 )
                return notify_fail("你的内力不够，劲力不足以施展「五彩神龙」！\n");

	if( (lvl2=me->query_skill("hook")) < 60 )
		return notify_fail("你如意钩法修为不足，还不会使用「五彩神龙」！\n");

	amount = (lvl1+lvl2);
            busy_time = amount / 20;
	if ( amount < 60 ) amount = 60;
	if ( amount > 200 ) amount = 200;

	if( me->query("neili") <= amount*4 )
		return notify_fail("你的内力不够使用「五彩神龙」！\n");
	if( me->query("jingli") <= amount*2 )
		return notify_fail("你的精力不够使用「五彩神龙」！\n");

	weapon = me->query_temp("weapon");

	me->add_temp("apply/damage", amount);
	me->add_temp("apply/attack", amount*2);
	me->add_temp("apply/dodge", amount*2);
	message_vision(HIM "\n$N手中"+me->query_temp("weapon")->query("name")+HIM"越耍越快,便如一条神龙，上下盘旋，护定其身。突然之间纵身向前，如暴风骤雨般对$n连攻数招，！\n\n" NOR, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
       COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
       COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	message_vision(WHT "\n三招过后$N,虽然耗费极大,但手中"+me->query_temp("weapon")->query("name")+WHT"仍然有条不紊防御全身！\n\n" NOR, me, target);
       target->start_busy(2);
       me->start_busy(busy_time);
	me->set_temp("apply/attack",0);
	me->set_temp("apply/damage",0);
	me->set_temp("apply/dodge",0);
            call_out("second_hit", 4, me, target);  
	
	return 1;
}

int second_hit(object me, object target){
	string weapon;
	object weapon1;
	int    lvl1, lvl2, amount;
            lvl1=me->query_skill("hook",1);
            lvl2=me->query_skill("dodge",1);
	amount = (lvl1+lvl2) ;
	if ( amount < 60 ) amount = 60;
	if ( amount > 500 ) amount = 500;
            weapon = me->query_temp("weapon");



            
            if(me->is_fighting()){
       me->add_temp("apply/damage", amount*2);
//	me->add_temp("apply/attack", amount*4);
//	me->add_temp("apply/dodge", amount*4);
	message_vision(HIW "\n$N看$n实在厉害，只得强提最后一丝内力，奋力猛扑！\n" NOR, me, target);
	message_vision(HIR "\n$N口中喝到“看招！”\n" NOR, me, target);
//	message_vision(HIR "\n$N的"+me->query_temp("weapon")->query("name")+HIR "又攻四招！\n\n" NOR, me, target);
	message_vision(HIG "\n$N手中"+me->query_temp("weapon")->query("name")+HIG "急攻数招，正是"HIW"『快』"HIG"字决！”\n" NOR, me, target);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	message_vision(HIG "\n突然$N手中"+me->query_temp("weapon")->query("name")+HIG "招数一变,飞舞成圈，银光闪闪，宛如明月，正是"HIW"『稳』"HIG"字决！”\n" NOR, me, target);
       COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	message_vision(HIG "\n只见$N手中"+me->query_temp("weapon")->query("name")+HIG "上隐隐发出风雷之声，功力已发挥至极限，正是"HIW"『狠』"HIG"字决！”\n" NOR, me, target);
       COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	message_vision(HIG "\n最后$N手中"+me->query_temp("weapon")->query("name")+HIG "蓄势待发，大有一击不中，远扬千里之势，正是"HIW"『准』"HIG"字决！”\n" NOR, me, target);
       COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	message_vision(HIC "\n七招过后$N已经是大汗淋漓。\n\n" NOR, me, target);
	me->start_busy(2+random(2));
            target->start_busy(2+random(2));
//	me->set_temp("apply/attack",0);
//	me->set_temp("apply/damage",0);
//	me->set_temp("apply/dodge",0);
	me->add("neili", -amount*5);
	me->add("jingli", -amount*3);

	} else 
	message_vision(HIY "\n$N见战势已定手中的"+me->query_temp("weapon")->query("name")+HIY"渐渐慢了下来。\n"NOR, me);
			

	return 1;
}

int end_att(object me){
	
	if (!me->is_fighting()){
		me->set_temp("apply/attack",0);
		me->set_temp("apply/damage",0);
		me->set_temp("apply/dodge",0);
	}

	return;

}
