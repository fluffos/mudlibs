//Cracked by Kafei
// longhe.c 「龙鹤」
// xuy 09/22/96
// Modified by xQin 2/00

#include <ansi.h>
#include "ljz_name.h"

int exert(object me, object target)
{
	int amount;
	mapping lj_exert;
	mapping my = me->query_entire_dbase();

	if( me->query_skill("linji-zhuang", 1) < 90 )
		return notify_fail("你所学的内功中没有这种功能。\n");

	if( mapp(lj_exert = me->query_temp("lj_exert")) && lj_exert["name"] != "longhe" )
		return notify_fail("你正在运用"+ ljz_name[lj_exert["name"]] +"。\n");

	if( my["neili"] >= my["max_neili"] * 2 )
		return notify_fail("你体内真气鼓荡，无法再吸纳内息了。\n");

	if( my["jingli"] >= my["max_jingli"] * 2 )
		return notify_fail("此时你四肢百骸真气鼓荡，不必再次运功。\n");

	if( !mapp(lj_exert) ) lj_exert = ([ ]);
	switch( lj_exert["time"] )
	{
		case 0: amount = my["jing"] / 4;
			me->receive_damage("jing", my["jing"]/2, me);
			me->add("neili", amount);
			me->add("jingli", amount);
			me->add_temp("lj_exert/jing2jingli", amount);
			me->add_temp("lj_exert/jing2neili", amount);
			write(HIY "你屏息静气，运行龙鹤二庄，只觉一股暖流出天门，穿地户，"
				"沿着周身经脉绕行一周天，再汇入丹田之中。\n" NOR);
			break;
		case 1: amount = (my["jingli"] - my["neili"]) / 2;
			if( amount > 0 )
			{
				me->add("jingli", -amount);
				me->add("neili", amount);
				me->add_temp("lj_exert/jingli2neili", amount);
				write(HIY "你屏息静气，交错运行龙鹤二庄，只觉几股内息自四肢百骸"
				"倒注入丹田之中。\n" NOR);
			}
			else if( amount < 0 )
			{
				amount = -amount;
				me->add("neili", -amount);
				me->add("jingli", amount);
				me->add_temp("lj_exert/neili2jingli", amount);
				write(HIY "你屏息静气，交错运行龙鹤二庄，只觉一股暖流自丹田"
				"散入四肢百骸。\n" NOR);
			}
			break;
		case 2: amount = my["qi"] / 4;
			me->receive_damage("qi", my["qi"]/2, me);
			me->add("neili", amount);
			me->add("jingli", amount);
			me->add_temp("lj_exert/qi2jingli", amount);
			me->add_temp("lj_exert/qi2neili", amount);
			write(HIY "你屏息静气，运行龙鹤二庄，只觉一股内息自气海流出，"
				"环绕周身经脉运行一周天，再汇入丹田之中。\n" NOR);
			break;
		default: return notify_fail("你已经运行龙鹤二庄到极限了。\n");
	}

	me->set_temp("lj_exert/name", "longhe");
	me->add_temp("lj_exert/time", 1);

	message("vision",
		HIY + "只见"+ me->name() +"屏息静气，头顶飘起一缕缕白气，神态略现疲乏。\n" NOR,
		environment(me), me);

	me->remove_call_out( (: call_other, __DIR__"remove", "exert", me :), 18);
	me->start_call_out( (: call_other, __DIR__"remove", "exert", me :), 18);
	return 1;
}
