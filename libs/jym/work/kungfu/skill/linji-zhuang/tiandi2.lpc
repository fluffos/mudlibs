// tiandi.c 「天地」
// xuy 09/22/96
// Modified by xQin 2/00

#include <ansi.h>
#include "ljz_name.h"

int exert(object me, object target)
{
	mapping lj_exert;
	mapping my = me->query_entire_dbase();
	int amount = (me->query_skill("mahayana")+me->query_skill("persuading"))
			*me->query_kar()/50;
	int ljz = me->query_skill("linji-zhuang", 1);

	if( ljz < 30 ) return notify_fail("你所学的内功中没有这种功能。\n");

	if( mapp(lj_exert = me->query_temp("lj_exert")) && lj_exert["name"] != "tiandi" )
		return notify_fail("你正在运用"+ ljz_name[lj_exert["name"]] +"。\n");

	if( my["eff_jing"] >= (my["max_jing"] + ljz*me->query_con()/2) )
		return notify_fail("你的精神已经提升到极限了。\n");

	if( my["eff_qi"] >= (my["max_qi"] + ljz*me->query_con()*2/3) )
		return notify_fail("你的元气已经过於充沛了。\n");

	if( my["jingli"] < amount*5 )
		return notify_fail("你的体力不足。\n");

	me->add("eff_jing", amount);
	me->add("eff_qi", amount);
	me->receive_heal("qi", amount);
	me->receive_heal("jing", amount);
	me->add("jingli", -4*amount);
	me->set_temp("lj_exert/name", "tiandi");
	me->add_temp("lj_exert/eff_jing", amount);
	me->add_temp("lj_exert/eff_qi", amount);

	write(HIY "你席地而坐，五心向天，运行天地二庄，益气升阳，益阴潜阳，升降反正，天地二气交泰于身，顿觉自己精气增加了。\n" NOR);
	message("vision",
		HIY + "只见" + me->name() + "席地而坐，五心向天，脸上红光时隐时现，不一会儿便神采弈弈地站了起来。\n" NOR,
		environment(me), me);

	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, amount :), 1800);

	return 1;
}

void remove_effect(object me, int amount)
{
	me->add("eff_jing", -amount);
	me->add("eff_qi", -amount);

	me->add_temp("lj_exert/eff_jing", -amount);
	me->add_temp("lj_exert/eff_qi", -amount);

	if( !me->query_temp("lj_exert/eff_jing") && !me->query_temp("lj_exert/eff_qi") )
	{
		tell_object(me, HIG"你所聚天地精气已散回天地之间，你又恢复了原有精气。\n"NOR);
		me->delete_temp("lj_exert");
	}
	else tell_object(me, HIG"你刚才所聚天地精气散回天地之间。\n"NOR);
}
