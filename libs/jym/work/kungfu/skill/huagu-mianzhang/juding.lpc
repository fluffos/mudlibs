// 子胥举鼎

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_SSERVER;
void remove_effect(object me, int amount);

int perform(object me, object target)
{
	int original, skill;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「子胥举鼎」只能对战斗中的对手使用。\n");

//	if( objectp(target) && target != me ) 
//		return notify_fail("你只能用「子胥举鼎」来提升自己的战力。\n");

	 if( me->query("gender") != "男性")
                return notify_fail("你并非男性，无法使用化骨棉掌绝学。\n");

	if( me->query_temp("weapon") )
		return notify_fail("你只能在空手时使用「子胥举鼎」！\n");

	if( me->query_skill("dulong-dafa", 1) < 120 )
		return notify_fail("你的毒龙大法火候未到，无法施展「子胥举鼎」！\n");

	if( me->query_skill("huagu-mianzhang", 1) < 120 )
		return notify_fail("你的化骨棉掌火候未到，无法施展「子胥举鼎」！\n");

	if( me->query("max_neili") <= 600 )
		return notify_fail("你的内力修为不足，无法施展「子胥举鼎」！\n");

	if( (int)me->query("neili") < 600  )
		return notify_fail("你的内力不够。\n");
       
	
       if( (int)me->query_temp("juding") )
		return notify_fail("你正在使用「子胥举鼎」！\n");

	skill = me->query_skill("huagu-mianzhang", 1);
	original = me->query_str();

	me->add("neili", -skill*2);
	me->receive_damage("jingli", skill);

	message_vision(HIR "\n$n抓住$N的后颈，一把提起。$N左手慢慢反转，在$n左腋底搔了一把。\n" NOR, me, target);
	message_vision(HIR "\n$n身子软了下来，$N左手拿住$n腋下，右手慢慢回转，抓住$n领口，缓缓举起$n的身子，过了自己头顶，向外摔出。\n" NOR, me, target);

	me->add_temp("apply/strength", original*3);

	me->set_temp("juding", 1);

	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, original :), skill/12);


	return 1;
}

void remove_effect(object me, int amount)
{
	me->add_temp("apply/strength", - 3*amount);

	me->delete_temp("juding");

	tell_object(me, HIG"\n稍候你将"WHT"「化骨棉掌」"HIR"与"HIY"「毒龙大法」"GRN"运用如初,双臂散力,恢复原样！\n"NOR);
}
