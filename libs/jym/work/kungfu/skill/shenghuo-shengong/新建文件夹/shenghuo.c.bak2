//Cracked by polybao
// guangming.c 光明神功

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
	int skill;

	if( target != me ) 
		return notify_fail("你只能用圣火神功来运光明神功。\n");

	if( (int)me->query("neili") < 100  ) 
		return notify_fail("你的内力不够。\n");
	if( (int)me->query_temp("guangming") ) 
		return notify_fail("你已经在运功中了。\n");

	if( (int)me->query_skill("shenghuo-shengong", 1) < 20)
		return notify_fail("你的圣火神功火侯不够！\n");

	skill = me->query_skill("force");
	me->add("neili", -100);

	message_vision(
	MAG "$N长吸一口气，默颂光明经文。只觉一股真气升起，顿时奋不顾身，只攻不守。\n" NOR, me);

	me->add_temp("apply/att",  skill/2);
	me->add_temp("apply/dam",  skill/2);
	me->add_temp("apply/def",  -skill/2);
	me->add_temp("apply/arm",  -skill/2);
	me->set_temp("guangming", 1);

	me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/2 :), skill/2);

	if( me->is_fighting() ) me->start_busy(3);

	return 1;
}

void remove_effect(object me, int amount)
{
	me->add_temp("apply/att",  -amount);
	me->add_temp("apply/dam",  -amount);
	me->add_temp("apply/def",  amount);
	me->add_temp("apply/arm",  amount);
	me->delete_temp("guangming");
	tell_object(me, "你的光明神功运行完毕，将内力收回丹田。\n");
}
