// ranmu-daofa.c 燃木刀法
/*
少林燃木刀法真本


修习此法，常人一百八十天即可大成，若病弱之人则万不可修习此法，因为反噬之力，异常之强，病弱之人，抵抗不了。

火焰刀者，非金非铁，无形无相，纯以体内真气感应天地间三阴之真气，依五行生克之法而摄炼，造就此刀，三五丈内，

纵横挥击，无物能当，以施于人，轻则断其经脉毁其神志，重者如遭雷击当场殛命。大凡为火焰刀所伤者，皮肉多无破损，

唯见一青黑色之痕，此中火焰刀之迹也。

修炼者要经过“内练筑基”、“三阴炼气”、“化煞炼刀”这三个内功练习步骤共一百八十天的修炼，达到一手掐五行诀，

一手做成火焰刀诀发出“火焰刀”的“焰气”，在三至五丈内依五行之气生克之理，纵横挥击，可以所向披靡。

以上三个步骤，必须循序渐进，不能错乱次序，否则，内息紊乱，容易走火入魔。曾经有一僧单修习“化煞炼刀”一步，

虽然很快就有小成，但不过一年，双足皆痿，不能行走。修炼者务必牢记！

修炼开始时，修炼者先要清心寡欲，不近荤酒，素食七天，第八天要选在甲子日或者每月初一、十五，或者三月初三，五月

五，七月七，九月九，也可以。在静室中或者山林野外没有干扰的好地方（因为那里气场对练功有利），面向北方站立，叩

齿三十六次，吸气九口，呼在左手掌心之上，把左手掌心轻按两眉之间的神堂穴（天目穴），再轻按两乳之间的气堂穴（膻中穴）

，然后轻按脐中丹鼎穴（神阙穴），然后轻按印腰后命门穴，并轻拍三下，又轻按丹鼎穴，合右手于左手背，保持这个姿势不动，

行筑基气法，口诀：口摄真气入丹鼎，左旋五圈右亦应，金水木火土归元，默咒催动掐五行。


此时观想极北的地方，佛家殿宇巍峨，有紫黑云气升腾于天，于是微微张开嘴，舌抵上腭，轻微缓慢地吸气，观想着把极北

的地方的云气全部摄来入口内，直下丹鼎穴中，气吸满后，闭住呼吸进行身体内部的观想，观想脐腹中有一个金鼎，大小如

拳头，（鼎有三脚，所谓三足鼎立），一足在前，两足在侧，云气都聚集在里面，两手向前移动三寸左右，左手大拇指顺序

掐金水木火土五诀，两手随之逆时针旋转五圈，再顺序掐五诀，两手则随之顺时针旋转五圈，（女子则反）然后不再掐诀，

两手重新轻按在丹鼎穴上，静立片刻，让体内之气自鼻内缓慢放出（刚才的掐诀旋转等都是在屏息中进行，这时才从鼻子中轻

轻地呼气），呼气的时候注意不要发出声音，从摄气到现在，为一遍，每次如此练习七遍。修炼七天之后，在此基础上，再增

加功法。（五诀：木诀在食指中节，火诀在中指上节，水诀在中指下节，土诀在无名指下节，金诀在小指中节。有说土诀在中

指下节，水诀在无名指下节者，其原理与十二地支诀有关，修炼者可按照自己感觉来选择，实践证明诀法的影响并不大。）

第八日练功时，增功为：面向北双膝着地成跪姿，而膝以上的身体保持直立，俯腰，两掌按地，相距二尺多，抬头望北斗七星

，看不见星斗的时候也要想象北斗七星高悬天空，开口，极缓摄气，观想北斗七星生紫色毫光，直来入口内，摄满气后，闭口，

舌封齿间，微微低头，观想毫光真气下入丹鼎穴，顺任脉下行至会阴穴，顺着两腿内侧下行至足底涌泉穴，左旋五圈，随之默

咒曰：“金水木火土”，后循原路返回丹鼎中，乃将口中津液合气吞入丹鼎，气闷之极时，将气自鼻内缓慢放出，再如前望北

斗摄光气入丹鼎，下涌泉右旋五圈收回，如是乃为一次，每行七次乃毕，如是修炼七日后再增功。

增功为：依前面北而跪，升腰正身，拔背顶项，微收下颔，胸腹松沉，两臂自体侧直举过顶，掌心朝前，抬头望北斗，开口极

缓摄气，思北斗生紫光直来入口内，摄气极，闭口，舌封齿间，吞气入丹鼎，两臂自前缓缓压下向前平伸，左手掌心翻朝天，

收回到腰肋旁，右手变成掌心向左，大拇指在上，将食指和无名指卷屈，拇指、中指、小指向前伸直，不必用力，成火焰刀诀式

（这个手型就是火焰刀诀），遂屏息运气上过气堂穴，左右分二支，循两臂内侧运达两手，于刀诀大中小指端，观想真气凝聚变

成三颗紫色的明亮星星，分别位于大中小三指的指端，观想紫色明星放出极细的光线从指端射出一尺左右），然后左手掐金水木

火土五诀（依五行相生的次序掐诀），右手刀连臂随之外划五圈，左上右下（顺时针旋转），圈直径约一尺左右，划时宜缓，这

是因为恐怕内气翻腾不适。划毕循原路收气归丹鼎，口中津液合气吞入丹鼎，待气闷之极时把气自鼻中缓缓放之，如是乃为一次，

每行七次乃毕（每次练功只划七圈而已，关键是精神集中，提高练习的质量，数量不必增加，七这个数往往具有某种神秘的暗示

力，而且与生命信息的构架也有很深的关系），如是修炼七日，后令刀诀毫光前射三尺许，复修炼七日，令刀射光丈许，亦依法

修炼七日，练功的时候，右手不能对着人，可能造成伤害，即使是隔着墙也不保险，也不能让任何人和动物在旁观看。

如前乃为内炼筑基，自有效验，或觉指端有物牵动，如有丝丝冷气射出，或觉风气往来，或觉身中有物流行，似此者俱佳也。另

有身寒如入冰窟者，寒热往来如疟者，内气凝滞不通者，或许无此法缘，又没有明师点拨，恐有不测，应即当停止。

*/
#include <ansi.h>

inherit SKILL;

mapping *action = ({
([	"action" : "$N面带微笑，一招「烈火烧身」，举$w对着$n连环砍了九九八十一刀，刀气纵横，宛如烈火般扑向$p，迅雷不可挡",
	"force" : 200,
        "dodge" : 20,         
	"damage" : 50,
	"lvl" : 0,
	"skill_name" : "烈火烧身",
	"damage_type" : "割伤"
]),
([	"action" : "$N运起内功一招「点木生火」，在$w上带出火红的无比劲气，迅速划了一个大弧，从上而下劈向$n的$l",
	"force" : 300,
        "dodge" : 35,
	"damage" : 70,
	"lvl" : 20,
	"skill_name" : "点木生火",
	"damage_type" : "割伤"
]),
([	"action" : "$N手臂一沉一拉，使出「张弓望月」，双手持着$w划出一道雪亮刀光，就在$n躲避之时猛地拦腰反切，劈向$n的$l",
	"force" : 250,
        "dodge" : 20,
	"damage" : 90,
	"lvl" : 40,
	"skill_name" : "张弓望月",
	"damage_type" : "割伤"
]),
([	"action" : "$N挥舞$w上劈下撩，左挡右开，使出一招「烈火腾云」，卷起阵阵刀风，每一圈都都划出不同的气流，齐齐罩向$n",
	"force" : 360,
        "dodge" : 15,
	"damage" : 110,
	"lvl" : 60,
	"skill_name" : "烈火腾云",
	"damage_type" : "割伤"
]),
([	"action" : "$N一招「火中取栗」，划个大圈后左脚跃步落地，手中$w往前直伸，刀走剑势，挟着炙热的风声点向$n的$l",
	"force" : 400,
        "dodge" : 15,
	"damage" : 130,
	"lvl" : 90,
	"skill_name" : "火中取栗",
	"damage_type" : "刺伤"
]),
([	"action" : "$N腾空而起，半空中一招「玉石俱焚」猛烈扑下，手中$w迅速连劈，满天流光般的刀影排山倒海般地向$n的全身卷去",
	"force" : 450,
        "dodge" : 30,
	"damage" : 150,
	"lvl" :100,
	"skill_name" : "玉石俱焚",
	"damage_type" : "割伤"
]),
});


int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
        if ((int)me->query_skill("riyue-bian",1) >1 || (int)me->query_skill("weituo-gun",1)>1)
                return notify_fail("你如果有达摩老祖的修为，方可同时学习少林日月鞭、韦陀棍、燃木刀三绝技。\n"); 
        if(!me->query("family") || me->query("family/family_name")!="少林派" )
                return notify_fail("你不是少林弟子，如何能用这燃木刀法？\n");

	if ((int)me->query("max_neili") < 1500)
		return notify_fail("你的内力不够。\n");
	if ((int)me->query_skill("hunyuan-yiqi", 1) < 120)
		return notify_fail("你的混元一气功内功火候太浅。\n");
        if((int)me->query_skill("ranmu-daofa",1) <= 200
        && (int)me->query_skill("xiuluo-dao",1) <= 140)
                return notify_fail("你的修罗刀火候不够，领悟不了燃木刀。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("ranmu-daofa",1);

        if ( me->query_temp("fenwo_hit")){
		return ([
		"action": HIR "$N双掌夹刀合十，手中的"+weapon->name()+HIR"顿时升起一团火焰将自己包围，$P"HIR"猛宣一声佛号，一刀直劈向$n！" NOR,
                "force" : 640,
		"damage": 480,
                "dodge" : 0,
		"damage_type": "割伤"]);
        }

        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");
	if ((int)me->query("jingli") < 80 )
		return notify_fail("你的精力不够练燃木刀法。\n");
	if ((int)me->query("neili") < 50 )
		return notify_fail("你的内力不够练燃木刀法。\n");
	me->receive_damage("jingli", 65);
        if((int)me->query_skill("ranmu-daofa",1)> 200)
            me->add("neili",-20);
            
	return 1;
}
string perform_action_file(string action)
{
        return __DIR__"ranmu-daofa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{                
        if(userp(me) && me->query_temp("fenwo_hit") &&
           victim->query("combat_exp") >= me->query("combat_exp")/2
           && me->query("fenwo") < me->query_skill("blade"))
                me->add("fenwo", 1); // for rmd's fenwo pfm 
}

