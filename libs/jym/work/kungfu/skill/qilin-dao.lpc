//麒麟刀法

inherit SKILL;

mapping *action = ({
([	"action" : "$N双手举起$w，一招「独劈天下」，刀锋自上向上，向$n的$l砍去",
	"force" : 120,
        "dodge" : -10,
        "parry" : 15,
	"damage": 80,
	"lvl" : 0,
	"skill_name" : "独劈天下",
	"damage_type" : "割伤"
]),
([	"action" : "$N右手持刀，一招「横扫千军」，手中$w笔直划向$n的$l",
	"force" : 130,
        "dodge" : -10,
        "parry" : 20,
	"damage": 90,
	"lvl" : 30,
	"skill_name" : "横扫千军",
	"damage_type" : "割伤"
]),
([	"action" : "$N一招「天降麒麟」，$w在$N手中旋转，突然刷地一声自左而右向$n猛劈",
	"force" : 140,
        "dodge" : -5,
        "parry" : 25,
	"damage": 80,
	"lvl" : 50,
	"skill_name" : "天降麒麟",
	"damage_type" : "割伤"
]),
([	"action" : "$N右手反执刀柄，一招「麒麟飞舞」，猛一挫身，$w直向$n的颈中斩去",
	"force" : 160,
        "dodge" : 15,
        "parry" : 25,
	"damage": 100,
	"lvl" : 80,
	"skill_name" : "麒麟飞舞",
	"damage_type" : "割伤",
]),
([	"action" : "$N刀尖平指，一招「天下无双」，一片片切骨刀气如飓风般裹向$n的全身",
	"force" : 370,
        "dodge" : 15,
        "parry" : 55,
	"damage": 160,
	"lvl" : 100,
	"skill_name" : "天下无双",
	"damage_type" : "割伤"
]),
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }


int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 50)
		return notify_fail("你的内力不够。\n");
	if ((int)me->query_skill("dulong-dafa", 1) < 10)
		return notify_fail("你的毒龙大法火候太浅。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
	level   = (int) me->query_skill("qilin-dao",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");
	if ((int)me->query("jingli") < 50)
		return notify_fail("你的精力不够练麒麟刀法。\n");



	me->receive_damage("jingli", 35);
	return 1;
}

string perform_action_file(string action)
{
        return __DIR__"qilin-dao/" + action;
}
