//edit landy 2004.4.16

#include <ansi.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;
  if (!target)
    return notify_fail("你打算用妙手回春做什么？\n");

  if ((int)me->query_skill("miaoshouhuichun", 1) < 100)
    return notify_fail("你的妙手回春修为不够。\n");
  if ((int)me->query("max_neili") < 1500) return notify_fail("你的内力不够。\n");
  if ((int)me->query("neili") < 500) return notify_fail("你的内力不够。\n");

  if ((int)me->query_temp("powery")) return notify_fail("你在用着呢，想重运一次，或是传于他人？\n");

  if ((int)target->query_temp("powery")) return notify_fail("你已经告诉过他内功心法了。\n");

  skill = me->query_skill("force");

  me->add("neili", -500);
  me->receive_damage("qi", 0);

  if (target->query("id") == me->query("id")) {
    message_combatd(
      HIW "$N运起妙手回春，一股白色真气笼罩在$N的周围。\n" NOR, me);
  } else {
    message_combatd(
      HIW + this_player()->query("name") + "在旁边悄声告诉$N一些内功心法。\n" NOR, target);

    message_combatd(
      HIW "$N提升内力顺着" + this_player()->query("name") + "的提示运了一便。\n" NOR, target);
  }

  target->add_temp("apply/attack", skill / 3);
  tell_object(target, HIG "你的攻击力果然瞬间提高了!\n" NOR);

  target->set_temp("powery", 1);

  return 1;
}
