// 湘灵

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_DBASE;
inherit F_SSERVER;

void remove_effect(object me, object target, int dodge, int speed, int damage, int parry);

int perform(object me, object target) {
  object weapon, weapon1;
  string str, msg, limbs;
  int parry_skill, skill, dodge_skill, extra, dodge, speed, parry, yunqi, damage;
  mapping myfam;

  if (!target) target = offensive_target(me);

  if ((!(myfam = me->query("family")) || myfam["family_name"] != "神龙教"))
    return notify_fail("你并非神龙弟子,无法使用“湘灵”！\n");

  if (me->query_temp("weapon"))
    return notify_fail("你只能在空手时使用“湘灵”！\n");


  if (!target || !target->is_character() || target->query("race") != "人类")
    return notify_fail("你要迷惑谁？\n");

  if (me->query_temp("yield"))
    return notify_fail("你目前无法使用“湘灵”！\n");

  if (me->query_skill_mapped("force") != "dulong-dafa")
    return notify_fail("你的内功并非毒龙大法，无法施展“湘灵”。\n");

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("“湘灵”只能在战斗中使用。\n" NOR);


  parry_skill = target->query_skill("parry");
  dodge_skill = target->query_skill("dodge");
  skill = me->query_skill("huanying-zhi", 1);



  if (me->query("gender") != "女性")
    return notify_fail("“湘灵”只有女性才能使用！\n" NOR);



  if (target->query_temp("xiangling"))

  {
    message_vision(
      HIG "\n$N见$n已经被自己迷惑，抓住时机瞬间将" NOR HIR "「神龙幻影指」" NOR HIG "连发两招！\n" NOR,
      me,
      target
    );
    me->add("jiajin", (skill / 10) * 2);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add("jiajin", -((skill / 10) * 2));
    me->start_busy(2);
    return 1;
  }

  if ((int)me->query_skill("dulong-dafa", 1) < 200)
    return notify_fail("你的毒龙大法修为未到，无法施展“湘灵”。\n" NOR);

  if ((int)me->query_skill("huanying-zhi", 1) < 200)
    return notify_fail("你的神龙幻影指修为还不够，尚未领悟到“湘灵”。\n" NOR);

  if (me->query("max_neili") <= 1000)
    return notify_fail("你的内力修为不足，劲力不足以施展“湘灵”！\n" NOR);

  if ((int)me->query("neili", 1) < 500)
    return notify_fail("你现在内力不够，劲力不足以施展“湘灵”！\n" NOR);


  if (me->query("jingli") <= 300)
    return notify_fail("你的精力不足，无法施展“湘灵”！\n" NOR);
  message_vision(HIM "\n$N的双目紧紧看着$n,口中柔柔地说道：“你看我美么？”。\n\n" NOR, me, target);
  me->start_busy(random(1) + 1);



  //		if (random(me->query("per"))+ me->query("combat_exp") > target->query("combat_exp")*4/5)
  if (me->query("per") + random(me->query("combat_exp")) > target->query("combat_exp") * 4 / 10)

  {
    message_vision(HIY "\n只见$n一个失神，被$N的眼神所吸引，顿时放慢攻击，手脚不听使唤！\n\n" NOR, me, target);
    target->start_busy(random(5) + 5);
    //            药理学350级以上配合神龙幻影指可以在使用perform的同时，使用着增加1点永久精力

    if ((int)me->query_skill("medicine", 1) > 350 && random(10) < 4)

    {
      tell_object(
        me,
        "你暗中将" NOR MAG "「药理学」" NOR "配合" NOR HIR "「神龙幻影指」" NOR "将对手的永久精力转为己用！”。\n\n" NOR
      );


      me->add("max_jingli", 1);
      me->add("eff_jingli", 1);
      me->start_busy(random(1) + 2);
    }
    if (target->query("gender") == "女性") {
      if (me->query("per") > target->query("prt") + 2)

        message_vision(HIY "\n$n毕竟是女儿身，“湘灵”对她的威力巨减！！\n" NOR, me, target);
      target->add_temp("apply/parry", parry_skill / 4);
      target->add_temp("apply/dodge", dodge_skill / 4);

    }


    target->add_temp("apply/parry", -parry_skill / 2);
    target->add_temp("apply/dodge", -dodge_skill / 2);


    if (target->query_temp("weapon")) {

      weapon1 = target->query_temp("weapon");

      if (me->query("combat_exp") < random(target->query("combat_exp") * 8 / 5)) {
        message_vision(
          HIR "\n$N看$n被自己迷惑，突然对着$n的" NOR + weapon1->name() + NOR HIR "出手，结果险些将其兵器打掉！\n" NOR,
          me,
          target
        );
        target->start_busy(random(2) + 2);
      } else {
        message_vision(
          HIR "\n$N看$n被自己迷惑，突然对着$n的" NOR + weapon1->name() + NOR HIR "出手，结果$n手中的" NOR + weapon1->name() + NOR HIR "脱手而出！\n" NOR,
          me,
          target
        );
        weapon1->unequip();
        weapon1->move(environment(target));
        target->start_busy(random(5) + 5);
        target->reset_action();

        limbs = target->query("limbs");
        target->add("neili", -skill * 2);
        extra = (int)me->query_skill("huanying-zhi", 1);
        damage = extra / 3 + random(extra / 2);
        target->receive_damage("qi", damage * 5, "被" + weapon1->name() + "穿心而死");
        target->receive_wound("qi", random(damage) * 5, "被" + weapon1->name() + "穿心而死");

        message_vision(
          HIG "\n$N拣起$n的" NOR + weapon1->name() + NOR HIG "，抓住时机配合" NOR HIR "「神龙幻影指」" NOR HIG "将" NOR + weapon1->name() + NOR HIG "飞向$n！" NOR,
          me,
          target
        );
        message_vision(
          NOR "\n结果只听见$n一声惨嚎，" NOR + weapon1->name() + NOR "已在$n的" + limbs[random(sizeof(limbs))] + "穿出，鲜血溅得满地！！\n" NOR,
          me,
          target
        );

        str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));

        message_vision("($N" + str + ")\n", target);
        me->start_call_out((: call_other, __FILE__, "over", me, skill / 2 :), skill / 15);
      }
    }
    extra = (int)me->query_skill("huanying-zhi", 1);
    speed = extra / 2 + random(extra / 2);
    dodge = extra * 3 / 4 + random(extra / 2);
    damage = extra / 3 + random(extra / 2);
    parry = extra * 3 / 4 + random(extra / 5);


    target->add_temp("apply/parry", -parry);

    target->set_temp("xiangling", 25 + extra / 6);
    call_out("checking", 1, me, target, weapon, dodge, speed, damage, parry);



    me->start_busy(1);
    me->add("neili", -skill);
    me->add("jing", -skill / 2);
    if (me->is_fighting())
      me->start_busy(1) + 1;
  } else {
    message_vision(HIW "$n对着$N大笑：“贱人！你长得跟癞蛤蟆一样，如此相貌岂能迷惑本人？看我收拾你！”。\n" NOR, me, target);
    target->kill_ob(me);
    me->start_busy(random(5) + 2);
  }
  return 1;
}

void checking(
  object me,
  object target,
  object weapon,
  int dodge,
  int speed,
  int damage,
  int parry
) {
  if (!living(me) || me->is_ghost()) {
    remove_effect(me, target, dodge, speed, damage, parry);
    return;
  }
  if (target->query_temp("xiangling")) {
    if (!me->is_fighting()) {
      message_vision(WHT "\n$N深吸了一口气，眼神渐渐恢复正常。\n" NOR, me);
      remove_effect(me, target, dodge, speed, damage, parry);

      return;
    }


    else if (me->query_skill_mapped("force") != "dulong-dafa") {
      remove_effect(me, target, dodge, speed, damage, parry);
      tell_object(me, WHT "\n你感到体内内功混乱，脸色突变。\n\n" NOR);
      return;
    }
    target->add_temp("xiangling", -1);
    call_out("checking", 1, me, target, weapon, dodge, speed, damage, parry);
  } else {
    remove_effect(me, target, dodge, speed, damage, parry);
    tell_object(me, WHT "\n你深吸了一口气，眼神渐渐恢复正常。\n\n" NOR);
  }
}


void remove_effect(object me, object target, int dodge, int speed, int damage, int parry) {
  int parry_skill, dodge_skill;
  parry_skill = target->query_skill("parry");
  dodge_skill = target->query_skill("dodge");
  me->set_temp("apply/attack", 0);
  me->set_temp("apply/damage", 0);
  me->set_temp("apply/dodge", 0);
  target->set_temp("apply/attack", 0);
  target->set_temp("apply/damage", 0);
  target->set_temp("apply/dodge", 0);

  if (!me) return;
  target->delete_temp("xiangling");
  me->set_temp("apply/attack", 0);
  me->set_temp("apply/damage", 0);
  me->set_temp("apply/dodge", 0);

  if (!target) return;
  target->set_temp("apply/attack", 0);
  target->set_temp("apply/damage", 0);
  target->set_temp("apply/dodge", 0);
}

int end_att(object me) {

  if (!me->is_fighting()) {
    me->set_temp("apply/attack", 0);
    me->set_temp("apply/damage", 0);
    me->set_temp("apply/dodge", 0);
  }

  return;
}
private int over(object me, object target, int amount) {
  target->delete_temp("xiangling");
  me->set_temp("apply/attack", 0);
  me->set_temp("apply/damage", 0);
  me->set_temp("apply/dodge", 0);
  message_vision(
    HIW "\n$N吸了一口气，将眼神恢复正常！\n\n" NOR, me);

  return 0;
}
