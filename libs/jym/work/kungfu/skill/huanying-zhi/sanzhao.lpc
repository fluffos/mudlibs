//sanzhao.c  美人三招
#include <ansi.h>
inherit F_DBASE;
inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon;
        int expme,expu,intme,intu,dodgeme,dodgeu,conu,conme,damage;
        mapping myfam;
        string str;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("美人三招只能对战斗中的对手使用。\n");
//        if( !wizardp(me)) 
//               return notify_fail("暂时并未开放此技能。\n");

              weapon = me->query_temp("weapon");
        if( !objectp(weapon) || weapon->query("skill_type") != "sword" )
                return notify_fail("你现在只能使用兵器,才能施展美人三招!\n");

        if (me->query("gender") !="女性") 
			return notify_fail("“美人三招”只有女性才能使用！\n" NOR);

        
        if ( (!( myfam= me->query("family")) || myfam["family_name"] != "神龙教"))
                return notify_fail("你并非神龙弟子,无法使用美人三招！\n");
        
        if( me->query_skill_mapped("force") != "dulong-dafa" )
                return notify_fail("你所用的并非毒龙大法，无法使用美人三招！\n");
        
        if( me->query_skill("dulong-dafa", 1) < 120 )
                return notify_fail("你的毒龙大法功力不够！\n");
        
        if( me->query_skill("sword", 1) < 120 )
                return notify_fail("你的基本剑法不够！\n");
        
        if( me->query_skill("huanying-zhi",1) < 120 )
                return notify_fail("你的神龙幻影指不够熟练！\n");
        
        if( me->query("neili") <= 500 )
                return notify_fail("你的内力不够使用美人三招！\n");
              
              if( (int)me->query_temp("juding") )
                             return notify_fail("你正在使用「子胥举鼎」无法同时施展「美人三招」！\n");
        
              if( me->query("jingli") <= 500 )
                return notify_fail("你的精力不够使用美人三招！\n");
        expme = me->query("combat_exp");
        expu = target->query("combat_exp");
        dodgeme = me->query("dodge");
        dodgeu = target->query("dodge");
        intme = me->query_int();
        intu = target->query_int();
        conme = me->query_con();
        conu = target->query_con();
        damage=me->query_skill("finger",1)*(random(3)+12);     
        if (damage<400) damage=400;    
        message_vision(HIW"\n$N顺势一招「贵妃回眸」反过身来，左手搂住$n头颈，右手握剑对准$n后心，一剑刺去。\n"NOR, me, target);                                  
          if (random(expme) > expu/2)  
	   {
              if (damage>target->query("qi") ) 
                {   
                        message_vision(HIR"\n只见$n躲闪不及，已被刺中后心，一声惨叫，鲜血从伤口涌出。\n"NOR, me, target);                                  
                        target->receive_wound("qi", random(target->query("eff_qi")),me);
                        target->receive_damage("qi",target->query("qi")+1,me);
                }   
                else
                {
                        message_vision(HIR"\n只见$n急忙躲闪，虽未中要害，但看来伤势不轻。\n"NOR, me, target);                         
                        target->receive_wound("qi", damage/3*2, me);
                        target->receive_damage("qi", damage, me);
                }
	
                        str = COMBAT_D->status_msg((int)target->query("qi") * 100 /(int)target->query("max_qi"));
                        message_vision("($N"+str+")\n", target);
         }
         else
         {
                me->start_busy(1);   
                message_vision(HIY"\n$n见此招来势凶猛，高高越起，轻巧地躲了。\n"NOR,me,target);
          }               
      if (living(target) && !target->is_ghost() && target->query("eff_qi")>=0 && target->query("qi")>=0)
      {
        message_vision(HIM"\n$N顺势在地下一个筋斗，在$n的胯下钻过，右手握剑刺入$n的后心,正是一招「小怜横陈」。\n"NOR, me, target);   
          if (random(intme+conme/2) > (intu+conu/3)/2)  
	   {
              if (damage>target->query("qi") ) 
                {   
                        message_vision(HIR"\n只见$n躲闪不及，已被刺中后心，一声惨叫，鲜血从伤口涌出。\n"NOR, me, target);                                  
                        target->receive_wound("qi", random(target->query("eff_qi")),me);
                        target->receive_damage("qi",target->query("qi")+1,me);
                }   
                else
                {
                        message_vision(HIR"\n只见$n急忙躲闪，虽未中要害，但看来伤势不轻。\n"NOR, me, target);                         
                        target->receive_wound("qi", damage/3*2, me);
                        target->receive_damage("qi", damage, me);
                }
	
                        str = COMBAT_D->status_msg((int)target->query("qi") * 100 /(int)target->query("max_qi"));
                        message_vision("($N"+str+")\n", target);
         }
         else
         {
                me->start_busy(1);   
                message_vision(HIY"\n$n见此招来势凶猛，高高越起，轻巧地躲了。\n"NOR,me,target);
          }               
       }
      if (living(target) && !target->is_ghost() && target->query("eff_qi")>=0 && target->query("qi")>=0)
      {       
        message_vision(HIC"\n$N右足向前轻踢，顺势一勾，使出「飞燕回翔」腿上的剑疾向$n的咽喉刺去。\n"NOR, me, target);          
          if(random(dodgeme)>dodgeu/2)
          {               
                if (damage>target->query("qi") )
                {   
                        message_vision(HIR"\n只见$n躲闪不及，已被刺中咽喉，一声惨叫，鲜血从伤口涌出。\n"NOR, me, target);                                  
                        target->receive_wound("qi", random(target->query("eff_qi")),me);
                        target->receive_damage("qi",target->query("qi")+1,me);
                }   
                else
                {
                        message_vision(HIR"\n只见$n急忙躲闪，虽未中要害，但看来伤势不轻。\n"NOR, me, target);                         
                        target->receive_wound("qi", damage/3*2, me);
                        target->receive_damage("qi", damage, me);
                }                           
                str = COMBAT_D->status_msg((int)target->query("qi") * 100 /(int)target->query("max_qi"));
                message_vision("($N"+str+")\n", target);
          } 
          else
          {
                me->start_busy(1);   
                message_vision(HIY"\n$n见此招来势凶猛，高高越起，轻巧地躲了。\n"NOR,me,target);
          }
        }
         me->start_busy(3+random(3));
         me->add("neili", -me->query("jiali")*3-100);
         me->add("jingli",-me->query("jiajin")*3-50);
         return 1;
}

