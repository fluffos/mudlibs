int valid_enable(string usage)
{
        return usage == "finger" || usage == "parry";
}

int valid_learn(object me)
{
        if ( (int)me->query_skill("liumai-shenjian",1) < 120 )
        return notify_fail("六脉神剑只能通过研习来提高！\n");
        return 1;
}

int practice_skill(object me)
{
                if ((int)me->query("jingli") < 600)
                return notify_fail("你的精力太低了。\n");
        if ((int)me->query("neili") < 100)
                return notify_fail("你的内力不够练六脉神剑。\n");
        me->receive_damage("jingli", 100);
        me->add("neili", -100);
        return 1;

}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int)me->query_skill("liumai-shenjian", 1);
		if (random(level) > 275 && me->query("neili") > 1000 ){
			me->add("neili", -60);
            return ([
					"action": HIW"$N内息急转，不断催动真气，「六脉神剑」使得奥妙无方，剑气破空之声更为凌厉，袭向$n的命门大穴" NOR,
					"force" : 600,
					"dodge" : 600,
				    "weapon" : "破体无形剑气",
					"parry" : 120,
					"damage_type" : "刺伤",
                    "damage": (random(2)+2)*100
                    ]);
        }
		if (random(level) > 185 && me->query("neili") > 1000 ){
			me->add("neili",-40);
            return ([
					"action": BLU"$N长笑一声，纵身前扑，双手拇指同时按出一记「少阳剑」，两道无形剑气破空而出，直逼向$n,无坚不摧，势不可挡" NOR,
					"force" : 600,
					"dodge" : 600,
					"weapon": "无形剑气",
					"parry" : 120,
					"damage_type" : "刺伤",
                    "damage": 200
                    ]);
        }
		if (random(level) > 135 && me->query("neili") > 1000 ){
			me->add("neili",-20);
            return ([
                    "action": HIY"$N双手手指急速弹动，「商阳剑」「中冲剑」连续使出，剑气源源不断扑向$n"NOR,
					"force" : 600,
					"dodge" : 600,
					"weapon": "无形剑气",
					"parry" : 120,
					"damage_type" : "刺伤",
                    "damage": 100
                    ]);
        }
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
//        return skill_name[level/30];
}

string perform_action_file(string action)
{
    return __DIR__"liumai-shenjian/" + action;
}

