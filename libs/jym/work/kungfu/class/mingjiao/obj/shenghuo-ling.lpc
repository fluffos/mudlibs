//明教弟子专用    

#include <weapon.h>
#include <ansi.h>
inherit F_AUTOLOAD;
inherit SWORD;
void create()
{
            set_name(RED"圣火令"NOR, ({ "shenghuo ling", "ling" }));
            set_weight(5000);
            if (clonep())
                    set_default_object(__FILE__);
            else { 
                    set("unit", "把");
                     set("long", "这是一把两尺来长的红里透黑的铁牌，非金非铁。质地坚硬无比，\n"
                            "似透明，令中隐隐似有火焰飞腾，实则是令质映光，颜\n"
                            "色变幻。令上刻得有不少波斯文字。它是明教弟子的信物，是明教圣火令的仿制品。 \n");
                    set("material", "steel");
                 set("value", 1000);
               set("no_sell", 1);
               set("no_drop", 1);
               set("no_get", 1);
               set("no_steal", 1);
                set("wield_msg", HIY "$N“唰”的一声，从腰间抽出一片红里透黑的铁牌握在手中。\n");
                set("unwield_msg", HIY "$N将圣火令插回腰间。\n" NOR);
            }
            init_sword(70);
            setup();
     }
int query_autoload() { return 1; }
