// yellow_silk 黄纱裙
// by April 2001.09.29

#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name("黄纱裙", ({ "yellow skirt", "skirt" }));
  set_weight(800);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件美丽的黄纱裙。\n");
    set("material", "cloth");
    set("value", 0);
    set("armor_prop/armor", 8);
    set("armor_prop/personality", 5);
    set("female_only", 1);
  }

  setup();
}
