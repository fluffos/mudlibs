//瘦头陀 
//苹果制造
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
#include "/kungfu/class/shenlong/auto_perform.h"
#include "/d/REGIONS.h";
int do_incense();
int auto_perform();
int ask_job();
int ask_abandon();
void create() {
  set_name("瘦头陀", ({ "shou toutuo", "shou" }));
  set("title", "神龙教护法");
  set("nickname", "辽东瘦尊者");
  set("long",
    "又矮又胖，全身宛如个肉球。\n"
    "衣饰偏又十分华贵，长袍马褂都是锦缎。\n"
    "脸上五官挤在一起，倒是给人硬生生的搓成了一团。\n");
  set("gender", "男性");
  set("age", 44);
  set("attitude", "peaceful");
  set("shen", -80000);
  set("str", 30);
  set("int", 10);
  set("con", 30);
  set("dex", 20);

  set("max_qi", 6000);
  set("max_jing", 6000);
  set("neili", 2000);
  set("max_neili", 2000);
  set("jiali", 0);
  set("combat_exp", 800000);
  set("score", 10000);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));

  set_skill("force", 500);
  set_skill("dulong-dafa", 500);
  set_skill("dodge", 500);
  set_skill("lingshe-shenfa", 500);
  set_skill("poison", 500);
  set_skill("huanying-zhi", 500);
  set_skill("sword", 500);
  set_skill("medicine", 500);
  set_skill("kick", 500);
  set_skill("jueming-tui", 500);
  set_skill("finger", 500);
  set_skill("literate", 100);

  map_skill("force", "dulong-dafa");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("kick", "jueming-tui");
  map_skill("finger", "huanying-zhi");
  map_skill("parry", "huanying-zhi");


  prepare_skill("kick", "jueming-tui");
  prepare_skill("finger", "huanying-zhi");

  create_family("神龙教", 2, "尊者");

  set("inquiry", ([
    "胖头陀": "他是我师弟！",
    "神龙岛": "那是辽东的一个大岛",
    "洪安通": "混蛋，教主的名字能是你说的？",
    "洪教主": "洪教主，仙福永享，寿与天齐",
    "工作": (: ask_job :),
    "job": (: ask_job :),
    "放弃": (: ask_abandon :),
    "abandon": (: ask_abandon :),
  ]));

  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/hook")->wield();

}

void attempt_apprentice(object me)

{

  if (me->query("family/family_name") == "丐帮"
    && me->query("combat_exp") >= 100000) {
    command("say 阁下已经是江湖上赫赫有名的人了，神龙岛可不敢收留。");
    return;
  }
  if (me->query("shenlong/rank") >= 1) {
    command("say 你个叛徒给我滚开！");
    return;
  }
  command("say 好吧，看来你资质不错，本尊者就答应传授你一些武功。");
  command("say 不过你还没有正式成为神龙教的教众，只有通过无根道人才能成为正式的神龙教教众。");
  command("say 你去我师弟那里领个面罩吧。");

  command("recruit " + me->query("id"));
  me->set("title", "神龙教弟子");

}
void destroy_it(object ob) {
  if (ob)
    destruct(ob);
}

int ask_job() {
  string *job_room = ({
    //华山
    "/d/huashan/xianrenqiao",
    "/d/huashan/wushangdong",
    "/d/huashan/sheshen",
    "/d/huashan/huayuan",
    "/d/huashan/zoulang4",
    "/d/huashan/pianting2",
    "/d/huashan/fengding",
    "/d/huashan/canglong",
    //峨嵋
    "/d/emei/wannian",
    "/d/emei/pan12",
    "/d/emei/zhongfeng",
    "/d/emei/qianfo1",
    "/d/emei/xixiang",
    "/d/emei/lenshan2",
    "/d/emei/huazang",
    "/d/emei/duguang2",
    //武当
    "/d/wudang/sanqingdian",
    "/d/wudang/guangchang",
    "/d/wudang/shiliang",
    "/d/wudang/wuyaling",
    "/d/wudang/jindian",
    "/d/wudang/xiaolu2",
    "/d/wudang/wdroad2",
    "/d/wudang/wdroad3",
    //少林
    "/d/shaolin/ruzhou",
    "/d/shaolin/shijie3",
    "/d/shaolin/shijie11",
    "/d/shaolin/guangchang4",
    "/d/shaolin/qfdian",
    "/d/shaolin/dmyuan2",
    "/d/shaolin/zoulang2",
    "/d/shaolin/zhulin6",
    //扬州
    "/d/city/jujinge",
    "/d/city/guangchang",
    "/d/city/minwu2",
    //西域
    "/d/xingxiu/xxh2",
    "/d/xingxiu/tianroad3",
    "/d/xingxiu/shanjiao",
    "/d/xingxiu/shankou",
    "/d/xingxiu/silk1",
    //祁连山
    "/d/qilian/tanglang",
    "/d/qilian/mazong",
    "/d/qilian/prairie",
    //雪山
    "/d/xueshan/shanlu4",
    "/d/xueshan/xshan",
    //杭州		"/d/hangzhou/road62",
    "/d/hangzhou/road77",
    //泉州
    "/d/quanzhou/yaopu",
    "/d/quanzhou/houzhu",
    "/d/quanzhou/dongta",
    "/d/quanzhou/gangkou1",
    "/d/quanzhou/zhongxin",
    //佛山
    "/d/foshan/dlroad3",


  });

  string region, id;
  object me, ob, bangzhong, weapon, room;
  int level, menpai, exp;
  mapping fam;


  me = this_player();
  exp = me->query("combat_exp");
  id = me->query("id");
  level = exp * 9 / 10 / 16025;
  if (me->query("family/family_name") != "神龙教") {
    command("say 阁下打听神龙教秘密所为何事？");
    return 1;
  }
  if (me->query("shenlong/gonglao") < 1000) {
    command("say 你目前的功劳还不够，多做点事情让我相信你再说吧。");
    return 1;
  }

  if (me->query("id") != "pingguo" && base_name(environment(me)) != "/d/city/duchang") {
    command("?");
    command("say 这里是什么地方？");
    message_vision("瘦头陀急急忙忙地离开了。\n", me);
    move("/d/city/duchang");
    message("vision", "瘦头陀急急忙忙地走了过来。\n", environment(this_object()), this_object());
    return 1;
  }

  if (me->query("job_ok")) {
    if (me->query("job_over")) {
      command("nod " + me->query("id"));
      command("say 嘿嘿，" + me->query("find_job") + "被教主废掉了武功，扔在万蛇洞中，已被万蛇所嗜。");
      command("say 反叛神龙教的人，就应该这样收拾。");
    }
    me->delete("find_job");
    me->delete("job_ok");
    me->add("shenlong/quanli", 4);
    set("job_ok/" + id, 1);

    call_out("wait_job", 10, id);
    return 1;
  }

  else if (query("job_ok/" + id)) {
    command("say " + RANK_D->query_respect(me) + "为神龙教尽心尽力，稍微休息休息还有工作给你。");
    return 1;
  }

  else if ((int)me->query_condition("job_fail") > 0) {
    command("hmm " + me->query("id"));
    command("say " + RANK_D->query_respect(me) + "你先去做点别的事情吧。");
    return 1;
  } else if (me->query("find_job")) {
    command("say 先前的" + me->query("find_job") + "你还没有收拾吧？");
    return 1;
  } else {
    ob = new("/d/shenlong/npc/bangzhu_npc");
    bangzhong = new("/d/shenlong/npc/bangzhong");
    room = load_object(job_room[random(sizeof(job_room))]);
    if (strsrch(file_name(room), "/d/") != 0
      || undefinedp(region = region_names[explode(file_name(room), "/")[1]]))
      region = "";

    command("say 哼，你知道么？自从咱们" + ob->query("real_title") + "的卧底" + ob->query("real_name") + "离开本教以后经常与本教作对，你现在去把他给我抓回来。");
    command("say 目前他正在" + region + "的" + room->query("short") + "一带活动。");
    message_vision(HIY "瘦头陀说到：来人！一个教众对着$N走了过来。\n" NOR, me);
    bangzhong->move(environment(me));
    me->set("find_job", ob->query("real_name"));

    bangzhong->set("find_job", ob->query("name"));
    bangzhong->set("find_job_name", ob->query("real_name"));
    bangzhong->set_leader(me);
    bangzhong->set("job_master", me->query("id"));
    bangzhong->set("start", 1);
    bangzhong->set("job_region", region);
    bangzhong->set("job_room", room->query("short"));
    bangzhong->start_check(me);

    bangzhong->set("combat_exp", exp * 9 / 10);
    bangzhong->set("dex", 20 + random(10));
    bangzhong->set("int", 10 + random(20));
    bangzhong->set("con", 5 + random(5));
    bangzhong->set("dex", 20 + random(10));

    bangzhong->set("max_qi", level * 20);
    bangzhong->set("eff_qi", level * 20);
    bangzhong->set("qi", level * 20);
    bangzhong->set("max_jingli", level * 22);
    bangzhong->set("jingli", level * 22);
    bangzhong->set("eff_jingli", level * 22);
    bangzhong->set("max_jing", level * 20);
    bangzhong->set("eff_jing", level * 20);
    bangzhong->set("jing", level * 20);
    bangzhong->set("max_neili", level * 25);
    bangzhong->set("neili", level * 25);

    bangzhong->set_skill("force", level);
    bangzhong->set_skill("dodge", level);
    bangzhong->set_skill("parry", level);
    bangzhong->set_skill("dulong-dafa", level);
    bangzhong->set_skill("lingshe-shenfa", level);
    bangzhong->set_skill("hook", level);
    bangzhong->set_skill("ruyi-gou", level);
    bangzhong->set_skill("strike", level);
    bangzhong->set_skill("finger", level);
    bangzhong->set_skill("sword", level);
    bangzhong->set_skill("huanying-zhi", level);
    bangzhong->set_skill("huagu-mianzhang", level);
    bangzhong->set_skill("dulong-dafa", level);
    bangzhong->set_skill("medicine", level * 2 / 3);
    bangzhong->set_skill("poison", level * 2 / 3);



    ob->move(room);
    ob->set("job_target", me->query("id"));
    message("vision", ob->query("name") + "快步走了过来。\n", room, ob);
    ob->random_move();

    if (me->query("id") == "pingguo") {
      tell_object(me, "您好苹果，此人目前在" + base_name(room) + "\n");
    }
    return 1;
  }
}

int ask_abandon() {
  object me, ob, bangzhong, weapon, room;
  int exp;
  me = this_player();
  exp = me->query("combat_exp");

  if (!me->query("find_job")) {
    command("? " + me->query("id"));
    return 1;
  } else if (me->query("job_ok")) {
    command("haha " + me->query("id"));
    command("say " + RANK_D->query_respect(me) + "真爱开玩笑，这" + me->query("find_job") + "已经被你收拾了，不是吗？");
    return 1;
  }


  else {
    command("say 收拾不了那个" + me->query("find_job") + "？");
    command("slap " + me->query("id"));
    command("say 滚滚滚！做点事情都做不好！。");
    tell_object(me, BRED + HIY "做事情推三阻四，这次扣除你100点功劳！下次绝不轻饶。\n" NOR);
    me->delete("find_job");
    me->add("shenlong/quanli", -1);
    me->add("shenlong/gonglao", -100);
    me->apply_condition("job_fail", 10);
    return 1;
  }

}

void wait_job(string id) {
  delete("job_ok/" + id);
}
