//张淡月
inherit NPC;
inherit F_MASTER;
#include "/kungfu/class/shenlong/auto_perform.h"
#include <ansi.h>
int do_incense();
int auto_perform();
int ask_ling();
void create() {
  set_name("张淡月", ({ "zhang danyue", "zhang" }));
  set("title", "神龙教黑龙使");
  set("long",
    "身材适当，看起来功夫不错，不过有点木罢了。\n");
  set("gender", "男性");
  set("age", 43);
  set("attitude", "peaceful");
  set("shen", -50000);
  set("str", 30);
  set("int", 10);
  set("con", 30);
  set("dex", 20);

  set("max_qi", 6000);
  set("max_jing", 6000);
  set("neili", 2000);
  set("max_neili", 2000);
  set("jiali", 100);
  set("combat_exp", 800000);
  set("score", 10000);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));

  set_skill("force", 200);
  set_skill("dulong-dafa", 200);
  set_skill("dodge", 200);
  set_skill("lingshe-shenfa", 200);
  set_skill("poison", 200);
  set_skill("huanying-zhi", 200);
  set_skill("sword", 200);
  set_skill("kick", 200);
  set_skill("medicine", 200);

  set_skill("jueming-tui", 200);
  set_skill("finger", 200);
  set_skill("literate", 110);

  map_skill("force", "dulong-dafa");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("sword", "huanying-zhi");
  map_skill("kick", "jueming-tui");
  map_skill("finger", "huanying-zhi");
  map_skill("parry", "jueming-tui");


  prepare_skill("kick", "jueming-tui");
  prepare_skill("finger", "huanying-zhi");

  create_family("神龙教", 2, "黑龙使");
  set("inquiry", ([
    "神龙岛": "神龙岛又叫蛇岛。",
    "五龙令": "五龙令乃是教主所赠，犹如教主亲临，跟皇帝的圣旨一样。",
    "黑龙令": (: ask_ling :),


  ]));

  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();

}

void init() {
  ::init();
  add_action("do_find", "find");
  add_action("do_find", "wen");
}

void attempt_apprentice(object ob) {
  mapping fam;

  if (!mapp(fam = ob->query("family")) || fam["family_name"] != "神龙教") {
    command("shake " + ob->query("id"));
    command("say " + RANK_D->query_respect(ob) +
      "去找扬州的胖瘦尊者吧。");
    return;
  }
  command("recruit " + ob->query("id"));
  ob->set("title", "神龙教弟子");

  return;
}

void destroy_it(object ob) {
  if (ob)
    destruct(ob);
}

string ask_ling() {
  string title;
  mapping myfam;
  object me, ling;
  me = this_player();


  myfam = (mapping)me->query("family");

  if (!myfam || myfam["family_name"] != "神龙教")
    return "咱们豪无渊源，你问这事干嘛？\n";

  if (me->query_temp("shenlong/ling"))
    return "哦？你不是已经有令了么？\n";

  if (!me->query_temp("shenlong/askling"))
    return "没得到教主许可，我无法给你五龙令！\n";

  title = WHT "神龙教黑龙门副使" NOR + " " + me->query("name") + "(" + capitalize(me->query("id")) + ")"; ;

  me->set_temp("apply/short", ({ title }));
  me->delete_temp("shenlong/askling");
  me->set_temp("shenlong/ling", 1);
  ling = new("/d/shenlong/obj/hling");
  ling->move(this_player());
  message_vision("张淡月给$n一面$N。\n" NOR, ling, me);
  return "既然教主已经许可，我也就没什么说的了。";
}

int do_find(string arg) {
  object ob, where, env, me = this_player();
  string region;



  if (me->query("shenlong/quanli") < 10)
    return notify_fail("你的权利太小，无法让张淡月帮你找人。\n");

  if (!living(this_object()))
    return notify_fail("嗯....你得先把张淡月弄醒再说。\n");

  if (this_object()->is_busy())
    return notify_fail("张淡月说道：没看见我忙着呢。\n");

  if (this_object()->query("jing") < 50)
    return notify_fail("张淡月现在的精神状况不佳。\n");

  if (!arg) return notify_fail("你要找谁？\n");

  if (!(ob = find_player(arg)))
    if (!(ob = find_living(arg)))
      return notify_fail("张淡月说道：有这个人么？\n");

  if (ob == me)
    return notify_fail("找自己的位置？没这个必要吧。\n");

  if (ob == this_object())
    return notify_fail("要张淡月找张淡月？没道理吧。\n");

  write("\n你悄声对张淡月说道：麻烦黑龙使替我找找" + ob->name() + "的所在。\n\n");
  tell_room(environment(me), "\n" + me->name() + "低声对张淡月说了些话。\n", ({ me, this_object() }));

  message_vision(HIW "张淡月拍了拍手来了一个教众。\n张淡月在教众耳边说了些话……\n教众急急忙忙地离开了。\n\n" NOR, me);
  message_vision(HIY "一个教众急急忙忙走了过来。\n教众在张淡月耳边说了些话……\n\n" NOR, me);

  me->add("shenlong/quanli", -10);

  if (!(where = environment(ob))) {
    command("hmm");
    return notify_fail("张淡月告诉你：这个人现在无法找到。\n");
  }
  if (!wizardp(me) && wizardp(ob)) {
    command("hmm");
    return notify_fail("张淡月说道：…………。\n");
  }
  if (strsrch(file_name(where), "/d/") != 0) {
    command("doubt zhang danyue");
    return notify_fail("张淡月告诉你：这个人现在无法找到。\n");
  }

  env = environment(me);

  if (me->query_kar() > ob->query_kar() / 3 + random(ob->query_kar() * 2 / 3)) {

    command("whisper " + me->query("id") + " " + ob->name() + "(" + ob->query("id") + ")现在在" + where->query("short") + "。");
  } else if (me->query_kar() > random(ob->query_kar() / 2)) {
    command("whisper " + me->query("id") + " " + ob->name() + "(" + ob->query("id") + ")现在在" + where->query("short") + "一带。");
  } else {
    command("sigh2");
  }

  return 1;
}
