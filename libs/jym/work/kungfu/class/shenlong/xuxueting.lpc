//许雪亭
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int do_incense();
#include "/kungfu/class/shenlong/auto_perform.h"
int auto_perform();
int ask_muti();
int ask_ling();
void create() {
  set_name("许雪亭", ({ "xu xueting", "xu" }));
  set("title", "神龙教青龙使");
  set("long",
    "高瘦汉子，目光炯炯，看上去十分干练。\n");
  set("gender", "男性");
  set("age", 48);
  set("attitude", "peaceful");
  set("shen", -50000);
  set("str", 30);
  set("int", 10);
  set("con", 30);
  set("dex", 20);

  set("max_qi", 6000);
  set("max_jing", 6000);
  set("neili", 2000);
  set("max_neili", 2000);
  set("jiali", 0);
  set("combat_exp", 800000);
  set("score", 10000);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));


  set_skill("force", 200);
  set_skill("dulong-dafa", 200);
  set_skill("dodge", 200);
  set_skill("lingshe-shenfa", 200);
  set_skill("poison", 200);
  set_skill("huanying-zhi", 200);
  set_skill("sword", 200);
  set_skill("kick", 200);
  set_skill("medicine", 200);

  set_skill("jueming-tui", 200);
  set_skill("finger", 200);
  set_skill("literate", 110);

  map_skill("force", "dulong-dafa");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("sword", "huanying-zhi");
  map_skill("kick", "jueming-tui");
  map_skill("finger", "huanying-zhi");
  map_skill("parry", "jueming-tui");


  prepare_skill("kick", "jueming-tui");
  prepare_skill("finger", "huanying-zhi");

  create_family("神龙教", 2, "青龙使");
  set("inquiry", ([
    "洪安通": "这三个字是你说的吗？",
    "洪教主": "洪教主仙福永享，寿与天齐，洪教主神目如电，烛照四方。",
    "五龙令": "五龙令乃是教主所赠，犹如教主亲临，跟皇帝的圣旨一样。",
    "青龙令": (: ask_ling :),
    "muti": (: ask_muti :),
    "木梯": (: ask_muti :),

  ]));


  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();

}
void attempt_apprentice(object ob) {
  mapping fam;

  if (!mapp(fam = ob->query("family")) || fam["family_name"] != "神龙教") {
    command("shake " + ob->query("id"));
    command("say " + RANK_D->query_respect(ob) +
      "去找扬州的胖瘦尊者吧。");
    return;
  }
  command("recruit " + ob->query("id"));
  ob->set("title", "神龙教弟子");

  return;
}

void destroy_it(object ob) {
  if (ob)
    destruct(ob);
}

string ask_muti() {
  object player = this_player();
  object muti;
  mapping fam;
  if (!(fam = this_player()->query("family")) || fam["family_name"] != "神龙教") {
    command("?");
    return 0;
  }
  if (objectp(present("mu ti", player))) {
    return "你不是有木梯了么？\n";
  }
  muti = new("/d/shenlong/obj/muti");
  muti->move(player);
  message_vision("$N从身后的架子上拿出一架木梯交给$n。\n", this_object(), player);
  return "用完了记得还给我。\n";
}
string ask_ling() {
  string title;
  mapping myfam;
  object me, ling;
  me = this_player();


  myfam = (mapping)me->query("family");

  if (!myfam || myfam["family_name"] != "神龙教")
    return "咱们豪无渊源，你问这事干嘛？\n";

  if (me->query_temp("shenlong/ling"))
    return "哦？你不是已经有令了么？\n";

  if (!me->query_temp("shenlong/askling"))
    return "没得到教主许可，我无法给你五龙令！\n";

  title = HIC "神龙教青龙门副使" NOR + " " + me->query("name") + "(" + capitalize(me->query("id")) + ")"; ;

  me->set_temp("apply/short", ({ title }));
  me->delete_temp("shenlong/askling");
  me->set_temp("shenlong/ling", 1);
  ling = new("/d/shenlong/obj/qling");
  ling->move(this_player());
  message_vision("许雪亭给$n一面$N。\n" NOR, ling, me);
  return "既然教主已经许可，我也就没什么说的了。";
}
