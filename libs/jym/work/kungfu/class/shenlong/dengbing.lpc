// Code of JYM
// deng bingchun 邓炳春

inherit NPC;
// inherit F_MASTER;

void create() {
  set_name("邓炳春", ({ "deng bingchun", "deng" }));
  set("title", "神龙教黑龙使座下");
  set("long",
    "他是张淡月的弟子。\n");
  set("gender", "男性");
  set("age", 33);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 80);
  set("int", 80);
  set("con", 80);
  set("dex", 80);
  set("max_qi", 8000);
  set("max_jing", 5000);
  set("neili", 12000);
  set("max_neili", 12000);
  set("jingli", 10000);
  set("max_jingli", 10000);
  set("jiali", 30);
  set("combat_exp", 5000000);
  set("score", 50000);
  set("shen", -8000);

  set_skill("force", 300);
  set_skill("dulong-dafa", 300);
  set_skill("dodge", 300);
  set_skill("lingshe-shenfa", 300);
  set_skill("strike", 300);
  set_skill("huagu-mianzhang", 300);
  set_skill("parry", 300);
  set_skill("blade", 300); ;

  map_skill("force", "dulong-dafa");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("strike", "huagu-mianzhang");
  map_skill("parry", "huagu-mianzhang");

  prepare_skill("strike", "huagu-mianzhang");

  create_family("神龙教", 3, "黑龙门弟子");

  setup();
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("/clone/misc/cloth")->wear();

}
