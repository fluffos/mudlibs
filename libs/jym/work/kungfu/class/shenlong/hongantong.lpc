inherit NPC;
inherit F_MASTER;

int auto_perform();
int waiting(object me);
int checking(object me);
int do_chase(object me);
int ask_gift();
int ask_perform();
int ask_job();
int ask_hgmz();
int do_kill(object me, object dest);



void create()
{
        set_name("洪安通", ({ "hong antong", "hong", "jiaozhu" }));
        set("long",                 
            "年纪甚老，白鬓垂胸，脸上都是伤疤皱纹，丑陋之极。\n");
        set("title", "神龙教教主");
            set("shenlong/huanxie_canuse", 1);
        set("gender", "男性");
        set("age", 59);


        set_skill("force", 800);
        set_skill("dulong-dafa", 800);
        set_skill("dodge", 800);
        set_skill("lingshe-shenfa", 800);
        set_skill("strike", 800);
        set_skill("huagu-mianzhang", 800);
        set_skill("parry", 800);
        set_skill("kick", 800);
        set_skill("jueming-tui", 800);        
        set_skill("poison", 800);
        set_skill("literate", 800);
        set_skill("medicine", 800);
        set_skill("shenlong-bashi", 800);
        set_skill("hand", 800);
        set_skill("finger", 800);
        set_skill("huanying-zhi", 800);

        map_skill("strike","huagu-mianzhang");
        map_skill("finger","huanying-zhi");
        map_skill("hand","shenlong-bashi");
        map_skill("dodge","lingshe-shenfa");
        map_skill("parry", "huagu-mianzhang");
        map_skill("force","dulong-dafa");
        map_skill("kick","jueming-tui");


        prepare_skill("kick","jueming-tui");
        prepare_skill("strike","huagu-mianzhang");

        set("str", 33);
        set("int", 28);
        set("con", 29);
        set("dex", 28);

        set("neili", 12000);
        set("jingli", 8000);
        set("qi", 9000);
        set("max_qi", 9000);
        set("max_jingli", 8000);
        set("max_neili", 12000);
        set("jiali", 300);
        set("combat_exp", 6400000);

                  set("attitude", "peaceful");
                  set("shen_type", -1);

                  create_family("神龙教", 1 , "岛主");
                  set("chat_chance_combat", 50);
                  set("chat_msg_combat", ({
                         (: auto_perform :),
                  }) );
        set("inquiry", ([
                "神龙教" : "哈哈，这是老夫创立的神教。",
                "神龙岛" : "神龙岛又叫蛇岛。",
                "化骨绵掌" : (: ask_hgmz :),
                "hgmz" : (: ask_hgmz :),
                "神龙绝技" : (: ask_perform :),
                "perform" : (: ask_perform :),
                "神龙圣药" : (: ask_gift :),
                "drug" : (: ask_gift :),
                "job" : (: ask_job :),
                "工作" : (: ask_job :),
                "任务" : (: ask_job :),


        ]));

        setup();
        carry_object("/d/city/obj/cloth")->wear();
        set_temp("job_pos",10);

}


init()
{
		  object ob = this_player();

		  ::init();

		  add_action("do_kill_sb","kill");
		  add_action("do_kill_sb","hit");
		  add_action("do_throw","throw");
}


int do_throw(string arg)
{
		  object victim, ob1, ob, me = this_player();
		  string what, who;

		  if( !arg
		  ||      sscanf(arg, "%s at %s", what, who)!=2)
					 return notify_fail("命令格式: throw <物品> at <某人>。\n");

		  ob = present(what, me);
		  if( !ob ) ob = present(arg, environment(me));
		  if( !ob ) return notify_fail("你要扔什么？\n");

		  if (ob->query("no_drop"))
					 return notify_fail("这个东西不能离开你。\n");

		  if (!(victim = present(who, environment(me))))
					 return notify_fail("这里没有你的目标。\n");

		  if (!victim)
					 return notify_fail("这里并无此人！\n");

		  if (!living(victim))
					 return notify_fail("这不是活物！\n");

		  if ( victim->query("id") == me->query("id")  ) {
					 return notify_fail("自己杀自己？\n");
		  }

		  if ( victim->query("family/family_name") == "神龙教"  ) {
				message_vision("$n想要偷袭$N！！！\n", victim, me);
				message_vision( "$N一声冷笑：大胆狂徒！敢来我神龙教行凶杀人！\n", this_object() );
				this_object()->kill_ob(me);
				return 1;
		  }

	return 0;
}


int do_kill_sb(string arg)
{
		  object ob, ob1=this_object(), me = this_player();

		  if ( !arg || arg == "" ) return 0;

		  if ( !ob=present(arg, environment(me)) ) return 0;
		  if ( ob->query("id") == me->query("id")  ) {
					 return notify_fail("自己杀自己？\n");
		  }

		  if ( ob->query("family/family_name") == "神龙教"  && ob != ob1 ) {
			  message_vision("$n对著$N喝道：「"+RANK_D->query_rude(ob)+"！今日不是你死就是我活！」\n", ob, me);
				message_vision("$N一声冷笑：大胆狂徒！敢来我神龙教行凶杀人！\n", ob1);
				ob1->kill_ob(me);
				return 1;
		  }


		  return 0;
}


void attempt_apprentice(object ob)
{
                  mapping fam;

if( !mapp(fam = ob->query("family")) || fam["family_name"] != "神龙教")
        {
                command ("say " + RANK_D->query_respect(ob) +
                        "去找五龙使吧，他们负责寻找新的教众。");
                return;
        }
        if ((int)ob->query_skill("dulong-dafa", 1) < 120) {
                command("say 恩。。。。"); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否还应该在毒龙大法上多下点功夫？");
                return;
        }

        if ((int)ob->query_skill("medicine", 1) < 180) {
                command("say " + RANK_D->query_respect(ob) + 
                        "的药理学不够。");
                return;
        }

        if ((int)ob->query_skill("poison",1) < 50) {
                command("say 你的毒技太低了。");
                                         return;
        }


        command("pat "+ob->query("id"));
        command("say 我就传授你我的绝技“化骨绵掌”！");
        command("recruit " + ob->query("id"));
        command("say " +ob->query("name")+ "你可以在竹林输入open bamboo进入密室。");
        ob->set("shenlong/mishi",1);
        ob->set_skill("huagu-mianzhang",10);
        command("chat 哈哈，我神龙教又多了"+ob->query("name")+"这一顶梁柱！");
        command("menpai* 高声宣布:");
        command("menpai 我神龙教又多了"+ob->query("name")+"这一顶梁柱！");
        command("say 你有什么练功上不明白的尽管来问我吧！");
        tell_object(ob,BRED+HIY"恭喜你学到神龙教绝技“化骨绵掌”\n"NOR);
        return;
}




int accept_object(object me, object obj)
{
        
                if (obj->query("id")=="sishier zhangjing") {
                     command("nod");
                     command("thumb "+me->query("id"));
                     command("say 就是它！");
                            message_vision(HIR"\n恭喜$N寻找到一本四十二章经。\n"NOR,me);
                           me->add("shenlong/give_42jing",1);

                     return 1;
                 }
                 command("slap "+me->query("id"));
                 command("say 你这个笨蛋，不是这个东西！还不去找");
                 return 0;
        
 
}


void destroy_it(object obj)
{
        if(obj)
        destruct(obj);
}


void unconcious()
{
        message_vision("\n只见$N打开座椅上的机关，从地道溜走了。\n", this_object());
        destruct(this_object());
}
void die()
{
        message_vision("\n$N手脚抽搐，挣扎几下就死了。\n", this_object());
        destruct(this_object());
}

string ask_hgmz()
{
        object me = this_player();
        mapping myfam;
        myfam = (mapping)me->query("family");

        if ( !myfam || myfam["family_name"] != "神龙教" )
                return "咱们豪无渊源，你问这事干嘛？\n";

        say("洪安通说道：此乃老夫所创的绝技，此掌威力无比，以内劲毒伤敌\n");
        say("洪安通说道：中毒者内力，精力均慢慢化去。\n");
        say("洪安通说道：所练此功，需体内蓄存内劲毒，但体内毒素过多无法排除，则无法提高。\n");
        return "每当你提高此功到二百级时，须将毒素排除，方能提高，此时化骨绵掌将尽数废除，十分危险。";
}
string ask_job()
{
        object me = this_player();

        mapping myfam;
        myfam = (mapping)me->query("family");

        if ( !myfam || myfam["family_name"] != "神龙教" )
        { 
                return "咱们豪无渊源，你问这事干嘛？\n";
        }

	 if( me->query_temp("shenlong/ling"))
        {
                return "哦？你不是已经有令了么？\n";
        }
	 if( me->query_temp("shenlong/askling"))
        {
                return "我不是让你去找五龙使了么？\n";
        }

        if(me->query("shenlong/gonglao") < 20000)
        {
                return "你目前的功劳还不够，多做点事情让我相信你再说吧。";
        }
        if(me->query("shenlong/rank") < 2)
        {
                return "就凭你目前在神龙教的地位？我看还是算了吧。";
        }
        if(me->query("combat_exp") < 500000)
        {
                return "你江湖经验太浅，还是多多磨练再说吧。";
        }
        say("洪安通说道：哼！白龙使竟然带清兵来攻打我们神龙教。\n");
        say("洪安通说道：你在我教时间不短了，功绩显赫这是大家所能看见的。\n");
        say("洪安通说道：我现在提升你为神龙教副使，你去找五龙使要五龙令吧。\n");
        me->set_temp("shenlong/askling", 1);
        return "快去找五龙使吧。";

}

int ask_perform()
{
        object obj;
        object me = this_player();
        object ob = this_object();

        if(me->query_skill("dulong-dafa", 1) <200)
        {
                message_vision("$N对$p说道：你的毒龙大法还不够，这个功夫还是不教你的好。\n", ob,me);
                return 1;
        }

        
        if(me->query("shenlong/give_42jing")<4)
        {
                message_vision("$N不屑地对$p说道：你的本教主的功劳太小，老夫不能传授你这个技能。\n", ob,me);
                return 1;
        }
        else
        {
        message_vision(HIG"$N对$p说道：看在你为教主搜集经书功劳显著我就教你这样技能。\n"NOR, ob,me);
        message_vision(HIG"$N在$p身上点了几个穴位，$p浑身说不出的舒服。\n"NOR, ob,me);
        me->add("shenlong/give_42jing",-4);
              me->set("shenlong/huanxie_canuse",1);
        }
        
        return 1;
}

int ask_gift()
{
        object obj;
        object me = this_player();
        object ob = this_object();
            object env, link_ob, obj2, place;
            int gengu;
                
            if (me->query("shenlong/add_gift"))
        {
                        command("shake "+getuid(me));
                        command("say 此药无法服用两次。");
                                return 1;
        }

        if(me->query_skill("dulong-dafa", 1) <200)
        {
                message_vision("$N对$p说道：你的毒龙大法还不够，这个药还是不吃的好。\n", ob,me);
                return 1;
        }

        if(me->query("shenlong/give_42jing")<8)
        {
                message_vision("$N不屑地对$p说道：你的本教主的功劳太小，老夫不能给你这个圣药。\n", ob,me);
                return 1;
        }
        else
        {
        message_vision(HIG"$N对$p说道：看在你为教主搜集经书功劳显著我就赏赐你豹胎易筋丸。\n"NOR, ob,me);
        message_vision(HIW"$N在$p身上点了几个穴位，将一粒药丸放入$p的嘴里。\n"NOR, ob,me);
              tell_object  (me,HIY"你一吞下豹胎易筋丸，便觉内息澎湃，急浪般涌入四肢百骸，全身骨节格格爆响。\n"NOR);
              tell_object  (me,HIY"接着又觉身轻如燕，几欲腾空飞去。看来你已经脱胎换骨，功力大进了！\n"NOR);
                        gengu = 1+random(2);
              me->add("shenlong/give_42jing",-8);
              me->set("shenlong/add_gift",1);
              me->add("max_neili",2000);
              me->add("eff_jingli",2000);
              me->add("combat_exp",(random(20000)));
             me->add("str",1);
              me->add("con",gengu);
                me->add("dex",1);
              me->set("shenlong/add/str",1);
              me->set("shenlong/add/con",gengu);
              me->set("shenlong/add/dex",1);
              me->save();

                link_ob = me->query_temp("link_ob");
                obj2 = LOGIN_D->make_body(link_ob);
                if (!obj2) return 0;

                me->save();
                exec(link_ob, me);
                destruct(me);

                obj2->restore();
                LOGIN_D->enter_world(link_ob, obj2, 1);
                write("身体更新完毕。\n");
//为了当初测试方便增加！
//              write(CYN"你增加了1点膂力"+gengu+"点根骨和1点身法！\n"NOR);

                write(CYN"因为豹胎易筋丸的药效，你的先天已经更改，并且功力提高了！\n\n"NOR);

                obj2->move("/d/shenlong/qianlong");
                obj2->write_prompt();

                obj2->set("neili", me->query("max_neili"));
                obj2->set("jingli", me->query("max_jingli"));
                obj2->set("eff_qi", me->query("max_qi"));
                obj2->set("qi", me->query("max_qi"));
                obj2->set("eff_jing", me->query("max_jing"));
                obj2->set("jing", me->query("max_jing"));
                obj2->save();


        }
        
        return 1;
}

int accept_kill(object obj)
{
        object me = this_object();
        mapping skill_status;
        string *sname;
        int i, max = 200;

        command("exert powerup");
        command("exert recover");


        return 1;

}

