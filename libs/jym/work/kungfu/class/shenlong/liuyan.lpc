// liu yan 柳燕

inherit NPC;

void create()
{
	set_name("柳燕", ({ "liu yan","liu" }));
        set("title", "神龙教黑龙使座下");
	set("long",
                "她是张淡月的弟子，体态极肥，脸如满月，眼小嘴大。\n");
	set("gender", "女性");
	set("age", 35);
	set("attitude", "peaceful");
	set("shen_type", -1);
	set("str", 80);
	set("int", 80);
	set("con", 80);
	set("dex", 80);
	set("max_qi", 8000);
	set("max_jing", 5000);
	set("neili", 12000);
	set("max_neili", 12000);
	set("jingli", 10000);
	set("max_jingli", 10000);
	set("jiali", 30);
	set("combat_exp", 5000000);
	set("score", 50000);
	set("shen", -8000);

	set_skill("force", 300);
	set_skill("dulong-dafa", 300);
	set_skill("dodge", 300);
        set_skill("lingshe-shenfa", 300);
	set_skill("strike", 300);
	set_skill("huagu-mianzhang", 300);
	set_skill("parry", 300);
	set_skill("blade", 300);;

	map_skill("force", "dulong-dafa");
	map_skill("dodge", "lingshe-shenfa");
	map_skill("strike", "huagu-mianzhang");
	map_skill("parry", "huagu-mianzhang");

	prepare_skill("kick", "jueming-tui");

	create_family("神龙教", 3, "黑龙门弟子");

	setup();
	carry_object("/clone/armor/flower_shoe")->wear();
	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/hook")->wield();

}
