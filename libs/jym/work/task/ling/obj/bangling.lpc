#define BANGZHU   "/d/huanghe/npc/bangzhu"

#include <ansi.h>
#include <localtime.h>

inherit ITEM;

#include "/d/REGIONS.h"
#include "/d/huanghe/doc/info_store.h"

void create() {
  set_name("密令", ({ "mi ling", "ling" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一块帮会中常用的帮令。\n");
    set("value", 0);
    set("material", "wood");
    set("no_drop", "这样东西不能离开你。\n");
    set("no_get", "这样东西不能离开那儿。\n");
  }
  setup();
}

void init() {
  add_action("do_find", "find");
}

int do_find(string arg) {
  string result;
  mapping job;

  if ((string)query("owner") != this_player()->query("id")) {
    write("你连自己的帮令都管不好，还是离开帮会吧。\n");
    return 1;
  }

  if (arg != "job") {
    write("什么？\n");
    return 1;
  }

  if (!mapp(job = query("job"))) {
    write("你现在没有被指派帮务。\n");
    return 1;
  }

  result = "你当前的帮务是";
  result += "护送帮主至" + job["dest"];

  write(result + "。\n");
  return 1;
}
