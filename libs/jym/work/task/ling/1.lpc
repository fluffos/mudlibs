#ifndef BANGS
#define BANGS  "/task/ling/"
#endif

#define BANGLING   BANGS + "obj/bangling"
#define BAOHU_NPC   BANGS + "npc/npc1"

inherit NPC;
inherit F_SSERVER;

#include <ansi.h>
#include <localtime.h>

#include "/task/ling/doc/info_destine.h"
#include "/d/REGIONS.h"

string ask_job();

void create() {
  set_name("任务使", ({ "renwu shi", "shi" }));
  set_color("$YEL$");
  set("gender", "男性");
  set("age", 25);

  set("long", "这人真名叫做燕小六，是一个带有浓重天津口音的衙门捕头。\n");
  set("combat_exp", 75000);
  set("shen_type", 1);
  set_skill("unarmed", 40);
  set_skill("dodge", 90);
  set("inquiry", ([
    "帮务": (: ask_job :),
    "job": (: ask_job :),
  ]));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}

string ask_job() {
  object me = this_player(), leader, ling, ob, *obj, dest, room;
  string myfam, *files, file, region, biaoju, ob_bang;
  string *mydests, mydest, *starts;
  int i, temp, myexp;
  mapping job, destine;

  if (!(ling = present("mi ling", me))) {
    ling = new(BANGLING);
    ling->set("owner", me->query("id"));
    //                ling->set("fam", myfam);
    ling->set("combat_exp", query("combat_exp"));
    ling->move(me);
    message_vision("$N把一" + ling->query("unit") + ling->name() + "扔给$n。\n", this_object(), me);
  }

  if (time() < (int)me->query("husong/asktime") + 600) {
    //                if( mapp(ling->query("job")) )
    return me->name() + "，你不是刚问过我吗？";
  }

  me->set("husong/asktime", time());

  region = explode(base_name(environment()), "/")[1];
  starts = keys(info_destine);
  if (member_array(region, starts) == -1) {
    command("shake");
    return "你歇着吧，最近没有要紧的事。";
  }
  destine = info_destine[region];
  mydests = keys(destine);
  mydest = mydests[random(sizeof(mydests))];
  ling->set("job/dest", region_names[mydest]);
  ling->set("job/bonus", destine[mydest]);
  ob = new(BAOHU_NPC);
  ob->set("name", "神秘人物");
  ob->set("title", me->query("name") + "护送的");
  ob->set("dest", mydest);
  me->set_leader(ob);
  ob->set("helper", me);
  command("nod");
  ob->move(environment());
  return "说道：我最近身体有些不适，你现在就替我护送他至" + region_names[mydest] + "吧。一路小心哦！\n";

}
