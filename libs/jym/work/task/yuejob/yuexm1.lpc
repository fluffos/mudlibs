// yue.c 岳小玫
// lag 2000.5.9
#include <ansi.h>

inherit NPC;
#include "/d/REGIONS.h";
int ask_job();
int ask_fail();
void assign_baohu(object me, string where);

void create() {
  set_name("岳小玫", ({ "yue xiaomei", "yue" }));
  set_color("$YEL$");
  set("title", "鲜花店老板娘");
  set("gender", "女性");
  set("age", 20);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("per", 55);

  set("qi", 6000);
  set("max_qi", 6000);
  set("jing", 6000);
  set("max_jing", 6000);
  set("neili", 6000);
  set("max_neili", 6000);
  set("jiali", 50);
  set("combat_exp", 8000000);
  set("score", 300000);

  set_skill("force", 300);
  set_skill("sword", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("finger", 300);
  set_skill("literate", 300);
  set("inquiry", ([
    "任务": (: ask_job() :),
    "work": (: ask_job() :),
    "job": (: ask_job() :),
    "失败": (: ask_fail() :),
    "fail": (: ask_fail() :),
    "放弃": (: ask_fail() :),
  ])),

    set("env/important", 1);

  setup();
  carry_object("/d/city/obj/cloth")->wear();
}

int ask_job() {

  object me = this_player();
  object ob;
  mapping quest;
  mapping skl;
  string *sname, place, qname, aname;
  int i, myexp, skill = 0;

  if (me->query("id") == "muder") {
    assign_baohu(me, "/d/city/guangchang");
    return 1;
  }

  if (time() < (int)me->query("noask/yuejob") + 90 + random(60)) {
    //			command("hmm "+(string)me->query("id"));
    //			command("say "+(string)me->query("name")+"，现在我这里没什么事要你做。");
    write("岳小玫对你说道：" + (string)me->query("name") + "，现在我这里没什么事要你做。\n");
    write("看起来岳小玫似乎对你并不是很信任！\n");
    return 1;
  }
  if (time() < (int)me->query("noask/yuejob_next") + 40 + random(100 - ((int)me->query("kar") + (int)me->query("per")))) {
    //			command("consider");
    //			command("say "+(string)me->query("name")+"啊，最近风平浪静的，我这里没什么事要你做。");
    write("岳小玫对你说道：" + (string)me->query("name") + "啊，最近风平浪静的，我这里没什么事要你做。\n");
    return 1;
  }
  quest = (__DIR__ "lagjob")->query_quest();

  skl = me->query_skills();
  if (!skl) {
    tell_object(me, "你去学一些本事先吧！\n");
    return 1;
  }
  if (me->query("combat_exp") < 80000) {
    command("say " + RANK_D->query_respect(me) + "杀采花大盗可不是一件容易的事情，你还是等你有了8万经验再来吧");
    return 1;
  }
  if (me->query("combat_exp") > 30000000) {
    command("admire " + (string)me->query("id"));
    command("say " + RANK_D->query_respect(me) + "是人间奇才,我哪里敢劳您的大驾呢！");
    return 1;
  }
  if (me->query("potential") < 200 || me->query("combat_exp") < 80000) {
    command("say 你连本钱都没有，我怎么放心要你去杀采花大盗呢？\n");
    return 1;
  }

  if (time() < (int)me->query("yuejob/asktime") + 60) {
    command("say 我刚才不是已经告诉过你了吗？\n");
    return 1;
  } else if (me->query("yuejob/kill_qiangdao") == 1) {
    command("kick " + me->query("id"));
    command("whisper " + me->query("id") + " 我不是已经告诉过你了吗，" + me->query("yuejob/amane") + "快去吧！\n" NOR);
    return 1;
  }
  //		me->map_skill("unarmed");
  else {
    qname = region_names[explode(quest["place"], "/")[1]];
    command("nod " + me->query("id"));
    //				aname = "采花贼在"+qname+"的『" + quest["short"] + "』";
    //				me->set("yuejob/amane",aname);
    //                command("whisper " + me->query("id") + " 据可靠消息，"+aname+"，快去吧！\n" NOR);
    me->set("yuejob/kill_qiangdao", 1);
    //                me->set("yuejob/task_time", time() + 300);
    me->set("yuejob/asktime", time());

    ob = new(__DIR__ "yue_killer");

    if (me->query("combat_exp") < 1000000)
      NPC_D->set_npc(ob, 0, me->query("combat_exp"), 60);
    if (me->query("combat_exp") >= 1000000 && me->query("combat_exp") < 1500000)
      NPC_D->set_npc(ob, 0, me->query("combat_exp"), 75);
    if (me->query("combat_exp") >= 1500000)
      myexp = me->query("combat_exp");
    myexp = 1.2 * myexp;
    NPC_D->set_npc(ob, 0, myexp, 100);

    if (ob->query("default_weapon"))
      ob->carry_object(ob->query("default_weapon"))->wield();
    ob->set("player_name", me->query("id"));
    me->set_temp("yue_name", ob->query("name"));
    ob->move(quest["place"]);
    //				ob->move( "/d/dali/majiu");
    aname = "采花贼" + ob->query("name") + "在" + qname + "的『" + quest["short"] + "』";
    me->set("yuejob/amane", aname);
    command("whisper " + me->query("id") + " 据可靠消息，" + aname + "出没，快去给我杀了他！\n" NOR);
    me->set("noask/yuejob_next", time());
    message("vision", ob->name(1) + "快步走了过来.\n", quest["place"], ob);

    return 1;
  }
}

int ask_fail() {
  string *go_list = ({
    "/d/shaolin/hanshui1",
    "/d/taishan/yidao3",
    "/d/hangzhou/hongchun",
    "/d/emei/emroad5",
    "/d/xueshan/shanlu2",
    "/d/dali/dalicheng10",
    "/d/qilian/dangpu",
    "/d/qilian/datong-ling",
    "/d/changbai/ssmiao",
    "/d/hangzhou/baoshi2",
  });
  object *ob_list;
  object me = this_player();
  int i;


  if (me->query("yuejob/kill_qiangdao") == 1) {
    command("sigh " + me->query("id"));
    command("say 你这身手也敢来惩奸除恶，都怪岳小玫我当初看错了人,扣你50点潜能。");
    command("kick " + me->query("id"));
    me->move(go_list[random(sizeof(go_list))]);
    me->add("potential", -50);
    me->set("noask/yuejob", time());
    me->delete("yuejob");

    if (me->query_temp("yue_name")) {
      ob_list = children(__DIR__ "yue_killer");
      for (i = 0; i < sizeof(ob_list); i++)
        if (environment(ob_list[i]) && ob_list[i]->query("name") == me->query_temp("yue_name")) {
          me->delete_temp("yue_name");
          message(
            "vision",
            ob_list[i]->name(1) + "急急忙忙地离开了。\n",
            environment(ob_list[i]),
            ob_list[i]
          );
          destruct(ob_list[i]);
        }
    }
    return 1;
  }
}

void assign_baohu(object me, string where) {
  object ob, here, servant, card;
  object *target_list;
  int i, j, servant_num, job_id;

  if (!userp(me)) return;
  if (!where) return;
  ob = new(__DIR__ "woman");
  ob->move(where);
  job_id = 100 + random(9999);
  me->set_temp("baohu/card_job_id", job_id);
  ob->set_temp("baohu/owner", me);
  ob->set("baohu/job_id", job_id);
  message_vision("\n$N快步走了过来!\n", ob);

  card = new(__DIR__ "obj/card.lpc");
  card->set("card_owner", me);
  card->set("card_job_id", job_id);
  card->move(me);
  /*
	servant_num = 1 + random(3);
	for(j = servant_num; j > 0; j--) 
	{
		servant = new(__DIR__"servant.lpc");
		servant->set("host", ob);
		servant->set_leader(ob);
		servant->move(where);
	}
	*/
}
