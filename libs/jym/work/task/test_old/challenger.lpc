//Cracked by Roath
//Jay 2/3/97
#include <ansi.h>
inherit NPC;

void self_destruct();

void create() {
  set_name("一个人", ({ "ren" }));
  set("long",
    "这只是一个人而已。\n");
  //	set("gender", "女性");
  set("age", 20);
  set("combat_exp", 1000);
  setup();
  remove_call_out("self_destruct");
  call_out("self_destruct", 600);

  //       set("chat_chance_combat", 50);
}

void init() {
  ::init();
  add_action("do_kill", "kill");
  add_action("do_throw", "throw");

}


void self_destruct() {
  object me = this_object();
  if (!environment(me)) return;
  message("vision", me->name() + "急急忙忙地离开了。\n", environment(me), me);
  destruct(me);
}

void die() {
  mixed killer;

  killer = query_temp("last_damage_from");
  if (stringp(killer)) killer = (object)find_player((string)killer);
  if (objectp(killer)) {
    if (killer->query("family/family_name") != query("family/family_name")
      && killer->query("family/family_name") == query("tz_menpai")
      && killer->query_temp("challenge") == query("name")) {

      message("channel:chat", HIC "【闲聊】" + query("name")
        + "(" + query("id") + ") " + killer->query("family/family_name")
        + "果真是高手如云，鄙人死于" + killer->query("name") + "之手，死而无憾矣。\n\n" NOR, users());

      JOB_GIFTD->job_gift(killer, ([ "combat_exp": 230, "potential": 200, "menpai_zc": 1, ]),
        ([ "job_name": "challenge_job", "job_name_cn": "门派挑战", "job_time_limit": 50, ]));
    } else if (killer->query("family/family_name") == query("menpai")) {
      message("channel:chat", HIC "【闲聊】" + query("name") + "(" + query("id") + ") "
        +killer->query("family/family_name") + "弟子记住" + killer->query("name")
        + "这个人面兽心残杀同门的" + killer->query("family/family_name") + "败类，为我报仇啊！\n" NOR, users());
    }
    killer->delete_temp("challenge");
  }
  ::die();
}


int accept_fight(object me) {
  object ob = this_object();

  //	if ((int)me->query("combat_exp") > (int)ob->query("combat_exp") * 2) {
  //		 write("\n由于实力相差太悬殊，你对于来自"+ob->query("name")+"的挑战显得不屑一顾。\n");
  //		 return 0;
  //	}

  if (ob->is_fighting()) {
    write(ob->name() + "摇头道：" + RANK_D->query_respect(me) + "，请勿倚多为胜！\n");
    return 0;
  }

  if (me->query("family/family_name") == ob->query("family/family_name")) {
    command("shake");
    command("say 你我同为" + ob->query("family/family_name") + "弟子怎可同门相残呢？");
    return 0;
  } else if (me->query("family/family_name") == ob->query("tz_menpai")) {
    command("say 既然这位" + RANK_D->query_respect(me) + "要接受挑战那鄙人就却之不恭了！");
    command("say 拳脚无眼、刀剑无情，我们生死由命吧！" + RANK_D->query_respect(me) + "出招！");

    message("channel:chat", HIW "【挑战】" + me->query("family/family_name")
      +me->query("name") + "接受" + ob->query("family/family_name") + ob->query("name")
      + "之挑战，双方业已签定生死状，生死各按天命！\n" NOR, users());
    kill_ob(me);
    me->set_temp("challenge", ob->query("name"));
    me->kill_ob(ob);
  }

  return 0;
}

int do_kill(string arg) {
  object me = this_player();
  string *id_list;

  id_list = this_object()->parse_command_id_list();

  //write(id_list[0]+", "+id_list[1]+", "+id_list[2]+"\n");

  if (arg == id_list[0] || arg == id_list[1] || arg == id_list[2]) {
    if (me->query("family/family_name") == query("tz_menpai")) {
      write("\n接受挑战应该使用fight命令。\n");
      return 1;
    } else {
      write("\n你无权接受挑战。\n");
      return 1;
    }

  } else {
    return 0;
  }
}

int do_throw(string arg) {
  write("\n目前无法使用暗器。\n");
  return 1;
}
