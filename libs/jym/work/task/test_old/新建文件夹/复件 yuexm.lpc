// yue.c 岳小玫
// lag 2000.5.9
#include <ansi.h>
#include <room.h>

inherit NPC;
int ask_exp(string arg);
int do_start(string arg);

void create() {
  set_name("岳小玫", ({ "yue xiaomei", "yue" }));
  set("nickname", RED "想杀人，找我啊" NOR);
  set("gender", "女性");
  set("age", 20);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("per", 55);

  set("qi", 6000);
  set("max_qi", 6000);
  set("jing", 6000);
  set("max_jing", 6000);
  set("neili", 6000);
  set("max_neili", 6000);
  set("jiali", 50);
  set("combat_exp", 8000000);
  set("score", 300000);

  set_skill("force", 300);
  set_skill("sword", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("finger", 300);
  set_skill("literate", 300);

  set("env/important", 1);

  setup();
  carry_object("/d/city/obj/cloth")->wear();
}

void init() {
  add_action("do_random", "job_start");

}

int can_used() {
  object me;
  me = this_player();

  if (this_player()->query("id") != "muder")
    return notify_fail("什么？\n");
  if (!wizardp(me))
    return notify_fail("什么？\n");
  return 1;

}

int do_random() {
  if (!can_used()) return 0;
  if (random(8) == 0) {
    do_start("gaibang");
  }
  if (random(8) == 1) {
    do_start("baituo");
  }
  if (random(8) == 2) {
    do_start("wudang");
  }
  if (random(8) == 3) {
    do_start("huashan");
  }
  if (random(8) == 4) {
    do_start("quanzhen");
  }
  if (random(8) == 5) {
    do_start("shaolin");
  }
  if (random(8) == 6) {
    do_start("taohua");
  }
  if (random(8) == 7) {
    do_start("xingxiu");
  }
  if (random(8) == 8) {
    do_start("xueshan");
  }
  if (random(8) == 9) {
    do_start("emei");
  }
  return 1;
}

int do_start(string arg) {
  object ob, room;
  string ob_menpai, tz_menpai, tz_room;
  int exp;

  if (!arg) return 0;

  tz_menpai = arg;
  exp = ask_exp(CHINESE_D->chinese_menpai(tz_menpai));
  //	if (exp <10000) return 0;
  tz_room = "/d/city/guangchang";
  if (objectp(room = load_object(tz_room)) &&
    objectp(ob = new("/task/challenge/challenger"))) {
    ob_menpai = ob->set_status(tz_menpai, exp);
    ob->move(room);
    tz_menpai = CHINESE_D->chinese_menpai(tz_menpai);
    message("vision", ob->name(1) + "快步走了过来.\n", environment(ob), ob);
    message(
      "channel:chat",
      HIW "【挑战】鄙人" + ob_menpai + ob->name(1) + "，号称打遍" + tz_menpai + "无敌手！今日坐镇『" + room->query("short") + "』挑战" + tz_menpai + "各位高手！\n\n" NOR,
      users()
    );
    message(
      "channel:chat",
      HIC "【闲聊】" + ob->name(1) + "(" + ob->query("id") + ")：" + tz_menpai + "有高手吗？哈，哈，哈！不怕死的来啊！！\n\n" NOR,
      users()
    );
  }

  return 1;
}

int ask_exp(string arg) {
  object where, ob, obj, *ob_list;
  string msg, name;
  int i, exp = 0;

  if (!arg) return 0;

  ob_list = users();

  for (i = 0; i < sizeof(ob_list); i++) {
    where = environment(ob_list[i]);
    if (ob_list[i]->query("combat_exp") > exp
      //		&& !wizardp(ob_list[i])
      && where
      && strsrch(file_name(where), "/d/") >= 0) {
      if ((string)ob_list[i]->query("family/family_name") == arg) {
        obj = ob_list[i];
        exp = obj->query("combat_exp");
      }

    }
  }

  if (!obj) return 0;

  return exp;
}
