        set("con", 30);
        set("dex", 30);
        set("per", 55);
        
        set("qi", 6000);
        set("max_qi", 6000);
        set("jing", 6000);
        set("max_jing", 6000);
        set("neili", 6000);
        set("max_neili", 6000);
