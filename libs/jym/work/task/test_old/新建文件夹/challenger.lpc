#include <ansi.h>
//inherit NPC;
#include "/task/challenge/npc_setup.lpc";


string set_status(string arg, int exp); 
string ask_me();
void self_destruct();

void create()
{
        set_random_name();
		set("gender", "男性");
        set("age", 32);
        set("str", 23);
        set("dex", 30);
        set("con", 23);
        set("int", 23);
        set("shen_type", -1);

        set("max_qi", 300);
        set("max_jing", 100);
        set("neili", 200);
        set("max_neili", 200);

        set("no_refresh", 1);

        set("inquiry", ([
            "岳小玫" : (: ask_me :),
        ]));


        setup();
        //carry_object("/clone/armor/beixin")->wear();
        remove_call_out("self_destruct");
        call_out("self_destruct", 120);

 //       set("chat_chance_combat", 50);
}

void init()
{
	::init();
	add_action("do_kill", "kill");

}


void self_destruct() {
    object me = this_object();
	if (!environment(me)) return;
    message("vision",me->name()+"急急忙忙地离开了。\n", environment(me), me);
    destruct(me);
}

string set_status(string arg, int exp) {
    int exprnum, i;
    string menpai,c_menpai;

	exprnum = random(3);

    set("tz_menpai",CHINESE_D->chinese_menpai(arg));
	set("nickname",HIR"打遍"+CHINESE_D->chinese_menpai(arg)+"无敌手"NOR);
    menpai = set_skills(0, exp);
	if (menpai == arg)
	{
		while(i = 8){
			i++;
			menpai = set_skills(0, exp);
			if( !(menpai == arg)) break;
		}
	}
	c_menpai = CHINESE_D->chinese_menpai(menpai);
	set("menpai",c_menpai);
	set("title",c_menpai+"高手"NOR);
    set("long", "他看起来是"+c_menpai+"的高手。\n");
    set_hp(query_skill("force", 1));
    if ( exp > 1000000 ) {
		carry_object("/clone/armor/tiejia")->wear();
        if ( query( "default_weapon" ) )
            carry_object(query("default_weapon"))->wield();
	}
	else{
		carry_object("/clone/armor/beixin")->wear();
	}

	 return c_menpai;

}

void die()
{
    mixed killer;

    killer = query_temp("last_damage_from");
    if (stringp(killer)) killer = (object)find_player((string)killer);
    if (objectp(killer)) {
        if (killer->query("family/family_name") != query("menpai") 
			&& killer->query("family/family_name") == query("tz_menpai") 
			&& killer->query_temp("challenge") == query("name")) {

		message("channel:chat",HIC"【闲聊】"+query("name")
			+"("+query("id")+") "+killer->query("family/family_name")
			+"果真是高手如云，鄙人死于"+killer->query("name")+"之手，死而无憾矣。\n\n"NOR,users());

		JOB_GIFTD->job_gift(killer,(["combat_exp": 230,"potential": 200,"menpai_zc": 1,]),
			(["job_name":"challenge_job","job_name_cn":"门派挑战","job_time_limit":50,]));
        }
		else if (killer->query("family/family_name") == query("menpai")) {
		message("channel:chat",HIC"【闲聊】"+query("name")+"("+query("id")+") "
		+killer->query("family/family_name")+"弟子记住"+killer->query("name")
		+"这个人面兽心残杀同门的"+killer->query("family/family_name")+"败类，为我报仇啊！\n"NOR,users());
		}
		killer->delete_temp("challenge");
    }
    ::die();
}

string ask_me() 
{
    object player = this_player();
    if (query("player_name") == player->query("id")) {
        return "老子怎么越看越觉得你像是个采花贼呢?";
    }else {
        return "青天白日的, 哪里有什么采花贼? 真是笑话.";
    }
}


int accept_fight(object me)
{
	if (me->query("family/family_name") == query("menpai")){
		command("shake");
		command("say 你我同为"+query("menpai")+"弟子怎可同门相残呢？");
		return 0;
	}
	else if (me->query("family/family_name") == query("tz_menpai"))
	{
       command("say 既然这位" + RANK_D->query_respect(me) + "要接受挑战那鄙人就却之不恭了！");
	   command("say 拳脚无眼、刀剑无情，我们生死由命吧！" + RANK_D->query_respect(me) + "出招！");

	   message("channel:chat",HIW"【挑战】"+me->query("family/family_name")
		   +me->query("name")+"接受"+query("menpai")+query("name")
		   +"之挑战，双方业已签定生死状，生死各按天命！\n"NOR,users());
	   kill_ob(me);
	   me->set_temp("challenge", query("name"));
	   me->kill_ob(this_object());
	}

	
	return 1;
}

int do_kill(string arg)
{
	object me = this_player();

	if (!arg || arg!=  query("id")) return 0;
	if (me->query("family/family_name") == query("tz_menpai"))
	{
		if (me->query_temp("challenge") != query("name"))
			{
			  write("\n接受挑战应该先使用fight命令。\n");
		      return 1;
			} else return 0;
	}
	else{
		write("\n接受挑战应该先使用fight命令。\n");
		return 1;
	}
}