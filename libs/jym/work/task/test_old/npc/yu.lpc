// yu 玉真子
 
inherit NPC;
 
void create()
{
        set_name("玉真子", ({ "yu zhenzi", "yu" }));
        set("title","铁剑门掌门人");
        set("nickname", "护国真人");
        set("long", 
        "铁剑门的叛徒，极其好色，虽是武林败类，但是一身功夫早就出神入化。\n");
        set("gender", "男性");
        set("age", 66);
        set("attitude", "peaceful");
        set("shen", -18000);
        set("str", 35);
        set("int", 30);
        set("con", 25);
        set("dex", 35);
        set("per",11);
           set("eff_jingli",2000);
        set("max_qi", 2500);
        set("max_jing", 2500);
        set("jiali", 100);
        set("combat_exp", 2100000);
        set("chat_chance_combat", 60);
//       set("chat_msg_combat", ({
//                (: perform_action, "strike.tiangang" :),
//         }));
        set_skill("strike", 240);
        set_skill("sword", 240);
        set_skill("dodge", 240);
        set_skill("parry", 240);
        set_skill("xiantian-gong", 242);
        set_skill("tiangang-zhang",240);
        set_skill("quanzhen-jianfa", 240);
        set_skill("jinyan-gong",240);             
        set_skill("literate", 240);
        set_skill("force",240);
        map_skill("force", "xiantian-gong");
        map_skill("dodge", "jinyan-gong");
        map_skill("strike","tiangang-zhang");
 
        map_skill("sword", "quanzhen-jianfa");
        prepare_skill("strike", "tiangang-zhang");
 
        setup(); 
        carry_object("/clone/misc/cloth")->wear();
       
     
}
#include "/d/city/job/npc.h"
