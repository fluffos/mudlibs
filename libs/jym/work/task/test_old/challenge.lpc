int do_start(string arg)
{
	string *menpai_list = ({
    "huashan", "shaolin", "wudang", "emei", "gaibang", "lingjiu",
    "baituo", "xueshan", "xingxiu", "taohua", "gumu"  });

	string *sex_list = ({ "男性", "女性"  });

	object ob, room;
	string ob_menpai, tz_menpai, tz_room, sex, chenhu;
	string name, nun_name;
	int exp, i = 0;

		//if (!stringp(arg)) 
		if (!arg || arg == "") 
			tz_menpai = menpai_list[random(sizeof(menpai_list))];
		else tz_menpai = arg;

		sex = sex_list[random(sizeof(sex_list))];

		exp = ask_exp(CHINESE_D->chinese_menpai(tz_menpai));
		if (exp <150000) exp = 150000;
		if (exp >150000 && exp < 300000) exp = 300000;
		if (exp >300000 && exp < 600000) exp = 600000;
		if (exp >600000 && exp < 1200000) exp = 1200000;
		if (exp >1200000 && exp < 2400000) exp = 2400000;
		if (exp >2400000 && exp < 4800000) exp = 4800000;
		if (exp >4800000) exp = 6000000;
		//if (exp <10000) return 0;
//		tz_room = load_object(family_master_place[family]);
//		tz_room = "/d/city/guangchang";
//        if(objectp(room=load_object(tz_room)) && 
		if(objectp(ob = new("/task/challenge/challenger.lpc"))){
			ob->set("gender", sex);
			ob_menpai = NPC_D->set_npc(ob, 0, exp, 90);
			while(ob_menpai == tz_menpai)
				{
					i++;
					tz_menpai = menpai_list[random(sizeof(menpai_list))];
					if(i>10) break;
				}
			if (ob_menpai == "shaolin" || ob_menpai == "xueshan" && sex == "女性")
			{
				ob->set("gender", "男性");
				NPC_D->generate_cn_name(ob);
			}
			if (ob_menpai == "emei" || ob_menpai == "gumu" || ob_menpai == "lingjiu" && sex == "男性")
			{
				ob->set("gender", "女性");
				NPC_D->generate_cn_name(ob);
			}	

			NPC_D->ob_menpai_newname(ob, ob_menpai);
//
			ob_menpai  = CHINESE_D->chinese_menpai(ob_menpai);
			tz_menpai=CHINESE_D->chinese_menpai(tz_menpai);
			ob->set("nickname", HIR"打遍"+tz_menpai+"无敌手"NOR);
			ob->set("tz_menpai", tz_menpai);
			room = load_object(family_master_place[tz_menpai]);
			ob->move(room);

		
			message("vision",ob->name(1)+"快步走了过来.\n", environment(ob), ob);
		    message("channel:chat",HIW"【挑战】"+ob_menpai+ob->name(1)+"，号称打遍" +tz_menpai
				+"无敌手！今日坐镇"+tz_menpai+"『"+room->query("short")+"』挑战"+tz_menpai +"各位高手！\n\n"NOR,users());
//		    message("channel:chat",HIC"【闲聊】"+ob->name(1)+"("+ob->query("id")+")："
//				+tz_menpai+"有高手吗？哈，哈，哈！不怕死的来啊！！\n\n"NOR,users());
		}

	 return 1;                         
}

int ask_exp(string arg)
{
	object where,ob,obj,*ob_list;
	string msg, name;
	int i, exp = 0;

	if (!arg) return 0;

	ob_list = users();

	for( i = 0; i < sizeof(ob_list); i++) {
		where = environment(ob_list[i]);
		if( ob_list[i]->query("combat_exp") > exp 
//		&& !wizardp(ob_list[i])
		&& where
		&& strsrch(file_name(where), "/d/") >= 0) {
			if ((string)ob_list[i]->query("family/family_name") == arg)
			{
				obj = ob_list[i];
				exp = obj->query("combat_exp");
			}

		}
	}

	if ( !obj ) return 0;

	return exp;
}