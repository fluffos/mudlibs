string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  int i;

  if (strlen(str) < 1) return 0;

  // AGENTS.md §15h: this driver's strings are UTF-8 native -- str[i] is
  // a Unicode codepoint, not a GBK byte, and strlen() counts characters,
  // not bytes. The original GBK lead/trail-byte range check
  // (161-255 / 176-247 on alternating byte offsets) never matches real
  // Chinese text anymore. Replaced with a straightforward CJK Unicode
  // Unified Ideographs block check on every character.
  for (i = 0; i < strlen(str); i++) {
    if (str[i] < 0x4e00 || str[i] > 0x9fff) return 0;
  }

  return 1;
}
