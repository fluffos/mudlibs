// diyun 狄云

inherit NPC;

void create()
{
        object cloth;

        set_name("狄云", ({ "di yun", "diyun"}));
        set("long", "他英武刚正，有一股豪迈之气。\n");
        set("gender", "男性");
        set("age", 25);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("per", 20);

        setup();
        // AGENTS.md §15e: /d/city/obj/cloth.lpc is part of the /d/city
        // zone, which this archive genuinely does not ship (§13 content
        // gap) -- carry_object() correctly returns 0 for missing content;
        // guard the chained ->wear() instead of assuming it always
        // succeeds.
        cloth = carry_object("/d/city/obj/cloth.lpc");
        if (objectp(cloth))
                cloth->wear();
}
