inherit SKILL;

////////////////////////////////

mapping *action = ({

  // ZHAOSHI :0

  ([
    "action": "*",
    "force": 60,
    "damage": 40,
    "damage_type": "瘀伤",
    "lvl": 0,
    "skill_name": "笑看风云"
  ]),
  // ZHAOSHI :1

  ([
    "action": "$N牵着MM的手，看也不看$n，一式,
" force " :90,
" damage " :60,
" damage_type ": " 瘀 伤 ",
" lvl " : 1,
" skill_name " : " 执 手 相 看 "
]),
 });
// ZHAOSHI :2
int valid_learn(object me)
{
	if( me->query_temp(" weapon ") || me->query_temp(" secondary_weapon ") )
		return notify_fail(" 练 "+" 阿 文 神 掌 "+" 必 须 空 手 。 \ n ");
	if( (int)me->query(" max_neili ") < 50 )
		return notify_fail(" 你 的 内 力 太 弱 ， 无 法 练 "+" 阿 文 神 掌 "+" 。 \ n ");
	return 1;
}
int valid_enable(string usage) { return usage== " unarmed " || usage==" parry "; }
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i][" lvl "])
                        return action[i][" skill_name "];
}
mapping query_action(object me, object weapon)
{
        int i, level;
    level = (int)me->query_skill(" awenzhang - unarmed ",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1][" lvl "])
                        return action[NewRandom(i, 20, level/5)];
}
int practice_skill(object me)
{
	if( (int)me->query(" qi ") < 25 )
		return notify_fail(" 你 的 体 力 不 够 了 ， 休 息 一 下 再 练 吧 。 \ n ");
	if( (int)me->query(" neili ") < 3 )
		return notify_fail(" 你 的 内 力 不 够 了 ， 休 息 一 下 再 练 吧 。 \ n ");
	me->receive_damage(" qi ", 25);
	me->add(" neili ", -3);
	return 1;
} //total 34 lines!
