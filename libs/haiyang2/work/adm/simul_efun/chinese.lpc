
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// §15h fix: this driver's strings are UTF-8, str[i] is a Unicode
	// codepoint (not a raw GBK byte) and strlen() counts characters (not
	// bytes) -- the original GBK lead-byte range check (str[0] > 160 &&
	// str[0] < 255) is always false for real Chinese text now, and the
	// original strlen(str)>=2 ("need a full 2-byte GBK char") wrongly
	// rejects genuine single-character UTF-8 substrings. See AGENTS.md §15h.
	if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
	return 0;
}
