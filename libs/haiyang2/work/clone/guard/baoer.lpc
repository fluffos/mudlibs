  map_skill("sword", "yunv-jian");
  map_skill("dodge", "tianluo-diwang");
  map_skill("parry", "yunv-jian");
  map_skill("unarmed", "meinv-quan");
  prepare_skill("strike", "tianluo-diwang");
  prepare_skill("cuff", "meinv-quan");
  set("chat_chance", 10);
