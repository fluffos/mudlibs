void create() {
  seteuid(getuid());
  write("simul_efun loaded successfully.\n");
}


// add bye fix 2001-12-17
// 因为系统efun不能正确反映时间，导致诸如dntg等无法过关，估计是因
// 为MUDOS不兼容的问题，特添加该段程序，请各巫师测试，如无问题则可
// 替换原来的 /amd/obj/simul_efun.c，需重启系统。
mixed localtime(int date) {
  mixed *local;
  if (date < 0) date = 2147483647 + date + 1;  //修正时间函数溢出
  local = ({ date % 60, date / 60 % 60, date / 3600 % 24, date / 86400 % 30 + 1, date / 2592000 % 12,
    date / 31104000, date / 86400 % 7, date / 86400 % 360, -86400, "PST" });
  return local;
}
// end bye fix

// dump_socket_status(): the MudOS efun is gone from this driver; the same table, built from socket_status()
// (a driver without the sockets package -- the WASM build -- has no sockets to list: the table is its header only)
string dump_socket_status() {
  string ret = sprintf(
    "%-3s %-10s %-9s %-22s %s\n",
    "Fd",
    "State",
    "Mode",
    "Local Address",
    "Remote Address"
  );
#ifdef __PACKAGE_SOCKETS__
  {
    mixed *all = socket_status();
    int n;

    for (n = 0; n < sizeof(all); n++)
      if (arrayp(all[n]) && sizeof(all[n]) >= 5)
        ret += sprintf(
          "%-3d %-10s %-9s %-22s %s\n",
          all[n][0],
          all[n][1],
          all[n][2],
          all[n][3],
          all[n][4]
        );
  }
#endif
  return ret;
}
