// add bye fix 2001-12-17
// 因为系统efun不能正确反映时间，导致诸如dntg等无法过关，估计是因
// 为MUDOS不兼容的问题，特添加该段程序，请各巫师测试，如无问题则可
// 替换原来的 /amd/obj/simul_efun.c，需重启系统。
mixed localtime(int date) {
  mixed *local;
  if (date < 0) date = 2147483647 + date + 1;  //修正时间函数溢出
  local = ({ date % 60, date / 60 % 60, date / 3600 % 24, date / 86400 % 30 + 1, date / 2592000 % 12,
    date / 31104000, date / 86400 % 7, date / 86400 % 360, -86400, "PST" });
  return local;
}
// end bye fix
