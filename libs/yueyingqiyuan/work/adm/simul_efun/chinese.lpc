string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  int i;

  // AGENTS.md §15h: this was a GBK lead/trail-byte range check
  // (str[i] returned a raw byte, 2 bytes/char, under the original
  // GBK-byte driver). On this driver str[i] is a full Unicode
  // codepoint and strlen() counts characters, not bytes -- replaced
  // with a direct CJK Unified Ideographs codepoint range check per
  // character, and the byte-count-based minimum-length gate (< 2
  // bytes = "at least 1 full GBK char") is now a character-count
  // gate (< 1 char).
  if (strlen(str) < 1) return 0;

  for (i = 0; i < strlen(str); i++) {
    if (str[i] < 0x4e00 || str[i] > 0x9fff) return 0;
  }

  return 1;
}
