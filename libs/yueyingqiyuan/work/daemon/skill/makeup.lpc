// literate.c

#include <ansi.h>

inherit SKILL;

string type() { return "beauty"; }

string level_description(int level) {
  int grade;
  string *level_desc = ({
    BLU "如花似玉" NOR,
    BLU "肤若凝脂" NOR,
    HIB "珠圆玉润" NOR,
    HIB "吐气如兰" NOR,
    YEL "明眸皓齿" NOR,
    YEL "冰肌玉骨" NOR,
    CYN "兰质惠心" NOR,
    HIW "青春永驻" NOR
    //秀外慧中
    //玉洁冰清
  });

  grade = level / 20;

  if (grade >= sizeof(level_desc))
    grade = sizeof(level_desc) - 1;
  return level_desc[grade];
}
