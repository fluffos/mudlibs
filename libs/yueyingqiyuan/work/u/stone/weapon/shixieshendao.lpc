//stone created
#include <weapon.h>
#include <ansi.h>

inherit F_UNIQUE;
inherit BLADE;
void init();
void kaifeng();

void create()
{
        set_name(HIR"尸"HIG"血"HIM"神"HIC"兵"NOR, ({"shenbing", "dao","blade"}));
	set_weight(1200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "阿修罗界镇界之宝，传说中的上古神兵。\n");
		set("value", 0);
		set("wield_msg", "$N「唰」地一声抽出一把$n握在手中，刹时间天地变色，鬼哭神嚎，$N感觉拥有了无上魔力！
上古传说武功道行高深之士可以血开锋（kaifeng)。\n");
		set("unwield_msg", "$N冷哼一声，$n转眼已经不见了。\n");
		set("weapon_prop/courage", 15);
	}
	init_blade(100);
	setup();
}

void init()
{
	add_action("do_kaifeng", "kaifeng");
}
int do_kaifeng(string arg)
{
	object who = this_player();
	object shendao;
	object newshendao;
	string newshendao_given;
	newshendao_given = "/u/stone/weapon/shixieshendao1.lpc";

	if(who->is_fighting())
		return notify_fail("你正打仗呢！想死啊！\n");
	if(who->is_busy())
		return notify_fail("你还有这工夫?正忙着呢!\n");	
	if(!shendao = present("shenbing",who))
		return notify_fail("你还缺少"+RED "尸血神兵" NOR +",怎么能施展「赤血开锋」神通呢?\n");
	if ( shendao->query("equipped")=="wielded" )
		return notify_fail("尸血神兵必须摘下才能开锋！\n");
	 if( (!arg) || !((arg == "shenbing") || (arg == "尸血神兵")))
                return notify_fail("你要以血开锋什么？\n");
        if( who->query("kee") < (int)(who->query("max_kee")/3))
//                who->receive_damage("kee",(int)who->query("max_kee")*20/100);
                return notify_fail("你现在伤太重，要以血开锋的话，驾驭不了神兵。\n"); 
        if( (int)who->query("force") < 1000 )
                return notify_fail("你的真气不足，要以血开锋的话，恐怕会受神兵反噬。\n");
        if( (int)who->query("mana") < 2000 )
                return notify_fail("你的法力还不充盈，不能施展「赤血开锋」神通。\n");
        if( (int)who->query("bellicosity") < 200 )
                return notify_fail("你的杀气还不重，不能施展「赤血开锋」神通。\n");
        if ( !(newshendao_given->in_mud()) ) 
	{
		message_vision("$N双目精光暴现，左手屈成剑指划破右臂，只见一道血箭射向“尸血神兵”\n\n
"+HIR"$N急喝道：“赤血开锋！”"NOR+"\n\n
"+RED"忽见，尸血神兵吸血，立化血光异闪，锋芒暴涨，灼目如火，一股红芒现出绕缠尸血神兵。"NOR+"\n
"+HIR"$N手中的尸血神兵化为“赤血神兵”。\n\n"NOR,who);
		message_vision("$N脸上浮现出诡异的笑容......\n\n",who);
		newshendao= new("/u/stone/weapon/shixieshendao1");
		newshendao->move(who);
		who->add("kee", -(int)who->query("max_kee")*10/100);
//		who->add("max_kee", -(int)who->query("max_kee")*10/100);
		who->start_busy(3);
		destruct(this_object());
		MONITOR_D->report_rumor_object_msg(who, "以赤血开锋得到了【"+HBRED"赤血神兵"NOR+HIR"】 了！");		
	} else {
		message_vision("$N左手屈成剑指划破右臂，只见一道血箭射向“尸血神兵”，$N急喝道：“赤血开锋”！\n
忽见，尸血神兵吸血，红光一闪，神兵化作一道红芒直冲九宵，不见了...\n",who);
	}
	destruct(this_object());
	return 1;
}
