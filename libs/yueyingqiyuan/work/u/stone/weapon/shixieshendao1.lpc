//stone 20020619
// /d/shixieshendao1.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;
int close(object me, object ob);

void create()
{
        set_name(HIR"赤血神兵"NOR, ({"shenbing", "dao","blade"}));
	set_weight(1200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", RED"阿修罗界镇界之宝，传说中的上古神兵。
经赤血开锋后的宝刃，暴起一团夺目的赤红之光。\n"NOR);
		set("value", 0);
		set("unwield_msg", "$N一声厉啸，随手一挥，手中$n已不见踪影。\n");
		set("weapon_prop/courage", 15);
	}
	init_blade(150);
	setup();
}

void init()
{
    add_action("do_wield","wield");
}
int do_wield(string arg)
{
    	object me,ob;
	me = this_player();
	ob = this_object();
//if( !arg ) return 0;
	if(arg == "shenbing" || arg == "blade" || arg == "all") {    
	if((int)me->query("max_force", 1) < 2500 ||
    	(int)me->query("force", 1) < 1000  ){
 	tell_object(me,"你感觉全身气息翻腾，原来你内力不够，提不起这把赤血神兵。\n");
  	return 1;
  	}
	if((int)me->query_str() < 15){
   	tell_object(me,"你想举起这把赤血神兵，怎奈力量不够，只好作罢。\n");
  	return 1;
	}
	ob->wield();
	message_vision(HIY"$N一声暴喝，“呛”的一声，赤血神兵出鞘。
红光四射，如血光暴崩，又似烈火四射，映得周围四周都一片赤红血光。
\n"NOR, me);
	me->add("force", -100);
	remove_call_out("close");
	call_out("close",1200, me,ob);
  	return 1;
  	}
}

int close(object me, object ob)
{
	object shendao;
	tell_room(environment(me), ob->query("name")+"的血光渐渐淡去，又恢复成尸血神兵......\n");
	shendao= new("/u/stone/weapon/shixieshendao");
	shendao->move(me);
        destruct(ob);
	return 1;
}
