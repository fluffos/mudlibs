#include <ansi.h>
#include <room.h>
#include <login.h>
inherit ROOM;
int do_use(string arg);
int do_zuan(string arg);
void create()
{
 set("short", HIM"【石头小家】"NOR);
        set("long",@LONG
这是石头平时休息的地方，东西不多，一张床，一张书桌
桌上有一台笔记本电脑，这可是石头小家里唯一值钱的好东东
呀!大家一定要手下留情!
LONG);
  set("exits", ([ /* sizeof() == 2 */
//"down" : "/d/changan/southseashore",
"west":__DIR__"bed_room",
]));
set("item_desc", ([ /* sizeof() == 1 */
  "bed" : "睡觉用的床铺(gosleep,gobed,bed)。 
",
]));
 set("objects", ([ 
//__DIR__"obj/zuozi" : 1,  
//__DIR__"bed_room" : 1,
//__DIR__"obj/rack" : 1,    
  "/u/stone/obj/huanyang" : 1,
    ]));
 setup();
//  set("no_clean_up", 0)
//call_other("/obj/board/bmw_b", "???");
}
void init()
{
        add_action("do_bed", "gosleep");
        add_action("do_bed", "gobed", );
        add_action("do_bed", "bed");
}

int do_bed()
{       object me;
        me=this_player();
        message_vision(HIY "$N掀开蚊帐，准备上床了。\n\n" NOR, me);
        me->move("/u/stone/bed_room");
            message_vision(HIY "\n蚊帐轻轻一动，$N钻了进来。\n" NOR, me);
                return 1;
}

