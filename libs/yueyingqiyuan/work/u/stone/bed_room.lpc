#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "【床上】");
 //       set_name("[1;30m【床上】[2;37;0m",({"chuang"}));
        set("long",@LONG
【这是一张学生用床，没有什么奇怪的。】
LONG);
        set("exits", ([
                "out": "/u/stone/workroom",
            ]));
        set("no_fight", 1);
        set("no_magic", 1);
        set("sleep_room",1);
        set("if_bed",1);
        setup();
}
