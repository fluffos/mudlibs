inherit ITEM;

void create()
{
        set_name("巫师工具架", ({ "rack" }) );
        set_weight(500000);
        set_max_encumbrance(40000);
        if( clonep() ) {
                object a,b,c,d;
                  seteuid(getuid());
//                if(a=new("/obj/wiz/suit"))
//                  a->move(this_object());
                if(a=new("/u/stone/obj/glass"))
                  a->move(this_object());

                if(b=new("/obj/goldbang"))
                  b->move(this_object());

                  seteuid(getuid());
                if(c=new("/obj/roommaker"))
                  c->move(this_object());

                  seteuid(getuid());
		if(d=new("/obj/objmaker"))
		  d->move(this_object());

                set_default_object(__FILE__);
        } else {
                set("unit", "个");
                set("long", "这是一口存放巫师工具的架子，可以用来堆放一些工具。\n");
                set("value", 0);
        }
}

int is_container() { return 1; }


