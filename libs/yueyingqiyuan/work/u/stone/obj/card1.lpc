// by stone
// stone 修改

#include <ansi.h>
#include <command.h>

inherit ITEM; 

void create()
{
	set_name( HIR "节日贺卡" NOR , ({"card", "ka"}));
	set_weight(90);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("long", "一张节日贺卡。上面有几个字：\n\n"
"送给每一位月影奇缘的玩家!\n\n"
BLINK+HIR"                  月影奇缘全体巫师恭贺各位：节日快乐。\n\n"NOR			
			"你可以打开(dakai)或(open)来看看，说不定会心想事成！\n"
			"背面还有一行小字：打开前先许愿，不然你的愿望怎么能实现呢？\n"
"可以许愿要经验(exp)、道行(dx)、潜能(pot)、黄金(gold)或者\n"
"内力(force)及法力(mana)。\n\n"
	"wish xxx or hope xxx\n"
	"经验(exp)可以得5000点\n"
	"道行(dx) 可以得10年\n"
	"潜能(pot)可以加3000点\n"
	"黄金(gold)可以得10两\n"
	"内力(force)可以加20点\n"
	"法力(mana) 可以加20点\n");		
		set("no_get",1);
		set("no_give",1);
		set("no_sell",1);
		set("no_put",1);
		set("no_drop",1);
		set("no_steal",1);
	}
	set("is_monitored",1);
	setup();
}


void init()
{
	if (!wizardp(this_player())) {
		set("no_get","节日贺卡不能捡起来！\n");
		set("no_give","这是节日贺卡啊，怎么能随便给人呢？\n");
		set("no_drop","节日贺卡每人才一张扔了多可惜呀！\n");
		set("no_sell","这是巫师定做的，卖不掉了。\n");
		set("no_put",1);
	}
	add_action("do_dakai", "dakai");
	add_action("do_dakai", "open");
	add_action("do_wish", "wish");
	add_action("do_wish", "hope");
	}


int do_dakai(string arg)
{
	object me, ob;
	me = this_player(); 
	if (arg!="card" && arg!="ka")
		return notify_fail("你想打开什么？\n");

		if ( me->query("wished") )
		{   

			message_vision(HIG "$N擦了擦手，小心地打开了节日贺卡。\n\n" NOR, this_player());  
			message_vision(HIG "$N的愿望实现啦！\n" NOR, this_player()); 
			 
			if ( me->query_temp("marks/exp") ){ 
				me->add("combat_exp",5000); 
				me->set("wished",0);
				me->set_temp("marks/exp",0); 
				destruct(this_object());
				return 1;
			}
			if ( me->query_temp("marks/dx") ){ 
				me->add("daoxing",10000); 
				me->set("wished",0);
				me->set_temp("marks/dx",0); 
				destruct(this_object());
				return 1;
			}
			if ( me->query_temp("marks/pot") ){
				me->add("potential",3000);
				me->set("wished",0);
				me->set_temp("marks/pot",0); 
				destruct(this_object());
				return 1;
			}
			if ( me->query_temp("marks/gold") ){
				ob=new("/obj/money/gold");
				ob->set_amount(10);  
				ob->move(me);
				me->set("wished",0);
				me->set_temp("marks/gold",0); 
				destruct(this_object());
				return 1;
			} 
			if ( me->query_temp("marks/force") ){ 
				me->add_maximum_force(20);
				me->set("wished",0);
				me->set_temp("marks/force",0); 
				destruct(this_object());
				return 1;
			}
			if ( me->query_temp("marks/mana") ){ 
				me->add_maximum_mana(20);
				me->set("wished",0);
				me->set_temp("marks/mana",0); 
				destruct(this_object());
				return 1;
			}
			return 1;
		} 
		tell_object(me,"打开贺卡前先许个愿(wish)或(hope)吧。\n"
"可以许愿要经验(exp)、道行(dx)、潜能(pot)、\n"
"黄金(gold)或者内力(force)及法力(mana)。\n");
		return 1;
	message_vision(HIG "$N还没许愿呢，愿望怎么能实现呢？\n" NOR, this_player());   
	tell_object(me, "你还是先许个愿再打开吧！先看看贺卡上写些什么吧！\n" NOR);
	return 1;
}
 
int do_wish(string arg) 
{
	object me;
	me = this_player();

	if (arg=="pot") { 
		message_vision(HIY "$N闭上眼睛，默默地许了个愿。\n" NOR, me);  
		me->set("wished",1);
		me->set_temp("marks/pot",1);
		return 1;
	}  
	if (arg=="gold") { 
		message_vision(HIY "$N闭上眼睛，默默地许了个愿。\n" NOR, me);  
		me->set("wished",1);
		me->set_temp("marks/gold",1);
		return 1;
    } 
	if (arg=="force") {
		message_vision(HIY "$N闭上眼睛，默默地许了个愿。\n" NOR, me);  
		me->set("wished",1);
		me->set_temp("marks/force",1);
		return 1;
	} 
	if (arg=="mana") {
		message_vision(HIY "$N闭上眼睛，默默地许了个愿。\n" NOR, me);  
		me->set("wished",1);
		me->set_temp("marks/mana",1);
		return 1;
	} 
	if (arg=="exp") {
		message_vision(HIY "$N闭上眼睛，默默地许了个愿。\n" NOR, me);  
		me->set("wished",1);
		me->set_temp("marks/exp",1);
		return 1;
	} 
	if (arg=="dx") {
		message_vision(HIY "$N闭上眼睛，默默地许了个愿。\n" NOR, me);  
		me->set("wished",1);
		me->set_temp("marks/dx",1);
		return 1;
	} 
	return notify_fail("你想许什么愿？可以许愿要经验(exp)、潜能(pot)、黄金(gold)或者内力(force)及法力（mana)。\n"); 
}

void owner_is_killed()
{
	object me = this_player();
	write(HIM"只见一道黑雾升起...尸体上什么东西消失了。\n"NOR);
	destruct(this_object());
	return;
}
