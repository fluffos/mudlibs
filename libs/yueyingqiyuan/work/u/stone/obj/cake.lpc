// by stone
// stone 修改

#include <ansi.h>
#include <command.h>

inherit ITEM;

void create() {
  set_name(HIY "节日贺卡" NOR, ({ "card", "ka" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "一张节目贺卡。上面有几个字：\n\n"
      HIR "                  谨以此记念我们曾经走过的美好的时光。\n" NOR
      "送给每一位支持月影奇缘的玩家\n"
      "全体巫师恭贺各位：节日快车。\n"
      "你可以打开(dakai)或(open)来看看，说不定会心想事成的呢！\n"
      "注:打开前先许愿，不然你的愿望怎么能实现呢？
" 可 以 许 愿 要 经 验 (exp) 、 道 行 (dx) 、 潜 能 (pot) 、 黄 金 (gold) 或 者 内 力 (force) 及 法 力 (mana) 。 \ n "
	" wish xxx or hope xxx \ n "
	" 经 验 (exp) 可 以 得 5000 点 \ n "
	" 道 行 (dx) 可 以 得 5 年 \ n "
	" 潜 能 (pot) 可 以 得 3000 点 \ n "
	" 黄 金 (gold) 可 以 得 10 两 \ n "
	" 内 力 (force) 可 以 加 20 点 \ n "
	" 法 力 (mana) 可 以 加 20 点 \ n ");
		set(" no_beg ",1);
		set(" no_get ",1);
		set(" no_give ",1);
		set(" no_steal ",1);
	}
	set(" is_monitored ",1);
	setup();
}


void init()
{
	if (!wizardp(this_player())) {
		set(" no_get "," 节 目 贺 卡 不 能 捡 起 来 ！ \ n ");
		set(" no_give "," 这 是 节 日 贺 卡 啊 ， 怎 么 能 随 便 给 人 呢 ？ \ n ");
		set(" no_drop "," 节 日 贺 卡 每 人 才 一 张 扔 了 多 可 惜 呀 ！ \ n ");
		set(" no_sell "," 这 是 巫 师 定 做 的 ， 卖 不 掉 了 。 \ n ");
	}
	add_action(" do_dakai ", " dakai ");
	add_action(" do_dakai ", " open ");
	add_action(" do_hope ", " hope ");}


int do_dakai(string arg)
{
	object me, ob;
	me = this_player(); 
	if (arg!=" card " && arg!=" ka ")
		return notify_fail(" 你 想 打 开 什 么 ？ \ n ");

//	if ( me->query(" fired ") )
//	{
		if ( me->query(" wished ") )
		{   

			message_vision(HIG " $N 擦 了 擦 手 ， 小 心 地 打 开 了 节 日 贺 卡 。 \ n \ n " NOR, me);  
			message_vision(HIG " $N 的 愿 望 实 现 啦 ！ \ n " NOR, me);  
//			me->set(" fired ",0);
			if ( me->query_temp(" marks / exp ") ){ 
				me->add(" combat_exp ",5000); 
				me->set(" wished ",0);
				me->set_temp(" marks / exp ",0); 
				destruct(this_object());
				return 1;
			}
			if ( me->query_temp(" marks / dx ") ){ 
				me->add(" daoxing ",5000); 
				me->set(" wished ",0);
				me->set_temp(" marks / dx ",0); 
				destruct(this_object());
				return 1;
			}
			if ( me->query_temp(" marks / pot ") ){
				me->add(" potential ",3000);
				me->set(" wished ",0);
				me->set_temp(" marks / pot ",0); 
				destruct(this_object());
				return 1;
			}
			if ( me->query_temp(" marks / gold ") ){
				ob=new(" / obj / money / gold ");
				ob->set_amount(10);  
				ob->move(me);
				me->set(" wished ",0);
				me->set_temp(" marks / gold ",0); 
				destruct(this_object());
				return 1;
			} 
			if ( me->query_temp(" marks / force ") ){ 
				me->add_maximum_force(20);
				me->set(" wished ",0);
				me->set_temp(" marks / force ",0); 
				destruct(this_object());
				return 1;
			}
			if ( me->query_temp(" marks / mana ") ){ 
				me->add_maximum_mana(20);
				me->set(" wished ",0);
				me->set_temp(" marks / mana ",0); 
				destruct(this_object());
				return 1;
			}
			return 1;
		} 
		tell_object(me," 打 开 贺 卡 前 先 许 个 愿 (wish) 或 (hope) 吧 。 \ n "
" 可 以 许 愿 要 经 验 (exp) 、 道 行 (dx) 、 潜 能 (pot) 、 黄 金 (gold) 或 者 内 力 (force) 及 法 力 (mana) 。 \ n ");
		return 1;
//	} 
//	me->add(" combat_exp ",vkar*10); 
	message_vision(HIG " $N “ 嗤 啦 ” 一 声 ， 把 节 日 贺 卡 撕 坏 了 ！ ： （ \ n " NOR, me);   
	message_vision(HIG " $N 的 愿 望 不 能 实 现 啦 ！ \ n " NOR, me); 
	destruct(this_object());
	return 1;
}
 
int do_wish(string arg) 
{
	object me;
	me = this_player();

	if (arg==" pot ") { 
		message_vision(HIY " $N 闭 上 眼 睛 ， 默 默 地 许 了 个 愿 。 \ n " NOR, me);  
		me->set(" wished ",1);
		me->set_temp(" marks / pot ",1);
		return 1;
	}  
	if (arg==" gold ") { 
		message_vision(HIY " $N 闭 上 眼 睛 ， 默 默 地 许 了 个 愿 。 \ n " NOR, me);  
		me->set(" wished ",1);
		me->set_temp(" marks / gold ",1);
		return 1;
    } 
	if (arg==" force ") {
		message_vision(HIY " $N 闭 上 眼 睛 ， 默 默 地 许 了 个 愿 。 \ n " NOR, me);  
		me->set(" wished ",1);
		me->set_temp(" marks / force ",1);
		return 1;
	} 
	if (arg==" mana ") {
		message_vision(HIY " $N 闭 上 眼 睛 ， 默 默 地 许 了 个 愿 。 \ n " NOR, me);  
		me->set(" wished ",1);
		me->set_temp(" marks / mana ",1);
		return 1;
	} 
	if (arg==" exp ") {
		message_vision(HIY " $N 闭 上 眼 睛 ， 默 默 地 许 了 个 愿 。 \ n " NOR, me);  
		me->set(" wished ",1);
		me->set_temp(" marks / exp ",1);
		return 1;
	} 
	if (arg==" dx ") {
		message_vision(HIY " $N 闭 上 眼 睛 ， 默 默 地 许 了 个 愿 。 \ n " NOR, me);  
		me->set(" wished ",1);
		me->set_temp(" marks / dx ",1);
		return 1;
	} 
	return notify_fail(" 你 想 许 什 么 愿 ？ 可 以 许 愿 要 经 验 (exp) 、 潜 能 (pot) 、 黄 金 (gold) 或 者 内 力 (force) 及 法 力 （ mana) 。 \ n "); 
}

void owner_is_killed()
{
	object me = this_player();
	write(HIM" 只 见 一 道 黑 雾 升 起 ... 尸 体 上 什 么 东 西 消 失 了 。 \ n "NOR);
	destruct(this_object());
	return;
}
