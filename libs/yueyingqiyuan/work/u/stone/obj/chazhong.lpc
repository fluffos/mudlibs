inherit ITEM;
//inherit F_FOOD;
inherit F_LIQUID;

string *names = ({
  "西湖龙井",
  "碧螺春",
  "信阳毛尖",
  "君山银针",
  "六安瓜片",
  "黄山毛峰",
  "祁门红茶",
  "都匀毛尖",
  "铁观音",
  "武夷岩茶",  
 });

void create()
{
  string name = names[random(sizeof(names))];
//  set_name(name, ({"tea", "cha", "ping", "bottle"}));
	set_name("白玉茶盅", ({"cha zhong", "chazhong", "cha", "tea"}));
  set_weight(400);
   if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long", "一只精美的白玉茶盅。\n");
    set("unit", "只");
    set("max_liquid", 4);
    set("value", 200);
	}
  	set("liquid", ([
		  "type": "water",
		  "name": ""+name+"",
		  "remaining": 4,
		  ]) );
    setup();
}
