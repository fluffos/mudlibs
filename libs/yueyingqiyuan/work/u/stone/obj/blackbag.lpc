//blackbag.c
//STONE

#include <ansi.h>
inherit ITEM;

void create() {
  set_name("黑色真皮包", ({ "blackbag", "bag", "bao" }));
  set_weight(500);
  set_max_encumbrance(8000);
  if (clonep()) {
    object a, b;
    seteuid(getuid());
    if (a = new("/u/stone/obj/computer"))
      a->move(this_object());

    seteuid(getuid());
    if (b = new("/u/stone/obj/cd"))
      b->move(this_object());
    set_default_object(__FILE__);
  } else {
    set("unit", "只");
    set("long", "一只大大的黑色真皮包，右下角上有一小铭牌：ＩＢＭ。\n");
    set("value", 500);
  }
}

int is_container() { return 1; }
