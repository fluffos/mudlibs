inherit ITEM;
#include <ansi.h>
void create()
{
        set_name(HIG"赐财如意"NOR ,({ "ruyi", "jade ruyi" }));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一柄脆绿欲滴的碧玉如意，在柄上刻着一行古篆小字：“招财进宝 赐财如意”。\n听说是财神赵公明的法宝，可以收天下之财，招人间之宝(zhaocai)。\n");
                set("unit", "柄");
                set("value", 100);
        }
        setup();
}
void init()
{
        add_action("do_zhaocai","zhaocai");
}
int do_zhaocai(string arg)
{
        object me,money;
        me = this_player();
        if(!arg)
                return notify_fail("你要招什么财，进什么宝？(coin,silver,gold,gold-coin)\n");
        if(!wizardp(me)) {
                tell_object(me,"这个是巫师专用的！！\n");
                message("vision","突然从天上传来一声大喝，对着"+me->name()+"喝道：这个可是巫师专用的！\n"
        "紧接着从天上伸下一个大手，将"+me->name()+"身上的"+this_object()->name()+"抓了去。\n"
        "同时只见一道闪电劈下，"+me->name()+"劈得晕了过去。\n",environment(me),me);
                me->unconcious();
                destruct(this_object());
        }
        switch(arg)
        {
                case "coin":
                        money = present("coin_money",me);
                        if(!money) {
                                money = new("/obj/money/coin");
                                money->move(me);
                        }
                        break;
                case "silver":
                        money = present("silver_money",me);
                        if(!money) {
                                money = new("/obj/money/silver");
                                money->move(me);
                        }
                        break;
                case "gold":
                        money = present("gold_money",me);
                        if(!money) {
                                money = new("/obj/money/gold");
                                money->move(me);
                        }
                        break;
                case "gold-coin":
                        money = present("gold_money",me);
                        if(!money) {
                                money = new("/obj/money/gold-coin");
                                money->move(me);
                        }
                        break;
                default:
                        return notify_fail("你要变什么？(coin,silver,gold,gold-coin)\n");
        }
        message_vision("$N定了定神，口中念念有词，“金满屋，银满地，金银财宝堆成山，变变变......”\n",me,this_object());
        message_vision("$N一挥手中$n，眼前一下子出现了许多金银财宝。\n",me,this_object());
        money->add_amount(100);
        return 1;
}
