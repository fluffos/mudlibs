#include <weapon.h>
#include <ansi.h>
inherit HAMMER;

//inherit ITEM;

void init();

void init()
{
	if (!wizardp(this_player())) {
                set("no_get","就你的体格想拿"+this_object()->query("name")+"，这可是全内置的配置，重得很。\n");
		set("no_give","这可是顶级的电脑笔记本，哪能随便送人呀？值好几万呢\n");
		set("no_drop","你是大款吗？顶级的电脑笔记本说扔就扔了？浪费啊！\n");
		set("no_sell","古人哪里知道"+this_object()->query("name")+"的价值？别是顺手牵羊弄来的吧?\n");
	}                                 
}

void create()
{
 		set_name(HIM"【IBM原装电脑笔记本】"NOR, ({ "thinkpad","computer","pc"}));
 		set_weight(1000);
        	 if( clonep() )
                set_default_object(__FILE__);
        	else {
        		set("unit", "台");	
        		set("long",WHT"P4的顶级配置，装有所有最新的软硬件，\n
专门为玩泥巴和写泥巴用的！还是无线上网哦！\n
我FAINT!!\n
底上有一个标签:巫师专用！\n"NOR);				
			set("value", 200000);
			set("wield_msg","只见$N点了头，“嗤”的一声，拉开手中的真皮包，取出一台$n。\n");
                	set("unwield_msg", "$N叹一口气，伸了一个大懒腰，顺手关上了$n，装进背后的真皮包。\n");
			set("armor_prop/intelligence",8);//悟性
			set("is_monitored", 1);
			set("material", "steel");
		}
        	init_hammer(80+random(30), TWO_HANDED);
		setup();
}
