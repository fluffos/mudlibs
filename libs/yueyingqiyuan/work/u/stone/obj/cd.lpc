//cd.c
// stone 20020422
#include <weapon.h>
inherit THROWING;
void create()
{
        set_name("光盘", ({"cd", "cd-room", "cdroom"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("base_unit", "张");
                set("long",    "一张亮晶晶的光盘。\n");
                set("base_weight", 5);
                set("value",1000);
        }
        set_amount(random(10)+1);
        init_throwing(40);
        setup();
}


