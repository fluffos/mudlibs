#include <ansi.h>

inherit NPC;

void create()
{
   	set_name(HIG"蹦蹦兔"NOR, ({"bengbeng tu", "tu","bengbeng"}));
	set("long", "她是雨梦从小养大的灵兔，有时很淘气，不过她可知道雨梦不少的秘密噢！\n");
	set("gender", "女性");
	set("age", 8);
	set("title",""MAG"小淘气"NOR);
	set("chat_chance", 10);
   	set("chat_msg", ({
		"蹦蹦兔说道：Hi,我是蹦蹦兔，可别小看我噢！\n",
		"蹦蹦兔说道：怎么不给我带点好吃的来，看在主人的份上也该意思意思啊……\n",
		"蹦蹦兔说道：想知道我家主儿的秘密吗？嘻嘻，不告诉你。\n",
        }));

	setup();

}

