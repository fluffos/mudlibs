#include <ansi.h>
inherit ITEM;

void create() {
  set_name(RED "蒸馏水" NOR, ({ "zhengliushui", "shui" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一瓶无色无味的蒸馏水, 用来做化学实验用的。 \n");
    set("unit", "瓶");
    set("value", 20000);
  }
  setup();
}

int init() {
  add_action("do_drink", "drink");
}

int do_drink(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要喝什么？\n");
  if (arg == "shui") {
    message_vision("$N仰头咕嘟咕嘟灌下一瓶" + name() + "。\n", me);
    destruct(this_object());
  }
  return 1;
}
