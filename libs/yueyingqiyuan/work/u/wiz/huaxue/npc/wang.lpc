inherit NPC;
//inherit F_DEALER;
#include <ansi.h>;

void create()
{
        set_name("王老师", ({ "wang taoshi", "wang"}));
        set("gender", "男性");
        set("age", 40);

        set("attitude","heroism");
        
        set("combat_exp", 100);
        set("shen_type", 100);
        set("vendor_goods", ({
		"/u/wiz/huaxue/obj/zhenliushui",
		"/u/wiz/huaxue/obj/liusuan",
	}));
        setup();
        set("chat_chance", 10);
}

        void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
