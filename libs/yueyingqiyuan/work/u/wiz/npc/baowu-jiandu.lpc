#include <ansi.h>
inherit NPC;

void rumor_obj();

void create() {
  set_name("管帐先生", ({ "xian shen", "baowu-jiandu" }));
  set("gender", "男性");
  set("age", 30);
  set("combat_exp", 8000);
  set("attitude", "friendly");
  set("env/invisibility", 1);
  setup();
  carry_object("/d/ourhome/obj/linen")->wear();
}

void init() {
  if (!this_object()->query("rumor_obj")) {
    this_object()->set("rumor_obj", 1);
    rumor_obj();
  }
}

void rumor_obj() {
  object *obs, ob, ppl, yao;
  string *dirs, ob_file;
  int i = 0;
  string yao_menpai, *yao_list = ({
    "putuo", "putuo2", "moon", "moon2", "moon3", "puti", "puti2", "wdd",
    "wdd2", "wdd3", "hell", "hell2", "hell3", "wzg", "wzg2", "xueshan",
    "xueshan2", "xueshan3", "jjf", "jjf2", "jjf3", "long", "long2",
  });

  dirs = get_dir("/d/obj/baowu");

  ob_file = "/d/obj/baowu" + dirs[random(time()) % sizeof(dirs)];

  obs = children(ob_file);
  if (sizeof(obs) > 1 && objectp(environment(ob = obs[0]))) {
    if (living(ppl = environment(ob))) {
      if (!userp(ppl) || random(ppl->query("kar")) > 20 || query("sent_yao"))
        CHANNEL_D->do_channel(ob, "rumor", "听说宝物" NOR + ob->name() + HIM "目前在" +
          ppl->name(1) + "的身上。\n");
      else if (ppl->query("combat_exp") > 10000) {
        yao_menpai = yao_list[random(sizeof(yao_list))];
        yao = new("/d/obj/baowu/npc/yao");
        yao->set_perform(yao, yao_menpai);
        yao->set("menpai", yao_menpai);

        if (!ob->query("chased") || ob->query("chased") == 5)
          ob->set("chased", 1);
        else if (ob->query("chased") == 1)
          ob->set("chased", 2);
        else
          ob->set("chased", 5);

        yao->reset_me(yao, ppl, yao_menpai, ob->query("chased"));
        yao->reset_action();
        yao->move(environment(ppl));
        yao->set("target", ppl->query("id"));
        yao->chase_player();
        yao->start();
        set("sent_yao", 1);
        call_out("reset_yao", 600);
        tell_room(environment(yao), yao->name() + "走了过来。\n");
        yao->command_function("follow " + ppl->query("id"));
        yao->command_function("say 识趣的快点把宝物交出来，否则有你好看的。\n");
        CHANNEL_D->do_channel(ob, "rumor", "听说" + ppl->name(1) + "因为拿了"
          +ob->name() + HIM "而被" + yao->name(1) + "追杀。\n");
      } else {
        CHANNEL_D->do_channel(ob, "rumor", "有人看见某人鬼鬼祟祟地从" +
          ppl->name(1) + "身上偷走了一" + ob->query("unit") +
          ob->name() + "！\n");
        destruct(ob);
      }
    } else {
      CHANNEL_D->do_channel(ob, "rumor", "奇怪，怎么一点关于的" NOR + ob->name() + HIM "消息都没有？\n");
      destruct(ob);
    }
  }
  remove_call_out("rumor_obj");
  call_out("rumor_obj", 300);
}

void reset_yao() {
  delete("sent_yao");
}
