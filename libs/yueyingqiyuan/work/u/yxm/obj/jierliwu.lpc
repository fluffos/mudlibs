// jierliwu.c 节日礼物

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
  if (!wizardp(this_player())) {
   set("no_get","这个东西不能get耶！\n");
    set("no_give","这么珍贵的礼物，哪能随便给人？\n");
    set("no_drop","这么宝贵的礼物，扔了多可惜呀！\n");
    set("no_sell","还是自己留着吧。\n");
  }                                    
  add_action("do_eat", "eat");
}

void create()
{
      set_name(HIC "节日礼物" NOR, ({"li wu","liwu"}));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
      set("long", "这是一颗巫师给大家的节日礼物。\n");
    set("value", 5000);
    set("drug_type", "补品");
  }
  
  setup();
}

int do_eat(string arg)
{
  object me = this_player();
  
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  
  me->set("food", (int)me->max_food_capacity());
                me->add("daoxing", 10000);
                me->add("potential",5000);
    message_vision(HIG "$N吃了巫师给你的礼物，得到了十年道行和五千潜能。 \n" NOR, me);
  
  destruct(this_object());
  return 1;
}
