void create() {
  //  mapping name;
  // name = NAME_D->man_name();
  // if ( random(2) )  name = NAME_D->woman_name();
  // set_name(name["name"],({name["id"]}));
  set_name("宝马杀手", ({ "drak bmw" }));
  if (random(2)) set("gender", "男性");
  else set("gender", "女性");
  set("long", "黑暗宝马派来的杀手。\n");
  if (random(15) == 0)
    set("have_jia", 1);
  set("age", 20 + random(30));
  set("attitude", "heroism");
  set("chat_chance_combat", 50);
  set("per", 20 + random(6));
  set("str", 40);
  set("cor", 25);
  set("cps", 25);
  set("int", 25);
  set("chat_chance", 5);
  set("chat_msg", ({
    (: my_randommove :),
  }));
  setup();
}

void init() {
  ::init();
  add_action("do_drive", "drive");
}

int do_drive() {
  object me = this_player();
  message_vision(HIC "$N对$n轻轻的吆喝到:宝宝乖,走咯、走咯！\n" NOR, me, this_object());
  this_object()->my_randommove();
  return 1;
}

