void die() {
  object ob, jia;
  ob = this_object()->query_temp("last_damage_from");
  if (ob) {
    tell_object(ob, HIY "你奋力杀死了杀手，你的武学和道行提高了!\n" NOR);
    ob->add("combat_exp", 500);
    ob->add("potential", 300);
    ob->add("daoxing", 500);
  }
  message_vision("只见$N闷哼一声，消失在黑暗之中!\n", this_object());
  destruct(this_object());

}

int my_randommove() {
  mapping exits;
  string *dirs;
  string ldir;
  string *loclist;
  string *loclist2;
  int size;

  if (!mapp(exits = environment()->query("exits"))) return 0;
  dirs = keys(exits);
  size = sizeof(dirs);
  if (size > 0) {
    ldir = dirs[random(size)];
    loclist = explode(exits[ldir], "/");
    loclist2 = explode(file_name(environment()), "/");
    if (loclist[sizeof(loclist) - 2] == loclist2[sizeof(loclist2) - 2])
      return command("go " + ldir);
  }
  return 0;
}

int random_place() {
  int i, j, k;
  object newob, me;
  mixed *file, exit;

  string *dirs = ({
    "/d/changan",
    "/d/kaifeng",
  });

  if (!sizeof(dirs)) return 1;

  i = random(sizeof(dirs));

  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file)) return 1;

  me = this_object();
  for (k = 0; k < 20; k++) {  // try 20 times
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1)
          continue;

        if (me->move(newob)) {
          message_vision("$N走了过来。\n", me);
          return 1;
        }
      }
    }
  }

  return 0;
}
