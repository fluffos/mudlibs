  if (max_mana < 30 * skillmax / 2) max_mana = 25 * skillmax / 2;
  if (max_mana > 800) max_mana = max_mana * 12 / 10;
  set("max_mana", max_mana);
  set("mana", query("max_mana"));
  set("mana_factor", query("max_mana") / 60);
  set("combat_exp", exp * 11 / 10);
  set("daoxing", exp * 11 / 10);

