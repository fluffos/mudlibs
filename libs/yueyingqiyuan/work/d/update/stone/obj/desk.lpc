#include <ansi.h>
inherit ITEM;
void create() {
  set_name("[1;33m【电脑桌】[2;37;0m", ({ "desk", "zuozi" }));
  set("long",
    "\n[1;36m这是石头用来放笔记本电脑的桌子[2;37;0m\n"
    "\n[1;36m上面居然有一台IBM的原装笔记本电脑！[2;37;0m\n");
  set_weight(500);
  set_max_encumbrance(10000);
  if (clonep()) {
    object a;
    seteuid(getuid());
    if (a = new("/d/update/stone/obj/computer"))
      a->move(this_object());
    set_default_object(__FILE__);
    set("no_get", 1);
    setup();
  }
}
int is_container() { return 1; }
