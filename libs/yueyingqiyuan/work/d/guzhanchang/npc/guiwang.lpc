//stone 20020627
// /d/guzhanchang/npc/guiwang.c 恶鬼王

inherit NPC;
#include <ansi.h>

void create()
{
 set_name("恶鬼王", ({ "gui wang", "gui","wang" }) );
 set("gender", "雄性");
 set("age", 1500);
 set("long",
 "这是古战场最老，也是最凶狠的一个鬼，被称为恶鬼王 ！\n");
 set("str", 48);
 set("cor", 52);
 set("cps", 22);
 set("max_kee", 20000);
 set("max_gin", 20000);
 set("max_sen", 20000);
 set("force",4500);
 set("max_force",4500);
 set("mana",4500);
 set("max_mana",4500);
 set("force_factor",100);
 	set_skill("parry",300);
 	set_skill("dodge",300);
        set_skill("lingfu-steps",300);
	set_skill("unarmed",350);
 	set_skill("yinfeng-zhua",300);
 	map_skill("unarmed","yinfeng-zhua");
 	map_skill("parry","yinfeng-zhua");
        map_skill("dodge","lingfu-steps");
 set("attitude", "aggressive");
 set("combat_exp", 4000000+random(2000000));
 
 set_temp("apply/attack", 100+random(300));
 set_temp("apply/damage",100+random(200));
 set_temp("apply/armor", 200+random(100));
 setup();
 carry_object("/obj/money/gold")->set_amount(20);
}


void die()
{
	int i;
	object me, zhu;
	string zhu_given;
	zhu_given = "/d/guzhanchang/obj/piduzhu.lpc";
	if(objectp(me = query_temp("last_damage_from") ))
	{
		if ( (!zhu_given->in_mud()) ) {
			message_vision("$N张开大嘴吐出一颗碧绿色的宝珠，$n赶忙一把抓往纳入怀里。\n",this_object(),me);			
			zhu = new("/d/guzhanchang/obj/piduzhu");
			zhu->move(me);
			MONITOR_D->report_rumor_object_msg(me, "拿到碧血宝珠了！");			
		}
	}
	::die();
}

