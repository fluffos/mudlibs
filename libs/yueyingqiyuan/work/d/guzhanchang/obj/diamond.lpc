// diamond.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIW "钻石" NOR, ({ "diamond", "zuanshi" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIM "亮晶晶的钻石，人见人爱的钻石，啊～～钻石！\n" NOR);
    set("value", 200000);
    set("unit", "克拉");
    set_weight(50);
    set("is_monitored", 1);
  }
}
