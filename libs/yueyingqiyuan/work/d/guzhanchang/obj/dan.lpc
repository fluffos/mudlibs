//stone 20020625
// /d/guzhanchang/obj/dan.c 麒麟竭丹

#include <ansi.h>
inherit ITEM;
void init() {
  if (!wizardp(this_player())) {
    set("no_give", "这么珍贵的麒麟竭丹，哪能随便给人？\n");
    set("no_drop", "这么宝贵的麒麟竭丹，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "麒麟竭丹" NOR, ({ "qilin dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIR "这是一颗赤红色的丹丸，正散发着清香芬芳的气息，据说是麒麟精气完
结时遗留下的血竭丹，有开窍明目之功用。传说吃一颗可得3万潜能。\n" NOR);
    set("value", 10000);
    set("no_put", 1);
    set("is_monitored", 1);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (this_player()->query("lingyao-pot") >= 1)
    return notify_fail("麒麟竭丹乃三界第一极炎热阳之丹，多食会暴体而死。\n");

  this_player()->add("potential", 30000);
  message_vision("$N一仰头咽下一颗麒麟竭丹，顿时开窍明目，似乎拥有无穷的潜能 !\n", this_player());
  this_player()->add("lingyao-pot", 1);
  destruct(this_object());
  return 1;
}
