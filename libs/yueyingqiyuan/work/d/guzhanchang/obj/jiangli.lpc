// stone 20020625
// /d/guzhanchang/obj/jiangli.c 神秘果

#include <ansi.h>
inherit ITEM;

void init() {
  if (!wizardp(this_player())) {
    set("no_give", "这么珍贵的神秘果，哪能随便给人？\n");
    set("no_drop", "这么宝贵的神秘果，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIM "神秘果" NOR, ({ "shenmi guo", "guo" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", HIM "一枚微微泛红略带黑点的奇怪果子，发出浓郁醉人的香气。此应是上古药王神农氏
尝百草时，无意中发现的珍药。据说有可洗髓伐毛，易经通脉，起死回生之神效。
自古相传只需吃一枚便可加臂力，强体质，增灵性，脱胎换骨。\n" NOR);
    set("value", 10000);
    set("no_put", 1);
    set("is_monitored", 1);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (this_player()->query("lingyao-jiangli") >= 1)
    return notify_fail("神秘果为上古珍果，药性霸道猛列，不可多食，否则必会裂体而亡！\n");

  //        this_player()->add("combat_exp", 5000);
  this_player()->add("str", 1);
  this_player()->add("con", 1);
  this_player()->add("spi", 1);
  message_vision("$N小心把神秘果纳入口中，入口即化，!\n", this_player());
  tell_object(
    this_player(),
    "神秘果入口即化，一股琼浆直透五脏六府，全身的毛孔舒泰之极......\n突然全身上下传来刀割般的巨痛，似乎要把你的身躯撕裂......" NOR
  );
  this_player()->add("lingyao-jiangli", 1);
  this_player()->unconcious();
  destruct(this_object());
  return 1;
}
