//stone 20020625
// /d/guzhanchang/obj/fali.c 灵山仙芝

#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  if (!wizardp(this_player())) {
    set("no_give", "这么珍贵的仙芝，哪能随便给人？\n");
    set("no_drop", "这么宝贵的仙芝，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(YEL "灵山仙芝" NOR, ({ "xian zhi", "zhi" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("long", YEL "这是一棵淡黄色的仙芝，常寄生于枯木上的菌类，
俗称瑞草，还阳草。传说吃一棵可得50法力。\n" NOR);
    set("value", 10000);
    set("no_put", 1);
    set("is_monitored", 1);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (this_player()->query("lingyao-fali") >= 1)
    return notify_fail("仙芝功效大补，多服食会物极必反，吐血而亡。\n");

  this_player()->add("maximum_mana", 50);
  message_vision("$N三口两口吞下一棵灵山仙芝，立时感到身轻体健，精力充沛。\n", this_player());
  this_player()->add("lingyao-fali", 1);
  destruct(this_object());
  return 1;
}
