inherit ITEM;

void create()
{
        set_name("乾坤百宝袋", ({ "bag" }) );
        set_weight(0);
        set_max_encumbrance(8000000);
                set_max_items(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "口");
                set("long", "一个天界才有的金丝织彩百宝袋，可包容万物。\n");
                set("value", 50000);
                set("no_sell", 1);
		set("no_put", 1);
		set("no_drop", 1);
		set("no_give", 1);
//		set("no_get", 1);
                set("is_monitored",1);
        }
}

int is_container() { return 1; }



