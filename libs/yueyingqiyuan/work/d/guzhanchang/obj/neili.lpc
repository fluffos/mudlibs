// stone 20020625
// d/guzhanchang/obj/neili.c 仙莲子

#include <ansi.h>
inherit ITEM;

void init()
{	
	if (!wizardp(this_player())) {		
		set("no_give","这么珍贵的仙莲子，哪能随便给人？\n");
		set("no_drop","这么宝贵的仙莲子，扔了多可惜呀！\n");
		set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
	}
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW"仙莲子"NOR, ({"lian zi", "zi"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "粒");
                set("long", HIW"一粒洁白如玉的莲子，其形珠圆玉润，产自天上瑶池中的仙
莲。服食后真气充盈，经脉通畅。传说吃一粒可得50内力。\n"NOR);
                set("value", 10000);
                set("no_put", 1);
                set("is_monitored",1);
        }
        setup();
}

int do_eat(string arg)
{
        if (!id(arg))
        	return notify_fail("你要吃什么？\n");
        if (this_player()->query("lingyao-neili") >=1 )        	
        return notify_fail("仙莲子乃三界第一极寒阴冷之物，多吃会冻僵而死。\n");
        
        this_player()->add("maximum_force", 50);
        message_vision("$N吃下一粒仙莲子，头上缓缓升起淡淡白烟，只觉得内力又深了一层！\n", this_player());
        this_player()->add("lingyao-neili",1);
        destruct(this_object());
        return 1;
}


