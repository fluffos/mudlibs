#include <ansi.h>
#include <dbase.h>
#include <armor.h>

//inherit ITEM;
inherit NECK;
inherit F_UNIQUE;

int do_wear(string arg);
int do_remove(string arg);

void create()
{
	set_name( HIG"碧"RED"血"WHT"珠"NOR , ({"pidu zhu", "zhu","bixue zhu"}));
	set_weight(120);
	if (clonep())
    	set_default_object(__FILE__);
  	else {
	set("unit", "颗");  
	set("no_get",1);
	set("no_put",1);
	set("long", HIG"那宝珠碧绿晶莹。一见可知定非凡品。被阳光一照，
碧血珠美丽之极，变幻万端，宝珠色里碧绿，中间
有一缕"RED"淡红"NOR""HIG"，晶莹透明。拿在手中甚是阴凉舒适。
这也是一颗珍贵的辟毒珠，可以用来解毒(jiedu)。\n"NOR);
	set("value", 2000000);  
	set("armor_prop/spells", 10);
	set("armor_prop/armor", 30);
		}
	set("is_monitored",1);
	setup();  
}

int init ()
{ if (!wizardp(this_player())) {
	set("no_drop","这么宝贵的碧血珠，哪能乱扔! \n");
        set("no_give","这么宝贵的碧血珠，还是自己留着吧! \n");
        set("no_sell","这么贵的东西，人家怎么买的起! \n");
	}
	add_action ("do_jiedu","jiedu");
	add_action("do_wear","wear");
	add_action("do_remove", "remove");
	return 1;
}

int do_jiedu (string arg)
{
	string *msgs = ({
"$N将"HIG"碧"NOR""HIR"血"NOR""HIW"珠"NOR"用力在身上摩擦。\n"NOR,
	});
	object me = this_player(1);

	if (me->is_busy())
		return notify_fail (HIG"你现在正忙着，不能替自己解毒！\n"NOR);
	message_vision (msgs[random(sizeof(msgs))],me);
	me->start_busy(1/2,0);if ((me->query("kar")+me->query_temp("spring/cure_times")) > 1)
	{
	if (! me->update_condition())
		return 1;     
	message_vision ("$N"HIR"忽然从嘴里吐出一滩黑血，身上的毒已经清除了。\n"NOR,me);
	me->clear_condition();
//    me->unconcious();
	}   
	me->add_temp("spring/cure_times",1);
	return 1;
}

int valid_leave(object me, string dir)
{
	me->delete_temp("spring/cure_times",1);
//  return ::valid_leave(me, dir);
}

int do_wear (string arg)
{
	object me = this_player();
	object zhu = this_object();
	string name = zhu->query("name");
	string msg;

	if (arg == "all") arg = "pidu zhu";
	if (arg != "bixue zhu" && arg != "zhu" && arg != "pidu zhu")
		return notify_fail("你要佩带什么？\n");
	msg = HIG"$N戴上一颗"+name+"，立即神采飞扬，容光焕发。\n"NOR; 
	if(zhu->query("unequip_msg"))
		zhu->delete("unequip_msg");
	zhu->set("wear_msg",msg);
	return 0;	
}

int do_remove (string arg)
{
	object me = this_player();
	object zhu = this_object();
	string name = zhu->query("name");
	string msg;

	if (arg != "all" && arg != "pidu zhu" && arg != "bixue zhu" && arg != "zhu")
		return notify_fail("你要摘掉什么？\n");

	msg = GRN"$N将"+name+"轻轻地摘下来……\n"NOR; 
	zhu->delete("wear_msg");
	zhu->set("unequip_msg",msg);
	return 0;	
}
