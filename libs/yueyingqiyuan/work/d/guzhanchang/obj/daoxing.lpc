//stone 20020625
// /d/guzhanchang/obj/daoxing.c 血露蟠桃

#include <ansi.h>
inherit ITEM;

void init() {
  if (!wizardp(this_player())) {
    set("no_give", "这么珍贵的血露蟠桃，你给别人，不觉可惜吗？\n");
    set("no_drop", "这么宝贵的血露蟠桃，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "血露蟠桃" NOR, ({ "pan tao", "tao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", HIR "这是一只晶莹发亮的赤红色蟠桃，散发出清香扑鼻的特异芬芳，
乃是天界蟠桃园中的异种，罕遇难求，据说吃一棵可得10年道行。\n" NOR);
    set("value", 10000);
    set("no_put", 1);
    set("is_monitored", 1);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (this_player()->query("lingyao-daoxing") >= 1)
    return notify_fail("血露蟠桃功效大补，多服食会物极必反，吐血而亡。\n");

  this_player()->add("daoxing", 10000);
  message_vision("$N张大嘴巴，连皮带肉吞了下去，立时觉得道行又高了一层!\n", this_player());
  this_player()->add("lingyao-daoxing", 1);
  destruct(this_object());
  return 1;
}
