//stone 20020625
// /d/guzhanchang/exp.c 凌宵果

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{	
	if (!wizardp(this_player())) {		
		set("no_give","这么珍贵的凌宵果，哪能随便给人？\n");
		set("no_drop","这么宝贵的凌宵果，扔了多可惜呀！\n");
		set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
	}
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIB"凌宵果"NOR, ({"lingxiao guo", "guo"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", HIB"一颗发出幽幽蓝光的奇异的果实，相传在昆仑山半天高的神树上，每年
会结出一串果子，将其食之能强身健体。传说吃上一颗可得5000武学。\n"NOR);
                set("value", 10000);
		set("no_put", 1);
                set("is_monitored",1);
        }
        setup();
}

int do_eat(string arg)
{
        if (!id(arg))
        return notify_fail("你要吃什么？\n");
        if (this_player()->query("lingyao-exp") >=1 )
        return notify_fail("凌宵果功效大补，多吃会乱性伤神，走火入魔！\n");

        this_player()->add("combat_exp", 5000);
        message_vision("$N慢慢吃下一颗凌宵果，只觉得心中一迷，手舞足蹈起来......\n\n一路疯拳打完，神闲气定，只觉武功心得大有进步。\n", this_player());
        this_player()->add("lingyao-exp",1);
        this_player()->start_busy(6);
        destruct(this_object());
        return 1;
}


