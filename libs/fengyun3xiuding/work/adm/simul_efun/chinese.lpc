
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// AGENTS.md §15h: on this driver str[i] is a Unicode codepoint (UTF-8
	// mudlib), not a raw GBK byte -- the old GBK lead-byte range check
	// (str[0] > 160 && str[0] < 255) is always false for real Chinese
	// text now. Use a CJK Unicode codepoint range check instead, and
	// halve the length guard from >=2 (GBK byte pairs) to >=1 (UTF-8
	// characters) -- logind.lpc's check_legal_name calls this per single
	// character (name[i..<0]).
	if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
	return 0;
}
