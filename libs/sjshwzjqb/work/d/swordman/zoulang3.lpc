int valid_leave(object me, string dir)
{       if (dir == "north") {
        if((string)me->query("title")!=WHT"十本刃剑客"NOR){
        if (objectp(present("yushui", environment(me))))
        return notify_fail("宇水横剑挡在面前：能够强过我的话，便可以从这过去。\n");

        }

        return ::valid_leave(me, dir);
        }
        return ::valid_leave(me, dir);

}
