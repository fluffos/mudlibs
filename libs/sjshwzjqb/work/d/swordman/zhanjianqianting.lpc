int valid_leave(object me, string dir)
{       if (dir == "north") {
        if((string)me->query("title")!=WHT"十本刃剑客"NOR){
        if (objectp(present("zongcilang", environment(me))))
        return notify_fail("宗次郎微笑着说道：志志雄大人不想有人打搅到他，所以请回吧。\n");

        }

        return ::valid_leave(me, dir);
        }
        return ::valid_leave(me, dir);

}
