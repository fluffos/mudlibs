//药材


#include <ansi.h>

inherit ITEM;

//int do_eat(string);
void init();
void create()
{
  set_name(RED "狗骨" NOR, ({"gou gu","yaocai"}));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "治疗外伤的好药。\n");
    set("value", 100);
    set("drug_type", "yaodan");
  }
  setup();
}


