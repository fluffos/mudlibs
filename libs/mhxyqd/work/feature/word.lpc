string trans_word(string arg) {
  int i, j, len, esc = 0;
  string msg = "";

  if (!arg) return "";

  len = strlen(arg);

  if (len < 1) return "";

  for (j = 0; j < 4; j++) {
    for (i = 0; i < len; i++) {
      if (arg[i] == 27) esc = 1;

      if (!esc) {
        if (arg[i] >= 65 && arg[i] <= 90) {
          int count;
          count = arg[i] - 65;
          count += 26 * j;
          msg += e_word_1[count];
        } else if (arg[i] >= 97 && arg[i] <= 122) {
          int count;
          count = arg[i] - 97;
          count += 26 * j;
          msg += e_word_2[count];
        } else if (arg[i] == 32)
          msg += "        ";
        else continue;
      } else msg += arg[i..i];

      if (esc && arg[i] == 'm')
        esc = 0;
    }
    msg += "\n";
  }
  return msg;
}

string trans_d_word(int data) {
  int i, tmp1, tmp2;
  string msg = "";

  i = 4;
  while (i--) {
    tmp1 = data;
    tmp2 = data % 10;
    while (tmp1) {
      int count;
      count = tmp2 + 10 * i;
      msg = d_word[count] + msg;
      tmp1 /= 10;
      tmp2 = tmp1 % 10;
    }
    msg = "\n" + msg;
  }
  return msg + "\n";
}
