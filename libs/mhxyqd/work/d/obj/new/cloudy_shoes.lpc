// cloudy_shoes.c

#include <armor.h>
#include <ansi.h>

inherit BOOTS;

void create() {
  set_name(HIW "凤凌踏云靴" NOR, ({ "cloudy shoes", "shoes" }));
  set_weight(1000);
  set("long", "一双凤纹绣边的踏云靴．\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "leather");
    set("unit", "双");
    set("value", 100000);
    set("armor_prop/armor", 10);
    set("armor_prop/dodge", 20);
  }
  setup();
}
