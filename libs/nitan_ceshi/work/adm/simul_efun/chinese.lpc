string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  int i, l;

  // GBK byte-range check (AGENTS.md sec.15h): on this driver str[i] is
  // a Unicode codepoint, not a raw GBK byte, and strlen() counts
  // characters, not bytes -- rewritten as a CJK Unified Ideographs
  // codepoint range check.
  l = strlen(str);
  if (l < 1) return 0;

  for (i = 0; i < l; i++) {
    if (str[i] < 0x4e00 || str[i] > 0x9fff) return 0;
  }

  return 1;
}

