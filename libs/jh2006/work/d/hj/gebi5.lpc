// gebi5.c
#include <room.h>
inherit ROOM;
void create() {
  set("short", "大戈壁");
  set("long", @LONG
这是西域的大戈壁，要走出这里并非易事。不远处尘土沙粒铺天盖地般吹
来，看来要起风暴了。
LONG);
  set("exits", ([
    "北-大戈壁": __DIR__ "gebi2",
    "南-大戈壁": __DIR__ "gebi3",
    "东-大戈壁": __DIR__ "gebi4",
    "西-大戈壁": __DIR__ "gebi1",
  ]));
  set("outdoors", "西域");
  setup();
}

void init() {
  object me = this_player();
  switch (random(4)) {
    case 0: me->set_temp("gc_n", 1); break;
    case 1: me->set_temp("gc_s", 1); break;
    case 2: me->set_temp("gc_e", 1); break;
    case 3: me->set_temp("gc_w", 1); break;
  }
  if (me->query_skill("dodge", 1) <= 150)
    me->add("jingli", -15);
  else
    me->add("jingli", -5);
}
