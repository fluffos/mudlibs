// mg3.c 迷宫
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
        set("short", CYN "高昌迷宫" NOR);
        set("long", @LONG
你越走越害怕，不知道前面会出现什么东西，你手上提着武器，慢慢的摸
索着前进。
LONG);
        set("no_sleep_room", 1);
        set("exits", ([
              "东-高昌迷宫" : __DIR__"mg4",
              "西-高昌迷宫" : __DIR__"mg4",
              "南-高昌迷宫" : __DIR__"mg4",
              "北-高昌迷宫" : __DIR__"mg4",            
        ]));        
   set("coor/x",-310);
  set("coor/y",190);
   set("coor/z",20);
   setup(); 
}

int valid_leave(object me, string dir)
{
       if (dir == "西-") me->add_temp("mark/steps",1);
       if (dir == "东-") me->add_temp("mark/steps",-1);         
       if (me->query_temp("mark/steps") == 5){
            me->move(__DIR__"mg-indoor");
            me->delete_temp("mark/steps");
             return notify_fail("你正走着，突然发现前面好象有了一些光亮。\n");
       }  
       if (me->query_temp("mark/steps") == -5){  
           me->move(__DIR__"mg2");
           me->delete_temp("mark/steps");
             return notify_fail("你正走着，突然发现前面好象有了一些光亮。\n");
       }           
       return ::valid_leave(me, dir);
}
