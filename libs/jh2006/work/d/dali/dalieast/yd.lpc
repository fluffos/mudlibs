inherit ROOM;

void create() {
  set("short", "燕子洞");
  set("long", @LONG
燕子洞，位于古城建水东面三十公里的群山之中。以它独特的景色，瑰丽
的风采，吸引着无数游人。燕子洞紧靠鸡街至建水的公路旁。洞前古木参天，
绿荫匝地，石芽丛生，石骨嶙峋。到山不知门何处，洞口白云自吞吐。
LONG
  );
  set("outdoors", "大理");

  set("exits", ([
    "北下-澄江抚仙湖": __DIR__ "chengj",
    "进入-燕子洞口": __DIR__ "ydk",
  ]));

  set("coor/x", -260);
  set("coor/y", -460);
  set("coor/z", -10);
  setup();
}
