// sl_cloth.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("五 彩 神 龙 皮", ({"shenlong piw", "shenlong pi","pi", "cloth"}));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long", "这是一张五彩神龙的皮。\n");
                set("value", 8000);
                set("material", "fur");
                set("unique", 1);
                set("treasure",1);
                set("armor_prop/armor", 80);
        }
        setup();
}