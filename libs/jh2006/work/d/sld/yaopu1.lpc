// yaopu1.c
// 药圃
inherit ROOM;
void create()
{
	set("short","药圃");
	set("long",@long
这里是神龙岛的药圃，种了不少珍奇药材。
long);
	set("exits",([
	    "南-竹林" : __DIR__"zl1",
            "西-药圃" : __DIR__"yaopu6",
            "北-药圃" : __DIR__"yaopu2",
]));
	set("no_clean_up",1);
	set("can_zhong",1);
	set("8type","乾");
	set("outdoors", "神龙岛");
	setup();
}
	    	
