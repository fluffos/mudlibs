#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "翠谷2");
        set("long", @LONG
你面前是个花团锦簇的翠谷，红花绿树，交相掩映。脚下踏着的是柔软细
草，鼻中闻到的是清幽花香，鸣禽间关，鲜果悬枝，不由的心旷神怡。
LONG    );
        set("exits", ([
                "西-瀑布" : __DIR__"pubu",
                "东-翠谷1" : __DIR__"shanlu3",
        ]));
