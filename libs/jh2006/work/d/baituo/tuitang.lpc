#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "退堂");
        set("long", @LONG
这间退堂不大，只放有两个茶几，挂了两副字画。左右两边是睡房，
再往后是个小院子。
LONG);
        set("exits", ([
              "南-堂屋" : __DIR__"tangwu",
              "东-睡房" : __DIR__"shuifang",
              "北-花园" : __DIR__"yuanzi",
        ]));
        setup(); 
}
