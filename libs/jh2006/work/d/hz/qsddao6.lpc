// /u/beyond/hz/qsddao4.c 青石大道

inherit ROOM;
void create() {
  set("short", "青石大道6");
  set("long", @LONG
你走在一条林荫大道上，两边鸟语花香，游客们往来穿梭，熙熙攘攘好
不热闹。你也兴致勃勃地继续在杭州观赏美丽的风景。大道西面是天香楼，
东面是一个书堂。
LONG
  );
  set("outdoors", "hz");
  set("exits", ([
    "南-青石大道5": __DIR__ "qsddao5",
    "西-天香楼": __DIR__ "jiulou",
    "东-书院": __DIR__ "shuyuan",
    "北-北门": __DIR__ "beimen",

  ]));
  set("coor/x", 100);
  set("coor/y", -320);
  set("coor/z", 0);
  setup();
}
