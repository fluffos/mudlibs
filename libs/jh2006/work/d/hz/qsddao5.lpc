// /u/beyond/hz/qsddao4.c 青石大道

inherit ROOM;
void create() {
  set("short", "青石大道5");
  set("long", @LONG
你走在一条林荫大道上，两边鸟语花香，游客们往来穿梭，熙熙攘攘好
不热闹。你也兴致勃勃地继续在杭州观赏美丽的风景。大道西面是杂货铺，
东面就是杭州城里的一个药铺。
LONG
  );
  set("outdoors", "hz");
  set("exits", ([
    "南-青石大道4": __DIR__ "qsddao4",
    "西-杂货铺": __DIR__ "zahuopu",
    "东-万年春": __DIR__ "yaopu",
    "北-青石大道6": __DIR__ "qsddao6",

  ]));
  set("coor/x", 100);
  set("coor/y", -330);
  set("coor/z", 0);
  setup();
}
