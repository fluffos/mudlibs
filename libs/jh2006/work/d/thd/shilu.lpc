#include <room.h>

inherit ROOM;

void create()
{
        set("short", "石路");
        set("long", @LONG
你踏过小石堤，立时一座精舍映入眼帘,屋外攀满了青藤。东面是
一间书房，而西面则是一座方厅。
LONG
        );
        set("exits", ([
                "南-小石堤" : __DIR__"shidi",
                "北-精舍" : __DIR__"jingshe",
                "东-书房" : __DIR__"bookroom",
                "西-方厅" : __DIR__"hall",
        ]));

        set("outdoors", "桃花岛");

        setup();
}


