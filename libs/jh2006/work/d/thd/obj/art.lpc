#include <ansi.h>
inherit ITEM;
void create()
{
        switch(random(10)) {
               case 0 : set_name( "清明上河图" , ({ "tu1", "art"})); break;
               case 1 : set_name( "山中游旅图" , ({ "tu1", "art"})); break;
               case 2 : set_name( "率意帖" , ({ "tu1", "art"})); break;
               case 3 : set_name( "八骏图" , ({ "tu1", "art"})); break;
               case 4 : set_name( "黄山行旅图" , ({ "tu1", "art"})); break;
               case 5 : set_name( "裴将军诗帖" , ({ "tu1", "art"})); break;
               case 6 : set_name( "满江红词稿" , ({ "tu1", "art"})); break;
               case 7 : set_name( "明月宝剑图" , ({ "tu1", "art"})); break;
               case 8 : set_name( "百鸟朝凤图" , ({ "tu1", "art"})); break;
               case 9 : set_name( "宋徽宗字帖" , ({ "tu1", "art"})); break;
        }
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("value", 300000);
                set("unit", "幅");
                set("weight", 100);
                set("material", "paper");
                }
        setup();
}

