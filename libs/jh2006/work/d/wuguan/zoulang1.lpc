//zoulang1.c
inherit ROOM;

void create() {
  set("short", "西廊1");
  set("long", @LONG
这是一条走廊，廊顶描绘着江南秀美的风景。每两根翠绿色的柱子间相隔
也就两三尺的距离，朱红色的琉璃瓦，嫩黄色的地砖。在走廊里面，丫鬟、奴
仆们走来走去，都忙着自己的事情，不敢有一点怠慢。西面传出阵阵诱人的香
气，往北走就到了后院，南面是一个练武场。 
LONG
  );

  set("exits", ([
    "西-厨房": __DIR__ "chufang",
    "东-西廊2": __DIR__ "zoulang2",
    "北-白石路": __DIR__ "shilu1",
    "南-西练武场": __DIR__ "wuchang2",
  ]));

  setup();
}
