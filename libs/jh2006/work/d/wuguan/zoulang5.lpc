//zoulang5.c
inherit ROOM;

void create() {
  set("short", "东廊1");
  set("long", @LONG
这是一条走廊，廊顶描绘着江南秀美的风景。每两根翠绿色的柱子间相隔
也就两三尺的距离，朱红色的琉璃瓦，嫩黄色的地砖。在走廊里面，丫鬟、奴
仆们走来走去，都忙着自己的事情，不敢有一点怠慢。往西走就是武馆的大厅，
东面是走廊的延伸，北面是一间不小的偏厅。
LONG
  );

  set("exits", ([
    "西上-武馆大厅": __DIR__ "dating",
    "东-东廊2": __DIR__ "zoulang6",
    "北-偏厅": __DIR__ "pianting1",
  ]));

  setup();
}
