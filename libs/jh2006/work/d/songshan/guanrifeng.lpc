//观日峰

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIR "观日峰" NOR);
  set("long",
    "这里就是" HIG "嵩山观日峰" NOR "，往这里一站,你不禁有一种:\n"
    "          渺万里层云,千山暮雪,只影向谁去?\n"
    "的感觉,这里有几块石头,大概是练气士平时修炼打坐的地方!\n"
  );
  set("outdoors", "嵩山");
  set("no_fight", 1);
  set("exits", ([
    "西-封禅台": __DIR__ "fengchantai",
  ]));
  setup();
}

void init() {
  add_action("do_guan", "guan");
  //  add_action("do_mingsi", "mingsi");
}

int do_guan(string arg) {
  object me = this_player();
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!arg || arg == "") return 0;
  if (arg == "sun") {
    message_vision("$N往石头上一站,看着刚刚升起的太阳,渐渐进入冥思。\n", me);
    me->set_temp("marks", "冥思");
    return 1;
  }
}

int do_mingsi() {
  object me = this_player();
  if (me->query_temp("marks") != "冥思")
    return 0;
  message_vision("$N在冥思中,慢慢和天地融合。\n", me);
  me->delete_temp("marks");
  me->start_busy(5);
  call_out("end_mingsi", 10, me);
  return 1;
}

void end_mingsi(object me) {

  message_vision("过了良久，$N突然体会到了天人合一的道理,武功大进。\n", me);
  me->add("potential", me->query_skill("hanbing-zhenqi", 1) / 10);
  if ((int)me->query("potential", 1) > (int)me->query("max_pot", 1))
    me->set("potential", (int)me->query("max_pot", 1));
  me->add("combat_exp", me->query_skill("hanbing-zhenqi", 1) / 30);



  return;
}
