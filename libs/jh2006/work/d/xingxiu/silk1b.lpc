inherit ROOM;

void create()
{
        set("short", "仙人崖");
        set("long", @LONG
这里以传说有神仙出没而得名，每到盛夏夜，火光从崖面飞出，名曰仙人
送灯。面山带水，群峰环峙，野草蒙茸，奇花异树，清幽险峻，令人绝俗。
LONG);
        set("outdoors", "yili");

        set("exits", ([
                "西北-水帘洞" : __DIR__"silk1a",
                "东北-丝绸之路" : __DIR__"silk",
        ]));

        setup();
}

