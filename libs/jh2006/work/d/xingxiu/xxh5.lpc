inherit ROOM;

void create()
{
        set("short", "星宿海");
        set("long", @LONG
这儿便是星宿海的尽头了。举目遥望, 周围是无际的湖泊和沼泽。
虽是荒芜, 然阴暗潮湿, 毒虫繁殖甚富。星宿弟子常来此捕捉毒虫,以
备练毒之用。
LONG
        );
        set("exits", ([
             "东南-星宿海" : __DIR__"xxh3",
             "西南-星宿海" : __DIR__"xxh4",
        ]));
        set("objects", ([
                __DIR__"npc/xxdizi.lpc"  : 1,
        ]));

        set("no_clean_up", 0);
        set("outdoors", "xingxiuhai");

        setup();

}

