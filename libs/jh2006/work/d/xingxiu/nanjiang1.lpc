inherit ROOM;

void create() {
  set("short", "南疆沙漠");
  set("long", @LONG
这就是浩瀚的塔克拉马干大沙漠，一走进来，你仿佛迷失了方向。
你感到口内十分焦渴，还是快些离开吧。
LONG);

  set("exits", ([
    "东北-南疆沙漠": __DIR__ "nanjiang",
    "东南-南疆沙漠": __FILE__,
    "西南-南疆沙漠": __DIR__ "nanjiang2",
    "西北-南疆沙漠": __FILE__,
    "北-南疆沙漠": __FILE__,
    "西-南疆沙漠": __FILE__,
    "南-南疆沙漠": __FILE__,
    "东-南疆沙漠": __FILE__,
  ]));
  set("coor/x", -310);
  set("coor/y", 110);
  set("coor/z", 0);
  set("coor/x", -310);
  set("coor/y", 110);
  set("coor/z", 0);
  set("coor/x", -310);
  set("coor/y", 110);
  set("coor/z", 0);
  setup();
}

int valid_leave(object me, string dir) {
  int current_water;

  current_water = me->query("water");
  if (current_water == 0) {
    write("你已经感到不行了，冥冥中你觉得有人将你抬到吐谷浑伏俟城中。\n");
    me->move(__DIR__ "silk8");
    me->unconcious();
  }

  if (current_water > 0 && current_water <= 20) {
    write("你过于缺水，眼冒金星。\n");
    me->set("water", 0);
  }

  if (current_water > 20) {
    me->set("water", current_water - 20);
  }
  if (dir == "东-" || dir == "南-" || dir == "西-" || dir == "北-")
    return notify_fail("你向那边走去，结果发现那是沙漠中的海市蜃楼。\n");
  return ::valid_leave(me, dir);
}
