//huaishu1.c

inherit ROOM;

void create() {
  set("short", "槐树林");
  set("long", @LONG
眼前一暗你走进一片槐树林，枝头鸟语轻鸣，荫下清风荡漾。好一个清
净禅修之所在。林中一 条小径曲折伸向前方。
LONG
  );
  set("outdoor", "shaolin");
  set("exits", ([
    "西-菩提院": __DIR__ "putiyuan",
    "东-槐树林": __DIR__ "huaishu2",
  ]));
  set("coor/x", 20);
  set("coor/y", 300);
  set("coor/z", 120);
  setup();
}
