inherit ROOM;

void create()
{
	set("short", "香积厨");
	set("long", @LONG
炊烟缭绕，蒸汽腾腾，香味扑鼻而来。靠墙是一排数丈长的灶台，支着
十来口大锅，最大的一口饭锅上方竟有人从梁上悬空而下，手持木棍在搅拌
。除了烧饭的僧人外，几位火工头陀忙着劈柴运薪，灶下炉火熊熊。一位中
年僧人正来回催促着。
LONG
	);

	set("exits", ([
		"北-香积厨" : __DIR__"chufang1",
                "西-饭厅" : __DIR__"fanting3",
                "南-小路" : __DIR__"xiaolu-1",
	]));

	set("objects",([
		__DIR__"npc/shaofan-seng" : 1,
                __DIR__"npc/hg-toutuo" : 1,
	]));
	set("coor/x",90);
  set("coor/y",230);
   set("coor/z",110);
   setup();
}



