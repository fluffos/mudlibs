//huaishu5.c

inherit ROOM;

void create() {
  set("short", "槐树林");
  set("long", @LONG
眼前一暗你走进一片槐树林，枝头鸟语轻鸣，荫下清风荡漾。好一个清
净禅修之所在。林中一 条小径曲折伸向前方。
LONG
  );
  set("outdoor", "shaolin");
  set("exits", ([
    "西-龙树院": __DIR__ "lshuyuan",
    "东北-后殿广场": __DIR__ "hguangz1",
    "南-槐树林": __DIR__ "huaishu4",
  ]));
  set("coor/x", 30);
  set("coor/y", 320);
  set("coor/z", 120);
  set("coor/x", 30);
  set("coor/y", 320);
  set("coor/z", 120);
  setup();
}
