#include <room.h>
inherit ROOM;


void create()
{
	set("short", "塔林");
	set("long", @LONG
这里是少林历代僧侣的墓地，上百座墓塔式样繁多，造型各异。你置身
其中，只看得眼花缭乱，不知该往哪个方向走，你似乎迷路了。
LONG
	);

	set("exits", ([
		"东北-塔林" : __DIR__"talin"+(random(10)+1),
		"东南-塔林" : __DIR__"talin3",
		"西北-塔林" : __DIR__"talin"+(random(10)+1),
		"西南-塔林" : __DIR__"talin5",
		"南-塔林"     : __DIR__"talin"+(random(10)+1), 
                "西-塔林"      : __DIR__"talin"+(random(10)+1),
                "北-塔林"     : __DIR__"talin"+(random(10)+1),
                "东-塔林"      : __DIR__"talin"+(random(10)+1),
	]));

	set("outdoors", "shaolin");

	set("coor/x",20);
  set("coor/y",300);
   set("coor/z",120);
   setup();

}

