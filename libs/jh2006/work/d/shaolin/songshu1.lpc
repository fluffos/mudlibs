//songshu1.c

inherit ROOM;

void create() {
  set("short", "松树林");
  set("long", @LONG
这是一片松树林。高高的大松树簇在一块，密实的枝叶象一蓬蓬巨伞般
伸向天空，把阳光遮得丝毫也无。一条洁净的青石小径蜿蜒林中。
LONG
  );
  set("outdoor", "shaolin");
  set("exits", ([
    "东-药王院": __DIR__ "yaowang",
    "西北-后殿": __DIR__ "hguangz3",
    "南-松树林": __DIR__ "songshu2",
  ]));
  set("coor/x", 70);
  set("coor/y", 310);
  set("coor/z", 110);
  setup();
}
