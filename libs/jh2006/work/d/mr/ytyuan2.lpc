#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIM "樱桃园" NOR);
  set("long", @long
这是一片樱桃园，树上开满了樱桃花。
long);
  set("exits", ([
    "北-樱桃园": __FILE__,
    "南-樱桃园": __FILE__,
    "西-樱桃园": __FILE__,
    "东-樱桃园": __DIR__ "ytyuan",
    //"南-" : __DIR__"huandong",
  ]));
  setup();
}
