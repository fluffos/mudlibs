#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
         set("short",GRN"湖边"NOR);
         set("long", @LONG
俗话说 : 上有天堂, 下有苏杭。这里正是大大有名的太湖。 湖面绿波
上漂着一叶叶的小舟, 一阵阵悦耳的小曲儿随着湖上的轻风不时漂入你的耳
中。
LONG
      );
       set("outdoors","mr");
       set("exits", ([
           "西-湖边" : __DIR__"hubian",
           "东-湖边" : __DIR__"hubian2",
]));
       set("coor/x",140);
  set("coor/y",-300);
   set("coor/z",0);
   setup();
}
