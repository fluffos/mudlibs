#include <room.h>

inherit ROOM;
void create()
{
	set("short", "黄河岸边5");
	set("long", @LONG
这里是黄河岸边。黄河流淌到这里，河床宽阔。黄色的河水在静静
地向东流去，使人忘记它发洪水时的狂威。
LONG );
	set("exits", ([
		"东-岱宗坊"      : "/d/taishan/daizong",
		"东北-黄河岸边6" : __DIR__"huanghe6",
		"西南-黄河岸边4" : __DIR__"huanghe4",
	]));

	set("outdoors", "黄河");
	set("coor/x",160);
  set("coor/y",110);
   set("coor/z",0);
   setup();
}

