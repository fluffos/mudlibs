#include <room.h>

inherit ROOM;

void create()
{
	set("short", "营盘水");
	set("long", @LONG
这里是当年蒙恬修长城时驻军的地方，蒙恬治军有方，当年他亲
自带人在驻地挖了好几口甜水井，使士卒们不用喝又苦又涩的咸水，
后来此地的百姓们叫这里为营盘水，称这里的井为“蒙恬井”。
LONG );
	set("exits", ([
		"西南-冰草湾" : __DIR__"bingcao",
		"东北-古长城" : __DIR__"guchangcheng",
	]));
	set("no_clean_up", 0);
	set("outdoors", "黄河");
	set("coor/x",90);
  set("coor/y",160);
   set("coor/z",0);
   setup();
}

