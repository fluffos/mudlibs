#include <room.h>

inherit ROOM;

void create() {
  set("short", "乌鞘岭");
  set("long", @LONG
乌鞘岭是武威东南的一个险要地段，黑石山上密林重重，时常有野
兽出没。一条官道从山下蜿蜒而过。
LONG);
  set("exits", ([
    "南-打柴沟": __DIR__ "dacaigou",
    "西北-武威": __DIR__ "wuwei",
  ]));

  set("outdoors", "黄河");
  set("coor/x", 70);
  set("coor/y", 110);
  set("coor/z", 0);
  setup();
}
