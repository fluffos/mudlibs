inherit ROOM;

void create() {
  set("short", "松树林");
  set("long", @LONG
这是一片松树林。几十丈高的大松树簇在一块，密实的枝叶象一蓬蓬巨伞
般伸向天空，把阳光遮得丝毫也无。尺把厚的松针积在地上，一脚踩下去，半
天拔不出来。
LONG);

  set("exits", ([
    "东-松树林": __FILE__,
    "南-空地": __DIR__ "kongdi",
    "西-松树林": __FILE__,
    "北-松树林": __DIR__ "shulin2",
  ]));

  set("outdoors", "华山");

  set("coor/x", 40);
  set("coor/y", 100);
  set("coor/z", 0);
  setup();
}
