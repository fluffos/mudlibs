#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @long
前面传来刀剑相碰的声音，快到了，你不由得加快了脚步，远远望去，
似乎是个大广场，围着不少人在练武。
long);
  set("exits", ([
    "北下-山路": __DIR__ "shanlu03",
    "南-广场": __DIR__ "guangchang",
    "西南-广场西": __DIR__ "guangchangw",
    "东南-广场东": __DIR__ "guangchange",

  ]));
  set("outdoors", "昆仑");
  setup();
}
