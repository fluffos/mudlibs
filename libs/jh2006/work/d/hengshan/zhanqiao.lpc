// zhanqiao.c
#include <room.h>
inherit ROOM;
void create() {
  set("short", "悬空栈桥");
  set("long", @LONG
栈道悬于南北危楼之间，由无数的掾铺成，每节掾宽尺许，九
节并排在一起，每根掾绑在铁索上，上铺木板，长数十丈，下临深
渊。山风呼啸，惊心动魄。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "南-悬空寺南楼": __DIR__ "xuankong2",
    "北-悬空寺北楼": __DIR__ "xuankong1",
  ]));
  set("outdoors", "恒山");
  set("no_clean_up", 0);
  set("coor/x", 50);
  set("coor/y", 110);
  set("coor/z", 30);
  setup();
}
