// 空地 kongdi.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "空地");
  set("long", @LONG
这里是一片大的空地，据说当年蝴蝶谷誓师大会便是在这里进行的，空地
右边有一条小溪，弯弯曲曲不知通往何方。
LONG
  );

  set("outdoors", "蝴蝶谷");

  set("exits", ([
    "北-牛棚": __DIR__ "niupeng",
    "东北-山路": __DIR__ "shanlu1",
    "西北-山路": __DIR__ "shanlu2",
    "西南-小径": __DIR__ "xiaojing2",
  ]));

  setup();
}
