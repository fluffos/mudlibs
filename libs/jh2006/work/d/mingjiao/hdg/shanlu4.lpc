// 山路 shanlu4.c
 
#include <ansi.h>
inherit ROOM;

void create() 
{ 
        set("short", "山路");
        set("long", @LONG
这是一条弯弯曲曲的山路，西面传来阵阵清香，你循着清香走了过去。
LONG
        );

        set("outdoors", "蝴蝶谷");

        set("exits", ([ 
            "南下-山路" : __DIR__"shanlu2",
            "西下-花圃" : __DIR__"huapu1",
        ]));

        setup();
}
