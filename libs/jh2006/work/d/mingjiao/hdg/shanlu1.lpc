#include <ansi.h>
inherit ROOM;

void create() 
{ 
        set("short", "山路");
        set("long", @LONG
这是一条弯弯曲曲的山路，不知通向何方。
LONG
        );

        set("outdoors", "蝴蝶谷");

        set("exits", ([ 
            "北上-山路" : __DIR__"shanlu3",
            "西南-空地" : __DIR__"kongdi", 
        ]));

        setup();
}
