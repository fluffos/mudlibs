// ysroad1.c 岩石路
// Modify By River@SJ 99.06
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", HIR"岩石路"NOR);
	set("long", @LONG
这是一岩石路，由此去火山尚须四十多里路。但在此已可以看到四面山上
一缕黑烟冲天而起。岩石路皆由火山灰堆成，厉时久，地面十分坚硬。 
LONG);	
	set("exits",([
		"东-石山" : __DIR__"shishan",
		"西-岩石路" : __DIR__"ysroad2",
	]));
	set("outdoors","冰火岛");
	setup();
}
