#include <room.h>
#include <ansi.h>
inherit ROOM;
void create()
{ 
       set("short", HIY"小厅"NOR);
       set("long", @LONG
这是聚义厅前的一个小厅，北面的院子是聚义厅，南边是练武场，东西两
边分别通向厨房和休息室。        
LONG);    
        set("exits", ([
                "东-休息室" : __DIR__"sleeproom",                          
                "北-聚义厅" : __DIR__"jyt",
                "西-厨房" : __DIR__"eatroom",
                "南-练武场" : __DIR__"wu1",
        ]));             
        set("objects",([
                __DIR__"npc/f-dizi" : 1,
                __DIR__"npc/m-dizi" : 1,
                CLASS_D("mingjiao") + "/zhou" : 1,
        ]));
        set("coor/x",-290);
  set("coor/y",210);
   set("coor/z",120);
   set("coor/x",-290);
 set("coor/y",210);
   set("coor/z",120);
   setup();
}
