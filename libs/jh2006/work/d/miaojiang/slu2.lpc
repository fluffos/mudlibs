inherit ROOM;

void create()
{
        set("short", "山路2");
        set("long", @LONG
这一段山路异常陡峭，两旁是茂盛的丛林。路旁有五毒教种植的花木，散发
着冲鼻的香气。
LONG
        );

        set("exits", ([
                "南下-山脚1" : __DIR__"slu1",
                "东上-山路3" : __DIR__"slu3",
                "北上-山路4" : __DIR__"slu4",
                
        ]));
     
        set("objects",([
                __DIR__"npc/dushe" : 1,

        ]));

       
        set("outdoors", "miaojiang");

        setup();
}
void init() 
{
      object ob=this_player();
      if (interactive(ob) && !ob->query_temp("marks/解毒一"))
//    ob->die(); 
      ob->apply_condition("man_poison",
      ob->query_condition("man_poison") + 80);
}