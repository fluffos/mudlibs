// /d/xiangyang/outnroad1.c

inherit ROOM;

void create() {
  set("short", "青石大道");
  set("long", @LONG
你走在一条青石大道上，人来人往非常繁忙，不时有人骑着马匆匆而过。
大道往北进入陕西、河南境内。南边通向襄阳城。
LONG
  );
  set("outdoors", "襄阳");

  set("exits", ([
    "北-青石大道": __DIR__ "outnroad2",
    "南-玄武门": __DIR__ "xuanwumen",
    "东南-青石大道": __DIR__ "outeroad1",
    "西南-青石大道": __DIR__ "outwroad1",
  ]));

  set("coor/x", 20);
  set("coor/y", 10);
  set("coor/z", 0);
  set("coor/x", 20);
  set("coor/y", 10);
  set("coor/z", 0);
  set("coor/x", 20);
  set("coor/y", 10);
  set("coor/z", 0);
  setup();
}
