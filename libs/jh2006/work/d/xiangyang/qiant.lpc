inherit ROOM;

void create()
{
        set("short","前厅");
        set("long",@LONG
这是薛府的前厅，由于修建年代久远，看起来已颇为陈旧，但因光线充足
完全没有陈年旧宅的阴晦之气。右首有一个书架，琳琅满目，全是各种医书，
一看就知道这里的主人对医学很有研究。
LONG
        );
        set("exits",([
          "南-薛府大门"  :  __DIR__"xue_men",
             "北-天井"  :  __DIR__"xue_tjing",
                ]));
        set("coor/x",-40);
  set("coor/y",50);
   set("coor/z",0);
   setup();
}
