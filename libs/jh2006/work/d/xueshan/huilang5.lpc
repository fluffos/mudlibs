void create() {
  set("short", "遮雨廊");
  set("long", @LONG
一道不算太宽的长廊，通向几座主要的大殿，廊顶和廊柱上满布壁画，描写
了历史人物事迹和佛教故事，色彩艳丽，形象逼真。
LONG
  );

  set("exits", ([
    "北-遮雨廊": __DIR__ "huilang7",
    "东上-却日殿": __DIR__ "queridian",
    "西-积善堂": __DIR__ "jishantang",
    "南-遮雨廊": __DIR__ "huilang3",
  ]));
  set("outdoors", "雪山");
  setup();
}
