// Room: shanlu7.c

inherit ROOM;

void create()
{
	set("short", "雪积古道");
	set("long", @LONG
  峰回路转。
  远望山顶，冰雕雪塑，隐约有庙舍。
  近踩积雪，深可及膝，举步为艰。
  风势尤劲，夹杂着冰雪，如刀割面。
LONG
	);

	set("exits", ([
		"东下-猴子洞" : __DIR__"houzidong",
		"西北-大轮寺山门" : __DIR__"shanmen",
                "西下-雪积古道" : __DIR__"shanlu6",
	]));
        set("outdoors", "雪山");
	set("coor/x",-270);
  set("coor/y",160);
   set("coor/z",30);
   setup();
}
