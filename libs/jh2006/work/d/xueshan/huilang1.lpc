inherit ROOM;

void create()
{
	set("short", "遮雨廊");
	set("long", @LONG
一道不算太宽的长廊，通向几座主要的大殿，廊顶和廊柱上满布壁画，描写
了历史人物事迹和佛教故事，色彩艳丽，形象逼真。
LONG
	);

	set("exits", ([
		"北-遮雨廊" : __DIR__"huilang3",
		"东-殿前广场" : __DIR__"guangchang",
                "西-钟楼" : __DIR__"zhonglou",
	]));
        set("outdoors", "雪山");
	setup();
}
