inherit ROOM;

void create() {
  set("short", "大道1");
  set("long", @LONG
这是一条由青石铺成的大道，西边通向著名的蜀都成都了，向东北走可以
去到湖北。
LONG);
  set("outdoors", "成都");

  set("exits", ([
    "西-大东门": __DIR__ "dadongmen",
    "东北-大道2": __DIR__ "eroad2",
  ]));

  set("coor/x", -90);
  set("coor/y", -30);
  set("coor/z", 0);
  setup();
}
