//普云洞
//cool@SJ,990605

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", HIY "普云洞" NOR);
  set("long",
    "原来这普云阁乃是一个小山洞，一进洞，门就无声无息的关闭了，眼前是一个天然形成的石甬道，
洞的顶上有一条狭长的石缝，光线来自那里，这条道周围分布着几个山洞，隐隐有些光从洞中透出。\n"
  );

  set("exits", ([
    "出去-龙树院": __DIR__ "lsy",
    "北-商阳": __DIR__ "shangyang",
    "北上-少商": __DIR__ "shaoshang",
    "西北-关冲": __DIR__ "guanchong",
    "东北-中冲": __DIR__ "zhongchong",
    "西南-少泽": __DIR__ "shaoze",
    "东南-少冲": __DIR__ "shaochong",
  ]));

  set("coor/x", -260);
  set("coor/y", -260);
  set("coor/z", 60);
  set("no_fight", 1);
  setup();
}
