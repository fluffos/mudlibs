inherit ROOM;
void create() {
  set("short", "南大街");
  set("long", @LONG
你走在一条繁华的街道上，向南北两头延伸。南边是南城门，北边通往
城南大街的中心地段，东面是听雨轩，西面是留园，望南面，是苏州城的南
城门。
LONG
  );
  set("outdoors", "suzhou");

  set("exits", ([
    "东-听雨轩": __DIR__ "tingyuxuan",
    "南-南门": __DIR__ "southgate",
    "西-留园": __DIR__ "liuyuan",
    "北-南大街": __DIR__ "nandajie1",
  ]));
  set("coor/x", 110);
  set("coor/y", -250);
  set("coor/z", 0);
  setup();
}
