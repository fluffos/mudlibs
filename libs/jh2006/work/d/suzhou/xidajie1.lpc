inherit ROOM;

void create()
{
	set("short", "西大街");
	set("long", @LONG
这是一条宽阔的青石板街道，向东西两头延伸。西大街是衙门所在，行
人稀少，静悄悄地很是冷清。东边是沧浪亭和宝带桥，南边是兵营。北边就
是衙门了。
LONG
	);
        set("outdoors", "city");

	set("exits", ([
              "东北-沧浪亭" : __DIR__"canglangting",
              "东南-宝带桥" : __DIR__"baodaiqiao",
	      "南-兵营大门" : __DIR__"bingyindamen",
              "西-西大街" : __DIR__"xidajie2",
	      "北-衙门大门" : __DIR__"yamen",
	]));

	set("coor/x",100);
  set("coor/y",-210);
   set("coor/z",0);
   setup();
}

