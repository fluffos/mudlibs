inherit ROOM;

void create()
{
	set("short", "西大街");
	set("long", @LONG
    你走在西大街上，感到这里的街面要比别处的干净、整洁。大概因
为靠近衙门、兵营可受保护的缘故，富人们都喜欢住在这里。东边静悄悄地
没有几个行人，西边是西城门通往郊外。南边是玄妙观，北边是一个书堂。
LONG
	);
        set("outdoors", "city");                
        set("objects",([
        __DIR__"npc/girl" : 1,
        ]));                                                
	set("exits", ([
		"东-西大街" : __DIR__"xidajie1",
		"南-玄妙观" : __DIR__"xuanmiaoguan",
		"西-西门" : __DIR__"westgate",
"北-书场" : __DIR__"shuchang",
	]));

	set("coor/x",90);
  set("coor/y",-210);
   set("coor/z",0);
   setup();
}

