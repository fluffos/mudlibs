inherit ROOM;

void create() {
  set("short", "青石大道");
  set("long", @long
你走在一条青石大道上，人来人往非常繁忙，不时地有人骑着马匆匆而过。
大道两旁有一些小货摊，似乎是一处集市。北边通向灵岩山。东面的湖边大道
通向举世著名的姑苏慕容世家。
long);
  set("outdoors", "suzhou");
  set("exits", ([
    "北-灵岩山": __DIR__ "lingyanshan",
    "东-湖边": "/d/mr/hubian",
    "南-青石大道": __DIR__ "qingshidadao1",
  ]));
  set("coor/x", 120);
  set("coor/y", -300);
  set("coor/z", 0);
  setup();
}
