  set("short", "山谷");
  set("long", @LONG
你走在一条狭窄的山谷之中，两旁山峰壁立，直插云霄。鸟鸣猿啼之声，
回荡在寂静的空谷之中。
LONG
  );

  set("exits", ([
    "东北-山谷": __DIR__ "shangu-2",
    "西南-山间平台": __DIR__ "pingtai",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "tiezhang");

  set("coor/x", -320);
  set("coor/y", -190);
  set("coor/z", 30);
  setup();
}
