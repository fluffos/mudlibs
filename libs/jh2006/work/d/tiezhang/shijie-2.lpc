inherit ROOM;

void create() {
  set("short", "石阶");
  set("long", @LONG
一排石阶盘旋而下，消失在浓浓的黑暗中。石阶上长满的绿色的青苔，滑
不留脚。远处黑暗的尽头似乎有点昏黄的光亮。
LONG
  );

  set("exits", ([
    "西上-石阶": __DIR__ "shijie-1",
    "北下-石阶": __DIR__ "shijie-3",
  ]));

  set("no_clean_up", 0);

  setup();
}
