inherit ROOM;
#include "hmy_def.lpc"

void create()
{
        set("short", "土路");
	set("long", @LONG
这是一条去黑木崖的必经之路，路上黄沙弥漫。北边不远处有不少行人在
接受日月神教教众的盘查。
LONG
        );
        set("exits", ([ 
          "东南-土路" : __DIR__"road4",
          "西北-石道" : __HMY__"shidao",
]));
        setup();
}

