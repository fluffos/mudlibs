// /d/hmy/taohua.c

inherit ROOM;

void create() {
  set("short", "桃花川");
  set("long", @LONG
走到桃花川，前面一派秀色奇石，一琢琢淡红的圆石自峰顶铺将下去，
宛若片片桃花，连成桃林一绝。
LONG
  );
  set("exits", ([
    "北上-眉毛崖": __DIR__ "meimao",
    "西上-紫石崖": __DIR__ "zisi",
    "西-紫云崖": __DIR__ "ziyun",
  ]));
  set("outdoors", "黑木崖");

  setup();
}
