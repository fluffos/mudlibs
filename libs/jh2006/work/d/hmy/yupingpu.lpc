// /d/hmy/yupingpu.c

inherit ROOM;

void create() {
  set("short", "玉屏瀑");
  set("long", @LONG
来到玉屏瀑，这里的景观真是无以比拟，一面宽宽大大晶莹如玉的瀑布
自天上泻下来，传说这是天上仙娥们在清洗天宫的玉屏风所流下地界的天池
中的圣水。
LONG
  );
  set("exits", ([
    "东-碧血崖": __DIR__ "lianhua",
    "西下-百仗泉": __DIR__ "baizhang",
    "北-观瀑亭": __DIR__ "guanpu",
  ]));
  set("objects", ([
    __DIR__ "npc/wolf": 1,
  ]));

  set("outdoors", "黑木崖");

  setup();
}
