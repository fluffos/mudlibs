// /d/hmy/ziyun.c 紫云崖

inherit ROOM;

void create()
{
        set("short", "紫云崖");
	set("long", @LONG
此处奇景又是一绝，崖岭弯曲回转，东方红日露出云层半截一映，满天
云雾霎时紫色一片，外深内淡，仿佛这崖边的云彩原本就是紫色。
LONG
        );
        set("exits", ([ 
	  "东-桃花川" : __DIR__"taohua",
	  "西-五老峰" : __DIR__"wulao",
]));
        set("outdoors", "黑木崖");
        setup();
}
 
