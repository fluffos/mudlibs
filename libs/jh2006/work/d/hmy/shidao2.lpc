inherit ROOM;

void create() {
  set("short", "石道");
  set("long", @LONG
一路上日月教教众把守严密，经过两处山道，来到一处水滩之前，西面
有一道石阶通往水滩。
LONG
  );
  set("outdoors", "黑木崖");
  set("exits", ([
    "西下-猩猩滩": __DIR__ "xingxingtang",
    "东-凉亭": __DIR__ "liangting",
    "南-石道": __DIR__ "shidao",
  ]));

  set("objects", ([
    __DIR__ "npc/wang": 1,
  ]));

  setup();
}
