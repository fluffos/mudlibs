// /d/hmy/lianhua.c

inherit ROOM;

void create() {
  set("short", "碧血崖");
  set("long", @LONG
这是碧血崖，往东可观黑木崖上秀水玉屏瀑，往西可至黑木崖总舵。
LONG
  );
  set("exits", ([
    "东下-仙人指路": __DIR__ "xianren",
    "西-玉屏瀑": __DIR__ "yupingpu",
    "东-五老峰": __DIR__ "wulao",
  ]));
  set("objects", ([
    __DIR__ "npc/bee": 1,
  ]));
  set("outdoors", "黑木崖");

  setup();
}
