inherit ROOM;
#include "midao.h"

void create() {

  set("short", "地道");
  set("long", @LONG
这是一条阴森森的地道，墙上每隔几米就挂着一盏若隐若现的油
灯，一股寒气直袭而来。
LONG
  );
  set("exits", ([
    "东-地道": __DIR__ "midao" + random(7),
    "西-地道": __DIR__ "midao" + random(7),
    "南-地道": __DIR__ "midao" + random(7),
    "北-地道": __DIR__ "midao" + random(7),
  ]));

  set("no_clean_up", 0);
  setup();
}
