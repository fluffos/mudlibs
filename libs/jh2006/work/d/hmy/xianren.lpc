{
        set("short", "仙人指路");
	set("long", @LONG
这仙人指路其实是东面仙人洞处垂下的一道石梁，远远搭上西边的莲花
崖。
LONG
        );
        set("exits", ([ 
	  "东上-仙人洞" : __DIR__"xian",
