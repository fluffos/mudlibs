// /d/hmy/changlang4.c

inherit ROOM;

void create() {
  set("short", "长廊");
  set("long", @LONG
一条长长的过道，左右两旁都是墙，每隔四五丈，墙上都点着一支明晃
晃的巨烛。
LONG
  );
  set("exits", ([
    "东-膳食房": __DIR__ "shifang",
    "南-长廊": __DIR__ "changlang6",
    "西-长廊": __DIR__ "changlang3",
    "北-休息室": __DIR__ "xiuxishi",
  ]));
  setup();

}
int valid_leave(object me, string dir) {
  if (dir == "北-" && this_player()->query("gender") == "男性")
    return notify_fail("看清楚，那是女弟子休息室！！，要睡到厢房去！\n");
  return ::valid_leave(me, dir);
}
