// /d/hmy/baichi.c 三岔口

inherit ROOM;

void create() {
  set("short", "三岔口");
  set("long", @LONG
来到三岔口，往西南和西北方向就是日月神教石阶，山道十分陡峭。
LONG
  );
  set("exits", ([
    "西上-石阶": __DIR__ "shijie",
    "东上-索道": __DIR__ "suo",
    "南-眉毛崖": __DIR__ "meimao",
    "东下-山道": __DIR__ "shandao2"
  ]));
  set("outdoors", "黑木崖");

  setup();
}
