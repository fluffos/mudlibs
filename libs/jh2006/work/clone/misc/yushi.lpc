#include <ansi.h>

inherit ITEM;

void create() {
  switch (random(8)) {
    case 0: set_name("白云石", ({ "yushi" })); break;
    case 1: set_name("猫眼石", ({ "yushi" })); break;
    case 2: set_name("鸡血石", ({ "yushi" })); break;
    case 3: set_name("蓝玉石", ({ "yushi" })); break;
    case 4: set_name("白玉石", ({ "yushi" })); break;
    case 5: set_name("紫花玉", ({ "yushi" })); break;
    case 6: set_name("黄斑玉", ({ "yushi" })); break;
    case 7: set_name("青兰玉", ({ "yushi" })); break;
  }
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 300000);
    set("unit", "块");
    set("weight", 100);
    set("long", "这是一小块玉石，好象还能值几个钱。\n");
    set("material", "stone");
  }
  setup();
}
