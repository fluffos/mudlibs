get() { return 1; }
short() { return "true"; }
init() { add_action("test_random", "test"); }
test_random(str) {
  int i, a, b, s, k, iterations, range;

  if (sscanf(str, "%d %d", iterations, range) != 2) return 0;
  a = allocate(range);
  for (i = 0; i < iterations; i++) {
    a[random(range)]++;
    b++;
  }
  for (i = 0; i < range; i++) {
    write(i + "\t" + a[i] + "\t" + (a[i] * 100 / iterations) + "%\n");
    s += a[i];
  }
  write("iterations: " + iterations + "\trange: " + range + "\tcount: " + b +
    "\tsum: " + s + "\n");
  return 1;
}

/*
 * move_object(dest): this driver's move_object() efun is 1-argument
 * (moves this_object() only) -- unlike the classic 2-argument
 * move_object(item, dest) this archive was written for. Every 2-arg
 * call site in this mudlib was mechanically rewritten to
 * `item->move_object(dest)`, which requires EVERY object that can
 * ever be the "item" to define its own move_object(dest) lfun (this
 * driver's call_other() never falls back to a same-named efun on a
 * miss -- it just silently returns 0, no error). Added mechanically
 * to every obj/ and players/ file as a precaution; not part of the
 * original archive. See AGENTS.md §7.158.
 */
int move_object(mixed dest) {
  return efun::move_object(dest);
}
