reset(started) {
  if (!started)
    set_light(1);
}

init() {
  add_action("north", "north");
  add_action("east", "east");
  add_action("southeast", "southeast");
  add_action("northwest", "northwest");
}

short() {
  return "A small grove on the shore of the Isle of the Magi";
}

long() {
  write("You are standing in a small grove on the shore of the Isle of the Magi\n" +
    "All of the trees here are either diseased, dead or heavily mutated\n" +
    "The shoreline continues southeast from here, as well as heading northwest\n" +
    "to Focus Point.\n" +
    "The grove continues to the north.\n" +
    "To the east, you can see an old disused well, and beyond that, on top\n" +
    "of the hill, stands the ruined tower of Arcanarton\n");
}

north() {
  call_other(this_player(), "move_player", "north#room/south/sislnd11");
  return 1;
}

east() {
  call_other(this_player(), "move_player", "east#room/south/sislnd17");
  return 1;
}

southeast() {
  call_other(this_player(), "move_player", "southeast#room/south/sislnd8");
  return 1;
}

northwest() {
  call_other(this_player(), "move_player", "northwest#room/south/sislnd10");
  return 1;
}

/*
 * create(): this driver's call_create() (invoked once, synchronously,
 * right when an object is first loaded/cloned) ALWAYS marks the
 * object as "already reset" and schedules its real first reset() for
 * up to "time to reset" seconds later -- regardless of whether the
 * mudlib defines create() at all. This whole archive uses the classic
 * old-MudOS reset(arg){if(arg)return;...} idiom AS ITS CONSTRUCTOR
 * (initial light/exits/NPCs/etc), which this driver's behavior
 * otherwise defers for up to 30 minutes after load -- e.g. a brand
 * new player's very first `look` finding their starting room
 * completely dark, because room/church's own reset() (which sets its
 * light) had never actually run yet. Call reset() explicitly here so
 * initialization is guaranteed synchronous on load, matching what
 * this archive's own master.c header comment describes ("reset()
 * will be called first"). Not part of the original archive -- added
 * mechanically to every file using this idiom. See AGENTS.md (new
 * entry, this session).
 */
create() {
  reset(0);
}
