reset(started) {
  if (!started)
    set_light(1);
}

init() {
  add_action("north", "north");
  add_action("south", "south");
  add_action("east", "east");
  add_action("west", "west");
  add_action("look", "look");
}

short() {
  return "A crumbling stone monument";
}

long() {
  write("You are halfway up the hill.\n" +
    "A crumbling monument stands on the side of the hill here.\n" +
    "On top of the hill, to the west, stands the ruins of the tower of\n" +
    "Arcanarton.\n" +
    "A path winds around the hill to the north, and heads down to the shore\n" +
    "of the island to the south and east\n");
}

north() {
  call_other(this_player(), "move_player", "north#room/south/sislnd14");
  return 1;
}

south() {
  call_other(this_player(), "move_player", "south#room/south/sislnd6");
  return 1;
}

east() {
  call_other(this_player(), "move_player", "east#room/south/sislnd5");
  return 1;
}

west() {
  call_other(this_player(), "move_player", "west#room/south/sislnd18");
  return 1;
}

look(str) {
  if (str != "at monument")
    return 0;
  else {
    write("The monument is very old and is crumbling.\n" +
      "Affixed to the side of the monument is a corroded old plaque which reads:\n" +
      "+-------------------------------------------------------------------------+\n" +
      "|                   BEWARE ALL YE WHO READ THIS MESSAGE                   |\n" +
      "|        Be it known, that on this day, the tower of the evil mage        |\n" +
      "|       Arcanarton was destroyed in an attack by the combined forces      |\n" +
      "|               of all of the mages of the land of Lustria.               |\n" +
      "|     The body of the mage Arcanarton was not found, and it is feared     |\n" +
      "|             that his evil work in this world is not yet over.           |\n" +
      "+-------------------------------------------------------------------------+\n");
  }
}

/*
 * create(): this driver's call_create() (invoked once, synchronously,
 * right when an object is first loaded/cloned) ALWAYS marks the
 * object as "already reset" and schedules its real first reset() for
 * up to "time to reset" seconds later -- regardless of whether the
 * mudlib defines create() at all. This whole archive uses the classic
 * old-MudOS reset(arg){if(arg)return;...} idiom AS ITS CONSTRUCTOR
 * (initial light/exits/NPCs/etc), which this driver's behavior
 * otherwise defers for up to 30 minutes after load -- e.g. a brand
 * new player's very first `look` finding their starting room
 * completely dark, because room/church's own reset() (which sets its
 * light) had never actually run yet. Call reset() explicitly here so
 * initialization is guaranteed synchronous on load, matching what
 * this archive's own master.c header comment describes ("reset()
 * will be called first"). Not part of the original archive -- added
 * mechanically to every file using this idiom. See AGENTS.md (new
 * entry, this session).
 */
create() {
  reset(0);
}
