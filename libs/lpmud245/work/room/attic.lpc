int lamp_is_lit;

reset(arg) {
  if (arg)
    return;
  set_light(1);
}

init() {
  add_action("west", "west");
  add_action("open", "open");
  add_action("push", "push");
  add_action("push", "press");
  add_action("close", "close");
}

short() {
  return "The attic";
}

long(str) {
  if (str == "door") {
    if (!call_other("room/elevator", "query_door", 0) &&
      call_other("room/elevator", "query_level", 0))
      write("The door is open.\n");
    else
      write("The door is closed.\n");
    return;
  }
  write("This is the attic above the church.\n" +
    "There is a door to the west.\n");
  if (lamp_is_lit)
    write("The lamp beside the elevator is lit.\n");

}

id(str) {
  return str == "door";
}

west() {
  if (call_other("room/elevator", "query_door", 0) ||
    call_other("room/elevator", "query_level", 0) != 3) {
    write("The door is closed.\n");
    return 1;
  }
  call_other(this_player(), "move_player", "west#room/elevator");
  return 1;
}

open(str) {
  if (str != "door")
    return 0;
  if (call_other("room/elevator", "query_level", 0) != 3) {
    write("You can't when the elevator isn't here.\n");
    return 1;
  }
  call_other("room/elevator", "open_door", "door");
  return 1;
}

close(str) {
  if (str != "door")
    return 0;
  call_other("room/elevator", "close_door", "door");
  return 1;
}

push(str) {
  if (str && str != "button")
    return 0;
  if (call_other("room/elevator", "call_elevator", 3))
    lamp_is_lit = 1;
  return 1;
}

elevator_arrives() {
  say("The lamp on the button beside the elevator goes out.\n");
  lamp_is_lit = 0;
}

prevent_look_at_inv(str) {
  return str != 0;
}

/*
 * create(): this driver's call_create() (invoked once, synchronously,
 * right when an object is first loaded/cloned) ALWAYS marks the
 * object as "already reset" and schedules its real first reset() for
 * up to "time to reset" seconds later -- regardless of whether the
 * mudlib defines create() at all. This whole archive uses the classic
 * old-MudOS reset(arg){if(arg)return;...} idiom AS ITS CONSTRUCTOR
 * (initial light/exits/NPCs/etc), which this driver's behavior
 * otherwise defers for up to 30 minutes after load -- e.g. a brand
 * new player's very first `look` finding their starting room
 * completely dark, because room/church's own reset() (which sets its
 * light) had never actually run yet. Call reset() explicitly here so
 * initialization is guaranteed synchronous on load, matching what
 * this archive's own master.c header comment describes ("reset()
 * will be called first"). Not part of the original archive -- added
 * mechanically to every file using this idiom. See AGENTS.md (new
 * entry, this session).
 */
create() {
  reset(0);
}
