int money;

reset(arg) {
  if (arg)
    return;
  money = 1;
}

query_weight() { return 0; }

short() {
  if (money == 0)
    return 0;
  return money + " gold coins";
}

/*
 * If we are picked up by a player, then move the money to his "purse",
 * and destruct this object.

 901128: Changed by JnA to not destruct object until surely picked by the
 player, i.e. object moved to the players inventory with move_object()
*/
init() {
  if (environment(this_object()) == this_player()) {
    call_other(this_player(), "add_money", money);
    money = 0;
    set_heart_beat(1);
  }
}

get() {
  return money > 0;
}

set_money(m) {
  money = m;
}

id(str) {
  if (str == "coins")
    return 1;
  if (str == "money")
    return 1;
}

heart_beat() {
  if (money == 0)
    destruct(this_object());
}

/*
 * move_object(dest): this driver's move_object() efun is 1-argument
 * (moves this_object() only) -- unlike the classic 2-argument
 * move_object(item, dest) this archive was written for. Every 2-arg
 * call site in this mudlib was mechanically rewritten to
 * `item->move_object(dest)`, which requires EVERY object that can
 * ever be the "item" to define its own move_object(dest) lfun (this
 * driver's call_other() never falls back to a same-named efun on a
 * miss -- it just silently returns 0, no error). Added mechanically
 * to every obj/ and players/ file as a precaution; not part of the
 * original archive. See AGENTS.md §7.158.
 */
int move_object(mixed dest) {
  return efun::move_object(dest);
}

/*
 * create(): this driver's call_create() (invoked once, synchronously,
 * right when an object is first loaded/cloned) ALWAYS marks the
 * object as "already reset" and schedules its real first reset() for
 * up to "time to reset" seconds later -- regardless of whether the
 * mudlib defines create() at all. This whole archive uses the classic
 * old-MudOS reset(arg){if(arg)return;...} idiom AS ITS CONSTRUCTOR
 * (initial light/exits/NPCs/etc), which this driver's behavior
 * otherwise defers for up to 30 minutes after load -- e.g. a brand
 * new player's very first `look` finding their starting room
 * completely dark, because room/church's own reset() (which sets its
 * light) had never actually run yet. Call reset() explicitly here so
 * initialization is guaranteed synchronous on load, matching what
 * this archive's own master.c header comment describes ("reset()
 * will be called first"). Not part of the original archive -- added
 * mechanically to every file using this idiom. See AGENTS.md (new
 * entry, this session).
 */
create() {
  reset(0);
}
