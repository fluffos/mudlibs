int gived;

id(str) {
  return str == "stone" || str == "black stone";
}

short() {
  return "A black stone";
}

long() {
  write("The stone is completely black, and feels warm to the touch.\n");
  write("There seems to be somthing magic with it.\n");
}

query_weight() { return 1; }

/* Prevent giving away this object */
drop() {
  gived += 1;
  if (gived == 2)
    return 1;
  else
    return 0;
}

get() { return 1; }

init() {
  add_action("list_peoples", "people");
  add_action("list_files", "ls");
  add_action("cat_file", "cat");
  add_action("drop_object", "drop");
}

list_files(path) {
  ls(path);
  return 1;
}

cat_file(path) {
  if (!path)
    return 0;
  cat(path);
  return 1;
}

list_peoples() {
  people();
  return 1;
}

drop_object(str) {
  if (str == "all") {
    drop_object("black stone");
    return 0;
  }
  if (!str || !id(str))
    return 0;
  write("The stone dissapears.\n");
  say(call_other(this_player(), "query_name") + " drops a black stone. It dissapears.\n");
  call_other(this_player(), "add_weight", -1);
  destruct(this_object());
  return 1;
}

/*
 * move_object(dest): this driver's move_object() efun is 1-argument
 * (moves this_object() only) -- unlike the classic 2-argument
 * move_object(item, dest) this archive was written for. Every 2-arg
 * call site in this mudlib was mechanically rewritten to
 * `item->move_object(dest)`, which requires EVERY object that can
 * ever be the "item" to define its own move_object(dest) lfun (this
 * driver's call_other() never falls back to a same-named efun on a
 * miss -- it just silently returns 0, no error). Added mechanically
 * to every obj/ and players/ file as a precaution; not part of the
 * original archive. See AGENTS.md §7.158.
 */
int move_object(mixed dest) {
  return efun::move_object(dest);
}
