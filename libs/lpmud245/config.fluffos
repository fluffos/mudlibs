###############################################################################
#              Customizable runtime config file for MudOS v22                 #
###############################################################################

# name of this mud
name : LPmud 2.4.5

# port number to accept users on
port number : 40262

# absolute pathname of mudlib
mudlib directory : /home/sunyc/src/mudlib/libs/lpmud245/work

# debug.log and author/domain stats are stored here
log directory : /log

# the directories which are searched by #include <...>
# /room is here because obj/living.lpc (and its subclasses) quote-includes
# "log.h", which lives in room/log.h, not next to living.lpc itself --
# a genuine cross-directory shared header in the original archive.
include directories : /include:/room

# The global include file is included automatically before every compile.
# This archive shipped no dedicated mudlib-wide header of its own (see
# include/empty.h's own comment) -- required by this driver regardless.
global include file : <empty.h>

# Directory to save binaries in.  (if BINARIES is defined)
save binaries directory : /data/binaries

# the file which defines the master object
master file : /obj/master

# the file where all global simulated efuns are defined.
simulated efun file : /obj/simul_efun

# alternate debug.log file name (assumed to be in specified 'log directory')
debug log file : debug.log

time to clean up : 1800
time to swap : 1200
time to reset : 1800

# This archive's rooms/objects universally use the classic old-MudOS
# reset(arg){if(arg)return;...} idiom AS THEIR CONSTRUCTOR (setting
# initial light, exits, NPCs, etc.) and rely on it firing promptly on
# first load/access -- without lazy resets, this driver only resets
# objects on its own periodic timer (up to "time to reset" seconds
# after load), leaving every freshly-loaded room uninitialized (dark,
# no exits) until that timer eventually fires. See AGENTS.md (new
# entry, this session).
lazy resets : 1
maximum bits in a bitfield : 1200
maximum local variables : 40
maximum evaluation cost : 5000000
maximum array size : 25000
maximum mapping size : 100000
inherit chain size : 60
maximum string length : 300000
maximum read file size : 300000
maximum byte transfer : 10000
hash table size : 7001
object table size : 1501
default fail message : What?
default error message : Something is wrong.

maximum users : 200
evaluator stack size : 1000
compiler stack size : 200
maximum call depth : 30
living hash table size : 256
