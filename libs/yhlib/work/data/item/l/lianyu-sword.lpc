#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m碧绿洞箫[2;37;0m", ({ "sword" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;31m桃花影落飞神剑[1;36m碧海潮升按玉箫[2;37;0m
剑柄上刻着一行小字：炼狱(lianyu)
");
	set("value", 2000000);
	set("point", 144);
	set("material", "stone");
	set("wield_msg", "[1;32m弹指峰头邀明月，清音洞内听竹影[2;37;0m\n");
	set("unwield_msg", "[1;32m绿竹林外聆击玉，试剑亭内奏纶音[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
