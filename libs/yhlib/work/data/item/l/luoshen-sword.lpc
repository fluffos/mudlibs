#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m炼狱[1;36m青冥[1;37m剑[2;37;0m", ({ "sword" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[37m这是一把由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m[37m为原料，吸地狱无数冤魂，取幽冥之火炼制。剑长三尺三寸，整个剑
神忽明忽暗，仿佛地狱的冤魂向你张牙舞爪，要将你喜席卷进去一样，你不禁打了一个冷战。[2;37;0m
剑柄上刻着一行小字：洛神(luoshen)
");
	set("value", 2000000);
	set("point", 136);
	set("material", "stone");
	set("wield_msg", "[1;37m只听$N一声冷哼，$n[1;37m悄然出鞘，霎时一股寒意直逼向你，透彻\n肺腑。无数的亡灵哭天抢地，飞沙走石，直向你扑过来使你不寒而栗。[2;37;0m\n");
	set("unwield_msg", "[1;37m$N撤剑还鞘，一股幽火敛进剑鞘，你不禁擦了擦头上的汗，长出一口气。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
