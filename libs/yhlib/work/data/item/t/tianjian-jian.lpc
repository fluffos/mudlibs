#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[35m血紫的裁决[2;37;0m", ({ "jian" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;31m这把剑长四尺，周身布满浅浅的血纹，蜿蜒流转到剑柄处，呈现出古怪的图案。在紫金的剑托上用雕琢了几个血色的字：
[35m尔等心如魔，血色纹修罗。[2;37;0m
剑柄上刻着一行小字：宇皇神傲(tianjian)
");
	set("value", 2000000);
	set("point", 129);
	set("material", "stone");
	set("wield_msg", "[1;31m$N手中突然呈现异样的光华，诡异的声音阵阵响起。\n[35m召唤埋藏与血脉中的远古圣器。\n[35m失落的血色之力啊，我在此企求传承。\n[35m以我的生命和最美丽的瞬间为代价。\n[1;31m一把紫色的长剑凭空出现在$N手中。[2;37;0m\n");
	set("unwield_msg", "[1;35m光华尽去，$N手中的紫色长剑，凭空消失不见，如溶入空气一般。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
