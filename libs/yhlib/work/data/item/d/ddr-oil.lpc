#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m破铜[1;36m烂铁[2;37;0m", ({ "oil" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
看，看什么看，再看就把你喝掉[2;37;0m
剑柄上刻着一行小字：联想(ddr)
");
	set("value", 2000000);
	set("point", 90);
	set("material", "stone");
	set("wield_msg", "锦绣山河[2;37;0m\n");
	set("unwield_msg", "锦绣山河[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
