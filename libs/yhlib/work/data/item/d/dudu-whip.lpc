#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[30m黑索[2;37;0m", ({ "whip" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一根鞭。
[30m这是一根漆黑的长鞭，毫不起眼，但是入手沉重，且不失柔韧，实在是千锤百炼之物。[2;37;0m
鞭柄上刻着一行小字：毒毒(dudu)
");
	set("value", 2000000);
	set("point", 139);
	set("material", "stone");
	set("wield_msg", "[30m$N一伸手，悄无声息的将黑索握在手中。[2;37;0m\n");
	set("unwield_msg", "[30m$N将手中的黑索卷起，放回腰间。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_whip(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
