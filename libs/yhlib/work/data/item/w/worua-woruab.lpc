#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("一段剑[2;37;0m", ({ "woruab" }));
	set_weight(6750);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[37m精铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：十段(worua)
");
	set("value", 800000);
	set("point", 30);
	set("material", "iron");
	set("wield_msg", "天[2;37;0m\n");
	set("unwield_msg", "下[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
