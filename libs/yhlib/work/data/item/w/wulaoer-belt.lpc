#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m妖缚[2;37;0m", ({ "belt" }));
	set_weight(960);
	set("item_make", 1);
	set("unit", "条");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一条腰带。
[1;37m由[2;37;0m「[1;32m妖缚[2;37;0m」[1;37m幻化而成的一条腰带，周身隐约散发着淡淡的光芒。[2;37;0m
腰带缘上刻着一行小字：乌老二(wulaoer)
");
	set("value", 2000000);
	set("point", 100);
	set("material", "stone");
	set("wear_msg", "[1;37m$N从背后抽出第五把剑，暗喝一声[2;37;0m「[1;32m海[2;37;0m」[1;37m，剑身立刻光化成一条腰带。[2;37;0m\n");
	set("remove_msg", "[1;32m海是万物之起源。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
