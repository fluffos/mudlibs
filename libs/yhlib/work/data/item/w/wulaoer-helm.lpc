#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;35m修罗[2;37;0m", ({ "helm" }));
	set_weight(2550);
	set("item_make", 1);
	set("unit", "顶");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一顶头盔。
[1;37m由[2;37;0m「[1;35m修罗[2;37;0m」[1;37m幻化而成的一顶头盔，周身隐约散发着淡淡的光芒。[2;37;0m
头盔缘上刻着一行小字：乌老二(wulaoer)
");
	set("value", 2000000);
	set("point", 150);
	set("material", "stone");
	set("wear_msg", "[1;37m$N从背后抽出第一把剑，暗喝一声[2;37;0m「[1;35m日[2;37;0m」[1;37m，剑身立刻光化成一顶头盔。[2;37;0m\n");
	set("remove_msg", "[1;35m日是不灭的光辉。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
