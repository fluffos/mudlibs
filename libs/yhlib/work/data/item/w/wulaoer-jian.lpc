#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;31m恨天[1;36m十二剑[2;37;0m", ({ "jian" }));
	set_weight(10000);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[2;37;0m[36m天山玄铁[2;37;0m炼制而成的一柄剑。
[1;37m剑长三尺七寸，剑脊上似乎刻有密密麻麻的小字，你凝神一看，却什么也看不清。[2;37;0m
剑柄上刻着一行小字：乌老二(wulaoer)
");
	set("value", 3000000);
	set("point", 370);
	set("material", "stone");
	set("wield_msg", "[1;37m一恨人才无行，二恨红颜薄命，三恨江浪不息。\n四恨世态炎凉，五恨月台易漏，六恨兰叶多焦。[2;37;0m\n");
	set("unwield_msg", "[1;37m七恨河豚甚毒，八恨架花生刺，九恨夏夜有蚊。\n十恨薛萝藏虺，十一恨未尝败过，十二恨天下无敌。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
