#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;36m惊天指[2;37;0m", ({ "jingtian" }));
	set_weight(3500);
	set("item_make", 1);
	set("unit", "套");
	set("long", "这是由[1;37m寰宇天晶[2;37;0m炼制而成的一套指套。
[1;36m一块纯白色水晶指套，晶莹剔透，无暇的表面射出耀眼的光泽。其中仿佛蕴藏着千千万万的生命，生命流动不息，散发出宇宙的力量。这便是传说中的至宝——惊天指，相传只有在天宫中才会出现。[2;37;0m
指套缘上刻着一行小字：苗逸(kong)
");
	set("value", 4200000);
	set("point", 474);
	set("material", "tian jing");
	set("wear_msg", "[1;36m$N伸指一弹惊天指，一声“叮”的轻响。天地为之震撼。[2;37;0m\n");
	set("remove_msg", "[1;36m$N悠悠一声长叹，轻轻拭去惊天指上的血迹，随手套在手上。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", 10);
	set("armor_prop/finger", 10);
	set("armor_prop/unarmed_damage", apply_damage());
	set("armor_prop/claw", 10);

	setup();
}

string long() { return query("long") + item_long(); }
