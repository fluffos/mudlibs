#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m幻甲[2;37;0m", ({ "jia" }));
	set_weight(2400);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一件战衣。
[35m这是天地四宝之一，集天地灵气之精华孕育而成。[2;37;0m
战衣缘上刻着一行小字：月影岚(gaowei)
");
	set("value", 2000000);
	set("point", 126);
	set("material", "stone");
	set("wear_msg", "[1;33m$N忽然被一阵狂风卷起，当狂风散去的时候，他身上多了一个如梦似幻的长衫。[2;37;0m\n");
	set("remove_msg", "[37m一时光芒大盛，亮光散去$N身上的长衫已经消失不见了。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
