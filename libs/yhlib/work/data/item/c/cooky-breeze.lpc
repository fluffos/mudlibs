#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;32m筱岚[2;37;0m", ({ "breeze" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;32m暗淡轻黄体性柔。情疏迹远只香留。何须浅碧深红色，自是花中第一流。[2;37;0m
剑柄上刻着一行小字：甜饼(cooky)
");
	set("value", 2000000);
	set("point", 144);
	set("material", "stone");
	set("wield_msg", "[1;32m永夜恹恹欢意少。空梦长安，认取长安道。为报今年春色好。花光月影宜相照。[2;37;0m\n");
	set("unwield_msg", "[1;32m随意杯盘虽草草。酒美梅酸，恰称人怀抱。醉莫插花花莫笑。可怜春似人将老。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
