#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;33m迷幻经纶[2;37;0m", ({ "dreamhat" }));
	set_weight(2550);
	set("item_make", 1);
	set("unit", "顶");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一顶头盔。
[1;33m一顶金黄色的帽子，似乎具有某种魔力。[2;37;0m
头盔缘上刻着一行小字：谢晓峰(china)
");
	set("value", 2000000);
	set("point", 67);
	set("material", "stone");
	set("wear_msg", "[1;33m$N缓缓带上迷幻经纶。\n霎时你觉得$N宛如皇帝一般，顿时双膝发软，忍不住倒头便拜，口中大呼：“吾皇万岁，万万岁！”\n[2;37;0m\n");
	set("remove_msg", "[1;33m$N缓缓摘下迷幻经纶。\n“啊呀”一声，你瘫倒在地，喃喃自语道：“我梦见皇上啦！”\n[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
