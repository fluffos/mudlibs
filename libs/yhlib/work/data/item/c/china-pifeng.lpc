#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;35m魔蝎披风[2;37;0m", ({ "pifeng" }));
	set_weight(2400);
	set("item_make", 1);
	set("unit", "件");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一件战衣。
[1;35m这是一件帅呆了、酷毙了的披风！披风上有一只张牙舞爪的毒蝎，据传天蝎座的人穿上它会有意想不到的效果。[2;37;0m
战衣缘上刻着一行小字：谢晓峰(china)
");
	set("value", 2000000);
	set("point", 133);
	set("material", "stone");
	set("wear_msg", "[1;35m在这一瞬间，$N觉得自己简直跟神一样。[2;37;0m\n");
	set("remove_msg", "[1;35m看着魔蝎披风，你垂涎三尺，手也蠢蠢欲动。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	set("armor_prop/armor", apply_armor());

	setup();
}

string long() { return query("long") + item_long(); }
