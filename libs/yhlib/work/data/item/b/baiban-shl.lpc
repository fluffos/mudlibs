#include <ansi.h>
#include <weapon.h>

inherit WHIP;
inherit F_ITEMMAKE;

void create()
{
	set_name("[1;37m逝水流[2;37;0m", ({ "shl" }));
	set_weight(1800);
	set("item_make", 1);
	set("unit", "根");
	set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一根鞭。
[1;31m红红红红红
[1;34m红的就象老四的屁股[1;36m
真的？
不信你再瞧瞧？
[1;33m信了吧，真是的[2;37;0m
鞭柄上刻着一行小字：白板(baiban)
");
	set("value", 2000000);
	set("point", 111);
	set("material", "stone");
	set("wield_msg", "$N拿出二百零二两黄金给花满地[2;37;0m\n");
	set("unwield_msg", "[1;37m$N缓缓的从水池抽出了炼好的鞭看了看，满意地说，很好，很好。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_whip(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
