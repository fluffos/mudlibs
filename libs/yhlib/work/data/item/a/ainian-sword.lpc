#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create()
{
	set_name("[2;37;0m[32m长剑[2;37;0m", ({ "sword" }));
	set_weight(5100);
	set("item_make", 1);
	set("unit", "柄");
	set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[32m这是一柄普通的精钢剑，一般的剑客都配带此剑。[2;37;0m
剑柄上刻着一行小字：鱼任翱(ainian)
");
	set("value", 2000000);
	set("point", 126);
	set("material", "stone");
	set("wield_msg", "[32m$N「唰」的一声抽出一柄长剑握在手中。[2;37;0m\n");
	set("unwield_msg", "[32m$N将手中的长剑插回剑鞘。[2;37;0m\n");
	if (! check_clone()) return;
	restore();
	init_sword(apply_damage());

	setup();
}

string long() { return query("long") + item_long(); }
