#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";


create()
{
 initialize_exit_map();
 add_exit("u/Casimir/castle/creation_center/creation_center.lpc", "west");
 add_exit("u/Casimir/castle/garden/garden2.lpc", "northeast");
 set_long("u/Casimir/castle/garden/garden3_desc");
 set_short("A Magnificent garden nearing Creation's Center");
}


