/*
 * bedchamber.c
 * Casimir's living quarters
 */

#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";

create()
{
initialize_exit_map();
add_exit("u/Casimir/castle/hallway/hallway2.lpc", "north");
add_exit("u/Casimir/castle/antechamber1/antechamber1.lpc", "east");
set_long("u/Casimir/castle/bedchamber/bedchamber_desc");
set_short("The Lord Casimir's Bedchambers");
}


