#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";

create()
{
	initialize_exit_map();
	add_exit("u/Casimir/castle/springs/springs.lpc","west");
	add_exit("u/Casimir/castle/jungle/jungle1.lpc","northeast");
	add_exit("u/Casimir/castle/jungle/jungle2.lpc","east");
	add_exit("u/Casimir/castle/jungle/jungle3.lpc","southeast");
	set_long("u/Casimir/castle/gate/gate_desc");
	set_short("Outside a long-forgotten gate");
}

