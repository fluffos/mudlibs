#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";

create()
{
	initialize_exit_map();
	add_exit("u/Casimir/castle/gate/gate.lpc","northwest");
	add_exit("u/Casimir/castle/jungle/jungle2.lpc","north");
	add_exit("u/Casimir/castle/jungle/jungle6.lpc","northeast");
	add_exit("u/Casimir/castle/jungle/jungle7.lpc","east");
	set_short("At the edge of the jungle.");
	set_long("u/Casimir/castle/jungle/jungle3_desc");

}

