#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";

create()
{
	initialize_exit_map();
	add_exit("u/Casimir/castle/gate/gate.lpc","west");
	add_exit("u/Casimir/castle/jungle/jungle1.lpc","north");
	add_exit("u/Casimir/castle/jungle/jungle5.lpc","northeast");
	add_exit("u/Casimir/castle/jungle/jungle6.lpc","east");
	add_exit("u/Casimir/castle/jungle/jungle7.lpc","southeast");
	add_exit("u/Casimir/castle/jungle/jungle3.lpc","south");
	set_short("A poorly beaten path through the jungle");
	set_long("u/Casimir/castle/jungle/jungle2_desc");
}

