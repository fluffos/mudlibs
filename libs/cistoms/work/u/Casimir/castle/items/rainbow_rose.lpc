/*
 *  A rainbow colored rose
 */

#include <global.h>

inherit "inherit/std/item/item.lpc";

create()
{
 set_name("rose");
 set_generic_name("rose");
 set_room_desc("A rainbow colored rose grows here, planted" +
		" by Casimir himself.");
