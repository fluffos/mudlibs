/*
 * purse.c
 *
 * The ultimate carrying device
 * */

inherit "inherit/std/item/item.lpc";
inherit "inherit/std/item/container.lpc";

create()
{
	set_name("purse");
	set_generic_name("purse");
	set_room_desc("An uninteresting purse is here.");
	set_can_get_or_put(1);
	set_capacity(5);
	set_lockable(1);
}
