#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";


create()
{
 initialize_exit_map();
 add_exit("u/Casimir/castle/garden/garden1.lpc","northwest");
 add_exit("u/Casimir/castle/antechamber2/antechamber2.lpc", "west");
 add_exit("u/Casimir/castle/garden/garden2.lpc","south");
 add_exit("u/Casimir/castle/gate/gate.lpc","east");
 set_long("u/Casimir/castle/springs/spring_desc");
 set_short("An indoor spring at a crossroads");
}


