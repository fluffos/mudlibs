#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";

create()
{
initialize_exit_map();
add_exit("u/Casimir/castle/meeting_room/meeting_room.lpc","north");
add_exit("u/Casimir/castle/garden/garden3.lpc", "east");
add_exit("u/Rahvin/hills/hill89.lpc","into the blue pool");
add_exit("u/Casimir/mForest/Marelian12.lpc","into the orange pool");
set_long("u/Casimir/castle/creation_center/creation_center_desc");
set_short("Beside creation's center.");
}


