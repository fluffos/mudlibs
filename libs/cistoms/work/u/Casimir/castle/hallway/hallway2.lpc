#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";

create()
{
initialize_exit_map();
add_exit("u/Casimir/castle/bedchamber/bedchamber.lpc", "south");
add_exit("u/Casimir/castle/hallway/hallway1.lpc", "northeast");
set_long("u/Casimir/castle/hallway/hallway2_desc");
set_short("A dimly lit hallway, near a bedchamber");
}

