#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";

create()
{
initialize_exit_map();
add_exit("u/Casimir/castle/workroom/workroom.lpc", "east");
add_exit("u/Casimir/castle/hallway/hallway2.lpc", "southwest");
set_long("u/Casimir/castle/hallway/hallway1_desc");
set_short("A dimly lit hallway, near a workroom");
}


