/*
 *
 *	Casimir's Workroom
 *	The Very Basic in Persistant Environments
 *
 */

#include <global.h>

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";


void pierce_veil();
void write_in_call_out(string arg);


create()
{
initialize_exit_map();
set_long("u/Casimir/castle/workroom/workroom_desc");
set_short("A Cluttered Workroom Belonging to Casimir.");
add_exit("u/Casimir/castle/balcony/balcony.lpc", "north");
add_exit("u/Casimir/castle/meeting_room/meeting_room.lpc", "south");
add_exit("u/Casimir/castle/hallway/hallway1.lpc", "west");
add_exit("u/Casimir/castle/garden/garden1.lpc","east");
add_exit("u/Casimir/castle/engine/engine.lpc", "down");
}

update()
{
reload_object(this_object());
}

init()
{

}



void
pierce_veil()
{

}

void
write_in_call_out(string arg)
{
tell_object(previous_object(), arg);
}
