/*
 *	meeting_room.c
 */

inherit "inherit/std/room/room.lpc";
inherit "inherit/std/room/exits.lpc";

create()
{
 initialize_exit_map();
 add_exit("u/Casimir/castle/workroom/workroom.lpc", "north");
 add_exit("u/Casimir/castle/creation_center/creation_center.lpc","south");
 add_exit("u/Casimir/castle/antechamber1/antechamber1.lpc","west");
 add_exit("u/Casimir/castle/antechamber2/antechamber2.lpc","east");
 set_short("An opulent meeting room");
 set_long("u/Casimir/castle/meeting_room/meeting_room_desc");
}

