#include <logon.h>

//prototypes
public void logon(object);
public void logon_handler(string, int, object);

//function definitions
void
create()
{

}

void
logon(object user_ob)
{
	write(LOGON_NAME_PROMPT);
	input_to("logon_handler", 2, LOGON_GET_NAME, user_ob);
}

void
logon_handler(string user_entry,  int operation, object user_ob)
{
	string *passkey;
	
	switch(operation)
	{
		case LOGON_GET_NAME:
		 if(!user_entry || user_entry == ""){
			write(LOGON_NAME_EMPTY);
			write(LOGON_NAME_PROMPT);
			input_to("logon_handler", 2, LOGON_GET_NAME, user_ob);
		 } else {
			/*Implement user existence and password checking*/
    		 	user_ob->set_living_name(user_entry);
    			user_ob->setnamelist(user_entry);
    			write("\nHello, " + user_entry + ".\n");
			user_ob->set_visible_name(user_entry);
	    		user_ob->setup();
			//tell_room(VOID_OB, (string)user_ob->query_name() + 
			//"enters this reality\n");
			write("\nYour EUID is "+geteuid(this_object()) +".\n" );
			user_ob->move(VOID_OB);
			destruct(this_object());
		}
	}
}
