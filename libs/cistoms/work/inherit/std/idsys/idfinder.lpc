private object *hashtable;
public object parsehashtable(string args);
public object parsehashtableroom(string args);
public object parsehashtableplayer(string args);
public object parsehashtablespecific(string args, object search_obj);

object
parsehashtable(string args)
{
	hashtable = objects();
	for(int i = 0; i < sizeof(hashtable); i++){
		if(hashtable[i]->checkid(args) > 0){
			return hashtable[i];
		}
	}
	for(int j = 0; j < sizeof(hashtable);j++){
		if(hashtable[j]->checkgenericname(args) != 0){
			return hashtable[j];
		}
	}

}

object
parsehashtableroom(string args)
{
	hashtable = all_inventory(environment(this_player()));
	for(int i = 0; i < sizeof(hashtable); i++){
		if(hashtable[i]->checkid(args) > 0){
			return hashtable[i];
		}
	}
	for(int j = 0; j < sizeof(hashtable); j++){
		if(hashtable[j]->checkgenericname(args) != 0){
			return hashtable[j];
		} 
	}

}

object
parsehashtableplayer(string args)
{
	hashtable = all_inventory(this_player());
	for(int i = 0; i < sizeof(hashtable); i++){
		if(hashtable[i]->checkid(args) > 0){
			return hashtable[i];
		}
	}
	for(int j = 0; j < sizeof(hashtable); j++){
		if(hashtable[j]->checkgenericname(args) != 0){
			return hashtable[j];
		}
	}
	
}

object
parsehashtablespecific(string args, object search_obj)
{
	hashtable = all_inventory(search_obj);
		for(int i = 0; i < sizeof(hashtable); i++){
			if(hashtable[i]->checkid(args) > 0){
				return hashtable[i];
			}
		}
		for(int j = 0; j < sizeof(hashtable); j++){
			if(hashtable[j]->checkgenericname(args) != 0){
				return hashtable[j];
			}
		}
}
	
