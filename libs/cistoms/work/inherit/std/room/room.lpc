/**************************************************************************
 *
 * 	room.c
 *	a very important inheritable
 *	that will control long and short descriptions in the future
 *	
 *	Coded by Tyler Vann-Campbell
 **************************************************************************/

#include <global.h>

/*Local Variables*/
string long_desc;
string short_desc;

/*Methods*/
void set_long(string file);
void set_short(string desc);
void all_living_names();
void non_living_desc();
void do_look();
void brief_look();
string get_short();

void
set_long(string file)
{
long_desc = file;
}

void
set_short(string desc)
{
short_desc = desc;
}

void
all_living_names()
{
object current_room;
object *room_inventory;
int i;
int max_people;

current_room = environment(this_player());
room_inventory = all_inventory(current_room);
max_people = sizeof(room_inventory);

tell_object(this_player(), "\n");

 for(i = 0; i < max_people; i++) {
		if(living(room_inventory[i]) == 1 
		&& room_inventory[i] != this_player() ) {
			tell_object(this_player(), 
			(string)room_inventory[i]->query_name() + " is here. ");
		}
	}
}

void
non_living_names()
{
object current_room;
object *room_inventory;
string final_desc = "";
int i;
int max_items;

current_room = environment(this_player());
room_inventory = all_inventory(current_room);
max_items = sizeof(room_inventory);

if(max_items > 1){
for(i = 0; i < max_items; i++) {
		if(room_inventory[i] != this_player()) {
			final_desc = final_desc +
			(string)room_inventory[i]->get_room_desc() + " ";
		}
	}
tell_object(this_player(),final_desc);
}
}
void
do_look()
{
cat(long_desc);
}

void
brief_look()
{
write(short_desc + "\n");
}

string
get_short()
{
	return short_desc;
}
