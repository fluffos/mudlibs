/* **************************************************
 *	exits.c
 *	CISTOMS exit handler
 *	Handles the addition and removal of exits
 * 	as well as the object move calls
 *
 * 	Coded by Tyler Vann-Campbell
 ******************************************************/

#include <global.h>

mapping all_exits;
void initialize_exit_map();
int exit_parse(string arg);
void add_exit(string destination, string description);
void query_str_exit();

/*
 * Initialize memory space for exit mapping
 * very important to call this in all room instances before
 * assigning exits
 *
 */
initialize_exit_map()
{
all_exits = ([]);
}

/*
 * Exits are parsed by searching for the hash of the exit string
 * for example, the index of "west" hashes to the room to that direction
 *
 * This idea is at the core of the exit system.
 */
int
exit_parse(string arg)
{
string move_dest;
if(undefinedp(all_exits[arg]) == 1)  {
   return 0;
	} else {
   move_dest = all_exits[arg];
   this_player()->move(move_dest);
   return 1;
	}
}

void 
add_exit(string destination, string description)
{
all_exits[description] = destination;
}

void
query_str_exit()
{
string *arr_exit;
int i;
int max_values;

arr_exit = keys(all_exits);
max_values = sizeof(arr_exit);
tell_object(this_player(), "There are paths leading in the " +
			"following directions:");

for(i = 0; i < max_values ; i++) {

if(max_values>1){
	if(max_values != 2) {	
		if (i == 0) {
			write((string)arr_exit[i]);
  		} else {
			if(i != (max_values - 1)) {
				  write(", " + (string)arr_exit[i]);
	  		} else {
		  		write(", and " + (string)arr_exit[i] + "\n");
  			}
	}
	} else { 
		if(i != (max_values - 1)){
			write((string)arr_exit[i] + " and ");
		} else {
			write((string)arr_exit[i]+ "\n");
		}
	}
} else {
	write((string)arr_exit[i] + "\n");
}
}
 
}
