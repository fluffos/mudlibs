/*
 * health object, handles health and death states
 * 
 * Coded by: Tyler Vann-Campbell
 **/

private int health = 0;
private int dead;
public void damage(int dam); //this can be overloaded for healing
public void set_health(int neo_health);
public void set_living_or_dead(int status);
public int get_health();
public int get_living_or_dead();

void
damage(int dam)
{
	if((health - dam) > 0){
			health -= dam;
	} else {
		set_health(0);
		tell_object(this_object(),"You are dead, perhaps you should" +
				       " rectify this situation with an" +
				      " indulgence.");
	}			
	return;
}

void
set_health(int neo_health)
{
	if(neo_health>=0){
		health = neo_health;
	} else {
		health = 0;
	}
}


int
get_health()
{
	return health;
}


	
