/*
 * character object inheritable
 * controls non-user aspects such as skill, stats and gender
 * */
#include <genders.h>


private int age;
private int endurance;
private int sleep;
private int speed;
private int nutrition;
private int strength;
private int gender = MALE;
private string prefix;
private string suffix;
private string description;
void set_age(int new_age);
void set_endurance(int new_endurance);
void set_sleep(int new_sleep);
void set_speed(int new_speed);
void set_nutrition(int new_nutrition);
void set_strength(int new_strength);
int set_gender(int new_gender);
void set_prefix(string new_prefix);
void set_suffix(string new_suffix);
int get_age();
int get_endurance();
int get_sleep();
int get_speed();
int get_nutrition();
int get_strength;
string query_nominative();
string query_accusative();
string query_genitive();
string get_prefix();
string get_suffix();
string get_description();

void
set_age(int new_age)
{
	if(!new_age||new_age<0){
		age = 0;
	} else {
		age = new_age;
	}
}

void
set_endurance(int new_endurance)
{
	if(!new_endurance||new_endurance<0){
		endurance = 0;
	} else {
		endurance = new_endurance;
	}
}

void
set_sleep(int new_sleep)
{
	if(!new_sleep||new_sleep<0){
		sleep = 0;
	} else {
		sleep = new_sleep;
	}
}

void
set_speed(int new_speed)
{
	if(!new_speed || new_speed < 0){
		speed = 0;
	} else {
		speed = new_speed;
	}
}
void
set_nutrition(int new_nutrition)
{
	if(!new_nutrition || new_nutrition < 0){
		nutrition = 0;
	} else {
		nutrition = new_nutrition;
	}
}
void
set_strength(int new_strength){
	if(!new_strength || new_strength<0){
		strength = 0;
	} else {
		strength = new_strength;
	}
}


int
set_gender(int new_gender)
{
	if(new_gender == FEMALE || new_gender == MALE){
		gender = new_gender;
		return 1;
	} else {
		gender = FEMALE;
		return 0;
	}
}
void
set_prefix(string new_prefix)
{
	if(!new_prefix || strlen(new_prefix)>30){
		prefix = "";
	} else {
		prefix = new_prefix;
	}
}
void
set_suffix(string new_suffix)
{
	if(!new_suffix || strlen(new_suffix)>30){
		suffix = "";
	} else {
		suffix = new_suffix;
	}
}
void
set_description(string new_description)
{
	if(!new_description || strlen(new_description)>2048){
		description = "";
	} else {
		description = new_description;
	}
}
int
get_age()
{
	return age;
}

int
get_endurance()
{
	return endurance;
}

int
get_sleep()
{
	return sleep;
}

int
get_speed()
{
	return speed;
}

int
get_nutrition()
{
	return nutrition;
}

int
get_strength()
{
	return strength;
}

string
query_nominative()
{
	switch(gender) {
		case FEMALE:
			return "she";
			break;
		case MALE:
			return "he";
			break;
		default:
			return "it";
			break;
	}
}
	
string
query_accusative()
{
	switch (gender) {
		case FEMALE:
			return "her";
			break;
		case MALE:
			return "him";
			break;
		default:
			return "it";
			break;
	}
}

string
query_genitive()
{
	switch (gender) {
		case FEMALE:
			return "her";
			break;
		case MALE:
			return "his";
			break;
		default:
			return "its";
			break;
	}
}

