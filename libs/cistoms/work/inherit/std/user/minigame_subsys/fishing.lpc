#include <global.h>
#include <minigame_subsys/fishing.h>

/*method functions*/
public void fish_set_overall_status(int new_status);
public void fish_set_fishing_state(int new_state);
public void fish_set_bait_state(int new_state);
public void fish_set_fish_type(int new_type);
public int fish_get_overall_status();
public int fish_get_fishing_state();
public int fish_get_bait_type();
public int fish_get_fish_type();
public int fish_commandHook(string cmd_verb, string direct_object);


/*defined fishing variables*/

private int overall_status;
private int fishing_state;
private int bait_state;
private int fish_type;

/*fishing system variables*/
private int line_length;
private int line_out;
private int fish_weight;

public void fish_set_overall_status(int new_status)
{
	if(new_status == FISHING_FALSE || new_status == FISHING_TRUE){
		overall_status = new_status;
	} else {
		overall_status = 0;
	}
}

public int fish_get_overall_status()
{
	if(overall_status == FISHING_FALSE || overall_status==FISHING_TRUE){
		return overall_status;
	} else {
		return 0;
	}
}

public void fish_set_fishing_state(int new_state)
{	
	if(new_state >= 0 && new_state <= 8){
		fishing_state = new_state;
	} else { 
		fishing_state = STATE_LINE_EMPTY;
	}
}



public int fish_commandHook(string cmd_verb, string direct_object)
{
	string verb_string;
	object cobj;
	
	verb_string = COMMAND_PREFIX + "fishing/" + cmd_verb;
	if(member_array(cmd_verb,get_dir(COMMAND_PREFIX+"fishing/")) > -1) {
		cobj = load_object(verb_string);
			if(cobj != 0) {
				return (int)cobj->main(direct_object);
			} else {
				notify_fail("You are fishing. "
				+"To exit the fishing system type "
				+"'retract'.");
				return 0;
			}
		} else {
	notify_fail("You are fishing. To exit the fishing system type "
			+ "'retract'.");
	return 0;
		}
}
