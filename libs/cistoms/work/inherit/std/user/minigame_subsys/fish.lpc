#include <global.h>
#include <minigame_subsys/fishing.h>

inherit "inherit/std/item/item.lpc";

/*fish description array*/
private string *fish_desc = ({"a juicy rainbow trout", "a fresh salmon",
				"a plump red snapper", "a strong thin pike",
				"a large mouthed bass", "a plain carp"});


public void  create_new_fish(int fish_type)
{
	set_can_get_or_put(1);
	set_name(fish_desc[fish_type]);
	set_weight(random(5) * fish_type);

}	

