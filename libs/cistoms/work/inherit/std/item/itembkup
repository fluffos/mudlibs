#include <global.h>

inherit "/inherit/base.c";

string item_name;
string room_description;
string close_desc;
int weight;
int visibility; //0 visibility is invisible
int get_perm;
void set_name(string new_name);
void set_room_desc(string new_desc);
void set_weight(int new_weight);
void set_vis(int new_vis);
void set_initial_environment(object env);
void set_can_get_or_put(int perm);
void set_close_desc(string filename);
void do_look();
string get_name();
string get_room_desc();
int get_can_get_or_put();
int get_weight();
int get_vis();


void
set_name(string new_name)
{
	int daycode;
	int objid;
	int randid;
	daycode = (time() / 100000);
	objid = (time() % 100000);
	write("Daycode: " + daycode + "\n");
	write("Time: " + objid + "\n");
	objid += daycode;
	write("Sum: " +objid+"\n");
	randid = (random(50) + 25);
	write("Random seed: "+randid+"\n");
	objid = ((objid * randid));
	write(objid + "\n");
	if(objid<0){objid = objid * -1;}
	write(""+objid+"\n");
	objid = objid / 100;
	write(""+objid+"\n");
	setnamelist(new_name + (string)objid);
	item_name = new_name;
}

void
set_room_desc(string new_desc)
{
	room_description = new_desc;
}

void
set_weight(int new_weight)
{
	if(new_weight >= 0){
		weight = new_weight;
	} else {
		weight = 0;
	}
}

void
set_vis(int new_vis)
{
	if(new_vis >= 0){
		visibility = new_vis;
	} else {
		visibility = 0;
	}
}

void
set_initial_environment(object env)
{
	move(env);
}

void
set_can_get_or_put(int perm)
{
	if(perm >= 1){
		perm = 1;
		get_perm = perm;
	} else {
		get_perm = 0;
	}
}

void
set_close_desc(string filename)
{
	if(!filename){return;
	} else {
		close_desc = filename;
	}
}

void
do_look()
{
	if(!close_desc){
		tell_object(this_player(),"There is nothing notable to observe there.");
	} else {
	cat(close_desc);
	}
	
}

string
get_name()
{
return item_name;
}

string
get_room_desc()
{
return room_description;
}

int
can_get_or_put()
{
	if(get_perm == 1 || get_perm == 0){
		return get_perm;
	} else {
		return 0;
	}
	
}

int
get_weight()
{
return weight;
}

int
get_vis()
{
return visibility;
}


