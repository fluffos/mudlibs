/*
 *  item.c
 *
 *  handles basic item functions:
 *  
 *  visibility, weight, description, and name   
 *  
 *  Coded by Tyler Vann-Campbell
 */

#include <global.h>
#include <item.h>

inherit "/inherit/base.lpc";

string interactive_name;
string item_name;
string room_description;
string close_desc;
string genericname;
private int wield_status = UNWIELDED;
/*
 * An object of the item class has a lot more detail than the system uses
 * Items can have weight or visibility, which can affect how well they
 * can be picked up and carried, and how soon they appear in dynamically
 * lit rooms.
 */
int weight;
int visibility; //0 visibility is invisible
int get_perm;
void set_interactive_name(string new_interactive_name);
void set_name(string new_name);
void set_room_desc(string new_desc);
void set_weight(int new_weight);
void set_vis(int new_vis);
void set_initial_environment(object env);
void set_can_get_or_put(int perm);
void set_close_desc(string filename);
void set_generic_name(string new_generic);
void do_look();
void wield();
void unwield();
string query_name();
string get_name();
string get_room_desc();
string get_generic_name();
int get_can_get_or_put();
int get_weight();
int get_vis();
int get_wield_status();

void
set_interactive_name(string new_interactive_name)
{
	if(!new_interactive_name){
		interactive_name = "something";
	} else {
		interactive_name = new_interactive_name;
	}
}

void
set_name(string new_name)
{
	int daycode;
	int objid;
	int randid;
	objid = getoid(this_object());
	objid += 100;
	setnamelist(new_name + (string)objid);
	item_name = new_name;
}

void
set_room_desc(string new_desc)
{
	room_description = new_desc;
}

void
set_weight(int new_weight)
{
	if(new_weight >= 0){
		weight = new_weight;
	} else {
		weight = 0;
	}
}

void
set_vis(int new_vis)
{
	if(new_vis >= 0){
		visibility = new_vis;
	} else {
		visibility = 0;
	}
}

void
set_initial_environment(object env)
{
	move(env);
}

void
set_can_get_or_put(int perm)
{
	if(perm >= 1){
		perm = 1;
		get_perm = perm;
	} else {
		get_perm = 0;
	}
}

void
set_close_desc(string filename)
{
	if(!filename){return;
	} else {
		close_desc = filename;
	}
}

void
set_generic_name(string new_generic)
{
	if(!new_generic){return;
	} else {
		genericname = new_generic;
		setgenericname(new_generic);
	}
}
		

void
do_look()
{
	if(!close_desc){
		tell_object(this_player(),"There is nothing notable to observe there.\n");
	} else {
	cat(close_desc);
	}
	
}

void
wield()
{
	if(wield_status == UNWIELDED){
		tell_object(this_player(),
		"You begin to wield " +
		genericname + ".\n");

		message("standard",
		this_player()->query_name() +
		" begins to wield " +
		genericname + ".\n",
		all_inventory(environment(this_player())),
		this_player());

		wield_status = WIELDED;
	} else {
		message("standard",
		"You are already wielding this.",
		this_player() );
	} return;
}

void
unwield()
{
	if(wield_status == WIELDED){
		tell_object(this_player(),
		"You stop wielding " +
		genericname + ".\n");

		message("standard",
		this_player()->query_name() +
		" stops wielding " +
		genericname + ".\n",
		all_inventory(environment(this_player())),
	       	this_player() );

		wield_status = UNWIELDED;
	} else {
		tell_object(this_player(),
		"You are not wielding this.\n");
	} return;
}
	

string
query_name()
{
	return interactive_name;
}


string
get_name()
{
return item_name;
}

string
get_room_desc()
{
return room_description;
}
string
get_generic_name()
{
return genericname;
}

int
can_get_or_put()
{
	if(get_perm == 1 || get_perm == 0){
		return get_perm;
	} else {
		return 0;
	}
	
}

int
get_weight()
{
return weight;
}

int
get_vis()
{
return visibility;
}

int
get_wield_status()
{
return wield_status;
}
