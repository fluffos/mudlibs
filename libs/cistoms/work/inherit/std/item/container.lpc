/*
 * container.c
 *
 * Handles Code for Containers of all sizes
 * Coded by Tyler Vann-Campbell
 * */

#include <global.h>

/*The basic properties of a container*/
private int capacity;
private int contents;
/*Locking isn't fully implemented yet*/
private int lockable = 0;
private int locked = 0;
/*
 * A neat project would be unique keys that corresponded to specific
 * containers. Also we could use passwords or other lock techniques
 */

public void set_capacity(int cap_arg);
public int add_item_contents(object added_item);
public int remove_item_contents(object removed_item);
public void set_lockable(int lock_arg);
public void lock_container();
public void unlock_container();
public void print_contents();

public int get_locked_state();
public int get_lockable();
public int get_capacity();
public int get_contents();

public void
set_capacity(int cap_arg)
{
	if(!cap_arg){
		return;
	} else {
		capacity = cap_arg;
	}
}

public int
add_item_contents(object added_item)
{
	object container;
	container = this_object();
	if(!added_item||undefinedp(added_item)==1){
		notify_fail("Put what in where?\n");
		return 0;
	} else {
		if(capacity - contents > 0&& /*Are we full?*/
		environment(added_item)==this_player()&& /*Are we around*/
		locked != 1)/*Are we locked?*/{
			added_item->move(container);
			contents++;
			write("Okay");
			return 1;
	} else {
		notify_fail("Container full or locked.");
		return 0;
}
}
}
public int
remove_item_contents(object removed_item)
{
	object container;
	container = this_object();
		if(locked != 1){
			removed_item->move(this_player());
			write("Removing...\n");
			contents--;
			return 1;
		}
}

public void
set_lockable(int lock_arg)
{
	if(!lock_arg){
		return;
	} else {
		if(lock_arg != 0){
			lockable = 1;
		} else {
			lockable = 0;
		}
	}
}

public void
lock_container()
{
	if(lockable == 1){
		locked = 1;
	} else {
		locked = 0;
	}
}

public void
unlock_container()
{
	locked = 0;
}

public void
print_contents()
{
	object *list;
	int i;
	list = all_inventory(this_object());
	write("The container holds the following items: (" + contents
			+ "/" + capacity + ")\n");
	for (i =0; i<sizeof(list); i++) {
		printf("%-25s %-50s\n",
				list[i]->listids(),
				list[i]->get_room_desc());
	}
}
				
public int
get_locked_state()
{
	if(!locked){
		return 0;
	} else {
		return locked;
	}
}

public int
get_lockable()
{
	if(!lockable){
		return 0;
	} else {
		return lockable;
	}
}

public int
get_capacity()
{
	if(!capacity){
		return 0;
	} else {
		return capacity;
	}
}

public int
get_contents()
{
	if(!contents){
		return 0;
	} else {
		return contents;
	}
}
