// set to 'private nosave' so that inheritor won't be able to directly
// access this variable and so that save_object() won't save it to the .o file

private nosave string *ids;
string *eyednames;
string genericname;
int checkid(string args);
int checkgenericname(string args);
int saveme(string path);
void setnamelist(string args);
void setgenericname(string args);
void listids();

void
remove()
{
	// add code here to prevent unwanted destructions.
	// update attributes of the container and the containees.
	destruct(this_object());
}

int
move(mixed dest)
{
	object current_room;

	// add code here to prevent disallowed moves (target is full, object
	// is immovable, etc.).  Also update attributes of source and target
	// objects.  Note: /inherit/master/valid.c:valid_override() is currently
	// set up to restrict calls to move_object() to this file only.

	move_object(dest);
	current_room = environment(this_player());
	if(undefinedp(current_room) == 0) {
		current_room->brief_look();
		current_room->non_living_names();
 		current_room->query_str_exit();
	} else {
	tell_object(this_player(), "You appear to exist outside of reality.");
	}
}
int
saveme(string path)
{
	return save_object(path);
}

void
set_ids(string *arg)
{
	// probably want to add some security here.
	ids = arg;
}

int
id(string arg)
{
	if (!arg || !ids) {
		return 0;
	}
	return (member_array(arg, ids) != -1);
}

int
checkid(string args)
{
	if(!args || !eyednames) {
		return 0;
	} else {
		return (member_array(args, eyednames) != -1);
	}

}

int
checkgenericname(string args)
{
	if(!args || !genericname) {
		return 0;
	} else {
		if(args != genericname){
			return 0;
		} else {
			return 1;
		}
	}
}

void
setnamelist(string args)
{
write("Assigning IDs...\n");
write(args+"\n");
eyednames  = ({args});
 
}

string
listids()
{
for(int i = 0; i < sizeof(eyednames); i++){
	return eyednames[i];
	}
}

void
setgenericname(string args)
{
	if(!args){
		return;
	} else {
	write("Setting Generic Name...\n");
	write(args+"\n");
	genericname = args;
	}
}

