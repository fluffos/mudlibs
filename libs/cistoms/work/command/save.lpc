/*
 * save.c
 *
 * This file is only for testing the save routines and will not be used during
 * actual gameplay.  This is very important as in a persistant environment, no
 * one should ever have to type save in order for the system to remember where
 * they last were. 
 * 
 * Coded by: Tyler Vann-Campbell
 */

#include <command.h>
#include <global.h>

inherit "inherit/std/idsys/idfinder.lpc";
int main(string args);
int me(string args);


int
main(string args)
{
return me(args);
}

int
me(string args)
{
	string path;
	path = "/data/Casimir/saves/anything";
	this_player()->saveme(path);
	return 1;
}


