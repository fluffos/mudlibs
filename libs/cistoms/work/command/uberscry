/*
 * uberscry.c
 *
 * Finds a user and returns their location by descriptiton and filename
 * as well as the name and OIN with which they were cloned on login.
 *
 * Coded by Tyler Vann-Campbell
 * */
#include <global.h>
#include <command.h>

inherit "inherit/std/idsys/idfinder.c";

object fingered_player;

int
main(string arg)
{
	fingered_player = parsehashtable(arg);
	tell_object(this_player(), 
			(string)fingered_player->query_name() + "\t");
	tell_object(this_player(),
			file_name(fingered_player) + "\n");
	tell_object(this_player(),
			environment(fingered_player)->get_short() + "\n");
	tell_object(this_player(),
			file_name(environment(fingered_player)) + "\n");
	return 1;
}

