#include <global.h>



int
main(string file)
{
	
	object obj;
	string updater;
	
	// need to call resolve_path() and query_cwd()
	if (!file) {
		return notify_fail("update what?\n");
	}
	if (obj = find_object(file)) {
		destruct(obj);

	tell_object(previous_object(),"You have updated " + file + "\n");
	
	}
	call_other(file, "update");
	return 1;
}
