/*
 * drop.c
 * moves an item from the player's inventory to the current room
 * 
 * Coded by Tyler Vann-Campbell
 * */

#include <global.h>
#include <command.h>
#include <item.h>

inherit "inherit/std/idsys/idfinder.lpc";

int
main(string args)
{
	object fingered_item;
	fingered_item = parsehashtableplayer(args);
	if(fingered_item == 0){
		notify_fail("You do not have one of those.\n");
		return 0;
	} else {
	if(fingered_item->can_get_or_put()==1&&
	environment(fingered_item)==this_player()){
		if(fingered_item->get_wield_status() == WIELDED){
			notify_fail("You need to unwield that first.\n");
			return 0;
		} else {
			fingered_item->move(environment(this_player()));
			tell_object(this_player(),
				"Okay.");
			return 1;
		}
	} else {
		notify_fail("Drop what?");
		return 0;
	
	}
	}
}

