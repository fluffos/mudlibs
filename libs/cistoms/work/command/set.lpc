#include <command.h>

inherit "inherit/std/idsys/idfinder.lpc";
	
int
main(string args)
{
	object obj_fingered_player;
	string str_fingered_player;
	string var;
	int val;
	if(sscanf(args, "%s %s %d", str_fingered_player, var, val)==3){
		obj_fingered_player=parsehashtable(str_fingered_player);
		if(obj_fingered_player == 0){
			notify_fail("Can't find player\n");
			return 0;
		} else {
			switch(var){
				case "age":
					obj_fingered_player->set_age(val);
					return 1;
					break;
				case "endurance":
					obj_fingered_player->set_endurance(val);
					return 1;
					break;
				case "sleep" :
					obj_fingered_player->set_sleep(val);
					return 1;
					break;
				case "speed" :
					obj_fingered_player->set_speed(val);
					return 1;
					break;
				case "nutrition" :
					obj_fingered_player->set_nutrition(val);
					return 1;
					break;
				case "strength" :
					obj_fingered_player->set_strength(val);
					return 1;
					break;
				default :
					notify_fail("No such numeric value.\n");
					break;
			}
		}
	} else {
		notify_fail("Syntax: SET <player> <variable> <number>\n");
		return 0;
	}
}
