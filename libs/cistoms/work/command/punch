/*
 * punch.c
 * a simple test attack, not intended for use in actual combat
 * */

#include <command.h>

inherit "inherit/std/idsys/idfinder.c";

int
main(string args)
{
	object target;
	if(!args){
		notify_fail("Syntax: PUNCH <target>\n");
		return 0;
	} else {
		target = parsehashtable(args);
		if(target == 0){
			notify_fail("Punch what?\n");
			return 0;
		} else {
			if(present(target) != 1 || target == this_player()){
				notify_fail("Can't find that here.\n");
				return 0;
			} else {
				if(member_array("inherit/std/user/health.c",
						deep_inherit_list(target)) == -1){
					message("standard",this_player()->query_name() +" punches in vain at an inanimate"+
							" object.",
						all_inventory(environment(this_player())),this_player());
					tell_object(this_player(),"Your attack will not do any good against that.\n");
					return 1;
				} else {
					mixed exclude = allocate(2);
				        exclude[0] = target;
					exclude[1] = this_player();
				
					message("combat",
					this_player()->query_name() +" reaches toward you and strikes you with a "+
					"solid punch in the chest.", target);
					
					message("standard",
					this_player()->query_name() +" reaches out and punches someone.",
					all_inventory(environment(this_player())),
					exclude);
					target->damage(20);

					return 1;
					}
			}
		}
	}
}
						
