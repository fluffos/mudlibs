/*
 *
 *	parents.c
 *	lists the deep inheritable list of any object
 *
 *
 *	Coded by Tyler Vann-Campbell
 */

#include <global.h>
inherit "inherit/std/idsys/idfinder.lpc";

object obj_parentsearch;
string *inheritlist;

int main(string arg)
{
	if(!arg){
		notify_fail("Syntax: PARENTS <objectname> | <filename>\n");
		return 0;
	} else {
		obj_parentsearch = parsehashtableplayer(arg);
		if(obj_parentsearch == 0){
			obj_parentsearch = parsehashtableroom(arg);
			if(obj_parentsearch == 0){
				obj_parentsearch = parsehashtable(arg);
			}
			if(obj_parentsearch != 0){
				inheritlist = deep_inherit_list(
						obj_parentsearch);
				for(int i=0; i<sizeof(inheritlist);i++){
					printf("**%50s\n",inheritlist[i]);
				}				
			return 1;
			} else {
				notify_fail("Can't find that.\n");
				return 0;
			}
		}
	}
}
