/*
 *	ipwho.c
 *	prints the user name and ip host number/name of every user
 *	connected
 * 	resembles who closely but utilizes the query_ip_name() efun.
 *
 * 	Coded by Tyler Vann-Campbell
 */
#include <command.h>

int
main(string arg)
{
object *list;
int j;

for (list = users(), j = 0; j < sizeof(list); j++) {
	printf("%-50s %-25s\n", (string)list[j]->query_name() ,
	query_ip_name(list[j])
	);
	}
	return 1;
}
