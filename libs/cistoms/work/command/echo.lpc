/*
 * 
 * 	Command Name: echo
 *	File Name: echo.c
 *	Function: sends an emphasized message to everyone in the world
 *	
 *	Coded by: Casimir
 *
 */

#include <global.h>
#include <command.h>

inherit BASE;

int 
main(string arg)
{
 tell_object(this_player(),
"You impart to the world to say the following words: \" " + arg + " \" and it obeys.");
 message("standard", "\n ***" + arg + "*** \n", users(), this_player());
 return 1;
}



