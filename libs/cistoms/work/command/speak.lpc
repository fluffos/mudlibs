/*
 *	speak.c
 *	changes the language one speaks, voila!
 *	careful that only the calling user is changed
 *	
 *	Coded by Tyler Vann-Campbell
 */

#include <global.h>
#include <command.h>
#include <languages.h>

int
main(string arg)
{
switch (arg) {
	case "oom" : this_player()->set_language(OOM_SPEAK);
		break;
	case "common" : this_player()->set_language(COMMON_SPEAK);
		break;
	case "eek" : this_player()->set_language(EEK_SPEAK);
		break;
	case "iegh" : this_player()->set_language(IEGH_SPEAK);
		break;
	default : write("\nSpeak what?\n");
	}
//	write(previous_object()->query_language());
return 1;
}
