/*
 *
 *	goto.c
 *	Enables divine teleportation
 *	Coded exclusively for Casimirage by Tyler Vann-Campbell
 *	
 */

#include <global.h>

mixed dest;
int main(string arg);
object load_room(string arg);
int find_room(string arg);
int goto_player(string arg);

int
main(string arg)
{
object dest;
object current_room;
dest = load_room(arg);
current_room = environment(this_player());
message("standard", this_player()->query_name() + " glows blindingly " +
			"and then vanishes, teleporting instantaneously.",
			all_inventory(current_room),
			this_player()
			);
this_player()->move(dest);
message("standard", this_player()->query_name() + " appears in a brilliant " +
			"nimbus of light, teleporting by divine means.",
			all_inventory(dest),
			this_player()
			);
return 1;
}

object 
load_room(string arg)
{
dest = load_object(arg);
write("You attempt to load " + arg + " into the realm of existence.\n");
if (dest == 0) {
	dest = find_object(arg);
	}
return dest; 
}


