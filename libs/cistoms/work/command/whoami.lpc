/*
 *  Whoami... the test of who you are
 *
 *  Just in case you forget
 *
 */

#include <command.h>

main()
{
 write("\nYou are known as ");
 write(this_player()->query_name() + " \n" );
 tell_object(this_player(),
		 "Cloned from the following file: " +
		 file_name(this_player()) +
		 "\n");
 tell_object(this_player(),
		 "Called by the following ids: " + "\n");
 this_player()->listids();
 tell_object(this_player(),
		 "In the enviroment of file: " + "\n");
 tell_object(this_player(),
		 file_name(environment(this_player())));
 
 return 1;
}
