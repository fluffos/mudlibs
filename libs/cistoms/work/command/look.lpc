/*
 *	look.c
 *	describes current environment using do_look method
 *	needs the ability to examine objects eventually
 *
 *	Coded by Tyler Vann-Campbell
 */

#include <global.h>
inherit "inherit/std/idsys/idfinder.lpc";

int look_in(string args);
int look_at(string args);
int room_look();

int main(string arg)
{
 
 if(!arg){
	 return room_look();
 } else {
 	if(strsrch(arg, "in ") > -1){
		return look_in(arg);
 	} else if(strsrch(arg, "at ") > -1){
		return look_at(arg);
	} else {
		notify_fail("Please rephrase that.\n");
		return 0;
	}
 }
	 
}

int
look_in(string args)
{
	object obj_container;
	string preposition;
	string str_container;
	if(sscanf(args, "%s %s" , preposition, str_container)!=2 || (preposition != "in")){
		notify_fail("Syntax: LOOK [IN <container>] | [AT <item>]\n");
		return 0;
	} else {
		obj_container = parsehashtableplayer(str_container);
		if(obj_container == 0){
			obj_container = parsehashtableroom(str_container);
		}
		if(obj_container != 0){
			if(member_array("inherit/std/item/container.lpc", 
			deep_inherit_list(obj_container)) < 0){
				notify_fail("That item is not a container.\n");
				return 0;
			} else {
				obj_container->print_contents();
				return 1;
			}
		} else {
			notify_fail("Can't find that.\n");
			return 0;
		}
			
	}
}

int
look_at(string args)
{
	object obj_item;
	string str_preposition;
	string str_item;
	if(sscanf(args, "%s %s", str_preposition, str_item)!=2 || (str_preposition != "at")){
		notify_fail("Syntax: LOOK [AT <item>] | [IN <container>]\n");
		return 0;
	} else {
		obj_item = parsehashtable(str_item);
		if(obj_item == 0){
			notify_fail("Can't find that.\n");
			return 0;
		} else {
			if(environment(obj_item) != this_player()&&
			environment(obj_item) != environment(this_player())){
				notify_fail("That is beyond your vision.\n");
				return 0;
			} else {
				obj_item->do_look();
				return 1;
			}
		}
	}
}



int
room_look()
{
 object current_room;
 
 current_room = environment(this_player());
 if(undefinedp(current_room) == 0)  {
    
    current_room->brief_look();
    current_room->do_look();
    current_room->non_living_names();

    current_room->query_str_exit(); 

 } else {
    tell_object(this_player(), "You appear to exist outside of reality.\n");
 }
 return 1;
}

