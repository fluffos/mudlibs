/*
 * put.c
 * puts things in container
 * */

#include <command.h>
inherit "inherit/std/idsys/idfinder.lpc";
int
main(string args)
{
	object obj_item;
	object obj_container;
	string item;
	string preposition;
	string container;
	if(strsrch(args, " in ") == -1){
	notify_fail("Syntax: PUT <item> IN <container>\n");
	return 0;	
	} else {
	if(sscanf(args, "%s %s %s" , item, preposition, container) != 3){
		notify_fail("Syntax: PUT <item> IN <container>\n");
		return 0;
	} else {
		if(preposition != "in"){
			notify_fail("Syntax: PUT <item> IN <container>\n");
			return 0;
		} else {
			//try to find the object
			obj_item = parsehashtableplayer(item);
			obj_container = parsehashtableroom(container);
			if(obj_container == 0){
				obj_container = parsehashtableplayer(container);
				if(obj_container == 0){
					notify_fail("Can't find " + container + ".\n");
					return 0;
				}
			}
			//make sure it's a valid object
			if(undefinedp(obj_item) != 1 && 
					undefinedp(obj_container) != 1){
			//check to see if container is a child of container
			if(member_array("inherit/std/item/container.lpc",
					inherit_list(obj_container))>-1){
			//check to see if container is in the inventory of
			//this player, likewise with item, then let
			//the method do the rest
			
			return obj_container->add_item_contents(obj_item);
			}
			} else {
				notify_fail("Can't find that.\n");
				return 0;
			}
		}
			
	}
	}
}

