/*
 *	clone.c
 *
 *	admin command to create a new instance of a mudlib object and
 *	move it to the current room
 *
 * 	Coded by Tyler Vann-Campbell
 */

#include <global.h>
#include <command.h>

object new_obj;
object created_dest;

int
main(string arg)
{
	new_obj = new(arg);
	created_dest = environment(this_player());
	new_obj->setup();
	new_obj->set_initial_environment(created_dest);	
	return 1;
}

	
