#include <global.h>
#include <command.h>
#include <languages.h>

main(string arg)
{
	arg = capitalize(arg);
	if(this_player()->query_language() == OOM_SPEAK)	{
	 string speech_mod;
	 speech_mod = replace_string(arg, "k" , "k'");
	 speech_mod = replace_string(speech_mod, "b", "boom");
	 speech_mod = replace_string(speech_mod, "d", "doom");
	 speech_mod = replace_string(speech_mod, "e ", "ay ");
	 speech_mod = replace_string(speech_mod, "m", "moom");
	 speech_mod = replace_string(speech_mod, "ee", "ai");
	 speech_mod = replace_string(speech_mod, "e", "-e-");
	 speech_mod = replace_string(speech_mod, "h", "hoom");
	 speech_mod = replace_string(speech_mod, "l", "loom");
	 speech_mod = replace_string(speech_mod, "n", "noom");
	 write("You say, \"" + speech_mod + "\"\n");
	 message("speech", (string)this_player()->query_name()
		+ " says, \"" + speech_mod + ".\"\n",
		all_inventory(environment(this_player())),
		this_player()
		);

	}
	if(this_player()->query_language() == IEGH_SPEAK) {
	 string speech_mod;
	 speech_mod = replace_string(arg, "a", "ah");
	 speech_mod = replace_string(speech_mod, "e", "eh");
	 speech_mod = replace_string(speech_mod, "i", "ieh");
	 speech_mod = replace_string(speech_mod, "o", "oh");
	 speech_mod = replace_string(speech_mod, "u", "ouh");
	 speech_mod = replace_string(speech_mod, "ll", "l");
	 speech_mod = replace_string(speech_mod, "mm", "m");
	 speech_mod = replace_string(speech_mod, "nn", "n");
	 speech_mod = replace_string(speech_mod, "rr", "r");
	 speech_mod = replace_string(speech_mod, "ss", "s");
	 speech_mod = replace_string(speech_mod, "tt", "t");
	 speech_mod = replace_string(speech_mod, "f", "fiegh ");
	 speech_mod = replace_string(speech_mod, "g", "gheh ");
	 speech_mod = replace_string(speech_mod, "h", "hweh ");
	 speech_mod = replace_string(speech_mod, "j", "jweih ");
	 speech_mod = replace_string(speech_mod, "r", "riegh ");
	 speech_mod = replace_string(speech_mod, "f", "fjeh ");
	 speech_mod = replace_string(speech_mod, "z", "shjii ");
	 speech_mod = replace_string(speech_mod, "b", "p");
	 speech_mod = replace_string(speech_mod, "c", "j");
	 speech_mod = replace_string(speech_mod, "d", "g");
	 speech_mod = replace_string(speech_mod, "k", "j'");
	 speech_mod = replace_string(speech_mod, "l", "rl'");
	 speech_mod = replace_string(speech_mod, "p", "gh");
	 speech_mod = replace_string(speech_mod, "s", "sh");
	 speech_mod = replace_string(speech_mod, "t", "g'");
	 speech_mod = replace_string(speech_mod, "v", "mn");
	 speech_mod = replace_string(speech_mod, "w", "hw");
	 speech_mod = replace_string(speech_mod, "y", "yi'");
	 write("You say, \"" + speech_mod + "\"\n");
	 message("speech", (string)this_player()->query_name()
		+ " says, \"" + speech_mod + ".\"\n", 
		all_inventory(environment(this_player())),
		this_player()
		);
	 }

	if(this_player()->query_language() == COMMON_SPEAK)	{
	tell_object(this_player(), "You say, \"" + arg + "\"\n");
	message( "speech", (string)this_player()->query_name()
		+ " says, \"" +  arg + ".\"\n", 
		all_inventory(environment(this_player())),
		this_player()
		);
	}
	return 1;
}
