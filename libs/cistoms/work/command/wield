#include <global.h>

inherit "/inherit/std/idsys/idfinder.c";

int object_wield(string args);

int
main(string args)
{
	if(!args){
		notify_fail("Wield what?");
		return 0;
	} else {
		return object_wield(args);
	}
}

int
object_wield(string args)
{
	object wieldee;
	wieldee = parsehashtableplayer(args);
	if(wieldee == 0){
		notify_fail("You are not holding a " + args + ".\n");
		return 0;
	} else {
		wieldee->wield();
		return 1;
	}
}
