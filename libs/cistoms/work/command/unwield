/*
 * unwield.c
 *
 * Unwields an object in the current inventory
 * Like wielding, it is up to the object to make sure that it is in the
 * correct status before it wields or unwields itself. Wield is simply a flag
 * in the object inheritable. For actions that require an item to be wielded,
 * checking for a wield flag in the inventory should be a trivial matter.
 *
 * TODO: Check and modify max wielding modifiers
 * Also, this might take a time-sensitive balance in the future.
 * 
 * Coded by Tyler Vann-Campbell
 * 5/11/2005
 */

#include <global.h>

inherit "/inherit/std/idsys/idfinder.c";

int object_unwield(string args);

int
main(string args)
{
	if(!args){
		notify_fail("Unwield what?");
		return 0;
	} else {
		return object_unwield(args);
	}
}

int
object_unwield(string args)
{
	object unwieldee;
	unwieldee = parsehashtable(args);
	if(unwieldee == 0){
		notify_fail("You are neither holding nor wielding a " +
				args + ".\n");
		return 0;
	} else {
		unwieldee->unwield();
		return 1;
	}
}

