/*
 * info.c
 * prints information about the object ids in the current environment
 * or current players inventory
 *
 * Coded by Tyler Vann-Campbell
 * */

int main(string args)
{
	object *list;
	int i;
	if(args == "inv"){
		list = all_inventory(this_player());
	} else {
		list = all_inventory(environment(this_player()));
	}
	for (i = 0;i < sizeof(list); i++) {
		printf("%-25s %-50s\n", 
				list[i]->listids(),
				list[i]->get_room_desc());
				}
	return 1;
}

