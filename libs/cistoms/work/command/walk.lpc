/*
 * 	walk.c
 *	handles movement call actions independent of the room object
 *	this is to avoid complicating things with the language parser
 *	and also to avoid getting errors on the commandHook function...
 *
 *	Coded by Tyler Vann-Campbell
 */

#include <global.h>

int 
main(string arg)
{
object current_room;
int success;
current_room = environment(this_player());
if(undefinedp(current_room) == 1) {
   tell_object(this_player(), "You appear to exist outside reality.");
  } else {
   success = current_room->exit_parse(arg);
   if(success == 1)  {
     message("standard", this_player()->query_name() + " strides away " +
			"heading " + arg + ".", 
			all_inventory(current_room),
			this_player()
			);
    
     message("standard", this_player()->query_name() +
     		" strides into view and earshot.",
		all_inventory(environment(this_player())),
		this_player()
		);
     return 1;
   } else {
     tell_object(this_player(), "No such path seems to exist.\n");
     return 1;
   }

  }

}

