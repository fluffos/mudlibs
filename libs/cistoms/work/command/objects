#include <global.h>
#include <command.h>

int
main(string arg)
{
	int i;
	object* all_list;
	all_list = objects();
	for(i=0;i<sizeof(all_list);i++){
		printf("%-=60s%-=20s\n",
		(string)file_name(all_list[i]),
		(string)environment(all_list[i]) );
	}
	return 1;
}

