/*
 * summon.c
 *
 * useful for moving unruly players to your location, or helping players
 * that need a hand finding a place. overall, a very useful admin command
 * 
 * Coded by: Tyler Vann-Campbell
 * */

#include <global.h>
#include <command.h>

inherit "/inherit/std/idsys/idfinder.lpc";

int
main(string args)
{
	object summonned_player;
	object summonning_location;
	
	if(!args){
		notify_fail("Syntax: SUMMON <player>");
		return 0;
	} else {
		summonned_player = parsehashtable(args);
		if(summonned_player == 0){
			notify_fail("Can't summon that person.");
			return 0;
		} else {
			message("standard",
			"Reality blurs as you are stripped from " +
			"your current location by divine will.\n",
			summonned_player);
			
			message("standard",
			summonned_player->query_name() + 
			" is ripped forcefully from your location"+
			" by divine summons.\n",
			all_inventory(environment(summonned_player)),
			summonned_player);
			
			message("standard",
			this_player()->query_name() +
			" reaches out with omnipotent power and"+
			" summons " + summonned_player->query_name() +
			"\nacross time and space.",
			livings(),
	({all_inventory(environment(summonned_player)),this_player(),
	 summonned_player})
			);

			summonning_location=environment(this_player());
			summonned_player->move(summonning_location);
			return 1;
			}
	}
}
