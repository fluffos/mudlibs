/*
 * get.c
 * moves an item into the inventory of the player from the environment or
 * from a container in the player's inventory
 *
 * Coded by Tyler Vann-Campbell
 * */

#include <global.h>

inherit "inherit/std/idsys/idfinder.lpc";

object fingered_item;

int environment_get(string args);
int container_get(string args);
int
main(string args)
{
	if(!args){
		notify_fail("Get what?\n");
		return 0;
	} else {
		if(strsrch(args, " from ") != -1){
			return container_get(args);
		} else {
			return environment_get(args);
		}
	}
}

int
environment_get(string args)
{
	fingered_item = parsehashtableroom(args);
	if (fingered_item != 0){
	if(fingered_item->can_get_or_put() == 1
		&& present(fingered_item)){
		fingered_item->move(this_player());
		tell_object(this_player(), "Okay.\n");
		return 1;
	}
	} else {
		notify_fail("Can't find that.\n");
		return 0;
	}
}

int
container_get(string args)
{
	string str_item;
	string str_preposition;
	string str_container;
	string str_junk;
	object obj_item;
	object obj_container;
	
	if(sscanf(args, "%s %s %s", 
	str_item, str_preposition, str_container) != 3 || 
	str_preposition != "from"){
		notify_fail("Syntax: GET <item> [FROM <container>]\n");
		return 0;
	} else {
		
		obj_container = parsehashtableroom(str_container);
		if(obj_container == 0){
			obj_container = parsehashtableplayer(str_container);
			if(obj_container == 0){
				notify_fail("Get " + str_item + " from what?\n");
				return 0;
			} 
		}
		obj_item = parsehashtablespecific(str_item, obj_container);
		if(obj_item == 0){
			notify_fail("Can't find that.\n");
			return 0;
		} else {
			if(environment(obj_item) != obj_container){
				notify_fail("Can't get that.");
				return 0;
			} else {
		if(environment(obj_container) != this_player()&&
		environment(obj_container) != environment(this_player())){
			notify_fail("Can't get that here.");
			return 0;
		} else {
			obj_container->remove_item_contents(obj_item);
			return 1;
		}
			}
		}
	}
}

