/*
 *  Global user object
 *  Defined and Coded by Casimir
 */

#include <global.h>

int health;
int beatype;
string name;
void commandHook(string arg);
void damage(string infstr);


void
init()
{
	add_action("commandHook", "say", 1);
	add_action("damage", "damage", 1);
}
void 
create()
{
	seteuid(0);
	health = 1000;
}


void
setup()
{
	set_heart_beat(1);
	enable_commands();
	init();
}

void
heart_beat()
{
beatype = random(11);

switch (beatype) { 
	case 1:	 break;
	case 2:  write("Your eyes grow watery and you blink.\n"); break;
	case 3:  write("You sniffle.\n"); break;
	case 4:  write("\nYou sneeze uncontrollably!\n");
	case 5:  break;
	case 6:  break;
	case 7:  write("\nYou squint as you think you can see a bird in the distance...\n"); break;
	case 8:  break;
	case 9:  break;
	case 10: write("\n Your heart pounds in your chest.\n");
	default: break; }
write(health + "h\n");
 
}

void
commandHook(string arg)
{
tell_object(this_player(1),  "You say, '" + arg + "'\n");
write("You hear the world echo back, '" + arg +"'\n");
return;
}

void
damage(string infstr)
{
int dam;
string target;
sscanf(infstr, "%s %d", target, dam); 
write("\n You inflict " + dam + " on " + target + ".\n");
}

