#include <global.h>


// needs fixed to handle passwords


void auth(string priname);
void chkpasswd(string passwd);
void make_user();
object user;
string name;
string passwd;

void
logon()
{
	


	write("***Casimirage Custom Multiuser Environment v.1 (c) Picklesnooper Programs***");
	cat("/etc/motd");
	write("This mudlib is currently being hacked at by the immortal, Casimir\n");
	write("This is only a test.");
	write("\n\n <Enter the name by which you are known in this world>\n ");
	input_to("auth", 0);
 	

}
void
auth(string priname)
{
	name = priname;
	write("<Not that it matters, but enter a password, " + name + ">\n>");
	input_to("chkpasswd", 1);
		
return;

}

void
chkpasswd(string passwd)
{
	if(name == "Casimir") {
		if(passwd == "sisra") {
			make_user();
		} else {
		write("\n\n<You are no such deity, try again!>\n\n");
		write("<What name do you go by, really?>\n\n");
		input_to("auth", 0);
		}
	} else {
	write("\n Normally, we'd check that password, but we're \n" +
		"feeling especially nice today. No Passwords!\n");
	make_user();
	}

}

void
make_user()
{
    (string)seteuid(getuid(this_object()));
    user = new("/clone/user.lpc");
    user->set_living_name(name + getoid(user));
    	write("\nI hereby declare that your name will be " + name +
	" from now on.\n***");
	user->set_visible_name(name);
	exec(user, this_object());
    user->setup();
	if((string)user->query_name() == "Casimir") {
		shout("\nAll creation grows quiet as the vast essence\n" +
			"of Casimir expands and fills every corner of\n" +
			"Ol'en, even to the deepest reaches of your soul.\n" +
			"You are left with a deep sensation of peace and\n" +
			"you pause to savor it before continuing, feeling\n" +
			"lighter and more at ease.\n");
	} else {
	tell_room(VOID_OB, (string)user->query_name() + " enters this reality\n"	);
user->move(VOID_OB);
destruct(this_object());	
}
}
