#include <global.h>
inherit "inherit/master/security.lpc";

void
logon()
{
	object user;

	write("***Casimirage CISTOMS Server v.0.5.1 (c) 2002 Picklesnooper Programs***\n");
	cat("/etc/motd");
	write("This is only a test(BETA).\n");
	seteuid(getuid(this_object()));
	user = new("/clone/user");
	if (!user) {
		write("Unable to create a user object.\n");
		destruct(this_object());
		return;
	}
	exec(user, this_object());
	user->start_login();
	destruct(this_object());
}
