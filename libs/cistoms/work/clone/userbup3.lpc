/*
 *  Global user object
 *  Defined and Coded by Casimir
 */

#include <global.h>


void
init()
{
	add_action("commandHook", "", 1);
}
void 
create()
{
	seteuid(0);
	write("Hooray if this works.");
	init();
}
void
setup()
{
	set_heart_beat(1);
	enable_commands();

}

void
heart_beat()
{
write("Your heart pounds in your chest and you realize that you are still alive.\n");
}

void
commandHook(string arg)
{
write("You hear the world echo back, " + arg);
}

