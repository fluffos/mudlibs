#include <global.h>

int health;
int beatype;
string name;
void commandHook(string arg);
void damage(string infstr);


void
init()
{
	add_action("commandHook", "say", 1);
	add_action("damage", "damage", 1);
}
void 
create()
{
	seteuid(0);
	health = 1000;
}


void
setup()
{
	set_heart_beat(1);
	enable_commands();
	init();
}

void
heart_beat()
{
beatype = random(11);

