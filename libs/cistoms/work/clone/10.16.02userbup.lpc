void
commandHook(string arg)
{
tell_object(this_player(1),  "You say, '" + arg + "'\n");
write("You hear the world echo back, '" + arg +"'\n");
return;
}

void
damage(string infstr)
{
int dam;
string target;
sscanf(infstr, "%s %d", target, dam); 
write("\n You inflict " + dam + "on " + target + ".\n");
}

