/*
 *  Global user object
 *  Hacked from scratch by Casimir aka Tyler Vann-Campbell
 *  Handles playable interactives with addeed features
 */

#include <global.h>
#include <languages.h>

inherit BASE;

int health;
int beatype;
int language;
private string name;
string query_name();
void set_visible_name(string visiblename);
void set_language(int lang);
int commandHook(string arg);
int query_language();
string get_room_desc();
void force_shout(string arg);
void damage(string infstr);
void whoami(string junk);



void
init()
{
	add_action("commandHook", "", 0);
	add_action("damage", "damage", 1);
//	add_action("whoami","whoami", 1);
}
void 
create()
{
	seteuid(0);
	health = 1000;
	set_language(COMMON_SPEAK);
}


void
setup()
{
	seteuid(getuid(this_object()));
	set_heart_beat(1);
	enable_commands();
	init();
	
}

void
write_prompt()
{
write(health + ">-");;
}

string 
query_name()
{
	return name;
}

int
query_language()
{
	return language;
}

void
heart_beat()
{
beatype = random(11);

switch (beatype) { 
	case 1:	 break;
	case 2:  break;
	case 3:  break;
	case 4:  break;
	case 5:  break;
	case 6:  break;
	case 7:  break;
	case 8:  break;
	case 9:  break;
	case 10: break;
	default: break; } 

 
}

void
set_visible_name(string visiblename)
{
	name = visiblename;
	write("Your will now appear as " + name);
}

void
set_language(int lang)
{
language = lang;
}

string
get_room_desc()
{
string desc;
desc = (string)query_name() + " is here. ";
return desc;
}

void
force_shout(string arg)
{
tell_object(this_object(), "\nYou are compelled to shout, \""+ arg + "\"");
message("shouts", "\n" + query_name() + " shouts, \"" + arg + "\"\n"
	, livings() , this_object());

}

int
commandHook(string arg)
{
string cmd_verb;
object cobj;
cmd_verb = COMMAND_PREFIX + query_verb();
cobj = load_object(cmd_verb);
 if (undefinedp(cobj) == 0) {
	return (int)cobj->main(arg);
 } else {
	write("Excuse me?");
	return 0;
	}
}


void
damage(string infstr)
{
int dam;
string target;
sscanf(infstr, "%s %d", target, dam); 
write("\n You inflict " + dam + " on " + target + ".\n");
write("\n The world retaliates and you inflict the damage on\n"+
	"yourself instead! Oops!\n");
health -= dam;
return;
}

void
receive_message(string class, string message)
{
receive("\n" + message + "\n" + (string)health + ">-");

}

void
whoami(string junk)
{
write("\nYou are known as "+ query_name() + "\n");
return;
}
