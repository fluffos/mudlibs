#include <global.h>
#include <languages.h>
#include <minigame_subsys/fishing.h>
#include <logon.h>

inherit BASE;
inherit "inherit/std/user/health.lpc";
inherit "inherit/std/user/character.lpc";
inherit "inherit/std/user/minigame_subsys/fishing.lpc";




int beatype;
int language;
private string name;
string query_name();
void set_visible_name(string visiblename);
void set_language(int lang);
int commandHook(string arg);
int query_language();
string get_room_desc();
void force_shout(string arg);
void damage(string infstr);
void whoami(string junk);
void setup();


void start_login();
void login_name_handler(string user_entry);

void
start_login()
{
	write(LOGON_NAME_PROMPT);
	input_to("login_name_handler", 2);
}

void
login_name_handler(string user_entry)
{
	if (!user_entry || user_entry == "") {
		write(LOGON_NAME_EMPTY);
		write(LOGON_NAME_PROMPT);
		input_to("login_name_handler", 2);
		return;
	}
	set_living_name(user_entry);
	setnamelist(user_entry);
	write("\nHello, " + user_entry + ".\n");
	set_visible_name(user_entry);
	setup();
	move(VOID_OB);
}




void
init()
{
	add_action("commandHook", "", 0); // only one add_action, please
//	add_action("damage", "damage", 1);
//	add_action("whoami","whoami", 1);
}
void 
create()
{
	seteuid(0);
	set_health(1000);
	set_language(COMMON_SPEAK);
}


void
setup()
{
	seteuid(getuid(this_object()));
	set_heart_beat(1);
	enable_commands();
	init();
	
}

void
write_prompt()
{
write(get_health() + ">-");;
}

string 
query_name()
{
	return name;
}

int
query_language()
{
	return language;
}

void
heart_beat()
{
beatype = random(11);

switch (beatype) { 
	case 1:	 break;
	case 2:  break;
	case 3:  break;
	case 4:  break;
	case 5:  break;
	case 6:  break;
	case 7:  break;
	case 8:  break;
	case 9:  break;
	case 10: break;
	default: break; } 

 
}

void
set_visible_name(string visiblename)
{
	name = visiblename;
	write("Your will now appear as " + name);
}

void
set_language(int lang)
{
language = lang;
}

string
get_room_desc()
{
string desc;
desc = (string)query_name() + " is here. ";
return desc;
}

void
force_shout(string arg)
{
tell_object(this_object(), "\nYou are compelled to shout, \""+ arg + "\"");
message("shouts", "\n" + query_name() + " shouts, \"" + arg + "\"\n"
	, livings() , this_object());

}

int
commandHook(string arg)
{
 
 string cmd_verb;
 object cobj;

 if(this_object()->fish_get_overall_status() == FISHING_TRUE){
	 return fish_commandHook(query_verb(), arg);
 } else {
	  cmd_verb = COMMAND_PREFIX + query_verb();
	  if(member_array(query_verb(),get_dir(COMMAND_PREFIX)) > -1) {
          	cobj = load_object(cmd_verb);
 			if (cobj != 0) {
				return (int)cobj->main(arg);
 			} else {
				notify_fail("Excuse me?");
				return 0;
			}
 		} else {
	notify_fail("You cannot do that.\n");
	return 0;
		}
 } 
}


void
receive_message(string msgclass, string message)
{
	message = sprintf("\n%-=80s\n", message);
	if(msgclass != "writes"){message = message + (string)get_health()+">-";}
	receive(message);
}

void
whoami(string junk)
{
write("\nYou are known as "+ query_name() + "\n");
return;
}
