/*
 *  Global user object
 *  Defined and Coded by Casimir
 */

#include <global.h>

string name;

void
init()
{
	add_action("commandHook", "say", 1);
}
void 
create()
{
	seteuid(0);
}


void
setup()
{
	set_heart_beat(1);
	enable_commands();
	init();
	

}

void
heart_beat()
{
write("\n Your heart pounds in your chest.\n");
}

void
commandHook(string arg)
{
tell_object(this_player(1),  "You say, '" + arg + "'\n");
write("You hear the world echo back, '" + arg +"'\n");
return;
}

