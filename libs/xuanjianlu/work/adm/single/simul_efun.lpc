void create() {
  seteuid(getuid());
  write("simul_efun loaded successfully.\n");
}

object unew(string str) {
  object ob;
  int i, j, k;
  object *clone;

  if (!stringp(str)) return 0;

  ob = new(str);
  // new() of a missing file returns 0; the query below would raise call_other() Bad argument 1 and kill
  // the caller (carry_object() in an NPC's create())
  if (!ob) return ob;

  i = ob->query("unique");

  if (!i) return ob;
  clone = filter_array(children(base_name(ob)), (: clonep :));
  j = sizeof(clone);
  while (j--)
    if (!clone[j]->query("clone_by_wizard")) {
      if (k = clone[j]->query_amount()) i -= k;
      else i--;
    }
  if (i < 0) destruct(ob);
  return ob;
}

// crypt(): this driver's efun raises "Error in crypt(), check your salt" for a key longer than 255 bytes, so a long password typed at the login prompt left the
// connection at a bare prompt.  A key over the limit is cut (the same cut at every call, so the hashes still match); every ordinary password is passed on unchanged.
string crypt(string key, mixed salt) {
  if (strlen(key) > 255)
    key = key[0..254];
  while (sizeof(to_buffer(key)) > 255)            // the limit is in bytes, a CJK character takes three
    key = key[0..<2];
  return efun::crypt(key, salt);
}
