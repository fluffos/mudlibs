#include <ansi.h>

string query_rank(object ob)
{
	int age, shen;
	int budd, lama, maha, taoism;
	int rank, slrank, dlrank, pixie;

	if( ob->is_ghost() )
		return BLU "【 鬼　魂 】" NOR;
       if( ob->query("id") == "eternal" ) 
		return NOR "【 平  民 】" NOR;
       if( ob->query("class_2") == "idle" ) 
		return HIG "【我爱发呆】" NOR;
       if( ob->query("class_2") == "lover" ) 
		return HIM "【 丘比特 】" NOR;
       if( ob->query("class_2") == "robber" ) 
		return HIR "【旷世土匪】" NOR;
       if( ob->query("class_2") == "steal" ) 
		return HIW "【盗王之王】" NOR;
       if( ob->query("class_2") == "beauty" ) 
		return HIY "【 七仙女 】" NOR;
		
      if (ob->query("id")=="wxfan") return HIM "【玉米地里的稻草人】" NOR;
             if (ob->query("id")=="smzhe") return HIG "【 淫  尼 】" NOR;


           if (ob->query("id")=="clx") return HIW "【 身无彩凤双飞翼 】" NOR;



	// 年龄
	age = ob->query("age");
	// 神(德行)
	shen = ob->query("shen");

	// 佛教禅宗
	//if( ob->query("family/family_name") == "少林派" )
	budd = ob->query_skill("buddhism", 1);

	// 西藏密宗
	//if( ob->query("family/family_name") == "雪山派"
	// || ob->query("family/family_name") == "血刀门" )
	lama = ob->query_skill("lamaism", 1);

	// 大乘佛教
	//if( ob->query("family/family_name") == "峨嵋派" )
	maha = ob->query_skill("mahayana", 1);

	// 道教
	//if( ob->query("family/family_name") == "武当派"
	// || ob->query("family/family_name") == "全真教" )
	taoism = ob->query_skill("taoism", 1);

       //辽东神龙教
       slrank = ob->query("shenlong/rank");

	// 丐帮
	if( ob->query("family/ family_name") == "丐帮" )
	rank = ob->query("rank");

	// 大理官职
	if( ob->query("dali/employee") )
		dlrank = ob->query("dali/rank"); 
	// the following was to set class for those who became gonggong
	// before mongol add class eunuch
	//if ( ob->query("gender") == "无性" )
	//	ob->set("class", "eunuch");
	// should be eunach. The following lines can be removed
	// after Aug 1/97 , except that line of "pixie =...
	//	if ( ob->query("class")=="eunuch") ob->set("class", "eunach");
	if( ob->query("class")=="eunach" ) {
		ob->delete("rank_info/respect");
		ob->delete("rank_info/rude");
	}
	// 东厂
	pixie = ob->query_skill("pixie- jian", 1);
	if( pixie < 60 && ob->query("class")=="eunach" )
		ob->delete("class");
	// remove the above line after 8/1/97, except the line of "pixie =..

	switch( ob->query("gender") ) {
	case "女性":
		switch( wizhood(ob) ) {
		case "(admin)":
			return HIW "【 天　后 】" NOR;
 		case "(arch)":
			return HIY "【 女　神 】" NOR;
		case "(wizard)":
			return HIG "【 仙　女 】" NOR;
/*		case "(designer)":
			return WHT "【 玄　女 】" NOR;
		case "(creator)":
			return HIC "【 天　女 】" NOR;
		case "(caretaker)":
			return WHT "【 仙　官 】" NOR;
		case "(virtuoso)":
			return HIM "【 散　仙 】" NOR;
		case "(apprentice)":
			return MAG "【 仙　子 】" NOR;
*/		case "(immortal)":
			return CYN "【 女　巫 】" NOR;
		default:
			if( ((int)ob->query("PKS") > 100)
			 && ((int)ob->query("PKS") > (int)ob->query("MKS")/10) )
				return HIR "【 土匪婆 】" NOR;
//			if( (int)ob->query("thief") > 10 )
//				return "【 惯　窃 】";
			switch( ob->query("class") ) {
 			case "bonze":
				/*if( ob->query("hooker") )
					return HIM "【 淫　尼 】" NOR;
				else*/ if( age <= 18 )
					return "【 小尼姑 】";
				else if( shen <= -1000 )
					return HIR "【 贼　尼 】" NOR;
				else if( maha >= 380 )
					return HIW "【 神　尼 】" NOR;
				else if( maha >= 290 )
					return WHT "【 师　太 】" NOR;
				else if( maha >= 200 )
					return WHT "【 比丘尼 】" NOR;
				else if( maha >= 110 )
					return WHT "【 学戒女 】" NOR;
				else if( maha >= 20 )
					return WHT "【 沙弥尼 】" NOR;
				else
					return "【 尼　姑 】";

			case "taoist":
				if( age <= 18 )
					return "【 小道姑 】";
 				else if( taoism >= 400 )
					return HIW "【 真　君 】" NOR;
				else if( taoism >= 350 )
					return HIW "【 女　真 】" NOR;
				else if( taoism >= 250 )
					return WHT "【 女　官 】" NOR;
				else if( taoism >= 150 )
					return WHT "【 女　冠 】" NOR;
				else if( taoism >= 50 )
					return WHT "【 女　道 】" NOR;
				else
					return "【 道　姑 】";

			case "bandit":
				return "【 女飞贼 】";
			case "dancer":
				return "【 舞　妓 】";
			case "scholar":
				return "【 才　女 】";
			case "officer":
				if( dlrank == 5 )
					return "【 王　妃 】";
				else if( dlrank == 4 )
 					return "【诰命夫人】";
				else
					return "【 女　官 】";
			case "shenlong_join":
				if (slrank==3)
					return HIG"【护教圣女】"NOR;
				else if (slrank==2)
					return HIY"【 女香主 】"NOR;
				else
					return HIM"【 女教众 】"NOR;
			case "fighter":
				return "【 女武者 】";
			case "swordsman":
				return "【 女剑士 】";
			case "alchemist":
				return "【 方　士 】";
			case "shaman":		
				return "【 巫　医 】";

			case "beggar":
				if(  rank >= 9 && shen >= 1000000 )
					return HIG "【 女神丐 】" NOR;
				else if( rank >= 9 && shen <= -1000000 )
					return HIG "【 魔丐婆 】" NOR;
				else if( rank >= 7 && shen >= 100000 )
					return HIG "【 女侠丐 】" NOR;
				else if( rank >= 7 && shen <= -100000 )
					return HIG "【 恶丐婆 】" NOR;
				else if( rank >= 5 && shen >= 10000 )
					return HIG "【 女义丐 】" NOR;
 				else if( rank >= 5 && shen <= -10000 )
					return HIG "【 凶丐婆 】" NOR;
				else if( rank >= 3 )
					return GRN "【 叫化婆 】" NOR;
				else
					return GRN "【 叫化妹 】" NOR;

			default:
				if( shen >= 10000000 )
					return HIC "【旷世侠女】" NOR;
				else if( shen >= 1000000 )
					return HIC "【 大侠女 】" NOR;
				else if( shen >= 100000 )
					return HIC "【 侠　女 】" NOR;
				else if( shen <= -10000000 )
					return RED "【混世魔女】" NOR;
				else if( shen <= -1000000 )
 					return HIR "【 女魔头 】" NOR;
				else if( shen <= -100000 )
					return HIR "【 妖　女 】" NOR;
				else if( shen <= -10000 )
					return HIR "【 恶　妇 】" NOR;
				else if( age <= 30 ) {
 					if( shen >= 1000 )
						return HIC "【 小侠女 】" NOR;
					else if( shen <= -1000 )
						return HIR "【 小妖女 】" NOR;
				}
				if( age <= 18 )
					return "【 少　女 】";
				else
					return "【 民　女 】";
			}
		}
	default:
		switch(wizhood(ob)) {
		case "(admin)":
			return HIW "【 天　帝 】" NOR;
		case "(arch)":
			return HIY "【 大　神 】" NOR;
		case "(wizard)":
			return HIG "【 神　仙 】" NOR;
/*		case "(designer)":
			return WHT "【 玄　仙 】" NOR;
		case "(creator)" :
			return HIC "【 天　仙 】" NOR;
 		case "(caretaker)":
			return WHT "【 天　官 】" NOR;
		case "(virtuoso)":
			return HIM "【 散　仙 】" NOR;
		case "(apprentice)":
			return MAG "【 仙　人 】" NOR;
*/		case "(immortal)":
			return CYN "【 半　仙 】" NOR;
		default:
			if( ((int)ob->query("PKS") > 100)
			 && ((int)ob->query("PKS") > (int)ob->query("MKS")/10) )
				return HIR "【 土　匪 】" NOR;
//			if( (int)ob->query("thief") > 10 )
//				return "【 惯　窃 】";
			switch( ob->query("class") ) {
			case "eunach":
				if( age <= 18 )
					return "【 小太监 】";
				else if( pixie >= 560 )
					return HIM "【 九千岁 】" NOR;
				else if( pixie >= 490 )
					return HIM "【东厂指挥】" NOR;
				else if( pixie >= 420 )
 					return HIM "【 大档头 】" NOR;
				else if( pixie >= 350 )
					return MAG "【东厂档头】" NOR;
				else if( pixie >= 280 )
					return MAG "【东厂千户】" NOR;
				else if( pixie >= 210 )
					return MAG "【东厂百户】" NOR;
				else if( pixie >= 140 )
					return MAG "【东厂太监】" NOR;
				else if( pixie >= 70 )
					return MAG "【九品太监】" NOR;
				else
					return "【 太　监 】";

			case "bonze":
				if( age <= 18 )
					return "【 小沙弥 】";
				else if( shen <= -1000 )
					return HIR "【 恶　僧 】" NOR;
				else if( budd >= 400 )
					return HIY "【 神　僧 】" NOR;
				else if( budd >= 380 )
					return HIY "【 圣　僧 】" NOR;
 				else if( budd >= 320 )
					return HIY "【 长　老 】" NOR;
				else if( budd >= 260 )
					return YEL "【 罗　汉 】" NOR;
				else if( budd >= 200 )
					return YEL "【 尊　者 】" NOR;
				else if( budd >= 140 )
					return YEL "【 禅　师 】" NOR;
				else if( budd >= 80 )
					return YEL "【 比　丘 】" NOR;
				else if( budd >= 20 )
					return YEL "【 沙　弥 】" NOR;
				else
					return "【 僧　人 】";

			case "lama":
				if( age <= 18 )
					return "【 小喇嘛 】";
				else if( lama >= 400 )
					return HIY "【 活　佛 】" NOR;
				else if( lama >= 360 )
					return HIY "【 明　王 】" NOR;
				else if( lama >= 300 )
 					return HIY "【 法　王 】" NOR;
				else if( lama >= 240 )
					return YEL "【 国　师 】" NOR;
				else if( lama >= 180 )
					return YEL "【 上　师 】" NOR;
				else if( lama >= 120 )
					return YEL "【 灌顶师 】" NOR;
				else if( lama >= 60 )
					return YEL "【 大喇嘛 】" NOR;
				else
					return "【 喇　嘛 】";

			case "taoist":
				if( age <= 18 )
					return "【 道　童 】";
				else if( shen <= -1000 )
					return HIR "【 妖　道 】" NOR;
				else if( taoism >= 400 )
					return HIW "【 真　君 】" NOR;
				else if( taoism >= 360 )
					return HIW "【 真　人 】" NOR;
				else if( taoism >= 300 )
					return HIW "【 天　师 】" NOR;
 				else if( taoism >= 240 )
					return CYN "【 大　师 】" NOR;
				else if( taoism >= 180 )
					return CYN "【 羽　客 】" NOR;			
				else if( taoism >= 120 )
					return CYN "【 黄　冠 】" NOR;
				else if( taoism >= 60 )
					return CYN "【 道　人 】" NOR;
				else
					return "【 道　士 】";

			case "bandit":
				return "【 盗　贼 】";
			case "scholar":
				return "【 书　生 】";
			case "officer":
				if( dlrank == 5 )
					return "【 王　爷 】";
				else if( dlrank == 4 )
					return "【 侯　爷 】";
				else if( dlrank == 3 )
					return "【 武　将 】";
				else if( dlrank <= 2 )
 					return "【 官　差 】";

			case "shenlong_join":
				if (slrank==3)
					return HIG"【 护  法 】"NOR;
				else if (slrank==2)
					return HIY"【辽东尊者】"NOR;
				else
					return HIM"【 教  众 】"NOR;

			case "fighter":		
				return "【 武　者 】";
			case "swordsman":	
				return "【 剑　士 】";
			case "alchemist":	
				return "【 方　士 】";
			case "shaman":
				return "【 巫　医 】";

			case "beggar":
				if( rank >= 9 && shen >= 1000000 )
					return HIG "【 神　丐 】" NOR;
				else if( rank >= 9 && shen <= -1000000 )
					return HIG "【 魔　丐 】" NOR;
				else if( rank >= 7 && shen >= 100000 )
					return HIG "【 侠　丐 】" NOR;
				else if( rank >= 7  && shen <= -100000 )
					return HIG "【 恶　丐 】" NOR;
				else if( rank >= 5 && shen >= 10000 )
					return HIG "【 义　丐 】" NOR;
				else if( rank >= 5 && shen <= -10000 )
					return HIG "【 凶　丐 】" NOR;
 				else if( rank >= 3 )
					return GRN "【 叫化子 】" NOR;
				else
					return GRN "【 小叫化 】" NOR;

			default:
				if( shen >= 10000000 )
					return HIC "【旷世大侠】" NOR;
				else if( shen >= 1000000 )
					return HIC "【 大　侠 】" NOR;
				else if( shen >= 100000 )
					return HIC "【 侠　客 】" NOR;
				else if( shen >= 10000 )
					return HIC "【 英　侠 】" NOR;
				else if( shen <= -10000000 )
					return RED "【混世魔王】" NOR;
				else if( shen <= -1000000 )
					return HIR "【 魔　头 】" NOR;
				else if( shen <= -100000 )
					return HIR "【 大恶人 】" NOR;
				else if( shen <= -10000 )
					return HIR "【 恶　霸 】" NOR;
				else if( age <= 30 ) {
 					if( shen >= 1000 )
						return HIC "【 少　侠 】" NOR;
					else if( shen <= -1000 )
						return HIR "【 恶　少 】" NOR;
				}
				if( age <= 18 )
					return "【 少　年 】";
				else
					return "【 平　民 】";
			}
		}
	}
}

string query_rankname(string mystatus)
{
	switch( mystatus )
	{
	case "(admin)"	:	return "天帝" + mystatus;
	case "(arch)"	:	return "大神" + mystatus;
	case "(wizard)"	:	return "神仙" + mystatus;
	case "(designer)":	return "玄仙" + mystatus;
	case "(creato r)":	return "天仙" + mystatus;
 	case "(caretaker)":	return "天官" + mystatus;
	case "(apprentice)":	return "仙人" + mystatus;
	case "(immortal)":	return "半仙" + mystatus;
	case "(player)"	:	return "玩家" + mystatus;
	default: return "未知权限" + mystatus;
	}
}

string query_respect(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/respect")) )
		return str;

	age = ob-> query("age")-SKILL_D("beauty")->reduce_age(ob);
	switch(ob->query("gender")) {
		case "女性":
			switch(ob->query("class")) {
			case "bonze":
				if( age < 18 ) return "小师太";
				else return "师太";
 				break;

			case "taoist":
				if( age < 18 ) return "小仙姑";
				else return "仙姑";

			case "officer":
				if (ob->query("dali/rank")==5)
					return "娘娘";
				else if (ob->query("dali/rank")==4)
					return "贵夫人";
				else {
					if( age < 18 ) return "小姑娘";
					else if( age < 50 ) return "姑娘";
					else return "婆婆";
				}
				break;
			default:
				if( age < 18 ) return "小姑娘";
				else if( age < 50 ) return "姑娘";
				else return "婆婆";
				break;
			}
 		case "男性":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 18 ) return "小师父";
				else return "大师";
				break;
			case "lama":
				if( age < 25 ) return "小师父";
				else return "上人";
				break;
			case "taoist":
				if( age < 18 ) return "小道兄";
				else return "道长";
				break;
			case "fighter":
			case "swordsman":
				if( age < 18 ) return "小老弟";
				else if( age < 50 ) return "壮士";
				else return "老前辈";
				break;
			case "eunach": 
				if (ob->query_skill("pixie-jian",1)>160)
 					return "督公";
				if (age <18) return "小公公";
				else if (age < 50) return "公公";
				else return "老公公";
				break;
			case "officer":
				if (ob->query("dali/rank")==5)
					return "王爷";
				else if (ob->query("dali/rank")==4)
					return "侯爷";
				else if (ob->query("dali/rank")==3)
					return "将军";
				else return "差爷";
				break;
			default:
				if( age < 20 ) return "小兄弟";
				else if( age < 50 ) return "壮士";
				else return "老爷子";
				break;
			}
	}
} 

string query_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/rude")) )
		return str;

	age = ob->query("age")-SKILL_D("beauty")->reduce_age(ob);
	switch(ob->query("gender")) {
		case "女性":
			switch(ob->query("class")) {
			case "bonze":
				return "贼尼";
				break;
			case "taoist":
				return "妖女";
				break;
			default:
				if( age < 18 ) return "小贱人";
				else if( age < 50 ) return "贱人";
				else return "死老太婆";
				break;
 			}
		case "男性":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "死秃驴";
				else return "老秃驴";
				break;
			case "lama":
				if( age < 50 ) return "死秃驴";
				else return "老秃驴";
				break;
			case "taoist":
				return "死牛鼻子";
				break;
			case "eunach":
				return "阉贼";
				break;
			case "officer":
				if (ob->query("dali/rank")==5)
					return "狗王";
				else if (ob->query("dali/rank")>=3)
					return "狗官";
 				else return "狗腿子";
				break;
			default:
				if( age < 20 ) return "小王八蛋";
				if( age < 50 ) return "臭贼";
				else return "老匹夫";
				break;
			}
	}
}

string query_self(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/self")) )
		return str;

	age = ob->query("age")-SKILL_D("beauty")->reduce_age(ob);
	switch(ob->query("gender")) {
		case "女性":
			switch(ob->query("class")) {
 			case "bonze":
				if( age < 50 ) return "贫尼";
				else return "老尼";
				break;
			default:
				if( age < 30 ) return "小女子";
				else if( age < 50 ) return "妾身";
				else return "老身";
				break;
			}
		case "男性":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "贫僧";
				else return "老衲";
				break;
			case "lama":
				if( age < 50 ) return "贫僧";
				else return "老衲";
				break;
			case "eunach":
				return "下官";
 				break;
			case "taoist":
				return "贫道";
				break;
			case "officer":
				if (ob->query("dali/rank")==5)
					return "小王我";
				else return "下官";
				break;
			default:
				if( age < 50 ) return "在下";
				else return "老头子";
				break;
			}
	}
}

string query_self_rude(object ob)
{
	int age;
	string str;

	if( stringp(str = ob->query("rank_info/self_rude")) )
 		return str;

	age = ob->query("age")-SKILL_D("beauty")->reduce_age(ob);
	switch(ob->query("gender")) {
		case "女性":
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "贫尼";
				else return "老尼";
				break;
			default:
				if( age < 30 ) return "本姑娘";
				else return "老娘";
				break;
			}
		case "男性":
		default:
			switch(ob->query("class")) {
			case "bonze":
				if( age < 50 ) return "大和尚我";
				else return "老和尚我";
				break;
			case "eun ach":
 				if (age < 50) return "本官";
				else return "老身";
				break;
			case "lama":
				if( age < 50 ) return "本佛爷";
				else return "老佛爷我";
				break;	
			case "taoist":
				return "本山人";
				break;
			case "officer":
				if (ob->query("dali/rank")==5)
					return "本王";
				else if (ob->query("dali/rank")==4)
					return "本侯";
				else if (ob->query("dali/rank")==3)
					return "本官";
				else return "差爷我";
				break;
			default:
				if( age < 50 ) return "大爷我";
		 		else return "老子";
				break;
 			}
	}
}

string query_close(object ob)
{
	int a1, a2;

	if (objectp(this_player()))
	{
		if (a2 = (int)ob->query("mud_age"))
		{
			a1 = this_player()->query("mud_age");
		} else 
		{ 	
		 	a1 = this_player()->query("age");
			a2 = ob->query("age");
		}
	} else 
	{	
	 	a1 = previous_object()->query("age");
	 	a2 = ob->query("age");
	}
 							
	switch (ob->query("gender")) {
	case "女性" :
		if (a1 >= a2)
			return "妹妹";
		else
			return "姐姐";
		break;
	case "无性" :
		if (ob->query("class")== "eunach") {
		if (a1 >= a2)
			if (random(5)==1) return "妹妹";
			else return "弟弟";
		else
			if (random(5)==1) return "姐姐";
			else return "哥哥";
		}
	default :
		if (a1 >= a2)
			return "弟弟";
		else
			return "哥哥";
		break;
 	}
}

string query_self_close(object ob)
{
	int a1, a2;
	string gender;
	
	if( objectp(this_player()) )
	{
		if (a2 = (int)ob->query("mud_age"))
		{
			a1 = this_player()->query("mud_age");
		} else 
		{ 	
		 	a1 = this_player()->query("age");
			a2 = ob->query("age");
		}
		gender = this_player()->query("gender");
	} else 
	{	
	 	a1 = previous_object()->query("age");
	 	a2 = ob->query("age");
 		gender = previous_object()->query("gender");
	}
		
	switch (gender) {
	case "女性" :
		if (a1 >= a2)
			return "姐姐我";
		else
			return "小妹我";
		break;
	default :
		if (a1 >= a2)
			return "愚兄我";
		else
			return "小弟我";
	}
}
