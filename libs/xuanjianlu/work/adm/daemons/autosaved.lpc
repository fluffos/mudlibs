// autosaved.c
// file:                Autosave daemon
// creator:     ken
// date:                98-2-23

// for autosave players data file.
#include <ansi.h>
#pragma save_binary

inherit F_DBASE;

void auto_save();

void create() {
  seteuid(ROOT_UID);
  set("channel_id", "档案精灵");
  CHANNEL_D->do_channel(this_object(), "sys", "自动存储系统已经启动。");
  remove_call_out("auto_save");
  call_out("auto_save", 40);
}

void auto_save() {
  int i, mem, x = 0, y = 0;
  object *ob, link_ob;
  string id;

  seteuid(getuid());
  ob = users();
  i = sizeof(ob);
  for (i = 0; i < sizeof(ob); i++) {
    id = (string)ob[i]->query("id");
    if (!id) continue;
    if (!environment(ob[i])) continue;
    if (!objectp(link_ob = ob[i]->query_temp("link_ob"))) continue;
    if ((int)link_ob->save() && (int)ob[i]->save()) {
      message("vision", HIG "【档案存储】提示：您的档案已经自动存储完毕。\n" NOR, ob[i]);
      x += 1;
    } else {
      message("vision", HIR "【档案存储】提示：您的档案自动存储失败，请与巫师联系。\n" NOR, ob[i]);
      y += 1;
    }
  }
  CHANNEL_D->do_channel(this_object(), "sys", sprintf("系统保存玩家档案，" + x + " 个成功， " + y + " 个失败！"));
  remove_call_out("auto_save");
  call_out("auto_save", 680 + random(120));
}
