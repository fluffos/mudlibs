// Created by Kevin 2003-1-11

#include <ansi.h>
#pragma save_binary

inherit F_DBASE;

void auto_save();

void create()
{
		seteuid(ROOT_UID);
		set("channel_id", "内存精灵");
		CHANNEL_D->do_channel( this_object(), "sys", "系统清道夫已经启动。");
		call_out("auto_rec", 40);
}

void auto_rec()
{
        object *ob;
        object where;
		int i,j=0,k=0,dest_npc;
		
		ob=livings();
		for(i=0;i<sizeof(ob);i++)
		{
			if(!ob[i]||!objectp(ob[i]))
				continue;
			if( userp(ob[i]) )
				continue;
			where=environment(ob[i]);
			if(!where||!objectp(where))
			{
				destruct(ob[i]);
				j += 1;
				continue;
			}
			if( sizeof(children(base_name(ob[i])+".lpc") ) > 10 ){
				if( ob[i] && objectp(ob[i]) ){
					destruct(ob[i]);
					k += 1;
					continue;
				}
			}
		}

		dest_npc = j+k;
		
		CHANNEL_D->do_channel( this_object(), "sys",sprintf("系统自动清除 " + reclaim_objects() + " 个变数，" + dest_npc + "(j=" + j + ",k=" + k + ") 个多余NPC。"));
		remove_call_out("auto_rec");
		call_out("auto_rec", 580+random(120));
}
