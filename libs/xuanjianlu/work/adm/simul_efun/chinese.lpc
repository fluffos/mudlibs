//Cracked by Kafei

string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// AGENTS.md §15h: this was a GBK lead-byte range check
	// (str[0] > 160 && str[0] < 255), always false against this driver's
	// UTF-8 codepoints. Replaced with a CJK Unified Ideographs codepoint
	// range check. strlen(str)>=2 (originally "at least one full 2-byte
	// GBK char") is now strlen(str)>=1 since every index is one character.
	if( strlen(str)>=1 && str[0] >= 0x4e00 && str[0] <= 0x9fff ) return 1;
	return 0;
}
