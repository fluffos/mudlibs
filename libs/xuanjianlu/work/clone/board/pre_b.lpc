// /clone/board/pre_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("奖励留言簿", ({ "board" }) );
        set("location", "/d/wizard/present_room");
        set("board_id", "pre_b");
        set("long", "这是一个专供巫师发奖励后的留言板。\n" );
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}
