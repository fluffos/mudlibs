//Cracked by clx
// dashi.c 礼物大使

inherit NPC;
string ask_me();
string ask_gift();

void create()
{
	set_name("礼物大使", ({ "liwu dashi", "dashi" }));
	set("long", "他就是玄剑录的礼物大使，新手可以向他领取奖赏(gift)。\n");
	set("gender", "男性");
	set("age", 50+random(10));
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 26);
	set("int", 16);
	set("con", 22);
	set("dex", 24);
        set("inquiry", ([
		"gift" :  (: ask_me :),
                "九丹" :  (: ask_me :),
		"春节快乐" :  (: ask_gift :),
		]));
	set("combat_exp", 70000+random(20000));
	set("dalinpc",1);
	set_skill("force", 60);
	set_skill("dodge", 60);
	set_skill("unarmed", 60);
	set_skill("parry", 60);
	setup();
	carry_object("/clone/armor/cloth")->wear();
}
string ask_me()
{
	object ob,who=this_player();
	
	if(who->query("id")=="yuwen" || who->query("id")=="box")
	{
		who->add("jiudan/box",1);
		ob=new("/clone/wiz/jiuzhuan_new");
		ob->move(who);
		tell_object(who, "你要的九丹百宝箱(box)已经记录在案了！\n");
		return "你马上吃吧！\n";
	}
	
	if (who->query("xjl/liwu")<2)
	{
		if (who->query("xjl/liwu")<2)
		{
			who->set("xjl/liwu",2);
                        who->set_temp("allowtime",NATURE_D->game_time());
			ob = new("/u/yijiu/rebuilder2");
			ob->move(this_object());
			ob->move(who);
			command("chat " "欢迎" +who->query("name")+"光临玄剑录\n",);
			message_vision("$N给$n一颗在造丸\n",this_object(), who);
			return "今后的游戏过程中请仔细阅读各种帮助和公告，如有疑问，请post，我们将尽快为你解决";
		}
		else return "你不是已经领过了吗";
	}
	return "你不是已经领过了吗。";
}
string ask_gift()
{
	object ob,who=this_player();

         if (who->query("combat_exp")<10000)
         return "你还没长大，拿这东西干嘛";
	{
		if (who->query("cunjie/liwu")<2)
		{
			who->set("cunjie/liwu",2);
                        who->set_temp("allowtime",NATURE_D->game_time());
			ob = new("/u/clx/yulu");
			ob->move(this_object());
			ob->move(who);
			command("chat " "玄剑录全体wiz祝" +who->query("name")+"春节快乐\n",);
			message_vision("$N给$n一瓶雨露\n",this_object(), who);
			return "今后的游戏过程中请仔细阅读各种帮助和公告，如有疑问，请post，我们将尽快为你解决";
		}
		else return "你不是已经领过了吗";
	}
	return "你不是已经领过了。";
}