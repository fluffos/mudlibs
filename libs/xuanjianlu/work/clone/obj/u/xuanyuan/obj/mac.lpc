// mac.c

inherit ITEM;

void create() {
  set_name("人体技能生发器", ({ "mac" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "台");
    set("long", "这是一台人体技能生发器。\n");
    set("value", 0);
  }
  setup();
}

void init() {
  add_action("do_order1", "order1");
  add_action("do_order2", "order2");
}

int do_order1(string arg) {
  string name, value;
  int number;
  object obj;

  if (sscanf(arg, "%s %s %d", name, value, number) != 3)
    return 0;

  if (!(obj = present(name, environment(this_player()))))
    return 0;

  obj->set(value, number);
  tell_object(this_player(), "ok.");
  return 1;
}

int do_order2(string arg) {
  string name, value;
  int number;
  object obj;

  if (sscanf(arg, "%s %s %d", name, value, number) != 3)
    return 0;

  if (!(obj = present(name, environment(this_player()))))
    return 0;

  obj->set_skill(value, number);
  tell_object(this_player(), "ok.");
  return 1;
}
