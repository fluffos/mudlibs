// apple machine
#include <ansi.h>
#define VERSION "apple machine"

inherit ITEM;

string *bet_item = ({
  "频果", "西瓜", "☆☆", "７７", "ＢＡＲ", "金钟", "茄子", "橘子", "荔枝",
});
string *bet_msg = ({
  HIR + "你按下了 Start 键, 上面的灯慢吞吞的跑著\n\n" + NOR,
  HIR + "达达达达 仪表板上的灯绕了一圈\n\n" + NOR,
  HIR + "达达达达 仪表板上的灯又绕了一圈\n\n" + NOR,
  HIR + "仪表板上的灯突然停住了, 正好在你压的物件上, 正当你在欢呼时灯又动了起来\n\n" + NOR,
  HIY + "达达达达 仪表板上的灯往反方向绕了一圈\n\n" + NOR,
  HIY + "达达达达 仪表板上的灯往反方向又绕了一圈\n\n" + NOR,
  HIY + "灯越走越慢, 你的心情也急速起伏\n\n" + NOR,
});

string bet_tran(string str);
void pay_money(object ob, int number);

void create() {
  set_name(HIW "苹果机" NOR, ({ "apple machine", "bingo", "bingo game", "apple" }));
  set("long",
    "赌博电玩, 你可以压的有\n1 频果 赔率 5, 2 西瓜 赔率 20, 3 双星 赔率 30, 4 双七 赔率 40," +
    " \n5 ＢＡＲ 赔率 50, 6 金钟 赔率 20, 7 茄子 赔率 15, 8 橘子 赔率 10, \n9 荔枝 赔率 2,\n"
    "玩法 bet <号码> <数量> <钱币种类>, start 启动, check 查看压钱数\n"
  );
  set("unit", "台");
  set("no_get", 1);
  set("value", 1);
  setup();
}

void init() {
  add_action("do_bet", "bet");
  add_action("do_start", "start");
  add_action("do_check", "check");
}
int do_bet(string str) {
  string ppls, coin, *terms, betname, numbers;
  object me, ppl, obj, *inv, coin_ob;
  int amount, number, i, j;
  mapping bets;

  me = this_player();
  if (me->query_temp("marycheck")) return notify_fail("你开始玩了, 不能再压了\n");
  //      bets = me->query_temp("marybet");
  inv = all_inventory(environment(me));
  if (!str || sscanf(str, "%d %d %s", number, amount, coin) != 3)
    return notify_fail("bet <号码> <数量> <钱币种类>\n");
  coin_ob = present(coin + "_money", me);
  if (amount < 0) return notify_fail("你不能这样压\n");
  if (!coin_ob || file_size("/clone/money/" + coin + ".lpc") < 0)
    return notify_fail("你想用那种货币来玩?\n");
  if (coin_ob->query("id") != "coin")
    return notify_fail("你只能用文钱(Coin)来玩\n");
  if ((int)coin_ob->query_amount() < amount)
    return notify_fail("你身上没有那麽多" + coin_ob->query("name") +
      "可以压。\n");
  if (!number || number > 9 || number < 1)
    return notify_fail("你不能这样压\n");
  coin_ob->add_amount(-amount);
  if (me->query_temp("marybet")) {
    bets = me->query_temp("marybet");
    terms = keys(bets);
  }
  if (!me->query_temp("marybet")) {
    for (i = 0; i < sizeof(bet_item) + 1; i++) {
      me->set_temp("marybet/" + i, 0);
    }
  }
  numbers = "" + number;
  printf(
    "你在 %s 下了%s\n",
    bet_tran(numbers),
    chinese_number(amount) + coin_ob->query("base_unit") + coin_ob->query("name")
  );
  me->add_temp("marybet/" + number, amount);
  /*      if( sizeof(bets) > 0 ) {
                printf("你现在压著:\n");
                for(i=0; i<sizeof(bets); i++) {
//                      for(j=0; j<sizeof(terms); j++) { 
                if( bets[terms[i]] < 1 ) continue;
//              printf(terms[i]);
                j = j + 1;
                betname = bet_tran(terms[i]);           
                printf("%-6s %-8d%c",betname, bets[terms[i]], (j%5==4) ? '\n' : ' ');
//      }
        }}
        printf("\n"); */
  /*      for(i=0; i<sizeof(bet_item); i++) {
        } */
  return 1;
}

string bet_tran(string str) {

  if (!str) return 0;
  switch (str) {
    case "1": return bet_item[0];
    break;
    case "2": return bet_item[1];
    break;
    case "3": return bet_item[2];
    break;
    case "4": return bet_item[3];
    break;
    case "5": return bet_item[4];
    break;
    case "6": return bet_item[5];
    break;
    break;
    case "8": return bet_item[7];
    break;
    case "9": return bet_item[8];
    break;
    default: return 0;
  }

}
int chance(int i) {
  if (i < 5) return 9;
  if (i < 8) return 1;
  if (i < 10) return 2;
  if (i < 12) return 3;
  if (i < 14) return 6;
  if (i < 16) return 7;
  if (i < 18) return 8;
  if (i < 19) return 4;
  if (i < 20) return 5;
}
int do_check() {
  string ppls, coin, *terms, betname;
  object me, ppl, obj, *inv, coin_ob;
  int amount, number, i, j;
  mapping bets;

  me = this_player();
  if (!me->query_temp("marybet"))
    return notify_fail("要先压钱才能玩\n");
  if (me->query_temp("marycheck"))
    //	if( query("start") == me->query("id") )
    return notify_fail("你已经在玩了\n");
  //              else return notify_fail("有人正在玩, 你等一下吧\n");
  me->set_temp("marycheck", 1);
  if (me->query_temp("marybet")) {
    bets = me->query_temp("marybet");
    terms = keys(bets);
  }
  if (!me->query_temp("marybet")) {
    for (i = 0; i < sizeof(bet_item) + 1; i++) {
      me->set_temp("marybet/" + i, 0);
    }
  }
  if (sizeof(bets) > 0) {
    printf("你现在压著:\n");

    for (i = 0; i < sizeof(bets); i++) {
      if (bets[terms[i]] < 1) continue;
      j = j + 1;
      betname = bet_tran(terms[i]);
      printf("%-6s %-8d%c", betname, bets[terms[i]], (j % 5 == 4) ? '\n' : ' ');
    }
  }
  printf("\n");
  call_out("run_game", 1, me, 0);
  //      tell_object(me,"test\n");
  return 1;
}

void run_game(object ob, int count) {
  int number;
  string numbers, betname;

  if (count < sizeof(bet_msg)) {
    tell_object(ob, bet_msg[count]);
    count = count + 1;
    call_out("run_game", 1, ob, count);
  }
  number = chance(random(20));
  //      number = number + 1;
  numbers = "" + number;
  betname = bet_tran(numbers);
  tell_object(ob, HIG + "停了! 停了! 开出来的是 " + betname + " \n" + NOR);
  if (ob->query_temp("marybet/" + number)) {
    ob->delete_temp("marycheck");
    call_out("pay_money", 1, ob, number);
    //      ob->delete("marycheck");
  } else {
    tell_room(environment(ob), HIR + ob->query("name") + "杠龟了\n" + NOR, ob);
    tell_object(ob, HIR + "你杠龟了\n" + NOR);
    ob->delete_temp("marybet");
    ob->delete_temp("marycheck");
  }
  return;
}

void pay_money(object ob, int number) {
  string numbers, betname;
  int amount;
  numbers = "" + number;
  betname = bet_tran(numbers);
  tell_object(ob, HIC + "恭喜你中了 " + HIY + betname + HIC + " \n" + NOR);
  tell_room(
    environment(ob),
    HIC + ob->query("name") + "中了 " + HIY + betname + HIC + " \n" + NOR,
    ob
  );
  coin = new("clone/money/coin");
  switch (numbers) {
    case "1":
      amount = 5;
      break;
    case "2":
      amount = 20;
      break;
    case "3":
      amount = 30;
      break;
    case "4":
      amount = 40;
      break;
    case "5":
      amount = 50;
      break;
    case "6":
      amount = 20;
      break;
    case "7":
      amount = 15;
      break;
    case "8":
      amount = 10;
      break;
    default:
      amount = 2;
  }

  coin->set_amount(amount * ob->query_temp("marybet/" + number));
  coin->move(ob);
  ob->delete_temp("marybet");
  return;


}
int do_check() {
  string ppls, coin, *terms, betname;
  object me, ppl, obj, *inv, coin_ob;
  int amount, number, i, j;
  mapping bets;

  me = this_player();
  if (me->query_temp("marybet")) {
    bets = me->query_temp("marybet");
    terms = keys(bets);
  }
  if (!me->query_temp("marybet")) {
    for (i = 0; i < sizeof(bet_item) + 1; i++) {
      me->set_temp("marybet/" + i, 0);
    }
  }
  if (sizeof(bets) > 0) {
    printf("你现在压著:\n");
    for (i = 0; i < sizeof(bets); i++) {
      if (bets[terms[i]] < 1) continue;
      j = j + 1;
      betname = bet_tran(terms[i]);
      printf("%-6s %-8d%c", betname, bets[terms[i]], (j % 5 == 4) ? '\n' : ' ');
    }
  }
  printf("\n");
  return 1;
}
