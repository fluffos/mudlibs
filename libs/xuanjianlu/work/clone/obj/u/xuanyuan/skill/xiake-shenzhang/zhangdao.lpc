// zhangdao.c

#include <combat.h>
#include <ansi.h>

inherit SSERVER;

void create() { seteuid(getuid()); }        
int perform(object me, object target)
{
     object obj;
        string msg;
        int i;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「掌刀」一诀只能对战斗中的对手使用。\n");

 if(me->is_busy()) return notify_fail(HIC"你正忙着呢。\n"NOR);
 if(me->query_skill("xiake-shenzhang",1)<60)
    return notify_fail(HIC"你侠客神掌火候不够，无法使出‘掌刀’这一诀。\n");
 if(me->query_skill("force")<60)
   return notify_fail(HIC"你内功火候不够，无法形成‘掌刀’。\n");
 if(me->query("neili")<500)
   return notify_fail(HIC"你内力不够。\n"NOR);
// message_vision(HIC"$N双掌朝天一拍，发出‘铿锵’一声刺耳的金属声，凌厉"+
//       "的真气\n在掌中凝聚而成一把黝黑的刀---掌刀。\n"NOR,me);
 obj=new("/d/xiakedao/obj/weapon/zhangdao");
if(!obj) return notify_fail(HIC"error"NOR);   
 obj->move(me);
 "/cmds/cooler/wield"->main(me,obj->query("id"));
 i=me->query("neili")/10;
 i=(i+random(i))/2;
 me->add_temp("apply/damage",i);
 COMBAT_D->do_attack(me,target,obj,TYPE_QUICK);
// obj->unequip();
 "/cmds/cooler/unwield1"->main(me,obj->query("id"));
 destruct(obj);
 me->add_temp("apply/damage",-i);
 me->add("neili",-500);
 me->start_busy(1);
        return 1;
}