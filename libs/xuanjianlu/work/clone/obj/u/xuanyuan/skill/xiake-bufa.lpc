//xiake-bufa.c
#include <ansi.h>
#include <c_fight.h>

inherit SKILL;

mapping *action = ({
([      "action" : "$n脚尖在地上一点，一式「蜻蜓点水」刹时人就直飞了出去，，令$N不知所措。\n",
        "dodge"  : 20,
        "lvl"    : 0,
        "skill_name":"蜻蜓点水"
]),
([      "action" : "$n一式「斗转星移」，双脚在地上一阵乱踩，身影顿时飘忽了起来，$N的凌厉攻势杀时迟钝了下来。\n",
        "dodge"  : 40,
        "lvl"    : 20,
        "skill_name":"斗转星移"
]),
([      "action" : "$n一式「寒松控雪」，足不动，手不抬，一转眼间便绕到了$N的身后。\n",
        "dodge"  : 50,
        "lvl"    : 40,
        "skill_name":"寒松控雪" 
]),
([      "action" : "$n一式「东柏凌风」，一转身间，四面八方飘动着无数个$n的身影，令$N手无足措。\n",
        "dodge"  : 60,
        "lvl"    : 50,
        "skill_name":"东柏凌风"
]),
([      "action" : "$n一式「一鹤冲天」，全身笔直，拔地而起，在半空中一转，已落到几丈远的地方。\n",
        "dodge"  : 80,
        "lvl"    :  60,
        "skill_name":"一鹤冲天"
]),
([      "action" : "$n一式「仙人排天」，两臂鹏举如翼，在剌剌风声中，从$N头顶横跃而过。\n",
        "dodge"  : 100,
        "lvl"    : 70,
        "skill_name":"仙人排天" 
]),
([      "action" : "$n一式「凤凰鼓翅」，双脚点地，全身化为一道白影，急速绕着$N打了几转。\n",
        "dodge"  : 150,
        "lvl"    : 90,
        "skill_name":"凤凰鼓翅"
]),
});

mapping query_action(object me, object weapon)
{
        int i, level;
        int tt;
        object obj;
        obj=who_i_fight(me);
        level   = (int) me->query_skill("xiake-bufa",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                 {
                  tt=NewRandom(i, 20, level/5);
                  if(tt==5)
                     {
                   if(me->is_busy()&&(me->query("neili")>100))
                    {
           tell_object(me,HIC"当你感觉到行动受阻时，急忙提一口气，脚下连变"+
                  "\n数种侠客步法，顿时身体就灵动了起来。\n"NOR);
          tell_room(environment(me),HIC+me->name()+
                 "脚下刹时踏出数种步法，变化无穷，令人眼花缭乱。\n",me);
                   me->start_busy(0);
                   me->add("neili",-30);
                     } 
                      }
                  if(tt==6)
                   {
         if(me->query("neili")>150)
             {
            me->add("neili",-70);
            me->start_busy(0);
            message_vision(HIC"$N终于使出了侠客步法中的精髓， 身影刹时就"+
              "飘忽了起来，\n如仙子临空般的飘逸，如鹰击长空般的迅疾。\n",me);
            if(obj)
            {
            if(random(me->query("combat_exp"))>(obj->query("combat_exp")/2))
             {
             message_vision(HIC"$n被$N的神奇步法所惑，身形变的迟钝起来。\n",me,obj);
               obj->start_busy(1);
         
               }
           else
           message_vision(HIC"$n并没有被$N的神奇步法迷惑，攻击如常。\n"NOR,me,obj);
          }
                    }
                   }
                 if(me->query_skill("feitian",1)>0)
                  action[tt]["dodge"]+=me->query_skill("feitian",1)*10;
                 action[tt]["dodge"]+=random(me->query("neili")/100)*3;
                        return action[tt];
                    }
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

int valid_enable(string usage)
{
        return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
        return 1;
}

string query_dodge_msg(string limb)
{
        object me, ob;
        mapping act;

        me = this_player();
        ob=me->query_temp("weapon");
        act = query_action(me, ob);
        if(!act) return action[random(sizeof(action))]["action"];
        return act["action"];
}