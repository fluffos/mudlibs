// xuanyuan-shengong.c 轩辕神功
// By xuanyuan

inherit FORCE;

string *jingmai = ({
  "冲",
  "任",
  "督",
  "带",
  "阴维",
  "阳维",
  "阴跤",
  "阳跤",
});

int valid_enable(string usage) {
  return usage == "force";
}

int valid_learn(object me) {
  int i, nb, nf, nh, ns, ts;
  nb = (int)me->query_skill("literate", 1);
  nf = (int)me->query_skill("force", 1);
  nh = (int)me->query_skill("xiake-shengong", 1);
  ns = (int)me->query("shen");

  if (me->query_skill("bibo-shengong", 1)
    || me->query_skill("beiming-shengong", 1)
    || me->query_skill("bahuang-gong", 1)
    || me->query_skill("hamagong", 1)
    || me->query_skill("huagong-dafa", 1)
    || me->query_skill("huntian-qigong", 1)
    || me->query_skill("hunyuan-yiqi", 1)
    || me->query_skill("longxiang", 1)
    || me->query_skill("jiuyang-shengong", 1)
    || me->query_skill("taiji-shengong", 1)
    || me->query_skill("xiaowuxiang", 1)
    || me->query_skill("zixia-shengong", 1)
    || me->query_skill("yunlong-shengong", 1)
    || me->query_skill("yunu-xinjing", 1))
    return notify_fail("你不先散了别派内功，怎能学轩辕神功？！\n");

  if (me->query("age") < 15)
    return notify_fail("轩辕神功威力太大，你年纪太小，强自练习会走火入魔的。\n");

  if (nf < nh)
    return notify_fail("轩辕神功以基本内功为基础，你的内功火候不够，还需要再练练。n");

  //	if ( ns < (nh*100) ) 
  //	return notify_fail("轩辕神功追求一种侠者的意境，你的侠义之气不够，还无法体会这种意境。\n");

  if ((nh <= 100) && (me->query("jingmai") < (nh / 15)))
    return notify_fail("轩辕神功每练一层都以打通人身上的奇经八脉为基础，你的" +
      jingmai[nh / 15 - 1] + "脉还没打通，无法继续练习。\n");
  return 1;
}


int practice_skill(object me) {
  if ((int)me->query("max_neili") < 500)
    return notify_fail("你得进一步提高你的内力。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的气不够。\n");
  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -50);
  return 1;

}

string exert_function_file(string func) {
  return __DIR__ "xuanyuan-shengong/" + func;
}
