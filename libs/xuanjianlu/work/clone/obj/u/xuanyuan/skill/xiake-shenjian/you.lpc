// you.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int i;

  if (!target) target = offensive_target(me);
  if (me->query_condition("fight_cond") > 0)
    return notify_fail("你现在不能使用诱字诀。\n");
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「诱」字诀只能对战斗中的对手使用。\n");

  msg = CYN "$N使出侠客神剑中的‘诱’字诀，只见$N吃力的抡起长剑东一指西一挑，" +
    "破洞百出。\n" NOR;
  message_vision(msg, me, target);
  me->apply_condition("fight_cond", 2);
  i = me->query("combat_exp") / 5000 + me->query_skill("sword");
  if (random(i) >
    ((target->query("combat_exp") / 5000 + target->query_skill("sword")) * 3 / 4)) {
    message_vision(HIC "$n看到$N的剑法中露出破绽，急忙进攻。\n" NOR, me, target);
    COMBAT_D->do_attack(target, me, target->query_temp("weapon"), TYPE_QUICK);
    message_vision(HIC "$N一见到$n上当贸然进攻，急忙剑法一变，只见其剑尖洒\n" +
      "出万点银光罩住了$n,以迅雷之势连功出三剑。\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon") /*,TYPE_QUICK*/);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon") /*,TYPE_QUICK*/);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon") /*,TYPE_QUICK*/);
  } else {
    message_vision(CYN "$n看破了$N的企图，没有贸然进攻。\n" NOR, me, target);
  }

  me->receive_damage("qi", 10);
  me->receive_damage("jing", 10);
  me->add("neili", -10);
  return 1;
}
