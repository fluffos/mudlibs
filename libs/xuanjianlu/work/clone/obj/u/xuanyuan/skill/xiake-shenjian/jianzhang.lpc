//jianzhang.c

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
      object ob;
        int damage;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("一剑加三掌只能对战斗中的对手使用。\n");

        if( !objectp(me->query_temp("weapon")) )
                return notify_fail("你必须有武器才能使用一剑加三掌！\n");              
                
                                
        if( (int)me->query_skill("xiake-shengong", 1) < 60 )
                return notify_fail("你的侠客神功不够娴熟，不会使用一剑加三掌。\n");
        if( (int)me->query_skill("xiake-shenjian", 1) < 100 )
                return notify_fail("你的侠客神剑不够娴熟，不会使用一剑加三掌。\n");
        if( (int )me->query_skill("sword", 1) < 2 )
              return notify_fail("你对剑的领悟不够，发挥不出一剑加三掌的威力。\n");
        if( (int)me->query("neili", 1) < 500 )
                return notify_fail("你现在内力太弱，不能使用一剑加三掌。\n");
        if( me->query_skill_mapped("unarmed")!="xiake-shenzhang")
                        return notify_fail("你的外功使用方式不对，你得使用侠客神掌。\n");
             if(me->query_skill("xiake-shenzhang",1) < 50)
                        return notify_fail("你的侠客神掌不够娴熟，无法配合使用一剑加三掌。\n");

 
       msg = CYN "$N运起侠客神剑剑意一诀中的第一诀「一剑加三掌」，只见$N有手抖起了满天剑影\n"+
                                 "左掌不时的在剑影中飘乎穿插。\n"NOR;
       
        if (random(me->query("combat_exp")) > target->query("combat_exp")*5/7 )
        {
        message_vision(msg, me, target);
        ob=me->query_temp("weapon");
         COMBAT_D->do_attack(me,target,me->query_temp("weapon"));
               ob->unequip();        
             me->reset_action();
         COMBAT_D->do_attack(me,target,0);
         COMBAT_D->do_attack(me,target,0);
         COMBAT_D->do_attack(me,target,0);         
        ob->wield();
        me->reset_action(); 
        } else 
        {
                me->start_busy(1);
                msg += CYN"可是$p看破了$P的意图，急速功出了一招，化解了$P的功势。\n"NOR;
        message_vision(msg, me, target);

             COMBAT_D->do_attack(target,me,target->query_temp("weapon"));
  
        }
       me->add("neili",-500);
       me->start_busy(2);
        return 1;
}