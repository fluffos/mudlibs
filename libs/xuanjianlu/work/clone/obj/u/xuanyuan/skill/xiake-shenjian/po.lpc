// po.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int i;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「破」字诀只能对战斗中的对手使用。\n");

  msg = CYN "$N使出侠客神剑中的‘破’字诀，顿时洒出漫天银光，$n的攻势被化解了。" NOR;
  i = me->query("combat_exp") / 5000 + me->query_skill("sword");
  if (random(i) >
    ((target->query("combat_exp") / 5000 + target->query_skill("sword")) * 2 / 3)) {
    me->start_busy(0);
    target->start_busy(2);
    message_vision(msg, me, target);
  } else {
    message_vision(CYN "$n看破了$N的企图。\n" NOR, me, target);
  }

  me->receive_damage("qi", 10);
  me->add("neili", -10);
  return 1;
}
