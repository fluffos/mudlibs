);

int valid_enable(string usage) {
  return usage == "cuff" || usage == "unarmed" || usage == "strike" || usage == "parry";
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练侠客神掌必须空手。\n");
  if ((int)me->query_skill("xiake-shengong", 1) < 20)
    return notify_fail("你的侠客神功火候不够，无法学侠客神掌。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练侠客神掌。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  object vict;
  int tt;
  int i, level;
  vict = who_i_fight(me);
  if (!vict) return action[NewRandom(i, 20, level / 5)];
  level = (int)me->query_skill("xiake-shenzhang", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"]) {
      tt = NewRandom(i, 20, level / 5);
      if (tt == 9) {
        if (me->query("neili") > 500) {
          message_vision(HIC "$N双手缓缓张开，一股强劲的气流顿时从其周围迅速扩展" +
            "开来，\n，满地的落叶灰尘被卷的四处飞腾，直接影响了周围的视线。\n" NOR, me);
          tell_room(environment(me), HIC "你被这强劲的气流吹的几乎站不稳脚步。\n" NOR, me);
          if (random(me->query("combat_exp")) > (vict->query("combat_exp") * 2 / 3)) {
            if (me->query("neili") > vict->query("neili")) {
              message_vision(HIC "$N在$n气劲的逼迫下摇摇晃晃的退了几步，可能吃了个不" +
                "小的亏。\n", vict, me);
              tell_object(vict, HIC + "你收" + me->name() + "内力的压迫，觉得胸口一闷，\n" +
                "看来你可能受了内伤。\n" NOR);

              vict->receive_wound("qi",
                (me->query("neili") / 50 + random(me->query("neili") / 50)) / 2);
              vict->receive_damage("qi", me->query("neili") / 50);
            } else {
              message_vision(HIC "$N强吸一口真气，抵住了$n强劲的内力，但身影不禁有些晃动" +
                "\n，可能吃了个暗亏。\n" NOR, vict, me);
              tell_object(vict, HIC + "你感到胸口有些不大舒服，可能受了些内伤。\n" + NOR);
              vict->receive_wound("qi",
                (me->query("neili") / 50 + random(me->query("neili") / 50)) / 4);
              vict->receive_damage("qi", me->query("neili") / 100);
            }
            me->start_busy(2);
            vict->start_busy(3);
          } else {
            if (vict->query("neili") > 200) {
              message_vision(HIC "$N‘嘿’的一声如春雷乍响，也逼出了一股强劲" +
                "的内力，\n同$n的内力中途相撞，顿时形成一个强劲的旋涡，" +
                "卷起的灰尘就象一\n条龙似的直冲天空。\n" NOR, vict, me);
              vict->receive_damage("qi", 40);
              me->receive_damage("qi", 30);
              vict->add("neili", -200);
              vict->start_busy(1);
              me->start_busy(2);
            } else {
              message_vision(HIC "$N双脚连续变动，左右腾挪，刹时变换了十几种身" +
                "形，\n终于躲开了$n凌历的一击。\n" NOR, vict, me);
              me->start_busy(2);
            }
          }
          me->add("neili", -500);
        }
      }
      if (tt == 8) {
        if (me->query("neili") > 300) {
          message_vision(HIC "$N双掌张开急点$n胸前大穴。\n" NOR, me, vict);
          //   action[tt]["action"]="";
          if (random(me->query("combat_exp")) > (vict->query("combat_exp") * 2 / 3)) {
            tell_object(me, HIC "你点中了" + vict->name() + "的穴道。\n" NOR);
            tell_object(vict, HIC "你的穴道被" + me->name() + "点中了。\n" NOR);
            vict->start_busy(random(5) + 1);
            vict->receive_damage("qi", 30);
          } else tell_object(me, HIC + vict->name() + "用内力震开了你的手指，点穴失败了。\n" NOR);
          me->add("neili", -300);
        }
      }
      if (me->query_skill("zhangyi", 1) > 0)
        action[tt]["damage"] += 10 * me->query_skill("zhangyi", 1);
      action[tt]["damage"] += random(me->query("neili") / 100) * 3;
      return action[tt];
    }
}

int practice_skill(object me) {
  string name;
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练侠客神掌。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -5);
  name = query_skill_name(me->query_skill("xiake-shenzhang", 1));
  message_vision(HIW "$N开始练习‘" + name + "’的技巧，只见掌影上下翻飞。 \n" NOR, me);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "xiake-shenzhang/" + action;
}
