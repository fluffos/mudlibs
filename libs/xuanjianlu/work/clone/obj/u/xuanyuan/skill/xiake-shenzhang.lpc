    "damage": 20,
    "damage_type": "瘀伤",
    "lvl": 0,
    "skill_name": "一元登真"
  ]),
  ([ "action": "$N左掌划一半圆，一式「土脉迎阳」，右掌斜穿而出，疾拍$n的胸前大穴",
    "force": 170,
    "dodge": 15,
    "damage": 20,
    "damage_type": "瘀伤",
    "lvl": 12,
    "skill_name": "土脉迎阳"
  ]),
  ([ "action": "$N使一式「地天交泰」，右掌上引，左掌由后而上一个甩劈，斩向$n的$l",
    "force": 190,
