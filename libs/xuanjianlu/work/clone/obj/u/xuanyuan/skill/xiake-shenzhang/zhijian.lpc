// zhijian.c

#include <combat.h>
#include <ansi.h>

inherit SSERVER;

void create() { seteuid(getuid()); }
int perform(object me, object target) {
  object obj;
  string msg;
  int i, at;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「指剑」一诀只能对战斗中的对手使用。\n");

  if (me->is_busy()) return notify_fail(HIC "你正忙着呢。\n" NOR);
  if (me->query_skill("zhangyi", 1) < 4)
    return notify_fail(HIC "你对掌的高深意境领悟的不够。\n" NOR);
  if (me->query_skill("xiake-shenzhang", 1) < 120)
    return notify_fail(HIC "你侠客神掌火候不够，无法使出‘指剑’这一诀。\n");
  if (me->query_skill("force") < 100)
    return notify_fail(HIC "你内功火候不够，无法形成‘指剑’。\n");
  if (me->query("neili") < 1000)
    return notify_fail(HIC "你内力不够。\n" NOR);
  obj = new("/d/xiakedao/obj/weapon/zhijian");
  if (!obj) return notify_fail(HIC "error" NOR);
  obj->move(me);
  "/cmds/cooler/wield"->main(me, obj->query("id"));
  i = me->query("neili") / 10;
  i = (i + random(i)) / 2;
  at = me->query_skill("zhangyi", 1) * 10;
  at = (at + random(at)) / 2;
  me->set_temp("apply/damage", i);
  me->set_temp("apply/attack", at);
  COMBAT_D->do_attack(me, target, obj, TYPE_QUICK);
  // obj->unequip();
  "/cmds/cooler/unwield1"->main(me, obj->query("id"));
  destruct(obj);
  me->set_temp("apply/damage", -i);
  me->set_temp("apply/attack", -at);
  me->add("neili", -(500 + random(500)));
  me->start_busy(3);
  return 1;
}
