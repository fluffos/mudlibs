//break.c

#include <ansi.h>
inherit F_SSERVER;

//#include <c_fight.h>

int exert(object me, object target)
{
	object weapon,ob;
	int mf,vf,damage,wdp,wap;

        if(!me->is_fighting())
		return notify_fail("你只有在战斗时才能使用这一诀。\n"NOR);

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("你要用内力来震谁？\n");

        if( me->is_busy())
		return notify_fail("你现在正忙，无法运气发功。\n"NOR);

        if( (int)me->query("max_neili") < 500 )
                return notify_fail("你的内力修为不够。\n");

        if( (int)me->query("neili") < 200 )
                return notify_fail("你的真气不够。\n");

        if(!(weapon=me->query_temp("weapon")))
           return notify_fail("震字诀是靠兵器来传送自己的内力，达到震伤对方或震断对方兵器的效果。"NOR);

        mf=me->query("neili")*me->query_skill("force");
        vf=target->query("neili")*target->query_skill("force");
        mf=mf/1000;
        vf=vf/1000;
        me->start_busy(5);
        if(mf>vf)
        damage=me->query("neili")/10;
        else damage=me->query("neili")/100;
        if(ob=target->query_temp("weapon"))
         {
                 wap = (int)weapon->weight() / 500
                        + (int)weapon->query("rigidity")
                        + (int)me->query("str");
                if(weapon->query("rank")) 
                     wap=wap*(weapon->query("rank"));
                wdp = (int)ob->weight() / 500
                        + (int)ob->query("rigidity")
                        + (int)target->query("str");
                 if(ob->query("rank")) 
                   wdp=wdp*ob->query("rank");    
           mf=mf+wap;
           vf=vf+wdp;
          tell_object(me,HIR"你把真气运至"+weapon->name()+HIR"上，缓缓的向"+
              target->name()+"的"+ob->name()+HIR"迎了上去。\n"NOR);
          if(random(mf+vf) < (mf*2/3))
            {
        tell_object(target,YEL"你感到一股强劲的内力从你的"+ob->name()+YEL"上"+
                "传了过来，觉得胸口一闷。\n"NOR);
            message_vision(HIW "只听见「啪」地一声，$N手中的" + ob->name()
                                + HIW"已经断为两截！\n" NOR, target );
                        ob->unequip();
                        ob->move(environment(target));
                        ob->set("name", "断掉的" + ob->query("name"));
                        ob->set("value", 0);
                        ob->set("weapon_prop", 0);
                        target->reset_action();
             me->receive_damage("qi",damage/3);       
              }
           else
            {
           message_vision(HIY "$N的" + weapon->name() + HIY"和$n的" + ob->name()
                                + HIY"相击，冒出点点的火星。\n" NOR, me, target);

       tell_object(target,YEL"你感到一股强劲的内力从你的"+ob->name()+YEL"上"+ 
          "传了过来，"+ob->name()+YEL"几乎脱手飞出。\n"NOR);
              }
          }
         else
          {
          tell_object(me,HIR"你默运一口真气传向"+weapon->name()+"\n"NOR);
         message_vision(HIR "$N的"+weapon->name()+"在内力的催动下嗡嗡直响。\n"NOR,me);
          if(random(mf+vf)<mf/2)
            {
         tell_object(target,HIR"你感觉到有一股雄厚的内力从"+me->name()+"的"+
               weapon->name()+HIR"传了过来，胸口一闷！\n"NOR);
         if(damage>100)
          tell_object(target,HIR"你受伤不轻。\n"NOR);
         target->receive_damage("qi",damage);
         target->receive_wound("qi",damage/2); 
             }
           else
             {
         tell_object(target,HIC"你暗吸一口真气，抵挡住了"+me->name()+"的"+
              weapon->name()+HIC"传过来绵延不断的内劲。\n"NOR);
         target->receive_damage("qi",damage/10);
              }
           } 
        me->add("neili", -100);
        return 1;
}