    "dodge": -10,
    "damage": 10,
    "lvl": 0,
    "skill_name": "双宿双飞",
    "damage_type": "割伤"
  ]),
  ([ "action": HIG "一式「随心所欲」，$N左手持刀著著进攻，蓦地里$w" + HIG "急旋，缓缓逼向
$n的$l" NOR,
    "force": 130,
    "dodge": -10,
    "damage": 20,
    "lvl": 8,
    "skill_name": "随心所欲",
    "damage_type": "割伤"
  ]),
  ([ "action": HIC "$N接着使出「心有灵犀」，陡然间风声飒然，右手持$w" + HIC "，一刀自後袭到，跟著
又是一刀，拦腰斩向$n" NOR,
    "force": 140,
    "dodge": -5,
    "damage": 30,
    "lvl": 16,
    "skill_name": "心有灵犀",
    "damage_type": "割伤"
  ]),
  ([ "action": MAG "$N一招「意乱情迷」，$w" + MAG "如影随形的再反手一刀，笔直砍向$n的$l" NOR,
    "force": 160,
    "dodge": 5,
    "damage": 40,
    "lvl": 24,
    "skill_name": "意乱情迷",
    "damage_type": "割伤"
  ]),
  ([ "action": YEL "$N一式「海枯石烂」，一个旋身，双手紧握$w" + YEL "，由左肩斜劈$n的$l" NOR,
    "force": 180,
    "dodge": 10,
    "damage": 50,
    "lvl": 33,
    "skill_name": "海枯石烂",
    "damage_type": "割伤"
  ]),
  ([ "action": WHT "$N挥舞$w" + WHT "，一招「吹笛萧萧」，连砍数刀，每一刀的力道和角度都不同，忽轻忽重，
齐齐劈向$n" NOR,
    "force": 210,
    "dodge": 15,
    "damage": 60,
    "lvl": 42,
    "skill_name": "吹笛萧萧",
    "damage_type": "割伤"
  ]),
  ([ "action": HIW "$N一招「携手天涯」，借跃空之势，又是双手运刀，$w" + HIW "破空而下，挟风声
劈向$n的$l，发出尖锐破空的刀啸声" NOR,
    "force": 240,
    "dodge": 5,
    "damage": 70,
    "lvl": 51,
    "skill_name": "携手天涯",
    "damage_type": "割伤"
  ]),
  ([ "action": HIY "$N一招「情归何处」，暴喝声中双手不住运起$w" + HIY "，每倒都高举过头，时而直劈，
时而斜削" NOR,
    "force": 280,
    "dodge": 20,
    "damage": 80,
    "lvl": 60,
    "skill_name": "情归何处",
    "damage_type": "割伤"
  ]),
});


int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_combine(string combo) { return combo == "fumo-jian"; }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("beiming-shengong", 1) < 10)
    return notify_fail("你的北冥神功火候太浅。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("ruyi-dao", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练如意刀。\n");
  me->receive_damage("qi", 25);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "ruyi-dao/" + action;
}
