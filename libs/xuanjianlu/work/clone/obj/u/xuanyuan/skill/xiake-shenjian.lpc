int valid_learn(object me) {
  object ob;
  int i, skill;

  if ((int)me->query("max_neili") < 300)
    return notify_fail("你的内力不够，没有办法练侠客神剑。\n");

  if ((string)me->query_skill_mapped("force") != "xiake-shengong")
    return notify_fail("侠客神剑必须配合侠客神功才能练。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  skill = me->query_skill("xiake-shenjian", 1);
  if (skill > (me->query_skill("xiake-shengong", 1) * 4 / 3)) {
    if (test_zouhuorumo(me)) return notify_fail("");
    return notify_fail(YEL "你的侠客神功火候不够，强练侠客神剑可能导致走火入魔！\n" NOR);
  }
  if (skill == 119) {
    if (me->query_skill("sword", 1) < 2)
      return notify_fail(YEL "你对剑的一经领悟不够，没法在进一步学习侠客\n" +
        "神剑了，你得提高你的基本剑法。\n" NOR);
  }
  if (skill == 149) {
    if (me->query_skill("sword", 1) < 2)
      return notify_fail(YEL "你对剑的一经领悟不够，没法在进一步学习侠客\n" +
        "神剑了，你得提高你的基本剑法。\n" NOR);
  }

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level, tt, wound, k;
  object obj, *inv;
  level = (int)me->query_skill("xiake-shenjian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"]) {
      //                        tt=NewRandom(i,20,level/5);
      tt = random(i);
      if (tt == 22) {
        if ((obj = who_i_fight(me)) && (me->query("neili") > 300)) {
          me->add("neili", -300);
          tell_object(me, HIC "你的真气运转流畅，随着剑意丝丝地从剑尖\n" +
            "发了出去。\n好爽！.....\n" NOR);
          tell_room(environment(me), HIC + me->name() +
            "剑光闪动，一阵阵寒意不断的向四周扩散，你不禁感觉到有些发冷。\n" NOR, me, obj);
          tell_object(obj, HIW "你感觉到" + me->name() + "的剑上发出丝丝真气\n" +
            "把你团团包围住，你感觉到气息受阻，行动也迟缓了下来。\n" +
            "看来你感觉不太好。\n......\n.." NOR);
          if (random(5) == 4) {
            tell_object(obj, HIR "不好！你收对方真气的引诱，气息全乱了。\n" +
              "你走火入魔了。\n..........\n.....\n" NOR);
            obj->apply_condition("zouhuorumo", me->query("neili") / 50 + 10);
            tell_room(environment(me), HIW + obj->name() +
              "突然浑身颤抖起来，可能是走火入魔了。\n" NOR, obj);
            if (me->query_skill("jianyi", 1) > 0)
              action[tt]["damage"] += 10 * me->query_skill("jianyi");
            action[tt]["damage"] += (me->query("neili") / 100) * 4;


            return action[tt];
          } else {
            wound = me->query_skill("sword") - obj->query_skill("sword");
            wound = wound / 5;
            if (wound < 1) wound = 40;
            obj->receive_wound("qi", random(wound));
            obj->receive_damage("qi", random(wound) + 10);
          }
        }
      }
      if (tt == 23) {
        if ((obj = who_i_fight(me)) && (me->query("neili") > 1500)) {
          if (me->query_skill("jianyi", 1) > 6) {
            tell_object(me, HIW "在绵绵剑意的催动下，你体内的真气形成一股\n" +
              "强大无比的旋涡从你的剑尖直冲而出。" NOR);
          } else {
            tell_object(me, YEL "有一股无法抗拒的力量把你体内的真气给催动\n" +
              "了起来，强大无比的真气从你体内逼出直透剑尖，你感觉到胸口\n" +
              "极闷。\n" NOR);
            me->receive_damage("qi", me->query("sword") / 10);
            me->receive_wound("qi", random(me->query("sword")) / 10 + 5);
          }
          message_vision(HIW "$N的剑上突然冒出三丈剑虹，就象一道霹雳划过天空，" +
            "\n，带过阵阵呼啸声.........\n...\n" NOR, me);
          message_vision(HIC "$n顿时被$N逼出的剑虹穿体而过，发出绝望的嚎叫...\n" +
            "\n" NOR, me, obj);
          me->add("neili", -1500);
          wound = me->query_skill("sword") - obj->query_skill("sword");
          if (wound < 1) wound = 50;
          obj->receive_damage("qi", 80 + random(wound) / 3);
          obj->receive_wound("qi", 50 + random(wound) / 3);
          tell_room(environment(me), YEL +
            "你被" + me->name() + "剑气带了一下，顿时鲜血直流。\n....\n" NOR, me, obj);
          inv = all_inventory(environment(me));
          for (k = 0; k < sizeof(inv); k++) {
            if (living(inv[k])) {
              wound = me->query("neili") - inv[k]->query("neili");
              wound = wound / 100;
              if (wound < 1) wound = 10;
              inv[k]->receive_wound("qi", (wound + random(wound)) / 2);
              inv[k]->receive_damage("qi", (wound + random(wound)));
            }
          }

        }
      }
      if (me->query_skill("jianyi", 1) > 0)
        action[tt]["damage"] += 10 * me->query_skill("jianyi");
      action[tt]["damage"] += (me->query("neili") / 100) * 4;
      return action[tt];
    }
}


int practice_skill(object me) {
  string name;
  if (((me->query("eff_qi") * 100 / me->query("max_qi")) < 40) ||
    ((me->query("eff_jing") * 100 / me->query("max_jing")) < 40)) {
    if (test_zouhuorumo(me) && (userp(me))) return notify_fail("");
    return notify_fail(YEL "你的体力和精力不够，强练侠客神剑可能走火入魔！" NOR);
  }
  if ((int)me->query("qi") < 30
    || (int)me->query("neili") < 3)
    return notify_fail("你的内力或气不够，没有办法练习侠客神剑。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -3);
  name = query_skill_name(me->query_skill("xiake-shenjian", 1));
  message_vision(HIW "$N按照剑法开始练习‘" + name + "’这一招的技巧。\n" NOR, me);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "xiake-shenjian/" + action;
}
