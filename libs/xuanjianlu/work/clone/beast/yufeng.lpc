// yufeng.c 玉蜂
// oky 2001/10/29

#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIW "玉蜂" NOR, ({ "yu feng", "feng", "bee" }));
  set("race", "昆虫");
  set("subrace", "飞虫");
  set("age", 5);
  set("long", "这是一只玉色的蜜蜂，个头比普通蜜蜂大得多，\n"
    "翅膀上被人用尖针刺有字。\n\n目前翅膀上没有什么字。\n");

  set("str", 40);
  set("dex", 50);
  set("combat_exp", 500);

  set("limbs", ({ "头部", "身体", "翅膀", "尾巴" }));
  set("verbs", ({ "bite", "poke" }));

  set_temp("apply/attack", 35);
  set_temp("apply/armor", 25);

  set("chat_chance", 2);
  set("chat_msg", ({
    (: this_object(), "random_move" :),
    "玉蜂在你头顶转了一圈，似乎发现这不是可采蜜的地方，就嗡嗡嗡地飞走了。\n",
    "玉蜂围绕着鲜花飞飞停停，似乎也不着重在采蜜上。\n",
  }));

  setup();
}

void init() {
  object ob;
  ::init();
  add_action("do_ci", "ci");
  /*
           if (this_player()->query("family/family_name") != "古墓派") {
                random(ob->query_kar() + ob->query_per()) < 30) {

                      remove_call_out("kill_ob");
                      call_out("kill_ob", 1, ob);
                kill_ob(this_player());
        }
*/
}

void unconcious() {
  write("玉蜂嗦地一下嗡嗡地飞走了。\n");
  destruct(this_object());
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  victim->apply_condition("insect_poison", 10 + me->query("insect_poison") +
    victim->query_condition("insect_poison"));
  if (me->query("bite_busy")) victim->start_busy(2);
}

int do_ci(string arg) {
  object me = this_player();
  string word, item;
  object ob, weapon;
  object obj = this_object();
  mapping my;
  int n = me->query("neili");
  int i;

  my = me->query_entire_dbase();
  i = strlen(word);

  if (!arg || arg == "") return notify_fail("你要在哪刺字？\n");

  if (sscanf(arg, "%s %s", item, word) != 2)
    return notify_fail("你要刺什么字？\n");

  if (item != "feng" && item != "yu feng" && item != "bee") return 0;

  if (this_object()->query("quest/id", 1) != 0)
    return notify_fail("这只玉蜂已经被人刺过字了，是" + this_object()->query("quest/name") + "(" + this_object()->query("quest/id") + ")所刺。\n");

  if ((strlen(word) < 2) || (strlen(word) > 8) || i % 2) {
    return notify_fail("刺的字必须是中文字体，并且是1到4个中文字。\n");
  }

  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你不能在玉蜂翅膀上刺字。\n");
  if (random(me->query_skill("yunu-xinjing", 1)) < 20
    // || me->query_skill("gumu-shenfa",1) < 20
    || me->query_skill("dodge", 1) < 50
    || me->query_skill("force", 1) < 50
    || (my["dex"] < 10)) {
    kill_ob(me);
    return 1;
  }

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword") {
    message_vision(
      "$N站起身来，运用轻功，深吸一口气，就直飞玉蜂。\n", me);
    message_vision(
      "结果什么也没发生。看来刺字的方法并不对，$N自己反而受伤。\n", me);
    me->set("neili", n - 200);
    me->receive_damage("qi", 200, "体力透支过度死了");
  } else {
    if (n >= 200) {
      message_vision("\n\n$N左手举起手中的利器，直飞向空中，片刻间玉蜂翅膀上出现了几个小字。\n\n",
        me,);
      this_object()->set("long", "这是一只玉色的蜜蜂，个头比普通蜜蜂大得多，\n"
        "翅膀上被人用尖针刺有字。\n\n目前翅膀上刻有「 " + word + " 」字。\n");
      this_object()->set("quest/id", me->query("id"));
      this_object()->set("quest/name", me->query("name"));
      return 1;
    } else {
      message_vision(
        "$N举剑，运足内力刺向玉蜂，锵的一声，结果剑断人伤，原来内力不足！\n", me);
      me->set("neili", 0);
      me->receive_damage("qi", 200, "体力透支过度死了");
      destruct(weapon);
    }

    return 1;
  }

  return 1;

}
