//太监衣服，因为Quest需要，将修改player id name log ,remove 以后恢复。物品十分容易损坏。


#include <ansi.h>

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("太监衣", ({ "taijian cloth","cloth" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("armor_prop/armor", 1);
        }
        setup();
}


void init()
{
        add_action("do_wear", "wear");
        add_action("do_remove", "remove");
}

int do_wear(string arg)
{
        if (!arg || (arg != "cloth" && arg != "taijian cloth" && arg != "all") ) return 0;

        this_player()->set_temp("apply/name",  ({"小太监"}));
        this_player()->set_temp("apply/short", ({"小太监(Xiao taijian)"}));
        this_player()->set_temp("apply/long",  ({"是一位小太监，忙忙碌碌的不知道要去做什么？/n"}));

        return 0;
}

int do_remove(string arg)
{
        if (!arg || (arg != "cloth" && arg != "taijian cloth" && arg != "all") ) return 0;

        this_player()->delete_temp("apply/name");
        this_player()->delete_temp("apply/short");
        this_player()->delete_temp("apply/long");
      

        return 0;
}


