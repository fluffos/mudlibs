// jinsi-shoutao.c 金丝手套

#include <armor.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit WRISTS;

void create() {
  set_name(HIY "金丝手套" NOR, ({ "jinsi shoutao", "shoutao" }));
  set("long", "这双手套是以极细极韧的白金丝织成，是林朝英传下的利器，虽然柔薄，却非宝刀利刃所能损伤。\n");
  set("weight", 300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("value", 50000);
    set("material", "gold");
    set("armor_prop/armor", 30);
    set("female_only", 1);
  }
  setup();
  ::create();
}
