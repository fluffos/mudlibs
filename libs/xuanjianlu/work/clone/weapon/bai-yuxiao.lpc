#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(HIW "洞箫" NOR, ({ "dong xiao", "xiao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 400);
    set_weight(5000);
    set("material", "bamboo");
    set("long", "这是一柄用上好的白玉，精工制成的玉箫。\n");
    set("wield_msg", "$N抽出一把$n，握在手中。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }
  init_sword(40);
  setup();
}
