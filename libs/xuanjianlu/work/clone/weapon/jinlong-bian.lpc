// jinglong-bian.c 金龙鞭 
// Xuanyuan

#include <weapon.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit WHIP;

void create() {
  set_name(HIY "金龙鞭" NOR, ({ "jinlong bian", "bian", "whip", "jinlong" }));
  set_weight(700);
  set_color(YEL);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 7000000);
    set("rigidity", 100000);
    set("material", "leather");
    set("long", "这是一条金色软鞭，鞭上珠光宝气，镶满了宝石、金刚钻、白玉之属。\n");
    set("wield_msg", "$N「唰」的一声从腰后抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n别回腰后。\n");
  }
  init_whip(70);
  setup();
  ::create();
}
