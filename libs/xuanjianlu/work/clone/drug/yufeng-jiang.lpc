//Cracked by Kafei
// yufeng-jiang.c  玉蜂浆
// Modified by Xuanyuan
#include <ansi.h>
inherit PILL;

void setup() {}

int cure_ob(string);
void create() {
  set_name(HIY "玉蜂浆" NOR, ({ "yufeng jiang", "jiang" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "瓶");
    set("long",
      "古墓派常用的疗伤灵药。取玉蜂之蜜酿成，色泽金黄，微微发出淡淡\n"
      "的清香，可解蜂毒，亦对水冲服，效果尤佳。\n");
    set("value", 10000);
    set("medicine", 1);
  }
  setup();
}

int cure_ob(object me) {
  message_vision(HIY "$N服下一包" + query("name") + HIY "，只觉通体舒泰，伤势大有好转。\n" NOR, me);

  if ((int)me->query("eff_qi") < (int)me->query("max_qi"))
    me->receive_curing("qi", 50 + random(100));

  if ((int)me->query_condition("insect_poison") > 0)
    me->apply_condition("insect_poison", 0);

  if (me->query_skill_mapped("force") == "yunu-xinjing") {
    me->add("max_jingli", 2);
    me->add("eff_jingli", 2);
  }
  destruct(this_object());
  return 1;
}

void init() {
  add_action("do_pour", "pour");
}

int effect_in_liquid(object ob) {
  tell_object(this_player(), HIY "你只觉得体内一股清新之气缓缓流动，精神焕发，大为受用。\n" NOR);
  if ((int)this_player()->query("eff_qi") < (int)this_player()->query("max_qi")) {
    this_player()->receive_curing("qi", 50 + random(100));
  }
  if ((int)this_player()->query("eff_jing") < (int)this_player()->query("max_jing")) {
    this_player()->receive_curing("jing", 50 + random(100));
  }
  this_player()->receive_heal("qi", 50 + random(50));
  this_player()->add("jingli", 200 + random(300));
  if ((int)this_player()->query_condition("insect_poison") > 10)
    this_player()->apply_condition("insect_poison", -10);
  return 0;
}
