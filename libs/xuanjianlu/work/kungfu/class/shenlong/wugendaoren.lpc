//无根道人
inherit NPC;
inherit F_MASTER;
#include "/kungfu/class/shenlong/auto_perform.h"
#include <ansi.h>
int do_incense();
int auto_perform();
int ask_tisheng();
int ask_for_join();
int ask_ling();
void create()
{
	set_name("无根道人", ({ "wugen daoren", "wugen" }));
            set_color("$HIW$");
	set("title", "神龙教五龙使");
	set("nickname", "赤龙使");
	set("class", "taoism");
	set("long", 
                "黑须道人，可是脸上充满了激愤之情。\n");
	set("gender", "男性");
	set("age", 43);
	set("attitude", "peaceful");
	set("shen", -50000);
	set("str", 30);
	set("int", 10);
	set("con", 30);
	set("dex", 20);
	
	set("max_qi", 6000);
	set("max_jing", 6000);
	set("neili", 2000);
	set("max_neili", 2000);
	set("jiali", 0);
	set("combat_exp", 800000);
	set("score", 10000);
                  set("chat_chance_combat", 90);
                  set("chat_msg_combat", ({
                         (: auto_perform :),
                  }) );

	set_skill("force", 170);
  	set_skill("dulong-dafa", 170);
	set_skill("dodge", 170);
	set_skill("lingshe-shenfa", 170);
	set_skill("poison", 170);
	set_skill("huanying-zhi", 170);
       set_skill("taiji-dao", 170);
	set_skill("blade", 170);
	set_skill("kick", 170);
       set_skill("medicine", 170);

	set_skill("jueming-tui", 170);
	set_skill("finger", 170);
  	set_skill("literate", 110);

	map_skill("force", "dulong-dafa");
	map_skill("dodge", "lingshe-shenfa");
       map_skill("blade", "taiji-dao");
	map_skill("kick", "jueming-tui");
	map_skill("finger", "huanying-zhi");
	map_skill("parry", "taiji-dao");


	prepare_skill("kick", "jueming-tui");
	prepare_skill("finger", "huanying-zhi");

	create_family("神龙教", 2, "赤龙使");
        set("inquiry", ([
                "神龙岛" : "神龙岛又叫蛇岛。",
                "五龙令" : "五龙令乃是教主所赠，犹如教主亲临，跟皇帝的圣旨一样。",
                "赤龙令" : (: ask_ling :),
                "提升" : (: ask_tisheng :),
                "加入"  : (: ask_for_join :),

        ]));            

	setup();
            carry_object("/clone/misc/cloth")->wear();
            carry_object("/d/shenlong/obj/yanlindao")->wield();

}
void init()
{
	::init();
        add_action("do_kneel", "fashi");
        add_action("do_kneel", "发誓");

}

void attempt_apprentice(object ob)
{
                  mapping fam;

if( !mapp(fam = ob->query("family")) || fam["family_name"] != "神龙教")
        {
                command("shake " + ob->query("id"));
                command ("say " + RANK_D->query_respect(ob) +
                        "去找扬州的胖瘦尊者吧。");
                return;
        }
        command("recruit " + ob->query("id"));
        ob->set("title","神龙教弟子");

        return;
}



void destroy_it(object ob)
{
	if(ob)
	destruct (ob);
}

string ask_tisheng()
{
	object ob,who=this_player();
        mapping fam;
	if (!(fam = this_player()->query("family")) || fam["family_name"] !="神龙教"){
		command("?");
	}

	if (who->query("shenlong/rank")>=1)
	{
		if (who->query("shenlong/gonglao")>=20000 && who->query("shenlong/rank")<2)
		{
			who->set("shenlong/rank",2);
			command("nod");
			return RANK_D->query_respect(who)+"为我教赴汤蹈火，功劳显赫，教主传话提升你为我教香主。";
		}
		if (who->query("shenlong/gonglao")>=50000 && who->query("shenlong/rank")<3)
		{
			who->set("shenlong/rank",3);
			command("congra");
			return RANK_D->query_respect(who)+"做事小心谨慎，深得教主欢心，教主传话提升你为我教护法。";
		}
	}
	
	if (who->query("shenlong/rank")==3)
	{
        	command("hehe");
		return RANK_D->query_respect(who)+"目前为护法，再提可能就是教主了。";
	}
        command("shrug");
	return RANK_D->query_respect(who)+"为本教做的还不够，不能提升 。";
}

string ask_for_join()
{
        object me;

        me = this_player();

	if( me->query("shenlong/rank") >= 1 )
                return "哦？你不是已经有头衔了吗？\n";

	if( me->query("family/family_name") != "神龙教"	&& me->query("combat_exp") >= 100000 ) 
                return "这位" +RANK_D->query_respect(this_player()) + "是"
                        +me->query("family/family_name")+"高手，难道是加入神龙教做卧底的？\n";

        if( (string)me->query("gender") == "无性" )
        return "不男不女，看见我就讨厌，给我滚开。\n";

        me->set_temp("pending/join_shenlong", 1);
        return "嗯，既然你想加入我神龙教，就要发誓(fashi)永远效忠神龙！。\n"
;
}
int do_kneel()
{
	object me = this_player();
	if( !me->query_temp("pending/join_shenlong") )
                return 0;

        message_vision(
                "恭喜$N加入神龙教!成为神龙教中的一员！”。\n\n"
,
        me, this_object() );
        command("nod");
        me->delete_temp("pending/join_shenlong");
        me->set("shenlong/rank", 1);
        me->set("class","shenlong_join");
	 return 1;
}

string ask_ling()
{
        string title;
        mapping myfam;
        object me,ling;
        me = this_player();


        myfam = (mapping)me->query("family");

        if ( !myfam || myfam["family_name"] != "神龙教" )
                return "咱们豪无渊源，你问这事干嘛？\n";

	 if( me->query_temp("shenlong/ling"))
                return "哦？你不是已经有令了么？\n";

	 if( !me->query_temp("shenlong/askling"))
                return "没得到教主许可，我无法给你五龙令！\n";

        title = HIR"神龙教赤龙门副使"NOR + " " + me->query("name") + 
              "(" + capitalize(me->query("id")) + ")";;

        me->set_temp("apply/short", ({title}));
        me->delete_temp("shenlong/askling");
        me->set_temp("shenlong/ling" ,1);
        ling = new("/d/shenlong/obj/cling");
        ling->move(this_player());
        message_vision("无根道人给$n一面$N。\n"NOR,ling, me);
	 return "既然教主已经许可，我也就没什么说的了。";
}

