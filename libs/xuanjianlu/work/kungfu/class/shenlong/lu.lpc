// Pingguo
//神龙教大夫
// Edit: (增加请教指令，用来增加medicine超过400以后，要求medicine200级以上，dulong-dafa 200级以上。)
// Edit Date: (2003.5.1)
// Editer: (Eternal)
#include <ansi.h>
inherit NPC;
int ask_dihuang();
int ask_yishu();
int ask_wangshu();
int ask_sunsimao();
int ask_cut();
int ask_poison();
int ask_sheyao();
int ask_huang();

void create() {
  set_name("陆高轩", ({ "lu gaoxuan", "lu" }));
  set("long",
    "四十来岁年纪，文士打扮，神情和蔼可亲。\n");
  set("gender", "男性");
  set("age", 41);
  set("title", "神龙教大夫");
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 28);
  set("int", 25);
  set("con", 26);
  set("dex", 26);
  set("max_qi", 5000);
  set("max_jing", 5000);
  set("neili", 5000);
  set("max_neili", 5000);
  set("jingli", 5000);
  set("max_jingli", 5000);
  set("jiali", 20);
  set("combat_exp", 200000);
  set("score", 50000);
  set("shen", -50000);


  set_skill("force", 100);
  set_skill("dulong-dafa", 100);
  set_skill("dodge", 100);
  set_skill("lingshe-shenfa", 100);
  set_skill("strike", 100);
  set_skill("huagu-mianzhang", 100);
  set_skill("parry", 100);


  set_skill("literate", 20);


  map_skill("force", "dulong-dafa");
  map_skill("dodge", "lingshe-shenfa");
  map_skill("strike", "huagu-mianzhang");
  map_skill("parry", "huagu-mianzhang");


  prepare_skill("strike", "huagu-mianzhang");

  create_family("神龙教", 2, "弟子");
  set("inquiry", ([
    "医书": (: ask_yishu :),
    "黄帝内经": (: ask_dihuang :),
    "王叔和脉经": (: ask_wangshu :),
    "孙思邈千金方": (: ask_sunsimao :),
    "自宫": (: ask_cut :),
    "解毒": (: ask_poison :),
    "蛇药": (: ask_sheyao :),
    "雄黄": (: ask_huang :),

  ]));

  setup();
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("/clone/misc/cloth")->wear();

}
void init()

{
  add_action("do_qingjiao", "qingjiao");
  add_action("do_yes", "愿意");
  add_action("do_no", "不愿意");


}


int ask_poison() {

  object me = this_player();
  object book;
  mapping fam;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "神龙教") {
    command("?");
    return 0;
  }

  if (me->query_temp("poison_drug")) {
    command("slap " + me->query("id"));
    command("say 不是跟你说了吗？这个药不能多吃！");

    return 1;

  }

  command("say “我这里有种药，正好能帮你驱除体内毒素！”");
  command("say “不过这个药嘛，可能对你的功力有损失……切记不可多吃。”");
  message_vision(HIR "陆大夫将一些红色的药丸放入$N的嘴里。\n" NOR, me);
  me->set("body_poison", me->query_skill("poison", 1) + 5);
  me->add("max_neili", -5);
  tell_object(me, HIG "也许是药力发挥作用，你四肢有点麻木，但体内的毒素正随着你的内力减少了。\n" NOR);
  me->start_busy(5);
  me->set_temp("poison_drug", 1);

  return 1;

}

int ask_yishu() {

  object me = this_player();
  object book;
  mapping fam;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "神龙教") {
    command("?");
    return 0;
  }

  command("say “我这里有黄帝内经、王叔和脉经、孙思邈千金方，不知道阁下想读哪一本呢？！”");

  return 1;

}


int ask_dihuang() {

  object me = this_player();
  object book;
  mapping fam;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "神龙教") {
    command("?");
    return 0;
  }

  if (me->query_temp("mark/陆") == 1) {
    command("say 你的书呢？怎么还不去仔细研究？");
    return 1;
  }
  command("say “这本黄帝内经你拿回去自己阅读！”");
  book = new("/d/shenlong/obj/book2.lpc");
  me->set_temp("mark/陆", 1);
  if (!present("medicine book", me)) book->move(me);

  return 1;

}

