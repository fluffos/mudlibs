string ask_huang() {

  mapping myfam;
  object ob, me = this_player();
  myfam = (mapping)me->query("family");

  if (!myfam || myfam["family_name"] != "神龙教")
    return "咱们豪无渊源，你问这事干嘛？\n";
  if (present("xionghuang", me))
    return RANK_D->query_respect(this_player()) + "你现在身上不是有雄黄么?";

  if (time() < me->query("huang/time") + 1800)
    return RANK_D->query_respect(me) + "你不是刚要过雄黄，怎么又来要了？过段时间再来吧。";

  me->set("huang/time", time());
  ob = new("/d/shenlong/obj/xionghuang");
  ob->move(me);
  message_vision("陆高轩给$n一块$N。\n" NOR, ob, me);
  return "好吧，这块雄黄你就拿去吧。";
}

string ask_sheyao() {
  mapping myfam;
  object me = this_player();
  myfam = (mapping)me->query("family");

  if (!myfam || myfam["family_name"] != "神龙教")
    return "咱们豪无渊源，你问这事干嘛？\n";

  if (!me->query_condition("snake_poison"))
    return "你好好的，要蛇药干吗？";

  message_vision("$N对$n说道：把嘴张开。\n", this_object(), me);
  message_vision("$N把嘴张得大大的。\n", me);
  message_vision("只见$N把一包蛇药全倒进$n嘴里\n", this_object(), me);
  message_vision("$N乐不可支地对$n说道：多谢陆大夫！\n", me, this_object()
  );

  call_out("lucure", 1 + random(2), me);
  return "下次小心了。";
}

void lucure(object me) {
  message_vision("$N吐出一口黑血，脸色看起来红润多了。\n", me);
  me->clear_condition("snake_poison");
}

int do_qingjiao(string arg) {

  object me, obj;
  string event = NATURE_D->outdoor_room_event();
  me = this_player();
  if (!arg || arg == "") return 0;
  if (arg != "medicine")
    return notify_fail("请输入qingjiao medicine。\n");

  if ((int)me->query_skill("dulong-dafa", 1) < 200)
    return notify_fail("你的毒龙大法修为未到，无法领悟高深的药理学。\n");
  if ((int)me->query_skill("medicine", 1) < 200)
    return notify_fail("你的药理学修为未到，无法领悟高深的药理学。\n");


  if (me->query("jing") < 1000)
    return notify_fail("你现在精神不佳，无法请教！\n");

  if ((int)me->query("potential") <= 20)
    return notify_fail("你的潜能不足，无法请教！\n");

  if (me->query("family/family_name") != "神龙教")
    return notify_fail("只有神龙教弟子才能请教！\n");

  if (me->is_busy()) {
    write("陆高轩说道：等" + RANK_D->query_respect(me) + "不忙了，再来找我请教吧。\n");
    return 1;
  }
  write("你向陆高轩请教药理学的疑问。\n");
  me->add("potential", -20);
  me->add("jing", -1000);
  me->improve_skill(arg, 6000);
  me->start_busy(3);
  write("你听了陆高轩的指点，似乎对药理学有所了解！\n");
  return 1;


}
int ask_cut() {

  object me = this_player();
  object book;
  mapping fam;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "神龙教") {
    command("? " + me->query("id"));
    return 1;
  }

  if (me->query("gender") != "无性") {
    command("hmm " + me->query("id"));
    return 1;
  }


  if (me->query("recut")) {
    command("hmm " + me->query("id"));
    command("say 不是已经给你治好了么？");

    return 1;

  }
  command("say “嗯，我看你自宫之时手术做的不是很彻底，应该还有办法给你修复一下。”");
  command("say “不过恐怕修复以后，你就不再是男儿身了，而且你的属性会降低，考虑清楚了再告诉我。（输入愿意）”");
  me->set_temp("YESorNO", 1);
  return 1;
}

int do_yes() {
  object me = this_player();
  if (me->query_temp("YESorNO") != 1) {
    return 1;
  }
  if (me->query("shenlong/gonglao") < 100000) {
    command("say “你的功劳太低了。”");

    return 1;
  }
  command("chat @CN又少了一个太监，多了一个女人。");

  message_vision(
    "$n给$N吃下一颗药丸。\n\n"
    "$n嘿嘿奸笑两声……\n\n"
    "$N慢慢昏了过去……\n\n",
    this_player(), this_object());

  me->set("gender", "女性");
  me->add("shenlong/gonglao", -100000);
  me->add("dex", -1);
  me->delete_temp("YESorNO");
  me->set("recut", 1);
  me->delete_skill("pixie-jianfa");
  me->unconcious();
  return 1;
}
