// 小童
inherit NPC;
#include <ansi.h>
int do_drug();
int auto_perform();
void create() {
  set_name("陆小小", ({ "lu xiaoxiao", "xiaoxiao" }));
  set("nickname", "陆高轩爱女");
  set("long",
    "她就是陆高轩的女儿陆小小。\n"
    "她年纪虽小，但容颜俏丽，十足的美人胚子。\n");
  set("gender", "女性");
  set("age", 12);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 18);
  set("int", 28);
  set("con", 20);
  set("dex", 24);

  set("max_qi", 300);
  set("max_jing", 300);
  set("neili", 500);
  set("max_neili", 500);
  set("jiali", 10);
  set("combat_exp", 100);
  set("score", 10000);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));
  set("inquiry", ([
    "卖药": (: do_drug :),
  ]));



  create_family("神龙教", 3, "弟子");

  setup();

  carry_object("/clone/misc/cloth")->wear();

}

int do_drug() {
  if (this_player()->query("family/family_name") != "神龙教") {
    say("陆小小说道：“你还是找爹爹要吧，我可不能乱给你拿。”\n");
    return 1;
  }
  if (this_player()->query("shenlongdrug") == "茯苓" ||
    this_player()->query("shenlongdrug") == "何首乌" ||
    this_player()->query("shenlongdrug") == "菊梗" ||
    this_player()->query("shenlongdrug") == "藏红花" ||
    this_player()->query("shenlongdrug") == "生地" ||
    this_player()->query("shenlongdrug") == "枸枳子" ||
    this_player()->query("shenlongdrug") == "豹胎" ||
    this_player()->query("shenlongdrug") == "巴豆" ||
    this_player()->query("shenlongdrug") == "金银花" ||
    this_player()->query("shenlongdrug") == "鲨胆") {
    say("陆小小说道：你不是帮我去买" + this_player()->query("shenlongdrug")
      + "了吗？\n");
    return 1;
  }
  switch (random(10)) {

    case 0:
      say("陆小小说道：爹爹让我去泉州帮他找点茯苓，我实在不想去了，你帮我买五钱吧。\n");
      this_player()->set("shenlongdrug", "茯苓");
      break;
    case 1:
      say("陆小小说道：爹爹让我去泉州帮他找点何首乌，我实在不想去了，你帮我买五支吧。\n");
      this_player()->set("shenlongdrug", "何首乌");
      break;
    case 2:
      say("陆小小说道：爹爹让我去泉州帮他找点菊梗，我实在不想去了，你帮我买五钱吧。\n");
      this_player()->set("shenlongdrug", "菊梗");
      break;
    case 3:
      say("陆小小说道：爹爹让我去泉州帮他找点藏红花，我实在不想去了，你帮我买五钱吧。\n");
      this_player()->set("shenlongdrug", "藏红花");
      break;
    case 4:
      say("陆小小说道：爹爹让我去泉州帮他找点生地，我实在不想去了，你帮我买五钱吧。\n");
      this_player()->set("shenlongdrug", "生地");
      break;
    case 5:
      say("陆小小说道：爹爹让我去泉州帮他找点枸枳子，我实在不想去了，你帮我买五包吧。\n");
      this_player()->set("shenlongdrug", "枸枳子");
      break;
    case 6:
      say("陆小小说道：爹爹让我去泉州帮他找点豹胎，我实在不想去了，你帮我买五只吧。\n");
      this_player()->set("shenlongdrug", "豹胎");
      break;
    case 7:
      say("陆小小说道：俺爹爹让我去泉州帮他找点巴豆，我实在不想去了，你帮我买五钱吧。\n");
      this_player()->set("shenlongdrug", "巴豆");
      break;
    case 8:
      say("陆小小说道：爹爹让我去泉州帮他找点金银花，我实在不想去了，你帮我买五钱吧。\n");
      this_player()->set("shenlongdrug", "金银花");
      break;
    case 9:
      say("陆小小说道：爹爹让我去泉州帮他找点鲨胆，我实在不想去了，你帮我买五粒吧。\n");
      this_player()->set("shenlongdrug", "鲨胆");
      break;


  }
  return 1;
}

int accept_object(object who, object ob) {
  object yao1, yao2, yao3, yao4, yao5, obj;
  object me = this_object();

  if (userp(ob)) {
    command("shake");
    command("say 给我个大活人干嘛啊？");
    return 1;
  }
  if ((string)ob->query("id") == "fuling" &&
    this_player()->query("shenlongdrug") == "茯苓"
    && !userp(ob)) {
    this_player()->add("luxiaoxiao", 1);
    call_out("destroy_it", 1, ob);
    if ((int)this_player()->query("luxiaoxiao") >= 5) {
      command("say 辛苦这位" + RANK_D->query_respect(who) + "了。");
      command("say 我这里有些药，你帮我去卖了吧。");
      message_vision(HIW "陆小小转身从药架上拿了一些药品和一个药瓶。\n" NOR, me);
      yao1 = new("/d/shenlong/obj/drug/jz-dan");
      yao2 = new("/d/shenlong/obj/drug/ql-san");
      yao3 = new("/d/shenlong/obj/drug/dm-san");
      yao4 = new("/d/shenlong/obj/drug/yc-wan");
      yao5 = new("/d/shenlong/obj/drug/zj-fen");
      obj = new("/d/shenlong/obj/drug/yaoping");
      yao1->move(me);
      yao2->move(me);
      yao3->move(me);
      yao4->move(me);
      yao5->move(me);
      obj->move(me);
      command("put all in ping");
      message_vision("陆小小给$N一个药瓶。\n" NOR, this_player());
      obj->move(this_player());
      this_player()->delete("luxiaoxiao");
      this_player()->delete("shenlongdrug");
    }
    return 1;
  }
  if ((string)ob->query("id") == "heshouwu" &&
    this_player()->query("shenlongdrug") == "何首乌"
    && !userp(ob)) {
    this_player()->add("luxiaoxiao", 1);
