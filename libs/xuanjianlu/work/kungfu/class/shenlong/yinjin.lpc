//殷  锦
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
#include "/kungfu/class/shenlong/auto_perform.h"
int do_incense();
int auto_perform();
int ask_ling();
int ask_playerkill();
void create()
{
	set_name("殷锦", ({ "yin jin", "yin" }));
            set_color("$HIW$");
	set("title", "神龙教五龙使");
	set("nickname", "黄龙使");
	set("long", 
                "细眼尖脸，八成是个马屁精。\n");
	set("gender", "男性");
	set("age", 43);
	set("attitude", "peaceful");
	set("shen", -500000);
	set("str", 30);
	set("int", 10);
	set("con", 30);
	set("dex", 20);
	set("shenlong/jueming", 2);
	set("max_qi", 9000);
	set("max_jing", 9000);
	set("neili", 7000);
	set("max_neili", 7000);
	set("jiali", 200);
	set("combat_exp", 2800000);
	set("score", 10000);
                  set("chat_chance_combat", 90);
                  set("chat_msg_combat", ({
                         (: auto_perform :),
                  }) );


	set_skill("force", 300);
  	set_skill("dulong-dafa", 300);
	set_skill("dodge", 300);
	set_skill("lingshe-shenfa", 300);
	set_skill("poison", 300);
	set_skill("huanying-zhi", 300);
	set_skill("sword", 300);
	set_skill("strike", 300);
       set_skill("medicine", 300);
	set_skill("kick", 300);
       set_skill("jueming-tui", 300);

	set_skill("huagu-mianzhang", 300);
	set_skill("finger", 300);
  	set_skill("literate", 110);

	map_skill("force", "dulong-dafa");
	map_skill("dodge", "lingshe-shenfa");
            map_skill("sword", "huanying-zhi");
	map_skill("strike", "huagu-mianzhang");
	map_skill("finger", "huanying-zhi");
	map_skill("parry", "huagu-mianzhang");
	map_skill("kick", "jueming-tui");

	prepare_skill("kick", "jueming-tui");
	prepare_skill("strike", "huagu-mianzhang");

        set("chat_msg", ({
                (: random_move :)
        }) );
	create_family("神龙教", 2, "黄龙使");
            
       set("inquiry", ([
                "洪安通" : "这三个字是你说的吗？",
                "杀人" : (: ask_playerkill :),
                "追杀" : (: ask_playerkill :),
                "铲除" : (: ask_playerkill :),
                "洪教主" : "洪教主仙福永享，寿与天齐，洪教主神目如电，烛照四方。",
                "五龙令" : "五龙令乃是教主所赠，犹如教主亲临，跟皇帝的圣旨一样。",
                "pk" : "杀人？哪里有杀人的？杀人了！！救命啊！！。",
                "......" : "......你想吃芝麻烧饼了？",
                "无聊" : "你很无聊么？很无聊教你个指令很好玩的。chat* slap 你自己的英文名字。",
                "!!!" : "!@#$%^&*())(*&^%$#@!”",
                "黄龙令" : (: ask_ling :),

        ]));
	setup();
            carry_object("/clone/misc/cloth")->wear();

}


void attempt_apprentice(object ob)
{

                command("shake " + ob->query("id"));

        return;
}

void destroy_it(object ob)
{
	if(ob)
	destruct (ob);
}

string ask_playerkill()
{
        object me; 
        mapping myfam;
        me = this_player();
        myfam = (mapping)me->query("family");

        if ( !myfam || myfam["family_name"] != "神龙教" )
                return "咱们豪无渊源，你问这事干嘛？\n";

        say("殷锦说道：哈哈，杀人？。\n");
        say("殷锦说道：你说吧，杀人我最在行，不过要我杀人，可是要付出代价的你考虑清楚。\n");
        say("殷锦说道：不论此人在天涯海角，我一定杀了他让你出气。\n");
        me->set_temp("shenlong/playerkill", 1);
        return "请输入：wantkill 对方的英文名字。";


}

string ask_ling()
{
        string title;
        mapping myfam;
        object me,ling;
        me = this_player();


        myfam = (mapping)me->query("family");

        if ( !myfam || myfam["family_name"] != "神龙教" )
                return "咱们豪无渊源，你问这事干嘛？\n";

	 if( me->query_temp("shenlong/ling"))
                return "哦？你不是已经有令了么？\n";

	 if( !me->query_temp("shenlong/askling"))
                return "没得到教主许可，我无法给你五龙令！\n";

        title = HIY"神龙教黄龙门副使"NOR + " " + me->query("name") + 
              "(" + capitalize(me->query("id")) + ")";;

        me->set_temp("apply/short", ({title}));
        me->delete_temp("shenlong/askling");
        me->set_temp("shenlong/ling" ,1);
        ling = new("/d/shenlong/obj/yling");
        ling->move(this_player());
        message_vision("殷锦给$n一面$N。\n"NOR,ling, me);
	 return "既然教主已经许可，我也就没什么说的了。";
}

void init()
{
        object ob = this_player();
        mapping fam;
        ::init();
        add_action("do_wantkill", "wantkill");


}

int do_wantkill(string arg)
{
        object npc, ob, where, env, me = this_player();
        int exp, lvl;
        string region;
        

        if(me->query("shenlong/quanli")<300)
                return notify_fail("你的权利太小，无法让殷锦帮你杀人。\n");

        if( !living(this_object()) )
                return notify_fail("嗯....你得先把殷锦弄醒再说。\n");

        if( this_object()->is_busy() )
                return notify_fail("殷锦说道：没看见我忙着呢。\n");

        if (!arg) return notify_fail("你要杀谁？\n");

        if( !(ob = find_player(arg)) )
        if( !(ob = find_living(arg)) )
                return notify_fail("殷锦说道：有这个人么？\n");
        if (ob->is_ghost())
                return notify_fail("殷锦说：他已经受到报应死了。\n");
                
        if( ob == me )
                return notify_fail("杀自己？吃多了你？。\n");

        if (ob->query("race") != "人类" )
       	return notify_fail("你只能杀人。\n");

        if( !userp(ob) )
                return notify_fail("目前只提供杀玩家活动。\n");
                
        if( ob == this_object() )
                return notify_fail("要殷锦杀殷锦？没道理吧。\n");

                write("\n你悄声对殷锦说道：麻烦黄龙使替我杀了"+ob->name()+"。\n\n");
        tell_room( environment(me), "\n"+me->name() + "低声对殷锦说了些话。\n", ({ me, this_object() }) );

        message_vision(HIW"殷锦嘿嘿奸笑两声。\n殷锦说到：“既然如此，我这就派人去。”\n\n"NOR, me);

        npc = new("/d/shenlong/npc/pknpc");
        exp = ob->query("combat_exp");
        lvl = pow(10*exp, 0.333334);

        npc->set("combat_exp", exp*2/3 + random(exp/1000) );
        npc->set("rank_info/rude", "神龙教的走狗");
	 npc->set("max_qi", ob->query("max_qi"));
	 npc->set("eff_qi", ob->query("max_qi"));
	 npc->set("max_jing", ob->query("max_jing"));
	 npc->set("eff_jing", ob->query("max_jing"));
	 npc->set("qi", npc->query("max_qi"));
	 npc->set("jing", npc->query("max_jing"));
	 npc->set("jiali", ob->query("jiali"));
	 npc->set("max_neili", ob->query("max_neili"));
	 npc->set("max_jingli", ob->query("max_jingli"));
	 npc->set("neili", npc->query("max_neili"));
	 npc->set("jingli", npc->query("max_jingli"));

	 npc->set_skill("dulong-dafa", lvl);
	 npc->set_skill("huagu-mianzhang", lvl);
	 npc->set_skill("jueming-tui", lvl);
	 npc->set_skill("lingshe-shenfa", lvl);
	 npc->set_skill("medicine", lvl);
	 npc->set_skill("poison", lvl);

	 npc->set_skill("force", lvl);
	 npc->set_skill("strike", lvl);
	 npc->set_skill("kick", lvl);
	 npc->set_skill("dodge", lvl);
 	 npc->set_skill("parry", lvl);

	 npc->map_skill("force", "dulong-dafa");
	 npc->map_skill("strike", "huagu-mianzhang");
	 npc->map_skill("dodge", "lingshe-shenfa");
	 npc->map_skill("parry", "huagu-mianzhang");
	 npc->map_skill("kick", "jueming-tui");

	 npc->prepare_skill("strike", "huagu-mianzhang");
	 npc->prepare_skill("kick", "jueming-tui");

        npc->move(environment(ob));
        message_vision(BLU "突然一个黑影拦住$n的去路！\n" NOR, npc, ob);
        message_vision(HIR "$N对$n说道："+RANK_D->query_respect(ob)+"你得罪了我教中人，今日我特来取你性命！\n" NOR, npc, ob);
	 npc->kill_ob(ob);
	 npc->start_check(ob);
	 npc->set_leader(ob);
        ob->kill_ob(npc);
        me->add("shenlong/quanli",-300);

        if( !(where = environment(ob)) ) {
                command("hmm");
                return notify_fail("殷锦告诉你：这个人现在无法找到。\n");
                }
        if( !wizardp(me) && wizardp(ob) ) {
                command("hmm");
                return notify_fail("殷锦说道：我还没这个本事。\n");
                }
        if( strsrch(file_name(where), "/d/") != 0 ) {
                command("hmm");
                return notify_fail("殷锦告诉你：这个人现在无法找到。\n");
                }

        env = environment(me);

  
        command("rumor 神龙教黄龙使派遣"+npc->query("name")+"受命从现在开始追杀"+ob->query("name")+"至死方休！");
        return 1;
}

