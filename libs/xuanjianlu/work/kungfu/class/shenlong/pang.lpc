//Pingguo
//胖头陀 
inherit NPC;
#include "pang_perform.h"
inherit F_MASTER;
#include <ansi.h>
int do_incense();
int auto_perform();
int ask_job();
int ask_mask();
string ask_jobdone();
void create()
{
	set_name("胖头陀", ({ "pang toutuo", "pang" }));
            set_color("$HIW$");
	set("title", "神龙教胖瘦二尊者");
	set("long", 
                "身材奇高，瘦得出奇，脸上皮包骨头，双目深陷，\n"
                "当真便如僵尸一般长发垂肩，头顶一个铜箍束住了长发，\n"
                "身上穿一件布袍，宽宽荡荡，便如是挂在衣架上。\n");
	set("gender", "男性");
	set("age", 41);
	set("attitude", "peaceful");
	set("shen", -50000);
	set("str", 30);
	set("int", 10);
	set("con", 30);
	set("dex", 20);
	
	set("max_qi", 6000);
	set("max_jing", 6000);
	set("neili", 2000);
	set("max_neili", 2000);
	set("jiali", 0);
	set("combat_exp", 500000);
	set("score", 10000);
                  set("chat_chance_combat", 90);
                  set("chat_msg_combat", ({
                         (: auto_perform :),
                  }) );

	set_skill("force", 200);
  	set_skill("dulong-dafa", 200);
	set_skill("dodge", 200);
	set_skill("lingshe-shenfa", 200);
	set_skill("poison", 200);
	set_skill("huanying-zhi", 200);
	set_skill("blade", 200);
	set_skill("kick", 200);
       set_skill("medicine", 200);
	set_skill("jueming-tui", 200);
	set_skill("qilin-dao", 200);
	set_skill("finger", 200);
  	set_skill("literate", 110);

	map_skill("force", "dulong-dafa");
	map_skill("dodge", "lingshe-shenfa");
	map_skill("kick", "jueming-tui");
	map_skill("finger", "huanying-zhi");
	map_skill("parry", "qilin-dao");
	map_skill("blade", "qilin-dao");


	prepare_skill("kick", "jueming-tui");
	prepare_skill("finger", "huanying-zhi");
        set("chat_msg", ({
                (: random_move :)
        }) );
	create_family("神龙教", 2, "尊者");
      set("inquiry", ([
                "神龙岛" : "神龙岛又叫蛇岛，在汝州的东北方向，从塘沽口出海便到",
                "功劳" : (: ask_jobdone :), 
                "洪安通" : "这三个字是你说的吗？",
                "洪教主" : "洪教主仙福永享，寿与天齐，洪教主神目如电，烛照四方。",
                "瘦头陀" : "别提了，咱哥儿俩换了这副身胚。",
                "工作" : (: ask_job :),
                "job" : (: ask_job :),
                "mask" : (: ask_mask :),
                "面罩" : (: ask_mask :),

        ]));
            

	setup();
            carry_object("/clone/misc/cloth")->wear();
	     carry_object("/d/shenlong/obj/dahuandao")->wield();

}

void attempt_apprentice(object me)

{
       object mask;
	if( me->query("family/family_name") == "丐帮"
        && me->query("combat_exp") >= 100000 ) {
		command ("say 阁下已经是江湖上赫赫有名的人了，神龙岛可不敢收留。");
                return;
	}
	command("say 好吧，看来你资质不错，本尊者就答应传授你一些武功。");
	command("say 不过你还没有正式成为神龙教的教众，只有通过无根道人才能成为正式的神龙教教众。");

	command("recruit " + me->query("id"));
       me->set("title","神龙教弟子");
       
    
       mask = new ("/d/shenlong/obj/sg_mianzhao");
       mask->move(me);
       message_vision("$N给$n一个面罩。\n", this_object(), me);

}
void destroy_it(object ob)
{
	if(ob)
	destruct (ob);
}

int ask_job(){
	
	object me=this_player();
	mapping fam;
        int pot,exp;
        int didian;
           didian = 1+random(6);
           exp = 150+random(10);
           pot = 100+random(10);
	if (!(fam = this_player()->query("family")) || fam["family_name"] !="神龙教"){
		command("?");
		return 0;
	}
        if(me->query_temp("job_over")==1) {
                command("nod");
                command("say 这些小事，你办的还凑合！");

                            me->delete_temp("job_over");
                            me->add("shenlong/gonglao",10);
		    me->add("combat_exp", exp);
	                me->add("potential", pot);
		   if ( me->query("potential") > me->query("max_potential") )
{
                 tell_object(me,BRED+HIY"\n你的潜能满了，无法增加。\n"NOR);
                 tell_object(me,BRED+HIY"你的经验增加"+exp+"点。\n"NOR);
                 tell_object(me,BRED+HIY"你的神龙教功劳增加了10点。\n"NOR);
                 me->set("potential", me->query("max_potential"));
                 return 1;
}
                 tell_object(me,BRED+HIY"\n你的潜能增加了"+pot+"点。\n"NOR);
                 tell_object(me,BRED+HIY"你的经验增加"+exp+"点。\n"NOR);
                 tell_object(me,BRED+HIY"你的神龙教功劳增加了10点。\n"NOR);



                return 1;
        }
		
        if(me->query_temp("job_here1")==1) {
                command("say 你快去兰州西大街杀了那个帮众，削弱一下正派的实力！");
                return 1;
        }
        if(me->query_temp("job_here2")==1) {
                command("say 你快去杭州黄龙洞杀了那个帮众，削弱一下正派的实力！");
                return 1;
        }
        if(me->query_temp("job_here3")==1) {
                command("say 你快去华山村草棚杀了那个帮众，削弱一下正派的实力！");
                return 1;
        }
        if(me->query_temp("job_here4")==1) {
                command("say 你快去星宿城中心杀了那个帮众，削弱一下正派的实力！");
                return 1;
        }
        if(me->query_temp("job_here5")==1) {
                command("say 你快去泰山天街杀了那个帮众，削弱一下正派的实力！");
                return 1;
        }
        if(me->query_temp("job_here6")==1) {
                command("say 你快去黄河渭汾流域杀了那个帮众，削弱一下正派的实力！");
                return 1;
        }
	if(didian==1) {
//      /d/qilian/weststreet
        command ("say “嘿嘿，你来的正好，神龙教正缺人手，看你武功凑合，你就去兰州西大街帮神龙教杀个帮众吧！”");
        command ("say “快去快回，要干净利落。”");
        me->set_temp("job_here1",1);

	return 1;
        }
	if(didian==2) {
//      /d/hangzhou/hl1
        command ("say “嘿嘿，你来的正好，神龙教正缺人手，看你武功凑合，你就去杭州黄龙洞帮神龙教杀个帮众吧！”");
        command ("say “快去快回，要干净利落。”");
        me->set_temp("job_here2",1);

	return 1;
        }
	if(didian==3) {
//      /d/village/ehouse1
        command ("say “嘿嘿，你来的正好，神龙教正缺人手，看你武功凑合，你就去华山村草棚帮神龙教杀个帮众吧！”");
        command ("say “快去快回，要干净利落。”");
        me->set_temp("job_here3",1);

	return 1;
        }
	if(didian==4) {
//      /d/xingxiu/beijiang
        command ("say “嘿嘿，你来的正好，神龙教正缺人手，看你武功凑合，你就去星宿城中心帮神龙教杀个帮众吧！”");
        command ("say “快去快回，要干净利落。”");
        me->set_temp("job_here4",1);

	return 1;
        }
	if(didian==5) {
//      /d/taishan/tianjie
        command ("say “嘿嘿，你来的正好，神龙教正缺人手，看你武功凑合，你就去泰山天街帮神龙教杀个帮众吧！”");
        command ("say “快去快回，要干净利落。”");
        me->set_temp("job_here5",1);

	return 1;
        }
	if(didian==6) {
//      /d/huanghe/weifen
        command ("say “嘿嘿，你来的正好，神龙教正缺人手，看你武功凑合，你就去黄河渭汾流域帮神龙教杀个帮众吧！”");
        command ("say “快去快回，要干净利落。”");
        me->set_temp("job_here6",1);

	return 1;
        }
}



int accept_object(object who, object ob)
{
        object *inv;
        int addgonglao, i;
	 if(userp(ob)) return 0;
        addgonglao = 1+random(2);
        if (!ob->query("money_id")) {
                command("?");
                return 0;
        }
        if (ob->query("money_id") && ob->value() < 100000) {
                command("hmm");
                command("say 这点钱能干嘛？。");
                return 0;
        }

        command("smile " + who->query("id"));
        command("whisper " + who->query("id")+ " 你为神龙教捐了钱，我就偷偷给你多加一点功劳，别说出去小心教主知道了。");
        who->add("shenlong/gonglao",addgonglao);
        who->start_busy(addgonglao);
        tell_object(who,BRED+HIY"由于你贿赂胖头陀，你的神龙教功劳增加了"+addgonglao+"点。\n"NOR);
        return 1;
}


string ask_mask() {
    object player=this_player();
    object mask;
    mapping fam;
    if (!(fam = this_player()->query("family")) || fam["family_name"] !="神龙教"){
		command("?");
		return 0;
	}
    if (objectp(present("mianzhao", player))) {
	return "你不是有面罩了么？\n";
    }
    mask = new ("/d/shenlong/obj/sg_mianzhao");
    mask->move(player);
    message_vision("$N给$n一个面罩。\n", this_object(), player);
    return "下次小心一点。\n";
}

string ask_jobdone()
{
        object who=this_player();

        return RANK_D->query_respect(who)+"在我神龙教工作之中，已经积累功劳点"+chinese_number(who->query("shenlong/gonglao"))+"。";
}



