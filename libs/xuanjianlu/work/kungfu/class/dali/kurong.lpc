//Cracked by Xuanyuan

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_for_join();
string ask_jing();
string ask_jiumozhi();
string ask_lingwu();
int talk1(object me);
int talk2(object me);
int talk3(object me);
int talk4(object me);
int talk5(object me);
int talk6(object me);
int talk7(object me);
void create() {
  set_name("枯荣大师", ({
    "kurong dashi",
    "dashi",
    "kurong",
    "ku rong",
  }));
  set("long",
    "他身材甚是高大，但四肢却失分枯瘦，面容更是奇特之极，左边一半脸色红润\n"
    "右边一半却如枯骨，除了一张焦黄的面皮之外全无肌肉，骨头凸了出来，宛然\n"
    "便是半个骷髅骨头。\n"
  );

  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("inquiry", ([
    "剃度": (: ask_for_join :),
    "出家": (: ask_for_join :),
    "六脉神剑": (: ask_jing :),
    "六脉神剑经": (: ask_jing :),
    "鸠摩智": (: ask_jiumozhi :),
    "大轮明王": (: ask_jiumozhi :),
    "请师叔示下": (: ask_lingwu :),
    "还请师叔示下": (: ask_lingwu :),
  ]));
  set("age", 80);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("max_qi", 5000);
  set("max_jing", 5000);
  set("neili", 8000);
  set("max_neili", 8000);
  set("jiali", 200);
  set("combat_exp", 3000000);
  set("score", 5000);

  set_skill("force", 400);
  set_skill("dodge", 400);
  set_skill("parry", 400);
  set_skill("finger", 400);
  set_skill("kurong-changong", 400);
  set_skill("yiyang-zhi", 400);
  set_skill("cuff", 400);
  set_skill("strike", 400);
  set_skill("buddhism", 400);
  set_skill("sword", 400);
  set_skill("duanshi-shenfa", 400);
  set_skill("duanjia-jian", 400);
  set_skill("qingyan-zhang", 400);
  set_skill("jinyu-quan", 400);
  set_skill("liumai-shenjian", 400);
  set_skill("medicine", 300);
  set_skill("literate", 200);

  map_skill("force", "kurong-changong");
  map_skill("dodge", "duanshi-shenfa");
  map_skill("strike", "qingyan-zhang");
  map_skill("parry", "liumai-shenjian");
  map_skill("finger", "liumai-shenjian");
  map_skill("cuff", "jinyu-quan");

  prepare_skill("finger", "liumai-shenjian");

  create_family("大理段家", 13, "弟子");

  setup();

  carry_object("/d/shaolin/obj/cheng-cloth")->wear();
}

void init() {
  ::init();

  if (interactive(this_player()) &&
    this_player()->query_temp("fighting")) {
    COMBAT_D->do_attack(this_object(), this_player(),
      query_temp("weapon"));
    this_player()->add_temp("tianlong_count", 1);
  }
}

string ask_for_join() {
  object me;

  me = this_player();

  if (me->query("family/family_name") != "大理段家")
    return "阿弥陀佛！施主不是大理段家子弟，何以向老衲谈及此事？";

  if (me->query("quit/bonze"))
    return "阿弥陀佛！施主既然已经还俗又因何再提出家之事？";

  if ((string)me->query("class") == "bonze")
    return "阿弥陀佛！你我同是出家人，何故跟贫僧开这等玩笑？\n";

  if ((string)me->query("class") == "taoist")
    return "阿弥陀佛！施主已经是道家人，何故跟贫僧开这等玩笑？\n";

  if ((string)me->query("gender") != "男性")
    return "阿弥陀佛！善哉！善哉！本寺向来不收女徒，女施主何故跟贫僧开这等玩笑？\n";

  if ((int)me->query_skill("kurong-changong", 1) < 200)
    return "阿弥陀佛！施主的枯荣禅功火候太浅，无法在本寺中参修。\n";

  me->set_temp("pending/join_bonze", 1);

  add_action("do_kneel", "kneel");
  return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。\n";
}

int do_kneel() {
  object me = this_player();

  string *prename = ({ "本" });
  string name, new_name;

  if (!me->query_temp("pending/join_bonze"))
    return 0;

  message_vision(
    "$N站起身来，双膝跪地，道：“请大师慈悲。”。\n\n"
    "$n伸出右手，反过来按在$N头上，手掌上似无半点肌肉，皮肤之下包着\n"
    "的便是骨头。$n仍不转身，说偈道：“一微尘中入三昧，成就一切微尘定，\n"
    "而彼微清真寺亦不增，于一普现难思刹。”手掌提起，$N满头乌发尽数落下，\n"
    "头顶光秃秃地更无一根头发，便是用剃刀来剃亦无这等干净。\n\n",
    me, this_object());

  name = me->query("name");
  new_name = prename[random(sizeof(prename))] + name[0..1];
  command("say 从今以后你的法名叫做" + new_name + "。");
  command("smile");
  me->delete_temp("pending/join_bonze");
  me->set("name", new_name);
  me->set("class", "bonze");
  me->set("K_record", me->query("PKS") + me->query("MKS"));
  me->set("shen_record", me->query("shen"));
  me->set("shen", 0);
  command("say 我欲收你为徒，但愿你心存善念，向佛终身。");
  command("recruit " + me->query("id"));
  return 1;
}

string ask_jing() {
  object me = this_player();
  object ob = this_object();

  if (ob->query("jiumozhi_came"))
    return "阿弥陀佛！那六脉神剑的图谱以被我毁去了。";

  if (me->query("family/family_name") != "大理段家")
    return "阿弥陀佛！那是我大理段氏祖国上的一门武功，威力无穷。";

  if ((string)me->query("class") != "bonze")
    return "阿弥陀佛！你是世俗之人，虽是自己子侄，许多武学的秘奥，亦不能向你泄漏。\n";

  if ((string)me->query("gender") != "男性")
    return "阿弥陀佛！那是我大理段氏祖国上的一门武功，威力无穷，只可惜女性不适宜修炼此功。\n";

  if ((int)me->query_skill("kurong-changong", 1) < 250)
    return "阿弥陀佛！这六脉神剑功夫以内力为主，实非急切间一蹴可成。你枯荣禅功火候太浅，无法在本寺中参修。\n";

  me->set_temp("ask_benyin", 1);
  return "阿弥陀佛！本寺虽藏有此经，但说也惭愧，我们无一人能练成经上所载神功，连稍突击堂奥也说不上。你去把本因叫进来，我有话要说。\n";
}

string ask_jiumozhi() {
  object me = this_player();

  if (!me->query_temp("6msj")) {
    message_vision(CYN "枯荣大师说道：大轮明王鸠摩智是吐蕃国的护国法王，但只听说他具大智慧，精通\n" NOR, me);
    message_vision(CYN "佛法，每隔五年，开坛讲经说法，西域天竺各地的高僧大德，云集大雪山大轮寺，\n" NOR, me);
    message_vision(CYN "执经问难，研讨内典，闻法既毕，无不欢喜赞叹而去。\n" NOR, me);
    return "这等大智大慧之人，不学武则已，既为武学中人，定然非同小可。";
  }

  message_vision(CYN "枯荣大师说道：大轮明王来信曰“谈论当世武功，慕容先生言下对贵寺‘六脉神剑’备致推\n" NOR, me);
  message_vision(CYN "崇，深以未得拜观为憾。近闻慕容先生仙逝，哀痛无已，为报知己，拟向本寺讨求该经，\n" NOR, me);
  message_vision(CYN "焚化于慕容先生墓前，日内来取，勿却为幸。欲以贵重礼物还报。\n" NOR, me);
  return "大轮明王自知轻重。只是他料到本寺并无出类拔萃的高人，宝经虽珍，但无人能够练成，那也枉然。";
}

string ask_lingwu() {
  object me = this_player();
  object ob = this_object();

  if (ob->query("jiumozhi_came")) {
    return "大轮明王已经来过了。";
  }
  if (!me->query_temp("ask_kurong")) {
    return 0;
  }
  call_out("talk1", 10, me);
  me->delete_temp("ask_kurong", 1);
  command("consider");
  return "对付大轮明王的办法…………";
}

int talk1(object me) {
  message_vision(CYN "\n    枯荣忽道：“咱们倘若分别练那六脉神剑，不论是谁，终究内力不足，都是练\n" NOR, me);
  message_vision(CYN "不成的。我也曾想到一个取七的法子，各人修习一脉，六人一齐出手。虽然以六敌\n" NOR, me);
  message_vision(CYN "一，胜之不武，但我们并非和他单独比武争雄，而是保经护寺，就算一百人斗他一\n" NOR, me);
  message_vision(CYN "人，却也说不得了。只是算来算去，天龙寺中再也寻不出第六个指力相当的好手来，\n" NOR, me);
  message_vision(CYN "自以为此踌躇难决。" + me->query("name") + "，你就来凑凑数罢。\n\n", me);
  remove_call_out("talk1");
  call_out("talk2", 10, me);
  return 1;
}
int talk2(object me) {
  message_vision(CYN "    本参道：“这路剑法的基本功夫，你早就已经会了，只须记一记剑法便成。”\n\n" NOR, me);
  message_vision(CYN "    本因道：“六脉神剑，并非真剑，乃是以一阳指的指力化作剑气，有质无形，\n" NOR, me);
  message_vision(CYN "可称无形气剑。所谓六脉，即手之六脉太阴肺经、厥阴心包经、少阴心经、太阳小\n" NOR, me);
  message_vision(CYN "肠经、阳明胃经、少阳三焦经。”说着从本观的蒲团后面取出一个卷轴。\n\n" NOR, me);
  remove_call_out("talk2");
  call_out("talk3", 10, me);
  return 1;
}
int talk3(object me) {
  object book;

  message_vision("    本参接过，悬在壁上，卷轴舒开，帛面年深日久，已成焦黄之色，帛上绘着个\n", me);
  message_vision("裸体男子的图形，身上注明穴位，以红线黑线绘着六脉的运走径道。\n", me);

  me->set_temp("can_read_6msj_book", 1);
  me->set("got_6msj", 1);
  book = new("/d/dali/obj/liumai-jing");
  book->set("no_get", 1);
  book->move(environment(me));

  tell_object(me, HIY "\n你现在可以通过(lingwu jianpu)开始研习六脉神剑经了！\n\n" NOR);
  remove_call_out("talk3");
  call_out("talk4", 300, me);
  return 1;
}
int talk4(object me) {
  object can, yin;
  object ob = this_object();

  message_vision(HIM "便在此时，你的鼻端忽然闻到一阵柔和的檀香，跟着一声若有若无的梵唱远远飘来。\n\n" NOR, me);
  command("say 善哉，善哉！大明轮王驾到。你们练得怎么样了？");
  if (can = present("bencan dashi", environment(me))) {
    message_vision(CYN "本参道：“虽不纯熟，似乎也已足可迎敌。”\n\n" NOR, can);
    command("say 很好！本因，我不想走动，便请明王到牟尼堂来叙会吧。");
    if (yin = present("benyin dashi", environment(me))) {
      message_vision(CYN "本因方丈应道：“是！”\n" NOR, yin);
      message_vision("本因大师走了出去。\n\n", yin);
      destruct(yin);
    }
  }
  me->delete_temp("can_read_6msj_book", 1);
  remove_call_out("talk4");
  call_out("talk5", 15, me);
  return 1;
}
int talk5(object me) {
  object jiumozhi, yin;
  object ob = this_object();

  message_vision("    过了好一会，只听得本因方丈道：“明王法驾，请移这边牟尼堂。”另一个声\n", me);
  message_vision("音道：“有劳方丈领路。”段誉听这声音甚是亲切谦和，彬彬有礼，绝非强凶霸横\n", me);
  message_vision("之人。听脚步声共有十来个人。听得本因推开板门，说道：“明王请！”\n\n", me);

  yin = new("/kungfu/class/dali/benyin");
  yin->move(environment(me));
  message_vision("本因走了进来。\n", me);
  jiumozhi = new("/kungfu/class/xueshan/jiumo");
  jiumozhi->move(environment(me));
  message_vision("鸠摩智走了进来。\n", me);
  ob->set("jiumozhi_came", 1);
  remove_call_out("talk5");
  call_out("talk6", 10, me);
  return 1;
}
int talk6(object me) {
  object xiang;
  message_vision("    鸠摩智道：“只是那日小僧曾夸口言道：‘小僧是吐蕃国师，于大理段氏无亲\n", me);
  message_vision("无故，吐蕃大理两国，亦无亲厚邦交。慕容先生既不便亲取，由小僧代劳便是。’\n", me);
  message_vision("大丈夫一言既出，生死无悔。小僧对慕容先生既有此约，决计不能食言。现愿以\n", me);
  message_vision("少林七十二门绝技的三种指法绝技的要旨交换”说着演示了三种指法。\n\n", me);
  message_vision("    本因、本观、本相、本参四僧见了鸠摩智献演三种指力，都不禁怦然心动，知\n", me);
  message_vision("道三卷奇书中所载，确是名闻天下的少林七十二门绝技，是否要将‘六脉神剑’的\n", me);
  message_vision("图谱另录副本与之交换，确是大费踌躇。\n\n", me);

  if (xiang = present("benxiang dashi", environment(me))) {
    message_vision(CYN "本因道：“师叔，明王远来，其意甚诚。咱们该当如何应接，请师叔见示。”\n" NOR, xiang);
  }

  remove_call_out("talk6");
  call_out("talk7", 10, me);
  return 1;
}
int talk7(object me) {
  object jianpu;
  command("say " + me->query("name") + "，咱们练功习艺，所为何来？");

  message_vision(CYN "    " + me->query("name") + "道：“师叔指点甚是，咱们自己的一阳指尚自修习不得周全，要旁人的武\n" NOR, me);
  message_vision(CYN "学奇经作甚？明王远来辛苦，待敝寺设斋接风。”\n\n" NOR, me);

  if (jianpu = present("liumai jianpu", environment(me))) {
    command("say 明王此翻大理之行注定是无功而返，这六脉神剑经我就毁了吧。");
    message_vision(HIR "枯荣大师将六脉神剑的图谱烧了。\n\n" NOR, me);
    destruct(jianpu);
  }
  remove_call_out("talk7");
  call_out("talk8", 20, me);
  return 1;
}
int talk8(object me) {
  object jiumozhi1, jiumozhi2;

  message_vision("鸠摩大怒，智双手一击，门外走进一名高大汉子取过一束藏香，鸠摩智盘膝坐在香后，\n", me);
  message_vision("隔着五尺左右，突击双掌搓板了几搓，向外挥出，六根香头一亮，同时点燃了。\n\n", me);
  message_vision(HIG "藏香所生烟气作碧绿之色，六条笔直的绿线袅袅升起。\n" NOR, me);
  message_vision(
    RED "鸠摩智双掌如抱圆球，内力运出，六道碧烟慢慢向外弯曲，分别指着枯荣、本观、本相、本因、本参、" + me->query("name") + "六人。\n\n" NOR,
    me
  );
  me->delete_temp("6msj");
  me->set_temp("defense_jiumozhi", 1);
  if (jiumozhi1 = present("jiumozhi", environment(me))) {
    destruct(jiumozhi1);
    jiumozhi2 = new("/d/dali/npc/jiumozhi");
    jiumozhi2->move(environment(me));
  }
  remove_call_out("talk8");
  return 1;
}
