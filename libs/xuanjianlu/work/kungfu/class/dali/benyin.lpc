//Cracked by Xuanyuan

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_enter();
string ask_jiumozhi();

int talk1(object me);
int talk2(object me);
int talk3(object me);
int talk4(object me);
int talk5(object me);

void create()
{
        set_name("本因", ({
                "benyin dashi",
                "dashi",
                "benyin",
                "ben yin",
        }));
        set("long",
"他看起来僧枯黄精瘦，四肢修长。\n");
        set("gender", "男性");
        set("attitude", "friendly");
        set("class", "bonze");
		set("inquiry",([
			"enter"	: (: ask_enter :),
			"进去"	: (: ask_enter :),
			"进来"	: (: ask_enter :),
			"进"	: (: ask_enter :),
			"鸠摩智"	: (: ask_jiumozhi :),
			"大轮明王"	: (: ask_jiumozhi :),
		]));
        set("age", 60);
        set("shen_type", 1);
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
        set("max_qi", 3000);
        set("max_jing", 3000);
        set("neili", 4000);
        set("max_neili", 4000);
        set("jiali", 150);
        set("combat_exp", 1500000);

        set_skill("force", 180);
        set_skill("kurong-changong", 180);
        set_skill("dodge", 180);
        set_skill("duanshi-shenfa", 180);
        set_skill("strike", 180);
	set_skill("cuff", 180);
	set_skill("finger", 180);
	set_skill("yiyang-zhi", 180);
	set_skill("liumai-shenjian",180);
        set_skill("qingyan-zhang", 180);
        set_skill("parry", 180);
        set_skill("buddhism", 200);
        set_skill("literate", 200);

        map_skill("force", "kurong-changong");
        map_skill("dodge", "duanshi-shenfa");
        map_skill("strike", "qingyan-zhang");
        map_skill("parry", "liumai-shenjian");
	map_skill("finger", "liumai-shenjian");
	map_skill("cuff", "jinyu-quan");

        prepare_skill("finger", "liumai-shenjian");

        create_family("大理段家", 14, "弟子");

        setup();

        carry_object("/d/shaolin/obj/cheng-cloth")->wear();
}

#include "/kungfu/class/dali/ben.h"

void init()
{
	object kurong, ku, nan;
	object me = this_object();
	object player = this_player();
	if (interactive(player) && player->query_temp("fighting")){
		COMBAT_D->do_attack(me,player, query_temp("weapon") );
		player->add_temp("tianlong_count", 1);
	}       
	if (player->query_temp("enter_tianlong")){
		command("buddhi");
		command("say 既然施主急闯天龙寺，那就请随我去牟尼堂吧。\n");
		message_vision("$N向里走了进去。\n", me);
		me->move("/d/dali/tianls11");
		player->set_temp("fight_tianlong", 1);
		player->delete_temp("enter_tianlong", 1);
		if ( ku=present("ming ku", environment(player)) ) {
			message_vision("$N急急忙忙地离开了。\n", ku);
			message("vision","明苦从寺里走了出来。\n", load_object("/d/dali/tianls1"));
			ku->move("/d/dali/tianls1");
		}
		if ( nan=present("ming nan", environment(player)) ) {
			message_vision("$N急急忙忙地离开了。\n", nan);
			message("vision","明难从寺里走了出来。\n", load_object("/d/dali/tianls1"));
			nan->move("/d/dali/tianls1");
		}
		return;
	}      
	if (player->query_temp("fight_tianlong") && kurong=present("kurong dashi", environment(me))) {
		me->set_temp("fight_tianlong",player->query("id"));
		remove_call_out("greeting");
		call_out("greeting",5,player);
	}
}
int greeting(object player)
{
	object kurong, yin, can, guan, xiang;
	object me=this_object();

	command("say 降妖除魔乃我佛家的本份，就让我们几个老和尚来超度施主吧。\n");
	player->delete_temp("fight_tianlong", 1);

	if ( me->query_temp("fight_tianlong") == player->query("id") && living(this_player())){
		me->kill_ob(player);
		player->kill_ob(me);

	if ( kurong=present("kurong dashi", environment(me)) ) {
		player->kill_ob(kurong);
		kurong->kill_ob(player);
	}
	if ( yin=present("benyin dashi", environment(me)) ) {
		player->kill_ob(yin);
		yin->kill_ob(player);
	}	
	if ( can=present("bencan dashi", environment(me)) ) {
		player->kill_ob(can);
		can->kill_ob(player);
	}
	if ( guan=present("benguan dashi", environment(me)) ) {
		player->kill_ob(guan);
		guan->kill_ob(player);
	}
	if ( xiang=present("benxiang dashi", environment(me)) ) {
		player->kill_ob(xiang);
		xiang->kill_ob(player);
	}
		remove_call_out("checkplay");
		call_out("checkplay",2,player);
		return 1;
	}
	message_vision("$N向外走了出去。\n", me);
	me->move("/d/dali/tianls10");
	return 1;
}
int checkplay(object player)
{
	object me=this_object();
	if (!present(query_temp("fight_tianlong"),environment(this_object() ) ) ) {
		command ("buddhi");
		message_vision("$N向外走了出去。\n", me);
		me->move("/d/dali/tianls10");
		return 1;
	}
	remove_call_out("checkplay");
	call_out("checkplay",2,player);
	return 1;
}
string ask_enter()
{
	object me = this_player();
	object ob = this_object();
	object room;

	if ( !me->query_temp("ask_benyin") ) 
		return 0;

	if(!( room = find_object("/d/dali/tianls11")) )
		room = load_object("/d/dali/tianls11");

	if(!objectp(room))
		return 0;

	command("nod "+me->query("id"));
	command("say 事有轻重缓急，大雪山大轮明王之约，转眼就到。"+me->query("name")+"，你也来参详参详。\n");
	message_vision("$N向里走了进去。\n", ob);
	ob->move(room);
	message("vision","本因大师走了进来。\n", room);
	me->delete_temp("ask_benyin");
	me->set_temp("6msj",1);
	return "阿弭佗佛！";
}

string ask_jiumozhi()
{
	object me = this_player();

	if ( !me->query_temp("6msj") ){
	return "你去问枯荣大师吧。";
	}
	message_vision(CYN"本因大师说道：大轮明王来信曰“谈论当世武功，慕容先生言下对贵寺‘六脉神剑’备致推\n"NOR,me);
	message_vision(CYN"崇，深以未得拜观为憾。近闻慕容先生仙逝，哀痛无已，为报知己，拟向本寺讨求该经，\n"NOR,me);
	message_vision(CYN"焚化于慕容先生墓前，日内来取，勿却为幸。欲以贵重礼物还报。\n"NOR,me);
	call_out("talk1", 10, me);
	return "大轮明王自知轻重。只是他料到本寺并无出类拔萃的高人，宝经虽珍，但无人能够练成，那也枉然。";
}

int talk1(object me)
{
	message_vision(CYN"\n    只听本参气愤愤的道：“这大轮明王也算是举世闻名的高僧了，怎能恁地不通\n"NOR,me);
	message_vision(CYN"情理，胆敢向本寺强要此经？"+me->query("name")+"，方丈师兄知道善意者不来，来者不善，此事后\n"NOR,me);
	message_vision(CYN"果非小，自己作不得主，请枯荣师叔出来主持大局。”\n\n"NOR,me);
	remove_call_out("talk1");
	call_out("talk2", 10, me);
	return 1;
}
int talk2(object me)
{
	message_vision(CYN"    本因道：“本寺虽藏有此经，但说也惭愧，我们无一人能练成经上所载神功，\n"NOR,me);
	message_vision(CYN"连稍突击堂奥也说不上。枯荣师波所参枯禅，是本寺的另一路神功，也当再假时日，\n"NOR,me);
	message_vision(CYN"方克大成。我们未练成神功，外人自不得而知，难道大轮明王竟有恃无恐，不怕这\n"NOR,me);
	message_vision(CYN"六脉神剑的绝学吗？”\n\n",me);
	remove_call_out("talk2");
	call_out("talk3", 10, me);
	return 1;
}
int talk3(object me)
{
	message_vision(CYN"    枯荣冷冷的道：“谅来他对六脉神剑是不敢轻视的。他信中对那慕容先生何等\n"NOR,me);
	message_vision(CYN"钦敬，而这慕容先生又心仪此经，大轮明王自知轻重。只是他料到本寺并无出类拔\n"NOR,me);
	message_vision(CYN"萃的高人，宝经虽珍，但无人能够练成，那也枉然。”\n\n",me);
	remove_call_out("talk3");
	call_out("talk4", 10, me);
	return 1;
}
int talk4(object me)
{
	message_vision(CYN"    本参大声道：“他如自己仰慕，相求借阅一观，咱们敬他是佛门高僧，最多不\n"NOR,me);
	message_vision(CYN"过婉言谢绝，也没什么大不了。最气人的，他竟要拿去烧化给死人，岂不太也小觑\n"NOR,me);
	message_vision(CYN"了天龙寺么？”\n\n",me);
	remove_call_out("talk4");
	call_out("talk5", 10, me);
	return 1;
}
int talk5(object me)
{
	
	message_vision(CYN"    本相喟然叹道：“师弟倒不必因此生嗔着恼，我瞧那大明轮王并非妄人，他是\n"NOR,me);
	message_vision(CYN"想效法吴季扎墓上挂剑的遗意，看来他对那位慕容易先生钦仰之极，唉，良友已逝，\n"NOR,me);
	message_vision(CYN"不见故人……”说着缓缓摇头。\n\n",me);
	remove_call_out("talk5");
	call_out("talk6", 10, me);
	return 1;
}
int talk6(object me)
{
	message_vision(CYN"    本因方丈道：“师叔估量敌势，咱们若非赶紧练成六脉神剑，只怕宝经难免为\n"NOR,me);
	message_vision(CYN"人所夺，天龙寺一败涂地。只是这神剑功夫以内力为主，实非急切间一蹴可成。\n\n"NOR,me);
	command("say 如今之时该当如何，还请师叔示下。");
	me->set_temp("ask_kurong",1);
	remove_call_out("talk6");
	return 1;
}

