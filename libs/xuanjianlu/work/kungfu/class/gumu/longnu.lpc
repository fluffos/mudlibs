#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me();
int auto_perform();
string ask_jiang();
string ask_zhen();
string ask_job();

void create()
{
        set_name("小龙女", ({ "xiao longnu", "long", "longnu" }));
		set("long", "她清丽异常，但也许是长居古墓之故，面色略白。\n");
        set("gender", "女性");
        set("age", 18);
        set("attitude", "friendly");
        set("str", 20);
        set("dex", 28);
        set("con", 20);
        set("int", 28);
        set("shen", 20000);

        set("combat_exp", 1600000);
        set("max_qi", 2500);
        set("max_jing", 5600);
        set("neili", 4500);
        set("max_neili", 4500);

        set("jiali",50);

        set_skill("literate", 150);
        set_skill("parry", 300);
        set_skill("force", 300);
        set_skill("dodge", 300);
        set_skill("sword", 300);
        set_skill("whip", 320);
        set_skill("throwing",400);
        set_skill("cuff", 300);
        set_skill("strike", 300);
        set_skill("meinu-quan", 300);
        set_skill("gumu-shenfa", 300);
        set_skill("tianluo-diwang", 300);
        set_skill("yinsuo-jinling", 320);
        set_skill("yunu-jue", 400);
        set_skill("yunu-jianfa", 300);
        set_skill("quanzhen-jian", 300);
        set_skill("yunu-xinjing", 300);

        map_skill("force", "yunu-xinjing");
        map_skill("dodge", "gumu-shenfa");
        map_skill("cuff", "meinu-quan");
        map_skill("strike", "tianluo-diwang");
        map_skill("whip", "yinsuo-jinling");
        map_skill("sword", "yunu-jianfa");
        map_skill("parry", "yunu-jianfa");

        prepare_skill("cuff", "meinu-quanfa");
        prepare_skill("strike", "tianluo-diwang");

        create_family("古墓派",3,"弟子");
        set("inquiry", ([
			"杨过" : "过儿是我夫君，我知道他很爱我，可一直呆在这真怕他会闷。",
            "job" : (: ask_job :),
            "工作" : (: ask_job :),
            "work" : (: ask_job :),
			"秘籍" : (: ask_me :),
			"玉蜂浆" : (: ask_jiang :),
			"玉蜂针" : (: ask_zhen :),
       ]) );
		set("chat_chance_combat", 50);
		set("chat_msg_combat", ({
			(: auto_perform :),
		}) );

		set("book_count", 1);
		set("jiang_count", 20);
		set("zhen_count", 7);

        setup();
        carry_object("/d/zhongnan/obj/baipao")->wear();
		if (clonep()) carry_object("/clone/unique/jinsi-shoutao", "/clone/armor/shoutao")->wear();
        if (clonep()) carry_object("/clone/unique/jinling-suo", "/clone/weapon/changjian")->wield();
}

void init()
{
		object ob;
		::init();
		if (interactive(ob = this_player()) && !is_fighting()) {
			 remove_call_out("greeting");
			 call_out("greeting", 1, ob);
		}
}

void greeting(object me)
{ 
		object ob;
		ob = this_object();

		if ( me->query("married_times") > 1 && me->query("family/master_id") == "xiao longnu" ) {
		command("say 我古墓一脉以“情”字相承。其中深意，" + me->query("name") +"却不能谨记。");
		command("expell " + me->query("id"));
		return;
		}
		return;
}

void attempt_apprentice(object ob)
{

	mapping fam = ob->query("family");
/*
	if(ob->query("gender") != "女性") {
                command("say 祖师婆婆订下的规矩，我们古墓派只收女徒，我不能收你，"+RANK_D->query_respect(ob)+"还是请回吧。");
                return;
                }
*/
	if (!fam || fam["family_name"] != "古墓派"){
                command("say "+RANK_D->query_respect(ob)+"与本派素无来往，不知此话从何谈起？");
                return;
                }
	if(fam["master_name"] == "李莫愁") {
		command("say 你是我师姐"+fam["master_name"]+"的徒弟，我不能收你。");
		return;
		}       
	if((int)ob->query_skill("force", 1) < 100) {
                command("say 我古墓武功内功是基础。"); 
                command("say " + RANK_D->query_respect(ob)+"是否还应该先在内功上多下点功夫？");
                return;
                }  
	if((int)ob->query_skill("dodge", 1) < 100) {
                command("say 你轻功这么差，我教的你不一定学得会。"); 
                command("say "+RANK_D->query_respect(ob)+"是否还应该在轻功上多下点功夫？");
                return;
                }
	if((int)ob->query_skill("sword", 1) < 100) {
                command("say 你剑法这么差，我教的你不一定学得会。"); 
                command("say "+RANK_D->query_respect(ob)+"是否还应该在剑法上多下点功夫？");
                return;
                }
	if((int)ob->query_skill("yunu-jue", 1) < 100) {
                command("say 你的玉女二十四诀修为尚浅，领悟不了我的功夫。"); 
                command("say "+RANK_D->query_respect(ob)+"是否还应该在玉女二十四诀上多下点功夫？");
                return;
                }
	if((int)ob->query_skill("tianluo-diwang", 1) < 100) {
                command("say 你的天罗地网势修为尚浅，领悟不了我的功夫。"); 
                command("say "+RANK_D->query_respect(ob)+"还是多抓几只麻雀再来找我吧。");
                return;
                }
	if(ob->query_int() < 30) {
                command("say 我的武功都要极高的悟性才能学会。");
                command("say 要能达到炉火纯青之境，体质什么的倒是无关紧要，悟性却是半点也马虎不得。");
                command("say 这位"+RANK_D->query_respect(ob)+"的悟性还大有潜力可挖，还是请回吧。");
                return;
                }
        command("say 嗯，看你还是个学武的料，我就收下你吧！");
        command("recruit " + ob->query("id"));
}

string ask_me()
{
	mapping fam; 
	object ob, *obs;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "古墓派")
		return RANK_D->query_respect(this_player()) + 
		"与本派素无来往，不知此话从何谈起？";

	if (query("book_count") < 1)
		return "你来晚了，本派的内功心法不在此处。";

	obs = filter_array(children("/d/zhongnan/obj/yunu_book1.lpc"), (: clonep :));
        if (sizeof(obs) > 2)
		return "你来晚了，本派的内功心法不在此处。";

	ob=new("/d/zhongnan/obj/yunu_book1");
	ob->move(this_player());
	add("book_count", -1);
	command ("rumor "+this_player()->query("name")+"弄到了一册玉女二十四诀上卷。");
	return "本派的内功心法玉女心经并不在我这里，不过这本「玉女二十四诀上卷」你可以拿回去好好钻研。";
}

string ask_jiang()
{
	mapping fam; 
	object ob, *obs;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "古墓派")
		return RANK_D->query_respect(this_player()) + 
		"与本派素无来往，不知此话从何谈起？";

	if(fam["master_name"] == "李莫愁") 
		return "怎么师姐的徒弟也对这古墓里的东西有兴趣？";

	if (query("jiang_count") < 1)
		return "你来晚了，玉蜂浆已经都给了你的师姐师妹们了。";

	if (this_player()->query("gumu/job") < 3)
		return "你抓的玉蜂太少了，没有玉蜂，哪里来的玉蜂浆？";

	if ( (int)this_player()->query("eff_qi")==(int)this_player()->query("max_qi") ) {
                message_vision("$N向$n脸上仔细地打量了一阵，摇了摇头。\n", this_object(), this_player());
                return "玉蜂浆酿制不易，你并未受伤，我不能给你。\n";
        }

	ob=new("/clone/drug/yufeng-jiang");
	ob->move(this_player());
	this_player()->add("gumu/job", -3);
	add("jiang_count", -1);
	say("小龙女给你一瓶玉蜂浆。\n");
	return "这是我们古墓派的疗伤灵药，你拿去好好服用。";
}

string ask_zhen()
{
	mapping fam; 
	object ob, *obs;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "古墓派")
		return RANK_D->query_respect(this_player()) + 
		"与本派素无来往，不知此话从何谈起？";

	if(fam["master_name"] == "李莫愁") 
		return "怎么师姐的徒弟也对这古墓里的东西有兴趣？";

	if (query("zhen_count") < 1)
		return "你来晚了，玉蜂针已经都给了你的师姐师妹们了。";

	if (this_player()->query_skill("throwing",1) < 120)
		return "你的基本暗器练的还不够，使用此物有害无益。";

	ob=new("/d/zhongnan/obj/yufeng-zhen");
	ob->move(this_player());
	add("zhen_count", -1);
	say("小龙女给你一枚玉蜂针。\n");
	return "这是我们古墓派的独门暗器，你拿去要慎用。";
}

string ask_job()
{
          mapping job_stat;
          object ob2;
          object ob = this_player();
          object me = this_object();
          object ping;

          job_stat = ob->query_temp("gm/feng");

          if ( ob->query("family/family_name") != "古墓派" )
                                         return "这位"+RANK_D->query_respect(ob)+"非我古墓派弟子，岂敢劳烦。\n";

        if( ob->is_busy() )
        {
                command("hmm "+ob->query("id"));
                        return "你还在忙着干别的事呢！\n";
        }

        if ( ob->query_temp("gm/maque") > 0)
        {
		if ( ob->query_temp("maque") > 0)
			return "我叫你去抓麻雀练习轻功，你好象还没有去过吧。\n";
		else return "你麻雀抓的还不熟练，再多练习一下去。\n";
        }

        if(job_stat || ob->query_temp("gm/feng") )
        {
                command("hmm "+ob->query("id"));
                        return "你还没完成任务，就又想要新的？\n";
        }

       ob->start_busy(random(3));

        if ( me->query_temp("job_pos") == 0 )
        {
               if(random(2)==1) me->set_temp("job_pos",1);
                        return "现在没什么要紧的事去作，你去休息吧。\n";
        }

        if ( me->query_temp("job_man") == ob->query("id") )
        {
        	ob->add_temp("gm/maque", 1 + random(3) );
        	ob->set_temp("maque", 1);
		return "你去墓外树林抓抓麻雀，自行练习一下轻功去吧。\n";
        }

        me->add_temp("job_pos", -1);

        command("nod");
        command("say 好，最近蜂蜜用完了，你去抓几只玉蜂回来酿蜜。");

        ping = present("fengjiang ping",ob );
        if(ping)destruct(ping);
        ob2 = new("/d/zhongnan/obj/ping.lpc");
        ob2->move(me);
        ob->set_temp("gm/feng",1);
        ob2->set("gm/owner", this_player()->query("id"));

        command("give fengjiang ping to "+ob->query("id"));

                return "早去早回，路上要小心一些！\n";
}

int accept_object(object me, object obj)
{
       object ob = this_player();


       command( "say "+obj->name()+"?");
         if ( obj->query("id") == "yu feng" && obj->query("owner/id") == ob->query("id"))
        {
               if ( ob->query("family/family_name") == "古墓派" )
                {
                       call_out("reward_dest", 1, obj, ob);
                }
                else 
                {
                       call_out("thank_dest", 1, obj, ob);
                }
       return 1;
        }

       command( "hmm" );
       command( "say 你给我这东西做什麽？" );
return 0;
}

void reward_dest(object obj,object ob)
{
       int exp;
       object me = this_object();

       object ping = present("fengjiang ping",this_player() );
       if(ping)destruct(ping);

       command( "say "+ob->query("name")+"干的不错，下去休息一下吧！\n");
       if(ob->query_temp("gm/feng",1) )
        {
		exp = 150+random(80);
		ob->add("combat_exp",exp);
		ob->add("potential",exp*3/5);
		if(ob->query("potential")>ob->query("max_potential"))
		ob->set("potential",ob->query("max_potential"));
		ob->delete_temp("gm/feng");
		add_temp("job_pos", 1);
		ob->add("gumu/job", 1);
        }
       me->set_temp("job_man", ob->query("id") );
       remove_call_out("clear_job_man");
       call_out("clear_job_man", 20+random(30), me);
       destruct(obj);
}

int clear_job_man(object me)
{
       if ( objectp(me) )
        {
               me->delete_temp("job_man");
        }
       return 1;
}

void thank_dest(object obj,object ob)
{
       command( "say 我很需要这玉蜂，多谢啦！\n");
       destruct(obj);
}

int auto_perform()
{
	object me=this_object();
	object weapon=me->query_temp("weapon");
	object opp=me->select_opponent();

	if( me->query("qi",1) < 0 || me->query("jing",1) < 0 || me->query("jingli",1) < 0) return 1;

	if ( !me->is_fighting() ) {
					 if ( me->query("eff_qi") < me->query("max_qi") )
								me->exert_function("heal");
					 me->set("jiali", 50);

					 return 1;
		  }

		  if ( objectp(weapon) ) {
					 if ( weapon->query("skill_type") == "sword" )
								return perform_action("sword.suxin");
		  }
		  else return perform_action("cuff.luowang");
}