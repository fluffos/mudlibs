//Cracked by Roath
// yu.c 俞莲舟
// updated by liu

inherit NPC;
inherit F_MASTER;
string ask_me(object me);

void create() {
  set_name("俞莲舟", ({ "yu lianzhou", "yu" }));
  set("nickname", "武当二侠");
  set("long",
    "他就是张三丰的二弟子俞莲舟。\n"
    "他今年五十岁，身材魁梧，气度凝重。\n"
    "虽在武当七侠中排名第二，功夫却是最精。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 28);
  set("int", 28);
  set("con", 28);
  set("dex", 28);

  set("max_qi", 1200);
  set("max_jing", 1200);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 50);
  set("combat_exp", 800000);
  set("shen", 80000);

  set("wudang/juehu", 1);

  set_skill("force", 220);
  set_skill("taiji-shengong", 220);
  set_skill("dodge", 220);
  set_skill("tiyunzong", 220);
  set_skill("cuff", 220);
  set_skill("taiji-quan", 220);
  set_skill("strike", 220);
  set_skill("mian-zhang", 220);
  set_skill("parry", 220);
  set_skill("sword", 220);
  set_skill("taiji-jian", 220);
  set_skill("hand", 250);
  set_skill("huzhua-juehu", 250);
  set_skill("taoism", 180);
  set_skill("literate", 150);

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("cuff", "taiji-quan");
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");
  map_skill("hand", "huzhua-juehu");

  prepare_skill("strike", "mian-zhang");
  prepare_skill("hand", "huzhua-juehu");

  set("inquiry", ([
    "虎爪绝户手": (: ask_me :),
    "虎爪手": "“虎爪手”本是我武当派原有的一门极厉害的擒拿手法",
  ]));

  create_family("武当派", 2, "弟子");

  setup();
  if (clonep())
    carry_object("/clone/weapon/qixing-jian",
      "/clone/weapon/changjian")->wield();
  carry_object("/d/wudang/obj/whiterobe")->wear();
}

void attempt_apprentice(object ob) {
  mapping fam;

  if (mapp(fam = ob->query("family")) && fam["family_name"] != "武当派") {
    command("say " + RANK_D->query_respect(this_player())
      + "并非我门中人，习武还是先从各位道长起吧！");
    return;
  }

  if ((int)ob->query_skill("taiji-shengong", 1) < 60) {
    command("say 我武当派乃内家武功，最重视内功心法。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在太极神功上多下点功夫？");
    return;
  }

  if ((int)ob->query("shen") < 80000) {
    command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
    command("say " + RANK_D->query_respect(ob) + "若能做出" +
      "几件侠义之事，我一定收你。");
    return;
  }
  command("say 好吧，既然" + RANK_D->query_respect(ob) + "也是" +
    "我辈中人，今天就收下你吧。");
  command("recruit " + ob->query("id"));
}

string ask_me(object me) {
  mapping fam;
  me = this_player();

  if (me->query("family/family_name") != "武当派") {
    return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
  }

  if (me->query_skill("taiji-shengong", 1) < 100) {
    command("say 我武当派乃内家武功，最重视内功心法。");
    return RANK_D->query_respect(me) + "是否还应该在太极神功上多下点功夫？";
  }

  if (me->query_skill("huzhua-juehu", 1) < 120 || me->query_skill("hand", 1) < 100) {
    command("say 我这绝户之技虽不属正大光明，却也耗我数月之功。");
    return RANK_D->query_respect(me) + "是否还应该在手法上多下点功夫？";
  }

  if (me->query("shen") < 80000) {
    command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
    return RANK_D->query_respect(me) + "若能做出" + "几件侠义之事，我一定授你。";
  }

  if (me->query("wudang/juehu")) return RANK_D->query_respect(me) + "不是早已经得我传授了吗？！";

  me->set("wudang/juehu", 1);
  command("sigh");
  command("say " + RANK_D->query_respect(me) + "也是我辈中人，我就传你这“虎爪绝户手”，也不枉你我相识一场。");
  return "不过你要记得，这路武功是令人断子绝孙、毁灭门户的杀手，若非遇上生死关头，决计不可轻用。";
}
