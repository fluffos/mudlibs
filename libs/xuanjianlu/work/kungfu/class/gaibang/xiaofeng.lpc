//Cracked by Roath
//gaibang npc
//by fear
inherit NPC;
int auto_perform();

void create()
{
        set_name("萧峰", ({ "xiao feng", "xiao", "feng"}));
        set("long", 
"这人身材甚是魁伟，三十来岁年纪，身穿灰色旧布袍，已微有破烂，浓眉大眼，\n"
"高鼻阔口，一张四方的国字脸，颇有风霜之色，顾盼之际，极有威势。\n");
        set("gender", "男性");
        set("age", 32);
        set("attitude", "heroism");
        set("shen_type", 1);
		set("rank",10);
        set("str", 30);
        set("int", 20);
        set("con", 30);
        set("dex", 20);

		set("neili", 8000);
        set("eff_neili", 8000);
        set("max_neili", 8000);
        set("jingli", 5000);
        set("max_jingli", 5000);
        set("eff_jingli", 5000);
        set("jiali", 200);
        set("jiajin",30);

        set("combat_exp", 3000000);
        set("score", 500000);
        set("death_count", 200);
        set("death_times", 200);

        set_skill("force", 300);
        set_skill("dodge", 300);
        set_skill("parry", 300);
        set_skill("blade", 300);
        set_skill("stick", 300);
        set_skill("hand", 300);
        set_skill("strike",300);
        set_skill("literate", 300);
        set_skill("dagou-bang",300);
        set_skill("liuhe-dao", 300);
        set_skill("xianglong-zhang",300);
        set_skill("shexing-diaoshou",300);
        set_skill("xiaoyaoyou", 300);
        set_skill("huntian-qigong", 300);
        set_skill("begging", 300);
        set_skill("checking",300);
        set_skill("digging", 300);
        set_skill("training", 300);
        map_skill("hand", "shexing-diaoshou");
        map_skill("force", "huntian-qigong");
        map_skill("parry", "xianglong-zhang");
        map_skill("blade", "liuhe-dao");
        map_skill("stick", "dagou-bang");
        map_skill("strike", "xianglong-zhang");
        map_skill("dodge", "xiaoyaoyou");
        
        prepare_skill("strike", "xianglong-zhang");

        create_family("丐帮", 13, "帮主");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: auto_perform :),
        }) );

        setup();
        carry_object("/d/gaibang/obj/budai")->set_amount(9);
        carry_object("/d/gaibang/obj/budai")->wear();
        carry_object("/d/gaibang/obj/yellowbang");
}
void init()
{
	object me,player;
	mapping skill_status;
	me=this_object();
	player=this_player();
	if (player->query_temp("pk_azi") ) {
		me->set_temp("pk_azi",player->query("id"));
		remove_call_out("greeting");
		call_out("greeting",1,player);
	}
}
int greeting(object player)
{
	object kurong, yin, can, guan, xiang;
	object me=this_object();
	if ( me->query_temp("pk_azi") == player->query("id") && living(this_player())){
		me->kill_ob(player);
		player->kill_ob(me);

		remove_call_out("checkplay");
		call_out("checkplay",2,player);
		return 1;
	}
	destruct(me);
	return 1;
}

int checkplay(object play)
{
	object azi;
	object me=this_object();
	if (!present(query_temp("pk_azi"),environment(this_object() ) ) ) {
		command ("say 星宿妖人也太不中用了，竟被这么快就被打死了！");
		destruct(me);
		if ( azi=present("azi", environment(me)) ) {
			message_vision("阿紫拍了拍手，做了个鬼脸。\n\n", azi);
		}
		return notify_fail("星宿妖人也太不中用了，竟被这么快就被打死了！\n");
	}
	else { 
		if (!play->is_ghost()) {
			remove_call_out("checkplay");
			call_out("checkplay",1,play);
		}
	}
	return 1;

}

void die()
{
	object ob, me;
	me = this_object();

	if( !living(this_object()) ) revive(1);
	if( objectp(ob = me->query_temp("last_damage_from")) )
	{
		command("say 阿紫，姐夫不能保护你了。");
		ob->delete_temp("pk_azi");
		ob->set_temp("pked_xiaofeng",1);
	}
	::die();
}

int auto_perform()
{
        object me=this_object();
        object weapon=me->query_temp("weapon");
        object opp=me->select_opponent();

        if ( !me->is_fighting() ) {
                if ( me->query("eff_qi") < me->query("max_qi") )
                        exert_function("heal");
                me->set("jiali", 50);

                return 1;
        }

        if ( !me->query_temp("powerup") ) {
			return exert_function("powerup");
        }  
		if(me->query_temp("sanhui") )
		{
			return perform_action("strike.leiting");
		}
		else 
		{
			return perform_action("strike.sanhui");
		} 
}