void destroy_it(object ob)
{
	if(ob)
	destruct (ob);
}

int do_pk(string target)
{
	call_out("do_abuse", 1, target);
}

int do_abuse(string target)
{
	object me = this_player();
	object obj;

	if (target=="azi" && me->query_temp("pk_azi"))
	{
		if (!me->query_temp("abuse_azi"))
		{
			command("sneer "+getuid(me));
			command("say 你要杀我，恐怕我姐夫不答应！\n");
			me->set_temp("abuse_azi", 1);
		} 
		else
		{
			command("fear "+getuid(me));
			command("say 姐夫快来啊，有人要杀我！\n");
			message_vision(HIG"突然山后跳出个大汉挡在阿紫身前！\n"NOR, me);
			message_vision("此人身材甚是魁伟，三十来岁年纪，身穿灰色旧布袍，已微有破烂，浓眉大眼，\n"
"高鼻阔口，一张四方的国字脸，颇有风霜之色，顾盼之际，极有威势。\n\n"NOR, me);

			obj = new("/kungfu/class/gaibang/xiaofeng");
			obj->move(environment(me));
			obj->kill_ob(me);
			me->delete_temp("abuse_azi");
		}
	}
}