//Cracked by Xuanyuan
// chilian_poison.c
// 赤炼神掌毒，冰魄银针毒

#include <ansi.h>

int update_condition(object me, int duration) {
  int damage = 1;
  if (!living(me)) {
    message("vision", me->name() + "浑身溃烂，发出熏天的臭气，引来不少苍蝇。\n", environment(me), ({ me }));
  } else {
    if (me->query("eff_jing") > me->query("max_jing") * 2 / 3) {
      tell_object(me, HIR "忽然一阵晕旋使你急欲作呕，你中的赤炼掌毒发作了！\n" NOR);
      message("vision", me->name() + "头重脚轻，身子突然晃了两晃。\n",
        environment(me), ({ me }));
    } else if (me->query("eff_jing") > me->query("max_jing") / 3) {
      tell_object(me, HIR "你头脑中大感晕眩，只觉中掌处麻木不仁，随即肿大。你中的赤炼掌毒发作了！\n" NOR);
      message("vision", me->name() + "“啊”的一声，捧住心口，险些摔倒在地上。\n",
        environment(me), ({ me }));
      me->start_busy(random(2));
    } else {
      tell_object(me, HIR "你觉得此时咽喉干痛，头涨欲裂，你中的赤炼掌毒发作了！\n" NOR);
      message("vision", me->name() + "身子摇晃几下，随即仆跌下去，摔倒在地上。\n",
        environment(me), ({ me }));
      me->start_busy(random(3));
    }
  }
  if (duration > 0) damage = duration;
  else damage = 10;

  me->receive_wound("jing", damage / 2, "赤炼掌毒攻心死了");
  me->receive_damage("qi", damage / 2, "赤炼掌毒攻心死了");


  if (me->query_condition("chilian_poison") > (5 + me->query_skill("wudu-xinfa", 1) / 10))
    me->apply_condition("chilian_poison",
      duration - 5 - me->query_skill("wudu-xinfa", 1) / 10);
  else return 0;
  //return CND_CONTINUE;
  return 1;
}
