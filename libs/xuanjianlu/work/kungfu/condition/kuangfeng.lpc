// playerkiller.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	if (duration < 1) {
        me->set_temp("apply/speed", 0);
        me->set_temp("apply/attack", 0);
        me->set_temp("apply/dodge", 0);
        me->delete_temp("huashan_kuangfeng");
return 0;
	}
        me->apply_condition("kuangfeng", duration - 1);
	return 1;
}
