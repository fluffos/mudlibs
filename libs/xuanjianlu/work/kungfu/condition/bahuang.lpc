//Cracked by Xuanyuan
//yun bahuang condition

#include <ansi.h>

void remove_effect(object me, int amount);

int update_condition(object me, int duration)
{
	int lvl, dur, drop;

	lvl = (int)me->query_skill("bahuang-gong", 1);
	dur = (int)me->query("neili");
	drop = 200 * 150 / lvl;
	dur = dur - drop;
	if (dur < 100) {
		remove_effect(me, lvl);
		return 0;
	}
	else if((int)me->query("neili",1) > (int)me->query("max_neili",1) ) {
	message_vision(HIW"但见$N鼻中吐出来的白气缠住$N的脑袋周围，缭绕不散，渐渐愈来愈浓，成为一团白雾。\n"NOR, me);
	me->add("neili", -drop);
	}
	else if((int)me->query("neili") > (int)me->query("max_neili",1)/2  ) {
	message_vision(HIR"渐渐的白雾将$N面目都遮没了，跟着只听得$N全身骨节格格作响，犹如爆豆。\n"NOR, me);
	me->add("neili", -drop*2);
	}
	else if((int)me->query("neili") > (int)me->query("max_neili",1)/4  ) {
	message_vision(WHT"过了良久，爆豆声渐轻渐稀，跟着那团白雾也渐渐淡了。\n"NOR, me);
	me->add("neili", -drop*4);
	}else{
	message_vision(WHT"过了良久，爆豆声渐轻渐稀，跟着那团白雾也渐渐淡了。\n"NOR, me);
	me->add("neili", -drop*8);
	}
	me->add("neili", -drop);
	if( me->query("neili") < 0)
	me->set("neili", 0);
	me->apply_condition("bahuang", dur);
	me->start_busy(10+random(30));
	return 1;
}

void remove_effect(object me, int amount)
{
	int lvl, drop,i, point, count;
	mapping skill_status;
	string *sname;

	lvl = (int)me->query_skill("bahuang-gong", 1);
	drop = 200 * 150 / lvl;

	me->delete_temp("bahuang");
	me->set("age",me->query("bahuang/temp_age"));
	me->delete("bahuang/temp_age");
	if(!me->query("bahuang_age")){
	me->set("bahuang_age", me->query("age"));
	}

	me->set("combat_exp",me->query("bahuang/temp_exp"));
	me->delete("bahuang/temp_exp");
	if(!me->query("bahuang_exp")){
	me->set("bahuang_exp", me->query("combat_exp"));
	}

	if (me->query("got_beiming"))
	{
		tell_object(me, "你身具北冥神功，分心之即八荒六合唯我独尊功的功效不能完全发挥出来。\n");
	}else{
		tell_object(me, "你借助八荒六合唯我独尊功的功效大大的提升了自己的武功，同时身法提升了二点！\n");
		me->add("dex", 2);
		me->add("combat_exp", (int)me->query("combat_exp",1)/10);
		if ( mapp(skill_status = me->query_skills()) ) {
                skill_status = me->query_skills();
                sname = keys(skill_status);
                count = sizeof(skill_status);

                for(i=0; i<sizeof(skill_status); i++) {
			point = (skill_status[sname[i]]+1)*(skill_status[sname[i]]+1)/2+1;
			while ( (point /= 2) > 0 )
                        	me->improve_skill(sname[i], point*20 + 1); 
                }
        }
	}
	me->add("max_neili", drop);
	me->add("max_jingli", drop);
	me->add("eff_jingli", drop);

	me->add("bahuang_effect", 1);
	message_vision(HIY"$N鼻孔中不断吸入白雾，待得白雾吸尽，$N睁开双眼，缓缓站起。\n"NOR, me);
//	tell_object(me, "你的八荒六合唯我独尊功运行完毕。\n");
}


