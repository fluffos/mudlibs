#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;
void death(object me);

int update_condition(object me, int duration) {
  if (duration == 80) {
    tell_object(me, WHT "你大限已至，此时回首前尘往事茫然若失，不禁干咳了几声。\n" NOR);
    message("vision", me->name() + "干咳了几声。\n", environment(me), me);
  } else if (duration == 60) {
    tell_object(me, WHT "你淡淡一笑，一张脸全成蜡黄，目光呆滞看向远方。\n" NOR);
    message("vision", me->name() + "淡淡一笑，一张脸全成蜡黄，目光呆滞看向远方。\n", environment(me), me);
  } else if (duration == 40) {
    tell_object(me, WHT "你感觉身体有些不听使唤，周围的空气渐渐地稀薄。\n" NOR);
    message("vision", me->name() + "的行动开始变的迟缓，不时的喘着粗气。\n", environment(me), me);
  } else if (duration == 20) {
    ;
    tell_object(me, WHT "你感觉手脚的力量已经开始脱离了身体，你强忍一口气慢慢地躺在了地下。\n" NOR);
    message("vision", me->name() + "双颊深陷，支持着躺在地下，人已死去大半。\n", environment(me), me);
    me->start_busy(20);
  } else if (duration == 0) {
    tell_object(me, WHT "你口里喃喃念着：“英雄，英雄……”渐渐的合上了双眼。\n" NOR);
    message("vision", me->name() + "临死之际，口里喃喃念着：“英雄，英雄……”双目一闭，就此逝去。\n", environment(me), me);
    me->start_busy(10);
    call_out("death", 1, me);
  }
  me->apply_condition("death", duration - 1);
  if (duration < 1) return 0;
  return CND_CONTINUE;
}

void death(object me) {
  //		tell_object(me, HIY"\n您的帐号已经寿终正寝，如果想继续使用此帐号进行游戏，请您联系巫师申请清除现有档案。\n"NOR);
  me->start_busy(10);
  me->delete("waiting_death");
  me->set("final_death", 1);
  me->move("/d/death/gate.lpc");
}
