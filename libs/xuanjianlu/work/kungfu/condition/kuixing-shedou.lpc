#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  int con, kar, i;

  if (duration < 1) return 0;

  kar = me->query_kar();

  if (random(30) < kar) return CND_CONTINUE;

  con = me->query_con();

  con > 40 ? i = random(2) : con > 30 ? i = random(3) : con > 20 ? i = random(2) + 1 : i = 2;

  if (i) {
    me->start_busy(i);
    tell_object(me, HIY "你被封的穴道传来一阵酸痛，行动变得迟缓了！\n" NOR);
  }

  me->apply_condition("kuixing-shedou", duration - 1);
  return CND_CONTINUE;
}
