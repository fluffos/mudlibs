// dzxy.c

#include <ansi.h>

int update_condition(object me, int duration)
{
        if (duration < 1) {
                tell_object(me, HIG"\n你终于压制住翻涌的内劲，感觉舒服过了！\n"NOR);
                return 0;
        }
        me->apply_condition("tong", duration - 1);
        me->add("neili",-(10+random(80)));
		if (me->query("neili")<0)
		{
			me->set("neili",0)
		}
        tell_object(me, RED"\n斗转星移消耗巨大，你只感内息不畅！\n"NOR);
        return 1;
}
