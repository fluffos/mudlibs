#include <ansi.h>
inherit F_DBASE;
inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, weapon1;
  string str, msg, dodge_skill;
  int skill, extra, dodge, speed, parry, yunqi, damage;
  mapping myfam;

  if (!target) target = offensive_target(me);

  if ((!(myfam = me->query("family")) || myfam["family_name"] != "神龙教"))
    return notify_fail("你并非神龙弟子,无法使用“绝命连环踢”！\n");


  if (me->query_temp("weapon"))
    return notify_fail("你只能在空手时使用“绝命连环踢”！\n");


  if (me->query_temp("yield"))
    return notify_fail("你目前无法使用“绝命连环踢”！\n");

  if (me->query_skill_mapped("force") != "dulong-dafa")
    return notify_fail("你的内功并非毒龙大法，无法施展“绝命连环踢”。\n");

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("“绝命连环踢”只能在战斗中使用。\n" NOR);
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");



  if ((int)me->query_skill("dulong-dafa", 1) < 200)
    return notify_fail("你的毒龙大法修为未到，无法施展“绝命连环踢”。\n" NOR);

  if ((int)me->query_skill("jueming-tui", 1) < 200)
    return notify_fail("你的绝命腿修为还不够，尚未领悟到“绝命连环踢”。\n" NOR);

  if (me->query("max_neili") < 1000)
    return notify_fail("你的内力修为不足，劲力不足以施展“绝命连环踢”！\n" NOR);

  if ((int)me->query("neili", 1) < 500)
    return notify_fail("你现在内力不够，劲力不足以施展“绝命连环踢”！\n" NOR);

  if (me->query("jingli") <= 300)
    return notify_fail("你的精力不足，无法施展“绝命连环踢”！\n" NOR);
  extra = (int)me->query_skill("jueming-tui", 1);
  damage = extra / 3 + random(extra / 2);

  dodge_skill = me->query_skill_mapped("dodge");
  if (!dodge_skill) dodge_skill = "轻功";
  else dodge_skill = to_chinese(dodge_skill);

  if (random(me->query("combat_exp")) * 3 > target->query("combat_exp")) {
    if (me->query("shenlong/jueming") == 1) {
      message_vision(HIG "\n$N将内力凝聚于右腿，突然凌空纵起，对准$n当胸踢去，端的是又快又狠！\n" NOR, me, target);
      message_vision(NOR "结果只听「砰」地一声巨响，$n胸口被$N重重地踢了一脚！！\n" NOR, me, target);
      target->receive_damage("qi", damage * 5, "被" + me->query("name") + "震碎心脉而死");
      target->receive_wound("qi", random(damage) * 5, "被" + me->query("name") + "震碎心脉而死");
      str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));

      message_vision("($N" + str + ")\n", target);
      me->start_call_out((: call_other, __FILE__, "over", me, skill / 2 :), skill / 15);
      me->add("neili", -extra * 2);
      me->add("jingli", -extra);
      me->add("shenlong/jm", 1);
      me->start_busy(random(2) + 2);
      if (me->query("shenlong/jm") == 30) {
        me->add("shenlong/jueming", 1);
        tell_object(me, BRED + HIY "通过实战你领悟到第二重的“绝命连环踢”\n" NOR);
      }
      return 1;
    }
    if (me->query("shenlong/jueming") == 2) {

      message_vision(HIG "\n$N将内力凝聚于右腿，突然凌空纵起，对准$n当胸踢去，端的是又快又狠！\n" NOR, me, target);
      message_vision(NOR "结果只听「砰」地一声巨响，$n胸口被$N重重地踢了一脚！！\n" NOR, me, target);
      target->receive_damage("qi", damage * 5, "被" + me->query("name") + "震碎心脉而死");
      target->receive_wound("qi", random(damage) * 5, "被" + me->query("name") + "震碎心脉而死");
      str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));

      message_vision("($N" + str + ")\n", target);
      me->start_call_out((: call_other, __FILE__, "over", me, skill / 2 :), skill / 15);
      message_vision(
        HIY "\n$N膝不曲，腰不弯，陡然滑出，施展「" + dodge_skill + "」平平飘至$n身后，双脚踏出，迅如电闪！\n" NOR,
        me,
        target
      );
      message_vision(NOR "结果只听「砰」地一声巨响，$n后心被$N重重地踢了一脚！口中鲜血狂喷！\n" NOR, me, target);
      target->receive_damage("qi", damage * 5, "被" + me->query("name") + "震碎心脉而死");
      target->receive_wound("qi", random(damage) * 5, "被" + me->query("name") + "震碎心脉而死");
      str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));

      message_vision("($N" + str + ")\n", target);
      me->start_call_out((: call_other, __FILE__, "over", me, skill / 2 :), skill / 15);
      me->add("neili", -extra * 3);
      me->add("jingli", -extra * 2);
      me->start_busy(random(2) + 3);
      if (me->query("shenlong/jm") == 90) {
        me->add("shenlong/jueming", 1);
        tell_object(me, BRED + HIY "通过实战你领悟到第三重的“绝命连环踢”\n" NOR);
      }
      me->start_busy(random(2) + 1);
      return 1;
    }
    if (me->query("shenlong/jueming") == 3) {

      message_vision(HIG "\n$N将内力凝聚于右腿，突然凌空纵起，对准$n当胸踢去，端的是又快又狠！\n" NOR, me, target);
      message_vision(NOR "结果只听「砰」地一声巨响，$n胸口被$N重重地踢了一脚！！\n" NOR, me, target);
      target->receive_damage("qi", damage * 5, "被" + me->query("name") + "震碎心脉而死");
      target->receive_wound("qi", random(damage) * 5, "被" + me->query("name") + "震碎心脉而死");
      str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));

      message_vision("($N" + str + ")\n", target);
      me->start_call_out((: call_other, __FILE__, "over", me, skill / 2 :), skill / 15);
      message_vision(
        HIY "\n$N膝不曲，腰不弯，陡然滑出，施展「" + dodge_skill + "」平平飘至$n身后，双脚踏出，迅如电闪！\n" NOR,
        me,
        target
      );
      message_vision(NOR "结果只听「砰」地一声巨响，$n后心被$N重重地踢了一脚！口中鲜血狂喷！\n" NOR, me, target);
      target->receive_damage("qi", damage * 5, "被" + me->query("name") + "震碎心脉而死");
      target->receive_wound("qi", random(damage) * 5, "被" + me->query("name") + "震碎心脉而死");
      str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));

      message_vision("($N" + str + ")\n", target);
      me->start_call_out((: call_other, __FILE__, "over", me, skill / 2 :), skill / 15);
      message_vision(HIB "\n$n连中两腿以后，身体摇摇欲坠，$N见况身形一沉，双腿如风车般旋起，\n" NOR, me, target);
      message_vision(HIB "卷起半天尘埃，威势惊人，直将$n围裹其中！\n" NOR, me, target);
      message_vision(HIR "只听一声惨叫，$n直跌出一丈开外，扭曲了几下，便即不动！\n" NOR, me, target);
      target->receive_damage("qi", damage * 5, "被" + me->query("name") + "震碎心脉而死");
      target->receive_wound("qi", random(damage) * 5, "被" + me->query("name") + "震碎心脉而死");
      str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));
      target->start_busy(random(20) + 5);
      message_vision("($N" + str + ")\n", target);
      me->start_call_out((: call_other, __FILE__, "over", me, skill / 2 :), skill / 15);
      me->add("neili", -extra * 4);
      me->add("jingli", -extra * 3);
      me->start_busy(random(2) + 4);
      return 1;
    }

  } else {
    message_vision(HIG "$n看出$N要出猛招，急忙攻向$N右腿，$N不得不将右腿内力散去。\n" NOR, me, target);
    me->start_busy(random(5) + 3);
  }
  return 1;
}
