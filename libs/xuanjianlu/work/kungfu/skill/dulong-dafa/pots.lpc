// 测试
// 经验转换潜能

#include <ansi.h>

int exert(object me, object target) {
  mapping myfam;
  if (me->is_fighting())
    return notify_fail("战斗中无法转换！\n");
  if ((!(myfam = me->query("family")) || myfam["family_name"] != "神龙教"
  ))
    return notify_fail("你并非神龙弟子,无法使用毒龙大法！\n");

  if ((int)me->query_skill("dulong-dafa", 1) < 100)
    return notify_fail("你的毒龙大法为还不够。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");

  if ((int)me->query("potential") >= (int)me->query("max_potential"))
    return notify_fail("你现在不须要转换！\n");



  me->set("potential", (int)me->query("max_potential"));
  me->add("combat_exp", -(int)me->query("max_potential"));

  write(YEL "\n 你运用毒龙大法将" + (int)me->query("max_potential") + "经验转换为" + (int)me->query("max_potential") + "潜能。\n" NOR);
  message("vision",
    YEL + me->name() + "运用毒龙大法将经验转换潜能。\n" NOR,
    environment(me), me);


  return 1;
}
