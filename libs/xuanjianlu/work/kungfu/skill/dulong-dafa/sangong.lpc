// 自由运用毒

#include <ansi.h>

int exert(object me, object target)
{

        if (!(me->query_temp("hgmz_powerup")))
                return notify_fail("你并没有运用化骨绵掌之毒！\n");

	if ((int)me->query_skill("dulong-dafa", 1) < 100)
		return notify_fail("你的毒龙大法修为还不够。\n");
	if ((int)me->query_skill("huagu-mianzhang", 1) < 100)
		return notify_fail("你的化骨绵掌修为还不够。\n");
	if ((int)me->query_skill("poison", 1) < 100)
		return notify_fail("你的基本毒技修为还不够。\n");
	if ((int)me->query_skill("medicine", 1) < 100)
		return notify_fail("你的药理学修为还不够。\n");

	if( (int)me->query("neili") < 500 )
		return notify_fail("你的内力不够。\n");
	if( (int)me->query("jingli") < 300 )
                return notify_fail("你的精力不够。\n");

	message_vision(HIY"\n$N呼出一口气，手掌之上出现的小点慢慢淡去。\n" NOR, me);

        me->delete_temp("hgmz_powerup");

        me->add("neili", -200);

	return 1;
}
