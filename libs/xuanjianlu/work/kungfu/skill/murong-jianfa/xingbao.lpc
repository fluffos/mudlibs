/******************
Cname:  慕容星爆
Ename:  xingbao
Create: Play
Time:   3/10/2002
********************/
#include <ansi.h>
inherit F_SSERVER;

int perform(object me, object target)
{
        string msg,*limbs,line;
        mapping M_apply, T_apply, M_dbase, T_dbase, map;
        int i,k,dam,size,damage,doubling;
        int myw_skill, myf_skill;
        int M_exp, M_dam, M_dod;
        int T_exp, T_par, T_dod;
        object weapon;
        line = HIG"慕容"+HIB"星爆"NOR;
       
        if ( me->query_temp("murong-xingbao") ) 
                return notify_fail("你刚发动过"+line+"，正在调理气息。\n");

        if (me->query("family/family_name") != "姑苏慕容") 
                return notify_fail("你不是慕容传人，不能使用慕容世家的嫡传武功。\n");

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail(line+"只能对战斗中的对手使用。\n");

        if( ( myw_skill = (int)me->query_skill("murong-jianfa",1)) < 200)
                return notify_fail(line+"需要高深的慕容剑法才能发动。\n");

        if( ( myf_skill = me->query_skill("douzhuan-xingyi",1)) < 200)
                return notify_fail("发动"+line+"需要高深的斗转星移心法。\n");

        if( me->query_skill("murong-shenfa",1 ) < 180)
                return notify_fail("你的慕容身法不够纯熟，无法发动"+line+"。\n");

                weapon = me->query_temp("weapon");
        if( !objectp(weapon) || weapon->query("skill_type")!= "sword" )
                return notify_fail("你手中无剑，如何使用"+line+"！\n");

                map = me->query_skill_map();
        if( undefinedp(map["sword"]) || map["sword"] != "murong-jianfa" )
                return notify_fail(line+"需要使用慕容剑法方能发动。\n");

        if( undefinedp(map["force"]) || map["force"] != "douzhuan-xingyi" )
                return notify_fail(line+"需要使用斗转星移心法方能发动。\n");
                
                M_dbase = me->query_entire_dbase();
                T_dbase = target->query_entire_dbase();
        if( M_dbase["max_neili"] < 1000 || M_dbase["neili"] < 600 )
                return notify_fail("你的内力不足，无法发动"+line+"攻击对手。\n");
  
        if( M_dbase["jing"] < 120 || M_dbase["jingli"] < 120 )
                return notify_fail("你目前的精神无法使用"+line+"。\n");
        
        if(me->query("env/murong-xingbao"))
        {
                msg = HIW"$N一声爆喝身体陡然向上拔高，手中"+weapon->name()+
                         "光芒爆闪，砰然炸开的"+weapon->name()+ 
                         "碎片化作无数寒星向$n激射而出 ...\n"NOR;
                doubling = 1;
        }
        else
                msg = HIC"$N身体急旋闪出丈外，手掐剑诀、步罡踏斗，所握"+weapon->name()
                        +"幻化出道道光影，刺眼光幕向$n全身罩去 ...\n"NOR;
        message_vision(msg,me,target);
        call_out("wait_end_xingbao",(50-me->query_con())<5?5:50-me->query_con(),me);
        call_out("clear_one_condition",2,me,"sword");
        me->set_temp("murong-xingbao",1);
        
        M_apply = me->query_temp("apply");
        T_apply = target->query_temp("apply");

        M_dod = me->query_skill("dodge");
        M_dam = me->query_skill("sword");
        T_par = target->query_skill("parry");
        T_dod = target->query_skill("dodge");

        limbs = target->query("limbs");
 
        me->start_busy(2);
        me->add("neili",-200);
        M_exp = me->query_dex() + M_dod/10 + M_dam/10;
        T_exp = target->query_dex() + T_dod/10 + T_par/10;
        
        if( M_exp > random(T_exp / 2) )
          {
                size=(int)((myf_skill+myw_skill)/40);           
                dam=M_dbase["jiali"]/2;
                dam+=((me->query_str()+M_apply["damage"]+M_apply["attack"])
                   -(target->query_con()+T_apply["armor"]+T_apply["defense"]
                   >T_apply["dodge"]?T_apply["defense"]:T_apply["dodge"]));
                
             if( M_dbase["combat_exp"] < T_dbase["combat_exp"] /2 )
                size = size - T_dbase["combat_exp"]/2/M_dbase["combat_exp"];
             if( size > 15 ) size = 14+random(size-14);
             if( size >= 1 )
               {
                      msg = CYN"只见$N身形不断变换，回旋穿梭，以应来袭！\n" NOR;
                      message_vision(msg, target);
                 for(i=0;i<=size;i++)
                    {
                      if( (dam > 1 && random(dam) < size) ||
                           M_dbase["neili"]<M_dbase["jiali"]/2 ) damage = dam-dam;
                      else damage = dam;
                      if( damage < 1 )
                        {
                            if(!doubling)
                                msg = CYN"一道"NOR+WHT"剑芒"NOR+CYN"漫无章法地从$N"+
                                limbs[random(sizeof(limbs))]+"旁激射而过。。。\n"NOR;
                            else
                                msg = CYN"一枚断刃"HIY"“嗖”"NOR+CYN"的一声从$N"+
                                limbs[random(sizeof(limbs))]+"旁飞过。。。\n"NOR;
                                me->start_busy(random(2));
                       }else
                       {
                            if(!doubling) 
                                msg = "一道凌厉的"HIW"剑芒"NOR"刺入$N"+
                                limbs[random(sizeof(limbs))]+"。。。\n";
                             else
                             {
                                msg = "一枚锋利的断刃"HIR"“哧”"NOR"的一声射入$N"+
                                limbs[random(sizeof(limbs))]+"。。。\n";
                                k++;
                              }
                            target->receive_damage("qi",doubling?damage:damage*3/2,me);
                            target->receive_wound("qi",doubling?damage/3:damage/2,me);
                       }
                            target->start_busy(random(k/2));
                            if(M_dbase["neili"]>M_dbase["jiali"]/2)
                            me->add("neili",-M_dbase["jiali"]/2);
                            else me->add("neili",0);
                            me->add("jingli", -(30-me->query_kar()));
                            message_vision(msg,target);
                    }
                    if(doubling)
                      {
                        if(random(k*5)+3>target->query_kar())
                        target->apply_condition("murong-xingbao", k);
                        weapon->unequip();
                        destruct(weapon);
                      }
                      msg = HIB"结果$N被攻的手忙脚乱，左右难支！\n" NOR;
                      message_vision(msg, target);
                      COMBAT_D->report_status(target);
                      return 1;
                } else 
                msg = "$N左躲右闪，利用丰富的战斗经验，化解了$n攻击。\n" NOR;
                message_vision(msg, target,me);
                return 1;
         }
         msg="$N将身一晃，轻而易举的化解了$n的攻击。";
         message_vision(msg, target,me);
         return 1;
}

int wait_end_xingbao(object me)
{
        remove_call_out("wait_end_xingbao");
        me->delete_temp("murong-xingbao");
        return 1;
}
int clear_one_condition(object me,string skill)
{ 
        remove_call_out("clear_one_condition");
          me->clear_one_condition(skill);
        return 1;
}
