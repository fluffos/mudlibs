// duo.c 波斯武功之夺
// lbc 3/2002

//流云使举起两根圣火令，双手一振，已搭在屠龙刀上。张无忌只感手掌中一阵激烈跳动
//，屠龙刀竟欲脱手，大骇之下，忙加运内力。流云使以圣火令夺人兵刃，原是手到擒来，
//千不一失，这一次居然夺不了对方单刀，大感诧异。辉月使一声娇叱，手中两根圣火令也
//已架在屠龙刀上，四令夺刀，威力更巨。
//张无忌身上已受了七八处伤，虽然均是轻伤，内力究已大减，这时但感半边身子发热，握着
//刀柄的右手不住发颤。
//蓦然间大喝一声，体内九阳神功源源激发。流云、辉月二使脸色齐变，妙风使见情势不对，
//一根圣火令又搭到了屠龙刀上。
//霎时间四人均凝立不动，各运内力。突然之间，张无忌胸口一痛，似乎被一枚极细的尖针
//刺了一下。张无忌手一松，屠龙刀便被五根圣火令吸了过去。 
// this is very cool~

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int attack_power(object user);
int defense_power(object user);
int single_duo(object target);
int multi_duo(object target);
int checking(object *duoer, object target, object weapon);
//int end_duo(object user);

int perform(object me, object target)
{
	object weapon1, weapon2, *inv;
	int ling_num, all_ling_num, lvl1, lvl2, cost, i;
	string ling_cnum, all_ling_cnum, duo_msg1, duo_msg2, w2_name, w2_type;

	if( !target ) 
		target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target))
		return notify_fail("你只能夺战斗中对手的兵刃。\n");

    	if ( !(weapon1 = me->query_temp("weapon")) )
		return notify_fail("你无法空手夺兵刃。\n");
	
	if ( weapon1->query("id") != "shenghuo ling" )
		return notify_fail("你只能用圣火令夺兵刃。\n");
	
	if ( !(weapon2 = target->query_temp("weapon") ) )
		return notify_fail("对手并未使用兵刃。\n");

	if ( (lvl1 = me->query_skill("shenghuo-ling", 1)) < 100)
		return notify_fail("你的古波斯武功还不够纯熟。\n");

	if ( (lvl2 = me->query_skill("force")) < 150)
		return notify_fail("你的内功修为不足。\n");
	
	if( me->query("neili") < 500 )
		return notify_fail("你的内力不够。\n");

	if( me->query("jingli") < 300 )
		return notify_fail("你的精力不够。\n");

////////////////////////////////////////////////////
	w2_name = weapon2->query("name");
	w2_type = w2_name[(sizeof(w2_name)-2)..(sizeof(w2_name)-1)];
	//这里有些问题，某些name为COLOR"兵器"COLOR的兵器显示有问题
	
	inv = all_inventory(me);
	ling_num = 0;
	for (i = 0; i < sizeof(inv); i++) 
	// 计算所持圣火令根数, 因为暂时不能wield 2 lings, 所以暂时无用
	{
		if ( inv[i]->query("equipped") && (inv[i]->query("id") == "shenghuo ling"))
			ling_num ++;
	}
//	ling_num = weapon1->query_amount();
	
	ling_cnum = chinese_number(ling_num);
	
	if (ling_num == 2 )	
		ling_cnum = "两根";
	else 
		if (ling_num > 2)	
			ling_cnum = ling_cnum + "根";
	else 
		ling_cnum = "一根";
	cost = (lvl1 + lvl2) /2;
	if (cost > 250)
		cost = 250;
	me->add("neili", -cost);
	me->add("jingli", -cost);

///////////////////////////////////////////////////////////////////////////	
	
	
	if (!target->query_temp("bosi/duo/ling_num")) // 单人夺兵刃
    {
		target->add_temp("bosi/duo/ling_num", ling_num);
		target->add_temp("bosi/duo/duoer", ({ me }) );

		duo_msg1 = HIG"\n$N"HIG"欺身向前，举起" + ling_cnum + "圣火令，";
		if (ling_num == 2)
			duo_msg1 += "双";
                     duo_msg1 = duo_msg1 + "手一振，已搭在" + w2_name + HIG"上！\n\n"NOR;

		message_vision(duo_msg1, me, target);
		single_duo(target);
	}
	else // n人夺兵刃,  1 < n <= ｘｋｘ所有圣火令总根数
	{
		target->add_temp("bosi/duo/ling_num", ling_num);
		target->add_temp("bosi/duo/duoer", ({ me }) );
		all_ling_num = target->query_temp("bosi/duo/ling_num");
		all_ling_cnum = chinese_number(all_ling_num);
		duo_msg2 = HIW"\n$N"HIW"一声" + (me->query("gender") == "男性" ?  "大喝" : "娇叱");
		duo_msg2 = duo_msg2 + "，手中" + ling_cnum + "圣火令也已架在" + (string)w2_name + HIW"上，" + all_ling_cnum + HIW"令相夺，威力更巨！\n\n"NOR;
		message_vision(duo_msg2, me, target);
		multi_duo(target);
	}
	return 1;	
}

int single_duo(object target)
{
	int ap, dp;
	object me, *duoer, weapon;
	duoer = target->query_temp("bosi/duo/duoer");
	weapon = target->query_temp("weapon");
	me = duoer[0];
	ap = attack_power(me);
	dp = defense_power(target);
	if (wizardp(me))
		printf("single ap = %d, dp = %d\n", ap, dp);

	if (random(ap) > dp )
	{
		message_vision(HIR"$n"HIR"只感手掌中一阵激烈跳动，" + weapon->name() + HIR"脱手而出，被圣火令吸了过去。\n\n"NOR, me, target);
		remove_call_out("checking");
		weapon->move(me);
		target->delete_temp("bosi/duo/duoer");
		target->delete_temp("bosi/duo/ling_num");
		return 1;
	}
	else
	{
		message_vision(HIG"$n"HIG"只感手掌中一阵激烈跳动，" + weapon->name() + HIG"竟欲脱手，大骇之下，忙加运内力。\n\n"NOR, me, target);
		me->start_busy(2);
		target->start_busy(target->query_busy() + 2);
		remove_call_out("checking");
		call_out("checking", 1, duoer, target, weapon);
		return 1;
	}
}

int multi_duo(object target)
{
	int ap, dp, i, wizs;
	object *duoer, weapon;
	duoer = target->query_temp("bosi/duo/duoer");
	weapon = target->query_temp("weapon");
	ap = 0;
	wizs = 0; //for test
	for (i = 0;i < sizeof(duoer) ; i ++) // 累加ｎ人的攻击力
	{
		ap = ap + attack_power(duoer[i]);
		wizs++;
	}
	dp = defense_power(target);
	if (wizs)
		printf("multi ap = %d, dp = %d duoer = %d\n", ap, dp, sizeof(duoer));
	if (random(ap) > dp )
	{
		message_vision(HIR"$n"HIR"又感手掌中一阵激烈跳动，" + weapon->name() + HIR"脱手而出，被圣火令吸了过去。\n\n"NOR, target, target);
		remove_call_out("checking");
		weapon->move( duoer[random(sizeof(duoer))] );
		target->delete_temp("bosi/duo/duoer");
		target->delete_temp("bosi/duo/ling_num");
		return 1;
	}
	else
	{
		message_vision(HIG"$n"HIG"又感手掌中一阵激烈跳动，" + weapon->name() + HIG"几乎脱手，大骇之下，忙加运内力。\n\n"NOR, target, target);
		duoer->start_busy(2); // 这种用法表示duoer全体
		target->start_busy(target->query_busy() + 2);
		remove_call_out("checking");
		call_out("checking", 1, duoer, target, weapon);
		return 1;
	}
}

int attack_power(object user)
{
	int neili, force, str, power;
	neili = user->query("neili") / 20;
	force = user->query_skill("force") / 2;
	str = user->query_str() / 10;
	power = neili * force * str;
	return power;
}

int defense_power(object user)
{
	int neili, force, str, power;
	neili = user->query("neili") / 20;
	force = user->query_skill("force") / 2;
	str = user->query_str() / 10;
	power = neili * force * str;
	return power;
}

int checking(object *duoer, object target, object weapon)
{
	int ap, dp, ppl_num, i, wizs;
	string ppl_cnum, force_skill, msg1, msg2;
	
	
	
	if (!target 
		|| !living(target) //你死了？那就撒手吧，呵呵
		|| environment(weapon) != target) //兵器因其他方法脱手
	{
		tell_room(environment(duoer[0]), CYN + weapon->name() + CYN + "上的力道一松，向上飞出，落在地上。\n\n" + NOR);
		weapon->move(environment(duoer[0]));
		if (target)
		{
			target->delete_temp("bosi/duo/ling_num");
		}
		return 1;
	}

	ap = 0;
	wizs = 0; //for test
	for (i = 0; i < sizeof(duoer); i++ )
	{
		if ( !duoer[i] 
			|| !living(duoer[i])
			|| !duoer[i]->is_fighting(target) 
			|| environment(duoer[i])!=environment(target))  // 夺兵器者消失了？或者昏迷，去掉标记
		{
			duoer = duoer - ({ duoer[i] });
			target->set_temp("bosi/duo/duoer", duoer);			// 这儿是否存在圣火令数量的问题，测试后才知道
			continue;
		}
		ap = ap + attack_power(duoer[i]); // 没死？ok, 累加power
		if (wizardp(duoer[i]))
			wizs++;
	}
	
	dp = defense_power(target);

	ppl_num = sizeof(duoer);
	
	if (wizs)
		printf("deadlock ap = %d, dp = %d, duoer = %d\n", ap, dp, ppl_num);
	
	if (!ppl_num)
	{
		tell_room(environment(target), CYN + target->name() + weapon->name() + CYN + "上吸力骤减，顿时松了口气。\n\n" + NOR);
		target->delete_temp("bosi/duo/ling_num");
		return 1;
	}
	
	force_skill = to_chinese(target->query_skill_mapped("force"));
	ppl_cnum = chinese_number(ppl_num + 1);
	tell_room(environment(target), HIW + ppl_cnum + "人凝立不动，各运内力……\n\n" + NOR);
	duoer->start_busy(2);
	target->start_busy(2);

	if (random(2))
	{
		if(!find_object("/kungfu/skill/shenghuo-ling/tougu")) 	
			load_object("/kungfu/skill/shenghuo-ling/tougu");

		call_other("/kungfu/skill/shenghuo-ling/tougu", "perform", duoer[random(sizeof(duoer))], target);
		//hehe, come on, man~
	}
	
	if (random(ap) > dp)
	{
		tell_room(environment(target), HIB + target->name() + HIB + "握着" + weapon->name() + HIB + "的手不住发颤，突然手一松，" + weapon->name() + HIB + "便被圣火令吸了过去。\n\n" + NOR);
		weapon->move( duoer[random(sizeof(duoer))] );
		target->delete_temp("bosi/duo/duoer");
		target->delete_temp("bosi/duo/ling_num");
		return 1;
	}
	else if (random(ap) < (ap /3))
	{
		msg1 = "";
		if (!force_skill)
			force_skill = "真气";
		
		msg1 = msg1 + HIY"" + target->name() + HIY"蓦然间"+ (target->query("gender") == "男性" ?  "大喝" : "娇叱") +"一声，体内" + force_skill + "源源激发，";
		msg2 = msg1;
		if (sizeof(duoer) < 2)
		{
			msg1 = msg1 + duoer[0]->name() + "脸色大变，只得撤回手中圣火令。\n\n" + NOR;
			msg2 = msg2 + "你脸色大变，只得撤回手中圣火令。\n\n" + NOR;
		}
		else 
		{
			msg1 = msg1 + "对面" + chinese_number(ppl_num) + "人脸色齐变，只得撤回手中圣火令。\n\n" + NOR;
			msg2 = msg2 + "你们" + chinese_number(ppl_num) + "人脸色齐变，只得撤回手中圣火令。\n\n" + NOR;
		}
		tell_room(environment(target), msg1, duoer );
		tell_object(duoer, msg2);
		duoer->start_busy(2);
		target->delete_temp("bosi/duo/duoer");
		target->delete_temp("bosi/duo/ling_num");
		return 1;
	}
	
	call_out("checking", 1, duoer, target, weapon);
}
