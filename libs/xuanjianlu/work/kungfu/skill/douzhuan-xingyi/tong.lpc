// 斗转星移之一通百通
// liu@xjl 2002
#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;
inherit F_CLEAN_UP;

#include "shaolin.h"
#include "gaibang.h"
#include "mizong.h"
#include "emei.h"
#include "quanzhen.h"
#include "wudang.h"
#include "gumu.h"
#include "dali.h"
#include "huashan.h"
#include "lingjiu.h"
#include "taohua.h"
#include "xingxiu.h"
#include "baituo.h"
#include "murong.h"

int num = 14;
int perform(object me, object target)
{
        int i;
        string color;
        if( target == me)target=offensive_target(me);
        if( !target )target = offensive_target(me);
        if( !target )target = me->select_opponent();

//		if( !wizardp(me) ) return notify_fail("一通百通暂不开放！\n");

        if( !me->is_fighting() || !me->is_fighting(target) || !living(target) ) return notify_fail("一通百通只能在战斗中使用。\n");

        if( environment(me)->query("no_fight") ) return notify_fail("在这里不能攻击他人。\n");

        if( userp(me) && me->query_condition("pker") > 240) return notify_fail("你感到一丝内疚，手突然软了下来！\n");

        if( me->query_temp("weapon") ) return notify_fail("手握兵器不能运用一通百通。\n");

        if( me->query_temp("yield") ) return notify_fail("你不出手，如何使出一通百通？\n");
        if(!me->query_temp("douzhuan-xingyi") ) return notify_fail("你没有使用特殊攻击斗转星移（perform douzhuan），所以无法近一步使用一通百通。\n");
        if( me->query_temp("tong") ) return notify_fail("你正在运用斗转星移一通百通。\n");
        if( me->query_condition("dzxy") ) return notify_fail("你血气翻涌，无法继续使用一通百通。\n");
        if( me->query_skill("douzhuan-xingyi",1) < 300 ) return notify_fail("你斗转星移的修为不够。\n");
        if( me->query_skill("force",1) < 300 ) return notify_fail("你的内功修为不够。\n");
        if( me->query_skill("parry",1) < 300 ) return notify_fail("你的基本招架修为不够。\n");
        if( me->query_skill("strike",1) < 300 ) return notify_fail("你的基本掌法修为不够。\n");
        if( me->query_skill("hand",1) < 300 ) return notify_fail("你的基本手法修为不够。\n");
        if( me->query_skill("finger",1) < 300 ) return notify_fail("你的基本指法修为不够。\n");
        if( me->query_skill("claw",1) < 300 ) return notify_fail("你的基本爪法修为不够。\n");
        if( me->query_skill("cuff",1) < 300 ) return notify_fail("你的基本拳法修为不够。\n");
        if( me->query_skill("kick",1) < 300 ) return notify_fail("你的基本腿法修为不够。\n");
        if( me->query("neili") <= 1000 )
                return notify_fail("你的内力不够！\n");
        if( me->query("jingli") <= 1000 )
                return notify_fail("你的精力不够！\n");
        switch( random(14) ) {
                case 0: color=GRN;break;
                case 1: color=HIR;break;
                case 2: color=HIG;break;
                case 3: color=YEL;break;
                case 4: color=HIY;break;
                case 5: color=BLU;break;
                case 6: color=HIB;break;
                case 7: color=MAG;break;
                case 8: color=HIM;break;
                case 9: color=CYN;break;
                case 10: color=HIC;break;
                case 11: color=WHT;break;
                case 12: color=HIW;break;
                case 13: color=RED;break;
        }

        message_vision("\n"+color+"$N起手使出$n成名绝技！俨然是姑苏慕容的“以彼之道，还施其身”！\n"NOR,me,target);
        me->start_busy(1);
        target->start_busy(1);

//        for (i=0; i<sizeof( keys( me->query_skill_prepare() ) ); i++)
//        { me->prepare_skill( keys( me->query_skill_prepare() )[i] ); }
//        me->reset_action();
        if( me->query("murong_baitong") )
        {
                if(random(num)==1)shaolin(me, target);
                else if(random(num)==2)gaibang(me, target);
                else if(random(num)==3)mizong(me, target);
                else if(random(num)==4)emei(me, target);
                else if(random(num)==5)quanzhen(me, target);
                else if(random(num)==6)wudang(me, target);
                else if(random(num)==7)gumu(me, target);
                else if(random(num)==8)dali(me, target);
                else if(random(num)==9)huashan(me, target);
                else if(random(num)==10)taohua(me, target);
                else if(random(num)==11)xingxiu(me, target);
                else if(random(num)==12)baituo(me, target);
                else if(random(num)==13)lingjiu(me, target);
                else murong(me,target);
}
        else if( !target->query("family/family_name") ) return notify_fail("你摸不清对手招数，于是放手不施。\n");
        else if( target->query("family/family_name") == "姑苏慕容" ) murong(me, target);
        else if( target->query("family/family_name") == "少林派" ) shaolin(me, target);
        else if( target->query("family/family_name") == "丐帮" ) gaibang(me, target);
        else if( target->query("family/family_name") == "雪山派" ) mizong(me, target);
        else if( target->query("family/family_name") == "血刀门" ) mizong(me, target);
        else if( target->query("family/family_name") == "峨嵋派" ) emei(me, target);
        else if( target->query("family/family_name") == "全真教" ) quanzhen(me, target);
        else if( target->query("family/family_name") == "武当派" ) wudang(me, target);
        else if( target->query("family/family_name") == "古墓派" ) gumu(me, target);
        else if( target->query("family/family_name") == "大理段家" ) dali(me, target);
        else if( target->query("family/family_name") == "华山派" ) huashan(me, target);
        else if( target->query("family/family_name") == "灵鹫宫" ) lingjiu(me, target);
        else if( target->query("family/family_name") == "桃花岛" ) taohua(me, target);
        else if( target->query("family/family_name") == "星宿派" ) xingxiu(me, target);
        else if( target->query("family/family_name") == "白驼山" ) baituo(me, target);
        return 1;
}
