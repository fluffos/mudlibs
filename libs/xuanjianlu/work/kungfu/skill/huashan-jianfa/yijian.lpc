//by coffee
//pfm yijian 宁氏一剑
/*
岳夫人长剑使得兴发，突然间一声清啸，剑锋闪烁不定，围着令狐冲身围疾刺，银光飞舞，众人看得眼都花了。猛地里
她一剑挺出，直刺令狐冲心口，当真是捷如闪电，势若奔雷。令狐冲大吃一惊，叫道：“
师娘！”其时长剑剑尖已刺破他衣衫。
岳灵珊拉住父亲衣袖，道：“爹，你传我一门破解这一剑的功夫，免得大师哥学会这一剑
后尽来欺侮我。”岳不群摇头笑道：“你妈这一剑叫做‘无双无对，宁氏一剑’，天下无敌，我怎有破解的法门？
*/
#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;
int remove_effect(object me, object target);

int perform(object me, object target) {
  string weapon;
  int skill;
  mapping myfam;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("宁氏一剑只能对战斗中的对手使用。\n");

  if ((!(myfam = me->query("family")) || myfam["family_name"] != "华山派") && me->query("id") != "coffee")
    return notify_fail("你并非华山弟子，无法使用宁氏一剑!\n");

  if (me->query("gender") != "女性")
    return notify_fail("只有女子才能使用这宁氏一剑的绝技!\n");

  if (me->query_temp("yijian"))
    return notify_fail("你正在使用宁氏一剑！\n");

  if (me->query_skill_mapped("force") != "zixia-gong")
    return notify_fail("你所使用并非紫霞神功!\n");

  if (me->query_skill("zixia-gong", 1) < 120)
    return notify_fail("你紫霞神功修为不够无法使用宁氏一剑！！\n");

  if (me->query_skill("sword") < 150)
    return notify_fail("你华山剑法修为不够,无法使用宁氏一剑！\n");

  if ((int)me->query("neili", 1) < 500)
    return notify_fail("你现在的内力太弱。\n");

  if ((int)me->query("jingli", 1) < 400)
    return notify_fail("你的精力太低。\n");

  weapon = me->query_temp("weapon");
  skill = (me->query_skill("huashan-jianfa")
    +me->query_skill("force")) / 5;

  me->add_temp("apply/attack", skill);
  me->add_temp("apply/damage", skill / 2);

  message_vision(
    HIY "$N突然间一声清啸，手中" + weapon->name() + HIY "闪烁不定，围着$n身围疾刺，银光飞舞，猛地里一剑挺出，直刺$n当真是捷如闪电，势若奔雷。\n\n" NOR,
    me,
    target
  );
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  me->add("neili", -200);
  me->add("jingli", -150);
  me->set_temp("yijian", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, target :), skill / 3);
  return 1;
}

int remove_effect(object me, object target) {
  me->set_temp("apply/attack", 0);
  me->set_temp("apply/damage", 0);
  me->delete_temp("yijian");
  if (me->is_fighting())
    message_vision(HIG "\n$N吸了一口气，将内力收回丹田，剑招也恢复正常！\n\n" NOR, me);
  return 0;
}
