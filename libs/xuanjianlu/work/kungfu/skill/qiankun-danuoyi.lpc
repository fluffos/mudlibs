});


int valid_enable(string usage)
{
	return (usage == "parry") || 
		(usage == "dodge") || 
		(usage == "move");
}

string query_dodge_msg()
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

string query_parry_msg()
{
	return parry_msg[random(sizeof(parry_msg))];
}

string query_move_msg()
{
	return move_msg[random(sizeof(move_msg))];
}	

int valid_learn(object me)
{
	return notify_fail("「乾坤大挪移」只能通过研习《乾坤大挪移心法》和自己练习来提高。\n");
}

int practice_skill(object me)
{
	int qkdny_cost;
	if (me->query_skill("qiankun-danuoyi", 1) < 350)
		return notify_fail("你的「乾坤大挪移」功力还不够，必须先通过研习《乾坤大挪移心法》来提高。\n");
	if (me->query_skill("force", 1) < 150)
		return notify_fail("你的基本内功火侯还不够，练不了「乾坤大挪移」。\n");
	if ( (int)me->query("max_neili") < 2000 )
		return notify_fail("你的内力不够雄厚, 练不了「乾坤大挪移」。\n");
	if ( (int)me->query("jingli") < 50 || (int)me->query("jing") < 50 || (int)me->query("neili") < 100 )
		return notify_fail("你的体力太差了，先歇息一会儿。\n");
	if (me->query_skill("jiuyang-shengong", 1) < 30)
		qkdny_cost = 3500 / me->query_skill("force", 1);
	else qkdny_cost = 2000 / me->query_skill("jiuyang-shengong", 1);
	me->receive_damage("jingli", qkdny_cost);
	me->receive_damage("jing", qkdny_cost);
	qkdny_cost = qkdny_cost / 2;
	me->add("neili", -qkdny_cost);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"qiankun-danuoyi/" + action;
}

int is_special()
{
	return 1;
}

string report_result(object attacker, object defender, object me, string result)
{
	string skill_name, c_skill_name, attack_skill;
	string *attack_type,limb, *limbs;
	mapping prepare,action;

	object attack_weapon = attacker->query_temp("weapon");
	object me_weapon=me->query_temp("weapon");
	
	limbs = defender->query("limbs");
	limb = limbs[random(sizeof(limbs))];	

	result = replace_string( result, "$l", limb );

	if (defender)
		result = replace_string( result, "$V", defender->name() );

	prepare = attacker->query_skill_prepare();
	
	if( !prepare ) 
		prepare = ([]);
	if( objectp(attack_weapon) ) 
		attack_skill = attack_weapon->query("skill_type");
	else switch( sizeof(prepare) )
	{
		case 0: attack_skill = "unarmed"; break;
		case 1: attack_skill = (keys(prepare))[0]; break;
		case 2: attack_skill = (keys(prepare))[attacker->query_temp("action_flag")]; break;
	}

	skill_name = attacker->query_skill_mapped(attack_skill);
	
	c_skill_name = to_chinese(skill_name);

	attacker->reset_action();
	action = attacker->query("actions");
		
	if( stringp(action["skill_name"]) )
		result = replace_string( result, "$s", "「"+action["skill_name"]+"」" );
	else if( stringp(skill_name) )
		result = replace_string( result, "$s", "「"+c_skill_name+"」" );
	else 
	{
			//c_skill_name = to_chinese(attacker->query_skill_mapped(attack_skill));
			//result = replace_string( result, "$s", c_skill_name[(sizeof(c_skill_name)-5)..(sizeof(c_skill_name)-1)] );
			//这儿有bug，在jifa none，bei none的时候取attack_skill的算法有误
			//我看了一下，有$s的地方都可以用"", 不影响美观，暂时就这样
			result = replace_string( result, "$s", "");
	}
	
	if( objectp(me_weapon) )
		result = replace_string( result, "$W", me_weapon->name(),attacker,defender );
	else 
		switch( random(3) ) 
		{
			case 0: 
				result = replace_string( result, "$W", "左手" );
				break;
			case 1: 
				result = replace_string( result, "$W", "右手" );
				break;
			case 2: 
				result = replace_string( result, "$W", "双手" );
				break;
		}

	attack_type = ({"攻", "击",}); 

	if( attack_weapon )
	{
		result = replace_string( result, "$w", attack_weapon->name() );
		switch( attack_weapon->query("skill_type") )
		{
			case "sword" :
				attack_type = ({"刺", "击", "砍", }); 
				break;
			case "blade" :
				attack_type = ({"砍", "劈", "挥", }); 
				break;
			case "staff" :
			case "stick" :
			case "club" :
				attack_type = ({"打", "扫", "砸", }); 
				break;
			case "hammer" :
				attack_type = ({"砸", "打", "挥", }); 
				break;
		}
	}	
	else if( stringp(action["weapon"]) )
		result = replace_string( result, "$w", action["weapon"] );
	else switch( attack_skill )
	{
		case "finger" : 
			result = replace_string( result, "$w", "手指" );
			attack_type = ({"点", "戳", "指", }); 
			break;
		case "cuff" :   
			result = replace_string( result, "$w", "拳头" );
			attack_type = ({"打", "击", "锤", }); 
			break;
		case "strike" : 
			result = replace_string( result, "$w", "手掌" );
			attack_type = ({"推", "击", "拍", }); 
			break;
		case "claw" :   
			result = replace_string( result, "$w", "手爪" );
			attack_type = ({"抓", "插", "挥", }); 
			break;
		case "hand" :
			result = replace_string( result, "$w", (random(2) ? "左手" : "右手") );
			attack_type = ({"拿", "抓", "拂", });
			break;
		case "kick" :
			result = replace_string( result, "$w", (random(2) ? "左腿" : "右腿") );
			attack_type = ({"踢", "踹", "扫", });
			break;
		default :       
			result = replace_string( result, "$w", "拳脚" );
			break;
	}

	result = replace_string( result, "$A", attack_type[random( sizeof(attack_type) )] );

	if (defender->query_skill_mapped("force"))
	{
		skill_name = defender->query_skill_mapped("force");
		c_skill_name = to_chinese(skill_name);
		result = replace_string( result, "$f", c_skill_name);
	}
	else 
		result = replace_string( result, "$f", "内功心法");
	
	return result;
}


mixed hit_by(object attacker, object defender, int damage)
{
	int size, lvl, chance;
	object *opponent, victim;
	string dodge_skill, parry_skill, force_skill, result;

	opponent = defender->query_enemy();
	dodge_skill=defender->query_skill_mapped("dodge");
	parry_skill=defender->query_skill_mapped("parry");
	force_skill=defender->query_skill_mapped("force");
	lvl=defender->query_skill("qiankun-danuoyi",1);
	
	//message_vision(HIR"乾坤大挪移调试enter：damage:" +damage+"\n"NOR,attacker,defender);
	
	
	if( !opponent || !arrayp(opponent) ) 
		return damage;
	
	// 如果有多于一个对手，(有可能)将攻击者的攻击转到另外一人身上。
	
	size=sizeof(opponent);
		
	if( !living(defender) 
	 || (force_skill != "shenghuo-xuanming"	&& force_skill != "jiuyang-shengong")
	 || dodge_skill != "qiankun-danuoyi"
	 || parry_skill != "qiankun-danuoyi" )
		return ([ "result" : "", "damage" : damage, "victim" : defender]);
	
	if(damage<=0 && force_skill=="jiuyang-shengong")
	{
		//内功配合了九阳神功处理办法
		//找到攻击者的攻击力
		damage=defender->query_str()*10;
		damage=damage+defender->query("jiali")*10;
		damage=damage+defender->query("eff_neili");
		message_vision(HIY"\n\n只见$n"HIY"运用「"+ to_chinese(force_skill)+ "」内力源源不断，配合「乾坤大挪移」，暗中将一股内劲顺势打在$N"HIY"身上\n\n"NOR,attacker,defender);
		return ([ "result" : "", "damage" : damage, "victim" : attacker]);
	}
	
	if ( defender->query("neili")<lvl*2 )
		return ([ "result" : "", "damage" : damage, "victim" : defender]);
	
	chance=random(lvl);	
	//message_vision(HIR"乾坤大挪移调试：add damage:" +damage+"       chance:"+chance+ "\n"NOR,attacker,defender);
	
	if ( lvl > 300 && chance>200 )
	{
		//攻击反弹
		
		if(size>1)
		{
			victim=opponent[random(size)];
			result =shift_other[random(sizeof(shift_other))];
			
			result =report_result(attacker, victim, defender, result);
			if (wizardp(defender))			
				tell_object(defender,HIR "随机转移到：  " + victim->name() + "   \n"NOR);
		}		
		else
		{
			victim=attacker;
			result =shift_back[random(sizeof(shift_back))];			
			result =report_result(attacker, victim, defender, result); 
			if (wizardp(defender))						
				tell_object(defender,HIR "转移到攻击者：  " + victim->name() + "   \n"NOR);			
		}
		message_vision(result,attacker,defender);
		return ([ "result" : "", "damage" : damage, "victim" : victim]);
	}
	
	if ( lvl > 200 && chance>150 )
	{
		//取消攻击
		result = shift[random(sizeof(shift))];
		result = report_result(attacker, defender, defender, result);
		
		if (wizardp(defender))			
			tell_object(defender,HIR "取消：  " + attacker->name() + "攻击   \n"NOR);
			
		message_vision(result,attacker,defender);
		return ([ "result" : "", "damage" : 0, "victim" : ""]);
	}
	
	if ( lvl > 100 && chance>100 )
	{
		//逃逸
		result = query_move_msg();
		result = report_result(attacker, defender, defender, result);
		
		if (wizardp(defender))			
			tell_object(defender,HIR "逃逸：  " + attacker->name() + "攻击   \n"NOR);
			
		message_vision(result,attacker,defender);
		return ([ "result" : "", "damage" : 0, "victim" : ""]);
	}	
	
	if ( lvl > 50 && chance>80 )
	{
		//躲闪
		result = query_dodge_msg();
		result = report_result(attacker, defender, defender, result);
		
		if (wizardp(defender))			
			tell_object(defender,HIR "躲闪：  " + attacker->name() + "攻击   \n"NOR);
			
		message_vision(result,attacker,defender);
		return ([ "result" : "", "damage" : 0, "victim" : ""]);
	}	
	
	if ( lvl > 30 && chance>50 ) 
	{
		//招架
		result = query_parry_msg();
		result = report_result(attacker, defender, defender, result);
		
		if (wizardp(defender))			
			tell_object(defender,HIR "招架：  " + attacker->name() + "攻击   \n"NOR);
			
		message_vision(result,attacker,defender);
	}
	
	return ([ "result" : "", "damage" : damage, "victim" : defender]);	
}
