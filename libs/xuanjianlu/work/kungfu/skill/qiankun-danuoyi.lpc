// Cracked by Roath
// qiankun-nuoyi.c 乾坤大挪移
// modified by box 2003/10/31

/*张无忌听到风声，知道这一掌真力充沛，非同小可，有意试一试他的内力，右掌回转，硬
碰硬的接了他这掌，左足这才着地。霎时之间，苦头陀掌上真力源源催至。张无忌运起乾
坤大挪移心法中第七层功夫，将他掌力渐渐积蓄，突然间大喝一声，反震出去，便如一座
大湖在山洪爆发时储满了洪水，猛地里湖堤崩决，洪水急冲而出，将苦头陀送来的掌力尽
数倒回。*/

#include <ansi.h>
#include <combat.h>

inherit SKILL;

private string report_result(object attacker, object defender, object me, string result);

string *dodge_msg = ({
		GRN"$n"GRN"身体滑如游鱼，在间不容发之际避开$N"GRN"这一招。\n"NOR,
		GRN"但见$n"GRN"四下转动，越奔越快，如风如火，似雷似电，足不点地的凌空飞行一般。\n"NOR,
		GRN"$n"GRN"施展挪移乾坤心法，一声清啸，拔身而起，在半空中轻轻一个转折，飘然落在丈许之外。\n"NOR,
		GRN"陡然间$n"GRN"身形拔起，在空中急速盘旋，连转四个圈子，愈转愈高，又是一个转折，轻轻巧巧得落在数丈之外。\n"NOR,
		GRN"$n"GRN"右手后挥，拨开了袭至的$w"GRN"，左手乾坤大挪移心法一提一送，身随劲起，嗖的一声，身子直冲上天。\n"NOR,
});

string *parry_msg = ({
		WHT"那知$n"WHT"跟著微转，一股柔和的劲力送出，将$N"WHT"击向$n"WHT"的一招直荡了开去。\n"NOR,
		WHT"$n挪移乾坤，从中牵引，$N"WHT"这招在中途转了方向，使了个空。\n"NOR,
		WHT"$n"WHT"右手五指犹如抚琴鼓瑟，忽挑忽捻，忽弹忽拔，上身半点不动，片刻间将$N"WHT"的这招力道尽数卸了。\n"NOR,
		WHT"却见$N"WHT"这一招将要及$n"WHT"，$n"WHT"右手五指轻拂，$N招数竟然转向，从$n"WHT"身侧斜了过去，相距虽不过三寸，这一招终于全然使了个空。\n"NOR,
		WHT"$n"WHT"动也不动，待$N"WHT"这招使到，内力斜引，将$N的力道挪移卸了开去。$N"WHT"只觉犹似入了水中，更无半点着力处。\n"NOR,
});

string *move_msg = ({
		HIY"$n"HIY"向左踏出两步，右手挥出，一股劲风扑向$N"HIY"的后心，这一招的方位时刻，拿捏得恰到好处，$N身不由主，出招陡然转了方向！\n"NOR,
		HIY"$n"HIY"左手护胸，右手五指犹如抚琴鼓瑟，忽挑忽捻，忽弹忽拨，上身半点不动，片刻间将$N"HIY"的招数尽数引开！\n"NOR,
		HIY"$n"HIY"左手牵，右手引，「乾坤大挪移」心法牛刀小试，$N"HIY"的招式已然转向！\n"NOR,
		HIY"$n"HIY"身子微转，一股柔和的劲力送出，将$N"HIY"击向$n"HIY"的一招直荡了开去。\n"NOR,
		HIY"$n"HIY"动也不动，待$N"HIY"这招使到，内力斜引，将$N"HIY"的力道挪移卸了开去。$N"HIY"只觉犹似入了水中，这一招更不知击向何处！\n"NOR,
});

string *shift_back = ({
		HIC"却给$n以「乾坤大挪移」功夫挪移到了自己身上。\n"NOR,
		HIC"$n$W一引一带，使出「乾坤大挪移」神功，$N"HIC"的$w"HIC"回转头去$A到自己。\n"NOR,
		HIC"却不知如何被$n"HIC"一带，$w"HIC"竟$A"HIC"到了自己的$l。\n"NOR,
		HIC"$n"HIC"向左踏出两步，$W"HIC"挥出，一股劲风扑向$N"HIC"的$l"HIC"。这一招的方位时刻，拿捏得恰到好处，$N"HIC"身不由主，$w"HIC"便往自己身上招呼。\n"NOR,
		HIC"$n"HIC"挪移乾坤，$N"HIC"这$w"HIC"在中途转了方向，$A"HIC"到了自己的$l。\n"NOR,
		HIC"便在此时，$n"HIC"迫使$N"HIC"$w"HIC"转向，$A"HIC"到了自己的$l。\n"NOR,
		HIC"$n"HIC"内息极迅速的流转一周，凝神专志，$W"HIC"牵引，使出「乾坤大挪移」心法，将$N"HIC"$A"HIC"来的$w"HIC"转移到自己身上。\n"NOR,
		HIC"只见$n"HIC"$W"HIC"拂去，在$p"HIC"的粘引之下，$w"HIC"转而$A"HIC"向自己的$l。\n"NOR,
		HIC"$n"HIC"$W"HIC"加了十成力，凝神牵带，$N"HIC"$w"HIC"反而$A到了自己。\n"NOR,
		HIC"$n"HIC"使挪移乾坤心法，一牵一引，$N"HIC"的$w"HIC"反向自己身上招呼过去。\n"NOR,
		HIC"$n"HIC"手肘微沉，施展「乾坤大挪移」心法，将$N"HIC"的$w"HIC"拨回到自己身上。\n"NOR,
		HIC"但被$n"HIC"一引一带，$N的$w"HIC"$A"HIC"回了自己的$l"HIC"，这「乾坤大挪移」手法之巧，计算之准，实已到了匪夷所思的地步。\n"NOR,
		HIC"$n"HIC"使出挪移乾坤的神功，推动$N"HIC"$w"HIC"，掠过去$A"HIC"向自己的$l。\n"NOR,
		HIC"$n"HIC"一声清啸，「乾坤大挪移」心法使出，$N$w"HIC"便即倒转回去，$A"HIC"到自己的$l。\n"NOR,
		HIC"$n"HIC"$W"HIC"挥出，引得$N"HIC"的这招$s"HIC"反而$A"HIC"到了自己。\n"NOR,
		HIC"$n"HIC"动也不动，待$N$w"HIC"攻到，内力斜引，将$N"HIC"的力道挪移回自己身上。\n"NOR,
		HIC"却见这一招将要及$n"HIC"，$n$W"HIC"轻拂，$N$w"HIC"竟然转向，$A"HIC"回来。\n"NOR,
		HIC"但$n"HIC"$W"HIC"一拂，将$w"HIC"反击回去。\n"NOR,
		HIC"$n"HIC"内息极迅速的流转一周，凝神专志，$W"HIC"牵引，使出「乾坤大挪移」心法，将$N"HIC"$A"HIC"来的$w"HIC"移回到自己身上。\n"NOR,
		HIC"$n"HIC"以挪移乾坤之法将$w"HIC"上的劲力反激回去。\n"NOR,
});

string *shift_other = ({
		HIM"却给$n以「乾坤大挪移」功夫挪移到了$V身上。\n"NOR,
		HIM"$n$W一引一带，使出「乾坤大挪移」神功，$N的$w调转头去$A向$V$l。\n"NOR,
		HIM"却不知如何被$n一带，$w竟$A向了$V的$l。\n"NOR,
