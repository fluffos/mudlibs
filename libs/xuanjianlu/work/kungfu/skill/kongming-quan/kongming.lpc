// kongming.c  
// By Xuanyuan 2002.5.1
/*
洪七公道：“我传你的降龙十八掌是外家的顶峰
功夫，那空明拳却是内家武功的精要所聚。你这柄短剑本可断金削玉，割切树干，
那又算得了甚么？要紧的是，手劲上须守得着‘空’字诀和‘松’字诀。”
*/
#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon = me->query_temp("weapon");
  int dodge, defense;
  /*
	if (! wizardp(me)) 
		return notify_fail("目前这功能还不开放！\n");
*/
  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("只能对战斗中的对手使用空明要诀！\n");

  if (me->query_temp("yield"))
    return notify_fail("你不出拳，如何使用空明要诀？\n");

  if (me->query_skill("kongming-quan", 1) < 120)
    return notify_fail("你的空明拳尚不纯熟，领悟不到空明拳的要诀！\n");

  if (me->query("neili") < 2000)
    return notify_fail("你现在内力不足，不能使用空明拳的要诀！\n");

  if (me->query("jiali") > 0)
    return notify_fail("你加了力后发觉拳劲过大，有违‘空’、‘松’两字要诀。\n");

  if (me->query_temp("kongming"))
    return notify_fail("你正在紧守‘空’、‘松’两字诀！\n");

  message_vision(HIC "$N使开周伯通所授的空明拳，本着以虚击实、以不足胜有余的妙旨，手劲上紧守得着‘空’字诀和‘松’字诀。\n" NOR, me);

  dodge = me->query_skill("dodge") / 2;
  defense = me->query_skill("parry") / 2;
  me->add_temp("apply/dodge", dodge);
  me->add_temp("apply/defense", defense);
  me->set_temp("kongming", me->query_skill("kongming-quan", 1) / 10);
  me->add("neili", -80);
  me->add("jingli", -30);
  call_out("remove_effect", 1, me, target, dodge, defense);
  return 1;
}

void remove_effect(object me, object target, int dodge, int defense) {
  if (objectp(me)) {
    if (objectp(target) && me->query_temp("kongming") && me->is_fighting(target)) {
      me->add_temp("kongming", -1);
      call_out("remove_effect", 1, me, target, dodge, defense);
      return;
    }
    if (me->is_fighting(target))
      message_vision(HIY "\n数招已过，$n感到$N的拳脚劲力已较刚才大了许多。\n" NOR, me, target);
    me->add_temp("apply/dodge", -dodge);
    me->add_temp("apply/defense", -defense);
    me->delete_temp("kongming");
  }
}
