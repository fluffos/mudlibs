//Cracked by Xuanyuan
// yingshe.c 鹰蛇生死搏

/*
鲜于通不让他说下去，立即扑上贴身疾攻，使的是华山派绝技之一的七十二路“鹰蛇生
死搏”。他收拢折扇，握在右手，露出铸作蛇头之形的尖利扇柄，左手使的则是鹰抓功路
子；右手蛇头点打刺戳，左手则是擒拿扭勾，双手招数截然不同。这路“鹰蛇生死搏”乃华
山派已传之百余年的绝技，鹰蛇双式齐施，苍鹰矫矢之姿，毒蛇灵动之势，于一式中同时现
出，迅捷狠辣，兼而有之。
鲜于通喝道：“小贼，教你知道我华山绝艺‘鹰蛇生死搏’的厉害！”说着
纵身上前，左手五指向张无忌右腋下的“渊腋穴”上抓了下去。他只道这一把抓落，张无忌
已绝无反抗之能，哪知着手之处，便如抓到了一张滑溜溜的大鱼皮，竟使不出半点劲道。
*/

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target) {
  int dex, skill;
  string weapon;
  string *msgyingshe, msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("鹰蛇生死搏只能对战斗中的对手使用。\n");

  if (me->query_temp("leidong"))
    return notify_fail("你已经在使用雷动九天，无法同时运用鹰蛇生死搏！\n");

  if (me->query_temp("yingshe"))
    return notify_fail("你已在使用鹰蛇生死搏了！\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("鹰蛇生死搏需空手才能施展！\n");

  if (me->query_skill_mapped("strike") != "hunyuan-zhang")
    return notify_fail("你所用的并非混元掌，不能施展鹰蛇生死搏！\n");

  if (me->query_skill_prepared("strike") != "hunyuan-zhang")
    return notify_fail("你所备的并非混元掌，不能施展鹰蛇生死搏！\n");

  if (me->query_skill_mapped("force") != "zixia-gong")
    return notify_fail("你所用的并非紫霞功，施展不出鹰蛇生死搏！\n");

  if (me->query_skill("force") < 200)
    return notify_fail("你的紫霞功火候未到，无法施展鹰蛇生死搏！\n");

  if (me->query_skill("strike") < 235)
    return notify_fail("鹰蛇生死搏需要精湛的混元掌方能有效施展！\n");

  if (me->query("neili") <= 1000)
    return notify_fail("你的内力不够使用鹰蛇生死搏！\n");

  msgyingshe = ({
    "$N忽然扑上贴身疾攻，使的正是华山派绝技之一的七十二路“鹰蛇生死搏”。",
    "$N握紧右手，作蛇头之形，左手使的则是鹰抓功路子；右手蛇头点打刺戳，左手则是擒拿扭勾，双手招数截然不同。",
    "$N使开一路华山派已传之百余年的绝技“鹰蛇生死搏”，鹰蛇双式齐施，苍鹰矫矢之姿，毒蛇灵动之势，于一式中同时现出，迅捷狠辣，兼而有之。",
  });

  msg = MAG "\n" + msgyingshe[random(sizeof(msgyingshe))] + "\n" NOR;
  message_vision(msg, me);

  dex = me->query_dex();

  me->add_temp("apply/damage", dex / 2);
  me->add_temp("apply/speed", dex * 2);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  skill = (me->query_skill("zixia-gong", 1) + me->query_skill("hunyuan-zhang", 1)) / 2;

  me->start_call_out((: call_other, __FILE__, "end_perform", me, dex :), skill / 6);

  me->add("neili", -dex * 4);
  me->add("jingli", -dex * 2);
  me->set_temp("yingshe", 1);
  return 1;
}

void end_perform(object me, int dex) {
  me->add_temp("apply/speed", -dex / 2);
  me->add_temp("apply/damage", -dex / 2);

  me->delete_temp("yingshe");

  tell_object(me, "你缓缓吸了一口气，收回鹰蛇生死搏的攻势。\n");
}
