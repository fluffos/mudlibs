#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;


int perform(object me, object target) {
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「麒麟十二刀」只能对战斗中的对手使用。\n");

  if (me->query_skill_mapped("force") != "dulong-dafa")
    return notify_fail("你所用的并非毒龙大法，无法施展「麒麟二十四刀」！\n");

  if (me->query("neili") <= 300)
    return notify_fail("你的内力不够，劲力不足以施展「麒麟二十四刀」！\n");

  message_vision(
    HIG "\n$N一声长啸手中" + me->query_temp("weapon")->query("name") + HIG "自上至下猛劈三刀！\n\n" NOR,
    me,
    target
  );
  me->delete("shenlong/12dao");
  me->add("shenlong/12dao", 3);
  me->start_busy(3);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  call_out("no2_hit", 3, me, target);
  return 1;
}

int no2_hit(object me, object target) {

  if (me->is_fighting()) {

    message_vision(
      HIG "\n紧接着$N手中" + me->query_temp("weapon")->query("name") + HIG "从左至右猛砍三刀！\n\n" NOR,
      me,
      target
    );
    me->add("shenlong/12dao", 3);
    me->start_busy(3);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    call_out("no3_hit", 3, me, target);

  } else
    message_vision(
      HIY "\n" + chinese_number(me->query("shenlong/12dao")) + "招过去以后，$N慢慢将内力收回单田。\n" NOR,
      me
    );
  return 1;
}

int no3_hit(object me, object target) {

  if (me->is_fighting()) {

    message_vision(
      HIG "\n紧接着$N手中" + me->query_temp("weapon")->query("name") + HIG "自上至下猛劈三刀！\n\n" NOR,
      me,
      target
    );
    me->start_busy(3);
    me->add("shenlong/12dao", 3);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    call_out("no2_hit", 3, me, target);

  } else
    message_vision(
      HIY "\n" + chinese_number(me->query("shenlong/12dao")) + "招过去以后，$N慢慢将内力收回单田。\n" NOR,
      me
    );
  return 1;
}


int end_att(object me) {



  return;

}
