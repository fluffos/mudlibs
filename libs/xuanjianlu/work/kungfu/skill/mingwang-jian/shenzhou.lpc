// kungfu/skill/mingwang-jian/shenzhou.c 明王神咒
// liu 2001.10
// 实在找不到描述 只有凭空制作

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

void checking(object me);

int perform(object me, object target) {
  int skill;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「神咒」只能在战斗中使用。\n");

  skill = me->query_skill("sword");

  if (me->query_temp("shenzhou"))
    return notify_fail("你正在运功中！\n");

  if (me->query_skill_mapped("force") != "longxiang-banruo")
    return notify_fail("你现在所用的并非龙象般若功，无法使出「神咒」。\n");

  if (me->query_skill_mapped("parry") != "mingwang-jian")
    return notify_fail("你没有不动明王剑法运在招架上，无法使出「神咒」。\n");

  if (skill < 180)
    return notify_fail("你的不动明王剑法修为不够，不能使用「神咒」。\n");

  if (me->query_skill("force") < 150)
    return notify_fail("你的龙象般若功修为不够，不能使用「神咒」。\n");

  if (me->query_skill("lamaism") < 100)
    return notify_fail("你的密宗心法修为不够，不能使用「神咒」。\n");

  if (me->query_skill("necromancy") < 100)
    return notify_fail("你的降伏法修为不够，不能使用「神咒」。\n");

  if (me->query("jingli") < skill * 3)
    return notify_fail("你的精力不够，不能使用「神咒」。\n");

  if (me->query("neili") < skill * 8)
    return notify_fail("你的内力不够，不能使用「神咒」。\n");

  message_vision(HIY "\n$N双眼微闭喃喃道：明王将世，神咒剑法！猛然怒目一睁，剑法骤然加快，剑招也截然不同！\n" NOR, me);

  me->add("neili", -skill * 8);
  me->add("jingli", -skill * 2);
  me->set_temp("shenzhou", skill / 15);
  me->add_temp("apply/attack", skill / 2);
  me->add_temp("apply/damage", skill / 2);


  if (me->query_skill("sword") < 200) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  } else if (me->query_skill("sword") < 300) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  } else if (me->query_skill("sword") < 400) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  } else if (me->query_skill("sword") < 500) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  } else if (me->query_skill("sword") < 600) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  } else {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }

  remove_call_out("checking");
  call_out("checking", 1, me);

  return 1;
}

void checking(object me) {
  int skill = me->query_skill("sword");

  if (me->query_skill_mapped("sword") != "mingwang-jian" || me->query_skill_mapped("parry") != "mingwang-jian"
    || me->query_skill_mapped("force") != "longxiang-banruo" || !objectp(me->query_temp("weapon"))
    || !me->is_fighting() || me->query_temp("shenzhou") <= 0) {
    message_vision(HIG "\n$N将内劲收归丹田，剑法也渐渐慢了下来。\n" NOR, me);
    me->delete_temp("shenzhou");
    me->add("neili", skill * 2);  //将内劲收归丹田，就该还些内力
    me->add("jingli", -skill);
    me->add_temp("apply/attack", -skill / 2);
    me->add_temp("apply/damage", -skill / 2);

    return;

  }

  if (!living(me) || me->is_ghost()) {
    me->delete_temp("shenzhou");
    me->add_temp("apply/attack", -skill / 2);
    me->add_temp("apply/damage", -skill / 2);


    return;
  }

  me->add_temp("shenzhou", -1);
  call_out("checking", 1, me);

  return;
}
