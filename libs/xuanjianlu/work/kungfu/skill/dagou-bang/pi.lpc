// dagou-bang pi
// liu 2002

/*
他数击不中，突发一招，使出打狗棒法“劈”字诀，竹棒登时生辉，劈棒过去，犹如刀网压下。
*/
#include <ansi.h>
inherit F_SSERVER;

int perform(object me, object target)
{
        object weapon;
        int skill;

        if ( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「劈」字诀只能对战斗中的对手使用。\n");

        if( me->query_skill_mapped("force") != "huntian-qigong")
                return notify_fail("你所用的内功与打狗棒的气路相悖！\n");

        if( (int)me->query_skill("force") < 120 )
                return notify_fail("你的内功修为不够火候，使用不了「劈」字诀。\n");
                
        if( (int)me->query_skill("stick") < 120 )
                return notify_fail("你的打狗棒法不够娴熟，不会使用「劈」字诀。\n");

        if( me->query("neili") <= skill*4 )
                return notify_fail("你的内力不够！\n");

        if( me->query("jingli") <= skill )
                return notify_fail("你的精力不够！\n");

        if( me->query_temp("dagou_pi") )
                return notify_fail("你正在使用「劈」字诀。\n");

        weapon=me->query_temp("weapon");
        skill = me->query_skill("stick");

        me->add("neili", -skill*2);
        me->add("jingli",-skill/2);
        me->set_temp("dagou_pi", skill/20);

        if(me->query("combat_exp",1) < target->query("combat_exp",1) )
        {
                message_vision(HIY "\n$N突发一招，使出打狗棒法“劈”字诀，"+weapon->name()+HIY"登时生辉，劈棒过去，犹如刀网压下。\n"NOR,me,target);
        }
        else
        {

                me->add_temp("apply/attack",-skill/2);
                me->add_temp("apply/speed",-skill/2);

                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

                me->add_temp("apply/attack",skill/2);
                me->add_temp("apply/speed",skill/2);

                message_vision(HIY "\n$N数击不中，突发一招，使出打狗棒法“劈”字诀，"+weapon->name()+HIY"登时生辉，劈棒过去，犹如刀网压下。\n"NOR,me,target);

        }

        me->add_temp("apply/attack",skill/2);

        if ( me->query_skill("stick") < 200 )
		{ 
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        }
        else if ( me->query_skill("stick") < 300 )
        {
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        }
        else
        {
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        }

        remove_call_out("checking");
        call_out("checking", 1, me);

        return 1;
}

void checking(object me)
{
		int skill = me->query_skill("stick");

        if(me->query_skill_mapped("stick") != "dagou-bang" || me->query_skill_mapped("force") != "huntian-qigong" 
        || !objectp(me->query_temp("weapon")) || !me->is_fighting()  || me->query_temp("dagou_pi") <= 0 )
        {
                me->delete_temp("dagou_pi");
                me->add("neili", skill);
                me->add("jingli",-skill);
                me->delete_temp("apply/attack");
                return ;

        }

        if( !living(me) || me->is_ghost() )
        {
                me->delete_temp("dagou_pi");
                me->delete_temp("apply/attack");
                return ;
        }

        me->add_temp("dagou_pi",-1);
        call_out("checking", 1, me);

		return;
}