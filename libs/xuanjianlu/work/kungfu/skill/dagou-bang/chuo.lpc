// dagou-bang chuo
// liu 2002

/*
岂知杨过新学了打狗棒法的精要，将那绊、劈、缠、戳、挑、引、
封、转八字诀使将出来，果然是变化精微，出神入化。法王大意抢攻，略见疏神，竟被他在
大腿上戳了一下，虽在危急中急闭穴道，未曾受伤，却也是疼痛良久。

他说未说完，杨过悄悄走到他身后，桨柄疾送，使出打狗棒法中第四招“戳”字诀，忽
地向他臀上戳去。以霍都的武功修为，背后有人突施暗算，岂有不知之理？可是打狗棒法端
的神奇奥妙，他虽惊觉，急闪之际终究还是差了这么几寸，噗的一下，正中臀部。饶是他内
功深厚，臀部又是多肉之处，可是这一下却也甚是疼痛，兼之出其不意，他只道定可避过，
偏偏竟又戳中，不由得“啊”的一声叫了出来。
*/
#include <ansi.h>
inherit F_SSERVER;
string *side = ({ "左侧", "右侧", "身后" });

int perform(object me, object target) {
  object weapon;
  string *limb, msg;
  int skill, ap, dp, damage, busytime;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || target == me)
    return notify_fail("你想戳谁？\n");

  if (environment(target)->query("no_fight"))
    return notify_fail("这里不能用「戳」字诀。\n");

  if (me->query_skill_mapped("force") != "huntian-qigong")
    return notify_fail("你所用的内功与打狗棒的气路相悖！\n");

  if ((int)me->query_skill("force") < 220)
    return notify_fail("你的内功修为不够火候，使用不了「戳」字诀。\n");

  if ((int)me->query_skill("stick") < 220)
    return notify_fail("你的打狗棒法不够娴熟，不会使用「戳」字诀。\n");

  weapon = me->query_temp("weapon");
  skill = me->query_skill("stick");

  if (me->query("neili") <= skill * 3)
    return notify_fail("你的内力不够！\n");

  if (me->query("jingli") <= skill * 2)
    return notify_fail("你的精力不够！\n");

  damage = skill + me->query("neili") / 20;
  if (damage > 1500) damage = 1500;
  if (damage < 300) damage = 300;
  ap = me->query("combat_exp", 1) / 1000 + skill + me->query("jiali") + me->query("jiajin");
  dp = target->query(
    "combat_exp",
    1
  ) / 1000 + target->query_skill("dodge") + target->query_skill("force");

  if (!target->is_character() || !me->is_fighting(target) || !living(target)) {
    msg = "\n$N悄悄走到$n身后, " NOR + weapon->name() + NOR "疾送，使出打狗棒法中第四招「戳」字诀，忽地向$n臀上戳去！\n\n" NOR;

    if (ap * 2 / 3 > dp) {
      damage = damage + random(damage / 3);
      msg += "以$n的武功修为，背后有人突施暗算，实在难以知晓。\n" NOR;
      msg += "加之打狗棒法端的神奇奥妙，噗的一下，正中$n臀部。" NOR;
      busytime = 4;
    } else if (ap > dp) {
      msg += "以$n的武功修为，背后有人突施暗算，岂有不知之理？\n" NOR;
      msg += "可是打狗棒法端的神奇奥妙，$n虽惊觉，但已闪躲不及急，噗的一下，正中臀部。\n" NOR;
      msg += "饶是$n内功深厚，臀部又是多肉之处，可是这一下却也甚是疼痛，不由得“啊”的一声叫了出来。" NOR;
      busytime = 3;
    } else if (ap * 3 / 2 > dp) {
      damage = damage - random(damage / 3);
      msg += "以$n的武功修为，背后有人突施暗算，岂有不知之理？\n" NOR;
      msg += "可是打狗棒法端的神奇奥妙，$n虽惊觉，急闪之际终究还是差了这么几寸。\n" NOR;
      msg += "只听「噗」的一声，" NOR + weapon->name() + "已然豁开一道血沟。" NOR;
      busytime = 2;
    } else {
      damage = damage / 10;
      msg += "以$n的武功修为，背后有人突施暗算，岂有不知之理？\n" NOR;
      msg += "$n运起本门身法，猛然闪躲，结果只擦破点皮肉。" NOR;
      busytime = 1;
    }
    if (!target->killing_ob(me)) target->kill_ob(me);
  } else {

    limb = target->query("limbs");
    msg = HIB "\n眨眼间$N已然闪到$n" + side[random(3)] + ", " + weapon->name() + HIB "疾送，使出打狗棒法中第四招「戳」字诀，忽地向$n戳去！\n\n" NOR;
    if (ap * 2 / 3 > dp) {
      damage = damage + random(damage / 3);
      msg += HIY "只听「噗」的一声，正中$n" + limb[random(sizeof(limb))] + "。\n" NOR;
      busytime = 4;
    } else if (ap > dp) {
      msg += HIY "$n大意抢攻，略见疏神，竟被$n在" + limb[random(sizeof(limb))] + "上戳了一下！\n\n" NOR;
      msg += HIY "危急中$n闭穴不及，血如泉涌，加之内劲震荡，真个痛苦非常。\n" NOR;
      busytime = 3;
    } else if (ap * 3 / 2 > dp) {
      damage = damage - random(damage / 3);
      msg += HIY "$n大意抢攻，略见疏神，竟被$n在" + limb[random(sizeof(limb))] + "上戳了一下！\n\n" NOR;
      msg += HIY "虽在危急中急闭穴道，未受重伤，却也是疼痛良久。\n" NOR;
      busytime = 2;
    } else {
      damage = damage / 10;
      msg += HIY "深知打狗棒法端的神奇奥妙，不敢大意抢攻，只等劲风逼近。\n\n" NOR;
      msg += HIG "$n运起本门身法，猛然闪躲，结果只擦破点皮肉。\n" NOR;
      busytime = 1;
    }
  }

  target->receive_wound("qi", damage, me);
  target->receive_damage("qi", damage + random(damage), me);
  if (wizardp(me)) tell_object(
    me,
    "damage " + damage + " ap " + ap + " dp " + dp + " busytime " + busytime + "\n"
  );
  me->add("neili", -skill);
  me->add("jingli", -skill / 2);
  me->start_busy(1 + random(2));
  target->start_busy(busytime);
  message_vision(msg + "\n", me, target);
  COMBAT_D->report_status(target);
  return 1;
}
