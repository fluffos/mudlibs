//Cracked by polybao
// tongbi.c 通臂灵爪
//来源 倚天屠龙记
//殷天正右臂一伸，不知如何，竟尔陡然间长了半尺，在莫声谷手腕上一拂，挟手将他长剑夺过，左手已按住他“肩贞穴”。

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

string *xuedao1 = ({
  "肩井穴",
  "紫宫穴",
  "中庭穴",
  "关元穴",
  "天池穴",
  "中渎穴",
  "风市穴",
  "环跳穴",
  "渊液穴",
  "阴谷穴",
  "足三里",
  "中府穴",
  "尺泽穴",
  "孔最穴",
  "列缺穴",
  "太渊穴",
  "少商穴",
  "商阳穴",
  "合谷穴",
  "手三里",
  "曲池穴",
  "迎香穴",
  "百会穴",
  "灵台穴",
  "太阳穴",
  "膻中穴",
  "命门穴",
  "鸠尾穴",
  "气海穴"
});


int perform(object me, object target) {
  object weapon;
  int sp, dp, time;

  if (!me->is_fighting())
    return notify_fail("你必须在战斗中才能使用通臂灵爪！\n");

  if (!target && me->is_fighting()) target = offensive_target(me);

  //	if( !target || !target->is_character() || target->query("race") != "人类" )
  //		return notify_fail("你要点谁的穴？\n");

  if (environment(target)->query("no_fight"))
    return notify_fail("在这里你不能偷袭！\n");

  if (me->query_skill("yingzhua-qinna", 1) < 120)
    return notify_fail("你的鹰爪擒拿手修炼还不够，不会通臂灵爪！\n");

  if (me->query_skill("shenghuo-xuanming", 1) < 100)
    return notify_fail("你的内功修为火候未到，无法点穴！\n");

  if (me->query("max_neili") <= 1000)
    return notify_fail("你的内力修为不足，无法使通臂灵爪！\n");

  if (!objectp(weapon = target->query_temp("weapon")))
    return notify_fail("对手并未使用兵刃！\n");

  sp = me->query_skill("dodge") + me->query_skill("parry") + me->query("combat_exp") / 50;
  dp = target->query_skill("dodge") + target->query_skill("parry") + target->query("combat_exp") / 50;

  if (sp / 2 + random(sp / 2) > dp / 3) {
    message_vision(
      HIW "\n$N右臂一伸，不知如何，竟尔陡然间长了半尺，在$n手腕上一拂，挟手将他" + weapon->query("name") + HIW "夺过，左手已按住$n" + xuedao1[random(29)] + "！\n\n" NOR,
      me,
      target
    );
    weapon->move(me);
    me->add("neili", -150);
    target->start_busy(3 + random(2));
  } else {
    message_vision(HIR "\n$N右臂一伸，$n发觉不妙，一闪身避了开去！ \n" NOR, me, target);
    me->start_busy(1 + random(2));
  }
  return 1;
}
