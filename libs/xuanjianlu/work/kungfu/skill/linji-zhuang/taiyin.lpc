// Comment: 临济十二庄修改
// 要求，临济十二庄300级。
// 你所聚太阴炼形法之气已散开，你又恢复了原状。
#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int exert(object me, object target) {

  if (!target || !me->is_fighting())
    return notify_fail("你不在战斗中。\n");

  if (me->query("neili") <= 1000)
    return notify_fail("你的内力不够！\n");

  if (me->query("max_neili") <= 1000)
    return notify_fail("你的内力修为不够！\n");

  if (me->query_skill("linji-zhuang", 1) < 300)
    return notify_fail("你的道学修为尚未豁然贯通，无法领会太极心法。\n");

  if ((int)me->query("eff_qi") < (int)me->query("max_qi") / 2)
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");

  if (me->query_temp("linji/taiyin"))
    return notify_fail("你已经运用太阴炼形法。\n");

  me->set_temp("linji/taiyin", 1);
  tell_object(me, HIM "\n你由动归静，使气脉归入丹田。真气在丹田里，似动非动。这就是阴阳的真正规律。\n" NOR);
  me->add("neili", -1000);

  call_out("tian", 3, me, target);
  return 1;
}

int tian(object me, object target) {
  int maxqi, amount;

  if (me->is_fighting()) {
    tell_object(me, HIG "\n你逐渐将「天字庄」运用全身。\n" NOR);
    me->set("env/prompt", "天");
    if (living(me) && (maxqi < me->query("max_qi") * 95 / 100 && me->query("neili") > 150)) {
      amount = (me->query_skill("linji-zhuang", 1) + me->query_skill("mahayana", 1)) / 5 + 10;
      me->add("neili", amount * 2);
      me->receive_curing("qi", amount * 2);
    }
    if (living(me) && (me->query("qi") < (maxqi * 2 / 3))) {
      amount = maxqi - me->query("qi");
      if (amount > me->query_temp("linji/taiyin")) amount = me->query_temp("linji/taiyin");
      me->receive_heal("qi", amount * 2);
    }
    call_out("di", 3, me, target);
  } else
    tell_object(me, HIM "\n你所聚太阴炼形法之气已散开，你又恢复了原状。\n" NOR);
  me->delete("env/prompt");
  me->delete_temp("linji/taiyin");

  return 1;
}


