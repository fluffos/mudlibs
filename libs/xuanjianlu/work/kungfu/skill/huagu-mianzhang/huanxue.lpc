// 毒龙换血大法

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        string weapon;
              mapping myfam;

        if( !target ) target = offensive_target(me);

        if( !target || !living(target))
                return notify_fail("你要和谁换血？\n");

        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你只有空手才能施展「毒龙换血大法」。\n");

        if ( (!( myfam= me->query("family")) || myfam["family_name"] != "神龙教"))
                return notify_fail("你并非神龙弟子,无法使用「毒龙换血大法」！\n");

	 if( me->query("gender") != "男性")
                return notify_fail("你并非男性，无法使用化骨棉掌绝学。\n");

        if( environment(target)->query("no_fight") )
                return notify_fail("这里不能换血！\n");

        if( me->query_con() < 40 )
                return notify_fail("你的体制太弱换血只能伤己！\n");
                
        if( me->query_skill_mapped("strike") != "huagu-mianzhang" )
                return notify_fail("你所用并非化骨棉掌,无法施展「毒龙换血大法」!\n");

	if( me->query_skill("dulong-dafa", 1) < 300 )
		return notify_fail("你的毒龙大法火候未到，无法施展「毒龙换血大法」！\n");

	if(me->query_skill_mapped("force") != "dulong-dafa")
		return notify_fail("没有激发毒龙大法内功,无法施展「毒龙换血大法」");

        if(me->query_skill("force") < 200 )
                return notify_fail("你的内功火候未到，无法施展「毒龙换血大法」！\n");

        if( (int)me->query_skill("strike") < 200 )
                return notify_fail("你的化骨棉掌不够娴熟，无法施展「毒龙换血大法」。\n");

        if( me->query("neili") < 500)
                return notify_fail("你的内力不够！\n");
		

		message_vision(WHT"\n$N双臂反在背后，突然双手十指弯起，各成半球之形，身子向后一撞十指便抓\n" NOR, me, target);
		message_vision(WHT"向$n的胸部，$n向后一缩，$N突然一个倒翻筋斗，身子跃起双腿一分，\n" NOR, me, target);
		message_vision(WHT"已跨在$n肩头,运起"HIR"「毒龙换血大法」"NOR""WHT"双手按指压住$n太阳穴！\n\n" NOR, me, target);

		target->kill_ob(me);	

	      if (  me->query_con() > random(target->query_con()) && me->query("neili") > random(target->query("neili")))
		{	
		message_vision(HIB"\n$n感觉到一阵阵寒气从太阳穴缓缓进入,同时体内的血液从太阳穴被$N急速吸出。\n\n"NOR,me,target);
		
		if ( me->query_skill("force") > random(target->query_skill("force")*2) )		
		
		{
			message_vision(HIC"\n$n感觉到不妙,急忙将头顶的$N甩了下来,但已经有鲜血从太阳穴冒出,受伤不轻。\n"NOR,me,target);
			me->receive_curing("qi",target->query("max_qi")/4);
			me->add("qi",target->query("max_qi")/4);
			target->set("qi", target->query("max_qi")/4);
			target->apply_condition("sl_poison",40); 
			target->receive_wound("qi", target->query("max_qi")/4, "中毒龙换血大法,血液流尽而亡" );
		}
              else	
		{
             		message_vision(HIC"\n$n感觉到不妙,急忙将头顶的$N甩了下来,虽然没有受伤，但是已经中毒。\n"NOR,me,target);

			target->apply_condition("sl_poison",60); 
	

              }
              }
		else	
		{
		message_vision(HIG"\n$n大惊之下，急忙闪身躲开。$N双手寒气无法排除,急忙护住心脉,以免毒气攻心。\n"NOR,me,target);
		me->add("qi", me->query("max_qi")/30);
		me->apply_condition("sl_poison",30);
		me->receive_wound("qi", me->query("max_qi")/30, "毒龙换血大法失败,血液流尽而亡");
		}

		me->add("neili", -200);
		me->add("jingli", -100);

        	me->start_busy(2+random(3));

        	return 1;
		}
