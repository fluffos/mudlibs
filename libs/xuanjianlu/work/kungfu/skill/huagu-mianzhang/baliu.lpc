// 鲁达拔柳
// 用于牵制敌人
// pingguo

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「鲁达拔柳」只能对战斗中的对手使用。\n");


  if ((int)me->query_skill("force") < 100)
    return notify_fail("你的内功修为不够火候，无法施展「鲁达拔柳」。\n");

  if (me->query("gender") != "男性")
    return notify_fail("你并非男性，无法使用化骨棉掌绝学。\n");

  if (me->query_skill_mapped("force") != "dulong-dafa")
    return notify_fail("只有神龙教独门内功才能施展「鲁达拔柳」！\n");

  if (me->query("neili") <= 300)
    return notify_fail("你的内力不够！\n");

  if (me->query("jingli") <= 200)
    return notify_fail("你的精力不够！\n");

  if (me->query_skill_mapped("parry") != "huagu-mianzhang")
    return notify_fail("你没有将化骨棉掌运用于招架之上，无法将「鲁达拔柳」发挥出来。\n");

  if ((int)me->query_temp("juding"))
    return notify_fail("你正在使用「子胥举鼎」无法分心使用「鲁达拔柳」！\n");

  if ((int)me->query_skill("strike") < 150)
    return notify_fail("你的化骨棉掌不够娴熟，无法施展「鲁达拔柳」。\n");

  if (target->is_busy()) {
    me->add("neili", -10);
    me->add("jingli", -5);
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧!\n");
  }

  message_vision(HIG "\n$N俯伏地上，$n伸右足踏住$N的后腰，$N双腿一缩，似欲跪拜！\n" NOR, me, target);
  message_vision(HIG "\n右臂却慢慢横掠而出，突然间一个筋斗，向$n的胯下钻去，只一作势！\n\n" NOR, me, target);



  me->add("neili", -80);
  me->add("jingli", -20);

  if (((random(me->query("combat_exp") / 4000) * (int)me->query_skill("strike")) >
    (((int)target->query("combat_exp") / 5000) * ((int)target->query_skill("parry") / 2 + (int)target->query_skill("dodge") / 2)) / 4)) {



    message_vision(HIC "\n结果$n被$N的奇怪招数攻了个手忙脚乱，一时无法还招进攻！\n" NOR, me, target);
    message_vision(HIR "\n$N左手已抓住$n右脚足踝，趁$n无法进攻之际，右手急攻$n两招！" NOR, me, target);

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));



    target->start_busy((int)me->query_skill("strike") / (40 + random(10)));
  } else {

    message_vision(HIW "\n可是$n看破了$N的企图，并没有上当。\n\n" NOR, me, target);



    me->start_busy(1 + random(3));
  }


  return 1;
}
