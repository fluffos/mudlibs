//tie-zhang
//liu 2002
/*
裘千仞更不答话，一声长啸，双掌猛往黄蓉左右双肩拍去。黄蓉笑嘻嘻的并不理会，
不闪不避，有心要叫软猬甲上的尖刺在他掌上刺下十多个窟窿，只听得郭靖惊叫：
“蓉儿闪开。”耳旁一股劲风过去，知道郭靖出手侧击敌人，只觉肩上两股巨力同时
撞到，欲待趋避，已自不及，身不由主的往后摔去，人未着地，气息已闭。

精神一振，掌力更为沉狠，料得定时候稍长，对手终究会抵挡不住，眼见郭靖挥掌
猛击而来，当即侧身，避过正面锋锐，右掌高，左掌低，同时拍出。郭靖回掌兜截，
四掌相接，各使内劲。两人同时“嘿”的一声呼喊，都退出了三步。

谭公身裁矮小，武功却着实了得，左掌拍出，右掌疾跟而至，左掌一缩回，又加在
右掌的掌力之上。他这连环三掌，便如三个浪头一般，后浪推前浪，并力齐发，比
之他单掌掌力大了三倍。乔峰叫道：“好一个‘长江三叠浪’！”左掌挥出，两股掌力
相互激荡，挤得余人都向两旁退去。
*/

#include <ansi.h>
inherit F_SSERVER;

void checking(object me,object target);

int perform(object me, object target)
{
        int skill, jiali;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("此绝技只能对战斗中的对手使用。\n");

        if( me->query_skill_mapped("parry") != "tie-zhang" )
                return notify_fail("你不全面激发铁掌掌法，无法施展此绝技！\n");

        if( me->query_skill("force") < 300 )
                return notify_fail("你的内功火候未到，无法施展此绝技！\n");

        if( me->query_skill("strike") < 350 )
                return notify_fail("你的掌法修为不足，还不会使用此绝技！\n");

        if( me->query("neili") <= 900 ) return notify_fail("你的内力不够！\n");

		jiali=(int)me->query("jiali");
		if( jiali < 50 )
			return notify_fail("如此刚猛掌法掌上不带内力怎能使出？\n");

	me->set_temp("tiezhang",1);
	checking(me,target);
	return 1;
}

void checking(object me,object target)
{
	string msg;
	int num = me->query_temp("tiezhang",1);
	int ap = me->query("combat_exp",1)/1000 + me->query_skill("strike") + (int)me->query("jiali") + me->query("str")*20;
	int dp = target->query("combat_exp",1)/1000 + target->query_skill("parry") + target->query_skill("dodge")+ target->query("dex")*40;

	if( !target || !me->is_fighting(target) || !living(target) || !living(me) || me->is_ghost() || (int)me->query("neili") < 0
	|| me->query_temp("tiezhang",1)==4 )
	{
		me->start_busy(2+random(2));
		me->delete_temp("tiezhang");
		return;
	}

	if(num==1) msg=HIR"\n$N一声长啸，双掌猛往$n左右双肩拍去！$n只听耳旁一股劲风过来，知道$N掌力已到！\n" NOR;
	else if(num==2) msg=HIW"\n$N精神一振，掌力更为沉狠，料定时候稍长，对手终究会抵挡不住，眼见$n挥掌猛击而来，当即侧身，避过正面锋锐，右掌高，左掌低，同时拍出！\n" NOR;
	else msg=HIB"\n$N左掌拍出，右掌疾跟而至，左掌一缩回，又加在右掌的掌力之上！这连环三掌，便如三个浪头一般，后浪推前浪，并力齐发，比之单掌掌力大了三倍！！\n" NOR;

	if( random(ap) > dp*2/3 ) {
		msg+=RED"\n$n只觉肩上一股巨力撞到，欲待趋避，已自不及，身不由主的往后摔去，人未着地，气息已闭。\n" NOR;
		target->receive_damage("qi", target->query("max_qi"), me);
		target->receive_wound("qi", target->query("max_qi"), me);
	} else if( random(ap) > dp/2 ) {
        	msg+=HIR"\n$n回掌兜截，四掌相接，各使内劲，结果$n脸色一下变得惨白，昏昏沉沉接连退了好几步！\n" NOR;
		target->receive_damage("qi", target->query("max_qi")/3, me);
		target->receive_wound("qi", target->query("max_qi")/5, me);
	} else if( random(ap) > dp/3 ) {
        	msg+=HIY"\n$n回掌兜截，四掌相接，各使内劲。两人同时“嘿”的一声呼喊，都退出了三步。\n" NOR;
		target->receive_damage("qi", target->query("max_qi")/8, me);
	} else msg+=HIC"\n$n叫道：“好一个‘长江三叠浪’！”左掌挥出，两股掌力相互激荡，挤得余人都向两旁退去。\n" NOR;

	me->add_temp("tiezhang",1);
	me->add("neili",-me->query_skill("force")*3 - (int)me->query("jiali"));
	if ((int)me->query("neili") < 0)
		me->set("neili",0);

	me->start_busy(2);
	message_vision(msg,me,target);
//	COMBAT_D->report_status(target);

	if(target->query("eff_qi")<=0)
	{
		target->set("eff_qi",0);
		target->unconcious();
	}
	if(target->query("qi")<=0)
	{
		target->set("qi",0);
		target->unconcious();
	}
	if(target->query("jingli")<=0) target->unconcious();

        call_out("checking", 1, me, target);
	return;
}

