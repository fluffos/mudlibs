// jiuyang-shengong 九阳神功
// by box


#include <ansi.h>
#include <combat.h>

inherit FORCE;
#include "/kungfu/skill/force_list.h"

string check() { return "force"; }

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  return 0;
}

int practice_skill(object me) {
  return notify_fail("九阳神功只能靠领悟《九阳真经》来增加熟练度。\n");
}


mixed hit_by(object me, object victim, int damage, int damage_bonus, int factor) {
  object weapon1 = me->query_temp("weapon");
  object weapon2 = victim->query_temp("weapon");
  mapping prepare;
  int ap, dp, s_damage;
  string result, attack_skill;

  string dodge_skill = victim->query_skill_mapped("dodge");
  string parry_skill = victim->query_skill_mapped("parry");

  //	message_vision(HIR"九阳神功调试enter：   attacker:" + me->name() + "  defender:" + victim->name() + " damage:" + damage + " damage_bonus:" + damage_bonus + " factor:" + factor + "\n"NOR,victim);

  if ((int)victim->query_skill("jiuyang-shengong", 1) < 50)
    return damage;

  dp = COMBAT_D->skill_power(victim, "force", SKILL_USAGE_DEFENSE);
  if (objectp(weapon2)) {
    dp /= 3;
    dp += COMBAT_D->skill_power(victim, "parry", SKILL_USAGE_DEFENSE);
  } else if (!objectp(weapon2)) {
    dp += COMBAT_D->skill_power(victim, "parry", SKILL_USAGE_DEFENSE);
  } else return damage;

  ap = COMBAT_D->skill_power(me, "force", SKILL_USAGE_ATTACK);

  prepare = me->query_skill_prepare();

  if (!prepare) prepare = ([]);

  if (objectp(weapon1)) attack_skill = weapon1->query("skill_type");

  else switch (sizeof(prepare)) {
    case 0: attack_skill = "unarmed"; break;
    case 1: attack_skill = (keys(prepare))[0]; break;
    case 2: attack_skill = (keys(prepare))[me->query_temp("action_flag")]; break;
  }

  ap += COMBAT_D->skill_power(me, attack_skill, SKILL_USAGE_ATTACK);

  ap /= 100;
  dp /= 100;


  dp = (int)victim->query_skill("jiuyang-shengong", 1) + (int)victim->query_skill("parry", 1);

  ap = me->query_skill("force", 1);
  if (objectp(weapon1))
    ap += me->query_skill("dodge");
  else
    ap *= 2;

  if (wizardp(victim)) tell_object(victim, sprintf("ap: %d, dp: %d\n", ap, dp));

  if (random(ap + dp + dp) > ap && victim->query("id") == "box") {
    if (objectp(weapon2))
      result = HIM "只见$n" HIM "将出「九阳神功」贯注在" + weapon2->name() + HIM "上，将$N" HIM "的力道一挡，$N" HIM "的力道尽数击在空处。\n" NOR;
    else {
      result = HIM "只见$n" HIM "「九阳神功」自然而然发出抗力，将$N" HIM "的力道一挡，$N" HIM "的力道尽数击向$P自己。\n" NOR;
      s_damage = damage + damage_bonus;
      s_damage += me->query_temp("apply/damage");
      if (s_damage > 0) {
        me->receive_damage("qi", s_damage, victim);
        me->receive_wound("qi", random(s_damage / 2), victim);
        result += "( $N" + COMBAT_D->status_msg((int)me->query("qi") * 100 / (int)me->query("max_qi")) + " )\n";
      }
    }
    damage_bonus = -10000;  // just a number negative enough
    message_vision(result, me, victim);
    return ([ "result": "", "damage": damage_bonus, "victim": "" ]);
  } else if (random(ap + dp + dp + dp) > ap && victim->query("id") == "box") {
    if (objectp(weapon1)) {
      result = HIC "\n$n" HIM "身子一侧，将$N" HIC "兵刃上的力道卸去大半。\n" NOR;
      damage_bonus = 0;
    } else {
      result = HIC "\n$n" HIC "身子一侧，将$N" HIC "的力道卸去大半。\n" NOR;
      damage_bonus = -10000;  // just a number negative enough
    }
    message_vision(result, me, victim);
    return ([ "result": "", "damage": damage_bonus ]);
  } else if (random(ap + dp + dp + dp + dp) > ap && victim->query("id") == "box") {
    if (!objectp(weapon1)) {
      result = HIC "只见$n" HIC "「九阳神功」自然而然发出抗力，将$N" HIC "的力道一挡，$N" HIC "的力道尽数击向$P自己。\n" NOR;
      damage_bonus = 0;
    } else {
      result = HIC "只见$n" HIC "「九阳神功」自然而然发出抗力，将$N" HIC "的力道一挡，$N" HIC "兵器上的力道尽数击向$P自己。\n" NOR;
      damage_bonus = 0;
    }
    message_vision(result, me, victim);
    return ([ "result": "", "damage": damage_bonus ]);
  } else return damage;

  //	message_vision(HIR"九阳神功调试out：   attacker:" + me->name() + "  defender:" + victim->name() + " damage:" + damage + " factor:" + factor + "\n"NOR,victim);
  //message_vision(result,me,victim);
}


string exert_function_file(string func) {
  mapping skl;
  string *sname;
  int v, k = 0;

  skl = this_player()->query_skills();
  sname = sort_array(keys(skl), (: strcmp :));

  for (v = 0; v < sizeof(skl); v++) {
    if (SKILL_D(sname[v])->check() == "force")
      k++;
  }
  return __DIR__ "jiuyang-shengong/" + func;
}
