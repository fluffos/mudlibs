// 圣火令上的怪异武功
// shenghuo-ling.c 圣火令法(古波斯武功)
// lbc 2002/3
// 应左则前 须右乃后 三虚七实 无中生有 天方地圆

#include <ansi.h>

inherit SKILL;

void yinfeng_attack(object me, object victim, object weapon);

string type() 
{ 
	return "knowledge";
}

string *dodge_msg = ({
        HIB"$n"HIB"东一闪、西一晃，尽数避开。\n"NOR,
        HIB"不料$n"HIB"脚下不知如何移动，身形早变。\n"NOR,
        HIB"便在这一瞬之间，$n"HIB "滚身避开。\n"NOR,
        HIB"$n"HIB"脚下一踬，忽然一个筋斗摔了出去，身法怪异，已达极点。\n"NOR,
        HIB"就在此时$n"HIB"突然间倒退两步，向后一个空心筋斗，凌空落下。\n"NOR,
        HIB"$n"HIB"纵身而起，几个起落，早已跃开。\n"NOR,
        HIB"眼见$n"HIB"难以抵挡，不料$p在地下一个打滚，狼狈万状的滚开。\n"NOR,
        HIB"$n"HIB"东滚一转，西摔一交，要多难看就有多难看，要多狼狈就有多狼狈。\n"NOR,
        HIB"$n"HIB"越来越是招架不住，手忙足乱，竟似比一个初学武功的莽汉尤有不如，但不论情势如何凶险，$p总能在千钧一发之际避开对方的凌厉杀着。\n"NOR
});

mapping *unarmed_action = ({
        ([  "action" : "$N一声呼啸，抢上三步，向$n胸腹间连拍三掌",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "突然之间，$N身形晃动，欺近$n，左手往$p身上抓去",
            "damage_type" : "抓伤"
        ]),
        ([  "action" : "$N脚下不知如何移动，身形已变，右手抓向$n$l",
            "damage_type" : "抓伤"
        ]),
        ([  "action" : "$N纵身而起，两个起落，已跃到$n身侧，跟着直欺而前，伸指点向$n$l",
            "damage_type" : "内伤"
        ]),
        ([  "action" : "$N粗着嗓子胡胡大呼，在半空中翻个空心筋斗，伸臂向$n抓到",
            "damage_type" : "抓伤"
        ]),
        //([  "action" : "$N一低头，将脑袋往$n迎去，忽地卧倒，向前扑出，双手向$n/*下肢*/抓去",
		// 若是抓向下肢, 随机的$l如何解释
		([  "action" : "$N一低头，将脑袋往$n迎去，忽地卧倒，向前扑出，双手向$n抓去",	
            "damage_type" : "抓伤"
        ]),
        ([  "action" : "$N在地下一个打滚，狼狈万状的滚向$n身边，身子一晃，肩头已向$n撞去",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "$N上身微斜，右臂弯过，从莫名其妙的方位转了过来，打向$n$l",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "$N欺身直进，寻隙攻上，左手手肘向$n$l撞去",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "便在一瞬之间，$N滚身向左，一拳打向$n$l，这一拳来无影，去无踪，竟无半点风声",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "$N突然连翻三个空心筋斗，忽地伸过右手击向$n$l，匪夷所思，事先竟无半点征兆",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "$N左手斜击甩上，招数怪异无比，堪堪便要点中$n$l",
            "damage_type" : "瘀伤"
        ]),
//        ([  "action" : "$N一拳打来，依照武学的道理，这一招必是打在$n左肩，哪知$P手在半途古古怪怪的转了个弯，竟打向在$n后颈",
        ([  "action" : "$N一拳打来，依照武学的道理，这一招必是打在$n左肩，哪知$P手在半途古古怪怪的转了个弯，竟打向$n$l",
            "damage_type" : "内伤"
        ]),
        ([  "action" : "$N直抢而前，脚下一踬，忽然一个筋斗摔了过去，身法怪异，已达极点，$P似是向前摔跌，双手却已向$n$l拍了过去",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "$N双手急挥横扫，看上去颠三倒四，实则中藏奇奥变化，越来越奇幻莫测",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "$N怪招层出不穷，每一招都足以迷乱敌人眼光，似左实右，似前实后，使$n难以辨识",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "$N突然间一声清啸，双手擒拿而出，三虚七实，武功怪异无比，神奇之极",
		    "damage_type" : "瘀伤"
        ]),
//        ([  "action" : "$N一个筋斗，身在半空，落下时右腿的膝盖跪向$n头顶",
        ([  "action" : "$N一个筋斗，身在半空，落下时右腿的膝盖跪向$n$l",
            "damage_type" : "内伤"
        ]),
        ([  "action" : "$N向后一坐，撞向$n的怀里，双肘向后撞出，诡秘阴毒，匪夷所思",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "$N忽然低头，一个头锤向$n撞来，如此打法原是武学中大忌，竟以自己最要紧的部位送向敌人",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "蓦地里$N脑袋乱摆，划着一个个圈子，摇头晃脑的装模作样。忽地着地一滚，抱向$n双腿",
//因为抱向双腿的结果是摔跌, 摔跌的部位未知, 所以此处为合理
			"damage_type" : "跌伤"
        ]),
        ([  "action" : "蓦地里$N跃身半空，向$n头顶坐了下来。这一招甚是怪异，竟以臀部攻人，天下武学之道虽繁，从未有这一路既无用、又笨拙的招数",
            "damage_type" : "跌伤"
        ]),
        ([  "action" : "$N自后抱向$n。这一抱似乎平平无奇，其实拿捏之准，不爽毫发，应变之速，疾如流星",
            "damage_type" : "跌伤"
        ]),
        ([  "action" : "$N踏上一步，忽地在地上一坐，抱向$n小腿。这招怪异的法门已是圣火令上所记极高深的功夫",
            "damage_type" : "跌伤"
        ]),
        ([  "action" : "$N使开圣火令上的怪异武功，拳打脚踢，一个头槌向$n撞到，这几下兔起鹘落，既快且怪",
            "damage_type" : "瘀伤"
        ]),
        ([  "action" : "突然间$N倒退两步，向后一个空心筋斗，凌空落下，双足骑向$n的肩头",
            "damage_type" : "跌伤"
        ])
});

mapping *weapon_action = ({
        ([ "action" : "$N一声呼啸，抢上三步，$w向$n左右连挥，着着进击",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "突然之间，$N身形晃动，欺近$n，$w往$p砍去",
           "damage_type" : "劈伤"
        ]),
        ([ "action" : "$N脚下不知如何移动，身形已变，$w挥向$n$l",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "$N纵身而起，两个起落，已跃到$n身侧，跟着直欺而前，$w点向$n$l",
           "damage_type" : "刺伤"
        ]),
        ([ "action" : "$N粗着嗓子胡胡大呼，在半空中翻个空心筋斗，$w向$n劈去",
           "damage_type" : "劈伤"
        ]),
        ([ "action" : "$N一低头，将脑袋往$n迎去，忽地卧倒，向前扑出，$w向$n挥去",
           "damage_type" : "割伤"
        ]),
        ([ "action" : "$N在地下一个打滚，狼狈万状的滚向$n身边，身子一晃，$w已向$n打去",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "$N上身微斜，右臂弯过，$w从莫名其妙的方位转了过来，打向$n$l",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "$N欺身直进，寻隙攻上，手中向$n$l上拍落",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "便在一瞬之间，$N滚身向左，$w挥向$n$l，这一下来无影，去无踪，竟无半点风声",
           "damage_type" : "割伤"
        ]),
        ([ "action" : "$N突然连翻三个空心筋斗，$N忽地伸过$w击向$n$l，匪夷所思，事先竟无半点征兆",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "$N手中$w斜击甩上，招数怪异无比，堪堪便要点中$n$l",
           "damage_type" : "刺伤"
        ]),
//        (  "action" : "$N$w打来，依照武学的道理，这一招必是打在$n左肩，哪知$w在半途古古怪怪的转了个弯，竟打向在$n后颈",
        ([ "action" : "$N$w打来，依照武学的道理，这一招必是打在$n左肩，哪知$w在半途古古怪怪的转了个弯，竟打向$n$l",
           "damage_type" : "内伤"
        ]),
        ([ "action" : "$N直抢而前，脚下一踬，忽然一个筋斗摔了过去，身法怪异，已达极点，$p似是向前摔跌，$w却已向$N$l击去",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "$N双手$w急挥横扫，看上去颠三倒四，实则中藏奇奥变化，越来越奇幻莫测",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "$N怪招层出不穷，每一招都足以迷乱敌人眼光，似左实右，似前实后，使$n难以辨识",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "$N突然间一声清啸，$w连环挥击，三虚七实，武功怪异无比，神奇之极",
           "damage_type" : "瘀伤"
        ]),
        ([ "action" : "$N忽地放手，那$w尾端向上弹起，打向$n$l",
           "damage_type" : "瘀伤"
        ])
});

int valid_enable(string usage) 
{         
	return  usage=="unarmed"||
	    usage=="strike" || 
            usage=="cuff"   ||
            usage=="hand"   ||
            usage=="claw"   || 
            usage=="finger" ||
            usage=="dodge"  ||
            usage=="parry"  ||
            usage=="claw"   ||
            usage=="sword"  ||
            usage=="blade"  ||
	    usage=="hammer" ||//for test
            usage=="stroke";
}

int valid_combine(string combo) 
{ 
	return combo=="shenghuo-ling"; 
}

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

nomask int parry_available() 
{ 
	return 1;
}

string query_parry_msg(object weapon, object victim) 
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

mapping query_action(object me, object weapon)
{
    mapping action;
    int force, damage, dodge;

    if( objectp(weapon) )
        action = weapon_action[random(sizeof(weapon_action))];
    else action = unarmed_action[random(sizeof(unarmed_action))];

    damage = me->query("max_neili") / 100;
    damage = (damage+random(damage)) / 30;
    damage += me->query_str();
    force = (me->query_skill("force")+random(damage))/3;
    dodge = me->query_dex();
    dodge = (dodge+random(dodge))/2;

    action["damage"] = damage;
    action["force"] = force;
    action["dodge"] = dodge;
	action["post_action"] = (: yinfeng_attack :);
    return action;
}

int valid_learn(object me)
{
    return notify_fail("圣火令的武功不是这么修习的。\n");
}

int practice_skill(object me)
{
    return notify_fail("圣火令的武功不是这么练习的。\n");
}

void yinfeng_attack(object me, object victim, object weapon)
{
	string *msg, weapon_name;
	int skill, damage;
	if (me->query_temp("yinfeng_attack") > 1) //最大2次叠加post_action
	{
		me->delete_temp("yinfeng_attack");
		return;
	}
	me->add_temp("yinfeng_attack", 1);
	
	if (weapon)
	{
		weapon_name = weapon->query("name");
		msg = ({
		WHT"\n$N突然招式变得更加怪异，胡踢瞎打，却招招落在$n薄弱之处！" NOR,
        WHT"\n$N趁$n被阴风刀内力所伤之际，手中" + weapon_name + WHT"长驱直入，直击向$n！"NOR,
        WHT"\n$N哈哈哈仰天三笑，" + weapon_name + WHT"闪电般挥向$n，却不带半点风声！"NOR,
		WHT"\n$n穴道被阴寒内力所闭，无法动弹，只得眼看着$N一招招向自己攻来！"NOR,
		});
	}
	else 
		msg = ({
		WHT"\n$N突然招式变得更加怪异，胡踢瞎打，却招招落在$n薄弱之处！" NOR,
        WHT"\n$N趁$n被阴风刀内力所伤之际，揉身而上，连环进击！"NOR,
        WHT"\n$N哈哈哈仰天三笑，闪电般出招攻向$n，却不带半点风声！"NOR,
		WHT"\n$n穴道被阴寒内力所闭，无法动弹，只得眼看着$N一招招向自己攻来！"NOR,
		});

	skill = me->query_skill("shenghuo-ling", 1);
	if ( (skill >= 160) 
		&& victim->query_temp("bosi/yinfeng") 
		&& me->query("neili") > 200
		&& random(5))
	{
		damage = skill / 2;
		if (damage > 160)
			damage = 160; //因为有可能出现2次叠加post_action, 所以最大damage是320, 而非160
		message_vision(msg[random(sizeof(msg))], me, victim );

		me->add("neili", -(100+random(damage)));
		me->add_temp("apply/attack", damage);
		me->add_temp("apply/damage", damage);
		COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));
		me->add_temp("apply/attack", -damage);
		me->add_temp("apply/damage", -damage);
	}
	return;
}

string perform_action_file(string action)
{
	return __DIR__"shenghuo-ling/" + action;
}
