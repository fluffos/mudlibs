//by spirit
//wuliang.c
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

#include "/kungfu/skill/eff_msg.h";
int perform(object me, object target)
{
	int lvl,skill;
	string weapon;

        if( !target ) target = offensive_target(me);
            if( !target || !target->is_character())
              return notify_fail("你想偷袭谁?\n");

            if( environment(target)->query("no_fight"))
           return notify_fail("这里不能偷袭。\n");
         
        if( objectp( me->query_temp("weapon")) )
                return notify_fail("只有空手才能施展盘古巨斧。\n");

        if( (int)me->query_skill("dizhu-zhang", 1) < 120 ||
            (int)me->query_skill("strike", 1) < 120 ||
            (int)me->query_str() < 30)
                return notify_fail("你有的功夫还不够娴熟，不会使用盘古巨斧。\n");

	 if( !wizardp(me) ) tell_object(me, "你不是巫师，不可造次！");
         
       if (me->query_skill_prepared("strike") != "dizhu-zhang" || 
           me->query_skill_mapped("strike") != "dizhu-zhang" )
                return notify_fail("你现在无法使用盘古巨斧进行攻击。");  
      
       if( (int)me->query("max_neili") < 1500 )
                return notify_fail("你的内力修为太弱，不能使用盘古巨斧！\n");
        
       if( (int)me->query("neili") < 10 )
                return notify_fail("你的真气不够！\n");

       if( (int)me->query_temp("wuliang") ) 
                return notify_fail("天之痕尚未修补，你不能再次使用盘古巨斧。\n");

	me->add("neili", -4);
	me->add("jing", -1);
       me->set_temp("wuliang",1);
       message_vision(HIG"\n$N双手祭在胸前，口中默念无上真言，天地之间微微颤动，一道剑气从$N的身体里迸出来！\n" NOR, me);
       me->start_busy(2);
       target->start_busy(2);
       call_out("step2",2,me,target);
	return 1;
}

void step2(object me,object target)
{
       message_vision(WHT"\n初时，剑气只是若隐若现，$N口中兀自喃喃不绝，突然间一声长啸，剑气猛然加强，" NOR, me);
       message_vision(WHT"\n一条无匹的光柱冲天而起，在空中隐约形成一把巨斧。\n" NOR, me);
        me->start_busy(1);
       target->start_busy(1);
       call_out("step3",1,me,target);
       return;
}

void step3(object me,object target)
{
       message_vision(HIW"\n$N双手摊开，天空中雷声滚动，巨斧开始变得雪亮，缓慢的向天地之间的界限处劈开去。\n" NOR, me);
       me->start_busy(3);
       target->start_busy(3);
       call_out("step4",3,me,target);
       return;
}

void step4(object me,object target)
{
       message_vision(HIR"\n天空中开始出现了裂痕，无数幽怨的灵魂向裂痕冲撞，隐隐有血光从裂痕处蔓延开来。" NOR, me);
       message_vision(HIR"\n裂痕处一只大手将$N抓了起来，迅速消失在天边不见了。\n" NOR,target,me);
       me->start_busy(2);
       target->start_busy(2);
       target->move("/d/city/guangchang");
        call_out("step5",2,me,target);
       return;
}

void step5(object me,object target)
{
	me->delete_temp("wuliang");
       message_vision(HIG"\n$N袖袍潇洒的一挥，巨斧渐渐变得透明，最终连同裂痕一起消失了，天地之间似乎什么也没发生过。\n" NOR,me); 
}