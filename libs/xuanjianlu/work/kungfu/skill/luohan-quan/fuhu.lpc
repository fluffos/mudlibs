//luohan-quan perform fuhu
//by liu 2002
/*
郭靖见那和尚使的
是少林罗汉拳，胖子使的是五行拳，都是外门功夫。和尚纵高伏低，身手便捷。那
胖子却是拳脚沉雄，莫瞧他年老，竟是招招威猛。斗到分际，和尚猱身直进，砰砰
砰，在胖子腰里连锤三拳，那胖子连哼三声，忍痛不避，右拳高举，有如巨锤般锤
将下来，正锤在和尚的光头之上。

陆冠英也盼望他指点
几手，心想这样的高人旷世难逢，只要点拨我一招一式，那就终身受用不尽，当下
走到厅中，说道：“请太公指点。”拉开架式，使出生平最得意的一套“罗汉伏虎
拳”来，拳风虎虎，足影点点，果然名家弟子，武功有独到之处，打得片刻，突然
一声大吼，恍若虎啸，烛影摇晃，四座风生。众庄丁寒战股栗，相顾骇然。他打一
拳，喝一声，威风凛凛，宛然便似一头大虫。便在纵跃翻扑之际，突然左掌竖立，
成如来佛掌之形。原来这套拳法中包含猛虎罗汉双形，猛虎剪扑之势、罗汉搏击之
状，同时在一套拳法中显示出来。再打一阵，吼声渐弱，罗汉拳法却越来越紧，最
后砰的一拳，击在地下，着拳处的方砖立时碎裂。陆冠英托地跃起，左手擎天，右
足踢斗，巍然独立，俨如一尊罗汉佛像，更不稍有晃动。
*/

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int link_one(object me, object target);
int link_two(object me, object target);
int link_three(object me, object target);
int link_four(object me, object target);
int remove_effect(object me);

int perform(object me, object target)
{
	if( !target ) target = offensive_target(me);

/*
	if( !wizardp(me) )
		return notify_fail("「罗汉伏虎」暂时不开放。\n");
*/

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「罗汉伏虎」只能对战斗中的对手使用。\n");

	if( (int)me->query_skill("buddhism",1) < 200 )
		return notify_fail("你的佛法修为不够，无法使用「罗汉伏虎」\n");

	if( (int)me->query_skill("cuff") < 300 )
		return notify_fail("你的鹰爪功不够娴熟，施展不出「罗汉伏虎」\n");

	if( me->query_skill_mapped("force") != "hunyuan-yiqi" )
		return notify_fail("你所用的并非混元一气功，施展不出「罗汉伏虎」\n");

        if( (int)me->query_skill("force") < 300 )
                return notify_fail("你的混元一气功火候不够，施展不出「罗汉伏虎」\n");

	if( me->query("neili",1) < 1000 )
		return notify_fail("你的内力不够施展「罗汉伏虎」\n");

	message_vision(HIW "\n$N说道：“请"+ RANK_D->query_respect(target) +"指点。”当下拉开架式，使出生平最得意的一套“"+HIR+"罗汉伏虎拳"+HIW+"”来，拳风虎虎，足影点点！\n"NOR,me,target);

	me->add_temp("apply/attack", 100);
	me->add_temp("apply/dodge", 100);

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

	COMBAT_D->do_attack(target, me, target->query_temp("weapon"));

	if ( me->query_skill("cuff") > 400 )
	{ 
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	}

	me->add_temp("apply/attack", -100);
	me->add_temp("apply/dodge", -100);

	me->add("neili", -200);
	me->start_busy(2);
	target->start_busy(2);
	call_out("link_one", 1, me, target);
	return 1;
}

int link_one(object me, object target)
{
	if( !target || !me->is_fighting(target) || !living(target) || !living(me) || me->is_ghost() )
	{call_out("remove_effect", 1, me);return 1;}

	message_vision("\n$N拳式不收，打得片刻，$N突然一声大吼，恍若虎啸，烛影摇晃，四座风生！\n"NOR,me,target);

	me->add_temp("apply/attack", 200);
	me->add_temp("apply/dodge", 200);

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

	COMBAT_D->do_attack(target, me, target->query_temp("weapon"));

	if ( me->query_skill("cuff") > 400 )
	{ 
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	}
	me->add_temp("apply/attack", -200);
	me->add_temp("apply/dodge", -200);

	me->add("neili", -100);
	me->start_busy(2);
	target->start_busy(2);
	call_out("link_two", 1, me, target);
	return 1;
}

int link_two(object me, object target)
{
	if( !target || !me->is_fighting(target) || !living(target) || !living(me) || me->is_ghost() )
	{call_out("remove_effect", 1, me);return 1;}

	message_vision("\n$N拳式不收，打一拳，喝一声，威风凛凛，宛然便似一头大虫！\n"NOR,me,target);

	me->add_temp("apply/attack", 300);
	me->add_temp("apply/dodge", 300);

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

	COMBAT_D->do_attack(target, me, target->query_temp("weapon"));

	if ( me->query_skill("cuff") > 400 )
	{ 
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	}
	me->add_temp("apply/attack", -300);
	me->add_temp("apply/dodge", -300);

	me->add("neili", -100);
	me->start_busy(2);
	target->start_busy(2);
	call_out("link_three", 1, me, target);
	return 1;
}
int link_three(object me, object target)
{
	if( !target || !me->is_fighting(target) || !living(target) || !living(me) || me->is_ghost() )
	{call_out("remove_effect", 1, me);return 1;}

	if(me->query_skill("banruo-zhang")) me->prepare_skill("strike", "banruo-zhang");
	else if (me->query_skill("sanhua-zhang")) me->prepare_skill("strike", "sanhua-zhang");
	else {call_out("remove_effect", 1, me);return 1;}

	message_vision(HIY "\n$N拳式不收，便在纵跃翻扑之际，突然左掌竖立，成如来佛掌之形。\n"NOR,me,target);

	me->add_temp("apply/attack", 500);
	me->add_temp("apply/dodge", 500);

	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

	COMBAT_D->do_attack(target, me, target->query_temp("weapon"));

	if ( me->query_skill("cuff") > 400 && me->query_skill("strike") > 400 )
	{ 
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	}

	me->add_temp("apply/attack", -500);
	me->add_temp("apply/dodge", -500);

	me->prepare_skill("strike");

	me->add("neili", -200);
	me->start_busy(2);
	target->start_busy(2);
	if(target) call_out("link_four", 1, me, target);
	if(!target) call_out("remove_effect", 2, me);
	return 1;
}

int link_four(object me, object target)
{
	if( !target || !me->is_fighting(target) || !living(target) || !living(me) || me->is_ghost() )
	{call_out("remove_effect", 1, me);return 1;}

	if( random(me->query("combat_exp",1)/1000) < target->query("combat_exp",1)/2000 )
	{
		message_vision(HIR "\n再打一阵，吼声渐弱，罗汉拳法却越来越紧，最后砰的一拳，击在地下，着拳处的方砖立时碎裂。\n"NOR,me,target);
		me->start_busy(random(2)+1);
	} else {
		message_vision(RED "\n斗到分际，$N猱身直进，砰砰砰，在$n腰里连锤三拳，$n连哼三声，忍痛不避！\n"NOR,me,target);
		target->add("eff_qi",-(target->query("max_qi")/3));
		target->add("qi",-(target->query("max_qi")/2));
		me->start_busy(random(2)+2);
	}
	me->add("neili", -200);
	target->start_busy(random(1)+1);
	call_out("remove_effect", 1, me);
	return 1;
}
int remove_effect(object me)
{
        me->set_temp("apply/attack", 0);
        me->set_temp("apply/dodge", 0);

	message_vision(YEL "\n$N托地跃起，左手擎天，右足踢斗，巍然独立，俨如一尊罗汉佛像，更不稍有晃动。\n"NOR,me);
        return 0;
}
