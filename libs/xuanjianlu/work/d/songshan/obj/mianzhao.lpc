//Cracked by box
// mianzhao.c 面罩
// modified by box 2002.4

#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name("面罩", ({ "mian zhao", "mask" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 0);
    set("unit", "个");
    set("long", "这是个黑布头套，能把整个脑袋套起来，只露出两个眼睛。\n");
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("songshan", 1);
  }
  setup();
}

void init() {
  add_action("do_wear", "wear");
  add_action("do_remove", "remove");
  add_action("do_discuss", "discuss");
  add_action("do_discuss", "商讨");
  add_action("do_discuss", "讨论");
  add_action("do_arrest", "arrest");
  add_action("do_arrest", "zhua");
}

int do_wear(string arg) {
  if (!arg || (arg != "mian zhao" && arg != "mask")) return 0;

  this_player()->set_temp("apply/name", ({ "蒙面人" }));
  this_player()->set_temp("apply/short", ({ "蒙面人(Mengmian ren)" }));
  this_player()->set_temp("apply/long", ({ "一个黑布蒙面，神秘兮兮的家伙。\n" }));
  return 0;
}

int do_remove(string arg) {
  if (!arg || (arg != "mian zhao" && arg != "mask"))
    return 0;

  this_player()->delete_temp("apply/name");
  this_player()->delete_temp("apply/short");
  this_player()->delete_temp("apply/long");

  return 0;
}

int do_discuss(string arg) {
  string who;
  object me = this_player(), ob, *inv;
  int i;
  inv = all_inventory(environment(me));
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("id") == arg && objectp(inv[i]))
      me = inv[i];
  }
  i = 0;

  if (!me->query("songshan/job"))
    return notify_fail("什么？\n");

  if (!arg || sscanf(arg, "%s", who) != 1)
    return notify_fail("指令格式：discuss <人物>\n");

  if (!objectp(ob = present(who, environment(me))))
    return notify_fail("你要和谁商讨有关并派之事？\n");

  if (ob->query("player_id") != me->query("id"))
    return notify_fail("左盟主要找的不是此人。\n");

  if (ob->query("bang"))
    return notify_fail("你已经抓到了她还费什么唇舌？\n");

  message_vision(CYN "$N说道：“在下此次奉左盟主之命，来到福建，原是有一件大事要和师太会商。”\n" NOR, me, ob);
  message_vision(CYN "$N说道：“此事有关中原武林气运，牵连我五岳剑派的盛衰，实是非同小可之举。”\n" NOR, me, ob);

  ob->set("discussed", 1);
  me->start_busy(2);
  call_out("discuss2", 2, me, ob);
  return 1;
}

int discuss2(object me, object ob) {
  message_vision(CYN "\n$n惊讶的说道：“噢！是吗？”\n" NOR, me, ob);
  message_vision(CYN "$n说道：“不知左盟主所为何事？”\n" NOR, me, ob);
  me->start_busy(2);
  call_out("discuss3", 2, me, ob);
  return 1;
}
int discuss3(object me, object ob) {
  message_vision(CYN "\n$N说道：“左盟主他老人家有个心愿，想将咱们有如一盘散沙般的五岳剑派，归并为一个‘五岳派’。”\n" NOR, me, ob);
  message_vision(CYN "$N说道：“那时人多势众，齐心合力，实可成为武林中诸门派之冠。不知师太意下如何？”\n" NOR, me, ob);
  me->start_busy(2);
  call_out("discuss4", 2, me, ob);
  return 1;
}
int discuss4(object me, object ob) {
  message_vision(CYN "\n$n长眉一轩，说道：“贫尼在恒山派中乃是闲人，素来不理事。这位师兄所提的大事，该当去跟我派掌门定闲师太说才是。”\n" NOR, me, ob);
  me->start_busy(1);
  call_out("discuss5", 1, me, ob);
  return 1;
}
int discuss5(object me, object ob) {
  message_vision(CYN "\n$N说道：“五派合并之事，实在牵涉太广，咱们是知其不可而为之。”\n" NOR, me, ob);
  message_vision(CYN "$N说道：“倘若师太只顾一人享清闲之福，不顾正教中数千人的生死安危，那是武林的大劫难逃，却也无可如何了。”\n" NOR, me, ob);
  me->start_busy(2);
  call_out("discuss6", 2, me, ob);
  return 1;
}
int discuss6(object me, object ob) {
  object room;
  mapping exits;
  string *dirs;

  message_vision(CYN "\n$n站起身来，冷冷的道：“你种种花言巧语，在我跟前全然无用。你嵩山派这等行径，不但乘人之危，简直是落井下石。”\n" NOR, me, ob);
  message_vision(CYN "\n$n连连摇手，喝道：“你再说下去，没的污了我耳朵。”\n" NOR, me, ob);

  room = environment(this_object());
  exits = room->query("exits");
  dirs = keys(exits);
  ob->command("go " + dirs[random(sizeof(dirs))]);
  me->start_busy(2);
  return 1;
}

int do_arrest(string arg) {
  object me = this_player(), head, victim;

  if (!me->query("songshan/job"))
    return notify_fail("什么？\n");

  if (!arg)
    return notify_fail("你要抓谁？\n");

  if (environment(me)->query("no_fight"))
    return notify_fail("这里不准战斗。\n");

  if (!objectp(head = me->query_temp("armor/head")) || head->query("id") != "mian zhao")
    return notify_fail("你不戴上面具怎么能冒充魔教的人来抓人？\n");

  victim = present(arg, environment(me));

  if (!victim)
    return notify_fail("这里并无此人！\n");

  if (victim == me)
    return notify_fail("何必多此一举？\n");

  if (userp(victim))
    return notify_fail("你不能抓玩家。\n");

  if (!living(victim))
    return notify_fail("这不是活物！\n");

  if (victim->query("player_id") != me->query("id"))
    return notify_fail("左盟主派你来抓的不是此人。\n");

  if (victim->query("player_id") == me->query("id") && !victim->query("discussed"))
    return notify_fail("还是先探探她口风，商讨一下并派之事吧。\n");

  if (!me->query_temp("job_done") && victim->query("player_id") != me->query("id"))
    return notify_fail("在没抓到左盟主要的人前还是别节外生枝的好。\n");

  if (me->query("combat_exp") > victim->query("combat_exp"))
    return notify_fail("抓她回去并不能讨好左盟主。\n");

  message_vision(HIW "$N叫道：$n，今日送你上西方极乐世界，得证正果，不须多谢我啦。\n" NOR, me, victim);
  message_vision(HIW "$N叫道：$n，可怨不得我日月神教心狠手辣，只好怪自己顽固，累得许多年轻弟子枉自送了性命，实在可惜。哈哈，哈哈！\n" NOR, me, victim);

  victim->set_temp("arrestee", 1);
  me->set_temp("marks/arrestee", victim->query("name"));

  victim->kill_ob(me);
  me->kill_ob(victim);
  call_out("dropmask", 1, me, victim);
  return 1;
}

int dropmask(object me, object victim) {
  message_vision(HIC "\n$n执剑在手，提一口气，长声叫道：“大胆魔教贼子，竟敢向恒山派为难。”青光闪动，一柄长剑向$N疾刺而至。\n" NOR, me, victim);
  message_vision(HIR "这一剑剑招精奇，势道凌厉，实是第一流好手的剑法。$N躲闪不急，脸上的面罩以被剑锋带到！\n" NOR, me, victim);
  message_vision("“啪”的一声，$N脸上的面罩被剑锋所带，掉在地上！\n" NOR, me, victim);

  //unwear 面罩
  do_remove("mask");
  unequip();

  victim->remove_all_killer();
  me->remove_all_killer();
  victim->start_busy(2);
  me->start_busy(2);

  call_out("say1", 2, me, victim);
  return 1;
}

int say1(object me, object victim) {
  message_vision(CYN "\n$n惊讶地「啊！」了一声。\n" NOR, me, victim);
  message_vision(
    CYN "$n说道：阿弥陀佛，善哉善哉！" + me->query("name") + "师兄，我恒山派和贵派无怨无仇，何以如此苦苦相逼？\n" NOR,
    me,
    victim
  );
  message_vision(CYN "$n说道：嵩山派是五岳剑派之首，和恒山派同气连枝，何以忽施偷袭！\n" NOR, me, victim);

  victim->remove_all_killer();
  me->remove_all_killer();
  victim->start_busy(2);
  me->start_busy(2);

  call_out("say2", 1, me, victim);
  return 1;
}

int say2(object me, object victim) {
  message_vision(
    CYN "\n$N说道：事已如此，也不必隐瞒你。左掌门命我赴浙闽干事，为的就是要劝说你们恒山派，可惜你冥顽不灵，我也只好如此了。\n" NOR,
    me,
    victim
  );
  message_vision(CYN "$n说道：贼子野心，贪得无厌……$N……你好生恶毒……\n" NOR, me, victim);

  victim->set("eff_qi", victim->query("max_qi"));
  victim->set("qi", victim->query("max_qi"));
  victim->set("eff_jing", victim->query("max_jing"));
  victim->set("jing", victim->query("max_jing"));
  victim->set("jingli", victim->query("max_jingli"));
  victim->set("neili", victim->query("max_neili"));
  victim->remove_all_killer();
  me->remove_all_killer();
  victim->start_busy(1);
  me->start_busy(1);

  victim->kill_ob(me);
  me->fight_ob(victim);
  return 1;
}
