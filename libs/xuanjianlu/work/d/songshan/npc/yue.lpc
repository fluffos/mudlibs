// yao.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create() {
  set_name("乐厚", ({ "yue hou", "hou", "yue" }));
  set("nickname", "大阴阳手");
  set("long", "这人矮矮胖胖，面皮黄肿，两只手掌肥肥的又小又厚。\n");
  set("gender", "男性");
  set("class", "swordsman");
  set("age", 50);
  set("attitude", "peaceful");
  set("str", 25);
  set("con", 20);
  set("dex", 20);
  set("int", 20);

  set("neili", 2600);
  set("max_neili", 2600);
  set("jiali", 30);
  set("max_qi", 2400);
  set("max_jing", 1200);
  set("combat_exp", 800000);
  set("shen_type", -1);

  set_skill("strike", 130);
  set_skill("sword", 110);
  set_skill("force", 110);
  set_skill("parry", 110);
  set_skill("dodge", 110);
  set_skill("songyang-qigong", 110);
  set_skill("songyang-zhang", 130);
  set_skill("songshan-jian", 110);
  set_skill("lingxu-bu", 110);

  map_skill("force", "songyang-qigong");
  map_skill("strike", "songyang-zhang");
  map_skill("sword", "songshan-jian");
  map_skill("parry", "songshan-jian");
  map_skill("dodge", "lingxu-bu");
  prepare_skill("strike", "songyang-zhang");

  create_family("嵩山派", 13, "弟子");
  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/armor/cloth")->wear();
}
