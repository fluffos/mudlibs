// ding.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create() {
  set_name("丁勉", ({ "ding mian", "ding", "mian" }));
  set("nickname", "托塔手");
  set("long", "他是嵩山派掌门人的二师弟托塔手丁勉。\n");
  set("gender", "男性");
  set("class", "swordsman");
  set("age", 45);
  set("attitude", "peaceful");
  set("str", 25);
  set("con", 20);
  set("dex", 20);
  set("int", 20);

  set("neili", 2600);
  set("max_neili", 2600);
  set("jiali", 30);
  set("max_qi", 2400);
  set("max_jing", 1200);
  set("combat_exp", 1200000);
  set("shen_type", -1);

  set_skill("strike", 130);
  set_skill("sword", 130);
  set_skill("force", 130);
  set_skill("parry", 130);
  set_skill("dodge", 130);
  set_skill("songyang-qigong", 130);
  set_skill("songyang-zhang", 130);
  set_skill("songshan-jian", 130);
  set_skill("lingxu-bu", 130);

  map_skill("force", "songyang-qigong");
  map_skill("strike", "songyang-zhang");
  map_skill("sword", "songshan-jian");
  map_skill("parry", "songshan-jian");
  map_skill("dodge", "lingxu-bu");
  prepare_skill("strike", "songyang-zhang");

  create_family("嵩山派", 13, "弟子");
  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/armor/cloth")->wear();
}
