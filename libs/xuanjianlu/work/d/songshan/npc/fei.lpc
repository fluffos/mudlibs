// fei.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("费彬", ({ "fei bing", "bing", "fei" }) );
        set("nickname", "大嵩阳手");
		set("long", "此人是嵩山派掌门左冷禅的第四师弟费彬、一套大嵩阳手武林中赫赫有名。\n");
        set("gender", "男性");
        set("class", "swordsman");
        set("age", 45);
        set("attitude", "peaceful");
        set("str", 25);
        set("con", 20);
        set("dex", 20);
        set("int", 20);

        set("neili", 2600);
        set("max_neili", 2600);
        set("jiali", 30);
        set("max_qi",2400);
        set("max_jing",1200);
        set("combat_exp", 950000);
        set("shen_type", -1);

        set_skill("strike", 120);
        set_skill("sword", 110);
        set_skill("force", 110);
        set_skill("parry", 110);
        set_skill("dodge", 110);
        set_skill("songyang-qigong", 110);
        set_skill("songyang-zhang", 120);
        set_skill("songshan-jian", 110);
        set_skill("lingxu-bu", 110);

        map_skill("force", "songyang-qigong");
		map_skill("strike", "songyang-zhang");
        map_skill("sword", "songshan-jian");
        map_skill("parry", "songshan-jian");
        map_skill("dodge", "lingxu-bu");
        prepare_skill("strike", "songyang-zhang");

        create_family("嵩山派", 13, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/armor/cloth")->wear();
}

