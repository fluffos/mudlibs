// gao.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create()
{
        set_name("高克新", ({ "gao kexin", "kexin", "gao" }) );
        set("nickname", "锦毛狮");
        set("gender", "男性");
        set("class", "swordsman");
        set("age", 35);
        set("attitude", "peaceful");
        set("str", 20);
        set("con", 20);
        set("dex", 20);
        set("int", 20);

        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 30);
        set("max_qi",2000);
        set("max_jing",1200);
        set("combat_exp", 500000);
        set("shen_type", -1);

        set_skill("strike", 80);
        set_skill("sword", 80);
        set_skill("force", 80);
        set_skill("parry", 80);
        set_skill("dodge", 80);
        set_skill("songyang-qigong", 80);
        set_skill("songyang-zhang", 80);
        set_skill("songshan-jian", 80);
        set_skill("lingxu-bu", 80);

        map_skill("force", "songyang-qigong");
		map_skill("strike", "songyang-zhang");
        map_skill("sword", "songshan-jian");
        map_skill("parry", "songshan-jian");
        map_skill("dodge", "lingxu-bu");
        prepare_skill("strike", "songyang-zhang");

        create_family("嵩山派", 13, "弟子");
        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/armor/cloth")->wear();
}

