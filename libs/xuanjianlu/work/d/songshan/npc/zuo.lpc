// zuo.c  左冷禅
// By box 2004.2.2

inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
#include "/d/hengshan/npc/roomdb.h"
#include "/d/hengshan/npc/npc_setup.lpc"
nosave string *chnnumber=({"一","二","三","四","五","六","七","八","九","十","零"});
nosave int mancount=10;
int make_npc(int i);
int setnpcstat(object npcob);
int giveexp();
int do_fangqi();
int ask_job();
int auto_perform();
void destnpc(object player);

void create()
{
        set_name("左冷禅", ({ "zuo lengchan", "zuo" }));
        set("long",
"这便是当代武学大宗师左冷禅。\n"
"他身穿杏黄色布袍，其时夕阳即将下山，日光斜照，映射其身，\n"
"显得金光灿烂，大增堂皇气象。\n");
        set("gender", "男性");
        set("age", 50);
        set("attitude", "peaceful");
        set("shen_type", -1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);

        set("max_qi", 3000);
        set("max_jing", 1800);
        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 100);
        set("combat_exp", 1400000);
        set("score", 5000);

	set("no_get", 1);
        set_temp("apply/armor", 100);

        set_skill("strike", 160);
        set_skill("sword", 160);
        set_skill("force", 160);
        set_skill("parry", 160);
        set_skill("dodge", 160);
        set_skill("songyang-qigong", 160);
        set_skill("songyang-zhang", 160);
        set_skill("songshan-jian", 160);
        set_skill("lingxu-bu", 160);

        map_skill("force", "songyang-qigong");
	map_skill("strike", "songyang-zhang");
        map_skill("sword", "songshan-jian");
        map_skill("parry", "songshan-jian");
        map_skill("dodge", "lingxu-bu");

        prepare_skill("strike", "songyang-zhang");

        create_family("嵩山派", 13, "掌门");

		set("chat_chance_combat", 50);
		set("chat_msg_combat", ({
				(: auto_perform :),
		}) );
		set("inquiry", ([
			"job" : (: ask_job :),
			"join" : (: ask_job :),
			"work" : (: ask_job :),
			"投山" : (: ask_job :),
			"工作" : (: ask_job :),
		]));
        setup();
	if (clonep())
		carry_object("/clone/weapon/guanri-jian",
					"/clone/weapon/qinggang-jian")->wield();
        carry_object("/clone/misc/cloth")->wear();
}
void init()
{
        ::init();
        add_action("do_fangqi","fangqi");
        add_action("do_fangqi","放弃");
}

int ask_job()
{
        object me,ob,npcob,*inv,mask;
        int i=0,j=0; 
        me = this_object();
        ob = this_player();
	ob->delete("hengshan");

        inv=all_inventory(environment(ob));
        for (i=0;i<sizeof(inv);i++)
        {
                if (inv[i]->query("player_id") == ob->query("id") && living(inv[i]))
                        j++;
        }
                                
        if (j>0 && ob->query("songshan/job") && ob->query_temp("job_done"))
        {
        	if(ob->query_temp("job_done")==j) 
        		ob->set("songshan/job",4);
        	else
        		ob->set("songshan/job",3);
        }		
        	
        if (ob->query("songshan/job") && !ob->query_temp("job_done") && ob->query("jobendtime") && ob->query("jobendtime")<time() ) 
                ob->set("songshan/job",2);
       
        if (ob->query("combat_exp")<200000 || ob->query("max_neili")<1000 )
        {
		command ("say 凭你这样的武功怎能制住恒山那群尼姑，你枉自送命也就算了，不要来坏我大事！");
                return 1;
	}
	
        switch(ob->query("family/family_name")) 
        {
                case "少林派":
                case "武当派":
                case "峨嵋派":
                case "华山派":
		case "全真教":
		case "大理段家":
			command ("say 我辈学武之人，最讲究的是正邪是非之辨，我嵩山派不敢让您屈尊。");
			return 1;
        }
        
        if (ob->query("shen") > 0 && !wizardp(ob) && (ob->query("family/family_name")=="星宿派" || 
        ob->query("family/family_name")=="雪山派" ||
        ob->query("family/family_name")=="神龙教")) 
        {       
		command ("say 我辈学武之人，最讲究的是正邪是非之辨，" + RANK_D->query_rude(ob) + "居然和妖魔勾搭成奸，实已犯了武林的大忌。");
		return 1;
	}
	
	if (mancount < 1 && !ob->query("songshan/job") && me->query("mancount") < 1)
	{ 
		command ("say 最近我嵩山派多有江湖好汉来投山，你过段时间再来吧。");
		return 1;
	}
		
        if (!ob->query("songshan/job")) 
        {
		ob->set("jobendtime",time()+600);
		ob->set("songshan/job",1);
		mancount--;
		command ("say 五岳剑派结盟之后，同气连枝，原是不分彼此。只是近年来大家见面的时候少，好多事情又没联手共为，致令魔教坐大，气焰日甚。");
		command ("say 合则势强，分则力弱。我五岳剑派若能合而为一，魔教固非咱们敌手，便是少林、武当这些享誉已久的名门大派，声势也远远不及咱们了。");
		i=4+random(1);
		ob->set("songshan/num",i);
		command ("say 你既有投嵩山之心，那就替我去一趟福建劝说恒山派的"+chnnumber[i-1]+"位师太吧。");
		command ("say 倘若她们冥顽不灵便一并抓回，其他事宜再另行决议。");
		if (!objectp(mask=present("mian zhao", ob)))
		{
			mask=new("/d/songshan/obj/mianzhao");
			mask->move(ob);
		}
		
		//开始设定npc
		make_npc(i);
		return 1;
        }
        
        switch(ob ->query("songshan/job")) 
        {
                case 0:
                case 1:
			command("say 叫你去福建你怎么还在这里闲逛？");
			command("say 要是干不了就赶快放弃(fangqi)了，给我滚的远远的！");
                        break;
                case 2:
                        ob->delete("jobendtime");
                        ob->delete("songshan");
                        command("hmm "+ob->query("id"));
			mancount++;
			command("say 去了这么久才回来，那些恒山派的女尼早已脱身了！");
                        break;
                case 3:
                        tell_object(ob,"你感到实战经验增加了！\n");
			mancount++;
			call_out("giveexp", 0, me, ob);
                        command("say " + RANK_D->query_respect(ob) + "马道成功，果然身手了得！");
			command("thumb "+ob->query("id"));
                        break;
                case 4:
                        tell_object(ob,"你感到实战经验增加了！\n");
			mancount++;
 			call_out("giveexp", 0, me, ob);
                        command("thumb "+ob->query("id"));
                        command("say " + RANK_D->query_respect(ob) + "马道成功，果然身手了得！抓回这些恒山女尼，看来定闲师太是大势已去！");
                        break;
        }
	return 1;
}

int make_npc(int i)
{
	int kroom,knpc,j,ci=0;
	string where, npcid;
	object fnpcob,npcob,ob;
	ob=this_player();

	while(j<i)
	{
		kroom=random(sizeof(room));
		knpc=random(sizeof(npc));
                
		//防止同一player出现同名 hengshan npc
		npcid=load_object("/d/hengshan/npc/"+npc[knpc])->query("id"); 
		if(ob->query("songshan/npc1/id")==npcid ||
		   ob->query("songshan/npc2/id")==npcid ||
		   ob->query("songshan/npc3/id")==npcid ||
		   ob->query("songshan/npc0/id")==npcid)
		{
			continue;
		}
		else
		{  
			fnpcob=new("/d/hengshan/npc/"+npc[knpc]);
			fnpcob->set("combat_exp",this_player()->query("combat_exp")*3/2);
			fnpcob->set("songshan",1);
			fnpcob->set("npcid",j);
			
			setnpcstat(fnpcob);
					
			if(wizardp(ob) && ob->query("id")=="box")
				where="/d/songshan/chanyuan";
			else		
				where="/d/quanzhou/"+room[kroom];
				
			fnpcob->move(where);
					
			//记录这个玩家的所有要抓的人的信息
			ob->set("songshan/npc" + j+"/id",fnpcob->query("id"));
			ob->set("songshan/npc" + j+"/where",where);
			ob->set_temp("hsnpc",fnpcob->query("id"));	
			if(wizardp(ob) && ob->query("id")=="box") 
			{
				write("Load room:"+room[kroom]+"   ");
				write("Npc name:"+npc[knpc]+"\n");
			}
			j++;
		}
	}
	return 1;
}
int setnpcstat(object npcob)
{
        object ob;
        int player_exp;
        ob=this_player();
        player_exp=ob->query("combat_exp");
	set_skills("hengshan",player_exp*3/2,100,npcob);        
	set_hp(ob,npcob,100);
        npcob->set("player_id",ob->query("id"));
}

int do_fangqi()
{
        object ob=this_player(),*inv;
        int j,i;

        if (!ob->query("songshan/job"))
        {
		return 0;
        }
        message_vision("$N对$n说道：“连几个柔弱的尼姑都搞不定，快快给我滚了下去！”\n",this_object(),ob);
	destnpc(ob);
        ob->delete("jobendtime");
        ob->delete("songshan");
        ob->delete("hsnpc");
        return 1;
}

void destnpc(object player)
{
	object room, npc;
	int j;
        for(j=0;j<player->query("songshan/num");j++)
        {
        	if(player->query("songshan/npc"+j+"/zhua")==0)
        	{
        		//消除没有抓住的npc
			room=load_object(player->query("songshan/npc"+j+"/where"));
			if (objectp(room))
			{
				npc=present(player->query("songshan/npc"+j+"/id"), room);
				if(objectp(npc))
					npc->dest();
			}
        	}
        }	
}

int giveexp()
{
        object ob=this_player(),*inv;
        int maxexp=1000,givepotential,j,maxman;
        inv=all_inventory(environment(ob));
        for ( j=0;j<sizeof(inv);j++) 
        {
                if (inv[j]->query("forceleader") == ob)
                {
                        message_vision(CYN"$N对着$n说道：“天网恢恢，疏而不漏。多行不义，必遭恶报。敝派虽然都是孱弱女子，却也决计不屈于强暴。”\n"NOR,inv[j],ob);
                        message_vision("从外面近来两名嵩山弟子把$N压了下去。\n",inv[j],ob);
                        destruct(inv[j]);
                }
        }
        destnpc(ob);
        maxexp=maxexp+random(50+(ob->query("jobendtime")-time())/10);
        givepotential=ob->query("max_potential")/3+random(ob->query("max_potential")/3);
        if (ob->query_temp("job_done") > 1) 
        {
                maxexp= maxexp + 400*(ob->query_temp("job_done")-1);
                givepotential= givepotential + 50*(ob->query_temp("job_done")-1);
        }
        ob->add("combat_exp", maxexp);
        ob->add("potential", givepotential);
        if ( ob->query("potential") > ob->query("max_potential") )
                ob->set("potential", ob->query("max_potential") );
	ob->delete_temp("job_done");
        ob->delete("jobendtime");
        ob->delete("songshan");	
        return 1;
}

int accept_fight(object ob)
{
        object me = this_object();

        int my_max_qi = (int)me->query("max_qi");

        if ( (int)me->query("qi")*100 / my_max_qi <= 80 ) {
                return 0;
        }

        command("sneer");
        message_vision("$N喝道：" + RANK_D->query_rude(ob) + "！你也配和我交手？\n", me);
        return 1;
}

int accept_kill(object ob)
{
        command("haha");
        command("say 天底下居然还有这种傻瓜？！");
        return 1;
}
int auto_perform()
{
	object me=this_object();
	object weapon=me->query_temp("weapon");
	object opp=me->select_opponent();

	if ( !me->is_fighting() ) 
	{
                if ( me->query("eff_qi") < me->query("max_qi") )
                        exert_function("heal");
                me->set("jiali", 50);
                return 1;
        }

        if ( objectp(weapon) ) 
        {
                if ( weapon->query("skill_type") == "sword")
                        return perform_action("sword.xuli");
        }
}