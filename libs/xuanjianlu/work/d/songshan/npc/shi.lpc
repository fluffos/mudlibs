// shi.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
void create() {
  set_name("史登达", ({ "shi dengda", "dengda", "shi" }));
  set("nickname", "千丈松");
  set("gender", "男性");
  set("class", "swordsman");
  set("age", 25);
  set("attitude", "peaceful");
  set("str", 20);
  set("con", 20);
  set("dex", 20);
  set("int", 20);

  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 30);
  set("max_qi", 1000);
  set("max_jing", 800);
  set("combat_exp", 200000);
  set("shen_type", -1);

  set_skill("strike", 60);
  set_skill("sword", 60);
  set_skill("force", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set_skill("songyang-qigong", 60);
  set_skill("songyang-zhang", 60);
  set_skill("songshan-jian", 60);
  set_skill("lingxu-bu", 60);

  map_skill("force", "songyang-qigong");
  map_skill("strike", "songyang-zhang");
  map_skill("sword", "songshan-jian");
  map_skill("parry", "songshan-jian");
  map_skill("dodge", "lingxu-bu");
  prepare_skill("strike", "songyang-zhang");

  create_family("嵩山派", 14, "弟子");
  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/armor/cloth")->wear();
}
