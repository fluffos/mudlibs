//Created by oky 2001/11/14

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", YEL "登记室" NOR);
  set("long",
    "这里是玄剑录的登记室，房子正墙上挂着一块木匾「公正严明」。一旁放着
一张长长的桌子，桌子上放了很多文具，里面有一位文员，他静静的在那写着什
么。墙的左侧挂着一块告示(gaoshi)。\n"
  );

  set("no_fight", "1");
  set("no_steal", "1");
  set("no_sleep_room", "1");

  set("item_desc", ([
    "gaoshi":

    "┌──────────────" + HIG "登记须知" NOR + "─────────────────┐\n"
    "│ 一：登记室里的内容用（check)查看，登记可直接用指令（register)        │ \n"
    "│ 二：本登记室提供密码，详情请向登记员查询(ask ying lian about 密码)   │ \n"
    "│ 三：请用(help register)来查询登记含义和资料。                        │ \n"
    "└───────────────────────────────────┘ \n\n"
  ]));

  set("regroom", "1");  //这样就只能在这个房间里register个人信息了。


  set("objects", ([
    //                __DIR__"" : 1,
  ]));

  set("exits", ([
    "east": __DIR__ "wumiao",
  ]));

  set("cost", 0);
  setup();
}

void init() {
  add_action("do_exercise", "exercise");
  add_action("do_exercise", "dazuo");
  add_action("do_respirate", "respirate");
  add_action("do_respirate", "tuna");
  add_action("do_practice", "practice");
  add_action("do_practice", "lian");
  add_action("do_study", "study");
  add_action("do_study", "du");
  add_action("do_feed", "feed");
}

int do_exercise(string arg) {
  object me = this_player();
  tell_object(me, "呆在这里，你只觉得心慌意乱，全身真气再也无法凝聚起来！\n");
  return 1;
}

int do_respirate(string arg) {
  object me = this_player();
  tell_object(me, "呆在这里，你只觉得心慌意乱，全身精气再也无法凝聚起来！\n");
  return 1;
}

int do_practice(string arg) {
  object me = this_player();
  tell_object(me, "你想站起来，却觉得浑身发软，全身提不起一丝劲儿来练功！\n");
  return 1;
}

int do_study(string arg) {
  object me = this_player();
  tell_object(me, "你只觉得脑袋里发晕，书本上一个个字都飞来飞去，再也读不进去！\n");
  return 1;
}

int do_feed(string arg) {
  object me = this_player();
  tell_object(me, "你发现所有的动物到了这里都不吃东西！\n");
  return 1;
}

int valid_leave(object me, string dir) {
  object *inv;
  int i;
  inv = all_inventory(me);
  if (dir == "east") {
    // can not got to any where if they take players
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->is_character())
        return notify_fail("你不能带着其他玩家离开这里。\n");
    }
  }
  me->set_temp("mark/登记室", 0);
  return ::valid_leave(me, dir);
}
