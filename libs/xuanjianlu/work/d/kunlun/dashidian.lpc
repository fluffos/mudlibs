//Cracked by box
// Room: /d/kunlun/dashidian.c

#include <ansi.h>

inherit ROOM;

int serve();

void create() {
  set("short", "大食殿");
  set("long", @LONG
圣火总坛，弟子众多，故食饮之处宽大，可容千人共餐，因名为大食
殿。明教历代相传，不茹荤酒，后因为驱除鞑子，废除了这条教规。因此
大殿中常常可闻喝酒猜拳之声。
这里专为黑木崖上的兄弟提供伙食(serve)。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "qiankun",

  ]));
  set("no_clean_up", 0);
  set("cost", 1);

  setup();
}

void init() {
  object ob = this_player();

  if (userp(ob) && !wizardp(ob) && ob->query("family/family_name") != "明教") {
    message_vision(HIR "厨子喝道：“$N你不是我明教中人，怎么闯到这里来了？出去！\n" NOR, ob);
    call_out("kickout", 1, ob);
  }
  add_action("do_serve", "serve");
}

int kickout(object ob) {
  if (!present(ob, find_object("/d/kunlun/dashidian.lpc"))) {
    return 1;
  }

  message_vision(HIR "厨子把$N赶了出去。\n" NOR, ob);
  ob->move("/d/kunlun/qiankun");
  message("vision", HIG "只见，" + ob->query("name") + "满脸羞愧地从里面走了出来。\n" NOR, environment(ob), ob);
  remove_call_out("kickout");
  return 1;
}

int do_serve() {
  object ob, me;
  me = this_player();

  if (me->query("family/family_name") != "明教") {
    return notify_fail(HIC "不是我教中人，你还有脸来要东西吃！你给我滚蛋吧你\n" NOR);
  }

  message_vision("$N向厨子要些食物吃喝。\n", me);

  if (!present("taihu yinyu", environment(me))
    && !present("shuijing yaorou", environment(me))
    && !present("santao ya", environment(me))
    && !present("taihu yinyu", me)
    && !present("shuijing yaorou", me)
    && !present("santao ya", me)) {
    switch (random(3)) {
      case 0:
        ob = new("/d/city/obj/santaoya");
        break;
      case 1:
        ob = new("/d/city/obj/thfish");
        break;
      case 2:
        ob = new("/d/city/obj/yrou");
        break;
    }
    ob->move(environment(me));
    message_vision("厨子端出" + ob->name() + "给$N。“您慢慢吃，不够还有。”\n", me);
  } else message_vision("厨子对$N说道：兄弟不够意思吧！还没吃完就再要？。\n", me);

  if (!present("biluochun", environment(me))
    && !present("hong ling", environment(me))
    && !present("bai ling", environment(me))
    && !present("biluochun", me)
    && !present("hong ling", me)
    && !present("bai ling", me)) {
    switch (random(3)) {
      case 0:
        ob = new("/d/murong/obj/biluochun");
        break;
      case 1:
        ob = new("/d/murong/obj/ling1");
        break;
      case 2:
        ob = new("/d/murong/obj/ling2");
        break;
    }
    ob->move(environment(me));
    message_vision("厨子端出" + ob->name() + "给$N。“您慢慢喝，不够还有。”\n", me);
  } else message_vision("厨子对$N说道：你还没喝完呢，喝完再说吧。\n", me);
  return 1;
}

int valid_leave(object me, string dir) {
  if (present("taihu yinyu", me)
    || present("shuijing yaorou", me)
    || present("santao ya", me)
    || present("biluochun", me)
    || present("hong ling", me)
    || present("bai ling", me))
    return notify_fail("厨子拦着你说：“您还是吃完再走吧。”\n");
  return ::valid_leave(me, dir);
}
