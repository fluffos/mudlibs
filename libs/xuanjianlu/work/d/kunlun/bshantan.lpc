//Cracked by box
//room: bshantan.c 碧水寒潭

#include <ansi.h>
inherit ROOM;
int do_jump();
void create()
{
        set("short", "碧水寒潭");
        set("long", @LONG
此处只见一个深潭，潭水呈碧绿色。因地处山阴，常年北风刮过，只
到潭边一站，已然寒气逼人。表面潭水早已结成厚冰，只有几个人工凿去
的缺口，望下去碧沉沉地，深不见底。
LONG );

        set("exits", ([
		"east" : __DIR__"shanquan",
        ]));
	set("cost", 3);
	set("outdoors", "mingjiao");
        set("resource/water", 1);
        setup();
}

void init()
{
	add_action("do_jump", "jump");
}

int do_jump()
{
	object me = this_player();

	if ( me->is_busy() || me->query_temp("pending/exercising"))
		return notify_fail("你现在正忙着呢。\n");
		
        if( present("pishui zhu", me) && me->query_temp("zhu_han") ) 
	{
		message_vision(HIG"$N取出辟水灵珠，含在嘴里，轻轻一纵，跃入寒潭之中。\n"NOR, me);
	        me->move("/d/kunlun/bshantan1");
        	message("vision", HIG"只听水面哗啦一声响，似乎有人也潜下水来。\n"NOR,
                environment(me), ({me}) );
	}
	else
	{
		tell_object(me, HIG"你一跳入水中，只觉蚀骨寒气从全身无数个毛孔侵入，四肢几乎完全麻木，\n"
				"你拚着丹田中残余的一股内力，攀住潭边的岩石，急急忙忙地爬了出来！\n"NOR);
                message("vision", HIG + "" + me->name() + "下半身一浸入水中，立刻大叫一声，落汤鸡似地跳了出来！\n"NOR,
               		environment(me), ({me}) );
	}
	return 1;
}