//Cracked by box
// lian.c 铁链

#include <weapon.h>
inherit WHIP;

void create()
{
        set_name("铁链", ({ "lian", "tielian","chain" }));
        set_weight(300);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("long", "这是不过筷子粗细的铁链。\n");
                set("value", 50);
                set("material", "iron");
                set("wield_msg", "$N从腰间解下一条$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n缠回腰上。\n");
        }
        init_whip(5);
        setup();
}
