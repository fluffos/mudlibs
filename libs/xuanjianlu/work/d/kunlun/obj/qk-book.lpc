//Cracked by box

#include <ansi.h>

inherit ITEM;
inherit F_UNIQUE;

int do_canwu(string arg);
int do_du(string arg);
int help();

void create() {
  set_name(HIB "乾坤大挪移" NOR, ({ "qiankun nuoyi", "book" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "部");
    set("long", YEL "一张破旧的羊皮，羊皮上面用篆文书着《乾坤大挪移》心法，看起来好像是内功心法。\n" NOR);
    set("material", "paper");
    set("skill", ([
      "name": "qiankun-danuoyi",        // name of the skill
      "exp_required": 2000000,      // minimum combat experience required
      "jingli_cost": 200,     // jing cost every time study this
      "difficulty": 100,     // the base int to learn this skill
      "max_skill": 800      // the maximum level you can learn
    ]));
    set("no_drop", "这样东西不能离开你。\n");
    set("no_get", "这样东西拿不起来。\n");
    set("no_steal", 1);
    set("no_sell", 1);
    ::create();

  }
}

void init() {
  add_action("do_du", "du");
  add_action("do_canwu", "canwu");
  add_action("do_canwu", "study");
}

int do_du(string arg) {
  return help();
}

int do_canwu(string arg) {
  object me = this_player();
  object where = environment(me);
  string skillarg;
  int jing_cost, times, jingli_cost;
  int i = me->query_skill("qiankun-danuoyi", 1);

  if (!arg)
    return help();

  skillarg = arg;

  if (sscanf(arg, "%s %d", arg, times) != 2)
    arg = skillarg;

  if (!times || times == 0)
    times = 1;

  if (!(arg == "qiankun nuoyi" || arg == "miji" || arg == "qiankun"
    || arg == "book"))
    return 0;

  skillarg = query("skill/name");

  if (where->query("pigging")) {
    write("你还是专心拱猪吧！\n");
    return 1;
  }

  if (base_name(environment(me)) == "/d/bwdh/sjsz/")
    return notify_fail("你不可以在试剑山庄里参悟。\n");

  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }

  if (!id("qiankun nuoyi")) {
    write("你要读什么？\n");
    return 1;
  }

  if (!me->query_temp("got_qkbook")) {
    write("你搅尽脑汁也看不明白这《乾坤大挪移心法》。\n");
    return 1;
  }


  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学点文化(literate)吧。\n");
    return 1;
  }


  if (me->query("gender") == "无性") {
    write("嘿嘿，您学不了乾坤大挪移。\n");
    return 1;
  }

  if ((int)me->query_skill("force", 1) < 30
    || (int)me->query_skill("force", 1) < (i - 30)) {
    write("你的基本内功火候不足，无法学习乾坤大挪移。\n");
    return 1;
  }

  if ((int)me->query_skill("literate", 1) < (i - 30)) {
    write("你的读书写字水平不够，没法领会《乾坤大挪移》了。\n");
    return 1;
  }

  if (me->query("jing") < 600) {
    write("你现在过于疲倦，无法专心下来研读《乾坤大挪移》。\n");
    return 1;
  }

  if ((int)me->query("combat_exp") < query("skill/exp_required")
    || (int)me->query("combat_exp") < (int)i * i * i / 10) {
    write("你的实战经验不足，乾坤大挪移心法无法再提高了。\n");
    return 1;
  }

  if (me->query_int() < 60) {
    write("你读了半天《乾坤大挪移》，可总也领悟不了那神功精妙所在。\n");
    return 1;
  }

  if (i > query("skill/max_skill")) {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }

  jingli_cost = (i - me->query_skill("literate", 1) / 100 * me->query_int()) * times;
  if (jingli_cost <= query("skill/jingli_cost") + query("skill/difficulty"))
    jingli_cost = query("skill/jingli_cost") + query("skill/difficulty");
  jing_cost = jingli_cost / 2;


  if (me->query("jing") < jing_cost)
    return notify_fail("你现在精神不佳，无法定心领悟那么多次！\n");

  if (me->query("jingli") < jingli_cost)
    return notify_fail("你现在精力不佳，无法定心领悟那么多次！\n");

  if ((int)me->query("potential") <= 1)
    return notify_fail("你的潜能不足，无法参悟九阳神功！\n");

  if ((int)me->query("potential") < 2 * times)
    return notify_fail("你的潜能不够参悟这么多次！\n");

  message("vision", me->name() + "翻开《乾坤大挪移》仔细的参悟了一会儿。\n", environment(me), me);


  if (random(20) == 0) {
    me->add("potential", -2 * (random(times)) - 2);
    me->improve_skill(skillarg, (i + me->query_skill("literate", 1) / 2 + random(i * 2)) * times);
    write("《乾坤大挪移》果然精妙，你只觉脑中豁然开朗，对" + to_chinese(skillarg) + "的领悟又进了一层！\n");
  } else if (random(10) == 0) {
    me->add("potential", -1 * (random(times)) - 1);
    me->improve_skill(
      skillarg,
      (i / 2 + me->query_skill("literate", 1) / 3 + random(i / 10)) * times
    );
    write("你细观《乾坤大挪移》，冥思苦想，对" + to_chinese(skillarg) + "渐渐加深一层体会！\n");
  } else if (random(5) == 0) {
    me->add("potential", -random(times));
    me->improve_skill(
      skillarg,
      (i / 4 + me->query_skill("literate", 1) / 4 + random(i / 2)) * times
    );
    write("你对照《乾坤大挪移》，拿手比划着，似乎对" + to_chinese(skillarg) + "中的几个招数有所体会。\n");
  } else if (random(2) == 0) {
    me->improve_skill(
      skillarg,
      (i / 8 + me->query_skill("literate", 1) / 6 + random(i / 4)) * times
    );
    write("你坐立不安，潜心苦思" + to_chinese(skillarg) + "上的难解之处。\n");
  } else if (random(5) == 0) {
    write("你心中说不出的烦燥，对" + to_chinese(skillarg) + "始终不得一解。\n");
  } else if (random(10) == 0) {
    me->improve_skill(skillarg, -(i / 10 + random(i / 5)) * random(times));
    write("你只觉得体内真气乱窜，" + to_chinese(skillarg) + "中的招式象走马灯一般在面前显现！\n");
  } else if (random(20) == 0) {
    me->improve_skill(skillarg, -(i / 6 + random(i / 3)) * random(times));
    write("你的大脑中一片空白。对" + to_chinese(skillarg) + "是越想越糊涂。\n");
  } else {
    write("你坐立不安，潜心苦思" + to_chinese(skillarg) + "上的难解之处。\n");
  }

  me->receive_damage("jing", jing_cost);
  me->receive_damage("jingli", jingli_cost);
  write("你研读《乾坤大挪移》有所进步。\n");
  return 1;
}


int help() {
  write("                   《乾坤大挪移》\n\n"
    "    羊皮的第一行写的是：“乾坤大挪移”。\n"
    "    羊皮的尽头题着“阳顶天笔录”。\n\n"
    "学习乾坤大挪移注意事项：\n\n"

    "一. 乾坤大挪移威力惊人。\n\n"
    "三十级以后可以招架对手对自己的伤害。\n"
    "五十级以后可以躲闪对手对自己的伤害。\n"
    "一百级以后可以逃逸对手对自己的伤害。\n"
    "二百级以后可以取消对手对自己的伤害。\n"
    "三百级以后可以把伤害反弹给对手。\n"
    "二. 这个是一个quest需要向张三丰、少林方丈、灭绝师太打听有关九阳神功的事情。\n"
    "三. 《乾坤大挪移》获取方法是你到张无忌那里要，或找到潇湘子用特殊命令取得。\n\n"
    "四. 乾坤大挪移无师可拜，也不能通过自己锻炼来长进，只有研习《乾坤大挪移》\n"
    "    才能提高。\n\n"
    "五. 乾坤大挪移对基本功的要求很苛刻，无法超过基本内功三十级以上，如果读\n"
    "    书写字低于乾坤大挪移三十级，将无法读懂《乾坤大挪移》。\n\n"
    "         早日精通乾坤大挪移，你必可成为武林第一高手！\n");
  return 1;
}
