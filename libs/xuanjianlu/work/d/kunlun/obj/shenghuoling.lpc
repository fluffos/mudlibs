//Cracked by box
// shenghuoling.c

#include <weapon.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit BLADE;
int help();
void create() {
  set_name(HIR "圣火令" NOR, ({ "shenghuo ling", "ling", "shenghuo" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一柄血红色的令牌，不知道有什么用。\n");
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声将怀中的$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n揣入怀中。\n");
    set("no_sell", 1);
    set("rigidity", 4500);
    set("no_steal", 1);
    set("skill", ([
      "name": "shenghuo-ling",        // name of the skill
      "exp_required": 2000000,      // minimum combat experience required
      "jingli_cost": 300,     // jing cost every time study this
      "difficulty": 200,     // the base int to learn this skill
      "max_skill": 800      // the maximum level you can learn
    ]));
  }

  init_blade(200);
  set("no_drop", "这样东西不能离开你。\n");
  set("no_get", "这样东西拿不起来。\n");
  set("no_steal", 1);
  set("no_sell", 1);
  setup();
  ::create();
}

void init() {
  add_action("do_du", "du");
  add_action("do_canwu", "canwu");
  add_action("do_du", "study");
}

int do_du(string arg) {
  return help();
}

int help() {
  write("                   《古波斯武功》\n\n"
    "要(canwu ling)提高圣火令功夫。\n");
  return 1;
}

int do_canwu(string arg) {
  object me = this_player();
  object where = environment(me);
  int jing_cost, times, jingli_cost;
  string skillarg;
  int i;

  if (!arg)
    return help();

  skillarg = arg;

  if (sscanf(arg, "%s %d", arg, times) != 2)
    arg = skillarg;

  if (!times || times == 0)
    times = 1;

  if (!(arg == "ling"))
    return 0;

  skillarg = query("skill/name");
  i = me->query_temp(skillarg, 1);
  if (where->query("pigging")) {
    write("你还是专心拱猪吧！\n");
    return 1;
  }

  if (base_name(environment(me)) == "/d/bwdh/sjsz/")
    return notify_fail("你不可以在试剑山庄里参悟。\n");

  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }

  if (!id("shenghuo ling")) {
    write("你要做什么？\n");
    return 1;
  }

  if (me->query("family/title") != "教主" || me->query("family/generation") != 33 ||
    query("masterid") != me->query("id")) {
    write("你搅尽脑汁也不明白这本圣火令上的秘密。\n");
    return 1;
  }

  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学点文化(literate)吧。\n");
    return 1;
  }


  if (me->query("gender") == "无性") {
    write("嘿嘿，您学不了圣火令上的功夫啦。\n");
    return 1;
  }


  if ((int)me->query_skill("literate", 1) < (i - 30)) {
    write("你的读书写字水平不够，没法领会令上的功夫了。\n");
    return 1;
  }

  if (me->query("jing") < 600) {
    write("你现在过于疲倦，无法专心下来参悟令上的功夫了。\n");
    return 1;
  }

  if ((int)me->query("combat_exp") < query("skill/exp_required")
    || (int)me->query("combat_exp") < (int)i * i * i / 10) {
    write("你的实战经验不足，圣火令武功无法再提高了。\n");
    return 1;
  }

  if (me->query_int() < 60) {
    write("你看着圣火令，可总也领悟不了精妙所在。\n");
    return 1;
  }

  if (i > query("skill/max_skill")) {
    write("你看了一会儿，但是发现上面的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }

  jingli_cost = (i - me->query_skill("literate", 1) / 100 * me->query_int()) * times;
  if (jingli_cost <= query("skill/jingli_cost") + query("skill/difficulty"))
    jingli_cost = query("skill/jingli_cost") + query("skill/difficulty");
  jing_cost = jingli_cost / 2;


  if (me->query("jing") < jing_cost)
    return notify_fail("你现在精神不佳，无法定心领悟那么多次！\n");

  if (me->query("jingli") < jingli_cost)
    return notify_fail("你现在精力不佳，无法定心领悟那么多次！\n");

  if ((int)me->query("potential") <= 1)
    return notify_fail("你的潜能不足，无法参悟九阳神功！\n");

  if ((int)me->query("potential") < 2 * times)
    return notify_fail("你的潜能不够参悟这么多次！\n");

  message("vision", me->name() + "看看圣火令有想了想，对照圣火令上奇怪的图文仔细的参悟了一会儿。\n", environment(me), me);


  if (random(20) == 0) {
    me->add("potential", -2 * (random(times)) - 2);
    me->improve_skill(skillarg, (i + me->query_skill("literate", 1) / 2 + random(i * 2)) * times);
    write("圣火令上的武功果然精妙，你只觉脑中豁然开朗，对" + to_chinese(skillarg) + "的领悟又进了一层！\n");
  } else if (random(10) == 0) {
    me->add("potential", -1 * (random(times)) - 1);
    me->improve_skill(
      skillarg,
      (i / 2 + me->query_skill("literate", 1) / 3 + random(i / 10)) * times
    );
    write("你细观圣火令，冥思苦想，对" + to_chinese(skillarg) + "渐渐加深一层体会！\n");
  } else if (random(5) == 0) {
    me->add("potential", -random(times));
    me->improve_skill(
      skillarg,
      (i / 4 + me->query_skill("literate", 1) / 4 + random(i / 2)) * times
    );
    write("你对照圣火令上的图文，拿手比划着，似乎对" + to_chinese(skillarg) + "中的几个招数有所体会。\n");
  } else if (random(2) == 0) {
    me->improve_skill(
      skillarg,
      (i / 8 + me->query_skill("literate", 1) / 6 + random(i / 4)) * times
    );
    write("你坐立不安，潜心苦思" + to_chinese(skillarg) + "上的难解之处。\n");
  } else if (random(5) == 0) {
    write("你心中说不出的烦燥，对" + to_chinese(skillarg) + "始终不得一解。\n");
  } else if (random(10) == 0) {
    me->improve_skill(skillarg, -(i / 10 + random(i / 5)) * random(times));
    write("你只觉得体内真气乱窜，" + to_chinese(skillarg) + "中的招式象走马灯一般在面前显现！\n");
  } else if (random(20) == 0) {
    me->improve_skill(skillarg, -(i / 6 + random(i / 3)) * random(times));
    write("你的大脑中一片空白。对" + to_chinese(skillarg) + "是越想越糊涂。\n");
  } else {
    write("你坐立不安，潜心苦思" + to_chinese(skillarg) + "上的难解之处。\n");
  }

  me->receive_damage("jing", jing_cost);
  me->receive_damage("jingli", jingli_cost);
  write("你的《古波斯武功》有所进步。\n");
  return 1;
}
