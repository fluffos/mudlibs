//Cracked by box
// /d/kunlun/npc/wushi.c

inherit NPC;
#include <ansi.h>

int reset();
int auto_perform();
string ask_me_heal();
int ask_me_leave();

void create()
{
	set_name("明教武士",({"mingjiao wushi","wushi"}));
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: auto_perform :),
	}) );
	
	
	set("inquiry", ([
		"heal" : (: ask_me_heal :),
		"疗伤" : (: ask_me_heal :),
		"leave": (: ask_me_leave:),
	]));
        create_family("明教",35,"明教武士");
	setup();
	
	
	if( clonep() )
	{
		  //carry_object("/clone/weapon/qinggang-jian")->wield();
		  carry_object("/d/dali/obj/tengjia")->wear();
	}
	
}


void attempt_apprentice(object ob)
{
	command("say 对不起，我是明教的武士！不能收徒弟！\n");
	return;
}

int accept_kill(object obj)
{
	object me = this_object();
	mapping skill_status;
	string *sname;
	int i, max = 200;

	return 1;
}

void init()
{
	::init();
}

int reset()
{
	object me = this_object();
	if( me->query("eff_qi") < me->query("max_qi") )
		exert_function("heal");
	me->set("jiali", 50);
	return 1;
}


string ask_me_heal()
{
	object ob = this_player();
	object me = this_object();

	if( ob->query("id")!=me->query("master"))
	{
		return "哼！你死了关我屁事！滚！！！";
	}

	if( ob->query("eff_qi") < ob->query("max_qi") )
		message_vision(HIG"$N看了看$n，痛快地说道：“没问题！”\n"NOR,me,ob);
	else 
		return "你无伤无痕，开我玩笑？";
	command("halt");
	command("exert lifeheal "+ob->query("id"));
	return "好些了吗？";
}

int ask_me_leave()
{
	object ob = this_player();
                
        if( query("master")!=ob->query("id") && !wizardp(ob) )        
        {
        	message_vision("他不是你的武士！你不能命令他返回总坛！\n", ob);	
        	return 1;
	}
	
	command("say 就此告辞！我在总坛等你！我们后会有期！\n");
        message_vision("\n$N一纵身几个跳跃，消失在远方。\n", this_object());
	
	ob->add_temp("wushi",-1);
	if(ob->query_temp("wushi")<=0)
		ob->set_temp("wushi",0);
	destruct(this_object());
	return 1;
}