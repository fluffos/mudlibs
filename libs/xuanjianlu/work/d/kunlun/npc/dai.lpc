//Cracked by Box

int auto_perform();
#include "mingjiao_npc.lpc"
#include <ansi.h>

void create() {
  mapping S_skills = ([]);
  mapping I_inquiry = ([]);
  mixed Skill_name;
  set_name("黛绮丝", ({ "dai qisi", "dai" }));
  set("title", "明教护教法王");
  set("nickname", MAG "紫衫龙王" NOR);
  set("long", "
一个肤如凝脂、杏眼桃腮的美艳妇人，容光照人，端丽难言。
她就是明教四法王之首的紫衫龙王。\n");
  set("gender", "女性");
  set("age", 24);
  set("attitude", "peaceful");
  set("shen", 2000000);
  create_family("明教", 35, "法王");

  I_inquiry["name"] = "在下就是明教紫衫龙王，不知阁下有何指教。";

  Skill_name = ({ "shenghuo-xuanming", "wuxing-bu", "jinhua-biao",
    "jinhua-zhang", "riyue-shenzhang", "shenghuo-quan", "guangming-xinfa" });
  Set_Inquiry(I_inquiry, Skill_name);

  S_skills["dodge"] = "wuxing-bu";
  S_skills["staff"] = "jinhua-zhang";
  S_skills["parry"] = "riyue-shenzhang";
  S_skills["force"] = "shenghuo-xuanming";
  S_skills["cuff"] = "shenghuo-quan";
  S_skills["strike"] = "riyue-shenzhang";
  set_skill("guangming-xinfa", 250 + random(20));
  set_skill("jinhua-zhang", 320 + random(20));
  set_skill("jinhua-biao", 320 + random(20));
  set_skill("beauty", 320 + random(20));
  set_skill("swimming", 320 + random(50));
  set_skill("literate", 200 + random(20));

  map_skill("staff", "jinhua-zhang");

  Set_Npcskills(280, 20, S_skills);

  Set_Npcattrib(27, 5, 30000, 3000, 50000, 4000, 60000, 3000, 40000, 10000, 2000000, 100000);

  prepare_skill("strike", "riyue-shenzhang");
  prepare_skill("cuff", "shenghuo-quan");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));
  setup();

  carry_object(OBJ_PATH "/changpao")->wear();
  carry_object("/clone/weapon/gangzhang")->wield();
  carry_object("/clone/anqi/jinhua-biao")->set_amount(100);
}
int auto_perform() {
  object me = this_object();
  object weapon = me->query_temp("weapon");
  object opp = me->select_opponent();

  if (me->query("qi", 1) < 0 || me->query("jing", 1) < 0 || me->query("jingli", 1) < 0) return 1;

  if (!me->is_fighting()) {
    if (me->query("eff_qi") < me->query("max_qi"))
      me->exert_function("heal");
    me->set("jiali", 50);

    return 1;
  }

  if (objectp(weapon)) {
    if (weapon->query("skill_type") == "staff")
      return perform_action("staff.huanying");
  } else return perform_action("strike.zhangdao");
}
