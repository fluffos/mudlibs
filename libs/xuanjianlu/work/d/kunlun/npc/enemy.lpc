//Cracked by box
// /d/kunlun/npc/enemy.c

inherit NPC;
#include <ansi.h>

int auto_perform();

void create() {
  set_name("明教敌人", ({ "mingjiao enemy", "enemy" }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));

  switch (random(4)) {
    case 0:
      create_family("神龙教", 2, "弟子"); break;
    case 1:
      create_family("雪山派", 10, "法师"); break;
    case 2:
      create_family("星宿派", 2, "弟子"); break;
    case 3:
      create_family("白驼山", 2, "少庄主"); break;
  }

  setup();


  if (clonep()) {
    carry_object("/clone/armor/tiejia")->wear();
  }
  call_out("self_destruct", 300);
}

int accept_kill(object obj) {
  object me = this_object();
  mapping skill_status;
  string *sname;
  int i, max = 200;

  return 1;
}

void init() {
  object player, me;
  player = this_player();
  me = this_object();

  if (player->query("id") == query("enemy") && player->query_temp("yudijob") == query("yudijob")) {
    if (query("combat_exp") >= 3500000)
      set_leader(player);
    player->kill_ob(me);
    me->kill_ob(player);
  }
}

void self_destruct() {
  object me = this_object();

  message("vision", name(1) + "急急忙忙的离开了。\n", environment(me));

  destruct(me);
}

void die() {
  object ob, obj, me, corpse;
  int i;
  ob = this_object();

  me = query_temp("last_damage_from");

  message_vision("$N大喝一声魔教好厉害，倒地而亡!\n", ob);

  if (userp(me)) {
    if (objectp(obj = present("tieyan ling", me))) {
      if (!me->query_temp("mjjob_over") && me->query("id") == query("enemy") && me->query_temp("yudijob") == query("yudijob")) {
        me->add("mingjiao/killed", 1);
        obj->note_write(me, ob);
      }
    }
  }

  if (objectp(corpse = CHAR_D->make_corpse(this_object())))
    corpse->move(environment(this_object()));

  destruct(ob);
  return;
}


int auto_perform() {
  object npc = this_object();
  object target = npc->select_opponent();

  if (!npc->query_temp("weapon"))
    command("wield all");

  if (npc->query("family/family_name") == "星宿派") {
    if (objectp(npc->query_temp("weapon"))) {
      command("perform jinxian");
    } else {
      if (!target->query_temp("huagong"))
        command("perform sanyin");
      else
        command("perform yiji");
      command("yun qisuck " + target->query("id"));
    }
  } else if (npc->query("family/family_name") == "雪山派") {
    if (npc->query_temp("weapon")) {
      if (!npc->query_temp("wushang"))
        command("perform wushang");
      else
        command("perform feichu");
    } else
      command("perform fen");
  } else if (npc->query("family/family_name") == "白驼山") {
    if (objectp(npc->query_temp("weapon"))) {
      command("perform shoot");
    } else {
      command("perform cuff");
    }
  } else if (npc->query("family/family_name") == "神龙教") {
    if (objectp(npc->query_temp("weapon"))) {
      command("perform wucai");
    } else {
      command("perform huanxue");
    }
  } else {}
  return 1;
}
