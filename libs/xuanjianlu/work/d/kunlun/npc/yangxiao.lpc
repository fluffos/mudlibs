void create()
{
	mapping S_skills= ([ ]);
	mapping I_inquiry=([ ]);
	mixed Skill_name;
        set_name("杨逍",({"yang xiao","yang","xiao"}));
        set("title", "明教光明左使");

        set("long", "
他就是明教的光明左使，和范遥合称逍遥二仙的杨逍。
他身着一身白衫，虽然已是中年，但看上去还十分英俊潇洒。\n");
        set("gender", "男性");
        set("age", 43);
        set("attitude", "peaceful");
        set("shen", 3000000);
        
        create_family("明教",34,"使者");
		
	I_inquiry["name"]="在下就是明教光明左使杨逍，不知阁下有何指教。";
	//I_inquiry["job"]=(: ask_job :);
	//I_inquiry["工作"]=(: ask_job :);
	I_inquiry["yudi"]=(: ask_yudi :);
	I_inquiry["御敌"]=(: ask_yudi :);
	I_inquiry["finish"]=(: ask_finish :);
	I_inquiry["完成"]=(: ask_finish :);
	I_inquiry["放弃"]=(: ask_abandon :);
	I_inquiry["abandon"]=(: ask_abandon :);	
	I_inquiry["武士"]=(: ask_wushi :);
	I_inquiry["wushi"]=(: ask_wushi :);		

	Skill_name=({"shenghuo-xuanming","xiaoyao-piaopiao","xiaoyao-zhangfa",
		     "xiaoyao-jianfa","riyue-shenzhang","shenghuo-quan","guangming-xinfa"});
	
	Set_Inquiry(I_inquiry,Skill_name);

	Set_Npcattrib(27,5,30000,3000,50000,4000,60000,3000,40000,10000,2000000,100000);

	S_skills["dodge"]="xiaoyao-piaopiao";
	S_skills["parry"]="xiaoyao-zhangfa";
	S_skills["sword"]="xiaoyao-jianfa";
	S_skills["force"]="shenghuo-xuanming";
	S_skills["cuff"]="shenghuo-quan";
	S_skills["strike"]="xiaoyao-zhangfa";
	set_skill("qiankun-danuoyi",100+random(10));
	set_skill("guangming-xinfa",380+random(20));
	set_skill("literate",300+random(20));
	
	Set_Npcskills(320,20,S_skills);
	
	prepare_skill("strike","xiaoyao-zhangfa");
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: auto_perform :),
	}) );
        setup();

        carry_object(OBJ_PATH"/changpao")->wear();
        carry_object("/clone/weapon/changjian")->wield();
}

int rujiao(object player)
{
	
	command("hi"+" "+player->query("id"));
	command("look"+" "+player->query("id"));
	player->start_busy(4);

    remove_call_out("rujiao1");
    call_out("rujiao1", 3, player);
}

int rujiao1(object player)
{
	object ling;
	command("say "+"好！既然这位"+RANK_D->query_respect(player)+"想加入我光明圣火教，那么从今天起，你就是我明教信徒！\n");
	player->create_family("明教",38,"教众");
	set_title(player,38);
	tell_object(player,HIC"恭喜您成为明教教众！\n"NOR);

	
	command("say "+"这位"+RANK_D->query_respect(player)+"请随我来。\n");
	message_vision("$N往里走去。\n$n跟着杨逍往里走去。\n",this_object(),player);
	move(MINGJIAO"/daguangchang");
	player->move(MINGJIAO"/daguangchang");
	message_vision("$N走来过来。\n$n跟着杨逍走来过来。\n",this_object(),player);	
	//here need add later
	message_vision("$N对$n说到：这里就是我明教重地光明顶。\n",this_object(),player);	
   	if(objectp(ling = present("tieyan ling", player)) )
	{
		message_vision("$N对$n说到：你刚入我教，怎可能有我教的铁焰令？如果是什么bug请汇报给wzfeng。\n",this_object(),player);	
		return 1;
	}
	ling = new(OBJ_PATH"/tieyanling");
	ling->move(player);
	tell_object(player,"杨逍从怀中取出一块状似火焰的令牌。\n");
	tell_object(player,"杨逍对你说到：这是我教信物<铁焰令>，你需要随身携带，不可丢失。\n");
	tell_object(player,"杨逍给你一块铁焰令。\n");
	command("say "+"你刚入我教，可以随便走走，看我明教声威比齐江湖其它各派如何。\n");
	command("say "+"你可先去五行旗，向旗主们学些入门的功夫。\n");
	command("say "+"我还有要务在身，先行告退。\n");
	move(MINGJIAO"/shting");
	message_vision("$N走了过来。\n",this_object());
	return 1;

}

int auto_perform()
{
	object me=this_object();
	object weapon=me->query_temp("weapon");
	object opp=me->select_opponent();

	if( me->query("qi",1) < 0 || me->query("jing",1) < 0 || me->query("jingli",1) < 0) return 1;

	if ( !me->is_fighting() ) {
					 if ( me->query("eff_qi") < me->query("max_qi") )
								me->exert_function("heal");
					 me->set("jiali", 50);

					 return 1;
		  }

		  if ( objectp(weapon) ) {
					 if ( weapon->query("skill_type") == "sword" )
								return perform_action("sword.jianqi");
		  }
		  else return perform_action("strike.xiaoyao");
}

string ask_job()
{
     	object player, ling;
     	mapping fam, status;
     	string *type;
     	int amu;
     	
     	player=this_player();

    	if (!(fam = this_player()->query("family")) || fam["family_name"] != "明教")
        	return "这位"+RANK_D->query_respect(player)+"并非我教弟兄，那敢在下那敢分派阁下什么任务呢。\n";

	if(!objectp(ling = present("tieyan ling", player)) )
		return "这位"+RANK_D->query_respect(player)+"没有我教信物铁焰令，我如何记录奖赏过失？\n";

	if (fam["generation"] >=37)
		 return "这位"+RANK_D->query_respect(player)+"刚为我教"+fam["title"]+"，怎能完成振兴明教的大任。\n";

	if(player->query("mingjiao/job"))
		return judge_jobmsg(player,0);

	command("nod "+player->query("id"));
	
        command("say 现在为了天下苍生，我们明教要去铲除邪派，此事就由你负责。");
        
        status = ([
                   "星宿派": 50,
                   "白驼山": 50,
                   "神龙教": 50,
                   "血刀门": 50,
                   "雪山派": 50,
                ]);
        
        type = keys(status);
        amu = sizeof(type);
        printf("你在下面门派名称中选择一个吧(cancel)为放弃:\n");
        while(amu--)
        {
        	printf("名称： %-15s  敌对度：%8d\n",
                	type[amu],
                    	status[type[amu]],
                       );
        }
                      
	player->set("mingjiao/job","kill_npc_player");
        input_to("get_chanchu",player,status,type);
        return HIW"好好练功，为苍生造福！"NOR;
}  

int get_chanchu(string arg, object me, mapping status, string *type)
{
	string str;
	object ling;
	int amu;
	amu = sizeof(type);
	if(arg == "cancel" || !arg || arg == "")
	{
		command("disapp " + me->query("id"));
		command("say 等你练好武功再来吧！");
		me->delete("mingjiao/job");		
		return 1;
	}
	if(member_array(arg, type)==-1)
	{
                printf("你在下面门派名称中选择一个吧(cancel)为放弃:\n");
                while(amu--)
                {
               	     printf("名称： %-15s  敌对度：%8d\n",
                             type[amu],
                             status[type[amu]],
                           );
                }
		input_to("get_chanchu",me,status,type);
		return 1;
	}
	
	if(!objectp(ling = present("tieyan ling", me)) )
		return notify_fail("这位"+RANK_D->query_respect(me)+"没有我教信物铁焰令，我如何记录奖赏过失？\n");
	else
		ling->set("job_id",me->query("id"));
	
	command("say 你就去给"+arg+"些教训吧。");
        me->set_temp("mjjob_time",time()+ 300);
	me->set_temp("mj_chanchu", arg);
	return 1;
}

string ask_finish()
{
	string name;
	string job_flg;
	object me, ob;
	me= this_player();
	ob=present("tieyan ling", me);

	if(!objectp(ob))
		return "没有铁焰令，你完成任务，我也不知道该怎么奖赏你啊？\n";

	job_flg = judge_jobmsg(me,1);

	if ( job_flg == "铲除异己" ) 
	{
		if(me->query_temp("mjjob_over")) 
		{
			me->delete_temp("mjjob_over");
			command("thumb "+me->query("id"));
			remove_call_out("reward_dest");
			call_out("reward_dest",1,this_player(),ob,job_flg);
			return "这位兄弟辛苦了!下去好好休息休息！\n";
		}
		else
		{
			return 	"这位兄弟还没有完成任务吧！！\n";
		}
	}
	else if (job_flg=="御敌")
	{
        	if(me->query("mingjiao/killed")>=me->query("mingjiao/enemy")-1)
		{
			command("thumb "+me->query("id"));
			remove_call_out("reward_dest");
			call_out("reward_dest",1,this_player(),ob,job_flg);
			return "这位兄弟辛苦了!下去好好休息休息！\n";
		}
                else if (!me->query_temp("mjjob_over"))
		{
			return 	"这几个小毛贼你都收拾不了？你死了算了，放弃任务吧！！\n";
		}
                else
                {
                      return  "什么都晚了，你这不争气的东西，放弃任务吧！\n";
                }
	}
	else
	{
		command("hmm "+me->query("id"));
		return "阁下没有这项工作吧。\n";
	}
		
	return "你要做什么？\n";
}

string ask_wushi()
{
	object player=this_player();
    	mapping fam;
    	object wushi;
	int comexp;
	int wushinum;
         return "对不起！百宝箱关闭了武士制度，因为发现了攻击力bug\n";

    	if (!(fam = this_player()->query("family")) || fam["family_name"] != "明教")
		return "这位"+RANK_D->query_respect(player)+"并非我明教弟兄，打听这个干嘛。\n";

	if (query("id")=="yang xiao" && query("name")=="杨逍")
	{
		if((int)fam["generation"]-33<0 || (int)fam["generation"]-33>2)
		{
			command("disapp " +player->query("id"));
			return "你还是为咱们明教多做贡献吧！";
		}
		wushinum=player->query_temp("wushi");
		
		//调试用
		if(player->query("id")=="box")
		{
			//wushinum=1;
		}
			
		switch((int)fam["generation"])
		{
			case 33:
				if (wushinum>=4)
					return HIC"教主已经有四位贴身武士了。这是最多的了。\n"NOR;
				break;
			case 34:
				if (wushinum>=2)
					return HIC"使者已经有两位贴身武士了，您不能再要了！\n"NOR;
				break;
			case 35:
				if (wushinum>=1)
					return HIC"法王已经有一位贴身武士了，您不能再要了\n"NOR;
				break;
			default:
				return HIC"您还不能拥有武士。\n"NOR;
				break;	
		}
		wushi=random_wushi(player);
		wushi->move(environment(player));
		wushi->set_leader(player);
		player->add_temp("wushi",1);
		return HIW"将"+wushi->query("name")+"("+wushi->query("id")+")"+"配给您作贴身武士\n"NOR;
	}	
	else
	{
		return "你还是去问问我们明教光明左使杨逍去吧！\n";
	}
}

object random_wushi(object me)
{
	object output;
	string nickname,name,*tmp,*pinying;
	mapping skill;
	name=NAME_D->create_name();
	nickname=NAME_D->create_nick();
	tmp=explode(name,"@");
	pinying=explode(tmp[1]," ");
	output=new("/d/kunlun/npc/wushi");
	output->set_name(tmp[0],({tmp[1],pinying[0],pinying[1]}));
	output->set("nickname",nickname);
	output->set("title","明教武士");
	output->set("gender",random(3)>0?"男性":"女性");
	output->set("master",me->query("id"));
	output=do_clone(output,me);
	return output;
}

object random_enemy(object me)
{
	object output;
	string nickname,name,*tmp,*pinying;
	
	name=NAME_D->create_name();
	nickname=NAME_D->create_nick();
	tmp=explode(name,"@");
	pinying=explode(tmp[1]," ");
	output=new("/d/kunlun/npc/enemy");
	output->set_name(tmp[0],({tmp[1],pinying[0],pinying[1]}));
	output->set("nickname",nickname);
	//output->set("title","明教敌人");
	output->set("gender",random(3)>0?"男性":"女性");
	output->set("enemy",me->query("id"));
	output=clone_npc(output,me);
	return output;
}

object clone_npc(object output, object me)
{
	int level;
	
    	set_attrib(me,output);

	level = pow(10*output->query("combat_exp"), 0.3334);	

    	switch (output->query("family/family_name"))
    	{
    		case "白驼山":
    			output->set_skill("force",level);
    			output->set_skill("dodge",level);
    			output->set_skill("parry",level);
    			output->set_skill("staff",level);
    			output->set_skill("cuff",level);
    			output->set_skill("strike",level);
    			
        		output->set_skill("hamagong", level);
        		output->set_skill("lingshe-zhang", level);
			output->set_skill("chanchubu", level);
			output->set_skill("poison", level);
			output->set_skill("lingshe-quan",level);
 
        		output->map_skill("force", "hamagong");
        		output->map_skill("dodge", "chanchubu");
        		output->map_skill("parry", "lingshe-zhang");
        		output->map_skill("strike", "hamagong");
        		output->map_skill("cuff", "lingshe-quan");
        		output->map_skill("staff", "lingshe-zhang");
        
        		output->prepare_skill("strike", "shentuo-zhang");
        		output->prepare_skill("cuff","lingshe-quan");
			//output->set("default_weapon", "/clone/weapon/shezhang");
			output->carry_object("/clone/weapon/shezhang")->wield();
			output->set("family/master_name","欧阳锋");
			output->set("title","白驼山少庄主");
			break;
    		case "雪山派":
 			output->set_skill("force",level);
    			output->set_skill("dodge",level);
    			output->set_skill("parry",level);
			output->set_skill("blade",level);
    			output->set_skill("sword",level);
    			output->set_skill("hand",level);
    			output->set_skill("cuff",level);
    			output->set_skill("strike",level);
    			output->set_skill("staff",level);
    			
        		output->set_skill("longxiang-banruo", level);
        		output->set_skill("xue-dao", level);
        		output->set_skill("jingang-chu", level);
			output->set_skill("dashou-yin", level);
			output->set_skill("yujiamu-quan", level);
			output->set_skill("xueshitiao", level);
			output->set_skill("mingwang-jian", level);
			output->set_skill("huoyan-dao",level);
 
        		output->map_skill("force", "longxiang-banruo");
        		output->map_skill("dodge", "xueshitiao");
        		output->map_skill("parry", "dashou-yin");
        		output->map_skill("blade", "xue-dao");
        		output->map_skill("sword", "mingwang-jian");
        		output->map_skill("hand", "dashou-yin");
        		output->map_skill("cuff", "yujiamu-quan");
        		output->map_skill("staff", "jingang-chu");
        		output->map_skill("strike","huoyan-dao");
        
        		output->prepare_skill("strike", "huoyan-dao");
        		
			//output->set("default_weapon", "/clone/weapon/gangzhang");
			output->carry_object("/clone/weapon/gangzhang")->wield();

			break;
		case "神龙教":	
        		output->set("shenlong/huanxie_canuse", 1);
        		output->set_skill("force", level);
        		output->set_skill("dulong-dafa", level);
        		output->set_skill("dodge", level);
        		output->set_skill("lingshe-shenfa", level);
        		output->set_skill("strike", level);
        		output->set_skill("huagu-mianzhang", level);
        		output->set_skill("parry", level);
        		output->set_skill("kick", level);
        		output->set_skill("jueming-tui", level);        
         		output->set_skill("poison", level);
        		output->set_skill("literate", level);
         		output->set_skill("medicine", level);

        		output->map_skill("strike","huagu-mianzhang");
        		output->map_skill("dodge","lingshe-shenfa");
        		output->map_skill("parry", "huagu-mianzhang");
        		output->map_skill("hook","ruyi-gou");
	        	output->map_skill("force","dulong-dafa");
	        	output->map_skill("kick","jueming-tui");
	        	
	        	output->prepare_skill("strike", "huagu-mianzhang");
	        	output->prepare_skill("kick", "jueming-tui");
        		break;
		case "星宿派":
    		default:
 			output->set_skill("force",level);
    			output->set_skill("dodge",level);
    			output->set_skill("parry",level);
    			output->set_skill("claw",level);
    			output->set_skill("strike",level);
    			output->set_skill("staff",level);
    			
		        output->set_skill("huagong-dafa", level);
		        output->set_skill("zhaixinggong", level);
		        output->set_skill("chousui-zhang", level);
		        output->set_skill("sanyin-zhua", level);
		        output->set_skill("tianshan-zhang", level);
		        output->set_skill("poison", level);
		
			output->map_skill("force", "huagong-dafa");
			output->map_skill("strike", "chousui-zhang");
			output->map_skill("claw", "sanyin-zhua");
			output->map_skill("dodge", "zhaixinggong");
			output->map_skill("parry", "sanyin-zhua");
			output->map_skill("staff", "tianshan-zhang");
		
			output->prepare_skill("strike", "chousui-zhang");
			output->prepare_skill("claw", "sanyin-zhua");
			//output->set("default_weapon", "/clone/weapon/gangzhang");
			output->carry_object("/clone/weapon/gangzhang")->wield();
			break;
    	}
    	return output;
}

void set_attrib(object me, object output)
{
	mapping hp_status;
    	hp_status=me->query_entire_dbase();

        output->set("str", hp_status["str"]);
        output->set("int", hp_status["int"]);
        output->set("con", hp_status["con"]);
	output->set("dex", hp_status["dex"]);
        output->set("age", hp_status["age"]);


        output->set("max_qi",    hp_status["max_qi"]);
        output->set("eff_qi",    hp_status["max_qi"]);
        output->set("qi",        hp_status["max_qi"]);
        output->set("max_jing",  hp_status["max_jing"]);
        output->set("eff_jing",  hp_status["max_jing"]);
        output->set("jing",      hp_status["max_jing"]);
        output->set("max_neili", hp_status["max_neili"]);
        output->set("eff_neili", hp_status["max_neili"]);
        output->set("neili",     hp_status["max_neili"]);
        output->set("max_jingli",hp_status["max_jingli"]);
        output->set("jingli",    hp_status["max_jingli"]);
        output->set("jiali",     to_int(sqrt(to_float(hp_status["max_neili"]))));
        output->set("gender",    hp_status["gender"]);
        output->set("combat_exp",hp_status["combat_exp"]);
}

object do_clone(object output,object me)
{
    	int level,rom;
    	object obj;

    	//seteuid( geteuid(output) );
    	set_attrib(me,output);

	level = pow(10*output->query("combat_exp"), 0.3334);	


	//基本功夫
	output->set_skill("force", level);
        output->set_skill("dodge", level);
	output->set_skill("parry", level);
	
	output->set_skill("shenghuo-xuanming", level);
	output->map_skill("force", "shenghuo-xuanming");	
	
	rom=random(500)+1;
	
	//调试用
	if(me->query("id")=="box")
	{
		message_vision("随机数字: " + rom + "\n",me);
	}

	if(rom<100)
	{	
		//龙王
		output->set_skill("throwing",level);
		output->set_skill("staff", level);
		output->set_skill("strike", level);
		output->set_skill("cuff", level);


		output->set_skill("jinhua-zhang", level);
		output->set_skill("jinhua-biao", level);
		output->set_skill("wuxing-bu", level);
		
		output->set_skill("riyue-shenzhang", level);
		output->set_skill("shenghuo-quan", level);
		output->map_skill("staff", "jinhua-zhang");
	        output->map_skill("strike", "riyue-shenzhang");
		output->map_skill("cuff", "shenghuo-quan");
		output->map_skill("parry", "jinhua-zhang");
		output->map_skill("dodge", "wuxing-bu");
			
		output->prepare_skill("cuff", "riyue-shenzhang");
        	output->prepare_skill("strike", "shenghuo-quan");
        		
        	output->carry_object("/clone/weapon/gangzhang")->wield();
        	output->carry_object("/clone/anqi/jinhua-biao")->set_amount(100);
	}
	else if(rom < 200)
	{
		//鹰王
			
		output->set_skill("hand", level);
		output->set_skill("claw", level);
		output->set_skill("sword", level);
			
		output->set_skill("dafeng-yunfei", level);
		output->set_skill("yingzhua-qinna", level);
		output->set_skill("baihong-jianfa", level);
		output->set_skill("tianying-aoxiang", level);
			
	       	output->map_skill("hand", "dafeng-yunfei");
		output->map_skill("claw", "yingzhua-qinna");
		output->map_skill("parry", "yingzhua-qinna");
		output->map_skill("dodge", "tianying-aoxiang");
		output->map_skill("sword", "baihong-jianfa");
			
		output->prepare_skill("hand", "dafeng-yunfei");
        	output->prepare_skill("claw", "yingzhua-qinna");			
			
	}
	else if(rom <300)
	{
		//狮王
		output->set_skill("strike", level);
		output->set_skill("cuff", level);
		output->set_skill("wuxing-bu", level);

		output->set_skill("riyue-shenzhang", level);
		output->set_skill("shenghuo-quan", level);
			
        	output->map_skill("strike", "riyue-shenzhang");
		output->map_skill("cuff", "shenghuo-quan");
		output->map_skill("dodge", "wuxing-bu");
		output->map_skill("parry", "shenghuo-quan");
			
		output->prepare_skill("cuff", "riyue-shenzhang");
        	output->prepare_skill("strike", "shenghuo-quan");
	}
	else if(rom <400)
	{
		//蝠王
		output->set_skill("strike", level);
		output->set_skill("hanbing-mianzhang", level);
		output->set_skill("qingfu-shenfa", level);
		
		output->map_skill("dodge", "qingfu-shenfa");
		output->map_skill("parry", "hanbing-mianzhang");
		output->map_skill("strike", "hanbing-mianzhang");
			
		output->prepare_skill("strike", "hanbing-mianzhang");	
	}
	else if(rom<495)
	{
		//使者
		output->set_skill("strike", level);
		output->set_skill("sword", level);
		output->set_skill("qiankun-danuoyi", 250);
			
		output->set_skill("xiaoyao-piaopiao",level);
		output->set_skill("xiaoyao-zhangfa", level);
		output->set_skill("xiaoyao-jianfa", level);
		
		output->map_skill("dodge", "qiankun-danuoyi");
		output->map_skill("parry", "qiankun-danuoyi");
		output->map_skill("strike", "xiaoyao-zhangfa");
		output->map_skill("sword", "xiaoyao-jianfa");
			
		output->prepare_skill("strike", "xiaoyao-zhangfa");	
			
		output->carry_object("/clone/weapon/qinggang-jian")->wield();
	}
	else if(rom>=495)
	{
		//教主
		output->set_skill("strike", level);
		output->set_skill("cuff", level);
		output->set_skill("sword", level);
		
		output->set_skill("qiankun-danuoyi", level);
		output->set_skill("jiuyang-shengong", level);
		output->set_skill("shenghuo-ling", level);
		
		output->map_skill("dodge", "qiankun-danuoyi");
		output->map_skill("parry", "qiankun-danuoyi");
		output->map_skill("strike", "shenghuo-ling");
		output->map_skill("cuff", "shenghuo-ling");
		output->map_skill("sword", "shenghuo-ling");
			
		output->map_skill("force", "jiuyang-shengong");	
		output->prepare_skill("strike", "shenghuo-ling");
		output->prepare_skill("cuff", "shenghuo-ling");
		output->prepare_skill("sword", "shenghuo-ling");
			
		output->carry_object("/clone/weapon/qinggang-jian")->wield();
	}
        		
	return output;
}

string ask_yudi()
{
	mapping fam;
	object ling, player, enemy, room;
	int num;
	string wherenpc;
		
	player=this_player();
	
    	if (!(fam = player->query("family")) || fam["family_name"] != "明教")
        	return "这位"+RANK_D->query_respect(player)+"并非我教弟兄，那敢在下那敢分派阁下什么任务呢。\n";

	if(!objectp(ling = present("tieyan ling", player)) )
		return "这位"+RANK_D->query_respect(player)+"没有我教信物铁焰令，我如何记录奖赏过失？\n";

	if (fam["generation"] >=37)
		 return "这位"+RANK_D->query_respect(player)+"刚为我教"+fam["title"]+"，怎能完成振兴明教的大任。\n";		 

	if(player->query("mingjiao/job"))
		return judge_jobmsg(player,0);

	command("nod "+player->query("id"));
	
	num=random(3)+2;
	
        command("say 据风火雷电四门探子回报，" + chinese_number(num) +"个邪派人士正在准备进攻我光明顶，你去帮助范遥去消灭他们吧!\n此事事关重大，你务必要小心从事！\n");
	
	player->set("mingjiao/job","yudi");
	player->set("mingjiao/enemy",num);
	
	//tell_object(player, "敌人共有: " + num + " 个\n");
	
	player->add_temp("yudijob",1);
	
	while(num>0)
	{
		wherenpc=where[random(sizeof(where))];
		wherenpc="/d/kunlun/" + wherenpc + ".lpc";
		if (!objectp(room = load_object(wherenpc)))
		{	
			//没有这个房间，出错了！
			tell_object(player,"出错了！报告巫师组，没有" + wherenpc +"这个房间\n");
			continue;
		}
		
		enemy=random_enemy(player);
		
		if(player->query("mingjiao/1")!=wherenpc &&
		   player->query("mingjiao/2")!=wherenpc &&
		   player->query("mingjiao/3")!=wherenpc &&
		   player->query("mingjiao/4")!=wherenpc)
		{
			player->set("mingjiao/" + num,wherenpc);
			player->set("mingjiao/npc" + num,enemy->query("id"));
                        enemy->move(wherenpc);
			enemy->set("enemy",player->query("id"));
			enemy->set("yudijob",player->query_temp("yudijob"));
			
			//铁焰令上记录杀手信息
			
			ling->add("mjjob_note/"+enemy->query("id"),([
			       "id":   enemy->query("id"),
			       "name": enemy->query("name"),
			       "where": room->query("short"),
			       "family_name": enemy->query("family/family_name"),
			       "bonus": 0,
			]));
			
			room=0;			
			num--;
		}
	}
        player->set_temp("mjjob_time",time()+ 300);
	player->delete("mingjiao/killed");
	player->delete_temp("mjjob_over");
	return "路上小心！";	
}
