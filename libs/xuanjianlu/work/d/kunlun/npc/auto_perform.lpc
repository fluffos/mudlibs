//Cracked by box
// /d/kunlun/npc/
// for mingjiao npc's autoperform
// 2004-1-18
// auto perform function (dispatched by chat_combat_msg)

int auto_perform()
{
	object me = this_object();
	object target = me->select_opponent();
	object weapon = me->query_temp("weapon");

	if ( !me->is_fighting() ) {
		if ( me->query("eff_qi") < me->query("max_qi") )
			exert_function("heal");
		me->set("jiali", (int)me->query_skill("force")/2);
		return 1;
	}

	if ( !objectp(target)
	  || !random( (int)me->query("combat_exp") * 2
		   / (int)target->query("combat_exp") + 1) ) return 0;

	if ( objectp(weapon) ) {
		if ( weapon->query("skill_type") == "sword" )
			return perform_action("sword.tougu");
	}
	else
	{
		if( !me->query_temp("sanhua") )
			return perform_action("strike.sanhua");
		else
			return perform_action("cuff.lianhuan");
	}
}