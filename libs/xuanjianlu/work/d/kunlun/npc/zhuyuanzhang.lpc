#include "mingjiao_npc.lpc"
//#include "mingjiao_job.h"
#include <ansi.h>

void create() {
  mapping S_skills = ([]);
  mapping I_inquiry = ([]);
  mixed Skill_name;
  set_name("朱元璋", ({ "zhu yuanzhang", "zhu" }));
  set("title", "明教弟子");
  set("long", "有待添加。\n");
  set("age", 32);
  set("attitude", "peaceful");
  set("shen", 300000);
  create_family("明教", 38, "弟子");

  Skill_name = ({ "guangming-xinfa", "wuxing-bu",
    "riyue-shenzhang", "shenghuo-quan" });
  I_inquiry["name"] = "在下就是明教弟子朱元璋，不知阁下有何指教。";
  Set_Inquiry(I_inquiry, Skill_name);
  Set_Npcattrib(20, 5, 1500, 300, 3000, 400, 2000, 300, 1500, 1000, 300000, 50000);

  S_skills["force"] = "shenghuo-xuanming";
  S_skills["dodge"] = "wuxing-bu";
  S_skills["parry"] = "duoming-bi";
  S_skills["pike"] = "duoming-bi";
  S_skills["strike"] = "riyue-shenzhang";
  S_skills["cuff"] = "shenghuo-quan";
  set_skill("guangming-xinfa", 50 + random(20));
  set_skill("literate", 50 + random(20));


  Set_Npcskills(50, 20, S_skills);

  prepare_skill("cuff", "shenghuo-quan");
  prepare_skill("strike", "riyue-shenzhang");

  setup();
  carry_object(OBJ_PATH "/changpao")->wear();
  carry_object(OBJ_PATH "/panguan-bi")->wear();
}
