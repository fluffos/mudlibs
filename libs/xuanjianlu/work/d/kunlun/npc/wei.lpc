//Cracked by Box

int auto_perform();
#include "mingjiao_npc.lpc"
#include <ansi.h>

void create() {
  mapping S_skills = ([]);
  mapping I_inquiry = ([]);
  mixed Skill_name;
  set_name("韦一笑", ({ "wei yixiao", "wei" }));
  set("title", "明教护教法王");
  set("nickname", HIG "青翼蝠王" NOR);
  set("long", "
这就是明教护教法王之一的青翼蝠王。他身披青条子白色长袍，身材高
瘦，脸色略为苍白。此人轻功极高，当世无匹。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen", 2000000);
  create_family("明教", 35, "法王");

  I_inquiry["name"] = "在下就是明教青翼蝠王，不知阁下有何指教。";

  Skill_name = ({ "shenghuo-xuanming", "qingfu-shenfa", "hanbing-mianzhang",
    "bagua-dao", "riyue-shenzhang", "shenghuo-quan", "guangming-xinfa" });
  Set_Inquiry(I_inquiry, Skill_name);

  Set_Npcattrib(27, 5, 30000, 3000, 50000, 4000, 60000, 3000, 40000, 10000, 2000000, 100000);

  S_skills["dodge"] = "qingfu-shenfa";
  S_skills["blade"] = "bagua-dao";
  S_skills["parry"] = "hanbing-mianzhang";
  S_skills["force"] = "shenghuo-xuanming";
  S_skills["cuff"] = "shenghuo-quan";
  S_skills["strike"] = "hanbing-mianzhang";
  set_skill("guangming-xinfa", 250 + random(20));
  set_skill("hanbing-mianzhang", 350 + random(20));
  set_skill("qingfu-shenfa", 350 + random(50));
  set_skill("dodge", 350 + random(50));
  set_skill("literate", 200 + random(20));

  map_skill("dodge", "qingfu-shenfa");

  Set_Npcskills(280, 20, S_skills);

  prepare_skill("strike", "hanbing-mianzhang");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));
  setup();

  carry_object(OBJ_PATH "/changpao")->wear();
}
int auto_perform() {
  object me = this_object();
  object weapon = me->query_temp("weapon");
  object opp = me->select_opponent();

  if (me->query("qi", 1) < 0 || me->query("jing", 1) < 0 || me->query("jingli", 1) < 0) return 1;

  if (!me->is_fighting()) {
    if (me->query("eff_qi") < me->query("max_qi"))
      me->exert_function("heal");
    me->set("jiali", 50);
    return 1;
  }

  if (objectp(weapon)) {
    if (weapon->query("skill_type") == "blade")
      return perform_action("blade.bagua");
  } else
    return perform_action("strike.blood");
}
