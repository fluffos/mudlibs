//Cracked by Box

inherit F_MASTER;

int auto_perform();

#include <ansi.h>
#include "mingjiao_npc.lpc"
string ask_jiuyang();
string ask_qk();

void create() {
  mapping S_skills = ([]);
  mapping I_inquiry = ([]);
  mixed Skill_name;
  object shenghuo;

  set("nickname", HIC "明教教主" NOR);


  set_name(HIW "张无忌" NOR, ({ "zhang wuji", "zhang" }));
  set("long",
    "他就是明教教主张无忌。\n"
    "他身着一身白衫，玉树临风十分英俊潇洒。\n"
    "当年他一人独当六大门派，一举成名，成为明教教主。\n"
  );
  set("gender", "男性");
  set("age", 24);
  set("shen_type", 1);


  Set_Npcattrib(27, 5, 30000, 3000, 50000, 4000, 60000, 3000, 40000, 10000, 6400000, 100000);

  Skill_name = ({ "shenghuo-quan", "riyue-shenzhang", "guangming-xinfa",
    "shenghuo-xuanming", "wuxing-bu", "bagua-dao" });

  S_skills["dodge"] = "qiankun-danuoyi";
  S_skills["blade"] = "shenghuo-ling";
  S_skills["parry"] = "qiankun-danuoyi";
  S_skills["force"] = "jiuyang-shengong";
  S_skills["cuff"] = "shenghuo-ling";
  S_skills["sword"] = "shenghuo-ling";
  S_skills["strike"] = "shenghuo-ling";
  set_skill("guangming-xinfa", 450 + random(20));
  set_skill("literate", 500 + random(20));
  set_skill("shenghuo-xuanming", 400 + random(100));
  set_skill("medicine", 500 + random(100));
  set_skill("poison", 400 + random(30));
  set_skill("shenghuo-quan", 400 + random(30));
  set_skill("riyue-shenzhang", 400 + random(30));
  set_skill("bagua-dao", 400 + random(30));
  set_skill("wuxing-bu", 400 + random(30));

  map_skill("parry", "qiankun-danuoy");
  map_skill("dodge", "qiankun-danuoyi");
  map_skill("strike", "shenghuo-ling");
  map_skill("cuff", "shenghuo-ling");

  Set_Npcskills(400, 20, S_skills);

  prepare_skill("cuff", "shenghuo-ling");
  prepare_skill("strike", "shenghuo-ling");

  create_family("明教", 33, "教主");

  set("chat_chance_combat", 500);
  set("chat_msg_combat", ({
    (: auto_perform :),
  }));

  I_inquiry["name"] = "在下就是明教教主张无忌，不知阁下有何指教。";
  I_inquiry["张无忌"] = "在下就是明教教主张无忌，不知阁下有何指教。";
  I_inquiry["九阳神功"] = (: ask_jiuyang :);
  I_inquiry["jiuyang shengong"] = (: ask_jiuyang :);
  I_inquiry["乾坤大挪移"] = (: ask_qk :);
  I_inquiry["qiankun nuoyi"] = (: ask_qk :);

  Set_Inquiry(I_inquiry, Skill_name);



  setup();

  if (clonep()) {
    shenghuo = carry_object(OBJ_PATH "/shenghuoling");

    if (objectp(shenghuo))
      shenghuo->wield();
    else if (objectp(shenghuo = carry_object(OBJ_PATH "/jueshi.lpc")))
      shenghuo->wield();
    else if (objectp(shenghuo = carry_object("/clone/weapon/qinggang-jian.lpc")))
      shenghuo->wield();
    carry_object("/clone/armor/cloth")->wear();
  }
}

int auto_perform() {
  object me = this_object();
  object weapon = me->query_temp("weapon");
  object opp = me->select_opponent();
  object weapon2 = opp->query_temp("weapon");

  if (me->query("qi", 1) < 0 || me->query("jing", 1) < 0 || me->query("jingli", 1) < 0) return 1;


  if (!me->is_fighting()) {
    if (me->query("eff_qi") < me->query("max_qi"))
      me->exert_function("heal");
    me->set("jiali", 50);
    return 1;
  }

  if (weapon2 && weapon->query("id") == "shenghuo ling")
    return perform_action("sword.duo");

  if (!opp->query_temp("bosi/yinfeng"))
    return perform_action("sword.yinfeng");
  else
    return perform_action("sword.tougu");

}
string ask_qk() {
  object *obs, player, obj = 0;
  player = this_player();

  if (player->query("family/family_name") != "明教") {
    command("laugh");
    return "你不是我们明教中人，我怎么能给你？";
  }

  if (player->query_temp("marks/摸") != 2) {
    return "你还是去明教的密室中去看看吧！";
  }

  if (player->query("combat_exp") < 1000000) {
    command("disapp " + player->query("id"));
    return "这位壮士还是去多学学本领再来吧！\n";
  }

  if (player->query("family/title") != "教主" || player->query("family/generation") != 33) {
    return "你不是教主就想学乾坤大挪移？未免也太痴心妄想了吧！";
  }
  obs = filter_array(children(OBJ_PATH "/qk-book.lpc"), (: clonep :));

  if (sizeof(obs) > 0)
    obj = obs[0];

  if (objectp(obj) && objectp(environment(obj)) &&
    userp(environment(obj)))
    return "《乾坤大挪移心法》被别的兄弟借走了，你去问他们吧\n";

  if (!objectp(obj))
    obj = new(OBJ_PATH "/qk-book.lpc");

  if (objectp(obj)) {
    obj->move(player);
    player->set_temp("got_qkbook", 1);
    player->delete_temp("marks/摸");
    message_vision("$N给$n一部乾坤大挪移心法。\n", this_object(), player);
    command("rumor " + this_player()->query("name") + "弄到了一部" NOR HIB "《乾坤大挪移》" HIM "。" NOR);
    return "我将《乾坤大挪移心法》传授于你吧。\n";
  }
}

string ask_jiuyang() {
  object *obs, player, obj = 0;
  player = this_player();

  if (player->query_temp("marks/摸") != 2) {
    return "你还是去明教的密室中去看看吧！";
  }

  if (player->query("combat_exp") < 1000000) {
    command("disapp " + player->query("id"));
    return "这位壮士还是去多学学本领再来吧！\n";
  }
  obs = filter_array(children(OBJ_PATH "/jiuyang-book.lpc"), (: clonep :));

  if (sizeof(obs) > 0)
    obj = obs[0];

  if (objectp(obj) && objectp(environment(obj)) &&
    userp(environment(obj)))
    return "《九阳真经》被别的兄弟借走了，你去问他们吧\n";

  if (!objectp(obj))
    obj = new(OBJ_PATH "/jiuyang-book.lpc");

  if (objectp(obj)) {
    obj->move(player);
    player->set_temp("got_jiuyang", 1);
    message_vision("$N给$n一部九阳神功。\n", this_object(), player);
    command("rumor " + this_player()->query("name") + "弄到了一部" NOR YEL "《九阳真经》" HIM "。" NOR);
    player->delete_temp("marks/摸");
    return "我将《九阳真经》传授于你吧。\n";
  }
}

void die() {
  object ob, me, ling, corpse;

  ob = this_object();
  me = query_temp("last_damage_from");

  if (userp(me))
    if (objectp(ling = present("shenghuo ling", ob))) {
      ling->set("masterid", me->query("id"));
      ling->move(me);
    }

  message_vision("$N倒在地上，挣扎了几下就死了。\n", ob);

  if (objectp(corpse = CHAR_D->make_corpse(ob)))
    corpse->move(environment(ob));

  destruct(ob);
}
