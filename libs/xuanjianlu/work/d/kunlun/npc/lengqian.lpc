//Cracked by Kafei

#include "mingjiao_npc.lpc"
//#include "mingjiao_job.h"
#include <ansi.h>

string ask_jinji();
string ask_gonglao();

void create() {
  mapping S_skills = ([]);
  mapping I_inquiry = ([]);
  mixed Skill_name;
  set_name("冷谦", ({ "leng qian", "leng" }));
  set("title", "明教五散人");
  set("long", "
明教五散人冷谦\n");
  set("age", 38);
  set("attitude", "peaceful");
  set("shen", 1000000);
  create_family("明教", 36, "散人");

  Skill_name = ({ "guangming-xinfa", "wuxing-bu", "duoming-bi",
    "riyue-shenzhang", "shenghuo-quan" });
  I_inquiry["name"] = "在下就是明教五散人冷谦，不知阁下有何指教。";
  I_inquiry["晋级"] = (: ask_jinji :);
  I_inquiry["功劳"] = (: ask_gonglao :);
  I_inquiry["jinji"] = (: ask_jinji :);
  I_inquiry["gonglao"] = (: ask_gonglao :);
  Set_Inquiry(I_inquiry, Skill_name);
  Set_Npcattrib(25, 5, 2000, 300, 4000, 400, 4000, 300, 3000, 1000, 1000000, 100000);

  S_skills["force"] = "shenghuo-xuanming";
  S_skills["dodge"] = "wuxing-bu";
  S_skills["parry"] = "duoming-bi";
  S_skills["pike"] = "duoming-bi";
  S_skills["strike"] = "riyue-shenzhang";
  S_skills["cuff"] = "shenghuo-quan";
  set_skill("guangming-xinfa", 120 + random(20));
  set_skill("literate", 120 + random(20));

  Set_Npcskills(120, 20, S_skills);

  prepare_skill("cuff", "shenghuo-quan");
  prepare_skill("strike", "riyue-shenzhang");

  setup();
  carry_object(OBJ_PATH "/changpao")->wear();
  carry_object(OBJ_PATH "/panguan-bi")->wield();
}

string ask_jinji() {
  //old_cc=me->query("mingjiao/credit");
  object ob, who = this_player();

  if (who->query("family/family_name") != "明教")
    return RANK_D->query_respect(who) + "和我明教素无瓜葛，何有此问啊？";

  if (who->query("mingjiao/credit") == 0)
    return "你一点功劳都没有，快去要job做吧！";

  if (who->query("mingjiao/credit") <= 10000) {
    command("congra");
    set_title(who, 38);
    return RANK_D->query_respect(who) + "为我明教尽心尽力、军功赫赫。晋升为";
  }

  if (who->query("mingjiao/credit") <= 300000) {
    command("congra");
    set_title(who, 37);
    return RANK_D->query_respect(who) + "为我明教尽心尽力、军功赫赫。晋升为掌旗使";
  }

  if (who->query("mingjiao/credit") <= 500000) {
    command("congra");
    set_title(who, 36);
    return RANK_D->query_respect(who) + "为我明教尽心尽力、军功赫赫。晋升为散人";
  }

  if (who->query("mingjiao/credit") <= 800000) {
    command("congra");
    set_title(who, 35);
    return RANK_D->query_respect(who) + "为我明教尽心尽力、军功赫赫。晋升为护教法王";
  }

  if (who->query("mingjiao/credit") <= 2000000) {
    command("congra");
    set_title(who, 34);
    return RANK_D->query_respect(who) + "为我明教尽心尽力、军功赫赫。晋升为光明使者";
  } else {
    command("bow");
    //set_title(who,33);
    return RANK_D->query_respect(who) + "为我明教尽心尽力、军功赫赫。\n想坐教主，功劳点就要大于经验值的一半。";
  }

}

string ask_gonglao() {
  object ob, who = this_player();

  if (who->query("family/family_name") != "明教")
    return RANK_D->query_respect(who) + "和我明教素无瓜葛，何有此问啊？";

  if (!who->query("mingjiao/credit"))
    return RANK_D->query_respect(who) + "在我明教工作之中，已经积累功劳零点\n";
  else
    return RANK_D->query_respect(who) + "在我明教工作之中，已经积累功劳点" + chinese_number(who->query("mingjiao/credit")) + "。\n";
}
