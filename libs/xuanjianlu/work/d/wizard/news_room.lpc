// Room: /d/wizard/meeting_room.c

#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "新闻中心");
	set("long","这里是玄剑录的新闻中心。巫师可以在这里用信息公告系统发布
【玄剑录】最新泥潭信息。具体命令为：	
	addmsg；   增加一条新闻
	listmsg：  查看目前新闻内容
	delmsg：   删除某一条新闻
	"BRED+HIW"添加新闻完毕后，一定记得要update /adm/daemons/msgd.c\n" NOR
);

	set("exits", ([
  	"north" : __DIR__"edit_room" ]));

	set("valid_startroom", 1);
	set("no_fight", "1");
	set("no_clean_up", 0);
	set("cost", 0);
	set("objects", ([
		"/adm/daemons/msgd.lpc" : 1,
		]) );
	setup();

//	call_other("/clone/board/progress_b", "???");
//	replace_program(ROOM);
}
void init()
{
        object me = this_player();

        if (wizhood(me) == "(player)")
                me->move("/d/death/death.lpc");
}

