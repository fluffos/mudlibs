inherit ROOM;

void create()
{
        set("short", "巫师休息室");
        set("long", @LONG
这里就「玄剑录」巫师的休息所在。刚粉刷过的四周墙壁上挂着过往巫师是
的画像，分别有：中文、阿飞、人生、阴阳子、轩辕虹、阿陆、冰咖啡和寒月等
等。屋子的正中央放着一张楠木桌，上面摆着一本巫师留言簿(board)。从这里
可以飘去(qu)任何一位巫师的办公室。
LONG );

        set("exits", ([ /* sizeof() == 2 */
                 "down" : __DIR__"guest_room",
                 "up"   : __DIR__"meeting_room",
                 "west" : __DIR__"present_room",
                 "east" : __DIR__"edit_room",
                 "north" : __DIR__"move_room",
        ]));

        set("valid_startroom", 1);
        set("no_fight", "1");
        set("no_clean_up", 0);
        set("cost", 0);
        setup();

        call_other("/clone/board/wiz_b", "???");
}

void init()
{
        object me = this_player();

          add_action("do_goto",  "qu");

        if (wizhood(me) == "(player)")
                me->move("/d/death/death.lpc");
}

int do_goto(string arg)
{
        object me = this_player();
        string user;

        if( !arg || arg=="" ) return notify_fail("你想去谁的工作室？\n");

        if(arg=="oky") me->move("/u/oky/workroom");
        if(arg=="server") me->move("/u/server/workroom");
        if(arg=="xuanyuan") me->move("/u/xuanyuan/workroom");
        if(arg=="lbc") me->move("/u/lbc/workroom");
        if(arg=="afei") me->move("/u/afei/workroom");
        if(arg=="guanyu") me->move("/u/guanyu/workroom");
		if(arg=="hotjc") me->move("/u/hotjc/workroom");
        if(arg=="yangdong") me->move("/u/yangdong/workroom");
        if(arg=="firefox") me->move("/u/may/workroom");
		if(arg=="baozi") me->move("/u/may/workroom");
		if(arg=="dog") me->move("u/dog/workroom");
        if(arg=="may") me->move("/u/may/workroom");
		if(arg=="byf") me->move("/u/may/workroom");
		if(arg=="polybao") me->move("/u/may/workroom");
		if(arg=="may") me->move("/u/may/workroom");
		if(arg=="ygunq") me->move("/u/ygunq/workroom");
		if(arg=="leafrose") me->move("/u/leafrose/workroom");
		if(arg=="season") me->move("/u/season/workroom");
		if(arg=="chen") me->move("/u/chen/workroom");
		if(arg=="pjf") me->move("/u/pjf/workroom");
		if(arg=="yuj") me->move("/u/yuj/workroom");
		if(arg=="zhengn") me->move("/u/zhengn/workroom");
		if(arg=="xxuan") me->move("/u/xxuan/workroom");
        return 1;
}
