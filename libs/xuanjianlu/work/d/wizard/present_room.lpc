// Data: 发礼物房
// Created by oky at 2001/7/16

inherit ROOM;
#include <ansi.h>

void yyy(string arg);
string file;

void create() {
  set("short", "礼品房");
  set("long", @LONG
这里是空荡荡的一片，什么也没有放。但感到有种神的力量在这间房子左右
徘徊，一般巫师来到这里，都是来给玩家发礼品才来的(song)，表示巫师对玩家
一种感谢，感谢他们对本服务器的支持。
LONG
  );

  set("exits", ([
    "east": __DIR__ "wizard_room"
  ]));

  setup();
  call_other("/clone/board/pre_b", "???");
}

void init() {
  add_action("do_song", "song");
  add_action("do_sheding", "sheding");
}

int do_song() {
  object who = this_player();
  object present;
  if (wiz_level(who) < wiz_level("(wizard)"))
    return notify_fail("要(arch)及以上巫师执行。\n");
  if (!file) return notify_fail("请设定送啥(sheding <file>)\n");

  present = load_object(file);
  if (!present) return notify_fail("没有" + file + "这个东西。\n");

  write(present->query("name") + "(" + present->query("id") + ")给每个人，确定吗？[Y/N]\n");
  input_to((: yyy :));
  return 1;
}

void yyy(string arg) {
  object *allp = users();
  object present;
  int i;

  log_file("present", sprintf("%s  本次礼物%s，舒畅%s\n", ctime(time()), file
    , this_player()->query("id")));
  if (arg == "y" || arg == "Y") {
    for (i = 0; i < sizeof(allp); i++) {
      present = new(file);
      present->move(allp[i]);
      tell_object(allp[i], HIY "牛魔王发礼品喽！天上掉下个" NOR + present->query("name")
        +HIY "砸在你头上。\n" NOR);
      log_file("present", sprintf("%s(%s)get it.\n", allp[i]->query("name")
        , allp[i]->query("id")));
    }
  } else write("取消。\n");
}

int do_sheding(string arg) {
  object who = this_player();
  object present;
  if (wiz_level(who) < wiz_level("(wizard)"))
    return notify_fail("要(arch)及以上巫师执行。\n");

  if (!arg) return notify_fail("请设定送啥(sheding <file>)\n");

  present = load_object(arg);
  if (!present) return notify_fail("没有" + arg + "这个东西。\n");

  file = arg;
  write("ok\n");
  return 1;
}
