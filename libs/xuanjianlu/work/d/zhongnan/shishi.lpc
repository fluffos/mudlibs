//liu 2002

inherit ROOM;

void create() {
  set("short", "石室");

  set("long", @LONG
石室中放着五具石棺(guan)，其中两具石棺棺盖以密密盖着。据说放
的是历代前辈的遗体。另外三其的棺盖却只推上一半，也不知其中有无尸
体，怪吓人的。
LONG);

  set("item_desc", ([ "guan": "
这石棺半开半掩着，也不知有没有尸体在里面，也许可以钻进去看看(enter)。
\n", ]));

  set("exits", ([
    "east": __DIR__ "zoudao4",
    "down": __DIR__ "midao1",
  ]));
  set("cost", 1);
  setup();
}

void init() {
  add_action("do_enter", "enter");
}

int do_enter(string arg) {
  object me = this_player();
  if (!arg || arg == "") return 0;
  else if (arg == "guan") {
    if (me->query_temp("exit_blocked")) return notify_fail("你正忙着挡住别人的出路呢！\n");
    if (me->query("rided")) return notify_fail("骑着东西钻洞？！\n");
    if (me->is_busy() || me->is_fighting()) return notify_fail("你正忙着呢！\n");

    message("vision", me->name() + "打开棺材盖钻了进去。\n", environment(me), ({ me }));
    me->move("/d/zhongnan/guan");
    message("vision", me->name() + "从外面钻了进来。\n", environment(me), ({ me }));
  }
  return 1;
}
