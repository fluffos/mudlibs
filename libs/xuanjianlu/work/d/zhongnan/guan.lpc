//Cracked by Liu 2002
// room: guan.c

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "棺");
        set("long", @LONG
石棺内一片漆黑。
LONG );

        set("exits", ([
                "out" : __DIR__"shishi",
        ]));

        setup();
}

void init()
{
        add_action("do_use", "use");
}

int do_use(string arg)
{
	object me = this_player();
       
	if( !arg || arg=="" || !present("fire", me))  return 0;
	if( arg=="fire" ) {
		write("\n你点燃了火折，忽然见到棺盖内侧似乎写得有字，凝目瞧去，果见是十六个大字：\n");
        	remove_call_out("open");
		call_out("open", 2, this_object());
	}
	return 1;
}
void open(object room)
{
	write(HIG"\n    “玉女心经，技压全真。重阳一生，不弱于人。”\n"NOR);
	call_out("open1", 2, this_object());
}
void open1(object room)
{
	write("\n这十六个字以浓墨所书，笔力苍劲，字体甚大。\n");
	call_out("open2", 2, this_object());
}
void open2(object room)
{
        write("\n原来这具石棺也是王重阳留下的。棺底可以掀开。\n");
	call_out("open3", 2, this_object());
}
void open3(object room)
{
        write("\n你四下摸索，果然摸到个可容一手的凹处。\n\n");
	add_action("do_turn", "turn");
}
int do_turn(string arg)
{
	object me = this_player();
	if( !arg || arg=="" || arg!="left") write("于是你用力转动那凹处，却是纹丝不动。\n");
	else {
		write("\n于是你用力向左转动那凹处，只听“咯”的一生，似是机关动了。\n");

        	remove_call_out("open4");
        	call_out("open4", 2, this_object());
	}
	return 1;
}
void open4(object room)
{
	write("\n你大喜向上一提，只听喀喇一响，棺底石板应手而起。\n");
	call_out("down", 2, this_object());
}
void down(object room)
{
	write("\n下面是一排石级，石级尽处是条短短甬道，再转了个弯，果然走进了一间石室。\n\n");

        this_player()->move("/d/zhongnan/shishi2");
	return;
}