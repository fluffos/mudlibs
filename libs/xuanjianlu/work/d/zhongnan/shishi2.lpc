inherit ROOM;
#include <ansi.h>

void create()
{
        set("short", "石室");
        set("long",
"室中也无特异之处，抬头仰望，但见室顶密密麻麻的写满了字迹符号，
最右处写着四个大字：“"+HIB+"九阴真经"+NOR+"”(zhenjing)。室顶西南角绘着一幅图(map)，
与武功无关，倒像是幅地图，绘的是出墓的秘道。\n");

	set("item_desc",([
"zhenjing" : "
“全真武学，博大精深，玉女心经，何足道哉？
  重阳遗刻，九阴真经，古墓后人，有缘一见。”

原来林朝英死后，王重阳曾来过古墓吊祭故人，见到石室顶上留下的玉女心经，
竟把全真派所有的武功尽数破去。便在这石棺的盖底留字说道，林朝英所破去
的，不过是全真派的粗浅武功而已，但较之最上乘的全真功夫，玉女心经又何
足道哉？他本欲将全真正宗心法刻在旁边，但又恐日后本派武学落入邪派之手，
于是，刻《九阴真经》于此，希望古墓后人能够有缘得见，不过对付玉女心经
的法门，仅为《九阴真经》的一小部份而已。
\n",
"map" : "
                           古墓
                            ⊙
                     走道—走道—走道
                            ｜
                           走道  厨房
                            ｜    ｜
               石室—走道—大厅—走道
                +     ｜    ｜    ｜
                +    弟子  后堂 练功室—练功室
                +   休息室
               密道←密道←密道←密道←地下水道—地下水道→＜山洞＞
\n",
]));

	set("exits",([
			"up" : __DIR__"shishi",
	]));
	set("cost",1);
	setup();
}
void init()
{
        add_action("do_lingwu", "lingwu");
}
int do_lingwu(string arg)
{
	mapping skills, learned;
	object me;
	string skillname,skillarg;
	int skill_special, skill_basic, times, jing_cost;

	me = this_player();
	skills = me->query_skills();
	learned = me->query_learned();

	if( !arg ) return notify_fail("你要研究何种基本武技？\n");
	if( arg == "force" ) return notify_fail("你不能自行修炼基本内功！\n");
	if( me->is_busy()) return notify_fail("你现在正忙着呢。\n");
	if( me->is_fighting() ) return notify_fail("你已经在战斗中了，学一点实战经验吧。\n");

	if(sscanf(arg, "%s %d", skillarg, times)!=2 ) skillarg = arg;
	if(!times || times == 0) times = 1;

	if( !stringp(skillname = me->query_skill_mapped(skillarg)) )
		return notify_fail("你必须有特殊武功方能与基本武技参照领悟！\n");

        if( skillarg == "force" )
                return notify_fail("你不能自行修炼基本内功！\n");

	skill_basic = me->query_skill(skillarg, 1);
	skill_special = me->query_skill(skillname, 1);
	jing_cost = skill_basic/2;

	if( skill_special < 1 )
		return notify_fail("你对这方面的技能还是一窍不通，最好从先从基本学起。\n");
	if( skill_basic > skill_special )
		return notify_fail("你" + to_chinese(skillname) + "功力不够，无法继续领悟！\n");
	if( skill_basic < 1 )
		return notify_fail("你好像还没有学过这项基本技能吧？ 最好先去请教别人。\n");

	if ( me->query("jing") < 100 ) 
		return notify_fail("你现在精神不佳，无法定下心来思考！\n");
	if ( skill_basic < 150 )
		return notify_fail("你"+to_chinese(skillarg)+"太差，对重阳遗刻始终不得一解。\n");

	//added for times lingwu > jing_cost
	if ( me->query("jing") < jing_cost*times ) 
		return notify_fail("你现在精神不佳，无法定心领悟那么多次！\n");

	if( (int)me->query("potential") <= 1 )
		return notify_fail("你的潜能不足，无法领悟基本武功！\n");

	me->receive_damage("jing", jing_cost*times, "在古墓冥思苦想把脑袋给想破了，白白的脑浆流了一地");

	// modified by aln here to show the importance of max jing
        	skill_special = skill_special * me->query("max_jing") * 2 / (1000 + me->query("max_jing"));

	if(random(20) == 0) {
		me->add("potential", -2*(random(times))-2);
		me->improve_skill(skillarg, (skill_special + random(skill_special*2))*times);
		write( "九阴真经果然精妙，你只觉脑中豁然开朗，对" + to_chinese(skillarg) + "的领悟又进了一层！\n" );
	}
	else if(random(10) == 0) {
		me->add("potential", -1*(random(times))-1);
		me->improve_skill(skillarg, (skill_special/2 + random(skill_special/1))*times);
		write( "你细观重阳遗刻，冥思苦想，对" + to_chinese(skillarg) + "渐渐加深一层体会！\n" );
	}
	else if(random(5) == 0) {
		me->add("potential", -random(times));
		me->improve_skill(skillarg, (skill_special/4 + random(skill_special/2))*times);
		write( "你对照重阳遗刻，拿手比划着，似乎对" + to_chinese(skillarg) + "中的几个招数有所体会。\n" );
	}
	else if(random(2) == 0) {
		me->improve_skill(skillarg, (skill_special/8 + random(skill_special/4))*times);
		write( "你坐立不安，潜心苦思" + to_chinese(skillarg) + "上的难解之处。\n" );
	}
	else if(random(5) == 0) {
		write( "你心中说不出的烦燥，对" + to_chinese(skillarg) + "始终不得一解。\n" );
	}
	else if(random(10) == 0) {
		me->improve_skill(skillarg, - (skill_special/10 + random(skill_special/5))*random(times));
		write( "你只觉得体内真气乱窜，" + to_chinese(skillarg) + "中的招式象走马灯一般在面前显现！\n" );
	}
	else if(random(20) == 0) {
		me->improve_skill(skillarg, - (skill_special/6 + random(skill_special/3))*random(times));
		write( "你的大脑中一片空白。对" + to_chinese(skillarg) + "是越想越糊涂。\n" );
	}
	else {
		write( "你坐立不安，潜心苦思" + to_chinese(skillarg) + "上的难解之处。\n" );
	}

	if( learned[skillarg] < 0 ) { 
		skills[skillarg]--;
		learned[skillarg] += skills[skillarg] * skills[skillarg];
	}

	if( me->query("potential") < 0) me->set("potential", 0);
	return 1;

}
