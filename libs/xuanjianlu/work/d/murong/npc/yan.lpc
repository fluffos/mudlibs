// /u/chen/murong/npc/yan.c
// by chen

#include <ansi.h>
string ask_shui();
inherit NPC;

void create() {
  set_name("严妈妈", ({ "yan mama", "mam", "yan" }));
  set("gender", "女性");
  set("age", 50);
  set("title", "花肥房管事");
  set("str", 25);
  set("int", 26);
  set("con", 26);
  set("dex", 26);
  set("combat_exp", 50000);
  set("shen_type", 1);
  set("attitude", "peaceful");
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("no_get", "你没办法拿起这个人");
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 30);

  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);

  setup();
  carry_object("/d/murong/obj/cloth")->wear();
  carry_object("/clone/weapon/gangdao")->wield();
  set("inquiry", ([
    "name": "我是曼佗罗山庄的花房管事。\n",
    "here": "这里是花肥房，专门把夫人让处死的人做花肥。\n",
    "rumors": "最近一个姓段的小子从我手里跑了。\n",
    "打水": (: ask_shui :),

  ]));

  set("chat_chance", 5);
  set("chat_msg", ({
    "严妈妈哼了一声，说道：“再让我抓住那个姓段的小子，非把他做了花肥不可！！。”\n",

  }));

}

string ask_shui() {
  if (this_object()->is_busy())
    return RANK_D->query_respect(this_player()) + "想忙死我吗？\n";


  if (!(int)this_player()->query_temp("shui"))
    return "你还是问问别人吧！";
  if (!(int)present("blade", this_player()))
    return "没有喷壶，怎么加水！";
  else
    command("say 好吧！我这就给你办！\n");
  message_vision(" 严妈妈把$N的喷壶打满了水.\n", this_player());
  this_player()->delete_temp("shui");
  this_player()->delete_temp("hu");
  this_player()->set_temp("jiaohua", 1);
  this_player()->start_busy(3);
  this_object()->start_busy(3);
  return "好了，你可以去浇花了";
}
