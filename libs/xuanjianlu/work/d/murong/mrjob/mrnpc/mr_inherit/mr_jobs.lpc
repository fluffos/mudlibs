mapping query_name() {
  mapping a, b, c, d;
  string name, id;
  int j = random(10);

  a = name_1[random(sizeof(name_1))];
  b = name_2[random(sizeof(name_2))];

  name = a["name"] + b["name"];
  id = a["id"] + " " + b["id"];
  if (j > 3) {
    c = name_2[random(sizeof(name_2))];
    name += c["name"];
    id += c["id"];
  }
  d = ([ "name": name, "id": id, "xing": a["id"] ]);
  return d;
}

string msg(string msg) {
  switch (msg) {
    case "water":
      return water[random(sizeof(water))];
    case "patrol":
      return patrol[random(sizeof(patrol))];
    case "canvass":
      return canvass[random(sizeof(canvass))];
    case "revive":
      return revive[random(sizeof(revive))];
  }
}

mapping *jobs() { return joblist; }

string *file_name() { return file_path; }

mapping query_city() { return area[random(sizeof(area))]; }
