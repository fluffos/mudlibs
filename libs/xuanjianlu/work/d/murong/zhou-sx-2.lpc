#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "小舟");
	set("long", @LONG
一叶小舟，最多也就能载七、八个人。船尾放着一根竹篙。
LONG
	);
	set("exits",([
		"out"  :  __DIR__"anbian",
	]));
        set("no_fight",1);

	setup();
}
void init()
{
//  mapping fam;
    object me;
       me=this_player();
//     room=this_object();
       message_vision(
               YEL "\n船夫把小舟靠在岸边，快下船吧。\n\n"NOR,me);
}
