//by chen

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create() {
  set("short", "墓室");
  set("long", @long
这是一个墓室，也不知何人死后葬于此地，有一口棺材(guancai)放在墓室中央.
long);
  set("exits", ([
    "out": __DIR__ "fenmu",
  ]));
  set("item_desc", ([
    "guancai": "一口很大的棺材，你不有的想跳(jump)进去看看！\n",
  ]));

  set("no_fight", 1);
  setup();

}

void init() {
  add_action("do_jump", "jump");


}



string do_jump(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "guancai") return "你要干什么？\n";
  if (arg == "guancai") {
    message("vision", me->name() + "跳进棺材里面发现里面竟然是空的。\n",
      environment(me), ({ me }));
    message("vision", me->name() + "突然身影一闪，不见了。\n",
      environment(me), ({ me }));
    me->move(__DIR__ "midao-2");
    message("vision", me->name() + "从外面跳了进来。\n",
      environment(me), ({ me }));

    return "你掉到棺材里了!\n";
  }
}
