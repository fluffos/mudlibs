inherit ROOM;

void create()
{
        set("short","古墓");

        set("long",@LONG
这里是慕容氏的坟场, 慕容氏死后都要被安葬这里,世世代代, 
无一例外。每到清明时分, 慕容后裔都要在这里祭祖。场中一座新
坟格外引人住目, 那是慕容复之父慕容博之墓,前面是慕容复的墓碑(shi)。
LONG);

                  set("exits",([

                                //"enter" : __DIR__"zoudao1",
                                "east" : __DIR__"road",

                                                         ]));
        set("item_desc", ([
                "shi": "这是慕容复的墓碑！\n"
       ]));
          set("cost",1);
          set("outdoors", "murong");
          setup();
}

void init()
{
        add_action("do_move", "move");
                add_action("do_ketou", "ketou");
        if (!this_player()->query_temp("ketou_times"))
                this_player()->set_temp("ketou_times",
                1+random(this_player()->query_skill("force", 1)));

}


int do_move(string arg)
{
        object me=this_player();

        if( !arg || arg != "shi" ) {
                return notify_fail("你要移动什么？\n");
        }

        if((int)me->query_str()>33) //膂力大于33
                {
                message_vision("$N站在石前，双掌发力推动巨石，只听得巨石吱吱连声，\n",this_player());
                message_vision("缓缓向后移去，现出一道门户来。\n", this_player());
                set("exits/enter", __DIR__"mushi");
                remove_call_out("close");
                call_out("close", 5, this_object());
                }
        else
                message_vision("$N试着推了推巨石，巨石纹丝不动，只得罢了。\n", this_player());
        return 1;
}

void close(object room)
{
        message("vision","只见巨石又吱吱地回到原地。\n", room);
        room->delete("exits/enter");
}

int do_ketou()
{
        object me, ob;

        me = this_player();
                
        if (me->is_busy() || me->is_fighting())
                return notify_fail("你正忙着呢。\n");

/*        if ( me->query_temp("ketou_times") == 0 )
        {
                message_vision("$N磕头磕得晕了过去。\n", me);
                me->set_temp("ketou_times",
                        1+random(me->query_skill("force", 1)));
                me->unconcious();
                return 1;
        }
*/
        me->add_temp("ketou_times", -1);        

        message_vision("$N虔诚地跪下来，在墓碑面前磕头。\n", me);

 if ( random (10) == 5 
        && !present("force book", me)
        && query("book_count") >= 1)
        {
                add("book_count", -1);
 ob=new(__DIR__"obj/neigong-book");
  ob->move(this_object());
                tell_object(me, "HIM突然啪地一声掉下一本内功心法！NOR\n");
        }

        if ( (int)me->query("jing")<0) {
                 write("你太累了，歇会再磕头吧！\n");              
                 return 1;
        }
        if ((int)me->query_skill("force", 1) >= 170 
        && (int)me->query_skill("force", 1) <= 101 
        && present("force book", me) )
        {        
                me->receive_damage("jing", 20);
                me->improve_skill("force", me->query("int"));
                if ( random(5) == 0 )
tell_object(me, "冥冥之中，你似乎觉得解决了你在内功方面的疑难。\n");
        }

        return 1;
}
