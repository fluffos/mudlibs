// liu 2001,9
// d/quanzhou/sea.c

#include <room.h>
#include <ansi.h>

inherit ROOM;

int billow();
private int billow_result(object victim);

void create()
{
	set("short", HIC"海"NOR);
	set("long", @LONG
茫茫然一望无际的碧蓝，潮汐汹涌澎湃，这里是海。
LONG);

	set("exits", ([ ]));

	set("outdoors", "quanzhou");
	set("cost", 1);
	set("insea", 1);
	setup();
}

void init()
{
	add_action("do_smack", "smack");
	add_action("do_smack", "pai");
	add_action("do_climb", "climb");
	add_action("do_practice", "lian");
	add_action("do_practice", "practice");
	remove_call_out("billow");
	call_out("billow",3 + random(3) );
}

int do_climb(string arg)
{
        object me = this_player();

        if ( !arg || arg != "up" )
		return notify_fail("什么？\n");

	if(me->is_busy())
		return notify_fail("你还在忙着呢。\n");

	message_vision("\n$N纵身一跃，抓住崖壁。$N连蹬数次，终于爬了上来。\n\n",me);
	me->add("jingli",-random(300));
	me->move("/d/quanzhou/seaside");
	return 1;
}

int do_practice(string arg)
{

        object me = this_player();
	string skillarg, skillname, skillzhao, multiple;
	int times, skill, skill_basic, qi;

	seteuid(getuid());

	if (me->is_busy())
                return notify_fail("你现在正忙着呢。\n");

	if( me->is_fighting() )
		return notify_fail("你已经在战斗中了，学一点实战经验吧。\n");

	if(!me->query("married_times")) 
		return notify_fail("你还没有所爱的人，不能领会其中的精要！\n");

	if (me->query("gender") != "男性") 
                return notify_fail("你体会不到男人思念一个人的心情。\n");

	if( me->query_skill_mapped("force") != "yunu-xinjing" )
		return notify_fail("你所用的并非玉女心经，无法练习黯然消魂掌！\n");

	if( me->query_skill_mapped("strike") != "xiaohun-zhang" )
		return notify_fail("不炼消魂掌跑这来干吗？！\n");

	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练黯然消魂掌必须空手。\n");

	if ((int)me->query("max_neili") < 2000)
		return notify_fail("你现在的内力太弱，无法练黯然消魂掌。\n");

	if ((int)me->query_str()< 33)
		return notify_fail("你现在的臂力太弱，无法练黯然消魂掌。\n");	

	if (me->query_skill("xiaohun-zhang",1) < 80)
		return notify_fail("你黯然消魂掌火候不足，不能在此修炼。\n");	

	if ((int)me->query("qi") < 200)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够练黯然消魂掌。\n");

	if( arg !="strike" )
		return notify_fail("不炼消魂掌跑这来干吗？\n");

	if( !arg ) return (__DIR__"enable")->main(me, arg);

	if(sscanf(arg, "%s %d", skillarg, times)!=2 )
	        skillarg = arg;
	
	if( skillarg != "strike" ) return notify_fail("什么？\n");

	if(!times || times == 0) {
		times = 1;
		multiple="";
	}
	else	multiple="反复";
	
	if(!stringp(skillname = me->query_skill_mapped(skillarg)) )
		return notify_fail("你只能练习用 enable 指定的特殊技能。\n");

	skill_basic = me->query_skill(skillarg, 1);
	skill = me->query_skill(skillname, 1);

	if( skill < 1 )
		return notify_fail("你好像还没有学过这项技能吧？最好先去请教别人。\n");
	if( skill_basic < 1 )
		return notify_fail("你对这方面的技能还是一窍不通，最好从先从基本学起。\n");
	if( skill_basic/2 <= skill/3 )
		return notify_fail("你的基本功火候未到，必须先打好基础才能继续提高。\n");

	notify_fail("你现在不能练习这项技能。\n");
	if( !SKILL_D(skillname)->valid_learn(me) ) return 0;

	notify_fail("你试着练习" + to_chinese(skillname) + "，但是并没有任何进步。\n");
	
	if(times < 0 ) return notify_fail("你要练多少？！\n");
	
	for(times; times > 0; times--) {
		if( SKILL_D(skillname)->practice_skill(me) )
			me->improve_skill(skillname, skill_basic/3+1, skill_basic > skill? 0: 1);
		else return 0;
	}

	if(skillzhao = SKILL_D(skillname)->query_skill_name(me->query_skill(skillname, 1))) {
		message_vision( HIG"$N" + multiple + "练习著" + to_chinese(skillname) + "中的" 
				+ skillzhao + "这一招，看来有些进步。\n"NOR, me);
	} 
	else {
		message_vision( HIG"$N" + multiple + "练习著" + to_chinese(skillname) + "，看来有些进步。\n"NOR, me);
	}

	return 1;
}

int billow()
{
	object *inv = all_inventory(find_object("d/quanzhou/sea"));
	object ob, me= this_player();
	int i;

	if( !this_player() ) return 1;
	if(!environment(this_player())) return 1;
	if( base_name(environment(this_player())) != "/d/quanzhou/sea") return 1;

	message_vision( BLU"\n突然一股狂风涌起数仗高的海浪打来，$N被带得内息翻涌澎湃。\n"NOR, this_player() );

	for ( i=0 ; i < sizeof(inv); i++)
	{
		if ( (string)inv[i]->query("race") == "人类" )
		{
			billow_result(inv[i]);
		}
	}

	remove_call_out("billow");
	call_out( "billow",3 + random(3) );
	return 1;
}

private int billow_result(object victim)
{
	string str, dodge_skill;
	int ap, dp, damage;

	ap = victim->query_dex()+victim->query_str();
	dp = victim->query_dex();
	ap *= victim->query("combat_exp")/1000;
	dp *= victim->query("combat_exp")/1000;
	ap = random(ap);

	if ( ap > dp)
	{
		message_vision(CYN"\n$N稍感力不从心，一个浪头便把$N排入海中。\n"NOR, victim);
		victim->receive_wound("qi", random(10), "被巨浪拍死了！");
		victim->receive_damage("qi", random(10), "被巨浪拍死了！");
	}
	else if ( ap < dp/7 && victim->query("race") == "人类")
	{
		message_vision(CYN"\n$N摧动真气又是一掌，才把浪头打了回去。\n\n"NOR, victim);
	}

	else
	{

		dodge_skill = victim->query_skill_mapped("dodge");
		if( !dodge_skill ) dodge_skill = "dodge";

		message_vision(CYN"\n$N纵身一跃，正好跳过巨浪。\n"NOR, victim);
	}

	if( victim->query_skill("strike",1) < 300 ) victim->improve_skill( "strike",victim->query("con") );

	return 1;
}

int do_smack(string arg)
{
        if ( !arg || arg != "billow" && arg != "lang")
		return notify_fail("你要拍什么？\n");

	message_vision( WHT"\n$N双掌合十，摧动真气向具浪拍去！\n"NOR, this_player());
	this_player()->add("neili", -random(5));
	remove_call_out("billow");
	call_out("billow",1);

	return 1;
}
