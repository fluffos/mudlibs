// liu 2001,9
// d/quanzhou/seaside.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "海滨绝壁");
  set("long", @LONG
海滨尽处竖一绝壁，左右森林环抱碧绿繁盛，壁下金沙连蔚海层次鲜明
海潮阵阵，虽是澎湃但也在那些须起伏处听出一丝淡然，壁旁孤立一座小亭，
亭内挂着一副对联 (duilian)，似是江淹「别赋」中的惨句。
LONG);

  set("exits", ([
    "northwest": __DIR__ "gushao",
  ]));

  set("item_desc", ([
    "duilian": " \n
	※※※※※	※※※※※
	※	※	※	※
	※  黯  ※  	※  唯  ※
	※	※	※	※
	※  然	※	※  别  ※
	※	※	※	※
	※  销	※	※  而  ※
	※	※	※	※
	※  魂	※	※  已  ※
	※	※	※	※
	※  者	※	※  矣  ※
	※      ※	※	※
	※※※※※	※※※※※
						\n",
  ]));

  set("outdoors", "quanzhou");
  set("cost", 1);
  setup();
}
void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object me = this_player();

  if (!arg || arg != "down")
    return notify_fail("什么？\n");

  if (me->query_skill("dodge") < 150)
    return notify_fail("你的轻功不够纯熟，跳下去就是找死。\n");

  message_vision("\n$N把心一横，纵身跳下悬崖。\n\n", me);

  tell_object(me, "只听得嗵的一声，你跌入海面，巨大的压力差点令你失去知觉。\n");
  me->move("/d/quanzhou/sea");
  me->add("qi", -random(300));
  return 1;
}
