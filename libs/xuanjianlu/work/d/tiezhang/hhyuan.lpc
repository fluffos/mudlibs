inherit ROOM;

void create() {
  set("short", "后花园");
  set("long", @LONG
这是一处环境优雅的花园。只见乔松修竹，苍翠蔽天，层峦奇岫，静窈幽深。
西面有一座假山，东面是大片的花圃。北面是通往山上的平台。
LONG);
  set("exits", ([
    "northup": __DIR__ "pingtai",
    "south": __DIR__ "hxfang",
    "west": __DIR__ "jiashan",
    "east": __DIR__ "huapu",
  ]));
  set("outdoors", "tiezhang");
  setup();
}
