//qqzhang.c 裘千丈
//team job first stage
//liu 2002

#include <ansi.h>
inherit NPC;
#include "/d/REGIONS.h"

int ask_join();
string ask_job();
string ask_over();
string ask_tz();

void create() {
  set_name("裘千丈", ({ "qiu qianzhang", "qiu", "qianzhang", "zhang" }));
  set("long",
    "他是一个白须老头，身穿黄葛短衫，足穿麻鞋，右手挥着一把大蒲扇。\n"
    "他满脸的油滑无赖的表情。\n");
  set("gender", "男性");
  set("age", 60);
  set("attitude", "friendly");
  set("shen_type", -1);
  set("str", 23);
  set("int", 30);
  set("con", 26);
  set("dex", 25);
  set("env/wimpy", 70);
  set("fam", "铁掌帮");
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 80);
  set("combat_exp", 1000000);
  set("score", 40000);

  set_skill("force", 160);
  set_skill("dodge", 160);
  set_skill("strike", 160);
  set_skill("parry", 160);
  set_skill("literate", 160);
  set_skill("tie-zhang", 160);
  set_skill("ding-force", 160);
  set_skill("shuishangpiao", 160);

  map_skill("force", "ding-force");
  map_skill("strike", "tie-zhang");
  map_skill("parry", "tie-zhang");
  map_skill("dodge", "shuishangpiao");
  prepare_skill("strike", "tie-zhang");

  create_family("铁掌帮", 14, "弟子");

  set("inquiry", ([
    "name": "记得先父曾给我起过一个名，叫甚么‘千丈’。我念着不好听，也就难得用它。\n",
    "here": "这里就是铁掌帮的总坛所在，你如没事，不要四处乱走，免招杀身之祸！！！\n",
    "上官剑南": "他是铁掌帮的第十三代帮主，也是我的师傅。\n",
    "裘千仞": "他早不干了，现在和一灯在一起，还有个法名，叫“慈恩”\n",
    "tiezhang": (: ask_tz :),
    "铁掌": (: ask_tz :),
    "job": (: ask_job :),
    "工作": (: ask_job :),
    "over": (: ask_over :),
    "结束": (: ask_over :)
  ]));
  setup();
}

string ask_tz() {
  if (this_player()->query("tiezhang_num") < 100 || this_player()->query_skill("tie-zhang") >= 1) {
    if (random(2) == 1) return "论威猛，铁掌虽不及降龙十八掌，可是掌法精奇巧妙，犹在降龙十八掌之上。";
    else return "铁掌帮自开山建帮，数百年来扬威中原，靠的就是这套铁掌掌法。";
  } else {
    this_player()->set_skill("tie-zhang", 1);
    tell_object(this_player(), HIC "你的铁掌进步了！\n" NOR);
    return "好了，既然" + RANK_D->query_respect(this_player()) + "问起，在下自然传授。";
  }
}

int accept_fight(object me) {
  command("say " + RANK_D->query_respect(me) + "怕是活腻了，来来来，让爷爷教训教训你！！\n");
  command("say 啊哟，糟糕，糟糕，这会儿当真不凑巧！你等一会，我肚子痛，要出恭！\n");
  return 0;
}

string ask_job() {
  string *place_list = ({
    "/d/changbai/longmf",
    "/d/changbai/beicheng",
    "/d/beijing/zijin/qianqingmen",
    "/d/beijing/beihai/baita",
    "/d/beijing/deshengmen",
    "/d/beijing/tianqiao",
    "/d/shaolin/wuchang",
    "/d/shaolin/hanshui2",
    "/d/heimuya/zongtan",
    "/d/heimuya/center",
    "/d/songshan/songyueta",
    "/d/huanghe/huanghebang2",
    "/d/taishan/nantian",
    "/d/village/eexit",
    "/d/xixia/center",
    "/d/city/guangchang",
    "/d/qilian/zibai",
    "/d/lingjiu/dating",
    "/d/xingxiu/xxroad6",
    "/d/baituo/lingshege",
    "/d/xueshan/zoulang",
    "/d/chengdu/center",
    "/d/emei/jinding",
    "/d/emei/huayanding",
    "/d/dali/minov89",
    "/d/dali/minov53",
    "/d/dali/minov71",
    "/d/dali/minov17",
    "/d/wudang/chaotian",
    "/d/zhongnan/haodian",
    "/d/zhongnan/dajiaochang",
    "/d/jiaxing/nanhu",
    "/d/hangzhou/gushan1",
    "/d/hangzhou/kedian",
    "/d/quanzhou/zhongxin",
    "/d/quanzhou/tumen",
    "/d/foshan/street1",
    "/d/hengshan/square",
    "/d/huashan/yunu",
  });
  object me = this_player(), killer, *t = me->query_team();
  object place = load_object(place_list[random(sizeof(place_list))]);
  int room = me->query("team/room"), room_reg = me->query("team/room_reg");
  string region;

  if (strsrch(
    file_name(place),
    "/d/"
  ) != 0 || undefinedp(region = region_names[explode(file_name(place), "/")[1]]))
    region = "";

  if (!place) return "bug! post to liu!";

  if (base_name(environment(me)) != "/d/tiezhang/wztang") {
    command("en");
    move("d/tiezhang/wztang");
    message_vision("裘千丈一甩袖子走了。\n", me);
    return "\n";
  }

  if (me->query("combat_exp", 1) < 100000)
    return RANK_D->query_respect(me) + "此等修，为敢也此来充数？！";

  if (!pointerp(t = me->query_team()))
    return "一个人无法完成，" + RANK_D->query_respect(me) + "还是找些同伴来吧！";

  if (me->query_temp("team_asked"))
    return RANK_D->query_respect(me) + "能忙得过来嘛？！速去" + room_reg + room->query("short") + CYN "。";

  if (me->query_condition("team"))
    return "多谢" + RANK_D->query_respect(me) + "，不过还是先歇一会再说吧。";

  //	if( me->query("team/obj_num",1) > 9 )
  //		return "此等小事无须劳师动众，"+me->query("team/name")+"带去的人手已经够了！";

  if (!me->is_team_leader() && me->query("team/id")) {
    if (me->query("shen", 1) > 0) killer = new("/d/tiezhang/npc/npcv");
    else killer = new("/d/tiezhang/npc/npcr");
    killer->set("team/id", me->query("team/id"));
    killer->move(room);

    me->set_temp("team_asked", 1);

    return "好，就随" + me->query("team/name") + "同去" + room_reg + room->query("short") + CYN "，万事谨慎！";
  } else if (me->is_team_leader()) {
    if (me->query("shen", 1) > 0) killer = new("/d/tiezhang/npc/npcv");
    else killer = new("/d/tiezhang/npc/npcr");
    killer->set("team/id", me->query("id"));
    killer->move(place);

    me->set_temp("team_asked", 1);

    t->set("team/name", me->query("name"));
    t->set("team/id", me->query("id"));
    t->set("team/room", place);
    t->set("team/room_reg", region);

    command("consider");
    return "最近江湖上有几个好事之徒，" + RANK_D->query_self_rude(this_object()) + "实在看不过！据查他们正在" + region + place->query("short") + CYN "一带活动，你等务必将其铲除！";

  } else return "叫你的头人前来答话！";
}

string ask_over() {
  object me = this_player();
  object *t = me->query_team();

  if (!me->query("team")) return "你又没有任务，结束什么？";

  command("consider");

  if (!me->is_team_leader()) {
    me->delete("team");
    me->delete_temp("team_asked");
    me->apply_condition("team", 10);
  } else {
    if (t->query("team")) {
      t->delete("team");
      t->delete_temp("team_asked");
      t->apply_condition("team", 10);
    }
  }
  return "好吧，" + RANK_D->query_respect(me) + "辛苦了。";
}
