int auto_perform() {
  object me = this_object();
  object target = me->select_opponent();
  object weapon = me->query_temp("weapon");
  int li = me->query_skill("force") / 4, jin = me->query("max_jingli") / 40;

  if (query(
    "qi",
    1
  ) < 10 || query("jing", 1) < 10 || query("jingli", 1) < 10 || query("neili", 1) < 10 || is_busy())
    return 1;

  if (query("qi", 1) < query("eff_qi") * 2 / 3) command("yun recover");
  if (query("jingli", 1) < query("eff_jingli") * 2 / 3) command("yun refresh");
  if (query("jing", 1) < query("eff_jing") * 2 / 3) command("yun regenerate");

  if (!living(target) || target->is_ghost()) { command("hehe"); command("halt"); }

  switch (query("family/family_name")) {

    case "白驼山":
      set("jiali", li);
      if (!query_temp("powerup")) command("yun powerup");
      else if (!query_temp("reverse")) command("yun reverse");
      else if (objectp(weapon)) command("perform shoot " + target->query("id"));
      else if (query_skill_prepared("strike") == "hamagong") command("perform puji");
      else if (!query_temp("baituo/lingshe")) command("perform lingshe");
      else command("perform cuff");
      set("jiali", 0);
      break;
    case "星宿派":
      set("jiali", li);
      set("jiajin", jin);
      set("tianshan", 1);
      if (!query_temp("hua")) command("yun hua");
      if (objectp(weapon)) command("perform pifeng");
      else if (!target->query_temp("huagong")) command("perform sanyin");
      else command("perform yiji");
      set("jiali", 0);
      set("jiajin", 1);
      break;
    case "雪山派":
      set("jiali", li);
      set("jiajin", jin);
      if (!query_temp("longxiang")) command("yun longxiang");
      else if (objectp(weapon)) {
        if (query_skill_mapped("parry") == "mingwang-jian") command("perform shenzhou");
        if (query_skill_mapped("parry") == "riyue-lun") command("perform riyue");
        if (query_skill_mapped("parry") == "jingang-chu") {
          if (random(3) != 1) command("perform wushang");
          else command("perform feichu");
        }
        if (query_skill_mapped("parry") == "xue-dao") command("perform shendao");
      } else if (query_skill_prepared("hand") == "dashou-yin") {
        if (!query_temp("xunlei")) command("perform xunlei");
        else command("perform yin");
      } else command("perform fen");
      set("jiali", 0);
      break;
    case "桃花岛":
      set("jiali", li);
      set("jiajin", jin);
      set("th_jianyi", 30 + random(30));
      if (!query_temp("wuzhuan")) command("yun wuzhuan");
      if (objectp(weapon)) {
        if (objectp(target->query_temp("weapon"))) command("perform jinglei");
        else if (random(3) == 1) command("perform jianzhi");
        else command("perform jianmang");
      } else if (query_skill_mapped("parry") == "tanzhi-shentong") {
        if (!query_temp("luoying_lanhua")) command("perform luoying");
        else command("perform jinglei");
      } else {
        if (!target->query_temp("taohua_huaixin")) command("perform huaixin");
        else if (random(3) != 2) command("perform bibo");
        else command("perform kuangfeng");
      }
      set("jiali", 0);
      set("jiajin", 1);
      break;
    case "灵鹫宫":
      set("jiali", li);
      if (!query_temp("powerup")) command("yun powerup");
      if (objectp(weapon)) {
        if (query_skill_mapped("parry") == "ruyi-dao") command("perform lianhuan");
        else command("perform san");
      } else if (query_skill_mapped("parry") == "youming-guizhao") {
        if (!query_temp("lingjiu/youming")) command("perform youming");
        else command("perform guizhao");
      } else {
        if (!query_temp("lingjiu/baihong")) command("perform baihong");
        else if (objectp(target->query_temp("weapon"))) command("perform zhemei");
        else command("perform hanmei");
      }
      set("jiali", 0);
      set("jiajin", 1);
      break;
    case "华山派":
      set("jiali", li);
      if (!query_temp("zixia")) command("yun zixia");
      if (objectp(weapon)) {
        if (!target->query_temp("know_kuangfeng")) command("perform kuangfeng");
        else if (random(3) == 2) command("perform san");
        else if (random(3) == 0) command("perform feilong");
        else command("perform jianzhang");
      } else command("perform wuji");
      set("jiali", 0);
      set("jiajin", 1);
      break;
    case "古墓派":
      set("jiali", li);
      set("jiajin", jin);
      set("double_attack", 1);
      set("gumu/youju", 1);
      if (objectp(weapon)) {
        if (!query_temp("suxin")) command("perform suxin");
        else command("perform hubo");
      } else if (target->is_busy()) command("perform youju");
      else command("perform luowang");
      set("jiali", 0);
      set("jiajin", 1);
      break;
    case "姑苏慕容":
      if (objectp(weapon)) {
        if (query_skill_mapped("parry") == "murong-daofa") command("perform baijia");
        else if (!query_temp("murong/lianhuan")) command("perform lianhuan");
        else command("perform xingbao");
      } else if (target->is_busy()) command("perform zhen");
      else if (random(3) != 1) command("perform canshang");
      else command("perform shedou");
      set("jiali", 0);
      set("jiajin", 1);
      break;
    case "日月神教":
      set("canuse_guimei", 1);
      set("canuse_cixin", 1);
      if (!query_temp("pixie/guimei")) command("perform guimei");
      if (objectp(weapon)) {
        if (!target->query_temp("pixie/cimu") && random(3) == 1) command("perform cimu");
        else if (!target->query_temp("pixie/ciwan")) command("perform ciwan");
        else if (!target->query_temp("pixie/cizu")) command("perform cizu");
        else command("perform cixin");
      } else if (random(5) == 0) command("perform tuxi " + target->query("id"));
      else set("jiali", li * 2);
      break;
    default:
      return 0;
  }
}

int accept_fight(object victim) {
  object me = this_object();
  if (!living(me)) return 1;
  set_hp();
  command("say 好好好，" + RANK_D->query_self_rude(me) + "今日就成全你！");
  me->kill_ob(victim);
  return 1;
}

int accept_kill(object victim) {
  object me = this_object();
  if (!living(me)) return 1;
  set_hp();
  command("say 哈哈哈！" + RANK_D->query_rude(victim) + "，是你自己找死可怪不得别人！");
  me->kill_ob(victim);
  return 1;
}

void die() {
  mixed killer;
  int tiezhang_num, exp, pot;

  killer = query_temp("last_damage_from");
  if (stringp(killer)) killer = (object)find_player((string)killer);
  if (objectp(killer)) {
    if (killer->query("team/id") == query("team/id")
      && killer->query_temp("team_asked")) {
      tiezhang_num = killer->query("tiezhang_num");
      killer->set("tiezhang_num", tiezhang_num + 1);
      exp = query("combat_exp", 1) / 10000;
      pot = query_skill("literate", 1) / 2;
      if (exp < 400) exp = 400;
      if (exp > 1500) exp = 1500;
      if (pot < 150) pot = 150;
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      if (killer->query("potential", 1) > killer->query("max_potential", 1))
        killer->set("potential", killer->query("max_potential", 1));
      tell_object(killer, HIC "\n你隐隐感到实战经验与浅能都增加了！\n" NOR);
    } else tell_object(killer, CYN "\n……想不到……我竟……命丧……你手……\n" NOR);
  }
  ::die();
}

int random_move() {
  mapping exits, doors;
  string *dirs, dir;
  object me = this_object();

  if (is_fighting() || is_busy() || !living(me))
    return 0;

  if (!me->query("steps")) {
    remove_call_out("destroying");
    call_out("destroying", 1200, me);
  }

  if (me->query("steps") >= 120) {
    remove_call_out("destroying");
    call_out("destroying", 1, me);
    return 0;
  }

  me->add("steps", 1);

  if (!objectp(environment())
    || !mapp(exits = environment()->query("exits"))
    || query("jingli") < query("max_jingli") / 2)
    return 0;

  dirs = keys(exits);

  if (this_object()->query("race") == "人类"
    && mapp(doors = environment()->query_doors()))
    dirs += keys(doors);

  if (sizeof(dirs) == 0) return 0;
  dir = dirs[random(sizeof(dirs))];

  if (mapp(doors) && !undefinedp(doors[dir])
    && (doors[dir]["status"] & DOOR_CLOSED))
    command("open " + dir);

  command("go " + dir);
  return 1;
}

void destroying(object me) {
  message_vision("$N看了看周遭，若无其事地离开了。\n", me);
  destruct(me);
  return;
}
