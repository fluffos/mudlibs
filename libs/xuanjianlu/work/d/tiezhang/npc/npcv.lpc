//Cracked by Liu
//vice_npc.c 2002
//NPC for tiezhang team job
//白驼山 星宿派 雪山派 桃花岛 灵鹫宫 古墓派 姑苏慕容 日月神教

#include <ansi.h>
#include <room.h>

inherit NPC;
int auto_perform();
void set_hp();
void setskills(int limit);
string ask_class();
void create() {
  set_name("邪派弟子", ({ "dizi" }));
  set("gender", "女性");

  switch (random(8)) {
    case 1:
      set("class", "baituo");
      set("family/family_name", "白驼山");
      break;
    case 2:
      set("class", "xingxiu");
      set("family/family_name", "星宿派");
      break;
    case 3:
      set("gender", "男性");
      set("class", "lama");
      set("family/family_name", "雪山派");
      break;
    case 4:
      set("class", "taohua");
      set("death_times", 300);
      set("family/family_name", "桃花岛");
      break;
    case 5:
      set("class", "dancer");
      set("family/family_name", "灵鹫宫");
      break;
    case 6:
      set("class", "swordsman");
      set("family/family_name", "古墓派");
      break;
    case 7:
      set("class", "murong");
      set("family/family_name", "姑苏慕容");
      break;
    default:
      set("gender", "无性");
      set("class", "eunach");
      set("family/family_name", "日月神教");
      break;
  }

  set("age", 60);
  set("str", 20);
  set("con", 30);
  set("int", 20);
  set("dex", 20);

  set("attitude", "peaceful");
  set("combat_exp", 1000000);

  set("chat_chance", 20);
  set("chat_msg", ({ (: random_move :) }));

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({ (: auto_perform :) }));

  set("inquiry", ([
    "class": (: ask_class :),
    "门派": (: ask_class :)
  ]));

  setup();
  carry_object("/clone/armor/tiejia")->wear();
}

string ask_class() {
  object me = this_player();
  if (query("team/id") == me->query("team/id") && me->query_temp("team_asked"))
    return RANK_D->query_self_rude(this_object()) + "师出" + query("family/family_name") + "，" + RANK_D->query_respect(me) + "有何指教？";
  else return RANK_D->query_self_rude(this_object()) + "与" + RANK_D->query_respect(me) + "毫无瓜葛，不说也罢！";
}

void init() {
  if (!userp(this_player())
    || this_player()->query("team/id") != query("team/id")) return;
  set_hp();
  return;
}

void set_hp() {
  mapping skill_status;
  int i, j, limit;
  string *skills;
  int pp = this_player()->query("combat_exp", 1), mp = query("combat_exp", 1);

  if (pp < (mp / 3) * 2) return;

  mp = (pp / 2) * 3;
  limit = (pow(mp * 10, 0.33333) + 1);
  set("combat_exp", mp);
  set("shen", -(mp / 3) * 2);

  if (!query("meetting")) setskills(limit);
  else {
    skill_status = query_skills();
    skills = keys(skill_status);
    j = sizeof(skill_status);
    for (i = 0; i < j; i++) {
      set_skill(skills[i], limit);
    }
  }

  set("max_neili", query_skill("force") * query("con") * 2 / 3);
  set("neili", query("max_neili"));
  set("eff_jingli", query_skill("force") * query("con") / 2);
  set("max_jingli", query("eff_jingli"));
  set("jingli", query("eff_jingli"));

  setup();

  set("eff_qi", query("max_qi"));
  set("qi", query("max_qi"));
  set("eff_jing", query("max_jing"));
  set("jing", query("max_jing"));
}

void setskills(int limit) {
  set_skill("force", limit);
  set_skill("dodge", limit);
  set_skill("parry", limit);
  set_skill("cuff", limit);
  set_skill("strike", limit);
  set_skill("kick", limit);
