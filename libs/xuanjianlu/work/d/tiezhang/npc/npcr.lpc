		set_skill("jiuyin-zhao",limit);
		set_skill("cuixin-zhang",limit);
		set_skill("emei-jian",limit);
		set_skill("mahayana",limit);
		set_skill("persuading",limit);

	        map_skill("force", "linji-zhuang");
	        map_skill("dodge", "zhutian-bu");
	        map_skill("claw", "jiuyin-zhao");
	        map_skill("finger", "tiangang-zhi");
	        map_skill("sword", "emei-jian");

		switch( random(6) )
