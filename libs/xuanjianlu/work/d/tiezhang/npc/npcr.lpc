//Cracked by Liu
//right_npc.c 2002
//NPC for tiezhang team job
//大理段家 少林派 "武当派 丐帮 华山派 峨嵋派 全真教

#include <ansi.h>
#include <room.h>

inherit NPC;
int auto_perform();
void set_hp();
void setskills(int limit);
string ask_class();
void create()
{
	set_name("正派弟子", ({ "dizi" }) );
	set("gender", "男性");

	switch( random(7) )
	{
		case 1:
			set("class", "dali");
			set("family/family_name","大理段家");
		break;
		case 2:
			set("class", "bonze");
			set("family/family_name","少林派");
		break;
		case 3:
			set("class", "taoist");
			set("family/family_name","武当派");
		break;
		case 4:
			set("class", "gaibang");
			set("death_times",300);
			set("family/family_name","丐帮");
		break;
		case 5:
			set("class", "huashan");
			set("family/family_name","华山派");
		break;
		case 6:
			set("gender", "女性");
			set("class", "bonze");
			set("family/family_name","峨嵋派");
		break;
		default:
			set("class", "taoist");
			set("family/family_name","全真教");
		break;
	}

	set("age", 60);
	set("str", 20);
	set("con", 30);
	set("int", 20);
	set("dex", 20);

	set("attitude", "peaceful");
	set("combat_exp", 1000000);

	set("chat_chance", 20);
	set("chat_msg", ({ (: random_move :) }) );

	set("chat_chance_combat", 100);
	set("chat_msg_combat", ({ (: auto_perform :) }) );

        set("inquiry", ([
            "class" : (: ask_class :),
            "门派" : (: ask_class :)
        ]));

	setup();
	carry_object("/clone/armor/tiejia")->wear();
}

string ask_class()
{
	object me = this_player();
	if(query("team/id")==me->query("team/id") && me->query_temp("team_asked"))
		return RANK_D->query_self(this_object()) + "师从" + query("family/family_name") + "，不知			" + RANK_D->query_respect(me) + "有何指教？";
	else return "我与"+ RANK_D->query_respect(me) +"并无瓜葛，恕" +RANK_D->query_self(this_object())+ "不便相告。";
}

void init()
{
	if ( !userp(this_player())
	|| this_player()->query("team/id") != query("team/id") )return;
	set_hp();
	return;
}

void set_hp()
{
	mapping skill_status;
	int i, j, limit;
	string *skills;
	int pp = this_player()->query("combat_exp",1), mp = query("combat_exp",1);

	if ( pp < (mp/3)*2 ) return;

	mp = (pp/2)*3;
	limit=(pow(mp*10,0.33333)+1);
	set("combat_exp",mp);
	set("shen",(mp/3)*2);

	if(!query("meetting")) setskills(limit);
	else {
		skill_status = query_skills();
		skills  = keys(skill_status);
		j = sizeof(skill_status);
		for(i=0; i<j; i++) {
			set_skill(skills[i], limit);
		}
	}

	set("max_neili",query_skill("force") * query("con") * 2 / 3 );
	set("neili",query("max_neili"));
	set("eff_jingli",query_skill("force") * query("con") / 2 );
	set("max_jingli",query("eff_jingli"));
	set("jingli",query("eff_jingli"));

	setup();

	set("eff_qi",query("max_qi"));
	set("qi",query("max_qi"));
	set("eff_jing",query("max_jing"));
	set("jing",query("max_jing"));
}

void setskills(int limit)
{
	set_skill("force",limit);
	set_skill("dodge",limit);
	set_skill("parry",limit);
	set_skill("cuff",limit);
	set_skill("strike",limit);
	set_skill("kick",limit);
	set_skill("claw",limit);
	set_skill("finger",limit);
	set_skill("hand",limit);
	set_skill("sword",limit);
	set_skill("stick",limit);
	set_skill("whip",limit);
	set_skill("literate",limit);

	if( query("family/family_name") == "大理段家" )
	{
		set_skill("kurong-changong",limit);
		set_skill("duanshi-shenfa",limit);
		set_skill("jinyu-quan",limit);
		set_skill("qingyan-zhang",limit);
		set_skill("liumai-shenjian",limit);
		set_skill("yiyang-zhi",limit);
		set_skill("duanjia-jian",limit);
		set_skill("buddhism",limit);

	        map_skill("force", "kurong-changong");
