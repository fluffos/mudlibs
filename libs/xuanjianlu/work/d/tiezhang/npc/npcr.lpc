		set_skill("riyue-bian",limit);
		set_skill("buddhism",limit);

	        map_skill("force", "hunyuan-yiqi");
	        map_skill("dodge", "shaolin-shenfa");
	        map_skill("cuff", "jingang-quan");
	        map_skill("claw", "longzhua-gong");
	        map_skill("hand", "qianye-shou");
