		set_skill("zhengqi-jue",limit);
		set("huashan/kuangfeng",1);
		set("huashan/feilong",1);

	        map_skill("force", "zixia-gong");
	        map_skill("dodge", "huashan-shenfa");
	        map_skill("cuff", "pishi-poyu");
