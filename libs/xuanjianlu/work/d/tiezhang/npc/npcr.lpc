	}
	set("meetting",1);
}

int auto_perform()
{
	object me = this_object();
	object target = me->select_opponent();
	object weapon = me->query_temp("weapon");
	int li=me->query_skill("force")/4,jin=me->query("max_jingli")/40;

        if( query("qi",1) < 10 || query("jing",1) < 10 || query("jingli",1) < 10 || query("neili",1) < 10 || is_busy() )
	return 1;

	if( query("qi",1) < query("eff_qi")*2/3 ) command("yun recover");
	if( query("jingli",1) < query("eff_jingli")*2/3 ) command("yun refresh");
	if( query("jing",1) < query("eff_jing")*2/3 ) command("yun regenerate");

	if( !living(target) || target->is_ghost() ) {command("sigh3");command("halt");}

	switch ( query("family/family_name") ) {

		case "大理段家" :
			set("jiali",li);
			if ( !query_temp("kurong") ) command("yun kurong");
			else if ( objectp(weapon) ) {
				if( !query_temp("yiyang") ) command("perform yiyang");
				else command("perform ailao");
			} else if ( query_skill_prepared("finger")=="liumai-shenjian") {
				if( !query_temp("start_6mai") ) command("perform liumai");
				else command("perform qiankun");
			} else if ( query_skill_prepared("finger")=="yiyang-zhi") {
				if( target->is_busy() ) command("perform sandie");
				else command("perform qiankun");
			} else command("perform wuluo");
			set("jiali",0);
			set("jiajin",1);
		break;
		case "少林派" :
			set("jiali",li/2);
			if(random(3)==2) command("yun jinzhongzhao");
			command("yun jingang");
			if(objectp(weapon) ) {
				if( target->is_busy()) command("perform xumi");
				else command("perform chanrao");
			} else if (query_skill_mapped("parry")=="longzhua-gong") {
				if( query_temp("qs_effect") ) command("perform lianhuan");
				else command("perform qianshou");
			} else {
				if( target->is_busy() ) command("perform jingmo");
				else if (random(3==2)) command("yun fumo");
				else command("perform san");
			}
			set("jiali",0);
			set("jiajin",1);
		break;
		case "武当派" :
			set("jiali",0);
			if ( !query_temp("taiji") ) command("yun taiji");
			else if ( objectp(weapon) ) {
				if( !target->is_busy() ) command("perform chan");
				else if(random(3)==2) command("perform shenmen");
				else if(query("eff_qi")>query("max_qi")/3) command("perform raozhi");
				else command("perform tongshou");
			} else if ( query_skill_prepared("hand")=="huzhua-juehu") {
				if( target->query_condition("juehu_damage") > 0 ) command("perform luanhuan");
				else command("perform juehu "+target->query("id"));
			} else {
				if( random(3)==2 ) command("perform huakai");
				else if (!query_temp("nian")) command("perform nian");
				else command("perform luanhuan");
			}
			set("jiali",0);
		break;
		case "全真教" :
			set("jiali",li);
			set("jiajin",jin);
			if ( objectp(weapon) && query_skill_mapped("parry")=="duanyun-bian") {
				if( random(3)==2 ) command("perform riyue");
				else if(random(3)==1) command("perform duanyun");
				else command("yun shentong");
			} else if ( objectp(weapon) && query_skill_mapped("parry")=="quanzhen-jian") {
				if( !query_temp("sanqing") ) command("perform sanqing");
				else if(!query_temp("quanzhen/zhuo")) command("perform zhuo");
				else if( random(2)==1 ) command("perform lianhuan");
				else command("yun shentong");
			} else {
				if( !query_temp("sanhua") ) command("perform sanhua");
				else if(random(3)==2) command("perform feishan");
				else if(random(3)==1) command("yun shentong");
				else command("perform juding");
			}
			set("jiali",0);
			set("jiajin",1);
		break;
		case "丐帮" :
			set("jiali",li);
			if (!query_temp("powerup")) command("yun powerup");
			if ( objectp(weapon) && !query_temp("shengang") ) command("yun shengang");
			if ( objectp(weapon) && query_skill_mapped("parry")=="dagou-bang" ) {
				if( objectp(target->query_temp("weapon") )) {
					if(random(5)==3) command("perform tiao");
					else if(random(5)==2) command("perform yin");
					else if(random(5)==1) command("perform duo");
					else if(random(5)==4) command("perform pi");
					else command("perform shansha");
				} else {
					if(random(5)==3) command("perform ban");
					else if(random(5)==2) command("perform chan");
					else if(random(5)==1) command("perform zhuan");
					else if(random(5)==4) command("perform feng");
					else command("perform chuo");
				}
			} else if ( objectp(weapon) && query_skill_mapped("parry")=="liuhe-dao") {
				if( random(4)==1 ) command("perform xiaoyao");
				else if( random(4)==2 ) command("perform lianhuan");
				else command("perform cross");
			} else if ( query_skill_mapped("parry")=="shexing-diaoshou") {
				if(!target->query_temp("gb_chanshen")) command("perform chanshen");
				else command("perform huixuan");
			} else {
				if (random(3)!=1) command("perform sanhui");
				else command("perform xianglong");
			}
			set("jiali",0);
			set("jiajin",1);
		break;
		case "华山派" :
			set("jiali",li);
			if (!query_temp("zixia")) command("yun zixia");
			if ( objectp(weapon) ) {
				if(!target->query_temp("know_kuangfeng")) command("perform kuangfeng");
				else if(random(3)==2) command("perform san");
				else if(random(3)==0) command("perform feilong");
				else command("perform jianzhang");
			} else command("perform wuji");
			set("jiali",0);
			set("jiajin",1);
		break;
		case "峨嵋派" :
			set("jiali",li);
			set("jiajin",jin);
			if ( !query_temp("linji/daxiao") ) command("yun daxiao");
			if ( !query_temp("linji/fengyun") ) command("yun fengyun");
			if ( !query_temp("linji/zhixin") ) command("yun zhixin");
			if ( objectp(weapon) ) {
				if(random(3)==2 ) command("perform mie");
				else if(random(3)==1) command("perform jue");
				else command("perform miejue");
			} else if ( query_skill_mapped("parry")=="jinding-zhang") {
				if( random(3)==2 ) command("perform pozhao");
				else command("perform piaoxue");
			} else command("perform shenzhua");
			set("jiali",0);
			set("jiajin",1);
		break;
	default:
		return 0;
	}
}

int accept_fight(object victim)
{
	object me = this_object();
	if (!living(me)) return 1;
	set_hp();
	command("say 在下就与"+RANK_D->query_respect(victim) +"切磋一二，献丑了！" );
	me->fight_ob(victim);
	return 1;
}

int accept_kill(object victim)
{
	object me = this_object();
	if (!living(me)) return 1;
	set_hp();
	command( "say 何必呢！"+RANK_D->query_respect(victim)+"，苦海无边，回头是岸！" );
	me->fight_ob(victim);
	return 1;
}

void die()
{
	mixed killer;
	int tiezhang_num, exp,pot;

	killer = query_temp("last_damage_from");
	if (stringp(killer)) killer = (object)find_player((string)killer);
	if (objectp(killer)) {
        if (killer->query("team/id") == query("team/id")
	&& killer->query_temp("team_asked")) {
		tiezhang_num = killer->query("tiezhang_num");
		killer->set("tiezhang_num", tiezhang_num+1);
		exp=query("combat_exp",1)/10000;
		pot=query_skill("literate",1)/2;
		if (exp<400) exp =400;
		if (exp>1500) exp =1500;
		if (pot<150) pot =150;
		killer->add("combat_exp",exp);
		killer->add("potential",pot);
		if(killer->query("potential",1) > killer->query("max_potential",1))
		killer->set("potential",killer->query("max_potential",1));
		tell_object(killer,HIC"\n你隐隐感到实战经验与浅能都增加了！\n"NOR);
		} else tell_object(killer,CYN"\n……想不到……我竟……命丧……你手……\n"NOR);
	}
	::die();
}

int random_move()
{
	mapping exits, doors;
	string *dirs, dir;
	object me=this_object();

	if (is_fighting() || is_busy() || !living(me))
	     return 0;

	if (!me->query("steps")) {
	     remove_call_out("destroying");
	     call_out("destroying",1500,me);
	}

	if (me->query("steps")>=300) {
	     remove_call_out("destroying");
	     call_out("destroying",1,me);
	     return 0;
	}

	me->add("steps",1);

	if (!objectp(environment()) 
	     || !mapp(exits = environment()->query("exits")) 
	|| query("jingli") < query("max_jingli") / 2 )
	     return 0;

	dirs = keys(exits);

	if (this_object()->query("race") == "人类"
	     && mapp(doors = environment()->query_doors()))
	     dirs += keys(doors);

	if (sizeof(dirs) == 0) return 0;
	dir = dirs[random(sizeof(dirs))];

	if (mapp(doors) && !undefinedp(doors[dir])
	     && (doors[dir]["status"] & DOOR_CLOSED) )
	     command("open " + dir);

	command("go " + dir);
	return 1;
}

void destroying(object me)
{
	message_vision("$N看了看周遭，若无其事地离开了。\n",me);
	destruct(me);
	return;
}
