// Room: pingtai.c

inherit ROOM;

void create() {
  set("short", "山间平台");
  set("long", @LONG
这里是山间的一块平地。山势在这里开始分支，矗立在面前的有五座高耸入
云的山峰，行似人的五指，“铁掌山”之名由此而得。五峰虽同处此山，但拇指
峰之雄伟，食指峰之险峻，中指峰之高耸，无名峰之奇丽，小指峰之秀美，则各
有特色，各擅胜场。在平台一侧的大石上，刻着一副地图。
LONG);

  set("exits", ([
    "westup": __DIR__ "shiban",
    "northeast": __DIR__ "shangu",
    "eastup": __DIR__ "suishi",
    "southdown": __DIR__ "hhyuan",
    "northwest": __DIR__ "huangcao",
    "northup": __DIR__ "sslin-1",
  ]));
  set("objects", ([
    __DIR__ "npc/hui": 3,
  ]));
  set("outdoors", "tiezhang");
  setup();
  replace_program(ROOM);
}
