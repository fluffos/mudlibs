void create() {
  set("short", "荒草路");
  set("long", @LONG
你走一条荒芜的小路上，两旁荒草齐膝，荆棘遍地，似乎罕有人至。山石壁
立，遮天蔽日，鸟兽全无，四周笼罩在一片阴暗之中，使这里看起来格外深隧幽
静。
LONG);
  set("exits", ([
    "southeast": __DIR__ "pingtai",
    "northup": __DIR__ "wmfeng",
  ]));
  set("outdoors", "tiezhang");
  setup();
