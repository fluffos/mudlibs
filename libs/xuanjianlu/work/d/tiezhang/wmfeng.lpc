// Room: mmfeng.c

#include <ansi.h>

inherit ROOM;

string look_bei();

void create()
{
	set("short", GRN"无名峰"NOR);
	set("long", @LONG
跨过路上的荆棘和荒草，你终于登上了无名峰的峰顶。由于这里地处五峰之
中，四周有其它山峰阻挡，因此风势很小，常年笼罩在一片云雾之中。峰顶长满
了齐腰的荒草，怪石嶙峋，一片荒凉景色。在峰顶的正中，赫然矗立着一座岩石
砌就的坟墓，坟墓的前面立着一块一人多高的花岗岩的墓碑(bei)。
LONG	);
	set("exits", ([
		"southdown" : __DIR__"huangcao",
]));

	set("item_desc",([
		"bei" : (: look_bei :),
]));
	set("outdoors", "tiezhang");
	setup();
}

string look_bei()
{
    return
    "\n"
 "*****************\n"
 "*           铁  *\n"
 "*           掌  *\n"
 "*           帮  *\n"
 "*       上  第  *\n"
 "*           十  *\n"
 "*       官  三  *\n"
 "*           代  *\n"
 "*       剑  帮  *\n"
 "*           主  *\n"
 "*   不  南      *\n"
 "*   肖          *\n"
 "*   弟          *\n"
 "*   子  之      *\n"
 "*   裘  墓      *\n"
 "*   千          *\n"
 "*   仞          *\n"
 "*   谨          *\n"
 "*   立          *\n"
 "*****************\n";
    "\n";
}
