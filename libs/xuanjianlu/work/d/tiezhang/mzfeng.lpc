// Room: mzfeng.c

inherit ROOM;

void create() {
  set("short", "拇指峰");
  set("long", @LONG
拇指峰是铁掌五峰中最为低矮的一峰，名为峰，实则只是一座较高的石山
罢了。峰顶到处是又大又圆的岩石，在日晒雨淋下，被风蚀得十分光滑。在岩
石的缝隙中，长出许多松树，其中一棵尤其引人注目。这棵松名为--并蒂松，
乃同根而生，于距地一米高处，忽分为二。这两根树干同粗同高，均长得高大
挺拔，枝叶茂盛，尤如兄弟一般，因此又名--兄弟松。
LONG);
  set("exits", ([
    "southwest": __DIR__ "suishi",
  ]));
  set("item_desc", ([
    "song": "这棵松树能长得如此奇特，必蕴涵了天地日月之精华。\n",
  ]));
  set("outdoors", "tiezhang");
  setup();
}
