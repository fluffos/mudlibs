#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short","练功房");
	set("long", @LONG
这是一间用花岗岩砌成的石屋。室内一只大炉中燃了洪炭，煮着热气腾腾的
一镬东西，镬旁两个黑衣小童，一个使劲推拉风箱，另一个用铁铲翻炒镬中之物，
听这沙沙之声，所炒的似是铁沙。几名帮中弟子闭目盘膝坐在锅前，或对着腾上
的热气吐呐，或插指于镬中苦练。
LONG
	);
        set("exits", ([ 
			"south" : __DIR__"zoulang-2",
	]));

	set("objects",([
			__DIR__"npc/hei" : 1,
	]));
	set("tiezhang",1);
	setup();
}

void init()
{
    add_action("do_practice", "lianxi");
    add_action("do_practice", "afflict");
}

int do_practice(string arg)
{
        object me = this_player();
	string skillarg, skillname;
	int times, skill, skill_basic;

	seteuid(getuid());

	if (me->is_busy())
                return notify_fail("你现在正忙着呢。\n");

	if( me->is_fighting() )
		return notify_fail("你已经在战斗中了，学一点实战经验吧。\n");

	if( me->query_skill_mapped("strike") != "tie-zhang" )
		return notify_fail("不炼铁掌跑这来干吗？！\n");

	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练铁掌必须空手。\n");

	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你现在的内力太弱，无法练铁掌。\n");

	if ((int)me->query_str()< 33)
		return notify_fail("你现在的臂力太弱，无法练铁掌。\n");	

	if (me->query_skill("tie-zhang",1) < 100)
		return notify_fail("你现在只能用learn的来学铁掌。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 50)
		return notify_fail("你的内力不够练铁掌。\n");

	if( !arg ) return notify_fail("什么？\n");

	if(sscanf(arg, "%s %d", skillarg, times)!=2 )
	        skillarg = arg;
	
	if( skillarg != "strike" ) return notify_fail("什么？\n");

	if(!times || times == 0) times = 1;
	
	if(!stringp(skillname = me->query_skill_mapped(skillarg)) )
		return notify_fail("你只能练习用 enable 指定的特殊技能。\n");

	skill_basic = me->query_skill(skillarg, 1);
	skill = me->query_skill(skillname, 1);

	if( skill < 1 )
		return notify_fail("你好像还没有学过这项技能吧？最好先去请教别人。\n");
	if( skill_basic < 1 )
		return notify_fail("你对这方面的技能还是一窍不通，最好从先从基本学起。\n");
	if( skill_basic/2 <= skill/3 )
		return notify_fail("你的基本功火候未到，必须先打好基础才能继续提高。\n");

	notify_fail("你现在不能练习这项技能。\n");
	if( !SKILL_D(skillname)->valid_learn(me) ) return 0;

	notify_fail("你试着练习" + to_chinese(skillname) + "，但是并没有任何进步。\n");
	
	if(times < 0 ) return notify_fail("你要练多少？！\n");
	
	for(times; times > 0; times--) {
		if( SKILL_D(skillname)->practice_skill(me) )
			me->improve_skill(skillname, skill_basic/3+me->query_int()+1, skill_basic > skill? 0: 1);
		else return 0;
	}
	if(random(4)==1) message_vision("$N一掌打在布袋中央，声音甚响，可是那布袋竟然纹丝不动，殊无半点摇晃。\n", me);
	else if(random(4)==2) message_vision( HIR"$N高举双手，十根手指上微有热气袅袅而上，忽地站起身来，双手猛插入镬！\n"NOR, me);
	else if(random(4)==3) message_vision("$N忍热让双掌在铁沙中熬炼，隔了好一刻，这才拔掌，回手拍的一声，击向悬在半空的一只小布袋。\n", me);
	else message_vision( CYN"$N双掌在布袋上拍一会，在镬中熬一会，熬一会又拍一会。\n"NOR, me);
	return 1;
}
