/**
// 擂台下
*/
#include <ansi.h>

inherit ROOM;

int do_dalei();
void full_all(object me);
void do_let(string arg);

void create() {
  set("short", HIG "比武擂台" NOR);
  set("long",
    "这里是扬州城外的擂台下面，只见这里人头沥动，大家都在密切
注视著擂台上的动静。擂台是由上等红木搭制而成，高约一丈，方
圆三十多丈，十分的宽阔结实。擂台两侧各有一根高大的圆木，两
根圆木上方则横着一幅牌匾(paibian)。\n"
  );

  set("valid_startroom", 1);

  set("no_fight", 1);
  set("no_practice", 1);

  set("item_desc", ([
    "paibian": HIY "如要擂台比武，请用打入： biwu 或 比武\n" NOR,
  ]));

  set("exits", ([
    "north": "/d/city/kantai",
  ]));

  setup();
}

void init() {
  add_action("do_dalei", "biwu");
  add_action("do_dalei", "比武");
}

int do_dalei() {
  object me = this_player(), obj = this_object(), room;
  object ob1, ob2;
  if (!objectp(room = find_object("/d/biwu/leitai")))
    room = load_object("/d/biwu/leitai");
  if (objectp(ob1 = present("fighter dummy 1", room))
    && objectp(ob2 = present("fighter dummy 2", room))) {
    return notify_fail("已经有两位选手在比武了。\n");
  } else {
    do_let(me->query("id") + " play " + me->query("id"));
    message_vision(WHT "\n$N跳上擂台，大声说道：请各位英雄赐教!\n" NOR, me);
  }
  return 1;
}


int do_let(string arg) {
  object ob, dummy;
  string pl1, pl2;

  if (!arg) return 0;
  if (sscanf(arg, "%s play %s", pl1, pl2) != 2) {
    pl1 = arg;
    pl2 = arg;
  }

  ob = find_player(pl1);
  if (!ob) return notify_fail("没有" + pl1 + "这个玩家！\n");
  seteuid(getuid());
  dummy = new("/clone/biwu/dummy");
  dummy->set("id", pl2);
  if (!dummy->restore()) {
    destruct(dummy);
    return notify_fail("没有" + pl2 + "这个玩家！\n");
  }
  dummy->set_temp("link_ob", ob);
  ob->set_temp("body_ob", dummy);
  ob->set_temp(
    "apply/short",
    ({ ob->query("title") + " " + ob->query("name") + "(" + capitalize(ob->query("id")) + ")" + WHT "<打擂中>" NOR })
  );
  exec(dummy, ob);

  dummy->set_name(dummy->name(1), ({ pl2, "fighter dummy" }));
  dummy->setup();
  dummy->move("/d/biwu/leitai");
  full_all(dummy);
  return 1;
}


void full_all(object me) {
  me->set("eff_jing", (int)me->query("max_jing"));
  me->set("jing", (int)me->query("max_jing"));
  me->set("eff_qi", (int)me->query("max_qi"));
  me->set("qi", (int)me->query("max_qi"));
  me->set("jingli", (int)me->query("max_jingli"));
  me->set("neili", (int)me->query("max_neili"));
  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());
  me->remove_all_killer();
  me->clear_condition();
}
