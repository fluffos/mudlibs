#include <ansi.h>

inherit ROOM;

string look_jia();
int do_giveup();
//int start_biwu(int i);

void create() {
  set("short", HIG "比武擂台" NOR);
  set("long",
    "       　
" + HIG + "                               ┏━━━━━┓ 　" + NOR + "　　      
 " + HIG + "       　   　                ┃扬  州  擂┃   " + NOR + "              
 " + HIG + "                              ┗━━━━━┛   " + NOR + "
 " + HIM + "          ┌─┐                 　　　　                ┌─┐ 　  " + NOR + "
 " + HIM + "          │拳│" + NOR + "　　　" + HIW + "擂台的柱子，两个人都抱不住；" + NOR + "      " + HIM + " │脚│" + NOR + " 
 " + HIM + "          │打│" + NOR + "　　　" + HIW + "脚下踩的板子，都是用一尺见方的，" + NOR + "  " + HIM + " │踢│" + NOR + "　
 " + HIM + "          │南│" + NOR + "      " + HIW + "方木一根根铺成的，长有五丈，宽 " + NOR + "   " + HIM + " │北│" + NOR + "
 " + HIM + "          │山│" + NOR + "　　　" + HIW + "有四丈七八；　" + NOR + "　    　　　　　    " + HIM + " │海│" + NOR + "
 " + HIM + "          │山│" + NOR + "      " + HIW + "在擂台的左右，有两座看台，一东" + NOR + "    " + HIM + " │北│" + NOR + "
 " + HIM + "          │崩│" + NOR + "      " + HIW + "一西，样式和擂台差不多，只是比擂" + NOR + "  " + HIM + " │海│" + NOR + "
 " + HIM + "          │地│" + NOR + "      " + HIW + "台稍微大了点，在每个看台的两边，" + NOR + " 　" + HIM + "│翻│" + NOR + "
 " + HIM + "          │裂│" + NOR + "      " + HIW + "都搭有一个梯子，供人上下出入。" + NOR + "    " + HIM + " │江│" + NOR + " 　
 " + HIM + "          └─┘　　　　　　　　　　　　　　　　         └─┘　   " + NOR + "
\n\n"
    "	这里是个方形的擂台，正前方竖着一排兵器架(jia)，台下围满了看热闹的人。\n\n"
  );
  set("invalid_startroom", 1);
  set("no_sleep_room", "1");
  set("no_death", 1);

  set("item_desc", ([
    "jia": (: look_jia :),
  ]));

  set("objects", ([
    __DIR__ "live": 1,
  ]));

  setup();
}

void init() {
  add_action("do_get", "get");
  add_action("do_giveup", "giveup");
  add_action("do_ready", "ok");
  //////////////////////////////////////
  add_action("do_disable1", "kill");
  add_action("do_disable", "hit");
  add_action("do_disable", "halt");
  add_action("do_disable", "persuade");
  add_action("do_disable", "steal");
  add_action("do_disable", "fight");
  add_action("do_disable", "quit");
  add_action("do_disable", "sleep");
  add_action("do_disable", "apprentice");
  add_action("do_disable", "bai");
  add_action("do_disable", "practice");
  add_action("do_disable", "lian");
  add_action("do_disable", "study");
  add_action("do_disable", "du");
  add_action("do_disable", "dazuo");
  add_action("do_disable", "tuna");
  //////////////////////////////////////
}

int do_giveup() {
  object ob1, ob2, me = this_player(), room = this_object();
  if (objectp(ob1 = present("fighter dummy 1", room))
    && objectp(ob2 = present("fighter dummy 2", room))) {
    if (me->query_temp("bw_ready"));
    return notify_fail("现在后悔已经来不及啦！\n");
  }
  message_vision(me->query("family/family_name") + "$N自动认输。\n", me);
  me->quit(me);
  return 1;
}

int do_disable(string arg) {
  tell_object(this_player(), "不能在擂台上这样。\n");
  return 1;
}

int do_disable1(string arg) {
  object me = this_player();
  if (!me->query_temp("bw_ready")) {
    tell_object(this_player(), "不能在擂台上这样。\n");
    return 1;
  }
}

int do_ready() {
  object ob1, ob2, me = this_player();
  if (me->query_temp("bw_ready"))
    return notify_fail("你已经准备好了！\n");
  if (objectp(ob1 = present("fighter dummy 1", this_object()))
    && objectp(ob2 = present("fighter dummy 2", this_object()))) {
    if (me->query("id") == ob1->query("id")) {
      message_vision("$N躬身作了个揖：请赐教！\n", me);
      me->set_temp("bw_ready", 1);
    }
    if (me->query("id") == ob2->query("id")) {
      message_vision("$N也躬身回了个揖：请出招！\n", me);
      me->set_temp("bw_ready", 1);
    }
    remove_call_out("start_biwu");
    call_out("start_biwu", 0, 3);
    return 1;
  }
  tell_object(me, "人还没到齐，现在为时尚早。\n");
  return 1;
}
int start_biwu(int i) {
  object ob1, ob2;
  if (!intp(i)) i = 3;
  if (objectp(ob1 = present("fighter dummy 1", this_object()))
    && objectp(ob2 = present("fighter dummy 2", this_object()))) {
    if (ob1->query_temp("bw_ready") && ob2->query_temp("bw_ready")) {
      message_vision(HIY "一声锣响，$N和$n的比武开始倒进入计时。\n" NOR, ob1, ob2);
      call_out("countstart", 3, i);
    }
    return 1;
  }
  return notify_fail("人没到齐！\n");
}

void countstart(int min) {
  object ob1, ob2;
  int min2;
  ob1 = present("fighter dummy 1", this_object());
  ob2 = present("fighter dummy 2", this_object());
  min--;
  if (min) {
    min2 = min + 1;
    message_vision("比武倒计时：" + min2 + "！\n", ob1, ob2);
    call_out("countstart", 1, min);
  } else {
    message_vision("比武倒计时：1！\n", ob1, ob2);
    call_out("do_start", 1);
  }
}

int do_start() {
  object ob1, ob2;
  if (objectp(ob1 = present("fighter dummy 1", this_object()))
    && objectp(ob2 = present("fighter dummy 2", this_object()))) {
    message_vision(HIR "只听一声锣响，$N和$n的比武正式开始。\n" NOR, ob1, ob2);
    ob1->kill_ob(ob2);
    ob2->kill_ob(ob1);
    return 1;
  }
  return notify_fail("人没到齐！\n");
}

int do_get(string arg) {
  object weapon, me = this_player();
  string type;
  if (!arg) return 0;
  if (me->is_busy()) return 0;
  if (sscanf(arg, "%s from jia", type) != 1) return 0;
  switch (type) {
    case "sword":
      if (this_player()->query("gender") == "无性")
        weapon = new("/clone/test/xiuhua");
      else
        weapon = new("/clone/weapon/gangjian");
      break;
    case "blade":
      weapon = new("/clone/weapon/gangdao");
      break;
    case "stick":
      weapon = new("/clone/weapon/gangbang");
      break;
    case "staff":
      weapon = new("/clone/weapon/shezhang");
      break;
    case "falun":
      weapon = new("clone/weapon/falun");
      break;
    case "whip":
      weapon = new("/clone/weapon/changbian");
      break;
    case "xiao":
      weapon = new("/clone/weapon/zhuxiao");
      break;
    case "armor":
      weapon = new("/clone/armor/tiejia");
      break;
    default:
      return notify_fail("找不到" + type + "\n");
  }
  if (weapon->move(me)) {
    message_vision("$N从兵器架上取下一" + weapon->query("unit") + weapon->name() + "。\n", me);
    if (me->is_fighting())
      me->start_busy(2);
  } else {
    destruct(weapon);
  }
  return 1;
}

string look_jia() {
  string msg;
  msg = "这是一个兵器架，十八般武器是应有尽有。\n";
  msg += "目前存放有剑(sword)，刀(blade)，棒(stick)，杖(staff)，轮(falun)，\n鞭(whip)。还有一些铁甲(armor)。\n";
  msg += "请用指令“get 种类 from jia”拿取你称手的兵器或甲胄。\n";
  return msg;
}

int valid_leave(object me, string dir) {
  if (base_name(me) == "/d/city/npc/fighter") return 0;
  return ::valid_leave(me, dir);
}
