//树林


inherit ROOM;

void create()
{
        set("short","树林");

        set("long",@LONG
一片茂密的树林，地上有不少的尸体，有官兵的也有神龙教弟子的。
LONG);

        set("exits",([ "west" : __DIR__"shulin8",
                        "east" : __DIR__"shanlu1",
                        "northwest" : __DIR__"shulin9",
                        "southwest" : __DIR__"shulin10",
                      ])
			  );
	  set("cost",2);
	  set("outdoors", "shenlong");

        setup();

}


#include "snake.h"