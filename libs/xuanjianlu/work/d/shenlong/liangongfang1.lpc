//pingguo

inherit ROOM;
int do_lian(string arg);
void create() {
  set("short", "练功房");
  set("long", @LONG
这里是神龙教秘密的练功房，地下整整齐齐放着几个蒲团，几位神龙教长老
正盘膝坐在上面练功。墙壁上画着一些神龙教基本的武功，仔细看起来好像
是一个人在舞动双钩，你不禁也想练一练（lian hook）。北面是男厢房。
LONG
  );
  set("exits", ([
    "north": __DIR__ "shuifang1",
    "east": __DIR__ "zhulin1",
    "south": __DIR__ "yaofang",
  ]));

  set("objects", ([
    __DIR__ "obj/tree": 3,
  ]));

  set("cost", 0);

  setup();
}

int valid_leave(object me, string dir) {
  if (me->query("gender") == "女性" && dir == "north" && !wizardp(me))
    return notify_fail("看清楚点，那是男厢房！\n");

  return ::valid_leave(me, dir);
}

void init() {

  add_action("do_lian", "lian");
}


int do_lian(string arg) {
  object me = this_player();
  int check;
  if (!arg)
    return notify_fail("你只能练习用 enable 指定的特殊技能。\n");
  if (arg != "hook")
    return notify_fail("你只能练习用 enable 指定的特殊技能。\n");


  if ((int)me->query("qi") < 26 || me->query("jingli") < 30)
    return notify_fail("你舞了半天，手脚发软，看来是要休息休息了。\n");
  me->receive_damage("qi", 25);
  me->receive_damage("jingli", 25);

  message_vision("$N一边参照墙上的秘诀一边领悟基本钩法的运用。\n", me);

  check = (int)me->query_skill(
    "hook",
    1
  ) * (int)me->query_skill("hook", 1) * (int)me->query_skill("strike", 1);
  if (check > (int)me->query("combat_exp") * 10) {
    write("你练习了一会，发现自己没有什么进步，看来该去弄点实战经验了。\n");
    return 1;
  }

  if ((int)me->query_skill("hook", 1) >= 101) {
    write("你参照了一会，发现太简单了。\n");
    return 1;
  }

  me->improve_skill("hook", me->query("int") + me->query("con"));
  return 1;
}
