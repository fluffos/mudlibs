// 42经
#include "ansi.h"

inherit ITEM;
inherit F_UNIQUE;

void setup() {}



void create() {
  set_name(YEL "四十二章经" NOR, ({ "sishier zhangjing", "jing", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "部");
    set("long", "这是一部四十二章经，封面用绸缎包好了。\n");
    set("value", 5000);
    set("no_steal", 1);
    set("material", "paper");
  }
  ::create();
}
