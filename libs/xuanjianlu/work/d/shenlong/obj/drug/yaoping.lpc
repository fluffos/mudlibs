//药瓶子
inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIC "药瓶" NOR, ({ "yao ping", "yaoping", "ping" }));
  set_weight(500);
  set_max_encumbrance(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个用来装药物的仿古瓶子上面写着【神龙教】三个字，做的十分的精致。\n");
    set("value", 50);
  }
}

int is_container() { return 1; }

int reject(object ob) {
  if (ob && ob->query("shenlong_drug")) return 0;
  notify_fail("你只能把神龙教的药物放进去。\n");
  return 1;
}
