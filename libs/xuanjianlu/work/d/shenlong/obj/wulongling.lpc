//Pingguo
// 五龙令
#include <weapon.h>
#include <ansi.h>

int do_forcelead(string);
int do_forcekill(string);
int do_forceleave(string);
int do_forcegive(string);
int do_forceget(string);


inherit HAMMER;

void create()
{
		  set_name("五龙令", ({ "wulong ling", "ling" }) );
		  set_weight(1000);
		  if( clonep() )
					 set_default_object(__FILE__);
		  else {
					 set("unit", "面");
					 set("long", "这是一面可以号令神龙教教众的令牌，持此令者，犹如教主本人。用法如下:
	force_kill     : 让教众杀人。
	force_lead     : 让教众跟随。
	force_get      : 让教众帮忙拿什么东西。
	force_leave    : 让教众离开此房间。
	force_give     : 让教众给你身上的某种东西。
\n");
                set("value", 50);
                set("material", "iron");
                set("wield_msg", "$N拿出一面$n，握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(5);
		  setup();
}

init()
{
	object me = this_player();
	 if ( me->query("id",1)!="pingguo" && !wizardp(me)) {
		set("no_drop",  "这么有用的东西怎么能扔了呢。\n");
		set("no_steal", "这个东西你偷不到。\n");
		set("no_get", "这个东西拿不起来。\n");
		}
    add_action("do_lead", "force_lead");
    add_action("do_kill", "force_kill");
    add_action("do_leave", "force_leave");
    add_action("do_give", "force_give");
    add_action("do_get", "force_get");

}


int do_lead(string arg)
{
    object me = this_player();

    return notify_fail("带领。\n");

    return 1;
}

int do_kill(string arg)
{
    object me = this_player();
    return notify_fail("杀人。\n");

    return 1;
}

int do_give(string arg)

{
    object me = this_player();
    return notify_fail("交给。\n");

    return 1;
}

int do_leave(string arg)
{
    object me = this_player();
    return notify_fail("离开。\n");


    return 1;
}

int do_get(string arg)
{
    object me = this_player();
    return notify_fail("拿取。\n");


    return 1;
}


