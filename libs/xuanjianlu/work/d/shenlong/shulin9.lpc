//树林


inherit ROOM;

void create()
{
        set("short","树林");

        set("long",@LONG
一片茂密的树林，地上有不少的尸体，有官兵的也有神龙教弟子的。。
LONG);

        set("exits",([ "south" : __DIR__"shulin8",
                        "west" : __DIR__"shulin6",
                        "southeast" : __DIR__"shulin11",
                      ])
			  );
	  set("cost",2);
	  set("outdoors", "shenlong");

        setup();

}


#include "snake.h"