inherit NPC;
#include "/d/shenlong/npc/auto_wudang.h"

void create()
{
	set_name("清兵", ({
		"qing bing",
		"bing",
	}));
	set("long",
		"一个自以为是的清兵。\n"
	);

	set("gender", "男性");
	set("attitude", "aggressive");
	set("no_get", "清兵对你而言太重了。");

	set("age", 20);
	set("shen_type", 1);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 20);

       set("max_qi", 9555);
       set("max_jing", 9000);
       set("max_jingli", 9000);
       set("eff_jingli", 9000);
       set("jingli", 9000);
       set("jing", 9000);
	set("neili", 9000);
	set("max_neili", 6000);

	set("combat_exp", 800000);
	

	set_skill("force", 200);
	set_skill("taiji-shengong", 200);
	set_skill("dodge", 200);
	set_skill("tiyunzong", 200);
	set_skill("strike", 200);
	set_skill("mian-zhang", 200);
	set_skill("parry", 200);
	set_skill("taoism", 200);
	set_skill("cuff", 200);
	set_skill("taiji-quan", 200);
	set_skill("sword", 200);
	set_skill("taiji-jian", 200);


	map_skill("force", "taiji-shengong");
	map_skill("sword", "taiji-jian");
	map_skill("dodge", "tiyunzong");
	map_skill("strike", "mian-zhang");
	map_skill("parry", "taiji-jian");
	map_skill("cuff", "taiji-quan");
       prepare_skill("strike", "mian-zhang");
       prepare_skill("cuff", "taiji-quan");

       create_family("武当派", 5, "弟子");

	setup();

            carry_object("/clone/weapon/gangjian");
            carry_object("/clone/armor/tiejia")->wear();
            carry_object("/d/shenlong/zhanchang/obj/huoqiang")->wield();
}


void init()
{
	object ob = this_player();
	
	::init();

	if (interactive(ob))
	{
		command("say 乱闯兵船者！杀无赦！");
		remove_call_out("kill_ob");
		command("shoot "+ob->query("id")); 
        	command("unwield long qiang");
        	command("wield sword");
		command("kill "+ob->query("id")); 
		command("perform chan "+ob->query("id"));
	}       
}


