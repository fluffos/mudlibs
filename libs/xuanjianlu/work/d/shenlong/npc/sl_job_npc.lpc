// shenlong job npc
#include <ansi.h>
inherit NPC;

int setup_robber(int exp_level);
int set_random_title();
void start_checking(object target);
void start_job(object target);
void self_destruct();


nosave string *menpai_names1 = ({
  "渤海帮",
  "飞鱼帮",
  "鄱阳帮",
  "铁叉帮",
  "长鲸帮",
  "天河帮",
  "龙游帮",
  "青竹帮",
  "金龙帮",
});

nosave string *menpai_names2 = ({
  HIR "渤海帮帮众" NOR,
  HIR "飞鱼帮帮众" NOR,
  HIR "鄱阳帮帮众" NOR,
  HIR "铁叉帮帮众" NOR,
  HIR "长鲸帮帮众" NOR,
  HIR "天河帮帮众" NOR,
  HIR "龙游帮帮众" NOR,
  HIR "青竹帮帮众" NOR,
  HIR "金龙帮帮众" NOR,

});


nosave int random_id;


void create() {
  string my_title;

  random_id = random(9);

  my_title = menpai_names2[random_id];


  set("title", my_title);
  set_name("帮众", ({ "bang zhong", "bangzhong" }));
  set("long", "他是一个深得" + menpai_names1[random_id] + "帮主欢心的帮众，别看年纪轻轻，身手却不错。\n");
  set("gender", "男性");
  set("age", 29);
  set("str", 25);
  set("dex", 30);
  set("con", 25);
  set("int", 23);
  set("shen_type", -1);

  set("max_qi", 300);
  set("max_jing", 100);
  set("neili", 200);
  set("max_neili", 200);


  setup();
  add_money("silver", 20);
  add_money("gold", 2);
  carry_object("/clone/armor/cloth")->wear();
  remove_call_out("self_destruct");
  call_out("self_destruct", 1200);

}

int set_random_title() {
  string my_title;

  random_id = random(5);

  my_title = menpai_names2[random_id];
  //    set_name(my_name, ({"bang zhong"}));
  set("long", "他是一个年轻的" + menpai_names1[random_id] + "帮众。\n");

  return random_id;
}

int setup_robber(int exp_level) {
  int level, menpai, exp;

  menpai = random_id;
  if (exp_level > 500000)

  {

    exp = exp_level / 100 * (random(20) + 90);

    if (exp < 0) return;

    level = pow(25 * exp, 0.333334);

  }


  else {
    exp = exp_level / 100 * (random(20) + 70);

    if (exp < 0) return;

    level = pow(10 * exp, 0.333334);



  }



  if (level < 10) level = 10;

  set("max_neili", level * 10);
  set("neili", level * 10);
  set("eff_jingli", level * 8);
  set("max_jingli", level * 8);
  set("jingli", level * 8);
  set("max_qi", level * 8);
  set("eff_qi", level * 8);
  set("qi", level * 8);
  set("max_jing", level * 7);
  set("eff_jing", level * 7);
  set("jing", level * 7);
  set("jiali", level / 2);

  set("combat_exp", exp);
  set_skill("force", level * 2 / 3);
  set_skill("dodge", level * 2 / 3);
  set_skill("parry", level * 2 / 3);
  set_skill("sword", level * 2 / 3);
  set_skill("blade", level * 2 / 3);
  set_skill("strike", level * 2 / 3);
  set_skill("cuff", level * 2 / 3);
  set_skill("finger", level * 2 / 3);
  set_skill("claw", level * 2 / 3);
  set_skill("club", level * 2 / 3);
  set_skill("kick", level * 2 / 3);
  set_skill("staff", level * 2 / 3);
  set_skill("whip", level * 2 / 3);

  switch (menpai) {
    // Huashan
    case 0:
      set_skill("huashan-jianfa", level * 2 / 3);
      set_skill("liangyi-dao", level * 2 / 3);
      set_skill("huashan-shenfa", level * 2 / 3);
      set_skill("zixia-gong", level * 2 / 3);
      set_skill("pishi-poyu", level * 2 / 3);
      set_skill("hunyuan-zhang", level * 2 / 3);

      map_skill("force", "zixia-gong");
      map_skill("dodge", "huashan-shenfa");
      map_skill("parry", "huashan-jianfa");
      map_skill("strike", "hunyuan-zhang");
      map_skill("cuff", "pishi-poyu");
      map_skill("sword", "huashan-jianfa");
      map_skill("blade", "liangyi-dao");

      prepare_skill("cuff", "pishi-poyu");
      prepare_skill("strike", "hunyuan-zhang");

      set("default_weapon", "/clone/weapon/gangjian");

      break;
      // emei
    case 1:
      set_skill("huifeng-jian", level * 2 / 3);
      set_skill("yanxing-dao", level * 2 / 3);
      set_skill("jinding-zhang", level * 2 / 3);
      set_skill("tiangang-zhi", level * 2 / 3);
      set_skill("linji-zhuang", level * 2 / 3);
      set_skill("zhutian-bu", level * 2 / 3);

      map_skill("force", "linji-zhuang");
      map_skill("sword", "huifeng-jian");
      map_skill("blade", "yanxing-dao");
      map_skill("strike", "jinding-zhang");
      map_skill("finger", "tiangang-zhi");
      map_skill("dodge", "zhutian-bu");
      map_skill("parry", "huifeng-jian");

      prepare_skill("finger", "tiangang-zhi");
      prepare_skill("strike", "jinding-zhang");
      set("default_weapon", "/clone/weapon/gangdao");
      break;
      // wudang
    case 2:
      set_skill("taiji-shengong", level * 2 / 3);
      set_skill("taiji-jian", level * 2 / 3);
      set_skill("tiyunzong", level * 2 / 3);
      set_skill("taiji-quan", level * 2 / 3);

      map_skill("force", "taiji-shengong");
      map_skill("parry", "taiji-jian");
      map_skill("cuff", "taiji-quan");
      map_skill("dodge", "tiyunzong");
      map_skill("sword", "taiji-jian");

      prepare_skill("cuff", "taiji-quan");
      set("default_weapon", "/clone/weapon/gangjian");
      break;
      // shaolin
    case 3:
      set_skill("damo-jian", level * 2 / 3);
      set_skill("xiuluo-dao", level * 2 / 3);
      set_skill("wuchang-zhang", level * 2 / 3);
      set_skill("zui-gun", level * 2 / 3);
      set_skill("shaolin-shenfa", level * 2 / 3);
      set_skill("hunyuan-yiqi", level * 2 / 3);
      set_skill("yizhi-chan", level * 2 / 3);
      set_skill("banruo-zhang", level * 2 / 3);

      map_skill("force", "hunyuan-yiqi");
      map_skill("dodge", "shaolin-shenfa");
      map_skill("parry", "damo-jian");
      map_skill("sword", "damo-jian");
      map_skill("blade", "xiuluo-dao");
      map_skill("club", "zui-gun");
      map_skill("staff", "wuchang-zhang");
      map_skill("finger", "yizhi-chan");
      map_skill("strike", "banruo-zhang");

      prepare_skill("finger", "yizhi-chan");
      prepare_skill("strike", "banruo-zhang");
      set("default_weapon", "/clone/weapon/gangjian");
      break;

      // gaibang
    case 4:
    default:
      set_skill("liuhe-dao", level * 2 / 3);
      set_skill("xiaoyaoyou", level * 2 / 3);
      set_skill("huntian-qigong", level * 2 / 3);
      set_skill("shexing-diaoshou", level * 2 / 3);

      map_skill("force", "huntian-qigong");
      map_skill("dodge", "xiaoyaoyou");
      map_skill("parry", "liuhe-dao");
      map_skill("blade", "liuhe-dao");
      map_skill("hand", "shexing-diaoshou");

      prepare_skill("hand", "shexing-diaoshou");
      set("default_weapon", "/clone/weapon/gangdao");
      break;
  }
  if (random(2) > 0) carry_object(query("default_weapon"))->wield();

  return menpai;
}

void start_checking(object target) {
  call_out("self_destruct", 60 + random(20), target);
  return;
}

void self_destruct() {
  object me = this_object();

  message("vision", name(1) + YEL "采购了好了东西，就匆匆忙忙的回去了。\n" NOR, environment(me), me);
  destruct(me);
}

void die() {
  object me = this_object();
  object ob = me->query_temp("last_damage_from");

  if (!living(me)) { revive(1); reincarnate(); }

  if (!ob || me->query("combat_exp", 1) < ob->query("combat_exp", 1) / 100 * 71) {
    tell_object(ob, HIG "\n你是不是杀错人了？\n" NOR);
    ::die();
    return;
  }


  else {
    tell_object(ob, HIG "\n你擦了擦身上的血迹.....\n" NOR);

    ob->delete_temp("job_here1");
    ob->delete_temp("job_here2");
    ob->delete_temp("job_here3");
    ob->delete_temp("job_here4");
    ob->delete_temp("job_here5");
    ob->delete_temp("job_here6");
    //                                     ob->delete_temp("job_here7");
    ob->set_temp("job_over", 1);
    ::die();
  }

}

int accept_kill(object victim) {
  command("sneer");
  command("say 等老子收拾了你，再去采购！");

  return 1;
}
