inherit NPC;


void create()
{
	set_name("清兵", ({
		"qing bing",
		"bing",
	}));
	set("long",
		"一个自以为是的清兵。\n"
	);

	set("gender", "男性");
	set("attitude", "aggressive");
	set("no_get", "清兵对你而言太重了。");

	set("age", 20);
	set("shen_type", 1);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 20);

       set("max_qi", 9555);
       set("max_jing", 9000);
       set("max_jingli", 9000);
       set("eff_jingli", 9000);
       set("jingli", 9000);
       set("jing", 9000);
	set("neili", 9000);
	set("max_neili", 6000);

	set("combat_exp", 800000);
	

	set_skill("force", 200);
	set_skill("hunyuan-yiqi", 200);
	set_skill("dodge", 200);
	set_skill("shaolin-shenfa", 200);
	set_skill("strike", 200);
	set_skill("banruo-zhang", 200);
	set_skill("jingang-quan", 200);
	set_skill("parry", 200);
	set_skill("buddhism", 200);
	set_skill("finger", 200);
	set_skill("yizhi-chan", 200);
	set_skill("sword", 200);
	set_skill("damo-jian", 200);


	map_skill("force", "hunyuan-yiqi");
	map_skill("sword", "damo-jian");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("strike", "banruo-zhang");
	map_skill("parry", "damo-jian");
	map_skill("finger", "yizhi-chan");
       prepare_skill("strike", "banruo-zhang");
       prepare_skill("finger", "yizhi-chan");

       create_family("少林派", 5, "弟子");

	setup();

	switch( random(3) )
	{
		case 0:
			carry_object("/clone/weapon/gangzhang")->wield();
			break;
		case 1:
			carry_object("/clone/weapon/changjian")->wield();
			break;
		case 2:
			carry_object("/clone/weapon/gangjian")->wield();
			break;
	}

            carry_object("/clone/armor/tiejia")->wear();

}


void init()
{
	object ob = this_player();
	
	::init();

	if (interactive(ob))
	{
		command("say 乱闯兵船者！杀无赦！");
		remove_call_out("kill_ob");

        	command("wield sword");
        	command("unwield gangzhang");
		command("kill "+ob->query("id")); 
		command("perform weituo "+ob->query("id"));
		command("exert jingang");
		command("perform jingmo "+ob->query("id"));
		command("perform san "+ob->query("id"));


	}       
}


