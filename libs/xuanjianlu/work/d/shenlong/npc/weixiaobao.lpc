#include <ansi.h>
inherit NPC;

void destroying(object, object);

void create() {
  set_name("韦小宝", ({ "wei xiaobao", "xiaobao", "wei" }));
  set_color("$HIY$");
  set("title", "通吃候");
  set("nickname", "小白龙");

  set("long",
    "此人身穿将军铠甲，但是怎样看也只不过是个小孩子。\n");
  set("gender", "男性");
  set("age", 18);

  set_skill("unarmed", 120);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("ding-dodge", 120);
  set_skill("ding-force", 120);
  set_skill("ding-unarmed", 120);
  map_skill("force", "ding-force");
  map_skill("dodge", "ding-dodge");
  map_skill("unarmed", "ding-unarmed");
  prepare_skill("unarmed", "ding-unarmed");
  set("max_neili", 2000);
  set("neili", 2000);
  set("jiali", 100);

  set("combat_exp", 600000);
  set("shen_type", 1);
  setup();
  carry_object("/d/city/obj/cloth")->wear();

}

int accept_object(object me, object obj) {
  object book;
  if ((string)obj->query("id") == "mi zhi") {
    message("vision", me->name() + "给韦小宝一封秘旨。\n", environment(me),
      ({ me }));
    book = new("/d/shenlong/obj/42jing.lpc");
    if (!book) {
      command("say 啊？这不是给我的吧。");
      return 0;
    }

    command("ah " + me->query("id"));
    write(HIY "韦小宝跪在地上双手接过秘旨。\n" NOR);
    write(HIY "韦小宝一边看，一边念叨着。\n" NOR);
    write(HIY "韦小宝说到：看来小玄子没有忘记我。\n" NOR);

    command("say 多谢这位" + RANK_D->query_respect(me) + "帮我带来了小玄子的秘旨。");
    book->move(me);
    add("book_count", -1);
    message_vision("$n偷偷递给$N一本书。\n", me, this_object());
    command("whisper " + me->query("id") + " 这本书就是神龙教主想要的四十二章经，麻烦你帮我带回去给皇上吧。");
    command("rumor " + me->query("name") + "弄到了一部四十二章经。");
    remove_call_out("destroying");
    call_out("destroying", 1, this_object(), obj);
    return 1;
  }
  return 0;
}

void destroying(object me, object obj) {
  destruct(obj);
  return;
}
