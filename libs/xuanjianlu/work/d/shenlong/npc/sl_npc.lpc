void init()
{
		  object victim = this_player();
		  object *inv, me = this_object();
//		  mapping skill_status;
//		  string *sname;
		  int i, max, j, my_exp;
		  
		  		  if( interactive(victim))
						{
								if( me->query_temp("fought") && query_temp("victim") && victim->query("id") == query_temp("victim") )
								{
										  me->kill_ob(victim);
										  victim->kill_ob(me);
										  message_vision( "$n对着$N大吼：明年的今天就是你的忌日！\n", victim, me );
										  remove_call_out("checking");
										  call_out("checking", 25, me, victim,me->query_temp("bonus",1));
										  return;
								}
						}


		  if ( !me->query_temp("said") ) {
				 switch( random(3) )
				 {
					 case 0:
                                                       message_vision(HIG"\n$N喝道：圣上有令，让我等特来铲除你们的邪教。\n"NOR, this_object());
								command( "say 我等奉命前来攻打神龙岛！" );
								
								break;
					 case 1:
                                                       message_vision(HIG"\n$N喝道：圣上有令，让我等特来铲除你们的邪教。\n"NOR, this_object());
								command( "say 你们快来受死吧！" );
								
								break;
					 case 2:
                                                       message_vision(HIG"\n$N喝道：圣上有令，让我等特来铲除你们的邪教。\n"NOR, this_object());
								command( "say 快快投降！" );
								
								break;
				 }
				 me->set_temp("said", 1);
              call_out("destruct_me",120+random(60),me);

		  }

		  if ( !me->query_temp("copied") ) {
/*
			  if ( mapp(skill_status = victim->query_skills()) ) {
					 skill_status = victim->query_skills();
					 sname = keys(skill_status);

					 for(i=0; i<sizeof(skill_status); i++) {
								if ( skill_status[sname[i]] > max ) max = skill_status[sname[i]];
					 }

					 if( victim->query("combat_exp",1) > 15000 )max = max*4/3;
					 else if( victim->query("combat_exp",1) > 100000 )max = max*2;
					 else if( victim->query("combat_exp",1) > 500000 )max = (int)(max*5/2);
					 else if( victim->query("combat_exp",1) > 1500000 )max = (int)(max*6/2);
*/					 
					 my_exp = victim->query("combat_exp") + (int) random(victim->query("combat_exp")/10) * (random(2) + 1);
	                        	 
	                        	 for(max=1;max*max*max<my_exp*10;max++) {}
	                        	 
					 me->set_skill("force", max*4/5);
					 me->set_skill("dodge", max*4/5);
					 me->set_skill("parry", max*4/5);
					 me->set_skill("cuff", max*4/5);
					 me->set_skill("sword", max*4/5);
					 me->set_skill("whip", max*4/5);
					 me->set_skill("duanyun-bian", max*4/5);
					 me->set_skill("blade", max*4/5);
					 me->set_skill("stick", max*4/5);
					 me->set_skill("staff", max*4/5);
					 me->set_skill("huntian-qigong", max*4/5);
					 me->set_skill("zui-gun", max*4/5);
					 me->set_skill("dagou-bang", max*4/5);
					 me->set_skill("liangyi-dao", max*4/5);
					 me->set_skill("tianshan-zhang",max*4/5);
					 me->set_skill("jingang-quan", max*4/5);
					 me->set_skill("huashan-jianfa", max*4/5);
					 me->set_skill("wuxingbu", max*4/5);
					 me->set_skill("club", max*4/5);
					 
					 me->set("combat_exp", victim->query("combat_exp",1)+random(5000));
					 me->set("max_qi", victim->query("max_qi")/2);
					 me->set("max_neili", victim->query("max_neili")/2);
					 me->set("neili", me->query("max_neili")/2);
					 me->set("eff_qi", victim->query("max_qi")/2);
					 me->set("max_jing", victim->query("max_jing")*3/2);
					 me->set("eff_jing", victim->query("max_jing")*3/2);
					 me->set("max_jingli", me->query("max_jingli"));
					 me->set("jingli", victim->query("jingli"));
					 me->set("qi", me->query("max_qi"));
					 me->set("jing", me->query("max_jing"));
					 me->set("shen",1*victim->query("combat_exp")/20);

					 me->set("no_sing", 1);
					 me->set_temp("copied", 1);

		  inv = all_inventory(victim);

					 for (j=0; j<sizeof(inv); j++) {
					 if(inv[j]->is_unique() && random(5) == 1)
					 map_skill("sword", "huashan-jianfa");
					 map_skill("cuff", "jingang-quan");
					 map_skill("blade", "liangyi-dao");
					 map_skill("staff", "tianshan-zhang");
					 map_skill("dodge", "wuxingbu");
					 map_skill("club", "zui-gun");
					 map_skill("whip", "duanyun-bian");
					 map_skill("stick", "dagou-bang");
					 map_skill("force", "huntian-qigong");
					 prepare_skill("cuff", "jingang-quan");

					 }
		  
		  if ( !me->query_temp("victim") ) {
					 remove_call_out("rob_kill");
					 call_out("rob_kill", 40, me, victim);
					 me->set_temp("victim", victim->query("id"));
		  } else if( (string)victim->query("id") == (string)me->query_temp("victim") ) {
					 remove_call_out("rob_kill");
					 call_out("rob_kill", 2, me, victim);
					 }
		  }


}



void destruct_me(object me)
{
		  if ( me && objectp(me) )
		  {
			 message_vision("$N骂到：“算你跑的快！”\n", this_object());
			 destruct(me);
		  }
}




int checking(object me, object victim,int bonus)
{
	if ( !me  ) {
		return 1;
	}

	if( !present(victim, environment(me)) )
		return 1;

	me->set_temp("bonus",bonus);




	if ( victim->is_ghost() ) {
		command("grin");
              command("kill di zi"); 

//		remove_call_out("destruct_me");
//		call_out("destruct_me", 1, me);
		return 1;
	}

	if ( !me->is_fighting() && present(victim, environment(me)) && me->query("qi",1)>0 ) {
		me->kill_ob(victim);
		message_vision( "$n对着$N大吼：大爷我杀了你！\n", victim, me );

		remove_call_out("checking");
		call_out("checking", 1, me, victim,bonus+random(2) );
		return 1;
	}


	remove_call_out("checking");
	call_out("checking", 1, me, victim,bonus+random(2));
	return 1;
}



int accept_fight(object victim)
{
        object me = this_object();
        if ( me->query_temp("victim") && victim->query("combat_exp") > me->query("combat_exp") ) {
                 command( "say 滚！我可没功夫和你瞎闹！" );
                 return 0;
        }
        else {
                command( "say 你吃了狼心豹子胆啦，竟敢反抗！" );
                if (victim->query("family/family_name") != "神龙教") {
                        me->set("kill_player",victim->query("id"));
                        call_out("checking2", 1, me, victim);
                        }
                me->set_temp("fought", 1);
                me->kill_ob(victim);
                remove_call_out("checking");
                call_out("checking", 1, me, victim);

                return 1;
        }
}

int accept_kill(object victim)
{
        object me = this_object();

        if ( me->query_temp("victim") && victim->query("combat_exp") > me->query("combat_exp")*2 ) {
                 command( "say 嘿嘿，还有帮忙的？。" );
                 message_vision("\n$N急急忙忙离开了！\n", me);
                 remove_call_out("checking");
                 me->remove_all_enemy();
                 destruct(me);
        }
        else {
                command( "say 不知死活的东西！" );
                if (victim->query("family/family_name") != "神龙教") {
                        me->set("kill_player",victim->query("id"));
                        call_out("checking2", 1, me, victim);
                        }
                me->set_leader(victim);
                remove_call_out("checking");
                call_out("checking", 1, me, victim);
        }

        return 1;
}

void die()
{
		  int pot,exp;
		  object me=this_object();
		  object ob = me->query_temp("last_damage_from");

		 if( !living(me) ) {revive(1);reincarnate();}

		  if(!ob || me->query("combat_exp",1) < ob->query("combat_exp",1)/2 )
		  {
					 ::die();
					 return;
		  }


		  if( random(2) == 0 )
		  {
					 exp = 10+random(30);
					 pot = 10+random(30);
					 ob->add("combat_exp", exp);
					 ob->add("potential", pot);
					 if ( ob->query("potential") > ob->query("max_potential") )
				        ob->set("potential", ob->query("max_potential"));
					 tell_object(ob,HIG"\n你获得"+pot+"点潜能和"+exp+"点经验！\n"NOR);
					 ::die();
		  }
		  else
		  {			
                                   exp = 30+random(10);
					 pot = 10+random(30);
					 message_vision(HIY"\n突然$N跳出战圈不打了，冷冷地说道“今天运气不好，下次再来收拾你”。\n"NOR, this_object());
					 message_vision(HIY"\n说罢$N急急忙忙地离开了。\n"NOR, this_object());
                                                              ob->add("combat_exp", exp);
                                                              ob->add("potential", pot);
					 tell_object(ob,HIG"\n你获得"+pot+"点潜能和"+exp+"点经验！\n"NOR);
					 if(ob->query("potential",1)>ob->query("max_potential",1) )
				              ob->set("potential",ob->query("max_potential",1));
					 destruct(me);
		  }
}


