int accept_kill(object obj)
{
        if (obj->is_killing(this_object()) ) return 1;
        command("menpai* 报告：赤龙门所镇守的要道有敌人入侵，大家多加小心！");
}

void die()
{
        command("menpai* corpse");
	::die();
}
void init()
{

  add_action("do_start", "command");
  add_action("do_start", "命令");
  add_action("do_start", "开始");
  add_action("do_start", "start");
  add_action("do_start", "镇守");

  add_action("do_stop", "abandon");
  add_action("do_stop", "fangqi");

}

int do_start()
{
  int exp;
  object ob, blk, obj=this_object();
  ob = this_player();
  exp =  ob->query("combat_exp",1);
  if ( ob->is_busy() || ob->is_fighting() )
    {
      tell_object(ob, "你现在正忙着！\n");
      return 1;
    }           
   if(!present("chilong ling", this_player()))

   return notify_fail("无凭无据，如何让弟子听从你的吩咐？\n");


  message_vision(HIR"$N拿出腰间的赤龙令，对弟子说道：“我等奉教主之命，来到此处镇守要道！”。\n"NOR, ob);

  if ( ob->query("job/start") )
    {
      command("say 你不是正在镇守要道么？");
      return 1;
    }

  if (query_temp("stock") > 0)
    {
      command("say 此地已经有人镇守了。");
      return 1;
    }

  add_temp("stock", 1);
  ob->set("job/start", "1");
  message_vision(HIC"弟子接过$N手上的赤龙令看了看，然后还给$N。\n"NOR, ob);
  message_vision(HIC"弟子点了点头说道：“你等先在此地巡逻，记住一定要用尽全力镇守此地”。\n"NOR, ob);
  this_job = 1; 
  obj->set("combat_exp",exp);
  blk=new("/d/shenlong/npc/clblkdizi");
  blk->move("/d/shenlong/beach");
  call_out("robber", 30, ob);
  return 1;
}

void robber(object obj)
{
  int i ,num;
  object ob,robber;
  ob = this_player();
  num = 2+random(1);
  message_vision(HIW"\n突然从沙滩上那边冲过来"+chinese_number(num)+"个清兵！手上拿着兵器，看起来气势汹汹！\n"NOR, ob);
  ob->set_temp("herb_victim", 1);
  for (i=0; i<num; i++)
{
  robber=new("/d/shenlong/npc/sl_npc");
  robber->move("/d/shenlong/haitan1");
  robber->kill_ob(ob);
  ob->kill_ob(robber);
}
  call_out("robber2", 120, ob);

}

