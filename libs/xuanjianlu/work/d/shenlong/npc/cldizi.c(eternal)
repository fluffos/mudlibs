void finish_job(object me,object obj)

{
  object ling,ob,*ob2;
  int exp,exp2,i;
  ob = this_player();
  ling = present("chilong ling", ob);
  if ( (this_job) )
  {
  message_vision(HIY"只见神龙岛上红旗飘扬，一个教众跑了过来！\n"NOR, ob);
  message_vision(HIY"教众对$N说道：“教主恭喜赤龙副使凯旋归来！”\n"NOR, ob);
  exp = 1000+random(500);
  exp2 = exp/2;
  ob->add("combat_exp", exp);
  ob->add("shenlong/gonglao", 500);
  tell_object(ob,HIG"\n这次坚守你获得一些经验！\n"NOR);
  tell_object(ob,HIG"\n这次坚守你获得五百点神龙功劳！\n"NOR);

  tell_object(ob,HIG"\n你的每个下属获得一些经验！\n"NOR);
  tell_object(ob,HIG"\n你的每个下属获得一百点神龙功劳！\n"NOR);

  ob->delete("job/start");
  add_temp("stock", -1);
  ob2 = all_inventory(environment(me));

  for(i=0; i<sizeof(ob2); i++) {
  if( !living(ob2[i]) || ob2[i]==me ) continue;

  if (!ob2->query_temp("shenlong/share赤龙"))

  {
      return 0;
  }
			tell_object(ob2[i], HIG"\n你获得一些经验！\n"NOR);
			tell_object(ob2[i], HIG"\n你获得一百点神龙功劳！\n"NOR);
			ob2->add("combat_exp", exp2);
			ob2->add("shenlong/gonglao", 100);

 message_vision(HIY"$N将赤龙令交给弟子，然后走了出去。”\n"NOR, ob);
 ob->move("/d/shenlong/beach");
 ob->delete_temp("shenlong/ling");
 destruct(ling);
 ob2->delete_temp("shenlong/share赤龙");
 this_job = 0;
}
}

}

int do_stop()

{
  object ob;
  ob = this_player();
  if (!ob->query("job/start") )
    {
      return 1;
    }
  message_vision(HIY"$N决定放弃这次坚守！\n"NOR, ob);
  this_job = 0;
  ob->delete("job/start");
  ob->add("shenlong/gonglao",-500);

  ob->move("/d/shenlong/beach");

  add_temp("stock", -1);
  return 1;
}