#include <ansi.h>
inherit NPC;
int do_sayd(string arg);

void create()
{
	set_name("渔夫", ({ "yu fu", "yufu" }));
	set("long", 
	"一位神龙教教众化妆的渔夫。\n");
	set("gender", "男性");
	set("age", 40);
	set("no_sing",1);
	set("no_kill",1);	
	set_skill("unarmed", 120);
	set_skill("dodge", 100);
	set_skill("parry", 100);
	set_skill("ding-dodge", 120);
	set_skill("ding-force", 120);
	set_skill("ding-unarmed", 120);
	map_skill("force","ding-force");
	map_skill("dodge","ding-dodge");
	map_skill("unarmed","ding-unarmed");
	prepare_skill("unarmed","ding-unarmed");
	set("max_neili",2000);
	set("neili",2000);
	set("jiali",100);

	set("combat_exp", 600000);
	set("shen_type", 1);
	setup();
	carry_object("/d/city/obj/cloth")->wear();
}

void init() 
{
	add_action("do_sayd", "wenchuan");
}

int do_sayd(string arg)
{
	object me,obj;
	string event = NATURE_D->outdoor_room_event();
	me= this_player();
	if( !arg || arg == "" ) return 0;
	if (arg != "神龙教主，仙福永享，寿与天齐")
		return notify_fail("你要说什么？\n");
	
	if (me->query("family/family_name") != "神龙教" )
		return 0;
		
	if( me->is_busy() ) {
		write("渔夫说道：等" + RANK_D->query_respect(me) + "您忙完了，小的立刻上路。\n");
		return 1;
	}
	write("你在渔夫身边悄声说道：“神龙教主，仙福永享，寿与天齐！”。\n");
	message_vision(HIG"\n渔夫在$N耳边说道：“来吧，我送你回中原！”。\n"NOR,me);
	message_vision(HIY"\n渔夫领着$N走进一条小船。\n"NOR,me);
	message_vision(WHT"\n小船缓缓的开走了。\n"NOR,me );
	me->move("/d/shenlong/xiaochuan1");
	return 1;
}