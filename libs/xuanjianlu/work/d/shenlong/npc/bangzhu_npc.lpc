	set("real_long", "这是一位大理官差，因大理境内眼见神龙弟子胡作非为，良心发现，叛逃神龙。此人一身大理武功出类拔萃。\n");
	set("real_title", "大理王府");
	set("real_menpai", "dali");
		break;
	case 5:
	set_name("丐帮弟子", ({ "gaibang dizi", "dizi"}) );
	set("long","这是曾经的青竹帮帮主，后投身神龙，潜伏于丐帮，此人一身丐帮武功出类拔萃。\n");	
       set("gender", "男性");
	set("age", 53);
	set("real_name","洪万枪");
	set("real_long", "这是一名丐帮九袋长老，此人一身丐帮武功出类拔萃。\n");
	set("real_title", "丐帮");
	set("real_menpai", "gaibang");
		break;

	}
	set("str", 20);
	set("con", 20);
	set("int", 20);
	set("dex", 20);

	set("attitude", "peaceful");
