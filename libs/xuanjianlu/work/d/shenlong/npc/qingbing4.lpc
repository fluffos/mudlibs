inherit NPC;


void create()
{
	set_name("清兵", ({
		"qing bing",
		"bing",
	}));
	set("long",
		"一个自以为是的清兵。\n"
	);

	set("gender", "男性");
	set("attitude", "aggressive");
	set("no_get", "清兵对你而言太重了。");

	set("age", 20);
	set("shen_type", 1);
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 20);

       set("max_qi", 9555);
       set("max_jing", 9000);
       set("max_jingli", 9000);
       set("eff_jingli", 9000);
       set("jingli", 9000);
       set("jing", 9000);
	set("neili", 9000);
	set("max_neili", 6000);

	set("combat_exp", 800000);
	

	set_skill("force", 200);
	set_skill("kurong-changong", 200);
	set_skill("dodge", 200);
	set_skill("duanshi-shenfa", 200);
	set_skill("strike", 200);
	set_skill("qingyan-zhang", 200);
	set_skill("parry", 200);
	set_skill("buddhism", 200);
	set_skill("finger", 200);
	set_skill("yiyang-zhi", 200);
	set_skill("staff", 200);
	set_skill("sword", 200);
	set_skill("duanjia-jian", 200);


	map_skill("force", "kurong-changong");
	map_skill("sword", "duanjia-jian");
	map_skill("dodge", "duanshi-shenfa");
	map_skill("staff", "duanjia-jian");
	map_skill("strike", "qingyan-zhang");
	map_skill("parry", "yiyang-zhi");
	map_skill("finger", "yiyang-zhi");
       prepare_skill("strike", "qingyan-zhang");
       prepare_skill("finger", "yiyang-zhi");

       create_family("大理段家", 5, "弟子");

	setup();

	switch( random(3) )
	{
		case 0:
			carry_object("/clone/weapon/gangdao")->wield();
			break;
		case 1:
			carry_object("/clone/weapon/gangzhang")->wield();
			break;
		case 2:
			carry_object("/clone/weapon/gangjian")->wield();
			break;
	}
            carry_object("/clone/armor/tiejia")->wear();

}


void init()
{
	object ob = this_player();
	
	::init();

	if (interactive(ob))
	{
		command("say 乱闯兵船者！杀无赦！");
		remove_call_out("kill_ob");
		command("exert kurong");
        	command("unwield gangdao");
		command("kill "+ob->query("id")); 
		command("perform qiankun "+ob->query("id"));
		command("perform piaomiao "+ob->query("id"));
		command("perform ailao "+ob->query("id"));
		command("perform yiyang "+ob->query("id"));


	}       
}


