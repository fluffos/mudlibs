#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", HIY"海滩"NOR);
        set("long", @LONG
但见岸上树木苍翠，长长的海滩望不到尽头，尽是雪白的细沙，四处一片
寂静，听不见一点声音，西面是大海，东面仿佛有一座山峰，两旁是望不到尽
头的海滩。
LONG
        );

	set("exits", ([

		"south" : __DIR__"beach",
		"east" : __DIR__"shulin1",
		"north" : __DIR__"haitan",

        ]));
        set("objects", ([
            "/d/shenlong/npc/hldizi" : 1,
            "/d/shenlong/npc/heilong" : 1,
        ]));
	set("cost", 2);

        setup();
}





int valid_leave(object me, string dir) {
    object ob;


    if ( me->query("job/start") )
              if (objectp(present("di zi", environment(me)))) 
                      return notify_fail("你现在正在镇守要道，如果要离开请放弃(abandon)，你会损失一些神龙教功劳！\n"); 
              else             
              { 
                      message_vision("$N看形势不妙，急急忙忙溜走了。\n", me);          
       
                      me->delete("job/start");
                      me->add("shenlong/gonglao",-500);
              } 

        return ::valid_leave(me, dir);
}

void init()
{

        add_action("do_quit", "quit");

}



int do_quit()

{
        write("这里目前无法退出游戏。\n");
        return 1;
}


