
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "竹林");
        set("long", @LONG
面前是一片翠绿的竹林，这儿安静多了。偶尔有几个人走过，似乎都诚惶
诚恐的样子，你不由得吸了一口气，把挂在嘴边的话又咽了回去。西面是一个
竹房，北面又是一片竹林，东面是一所竹堂。
LONG
        );

        set("outdoors", "shenlong");
        set("exits", ([
                "west" : __DIR__"liangongfang1",
                "east" : __DIR__"liangongfang2",
                "south" : __DIR__"shibanlu",
                "north" : __DIR__"zhulin2",
        ]));

        set("objects", ([
        ]));

        set("cost", 1);

        setup();

        replace_program(ROOM);
}

