#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "青石板路");
  set("long", @LONG
一条幽静的青石板路，一头通向大厅，一头通向竹林，路旁放着几盆花
卉，开着菊花、蔷薇等，煞是艳丽。西面是药房，东面是武器库。
LONG
  );
  set("outdoors", "shenlong");
  set("exits", ([
    "south": __DIR__ "dating",
    "north": __DIR__ "zhulin1",
    "west": __DIR__ "yaofang",
    "east": __DIR__ "wuqiku",
  ]));

  set("cost", 1);

  setup();
  replace_program(ROOM);
}
