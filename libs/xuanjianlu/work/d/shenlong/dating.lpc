//Pingguo

inherit ROOM;
#include <ansi.h>;


void create() {
  set("short", "大厅");
  set("long", @LONG
你来到了一个大厅之中，这厅硕大无朋，足可容
得下千人之众，一群群少男少女分五色站好，每
个队列之前都站着一个头目。大厅四周有很多出
口。
LONG
  );
  set("outdoors", "shenlong");

  set("exits", ([
    "north": __DIR__ "shibanlu",
    "south": __DIR__ "changlang3",
  ]));
  set("objects", ([
    CLASS_D("shenlong") + "/yinjin": 1 ]));
  set("cost", 3);
  setup();
  //	replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");

  if ((!myfam || myfam["family_name"] != "神龙教")
    && objectp(present("yin jin", environment(me)))) {

    if (dir == "north" || dir == "west" || dir == "east")
      // north 是上山的路线，本来打算在west and east增加两个出口作为它用.
      return notify_fail("殷锦冷笑一声“想上去杀了我再说！”。\n");
  }
  return ::valid_leave(me, dir);
}
