//Pingguo

inherit FERRY;

void create() {
  set("short", "山溪");
  set("long", @LONG
沿山溪而行，溪水淙淙，草木清新，颇感心旷神怡。
往东是一座山丘，北面是一道天然形成的山坡，向西
眺望，便是一道平静宽广的山溪。
近岸处有一叶小舟，也许喊(yell)一声船家就能听见。
LONG
  );

  set("exits", ([
    "northup": __DIR__ "shanpo1",
    "east": __DIR__ "shanqiu",
  ]));



  set("outdoors", "shenlong");
  set("cost", 1);

  set("name", "溪");
  set("boat", __DIR__ "duchuan");
  set("opposite", __DIR__ "shanxi1");

  setup();
}
