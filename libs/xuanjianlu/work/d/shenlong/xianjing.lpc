

#include <ansi.h>
inherit ROOM;
int look_sksleton(string);
int jump(string);
int climb(string);
int search(string);
void create()
{
	set("short", "陷阱");
	set("long", @LONG
这个陷阱有三，四丈之高，是神龙教为了防止外敌入侵所挖的
陷阱，里面机关重重，只有一小块地方仅仅够你站着的。陷阱中有
一块大钢板，上面有许多的骸骨(skeleton)，通过衣服，你能分辨
出他们有些是清兵，有些人武林人士。不知道可不可以爬(climb)出
去或者跳出去(jump)。
LONG
	);


	set("cost", 2);



	setup();
}

void init()
{

	object me = this_player();
	if( interactive(me = this_player()) ) {
	    remove_call_out("dropping");
	    call_out("dropping", 1);
	}
       add_action("look_skeleton", "look");
       add_action("climb", "climb");
       add_action("search", "search");
       add_action("throw", "throw");
       add_action("throw", "reng");
       add_action("search", "find");
       add_action("jump", "jump");

}

void dropping()
{
	object me = this_player();



	if( interactive(me = this_player()) ) {
		message_vision( HIR "\n$N的眼前突然出现一个无底的深渊...$N掉入了陷阱之中。\n" NOR, me);
		message_vision( HIB "\n陷阱中的钢板突然冒出许多锋利的钢针，深深地扎入了$N的身体中...\n" NOR, me);

		me->receive_wound("qi",1000, "被钢针扎死了。");

		me->unconcious();

	}
}


int look_skeleton(string arg)
{
        if( !arg || arg!="skeleton" ) return 0;
        write("钢针上有很多的骸骨，你随便看了其中的一具。\n");
        switch (random(7)) {
        case 0:
          write("这具骸骨上的衣服中间有一个清字！\n");
          break;
        case 1:
          write("这还是一具清兵的骸骨！\n");
          break;
        case 2:
          write("这具骸骨比较小，可能还是一个孩子。\n");
          break;
        case 3:
          write("这具骸骨的衣服上面有一个龙的标志。\n");
          break;
        case 4:
          write("这具骸骨上面有个牌子，上面写着“严禁随地大小便”真是!@#$!#@#$！\n");
          break;
        case 5:
          write("一具没脑袋的骸骨！\n");
          break;
        case 6:
          write("这具骸骨的衣服口袋鼓鼓囊囊的，不知道有什么，你不禁想要找找(search)看。\n");
          break;
 
        }
        return 1;
}

int search(string arg)
{
	 object obj,me = this_player();

        if( !arg || arg!="skeleton" ) return 0;
        write("你将手塞入骸骨的衣服口袋仔细的摸索着。\n");
        switch (random(3)) {
        case 0:
          write("突然从骸骨的口袋里面摸出一条毒蛇！\n");
          obj = new("/d/shenlong/npc/snake");
          obj->move(environment(me));
          break;
        case 1:
          write("突然从骸骨的口袋里面摸出一张布！\n");
          obj = new("/d/shenlong/obj/xueshu");
          obj->move(environment(me));
          break;
        case 2:
          write("突然从骸骨的口袋里面摸出一捆绳子。\n");
          obj = new("/d/village/npc/obj/rope");
          obj->move(environment(me));
          break;
      
 
        }
        return 1;
}

int jump(string arg)
{
        object me = this_player();

        if ( !arg || arg != "up" )
             return notify_fail( "你要往哪里跳？\n");

	if (me->is_busy())
	     return notify_fail("你正忙着呢！\n");	

        message_vision(HIG"$N猛地纵身越起，想要从陷阱口跳出去。\n"NOR, me);

        if ( me->query_skill("dodge",1) <= 200 ) {
             message_vision(HIY"$N双足用力腾空而起，怎奈失去重心，摔在钢板之上\n"NOR, me);
             message_vision(HIY"一声惨嚎，$N的身体扎在钢针之上，鲜血涌出，眼看活不成了。\n"NOR, me);
             me->receive_wound("qi", me->query("max_qi")+100, "被钢针扎死了");
        }

        if ( me->query_skill("dodge",1) > 200 && me->query_skill("dodge",1) < 400 ) {
             message_vision(HIY"$N双足用力腾空而起，怎奈失去重心，急忙使出“千斤坠”\n"NOR, me);
             message_vision(HIY"，避开钢针，缓缓的落在墙边。\n"NOR, me);
             me->unconcious();
        }

        
        if ( me->query_skill("dodge",1) >= 400 ) {
             me->move(__DIR__"shanlu3");
             message_vision(HIY"$N终于逃出这“监牢”了。\n"NOR, me);
             message("vision", me->name() + "纵身从陷阱口跃出，缓缓地落在洞口外面！\n",environment(me), ({me}) );
        }

        return 1;
} 

int throw(string arg)
{
        object me = this_player();

        if ( !arg || arg == "" ) return 0;

        if ( arg == "sheng zi" ) {
                if ( !present("sheng zi", me) )
                        write("你要扔什么？\n");
                else {
                        message_vision("$N将绳子扔出陷阱。\n", me);
                        me->set_temp("tied", 1);
                }

                return 1;
        }

        return 0;
}

int climb(string arg)
{
        object me = this_player();

        if ( arg && arg != "up" )
                return notify_fail("什么？\n");

        if(me->query_encumbrance() * 10 / me->query_max_encumbrance() > 10/100)
                return notify_fail("你负重太多，身子腾挪不开。\n");

        if ( !me->query_temp("tied") )
                return notify_fail("没东西支撑你怎么爬呀？\n");

        message_vision("$N拉着绳子开始往上爬。\n", me);
        message("vision", me->name()+"一会儿便爬了一半了。\n", environment(me), ({me}) );
        tell_object(me, "你向下一望，只见脚下都是钢针和骸骨，不由得心惊胆跳！\n");

        if (  me->query("str") <= 20 || me->query("con") >= 25 || me->query_skill("dodge") > 50 ) {
                me->move(__DIR__"shanlu3");
                message("vision", me->name()+"从陷阱爬了出来。\n", environment(me), ({me}) );
                me->delete_temp("tied");
                tell_object(me, HIY"你顺着绳子爬出了陷阱！\n"NOR);
        }
        else {
                tell_object(me, HIR"突然间绳子“啪”地一声断了，你发出一连串凄历的惨嚎，身不由主地往钢针上坠落！\n"NOR);
                me->delete_temp("tied");
                me->move(__DIR__"xianjing");
                message("vision", me->name()+"由洞口直坠下来!\n", environment(me), ({me}) );
                me->receive_wound("qi", me->query("max_qi")+100, "被钢针扎死了。");
        }

        return 1;
}