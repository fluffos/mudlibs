

#include <ansi.h>
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
#include "/clone/unique/special_weapon.h"
void create()
{
	set_name(HIC"斩马刀"NOR, ({ "zhanma dao", "dao" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "一柄刀身十分薄，刀刃非常锋利的刀，是清朝将领打仗指挥用刀。\n");
		set("value", 30000);
		set("material", "steel");
		set("rigidity", 500);
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插回腰间。\n");
	}
	init_blade(55);
	setup();
}
