#include <ansi.h>
#include <room.h>
inherit ROOM;

void init() {
  add_action("do_get", "get");
}

void create() {
  set("short", "女睡房");
  set("long", @LONG
神龙教的女睡房，虽说是厢房，却也十分宽敞，陈设雅洁，你真想
躺在床上美美地睡上它一觉。
LONG
  );
  set("sleep_room", 1);
  set("no_fight", 1);
  set("no_steal", 1);

  set("exits", ([
    "south": __DIR__ "liangongfang2",
  ]));
  set("cost", 1);

  setup();
}

int do_get(string arg) {
  object obj;

  if (arg
    && objectp(obj = present(arg, environment(this_player())))
    && obj->is_character()) {
    write("你不能搬动玩家的身体。\n");
    return 1;
  } else
    return 0;
}
