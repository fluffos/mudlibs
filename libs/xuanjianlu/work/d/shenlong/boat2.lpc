inherit ROOM;
#include <ansi.h>
#include <login.h>
void create()
{
        set("short",HIR"炮船甲板"NOR);
        set("long", @LONG
此船乃水师主力，身高大，首昂尾翘，航行迅速，不惧风浪。
树三桅，主桅高四丈，船长二十丈，舱五层，船面设楼高如城，
可容三百余人，配红夷炮八门，千斤佛郎机四十门。      
LONG );

        set("outdoors", "shenlong");
         set("exits", ([
                "north" : __DIR__"boat3",
                "south" : __DIR__"boat1",
                "east" : __DIR__"haitan1",
                "down" : __DIR__"boat5",
        ]));
        set("objects", ([
            "/d/shenlong/npc/qingbing" : 1,
            "/d/shenlong/npc/qingbing2" : 1,
            "/d/shenlong/npc/qingbing3" : 1,
        ]));
        set("cost", 1);
        setup();
}


int valid_leave(object me, string dir)
{

        if ( dir == "east" )
        {
                if ( me->query_skill("lingshe-shenfa", 1) < 100 )
                {
                        message_vision( HIY
                "\n「啊～～～～～～～」\n"
                "\n「～～～～」\n"
                "\n「……」\n"
                "\n船下突然传来$N一阵极凄厉的惨叫声。\n" NOR, me );
                me->set("eff_qi", 10);
                me->set("qi", -1);
                me->move("/d/shenlong/haitan1");
                return notify_fail("\n\n★……☆～～你被摔的眼冒金星～～\n" );

                }               

                message_vision( HIW
                "$N施展灵蛇身法，从船身甲板逾越回岸边。\n"
                "只见$N身轻如燕，缓缓地落在岸边。\n" NOR, me );

        }

        return ::valid_leave(me, dir);
}