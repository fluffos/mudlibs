//树林


inherit ROOM;

void create()
{
        set("short","树林");

        set("long",@LONG
一片茂密的树林，地上有不少的尸体，有官兵的也有神龙教弟子的。
LONG);

        set("exits",([ "southwest" : __DIR__"shulin1",
                        "south" : __DIR__"shulin2",
                        "east" : __DIR__"shulin6",
                      ])
			  );
	  set("cost",2);
	  set("outdoors", "shenlong");

        setup();

}



