#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "小船");
  set("long", @LONG
一条开往神龙岛的小船。船不大但是速度很快。
你坐在船上欣赏着船外的风景。
LONG
  );

  set("cost", 2);

  setup();
}


void init()

{
  call_out("move", 15, this_player());
}


void move(object me) {

  write("\n转眼间你回到了中原。\n");
  me->move("/d/beijing/tanggu");
  message("vision", me->name() + "从小船走了出来。\n", environment(me), ({ me }));

  write("\n你从小船上走了出来。\n");

  me->start_busy(3);
}
