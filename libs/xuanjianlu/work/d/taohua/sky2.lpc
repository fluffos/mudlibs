// sky1.c
// xuanyuan 2002.4.7

inherit ROOM;
void create()
{
        set("short", "天空");
        set("long", @LONG
你身在云层之中，穿梭在云彩之间，你一低头发现下面已是一片汪洋大
海，海水深蓝，与天接色一望无际。
LONG
        );
        set("no_fight",1);
        setup();
}
void init()
{
       object ob = this_player();

    call_out("run", 15, ob);
}

void run(object ob)
{
        if (environment(ob) == this_object())
        ob->move(__DIR__"sky3");
        write("\n你坐在白雕的背上，身子飞翔于空中，下面是汪洋大海，蓝色的海水中偶尔浮\n"
"上一朵朵白色的浪花，海风不象陆上的风那般干涸，揉润的海风拂在脸上，真\n"
"是说不出的滋润。。\n\n");
}


