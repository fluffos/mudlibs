// sky1.c
// xuanyuan 2002.4.7

#include <ansi.h>
#define MAPDB "/clone/obj/mapdb"
inherit ROOM;
void create()
{
        set("short", "天空");
        set("long", @LONG
你身在云层之中，穿梭在云彩之间，东方的天空呈湛蓝色，略显柔和，
偶尔看见几只飞鸟从身边划过。
LONG
        );
        set("no_fight",1);
        setup();
}

void init()
{
	object ob = this_player();
	string* msgfly, msg;

	if ( ob->query("kar") < (5+random(10)) && ob->query("dex") < random(10) ) {
		msgfly = ({
			"蓦地里那雌雕纵身长鸣，抛下$N，振翅向北飞去。那雄雕飞高一望，鸣声啾急，随后急赶。",
			"雌雄双雕形体虽巨，背上负了人毕竟难以远飞，不多时便即不支，越飞越低，终于着地。",
			});
		
		msg = HIR"\n"+ msgfly[random(sizeof(msgfly))] +"\n" NOR;
		message_vision(msg, ob);

		ob->delete("rided");
		ob->delete_temp("taohua/fly");
	    remove_call_out("do_random_move");
	    call_out("do_random_move", 2, ob); // unconcious at least 30 sec
	}
	else call_out("run", 10, ob);
}


void run(object ob)
{
        if (environment(ob) == this_object())
        ob->move(__DIR__"sky2");
        write("\n你坐在白雕的背上，身子飞翔于空中，地上的景物越来越小，山川河流向赶集\n"
"似的匆匆向身后流去，微风在耳边吹拂着，有种飘飘欲仙的感觉。远处依稀可\n"
"以看见大海的轮廓。。\n\n");
}

int do_random_move(object ob) {
    string room_path;
    object mapdb, room;

    mapdb = find_object(MAPDB);
    if (! objectp(mapdb))	  mapdb = new(MAPDB);
    if (! objectp(mapdb)) 	  return -1;
    if (strsrch(base_name(environment(ob)), "/d/death/") == 0) return -1;

    mapdb->restore();
    room_path = mapdb->query_random_room_path();
    if (strsrch(room_path, "/d/island/")==0 ||
	strsrch(room_path, "/d/taohua/")==0 ||
	strsrch(room_path, "/d/shenlong/")==0 ||
	strsrch(room_path, "/d/hengshan2/")==0 ||
	strsrch(room_path, "/d/henshan/")==0 ||
	strsrch(room_path, "/d/kunlun/")==0 ||
	strsrch(room_path, "/d/taohuacun/")==0 ||
	strsrch(room_path, "/d/xiangyang/")==0 ||
	strsrch(room_path, "/d/murong/")==0 ||
	strsrch(room_path, "/d/tianying/")==0 ||
	strsrch(room_path, "/d/bwdh/")==0 ||
	strsrch(room_path, "/d/em/")==0 ||
	strsrch(room_path, "/d/death/")==0 ||
	strsrch(room_path, "/d/wizard/")==0 ||
	strsrch(room_path, "/d/xiakedao/")==0) return -1;

    room = find_object(room_path);
    if (!objectp(room))   room = load_object(room_path);
    if (!objectp(room)) return -1;

    ob->move(room);
    message_vision("突然$N从半空中掉了下来。\n", ob);
    ob->unconcious();

    return 0;
}
