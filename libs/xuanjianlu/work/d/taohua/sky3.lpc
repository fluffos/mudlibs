// sky1.c
// xuanyuan 2002.4.7

inherit ROOM;
void create() {
  set("short", "天空");
  set("long", @LONG
你身在云层之中，穿梭在云彩之间，下面是汪洋大海，海水深蓝，与天
接色一望无际。东方隐约可以看见一个小岛。
LONG
  );
  set("no_fight", 1);
  setup();
}

void init() {
  object ob = this_player();

  call_out("run", 15, ob);
}

void run(object ob) {
  if (environment(ob) == this_object())
    ob->delete("rided");
  ob->delete_temp("taohua/fly");
  ob->move("/d/taohua/harbor");
  write("\n经过长途跋涉，双雕终于飞抵了桃花岛。\n\n");
}
