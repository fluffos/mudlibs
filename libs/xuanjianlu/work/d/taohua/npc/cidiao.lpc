// 雌雕
// Xuanyuan 2002.4.7

#include <ansi.h>
inherit F_UNIQUE;
inherit NPC;
void create()
{
		seteuid(getuid());
        set_name("雌雕", ({ "ci diao", "diao" }) );
        set("race", "飞禽");
		set("subrace","走禽");
        set("age", 20);
        set("long", 
"一只白雌雕，身形奇巨，比之常雕大出倍许，实是异种。雕羽白色本\n"
"已稀有，而雕身如此庞大，蒙古族中人都说是一对“神鸟”\n");

        set("attitude", "peaceful");

        set("limbs", ({ "头部", "身体", "翅膀", "爪子", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );

		set("str", 50);
		set("con", 40);
		set("dex", 80);
		set("int", 20);

        set("max_jing", 1000);
        set("max_jingli", 1000);
        set("max_qi",   1000);
        set("max_neili",800);
        set("neili",    800);
        set("jiali",     0);

		set("ability", 8);

        set("combat_exp", 50000);
        set_temp("apply/attack", 50);
        set_temp("apply/damage", 50);
        set_temp("apply/dodge",  50);
        set_temp("apply/armor",  50);

		set_skill("dodge", 100);
		set_skill("claw", 100);

        set("chat_chance", 10);
        set("chat_msg", ({
		"双雕齐声长鸣。\n",
		"双雕在空中盘旋飞翔，不住啼鸣。\n",
        }) );

	setup();
        ::create();
}

int init()
{
        add_action("do_ride","shang");
        add_action("do_ride","qi");
        add_action("do_ride","zuo");
        add_action("do_unride","xia");
        add_action("do_unride","unride");
        add_action("do_fly","fly");
        add_action("do_fly","fei");
}

int do_ride(string arg)
{
	object ob = this_object();
	object me = this_player();
	string* msgride, msg;

	if( !arg || !ob = present(arg, environment(me)) )
		return notify_fail("你要骑什么？\n");

	if (me->query_busy())
		return notify_fail("你正忙着呢！\n");

	if( me->query("family/family_name") != "桃花岛" && me->query("family/master_name") != "黄药师")
		return notify_fail("就你也想骑这白雕？别做梦了！\n");

	if (!living(ob))
		return notify_fail("先等它醒过来在说吧。\n");

	if( !me->query("rided") )
	{
		if( !ob->query("rider") || ob->query("rider") == me)  
		{
			me->set("rided", ob);
			me->set_temp("canfly", 1);
			ob->set("rider", me);
			msgride = ({
				"$N伏上雌雕之背，搂住雕颈，口中一声呼啸，双雕振翅而起。",
				"$N伏上雌雕之背，斗然凭虚临空，双雕一飞离地，立感平稳异常。",
				"$N伏上雌雕之背，初时还怕自己身子重，那雕儿未必负荷得起，岂知那白雕双翅展开，竟然并无急堕之像。",
				});
		
			msg = HIG"\n"+ msgride[random(sizeof(msgride))] +"\n" NOR;
			message_vision(msg, me);
			me->start_busy(2);
			return 1;
		}
		else return notify_fail( (ob->query("rider"))->name() + "已经骑在它身上了！\n");
	}
	else return notify_fail("你已经骑在" + (me->query("rided"))->name() + "上了！\n");
}

int do_unride(string arg)
{
	object ob = this_object();
	object me = this_player();
	if( !arg 
	|| !objectp(ob = present(arg, environment(me)))
	|| ob != me->query("rided")
	|| ob->query("rider") != me)
		return notify_fail("你要干什么？\n");

	me->delete("rided");
	me->delete_temp("canfly");
	ob->delete("rider" );
	message_vision("\n$N一纵身，从" + ob->name() +"身上跃了下来。\n", me);

	return 1;
}

int do_fly(string arg)
{
	object ob = this_object();
	object me = this_player();
	object xiongdiao;
	string* msgfly, msg;

	if( !me->query_temp("canfly") )
		return notify_fail("你还没骑上去就想飞？\n");

	if ( arg !="taohuadao" ) 
		return notify_fail("你要飞到哪里去？\n");

	if (me->query_busy())
		return notify_fail("你正忙着呢！\n");

	if( me->query("family/family_name") != "桃花岛" && me->query("family/master_name") != "黄药师")
		return notify_fail("白雕不肯听你的话！\n");

	if (!living(ob))
		return notify_fail("先等它醒过来在说吧。\n");

	if ( !present("xiong diao", environment(me) ) )
		return notify_fail("双雕须一道飞行，你还是先去找找雄雕去吧。\n");

	if( me->query_temp("canfly") && me->query("rided") && !me->query_temp("taohua/fly") )
	{
		msgfly = ({
			"雌雕背上$N，纵吭欢唳，振翅直上，转眼之间，双雕已飞出老远。",
			"双雕负着$N，比翼东去，转眼之间，双雕已飞出老远。",
			"双雕升空打了几个盘旋，负着$N投东而去。",
			"双雕齐声长鸣，振翼而起，在天空盘旋一周，向东而去，片刻之间已隐没云中。",
			"只见那雌雕双翅一振，高飞入云，盘旋数圈，负着$N投东而去。",
			});
		
		msg = HIY"\n"+ msgfly[random(sizeof(msgfly))] +"\n" NOR;
		message_vision(msg, me);

		me->start_busy(2);
		me->delete("rided");
		ob->delete("rider");
		me->delete_temp("canfly");
		me->set_temp("taohua/fly", 1);

		if ( xiongdiao = present("xiong diao", environment(me)) ) 
		destruct(xiongdiao);
        me->move("/d/taohua/sky1");
		destruct(ob);

		return 1;
	}
	else return notify_fail("你已经骑在" + (me->query("rided"))->name() + "上飞翔了！\n");
}