#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "度母殿");
  set("long", @LONG
这里是大轮寺的度母殿，正中五尊大座佛，均为高肉髻、外披
袒右袈裟、结跏趺坐、执手印须弭坐各异。殿内对称排列四根大柱，
上雕忍冬纹，下刻连珠纹。北壁上供有两尊金刚像：马头明王和阎
魔护法。
LONG
  );
  set("exits", ([
    "north": __DIR__ "changlang",
    "southdown": __DIR__ "yanwu",
  ]));
  set("objects", ([
    __DIR__ "npc/zrlama": 1,
    __DIR__ "npc/xs_job/xs_deng": 1,
    "/clone/obj/tonggang": 1,
  ]));

  set("cost", 1);
  setup();
  //        replace_program(ROOM);
}
void reset_to_dizi(string name, string family) {
  object obj, ob;
  if (objectp(obj = present("tong gang", this_object()))) {
    //弟子跑掉减少遍照雪海内的油
    if (objectp(ob = present("su you", obj))) {
      remove_call_out("reset_to_fire");
      call_out("reset_to_fire", 1, obj, ob, name, family);
      return;
    }
  }
}
void reset_to_fire(object obj, object ob, string name, string family) {
  remove_call_out("start_fire");
  if (family) {
    obj->add("xs_chanchu/" + family, 3);
    obj->save();
  }
  message_vision("一位" + name + "突然出现在大殿，往铜缸$N中投入一根燃烧的火把，一旋身消失在屋脊后！\n", obj);
  call_out("start_fire", 2, obj, ob, 0);
}
void start_fire(object obj, object ob) {
  remove_call_out("end_fire");
  message_vision(
    HIR "铜缸$N" + HIR + "内的" + NOR + "$n" + HIR + "腾起数丈高的烈焰，熊熊的火焰映红了整个寺院！\n" NOR,
    obj,
    ob
  );
  call_out("end_fire", 8, obj, ob, 0);
}
void end_fire(object obj, object ob, int i) {
  int sum;
  remove_call_out("end_fire");
  sum = obj->query_current_liquid() / (10 + random(10));
  i++;
  if (i == 3)
    message_vision(HIC "铜缸$N" + HIC + "内的火焰终于熄灭了！\n" NOR, obj);
  if (i == 2)
    message_vision(RED "$N" + RED + "内冲天的火焰慢慢减缓了火势！\n" NOR, obj);
  if (i == 1)
    message_vision(HIB "无数的喇嘛手提木桶和灭火器具冲向大殿！\n" NOR, obj);
  if (obj->query_current_liquid()) {
    obj->add_current_liquid(-sum);
    obj->add("liquid_remaining", -sum);
    ob->add_amount(-sum);
  }
  if (ob->query_amount() < 1 || obj->query_current_liquid() < 1) {
    obj->set_current_liquid(0);
    obj->set("liquid_remaining", 0);
    obj->set("liquid_remaining", 0);
    destruct(ob);
  }
  if (i < 3)
    call_out("end_fire", 6, obj, ob, i);
  obj->save();
  return;
}
