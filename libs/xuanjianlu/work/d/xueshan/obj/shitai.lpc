//play

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIB"停尸台"NOR, ({ "tingshi tai", "altar", "tai" }) );
        set_weight(300000);
        set_max_encumbrance(5000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "座");
                set("long", "这是一座存放尸体用的平台。\n");
                set("value", 1000);
                set("material", "stone");
                set("no_get",1);
        }
        set("xsjob_chaodu", 1);
        setup();
}                       
int is_container() { return 1; }
void init()
{
        add_action("do_put", "put");
}

int do_put(string arg)
{
        string item, target; 

        if( arg && sscanf(arg, "%s in %s", item, target) == 2 )
        {
                if( !this_object()->id(target)) return 0;
                else
                {
                        write("你不能往"+name()+"里放任何东西。\n");
                        return 1;
                }
        }
        return 0;
}
