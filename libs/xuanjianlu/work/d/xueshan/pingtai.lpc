//by play
inherit ROOM;

void create() {
  set("short", "中央平台");
  set("long", @LONG
这里是一座高耸的在寺院广场正中的平台，身处于此可以遍览寺院。
平台长宽各十五丈由祁连山深处的藏青条石堆砌而成。平台四周各有一
座用于祭祀的平台，一根入云的幡杆矗立在平台正中。
LONG
  );
  set("exits", ([
    "down": __DIR__ "guangchang",
    "north": __DIR__ "pingtai2",
    "south": __DIR__ "pingtai3",
    "west": __DIR__ "pingtai1",
    "east": __DIR__ "pingtai4",
  ]));
  set("objects", ([
    __DIR__ "obj/shitai": 1,
  ]));

  set("cost", 1);
  set("outdoors", "qilian-shan");
  setup();
}
int valid_leave(object me, string dir) {
  object room, ob;
  if (!(room = find_object(query("exits/" + dir))))
    room = load_object(query("exits/" + dir));
  if (room) {
    ob = present("fa tan", room);
    if (ob)
      if (ob->query("xsjob_chaodu")) {
        if (environment(ob->query("xsjob_chaodu")) == room)
          return notify_fail("那里正在做法事，不能参观！\n");
        ob->delete("xsjob_chaodu");
        ob->set("pending", 0);
      }
  }

  return ::valid_leave(me, dir);
}
