//by play
inherit ROOM;

void create()
{
        set("short", "南平台");
        set("long", @LONG
这里是一座高耸的平台，身处于此可以遍览寺院。平台长宽各五丈
由祁连山深处的藏青条石堆砌而成。平台正中设有一座祭坛，一根入云
的幡杆矗立在北边的高台上。
LONG
        );
        set("exits", ([
		"north" :__DIR__"pingtai",
        ]));

	set("objects", ([
		__DIR__"obj/jitan" : 1,
	]));

	set("cost", 1);
        setup();
        set("outdoors","qilian-shan");
}
int valid_leave(object me, string dir)
{
	object ob;
	ob=(present("fa tan", (environment(me))));
        if ( ob )
        if ( me->query("id") == ob->query("pending")
	     || me->query("xs_chaodu"))
                return notify_fail("你法事没做完就想走？\n");
	return ::valid_leave(me, dir);
}
