inherit NPC;
#include <ansi.h>;
#define JOB_G (__DIR__"xs_job/inherit/xsjobs.lpc")
int ask_job();
void get_xsjob_dengyou(object me);

void create()
{
        seteuid(getuid());
	set_name("值日喇嘛", ({ "zhiri lama", "lama" }));
	set("long", 
"这是度母殿的值日喇嘛，专门负责各种敬奉事物。\n");
	set("gender", "男性");
	set("age", 20);
        set("attitude", "friendly");
	set("class","lama");
	set("shen_type", 0);
	set("no_kill", 1);
	set("str", 22);
	set("int", 20);
	set("con", 22);
	set("dex", 21);
	set("inquiry", ([
		"job"     : (: ask_job :),
		"work"    : (: ask_job :),
		"工作"    : (: ask_job :),
		"任务"    : (: ask_job :),
	]));
	
	set("max_qi", 300);
	set("max_jing", 300);
	set("neili", 100);
	set("max_neili", 100);
	set("jiali", 10);
	set("combat_exp", 1000);

	set_skill("force", 20);
	set_skill("dodge", 25);
	set_skill("parry", 20);
	set_skill("strike", 20);


	setup();
	carry_object(__DIR__"obj/lamajiasha")->wear();
}

void init()
{
        add_action("do_report", "report");
}

int ask_job()
{
	string msg;
	int list,i;
	mapping *jobs;
	object me = this_player();
	
        if(!me->query("family/family_name")||(me->query("family/family_name")!="雪山派"&& 
          me->query("family/family_name") != "血刀门"))
                return 0;
 
        if(me->query_temp("xsjob_over"))
        {
        	command("say 听说你已经完成了我交代的工作，怎么不向我报告(report)呢！");
        	return 1;
        } 
        if(me->query_temp("xsjob"))
        {
        	msg = sprintf("我交代给你的%s事情办得怎么样了？",
        	               me->query_temp("xsjob/type"),
        	               );
        	command("say "+msg);
        	write("输入cancel将会取消当前工作: ");
        	input_to("get_unjob",me);
        	return 1;
        }
        if(me->query_temp("xsjob_un")&&me->query_temp("xsjob_un")>time())
        {
        	command("say 现在没有什么工作，你去修习佛法吧。");
        	return 1;
        }
        command("say 我这里有几项工作，你选择哪个呢？");
        jobs = JOB_G->jobs();
        list = sizeof(jobs);
        for(msg="",i=0;i<list;i++)
        {
        msg += sprintf("  %d.%s \n",
                      i+1,
                      jobs[i]["type"],
                      );
        }
        write(msg);

        input_to("get_job",me,jobs);
        return 1;
}

int get_job(string arg, object me,mapping *jobs)
{
	int i, j=6, amu, sum;
	string msg="",file,*type;
	mapping job,status;
	object obj,room,ob;

        if( !arg || sscanf(arg, "%d", amu)!=1 ||!amu)
        {
        if(amu==0)
        {
        command("say 为佛门供奉佛主会保佑你的。\n");
        return 1;
       	}
        write("请选择1-5的数字，选0为取消:");
        input_to("get_job",me,jobs);
        return 1;
        }
        if(amu<1 || amu > 5){
        write("请选择1-5的数字，选0为取消: ");
        input_to("get_job",me,jobs);
        return 1;
        }
        i = amu-1;
        job = jobs[i];
        if (undefinedp(job)) {write("雪山工作系统错误。\n");return 1;}
        switch(i)
        {
               case 0:
                      if(!objectp(obj = present("suyou hu", me))||
                         (obj && !obj->query("xsjob")) )
                      {
		         obj=new(__DIR__"obj/xs_youhu.lpc");
		         obj->move(me);
		         command("say 这个油壶你收好。");
		      }
		      else
		      {
		      	 sum=0;
		      	 obj = present("suyou hu", me);
		      	 ob=present("su you", obj);
		      	 if(!ob)
		      	 ob=new("/d/xueshan/obj/suyou.lpc");
		      	 else
		      	 sum=ob->query_amount();
		      	 write(sum+",,,,,,,,\n");
		      	 ob->set_amount(6-sum);
		      	 ob->move(obj);
		      	 obj->set_current_liquid(6-sum);
		      }
		      set_temp("xsjob_dengyou",JOB_G->file_dengyou());
		      if(me->query_temp("xsjob_dengyou") )
		         me->set_temp("xsjob_dengyou",0);
                      
               while (j--) get_xsjob_dengyou(me);
                      type = me->query_temp("xsjob_dengyou");
		      set_temp("xsjob_dengyou",0);
		      sum = sizeof(type);
		      msg += "最近寺中香火鼎盛，你快去为:\n";
                      while (sum--) msg += GRN+type[sum]+"    "NOR;
                      msg += CYN"\n的琉璃灯中加些酥油吧。"NOR;
                      JOB_G->go_move_deng();
                      break;
               case 1:
                      if (sizeof(children(__DIR__"xs_job/xs_npc/xs_laoshu"))>5 )
                      {
                      	    command("say 已经有不少人帮我清除鼠患了，你做些别的工作吧。");
                      	    return 1;
                      }
                      file = JOB_G->file_shuhuan();
                      if(!( room = find_object("/d/xueshan/"+file)) )
                            room = load_object("/d/xueshan/"+file);
                      if(!room)
                      {
                      	      if(wizardp(me))
                              write("/d/xueshan/"+file+"\n");
                   	      write("雪山工作系统出错，请告之巫师。\n");
        	              return 1;
                      }
                      msg = "本寺酥油来之不易经常被老鼠偷吃你去清鼠患吧。";
		      ob=new(__DIR__"xs_job/xs_npc/xs_laoshu.lpc");
 	              ob->move(room);
 	              ob->set("xs_shuhuan",me);
	      
		      break;
 	       case 2:
                      if (sizeof(children(__DIR__"xs_job/xs_npc/xs_robber"))>5 )
                      {
                      	    command("say 已经有不少人帮我清查寺院了，你做些别的工作吧。");
                      	    return 1;
                      }
 	              file = JOB_G->file_jingtu();
                      if(!( room = find_object("/d/xueshan/"+file)) )
                            room = load_object("/d/xueshan/"+file);
                      if(!room)
                      {
                      	      if(wizardp(me))
                              write("/d/xueshan/"+file+"\n");
                   	      write("雪山工作系统出错，请告之巫师。\n");
        	              return 1;
                      }
                      msg = "近来总有外派弟子到我寺中搞破坏，你去帮我查一下，遇到后格杀勿论。";

 	              obj=new(__DIR__"xs_job/xs_npc/xs_robber.lpc");
 	              obj->move(room);
 	              obj->set("xs_jingtu",me);
 	              
 	              break;
 	       case 3:
                      if(!( room = find_object("/d/xueshan/pingtai")) )
                            room = load_object("/d/xueshan/pingtai");
                      if(!room)
                      {
                   	      write("雪山工作系统出错，请告之巫师。\n");
        	              return 1;
                      }
                      ob = present("tingshi tai", room);
                      if(!ob || !ob->query("xsjob_chaodu"))
                      {
                   	      write("雪山工作系统出错，请告之巫师。\n");
        	              return 1;                      	
                      }
                      msg = "我佛慈悲，你去法坛超渡亡魂吧。";

 	              obj=new("/clone/misc/corpse.lpc");
 	              obj->move(ob);
 	              obj->set("xs_chaodu",me); 	              
 	              break;
 	       case 4:
                      msg = "现在各大门派均对我寺不怀好意，你去帮我给他们些教训。";
                      if(!( room = find_object("/d/xueshan/dumudian")) )
                            room = load_object("/d/xueshan/dumudian");
                      if(!room)
                      {
                   	      write("雪山工作系统出错，请告之巫师。\n");
        	              return 1;
                      }
                      ob = present("tong gang", room);
                      if(!ob || !ob->query("xsjob"))
                      {
                   	      write("雪山工作系统出错，请告之巫师。\n");
        	              return 1;                      	
                      }
                      status = ob->query("xs_chanchu");
                      if(!status || sizeof(status)<5){
                      status = ([
                              "少林派": 50,
                              "武当派": 50,
                              "峨嵋派": 50,
                              "华山派": 50,
                              "丐帮": 50,
                      ]);
                      ob->set("xs_chanchu",status);
                      ob->save();
                      }
                      type = keys(status);
                      amu = sizeof(type);
                      printf("你在下面门派名称中选择一个吧(cancel)为放弃:\n");
                      while(amu--)
                      {
                 	     printf("名称： %-15s  敌对度：%8d\n",
                             type[amu],
                             status[type[amu]],
                           );
                      }
                      
                      input_to("get_chanchu",me,job,status,type);
                      return 1;
 	              break;
              default:
               	      command("say 雪山系统错误，请联系巫师。");
               	      return 1;
		      break;
	}
        me->set_temp("xsjob_time",time()+job["time"]);
	command("say "+msg);
	me->set_temp("xsjob",job);
	return 1;
}
int get_chanchu(string arg,object me,mapping job,mapping status,string *type)
{
	string str;
	object obj;
	int amu;
	amu = sizeof(type);
	if(arg == "cancel" || !arg || arg == "")
	{
		command("say 那你想好以后再来吧。");
		return 1;
	}
	if(member_array(arg, type)==-1)
	{
                printf("你在下面门派名称中选择一个吧(cancel)为放弃:\n");
                while(amu--)
                {
               	     printf("名称： %-15s  敌对度：%8d\n",
                             type[amu],
                             status[type[amu]],
                           );
                }
		input_to("get_chanchu",me,job,status,type);
		return 1;
	}
	command("say 你就去给"+arg+"些教训吧。");
        command("say 这封手信拿好，用以记录你的战绩。");
        obj=new("/d/xueshan/npc/xs_job/xs_npc/obj/shouxin.lpc");
        obj->move(me);
        obj->set("xs_chanchu",me); 	              
        me->set_temp("xsjob_time",time()+job["time"]);
	me->set_temp("xsjob",job);
	me->set_temp("xs_chanchu", arg);
	return 1;
}
int get_unjob(string arg,object me)
{
	if(arg == "Cancel"||arg == "cancel"||arg[0]=='C'||arg[0]=='c')
	{
                me->delete_temp("xsjob_time");
		me->delete_temp("xsjob");
		command("say "+me->name()+"你以后要多为佛主做奉献喔。");
		me->set_temp("xsjob_un",time()+600);
		me->save();
	}
	else
	command("say "+me->name()+"快去完成我交给你的工作！");
	return 1;
}

void get_xsjob_dengyou(object me)
{
        string *status,*type;
	int j;

	type = me->query_temp("xsjob_dengyou");
	if(!type) type=({});
	status = this_object()->query_temp("xsjob_dengyou");

	j = random(sizeof(status));
	type += ({ status[j] });
	status -= ({status[j]});
	set_temp("xsjob_dengyou", status);
        me->set_temp("xsjob_dengyou", type);
}

int do_report(string arg)
{
	object me,obj;
	int exp, pot, sco, k=1, t, m=0, amu, bonus;
	mapping job;
	me = this_player();
	job = me->query_temp("xsjob");
	if(!mapp(job))
	      return notify_fail("什么？\n");
        t=me->query_temp("xsjob_time");
	if(!me->query_temp("xsjob_over")&&t>time())
	      return notify_fail("我交给你办的"+job["type"]+"工作完成了吗！\n");
        
	if(t>time())
	k+=(t-time())*10/job["time"];
	m=me->query_temp("xsjob_hortation");
        switch(job["content"])
        {
        	case "dengyou":
        	bonus = __FILE__->get_bonus(me,"dengyou");
                k += m;
                bonus +=k;
		command("say "+me->name()+"你添加灯油辛苦了！\n");
 		exp = job["exp_bonus"] + bonus+random(bonus*2/3);;
		pot = job["pot_bonus"] + bonus*2/3+random(bonus/2);
	        if(me->query("max_potential")<me->query("potential")+pot)
	        pot = me->query("max_potential") - me->query("potential");
        	me->add("combat_exp", exp);
	        me->add("potential", pot);
	        		
	        me->delete_temp("xsjob_over");
		me->delete_temp("xsjob");
                me->delete_temp("xsjob_time");
                me->save();
      	
        	break;
        	case "shuhuan":
		command("say 不错，你完成的很出色！\n");
        	bonus = __FILE__->get_bonus(me,"shuhuan");
 	        k += m*5;
 	        bonus += k;
 		exp = job["exp_bonus"] + bonus+random(bonus/3);;
		pot = job["pot_bonus"] + bonus/4+random(k*2);;
	        if(me->query("max_potential")<me->query("potential")+pot)
	        pot = me->query("max_potential") - me->query("potential");
        	me->add("combat_exp", exp);
	        me->add("potential", pot);
		
	        me->delete_temp("xsjob_over");
	        me->delete_temp("xsjob_hortation");
                me->delete_temp("xsjob_time");
		me->delete_temp("xsjob");
                me->save();
        	break;
        	case "jingtu":
                command("say 很好，以后你要继续为佛主奉献。");		
        	bonus = __FILE__->get_bonus(me,"jingtu");
        	bonus += k;
 		exp = job["exp_bonus"] + bonus+random(bonus/4);;
		pot = job["pot_bonus"] + bonus/4+random(k*2);
	        if(me->query("max_potential")<me->query("potential")+pot)
	        pot = me->query("max_potential") - me->query("potential");
        	me->add("combat_exp", exp);
	        me->add("potential", pot);
		
	        me->delete_temp("xsjob_over");
	        me->delete_temp("xsjob_hortation");
                me->delete_temp("xsjob_time");
		me->delete_temp("xsjob");
                me->save();
        	break;
        	case "chaodu":
        	if(!m||m<1)
        	{
	        me->delete_temp("xsjob_over");
	        me->delete_temp("xsjob_hortation");
		me->delete_temp("xsjob");
                me->delete_temp("xsjob_time");
		command("say "+me->name()+"我交给你的事情都做不好，太令我失望了！\n");
                me->save();
		return 1;
        	}
		command("say 阿弥陀佛，善哉善哉！\n");
 	        k += m*5;
        	bonus = __FILE__->get_bonus(me,"chaodu");
        	bonus += k;
 		exp = job["exp_bonus"] + bonus+random(bonus/3);;
		pot = job["pot_bonus"] + bonus/3+random(k*3);;
	        if(me->query("max_potential")<me->query("potential")+pot)
	        pot = me->query("max_potential") - me->query("potential");
        	me->add("combat_exp", exp);
	        me->add("potential", pot);
		
	        me->delete_temp("xsjob_over");
	        me->delete_temp("xsjob_hortation");
                me->delete_temp("xsjob_time");
		me->delete_temp("xsjob");
                me->save();
        	break;
        	case "chanchu":
        	if(!m||m<3)
        	{
	        me->delete_temp("xsjob_over");
	        me->delete_temp("xsjob_hortation");
		me->delete_temp("xsjob");
		me->delete_temp("xs_chanchu");
                me->delete_temp("xsjob_time");
		command("say "+me->name()+"你这次做的可是令我不满啊！\n");
                me->save();
		return 1;
        	}
		command("say 给那些鼠辈颜色看看，你做得不错！\n");
 	        k += (m-2)*5;
        	bonus = __FILE__->get_bonus(me,"chanchu");
        	bonus += k;
 		exp = job["exp_bonus"] + bonus+random(bonus/3);;
		pot = job["pot_bonus"] + bonus/3+random(k*3);;
	        if(me->query("max_potential")<me->query("potential")+pot)
	        pot = me->query("max_potential") - me->query("potential");
        	me->add("combat_exp", exp);
	        me->add("potential", pot);
                obj = present("shou xin", me);
                if(obj){
                        write("你将"+obj->name()+"交还给了"+name()+"。\n");
                        destruct(obj);
               	}	
	        me->delete_temp("xsjob_over");
	        me->delete_temp("xsjob_hortation");
		me->delete_temp("xsjob");
		me->delete_temp("xs_chanchu");
                me->delete_temp("xsjob_time");
                me->save();
        	break;
                default:
                write("雪山工作系统出现错误，请告之巫师。\n");
        	return 1;
        }
        	tell_object(me,HIC"你在完成"+job["type"]+"的工作中，获得了\n" +
		chinese_number(pot) + "点潜能的提升，领悟到" +
		chinese_number(exp) + "点实战经验。\n"NOR);
              return 1;
}

int get_bonus(object me, string str)
{
	int amu, Exp;
	Exp = me->query("combat_exp");

        switch(str)
        {
        	case "dengyou":  //5万经验奖励到最低点
        	      	amu=Exp/2000; 	amu>25?amu=25:amu;   amu=26-amu;
        	break;
        	case "shuhuan": //50万经验奖励到峰值
                    	amu=Exp/5000;
                    	amu>=10?amu=amu+90:amu;
               	 	amu<50?amu=30:amu>150?amu=150:amu;
        	break;
        	case "jingtu":  //270万经验奖励到峰值
                       	amu=Exp/9000;
                    	amu>=10?amu=amu+150:amu;
                       	amu<100?amu=100:amu>400?amu=400:amu;
        	break;
        	case "chaodu":  //520万经验奖励到峰值
                       	amu=Exp/13000; 
                    	amu>=10?amu=amu+200:amu;
                       	amu<150?amu=150:amu>600?amu=600:amu;
        	break;
                case "chanchu":  //1180万经验奖励到峰值
                       	amu=Exp/18000; 
                    	amu>=20?amu=amu+250:amu;
                       	amu<200?amu=200:amu>900?amu=900:amu;
                break;
                default:
                       amu = 1;
                break;        	
        }
	return amu;
}

int accept_object(object me, object ob)
{
	object butter, gang;

	if (ob->name()!="酥油罐") {
        write("值日喇嘛脸上露出迷惑的表情。\n");
        command ("shake");
	    remove_call_out("destroy_it");
        call_out("destroy_it", 1, ob);
        return 1;
	}
 	if ( objectp(butter = present("su you", ob)) && objectp(gang = present("tong gang", environment(this_object()))) ) {
		butter->move_liquid(gang);
        message_vision("$N将酥油小心翼翼的倒入遍照雪海内。\n", this_object());
	}
	if (me->query("class") == "lama"){ 
	if (me->query_skill("lamaism", 1) < 30){
	me->set("lama_butter",me->query("mud_age"));	
	command ("bow");
        command ("say 佛主保佑施主！");
	remove_call_out("destroy_it");
        call_out("destroy_it", 1, ob);
	return 1;
	}
	if (me->query_skill("lamaism", 1) >= 30
	&& me->query_skill("lamaism", 1) < 60){
	me->set("lama_butter",me->query("mud_age") + 7600);
	command ("bow");
        command ("say 佛主保佑施主！");
	remove_call_out("destroy_it");
        call_out("destroy_it", 1, ob);
	return 1;
        }
    }
	command ("say 佛主保佑施主！");
	remove_call_out("destroy_it");
        call_out("destroy_it", 1, ob);
	return 1;
}
void destroy_it(object ob)
{
        destruct(ob);
	return ;
}


