//  Cracked by play
// /d/xueshan/obj/xs_youhu.c

#include <ansi.h>
inherit "/d/xueshan/inherit/liquid_container.lpc";


void create()
{
        set_name(YEL"酥油壶"NOR, ({"suyou hu", "hu"}));
        set_max_encumbrance(3000);
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "一个用来装酥油的陶壶\n");
                set("value", 300);
        }

		// mark it as a liquid container
		set("liquid/container",1);
		set_max_liquid(6);
		set_current_liquid(0);
		set("xsjob",1);

		setup();

        carry_liquid("/d/xueshan/obj/suyou", 6);

}