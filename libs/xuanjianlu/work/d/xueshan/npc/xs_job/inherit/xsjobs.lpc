mixed go_move_deng()
{
	string *deng_path;
	object obj,room;
	int i;
	i = sizeof(move_deng);
	while(i--){
             if(!( room = find_object("/d/xueshan/"+move_deng[i])) )
                   room = load_object("/d/xueshan/"+move_deng[i]);
             
             if(!room) return;
             if(obj=present("liuli deng", room))
             if(obj->query("xs_deng")) return;
             obj = new("/d/xueshan/npc/xs_job/xs_deng");
             obj->move(room);
	}
        remove_call_out("go_move_deng");
	call_out("go_move_deng",60);
	return;
}
