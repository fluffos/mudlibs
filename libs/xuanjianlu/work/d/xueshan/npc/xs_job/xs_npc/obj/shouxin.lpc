//Cracked by Play
// shouxi.c
#include <ansi.h>
inherit ITEM;
string time_period(int timep);

void create()
{
        set_name( CYN"手信" NOR, ({"shou xin", "xin"}));
        set_weight(500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "封");
                set("long", "这是雪山派专用的手信。\n");
                set("no_drop", 1);
                set("value", 200);
		set("material","paper");
        }
		setup();
}
void init()
{
        add_action("do_read", ({"read","du"}));
}
int do_read(string arg)
{
	object me;
	mapping note;
	string *type;
	int i;
	me = this_player();
	if(!id(arg))
	        return notify_fail("你要读什么？\n");
	note = query("xsjob_note");
	if(!note||sizeof(note)<1)
	        return notify_fail("这封手信上没有记录任务信息。\n");
	if(query("xs_chanchu")!=me)
	        return notify_fail("你看不懂上面的信息。\n");
	
	type = keys(note);
        printf("这封手信上记录着雪山派弟子"+me->name()+"的如下信息:\n");
        printf("======================================================\n");
        printf("序号          人  物             英文名       奖励点\n");
        printf("======================================================\n");
	for(i=0;i<sizeof(type);i++)
	{
		printf("%-3d %16s %18s %10d\n",
		        i+1,
		        note[type[i]]["name"],
		        note[type[i]]["id"],
		        note[type[i]]["bonus"],
		);
	}
        printf("======================================================\n");
	
        return 1;
}
void note_write(object me,object ob)
{
	int bonus=1,exp1,exp2,time;
	if(query("xsjob_note/"+ob->query("id"))) return;
	if(query("xs_time")) return;
	if(sizeof(query("xsjob_note"))>=10)
	{
         	message("vision",HIW"你已经完成了铲除异教的工作。\n"NOR,({me}));
		return;
	}
	if(userp(ob))
	{
		if(ob->query("combat_exp")<me->query("combat_exp")/2*3)
		return;
		bonus += 1;
	}
	time = me->query_temp("xsjob_time");
        exp1 = me->query("combat_exp");
        exp2 = ob->query("combat_exp");
        bonus += exp2*2/exp1;
	add("xsjob_note/"+ob->query("id"),([
	       "id":   ob->query("id"),
	       "name": ob->query("name"),
	       "bonus": bonus,
	]));
        me->add_temp("xsjob_hortation", bonus);
	if(!me->query_temp("xsjob_over")&&sizeof(query("xsjob_note"))>=3)
	{
		message("vision",HIW"你完成了铲除异教的工作。\n"NOR,({me}));
		me->set_temp("xsjob_over", 1);
	}
        message("vision","你将战斗成果记录在了手信上。\n"NOR,({me}));	
        if(time<time())
        {
        	set("xs_time", 1);
        	message("vision",HIY"你铲除异教的工作时间已到。\n"NOR,({me}));
        }
        else
                message("vision","你有"+time_period(time-time())+"时间可以继续铲除异教的任务。\n"NOR,({me}));	
}
string time_period(int timep)
{
	int s, v, h, d, m, y, t,e;

	t = timep;
        
	s = t % 60 ;	        t /= 60;
        v = t % 60 ;            t /= 60;
	h = t % 24;		t /= 24;
        d = t % 30;             t /= 30;
        m = t % 12;             t /= 12;
	y = t;

        return sprintf("%s%s%s%s%s%s",
                        y?y+"年":"", m?m+"月":"",
                        d?d+"日":"", h?h+"时":"",
                        v?v+"分":"", s?s+"秒":"");
}