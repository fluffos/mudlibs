//Cracked by Play
// npc: xs_robber.c

#include <ansi.h>
inherit NPC;

int setup_robber(int exp_level);
int set_random_name();
void clear_dumudian();
void self_destruct();
string title;

nosave string *menpai_names1 = ({
    "华山派",
    "峨嵋派",
    "武当派",
    "少林派",
    "丐帮",
});

nosave string *menpai_names2 = ({
    "华山",
    "峨嵋",
    "武当",
    "少林",
    "丐帮",
});

nosave int random_id;

void create()
{
	set_name("进香客", ({ "jinxiang ke", "ke", "guest" }));
        set("gender", "男性" );
        set("age", 20+random(20));
        set("str", 25);
        set("dex", 30);
        set("con", 25);
        set("int", 23);
        set("max_qi", 300);
        set("max_jing", 100);
        set("neili", 200);
        set("max_neili", 200);
        set("chat_chance", 5);
        set("chat_msg", ({
                (: random_move :)
        }) );
      
        setup();
 	remove_call_out("self_destruct");
	call_out("self_destruct", 600);

}

void init()
{
	::init();
        add_action("do_killing", "kill");
        add_action("do_look", ({"look","l"}));
}
int do_look(string arg)
{
	object me = this_player();
	if(this_object()->id(arg)&&query("xs_jingtu")==me&&!query("look_ok"))
	{
		command("hehe "+me->query("id"));
		command("say 既然你认出了我的身份，那就没什么好说的了！");
		set_random_name();
		set("look_ok",1);
                setup_robber(me->query("combat_exp"));
		this_object()->kill_ob(me);
		me->kill_ob(this_object());
		return 1;
	}
	return 0;
}
int do_killing(string arg)
{
	object *inv,victim;
	int i;
        if ( !arg || arg == "")	return 0;
        if( objectp(victim = present(arg, environment(this_object()))) && living(victim))
          {
        	if(victim == this_object()||victim == query("xs_jingtu"))
          	{
          		inv = all_inventory(this_object());
          		for(i=0; i<sizeof(inv); i++) {
          			if( !living(this_object()) ) continue;
          			if( !inv[i]->query("skill_type")) continue;
          			if( !inv[i]->query("weapon_prop/damage")) continue;
          			command("wield "+inv[i]->query("id"));
          		}
          	}
          }
        return 0;               
}
int die()
{
        int i;
        
        object me,*user;
        object obj,room;

        me = this_object()->query_temp("last_damage_from");
        if(query("family/family_name"))
        {
        if(!( room = find_object("/d/xueshan/dumudian")) )
              room = load_object("/d/xueshan/dumudian");
        if(room)
        {
        	if(objectp(obj = present("tong gang", room)))
        	{
        		obj->add("xs_chanchu/"+query("family/family_name"), 1);
	                obj->save();
        	}
        }
        }
        if(query("xs_jingtu")&&query("xs_jingtu")==me && query("look_ok"))
        {
        	me->set_temp("xsjob_over",1);
       		me->add_temp("xsjob_hortation",query("hortation"));
        	message("vision",HIW"你完成了佛门静土的任务。\n"NOR, ({me}));

        }else
        {
        	user=users();
        	for(i=0;i<sizeof(user);i++)
        	{
        		if(user[i]!=query("xs_jingtu")) continue;
        		tell_object(user[i],HIR"你佛门静土工作所涉及的敌人已经被"+me->name()+"作掉了。\n"NOR);
        	}
        }
	::die();
	return 0;
}

int set_random_name()
{
    string my_name;

    random_id=random(5);
    my_name = menpai_names2[random_id] + "弟子";
    set_name(my_name, ({"dizi"}));
    set("title","窥探雪山使者");
    set("long", "他看起来是一精明强干武功不错的"+menpai_names1[random_id]+"弟子。\n");
    set("family/family_name",menpai_names1[random_id]);
    return random_id;   
}

int setup_robber(int exp_level)
{
    int level, menpai, exp;

    menpai = random_id;

    exp = exp_level/100*(random(40)+110);

    if (exp < 50000 ) exp=50000;
    
    level = pow(10*exp, 0.333334);
    
    if (level < 50) level = 50;

    set("max_neili", level*20);
    set("neili", level*30);
    set("max_jingli", level*12);
    set("eff_jingli", level*12);
    set("jingli", level*12);
    set("jiali", level-random(level/2));

    set("combat_exp", exp);
    set_skill("force", level);
    set_skill("dodge", level);
    set_skill("parry", level);
    set_skill("sword", level);
    set_skill("blade", level);
    set_skill("strike", level);
    set_skill("cuff", level);
    set_skill("finger", level);
    set_skill("claw", level);
    set_skill("club", level);
    set_skill("kick", level);
    set_skill("staff", level);
    set_skill("whip", level);

    switch (menpai){
    // Huashan
   case 0:
        set_skill("huashan-jianfa", level);
        set_skill("liangyi-dao", level);
        set_skill("huashan-shenfa", level);
        set_skill("zixia-gong", level);
        set_skill("pishi-poyu", level);
        set_skill("hunyuan-zhang", level);
 
        map_skill("force", "zixia-gong");
        map_skill("dodge", "huashan-shenfa");
        map_skill("parry", "huashan-jianfa");
        map_skill("strike", "hunyuan-zhang");
        map_skill("cuff", "pishi-poyu");
        map_skill("sword", "huashan-jianfa");
        map_skill("blade", "liangyi-dao");
        
        prepare_skill("cuff", "pishi-poyu");
        prepare_skill("strike", "hunyuan-zhang");
        setup();
        carry_object("/clone/weapon/gangjian")->wield();
      
        break;
    // emei
    case 1:
        set_skill("huifeng-jian", level);
        set_skill("yanxing-dao", level);
        set_skill("jinding-zhang", level);
        set_skill("tiangang-zhi", level);
        set_skill("linji-zhuang", level);
        set_skill("zhutian-bu", level);

        map_skill("force", "linji-zhuang");
        map_skill("sword", "huifeng-jian");
        map_skill("blade", "yanxing-dao");
        map_skill("strike", "jinding-zhang");
        map_skill("finger", "tiangang-zhi");
        map_skill("dodge", "zhutian-bu");
        map_skill("parry", "huifeng-jian");

        prepare_skill("finger", "tiangang-zhi");
        prepare_skill("strike", "jinding-zhang");
        setup();
        carry_object("/clone/weapon/gangjian")->wield();
        break;
    // wudang
    case 2:
        set_skill("taiji-shengong", level);
        set_skill("taiji-jian", level);
        set_skill("tiyunzong", level);
        set_skill("taiji-quan", level);
 
        map_skill("force", "taiji-shengong");
        map_skill("parry", "taiji-jian");
        map_skill("cuff", "taiji-quan");
        map_skill("dodge", "tiyunzong");
        map_skill("sword", "taiji-jian");
        
        prepare_skill("cuff", "taiji-quan");
        carry_object("/clone/weapon/gangjian")->wield();
        break;
    // shaolin
    case 3:
        set_skill("damo-jian", level);
        set_skill("xiuluo-dao", level);
        set_skill("wuchang-zhang", level);
        set_skill("zui-gun", level);
        set_skill("shaolin-shenfa", level);
        set_skill("hunyuan-yiqi", level);
        set_skill("yizhi-chan", level);
        set_skill("banruo-zhang", level);
        set_skill("riyue-bian", level);
 
        map_skill("force", "hunyuan-yiqi");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("parry", "damo-jian");
        map_skill("sword", "damo-jian");
        map_skill("blade", "xiuluo-dao");
        map_skill("club", "zui-gun");
        map_skill("staff", "wuchang-zhang");
        map_skill("finger", "yizhi-chan");
        map_skill("strike", "banruo-zhang");
        map_skill("whip", "riyue-bian");
        
        prepare_skill("finger", "yizhi-chan");
        prepare_skill("strike", "banruo-zhang");
        setup();
        if(random(10>5))
        carry_object("/clone/weapon/gangjian")->wield();
        else
        if(random(5>2))
        carry_object("/clone/weapon/tiegun")->wield();
        else
        carry_object("/clone/weapon/changbian")->wield();
        break;
    // gaibang
    case 4:
    default:    
        set_skill("liuhe-dao", level);
        set_skill("xiaoyaoyou", level);
        set_skill("huntian-qigong", level);
        set_skill("shexing-diaoshou", level);
 
        map_skill("force", "huntian-qigong");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("parry", "liuhe-dao");
        map_skill("blade", "liuhe-dao");
        map_skill("hand", "shexing-diaoshou");
        
        prepare_skill("hand", "shexing-diaoshou");
        setup();
        carry_object("/clone/weapon/gangdao")->wield();
        break;
    }
    set("eff_qi", level*18);
    set("max_qi", level*18);
    set("qi", level*18);
    set("max_jing", level*12);
    set("eff_jing", level*12);
    set("jing", level*12);
        carry_object("/clone/armor/beixin")->wear();
        carry_object("/d/xingxiu/obj/fire");

    return menpai;
}

void self_destruct() {
    object me = this_object();
    if(me->is_fighting()||!living(me))
    {
	remove_call_out("wait_destruct");
    	call_out("wait_destruct",60);
    	return;
    }
    if(query("xs_jingtu"))
    clear_dumudian(); 
    message_vision("$N急急忙忙地离开了。\n", me);
    destruct(me);
}
void wait_destruct()
{
    	self_destruct();
}
void clear_dumudian()
{
    object room1;

    if(!( room1 = find_object("/d/xueshan/dumudian")) )
         room1 = load_object("/d/xueshan/dumudian");
    if(room1)
    room1->reset_to_dizi(this_object()->name(),query("family/family_name"));
}