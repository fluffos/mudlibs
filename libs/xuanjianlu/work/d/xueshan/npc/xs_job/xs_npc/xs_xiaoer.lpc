// Play
// xiaoer.c 杂货小二

inherit NPC;
inherit F_DEALER;

string ask_me(string);

void create() {
  set_name("杂货商", ({ "zahuo shang", "shang", "waiter" }));
  set("gender", "男性");
  set("age", 50);
  set("long",
    "这是一位小本经营的杂货商。\n");
  set("combat_exp", 100);
  set("attitude", "friendly");
  set("rank_info/respect", "老爹");
  set("vendor_goods", ({
    "/clone/food/nang",
    "/clone/food/jiudai",
    "/d/xingxiu/obj/fire",
    __DIR__ "obj/xs_youhu",
    __DIR__ "obj/xs_shujia",
  }));

  setup();
}
void init() {
  add_action("do_buy", "buy");
  add_action("do_list", "list");
}
