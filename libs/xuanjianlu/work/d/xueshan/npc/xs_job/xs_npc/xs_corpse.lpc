//Cracked by play
// corpse.c
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "燃烧的" + NOR + WHT + "尸体" NOR, ({ "ranshao shiti", "corpse" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一具燃烧的尸体。\n");
    set("unit", "具");
    set("value", 0);
  }
  set("no_get", 1);
  setup();
}
