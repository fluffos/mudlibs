//Cracked by play
// npc: mao.c

#include <ansi.h>
inherit NPC;
int setup_robber(int exp_level);
void self_destruct();

void create()
{
	set_name("野猫", ({ "ye mao", "mao" }));
	set("long","面露凶光的一只大野猫。\n");
	set("unit", "只");
	set("age", random(10)+4);
        set("str", 50);
        set("dex", 50);
        set("con", 50);
        set("int", 30);
        set("max_qi", 300);
        set("max_jing", 100);
        set("neili", 200);
        set("max_neili", 200);
        set("xs_job", 1);

        setup();
 	remove_call_out("self_destruct");
	call_out("self_destruct", 600);

}
void init()
{
        if(!query("call_skill")){
        setup_robber(this_player()->query("combat_exp"));
        set("call_skill", 1);
        }
        if(this_player()->query("id")=="lao shu"&&this_player()->query("xs_job"))
         kill_ob(this_player());
}
int setup_robber(int exp_level)
{
    int level, exp;

    exp = exp_level;

    if (exp < 10000 ) exp=10000;
    
    level = pow(10*exp, 0.333334);
    
    if (level < 30) level = 30;

    set("max_qi", level*10);
    set("eff_qi", level*10);
    set("qi", level*10);
    set("max_jing", level*8);
    set("eff_jing", level*8);
    set("jing", level*8);
    set("max_jingli", level*5);
    set("eff_jingli", level*5);
    set("jingli", level*8);
    set("max_neili", level*8);
    set("jiali", level-random(level/2));

    set("combat_exp", exp);
    set("neili", level*8);
    set_temp("apply",([
                 "attack" : level,
                 "damage" : level/2,
                 "armor" : level,
                 "defense" : level,
    ]));
    return 1;
}
void self_destruct()
{
	object me;
	me = this_object();
    
        message_vision( "$N叫了一声蹿向房脊跑掉了。\n", me);
        destruct(me);
}

int die()
{
        object me,*user;
        me = this_object()->query_temp("last_damage_from");
        if(me->query_temp("xsjob"))
        if(me->query_temp("xsjob/content")=="shuhuan")
        me->add_temp("xsjob_hortation",3);
        ::die();
}