//Cracked by Play
// npc: xs_robber.c

#include <ansi.h>
inherit NPC;
int setup_robber(object me, int exp_level);
void self_destruct();
void ghost_perform(int level);

string *chaodu_msg = ({
  "$N听到$n洪亮的经文声全身瑟瑟发抖。。。\n",
  "$N退离$n数丈距离，身周形成一股淡淡的雾气。。。\n",
  "$N被$n精亮的双眸盯住元神行动逐渐迟缓。。。\n",
  "$n一声高过一声的诵经声使得$N露出极为痛苦的表情。。。\n",
});

void create() {
  set_name(BLU "幽魂" NOR, ({ "you hun", "hun", "ghost" }));
  set("gender", "男性");
  set("age", 20 + random(20));
  set("str", 60);
  set("dex", 100);
  set("con", 5000);
  set("int", 5000);
  set("no_get", 1);
  set("xs_chaodu", 1);
  set("max_qi", 300);
  set("max_jing", 100);
  set("neili", 200);
  set("max_neili", 200);

  setup();
  remove_call_out("self_destruct");
  call_out("self_destruct", 300);
}
void init() {
  object ob, me;
  if (!query("call_skill")) {
    ob = present("fa tan", environment(this_object()));
    if (ob) me = ob->query("xsjob_chaodu");
    if (!me) me = this_player();
    setup_robber(me, me->query("combat_exp"));
    set("call_skill", 1);
  }
  add_action("do_chaodu", "chaodu");
}
int do_chaodu(string arg) {
  object me;
  int level, level2;
  me = this_player();
  level = me->query_skill("lamaism", 1);
  level2 = me->query_skill("necromancy", 1);
  if (!id(arg))
    return notify_fail("你要超渡谁？\n");
  if (level < 60)
    return notify_fail("你的密宗心法不够纯熟无法使用佛门超渡。\n");
  if (level2 < 60)
    return notify_fail("你的降伏法不够纯熟无法使用佛门超渡。\n");
  if (query("xs_ghost/" + me->query("id")))
    return notify_fail("你正在使用佛门超渡技法。\n");
  if (me->query("jing") < me->query("max_jing") / 3)
    return notify_fail("你的精神状况不能运用佛门超渡。\n");

  message_vision(HIW "$N跌坐于地手掐往生手印双目神光闪闪盯住$n" + HIW + "元神口中不停诵着经文。。。\n" NOR, me, this_object());
  this_object()->remove_all_killer();
  me->remove_all_killer();
  me->add("jing", -me->query("max_jing") / 5);
  set("xs_ghost/" + me->query("id"), 1);
  me->start_busy(2);
  remove_call_out("chaodu_ghost");
  call_out("chaodu_ghost", 3 + random(5), me, level, level2, 0);

  return 1;
}
void chaodu_ghost(object me, int level, int level2, int i) {
  object obj, ob;
  i++;
  me->start_busy(2);
  me->add("jingli", -100, "超度失败精尽而亡");
  if ((query("xs_level") < random(level + level2) * 2 || (level + level2) > 600) && i > random(3) + 2) {
    obj = present("fa tan", environment(this_object()));
    ob = new(__DIR__ "xs_corpse.lpc");
    ob->set("xs_chaodu", me);
    ob->move(obj);
    me->add_temp("xsjob_hortation", 5);
    obj->set("out_ghost", 0);
    me->improve_skill("lamaism", level);
    me->improve_skill("necromancy", level2);
    message_vision(HIG "在$N的洪亮诵经声中$n" + HIG + "身影逐渐淡化，咻地一声投入了熊熊的烈火中。\n" NOR, me, this_object());
    destruct(this_object());
    return;
  }
  if (query("xs_level") > random(me->query("eff_jingli") / 2)) {
    set("xs_ghost/" + me->query("id"), 0);
    me->improve_skill("lamaism", me->query_int() / 2);
    me->improve_skill("necromancy", me->query_int() / 2);
    message_vision(HIB "$n痛苦的表情突然淡去，双目凶光暴涨，猛然扑向$N 。。。\n" NOR, me, this_object());
    kill_ob(me);
    me->kill_ob(this_object());
    return;
  }

  me->improve_skill("lamaism", me->query_int());
  me->improve_skill("necromancy", me->query_int());
  message_vision(chaodu_msg[random(sizeof(chaodu_msg))], this_object(), me);
  remove_call_out("chaodu_ghost");
  call_out("chaodu_ghost", 5 + random(5), me, level, level2, i);
}
int setup_robber(object me, int exp_level) {
  int level, exp;

  exp = exp_level;

  if (exp < 50000) exp = 50000;

  level = pow(10 * exp, 0.333334);

  if (level < 60) level = 60;
  if (level > 500) level = 500;
  set_skill("force", level);
  set_skill("dodge", level);
  set_skill("parry", level);
  set("max_qi", level * 15);
  set("eff_qi", level * 15);
  set("qi", level * 15);
  set("max_jing", level * 10);
  set("eff_jing", level * 10);
  set("jing", level * 10);
  set("max_jingli", level * 10);
  set("eff_jingli", level * 10);
  set("jingli", level * 15);
  set("max_neili", level * 15);
  set("jiali", level - (level / 2 + random(level / 5)));

  set("combat_exp", exp / 2);
  set("neili", level * 20);
  set_temp("apply", ([
    "attack": level / 5,
    "damage": level / 10,
    "armor": level / 2,
    "defense": level,
  ]));
  set("xs_level", level);
  remove_call_out("ghost_perform");
  call_out("ghost_perform", 10 + random(5), level);

  return 1;
}
void ghost_perform(int level) {
  string msg;
  object me;
  me = this_object()->query_temp("last_opponent");
  if (!me)
    me = this_object()->query_temp("last_damage_from");
  if (!me)
    me = this_player();


  remove_call_out("ghost_perform");
  if (me && is_fighting(me)) {
    switch (random(10)) {
      case 0:
      case 1:
        msg = "$N" + BLU + "随身附形吸取$n" + BLU + "的精力！\n" NOR;
        me->add("jingli", -random(level / 2) - 50);
        break;
      case 2:
      case 3:
        msg = "$N" + HIC + "随身附形吸取$n" + HIC + "的精！\n" NOR;
        me->add("jing", -random(level / 2) - 50);
        break;
      case 4:
      case 5:
        msg = "$N" + HIY + "随身附形吸取$n" + HIY + "的内力！\n" NOR;
        me->add("neili", -random(level / 2) - 50);
        break;
      case 6:
      case 7:
        msg = "$N" + HIR + "随身附形吸取$n" + HIR + "的气！\n" NOR;
        me->add("qi", -random(level / 2) - 50);
        break;
      default:
        msg = "$N" + HIG + "随身附形被$n" + HIG + "闪了开去！\n" NOR;
        break;
    }
    message_vision(msg, this_object(), me);
  } else if (!query("xs_ghost"))
    kill_ob(me);
  call_out("ghost_perform", 8 + random(10), level);
}
void self_destruct() {
  object me, obj;
  me = this_object();
  if (is_fighting()) {
    remove_call_out("self_destruct");
    call_out("self_destruct", 60);
    return;
  }
  obj = present("fa tan", environment(this_object()));
  if (obj)
    obj->set("out_ghost", 0);
  message_vision("$N 咻 的一声隐去了身形不见了。\n", me);
  destruct(me);
}

int die() {
  object me, ob, obj;
  me = this_object()->query_temp("last_damage_from");
  if (query_temp("xs_chaodu") == me) {
    obj = present("fa tan", environment(this_object()));
    ob = new(__DIR__ "xs_corpse.lpc");
    ob->set("xs_chaodu", me);
    ob->move(obj);
    me->add_temp("xsjob_hortation", 3);
    obj->set("out_ghost", 0);
    message_vision(HIC "$N用武力将$n" + HIC + "降服投掷到熊熊的烈火中。\n" NOR, me, this_object());
    destruct(this_object());
    return 1;
  } else {
    message_vision("$N 咻 的一声隐去了身形不见了。\n", this_object());
    destruct(this_object());
    return 1;
  }
}
