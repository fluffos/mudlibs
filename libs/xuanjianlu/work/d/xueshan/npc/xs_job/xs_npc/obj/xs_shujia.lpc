//Cracked by Play
// xs_shujia.c
#include <ansi.h>

inherit ITEM;
#define JOB_G ("/d/xueshan/npc/xs_job/inherit/xsjobs.lpc")

void create()
{
        set_name( CYN"捕鼠夹" NOR, ({"bushu jia", "jia"}));
        set_weight(500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", 
                "用来捕鼠的铁夹。\n");
                set("value", 200);
		set("material","orin");
        }
		setup();
}
void init()
{
        add_action("do_anfang", "anfang");
        add_action("do_zhuo", ({"use","yong","shiyong"}));
}
int do_anfang(string arg)
{
	object me;
	me = this_player();
	if(!environment(me)->query("xsjob"))
	        return notify_fail("你不能将鼠夹安放在此地！\n");
	if(arg == "cancel" )
	{
		if(!query("xs_anfang"))
		return notify_fail("这个鼠夹并没有使用啊！\n");
		set("xs_anfang", 0);
		set("no_get", 0);
        	this_object()->move(me);
                message_vision("$N小心翼翼地将安放在此处的$n收了起来。\n", me,this_object());
		return 1;
	}
	if(!id(arg))
	        return notify_fail("格式: anfang shu jia\n");
	if(query("xs_anfang"))
	        return notify_fail("这个鼠夹已经安放在此地了！\n");
	set("no_get", 1);
	set("xs_anfang",1);
	this_object()->move(environment(me));
        message_vision("$N小心翼翼地将$n安放在了地上。\n", me,this_object());
        return 1;
}
int do_zhuo(string arg)
{
	object me,ob,obj,room;
        string file;
	me = this_player();

        if(!this_object()->id(arg))
                return notify_fail("你只能用捕鼠夹捕捉老鼠！\n");
       	obj = present("lao shu", environment(me));
       	if(!obj)
                return notify_fail("你所处的环境没有老鼠！\n");
       	if(!query("xs_anfang"))
                return notify_fail("这个捕鼠夹没有被安放，不能用来捕鼠！\n");

        message_vision("$N启动"+name()+"啪的一声将$n抓住了。\n", me,obj);
        if(!me->query_temp("xsjob")||me->query_temp("xsjob/content")!="shuhuan")
        {
                message_vision("$N将死掉的$n一脚踢开。\n", me,obj);
                destruct(obj);
               	return 1;
        }
       	if(obj->query("xs_shuhuan"))
       	{
       		if(obj->query("xs_shuhuan")==me)
       			me->add_temp("xsjob_hortation", 2);
       		else
       		        me->add_temp("xsjob_hortation", 1);
       	}
        destruct(obj);
        if(me->query_temp("xsjob_time")&&me->query_temp("xsjob_time")>time())
        {
              file = JOB_G->file_shuhuan();
              if(!( room = find_object("/d/xueshan/"+file)) )
                    room = load_object("/d/xueshan/"+file);
              if(!room)
              {
      	      write("雪山工作系统出错，请告之巫师。\n");
              return 1;
              }
	      ob=new("/d/xueshan/npc/xs_job/xs_npc/xs_laoshu.lpc");
              ob->move(room);
              me->set_temp("xsjob_over",1);
              ob->set("xs_shuhuan",me);
              message("vision","你还有些时间可以再去抓几只老鼠。\n", ({me}));
        }else{
              message("vision",HIW"你完成了清除鼠患的工作。\n"NOR, ({me}));
              me->set_temp("xsjob_over",1);
              this_object()->move(me);
   	      set("no_get", 0);
              set_temp("xs_anfang", 0);    
              message_vision("$N将$n拾了起来。\n", me,this_object());
        }
	return 1;
}