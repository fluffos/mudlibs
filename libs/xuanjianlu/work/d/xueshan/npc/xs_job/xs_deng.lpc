//Cracked by Play
// xs_deng.c
#include <ansi.h>

inherit "/d/xueshan/inherit/liquid_container.lpc";

int burn_out_deng();

int do_get_liquid(int liquid);

void create() {
  int i;
  set_name(HIM "七彩" HIW "水晶" HIC "琉璃灯" NOR, ({ "liuli deng", "deng" }));
  set_max_encumbrance(90000);
  set_weight(50000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "盏");
    set("long",
      "由水晶制成的琉璃灯，灯光闪闪，透出无比的神秘。\n");
    set("value", 10000);
    set("material", "bronze");
    set("no_get", 1);
    set("no_refresh", 1);
  }
  // mark it as a liquid container
  set("liquid/container", 1);
  set_max_liquid(1000);
  set_current_liquid(0);
  set("liquid/unique", 1);
  set("xs_deng", 1);
  set("xsjob", 1);
  set("liquid/uniqueid", "su you");
  setup();
  carry_liquid("/d/xueshan/obj/suyou", 10);
  burn_out_deng();
}

int burn_out_deng() {
  object *inv;
  int i;

  inv = all_inventory(this_object());

  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query_amount()) {
      if (inv[i]->query_amount() > 10)
        inv[i]->add_amount(-1);
    } else
      destruct(inv[i]);
  }
  this_object()->set_current_liquid(query_current_liquid() - 1);

  remove_call_out("burn_out_deng");
  call_out("burn_out_deng", 120);
  return 1;
}
