inherit ROOM;

void create()
{
	set("short", "石阶");
	set("long", @LONG
石阶蜿然向下伸延，尽头可见扇紧壁着的石门。两侧石壁上挂着点燃
的火把，把通道照得十分明亮。
LONG
	);

	set("exits", ([ /* sizeof() == 1 */
		"down" : __DIR__"door",
	]));


	set("cost", 0);
	setup();
}

int valid_leave(object me, string dir)
{
        int i;
        object obj;
		object *inv;

        if ( living(obj) && !wizardp(me) ) {
        inv = all_inventory(me);
           if ( dir == "down" ) {
                for (i=0; i<sizeof(inv); i++) {
                        if (inv[i]->is_character())
                        return notify_fail("你不能带着其他玩家离开这里。\n");
                }
			}
		}
        return ::valid_leave(me, dir);
}