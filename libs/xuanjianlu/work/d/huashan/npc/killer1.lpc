// killer1.c 
// by firefox 12-10-2001

inherit NPC;

#include <ansi.h>
#include "/clone/obj/npc_setup.h"
void die();
void set_npc(object ob);
void random_go();
string  ask_me();
void create()
{
	string menpai;
	set_random_name();
	set("gender", "男性");
	set("age", 25+random(25));
	set("shen_type", -1);
	set("attitude", "heroism");
  	set_npc(this_player());
    set_hp(query_skill("force", 1)*2);
	set("inquiry", ([
	    "剑宗" : (: ask_me :),
	    "气宗" : (: ask_me :),
	]));

	setup();

	carry_object("/clone/misc/cloth")->wear();
	carry_object(query("default_weapon"))->wield();
	add_money("silver", random(10));
}
void init()
{
	call_out("dest",1200);
	remove_call_out("random_go");
	call_out("random_go",5+random(10));
}
void set_npc(object player)
{
	int playexp,skill_rate;
	string menpai;
	object me=this_object();
	playexp=(int)player->query("combat_exp");
	if (playexp<=300000) {
		skill_rate=50+random(20);
	}else {
		if (playexp<=1000000) 
			skill_rate=60+random(30);
		else skill_rate=100;
	}
	playexp=playexp;		//*1.2;
	menpai = set_skills("huashan", playexp, skill_rate);
	set("long", "他是华山剑宗高手。\n");
	set("family/family_name","华山剑宗十四代弟子");
	set("title","华山剑宗十四代弟子");
}
void random_go()
{
	mapping exits;
	object env;
	string *road,roompath;
	int i,j;
	env=environment(this_object());
	exits=env->query("exits");
	road=keys(exits);
	j=random(sizeof(road));
	roompath=exits[road[j]];
	if (strsrch(roompath,"/d/huashan/hsstreet1")==0){
		command("east");
		env=environment(this_object());
	}
	command(road[random(sizeof(road))]);
	remove_call_out("random_go");
	call_out("random_go",5+random(10));
}	
int dest()
{
	tell_room(environment(this_object()),"$N急急忙忙的走了！\n");
	destruct(this_object());
	return 1;
}
string ask_me()
{
	object ob=this_player(),me=this_object();
	if (me->query("player_id") == ob->query("id") )
		return ("岳不群这伪君子霸占华山派掌门之位，却教众弟子练气不练剑，以致我华山派声名\n"+
			"日衰。"+me->name()[0..1]+"某既是华山弟子，终不能袖手旁观，置之不理。\n");
	return "你是不是在说梦话？什么剑宗气宗的。\n";
}
void die()
{
	object ob=this_player(),me=this_object();
	if ( objectp( ob = find_player(me->query("player_id")) ) ) {
		ob->set_temp("job2_done",1);
        }
	message_vision("\n$N倒在地上，挣扎了几下就死了。\n",me);
	tell_object(ob,"你已杀了剑宗弟子，快去禀报掌门吧！\n");
	destruct(me);
}
#include "/clone/obj/npc_setup.lpc"
