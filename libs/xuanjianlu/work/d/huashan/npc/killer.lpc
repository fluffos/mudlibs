inherit NPC;

#include <ansi.h>
#include "/d/REGIONS.h"
#include "/clone/obj/npc_setup.h"

#define JOB_SERVER "/clone/obj/job_server"
#define TRAVERSER  "/clone/obj/traverser"
#define MAPDB "/clone/obj/mapdb"

void set_npc(object ob);
//void die();
int checkplayer(object ob);
int xiashan(object ob);
string find_target_room(object traverser, int dist);
int greeting(object play);


void create() {
  string menpai;
  set_random_name();
  set("gender", "男性");
  set("age", 25 + random(25));
  set("shen_type", -1);
  set("attitude", "heroism");
  set_npc(this_player());
  set_hp(query_skill("force", 1));

  setup();

  carry_object("/clone/misc/cloth")->wear();
  carry_object(query("default_weapon"))->wield();
  add_money("silver", random(10));
}
void init() {
  object me, player;
  mapping skill_status;
  me = this_object();
  player = this_player();
  if (player->query_temp("target_id") == me->query("id")) {
    me->set_temp("killname", player->query("id"));
    remove_call_out("greeting");
    call_out("greeting", 1, player);
  }
}
void set_npc(object player) {
  int playexp, skill_rate;
  string menpai;
  object me = this_object();
  playexp = (int)player->query("combat_exp");
  if (playexp <= 300000) {
    skill_rate = 40 + random(20);
  } else {
    if (playexp <= 1000000)
      skill_rate = 60 + random(20);
    else skill_rate = 100;
  }
  playexp = playexp;  //*1.2;
  switch (random(5)) {
    case 0:
    default:
      menpai = set_skills("xingxiu", playexp, skill_rate);
      break;
    case 1:
      menpai = set_skills("baitou", playexp, skill_rate);
      break;
    case 2:
      menpai = set_skills("gaibang", playexp, skill_rate);
      break;
    case 3:
      menpai = set_skills("xueshan", playexp, skill_rate);
      break;
    case 4:
      menpai = set_skills("taohua", playexp, skill_rate);
      break;
  }
  set("long", "他看起来是" + menpai + "派高手。\n");
}

int checkplay(object play) {
  object me = this_object();
  if (!present(query_temp("killname"), environment(this_object()))) {
    destruct(me);
    return notify_fail("也太不中用了，竟被打死了！\n");
  }
  if (play->query("qi") <= play->query("max_qi") / 10 && living(play)) {  //query("qi")<=50 
    command("halt");
    play->unconcious();
    remove_call_out("checkplay");
    remove_call_out("xiashan");
    call_out("xiashan", 1, play);
  } else {
    if (!play->is_ghost()) {
      remove_call_out("checkplay");
      call_out("checkplay", 1, play);
    }
  }
  return 1;

}
int xiashan(object player) {
  string target_room_path;
  object traverser, room;
  int ret, dist;

  traverser = new(TRAVERSER);
  if (!objectp(traverser)) {
    printf("BUG: %s cannot be cloned\n", TRAVERSER);
    return 0;
  }
  // find a target room
  dist = 10 + random(10);
  target_room_path = find_target_room(traverser, dist);
  ret = 0;
  while (ret < 100 && !target_room_path) {
    ret++;
    target_room_path = find_target_room(traverser, dist);
  }
  if (!target_room_path) {
    printf("BUG: cannot find target room. Try ask again.\n");
    return 0;
  }
  destruct(traverser);
  room = find_object(target_room_path);
  if (!room) room = load_object(target_room_path);
  if (!room) {
    printf("BUG: could not load room %s\n", target_room_path);
    return 0;
  }
  // killer will self-destruct in 10 minutes
  message("vision", this_object()->query("name") + "把昏过去的" + this_player()->query("name") +
    "背了起来，身形一晃，下山而去！\n", environment(this_object()), this_object());
  player->move(this_object());
  this_object()->move(room);
  message("vision", this_object()->query("name") + "快步走了过来.\n", room, this_object());
  //    command("get "+this_player()->query("id"));
  message("vision", this_object()->query("name") + "放下背上的" + this_player()->query("name") +
    "转身离去！\n", room, this_object());
  player->move(environment(this_object()));
  //	if ( random(30)==16)
  //		player->set("feng",1);
  destruct(this_object());
  return ret;
}
// returns the file path of target room
string find_target_room(object traverser, int dist) {
  object mapdb;
  string room_path;

  // simply get a ramdon room path
  mapdb = find_object(MAPDB);
  if (!objectp(mapdb)) mapdb = new(MAPDB);
  if (!objectp(mapdb)) return 0;

  mapdb->restore();
  room_path = mapdb->query_random_room_path();
  if (strsrch(room_path, "/d/bwdh/") == 0 ||
    strsrch(room_path, "/d/city/") == 0 ||
    strsrch(room_path, "/d/changan/") == 0 ||
    strsrch(room_path, "/d/death/") == 0 ||
    strsrch(room_path, "/d/dongtinghu/") == 0 ||
    strsrch(room_path, "/d/em/") == 0 ||
    strsrch(room_path, "/d/hengshan/") == 0 ||
    strsrch(room_path, "/d/hengshan2/") == 0 ||
    strsrch(room_path, "/d/huangshan/") == 0 ||
    strsrch(room_path, "/d/murong/") == 0 ||
    strsrch(room_path, "/d/shenlong/") == 0 ||
    strsrch(room_path, "/d/xiakedao/") == 0 ||
    strsrch(room_path, "/d/wizard/") == 0 ||
    strsrch(room_path, "/d/taohuacun/") == 0 ||
    strsrch(room_path, "/d/xiangyang/") == 0
  ) return 0;
  return room_path;
}

int greeting(object player) {
  object me = this_object();
  if (me->query_temp("killname") == player->query("id") && living(this_player())) {
    me->kill_ob(player);
    player->kill_ob(me);
    remove_call_out("checkplay");
    call_out("checkplay", 2, player);
    return 1;
  }
  destruct(me);
  return 1;
}

#include "/clone/obj/npc_setup.lpc"
