#include <room.h>
#include <ansi.h>
inherit ROOM;
nosave string *hsmapdb = ({ "buwei1", "shaluo", "buwei2", "canglong", "chaoyang", "chufang",
  "donglang", "fengding", "houyuan", "huayuan", "husun", "laojun", "pianting", "qianchi",
  "qingke", "shanlu1", "shanlu2", "sheshen", "shuyuan", "siguoya", "square", "wuqiku",
  "xiaolu1", "xiaolu2", "xiaozhu", "xilang", "xuanya", "yunu", "yunuci", "yuquan", "zhenyue",
  "zoulang", "zoulang1", "zoulang2", "zoulang3", "zoulang4", "zoulang5" });
int do_mianbi();
int do_strike(string);
int make_npc(object ob);

void create() {
  set("short", "山洞");
  set("long", @LONG
山洞内有块光溜溜的大石，不知道曾有多少华山派的前辈在此思过面
壁，以致这块大石竟被坐得滑溜。石壁(wall)左侧刻着「风清扬」三个大
字，是以利器所刻，笔划苍劲，深有半寸。这三字刻得劲力非凡，想必其
人武功一定十分了得。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "out": __DIR__ "siguoya",
  ]));

  set("item_desc", ([
    "wall": "一面很厚的石壁。\n",
  ]));

  set("cost", 2);
  setup();
}

void init() {
  object me = this_player();

  if (interactive(me) && me->query("huashan/job_pending")) {
    me->set_temp("hz_job/sgy", 1);
  }

  add_action("do_mianbi", "面壁");
  add_action("do_mianbi", "mianbi");
  add_action("do_strike", "strike");
  add_action("do_lingwu", "lingwu");
  add_action("do_quit", "quit");

  /*   	add_action("do_study",  "exercise");
	add_action("do_study",  "dazuo");
	add_action("do_study",  "practice");
	add_action("do_study",  "lian");
	add_action("do_study",  "study");
	add_action("do_study",  "du");*/

}

int do_quit() {
  object me = this_player();
  if (me->query_temp("start_time"))
    return notify_fail("你正在忙其他事情不能退出！\n");
}
int do_mianbi() {
  int shen_n, check, level, nowtime;
  object me = this_player();
  shen_n = me->query("shen");
  nowtime = time();
  level = (int)me->query_skill("force", 1);
  check = level * level * level;
  if (!me->query("huashan/job_mianbi") || me->query("job_done")) {
    message_vision("$N在大石上坐了下来，面对着石壁趺坐静思。\n", me);

    if (random(15) == 9 && !me->query_temp("marks/面")) {
      write("良久，你突然有一股破壁(strike)的冲动。\n");
      me->set_temp("marks/面", 1);
    }
    me->set_busy(10);

    if (random(200) == 18 && (int)me->query("shen") < 30000) {
      me->set("shen", shen_n + 20);
      write("你的侠义正气增加了。\n");
    }

    if (random(200) == 1 && (int)me->query_skill("force", 1) <= 40
      && check < (int)me->query("combat_exp") * 10) {
      me->receive_damage("jing", 10, "心力绞瘁死了");
      me->improve_skill("force", me->query("int"));
      write("你领悟了内功方面的几个疑难。\n");
    }
  } else {

    if (me->query_temp("job2_done")) {
      tell_object(me, "你已杀了剑宗弟子，快去禀报掌门吧！\n");
    } else if (me->query("job2time") && me->query("job2time") > nowtime) {
      tell_object(me, "掌门有令，还不快去找剑宗弟子！\n");
    } else if (me->query("job2time") && me->query("job2time") <= nowtime) {
      tell_object(me, "你胆大妄为，私下放过剑宗弟子，快快前去请罪吧！\n");
      me->delete_temp("start_time");
      me->delete("no_get");
      me->delete("huashan/job_mianbi");
      me->set("mianbi_failed", 1);
    } else

    if (me->query("family/family_name") == "华山派" &&
      me->query("huashan/job_mianbi") && !me->query_temp("start_time")
      && !me->query_temp("job_done") && !me->query("job2time")) {
      me->set_temp("start_time", time());
      me->set("no_get", 1);
      remove_call_out("shiguo");
      call_out("shiguo", 5, me);
      message_vision("$N伸手拍了拍大石，说道：“石头啊石头，你寂寞了多年，今" +
        "日我来和你相伴了。”\n", me);
      message_vision(MAG "$N坐上大石，双眼离开石壁不过尺许，双目微合盘膝而坐，渐入佳境。\n" NOR, this_player());
    }
  }
  return 1;
}

int do_lingwu() {
  object me = this_player();
  int level, check;

  level = (int)me->query_skill("zixia-gong", 1);
  check = level * level * level;

  if ((int)me->query_skill("zixia-gong", 1) >= 50
    && (int)me->query_skill("zixia-gong", 1) <= 100
    && present("zixia book", me) && (int)me->query("jing") > 29) {
    if (check < (int)me->query("combat_exp") * 10) {
      me->receive_damage("jing", 20, "心力绞瘁死了");
      me->improve_skill("zixia-gong", me->query("int"));
      write("你领悟了紫霞神功方面的几个疑难。\n");
    } else {
      write("你实战经验不足，无法领悟紫霞神功。\n");
    }
  } else if ((int)me->query("jing") < 30) {
    write("你精神无法集中。\n");
  } else {
    write("什么？\n");
  }

  return 1;
}

int do_strike(string arg) {
  int n, q;
  object weapon, me = this_player();
  n = me->query("neili");
  q = me->query("qi");

  if (me->query_temp("marks/面")) {

    if (!arg || arg != "wall")
      return notify_fail("你要击破甚么？！\n");

    if (!objectp(weapon = me->query_temp("weapon"))
      || (string)weapon->query("skill_type") != "sword") {

      if (me->query("neili") < 200)
        return notify_fail("你的内力不够！\n");

      message_vision(
        "$N站起身来，拜出骑马蹲裆式，深吸一口气，双掌同时拍向石壁。\n", me);
      message_vision(
        "结果什么也没发生。看来破壁的方法并不对，$N自己反而受伤。\n", me);
      me->set("neili", n - 200);
      me->receive_damage("qi", 200, "体力透支过度死了");
    } else {
      if (n >= 200) {
        message_vision(
          "$N举剑运足内力刺向石壁，擦的一声，剑竟尔插入石壁之中，直没至柄！\n", me);
        message_vision(
          "$N随即抽出剑来，但听得砰砰之声不绝，石头不住滚落，露出一个窄窄的孔道。\n", me);
        set("exits/enter", __DIR__ "yongdao1");
        me->set("neili", n - 200);
        me->delete_temp("marks/面");
        remove_call_out("close");
        call_out("close", 5, this_object());
      } else {
        message_vision(
          "$N举剑，运足内力刺向石壁，锵的一声，结果剑断人伤，原来内力不足！\n", me);
        me->set("neili", 0);
        me->receive_damage("qi", 200, "体力透支过度死了");
        destruct(weapon);
      }

      return 1;
    }

    return 1;

  } else {
    write("什么？\n");
  }

  return 1;
}

void close(object room) {
  message("vision", "石头稀里哗拉坍塌下来，又封住了入口。\n", room);
  room->delete("exits/enter");
}
/*int do_study()
{
	return notify_fail("这里是华山派思过之处，还是安心面壁思过吧！\n");
}*/

int shiguo(object me) {
  int nowtime;
  object killer;
  nowtime = time();
  if (nowtime >= ((int)me->query_temp("start_time") + 150 + random(10)) &&
    environment(me)->query("short") == "山洞") {
    me->delete_temp("start_time");
    me->delete("no_get");
    //		me->delete("huashan/job_mianbi");
    me->set_temp("job_done", 1);
    message_vision(HIW "$N深深吸了一口气，微微睁开双目，慢慢的站了起来！。\n" NOR, me);
    return 1;
  }
  if (random(10) > 7 && !me->is_fighting() && environment(me)->query("short") == "山洞") {
    message_vision(WHT "忽听得远远有人走上崖来，脚步迅捷，来人武功着实不低。\n" NOR, me);
    tell_object(me, HIR "你心中一凛：“这人不是本门中人，他上崖来干甚么？莫非是那魔教中人吗？”\n\n" NOR);
    killer = new(__DIR__ "npc/killer");
    killer->move(environment(me));
    me->set_temp("target_id", killer->query("id"));
    message_vision("片刻之间，那人已然上崖，大声道：“" + me->query("name") + "兄，故人来访。”\n", me);
    message_vision(HIY "$N道：“" + me->query("name") + "兄，这便跟我走罢。\n" NOR, killer);
    message_vision("$N道：“不去！杀了我也不去！”\n", me);
    killer->move(environment(me));
    remove_call_out("shiguo");
    call_out("shiguo", 5, me);
    return 0;
  }
  if (!me->is_fighting() && environment(me)->query("short") == "山洞") {
    if (random(100) == 14) {
      tell_object(this_player(), "陆大有快步走了过来，对你拱了拱手。\n" +
        HIW "陆大有说道：“掌门有令，听闻华山剑宗弟子前来华山捣乱，掌门令你带罪立功，下山除去此人！\n" NOR);
      tell_object(this_player(), "陆大有说罢转身离去！\n");
      me->delete_temp("start_time");
      me->delete("no_get");
      me->set("job2time", time() + 1200);
      make_npc(this_player());
      message_vision(HIW "$N深深吸了一口气，微微睁开双目，慢慢的站了起来。\n" NOR, me);
      return 0;
    }
    tell_object(me, "你心无旁鹜静心思过，往事在你的脑海渐渐浮现！\n");
  } else {
    if (environment(me)->query("short") != "山洞" && living(me)) {
      message_vision(HIW "$N此番下山有违师令，责罚看来是免不了啦！\n" NOR, me);
      me->delete_temp("start_time");
      me->delete("no_get");
      me->set("mianbi_failed", 1);
      return 0;
    }
  }
  remove_call_out("shiguo");
  call_out("shiguo", 5, me);
  return 0;
}
int make_npc(object ob) {
  object kill1;
  int i;
  kill1 = new("/d/huashan/npc/killer1");
  i = random(sizeof(hsmapdb));
  //	write(hsmapdb[i]);
  kill1->move("/d/huashan/" + hsmapdb[i]);
  kill1->set("player_id", ob->query("id"));
}
int valid_leave(object me, string dir) {
  if (me->query_temp("start_time") && (dir == "out" || dir == "enter"))
    return notify_fail("还是静心思过吧。\n");
  return ::valid_leave(me, dir);
}
