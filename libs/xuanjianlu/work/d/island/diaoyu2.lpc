

#include <ansi.h>
inherit ROOM;


void create()
{
	set("short", "通吃岛");
	set("long", @LONG
这里是钓鱼岛的海边，周围乱石嶙峋，是个藏身的好地方，不知道周围
地上有一些生活过的痕迹，你不尽感觉到，这里肯定有人居住。
LONG
        );
	set("exits", ([ /* sizeof() == 3 */
		  "west" : __DIR__"diaoyu",
	]));
	

	set("no_clean_up", 1);


	set("wei_count", 1);

	set("cost", 5);
	setup();
}

void init()
{
	add_action("do_shout", "shout");
	add_action("do_shout", "han");
}



int do_shout(string arg)
{
	object ob, me = this_player();

	if( !arg || arg=="" ) return 0;

	message_vision("$N撤着脖子高声喊道："+arg+"，小玄子想你。\n", me);

	if( ( arg == "小桂子" || arg == "韦大人" || arg == "韦爵爷" ) 
	&& query("wei_count") >= 1	&& !present("wei xiaobao", environment(me)) ) {
	    add("call_times", 1);

	    if( (int)query("call_times") == 20 ) {
		message_vision(HIG"只听得身旁的山石后面传来一阵哭声。\n"NOR, me);
		message_vision(HIG"接着，一个小孩从山石后面走了出来。\n"NOR, me);
		message_vision(HIY"小孩见到你，先是一愣，然后说道：谁找我？\n"NOR, me);

		add("wei_count", -1);
		ob = new("/d/shenlong/npc/weixiaobao.lpc");
		ob->move(environment(me));
		delete("call_times");
	    }

	}

	return 1;
}

void reset()
{
	::reset();
	delete("call_times");
}
