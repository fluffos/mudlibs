#include <ansi.h>
#include "room.h"

inherit ROOM;

nosave string current_id = "";
nosave int current_job = 0;

int introduce_robber(object current_player);
int reset_to_normal();

void create()
{
        set("short", "西大街");
        set("long", @LONG
这是一条宽阔的青石板街道，向东西两头延伸。南面有一家小杂货铺。
LONG
        );
set("exits", ([
                "west" : __DIR__"lanzhou-ximen",
                "east" : __DIR__"lanzhou",
		"south" :__DIR__"zahuopu",
		"north" :__DIR__"yangguan",
        ]));
	set("objects", ([
                "/d/village/npc/kid": 2,
	]));
	set("cost", 1);
        setup();
        set("outdoors","qilian-shan");
 
}



void init() {
    object challenger, me = this_player();
    if ( (me->query("family/family_name") == "神龙教")
         && !(current_job) 
         && (me->query_temp("job_here1")) ) {
        call_out("introduce_robber", random(10)+10, me);
        current_job = 1; 
    }
    add_action("do_giveup", "giveup");
}

int introduce_robber(object current_player)
{   
    object bangzhong;
    object me = this_player();

    if ( objectp(present(current_player->query("id"), this_object())) )
    {
        bangzhong = new("/d/shenlong/npc/sl_job_npc");
        bangzhong->setup_robber(current_player->query("combat_exp"));
        bangzhong->move(this_object());    
        message_vision(HIB"\n一阵嘈杂的声音传入你的耳朵里。原来是一个$N走了过来。\n"NOR, bangzhong);
        message_vision(HIY"\n只听$N一边走一边说道：今天帮主派俺下山采购，运气真好！\n\n" NOR, bangzhong, current_player);
        tell_object(me,BRED+WHT"\n你隐约觉得胖头陀说的好像就是这个人！\n"NOR);
        tell_object(me,HIR"\n你决定杀了帮众！\n"NOR);
              current_job = 0 ;
              bangzhong->start_checking(current_player);

    }
    else
    {
        reset_to_normal(); 
    }
}

int reset_to_normal()
{

   current_job = 0;
   return 1;

}


int valid_leave(object me, string dir) {
    object ob;


    if ( me->query_temp("job_here1") )
        return notify_fail("你要干吗去？就是这里，没错了！\n");

        return ::valid_leave(me, dir);
}


int do_giveup() {

    object ob, me = this_player();
    ob = me->query_temp("challenger");
    if (me->query_temp("job_here1"))

           
            {       
                     message_vision("\n$N叹息到：“哎，失去一次机会！”\n", me);
               tell_object(me,HIG"\n由于你丧失这次机会，导致你降低了5点神龙教功劳！\n"NOR);
            me->add("shenlong/gonglao", -5);
            me->delete_temp("job_here1");
        }
        else
              return notify_fail("没有工作你放弃什么？\n");
    return 1;
}            
        
