// 怒剑狂刀
 
//changan city

#include <ansi.h>
inherit ROOM;

void create ()
{
        set ("short","钟楼广场");
        set ("long", @LONG

这里是西安城的中心，四条大街交汇于此。一座高大的钟楼(zhonglou)耸
立于前，很是有些气势。每到清晨，响亮的钟声便会伴着淡淡雾气传
向西安城的大街小巷。路口车水马龙，来往人潮不断。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));
        set("item_desc", ([
			"zhonglou" :"钟楼为一座二层方形塔，塔身全为木制，底座宽大，造
型简洁庄严。方塔底四周有门，门楣上有石刻。\n",

			]));
		set("exits", 
        ([ //sizeof() == 5
			   "west" : __DIR__"xidajie-1",
			   "east" : __DIR__"dongdajie-1",
			   "north" : __DIR__"beidajie-1",
			   "south" : __DIR__"nandajie-1",
        ]));
        set("objects", ([
			__DIR__"npc/liumangtou": 1,
			__DIR__"npc/liumang" :1,
        ]));
        set("outdoors", "xi'an");
   
        setup();
   
}

void init()
{
	add_action("do_enter", "enter");
}

int do_enter(string arg)
{
   object me;
   me=this_player();

     if(!arg || arg=="") return 0;

	 if( arg=="zhonglou")
	 {
		 message("vision",
			 me->name() + "走进钟楼里了。\n",
			 environment(me), ({me}) );
		          me->move("/d/xi'an/zhonglou-1");
         message("vision",me->name() + "从广场上走了过来。\n",
			 environment(me), ({me}) );
         
		 return 1;
	 }


}

