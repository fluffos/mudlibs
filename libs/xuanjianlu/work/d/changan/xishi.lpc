inherit ROOM;
void create() {
  set("short", "西市");
  set("long", @LONG
   这是西安的西市，与城东的东市遥相呼应，都是西安的交易中心，这里
   人山人海，出出进进，来往的都是生意人，还有往来不绝的市民，东面
   是一家肉店，西面是一个菜市，北面有一阵水果香味传来。
LONG);
  set("exits", ([
    "north": __DIR__ "guoshi",
    "south": __DIR__ "xidajie-3",
    "east": __DIR__ "roudian",
    "west": __DIR__ "caishi",
  ]));
  set("objects", ([
    __DIR__ "npc/youke": 2,
  ]));
  set("outdoors", "xi'an");
  setup();
}
