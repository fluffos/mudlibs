inherit ROOM;
void create()
{ 
   set("short","农田");
   set("long",@LONG
一片绿油油的农田，有几个，农夫在农田上辛勤的耕耘，一滴一滴
的汗水洒在土地上，头顶上骄阳是火，东北方是农田的延伸，再往
南走就是西安的西市了。
LONG);
   set("exits",([
   "northeast" : __DIR__"nongtian-1",
   "south" : __DIR__"caishi",
   "west" : __DIR__"mingfang-3",
   ]));
   set("outdoors","xi'an");
   setup();
}