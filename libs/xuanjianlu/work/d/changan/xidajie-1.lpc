    "north": __DIR__ "yamen",
      "south": __DIR__ "bingyindamen",
      "west": __DIR__ "xidajie-2",
      "east": __DIR__ "center",
    ]));



  set("outdoors", "xi'an");
  set("no_clean_up", 0);
  setup();
}
