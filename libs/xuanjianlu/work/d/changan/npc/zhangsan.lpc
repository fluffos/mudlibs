// 怒剑狂刀
 
//zhangsan.c


inherit NPC;
int ask_jingubang();


void create()
{
   
        set_name("张三", ({"zhang san", "zhang"}));
        set("title", "剑铺老板");
        set("gender", "男性");
        set("age", 25);
        set("long", "剑铺老板。
凶蛮狠毒。\n");
        set("inquiry",([
        "jingubang" : (:ask_jingubang:),
		]));


        setup();
	carry_object("/clone/armor/cloth")->wear();
}

void init()
{   
	int buy;
	add_action("do_vendor_buy","buy");
}

int ask_jingubang()
{	
     message_vision("张三看了$N一眼，对$N说:拿1两黄金来!\n",this_player());
	 this_player()->set_temp("jingubang",1);
	 return 1;
}

int accept_jingubang()
{   
   object obj;
   if(!this_player()->query_temp("jingubang"))
   {
	   message_vision("张三对$N说:要买金箍棒,没门!\n",this_player());
	   return 0;
   }
   if(this_player()->query_temp("jingubang")==1)
   {
	   message_vision("张三给$N一根金箍棒",this_player());
       this_player()->delete_temp("jingubang");
	   obj=new("/d/xi'an/obj/jingubang");
	   obj->move(this_player());
   } 
   return 1;
}





