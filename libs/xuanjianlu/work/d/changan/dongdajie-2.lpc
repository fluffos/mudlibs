    "north": __DIR__ "mingfang-2",
      "south": __DIR__ "tiejiangpu",
      "west": __DIR__ "dongdajie-1",
      "east": __DIR__ "dongdajie-3",
    ]));

  set("objects", ([
    __DIR__ "npc/youke": 1,
    __DIR__ "npc/xiaopizi": 1,
  ]));

  set("outdoors", "xi'an");
  set("no_clean_up", 0);
  setup();
}
