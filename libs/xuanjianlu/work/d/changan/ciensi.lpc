//怒剑狂刀
 
//ciensi.c
inherit ROOM;

void create ()
{
  set ("short", "慈恩寺");
  set ("long", @LONG

走进慈恩寺，进入眼帘的是雄伟的大雁塔(dyt)，七层突兀于灵空，甚是壮
观。寺内古柏森森，绿阴成片，左右钟鼓楼遥遥相对。院内有两组石
碑群，为一些著名进士所题刻。
LONG);

  set("item_desc", ([

	  "dyt" : "大雁塔为一座七层方形塔，塔身十分雄伟，底座宽大，造
型简洁庄严神秘。方塔底座有门，门楣上有石刻画。\n",
				]));


  set("exits", ([
        
        "northwest"     : __DIR__"wangnanjie",
      ]));
  set("outdoors", __DIR__);

  setup();
}

void init()
{
	add_action("do_enter", "enter");
}


int do_enter(string arg)
{
   object me;
   me=this_player();

     if(!arg || arg=="") return 0;

	 if( arg=="dyt")
	 {
		 message("vision",
			 me->name() + "走进大雁塔里了。\n",
			 environment(me), ({me}) );
		          me->move("/d/xi'an/dyt1");
         message("vision",me->name() + "从塔外走了进来。\n",
			 environment(me), ({me}) );
         
		 return 1;
	 }


}




