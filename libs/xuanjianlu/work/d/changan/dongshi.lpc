inherit ROOM;
void create() {
  set("short", "东市");
  set("long", @LONG
   这是西安的东市，与城西的西市遥相呼应，都是西安的交易中心，这里
   人山人海，出出进进，来往的都是生意人，还有往来不绝的市民，东面
   是一家布店，西面是一个染料坊，北面是丝绸店。
LONG);
  set("exits", ([
    "north": __DIR__ "sichou",
    "south": __DIR__ "dongdajie-3",
    "east": __DIR__ "budian",
    "west": __DIR__ "ranliao",
  ]));
  set("objects", ([
    __DIR__ "npc/youke": 2,
  ]));
  set("outdoors", "xi'an");
  setup();
}
