// chen

inherit ROOM;
void create()
{
  set("short","菜市");
  set("long",@LONG
这是一个菜市，里面有无数的小贩，在不听的吆喝着，此起彼伏，甚是热闹，
市里各种蔬菜应有尽有，品类齐全，价格低廉，引来无数市民。北面是一片
广阔的农田。
LONG);
  set("exits",([
  "east" : __DIR__"xishi",
  "north" : __DIR__"nongtian-2",
  ]));
  set("outdoors","xi'an");
  setup();
}