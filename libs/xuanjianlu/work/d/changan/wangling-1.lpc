//chen

inherit ROOM;
void create() {
  set("short", "秦王墓");
  set("long", @LONG
这里已经是秦王陵地内部了，四处全是由泥做成的兵俑，
兵俑们排成一个个方阵，气势逼人，使人不由想起当年
秦始皇横扫六国的威风，四周每一处都做工精美，也不
知花了多少人的汗水。
LONG);
  set("exits", ([
    "out": __DIR__ "wangling",
    "east": __DIR__ "wangling-2",
    "west": __DIR__ "wangling-3",
    "northup": __DIR__ "wangling-4",
  ]));
  setup();
}
