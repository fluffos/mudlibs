//Room: majiu.c 马厩


inherit ROOM;

void create()
{
      set("short","马厩");
      set("long",@LONG
这是客店后的马厩，常年供应新鲜草料。扬州民风淳朴，马夫们会把
马牵到马厩好生照看，将它们喂饱饮足，再洗刷得干乾净净，一直伺候到
客人上路,马厩中堆放著几堆草料，正中有一口泔槽。
LONG);
      set("outdoors", "xi'an");
      set("no_fight", "1");
      set("no_beg", "1");
      set("no_clean_up", 0);
      set("objects", ([
               __DIR__"npc/zaohongma": 1,
               __DIR__"npc/huangbiaoma": 1,
               __DIR__"npc/ziliuma": 1,
               __DIR__"npc/mafu": 1,
      ]));
      set("exits",([ /* sizeof() == 1 */
          "east"      : __DIR__"beidajie-1",
      ]));
      setup();
      replace_program(ROOM);
}
