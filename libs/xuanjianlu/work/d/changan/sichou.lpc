{
  set("short","丝绸店");
  set("long",@LONG
这是一个西安的一个丝绸店，店主年轻时走南闯北，各地丝绸了如之掌，
店里经营各地丝绸，品类齐全，质量可靠,顾客好评如潮。
LONG);
  set("exits",([
  "northeast" : __DIR__"dadao-3",
  "northwest" : __DIR__"mingfang-5",
  "south" : __DIR__"dongshi",
  ]));
  //set("outdoors","xi'an");
  setup();
}