// Room: wuguan.c


inherit ROOM;
void create() {
  set("short", "武馆旧址");
  set("long", @LONG
这武馆本是专为初出江湖的少年设立的。初出道的少年可以在此学习
一些基本的防身武功，一来不会光阴虚度，二来也好为今后选定一个
心慕的门派。但由于馆主经营不善，已没有昔日的风光了！墙上贴着
个贴子(tiezi)。
LONG);
  set("objects", ([
    __DIR__ "npc/chen": 1,
  ]));
  set("no_fight", 1);
  set("no_steal", 1);
  set("no_beg", 1);
  set("item_desc", ([
    "tiezi": @TEXT
武馆敬启者：
   由于本武馆经营不善，缺乏资金已无力资助各位少侠，现闭馆整顿，
希望各位少侠见谅。
                               馆主：陈



TEXT ]));
  set("exits", ([
    "north": __DIR__ "xidajie-2",
  ]));
  set("no_clean_up", 0);
  setup();
}
