inherit ROOM;
void create() {
  set("short", "农田");
  set("long", @LONG
一片绿油油的农田，有几个，农夫在农田上辛勤的耕耘，一滴一滴
的汗水洒在土地上，头顶上骄阳是火，西南方是农田的延伸，再往
东走就是西安的北大街了。
LONG);
  set("exits", ([
    "east": __DIR__ "dadao",
    "south": __DIR__ "guoshi",
    "southwest": __DIR__ "nongtian-2",
  ]));
  set("outdoors", "xi'an");
  setup();
}
