//By Seashore

#include <dbase.h>;
inherit F_DBASE;
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  mapping map, tlist, conditions;
  mixed *tlist2;
  string *sname, *mapped, text, *cdts;
  int loop, i;

  seteuid(getuid(me));

  if (!arg) ob = me;
  else {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的condition？\n");
  }

  conditions = ob->query_all_condition();
  if (!sizeof(conditions)) {
    write((ob == me ? "你" : ob->name()) + "目前并没有设定任何conditons。\n");
    return 1;
  }
  cdts = keys(conditions);
  printf((ob == me ? "你" : ob->name()) + "目前身上的conditions有：\n");
  for (i = 0; i < sizeof(cdts); i++)
    printf("%-30s--------%8d\n", cdts[i], conditions[cdts[i]]);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : qcd [id/npc name]
 
这个指令可以显示出player或npc身上的conditions.
 
HELP
  );
  return 1;
}
