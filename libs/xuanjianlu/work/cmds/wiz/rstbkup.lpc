// restorebackup.c
// restore player's data from backup
// by sdong , 11/18/98

#include <ansi.h>
#include <combat.h>
#ifndef QUEUEDIR
#define QUEUEDIR "/queue/"
#endif
#define RESTOREDATA QUEUEDIR + "restore"
#define LOCKDATA QUEUEDIR + "restore.lock"
#define SOURCEDIR "/backup/"
#define TARGETDIR "/data/user/"

inherit F_DBASE;
inherit F_CLEAN_UP;

