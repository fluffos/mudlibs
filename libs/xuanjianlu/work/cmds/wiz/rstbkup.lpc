int main(object me, string arg)
{
	object obj,ob;
	string name,date,initial,src,dst;

	if( wizhood(me) != "(caretaker)" && wizhood(me) != "(wizard)" &&
		  wizhood(me) != "(arch)" && wizhood(me) != "(admin)"
	  ) return notify_fail("什么？\n");

	if (!arg) return notify_fail("指令格式：rstbkup id 日期\n");
	if(sscanf(arg, "%s %s", name, date) != 2)return notify_fail("指令格式：rstbkup player #backup.\n");
	
	src = sprintf(SOURCEDIR "%s/user/%c/%s.o", date,name[0], name);
	dst = sprintf(TARGETDIR "%c/%s.o", name[0], name);
	if( file_size(src) < 0 ) {
		ob = present(src, me);
		if( !ob ) ob = present(src, environment(me));
		if( !ob ) return notify_fail("没有这个档案。请检查id和日期是否正确！\n");
	}
	printf(HIY"备份文件：%s\n",src);
	printf(HIW"目标文件：%s\n",dst);
	if( cp(src, dst) )
		write(HIM"恢复完毕。\n"NOR);
	else write(HIR"错误，请检查id和日期是否正确！"NOR);
	write_file("/log/rstbkup.lpc",
                        sprintf("%s(%s)于%s为%s恢复了档案。 \n",
                        me->name(), getuid(me),ctime(time()),name));
		return 1;
}
int help(object me)
{
write(@HELP
指令格式：rstbkup id 日期
如：rstbkup hatcher 2001-1-22

用来从备份中恢复玩家数据
HELP
	 );
	 return 1;
}

