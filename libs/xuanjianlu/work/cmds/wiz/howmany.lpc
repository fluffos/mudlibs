// howmany.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  int i, j, reg_cnt;
  string *dir, *ppls, name;
  mixed info;
  seteuid(getuid());
  reg_cnt = 0;
  dir = get_dir(DATA_DIR + "login/");
  for (i = 0; i < sizeof(dir); i++) {
    reset_eval_cost();
    ppls = get_dir(DATA_DIR + "login/" + dir[i] + "/");
    reg_cnt += sizeof(ppls);
  }
  write(HIR "※" HIY + MUD_NAME + HIR "※" HIC "现有注册玩家" HIY + reg_cnt + HIC "位。\n" NOR);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式: howmany

告诉你现在本游戏共有多少注册玩家。
HELP
  );
  return 1;
}
