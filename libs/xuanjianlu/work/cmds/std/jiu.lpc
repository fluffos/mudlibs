#include <ansi.h>
void set_hp(object player,object ob);

int main(object me, string arg)
{
	string who;
	object killob,ob,*inv,jiudaiob;
	int i;
/*
	inv=all_inventory(environment(me));
	for (i=0;i<sizeof(inv);i++) {
		if (inv[i]->query("id") == arg && objectp(inv[i]) )
			me=inv[i];
	}

//	if (!objectp(ob)) return notify_fail("什么！\n");
	i=0;

	if (!arg || arg!=ob->query("id") ){
		write("你想救谁？\n");
		return 1;
	}
*/
	//if (!me->query("hengshan") && me->query("id")!="box") 
	if (!me->query("hengshan")) 
		return notify_fail("什么？\n");

	if (! arg || sscanf(arg, "%s",who) != 1) 
		return notify_fail("指令格式：jiu <人物>\n");

	if (! objectp(ob = present(who, environment(me))))
		return notify_fail("你要救谁？\n");

	//if (ob->query("player_id") != me->query("id") && me->query("id")!="box") 
	if (ob->query("player_id") != me->query("id")) 
		return notify_fail("这是你要救的人吗？\n");

/*	if (!(jiudaiob=present("jiudai",ob)) ){
		tell_object(ob,"这位师太昏迷不醒，看来中了迷药，还是先救醒了再说吧！\n");
		return 1;
	}
	if (jiudaiob->query("liquid/remaining") < 1)
        	return notify_fail(jiudaiob->query("name")+"里面的水已经用光了。\n");*/
	if (!ob->query("bang") )
		return notify_fail("已经救醒了，还救什么？想吃豆腐呀！\n");
/*	jiudaiob->add("liquid/remaining", -3);
	message_vision("$N当即取了一杓冷水，泼了少许在$n脸上。过得片刻，$n嘤咛一声，醒了转来。\n",ob,me);
	me->revive(30);*/
	ob->delete("bang");
//	message_vision("$N初时不知身在何地，微微睁眼，突然省悟，当即跃起，想去摸身边长剑时，才知手足被缚，险些重又跌倒。\n\n",me);
	message_vision("$n对$N说道：“小师太，别怕!是定闲师太要我来此援助你等。快跟我走吧。”\n说罢拔刀割断了她手足上绳索。\n\n",ob,me);
	message_vision(HIY"$N正想离开此地，忽闻身后一声轻响，$n大叫一声：“大侠小心！”\n"NOR,me,ob);
	message_vision(HIW"$n忙拉住$N往旁一闪，躲开了身后致命一剑！\n$N转身一看，一个黑巾蒙面的蒙面人挥剑刺向$N的要穴！\n"NOR,me,ob);
	me->set_temp("blockroad",1);
	killob = new("/d/hengshan/npc/mmkill");
	killob->move(environment(ob));
        killob->make_killer(killob,me);

	//if(me->query("id")!="box")
		killob->kill_ob(me);
	killob->set("player_id",me->query("id"));
	inv = all_inventory(environment(me));
	for(i=0; i<sizeof(inv); i++) 
	{
		if( inv[i]->query("family/family_name")=="恒山派" ) 
		{
			message_vision("\n$N大喝一声：“看剑！”挥剑冲了上来。\n",inv[i] );
			inv[i]->kill_ob(killob);
			//if(me->query("id")!="box")
				me->kill_ob(killob);
		}
	}
	//if(me->query("id")!="box")
		ob->kill_ob(killob);
	return 1;
}