// Create by box

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
        string dest, cmd;
        object ob;

        if( me != this_player() ) 
        	return 0;

        if( !arg || sscanf(arg, "%s to %s", dest, cmd) != 2 )
                return notify_fail("指令格式: order <某人> to <指令>\n");
                 
        if( !objectp(ob = present(dest, environment(me))))
                return notify_fail("你要命令谁？\n");
                
        if( !living(ob) )
                return notify_fail("他已经不能执行命令了。\n");
                
        if( ob->query("master")!=me->query("id") && !wizardp(me) )        
        	return notify_fail("他不是你的武士！你不能对他下命令！\n");
/*
	if( wiz_level(me) <= wiz_level(ob) )
		return notify_fail("你没有强制" + ob->name() + "执行指令的权力。\n");
*/
        if( userp(ob) )
                log_file("force_wushi", sprintf("[%s] %s forces %s to %s\n",  
                        ctime(time()), geteuid(me), geteuid(ob), cmd));
        return ob->force_me(cmd);
}

int help(object me)
{
        write(@Help
 指令格式: order <明教武士> to <指令>

 命令明教武士做事。
Help
        );
        return 1;
}



