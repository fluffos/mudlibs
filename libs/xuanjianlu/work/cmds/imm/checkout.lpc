// checkout.c
// By Oky (2001/4/24)

#include <ansi.h>

inherit F_CLEAN_UP;

mapping valid_types = ([
  "unarmed": "拳脚",
  "sword": "剑法",
  "blade": "刀法",
  "stick": "棍法",
  "staff": "杖法",
  "kick": "腿法",
  "force": "内功",
  "parry": "招架",
  "dodge": "轻功",
  "array": "阵法",
  "whip": "鞭法",
  "cuff": "拳法",
  "strike": "掌法",
  "club": "棍法",
  "hammer": "锤法",
  "hand": "手法",
  "finger": "指法",
  "claw": "爪法",
]);

int main(object me, string arg) {
  object player;
  mapping map;
  string *types, *skill, ski, map_to, str;
  int i, modify;

  if (arg) {
    player = present(arg, environment(me));
    if (!player)
      player = find_player(arg);
    if (!player)
      player = find_living(arg);
    if (!player)
      return notify_fail("你想查看谁的状态? \n");

    map = player->query_skill_map();
    if (!mapp(map) || sizeof(map) == 0)
      return notify_fail(player->query("name") + "现在没有使用任何特殊技能。\n");


    skill = keys(valid_types);

    write(HBBLU + HIY "" + (player == me ? "你目前使用中的特殊技能：                                          \n\n" NOR : player->name() + "目前使用中的特殊技能：                                      \n\n" NOR));


    str = "\n";
    write("┌─" HBBLU + HIW "基本技能" NOR "────────" HBBLU + HIW "特殊技能" NOR "───────" HBBLU + HIW "有效等级" NOR "───┐" NOR);
    write("\n");
    for (i = 0; i < sizeof(skill); i++) {
      if (undefinedp(valid_types[skill[i]])) {
        map_delete(map, skill[i]);
        continue;
      }
      if (!player->query_skill(skill[i])) continue;
      modify = player->query_temp("apply/" + skill[i]);
      printf("│  %-20s： %-20s  有效等级：%s%3d  " NOR "│\n" NOR,
        valid_types[skill[i]] + " (" + skill[i] + ")",
        undefinedp(map[skill[i]]) ? "无" :
        to_chinese(map[skill[i]]),
        (modify == 0 ? "" : (modify > 0 ? HIC : HIR)),
        player->query_skill(skill[i]));
    }
    str += "└───────────────────────────────┘\n";

    me->start_more(str);
    return 1;
  } else {
    return notify_fail("你想看谁的状态啊? \n");
  }
}

int help(object me) {
  write(@HELP
指令格式 : checkout <某人>

指令用途：这个指令可以让你查出其他使用者所指明技能种类和
技能名称。（巫师专用）
HELP
  );
  return 1;
}
