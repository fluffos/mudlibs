// Change by Server
// summon command..

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string str) {
  object ob;
  int i;
  if (!str) return notify_fail("<Syntax>: Summon <player Id>\n");
  ob = LOGIN_D->find_body(str);
  if (!ob) ob = find_object(str);

  if (!ob) return notify_fail("咦... 有这个人吗?\n");

  // moving
  tell_room(environment(ob), MAG "突然间天昏地暗，乌云密布，你恍惚间看到一个金甲天神出现在云端\n" +
    "天空中" + (string)me->name() + "伸出一只大手把" + (string)ob->name() + "抓了起来, 然後不见了.\n" NOR);

  tell_object(ob, HIR "一只手把你抓了起来, 你眼前一阵黑....\n" NOR);

  ob->move(environment(me));

  tell_object(me, HIY "你把" + (string)ob->query("name") + "抓到你的面前.\n" NOR);

  tell_object(ob, HIR ".... 醒来时发现是" + (string)me->query("name") + "把你弄过来的.\n" NOR);

  tell_room(environment(ob), HIG "" + (string)ob->name() + "突然出现" + "在你眼前\n" NOR, ({ me, ob }));

  // ok ..
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : summon <某人>

此指令可让你(你)将某人抓到你面前。
HELP
  );
  return 1;
}
