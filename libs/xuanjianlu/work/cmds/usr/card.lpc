#include <ansi.h>
#include <mudlib.h>

inherit F_CLEAN_UP;
int print_info(object usr);

int main(object me, string arg) {
  object ob = this_player();
  string msg;
  object usr;
  /*
       if (!wizardp(me))
                 return notify_fail("你不是巫师，不能使用这个命令。\n");
*/
  if (!arg) {
    msg = BBLU HIY + "       " + "【玄剑录卡片档案】(GB中文)" + "         \n" NOR;
    msg += "┌───────────────────┐\n";
    msg += "│卡片(GB中文)                          │\n";
    msg += "│┌┄┄┄┄┐  名字：_________         │\n";
    msg += "│┊        ┊                          │\n";

    if (ob->query("family/family_name", 1) == "丐帮") {
      msg += "│┊        ┊  门派：" + HIW + ob->query("family/family_name") + NOR "    年龄：___ │\n" NOR;
    } else {
      msg += "│┊        ┊  门派：" + HIW + ob->query("family/family_name") + NOR "  年龄：___ │\n" NOR;
    }
    msg += "│┊        ┊  OicQ：_________         │\n";
    msg += "│┊        ┊  URL ：_________________ │\n";
    msg += "│┊        ┊                          │\n";
    msg += "│└┄┄┄┄┘  出生日期：____年__月__日│\n";
    msg += "│   (属相)     E_mail  ：______________│\n";
    msg += "└───────────────────┘\n";

    //     msg += "  " + NATURE_D->game_time() + "记。\n";
    write(msg);
    return 1;
  }
  /*
    else
                 return notify_fail("指令格式：card player.\n");
*/
  usr = present(arg, environment(me));
  if (!usr) usr = present(arg, me);
  if (!usr) usr = find_player(arg);
  if (usr) {
    print_info(usr);
    return 1;
  }

  seteuid(geteuid(me));
  usr = new("/clone/test/dummy");
  usr->set("id", arg);

  if (!wizardp(me))
    return notify_fail("你不是巫师，不能使用这个命令。\n");
  if (!usr->restore())
    return notify_fail("没有这个玩家。\n");
  print_info(usr);
  destruct(usr);
  return 1;

  /*
  else {
       msg  =  BBLU HIY+"       "+"【玄剑录卡片档案】(GB中文)"+"         \n"NOR;
       msg += "┌───────────────────┐\n";
       msg += "│卡片(GB中文)                          │\n";
       msg += "│┌┄┄┄┄┐  名字：_________         │\n";
'       msg += "│┊        ┊                          │\n";' 
       msg += "│┊        ┊  门派："+HIW+ob->query("family/family_name")+NOR"  年龄：___ │\n"NOR;
       msg += "│┊        ┊  OicQ：_________         │\n";
       msg += "│┊        ┊  URL ：_________________ │\n";
       msg += "│┊        ┊                          │\n";
       msg += "│└┄┄┄┄┘  出生日期：____年__月__日│\n";
       msg += "│   (属相)     E_mail  ：______________│\n";
       msg += "└───────────────────┘\n";

//     msg += "  " + NATURE_D->game_time() + "记。\n";
       write(msg);
       return 1;
        }
*/
}

int print_info(object usr) {
  string msg;
  msg = BBLU HIY + "       " + "【玄剑录卡片档案】(GB中文)" + "         \n" NOR;
  msg += "┌───────────────────┐\n";
  msg += "│卡片(GB中文)                          │\n";
  msg += "│┌┄┄┄┄┐  名字：_________         │\n";
  msg += "│┊        ┊                          │\n";
  if (usr->query("family/family_name", 1) == "丐帮") {
    msg += "│┊        ┊  门派：" + HIW + usr->query("family/family_name") + NOR "    年龄：___ │\n" NOR;
  } else {
    msg += "│┊        ┊  门派：" + HIW + usr->query("family/family_name") + NOR "  年龄：___ │\n" NOR;
  }
  msg += "│┊        ┊  OicQ：_________         │\n";
  msg += "│┊        ┊  URL ：_________________ │\n";
  msg += "│┊        ┊                          │\n";
  msg += "│└┄┄┄┄┘  出生日期：____年__月__日│\n";
  msg += "│   (属相)     E_mail  ：______________│\n";
  msg += "└───────────────────┘\n";

  //     msg += "  " + NATURE_D->game_time() + "记。\n";
  write(msg);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : card
 
这个指令可以让你知道你的卡片信息。 
 
HELP
  );
  return 1;
}
