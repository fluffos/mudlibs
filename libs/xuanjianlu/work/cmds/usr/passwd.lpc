// Change by Server
// passwd.c
// play rework 2002.7.25
#ifndef REGI_D
#define REGI_D "/adm/daemons/regid"
#endif
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	string item, who, what;
	int sum;
	
	if (arg && sscanf(arg, "%s %s %s", item, who, what) == 3 &&
		((string)SECURITY_D->get_status(me)=="(admin)" ||
		 (string)SECURITY_D->get_status(me)=="(arch)")) {
		 if(item == "password")
 		 {
                 	if( strlen(what)< 5 ) {
            		write("密码的长度至少要五个字元，请重设密码。\n");
            		return 1;
            		}
		 	write("changing password of " + who + " to " + what + "\n");
		 	return REGI_D->change_password(who, what);
		 }
		 if(item == "wizard_password")
		 {
                 	if( strlen(what)< 8 ) {
            		write("验证码的长度至少要八个字元，请重设验证码。\n");
            		return 1;
            		}
		 	write("changing wizard_password of " + who + " to " + what + "\n");
		 	return REGI_D->change_wizard_password(who, what);
		 }
		 write("指令格式：passwd passwrod [id] [password]\n"
		       "          passwd wizard_passwrod [id] [password]\n");
		 return 1;
	}
	if (arg && sscanf(arg, "%s %d", who, sum) == 2 &&
		((string)SECURITY_D->get_status(me)=="(admin)" ||
		 (string)SECURITY_D->get_status(me)=="(arch)")) {
		 	write("changing validate of " + who + " to " + sum + "\n");
		 	return REGI_D->change_validate(who, sum);
	}
	if (arg && sscanf(arg, "%s %s", who,what) == 2 )
        {
        	if( me != this_player(1) ) return 0;
        	if( who != "wizard_password")
        	{
		 write("指令格式：passwd wizard_password [password]\n");
		 return 1;        		
        	}
        	ob = me->query_temp("link_ob");
        	if( !ob ) return 0;
        	if(!wiz_level(me->query("id"))) return 0;
        	while( ob && ob->is_character() ) ob = ob->query_temp("link_ob");
                if(ob->query("wizard_password"))
                {
                	write("为了安全起见，请先输入您原来的验证码：");
                	input_to("get_old_wizpass", 1, ob);
                }else
                {
	                write("请输入新的巫师验证码：");
                 	input_to("get_new_wizpass", 1, ob );
                }
        	return 1;
	}

	if( me != this_player(1) ) return 0;

	ob = me->query_temp("link_ob");
	if( !ob ) return 0;
	while( ob && ob->is_character() ) ob = ob->query_temp("link_ob");

	write("为了安全起见，请先输入您原来的密码：");
	input_to("get_old_pass", 1, ob);
	return 1;
}

private void get_old_wizpass(string pass, object ob)
{
	string old_wizpass;

	write("\n");
	old_wizpass = ob->query("wizard_password");
	if( crypt(pass, old_wizpass)!=old_wizpass ) {
		write("巫师验证码错误！\n");
		return;
	}
	write("请输入新的巫师验证码：");
	input_to("get_new_wizpass", 1, ob );
}

private void get_new_wizpass(string pass, object ob)
{
	string old_pass;
	old_pass = ob->query("password");
	if( crypt(pass, old_pass)==old_pass ) {
		write("巫师验证码不能和人物密码相同！\n");
		return;
	}
	if( strlen(pass)< 8 ) {
		write("\n验证码的长度至少要八个字元，请重设您的验证码：");
		input_to("get_new_wizpass", 1, ob);
		return;
	}
	write("\n请再输入一次新的巫师验证码：");
	input_to("confirm_new_wizpass", 1, ob, crypt(pass,0));
}

private void confirm_new_wizpass(string pass, object ob, string new_pass)
{
	write("\n");
	if( crypt(pass, new_pass)!=new_pass ) {
		write("对不起，您输入的巫师验证码并不相同，继续使用原来的验证码。\n");
		return;
	}
	seteuid(getuid());
	if( !ob->set("wizard_password", new_pass) ) {
		write("巫师验证码变更失败！\n");
		return;
	}

	ob->save();
	write("巫师验证码变更成功。\n");
}
private void get_old_pass(string pass, object ob)
{
	string old_pass;

	write("\n");
	old_pass = ob->query("password");
	if( crypt(pass, old_pass)!=old_pass ) {
		write("密码错误！\n");
		return;
	}
	write("请输入新的密码：");
	input_to("get_new_pass", 1, ob );
}

private void get_new_pass(string pass, object ob)
{
	if( strlen(pass)< 5 ) {
		write("\n密码的长度至少要五个字元，请重设您的密码：");
		input_to("get_new_pass", 1, ob);
		return;
	}
	write("\n");
	write("请再输入一次新的密码：");
	input_to("confirm_new_pass", 1, ob, crypt(pass,0));
}

private void confirm_new_pass(string pass, object ob, string new_pass)
{
	write("\n");
	if( crypt(pass, new_pass)!=new_pass ) {
		write("对不起，您输入的密码并不相同，继续使用原来的密码。\n");
		return;
	}
	seteuid(getuid());
	if( !ob->set("password", new_pass) ) {
		write("密码变更失败！\n");
		return;
	}

	ob->save();
	write("密码变更成功\。\n");
}
int help(object me)
{
	write(@HELP
指令格式 : passwd
 
这个指令可以修改你的人物密码。
 
HELP
    );
    return 1;
}
 
