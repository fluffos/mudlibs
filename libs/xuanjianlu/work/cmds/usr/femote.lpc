//femote.c 
//By Seashore(2002-05-08)

#include <ansi.h>
inherit F_CLEAN_UP;
string convert(string str, object me, object target);

int main(object me, string arg) {
  mapping emote, result;
  string *e, content;
  int i, cnt, start;
  object target;

  if (!arg) return notify_fail("femote <关键字>\n"
    + "功能：列出目前所有含指定关键字的 emote。比如：\n\n"
    + "femote 飞起一\n"
    + "只要匹配到了femote指定的关键字，即返回一个结果。\n");

  target = new(USER_OB);
  target->set("name", "某人");
  target->set("mud_age", 540757);
  target->set("age", 20);
  target->set("gender", "男性");

  e = sort_array(EMOTE_D->query_all_emote(), 1);

  for (i = 0; i < sizeof(e); i++) {
    emote = EMOTE_D->query_emote(e[i]);

    if (emote["others"] && strsrch(emote["others"], arg) >= 0) {
      content = emote["others"];
      content = convert(content, me, target);
      if (!start) {
        write("查询结果\n");
        write(HIB "───────────────────────────────────\n" NOR);
        start = 1;
      }
      write(HIR + e[i] + "\n" NOR);
      write("动作：" + content + "\n");
      cnt++;
      if (cnt > 50) return notify_fail("符合该条件的emote数量太多，请重新选择条件查找。\n");
    }

    if (emote["others_self"] && strsrch(emote["others_self"], arg) >= 0) {
      content = emote["others_self"];
      content = convert(content, me, target);
      if (!start) {
        write("查询结果\n");
        write(HIB "───────────────────────────────────\n" NOR);
        start = 1;
      }
      write(HIR + e[i] + HIW " <自己>\n" NOR);
      write("动作：" + content + "\n");
      cnt++;
      if (cnt > 50) return notify_fail("符合该条件的emote数量太多，请重新选择条件查找。\n");
    }

    if (emote["others_target"] && strsrch(emote["others_target"], arg) >= 0) {
      content = emote["others_target"];
      content = convert(content, me, target);
      if (!start) {
        write("查询结果\n");
        write(HIB "───────────────────────────────────\n" NOR);
        start = 1;
      }
      write(HIR + e[i] + HIR " <某人>\n" NOR);
      write("动作：" + content + "\n");
      cnt++;
      if (cnt > 50) return notify_fail("符合该条件的emote数量太多，请重新选择条件查找。\n");
    }
    emote = ([]);
  }

  if (cnt) {
    write("在侠客行中，包含“" + arg + "”的 emote 共有 " + cnt + " 个。\n");
    write(HIB "───────────────────────────────────\n" NOR);
  } else printf("侠客行中无符合查询条件的 emote。\n");

  destruct(target);
  return 1;
}

string convert(string str, object me, object target) {
  str = replace_string(str, "$S", RANK_D->query_self(me));
  str = replace_string(str, "$s", RANK_D->query_self_rude(me));
  str = replace_string(str, "$N", me->name());
  str = replace_string(str, "$P", gender_self(me->query("gender")));

  str = replace_string(str, "$C", RANK_D->query_self_close(target));
  str = replace_string(str, "$c", RANK_D->query_close(target));
  str = replace_string(str, "$R", RANK_D->query_respect(target));
  str = replace_string(str, "$r", RANK_D->query_rude(target));
  str = replace_string(str, "$n", target->query("name"));
  str = replace_string(str, "$p", gender_pronoun(target->query("gender")));
  return str;
}

int help(object me) {
  write(@HELP
femote 关键字
功能：列出目前所有含指定关键字的 emote。比如：

femote 飞起一

只要匹配到了femote指定的关键字，即返回一个结果。
暂不支持"*"。
)
HELP
  );
  return 1;
}
