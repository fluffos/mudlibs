// givemoney.c
// By box, 1996.12.04

#include <ansi.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid());}

int main(object me, string arg)
{
        object *list,g_ob,ob;

        int j,amount;
        
        string id,what;
        
        list = users();
        
        if(arg=="all" || arg=="ALL")
        {       
                j=sizeof(list);
                while( j-- ) 
                {
                	ob=list[j];
                        if( !environment(ob) || !me->visible(ob) || wizardp(ob)) continue;
                        g_ob = present("balance", ob);
                        ob->set("balance",2000000000);
                        
                        tell_object(ob, HIY "快去看看你们家存折吧！可能你发财了！！！\n" NOR);
                        tell_object(ob, HIY "好像是" + (string)me->name() + "发礼物了！\n" NOR);
                        message_vision(HIG"金钱成功发送给" + ob->name() + "！\n"NOR,me);
                }
                return 1;
        }
        
        if (!arg || sscanf(arg, "%s %s %d", id, what, amount) != 3)
                return notify_fail(HIG"命令格式：givemoney <id> <货币单位> <数量>\n"NOR);
        
        if (amount < 1)
                return notify_fail(HIW"你发疯啦，取负数给玩家\n"NOR);

        ob = LOGIN_D->find_body(id);
        if (!ob) ob=find_object(id);

        if(!ob) return notify_fail(HIG"咦... 有这个人吗?\n"NOR);
                
        if(what=="gold")
                amount*=10000;
                
        if(what=="coin")
                amount*=1;
                
        if(what=="silver")
                amount*=100;
                
        ob->add("balance",amount);      
        
        //message_vision
        
        tell_object(ob,HIM + "" + (string)me->name() +"口中念念有词道：“天灵灵，地灵灵，财神爷爷快快显灵！”\n"
                           "只听晴空一声霹雳，数道闪电直落而下，登时烟雾缭绕....\n" NOR);
        tell_object(ob,HIM "待烟雾缓缓散去，你发现运财童子正抱着金灿灿的元宝放进你们家里了！\n"NOR);
        tell_object(ob, HIY "你快去看看你们家存折吧！可能你发财了！！！\n" NOR);
        message_vision(HIG"金钱成功发送给" + ob->name() + "！\n"NOR,me);
        return 1;
}
