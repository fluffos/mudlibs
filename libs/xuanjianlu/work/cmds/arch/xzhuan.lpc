#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  int i, j, exp, skill_lv;
  object ob;
  string menpai, obj, ttt;
  mapping my_family, family;
  string *zhuan_skills;
  string *zhuan_menpai = ({
    "shaolin",
    "wudang",
    "emei",
    "taohua",
    "lingjiu",
    "xingxiu",
    "baituo",
    "xueshan",
    "dali",
    "gaibang",
    "gumu",
    "huashan",
    "quanzhen",
    "shenlong",
    "mingjiao",
  });

  string *basic_skills = ({
    "dodge",
    "parry",
    "force",
    "hand",
    "kick",
    "finger",
    "blade",
    "sword",
    "stick",
    "strike",
    "cuff",
    "staff",
    "hammer",
    "claw",
    "whip",
  });



  if (!arg)
    return notify_fail("zhuan <某人> <经验> <门派>\n");
  if (!arg || sscanf(arg, "%s %d %s", obj, exp, menpai) != 3)
    return notify_fail("zhuan <某人> <经验> <门派>。\n");

  ob = find_player(obj);
  if (!ob)
    ob = find_living(obj);
  if (!ob)
    return notify_fail("找不到这个生物.\n");
  j = 0;
  for (i = 0; i < sizeof(zhuan_menpai); i++) {
    if (menpai == zhuan_menpai[i])
      j += 1;
  }
  if (j == 0)
    return notify_fail("没有这个门派。\n");
  if (wizhood(me) != "(admin)")
    return notify_fail("" + me->query("id") + "没有给" + ob->name() + "转站的权利。\n");

  /*	
	if (ob->query("zhuanzhan")>0)
		return notify_fail("此人已经转过站了，不需要重复操作！\n");
*/
  /*
	if( !mapp(my_family = me->query("family")) ) 
		return notify_fail("给别人转站，自己得先有个门派！\n");
*/
  write(WHT "开始为 " NOR + ob->short(1) + WHT "转站：\n" NOR);
  family = allocate_mapping(sizeof(my_family));

  switch (menpai) {
    case "lingjiu":
      family["master_id"] = "shi sao";
      family["master_name"] = "石嫂";
      family["family_name"] = "灵鹫宫";
      family["generation"] = 5;
      family["enter_time"] = time();
      zhuan_skills = ({
        "bahuang-gong",
        "music",
        "ruyi-dao",
        "yueying-wubu",
        "tianyu-qijian",
        "liuyang-zhang",
        "zhemei-shou",
      });
      break;
    case "taohua":
      family["master_id"] = "lu chengfeng";
      family["master_name"] = "陆乘风";
      family["family_name"] = "桃花岛";
      family["generation"] = 3;
      family["enter_time"] = time();
      zhuan_skills = ({
        "bitao-xuangong",
        "qimen-dunjia",
        "music",
        "yuxiao-jian",
        "luoying-shenjian",
        "luoying-shenfa",
        "lanhua-fuxue",
        "xuanfeng-saoye",
        "tanzhi-shentong",
      });
      break;
    case "baituo":
      family["master_id"] = "ma guangzuo";
      family["master_name"] = "马光佐";
      family["family_name"] = "白驼山";
      family["generation"] = 4;
      family["enter_time"] = time();
      zhuan_skills = ({
        "hamagong",
        "chanchubu",
        "lingshe-quan",
        "lingshe-zhang",
        "shentuo-zhang",
        "poison",
      });
      break;
    case "xingxiu":
      family["master_id"] = "tianlang zi";
      family["master_name"] = "天狼子";
      family["family_name"] = "星宿派";
      family["generation"] = 3;
      family["enter_time"] = time();
      zhuan_skills = ({
        "huagong-dafa",
        "poison",
        "chousui-zhang",
        "tianshan-zhang",
        "zhaixinggong",
        "sanyin-zhua",
        "feixing-shu",  //Add by Kevin 2003-1-2
      });
      break;
    case "wudang":
      family["master_id"] = "lingxu daozhang";
      family["master_name"] = "灵虚道长";
      family["family_name"] = "武当派";
      family["generation"] = 4;
      family["enter_time"] = time();
      zhuan_skills = ({
        "taiji-shengong",
        "taiji-jian",
        "taiji-quan",
        "mian-zhang",
        "tiyunzong",
        "taoism",
      });
      break;
    case "xueshan":
      family["master_id"] = "changqi lama";
      family["master_name"] = "昌齐大喇嘛";
      family["family_name"] = "雪山派";
      family["generation"] = 13;
      family["enter_time"] = time();
      zhuan_skills = ({
        "longxiang-banruo",
        "mingwang-jian",
        "huoyan-dao",
        "jingang-chu",
        "shenkongxing",
        "yujiamu-quan",
        "lamaism",
        "necromancy",
      });
      break;
    case "shaolin":
      family["master_id"] = "qingfa biqiu";
      family["master_name"] = "清法比丘";
      family["family_name"] = "少林派";
      family["generation"] = 41;
      family["enter_time"] = time();
      zhuan_skills = ({
        "hunyuan-yiqi",
        "damo-jian",
        "luohan-quan",
        "shaolin-shenfa",
        "buddhism",
      });
      break;
    case "huashan":
      if (ob->query("gender") == "男性") {
        family["master_id"] = "yue buqun";
        family["master_name"] = "岳不群";
      }
      if (ob->query("gender") == "女性") {
        family["master_id"] = "ning zhongze";
        family["master_name"] = "宁中则";
      }
      family["family_name"] = "华山派";
      family["generation"] = 14;
      family["enter_time"] = time();
      zhuan_skills = ({
        "huashan-jianfa",
        "huashan-shenfa",
        "zhengqi-jue",
        "ziyin-yin",
        "hunyuan-zhang",
        "pishi-poyu",
        "zixia-gong",
        "liangyi-dao",
      });
      break;
    case "gaibang":
      family["master_id"] = "lu youjiao";
      family["master_name"] = "鲁有脚";
      family["family_name"] = "丐帮";
      family["generation"] = 19;
      family["enter_time"] = time();
      zhuan_skills = ({
        "huntian-qigong",
        "dagou-bang",
        "xianglong-zhang",
        "liuhe-dao",
        "fengmo-zhang",
        "shexing-diaoshou",
        "xiaoyaoyou",
      });
      break;
    case "emei":
      family["master_id"] = "fang bilin";
      family["master_name"] = "方碧琳";
      family["family_name"] = "峨嵋派";
      family["generation"] = 5;
      family["enter_time"] = time();
      zhuan_skills = ({
        "jinding-zhang",
        "linji-zhuang",
        "tiangang-zhi",
        "yanxing-dao",
        "zhutian-bu",
        "persuading",
        "mahayana",
        "emei-jian",
      });
      break;
    case "shenlong":
      family["master_id"] = "pang toutuo";
      family["master_name"] = "胖头陀";
      family["family_name"] = "神龙教";
      family["generation"] = 3;
      family["enter_time"] = time();
      zhuan_skills = ({
        "jueming-tui",
        "lingshe-shenfa",
        "dulong-dafa",
        "medicine",
        "poison",
        "qilin-dao",
        "hook",
        "huanying-zhi",
        "ruyi-gou",
      });
      break;
    case "dali":
      family["master_id"] = "zhu wanli";
      family["master_name"] = "褚万里";
      family["family_name"] = "大理段家";
      family["generation"] = 16;
      family["enter_time"] = time();
      zhuan_skills = ({
        "buddhism",
        "duanjia-jian",
        "duanshi-shenfa",
        "jinyu-quan",
        "kurong-changong",
      });
      break;
    case "gumu":
      //			family["master_id"] = "xiao longnu";
      //			family["master_name"] = "小龙女";
      family["family_name"] = "古墓派";
      family["generation"] = 5;
      family["enter_time"] = time();
      zhuan_skills = ({
        "yunu-xinjing",
        "yunu-jue",
        "tianluo-diwang",
        "yunu-jianfa",  //modified by kevin 2003-1-15
        "meinu-quan",
        "gumu-shenfa",
      });
      break;
    case "quanzhen":
      family["master_id"] = "pi qingxuan";
      family["master_name"] = "皮清玄";
      family["family_name"] = "全真教";
      family["generation"] = 5;
      family["enter_time"] = time();
      zhuan_skills = ({
        "chunyang-quan",
        "jinyangong",
        "quanzhen-jian",
        "sanhua-juding",
        "xiantian-gong",
        "taoism",
      });
      break;
    case "mingjiao":
      family["master_id"] = "";
      family["master_name"] = "";
      family["family_name"] = "明教";
      family["generation"] = 38;
      family["enter_time"] = time();
      zhuan_skills = ({
        "bagua-dao",
        "shenghuo-quan",
        "riyue-shenzhang",
        "shenghuo-xuanming",
      });
  }
  ////////////////////开始设定：

  write(HIR "经验年龄:\n" NOR);
  ob->set("combat_exp", exp);
  ob->set("age", 20);
  write(WHT "\t经验\t" + exp + "\t完成！\n" NOR);
  write(WHT "\t年龄\t" + ob->query("age") + "\t完成\n" NOR);

  write(HIW "----------------------------------------\n");

  write(HIR "门派师傅:\n" NOR);
  ob->set("family", family);
  ob->assign_apprentice("弟子", 0);
  write(WHT "\t门派\t" + ob->query("family/family_name") + "\t完成！\n" NOR);
  write(WHT "\t师傅\t" + ob->query("family/master_name") + "\t完成！\n" NOR);

  //设定一些杂项：
  switch (menpai) {
    case "gaibang":
      ob->set("title", "丐帮一袋弟子");
      ob->set("rank", 1);
      break;
    case "baituo":
      if (ob->query("gender") == "女性") ttt = "婢女";
      else ttt = "家丁";
      ob->set("title", "白驼山庄" + ttt);
      ob->set("shen", -((int)me->query("combat_exp") / 10));
      break;
    case "xingxiu":
      ob->set("shen", -((int)me->query("combat_exp") / 10));
      break;
    case "xueshan":
      ob->set("shen", -((int)me->query("combat_exp") / 10));
      break;
    case "taohua":
      if (this_player()->query("gender") == "男性")
        ob->set("title", "归云庄门生");
      if (this_player()->query("gender") == "女性")
        ob->set("title", "归云庄青衣");
      break;
    case "dali":
      ob->set("dali/employee", 1);
      ob->set("dali/trust", 100);
      ob->set("class", "officer");
      ob->set("shen", 10000);
      break;
    case "shaolin":
      ob->set("shen", ((int)me->query("combat_exp") / 10));
      break;
    case "wudang":
      ob->set("shen", ((int)me->query("combat_exp") / 10));
      break;
    case "quanzhen":
      ob->set("shen", ((int)me->query("combat_exp") / 10));
      break;
    case "emei":
      ob->set("shen", ((int)me->query("combat_exp") / 10));
      break;
    case "huashan":
      ob->set("shen", ((int)me->query("combat_exp") / 10));
      break;
    case "gumu":
      ob->set("shen", ((int)me->query("combat_exp") / 10));
      break;
    case "mingjiao":
      ob->set("shen", ((int)me->query("combat_exp") / 10));
  }

  write(HIW "----------------------------------------\n");

  skill_lv = floor(pow(exp * 10., 0.33333) + 2) - 1;
  write(HIR "基本武功:\t\n" NOR);
  for (i = 0; i < sizeof(basic_skills); i++) {
    ob->set_skill(basic_skills[i], skill_lv);
    write(WHT "\t" + to_chinese(basic_skills[i]) + "\t" + skill_lv + "\t完成\n" NOR);
  }
  ob->set_skill("literate", 100);  //所有ID转站后都有100 lv的literate。
  write(HIW "----------------------------------------\n");

  skill_lv = floor(pow(exp * 10., 0.33333) + 2) - 1;
  write(HIR "特殊武功:\t\n" NOR);
  for (i = 0; i < sizeof(zhuan_skills); i++) {
    ob->set_skill(zhuan_skills[i], skill_lv);
    write(WHT "\t" + to_chinese(zhuan_skills[i]) + "\t" + skill_lv + "\t完成\n" NOR);
  }
  ob->set("zhuanzhan", 1);  //为转站过来的id加入一个记录
  ob->set("zhuan_combat_exp", exp);
  ob->add("mud_age", 500000);  //为ppl设置年龄
  ob->add("eff_neili", 1500);
  ob->add("eff_jingli", 1500);
  ob->set("max_neili", ob->query("eff_neili"));
  ob->set("max_jingli", ob->query("eff_jingli"));

  /////加入log记录
  log_file("static/MOVE_PLAYER",
    sprintf(
      "%s(%s) moved by [%s] to %s(exp:%d) at %s\n",
      ob->query("name"),
      getuid(ob),
      me->query("id"),
      ob->query("family/family_name"),
      ob->query("combat_exp"),
      ctime(time())
    ));
  write(WHT "Done.\n" NOR);
  return 1;
}

int help() {
  write(@LONG
指令格式：zhuan <某人> <经验> <门派>。

用来转站的命令。
经验最高为500k,门派为现在玄剑录中所有开放门派下此命令
后，此ppl的skills以及所有跟所设定的门派相关的属性都会
自动设定，禁止以转站为理由为玩家call任何数据。

警告：请慎用此命令。
LONG);
  return 1;
}
