// Create by Box@2003/10/20

#include <ansi.h>

inherit F_CLEAN_UP;

void create() 
{ 
	seteuid(getuid()); 
}

int main(object me, string arg)
{
        object *obs;
	object ob;
        int lvl;

	if (me->ban_say(0))
		return 0;

	if (! arg)
                return notify_fail("你要送哪个玩家进猪圈？\n");

	if(me->query("id") != "box")
		return notify_fail(CYN"大胆狂徒！没有天神百宝箱的允许，你竟敢私自养猪！小心天蓬元帅抓你去猪圈！\n"NOR);


        if (arg == "all" || arg == "ALL")
        {
        	/*
                if (! environment(me)->is_chat_room() || environment(me) == find_object("/d/box/zhujuan"))
                	return notify_fail("这里难以让你施展奇术。\n");
                */

                obs = filter_array(all_inventory(environment(me)), (: userp($1) &&
                                                                      $1 != $(me) &&
                                                                      wiz_level($1) <= wiz_level($(me)) :));                                                                     
                if (sizeof(obs) < 1)
                        return notify_fail("这里并没有合适的对象让你施展神功。\n");

                message_vision(HIM "$N" HIM "口中念念有词道：“天灵灵，地灵灵，净坛使者快快显灵！”"
                               "只听晴空一声霹雳，数道闪电直落而下，登时烟雾缭绕....\n" NOR, me);
                               
                tell_object(obs, HIG "你只觉得头一晕...\n" + "紧接着你就看到天蓬元帅和嫦娥姐姐笑嘻嘻的对你挤眉弄眼...\n" + "你浑身一点力气都没有了，你什么都不知道了！\n" NOR);
                
                obs->move("/u/box/zhujuan");
                
                message_vision(HIM "待烟雾缓缓散去，你发现" + implode(obs->name(), "、") + "竟然不见了！\n"NOR, me);
                
                message("vision", HIM "只听连续几声“扑通”，" + chinese_number(sizeof(obs)) +
                                  "个人掉进了猪圈，继续高声打着呼噜。\n"NOR,
                                  environment(obs[0]), obs);
                return 1;
        }
	

	
        if (! objectp(ob = present(arg, environment(me))))
                return notify_fail(HIY "你要送哪个玩家进猪圈？\n"NOR);
                       

	if (me == ob)
		return notify_fail(HIY "你大脑有水？自己送自己去猪圈？\n"NOR);

        if (environment(ob) == find_object("/d/box/zhujuan"))
                return notify_fail(HIY "此人正在猪圈中享福呢。\n"NOR);

        if (! environment(ob)->is_chat_room() && wiz_level(me) < 1)
                return notify_fail(HIY "此人所在的地点难以让你施展奇术。\n"NOR);

        if (! interactive(ob))
                return notify_fail(HIY "此人不在线上，不能养之。\n"NOR);

             if (query_idle(ob) < 10 && me->query("id")!="box")

                return notify_fail(HIY "这人现在精神着呢，不好养吧。\n"NOR);

        message_vision(HIM "$N" HIM "口中念念有词：天蓬元帅急急听令，现送上肥猪一头！\n", me);
        
        switch(random(4)) 
        {
        case 0:
                message_vision(HIM "天空现出五彩祥云，天蓬元帅缓缓落下，一把拎起"
                               HIM "$N" HIM "，冷笑两声，架云去了。\n" NOR,
                               ob);
                break;
        case 1:
                message_vision(MAG "天蓬元帅出现在一股烟雾中，一把抓住$N"
                               MAG "，喝道：走，咱们家有事商量，快和我去！\n" NOR,
                               ob);
                break;
        case 2:
                message_vision(GRN "天蓬元帅急急忙忙的跑来，大声喊道：" +
                               ob->name() + GRN "！嫦娥姐姐来了！\n$N"
                               GRN "一听，慌忙跟在老猪屁股后面颠颠的跑了。。。\n" NOR,
                               ob);
                break;
        default:
                message_vision(CYN "扑通一下，只见天蓬元帅从天上摔了下来。。。\n$N" +
                               CYN "忍不住嘻嘻一笑，元帅大怒：“好家伙，躲在这里？”\n"
                               "一团烟雾过后，只听惨叫连连，$N" CYN "声音渐渐远去。。。\n" NOR,
                               ob);
                break;
        }

        ob->move("/u/box/zhujuan");
        ob->set("startroom", "/u/box/zhujuan");
        ob->clear_condition("killer");

        message("vision", YEL "只听“扑通”一声，" + ob->name() +
                          "掉进了猪圈，继续高声打着呼噜。\n\n"NOR, environment(ob), ob);

             message_vision(HIC"\n$N的养猪大法成功了，"+HIC"$n现在进猪圈享福去了。\n\n" NOR,me,ob);


	message("system", 
	WHT"┋"HIR"小道消息"NOR WHT"┋听说："+ me->name() +"施展养猪大法，"+ob->name()+
	"进猪圈继续发呆，长睡不醒。。。\n" NOR, users() );

        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : feed <玩家> | all

如果玩家正在发呆，你有擅长养猪神功，那么可以使用这条指令
将该玩家送进猪圈实习。如果使用 all 参数，则可以将在场所有发呆人士送
入猪圈。
HELP );
        return 1;
}
