// /cmds/adm/spy.c.
#include <ansi.h>
inherit F_CLEAN_UP;
int main()
{
        object me,where,*list;
        int i,j,k,temp,tempp,temppp; 
        me = this_player();
        
        list=users();

//蒙面人
        tell_object(me,HIW"■ 蒙面人： \n"NOR);
        tell_object(me,"─────────────────────────────────────\n");
        i=sizeof(list);
        while(i--)
             {
             if (!wizardp(list[i])&&list[i]->query_temp("apply/name"))
                {
                temp=1;
                where = environment(list[i]);
                printf(list[i]->query("name")+"("+list[i]->query("id")+")"+"现在在"+(string)where->query("short")+
                "("+(string)file_name(where)+")"+"假装蒙面人。\n");
                }     
        }
        if(temp==0)
        {
                tell_object(me,"现在还没有人假装！\n\n");
        }
 
 //运镖
        tell_object(me,HIW"\n\n■ 运镖： \n"NOR);
        tell_object(me,"─────────────────────────────────────\n");        
        j=sizeof(list);
        while(j--)
             {
             if (!wizardp(list[j])&&list[j]->query("mission_gived"))
                {
                tempp=1;
                where = environment(list[j]);
                printf(list[j]->query("name")+"("+list[j]->query("id")+")"+"已经运了"+chinese_number(list[j]->query("运镖成功"))+"次镖。"
                                        "连续运镖成功的次数是"HIW+chinese_number(list[j]->query("运镖连续成功"))+NOR"次\n");
                printf(list[j]->query("name")+"("+list[j]->query("id")+")"+"现在在"+(string)where->query("short")+
                "("+(string)file_name(where)+")"+"\n");
                if(list[j]->query("start_point"))
                {
                printf(list[j]->query("name")+"("+list[j]->query("id")+")"+"现在的运镖路线："HIR+list[j]->query("start_point")+
                "→"+list[j]->query("end_point")+"\n\n"NOR);
                }
                else
                {
                printf(list[j]->query("name")+"("+list[j]->query("id")+")"+"现在的运镖路线："HIR+list[j]->query_temp("start_point")+
                "→"+list[j]->query("end_point")+"\n\n"NOR);
                }
                }
             }        
        if(tempp==0)
        {
                tell_object(me,"现在还没有人在运镖！\n\n");
        }

//通缉
        tell_object(me,HIW"\n\n■ 通缉犯： \n"NOR);
        tell_object(me,"─────────────────────────────────────\n");

                 k=sizeof(list);
                  while(k--)
                        {
                                if (/*!wizardp(list[i])&&*/list[k]->query("wanted")&&list[k]->query("class")!="officer")                             {
                                        temppp=1;
                                        printf(list[k]->query("name")+"("+list[k]->query("id")+")"+"在被通缉中,悬赏"+chinese_number(list[k]->query("combat_exp")/60+list[k]->query("wanted/exp"))+"点经验和若干潜能、金钱。 \n");
                 //                if(list[i]->query("wanted/exp")>=500000)          
                 //                          CHANNEL_D->do_channel(this_object(), "rumor",
                 //                sprintf("%s正在被悬赏500000经验取其首级。", list[i]->name(1)),
                 //                sprintf("%s正在被悬赏500000经验取其首级。", list[i]->name(1)),
                                 
                 //               );
                                }
                        }
    
        if(temppp==0)
        {
                tell_object(me,"现在还没有人被通缉！\n");
                return 1;
        }

        tell_object(me,"\n\n─────────────────────────────────────\n\n\n");    
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : spy
 
这个指令可以让你查看在线有那位玩家假装蒙面人、运镖和通缉犯.
 
HELP
    );
    return 1;
}
