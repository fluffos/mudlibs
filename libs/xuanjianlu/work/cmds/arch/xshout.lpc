//Cracked by box
//shout.c
#include <ansi.h>
inherit F_CLEAN_UP;
int help(object me);
#define SHOUT_LIST	({ })
int main(object me, string arg)
{
	object obj;
	string target, msg;
	if (!wizardp(me) && member_array(me->query("id"), SHOUT_LIST) == -1 && wizhood(me)!="(admin)")
		return notify_fail("目前暂不开放 xshout。\n");
	if (!arg)
		return help(me);
		
	if(sscanf(arg, "(%s) %s", target, msg)==2) 
	{
		
		obj = find_player(target);
		if(!obj)
			return notify_fail(HIW"没有这个人....。\n"NOR);
		message("system", 
		WHT"┋"HIR"千里传音"NOR HIW"┋"+ me->name() +"对"+obj->name()+"纵声长啸：" + msg + "\n" NOR, 
		({obj,me}) );		
		return 1;
	}
	message("system", 
	WHT"┋"HIR"千里传音"NOR HIW"┋"+ me->name() +"纵声长啸：" + arg + "\n" NOR, 
	users() );		
	return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : xshout <讯息>
 	   xshout <PlayerID> <讯息>	
这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话。
HELP
    );
    return 1;
}
 
