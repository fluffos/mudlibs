#include "/doc/help.h"
#include <ansi.h>

inherit F_CLEAN_UP;
// inherit F_CMD

int main(object me, string arg) {
  object ob;

  /*
        if( me->query("id") != "box")
                     return notify_fail(MAG"你没有权利使用这个指令！\n"NOR);
*/

  if (me != this_player(1))
    return 0;

  seteuid(getuid(me));

  if (!arg)
    return notify_fail("指令格式: hunmi <living>\n");

  ob = present(arg, environment(me));

  if (!ob)
    return notify_fail("找不到这个生物。\n");


  if (ob->query("id") == "box")
    return notify_fail(HIC "大胆狂徒！你敢对最伟大的天神" + ob->name() + "无礼。\n" NOR);


  if (wiz_level(me) < wiz_level(ob))
    return notify_fail("你没有这种权力。\n");

  message_vision(HIG "天空中一道神光倏然而下罩住了$n，$n应声摔倒在地上！！\n" NOR, me, ob);
  ob->unconcious();
  return 1;
}

int help(object me) {
  write(@HELP

指令格式: hunmi <id>
 
使某人立刻昏迷不醒

HELP
  );
  return 1;
}
