// giveall.c
//BY cnnetgame.com's WFoxd 2000-9-15
/*请不要连续使用本命令，特别是在人多的时候，会给系统带来很大负担*/

inherit F_CLEAN_UP;
#include <ansi.h>

private int help(object me);

int main(object me, string what) {
  object ob, *ob_list, ob1;
  object present;

  int i, j;
  string str, id, instr;

  //message_vision(what + "\n",me);

  if (!what)
    return help(me);

  if (sscanf(what, "%s %s", id, str) == 2) {
    ob = LOGIN_D->find_body(id);

    if (!ob) ob = find_object(id);

    if (!ob) return notify_fail(HIG "咦... 有这个人吗?\n" NOR);

    //message_vision(str + "\n",me);

    if (sscanf(str, "%s %s", id, instr) == 2)
      return notify_fail(HIG "命令格式：giveall <id> <物品路径>\n" NOR);

    if (file_size(str) < 0)
      return notify_fail("没有这个档案(" + str + ")。\n");

    ob1 = new(str);

    ob1->move(ob);

    //message_vision

    tell_object(ob, HIM + "" + me->name() + "手舞足蹈口中念念有词道：“我变！我变！我变变变！”\n"
      "只听晴空几声霹雳，一" + ob1->query("unit") + HIR "" + ob1->name() + HIM "缓缓落入你的怀里。\n" NOR);
    message_vision(HIG "" + ob1->name() + "成功发送给" + ob->name() + "！\n" NOR, me);
    return 1;
  }

  else {
    if (file_size(what) < 0)
      return notify_fail("没有这个档案(" + what + ")。\n");

    present = load_object(what);

    if (!present)
      return notify_fail("没有" + what + "这个东西。\n");

    seteuid(getuid());

    ob_list = users();

    for (i = 0; i < sizeof(ob_list); i++) {
      ob = ob_list[i];
      if (wizardp(ob)) {
        j++;
        continue;
      }
      ob1 = new(what);
      ob1->move(ob);
      tell_object(ob, HIG "天上突然掉下了什么东西到你的口袋里，你最好检查一下。\n" NOR);
      tell_object(ob, HIG "好像是" + (string)me->name() + "发礼物了！\n" NOR);
    }
    str = sprintf("共有 %d 位玩家得到了%s。\n", sizeof(ob_list) - j, what->query("name"));
    me->start_more(str);
    return 1;
  }
}

int help(object me) {
  write(@HELP
指令格式：giveall 物品路径

命令格式：giveall <id> <物品路径>

给在线的所有玩家一件物品。

HELP
  );
  return 1;
}
