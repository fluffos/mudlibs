// CMDS /cmds/arch/wakeup.c
// Update by box@2001/05/02

#include "/doc/help.h"
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me,string arg)
{
	object ob;
        if (!arg) return notify_fail ("usage:wakeup <id>\n");
        
        ob = LOGIN_D->find_body(arg);
        if (!ob) ob=find_object(arg);
        if (!ob)
                
                ob = present(arg, environment(me));
        if(!ob) return notify_fail(HIG"咦... 有这个人吗?\n"NOR);
        ob->remove_call_out("revive");
        ob->revive();
        ob->reincarnate();
        write(HIG "" + (string)me->name()+"哈哈大笑几声说道：“睡醒了吧”\n"NOR);
        message_vision(HIG "" + ob->name() + "此时已经醒过来了！\n"NOR,me);
        return 1;
}

int help()
{
       write( @TEXT

指令格式：wakeup <Id>
使某人苏醒

TEXT
       );
       return 1 ;
}

