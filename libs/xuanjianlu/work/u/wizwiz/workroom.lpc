#include <ansi.h>

inherit ROOM;
void yyy(string arg);
string file;

void create() {

  set("short", "无名居");
  set("long", @LONG
	    这是一间简陋的居室。北面是一扇小窗，窗外青山绿水，鸟语花香。
	室内摆设简朴随意，一桌、一椅、一床。一个小书童站在窗边向外看着什么。
LONG
  );


  set("valid_startroom", 1);
  set("exits", ([
    "kl": "/d/kunlun/guangchang74", "sl": "/d/shaolin/smdian", "sn": "/d/shenlong/tingkou", "xi": "/d/xixia/dawu", "hz": "/d/hangzhou/kedian", "wds": "/d/wudang/sanqingdian", "xx": "/d/xingxiu/xxh2", "gb": "/d/gaibang/undertre", "gy": "/d/taihu/qianyuan", "hs": "/d/huashan/buwei1", "bt": "/d/xingxiu/btyard", "dl": "/d/dali/wangfu1", "em": "/d/emei/hz_guangchang", "xs": "/d/xueshan/guangchang", "yz": "/d/city/kedian", "qz": "/d/quanzhou/zhongxin", "hs": "/d/huashan/buwei1", "bt": "/d/xingxiu/btyard", "dl": "/d/dali/wangfu1", "em": "/d/emei/hz_guangchang", "xs": "/d/xueshan/guangchang", "wr": "/d/wizard/wizard_room", "mz": "/d/taishan/fengchan", "lj": "/d/lingjiu/damen",
  ]));

  setup();

}

void init() {
  if (this_player()->query("id") == "wizwiz") {
    this_player()->set("title", HIR "斩贪官 诛奸邪" NOR);
    this_player()->set("nickname", HIW "法定乾坤" NOR);
    this_player()->set("name", "包拯");
  }
  add_action("do_yao", "yao");
  add_action("do_song", "song");
  add_action("do_sheding", "sheding");

}


int do_yao(string arg) {
  object me, miji;
  me = this_player();
  if (this_player()->query("id") != "wizwiz") return notify_fail("书童拦在你面前道：这不你的家你怎么能随便拿东西呢？！\n");
  if (!arg) return notify_fail(CYN "书童一脸不解问道：您要什么东西？\n" NOR);
  miji = load_object(arg);
  if (!miji) return notify_fail("书童一脸委屈：没有" + arg + "这个东西，我拿什么给您。\n");
  miji = new(arg);
  miji->move(me);
  return notify_fail("书童走过来给了你一个" + miji->query("name") + "。\n");

}


int do_song() {
  object who = this_player();
  object present;
  if (this_player()->query("id") != "wizwiz")
    return notify_fail("书童拦在你面前道：这不你的家你怎么能随便拿主人的东西送人呢？！\n");
  if (!file) return notify_fail("书童道：请问要送啥？\n");

  present = load_object(file);
  if (!present) return notify_fail("书童一脸委屈：没有" + file + "这个东西，我拿什么送人。\n");

  write(present->query("name") + "(" + present->query("id") + ")给每个人，确定吗？[Y/N]\n");
  input_to((: yyy :));
  return 1;
}

void yyy(string arg) {
  object *allp = users();
  object present;
  int i;

  log_file("present", sprintf("%s  本次礼物%s，舒畅%s\n", ctime(time()), file
    , this_player()->query("id")));
  if (arg == "y" || arg == "Y") {
    for (i = 0; i < sizeof(allp); i++) {
      present = new(file);
      present->move(allp[i]);
      tell_object(allp[i], HIY "巫师发礼品喽！天上掉下个" NOR + present->query("name")
        +HIY "落在你手中。\n" NOR);
      log_file("present", sprintf("%s(%s)get it.\n", allp[i]->query("name")
        , allp[i]->query("id")));
    }

  } else write("取消。\n");
}

int do_sheding(string arg) {
  object who = this_player();
  object present;
  if (this_player()->query("id") != "wizwiz")
    return notify_fail("这不你的家你怎么能随便拿主人的东西送人呢？！\n");

  if (!arg) return notify_fail("书童道：请问要送啥？\n");

  present = load_object(arg);
  if (!present) return notify_fail("书童一脸委屈：没有" + arg + "这个东西，我拿什么送人。\n");

  file = arg;
  write("ok\n");
  return 1;
}
