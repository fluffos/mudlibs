//Cracked by box

#include <ansi.h>

inherit ITEM;
inherit F_UNIQUE;

int do_canwu(string arg);

void create()
{
    set_name(YEL "九阳神功" NOR, ({"jiuyang book", "book"}));
    if (clonep())
        set_default_object(__FILE__);
    else 
    {
        set("unit", "部");
	set("long", YEL"一本厚约半寸的册子，册子面上用篆文书着《九阳真经》，里面记载了上乘的内功心法。\n"NOR);
        set("material", "paper");
        set("value", 1000000000);
        set("skill", ([
                        "name": "jiuyang-shengong",        // name of the skill
                        "exp_required": 2000000,      // minimum combat experience required
                        "jing_cost":    300,     // jing cost every time study this
                        "difficulty":   100,     // the base int to learn this skill
                        "max_skill":    800      // the maximum level you can learn
                ]) );
        set("no_drop","这样东西不能离开你。\n");
        set("no_get","这样东西不能离开你。\n");
        set("no_steal", 1);
	set("no_sell", 1);
	::create();
              
    }
}

void init()
{
		  add_action("do_canwu", "canwu");
		  add_action("do_canwu", "study");
}

int do_canwu(string arg)
{
	object me = this_player();
	object where = environment(me);
	int jing_cost, times, jingli_cost;
	int i=me->query_skill("jiuyang-shengong",1);
	string skillarg=arg;

	if(sscanf(arg, "%s %d", arg, times)!=2 ) 
		arg=skillarg;
		
	if(!times || times == 0) 
		times = 1;	
	
	if (!(arg=="jiuyang miji" || arg=="jiuyang" || arg=="miji" || arg=="shengong"
		|| arg=="jiuyang shengong"))
		return 0;
		
	skillarg="jiuyang-shengong";		

	if (where->query("pigging")) {
		write("你还是专心拱猪吧！\n");
      		return 1; }
      	
    	if ( base_name(environment(me)) == "/d/bwdh/sjsz/" )
    		return notify_fail("你不可以在试剑山庄里参悟。\n");      	

	if (me->is_busy()) {
		write("你现在正忙着呢。\n");
		return 1; }

	if (me->is_fighting() ) {
		write("你无法在战斗中专心下来研读新知！\n");
		return 1; }

	if (!id("jiuyang book")) {	
		write("你要读什么？\n");
		return 1; }

	if (!me->query_temp("got_jiuyang")) {
		write("你搅尽脑汁也看不明白这本《九阳真经》。\n");
		return 1; }


	if (!me->query_skill("literate", 1) ) {
		write("你是个文盲，先学点文化(literate)吧。\n");
		return 1; }


	if (me->query("gender") == "无性") {
		write("嘿嘿，您学不了九阳神功啦。\n");
		return 1; }
	
	if ((int)me->query_skill("force", 1) < 30
		|| (int)me->query_skill("force", 1)< (i-30)) {
		write("你的基本内功火候不足，无法学习九阳神功。\n");
		return 1; }

	if ((int)me->query_skill("literate", 1) < (i-30)) {
		write("你的读书写字水平不够，没法领会《九阳真经》了。\n");
		return 1; }

	if (me->query("jing") < 600) {
		write("你现在过于疲倦，无法专心下来研读《九阳真经》。\n");
		return 1; }

	if ((int)me->query("combat_exp") < (int)i*i*i/10 ) {
		write("你的实战经验不足，九阳神功无法再提高了。\n");
		return 1; }

	if (me->query_int()<60) {
		write("你读了半天《九阳真经》，可总也领悟不了那神功精妙所在。\n");
		return 1; }
		
	if (me->query_skill("jiuyang-shengong", 1) > 800) {
		write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
		return 1; }
			
	jing_cost = (me->query_skill("jiuyang-shengong", 1)-me->query_skill("literate",1)/100*me->query_int())*times;
	jingli_cost = (me->query_skill("jiuyang-shengong", 1)-me->query_skill("literate",1)/100*me->query_int())*times;
	
	
	if ( me->query("jing") < jing_cost ) 
		return notify_fail("你现在精神不佳，无法定心领悟那么多次！\n");
		
	if ( me->query("jingli") < jingli_cost ) 
		return notify_fail("你现在精力不佳，无法定心领悟那么多次！\n");		

	if( (int)me->query("potential") <= 1 )
		return notify_fail("你的潜能不足，无法参悟九阳神功！\n");
		
	if( (int)me->query("potential") < 2*times)
		return notify_fail("你的潜能不够参悟这么多次！\n"); 

	message("vision", me->name() + "翻开《九阳真经》仔细的参悟了一会儿。\n", environment(me), me);


	if(random(20) == 0) {
		me->add("potential", -2*(random(times))-2);
		me->improve_skill(skillarg, (i + me->query_skill("literate", 1)/2 + random(i*2))*times);
		write( "《九阳真经》果然精妙，你只觉脑中豁然开朗，对" + to_chinese(skillarg) + "的领悟又进了一层！\n" );
	}
	else if(random(10) == 0) {
		me->add("potential", -1*(random(times))-1);
		me->improve_skill(skillarg, (i/2 + me->query_skill("literate", 1)/3 + random(i/10))*times);
		write( "你细观《九阳真经》，冥思苦想，对" + to_chinese(skillarg) + "渐渐加深一层体会！\n" );
	}
	else if(random(5) == 0) {
		me->add("potential", -random(times));
		me->improve_skill(skillarg, (i/4 + me->query_skill("literate", 1)/4 + random(i/2))*times);
		write( "你对照《九阳真经》，拿手比划着，似乎对" + to_chinese(skillarg) + "中的几个招数有所体会。\n" );
	}
	else if(random(2) == 0) {
		me->improve_skill(skillarg, (i/8 + me->query_skill("literate", 1)/6 + random(i/4))*times);
		write( "你坐立不安，潜心苦思" + to_chinese(skillarg) + "上的难解之处。\n" );
	}
	else if(random(5) == 0) {
		write( "你心中说不出的烦燥，对" + to_chinese(skillarg) + "始终不得一解。\n" );
	}
	else if(random(10) == 0) {
		me->improve_skill(skillarg, - (i/10 + random(i/5))*random(times));
		write( "你只觉得体内真气乱窜，" + to_chinese(skillarg) + "中的招式象走马灯一般在面前显现！\n" );
	}
	else if(random(20) == 0) {
		me->improve_skill(skillarg, - (i/6 + random(i/3))*random(times));
		write( "你的大脑中一片空白。对" + to_chinese(skillarg) + "是越想越糊涂。\n" );
	}
	else {
		write( "你坐立不安，潜心苦思" + to_chinese(skillarg) + "上的难解之处。\n" );
	}

	me->receive_damage("jing", jing_cost);
	me->receive_damage("jingli", jingli_cost);	
	write("你研读《九阳真经》有所进步。\n");
	return 1; 
}

