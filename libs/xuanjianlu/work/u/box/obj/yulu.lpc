// qiyun-yulu.c 七云雨露(比武大会指定冠军饮品)
// Xoxo, Nov. 2002

#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_yulu", "yulu");
  add_action("do_look", "look");
}

void create() {
  set_name("七云雨露", ({ "qiyun yulu", "yulu", "gift" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "瓶");
    set("long",
      "这是一瓶由侠客行巫师工会精心调制的七云雨露，小巧的玉瓶口边挂着一张小纸条(note)。\n");
    set("value", 1000000000);
  }
  set_color(HIW);

  setup();
}

int do_look(string arg) {
  object me = this_player();

  if (!arg || arg != "note")
    return 0;


  tell_object(me, HIW "这是一张七云雨露的使用说明书。\n" NOR

    CYN "上面写着：请自由选择雨露的开法，每瓶雨露只够喝一次。\n" NOR
    "１. 增加两万点经验值。      (键入 " WHT "yulu 1" NOR ")\n"

    "２. 增加五千点潜能。        (键入 " WHT "yulu 2" NOR ")\n"

    "３. 增加１００点最大精力值。(键入 " WHT "yulu 3" NOR ")\n"

    "４. 增加１００点最大内力值。(键入 " WHT "yulu 4" NOR ")\n"

    "５. 增加三次有效死亡。      (键入 " WHT "yulu 5" NOR ")\n"

    "６. 增加所有武功半级。      (键入 " WHT "yulu 6" NOR ")\n"

    "特殊. 增加单项武功两级。(例：键入 " WHT "yulu " HIY "literate" NOR ")\n\n"

    HIG "注：增加的潜能必须在离开游戏前使用完毕！玩家的档案必须要能\n"
    "    
支持得到的奖励。如果不支持而损失将不补发！\n" NOR);
  return 1;
}

int do_yulu(string arg) {
  mapping skill_status;
  string *sname;
  int i, point, count, new_shen, new_exp, new_pot;
  object me = this_player();
  object ob = this_object();

  if (arg == "1" || arg == "2" || arg == "3" ||
    arg == "4" || arg == "5" || arg == "6") {

    switch (arg) {
      case "1":
        message_vision(HIW
          "$N小心翼翼的把一瓶七云雨露打开，雨露突然汽化，换化成一朵白云围绕在$N的身边，\n过了许久，才慢慢消散，无影无踪。\n"
          NOR, me);
        log_file("BWDH-Reward",
          sprintf("%s(%s)於%s打开了(%s)复制的七云雨露，增加两万点经验值。\n",
            me->query("name"), getuid(me), ctime(time()), ob->query("cloner")));
        me->add("combat_exp", 20000);
        me->add("award/yulu1", 1);
        break;
      case "2":
        message_vision(MAG
          "$N小心翼翼的把一瓶七云雨露打开，雨露突然汽化，换化成一朵紫云围绕在$N的身边，\n过了许久，才慢慢消散，无影无踪。\n"
          NOR, me);
        log_file("BWDH-Reward",
          sprintf("%s(%s)於%s打开了(%s)复制的七云雨露，增加五千点潜能。\n",
            me->query("name"), getuid(me), ctime(time()), ob->query("cloner")));
        me->add("potential", 5000);
        me->add("award/yulu2", 1);
        break;
      case "3":
        message_vision(HIR
          "$N小心翼翼的把一瓶七云雨露打开，雨露突然汽化，换化成一朵红云围绕在$N的身边，\n过了许久，才慢慢消散，无影无踪。\n"
          NOR, me);
        log_file("BWDH-Reward",
          sprintf("%s(%s)於%s打开了(%s)复制的七云雨露，增加一百点最大精力值。\n",
            me->query("name"), getuid(me), ctime(time()), ob->query("cloner")));
        me->add("max_jingli", 100);
        me->add("eff_jingli", 100);
        me->add("award/yulu3", 1);
        break;
      case "4":
        message_vision(HIG
          "$N小心翼翼的把一瓶七云雨露打开，雨露突然汽化，换化成一朵绿云围绕在$N的身边，\n过了许久，才慢慢消散，无影无踪。\n"
          NOR, me);
        log_file("BWDH-Reward",
          sprintf("%s(%s)於%s打开了(%s)复制的七云雨露，增加一百点最大内力值。\n",
            me->query("name"), getuid(me), ctime(time()), ob->query("cloner")));
        me->add("max_neili", 100);
        me->add("award/yulu4", 1);
        break;
      case "5":
        message_vision(HIB
          "$N小心翼翼的把一瓶七云雨露打开，雨露突然汽化，换化成一朵蓝云围绕在$N的身边，\n过了许久，才慢慢消散，无影无踪。\n"
          NOR, me);
        log_file("BWDH-Reward",
          sprintf("%s(%s)於%s打开了(%s)复制的七云雨露，增加三次有效死亡。\n",
            me->query("name"), getuid(me), ctime(time()), ob->query("cloner")));
        me->add("death_times", 3);
        me->add("award/yulu5", 1);
        if ((int)me->query("death_times") >
          (int)me->query("death_count"))
          me->set("death_count",
            (int)me->query("death_times"));
        break;
      case "6":
        message_vision(HIC
          "$N小心翼翼的把一瓶七云雨露打开，雨露突然汽化，换化成一朵青云围绕在$N的身边，\n过了许久，才慢慢消散，无影无踪。\n"
          NOR, me);
        log_file("BWDH-Reward",
          sprintf("%s(%s)於%s打开了(%s)复制的七云雨露，所有技能增加1/2等级。\n",
            me->query("name"), getuid(me), ctime(time()), ob->query("cloner")));
        if (mapp(skill_status = me->query_skills())) {
          skill_status = me->query_skills();
          sname = keys(skill_status);
          count = sizeof(skill_status);

          for (i = 0; i < sizeof(skill_status); i++) {
            point = (skill_status[sname[i]] + 1) * (skill_status[sname[i]] + 1) / 2 + 1;
            me->improve_skill(sname[i], point + 1);
          }
        }
        me->add("award/yulu6", 1);
        break;
    }
    destruct(ob);
    return 1;
  } else {
    if (me->query_skill(arg, 1)) {
      message_vision(HIY
        "$N小心翼翼的把一瓶七云雨露打开，雨露突然汽化，换化成一朵金云围绕在$N的身边，\n过了许久，才慢慢消散，无影无踪。\n"
        NOR, me);
      log_file("BWDH-Reward",
        sprintf("%s(%s)於%s打开了(%s)复制的七云雨露，增加两级%s。\n",
          me->query("name"), getuid(me), ctime(time()), ob->query("cloner"), arg));
      me->set_skill(arg, (me->query_skill(arg, 1) + 2));
      me->add("award/yuluSP", 1);
      destruct(ob);
      return 1;
    } else
      return notify_fail("你只能提高目前拥有的技能。\n");
  }
}



