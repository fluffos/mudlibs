//Cracked by box
// jinjing-shou 碧水金睛兽

#include <ansi.h>

inherit NPC_TRAINEE;

void create() {
  set_name("碧水金睛兽", ({ "jinjing shou", "shou", "beast" }));
  set_weight(6000000);
  set("race", "野兽");
  set("age", 1000);
  set("long", "它是此处的守潭神兽，据传是当年百宝箱的坐骑，力大无穷，乃是千年一现的洪荒异兽。\n" +
    "尤其是它头上那一枝金光闪闪的兽角，据传割下制炼后能让佩戴者寒毒不侵，洪波辟易。\n");
  set("msg_fail", "$n冲着$N怒吼一声，随时准备猛扑过来");
  set("msg_succ", "$n鼻孔中喷着粗气，脑袋不停地摇晃着奔来奔去");
  set("msg_trained", "$n低啸一声，伸开前爪在$N的面前伏了下来");
  set("auto_follow", 1);
  set("attitude", "peaceful");

  set("wildness", 50);

  set("combat_exp", 1000000);
  set("shen_type", 0);
  set("env/wimpy", 50);

  set("str", 100);
  set("int", 100);
  set("con", 100);
  set("dex", 100);

  set("max_jing", 4000);
  set("max_qi", 8000);
  set("max_neili", 10000);
  set("neili", 10000);
  set("jiali", 400);

  set("chat_chance", 5);

  set("chat_msg", ({
    (: this_object(), "random_move" :),
  }));

  set("unicorn", 1);

  set_temp("apply/attack", 500);
  set_temp("apply/damage", 500);
  set_temp("apply/dodge", 500);
  set_temp("apply/armor", 500);

  setup();
}

void init() {
  //::init();
  /*
        if( this_object()->query_lord() != this_player() ) 
        {
                this_object()->kill_ob(this_player());
                this_object()->set_leader(this_player());
        }
        else 
        {
        }
        */

  object me, who;
  me = this_player();
  who = this_object();
  if (me->query("id") == "box") {
    who->set_lord(me);
    who->set("host_id", me->query("id"));
  }
  if (interactive(me)) {
    if (me->query("id") == who->query_temp("kill_name")) {
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, me);
    }
  }
  add_action("do_qie", "qie");
  add_action("do_qie", "ge");
  add_action("do_ride", "ride");
  add_action("do_ride", "qi");
  add_action("do_unride", "unride");
  add_action("do_unride", "xia");
  add_action("do_attack", "attack");
  add_action("do_stop", "stop");
  add_action("do_sha", "sha");
  add_action("do_guard", "baohu");
  add_action("do_hit", "da");
}


