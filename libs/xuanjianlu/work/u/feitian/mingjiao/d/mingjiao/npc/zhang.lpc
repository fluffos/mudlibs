//Cracked by Roath

inherit NPC;
inherit F_MASTER;


#include <ansi.h>
int auto_perform();

void create()
{
        set_name("张无忌", ({ "zhang wuji", "zhang" }));
        set("long",
                "张无忌。\n"
                "张无忌，\n"
                                "张无忌。\n");
        set("gender", "男性");
        set("age", 24);
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 14123);
        set("max_jing", 3173);
                set("eff_jingli", 9000);
                set("max_jingli", 9000);
        set("neili", 12000);
        set("max_neili", 12000);
        set("jiali", 0);
        set("combat_exp", 6400000);
        set("score", 640000);

        set_skill("force", 400);
        set_skill("shenghuo-xuanming", 400);
        set_skill("dodge", 400);
        set_skill("qiankun-danuoyi", 400);
        set_skill("cuff", 400);
        set_skill("shenghuo-quan", 400);
        set_skill("parry", 400);
        set_skill("sword", 400);
        set_skill("blade", 400);
        set_skill("pike", 400);
        set_skill("strike", 400);
        set_skill("riyue-shenzhang", 400);
        set_skill("shenghuo-ling", 400);
        set_skill("guangming-xinfa", 400);
        set_skill("literate", 400);

        map_skill("force", "shenghuo-xuanming");
        map_skill("dodge", "qiankun-danuoyi");
        map_skill("cuff", "shenghuo-quan");
        map_skill("parry", "qiankun-danuoyi");
        map_skill("sword", "shenghuo-ling");
        map_skill("strike", "riyue-shenzhang");

        prepare_skill("cuff", "shenghuo-quan");
                prepare_skill("strike", "riyue-shenzhang");
        
        create_family("明教", 33, "教主");

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: auto_perform :),
        }) );

        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/armor/cloth")->wear();
}

int auto_perform()
{
        object me=this_object();
        object weapon=me->query_temp("weapon");
        object opp=me->select_opponent();

        if( me->query("qi",1) < 0 || me->query("jing",1) < 0 || me->query("jingli",1) < 0) return 1;

        if ( !me->is_fighting() ) {
                                         if ( me->query("eff_qi") < me->query("max_qi") )
                                                                me->exert_function("heal");
                                         me->set("jiali", 50);

                                         return 1;
                  }
                  if ( objectp(weapon) ) {
                                if( !opp->query_temp("bosi/yinfeng") )
                                                return perform_action("sword.yinfeng");
                                                else return perform_action("sword.tougu");
                  }
}