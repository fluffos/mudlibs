void init()
{
        object me = this_player();
        tell_room( environment(me), CYN"旺财说道：欢迎" + me->query("title") + " "
                + me->query("name") + "(" + me->query("id") + ")" + " 来到"HIG"楚灵熙"NOR"的工作室！！！\n"NOR);

}
int valid_leave(object me, string dir)
{
              if(me->query("id")=="clx")
                return ::valid_leave(me, dir);
