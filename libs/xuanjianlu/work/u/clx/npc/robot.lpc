//npc 42jing工作用npc
inherit NPC;
#include <ansi.h>
#include "/d/REGIONS.h";


void create() {
  set_name("机器人", ({ "robot", "npc" }));
  set_color("$HIW$");
  set("title", HIR "神龙教任务机器人不要杀" NOR);
  set("gender", "男性");
  set("age", 500);
  set("long", "浑身发出银光，是高科技的产物，内置奔腾５-２G CPU 内存１０G。\n");

  set("combat_exp", 1);
  set("shen_type", 0);

  set("attitude", "heroism");

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);

  setup();
  carry_object("/clone/misc/cloth")->wear();
}


void init() {
  remove_call_out("jing");
  call_out("jing", random(10) + 600);
}


void jing() {


  string *npc_room = ({
    //华山
    "/d/huashan/xianrenqiao",
    "/d/huashan/wushangdong",
    "/d/huashan/sheshen",
    "/d/huashan/huayuan",
    "/d/huashan/zoulang4",
    "/d/huashan/pianting2",
    "/d/huashan/fengding",
    "/d/huashan/canglong",
    //峨嵋
    "/d/emei/wannian",
    "/d/emei/pan12",
    "/d/emei/zhongfeng",
    "/d/emei/qianfo1",
    "/d/emei/xixiang",
    "/d/emei/lenshan2",
    "/d/emei/huazang",
    "/d/emei/duguang2",
    //武当
    "/d/wudang/sanqingdian",
    "/d/wudang/guangchang",
    "/d/wudang/shiliang",
    "/d/wudang/wuyaling",
    "/d/wudang/jindian",
    "/d/wudang/xiaolu2",
    "/d/wudang/wdroad2",
    "/d/wudang/wdroad3",
    //少林
    "/d/shaolin/ruzhou",
    "/d/shaolin/shijie3",
    "/d/shaolin/shijie11",
    "/d/shaolin/guangchang4",
    "/d/shaolin/qfdian",
    "/d/shaolin/dmyuan2",
    "/d/shaolin/zoulang2",
    "/d/shaolin/zhulin6",
    //扬州
    "/d/city/jujinge",
    "/d/city/guangchang",
    "/d/city/minwu2",
    //西域
    "/d/xingxiu/xxh2",
    "/d/xingxiu/tianroad3",
    "/d/xingxiu/shanjiao",
    "/d/xingxiu/shankou",
    "/d/xingxiu/silk1",
    //祁连山
    "/d/qilian/tanglang",
    "/d/qilian/mazong",
    "/d/qilian/prairie",
    //雪山
    "/d/xueshan/shanlu4",
    "/d/xueshan/xshan",
    //杭州
    "/d/hangzhou/road62",
    "/d/hangzhou/road77",
    //泉州
    "/d/quanzhou/yaopu",
    "/d/quanzhou/houzhu",
    "/d/quanzhou/dongta",
    "/d/quanzhou/gangkou1",
    "/d/quanzhou/zhongxin",
    //佛山
    "/d/foshan/dlroad3",


  });

  string region;
  object npc, room;
  npc = new("/d/shenlong/npc/xiaotaijian");
  room = load_object(npc_room[random(sizeof(npc_room))]);
  if (strsrch(file_name(room), "/d/") != 0
    || undefinedp(region = region_names[explode(file_name(room), "/")[1]]))
    region = "";

  command("sys 『神龙教《四十二章经》任务开始分配NPC所在地点』");
  command("sys 『下一次将在９分５９秒后启动』");
  command("wiz 『神龙教《四十二章经》任务开始分配NPC所在地点』");
  command("wiz 『下一次将在９分５９秒后启动』");

  command("rumor 听说皇帝派遣的小太监出现在" + region + "的" + room->query("short") + "一带。");
  npc->move(room);
  message("vision", npc->query("name") + "快步走了过来。\n", room, npc);
  npc->random_move();
  remove_call_out("jing");
  call_out("jing", random(10) + 600);


}
