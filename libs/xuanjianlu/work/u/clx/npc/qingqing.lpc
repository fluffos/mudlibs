inherit NPC;

#include <ansi.h>
int give_yan();


int create() {
  set_name(HIM "青青" NOR, ({ "qing qing", "qing", "lover" }));
  set("long", "一位貌美如花的小姑娘。她是楚灵熙的女佣人\n");

  set("gender", "女性");
  set("attitude", "peaceful");
  set("class", "bonze");
  set("age", 15);
  set("str", 20);
  set("int", 30);
  set("per", 40);
  set("con", 20);
  set("max_neili", 400);
  set("max_jingli", 400);
  set("max_qi", 300);
  set("combat_exp", 50000);



  set("chat_chance", 5);
  set("chat_msg", ({
    "青青叹道：主人回来了，工作辛苦吧?\n",
    "青青叹道：主人，你要多听听你妈的话呀，别在惹她生气了，知道吗！\n",
    "青青叹道：以后少抽点烟，对你的身体不好！\n",
    "青青叹道：旺财最乖了，我最喜欢狗狗了!\n",

  }));
  set("inquiry", ([
    "香烟": (: give_yan :),




  ]));

  set_skill("force", 50);
  set_skill("strike", 50);
  set_skill("dodge", 79);
  set_skill("parry", 79);
  set_skill("cuff", 50);
  set_skill("literate", 50);
  set_skill("meinu-quan", 79);
  set_skill("jinyangong", 50);
  setup();
  add_money("silver", 5);
  carry_object("/u/clx/obj/cloth")->wear();
  carry_object("/u/clx/obj/yan");
  set("yan", 20);
  setup();
}
int give_yan() {
  object who = this_player();
  object dou;

  if (query("yan") <= 0) {
    command("say 不给了，不给了，你们把烟都抽光了，我怎么跟主人交待呀！");
    return 1;
  }

  dou = new("/u/clx/obj/yan");
  add("yan", -1);
  message_vision(HIM "青青" NOR "给$N一支$n。\n", who, dou);
  dou->move(who);
  return 1;
}
