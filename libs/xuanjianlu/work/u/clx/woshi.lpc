// Room: /u/clx/woshi.c
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIR "楚灵熙" NOR + HIC "高级卧房" NOR);
  set("long", @LONG

这里是楚灵熙的高级卧房，这里的装饰比五星级酒店的总统套房，还要舒适。
房子的中间摆着一张舒适的大床(bed)，旁边还站着一位美丽的女佣人，伺候
楚灵熙的起居生活
LONG);
  set("item_desc", ([ "bed": "睡觉用的大床(bed)。 \n", ]));
  set("outdoors", 0);
  set("chat_room", 1);
  set("no_time", 1);
  set("sleep_room", 1);
  set("if_bed", 1);
  set("no_time", 1);
  set("freeze", 1);
  set("no_fight", 1);
  set("chat_room", 1);
  set("no_magic", 1);
  set("no_upgrade_age", 1);
  set("resource", ([ /* sizeof() == 1 */
    "water": 1,
  ]));
  set("valid_startroom", 1);
  set("exits", ([ /* sizeof() == 4 */
    "down": __DIR__ "workroom",
  ]));
  set("objects", ([
    "/u/clx/npc/qingqing": 1,
  ]));
  setup();
}
void init() {
  add_action("do_bed", "bed");
}

int do_bed() {
  object me;
  me = this_player();
  message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
  me->move("/u/clx/bed_room");
  message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
  return 1;
}
