#include "ansi.h"

inherit NPC;

void create()
{
    set_name("天星璀璨", ({ "nettrain"}));
    set("gender", "男性");
    set("age", 14+random(10));
    set("long",
        "一个傻乎乎的精灵，看上去很厉害，还是不要惹他吧。；9\n");
    set("combat_exp", 4000000+random(4000000));
    set("shen_type", 1);
    set("str", 28);
    set("con", 30);
    set("int", 15);
    set("dex", 27);
    set("eff_qi", 10000+random(14000));
    set("qi", 10000+random(14000));
    set("max_qi", 4800+random(4000));
    set("max_jing", 4220+random(4000));
    set("eff_jing", 4220+random(4000));
    set("jing", 4220+random(4000));
    set("eff_jingli", 4220+random(4000));
    set("max_jingli", 4220+random(4000));
    set("neili", 8250+random(14000));
    set("max_neili", 8250+random(14000));
    set("jiali", 100+random(200));

    set_skill("force",   300+random(440));
    set_skill("xiantian-gong",   250+random(540));
    set_skill("sword",   250+random(550));
    set_skill("parry",   200+random(560));
    set_skill("dodge",   240+random(430));
    set_skill("xiaoyaoyou",   260+random(660));
    set_skill("quanzhen-jian",   300+random(520));
    set_skill("taoism", 260+random(440));


    map_skill("force","xiantian-gong");
    map_skill("sword","quanzhen-jian");
    map_skill("parry","quanzhen-jian");
    map_skill("dodge","xiaoyaoyou");


    setup();

    carry_object("/d/taohua/obj/tiexiao")->wield();
}

