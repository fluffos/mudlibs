// rebuild.c 再造丸
#include "ansi.h"

inherit ITEM;
int bl, wx, gg, sf;

void init() {
  add_action("do_adjust", "adjust");
}

void create() {
  set_name(WHT "再造丸" NOR, ({ "zaizao wan", "wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗略显灰色的再造丸，乃巫师用无边法力制成，可以重构肉身。\n"
      +HIR + "重新指定天赋的顺序是臂力、悟性、根骨、身法。如：adjust 20 20 30 20。" + NOR + "\n");
    set("value", 0);
    set("medicine", 1);
    //              set("no_drop","这样东西不能离开你。\n");
    //              set("no_get", "这样东西不能离开那儿。\n");
  }
  setup();
}

int cure_ob(object me) {
  if (me->query("rebuild"))
    return notify_fail("你已经调整过一次天赋，此物对你已无任何用处了。\n");

  if (!me->query_temp("adjustgift"))
    return notify_fail("请先用adjust分配各项天赋的数值，方法：adjust <臂力值> <悟性值> <根骨值> <身法值>，例如：adjust 20 20 30 20\n");

  message_vision(HIR "$N吃下一颗再造丸，只觉浑身起了翻江倒海般的变化...\n" NOR, this_player());
  write(HIM "你的天赋已经重新调整成功，恭喜！\n" NOR);

  me->set("str", bl);
  me->set("int", wx);
  me->set("con", gg);
  me->set("dex", sf);
  me->delete_temp("adjustgift");
  me->set("rebuild", 1);
  // 取消桃花、华山、大理add 天赋的记录
  me->delete("dali/yideng_rewarded");
  me->delete("taohua_maze");
  me->delete("huashan/yin-jue");
  me->save();
  destruct(this_object());
  return 1;
}

int do_adjust(string arg) {
  int n;
  object me = this_player();

  if (!arg) return notify_fail("注意，天赋调整后无法更改，请慎之又慎！方法：adjust <臂力值> <悟性值> <根骨值> <身法值>\n");

  if (sscanf(arg, "%d %d %d %d", bl, wx, gg, sf) != 4)
    return notify_fail("方法：adjust <臂力值> <悟性值> <根骨值> <身法值>\n");

  if (me->query("rebuild"))
    return notify_fail("你已经调整过一次天赋，此物对你已无任何用处了。\n");

  if ((me->query("str") + me->query("int") + me->query("con") + me->query("dex")) < 90)
    return notify_fail("你的天赋已经足够，此物对你已无任何用处了！\n");

  if (bl < 10 || bl > 30) return notify_fail("膂力值须大于10小于30！\n");
  if (gg < 10 || gg > 30) return notify_fail("根骨值须大于10小于30！\n");
  if (sf < 10 || sf > 30) return notify_fail("身法值须大于10小于30！\n");
  if (wx < 10 || wx > 30) return notify_fail("悟性值须大于10小于30！\n");

  n = 90;
  //        if (me->query("taohua_maze")) n++;

  if ((bl + gg + sf + wx) != n) {
    write(HIR "你可以分配的四项天赋总和是" + n + "点，请仔细检查是否有错误！\n" NOR);
    return 1;
  }

  me->delete_temp("adjustgift");
  add_action("do_da", "da");
  write("你决定的天赋是" + HIR + "臂力" + bl + "点，悟性" + wx + "点，根骨" + gg + "点，身法" + sf + "点" + NOR + "，对吗？(da 对 或者 da 不对)\n");
  return 1;
}

int do_da(string arg) {
  object me;

  me = this_player();

  remove_action("do_da", "da");

  if (arg == "对") {
    me->set_temp("adjustgift", 1);
    write("现在你可以服药了。\n");
  } else {
    write("再仔细想想，重新调整吧。\n");
  }

  return 1;
}
