//Cracked by Roath
// yuanxiao.c 元宵

#include "ansi.h"

inherit ITEM;

void setup() {}

int cure_ob(string);
void create() {
  set_name("元宵", ({ "yuanxiao", "tangyuan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "碗");
    set("long", "一碗热气腾腾的元宵，不知什么馅儿的……管它呢，赶紧吃了闹花灯去咯！\n");
    set("value", 300000);
    set("food_remaining", 1);
    set("food_supply", 160);
    set("water_supply", 160);
    //                 set("no_drop","这么好吃的元宵怎么舍得不要？\n");
    set("no_get", "从别人碗里抢元宵？斯文扫地啊！\n");
  }
  setup();
}

int cure_ob(object me) {
  int jingli_limit, effjingli_limit, add_skill, improve;

  jingli_limit = me->query("max_jingli");
  effjingli_limit = me->query("eff_jingli");

  if ((me->query("yuanxiao")) == 0) {
    me->add("max_jingli", -30);
    me->add("eff_jingli", -30);
    message_vision(HIR "$N又吃下一碗烫元宵，只烫得满眼流泪，不一会儿突然腹如刀绞，原来吃的太急太多，撑坏了！\n" NOR, me);
  } else {
    me->add("max_jingli", 30);
    me->add("eff_jingli", 30);
    me->set("yuanxiao", 2);

    message_vision(HIY "$N吃下一碗热元宵，浑身暖暖的，幸福的忘乎所以...\n" NOR, this_player());
  }

  me->unconcious();
  destruct(this_object());
  return 1;
}
