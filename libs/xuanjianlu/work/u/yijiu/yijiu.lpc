inherit NPC;

void create()
{
    set_name("依旧",({"yijiu"}));
    set("long","好色如命!\n");
    set("age",15);

    set("chat_chance",5);
    set("chat_msg",({
         "依旧紧张的说道:你别踢我,我警告你!\n",
       }));
    setup();
}
/*
void init()
{
    object me=this_player();
    tell_object(me,"依旧冲了过来,吻了你一下!\n",me);
    add_action("do_kick","kick");
}
*/

int do_kick(string arg)
{
    object me=this_player();
    object ob=this_object();

    if(!arg || arg != "yijiu")
        return 0;

    if(arg == "yijiu")
         message_vision("$N飞起一脚正好踢在$n的屁屁上!\n",me,ob);
        tell_object(me,"依旧对你作了一揖道:谢谢!\n",me);
        return 1;
}
