#include "ansi.h"

inherit ITEM;

int cure_ob(string);
void init();

void create() {
  set_name(HIW "玉蜂浆" NOR, ({ "yufeng jiang", "jiang" }));
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "瓶");
    set("value", 70000);
    set("medicine", 1);
    set("food_supply", 80);
    set("water_supply", 120);
    //              set("no_drop", "这样东西不能离开你。\n");
  }

  setup();
}

int cure_ob(object me) {
  me->set("eff_jing", (int)me->query("max_jing"));
  me->set("jing", (int)me->query("max_jing"));
  me->set("eff_qi", (int)me->query("max_qi"));
  me->set("qi", (int)me->query("max_qi"));
  if (me->query_condition("insect_poison") > 35)
    me->apply_condition("insect_poison", 0);
  if (me->query_condition("snake_poison") > 35)
    me->apply_condition("snake_poison", 0);
  if (me->query_condition("sl_poison") > 35)
    me->apply_condition("sl_poison", 0);
  if (me->query_condition("xx_poison") > 35)
    me->apply_condition("xx_poison", me->query_condition("xx_poison") - 35);
  if (me->query_condition("xx_poison") > 55)
    me->apply_condition("xx_poison", me->query_condition("xx_poison") - 55);
  if (me->query_condition("hanbing_damage") > 30)
    me->apply_condition("hanbing_damage", 10);
  message_vision(HIW "$N喝下一瓶玉蜂浆，感觉伤势好了许多。\n" NOR, me);

  destruct(this_object());
  return 1;
}
