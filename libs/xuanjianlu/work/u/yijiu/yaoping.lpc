//Cracked by Roath
// mabudai.c 麻布袋

inherit ITEM;

void create()
{
        set_name("黑玉瓶", ({ "heiyu ping", "ping" }));
	set_weight(500);
        set_max_encumbrance(200);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
                set("long", "一只黑玉琢成的小瓶，瓶子底部却有数块红色斑，既象鲜血，又象火焰。\n");
		set("value", 50);
	}
}

int is_container() { return 1; }

int reject(object ob)
{
        if (ob && ((string)ob->query("name") == "houhui yao" || (string)ob->query("name") == "后悔药" )) return 0;
        notify_fail("你不能用黑玉瓶来装这个东西。\n");
        return 1;
}
