inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("九转还魂丹", ({ "sheng zi" }));
  set_weight(70);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这绝对不是臭鸡蛋。\n");
    set("unit", "颗");
    set("value", 80);
    set("food_remaining", 1);
    set("food_supply", 80);
  }
}
