//Cracked by Roath
// zhu-jian 竹剑
// qfy September 29, 1996

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;
int query_autoload() { return 1; }
#include "/clone/unique/special_weapon.h"
void create()
{
        set_name("竹剑",({ "zhu jian", "sword", "jian" }) );
        set_weight(4000);
		set_color(HIG);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 7000);
                set("material", "steel");
                set("long", "此剑为赵云御赐，断金削铁，锋利异常。\n");
                set("wield_msg", HIG "$N抽出$n，只见此剑有如一根青竹，暖气逼人，小巧可爱的竹剑。\n" NOR );
                set("unwield_msg", HIG "$N潇洒地将$n一挥一旋，插回鞘中。\n" NOR);
                set("unequip_msg", HIG "$N潇洒地将$n一挥一旋，插回鞘中。\n" NOR);
        }
	init_sword(100);
        setup();
	::create();
}
