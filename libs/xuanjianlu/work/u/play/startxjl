#!/bin/sh
ulimit -n 1024
workdir=/home/earth

touch $workdir/bin/xjl.out
nice $workdir/bin/addr_server 3335 >>$workdir/bin/xjl.out &
while true
do
  \mv -f $workdir/xjl/log/debug.log \
         $workdir/xjl/log/debug`date +"%m%d%H%M%S"`
  $workdir/bin/driver $workdir/bin/config.xjl >>$workdir/bin/xjl.out 
  nice $workdir/bin/addr_server 3335 >>$workdir/bin/xjl.out &
  sleep 10 
done
