inherit ROOM;
#include <ansi.h>
#include <room.h>

void create()
{
      set("short",HIC"闲情雅居"NOR);
      set("long",
"这是一间简陋的居室。室外是"HIG"青山绿水，鸟语花香"NOR"。室内摆设
简朴随意，透露出浓浓的古韵。一张琴，一柄剑，是主人终日不离
的爱物。居室正中高悬着一条横幅，上书  "BLK+BCYN"神飞八极  意贯古今"NOR"。\n"
);
      	set("no_fight", 1);
	set("exits", ([
                "kl" : "/d/kunlun/wall5",
                "sl" : "/d/shaolin/smdian",
                "sn" : "/d/shenlong/tingkou",
                "xi" : "/d/xixia/dawu",
                "hz" : "/d/hangzhou/kedian",
                "wd" : "/d/wudang/sanqingdian",
                "xx" : "/d/xingxiu/xxh2",
                "gb" : "/d/gaibang/undertre",
                "gy" : "/d/taihu/qianyuan",
                "hs" : "/d/huashan/buwei1",
                "bt" : "/d/xingxiu/btyard",
                "dl" : "/d/dali/wangfu1",
                "em" : "/d/emei/hz_guangchang",
                "xs" : "/d/xueshan/guangchang",
		"yz" : "/d/city/kedian",
                "qz" : "/d/quanzhou/zhongxin",
                "hs" : "/d/huashan/buwei1",
                "bt" : "/d/xingxiu/btyard",
                "dl" : "/d/dali/wangfu1",
                "em" : "/d/emei/hz_guangchang",
                "xs" : "/d/xueshan/guangchang",
                "wr": "/d/wizard/wizard_room",                                                             
                "mz": "/d/taishan/fengchan",                                                             
                "fe": "/d/taishan/zhengqi",                                                             
                "ss": "/d/taishan/xiayi",                                                             
	]));
		set("valid_startroom","1");
      		setup();
      
//        call_other("/clone/board/discip_b", "???");
}

int valid_leave(object me, string dir)
{
        if( dir=="wr" && !wizardp(me) )
                return notify_fail("那里只有巫师才能进去。\n");
        return ::valid_leave(me, dir);
}

