// mj_ship1.c  明教海船
// write by lbc

// 飞鸽传书，改变方向

inherit F_CLEAN_UP;
inherit ROOM;

#include <ansi.h>

int do_start();
int navigate();
int start_battle();
int do_stop();
int do_load();
int do_aim(string target_dir);
int do_fire();

string long_desc() {
  string desc;

  desc = "这是一艘明教专用的海船。船帆上有一个大红的火焰。甲板上放了十数\n";
  desc += "门大炮(Da pao)。了望台和甲板高层放着两架千里望。\n";
  desc += "你可以用order来指挥水手们航海。\n\n";

  if (!this_object()->query("exits/out"))
    switch ((int)this_object()->query_temp("navigate/weather")) {
      case 1: desc += BLU "天空中彤云密布，只有几只海鸥还在奋力展翅，海船左右摇晃不已，你感到有\n点立足不稳。\n" NOR; break;
      case 2: desc += BLU "海面汹涌澎湃，几丈高的巨浪排山倒海似得压来，随时都有可能将船掀翻，你\n时而不得不紧紧抱住船杆，以免落海。\n" NOR; break;
      default: desc += BLU "四周是辽阔的海面，海风在你耳边轻轻吹过，海浪一个接一个向船泼打过来。\n" NOR; break;
    }
  return desc;
}

void create() {
  string argg;
  int num;

  set("short", "海船");
  set("long", (: long_desc :));
  set("item_desc",
    ([ "pao": "这是一门大炮，你可以用(load)来指挥水手专装填弹药，(aim 方向)瞄准，(fire)开火。\n",
    ]));
  set("invalid_startroom", 1);
  set("cost", 5);
  setup();

  //        if( sscanf(__FILE__, "%s%d", argg, num) == 2 )
  //        set("exits", ([ 
  //		  "down" : __DIR__"cabin" + num,
  //        ]));
}

void init() {
  add_action("do_order", "order");
  add_action("do_locate", "locate");
  add_action("do_load", "load");
  add_action("do_aim", "aim");
  add_action("do_fire", "fire");
}

// 指挥函数
int do_order(string arg) {
  object me = this_player();
  if (!arg)
    return notify_fail("你要让水手做什么？\n");
  if (this_object()->query_temp("battle"))
    return notify_fail("先解决眼前的敌人吧。\n");
  if (this_object()->query_temp("mj_job/x_pot") == -9999) {
    remove_call_out("back2");
    call_out("back2", 3);
  }

  switch (arg) {
    case "start":
      do_start();
      break;
    case "east":
      if (this_object()->query("exits/out"))
        return notify_fail("船还没开呢。\n");
      message_vision(CYN "$N让水手把船往东开。\n" NOR, me);
      set_temp("navigate/dir", "东");
      break;
    case "west":
      if (this_object()->query("exits/out"))
        return notify_fail("船还没开呢。\n");
      message_vision(CYN "$N让水手把船往西开。\n" NOR, me);
      set_temp("navigate/dir", "西");
      break;
    case "north":
      if (this_object()->query("exits/out"))
        return notify_fail("船还没开呢。\n");
      message_vision(CYN "$N让水手把船往北开。\n" NOR, me);
      set_temp("navigate/dir", "北");
      break;
    case "south":
      if (this_object()->query("exits/out"))
        return notify_fail("船还没开呢。\n");
      message_vision(CYN "$N让水手把船往南开。\n" NOR, me);
      set_temp("navigate/dir", "南");
      break;
    case "stop":
      do_stop();
      break;
      /*		case "load":
			do_load();
			break;
		case "aim":
			do_aim();
			break;
		case "fire":
			do_fire();
			break;
*/
    default:
      return notify_fail("你要让水手做什么？\n");
  }
  return 1;
}

// 航海函数
int navigate() {
  int x, y;
  string dir;
  object harbor, me = this_player(), ob = this_object();

  dir = query_temp("navigate/dir");

  set_temp("navigate/weather", random(3));

  switch (dir) {
    case "东":
      add_temp("navigate/locx", 1);
      break;
    case "西":
      add_temp("navigate/locx", -1);
      break;
    case "南":
      add_temp("navigate/locy", 1);
      break;
    case "北":
      add_temp("navigate/locy", -1);
      break;
  }

  x = query_temp("navigate/locx");
  y = query_temp("navigate/locy");

  if (dir && (x == 0)) {
    if (y == 0) {
      message_vision(HIR "水手报告，已经到了我教秘密码头了。\n" NOR, me);
      remove_call_out("navigate");
      remove_call_out("feige");
      harbor = load_object("/d/kunlun/obj/mj_harbor");
      set("exits/out", base_name(harbor));
      harbor->set("exits/enter", base_name(this_object()));
      delete_temp("navigate/dir");
      return 1;
    } else {
      message_vision(HIR "船身一阵剧烈摇晃，好像搁浅了！\n" NOR, me);
      delete_temp("navigate/dir");
    }
  }

  if ((x == ob->query_temp("mj_job/x_pot")) && (y == ob->query_temp("mj_job/y_pot"))) {
    start_battle();
    return 1;
  }

  if (dir)
    tell_room(this_object(), "船正往" + dir + "方向前进。\n");
  remove_call_out("navigate");
  call_out("navigate", 2);
  return 1;
}

int do_start() {
  object harbor, me = this_player();
  string filename, argg;
  int num;

  if (!stringp(filename = this_object()->query("exits/out"))) {
    message_vision("船已经出海了。\n", me);
    return 1;
  }

  message_vision("test1\n", me);
  if (!(harbor = find_object(filename)))
    harbor = load_object(filename);

  message("vision", "船离了岸，驶向茫茫的大海。\n", harbor);
  filename = base_name(this_object());
  if (sscanf(filename, "%s%d", argg, num) == 2)
    //		harbor->delete("exits/enter" + num);
    harbor->delete("exits/enter");

  message_vision("$N大喝一声“开船”，于是船便离了岸。\n", me);
  this_object()->delete("exits/out");
  set_temp("mj_job/x_pot", -1000);
  set_temp("mj_job/y_pot", -1000);
  set_temp("navigate/locx", 0);
  set_temp("navigate/locy", 0);
  remove_call_out("feige");
  call_out("feige", 120);
  remove_call_out("navigate");
  call_out("navigate", 2);
  message_vision("test2\n", me);
  return 1;
}

int start_battle() {
  object ob, me;
  int dir;  //数字敌船方向
  string cdir, edir;  //中文, 英文敌船方向
  me = this_player();
  ob = this_object();
  dir = random(8);
  switch (dir) {
    case 1:
      cdir = "东";
      edir = "east";
      break;
    case 2:
      cdir = "南";
      edir = "south";
      break;
    case 3:
      cdir = "西";
      edir = "west";
      break;
    case 4:
      cdir = "北";
      edir = "north";
      break;
    case 5:
      cdir = "东北";
      edir = "northeast";
      break;
    case 6:
      cdir = "东南";
      edir = "southeast";
      break;
    case 7:
      cdir = "西北";
      edir = "northwest";
      break;
    default:
      cdir = "西南";
      edir = "southwest";
  }

  message_vision(HIR "水手大声报告：“" + cdir + "方向发现敌船！”\n" NOR, me);
  set_temp("battle/edir", edir);
  message_vision("TEST ok!!!!!\n", me);
  delete_temp("navigate/dir");
  ob->set_temp("attacked", 0);
  remove_call_out("enemy_shoot");
  call_out("enemy_shoot", 10);
  return 1;
}

int do_stop() {
  object me = this_player();
  message_vision("$N让水手把船停了下来。\n", me);
  delete_temp("navigate/dir");
  return 1;
}

int do_locate() {
  int x, y;
  string dirx, diry, loc;
  x = query_temp("navigate/locx");
  y = query_temp("navigate/locy");

  if (x == 0) {
    tell_object(this_player(), "你在岸边。\n");
    return 1;
  }
  loc = "船正在距离明教码头";
  dirx = (x > 0) ? "东" : "西";
  diry = (y > 0) ? "南" : "北";

  y = (y > 0) ? y : -y;
  x = (x > 0) ? x : -x;
  if (y == 0) {
    dirx = "正东";
    diry = "";
    loc += dirx + chinese_number(x) + "海里处。\n";
  } else
    loc = loc + dirx + chinese_number(x) + "海里，" + diry + chinese_number(y) + "海里处。\n";
  tell_object(this_player(), loc);
  return 1;
}

int feige() {
  message_vision(HIC "\n突然海面上飞来一只信鸽，停在船桅上。\n\n" NOR, this_player());
  remove_call_out("feige2");
  call_out("feige2", 2);
  return 1;
}

int feige2() {
  int x, y, enemy;
  string enemy_boat;
  object ob = this_object();
  x = 50 + random(50);
  y = 50 + random(50);
  message_vision(CYN "一名明教水手唤下信鸽，取出绑在鸽子脚上的密信。\n\n" NOR, this_player());
  enemy = random(2);
  if (enemy)
    enemy_boat = "正派人士";
  else enemy_boat = "元兵";
  message_vision(
    CYN "信上写道：“听说有一艘" + enemy_boat + "的船在距离塘沽口大约" + "东" + chinese_number(x) + "海里，" + "北" + chinese_number(y) + "海里处，需得格外小心。”\n\n" NOR,
    this_player()
  );
  ob->set_temp("mj_job/x_pot", x);
  ob->set_temp("mj_job/y_pot", -y);
  return 1;
}

int enemy_shoot() {
  object me, ob;
  int attacked;
  me = this_player();
  ob = this_object();
  attacked = ob->query_temp("attacked");

  if (!attacked) {
    message_vision(HIR "突然间轰隆一声巨响，船身猛烈一侧，跟着半空中海水倾泻，直涌上甲板来。水手们高声大叫：“敌船开炮！敌船开炮！”\n\n" NOR, me);
    ob->set_temp("attacked", 1);
  }

  if (attacked == 1) {
    message_vision(HIR "过不多时，敌船又是一炮轰来，正中船头，船上登时起火。\n\n" NOR, me);
    ob->set_temp("attacked", 2);
  }

  if (attacked == 2) {
    message_vision(HIR "蓦地里红光一闪，震天价一声大响，适才敌船一炮正好击中甲板上的火药桶。但见船上到处是火，转眼即沉。\n\n" NOR, me);
    ob->set_temp("attacked", 3);
    remove_call_out("enemy_shoot");
    remove_call_out("ship_sink");
    call_out("ship_sink", 3);
    return 1;
  }
  remove_call_out("enemy_shoot");
  call_out("enemy_shoot", 5);
  return 1;
}

int do_load() {
  object ob, me;
  ob = this_object();
  me = this_player();
  if (ob->query_temp("loaded")) {
    tell_object(me, "弹药已经装好了。\n");
    return 1;
  }

  message_vision(HIR "$N命令水手给大炮装好弹药。\n\n" NOR, me);
  ob->set_temp("loaded", 1);
  return 1;
}

int do_aim(string target_dir) {
  object ob, me;
  ob = this_object();
  me = this_player();
  if (ob->query_temp("aimed")) {
    tell_object(me, "开炮吧！\n");
    return 1;
  }
  if (!target_dir || (target_dir != ob->query_temp("battle/edir"))) {
    tell_object(me, "这个方向没有敌船。\n");
    return 1;
  }
  message_vision(HIR "$N命令水手调整炮口，对准了对面的船。\n\n" NOR, me);
  ob->set_temp("aimed", 1);
  return 1;
}

int do_fire() {
  object ob, me;
  ob = this_object();
  me = this_player();

  if (me->is_busy()) {
    tell_object(me, "你正忙着呢。\n");
    return 1;
  }
  if (!ob->query_temp("attacked")) {
    tell_object(me, "好端端的不要胡乱开炮！\n");
    return 1;
  }

  if (!ob->query_temp("loaded")) {
    tell_object(me, "大炮还没有装填弹药，怎么打？\n");
    return 1;
  }
  if (!ob->query_temp("aimed")) {
    tell_object(me, "还没瞄准敌人呢，你想往哪儿打？\n");
    return 1;
  }

  if (ob->query_temp("shot")) {
    tell_object(me, "已经打中敌船了。\n");
    return 1;
  }
  message_vision(HIR "$N亲自点燃药绳，砰的一炮轰将过去。\n\n" NOR, me);
  message_vision(HIB "这一炮正中敌船，对面船上登时起火，水手纷纷跳海逃生。\n\n" NOR, me);
  ob->set_temp("shot", 1);
  ob->delete_temp("aimed");
  ob->delete_temp("loaded");
  remove_call_out("enemy_shoot");
  remove_call_out("enemy_come");
  call_out("enemy_come", 2, this_player());
  return 1;
}

int enemy_come(object player) {
  int enemy_num, i;
  object killer, *ob;
  tell_room(this_object(), HIC "\n突然对面船上有人放下一艘小艇，飞速的向这边划来。到的近前，几个身影一跃而起，上了甲板。\n" NOR);
  ob = all_inventory(this_object());
  for (i = 0; i < sizeof(ob); i++) {
    if (ob[i]->query_temp("mj_job/asked_yang"))
      enemy_num++;
  }

  enemy_num = enemy_num / 2 + 1;

  set_temp("enemy_num", enemy_num);

  for (i = 0; i < enemy_num; i++) {
    killer = new("/d/kunlun/npc/mjship_npc");
    killer->set_status(player);
    killer->move(this_object());
    message("vision", CYN "\n" + killer->name(1) + "大喝道：“魔教妖人！拿命来吧！”\n" NOR, this_object(), killer);
    for (i = 0; i < sizeof(ob); i++) {
      if (ob[i]->query_temp("mj_job/asked_yang"))
        killer->kill_ob(ob[i]);
    }
  }
  return 1;
}

int ship_sink() {
  object me, ob;
  me = this_player();
  ob = this_object();
  message_vision(HIB "船沉了！\n\n" NOR, me);
  me->move("/d/kunlun/obj/mj_harbor");
  destruct(ob);
  return 1;
}

void back1() {
  remove_call_out("back2");
  call_out("back2", 3);
  return;
}

void back2() {
  object me = this_player();
  message_vision(HIC "水手报告：“海船损伤甚重，须得回我教港口修复。”\n\n" NOR, me);
  message_vision(CYN "$N叹了口气，只得让海船开回明教港口。\n\n" NOR, me);
  remove_call_out("back3");
  call_out("back3", 3);
  return;
}

int back3() {
  object me = this_player();
  object *ob;
  int i;
  message_vision(HIC "不日船便到了秘密港口。\n\n" NOR, me);
  ob = all_inventory(this_object());
  for (i = 0; i < sizeof(ob); i++) {
    message_vision("$N从船上走了下来。\n\n" NOR, ob[i]);
    ob[i]->move("/d/kunlun/obj/mj_harbor");
  }
  message_vision("水手们收起踏板，将船开走了。\n\n" NOR, me);
  destruct(this_object());
  return 1;
}
