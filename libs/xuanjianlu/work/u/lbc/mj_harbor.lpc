// mj_harbor.c 明教秘密港
// write by lbc

inherit F_CLEAN_UP;
inherit ROOM;

#define SHIP      "/d/kunlun/obj/mj_ship"
#define SHIPS     "/d/kunlun/obj/"
#define SHIPNAME  "mj_ship"
#include <ansi.h>

void create() {
  set("short", "海港");
  set("long", @LONG
这里是一个大海港，可是从树林的那边，什么也看不见。码头上的旗帜
上绣了一个大红的火焰。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "northwest": "/d/beijing/tanggu",
  ]));
  set("no_clean_up", 0);
  set("cost", 1);

  setup();
}

void init() {
  add_action("do_yell", "yell");
}

int do_yell(string arg) {
  object ship, me = this_player();
  int i;

  if (!me->query_temp("mj_job/asked_yang"))
    return notify_fail("你没事乱喊什么？\n");

  if (!arg || arg != "chuan")
    return notify_fail("你要喊什么？\n");

  if (this_object()->query("exits/enter"))
    return notify_fail("船已经在待命了。\n");

  i = 0;
  i++;

  while (ship = find_object(SHIP + i))
    i++;

  if (i > 3)
    return notify_fail("一名明教教众跑了过来，对你说道：“启秉" + me->query("communion/title") + "，所有的海船都出海了。\n");

  ship = load_object(SHIP + i);

  this_object()->set("exits/enter", base_name(ship));
  ship->set("exits/out", base_name(this_object()));
  message("vision", "一条大海船不知从哪里慢慢驶了出来，水手将一块踏脚板搭在沙滩上。\n", this_object());
  return 1;
}
