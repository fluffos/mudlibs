#include "/d/kunlun/npc/mingjiao_npc.lpc"
#include <ansi.h>

int auto_perform();
int rujiao(object player);
int rujiao1(object player);
int ask_job();
void check_out(object ob);

void create()
{
		mapping S_skills= ([ ]);
		mapping I_inquiry=([ ]);
		mixed Skill_name;
   		object me = this_object();
		set_name("杨逍",({"yang xiao","yang","xiao"}));
        set("title", "明教光明左使");

        set("long", "他就是明教的光明左使，和范遥合称逍遥二仙的杨逍。\n他身着一身白衫，虽然已是中年，但看上去还十分英俊潇洒。\n");
        set("gender", "男性");
        set("age", 43);
        set("attitude", "peaceful");
        set("shen", 3000000);
        create_family("明教",34,"使者");
   		create_communion(me, 34);
		
		I_inquiry["name"]="在下就是明教光明左使杨逍，不知阁下有何指教。";
		I_inquiry["金毛狮王"]=(: ask_job :);
		I_inquiry["谢逊"]=(: ask_job :);
		I_inquiry["xiexun"]=(: ask_job :);

		Skill_name=({"shenghuo-xuanming","xiaoyao-piaopiao","xiaoyao-zhangfa","xiaoyao-jianfa","riyue-shenzhang","shenghuo-quan","guangming-xinfa"});
		Set_Inquiry(I_inquiry,Skill_name);

		Set_Npcattrib(27,5,5000,300,7000,400,9000,300,5000,1000,3000000,100000);

//	S_skills["dodge"]="xiaoyao-piaopiao";
//	S_skills["parry"]="xiaoyao-zhangfa";
//	S_skills["sword"]="xiaoyao-jianfa";
//	S_skills["force"]="shenghuo-xuanming";
//	S_skills["cuff"]="shenghuo-quan";
//	S_skills["strike"]="xiaoyao-zhangfa";
	set_skill("qiankun-danuoyi",80+random(10));
//	set_skill("guangming-xinfa",380+random(20));
	set_skill("literate",300+random(20));
	
//	Set_Npcskills(320,20,S_skills);
	
	prepare_skill("strike","xiaoyao-zhangfa");
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: auto_perform :),
	}) );
        setup();

        carry_object(OBJ_PATH"/changpao")->wear();
        carry_object("/clone/weapon/changjian")->wield();
}

int rujiao(object player)
{
	
	command("hi"+" "+player->query("id"));
	command("look"+" "+player->query("id"));
	player->start_busy(4);

    remove_call_out("rujiao1");
    call_out("rujiao1", 3, player);
}

int rujiao1(object player)
{
	object ling;
	string fam = player->query("family/family_name");
	
	if(!objectp(player))
	{
		command("say 咦？刚才是谁要入教？\n");
		message_vision("$N往里走去。\n",this_object());
		move(MINGJIAO"/shting");
		message_vision("$N走了过来。\n",this_object());
		return 1;
	}
	
	if(fam == "星宿派")
	{
		command("say " + "我教虽被世人称为魔教，却也不和丁老怪同流合污。\n");
		command("say " + "这位" +RANK_D->query_respect(player) + "请自便。\n");
		message_vision("$N往里走去。\n",this_object());
	}
	
	else if(fam == "峨嵋派")
	{
		command("say " + "贵派灭绝师太恨我教入骨，我教不能收你。\n");
		command("say " + "这位" +RANK_D->query_respect(player) + "请自便。\n");
		message_vision("$N往里走去。\n",this_object());
	}
	
	else if((int)player->query_skill("pixie-jian", 1) >=60)
	{
		command("sneer " + getuid(player));
		command("say " + "阁下明知我教与朝廷为敌，莫非想来我教卧底么？\n");
		command("say " + "这位" +RANK_D->query_respect(player) + "请自便。\n");
		message_vision("$N往里走去。\n",this_object());
	}

	else
	{
		command("say "+"好！既然这位"+RANK_D->query_respect(player)+"想加入我光明圣火教，那么从今天起，你就是我明教信徒！\n");
		create_communion(player, 38);
		tell_object(player,HIC"恭喜您成为明教教众！\n"NOR);
		command("say "+"这位"+RANK_D->query_respect(player)+"请随我来。\n");
		message_vision("$N往里走去。\n$n跟着杨逍往里走去。\n",this_object(),player);
		move(MINGJIAO"/daguangchang");
		player->move(MINGJIAO"/daguangchang");
		message_vision("$N走来过来。\n$n跟着杨逍走来过来。\n",this_object(),player);	
		//here need add later
		message_vision("$N对$n说到：这里就是我明教重地光明顶。\n",this_object(),player);	
	    if(objectp(ling = present("tieyan ling", player)) )
		{
			message_vision("$N对$n说到：你刚入我教，怎可能有我教的铁焰令？如果是什么bug请汇报给巫师。\n",this_object(),player);	
			player->delete_temp("ask_rujiao");
			move(MINGJIAO"/shting");
			message_vision("$N走了过来。\n",this_object());
			return 1;
		}
		ling = new(OBJ_PATH"/tieyanling");
		ling->move(player);
		tell_object(player,"杨逍从怀中取出一块状似火焰的令牌。\n");
		tell_object(player,"杨逍对你说道：这是我教信物<铁焰令>，你需要随身携带，不可丢失。\n");
		tell_object(player,"杨逍给你一块铁焰令。\n");
		command("say "+"你刚入我教，可以随便走走，看我明教声威比齐江湖其它各派如何。\n");
		command("say "+"你可先去五行旗，向旗主们学些入门的功夫，或者向五散人请教。\n");
		command("say "+"我还有要务在身，先行告退。\n");
	}
	player->delete_temp("ask_rujiao");
	move(MINGJIAO"/shting");
	message_vision("$N走了过来。\n",this_object());
	return 1;

}

int auto_perform()
{
	object me=this_object();
	object weapon=me->query_temp("weapon");
	object opp=me->select_opponent();

	if( me->query("qi",1) < 0 || me->query("jing",1) < 0 || me->query("jingli",1) < 0) return 1;

	if ( !me->is_fighting() ) 
	{
		if ( me->query("eff_qi") < me->query("max_qi") )
			me->exert_function("heal");
		me->set("jiali", 50);
        return 1;
    }
	
	if ( objectp(weapon) ) 
	{
		if ( weapon->query("skill_type") == "sword" )
			return perform_action("sword.jianqi");
	}
    else return perform_action("strike.xiaoyao");
}

void init()
{
	object ob, me;
	string famm;
	ob = this_player();
	::init();

	set_heart_beat(1);
		
	famm = ob->query("family/family_name");
	if( (interactive(ob) 
		&& living(ob)
		&& ob->query("communion/communion_name") == "明教")
		&& ((int)ob->query_skill("pixie-jian", 1) >=60
		|| famm == "星宿派"
		|| famm == "峨嵋派"))
	{
		remove_call_out("check_out");
		call_out("check_out", 1, ob);
	}
}


void check_out(object ob)
{
	if(ob->query("communion/generation") != 33)
		{
			command("look " + getuid(ob));
			remove_call_out("chujiao");
			call_out("chujiao", 3 , ob);
			ob->start_busy(4);
		}
		else 
		{
			command("look " + getuid(ob));
			command("sigh " + getuid(ob));
			command("shout");
			// 待加入暗杀教主，或是逼退教主程序。
		}
}

void chujiao(object ob)
{
	mapping fam;
	object ling;
	if(ob->query_skill("pixie-jian",1))
	{
		command("hmm " + getuid(ob));
		command("say " + RANK_D->query_rude(ob)+ "身为我明尊座下弟子，竟然去为朝廷效力！");
		command("say 我光明圣教已无你容身之地，你走吧！");
		command("say 你若能痛定思过，离开朝廷，尚可考虑重入明教。\n");
	}
	
	if(ob->query("family/family_name") == "星宿派")
	{
		command("hmm " + getuid(ob));
		command("say 我明教虽被世人称为魔教，却也不屑和丁春秋此类为伍！");
		command("say 我光明圣教已无你容身之地，你走吧！");
		command("say 你若能和星宿妖人断绝关系，尚可考虑重入明教。\n");
	}
	
	if(ob->query("family/family_name") == "峨嵋派")
	{
		command("hmm " + getuid(ob));
		command("say 峨嵋派掌门灭绝师太恨我教入骨，你既入我教，为何又去投入灭绝老尼门下？");
		command("sigh");
		command("say 你若继续留在教中，恐怕诸多不便，你这就走吧。\n");
	}
		
	ob->delete("communion");
	ob->delete("mingjiao/credit");
	if(objectp(ling = present("tieyan ling", ob)))
	{
		message_vision("$N从怀里摸出一块铁焰令，“当”的一声丢在地上。\n", ob);
		ling->move(environment(ob));
	}
	if (fam = ob->query("family"))
	{
		/*ob->create_family(fam["family_name"], fam["generation"], fam["title"]);
        ob->set("family/enter_time", fam["enter_time"]);
		ob->set("family/master_id", fam["master_id"]);
		ob->set("family/privs", fam["privs"]);
		ob->set("family/master_name", fam["master_name"]);*/
		ob->set("title", ob->query("mingjiao/old_title"));
	}
	else
	{
		ob->set("title", "普通百姓");
	}
}

int ask_job()
{
	int x, y, enemy, gen;
	string posx, posy, enemy_boat;
	object ob = this_player();
	gen = ob->query("communion/generation");
	if (!gen || gen > 35)
	{
		command("say 金毛狮王已经失踪多年，本教兄弟曾四处打听，都没有消息。\n");
		return 1;
	}
		
	tell_object(ob, "杨逍小声说道：金毛狮王已经失踪多年，根据本教兄弟打听到的消息，现在金毛狮王是在极北之处的一个小岛上。\n");
	command("say " + ob->query("communion/title") + "如能亲自出马，必能迎得谢狮王归来。\n");
	command("say 我教在塘沽口附近有专用的秘密码头，海船随时听候调遣。\n");
	x = 50 + random(50);
	y = 50 + random(50);
	enemy = random(2);
	if (enemy)
		enemy_boat = "正派人士";
	else enemy_boat = "元兵";
	//command("say 听说有一艘" + enemy_boat + "的船在距离塘沽口大约" + "东" + chinese_number(x) + "海里，" + "北" + chinese_number(y) + "海里处，需得格外小心。\n");
	//ob->set("mj_job/x_pot", x);
	//ob->set("mj_job/y_pot", y);
	ob->set_temp("mj_job/asked_yang", 1);
	command("say test ok\n");
	return 1;
}