// class类型是C++新增的，想不到LPC也支持
class email
{
	string rcpt;	// 收件者地址
	string body;	// 内容
	int status;		// 状态码
	string id;		// 用户 ID
	string passwd;	// 密码
	object user;
	int normal;
}

