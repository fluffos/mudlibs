#include <ansi.h>
inherit NPC;
#include "npc_setup.h"

string ask_cike();
string ask_move();
string chs_menpai(string menpai);

void create()
{
        set_random_name();
        set("gender", "男性" );
        set("age", 32);
        set("str", 23);
        set("dex", 30);
        set("con", 23);
        set("int", 23);
        set("shen_type", -1);

        set("max_qi", 300);
        set("max_jing", 100);
        set("neili", 200);
        set("max_neili", 200);

        set("no_refresh", 1);

        /*set("inquiry", ([
            "斧头帮" : "斧头帮? 你可知道他们帮主的所在吗？",
            "程金斧" : (: ask_move :),
            "刺客" : (: ask_cike :)
        ]));*/

        setup();
        carry_object("/clone/armor/beixin")->wear();
        //remove_call_out("self_destruct");
        //call_out("self_destruct", 1200);

}

int self_destruct() {
    object me = this_object();
    message("vision", name(1)+"急急忙忙地离开了。\n", environment(me), me);
    destruct(me);
	return 1;
}

void set_status(mixed player_arg) {
    int exp, sacrifice, exp_rate, skill_rate;
    object player;
    string menpai;

    if (stringp(player_arg)) player = find_player(player_arg);
    else if (objectp(player_arg)) player = player_arg;
    else return;
    if (!objectp(player)) return;

    set("player_name", player->query("id"));
    exp = player->query("combat_exp");

    /*sacrifice = (int)player->query("futou_bang/sacrifice");
    if (sacrifice < 50) exp = exp * (200-sacrifice)/200;
    else exp = exp*3/4;*/

    if (exp < 1000) exp = 1000;
    else  if (exp < 50000) {
        exp = exp/2;
        set("dex", 15);
    }else if (exp < 100000) {
        exp = exp*2/3;
        set("dex", 20);
    }else if (exp < 500000) {
        exp = exp*2/3;
        set("dex", 25);
    }else if (exp < 800000) {
        set("dex", 25);
    }

    // exp 1M add 7%     2M add 14%     3M add 21%
    exp_rate = 80;
    skill_rate = 80;
    if (exp > 1000000) {
        exp_rate += 1*exp/1000000;
        skill_rate += 1*exp/1000000;
    }
    exp_rate += random(20);
    skill_rate += random(10);

    menpai = set_skills(0, exp*exp_rate/100, skill_rate);
    set("long", "他看起来是"+ chs_menpai(menpai) +"高手。\n");
    set_hp(query_skill("force", 1));
    if (exp > 100000) carry_object(query("default_weapon"))->wield();

//    remove_call_out("check_corpse");
//  call_out("check_corpse", 10);
}

void die()
{
    mixed killer;
    int killer_num, i;
	object *ob, mj_ship;
    mj_ship = environment(this_object());
	
	mj_ship->add_temp("enemy_num", -1);
	killer_num = mj_ship->query_temp("enemy_num");
	if(killer_num <= 0)
	{
		ob = all_inventory(environment(this_object()));
		for(i=0; i<sizeof(ob); i++) 
		{
			if(ob[i]->query_temp("mj_job/asked_yang"))
			{
				ob[i]->add("combat_exp", random(400)+700);
				ob[i]->add("potential", 400);
				ob[i]->add("mingjiao/credit", 10 + random(10));
				ob[i]->delete_temp("mj_job");
			}
		}
	   	mj_ship->delete_temp("enemy_num");
		mj_ship->delete_temp("battle");
		mj_ship->delete_temp("attacked");
		mj_ship->delete_temp("shot");
		mj_ship->set_temp("mj_job/x_pot", -9999);
		mj_ship->set_temp("mj_job/y_pot", -9999);
		tell_room(mj_ship, "你的临敌经验增加了！\n");
	}
	::die();
}

string chs_menpai(string menpai)
{
	string ch;
	switch (menpai)
	{
	case "huashan": ch ="华山派";	break;
	case "shaolin": ch ="少林派";	break;
	case "wudang": ch ="武当派";	break;
	case "emei": ch ="峨嵋派";	break;
	case "gaibang": ch ="丐帮";	break;
	case "baituo": ch = "白驼山"; break;
	case "xueshan": ch = "密宗"; break;
	case "xingxiu": ch = "星宿派"; break;
	case "taohua": ch = "桃花岛"; break;
	case "lingjiu": ch = "灵鹫宫"; break;
	case "gumu": ch = "古墓派"; break;
	default: ch = "不知名";
	}
	return ch;
}

#include "npc_setup.lpc"
