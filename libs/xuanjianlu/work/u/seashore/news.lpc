#include <ansi.h>;

void create() { seteuid(ROOT_UID); }

int check_news(object me)
{
        return NEWS_D->check_news(me);
}

int main(object me, string arg)
{
        return NEWS_D->main(me,arg);
}



int help(object me)
{
    write(@HELP
查看最新新闻的指令 

指令格式 :
news                    查看共有的和最新发布的新闻。
news all                新闻一览。 
news new                阅读最新的新闻。 
news <新闻编号>         查看此编号新闻的详细内容。 
HELP
    );
    return 1;
}
