#include <dbase.h>
#include <name.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

nosave int amount;

void setup() {}

int query_amount() { return amount; }

// AGENTS.md §8.3a-class bug: destruct_me() is invoked by name via a
// driver-origin call_out() (set_amount() below), exactly like an
// add_action-bound dispatcher -- `private` demotes to DECL_HIDDEN once
// this file is inherited (by every stackable/combined item, most
// impactfully money), and the driver then silently refuses the
// call_out apply ("insufficient permission ... needs: private, has:
// hidden"). Symptom: any stackable item whose amount is spent/reduced
// to exactly 0 (e.g. spending your entire silver stack in one
// purchase) gets moved to VOID_OB and then NEVER actually destructs --
// a permanently-orphaned zero-amount clone, one apply() denial logged
// per occurrence. Dropping `private` (no `nomask` was present to
// preserve) fixes it the same way as every other instance of this bug
// class.
void destruct_me() { destruct(this_object()); }

void set_amount(int v) {
  if (v < 0) error("combine:set_amount less than 1.\n");
  if (v == 0) { ::move(VOID_OB); call_out("destruct_me", 1); } else {
    amount = v;
    this_object()->set_weight(v * (int)query("base_weight"));
  }
}

void add_amount(int v) { set_amount(amount + v); }

string short() {
  return chinese_number(query_amount()) + query("base_unit") + ::short();
}

varargs int move(mixed dest, int silent) {
  object env, *inv;
  int i, total;
  string file;

  // we want combined item can always be transfered without checking
  // overweight. The correct weight will be reset by set_amount later;

  //wzfeng have remove it.becasue if set it =0 ,u can arbitrari put anything in a bag. 
  //this_object()->set_weight(0);
  if ( ::move(dest, silent)) {
    //I douno why add living .if add it, when u put something in bag, will jump over
    //so I'm remove it				wzfeng 2000 7/////////////////////////////////
    /*                if( living(env = environment()) 
                   && !this_object()->query("embedded")) 
				   */
    if ((env = environment())
      && !this_object()->query("embedded")) {
      file = base_name(this_object());
      inv = all_inventory(env);
      total = (int)query_amount();
      for (i = 0; i < sizeof(inv); i++) {
        if (inv[i] == this_object()) continue;
        //                                if( base_name(inv[i])==file && !inv[i]->query("embedded")) { //play 2002.7.5
        if ((base_name(inv[i]) == file ||
          (this_object()->short() == inv[i]->short()) ||
          (this_object()->name() == inv[i]->name() &&
            this_object()->query("id") == inv[i]->query("id") &&
            this_object()->query("base_unit") == inv[i]->query("base_unit")
          )) && !inv[i]->query("embedded")) {
          total += (int)inv[i]->query_amount();
          destruct(inv[i]);
        }
      }
      set_amount(total);
    }
    return 1;
  }
}
