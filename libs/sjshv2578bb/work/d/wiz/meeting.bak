// Room: /d/wiz/wizroom.c

inherit ROOM;
#include <ansi.h>

int block_cmd();

void create ()
{
  set ("short","玩家意见室");
  set ("long", 
"\n"
"这儿是巫师和玩家交流意见的地方，如果你对巫师有什么好的建
议或者有什么问题需要巫师解决，可以在这儿留言与次无关的留
言将不被保存！
"
"\n"NOR);
  


  set("exits", ([ /* sizeof() == 2 */
  "down": "/d/city/kezhan",
  "north": "/d/wiz/system",
 ]));


  setup();
  call_other("/obj/board/meet_b", "???");
}

void init()
{   
          add_action("say_log",({ "say","'"}));
}

int say_log(string msg)
{
        object me;
        string logpath = "meeting";
        me = this_player();
        if( !msg ) return 0;
        else
        "/cmds/std/say.c"->main(me, msg);
        MONITOR_D->mudring_log(logpath, me, msg);
        return 1;
}
