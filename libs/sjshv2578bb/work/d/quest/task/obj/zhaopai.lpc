inherit ITEM;
#include <task.h>
#include <ansi.h>

void create()
{
        set_name("招牌", ({"zhao pai", "pai"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "药铺掌柜杨中顺的老字号招牌。\n");
                set("unit", "块");
                 set("owner_name","杨中顺");
               set("owner_id","yang zhongshun");
        }
}

