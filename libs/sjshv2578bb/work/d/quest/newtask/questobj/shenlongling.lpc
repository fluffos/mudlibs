#include <ansi.h>
inherit ITEM;
void create()
{
    set_name("神龙狮虎令", ({ "shenlong" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "块");
            set("material", "stone");
            set("long", "一块血迹斑斑的令牌。\n");
}
    setup();
}
