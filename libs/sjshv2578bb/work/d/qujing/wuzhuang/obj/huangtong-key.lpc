//Cracked by Roath
// huangtong-key.c 
//Modified by kuku@2004.04.10

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIY "黄铜钥匙" NOR, ({"huangtong key", "key"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "一把黄铜钥匙。\n");
        }
  
        set("is_monitored",1);
        setup();
}

// to prevent robot hold keys. mon 10/31/98
void self_dest(object me)
{
    mapping skl;
    string *skills;
    int i,j;
    
    skl = environment(me)->query_skills();
    skills  = keys(skl);
    if(!me) return;
    if(!environment(me)) return;
    j = sizeof(skl);                                    
    if(userp(environment(me)) && skl && sizeof(skl)>0){        //加入对故意拿着钥匙不开门的惩罚，每项skills降一级
        for(i=0; i<j; i++)                                             
                environment(me)->set_skill(skills[i], skl[skills[i]]-1);                                   
        tell_object(environment(me),name()+"带在身上时间过长，耽误了人参果大会的正常召开，系统给予你相应的惩罚。\n");
    }
    tell_object(environment(me),name()+
            "落在地上，不见了。\n");
    destruct(me);
}
void announce(object who)
{
    if(!this_object()) return;
    if(!who) return;
    CHANNEL_D->do_channel(this_object(), "rumor", 
            who->query("name")+"得到了"+name()+"！\n");
}

void tip(object me)               //加入时间限制提示
{
    if(!me) return;
    if(!environment(me)) return;
    CHANNEL_D->do_channel(me, "rumor", "距离人参果大会的召开截止时间还差1分钟。\n");
}

void init()
{
        remove_call_out("tip");
    call_out("tip",1740,this_object());
    call_out("self_dest",1800,this_object());
    remove_call_out("announce");
    call_out("announce",random(10),this_player());
}


