//红酒
//junhyun@SK
#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("波缇娜82", ({"portinas", "hongjiu", "jiu"}));
        set_weight(700);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一瓶上好的82年份波缇娜红酒。\n");
                set("unit", "瓶");
                set("value", 50);
                set("max_liquid", 15);
        }

        // because a container can contain different liquid
        // we set it to contain wine at the beginning
        set("liquid", ([
                "type": "alcohol",
                "name": "波缇娜红酒",
                "remaining": 15,
                "drunk_apply": 5,
        ]));
}

