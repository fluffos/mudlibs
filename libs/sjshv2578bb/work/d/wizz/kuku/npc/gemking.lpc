// /d/wizz/kuku/npc/gemking.c
// Created by kuku 2003.10.24 
      
inherit NPC; 
#include <ansi.h> 

int ask_number();
int ask_gold();
int ask_jobgift();
int ask_gift();

void create() 
{ 
	set_name( HIW "宝石尊" NOR, ({"gem king","king"})); 
        set("title",HIR+"(十大名尊之)"+NOR);  
        set("long", "一位风度翩翩、仙风道骨的老者。\n");  
        set("gender", "男性");  
        set("attitude", "peaceful"); 
        set("class", "xian"); 
        set("age", 46); 
        set("str", 40+random(10)); 
        set("int", 30); 
        set("per", 30+random(4)); 
        set("con", 20); 
        set("max_kee", 50000);    
        set("max_sen", 50000);     
        set("kee", 50000);   
        set("sen", 50000);    
        set("max_force", 30000);   
        set("force", 30000);  
        set("force_factor", 450);  
        set("max_mana", 30000);   
        set("mana", 30000);   
        set("mana_factor", 450);  
        set("combat_exp", 15000000);   
        set("daoxing", 15000000);   
    
  	set("chat_chance",5); 
        set("chat_msg", ({ 
              CYN"宝石尊说道: 有卖宝石的吗？\n"NOR, 
              CYN"宝石尊说道: 本处大量收购宝石。\n"NOR, 
              CYN"宝石尊说道: 如果卖的数量够多，还可以得到额外的好处喔。\n"NOR, 
        })); 

  	set("inquiry", ([
    		"宝石": "来吧，来吧，只要你有宝石我都收购的。\n",
     		"数量" : (: ask_number:),
     		"gold" : (: ask_gold:),
     		"任务奖励" : (: ask_jobgift:),
     		"奖励" : (: ask_gift:),
    	]));
         
        setup(); 
         
        carry_object("/d/obj/cloth/linen")->wear();   
        carry_object("/d/obj/weapon/sword/qinghong")->wield();   
} 

int accept_object(object who, object ob)
{
        int  i;
     
        i=ob->query("b_lvl");
        
        if(!i){
            command("say 我这里只收购宝石。\n");
            return 0;
        }
        if( ob->is_character()){
            command("say 我这里只收购宝石。\n");
            return 0;
        }
        if(i<8){
        	who->add("sell_gem/number",1); 
        	who->add("sell_gem/onelevel",1);
        	who->add("sell_gem/gold_temp_num",1);
        	who->add("sell_gem/gift_temp_num",1);
        }
        else if(i<15){
        	who->add("sell_gem/number",3);  
        	who->add("sell_gem/twolevel",1);    
        	who->add("sell_gem/gold_temp_num",3);  
        	who->add("sell_gem/gift_temp_num",3);
        }  	   
        else if(i<22){
        	who->add("sell_gem/number",10);  
        	who->add("sell_gem/threelevel",1);
        	who->add("sell_gem/gold_temp_num",10);
        	who->add("sell_gem/gift_temp_num",10);
        }
        else if(i<29){
        	who->add("sell_gem/number",30);
        	who->add("sell_gem/fourlevel",1);
        	who->add("sell_gem/gold_temp_num",30);
        	who->add("sell_gem/gift_temp_num",30);
        }	
        else{
        	who->add("sell_gem/number",90);        
        	who->add("sell_gem/fivelevel",1);    
        	who->add("sell_gem/gold_temp_num",90); 
        	who->add("sell_gem/gift_temp_num",90);
        }
        who->start_busy(2); 
        command("say 不错，继续加油哦。愿你好梦成真!\n");  
        return 1;
}

int ask_number()
{
	object me = this_object();
	object who = this_player();
		       
        if(!who->query("sell_gem") ){  
                command("say 到目前为止你还没卖过宝石。\n");  
                return 1;
        } 
        if(who->query("sell_gem/number")>=150000)
        	who->delete("sell_gem");
	
	command("say 你目前给了我：\n"
		 +who->query("sell_gem/onelevel")+"个一级的宝石，\n"
	         +who->query("sell_gem/twolevel")+"个二级的宝石，\n"
	         +who->query("sell_gem/threelevel")+"个三级的宝石，\n"
	         +who->query("sell_gem/fourlevel")+"个四级的宝石，\n"
	         +who->query("sell_gem/fivelevel")+"个终级的宝石，\n"
	         +"合计"+who->query("sell_gem/number")+"个宝石。\n");  	
	return 1;
}

int ask_gold()
{
	int i;
	object me = this_object();
	object who = this_player();
	
	i=who->query("sell_gem/gold_temp_num");
			       
        if(i<200 ){  
                command("say 你卖的宝石数量不够呀，等你卖够了再来领吧。\n");  
                return 1;
        }        
	who->add("balance",1000000);
	who->add("sell_gem/gold_temp_num",-200);
	command("say 你还可以领"+(i/200-1)+"次gold奖励。\n");
	command("say 恭喜恭喜！你得到了100两黄金。\n");
	return 1;
}

int ask_jobgift()
{
	int i,j;
	object me = this_object();
	object who = this_player();
	
	i=who->query("sell_gem/number");
	j=who->query("sell_gem/gem_old_num");
			       
        if(i<10000 ){  
                command("say 你卖的宝石数量不够呀，等你卖够了再来领吧。\n");  
                return 1;
        } 
        
        if(j){
        	if( i<(j+10) ){
        		command("say 再给我点宝石吧。\n");
        		return 1;
        	}
        }
        	
        if(who->query("sell_gem/ask_jobgift_time") && (who->query("sell_gem/ask_jobgift_time")+(12*60*60))>time()){ 
        	command("say 这么快又来要呀？还没到时间呢，等等再来。\n");
        	return 1;
        }          	
        
	who->set("sell_gem/ask_jobgift_time",time());
	who->set("sell_gem/gem_old_num",who->query("sell_gem/number"));	
	command("say 奖励时间持续一个小时，半天后可以再来。\n");
	return 1;
}

int ask_gift()
{
	int i;
	object me = this_object();
	object who = this_player();
	
	i=who->query("sell_gem/gift_temp_num");
			       
        if(i<20000 ){  
                command("say 你卖的宝石数量不够呀，等你卖够了再来领吧。\n");  
                return 1;
        } 	
	who->add("combat_exp",2000000);
	who->add("daoxing",2000000);
	who->add("potential",2000000);
	who->add("sell_gem/gift_temp_num",-20000);
	command("say 你还可以领"+(i/20000-1)+"次武学、道行和潜能的奖励。\n");
	command("say 恭喜恭喜！你得到了2000000点武学、2000年道行和2000000点潜能的奖励！\n");
	return 1;
}
		 		
void die()
{
	if (environment())
    	message("sound", "宝石尊「唉」的一声叹了口气！\n", environment());

	set("eff_kee", 10000);
  	set("eff_gin", 10000);
  	set("eff_sen", 10000);
  	set("kee", 10000);
  	set("gin", 10000);
  	set("sen", 10000);
  	set("force", 10000);
  	set("mana", 10000);
}

void unconcious()
{
	die ();
}
