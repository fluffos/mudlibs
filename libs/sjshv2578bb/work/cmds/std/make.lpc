      message_vision(HIM "$N无意中配出了" + ob->query("name") + "。\n" NOR, me);
      me->add("sen", -20);
      me->add("force", -50);
      me->start_busy(3);
      break;
    case "juhundan":
      if (!present("moli gen", me) || !present("dimai zizhi", me) || !present("mogui hua", me)
        || !present(
          "xiong huang",
          me
        ) || !present("lingshi xianru", me) || !present("tianxin shi", me)
        || !present("ling zhi", me))
        return notify_fail("你的药材不齐全。\n");
