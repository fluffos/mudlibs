        return notify_fail("你的药材不齐全。\n");
      if (lv < 600)
        return notify_fail("你的医术不足以制出这种药。\n");
      if (random(100) == 1) {
        ob1 = present("moli gen", me);
        ob2 = present("changsheng guo", me);
        ob3 = present("dimai zizhi", me);
