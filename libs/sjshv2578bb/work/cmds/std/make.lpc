void done(object me) {
  int i;
  object *inv;
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("done"))
      destruct(inv[i]);
  }
  message_vision(HIC "只见$N驱真气于药材之上，不多会药材便消失了。\n" NOR, me);
  me->start_busy(6);
  return;
}

int help(object me) {
  write(@HELP
指令格式 : make <药品名称>
           
这个指令是医师职业用来制药的命令。 

HELP
  );
  return 1;
}
