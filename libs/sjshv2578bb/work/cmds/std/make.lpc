      me->add("force", -50);
      me->start_busy(3);
      break;
    case "xuming":
      if (!present(
        "qiannian roufo",
        me
      ) || !present("wujing gen", me) || !present("yanwang teng", me)
        || !present("zhu guo", me) || !present("kongqing shiru", me))
        return notify_fail("你的药材不齐全。\n");
      if (lv < 400)
        return notify_fail("你的医术不足以制出这种药。\n");
      ob1 = present("qiannian roufo", me);
      ob2 = present("wujing gen", me);
      ob3 = present("yanwang teng", me);
