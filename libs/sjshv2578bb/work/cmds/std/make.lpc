      me->add("sen", -20);
      me->add("force", -50);
      me->start_busy(3);
      break;
    case "huxindan":
      if (!present("dimai zizhi", me) || !present("wujing gen", me) || !present("heshou wu", me)
        || !present(
          "bing shen",
          me
        ) || !present("qiannian roufo", me) || !present("huangxian lu", me)
        || !present("xiong huang", me))
        return notify_fail("你的药材不齐全。\n");
      if (lv < 600)
        return notify_fail("你的医术不足以制出这种药。\n");
      ob1 = present("dimai zizhi", me);
      ob2 = present("wujing gen", me);
      ob3 = present("heshou wu", me);
      ob4 = present("bing shen", me);
      ob5 = present("qiannian roufo", me);
      ob6 = present("huangxian lu", me);
      ob7 = present("xiong huang", me);
      ob1->set("done", 1);
      ob2->set("done", 1);
      ob3->set("done", 1);
      ob4->set("done", 1);
      ob5->set("done", 1);
      ob6->set("done", 1);
      ob7->set("done", 1);
      done(me);
      ob = new("/d/quest/occupation/medical/yao/huxindan");
      ob->move(me);
      message_vision(HIM "$N无意中配出了" + ob->query("name") + "。\n" NOR, me);
      me->add("sen", -20);
      me->add("force", -50);
      me->start_busy(3);
      break;
    case "bilingdan":
      if (!present("xiong dan", me) || !present("changsheng guo", me) || !present("yin guo", me)
        || !present(
          "kongqing shiru",
          me
        ) || !present("tianxin shi", me) || !present("huangxian lu", me)
        || !present("tongtian cao", me))
        return notify_fail("你的药材不齐全。\n");
      if (lv < 600)
