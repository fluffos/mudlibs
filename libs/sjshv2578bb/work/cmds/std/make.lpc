      ob3 = present("dimai zizhi", me);
      ob4 = present("moli gen", me);
      ob5 = present("bing shen", me);
      ob6 = present("huangxian lu", me);
      ob7 = present("yanwang teng", me);
      ob1->set("done", 1);
      ob2->set("done", 1);
      ob3->set("done", 1);
      ob4->set("done", 1);
      ob5->set("done", 1);
      ob6->set("done", 1);
      ob7->set("done", 1);
      done(me);
      ob = new("/d/quest/occupation/medical/yao/qiongjiang");
      ob->move(me);
      message_vision(HIM "$N无意中配出了" + ob->query("name") + "。\n" NOR, me);
      me->add("sen", -20);
      me->add("force", -50);
      me->start_busy(3);
      break;
    case "zaizaodan":
      if (!present(
        "changsheng guo",
        me
      ) || !present("lingshi xianru", me) || !present("wujing gen", me)
        || !present("qiannian roufo", me) || !present("zhu guo", me) || !present("jinsha lan", me)
        || !present("yuanhan cao", me))
        return notify_fail("你的药材不齐全。\n");
      if (lv < 600)
        return notify_fail("你的医术不足以制出这种药。\n");
      ob1 = present("changsheng guo", me);
      ob2 = present("lingshi xianru", me);
      ob3 = present("wujing gen", me);
      ob4 = present("qiannian roufo", me);
      ob5 = present("zhu guo", me);
      ob6 = present("jinsha lan", me);
      ob7 = present("yuanhan cao", me);
      ob1->set("done", 1);
      ob2->set("done", 1);
