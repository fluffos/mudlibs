      ob1 = present("xiong dan", me);
      ob2 = present("changsheng guo", me);
      ob3 = present("yin guo", me);
      ob4 = present("kongqing shiru", me);
      ob5 = present("tianxin shi", me);
      ob6 = present("huangxian lu", me);
      ob7 = present("tongtian cao", me);
      ob1->set("done", 1);
      ob2->set("done", 1);
      ob3->set("done", 1);
      ob4->set("done", 1);
      ob5->set("done", 1);
      ob6->set("done", 1);
      ob7->set("done", 1);
      done(me);
      ob = new("/d/quest/occupation/medical/yao/bilingdan");
      ob->move(me);
      message_vision(HIM "$N无意中配出了" + ob->query("name") + "。\n" NOR, me);
      me->add("sen", -20);
      me->add("force", -50);
