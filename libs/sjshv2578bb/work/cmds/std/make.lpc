//make.c

#include <ansi.h>

void done(object me);
int main(object me, string arg) {
  object ob, ob1, ob2, ob3, ob4, ob5, ob6, ob7;
  int lv;
  lv = me->query_skill("medical", 1);

  seteuid(getuid());

  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");

  if (!arg)
    return notify_fail("你要制什么药？\n");

  if (!me->query("occupation") || me->query("occupation") != "医师")
    return notify_fail("只有医师才能制药。\n");

  if (me->query("sen") <= 50)
    return notify_fail("你现在太累了，休息休息吧！\n");

  if (me->query("force") < 50)
    return notify_fail("你的真气不够，不能做什么了。\n");

  if (me->is_fighting())
    return notify_fail("你正在战斗，制什么药啊？\n");
  if (me->is_busy() || me->query_temp("pending/exercising"))
    return notify_fail("你正忙着呢，没时间制药。\n");

  switch (arg) {
    case "xionghuang":
      if (!present("xiong huang", me) || !present("tongtian cao", me))
        return notify_fail("你的药材不齐全。\n");
      ob1 = present("xiong huang", me);
      ob2 = present("tongtian cao", me);
      ob1->set("done", 1);
      ob2->set("done", 1);
      done(me);
      ob = new("/d/quest/occupation/medical/yao/xionghuang");
      ob->move(me);
      message_vision(HIM "$N无意中配出了" + ob->query("name") + "。\n" NOR, me);
      me->add("sen", -20);
      me->add("force", -50);
      me->start_busy(3);
      break;
    case "jinyuansan":
      if (!present("jinsha lan", me) || !present("yanwang teng", me))
        return notify_fail("你的药材不齐全。\n");
      ob1 = present("jinsha lan", me);
      ob2 = present("yanwang teng", me);
      ob1->set("done", 1);
      ob2->set("done", 1);
      done(me);
      ob = new("/d/quest/occupation/medical/yao/jinyuansan");
      ob->move(me);
      message_vision(HIM "$N无意中配出了" + ob->query("name") + "。\n" NOR, me);
      me->add("sen", -20);
      me->add("force", -50);
      me->start_busy(3);
      break;
    case "wulongdan":
      if (!present("yuanhan cao", me) || !present("ling zhi", me) || !present("wujing gen", me))
        return notify_fail("你的药材不齐全。\n");
      if (lv < 200)
        return notify_fail("你的医术不足以制出这种药。\n");
      ob1 = present("yuanhan cao", me);
      ob2 = present("ling zhi", me);
      ob3 = present("wujing gen", me);
      ob1->set("done", 1);
      ob2->set("done", 1);
      ob3->set("done", 1);
      done(me);
      ob = new("/d/quest/occupation/medical/yao/wulongdan");
      ob->move(me);
      message_vision(HIM "$N无意中配出了" + ob->query("name") + "。\n" NOR, me);
      me->add("sen", -20);
      me->add("force", -50);
      me->start_busy(3);
      break;
