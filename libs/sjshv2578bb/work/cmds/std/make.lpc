        || !present("tianxin shi", me) || !present("tongtian cao", me))
        return notify_fail("你的药材不齐全。\n");
      if (lv < 400)
        return notify_fail("你的医术不足以制出这种药。\n");
      ob1 = present("zhu guo", me);
      ob2 = present("bing shen", me);
      ob3 = present("ling zhi", me);
      ob4 = present("tianxin shi", me);
      ob5 = present("tongtian cao", me);
      ob1->set("done", 1);
      ob2->set("done", 1);
      ob3->set("done", 1);
      ob4->set("done", 1);
      ob5->set("done", 1);
      done(me);
      ob = new("/d/quest/occupation/medical/yao/xiaohuandan");
      ob->move(me);
      message_vision(HIM "$N无意中配出了" + ob->query("name") + "。\n" NOR, me);
      me->add("sen", -20);
      me->add("force", -50);
      me->start_busy(3);
      break;
    case "jiuhua":
      if (!present("huangxian lu", me) || !present("jinsha lan", me) || !present("mogui hua", me)
        || !present("yuanhan cao", me) || !present("qiannian xuelian", me))
        return notify_fail("你的药材不齐全。\n");
      if (lv < 400)
        return notify_fail("你的医术不足以制出这种药。\n");
      ob1 = present("huangxian lu", me);
      ob2 = present("jinsha lan", me);
      ob3 = present("mogui hua", me);
      ob4 = present("yuanhan cao", me);
      ob5 = present("qiannian xuelian", me);
      ob1->set("done", 1);
      ob2->set("done", 1);
      ob3->set("done", 1);
      ob4->set("done", 1);
      ob5->set("done", 1);
      done(me);
      ob = new("/d/quest/occupation/medical/yao/jiuhua");
      ob->move(me);
      message_vision(HIM "$N无意中配出了" + ob->query("name") + "。\n" NOR, me);
