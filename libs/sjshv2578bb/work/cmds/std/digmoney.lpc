#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object room, ob, guai, tu;
  mapping baobiao_path;
  int value, level, number;

  tu = present("cangbao tu", me);
  if (me->is_busy()) return notify_fail("你正忙着呢！\n");
  room = environment(me);
  message_vision(HIY "正所谓人为财死，鸟为食亡，$N开始疯狂的挖掘是否有人埋了钱财在路上！\n" NOR, me);
  me->receive_damage("kee", random(50) + 100);

  if (!(baobiao_path = room->query("dig_money"))) return 1;
  if (!mapp(baobiao_path)) return 1;

  if (!(value = baobiao_path["value"])) return 1;
  if (!(number = baobiao_path["number"])) return 1;
  if (random(3) == 0) {
    room->delete("dig_money");
    level = random(10);
    if (level < 5) level = 1;
    else if (level < 8) level = 2;
    else level = 3;
    guai = new("/d/quest/digmoney/guai");
    guai->invocation(me, level);
    guai->move(room);
    message_vision("\n" + guai->query("name") + "突然跳了出来......,叫道：拿命来。\n", me);
    guai->kill_ob(me);
    if (tu)
      destruct(tu);
    if (guai && room != environment(me))
      call_out("check_time", 1, me, guai);
  } else if (random(3) == 1) {
    room->delete("dig_money");
    ob = new("/obj/money/gold");
    if (!ob) return 1;
    message_vision(CYN "突然，火星四射，被$N挖到了一罐财宝！仔细一看，竟然是" + chinese_number(value) + "两黄金！\n" NOR, me);
    ob->set_amount(value);
    ob->move(room);
    if (tu)
      destruct(tu);
  } else {
    room->delete("dig_money");
    ob = new("/d/quest/baoshi/baoshi");
    if (!ob) return 1;
    if (ob->query("b_lvl") < 15) {
      message_vision(CYN "突然，火星四射，被$N挖到了一罐财宝！仔细一看，竟然是一个" + ob->name() + "！\n" NOR, me);
      ob->move(room);
    } else
      message_vision(CYN "$N挖了半天什么也没挖到，不禁失望至极。\n" NOR, me);
    if (tu)
      destruct(tu);
  }
  "/adm/daemons/ran_moneyd"->del_log("" + number);
  return 1;
}

int check_time(object me, object guai) {
  object room = environment(guai);

  message_vision(HIR "不好，妖怪的老巢被$N挖塌了！\n" NOR, me);
  message(
    "channel:chat",
    YEL "【小道消息】店小二：不好，妖怪的老巢被" + me->query("name") + "挖塌了，大家快去" + room->query("short") + "杀妖怪呀！\n" NOR,
    users()
  );

  return 1;
}
