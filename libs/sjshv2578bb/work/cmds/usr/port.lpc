// [1;31m此文件禁止随意移动和更改[0m
// CMDS /cmds/usr/port.c 端口使用状态文件
// Update by waiwai@2001/07/29

#include <ansi.h>
#include <mudlib.h>

inherit F_CLEAN_UP;

int main(object me) {
  object *ob;
  string str;
  int i, p1, p2, wiz_p;

  ob = filter_array(children(USER_OB), (: userp :));

  str = CHINESE_MUD_NAME + "『" BYEL "" HIW " " + CHINESE_SERVER_SITE + " " NOR "』端口使用情况：" NOR;
  for (i = 0; i < sizeof(ob); i++) {
    if (!environment(ob[i])) continue;
    // 去除巫师隐身显示
    if (wizardp(ob[i]) && ob[i]->query("env/invisibility")) continue;
    if (query_ip_port(ob[i]) == 6666) p1++;
    if (query_ip_port(ob[i]) == 8888) p2++;
  }
  str += sprintf(YEL "6666：%2d人│8888：%2d人" NOR, p1, p2);

  write(str + "\n");
  return 1;
}

int help(object me) {
  write(@HELP

指令格式：port

查看目前游戏中各端口的连线使用情况。请选择使用率较低的端口连线。

HELP
  );
  return 1;
}
