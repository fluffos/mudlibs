#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        int gift_points,used_gift_points,count;
        string target;
        object cake;
        cake=present("cake",me);
        if( !arg ) return notify_fail("你要分配到哪个参数上？\n");
        if( sscanf(arg, "%s %d", target, used_gift_points)!=2 )
                return notify_fail("你要分配到哪个参数上？\n");

        gift_points = me->query("gift_points");
        if( gift_points <=0 )
        return notify_fail("你现在没有参数点。\n");

        if(me->is_busy())
        return notify_fail("你上个动作还没完成。\n");
        switch (target) {
        case "武学" :
        case "exp" :
                        if(used_gift_points>me->query("gift_points"))
                                return notify_fail("你现在的可分配点数不够。\n");
                        if(used_gift_points>500000)
                                return notify_fail("武学的分配点数最高50万。\n");
                        me->add("used_gift_points",used_gift_points);
                        me->add("gift_points",-used_gift_points);
                        me->add("combat_exp",used_gift_points);
                        break;
        case "道行" :
        case "dx" :
                    if(used_gift_points>me->query("gift_points"))
                        return notify_fail("你现在的可分配点数不够。\n");
                    if(used_gift_points >500000)
                        return notify_fail("道行的分配点数最高50万。\n");
                    me->add("used_gift_points",used_gift_points);
                    me->add("gift_points",-used_gift_points);
                        me->add("daoxing",used_gift_points);
                    break;
        case "潜能" :
        case "qn" :
                    if(used_gift_points>me->query("gift_points"))
                        return notify_fail("你现在的可分配点数不够。\n");
                    if(used_gift_points >300000)
                        return notify_fail("潜能的分配点数最高30万。\n");
                if(me->query("qn_fenpei"))
                        return notify_fail("你已经分过潜能了。\n");
                    me->add("used_gift_points",used_gift_points);
                    me->add("gift_points",-used_gift_points);
                        me->add("potential",used_gift_points);
                me->add("qn_fenpei",1);
                    break;
        default :
                tell_object(me,"命令格式fenpei exp(dx,qn) 点数。\n");
                return 1;
        }
        write("Ok！成功分配完成！\n");
        
        if(!me->query("lucky/goldgift")){
                if(random(100)>95){
                        count=4000000+random(1000000);
                        me->add("balance",count);
                        me->add("lucky/goldgift",1);
                        tell_object(me, HIY"恭喜恭喜，你得到了"+count/10000+"两黄金的飞来横财。祝你中秋快乐！\n"NOR); 
                }               
                else if(random(100)>85){
                        count=3000000+random(1000000);
                        me->add("balance",count);
                        me->add("lucky/goldgift",1);
                        tell_object(me, HIY"恭喜恭喜，你得到了"+count/10000+"两黄金的飞来横财。祝你中秋快乐！\n"NOR); 
                }
                else if(random(100)>75){
                        count=2000000+random(1000000);
                        me->add("balance",count);
                        me->add("lucky/goldgift",1);
                        tell_object(me, HIY"恭喜恭喜，你得到了"+count/10000+"两黄金的飞来横财。祝你中秋快乐！\n"NOR); 
                }
                else if(random(100)>60){
                        count=1000000+random(1000000);
                        me->add("balance",count);
                        me->add("lucky/goldgift",1);
                        tell_object(me, HIY"恭喜恭喜，你得到了"+count/10000+"两黄金的飞来横财。祝你中秋快乐！\n"NOR); 
                }
                else{
                        count=random(1000000);
                        me->add("balance",count);
                        me->add("lucky/goldgift",1);
                        tell_object(me, HIY"恭喜恭喜，你得到了"+count/10000+"两黄金的飞来横财。祝你中秋快乐！\n"NOR); 
                }
        }
        me->save();
        me->start_busy(2);
        if(me->query("gift_points")==0){
                if(cake)
                        destruct(cake);
        }
        return 1;
}

int help(object me)
{
        write(@HELP

指令格式 : fenpei <个人参数>
这个指令可以让你将参数点分配到你指定的参数上。参数点
一但分配掉，将永远不可更改。

fenpei 武学 100，将100点参数点分配到武学上。

如不可输入中文，可用字母代替。
武学 exp        道行 dx
潜能 qn        

HELP
        );
        return 1;
}
