#include <ansi.h> 
#include <combat.h>
inherit F_CLEAN_UP; 
inherit UPEXP_D;
 
string chinese_daoxing(int gain); 
string status_color(int current, int max); 
 
int main(object me, string arg) 
{ 
        object ob,weapon; 
        mapping my; 
        int dao,x,i,sec, min, hrs, day, mon, age,upexp,attack_points, dodge_points, parry_points;
        string str,out_str,skill_type; 
        seteuid(getuid(me)); 
        
        age = (int)me->query("mud_age");                
        sec = age % 60;
        age /= 60;
        min = age % 60;
        age /= 60;
        hrs = age % 24;
        age /= 24;
        day = age % 30;
        mon = age / 30;
        
        out_str = (mon? chinese_number(mon)+"月":"")
                + (day? chinese_number(day)+"天":"")
                + (hrs? chinese_number(hrs)+"小时":"");
 
        if(!arg) ob = me; 
        else if (wizardp(me)) { ob = present(arg, environment(me)); 
             if (!ob) ob = find_player(arg); 
             if (!ob) ob = find_living(arg); 
        if (!ob) return notify_fail("您要察看谁的状态？\n"); 
        }  
                else return notify_fail("只有巫师才可以察看别人的状态。\n"); 
 
        my = ob->query_entire_dbase(); 
        upexp=exp[my["level"]]-my["combat_exp"];
        attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK); 
        parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE); 
        dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE); 
 
        printf(NOR CYN"┏━━━━━━━━━━━━━"HIY"三"HIR"·"HIY"界"HIR"·"HIY"神"HIR"·"HIY"话"NOR CYN"━━━━━━━━━━━━━┓\n"NOR,); 
        printf(NOR CYN"┃"NOR WHT" 个人状态"NOR CYN" 姓 名："NOR WHT"%-12s "NOR CYN" 性别："NOR WHT"%-10s "NOR CYN"I D："NOR WHT"%-13s"NOR CYN"┃\n"NOR,ob->name(),ob->query("gender"),"["+capitalize(ob->query("id"))+"]"); 
        printf(NOR CYN"┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n"NOR); 
        printf(NOR CYN"┃"NOR WHT"〖 气血 〗%s%7-d/%8-d%s[%3d%%]"NOR,status_color(my["kee"],my["eff_kee"]),my["kee"],my["eff_kee"],status_color(my["eff_kee"],my["max_kee"]),my["eff_kee"]*100/my["max_kee"]); 
        printf(NOR WHT"  〖 内力 〗%s%7-d/%7-d(+%4d)"NOR CYN"┃\n"NOR,status_color(my["force"], my["max_force"]), my["force"], my["max_force"],my["force_factor"]); 
        printf(NOR CYN"┃"NOR WHT"〖 精神 〗%s%7-d/%8-d%s[%3d%%]"NOR,status_color(my["sen"],my["eff_sen"]),my["sen"],my["eff_sen"],status_color(my["eff_sen"],my["max_sen"]),my["eff_sen"]*100/my["max_sen"]); 
        printf(NOR WHT"  〖 法力 〗%s%7-d/%7-d(+%4d)"NOR CYN"┃\n"NOR,status_color(my["mana"], my["max_mana"]), my["mana"], my["max_mana"],my["mana_factor"]); 
        if(my["food"]*100/ob->max_food_capacity()>100) str=HIC+"很饱"; 
        else if(my["food"]*100/ob->max_food_capacity()>90) str=HIG+"正常"; 
        else if(my["food"]*100/ob->max_food_capacity()>60) str=HIY+"缺食";         
                else if(my["food"]*100/ob->max_food_capacity()>30) str=CYN+"缺食"; 
        else if(my["food"]*100/ob->max_food_capacity()>10) str=HIR+"缺食"; 
        else str=RED+"饥饿"; 
        printf(NOR CYN"┃"NOR WHT"〖 食物 〗%s%7-d/%7-d [%4s%s]"NOR,status_color(my["food"], ob->max_food_capacity()), 
        my["food"], ob->max_food_capacity(),str,status_color(my["food"], ob->max_food_capacity()));
        //Add by kuku@2004/04/24  潜能上限设置，加入百分比显示
//        if(ob->query("potential") > ob->query("opotential")+ob->query("level")*10000)
//                ob->set("potential",ob->query("opotential")+ob->query("level")*10000);
//             printf(NOR WHT"  〖 潜能 〗%s%7-d/%7-d (%3d%%)"NOR CYN"┃\n"NOR,HIC,(int)ob->query("potential") - (int)ob->query("learned_points"),ob->query("opotential")+ob->query("level")*10000,(ob->query("potential") - ob->query("learned_points"))*100/(1+ob->query("opotential")+ob->query("level")*10000));  
             printf(NOR WHT"  〖 潜能 〗%s%14-d "NOR CYN"       ┃\n"NOR,HIG,(int)ob->query("potential") - (int)ob->query("learned_points"));  

        if(my["water"]*100/ob->max_water_capacity()>100) str=HIC+"很饱"; 
        else if(my["water"]*100/ob->max_water_capacity()>90) str=HIG+"正常"; 
        else if(my["water"]*100/ob->max_water_capacity()>60) str=HIY+"缺水"; 
        else if(my["water"]*100/ob->max_water_capacity()>30) str=CYN+"缺水"; 
        else if(my["water"]*100/ob->max_water_capacity()>10) str=HIR+"缺水"; 
        else str=RED+"饥渴"; 
         printf(NOR CYN"┃"NOR WHT"〖 饮水 〗%s%7-d/%7-d [%4s%s]"NOR,status_color(my["water"], ob->max_water_capacity()), 
        my["water"], ob->max_water_capacity(),str,status_color(my["water"], ob->max_water_capacity())); 
                if((int)ob->query("combat_exp")>=160000000)
        printf(NOR WHT"  〖 等级 〗%s%14-s        " NOR CYN"┃\n"NOR,HIR,"95(极限)");
        else
        printf(NOR WHT"  〖 等级 〗"+UPEXP_D->query_upexp(ob)+HIR"     /""%14-d"  NOR CYN"┃\n"NOR,upexp);  
//Add by kuku@2004/04/24  杀气上限设置，加入百分比显示(和天性有关)
        if(ob->query("bellicosity") > ob->query("obellicosity")+20*ob->query("level"))
                ob->set("bellicosity",ob->query("obellicosity")+20*ob->query("level"));
        printf(NOR CYN"┃"NOR WHT"〖 杀气 〗%s%7-d/%7-d [%3d%%]"NOR,HIR,ob->query("bellicosity"),ob->query("obellicosity")+20*ob->query("level"),ob->query("bellicosity")*100/(1+ob->query("obellicosity")+20*ob->query("level")) ); 
        printf(NOR WHT"  〖 武学 〗%s%18-d    "NOR CYN"┃\n"HIG,HIY,(int)ob->query("combat_exp"));
        if(ob->query("wuxing"))
        printf(NOR CYN"┃"NOR WHT"〖 五行 〗%s%46-s          " NOR CYN"┃\n"NOR,HIB,ob->query("wuxing"));  
        else
        printf(NOR CYN"┃"NOR WHT"〖 五行 〗%s%46-s          " NOR CYN"┃\n"NOR,HIB,"无");         
        dao=(int)ob->query("daoxing");
        printf(NOR CYN"┃"NOR WHT"〖 道行 〗%s%46-s          " NOR CYN"┃\n"NOR,       HIM,chinese_daoxing(dao));
                
//其他信息部分修改，将score里显示的攻击和防御数值显示在这里
        printf(NOR CYN"┣━━━━━━━━━━━━━━━其他信息━━━━━━━━━━━━━━┫\n" NOR);  
        
/*******************************************************************************/
        if(wizardp(this_player())) 
        printf("  〖 攻击 〗 " HIW "%d (+%d)" NOR "\t\t〖 防御 〗 " HIW "%d (+%d)\n" NOR,
        attack_points/100 + 1, ob->query_temp("apply/damage"),
                (dodge_points + (weapon? parry_points: 
                (parry_points/10)))/100 + 1, ob->query_temp("apply/armor"));
        else printf(" 〖兵器伤害〗 ["HIR"%d"NOR"]" NOR "\t\t〖盔甲保护〗 ["HIG"%d"NOR"]\n" NOR,
        ob->query_temp("apply/damage"),
        ob->query_temp("apply/armor"));
/*******************************************************************************/
        printf(NOR CYN"┗━━━━━━━━━━━━━"HIY"三"HIR"·"HIY"界"HIR"·"HIY"神"HIR"·"HIY"话"NOR CYN"━━━━━━━━━━━━━┛\n"NOR); 
   
        printf("\n");    
        return 1; 
} 
 
string status_color(int current, int max) 
{ 
        int percent; 
        if( max>0 ) percent = current * 100 / max; 
        else percent = 100; 
        if( percent > 100 ) return HIC; 
        if( percent >= 90 ) return HIG; 
        if( percent >= 60 ) return HIY; 
        if( percent >= 30 ) return CYN; 
        if( percent >= 10 ) return HIR; 
        return RED; 
} 
 
 
string chinese_daoxing(int gain) { 
            int year,day,hour; 
             string str; 
 
             year=gain/1000; 
             day=(gain-year*1000)/4; 
             hour=(gain-year*1000-day*4)*3; 
             str=""; 
             if(year) str=str+chinese_number(year)+"年"; 
             if(day) str=str+chinese_number(day)+"天"; 
             if(hour) str=str+chinese_number(hour)+"时辰"; 
             if(gain==0) str="未入道途"; 
             return str; 
} 
 
 
int help(object me) 
{ 
        write(@HELP 
指令格式 : hp 
           hp <对象名称>                   (巫师专用) 
  
这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。 
  
see also : score 
HELP 
    ); 
    return 1; 
}
