// Created by stey

#include <ansi.h>
inherit ROOM;
#include "banned.h"



void setup2() {

  int level, i;
  object guai;
  set("mofengroom", 1);

  if (this_object()->query("level")) level = this_object()->query("level");
  else level = random(40) + 10;

  if (this_object()->query("npc_number") > 1) {
    for (i = 0; i < this_object()->query("npc_number"); i++) {

      guai = new("/d/quest/mofeng/npc/stey/guai");
      if (objectp(guai)) {
        guai->create(level, level);
        guai->move(this_object());
      }
    }
  }

  set("alternative_die", 1);

  setup();
}

void init() {
  this_object()->init2();

  add_action("do_quit", banned_action);




}

int do_quit(string arg) {
  write("你不能在这里用这条命令。\n");
  if (wizardp(this_player()))
    write("巫师请参阅同一路径内的banned.h文档。\n");

  return 1;
}

void alternative_die(object who) {
  object killer, corpse;
  killer = who->query_temp("last_damage_from");

  if (userp(who)) {
    message_vision("$N死了。\n", who);
    who->set("kee", 100);
    who->set("sen", 100);
    if (who->query("eff_kee") < 10)
      who->set("eff_kee", 100);
    if (who->query("eff_sen") < 10)
      who->set("eff_sen", 100);

    who->dismiss_team();
    who->remove_ride();
    who->delete_temp("last_fainted_from");
    who->move("/d/quest/mofeng/enter");
    who->unconcious();
  } else {
    if (objectp(corpse = CHAR_D->make_corpse(who, killer)))
      corpse->move(this_object());
    message_vision("$N死了。\n", who);
    who->reward();
    destruct(who);
  }
}
