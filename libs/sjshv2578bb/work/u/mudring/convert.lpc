// convert.c
// By Mudring@SanJie

#include <ansi.h>
inherit F_CLEAN_UP;

int convert_file(string file)
{
    string stat;

    stat = read_file(file);
    stat = replace_string(stat, "/r", "");
    if (!write_file(file, stat, 1))
    {
        write("文件 "+ file +" 存储失败。\n");
        return 0;
    }
    return 1;
}


int main(object me, string file)
{

    if (!SECURITY_D->valid_grant(me, "(wizard)"))
        return 0;

    if (!file)
        return notify_fail("指令格式：convert <filename>.\n");

    seteuid(geteuid(me));

    file = resolve_path(me->query("cwd"), file);

    if (!SECURITY_D->valid_write(file, me, "write"))
        return notify_fail("你没有足够的读写权利。\n");

    MONITOR_D->report_adm_object_msg(me, HIR" convert " + file + "!"NOR); 
    log_file("cmds/convert", sprintf("convert %s at %s from %s.\n",
             file, log_time(), query_ip_number(me)));

    write("convert file " + file + " to Unix format ");
    me->set("cwf", file);
    SECURITY_D->backup_file(file);

    if (convert_file(file))
        write("succeed!\n");
    else
        write("failed!\n");

    return 1;
}

int help()
{
    write(@HELP

指令格式：convert <filename>.

此指令用来转换文件的格式。

HELP
    );
    return 1;
}

