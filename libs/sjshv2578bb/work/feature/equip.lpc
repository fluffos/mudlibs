//      equip.c
#include <ansi.h>
#include <dbase.h>
#include <weapon.h>
//  5  inherit "/std/save/wsave.lpc";
//Modified by kuku@SJSH  2003.12.7   加入新装备系统的控制

int wear() {
  object owner;
  mapping armor_prop, applied_prop;
  string *apply, type;
  int level;

  // Only character object can wear armors.
  if (!(owner = environment())) return 0;
  if (!owner->is_character()) return 0;

  // If already worn, just recognize it.
  if (query("equipped")) return 1;

  // Check if we have "armor_prop" defined.
  if (!mapp(armor_prop = query("armor_prop")) ||
    query("weapon_prop/damage") > 0)
    return notify_fail("你只能穿戴可当作护具的东西。\n");

  type = query("armor_type");
  if (owner->query_temp("armor/" + type))
    return notify_fail("你已经穿戴了同类型的护具了。\n");

  if (userp(owner) && !wizardp(owner)) {
    //Added by kuku@sjsh 2003/10/18
    if (query("female_only") && (string)owner->query("gender") != "女性")
      return notify_fail(HIG "这是女人的东西，你一个大男人也想用?羞也不羞？\n" NOR);

    //Added by kuku@sjsh 2003/10/18
    if ((string)owner->query("gender") != "女性" && type == "skirts")
      return notify_fail(HIG "这是女人的东西，你一个大男人也想用?羞也不羞？\n" NOR);

    //Added by kuku@2003/01/12
    level = (int)query("need_level");
    if ((int)owner->query("level") < level)
      return notify_fail("你的等级不足以装备此护具。\n");
  }

  if (query("Is_Diablo_Obj")) {
    if (query("lvl") > 2) {
      if (!query("identification"))
        return notify_fail("这件护具还没鉴定，不能使用。\n");
    }
  }


  //Added by kuku@2003/10/18
  if (query("need_class") != 0) {
    if (!owner->query("family/family_name"))
      return notify_fail("你还没拜入师门，不能装备这件护具。\n");
    if (query("need_class") > 0 && userp(owner) && !wizardp(owner)) {
      if (owner->query("family/family_name") != "方寸山三星洞"
        && owner->query("family/family_name") != "五庄观"
        && owner->query("family/family_name") != "月宫"
        && owner->query("family/family_name") != "蜀山剑派"
        && owner->query("family/family_name") != "南海普陀山"
        && owner->query("family/family_name") != "将军府"
        && owner->query("family/family_name") != "东海龙宫")
        return notify_fail("你不是仙族，不能装备这件护具。\n");
    } else if (query("need_class") < 0 && userp(owner) && !wizardp(owner)) {
      if (owner->query("family/family_name") != "大雪山"
        && owner->query("family/family_name") != "火云洞"
        && owner->query("family/family_name") != "陷空山无底洞"
        && owner->query("family/family_name") != "盘丝洞"
        && owner->query("family/family_name") != "轩辕古墓"
        && owner->query("family/family_name") != "阎罗地府"
        && owner->query("family/family_name") != "三界山")
        return notify_fail("你不是魔族，不能装备这件护具。\n");
    }
  }

  owner->set_temp("armor/" + type, this_object());
  apply = keys(armor_prop);
  applied_prop = owner->query_temp("apply");
  if (!mapp(applied_prop)) applied_prop = ([]);
  for (int i = 0; i < sizeof(apply); i++) {
    if (undefinedp(applied_prop[apply[i]])) {
      applied_prop[apply[i]] = armor_prop[apply[i]];
      if (metep(owner))  //转生后的附加值
      {
        applied_prop[apply[i]] += (armor_prop[apply[i]]) / 4;
        this_object()->set("mete_armor_prop/" + apply[i], (armor_prop[apply[i]]) / 4);
      }
    } else {

      applied_prop[apply[i]] += armor_prop[apply[i]];
      if (metep(owner))  //转生后的附加值
      {
        applied_prop[apply[i]] += (armor_prop[apply[i]]) / 4;
        this_object()->set("mete_armor_prop/" + apply[i], (armor_prop[apply[i]]) / 4);
      }
    }
  }
  owner->set_temp("apply", applied_prop);
  set("equipped", "worn");
  return 1;
}

int wield() {
  object owner, old_weapon;
  mapping weapon_prop;
  string *apply, type;
  int flag, level;

  // Only character object can wear armors.
  if (!(owner = environment()) || !owner->is_character()) return 0;

  // If already wielded, just recognize it.
  if (query("equipped")) return 1;

  // Check if we have "weapon_prop" defined.
  if (!mapp(weapon_prop = query("weapon_prop")))
    return notify_fail("你只能装备可当作武器的东西。\n");

  if (userp(owner) && !wizardp(owner)) {
    // Added by kuku@2003/10/18
    level = (int)query("need_level");
    if ((int)owner->query("level") < level)
      return notify_fail("你的等级不足以装备此武器。\n");
  }

  if (query("Is_Diablo_Obj")) {
    if (query("lvl") > 2) {
      if (!query("identification"))
        return notify_fail("这件武器还没鉴定，不能使用。\n");
    }
  }
  //内力法力限制为以后扩展预留
  // Added by kuku@2003/10/18 
  if (query("need_force") && userp(owner) && !wizardp(owner)) {
    if ((int)owner->query("max_force") < query("need_force"))
      return notify_fail("你感觉全身气息翻腾，原来你内力不够无法装备这样武器。\n");
  }

  // Added by kuku@2003/10/18
  if (query("need_mana") && userp(owner) && !wizardp(owner)) {
    if ((int)owner->query("max_mana") < query("need_mana"))
      return notify_fail("你感觉全身气息翻腾，原来你法力不够无法装备这样武器。\n");
  }

  // Added by kuku@2003/10/18
  if (query("need_str") && userp(owner) && !wizardp(owner)) {
    if ((int)owner->query_str() < query("need_str"))
      return notify_fail("你想举起这件武器，怎奈力量不够，只好作罢武器。\n");
  }
  //Added by kuku@2003/10/18
  if (query("need_class") != 0) {
    if (!owner->query("family/family_name"))
      return notify_fail("你还没拜入师门，不能装备这件兵器。\n");
    if (query("need_class") > 0 && userp(owner) && !wizardp(owner)) {
      if (owner->query("family/family_name") != "方寸山三星洞"
        && owner->query("family/family_name") != "五庄观"
        && owner->query("family/family_name") != "月宫"
        && owner->query("family/family_name") != "蜀山剑派"
        && owner->query("family/family_name") != "南海普陀山"
        && owner->query("family/family_name") != "将军府"
        && owner->query("family/family_name") != "东海龙宫")
        return notify_fail("你不是仙族，不能装备这件兵器。\n");
    } else if (query("need_class") < 0 && userp(owner) && !wizardp(owner)) {
      if (owner->query("family/family_name") != "大雪山"
        && owner->query("family/family_name") != "火云洞"
        && owner->query("family/family_name") != "陷空山无底洞"
        && owner->query("family/family_name") != "盘丝洞"
        && owner->query("family/family_name") != "轩辕古墓"
        && owner->query("family/family_name") != "阎罗地府"
        && owner->query("family/family_name") != "三界山")
        return notify_fail("你不是魔族，不能装备这件兵器。\n");
    }
  }

  flag = query("flag");

  if (flag & TWO_HANDED) {
    if (owner->query_temp("weapon")
      || owner->query_temp("secondary_weapon")
      || owner->query_temp("armor/shield"))
      return notify_fail("你必须空出双手才能装备双手武器。\n");
    owner->set_temp("weapon", this_object());
  } else {

    // If we are are using any weapon?
    if (!(old_weapon = owner->query_temp("weapon")))
      owner->set_temp("weapon", this_object());

    else  // If we still have a free hand? 
    if (!owner->query_temp("secondary_weapon")
      && !owner->query_temp("armor/shield")) {

      // If we can wield this as secondary weapon?
      if (flag & SECONDARY) {
        owner->set_temp("secondary_weapon", this_object());
        if (old_weapon->query("apply/skill_type") &&
          old_weapon->query("apply/skill_type") ==
          this_object()->query("apply/skill_type") &&
          old_weapon->query("skill_type") !=
          this_object()->query("skill_type")) {
          owner->set_temp("use_apply_action", 1);
          old_weapon->set_temp("use_apply_skill", 1);
        }

        // If we can switch our old weapon to secondary weapon ?
      } else if ((int)old_weapon->query("flag") & SECONDARY) {
        old_weapon->unequip();
        owner->set_temp("weapon", this_object());
        old_weapon->wield();

        // We need unwield our old weapon before we can use this one.
      } else
        return notify_fail("你必须先放下你目前装备的武器。\n");

      // We have both hands wearing something.
    } else
      return notify_fail("你必须空出一只手来使用武器。\n");
  }

  apply = keys(weapon_prop);
  for (int i = 0; i < sizeof(apply); i++) {
    owner->add_temp("apply/" + apply[i], weapon_prop[apply[i]]);
    if (metep(owner))  //转生后的附加攻击
    {
      owner->add_temp("apply/" + apply[i], (weapon_prop[apply[i]]) / 4);
      this_object()->set("mete_apply/" + apply[i], (weapon_prop[apply[i]]) / 4);
    }
  }
  if (owner->query_temp("use_apply_action") == 1) {
    owner->reset_apply_action();
  } else
    owner->reset_action();
  set("equipped", "wielded");
  return 1;
}

int unequip() {
  object owner, weapon;
  mapping prop, applied_prop, mete_prop;
  string *apply, equipped;

  if (!environment()) return 0;
  if (!(owner = environment())->is_character()) return 0;

  if (!stringp(equipped = query("equipped")))
    return notify_fail("你目前并没有装备这样东西。\n");

  if (equipped == "wielded") {
    if ((weapon = (object)owner->query_temp("weapon")) == this_object())
      owner->delete_temp("weapon");
    else if ((object)owner->query_temp("secondary_weapon") == this_object())
      owner->delete_temp("secondary_weapon");
    owner->delete_temp("use_apply_action");
    // added by snowcat 6/21 (ling jian)
    if (weapon)
      weapon->delete_temp("use_apply_skill");
    prop = query("weapon_prop");
    if (query("mete_apply"))
      mete_prop = query("mete_apply");
    owner->delete_temp("perf_quick");
    owner->reset_action();
  } else if (equipped == "worn") {
    owner->delete_temp("armor/" + query("armor_type"));
    prop = query("armor_prop");
    if (query("mete_armor_prop"))
      mete_prop = query("mete_armor_prop");
  }

  apply = keys(prop);
  applied_prop = owner->query_temp("apply");
  for (int i = 0; i < sizeof(apply); i++) {  // To support array apply, we cannot add_temp() here.
    applied_prop[apply[i]] -= prop[apply[i]];
    if (metep(owner) && mete_prop)
      //转生后武器攻击处理！          
      applied_prop[apply[i]] -= mete_prop[apply[i]];
  }
  delete("equipped");
  weapon = (object)owner->query_temp("secondary_weapon");
  // add by bbs, April 28.
  if (weapon) {
    weapon->unequip();
    weapon->wield();
  }
  return 1;
}
