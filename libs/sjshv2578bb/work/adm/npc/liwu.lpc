//Add by kuku@2004/02/23 去除新人礼物

inherit NPC;
#include <ansi.h>
//#include "2002.h"
int give_newbie();
int give_family();
int give_bag();
int answer_me();
int give_saozhou ();

void create()
{
	set_name("三界轮回使", ({"lun hui","lunhuishi"})); 
     	set ("long", @LONG
他是在这里负责给新手做指引的，大家可以向他要(saozhou)
来打工，开始自己的三界神话历程(ask lun hui about 扫大街)。
LONG);
        set("gender", "男性");
        set("title",HIY"欢迎光临三界神话测试分站"NOR); 
        set("age", 20);
        set("max_kee", 10000);
        set("kee", 10000);
        set("per", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("inquiry", ([

            	"bonnet"    : "这里有“金丝禅衣”，那个更好，我的天师法冠过时了，哎！",
            	"newbie"    :(:give_newbie:),
            	"gift"    :(:give_newbie:),
            	"礼物"    :(:give_newbie:),

            	"family"    :(:give_family:),
            	"门派礼物"  :(:give_family:),
		"储藏箱"  :(:give_bag:),
            	"name"      :(:answer_me:),
            	"扫大街"   : (: give_saozhou :),
]));
        setup();
        carry_object("/d/lingtai/obj/faguan")->wear();
}


int answer_me()
{
        command("say 小心我扁你！嘿嘿 。\n");
        return 1;
}


int give_newbie()
{
        object who=this_player();
        if (!userp(who)){
                command("heng");
                command("say 什么小猫小狗也来要礼物？！");
                command("qi");
                return 1;
        }

         if (who->query("combat_exp") > 50000 ){
                command("hammer "+who->query("id") );
                command("say 你都这么厉害了还差这么一点小东西么？");
                return 1;
         }

         if (this_player()->query("lll/gai") == "got" ){
         message_vision("$N对着$n哼了一声。\n",this_object(),this_player());
                command("say 新人礼物只有一份！领过就不给了！\n");
        return 1;
        }

        who->add("combat_exp",50000); 
        who->add("daoxing",50000); 
        who->add("force",800);
        who->add("mana",800);
        who->add("max_mana",1000);
        who->add("max_force",1000);
        who->add("maximum_force",1000); 
        who->add("maximum_mana",1000); 
        who->add("potential",100000);
        who->set("lucky",1);
        who->set("lll/gai","got");
message_vision("$N对着$n神秘的笑了笑，$n觉得身体发生剧烈的变化，顿时晕倒在地。\n",this_object(),this_player());
        command("tell "+who->query("id")+" 
        你的道行增加了五十年!\n
        你的武学增加了五万!\n 
        你的潜能增加了十万点。\n
        您现在有1000点内力和1000点法力，您可以在Enable没有超过上述两值的情况下不用打坐冥思。\n"); 
        command("chat 恭喜恭喜，"+who->query("name")+"得到了新人礼物！");
        return 1;
}


