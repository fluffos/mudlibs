void init()
{
    call_out("greeting", 1, this_player());
    ::init();
}

void greeting(object who) 
{
//382  if( who->query("combat_exp") < 600000) {
// Changed by mudring@sjsh
//384      if (!userp(who)) return ;
if( !who || environment(who) != environment() ) return;
if( who->query("combat_exp") < 50000) {
        tell_object(who,"三界轮回使悄悄告诉你：可以向我要门派礼物哦(ask lun hui about family)。\n");  
         }
}

int give_bag() 
{
        object newob; 
        object who=this_player();  
        if (!userp(who)){ 
            command("heng"); 
            command("say 什么小猫小狗也来要？！"); 
            return 1; 
        }
            if(who->is_busy()) {
                tell_object(who,"你正忙着呢！\n"); 
                return 1; 
             }
             if(present("chucang xiang",who)) {
                 message_vision("$N对着$n哼了一声,你已经有了。\n",this_object(),this_player()); 
                 return 1; 
               }
                newob=new("/obj/sjsh_bag"); 
                if (!objectp(newob)){
        		command("say 储藏箱一时难拿到，等等！");
        		return 1;
    		}
                newob->set("owner_id",who->query("id")); 
                if(!who->query("sjsh_bag")) { 
                	newob->save(); 
                	who->set("sjsh_bag",1); 
                	who->save(); 
            	}
                if(newob->restore()) {
                	message_vision("$N对着$n神秘的点了点头。\n$N拿出了一个"+newob->name()+"给$n。\n",this_object(),this_player()); 
                	newob->move(who); 
                	return 1;
                } 
                else{ 
                	command("say 等等，一时半会还没找到！\n"); 
                	destruct(newob); 
                	return 1;
                } 
}

int give_saozhou ()
{
    object ob;
    object who = this_player();

    if (present("sao zhou", who))
    {
        command_function("hmm");
        tell_object(who, CYN"你不是刚拿过吗，想倒卖啊？\n"NOR);
        return 1;
    }
    command_function("nod");
    ob = new("/d/quest/small/saozhou");
    ob->move(who);
    tell_object(who, WHT"三界轮回使拿出一把大扫帚给你，去扫大街吧！\n"NOR);
    tell_object(who, "你可以用(look saozhou)来获得帮助！\n");
    return 1;
}
