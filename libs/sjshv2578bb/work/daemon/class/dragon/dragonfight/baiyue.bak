//卧龙拜月
//by junhyun@SK
#include <ansi.h>
#include <combat.h>
void baiyue_ok(object);
inherit SSERVER;
int calculate_damage(object me, object target, int base_damage, int damge_bonus);

int perform(object me, object target)
{       
        string msg="";
        int damage,wound,k,damage_bonus,mystr;
        object weapon=me->query_temp("weapon");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("【卧龙拜月】不是拿来玩的！\n");

        if(!me->is_fighting())
                return notify_fail("【卧龙拜月】只能在战斗中使用！\n");
        
                   
        if (me->query_skill_mapped("force")!="dragonforce")
                return notify_fail("【卧龙拜月】必须以龙神心法为根基！\n");
                
        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 300 )
                return notify_fail("你的精神状态太差了，不能驾驭飞龙！\n");
        if((int)me->query("kee") < 200 )
                return notify_fail("你的气血太少了，弄不好反会被飞龙吞噬！\n");
        if((int)me->query_skill("dragonforce", 1) < 100)
                return notify_fail("你的龙神心法修为还不够不能用【卧龙拜月】！\n");
        if((int)me->query_skill("dragonfight", 1) < 200)
                  return notify_fail("你的龙形搏击修为还不够，恐怕不能使用【卧龙拜月】！\n");
                if(me->query_temp("no_baiyue"))
                return notify_fail("你是耍把式的？\n");
               mystr=me->query_str()*2;

              k=(int)me->query_skill("unarmed");
              damage_bonus=k;
              damage_bonus=mystr*(damage_bonus+100+me->query("force_factor"))/200;
        message_vision(HIW"
$N虚晃一拳，跳出战圈，积蓄内力，回身一招【卧龙拜月】澎湃而出！\n\n"NOR,me,target);
                     
                        if (random((int)me->query("per"))<5 || random((int)target->query("daoxing")) > ((int)me->query("daoxing"))) 
                                                    {
        message_vision(HIG"$n被$N的内力一逼，胸口一阵窒息，急忙向一旁躲开！\n"NOR,me,target);

                                }
                                 else {
                        msg +=HIW "$N向前一步踏出，左掌虚空划了一个圆圈，右掌从左掌
下穿出直拍$n前胸，招式虽然平常，却蕴含无尽内力！\n";
                        damage=calculate_damage(me, target, 20, damage_bonus);
                        wound=random(damage-(int)target->query_temp("apply/armor"));
                        if(damage>0) {
                                target->receive_damage("kee", damage, me);
                                if(wound>0) target->receive_wound("kee", wound, me);
                                msg+=HIR"掌未到，掌风已经令$n窒息，结果“砰”的一声，这一
掌结结实实的拍在$n胸口！$n眼前一黑向后飞了出去！\n" NOR;
                                        }
                        msg +=HIW "$N不等$n落地，一个箭步冲了上去，左掌向上轻轻一撩
一股劲风卷着$n向上飞去，$N右手顺势又是一记重拳！\n";
                        damage=calculate_damage(me, target, 60, damage_bonus);
                        wound=random(damage-(int)target->query_temp("apply/armor"));
                        if(damage>0) {
                                target->receive_damage("kee", damage, me);
                                if(wound>0) target->receive_wound("kee", wound, me);
                                msg+=HIR"$n身在空中无法移动身体，被$N的重拳狠狠的捶在后背
上，$n只觉得喉头一甜，“噗”的一声喷出一大口鲜血！\n" NOR;
                                        }
                        msg +=HIW "$N随即纵身跃上空中，双掌合拳，高举过头顶，借着下
降的力量，对着向上飞来的$n的脑袋狠狠的砸了下去！\n";
                        damage=calculate_damage(me, target, 80, damage_bonus);
                        wound=random(damage-(int)target->query_temp("apply/armor"));
                        if(damage>0) {
                                target->receive_damage("kee", damage, me);
                                if(wound>0) target->receive_wound("kee", wound, me);
                                msg+=HIR"结果$n头部中招，只觉得头晕目眩，双耳轰鸣，“轰”
的一声，$n重重的砸在地上，口吐鲜血，眼看是不行了。\n" NOR;
                                        }
                            message_vision(msg, me, target);
                                                 COMBAT_D->report_status(target);
                            }
              me->set_temp("no_baiyue",1);
              call_out("baiyue_ok",2+random(2),me);
        //target->start_busy(3); 
        me->add("kee", -100);
        me->add("force", -400);
        me->add("sen",-100);
        return 1;
}

int calculate_damage(object me, object target, int base_damage, int damage_bonus)
{
        int damage;
        int myexp, youexp;

        damage=base_damage+(damage_bonus+random(damage_bonus))/4;
        myexp=me->query("combat_exp");
        youexp=target->query("combat_exp");
        if(random(youexp)>myexp) {
                damage-=damage/3;
                youexp/=2;
        }
        if (wizardp(me) && me->query("env/combat")=="verbose")
                tell_object(me, sprintf(HIC "damage: %d\n" NOR, damage));

        return damage;
}
void baiyue_ok(object me)
{
if (!me) return;
      me->delete_temp("no_baiyue");
}

