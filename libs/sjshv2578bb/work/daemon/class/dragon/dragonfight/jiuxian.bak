// 云龙九现  by wuyou@sk_xyj 2002-12-4

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int damage, ap, dp;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「云龙九现」？\n");

        if (!PFM_D->valid_family(me, "东海龙宫"))
                return notify_fail("你不是龙宫弟子，怎么能使用「云龙九现」？\n");
            
        if((string)me->query_skill_mapped("force")!="dragonforce")
                return notify_fail("不会龙神心法的人用不了「云龙九现」！\n");

        if((int)me->query("force") < 65+(int)me->query("force_factor") )
                return notify_fail("你的内力不足！\n");

        if(me->query("max_force") < 800 || me->query("force")<200)
                return notify_fail("内力不足，无法发挥「云龙九现」的威力！\n");

        if((int)me->query("kee") < 300 )
                return notify_fail("你身体太虚弱了，无法施展「云龙九现」！\n");

        if((int)me->query_skill("dragonfight", 1) <60)
                return notify_fail("你的龙形搏击练得不够纯熟，无法使出这招「云龙九现」！\n");

        if((int)me->query_skill("dragonforce", 1) <50)
                return notify_fail("你对龙神心法领悟尚浅，不能使出「云龙九现」！\n");
        
        if( time()-(int)me->query_temp("jiuxian_end") < 4 )  
                return notify_fail(WHT"「云龙九现」对真气损耗太大,无法连续使用！\n"NOR);  
        
        if( time()-(int)me->query_temp("lxtx_end") < 3 )  
                return notify_fail(WHT"「云龙九现」"NOR"与"HIY"乱舞"NOR"无法连续使用！\n"NOR);                     

        me->add("force", -(int)me->query("force_factor"));
        me->add("force", -50);
        me->receive_damage("kee", 100);

        msg = MAG"\n$N突然身形向后急退,爆发出一声惊天动地的龙吟！\n" NOR;
        msg += HIW"\n"
              "             ┏━┓┏━┓┏━┓┏━┓ \n"
              "             ┃云┃┃龙┃┃九┃┃现┃ \n"
              "             ┗━┛┗━┛┗━┛┗━┛ \n\n"NOR;
        msg += MAG"只见$N身后突然云雾缭绕，隐约间好像看见几条神龙在飞舞！\n"
              "突然,$N身后的云龙飘然而至,径直冲向$n的胸口。\n"
              "$n早已经看得目瞪口呆，哪里还有还手之力。\n"NOR;

        msg += HIW"\n" 
              "             ┏━┓┏━┓┏━┓┏━┓ \n" 
              "             ┃亦┃┃真┃┃亦┃┃幻┃ \n" 
              "             ┗━┛┗━┛┗━┛┗━┛ \n\n"NOR; 
        ap = me->query_skill("dragonfight", 1);
        ap = ( ap * ap * ap / (4 * 400) );
        ap = ap*250 + (int)me->query("combat_exp");
        dp = target->query_skill("dodge");
        dp = ( dp * dp * dp / (4 * 300) );
        dp = dp*250 + target->query("combat_exp");
        if( random((ap + dp)/400) <  dp/1000 ) 
        {
                msg +=HIG "$n早已看破虚实,一个铁板桥，勉强躲过了这致命一击！\n\n"NOR;
                me->start_busy(2);
                message_vision(msg, me, target);
        } 
        else 
        {
                damage = (int)me->query_skill("unarmed",1) / 40 +
        (int)me->query("sen") / 800 + random((int)me->query("sen") / 800 );
                msg += HIR
                "九条云龙顿时穿胸而过,然而这只是幻象,$N的双掌紧随其后,直印象$n的胸口.\n"
                "$n躲闪不及,被打个正着,象一捆稻草一样飞了出去!\n"NOR;
                damage +=random(10);
                target->receive_damage("sen", me->query("eff_sen")*damage/150, me, "pfm");
                target->receive_wound("sen", me->query("eff_sen")*damage/300, me, "pfm");
                target->receive_damage("kee", me->query("eff_kee")*damage/150, me, "pfm");
                target->receive_wound("kee", me->query("eff_kee")*damage/300, me, "pfm");
                PFM_D->test_msg(me,target,
                        "receive_damage(sen,"+me->query("eff_sen")*damage/150+")"
                        + "receive_damage(kee,"+me->query("eff_kee")*damage/150+")"
                        + "receive_wound(kee,"+me->query("eff_kee")*damage/300+")"
                        + "receive_wound(sen,"+me->query("eff_sen")*damage/300+")");
                me->improve_skill("dragonfight", 1, 1);
                message_vision(msg, me, target);
                COMBAT_D->report_status(target);
        }

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        me->set_temp("jiuxian_end",time());
        return 1;
}

