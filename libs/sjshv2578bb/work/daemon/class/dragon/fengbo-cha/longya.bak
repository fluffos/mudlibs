//龙牙连击
//by junhyun@SK

#include <ansi.h>
#include <combat.h>
void longya_ok(object);
inherit SSERVER;
int calculate_damage(object me, object target, int base_damage, int damge_bonus);

int perform(object me, object target)
{       
        string msg="";
        int damage,wound,k,damage_bonus,mystr;
        object weapon=me->query_temp("weapon");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("【龙牙连击】不是拿来玩的！\n");

        if(!me->is_fighting())
                return notify_fail("【龙牙连击】只能在战斗中使用！\n");
        
                   
        if (me->query_skill_mapped("force")!="dragonforce")
                return notify_fail("【龙牙连击】必须以龙神心法为根基！\n");
                
        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");
                
        if((int)me->query("sen") < 300 )
                return notify_fail("你的精神状态太差了，不能驾驭飞龙！\n");
                
        if((int)me->query("kee") < 200 )
                return notify_fail("你的气血太少了，弄不好反会被飞龙吞噬！\n");
                
        if((int)me->query_skill("dragonforce", 1) < 100)
                return notify_fail("你的龙神心法修为还不够不能用【龙牙连击】！\n");
                
        if((int)me->query_skill("fengbo-cha", 1) < 100)
                return notify_fail("你的风波叉修为还不够，恐怕不能御叉化龙！\n");
                
        if(me->query_temp("no_longya"))
                return notify_fail("你不怕把牙崩了？！\n");
        mystr=me->query_str();

        k=(int)me->query_skill("fork");
        damage_bonus=k;
        damage_bonus=mystr*(damage_bonus+100+me->query("force_factor"))/200;
        message_vision(HIW"$N一声龙吟，手中叉化作一条张牙舞爪的巨龙，陡然间连发四招，正是龙宫绝学—【龙牙连击】\n"NOR,me,target);
                     
        if (random((int)me->query("per"))<10 || random((int)target->query("daoxing")) > ((int)me->query("daoxing"))) 
        {
                message_vision(HIB"$n似乎看穿了$N的招数，站在原地一招一式的化解着$N的所有攻势！\n"NOR,me,target);

        }
        else 
        {
                msg +=HIC "【震天】$N飞身而起，手中寒光一闪，叉尖由上而下削向$n头顶！\n\n";
                damage=calculate_damage(me, target, 20, damage_bonus);
                wound=random(damage-(int)target->query_temp("apply/armor"));
                if(damage>0) 
                {
                        target->receive_damage("kee", damage, me, "pfm");
                        if(wound>0) target->receive_wound("kee", wound, me, "pfm");
                                msg+=HIR"结果$n被削去了一大块头皮！\n\n" NOR;
                }
                msg +=HIG "【撼地】$N刚刚落地，看都不看舞叉横扫，叉杆贴地直扫$n脚踝！\n\n";
                damage=calculate_damage(me, target, 40, damage_bonus);
                wound=random(damage-(int)target->query_temp("apply/armor"));
                if(damage>0) 
                {
                        target->receive_damage("kee", damage, me, "pfm");
                        if(wound>0) target->receive_wound("kee", wound, me, "pfm");
                                msg+=HIR"结果$n左脚中叉当场不能动弹！\n\n" NOR;
                }
                msg +=HIY "【翻江】$N一个翻身，左手一撑，顺手上挑，寒光笼罩在$n前胸！\n\n";
                damage=calculate_damage(me, target, 60, damage_bonus);
                wound=random(damage-(int)target->query_temp("apply/armor"));
                if(damage>0) 
                {
                        target->receive_damage("kee", damage, me, "pfm");
                        if(wound>0) target->receive_wound("kee", wound, me, "pfm");
                                msg+=HIR"结果$n前胸被扎出一个血窟窿！\n\n" NOR;
                }
                msg +=HIM "【倒海】$N一声龙吟，连叉带人化作一条黑龙，风一样疾飞向$n！\n\n";
                damage=calculate_damage(me, target, 80, damage_bonus);
                wound=random(damage-(int)target->query_temp("apply/armor"));
                if(damage>0) 
                {
                        target->receive_damage("kee", damage, me, "pfm");
                        if(wound>0) target->receive_wound("kee", wound, me, "pfm");
                                msg+=HIR"结果$n宛如被一条黑龙当胸穿过一般，“哇”的吐出一口鲜血。\n\n" NOR;
                }
                message_vision(msg, me, target);
                COMBAT_D->report_status(target);
        }
        me->set_temp("no_longya",1);
        call_out("longya_ok",2+random(2),me);
        //me->start_busy(2+random(1));
        me->add("kee", -100);
        me->add("force", -400);
        me->add("sen",-100);
        return 1;
}

int calculate_damage(object me, object target, int base_damage, int damage_bonus)
{
        int damage;
        int myexp, youexp;

        damage=base_damage+(damage_bonus+random(damage_bonus))/4;
        myexp=me->query("combat_exp");
        youexp=target->query("combat_exp");
        if(random(youexp)>myexp) {
                damage-=damage/3;
                youexp/=2;
        }
        if (wizardp(me) && me->query("env/combat")=="verbose")
                tell_object(me, sprintf(HIC "damage: %d\n" NOR, damage));

        return damage;
}
void longya_ok(object me)
{
        if (!me) return;
        me->delete_temp("no_longya");
}


