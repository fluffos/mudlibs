//大海无量 

#include <ansi.h>
#include <combat.h>

inherit SSERVER;
void check_me(object me, object target);
void remove_effect(object me);
void doing_attack(object me, object target, object weapon);

int perform(object me, object target)
{

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「大海无量」？\n");


        if (!PFM_D->valid_family(me, "东海龙宫"))
                return notify_fail("你非龙族，怎能习惯这水中出没的叉法？\n");
        if ( me->query_skill("fengbo-cha",1)<100 ) 
                return notify_fail("你的风波十二叉还不够纯熟！\n");
        if ( me->query_skill_mapped("force") !="dragonforce")
                return notify_fail("「大海无量」必须配合龙神心法才能发挥威力。\n");
        if ( me->query_skill("dragonforce",1)<120 ) 
                return notify_fail("你的龙神心法还不够纯熟！\n");
        if ((int)me->query_skill("dragonstep", 1) < 100 ) 
                return notify_fail("你的修为不够深，还使不出这一招！\n");
        if ( me->query("max_force")<1000 || me->query("force")<500 )
                return notify_fail("你的内力不足，无法照路数舞叉。\n");
        if ( me->query("kee")<300 )
                return notify_fail("你的气血不足，无法照路数舞叉。\n");

        me->add("force", -200);
        tell_object(me, HIC"你把内功心法在心中默念一遍，一股热气从足底涌泉穴慢慢升起。。。\n"NOR);
        me->set_temp("no_move", 1);
        me->set_temp("perform/dhwl",0);
        me->start_call_out( (: call_other, __FILE__, "check_me", me, target:), 1);
        return 1;

}


void check_me(object me,object target)
{
        object weapon;
        string *msg = ({
        HIC"你运起龙神心法，转瞬间突然周身骨骼格格做响，面上浮现出阵阵青气。\n"NOR,
        HIC"你面上的青气渐渐淡了，目中却精光大盛，脚心涌泉穴热力滚滚，直往上冲。\n"NOR,
        HIC"你收敛心神，把脚底热气运至膝间跳环，但觉内力运转间身轻无比。\n"NOR,
        HIC"你默念龙神心法，四肢不动而意在脾，人虽未动，却只觉内力沉于丹田，力量倍增。\n"NOR,
        HIC"你将沉于丹田之力带行全身，身上啪啪连响，运转自如直冲任督，忍不住纵声长啸。\n"NOR,
        HIC"你想起龙神心法所言：舌不吟而神在心。连忙收声运气，但觉得心灵中一片空灵。\n"NOR,
        HIC"你屏住气息，运转内力于肺间。呼吸均匀悠长，以然达到了鼻不香而魄在肺的境界。\n"NOR,
        HIC"你心平气静，对外界的嘈杂亦不听不想；耳不闻而精在肾，沉身运气，内力更高了一层。\n"NOR,
        HIC"你突觉内力运转周身无法突破，不禁闭目沉思，就在闭目的一瞬间意识到眼不视而魂在肝的道理。\n"NOR,
        HIC"你运气一周天，浑身充满强霸的力道。突然间脑际灵光一闪，气化为神，神化为虚直冲头顶。\n"NOR,
        });

        int i;
        if (!me) return;
        i=me->query_temp("perform/dhwl");
        weapon=me->query_temp("weapon");
        if( !target||!present(target->query("id"), environment(me)) ) remove_effect(me);

        else 
                if (!target->is_fighting() || !me->is_fighting()) remove_effect(me);

                else 
                        if (!weapon || (weapon->query("skill_type")!="fork")) remove_effect(me);

                        else 
                                if (i>9) doing_attack(me, target, weapon);

                                else 
                                { 
                                        tell_object(me, msg [i]);
                                        i+=1;
                                        me->set_temp("perform/dhwl",i); 
                                        call_out("check_me", 1, me, target);
        
                                }
}

void remove_effect(object me)
{  
        me->delete_temp("no_move");
        me->delete_temp("perform/dhwl");
        me->delete_temp("perform");
        me->start_busy(1);

}

void doing_attack(object me, object target, object weapon)
{
    
        int skill;
        if (!me) return;
        if (!weapon||!target) 
        {
                me->delete_temp("perform/dhwl");
                me->delete_temp("perform");
                me->start_busy(1);
                return;
        }

        me->delete_temp("no_move");
        message_vision(HIC"$N一声龙吟，热气突破头顶的百汇穴，瞬时间，$N觉得全身所有穴位都有热气\n如同百川归海一样涌向丹田，全身有无穷的力量随时要迸发出来。\n"NOR, me);

        skill=(int)me->query_skill("fengbo-cha",1)/3;
        if (userp(me)) me->add_temp("apply/attack", skill);
        for (int i =0;i<12;i++) 
        {

                if (wizardp(me) && me->query("env/combat")=="verbose")
                tell_object(me,HIY "第"+chinese_number(i+1)+"叉！" NOR);
                COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
        }

        if (userp(me)) me->add_temp("apply/attack", -skill);
        me->delete_temp("perform/dhwl");
        me->delete_temp("perform");
        me->start_busy(3);
    

}
