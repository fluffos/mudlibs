#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        if(me->is_busy())
                return notify_fail("你现在没空！！\n");
        if((int)me->query_skill("jiuyin-force", 1) <200)
                return notify_fail("你的玄天九阴真经还不够熟练！\n");
        extra = me->query_skill("sword");
        if ( extra < 200) return notify_fail("你的圣灵剑法还不够纯熟！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("[云牵雾绕]只能对战斗中的对手使用。\n");
        if( time()-(int)me->query_temp("yunwu_end") < 4 ) 
                return notify_fail("你现在真气不纯。\n");   
        me->add_temp("apply/attack",extra*2);me->add_temp("apply/damage",extra*2);

        if (!target->is_busy()) target->start_busy(1); 
        weapon = me->query_temp("weapon");
        message_vision(HIC"$N脚踏七星，横剑而立。双手缓缓抬起，暗自运起玄天九阴真经。\n" NOR,me,target);
        message_vision(HIB "顿时一股云气从$N的身体散出来。\n"NOR,me,target);
        message_vision(HIB"$n对着这突然改变的环境不由得目瞪口呆，愣在当场！\n"NOR,me,target);
        message_vision(HIB"$N乘机绵绵不断连续功出五招。\n" NOR,me,target);
        message_vision(HIM"\n$N手中宝剑由下向上挑起，人随剑行，跃向空中。\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIC"\n$N借着漫天云雾，在空中两个来回，又对着$n刺出了两剑。\n"NOR,me,target);

        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
      message_vision(HIW"\n$N借着更浓的云雾，从空中直落而下扑向$n，幻出漫天剑影压向$n！\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIB"\n$N轻盈的落在一旁，然而脸在飘渺的云雾中显得更加冷酷了。\n"NOR,me,target);
//        me->start_busy(2);
        me->add("force", -150);
        me->add_temp("apply/attack",-extra*2);me->add_temp("apply/damage",-extra*2);

        me->set_temp("yunwu_end",time()); 
        return 1;
}

