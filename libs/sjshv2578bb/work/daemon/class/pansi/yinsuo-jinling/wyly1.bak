       //edited by dewbaby@sjsh
        
#include <ansi.h>
        
       inherit SSERVER; 
        
       int perform(object me, object target) 
       { 
             object weapon,ob;               
             int youexp,myexp;             int damage;
    int yourexp;
                             
              if( !target ) target = offensive_target(me); 
       
              if( !target 
              ||      !target->is_character() 
              ||      target->is_corpse() 
              ||      target==me) 
                      return notify_fail("你要对谁施展这一招「五韵连音」？\n"); 
       
              if(!me->is_fighting()) 
                      return notify_fail("「五韵连音」只能在战斗中使用！\n"); 
       
              if((int)me->query("force") < 100 ) 
                      return notify_fail("你的内力不够！\n"); 
       
              if((int)me->query("kee") < 100 ) 
                      return notify_fail("你的气血不足，没法子施用外功！\n"); 
       
              if((int)me->query_skill("yinsuo-jinling", 1) < 150) 
                      return notify_fail("你的银索金铃级别还不够，无法领会五韵精髓！\n"); 
       
     
              myexp = (int) me->query("combat_exp"); 
              youexp = (int) target->query("combat_exp");   
        message_vision(HIY"$N双手急速挥舞银索金铃，竟发出隐藏着宇宙最神奇力量的五韵之音\n"NOR, me); 
     message_vision(HIW"☆商☆\n"NOR,me,target); 
     message_vision(HIY"☆角☆\n"NOR,me,target); 
     message_vision(HIR"☆徽☆\n"NOR,me,target); 
     message_vision(HIB"☆羽☆\n"NOR,me,target); 

            damage=(int)me->query_skill("parry")+random((int)me->query_skill("whip")); 
             if(random(myexp)>yourexp/5) 
           {
             target->start_busy(2);
        me->start_busy(1);
             target->receive_damage("kee",damage/4);
             target->receive_wound("kee",damage/4);
             target->receive_damage("sen",damage/4);
             target->receive_wound("sen",damage/6)+10;
             COMBAT_D->report_status(target);
            }
          else {
             message_vision(HIW"$n动作丝毫不乱，冷笑着躲过危机。\n"NOR,me,target);
             me->start_busy(3);
             me->add("force", -150);
             me->add("kee", -80);

    }
}


