//fogang.c 佛光普照


#include <ansi.h>

inherit F_SSERVER;
#include <combat_msg.h>;

int remove_effect(object me);
int perform(object me, object target)
{
        int damage, ap, dp, p;
        float at;
        string msg, dodge_skill;

 
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
                return notify_fail("「佛光普照」只能在战斗中使用。\n");

        if( (int)me->query_skill("lotusforce", 1) < 420 )
                return notify_fail("你的莲花心法未成，不能使用「佛光普照」！\n");
        if( (int)me->query("max_force") < 2000 )
                return notify_fail("你的内力修为不足，不能使用「佛光普照」！\n"); 
        if( (int)me->query("force") < 1000 )
                return notify_fail("你现在内力不足，不能使用「佛光普照」！\n"); 

        if( (int)me->query_skill("lunhui-zhang", 1) < 430 )
                return notify_fail("你的轮回杖不够娴熟，不能使用「佛光普照」。\n");
       
       
    msg = MAG "\n
只见$N面显庄严，突然间全身骨骼中发出劈劈拍拍的轻微爆裂之声，炒豆般的响声未绝，一式「"HIY"佛光普照"MAG"」，
提一口真气，飘身而上，半空中杖掌交错，一股内劲狭带着热浪，如风如火，似雷似电，这一招拍出，
击向$n，招式平平淡淡，一成不变，但却挡无可挡，避无可避！\n"NOR;
//        ap = (int)me->query_skill("lunhui-zhang",1) * (int)me->query("force");
        ap = (int)me->query_skill("lunhui-zhang",1) ;
//        dp = (int)target->query_skill("force", 1) * (int)target->query("force");
        dp = (int)target->query_skill("force", 1) ;
        ap *= (int)me->query("combat_exp")/200;
        dp *= (int)target->query("combat_exp")/200;    
//        ap /= 1000;
//        dp /= 1000;

        me->start_busy(2);        
        if(random(ap) > dp*2/7){
                target->start_busy(1+random(2));
                damage = me->query_skill("lunhui-zhang",1)/2 + me->query_skill("lotusforce", 1)/2;
                damage *= 2;
                damage += me->query("force_factor")*10;
                
                if(target->query("force") < 1) at = 5;
                else at = me->query("force") / (target->query("force")+1);
                if(at < 1){
//                    damage /= 2;
                    at = 1;
                    }
                else damage *= at;
                damage -= target->query_temp("apply/armor")*2;
                if (damage < 0) damage = 0;
                if (damage > 3600) damage = 3600;
                damage = damage + random(damage / 2);
                if (target->query_skill_mapped("force") == "lotusforce" &&
                    target->query_skill("lotusforce", 1) > 200){
                      tell_object(me, HIY"\n哪知你一杖打在"+target->name()+"身上，却犹如江河入海，又如水乳交融，劲力登时无影无踪！\n"NOR);
                      msg += "猛听得砰然一声大响，$N已打中在$n胸口，只道$p定然全身骨骼粉碎。哪知一杖过去，
$n脸露讶色，竟好端端的站着，$n却也是脸如死灰，手微微发抖！\n";
                      target->start_busy(2);
                      target->receive_damage("kee", damage/2, me); 
                      target->receive_wound("kee", damage/4, me); 
                      message_vision(msg, me, target);
                      me->add("force", -200);
                      return 1;
                      }
                target->receive_damage("kee", damage, me);
                target->receive_wound("kee", damage/2, me);
                target->add("force", -damage/5);
                me->add("force", -200);
                if(damage >= 2000)
                     msg += "这一招乃是使上了全力，丝毫不留余地，$n的生死存亡，便决于这顷刻之间！\n";
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += damage_msg(damage, "瘀伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
                }
        else {
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
        }
        me->add("force", -100);
        message_vision(msg, me, target);
        return 1; 
}


