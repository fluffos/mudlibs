// 凤舞九天
// yangwl 1/31/2001

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{            
        int ob,tar,extra,damage,str,kar;
        object weapon;
        string msg;

        extra=(int)me->query_skill("yirubian", 1);
        ob=(int)me->query("combat_exp")+ extra*extra*extra/10;
        tar=(int)me->query("combat_exp");
        weapon=me->query_temp("weapon");
        str=(int)me->query_str();
        kar=(int)me->query_kar();

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招"+HIG"「凤舞九天」"+NOR"？\n");
                

        if(!me->is_fighting())
                return notify_fail("你们没有在打架！\n");
        if((int)me->query("force") < 500+(int)me->query("force_factor") )
                return notify_fail("你的内力不够！\n");


        if((int)me->query("kee") < 300 )
                return notify_fail("你的气血不足，没法子施用外功！\n");

        if (extra < 10)
               return notify_fail("你的忆如鞭法等级太低！ \n");

        if (!PFM_D->valid_family(me, "蜀山剑派"))
                return notify_fail(HIG"「凤舞九天」"+NOR"是蜀山不传之密！\n");


        if( random(me->query("max_force")) < 50 ) 
        {
                write("糟糕，没成功！\n");
                return 1;
        }

        if (extra > 10 )
        {
        msg=                HIC "第一式！$N身形一转，一招「烟雨飘飘」"+weapon->query("name")+"幻出满天鞭影，虚虚实实地袭
向$n的胸口七处大穴！\n" NOR;
        message_vision(msg, me, target);
        me->add("force",-10);
        target->receive_damage("kee", -60-str, me, "pfm");
        COMBAT_D->report_status(target,0);
        }
        
        if (extra > 20 )
        {
        msg=                HIR "第二式！$N霞袖慢垂，莲步急趋，手中"+weapon->query("name")+"似影随形，一招「如梦如幻」扫
向$n！\n" NOR;
        message_vision(msg, me, target);
        me->add("force",-20);
        target->receive_damage("kee", -80-str, me, "pfm");
        COMBAT_D->report_status(target,0);
        }

        if (extra > 40 )
        {
        msg=                HIB "第三式！$N力贯"+weapon->query("name")+"，一招「落花流水」点点鞭影飘浮不定地点向$n的
全身！\n" NOR; 
        message_vision(msg, me, target);
        me->add("force",-40);
        target->receive_damage("kee", -100-str, me, "pfm");
        COMBAT_D->report_status(target,0);
        }

        if ( extra > 60)
        {
        msg=                HIY "第四式！$N徐徐舞动"+weapon->query("name")+"，却是一招「随风飘逝」，只见招断意连，缠绵婉
转，一鞭未绝，便隐隐有万鞭相随！\n" NOR;
        message_vision(msg, me, target);
        me->add("force",-40);
        if ( random (ob) > tar/3  &&  random(100) > 30){
        damage=(int)target->query("kee",1)/2+str;
        if (damage < 400 )
        damage=400;
        target->receive_damage("kee", damage/4, me, "pfm");
        target->receive_wound("kee", damage/10, me, "pfm");
        COMBAT_D->report_status(target,0);}
      
        }

        if ( extra > 100)
        {
        msg=                HIG "第五式！$N使一招「寒风起兮」，手中"+weapon->query("name")+"抖得笔直向$n的小腹连刺数
鞭！\n" NOR;
        message_vision(msg, me, target);
        me->add("force",-60);
        if ( random (ob) > tar/3  &&  random(100) > 40){
        damage=(int)target->query("kee",1)+str;
        if (damage < 500 )
        damage=500;
        target->receive_damage("kee", damage/3, me, "pfm");
        target->receive_wound("kee", damage/10, me, "pfm");
        COMBAT_D->report_status(target,0);}

        }

        if (extra > 150)
        {
        msg=                HIM "第六式！$N身形转动，使出「星光灿烂」向$n连打六下！\n" NOR;
        message_vision(msg, me, target);
        me->add("force",-60);
        if ( random (ob) > tar/2  &&  random(100+kar) > 60 ){
        damage=(int)target->query("kee",1)+str;
        if (damage < 600 )
        damage=600;
        target->receive_damage("kee", damage/3, me, "pfm");
        target->receive_wound("kee", damage/8, me, "pfm");
        COMBAT_D->report_status(target,0);}

        }

        if (extra > 200 )
        {
        msg=                YEL "第七式！忽然间$N鞭势陡变，"+weapon->query("name")+"浏漓顿挫，古意盎然，一式「千秋万古」
如月之曙，如气之秋，纵有千载情愁，亦化于这一招之中！\n" NOR;
        message_vision(msg, me, target);
        me->add("force",-80);
        if ( random (ob) > tar/2  &&  random(100+kar) > 70 ){
        damage=(int)target->query("kee",1)+str;
        if (damage < 700 )
        damage=700;
        target->receive_damage("kee", damage/3, me, "pfm");
        target->receive_wound("kee", damage/8, me, "pfm");
        COMBAT_D->report_status(target,0);}

        }

        if (extra > 250 )
        {
        msg=                HIW "第八式！$N一式「日月星辰」，"+weapon->query("name")+"光芒大盛，点点如星，团团如日，美幻
美伦，洒向天际！\n" NOR;
        message_vision(msg, me, target);
        me->add("force",-90);
        if ( random (ob) > tar  &&  random(100+kar/2) > 80 ){
        damage=(int)target->query("kee",1)+str*2;
        if (damage < 800 )
        damage=800;
        target->receive_damage("kee", damage/2, me, "pfm");
        target->receive_wound("kee", damage/8, me, "pfm");
        COMBAT_D->report_status(target,0);}

        }

        if ( extra > 300 )
        {
        msg=                MAG "第九式！$N一式「凤舞九天」，"+weapon->query("name")+"挥洒自如，霎时间绛雪纷纷，娇如柳絮，
弱似梨花，密密裹住$n全身！\n" NOR;
        message_vision(msg, me, target);
        me->add("force",-100);
        if ( random (ob) > tar*3/2  && random(100+kar/2) > 80){
        damage=(int)target->query("kee",1)+str*3;
        if (damage < 1000 )
        damage=1000;
        target->receive_damage("kee", damage/3*2, me, "pfm");
        target->receive_wound("kee", damage/6, me, "pfm");
        COMBAT_D->report_status(target,0);}

        }
        
        me->start_busy(random(2)+2);

        return 1;
}

