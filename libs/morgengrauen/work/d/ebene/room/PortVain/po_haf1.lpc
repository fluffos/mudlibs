/*
 * Hafenstrasse, Port Vain — north exit of /gilden/abenteurer.
 *
 * Strategy A FluffOS room. The live domain /d/ebene (files.ebene
 * submodule) is not in this snapshot. Text is reconstructed from the
 * guild's own Hafenstrasse / Port Vain details so the north walk works.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "sueden": "/gilden/abenteurer",
    "sued": "/gilden/abenteurer",
    "s": "/gilden/abenteurer",
    "south": "/gilden/abenteurer",
    "gilde": "/gilden/abenteurer",
  ]);
  extras = ([
    "strasse":
      "Die Hafenstrasse verbindet die Abenteurergilde mit dem Hafen von "
      "Port Vain.\n",
    "hafenstrasse":
      "Die Hafenstrasse verbindet die Abenteurergilde mit dem Hafen von "
      "Port Vain.\n",
    "hafen":
      "Weiter noerdlich liegt der Hafen von Port Vain. Von hier aus siehst "
      "Du nur die Strasse und das goldene Licht der aufgehenden Sonne.\n",
    "sonne":
      "Goldenes Licht einer ewig aufgehenden Sonne liegt auf der "
      "Hafenstrasse.\n",
    "tuer":
      "Die immer offene Tuer der Abenteurergilde steht im Sueden.\n",
    "gilde":
      "Die immer offene Tuer der Abenteurergilde steht im Sueden.\n",
  ]);
}

string query_short() { return "Hafenstrasse von Port Vain"; }

string query_long() {
  return
    "Die Hafenstrasse von Port Vain liegt im goldenen Licht einer ewig\n"
    "aufgehenden Sonne. Nach Sueden steht die immer offene Tuer der\n"
    "beruehmten Abenteurergilde. Der Weg zum Hafen fuehrt weiter nach\n"
    "Norden, aber der Hafen selbst ist von hier aus noch nicht zu erreichen.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Der offensichtliche Ausgang ist sueden.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hafenstrasse" || str == "strasse" || str == "here";
}
