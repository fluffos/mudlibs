/*
 * Buero des Foerdervereins — up exit of /gilden/abenteurer
 * (original path /p/verein/room/buero).
 *
 * Strategy A FluffOS room. The live Verein rooms are not in this
 * snapshot. Text follows the guild's own Buero / Treppe details.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "unten": "/gilden/abenteurer",
    "down": "/gilden/abenteurer",
    "d": "/gilden/abenteurer",
    "gilde": "/gilden/abenteurer",
  ]);
  extras = ([
    "treppe":
      "Die Treppe fuehrt nach unten zurueck in den grossen Gildensaal.\n",
    "informationen":
      "Wichtige Informationen des Foerdervereins Projekt MorgenGrauen e.V.\n"
      "warten hier. Du musst sie selbst suchen.\n",
    "akten":
      "Regale mit Akten des Foerdervereins. Nichts davon laesst sich hier "
      "lesen.\n",
  ]);
}

string query_short() { return "Buero des Foerdervereins"; }

string query_long() {
  return
    "Das Buero des Foerdervereins Projekt MorgenGrauen e.V. liegt ueber\n"
    "der Abenteurergilde. Eine Treppe fuehrt nach unten zurueck in den\n"
    "grossen Gildensaal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Der offensichtliche Ausgang ist unten.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "buero" || str == "foerderverein" || str == "here";
}
