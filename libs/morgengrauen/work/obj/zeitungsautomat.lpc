/*
 * Newspaper stand in the Abenteurergilde.
 *
 * Strategy A FluffOS object. Original inherit /std/thing is
 * zeitungsautomat_ldmud.lpc. Archive AddItem in
 * /gilden/abenteurer; get clones /obj/mpa and leaves the stand.
 */

int query_dispenser() { return 1; }

void create() {
  seteuid(getuid());
}

string query_name() { return "Zeitung"; }
string query_short() { return "Eine Zeitung"; }
string short() { return query_short(); }
string query_long() {
  return "Hier stehen immer die neuesten Nachrichten und Geruechte drin.\n";
}
string long() { return query_long(); }

int id(string str) {
  return str == "zeitung" || str == "mpa" || str == "servicepaket";
}

void move_to(object dest) {
  if (objectp(dest))
    efun::move_object(dest);
}

int dispense(object targ) {
  object *inv;
  object paper;
  int i;

  if (!objectp(targ))
    return 1;
  inv = all_inventory(targ);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->id("mpa") && !inv[i]->query_dispenser()) {
      tell_object(targ, "Du hast doch bereits eine Zeitung.\n");
      return 1;
    }
  }
  paper = 0;
  catch(paper = clone_object("/obj/mpa"));
  if (!paper) {
    tell_object(targ, "Du kannst die Zeitung leider nicht mehr tragen.\n");
    return 1;
  }
  paper->move_to(targ);
  tell_object(targ,
    "Du nimmst die Zeitung. Sofort erscheint auf "
    "unerklaerliche Weise eine neue.\n");
  return 1;
}
