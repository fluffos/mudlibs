
inherit ROOM;


string look_writing();


void create()
{
	set("short", "走廊");
	set("long", @LONG
这是一条走廊。房顶一侧支在东面的高墙上，另一侧则与西
侧的清和殿屋顶相连。彩梁画栋，连顶棚也用彩漆绘满了各种飞
天的图形，每幅精美的雕画似乎都在诉说一个娓娓动人的故事。
往东通往前院，南北都有房间。
LONG
	);

	set("exits", ([
		"east" : __DIR__"qianyuan",
		"west" : __DIR__"qihedian",
		"north" : __DIR__"fang3",
		"south" : __DIR__"fang4",
	]));

	setup();
}


