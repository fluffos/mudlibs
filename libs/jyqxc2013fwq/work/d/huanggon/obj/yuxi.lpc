// yuxi.c
#include <ansi.h>
#include <weapon.h>

inherit HAMMER;

void create()
{
        set_name(HIC"玉玺"NOR, ({ "yu xi" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是皇帝玉玺。\n");
                set("value", 100);
                set("material", "iron");
                set("wield_msg", "$N拿出$n，试了试重量，然後提在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_hammer(30);
        setup();
}
