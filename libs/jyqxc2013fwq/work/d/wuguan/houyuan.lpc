inherit ROOM;
int valid_leave();
void create() {
  set("short", "后院");
  set("long", @LONG
这是连城武馆的后院。
LONG);

  set("exits", ([
    "northeast": __DIR__ "zhengting",
    "down": __DIR__ "qiushi",
  ]));
  set("objects", ([
    __DIR__ "npc/dingdian": 1,
  ]));
  setup();

}
int valid_leave(object me, string dir) {
  if (dir != "down")
    return ::valid_leave(me, dir);

  if (dir == "down" && objectp(present("ding dian", environment(me)))) {
    if ((string)me->query("family/family_name") == "连城武馆") {
      if ((me->query("gender") == "男性"))
        write("丁典侧身让开，说道: “俊男辛苦了，囚犯正等着你鞭打呢。”\n");
      else if ((me->query("gender") == "女性"))
        write("丁典侧身让开，说道：“美女辛苦了，囚犯正等着妳鞭笞呢。”\n");
      return 1;
    } else
      return notify_fail(
        "丁典喝道：“下面是本馆的囚室，这位" + RANK_D->query_respect(me) + "请止步。”\n");
  }
  return ::valid_leave(me, dir);
}
