// wangyuyan.c
#include <ansi.h>
inherit NPC;

void create()
{
set_name("王语嫣",({ "wang yuyan", "wang", "yuyan" }) );
       set("nickname", HIM"神仙姐姐"NOR);
        set("gender", "女性");
        set("age", 18);
        set("long", 
          "王语嫣小姐天姿国色，赏心悦目，真是人见人爱。\n");
	set("combat_exp", 800);
//        set("shen", 100);
	set("shen_type", 1);
        set("per", 88);
		set("str", 18);
        set("dex", 18);
        set("con", 18);
        set("int", 30);
        set("attitude", "friendly");
        set("qi", 330);
        set("max_qi", 330);
        set("neili", 100);
        set("max_neili", 100);
        set_skill("force",20);
        set_skill("unarmed",20);
        set_skill("literate",90);
		set_skill("parry",20);
        set_skill("dodge",20);
        set("inquiry", ([
		"慕容复" : "他是小女子的表哥，在江湖上非常有名望。\n",
		"段誉" : "段公子是大理世子，虽然对小女子极为痴情，不过小女子心中只有表哥一人。\n",
	]));
	setup();
  carry_object("/d/city/npc/obj/pink_cloth")->wear();
	add_money("coin", 100);
}
void kill_ob (object ob)
{
  object me = this_object();
  object where = environment (me);
  object murong = present ("murong fu", where);
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  if (murong && !murong->is_fighting())
  {message("vision","慕容复怒道：“"+ob->name()+"，竟敢对我表妹下手，我宰了你！”\n",environment(),me);
  murong->kill_ob(ob);}
}
