// murongfu.c 慕容复

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("慕容复", ({"murong fu", "murong", "fu"}));
	set("nickname", HIW"慕容公子"NOR);
	set("title", "南慕容");
	set("gender", "男性");
	set("age", 28);
	set("long", 
		"他是江湖上鼎鼎大名的慕容公子，和北乔峰齐名于世。\n");
	set("attitude", "heroism");
	set("shen",-10000);
	set("str", 26);
	set("int", 28);
	set("con", 26);
	set("dex", 27);
  set("food",1000);
  set("water",1000);
	set("chat_chance", 1);
	set("chat_msg", ({
		"慕容复眉头一皱道：“何时才能光复大燕国啊？………”\n",
	}));

	set("inquiry", ([
		"大燕" : "见到大燕国未来皇帝，还不跪下！\n",
		"大燕国" : "见到大燕国未来皇帝，还不跪下！\n",
		"慕容博" : "家父已经去世多年了。\n",
		"王语嫣" : "她是在下的表妹。\n",
	]));

	set("jing", 2000);
	set("max_jing", 2000);
	set("jingli", 1000);
	set("max_jingli", 1000);
	set("qi", 3500);
	set("max_qi", 3500);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali",200);
	
	set("combat_exp", 1200000);
	set("score", 20000);
	 
	set_skill("force", 200);		// 基本内功
	set_skill("shenyuan-gong", 200);	// 神元功
	set_skill("literate",80);       //读书写字
	set_skill("hand", 180);		// 基本手法
	set_skill("fengyun-shou", 180);	// 风云手
	set_skill("sword", 180);        //基本剑法
	set_skill("fumo-jian", 180);    //伏魔剑法
	set_skill("dodge", 180);		// 基本躲闪
	set_skill("douzhuan-xingyi", 200);		// 斗转星移
	set_skill("parry", 200);			// 基本招架
	
	map_skill("force", "shenyuan-gong");
	map_skill("dodge", "douzhuan-xingyi");
	map_skill("sword", "fumo-jian");
	map_skill("parry", "fumo-jian");
	map_skill("hand", "fengyun-shou");
	prepare_skill("hand", "fengyun-shou");
	setup();
	create_family("慕容世家",6,"传人");
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
}

void attempt_apprentice(object ob)
{
     command("say 本公子一心复国，哪有时间教徒弟？如果你能帮本公子找到玉玺的话……\n");
  }
int accept_object(object who, object ob)
{
	if( !who || environment(who) != environment() )
		return 0;
	if( !objectp(ob) )
		return 0;
	if( !present(ob, who) )
		return notify_fail("你没有这件东西。\n");

	if( (string)ob->query("name") != HIC"玉玺"NOR)
		return notify_fail("慕容复不需要这件东西。\n");
    say( "慕容复接过"+HIC"玉玺"NOR+"，哈哈大笑!\n" );
	ob->move(this_object());
    kill_ob(who);
  return 1;
}