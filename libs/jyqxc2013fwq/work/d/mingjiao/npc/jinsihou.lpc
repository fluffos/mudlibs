// jinsihou.c

inherit NPC;

void create()
{
	set_name("金丝猴", ({ "monkey" }) );
	set("gender", "雄性");
	set("race", "野兽");
	set("age", 5);
	set("long", "这只金丝猴在在桃树间跳上跳下，还不时津津有味地啃几口蜜桃。\n");
	set("combat_exp", 5000);
	set("attitude", "peaceful");
	set("water", 200);
	set("food", 200);
set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

	set("apply/attack", 10);
	set("apply/defense", 10);

	set("chat_chance", 2);
	set("chat_msg", ({
		"金丝猴冲着你大扮鬼脸，叽叽歪歪一阵乱叫......!\n",
		"金丝猴忽然跳了过来，一个倒勾，前爪一伸摘了你的草帽!\n",
		"金丝猴轰的一声一起从这株树跳到那株树，把你吓了一大跳!\n",
	}) );

	set_skill("unarmed", 25);
	set_skill("parry", 20);
	set_skill("dodge", 20);

	setup();
}
