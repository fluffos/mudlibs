// Room: /d/mingjiao/xuantianshi.c
// Date: XXL 97/05/9
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "悬天石");
  set("long", @LONG
从石上远眺，只见云海苍茫处，险绝万峦生，昆仑一脉，逶迤
千里，真一派大好江山。关于悬天石，还有许多传说。相传明教第
三十代教主为解明教之难，舍身于此,明教一代绝学“圣火魔功”
从此失传。许多后来之人于此凭吊，莫不泣泪，但更多的是从此石
跳下（jump down），想寻找“圣火魔功”秘籍，却从没有人能安然而归。
LONG
  );

  set("exits", ([
    "westdown": __DIR__ "shanlu3",
  ]));

  set("outdoors", "mingjiao");
  setup();
}
void init() {
  add_action("do_jump", "jump");
  add_action("do_jump", "tiao");
}
int do_jump(string arg) {
  object me = this_player();
  int n = (int)me->query_dex();
  if (!arg || arg != "down") {
    write("你想往哪跳?\n");
    return 1;
  }

  if (n > 40) {
    message_vision("$N鼓足勇气，往悬崖下跳去。\n", me);
    message_vision("$N衣身飘飘，不一会儿双足稳稳地落在地上。\n", me);
    me->move(__DIR__ "gudi1");
  } else {
    message_vision(HIR "$N惨叫一声，重重地摔向谷底，顿时不省人事。\n", me);
    me->move(__DIR__ "gudi1");
    me->unconcious();
  }
  return 1;
}
