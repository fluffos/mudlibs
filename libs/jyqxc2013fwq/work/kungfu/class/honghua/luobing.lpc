// luobing.c 骆冰
#include <ansi.h>
inherit NPC;

void create()
{
set_name("骆冰",({ "luo bing", "luo", "bing" }) );
        set("gender", "女性");
        set("nickname",HIM "文夫人"NOR);
        set("age", 28);
        set("long", 
          "骆冰是奔雷手文泰来的夫人。\n");
	set("combat_exp", 90000);
        set("shen", 3000);
	    	set("str", 21);
        set("dex", 23);
        set("con", 20);
        set("int", 23);
        set("attitude", "friendly");
        set("qi", 1000);
        set("max_qi", 1000);
        set("neili", 600);
        set("max_neili", 600);
		set("jiali",20);
        set_skill("force",80);
        set_skill("unarmed",85);
        set_skill("yunv-xinfa",80);
        set_skill("literate",80);
        set_skill("meinv-quan",85);
        set_skill("blade",90);
		    set_skill("parry",90);
        set_skill("dodge",90);
        set_skill("yunv-shenfa",90);
        set_skill("xiuluo-dao",90);
        map_skill("force","yunv-xinfa");
		map_skill("blade","xiuluo-dao");
        map_skill("parry","xiuluo-dao");
        map_skill("unarmed", "meinv-quan");
        map_skill("dodge","yunv-shenfa");
        set("inquiry", ([
		"文泰来" : "文泰来是我的先夫。\n",
		"红花会": "红花会志在反清复明。\n",
	]));
	setup();
	create_family("红花会",3,"女当家");
	carry_object("/d/honghua/obj/yuanyangdao")->wield();
  carry_object("/d/city/npc/obj/pink_cloth")->wear();
	add_money("silver", 80);
}
void attempt_apprentice(object ob)
{
     command("say “我们总舵主武功盖世，如果你诚心加入红花会，请去南疆找红花会总舵。”\n");
  }

