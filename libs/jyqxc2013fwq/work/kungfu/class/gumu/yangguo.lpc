// Last Modified by winder on Feb. 28 2001
// yangguo.c 杨过

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me();

void create() {
  set_name("杨过", ({ "yang guo", "yang" }));
  set("nickname", HIB "神雕大侠" NOR);
  set("gender", "男性");
  set("age", 26);
  set(
    "long",
    "他就是神雕大侠杨过，一张清癯俊秀的脸孔，剑眉入鬓，凤眼生威。\n虽然他只有一只胳膊，但是魁伟的身材仍让人感觉英气逼人。\n他剑法早已大成，偶尔瞒着小龙女去江湖中行侠仗义却已连木剑都不再用。\n在古墓中为了配合小龙女练习双剑合璧，才佩一把长剑在身。\n"
  );
  set("attitude", "heroism");
  set("shen", 200000);
  set("per", 28);
  set("str", 30);
  set("int", 37);
  set("con", 36);
  set("dex", 38);
  set("chat_chance", 5);
  set("chat_msg", ({
    "杨过叹了口气道：“龙儿，妳愿意陪我出去闯荡江湖吗？”\n",
    "杨过喃喃道：“独孤求败！独孤求败！你若在世可敢和我一战？”\n",
  }));
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "strike.xiaohun" :),
    (: exert_function, "recover" :),
    (: perform_action, "sword.xunlei" :),
    //	(: command("wield jian") :),
    //  (: command("unwield jian") :),
  }));

  set("qi", 90000);
  set("max_qi", 90000);
  set("jing", 90000);
  set("max_jing", 90000);
  set("jingli", 2000);
  set("max_jingli", 2000);
  set("neili", 40000);
  set("max_neili", 20000);
  set("jiali", 500);
  set("food", 1000);
  set("water", 1000);
  set("combat_exp", 12000000);
  set("score", 0);

  set_skill("force", 500);
  set_skill("nutao-shengong", 450);
  set_skill("sword", 500);
  set_skill("dodge", 400);
  set_skill("anran-zhang", 500);
  set_skill("yunv-shenfa", 350);
  set_skill("parry", 350);
  set_skill("finger", 200);
  set_skill("strike", 500);
  set_skill("literate", 120);
  set_skill("tanzhi-shentong", 200);
  set_skill("iron-sword", 500);
  map_skill("force", "nutao-shengong");
  map_skill("sword", "iron-sword");
  map_skill("dodge", "yunv-shenfa");
  map_skill("parry", "iron-sword");
  map_skill("strike", "anran-zhang");
  map_skill("finger", "tanzhi-shentong");
  prepare_skill("strike", "anran-zhang");
  create_family("古墓派", 4, "弟子");
  set("letter_count", 1);

  set("inquiry", ([
    "小龙女": "龙儿是在下的妻子。\n",
    "古墓派": "林祖师本来和重阳真人是一对情侣，可是...\n",
    "神雕": "你问雕兄？\n",
    "玄铁剑": "在下将玄铁剑送给郭二小姐了。\n",
  ]));
  //	set("env/wimpy", 40);
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/city/obj/cloth")->wear();
}
void init() {
  add_action("do_qiecuo", "qiecuo");
}

void attempt_apprentice(object ob) {
  command("say 好吧，我就收下你这个徒弟了。\n");
  command("recruit " + ob->query("id"));
  return;
}
