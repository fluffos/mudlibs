//标准客栈内厅
//所有的动作都要加上判断，看玩家是否有能力创建这个房间
//hotel1.c
#pragma save_binary

#include <ansi.h>
#include <changecolor.h>
inherit ROOM;
#include "/data/home/std_file/stdhotel1.lpc"
void create()
{
	set("short", "致远阁客栈总店内厅");//房间短描述，模板为ROOM_NAME
	set("long", @LONG
这是一个新的房间，你可以对它进行装修。
LONG
	);
	set("valid_startroom",0);
	set("host","pal");//所有者，模板里固定为pkuxkx
	set("roomvalue",50);//房间价值，初始为50，降到0就倒了
	set("room_ok",1);//是否好的房间
	set("selfcreate",1);
	set("exits", ([
//房间出口
		]));
	set("objects", ([
//房间有的物品
		]));
	restore();
	setup();
}
