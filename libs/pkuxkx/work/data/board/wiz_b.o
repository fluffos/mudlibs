obect target, int i, int j, int damagea , int damageb)[/code]pfm的主函数里最后调用[code] fun( me , target , i , 0 , damagea , damageb)[/code]然后就自动进入fun函数fun函数有三个if，有一个是退出条件，满足退出条件当然就退出pfm了，所以return不满足就判断另外两个if，另外两个if是伤害判断，call了一秒busy和双方伤害，然后 j+1 ，并且调用fun这样fun又被调用，自然就成循环了你看我的凌虚飞渡的remove_effct()函数，就是这个方法，参考一下吧[code] //太乙神游pfm凌虚飞渡，无门派强力dodge，但使用限制亦很多// 2009.8.17 finished by zgbl#include #include inherit F_SSERVER;int perform(object me, object target){      string msg;                                         int improve;      if( !target ) target = offensive_target(me);   if ((int)me->query(\\\"family\\\"))      return notify_fail(\\\"往矣，非曳尾涂中之士，如何领悟太乙正道？\\\\n\\\");   if (me->query_skill(\\\"hunyuan-yiqi\\\",1) > 0)      return notify_fail(\\\"往矣，非曳尾涂中之士，如何领悟太乙正道？\\\\n\\\");   if (me->query(\\\"betrayer\\\") > 0)      return notify_fail(\\\"往矣，非曳尾涂中之士，如何领悟太乙正道？\\\\n\\\");   if ((int)me->query(\\\"reborn/all\\\")>=1)      return notify_fail(\\\"往矣，非曳尾涂中之士，如何领悟太乙正道？\\\\n\\\");//有门派或者有过门派都无法使用，纯百姓技能               if( me->query_skill(\\\"taiyi-you\\\",1) < 150 )                return notify_fail(\\\"你提起一口气，身子飘飘欲飞，却怎么都起不来！\\\\n你的太乙神游不够娴熟，不能使用「凌虚飞渡」！\\\\n\\\");            if( me->query_skill(\\\"taiyi-shengong\\\",1) < 150 )                return notify_fail(\\\"你提起一口气，身子飘飘离地，挣扎了片刻，重重的摔了下来！\\\\n你的太乙神功等级不够，不能使用「凌虚飞渡」！\\\\n\\\");           if( me->query_dex() < 30 )                return notify_fail(\\\"你提起一口气，重重的一跺脚，跳起一尺……\\\\n你的身法太低，不能使用「凌虚飞渡」！\\\\n\\\");      if( me->query(\\\"qi\\\") < ((me->query(\\\"max_qi\\\"))/2) )             return notify_fail(\\\"你试着一提气，胸口顿时一阵剧痛！\\\\n你的气血太低，不能使用「凌虚飞渡」！\\\\n\\\");      if( !me->is_fighting())                return notify_fail(\\\"没战斗乱蹦什么，嫌内力多啊？\\\\n\\\");         if( me->query(\\\"neili\\\") < me->query(\\\"max_neili\\\")/4 )                return notify_fail(\\\"你一口气提到一半，胸口一浊，又泄了出来！\\\\n你的内力太少了，无法使用出「凌虚飞渡」！\\\\n\\\");             if (me->query_skill_mapped(\\\"dodge\\\") != \\\"taiyi-you\\\")                return notify_fail(\\\"不用太乙神游，谈何凌虚飞渡？\\\\n\\\");                                                                                    if( me->query_temp(\\\"taiyi-you\\\")   )                return notify_fail(\\\"你正在凌虚飞渡，难道你想下来？\\\\n\\\");             msg = HIC\\\"$N缓缓地吸一口长气，袍袖一拂，衣袂飘飞处，身体仿佛轻若无物！\\\\n$N向无尽的虚空中缓缓踏出一步，身体居然如有神助地飘了起来！\\\\n\\\" NOR;            message_vision(msg, me, target);       improve = (int)me->query_skill(\\\"taiyi-you\\\", 1)*2/5 + (int)me->query_dex() *10 - (int)me->query_skill(\\\"dodge\\\", 1);      me->add_temp(\\\"apply/dodge\\\", improve);      me->set_temp(\\\"taiyi-you\\\",1);        me->add(\\\"neili\\\", -(improve + 100));       //提升系数为太乙神游*2.5+先天身法*10                  call_out(\\\"remove_effect\\\", 1, me, (int)me->query_skill(\\\"taiyi-you\\\", 1),improve);      return 1;}void remove_effect(object me, int count,int improve){        if (!me) return;        if( me->query_skill_mapped(\\\"dodge\\\") != \\\"taiyi-you\\\"          || count < 1){           me->add_temp(\\\"apply/dodge\\\", - improve);           me->delete_temp(\\\"taiyi-you\\\");           tell_object(me, HIC\\\"你缓缓吐出一口浊气，飘飞的衣袂落了下来，双足轻轻点在地上。\\\\n\\\"NOR);           tell_room(environment(me), HIC + me->name()+\\\"缓缓吐出一口浊气，飘飞的衣袂落了下来，双足轻轻点在地上。\\\\n\\\" NOR,  ({ me }));           return;        }  //持续时间为太乙神游等级，切换dodge后pfm停止，避免连续使用dodge型pfm重复提高有效dodge  if( me->query(\\\"qi\\\") < ((me->query(\\\"max_qi\\\"))/2) ) {           me->add_temp(\\\"apply/dodge\\\", - improve);           me->delete_temp(\\\"taiyi-you\\\");           tell_object(me, HIR\\\"你再也承受不住连续的打击，胸口的内气一散，不得不落了下来。\\\\n\\\"NOR);           tell_room(environment(me), HIR + me->name()+\\\"再也承受不住连续的打击，胸口的内气一散，不得不落了下来。\\\\n\\\" NOR,  ({ me }));           return; } //若受伤导致当前气血低于50%则效果停止     if( me->query(\\\"neili\\\") < me->query(\\\"max_neili\\\")/4 ) {     me->add_temp(\\\"apply/dodge\\\", - improve);           me->delete_temp(\\\"taiyi-you\\\");           tell_object(me, HIR\\\"你内力逐渐枯竭，再也支撑不住飘飞的身体，不得不落了下来。\\\\n\\\"NOR);           tell_room(environment(me), HIR + me->name()+\\\"内力逐渐枯竭，再也支撑不住飘飞的身体，不得不落了下来。\\\\n\\\" NOR,  ({ me }));           return; } //内力消耗至最大内力1/4时效果停止 call_out(\\\"remove_effect\\\", 1 , me, count -1, improve); //循环调用，1s判定一次退出条件}[/code][2;37;0m","time":1250584031,"fid":"46","title":"Re:导师们来帮忙，我想在测试站做一个替代busy的新pfm，太极云手","author":"北侠巫师讨论区(zgbl)[2;37;0m","tid":"8098","authorid":"zgbl",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=79191&ptid=8098对了，if 里重复调用 fun（）的之前格式不对，是这样调用call_out(\\\"fun\\\", 1 , me, target , i , j , damagea , damageb);[2;37;0m","time":1250584150,"fid":"46","title":"Re:导师们来帮忙，我想在测试站做一个替代busy的新pfm，太极云手","author":"北侠巫师讨论区(zgbl)[2;37;0m","tid":"8098","authorid":"zgbl",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=79192&ptid=8098我可以很装b的对白菜说一句“朽木不可雕也”么yct45 yct45 yct45 yct45 yct45 yct45[2;37;0m","time":1250584162,"fid":"46","title":"Re:导师们来帮忙，我想在测试站做一个替代busy的新pfm，太极云手","author":"北侠巫师讨论区(picewolf)[2;37;0m","tid":"8098","authorid":"picewolf",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=79193&ptid=8098call_out(\\\"fun\\\", 1 这个就是1回合后再次调用fun，然后fun里进行判断，效果继续就继续call_out，就成一个心跳一次的循环了[2;37;0m","time":1250584173,"fid":"46","title":"Re:导师们来帮忙，我想在测试站做一个替代busy的新pfm，太极云手","author":"北侠巫师讨论区(zgbl)[2;37;0m","tid":"8098","authorid":"zgbl",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=79194&ptid=8098原来你是用call_out来实现1秒1次……[2;37;0m","time":1250584186,"fid":"46","title":"Re:导师们来帮忙，我想在测试站做一个替代busy的新pfm，太极云手","author":"北侠巫师讨论区(safeguard)[2;37;0m","tid":"8098","authorid":"safeguard",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=79195&ptid=8098对，就是这个意思，这个是我参考凌波微步的洛神写的，洛神也是做成一种状态，一秒判断一次退出条件，用的就是call_out循环[2;37;0m","time":1250584197,"fid":"46","title":"Re