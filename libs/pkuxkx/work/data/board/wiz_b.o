之力量，向$n作出的末日裁决！\\\\n\\\"NOR;       msg +=HIW\\\"	           ▃	           ▕█▍	           ▕█▍    ◢██◣	          ◢██▌◢█◤▕█▎	      ▄███◤▕██▌ █▍	  ▕█████▌◢██▎█▍	    ◥█◤▕██◤◢▋  █▆	          ◢█◤▕█▏   ◥█	        ▁██◢▇█▄▁ ▕█	       ███▎◢▉ ◥█▅█▍	      ▕██▊ █▌    ███◣	        ◤ █▍█ ▅▆█◤◥██▅	          ◥▌◤  ◥◤     ◥█◤\\\\n\\\\n\\\"NOR;       message_vision(msg,me,target);        //        ap=me->query_skill(\\\"wanxi-spells\\\");        if (apquery(\\\"combat_exp\\\")/100;                dp=(int)target->query_skill(\\\"dodge\\\")/2+(int)target->query_skill(\\\"parry\\\")/2;        if (dpquery(\\\"combat_exp\\\")/100;        dp2=target->query_cps();        dp2=dp2*dp2*dp2/10;        dp+=dp2;                l=(int)me->query_skill(\\\"literate\\\",1);     damage = 100 + (int)(me->query_skill(\\\"wanxi-spells\\\",1))+(int)me->query(\\\"mana_factor\\\")/2;    damage +=(int)(me->query_skill(\\\"force\\\",1))/2;	  damage=damage*8/10;        if(me->query_temp(\\\"magic_set\\\")) {           ap += ap/2;           damage += damage/2;         }        if(wizardp(me))          tell_object(me,sprintf(\\\"damage:%d,ap:%d,dp:%d\\\\n\\\",damage,ap,dp));// if (damage >450) damage = 400+random(50);                //第一招,阿瑞斯：Ares ，战神,必出，伤气血          msg = HIY\\\"\\\\n英俊的战神阿瑞斯，全身盔甲，手执长枪，二话不答，一声暴喊，长枪直指$n\\\\n\\\"NOR;            if((random((ap+dp)*3)>dp*3/4 && skill_wanxispells>=150 && l>=100)|| wizardp(me))        {        	msg+=\\\"$n还没有来得及思考，长枪从手臂刺过,溅了一身的鲜血。。\\\\n\\\";                target->receive_damage(\\\"kee\\\",damage*2,me,\\\"magic\\\");                message_vision(msg, me, target);               COMBAT_D->report_status(target);     	        }else 	{		msg += \\\"可是$n看破了阿瑞斯的企图，向后轻松跃开越开。\\\\n\\\" NOR;		message_vision(msg, me, target);	}        //第二招,赫斐斯托司：Hephaestus，火神,伤精神       if((random(3*(ap+dp))>dp && skill_wanxispells>=160 && l>110) || wizardp(me))        {          msg = HIR\\\"\\\\n火神赫斐斯托司，一身劲肉，携铁锤朝$n劈面一锤，隐隐带着火光之气\\\\n\\\"NOR;          msg+=\\\"$n一时恍惚，被砸得昏头昏脑。\\\\n\\\";          message_vision(msg, me, target);          target->receive_damage(\\\"sen\\\",damage*2,me,\\\"magic\\\");          COMBAT_D->report_sen_status(target);              	        }        //第三招,阿佛洛狄特（罗马又称维纳斯）：Aphrodite爱情女神,伤神 if((random(3*(ap+dp))>dp && skill_wanxispells>=160 && (int)me->query(\\\"sen\\\") > 1000 && l>120) || wizardp(me))        {          msg = HIW\\\"\\\\n维纳斯翩然而至，小爱神丘比特弯弓搭箭，向$n射出爱神之箭\\\\n\\\"NOR;          msg+=\\\"$n沐浴在维纳斯的美丽之中，竟然忘记了躲闪。\\\\n$n不由地愁容满面\\\\n\\\";          message_vision(msg, me, target);            target->receive_damage(\\\"sen\\\",damage*3,me,\\\"magic\\\");          COMBAT_D->report_sen_status(target);     	        }        //第四招,狄俄倪索斯（罗马又称巴古斯）：Dionysus，酒神与狂饮欢乐之神,伤气血和上限   if((random(5*(ap+dp)/2)>dp && skill_wanxispells>=180 && (int)me->query(\\\"sen\\\") > 1000 && l>130)|| wizardp(me))        {          msg = HIB\\\"\\\\n$N微一转身，狄俄倪索斯已到了$n面前\\\\n\\\"NOR;          msg+=\\\"$n在狄俄倪索斯酒气与狂欢的气氛不能自拔，越陷越深。\\\\n\\\";          message_vision(msg, me, target);           target->receive_damage(\\\"kee\\\",damage*2,me,\\\"magic\\\");          target->receive_wound(\\\"kee\\\",damage*3/2);          COMBAT_D->report_status(target);     	        }        //第五招,阿尔忒弥斯：Artemis ，月神，又是狩猎之神、妇女之神，是女性纯洁的化身,减内力       if((random(2*(ap+dp))>dp && skill_wanxispells>=220 && (int)me->query(\\\"sen\\\") > 1200 && l>150)|| wizardp(me))         {          msg = HIC\\\"\\\\n美丽漂亮的阿尔忒弥斯迅速跑过$n的身旁，在$n愕然之际，翩然回首，长箭已经洞穿了$n\\\\n\\\"NOR;          msg+=\\\"$n怅然地觉的好像失去了点什么。\\\\n\\\";          message_vision(msg, me, target); 	          if (target->query(\\\"force\\\") >damage*2)            target->add(\\\"force\\\",-damage*2);          else              target->set(\\\"force\\\",0);    //      COMBAT_D->report_status(target);     	        }        //第六招,阿波罗：Apollo，在诗与艺术中表现为光明、青春和音乐之神，又是太阳神，补血if((random(3*(ap+dp)/2)>dp && skill_wanxispells>=230 && (int)me->query(\\\"sen\\\") > 1200 && l>170)|| wizardp(me))        {          msg = HIR\\\"\\\\n在$N惊惶之际，太阳神阿波罗出现在$N的面前\\\\n\\\"NOR;          msg+=\\\"$N沐浴在和煦的阳光中，脸色逐渐红润起来。。。\\\\n$N不由深深地吸了口气\\\\n\\\"; message_vision(msg, me, target);           me->receive_heal(\\\"kee\\\",damage*3);          me->receive_curing(\\\"kee\\\",damage);            	        }        //第七招,雅典娜：Athena，起初被视为女战神,减气血和精神if((random(3*(ap+dp)/2)>dp && skill_wanxispells>=250 && (int)me->query(\\\"sen\\\") > 1200 && l>190)|| wizardp(me))        {          msg = HIY\\\"\\\\n主管胜利、智慧和技艺的战争女神雅典娜,一手执枪，一首执盾\\\\n\\\"NOR;          msg+=\\\"$n在雅典娜面前根本无力可施，大腿被长枪刺穿,鲜血直流。\\\\n\\\";          message_vision(msg, me, target);         target->receive_damage(\\\"sen\\\",damage*3,me);         target->receive_damage(\\\"kee\\\",damage*2,me);          COMBAT_D->report_status(target);     	        }        //第八招,哈得斯：Hades，冥王，司掌冥界，统治阴暗的世界,减法力      if((random(3*(ap+dp)/2)>dp && skill_wanxispells>=300 && (int)me->query(\\\"sen\\\") > 1200 && l>200)|| wizardp(me))        {         msg = HIW\\\"\\\\n$n突觉四周一片黑暗，浑不知道自己已经落入冥王哈得斯的手中\\\\n\\\"NOR;          msg+=\\\"$n只觉地浑身冷飕飕的，自己被抽走了点什么\\\\n\\\";          message_vision(msg, me, target);         if (target->query(\\\"mana\\\") >damage*3)             target->add(\\\"mana\\\",-damage*3);          else              target->set(\\\"mana\\\",0);    	        }        //第九招,德墨特尔：Demeter，大地女神，司丰收,同busy        if((random(3*(ap+dp)/2)>dp && skill_wanxispells>=340 && (int)me->query(\\\"sen\\\") > 1200 && l>220)|| wizardp(me))        {          msg = HIB\\\"\\\\n德墨忒尔天生胆小，在她的面前，$n和$N都不由放慢脚步，免得惊吓这位温和善良的大地女神\\\\n\\\"NOR;          message_vision(msg, me, target);          me->start_busy(random(3));          target->start_busy(1+random(3));        }        //第十招,波赛东：Poseidon，海王，海洋和水域的一切主宰,减内力法力        if((random(4*(ap+dp)/3)>dp && skill_wanxispells>=370 && (int)me->query(\\\"sen\\\") > 1200 && l>250)|| wizardp(me))        {          msg = HIB\\\"\\\\n在$n茫然的时候，海王波赛东的三叉戟已经刺到面前\\\\n\\\"NOR;          msg+=\\\"$n只能闭上眼睛胡乱招架，身形显得如此渺小.\\\\n\\\";          message_vision(msg, me, target);            if (target->query(\\\"mana\\\") >damage*5)             target->add(\\\"mana\\\",-damage*5);          else              target->set(\\\"mana\\\",0);          if (target->query(\\\"force\\\") >damage*5)             target->add(\\\"force\\\",-damage*5);          else              target->set(\\\"force\\\",0);          target->start_busy(2);    	        }        //第十一招,赫拉 ：Hera，宙斯的姐姐与妻子。是女性的代表，掌管婚姻和生育,伤气血和上限，精神和上限      if((random(4*(ap+dp)/3)>dp && skill_wanxispells>=330 && (int)me->query(\\\"sen\\\") > 1200 && l>280 && me->query(\\\"married\\\") == 1)|| wizardp(me))        {          msg = HIM\\\"\\\\n赫拉,神圣的婚姻女神,代$N的爱侣向$n发出了全力一击\\\\n\\\"NOR;          msg+=\\\"$n在这家庭的捍卫者前无可奈何地低下了头\\\\n一股鲜血狂飙而出，脸色变的无比苍白\\\\n\\\";          message_vision(msg, me, target);          target->receive_damage(\\\"sen\\\",damage*6,me);          target->receive_damage(\\\"kee\\\",damage*6,me);        target->receive_wound(\\\"sen\\\",damage*2);          target->receive_wound(\\\"kee\\\",damage*2);          COMBAT_D->report_status(target);           COMBAT_D->report_sen_status(target);     	     	        }        //第十二招,宙斯 ：Zeus，天神之父，地上万物的最高统治者,此招一出，对方必死,自己内力，法力耗光 if((random(ap+dp)>dp && skill_wanxispells>350 && l>320 && random(300)>295&& me->query_kar()>40)||wizardp(me))	{		msg = HIY\\\"\\\\n伟大的宇宙的主宰，地上万物的最高统治者，天神之父－－宙斯出现了。\\\\n\\\"NOR;		msg+=\\\"$n无法阻挡这巨大的神的力量，\\\\n在雷霆声中，$n受到了真正的末日审判\\\\n\\\";                message_vision(msg, me, target);                msg = \\\"据说\\\"+me->name()+\\\"的愤怒得到了\\\"HIR\\\"天神之父－－宙斯\\\"NOR+HIM\\\"的同情，不知道谁又会被宙斯惩罚至死了！\\\\n\\\"NOR;                if (!wizardp(me))                message(\\\"channel:rumor\\\",HIM\\\"【道听途说】某人：\\\"+msg+\\\"\\\\n\\\"NOR,users());		me->start_call_out( (: call_other, __FILE__, \\\"kill_him\\\", me, target :), 2);			     me->add(\\\"force\\\",-1000);if (me->query(\\\"force\\\")set(\\\"force\\\",0);      me->add(\\\"mana\\\",-1000);if (me->query(\\\"mana\\\")set(\\\"mana\\\",0);	}         me->start_busy(1+random(4));       if( !target->is_fighting(me) ) {                if( living(target) ) {                        if( userp(target) ) target->fight_ob(me);                        else target->kill_ob(me);                }        }  return 3+random(4);}void kill_him(object me, object target){	string msg;	if( ! target || !me )		return;	//bugbug,2002-6-8	if(me->is_fighting() && target->is_fighting() &&	environment(me) == environment(target))	{		msg =HIR\\\"\\\\n$n只觉得眼前一花，一股血箭喷涌而出．．$n的眼睛死鱼般的突了出来．．\\\\n\\\" NOR;                target->receive_damage(\\\"sen\\\",target->query(\\\"max_sen\\\")+1);                target->receive_wound(\\\"sen\\\", (int)target->query(\\\"max_sen\\\")+1);                target->receive_damage(\\\"kee\\\",target->query(\\\"max_kee\\\")+1);                target->receive_wound(\\\"kee\\\", (int)target->query(\\\"max_kee\\\")+1);                msg+=HIR\\\"\\\\n$N轻蔑的看了一眼$n的尸体，擦了擦头上的细汗．．\\\\n\\\" NOR;                COMBAT_D->report_status(target);                message_vision(msg, me, target);                	        	        		target->heart_beat();	}	return ;}[2;37;0m","time":1245319172,"fid":"6789","title":"46","author":"Re:现在的系统里有没有这个？[2;37;0m","tid":"帖子内容开始标记","authorid":"北侠巫师讨论区()",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=65766&ptid=6789for your information看最后一招[2;37;0m","time":1245319430,"fid":"46","title":"Re:现在的系统里有没有这个？","author":"北侠巫师讨论区(whuan)[2;37;0m","tid":"6789","authorid":"whuan",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=65767&ptid=6789这个pfm告诉我们，有丰富的想象是多么的重要啊以前iszt share过一个五行毒，让我觉得其实我们不是缺少代码编写的能力，而是想象力不够[2;37;0m","time":1245319442,"