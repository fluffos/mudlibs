 notify_fail(\\\"你只能对战斗中的对手使用「狂风二十一式」。\\\\n\\\");        if (!(weapon = me->query_temp(\\\"weapon\\\")) || weapon->query(\\\"skill_type\\\") != \\\"blade\\\")                return notify_fail(\\\"你必须拿刀才能施展「狂风二十一式」。\\\\n\\\");        if( (int)me->query_skill(\\\"kuangfeng-dao\\\",1) < 180)                return notify_fail(\\\"你目前功力还使不出「狂风二十一式」。\\\\n\\\");        if( (int)me->query(\\\"neili\\\") < 200 )                return notify_fail(\\\"你的内力不够。\\\\n\\\");                        me->add(\\\"neili\\\", - 200);        msg = HIC\\\"$N淡然一笑，本就快捷绝伦的刀法骤然变得更加凌厉！就在这一瞬之间，\\\\n\\\" + \\\"$N已劈出二十一刀！刀夹杂着风，风里含着刀影！$n只觉得心跳都停止了！\\\\n\\\"NOR;        time = (int)me->query_skill(\\\"kuangfeng-dao\\\",1) / 20;        if (time > 10)  time = 10;        if( random(me->query(\\\"combat_exp\\\")) > (int)target->query(\\\"combat_exp\\\")/3 ){                if(!target->is_busy() && random(2) == 0){                       msg += HIC\\\"$n霎时被刀气所逼，直冒冷汗，动弹不得！\\\\n\\\"NOR;                       target->start_busy( time );                }                damage = (int)me->query_skill(\\\"kuangfeng-dao\\\",1) + (int)me->query_skill(\\\"blade\\\", 1) + me->query(\\\"jiali\\\");                damage += random(damage/2);                if (wizardp(me)) tell_object(me, \\\"damage = \\\" + damage +\\\"\\\\n\\\");                target->receive_damage(\\\"qi\\\", damage, me);                target->receive_wound(\\\"qi\\\", damage/2, me);                msg += RED\\\"只见$n已被$N切得体无完肤，血如箭般由全身喷射而出！\\\\n\\\"NOR;                                                                p = (int)target->query(\\\"qi\\\")*100/(int)target->query(\\\"max_qi\\\");                msg += \\\"( $n\\\"+eff_status_msg(p)+\\\" )\\\\n\\\";                  me->add(\\\"neili\\\", -me->query(\\\"jiali\\\")/2);        }         else{                msg += HIC \\\"可是$p急忙抽身躲开，$P这招没有得逞。\\\\n\\\" NOR;                [color=red]me->start_busy( time / 2 );[/color][color=red]                我想这里的代码的意思是如果失败，自己busy的时间是time/2，最长5秒吧[/color][color=red]                狂的命中够高了，失败惩罚应该大一点[/color]        }        message_combatd(msg, me, target);         [color=red]me->start_busy(2);[/color][color=#ff0000]        不管成功还是失败，这里的start_busy都会执行到，那就是说失败惩罚也被这个2秒的busy替代掉了，那就是用kuang，自身的busy永远是2了？[/color]        return 1;}>[2;37;0m","time":1250842644,"fid":"46","title":"新的start_busy会取代老的吧？","author":"北侠巫师讨论区(safeguard)[2;37;0m","tid":"8196","authorid":"safeguard",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=80926&ptid=8196看一下action.c，北侠的action.c加了一个add_busy()[2;37;0m","time":1250844444,"fid":"46","title":"Re:新的start_busy会取代老的吧？","author":"北侠巫师讨论区(ddid)[2;37;0m","tid":"8196","authorid":"ddid",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=80932&ptid=8196会被替代[2;37;0m","time":1250846244,"fid":"46","title":"Re:新的start_busy会取代老的吧？","author":"北侠巫师讨论区(whuan)[2;37;0m","tid":"8196","authorid":"whuan",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=80941&ptid=8196那像这样的小bug要改掉吗？[2;37;0m","time":1250851644,"fid":"46","title":"Re:新的start_busy会取代老的吧？","author":"北侠巫师讨论区(safeguard)[2;37;0m","tid":"8196","authorid":"safeguard",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=80970&ptid=8202这是自己做的一个风云系统里的文件。 这个文件是一个随机宝石文件，拿到后用命令qian  with stone就可增加定制武器的属性。可以正常增加属性，但是问题在于不能成功存储，因此quit后再进来属性就又回去了。存储操作在文件的第75行：num = weapon->save();为了调试后面加了行输出，可以看出save()总是返回0. 但是用qian命令增加属性后，手工用 call ->save()又可以正常保存。 麻烦哪位大侠给看看问题在哪里，怎么解决？多谢了！[2;37;0m","time":1250862445,"fid":"38","title":"【求助】帮忙看看这个文件有什么问题","author":"巫师园地版(bizika)[2;37;0m","tid":"8202","authorid":"bizika",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=80975&ptid=8202根据现象来看，很可能是权限的问题，就是不知道怎么解决它[2;37;0m","time":1250863045,"fid":"38","title":"Re:【求助】帮忙看看这个文件有什么问题","author":"巫师园地版(bizika)[2;37;0m","tid":"8202","authorid":"bizika",]),(["msg":"本帖地址：http://pkuxkx.net/fo