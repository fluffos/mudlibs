\\"west\\\" : __DIR__\\\"shulin8\\\",		\\\"north\\\" : __DIR__\\\"shulin\\\"+(random(10)+2),	]));准备把松林中的一个地点(shulin14.c）加一个init()，（类似峨嵋的云海），就能保证多次走动会触发陷阱。void init(){  		object me = this_object();		\\\"east\\\" : __DIR__\\\"shulin\\\"+(random(10)+2),		\\\"south\\\" : __DIR__\\\"qyping\\\",		\\\"west\\\" : __DIR__\\\"shulin8\\\",		\\\"north\\\" : __DIR__\\\"shulin\\\"+(random(10)+2),}[2;37;0m","time":1356607936,"fid":"46","title":"少林松林无法触发陷阱问题","author":"北侠巫师讨论区(all)[2;37;0m","tid":"32411","authorid":"all",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=394905&ptid=32411如果加上这个最好每次走动就触发一次，或者最少间隔1s才会触发一次，否则很容易互相扰乱。因为每次进入房间不止触发一次init[2;37;0m","time":1356612736,"fid":"46","title":"Re:少林松林无法触发陷阱问题","author":"北侠巫师讨论区(seagate)[2;37;0m","tid":"32411","authorid":"seagate",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=394910&ptid=32411我不太懂，一个人进入一个房间会触发多个init么？我看其他一些随机迷宫是这样写的。[2;37;0m","time":1356614536,"fid":"46","title":"Re:少林松林无法触发陷阱问题","author":"北侠巫师讨论区(all)[2;37;0m","tid":"32411","authorid":"all",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=394913&ptid=32411其实也没有关系，不过友好起见加一下比较好。任何和房间的互动都会触发init，所以不止一次，没啥问题，就是如果更新房间以后记录时间，时间太短不更新，这样我觉得更友好一点[2;37;0m","time":1356614547,"fid":"46","title":"Re:少林松林无法触发陷阱问题","author":"北侠巫师讨论区(seagate)[2;37;0m","tid":"32411","authorid":"seagate",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=&ptid=32422北侠的世界设计规则：1.玩家的装备。1.1武器的伤害不可以超过500。1.2全身防具防御之和不可以超过2000。2.任务奖励。2.1如有新开发主流任务(非限定次数类任务)，奖励幅度不要超过200k/小时，可用CD时间+奖励函数来控制，并大致估算任务实际时间(完成任务流程平均时间)和单个任务周期的比例(cd时间)，请在wiki开发文档注明。方便其他巫师对于玩家总体获得经验比例有个大致的印象。2.2高级任务的奖励相对设定得更加独特一点，但因为奖励不仅仅涉及常规的经验潜能奖励，如设计的奖励与其他高级任务相同或相似，请联系相关巫师商量一个合理的范围，避免出现例如a,b二任务都提供武功级别提升奖励，a任务难度远低于b任务的情况。2.3在任务开放初期，开发者尽可能多的关注玩家log。新任务奖励可在奖励函数中增加日志记录。举例：log_file(\\\"user/pyh\\\",sprintf(\\\"%s于%s获得经验%d，总计漂流%d里，杀贼系数：%f。多人任务：%d\\\\n\\\",me->query(\\\"id\\\"),ctime(time()),exp,me->query_temp(\\\"pyh/downflow\\\"),to_float(me->query_temp(\\\"pyh/count\\\"))+me->query_temp(\\\"pyh/extra_count\\\"),flag));这是鄱阳湖寻宝任务的log记录，如发现异常尽快修正。一般而言，任务稳定运行过一段时间后出现奖励异常/bug的情况会大大下降。2.4任务奖励用REWARDD控制，具体可以参考文件/adm/daemons/rewardd.c3.天赋、隐藏属性等一些玩家参数的修改需要符合尽量难度一致的原则。3.1如铜雀台提供了8点积分换得一点天赋修正(比如把1点根骨转化成1点身法)，那么如果设计了新的天赋更改方式，则需玩家付出与之前设定大体一致的代价。又如剿匪提供了可以消除死亡损失的天魔解体，其他任务如有相似奖励，必须有对应相似难度和任务频度。4.quest的设计。4.1quest的奖励必须留有日志文件。4.2如涉及先天属性的增加，除日志文件外还需记录在玩家身上。例如：user->add(\\\"xiantian/con/2005zq\\\",1)4.3quest因为其只能一人解一次的特点，没有一个严格的性比价约束，但应尽量避免过高的奖励出现(降低人物成长周期)。如奖励身外物(黄金，宝石等等)必须考虑到可能出现的玩家用大米刷奖励的情况。而自身属性尤其是先天的奖励更需慎重，因为可能已存在的quests已经奖励了先天，也许每个只能完成一次的quest奖励1，2点先天并不是很大的数值，而很多个这样的quests放在一起，就有可能导致玩家属性大大超过正常和设计者预期了。5.地图的设计。5.1尽量接近真实的设计地图，避免出现诸如A room east连接B room，但B room west连接到了C room这样的情况。(必要的quest迷宫不在此列)5.2为了降低玩家不断提高的获取经验速度，北侠现在的区域划分为5大块河北，西域，江南，中原，西南，分别使用了长江黄河，蜀道等方式降低玩家跨区域的速度，如非十分必要，绝对不要增加其他途径连接不同的大区域。5.3重新设计某区域，请尽量保留其主干路径，如扬州从北门到南门是9步，东门到西门是11步，可以把不合理的十字形结构改成真实的城市网状或者其他合理的分布形态，但尽量保留主干道路的不变，这样玩家不需要改变大量的alias,trigger去适应。6.新的独立系统的开发。6.1需要考虑的是，新的体系在突出自己特色的情况下，尽量去适应老的体系，否则要修改的地方将会是海量的。6.2如非将彻底废除一个老的体系，新的体系尽量不要出现和老的体系完全颠覆性的设计。6.3新系统奖励、回报在开放初期就低不就高，如果性价比低，可以以后慢慢加，反过来，如果玩家获益过高，再想降低就很容易起争执了。7.尽量不要开发不符合武侠氛围的东西。7.1比如可以飞，比如可以不坐船过江过河(这里指长江黄河，或者今后如开发著名地标类地貌，轻功一展，飞跃了太湖显然也是不符合金庸武侠世界的逻辑的)7.2现代名称的物品(比如手表)，尽量不要出现在玩家正常可获得的途径渠道中，如为节日或特殊事件开发的道具奖品则不在此规则限制。7.3各类描述尽量符合金庸武侠的氛围。8.其他8.1所有已存在wiki文档中的类别改动必须由修改者同步修改wiki文档。不存在于wiki文档的改动视重要程度由改动或开发者加入wiki文档。[2;37;0m","time":1356655940,"fid":"46","title":"北侠世界设计规则(求大家完善和去除不合理的条目)，上次巫师大会已经共享过了","author":"北侠巫师讨论区(zine)[2;37;0m","tid":"32422","authorid":"zine",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=&ptid=32423也许是个馊主意。把跟战斗相关的一些主要命令，比如kill，killall，hit，hitall，perform等加上fullme限制，不fullme不让用。可以把限制放宽一些，比如deactivity[2;37;0m","time":1356658342,"fid":"46","title":"想到一个对付自动机器人的方法","author":"北侠巫师讨论区(all)[2;37;0m","tid":"3242