想去打开柜门，却隐约听到外面有响动，吓得$N连忙缩回手来。\\\\n\\\", me);return 1;}}else{message_vision(\\\"$N伸手去开柜门，门外却总有侍卫走来走去，看来最近皇宫里不太平，禁戒森严。$N只好悻悻得收回手来。\\\\n\\\", me);return 1;}}[/code]然后是do_move函数[code]  [/code][code]int do_move(string arg){object ob, book;object me = this_player();int nowtime = time();int level, kar;if (!arg || arg != \\\"bedding\\\") return 0;if (objectp(ob = present(\\\"huang taihou\\\", environment(me))) && living(ob) && ob->query(\\\"fake\\\") ){ob->kill_ob(me);return 1;}if (query(\\\"time2\\\") < nowtime ){if(me->query(\\\"taihou/time2\\\") < nowtime){switch(random(5)){case 4:message_vision(\\\"$N掀开被褥，见床板上有个小铜环，伸指一拉，一块阔约一尺、长约二尺的木板应手而起，下面是个长方形的暗格，赫然放着一本《四十二章经》，$N欣喜若狂，立刻将经书放入怀内。\\\\n\\\", me);book = new(\\\"/d/beijing/npc/obj/book42_7\\\");book->move(me);break;case 3:message_vision(\\\"$N掀开被褥，见床板上有个小铜环，伸指一拉，一块阔约一尺、长约二尺的木板应手而起，下面是个长方形的暗格，放着些珠宝银票。\\\\n\\\", me);ob = new(\\\"/clone/money/thousand-cash\\\");ob->move(environment(me));break;default:message_vision(\\\"$N掀开被褥，见床板上有个小铜环，伸指一拉，一块阔约一尺、长约二尺的木板应手而起，下面是个长方形的暗格，里面空无一物。\\\\n\\\", me);break;}set(\\\"time2\\\", 900+nowtime);level = me->query(\\\"level\\\");kar = me->query(\\\"kar\\\");me->set(\\\"taihou/time2\\\", nowtime+3600*60/(level+kar));return 1;}else{message_vision(\\\"$N伸手去掀被褥，却隐约听到外面有响动，吓得$N连忙缩回手来。\\\\n\\\", me);return 1;}}else{message_vision(\\\"$N伸手去掀被褥，门外却总有侍卫走来走去，看来最近皇宫里不太平，禁戒森严。$N只好悻悻得收回手来。\\\\n\\\", me);return 1;}}[/code]大家帮忙看看有没有问题[2;37;0m","time":1275494657,"fid":"46","title":"Re:白菜大神工作讨论帖","author":"北侠巫师讨论区(safeguard)[2;37;0m","tid":"14029","authorid":"safeguard",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=156228&ptid=14029good，完全支持！[2;37;0m","time":1275531259,"fid":"46","title":"Re:白菜大神工作讨论帖","author":"北侠巫师讨论区(whuan)[2;37;0m","tid":"14029","authorid":"whuan",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=1