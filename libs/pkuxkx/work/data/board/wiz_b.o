		return;	}*///whuan 解除内力为负而引起的死亡	// Do attack if we are fighting.	if( is_busy() ) {		continue_action();		// We don\\'t want heart beat be halt eventually, so return here.		return;	} else {		continue_exert();		continue_perform();		// Is it time to flee?		if( is_fighting()		&&      intp(wimpy_ratio = (int)query(\\\"env/wimpy\\\"))		&&      wimpy_ratio > 0		&&      (       my[\\\"qi\\\"] * 100 / my[\\\"max_qi\\\"] chat();				// chat() may do anything -- include destruct(this_object())			}			else //如果经验相对上次杀害npc增长超过1000，则判断为完成任务，相应降杀气 by icer			if ((this_object()->query(\\\"combat_exp\\\")-this_object()->query_temp(\\\"last_killer_exp\\\")>1000) 				&& (this_object()->query_temp(\\\"last_killer_exp\\\")!=0))			{				tell_object(this_object(),\\\"你感觉自己的性情平和了许多，心中的杀气也减少了。\\\\n\\\");				this_object()->set(\\\"shaqi\\\",(int)(this_object()->query(\\\"shaqi\\\")/2));				this_object()->set_temp(\\\"last_killer_exp\\\",this_object()->query(\\\"combat_exp\\\"));			}	if( tick--  ) return;	else tick = 5 + random(10);	cnd_flag = update_condition();	// If we are compeletely in peace, turn off heart beat.	// heal_up() must be called prior to other two to make sure it is called	// because the && operator is lazy :P	if( ((cnd_flag & CND_NO_HEAL_UP) || !heal_up())	&&      !is_fighting() 	&&      !interactive(this_object())) {		if( environment() ) {			ob = first_inventory(environment());			while(ob && !interactive(ob))				ob = next_inventory(ob);		}		if( !ob ) set_heart_beat(0);	}	if( !interactive(this_object()) ) return;	// Make us a bit older. Only player\\'s update_age is defined.	// Note: update_age() is no need to be called every heart_beat, it	//       remember how much time has passed since last call.	this_object()->update_age();	if(query_idle(this_object()) > IDLE_TIMEOUT			&& this_object()->query(\\\"noDeadNetnoIdle\\\") != \\\"Pkuxkx\\\")		this_object()->user_dump(DUMP_IDLE);}修改：void heart_beat(){	int wimpy_ratio, cnd_flag;	mapping my;	object ob, obj;	my = query_entire_dbase();	obj = this_object();	if(!query_temp(\\\"have_block_last_line\\\"))	{		//write(ESC+\\\"[2;25r\\\");		set_temp(\\\"have_block_last_line\\\",1);	}	//write(ESC+\\\"[s\\\"+ESC+\\\"[1;1f\\\"+HIY+BGRN+\\\"        \\\"+ctime(time())+NOR+ESC+\\\"[u\\\");	// If we are dying because of mortal wounds?	if( my[\\\"eff_qi\\\"] < 0 || my[\\\"eff_jing\\\"] < 0) {		remove_all_enemy();		die();		return;	}	// If we\\'re dying or falling unconcious?	if( my[\\\"qi\\\"] < 0 || my[\\\"jing\\\"] < 0) {		remove_all_enemy();//                  if (query(\\\"disable_type\\\") != \\\"\\\")		       if (!living(obj))			  die();		else unconcious();		return;	}/*	if ( my[\\\"neili\\\"] < 0 || my[\\\"jingli\\\"] < 0) {		remove_all_enemy();		if (my[\\\"neili\\\"] < 0)			my[\\\"neili\\\"] = 0;		if (my[\\\"jingli\\\"] < 0)			my[\\\"jingli\\\"] = 0;		unconcious();		return;	}*///whuan 解除内力为负而引起的死亡	// Do attack if we are fighting.	if( is_busy() ) {		continue_action();		// We don\\'t want heart beat be halt eventually, so return here.		return;	} else {		continue_exert();		continue_perform();		// Is it time to flee?		if( is_fighting()		&&      intp(wimpy_ratio = (int)query(\\\"env/wimpy\\\"))		&&      wimpy_ratio > 0		&&      (       my[\\\"qi\\\"] * 100 / my[\\\"max_qi\\\"] chat();				// chat() may do anything -- include destruct(obj)			}			else //如果经验相对上次杀害npc增长超过1000，则判断为完成任务，相应降杀气 by icer			if ((obj->query(\\\"combat_exp\\\")-obj->query_temp(\\\"last_killer_exp\\\")>1000) 				&& (obj->query_temp(\\\"last_killer_exp\\\")!=0))			{				tell_object(obj,\\\"你感觉自己的性情平和了许多，心中的杀气也减少了。\\\\n\\\");				obj->set(\\\"shaqi\\\",(int)(obj->query(\\\"shaqi\\\")/2));				obj->set_temp(\\\"last_killer_exp\\\",obj->query(\\\"combat_exp\\\"));			}	if( tick--  ) return;	else tick = 5 + random(10);	cnd_flag = update_condition();	// If we are compeletely in peace, turn off heart beat.	// heal_up() must be called prior to other two to make sure it is called	// because the && operator is lazy :P	if( ((cnd_flag & CND_NO_HEAL_UP) || !heal_up())	&&      !is_fighting() 	&&      !interactive(obj)) {		if( environment() ) {			ob = first_inventory(environment());			while(ob && !interactive(ob))				ob = next_inventory(ob);		}		if( !ob ) set_heart_beat(0);	}	if( !interactive(obj) ) return;	// Make us a bit older. Only player\\'s update_age is defined.	// Note: update_age() is no need to be called every heart_beat, it	//       remember how much time has passed since last call.	obj->update_age();	if(query_idle(obj) > IDLE_TIMEOUT			&& obj->query(\\\"noDeadNetnoIdle\\\") != \\\"Pkuxkx\\\")		obj->user_dump(DUMP_IDLE);}[2;37;0m","time":1246586603,"fid":"46","title":"this_object(),this_player()等函数耗时问题。","author":"北侠巫师讨论区(bfmgqy)[2;37;0m","tid":"7152","authorid":"bfmgqy",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=69169&ptid=7153现在在论坛里面一点击mantis直接从论坛转向mantis，想看论坛的话还要重新打开一个窗口，很麻烦，能否改改[2;37;0m","time":1246587203,"fid":"46","title":"能否将mantis连接改成弹出式连接","author":"北侠巫师讨论区(bfmgqy)[2;37;0m","tid":"7153","authorid":"bfmgqy",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=69175&ptid=7153按住shift点...[2;37;0m","time":1246588403,"fid":"46","title":"Re:能否将mantis连接改成弹出式连接","author":"北侠巫师讨论区(vast)[2;37;0m","tid":"7153","authorid":"vast",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=69180&ptid=7153用TT浏览器，直接把链接拖一下，就可以有新标签页打开……[2;37;0m","time":1246589003,"fid":"46","title":"Re:能否将mantis连接改成弹出式连接","author":"北侠巫师讨论区(zgbl)[2;37;0m","tid":"7153","authorid":"zgbl",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=69188&ptid=7152好的习惯是先获得一个引用，避免函数调用。但是性能不是最主要的考虑，而是代码的可读性。性能优化第一天条：在没有数据，不知道瓶颈之前，不要