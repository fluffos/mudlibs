[0868]                        else if( water > 80 ) tell_room(me,\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地的水分渐渐地蒸发,看起来并无大碍。\\\\n\\\");[0869]                        else if( water > 60 ) tell_room(me,\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地的水分渐渐地蒸发,叶片有点儿发黄发蔫，好像是缺水了。\\\\n\\\");[0870]                        else if( water > 40 ) tell_room(me,\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地的水分渐渐地蒸发,看起来必须得浇点儿水了。\\\\n\\\");[0871]                        else if( water > 20 ) tell_room(me,\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地的水分渐渐地蒸发,叶片快被晒干了，赶快浇水吧。\\\\n\\\");[0872]                        else if( water > 0 ) tell_room(me,\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地的水分渐渐地蒸发,再不浇水就旱死了。\\\\n\\\");[0873]                        set(\\\"plant/\\\"+slot+\\\"/\\\"+plant+\\\"/water\\\",water);[0874]                } >> 未完继续 91%  200 ) grass = 199;[0878]                        str=\\\"一阵风吹过，不知从哪儿又吹来了几颗野草的种子，\\\";[0879]                        if( grass < 20 ) tell_room(me,str+\\\"野草开始在\\\"+\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地里面发芽了。\\\\n\\\");[0880]                        else if( grass < 40 ) tell_room(me,str+\\\"野草在\\\"+\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地里面茁壮地成长。\\\\n\\\");[0881]                        else if( grass < 80 ) tell_room(me,str+\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地里面野草已经满地都是了。\\\\n\\\");[0882]                        else if( grass < 150 ) tell_room(me,str+\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地里面满地里已经看不到你种的作物。\\\\n\\\");[0883]                        else if( grass < 200 ) tell_room(me,str+\\\"第\\\"+slot+\\\"块\\\"+name+\\\"地再不除草，你的\\\"+name+\\\"就绝收了。\\\\n\\\");[0884]                        set(\\\"plant/\\\"+slot+\\\"/\\\"+plant+\\\"/grass\\\",grass);[0885]                }[0886]                [0887]                if( water > 100 ) j=200-water;[0888]                else j=water;   [0889]                [0890]                if( grass > 20 || 100-j > 10)[0891]                outcome=outcome-(outcome-j*(200-grass)*outcome/20000)/50;[0892]                 [0893]        