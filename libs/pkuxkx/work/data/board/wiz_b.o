ller=new(__DIR__\\\"killer\\\"+newkiller);          killer->do_copy(me);          where = TASK_D->random_place();          me->set_temp(\\\"yidao/where\\\",TASK_D->place_belong(where));          me->set_temp(\\\"yidao/killer\\\",killer->query(\\\"name\\\"));          me->set_temp(\\\"yidao/target_ob\\\",killer); //加一个判断                  message_vision(\\\"$N说道：“你有种去\\\"+TASK_D->place_belong(where)          +\\\"找我兄弟\\\"+killer->query(\\\"name\\\")+\\\"(\\\"+killer->query(\\\"id\\\")          +\\\")，他会给我报仇的！”\\\\n\\\",this_object());          killer->move(where);          for (i=0;irandom_move();      }     else   message_vision(\\\"$N长叹道：“人算不如天算，想不到我兄弟五人都栽在你的手中！”\\\\n\\\",this_object());                     ::die();}红色字部分是我添加的，具体位置在u/haiv/huyidao目录里边的killer.h[2;37;0m","time":1279790052,"fid":"46","title":"来帮帮忙吧，解决不了了","author":"北侠巫师讨论区(haiv)[2;37;0m","tid":"14793","authorid":"haiv",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=167532&ptid=14793问题解决了，呵呵[2;37;0m","time":1279800852,"fid":"46","title":"Re:来帮帮忙吧，解决不了了","author":"北侠巫师讨论区(haiv)[2;37;0m","tid":"14793","authorid":"haiv",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=167557&ptid=14793die里用this_player()不知道会怎么样。[2;37;0m","time":1279809852,"fid":"46","title":"Re:来帮帮忙吧，解决不了了","author":"北侠巫师讨论区(jason)[2;37;0m","tid":"14793","authorid":"jason",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=167723&ptid=1544[quote]原帖由 [i]zgbl[/i] 于 2010-7-18 11:34 AM 发表 [url=http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=166437&ptid=1544][img]http://pkuxkx.net/forum/images/common/back.gif[/img][/url]围观古董老水车，顺便support那四个，话说我居然都认识- -另，support hash [/quote]香蕉 我想我是 萨维奥拉在你来以后还诈尸过?????[2;37;0m","time":1279871054,"fid":"38","title":"Re:俺有一个梦想","author":"巫师园地版(hash)[2;37;0m","tid":"1544","authorid":"hash",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=168082&ptid=14845