)，返回物件所对应的文件名。  gender.c    函数gender_self，gender_pronoun，返回一些称呼。message.c message_vision(string msg,object me,object you)，   一个很常用的输出函数，会把字符串msg中的$N转化为me的名字，      把$n转化为you的名字。    tell_object(object ob,string msg)，常用输出函数，只把msg输出给物件ob。    tell_room(mixed ob,string msg,object *exclude)，常用输出函数。    shout(string msg)，好象只在巫师指令shout中用到。    write(string msg)，很常用的输出函数，简单地输出一个字符串msg。    say(str,mixed exclude)  object.c    int getoid(object ob)，返回物件ob的编号。    string file_owner(string file)，返回文件file的拥有者。    string domain_file(string file)，返回该文件所在的区域，    如：文件/d/death/gate.c所在区域就是death。在分区域       管理地图时，这个函数应该有不错的利用价值。    string creator_file(string file)，返回文件的创建者。    string author_file(string file)，返回文件的作者。    destruct(object)，把物件ob从内存中清除。  path.c    string user_cwd(string name)，    string user_path(string name)，返回叫name的巫师的工作目录。    string resolve_path(string cur,string new_path)，根据当前       目录sur，和新的路径，返回一个全路径名。  wizard.c    wizhood----->SECURITY_D->get_status    wiz_level----->SECURITY_D->get_wiz_level3./adm/daemons/  aliasd.c    定义了几个简化命令。  channeld.c    频道精灵  chard.c    设置人种、创建尸体。  chinesed.c    处理中文。  cmd_d.c    命令控制。  combatd.c    战斗精灵。  emoted.c    表情精灵。  fingerd.c    查询用的几个函数。  ftpd.c    文件传输精灵？  inquiryd.c缺省询问控制。 logind.c    连线精灵。  natured.c    天气精灵？  profiled.c    系统资源精灵？  rankd.c    称呼精灵？  securityd.c    权限管理精灵。  virtuald.c    就定义了一个object compile_object(object ob){return 0;}    的函数，不知道是干吗用的。  race/human.c    人类缺省属性设置  race/beast.c  race/monster.c    兽类缺省属性设置  network/*.c    网络互连模块  注：该目录下的文件可扩展性很强，是巫师经常修改的地方。      也可以自己添加××精灵，我就在风云再起中添加了一      个奖励精灵，主管一切恩怨和杀人后的奖励。4./feature/  action.c：动作类函数    start_busy(mixed new_busy,mixed new_interrupt)，设置busy    query_busy()，检查busy    is_busy(),判断是否在busy中    continue_action()，被heart_beat()调用，以修改busy大小，        即心跳一次，busy减1。    interrupt_me(object who,string how)，因故中断某个过程        (如以前的命令stop就是调用该函数)。    start_call_out(function fun,int delay)    eval_function(function fun)，定时(delay)启动函数fun。  apprentice.c：师徒类函数    is_apprentice_of(object ob)，判断ob是不是这个人的徒弟    assigh_apprentice(strin title,int privs)，指定头衔    create_family(string family_name,int generation,string title)，创建门派。    recruit_apprentice(object ob)，收ob为徒  alias.c：控制玩家所有输入命令以及命令别名(alias)    mapping alias;命令别名映射    string process_input(string str)，对玩家输入的命令进行处理    query_all_alias()，返回所有的命令别名  attack.c    object *enemy;正在厮杀的敌人的数组    string *killer;曾经厮杀过的id的数组(a对hunter下了kill指令,        hunter就加入到这个数组里去了;a在路上遇见一个叫hunter的        玩家,两人就打起来了)    query_enemy()    query_killer()    is_fighting(object ob)：判断是否正在和ob打架    is_killing(object ob)：判断是否正在和ob厮杀    fight_ob(object ob)：和ob打架    kill_ob(ob)：和ob厮杀    want_kill(ob)：和ob厮杀    clean_up_enemy()：退出战斗    remove_enemy(ob)：和ob停止打架    remove_killer(ob)：和ob停止厮杀    remove_all_enemy()：停止所有战斗，但还记仇(killer不变)    remove_all_killer()：停止所有的打架和厮杀    reset_action()：换兵刃后重新设置出招    attack()：出招    select_opponent()：寻找出招机会    init()：换房间时，判断是否需要出手  attribute.c：读取天赋附加值    query_A()    A:str,cps,con,int,cor,kar,per,spi  array.c：有关阵法的函数  autoload.c：有关存盘物件的函数    string *autoload;存盘物件数组    clean_up_autoload()：清除存盘物件    save_autoload()：保存存盘物件    restore_autoload()：恢复存盘物件  command.c：有关命令的函数    string *path;该玩家的命令路径    disable_player()：使玩家指令失效    enable_player()：恢复玩家指令  condition.c：身体状况    mapping conditions;    update_condition()：被heart_beat调用，用来更新condition    apply_condition(string cnd,string info)：设置condition    clear_condition()：清除所有condition    query_condition(string cnd)：检查cnd所剩的发作次数    query_all_condition()：返回所有的condition  damage.c：伤害和恢复    int ghost;鬼的标记    is_ghost()：判断是否是鬼    receive_damage(string type,int damage,object who)：伤有效值(前面的)    receive_wound(string type,int damage,object who)：伤最大值(后面的)    receive_heal(string type,int heal)：恢复heal点有效值    receive_curing(string type,int heal)：恢复heal点最大值    unconcious()：晕倒    die()：死掉    revive()：醒过来    reincarnate()：活过来    heal_up()：每次心跳恢复一下各个状态    int max_food_capacity()    int max_water_capacity()：最大食量  dbase.c：人物数据    mapping dbase;人物的数据    mapping tmpdbase;人物的临时数据    set(mixed prop,mixed data)    set_temp(mixed prop,mixed data)：设置数据    query(mixed prop)    query_temp(mixed prop)：查询数据    delete(mixed prop)    delete_temp(mixed prop)：删除数据    add(string prop,mixed data)    add_temp(string prop,mixed data)：修改数据    query_entire_dbase()：返回dbase    query_entire_tmp_dbase()：返回tmpdbase  edit.c：编辑用函数  equip.c：装备用函数    wear()：穿    wield()：装备武器    unequip()：卸除装备  finance.c：交易函数    can_ford(int amount)：有amount文钱吗？    pay_money(int amount)：付钱  food.c：食物函数    do_eat()：吃  liquid.c：饮料函数    do_drink()：喝    do_fill()：灌    extra_long()：根据所剩的量，提供不通的描述  message.c：信息输出函数    string *msg_buffer;信息记录缓冲    receive_message(string msgclass,string msg)：根据msgclass区别发送msg    write_prompt()：输出一个命令提示符    receive_snoop(string msg)：对snoop来的msg进行处理(在前面加个%)  more.c：分屏看文件的有关函数    more(string cmd,string *text,int line)    start_more(string msg)  move.c：有关物件移动的函数    int weight;物件重量    int encumb,max_encumb;物件的负荷(所有在该物件里的所有东西的总重量),最大负荷    set_max_encumbrance(int e)：设置最大负荷    add_encumbrance(int a)：增加负荷    query_encumbrance()：返回当前负荷    query_max_encumbrance()：返回当前最大负荷    over_encumbranced()：判断是否超载    set_weight(int w)：设置重量    query_weight()：返回物件重量    weight()：返回物件重量加总负荷    move(mixed dest,int silently)：把物件挪向dest    remove(string euid)：移除    move_or_destruct(object dest)：把物件送到最后乐园(void_ob)  name.c：有关名字的函数    string *my_id;    set_name(string name,string *id)：设置名字和id    id(string i)：判断i是不是该物件的id    name(int raw)：返回中文名字    short(int raw：返回该物件的简单描述    long(int raw)：返回该物件的长描述  skill.c：武技函数(以wind为例)    mapping skills;武功等级    maping learned;武功小点    mapping skill_map;低高级武功的映射    query_skills()：返回skills    query_learned()：返回learned    query_skill_map()：返回skill_map    set_skill(string skill, int val)：设置武功    delete_skill(string skill)：删除武功    map_skill(string skill, string mapped_to)：       把mapped_to作为skill的高级武功。    query_skill_mapped(string skill)：返回skill所enable的高级武功    delete_skill(string skill)：删除武功    map_skill(string skill, string mapped_to)：       把mapped_to作为skill的高级武功。    query_skill_mapped(string skill)：返回skill所enable的高级武功    int query_skill(string skill,int raw)：       如果raw=1,返回skill的等级；否则返回skill的有效等级    int query_learn(string skill)：返回武功skill的小点    int skill_death_penalty()：死了之后降武功    improve_skill(string skill, int amount, int weak_mode)：提升武功小点  vendor.c：买卖函数    int buy_object(object me,string what)：返回me来买what所须的money    compelete_trade(object me, string what)：成交    price_string(int v)：v文钱的中文描述    do_vender_list(string arg)：看商品的列单  treemap.c：这个东西更接近于mudlib，dbase.c还是继承它的  save.c：存盘和恢复函数    save()：存盘    restore()：恢复[2;37;0m","time":1239862471,"fid":"46","title":"文件介绍（备份）","author":"北侠巫师讨论区(picewolf)[2;37;0m","tid":"5838","authorid":"picewolf",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=56893&ptid=5852以下是对北侠网站用google analytics工具进行了七天跟踪分析的部分结果：所有访问来源总共发送了 5,217 次访问 [img]https://www.google.com/analytics/reporting/sparkline?p=000000000000000000000000000000000000000000000005uksgzzypunuwri&pe=30[/img] [list][*][size=5]53.67% [/size][url=https://www.google.com/analytics/reporting/direct_sources?id=16770219&pdr=20090318-20090417&cmp=average&trows=10&gdfmt=nth_day][size=3][color=#005c9c]直接点击量 [/color][/size][/url][/list][size=3][color=#005c9c][img]https://www.google.com/analytics/reporting/sparkline?p=00000000000000000000000000000000000000000000000jj2iszznfosycvv&pe=30[/img][/color][/size] [list][*][size=5]13.28% [/size][url=https://www.google.com/analytics/reporting/referring_sources?id=16770219&pdr=20090318-20090417&cmp=av