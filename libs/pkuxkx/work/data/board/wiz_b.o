ugh to make an aggressive action.		}		else if( random( (int)victim->query_dex() * 3 ) > (int)me->query_str() || victim->query(\\\"no_action\\\") ) 		{			            to_do_attack(me,victim,i);		// Else, we just start guarding.		}		else if( !me->query_temp(\\\"guarding\\\")  ) 		{			me->set_temp(\\\"guarding\\\", 1);			combat_msg( guard_msg[random(sizeof(guard_msg))],1, me, victim);			return;		} 		else 			return;	} // enclose of hubo}[2;37;0m","time":1333552552,"fid":"46","title":"加了一段代码，设计了一下武器的出招速度，大家看看这种设计合理么？","author":"北侠巫师讨论区(picewolf)[2;37;0m","tid":"28021","authorid":"picewolf",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=340661&ptid=28021好像不奏效。。。实际的战斗出招，是通过底层控制fight()来实现每一个回合的出招么？[2;37;0m","time":1333554352,"fid":"46","title":"Re:加了一段代码，设计了一下武器的出招速度，大家看看这种设计合理么？","author":"北侠巫师讨论区(picewolf)[2;37;0m","tid":"28021","authorid":"picewolf",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=340706&ptid=28021[quote]直接拷贝到fight.h里替换就行应该没什么问题。现在我直接用武器来区分，我觉得应该用重量区分。 ...[size=2][color=#999999]picewolf 发表于 2012-4-4 11:42 PM[/color] [url=http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=340661&ptid=28021][img]http://pkuxkx.net/forum/images/common/back.gif[/img][/url][/size][/quote] 无限加班，上班，么有空认真看。您还是找SG师傅和月色师傅吧……[2;37;0m","time":1333593353,"fid":"46","title":"Re:加了一段代码，设计了一下武器的出招速度，大家看看这种设计合理么？","author":"北侠巫师讨论区(ivanfox)[2;37;0m","tid":"28021","authorid":"ivanfox",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=340730&ptid=28021你这样设置，怎么发出每隔比如0.8心跳一招，1.5心跳一招，2.5心跳一招，3.3心跳一招，1.3心跳一招之类的发招速度？要先解决这个发招间隔才行吧？比如1.5心跳一招，正常应该每2招空一招，而且我觉得这个出招速度最好不要写死，作为武器的一个属性就可以了，设置一个默认值，如果武器没有出招速度有一个默认算法[2;37;0m","time":1333598153,"fid":"46","title":"Re:加了一段代码，设计了一下武器的出招速度，大家看看这种设计合理么？","author":"北侠巫师讨论区(seagate)[2;37;0m","tid":"28021","authorid":"seagate",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=340847&ptid=28021