);//修改了parry描述mapping query_action(object me, object weapon){ int i, level; level = (int) me->query_skill(\\\"taiyi-jian\\\",1); for(i = sizeof(action); i > 0; i--)  if(level > action[i-1][\\\"lvl\\\"])   return action[NewRandom(i, 20, level/5)];}int practice_skill(object me){ object weapon; if (!objectp(weapon = me->query_temp(\\\"weapon\\\")) || (string)weapon->query(\\\"skill_type\\\") != \\\"sword\\\")  return notify_fail(\\\"你使用的武器不对。\\\\n\\\"); if ((int)me->query(\\\"family\\\"))  return notify_fail(\\\"往矣，非曳尾涂中之士，如何领悟太乙正道？\\\\n\\\"); if ((int)me->query(\\\"qi\\\") < 60)  return notify_fail(\\\"你的精力不够练太乙神剑。\\\\n\\\");  if ((int)me->query(\\\"neili\\\") < 100)  return notify_fail(\\\"你的内力不够练太乙神剑。\\\\n\\\"); me->receive_damage(\\\"qi\\\", 40); me->add(\\\"neili\\\", -20); return 1;//修改练习消耗、要求和描述}string perform_action_file(string action){ return __DIR__\\\"taiyi-jian/\\\" + action;}[/code][2;37;0m","time":1250358022,"fid":"46","title":"Re:开始写武馆","author":"北侠巫师讨论区(zgbl)[2;37;0m","tid":"7996","authorid":"zgbl",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=78422&ptid=7996漏了段函数，faint[code] string query_parry_msg(object weapon){       if( weapon )        return parry_msg[random(sizeof(parry_msg))];    else        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];}[/code][2;37;0m","time":1250358112,"fid":"46","title":"Re:开始写武馆","author":"北侠巫师讨论区(zgbl)[2;37;0m","tid":"7996","authorid":"zgbl",]),(["msg":"本帖地址：http://pkuxkx.net/forum/redirect.php?goto=findpost&pid=78454&ptid=8035将combatd中的killer_reward（）中的神获得与exp挂钩改动如下：原来的是killer get shen = -target(shen)/10现在改动为：设定参数aa=exp_me/exp_targetif a>1 则a=exp_target/exp_meif a>0.8 killer get shen = -target（shen)if 0.4[2;37;0m","time":1250390422,"fid":"46","title":"拟做如下改动","author":"北侠巫师讨论区(picewolf)[2;37;0m","tid":"8035","authorid":"picewolf",]),(["msg":"本帖地址：http://pkuxkx.net/f