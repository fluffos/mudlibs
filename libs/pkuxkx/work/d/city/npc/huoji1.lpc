// huoji. 药铺伙计

inherit NPC;
inherit F_DEALER;

void create()
{
        set_name("铁匠铺伙计", ({ "huo ji", "huoji" }));
	set("str", 20);
	set("gender", "男性");
	set("age", 18);
        set("long", "他是王铁匠的学徒，平常除了和师傅学习锻造的本事之外，还负责出售一些价值不菲的兵器。\n");
	set("combat_exp", 250);
	set("attitude", "friendly");
	set("vendor_goods", ({
              "/clone/weapon/hammer/tongchui.lpc",
              "/clone/weapon/hammer/jingua.lpc",
              "/clone/weapon/whip/caichou.lpc",
              "/clone/weapon/staff/shawei.lpc",
              "/clone/weapon/staff/wuchangbang.lpc",
              "/clone/weapon/staff/tiezhang.lpc",
              "/clone/weapon/blade/dadan.lpc",
              "/clone/weapon/blade/fengdao.lpc",
              "/clone/weapon/blade/gudingdao.lpc",
              "/clone/weapon/blade/jindao.lpc",
              "/clone/weapon/blade/kandao.lpc",
              "/clone/weapon/blade/wandao.lpc",
              "/clone/weapon/blade/yanblade.lpc",
                "/d/city/weapon/tongqianbiao.lpc",
//              "/clone/weapon/sword/panguanbi.lpc",
//用判官笔限制panguan-bifa写字的频率
              "/clone/weapon/sword/qingfeng.lpc",
              "/clone/weapon/sword/ruler.lpc",
              "/clone/weapon/sword/yudi.lpc",
                "/d/city/weapon/yingzhen.lpc",
                "/d/city/weapon/xiuzhongjian.lpc",
                "/d/city/weapon/huaguzhen.lpc",
                "/d/city/weapon/suohoubiao.lpc",
                "/d/city/weapon/dmqiang",
                "/d/city/weapon/hyqiang",
                "/d/city/weapon/changqiang",
                "/d/city/weapon/fangtianji",
                "/d/city/weapon/mingyueji",
                "/d/city/weapon/jinfengji",
	}));

	set("shen_type",1);set("score",200);setup();
}

