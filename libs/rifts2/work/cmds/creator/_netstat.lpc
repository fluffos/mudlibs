//	/bin/dev/_netstat.c

//	Command for checking network sockets

//	coded by Descartes of Borg 23 Nov 1992



#include <std.h>

inherit DAEMON;



/* dump_socket_status() is a MudOS-era native driver call whose C signature
 * (outbuffer_t*) is never actually exposed as a callable LPC efun on this
 * driver -- socket_status(int) is the real modern equivalent. Minimal
 * compatible reimplementation below, not the original's exact table
 * format (which we have no record of). */
int cmd_netstat() {
  mixed *socks;
  int i;

  write("Socket status:\n");
  i = 0;
  while (socks = socket_status(i)) {
    write(sprintf("%2d: fd=%-4d state=%-12s mode=%-10s local=%-22s remote=%-22s owner=%O\n",
      i, socks[0], socks[1], socks[2], socks[3], socks[4], socks[5]));
    i++;
  }
  if (!i) write("No active sockets.\n");
  return 1;
}



int help()

{

  write( @EndText

Syntax: netstat

Effect: Lists the status of the mud's internet sockets.

See man: dump_socket_status

See also: mstatus, cache, callouts, dumpallobj, opcprof, fdinfo

EndText

  );

  return 1;

}

