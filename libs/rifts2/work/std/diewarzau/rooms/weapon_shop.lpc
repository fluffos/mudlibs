inherit "std/room";



void reset() {

   object ob;

   ::reset();

   if (!present("biff")) {

      /* "/wizards/diewarzau/obj/mon/biff" was never archived (the
       * wizard's personal home directory this content lived in didn't
       * ship with this source) -- new() returns 0 for a nonexistent
       * file, and an unguarded ->move() on that 0 crashed this room's
       * every reset(). Guarded rather than fabricated -- see NOTES.md. */
      if (ob = new("/wizards/diewarzau/obj/mon/biff"))
        ob->move(this_object());

   }

}



void create() {

   ::create();

   set_property("indoors",1);

   set_property("light",3);

   add_exit("/d/standard/square", "west");

   set("short","Fred's gift shop");

   set("long",

"Weapons adorn the walls of this armoury.  There is a sign on the wall "

"behind the shopkeeper.");

   set_items( (["sign":"The say reads: 'say shopkeeper, help' for"+

	     " assistance."]) );

}

