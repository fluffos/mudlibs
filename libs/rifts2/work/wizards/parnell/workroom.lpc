inherit "/std/vault_locker_room.lpc";

void create()
{
    ::create();
    set("long", "This inherits from /std/vault_locker_room.lpc");
    set_exits( ({ "/wizards/parnell/workroom2.lpc"}), ({"south"}) );
    set_light(5);
    add_exit("/d/standard/square", "square");
}

void reset()
{
    ::reset();
}