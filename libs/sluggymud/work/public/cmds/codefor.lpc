#include <globals.h>

int main(string a)
{
    object ret;
    mixed code;

    if (file_size(TMP_EVAL_FILE+".lpc") != -1)
    rm (TMP_EVAL_FILE+".lpc");
    if (find_object(TMP_EVAL_FILE))
    destruct(find_object(TMP_EVAL_FILE));

    write_file(TMP_EVAL_FILE+".lpc", "mixed eval() { " + a + "; }\n");

    ret = load_object(TMP_EVAL_FILE);

    dump_prog(ret, 1, CODE_TMP_FILE);
    code = read_file( CODE_TMP_FILE);
    rm(CODE_TMP_FILE);
    rm(TMP_EVAL_FILE+".lpc");

    // This driver's dump_prog() labels the disassembly section
    // "DISASSEMBLY:\n" (confirmed live -- see NOTES.md); the archive's own
    // ";;;  *** Disassembly ***\n" marker never matches any FluffOS output
    // format, so explode() always returned a 1-element array and code[1]
    // threw "Array index out of bounds" on every real invocation.
    code = explode(code, "DISASSEMBLY:\n");
    code = code[1];
    write(code[0..strlen(code)-1]);
    return 1;
}
