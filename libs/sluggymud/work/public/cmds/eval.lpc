#include <globals.h>

int main(string arg)
{
    /* clean up first */
    if (file_size(TMP_EVAL_FILE+".lpc") != -1)
    rm (TMP_EVAL_FILE+".lpc");
    if (find_object(TMP_EVAL_FILE))
    destruct(find_object(TMP_EVAL_FILE));

    write_file(TMP_EVAL_FILE+".lpc","mixed eval() { "+arg+"; }\n");
    printf("Result = %O\n", TMP_EVAL_FILE->eval());
    return 1;
}
