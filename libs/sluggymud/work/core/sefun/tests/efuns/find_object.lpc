void do_tests() {
    object ob;
    
    ASSERT(find_object(__FILE__) == this_object());
    ob = find_object("/core/sefun/tests/efuns/unloaded");
    if (ob)
    destruct(ob);
    ASSERT(!find_object("/core/sefun/tests/efuns/unloaded"));
    ASSERT(ob = find_object("/core/sefun/tests/efuns/unloaded", 1));
    ASSERT(file_name(ob) == "/core/sefun/tests/efuns/unloaded");
    destruct(ob);
    ASSERT(ob = load_object("/core/sefun/tests/efuns/unloaded", 1));
    ASSERT(file_name(ob) == "/core/sefun/tests/efuns/unloaded");
    ASSERT(!load_object("/foo"));
}
