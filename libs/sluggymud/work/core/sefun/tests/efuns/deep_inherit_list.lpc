void do_tests() {
    mixed *x;
    
    ASSERT(deep_inherit_list(this_object()) == ({ }));
    x = deep_inherit_list(load_object("/core/sefun/tests/efuns/inh2.lpc"));
    ASSERT(sizeof(x) == 2);
    ASSERT(x[0] == "/core/sefun/tests/efuns/inh1.lpc");
    ASSERT(x[1] == "/core/sefun/tests/efuns/inh0.lpc");
}
