###############################################################################
#              Customizable runtime config file for FluffOS                   #
###############################################################################
# Adapted from this archive's own lib/core/cfg/mudos.cfg (a real, minimal
# MudOS v21-era config -- this repo explicitly targets the FluffOS driver
# per its own README) for this project's conventions -- see NOTES.md.

# name of this mud
name : Sluggy MUD

# port number to accept users on
port number : 40250

# absolute pathname of mudlib
mudlib directory : /home/sunyc/src/mudlib/libs/sluggymud/work

# debug.log and author/domain stats are stored here (resolves against the
# driver's launch CWD, not mudlib directory -- see AGENTS.md 5.2; always
# launch via `cd libs/sluggymud && driver config.fluffos`)
log directory : /log

# the directories which are searched by #include <...>
include directories : /core/include:/secure/include:/public/include

# file to include in all LPC objects (optional)
global include file : <config.h>

# Directory to save binaries in.  (if BINARIES is defined)
save binaries directory : /secure/save/binaries

# the file which defines the master object
master file : /core/lib/master/master

# the file where all global simulated efuns are defined.
simulated efun file : /core/sefun/sefun

# debug.log file name (assumed to be in specified 'log directory')
debug log file : debug.log

time to clean up : 1200
time to swap : 0
time to reset : 1800
maximum bits in a bitfield : 1200
maximum evaluation cost : 5000000
maximum local variables : 35
maximum array size : 64000
maximum buffer size : 400000
maximum mapping size : 64000
inherit chain size : 30
maximum string length : 200000
maximum read file size : 200000
maximum byte transfer : 10000
hash table size : 7001
object table size : 1501
default fail message : Beg your pardon?
default error message : This is the default error message.

maximum users : 40
evaluator stack size : 1000
compiler stack size : 200
maximum call depth : 30
living hash table size : 100
