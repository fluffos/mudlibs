string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  int i;

  // UTF8 FIX: this used to scan raw GBK bytes -- str[i] byte-range checks
  // (161-254 for any byte, 176-247 for even/lead-byte positions) with
  // i%2 gating to distinguish GBK lead vs trail bytes. str[i] now returns
  // a full Unicode codepoint per character, so this checks every
  // character is in the CJK Unified Ideographs block (U+4E00-U+9FFF)
  // instead -- this function validates the WHOLE string (used to check
  // an entire surname/given-name field), not just one character.
  if (strlen(str) < 1) return 0;

  for (i = 0; i < strlen(str); i++) {
    if (str[i] < 0x4e00 || str[i] > 0x9fff) return 0;
  }

  return 1;
}
