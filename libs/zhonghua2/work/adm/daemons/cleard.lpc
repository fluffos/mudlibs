#pragma optimize
#pragma save_binary

inherit F_DBASE;

#include <ansi.h>
void create() {
  seteuid(ROOT_UID);
  set("name", HIR "系统精灵" NOR);
  set("channel_id", "系统精灵");
  CHANNEL_D->do_channel(this_object(), "sys", "\n清除程序已经启动。\n");
  call_out("auto_clear", 30);
}
void auto_clear() {
  CHANNEL_D->do_channel(this_object(), "sys", HIY "清除程序运行中。\n" NOR);
  if (random(3) == 1)
    rm("/log/debug.log");

  // Guard: debug.log may have just been rm()'d above (1/3 chance every
  // cycle) or may not exist yet at all under WASM (harness log/ mount
  // gap) -- an unguarded cp() on a missing source throws "lstat failed"
  // and aborts the rest of this function, silently killing the 30-min
  // reschedule below forever. See AGENTS.md §7.11.
  if (file_size("/log/debug.log") >= 0)
    cp("/log/debug.log", "/drive/system.log");  //备份debug.log为systerm.log为程序查错
  if (file_size("/mudos.log") >= 0)
    cp("/mudos.log", "/mudosxp.log");  //清除mudosxp.log为"0"K
  remove_call_out("auto_clear");
  call_out("auto_clear", 1800);  //30分钟清理一次
}
