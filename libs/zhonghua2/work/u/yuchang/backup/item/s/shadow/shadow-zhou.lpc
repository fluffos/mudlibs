#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m大日[1;33m如来[1;31m咒[2;37;0m", ({ "zhou" }));
  set_weight(15000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
[1;33m如来佛祖[1;37m使用过，遗落于凡间的[1;31m神器[1;37m。[2;37;0m
剑柄上刻着一行小字：影舞(shadow)
");
  set("value", 2100000);
  set("point", 117);
  set("materail", "magic stone");
  set(
    "wield_msg",
    "[1;31m大日[1;33m如来[1;31m咒[1;37m凭空出现于[1;36m$N[1;37m手中，四周空气变得异常凝重。[2;37;0m\n"
  );
  set(
    "unwield_msg",
    "[1;37m空气突然变得不那么压抑，原来[1;31m大日[1;33m如来[1;31m咒[1;37m再一次消失在[1;36m$N[1;37m手中。[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
