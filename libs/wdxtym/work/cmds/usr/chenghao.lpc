
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        int min, hrs, day, mon, age;
		string sec;
        string out_str;
    	sec = sprintf(" 														 "HIY"『 称号溥 』     "NOR"  \n");
	sec += sprintf(WHT""WHT""WHT""NOR"\n");

    	sec += sprintf(HIY"	" + ZJURL("cmds:chjl quxiao")ZJSIZE(25)"取下前缀称号"NOR" ")+sprintf(WHT"						" + ZJURL("cmds:chjl quxiao1")ZJSIZE(25)"取下成就称号"NOR" \n");
//    	sec += sprintf(HIY"  『 称号 』                    " + ZJURL("cmds:chjl quxiao1")ZJSIZE(25)"取下成就称号"NOR" \n");
	sec += sprintf(WHT""WHT""WHT""NOR"\n");

if (me->query("chenghao/slr"))
        { 
        sec += sprintf(HIY"  扫地僧																"  + ZJURL("cmds:chjl slr")ZJSIZE(25)"激活称号"NOR" \n");
        sec += sprintf(HIW"  普通称号"NOR" \n");
    	}						
if (me->query("chenghao/zmjh"))
        { 
        sec += sprintf(HIY"  守陵人																"  + ZJURL("cmds:chjl zmjh")ZJSIZE(25)"激活称号"NOR" \n");
        sec += sprintf(HIW"  普通称号"NOR" \n");
    	}    	
	
		sec = replace_string(sec,"\n",ZJBR)+"\n";
		write(ZJOBLONG+sec+"\n");
		
		
		
        return 1;
}


