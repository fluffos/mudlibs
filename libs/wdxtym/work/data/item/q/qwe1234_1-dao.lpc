#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("魔刀[2;37;0m", ({ "dao" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;37m世界[2;37;0m炼制而成的一把刀。
刀柄上刻着一行小字：浪翻云(qwe1234_1)
");
  set("value", 1);
  set("point", 50000);
  set("material", "silk");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
