#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m碧落黄泉剑[1;31m[2;37;0m", ({ "jian" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;37m世界[2;37;0m炼制而成的一柄剑。
上穷碧落下黄泉[2;37;0m
剑柄上刻着一行小字：微笑(weixiao_1)
");
  set("value", 200100000);
  set("point", 22000);
  set("material", "silk");
  set("wield_msg", "一道闪电划过[2;37;0m\n");
  set("unwield_msg", "一道锋芒回归剑鞘[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
