#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m神祸[2;37;0m", ({ "shj" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;37m世界[2;37;0m炼制而成的一柄剑。
[1;31m看起来这把剑很不详，但似乎又很普通[2;37;0m
剑柄上刻着一行小字：罐子(p357159_1)
");
  set("value", 200100000);
  set("point", 22000);
  set("material", "silk");
  set("wield_msg", "[1;31m$n缓缓出鞘周围顿时升起一丝凉意，你感觉到背后微微发凉[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
