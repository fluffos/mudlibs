  int num = 0;

  str = this_object()->query("con");
  if (!mapp(sk = query_skills()))
    return str;

  improve = (int)sk["force"] + (int)this_object()->query_temp("suit_skill/force");


  return str + (improve / 10) + this_object()->query_temp("apply/con") + this_object()->query_temp("suit_eff/constitution") + this_object()->query("titlea/con");
