int query_dex() {
  mapping sk;
  int str;
  int improve = 0;
  int num = 0;

  str = this_object()->query("dex");
  if (!mapp(sk = query_skills()))
    return str;

  improve = (int)sk["dodge"] + (int)this_object()->query_temp("suit_skill/dodge");


  return str + (improve / 10) + this_object()->query_temp("apply/dex") + this_object()->query_temp("suit_eff/spirituality") + this_object()->query("titlea/dex");
}

int query_per(string arg) {
  int per;
  int age;
  int ac;
  int num = 0;
  per = (int)this_object()->query("per") + this_object()->query_temp("apply/per");
  if (this_object()->query("special_skill/youth"))
    return per;

  age = this_object()->query("age");

  ac = query_skill("art-cognize", 1);
  if (ac < 100) {
    if (age > 70) per -= 6; else if (age > 60) per -= 5; else if (age > 50) per -= 4; else if (age > 40) per -= 3; else if (age > 30) per -= 2;
  }
  per += ac / 20;


  return per;
}
