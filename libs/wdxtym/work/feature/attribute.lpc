#include <ansi.h>
#include <command.h>
#include <dbase.h>
#include <skill.h>

int query_str() {
  mapping sk;
  int str;
  int improve = 0;
  int lx = 0;
  int num = 0;
  str = this_object()->query("str");
  if (!mapp(sk = query_skills()))
    return str;

  improve += (int)sk["unarmed"] / 30;
  improve += (int)sk["cuff"] / 30;
  improve += (int)sk["finger"] / 30;
  improve += (int)sk["strike"] / 30;
  improve += (int)sk["hand"] / 30;
  improve += (int)sk["claw"] / 30;
  improve += (int)this_object()->query_temp("suit_skill/unarmed") / 30;
  improve += (int)this_object()->query_temp("suit_skill/cuff") / 30;
  improve += (int)this_object()->query_temp("suit_skill/finger") / 30;
  improve += (int)this_object()->query_temp("suit_skill/strike") / 30;
  improve += (int)this_object()->query_temp("suit_skill/hand") / 30;
  improve += (int)this_object()->query_temp("suit_skill/claw") / 30;
  lx = (int)sk["longxiang"] / 30;
  if (lx >= 13) lx = 15;

  return str + improve + lx + this_object()->query_temp("suit_eff/strength") + this_object()->query_temp("apply/str") + this_object()->query("titlea/str");

}

int query_int() {
  mapping sk;
  int str;
  int improve = 0;
  int num = 0;

  str = this_object()->query("int");
  if (!mapp(sk = query_skills()))
    return str;
  improve = (int)sk["literate"] + (int)this_object()->query_temp("suit_skill/literate");


  return str + (improve / 10) + this_object()->query_temp("apply/int") + this_object()->query_temp("suit_eff/intelligence") + this_object()->query("titlea/int");
}

