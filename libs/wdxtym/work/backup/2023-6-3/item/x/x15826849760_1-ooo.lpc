#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m飘[1;31m雪[1;32m剑[2;37;0m", ({ "ooo" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;37m世界[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：渡浅(x15826849760_1)
");
  set("value", 200100000);
  set("point", 22000);
  set("material", "silk");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
