#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m惧[1;31m镰[1;35m破刃[2;37;0m", ({ "ren" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;37m世界[2;37;0m炼制而成的一把刀。
[1;32m随处可见的庄园割草镰刀，[1;35m有些破损，还有，[1;31m血渍？[2;37;0m
刀柄上刻着一行小字：灵梦(bllm_1)
");
  set("value", 200100000);
  set("point", 22000);
  set("material", "silk");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
