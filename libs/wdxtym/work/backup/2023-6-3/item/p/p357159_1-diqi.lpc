#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m帝起[2;37;0m", ({ "diqi" }));
  set_weight(1);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;31m真龙[2;37;0m炼制而成的一柄剑。
[1;33m剑看上去平平无奇，可上面的[1;31m符文[1;33m却引人注目，一个个符文交错，散发出奇异的光彩[2;37;0m
剑柄上刻着一行小字：罐子(p357159_1)
");
  set("value", 300100000);
  set("point", 33000);
  set("material", "silk");
  set("wield_msg", "$n缓缓出鞘，霎时间紫气东来三万里，天空中出现四兽虚像，令人叹为观止[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
