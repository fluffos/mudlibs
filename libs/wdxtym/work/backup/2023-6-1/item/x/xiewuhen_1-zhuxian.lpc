#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m诛仙剑[2;37;0m", ({ "zhuxian" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "柄");
  set(
    "long",
    "这是由[1;37m世界[2;37;0m炼制而成的一柄剑。
[1;31m诞生于鸿蒙中第一缕光，此剑专克不死之身，被诛仙剑攻击的伤口无法复原。威力乃当世之首。因为威力巨大，足有逆天之能，使用者易产生统治天下的想法而被其中的凶戾之气反噬，杀戮之气极重。[2;37;0m
剑柄上刻着一行小字：谢无痕(xiewuhen_1)
"
  );
  set("value", 200100000);
  set("point", 22000);
  set("material", "silk");
  set("wield_msg", "[1;31m非铜非铁亦非钢，曾在须弥山下藏。不用阴阳颠倒炼，岂无水火淬锋芒？[2;37;0m\n");
  set("unwield_msg", "[1;31m诛仙利，戮仙亡，陷仙四处起红光。绝仙变化无穷妙，大罗神仙血染裳[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
