#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("砍的心[2;37;0m", ({ "sword" }));
  set_weight(750);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;37m世界[2;37;0m炼制而成的一柄剑。
传说中的砍砍所拥有的无上神器[2;37;0m
剑柄上刻着一行小字：砍砍二号(x000127_1)
");
  set("value", 200100000);
  set("point", 22000);
  set("material", "silk");
  set("wield_msg", "拥有的砍砍的心[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
