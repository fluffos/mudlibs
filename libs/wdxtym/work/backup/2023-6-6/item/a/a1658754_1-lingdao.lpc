#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("灵刀[2;37;0m", ({ "lingdao" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;33m传奇[35m灵石[2;37;0m炼制而成的一把刀。
刀柄上刻着一行小字：渡渡(a1658754_1)
");
  set("value", 12100000);
  set("point", 1320);
  set("material", "magic stone");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一把[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
