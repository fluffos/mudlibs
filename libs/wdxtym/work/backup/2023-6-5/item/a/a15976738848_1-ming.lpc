#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("命运之蛇[2;37;0m", ({ "ming" }));
  set_weight(400);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[1;37m世界[2;37;0m炼制而成的一条腰带。
一个又一个水银色的复杂符号相继连成的一条巨大虚幻的无鳞之蛇。
银白的巨蛇表面，密密麻麻的花纹和符号构成了一个又一个彼此相连的转轮[2;37;0m
腰带缘上刻着一行小字：等等(a15976738848_1)
");
  set("value", 200100000);
  set("point", 8800);
  set("material", "silk");
  set(
    "wear_msg",
    "首尾相接，和无数虚幻的河流交汇在一起，衍化为了一个模糊的，不够真实的，缓缓转动的巨大圆轮，而圆轮的四周，有各种各样的象征符号代表不同的未来。[2;37;0m\n"
  );
  set("remove_msg", "命运回环[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
