#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m葬天[2;37;0m", ({ "ztt" }));
  set_weight(9000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;35m神铁[2;37;0m炼制而成的一柄剑。
我就是我，任何事物不足与我匹敌，自在逍遥皆是我，我如阳光温暖自己，耀眼星光仍是我。终身美丽，释放自己。[2;37;0m
剑柄上刻着一行小字：喜羊羊(oo00_1)
");
  set("value", 2700000);
  set("point", 286);
  set("material", "magic stone");
  set("wield_msg", "我生来就是高山而非溪流，我欲于岁月之途撞碎仰止的巍峨。[2;37;0m\n");
  set("unwield_msg", "我生来就是人杰而非草芥，我燃起燎原之火炙烤璀璨的星河。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
