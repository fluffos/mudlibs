
inherit COMBINED_ITEM_BANG;
inherit F_LIQUID;

void create()
{
	set_name(HIW"玄冰"HIG"碧火"HIC"酒"NOR, ({"icefire jiu", "wine"}));
	set_weight(700);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一个用来装酒的酒壶·。\n");
		set("base_unit", "壶");
		set("base_weight",300);
		set("unit", "壶");
		set("base_value", 50000);
		set("max_liquid", 10);
	}

	// because a container can contain different liquid
	// we set it to contain wine at the beginning
	set("liquid", ([
		"type": "alcohol",
		"name": "玄冰碧火酒",
		"bei": "暂无",
		
		"drunk_apply": 20,
	]));
	setup();
	set_amount(1);
}
//void owner_is_killed() { destruct(this_object()); }