// dangui.c

#include "herb.h"

void create()
{
	set_name(HIG "绿豆" NOR, ({ "lv dou" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是酿酒材料。\n");
		set("base_unit", "斗");
		set("base_value", 10000);
		set("base_weight", 70);
		set("level",275);
		set("wine","/clone/wine/yulujiu");
	}
	setup();
}
