#pragma optimize

#include <ansi.h>

// wizard.lpc (#include'd below) keeps the fallback set/query/delete for objects that do not inherit F_DBASE: they
// need `dbase`/`tmp_dbase`/`default_ob` and the tree helpers _query/_set/_delete, which F_TREEMAP supplies. F_DBASE
// itself is not inherited: its own methods call the bare set/query expecting them to resolve as simul_efuns, which
// they cannot while this very file is composing them.
inherit F_TREEMAP;
mapping dbase = ([]);
nosave mapping tmp_dbase = ([]);
nosave mixed default_ob = 0;

#include "/adm/simul_efun/atoi.lpc"
#include "/adm/simul_efun/chinese.lpc"
#include "/adm/simul_efun/file.lpc"
#include "/adm/simul_efun/gender.lpc"
#include "/adm/simul_efun/object.lpc"
#include "/adm/simul_efun/override.lpc"
#include "/adm/simul_efun/path.lpc"
#include "/adm/simul_efun/wizard.lpc"
#include "/adm/simul_efun/user.lpc"

// This must be after gender.c
#include "/adm/simul_efun/message.lpc"

// This is the utilitis
#include "/adm/simul_efun/util.lpc"

// helpers the code of this lib calls and the archive's simul_efun lacks (after wizard.lpc: it calls query())
#include "/adm/simul_efun/ntefun.lpc"

void create() {
  seteuid(getuid());
  write("simul_efun loaded successfully.\n");
}
