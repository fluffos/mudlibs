inherit ROOM;

void create() {
  set("short", "工作室");
  set("long", "工作室\n");

  set("action_list", ([
    "测试": "test",
  ]));

  setup();
}

void init() {
  add_action("do_test", "test");
  add_action("do_test2", "test2");
  add_action("do_dest_item", "dest_item");
}

int do_test2() {
  tell_room(this_object(), "测测试试试\n" NOR);
  return 1;
}

