#include <lib.h>

inherit LIB_BASE_STORAGE;
inherit LIB_BASE_ARMOR;
inherit LIB_SHADOW_HOOK;
inherit LIB_MONEY;

private nosave mixed *WornSave = ({});

void create(){
    mixed a_save, s_save;
    base_armor::create();
    SetSaveRecurse(1);
    a_save = base_armor::GetSave();
    s_save = base_storage::GetSave();
    WornSave = distinct_array(a_save + s_save);
    base_armor::AddSave(WornSave);
    base_storage::create();
}

void init(){
    base_armor::init();
}

/* base_storage and base_armor both define these two.  base_armor's SetSaveRecurse() (persist's) is
 * the one create() relies on, so a worn pack saves what is inside it; the glow is the container's,
 * which already counts the pack's own radiance plus whatever it carries. */
protected int SetSaveRecurse(int x){
    return base_armor::SetSaveRecurse(x);
}

int GetRadiantLight(int ambient){
    return base_storage::GetRadiantLight(ambient);
}

mixed direct_remove_obj(){
    return base_armor::direct_remove_obj();
}

mixed direct_wear_obj(){
    return base_armor::direct_wear_obj();
}

mixed eventEquip(object who, string *limbs){
    return base_armor::eventEquip(who, limbs);
}

varargs mixed eventUnequip(object who){
    return base_armor::eventUnequip(who);
}

varargs string GetEquippedDescription(object who){
    return base_armor::GetEquippedDescription(who);
}

varargs string GetExternalDesc(object who){
    return base_armor::GetExternalDesc(who);
}

string GetEquippedShort(){
    return base_armor::GetEquippedShort();
}

string *GetSave(){
    return base_armor::GetSave();
}

varargs string *AddSave(string *args){
    WornSave += args;
    return base_armor::AddSave(WornSave);
}
