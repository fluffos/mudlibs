#include <daemons.h>

private string nom, cdir;

varargs int make_workroom(mixed dude, int cre) {
    string tdir, dir_line, bakdata;
    int creator;

    if(!dude) return 0;

    if(objectp(dude)){
        cdir = homedir(dude, cre);
        creator = (cre || creatorp(dude));
        if(sizeof(get_dir(REALMS_DIRS+"/")) ==1) creator = 1;
        nom = dude->GetKeyName();
    }

    if(stringp(dude)){
        dude = lower_case(dude);
        if(cre ||  member_array(dude, PLAYERS_D->GetCreatorList()) != -1){
            creator = 1;
            cdir = REALMS_DIRS + "/" + dude;
        }
        else {
            cdir = ESTATES_DIRS + "/" + dude[0..0] + "/" + dude;
        }
        nom = dude;
    } 

    if(unguarded( (: file_size("/realms/template/") :) ) == -1) return 4;

    if(unguarded( (: file_size(cdir+"/area") :) ) == -1){
        tdir = "/realms/template/";
        dir_line = "#define MY_DIR          \""+cdir+"\"";
        bakdata = "workroom.orig : "+cdir+"/workroom.c\n";
        mkdir(cdir);
        mkdir(cdir+"/log");
        mkdir(cdir+"/log/archive");
        mkdir(cdir+"/bak");
        mkdir(cdir+"/tmp");
        mkdir(cdir+"/area");
        mkdir(cdir+"/adm");
        mkdir(cdir+"/area/room");
        mkdir(cdir+"/area/save");
        mkdir(cdir+"/area/weap");
        mkdir(cdir+"/area/obj");
        mkdir(cdir+"/area/npc");
        mkdir(cdir+"/area/armor");
        mkdir(cdir+"/area/etc");
        mkdir(cdir+"/area/doors");
        mkdir(cdir+"/area/meals");

        if(creator){
            mkdir(cdir+"/cmds");
            mkdir(cdir+"/public_html");
            cp(tdir+"plan", cdir+"/.plan");
            cp(tdir+"evaldefs.h", cdir+"/evaldefs.h");
            cp(tdir+"profile", cdir+"/.profile");
            cp(tdir+"cmds/custom.lpc", cdir+"/cmds/custom.lpc");
            cp(tdir+"workroom.lpc", cdir+"/workroom.lpc");
            cp(tdir+"workroom.lpc", cdir+"/workroom.bak");
            cp(tdir+"workroom.lpc", cdir+"/bak/workroom.orig");
            cp(tdir+"area/obj/chest.lpc", cdir+"/area/obj/chest.lpc");
        }

        else {
            cp(tdir+"workroom_builder.lpc", cdir+"/workroom.lpc");
            cp(tdir+"workroom_builder.lpc", cdir+"/workroom.bak");
            cp(tdir+"workroom_builder.lpc", cdir+"/bak/workroom.orig");
            cp(tdir+"area/obj/builder_chest.lpc", cdir+"/area/obj/builder_chest.lpc");
        }

        cp(tdir+"adm/remote.lpc",cdir+"/adm/remote.lpc");
        write_file(cdir+"/bak/bk.db",bakdata);
        cp(tdir+"area/customdefs.part1", cdir+"/area/customdefs.h");
        write_file(cdir+"/area/customdefs.h","\n"+dir_line+"\n");
        write_file(cdir+"/area/customdefs.h",read_file(tdir+"area/customdefs.part2"));
        cp(tdir+"area/room/sample_room.lpc", cdir+"/area/room/sample_room.lpc");
        cp(tdir+"area/room/sample_two.lpc", cdir+"/area/room/sample_two.lpc");
        cp(tdir+"area/weap/sword.lpc", cdir+"/area/weap/sword.lpc");
        cp(tdir+"area/obj/table.lpc", cdir+"/area/obj/table.lpc");
        cp(tdir+"area/obj/key.lpc", cdir+"/area/obj/key.lpc");
        cp(tdir+"area/obj/case.lpc", cdir+"/area/obj/case.lpc");
        cp(tdir+"area/obj/cup.lpc", cdir+"/area/obj/cup.lpc");
        cp(tdir+"area/obj/pitcher.lpc", cdir+"/area/obj/pitcher.lpc");
        cp(tdir+"area/obj/watch.lpc", cdir+"/area/obj/watch.lpc");
        cp(tdir+"area/npc/fighter.lpc", cdir+"/area/npc/fighter.lpc");
        cp(tdir+"area/armor/chainmail.lpc", cdir+"/area/armor/chainmail.lpc");
        cp(tdir+"area/armor/leather_boot_r.lpc", cdir+"/area/armor/leather_boot_r.lpc");
        cp(tdir+"area/armor/leather_boot_l.lpc", cdir+"/area/armor/leather_boot_l.lpc");
        return 1;
    }

    else {
        //write("That person already has a homedir.");
        return 5;
    }
}
