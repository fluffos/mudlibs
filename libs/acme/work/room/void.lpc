/*
 * Catalog start room. The archive has no playable world -- flavor
 * acme-rpg is one combat module, and the only shipped room is
 * platform/.etc/skel/.room/workroom.c (`inherit RoomCode;`).
 */

mapping exits;

void create() {
  exits = ([
    "north": "/room/workshop",
  ]);
}

string query_short() { return "The Void"; }

string query_long() {
  return "The Void\n"
    "You stand in a quiet gray space at the edge of Acme MUD, an\n"
    "experimental LDMud 3.x framework (devo@eotl, 2016-2017) that never\n"
    "shipped a finished world. A workshop lies to the north.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Exits: north.\n";
}

int id(string str) { return str == "void" || str == "here"; }
