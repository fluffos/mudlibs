mapping exits;

void create() {
  exits = ([
    "south": "/room/void",
  ]);
}

string query_short() { return "Framework workshop"; }

string query_long() {
  return "Framework workshop\n"
    "A bare workbench. The original Acme sources live under /platform\n"
    "and /flavor (login, MessageLib, XML command specs), written for\n"
    "LDMud 3.x closures and virtual inherit. South returns to the void.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "Exits: south.\n";
}

int id(string str) { return str == "workshop" || str == "here"; }
