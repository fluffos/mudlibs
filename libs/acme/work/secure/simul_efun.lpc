/*
 * FluffOS simul_efun for the acme catalog overlay.
 * Original /secure/simul_efun_ldmud.lpc raises on write()/say()/printf()
 * ("use MessageLib") -- that is LDMud-era API policy, not used here.
 */

void cat(string file) {
  string s;

  s = read_file(file);
  if (s)
    write(s);
}

void log_file(string file, string str) {
  if (file_size("/log") != -2)
    mkdir("/log");
  write_file("/log/" + file, str);
}

int exists(string path) {
  return file_size(path) != -1;
}
