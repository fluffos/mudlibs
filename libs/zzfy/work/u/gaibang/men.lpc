#include <room.h>
inherit ROOM;
string look_sign(object me);
void create()
{
        set("short", "丐帮大门");
        set("long", @LONG
一座破庙的大门，四周破破烂烂的，丢满了各种
杂物，还有丐帮弟子收集的破铜烂铁等。丐帮弟子进
进出出，不知道又发生什么大了。
LONG
        );
        set("exits", ([
         "north"   : __DIR__ "fotang",
         "south":"/d/qianfo/shanjiao",
         ]) );

        set("item_desc", ([
                "sign": (: look_sign :),
        ]) );

        set("objects", ([
                __DIR__"npc/beggar" : 2,
        ]) );
 
        set("outdoors", "gaibang");
        set("coor/x",20);
        set("coor/y",2100);
        set("coor/z",0);
        set("coor/x",20);
        set("coor/y",2100);
        set("coor/z",0);
        setup();

}

string look_sign(object me)
{
        return "
                  [5;37;44m┏━━━━━━━━━┓[0m
                  [5;37;44m┃[33m    丐      帮 [37m   ┃[0m
                  [5;37;44m┗━━━━━━━━━┛[0m  \n";
}

