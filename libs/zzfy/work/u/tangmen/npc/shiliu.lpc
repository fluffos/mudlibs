// laodenuo.c 
inherit NPC;
#include <ansi.h>
void create() {
  set_name("唐十六", ({ "tang shiliu", "shiliu" }));
  set("nickname", RED "有来无回" NOR);
  set("long",
    "唐门唐十六是唐门负责搏杀的。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("str", 22);
  set("int", 25);
  set("con", 30);
  set("per", 10);
  set("agi", 25);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "throwing.tanghua" :),
    (: perform_action, "dodge.rain" :),
  }));
  set("attitude", "friendly");
  set("max_force", 15000);
  set("force", 15000);
  set("force_factor", 25);
  set("max_kee", 5999);
  set("max_gin", 599);
  set("max_sen", 599);
  set("eff_kee", 5999);
  set("kee", 5999);
  set("chat_chance", 1);
  set("chat_msg", ({
    "唐十六说：你是谁？\n",
  }));
  set_skill("force", 100);
  set_skill("tangforce", 60);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("throwing", 100);
  set_skill("move", 100);
  set_skill("blade", 100);
  set_skill("tang-blade", 60);
  set_skill("tang-throwing", 100);
  set_skill("tang-steps", 60);

  map_skill("dodge", "tang-steps");
  map_skill("force", "tangforce");
  map_skill("throwing", "tang-throwing");
  map_skill("blade", "tang-blade");
  create_family("唐门", 17, "弟子");
  set("combat_exp", 1670000);
  setup();
  carry_object(__DIR__ "obj/dart")->wield();
}
