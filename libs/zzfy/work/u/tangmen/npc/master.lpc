#include <ansi.h>
inherit F_MASTER;
inherit NPC;
void create() {
  set_name("唐老爷子", ({ "master yezi", "master" }));
  set("nickname", HIG "蜀中唐门第一人" NOR);
  set("gender", "男性");
  set("age", 67);
  set("long",

    "唐老爷子是唐门的创始人，绝少人知道他的武功有多高。\n");

  set("combat_exp", 10000000);
  set("score", 200000);

  set("class", "tangmen");

  set("str", 40);
  set("int", 40);
  set("cor", 40);
  set("cps", 40);
  set("spi", 40);

  set("force", 100000);
  set("max_force", 100000);
  set("force_factor", 100);

  set("atman", 1400);
  set("max_atman", 1400);

  set("mana", 4000);
  set("max_mana", 2000);
  set("mana_factor", 5);


  set("apprentice_available", 3);
  create_family("唐门", 2, "掌门");

  set_skill("literate", 100);
  set_skill("magic", 40);
  set_skill("force", 170);
  set_skill("move", 160);
  set_skill("tangforce", 180);
  set_skill("spells", 50);
  set_skill("unarmed", 30);
  set_skill("blade", 100);
  set_skill("parry", 40);
  set_skill("dodge", 140);
  set_skill("throwing", 160);
  set_skill("tang-throwing", 160);
  set_skill("tang-blade", 160);

  set_skill("tang-steps", 200);

  map_skill("throwing", "tang-throwing");
  map_skill("blade", "tang-blade");
  map_skill("parry", "tang-blade");
  map_skill("move", "tang-steps");
  map_skill("dodge", "tang-steps");
  map_skill("force", "tangforce");
  set("chat_msg_combat", ({
    (: perform_action, "blade.banlanwushi" :),
  }));


  set_temp("apply/dodge", 20);
  set_temp("apply/armor", 20);
  setup();

  carry_object(__DIR__ "obj/dafeng")->wield();

}


void attempt_apprentice(object me) {
  if (this_player()->query_temp("rutangmen")) {
    command("say 既是我们唐门的人，好，我收你为徒！\n");
    command("recruit " + me->query("id"));
  } else
    command("shake");
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "tangmen");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "唐门弟子");
    return;
  } else if (exp <= 128000) {
    student->set("title", "唐门小徒");
    return;
  } else if (exp <= 512000) {
    student->set("title", "唐门五徒弟");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "唐门四徒弟");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "唐门三徒弟");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "唐门二徒弟");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "唐门大徒弟");
    return;
  } else
    student->set("title", "唐门长老");
  return;
}
