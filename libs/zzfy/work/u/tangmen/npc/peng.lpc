// laodenuo.c 

inherit NPC;
#include <ansi.h>
void create()
{
	set_name("唐朋", ({ "tang peng", "peng" }));
	set("nickname", RED"广交天下好友"NOR);
	set("long", 
"唐门唐朋是唐门年轻一代的高手，是唐方最喜欢的弟弟。\n");
	set("gender", "男性");
	set("age", 24);
	set("attitude", "peaceful");
		set("str", 18);
	set("int", 25);
	set("con", 20);
	set("per", 40);
	set("agi",45);
       set("combat_exp",100000);

	set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "throwing.tanghua" :),
                (: perform_action, "dodge.rain" :),
        }) );
	set("attitude","friendly");
        set("max_force", 5000);
        set("force", 5000);
        set("force_factor", 10);
	set("max_kee",999);
        set("max_gin",499);
        set("max_sen",499);
	set("eff_kee",999);
	set("kee",999);
        set("chat_chance", 1);
        set("chat_msg", ({
                "唐朋朝你笑嘻嘻。\n",
        }) );
	set_skill("force", 60);
	set_skill("tangforce", 60);
	set_skill("dodge", 60);
	set_skill("parry", 70);
		set_skill("throwing", 100);
	set_skill("move", 100);
	
	set_skill("tang-throwing", 80);
	set_skill("tang-steps", 60);
	
	map_skill("dodge", "tang-steps");
	map_skill("force", "tangforce");
		map_skill("throwing", "tang-throwing");
	create_family("唐门", 24, "弟子");
	setup();
	carry_object(__DIR__"obj/dart")->wield();
}
