#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
inherit F_MASTER;
string ask_me();
void create() {
  set_name("萧秋水", ({ "master xiao", "master", "xiao" }));
  set("long",
    "他是神州结义老大萧秋水，当代第一大侠。\n");
  set("nickname", HIW "红叶乱飞秋千去" NOR);
  create_family("神州结义", 1, "老大");
  set("str", 45);
  set("cor", 45);
  set("cps", 45);
  set("agi", 45);
  set("int", 45);
  set("attitude", "friendly");
  set("max_force", 20000);
  set("max_atman", 5000);
  set("max_mana", 6000);
  set("force", 20000);
  set("force_factor", 30);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({ (: perform_action, "jingtianyijian" :),
    (: perform_action, "jingtianyijian" :), }));
  set("inquiry", ([
    "权力帮": "你想拜权力帮,让我想想?如果有我的推荐信或者帮主会收你的 \n",
    "推荐信": (: ask_me :),
  ]));
  set("combat_exp", 10000000);
  set_temp("apply/damage", 500);
  set_skill("unarmed", 100);
  set_skill("force", 200);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  //       set_skill("noloveforce",150);
  //        set_skill("literate",150);
  // set_skill("huanhua-steps",200);
  //    set_skill("huanhua-sword",200);/
  //map_skill("force","noloveforce");
  //map_skill("sword","huanhua-sword");
  //map_skill("dodge","huanhua-steps");
  set("chat_chance", 2);
  set("chat_msg", ({
    "萧秋水说道：若能找到唐方就好了。\n",
    "萧秋水说道：唐方不知道去那里了。\n",
  }));

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("obj/weapon/longsword")->wield();
}
string ask_me() {
  object ob;
  if ((int)this_player()->query("combat_exp") < 1000000)
    return RANK_D->query_respect(this_player()) + "资质不够，给你推荐不太好。";
  if ((int)this_player()->query("for_badp") == 0)
    return RANK_D->query_respect(this_player()) + "不是给你推荐了吗?";
  ob = new("/letter");
  ob->move(this_player());
  this_player()->set("for_badp");
  message_vision("$N获得一封推荐信。\n", this_player());

  return "好吧，凭我这封推荐信，你或许能拜尉迟二为师。";

}
void attempt_apprentice(object me) {
  if (me->query_temp("for_qiushui")) {
    command("sigh");
    command("say 唐方原来在那里啊，！\n");
    command("recruit " + me->query("id"));
    return;
  } else {
    command("shake");
    command("say 你若能找到唐方，我就收你为徒。\n");
  }
}


void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "zhen");
}
void init() {
  add_action("give_quest", "quest");
}
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 4000) {
    student->set("title", "神州结义帮众");
    return;
  } else if (exp <= 10000) {
    student->set("title", "神州结义小豪侠");
    return;
  } else if (exp <= 18000) {
    student->set("title", "神州结义豪侠");
    return;
  } else if (exp <= 30000) {
    student->set("title", "神州结义剑奴");
    return;
  } else if (exp <= 60000) {
    student->set("title", "神州结义剑王");
    return;
  } else if (exp <= 120000) {
    student->set("title", "神州结义剑神");
    return;
  } else if (exp <= 300000) {
    student->set("title", "神州结义剑圣");
    return;
  } else if (exp <= 800000) {
    student->set("title", "神州结义管家");
    return;
  } else if (exp <= 2000000) {
    student->set("title", "神州结义大管家");
    return;
  } else if (exp <= 6000000) {
    student->set("title", "神州结义副总管");
    return;
  } else if (exp <= 12000000) {
    student->set("title", "神州结义总管");
    return;
  } else
    student->set("title", "神州结义老二");
  return;
}
int is_ghost() { return 1; }
