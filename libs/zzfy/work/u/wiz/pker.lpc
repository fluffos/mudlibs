#include <ansi.h>

inherit NPC;

void create() {
  set_name("杀无赦", ({ "sha wushe", "sha", "wushe" }));
  set("long",
    "他就是「杀手联盟」的一级杀手.\n" +
    "他用黑布蒙着脸,可是透过他的眼神你仍然依稀可见恐怖\n" +
    "他面色煞白,你不敢多看了一眼.\n");
  set("title", "杀手联盟高手");
  set("gender", "男性");
  set("age", 36);
  set("shen_type", 0);
  set("attitude", "peaceful");

  set("str", 500);
  set("int", 50);
  set("con", 50);
  set("dex", 50);

  set("kee", 5000000);
  set("max_kee", 5000000);
  set("sen", 5000000);
  set("max_sen", 5000000);
  set("gin", 1400000);
  set("max_gin", 500000);
  set("force", 90000000);
  set("max_force", 2000000);

  set("combat_exp", 60000000);
  set("score", 2000000);
  set_skill("force", 500);
  set_skill("unarmed", 500);
  set_skill("dodge", 500);
  set_skill("parry", 550);
  set_skill("sword", 550);
  set_skill("literate", 200);
  set_skill("luoriquan", 500);
  set_skill("iron-cloth", 500);

  //   map_skill("force", "yiqiguanforce");
  map_skill("unarmed", "luoriquan");

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.luori" :),
  }));
  setup();
  carry_object("/obj/cloth")->wear();

}

void init() {
  object ob;

  ::init();

  ob = this_player();

  if (ob->query("OPK") > 0) {
    command("heihei");
    command("say 我平生最讨厌你这些喜欢杀人的人！与其让你杀人，还不如我把你给杀了,受死吧！\n");
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
    command("perform yiqiguanriyue");
  }
}
