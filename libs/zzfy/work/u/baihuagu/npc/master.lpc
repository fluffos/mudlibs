inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  set_name("百花仙", ({ "master baihuaxian", "master" }));
  set("nickname", HIW "无忧仙子" NOR);
  set("gender", "女性");
  set("age", 20);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("int", 30);
  set("per", 100);
  set("agi", 25);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sijifeihua" :),
    (: perform_action, "dodge.wunianwuyou" :),
  }));
  set("attitude", "friendly");
  set("max_force", 5000);
  set("force", 5000);
  set("force_factor", 30);
  set("max_kee", 99999);
  set("max_gin", 99999);
  set("max_sen", 99999);
  set("eff_kee", 99999);
  set("kee", 999999);
  set("chat_chance", 1);
  set("chat_msg", ({
    "百花仙子从怀中拿出短箫。\n百花仙子不经意在短箫上吹了几下。\n",
  }));

  set("long",
    "
百花仙子那美丽的容貌让阳光都为之闭让．．．
百花仙子那无忧的神态让微风都为之赞叹．．．
\n"
  );
  create_family("百花谷", 1, "谷主");

  set("combat_exp", 6000000);
  set("score", 200000);

  set_skill("move", 120);
  set_skill("daode", 150);
  set_skill("sword", 150);
  set_skill("parry", 150);
  set_skill("dodge", 120);
  set_skill("force", 180);
  set_skill("literate", 180);
  set_skill("unarmed", 150);
  set_skill("siji", 150);
  set_skill("jingshenforce", 120);
  set_skill("wuyou-steps", 130);
  set_skill("baihua-sword", 180);
  map_skill("dodge", "wuyou-steps");
  map_skill("sword", "baihua-sword");
  map_skill("force", "jingshenforce");
  map_skill("parry", "baihua-sword");
  map_skill("unarmed", "siji");


  setup();
  carry_object(__DIR__ "obj/colorcloth")->wear();
  carry_object(__DIR__ "obj/cq")->wield();
}

void attempt_apprentice(object me) {
  command("recruit " + me->query("id"));
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "baihua");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "百花谷花奴");
    return;
  } else if (exp <= 128000) {
    student->set("title", "百花谷花使");
    return;
  } else if (exp <= 512000) {
    student->set("title", "百花谷花尊");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "百花谷花圣");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "百花谷花灵");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "百花谷花仙");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "百花谷花神");
    return;
  } else
    student->set("title", "百花谷谷主");
  return;
}
