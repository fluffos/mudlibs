
inherit NPC;

void create()
{
        set_name("蜜蜂", ({ "bee" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只小小的蜜蜂\n");
        set("max_kee", 1);
        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set_skill("dodge", 200);

        setup();
}

