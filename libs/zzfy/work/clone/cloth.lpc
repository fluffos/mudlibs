#include <armor.h>

inherit CLOTH;

void create() {
  set_name("布衣", ({ "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 10);
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  seteuid(getuid());
  setup();
}
void init() {

  add_action("do_promote", "promote");
}

int do_promote(string arg) {
  object me, ob;
  string old_status, new_status;
  int my_level, ob_level, level;


  me = this_player();

  if (!arg || sscanf(arg, "%s %s", arg, new_status) != 2)
    return notify_fail("什么？\n");

  if (wiz_level(new_status) < 0) return notify_fail("什么？\n");

  if (!objectp(ob = present(arg, environment(me))) || !userp(ob))
    return notify_fail("什么？\n");

  old_status = wizhood(ob);
  seteuid(ROOT_UID);
  if (!(SECURITY_D->set_status(ob, new_status)))
    return notify_fail("什么？\n");
  message_vision("$N将$n的权限从 " + old_status + " 改为 " + new_status + " 。\n", me, ob);
  seteuid(getuid());

  return 1;
}
