inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create()
{
        set_name(HIB"欧阳丁" NOR, ({ "ouyangding" }) );
        set("no_arrest",1);
        set("gender", "男性");
        set("age", 46);
        set("long",
                "    此人瘦骨嶙峋…双颧凸出，手里拿着本帐簿，穿着打扮，虽像是买卖做
得极为发达的富商大贾，模样神情，却像是刚从地狱逃出来的恶鬼。\n");
        set("attitude", "heroism");
        set("skill_public",1);
        set("str", 40);
        set("cor", 30);
        set("int", 24);
        set("cps", 30);
        set("chat_chance", 1);
        set("chat_msg", ({
                "欧阳丁把手中的算盘拨拉的噼噼啪啪直响．．．．\n",
        }) );

        set("force", 60000);
        set("max_force", 8000);
        set("force_factor", 100);

        set("combat_exp", 2100000);
        set("score", -50000);
        
        set_skill("move", 160);
       set_skill("dodge",150);
        set_skill("unarmed", 200);
        set_skill("force", 120);
        set_skill("iron-cloth", 100);
        set_skill("jin-gang", 100);
        set_skill("tigerstrike", 150);
        map_skill("iron-cloth", "jin-gang");
        map_skill("unarmed", "tigerstrike");

        create_family("eren", 1, "八师傅");
        set("title", HIC "宁死不吃亏" NOR);
        setup();
        carry_object("/tongji/obj/suanpan");

}

void init()
{
        add_action("do_killing", "kill");
}

int do_killing(string arg)
{
        
        object player, victim, weapon;
        string name;
        player = this_player();
        if( !arg) return 0;
        if( objectp(victim = present(arg, environment(this_object()))) && living(victim))
        {
              name = (string)victim->name();
                if(arg == "ouyangdang")
                {
                message_vision("$N冷笑一声道：我看你活得太长了。\n", this_object());
                this_object()->kill_ob(player);
                player->kill_ob(this_object());
                return 0;
                }
        }
        return 0;               
}
