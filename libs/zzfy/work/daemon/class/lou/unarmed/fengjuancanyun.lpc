// wx@fengyuntianxia
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        int orforce;
        object weapon;
        if(me->is_busy())
                return notify_fail("你现在没空！！\n");
        extra = me->query_skill("yingfengzhi",1);
        if ( extra < 100) return notify_fail("你的影风指法还不够纯熟！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［风卷残云］只能对战斗中的对手使用。\n");
        orforce = (int) me->query("force");

    if (orforce<200)  return notify_fail("你的内力不够。\n");
          weapon = me->query_temp("weapon");
          me->add_temp("apply/attack",extra/10);
      me->set("force_factor",0);
          me->add("force_factor",extra/5);
        msg = HIW  "$N使出影风指法中的［风卷残云］，十指连绵不断地向$n点出！\n" NOR;
        message_vision(msg,me,target);
        msg = HIG  "$N拇指猛点，一招[风平浪静]，指力带着丝丝劲力，闪电般向$n点出！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIG  "$N食指微弹，一招[风起云涌]，一股阴柔劲力骤的点向$n！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIG  "$N中指连弹，一招[风行一时]，指力连连点向$n！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
       msg = HIG  "$N无名指凌空一点，一招[风雨交加]，刚劲的指力带着嘶嘶劲风点向$n!" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
       msg = HIG  "$N小指轻拨，一招[风卷残云]，虚虚实实向$n点去！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->add("force",-100);
        me->add("force_factor",-extra/5);
        me->add_temp("apply/attack",-extra/10);

        me->start_busy(3);
        return 1;
}