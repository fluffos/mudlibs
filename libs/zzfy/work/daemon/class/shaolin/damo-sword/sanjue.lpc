// xgchen edit
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int i;
  object weapon;
  extra = me->query_skill("damo-sword", 1) * 2;
  if (extra < 160) return notify_fail("你的［达摩三绝剑］还不够纯熟！\n");
  if (me->query("force") < 500) return notify_fail("你的内力还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("[达摩三绝剑]只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  if (!weapon) return notify_fail("[达摩三绝剑]能是要剑才可以发出绝技！\n");
  if ((string)weapon->query("skill_type") != "sword")
    return notify_fail("[达摩三绝剑]能是要剑才可以发出绝技！\n");
  if ((string)me->query_skill_mapped("sword") != "damo-sword")
    return notify_fail("[达摩三绝剑]能是要装备剑才可以发出绝技！\n");
  extra = me->query_skill("damo-sword", 1);
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra * 10);
  msg = HIY "\n$N使出达摩剑法的[达摩三绝剑]中的第一绝,身体突然加快！\n\n" NOR;
  message_vision(msg, me, target);
  for (i = 0; i < extra / 500; i++) {
    msg = HIM "$N身如燕子，剑如风云！\n" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  }
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  msg = HIY "$N使出[达摩三绝剑]第二绝，闪电般直刺$n！\n" NOR;
  message_vision(msg, me, target);
  for (i = 0; i < extra / 500; i++) {
    msg = HIW "$N剑游无极，气涌剑身！\n" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  }
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  msg = HIY "$N使出[达摩三绝剑]第三绝，身体微转挥剑向$n削去！\n" NOR;
  message_vision(msg, me, target);
  for (i = 0; i < extra / 500; i++) {
    msg = HIB "$N挥剑闭目，突发长啸！\n" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  }
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra * 10);
  me->start_busy(4);
  return 1;
}

int help(object me) {
  write(WHT "\n达摩三绝剑：" NOR "\n");
  write(@HELP
          达摩三绝剑是由达摩禅师所创的无上剑法，以“快”“连”“准”见著。
          相传张三丰的太极剑是由此演变出来的。可想它的厉害！	
	绝技要求：	 (学）秘密；
	               (用）内力 500 以上；      
		        等级 80 以上;
HELP
  );
  return 1;
}
