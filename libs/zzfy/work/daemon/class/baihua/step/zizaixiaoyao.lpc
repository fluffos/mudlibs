// tie@fengyun
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  extra = me->query_skill("wuyou-steps", 1);
  if (extra < 50) return notify_fail("你的［无忧步法］还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［自在逍遥］只能对战斗中的对手使用。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "已经手忙脚乱了！\n");
  message_vision("$N身形如潺潺流水，在$n的身旁飘渺不定，$n的神色紧张，象似被$N梦幻般的步法所震撼！\n", me, target);
  if (random((int)target->query("combat_exp")) < (int)me->query("combat_exp")) {

    message_vision("结果$N被绕得脸色残白，手忙脚乱！\n", target);
    target->start_busy(3);
  } else {
    message_vision("结果$N神情自若,并不慌张！\n", me);
    me->start_busy(2);
  }
  return 1;
}
