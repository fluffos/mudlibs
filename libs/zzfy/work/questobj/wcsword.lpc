#include <weapon.h>
inherit SWORD;
#include <ansi.h>
void create() {
  set_name(HIY "无尘剑" NOR, ({ "wcsword" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("material", "stone");
    set("long", "一把宝剑。\n");
  }
  init_sword(90);
  setup();
}
