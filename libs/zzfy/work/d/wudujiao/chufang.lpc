inherit	ROOM;
#include <ansi.h>
void create()
{
	set("short", "厨房");
	set("long", @LONG
走过大厅是个不大不小的厨房，这里是五毒教教徒就餐的地方，厨子们正忙前忙后的
准备着饭菜。厨房中最明显的是一口大锅，里面热气腾腾的不知道在煮着什么。一
阵阵香气夹杂着些许药味从锅中飘出，让你不觉得食欲大振。

LONG
	);
	set("exits", ([	
  "north" : "/d/wudujiao/dt",
  "west" : "/d/wudujiao/yaofang",
]));
	set("objects", ([
	__DIR__"obj/daguo" : 1,
			]) );
	set("outdoors",	"wudujiao");


	set("coor/x",-17);
	set("coor/y",-440);
	set("coor/z",0);
	set("coor/x",-17);
	set("coor/y",-440);
	set("coor/z",0);
	set("coor/x",-17);
	set("coor/y",-440);
	set("coor/z",0);
	setup();
}
void reset()
{
	object *inv;
	object con, item;
	::reset();
	con = present("daguo", this_object());
	inv = all_inventory(con);
	if( !sizeof(inv) && !random(3))	{

	item = new(__DIR__"obj/food");
	item->move(con);
	}
}