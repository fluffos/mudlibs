inherit ROOM;
#include <room.h>
void create() {
  set("short", "教主卧房");
  set("long", @LONG
这里是五毒教教主休息的地方，这里布置的十分华丽，红毯金灯，屋角张绣花锦床。
由于五毒教的教主在不久前神秘的失踪了，所以现在教主职位暂由五毒教右护法担任。
右护法不顾教中众人反对，搬进教主卧房。而且终日不离开半步。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "hyt",
  ]));
  set("objects", ([
    __DIR__ "npc/yun": 1,
  ]));
  set("item_desc", ([
    "bed": "这张绣花锦床似乎可以推开(push)。\n",
    "床": "这张绣花锦床似乎可以推开(push)。\n",

    "绣花锦床": "这张绣花锦床似乎可以推开(push)。\n",
  ]));
  set("coor/", -70);
  set("coor/y", -430);
  set("coor/z", 0);
  set("coor/x", -70);
  set("coor/y", -430);
  set("coor/z", 0);
  set("coor/x", -70);
  set("coor/y", -430);
  set("coor/z", 0);
  set("coor/x", -70);
  set("coor/y", -430);
  set("coor/z", 0);
  setup();

}
void init() {
  add_action("do_push", "push");

}


int do_push(string arg) {
  object ob;
  object sect;
  if (!arg && arg != "bed" && arg != "床" && arg != "绣花锦床")
    return 0;
  if (ob = present("master yun", this_object())) {
    message_vision("$N的脸上露出了一种奇怪的表情，对$n低声说道：“不要乱动本教主的东西！！\n", ob, this_player());
    return 1;
  }
  if (!query("exits/down")) {
    message_vision("$N把绣花锦床推开发现了一条密道．\n", this_player());
    set("exits/down", __DIR__ "secret_room");
    sect = find_object(__DIR__ "secret_room");
    if (!sect)
      sect = load_object(__DIR__ "secret_room");

    sect->set("exits/up", __FILE__);
  } else {
    message_vision("$N把绣花锦床推过来掩盖住密道．\n", this_player());
    delete("exits/down");
    sect = find_object(__DIR__ "secret_room");
    if (!sect)
      sect = load_object(__DIR__ "secret_room");
    sect->delete("exits/up");
  }
  return 1;
}
