// cloth.c
//
// This	is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create() {
  string *order = ({ "蓝缎白花", "白缎蓝花",
    "青缎红花", "紫缎白花", "黑缎绿花", "绿缎蓝花" });
  set_name((order[random(6)]) + "教服", ({ "jiao clothes", "clothes" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 100000);
    set("jiao_cloth", 1);
    set("material", "cloth");
    set("armor_prop/armor", 20);
  }
  setup();
}
