// TIE@FY3
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create() {
  set_name(HIG "青蛇剑" NOR, ({ "qingshe sword" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "一柄扭曲的蛇形利剑。\n");
    set("value", 50000);
    set("rigidity", 2000);
    set("material", "steel");
    set("max_enchant", 7);
    set("for_create_weapon", 1);
  }
  init_sword(50);

  setup();
}
