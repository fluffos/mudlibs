inherit	NPC;
inherit	F_MASTER;
#include <ansi.h>
void create()
{
	set_name("司徒星", ({ "master yun", "master"}) );
	set("nickname",	HIG "披星戴月"NOR);
	set("gender", "男性" );
	set("age", 70);
	set("per", 3);
	set("agi",25);
	set("int",30);
	set("attitude","friendly");
	set("max_force", 30000);
	set("force", 15000);
	set("force_factor", 100);
	set("chat_msg",	({

		"司徒星痛苦的呻吟了几声。\n司徒星恨恨地说道：该杀的云飘扬，枉费我对他那么好...哎...。\n",
	}) );
	set("long",
"
司徒星是五毒教的教主。但现在的他只是一个只剩一口气的囚犯了.....
他那当日的威风在他现在那苍老的脸上再也看不到了，他之所以还能活
着就是因为他还要报仇...
\n"
	);
	create_family("五毒教",	1, "教主");
	set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
		(: perform_action, "sword.qianshechudong" :),
		(: perform_action, "dodge.zhizunwudu" :),
	       // (: perform_action, "unarmed.dimo" :),
		(: exert_function, "zhangqi" :)
	}) );
	set("combat_exp", 5000000);
	set("score", 200000);


	set_skill("move", 150);
        set_skill("parry",150);
	set_skill("dodge", 150);
	set_skill("force", 180);
	set_skill("literate", 120);
	set_skill("unarmed",120);
	set_skill("sword",120);
        set_skill("qingshe-sword",150);
        set_skill("toxin",150);
        set_skill("wudutoxin",150);
        set_skill("wudu-steps",150);

//      set_skill("demon-strike",70);
        set_skill("wudu-force",150);
        set_skill("perception",150);
	map_skill("dodge", "wudu-steps");
	map_skill("force", "wudu-force");
	map_skill("sword", "qingshe-sword");
	map_skill("toxin", "wudutoxin");
	setup();
	carry_object(__DIR__"obj/jiao_cloth")->wear();

	carry_object(__DIR__"obj/xysword")->wield();

}

void attempt_apprentice(object me)
{
	if(me->query_temp("won_yun"))
	{
	command("smile");
	command("recruit " + me->query("id") );
		return;
	}
	else
	{
	command("shake");
	}
}

void recruit_apprentice(object ob)
{

	if( ::recruit_apprentice(ob) )
		ob->set("class", "wudujiao");
}
void re_rank(object student)
{
		student->set("title","五毒教大护法");
		return ;

}
