inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  set_name("蓝凤凰", ({ "master lan", "master" }));
  set("nickname", HIR "蚀骨消魂" NOR);
  set("gender", "女性");
  set("age", 50);
  set("dur", 20);
  set("per", 50);
  set("agi", 25);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 3000);
  set("force", 1500);
  set("force_factor", 150);

  set("long",
    "
蓝凤凰是五毒教的护法，自从五毒教教主失踪后，他就顺理成章的成为了五毒教的
教主了。他为人狡诈，多疑。城府极深，武功在五毒教里也可以说是除教主以外的
第一高手了。
\n"
  );
  create_family("五毒教", 2, "代教主");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword.qianshechudong" :),
    (: perform_action, "dodge.zhizunwudu" :),
    // (: perform_action, "unarmed.dimo" :),
    (: exert_function, "zhangqi" :)
  }));
  set("combat_exp", 3000000);
  set("score", 200000);

  set_skill("move", 150);
  set_skill("parry", 120);

  set_skill("dodge", 150);
  set_skill("force", 180);
  set_skill("literate", 120);
  set_skill("unarmed", 120);
  set_skill("sword", 120);
  set_skill("qingshe-sword", 120);
  set_skill("toxin", 120);
  set_skill("wudutoxin", 120);
  set_skill("wudu-steps", 120);
  //	set_skill("demon-strike",70);
  set_skill("wudu-force", 120);
  set_skill("perception", 120);
  map_skill("dodge", "wudu-steps");
  map_skill("force", "wudu-force");
  map_skill("sword", "qingshe-sword");
  map_skill("toxin", "wudutoxin");
  setup();
  carry_object(__DIR__ "obj/jiao_cloth")->wear();
  carry_object(__DIR__ "obj/xysword")->wield();


}

void attempt_apprentice(object me) {
  if (me->query_temp("won_baichan")) {
    command("smile");
    command("recruit " + me->query("id"));
    return;
  } else {
    command("shake");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "wudujiao");

}
void re_rank(object student) {
  student->set("title", "五毒教坛主");
  return;

}
int accept_fight(object me) {
  if (me->query("family/family_name") == query("family/family_name") &&
    me->query("family/master_id") == query("id")) {
    command("say 好，你要是赢了我，就可以去找教主学功夫了！\n");
    return 1;
  } else {
    command("say 开什么玩笑，你配和我动手吗	？\n");
    return 0;
  }

}
void win_enemy(object loser) {
  command("say 哎！徒儿还要努力呀！\n");
}
void lose_enemy(object winner) {
  command("say 不枉我尽心教导你！好！你可以到教主那里深造去了。\n");
  winner->set_temp("won_yun", 1);
}

int accept_object(object who, object ob) {
  object silk;
  if (ob->query("id") == "tigers") {
    command("touch");
    command("say 这位" + RANK_D->query_respect(who) + "，感谢你帮了我的大忙,这是给你的酬劳！\n");
    silk = new("/questnew/obj/hongbao");
    silk->move(this_object());

    command("give full-hongbao to " + who->query("id"));
    add("given", 1);
    return 1;
  }
  tell_object(who, "蓝凤凰说道：这不是我想要的。\n");
  return 0;
}
