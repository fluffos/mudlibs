inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  set_name("青蛇老者", ({ "master snake", "master" }));
  set("nickname", HIG "青蛇旗-旗主" NOR);
  set("gender", "男性");
  set("age", 60);
  set("per", 3);
  set("agi", 25);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 3000);
  set("force", 1500);
  set("force_factor", 30);
  set("long",

    "
青蛇老者是五毒教中的地位仅次于护法的五大毒使之一，
他身为五大毒使之一，无论是武功还是修养都是五毒教中数
一数二的，他是青蛇旗的旗主。
\n"
  );
  create_family("五毒教", 7, "旗主");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    //		  (: perform_action, "unarmed.dimo" :),
    (: perform_action, "dodge.zhizunwudu" :),
    (: perform_action, "sword.qianshechudong" :),
    (: exert_function, "zhangqi" :)
  }));
  set("combat_exp", 1000000);
  set("score", 200000);

  set_skill("move", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);

  set_skill("force", 100);
  set_skill("sword", 100);
  set_skill("qingshe-sword", 100);
  set_skill("literate", 80);
  set_skill("unarmed", 70);
  set_skill("toxin", 50);
  set_skill("wudutoxin", 50);
  set_skill("wudu-steps", 80);
  // set_skill("demon-strike",70);
  set_skill("wudu-force", 70);
  set_skill("perception", 70);
  map_skill("dodge", "wudu-steps");
  map_skill("force", "wudu-force");
  map_skill("sword", "qingshe-sword");
  //	map_skill("unarmed", "demon-strike");
  map_skill("toxin", "wudutoxin");
  setup();
  carry_object(__DIR__ "obj/jiao_cloth")->wear();
  carry_object(__DIR__ "obj/shesword")->wield();


}

void attempt_apprentice(object me) {
  if ((int)me->query_skill("toxin", 1) >= 20) {
    command("smile");
    command("recruit " + me->query("id"));
    return;
  } else {
    command("heihei");
    command("say 你下毒的基本功还行，你还是找本书学学吧！\n");

  }
}

void recruit_apprentice(object ob) {

  if ( ::recruit_apprentice(ob))
    ob->set("class", "wudujiao");
}
void re_rank(object student) {
  student->set("title", "五毒教青蛇旗弟子");
  return;

}
int accept_fight(object me) {
  if (me->query("family/family_name") == query("family/family_name") &&
    me->query("family/master_id") == query("id")) {
    command("say 好，你要是赢了我，就可以去找我师兄学功夫了！\n");
    return 1;
  } else {
    command("say 开什么玩笑，你配和我动手吗	？\n");

    return 0;
  }
}
void win_enemy(object loser) {
  command("say 哎！徒儿还要努力呀！\n");
}
void lose_enemy(object winner) {
  command("say 不枉我尽心教导你！好！你可以到你师伯那里深造去了。\n");
  winner->set_temp("won_qingshe", 1);
}

void init() {
  add_action("do_get", "get");
}

int do_get(string arg) {

  string what, where;
  if (!arg) return 0;
  if (sscanf(arg, "%s from %s", what, where) != 2) return 0;
  if (where == "xiqiang" || where == "西墙" ||
    where == "west wall" || where == "wall") {
    message_vision("$N对$n大吼一声：大胆！竟敢打本教圣物的主意！\n", this_object(), this_player());
    this_object()->kill_ob(this_player());
    this_player()->start_busy(2);
    return 1;
  }

  return 0;
}
