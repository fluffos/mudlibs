inherit	NPC;
void create()
{
	string *name = ({"烂醉如泥的","醉意熏熏的","春风得意的","笑口颜开的","一筹莫展的"});
	set_name(name[random(sizeof(name))]+"教徒", ({ "jiaotu", "tu"})	);
	set("gender", "男性" );
	set("age",random(20)+ 32);
	create_family("五毒教",	15, "教徒");
	set("long", "这是一个一手拿着酒碗，一手拿着鹿腿的五毒教教徒。\n");
	set("vendetta_mark","wudujiao");
	set("combat_exp", random(1000)+1000);
	set("attitude",	"friendly");
	set_skill("unarmed", 60+random(10));
	set_skill("dabei-strike",random(10)+70);
	set("chat_chance", 2);
	set("chat_msg",	({
		(: random_move :),

		name()+"大声叫道：好酒入口，好肉在手，一醉方休！\n",
	}) );
	set_skill("move",40);
	set_skill("force",20);
	map_skill("unarmed", "dabei-strike");
	set("chat_chance_combat", 10);
	set("force",50);
	set("chat_msg_combat", ({
		(: perform_action, "unarmed.qianshouqianbian" :),
	}) );
	set("max_force",50);
	set("force_factor",2);
	setup();
	carry_object(__DIR__"obj/jiao_cloth")->wear();
	//carry_object(__DIR__"obj/ironfist")->wield();
}