inherit ROOM;
void create() {
  set("short", "路边客栈");
  set("long", @LONG
一个不大的小客栈。当门挂着一个“酒”字招牌。招牌下面系着几个小小的黄铜风铃。
微风掠过，风铃发出清脆悦耳的叮咚声。客栈是五毒教教徒开的，为的是对进入五毒教
的江湖好汉有个了解。五毒教的教徒多视酒如命，经常三五成群的来这里喝酒。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "road1",
  ]));
  set("objects", ([
    __DIR__ "npc/waiter": 1,
    __DIR__ "npc/jiaotu2": 4,
  ]));

  set("coor/x", -10);
  set("coor/y", -440);

  set("coor/z", 0);
  set("coor/x", -10);
  set("coor/y", -440);
  set("coor/z", 0);
  set("coor/x", -10);
  set("coor/y", -440);
  set("coor/z", 0);
  setup();
}
