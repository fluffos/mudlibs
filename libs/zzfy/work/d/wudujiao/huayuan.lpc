inherit ROOM;
#include <room.h>
void create() {
  set("short", "后院门");
  set("long", @LONG
这里是五毒教的后院门，透过月牙般的小门向里面望去，院内百花争奇斗艳。
蜜蜂，彩蝶在花间飞舞。两旁是绿油油的芳草地，微风吹过，青草晃动，似乎里
面隐藏着无限的杀机。
LONG
  );
  set("exits", ([
    "northeast": __DIR__ "wuku",
    "southeast": __DIR__ "yaofang",
    "west": __DIR__ "garden",
    "north": __DIR__ "grass",
    "south": __DIR__ "grass1",
  ]));
  set("outdoors", "wudujiao");
  set("coor/x", -30);

  set("coor/y", -430);
  set("coor/z", 0);
  set("coor/x", -30);
  set("coor/y", -430);
  set("coor/z", 0);
  set("coor/x", -30);
  set("coor/y", -430);
  set("coor/z", 0);
  setup();
}
