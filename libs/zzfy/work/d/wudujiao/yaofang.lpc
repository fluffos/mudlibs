inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "药房");
  set("long", @LONG
这里是五毒教的药房，到处弥漫着呛人的草药味道。墙角里堆满个各种中草药，一个
满头白发的老医生正在忙碌着。靠墙的一块牌匾上写着：

		 死神客星

LONG
  );
  set("exits", ([
    "east": __DIR__ "chufang",
    "northwest": __DIR__ "huayuan",
  ]));
  set("objects", ([
    __DIR__ "obj/corner": 1,
    __DIR__ "npc/tangji": 1,

  ]));

  set("outdoors", "wudujiao");

  set("coor/x", -20);
  set("coor/y", -440);
  set("coor/z", 0);
  set("coor/x", -20);
  set("coor/y", -440);
  set("coor/z", 0);
  set("coor/x", -20);
  set("coor/y", -440);
  set("coor/z", 0);
  setup();
}
void reset() {
  object *inv;
  object con, item1, item2, item3;
  ::reset();

  con = present("corner", this_object());
  inv = all_inventory(con);
  if (!sizeof(inv)) {
    item1 = new(__DIR__ "obj/caoyao");
    item2 = new(__DIR__ "obj/caoyao");
    item3 = new(__DIR__ "obj/caoyao");
    item1->move(con);
    item2->move(con);
    item3->move(con);
  }
}
