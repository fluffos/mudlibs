// TIE@FY3
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create() {
  set_name(HIC "五毒神刃" NOR, ({ "wudu sword" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "一柄奇形怪状的兵刃。\n");
    set("value", 50000);
    set("rigidity", 2000);
    set("material", "iron");
    set("max_enchant", 7);
    set("for_create_weapon", 1);
  }
  init_sword(70);

  setup();
}
