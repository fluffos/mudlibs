#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIG "如意青蛇剑" NOR, ({ "qingshe sword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把墨绿色的喂有青蛇毒的宝剑。\n");
    set("value", 400);
    set("material", "steel");
    set("wield_msg", "$N从腰间的蛇纹剑鞘中抽出一把寒气逼人的$n握在手中。\n");
    set("unwield_msg", "$N握着$n的手微微一动，$n自动弹回蛇纹剑鞘中。\n");
  }
  init_sword(55);
  setup();

}
mixed hit_ob(object me, object victim, int damage_bonus) {
  victim->apply_condition("she_poison", random(10) + 10);

  return HIG "$n似乎染上了如意青蛇剑上的青蛇毒！\n" NOR;
}
