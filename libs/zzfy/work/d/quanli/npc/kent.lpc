#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("兰特", ({ "kent" }) );
        set("long",
                "风云中最大的帮派，权力帮的总管。\n");
	set("nickname", GRN"落雪随风"NOR);
        create_family("权力帮",2,"总管");
	 set("str", 30);
        set("cor", 30);
        set("cps", 30);
	set("agi",30);
	set("int",30);
       set("attitude","friendly");
        set("max_force", 10000);
        set("force", 10000);
set("atman", 1000);set("mana", 1000);
        set("force_factor", 10);
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({(: perform_action, "blade.banlanwushi" :),
                  (: perform_action, "dodge.changmengwuchen" :),      }) );
                 set("inquiry", ([
"帮主": "帮主近来正在接待萧秋水那小子，没空理你。 \n",
"规矩": "你若能接我三刀，我就收你。(accept test)\n",
        ]) );
set("combat_exp", 2000000);
	set_temp("apply/damage",500);
        set_skill("unarmed", 80);
	set_skill("blade",100);
	set_skill("force",130);
        set_skill("parry",90);
        set_skill("dodge",90);
	 set_skill("move",90);
	set_skill("literate",160);
	set_skill("wuchenforce",100);
set_skill("tang-blade",150);
set_skill("throwing",50);
set_skill("tang-throwing",40);
    set_skill("wuchen-steps",100);
map_skill("force","wuchenforce");
map_skill("blade","tang-blade");
map_skill("throwing","tang-throwing");
map_skill("dodge","wuchen-steps");
            set("chat_chance", 2);
set("chat_msg", ({
                "兰特说道：萧秋水那小子果然有两下子，两招内就被他破了我的刀法。\n",
                "兰特说道：呀，萧秋水那家伙把我的小刀弄到哪儿去了？\n",
        }) );

    setup();

             carry_object(__DIR__"obj/blade")->wield();
}

void attempt_apprentice(object me)
{
        command("say 你连我收徒的规矩都不知道，我怎么收你？\n");
}
void init()
{
        ::init();
        add_action("do_accept", "accept");

}
int do_accept(string arg)
{
        mapping guild;

        if( arg== "test" ) {
	if(this_player()->query("family/master_id") == this_object()->query("id"))
	{
	say("\n兰特拍拍你的头道：好好为权力帮效力吧！\n");
	return 1;
	}
	
                say("\n兰特点了点头，说道：很好，这是第一招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                        
say("兰特叹了口气，说道：连第一招都撑不过，还想拜师，嘿嘿....\n");
                        return 1;
		}
                say("\n兰特说道：这是第二招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                        
say("兰特「哼」地一声，说道：还是接不下第二招....\n");
                        return 1;
                }
                say("\n兰特说道：第三招来了....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                        
say("兰特叹道：快离开，你武功根基太差....\n");
                        return 1;
                }
                
say("\n兰特哈哈大笑，说道：八大天王果然没看错眼，是块可用之才！\n\n");
                command("recruit " + this_player()->query("id") );
                return 1;
        }
        return 0;
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "quanli");
}
void killed_enemy(object who)
{
        command("say 白痴一个，死不足惜！\n");
}

void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 4000 ) {
                student->set("title","权力帮帮众");
                return ;
        } else if ( exp <= 10000 ) {
                student->set("title","权力帮小地魔");
                return ;
        } else if ( exp <= 18000 ) {
                student->set("title","权力帮地魔");
                return ;
        } else if ( exp <= 30000) {
                student->set("title","权力帮小天魔");
                return ;
        } else if ( exp <= 60000 ) {
                student->set("title","权力帮天魔");
                return ;
        } else if ( exp <= 120000 ) {
                student->set("title","权力帮小天王");
                return ;
        } else if ( exp <= 300000 ) {
                student->set("title","权力帮天王");
                return ;
        } else if ( exp <= 800000 ) {
                student->set("title","权力帮老小管家");
                return ;
        } else if ( exp <= 2000000 ) {
                student->set("title","权力帮大管家");
                return ;
        } else if ( exp <= 6000000 ) {
                student->set("title","权力帮副总管");
                return ;
        } else if ( exp <= 12000000 ) {
                student->set("title","权力帮总管");
                return ;
        } else
                student->set("title","权力帮副帮主");
                return ;
}
int accept_fight(object me)
{
        if(this_player()->query("family/master_id") == this_object()->query("id"))
	  
        {
        command("say 好，你赢了我，你就可以去找帮主了！\n");
        return 1;
        }
        else
        {
        command("say 没空！\n");
        return 0;
        }
}
void win_enemy(object loser)
{
command("say 你武功不行啊！\n");
}
void lose_enemy(object winner)
{
command("say 果然厉害！你可以去见帮主了。\n");
winner->set_temp("won_kent",1);
}
int do_test(object me)
{
object ob;
message_vision(HIY "\n$N说道：别乱走！\n" NOR, this_object());

}		
int accept_object(object who, object ob)
{
	if(ob->query("id") == "dao")
	{
	command("say 你哪儿找来的？");
	command("thank "+who->query("id"));
	if(environment() != environment(who)) return 1;
if(!who->query("m_success/找小刀"))
        {
                who->set("m_success/找小刀",1);
                who->add("score",1000);

        }
	return 1;
	}
}

