// spy.c

inherit NPC;

void create()
{
        object obj;

        set_name("黑衣人", ({ "figure" }) );
        set("gender", "男性");
        set("age", 24);
        set("long",
                "这个人一身黑色服装，动作诡密．\n");
        set("combat_exp", 2000000);
        set_skill("dodge", 200);
        set_skill("unarmed", 120);
        set_skill("sword", 100);
        set_skill("parry", 200);
        set("attitude", "aggressive");
set_skill("move", 40);
 set("bellicosity", 1000 );
       setup();
        obj = carry_object(__DIR__"obj/sword");
        obj->wield();
        carry_object(__DIR__"obj/black_suit")->wear();
        
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}



