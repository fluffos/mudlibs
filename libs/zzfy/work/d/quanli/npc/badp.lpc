#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
inherit F_MASTER;
void create()
{
        set_name("尉迟二", ({ "badp" }) );
        set("long",
                "风云中最大的帮派，权力帮的帮主。\n");
	set("nickname", MAG"万潮鹏飞，君临天下"NOR);
        create_family("权力帮",2,"帮主");
	 set("str", 40);
        set("cor", 40);
        set("cps", 40);
	set("agi",40);
	set("int",40);
       set("attitude","friendly");
        set("max_force", 20000);
        set("max_atman", 5000);
set("max_mana", 6000);
set("force", 20000);
        set("force_factor", 30);
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({(: perform_action, "unarmed.pofuchenzhou" :),
                  (: perform_action, "dodge.changmengwuchen" :),      }) );
                 set("inquiry", ([
"权力帮": "权力帮自从李沉舟开帮以来，向来是武林第一大帮。 \n",
        ]) );
set("combat_exp", 10000000);
	set_temp("apply/damage",500);
        set_skill("unarmed", 150);
	set_skill("force",140);
        set_skill("parry",100);
        set_skill("dodge",100);
	set_skill("literate",110);
	set_skill("wuchenforce",150);
set_skill("liumang-strike",200);
    set_skill("wuchen-steps",150);
map_skill("force","wuchenforce");
map_skill("unarmed","liumang-strike");
map_skill("dodge","wuchen-steps");
            set("chat_chance", 2);
set("chat_msg", ({
                "尉迟二说道：若能让萧秋水加入权力帮，那我真是无憾了。\n",
                "尉迟二说道：权力帮的弟子别在我面前乱走。\n",
        }) );

    setup();

}
int accept_object(object me, object obj)
{
	if(obj->query("for_badp"))
	{
	me->set_temp("for_badp",1);
         command("say 难道他还是不肯。。。。唉！\n");
        command("recruit " + me->query("id") );
	return 1;
	}
	return 0;
}

void attempt_apprentice(object me)
{
        if(me->query_temp("for_badp"))
	{
	  command("sigh");
        command("say 算了，萧秋水还是不肯啊，！\n");
       command("recruit " + me->query("id") );
		return;
	}
	else
	{
	command("shake");
        command("say 你若能让萧秋水加入本帮，我便把一生所学尽传于你。\n");
	}
	}


void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "quanli");
}
void init()
{
        add_action("give_quest", "quest");
}
void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 4000 ) {
                student->set("title","权力帮帮众");
                return ;
        } else if ( exp <= 10000 ) {
                student->set("title","权力帮小地魔");
                return ;
        } else if ( exp <= 18000 ) {
                student->set("title","权力帮地魔");
                return ;
        } else if ( exp <= 30000) {
                student->set("title","权力帮小天魔");
                return ;
        } else if ( exp <= 60000 ) {
                student->set("title","权力帮天魔");
                return ;
        } else if ( exp <= 120000 ) {
                student->set("title","权力帮小天王");
                return ;
        } else if ( exp <= 300000 ) {
                student->set("title","权力帮天王");
                return ;
        } else if ( exp <= 800000 ) {
                student->set("title","权力帮老小管家");
                return ;
        } else if ( exp <= 2000000 ) {
                student->set("title","权力帮大管家");
                return ;
        } else if ( exp <= 6000000 ) {
                student->set("title","权力帮副总管");
                return ;
        } else if ( exp <= 12000000 ) {
                student->set("title","权力帮总管");
                return ;
        } else
                student->set("title","权力帮副帮主");
                return ;
}
