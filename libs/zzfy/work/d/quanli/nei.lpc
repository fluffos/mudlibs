
inherit ROOM;
#include <room.h>

void create()
{
        set("short", "门内");
        set("long", @LONG
这里是权力帮的正厅，帮内的兰总管经常在这里出现。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
               "south" : __DIR__"door",
        "north" : __DIR__"tang",
        ]));
        set("objects", ([
        __DIR__"npc/kent" : 1,
                        ]) );
        set("outdoors", "quanli");
	set("no_dazuo",1);
set("no_magic",1);
        set("coor/x",0);
	set("coor/y",12240);
	set("coor/z",0);
	setup();
        
}
int valid_leave(object me, string dir)
{
        object ob;
        if( dir == "north" && ob=present("kent", this_object()))
		if(!me->query_temp("won_kent"))
		{
	ob->do_test(me);
		return notify_fail("");
		}
		return 1;
}



