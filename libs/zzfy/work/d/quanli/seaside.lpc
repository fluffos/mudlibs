inherit ROOM;
#include <command.h>
void create()
{
	set("short", "权力湖");
	set("long", @LONG
碧海蓝天，这条湖泊是当年权力帮第一代水王的杰作。湖对岸就是神秘的权力岛，
不少武林正邪两派的高手都曾对它虎视耽耽，其中更有不少人硬闯权力岛，结果
无一能还。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"h",

]));
set("item_desc", ([
                "lake": "你可以从这里潜（ｄｉｖｅ）到湖底。\n",
                "湖" : "你可以从这里潜（ｄｉｖｅ）到湖底。\n"
        ]) );

set("outdoors", "quanli");

        set("coor/x",0);
	set("coor/y",12150);
	set("coor/z",0);
	setup();
	
}
void init()
{		
	add_action("do_dive","dive");}
int do_dive()
{
	object me;
	object room;
             me = this_player();
	message_vision("$N一个纵身，潜入湖中．．．\n",me);
	room = load_object(__DIR__"lake");
	me->move(room);
	return 1;	
}

