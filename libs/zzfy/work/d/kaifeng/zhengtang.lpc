/// Room: zhengtang.c
// atu 2000/01/10 
#include <ansi.h>
inherit ROOM;
//void kf_same(object who,object me);

void create()
{
	set("short", "开封府大堂");
	set("long", "
这里是开封府的大堂，堂下衙役分班站立，四周鸦鹊无声。堂口摆放
着皇上御赐的三口铜铡。包大人高坐在堂上，脸色阴沉，微有怒色，看来
正在下令捉拿人犯。大堂正中高悬一匾：\n"HIR+"
               明    镜    高    悬\n\n"NOR
        );
	set("valid_startroom",1);
	set("no_steal", "1");
	set("no_fight", "1");
	set("exits", ([
"south":__DIR__"wroad1",
"east":__DIR__"qianyafang",
	]));
       set("coor/x",50);
       set("coor/y",20);
       set("coor/z",0);

	set("objects", ([
		__DIR__"npc/bao": 1,
		"/d/fy/npc/yayi": 4,
	]));
	set("coor/x",50);
	set("coor/y",20);
	set("coor/z",0);
	setup();
//     replace_program(ROOM);
}

void init ()
{
	add_action("do_work","work");
	add_action("do_finish","finish");
}

int do_work (string arg)
{
	object ob,ob1;
	int kf_npc,kf_whatnpc,worked_num;
	string kf_name,kf_name1,kf_where,titles;
	object me = this_player();
		
	if ((int)me->query("kf_jiangli"))
		return notify_fail("包大人说道：神捕大人还没进京面圣啊？\n");

	if (!(int)me->query("kaifengfu"))
		return notify_fail("两旁衙役大声喝道：大胆刁民，不得咆哮公堂！\n");
	if (!objectp(present("bao daren", environment(me))))
		return notify_fail("衙役笑道：包大人已经退堂了，要想任务明日请早了您。\n");

	if (present("ling pai",me)||(int)me->query("kf_working"))
		return notify_fail("包大人脸色一沉道：本府前日交与你的差事速去办理，不得捻轻怕重！\n");
	kf_npc = 1 + random(165);
	kf_whatnpc =1+random(6);
	me->set("kf_whatnpc",kf_whatnpc);
	ob = new(__DIR__"obj/lingpai");        //50
	if(kf_whatnpc==1){ob1 = new(__DIR__"npc/tufei1");}
	if(kf_whatnpc==2){ob1 = new(__DIR__"npc/tufei2");}
	if(kf_whatnpc==3){ob1 = new(__DIR__"npc/tufei3");}
	if(kf_whatnpc==4){ob1 = new(__DIR__"npc/tufei4");}
	if(kf_whatnpc==5){ob1 = new(__DIR__"npc/tufei5");}
	if(kf_whatnpc==6){ob1 = new(__DIR__"npc/tufei6");}
//	kf_same(ob1,me);    
//	ob1->move(ob);
	ob ->move(me);
	me->set_temp("kf_npc",kf_npc);
	me->add("kf_worked",1);
	if(kf_npc<165) kf_where = "清平山庄附近";
	if(kf_npc<152) kf_where = "帝王谷附近";
	if(kf_npc<141) kf_where = "岱庙附近";
	if(kf_npc<125) kf_where = "大昭寺附近";
	if(kf_npc<107) kf_where = "千金楼附近";
	if(kf_npc<84) kf_where = "风云城中";
	if(kf_whatnpc==1){ kf_name = "蒙面大盗"; kf_name1 = "拦路抢劫,杀人如麻";}
	if(kf_whatnpc==2){ kf_name = "无影神偷"; kf_name1 = "四处盗窃财物";}
	if(kf_whatnpc==3){ kf_name = "恶人云中鹤"; kf_name1 = "经常劫掠民女，无恶不做";}
	if(kf_whatnpc==4){ kf_name = "西夏细作"; kf_name1 = "四处活动";}
	if(kf_whatnpc==5){ kf_name = "大辽奸细"; kf_name1 = "四处造谣破坏";}
	if(kf_whatnpc==6){ kf_name = "神秘人"; kf_name1 = "刺杀朝廷命官";}

	me->set_temp("kf_whatnpc",kf_whatnpc);
	me->set_temp("kf_name",kf_name);
	me->set_temp("kf_where",kf_where);
	message_vision ("包大人一拍惊堂木怒道：据查今有"+kf_name+"在"+kf_where+kf_name1+"，"+me->query("name")+"速去破案，不得有误。\n",me);
	me->set("kf_working",1);
/*
	titles = me->query("title");
	worked_num=me->query("kf_worked");
	if (worked_num>=3200 && strsrch(titles, HIY"【神捕】"NOR) < 0 )
		me->add("title",HIY"【神捕】"NOR);
	if (worked_num>=1600 && worked_num < 3200 && strsrch(titles, HIY"【御前一等侍卫】"NOR) < 0 )
		me->add("title",HIY"【御前一等侍卫】"NOR);
	if (worked_num>=800 && worked_num < 1600 && strsrch(titles, HIY"【御前二等侍卫】"NOR) < 0 )
		me->add("title",HIY"【御前二等侍卫】"NOR);
	if (worked_num>=400 && worked_num < 800 && strsrch(titles, HIY"【御前三等侍卫】"NOR) < 0 )
		me->add("title",HIY"【御前三等侍卫】"NOR);
	if (worked_num>=200 && worked_num < 400 && strsrch(titles, HIY"【开封府总捕头】"NOR) < 0 )
		me->add("title",HIY"【开封府总捕头】"NOR);
	if (worked_num>=100 && worked_num < 200 && strsrch(titles, HIY"【开封府副总捕头】"NOR) < 0 )
		me->add("title",HIY"【开封府副总捕头】"NOR);
	if (worked_num>=50 && worked_num < 100 && strsrch(titles, HIY"【开封府捕头】"NOR) < 0 )
		me->add("title",HIY"【开封府捕头】"NOR);
	if (worked_num >=20 && worked_num < 50 && strsrch(titles, HIY"【开封府捕快】"NOR) < 0 )
		me->add("title",HIY"【开封府捕快】"NOR);
	if (worked_num >=1 && worked_num < 20 && strsrch(titles, HIY"【开封府实习捕快】"NOR) < 0 )
		me->add("title",HIY"【开封府实习捕快】"NOR);
//   me->set_temp(kfwork_time,1);
		me->save();
*/	
	return 1;
}
int do_finish (string arg)
{
	object ob;
	int kf_npc,kf_whatnpc,kf_exp,kf_qn;
	string kf_name,kf_name1,kf_where,titles;
	object me = this_player();
	ob= present("ling pai",me);
	kf_name = me->query_temp("kf_name");
	kf_where = me->query_temp("kf_where");
	
	if (!(int)me->query("kaifengfu"))
		return notify_fail("两旁衙役大声喝道：大胆刁民，不得咆哮公堂！\n");
	if (!objectp(present("bao daren", environment(me))))
		return notify_fail("衙役笑道：包大人已经退堂了，要想交令明日请早了您。\n");
	if (!me->query("kf_working"))
		return notify_fail("包大人脸色一沉道：本府什么时候派过你差事啊？\n");
	if (!(int)me->query_temp("kf_finish"))
		return notify_fail("包大人脸色一沉道：本府交你的差使至今还未办妥，你还有面目来见我？\n");
	if (present("ling pai",me)){
		tell_object(me, "你恭恭敬敬的缴上令牌。\n" NOR );
	destruct(present("ling pai",me));
	}        
	message_vision ("包大人微微一笑道："+me->query("name")+"在"+kf_where+"破获"+kf_name+"一案，劳苦功高，赶快下去休息吧！\n",me);
	kf_exp = random(2000)+random(1000);
	kf_qn = random(500);
	me->add("combat_exp",kf_exp);
	me->add("potential",kf_qn);
	me->add("kf_worked",1);
	me->set("kf_working",0);
	me->delete_temp("kf_finish");
	tell_object(me, "你获得了" + chinese_number(kf_exp)+ "点经验。\n" NOR );
	tell_object(me, "你获得了" + chinese_number(kf_qn)+ "点潜能。\n" NOR );
	if (me->query("kf_worked")==3200){
		titles=replace_string( me->query("title"), HIY"【御前一等侍卫】"NOR, "");
		titles+=HIY"【神捕】"NOR;
		me->set("title",titles);
		me->add("score",200);
		message_vision(HIC "$N的评价提高了！\n" NOR,me);
		tell_object(me, "你现在的评价是" + chinese_number((string)(me->query("score")))+"。\n"NOR);
		message_vision (WHT"包大人微笑着说道："+me->query("name")+"连破大案，天下闻名，本府已经奏明圣上。\n昨日朝旨已下，命你进京面圣。你可立即动身，速去速回"NOR,me);
		me->set("kf_jiangli",1);

      }
	if (me->query("kf_worked")==1600){
		titles=replace_string( me->query("title"), HIY"【御前二等侍卫】"NOR, "");
		titles+=HIY"【御前一等侍卫】"NOR;
		me->set("title",titles);
		me->add("score",150);
		message_vision(HIC "$N的评价提高了！\n" NOR,me);
		tell_object(me, "你现在的评价是" + chinese_number((string)(me->query("score")))+"。\n"NOR);
      }
	if (me->query("kf_worked")==800){
		titles=replace_string( me->query("title"), HIY"【御前三等侍卫】"NOR, "");
		titles+=HIY"【御前二等侍卫】"NOR;
		me->set("title",titles);
		me->add("score",100);
		message_vision(HIC "$N的评价提高了！\n" NOR,me);
		tell_object(me, "你现在的评价是" + chinese_number((string)(me->query("score")))+"。\n"NOR);
	}
	if (me->query("kf_worked")==400){
		titles=replace_string( me->query("title"), HIY"【开封府总捕头】"NOR, "");
		titles+=HIY"【御前三等侍卫】"NOR;
		me->set("title",titles);
		me->add("score",80);
		message_vision(HIC "$N的评价提高了！\n" NOR,me);
		tell_object(me, "你现在的评价是" + chinese_number((string)(me->query("score")))+"。\n"NOR);
	}
	if (me->query("kf_worked")==200){
		titles=replace_string( me->query("title"), HIY"【开封府副总捕头】"NOR, "");
		titles+=HIY"【开封府总捕头】"NOR;
		me->set("title",titles);
		me->add("score",40);
		message_vision(HIC "$N的评价提高了！\n" NOR,me);
		tell_object(me, "你现在的评价是" + chinese_number((string)(me->query("score")))+"。\n"NOR);
	}
	if (me->query("kf_worked")==100){
		titles=replace_string( me->query("title"), HIY"【开封府捕头】"NOR, "");
		titles+=HIY"【开封府副总捕头】"NOR;
		me->set("title",titles);
		me->add("score",20);
		message_vision(HIC "$N的评价提高了！\n" NOR,me);
		tell_object(me, "你现在的评价是" + chinese_number((string)(me->query("score")))+"。\n"NOR);
	}
	if (me->query("kf_worked")==50){
		titles=replace_string( me->query("title"), HIY"【开封府捕快】"NOR, "");
		titles+=HIY"【开封府捕头】"NOR;
		me->set("title",titles);
		me->add("score",10);
		message_vision(HIC "$N的评价提高了！\n" NOR,me);
		tell_object(me, "你现在的评价是" + chinese_number((string)(me->query("score")))+"。\n"NOR);
	}
	if (me->query("kf_worked")==20){
		titles=replace_string( me->query("title"), HIY"【开封府实习捕快】"NOR, "");
		titles+=HIY"【开封府捕快】"NOR;
		me->set("title",titles);
	}
	me->save();
	return 1;
}
