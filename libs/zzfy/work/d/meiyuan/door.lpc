inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIW "梅园" NOR);
  set("long", @LONG
大天神卓不凡的官邸。一座极大的院子，门口汉白玉的
台阶铺着红色的地毯，两只形态各异石狮子分列在大门的左
右，黑漆大门上镶着两个金制门环，抬头见一个匾额，匾额
上龙飞凤舞的写着“梅园”两个字，一看就是出自名家之笔。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
