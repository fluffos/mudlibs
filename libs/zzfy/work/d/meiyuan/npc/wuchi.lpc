// waiter.c

inherit	NPC;
inherit	F_VENDOR;

void create()
{
	set_name("武痴", ({ "wu chi" })	);
	set("gender", "男性" );
	set("age", 22);
	set("long",
		"一个练武成痴的人。\n");
	set("combat_exp", 10000000);
	set("attitude",	"friendly");
	set("vendor_goods", ([
		"/d/meiyuan/obj/shengxian" : 5,
		"/d/meiyuan/obj/swordbook" : 5,
		"/d/meiyuan/obj/jiuyinbook" :5,
		"/d/meiyuan/obj/xiuxian" :5,
		"/d/meiyuan/obj/pozhupian" :5, 

       ]) );
	setup();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() )	{
		remove_call_out("greeting");
		call_out("greeting", 1,	ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob	|| environment(ob) != environment() ) return;
	switch(	random(3) ) {
		  case 0:
			say( "武痴说道：这位" +	RANK_D->query_respect(ob)
				+ "，看你也是练武之人，有什么不懂的就问我吧。\n");
			break;
	}
}