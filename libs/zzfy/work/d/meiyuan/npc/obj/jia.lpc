//magic@qy
#include <armor.h>
inherit	CLOTH;
#include <ansi.h>
void create()
{
	set_name(HIY"金丝软甲"NOR, ({ "jia" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long", "一件金丝编成的软甲。\n");
		set("material",	"cloth");
		set("armor_prop/armor",	500);
		set("armor_prop/intelligence",500);
	}
	setup();
}