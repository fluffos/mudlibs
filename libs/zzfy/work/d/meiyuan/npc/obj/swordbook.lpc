// XXDER
inherit	ITEM;
void create()
{
	string *names =	({
		"「华山剑谱」",
	});

	set_name( names[random(sizeof(names))],	({ "swordbook" }));
	set_weight(600);
	set("unit", "本");
	set("long", "华山派的独门秘籍。\n");
	set("value", 500000);
	set("skill", ([
		"name":			"sword",	     //	name of	the skill
		"exp_required":	0,				// minimum combat experience required
										// to learn this skill.
		"sen_cost":		40,				// gin cost every time study this
		"difficulty":	50,				// the base int	to learn this skill
										// modify is gin_cost's	(difficulty - int)*5%

		"max_skill":	150				 // the	maximum	level you can learn
										// from	this object.
	]) );
}