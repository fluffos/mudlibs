// sd.c 阿拉丁神灯
#include <ansi.h>
inherit ITEM;

void init()
{
        add_action ("do_trans","trans");}

void create()
{
        set_name("魔毯", ({"motan"}));
        set_weight(180);
             if (clonep())
                set_default_object(__FILE__);
else {
                set("value", 10000);
set("long", HIC"这就是传说的中的阿拉丁的那张魔毯,具有神奇的魔力,
可以带(trans)你到以下地方：

风云广场(gc)    沉香中心(cx)  少林寺(sl)   关外(gw)\n
神水宫(ss)      黄山(hs)      泰山(ts)     幽灵山庄(yl)\n
万梅山庄(wm)    长春岛(ccd)   兴国禅寺(xg) 千金楼(qjl)\n"NOR
);
                set("unit", "张");
             set("material", "steel");
}
                 setup();
}

int do_trans(string arg)
{

          string pla;
          object me = this_player();
if( me->query("gin") < 30 )               return notify_fail("你精神不够旺盛，无法使用魔毯！\n");           if (!arg)
              return notify_fail("你想飞到哪里？\n");
          if( !wizardp(me) && me->is_fighting()  ) 
          return notify_fail("这么危险，你还有空去拿神灯出来?\n");

          if( !wizardp(me) && !environment(me)->query("outdoors") ) 

          return notify_fail(HIY"\n这地方太矮了，还是等出去再用吧。\n"NOR);

          else {
          message_vision(HIY
"$N拿出从怀里拿出一张魔毯,向空中一抛,纵身一跃,跳到魔毯上面。\n"+
"$N紧闭双眼,对着魔毯念了几句咒语,魔毯载着$N直冲云霄。\n\n"NOR, me);
}
          if(arg=="gc") pla = "/d/fy/fysquare";
     else if(arg=="cx") pla = "/d/chenxiang/cxcenter";
     else if(arg=="sl") pla = "/d/shaolin/fang";
     else if(arg=="gw") pla = "/u/guanwai/shop";
     else if(arg=="ss") pla = "/d/shenshui/gong";
     else if(arg=="hs") pla = "/d/huangshan/shizi";
     else if(arg=="ts") pla = "/d/taishan/buyun";
     else if(arg=="yl") pla = "/u/ghost/house3";
     else if(arg=="wm") pla = "/d/wanmei/center";
     else if(arg=="ccd") pla = "/d/tieflag/moonding";
     else if(arg=="xg") pla = "/d/qianfo/tianwang";
     else if(arg=="qjl") pla = "/d/qianjin/jinge";
     

               else {
               message_vision(HIR
"魔毯飞了半天，才发觉$N要去的地方根本不存在，一怒之下，翻了过来，\n结果$N一个跟斗从天下栽了下来，摔得鼻青脸肿！\n"NOR, me);
}
     if (me->move(pla)) 
{
       message_vision(HIW"\n到了！魔毯稳稳地降到半空，$N轻轻从魔毯上跳了下来，将魔毯收回怀中。\n"NOR,me);
}}

