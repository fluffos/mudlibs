// XXDER
inherit ITEM;
void create() {
  string *names = ({
    "《九阴真经》「下册」",
  });

  set_name(names[random(sizeof(names))], ({ "jiuyin-book2" }));
  set_weight(600);
  set("unit", "本");
  set("long", "天下第一武学奇书。\n");
  set("value", 0);
  set("skill", ([
    "name": "dodge",      //	name of	the skill
    "exp_required": 0,    // minimum combat experience required
    // to learn this skill.
    "sen_cost": 40,    // gin cost every time study this
    "difficulty": 4,          // the base int to learn	this skill
    // modify is gin_cost's	(difficulty - int)*5%

    "max_skill": 150     // the	maximum	level you can learn
    // from	this object.
  ]));
}
