int recognize_apprentice(object ob)
{
 object xin;

 if(ob->query("score") > 10000) 
  {
   message_vision("血刀老祖说道：你这种正派人士还是找别人学吧。\n", ob);
   return 0;
  }
 if( !ob->query("marks/jpm") ) 
  {
   say("血刀老祖说道：你要是帮我找到彩绘全本金瓶梅，我就教你。\n");
   return 0;
  }
return 1;
}

int accept_object(object who, object ob)
{
        int bonus;
        if( ob->name() != "彩绘全本金瓶梅")
        {
                say("血刀老祖说道：我要这有什么用呢，又不是....\n");
                return 1;
        }
        else
        {
                who->set("marks/jpm", 1);
                say("血刀老祖说道：太好了！这本书真是太好了....\n");
                bonus = random(50);
                who->add("combat_exp", bonus);
                bonus = bonus + random(10);
                who->add("potential", bonus );
                if(!who->query("m_success/jpm"))
                        {
                        who->set("m_success/jpm",1);
                        if(who->query("score") >= 5000) who->add("score",-5000);
                        else who->set("score",0);
                        }
                return 1;
        }
        return 1;
}

