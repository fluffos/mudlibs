inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
        set_name("血刀老祖", ({ "xuedao laozu", "laozu" }) );
        set("nickname", HIR "血海淫僧"NOR);
        set("gender", "男性" );
        set("age", 72);
        set("str", 30);
        set("cor", 30);
        set("cps", 30);
        set("int", 30);
        set("per", 30);
        set("agi",30);
        set("skill_public",1);
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "blade.xueyin" :),
        }) );



        set("attitude","peaceful");
        set("max_force",3000);
        set("force", 3000);
        set("force_factor", 100);
        set("max_kee",2000);
        set("max_gin",2000);
        set("max_sen",2000);
        set("eff_kee",2000);
        set("kee",2000);
        set("chat_chance", 1);
        set("long",
"红光满面且目光淫亵的老和尚.
\n"
        );
        create_family("血刀门", 1, "门主");
        set("combat_exp", 5000000);
        set("score", 200000);

        set_skill("move", 300);
        set_skill("parry", 150);

        set_skill("dodge", 150);
        set_skill("force", 180);
        set_skill("literate", 150);
        set_skill("blade",180);
        set_skill("bloom-blade",150);
        set_skill("douzhuan-steps",150);
        set_skill("bloom-force",150);
        map_skill("dodge", "douzhuan-steps");
        map_skill("blade", "bloom-blade");
        map_skill("move", "douzhuan-steps");
        map_skill("force","bloom-force");
        map_skill("parry","bloom-blade");


        setup();
        carry_object(__DIR__"obj/bloomblade")->wield();
        
}
