//lmd@wenxin
//down_room
#include <ansi.h>

inherit	ROOM;

void create()
{
	object silver;
	set("short", HIY "细雨楼宝库" NOR);
	set("long", @LONG
这里是一间宽敞的地下室，两边壁上一溜一胳膊粗的牛油蜡，照得屋里如
白昼一般，靠墙堆着小山一样的金砖。刺得你眼睛都睁不开！！
LONG
	);

	set("objects", ([
		__DIR__"npc/dizi" : 2,
		__DIR__"npc/dizi1" : 2,
		"/obj/money/gold": 1		     

	]) );

	set("coor/x",20);
	set("coor/y",50);
	set("coor/z",-10);
	setup();
	silver = present("gold",this_object());
	silver->set_amount(random(10)+10);     
	silver->set("name", YEL	"小块金砖" NOR);
}
void init()
{
	add_action("do_break", "break");
}
int do_break(string arg)
{
	object obj;
	object me;
	if(!arg	|| arg=="")
	{

		write("你要拉什么？\n");
		return 1;
	}
	if( arg	== "door" || arg == "门" || arg	== "钢门")
	{
	me = this_player();
	message_vision("$N一踹开打大门，出现了一段向上的楼梯。\n", me);
	if( !query("exits/up") ) {
	set("exits/up",	__DIR__"zhangfang");
	/* if(!me->query("m_success/听雨楼"))
	 {
		me->set("m_success/听雨楼",1);
		me->add("score",100);

	} */
	call_out("close_path", 1);
	}
	return 1;
	}
	else
	      {
		write("你伸手轻轻拉了拉"+arg+"\n");
		return 1;
	}
}
void close_path()
{
	if( !query("exits/up") ) return;
	message("vision",
"厚重钢门大门忽然无声无息的合了起来．\n",
		this_object() );
		delete("exits/up");
}