inherit	NPC;
inherit	F_MASTER;
#include <ansi.h>
int kill_him();
void create()
{
	set_name("杨无邪", ({ "wuxie"})	);
	set("nickname",	HIW "万事通" NOR);
	set("gender", "男性" );
	set("age", 34);
	set("agi",30);
	set("per", 35);
	set("int",30);
	set("attitude","friendly");
	set("max_force", 3000);
	set("force", 3000);
	set("long",
"
他是青龙堂左护法，处事精明沉稳，武功高强，负责秘籍的看护。
\n"

	);
	create_family("清风细雨楼", 4, "左护法");
	set("chat_chance_combat", 20);
	
	set("combat_exp", 800000);
	set_skill("move", 100);
	set_skill("dodge", 100);
	set_skill("force", 100);
	set_skill("literate", 80);
	set_skill("unarmed",100);
	set_skill("liuyun-steps",100);
	set_skill("yingfengzhi",100);
	set_skill("cloudforce",80);
	map_skill("dodge", "liuyun-steps");
	map_skill("force", "cloudforce");
	map_skill("unarmed", "yingfengzhi");
	setup();
     //	  carry_object(__DIR__"obj/monk_cloth")->wear();



}

void init()
{
	add_action("do_get","get");
}

int do_get(string arg)
{
string what,where;
if(!arg) return	0;
if(sscanf(arg,"%s from %s",what, where)	!=2) return 0;
if(where == "匾" || where == "牌匾" ||
where == "bian")
{
message_vision("$N对$n大吼一声：大胆！竟敢在本座眼皮下盗书？！\n",this_object(),this_player());
this_object()->kill_ob(this_player());
this_player()->start_busy(2);
return 1;
}

return 0;
}