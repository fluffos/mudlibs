inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int kill_him();
void create() {
  set_name("燕北飞", ({ "master yan", "master" }));
  set("nickname", HIW "傲天孤燕" NOR);
  //       set("vendetta_mark","shaolin");
  set("gender", "男性");
  set("age", 44);
  set("agi", 30);
  set("per", 35);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 5000);
  set("force", 5000);
  set("long",
    "
他是青龙堂堂主，为人豪爽义气武功卓越。
\n"
  );
  create_family("清风细雨楼", 2, "楼主");
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.dodge.xingyunliushui" :),
    (: perform_action, "unarmed.fengjuancanyun" :)
  }));
  set("combat_exp", 1500000);
  set_skill("move", 120);
  set_skill("dodge", 120);
  set_skill("force", 140);
  set_skill("literate", 100);
  set_skill("unarmed", 140);
  set_skill("liuyun-steps", 120);
  set_skill("yingfengzhi", 120);
  set_skill("cloudforce", 100);
  map_skill("dodge", "liuyun-steps");
  map_skill("force", "cloudforce");
  map_skill("unarmed", "yingfengzhi");
  setup();
  //        carry_object(__DIR__"obj/monk_cloth")->wear();
  //      carry_object(__DIR__"obj/staff")->wield();

}

void attempt_apprentice(object me) {
  if (me->query_temp("won_master_yeguhun")) {
    command("smile");
    command("recruit " + me->query("id"));
    return;
  } else {
    command("shake");
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "lou");
}
void re_rank(object student) {
  student->set("title", "清风细雨楼青龙堂弟子");
  return;

}
int accept_fight(object me) {
  if (me->query("family/family_name") == query("family/family_name") &&
    me->query("family/master_id") == query("id")) {
    command("say 好，你赢了我，你就可以直接去见楼主了！\n");
    return 1;
  } else {
    command("say 你走吧，我的武功不是用来和人闹着玩的。\n");
    return 0;
  }
}
void win_enemy(object loser) {
  command("say 徒儿你离青出于蓝还远呢，还要加倍努力呀！\n");
}
void lose_enemy(object winner) {
  command("say 你的武功已经在我之上，你可以去见楼主了。\n");
  winner->set_temp("won_master_yan", 1);
}
