inherit	NPC;

void create()
{
	set_name("练武弟子", ({	"dizi"}) );
	set("gender", "男性" );
	set("age", 16);
	set("long", "这是一位清风细雨楼入室弟子。\n");
	set("combat_exp", 100000);
	set("attitude",	"friendly");
	set_skill("unarmed", 20+random(60));
	set_skill("dodge", 20 +	random(60));
	set_skill("move",150);
	set("chat_chance", 10);
	set("chat_msg",	({
		"清风细雨楼入室弟子紧锁双眉，正在沉思中．\n",
		"清风细雨楼入室弟子自言自语的说道：那招“风卷残云”为什么总是练不好？\n",
	}) );
	
	setup();

	add_money("silver", 5);
	//carry_object(__DIR__"obj/jinzhuang")->wear();
	//if (!random(3))
	//carry_object(__DIR__"obj/huopiao");

}