// waiter.c

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create()
{
        set_name("美人蕉", ({ "meiren" }) );
        set("gender", "女性" );
        set("age", 18);
        set("title", BLU "苗族少女" NOR);
        set("long",
                "这位小姑娘正对你露出灿烂的笑脸。\n");
        set("combat_exp", 500000);
        set("attitude", "friendly");
        set("per",30);
        set("vendor_goods", ([
                __DIR__"obj/flower":25,
/*                __DIR__"obj/yellow_flower":33,
                __DIR__"obj/blue_flower":44,
                __DIR__"obj/white_flower":14,
                __DIR__"obj/black_flower":10,
*/      ]) );
        set_skill("unarmed",50);
        set_skill("dodge",50);
        setup();
        carry_object(__DIR__"obj/wcloth")->wear();
//       if (!random(2)) carry_object("questnew/obj/txmuliao");
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(5) ) {
                case 0:
message_vision("$N笑着说道：各种茶花，买些回去给你的心上人吧。\n",this_object(),ob);
                        break;
                case 1:
message_vision("$N笑咪咪地说道：这位"+RANK_D->query_respect(ob)+
"要买几品花儿？\n",this_object(),ob);
                        break;
        }
}