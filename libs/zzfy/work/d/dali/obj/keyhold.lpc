inherit ITEM;
void create() {
  set_name("钥匙孔", ({ "key hole", "hole", "钥匙孔" }));
  set_weight(500);
  set_max_encumbrance(1);
  set("no_get", 1);
  set("no_shown", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一个钥匙孔。\n");
    set("value", 1);
  }
}
int is_container() { return 1; }
