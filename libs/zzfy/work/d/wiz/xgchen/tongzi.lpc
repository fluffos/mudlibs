#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
string ask_me();
void create()
{
        set_name(HIR"运财童子"NOR, ({ "tongzi" }) );
        set("long",
                "他是神仙派下来的运财童子。\n");
         set("str", 45);
        set("cor", 45);
        set("title", HIC"观音座下"NOR);
        set("cps", 45);
        set("agi",45);
        set("int",45);
       set("attitude","friendly");
                 set("inquiry", ([
                "红包" : (: ask_me :),
                "hongbao" : (: ask_me :),
                "liwu" : (: ask_me :),
                "礼物" : (: ask_me :),
        ]) );
set("combat_exp", 100000000);
            set("chat_chance", 2);
            set_skill("unarmed", 1000);
            set("force", 10000);
            set("max_kee", 1000000);
            set("kee", 1000000);
        set("force_factor", 1500);
set("chat_msg", ({
                HIR"运财童子"+NOR+"说道："+WHT+"欢迎大家到来郑州风云。\n"NOR,
        }) );

    setup();
}
string ask_me()
{
	object ob;
        if ( (int)this_player()->query("hongbao_over") == 22 )
		return RANK_D->query_respect(this_player()) + 
		"不是给你红包了吗?想乱占便宜呀！";
        if ( (int)this_player()->query("hongbao_over") == 1 )
		return RANK_D->query_respect(this_player()) + 
		"你不是已经开过红包了吗?想乱占便宜呀！";
        ob = new("/d/wiz/xgchen/hb.lpc");
	ob->move(this_player());
        this_player()->set("hongbao_over",22);
            message_vision("$N获得一个沉甸甸的红包。\n",this_player());

        return "希望你努力成为一代大侠。。。。";

}


