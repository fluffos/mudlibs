// seaside.c
inherit	ROOM;
void create()
{
	set("short", "海边港湾");
	set("long", @LONG
沿海边走了很远，你的眼前出现一个港湾，无边无际的大海就在眼前了。
海风清凉，海面微微泛着波浪。碧蓝的的海水拍打在礁石上面，涌动出洁白
的浪花。极目远眺，极远处有一个黑点，好象是个小岛。
LONG
	);
	set("exits", ([	
  "south" : "/d/tieflag/searoad1",

]));
	set("outdoors",	"moondoor");
	set("coor/x",1000);
	set("coor/y",100);
	set("coor/z",-10);
	setup();

}

void init()
{
   add_action("do_around", "around");
}

int do_around(string arg)
{
   object me, room;

 if(!arg || arg=="")
  {
   write("你要绕过什么？\n");
   return 1;
  }
 if( arg == "礁石" || arg == "stone" ||	arg == "jiaoshi")
  {
   me =	this_player();
   message_vision("$N转到礁石后面！！\n", me);

   room	= find_object(__DIR__"gangwan1");
   if(!objectp(room)) room=load_object(__DIR__"gangwan1");
   me->move(room);
   return 1;
  }
  else
   {
    write("你不可以绕过"+arg+"\n");
    return 1;
   }
}