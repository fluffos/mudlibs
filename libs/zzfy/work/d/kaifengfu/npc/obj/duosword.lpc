#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
        set_name( HIR "夺命剑" NOR, ({ "duosword" }) );
        set_weight(30000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long",
                        
"这是一柄皇帝当年赐与展昭的镶着金龙的宝剑\n"
);
                set("value", 18000);
                set("for_bandit",1);
                set("material", "steel");
                set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
        }

        init_sword(75);
        setup();

}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        dam = (int) me->query("force");
        victim->receive_damage("kee",dam/5);
        return HIG "多命剑发出的呼啸声扰得$n心神不宁。\n" NOR;
}
