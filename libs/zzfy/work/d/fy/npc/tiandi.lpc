#include <ansi.h>
inherit NPC;
void create() {
  set_name("天地无用", ({ "master tiandi", "master", "tiandi" }));
  set("long",
    "风云中最神秘的人，功夫有多高没人知道\n");
  set("nickname", RED "天地阁主" NOR);
  create_family("天地阁", 1, "阁主");
  set("str", 47);
  set("cor", 46);
  set("cps", 45);
  set("agi", 45);
  set("int", 40);
  set("attitude", "friendly");
  set("max_force", 15000);
  set("max_kee", 25000);
  set_temp("kf_tufei", 61);
  set("pursuer", 1);
  set("max_sen", 25000);
  set("max_gin", 25000);
  set("force", 15000);
  set("force_factor", 3);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword.xiangsiwuyong" :),
  }));
  set("combat_exp", 20000000);
  set_temp("apply/damage", 500);
  set_skill("unarmed", 100);
  set_skill("sword", 100);
  set_skill("force", 100);
  set_skill("parry", 120);
  set_skill("dodge", 100);
  set_skill("vivienforce", 170);
  set_skill("move", 80);
  set_skill("literate", 200);
  set_skill("vivien-sword", 200);
  set_skill("vivien-steps", 200);
  set_skill("kongshoudao", 100);
  map_skill("unarmed", "kongshoudao");
  map_skill("dodge", "vivien-steps");
  map_skill("force", "vivienforce");
  map_skill("sword", "vivien-sword");
  setup();

  carry_object(__DIR__ "obj/leafsword")->wield();

}

void attempt_apprentice(object me) {
  if (!me->query("class")) {
    command("xixi");
    command("say 好吧，自己努力吧！\n");
    command("recruit " + me->query("id"));
  } else
    command("say 我不要你这种叛徒！\n");
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "swordsman");

}
void init() {
  add_action("give_quest", "quest");
}
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 4000) {
    student->set("title", "天地阁门徒");
    return;
  } else if (exp <= 10000) {
    student->set("title", "天地阁帮众");
    return;
  } else if (exp <= 18000) {
    student->set("title", "天地阁副香主");
    return;
  } else if (exp <= 30000) {
    student->set("title", "天地阁香主");
    return;
  } else if (exp <= 60000) {
    student->set("title", "天地阁副坛主");
    return;
  } else if (exp <= 120000) {
    student->set("title", "天地阁坛主");
    return;
  } else if (exp <= 300000) {
    student->set("title", "天地阁副旗主");
    return;
  } else if (exp <= 800000) {
    student->set("title", "天地阁旗主");
    return;
  } else if (exp <= 2000000) {
    student->set("title", "天地阁总管");
    return;
  } else if (exp <= 6000000) {
    student->set("title", "天地阁护法");
    return;
  } else if (exp <= 12000000) {
    student->set("title", "天地阁总护法");
    return;
  } else
    student->set("title", "天地阁副阁主");
  return;

}
