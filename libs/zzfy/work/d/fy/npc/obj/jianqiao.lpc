#include <ansi.h>
inherit ITEM;
void create()
{
    set_name("古剑鞘", ({ "jianqiao" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "个");
            set("material", "paper");
            set("long", "一把古剑的剑鞘。\n");
          }

    setup();
}

