// liyuanzhi.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("李沅芷", ({ "li yuanzhi", "li", "yuanzhi"}) );
	set("gender", "女性");
	set("age", 16);
	set("long",
		"她是元霸的夫人，貌胜天仙,元霸就是为了他而闯进伏虎塔的。
        她全身伤痕,象是刚刚被凌辱!\n");
	set("combat_exp", 200000);
        set("shen_type", 1);
        set("max_force", 1000);
        set("force", 1000);
        set("max_kee", 2000);
        set("kee", 1000);
	set("attitude", "peace");
        set("per", 80);
        set("int", 26);
        set("con", 26);
        set("str", 26);
        set("dex", 26);

	set_skill("unarmed", 75);
	set_skill("sword", 75);
	set_skill("parry", 70);
	set_skill("dodge", 70);
	set_skill("force", 70);
	setup();
}
