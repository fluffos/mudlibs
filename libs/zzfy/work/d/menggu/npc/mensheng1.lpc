// data by xgchen

#include <ansi.h>

inherit NPC;

void create() {
  set_name("天子门生", ({ "tianzi mensheng", "mensheng" }));
  set("gender", "男性");
  set("age", 25);
  set("long",
    "这是位青年壮汉，虎背熊腰。\n");
  set("combat_exp", 20000);
  set("shen_type", 1);
  set("attitude", "heroism");

  set("apply/attack", 50);
  set("apply/defense", 50);

  set_skill("sword", 60);
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("dodge", 50);

  setup();

  carry_object("/obj/weapon/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}
void init() {
  object ob;
  if (random(2) == 1)
    message_vision(HIY "天子门生悄悄告诉$N：我们帮主把叛徒元霸扣在伏虎塔上了！\n" NOR,
      this_player());
  else
    message_vision(HIY "天子门生冲着$N说：十几个长老的分层把守，元霸跑不了的！\n" NOR,
      this_player());
}
