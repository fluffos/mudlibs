// chang1.c 常赫志

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("常伯志", ({ "chang bozhi", "chang", "bozhi" }));
  set("title", "天子门长老");
  set("nickname", HIB "白无常" NOR);
  set("long",
    "他身材又高又瘦，脸色蜡黄，眼睛凹进，眼角上有一粒黑痣，眉毛
斜斜的倒垂下来，形相甚是可怖。他是慧侣道人的徒弟。江湖上少有
能敌。黑白无常两兄弟是川江上著名的强盗，心狠手辣，因此得了
这个的外号。\n");
  set("gender", "男性");
  set("class", "fighter");
  set("age", 42);
  set("attitude", "aggressive");
  set("shen_type", 1);
  set("per", 14);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_kee", 2500);
  set("max_sen", 1000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 100);
  set("combat_exp", 2500000);

  set_skill("force", 120);
  set_skill("dodge", 120);
  set_skill("parry", 120);

  setup();
  carry_object("/obj/cloth")->wear();
}
