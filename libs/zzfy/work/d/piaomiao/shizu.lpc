#include <room.h>
inherit ROOM;
void create() {
  set("short", "失足岩");
  set("long", @LONG
一失足成千古恨，此岩甚为狭窄，落脚之处仅是一个浅浅的鞋
印，不知是天然形成的还是后人踩出来的，但是可以肯定一点，在
此不幸丧生的人以有数千，你会不会成为其中的一员呢?
LONG
  );
  set("exits", ([
    "westdown": __DIR__ "duanhun.lpc",
    "northup": __DIR__ "baizhang.lpc",
  ]));

  set("outdoors", "piaomiao");
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);

  setup();
}
