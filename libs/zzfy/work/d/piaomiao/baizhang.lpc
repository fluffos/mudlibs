#include <room.h>
inherit ROOM;
void create() {
  set("short", "百丈涧");
  set("long", @LONG
转过失足岩，就来到了这里. 此地竟然植满苍松翠柏，宽达十
几丈的涧水从山顶流淌下来，仅有一条铁链横跨两岸，在风中微微
的摇摆.
LONG
  );
  set("exits", ([
    "east": __DIR__ "jietian.lpc",
    "southdown": __DIR__ "shizu.lpc",
  ]));

  set("outdoors", "piaomiao");
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);

  setup();
}
