#include <ansi.h>
#include <weapon.h>
inherit RING;
void create() {
  set_name(HIB "逍遥指环" NOR, ({ "free ring" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是逍遥派掌门的信物。\n");
    set("timestamp", "jbaofom");
    set("rigidity", 50);
    set("value", 20000);
    set("material", "stone");
    set("wield_msg", "$N从怀中摸出一个$n戴在右手拇指上。\n");
    set("unwield_msg", "$N将右手拇指上的$n藏入怀中。\n");
  }
  init_ring(90);

  setup();
}
