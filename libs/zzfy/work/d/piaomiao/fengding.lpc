#include <room.h>
inherit ROOM;
void create() {
  set("short", "缥缈峰顶");
  set("long", @LONG
这里便是缥缈峰的顶端，一座巨大的石堡巍然耸立，上书" 灵
鹫宫" 三字，堡门左右各有一头石雕的猛鹫，高达三丈有余，尖喙
巨爪，神骏非凡，堡门半掩，四下无人。
LONG
  );
  set("exits", ([
    "south": __DIR__ "road5.lpc",
    "north": __DIR__ "dadian.lpc",
  ]));

  set("outdoors", "piaomiao");
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);

  setup();
  replace_program(ROOM);
}
