// copy to /d/wsc/hkting.c
inherit ROOM;
void create() {
  set("short", "会客厅");
  set("long", @LONG
这就是名震天下的五色帆船的会客厅了，虽然并不是象很多人想象中那样金壁
辉煌,但是布置的极为雅致、华丽。在大厅中央有一张蟠龙交椅，紫衣侯正坐在那里
很威严地注视着你。在他的背后，有一块近八尺高的屏风，上面是一幅极漂亮的刺
绣。上面绣的俨然正是那五色帆船。
LONG
  );
  set("exits", ([
    "out": "/d/tieflag/seaside",
  ]));
  set("no_magic", 1);
  set("item_desc", ([
    "屏风": "这是一块极漂亮的丝绸刺绣屏风，上面绣着五色帆船。\n",
    "pingfeng": "这是一块极漂亮的丝绸刺绣屏风，上面绣着五色帆船。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/zyhou": 1,
  ]));
  set("coor/x", 1000);
  set("coor/y", -300);
  set("coor/z", 0);
  setup();
}
void init() {
  add_action("do_move", "move");
}
int do_move(string arg) {
  object obj;
  object me;
  if (!arg || arg == "") {
    write("你要移开什么？\n");
    return 1;
  }
  if (arg == "pingfeng" || arg == "屏风") {
    me = this_player();
    message_vision("$N移开屏风，发现了一个暗门。\n", me);
    if (!query("exits/enter")) {
      set("exits/enter", __DIR__ "midao");
      call_out("close_path", 1);
    }
    return 1;
  } else {
    write("你不可以移开" + arg + "\n");
    return 1;
  }
}
void close_path() {
  if (!query("exits/enter")) return;
  message("vision",
    "屏风自动移了回来，又挡住了暗门。\n",
    this_object());
  delete("exits/enter");
}
