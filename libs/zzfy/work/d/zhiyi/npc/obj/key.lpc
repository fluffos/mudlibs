// copy to /d/wsc/npc/obj/key.c
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
void create() {
  set_name(MAG "密室钥匙" NOR, ({ "key" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("turekey", 1);
    set("material", "iron");
    set("long", "这是一把形式很古朴的钥匙．\n");
    set("wield_msg", "$N从怀中拿出一把密室钥匙握在手中。\n");
    set("unequip_msg", "$N将手中的密室钥匙放回怀里。\n");
  }
  init_blade(5);
  setup();
}
