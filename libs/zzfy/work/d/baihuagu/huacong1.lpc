inherit ROOM;

void create() {
  set("short", "花丛深处");
  set("long", @LONG
道边茂密的花丛形成了天然的屏障，再加上地势渐低，
无人可以猜到此路倒底通向何方。走着走着，前面居然出现了一座高山。
LONG
  );
  set("exits", ([
    "east": __DIR__ "huacong",
    "westup": __DIR__ "baihua1",
  ]));
  set("outdoors", "fengyun");

  set("coor/x", 90);
  set("coor/y", 1020);
  set("coor/z", -10);
  setup();
}
