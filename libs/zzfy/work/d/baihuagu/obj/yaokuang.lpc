#include <weapon.h>
inherit HAMMER;
void create()
{
        set_name("采药筐", ({ "yaokuang" }) );
        set_weight(40000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 500);
                set("material", "wood");
                set("long", "一个装满草药的药筐。\n");
                set("weapon_prop/karma",1);
        }
        init_hammer(5);
        setup();
}