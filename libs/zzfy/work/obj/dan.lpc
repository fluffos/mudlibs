inherit F_FOOD;
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(HIW"叛师丹"NOR , ({"dan" }) );
    if( clonep() )
		set_default_object(__FILE__);
	else {
  set("long","一颗阿翔特制的的小豆豆。\n");
		set("unit", "颗");
		set("food_remaining", 1);
		set("food_supply", 0);
                set("value", 100000000); 
               	set("material", "food");
	}
	setup();
}

int finish_eat()
{
    object me;
    	me = this_player();
        me->delete("family");
	me->set("title","普通百姓");
        me->delete("class"); 
        me->set("betrayer", 0);
        me->add("QINGPAN",1); 
        destruct(this_object());
        return 1;
}
