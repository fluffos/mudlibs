#include <ansi.h>
inherit ROOM;

void create()
{       
set("short", HIW "山猫工作室" NOR);
set("long", @LONG
        这里是山猫的工作室。正门桌上的茶盘放着刚砌好的“铁观音”，
飘出阵阵香气。左边桌上放着一台奔腾200电脑正在嗡嗡地工作。书架(shelf)
上全是好看的小说，墙上有一副对联(duilian)。
LONG    );
        set("valid_startroom", 1);
set("no_fight", 1);
set("no_sleep", 1);
set("no_stear", 1);
        set("exits", ([
                "down" : "/u/adx/workroom1",
                "taohua" : "/d/taohua/dating",
                "lingjiu" : "/d/lingjiu/dating",
                "kedian" : "/d/city/kedian",
                "south" : "/d/wizard/exitroom",
                "southeast" : "/d/wizard/wizard_room",
                "southwest" : "/u/jackyboy/damen",
        ]));
        set("item_desc", ([
                "shelf" : HIR "\n这里有各门各派的武功秘籍。\n" NOR,
                "duilian" : HIM "\n还没想好挂什么?\n" NOR,
        ]));
        set("objects",([
                "/d/city/obj/jiudai" : 1,
        ]));
        setup();
}
int valid_leave(object me, string dir)
{
        if( (dir=="south") && !wizardp(me)||(dir=="southeast") && !wizardp(me) )
        if( (dir=="south") && !wizardp(me)||(dir=="southeast") && !wizardp(me) )
                return notify_fail("那里只有巫师才能进去。\n");
        return ::valid_leave(me, dir);
}

