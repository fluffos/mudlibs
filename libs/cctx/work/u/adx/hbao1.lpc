// 红包

inherit ITEM;

void create() {
  set_name("红包", ({ "hong bao", "bao" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long",

      "一个用来装喜银的红包。\n"
      "你可以撕开(sikai)看看装了多少喜银\n" NOR);

    set("value", 0);
  }
}

void init() {
  object ob, me;

  me = this_player();
  ob = present("hong bao", me);
  if (ob)
    add_action("do_shi", "sikai");
}

int do_shi(string arg) {
  object ob, me, obj;
  int i;

  me = this_player();
  ob = present("hong bao", me);
  obj = new("/clone/money/silver");

  if (!id(arg))
    return notify_fail("你要撕开什么？\n");

  if (!present("hong bao", me))
    return notify_fail("你身上没有红包啊？\n");

  i = random(200);
  obj->set_amount(i);
  obj->move(me);
  message_vision(sprintf("$N将$n用力撕开，从里面拿出%s%s喜银\n",
    chinese_number(i),
    obj->query("base_unit")),
    me, ob);
  destruct(ob);
  return 1;
}
