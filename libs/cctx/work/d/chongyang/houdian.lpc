//Room:/d/chongyang/houdian.c
inherit ROOM; 
#include <ansi.h> 
void create() 
{ 
	set("short", "后殿");
	set("long", 
"这里是重阳宫后殿，平日是全真教师祖王重阳与全真七\n"
"子议事的大厅，靠墙角处放着几张太师椅，此殿的宽敞不亚于三清殿，\n"
"正墙上挂着一幅"HIG"画"NOR"(hua)。\n"
	);
	set("item_desc", ([
"hua":YEL"只见画中道人手挺长剑，风姿飒爽，不过三十来岁年纪，肖像之旁题著「活死人」三字。
画像不过寥寥几笔，但画中人英气勃勃，飘逸绝伦。\n"NOR,
"ange":"这是一个很小的暗格,好像里边有什么东西你可以(pick)。\n",
]));
	set("exits",([ /* sizeof()==3 */
  "south":__DIR__"taijie3",
  "north"   :__DIR__"houyuan",
  "west":__DIR__"xiuxishi",
]));
	set("objects", ([
		CLASS_D("chongyang") + "/wangchuyi" : 1
		]));

	setup();
}
void init()
{
	add_action("do_move", "move");
	add_action("do_pick","pick");
}
int do_move(string arg)
{
    object me=this_player();
     if( !arg || arg !="hua" ) 
         return notify_fail("你要移开什么？\n" ) ;
	if(this_player()->query("jing")>220)
      	{
		message_vision("$N小心翼翼的移开了画，发现了一个暗格(ange)。\n", this_player());

		}
	else
		message_vision("$N小心翼翼的移开了画，后边除了一堵墙别的什么也没有。\n", this_player());	
	return 1;	
}
void reset()
{
        ::reset();
        set("get_available" , 1);
}
int do_pick(string arg)
{
       object me,obj;

       me = this_player();
       if( !arg || arg!="ange" )
              return notify_fail("你要拿什么?\n");
       if ( query("get_available") )  
       if(this_player()->query("jing")>220)
       {
       obj = new (__DIR__"obj/sanqingdan");
       obj->move(me);
       add("get_available", -1);
       message_vision(YEL"$N从暗格里拿出一颗"+HIW"三清换质丹。\n"NOR,me );
       }
       else
       return notify_fail(YEL"你在暗格里摸了摸，暗格是空的，里边的东西被人拿走了。\n"NOR);
       return 1;
}
