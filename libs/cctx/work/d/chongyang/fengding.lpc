// Room:/d/chongyang/fengding.c
inherit ROOM; 
#include <ansi.h> 
void create() 
{ 
	set("short", "终南山峰顶");
	set("long", 
"这是终南山的峰顶，站在这里环顾四周发现此山并没有想象中的那么高，\n"
"四周一片白茫茫的景象，四周云雾缭绕简直就是人间仙境，在一面光滑的"HIY"石壁"NOR"\n"
"上可这几行"HIG"字"NOR"（zi），你仔细一看这几个字不是用兵器或是石凿刻上去的，字边\n"
"圆滑整齐分明是有人以深厚的内力和很强的指力所写，石壁盘边坐着一个人好像\n"
"是在研究这石壁上的字。\n"
	);
	set("no_beg",1);
	set("exits",([ /* sizeof()==1 */
  "southdown":__DIR__"shanlu3",
]));
	set("objects", ([
		CLASS_D("chongyang") + "/wangchongyang" : 1]));
		set("outdoors","chongyang");


	setup();
	replace_program(ROOM);
}
