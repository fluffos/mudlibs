//Room:/d/chongyang/changlang2.c
inherit ROOM; 
 
void create() 
{ 
	set("short", "西厢长廊");
	set("long", @LONG
这是一条笔直的长廊，两边花开草绿景色迷人，你不禁想：
“原来重阳宫中也有这般迷人的景色。”
LONG
	);

	set("exits",([ /* sizeof()==2 */
  "south":__DIR__"youpiandian",
  "north"   :__DIR__"ynxiaojing2",
]));
	set("objects", ([
		CLASS_D("chongyang") + "/lizhichang" : 1,
			__DIR__"npc/dizi1":1]));

	set("no_clean_up", 0);

	setup();
	
}
int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam = (mapping)me->query("family");

	if ((!myfam || myfam["family_name"] != "全真教") && dir == "north" &&
		objectp(present("li zhichang", environment(me))))
	   return notify_fail("李志常行了个理说道：后边是本教重地，你不是本教弟子还是回去吧。\n");
		
        return ::valid_leave(me, dir);
}
