#include <room.h>
inherit ROOM;


void create() {
  set("short", "三清殿");
  set("long", @LONG
这里是凌霄宫的三清殿，是全真教会客的地点。供着元始天尊、
太上道君和天上老君的神像，香案上香烟缭绕。靠墙放着几张太师椅，
地上放着几个蒲团。南边是练武的广场，北边是后院。
LONG
  );
  set("valid_startroom", "1");

  set("exits", ([ /* sizeof()==2 */
    "south": __DIR__ "guangchang.lpc",
    "north": __DIR__ "zoulang1.lpc",
  ]));
  set("objects", ([
    CLASS_D("chongyang") + "/yzping": 1 ]));
  set("no_clean_up", 0);
  setup();
  "/clone/board/quanzhen_b"->foo();


}
void init() {
  object me;
  me = this_player();
  me->set("startroom", base_name(environment(me)));
  return;
}
