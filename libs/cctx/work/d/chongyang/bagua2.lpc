inherit ROOM;


#include "/d/chongyang/bagua.h"


void create()
{
	set("short", "八卦阵");
	set("long", @LONG
这里原来是一个八卦阵，四壁墙壁光滑，墙上还挂着长明灯。
其中一面墙壁上刻着一行小篆：“八卦通天地，金刚泣鬼神”。
四周灰尘厚积，蛛网密布，看来已经很久没人来过了。
LONG
	);

	set("exits", ([
		"乾" : __DIR__"bagua7",
		"巽" : __DIR__"bagua6",
		"离" : __DIR__"bagua5",
		"艮" : __DIR__"bagua4",
		"兑" : __DIR__"bagua3",
		"坎" : __DIR__"bagua2",
		"震" : __DIR__"bagua1",
		"坤" : __DIR__"bagua0",
	]));

	setup();
}


int valid_leave(object me, string dir)
{
	if (check_dirs(me, dir))
		return notify_fail("你走错了方位,又回到了密道入口。\n");
	return ::valid_leave(me, dir);
}

