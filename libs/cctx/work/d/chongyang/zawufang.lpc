//Room:/d/chongyang/zawufang.c
inherit ROOM; 
#include <ansi.h>
void create() 
{ 
	set("short", "杂物房");
	set("long", 
"这是一间破旧的小屋子,因为年久失修又没人打理,房\n"
"里乱七八糟的堆放着一些"YEL"杂物"NOR"(zawu).到处是蜘蛛网,好像\n"
"很久没人来过了.\n"
	);
    set("exits", ([
        "west" : __DIR__"youpiandian",
    ]));
    set("item_desc", ([
        "zawu" : "这些东西堆放在这里已经有好久了,看来该整理一下了.\n",
    ]));
        setup();
}

void init()
{
    add_action("do_kan", "zhengli");
}



int do_kan ( string arg )
{
    object ob, weapon;
    string dir;
    if( !arg || arg !="zawu" ) 
         return notify_fail("你要移开什么？\n" ) ;

	    message_vision(
        "$N紧了紧腰带,开始整理杂物。\n", this_player());

        if(this_player()->query("jing")>220)
	{
        set("exits/northeast", __DIR__"midao1");
        message_vision(
        "$N你忙了好久终于把这房间整理好了,突然你发现在靠墙角的地方有一道很不起眼的暗门。\n", this_player());
        this_player()->add("jing",-150);
        remove_call_out("close");
        call_out("close", 20, this_object());
	}
        else	
	{
        message_vision(
        "$N你忙了好久,还是没有把房间整理好。\n", this_player());
	this_player()->set("jing",0);
	}
return 1;
}

void close(object room)
{
    message("vision","暗门啪的一声,关上了。\n", room);
    room->delete("exits/northeast");
}
