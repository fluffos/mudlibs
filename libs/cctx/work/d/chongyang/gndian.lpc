// Room:/d/chongyang/gndian.c
inherit ROOM; 
 
void create() 
{ 
	set("short", "广宁殿");
	set("long", @LONG
这是“广宁子”郝大通的居所，在他身后有一幅字(zi).
往北通往练武场南边通往三清殿，西边是藏经楼。
LONG
	);
	set("item_desc", ([ 
"zi":"广宁坐赵州桥下，儿童戏累石为塔于其顶，嘱以勿坏，头竟不侧，河水溢，不动，亦不伤。\n",
]));
	set("exits",([ /* sizeof()==3 */
  "north":__DIR__"lianwuchang1",
  "south"   :__DIR__"zoulang1",
  "westup":__DIR__"cjlou",
]));
	set("objects", ([
		CLASS_D("chongyang") + "/haodatong" : 1,
		__DIR__"npc/dizi1":1,
		__DIR__"npc/xiangke":1]));

	set("no_clean_up", 0);

	setup();
	
}

int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam = (mapping)me->query("family");

	if ((!myfam || myfam["family_name"] != "全真教") && dir == "north" &&
		objectp(present("hao datong", environment(me))))
	   return notify_fail("郝大通行了个理说道：后边是本教重地，你不是本教弟子还是回去吧。\n");
		
        return ::valid_leave(me, dir);
}
