// Room:/d/chongyang/shanlu2.c
inherit ROOM; 
#include <ansi.h> 
void create() 
{ 
	set("short", "山路");
	set("long", @LONG
这是一条艰险的山路直通主峰，盘边就是深不见底的悬崖，
只要跌下去一定会被摔死。
LONG
	);

	set("exits",([ /* sizeof()==2 */
  "southdown":__DIR__"shanlu1",
  "eastup":__DIR__"shanlu3",
]));
	set("outdoors","chongyang");
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
int valid_leave(object me,string dir)
{
        int i;
        i=me->query_skill("dodge",1)*10;
        if(i<10)
                i=50;
        i=random(i);
        if((i!=0&&i<7)||me->query("test_player")==1)
        {
                message_vision(HIR"$N脚下一不小心，踩了个空，身子一歪就从峭壁上跌了下去。\n"NOR,me);
                me->set_temp("diemsg","不小心从峭壁跌了下去，摔死了");
                me->die();
                return 0;
        }
        return ::valid_leave(me,dir);
}
