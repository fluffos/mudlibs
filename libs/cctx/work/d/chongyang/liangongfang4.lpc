// Room:/d/chongyang/liangongfang4.c

inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", "沙坑");
        set("long", 
"这是一个长三丈，宽两丈的"YEL"沙坑"NOR"(shakeng)，里边是松软的细沙。\n"

        );
        
	set("outdoors", "chongyang");
        set("exits", ([
                
                "southwest" : __DIR__"lianwuchang1",
		"south":__DIR__"liangongfang2",
        ]));
        set("item_desc", ([
    		"shakeng":"这是一个大沙坑，你可以跳(tiao)进去试试。\n",
    	]));

        setup();
}

void init()
{
        add_action("do_tiao", "tiao");
        
}


int do_tiao(string arg)
{
        object me;

        me = this_player();

        if ( !arg || ( arg != "shakeng" ) )
                return notify_fail("小心别人在沙里挖洞，还是别跳了。\n");
                
        me->receive_damage("qi", 20);

        message_vision("$N纵身一跃，跳进了沙坑。\n", me);

        if ( (int)me->query_skill("dodge", 1) < 100)
        {
                me->improve_skill("dodge", me->query("int"));
                write("你跳进了沙坑，觉得对轻身功夫有了些了解。\n");
                return 1;
        }

        write("你再跳也没用了。\n");

        return 1;
}
