// Room: /d/chongyang/damen.c 大门

inherit ROOM;
#include <ansi.h>


void create()
{
    set("short", "大门");
    set("long", 
"你走的小腿发软，终于走到了你要到的地方“重阳宫”，你抬头一看\n"
"正中一道二丈来宽，三丈来高的朱红杉木包铜"HIR"大门"NOR"，上方一块大匾，龙飞\n"
"凤舞地书着"HIY"『重阳宫』"NOR"三个大字。不时有香客进去进香。\n"
    );
    

    set("exits", ([
        "southwest" : __DIR__"qzroad12.lpc",
	"north":__DIR__"yuanping.lpc",    
	]));

    set("outdoors", "chongyang");
    setup();
    replace_program(ROOM);
}
