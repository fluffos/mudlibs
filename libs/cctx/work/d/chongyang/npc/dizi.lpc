// dizi.c 男弟子

inherit NPC;

void create() {
  set_name("弟子", ({ "quanzhen dizi", "dizi" }));
  set("long",
    "他是全真教第五代弟子年纪很小显然刚来不久。\n");
  set("gender", "男性");
  set("age", 16);
  set("attitude", "peaceful");
  set("shen_type", 1);

  set("str", 20);
  set("int", 20);
  set("con", 22);
  set("dex", 25);

  set("max_qi", 300);
  set("max_jing", 200);
  set("neili", 200);
  set("max_neili", 200);

  set("combat_exp", 2000);
  set("score", 1000);

  set_skill("force", 30);
  set_skill("dodge", 20);
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_temp("apply/attack", 15);
  set_temp("apply/defense", 15);
  set_temp("apply/damage", 5);

  create_family("全真教", 5, "弟子");

  setup();

  carry_object("/d/obj/greyrobe")->wear();
}
void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  say("全真弟子说道：这位" + RANK_D->query_respect(ob)
    + "，是来进香的吧。\n");
  return;
}
