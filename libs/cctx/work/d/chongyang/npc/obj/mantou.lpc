// mantou.c 馒头

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("馒头", ({ "mantou", "dumpling" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个白面馒头。\n");
    set("unit", "个");
    set("value", 150);
    set("food_remaining", 6);
    set("food_supply", 50);
  }
}
