// Room :/d/chongyang/cjge2.c
inherit ROOM;
#include <ansi.h>
int do_jump(string);
void create() {
  set("short", "藏经阁三楼");
  set("long",
    "这是全真教的藏经阁里边堆放着学多到家的书籍,整个阁楼打扫的\n"
    "一尘不染,四周摆放着许多书架.有一扇" HIB "窗户" NOR "(window)开着.\n"
  );
  set("exits", ([ /* sizeof()==1 */
    "down": __DIR__ "cjge1",
  ]));

  set("item_desc", ([
    "window": "你从窗口望出去,下边是一条很深的深谷,对面的树林
密密麻麻的排满了地面.在远处你好像看到块很大但是不像天生的石头
好像是一座坟墓.崖边有一条小路.\n",
  ]));
  set("no_fight", 1);
  setup();

}

void init() {
  //    add_action("do_jump","jump");
}

int do_jump(string arg) {
  object me;
  int i_dodge;
  me = this_player();
  i_dodge = (int)me->query_skill("dodge");

  if (!arg || arg == "") return 0;
  if (arg != "window") return 0;
  switch (arg) {
    case "window":
      if (i_dodge < 100) return notify_fail("你的轻功还不足以跳过去！\n");
      else {
        message("vision",
          me->name() + "向小路跃了过去。\n",
          environment(me), ({ me }));
        me->move("/d/gumu/xiaolu4");
        message("vinson", "你纵身一跳，只觉身子轻飘飘的飞了出去！\n" +
          "睁眼一看，已落在古墓小路之上。 \n", me);
      }
      break;
  }
  return 1;
}
