// xmdydan.c 玄门定阳丹
inherit ITEM;
#include <ansi.h>

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "玄门定阳丹" NOR, ({ "xuanmen dan", "dan" }));
  set("unit", "颗");
  set("long", "这是一颗鲜红色的丹药。\n");
  set("value", 20000);
  setup();
}

int do_eat(string arg) {
  int force_limit, neili_limit;

  object me = this_player();

  force_limit = me->query_skill("force") * 10;
  neili_limit = me->query("max_neili");

  if (!id(arg) || (arg != "dan" && arg != "xuanmen dan"))
    return notify_fail("你要吃什么？\n");

  if (neili_limit <= force_limit) {
    me->add("max_neili", random(50));
    me->add("neili", 25 - random(50));
    me->add("max_qi", random(30));
    me->set("eff_jing", me->query("max_jing"));
    me->set("jing", me->query("max_jing"));
    me->set("eff_qi", me->query("max_qi"));
    me->set("qi", me->query("max_qi"));
    me->set("neili", me->query("max_neili"));


    message_vision(HIC "$N吃下一颗" HIR "玄门定阳丹" HIC "，顿然间只觉一股炙热之气游走于全身七经八脉.\n" NOR, this_player());
  } else {
    me->add("max_neili", -random(150));
    message_vision(
      HIC "$N吃下一颗" HIR "玄门定阳丹" HIC "，顿然之间一股热气袭来，你因为服食太快，药效起了副作用.\n" NOR,
      this_player()
    );
    me->unconcious();
  }
  destruct(this_object());
  return 1;
}
