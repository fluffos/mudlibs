inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("清茶", ({ "qing cha", "cha", "tea" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一杯清茶,飘出悠悠清香。\n");
    set("unit", "杯");
    set("value", 20);
    set("max_liquid", 10);
  }
  set("liquid", ([
    "name": "清茶",
    "remaining": 8,
    "type": "water"
  ]));
  set("liquid_type", "water");
  setup();
}
