// stone.c
// By Kayin @ CuteRabbit Studio 1999/3/20 update
#include <ansi.h>

inherit ITEM;

int do_eat(string stone);
int do_yunstone();
void init()
{
        add_action("do_yunstone","yunstone");
        add_action("do_eat","eat");
}

void create()
{
        set_name( YEL"石头"NOR, ({ "shi tou","shi","stone"}));
        set_weight(30000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long","这块石头看似很普通，可是你拿着玩了一下觉得重量好像不大对。\n"
                        +"这块石头似乎包含着什么，你不由想吧他弄碎(yunstone)，可能会有些什\n"
                        +"么新奇的东西出现\n");
                set("value", 0);
                set("material", "stone");
        }
}

int do_yunstone()
{
        object me,stone,new_ob;
        int n;
        me=this_player();
        stone=this_object();

        if (me->query_temp("marks/王1",1))
        {
                if( (int)me->query("max_neili") < 1000 )
                return notify_fail("你的内力不够无法弄碎石头！\n");
        message_vision(HIR "$N盘膝而坐，手托石头，真气游走，开始以内力震碎石头。\n" NOR, me);
        me->add("neili",-500);
        me->set_temp("marks/王1",0);
        switch(random(4) ) {
                case 0:
                        new_ob=new("/d/chongyang/obj/huashidan",1);
                        new_ob->move(me);                       
                        me->set_temp("marks/王2",1);
                        message_vision(HIY "石头渐渐粉碎，终于出现了一颗小小的像水晶一样的石头！！\n" NOR, me );
                        destruct(stone);
                        break;
                default:
                        message_vision(HIY "石头渐渐粉碎，最后只有地上的粉末，别的什么也没有了。\n" NOR, me );
                        destruct(stone);
                }
                return 1;
        }
        else
        message_vision(HIY"你要用内力干什么? \n"NOR,me);
        return 1;
        
}


int do_eat(string stone)
{
        object me;
        int n;
        string stone_name;
        me=this_player();
        stone_name = this_object()->query("id");
        if( !stone || stone!=stone_name )
                return notify_fail("你要吃什么?\n");
        n=random(3);
        switch(n) {
                case 0:
                        message_vision(HIY "$N看来急坏了，拿起石头就啃，结果当场大牙蹦掉了十二颗!这也行？真傻！\n" NOR,me);
                        me->add("food",500);
                        me->add("water",500);
                        break;
                default:
                        message_vision(HIY "$N看来饿坏了，拿起石头就啃，结果当场大牙蹦掉了十二颗!\n" NOR,me);
                }
        destruct(this_object() );
        return 1;
}

