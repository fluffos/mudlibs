// sanqingdan.c 三清换质丹
inherit ITEM;
#include <ansi.h>

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIW "三清换质丹" NOR, ({ "sanqing dan", "dan" }));
  set("unit", "粒");
  set("long", "这是一粒三清换质丹，是全真教的疗伤圣药。\n");
  setup();
}

int do_eat(string arg) {
  if (!id(arg)) return notify_fail("你要吃什么？\n");
  if (arg == "dan") {
    this_player()->set("eff_jing", this_player()->query("max_jing"));
    this_player()->set("jing", this_player()->query("max_jing"));
    this_player()->set("eff_qi", this_player()->query("max_qi"));
    this_player()->set("qi", this_player()->query("max_qi"));
    this_player()->set("neili", this_player()->query("max_neili"));
    message_vision(HIY "$N你吃下一枚" HIW "三清换质丹" HIY "，脸色好看多了.\n" NOR, this_player());
    destruct(this_object());
  }
  return 1;
}
