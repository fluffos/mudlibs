//Room:/d/chongyang/liangongfang3.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "小石林");
  set("long",
    "这是一个小石林，有些奇形怪状的石头，其中有一块像是一个" HIC "石人" NOR "(ren)。\n"
  );
  set("exits", ([
    "southeast": __DIR__ "lianwuchang1",
    "south": __DIR__ "liangongfang1",
  ]));
  set("item_desc", ([
    "ren": HIW "这是一个给全真弟子练剑法用的石头人。\n" NOR,
  ]));
  set("outdoors", "chongyang");

  setup();
}

void init() {
  add_action("do_ci", "ci");
}

int do_ci(string arg) {
  object me, weapon;
  int i_sword, i_qi;
  me = this_player();
  i_sword = (int)me->query_skill("sword", 1);
  i_qi = 600 / (int)me->query("int");
  if (!arg || arg == "") return 0;
  if (arg == "ren") {
    if (!objectp(weapon = me->query_temp("weapon"))
      || (string)weapon->query("skill_type") != "sword")
      return notify_fail("没有剑可以吗？\n");
    if ((int)me->query("qi") < i_qi) return notify_fail("你太累了，先休息一会吧。\n");
    if (i_sword < 50) {
      message("vinson", "你挺剑刺向石人，只听“刷”的一声，剑刃顺着石面滑了开去。\n", me);
      message("vision",
        me->name() + "左手捏一个剑诀，右手握着长剑挺身向石人刺去。\n",
        environment(me), ({ me }));
    }
    if (50 <= i_sword && i_sword < 150) {
      message("vinson", "你挺剑刺向石人，只听“当”的一声，你的剑差点脱手。\n", me);
      message("vision",
        me->name() + "左手捏一个剑诀，右手握着剑挺身向石人刺去。\n",
        environment(me), ({ me }));
    }
    if (150 <= i_sword) {
      message("vision", me->name() + "挺剑刺向大石，只听得“当”的一声，剑尖没入石人尺许！\n",
        environment(me), ({ me }));
      return notify_fail("你挺剑刺向石人，只听得“当”的一声，剑尖没入石人尺许！\n");
    }
    me->improve_skill("sword", 2 * i_sword);
    me->receive_damage("qi", i_qi);
  } else return notify_fail("你要刺什么？\n");
  return 1;
}
