// Room: /d/chongyang/qzroad1.c 

inherit ROOM; 
#include <ansi.h>
 
void create() 
{ 
        set("short", "重阳宫山门");
        set("long", 
"你走在一条坚实的石阶上，不时地有进香客从你的身边走过。\n"
"你忽见松後有一块"YEL"石碑"NOR"(bei),长草遮掩，露出"HIC"「长春」"NOR"二字。\n"

        );
        set("outdoors", "chongyang");
        set("no_clean_up", 0);
        set("item_desc", ([ 
  "bei" : "这是长春子秋处机看到世人多灾多难,十分难过而作的诗:\n"
"          天苍苍兮临下土，胡为不救万灵苦？\n"

"          万灵日夜相凌迟，饮气吞声死无语。\n"

"          仰天大叫天不应，一物细琐枉劳形。\n"

"          安得大千复混沌，免教造物生精灵。\n"

"                       "YEL"小洞"NOR"\n",
              
  "dong":"这是一个很小的洞也不知道是什么动物挖的你可以掏掏(pick)看里边有什么.\n",
  "小洞":"这是一个很小的洞也不知道是什么动物挖的你可以掏掏(pick)看里边有什么.\n",
]));
        
        set("exits", ([ /* sizeof() == 2 */
  "northup" : __DIR__"qzroad2.lpc",
  "eastdown" : "/d/gumu/gmroad5.lpc",
]));

        setup();
        
}
void init()
{
        add_action("do_pick", "pick");
}
void reset()
{
        ::reset();
        set("get_available" , 1);
}
int do_pick(string arg)
{
         object me,obj;
         me=this_player();
        if( !arg || arg!="dong") 
                return notify_fail("你要拿什么?\n");
                
        if(me->query_temp("marks/王",1))
        {
                        if ( query("get_available") )
                        {       
                obj = new (__DIR__"obj/stone");
       obj->move(me);
       add("get_available", -1);
        me->set_temp("marks/王",0);
        me->set_temp("marks/王1",1);
       message_vision(HIW"$N伸手进洞里一阵乱摸,忽然摸到了一块"+YEL"石头。\n"NOR,me );
        return 1;
                        }
                        else
        message_vision(HIW"$N伸手进洞里一阵乱摸,结果什么也没有.\n"NOR,me);
        me->set_temp("marks/王",0);
        return 1;
        }
        else
        message_vision(HIR"$N伸手进洞里一阵乱摸,一不小心碰到了一个凉凉的动物,紧跟着只觉手上一阵剧痛....\n"NOR,me);
        me->apply_condition("snake_poison", 60);
        me->unconcious();
        return 1;
}

