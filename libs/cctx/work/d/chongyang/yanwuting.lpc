inherit ROOM;


void create() {
  set("short", HIY "演武厅" NOR);
  set("long", HIY @LONG
这是全真教的演武厅,全真弟子在一段时间的锻练以后可以在
这里切磋武艺,地上一个八卦图可方便比武之时改变方位.
LONG NOR
  );
  set("exits", ([
    "south": __DIR__ "ynxiaojing5",
    "west": __DIR__ "jingshi",
    "east": __DIR__ "liangongfang5",
  ]));


  setup();
}
