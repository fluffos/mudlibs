#include <ansi.h>
inherit ROOM;

string look_gaoshi();

void create() {
  set("short", "东门");
  set("long", @LONG
这是长安城的东城门，城门正上方写着“东门”两个大字，城墙上贴着几张
通缉告示(gaoshi)。不少被发配到边疆做苦力的罪犯常常经过这里逃回中原，官
兵们戒备森严，动不动就截住行人进行盘问。一条笔直的青石大道向东西两边延
伸。
LONG
  );
  set("outdoors", "changan");

  set("item_desc", ([
    "gaoshi": (: look_gaoshi :),
  ]));

  set("exits", ([
    "east": __DIR__ "eroad1",
    "west": __DIR__ "d-dajie3",

  ]));
  set("objects", ([
    "/d/city/npc/wujiang": 1,
    "/d/city/npc/bing": 2,
  ]));
  setup();
}

string look_gaoshi() {
  return FINGER_D->get_killer() + "\n         长安太守\n          常太平\n";
}
