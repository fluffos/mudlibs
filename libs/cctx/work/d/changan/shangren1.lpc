inherit NPC;

void create()
{
	set_name("珠宝商人", ({ "shang ren","shangren","shang" }));
	set("gender", "男性");
	set("age", 30);
	set("str", 25);
	set("dex", 16);
	set("long", "这是一个珠宝商人，一双灵活的眼睛透出一股子精明，看上去身体强壮，似乎会点功夫。\n");
	set("combat_exp", 30000);
	set("shen_type", 1);
	set("attitude", "friendly");

	set_skill("unarmed", 40);
	set_skill("force", 40);
	set_skill("sword", 40);
	set_skill("dodge", 40);
	set_skill("parry", 40);

	set("neili", 350); 
	set("max_neili", 350);
	set("jiali", 10);

	setup();
	carry_object("/d/clone/jingduan")->wear();
}

