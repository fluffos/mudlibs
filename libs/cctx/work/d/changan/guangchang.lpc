#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "中央广场");
        set("long", @LONG
这里是长安城的中央广场。由于长安交通发达，西到西域，南接成都，
北上京城，东临华山，是一个交通运输的中心，所以你不时可以看见各地
的商人带着商队匆匆走过。这里是城市的正中心，有一个很宽阔的广场，
地面铺满大快的青石。一些游手好闲的人在这里溜溜达达，经常有一些艺
人在这里表演。
LONG
        );
        set("no_sleep_room",1);
        set("outdoors", "changan");


        set("exits", ([
                "east"   : __DIR__"d-dajie1",
           "up" : "/d/biwu/compete",
                "south"  : __DIR__"n-dajie1",
                "west"   : __DIR__"x-dajie1",
                "north"  : __DIR__"b-dajie1",
        ]));

        set("objects", ([
                "/d/npc/baoyu" : 1, 
                "/d/npc/bukuai" : 2, 
       ]));

        setup();
}

void init()
{
        this_player()->delete_temp("biwu");

}

