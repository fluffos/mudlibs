// Room: /d/changan/tufeimo3.c
// Date: inca 98/08/23

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIY"黄土高原" NOR);
        set("long", HIY@LONG
你走在一条黄土路上。这里已经深入黄土高原了，你越走越荒凉举目望去
到处都是一片黄土。听说这里时常有土匪出没，有时走错路还会闯进土匪窝，
你还是赶快离开这里吧。这里已经没有路了，你忽然发现前面有个窑洞(yaodong)
，也许可以进去休息一下。
LONG
NOR        );
        set("outdoors", "changan");

	set("item_desc", ([
		"yaodong" : "    这是一个破旧的窑洞，门口挂着一层厚厚的布帘，看不出里面有什么东西，\n"+
                            "你可以进去(enter)看看。\n",
	]));

        set("exits", ([
		"southeast"   : __DIR__"tufeiwo2",
        ]));


        setup();
}

void init()
{
        add_action("do_enter", "enter");
        UPDATE_D->check_user(this_player());
}

int do_enter(string arg)
{
        object me;
        me = this_player();

        if( !arg || arg=="" ) return 0;

        if( arg=="yaodong" ) 
        {
                message("vision",
                        me->name() + "一弯腰，掀起布帘，往洞里走了进去。\n",
                        environment(me), ({me}) );
                me->move("/d/changan/tufeiwo4");
                message("vision",
                        me->name() + "掀开布帘，走了进来。\n",
                        environment(me), ({me}) );
                return 1;
        }
} 


