{
	set("short","密室");
	set("long",@long
这是一间密室，这里空荡荡的，四周都是坚硬的岩石，只有四个墙角挂着的油灯，
发出一丝亮光，使人感到更加的幽暗。你正准备离开的时候，却感到墙上好象有点不
对劲，但你仔细看了看又说不出有什么问题。

long
	);

	set("exits",([
		"northwest"    : __DIR__"shanghui2",
		]));

       create_door("northwest", "小门", "southeast", DOOR_CLOSED);

		setup();
