// ROOM: /d/changan/xiyuan1.c
// DATA: inca	98/09/02

inherit ROOM;

void create() {
  set("short", "剧院大门");
  set("long", @LONG
这里是全国著名的大剧院，曾经有许多有名的演员都在这里演出过，
大家都以在这里做专场演出为荣耀，所以汇聚了不少优秀的演员，他们都
希望有朝一日能在这里一举成名，因此这里的票价都不算便宜。门口立着
一块不大的木牌(mupai)，上面写着当天的节目和票价。
LONG
  );

  set("no_fight", 1);
  set("valid_startroom", 1);
  set("no_sleep_room", 1);

  set("item_desc", ([
    "mupai": "   失街亭        门票  50两。\n",
  ]));

  set("objects", ([
    __DIR__ "npc/piaofan": 1,
  ]));

  set("exits", ([
    "west": __DIR__ "n-dajie3",
    "east": __DIR__ "xiyuan2",
  ]));

  setup();
}

int valid_leave(object me, string dir) {

  if (!me->query_temp("rent_paid") && dir == "east")
    return notify_fail("票贩一下挡在门前，白眼一翻：怎麽着，不买票？想白看啊！\n");

  return ::valid_leave(me, dir);
}
