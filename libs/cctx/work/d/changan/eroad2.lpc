#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "青石大道");
        set("long", @LONG
你走在一条青石大道上。四周的人不是很多，不时有几个挑担的，经商的匆匆走过。
路的两边种着不少泡桐树。从这里向东到东岳----华山。东边远远的可以看见长安城的
东城门。
LONG
        );
        set("outdoors", "changan");

        set("exits", ([
                "east"    : __DIR__"eroad3",
                "west"    : __DIR__"eroad1",
        ]));

        set("objects", ([
                __DIR__"npc/tiaofu" : 1,
        ]));

        setup();
        replace_program(ROOM);
}

