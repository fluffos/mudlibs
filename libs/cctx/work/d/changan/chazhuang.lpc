inherit ROOM;

void create()
{
	set("short", "同心容茶庄");
	set("long", @LONG
你一走进来，就闻到一股茶香沁入心脾，精神为之一爽。几张八仙桌一字排开，
坐满了客人，或高声谈笑，或交头接耳。你要想打听江湖掌故和谣言，这里是个好
所在。
LONG
	);
	set("resource/water", 1);

	set("exits", ([
		"east"   : __DIR__"b-dajie1",
		"south"  : __DIR__"x-dajie1",
	]));

	set("objects", ([
		__DIR__"npc/chaboshi": 1,
	]));

	setup();
	replace_program(ROOM);
}

