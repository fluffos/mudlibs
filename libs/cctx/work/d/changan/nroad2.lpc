#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "青石大道");
        set("long", @LONG
你走在一条青石大道上。四周的人不是很多，不时有几个由保镖保护的
富商匆匆走过。路的两边种着不少泡桐树。从这里向北就到黄土高原。东边
远远的可以看见长安城的北城门。
LONG
        );
        set("outdoors", "changan");

        set("exits", ([
                "northup" : __DIR__"nroad3",
                "south"   : __DIR__"nroad1",
        ]));

        set("objects", ([
                __DIR__"npc/baobiao" : 2,
                __DIR__"npc/fushang" : 1,
        ]));

        setup();
        replace_program(ROOM);
}

