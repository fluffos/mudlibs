#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "南大街");
        set("long", @LONG
你走在一条青石大道上，这是长安城的南大街，向南北两边延伸出去。四周
人来人往，经商的，骑马的，熙熙攘攘，非常热闹。从这里向北就是长安城的中
央广场，东边是财神钱庄，西边是张记当铺。
LONG
        );
        set("outdoors", "changan");

        set("exits", ([
                "south"  : __DIR__"n-dajie2",
                "north"  : __DIR__"guangchang",
		"east"   : __DIR__"qianzhuang",
		"west"   : __DIR__"dangpu",
        ]));

        setup();
        replace_program(ROOM);
}

