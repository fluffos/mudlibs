#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "青石大道");
  set("long", @LONG
你走在一条青石大道上。四周人来人往，赶路的，经商的，挑担子的，
熙熙攘攘，非常热闹。路的两边种着不少泡桐树。从这里向东就到东岳--
华山。西边是长安城的东城门。
LONG
  );
  set("outdoors", "changan");

  set("exits", ([
    "east": __DIR__ "eroad2",
    "west": __DIR__ "dongmen",
  ]));

  setup();
  replace_program(ROOM);
}
