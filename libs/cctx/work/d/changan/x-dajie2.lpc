#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "西大街");
        set("long", @LONG
你走在长安城的东大街上，这是一条向东西两边延伸出去的青石大道，四周
人来人往，赶路的，经商的，挑担子的，熙熙攘攘，非常热闹。路的两边种着不
少树，北边的书院传来阵阵的读书声，南边的杂货铺却生意清淡。
LONG
        );
        set("outdoors", "changan");

        set("exits", ([
                "east"  : __DIR__"x-dajie1",
		"north" : __DIR__"shuyuan",
                "west"  : __DIR__"x-dajie3",
		"south" : __DIR__"zahuopu",
        ]));

        setup();
        replace_program(ROOM);
}

