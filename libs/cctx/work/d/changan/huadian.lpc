inherit ROOM;

void create() {
  set("short", "花店");
  set("long", @LONG
这是一家花店，地方虽然不大，由于主人整理的井井有条，所以摆了许多花也不觉
得很拥挤。这里摆放着许多盆花，你仿佛在花的海洋中，你闭上眼睛吸了口气，只觉得
心旷神怡，门口的柱子上挂着一块牌子(paizi)。
LONG
  );

  set("item_desc", ([
    "paizi": "出售鲜花，价格从优，多买打折。\n",
  ]));

  set("exits", ([
    "east": __DIR__ "n-dajie3",
  ]));

  set("objects", ([
    __DIR__ "npc/xiaolan": 1,
  ]));

  setup();
}
