#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "青石大道");
  set("long", @LONG
你走在一条青石大道上。四周人来人往，赶路的，经商的，挑担子的，
不时还有几个带着驼队的西域商人匆匆的向东走去。熙熙攘攘，非常热闹。
路的两边种着不少泡桐树。从这里向北就到黄土高原。东边是长安城的北
城门。
LONG
  );
  set("outdoors", "changan");

  set("exits", ([
    "north": __DIR__ "nroad2",
    "south": __DIR__ "beimen",
  ]));

  setup();
}
