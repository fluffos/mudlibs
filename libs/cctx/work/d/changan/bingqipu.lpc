inherit ROOM;

void create() {
  set("short", "兵器铺");
  set("long", @LONG
这是一家兵器铺，这里虽然很大，由于四周摆满了兵器架显得有些拥挤。兵器架上摆满了
钢刀，钢剑，长鞭等兵器，老板孙得胜正忙着向进来的武林豪客介绍着这些做工精良的兵刃，
如果需要你可以来看看有没有趁手的兵器。据说这里偶尔也会有宝刀，宝剑出售。门口挂着
一个招牌(zhaopai)。
LONG
  );

  set("item_desc", ([
    "zhaopai": "用 \"list\" 列出货物清单，\"buy\" 向老板购买。\n",
  ]));

  set("exits", ([
    "north": __DIR__ "x-dajie3",
    "south": "/d/item/jianchang",
  ]));

  set("objects", ([
    __DIR__ "npc/sun": 1,
  ]));

  setup();
  replace_program(ROOM);
}
