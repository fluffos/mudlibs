#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIY"黄土高原"NOR);
        set("long", HIY @LONG
你走在一条黄土路上。这里已经快离开黄土高原了，举目望去到处都是一
片黄土，但路的两边也种了不少的泡桐树。前面在过去就要进入太行山脉了，
这里不时有小贩向过往的行人卖酒水之类的东西，你可以在这里进行补给。
LONG
NOR
        );
        set("outdoors", "changan");

        set("exits", ([
                "northwest"  : __DIR__"nroad6",
            "southdown"   : __DIR__"nroad4",
        ]));

        set("objects", ([
                __DIR__"npc/xiaofan" : 1,
        ]));

        setup();
        replace_program(ROOM);
}

