// npc: /d/changan/npc/laobao.c
// inca  98/09/21

inherit NPC;

void create()
{
        set_name("老鸨", ({ "lao bao", "laobao" }) );
        set("gender", "女性" );
	set("title", "百花院老板娘");
        set("age", 47);
        set("long", 
            "她就是百花院的老板娘，正在招呼着进来的客人们，虽是徐娘半老，但风韵尤存。\n");
        set("str", 25);
        set("dex", 25);
        set("con", 25);
        set("int", 25);
        set("shen_type", 1);

        set_skill("unarmed", 20);
	set_skill("force", 20);
        set_skill("dodge", 35);

        set("combat_exp", 25000);

        set("max_qi", 300);
        set("max_jing", 100);
        set("neili", 500);
        set("max_neili", 500);

        set("attitude", "friendly");
        set("inquiry", ([
            "韦小宝" : "那是扬州丽春院韦春芳的儿子，长得啊。。。。就像你。",
            "百花院" : "我们百花院可是长安城里头一份的找乐子去处。",
            "here"   : "咦？你不知道这儿是哪儿？那你来这儿干什么？没钱给老娘滚出去",
       ]) );

        setup();
        set("chat_chance", 80);
        set("chat_msg", ({
                "老鸨得意地说道：当年老娘我标致得很，每天有好几个客人。\n",
                "老鸨怒骂道：辣块妈妈，要是罗刹鬼、红毛鬼子到百花院来，老娘用大扫帚拍了出去。\n",
                "老鸨对你说道：你一双眼睛贼忒嘻嘻的，真像那个喇嘛！\n",
        }) );
        carry_object("/d/city/obj/flower_shoe")->wear();

        carry_object("/d/city/obj/pink_cloth")->wear();
}
void init()
{
        object ob;

        ::init();
        if (interactive(ob = this_player()) && !is_fighting()) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object me)
{
    command("look " + me->query("id"));

    if (me->query("gender")=="无性") {
       command("say 你当老娘是烂婊子吗？老娘满汉蒙藏回都接，就是不伺候太监！");
       command("kick " + me->query("id"));
       message("vision", me->name() +"被老鸨一脚踢出门外。\n",
                environment(me), ({me}));
       me->move("/d/city/nandajie2");
       message("vision", me->name() +"被人百花院里踢了出来，栽倒在地上，磕掉两颗门牙。\n", 
                environment(me), ({me}));

    }
    else {
    if (me->query("class") =="bonze") {
       command("say 呦，" + RANK_D->query_respect(me) 
                +"也来光顾我们百花院啊。");
       command("say 想当年我接过一个西藏喇嘛，他上床前一定要念经，一面念经，眼珠子就骨溜溜的瞧着我。");
    }
    if (me->query("gender")=="女性") {
       command("say 哎呀，这年月大姑娘也逛窑子，成何体统。");
       command("sigh");
       command("say 可惜我儿子不在，不然让他伺候你。");
    }
    command("say 楼上楼下的姑娘们，客人来了！");
    }
    return ;
}

