// zhangba.c 张老板

#include <ansi.h>

inherit NPC;
//int redeem(string arg);

void create() {
  set_name("张八", ({ "zhang ba", "zhang", "zhangba" }));
  set("title", "当铺老板");
  set("shen_type", 0);

  set("gender", "男性");
  set_max_encumbrance(100000000);
  set("age", 35);
  set("long", "    他就是当铺老板张八，通常人们都叫他八爷，他胖胖的看上去\n"
    "慈眉善目，笑起来眼睛就会眯成一条缝，可有人说这是笑里藏刀，\n"
    "传闻他也是财神的大股东之一。\n");
  set("no_get_from", 1);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_temp("apply/attack", 30);
  set_temp("apply/attack", 30);
  set_temp("apply/damage", 15);

  set("combat_exp", 50000);
  set("attitude", "friendly");

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
