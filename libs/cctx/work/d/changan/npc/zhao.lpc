// zhao.c 赵驼子


inherit F_DEALER;

void create()
{
	set_name("赵驼子", ({ "zhao tuozi", "zhao","zhaotuozi" }));
	set("title", "杂货铺老板");
	set("shen_type", 1);

	set("gender", "男性");
	set("age", 45);
	set("long",
		"    赵驼子并不是土生土长的长安人，他十多年前一个人搬来这里，\n"
		"不久就开了这间杂货铺，做了十几年的小买卖，没有人知道他的来历。\n");
	set_skill("unarmed", 50);
	set_skill("dodge", 50);
	set_temp("apply/damage", 15);

	set("combat_exp", 40000);
	set("attitude", "friendly");
	set("vendor_goods", ({
//		__DIR__"obj/mabudai",
		__DIR__"obj/toukui",
		__DIR__"obj/cycle",
		__DIR__"obj/surcoat",
		__DIR__"obj/huwan",
		__DIR__"obj/zhitao",
		__DIR__"obj/huyao",
		__DIR__"obj/caoxie",
		__DIR__"obj/shoutao",
	}));
	
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
