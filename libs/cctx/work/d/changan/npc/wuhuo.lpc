// WuHuo.c   吴火

inherit NPC;

void create()
{
	set_name("吴火", ({ "wu huo", "wuhuo","wuguanzhu"}));
	set("gender", "男性");
	set("age", 40);
	set("long", 
		"他就是金狮武馆的馆主，他身材很高，国字脸，看上去有一种威武的感觉。\n"
		"他是长安城中有名的拳师，据说他年轻时曾云游天下，遍访名师，终于学成\n"
		"一身功夫，曾经在武林大会上连败多名对手，人送绰号无人敌，成为一代宗师。\n");
	
	set("combat_exp", 15000);
	set("shen_type", 0);
	set("attitude", "friendly");
	
	set_skill("unarmed", 70);
	set_skill("dodge", 70);
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);

	setup();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver", 2);
}
