// sun.c 孙得胜

inherit F_DEALER;

void create() {
  set_name("孙得胜", ({ "sun desheng ", "sun", "sundesheng" }));
  set("title", "兵器铺老板");
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 35);
  set("long",
    "    孙得胜本是一个铁匠，几年前在一次搬家时，在一只破旧的小皮箱中找到了\n"
    "满满一箱的黄金，据说这是以前一个人托孙得胜的父亲保存的，可过了很久也没\n"
    "来取，于是孙得胜就用这些金子开了这间兵器铺，请了个人打造兵器，自己则当\n"
    "起了老板。\n");
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/damage", 15);

  set("combat_exp", 40000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    __DIR__ "obj/gangjian",
    __DIR__ "obj/changjian",
    __DIR__ "obj/gangdao",
    __DIR__ "obj/gangzhang",
    __DIR__ "obj/changbian",
    //		__DIR__"obj/tiejia",
    __DIR__ "obj/beixin",
    __DIR__ "obj/pixue",
    __DIR__ "obj/tiegun",
    __DIR__ "obj/dagger",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
