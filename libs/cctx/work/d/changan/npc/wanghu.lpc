// wanghu.c   王虎
// inca    98/09/26

inherit NPC;

void create()
{
	set_name("王虎", ({ "wang hu", "wanghu","wang"}));
	set("gender", "男性");
	set("age", 45);
	set("long", 
		"他是威武镖局的总镖头----王虎，他身体很结实，看上去有一种威猛的感觉。\n"
		"他年轻时曾云游天下，凭借手中一口钢刀，打败无数刀客，据说他和天下第一\n"
		"刀胡斐打成平手，后来他开的这间镖局又赢的了天下第一镖局的称号。\n");
	
	set("combat_exp", 15000);
	set("shen_type", 0);
	set("attitude", "friendly");
	
	set_skill("unarmed", 70);
	set_skill("dodge", 70);
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);

	setup();
	carry_object("/clone/misc/cloth")->wear();
	carry_object(__DIR__"obj/gangdao")->wear();
}
