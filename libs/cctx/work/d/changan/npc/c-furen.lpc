// c-furen.c 常夫人

inherit NPC;

void create() {
  set_name("常夫人", ({ "chang furen", "furen" }));
  set("age", 32);
  set("gender", "女性");
  set("long", "这就是常夫人，虽然已经年过三十由于保养的很好，看上去仍然很年轻。\n"
    "据说她年青时也练过武功，可看她柔弱的样子又不象身怀武功。\n");
  set("attitude", "friendly");

  set("str", 18);
  set("dex", 12);
  set("combat_exp", 6000);
  set("shen_type", 1);

  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  set_skill("blade", 40);
  set_skill("force", 40);
  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);
  set_temp("apply/damage", 20);
  set_temp("apply/armor", 40);

  setup();
  carry_object("/d/city2/obj/jinduan")->wield();
}
