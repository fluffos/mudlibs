// fujiang.c 副将

inherit NPC;
//inherit F_SKILL;

void create()
{
	set_name("副将", ({ "fu jiang", "fujiang", "jiang" }));
	set("gender", "男性");
	set("age", random(10) + 30);
	set("str", 25);
	set("dex", 16);
	set("long", "他虽然年纪不大，由于久经沙场的，显出一副老练的样子，确有说不出的威风。\n");
	set("combat_exp", 45000);
	set("shen_type", 1);
	set("attitude", "peaceful");

	set_skill("unarmed", 40);
	set_skill("force", 40);
	set_skill("sword", 40);
	set_skill("dodge", 40);
	set_skill("parry", 40);
	set_temp("apply/attack", 35);
	set_temp("apply/defense", 35);
	set_temp("apply/armor", 35);
	set_temp("apply/damage", 20);

	set("neili", 300); 
	set("max_neili", 300);
	set("jiali", 10);

	setup();
	carry_object(__DIR__"obj/gangdao")->wield();
	carry_object(__DIR__"obj/tiejia")->wear();
}
