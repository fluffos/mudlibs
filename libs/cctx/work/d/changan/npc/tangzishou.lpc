// npc:  /d/changan/npc/tangzishou.c
// data: inca  98/08/28

inherit NPC;
//inherit F_SKILL;

void create()
{
	set_name("趟子手", ({ "tangzi shou","tangzishou" }));
	set("gender", "男性");
	set("age", random(10) + 20);
	set("str", 25);
	set("dex", 16);
	set("long", "这是一个身材高大的趟子手，两臂粗壮，虎背熊腰，看上去很有精神。\n");
	set("combat_exp", 10000);
	set("shen_type", 1);
	set("attitude", "heroism");

	set_skill("unarmed", 40);
	set_skill("force", 40);
	set_skill("blade", 40);
	set_skill("dodge", 40);
	set_skill("parry", 40);

	set("neili", 250); 
	set("max_neili", 250);
	set("jiali", 10);

	setup();
	carry_object("/d/city/obj/cloth")->wear();
}


