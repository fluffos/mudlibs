// jiaotou.c 教头

inherit NPC;

void create() {
  set_name("教头", ({ "jiao tou", "jiaotou" }));
  set("gender", "男性");
  set("age", 35);
  set("long", "他是武馆聘的教头,他看上有三十多岁，一脸彪悍之色。\n");

  set("combat_exp", 7000);
  set("shen_type", 0);
  set("attitude", "friendly");

  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);

  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 2);
}
