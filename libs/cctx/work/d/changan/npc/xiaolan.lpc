// xiaolan.c 小兰
// inca  98/09/28

inherit F_DEALER;

void create()
{
	set_name("小兰", ({ "xiao lan", "xiaolan" }));
	set("shen_type", 1);
	set("gender", "女性");
	set("age", 16);
	set("long",
		"    小兰年方二八，正是花一样的年龄，她小的时候就沿街卖花\n"
		"长大后在邻居的帮助下就开了这个花店。\n");
	set_skill("unarmed", 20);
	set_skill("dodge", 20);
	set_temp("apply/damage", 10);

	set("combat_exp", 10000);
	set("attitude", "friendly");

	setup();
	carry_object("/clone/misc/cloth")->wear();
}


