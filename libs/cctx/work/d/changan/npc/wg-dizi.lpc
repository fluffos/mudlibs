// wg-dizi.c 武馆弟子

inherit NPC;

void create()
{
	set_name("武馆弟子",({"wuguan-dizi","dizi"}));
	set("gender", "男性");
	set("age", 20);
	set("long", "他是一个武馆弟子，他看上去很年轻还不到二十岁，但身体强壮，显出了一股年轻人的朝气。\n");
	
	set("combat_exp", 3000);
	set("shen_type", 0);

	set("attitude", "friendly");
	
	set_skill("unarmed", 20);
	set_skill("dodge", 20);
	set_temp("apply/attack", 10);
	set_temp("apply/defense", 10);

	setup();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver",2);
}
