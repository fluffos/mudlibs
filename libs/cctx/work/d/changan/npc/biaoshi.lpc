// npc:  /d/changan/npc/biaoshi.c
// data: inca  98/08/28

inherit NPC;
//inherit F_SKILL;

void create()
{
	set_name("镖师", ({ "biao shi","biaoshi" }));
	set("gender", "男性");
	set("age", random(10) + 30);
	set("str", 25);
	set("dex", 16);
	set("long", "这是一个身材高大的江湖人，两臂粗壮，膀阔腰圆，看起来很不好惹。\n");
	set("combat_exp", 60000);
	set("shen_type", 1);
	set("attitude", "heroism");

	set_skill("unarmed", 80);
	set_skill("force", 80);
	set_skill("blade", 80);
	set_skill("dodge", 80);
	set_skill("parry", 80);

	set("neili", 500); 
	set("max_neili", 500);
	set("jiali", 10);

	setup();
	carry_object("/d/city/obj/gangdao")->wield();
	carry_object("/d/city/obj/cloth")->wear();
}

