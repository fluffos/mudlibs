// piaofan.c    票贩

inherit NPC;

void create() {
  set_name("票贩", ({ "piao fan", "fan" }));
  set("gender", "男性");
  set("age", 25);
  set("long",
    "这个票贩正向过往的行人兜售着手里的几张票。\n");
  set("combat_exp", 100);
  set("attitude", "friendly");
  setup();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(2)) {
    case 0:
      say("票贩笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进去看看吧，都是名角呢。\n");
      break;
    case 1:
      say("票贩说道：这位" + RANK_D->query_respect(ob)
        + "，欢迎来到大剧院，请进请进。\n");
      break;
  }
}

int accept_object(object who, object ob) {

  if (ob->query("money_id") && ob->value() >= 5000) {
    tell_object(who, "票贩点了点头，说道：您赶快进去吧，快开演了。\n");

    who->set_temp("rent_paid", 1);

    return 1;
  }

  return 0;
}
