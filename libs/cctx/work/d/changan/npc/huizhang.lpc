// npc:  /d/changan/npc/huizhangc
// data: inca  98/08/28

inherit NPC;
//inherit F_SKILL;

void create()
{
	set_name("商会会长", ({ "hui zhang","huizhnag" }));
	set("gender", "男性");
	set("age", random(10) + 50);
	set("str", 15);
	set("dex", 10);
	set("long", 
		"他就是长安的商会会长，也是长安城中最有钱的人，据说他的钱\n"
		"可以买下整个长安，所以他自然成了商会会长。\n");
	set("combat_exp", 10000);
	set("shen_type", 1);
	set("attitude", "friendly");

	set_skill("unarmed", 40);
	set_skill("force", 40);
	set_skill("blade", 40);
	set_skill("dodge", 40);
	set_skill("parry", 40);

	set("neili", 250); 
	set("max_neili", 250);
	set("jiali", 10);

	setup();
	carry_object(__DIR__"obj/jinduan")->wear();
}



