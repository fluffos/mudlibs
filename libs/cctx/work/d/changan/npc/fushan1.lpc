// fushan1.c    富商


inherit F_DEALER;

void create() {
  set_name("富商", ({ "fu shang", "shang" }));
  set("shen_type", 1);
  set("str", 30);
  set("gender", "男性");
  set("age", 45);
  set("long",
    "这是一个富商，长的油头大耳，大腹便便，一坐下来就不停的擦着汗。\n");
  set("combat_exp", 500);
  set("attitude", "friendly");

  setup();
  carry_object(__DIR__ "obj/jinduan")->wear();
}
