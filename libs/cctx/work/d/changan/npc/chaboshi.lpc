// chaboshi 兰花

inherit F_DEALER;

void create()
{
	set_name("兰花", ({ "lan hua", "lanhua" }));
	set("title", "茶博士");
	set("nickname", "长安一支花");
	set("shen_type", 1);

	set("str", 25);
	set("gender", "女性");
	set("age", 16);
	set("long",
		"兰花年方二八，由于爷爷年纪大了，才接过了这个祖传的茶馆，\n"
		"兰花是长安城里有名的大美人，老少爷儿们总喜欢往她这儿逛，\n"
		"所以她对城里的一举一动都了如执掌。\n");
	set("combat_exp", 500);
	set("attitude", "friendly");
//	set("inquiry", ([
//		"阿庆" : "我们家阿庆去北边做生意去了耶。\n",
//		"生意" : "这个么……。\n",
//	]));
	
	set("vendor_goods", ({
		__DIR__"obj/peanut",
		__DIR__"obj/dofu",
	}));

	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
	object ob;
	
	::init();
	if (interactive(ob = this_player()) && !is_fighting()) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

void greeting(object ob)
{
	if (!ob || environment(ob) != environment())
		return;
	switch(random(2)) {
	case 0 :
		say("兰花笑眯眯地说道：这位" + RANK_D->query_respect(ob) +
			"，快请进来喝杯热茶。\n");
		break;
	case 1 :
		say("兰花说道：哟！这位" + RANK_D->query_respect(ob) + 
			"您来了啊！本店有刚炸好的五香花生出售。\n");
		break;
	}
}
