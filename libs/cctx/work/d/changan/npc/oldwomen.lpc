inherit NPC;
//inherit F_SKILL;

void create() {
  set_name("裁缝", ({ "old women", "women" }));
  set("gender", "女性");
  set("age", 60);
  set("str", 15);
  set("dex", 10);
  set("long", "这个老妇人就是这里的裁缝，她在这里做衣服已经有好多年了。\n");
  set("combat_exp", 5000);
  set("shen_type", 1);
  set("attitude", "friendly");

  set_skill("unarmed", 20);
  set_skill("force", 20);
  //	set_skill("sword", 20);
  set_skill("dodge", 20);
  set_skill("parry", 20);

  set("neili", 1500);
  set("max_neili", 150);
  set("jiali", 5);

  setup();
  carry_object("/d/city/obj/cloth")->wear();
}
