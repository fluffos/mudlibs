#include <room.h>
inherit ROOM;

void create()
{
	set("short","长安商会");
	set("long",@long
这是一间宽敞的房间，是商会会长的办公室，正中间摆着一张很大的桌子，
房间的右边放着几把椅子，左边有一个很大的书架，书架上摆满了书，其中还
夹杂着几本用一种奇怪的文字写的书(shu)。坐在办公桌后的老者看见你进来后，
慢慢的抬起头打量着你。在老者身后好象有一道小门，不知通向哪里。
long
	);

	set("exits",([
		"north"     : __DIR__"shanghui1",
		"southeast" : __DIR__"shanghui3",
		]));

	set("item_desc", ([
		"shu" : "这是用一种奇怪的文字写的书。\n",
	]));

	set("objects", ([
		__DIR__"npc/huizhang" : 1,
	]));

        create_door("southeast", "小门", "northwest", DOOR_CLOSED);

        setup();
}


