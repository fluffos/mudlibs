#include <ansi.h>
inherit ROOM;

string look_gaoshi();

void create() {
  set("short", "南门");
  set("long", @LONG
这是长安城的东城门，城门正上方写着“南门”两个大字，城墙上贴着几张
通缉告示(gaoshi)。官兵们戒备不是很严，只是偶尔截住看上去象是从西边逃回
来的人进行盘问。一条笔直的青石大道向南北两边延伸。一些西域来的商人都从
这里出城，向南到达成都。北边是城里。
LONG
  );
  set("outdoors", "changan");

  set("item_desc", ([
    "gaoshi": (: look_gaoshi :),
  ]));

  set("exits", ([
    "south": __DIR__ "sroad1",
    "north": __DIR__ "n-dajie3",

  ]));
  set("objects", ([
    "/d/city/npc/wujiang": 1,
    "/d/city/npc/bing": 2,
  ]));
  setup();
}

string look_gaoshi() {
  return FINGER_D->get_killer() + "\n         长安太守\n          常太平\n";
}
