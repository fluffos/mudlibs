inherit ROOM;

void create()
{
	set("short", "镖局大厅");
	set("long", @LONG
这里是威武镖局的大厅。这里正中间铺者一条大红的地毯，尽头摆放着一张供桌，
画像是一个年轻人不知道是谁。两边的桌椅放的整整齐齐，总镖头王虎正和几个镖师
谈论着什么，看见你进来后急忙站起来，向你迎了过来。
LONG
	);



	set("exits", ([
		"north" : __DIR__"biaoju1",
//		"west"  : __DIR__"biaoju3",
	]));

	set("objects", ([
		__DIR__"npc/wanghu": 1,
		__DIR__"npc/biaoshi": 2,
	]));

	setup();
	replace_program(ROOM);
}


