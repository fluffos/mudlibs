#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "黄土高原" NOR);
  set("long", HIY @LONG
你走在一条黄土路上。这里已经深入黄土高原了，举目望去到处都是一片
黄土，很少见到人家。听说这里时常有土匪出没，有时走错路还会闯进土匪窝，
你还是赶快离开这里吧。
LONG
    NOR);
  set("outdoors", "changan");

  set("exits", ([
    "northup": __DIR__ "tufeiwo2",
    "southwest": __DIR__ "nroad4",
  ]));


  setup();
  replace_program(ROOM);
}
