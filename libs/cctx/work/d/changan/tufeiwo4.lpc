#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "土匪窝" NOR);
  set("long", HIY @LONG
这是一个破旧的窑洞，墙角乱扔着许多酒罐，墙边摆着一张木桌，有几个人
正在桌旁喝着酒，。。。。糟啦。。。。你闯进土匪窝了。。。。快逃。。。。
LONG
    NOR);

  //        set("exits", ([
  //                "out"       : __DIR__"tufeiwo3",
  //        ]));

  set("objects", ([
    __DIR__ "npc/tufeitou": 1,
    __DIR__ "npc/tufei2": 3,
  ]));

  setup();

}


void init() {
  add_action("do_out", "out");

}

int do_out(string arg) {
  object me;
  me = this_player();

  if (!arg || arg == "") {
    message("vision",
      me->name() + "一掀布帘，往外退了出去。\n",
      environment(me), ({ me }));
    me->move("/d/changan/tufeiwo3");
    message("vision",
      me->name() + "掀开布帘，从窑洞内退了出来。\n",
      environment(me), ({ me }));
    return 1;
  } else return 0;

}
