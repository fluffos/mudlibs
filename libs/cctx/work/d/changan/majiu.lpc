#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", "马厩");
    set("long",@LONG
你走进一间马厩，这里有许多健壮的马匹，你付了钱后就可以骑马，
可以到任何一座城市。这里人来人往可以看得出来这里生意非常的兴隆。
墙上挂这一块排字（paizi）
LONG);

        set("exits", ([
                "west" : "/d/city/kedian" ,       
        ]));
        set("item_desc", ([
        "paizi" :"买一匹马         1两黄金\n"
                 "骑马  ride \n"
                 "下马  down \n"
        ]));

        set("objects", ([
                "/d/npc/mafu" : 1,
        ]));

        set("no_fight",1);
        set("no_sleep",1);
        setup();
        replace_program(ROOM);
}

