inherit ROOM;

void create()
{
	set("short", "武馆大厅");
	set("long", @LONG
这里是金狮武馆的大厅。这里正中间铺者一条大红的地毯，尽头摆着一长太师椅，
两边整齐的放着几吧椅子，吴馆主通常都是在这里接待来访的朋友或处理一些日常性
的事物，没事的时候他也回来这里看看和教头门聊聊天，或者亲自下示范一下。
LONG
	);



	set("exits", ([
		"north" : __DIR__"wuguan4",
		"south" : __DIR__"wuguan1",
		"west"  : __DIR__"wuguan3",
	]));

	set("objects", ([
		__DIR__"npc/wuhuo": 1,
		__DIR__"npc/jiaotou": 2,
	]));

	setup();
	replace_program(ROOM);
}

