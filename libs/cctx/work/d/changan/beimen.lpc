#include <ansi.h>
inherit ROOM;

string look_gaoshi();

void create()
{
	set("short", "北门");
	set("long", @LONG
这是长安城的北城门，城门正上方写着“北门”两个大字，城墙上贴着几张
通缉告示(gaoshi)。一些罪犯常常从这里向西逃到西域，官兵们戒备森严，动不
动就截住行人进行盘问。一条笔直的青石大道向南北两边延伸。南边是城里。从
这里向东北可以到京城。
LONG
	);
        set("outdoors", "changan");

	set("item_desc", ([
		"gaoshi" : (: look_gaoshi :),
	]));

	set("exits", ([
		"north" : __DIR__"nroad1",
                "south" : __DIR__"b-dajie3",
		
	]));
        set("objects", ([
                "/d/city/npc/wujiang" : 1,
                "/d/city/npc/bing" : 2,
        ]));
	setup();
}

string look_gaoshi()
{
        return FINGER_D->get_killer() + "\n         长安太守\n          常太平\n";
}

