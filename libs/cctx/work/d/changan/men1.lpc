#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "武馆大门");
  set("long", @LONG
这是长安最有名的金狮武馆的大门。大门的两边各有一只威武的石狮，朱红色的
大门大开着，你可以看见里面的连武场上正有许多年轻的后生跟着一个汉子练着拳脚，
看着这龙腾虎跃的场面，你内心不禁涌起了进去练习以下一下的热情。
LONG
  );
  set("outdoors", "changan");

  set("exits", ([
    "south": __DIR__ "x-dajie3",
    "north": __DIR__ "wuguan1",
  ]));

  set("objects", ([
    __DIR__ "npc/wg-dizi": 2,
  ]));

  setup();
}
