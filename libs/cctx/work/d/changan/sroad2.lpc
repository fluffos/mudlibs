#define path /wizhome/incahome/changan
#include <ansi.h>;
inherit ROOM;

void create()
{
	set("short","青石大道");
	set("long",@long
你走在一条青石大道上。四周的人不是很多，不时有几个光着身子的人
匆匆走过。路的两边种着不少泡桐树。南边远远的可以看见一座云雾缭绕的
高山。东边远远的可以看见长安城的南城门。
long
	);

	set("exits",([
		"north" 	: __DIR__"sroad1",
		"southwest" : __DIR__"tudimiao",
		"south"  :__DIR__"wdxiaolu",
	]));

	set("outdoors","changan");

	setup();
	replace_program(ROOM);
}
