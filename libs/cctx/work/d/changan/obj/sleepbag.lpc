// mabudai.c 麻布袋
//sleepbag.c 睡袋
inherit ITEM;

void create()
{
        set_name("睡袋", ({ "sleepbag", "shuidai" }));
        set_weight(500);
        set_max_encumbrance(10000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "一只用布织成的睡袋子，好像可以睡觉。\n");
                set("value", 1000);
        }
        setup();
}
void init(){
add_action("do_sleep","sleep");
}

void do_sleep()
{
}
