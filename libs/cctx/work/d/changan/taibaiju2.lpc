inherit ROOM;


void create()
{
	set("name", "太白居");
	set("short", "太白居二楼");
	set("long", @LONG
这里是雅座，文人学士经常在这里吟诗作画，富商巨贾也在这里边吃喝边作交易。
这里也是城里举办喜宴的最佳场所。你站在楼上眺望，只觉得心旷神怡。东面是东岳
华山，崇山峻岭。而南面则有闻名全国的戏院，不时传来锣鼓声和戏迷的叫好声。墙
上挂着价格牌子(paizi)。
LONG
	);

	set("item_desc", ([
		"paizi" : "本店出售烧鸡及上等女儿红。\n",
	]));



	set("exits", ([
		"down" : __DIR__"taibaiju1",
	]));

	setup();
	replace_program(ROOM);
}
