#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "北大街");
        set("long", @LONG
你走在长安城的北大街上，一条青石大道向南北两边延伸出去，四周人来人往，
赶路的，经商的，挑担子的，熙熙攘攘，非常热闹。路的两边种着不少树，西边的
帅府不时有报告军情的快马进出，看来边疆不是很太平，也许你可以去帮一下忙。
而东边的珠宝店生意兴隆的景象又让你感到天下太平。
LONG
        );
        set("outdoors", "changan");

        set("exits", ([
                "north"  : __DIR__"b-dajie3",
                "south"  : __DIR__"b-dajie1",
		"east"   : __DIR__"fobaoxuan",
		"west"   : __DIR__"shuaifu",
        ]));

        setup();
        replace_program(ROOM);
}