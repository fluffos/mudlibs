inherit ROOM;

void create() {
  set("short", "张记当铺");
  set("no_steal", 1);

  set("long", @LONG
这是一家当铺，门口的招牌上写着一个大大的张字，进门就看见一个老高的柜台
横在屋中间，柜台上立着一块牌子(paizi)。柜台后站着一个朝奉，正眯缝着眼看着
你，旁边的太师椅上躺着一个胖子，他就是当铺老板----张八。
LONG
  );
  set("no_fight", 1);
  set("no_beg", 1);
  set("no_sleep", 1);

  set("item_desc", ([
    "paizi": "公平合理，童叟无欺\n",
  ]));

  set("objects", ([
    __DIR__ "npc/chaofeng": 1,
    __DIR__ "npc/zhangba": 1,
  ]));

  set("exits", ([
    "east": __DIR__ "n-dajie1",
    "north": __DIR__ "x-dajie1",
  ]));

  setup();
  replace_program(ROOM);
}
