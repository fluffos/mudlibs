inherit ROOM;

void create() {
  set("short", "太白居");
  set("long", @LONG
方圆数百里内提起太白居可以说是无人不知，无人不晓。当年李太白到此游玩，
路过这里时，被楼上飘来的酒香吸引，喝完酒后诗性大发，吟出了“”的千古绝句，
从此这里改名为“太白居”，不少人慕名而来，或者瞻仰名人遗迹，或者付诸风雅，
使得这里车水马龙，热闹非凡。楼下布置简易，顾客多是匆匆的行人，买点包子、
鸡腿、米酒就赶路去了。楼上是雅座。
LONG
  );

  set("exits", ([
    "west": __DIR__ "n-dajie1",
    "north": __DIR__ "d-dajie1",
    "up": __DIR__ "zuixianlou2",
  ]));

  set("objects", ([
    __DIR__ "npc/xiaoer2": 1,
  ]));

  setup();
  replace_program(ROOM);
}
