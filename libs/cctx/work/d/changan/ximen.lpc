#include <ansi.h>
inherit ROOM;

string look_gaoshi();

void create() {
  set("short", "西门");
  set("long", @LONG
这是长安城的西城门，城门正上方写着“西门”两个大字，城墙上贴着几张
通缉告示(gaoshi)。许多来边疆做苦力的罪犯常常经过这里逃回中原，官兵们戒
备森严，动不动就截住行人进行盘问。一条笔直的青石大道向东西两边延伸。西
边是郊外，一直向西去就是西北最重要的城市--兰州。东边是城里。
LONG
  );
  set("outdoors", "lanzhou");

  set("item_desc", ([
    "gaoshi": (: look_gaoshi :),
  ]));

  set("exits", ([
    "west": "/d/chengdu/nroad9",
    "east": __DIR__ "x-dajie3",

  ]));
  set("objects", ([
    "/d/city/npc/wujiang": 2,
    "/d/city/npc/bing": 4,
  ]));
  setup();
}

string look_gaoshi() {
  return FINGER_D->get_killer() + "\n         长安太守\n          常太平\n";
}
