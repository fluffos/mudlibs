inherit ROOM;

void create()
{
	set("short", "大剧院");
	set("long", @LONG
这里是全国著名的大剧院，曾经有许多有名的演员都在这里演出过，
大家都以在这里做专场演出为荣耀。台上正在。
LONG
	);

	set("no_fight", 1);
	set("valid_startroom", 1);
        set("no_sleep_room",1);

	set("objects", ([
		__DIR__"npc/xiaofan" : 1,
	]));

	set("exits", ([
		"west"   : __DIR__"xiyuan1",
	]));


	setup();
}


int valid_leave(object me, string dir)
{
	if ( dir == "west" ) me->delete_temp("rent_paid");

	return ::valid_leave(me, dir);
}



