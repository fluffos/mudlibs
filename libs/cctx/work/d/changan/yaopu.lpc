inherit ROOM;

void create() {
  set("short", "回春堂");
  set("long", @LONG
这是回春堂药铺，一股浓浓的药味让你几欲窒息，那是从药柜上的几百个小
抽屉里散发出来的。名医王通治坐在茶几旁，独自喝着茶，只有一名小伙计站在
柜台后招呼着顾客。柜台上贴着一张发黄的广告(guanggao)。
LONG
  );
  set("item_desc", ([
    "guanggao": "本店出售以下药品：
			金创药：\t五十两白银
			其他神药与老板面议。\n",
  ]));


  set("objects", ([
    __DIR__ "npc/doctor": 1,
    __DIR__ "npc/huoji": 1,
  ]));

  set("exits", ([
    "south": __DIR__ "d-dajie2",
  ]));

  setup();
}
