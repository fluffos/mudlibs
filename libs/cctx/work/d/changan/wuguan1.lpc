inherit ROOM;

void create() {
  set("short", "练武场");
  set("long", @LONG
这里是金狮武馆的练武场。这是一个很大的黄土场，场子的两边各立着一根高高
的柱子，柱子上挂着的两面锦旗在风中飘舞着，靠墙的木架上整齐的摆放着刀枪棍棒
和石锁之类的东西，练武场上的后生正努力的练习着，希望有朝一日能象馆主一样成
为天下闻名的拳师。
LONG
  );



  set("exits", ([
    "north": __DIR__ "wuguan2",
    "south": __DIR__ "men1",
  ]));

  set("objects", ([
    __DIR__ "npc/jiaotou": 1,
    __DIR__ "npc/wg-dizi": 4,
  ]));

  setup();
  replace_program(ROOM);
}
