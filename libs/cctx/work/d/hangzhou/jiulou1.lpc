// Room: /d/city/jiulou
// Date:  netkill    98/08/18

inherit ROOM;
int look_zi(string arg);

void create() {
  set("short", "酒楼二楼");
  set("long", @LONG
这里是酒楼的二楼，桌子上积满了灰尘，凳子乱七八糟的摆着，
墙上写满了许多字(zi),地上还有几只毛笔。
LONG
  );

  set("item_desc", ([
    "zi": (: look_zi :),
  ]));
  setup();

}
void init() {

  add_action("look_zi", "look");
  add_action("do_jump", "jump");
}
int look_zi(string arg) {
  if (!arg || arg != "zi") return 0;
  write("墙上写着许多诗句，其中有一句是：\n\n");
  switch (random(11)) {
    case 0:
      write("纤云四卷天无河，清风吹空月舒波。沙平水息声影绝，一杯相属君当歌。\n");
      break;
    case 1:
      write("似泪洒、纨扇题诗。朗月清风，浓烟暗雨，天教憔悴瘦芳姿。\n");
      break;
    case 2:
      write("我来正逢秋雨节，阴气晦昧无清风。\n");
      break;
    case 3:
      write("须信画堂绣阁，皓月清风，忍把光阴轻弃。自古及今，佳人才子，少得当年双美。\n");
      break;
    case 4:
      write("清风不识字，何故乱翻书。\n");
      break;
    case 5:
      write("飘散露华清风紧。动翠幕，晓寒犹嫩，中酒残妆整顿。聚两眉离恨。\n");
      break;
    case 6:
      write("晚来高树清风起。动帘幕、生秋气。画楼昼寂，兰堂夜静，舞艳歌姝，渐任罗绮。\n");
      break;
    case 7:
      write("凉簟碧纱厨，一枕清风昼睡馀。睡听晚衙无一事，徐徐，读尽床头几卷书。\n");
      break;
    case 8:
      write("天地英雄气千秋尚凛然\n");
      break;
    case 9:
      write("文姬赠别双团扇，自写银钩，散尽离愁，携得清风出画楼。\n");
      break;
    case 10:
      write("明月别枝惊鹊，清风半夜鸣蝉。稻花香里说丰年，听取蛙声一片。\n");
      break;
  }
  return 1;
}

int do_jump(string arg) {
  object ob = this_player();
  if (!arg || arg != "down") return 0;
  message("vision", ob->name() + "从窗户跳了出去。\n", environment(ob), ({ ob }));

  message("vision", "你一纵身，从窗户跳了出去。\n", ob);
  ob->move(__DIR__ "yuanzi");
  message("vision", ob->name() + "从楼上跳了下来。\n", environment(ob), ({ ob }));
  return 1;
}
