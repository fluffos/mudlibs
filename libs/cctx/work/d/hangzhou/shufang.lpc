// Room: /d/hangzhou/shufang
// Date:  netkill    98/08/18

#include <ansi.h>
inherit ROOM;

void create()
{
    set("short",   "书房" );
    set("long", @LONG
这是一间雅致的书房，一张书桌，墙上挂着几幅字画，桌子
上摆着笔墨纸砚，一本书打开来放在中间，旁边还放着一个盒子(hezi)。
LONG
    );
	

        set("exits", ([
                "south":__DIR__"zfhouyuan",
        ]));
	set("item_desc", ([
		"hezi" : "一个木盒子，里面放着几支木令牌(ling),你禁不住想偷它一支(tou)。\n",
		]));
	
   
    setup();
	
}

int init()
{
	add_action("do_tou","tou");
}

int do_tou(string arg)
{
	 object ling,me=this_player();
		if (!arg || arg=="") return notify_fail("你想偷什么？");
		if (arg=="ling")
		if ( me->query_temp("zou"))  
		{ling=new("/d/hangzhou/obj/ling");
		 ling->move(me);
		 message("vision","你偷偷的取出一支令牌，揣在怀里，还好，没人发现，快离开这里吧!\n",me);
		 me->delete_temp("zou");
		 return 1;
		}
	       else 
		{
	message_vision(HIR "忽然几个衙役走了进来，对$N喝道:大胆刁民，竟敢闯入知府大院，给我拿下！！\n"+
			   "衙役拿起棍子一阵乱打 ....\n" NOR ,me);
	
	me->unconcious();
	me->move(__DIR__"jianyu");
		}
	return 1;
}
