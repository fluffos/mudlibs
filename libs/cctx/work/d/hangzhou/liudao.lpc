// Room: /d/city/liudao
// Date:  netkill    98/08/18

#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", GRN "柳荫道" NOR);
    set("long", @LONG
一条很舒服的路，地面是青石镶成，两旁柳树成荫，运河的水
在你的身边静静的流淌，知了在树上喳喳的叫，河上停放着几艘大
船(ship)，看样子是有钱人家出来游山玩水的。由于这里经常有一
些官府的人出入，所以不时有官差走动，以防止不测。
LONG
    );
	
        set("exits", ([
                "south"  : __DIR__"gangkou",
		"west" :__DIR__"liudao1",
        ]));

    set("item_desc", ([
         
       "ship" : "一只大画舫，做的十分豪华，精致，几个丫环模样的人在船头\n"
		"指指点点的看风景。\n",  
  ]));
    
    set("outdoors", "city");
    setup();
	
}

int init()
{
	add_action("do_jump","jump");
}

int do_jump(string arg)
{       
	
	object guan,ob=this_player();
	guan=new(__DIR__"npc/guanchai");
	if ((int)ob->query_temp("x1"))
	{
	message_vision(	"官差对$N大声喝道：你竟然敢在这里撒野，看我如何收拾你！\n"+
			HIR"说完忽然从怀里掏出个什么东西在$N眼前一晃！\n"+
			"$N顿时觉得头旋目晕，昏了过去。\n\n"NOR+
			"官差嘿嘿笑了几声，把$N扶起来抗在肩上。\n",ob);
	ob->unconcious();
	ob->move(__DIR__"jianyu");
	ob->delete_temp("x1");
	
	}
	else
	{
	if (!arg || arg !="ship") return 0;
	tell_object(ob,"你正想跳上那艘船...\n"+ HIR"忽然从西边走来了一名官差....\n"NOR+
			"官差一动不动的盯着你\n");
	message("vision","官差走了过来\n",environment(ob), ({ob}));
	
	guan->move(__DIR__"liudao");
	ob->set_temp("x1",1);
	}
	remove_call_out("guan_walk");
	call_out("guan_walk",5,guan,ob);
	call_out("guan_walk1",6,guan,ob);
	return 1;
}

void guan_walk(object ob, object me)
{	message_vision("官差说道：不要在这里乱来，知道吗？\n",ob);
	message_vision("官差往西离开\n",ob);
	
}

void guan_walk1(object ob,object me)
{
	me->delete_temp("x1");
	destruct(ob);
}