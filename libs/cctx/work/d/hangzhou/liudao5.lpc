#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", GRN "柳荫道" NOR);
    set("long", @LONG
一条很舒服的路，地面是青石镶成，两旁柳树成荫，知了在
树上喳喳的叫。树枝随风摇摆，小鸟飞来飞去。西去不远，就到
杭州了。往东，通向运河码头。
LONG
    );
	

        set("exits", ([
                "west"  : __DIR__"liudao6",
		"east" :__DIR__"liudao4",
        ]));

  
    
    set("outdoors", "city");
    setup();
	replace_program(ROOM);
}


