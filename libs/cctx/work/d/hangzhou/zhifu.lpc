// Room: /d/hangzhou/zhifu1
// Date:  netkill    98/08/18



inherit ROOM;

void create() {
  set("short", "知府大门");
  set("long", @LONG
这是杭州知府的大门，左右各有一个牌子，上面写着“肃静”
“回避”，右边还有一面大鼓(gu)，前面的大门紧紧的关着,几
个衙役不怀好意的盯着你看。
LONG
  );

  set("exits", ([
    "south": __DIR__ "beijie",
    "west": __DIR__ "laofang",
  ]));

  set("objects", ([
    "/d/city/npc/yayi": 4,
  ]));
  set("item_desc", ([
    "gu": "一面大鼓，是专门用来给百姓鸣冤的，你如果有何冤情，可以敲一下鼓(qiao)\n",
  ]));

  setup();

}

int init() {
  add_action("do_hit", "qiao");
}



int do_hit(string arg) {
  object me = this_player();
  if (!arg || arg == "") return notify_fail("你要敲什么？\n");
  if (arg == "gu") {
    message_vision("$N用里敲了几下鼓，咚～～咚～～咚～～\n" +
      "只听到里面传来一个声音：是谁击鼓鸣冤，给我带进来\n" +
      "几个衙役把你一架，抬了进去。\n", me);
    me->move(__DIR__ "zhifu1");
  }
  return 1;
}
