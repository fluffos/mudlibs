inherit ROOM;

void create()
{
    set("short",  "牢房" );
    set("long", @LONG
这里是杭州的牢房，四周黑乎乎，的几盏忽明忽暗油灯挂在
墙上，左边有间牢房，里面关着个老者。透过门缝(men)看过去，
那人竟是...
LONG
    );
	

        set("exits", ([
                "north":__DIR__"laofang3",
        ]));

	set("item_desc",([
		"men" : "一道木门，看起来并不怎么牢固，大概震(break)可以震开。\n",
	]));
  	    
       setup();
	
}


int init ()
{  
	add_action("do_break","break");
}

int do_break( string arg )
{
	object  room;
	int str ;
	str =this_player()->query_str();
	if(!arg || arg=="") return 0;
	if (arg=="men")
	{
	if ( str > 20 )
	message_vision("你一运气，力聚双臂，抓住牢门，只听“咯”的一声，门开了\n",this_player());
	else  return notify_fail ("你使出了吃奶的力气，怎么也震不开牢门\n");

	if(!( room = find_object(__DIR__"laofang4")) )
			room = load_object(__DIR__"laofang4");
		room->set("exits/west", __DIR__"laofang5");

		remove_call_out("close_door");
		call_out("close_door", 50, room);
		
		return 1;
	}

	return 0;
}

void close_door(object room)
{
	
	room->delete("exits/west");
}	

