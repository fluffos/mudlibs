#include <room.h>
inherit ROOM;

void create()
{
    set("short",   "知府正厅" );
    set("long", @LONG
这是杭州知府正厅，正中一块匾，上书“心如明镜”，
左右放着各种刑具，看了让你心里一阵哆嗦。侧边有道小门
看来是通向后院的。
LONG
    );
	

        set("exits", ([
                "south" :__DIR__"zhifu",
		"northeast":__DIR__"zfhouyuan",
        ]));
	set("objects", ([
		__DIR__"npc/hang" : 1,
		"/d/city/npc/yayi" : 2,
	]));
	  

     create_door("northeast", "小门", "southwest", DOOR_CLOSED);  
    
    	
    	setup();
	
}


int valid_leave(object me, string dir)
{ if (!me->query_temp("zou")
	&& dir=="northeast"
	&& objectp(present("ya yi", environment(me))))
	return notify_fail("衙役喝道：知府大院是你能乱闯的吗，还不快滚。\n");
	return ::valid_leave(me, dir);
}

