#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", GRN "柳荫道" NOR);
    set("long", @LONG
一条很舒服的路，地面是青石镶成，两旁柳树成荫，前面不
远就是西湖，你隐约都已经可以看见长长的苏堤了。
LONG
    );
	

        set("exits", ([
                "north"  : __DIR__"nliudao",
		"southwest":__DIR__"nliudao2",
        ]));

   
    
    set("outdoors", "hangzhou");
    setup();
	replace_program(ROOM);
}


