// hansi.c

inherit NPC;

void create() {
  set_name("韩四", ({ "han si", "han" }));
  set("gender", "男性");
  set("age", 35);
  set("long", "他就是杭州知府的管家，为人精明无比，识得一些诗书，也好个风庸附雅\n");
  set("combat_exp", 4000);
  set_skill("dodge", 20);
  set_skill("unarmed", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  set("shen_type", -1);
  set("attitude", "friendly");
  setup();
  set("chat_chance", 5);
  set("chat_msg", ({
    "韩四说道：西湖风景美，鱼更美啊。我们家老爷最喜欢吃鱼了。\n",
    "韩四吟道：山外青山楼外楼，西湖歌舞几时休，\n暖风吹的游人醉，只把...只把...这个什么...呵呵。 \n",
    "韩四端起酒杯喝了两口酒\n",
  }));
  add_money("silver", 3);
  carry_object("/clone/misc/cloth")->wear();
}
