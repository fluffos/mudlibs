// xiucai.c

inherit NPC;

void create()
{
	set_name("秀才", ({ "xiu cai", "xiu" }));
	set("gender", "男性");
	set("age", 28);
	set("long","一个的春风得意的书生\n");
	set("combat_exp", 4000);
        set_skill("dodge", 20);
        set_skill("unarmed", 20);
        set_temp("apply/attack",  10);
        set_temp("apply/defense", 10);
	set("shen_type", -1);
	set("attitude", "friendly");
	setup();
	set("chat_chance", 30);
	set("chat_msg", ({
		"秀才吟道：人生得意需尽欢，莫使金樽空对月。\n",
		"秀才唱到：今朝有酒今朝醉，明朝清...风...风...四漂流。\n",
		"秀才走路摇摇摆摆，显然是喝醉了酒。\n",
		(:random_move:),
	}) );
	add_money("silver",3);
	carry_object("/d/city2/obj/jinduan")->wear();
}
	
