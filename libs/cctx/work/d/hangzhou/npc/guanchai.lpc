// wujiang.c 官差
// netkill /98/8/22


#include <ansi.h>
inherit NPC;
//inherit F_SKILL;

void create()
{
	set_name("官差", ({ "guan chai", "chai" }));
	set("gender", "男性");
	set("age", random(10) + 30);
	set("str", 25);
	set("dex", 16);
	set("long", "他站在那里，监视着来往的人，看谁会有什么小动作。\n");
	set("combat_exp", 200000);
	set("shen_type", 1);
	set("attitude", "peaceful");

	set_skill("unarmed", 180);
	set_skill("force", 180);
	set_skill("sword", 180);
	set_skill("dodge", 180);
	set_skill("parry", 180);
	set_temp("apply/attack", 50);
	set_temp("apply/defense", 50);
	set_temp("apply/armor", 50);
	set_temp("apply/damage", 30);

	set("neili", 800); 
	set("max_neili", 800);
	set("jiali", 20);

	setup();
	carry_object("/d/city/obj/gangjian")->wield();
	carry_object("/d/city/obj/tiejia")->wear();
}

int init()
{ add_action("do_kill","kill");
  add_action("do_kill","hit");
  
}

int do_kill(string arg)
{
	object ob=this_player();
  if (!this_object()->id(arg)) return 0;

     command("say 反了，反了，大爷我今天就送你去见阎王吧");
     this_object()->kill_ob(this_player()); 
     remove_call_out("kill_me");
     call_out("kill_me",10,ob);
     return 1;     
        
}
void kill_me(object me)
{
	message_vision(	"忽然官差剑从右手交到左手，一下从怀里掏出一个亮闪闪\n"+
			"的东西，在$N眼前一晃。\n"
			+HIR"$N只觉的眼前一花，顿时漏出了破绽\n"+
			"官差乘机一脚踢了过来，$N把持不稳,落入了江中....\n"NOR,me);
	message("vision",HIR"你在水中扑腾了两下，渐渐的沉了下去....\n"NOR, me);
	me->move("/d/yunhe/jiang");
	me->die();
	
}
	

