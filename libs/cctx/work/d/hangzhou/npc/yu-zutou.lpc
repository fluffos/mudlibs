void close_door(object room);

inherit NPC;

void close_door(object room);

void create() {
  set_name("张有财", ({ "zhang youcai", "zhang" }));
  set("long",
    "他就是牢房的监长。\n");
  set("attitude", "peaceful");
  set("title", "牢房监长");

  set("age", 50);
  set("combat_exp", 40000);
  set("max_jing", 1000);
  set("max_qi", 1000);
  set_skill("dodge", 80);
  set_skill("unarmed", 80);
  set_temp("apply/armor", 60);
  set_temp("apply/damage", 40);
  setup();
}

int accept_object(object who, object ob) {
  object room;
  if ((string)ob->query("name") == "令牌") {
    tell_object(who, "张有财说道：你既然有知府大人令牌，自然要可以进去，可是..不过嘛..这个...\n");
    who->set_temp("ling", 1);

  }

  if (ob->query("money_id") && ob->value() >= 1000 && who->query_temp("ling")) {
    message_vision("张有财嘿嘿奸笑几声，偷偷替$N打开了大门。\n", who);

    if (!(room = find_object("/d/hangzhou/laofang")))
      room = load_object("/d/hangzhou/laofang");

    room->set("exits/westdown", "/d/hangzhou/laofang1");

    remove_call_out("close_door");
    call_out("close_door", 10, room);

    return 1;
  }

  return 0;
}

void close_door(object room) {
  message("vision", "狱卒把大门呀的一声关了起来。\n", room);
  room->delete("exits/westdown");
}
