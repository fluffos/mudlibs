// laobanniang 老板娘 root by netkill

inherit NPC;

int accept_object(object who, object ob);

void create() {
  set_name("老板娘", ({ "laoban niang", "niang" }));
  set("shen_type", 1);

  set("str", 42);
  set("gender", "女性");
  set("age", 25);
  set("long",
    "他就是不归酒家的老板娘，虽然年过四十，却还是半老徐娘，风韵犹存。\n");
  set("combat_exp", 500);
  set("attitude", "friendly");
  set("inquiry", ([
    "西湖醋鱼": "这个醋鱼啊，可不好做，得要上好的大鲤鱼才做得出来。",
    "鱼": "鱼？我们这里的鱼可好吃了，你想吃要什么鱼？。\n
			清蒸，红烧...最好吃的鱼啊，莫过于西湖醋鱼。",
  ]));


  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
int accept_object(object who, object ob) {
  object cyu;

  if ((string)ob->query("name") == "大鲤鱼") {
    command("say 啊，多好的大鲤鱼啊，正是做西湖醋鱼的好原料，客官想吃吗?五十两白银一条。");
    who->set_temp("yu", 1);

  }
  if (ob->query("money_id") && ob->value() >= 5000 && who->query_temp("yu")) {
    command("say 客官稍等，鱼一会就做好。");
    message_vision("老板娘将鱼送进厨房,不一会就捧着一盘美味的西湖醋鱼出来。\n", this_player());
    cyu = new("/d/hangzhou/obj/cuyu");
    cyu->move(who);
    message_vision("老板娘给$N一盘西湖醋鱼。\n", this_player());
    who->delete_temp("yu");
  }


  return 1;
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment())
    return;
  switch (random(2)) {
    case 0:
      say("老板娘热情的说道：客官快请坐，楼上有雅坐。\n");
      break;
    case 1:
      say("老板娘说道：小二，快收拾桌子，来客人了。\n");
      break;
  }
}
