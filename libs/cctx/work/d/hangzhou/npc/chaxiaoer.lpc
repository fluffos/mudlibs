// chaxiaoer.c 茶小二


inherit F_DEALER;

void create()
{
	set_name("福哥", ({ "fu ge", "fu" }));
	set("title", "茶小二");
	
	set("shen_type", 1);

	set("str", 28);
	set("gender", "男性");
	set("age", 42);
	set("long",
		"福哥开茶馆也开了十多年了，据说他的泡茶技术无人能比\n"
		"当年皇帝都喝过他泡的茶\n");
	set("combat_exp", 500);
	set("attitude", "friendly");
	
	set("vendor_goods", ({
		"/d/hangzhou/obj/tieguanyin",
		}));
	
	
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

int init()
{ object ob;
	
	::init();
	if (interactive(ob = this_player()) && !is_fighting()) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	 add_action("do_list", "list");
        add_action("do_buy", "buy");
}

void greeting(object ob)
{
	if (!ob || environment(ob) != environment())
		return;
	switch(random(2)) {
	case 0 :
		say("福哥笑眯眯地说道：这位" + RANK_D->query_respect(ob) +
			"，快请进来喝杯热茶。\n");
		break;
	case 1 :
		say("福哥说道：这位客官，是不是喝一壶虎跑泉泡的上好铁观音。\n");
		break;
	}
}
