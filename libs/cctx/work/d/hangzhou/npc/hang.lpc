// hang.c 韩观

inherit NPC;
//inherit F_SKILL;

void create()
{
	set_name("韩观", ({ "han guan", "han" }));
	set("title", "杭州知府");
	set("gender", "男性");
	set("age", 43);
	set("str", 20);
	set("dex", 20);
	set("long", "他就是韩观， 杭州现任知府。\n");
	set("combat_exp", 30000);
	set("shen_type", 0);
	set("attitude", "heroism");

	set_skill("unarmed", 50);
	set_skill("force", 50);
	set_skill("sword", 50);
	set_skill("dodge", 50);
	set_skill("parry", 50);
	set_temp("apply/attack", 50);
	set_temp("apply/defense", 50);
	set_temp("apply/armor", 50);
	set_temp("apply/damage", 15);

	set("neili", 500); 
	set("max_neili", 500);
	set("jiali", 10);
	set("inquiry", ([
                
                   "鱼" :   ("鱼！真是好吃啊，若能吃上一尾太湖的大鲤鱼就好了"),

        ]) );

	setup();
	set("chat_chance", 3);
	set("chat_msg", ({
		"韩观说道：杭州真是个好地方啊，在此做官，逍遥自在。\n",
		"韩观说道：太湖的鱼真是美味啊，另人回味不已。\n",
		"韩观说道：学问之道，在于勤奋，为官之道，在于厚黑，呵呵。 \n",
		"韩观说道：为官者，清廉最为重要，须得紧记在心。\n",
	}) );
	carry_object("/d/city2/obj/jinduan")->wear();
}


int accept_object(object me, object ob)
{ 	
	if ( (string)ob->query("name") == "大鲤鱼")
		{command( "say 你那里来的如此好鱼，如果烧成一尾醋鱼的话，就太美味了...");
		command ("say 本官为官清廉，你拿回去自用吧。");
		return 0;}
	if ( ob->query("money_id") )
		{command("say 你竟然敢贿赂本官，小心我将你打入大牢，念你是初犯，东西收公，你走吧。");
		return 1;}
	if ( (string)ob->query("name") == "西湖醋鱼")
		{ command( "say 哇，多么美味的鱼啊！");
		  write("韩观你拿起西湖醋鱼咬了几口。\n");
		  write("韩观将剩下的西湖醋鱼吃得干干净净。\n");
		  command("taste");
		  command( "say 你是个良民，本官赏你在知府大院里四处游玩一天吧，想必你还没见过世面吧！");
		  command( "heihei");
		  me->set_temp("zou",1);
		  return 1;
		
		}
	return 0;
}