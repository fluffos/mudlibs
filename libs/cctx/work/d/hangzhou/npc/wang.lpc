// wang.c 杂货铺老板


inherit F_DEALER;

void create()
{
	set_name("王永寿", ({ "wang yongfu", "wang" }) );
	set("gender", "男性" );
	set("age", 32);
	set("long",
		"这个杂货铺的老板整天笑咪咪的招呼着客人。\n");
	set("combat_exp", 100);
	set("attitude", "friendly");
	set("rank_info/respect", "老板");
	set("vendor_goods", ({
		__DIR__"obj/yugang",
		"/d/city/obj/caoxie",
		
	}));
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}