inherit NPC;

void close_door(object room);

void create() {
  set_name("狱卒", ({ "yu zu", "zu" }));
  set("long",
    "这是一个杭州守牢房的狱卒。\n");
  set("attitude", "peaceful");

  set("age", 30);
  set("combat_exp", 20000);
  set("max_jing", 500);
  set("max_qi", 500);
  set_skill("dodge", 40);
  set_skill("unarmed", 40);
  set_temp("apply/armor", 30);
  set_temp("apply/damage", 20);
  setup();
}
