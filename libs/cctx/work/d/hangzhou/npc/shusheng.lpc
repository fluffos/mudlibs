// hansi.c

inherit NPC;

void create() {
  set_name("书生", ({ "shu sheng", "sheng" }));
  set("gender", "男性");
  set("age", 28);
  set("long", "一个的寞落的书生\n");
  set("combat_exp", 4000);
  set_skill("dodge", 20);
  set_skill("unarmed", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  set("shen_type", -1);
  set("attitude", "friendly");
  setup();
  set("chat_chance", 5);
  set("chat_msg", ({
    "书生吟道：劝君莫惜金缕衣，劝君惜取少年时。花开堪折直须折，莫待无花空折枝！\n",
    "书生叹了口气道：人生几何啊！\n",
  }));
  add_money("silver", 3);
  carry_object("/clone/misc/cloth")->wear();
}
