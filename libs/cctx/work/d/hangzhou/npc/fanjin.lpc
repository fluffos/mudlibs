// fanjin.c 范锦


inherit F_DEALER;

void create() {
  set_name("范锦", ({ "fan jin", "fan" }));
  set("title", "书店老板");

  set("shen_type", 1);

  set("str", 30);
  set("gender", "男性");
  set("age", 52);
  set("long",
    "他就是书店的老板，当年科考屡次落板后，灰心冷意，就开了个书店\n"
    "不过听说他有一套考试的心得，别人用了一考就中，他自己却考不上\n");
  set("combat_exp", 500);
  set("attitude", "friendly");


  setup();
  carry_object("/clone/misc/cloth")->wear();
}
