// wangpin.c 王品


inherit F_DEALER;

void create()
{
	set_name("王品", ({ "wang pin", "wang" }));
	set("title", "药铺老板");
	
	set("shen_type", 1);

	set("str", 30);
	set("gender", "男性");
	set("age", 42);
	
	set_skill("unarmed", 80);
	set_skill("dodge", 80);
	set_skill("parry", 80);
	set_temp("apply/attack", 80);
	set_temp("apply/defense", 80);
	set_temp("apply/damage", 20);
	set("long",
		"他就是药铺老板，由于头脑灵活，会做生意，把个小药铺搞的红红火火的。\n");
	set("combat_exp", 50000);
	set("attitude", "friendly");
	set("vendor_goods", ({
		"/d/city/obj/jinchuang",
		"/d/city/obj/yangjing"
	}));
	
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
