#include <ansi.h>
inherit ROOM;

void create() {
  set("short", GRN "湖边小路" NOR);
  set("long", @LONG
这是一条西湖边的小路，西边不远可以看见一家大酒楼，长长的
幌子从树林中升了出来，上面写着大大的一个“酒”字，你似乎都闻
到了阵阵的酒香。
LONG
  );


  set("exits", ([
    "west": __DIR__ "jiujia",
    "east": __DIR__ "nliudao2",
  ]));



  set("outdoors", "hangzhou");
  setup();
  replace_program(ROOM);
}
