// Date:  netkill    98/08/18


#include <ansi.h>
inherit ROOM;

void create() {
  set("short", GRN "小亭" NOR);
  set("long", @LONG
这是太湖边上的一个小亭子，几个人正在钓鱼，真所谓是
偷得浮生半日闲，好不逍遥。
LONG
  );


  set("exits", ([
    "west": __DIR__ "troad5",
  ]));



  set("outdoors", "hangzhou");
  setup();
}

int init() {
  add_action("do_fishing", "fighing");
  add_action("do_fishing", "diao");

}

int do_fishing(string arg)

{
  object me = this_player();

  if (!arg || arg == "") return 0;
  if (arg == "yu" || arg == "fish")
    if (!present("gan", me)) return notify_fail("空手捉鱼吗？\n");
  if ((int)me->query_temp("a")) return notify_fail("你不是正在钓着吗？\n");
  if ((int)me->query("jing") < 20) return notify_fail("你太累了，别钓了吧。\n");
  message_vision("$N把鱼竿一甩，坐在亭子边上掉起鱼来。\n", me);
  me->set_temp("a", 1);
  remove_call_out("diao");
  call_out("diao", 3, me);
  return 1;
}


void diao(object me) {
  object yu;
  int n = random(100);
  if (!n) {
    yu = new(__DIR__ "obj/daliyu");
    yu->move(me);
    message_vision("哇！$N钓到了一条大鲤鱼，看来运气不错。\n", me);
  } else if (n > 50 && n < 60) {
    yu = new(__DIR__ "obj/yu");
    yu->move(me);
    message_vision("$N钓到了一条小鱼，有收获。\n", me);
  } else message_vision("$N钓了半天，结果什么也没掉到。\n", me);
  me->add("jing", -5);
  me->delete_temp("a");

}
