#include <room.h>
inherit ROOM;

void create() {
  set("short", "后花园");
  set("long", @LONG
这是杭州知府的后花园，园子里种着一些竹子，兰花，几
块石头搭成个假山，点缀的十分素雅。
LONG
  );


  set("exits", ([
    "southwest": __DIR__ "zhifu1",
    "north": __DIR__ "shufang",
  ]));


  create_door("southwest", "小门", "northeast", DOOR_CLOSED);

  set("outdoors", "hangzhou");
  setup();
}
