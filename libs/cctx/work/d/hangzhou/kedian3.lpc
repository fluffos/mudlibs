// Room: /city/kedian3.c
// YZC 1995/12/04 

inherit ROOM;

void create() {
  set("short", "客店二楼");
  set("long", @LONG
这是一间很大的客房，陈设十分简陋。靠墙放了十几张小木床，
不少客人正和衣而卧，满屋子都是呼呼的打酣声。西边有一道窗户
(window)透进微弱的光线。
LONG
  );


  set("sleep_room", "1");
  set("no_fight", "1");
  set("hotel", 1);

  set("exits", ([
    "out": __DIR__ "kedian2",
  ]));
  set("item_desc", ([
    "window": "一扇小窗户，微微的透进些光亮，透过窗户可以看见对面酒楼。\n",
  ]));


  setup();
}
int init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object ob = this_player();
  if (!arg || arg != "window") return 0;
  message("vision", ob->name() + "从窗户跳了出去。\n", environment(ob), ({ ob }));

  message("vision", "你一纵身，从窗户跳了出去。\n只听见店小二在后面骂道：是那个该死又在乱跳我的窗户。\n", ob);
  ob->move(__DIR__ "yuanzi");
  message("vision", ob->name() + "从楼上跳了下来。\n", environment(ob), ({ ob }));
  return 1;
}
