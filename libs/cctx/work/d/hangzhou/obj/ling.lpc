inherit ITEM;

void create() {
  set_name("令牌", ({ "ling pai", "ling" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", "这是一支知府用于发布命令的令牌。\n");

    set("material", "iron");
  }
  setup();
}

void init() {
  call_out("dest", 1800);
}

void dest() {
  destruct(this_object());
}
