// cuyu.c 西湖醋鱼
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("西湖醋鱼", ({ "cuyu", "yu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一尾美味之极的西湖醋鱼。\n");
    set("unit", "尾");
    set("food_remaining", 2);
    set("food_supply", 100);
  }
}
