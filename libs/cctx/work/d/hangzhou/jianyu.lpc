// Date: YZC 96/02/06

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "监狱");
	set("long", @LONG
这里黑沉沉的，即无一丝光亮，也无半分声息。四壁摸上去冰
凉，且极硬，似乎都是钢铁铸成，南面有一扇小铁窗(window)，可
以看到隔壁牢房的情况，倾耳仔细的听，可以听到起他牢房里的哀
叹声，吵打声，你不由心头一冷，不知道要关到什么时候。
LONG
	);

	set("valid_startroom",1);
	set("item_desc",([
	"window":"一扇小铁窗，穿过窗子看过去，只见那边关着个老者，虽然在狱中，却还在读书!\n",
		]));
	setup();

}

void init()
{       
	object ob = this_player();

		
		message("vision",
			HIY "只听牢房铁门匡地一响，一个昏昏沉沉的家伙被扔了进来！\n\n" NOR, 
			environment(ob), ob);

		tell_object(ob, "狱卒嘿嘿地笑着：今儿个你可落在我手里了...！\n");

		ob->set("startroom", "/d/hangzhou/jianyu");
		remove_call_out("randoms");	
		call_out("randoms",20,ob);
		call_out("do_go",60,ob);
		
}

void do_go(object ob)
{	
	message("vision",HIY"只听得牢门哐咣直响，一个狱卒把门打开，对你说道：你可以走了!\n"+
			"你只觉得昏昏沉沉的被丢了出去！\n"NOR,ob);
	ob->move(__DIR__"beijie");
	ob->set("startroom","/d/hangzhou/kedian");
	
}



void randoms( object me)
{ switch (random(2))
	{case 0:   
 	message_vision("隔壁传来一阵读书声：大学之道，在明明德。在亲民，在止于至善。 \n",me);
	break;
	case 1 :
	message_vision("隔壁传来一阵读书声：格物致知，诚意正心，修身齐家，治国平天下。\n",me);
	break;
	}
}

 