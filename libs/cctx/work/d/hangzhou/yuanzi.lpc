// Room: /city/kedian3.c
// YZC 1995/12/04 

inherit ROOM;

void create()
{
	set("short", "客店后院");
	set("long", @LONG
这里是客店的后院，种着一些很普通的花草，几个房客正在
这里闲聊。
LONG
	);

	
	
	set("exits", ([
		"east" : __DIR__"kedian",
	]));	
	
	
	setup();
	
}

int init()
{	add_action("do_jump","jump");
}

int do_jump( string arg)
{
	object ob=this_player();
	if (!arg || arg!="up") return 0;
	message("vision","你一纵身，跳到了酒楼二楼\n",ob);
	ob->move(__DIR__"jiulou1");
	message("vision",ob->name()+"跳了上来\n",environment(ob), ({ob}) );
	return 1;
}