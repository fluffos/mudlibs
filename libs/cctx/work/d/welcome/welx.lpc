inherit ROOM;

void create() {
  set("short", "欢迎光临驰骋天下");
  set("long", @LONG
这里是最后的大门，踏出这里就走向江湖了。请你记得多保存你的
资料(save),如果累了想离开请(quit),不懂的地方可以看(help),祝你
玩的愉快。
LONG
  );


  set("exits", ([
    "1": "/d/city/kedian",
    "2": "/d/changan/kedian",
    "3": "/d/city2/kedian1",
    "4": "/d/jyguan/kedian",
    "5": "/d/kunming/kedian",
    "6": "/d/chengdu/yanbin",
  ]));
  set("objects", ([
    __DIR__ "npc/jieyinshi2": 1,
  ]));

  set("no_fight", 1);
  setup();
}


int valid_leave(object me, string dir) {
  if (dir == "1") {
    me->set("phlye", 1);
    me->set("startroom", "/d/city/kedian");
  }
  if (dir == "2") {
    me->set("phlye", 2);
    me->set("startroom", "/d/changan/kedian");
  }
  if (dir == "3") {
    me->set("phlye", 3);
    me->set("startroom", "/d/city2/kedian");
  }
  if (dir == "4") {
    me->set("phlye", 4);
    me->set("startroom", "/d/jiayguan/kedian");
  }
  if (dir == "5") {
    me->set("phlye", 5);
    me->set("startroom", "/d/kunming/kedian");
  }
  if (dir == "6") {
    me->set("phlye", 6);
    me->set("startroom", "/d/chengdu/yanbin");
  }
  return ::valid_leave(me, dir);

}
