inherit ROOM; 
#include <ansi.h>  
void create() 
{ 
	set("short", HIB"大房间"NOR);
	set("long", @LONG
这是一个很大的房间,里边有整整九九八十一
只麻雀(maque)正在飞来飞去.
LONG
	);

	set("exits",([ 
  "southwest":__DIR__"guodao8",
]));
	set("item_desc", ([
	"maque":"一只可爱的小麻雀飞来飞去,你很想捉(zhuo)住它。\n",
	]));
	

	setup();
}
void init()
{
        add_action("do_zhuo", "zhuo");
        add_action("do_zhuo","捉");
}

int do_zhuo( string arg)
{       
        object me;
        int i_tldw, i_qi;
        me=this_player();
        i_tldw=(int)me->query_skill("tianluo-diwang",1);
        i_qi=600/(int)me->query("int");
        if (!arg || arg=="") return 0;
        if (arg == "maque")
                { 
              if( (int)me->query("qi") < i_qi)
               return notify_fail("你太累了，先休息一会吧。\n");
                if (i_tldw < 100)
                	{
                		message("vinson","你能捉的住这八十一只麻雀吗？.\n",me);
			}
                if (i_tldw >100) 
                        {message("vinson","你飞身而起,扑向麻雀。\n",me);
                         message("vision",
                         me->name() + "飞身扑向麻雀。\n",
                         environment(me), ({me}) );}
                me->improve_skill("tianluo-diwang", 16*i_tldw);
                me->receive_damage("qi", i_qi );
                }
        else return notify_fail("你要捉什么？\n");
        return 1;       
}

