inherit ROOM; 
#include <ansi.h>  
void create() 
{ 
	set("short", BLK"石室"NOR);
	set("long", 
"这是一间不大的石室,墙上挂着两幅画,正面是一幅女子的"HIG"画像"NOR"(hua1),想必这便是\n"
"古墓派的师祖婆婆"HIY"“林朝英”"NOR"女侠了，而后边的哪一幅则是全真教的开山始祖，"HIY"王重阳"NOR"\n"
"的"HIG"画像"NOR"(hua2)。\n"
	);

	set("exits",([ 
  "east":__DIR__"guodao1",
]));
	set("item_desc", ([ 
	"hua1":"这是林朝英年轻时的画像，画中之人虽不妖艳动人但是朴素典雅，另有一番美雅, 。\n",
	"hua2":"这是林朝英女侠当年为王重阳所画的肖像，和全真教里挂的哪一幅一模一样。\n",
	]));
	
	setup();

}
void init()
{
        add_action("do_ke", "ke");
	add_action("do_tu","tu");
}
int do_ke(string arg)
{
	object ob;
        ob=this_player();
	if (!arg || arg=="")return notify_fail("你要对谁磕头？\n");
	if(arg=="hua1")
	     if(ob->query_temp("marks/拜师",1))
	     	{
	     	ob->set_temp("marks/拜师",0);
	     	ob->set_temp("gumu/磕头",1);
	     		return notify_fail(HIC+ob->query("name")+"对着林朝英的画像恭恭敬敬的磕下了第一个头.\n"NOR);
	       return 1;
	       }
	        else if(ob->query_temp("gumu/磕头",1))
	              {
	     	     ob->set_temp("gumu/磕头",0);
	     	     ob->set_temp("gumu/磕头1",1);
	               	return notify_fail(HIC+ob->query("name")+"对着林朝英的画像恭恭敬敬的磕下了第二个头.\n"NOR);
	     	     return 1;
	     	}
	     	else if(ob->query_temp("gumu/磕头1",1))
	               	{
	             ob->set_temp("gumu/磕头1",0);  		
	     	     ob->set_temp("gumu/磕头2",1);
	               	return notify_fail(HIC+ob->query("name")+"对着林朝英的画像恭恭敬敬的磕下了第三个头.\n"
	               	"好了现在对着王重阳的画吐(tu)唾沫.\n"NOR);
	     	     return 1;
	     	}
	     	else
	     	{
	     		return notify_fail(HIC+ob->query("name")+"对着师祖婆婆的画像恭恭敬敬的磕了个头。\n"NOR);
	     		return 1;
	     	}
	
}
int do_tu(string arg)
{
	object ob;
        ob=this_player();
	if (!arg || arg=="")
	     return notify_fail("你要对谁吐唾沫？\n");
	if(arg=="hua2")
	       	if(ob->query_temp("gumu/磕头2",1))
	       	{
	     	ob->set_temp("gumu/磕头2",0);
	     	ob->set_temp("gumu/吐1",1);
	     	     	return notify_fail(HIC+ob->query("name")+"鼓足气“噗~~啪”一口唾沫飞上了王重阳的画像.\n去找孙婆婆吧.\n"NOR);
	       return 1;
	       }
	        else return notify_fail(HIC"没事别乱吐，真是的。\n"NOR);
	     		return 1;
	
}
	     		