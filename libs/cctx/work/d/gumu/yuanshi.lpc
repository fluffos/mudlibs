inherit ROOM;
#include <ansi.h> 
int do_study(string arg);

void create()
{
	set("short", HIC"圆室"NOR);
	set("long", @LONG
这是一间圆形的石室,地上画着一些乱七八糟的脚印(jiaoyin).
LONG
	);
	set("exits",([
	"northeast":__DIR__"guodao10-1",
	]));
	set("item_desc", ([
		"jiaoyin" : "这是古墓派的纤云步法。\n",
	]));

	setup();
}

void init()
{
	add_action("do_study", "zou");
	add_action("do_study","ta");
	add_action("do_study","lianxi");
	add_action("do_study","zuanyan");
}


int do_study(string arg)
{
	mapping myfam;
	object me;
	
	me = this_player();

	if ( !arg || ( arg != "jiaoyin" ) )
		return notify_fail("什么？\n");
		
	if( me->query("gender") == "男性" )
		return notify_fail("你不是古墓派的弟子.\n");
		
        myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] != "古墓派")
        	return notify_fail("你不是古墓派的弟子，不能学习这套步法.\n");


	if ( (int)me->query_skill("literate", 1) < 1)
		return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
		
	if ((int)me->query_skill("dodge",1)<=(int)me->query_skill("xianyun-bufa",1))
		return notify_fail("你的基本轻功太差了,练好基本轻功再来吧.\n");

	if ( (int)me->query_skill("xianyun-bufa",1)< 10)
		return notify_fail("你连纤云步法的要旨都不知道,你练什么呀.\n");	

	if ( (int)me->query_dex()< 25)
		return notify_fail("你的身法太差了,不能练习纤云步法.\n");
				
	if ((int)me->query_skill("tianluo-diwang",1)<100)
		return notify_fail("你的天罗地网势太差了，不能学习纤云步法。\n");
        if ((int)me->query("max_neili")< 100)
        	return notify_fail("你的内功修为太差，不能练习纤云步法。\n");
        	
	if((int)me->query("qi") < 11)
		return notify_fail("你现在精神无法集中！\n");

	message_vision(HIY"$N专心练习"HIC"纤云步法。\n"NOR, me);

	if ( (int)me->query_skill("xianyun-bufa", 1) < 200)
		{
			me->improve_skill("xianyun-bufa", me->query_int());			
			write("你按照地上的脚印走了一遍,似乎对纤云步法有所领悟。\n");
			me->add("qi",-10);
			me->set_temp("stone_learned",1);
		}

	if ( !me->query_temp("stone_learned") )
	{
		write("你研究了一会儿脚印，发现上边所说的东西对你来说太浅了。\n");
	}
	return 1;
}

