#include <ansi.h> 
inherit ROOM; 
int do_enter(string arg);
int do_open(string arg);
void create() 
{ 
	set("short",BLK "墓室"NOR);
	set("long", @LONG
这是一间存放棺材(guangcai)的房间，靠墙的地方放着五口石棺，有几口已经封好了，
别的棺材还开着，好像还没有人。这个房间非常昏暗，一点儿光线都没有。
LONG
	);

	set("exits",([ 
  "north":__DIR__"guodao4",
]));
        set("item_desc", ([
	"guangcai":"这是一口很普通的石棺.\n",
	]));
	
	set("no_clean_up", 0);

	setup();

}
void init()
{
        add_action("do_enter","enter");
        add_action("do_open","open");
}

int do_enter(string arg)
{
        object me;
        me = this_player();

        if( !arg || arg=="" ) return 0;
        if( arg=="guangcai" ) 
        {
        	if(me->query_temp("gumu/棺1",1))
        	{
        		write("你腑身钻入棺材里,顺手盖上了棺盖。\n");
             me->move(__DIR__"guangcai");
             me->set_temp("gumu/钻1", 1);
             me->set_temp("gumu/棺1",0);
             return 1;
       		}
       		else
       		{
       		write("你是白痴呀,哪棺材盖的紧紧的你想穿过去呀!!!??\n");
       		return 1;
       		}
       	
       	}
       	else
       	{
       		write("你想往哪钻？!\n");
       		return 1;
       	}
       	
}

int do_open(string arg)
{
	object me;
	me=this_player();
	if( !arg || arg=="" ) return 0;

        if( arg=="guangcai" ) 
        {
        	if(me->query_temp("gumu/九阴",1))
        	{
        		message_vision("$N使劲挪开了棺盖.\n",me);
			me->delete_temp("gumu/九阴",1);
        		me ->set_temp("gumu/棺1",1);
        		return 1;
        	}
        	else
        	{
        		message_vision("石棺的笋头接的太牢,$N怎么也挪不开,只好悻悻的放弃了.\n",me);
        		return 1;
        	}
        }
        else
        {
        	write("你要打开什么?\n");
        	return 1;
        }
}
