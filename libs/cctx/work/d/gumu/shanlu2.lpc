inherit ROOM;

void create() {
  set("short", "小山路");
  set("long", @LONG
这是一条崎岖的小山路，两旁古树参天，怪石林立。
LONG
  );

  set("exits", ([
    "southwest": __DIR__ "shanlu1",
    "north": __DIR__ "shanlu3",
    "east": __DIR__ "shulin1",
  ]));
  set("outdoors", "gumu");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
