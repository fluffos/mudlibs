#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIB "古墓密林" NOR);
  set("long",
    "这是一片树的海洋。四周一望无际，全是参天的古树。周围静悄悄的。\n" +
    "远处偶尔传来几声鸟叫。\n"
  );
  set("exits", ([
    "east": __DIR__ "milin" + (random(3) + 1),
    "northeast": __DIR__ "milin" + (random(3) + 1),
    "northwest": __DIR__ "milin" + (random(3) + 1),
    "southwest": __DIR__ "milin" + (random(3) + 1),
    "southeast": __DIR__ "milin" + (random(3) + 1),
    "west": __DIR__ "milin3",
    "south": __DIR__ "milin" + (random(3) + 1),
    "north": __DIR__ "milin" + (random(3) + 1),
  ]));
  set("objects", ([
    __DIR__ "npc/yufeng": 1,
    __DIR__ "npc/yetu": 1 ]));


  set("outdoors", "gumu");

  setup();
}
void init() {
  object ob;
  mapping myfam;
  ob = this_player();
  if (query("exits/south"))
    myfam = (mapping)ob->query("family");
  if (myfam && myfam["family_name"] == "古墓派")
    if (ob->query("class") == !"taoist") {
      delete("exits/south");
      set("exits/south", __DIR__ "milin_in");
      return;
    }
  delete("exits/south");
  set("exits/south", __DIR__ "milin" + (random(3) + 1));
}
