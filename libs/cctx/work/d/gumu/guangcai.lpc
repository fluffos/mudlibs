#include <ansi.h> 
inherit ROOM; 
int do_use(string arg); 
int do_mo(string arg);
int do_pass(string arg);
void create() 
{ 
	set("short",BLK "棺材内"NOR);
	set("long", @LONG
你缩身在棺材里,左右不能动.
LONG
	);
	set("exits",([
	"out":__DIR__"mushi",
	]));
	set("objects",([
		__DIR__"obj/fire":1,
		]));
	
	set("no_clean_up", 0);

	setup();

}
void init()
{
        add_action("do_pass","pass");
        add_action("do_pass","an");
        add_action("do_pass","bo");
        add_action("do_mo","mo");
        add_action("do_mo","zhao");
        add_action("do_use", "use");
}
int do_use(string arg)
{
        object me;
        me = this_player();
        if( !arg || arg=="" ) 
        	return 0;
        if (!present("fire", me)) 
        	return 0;
        if( arg=="fire" ) {
             write(
             "你点燃了火折，发现棺材内壁上刻着几个字(zi)。\n"
             );
             set("item_desc", ([ 
	"zi":"棺木之下有一密室.\n",
	]));
	me->set_temp("gumu/棺2",1);
	return 1;
       }
       else write("你要用什么?\n");
       return 1;
       
}
int do_mo(string arg)
{
	object me;
	me=this_player();
	if( !arg || arg=="")
	{		
	if(me->query_temp("gumu/棺2",1))
	{
		write("你到处摸索,发现了一个机关的按钮(niu).\n");
		set("long","你缩身在棺材里,左右不能动.在你的右手边有一个按钮(niu).\n");
		set("item_desc",([
		"niu":"这是一个很小的按钮,不注意还以为是一颗小石头.\n",
		]));
		me->set_temp("gumu/棺2",0);
		me->set_temp("gumu/棺3",1);
		return 1;
	}
	else write("你乱摸什么?\n");
	return 1;
	}
	else write("你乱摸什么?\n");
	return 1;
}
int do_pass(string arg)
{
	object me;
	me=this_player();
	if( !arg || arg=="") return 0;
	if(arg=="niu")
	{
		if(me->query_temp("gumu/棺3",1))
		{
		write("你按下机关按钮,只听“喀拉”一声，石棺下打开了一条通道，你一不留神，掉了下去.\n");
		set("long","你缩身在棺材里,左右不能动.\n");
		me->delete_temp("gumu/棺3");
		me->move(__DIR__"mishi");
		return 1;
		}
		else write("你乱按什么呀？\n");
		return 1;
	}
	else write("你乱按什么呀？\n");
		return 1;
	
	
}
