inherit ROOM; 
#include <ansi.h> 
void create() 
{ 
	set("short", BLK"暗道"NOR);
	set("long", @LONG
这是一条狭长的暗道,里边一点儿灯火也没有.
南边是哪道暗门(men).
LONG
	);
	set("exits",([
	"north":__DIR__"chongyang2",
	]));

	set("no_clean_up", 0);

	setup();

}
void init()
{
        add_action("do_open","open");
        add_action("do_open","打开");
}
int do_open(string arg)
{
	object room;
	object ob=this_player();
	if(!arg||arg!="men")
		return notify_fail("你要打开什么?\n");
	if(ob->query_temp("gumu/重阳5",1))
		{
			message_vision("$N使出吃奶的力气把暗门打开。\n", ob);
			set("exits/south",__DIR__"guodao5");
			if( room = find_object(__DIR__"guodao5") ) {
		        room->set("exits/north", __FILE__);}
			ob->delete_temp("gumu/重阳5");
			return 1;
		}
	else{
		message_vision("$N使出吃奶的力气,可是暗门纹丝不动,只好悻悻的放弃了.\n",ob);
		return 1;
	}
}
int valid_leave(object me, string dir)
{
	object room;
        if(dir=="south")
        {
        	message_vision("$N一闪身出了暗道,紧接着暗门合上了。\n",me);
		delete("exits/south");
		if( room = find_object(__DIR__"guodao5") ) {
	        room->delete("exits/north");}

		return 1;
	}
		return ::valid_leave(me, dir);
}
	
