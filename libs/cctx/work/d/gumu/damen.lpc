#include <ansi.h> 
inherit ROOM; 
void create() 
{ 
	set("short", "大门");
	set("long",
"这是古墓的大门，门头上写着四个大字"HIW"“活死人墓”"NOR"。门口站着一位老婆婆。\n"
"面色慈祥的看着你.\n"
	);
	set("valid_startroom","1");
	set("exits",([ 
  "south":__DIR__"milin_out",
  "west":__DIR__"gumu_in",
]));
	set("objects", ([
		CLASS_D("gumu") + "/sunpopo" : 1,
]));

	set("outdoors","gumu");

	setup();
	"/clone/board/gumu_b"->foo();
	
}
void init()
{
   object me;
    me=this_player();
me->set("startroom",base_name(environment(me)));
    return;
}


