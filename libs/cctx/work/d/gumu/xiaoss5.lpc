inherit ROOM;

void create() {
  set("short", YEL "休息室" NOR);
  set("long", @LONG
这是一间很小的石屋。屋里陈设简陋，一张石头床，一张
石桌子，几个石椅子，别的什么都没了，石桌上点着一只蜡烛，微微
烛光让你昏昏欲睡。
LONG);
  set("exits", ([
    "southeast": __DIR__ "guodao10-1",
  ]));

