#include <weapon.h>
inherit SWORD;

void create() {
  set_name("生锈的长剑", ({ "changjian", "jian" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄很普通的剑，因为摆放年久再加上古墓比较潮湿，这柄剑已经是锈迹斑斑。\n");
    set("value", 100);
    set("material", "steel");
  }
  setup();
}
