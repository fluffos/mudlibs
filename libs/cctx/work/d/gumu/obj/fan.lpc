inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("米饭", ({ "fan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "香喷喷的米饭。\n");
    set("unit", "碗");
    set("value", 50);
    set("food_remaining", 10);
    set("food_supply", 100);
  }
}
