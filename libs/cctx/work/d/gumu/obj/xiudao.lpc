#include <weapon.h>
inherit BLADE;

void create()
{
	set_name("生锈的钢刀", ({ "gangdao", "dao" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄很普通的钢刀，因为摆放年久再加上古墓比较潮湿，这柄刀已经是锈迹斑斑。\n");
		set("value", 100);
		set("material", "steel");
	}
	setup();
}