#include <ansi.h>

inherit ITEM;
int serve_fan(object);
int is_container() { return 1;}

void create()
{
        set_name(HIB"锅"NOR, ({ "guo" }) );
        set_weight(3000);
        set_max_encumbrance(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "这是一口铁锅,看上去很干净,你可以用它来做(zuo)饭。\n");
                set("value", 1000);
                set("no_get",1);
                set("no_drop",1);
                set("amount",10);
        }
        setup();
}
int serve_fan(object who)
{
	object ob1;
        object me,ob,obj;
        me = this_player();
	ob = this_object();

        if( !who || environment(who) != environment() ) 
                return 0;

        if( !me->query_temp("gumu/饭2",1))
                return notify_fail("你得先烧水(yao shui)。\n");

                if( objectp(ob1=present("dami",ob))) 
                {
                        message_vision("$N揭开锅盖,一锅米饭做好了。\n",me);
 //                       destruct(ob1);
//                        me->delete_temp("gumu/饭2");
                        obj = new(__DIR__"obj/fan");
                        obj->move(ob);
                        return 1;
                }
else
                        return notify_fail("你连米都没放进去,你煮空气呀！\n");
}
