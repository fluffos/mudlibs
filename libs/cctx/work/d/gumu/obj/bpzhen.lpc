// bpzhen.c 冰魄银针
// By Kayin @ CuteRabbit Studio 1999.3.25 new
#include <ansi.h>
inherit ITEM;
void init() {
  add_action("do_yong", "yong");
}

void create() {
  set_name(HIW "冰魄银针" NOR, ({ "bingpo yinzhen", "yinzhen" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("value", 1000);
    set("material", "gold");
    set("long", "这是一枚用精钢铸成的细如发丝的金针.\n");
  }
  setup();
}
int do_yong(string arg) {
  object me, target, obn;
  mapping myfam;
  me = this_player();
  myfam = (mapping)me->query("family");
  if (!arg)
    return notify_fail("你要用冰魄银针做什么？\n");

  if (!me->is_fighting())
    return notify_fail("冰魄银针只能对战斗中的对手使用。\n");

  if ((!myfam || myfam["family_name"] != "古墓派"))
    return notify_fail("不怕这冰魄银针上的剧毒吗?\n");

  if (me->query("class") == !"taoist")
    return notify_fail("你不是是李莫愁的弟子,不能用冰魄银针。\n");

  if ((int)me->query_skill("throwing", 1) <= 0)
    return notify_fail("你会用暗器吗？！\n");

  if (!objectp(target = present(arg, environment(me))))
    return notify_fail("这里没有这个人。\n");
  if (target == me)
    return notify_fail("你想自杀？ :p\n");

  message_vision(HIY "\n$N摸出一枚" HIW "冰魄银针" HIY "扣在手中，寻找时机,一枚银白的细针射向$n,\n" NOR, me, target);
  me->start_busy(2);
  if (random((int)me->query_skill("throwing") * 2) < (int)target->query_skill("dodge") / 2) {
    message_vision(HIB "\n但$n" HIB "经验丰富,不及细看侧身闪避,有惊无险的躲过了这极厉害的" HIW "冰魄银针！\n" NOR, me, target);
  } else {

    message_vision(
      HIB "\n只听银针破空飞出,$n" HIB "不及闪避" HIW "冰魄银针" HIB "尽数打到$n" HIB "的身上.\n" NOR,
      me,
      target
    );
    target->apply_condition("bingpo_poison", (int)target->query_condition("bingpo_poison") + 20);
    obn = new("/d/gumu/obj/bpjieyao", 1);
    obn->move(me);
  }
  destruct(this_object());

  return 1;
}
