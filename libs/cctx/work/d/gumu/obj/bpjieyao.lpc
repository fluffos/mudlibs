// bpjieyao.c  冰魄银针解药
// By Kayin @ CuteRabbit Studio 1999.3.25 new
#include <ansi.h>

inherit ITEM;

void create()
{
   set_name(HIR"红色药丸"NOR, ({"yao wan", "wan","yao"}));
   if (clonep())
      set_default_object(__FILE__);
   else {
      set("unit", "粒");
      set("value", 1000);
   }
   setup();
}

int init()
{
   add_action("do_eat", "eat");
}

int do_eat(string arg)
{
   if(!id(arg))
       return notify_fail("你要吃什么？\n");

   message_vision("$N吃下一粒" + name() + "。\n", this_player());
   if ((int)this_player()->query_condition("bingpo_poison") > 0) {
    if ((int)this_player()->query_condition("bingpo_poison") < 11) {
      this_player()->apply_condition("bingpo_poison", 0);
      message_vision(HIC"$N身上的毒气尽退，脸色看上去好多了。\n"NOR, this_player()); }
   else {
   this_player()->apply_condition("bingpo_poison", (int)this_player()->query_condition("bingpo_poison") -10);
      message_vision(HIM"$N的脸色渐渐红润起来。\n"NOR, this_player());
   }
  }
    else
    { tell_object(this_player(), HIB"你觉得这药丸好像不对。\n" NOR );
    this_player()->apply_condition("bingpo_poison", 40);
}
   destruct(this_object());
   return 1;
}
