// fengxiang.c 蜂箱
// By Kayin @ CuteRabbit Studio 1999/3/23 new

#include <ansi.h>
inherit ITEM;
void init() {
  add_action("do_control", "control");
  add_action("do_control", "zhe");
}

void create() {
  set_name(HIR "蜂箱" NOR, ({ "feng xiang", "xiang" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 0);
    set("jian", 30);
    set("material", "steel");
    set("long", "这是一只很普通的蜂箱,里边有好多蜜蜂.\n");

  }
  setup();
}
int do_control(string arg) {
  object me, obj;
  int myexp, objexp;
  int mylev, objlev;
  int steps;
  me = this_player();
  if (!arg)
    return notify_fail("你想让蜜蜂蜇谁?？\n");

  if (this_object()->query("jian") <= 0)
    return notify_fail("蜂箱里已经没有蜜蜂了。\n");
  if (!present("yufeng jiang", me))
    return notify_fail("你没有玉峰浆了,不能驱使蜜蜂.\n");

  if (!objectp(obj = present(arg, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!obj->is_character() || obj->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");

  if (obj == me)
    return notify_fail("你想自杀？ :p\n");
  myexp = me->query("combat_exp");
  objexp = obj->query("combat_exp");
  mylev = me->query_skill("yufeng-shu");
  objlev = obj->query_skill("yufeng-shu");

  if (mylev <= 0)
    return notify_fail("你不会御蜂术，小心蜇到自己！\n");

  myexp = 50 * objexp / myexp;
  if (myexp < 50) myexp = 50;

  if ((int)me->query("jing") < myexp)
    return notify_fail("你的精力不够了！\n");

  this_object()->add("jian", -1);
  steps = (mylev - objlev) / 10;
  if (steps < 2) steps = 2;
  if (steps > 8) steps = 8;
  message_vision(HIY "\n$N拿起蜂箱,驱使蜂箱中的玉峰扑向$n\n\n" NOR, me, obj);
  me->start_busy(2);
  if (userp(obj)) {
    obj->fight_ob(me);
    me->fight_ob(obj);
  } else {
    obj->kill_ob(me);
    me->fight_ob(obj);
  }
  if (random(mylev) < objlev / 2)
    message_vision("\n但$n很快就驱散了蜜蜂！\n", me, obj);
  else {
    tell_object(obj, HIR "\n你只觉一片黑压压的东西向你扑来,你只能包头鼠窜.\n" NOR);
    obj->receive_damage("jing", steps * 10);
    obj->receive_damage("qi", steps * 50);
    obj->apply_condition("feng_poison", (int)obj->query_condition("feng_poison") + 20);
    obj->start_busy(steps);
    remove_call_out("out_zhen");
    call_out("out_zhen", steps + 2, obj);

  }
  me->receive_damage("jing", myexp);
  return 1;
}
void out_zhen(object ob) {
  message_vision("$N费尽九牛二虎之力,终于驱散了蜜蜂！\n", ob);
}
