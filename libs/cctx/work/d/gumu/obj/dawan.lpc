inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("大碗", ({ "da wan", "wan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是一个粗瓷大碗，虽然已经放了好久，不过还没有坏。!\n");
    set("unit", "只");
    set("value", 20);
    set("max_liquid", 10);
  }
  setup();
}
