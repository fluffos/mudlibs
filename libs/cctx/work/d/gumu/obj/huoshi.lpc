//JackyBoy 修改 98.11.5 @ CCTX 风云再起 Studio 增加exits显示和玩家显示

#include <room.h>
#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create()
{
        set_name("火石", ({ "huo shi", "shi" ,"huoshi"}) );
        if( clonep() )
                set_default_object(__FILE__);
        else 
        {
                set("long", "这是江湖人士常用的火石，可以用它来照明(use huoshi)哟!\n");
                set("unit", "些");
                set("base_unit", "个");
                set("value",100);
                set("base_weight", 1);
                set("base_value", 1);
                set("damage", 1);       //Here the damage=int_throwing, added by King
        }
        set_amount(30);
        init_throwing(1);
        setup();
}

void init()
{
        seteuid(geteuid());
        add_action("zhaoming","use");
        this_player()->set_temp("heat",1);
}

int zhaoming(string arg)
{
        object where, me;
        object *ob,*inv;
        string msg,tmp,*dirs;
        mapping exits;
        int i;
        if(arg!="huoshi"&&arg!="shi"&&arg!="huo shi")
                return notify_fail("用法：use huoshi\n");
        me = this_player();
        arg=me->query("id");
        where = environment(find_player(arg));
        if (!where) return notify_fail ("火石发了一下光又熄灭了，你什么也没看到。\n");
        msg = where->query ("short");
        msg += where->query("long");
                
        if( mapp(exits = where->query("exits")) ) 
        {
                dirs = keys(exits);
                for(i=0; i<sizeof(dirs); i++)
                        if( (int)where->query_door(dirs[i], "status") & DOOR_CLOSED )
                                dirs[i] = 0;
                dirs -= ({ 0 });
                
                msg += sprintf("    这里明显的出口是 " HIY + "%s"   + NOR  " 和 " HIY 
                        + "%s"  + NOR "。\n",implode(dirs[0..sizeof(dirs)-2], "、"), 
                        dirs[sizeof(dirs)-1]);
        }

        inv = all_inventory(where);
        for(i=0; i<sizeof(inv); i++) 
        {
                if( inv[i]==me ) continue;
                //if( !me->visible(inv[i]) ) continue; //让隐身者现形！
                msg += "  " + inv[i]->short() + "\n";
        }
        write (msg);
        i=this_object()->query_amount();
        this_object()->set_amount(i-1);
        return 1;
}
