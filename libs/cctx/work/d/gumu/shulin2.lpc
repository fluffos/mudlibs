inherit ROOM; 
 
void create() 
{ 
	set("short", "小树林");
	set("long", @LONG
这是一片小树林，地上横七竖八的倒着几棵树(tree)。有一个中年男人正在砍树。
LONG
	);

	set("exits",([ 
  "west":__DIR__"shanlu2",
]));
	set("objects", ([
		CLASS_D("gumu") + "/yangguo" : 1,
			]));


	set("outdoors","gumu");
	//set("no_clean_up", 0);
	set("item_desc", ([
	"tree":"一株株大树迎风高耸，你一时兴起也想砍两下试试。\n",
	]));
	

	setup();
}
void init()
{
        add_action("do_kan", "kan");
}

int do_kan( string arg)
{       
        object me,weapon;
        int i_unarmed, i_qi;
        me=this_player();
        i_unarmed=(int)me->query_skill("unarmed",1);
        i_qi=600/(int)me->query("int");
        if (!arg || arg=="") return 0;
        if (arg == "tree")
                { 
	if(!present("chaidao" , me))
               return notify_fail("没有柴刀可以吗？\n");
              if( (int)me->query("qi") < i_qi)
               return notify_fail("你太累了，先休息一会吧。\n");
                if (i_unarmed < 50) 
                        {message("vinson","你举起柴刀猛地向大树砍去，可是只砍进树干寸许。\n",me);
                         message("vision",
                         me->name() + "举起柴刀猛地向大树砍去，可是只砍进树干寸许。\n",
                         environment(me), ({me}) );}
                if ( 50 <= i_unarmed && i_unarmed < 150) {
                        message("vinson","你高举柴刀猛力劈向大树，只听“嚓”的一声，柴刀没入树干。\n", me);
                        message("vision",
                         me->name() + "高举柴刀猛力劈向大树，只听“嚓”的一声，柴刀没入树干。\n",
                        environment(me), ({me}) );}
                if ( 150 <= i_unarmed) 
			{message("vision",me->name() + "力贯双臂，举起柴刀，对准树干拦腰砍去，只听“咔~~~嚓~~嚓”一人粗的树应声而倒！\n",
                        environment(me), ({me}) );
                        return notify_fail(  "你力贯双臂，举起柴刀，对准树干拦腰砍去，只听“咔~~~嚓~~嚓”一人粗的树应声而倒！\n" );}
                me->improve_skill("unarmed", 2*i_unarmed);
                me->receive_damage("qi", i_qi );
                }
        else return notify_fail("你要砍什么？\n");
        return 1;       
}

