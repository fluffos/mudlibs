// yufeng.c 玉蜂
// By Kayin @ CuteRabbit Studio 1999.3.25.new
#include <ansi.h>
inherit NPC;

void create()
{
	int age;
	age =this_player()->query("age") + random(40);
	set_name("玉蜂", ({"yu feng","feng","bee"}) );
	set("race", "野兽");
	set("age", age);
	set("long", "这是一只蜜蜂，正忙着采蜜。\n");
	
	set("str", 40);
	set("dex", 50);
	set("combat_exp",100 + age*10);

	set("limbs", ({ "头部", "身体", "翅膀", "尾巴" }) );
	set("verbs", ({ "poke" }) );

	set_temp("apply/attack", 33);
	set_temp("apply/armor", 20);
	
	set("chat_chance", 3);
	set("chat_msg", ({
		(: random_move :),
	"玉蜂嗡嗡嗡飞过来，在你头上转了一圈，又飞走了。\n",
	 }) );

	setup();
}
int hit_ob(object me, object ob, int damage)
{
	ob->apply_condition("feng_poison",(int)ob->query_condition("feng_poison")+5);
        tell_object(ob, HIR "你的身上被玉蜂蛰了一个大包！\n" NOR );
	
}