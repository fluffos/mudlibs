#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;
string ask_gm(object ob);
string ask_guo(object ob);
int do_skills(string arg);
int do_kill(object me, object dest);
string ask_dao();
void create()
{
        
        set_name("樵夫", ({ "qiao fu", "man"}));
        set("gender", "男性");
        set("age", 26);
        set("long","这是一名年轻的樵夫,虽然有一些残疾,可是臂力确是非常的惊人.\n");
        set("per",30);
        set("str",60);
        set("int",40);
        set("con",29);
        set("dex",25);
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set("apply/attack", 15);
        set("apply/defense", 15);
        set("apply/damage", 5);
        set("combat_exp", 10000);
        set("shen_type", 1);
        set("attitude", "peaceful");
        set("inquiry", ([
        "古墓": (: ask_gm :),
        "小龙女":"对不起，我不认识她",
        "杨过":(: ask_guo :),
        "name":"我叫傻蛋.\n",
        "名字":"我叫傻蛋.\n", 
        "神雕大侠":(: ask_guo :),
        "活死人墓":(: ask_gm :),
        "here":"这里是终南山.\n",
        "柴刀":(: ask_dao :),
        ]));
        setup();
        carry_object("/d/city/obj/cloth")->wear();
        add_money("silver", 5); 
}
void init()
{
        object ob;

        ::init();

        if( interactive(ob = this_player()) && !is_fighting() ) 
        {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
       ::init();
       add_action("do_skills","skills");
       add_action("do_skills","cha");
        if( !ob || environment(ob) != environment() ) return;
             say(""+this_object()->name()+"说道：这位" + RANK_D->query_respect(ob)
             + "，来此地有什么事吗?。\n");
        return;
}

string ask_dao()
{
        object dao;
        if(query("cdao")<1)
         return "我这里已经没有柴刀了。\n";
        if(!(int)this_player()->query_temp("dao"))
        {
                dao=new("/d/gumu/npc/obj/chaidao");
                dao->move(this_player());
                add("dao", -1);
                this_player()->set_temp("dao",1);
                return "借给你用吧.\n";
        }
        else
               return "“不是才借过一把给你吗？”说罢樵夫白了"+ this_player()->name() +"一眼。\n";
}

int recognize_apprentice(object ob)
{
    if (ob->query("shen")<50000) 
    {
    message_vision("$N摇了摇头说道，你的评价好像不是很好呀。\n",this_object());
    return 0;
        }
    if(!ob->query("couple/have_couple"))
    {
command("tell "+ob->query("id")+" 对不起，你还没有所爱的人，我不能教你。\n"); 
        return 0;
}
    return 1;   
}


int do_kill(object me, object dest)
{
        if( objectp(dest) && present(dest, environment(me))
                 && !environment(me)->query("no_fight"))
        {
                message_vision(HIR "$N对$n说道：我一见邪派高手就生气。"
                        +RANK_D->query_rude(dest)+"，纳命来！\n" NOR, me, dest);
                me->set_leader(dest);
                me->kill_ob(dest);
                dest->fight_ob(me);

                call_out("checking", 0,  me, dest);
        }
        else  
                call_out("waiting", 1, me, dest);
        
        return 1;
}


string ask_gm(object ob)
{
        mapping myfam;
        string str;
        myfam = (mapping)this_player()->query("family");
        if ((!myfam || myfam["family_name"] != "古墓派"))
        {
                str="“在山中有一个很大的墓穴,不知是不是.”\n";
                this_player()->set_temp("marks/古墓",1);
                return str;
        }
        else 
        {
                if ( this_player()->query("class") == "taoist" )
                {
                        str="对不起，从来没有听说过有这么个地方!\n";
                        return str;
                }
                else
                {
                        str="“这位"+RANK_D->query_respect(ob)+"已经是古墓派的弟子了，你还来问我？”\n";
                        return str;
                }
        }
}
string ask_guo(object ob)
{
    string str;
    object me;
    me=this_player();
    if( me->query("shen")< 500000 ||me->query_str() < 35
    ||me->query("kar")< 10 )
    {
        set_name("杨过", ({ "yang guo", "yang" }));
        set("nickname", HIG "神雕大侠" NOR);
        set("gender", "男性");
        set("age", 30);
        set("int",30);
        set("con",30);
        set("str", 30);
        set("dex", 30);
        set("long", "他是一位高大的男子，相貌俊秀。\n"+
        "一只长袖空空如也，显是断了一臂，尽管如此，\n"+
        "仍然掩不住他迷人的风采。\n");
        set("combat_exp", 5000000);
        set("score", 10000);
        set("shen_type", 1);
        set("attitude", "peaceful");
        set("count",1);
        set("cdao",1);
        set_skill("sword", 350);
        set_skill("force", 400);
        set_skill("unarmed", 400);
        set_skill("dodge", 350);
        set_skill("parry", 350);
        set_skill("anranxiaohun-zhang",400);
        set_skill("quanzhen-jianfa", 350);
        set_skill("xiantian-gong", 400);
        set_skill("xianyun-bufa",350);
        map_skill("sword", "quanzhen-jianfa");
        map_skill("parry", "anranxiaohun-zhang");
        map_skill("unarmed","anranxiaohun-zhang");
        map_skill("dodge", "xianyun-bufa");

        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/armor", 40);
        set_temp("apply/damage", 100);
        
        set("qi",2500);
        set("max_qi",2500);
        set("eff_qi",2500);
        set("neili", 5000); 
        set("max_neili", 5000);
        set("jiali", 100);
        set("inquiry", ([
                "小龙女" : "她就在小屋里。\n",
       ]) );
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action,"sword.sanqing" :),
                (: perform_action,"sword.tonggui" :),
                (: perform_action,"unarmed.xiaohun":),
                (: exert_function, "recover" :),
                (: exert_function, "heal" :),
                (: exert_function, "bidu" :),
        }) );

       create_family("古墓派", 3, "弟子");
       setup();
       carry_object("/clone/misc/cloth")->wear();
       add_money("gold", 2);
       return "“请问这位"+RANK_D->query_respect(this_player())+"找我有什么事吗？”\n";
	}
	else 
    {
    	return 0;
    }
}
int do_skills(string arg)
{
   object ob ;
   ob = this_player () ;
   if( !arg || arg!="yang" )
     return 0;
  if (ob->query("shen")<50000)
  {
   message_vision("$N摇了摇头说道，你的评价不怎么好吧！\n",this_object());
   return 1;
   }
   command("tell "+ob->query("id")+" 我所有的武功如下：\n"+
"□黯然消魂掌 (anranxiaohun-zhang)          - 深不可测 400/    0\n"+
"  基本轻功 (dodge)                         - 深不可测 350/    0\n"+    
"  基本内功 (force)                         - 深不可测 400/    0\n"+
"  基本拳脚 (unarmed)                       - 深不可测 400/    0\n"+
"  基本招架 (parry)                         - 深不可测 350/    0\n"+
"□全真剑法 (quanzhen-jianfa)               - 深不可测 350/    0\n"+
"  基本剑法 (sword)                         - 深不可测 350/    0\n"+
"□先天神功 (xiantian-gong)                 - 深不可测 400/    0\n"+
"□纤云步法 (xianyun-bufa)                  - 深不可测 350/    0\n");
return 1;
}