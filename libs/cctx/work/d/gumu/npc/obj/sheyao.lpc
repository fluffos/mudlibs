// sheyao.c  蛇药
// Kayin@CuteRabbit 1999/3/12
#include <ansi.h>

inherit ITEM;

void create()
{
   set_name(HIW"蛇药"NOR, ({"she yao", "yao"}));
   if (clonep())
      set_default_object(__FILE__);
   else {
      set("unit", "包");
      set("value", 500);
   }
   setup();
}

int init()
{
   add_action("do_eat", "eat");
}

int do_eat(string arg)
{
   object me = this_player();

   if(!id(arg))
       return notify_fail("你要吃什么？\n");

   message_vision(HIY"$N吃下一包" + name() + "。\n"NOR, me);
   if ((int)me->query_condition("snake_poison") > 0) {
    if ((int)me->query_condition("snake_poison") < 11) {
      me->apply_condition("snake_poison", 0);
      message_vision(HIY"$N"HIY"身上的蛇毒尽退，脸色看上去好多了。\n"NOR, me); }
   else {
   me->apply_condition("snake_poison", (int)me->query_condition("snake_poison") -10);
      message_vision(HIY"$N"HIY"的脸色渐渐红润起来。\n"NOR, me);
   }
  }
    else tell_object(me, HIY"好像没什么用。\n" NOR );

   destruct(this_object());
   return 1;
}
