#include <weapon.h>
inherit BLADE;

void create() {
  set_name("柴刀", ({ "chaidao", "dao" }));
  set_weight(9000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一柄普通的柴刀，是农家砍柴用的。\n");
    set("value", 10);
    set("material", "steel");
    set("wield_msg", "$N从腰中拔除刚借的柴刀。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");
  }
  init_blade(15);
  setup();
}
