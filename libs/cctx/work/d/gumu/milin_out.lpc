#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIB "古墓密林" NOR);
  set("long",
    "这是一片树的海洋。四周一望无际，全是参天的古树。周围静悄悄的。\n" +
    "远处偶尔传来几声鸟叫。这里就是密林的中央了。\n"
  );
  set("exits", ([
    "south": __DIR__ "milin2",
    "east": __DIR__ "milin2",
    "north": __DIR__ "damen",
    "west": __DIR__ "milin2",
  ]));

  set("outdoors", "gumu");

  setup();
}
void init() {
  object ob;
  mapping myfam;
  ob = this_player();
  if (query("exits/south"))
    myfam = (mapping)ob->query("family");
  if (myfam && myfam["family_name"] == "古墓派")
    if (ob->query("class") == !"taoist") {
      delete("exits/south");
      set("exits/south", __DIR__ "milin_in");
      return;
    }
  delete("exits/south");
  set("exits/south", __DIR__ "milin2");
}
