inherit ROOM; 
#include <ansi.h> 
void create() 
{ 
	set("short", "山边小路");
	set("long", 
"这是一条很窄的小路,紧靠着重阳宫,在这里可以看到重阳宫的围墙\n"
"围墙後有一幢建筑,在建筑的三楼"HIG"窗户"NOR"(window)还开着.\n"
	);
	set("item_desc",([
	"window":"这是重阳宫藏经搁三楼的窗户.\n"]));
	
	set("exits",([ 
  "southeast":__DIR__"xiaolu3",
]));
	
	set("outdoors","gumu");
	set("no_clean_up", 0);

	setup();
	replace_program(ROOM);
}
