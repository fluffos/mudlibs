#include <ansi.h> 
inherit ROOM; 
//int do_dao(string arg);
//int do_sheng(string arg);
//int do_zhu(string arg); 
void create() 
{ 
	set("short",BLK "厨房"NOR);
	set("long", @LONG
这是古墓的厨房，这里所有的东西一应俱全，灶(zao)台
上放着一口锅(guo)可以用来煮饭。
LONG
	);
	set("no_fight",1);
	set("exits",([ 
  "south":__DIR__"guodao6",
]));
	set("objects", ([
	__DIR__"obj/guo":1]));
set("item_desc", ([ 
"guo":"这是一口铁锅，看来这锅常常都有人用。\n",
"zao":"这是一口石灶如果你要做饭要先生火(sheng zao,dian zao).\n",
]));
	set("no_clean_up", 0);
	setup();
}
void init()
{
        add_action("do_dao","dao");
	add_action("do_dao","yao");
	add_action("do_dao","jia");
        add_action("do_sheng","sheng");
        add_action("do_sheng","dian");
        add_action("do_zuo","zuo");
}
int do_sheng(string arg)
{
	object me=this_player();
	if( !arg||arg=="")return 0;
	if( arg=="zao")
	{
		message_vision("$N"HIR"生起火"NOR"准备做饭。\n",me);
		me->set_temp("gumu/饭1",1);
		me->start_busy(5);
		return 1;
	}
	else write("你要在哪生火？\n");
	return 1;
}
int do_dao(string arg)
{
	object me=this_player();
	if( !arg||arg=="") return 0;
	if( arg=="shui")
	{
		if(me->query_temp("gumu/饭1",1))
		{
			message_vision("$N舀了两碗水倒进锅里,慢慢等着烧水。\n",me);
			me->set_temp("gumu/饭1",0);
			me->set_temp("gumu/饭2",1);
			me->start_busy(5);
			return 1;
		}
		else write("你舀水洗锅呀？\n");
		return 1;
	}
	else write("你要舀什么？\n");
	return 1;
}
int do_zuo(string arg)
{
        object me,guo;
        me = this_player();
        guo = present("guo", environment(me));
        if( me->query_temp("gumu/饭2",1) )
        {
                guo->serve_fan(me) ;
        }
        else {
                return notify_fail("你不生火烧水怎么煮饭?\n");
                }
}
int valid_leave(object me, string dir)
{
        if ( dir == "south")
        me->delete_temp("gumu/饭2");
        me->delete_temp("gumu/饭1");
        return ::valid_leave(me, dir);
}
	