// Room:/d/chongyang2.c
// By Kayin @ CuteRabbit Studio 99-4-13 15:14 new
inherit ROOM; 
#include <ansi.h> 
void create() 
{ 
	set("short", BLK"暗道"NOR);
	set("long", @LONG
这是一条狭长的暗道,里边一点儿灯火也没有.
前面是一堵墙，别的什么也没有了。
LONG
	);
	set("exits",([ 
	"south":__DIR__"chongyang1",
	]));
	set("objects", ([
		__DIR__"obj/fire":2,
		]));
		
	set("no_clean_up", 0);

	setup();

}
void init()
{
        add_action("do_pass","pass");
        add_action("do_pass","按");
        add_action("do_use","use");
}
int do_use(string arg)
{
        object me;
        me = this_player();
        if( !arg || arg=="" ) 
        	return 0;
        if (!present("fire", me)) 
        	return 0;
        if( arg=="fire" ) {
             write(
             "你点燃了一根火折，发现墙上有一块凸起的小石头(stone)。\n"
             );
             set("item_desc", ([ 
	"stone":"这好像是什么机关的按钮.\n",
	]));
	me->set_temp("gumu/重1",1);
	return 1;
       }
       else write("你要用什么?\n");
       return 1;
       
}
int do_pass(string arg)
{
	object ob=this_player();
	if(!arg||arg!="stone")
		return notify_fail("你要按什么?\n");
	if(ob->query_temp("gumu/重1",1))
	{
		if(ob->query_temp("gumu/重阳5",1))
		{
			message_vision("$N按了一下机关只听“咔”的一声，$N消失在墙后。\n", ob);
			ob->move(__DIR__"chongyang3");
			return 1;
		}
		else{
		message_vision("$N一阵乱按，触动了机关，只听几声轻想，数枚羽箭射向$N，\n"
		"$N在这狭窄的通道里无处可躲，数支羽箭从$N的后胸对穿而出.\n",ob);
		ob->die();
		return 1;
		}
	}
	else
	{
	write("你乱按什么?\n");
}	
}
	
