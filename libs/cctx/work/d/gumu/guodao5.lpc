#include <ansi.h> 
inherit ROOM; 
 
void create() 
{ 
	set("short",BLK "古墓过道"NOR);
	set("long", @LONG
这是一条狭长的过道,宽度还不到三丈。在左边的墙上好像有一道暗门(men).
LONG
	);

	set("exits",([ 
  "west":__DIR__"guodao2",
  "south":__DIR__"xiaoss2",
]));
set("item_desc", ([ 
	"men":"这是和墙壁衔接的非常吻合的一道暗门,如果不是注意去看它还真看不出来.\n",
	]));
	
	set("no_clean_up", 0);

	setup();

}
void init()
{
        add_action("do_push","push");
        add_action("do_push","tui");
        add_action("do_push","推");
} 
int do_push(string arg)
{
	object room;
	object ob=this_player();
	if(!arg||arg!="men") 
		return notify_fail("你要推什么?\n");

	if(ob->query_temp("gumu/重阳4",1))
		{
			message_vision("$N使出吃奶的力气把暗门推开,暗门后边是一条通道。\n", ob);
			set("exits/north",__DIR__"chongyang1");
			if( room = find_object(__DIR__"chongyang1") ) {
		        room->set("exits/south", __FILE__);}
			ob->delete_temp("gumu/重阳4");
			ob->set_temp("gumu/重阳5",1);
			return 1;
		}
	else{
		message_vision("$N使出吃奶的力气,可是暗门纹丝不动,只好悻悻的放弃了.\n",ob);
		return 1;
	}
}
int valid_leave(object me, string dir)
{
	object room;
        if(dir=="north")
        {
        	message_vision("$N一闪身进入暗门,紧接着暗门合上了。\n",me);
		delete("exits/north");
		if( room = find_object(__DIR__"chongyang1") ) {
	        room->delete("exits/south");}

		return 1;
	}
	else if(dir=="south"||dir=="west")
	{
		delete("exits/north");
		return 1;
	}
		return ::valid_leave(me, dir);
}
	
