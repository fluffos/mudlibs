inherit ROOM;
#include <ansi.h> 
int do_study(string arg);

void create()
{
	set("short", HIM"练拳室"NOR);
	set("long", @LONG
这是一间很大的房间，墙壁(wall)上刻着一些惟妙惟肖的美女
旁边还有注解，原来这就是古墓派的美女拳法。
LONG
	);
	set("exits",([
	"north":__DIR__"guodao9-2",
	]));
	set("item_desc", ([
		"wall" : "这上边刻着古墓派的美女拳法。\n",
	]));

	setup();
}

void init()
{
	add_action("do_study", "study");
	add_action("do_study","yanxi");
	add_action("do_study","lianxi");
	add_action("do_study","zuanyan");
	add_action("do_study","xuexi");
}


int do_study(string arg)
{
	mapping myfam;
	object me;
	
	me = this_player();

	if ( !arg || ( arg != "wall" ) )
		return notify_fail("什么？\n");
		
	if( me->query("gender") == "男性" )
		return notify_fail("你能学会吗？\n");
		
        myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] != "古墓派")
        	return notify_fail("你不是古墓派的弟子，不能学习这套拳法.\n");


	if ( (int)me->query_skill("literate", 1) < 1)
		return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
		
	if ((int)me->query_skill("tianluo-diwang",1)<100)
		return notify_fail("你的天罗地网势太差了，不能学习美女拳法。\n");
		
	if ((int)me->query_skill("meinu-quanfa",1)<10)
		return notify_fail("你连美女拳法的主旨都没搞清楚,你怎么练.\n");
				
        if ((int)me->query("max_neili")< 100)
        	return notify_fail("你的内功修为太差，不能练习美女拳法。\n");
        	
	if((int)me->query("qi") < 11)
		return notify_fail("你现在精神无法集中！\n");

	message_vision("$N正专心研读石壁上的武功。\n", me);

	if ( (int)me->query_skill("meinu-quanfa", 1) < 200)
		{
			me->improve_skill("meinu-quanfa", me->query_int());			
			write("你研究了一会儿石壁上的图形和注解，似乎对美女拳法有一些了解。\n");
			me->add("qi",-10);
			me->set_temp("stone_learned",1);
		}

	if ( !me->query_temp("stone_learned") )
	{
		write("你研究了一会儿石壁，发现上边所说的东西对你来说太浅了。\n");
	}
	return 1;
}

