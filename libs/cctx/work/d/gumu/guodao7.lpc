#include <ansi.h> 
inherit ROOM; 
 
void create() 
{ 
	set("short",BLK "古墓过道"NOR);
	set("long", @LONG
这是一条狭长的过道,墙壁上点着几盏昏暗的油灯.
LONG
	);

	set("exits",([ 
  "west":__DIR__"guodao3",
  "east":__DIR__"guodao8",
  "north":__DIR__"liangongfang1",
  "south":__DIR__"fangjian1",
]));
	set("no_clean_up", 0);

	setup();

}
