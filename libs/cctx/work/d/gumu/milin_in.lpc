#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIB "古墓密林" NOR);
  set("long",
    "这是一片树的海洋。四周一望无际，全是参天的古树。周围静悄悄的。\n" +
    "远处偶尔传来几声鸟叫。在地上立着一块小" HIY "石碑" NOR "(bei).\n"
  );
  set("item_desc", ([
    "bei": "外人止步",
  ]));
  set("exits", ([
    "south": __DIR__ "caodi1",
    "east": __DIR__ "milin2",
    "north": __DIR__ "milin2",
    "west": __DIR__ "milin2",
  ]));

  set("outdoors", "gumu");

  setup();
}
void init() {
  object ob;
  mapping myfam;
  ob = this_player();
  if (query("exits/north"))
    if (ob->query_temp("marks/古墓", 1)) {
      delete("exits/north");
      set("exits/north", __DIR__ "milin_out");
      ob->set_temp("marks/古墓", 0);
      return;
    }
  myfam = (mapping)ob->query("family");
  if (myfam && myfam["family_name"] == "古墓派")
    if (ob->query("class") == !"taoist") {
      delete("exits/north");
      set("exits/north", __DIR__ "milin_out");
      return;
    }
  delete("exits/north");
  set("exits/north", __DIR__ "milin2");
}
