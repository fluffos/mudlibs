inherit ROOM; 
 
void create() 
{ 
	set("short",BLK "古墓过道"NOR);
	set("long", @LONG
这是一条狭长的过道,墙壁上点着几盏昏暗的油灯.
LONG
	);

	set("exits",([ 
  "west":__DIR__"guodao7",
  "east":__DIR__"xiaoss3",
  "northeast":__DIR__"fangjian3",
]));
	set("no_clean_up", 0);

	setup();

}