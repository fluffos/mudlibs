#include <ansi.h> 
inherit ROOM; 
 
void create() 
{ 
	set("short",BLK "石屋"NOR);
	set("long",
"这座石室形状甚是奇特，前宽後窄，成为梯形，\n"
"西边半圆，东边却作三角形状.正好和刚才的那间屋子相反.\n"
"墙上同样刻满了诸般花纹"HIY"符号"NOR"(fuhao)均是以利器刻成，\n"
"或深或浅，殊无规则.\n"
	);

	set("exits",([ 
  "south":__DIR__"chongyang3",
]));
	set("item_desc", ([
		"fuhao" : "这便是古墓派内功的精髓所在“玉女心经”。\n",
	]));

	set("no_clean_up", 0);

	setup();

}
void init()
{
	add_action("do_study","study");
	add_action("do_study", "yuedu");
	add_action("do_study","du");
	add_action("do_study","yanjiu");
	add_action("do_study","zuanyan");
}


int do_study(string arg)
{
	mapping myfam;
	object me;
	
	me = this_player();

	if ( !arg || ( arg != "fuhao" ) )
		return 0;
		
        myfam = (mapping)me->query("family");

	if ( (int)me->query_skill("literate", 1) < 1)
		return notify_fail("你是个文盲，先学点文化(literate)吧。\n");

	if((int)me->query_skill("yunu-xinfa",1)<100)
                return notify_fail("你的玉女心法修为太差，不能学习玉女心经。\n");
				
        if ((int)me->query("max_neili")< 1000)
                return notify_fail("你的内功修为太差，不能练习玉女心经。\n");
        	
	if((int)me->query("qi") < 16)
		return notify_fail("你现在精神无法集中！\n");

	if((int)me->query("neili") < 21)
		return notify_fail("你的内力不够!\n");
		
	message_vision(HIY"$N正在揣摩符号。\n"NOR, me);

       if((int)me->query_skill("yunu-xinjing",1)<200)
		{
                     me->improve_skill("yunu-xinjing",me->query_int());
                        write("你似乎对玉女心经有所领悟。\n");
			me->add("qi",-15);
			me->add("neili",-20);
			me->set_temp("stone_learned",1);
		}

	if ( !me->query_temp("stone_learned") )
	{
		write("你发现上边所说的东西对你来说太浅了。\n");
	}
	return 1;
}

