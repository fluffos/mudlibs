#include <ansi.h> 
inherit ROOM; 
 
void create() 
{ 
	set("short",BLK "古墓过道"NOR);
	set("long", @LONG
这是一条狭长的过道,宽度还不到三丈。墙上点着一盏昏暗的油灯。
LONG
	);

	set("exits",([ 
  "west":__DIR__"bingqifang",
  "east":__DIR__"guodao3",
  "north":__DIR__"chufang",
]));
	set("no_clean_up", 0);

	setup();

}
