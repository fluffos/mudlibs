#include <ansi.h> 
inherit ROOM; 
 
void create() 
{ 
	set("short",BLK "石屋"NOR);
	set("long",
"这座石室形状甚是奇特，前窄後宽，成为梯形，\n"
"东边半圆，西边却作三角形状.墙上刻满了诸般花纹"HIY"符号"NOR"(fuhao)，\n"
"均是以利器刻成，或深或浅，殊无规则.\n"
	);

	set("exits",([ 
  "north":__DIR__"chongyang4",	
  "south":__DIR__"chongyang2",
]));
	set("item_desc", ([
		"fuhao" : "全真剑法的精髓尽在于此。\n",
	]));

	set("no_clean_up", 0);

	setup();

}
void init()
{
	add_action("do_study","study");	
	add_action("do_study", "yuedu");
	add_action("do_study","du");
	add_action("do_study","yanjiu");
	add_action("do_study","zuanyan");
}


int do_study(string arg)
{
	mapping myfam;
	object me;
	
	me = this_player();

	if ( !arg || ( arg != "fuhao" ) )
		return 0;
		
        myfam = (mapping)me->query("family");
        if(myfam && myfam["family_name"] != "古墓派")
        	return notify_fail("你不是古墓派的弟子，不能学习这套剑法.\n");


	if ( (int)me->query_skill("literate", 1) < 1)
		return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
		
	if ((int)me->query_skill("sword",1)<=(int)me->query_skill("quanzhen-jianfa",1))
		return notify_fail("你的基本功太差了,练好基本功再来吧.\n");

        if ((int)me->query("max_neili")< 100)
        	return notify_fail("你的内功修为太差，不能练习全真剑法。\n");
        	
	if((int)me->query("qi") < 16)
		return notify_fail("你现在精神无法集中！\n");

	if((int)me->query("neili") < 21)
		return notify_fail("你的内力不够!\n");
		
	message_vision(HIY"$N正在揣摩符号。\n"NOR, me);

	if ( (int)me->query_skill("quanzhen-jianfa", 1) < 200)
		{
			me->improve_skill("quanzhen-jianfa", me->query_int());			
			write("你似乎对全真剑法有所领悟。\n");
			me->add("qi",-15);
			me->add("neili",-20);
			me->set_temp("stone_learned",1);
		}

	if ( !me->query_temp("stone_learned") )
	{
		write("你发现上边所说的东西对你来说太浅了。\n");
	}
	return 1;
}

