// Room:/d/
// By Kayin @ CuteRabbit Studio 
inherit ROOM; 
#include <ansi.h>  
void create() 
{ 
	set("short", BLK"大厅"NOR);
	set("long", 
"这是一间很大的大厅,中间放着一张石桌,盘边放着几个石凳,\n"
"四周挂着好多盏油灯,把大厅照的异常明亮,在左边墙上有一盏\n"
""HIY"油灯"NOR"(deng)好像位置不对.\n"
	);

	set("item_desc", ([ 
	"deng":"这是一盏很普通的油灯.\n",
	]));
	set("exits",([ 
  "north":__DIR__"guodao3",
  "south":__DIR__"gumu_in",
  "east":__DIR__"guodao9-1",
  "west":__DIR__"guodao10-1",
  
]));
	set("no_clean_up", 0);

	setup();

}
void init()
{
      add_action("do_zhuan","zhuan");
}

int do_zhuan(string arg)
{
	string dir;
	object me=this_player();
	if(!arg||arg=="") return 0;
	if(arg=="deng")
	{
		if(me->query_temp("gumu/重阳",1))
		{
			write("你试著转动油灯,发现他可以左右转动....\n");
            me->delete_temp("gumu/重阳");
            me->set_temp("gumu/重阳1",1);
			return 1;
		}
		else if(me->query_temp("gumu/重阳3",1))
		{
			write("你使劲转动油灯，只听到“~轰~~隆~隆”，也不知道那里的门打开了.\n");
			me->delete_temp("gumu/重阳3");
			me->set_temp("gumu/重阳4",1);
			return 1;
		}
		else
		return 0;
	}
	if( sscanf(arg, "deng %s", dir)==1 ) 
	{
			if( dir=="right" ) 
			{
				if(me->query_temp("gumu/重阳1",1)) 
				{
				message_vision("$N将油灯向右转了半圈..，忽然听到“嗒”的一声。\n", me);
				me->delete_temp("gumu/重阳1");
				me->set_temp("gumu/重阳2",1);
				return 1;
				} 
				else
				{
				message_vision("$N使劲转了一下油灯,根本没用.\n",me);
				return 1;
				}
			}
			else if( dir=="left" ) 
			{
				if(me->query_temp("gumu/重阳2",1))
				{
				message_vision("$N将油灯像左转了半圈..，忽然听到“嗒”的一声。\n",me);
				me->delete_temp("gumu/重阳2");
				me->set_temp("gumu/重阳3",1);
				return 1;
				}
				else
				{
				message_vision("$N使劲转了一下油灯,根本没用.\n",me);
				return 1;
				}
			}
			else 
			{
			write("你要将油灯转向那个方向？\n");
			return 1;
			}
	}
}
