inherit ROOM;
#include <ansi.h> 
int do_study(string arg);

void create()
{
	set("short", HIC"密室"NOR);
	set("long", @LONG
这是古墓下的一间密室，墙上刻着一些文字(wenzi)。
LONG
	);
	set("exits",([
	"up":__DIR__"mushi",
	]));
	set("item_desc", ([
		"wenzi" : "原来这上边记载着九阴真经里的移魂大法。\n",
	]));

	setup();
}

void init()
{
	add_action("do_study", "study");
	add_action("do_study","xue");
	add_action("do_study","du");
	add_action("do_study","kan");
}


int do_study(string arg)
{
	mapping myfam;
	object me;
	
	me = this_player();

	if ( !arg || ( arg != "wenzi" ) )
		return notify_fail("什么？\n");
		
	if ( (int)me->query_skill("literate", 1) < 1)
		return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
		
	if( (int)me->query("shen") < 0 )
		return notify_fail("你的邪气太重，无法修炼移魂大法。\n");
		
	if ( (int)me->query("per") < 20)
		return notify_fail("就凭你这惨不忍睹的形象？。\n");
		
	if(me->query("gender") == "女性")
	{
		if(me->query_skill("yihun-dafa",1)>me->query("per")*15)
			return notify_fail("你就只能学到这些了。\n");
	}
	else
	{
		if(me->query_skill("yihun-dafa",1)>me->query("per")*5)
			return notify_fail("你就只能学到这些了。\n");
	}

        if ((int)me->query("max_neili")< 500)
        	return notify_fail("你的内功修为太差，不能学习移魂大法。\n");
        	
	if((int)me->query("jing") < 11)
		return notify_fail("你现在精神无法集中！\n");

	message_vision(HIY"$N专心的研读墙壁上的文字。\n"NOR, me);

		me->improve_skill("yihun-dafa", me->query_int());			
		write("对石壁上所说的东西似乎有了一些了解。\n");
		me->add("jing",-10);
	return 1;
}

