#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIG "比武厅" NOR);
  set("long", @LONG
这里是一间用来比武的大厅，墙的一边有一排兵器架，一边是一排木
桩(zhuang),几名弟子正在挥掌击打着木桩，留下了一道道黑色的掌印，看
来是在练毒掌，显的阴森恐怖。
LONG
  );
  set("exits", ([
    //"north": __DIR__"guangchang",
    "east": __DIR__ "lianwufang",
    "west": __DIR__ "e_changlang3",
    "south": __DIR__ "chufang",
  ]));

  set("no_clean_up", 0);
  //	set("outdoors", "xingxiuhai");
  set("objects", ([
    __DIR__ "obj/muzhang": 1,
    __DIR__ "obj/tiegun": 1,
  ]));
  setup();
  //	replace_program(ROOM);
}


void init() {
  add_action("do_da", "da");
}

int do_da(string arg) {

  object me = this_player();
  int ging_cost = 600 / (int)me->query_int();
  if (arg != "zhuang" || arg == "" || !arg)
    return 0;
  if ((int)me->query_skill("strike", 1) > 60)
    return notify_fail("你就是再打下去，对你也没什么好处了！\n");
  if ((int)me->query("jing") < 20)
    return notify_fail("你太累了，还是先休息一会吧!\n");
  message_vision("$N挥掌击打着木桩\n", me);
  me->improve_skill("strike", me->query_int());
  me->receive_damage("jing", ging_cost);
  return 1;
}
