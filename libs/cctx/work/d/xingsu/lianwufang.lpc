#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIG "练武房" NOR);
        set("long", @LONG
这间房子黑乎乎的，十分诡秘，四周什么都没有，却不时会听到练武
的声音，待你来看时，却什么都没有，偶尔有时会有一个影子一晃，却又
不见了，没什么特别的事，还是别呆在这里的好。
LONG
        );
        	set("exits", ([
  		//"north": __DIR__"guangchang",
		"west" : __DIR__"biwuting",
		//"west" : __DIR__"e_changlang3",
		//"south"  : __DIR__"chufang",
			]));
        
		set("no_clean_up", 0);
        //	set("outdoors", "xingxiuhai");

        	setup();
        //	replace_program(ROOM);
}

void init()
{
	add_action("do_make", "make");
}


int do_make( string arg)
{
	object *ob,env, obj,cor,me=this_player();
	int count,i;
	if ( ! arg || arg =="" || arg != "corpse") return 0;
	if ( objectp(cor=present("corpse", environment(me))))
	{
	 if ((int)me->query_skill("huagong-dafa",1) < 40 )
	 	return notify_fail("你的化功大法太低，不能制作僵尸\n");
	 if ( (int)me->query("neili") < 400 )
	 	return notify_fail("你的内力太低了，不能制作僵尸\n");
	env= environment(me);
	ob = all_inventory(env);
	obj =new(__DIR__"npc/jiangshi");
	for(i=0; i<sizeof(ob); i++)
		if( living(ob[i]) && ob[i]->id("jiang shi"))
			count++;
	//sprintf("%d",count);
	if (count > 3 ) return notify_fail("这里的僵尸太多了\n");
	message_vision(HIW "$N运起化功大法，将内力输入尸体里......\n"+
			   "过了一会，只见尸体动了起来，变成了一具僵尸\n" NOR,me);
	obj->move(env);
	me->add("neili",-400);
      destruct(cor);
	
	}
	else
	return notify_fail("你没有尸体，怎么做僵尸？\n");
	return 1;
}
