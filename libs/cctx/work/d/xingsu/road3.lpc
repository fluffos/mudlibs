#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "小路");
  set("long", @LONG
一条通向天山的小路，路边的草丛(cao)有些茂密，不时会发出嗖嗖的
响声另人耸然。
LONG
  );
  set("exits", ([
    "west": __DIR__ "road4",
    "southeast": __DIR__ "road2",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "xingxiuhai");
  set("count", 1);
  setup();
  //	replace_program(ROOM);
}

void init() {
  add_action("do_poke", "poke");
}

int do_poke(string arg) {
  object ob, me = this_player();
  if (arg != "cao" || !arg || arg == "") return 0;
  if (!query("count")) return notify_fail("你把草丛扒开，结果什么也没有!\n");
  message_vision("$N扒开草丛，忽然从里面爬出了几只蛇虫\n", me);
  ob = new(__DIR__ "npc/shachong");
  ob->move(environment(me));
  ob = new(__DIR__ "npc/shachong");
  ob->move(environment(me));
  ob = new(__DIR__ "npc/snake");
  ob->move(environment(me));
  return 1;
}
