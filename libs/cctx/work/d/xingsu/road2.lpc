#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
一条通向天山的小路，西域的天气是说变就变，一会是大晴天，一会
就风云突起，下起雨来，大雨倾盆，另人无处可藏，只有对着老天爷发起
牢骚来。
LONG
        );
        	set("exits", ([
  		"northwest" : __DIR__"road3",
		"east" : __DIR__"road1",
			]));
        
		set("no_clean_up", 0);
        	set("outdoors", "xingxiuhai");

        	setup();
        	replace_program(ROOM);
}
