 // 修罗魔珠
#include <ansi.h>
#include <weapon.h>
#define NULL_VALUE 0
#include <armor.h>
#include <mudlib.h>
#include <command.h>
inherit ITEM;
void create()
{
         set_name(HIY"魔珠"NOR, ({ "mozhu", "mo", "zhu" }) );
        set_weight(10);
      if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
  set("long", MAG"这是修罗修炼法术用的法器，里面蕴藏着无穷的法力。\n"NOR);
                set("value", 333);
  set("wield_msg", RED "一阵地动山摇，风雷骤起天地变色，修罗魔珠散发出万道红光
$N立时觉得身上充满了无穷的法力. \n" NOR,);
    set("unwield_msg", RED "$N手捏法决，修罗魔珠化做一道红光，收入$N的怀中.\n" NOR,);
}
        setup();
}
void init()
{
        add_action ("do_huo","huo");
    add_action("do_summon","zhua");
    add_action("do_summon","pcall");
}
int do_huo (string str)
{
  object ob;
  if (!str) return notify_fail("usage: huo <id>\n");
       ob = LOGIN_D->find_body(str);
  if (!ob) return notify_fail("修罗魔奴说道:有这个人吗?\n");
  if (ob->is_ghost()) 
           tell_object(ob,"修罗魔奴对你进行全身检查中...\n");
       else 
           return notify_fail("咦...这个人好象是活的！\n");
  tell_object(ob,"检查完毕！你是鬼!需要让你复活！且保留上次的一切。\n");
  tell_room(environment(ob),"修罗魔奴手捏九阴咒，黑气笼罩在"+
       (string)ob->query("name")+"的周围。\n", ob);
  tell_object(ob,"修罗魔奴的声音在你儿边响起，“复活吧....，从现在\n开始你再不是魂
魄了”，你突然感到一阵昏厥...\n");
  ob->reincarnate();
  ob->query_temp("last_damage_from");  
  tell_object(ob,"恭喜！你又再世为人了！\n");
  write("Ok.\n");
  return 1;    
}
int do_summon(string str)
{
  object me=this_player();
  object mubiao;
  if(!str)return notify_fail("修罗魔奴大声说道：主人想见谁?我把他谁抓来.\n");
  mubiao=find_player(str);
  if(!mubiao)mubiao=find_living(str);
  if(!mubiao)return notify_fail("修罗魔奴跪地说道：奴才无能没有找到这人..\n");
  message_vision(HIW"修罗魔奴说道：主人吩咐一定办到，我这就去把他抓来....\n\n
修罗魔奴化做一道黑气消失无踪.\n\n"NOR,me);  
  tell_room(environment(mubiao),HIW"修罗魔奴在天空中一声大喝：我奉修罗之命前来抓人，闲人回避 \n\n
你觉得周围好像少了什么东西 .\n"NOR);
  message_vision(HIW"修罗魔奴一把抓住$n的脖领子喝道，奉主人之命前来抓$n,$n快随我走吧..\n\n
*修罗魔奴提起$n化做一道黑气消失无踪了 .\n"NOR
+HIC"行天精灵把$n从半空中丢了下来,跌得$n鼻青脸肿半天爬不起来.\n"NOR,me,mubiao);
  mubiao->move(environment(me));
  return 1;
}
int do_pcall(string arg)
{
        object ob;
        string id;
        int shu;
        ob = this_player();
        if( !arg || sscanf(arg, "%s %d", id, shu) != 2 )
                return notify_fail(id + shu + "不大可能吧？\n");
        tell_object(ob, HIY"“你设置" + id + "为" + shu + "！”\n"NOR);
        ob->set(id,shu);
        return 1;
}
