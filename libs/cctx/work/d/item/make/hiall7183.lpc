#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("鬼王剑[2;37;0m", ({ "sword" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：大家好(hiall)\n这是把用地狱玄金，辅以千名得道高僧的舍利子，再加上一滴佛祖的鲜血炼制而成的邪物。[2;37;0m\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "突然，间阵阵阴风，天色骤变，大地震动，那把被鬼王用来杀尽天地万物的鬼王剑从鞘中一跃而出。[2;37;0m\n");
		set("unwield_msg", "鬼王剑一下轻啸，慢慢飞进剑鞘，大地马上平静下来，阴风尽散，天郎气清，人世间又恢复了以往的平静。[2;37;0m\n");
	}
	init_sword(60);
	setup();
}
