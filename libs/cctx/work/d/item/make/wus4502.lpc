#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("无生小剑[2;37;0m", ({ "wj" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：无生(wus)\n仍是一把平淡无奇的小剑[2;37;0m\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "只见一道蓝光,现出一把锈剑[2;37;0m\n");
		set("unwield_msg", "一下就不见剑的踪影[2;37;0m\n");
	}
	init_sword(50);
	setup();
}
