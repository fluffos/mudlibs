#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;35m桃花剑[2;37;0m", ({ "taohuasword" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m黑珍石[2;37;0m炼制而成的一把剑。\n剑柄上刻着一行小字：蒙蒙(year)\n[1;35m这把剑透着桃花的清香,一看就知道是year的剑![2;37;0m\n"
    );
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "[1;35m你抽出桃花剑,只见花瓣纷飞,剑气向四周涌出![2;37;0m\n");
    set("unwield_msg", "[1;35m你收起桃花剑![2;37;0m\n");
  }
  init_sword(50);
  setup();
}
