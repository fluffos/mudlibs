#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("飞雪剑[2;37;0m", ({ "jian" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：雪儿(xue)\n寒光四射[2;37;0m\n"
    );
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "$N一声清啸，抖出一把飞雪剑[2;37;0m。\n");
    set("unwield_msg", "$N随手一抹，收起了飞雪剑[2;37;0m。\n");
  }
  init_sword(50);
  setup();
}
