#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;33m屠龙[2;37;0m", ({ "tulong" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由[33m地藏之石[2;37;0m辅以[1;32m麒麟之血[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：小胖猫(ioio)\n\n");
    set("value", 500000000);
    set("materail", "[33m地藏之石[2;37;0m");
    set("wield_msg", "$N一声清啸，抖出一把[1;33m屠龙[2;37;0m。\n");
    set("unwield_msg", "$N随手一抹，收起了[1;33m屠龙[2;37;0m。\n");
  }
  init_sword(7000);
  setup();
}
