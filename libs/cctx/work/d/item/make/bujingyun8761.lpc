#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[1;36m绝世好剑[2;37;0m", ({ "sword" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m炼制而成的一把剑。\n剑柄上刻着一行小字：步惊云(bujingyun)\n用步惊云的血才能解开封印的惊世之剑[2;37;0m\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "步惊云以血祭剑，顷刻之间，步惊云手中已多了一把寒光四射的[1;36m绝世好剑[2;37;0m\n");
		set("unwield_msg", "一道剑影闪过，剑意散开，步惊云收起[1;36m绝世好剑[2;37;0m\n");
	}
	init_sword(50);
	setup();
}
