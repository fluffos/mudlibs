#include <ansi.h>

#include <weapon.h>

inherit STAFF;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("小辣椒[2;37;0m", ({ "jiao" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把杖\n杖柄上刻着一行小字：水灵儿(water)\n一把通红的小辣椒[2;37;0m\n"
    );
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "你装备小辣椒[2;37;0m\n");
    set("unwield_msg", "你把小辣椒放入怀中[2;37;0m\n");
  }
  init_staff(50);
  setup();
}
