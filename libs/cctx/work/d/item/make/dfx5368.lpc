#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;31m越王剑[2;37;0m", ({ "sword" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：大飞侠(dfx)\n[1;35m干将左手持蛟龙剪，一扬手已经取出了剑坯，右手持金刚锤聚精会神地用力锤打。[2;37;0m\n"
    );
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "[1;35m干将锤打完毕，大喝一声，将剑抛入水池，只听丝丝作响，从水池腾起一股雾气，弥漫四周。[2;37;0m\n");
    set("unwield_msg", "[1;35m你死定了！[2;37;0m\n");
  }
  init_sword(50);
  setup();
}
