#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[1;36m天羽奇剑[2;37;0m", ({ "jian" }));
	set_weight(300);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[1;33m凤凰羽毛[2;37;0m辅以[1;32m麒麟之血[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：爱丽丝(hiall)\n[1;36m这是一柄精钢所制的剑，剑身轻巧，寒气逼人。[2;37;0m\n");
		set("value", 500000000);
		set("materail", "[1;33m凤凰羽毛[2;37;0m");
		set("wield_msg", "$N一声清啸，抖出一把[1;36m天羽奇剑[2;37;0m。\n");
		set("unwield_msg", "$N随手一抹，收起了[1;36m天羽奇剑[2;37;0m。\n");
	}
	init_sword(10300);
	setup();
}
