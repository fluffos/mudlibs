		set("value", 10000000);
		set("materail", "[1;32m冰蚕丝[2;37;0m");
		set("wear_msg", "[1;32m你抖了抖上面的灰尘，穿上了件千苍百孔的道袍。[2;37;0m\n");
		set("remove_msg", "[1;36m你小心小心翼翼地收起了道袍.[2;37;0m\n");
		set("armor_prop/armor", 140);
	}
