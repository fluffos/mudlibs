#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;34m邪剑[2;37;0m", ({ "hh" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由炼制而成的一把剑。\n剑柄上刻着一行小字：何大壮(hch)\n[1;34m这是一把充满邪气的宝剑[2;37;0m\n");
    set("value", 0);
    set("materail", "");
    set("wield_msg", "[1;34m邪剑出鞘，血不染剑不归[2;37;0m\n");
    set("unwield_msg", "[1;34m你收起邪剑[2;37;0m\n");
  }
  init_sword(0);
  setup();
}
