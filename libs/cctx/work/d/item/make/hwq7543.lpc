#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[31m玫瑰花[2;37;0m", ({ "rose" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m炼制而成的一把剑。\n剑柄上刻着一行小字：花无缺(hwq)\n用呼吸，用身体，用生命，我只能这么默默关注着你.[2;37;0m\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "[1;36m这是一朵玫瑰花，因为珍藏了十几年，早已失去原有的色，香，味，依稀可辩的是她那原有的形态.[2;37;0m\n");
		set("unwield_msg", "[1;36m你深深叹了口气，缓缓收起了她。[2;37;0m\n");
	}
	init_sword(50);
	setup();
}
