#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;37m圣光神剑[2;37;0m", ({ "jian" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m地藏之石[2;37;0m辅以[1;32m麒麟之血[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：渡明(cgm)\n这把就是传说中的太阳之神所用的圣剑，恐怖非常，据说见过此剑出鞘的人没有可以生还的。[2;37;0m\n"
    );
    set("value", 500000000);
    set("materail", "[33m地藏之石[2;37;0m");
    set("wield_msg", "[1;31m只听到嗤的一声轻响，一道[1;37m强光[1;31m从天而降，眼前一片光亮，紧跟着眼前一黑，昏了过去。[2;37;0m\n");
    set("unwield_msg", "[34m慢慢的你终于有了知觉，只觉得眼前的强光突然消失，一切又恢复了正常，过了良久，才能看清周围的环境。[2;37;0m\n");
  }
  init_sword(12000);
  setup();
}
