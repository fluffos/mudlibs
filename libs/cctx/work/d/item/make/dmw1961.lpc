#include <armor.h>

inherit CLOTH;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("伏龙甲[2;37;0m", ({ "fulongjia" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("item_file_name", __FILE__);
    set("unit", "件");
    set(
      "long",
      "这是由[1;37m天蚕丝[2;37;0m炼制而成的一件甲。\n甲上刻着一行小字：大魔王(dmw)\n[1;31m远去看上去是一个仆仆统统的甲..但是...哈哈[2;37;0m\n"
    );
    set("value", 9370000);
    set("materail", "[1;37m天蚕丝[2;37;0m");
    set("wear_msg", "soufulongjia[2;37;0m\n");
    set("remove_msg", "[1;31m唰....甲没有了[2;37;0m\n");
    set("armor_prop/armor", 130);
  }
  setup();
}
