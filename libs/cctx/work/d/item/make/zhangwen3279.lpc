#include <armor.h>

inherit CLOTH;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;37m天使羽衣[2;37;0m", ({ "yuyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("item_file_name", __FILE__);
    set("unit", "件");
    set(
      "long",
      "这是由[1;37m天蚕丝[2;37;0m炼制而成的一件甲。\n甲上刻着一行小字：张雯(zhangwen)\n[33m是一件天使穿的羽衣，因不小心冲下天河，结果落入凡间![2;37;0m\n"
    );
    set("value", 9370000);
    set("materail", "[1;37m天蚕丝[2;37;0m");
    set("wear_msg", "[1;31m你穿上你件天使的羽衣，顿时你眼前一亮，这不是作梦吧，天使下凡了.[2;37;0m\n");
    set("remove_msg", "[1;36m你把天使的羽衣收好，下次跳舞时再穿.[2;37;0m\n");
    set("armor_prop/armor", 130);
  }
  setup();
}
