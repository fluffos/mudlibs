#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;36m雏凤剑[2;37;0m", ({ "power" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由[1;33m凤凰羽毛[2;37;0m辅以[1;32m麒麟之血[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：卡因(keyin)\n\n");
    set("value", 500000000);
    set("materail", "[1;33m凤凰羽毛[2;37;0m");
    set("wield_msg", "[1;34m$N一抬手,一把雏凤剑飞出.只见剑身灿烂夺目.[2;37;0m\n");
    set("unwield_msg", "[1;33m$N一招手,雏凤剑自动飞回了$N的腰间.[2;37;0m\n");
  }
  init_sword(12000);
  setup();
}
