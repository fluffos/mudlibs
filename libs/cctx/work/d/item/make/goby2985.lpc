#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;33m火神圣剑[2;37;0m", ({ "sword" }));
  set_weight(9000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[37m玄铁石[2;37;0m辅以[1;36m金刚砂[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：小明(goby)\n[1;31m这把就是传说中火神的宝物，隔了一件剑鞘还是觉得一阵阵火热的气直逼过来。[2;37;0m\n"
    );
    set("value", 15000000);
    set("materail", "[37m玄铁石[2;37;0m");
    set("wield_msg", "[1;37m突然间只觉得热气沸腾，就象到太阳上面似的，一把火红的宝剑从鞘中一跃而出。[2;37;0m\n");
    set("unwield_msg", "[1;34m只听到一声轻响，眼前一暗，那把火红的宝剑自动飞进剑鞘，四周马上恢复了一片清凉。[2;37;0m\n");
  }
  init_sword(360);
  setup();
}
