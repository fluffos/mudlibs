#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[36m山缺[2;37;0m", ({ "shangque" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：阿冲(chong)\n[36m这是一位无名铸剑师所炼之剑，剑柄刻着几个小字:山必有缺。[2;37;0m\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "[36m阿冲长叹一声，从背上缓缓取出山缺。[2;37;0m\n");
		set("unwield_msg", "$N随手一抹，收起了[36m山缺[2;37;0m。\n");
	}
	init_sword(50);
	setup();
}
