#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[1;37m邪剑[2;37;0m", ({ "hhh" }));
	set_weight(9000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[37m玄铁石[2;37;0m辅以[1;31m赤乌沙[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：李四(hhh)\n一把锋利的邪剑在阳光下闪闪发光[2;37;0m\n");
		set("value", 10000000);
		set("materail", "[37m玄铁石[2;37;0m");
		set("wield_msg", "[1;34m李四伸手一抖，抽出一把锋利邪剑[2;37;0m\n");
		set("unwield_msg", "$N随手一抹，收起了[1;37m邪剑[2;37;0m。\n");
	}
	init_sword(140);
	setup();
}
