#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("竹剑[2;37;0m", ({ "hhh" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由炼制而成的一把剑。\n剑柄上刻着一行小字：李四(hhh)\n这是一把练功的竹剑[2;37;0m\n");
    set("value", 0);
    set("materail", "");
    set("wield_msg", "李四伸手一抖，抽出一把竹剑。[2;37;0m\n");
    set("unwield_msg", "李四随手一挥，收起竹剑[2;37;0m\n");
  }
  init_sword(0);
  setup();
}
