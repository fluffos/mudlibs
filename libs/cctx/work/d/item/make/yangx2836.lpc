#include <armor.h>

inherit CLOTH;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;33m真龙宝甲[2;37;0m", ({ "sword" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("item_file_name", __FILE__);
    set("unit", "件");
    set(
      "long",
      "这是由[1;37m天蚕丝[2;37;0m炼制而成的一件甲。\n甲上刻着一行小字：杨逍(yangx)\n[1;31m这是以百龙之鳞炼成的宝甲，是传说中的宝物，也是上古十珍之一。[2;37;0m\n"
    );
    set("value", 9370000);
    set("materail", "[1;37m天蚕丝[2;37;0m");
    set("wear_msg", "[1;31m杨逍一声长啸,天空中似有金龙翻滚，突然化作一道紫光射入杨逍身上，聚虚成形。[2;37;0m\n");
    set("remove_msg", "[1;32m杨逍口中念念有词，只见他身上的真龙宝甲发出一道强光，伴随着龙吟之声，射入天际。[2;37;0m\n");
    set("armor_prop/armor", 130);
  }
  setup();
}
