#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;31m匕首[2;37;0m", ({ "bishou" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m地藏之石[2;37;0m辅以[1;32m麒麟之血[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：杨阳(abc)\n细看那匕首，剑身如墨，无半点光泽。[2;37;0m\n"
    );
    set("value", 500000000);
    set("materail", "[33m地藏之石[2;37;0m");
    set("wield_msg", "$N「唰」的一声抽出一柄[1;31m匕首[2;37;0m握在手中，只觉一股寒气扑面而来。[2;37;0m\n");
    set("unwield_msg", "$N将手中的[1;31m匕首[2;37;0m插回剑鞘，只听嗤的一声轻响。[2;37;0m\n");
  }
  init_sword(12000);
  setup();
}
