#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("钢剑[2;37;0m", ({ "jian" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m地藏之石[2;37;0m辅以[1;32m麒麟之血[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：七星(mildseven)\n这是一柄精工制成的钢剑，这种剑在将领之间非常流行。[2;37;0m\n"
    );
    set("value", 500000000);
    set("materail", "[33m地藏之石[2;37;0m");
    set("wield_msg", "你「唰」的一声抽出一柄钢剑握在手中。[2;37;0m\n");
    set("unwield_msg", "你将手中的钢剑插回剑鞘。[2;37;0m\n");
  }
  init_sword(7000);
  setup();
}
