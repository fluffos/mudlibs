#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("洛洛的天使之剑[2;37;0m", ({ "lolo" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[1;33m凤凰羽毛[2;37;0m炼制而成的一把剑。\n剑柄上刻着一行小字：响尾蛇(xws)\n这是一把洛洛的天使之剑，剑身散发着青光.[2;37;0m\n"
    );
    set("value", 125000000);
    set("materail", "[1;33m凤凰羽毛[2;37;0m");
    set("wield_msg", "洛洛的天使之剑飞出剑鞘，四周闪电雷鸣，天地为之哭泣。[2;37;0m\n");
    set("unwield_msg", "洛洛的天使之剑飞入剑鞘，四周恢复了平静。[2;37;0m\n");
  }
  init_sword(1750);
  setup();
}
