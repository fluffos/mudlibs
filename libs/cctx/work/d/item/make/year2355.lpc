#include <armor.h>

inherit CLOTH;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;34m桃花甲[2;37;0m", ({ "yeararmor" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("item_file_name", __FILE__);
    set("unit", "件");
    set(
      "long",
      "这是由[1;37m天蚕丝[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一件甲\n甲上刻着一行小字：蒙蒙(year)\n[1;31m这是一件用天蚕丝和汞丹母打造的一件宝甲![2;37;0m\n"
    );
    set("value", 9370000);
    set("materail", "[1;37m天蚕丝[2;37;0m");
    set("wear_msg", "你穿上了[1;34m桃花甲![2;37;0m\n");
    set("remove_msg", "你把[1;34m桃花甲[2;37;0m脱了下来![2;37;0m\n");
    set("armor_prop/armor", 130);
  }
  setup();
}
