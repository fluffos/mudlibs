#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("断剑[2;37;0m", ({ "duansword" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：断剑(duanjian)\n此乃大侠断剑的随身宝剑,断口处光滑平整,似乎有人以极精纯的内力折断所致.[2;37;0m\n"
    );
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "[35m只见断剑双指一拣,拿出了心爱的宝剑,顿时一股生气迎面扑来.[2;37;0m\n");
    set("unwield_msg", "[34m断剑随手一抹,宝剑就隐然进入断剑的身体.[2;37;0m\n");
  }
  init_sword(80);
  setup();
}
