	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：小明(hiall)\n\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "$N一声清啸，抖出一把匕首[2;37;0m。\n");
		set("unwield_msg", "$N随手一抹，收起了匕首[2;37;0m。\n");
	}
