#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[1;37m雪莲剑[2;37;0m", ({ "ruis" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：睿睿子(rui)\n[1;37m此剑乃天山的万年玄冰形成，名曰雪莲剑，剑身如寒冰般透明,薄如蝉翼，是世上少有的神兵宝刃。[2;37;0m\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "[1;37m睿睿子手轻轻一抖,只见雪莲剑光流动，变幻不定,刹时你感到寒刺骨，四周的空气如冰封般凝固.[2;37;0m\n");
		set("unwield_msg", "[1;37m只见睿睿子口中念念有词，天山雪莲剑化为一缕青烟，消失于天地之间。[2;37;0m\n");
	}
	init_sword(50);
	setup();
}
