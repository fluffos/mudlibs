#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[36m碧血剑[2;37;0m", ({ "bixuejian" }));
	set_weight(12000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m地藏之石[2;37;0m辅以[1;32m麒麟之血[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：澄云(letten)\n这是一把与众不同的剑，剑身有着一丝淡淡的蓝色波纹，入手极轻，一看就知道是一把杀人利器。[2;37;0m\n");
		set("value", 500000000);
		set("materail", "[33m地藏之石[2;37;0m");
		set("wield_msg", "唰的一声，$N从身上抽出一把闪着蓝光的长剑，你心里不禁紧张起来。[2;37;0m\n");
		set("unwield_msg", "$N把剑收回到身上，你这才慢慢松了口气。[2;37;0m\n");
	}
	init_sword(7000);
	setup();
}
