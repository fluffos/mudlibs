#include <ansi.h>

#include <weapon.h>

inherit BLADE;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[1;31m园月弯刀[2;37;0m", ({ "blade" }));
	set_weight(9000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[37m玄铁石[2;37;0m辅以[1;36m金刚砂[2;37;0m炼制而成的一把刀\n刀柄上刻着一行小字：杨阳(abc)\n\n");
		set("value", 15000000);
		set("materail", "[37m玄铁石[2;37;0m");
		set("wield_msg", "$N一声清啸，抖出一把[1;31m园月弯刀[2;37;0m。\n");
		set("unwield_msg", "$N随手一抹，收起了[1;31m园月弯刀[2;37;0m。\n");
	}
	init_blade(360);
	setup();
}
