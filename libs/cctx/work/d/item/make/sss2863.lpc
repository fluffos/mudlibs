#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("劏猪剑[2;37;0m", ({ "sword" }));
  set_weight(0);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由炼制而成的一把剑。\n剑柄上刻着一行小字：杀杀杀(sss)\n\n");
    set("value", 0);
    set("materail", "");
    set("wield_msg", "$N一声清啸，抖出一把劏猪剑[2;37;0m。\n");
    set("unwield_msg", "$N随手一抹，收起了劏猪剑[2;37;0m。\n");
  }
  init_sword(0);
  setup();
}
