#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;31m[2;37;0m", ({ "龙神之剑sword" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：云儿(yuner)\n[1;31m用千个童子之血炼成威力无比[2;37;0m\n"
    );
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "[1;31m只见天空中一遍乌云飘来!!!!吓死人了[2;37;0m\n");
    set("unwield_msg", "[1;31m只见天边的乌云顿时散开来,真是很妙[2;37;0m\n");
  }
  init_sword(50);
  setup();
}
