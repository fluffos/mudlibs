#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[37m剑杀[2;37;0m", ({ "sword" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m地藏之石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：杨逍(yangx)\n[37m此剑名曰“剑杀”，为上古三邪之一，曾破剑无数，故佛祖视为邪物，封之于天池。[2;37;0m\n"
    );
    set("value", 125000000);
    set("materail", "[33m地藏之石[2;37;0m");
    set("wield_msg", "[37m杨逍收敛起笑容，抖出一把长约三尺三分的细剑，刹时，天地间充满了萧萧杀意。[2;37;0m\n");
    set("unwield_msg", "[37m杨逍微微一笑，将剑杀还入鞘内，天地间的杀气随之而散,又变得一遍祥和.[2;37;0m\n");
  }
  init_sword(3000);
  setup();
}
