#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;34m情长剑[2;37;0m", ({ "sword" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由[1;33m凤凰羽毛[2;37;0m炼制而成的一把剑。\n剑柄上刻着一行小字：聪(congw)\n[1;34m情长之剑[2;37;0m\n");
    set("value", 125000000);
    set("materail", "[1;33m凤凰羽毛[2;37;0m");
    set("wield_msg", "[1;34m$N流着热泪，缓缓抽出一把痴心情长剑。[2;37;0m\n");
    set("unwield_msg", "[1;34m$N深深谈了口气，将痴心情长剑还入剑鞘。[2;37;0m\n");
  }
  init_sword(1750);
  setup();
}
