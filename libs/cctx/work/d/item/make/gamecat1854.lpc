#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("林月如之剑[2;37;0m", ({ "sky" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：林月如(gamecat)\n林月如之剑[2;37;0m\n"
    );
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "林月如摸出把剑来[2;37;0m\n");
    set("unwield_msg", "林月如把剑收了起来[2;37;0m\n");
  }
  init_sword(50);
  setup();
}
