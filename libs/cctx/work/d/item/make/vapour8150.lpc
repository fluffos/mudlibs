#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[1;37m剑气[2;37;0m", ({ "va" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m炼制而成的一把剑。\n剑柄上刻着一行小字：玉笛书生(vapour)\n[36m剑就像空气一样[2;37;0m\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "[1;31m剑[2;37;0m\n");
		set("unwield_msg", "[1;33m突然白气不见..只见玉笛书生.....[2;37;0m\n");
	}
	init_sword(60);
	setup();
}
