#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[31m金蛇剑[2;37;0m", ({ "jian" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：李子(lyl)\n\n");
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "[1;37m只见叶开口中念念有词从他身后飞出一把兵器，煞时间天地无色日月无光.[2;37;0m\n");
    set("unwield_msg", "[1;36m叶开把剑随手一抛，只见金蛇剑飞入他身后的剑鞘[2;37;0m\n");
  }
  init_sword(50);
  setup();
}
