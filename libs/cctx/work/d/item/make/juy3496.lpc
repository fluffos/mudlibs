#include <ansi.h>

#include <weapon.h>

inherit STAFF;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;31m金箍棒[2;37;0m", ({ "mylove" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由[33m黑珍石[2;37;0m炼制而成的一把杖。\n杖柄上刻着一行小字：九月鹰飞(juy)\n这是九月鹰飞的打狗棒！[2;37;0m\n");
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "[1;33m九月鹰飞从身上掏出一根金箍棒，只觉得满眼金光！[2;37;0m\n");
    set("unwield_msg", "[1;36m不觉中，棒已不见！[2;37;0m\n");
  }
  init_staff(50);
  setup();
}
