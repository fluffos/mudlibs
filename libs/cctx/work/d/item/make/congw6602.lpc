#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
        set_name("^[[1;34m痴心情长剑[[2;37;0m", ({ "sword" }));
	set_weight(300);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[1;33m凤凰羽毛[2;37;0m辅以[1;32m麒麟之血[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：聪(congw)\n\n");
		set("value", 500000000);
		set("materail", "[1;33m凤凰羽毛[2;37;0m");
		set("wield_msg", "$N流着热泪，缓缓抽出一把痴心情长剑,全场霎时为蓝光所迷漫。[2;37;0m\n");
		set("unwield_msg", "$N一揩鼻涕，收起痴心剑，蓝光顿敛！[2;37;0m\n");
	}
	init_sword(10000);
	setup();
}
