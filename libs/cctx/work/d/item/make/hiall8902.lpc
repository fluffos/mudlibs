#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("小匕首[2;37;0m", ({ "sword" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：小明(hiall)\n这是一把小小的匕首，是小明姑娘的玩具，做得很精致。[2;37;0m\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "小明姑娘长长的秀发随风飘起，大家只觉得眼前一亮，再细看是，她手上已多了一把小小的匕首。[2;37;0m\n");
		set("unwield_msg", "$N随手一抹，收起了小匕首[2;37;0m。\n");
	}
	init_sword(50);
	setup();
}
