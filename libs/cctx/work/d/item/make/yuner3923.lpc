#include <armor.h>

inherit CLOTH;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("宝甲[2;37;0m", ({ "cloth1" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("item_file_name", __FILE__);
    set("unit", "件");
    set("long", "这是由炼制而成的一件甲。\n甲上刻着一行小字：云儿(yuner)\n\n");
    set("value", 0);
    set("materail", "");
    set("wear_msg", "[33m$N随手一挥，披上了宝甲[2;37;0m[33m。[2;37;0m\n");
    set("remove_msg", "[33m$N略微一抖，收起了宝甲[2;37;0m[33m。[2;37;0m\n");
    set("armor_prop/armor", 0);
  }
  setup();
}
