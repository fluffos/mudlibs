#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;32m西瓜刀[2;37;0m", ({ "va" }));
  set_weight(9000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由[37m玄铁石[2;37;0m辅以[1;31m赤乌沙[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：玉笛书生(vapour)\n\n");
    set("value", 10000000);
    set("materail", "[37m玄铁石[2;37;0m");
    set("wield_msg", "[1;36m玉笛书生大叫一声....老兄想打架吗....玉笛急忙的从身上拿出一把西瓜刀[2;37;0m\n");
    set("unwield_msg", "[1;36m好吧这回就放过你..[2;37;0m\n");
  }
  init_sword(180);
  setup();
}
