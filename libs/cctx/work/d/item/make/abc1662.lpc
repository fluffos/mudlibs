#include <ansi.h>

#include <weapon.h>

inherit WHIP;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;36m夺命金索[2;37;0m", ({ "suo" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "根");
    set("long", "这是由[37m玄铁石[2;37;0m辅以[1;36m金刚砂[2;37;0m炼制而成的一根鞭\n鞭柄上刻着一行小字：杨阳(abc)\n\n");
    set("value", 15000000);
    set("materail", "[37m玄铁石[2;37;0m");
    set("wield_msg", "$N一声清啸，抖出一根[1;36m夺命金索[2;37;0m。\n");
    set("unwield_msg", "$N随手一抹，收起了[1;36m夺命金索[2;37;0m。\n");
  }
  init_whip(360);
  setup();
}
