#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;34m邪剑[2;37;0m", ({ "hh" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m黑珍石[2;37;0m炼制而成的一把剑。\n剑柄上刻着一行小字：李四(hhh)\n上面克着一行小字：版权所有严禁伪造[1;34m李四(hhh)[2;37;0m\n"
    );
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "[1;34m邪剑出鞘，血不染剑不归![2;37;0m\n");
    set("unwield_msg", "[1;34m李四随手一挥，邪剑已入鞘内[2;37;0m\n");
  }
  init_sword(50);
  setup();
}
