#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param)
{
}

void create()
{
	set_name("[1;31m红剑鱼[2;37;0m", ({ "jian" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("item_make", 1);
		set("unit", "把");
		set("long", "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：小昆明(xkm)\n[1;37m宝贝，果然宝贝，千年以来只有达摩祖师可以拥有。[2;37;0m\n");
		set("value", 3750000);
		set("materail", "[33m黑珍石[2;37;0m");
		set("wield_msg", "[1;31m红光一闪，一把鲨鱼一样的宝剑腾的飞出，四处为之一亮！[2;37;0m\n");
		set("unwield_msg", "[1;33m宝剑“刺刺”收回，刹那间满屋暗淡！！[2;37;0m\n");
	}
	init_sword(50);
	setup();
}
