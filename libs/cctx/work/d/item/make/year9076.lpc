#include <ansi.h>

#include <weapon.h>

inherit SWORD;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("[1;35m桃花剑[2;37;0m", ({ "taohua" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set(
      "long",
      "这是由[33m黑珍石[2;37;0m辅以[1;33m汞丹母[2;37;0m炼制而成的一把剑\n剑柄上刻着一行小字：蒙蒙(year)\n[1;35m这个一把由黑珍石和汞丹母铸成的剑,透着一股桃花的清香![2;37;0m\n"
    );
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "[1;35m蒙蒙右手一伸,只见无数花瓣落下,她的手上就多了一把桃花剑![2;37;0m\n");
    set("unwield_msg", "[1;35m蒙蒙随手一挥,桃花剑随着花香就消逝啦![2;37;0m\n");
  }
  init_sword(50);
  setup();
}
