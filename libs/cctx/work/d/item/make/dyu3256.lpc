#include <ansi.h>

#include <weapon.h>

inherit STAFF;

string query_autoload() { return "1"; }

void autoload(string param) {}

void create() {
  set_name("玉竹杖[2;37;0m", ({ "yuzhuzhang" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("item_make", 1);
    set("unit", "把");
    set("long", "这是由[33m黑珍石[2;37;0m炼制而成的一把杖。\n杖柄上刻着一行小字：段玉(dyu)\n\n");
    set("value", 3750000);
    set("materail", "[33m黑珍石[2;37;0m");
    set("wield_msg", "$N一声清啸，抖出一把玉竹杖[2;37;0m。\n");
    set("unwield_msg", "$N随手一抹，收起了玉竹杖[2;37;0m。\n");
  }
  init_staff(50);
  setup();
}
