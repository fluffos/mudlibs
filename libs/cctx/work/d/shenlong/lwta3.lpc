// Date: 7* 99.2.27

inherit ROOM;
string look_out();
void create()
{
	set("short", "了望塔三层");
	set("long", @LONG
 你爬得汗流夹背,终于到了了望塔的顶层,西面海水 
拍岩,好高好清凉的所在呀,这里平时备有狼烟,硫磺 
等引火报警之物.也是神龙岛的第一屏障.不时有神龙
弟子上上下下的忙碌.你注意到这儿有(out) 
LONG
	);

	set("exits", ([
		"down" : __DIR__"lwta2",
	]));

	set("item_desc",([
				"out"		:	(: look_out :),
	]));
	//set("objects",([
	//	CLASS_D("shaolin") + "/qing-wen" : 1,
	//]));
          set("outdoors", "shenlong");
           setup(); 

}


void init()
{
	
	add_action("do_out", "out");
}



int do_out(string arg)
{
        object me, killer;

	int i, ging_cost, qi_cost;

        me = this_player();
        i = (int)me->query_skill("dodge", 0) + random(200);
       
        qi_cost = 500 / (int)me->query("int");
        if(((int)me->query("jing") < ging_cost) || ((int)me->query("qi") < qi_cost))
                i = 0;

        message_vision("$N钻出塔腰,抓住一根横竹,一松手.....\n", me);
        me->move(__DIR__"dayuan");
        message_vision("咚的一声闷响,只见$N站在沙堆上\n", me);
        if ( i < 50)
	{
		killer = new(CLASS_D("shaolin") + "/qing-wen");
		COMBAT_D->killer_reward(killer, me);
                me->die();
		destruct(killer);
	}
        else if( i < 125)
                me->unconcious();
        else {
                message_vision("$N金鸡独立,立在沙堆上。\n", me);
                if( i > 175)
                        me->improve_skill("dodge", 2*(int)me->query_skill("dodge", 1));
                
                me->receive_damage("qi", qi_cost );
        }

        return 1;
}
string look_out()
{
	return  
"这是了望塔的顶楼,海风从竹楼的缝隙吹进来,旁边的弟子正持刀向外张望\n";
}


