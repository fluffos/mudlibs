inherit ROOM;

void create() {
  set("short", "竹棚走道");
  set("long", @LONG
      前面不远处就是神龙弟子平时练功的地方了,
         不时传来他们低低的呼喝声,跳跃落地声,虽然是
         新建的地方,但是已被神龙弟子的足迹把地上铺的
        竹片踩得有点发亮了.
LONG
  );

  set("exits", ([
    "northup": __DIR__ "lgfroad1",
    "southdown": __DIR__ "lgf1",
  ]));
  // set("objects", ([
  //             "/d/shenlong/npc/xuxuetin": 1,
  // ]));
  set("outdoors", "shenlong");
  setup();
  replace_program(ROOM);
}
