#include <ansi.h>

inherit ROOM;
string *npcs = ({
  __DIR__ "npc/boy",
  "/7/npc/girl",
  __DIR__ "npc/old",
});


void create() {
  set("short", "大门");
  set("long", @LONG
这儿终于到了新修的神龙教大门了,竹门上面用青色的生漆
写着几个大字<<神龙教>>,竹门下的几个神龙弟子在争论
着什么,不过看他们的神色,还是喜气洋洋的.
LONG
  );
  set("objects", ([

    __DIR__ "npc/old": 1,
    __DIR__ "npc/boy": 2 + random(2),
    __DIR__ "npc/girl": 2,
  ]));
  set("exits", ([
    "west": __DIR__ "road3",
    "east": __DIR__ "road4",
  ]));

  set("outdoors", "shenlong");
  setup();
  replace_program(ROOM);

}
int valid_leave(object me, string dir) {

  if (present("ren", this_player())
  ) {
    if (dir == "west") {
      return notify_fail("神龙老者说道: 怎么中土之人如此下作,来盗我珊瑚人。\n");
    }
  }
  return ::valid_leave(me, dir);
}
