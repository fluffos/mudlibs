inherit ROOM;

void create()
{
    set("short", "大道");
    set("long", @LONG
      狭窄的走道,铺的石板不是很平,你不时要躲闪上面
  取了兵器下来的神龙弟子.不过两边绿荫成片,在这千里之
 外的海岛也算是个奇迹.
LONG
    );

    set("exits", ([
                "northup" : __DIR__"bqs",
                "southdown" : __DIR__"bqsroad1",
    ]));
    set("objects", ([
                __DIR__"npc/girl": 1,
                __DIR__"npc/boy": 1,
    ]));
    set("outdoors", "shenlong");
    setup();
   replace_program(ROOM); }