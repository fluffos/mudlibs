inherit ROOM;
void create() {
  set("short", "七星阁");
  set("long", @LONG
这是神龙岛刚修不久的七星阁,里面收藏了神龙弟子浴血夺
回的各式名兵,旁边有两张供桌,上供几本秘籍,故老相传,如果
参透其中的任何三本,就可天下无敌.
LONG
  );
  set("exits", ([
    "out": __DIR__ "bqs",
  ]));
  set("objects", ([
    __DIR__ "obj/sword": 1,
    __DIR__ "obj/staff": 1,
    __DIR__ "obj/finger": 1,
    __DIR__ "obj/blade": 1,
    __DIR__ "obj/unarmed": 1,
    __DIR__ "obj/dodge": 1,
    __DIR__ "obj/hyyqbook": 1,
    __DIR__ "obj/sdqgbook": 1,
    __DIR__ "obj/slbsbook": 1,
    __DIR__ "obj/slxfbook": 1 ]));
  set("outdoors", "shenlong");
  setup();
  replace_program(ROOM);
}
