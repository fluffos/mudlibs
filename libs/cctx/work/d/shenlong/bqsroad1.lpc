inherit ROOM;

void create() {
  set("short", "大道");
  set("long", @LONG
      上来后,你发现这个兵器室是建在个小土丘上的,
  原来神龙岛远离中土,只有大量种植竹子,以充建筑
  材料,因此道路不太好走,而且有点狭窄,没办法,你
  屏了口气,这样才让得开对面过来的人.
LONG
  );

  set("exits", ([
    "northup": __DIR__ "bqsroad2",
    "southdown": __DIR__ "road4",
  ]));
  set("objects", ([
    __DIR__ "npc/boy": 1,
  ]));
  set("outdoors", "shenlong");
  setup();
}
