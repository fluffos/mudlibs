inherit ROOM;

void create() {
  set("short", "聚一堂");
  set("long", @LONG
这是神龙岛的议事厅,西,南边都坐着几个老者,
好象在讨论着什么重要的事情老者身后又分别列席着数
十个位子,奇怪的是,东边的位子却没有人坐,你不由得放
轻了脚步,噤声缓行,好象这样才能适应这儿的气氛.
LONG
  );
  set("no_beg", 1);
  set("exits", ([
    "southdown": __DIR__ "hiroad3",
  ]));
  set("objects", ([

    __DIR__ "npc/xu": 1, __DIR__ "npc/wugen": 1, __DIR__ "npc/zhang": 1,
    __DIR__ "npc/boy": 2,
    __DIR__ "npc/old": 2,
  ]));
  set("outdoors", "shenlong");
  setup();
}
