inherit ROOM;

void create() {
  set("short", "海神当铺");
  set("long", @LONG
人有三急六穷,来这里的人,多数有点不好意思,江湖上的大
爷,那个不想过得风光呢,可是最近手气不好,没办法了,掀
开白底蓝字的布帘,看见的是须知(xuezhi)。
LONG
  );
  set("no_fight", 1);
  set("no_beg", 1);

  set("item_desc", ([
    "xuezhi": "公平交易\n",
  ]));
  set("objects", ([
    __DIR__ "npc/byw": 1, ]));
  set("exits", ([
    "west": __DIR__ "xroad2",
  ]));

  setup();
  replace_program(ROOM);
}
