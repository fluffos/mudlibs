inherit ROOM;

void create() {
  set("short", "花圃中心");
  set("long", @LONG
这是花圃的中心,四周的鲜花簇拥着你,周围有上百盆
类似苏铁的植物,里面静静的,中间点缀着几朵可爱的马蹄莲,
你却不会感到拥挤,空气带着些淡淡的花香在流动,尘世好象
离你远了,一切都显得是那么的没有重量.
LONG
  );

  set("exits", ([
    "northup": __DIR__ "huap3",



  ]));
  // set("objects", ([
  //             "/d/shenlong/npc/xuxuetin": 1,
  // ]));
  set("outdoors", "shenlong");
  setup();
  replace_program(ROOM);
}
