                "west" : __DIR__"road2",
    ]));
    set("objects", ([
                __DIR__"npc/boy": 1,
                __DIR__"npc/girl": 1,
    ]));
    set("outdoors", "shenlong");
    setup();
   replace_program(ROOM); }