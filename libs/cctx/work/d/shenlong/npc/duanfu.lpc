// duanfu.c 段福(dealer)

#include <ansi.h>

inherit PAWN;

void create() {
  set_name("段福", ({ "duan fu", "fu", "duan", "duanfu" }));
  set("title", "当铺老板");
  set("shen_type", 0);

  set("gender", "男性");
  set_max_encumbrance(100000000);
  set("age", 35);
  set("long",
    "据说段福是大理段氏的一个分支后代。\n");

  set("no_get_from", 1);
  set("no_get", 1);  //防止一个大bug

  set("str", 100);
  set_skill("unarmed", 90);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_temp("apply/attack", 130);
  set_temp("apply/attack", 130);
  set_temp("apply/damage", 115);

  set("combat_exp", 800000);
  set("attitude", "friendly");

  setup();
}
