#include <ansi.h>

inherit NPC;

void create() {
  set_name("神龙教老者", ({ "old man", "old", "man" }));
  set("long",
    "他虽然年纪已老，但是还是颇有几分年轻时的风采，不时背着手在想着什么\n"
    "然而神色郁郁,对一帮年轻男女颇为有礼,似乎害怕什么,样子十分可怜.\n");
  set("gender", "男性");
  set("attitude", "peaceful");

  set("age", 50 + random(50));
  set("shen_type", -1);
  set("str", 50 + random(10));
  set("dex", 50 + random(10));
  set("max_qi", 10000);
  set("max_jing", 5000);
  set("neili", 5000);
  set("max_neili", 5000);
  set("jiaji", 25 + random(25));
  set("combat_exp", 1000000 + random(1000000));

  set_skill("force", 180);
  set_skill("dodge", 180);
  set_skill("unarmed", 180);
  set_skill("parry", 180);
  set_skill("sword", 180);
  set("chat_chance", 1);
  set("chat_msg", ({
    "老者偷偷看了一眼旁边的弟子:真是年少轻狂，不知天高地厚!\n",
    "老者摇摇头说道:象许左使这样搞，怕我教会走向没落的\n",
    "老者看着蓝天说道:据说大劫之日，洪教主和苏夫人逃跑了!\n",
    "老者说道:中土人士对我们是越来越不满了\n",
  }));
  setup();
  carry_object("/d/shenlong/obj/xionghuang")->wield();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 50, ob);
  }
}

void greeting(object ob) {
  object obj;
  if (interactive(ob)) {
    if (obj = present("usedgao", ob))
      unconcious();
  }
  return;
}
