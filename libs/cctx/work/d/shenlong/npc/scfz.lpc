#include <ansi.h>
inherit NPC;
void create()
{
	set_name("商人", ({"shang ren","shan ren","ren"}));
	set("long",
	"这个个惯走海运的蔬菜商人,据说他很有些背膀，在黑白两道都很吃得开\n"
        "他正在忙着指挥着几个搬运小工在忙着为海船上菜，欢喜的神情一看就是又\n"
        "在上一次来回中赚了不少钱\n" );
	set("gender", "男性");
	set("attitude", "peaceful");
	set("age", 20+random(30));
	set("shen_type", -1);
	set("str", 20+random(150));
	set("dex", 20+random(110));
	set("max_qi", 10000);
	set("max_jing", 5000);
	set("neili", 5000);
	set("max_neili", 5000);
	set("jiaji", 25+random(25));
	set("combat_exp", 800000);
	set_skill("force", 200);
	set_skill("dodge", 200);
	set_skill("unarmed", 200);
	set_skill("parry", 200);
	set_skill("sword", 200);
set("chat_chance", 1);
       set("chat_msg", ({
"蔬菜贩子大声喝道:快点，快点，船要开了，没看见吗!\n",
"蔬菜贩子踢了搬运工一脚:再磨洋工，小心我把你扔到海里\n",
"蔬菜贩子说道:他妈的，这些小工用不成了，回京里换人吧\n",
"蔬菜贩子摇摇头说道:怪了，杨陵这小子，到扔到海里都没说去了那儿\n",
        })) ;
	setup();
	carry_object("/d/city/obj/duanjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
}


