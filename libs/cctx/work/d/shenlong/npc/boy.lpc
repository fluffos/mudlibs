#include <ansi.h>

inherit NPC;

void create() {
  set_name("年轻弟子", ({ "young boy", "boy", "young" }));
  set("title", "神龙教黄龙使座下弟子");
  set("long",
    "看起来神龙岛的弟子也不象传说中的可怕，他看起来还是有点帅\n"
  );

  set("gender", "男性");
  set("attitude", "peaceful");

  set("age", 10 + random(10));
  set("shen_type", -1);
  set("str", 50 + random(10));
  set("dex", 50 + random(10));
  set("max_qi", 1000);
  set("max_jing", 1050);
  set("neili", 2000);
  set("max_neili", 2000);
  set("jiaji", 5 + random(5));
  set("combat_exp", 200000 + random(100000));

  set_skill("force", 140);
  set_skill("dodge", 140);
  set_skill("unarmed", 140);
  set_skill("parry", 140);
  set_skill("sword", 160);
  set_skill("shedao-qigong", 130);
  map_skill("sword", "shedao-qigong");
  set("chat_chance", 1);
  set("chat_msg", ({
    "年轻弟子叹口气说道:我自小练武，厉经十载，何时才能出人头地\n",
    "年轻弟子对年轻弟子说道:据说大劫之日洪教主和苏筌逃跑了，你知道吗???\n",
  }));

  setup();
  carry_object("/d/shenlong/obj/xionghuang")->wield();
  carry_object("/d/city/obj/duanjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 10, ob);
  }
}

void greeting(object ob) {
  object obj;
  if (interactive(ob)) {
    if (obj = present("usedgao", ob))
      unconcious();
  }
  return;
}
