#include <ansi.h>
inherit NPC;
void create() {
  set_name("海盗", ({ "hai dao", "hai", "dao" }));
  set("long",
    "这是个在海上横行的海盗，杀人越货，无所不为\n"
    "目光粗野,也就是在神龙岛才收敛几分\n");
  set("gender", "男性");
  set("attitude", "peaceful");
  set("age", 10 + random(20));
  set("str", 20);
  set("dex", 20);
  set("max_qi", 300);
  set("max_jing", 300);
  set("neili", 300);
  set("max_neili", 300);
  set("combat_exp", 10000);
  set_skill("force", 50);
  set_skill("dodge", 50);
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("sword", 50);
  set("chat_chance", 1);
  set("chat_msg", ({
    "海盗哼着小曲：小寡妇呀，真漂亮\n",
    "海盗到处看看说道：神龙的小MM怎么不见了\n",
    "海盗哈哈大笑几声\n",
  }));
  setup();
}
