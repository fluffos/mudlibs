//yupiao.c
//write by 7*

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("鱼膘", ({ "yu piao", "piao" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是由鲸鱼的膘做成的装水的袋子,容量奇大。\n");
    set("unit", "个");
    set("value", 20000);
    set("max_liquid", 500);
  }

  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "alcohol",
    "name": "客家米酒",
    "remaining": 200,
    "drunk_apply": 10,
  ]));
}
