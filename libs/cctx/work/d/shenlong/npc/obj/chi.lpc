inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("水煮小翅", ({"pai chi", "chi"}));
        set_weight(300);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是海味因地制宜,用鲨鱼的小翅做的排翅,好香呀\n");
                set("unit", "碗");
                set("value", 10000);
                set("food_remaining", 10);
                set("food_supply", 500);
        }
}

