#include <ansi.h>
inherit NPC;
void create()
{
	set_name("搬运小工", ({"xiao gong","xiao","gong"}));
	set("title","码头工人");
	set("long",
	"这是个自幼家贫的小工，一看就过早的衰老了，脸被吹得又红又老。\n");
	set("gender", "男性");
	set("attitude", "peaceful");
	set("age", 10+random(10));
	set("shen_type", 1);
	set("str", 25+random(10));
	set("dex", 25+random(10));
	set("max_qi", 200);
	set("max_jing", 150);
	set("neili", 200);
	set("combat_exp", 500);
	set_skill("unarmed", 40);
set("chat_chance", 1);
        set("chat_msg", ({
"小工说道：不知孩子他妈今天病可有加重\n",
"小工说道：现在看病越来越贵了\n",
"小工说道：杨陵真是条好汉，被打得死去活来都没说\n"
        }) );
	setup();}

