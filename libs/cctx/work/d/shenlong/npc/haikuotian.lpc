inherit NPC;

void create()
{
	set_name("海阔天", ({ "haikuotian", "hai", "kuotian" }) );
	set("gender", "男性" );
	set("age", 30);
	set("long",
		"听说他就是当年一人一马杀过伏魔圈的好汉海阔天,不知为什么在这儿开起店来了\n");
	set("combat_exp", 200000);
	set("attitude", "friendly");
	set("rank_info/respect", "好汉");
	setup();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(2) ) {
		case 0:
			say( "海阔天从脖子里哼了一声" + RANK_D->query_respect(ob)
				+ "，不舒服就不要坐船。\n");
			break;
		case 1:
			say( "海阔天仰起脖子,灌了口茶,说道" + RANK_D->query_respect(ob)
				+ "，爱住不住,不住快走。\n");
			break;
	}
}

int accept_object(object who, object ob)
{
	
	if (ob->query("money_id") && ob->value() >= 20000) 
	{
		tell_object(who, "快点去挺尸,挺完了快出来。\n");

		who->set_temp("rent_paid",1);

		return 1;
	}

	return 0;
}
