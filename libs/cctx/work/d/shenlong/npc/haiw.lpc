// xian. 冼老板

inherit NPC;
void create() {
  set_name("海味", ({ "hai wei", "wei" }));
  set("title", "火锅店老板");
  set("shen_type", 1);

  set("str", 20);
  set("gender", "女性");
  set("age", 45);
  set("long", "她就是火锅店的女老板,据说做得一手好川味,这次来神龙不会呆太长时间。\n");
  set("combat_exp", 50000);
  set("qi", 300);
  set("max_qi", 300);
  set("attitude", "friendly");
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set("vendor_goods", ({
    __DIR__ "obj/yupiao",
    __DIR__ "obj/chi",
  }));

  setup();
  add_money("gold", 1);
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  //        add_action("do_list", "list");
  add_action("do_buy", "buy");
}
