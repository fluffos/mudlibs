
#include <ansi.h>

inherit NPC;

void create()
{
	set_name("年轻女弟子", ({"young girl","girl","young"}));
	set("title","神龙教赤龙使座下弟子");
	set("long",
	"长年的海风没有吹皱她的脸庞,可能是常吃海味，长得十分妩媚。\n"
	);

	set("gender", "女性");
	set("attitude", "peaceful");

	set("age", 10+random(10));
	set("shen_type", -1);
	set("str", 50+random(10));
	set("dex", 50+random(10));
	set("max_qi", 1000);
	set("max_jing", 1500);
	set("neili", 2000);
	set("max_neili", 2000);
	set("jiaji", 5+random(5));
	set("combat_exp", 200000+random(100000));

	set_skill("force", 140);
	set_skill("dodge", 140);
	set_skill("unarmed", 140);
	set_skill("parry", 140);
	set_skill("sword", 160);
	set_skill("shedao-qigong", 130);
	map_skill("sword","shedao-qigong");
set("chat_chance", 1);
        set("chat_msg", ({
"女弟子想着想着哭道:我一定要练成绝世武功，杀回中原!\n",
"女弟子擦干泪说道:那些所谓的名门正派，其实还不是男盗女娼!\n",
"女弟子看着蓝天说道:这一劫过后,不知我教的声望会如何!\n",
"女弟子悄悄说道:其实苏夫人对我们女弟子还是非常照顾的!\n",
        }) );

	setup();
	carry_object("/d/shenlong/obj/xionghuang")->wield();
        carry_object("/d/city/obj/duanjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver",5);
}

void init()
{
	object ob;

	::init();

	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 10, ob);
	}
}

void greeting(object ob)
{
	object obj;
        if (interactive(ob))
        {
	if (obj = present("usedgao", ob))          
		unconcious();
	}
	return;
}
