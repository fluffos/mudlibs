#include <ansi.h>

void create() {
  set_name("海斌", ({ "duan fu", "fu", "duan", "duanfu" }));
  set("title", "吃人不吐骨头");
  set("shen_type", 0);

  set("gender", "男性");
  set_max_encumbrance(100000000);
  set("age", 35);
  set("long",
    "面皮白净，说话慢声细气，常常亲切的笑着的一个老实人。\n");

  set("no_get_from", 1);
  set("no_get", 1);  //防止一个大bug

  set("str", 100);
  set_skill("unarmed", 90);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set_temp("apply/attack", 130);
  set_temp("apply/attack", 130);
  set_temp("apply/damage", 115);

  set("combat_exp", 800000);
  set("attitude", "friendly");

  setup();
}
