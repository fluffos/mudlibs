// longsword.c 长剑

#include <weapon.h>
inherit SWORD;

void create() {
  set_name("生铁长剑", ({ "changjian", "jian" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是神龙弟子专用的长剑,是托人从海外定做而来.\n");
    set("value", 1500);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(40);
  setup();
}
