inherit ITEM;

void create() {
  set_name("混元真经", ({ "hyyq book", "shu", "book" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是从最近下落不明的洪教主书房里找到的,谁也看它不懂。\n");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
      "name": "hunyuan-yiqi",  //name of the skill
      "exp_required": 100000,  //minimum combat experience required
      "jing_cost": 20,  // jing cost every time study this
      "difficulty": 20,  // the base int to learn this skill
      "max_skill": 1000  // the maximum level you can learn
    ]));
  }
}
