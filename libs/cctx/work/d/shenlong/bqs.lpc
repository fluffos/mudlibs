inherit ROOM;
int do_say(string arg);
void create()
{
        set("short", "武器库");
        set("long",@LONG
好多兵器呀,长的,短的,铁的,钢的,你看
得有点发呆,旁边的神龙弟子,拿起一件就走,
你也是赶快找件合手的兵器去练功吧.
LONG
        );
             set("objects",([
		__DIR__"obj/chanjian" : 2,
		__DIR__"obj/gangzh" : 2,
		
	]));
        set("exits", ([
                "southdown" : __DIR__"bqsroad2",
        ]));
        setup();
/*
        replace_program(ROOM);
*/
}
void init()
{
       add_action("do_say","say");
}
int do_say(string arg)
{

	if( !arg || arg=="" ) return 0;

	if( arg=="七星现身") 

	{
		write("一道铁门从壁上裂开来,。\n");
		message("vision", "天上有个声音说道,这儿离天堂只有一步了。\n", this_player());
		set("exits/enter", __DIR__"ms2");

		remove_call_out("close");
		call_out("close", 5, this_object());

		return 1;
	}
}

void close(object room)
{
	message("vision","咚咚两声轻响,铁门关上了。\n", room);
       room->delete("exits/enter");
}	





