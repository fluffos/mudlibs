inherit ROOM;

void create()

{
  set("short", "当铺");
  set("long", @LONG
这里是一个当铺，大理城中很多百姓都把自己不使用了的东西拿来
这里当掉，不过听说到了夜里后，有人曾听见当铺后院里传出呼救和哭
叫的声音，让这个当铺增添了些神秘感。墙上挂着顾客须知(note)。
LONG
  );
  set("exits", ([
    "west": __DIR__ "nanjie1",
  ]));
  set("no_fight", 1);
  set("objects", ([
    __DIR__ "npc/duanfu": 1,
  ]));
  set("item_desc", ([
    "note": @NOTE
用sell卖断身上的东西/用pawn典当身上的东西
用redeem列出典当了的东西并可以赎回！
NOTE
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
