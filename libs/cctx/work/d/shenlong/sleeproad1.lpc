
inherit ROOM;
void create()
{
	set("short", "小道");
	set("long", @LONG
前面是专门为刚下船来访的武林人士准备的修息室, 
因为坐了半天船,许多人可能会晕船,所以神龙弟子专门留 
出这间房子,以免大家难堪.这是一排小平房,前面有个棚子,
一个独眼黑脸的汉子端坐在棚子里的太师椅上一摇一摇的,
看见你进来,头也不抬的接着喝茶,听说他当年是有名的大海
盗----海阔天,他身后有个歪歪斜斜贴着的通知(tongzhi)。
LONG
	);
	set("no_fight", 1);
	set("valid_startroom", 1);
       set("no_sleep_room",1);
	set("item_desc", ([
		"tongzhi" : "教主有令,一床一人,铺费二百白银。\n",
	]));
	set("objects", ([
		__DIR__"npc/haikuotian" : 1,
	]));
	set("exits", ([
		"north" : __DIR__"matou",
		"south" : __DIR__"sleeproom",
	]));
	setup();
}
int valid_leave(object me, string dir)
{

	if ( !me->query_temp("rent_paid") && dir == "south" )
	return notify_fail("海阔天狠狠的盯着你,凶恶地说想找死是不是！\n");
	

}






	