

inherit ROOM;

void create()
{
	set("short", "大道");
	set("long", @LONG
	这是一条东西贯穿的石板道,这里已经进了神龙教的腹地了,
          虽然周围许多新修的建筑 ,  但还是有好几处没有打扫干净的
          地方,周围植了许多南方人称为金竹的植物,看起来人人都有
          事,这里北上是神龙弟子的兵器库,南下就是练功场了.
LONG
	);
        set("outdoors", "7");

	set("exits", ([
		"northeast" : __DIR__"road5",
		"southdown" : __DIR__"lgfroad1",
		"west" : __DIR__"damen",
		"northup" : __DIR__"bqsroad1",
	]));

	setup();
	replace_program(ROOM);
}

