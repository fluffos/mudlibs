#include <ansi.h>
inherit ROOM;


void create() {
  set("short", GRN "杨柳道" NOR);
  set("long", @LONG
你走在一条杨柳道上，两旁是青青的杨柳，随风摇摆。杜牧诗里赞到：
娉娉袅袅十三馀，豆蔻梢头二月初。春风十里扬州路，卷上珠帘总不如。
真是好一片扬州风光。

LONG
  );
  set("outdoors", "city");

  set("exits", ([
    "east": __DIR__ "yangliudao1",
    "west": __DIR__ "dongmen",
  ]));


  setup();
}
