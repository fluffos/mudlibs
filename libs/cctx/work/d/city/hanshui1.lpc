#include <ansi.h>
inherit ROOM;


void create() {
  set("short", HIW "运河杨州港" NOR);
  set("long", @LONG
面前是一条宽阔的河流(river)。江水静静的流淌,江面上许多船
只来来往往，有游山玩水的画舫，有渡客的小舟，有拉货运输的大船，
京城的许多奢侈品，皇宫的日常度用，都从这里络绎不绝的向北运，由
此运河，你可以免除车马之劳，舒舒服服的上京城去，也可到人间天堂
苏杭游乐一翻。
LONG
  );

  set("exits", ([
    "south": __DIR__ "yidao2",
    "west": "/d/gumu/gmroad1",
    "east": "/d/yunhe/matou2",
  ]));

  set("item_desc", ([
    "river": "这就是天下第一大运河，京杭大运河。由于这是南北交通\n"
    "的大动脉，河面上无论货船还是客船来来往往，非常热闹。\n",
  ]));

  set("outdoors", "city");
  setup();

}

int valid_leave(object me) {
  me->delete_temp("ok");
  me->delete_temp("ok1");
  me->delete_temp("zu");
  return ::valid_leave(me);

}
