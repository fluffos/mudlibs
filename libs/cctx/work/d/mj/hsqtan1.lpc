//HSQTAN1.C

inherit ROOM;

void create() {
  set("short", "瀑布");
  set("long", @LONG
这里是小河上的瀑布，水中幽暗无比，四周似乎有几处出口，但实在看
不清是通向何处。水中冰冷刺骨，令人难以忍受。
LONG
  );

  set("exits", ([
    "westup": __DIR__ "hongshui",

  ]));

  set("outdoors", "mingjiao");
  setup();
  //	replace_program(ROOM);
}

void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object me = this_player();
  if (!arg || arg == "") return 0;

  if (arg == "down") {

    if (me->query("jing", 1) <= 20) {
      write("你已经太累了，休息休息再跳吧。\n"); return 1;
    }
    if (me->query_skill("force", 1) > 70) {
      write("你就是再跳下去，对你也没有什么用了。\n"); return 1;
    }
    if (me->query_skill("force", 1) < 20) {
      write("你想跳进深潭里游泳，但那对于你来说似乎太难了。\n"); return 1;
    }
    message_vision("$N击破潭面的一处薄冰，一个纵身跳进了潭里。\n", me);
    me->improve_skill("force", 20);
    me->receive_damage("jing", 20);
    me->move("/d/mj/hsqtan2");
    return 1;
  }
}
