//gebitan3.c

inherit ROOM;

void create() {
  set("short", "沙丘");
  set("long", @LONG
眼前是一望无际的戈壁滩，没有路标，也没有一个行人，天
显得很高，远山披雪，苍鹰翱翔，走在这茫茫戈壁之上，你似乎
迷路了。
LONG
  );
  set("outdoors", "mingjiao");
  set("exits", ([
    "east": __DIR__ "gebitan1",
    "westup": __DIR__ "gebitan3",
    "northwest": __DIR__ "gebitan" + random(4),
    "southup": __DIR__ "gebitan" + random(4),
  ]));
  set("objects", ([
    "/d/mingjiao/obj/shigu": 3,
  ]));
  setup();
  replace_program(ROOM);
}
