inherit NPC;

inherit F_UNIQUE;

void create() {
  set_name("辉月使", ({ "huiyue shi", "huiyue", "shi", }));
  set("long",
    "圣火三使之一。\n"

  );
  set("title", "明教圣火使者");


  set("gender", "女性");

  //    set("class", "bonze");

  set("age", 44);
  set("shen_type", 1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 100);
  set("combat_exp", 1500000);
  set("score", 5000);

  set_skill("force", 200);
  set_skill("shenghuo-shengong", 200);
  set_skill("dodge", 200);
  set_skill("xiaoyao-bu", 200);
  set_skill("lingfa", 200);
  set_skill("shenghuo-lingfa", 200);
  set_skill("parry", 200);
  set_skill("literate", 200);
  set_skill("shenghuo-xinfa", 200);


  map_skill("force", "shenghuo-shengong");
  map_skill("dodge", "xiaoyao-bu");
  map_skill("lingfa", "shenghuo-lingfa");
  map_skill("parry", "shenghuo-lingfa");
  set("chat_chance", 500);
  set("chat_msg", ({
    (: exert_function, "recover" :),
    (: exert_function, "heal" :),
  }));
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "lingfa.duo" :),
  }));

  setup();

  carry_object("/d/mj/obj/baipao")->wear();
  carry_object("/d/mj/obj/shenghuo-ling")->wield();
}
