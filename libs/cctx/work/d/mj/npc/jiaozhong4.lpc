void create()
{
	set_name("教众", ({ "jiao zhong","zhong","jiao" }) );
	set("gender", "女性" );

	set("age", 35);
	set("long", "明教的教众。\n");
	set("title", "明教天微堂属下教众");
	set("shen_type",1);
	set("combat_exp", 300000);

	set("attitude", "peaceful");

	set("apply/attack", 50);
	set("apply/defense", 50);


	set_skill("unarmed", 50);
//	set_skill("blade", 20);
	set_skill("parry", 50);
	set_skill("dodge", 50);

	setup();
	carry_object("/d/mj/obj/baipao")->wear();
//        carry_object("/d/mingjiao/obj/mutang")->wield();

}

