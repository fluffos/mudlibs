  message_vision(YEL "\n只见$N骑两腿一夹，炎龙马向前急驰而去。\n" NOR, ob);
  ob->move("/d/mj/desert1");
  this_object()->move("/d/mj/desert1");
  message_vision(YEL "\n只见$N骑着炎龙马急奔而来。\n" NOR, ob);
  remove_call_out("lad4");
  call_out("lad4", 4, ob);
}
void lad4(object ob) {

  message_vision(YEL "\n只见$N骑两腿一夹，炎龙马向前急驰而去。\n" NOR, ob);
  ob->move("/d/mj/desert2");
  this_object()->move("/d/mj/desert2");
  message_vision(YEL "\n只见$N骑着炎龙马急奔而来。\n" NOR, ob);
  remove_call_out("lad5");
  call_out("lad5", 4, ob);
}
void lad5(object ob) {

  message_vision(YEL "\n只见$N骑两腿一夹，炎龙马向前急驰而去。\n" NOR, ob);
  ob->move("/d/mj/desert3");
  this_object()->move("/d/mj/desert3");
  message_vision(YEL "\n只见$N骑着炎龙马急奔而来。\n" NOR, ob);
  remove_call_out("lad6");
  call_out("lad6", 4, ob);
}
void lad6(object ob) {

  message_vision(YEL "\n只见$N骑两腿一夹，炎龙马向前急驰而去。\n" NOR, ob);
  ob->move("/d/mj/desert4");
  this_object()->move("/d/mj/desert4");
  message_vision(YEL "\n只见$N骑着炎龙马急奔而来。\n" NOR, ob);
  remove_call_out("lad7");
  call_out("lad7", 4, ob);
}
void lad7(object ob) {

  message_vision("\n只见$N骑两腿一夹，炎龙马向前急驰而去。\n", ob);
  ob->move("/d/mj/bos");
  this_object()->move("/d/mj/bos");
  message_vision("\n只见$N骑着炎龙马急奔而来。\n", ob);
  message_vision("\n只见炎龙马口吐白沫，眼看是不行了。\n", ob);
  this_object()->unconcious();
  this_object()->die();
  delete("rider");
  ob->delete_temp("onhorse");
  ob->delete_temp("marks/令");
  command("follow none");
}
