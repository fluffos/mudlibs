#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;
void lad1(object);
void lad2(object);
void lad3(object);
void lad4(object);
void lad5(object);
void lad6(object);
void lad7(object);
void create() {
  set_name(HIR "炎龙马" NOR, ({ "yan long ma", "yan", "ma" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 2 + random(3));
  set("long", "这是一匹炎龙宝马，日行千里，夜行八百。\n");
  set("int", 30);
  set("qi", 300);
  set("max_qi", 300);
  set("jing", 100);
  set("max_jing", 100);
  set("shen_type", 0);
  set("combat_exp", 50000);
  set("attitude", "peaceful");
  set("food", 5000);
  set("water", 5000);
  set("chat_chance", 6);
  set("chat_msg", ({
    (: this_object(), "random_move" :),
    "炎龙马用鼻子闻了闻你的脚。\n",
    "炎龙马在你的身边挨挨擦擦的，很亲昵的样子。\n",
    "炎龙马对著你摇了摇尾巴。\n",
    "炎龙马用後腿踢了踢脚下的砂土。\n" }));
  set("limbs", ({ "头部", "腹部", "尾巴", "后腿", "前腿" }));
  set("verbs", ({ "bite", "hoof", "knock" }));
  set_temp("apply/attack", 50);
  set_temp("apply/armor", 15);
  set_temp("apply/damage", 25);

  setup();
}

void init() {
  add_action("do_ride", "ride");
  add_action("do_go", "go");
  add_action("do_down", "down");
}


int do_ride() {
  string dir, dir2;
  object ob = this_player();
  if (!this_player()->query_temp("marks/令") || this_player()->query("combat_exp") < 20000) {
    message_vision("$N一跃身跨上了炎龙马。只见炎龙马仰天长啸，突然猛然一颠......\n"
      HIR "把$N狠狠摔在了地上,结果$N受了点轻伤。\n" NOR, ob);
    ob->receive_damage("qi", 50);
    ob->receive_wound("qi", 50);
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
    return 1;
  }
  if (objectp(query("rider"))) {
    return notify_fail("现在马上已经有人了！\n");
  } else {
    ob->set_temp("onhorse", 1);
    this_object()->set("rider", this_player());
    message_vision("$N一跃身跨上了炎龙马。\n", ob);
    this_object()->set_leader(this_player());
    command("follow " + ob->query("id"));

    return 1;
  }
}

int do_down() {
  object ob;
  ob = this_player();
  if (!objectp(query("rider"))) return notify_fail("马上没人。\n");
  if (ob->query_temp("onhorse")) {
    message_vision("\n$N身行一转，跃下马来，姿态十分优美。\n", ob);
    delete("rider");
    command("follow none");
    ob->delete_temp("onhorse");
  } else
    switch (random(3)) {
      case 0:
        message_vision("\n$N一把把马上的人拉下来，想自己跳上去。\n", ob);
        command("follow none");
        query("rider")->delete_temp("onhorse");
        delete("rider");
        ob->set_temp("onhorse");
        break;
      case 1:
      case 2:
        message_vision("\n$N想把马上的人拉下马来,但没有成功。\n", ob);
    }
  return 1;
}

int do_go(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg == "") return notify_fail("你要去哪儿？\n");
  if (!ob->query_temp("onhorse")) return notify_fail("你还没上马。\n");
  if (arg == "波斯" && ob->query_temp("onhorse")) {
    message_vision(HIY "\n炎龙马仰天长嘶一声，载着$N飞驰而去。\n" NOR, ob);
    call_out("lad1", 4, ob);
    return 1;
  }

  return notify_fail("你要去哪里？\n");
}
void lad1(object ob) {

  message_vision(YEL "\n只见$N骑两腿一夹，炎龙马向前急驰而去。\n" NOR, ob);
  ob->move("/d/mj/road1");
  this_object()->move("/d/mj/road1");
  message_vision(YEL "\n只见$N骑着炎龙马急奔而来。\n" NOR, ob);
  remove_call_out("lad2");
  call_out("lad2", 4, ob);
}
void lad2(object ob) {

  message_vision(YEL "\n只见$N骑两腿一夹，炎龙马向前急驰而去。\n" NOR, ob);
  ob->move("/d/mj/shanjiao");
  this_object()->move("/d/mj/shanjiao");
  message_vision(YEL "\n只见$N骑着炎龙马急奔而来。\n" NOR, ob);
  remove_call_out("lad3");
  call_out("lad3", 4, ob);
}
