// d/wudang/npc/xiaocui.c
// By Marz 04/01/96
#include <ansi.h>
#include <command.h>
#include <login.h>
inherit NPC;

int ask_me();
int ask_water();

void create() {
  set_name("伺茶小僮", ({ "xiao tong", "xiao", "tong" }));
  set("gender", "女性");
  set("age", 12 + random(6));
  set("long",

    "一脸聪明乖巧，满口伶牙俐齿。见有人稍微示意，便过去加茶倒水。\n");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("title", "明教伺茶小僮");
  set("str", 20);
  set("int", 28);
  set("con", 24);
  set("dex", 20);

  set("max_qi", 150);
  set("max_jing", 100);
  set("neili", 150);
  set("max_neili", 150);

  set("combat_exp", 1000 + random(800));
  set("score", 1000);

  set_skill("force", 30);
  set_skill("dodge", 20);
  set_skill("unarmed", 15 + random(10));
  set_skill("parry", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 15);
  set_temp("apply/damage", 3);

  set("inquiry", ([
    "食物": (: ask_me :),
    "茶": (: ask_water :),
  ]));

  setup();

  //		carry_object("/d/wudang/obj/greenrobe")->wear();
  //		carry_object("/d/city/obj/necklace");
}




int ask_me(object who) {

  object obn;
  who = this_player();
  obn = new(__DIR__ "/obj/ruo");


  if ((int)who->query("food") >= (int)who->query("max_food"))
    return ("你吃饱了还想要啊？\n");
  //else if(objectp(present("rou", environment(who))))
  //return notify_fail("那不是有吗？吃了再说吧。\n");

  else obn->move(environment(who));
  message_vision("小僮拿出些白面馒头，放在桌上．\n",
    who);



  return 1;
}
