inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

void create() {
  set_name("殷野王", ({ "yin yewang", "yin", "yewang", }));
  set("long",
    "他是一位手摇折扇的中年男子，身穿一件白布长袍。\n"
    "他是白眉鹰王殷天正之子。一双眼睛犹如冷电，精光四射，气势摄人。\n"
  );
  set("title", "明教天微堂堂主");

  set("nickname", "一飞冲天");
  set("gender", "男性");
  set("attitude", "friendly");
  //    set("class", "bonze");

  set("age", 34);
  set("shen_type", 1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 100);
  set("combat_exp", 500000);
  set("score", 5000);

  set_skill("force", 85);
  set_skill("shenghuo-shengong", 85);
  set_skill("dodge", 85);
  set_skill("xiaoyao-bu", 85);
  set_skill("hand", 95);
  set_skill("yingzhua-shou", 95);
  set_skill("parry", 85);
  set_skill("literate", 85);
  set_skill("shenghuo-xinfa", 85);


  map_skill("force", "shenghuo-shengong");
  map_skill("dodge", "xiaoyao-bu");
  map_skill("hand", "yingzhua-shou");
  map_skill("parry", "yingzhua-shou");

  prepare_skill("hand", "yingzhua-shou");

  create_family("明教", 3, "天微堂堂主");
  set("chat_chance", 500);
  set("chat_msg", ({
    (: exert_function, "recover" :),
    (: exert_function, "heal" :),
  }));
  set("chat_chance_combat", 500);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
  }));
  setup();

  carry_object("/d/mj/obj/baipao")->wear();
}

void attempt_apprentice(object ob) {

  if ((int)ob->query("shen") < 0) {
    command("say 你应当多作些行侠仗义的事，以修身心。");
    return 0;
  }
  command("recruit " + ob->query("id"));
  ob->set("title", "明教天微堂属下教众");
  command("say 好，我就收下你这位好兄弟");
  command("say 我明教又得一栋梁之才！");
  command("haha ");
  return;
}
