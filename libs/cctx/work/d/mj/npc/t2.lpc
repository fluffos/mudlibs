// baoxiang.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void greeting(object);
void init();

string ask_me();
string ask_cha();

void create()
{
	set_name("伺茶小僮", ({"xiao tong", "xiao","tong"}) );
	set("gender", "女性" );
	set("age", 12+random(6));
	set("long",
	  
	  "一脸聪明乖巧，满口伶牙俐齿。见有人稍微示意，便过去加茶倒水。\n");
	set("attitude", "friendly");
    set("shen_type", 1);
        set("title","明教伺茶小僮");
        set("str", 20);
        set("int", 28);
        set("con", 24);
        set("dex", 20);

        set("max_qi", 150);
        set("max_jing", 100);
        set("neili", 150);
        set("max_neili", 150);

		set("combat_exp", 1000+random(800));
        set("score", 1000);

        set_skill("force", 30);
        set_skill("dodge", 20);
        set_skill("unarmed", 15+random(10));
        set_skill("parry", 20);
        set_temp("apply/attack", 10);
        set_temp("apply/defense", 15);
        set_temp("apply/damage", 3);

	set("inquiry", ([
		"食物"       : (: ask_me :),
		"茶"           : (: ask_cha :),
	]));

        setup();
        
	carry_object("/d/mj/obj/baipao")->wear();
//		carry_object("/d/city/obj/necklace");
}
void init()
{	
	object ob;

	::init();

	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;

	say("小僮笑吟吟地说道：这位" + RANK_D->query_respect(ob)
	     + "请先入座，" + "我这就给您上茶。\n");
}



string ask_me()
{

        object ob;
	object me=this_player();
        if(present("mantou",environment(me))||present("mantou",me))
		return ("那不是有吗？吃了再说吧。\n");
	if ( (int)me->query("food") >= (int)me->max_food_capacity() ) 
                 return ("你怎么吃饱了还想要啊？\n");
        ob = new("/d/mj/npc/obj/mantou");
        ob->move(environment(me));
        return "这里有些白面馒头，别着急慢慢吃哟！";
}
string ask_cha()
{
        object ob;
	object me=this_player();
        if(present("wan",environment(me))||present("wan",me))
		return ("那不是有吗？吃了再说吧。\n");
	if ( (int)me->query("water") >= (int)me->max_water_capacity() ) 
                 return ("你怎么喝足了还想要啊？\n");
        ob = new("/d/mj/npc/obj/wan");
        ob->move(environment(me));
        return "这里有些热茶，别着急慢慢喝哟！";
}

