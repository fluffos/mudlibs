// shenghuo-ling
// by netkill 98-10-01
//超频

#include <weapon.h>
#include <ansi.h>

inherit LINGFA;
//inherit BLADE;

void create() {
  set_name(HIW "圣" HIR "火" HIW "令" NOR, ({ "shenghuo-ling" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "这是一只明教的圣物----圣火令。\n");
    set("value", 1000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一只$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");

  }
  init_lingfa(500);

  setup();
}


void init() {
  if (this_player() == environment())
    add_action("do_study", "study");
}


int do_study(string arg) {
  object me = this_player();
  int tag, i_jing;
  tag = ((int)me->query_skill("literate", 1) / 5 +
    (int)me->query_skill("shenghuo-xinfa", 1)) / 2;
  i_jing = 600 / (int)me->query_int();

  if (!arg || arg == "") return 0;
  if (arg == "shenghuo-ling") {
    if ((int)me->query_int() < 30)
      return notify_fail("你的领悟力不够，无法领会圣火令上高深武功\n");
    if ((int)me->query_skill("shenghuo-xinfa", 1) < 60)
      return notify_fail("你的圣火心法火侯不够，学不了圣火令法\n");
    message_vision("$N拿着圣火令仔细研究\n", me);
    me->improve_skill("lingfa", tag);
    me->receive_damage("jing", i_jing);
  } else return 0;
  return 1;
}
