// dawancha.c 粗磁大碗
// By Marz 03/29/96

inherit ITEM;
void create() {
  set_name("茶碗", ({ "wan" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个茶碗。\n");
    set("unit", "个");
    set("value", 0);

    set("wtr_count", 3);
  }

  // because a container can contain different liquid
  // we set it to contain tea at the beginning

}
void init() {
  add_action("do_drink", "drink");
}
int do_drink(string arg) {
  object me;
  me = this_player();
  if (!arg || arg == "")
    return notify_fail("你要喝什么？\n");
  if ((int)this_player()->query("water") >= (int)this_player()->max_water_capacity())
    return notify_fail("你已经喝得太饱了。\n");
  if (arg == "wan" && query("wtr_count") < 0) {
    destruct(this_object());
    return 0;
  }
  if (arg == "wan" && query("wtr_count") >= 0) {
    message_vision("$N端起细瓷茶碗咕噜咕噜喝了几口清茶。\n", me);
    this_player()->add("water", 15);
    add("wtr_count", -1);
    return 1;
  }
  return 0;
}
