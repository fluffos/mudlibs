// WeiYiXiao.c	韦一笑
// inca	98/10/01

#include "ansi.h"

inherit NPC;
inherit F_MASTER;
//inherit F_UNIQUE;

void create() {
  set_name("韦一笑", ({ "wei yixiao", "wei", "yixiao", }));
  set("long",
    "他是明教四大护教法王之青翼蝠王，他脸形瘦削，脸色灰扑扑的\n"
    "一双眼睛冷冰冰的，让人感到一阵阵寒意。\n"
  );

  set("title", HIG "明教" HIC "青翼蝠王" NOR);
  set("gender", "男性");
  set("attitude", "peaceful");

  set("age", 48);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 3000);
  set("max_jing", 1500);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 150);
  set("combat_exp", 700000);
  set("score", 100000);

  set_skill("force", 120);
  set_skill("dodge", 200);
  set_skill("strike", 180);
  set_skill("parry", 150);
  set_skill("qingfu-shenfa", 250);
  set_skill("hanbing-mianzhang", 180);
  set_skill("literate", 100);

  map_skill("force", "shenghuo-shengong");
  map_skill("dodge", "qingfu-shenfa");
  map_skill("strike", "hanbing-mianzhang");
  map_skill("parry", "hanbing-mianzhang");

  prepare_skill("strike", "hanbing-mianzhang");

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: command("perform xixueqingfu") :),
  }));

  setup();

  carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init() {
  object me, ob;
  me = this_object();
  ob = this_player();

  ::init();

  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, me, ob);
  }
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("dodge", 1) < 100) {
    command("say 学我的功夫，首先轻功要好，$N是否应该在轻功上多下点工夫。");
    return;
  }
  if ((int)ob->query_skill("shenghuo-shengong", 1) < 60) {
    command(" say 你的圣火神功太低了，学不了我的武功 ");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
  ob->set("title", HIW "明教护教法王座下弟子" NOR);

}

