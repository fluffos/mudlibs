#include <ansi.h>

inherit NPC;

void create() {
  set_name("老虎", ({ "lao hu", "lao", "hu", "tigger" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 2 + random(3));
  set("long", "掉睛白额大虫。\n");
  set("int", 30);
  set("qi", 300);
  set("max_qi", 300);
  set("jing", 100);
  set("max_jing", 100);
  set("shen_type", 0);
  set("combat_exp", 20000);
  set("attitude", "peaceful");
  set("food", 5000);
  set("water", 5000);

  set("limbs", ({ "头部", "腹部", "尾巴", "后腿", "前腿" }));
  set("verbs", ({ "bite", "hoof", "knock" }));
  set_temp("apply/attack", 50);
  set_temp("apply/armor", 15);
  set_temp("apply/damage", 25);

  setup();
}

void init() {
  object ob;


  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {


    remove_call_out("do_killing");
    call_out("do_killing", 1, ob);

  }
}
void do_killing(object ob) {
  if (!ob || environment(ob) != environment())
    return;

  this_object()->kill_ob(ob);
}
