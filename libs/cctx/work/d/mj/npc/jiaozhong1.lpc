// menwei1.c

inherit NPC;
//string inquiry_dao();


void create()
{
	set_name("教众", ({ "jiao zhong","zhong","jiao" }) );
	set("gender", "男性" );

	set("age", 35);
	set("long", "明教的教众。\n");
	set("title", "明教护教教众");
	set("shen_type",1);
	set("combat_exp", 300000);

	set("attitude", "peaceful");

	set("apply/attack", 50);
	set("apply/defense", 50);


	set_skill("unarmed", 50);
//	set_skill("blade", 20);
	set_skill("parry", 50);
	set_skill("dodge", 50);

	setup();
	carry_object("/d/mj/obj/baipao")->wear();
//        carry_object("/d/mingjiao/obj/mutang")->wield();

}
void init()
{
        object ob;
        mapping myfam;
        
        ::init();
        if (interactive(ob = this_player()) && !is_fighting()) {
                myfam = (mapping)ob->query("family");
                if ((!myfam || myfam["family_name"] != "明教") ) {
		        
                        remove_call_out("do_killing");
                        call_out("do_killing",4,ob);
                }
        }
}
void do_killing(object ob)
{
	if (!ob || environment(ob) != environment())
                return;
	command("say " + RANK_D->query_rude(ob)+"竟敢跑到光明顶来撒野，受死吧！");
        this_object()->kill_ob(ob);
}