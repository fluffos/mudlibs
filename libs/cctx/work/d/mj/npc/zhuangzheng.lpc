// ZhuangZheng.c
// pal 1997.05.11

inherit NPC;

inherit F_UNIQUE;
int ask_me();
void create()
{
    set_name("庄铮", ({ "zhuang zheng", "zhuang", "zheng", }));
	set("long",
        "他是一位高大魁伟的中年男子，身穿一件白布长袍。\n"
        "他天生神力，手中的两头狼牙棒有万夫不当之勇，真是一条威风凛凛的汉子。\n"
	);

    set("title", "锐金旗掌旗使");
	set("gender", "男性");
	set("attitude", "friendly");
//    set("class", "bonze");

    set("age", 42);
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("max_qi", 1000);
	set("max_jing", 1000);
	set("neili", 1000);
	set("max_neili", 1000);
	set("jiali", 100);
	set("combat_exp", 100000);
	set("score", 5000);

	set_skill("force", 85);
	set_skill("hunyuan-yiqi", 85);
	set_skill("dodge", 85);
	set_skill("shaolin-shenfa", 85);
	set_skill("cuff", 95);
	set_skill("jingang-quan", 95);
	set_skill("parry", 85);
	set_skill("buddhism", 85);
	set_skill("literate", 85);

	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("cuff", "jingang-quan");
	map_skill("parry", "jingang-quan");

	prepare_skill("cuff", "jingang-quan");

        set("inquiry", ([
		"打铁" : (: ask_me :),
	
        ]) );
	set("hammer_count", 10);
	setup();

    carry_object("/d/mj/obj/langyabang")->wield();
	carry_object("/d/mj/obj/baipao")->wear();
}

void init()
{
        object ob;
        mapping myfam;
        
        ::init();
        if (interactive(ob = this_player()) && !is_fighting()) {
                myfam = (mapping)ob->query("family");
                if ((!myfam || myfam["family_name"] != "明教") ) {
		 
                        remove_call_out("do_killing");
                        call_out("do_killing",4,ob);
                }
        }
}
void do_killing(object ob)
{
	if (!ob || environment(ob) != environment())
                return;
       command("consider " +ob->query("id") );
        this_object()->kill_ob(ob);
}
int ask_me()
{	object obj,me;
	me=this_player();
	if(query("hammer_count") <0 ) 
	{
		 command("say "+"我这里没铁锤了。");
		command("shrug "+me->query("id") );
	return 1;
	}
      	if ( this_player()->query_temp("marks/打铁") ) {
	    command("say "+"你不是刚刚才问过吗？");return 1;
	}
	else {  
		
		command("pat "+me->query("id") );
		command("say "+"好好干。");
	obj = new("/d/mj/obj/tiechui");
        obj->move(me);
	add("hammer_count", -1);
		write("庄铮交给你一个大铁锤。\n");
		
		this_player()->set_temp("marks/打铁", 1);return 1;
	}
	
}