//room: /d/mingjiao/dadian.c
inherit ROOM;
#include <ansi.h>
void init();

void create()
{
        set("short",HIW"玉阶"NOR);
        set("long", @LONG
这里是由汉白玉逐级修建而成的石梯，南北是一条豁然贯通的长廊，
向西是一间小小的厅堂，向东沿阶而上是后厅。
LONG
           );
	set("outdoors", "mingjiao");
        set("exits",([
            "south" : __DIR__"llang3",
            "north" : __DIR__"llang2",
            "west" : __DIR__"xiaoting3",
            "eastup" : __DIR__"houting",
           ]));
        set("objects",([
		__DIR__"npc/zhangzhong":1,
			]));
        setup();
}
int valid_leave(object me, string dir)
{	
        if(dir == "west" &&  !this_player()->query_temp("marks/挪移") ){
       
            return notify_fail(YEL"那是明教的重地，闲杂人不能乱闯的。\n"NOR);
	}


	
    return ::valid_leave(me, dir);
}