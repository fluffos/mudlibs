//JMQJIGUAN.C

inherit ROOM;

void create() {
  set("short", "巨木旗");
  set("long", @LONG
你眼前只见一棵大树，高有百丈，十人也环抱不住。巨树倚绝壁而
生，枝叶繁茂，藤萝环绕，竟然无法一览全貌。树身有一处光滑无比，
是常有人摩挲而成。为旗中弟子平时练功之用。旗中不但有许多力大如
牛的武林高手，更有许多能工巧匠。光明顶的宏大的建筑就是出自本旗
之手。因为光明顶处在高出，所以这里是光明顶的第一道防线，当真有
一夫当关万夫莫开之势。东面是一片阴森的大树林。
LONG
  );

  set("exits", ([
    "east": __DIR__ "jmqshulin1",
    "west": __DIR__ "zongtan",
  ]));
  set("objects", ([
    __DIR__ "npc/jiaozhong1": 4,
    __DIR__ "npc/wensong": 1,
  ]));

  set("outdoors", "mingjiao");
  setup();
  //	replace_program(ROOM);
}
