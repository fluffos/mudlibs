void init();

void create()
{
        set("short",HIR"明教光明顶"NOR);
        set("long", 
"这里就是明教光明顶。你走到这里，可看见三个黄金色大字。明\n"+
"教，少林，丐帮中明教是最大的教，少林是最大的门派，而丐帮则是\n"+
"最大帮派。明教自由波斯总教传至中原已有一百多年的历史了。明教\n"+
"始终都以反元抗胡，行善去恶，除暴安良为自已的宗旨，但由于明教\n"+
"太大，门下教众难免莨莠不齐，至使被名门正派称为魔教。正中央坐\n"+
"一面红色火焰的大旗。\n\n\n"+
HIR"                         光    明    顶\n\n"NOR

           );

        set("exits",([
//            "southdown" : __DIR__"gmding",
//            "north" : __DIR__"llang4",
            "westdown" : __DIR__"zongtan",
            "northup" : __DIR__"ysdating",
           ]));

        set("objects",([
		__DIR__"npc/jiaozhong1":2,
		__DIR__"npc/jiaozhong2":2,
		"/kungfu/class/mingjiao/yintianzheng":1,
			]));
        setup();
}
