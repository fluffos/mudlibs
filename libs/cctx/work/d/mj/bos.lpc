
inherit ROOM;
#include <ansi.h>


void create()
{
        set("short",HIR"波斯明教总坛"NOR);
        set("long", 
"这里就是波斯明教总坛。你走到这里，可看见三个黄金色大字。明\n"+
"教，少林，丐帮中明教是最大的教，少林是最大的门派，而丐帮则是\n"+
"最大帮派。明教自由波斯总教传至中原已有一百多年的历史了。明教\n"+
"始终都以反元抗胡，行善去恶，除暴安良为自已的宗旨，但由于明教\n"+
"太大，门下教众难免莨莠不齐，至使被名门正派称为魔教。正中央坐\n"+
"一面红色火焰的大旗。\n\n\n"+
HIR"                     波  斯  明  教  总  坛\n\n"NOR

           );
set("outdoors", "mingjiao");
        set("exits",([
            "southdown" : __DIR__"desert4",

           ]));
        set("objects",([
		__DIR__"npc/huiyue":1,
		__DIR__"npc/liuyun":1,
		__DIR__"npc/miaofeng":1,
			]));
        setup();
}
