#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", YEL "密道大厅" NOR);
  set("long", @LONG 
走进这里，你不有惊讶不已，在密道中竟有如此宽敞的大厅，四周
墙上几十盏油灯将这里照的如同白昼，明教四周盛产石油，用来点灯最
好不过，由于厚土旗的设计巧妙，这些灯点了几十年还未熄灭。中间有
一个大石台，中间凹了进去，显然有许多人在上面打坐过。这里四壁都
是精铁浇注而成，有八个出口依八卦而布，甚是玄妙。看来如果找不到
出口，休想离开这里。 
LONG
  );

  set("exits", ([
    "west": __DIR__ "md1",
    "east": __DIR__ "md2",
    "south": __DIR__ "md3",
    "north": __DIR__ "md4",
    "southwest": __DIR__ "md5",
    "southeast": __DIR__ "md6",
    "northwest": __DIR__ "md7",
    "northeast": __DIR__ "md11",
    "southdown": __DIR__ "xiaomishi",
  ]));

  setup();

  create_door("southdown", "小石门", "northup", DOOR_CLOSED);


}
