//gebitan2.c

inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "戈壁滩");
  set("long", @LONG
眼前是一望无际的戈壁滩，没有路标，也没有一个行人，天
显得很高，远山披雪，苍鹰翱翔，走在这茫茫戈壁之上，你似乎
迷路了。
LONG
  );
  set("outdoors", "mingjiao");
  set("exits", ([
    "east": __DIR__ "desert0",
    "west": __DIR__ "desert2",
    "northeast": __DIR__ "desert" + random(4),
    "southeast": __DIR__ "desert" + random(4),
  ]));
  setup();
  replace_program(ROOM);
}
void init() {
  object ob = this_player();

  if (random((int)ob->query_skill("force", 1)) < 100) {
    message_vision(HIR "\n只见平地里刮起一阵狂风，沙丘上的沙被卷得满天乱飞。\n" NOR, ob);
    ob->add("water", -20); ob->add("jing", -10);
  }
  if (ob->query("water") < 0) ob->unconcious();
}
