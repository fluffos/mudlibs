//room: /d/mingjiao/dadian.c
inherit ROOM;
#include <ansi.h>


void create() {
  set("short", HIY "假山" NOR);
  set("long", @LONG
这里是圣火堂后院的一处假山，院子不大，但假山怪石嶙峋，千奇百怪，
上面似乎经常有人走动，所以假山表面好像十分光滑，南面是圣火堂。
LONG
  );
  set("exits", ([
    "south": __DIR__ "shtang",
    //            "north" : __DIR__"shtang",
    //            "west" : __DIR__"dadian",
    //            "east" : __DIR__"shiwu",
  ]));

  setup();
}
void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object me = this_player();
  if (!arg || arg == "") return 0;

  if (arg == "jiashan") {

    if (me->query("jing", 1) <= 20) {
      write("你已经太累了，休息休息再跳吧。\n"); return 1;
    }
    if (me->query_skill("dodge", 1) > 70) {
      write("你就是再跳下去，对你也没有什么用了。\n"); return 1;
    }
    if (me->query_skill("dodge", 1) < 20) {
      write("你想在假山上跳跳，但那对于你来说似乎太难了。\n"); return 1;
    }
    message_vision("$N在嶙峋的假山上腾挪闪转，不断跳跃。\n", me);
    me->improve_skill("dodge", 20);
    me->receive_damage("jing", 20);
    return 1;
  }
}
