//room: /d/mingjiao/dadian.c
inherit ROOM;
#include <ansi.h>
void init();

void create()
{
        set("short",HIR"锐金旗"NOR);
        set("long", @LONG
这里是锐金旗所在地，明教的机关武器，都出自锐金旗之手。旗下弟子
不但武功卓越，更是一等一的暗器高手，屋内堆满各类兵器防具，正中央一
只巨大火炉，奇热难当。
LONG
           );
        set("exits",([
            "up" : __DIR__"rjqmenlou1",
            "north" : __DIR__"lw3",
            "west" : __DIR__"eastroom",
            "east" : __DIR__"hongshui",
           ]));
        set("objects",([
		__DIR__"npc/jiaozhong1":2,
		__DIR__"npc/jiaozhong2":2,
		__DIR__"npc/zhuangzheng":1,
			]));
        setup();
}
void init()
{
	add_action("do_da", "da");
}

int do_da(string arg)
{
        object me=this_player();
        if (!arg || arg == "") return 0;

        if ( arg == "tie" )
        {
         
	if ( me->query("jing",1)<=20) {
		write("你已经太累了，休息休息再打吧。\n");return 1;}
	if ( me->query_skill("parry",1) > 70) {
		write("你就是再打下去，对你也没有什么用了。\n");return 1;}
	if(!present("tiechui",me)){
		write("你没有工具怎么打铁？\n");return 1;}
	message_vision("$N认真的打铁。\n",me);
         me->improve_skill("parry", 20);
         me->receive_damage("jing",20);
	return 1;
        }
}
