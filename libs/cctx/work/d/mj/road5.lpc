//room: /d/mingjiao/dadian.c
inherit ROOM;
#include <ansi.h>
void init();

void create() {
  set("short", HIR "山路" NOR);
  set("long", @LONG
这里是一大片的森林，一条曲折的小路穿越其间。这里已没有上山的深崖
峭壁的危险，地势已较为平坦。但林木高耸云间，又别有一番阴森可怕。两边
的林木笔直的生长着，很有规律，是几百年前明教老祖们开辟光明顶时所植。
虽是人为所植，但历时年代已久，有很多的飞鸟猛兽出入其间。树梢间积着十
分厚的积雪，其景十分壮观。
LONG
  );
  set("outdoors", "mingjiao");
  set("exits", ([
    //            "southdown" : __DIR__"gmding",
    "northup": __DIR__ "road4",
    "eastdown": __DIR__ "road6",
    //            "eastup" : __DIR__"gmding",
  ]));
  set("objects", ([
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "northup") {
    if (me->query("qi") <= 10) {
      write(YEL "你爬山爬得很累了，歇歇再走吧。\n\n" NOR, me);

    }
    me->add("qi", -10);
  }

  return ::valid_leave(me, dir);
}
