//room: /d/mingjiao/dadian.c
inherit ROOM;

void init();

void create() {
  set("short", "餐房");
  set("long", @LONG
这里是间收拾整齐的餐房，四周是整齐的古木家具，是明教弟子用膳所在。
LONG
  );

  set("no_fight", 1);
  set("valid_startroom", 1);
  set("exits", ([
    //            "northwest" : __DIR__"shenshe",
    "west": __DIR__ "xiaoting2",
    //            "north" : __DIR__"qinglong",
    //            "east" : __DIR__"eatroom",
  ]));
  set("objects", ([
    __DIR__ "npc/t2.lpc": 1,
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "west" && present("wan", me)) {
    if (objectp(present("xiao tong", environment(me))))
      return notify_fail("小僮伸手拦住你说道：教主吩咐，饮水不得带出茶室。\n"
        +RANK_D->query_respect(me) + "请好自为之，免得自讨没趣。\n");
  }
  if (dir == "west" && present("mantou", me)) {
    if (objectp(present("xiao tong", environment(me))))
      return notify_fail("小僮伸手拦住你说道：教主吩咐，食物不得带出茶室。\n"
        +RANK_D->query_respect(me) + "请好自为之，免得自讨没趣。\n");
  }


  return ::valid_leave(me, dir);
}
