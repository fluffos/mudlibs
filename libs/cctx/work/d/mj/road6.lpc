//room: /d/mingjiao/dadian.c
inherit ROOM;
#include <ansi.h>


void create()
{
        set("short",HIR"山路"NOR);
        set("long", @LONG
这是一条一窄又陡的山路，山路两旁长着又高又杂的乱草杂树，几没人头，
偶尔会有几枝荆棘挡住你的去路，一不小心则会被其刺伤。
LONG
           );
set("outdoors", "mingjiao");
        set("exits",([
//            "southdown" : __DIR__"gmding",
            "west" : __DIR__"road7",
            "westup" : __DIR__"road5",
//            "eastup" : __DIR__"gmding",
           ]));
        set("objects",([
"/d/huashan/npc/youke":2,
			]));
        setup();
}
int valid_leave(object me, string dir)
{	if (dir == "westup" )  {
        if (me->query("qi")<=10) 
	{
		write(YEL"你爬山爬得很累了，歇歇再走吧。\n\n"NOR, me);
	
	}
	me->add("qi",-10);
	}
	
	return ::valid_leave(me, dir);
}