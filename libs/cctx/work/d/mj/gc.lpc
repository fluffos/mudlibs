  set("short", YEL "明教广场" NOR);
  set("long", @LONG
这是一个十分大的广场，它足于容下上千人，这里是当年张教主力拼六大
门派的地方，使得明教和六大门派之间的仇恨得以排除。这里平时可看到很多
的明教弟子在这练功。东面有一株三丈来高的大松树。西面是长长的走廊。向
东通往明教大殿。
LONG
  );
  set("exits", ([
    //            "south" : __DIR__"lw3",
    //            "north" : __DIR__"lw1",
    "west": __DIR__ "clang1",
    "east": __DIR__ "dadian",
  ]));
  set("outdoors", "mingjiao");


  set("objects", ([
    __DIR__ "npc/jiaozhong1": 2,
    __DIR__ "npc/jiaozhong2": 2,
    "/kungfu/class/mingjiao/yangxiao": 1,
  ]));
  setup();
