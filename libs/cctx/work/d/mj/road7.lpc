//room: /d/mingjiao/dadian.c
inherit ROOM;
#include <ansi.h>
void init();

void create() {
  set("short", HIY "山路" NOR);
  set("long", @LONG
这里是一条傍着峭壁的小路，一边是深不见底的悬崖，峭壁笔直，几不见
天，更没有可以着手之处，偶尔会有一两处地方岩石突起，挡住你的去路，必
须低头才能通过。一边是深不见底的深崖，云雾深锁其间，飞鸟难渡，只是偶
尔传来几声鸟儿发出的凄厉的叫声，看起来你必须小心翼翼的走过去。
LONG
  );
  set("outdoors", "mingjiao");
  set("exits", ([
    //            "southdown" : __DIR__"gmding",
    "east": __DIR__ "road6",
    "eastdown": __DIR__ "road8",
    //            "eastup" : __DIR__"gmding",
  ]));
  set("objects", ([
    "/d/huashan/npc/youke": 2,
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "east") {
    if (me->query("qi") <= 10) {
      write(YEL "你爬山爬得很累了，歇歇再走吧。\n\n" NOR, me);

    }
    me->add("qi", -10);
  }

  return ::valid_leave(me, dir);
}
