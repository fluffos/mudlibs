    //            "north" : __DIR__"hongshui",
    "west": __DIR__ "houtu",
    //            "east" : __DIR__"liehuo",
  ]));
  set("objects", ([
    __DIR__ "npc/jiaozhong1": 2,
    __DIR__ "npc/jiaozhong2": 2,
    __DIR__ "npc/xinran": 1,
  ]));
  setup();
