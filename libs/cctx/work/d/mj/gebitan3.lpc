//gebitan4.c

inherit ROOM;

void create()
{
        set("short", "沙丘");
	set("long", @LONG
眼前是一望无际的戈壁滩，没有路标，也没有一个行人，天
显得很高，远山披雪，苍鹰翱翔，走在这茫茫戈壁之上，你似乎
迷路了。
LONG
	);
set("outdoors", "mingjiao");
 	set("exits",([
		      "eastdown" : __DIR__"gebitan2",
		      "west" : __DIR__"gebitan4",	
		      "northup" : __DIR__"gebitan"+random(4),
                      "south" : __DIR__"gebitan"+random(4),  				
	]));
	setup();
	replace_program(ROOM);
}