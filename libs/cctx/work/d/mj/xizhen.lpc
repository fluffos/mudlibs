//room: /d/mingjiao/dadian.c
inherit ROOM;



void create() {
  set("short", "吸真台");
  set("long", @LONG
这里说是一个台，其实是一块诺大的巨石，高高耸立的石柱，柱上有不少
人用手掌拍打过得痕迹，看得出此人功力不低，掌掌劲力深入石柱。四周是齐
人高的野草。
LONG
  );
  set("outdoors", "mingjiao");

  set("exits", ([
    "northdown": __DIR__ "shenshe",

  ]));

  setup();
}
void init() {
  add_action("do_hit", "hit");
}

int do_hit(string arg) {
  object me = this_player();
  if (!arg || arg == "") return 0;

  if (arg == "stone") {

    if (me->query("jing", 1) <= 20) {
      write("你已经太累了，休息休息再打吧。\n"); return 1;
    }
    if (me->query_skill("hand", 1) > 70) {
      write("你就是再打下去，对你也没有什么用了。\n"); return 1;
    }
    if (me->query_skill("hand", 1) < 20) {
      write("你试着掌击石柱，但手掌生痛。\n"); return 1;
    }
    message_vision("$N不断用掌击石柱。\n", me);
    me->improve_skill("hand", 20);
    me->receive_damage("jing", 20);
    return 1;
  }
}
