#include <room.h>

inherit ROOM;

void create()
{
        set("short","走廊");
        set("long", @LONG
这条走廊向西延伸，右侧是一些房间。它们都尽闭着房门，向里面看时是一片昏
暗，只觉有些朦胧的轮廓。
    你正欲转身，却发现走廊尽头有光从门缝里透出。那门(men)只是虚掩着并未
上锁。
LONG
        );

        set("exits",([                /* sizeof() == 2 */
                     "east"  : __DIR__"zoulang",
                     "north" : __DIR__"mjroom"
        ]));

        create_door("north","楠木门","south",DOOR_CLOSED);        

        setup();
        replace_program(ROOM);
}
