// shenghuo-ling
// by netkill 98-10-01
//超频

#include <weapon.h>
#include <ansi.h>


inherit LINGFA;
void init() {
  add_action("do_du", "du");
}

void create() {
  set_name(HIW "圣" HIR "火" HIW "令" NOR, ({ "shenghuo-ling" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是明教的圣物----圣火令。由乌黑的玄铁乌砂冶炼而成。\n隐约有圣火腾飞之状，上面密密麻麻的刻满了波斯文字。\n");
    set("value", 1000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一只$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");

  }
  init_lingfa(300);

  setup();
}




int do_du(string arg) {
  object me = this_player();
  int tag, i_jing;
  tag = ((int)me->query_skill("literate", 1) / 5 +
    (int)me->query_skill("shenghuo-xinfa", 1)) / 2;
  i_jing = 600 / (int)me->query_int();

  if (!arg || arg == "") return 0;

  if (arg == "shenghuo-ling") {

    if (me->query_int() < 30) {
      write("你始终对圣火令上面的波斯文字琢磨不透。\n"); return 1;
    }
    if (me->query_skill("shenghuo-shengong", 1) < 60) {
      write("你始终对圣火令上面的波斯文字琢磨不透。\n"); return 1;
    }
    if (me->query_skill("shenghuo-lingfa", 1) > 200) {
      write("你拿着圣火令研究了一会儿，发现上面的知识对你来说太浅了。\n"); return 1;
    }
    if (me->query("jing", 1) < 30) {
      write("已经太累了。\n"); return 1;
    }
    message_vision("$N拿着圣火令仔细研究。\n", me);
    me->improve_skill("shenghuo-lingfa", tag);
    me->improve_skill("lingfa", tag);
    me->receive_damage("jing", i_jing);
    return 1;
  }

}
