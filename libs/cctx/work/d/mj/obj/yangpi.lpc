#include <ansi.h>


inherit ITEM;
void init() {
  add_action("do_du", "du");
}

void create() {
  set_name("羊皮", ({ "yangpi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "一张薄薄的羊皮，上面密密麻麻的刻满了波斯文字。\n");
    set("value", 3);
    set("material", "bone");


  }


  setup();
}




int do_du(string arg) {
  object me = this_player();
  int tag, i_jing;
  tag = ((int)me->query_skill("literate", 1) / 5 +
    (int)me->query_skill("shenghuo-xinfa", 1)) / 2;
  i_jing = 600 / (int)me->query_int();

  if (!arg || arg == "") return 0;

  if (arg == "yangpi") {

    if (me->query_int() < 30) {
      write("你始终对羊皮上面的波斯文字琢磨不透。\n"); return 1;
    }
    if (me->query_skill("shenghuo-xinfa", 1) < 100) {
      write("你始终对羊皮上面的波斯文字琢磨不透。\n"); return 1;
    }
    if (me->query_skill("qiankun-nuoyi", 1) > 200) {
      write("你拿着羊皮研究了一会儿，发现上面的知识对你来说太浅了。\n"); return 1;
    }
    if (me->query("jing", 1) < 30) {
      write("已经太累了。\n"); return 1;
    }
    message_vision("$N仔细的阅读羊皮。\n", me);
    me->improve_skill("qiankun-nuoyi", tag);
    me->receive_damage("jing", i_jing);
    return 1;
  }

}
