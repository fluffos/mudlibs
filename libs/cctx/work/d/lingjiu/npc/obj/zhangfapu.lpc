#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "《天山六阳掌》基本篇" NOR, ({ "zhangfa pu", "pu", "book" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("unit", "本");
    set("long", "这是一本学习基本掌法的秘籍，上面画着一些纷繁复杂的招式及修练法门。\n");
    set("value", 0);
    set("material", "paper");
    set("skill", ([
      "name": "strike",
      "exp_required": 5000,
      "jing_cost": 30,
      "difficulty": 30,
      "max_skill": 100,
    ]));
  }
}
