inherit NPC;

void create()
{
	set_name("段二", ({ "duan er", "duan" }));
	set("title", "杂货铺老板");
	set("shen_type", 1);

	set("gender", "男性");
	set("per", 13);
	set("age", 45);
	set("long",
		"他经营这家小店，以养家糊口。\n");
	set_skill("unarmed", 50);
	set_skill("dodge", 50);
	set_temp("apply/damage", 15);

	set("combat_exp", 40000);
	set("attitude", "friendly");
	set("vendor_goods", ({
		"/d/lingjiu/obj/jiudai",
		"/d/lingjiu/obj/suanmei",
		"/d/lingjiu/obj/gao",
		"/d/lingjiu/obj/towel",
	}));
	
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
        add_action("do_sell", "sell");
}
