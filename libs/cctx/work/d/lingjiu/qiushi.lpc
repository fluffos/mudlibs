#include <room.h>
inherit ROOM;
void create()
{
        set("short", "囚室");
        set("long",@LONG
这是『灵鹫宫』关押犯人的地方，屋中光线昏暗，气味难闻。屋角隐
隐约约有个人影。
LONG
        );
        set("exits", ([
		"south" : __DIR__"men1",
        ]));
        create_door("south", "铁门", "north", DOOR_CLOSED);
        setup();
        replace_program(ROOM);
}