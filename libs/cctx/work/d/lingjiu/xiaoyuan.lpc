inherit ROOM;

void create() {
  set("short", "小院");
  set("long", @LONG
这里周围有各个房间，里面的墙上画着灵鹫宫武功的图解。灵鹫宫弟子只有
在将武功修炼到一定的火候后，才可到此修习上乘武功。
LONG
  );
  set("no_fight", 1);
  set("no_sleep", 1);
  set("outdoors", "lingjiu");
  set("exits", ([
    "north": __DIR__ "zoulang01",
    "south": __DIR__ "lg3",
    "east": __DIR__ "lg5",
    "west": __DIR__ "lg1",
    "southeast": __DIR__ "lg4",
    "southwest": __DIR__ "lg2",
  ]));
  set("objects", ([
    __DIR__ "npc/binu": 1,
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  object ob = this_player();
  if ((dir == "south") || (dir == "west") || (dir == "east") || (dir == "southeast") || (dir == "southwest")) {
    if (!present("lingjiu ling", ob)) {
      return notify_fail("婢女拦住你道：“未经尊主许可，任何人不得入内。”\n");
    }
    destruct(present("lingjiu ling", ob));
  }
  return ::valid_leave(me, dir);
}
