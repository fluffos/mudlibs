#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", HIY "菊园" NOR);
  set("long",
    HIY "你走进一间庭院，四周种着许多的菊花，有许多还是名贵的品种。\n"
    HIY "这里是" + HIC "灵鹫四姝" HIY + "“菊剑”的居所。\n" NOR
  );
  set("outdoors", "lingjiu");
  set("exits", ([
    "east": __DIR__ "zoulang05",
    "west": __DIR__ "xiaowu3",
  ]));

  create_door("west", "木门", "east", DOOR_CLOSED);
  setup();
}
