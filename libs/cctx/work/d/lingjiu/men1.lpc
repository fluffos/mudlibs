#include <room.h>
inherit ROOM;

void create() {
  set("short", "囚室大门");
  set("long",
    "这是囚室的大门，囚室是用来关押反抗灵鹫宫的洞主和岛主的。\n"
  );
  set("outdoors", "lingjiu");
  set("exits", ([
    "north": __DIR__ "qiushi",
    "east": __DIR__ "zoulang13",
  ]));
  create_door("north", "铁门", "south", DOOR_CLOSED);
  setup();
}
