#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", "独尊厅");
    set("long",
      "这就是"+HIC"『灵鹫宫』"NOR+"独尊厅。大厅全是以巨石砌成，石块之间\n"
      "竟无半点缝隙，令人称奇。厅内矗立着四根石柱，皆为坚硬的花岗石所制。\n"
    );
    set("exits", ([
	"north" : __DIR__"qianting",
	"south" : __DIR__"damen",
	"northeast" : __DIR__"zoulang03",
	"northwest" : __DIR__"zoulang02",
      ]));

    set("objects",([
	"/kungfu/class/lingjiu/xuzhu" : 1,
      ]));
    set("valid_startroom", 1);
    setup();
    "/clone/board/lingjiu_b"->foo();  }
