#include <ansi.h>
inherit ROOM;

void create()
{
	set("short","失足岩");
	set("long",
"这是通向"+HIC"『灵鹫宫』"NOR+"的必经之路，山道被一块如鹰喙突出的巨岩截断\n"
"，巨岩光可鉴人，只有中间凿出了一条窄窄的石阶通向山道的那一头。你\n"
"小心翼翼地试着踏了上去，心想：我能过去吧。\n"
);
	set("outdoors", "lingjiu");
	set("exits",([
	"northup" : __DIR__"jian",
	"eastdown" : __DIR__"ya",
	]));
	set("objects",([
		"/kungfu/class/lingjiu/tbyou" : 1,
	]));

	setup();
}
int valid_leave(object me, string dir)
{
	if (  (dir == "northup")
           && ((string)me->query("family/family_name") != "灵鹫宫")
	   && ( objectp(present("liu sao", environment(me)))) )

	 return notify_fail
		("刘嫂伸手拦住你道：尊主有令\n"
		 "在山脚交纳贡金就可以了,不必上飘渺峰\n");
	return ::valid_leave(me, dir);
}