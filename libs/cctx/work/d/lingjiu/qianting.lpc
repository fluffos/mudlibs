#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "前厅");
  set("long",
    "这就是" + HIC "『灵鹫宫』" NOR + "前厅。全是以巨石砌成，往北是花厅。\n"
    "西边飘来阵阵的药味，东边是灵鹫宫弟子练功休息的地方。\n"
  );
  set("exits", ([
    "north": __DIR__ "huating",
    "south": __DIR__ "dating",
    "east": __DIR__ "zoulang03",
    "west": __DIR__ "zoulang02",
  ]));

  setup();
}
