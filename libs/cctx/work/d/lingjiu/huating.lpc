#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "花厅");
  set("long",
    "这就是" + HIC "『灵鹫宫』" NOR + "花厅。四周摆放着许多盆花。\n"
    "往北通向花园，往南是独尊厅。\n"
  );
  set("exits", ([
    "south": __DIR__ "qianting",
    "southeast": __DIR__ "zoulang03",
    "southwest": __DIR__ "zoulang02",
  ]));

  setup();
  replace_program(ROOM);
}
