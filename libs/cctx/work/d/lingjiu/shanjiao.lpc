#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "缥缈峰山脚");
  set("long",
    "这里是缥缈峰山脚, 抬头上望, 缥缈峰耸入云天, 峰顶白云缭绕, 宛\n"
    "若仙境. 白云深处隐约可见琼楼玉宇, 那就是令江湖人物闻名丧胆的\n"
    HIC "『灵鹫宫』" NOR + "。听说宫中住着一些武艺高强的女侠, 而且只收女弟子为徒。\n"

  );
  set("outdoors", "lingjiu");
  set("exits", ([
    "westup": __DIR__ "ya",
    "southdown": __DIR__ "nexit",
  ]));
  set("objects", ([
    "/kungfu/class/lingjiu/tbzhu": 1,
  ]));
  setup();
  replace_program(ROOM);
}
