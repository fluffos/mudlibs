#include <ansi.h>
inherit ROOM;

void create()
{
	set("short","断魂崖");
	set("long",
"这是通向"+HIC"[灵鹫宫]"NOR+"的必经之路，一条小道蜿蜒曲折地通向缥缈峰顶。\n"
"路的右侧是一条陡峭的山崖，一阵山风吹过，你似乎听见从下面传来几声\n"
"惨号，你心中一凛，不禁加快脚步赶紧离开这里。\n"
);
	set("outdoors", "lingjiu");
	set("exits",([
	"westup" : __DIR__"yan",
	"eastdown" : __DIR__"shanjiao",
]));
	set("objects",([
		"/d/lingjiu/npc/ljshi" : 2,
	]));

	setup();
}
int valid_leave(object me, string dir)
{
	if (  (dir == "westup")
           && ((string)me->query("family/family_name") != "灵鹫宫")
	   && ( objectp(present("shengshi", environment(me)))) )

	 return notify_fail
		("灵鹫圣使伸手拦住你道：尊主有令\n"
		 "在山脚交纳贡金就可以了,不必上飘渺峰\n");
	return ::valid_leave(me, dir);
}