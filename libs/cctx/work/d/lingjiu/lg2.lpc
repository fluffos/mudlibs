// By adx @ CuteRabbit 22:21 99-3-19
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "月影馆");
	set("long",@LONG
你走进一间石头砌成的房间，这里四周的墙上都画着许多小人，身型飘动。
你仔细一看，画的正是“月影舞步”步法。你不禁跟着墙上的图案练习（lianxi）
起“月影舞步”来。
LONG);
	set("no_fight",1);
	set("no_sleep",1);
	set("exits", ([
	"northeast" : __DIR__"xiaoyuan",
]));
	setup();
}

void init()
{
	add_action("do_lianxi", "lianxi");
}

int do_lianxi(string arg)
{
        mapping fam;
	object me, killer;
	int i, jing_cost, qi_cost;

	me = this_player();
	i = (int)me->query_skill("dodge", 0) + random(500);
	jing_cost = 2500 / ((int)me->query("int"));
	qi_cost = 3000 / ((int)me->query("int"));
	if (!arg || (arg != "yueying-wubu"))
	{
		return notify_fail("你要练习什么？\n");	
	}
        if (interactive(me)
        && ((fam = me->query("family")) && fam["family_name"] != "灵鹫宫" ))
        {
                return notify_fail("别做梦了！非灵鹫宫弟子怎么可以练！”\n");
        }
	if((int)me->query_skill("yueying-wubu", 1) < 200)
	{
	message_vision(HIW"$N按图谱使出“月影舞步”。\n\n"NOR, me);
	if( i < 100 )
		me->unconcious();
	else {
		message_vision(HIW"$N“吁”了口气，收招立定。\n"NOR, me);
		if( i > 200 )
		me->improve_skill("yueying-wubu", (int)me->query_skill("yueying-wubu", 1));
		me->receive_damage("jing", jing_cost );
		me->receive_damage("qi", qi_cost );
	     }
	}
	else {
		return notify_fail("你的武功已经够高的了，已经从这里学不到什么东西？\n");
	     }	
		i = 0;
	return 1;
}
