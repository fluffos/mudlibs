#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "独尊厅大门");
        set("long",
"这就是通向"+HIC"『灵鹫宫』"NOR+"独尊厅的大门。大门左右各有一头石雕的猛鹫\n"
"，高达三丈有余，尖喙巨爪，神骏非凡，栩栩如生，似乎随时要腾空而去。\n"
	);
        set("outdoors", "lingjiu");
        set("exits", ([
		"north" : __DIR__"dating",
		"south" : __DIR__"dadao2",
        ]));

	set("objects",([
		"/kungfu/class/lingjiu/meijian" : 1,
		"/kungfu/class/lingjiu/lanjian" : 1,
		"/kungfu/class/lingjiu/jujian" : 1,
		"/kungfu/class/lingjiu/zhujian" : 1,
	]));
	setup();
}
int valid_leave(object me, string dir)
{

	if (  (dir == "north")
           && ((string)me->query("family/family_name") != "灵鹫宫")
	   && ( objectp(present("mei jian", environment(me)))
	   ||   objectp(present("lan jian", environment(me)))
	   ||   objectp(present("ju jian", environment(me)))
	   ||   objectp(present("zhu jian", environment(me))) ) )

	 return notify_fail
		("灵鹫四姝伸手拦住你，说道：“非灵鹫宫弟子请回！”\n");
	return ::valid_leave(me, dir);
}
