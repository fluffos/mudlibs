#include <ansi.h>
inherit ROOM;

void init();
int do_zou(string);
void create()
{
	set("short","仙愁门");
	set("long",
"这里就快到缥缈峰绝顶了，越往上走，山势越高，缭绕在你身边的白\n"
"雾愈来愈浓，往南则是下山的路。沿着山道没走几步，在你眼前出现一个\n"
"石坊，上书"+HIW"『仙愁门』"NOR+"三个大字，盖因上山之艰辛吧。\n"
);
	set("outdoors", "lingjiu");
	set("exits",([
		"eastup" : __DIR__"dadao1",
	]));
	set("objects",([
		"/d/lingjiu/npc/ljshi" : 2,
	]));
	setup();
}
void init()
{
	add_action("do_zou", "zou");
}
int do_zou(string arg)
{
	object me=this_player(), room;

	if(!arg || arg!="tiesuo")
		return notify_fail("你要走什么？\n");

	if(!( room = find_object(__DIR__"jian")) )
		room = load_object(__DIR__"jian");

	if(!objectp(room))
		return notify_fail("ERROR:not found 'jian.c' \n");
	message_vision(YEL"$N踩上铁索，飘然而去。\n"NOR,me);
        me->move(room);
        return 1;
}
int valid_leave(object me, string dir)
{
	if (  (dir == "eastup")
           && ((string)me->query("family/family_name") != "灵鹫宫")
	   && ( objectp(present("shengshi", environment(me)))) )

	 return notify_fail
		("灵鹫圣使伸手拦住你道：尊主有令\n"
		 "在山脚交纳贡金就可以了,不必上飘渺峰\n");
	return ::valid_leave(me, dir);
}