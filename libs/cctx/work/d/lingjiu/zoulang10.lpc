#include <room.h>
inherit ROOM;

void create()
{
	set("short","画廊");
	set("long",@LONG
这是一条非常精美的长廊，柱子和栏杆是用华贵的紫檀木制成，上面
雕饰着美丽的图画，画工精巧，美不胜收。地板不知是用什么材料做的，
走在上面毫无声息，你只感到脚下软软的，非常舒服。
LONG
     );
        set("exits", ([
		"north" : __DIR__"zoulang12",
		"south" : __DIR__"zoulang06",
		"east" : __DIR__"restroom1",
		"west" : __DIR__"zoulang09",
	]) );
        create_door("east", "竹门", "west", DOOR_CLOSED);
	setup();
	replace_program(ROOM);
}