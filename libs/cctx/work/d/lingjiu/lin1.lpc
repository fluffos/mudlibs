#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", HIM"梅林"NOR);
        set("long",
HIM"你走进一间庭院，四周种着许多的梅树，每到寒冬季节梅花全部开放，\n"
HIM"煞是游玩的好地方。这里是"+HIC"灵鹫四姝"HIM+"“梅剑”的居所。\n"NOR
	);
        set("outdoors", "lingjiu");
        set("exits", ([
		"east" : __DIR__"zoulang11",
		"west" : __DIR__"xiaowu1",
        ]));

        create_door("west", "木门", "east", DOOR_CLOSED);
	setup();
	replace_program(ROOM);
}