#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "小屋");
  set("long",
    "你走进" + HIM "梅剑" NOR + "的居所，四周的家具都是用紫檀木制成，上面雕刻着许多\n"
    "梅花。地板软软的，不知是用什么材料做的，走在上面毫无声息。\n"
  );
  set("exits", ([
    "east": __DIR__ "lin1",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);
  setup();
}
