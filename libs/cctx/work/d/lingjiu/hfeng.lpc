// /d/lingjiu/hfeng.c 滦凤阁
// By adx @ CuteRabbit 22:21 99-3-19

inherit ROOM;
#include <room.h>

void create() {
  set("short", "滦凤阁");
  set("long", @LONG
这里是灵鹫宫弟子沐浴的地方，是把用天山的泉水用管道引到屋顶让阳光直接
加热而成。“天山童姥”每天都要到这里，以天山泉水沐浴（wash）。
据说这泉水还能疗伤。
LONG
  );
  set("no_fight", 1);
  set("no_sleep", 1);
  set("exits", ([
    "east": __DIR__ "xiaoyuan1",
  ]));
  setup();
  create_door("east", "檀木门", "west", DOOR_CLOSED);
}
void init() {
  add_action("do_jump", "wash");
}
int do_jump() {
  object me;
  int wait;
  me = this_player();
  wait = random(100 - (int)me->query("con") * 2);
  if (wait <= 20) wait = 21;
  message_vision("$N缓步走入泉水中．\n", me);
  tell_object(me, "你感到全身无比的舒泰．．\n");
  remove_call_out("curehimup");
  call_out("curehimup", wait, me);
  return 1;
}
void curehimup(object me) {
  int jing, qi, neili;
  jing = (int)me->query("max_jing");
  qi = (int)me->query("max_qi");
  neili = (int)me->query("max_neili");
  if (me && environment(me) == this_object()) {
    message_vision("$N的精气内力全恢复了！！\n", me);
    me->set("eff_jing", jing);
    me->set("eff_qi", qi);
    me->set("jing", jing);
    me->set("qi", qi);
    me->set("neili", neili);
  }
}
