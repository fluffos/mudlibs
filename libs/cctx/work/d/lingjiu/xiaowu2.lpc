#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "小屋");
  set("long",
    "你走进" + CYN "兰剑" NOR + "的居所，四周的家具都是用紫檀木制成，上面雕刻着许多\n"
    "兰花。地板软软的，不知是用什么材料做的，走在上面毫无声息。\n"
  );
  set("exits", ([
    "west": __DIR__ "lin2",
  ]));

  create_door("west", "木门", "east", DOOR_CLOSED);
  setup();
}
