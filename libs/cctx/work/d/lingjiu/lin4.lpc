#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", HIG "竹林" NOR);
  set("long",
    HIG "你走进一间庭院，四周种着许多的竹子，一阵风吹过，竹叶发出\n"
    HIG "“沙、沙……”的响声。这里是" + HIC "灵鹫四姝" HIG + "“竹剑”的居所。\n" NOR
  );
  set("outdoors", "lingjiu");
  set("exits", ([
    "east": __DIR__ "xiaowu4",
    "west": __DIR__ "zoulang05",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}
