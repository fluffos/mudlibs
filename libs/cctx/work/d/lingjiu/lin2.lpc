// /d/lingjiu/lin2.c 兰园
// By adx @ CuteRabbit 22:21 99-3-19
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", NOR + CYN "兰园" NOR);
  set("long",
    CYN "你走进一间庭院，四周种着许多的兰花，每到兰花开放的季节，灵鹫\n"
    CYN "弟子都聚集到这里游玩。这里是" + HIC "灵鹫四姝" NOR + CYN "“兰剑”的居所。\n" NOR
  );
  set("outdoors", "lingjiu");
  set("exits", ([
    "east": __DIR__ "xiaowu2",
    "west": __DIR__ "zoulang11",
  ]));

  create_door("east", "木门", "west", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}
