#include <ansi.h>
inherit ROOM;

string look_jingzi();
void create()
{
        set("short","缀锦阁");
        set("long",@LONG
这是日常梳妆打扮的地方，放着一张红木梳妆台 ， 正对着你的是一
面光润的铜镜(jingzi)，梳妆台上散落着一些胭脂花粉。台旁摆着斗大的
一个汝瓷花囊，插着满满的水晶球儿般的白菊。
LONG
        );
         set("exits", ([
		"west" : __DIR__"zoulang18",
		   ]));

        set("item_desc", ([
		"jingzi" : (: look_jingzi :) ,
        ]));

       setup();
}
string look_jingzi()
{
	object me=this_player();

	message_vision("$N偷眼看着镜中的自己。\n",me);	
        if ((string)me->query("gender")=="女性")
		return "你抬眼往镜中瞧去，只见一个貌若春花的女子脉脉含情地凝望着你。\n你脸上一热，羞涩地低下了头，心想：那就是我吗？\n";
	if ((string)me->query("gender")=="男性")
                return "你抬眼往镜中瞧去，只见一个五大三粗的男子在镜中直瞪着你。\n你不觉心想：唉，这么雅致之处我真不好意思呆着了。\n";
	if ((string)me->query("gender")=="无性")
 		return "你抬眼往镜中瞧去，只见一个不男不女的人影恍惚镜中。\n你不觉心想：唉，为什么爹妈没给我一个女儿身呢？\n";
}
void init()
{
           add_action("do_pick","pick");
}
void reset()
{
        ::reset();
        set("get_available" , 1);
}
int do_pick(string arg)
{
       object me,obj;

       me = this_player();
       if( !arg || arg!="jingzi" )
              return notify_fail("你要拿什么?\n");
       if ( query("get_available") )  {
       obj = new (__DIR__"obj/zhangfapu");
       obj->move(me);
       add("get_available", -1);
       message_vision(YEL"$N拿起镜子，突然发现下面有一本书，就收入怀中。\n"NOR,me );
       }
       else
       return notify_fail("你拿起镜子一看，只是一面普通的镜子，就顺手放了回去。\n");
       return 1;
}