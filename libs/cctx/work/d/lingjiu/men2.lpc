// /d/lingjiu/men1.c
// By adx @ CuteRabbit 22:21 99-3-19
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "书房大门");
  set("long", @LONG
这是书房门口，只看见大门两旁贴着一副对联(duilian)，抬头上望。
门楣上一块大匾(bian)上写着几个大字,旁边放着一盆花（hua）。
LONG
  );
  set("outdoors", "lingjiu");
  set("exits", ([
    "north": __DIR__ "shufang",
    "south": __DIR__ "zoulang16",
  ]));

  set("item_desc", ([
    "duilian": HIY "行到水穷处，坐看云起时.\n" NOR,
    "bian": HIC "任我逍遥\n" NOR,
    "hua": "这是一盆花，你可以闻一下。\n",
  ]));
  setup();
}
void init() {
  add_action("do_pick", "pick");
}
void reset() {
  ::reset();
  set("get_available", 1);
}
int do_pick(string arg) {
  object me, obj;

  me = this_player();
  if (!arg || arg != "hua")
    return notify_fail("你要拿什么?\n");
  if (query("get_available")) {
    obj = new(__DIR__ "obj/shoufapu");
    obj->move(me);
    add("get_available", -1);
    message_vision(YEL "$N拿起盆花，突然发现下面有一本《天山折梅手》基本篇。\n" NOR, me);
  } else
    return notify_fail("你拿起盆花一看，闻了一下花很香，然后放了回去。\n");
  return 1;
}
