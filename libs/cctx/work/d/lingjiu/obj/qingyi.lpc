#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIC "青衣" NOR, ({ "qing yi", "cloth", "yi" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", CYN "这是件质量上佳青衣，是由[针神]亲手缝制的。\n" NOR);
    set("material", "cloth");
    set("armor_prop/armor", 50);
    set("value", 100);
  }
  setup();
}
