#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(HIC "长袍" NOR, ({ "chang pao", "cloth", "pao" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HIC "这是件质量上佳长袍，是由[针神]亲手缝制的。\n" NOR);
    set("material", "cloth");
    set("armor_prop/armor", 100);
    set("value", 100);
  }
  setup();
}
