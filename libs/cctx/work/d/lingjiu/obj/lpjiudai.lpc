// wineskin.c  酒袋
// By adx @ CuteRabbit 22:21 99-3-19

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "鹿皮酒袋" NOR, ({ "jiudai" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", YEL "这是一个用鹿皮做成的酒袋，一般用来装药酒。\n" NOR);
    set("unit", "个");
    set("nopawn", 1);
    set("value", 200);
  }
}
void init() {
  add_action("do_yao", "yao");
  add_action("do_drink", "drink");
}
int do_yao(object who) {
  object ob1, ob2;
  object me, ob, obj;

  me = this_player();
  ob = this_object();

  message_vision("$N拿起鹿皮酒袋摇了摇。\n\n", me);
  if (objectp(ob1 = present("baiyunwan", ob))
    && objectp(ob2 = present("luxue", ob))) {
    message_vision(CYN "$N发现白云熊胆丸溶解在鹿血里。\n" NOR, me);
    destruct(ob1);
    destruct(ob2);
    this_player()->add_temp("marks/lp", 5);
    return 1;
  } else
    return notify_fail("你不把东西装进去，怎么摇也没用的。\n");
}
int do_drink(string arg) {
  if (!id(arg))
    return notify_fail("你要喝什么？\n");
  if (this_player()->query_temp("marks/lp", 1) < 1) {
    return notify_fail("你拿起酒袋，发现是空的！\n");
  } else {
    this_player()->set("eff_jing", this_player()->query("max_jing"));
    this_player()->set("jing", this_player()->query("max_jing"));
    this_player()->set("eff_qi", this_player()->query("max_qi"));
    this_player()->set("qi", this_player()->query("max_qi"));
    this_player()->add("food", 20);
    this_player()->add("water", 20);
    this_player()->add(
      "neili",
      200
    ); message_vision(HIC "$N拿起鹿皮酒袋咕噜噜地喝了几口。只觉精气上升，气色大好。\n" NOR, this_player());
    this_player()->add_temp("marks/lp", -1);
  }
  return 1;
}
int is_container() { return 1; }
