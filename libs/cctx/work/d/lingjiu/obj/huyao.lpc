#include <ansi.h>
#include <armor.h>

inherit WAIST;

void create()
{
	set_name( HIC "护腰" NOR , ({ "hu yao", "hu", "yao" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
                set("long", CYN "这是一件皮质的护腰，上面钉着一头铜制黑鹫。\n" NOR );
		set("value", 1000);
		set("material", "waist");
		set("armor_prop/unarmed", 10);
	}
	setup();
}
