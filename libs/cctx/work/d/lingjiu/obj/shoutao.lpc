#include <ansi.h>
#include <armor.h>

inherit HANDS;

void create()
{
	set_name( HIC "手套" NOR , ({ "pi shoutao", "shoutao" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
                set("long", CYN "这是一双皮质手套，上面绣着一头黑鹫。\n" CYN );
		set("value", 1000);
		set("material", "hands");
		set("armor_prop/hand", 10);
	}
	setup();
}
