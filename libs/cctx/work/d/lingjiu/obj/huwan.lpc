#include <ansi.h>
#include <armor.h>

inherit WRISTS;

void create()
{
	set_name( HIC "护腕" NOR , ({ "hu wan", "wan" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
                set("long", CYN "这是一件皮质的护腕，上面刻着一头黑鹫。\n" NOR );
		set("value", 1000);
		set("material", "wrists");
		set("armor_prop/strike", 10);
	}
	setup();
}
