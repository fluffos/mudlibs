// /d/lingjiu/obj/lingjiu.c 灵鹫令
// By adx @ CuteRabbit 22:21 99-3-19

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIG "灵鹫令" NOR, ({ "lingjiu ling", "ling", "letter" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_get", 1);
    set("nopawn", 1);
    set("unit", "个");
    set("long", HIG "这是一个由灵鹫宫尊主授予的铁令，凭此可进入小院研习上乘武功。\n" NOR);
    set("no_drop", "这样东西不能离开你。\n");
    set("material", "paper");
  }
}
void init() {
  call_out("dest", 300);
}

void dest() {
  destruct(this_object());
}
