#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create()
{
	set_name( HIC "斗篷" NOR , ({"dou peng", "peng"}) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
	set("unit", "件");
	set("long", HIC "这是件黑色的斗篷,上面绣着一只灵鹫。\n" NOR );
	set("material", "cloth");
	set("armor_prop/armor", 100);
        set("value",100);
    }
    setup();
}
