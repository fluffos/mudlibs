#include <ansi.h>
#include <weapon.h>
inherit SWORD;

void create()
{
	set_name( HIC "天羽奇剑" NOR , ({ "tianyu jian", "jian" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", CYN "这是一柄精钢所制的剑，剑身轻巧，寒气逼人。\n"
				"上面镶着一头铜制的黑鹫。\n" NOR );
		set("value", 100);
		set("material", "steel");
		set("wield_msg", CYN "$N「唰」的一声抽出一柄$n"+CYN"握在手中。\n" NOR );
		set("unwield_msg", CYN "$N将手中的$n"+CYN"插回剑鞘。\n" NOR );
	}
	init_sword(200);
	setup();
}
