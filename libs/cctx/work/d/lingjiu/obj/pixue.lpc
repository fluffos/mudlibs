#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(HIC "皮靴" NOR, ({ "pi xue", "xue" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", CYN "一双皮靴，上面绣有一头黑鹫。" NOR);
    set("value", 1000);
    set("material", "boots");
    set("armor_prop/dodge", 10);
  }
  setup();
}
