#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create()
{
	set_name( HIC "指套" NOR , ({ "zhitao", "zhi tao" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "副");
                set("long", CYN "这是五个环环相链的铁指套，上面刻着一头黑鹫。\n" NOR );
		set("value", 1000);
		set("material", "finger");
		set("armor_prop/parry", 10);
	}
	setup();
}
