#include <ansi.h>

inherit ITEM;
void serve_cai(object);

void create() {
  set_name("炉灶", ({ "luzao" }));
  set_weight(3000);
  set_max_encumbrance(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一个炉灶，你可以在上面做菜（soup）。\n");
    set("value", 1000);
    set("no_get", 1);
    set("amount", 10);
  }
  setup();
}
void serve_cai(object who) {
  object ob1, ob2, ob3, ob4, ob5;
  object me, ob, obj;
  me = this_player();

  if (!who || environment(who) != environment()) return;

  if (!who->query_temp("marks/ran")) return;

  if (objectp(ob = present("luzao", environment(me)))) {
    message_vision("$N拿起锅铲按照黄蓉教你的方法做菜。\n", me);
    ob1 = present("niurou", ob);
    ob2 = present("zhurou", ob);
    ob3 = present("zhangrou", ob);
    ob4 = present("xiaoturou", ob);
    ob5 = present("yangrou", ob);

    if (ob1 && ob2 && ob3 && ob4 && ob5) {
      message_vision("$N做好了这道菜。\n", me);
      destruct(ob1);
      destruct(ob2);
      destruct(ob3);
      destruct(ob4);
      destruct(ob5);
      me->delete_temp("marks/ran");
      obj = new("/d/taohua/obj/cai");
      obj->move(ob);
    }
    return 1;
  }
}
