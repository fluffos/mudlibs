#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name(HIR "鹿血" NOR, ({ "luxue", "xue" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一滴梅花鹿的鲜血。\n");
    set("unit", "滴");
    set("value", 0);
  }
}
