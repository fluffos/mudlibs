inherit ROOM;
#include <ansi.h>

void create()
{
	set("short",HIW "雪山山麓" NOR);
	set("long", 
"你来到了大雪山的山腰，只觉得天寒地冻，连呼吸都有点困难了，如果身体不好\n"
"的人，支撑不了多久的。\n"
	);


	set("exits", ([
		"northup" : __DIR__"road3",
		"westdown" : __DIR__"road1",
	]));
			setup();
	replace_program(ROOM);

}

