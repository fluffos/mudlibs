inherit ROOM;
#include <ansi.h>

void create()
{
	set("short",HIY "休息室" NOR);
	set("long", 
"这里灯光昏暗，从窗边往南望可以看到满山的雪景，屋子中间放着一个"+BLINK HIR"大火盆\n"NOR
"给寒冷的天气带来许许温暖。使人昏昏想睡。\n"
	);
        set("sleep_room", 1);
        set("no_fight", 1);

	set("exits", ([
		"west" : __DIR__"lang1",
		"north" : __DIR__"lianyaotang",
	]));
			setup();
	replace_program(ROOM);

}

