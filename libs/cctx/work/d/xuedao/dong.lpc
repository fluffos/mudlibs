#include <ansi.h>
inherit ROOM;
int do_yungong(string arg);

void create() {
  set("short", HIW "千年冰窟" NOR);
  set("long",
    HIW "这里是雪山地下的千年冰窟，进来的人，连撒泡尿都会结成铁一样硬的冰，只有\n"
    "内力深厚的人才可以在这里稍留片刻。四周由于光线的反射折射，让人眼花缭乱。\n" NOR);

  set("exits", ([
    "out": __DIR__ "houshan",
  ]));
  setup();
}

void init() {
  add_action("do_yungong", "yungong");
}

int do_yungong(string arg) {
  object me;
  int i, ging_cost, qi_cost;

  me = this_player();
  i = (int)me->query_skill("force", 1) + random(50);
  ging_cost = 500 / (int)me->query("int");
  qi_cost = 500 / (int)me->query("int");
  if (((int)me->query("jing") < ging_cost) || ((int)me->query("qi") < qi_cost))
    i = 0;

  message_vision("$N盘腿坐下，开始运功与寒冷对抗。\n", me);
  if (i < 1) {
    message_vision("$N承受不了这里的寒冷，倒在地上抽了几下筋，死了。\n", me);
    me->die();
    message("channel:chat", HIM "【谣言】某人：" + me->query("name") +
      "被冻死了。\n" NOR, users());

  } else if (i < 3) {
    message_vision("$N承受不了这里的寒冷，晕了过去。\n", me);
    me->unconcious();
    switch (random(2)) {
      case 0:

        break;
      case 1:

        break;
        message_vision("$N深深吸了口气，站了起来。\n", me);
    }
  } else {
    switch (random(5)) {
      case 0:
        message_vision("$N深深吸了口气，站了起来。\n", me);

        break;
      case 1:
        message_vision("$N深深吸了口气，站了起来。\n", me);

        break;
      case 2:
      case 3:
      case 4:
        break;
    }
    if (i < 100) me->improve_skill("force", 1 * (int)me->query_skill("force", 1));
    if (i > 100) me->improve_skill("force", 0 * (int)me->query_skill("force", 1));

    me->receive_damage("jing", ging_cost);
    me->receive_damage("qi", qi_cost);
  }
  return 1;
}
