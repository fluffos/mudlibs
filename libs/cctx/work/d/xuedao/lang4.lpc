inherit ROOM;
#include <ansi.h>

void create()
{
	set("short",HIY "长廊尽头" NOR);
	set("long", 
"一条长长的走廊，紧靠在雪山的悬崖上，从这里往下去，可以看到满山谷的皑皑白雪\n"
"寒冷的山风吹来，叫人直打寒颤。\n"
	);

	set("exits", ([

		"east" : __DIR__"lang3",
		"north" : __DIR__"zlang1",
	]));
			setup();
	replace_program(ROOM);

}

