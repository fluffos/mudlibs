inherit ROOM;
int do_jump(string arg);

void create()
{
        set("short", "雪山谷底");
        set("long",
        "这里是一处幽静的所在，虽然天气有点寒冷，但四处群山环抱，到处鸟语花香\n"+
	"看来这里不能出去了，四处转转，或许有收获。半山似乎有个山洞。\n");
        set("outdoors", "xuedao");

			setup();

}
void init()
{
	add_action("do_jump", "jump");
}

int do_jump(string arg)
{
	object me;
	int i, ging_cost, qi_cost;
 if( !arg || arg=="" ) return 0;

        if( arg=="up" ) {
	me = this_player();
message_vision("$N一个纵身，往崖上跳了上去。\n", me);

me->move("/d/xuedao/gudidong");

return 1;}

}