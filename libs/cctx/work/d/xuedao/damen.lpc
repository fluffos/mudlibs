// damen 血刀门
// by Xiang

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIR "血刀门" NOR);
  set("long",
    "这里就是血刀门的大门了，来到这里，禁不住的刹气让来者胆寒，四处阴森森 \n" +
    "的弥满着死人的气息，抬头一看，血红的屋檐下挂着一块匾，上书三个霸气的红色 \n" +
    "大字：" + HIR " “   血刀门   ”  \n" NOR
  );

  set("valid_startroom", 1);
  set("exits", ([
    "eastdown": __DIR__ "shanlu1",
    "west": __DIR__ "tianditang",
  ]));
  set("objects", ([
    __DIR__ "npc/suxing": 1,
    __DIR__ "npc/xdseng": 2,
  ]));
  setup();
  "/clone/board/xuedao_b"->foo();
}
