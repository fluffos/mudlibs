#include <ansi.h>
inherit ROOM;
int do_yungong(string arg);

void create()
{
        set("short",HIR "血池"NOR);
        set("long",
HIR"这里是一个装满了红色血水的池子，颜色红得发紫，看来最好不要下去，血刀门\n"
"弟子杀了人通常都丢在这个池子里。。\n"NOR);
        set("outdoors", "xuedao");	
		set("exits", ([
		"southup" : __DIR__"lang3",
		"westup" : __DIR__"zlang1",
		"eastup" : __DIR__"clang1",
					]));	
        setup();
}

void init()
{
	add_action("do_swim", "swim");
}

int do_swim(string arg)
{
	object me;
	int i, ging_cost, qi_cost;

	me = this_player();
	i = (int)me->query_skill("unarmed", 1) + random(50);
	ging_cost = 250 / (int)me->query("int");
	qi_cost = 250 / (int)me->query("int");
	if(((int)me->query("jing") < ging_cost) || ((int)me->query("qi") < qi_cost))
		i = 0;

	message_vision("$N三下两下扒光了衣服，在"+HIR"血池"NOR+"里游了起来\n", me);
	if ( i < 3)
		{
	        message_vision("$N一口气接不上来，在"+HIR"血池里"NOR+"挣扎了几下，死了\n", me);
		me->die();
		message("channel:chat", HIM"【谣言】某人："+me->query("name")+
"被血池淹死了。\n"NOR, users());
	        }
	else if( i < 10)
		{
	        message_vision("$N喘着粗气，迷迷糊糊，从池里爬将上来。\n", me);
		me->unconcious();
		switch( random(2) ) {
		case 0:

			break;
		case 1:

		break;
	//	message_vision("$N三下两下扒光了衣服，在"+HIR"血池里"NOR+"游了起来\n", me);
		}
	        }
	else {
		switch( random(5) ) {
		case 0:
	//	message_vision("$N三下两下扒光了衣服，在"+HIR"血池里"NOR+"游了起来\n", me);

			break;
		case 1:
//		message_vision("$N三下两下扒光了衣服，在"+HIR"血池里"NOR+"游了起来\n", me);

			break;
		case 2:
		case 3:
		case 4:
		break;
		}
		if( i < 100) me->improve_skill("unarmed", 1*(int)me->query_skill("unarmed", 1));
		if( i > 100) me->improve_skill("unarmed", 0*(int)me->query_skill("unarmed", 1));
		
		me->receive_damage("jing", ging_cost );
		me->receive_damage("qi", qi_cost );
	     }
	return 1;
}
