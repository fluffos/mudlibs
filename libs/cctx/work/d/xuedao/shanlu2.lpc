inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIY "山路" NOR);
  set("long",
    "这里是一段小小的山路，往西就可以到达雪山了。虽然还没有到达雪山，但也 \n" +
    "感到有些逼人的寒气。 西往是一座座连在一起的" + BLINK HIW "～※雪山※～" NOR + "。\n"
  );

  set("exits", ([
    "eastdown": __DIR__ "shanlu3",
    "westup": __DIR__ "shanlu1",
  ]));
  set("objects", ([
    __DIR__ "npc/yetu": 1,
  ]));


  setup();
  replace_program(ROOM);

}
