inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIW "内长廊" NOR);
  set("long",
    "一条长长的走廊，南边吹来阵阵凉风，隐约可以可以看到皑皑白雪。几条走廊\n"
    "围绕着一个红色的池子。\n"
  );

  set("exits", ([
    "west": __DIR__ "restroom2",
    "south": __DIR__ "lang4",
    "north": __DIR__ "zlang2",
    "eastdown": __DIR__ "xuechi",
  ]));
  setup();

}
