inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIY "后山" NOR);
  set("long",
    "眼前一亮，你来到一处鸟语花香的所在，这里地处山谷，虽在雪山之中，却一年\n"
    "四季鸟语花香，偶尔可以听到远处山谷传来布谷鸟的鸣叫。\n"
  );


  set("exits", ([
    "enter": __DIR__ "dong",
    "eastup": __DIR__ "road3",
  ]));
  setup();
  replace_program(ROOM);

}
