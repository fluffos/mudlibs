// qingfeng.c
#include <ansi.h>
#include <weapon.h>
inherit BLADE;

void create() {
  set_name(HIC "青锋斩" NOR, ({ "blade" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", HIC "这是一柄泛着青光的刀，刀刃绯薄，似乎很锋利。\n" NOR);
    set("value", 1000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
  }
  init_blade(20);
  setup();
}
