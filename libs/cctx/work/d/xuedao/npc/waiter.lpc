// baoxiang.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>


string ask_me();

void create() {
  set_name("小和尚", ({ "xiao heshang", "xiao" }));
  set("long",
    "他是一个侍茶的小和尚。\n");

  set("gender", "男性");
  set("age", 15);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("max_qi", 100);
  set("max_jing", 100);
  set("neili", 100);
  set("max_neili", 100);
  set("jiali", 30);

  set("combat_exp", 70000);
  set("score", 8500);



  set("class", "taoist");

  set("inquiry",
    ([
      "肉": (: ask_me :),
    ]));



  setup();

  carry_object("/d/xuedao/obj/cloth")->wear();
}



string ask_me() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family"))
    || fam["family_name"] != HIR "血刀门" NOR)
    return RANK_D->query_respect(this_player()) + "你不是本本的人，缘何来此乞讨？";
  ob = new("/d/xuedao/obj/rou");
  ob->move(this_player());
  return NOR "这里有些" + HIR "野猪肉" NOR + "，你拿去好好享用吧。";
}
