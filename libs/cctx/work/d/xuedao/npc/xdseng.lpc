

#include <ansi.h>
inherit NPC;

void create()
{
    set_name("血刀僧众", ({
	"xuedao seng",
	"seng",
	"xd seng",
      }));
    set("long",
      "他是一位身材高大的壮年僧人，两臂粗壮，膀阔腰圆。他手持兵\n"
      "刃，身穿一袭灰布僧衣，似乎有一身武艺。\n"
    );
    set("gender", "男性");
    set("age", 40);
    set("shen_type", -1);
    set("attitude", "peaceful");
    set("str", 35);
    set("int", 20);
    set("con", 20);
    set("dex", 25);
    set("max_qi", 500);
    set("max_jing", 300);
    set("neili", 500);
    set("max_neili", 500);
    set("jiaji", 50);
    set("combat_exp", 80000);
    set("score", 1);
    
    set_skill("dodge",40);
    set_skill("xue-dao",60);
    set_skill("parry",40);
  
    set_skill("unarmed",60);
    set_skill("blade",60);
    set_skill("xuedao-xinfa",40);
    set_skill("force",40);
    set_skill("xueying-shenfa",40);
    
    map_skill("unarmed","wuying-shenquan");
    map_skill("force", "xuedao-xinfa");
    map_skill("blade", "xue-dao");
    map_skill("parry", "xue-dao");
    map_skill("dodge", "xueying-shenfa");
    
    
    set("class", "taoist");
    
    setup();
    
    carry_object(__DIR__"obj/gangdao")->wield();
    carry_object(__DIR__"obj/cloth")->wield();
}

void init()
{
    object me, ob;
    mapping fam;
    
    ::init();
    
    ob = this_player();
    me = this_object();
    
    if (interactive(ob) 
      && !environment(ob)->query("no_fight")
      
      && ( (fam = ob->query("family")) && fam["family_name"] != HIR"血刀门"NOR ) )
    {
command("kill " + ob->query("id"));
	if( !ob->query_temp("warned") ) {
	    command("say 我血刀们且是外人随便闯入的？！\n");
	    command("say 再不离开，否则杀了你！\n");
	    ob->set_temp("warned", 1);
	}
	else if( ob->query_temp("stay") < 10 ) ob->add_temp("stay", 1);
	else {
	    command("say 大胆狂徒，竟敢闯到血刀门里来捣乱！！！\n");
	    me->set_leader(ob);
	    remove_call_out("kill_ob");
	    call_out("kill_ob", 1, ob); 
	}
    }       
    
}
