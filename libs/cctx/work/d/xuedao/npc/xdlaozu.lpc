// baoxiang.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>


string ask_me();

void create()
{
	set_name("血刀老祖", ({"xuedao laozu","zhangmen","laozu"}));
	set("long", 
		"他就是"+HIR"血刀门"NOR+"掌门人。\n"
		"他今年看起来倒满和蔼的。\n");
	set("gender", "男性");
	set("age", 50);
	set("attitude", "peaceful");
        set("shen_type", -1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	
	set("max_qi", 1000);
	set("max_jing", 500);
	set("neili", 2000);
	set("max_neili", 2000);
	set("jiali", 30);

	set("combat_exp", 1000000);
	set("score", 8500);
	
	set_skill("dodge",250);
	set_skill("parry",250);
	set_skill("unarmed",250);
	set_skill("blade",250);
        set_skill("literate",150);
	set_skill("xuedao-xinfa",250);
	set_skill("xue-dao",250);
	set_skill("force",250);
	set_skill("xueying-shenfa",250);
	set_skill("wuying-shenquan",250);	
	
	map_skill("unarmed","wuying-shenquan");
	map_skill("force", "xuedao-xinfa");
	map_skill("blade", "xue-dao");
	map_skill("parry", "xue-dao");
	map_skill("dodge", "xueying-shenfa");

	create_family(HIR"血刀门"NOR, 1, "僧人");
	set("class", "taoist");

	set("inquiry", 
		([
			"血刀" : (: ask_me :),
		]));
                                
	set("xblade_count", -1);

	setup();
	carry_object("/d/xuedao/obj/xblade")->wield();
	carry_object("/d/xuedao/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen")  >-200000) {
	command("sigh");

		command("say 老纳已经封门不收弟子了，你请回吧。");
			return;}
	if ((int)ob->query_skill("xuedao-xinfa", 1) < 100) {
		command("say 练血刀刀法最重内功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否还应该在血刀心法上多下点功夫？");
		return;

	}
	
	command("say 好吧，看你还是个人才，比我还坏，血刀门看来得靠你了。");
	command("recruit " + ob->query("id"));
        if (query("xblade_count") < 1)
       {command("say 好徒儿，我还有一把血刀，你拿去好好保管！");
	new("/d/xuedao/obj/xblade")->move(this_player());
	add("xblade_count", 1);}
}

string ask_me()
{
        mapping fam; 
        object ob;

        if (!(fam = this_player()->query("family")) 
	    || fam["family_name"] != HIR"血刀门"NOR)
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";
        if (query("xblade_count") < 1){
                return HIW"本派的"NOR+HIR"血刀"NOR+HIW"不随意给人保管的。"NOR;
    
               return HIW"本派的"NOR+HIR"血刀"NOR+HIW"不随意给人保管的。"NOR;}
}
int accept_fight(object ob)
{
object me  = this_object();
       mapping fam; 
if ( me->query("winner") == ob->query("id") ) 
return notify_fail("你跟你自己打什麽架？！\n");
        if (!(fam = this_player()->query("family")) 
    || fam["family_name"] != HIR"血刀门"NOR) return notify_fail("看来掌门不愿接受你的挑战。\n");
if (ob->query("combat_exp")<1000000) return notify_fail("看来掌门不愿接受你的挑战。\n");
remove_call_out("checking");
call_out("checking", 1, me, ob);
return 1;
}
int checking(object me, object ob)
{
object obj;
int my_max_qi, his_max_qi;
my_max_qi  = me->query("max_qi");
his_max_qi = ob->query("max_qi");
 if (me->is_fighting()) {
call_out("checking",2, me, ob);
return 1;
}
if ( !present(ob, environment()) ) return 1; 
if (( (int)me->query("qi")*100 / my_max_qi) <= 50 ) {
command("say 果然厉害，恭喜你成为本门掌门人，老衲可以隐退了！\n");
   remove_call_out("do_copy");
 call_out("do_copy", 1, me, ob);
return 1;
}
   if (( (int)ob->query("qi")*100 / his_max_qi) < 50 ) {
command("say 看来" + RANK_D->query_respect(ob) + 
            "还得多加练习，方能在当今武林中耀我血刀之风！\n");
command("pat "+ob->query("id"));
return 1;
}
 return 1;  
}
int do_copy(object me, object ob)
{
me->set("winner", ob->query("id"));
me->add("generation", 1);
me->set("name",  ob->query("name") );
me->delete("title");
me->set("short", me->query("title") + " " + me->query("name") + "(" + me->query("id") + ")");
if (ob->query("gender")=="女性"){
ob->set("title", HIR"血刀门"NOR+HIW"第" + chinese_number(me->query("generation")) + "代掌门大师姐"NOR);
me->set("title", HIR"血刀门"NOR+HIW"第" + chinese_number(me->query("generation")) + "代掌门大师姐"NOR);
return 1;
}
if (ob->query("gender")=="男性"||ob->query("gender")=="无性"){
me->set("title", HIR"血刀门"NOR+HIW"第" + chinese_number(me->query("generation")) + "代掌门大师兄"NOR);
ob->set("title", HIR"血刀门"NOR+HIW"第" + chinese_number(me->query("generation")) + "代掌门大师兄"NOR);
return 1;
}
me->set("age",  ob->query("age") );
ob->delete_temp("apply/short");
ob->set_temp("apply/short", ({me->short()}));
return 1;
}
