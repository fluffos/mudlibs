// baoxiang.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>


string ask_me();

void create()
{
	set_name("尤生", ({ "you sheng", "sheng" }));
	set("long", 
		"他就是"+HIR"血刀门"NOR+"第二代僧人尤生。\n"
		"他满脸横肉，相貌极为不善。\n");
	set("gender", "男性");
	set("age", 35);
	set("con", 25);
	set("attitude", "peaceful");
        set("shen_type", -1);
	set("str", 25);
	set("int", 25);
	set("dex", 25);
	
	set("max_qi", 1000);
	set("max_jing", 800);
	set("neili", 1000);
	set("max_neili", 1000);
	set("jiali", 50);

	set("combat_exp", 100000);
	set("score", 8500);
	
	set_skill("dodge",60);
	set_skill("parry",60);
	set_skill("unarmed",60);
	set_skill("blade",60);
	set_skill("literate",30);
	set_skill("xuedao-xinfa",60);
	set_skill("xue-dao",60);
	set_skill("force",60);
	set_skill("xueying-shenfa",60);
	set_skill("wuying-shenquan",60);	
	
	map_skill("unarmed","wuying-shenquan");
	map_skill("force", "xuedao-xinfa");
	map_skill("blade", "xue-dao");
	map_skill("parry", "xue-dao");
	map_skill("dodge", "xueying-shenfa");

	create_family(HIR"血刀门"NOR, 2, "僧人");
	set("class", "taoist");
	set("inquiry", 
		([
			"血刀刀谱" : (: ask_me :),
		]));

                                
	set("book_count", 1);

	setup();
	carry_object("/d/xuedao/obj/qingfeng")->wield();
	carry_object("/d/xuedao/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen")  >-1) {
		command("say 哈哈！要入我血刀门，你还不构资格。");
		command("say 在烧杀抢虏上" + RANK_D->query_respect(ob) +
			"你还要多加努力。");
		return;
	}
	command("say 好吧，大师傅我就就收下你了。以后一定要多杀人，多放火，杀光抢光，哈哈！");
	command("recruit " + ob->query("id"));
}

string ask_me()
{
        mapping fam; 
        object ob;

        if (!(fam = this_player()->query("family")) 
	    || fam["family_name"] != HIR"血刀门"NOR)
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";
        if (query("book_count") < 1)
                return HIW"你来晚了，本派的"NOR+HIR"【血刀刀谱】"NOR+HIW"不在此处。"NOR;
        add("book_count", -1);
        ob = new("/d/xuedao/obj/xuedao-jing");
        ob->move(this_player());
        return HIW"好吧，这本"NOR+HIR"【血刀刀谱】"NOR+HIW"你拿回去好好钻研。"NOR;
}

