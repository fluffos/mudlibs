// baoxiang.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>


string ask_me();

void create()
{
	set_name("狄云", ({ "di yun", "di","yun" }));
	set("long", 
		"他就是"+HIR"血刀门"NOR+"弟子狄云。\n"
		"他今年看起来倒满和蔼的。\n");
	set("gender", "男性");
	set("age", 30);
	set("attitude", "peaceful");
        set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	
	set("max_qi", 1000);
	set("max_jing", 500);
	set("neili", 2000);
	set("max_neili", 2000);
	set("jiali", 30);

	set("combat_exp", 10000000);
	set("score", 8500);
	
	set_skill("dodge",250);
	set_skill("parry",250);
	set_skill("unarmed",250);
	set_skill("blade",250);
	set_skill("literate",120);
	set_skill("xuedao-xinfa",250);
	set_skill("xue-dao",250);
	set_skill("force",250);
	set_skill("xueying-shenfa",250);
	set_skill("wuying-shenquan",250);	
	set_skill("sword",250);
	set_skill("liancheng-jian",250);	
	set_skill("shenzhao-shengong",250);	
		
	map_skill("unarmed","wuying-shenquan");
	map_skill("force", "shenzhao-shengong");
	map_skill("blade", "xue-dao");
	map_skill("parry", "xue-dao");
	map_skill("dodge", "xueying-shenfa");
	map_skill("sword", "liancheng-jian");

	create_family(HIR"血刀门"NOR, 2, "弟子");


	set("inquiry", 
		([
			"神照经" : (: ask_me :),
		]));
                                
	set("book_count", -1);

	setup();
	carry_object("/d/jingzhou/obj/gangjian")->wield();
	carry_object("/d/xuedao/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen")  >200000) {
	command("sigh");

		command("say 我已经封门不收弟子了，你请回吧。");
			return;}
	if ((int)ob->query_skill("xuedao-xinfa", 1) < 100) {
		command("say 练血刀刀法最重内功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否还应该在血刀心法上多下点功夫？");
		return;

	}
	
	command("say 好吧，看你还是个人才，血刀门看来得靠你了。");
	command("recruit " + ob->query("id"));
        if (query("xblade_count") < 1)
       {command("say 我还有一本神照经，你拿去好好保管！");
	new("/d/xuedao/obj/shenzhao-jing")->move(this_player());
	add("book_count", 1);}
}

string ask_me()
{
        mapping fam; 
        object ob;

        if (!(fam = this_player()->query("family")) 
	    || fam["family_name"] != HIR"血刀门"NOR)
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";
        if (query("book_count") < 1){
                return HIW"本派的"NOR+HIR"血刀"NOR+HIW"不随意给人保管的。"NOR;
    
               return HIW"本派的"NOR+HIR"血刀"NOR+HIW"不随意给人保管的。"NOR;}
}
