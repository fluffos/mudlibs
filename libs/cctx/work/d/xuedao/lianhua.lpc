inherit ROOM;
#include <ansi.h>

void create()
{
	set("short",HIW "莲花池" NOR);
	set("long", 
"这里是大雪山的南麓，虽未到雪山的峰顶，却也叫抵抗不住的人难以上行。 \n"
"山麓有一个莲花池，不过却不是好像不是种的雪莲，而是普通的莲花。\n"
	);


	set("exits", ([
		"southdown" : __DIR__"daotang",
		"northup" : __DIR__"road1",
	]));
	set("objects", ([
	__DIR__"npc/xdlaozu" : 1,
        ]));

			setup();
	replace_program(ROOM);

}

