inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIR "血刀堂" NOR);
  set("long",
    "这里就是血刀门的血刀堂，血刀门大弟子每日在此打坐练功，血刀弟子有问题都 \n" +
    "可以向他请教。靠墙供桌上供着一把颜色暗红的" + HIR "《血刀》" NOR + "。\n"
  );


  set("exits", ([
    "south": __DIR__ "zlang2",
    "northup": __DIR__ "lianhua",
    "east": __DIR__ "jitai",
    "west": __DIR__ "restroom",
  ]));
  set("objects", ([
    __DIR__ "npc/shengdi": 1,
  ]));

  setup();

}
