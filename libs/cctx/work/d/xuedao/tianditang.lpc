// damen 血刀门
// by congw
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIW "天地堂" NOR);
  set("long",
    "天地堂乃是血刀门以前纪事大典的好地方，后来由于在江湖中群雄围攻，血刀 \n" +
    "元气大伤，这里也因此而变得荒凉落寞。江湖后辈人才倍出，也许有人会将血刀门\n"
    "重整旗鼓。 \n"
  );


  set("exits", ([
    "south": __DIR__ "biwutang",
    "north": __DIR__ "bingqitang",
    "east": __DIR__ "damen",
    "west": __DIR__ "jitai",
  ]));
  setup();
  replace_program(ROOM);

}
