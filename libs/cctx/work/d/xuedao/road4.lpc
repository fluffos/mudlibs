#include <ansi.h>
inherit ROOM;
int do_jump(string arg);

void create() {
  set("short", "雪山峰顶");
  set("long",
    "你来到了大雪山的山巅，只觉得天寒地冻，呼吸困难，如果不赶紧下山，怕是要\n" +
    "冻死在这里。\n");
  set("outdoors", "xuedao");
  set("exits", ([

    "southdown": __DIR__ "road3",
  ]));
  setup();

}
void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object me;
  int i, ging_cost, qi_cost;
  if (!arg || arg == "") return 0;

  if (arg == "down") {
    me = this_player();
    message_vision("$N一个纵身，往崖下跳了下去。\n", me);
    if (me->query_skill("dodge", 1) < 100) {
      me->move("/d/xuedao/dong");
      me->die();
      message("channel:chat", HIM "【谣言】某人：" + me->query("name") +
        "跳下悬崖摔死了。\n" NOR, users());
    }


    else {
      me->move("/d/xuedao/gudi");
      me->unconcious();
    }
    return 1;
  }

}
