inherit ROOM;
#include <ansi.h>

void create()
{
	set("short",HIW "雪山山麓" NOR);
	set("long", 
"这里是大雪山的南麓，虽未到雪山的峰顶，却也叫抵抗不住的人难以上行。 \n"
"路上极为荒凉，可谓万径人踪灭。不见任何飞禽走兽。\n"
	);


	set("exits", ([
		"southdown" : __DIR__"lianhua",
		"eastup" : __DIR__"road2",
	]));
			setup();
	replace_program(ROOM);

}

