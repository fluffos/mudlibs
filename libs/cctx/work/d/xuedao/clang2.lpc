inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIW "内长廊" NOR);
  set("long",
    "一条长长的走廊，南边吹来阵阵凉风，隐约可以可以看到皑皑白雪。几条走廊\n"
    "围绕着一个红色的池子。仿是满池的鲜血，看之胆寒。\n"
  );

  set("exits", ([

    "south": __DIR__ "clang1",
    "north": __DIR__ "jitai",
  ]));
  setup();

}
