// damen 血刀门
// by congw
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIR "祭台" NOR);
  set("long",
    "这里就是血刀门祭天的大广场了，每月月圆之夜都会有祭天仪式，这样才可以 \n" +
    "血刀门的弟子武功精进，使得血刀弟子杀气大盛，练出的刀法也是霸气令人发指。\n"
    "因此有许多的弟子从外面带回鲜活的死人回来祭台。以增加自己的刀气。\n"
  );


  set("exits", ([
    "south": __DIR__ "clang2",
    "northdown": __DIR__ "tzfang",
    "east": __DIR__ "tianditang",
    "west": __DIR__ "daotang",
  ]));
  set("objects", ([
    __DIR__ "npc/wanbao": 1,
    __DIR__ "npc/xdseng": 2,
  ]));
  setup();

}
