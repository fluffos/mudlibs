inherit ITEM;
int do_du(string arg);

void init() {
  add_action("do_du", "du");
}

void create() {
  set_name("神照经", ({ "book" }));
  set("value", 1000);


  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "\n一本经书,封皮(binding)很旧。\n");
    set("unit", "本");
    set("material", "paper");
  }
  setup();
}


int do_du(string arg) {
  int i, jing_cost;
  object me;
  me = this_player();

  if (!arg || arg == "") return 0;

  if (arg == "book" && me->query_skill(
    "literate",
    1
  ) > 60 && me->query_skill("shenzhao-shengong", 1) < 250) {

    jing_cost = 300 / (int)me->query("int");
    if ((int)me->query("jing") < jing_cost) return 0;

    me->improve_skill("shenzhao-shengong", (int)me->query("int"));
    message_vision("$N拿出一本发黄的小册子仔细阅读，又冥思苦想。\n", me);
    me->receive_damage("jing", 15); return 1;
  }
}
