#include <ansi.h>
inherit ITEM;
void setup()
{}
void init()
{
add_action("do_eat", "eat");
}
void create()
{
set_name(HIW"消食健胃片"NOR, ({"jianwei pian", "pian"}));
if (clonep())
            set_default_object(__FILE__);
else {
set("unit", "颗");
set("long",HIW"⒙⒙\n"NOR);
}
setup();
}
int do_eat(string arg)
{
object me = this_player();
if (!id(arg))
return notify_fail("你要吃什么？\n");
message_vision("$N又吃下一颗消食健胃片，咕噜咕噜放了几个响屁，觉得舒服多了。\n" , me);
destruct(this_object());
me->add("combat_exp", 10000);
return 1;
}
