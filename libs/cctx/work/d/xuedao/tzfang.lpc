// damen 血刀门obn = new(__DIR__"../obj/nuerxiang");
// by congw
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIW "屠宰房" NOR);
  set("long",
    "这里横七竖八的放着些铡刀和菜刀，血刀门日子好过便杀猪吃，日子不好过时\n"
    "也只好杀人吃了，案板上放着些鲜血淋漓的" + HIR "肉" NOR + "(Rou)。\n"
  );
  set("no_fight", 1);
  set("objects", ([
    __DIR__ "npc/waiter": 1,
  ]));

  set("exits", ([
    "southup": __DIR__ "jitai",
    "north": __DIR__ "chufang",
    "west": __DIR__ "zhujuan",
    "east": __DIR__ "zawujian",
  ]));
  setup();
  replace_program(ROOM);

}
