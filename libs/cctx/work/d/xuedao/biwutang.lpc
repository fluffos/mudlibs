inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIW "比武堂" NOR);
  set("long",
    "血刀门在江湖上虽为正派武林人士所不齿，但在武功上却不断上进，经常有血 \n" +
    "刀门的弟子在这里切蹉武技，互相学习。\n"
  );


  set("exits", ([
    "south": __DIR__ "lianyaotang",
    "north": __DIR__ "tianditang",
  ]));
  set("objects", ([
    __DIR__ "npc/yousheng": 1,
  ]));

  setup();

}
