inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "兵器堂");
  set("long",
    "这里是血刀门放置兵器的地方，到处放着锈迹癍癍的刀剑。墙角上有一排兵器 \n" +
    "架。\n"
  );


  set("exits", ([
    "south": __DIR__ "tianditang",
  ]));
  set("objects", ([

    __DIR__ "obj/gangdao": 3,
    __DIR__ "obj/armor": 3,
  ]));

  setup();
  replace_program(ROOM);

}
