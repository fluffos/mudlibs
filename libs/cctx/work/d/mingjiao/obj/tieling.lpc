// tieling.c 铁令

#include <weapon.h>
inherit LINGFA;

void create()
{
        set_name("铁令", ({ "tieling", "ling" }));
        set_weight(200);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", "这是一只普通的铁令，由精铁打造而成，握在手里沉甸甸的。\n");
                set("value", 500);
                set("material", "iron");
                set("wield_msg", "$N「唰」的一声，抽出一只$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插回腰间。\n");
        }
        init_lingfa(25);
        setup();
}

