// Room: /heichao/dadian
// netkill /98/8/11

inherit ROOM;

void create() {
  set("short", "大殿");
  set("long", @LONG
这里是黑潮会的大殿，左右四道大门(men)，通向黑潮的八个
分堂前面设一宝座，是黑潮的老大之座。这里冷冷清清，却又透
着一种神秘，往前去则是后殿。
LONG
  );

  set("exits", ([


    "south": __DIR__ "qiandian",
    "north": __DIR__ "huodian",
  ]));


  set("item_desc", ([
    "men": "左一(l1):  暗黑堂。\n" +
    "左二(l2):  明黑堂。\n" +
    "左三(l3):  侠黑堂。\n" +
    "左四(l4):  义黑堂。\n" +
    "右一(r1):  天潮堂。\n" +
    "右二(r2):  地潮堂。\n" +
    "右三(r3):  神潮堂。\n" +
    "右四(r4):  鬼潮堂。\n",
  ]));

  setup();




}

void init() {
  add_action("do_enter", "go");
  UPDATE_D->check_user(this_player());
}

int do_enter(string arg) {
  object me;
  me = this_player();

  if (!arg || arg == "") return 0;

  switch (arg) {

    case "l1": me->move(__DIR__ "anhei"); return 1;
    break;
    case "l2": me->move(__DIR__ "minghei"); return 1;
    break;
    case "l3": me->move(__DIR__ "xiahei"); return 1;
    break;
    case "l4": me->move(__DIR__ "yihei"); return 1;
    break;
    case "r1": me->move(__DIR__ "tianchao"); return 1;
    break;
    case "r2": me->move(__DIR__ "dichao"); return 1;
    break;
    case "r3": me->move(__DIR__ "shenchao"); return 1;
    break;
    case "r4": me->move(__DIR__ "guichao"); return 1;
    break;

  }


}
