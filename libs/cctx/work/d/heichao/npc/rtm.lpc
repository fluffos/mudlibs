#include <ansi.h>

inherit F_MASTER;
inherit F_UNIQUE;
inherit NPC;

void greeting(object ob);
void create() {
  seteuid(getuid());
  set_name("天边云", ({ "tian bianyun", "tian", "bianyun" }));
  set("nickname", WHT "御风掣电" NOR);
  set("long", "    黑潮的创始人之一，义拨云天，曾在江湖叱咤千秋，传闻武功十分了得。\n"
    + "匿迹江湖几秋，几被世人遗忘。后闻他一心苦读已得天道，朱熹曾寻访到他，\n"
    + "与之谈古论今，世事兴衰，其言令朱熹钦佩不已。他行踪不定，浮云四海。\n");
  set("title", "黑潮 托塔天王");
  set("gender", "男性");
  set("age", 20);
  set("shen_type", 1);
  set("attitude", "friendly");

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("qi", 3050);
  set("max_qi", 3050);
  set("jing", 3050);
  set("max_jing", 3050);
  set("neili", 5000);
  set("max_neili", 5000);
  set("jiali", 120);

  set("combat_exp", 29900000);
  set("score", 555000);

  set_skill("force", 999);
  set_skill("unarmed", 999);
  set_skill("dodge", 999);
  set_skill("parry", 999);
  set_skill("hand", 999);
  set_skill("sword", 999);
  set_skill("blade", 999);
  set_skill("literate", 900);
  set_skill("jiuyang-shengong", 999);
  //    set_skill("qiankun-danuoyi", 999);
  //    set_skill("qishang-quan", 999);
  //    set_skill("wuxue-xinfa", 999);
  set_skill("taiji-quan", 999);
  set_skill("taiji-jian", 999);
  set_skill("taiji-dao", 999);

  map_skill("force", "jiuyang-shengong");
  //	map_skill("dodge", "qiankun-danuoyi");
  //	map_skill("unarmed", "qishang-quan");
  map_skill("hand", "taiji-quan");
  map_skill("sword", "taiji-jian");
  map_skill("blade", "taiji-dao");



  set("chat_chance", 5);
  set("chat_msg", ({
    "天边云愤然说道“MUD大业未成, 同辈仍需努力!”\n",
    "天边云叹道“生亦何欢, 死亦何忧!理想 -- 你在哪里?”\n",
    "天边云悠然道“自某大彻大悟，已然不再练功!这沧海桑田之事已遁然于胸，世间冷暖尽看眼底”\n",
    "天边云道：借问，有谁见到一个魁梧壮汉？\n",

  }));

  set("inquiry", ([
    "黑潮": "黑潮组织游戏人生，娱乐尔等，为人民服务！\n",
    "天道": "啊！你怎知道我是天神转世，岂能留你口实！...姑且让你苟活些时日，先扣你饭票若干！\n",
    "汉子": "小兄弟，你真的见到他了！快告诉我他...唉...终结者来矣！！！\n",
    "未来": "数世代之后将有一场劫难，天地为之变更，人将亡！地狱之门将在当世开启，后世的魔鬼将从此而来..\n",
    "迷题": "我既以得天道，这世间于我自然无秘密可言...玄机道破，世将倾覆...汝有救世良策？\n",
  ]));
  setup();
  carry_object("/d/mingjiao/obj/yitianjian")->wield();
  //        	carry_object("/d/mingjiao/obj/jiaozhumingpao")->wear();
  add_money("gold", 100);
}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  //       if(ob->query("id") == "quake")
  //               command("follow quake");
  if ((int)ob->query("shen") < -50000) {
    command("wield yitian jian");
    command("look " + ob->query("id"));
    command("say 汝当彻悟矣！且随我浮云天涯倾听善良乐音...看招！");
    command("hit " + ob->query("id"));
    command("unwield yitian jian");
  } else if ((int)ob->query("shen") < -5000) {
    command("say 魔从心起，于武学不利，其道必诛，劝君放下屠刀，立地成佛.");
  } else if ((int)ob->query("shen") < -100) {
    command("say 这位朋友，人行江湖，言行当正，切务走进邪魔歪道.");
  } else if ((int)ob->query("shen") >= 0) {
    command("say 光明正道任人走，邪门歪道易失足！劝君多加保重.");
  } else if ((int)ob->query("shen") > 10000) {
    command("say 这位大侠在上，受云一礼，它日必为武林翘楚.");
  }
  return;
}



void attempt_apprentice(object ob) {
  if ((int)ob->query("int") < 30) {
    command("say 你的悟性太低了，不适合师从于我。");
    return 0;
  }
  if ((string)ob->query("gender") != "男性") {
    command("say 你阳气不足，习我功夫恐将走火如魔。");
    return 0;
  }
  if ((int)ob->query("shen") <= 15000) {
    command("say 你应当多作些行侠仗义的事，以修身心。");
    return 0;
  }
  command("say 好，我就收下你这位好兄弟");
  command("say 再接再砺！");
  return;
}

int accept_fight(object ob) {
  if (((int)ob->query("combat_exp") < 30000) && ((int)ob->query("shen") > 0)) {
    message_vision("天边云一拱手说道：这位" + RANK_D->query_respect(ob) +
      "，在下领教了。\n", ob);
    return 1;
  } else {
    message_vision("武林中人最忌争强斗狠，你不是我的对手，回去吧。\n", ob);
    return 0;
  }
}
