#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", YEL "小路" NOR);
	set("long", @LONG
这是一条人迹罕至的小路，两边杂草从生，西面有几间草房
看上去是一家农户，可又十分古怪，透着些蹊跷。
LONG
	);
        set("outdoors", "wudu");

	set("exits", ([
		"west" :__DIR__"caofang",
		"east" : __DIR__"xiaolu",
		
	]));
	setup();
	replace_program(ROOM);

}

