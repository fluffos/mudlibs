#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "草房");
  set("long", @LONG
一间十分简陋的草房，四壁光突突的，什么也没有，墙角堆着
几只藤篓(lou)，几把锄头，看上去有点古怪。南边通着一间厢房。
LONG
  );

  set("exits", ([
    "east": __DIR__ "xiaolu1",
    "south": __DIR__ "caofang1",

  ]));
  set("item_desc", ([
    "lou": "一只藤篓，不知道做什么用。\n",
  ]));
  setup();

}

int init() {
  add_action("do_kick", "kick");
  add_action("do_kick", "fan");
  add_action("do_kick", "move");
  add_action("do_kick", "da");
}

int do_kick(string arg) {
  object me = this_player(), ob;
  if (arg == "" || !arg) return notify_fail("不要乱动别人家的东西\n");
  if (arg == "lou") {
    message_vision("$N刚想去碰那只藤篓，忽然从里面爬出了一尾毒蛇\n", me);
    ob = new(__DIR__ "npc/dushe");
    ob->move(__DIR__ "caofang");
    return 1;
  } else return notify_fail("不要乱动别人家的东西\n");
}
