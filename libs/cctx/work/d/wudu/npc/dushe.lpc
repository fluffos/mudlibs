// 毒蛇 dushe.c

inherit NPC;

void create()
{
	set_name("毒蛇", ({ "du she", "she" }) );
	set("race", "野兽");
	set("age", 1);
	set("long", "一只有毒的花斑蛇。\n");
	set("attitude", "aggressive");
	
	set("limbs", ({ "头部", "身体", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

	set("combat_exp", 100);
//	set("shen_type", 0);

//	set("chat_chance", 6);
//	set("chat_msg", ({
//		(: this_object(), "random_move" :),
//	}) );
	
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 20);
	set_temp("apply/damage", 15);
	set_temp("apply/armor", 10);

	setup();
}

void die()
{
	object ob;
	message_vision("$N蠕动了两下，死了。\n\n", this_object());
	ob = new("/d/wudu/obj/shedan");
	ob->move(environment(this_object()));
	destruct(this_object());
}
	
