inherit ROOM;

void create()
{
	set("short", "黄土路");
	set("long", @LONG
	着是一条坑坑洼洼的土路，弯弯曲曲的通向山脚的小村。
LONG
	);
        set("outdoors", "wudang");

	set("exits", ([
		"southwest" : "/d/gumu/gmroad1",
		"southeast" : "/d/yunhe/matou3",
		"north" : __DIR__"sexit",
	]));

	setup();
	
}
int valid_leave(object me)
{ 
        me->delete_temp("ok");
	me->delete_temp("ok1");
	me->delete_temp("zu");
	return ::valid_leave(me);

}

