//#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
这是一条极为险峻的山路，弯弯屈曲直通山顶，路上十分的不平，
稍不小心就会掉下去，你必需万分小心。向上看去，只见云雾缭绕，
不见峰顶在何处。
LONG
  );
  set("exits", ([
    "westup": __DIR__ "bshanlu1",
    "northdown": __DIR__ "canglong"
  ]));
  set("no_clean_up", 0);
  set("outdoors", "huashan");


  setup();
}
