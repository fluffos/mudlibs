// huading.c 华山仙顶 - 隐居处
// Written by Doing Lu 1999/1/6

inherit RECORDABLE_ROOM;

#include <ansi.h>

void create() {
  set("short", HIW "华山仙顶" NOR);
  set("long", @LONG
	这里是华山之巅，四处白雾茫茫，远望过去，层层云海，笼罩华山群峰，
皆在足下；极目天地，四野无碍，不禁心旷神怡，隐然欲仙，似此仙境，世所罕
见，真是绝佳的隐居之处。
LONG
  );
  set("exits", ([
    "westdown": __DIR__ "sheshen",
  ]));

  set("outdoors", "huashan");

  setup();
}
