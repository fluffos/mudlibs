//inherit NPC;
inherit F_DEALER;

void create() {
  set_name("马夫", ({ "mafu" }));
  set("gender", "男性");
  set("age", 42);
  set("long",
    "他是个马夫满脸风霜，可以看得出来他到过许多地方。\n");
  set("combat_exp", 100);
  set("attitude", "friendly");
  set("no_get", "1");

  set("vendor_goods", ({
    __DIR__ "mapi",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
