#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;

void create()
{
        string *surname=({HIR"枣红",HIM"紫榴",HIW"黄骠",HIC"玉骢"});
        set_name(surname[random(sizeof(surname))]+"马"NOR, ({ "mapi" }) );
        set("race", "野兽");
        set("gender", "雄性");
        set("age", 2+random(3));
        set("long", "这是一匹宝马，日行千里，夜行八百。\n"+
                "玩家可以骑上它去任何地方(ride/down)。\n");
        set("int", 30);
        set("qi", 3000);
        set("max_qi", 3000);
        set("jing", 1000);
        set("max_jing", 1000);
        set("shen_type", 0);
        set("combat_exp",50000);
        set("attitude", "peaceful");

        set("limbs", ({ "头部", "腹部", "尾巴","后腿","前腿" }) );
        set("verbs", ({ "bite","hoof","knock" }) );
        set_temp("apply/attack", 50);
        set_temp("apply/armor", 15);
        set_temp("apply/damage", 25);
        set("value", 10000);

        setup();
}

void init()
{
 add_action("do_ride", "ride");
 add_action("do_down", "down");
 add_action("do_goyz", "goyz");
 add_action("do_gobj", "gobj");
 add_action("do_goca", "goca");
}

int do_ride ()
{
        string dir,dir2;
        object ob = this_player () ;

        if( objectp(query("rider"))) 
        {
                return notify_fail("现在马上已经有人了！\n" ) ;
        }
        else
        {
        ob->set_temp("onhorse",1);
        this_object()->set("rider",this_player());
        message_vision("$N一跃身跨上了马。\n" , ob );
        this_object()->set_leader(this_player());
        command("follow "+ob->query("id"));
        write("请输入要去的地方。例去北京(gobj)\n");
        return 1; 
        }       
}

int do_down()
{
        object ob;
        ob = this_player () ;
        if(!objectp(query("rider"))) return notify_fail("马上没人。\n");
        if(ob->query_temp("onhorse"))
        {
        message_vision("\n$N身行跃下马来，姿态十分优美。\n" , ob );
        delete("rider");
        command("follow none");
        ob->delete_temp("onhorse");
        }
        else 
        switch(random(3))
        {
        case 0: 
        message_vision("\n$N一把把马上的人拉下来，想自己跳上去。\n" , ob );
        command("follow none");
        query("rider")->delete_temp("onhorse");
        delete("rider");
        ob->set_temp("onhorse");
        break;
        case 1: 
        case 2:
        message_vision("\n$N想把马上的人拉下马来,但没有成功。\n" , ob );
        }         
        return 1;
}
#include "goyz.h"
#include "gobj.h"
#include "goca.h"

