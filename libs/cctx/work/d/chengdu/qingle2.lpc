// chengdu/qingle2.c
// Written by Doing Lu  1998

inherit ROOM;

void create()
{
	set("short", "清乐大街");
	set("long", @LONG
	这是一条东西走向的宽阔大街，成都的富户大都聚居在这里，一般的人
不要说住在这里，就是来这里逛逛也不太可能。西面是城中的干道南大街，南北
都是大门紧锁的豪宅，朱红色的大门显示了主人的身份，门口站着几个神气活现
的家丁，几只大狼狗狠狠的瞪着你。
LONG
	);
        set("outdoors", "chengdu");

	set("exits", ([
		"east" : __DIR__"qingle1",
		"south" : __DIR__"mafudamen",
		"west" : __DIR__"nandajie1",
		"north" : __DIR__"niufudamen",
	]));

	set("objects", ([
		__DIR__"npc/mafujiading"  : 2,
		__DIR__"npc/mafulanggou"  : 1,
		__DIR__"npc/niufujiading" : 2,
		__DIR__"npc/niufulanggou" : 2,
	]));

	setup();
}

int valid_leave(object me, string dir)
{
	if (dir == "north" && 
	    objectp(present("niufu jiading", environment(me))) &&
	    ! me->query_temp("enter/牛府"))
	{		
		return notify_fail("牛府家丁大声喝道：干什么！穷小子，滚开！\n");
	}
	if (dir == "south" && 
	    objectp(present("mafu jiading", environment(me))) &&
	    ! me->query_temp("enter/马府"))
	{
		return notify_fail("马府家丁大声喝道：干什么！穷小子，滚开！\n");
	}
	return ::valid_leave(me, dir);
}