inherit ROOM;

void create()
{
	set("short", "贫民居");
	set("long", @LONG
	这里是成都城内贫民居住的地方，贫民大多聚居在西门附近，这里很少
有其他人来。
LONG
	);

	set("exits", ([
		"north" : __DIR__"xidajie3",
	]));

	set("objects", ([
		__DIR__"npc/oldwoman" : 1,
		__DIR__"npc/kid" : 1,
		__DIR__"npc/boy" : 1,
	]));

	setup();
	replace_program(ROOM);
}
