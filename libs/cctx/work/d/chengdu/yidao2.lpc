inherit ROOM;

void create() {
  set("short", "蜀道");
  set("long", @LONG
	这里是四川的驿道，弯弯曲曲的很是难走，从这里往东就是名闻天下的
栈道，西面通往成都。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "southwest": __DIR__ "yidao1",
    "east": __DIR__ "zhandao1",
  ]));

  setup();
}
