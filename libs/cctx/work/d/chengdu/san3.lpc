#include <room.h>
inherit ROOM;

void create() {
  set("short", "祁山山道");
  set("long", @LONG
山道旁是一片小松林，面前出现了一条宽广的石板道，笔直向上通向山
顶。沿道稀稀落落地种着几棵柏树，却显得高大挺拔，蝤龙般的枝干向
天空高高伸展着。山顶被一层淡淡的白雾笼罩着。
LONG
  );
  set("outdoors", "chengdu");
  set("exits", ([
    "eastup": __DIR__ "san5",
    "southdown": __DIR__ "san1",

  ]));

  setup();
}
