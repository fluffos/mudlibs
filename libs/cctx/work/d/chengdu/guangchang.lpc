inherit ROOM;

void create() {
  set("short", "城中心");
  set("long", @LONG
	这里便是成都市主要街道的交汇处，由于多年没有经过战火，这里显得热
闹繁华。从城中向远处眺望，依稀可以看见高大的城墙。而街道上人来人往，也有
一些武林人士，还有一些艺人在广场边上表演杂技。有时也能看见一些穿着号坎的
士兵到处游荡。这个毕竟是三国古都，依稀可以看到往日的恢宏气象。
LONG
  );
  set("no_sleep_room", 1);
  set("outdoors", "chengdu");

  set("exits", ([
    "east": __DIR__ "dongdajie1",
    "south": __DIR__ "nandajie1",
    "west": __DIR__ "xidajie1",
    "north": __DIR__ "beidajie1",
  ]));

  set("objects", ([
    __DIR__ "npc/liumang": 1,
    "/d/npc/jinglei": 1,
    __DIR__ "npc/liumangtou": 1,
    __DIR__ "npc/bing": 1,
    __DIR__ "npc/yiren": 1,
    __DIR__ "npc/xingren": 1,
    __DIR__ "npc/haoke": 1,
  ]));

  setup();
}
