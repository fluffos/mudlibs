inherit ROOM;

void create() {
  set("short", "南门");
  set("long", @LONG
	这是就是成都的南门，由于这里曾是三国故都，因此城墙高大，城门也
显得异常雄伟。向北便可通往城内，南边是通往云南、贵州去道路，十分难走。
城门口站着几个官兵，正盯着来往的行人仔细打量。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "south": "/d/dali/croad10",
    "north": __DIR__ "nandajie3",
  ]));

  set("objects", ([
    __DIR__ "npc/bing2": 2,
    __DIR__ "npc/wujiang": 1,
    __DIR__ "npc/xingren": 1,
  ]));

  setup();
}
