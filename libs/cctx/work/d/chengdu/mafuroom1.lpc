inherit ROOM;

void create()
{
	set("short", "马府厢房");
	set("long", @LONG
	这是马府的厢房。
LONG
	);

	set("exits", ([
		"west"  : __DIR__"mafuyuan",
	]));

	set("objects", ([
		__DIR__"npc/machunhua" : 1,
		__DIR__"npc/yahuan" : 2,
	]));

	setup();
	replace_program(ROOM);
}
