#include <room.h>
inherit ROOM;

void create()
{
	set("short", "官道");
	set("long", @LONG
一条笔直的官道，四周人来人往。挑担子的、行商的，赶着大车的
马夫，上京赶考的书生，熙熙攘攘，非常热闹。不时还有两三骑快
马从身边飞驰而过，扬起一路尘埃。前面就是古都长安城了！远远
的就可以看到长安城的城门了！
LONG
	);
        set("outdoors", "chengdu");
	set("exits", ([
		"east" : "/d/changan/ximen",
		"west" : __DIR__"nroad8",
		"northwest" : "/d/lanzhou/caroad8",
]));

	setup();

	replace_program(ROOM);
}



