inherit ROOM;

void create() {
  set("short", "马府大院");
  set("long", @LONG
	这里是马府的大院，东西有两个厢房，南面有一个大厅。
LONG
  );

  set("exits", ([
    "east": __DIR__ "mafuroom1",
    "south": __DIR__ "mafuroom3",
    "west": __DIR__ "mafuroom2",
    "north": __DIR__ "mafudamen",
  ]));

  set("objects", ([
    __DIR__ "npc/puyi": 1,
    __DIR__ "npc/yahuan": 1,
  ]));

  setup();
  replace_program(ROOM);
}
