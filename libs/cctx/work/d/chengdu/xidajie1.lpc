inherit ROOM;

void create() {
  set("short", "西大街");
  set("long", @LONG
	这是一条宽阔的大街，向东西两头延伸，看起来西大街的人不如其它街
道繁华，可能是处地比较偏僻的缘故，向西通往西门，而东面则是成都城的中心，
那里看起来非常热闹。北面有一个小吃店，多是一些游客和过路的人在那里休息
打尖。南面有一个茶馆，不少人在那里闲聊品茶。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "east": __DIR__ "guangchang",
    "south": __DIR__ "chaguan",
    "west": __DIR__ "xidajie2",
    "north": __DIR__ "xiaodian",
  ]));

  setup();
}
