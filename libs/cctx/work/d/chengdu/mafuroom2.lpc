inherit ROOM;

void create()
{
	set("short", "马府厢房");
	set("long", @LONG
	这是马府里的厢房。
LONG
	);

	set("exits", ([
		"east"  : __DIR__"mafuyuan",
	]));

	set("objects", ([
		__DIR__"npc/xuzheng" : 1,
		__DIR__"npc/puyi" : 1,
	]));

	setup();
	replace_program(ROOM);
}
