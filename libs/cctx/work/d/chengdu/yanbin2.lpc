inherit ROOM;

void create() {
  set("name", "宴宾楼");
  set("short", "宴宾楼二楼");
  set("long", @LONG
	这里是宴宾楼二楼，若要接风洗尘，在这里摆酒席是最好不过的了，你站在
楼上眺望，不远处就是状元楼，北门附近的武侯词与关帝庙也可看得清清楚楚，成都
城中房磷节错，高高低低，别有一番风味。 墙上挂着价格牌子(paizi)，若是要想购
买一些高档食品点心，可以和小二说。在大厅四周的走廊分别通向各个雅间，里面不
断传来划拳喝彩的声音。
LONG
  );

  set("item_desc", ([
    "paizi": "本店出售烤鸭，全兴酒。\n",
  ]));

  set("objects", ([
    __DIR__ "npc/xiaoer5": 1,
  ]));

  set("exits", ([
    "down": __DIR__ "yanbin",
  ]));

  setup();
}
