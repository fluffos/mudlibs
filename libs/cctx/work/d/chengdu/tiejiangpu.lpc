inherit ROOM;

void create()
{
	set("short", "铁匠铺");
	set("long", @LONG
	这是一家简陋而又常见的铁匠铺，中心摆着一个火炉，炉火把四周照得一
片通红，你一走进去就感到浑身火热。墙角堆满了已完工和未完工的菜刀、铁锤、
铁棍等物。一位铁匠满头大汗挥舞着铁锤，专心致志地在打铁。
LONG
	);

	set("exits", ([
		"south" : __DIR__"dongdajie2",
	]));
        set("objects", ([
                 __DIR__"npc/tiejiang": 1,]));

	setup();
	replace_program(ROOM);
}
