inherit ROOM;

void create() {
  set("short", "牛府大门");
  set("long", @LONG
	这里是成都的著名富户，牛穆仁的豪宅。院子里假山鱼池，一应俱全。
远看去房屋嶙次节比，。层层叠叠，果然是气派非凡。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "south": __DIR__ "qingle2",
    "north": __DIR__ "niufuyuan",
  ]));

  setup();
  replace_program(ROOM);
}
