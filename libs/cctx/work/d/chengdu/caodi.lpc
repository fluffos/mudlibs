#include <room.h>
inherit ROOM;

void create() {
  set("short", "草地");
  set("long", @LONG
这是一片芳草地，落英缤纷，蜂歌蝶舞，朝露夕光，沁人心脾几个小姑
娘莺声曼影，顽皮可人，宛如三月桃李，腊冬嫩梅，惹人怜爱。任你是
江湖豪杰，走到这里，心中也平添几寸温柔少却三分杀意。
LONG
  );
  set("outdoors", "chengdu");
  set("exits", ([
    "southwest": __DIR__ "nroad3",
    "west": __DIR__ "sanjiao",
  ]));

  setup();
}
