// chengdu/zhandao6.c
// Written by Doing Lu 1998

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "栈道");
  set("long", @LONG
	这是进出四川的主要通路，栈道下方是深达千尺的深涧，真是难以想象
当初是如何造出这栈道来的。两旁尽是崇山峻岭，险要之极。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "south": __DIR__ "zhandao5",
    "northeast": __DIR__ "zhandao7",
  ]));

  setup();
}

void init() {
  object me;
  int dp;

  me = this_player();

  if (objectp(me)) {
    dp = me->query_skill("dodge");
    if (random(dp) + dp < 40) {
      message_vision(HIR "$N走着走着，扑通摔了一个大跟斗，狼狈不堪。\n" NOR, me);
      me->receive_damage("qi", random(50) + 20);
    }
  }
}
