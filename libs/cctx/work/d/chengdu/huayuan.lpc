inherit ROOM;

void create() {
  set("short", "花园");
  set("long", @LONG
	谁能想到在如此荒凉的民居里、竟然有如此景观。小院里到处开满了鲜花
，你仔细看去，才发现这些鲜花并非是一个季节的。究竟谁有如此能力竟然能让花
儿随心所欲地开放？
LONG
  );

  set("exits", ([
    "north": __DIR__ "minju2",
  ]));

  set("objects", ([
    __DIR__ "npc/shenni": 1,
  ]));

  setup();
}
