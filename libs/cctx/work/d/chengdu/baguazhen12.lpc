#include <ansi.h>

inherit ROOM;

int get_out(object);

void create()
{
	set("short", "八卦阵");
	set("long", @LONG
	这里是阴森森的地下暗道，只有昏暗的灯光，没有任何出口，附近立着
一块石碑，上书：八卦阵不可擅入，请速回。
LONG
	);

	setup();
}

void init()
{
	remove_call_out("get_out");
	call_out("get_out", 1, this_player());
}

int get_out(object me)
{
	write(HIY "你眼前一黑，只觉得四周变化无穷，忽然发现你已出了八卦阵。\n" NOR);
	me->move("/d/chengdu/wuhouci2");
	message("vision", me->query("name") + "突然出现在你的眼前，吓了你一跳。\n",
		environment(me), ({me}));
}