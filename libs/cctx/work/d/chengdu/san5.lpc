#include <room.h>
inherit ROOM;

void create()
{
    set("short", "祁山山道");
    set("long", @LONG
山道边是一片松林，面前是一条宽广的石板道，笔直向上通向山顶。沿
道稀稀落落地种着几棵柏树，却显得高大挺拔，蝤龙般的枝干向天空高
高伸展着。山顶被一层淡淡的白雾笼罩着。
LONG
    );
    set("outdoors", "chengdu");
    set("exits", ([
        "northup" : __DIR__"san6",
        "westdown" : __DIR__"san3",


]));

      setup();
    replace_program(ROOM);
}

