inherit ROOM;

void create() {
  set("short", "牛府正厅");
  set("long", @LONG
	这是牛府的正厅，是主人会客的地方。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "south": __DIR__ "niufuyuan",
    "north": __DIR__ "niufuhouyuan",
  ]));

  set("objects", ([
    __DIR__ "npc/niumuren": 1,
    __DIR__ "npc/yahuan": 1,
    __DIR__ "npc/puyi": 1,
  ]));

  setup();
  replace_program(ROOM);
}
