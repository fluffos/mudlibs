// chengdu/baguazhen10.c
// Written by Doing Lu  1998
inherit ROOM;

#include <ansi.h>

void to_die(object me);
void show_danger(object me);

string *die_msg = ({
  "突然一阵乱箭射来，纵使你武功盖世也无处躲藏，霎时你就被射成了刺猬。\n",
  "忽然一阵巨响，无数的石头跌落下来，直把你砸得晕头转向，不知所以。\n",
  "一阵轰隆隆的水声震耳欲聋，原来是地下水涌了进来，你再也喘不过气来。\n",
  "忽然火光四起，熊熊大火将你包在中间，你眼前尽是火苗飞舞。\n",
  "轰的一声，四面的土壁塌了下来，把你埋在其中。\n",
});


void create() {
  set("short", "八卦阵");
  set("long", @LONG
	这里是阴森森的地下暗道，只有昏暗的灯光，没有任何出口，你似乎迷
失了方向。旁边立了一块石碑，上书：擅入者死。
LONG
  );

  setup();
}

void init() {
  object me;

  me = this_player();

  remove_call_out("show_danger");
  call_out("show_danger", 0, me);
  me->start_busy(3);

}

void show_danger(object me) {
  tell_object(me, HIR "你一走到这里，就发觉不妙。\n\n" NOR);
  remove_call_out("to_die");
  call_out("to_die", 1, this_player());
}

void to_die(object me) {
  write(die_msg[random(sizeof(die_msg))]);
  write("\n你心中暗叫：不好，吾命休矣！\n");
  write(RED "\n你再也看不见任何东西了......\n" NOR);
  me->die();
}
