// chengdu/minju2.c
// Written by DOing Lu  1998

inherit ROOM;

void create() {
  set("short", "民居");
  set("long", @LONG
	这里是成都东门附近的住家，两扇紧闭的大门略显些陈旧，看来好象很久
没有人出入了，也不知道里面究竟有没有人住。
LONG
  );

  set("exits", ([
    "north": __DIR__ "dongdajie3",
  ]));

  setup();
}

void init() {
  add_action("do_knock", "knock");
  add_action("do_break", "break");
}

int do_knock(string arg) {
  if (!arg) return notify_fail("你想敲空气吗？那是敲不出声音来的！\n");
  if (arg != "门" && arg != "men" && arg != "gate")
    return notify_fail("你敲了一下自己的脑袋，不知道你想干什么？\n");
  message_vision("$N走到门前，轻轻的叩了一下门。\n", this_player());
  message_vision("但是里面没有任何反应。\n", this_player());
  return 1;
}

int do_break(string arg) {
  object me;
  object ob;
  object room;

  me = this_player();
  if (!arg) return notify_fail("你对空气大喝一声：开！人家以为你是傻瓜！\n");
  if (arg != "门" && arg != "men" && arg != "gate")
    return notify_fail("你题了一脚，显得百无聊赖。\n");
  if (query("exits/south")) {
    write("门已经破了。\n");
    return 1;
  }
  message_vision("$N对着门一脚踹去。\n", this_player());
  if (me->query("qi") < 250) {
    message_vision("只听砰的一声，$N痛的嗷嗷直叫，但是门纹丝不动。\n", this_player());
    return 1;
  }
  message_vision("嘭的一声巨响，$N把门踹开了。\n", this_player());

  set("exits/south", __DIR__ "huayuan");

  room = find_object("/d/chengdu/huayuan");
  if (!room) room = load_object("/d/chengdu/huayuan");

  if (ob = present("wei ke", room)) {
    message_vision("突然一个黑影飘了出来，身法极快，似梦似幻，难以捉摸。\n", me);
    ob->move("/d/chengdu/minju2");
    ob->follow_and_kill(me);
  }

  return 1;
}
