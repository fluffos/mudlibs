// chengdu/guandimiao.c
// Written by Doing Lu 1998

#include <ansi.h>
inherit ROOM;

int do_hui(string);

void create()
{
	set("short", "关帝庙");
	set("long", @LONG
	这是祭祀武圣关帝的庙宇，想当年，关公自从和刘张桃园三结义后，重
言守义，不论是流落曹营还是千里走单骑，从来都是光明磊落，没做出半点背信
弃义之事，天下豪杰无不为之折服。关帝武功绝伦，先温酒斩华雄、后斩颜良，
诛文丑、过五关，斩六将，勇不可当，更有三英战吕布之佳话，实是习武人之偶
像。庙宇中关羽侧卧床前，正读春秋；旁边关平在左护卫，右侧周仓抱青龙偃月
刀(dao)侍立一旁。
LONG
	);

	set("no_fight", "1");
	set("no_steal", "1");
	set("no_sleep_room", "1");
	set("valid_startroom", 1);

	set("exits", ([
		"east" : __DIR__"beidajie3",
	]));

	set("item_desc", ([
		"dao" : "这是关公纵横天下所使用的兵器，名青龙偃月，重达八十二斤，你看了也忍不住想挥舞一下。\n",
	]));

	setup();
}

int init()
{
	add_action("do_hui", "hui");
}

int do_hui(string arg)
{
	object me;

	me = this_player();

	if (!arg) return notify_fail("你想干啥？\n");

	if (arg != "dao" && arg != "青龙偃月刀") return notify_fail("你想挥什么？\n");


	if (me->query_str() < 20 || me->query("qi")<200)
	{
		message_vision("$N拿起青龙偃月刀，使劲力气挥舞了一阵，累了个半死。\n", me);
		me->set("qi", 10);
		return 1;
	}

	if (me->query_str() < 35)
	{
		message_vision("$N大喝一声，举起青龙偃月刀，挥舞一阵，累的气喘吁吁。\n", me);
		tell_object(me, "你对使用力量似乎有点心得。\n");
		me->improve_skill("unarmed", me->query("unarmed") / 10 + 1);
		me->set("qi", 10);
		return 1;
	}

	message_vision("$N深吸一口气，大喝一声，举起青龙偃月刀，使出一套刀法，威猛之极。\n", me);
	tell_object(me, "你对力量和刀法似乎有点心得。\n");
	me->improve_skill("unarmed", me->query_skill("unarmed") / 5 + me->query("str") + 1);
	me->improve_skill("blade", me->query_skill("blade") / 5 + me->query("str") + 1);
	me->set("qi", 10);	
	return 1;
}