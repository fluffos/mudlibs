inherit ROOM;

void create() {
  set("short", "书院");
  set("long", @LONG
	这里是成都的一个书院，平时很多的文人墨客都到这里聚会，在这里讲书
的乃是当年赫赫有名的凤雏先生，若有什么疑问大可以向他请教。庞统先生虽然才
高九斗，但是从来不修篇幅，一身道袍破破烂烂，手中的羽扇也是黑乎乎的，但是
他一肚子学问可是古往今来少有人及的。
LONG
  );

  set("exits", ([
    "east": __DIR__ "beidajie1",
  ]));

  set("objects", ([
    __DIR__ "npc/pangtong": 1,
  ]));

  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
