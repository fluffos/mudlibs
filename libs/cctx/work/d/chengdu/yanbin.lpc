inherit ROOM;

void create() {
  set("short", "宴宾楼");
  set("long", @LONG
	宴宾楼是成都里几个有名的大酒楼之一，当有客自远方来，少不得在此
接风洗尘。在宴宾楼上，可以眺望成都全景，武侯祠，关帝庙等尽可一收眼底。
楼下都是一些外买小点，多是一些来往的游客行人光顾。楼上是摆酒宴的地方。
LONG
  );

  set("valid_startroom", 1);

  set("exits", ([
    "west": __DIR__ "beidajie1",
    "east": __DIR__ "majiu",
    "up": __DIR__ "yanbin2",
  ]));

  set("objects", ([
    __DIR__ "npc/xiaoer4": 1,
  ]));

  setup();
}
