inherit ROOM;

void create() {
  set("short", "南大街");
  set("long", @LONG
	这是一条宽阔的大街，向南北两头延伸，由于这里以处于外城的地界，
因此人显得不如城里的人多。东面看来是一家药铺，里面传来一股浓烈的中药气
味，西边则是一家当铺，招牌上面写着开源典当四个大字，看来是生意兴隆。北
面通往城中心，很是热闹，往南走就快到城门了。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "east": __DIR__ "yaopu",
    "south": __DIR__ "nandajie3",
    "west": __DIR__ "kaiyuan",
    "north": __DIR__ "nandajie1",
  ]));

  set("objects", ([
    __DIR__ "npc/xingren": 2,
  ]));

  setup();
}
