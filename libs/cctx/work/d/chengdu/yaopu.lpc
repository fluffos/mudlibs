inherit ROOM;

void create() {
  set("short", "药铺");
  set("long", @LONG
	这里是一家很普通的药铺，到处弥漫这一股中药的气味。有一些顾客向药
铺伙计问这问那，不知道在打听什么。几个小伙计在柜台后面忙着取药，称重。柜
台上放着一份清单，列出一些药品名字，其中有成药，也有一些中成药。
LONG
  );

  set("no_fight", 1);
  set("no_beg", 1);
  set("objects", ([
    __DIR__ "npc/huoji": 1,
    __DIR__ "npc/guke": 3,
  ]));

  set("exits", ([
    "west": __DIR__ "nandajie2",
  ]));

  setup();
  replace_program(ROOM);
}
