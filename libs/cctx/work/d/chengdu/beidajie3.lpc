inherit ROOM;

void create() {
  set("short", "北大街");
  set("long", @LONG
	这是一条宽阔的大街，向南北两头延伸，往北就是城门了，从那里出去
可以去陕西，所以来往的行人，商人都很多。东面是武侯祠，供奉着三国时的名
相诸葛亮。而西面相对的则是三国时的蜀国大将，武帝关羽的庙堂。平时很多仰
慕者都到那里祭祀。往南则通往城内。
LONG
  );

  set("exits", ([
    "east": __DIR__ "wuhouci",
    "south": __DIR__ "beidajie2",
    "west": __DIR__ "guandimiao",
    "north": __DIR__ "beimen",
  ]));

  set("objects", ([
    __DIR__ "npc/xingren": 3,
  ]));

  setup();
  replace_program(ROOM);
}
