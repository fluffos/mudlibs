inherit ROOM;

int get_out(object);

void create() {
  set("short", "八卦阵");
  set("long", @LONG
	这里是八卦阵的中心，你松了一口气，终于走出了这个危机四伏的阵法。
这里虽然光线不是很好，但是还是可以勉强看得清楚，周围都是石壁，非常坚固，
眼前摆着一个石桌，上面有一本书。桌后坐着有一个人，脸观如玉，头带朝天冠，
身披道袍，右手持羽扇，左指微掐，似乎在算计什么。你不禁大吃一惊，仔细看
来才发现这不过是一个木像而已，栩栩如生，当真令人匪夷所思。可能当初吓退
司马懿的就是这个木像。

LONG
  );

  set("exits", ([
    "up": __DIR__ "wuhouci2"
  ]));

  set("objects", ([
    __DIR__ "obj/wuhoumiji": 1,
  ]));

  setup();
}
