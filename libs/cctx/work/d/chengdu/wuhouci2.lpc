// chengdu/wuhouci2.c
// Written by Doing Lu 1998

#include <ansi.h>
inherit ROOM;

int	do_move(string arg);

void create()
{
	set("short", "武侯祠后室");
	set("long",@LONG
	这里是武侯词的后室，空荡荡的什么也没有，只是墙角放了一个香炉。
LONG	
	);

	set("exits", ([
		"south" : __DIR__"wuhouci",
	]));

	setup();
}

void init()
{
	add_action("do_move", "move");
}

int do_move(string arg)
{
	object me;

	me = this_player();
	if (! arg)
	{
		write("你想搬什么？\n");
		return 1;
	}
	if (arg != "香炉")
	{
		message_vision("$N伸手乱舞了一会，不知道想干什么。\n", me);
		return 1;
	}
	if (query("exits/down"))
	{
		message_vision("$N用力推了推香炉，香炉动了动，突然滑回原处。\n", me);
		delete("exits/down");
		return 1;
	}
	if (! query("move"))
	{
		set("move", 1);
		message_vision("$N用力推了推香炉，好容易向边上推动了一点。\n", me);
		return 1;
	}
	add("move", 1);
	if (query("move") < 10)
	{
		message_vision("$N用力推了推香炉，好容易又向边上推动了一点。\n", me);
		return 1;
	}
	message_vision("$N推了一下香炉，突然轰隆隆的响了一阵，地面出现了一个可供一个人出入的洞口。\n", me);
	delete("move");
	set("exits/down", __DIR__"baguazhen1");
 	return 1;
}
