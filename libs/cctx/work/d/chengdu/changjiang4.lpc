// chengdu/changjiang4.c
// Written by Doing Lu 1998

#include <ansi.h>

inherit ROOM;
int jump();

void create()
{
	set("short", "三峡下游");
	set("long", @LONG
	这里是三峡的下游，水流要比三峡缓和得多了，往东便是重镇宜昌，那
里地处水陆交汇的要道，自东向西的水运交通和自南向北的陆路交通都要经过那
里。西行便是名闻天下的三峡。船两边是平缓的江水，不知道跳下去(jump)会怎
么样。
LONG	);

        set("outdoors", "chengdu");

	set("no_fight", "1");
	set("no_steal", "1");
	set("no_sleep_room", "1");

	set("objects", ([
		__DIR__"npc/chengke" : random(3) + 1,
	]));

	setup();
}

void init()
{
	object me;

	me = this_player();

	me->set_temp("stay/长江", 1);
	me->delete_temp("jump/长江");
	remove_call_out("going");
	call_out("going", 1);

	add_action("do_jump", "jump");
}

int do_jump()
{
	object me;
	
	me = this_player();

	message_vision("$N纵身一越，跳到了江中。\n掌舵的船夫们和乘客齐声惊呼。\n", me);
	message_vision(HIB "扑通一下，$N投入水中。\n" NOR, me);
	me->start_busy(1);

	me->start_call_out((: call_other, __FILE__, "go_back", me :), 1);
	me->set_temp("jump/长江", 1);
	
	return 1;
}

int go_back(object me)
{
	tell_object(me, HIG "你心中暗叫：不好，我得赶快回到船上去。\n" NOR);
	if (me->query_skill("dodge") < 80)
	{
		message("vision", HIR "$N在江中挣扎了很久，一个浪头打了过来，$N就不见了。\n" NOR,
			environment(me),({me}));
		tell_object(me, HIR "你挣扎了很久，一个浪头打了过来，你就什么也看不见了......\n" NOR);
		if (wizardp(me))
		{
			tell_object(me, "\n你醒来才知道是上帝救了你一条小命。\n");
		} else
		{
			me->die();
		}
	} else
	{
		message_vision(HIC "$N提气一纵，足尖在水面上轻轻一点，身形一晃，已回到了船上，身法奇妙，众人齐声喝彩。\n" NOR, me);
		if (me->query_skill("dodge",1) < 120)
		{	
			tell_object(me, "你对轻功略有领悟。\n");
			me->improve_skill("dodge", me->query_skill("dodge") / 12 + 1);
		}
	}
	me->delete_temp("jump/长江");
}

int to_next(object me)
{
	if (me->query_temp("come from") == "changjiang3")
	{
		me->delete_temp("come from", "changjiang4");
		tell_object(me, "\n终于到了......\n\n");
		me->delete_temp("stay/长江");
		me->move("/d/yichang/matou");
	} else
	if (me->query_temp("come from") == "matou")
	{
		me->set_temp("come from", "changjiang4");
		tell_object(me, "\n船继续向上游航行......\n\n");
		me->move("/d/chengdu/changjiang3");
	}
}

int going()
{
	object* all_player;
	object me;
	int i;

	all_player = all_inventory(this_object());

	for (i = 0; i < sizeof(all_player); i++)
	{
		if (interactive(me = all_player[i]))
		{
			me->add_temp("stay/长江", 1);
			if (me->query_temp("stay/长江") >= 3 && ! me->query_temp("jump/长江"))
			{
				to_next(me);
			} else
			{
				tell_object(me, HIB "\n哗~   哗~   哗~\n" NOR);
			}
		}
	}

	call_out("going", 1);
	return 1;
}
