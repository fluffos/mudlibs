inherit ROOM;

void create()
{
	set("short", "开源典当");
	set("long", @LONG
	这是成都城中最有名的当铺，已经有上百年的历史。百年来，真可谓财源
滚滚，不负开源的名称。柜台后有几个伙计忙得不可开交，旁边坐着一个朝奉，正
在拨拉着算盘算帐。
LONG
	);

	set("no_fight", 1);
