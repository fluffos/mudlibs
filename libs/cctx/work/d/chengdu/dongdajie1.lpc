inherit ROOM;

void create() {
  set("short", "东大街");
  set("long", @LONG
	这是一条宽阔的大街，向东西两头延伸，西边人声嘈杂，那里通往城中
心，北边是一个酒楼，里面觥筹交错，人声鼎沸，南边看来就不象是一个正经的
去处。往东通往外城。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "east": __DIR__ "dongdajie2",
    "south": __DIR__ "cuifangyuan",
    "west": __DIR__ "guangchang",
    "north": __DIR__ "zhuangyuan1",
  ]));

  set("objects", ([
    __DIR__ "npc/xingren": 2,
  ]));

  setup();
  replace_program(ROOM);
}
