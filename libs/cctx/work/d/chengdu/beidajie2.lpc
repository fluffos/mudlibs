inherit ROOM;

void create() {
  set("short", "北大街");
  set("long", @LONG
	这是一条宽阔的大街，向南北两头延伸，往北去有武侯祠和关帝庙。南
面通往城内，东面有一家金铺，专卖各类金饰品。而西面有一个武器铺，据说卖
些武器，防具，许多武林人士都喜欢去那里买些东西。
LONG
  );

  set("exits", ([
    "east": __DIR__ "jinpu",
    "south": __DIR__ "beidajie1",
    "west": __DIR__ "wuqidian",
    "north": __DIR__ "beidajie3",
  ]));

  set("objects", ([
    __DIR__ "npc/xingren": 1,
  ]));

  setup();
}
