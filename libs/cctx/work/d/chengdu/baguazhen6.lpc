inherit ROOM;

void create()
{
	set("short", "八卦阵");
	set("long", @LONG
	这里是阴森森的地下暗道，只有昏暗的灯光，到处都有出口，你似乎迷
失了方向。
LONG
	);

	set("exits", ([
		"east" :      __DIR__"baguazhen7",
		"southeast" : __DIR__"baguazhen11",
		"south" :     __DIR__"baguazhen10",
		"southwest" : __DIR__"baguazhen11",
		"west" :      __DIR__"baguazhen12",
		"northwest" : __DIR__"baguazhen11",
		"north" :     __DIR__"baguazhen11",
		"northeast" : __DIR__"baguazhen11",
	]));

	setup();
	replace_program(ROOM);
}
