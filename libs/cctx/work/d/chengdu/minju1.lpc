// chengdu/minju1.c
// Written by DOing Lu  1998

inherit ROOM;

void create() {
  set("short", "民居");
  set("long", @LONG
	这里是成都东门附近的住家，两扇紧闭的大门略显些陈旧，围墙也有一些
地方崩坏了，但是看来这个住家还算是小康之家。从内院隐隐约约传来人说话的声
音。
LONG
  );

  set("exits", ([
    "south": __DIR__ "dongdajie3",
  ]));

  setup();
}

void init() {
  add_action("do_knock", "knock");
  add_action("do_break", "break");
}

int do_knock(string arg) {
  if (!arg) return notify_fail("你想敲空气吗？那是敲不出声音来的！\n");
  if (arg != "门" && arg != "men" && arg != "gate")
    return notify_fail("你敲了一下自己的脑袋，不知道你想干什么？\n");
  message_vision("$N走到门前，轻轻的叩了一下门。\n", this_player());
  if (query_temp("coming") == 1) {
    message_vision("来了~\n", this_player());
    set_temp("coming", 2);
    return 1;
  }
  if (query_temp("coming") == 2) {
    message_vision("马上就来，别急~\n", this_player());
    return 1;
  }
  remove_call_out("open_gate");
  call_out("open_gate", 1, this_player());
  set_temp("coming", 1);
  return 1;
}

int do_break(string arg) {
  object me;
  me = this_player();
  if (!arg) return notify_fail("你对空气大喝一声：开！人家以为你是傻瓜！\n");
  if (arg != "门" && arg != "men" && arg != "gate")
    return notify_fail("你题了一脚，显得百无聊赖。\n");
  if (query("exits/north")) {
    write("门已经破了。\n");
    return 1;
  }
  message_vision("$N对着门一脚踹去。\n", this_player());
  if (me->query("qi") < 150) {
    message_vision("只听砰的一声，$N痛的嗷嗷直叫，但是门纹丝不动。\n", this_player());
    return 1;
  }
  message_vision("嘭的一声巨响，$N把门踹开了。\n", this_player());
  message_vision("只听见里面一阵骚动，显然已经发现了$N这个不速之客。\n", this_player());

  set("exits/north", __DIR__ "xiaoyuan");

  return 1;
}

void open_gate(object me) {
  delete_temp("coming");
  message_vision("一个老家人打开了门，对$N看了看。\n", this_player());
  message_vision("老家人说：对不起，我家主人现在不想见客，您请回吧。\n", this_player());
  return;
}
