// Written by Doing Lu  1998

inherit NPC;

int got_weapon();

void create()
{
	set_name("徐诤", ({ "xu zheng", "xu" }));
	set("age", 21);
	set("gender", "男性");
	set("long", "他是马行空的徒弟，常年随马行空走镖。\n");
	set("attitude", "peaceful");

	set("qi", 600);
	set("max_qi", 600);
	set("jing", 300);
	set("max_jing", 300);
	set("neili", 500);
	set("max_neili", 500);
	set("jiali", 20);

	set("str", 22);
	set("dex", 20);
	set("con", 20);
	set("int", 20);
 
	set("combat_exp", 30000);
	set("shen_type", 1);

	set_skill("unarmed", 60);
	set_skill("blade", 50);
	set_skill("force", 50);
	set_skill("dodge", 40);
	set_skill("huntian-qigong", 50);
	set_skill("wuhu-duanmendao", 50);
	set_skill("xiaoyaoyou", 40);

	map_skill("force", "huntian-qigong");
	map_skill("dodge", "xiaoyaoyou");
	map_skill("blade", "wuhu-duanmendao");
	map_skill("parry", "wuhu-duanmendao");

	set_temp("apply/attack", 30);
	set_temp("apply/defense", 50);
	set_temp("apply/damage", 30);
	set_temp("apply/armor", 20);

	setup();
	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/gangdao")->wield();
}
