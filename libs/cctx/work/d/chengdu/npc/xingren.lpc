// xingren.c  成都行人
// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("行人", ({ "xing ren", "ren" }));
  set("gender", "男性");
  set("age", random(15) + 30);
  set("long", "一个行人，东张西望的不知道在瞧什么。\n");

  set("str", 15 + random(20));
  set("cor", 15 + random(20));
  set("cps", 15 + random(20));
  set("int", 15 + random(20));

  set("max_qi", 100 + random(800));
  set("max_jing", 100 + random(200));
  set("shen_type", 0);

  set_temp("apply/attack", 10 + random(50));
  set_temp("apply/defense", 10 + random(50));
  set_temp("apply/damage", 10 + random(50));

  set("combat_exp", 1000 + random(5000));

  set_skill("unarmed", 20 + random(50));
  set_skill("dodge", 20 + random(50));
  set_skill("parry", 20 + random(50));

  setup();
  //add_money("silver", random(10));
}

int accept_fight(object me) {
  command("say 我逛街那里惹着你了。\n");
  return 0;
}

int accept_object(object me, object obj) {
  command("say 我又不认识你，你给我这东西干吗？\n");
  return 0;
}
