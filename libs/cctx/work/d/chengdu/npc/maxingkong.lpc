// maxingkong.c 马行空
// Written by Doing Lu  1998

inherit NPC;

int got_weapon();

void create() {
  set_name("马行空", ({ "ma xingkong", "ma" }));
  set("age", 48);
  set("gender", "男性");
  set("long", "这就是著名的成都富户马行空，一直做行镖生意。\n");
  set("attitude", "peaceful");

  set("qi", 1000);
  set("max_qi", 1000);
  set("jing", 500);
  set("max_jing", 500);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 30);

  set("str", 25);
  set("dex", 30);
  set("con", 25);
  set("int", 30);

  set("combat_exp", 100000);
  set("shen_type", 1);

  set_skill("unarmed", 80);
  set_skill("blade", 80);
  set_skill("force", 80);
  set_skill("dodge", 80);
  set_skill("huntian-qigong", 80);
  set_skill("wuhu-duanmendao", 80);
  set_skill("xiaoyaoyou", 90);

  map_skill("force", "huntian-qigong");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("blade", "wuhu-duanmendao");
  map_skill("parry", "wuhu-duanmendao");

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 50);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 20);

  set("chat_chance", 5);
  set("chat_msg", ({
    "马行空叹了口气说：着走镖生意难做啊，徐诤太老实了。\n",
    "马行空低头不语。\n",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/gangdao")->wield();
}
