// wulinren.c 武林人士 in chengdu/wuqidian
// Written by Doing Lu 1998

inherit NPC;

void create()
{
	set_name("武林人士", ({ "wuiln ren", "ren" }));
	set("long", 
		"一名这在挑选兵器的武林人士，看得出他会一些武功。\n");
	set("gender", "男性");
	set("age", 30 + random(30));
	set("attitude", "heroism");
	set("shen_type", 1);

	set("str", 20);
	set("int", 20);
	set("con", 25);
	set("dex", 20);
	
	set("max_qi", 300 + random(300));
	set("max_jing", 200 + random(200));
	set("neili", 300 + random(300));
	set("max_neili", 300 + random(300));

	set("combat_exp", 2000 + random(10000));

	set_skill("force", 30 + random(40));
	set_skill("dodge", 30 + random(40));
	set_skill("unarmed", 30 + random(40));
	set_skill("parry", 40 + random(40));

	set("chat_chance", 10);
	set("chat_msg", ({
		"大汉弹了弹手中的剑说：好剑，好剑！\n",
		"大汉拿起一炳刀说：不愧是唐们铁器，打造的就是好。\n",
		"大汉靠在柜台上，低声问道：还有暗器么？\n",
		"大汉懒洋洋的说道：有没有别的兵器了？\n",
	}));

	setup();
	carry_object("/clone/misc/cloth")->wear();
}
