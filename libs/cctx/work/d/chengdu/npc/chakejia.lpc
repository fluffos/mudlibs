// chakajia.c 茶客甲 in chengdu/chaguan
// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("茶客甲", ({ "chake jia", "jia" }));
  set("age", 25);
  set("gender", "男性");
  set("long", "这是一个正在品茶闲聊的茶客。\n");
  set("attitude", "peaceful");

  set("combat_exp", 5000);
  set("shen_type", 1);

  set("chat_chance", 10);
  set("chat_msg", ({
    "茶客甲小声说：听说大财主牛穆仁可是大有来头啊。\n",
    "茶客甲故作神秘说：听说牛老财主的武功很高哩。\n",
    "茶客甲饮了一口茶，眯着眼睛似乎在品味。\n",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
