// yanhuan 丫鬟
// Written by Doing Lu  1998

inherit NPC;

void create()
{
	set_name("丫鬟", ({ "yahuan"}));
	set("long", "这是一个丫鬟。\n");
	set("gender", "女性");
	set("age", 15 + random(10));

	set_skill("unarmed", 10);

	set("combat_exp", 300);
	set_temp("apply/attack", 5);
	set_temp("apply/defanse", 5);
	set_temp("apply/damage", 5);

	set("shen_type", 0);
		
	setup();
	carry_object("/clone/misc/cloth")->wear();
}
