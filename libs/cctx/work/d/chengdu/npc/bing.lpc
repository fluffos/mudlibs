// bing.c 成都官兵
// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("官兵", ({ "guan bing", "bing" }));
  set("age", 22);
  set("gender", "男性");
  set("long", "虽然官兵的武艺不能和武林人士相比，可是他们讲究的是人多力量大。\n");
  set("attitude", "peaceful");

  set("str", 24);
  set("dex", 16);
  set("combat_exp", 10000);
  set("shen_type", 1);

  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  set_skill("blade", 40);
  set_skill("force", 40);
  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);
  set_temp("apply/damage", 20);
  set_temp("apply/armor", 40);

  set("chat_chance", 10);
  set("chat_msg", ({
    "官兵骂道: 格老子的，怎么饷银就这么点，一定是太守克扣了。\n",
    "官兵嘀咕道：这点钱买什么好呢？\n",
    "官兵嘀咕道：逛窑子两下就没钱了。\n",
    "官兵四周看看，骂道：格老子的，土匪还敢作反，老子一刀一个。\n",
    (: command, "sigh" :),
  }));

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    "官兵喝道：大胆刁民，竟敢造反不成？\n",
    "官兵喝道：跑得了和尚跑不了庙，你还是快快束手就擒！\n",
    "官兵喝道：刁民竟敢到成都作乱，你还反了不成？\n",
  }));
  setup();
  carry_object(__DIR__ "obj/gangdao")->wield();
  carry_object(__DIR__ "obj/junfu")->wear();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) &&
    (int)ob->query_condition("killer")) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}

int accept_fight(object me) {
  command("say 格老子，敢惹你家大爷！\n");
  me->apply_condition("killer", 100);
  kill_ob(me);
  return 1;
}
