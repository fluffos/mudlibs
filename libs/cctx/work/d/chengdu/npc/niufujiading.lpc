// mafujiading 牛府家丁 in niufu[..]
// Written by Doing Lu 1998

inherit NPC;

void create()
{
	set_name("牛府家丁", ({ "niufu jiading", "niufu", "jiading"}));
	set("long", "这是一个牛府的家丁，他看着你，一脸不屑。\n");
	set("gender", "男性");
	set("age", 20 + random(10));

	set("combat_exp", 15000 + random(15000));
        set_skill("unarmed", 40 + random(30));
        set_skill("force", 40 + random(30));
        set_skill("dodge", 40 + random(30));
        set_temp("apply/attack", 40 + random(30));
        set_temp("apply/defense", 40 + random(30));
	set("shen_type", -1);

	set("chat_chance", 6);
	set("chat_msg", ({
		"牛府家丁哼了一声。\n",		
		"牛府家丁拉了拉狼狗说：上，上。\n",
		"牛府家丁冷冷的看着马府家丁，一脸不屑。\n",
	}) );
		
	setup();
	carry_object("/clone/misc/cloth")->wear();
}
	
int accept_object(object me, object ob)
{
	if (! ob->query("money_id"))
	{
		message_vision("牛府家丁对$N说：穷小子，什么破烂东西也塞给我。\n", me);
		return 0;
	}
	if (ob->value() < 5000)
	{
		message_vision("牛府家丁掂了掂手中的银两，哼了一声。\n", me);
		return 1;
	}
	if (ob->value() < 15000)
	{
		if (me -> query_temp("enter/牛府"))
		{
			message_vision("牛府家丁把银两放入口袋，道：还不进去？\n", me);
			return 1;
		}
		message_vision("牛府家丁把银两放入口袋，挥了挥手道：我让人去给你通报一下。\n", me);
		remove_call_out("waiting");
		call_out("waiting", 2, this_player());
		return 1;
	}

	message_vision("牛府家丁点头哈腰道：原来是贵客来此，请进请进。\n", me);
	me -> set_temp("enter/牛府", 1);
	return 1;
}

int waiting(object me)
{
	object room;

	if (! (room = find_object("/d/chengdu/niufuroom3")) )
	{
		room = load_object("/d/chengdu/niufuroom3");
	}

	if (!objectp(present("niu muren", room)))
	{
		message_vision("牛府家丁冷冷对$N道：老爷现在不在，你改日再来吧。\n", me);
		return 0;
	}

	if (random(3) != 1)
	{
		message_vision("牛府家丁冷冷对$N道：老爷近日不想会客，你请回吧。\n", me);
		return 0;
	}

	message_vision("牛府家丁对$N道：老爷有请，进去吧。\n", me);
	me -> set_temp("enter/牛府", 1);
	return 1;
}