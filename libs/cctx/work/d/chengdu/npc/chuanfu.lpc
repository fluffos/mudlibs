// chuanfu.c 长江渡口船夫
// Written by Doing Lu 1998

inherit NPC;

void create()
{
	set_name("渡口船夫", ({ "chuanfu"}));
	set("gender", "男性");
	set("age", 50);
	set("long",
		"这是一个长江渡口的船夫。\n",
	);

	set("combat_exp", 1000000);
	set("shen_type", 1);

	set("str",1000);

	set("max_neili", 10000);
	set("neili", 10000);
	set("jiali", 500);

	set_skill("force", 400);
	set_skill("unarmed", 400);
	set_skill("dodge", 400);
	set_skill("parry", 400);

	setup();
	carry_object("/clone/misc/cloth")->wear();
}

int accept_object(object me, object ob)
{
	if (ob->query("money_id") && ob->value() < 2000)
	{
		message_vision("船夫对$N摇摇头说：乘船得二十两纹银。\n", me);
		return 0;
	}

	message_vision("老船夫对$N说：好，这就出发。\n", me);
	message_vision("$N登上了渡船，船尾的船夫喊了个号子，就出发了。\n", me);
	me->set_temp("come from", "dukou");
	me->move("/d/chengdu/changjiang1");
       	return 1;
}
