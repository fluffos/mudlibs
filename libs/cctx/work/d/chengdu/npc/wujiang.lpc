// wujiang.c 成都武将
// Written by Doing Lu  1998

inherit NPC;

void create()
{
	set_name("武将", ({ "wu jiang", "wu", "jiang" }));
	set("gender", "男性");
	set("age", 30 + random(15));
	set("str", 25 + random(10));
	set("dex", 16 + random(10));
	set("long", "他站在那里，的确有说不出的威风。\n");
	set("combat_exp", 75000 + random(100000));
	set("shen_type", 1);
	set("attitude", "peaceful");

	set_skill("unarmed", 60 + random(30));
	set_skill("force", 60 + random(30));
	set_skill("sword", 60 + random(30));
	set_skill("dodge", 60 + random(30));
	set_skill("parry", 60 + random(30));
	set_temp("apply/attack", 50 + random(20));
	set_temp("apply/defense", 50 + random(20));
	set_temp("apply/armor", 50 + random(20));
	set_temp("apply/damage", 30 + random(20));

	set("neili", 400 + random(400));
	set("max_neili", 400 + random(400));
	set("jiali", 10 + random(20));

	set("chat_chance", 10);
	set("chat_msg", ({
		"武将说道: 不能上阵杀敌立功，真是令人遗憾啊。\n",
		"武将四周看看，骂道：格老子的，怎么也看不到几个土匪，也好过过手瘾。\n",
	}) );

	setup();
	carry_object(__DIR__"obj/gangjian")->wield();
	carry_object(__DIR__"obj/tiejia")->wear();
}

void init()
{
	object ob;
	::init();
	if (interactive(ob = this_player()) && 
		(int)ob->query_condition("killer")) {
		remove_call_out("kill_ob");
		call_out("kill_ob", 1, ob);
	}
}

int accept_fight(object me)
{
	command("say 我乃朝廷命官，怎么能和你动手！\n");
	return 0;
}
