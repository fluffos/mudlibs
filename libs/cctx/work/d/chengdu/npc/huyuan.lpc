// mafujiading 护院镖师
// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("护院镖师", ({ "huyuan" }));
  set("long", "这是一个护院镖师，他会些武功，专门给富户守院。\n");
  set("gender", "男性");
  set("age", 20 + random(10));

  set("str", 30);
  set("int", 15);
  set("dex", 25);
  set("con", 20);

  set("combat_exp", 25000 + random(15000));
  set_skill("unarmed", 40 + random(30));
  set_skill("force", 40 + random(30));
  set_skill("dodge", 40 + random(30));
  set_skill("parry", 40 + random(30));
  set_skill("blade", 40 + random(30));
  set_skill("wuhu-duanmendao", 40 + random(30));
  set_skill("xiaoyaoyou", 40 + random(30));

  map_skill("blade", "wuhu-duanmendao");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("parry", "wuhu-duanmendao");

  set("shen_type", -1);

  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/gangdao")->wield();
}
