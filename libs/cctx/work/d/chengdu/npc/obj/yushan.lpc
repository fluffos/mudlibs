// yushan.c
// Written by Doing Lu

#include <weapon.h>
inherit SWORD;

void create()
{
	set_name("羽扇", ({ "yu shan", "shan" }));
	set_weight(50);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是庞统用的羽扇，看起来黑乎乎的。\n");
		set("value", 0);
		set("material", "silk");
		set("wield_msg", "$N慢慢的拿出一把$n，握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回腰间。\n");
	}
	init_sword(5);
	setup();
}
