// nipao.c

inherit EQUIP;

void create() {
  set_name("尼袍", ({ "ni pao", "pao", }));
  set("long", "这是南海神尼穿的布袍，看似很一般，可是摸上去感觉很是奇怪。\n");
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("armor_type", "cloth");
    set("value", 100000);
    set("armor_prop/dodge", 30);
    set("armor_prop/armor", 500);
  }
}
