// renshen.c 人参
// Written by Doing Lu  1998

inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("人参", ({ "ren shen", "shen" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("long", "这是一棵人参。\n");
    set("value", 1000);
  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  this_player()->add("neili", 20);
  message_vision("$N吃下一棵人参，觉得内息顿起。\n", this_player());
  destruct(this_object());
  return 1;
}
