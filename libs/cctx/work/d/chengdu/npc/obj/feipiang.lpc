// feipiang.c 肺片

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("夫妻肺片", ({ "feipiang", "fei" }));
  set_weight(40);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一块地道的川味小吃，红红的竦椒油，让人一看直流口水！\n");
    set("unit", "块");
    set("value", 60);
    set("food_remaining", 3);
    set("food_supply", 30);
  }
}
