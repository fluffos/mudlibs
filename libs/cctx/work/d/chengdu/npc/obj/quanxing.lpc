// quanxing.c  全兴酒 carry by xiaoer2
// Written by Doing Lu 1998

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("全兴酒瓶", ({ "jiuping", "ping", "quan xing" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个用来装全兴酒的酒瓶。\n");
    set("unit", "个");
    set("value", 120);
    set("max_liquid", 20);
  }

  set("liquid", ([
    "type": "alcohol",
    "name": "全兴酒",
    "remaining": 24,
    "drunk_apply": 6,
  ]));
}
