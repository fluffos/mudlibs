// tangwuwei.c 唐无味  in chengdu/wuqidian
// Written by Doing Lu 1998

#include <ansi.h>
inherit F_DEALER;

string *blades = ({
  "/d/chengdu/obj/xiuluodao",
  "/d/chengdu/obj/yanlingdao",
  "/d/chengdu/obj/duanhundao",
});

string *swords = ({
  "/d/chengdu/obj/feiyunjian",
  "/d/chengdu/obj/yunvjian",
  "/d/chengdu/obj/xuanbingjian",
});

string *whips = ({
  "/d/chengdu/obj/molongbian",
  "/d/chengdu/obj/chanhunsuo",
  "/d/chengdu/obj/fumobian",
});


void create() {
  set_name("唐无味", ({ "tang wuwei", "tang" }));
  set("shen_type", 0);

  set("gender", "男性");
  set_max_encumbrance(100000000);
  set("age", 40);
  set("long",
    "唐无味是四川唐家的兵器销售总代理。\n");
  set("no_get_from", 1);

  set("qi", 2000);
  set("max_qi", 2000);
  set("jing", 500);
  set("max_jing", 500);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 80);

  set_skill("unarmed", 100);
  set_skill("dodge", 200);
  set_skill("parry", 100);
  set_skill("blade", 100);
  set_skill("force", 100);

  set_temp("apply/attack", 100);
  set_temp("apply/attack", 100);
  set_temp("apply/damage", 50);

  set("combat_exp", 100000);
  set("attitude", "friendly");

  setup();

  carry_object(blades[random(sizeof(blades))])->move();
  carry_object(swords[random(sizeof(swords))])->move();
  carry_object(whips[random(sizeof(whips))])->move();

  /*
	carry_object("/clone/weapon/gangdao")->wield();
*/
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
  add_action("do_sell", "sell");
  add_action("do_value", "value");
}

void die() {
  message_vision("\n$N死了。\n", this_object());
  destruct(this_object());
}
