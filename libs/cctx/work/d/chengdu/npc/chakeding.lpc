// chakajia.c 茶客丁 in chengdu/chaguan
// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("茶客丁", ({ "chake ding", "ding" }));
  set("age", 23);
  set("gender", "男性");
  set("long", "这是一个正在品茶闲聊的茶客。\n");
  set("attitude", "peaceful");

  set("combat_exp", 5000);
  set("shen_type", 1);

  set("chat_chance", 10);
  set("chat_msg", ({
    "茶客丁道：余沧海那么厉害，还不是让岳不群打得到处跑。\n",
    "茶客丁道：青城四秀吹嘘得利害，碰上令狐冲...嘿嘿。\n",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
