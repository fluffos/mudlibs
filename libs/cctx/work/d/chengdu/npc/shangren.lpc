// shangren.c  成都商人
// Written by Doing Lu 1998

inherit NPC;

void create() {
  set_name("商人", ({ "shang ren", "ren" }));
  set("gender", "男性");
  set("age", random(30) + 30);
  set("long", "一个正在长江渡口发载货物的商人。\n");

  set("str", 20 + random(20));
  set("cor", 20 + random(20));
  set("cps", 20 + random(20));
  set("int", 20 + random(20));

  set("max_qi", 300 + random(800));
  set("max_jing", 300 + random(200));
  set("shen_type", 0);

  set_temp("apply/attack", 10 + random(50));
  set_temp("apply/defense", 10 + random(50));
  set_temp("apply/damage", 10 + random(50));

  set("combat_exp", 3000 + random(5000));

  set_skill("unarmed", 30 + random(50));
  set_skill("dodge", 30 + random(50));
  set_skill("parry", 30 + random(50));

  set("chat_chance", 5);
  set("chat_msg", ({
    "商人说道：船老大，我这货物得快点到，行么。\n",
    "商人说道：船老大，您看我这一次发这么多货，怎么也的折扣点吧。\n",
  }));

  setup();
  add_money("silver", random(20));
}

int accept_fight(object me) {
  message_vision("商人赔笑道：这位" + RANK_D->respect(me) + "，放过小的一马。\n", me);
  return 0;
}

int accept_object(object me, object obj) {
  command("say 无功不受禄，您自己留着吧？\n");
  return 0;
}
