// jiang daye.c 

inherit F_DEALER;
void create()
{
	set_name("姜大爷", ({ "jiang daye","daye" }));
	set("title", "茶馆老板");
	set("shen_type", 1);
	set("str", 30);
	set("gender", "男性");
	set("age", 50);
	set("long",
		"姜大爷是四川有名的种茶人，由于年老，于是在祁山开了这家茶亭\n"
		"为过往的游客提供茶水，赚点小钱。\n");
	set("combat_exp", 6000);
	set("attitude", "friendly");
	set("inquiry", ([
		"生意" : "这个么……还不错!\n",
	]));
		set("vendor_goods", ({
		__DIR__"obj/huasheng",
		__DIR__"obj/feipiang",
	        __DIR__"obj/tea",
}));
	setup();
	carry_object("/clone/misc/cloth")->wear();
}
void init()
{
	object ob;
		::init();
	if (interactive(ob = this_player()) && !is_fighting()) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
void greeting(object ob)
{
	if (!ob || environment(ob) != environment())
		return;
	switch(random(2)) {
	case 0 :
		say("姜大爷笑眯眯地说道：这位" + RANK_D->query_respect(ob) +
			"，累了吧?快请进来喝杯热茶。\n");
		break;
	case 1 :
		say("姜大爷说道：这位" + RANK_D->query_respect(ob) + 
			"我这儿有刚炸好的五香花生出售。买点尝尝?\n");
		break;
	}
}
