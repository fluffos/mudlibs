// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("樱花", ({ "ying hua", "ying", "hua" }));
  set("gender", "女性");
  set("age", 19);
  set("long",
    "\n这是一位小姑娘，虽然年纪不大，可是脸上尽是谄媚的笑容。\n");
  set("str", 15);
  set("dex", 25);
  set("con", 25);
  set("int", 15);
  set("shen_type", -1);

  set_skill("unarmed", 20);
  set_skill("force", 20);
  set_skill("dodge", 25);

  set("combat_exp", 1000);

  set("max_qi", 200);
  set("max_jing", 100);
  set("neili", 200);
  set("max_neili", 200);

  set("attitude", "friendly");

  setup();
  carry_object("/d/chengdu/obj/flower_shoe")->wear();
  //carry_object("/d/chengdu/obj/pink_cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object me) {
  command("say 呦，客官您好，楼上座座。\n");
  return;
}
