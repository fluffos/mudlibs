// chakajia.c 茶客乙 in chengdu/chaguan
// Written by Doing Lu  1998

inherit NPC;

void create()
{
	set_name("茶客乙", ({ "chake yi", "yi" }));
	set("age", 32);
	set("gender", "男性");
	set("long", "这是一个正在品茶闲聊的茶客。\n");
	set("attitude", "peaceful");

	set("combat_exp", 10000);
	set("shen_type", 1);

	set("chat_chance", 10);
	set("chat_msg", ({
		"茶客乙看了看周围说：听说福威镖局的人得罪了青城派的高手哦。\n",
		"茶客乙摇了摇头道：福威镖局好像给青城派抄了。\n",
		"茶客乙饮了一口茶，摇头晃脑的似乎在品味。\n",
	}) );

	setup();
	carry_object("/clone/misc/cloth")->wear();
}
