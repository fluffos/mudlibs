// puyi 仆役
// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("仆役", ({ "puyi" }));
  set("long", "这是一个仆役。\n");
  set("gender", "男性");
  set("age", 15 + random(20));

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_skill("parry", 20);

  set("combat_exp", 1000);
  set_temp("apply/attack", 15);
  set_temp("apply/defanse", 15);
  set_temp("apply/damage", 15);

  set("shen_type", 0);

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
