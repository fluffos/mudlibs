// cui.c  in cuifangyuan
// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("崔秀姑", ({ "cui" }));
  set("gender", "女性");
  set("age", 39);
  set("long",
    "\n这老鸨婆看起来年纪似乎不大，可是尽是做一些坑蒙拐骗良家妇女的事，早已丧尽天良。\n");
  set("str", 25);
  set("dex", 25);
  set("con", 25);
  set("int", 25);
  set("shen_type", -1);

  set_skill("unarmed", 20);
  set_skill("force", 20);
  set_skill("dodge", 35);

  set("combat_exp", 8000);

  set("max_qi", 300);
  set("max_jing", 100);
  set("neili", 500);
  set("max_neili", 500);

  set("attitude", "friendly");
  set("inquiry", ([
    "翠芳院": "我们翠芳院可是成都城里头一份的找乐子去处，什么细柳院啦，春媚院了，\n"
    "一听就不是什么好去处。\n",
  ]));

  setup();
  carry_object("/d/chengdu/obj/flower_shoe")->wear();
  //carry_object("/d/chengdu/obj/pink_cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object me) {
  command("look " + me->query("id"));

  if (me->query("gender") == "无性") {
    command("say 呦，公公您也爱这调调？");

  } else {
    if (me->query("class") == "bonze") {
      command("say 呦，" + RANK_D->query_respect(me)
        + "也来光顾我们翠芳院啊。");
    } else if (me->query("gender") == "女性") {
      command("say 哎呀，这年月大姑娘也逛窑子，啧啧，真是什么人都有哩。");
    } else
      command("say 楼上楼下的姑娘们，客人来了！");
  }
  return;
}
