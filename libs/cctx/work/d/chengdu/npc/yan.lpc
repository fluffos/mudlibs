// yan.c 言老板 in zhuangyuan2  负责定(ding)酒席
// Written by Doing Lu 1998

#include <ansi.h>


inherit F_DEALER;

void create() {
  set_name("言老板", ({ "yan laoban", "yan" }));
  set("title", "状元楼老板");
  set("shen_type", 1);

  set("str", 40);
  set("gender", "男性");
  set("age", 42);
  set("long", "言老板乃是状元楼的第七位老板，据说还真的是一个状元。\n");
  set("combat_exp", 800000);
  set("qi", 3000);
  set("max_qi", 3000);
  set("attitude", "friendly");
  set_skill("unarmed", 400);
  set_skill("dodge", 400);
  set_temp("apply/attack", 400);
  set_temp("apply/defense", 400);

  setup();
  add_money("gold", 5);
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_ding", "ding");
  add_action("do_answer", "answer");
}

int do_ding(string arg) {
  object me;
  me = this_player();
  if (!arg) return 0;

  if (arg != "酒席" && arg != "酒宴" && arg != "喜宴" && arg != "喜筵")
    return notify_fail("你要摆什么？过家家么？\n");

  if (me->query_temp("man/状元楼"))
    return notify_fail("你已经向老板定下酒席了。\n");

  if (arg == "喜宴" || arg == "喜筵") {
    write("言老板说：恭喜恭喜， 有几位客人啊？ 告述我（answer)，也好让我们准备准备。\n");
    me->add_temp("ding/状元楼", 2);
  } else {
    write("言老板满面笑容道：这位客官真是看得起鄙店，告述(answer)在下有几位客人？\n");
    me->add_temp("ding/状元楼", 1);
  }
  message("vision", me->query("name") + "向言老板顶酒宴。\n", environment(me), ({ me }));
  return 1;
}

int do_answer(string arg) {
  object me;
  int ren;

  me = this_player();
  if (!arg) return notify_fail("你要回答谁什么？\n");
  if (!me->query_temp("ding/状元楼"))
    return notify_fail("你要向谁回答？\n");
  if (!sscanf(arg, "%d", ren))
    return notify_fail("言老板一脸茫然，没听懂你的话。\n");

  if (me->query_temp("ren/状元楼")) {
    write("改人数？也行啊。\n");
  }

  if (ren > 30)
    return notify_fail("言老板陪着笑说，客官您别见怪，小店盛不下这么多人。\n");
  if (ren < 5)
    return notify_fail("言老板哼了一声，这几个人也要酒席？\n");
  write("言老板说：好哩，在下这就给你们办,客官您先付钱吧，一位一两黄金。\n");
  me->add_temp("ren/状元楼", ren);
  return 1;
}

int accept_object(object who, object ob) {
  if (!ob->query("money_id")) {
    write("言老板说：你给我这东西干什么？\n");
    return 0;
  }
  if (!who->query_temp("ding/状元楼")) {
    write("言老板笑着说：要买东西请和小二说。\n");
    return 0;
  }
  if (ob->value() < who->query_temp("ren/状元楼") * 10000) {
    write("言老板笑着说：对不起，本店不打折扣。\n");
    return 0;
  }
  return 1;
}
