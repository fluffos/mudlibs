// chakajia.c 茶客丙 in chengdu/chaguan
// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("茶客丙", ({ "chake bing", "bing" }));
  set("age", 45);
  set("gender", "男性");
  set("long", "这是一个正在品茶闲聊的茶客。\n");
  set("attitude", "peaceful");

  set("combat_exp", 3000);
  set("shen_type", 1);

  set("chat_chance", 10);
  set("chat_msg", ({
    "茶客丙品了一口茶道：青城派以前声威很高，只是长青子败在了林远图手下以后才不如往昔了。\n",
    "茶客丙摇了摇头道：难怪余道长要报仇了。\n",
    "茶客丙看了看门口，叹道：青城派出了几个弟子就把福威镖局摆平了。\n",
    "茶客丙饮了一口茶，似乎在品味。\n",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
