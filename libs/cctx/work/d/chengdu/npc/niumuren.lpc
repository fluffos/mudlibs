// niumuren.c 牛穆仁
// Written by Doing Lu  1998

inherit NPC;

int got_weapon();
int ask1();
int ask2();

void create() {
  set_name("牛穆仁", ({ "niu muren", "niu" }));
  set("age", 52);
  set("gender", "男性");
  set("long", "这就是著名的成都富户牛穆仁，没人知道他究竟是靠做什么生意发的家。\n");
  set("attitude", "peaceful");

  set("qi", 2000);
  set("max_qi", 2000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 50);

  set("str", 35);
  set("dex", 30);
  set("con", 30);
  set("int", 35);

  set("combat_exp", 700000);
  set("shen_type", -1);

  set_skill("unarmed", 120);
  set_skill("cuff", 120);
  set_skill("finger", 180);
  set_skill("strike", 180);
  set_skill("dodge", 120);
  set_skill("parry", 120);
  set_skill("blade", 140);
  set_skill("sword", 140);
  set_skill("force", 120);
  set_skill("hunyuan-yiqi", 150);
  set_skill("xiuluo-dao", 140);
  set_skill("damo-jian", 140);
  set_skill("jingang-quan", 120);
  set_skill("shaolin-shenfa", 120);
  set_skill("nianhua-zhi", 180);
  set_skill("sanhua-zhang", 180);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("blade", "xiuluo-dao");
  map_skill("sword", "damo-jian");
  map_skill("cuff", "jingang-quan");
  map_skill("parry", "xiuluo-dao");
  map_skill("finger", "nianhua-zhi");
  map_skill("strike", "sanhua-zhang");

  prepare_skill("finger", "nianhua-zhi");
  prepare_skill("strike", "sanhua-zhang");

  reset_action();

  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 100);
  set_temp("apply/armor", 40);

  set("chat_chance", 5);
  set("chat_msg", ({
    "牛穆仁望着远方，似乎有满腹的心事。\n",
    (: command, "sigh" :),
  }));

  set("inquiry", ([
    "少林寺": (: ask1 :),
    "火工僧": (: ask2 :),
  ]));

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    "牛穆仁一声冷笑：你不想活了是不是？\n",
    (: got_weapon :),
  }));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}

int accept_fight(object me) {
  message("vision", "牛穆仁淡淡的说：" + RANK_D->query_respect(this_player())
    + "何出此言？\n", this_player());
  return 0;
}

int got_weapon() {
  if (present("duanhun dao", this_object())) return 0;
  carry_object("/d/chengdu/obj/duanhundao")->wield();
  message_vision("牛穆仁长啸一声，右手一翻，亮出一把断魂刀。\n", this_player());
  command("chat 待我超度了你!\n");
}

int ask1() {
  message_vision("牛穆仁微微一颤，沉声道：你说什么？\n", this_player());
  return 1;
}

int ask2() {
  message_vision("牛穆仁大喝一声：好家伙，竟敢寻我晦气！\n", this_player());
  this_object()->kill_ob(this_player());
  this_player()->kill_ob(this_object());
  return 1;
}

int recognize_apprentice(object ob) {
  if (ob->query_skill("hunyuan-yiqi", 1) >= 60) {
    if (!ob->query_temp("teach/牛穆仁")) {
      message_vision("牛穆仁注视你良久，说道：看在大家乃是武林一脉的份上，就教你点武功吧。\n", ob);
      ob->set_temp("teach/牛穆仁", 1);
    }
    return 1;
  }
  return 0;
}
