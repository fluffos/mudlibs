// huoji3. 金铺伙计  in chengdu/jinpu
// Written by Doing Lu 1998 

#include <ansi.h>

inherit F_DEALER;

int	chat_1();
int	chat_2();
int	chat_3();

void create()
{
	set_name("金铺伙计", ({ "jinpu huoji", "huoji" }));
	set("str", 20);
	set("gender", "男性");
	set("age", 20);
	set("long", "他长的眉清目秀，一张嘴极尽人间之能事，听得你欲罢不能。\n");
	set("combat_exp", 5000);

	set_skill("unarmed", 50);
	set_skill("dodge", 20);

	set("attitude", "friendly");
	set("vendor_goods", ({
		"/d/chengdu/obj/midai",
	}));

	set("chat_chance", 25);
	set("chat_msg", ({
		(: chat_1 :),
		(: chat_2 :),
		(: chat_3 :),
	}));

	set("vendor_goods", ({
		"/d/chengdu/obj/jinxianglian",
		"/d/chengdu/obj/jinshouzhuo",
		"/d/chengdu/obj/jinjiezhi",
		"/d/chengdu/obj/jinfengchai",
	}));

	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

int chat_1()
{
	object *ob;
	object me;
	string respect;

	ob = all_inventory(environment());
	me = ob[random(sizeof(ob))];
	if (! interactive(me)) return 0;

	write("Name = " + me->query("name") + "\n");
	respect = RANK_D->query_respect(me);

	if (me->query("gender") == "男性")
	{
		message_vision("伙计对$N笑眯眯道：这位" + respect +
		"，您看看这串金项链，这可是成都第一能工巧匠打造的哦。\n", me);
	} else
	if (me->query("gender") == "女性")
	{
		message_vision("伙计对$N说：这位" + respect + 
		"试试这串项链。\n", me);
	} else
	{
		message_vision("伙计对$N说：这串项链也是很精致的哦。\n", me);
	}
	return 1;
}

int chat_2()
{
	object *ob;
	object me;
	string respect;

	ob = all_inventory(environment());
	me = ob[random(sizeof(ob))];
	if (! interactive(me)) return 0;

	write("Name = " + me->query("name") + "\n");
	respect = RANK_D->query_respect(me);

	if (me->query("gender") == "男性")
	{
		message_vision("伙计对$N殷勤道：这位" + respect + 
		"，拿个凤钗回去给哪位小姐做个订情之物？\n", me);
	} else
	if (me->query("gender") == "女性")
	{
		message_vision("伙计对$N说：这位" + respect + 
		"真是赛过卓文君，啧啧，戴上这个凤钗就更漂亮了。\n", me);
	} else
	{
		message_vision("伙计对$N说：来个凤钗可好?\n", me);
	}
	return 1;
}

int chat_3()
{
	object *ob;
	object me;
	string respect;

	ob = all_inventory(environment());
	me = ob[random(sizeof(ob))];
	if (! interactive(me)) return 0;

	write("Name = " + me->query("name") + "\n");
	respect = RANK_D->query_respect(me);

	if (me->query("gender") == "男性")
	{
		message_vision("伙计对$N道：这位" + respect + 
		"，这对金手镯可是贵重无比的哩！\n", me);
	} else
	if (me->query("gender") == "女性")
	{
		message_vision("伙计对$N说：哎呀，这位" + respect + 
		"如是戴上了这对金手镯，啧啧，没法说了。\n", me);
	} else
	{
		message_vision("伙计对$N说：看看这对手镯吧！\n", me);
	}
	return 1;
}
