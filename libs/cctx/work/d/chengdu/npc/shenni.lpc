// shenni.c  南海神尼  in houyuan
// Written by Doing Lu  1998

#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int ask_me();
void follow_and_kill(object me);
void go_back(object me);

void create() {
  set_name("卫可", ({ "wei ke", "ke", "shen ni" }));
  set("nickname", HIY "南海神尼" NOR);
  set("gender", "女性");
  set("age", 100);
  set("long",
    "她就是世外高人，南海神尼，传说桃花岛主的弹指神通的神功就是和她学的。\n");
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    "南海神尼冷笑道：小子找死，扰我清修。\n",
    "南海神尼森然道：竟敢与贫尼交手，待贫尼超度了你。\n",
  }));

  set("inquiry", ([
    "鲜花": (: ask_me :),
  ]));


  set("qi", 10000);
  set("max_qi", 10000);
  set("jing", 5000);
  set("max_jing", 5000);
  set("neili", 10000);
  set("max_neili", 10000);
  set("jiali", 200);

  set("combat_exp", 5500000);
  set("score", 0);

  set_skill("force", 400);
  set_skill("bibo-shengong", 400);
  set_skill("beiming-shengong", 400);
  set_skill("finger", 450);
  set_skill("strike", 400);
  set_skill("cuff", 400);
  set_skill("hand", 400);
  set_skill("claw", 400);
  set_skill("sword", 450);
  set_skill("blade", 450);
  set_skill("tanzhi-shentong", 450);
  set_skill("dodge", 450);
  set_skill("anying-fuxiang", 450);
  set_skill("parry", 400);
  set_skill("qimen-wuxing", 100);
  set_skill("literate", 400);

  set_temp("apply/attack", 400);
  set_temp("apply/defense", 200);
  set_temp("apply/damage", 400);

  map_skill("force", "bibo-shengong");
  map_skill("finger", "tanzhi-shentong");
  map_skill("dodge", "anying-fuxiang");
  map_skill("parry", "tanzhi-shentong");

  prepare_skill("finger", "tanzhi-shentong");

  setup();

  carry_object(__DIR__ "obj/bupao")->wear();
}

int recognize_apprentice(object ob) {
  if (ob->query("max_neili") < 2000 || ob->query("exp") < 500000) {
    return 0;
  }
  return 1;
}

int ask_me() {
  if (this_object()->is_fighting()) {
    write("南海神尼正在打架，没工夫理你。\n");
    return 1;
  }
  message_vision("南海神尼笑道：我以前久居南海，一年四季都有鲜花开放，我来到四川多有不惯，\n", this_player());
  message_vision("所以用内力培育此花，其长势却也不弱于南海。\n", this_player());
  return 1;
}

void follow_and_kill(object me) {
  command("chat 哼，找死！\n");
  message_vision("南海神尼对$N大喝一声：何方妖魔，敢扰我静修！\n", me);
  command("follow " + me->query("id"));
  this_object()->kill_ob(me);
  me->kill_ob(this_object());
  remove_call_out("go_back");
  call_out("go_back", 100, me);
}

void go_back(object me) {
  command("chat* 南海神尼冷笑一声。\n");
  command("follow none");
  message_vision("南海神尼飘然离去，就如清风一般淡然而去。\n", me);
  this_object()->move("/d/chengdu/huayuan");
  remove_call_out("go_back");
}
