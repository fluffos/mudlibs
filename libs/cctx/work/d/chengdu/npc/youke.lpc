// shangren.c  成都游客
// Written by Doing Lu 1998

inherit NPC;

void create()
{
	set_name("游客", ({ "you ke","ke" }) );
	set("gender", "男性" );
	set("age", random(15)+30);
	set("long", "一个成都的游客。\n");

	set("str", 15 + random(20));
	set("cor", 15 + random(20));
	set("cps", 15 + random(20));
	set("int", 15 + random(20));

	set("max_qi", 200 + random(800));
	set("max_jing", 200 + random(200));
	set("shen_type", 0);

	set_temp("apply/attack",  10 + random(40));
	set_temp("apply/defense", 10 + random(40));
	set_temp("apply/damage",  10 + random(40));

	set("combat_exp", 1000 + random(5000));

	set_skill("unarmed", 20 + random(50));
	set_skill("dodge", 20 + random(50));
	set_skill("parry", 20 + random(50));

	set("chat_chance", 5);
	set("chat_msg", ({
		"游客说道：三峡风光真是好啊。\n",
		"游客笑道：成都果然是天府之国，真是名不虚传。\n",
		"游客摇头道：这蜀道太难走了，太难走了。\n",
	}));

	setup();
	add_money("silver", random(10));
}

int accept_object(object me, object obj)
{
	command("say 你给我这东西干啥？\n");
	return 0;
}
