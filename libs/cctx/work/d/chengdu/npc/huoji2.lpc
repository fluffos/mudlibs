// huoji2. 米铺伙计 in chengdu/mipu
// Written by Doing Lu  1998 

inherit F_DEALER;

void create()
{
	set_name("米铺伙计", ({ "mipu huoji", "huoji" }));
	set("str", 25);
	set("gender", "男性");
	set("age", 20);
	set("long", "他十分强壮，也许是在米铺干活，长得白白胖胖的。\n");
	set("combat_exp", 5000);

	set_skill("unarmed", 50);
	set_skill("dodge", 20);

	set("attitude", "friendly");
	set("vendor_goods", ({
		"/d/chengdu/obj/midai",
	}));

	set("chat_chance", 10);
	set("chat_msg", ({
		"伙计一边扫米粒，一边嘀咕：这每天掉到地上的米也能养活一家子人了。\n",
		"伙计嘀咕道：看来还是开米行最划算，从来不愁没生意。\n",
		"伙计叹了一口气：什么时候我也能开一个米铺。\n",
	}));

	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}
