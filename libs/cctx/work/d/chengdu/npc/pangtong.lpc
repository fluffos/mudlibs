// Written by Doing Lu 1998

#include <ansi.h>

inherit NPC;

void create() {
  set_name("庞统", ({ "pang tong", "pang" }));
  set(
    "long",
    "庞士元乃是三国第一聪明人，人称凤雏，被水镜先生认为是荆州第一人，仅有卧龙可以与之相比，\n谁知在落凤坡中了张任的小奸计，很是没面子，不好意思再打西川，只有躲在这里教书。\n"
  );
  set("nick", HIY "凤雏" NOR);
  set("gender", "男性");
  set("age", 1000);

  set("str", 20);
  set("int", 50);
  set("dex", 20);
  set("con", 20);

  set("jing", 10000);
  set("max_jing", 10000);
  set("qi", 10000);
  set("max_qi", 10000);
  set("neili", 10000);
  set("max_neili", 10000);
  set("jiali", 200);

  set_skill("literate", 999);
  set_skill("taoism", 999);

  set_skill("unarmed", 600);
  set_skill("force", 600);
  set_skill("sword", 600);
  set_skill("dodge", 400);
  set_skill("parry", 600);
  set_temp("apply/attack", 600);
  set_temp("apply/defense", 600);
  set_temp("apply/damage", 600);

  set("combat_exp", 4000000);
  set("shen_type", 1);
  setup();

  set("chat_chance", 3);
  set("chat_msg", ({
    "庞统恨道：张任这家伙真不是东西。\n",
    "庞统叹道：唉，这小子有点门道，连我都中了计。\n",
    "庞统摇摇羽扇，说道：尽是孔明这家伙说些丧气话，折我的威风。\n",
    "庞统呆呆的不说话。\n",
  }));

  set("inquiry", ([
    "张任": "哼，这小子，不提他了。\n",
    "刘备": "我一时不察，中了奸计，唉，没脸见他了。\n",
    "诸葛亮": "哼，孔明算什么，当然了，他也有点本领，唉，他运气比我好。\n",
    "八卦阵": "那算什么，不就是东南西北，东北西南......你走到了死门我可不管。\n",
    "武侯秘籍": "什么？拿给我看看写些什么东西。\n",
  ]));

  carry_object(__DIR__ "obj/yushan")->wield();
  carry_object("/clone/misc/cloth")->wear();
}

int recognize_apprentice(object ob) {
  if (!(int)ob->query_temp("mark/庞统")) {
    message("vision", "庞统对" + ob->name() + "说，看在你好学的份上，就教你点本领。\n", ob);
    ob->set_temp("mark/庞统", 1);
    return 1;
  }
  return 0;
}
