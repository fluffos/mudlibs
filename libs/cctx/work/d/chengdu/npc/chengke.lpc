// shangren.c  长江乘客
// Written by Doing Lu 1998

inherit NPC;

void create() {
  set_name("乘客", ({ "cheng ke", "ke" }));
  set("gender", "男性");
  set("age", random(15) + 30);
  set("long", "一个乘客，正在江边欣赏美景。\n");

  set("chat_chance", 5);
  set("chat_msg", ({
    "乘客说道：三峡风光真是好啊。\n",
    "乘客说道：不知还有多久才到。\n",
  }));

  setup();
}

int accept_object(object me, object obj) {
  command("say 你给我这东西干啥？\n");
  return 0;
}
