// laoban.c 成都小店老板  in xiaodian.c
// Written by Doing Lu  1998

inherit F_DEALER;

void create() {
  set_name("小店老板", ({ "yaopu huoji", "huoji" }));
  set("gender", "男性");
  set("age", 50);
  set("long", "他是成都西街的小店的老板。\n");
  set("combat_exp", 2500);
  set("attitude", "friendly");
  set("vendor_goods", ({
    __DIR__ "obj/fire.lpc",
    __DIR__ "obj/stick",
    __DIR__ "obj/shoes",
    __DIR__ "obj/bottle",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
