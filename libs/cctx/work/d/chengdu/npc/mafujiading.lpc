// mafujiading 马府家丁 in mafu[..]
// Written by Doing Lu  1998

inherit NPC;

void create() {
  set_name("马府家丁", ({ "mafu jiading", "mafu", "jiading" }));
  set("long", "这是一个马府的家丁，他看着你，一脸不屑。\n");
  set("gender", "男性");
  set("age", 20 + random(10));

  set("combat_exp", 10000 + random(10000));
  set_skill("unarmed", 30 + random(20));
  set_skill("force", 30 + random(20));
  set_skill("dodge", 30 + random(20));
  set_temp("apply/attack", 30 + random(30));
  set_temp("apply/defense", 30 + random(30));
  set("shen_type", -1);

  set("chat_chance", 6);
  set("chat_msg", ({
    "马府家丁哼了一声，满脸不屑的看着你。\n",
    "马府家丁拉了拉狼狗说：上，上。\n"
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
