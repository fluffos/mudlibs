// liumangtou.c 流氓头

inherit NPC;

void create()
{
	set_name("流氓头", ({ "liumang tou", "liumang", "liu" }));
	set("gender", "男性");
	set("age", 25);
	set("long", "他长得奸嘴猴腮的，一看就不像是个好人。\n");
	
	set("combat_exp", 7000);
	set("shen_type", -1);
	set("attitude", "peaceful");
	
	set_skill("unarmed", 40);
	set_skill("dodge", 40);
	set_temp("apply/attack", 20);
	set_temp("apply/defense", 20);

	set("chat_chance", 10);
	set("chat_msg", ({
		(: command , "rascal" :),
		(: command , "kick yi" :),
		(: command , "admire bing" :),
	}) );


	setup();
	carry_object("/clone/misc/cloth")->wear();
	//add_money("silver", 2);
}

void init()
{
	object ob;

	::init();

	if( interactive(ob = this_player()) && !is_fighting() ) 
       {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	if ((string)ob->query("gender")=="女性")
	{
	   switch(random(3))
	   {
		case 0:command("18mo "+(string)ob->query("id"));break;
	  	case 1:command("hehe "+(string)ob->query("id"));break;
	   }
     
	}
	else
	{
	   switch(random(3))
	   {
		case 0:command("kick "+(string)ob->query("id"));break;
	  	case 1:command("hi "+(string)ob->query("id"));break;
	   	case 2:command("admire "+(string)ob->query("id"));break;
	   }
	}
	return;
}
