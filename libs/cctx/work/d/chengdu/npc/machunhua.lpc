// machunhua.c 马春花
// Written by Doing Lu  1998

inherit NPC;

int got_weapon();

void create()
{
	set_name("马春花", ({ "ma chunhua", "ma" }));
	set("age", 19);
	set("gender", "女性");
	set("long", "她是马行空的女儿，长的楚楚动人，看不出是常年行走江湖的模样。\n");
	set("attitude", "peaceful");

	set("qi", 500);
	set("max_qi", 500);
	set("jing", 250);
	set("max_jing", 250);
	set("neili", 400);
	set("max_neili", 400);
	set("jiali", 20);

	set("str", 20);
	set("dex", 20);
	set("con", 20);
	set("int", 20);
 
	set("combat_exp", 20000);
	set("shen_type", 1);

	set_skill("unarmed", 40);
	set_skill("blade", 40);
	set_skill("force", 40);
	set_skill("dodge", 60);
	set_skill("huntian-qigong", 40);
	set_skill("wuhu-duanmendao", 40);
	set_skill("xiaoyaoyou", 60);

	map_skill("force", "huntian-qigong");
	map_skill("dodge", "xiaoyaoyou");
	map_skill("blade", "wuhu-duanmendao");
	map_skill("parry", "wuhu-duanmendao");

	set_temp("apply/attack", 20);
	set_temp("apply/defense", 50);
	set_temp("apply/damage", 20);
	set_temp("apply/armor", 25);

	setup();
	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/gangdao")->wield();
}
