// piaoke.c
// Written by Doing Lu 1998

inherit NPC;

void create() {
  set_name("嫖客", ({ "piao ke", "piao", "ke" }));
  set("gender", "男性");
  set("age", 18 + random(40));
  set("long",
    "\n这是一位嫖客，他脚步轻浮，一看就是心虚气短的人。\n");
  set("str", 15 + random(15));
  set("dex", 20 + random(5));
  set("con", 25 + random(10));
  set("int", 20 + random(10));
  set("shen_type", -1);

  set_skill("unarmed", 20 + random(20));
  set_skill("dodge", 25 + random(30));

  set("combat_exp", 1000 + random(10000));

  set("max_qi", 150 + random(200));
  set("max_jing", 100);
  set("neili", 200 + random(100));
  set("max_neili", 200 + random(200));

  set("attitude", "friendly");

  set("chat_chance", 10);
  set("chat_msg", ({
    (: command, "kiss yinghua" :),
    (: command, "18mo yinghua" :),
  }));

  setup();
  carry_object("/d/chengdu/obj/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1 + random(3), ob);
  }
}

void greeting(object me) {
  command("say 嘿，这位" + RANK_D->query_respect(me) + "也来玩玩？\n");
  return;
}
