inherit ROOM;

void create() {
  set("short", "东大街");
  set("long", @LONG
	这是一条宽阔的大街，向东西两头延伸，由于这里以处于外城的地界，
因此人显得不如城里的人多。北面出来阵阵的打铁声，南边则是一家米铺。向东
就快到城门了。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "east": __DIR__ "dongdajie3",
    "south": __DIR__ "mipu",
    "west": __DIR__ "dongdajie1",
    "north": __DIR__ "tiejiangpu",
  ]));

  set("objects", ([
    __DIR__ "npc/xingren": 1,
  ]));

  setup();
  replace_program(ROOM);
}
