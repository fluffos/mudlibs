#include <ansi.h>
inherit ROOM;

void create()
{
	set("short",HIR "蜀道");
	set("long", @LONG
一路上只是山重水复，才过山岭又涉溪流。叹息时只是赞同诗仙所
云：蜀道难，难于上青天...
LONG
	);	
        set("outdoors", "qingzh");

	set("exits", ([
		"southeast" : __DIR__"road3",
		"southwest" : __DIR__"road1",
		
	]));
	
//	set("objects", ([
//		__DIR__"npc/guest" : 1]));
	
	setup();
//	replace_program(ROOM);
}

	
void init()
{
	object ob;
	int ioqi;
	
	ob = this_player();
	ioqi = 200 / (int)ob->query("int") + 1;
        ob->receive_damage("jing", ioqi );
        if((int)ob->query("jing") < 30) 
                 message("vinson",HIY"你已经疲惫不堪，想是要歇息一会儿了！\n"NOR, ob);	       
}
		

