inherit ROOM;

void create()
{
	set("short", "状元楼");
	set("long", @LONG
	状元楼也算是成都里几个有名的大酒楼之一，成都富户若是摆结婚喜宴
大多都是在这里，也是为取个意头。楼下都是一些外买小点，多是一些来往的游
客行人光顾。楼上是摆酒宴的地方。
LONG
	);

	set("valid_startroom", 1);

	set("exits", ([
		"south" : __DIR__"dongdajie1",
		"up" : __DIR__"zhuangyuan2",
	]));

	set("objects", ([
		__DIR__"npc/xiaoer1" : 1,
	]));

	setup();
	replace_program(ROOM);
}

