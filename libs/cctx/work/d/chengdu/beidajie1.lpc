inherit ROOM;

void create() {
  set("short", "北大街");
  set("long", @LONG
	这是一条宽阔的大街，这里地处成都闹区，非常繁华，许多行人来来往
往，看得出不愧是天府之国。向南北两头延伸。北面有一些店铺，而西面有一家
书院，是一些文人墨客喜欢积聚的地方。东面有一个酒楼，是成都有名的宴宾楼。
南面则是城中心，非常热闹。
LONG
  );

  set("exits", ([
    "east": __DIR__ "yanbin",
    "south": __DIR__ "guangchang",
    "west": __DIR__ "shuyuan",
    "north": __DIR__ "beidajie2",
  ]));

  set("objects", ([
    __DIR__ "npc/xingren": 1,
  ]));

  setup();
}
