// chengdu/wuhouci.c
// Written by Doing Lu 1998

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "武侯祠");
  set("long",
    "	这里便是三国时期的蜀国名相，武侯诸葛亮的祠堂。诸葛亮自隆中初定\n"
    "三分天下之策略，辅佐刘氏近三十年，平定荆州，夺取两川，败司马于渭水，逐\n"
    "曹真于三秦，可谓功莫大焉。虽然受命于危难之间，未能力挽狂澜于乱世，但是\n"
    "其胸襟气魄，丰功伟业，后人难不敬仰。成都居民特造此祠堂以祭奠武侯。祠堂\n"
    "正中的武侯之像沉稳凝重，双眼望向远方，似有无尽的睿智，又若有无尽的悲伤，\n"
    "似乎无奈于明知不可为而为之吧。像旁有一幅后人所书的对联：\n\n"

    HIW "		出师未捷身先死\n"
    "		长使英雄泪满襟\n\n" NOR

  );

  set("no_fight", "1");
  set("no_steal", "1");
  set("no_sleep_room", "1");
  set("valid_startroom", 1);

  set("exits", ([
    "west": __DIR__ "beidajie3",
    "north": __DIR__ "wuhouci2",
  ]));

  setup();
}
