inherit ROOM;

void create() {
  set("short", "北门");
  set("long", @LONG
	这是就是成都的北门，从北门出去可以到达陕西一带，那里的路虽然不
太好走，但是比川路要好一些，因为是通往三秦的道路，因此行人不少，往南则
通往城内，离城不远便可以看到武侯祠与关帝庙。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "south": __DIR__ "beidajie3",
    "north": __DIR__ "nroad1",
  ]));

  set("objects", ([
    __DIR__ "npc/bing2": 3,
    __DIR__ "npc/wujiang": 1,
    __DIR__ "npc/xingren": 3,
  ]));

  setup();
}
