inherit ROOM;

void create() {
  set("short", "八卦阵");
  set("long", @LONG
	这里是阴森森的地下室，点着昏暗的灯光，旁边有一个石碑，上书有字：
八卦阵，不可擅入。你不禁有点心惊，这种地方还是小心一点好。上面隐隐透出
一丝亮光。
LONG
  );

  set("exits", ([
    "north": __DIR__ "baguazhen2",
    "up": __DIR__ "wuhouci2",
  ]));

  setup();
  replace_program(ROOM);
}
