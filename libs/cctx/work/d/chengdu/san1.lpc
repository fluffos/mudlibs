#include <room.h>
inherit ROOM;

void create() {
  set("short", "祁山山道");
  set("long", @LONG
山道旁是一片小松林，面前出现了一条宽广的石板道，笔直向上通向山
顶。沿道稀稀落落地种着几棵柏树，却显得高大挺拔，蝤龙般的枝干向
天空高高伸展着。南面是一个小小的祠堂。
LONG
  );
  set("outdoors", "chengdu");
  set("exits", ([
    "northup": __DIR__ "san3",
    "westup": __DIR__ "chatin",
    "southdown": __DIR__ "sanjiao",

  ]));

  setup();
}
