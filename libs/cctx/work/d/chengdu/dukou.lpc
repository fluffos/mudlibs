inherit ROOM;

void create() {
  set("short", "长江渡口");
  set("long", @LONG
	这是长江渡口，由于蜀道难行，所以从成都到中原的大部分货物都是从
水路运输的，而来川的游客也喜欢从长江水路走，可以欣赏三峡奇景，从水路沿
江而下，可直达宜昌。渡口有一个价目表(sign)。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "north": "yidao1",
  ]));

  set("item_desc", ([
    "sign": "直达宜昌，二十两纹银。\n",
  ]));


  set("objects", ([
    __DIR__ "npc/youke": 2,
    __DIR__ "npc/shangren": 2,
    __DIR__ "npc/chuanfu": 1,
  ]));

  setup();
  replace_program(ROOM);
}
