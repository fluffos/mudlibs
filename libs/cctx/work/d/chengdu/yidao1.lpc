inherit ROOM;

void create()
{
	set("short", "蜀道");
	set("long", @LONG
	这里是四川的驿道，弯弯曲曲的很是难走，道上的行人很少，大部分的
商户旅客都从水路沿江而下，出三峡抵达宜昌，那样即省力，又安全。从这里向
南就可到长江渡口，向东而去也可出栈道抵达中原。西面就是三国古都成都。
LONG
	);
        set("outdoors", "chengdu");

	set("exits", ([
		"northeast" : __DIR__"yidao2",
	//	"south" : __DIR__"dukou",
		"west" : __DIR__"dongmen",
	]));

	setup();
	replace_program(ROOM);
}
