inherit ROOM;

void create()
{
	set("short", "米铺");
	set("long", @LONG
	这里是成都最大的米行，盛源米行开的米铺。经营大米，人来人往，伙计
们也忙得不可开交，一袋一袋的大米从后面的仓库里拿出来，就堆在墙角，付了钱
就可以拿走，地上尽是掉下来的米粒。有一个伙计拿着扫把把米粒收集在一起。
LONG
	);

	set("exits", ([
		"north" : __DIR__"dongdajie2",
	]));
        set("objects", ([
                 __DIR__"npc/huoji2": 2,
	]));

	setup();
	replace_program(ROOM);
}
