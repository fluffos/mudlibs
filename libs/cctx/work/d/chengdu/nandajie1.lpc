inherit ROOM;

void create()
{
	set("short", "南大街");
	set("long", @LONG
	这是一条宽阔的大街，向南北两头延伸，北面就是城中心，因此这里也
挺热闹。这附近多是一些富户所居住的地方，东西望去都是一些豪宅深院，看上
去的确是富足人家，不过都说豪宅难进，看看那些家丁的神气也就差不多了。向
南走则是出城的方向。
LONG
	);
        set("outdoors", "chengdu");

	set("exits", ([
		"east" : __DIR__"qingle2",
		"south" : __DIR__"nandajie2",
		"west" : __DIR__"qingle3",
		"north" : __DIR__"guangchang",
	]));

	set("objects", ([
		__DIR__"npc/xingren" : 2,
	]));

	setup();
	replace_program(ROOM);
}
