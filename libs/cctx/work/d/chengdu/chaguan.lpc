inherit ROOM;

void create() {
  set("short", "茶馆");
  set("long", @LONG
	这是成都西街边上的一个茶馆，据说已经有上百年的历史了，每天都有
许多的人在这里闲聊品茶。
LONG
  );

  set("exits", ([
    "north": __DIR__ "xidajie1",
  ]));

  set("objects", ([
    __DIR__ "npc/chakejia": 1,
    __DIR__ "npc/chakeyi": 1,
    __DIR__ "npc/chakebing": 1,
    __DIR__ "npc/chakeding": 1,
  ]));

  setup();
}
