// xuanbingjian.c 玄冰剑
// Written by Doing Lu 1998

#include <weapon.h>
inherit SWORD;

void create()
{
	set_name("玄冰剑", ({ "sword" }));
	set_weight(3000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄用寒冰玉石与玄铁石合铸煅锻成造的宝剑，是世上少有的神兵宝刃。\n");
		set("value", 500000);
		set("material", "steel");
		set("wield_msg", "$N轻轻拔出$n，一股寒气扑面而来。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
	}
	init_sword(120);
	setup();
}
