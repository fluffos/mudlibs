// chanhunsuo.c  缠魂索
#include <weapon.h>
inherit WHIP;

void create() {
  set_name("缠魂索", ({ "chanhun suo", "suo" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "这是一条缠魂索，上面隐然有一股霸气 。\n");
    set("value", 100000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抖出一条$n，一股杀气扑面而来。\n");
    set("unwield_msg", "$N将手中的$n卷回腰间。\n");
  }
  init_whip(65);
  setup();
}
