// feiyunjian.c 飞云剑
// Written by Doing Lu 1998

#include <weapon.h>
inherit SWORD;

void create()
{
	set_name("飞云剑", ({ "sword" }));
	set_weight(2500);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄用寒冰玉石锻造的宝剑，剑身淡淡显出云彩。\n");
		set("value", 100000);
		set("material", "steel");
		set("wield_msg", "$N伸手拔出$n，宛如彩云出虹。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
	}
	init_sword(80);
	setup();
}
