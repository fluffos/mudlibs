// jinjiezhi.c 金戒指
// Written by Doing Lu

#include <armor.h>

inherit FINGER;

void create()
{
	set_name("金戒指", ({ "jin jiezhi", "jiezhi" }));
	set("weight", 100);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一枚精致的金戒指。\n");
		set("unit", "个");
		set("value", 10000);
		set("material", "gold");
		set("armor_prop/armor", 2);
	}
	setup();
}	
