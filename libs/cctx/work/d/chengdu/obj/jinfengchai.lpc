// jinfengchai.c 金凤钗
// Written by Doing Lu

#include <armor.h>

inherit HEAD;

void create()
{
	set_name("金凤钗", ({ "jin fengchai", "fengchai" }));
	set("weight", 150);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一只精致的金凤钗。\n");
		set("unit", "个");
		set("value", 40000);
		set("material", "gold");
		set("armor_prop/armor", 5);
	}
	setup();
}	

int wear()
{	
	if (::wear())
	{
		if (this_player()->query("gender") != "女性") write("你好恶心。\n");			
		return 1;		
	}
	return 0;
}