// jinxianglian.c 金项链
// Written by Doing Lu

#include <armor.h>

inherit NECK;

void create()
{
	set_name("金项链", ({ "jin xianglian", "xianglian" }));
	set("weight", 300);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一枚精致的金项链。\n");
		set("unit", "个");
		set("value", 30000);
		set("material", "gold");
		set("armor_prop/armor", 5);
	}
	setup();
}	

int wear()
{	
	if (::wear())
	{
		if (this_player()->query("gender") != "女性") write("我吐、吐、吐！\n");
		return 1;		
	}
	return 0;
}