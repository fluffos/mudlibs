// duanhundao.c 断魂刀
// Written by Doing Lu 1998

#include <weapon.h>
inherit BLADE;

void create() {
  set_name("断魂刀", ({ "blade" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄诡秘异常的宝刀，青冷冷的刀刃上透出一股杀气。\n");
    set("value", 120000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声拔出$n，一股杀气油然而起。\n");
    set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
  }
  init_blade(100);
  setup();
}
