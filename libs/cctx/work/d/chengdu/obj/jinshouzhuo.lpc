// jinshouzhuo.c 金手镯
// Written by Doing Lu 1998

#include <ansi.h>
#include <armor.h>

inherit WRISTS;

void create()
{
	set_name( "金手镯", ({ "jin shouzhuo", "shouzhuo"}) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
		set("long", "这是一件精美的金手镯。\n");
		set("value", 50000);
		set("material", "gold");
		set("armor_prop/armor", 5);
	}
	setup();
}

int wear()
{	
	if (::wear())
	{
		if (this_player()->query("gender") != "女性") write("你好好照照镜子吧！\n");
		return 1;		
	}
	return 0;
}