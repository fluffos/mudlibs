// fumobian.c  伏魔鞭
#include <weapon.h>
inherit WHIP;

void create() {
  set_name("伏魔鞭", ({ "fumo bian", "bian" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "这是一条伏魔鞭，似乎有着无边的慈悲之意。\n");
    set("value", 300000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抖出一条$n，当真有着惊天地泣鬼神的气势。\n");
    set("unwield_msg", "$N将手中的$n卷回腰间。\n");
  }
  init_whip(100);
  setup();
}
