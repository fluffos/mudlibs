// wuhoumiji.c 武侯秘籍
// Written by Doing Lu 1998

inherit ITEM;

void create()
{
	set_name("武侯秘籍", ({ "shu", "book" }));
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是诸葛亮遗留下来的秘籍，上有兵法著作，是无上的文学宝典，但是它深奥难懂。\n");
		set("value", 0);
		set("material", "silk");
		set("skill", ([
			"name":	"literate",
			"exp_required":	0,
                        "jing_cost":    40,
			"difficulty":	40,
                    "max_skill": 199
		]) );
	}
}
