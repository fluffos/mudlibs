// yanlingdao.c 燕翎刀
// Written by Doing Lu 1998

#include <weapon.h>
inherit BLADE;

void create()
{
	set_name("燕翎刀", ({ "blade" }));
	set_weight(15000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄又厚又重的刀，虽然难以使动，但其威力不可小觑。\n");
		set("value", 40000);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声将$n握在手中，阴森森的透出一股寒气。\n");
		set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
	}
	init_blade(65);
	setup();
}
