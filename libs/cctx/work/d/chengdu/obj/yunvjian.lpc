// yunvian.c 玉女剑
// Written by Doing Lu 1998

#include <weapon.h>
inherit SWORD;

void create()
{
	set_name("玉女剑", ({ "sword" }));
	set_weight(2000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄轻灵薄刃的玉女剑，虽然纤细，却是用百练精钢打造而成。\n");
		set("value", 40000);
		set("material", "steel");
		set("wield_msg", "$N随手一晃，亮出了一柄$n。\n");
		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
	}
	init_sword(50);
	setup();
}
