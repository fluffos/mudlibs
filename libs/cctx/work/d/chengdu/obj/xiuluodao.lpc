// xiuluodao.c 修罗刀
// Written by Doing Lu 1998

#include <weapon.h>
inherit BLADE;

void create()
{
	set_name("修罗刀", ({ "blade" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄修罗刀，刀上似乎有一股淡淡的怨气。\n");
		set("value", 20000);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声将$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
	}
	init_blade(50);
	setup();
}
