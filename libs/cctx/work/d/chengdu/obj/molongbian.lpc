// molongbian.c  魔龙鞭
#include <weapon.h>
inherit WHIP;

void create()
{
	set_name("魔龙鞭", ({ "molong bian", "bian" }));
	set_weight(1000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "这是一条魔龙鞭，坚韧而沉重。\n");
		set("value", 20000);
		set("material", "leather");
		set("wield_msg", "$N「唰」的一声抖出一条$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n卷回腰间。\n");
	}
	init_whip(40);
	setup();
}
