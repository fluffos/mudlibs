// jiuzhuan.c 九转金丹 (秘密)
// Written by Doing Lu 1998

#include <ansi.h>

inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("九转金丹", ({ "jiuzhuan jindan", "dan" }));
  set("no_drop", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "这是一粒太上老君练成的九转金丹，服一粒可长生不老。\n");
    set("value", 10000000);
  }
  setup();
}

int do_eat(string arg) {
  object me;

  me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  me->add("max_neili", 200);
  me->set("neili", me->query("max_neili"));
  me->set_temp("nopoison", 1);
  me->set("eff_jing", me->query("max_jing"));
  me->set("jing", me->query("max_jing"));
  me->set("eff_qi", me->query("max_qi"));
  me->set("qi", me->query("max_qi"));
  me->set("food", 300);
  me->set("water", 300);
  if (me->query("potential") < 10000) {
    me->add("potential", me->query("combat_exp") / 500);
  }
  me->set_skill("hunyuan-yiqi", 150);

  message_vision(HIY "$N服下一粒九转金丹，觉得神台一片空明，一股内息源源而起，说不出的受用。\n" NOR, this_player());
  destruct(this_object());
  return 1;
}
