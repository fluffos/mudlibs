inherit ROOM;

void create() {
  set("short", "西大街");
  set("long", @LONG
	这是一条宽阔的大街，向东西两头延伸，这里几乎没什么人，偶然路上
有一两个匆匆的行人。北面有一个小店，卖些日用杂货，但好象没什么人。南面
则是一个镖局，但是早已荒废，据说是惹怒了青城派的高手，派人把镖局给抄了。
再往西就更荒凉了，东面似乎热闹一些。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "east": __DIR__ "xidajie1",
    "south": __DIR__ "biaoju",
    "west": __DIR__ "xidajie3",
    "north": __DIR__ "zahuodian",
  ]));

  setup();
  replace_program(ROOM);
}
