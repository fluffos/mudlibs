void create() {
  set("short", "清乐大街");
  set("long", @LONG
	这是一条东西走向的宽阔大街，成都的富户大都聚居在这里，一般的人
不要说住在这里，就是来这里逛逛也不太可能。可是这里阴沉沉的，没有半点生
气。大街上也看不到人。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "west": __DIR__ "qingle2",
  ]));

