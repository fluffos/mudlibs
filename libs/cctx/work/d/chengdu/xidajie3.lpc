inherit ROOM;

void create() {
  set("short", "西大街");
  set("long", @LONG
	这是一条宽阔的大街，向东西两头延伸，往西就是城门了，从那里出去
就是青城山，但是听说那里有土匪出没，没有点本事的人最好还是不要到那里去。
东面通往城内，那里就安全多了。街道南北都住着一些贫民。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "east": __DIR__ "xidajie2",
    "north": __DIR__ "pinminju1",
    "west": __DIR__ "ximen",
    "south": __DIR__ "pinminju2",
  ]));

  setup();
}
