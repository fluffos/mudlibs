inherit ROOM;

void create() {
  set("short", "牛府大院");
  set("long", @LONG
	这里是牛府的大院，中间有个鱼池，附近是一个假山，一直连到后院，
很有气势。
LONG
  );

  set("exits", ([
    "east": __DIR__ "niufuroom1",
    "south": __DIR__ "niufudamen",
    "west": __DIR__ "niufuroom2",
    "north": __DIR__ "niufuroom3",
  ]));

  set("objects", ([
    __DIR__ "npc/huyuan": 2,
    __DIR__ "npc/puyi": 1,
    __DIR__ "npc/yahuan": 1,
  ]));

  setup();
  replace_program(ROOM);
}
