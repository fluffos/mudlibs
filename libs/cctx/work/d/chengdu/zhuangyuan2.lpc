inherit ROOM;

void create() {
  set("name", "状元楼");
  set("short", "状元楼二楼");
  set("long", @LONG
	这状元楼上，可以说是成都城举办酒宴的最佳场所，不少富户商人都是在
这里摆的结婚喜宴，你若是要定（ding)酒席，可以和状元楼的言老板谈。状元楼势
很高，显得很有气派，你站在楼上眺望，只见成都市中房磷节错，高高低低，别有
一番风味。墙上挂着价格牌子(paizi)，若是要想购买一些高档食品点心，可以和小
二说。在大厅四周的走廊分别通向各个雅间，里面不断传来划拳喝彩的声音。
LONG
  );

  set("item_desc", ([
    "paizi": "本店出售烤鸭，全兴酒。\n",
  ]));

  set("objects", ([
    __DIR__ "npc/yan": 1,
    __DIR__ "npc/xiaoer2": 1,
  ]));

  set("exits", ([
    "down": __DIR__ "zhuangyuan1",
  ]));

  setup();
}
