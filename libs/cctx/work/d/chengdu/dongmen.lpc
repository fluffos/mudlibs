inherit ROOM;

void create() {
  set("short", "东门");
  set("long", @LONG
	这是就是成都的东门，由于这里曾是三国故都，因此城墙高大，城门也
显得异常雄伟，由于常年没有战火，因此守门的官兵也不是很经意，城门口人来
人往，都在忙碌自己的事情。向西便可通往城内，东边则是驿道，弯弯曲曲的，
很不好走。
LONG
  );
  set("outdoors", "chengdu");

  set("exits", ([
    "east": __DIR__ "shudao19",
    "west": __DIR__ "dongdajie3",
  ]));

  set("objects", ([
    __DIR__ "npc/bing2": 2,
    __DIR__ "npc/wujiang": 1,
    __DIR__ "npc/xingren": 3,
  ]));

  setup();
  replace_program(ROOM);
}
