inherit ROOM;

void create()
{
	set("short", "东大街");
	set("long", @LONG
	这是一条宽阔的大街，向东西两头延伸，这里是靠近东门的城边，向东
就可以看到城门，向西通往城内，南北都有一些民居。
LONG
	);
        set("outdoors", "chengdu");

	set("exits", ([
		"east" : __DIR__"dongmen",
		"south" : __DIR__"minju2",
		"west" : __DIR__"dongdajie2",
		"north" : __DIR__"minju1",
	]));

	setup();
	replace_program(ROOM);
}
