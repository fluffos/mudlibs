#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIW "比武广场" NOR);
        set("long", @LONG
这里是老英雄公平子先生的比武广场。平整的青石地板，四面旌旗飘扬。
四周的墙上挂着十八般武器，供比武的人任意取用。天下的英雄们若要一争
高低，都来此比试。有公平子老先生为证，谁也无法投机取巧，所以这里的
英雄排名，为天下人士所公认。
LONG
        );
        setup();
 	set ("exits",([
        "down" : "/d/changan/guangchang",
		]));
       

}

void init()
{
	this_player()->set_temp("biwu",1);

}

