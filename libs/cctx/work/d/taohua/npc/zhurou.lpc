// /d/taohua/npc/zhurou.c 小猪耳朵
// adx 22:36 99-2-16
inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("小猪耳朵", ({"zhurou", "zhu"}));
	set_weight(300);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一块从刚杀的小猪上割下的耳朵。\n");
		set("unit", "块");
		set("value", 200);
		set("food_remaining", 4);
		set("food_supply", 50);
	}
}
