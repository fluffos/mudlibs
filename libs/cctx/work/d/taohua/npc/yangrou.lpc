inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("羊羔坐臀", ({ "yangrou", "yang" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块鲜血淋漓肥的羊羔坐臀。\n");
    set("unit", "块");
    set("value", 200);
    set("food_remaining", 4);
    set("food_supply", 50);
  }
}
