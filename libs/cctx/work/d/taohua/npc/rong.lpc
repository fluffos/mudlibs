
inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
    set_name("黄蓉", ({"huang rong", "huang", "rong"}));
    set("title", "桃花岛主独生爱女");
    set("gender", "女性");
    set("age", 18);
	set("long", 
        "这是桃花岛主的独生女儿。由于岛主夫人早死，岛主对这个女儿备加疼爱。\n"
        "她生性跳脱飞扬，喜欢四处乱跑。\n");

	set("attitude", "peaceful");
	
    set("str", 18);
    set("int", 30);
    set("con", 21);
    set("dex", 26);

    set("qi", 500);
    set("max_qi", 500);
	set("jing", 100);
	set("max_jing", 100);
    set("neili", 800);
    set("max_neili", 800);
    set("jiali", 0);
	
    set("combat_exp", 150000);
    set("score", 0);
	
    set_skill("force", 60);
    set_skill("bibo-shengong", 80);
    set_skill("unarmed", 80);
    set_skill("luoying-zhang", 80);
       set_skill("dodge", 100);
    set_skill("anying-fuxiang", 80);
    set_skill("parry", 85);
    set_skill("sword", 80);
    set_skill("luoying-shenjian",80);
	set_skill("qimen-wuxing",60);
	set_skill("literate",80);
	
    map_skill("force"  , "bibo-shengong");
    map_skill("unarmed", "luoying-zhang");
    map_skill("dodge"  , "anying-fuxiang");
    map_skill("sword"  , "luoying-shenjian") ;

        set("inquiry", ([
	"作菜" : "我会做“玉笛谁家听落梅”这可是道名菜！\n",
	"玉笛谁家听落梅" : "做这道菜可不容易，要羊羔坐臀、小猪耳朵、小牛腰子、獐腿肉和小免肉。\n",
	"郭靖" : "他在哪，带我去找他。\n",
	"黄药师" : "他是我爹！\n",
	"桃花岛" : "这是我的家，外人不能随便来。\n",
	"归云庄" : "这是桃花岛弟子在中原的落脚点。\n",
        ]));

    create_family("桃花岛", 2, "弟子");
	setup();
    carry_object("/d/taohua/obj/ruanwei")->wear();
    carry_object("/d/taohua/obj/shudai")->wear();

}
void attempt_apprentice(object ob)
{
    command("say 我年纪这么小就收徒弟，岂不让人笑掉大牙！");
}