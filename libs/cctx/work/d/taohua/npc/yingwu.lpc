// /d/taohua/npc/yingwu.c
// adx 12:02 99-2-10
#include <ansi.h>
inherit NPC;

void greeting(object);
void init();
void create()
{
	set_name(HIY"鹦"+HIG"鹉"NOR, ({ "ying wu","ying","wu" }) );
	set("long", "一只黄绿色的鹦鹉。\n");

	set("race", "野兽");
	set("age", 3);
	set("attitude", "heroism");

	set("max_ging", 80);
	set("max_qi", 80);

	set("str", 10);
	set("cor", 50);

	set("limbs", ({ "嘴", "翅膀", "爪子" }) );
	set("verbs", ({ "bite" }) );

	set_temp("apply/attack", 10);
	set_temp("apply/damage", 10);
	set_temp("apply/armor", 10);

	set("combat_exp", 1000);
	setup();
}
void init()
{
	object ob;

	::init();

	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}
void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	if((string)ob->query("family/family_name")=="桃花岛")
	   { say(HIY"鹦"+HIG"鹉"+HIW"尖声道：“岛主来了、岛主来了……”\n" NOR);
	     return;
	    }
	if(!ob->query("family/family_name"))
	   { say(HIY"鹦"+HIG"鹉"+HIW"尖声道：“有刺客，有刺客……”\n" NOR);
	     return;
	    }

}

