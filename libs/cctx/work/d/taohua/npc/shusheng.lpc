// /NPC shusheng.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("弱质书生", ({ "shu sheng","shu", "sheng"}));
	set("long",
	    "这是个弱质书生, 手无缚鸡之力,\n"+
	    "四体不群, 五谷不分.\n");
	set("gender", "男性");
	set("age", 25);
	set("shen_type",1);
	set("attitude", "peaceful");

	set("str", 14);
	set("int", 20);
	set("con", 15);
	set("dex", 16);

	set("qi", 100);
	set("max_qi", 100);
	set("jing", 100);
	set("max_jing", 100);

	set("chat_msg", ({
		"书生说道: 请这位是否想上桃花岛，哪里有一个吃人的恶魔。\n"+
		"如果你肯花点钱我告诉你怎么去。\n",
		(: random_move :)
	}) );
	setup();
	carry_object("/d/taohua/obj/cloth")->wear();
}
int accept_object(object me, object ob)
{
	object qing;
	
	command("smile");
	command("say 呵呵，多谢这位" + RANK_D->query_respect(me) + " ！");

	if( ob->query("money_id") && me->query("class") != "bonze" ) 
	{
		if(ob->value() < 100000)
		{
			command("say 这位给的未免少了点。");
			return 1;
		}
		else
		{
			command("say " + RANK_D->query_respect(me) + 
			"好，你拿着请柬尽管大胆地上岛。");

			qing=new("/d/taohua/obj/qingjian");
			qing->move(me);
			message_vision("书生给$N一张请柬。\n", me);

			command("say 请柬限时一日，逾时失效，到时你要速速离岛，否则有性命之忧，切记切记！"); 
			return 1;
		}
	}

	return 1;
}

