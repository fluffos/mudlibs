// yapu1.c

#include <ansi.h>
inherit NPC;

void create()
{
	set_name("哑仆", ({ "ya pu","ya","pu" }) );
	set("gender", "男性" );
	set("age", 40);
	set("long",
		"一个表情呆板的老仆人,负责守卫桃花岛。\n"
		"如有擅闯桃花岛着"+HIR"杀无赦。\n"NOR
);
	set("age", 35);
	set("shen_type", 1);
	set("str", 27);
	set("int", 20);
	set("con", 25);
	set("dex", 27);
	set("max_qi", 1000);
	set("max_jing", 300);
	set("neili", 2000);
	set("max_neili", 2000);
	set("jiaji", 100);
	set("combat_exp", 200000);
	set("score", 2);

	set_skill("force", 70);
	set_skill("bibo-shengong", 70);
	set_skill("dodge", 70);
	set_skill("anying-fuxiang", 70);
	set_skill("unarmed", 70);
	set_skill("parry", 70);
	set_skill("cuixin-zhang", 70);

	map_skill("force", "bibo-shengong");
	map_skill("dodge", "anying-fuxiang");
	map_skill("unarmed", "cuixin-zhang");
	map_skill("parry", "cuixin-zhang");

	set("chat_chance_combat", 30);
	set("chat_msg_combat", ({
		(: perform_action, "force.powerup" :),
		(: perform_action, "unarmed.gu" :),
		(: exert_function, "recover" :),
}) );
       set("chat_chance",2);
        set("chat_msg",({
                (:random_move :) 
      }));
	setup();

	carry_object("/d/taohua/obj/cloth")->wear();
}

void init()
{
	object me, ob;
	mapping fam;

	::init();

	ob = this_player();
	me = this_object();
	
	if (interactive(ob) 
	&& !environment(ob)->query("no_fight")
	&& !present("qingjian", ob) 
	&& ( (fam = ob->query("family")) && fam["family_name"] != "桃花岛" ) )
	{
		if( !ob->query_temp("warned") ) {

			ob->set_temp("warned", 1);
		}
		else if( ob->query_temp("stay") < 3 ) ob->add_temp("stay", 1);
		else {
			me->set_leader(ob);
			remove_call_out("kill_ob");
			call_out("kill_ob", 1, ob); 
		}
	}

}
