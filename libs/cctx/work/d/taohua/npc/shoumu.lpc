// /d/taohua/npc/puren3.c
// adx 3:16 99-2-8

#include <ansi.h>
inherit NPC;
inherit F_SKILL;
void create()
{
	set_name("守墓家奴", ({"shoumu jianu","shoumu","jianu"}));
	set("long",
		"他是守卫桃花岛女主冯氏墓的家奴，两臂粗壮，他手持长剑。\n"
	);
	set("gender", "男性");
	set("attitude", "peaceful");
	set("class", "bonze");

	set("age", 35);
	set("shen_type", 1);
	set("str", 27);
	set("int", 20);
	set("con", 25);
	set("dex", 27);
	set("max_qi", 1500);
	set("max_jing", 300);
	set("neili", 1500);
	set("max_neili", 1500);
	set("jiaji", 100);
	set("combat_exp", 100000);
	set("score", 2);

	set_skill("force", 70);
	set_skill("bibo-shengong", 70);
	set_skill("dodge", 70);
	set_skill("anying-fuxiang", 70);
	set_skill("unarmed", 70);
	set_skill("luoying-zhang", 70);
	set_skill("parry", 70);
	set_skill("luoying-shenjian", 70);

	map_skill("force", "bibo-shengong");
	map_skill("dodge", "anying-fuxiang");
	map_skill("unarmed", "luoying-zhang");
	map_skill("parry", "luoying-shenjian");

	set("chat_chance_combat", 30);
	set("chat_msg_combat", ({
		(: perform_action, "force.powerup" :),
		(: exert_function, "recover" :),
}) );
	setup();

	carry_object("/d/obj/changjian")->wield();
	carry_object("/d/obj/cloth")->wear();
}
void init()
{
	object ob;
	::init();
	if (interactive(ob = this_player()) && 
		(int)ob->query_condition("killer")) {
		remove_call_out("kill_ob");
		call_out("kill_ob", 1, ob);
	}
	if( interactive(ob = this_player()) && !is_fighting() ) {
        switch(random(10))
	{   
        case 1:
	message_vision("\n突然墓室中打开了一道暗门，从里面走出一个守墓家奴。\n"
	"对$N喝道：贼子敢尔！连夫人的东西你也敢动！\n", this_player());
	remove_call_out("kill_ob");
	call_out("kill_ob", 1, ob);
	break;
	}
	}
}