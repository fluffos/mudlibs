inherit NPC;

void create() {
  set_name("守墓家奴", ({ "shoumu jianu", "shoumu", "jianu" }));
  set("long",
    "他是守卫桃花岛女主冯氏墓的家奴，两臂粗壮，他手持长剑。\n"
  );

  set("gender", "男性");
  set("attitude", "aggressive");
  set("class", "bonze");

  set("age", 20);
  set("shen_type", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("max_qi", 500);
  set("max_jing", 300);
  set("neili", 500);
  set("max_neili", 500);
  set("pursuer", 1);
  set("combat_exp", 10000);
  set("score", 1);

  set_skill("force", 60);
  set_skill("bibo-shengong", 60);
  set_skill("dodge", 60);
  set_skill("anying-fuxiang", 60);
  set_skill("unarmed", 60);
  set_skill("luoying-zhang", 60);
  set_skill("parry", 60);
  set_skill("blade", 60);
  set_skill("luoying-shenjian", 60);

  map_skill("force", "bibo-shengong");
  map_skill("dodge", "anying-fuxiang");
  map_skill("unarmed", "luoying-zhang");
  map_skill("parry", "luoying-shenjian");
  map_skill("blade", "luoying-shenjian");

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "force.powerup" :),
    (: exert_function, "recover" :),
    setup();
    carry_object("/d/obj/changjian")->wield();
    carry_object("/d/obj/cloth")->wear();
  }
