// /d/taohua/puren2.c
// adx 2:32 99-2-8

#include <ansi.h>
inherit NPC;

string ask_me(string name);

void create()
{
	set_name("仆人", ({ "pu ren", "pu", "ren", }));
	set("long",
		"他是个厨子，负责给众弟子和仆人做饭\n" );
	set("gender", "男性");
	set("attitude", "friendly");
	set("class", "bonze");

	set("age", 40);
	set("shen_type", 1);
	set("str", 17);
	set("int", 16);
	set("con", 18);
	set("dex", 20);
	set("max_qi", 150);
	set("max_jing", 150);
	set("jiali", 10);
	set("combat_exp", 5000);

	set_skill("force", 15);
	set_skill("dodge", 15);
	set_skill("unarmed", 15);
	set_skill("parry", 15);

        set("inquiry", ([
		"吃的" : (: ask_me, "gao" :),
		"食物" :   (: ask_me, "gao" :),
		"水" :   (: ask_me, "chahu" :),
                "茶" :   (: ask_me, "chahu" :),
        ]));

	set("foor_count", 15);

	setup();
	carry_object("/d/taohua/obj/cloth")->wear();
}

string ask_me(string name)
{
	mapping fam; 
	object ob;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "桃花岛")
		return RANK_D->query_respect(this_player()) + 
		"你与本派素无来往，不知此话从何谈起？";

	if (  present(name, this_player()) )
		return RANK_D->query_respect(this_player()) + 
		"你现在身上不是有吗，怎麽又来要了？别人都还没吃饭呢！";

        if( this_player() ->query("age")<15)
                return "你年纪太小我不给你!";

	if (query("foor_count") < 1)
		return "抱歉，你来得不是时候，开饭的时间已经过了。";

	ob = new("/d/taohua/obj/" + name);
	ob->move(this_player());

	add("foor_count", -1);

	message_vision(YEL"仆人给$N一个" + ob->query("name") + "。\n"NOR, this_player());

	return "给。";
}
