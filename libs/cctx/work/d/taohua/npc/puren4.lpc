// /d/taohua/npc/puren4.c
// adx 21:20 99-2-12
#include <ansi.h>
inherit NPC;
void create() {
  set_name("仆人", ({ "pu ren", "pu", "ren", }));
  set("long",
    "他是一位身材高大的仆人，负责守卫桃花岛。\n"
  );

  set("gender", "男性");
  set("attitude", "peaceful");

  set("age", 35);
  set("shen_type", 1);
  set("str", 27);
  set("int", 20);
  set("con", 25);
  set("dex", 27);
  set("max_qi", 1500);
  set("max_jing", 300);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiaji", 100);
  set("combat_exp", 100000);
  set("score", 2);

  set_skill("force", 70);
  set_skill("bibo-shengong", 70);
  set_skill("dodge", 70);
  set_skill("anying-fuxiang", 70);
  set_skill("unarmed", 70);
  set_skill("luoying-zhang", 70);
  set_skill("parry", 70);
  set_skill("luoying-shenjian", 70);

  map_skill("force", "bibo-shengong");
  map_skill("dodge", "anying-fuxiang");
  map_skill("unarmed", "luoying-zhang");
  map_skill("parry", "luoying-shenjian");

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: perform_action, "force.powerup" :),
    (: exert_function, "recover" :),
  }));
  setup();

  carry_object("/d/taohua/obj/changjian")->wield();
  carry_object("/d/taohua/obj/cloth")->wear();
}

void init() {
  object me, ob;
  mapping fam;

  ::init();

  ob = this_player();
  me = this_object();

  if (interactive(ob)
    && !environment(ob)->query("no_fight")
    && !present("qing jian", ob)
    && ((fam = ob->query("family")) && fam["family_name"] != "桃花岛")) {
    if (!ob->query_temp("warned")) {
      command("say 你是谁？  怎么闯到桃花岛里来了？速速离开！");
      command("say 岛主有令：外人不得擅自上岛！");
      ob->set_temp("warned", 1);
    } else if (ob->query_temp("stay") < 3) ob->add_temp("stay", 1);
    else {
      command("say 大胆狂徒，竟敢闯到桃花岛里来撒野！！！\n");
      me->set_leader(ob);
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, ob);
    }
  }

}
