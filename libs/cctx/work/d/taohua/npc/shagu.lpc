// /d/taohua/npc/shagu.c
// adx 3:16 99-2-8

#include <ansi.h>

inherit NPC;

void create() {
  set_name("傻姑", ({ "sha gu", "sha", "gu", }));
  set("long",
    "她是曲灵风的女儿，由于小时侯受到惊吓，变得傻里傻气。\n"
  );
  set("gender", "女性");
  set("attitude", "peaceful");
  set("class", "bonze");

  set("age", 17);
  set("shen_type", 1);
  set("str", 30);
  set("int", 15);
  set("con", 25);
  set("dex", 27);
  set("max_qi", 1500);
  set("max_jing", 300);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiaji", 100);
  set("combat_exp", 300000);
  set("score", 2);

  set_skill("force", 70);
  set_skill("bibo-shengong", 70);
  set_skill("dodge", 70);
  set_skill("anying-fuxiang", 70);
  set_skill("unarmed", 70);
  set_skill("parry", 70);
  set_skill("cuixin-zhang", 70);

  map_skill("force", "bibo-shengong");
  map_skill("dodge", "anying-fuxiang");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("parry", "cuixin-zhang");

  set("chat_chance_combat", 35);
  set("chat_msg_combat", ({
    (: perform_action, "force.powerup" :),
    (: perform_action, "unarmed.gu" :),
    (: exert_function, "recover" :),
  }));
  setup();

  carry_object("/d/taohua/obj/cloth")->wear();
}

void init() {
  object me, ob;
  mapping fam;

  ::init();

  ob = this_player();
  me = this_object();

  if (interactive(ob)
    && !environment(ob)->query("no_fight")
    && !present("qing jian", ob)
    && ((fam = ob->query("family")) && fam["family_name"] != "桃花岛")) {
    command("say 你来陪我玩啊！！！\n");
    remove_call_out("hit_ob");
    call_out("hit_ob", 1, ob);
  }
}
