// /d/taohua/tanzhi.c
// adx 2:23 99-2-6
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short","弹指峰");
	set("long",@LONG
你爬上桃花岛唯一的山峰弹指峰，站在这里可以一览整个不大的桃花岛，
四周是一片万顷碧涛。旁边有一块大石（shone）据说当年黄药师就是站
在上面看到万顷碧波排山倒海，领悟出了碧波神功和碧海潮声曲。大石上
好象刻着几个小字（zhi）。
LONG
	);
	set("exits", ([
	"northdown" : __DIR__"shanlu",
]));

	set("item_desc", ([
	    "shone" : YEL"这是一块大石足有十丈高，你可以爬（climb）上去.\n"NOR,
	    "zhi" : YEL "如果不知道怎么下来（xia），就不要上去。东邪黄某警告后来者。\n" NOR ,
        ]));

	set("outdoors", "taohua");
	setup();
}
void init()
{
    add_action("do_climb", "climb");
}
int do_climb(object me)
{
    me = this_player () ;
    if(!me->query_skill("bibo-shengong", 1)||(int)me->query_skill("bibo-shengong", 1) < 150||(int)me->query_skill("literate", 1) < 150)
    {
      message_vision("$N刚爬到半截，一口真气提不上来。\n"
                     HIR "结果$N摔了个鼻青脸肿！\n" NOR
                     "看来你的内功修为还很不够。\n" , me ) ;
      me -> receive_damage ("qi",50) ;
      me -> receive_wound  ("qi",50) ;
      return 1;
    }
else
    message_vision(HIW "$N手脚并用两下就爬上大石。\n"NOR, me );
    me->move("/d/taohua/tanzhi1") ;
    return 1 ;
}
