// /d/taohua/shufang.c
// adx 14:47 99-2-7
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "桃花轩一楼");
  set("long", @LONG
这是一个竹子搭的房间，墙上挂着一幅画（hua），西边是一个练功房，
南边是桃花岛唯一一座山峰弹指峰，北边有一个荷花池。
LONG
  );
  set("exits", ([
    "north": __DIR__ "hehuachi",
    "southup": __DIR__ "shanlu",
    "up": __DIR__ "taohuaxuan2",
    "west": __DIR__ "liangong3",
    "northeast": __DIR__ "xiaowu",
  ]));
  set("item_desc", ([
    "hua": "这是一幅很普通的水墨画，画后面好象放着一本书，不要掀开来（xian）看。",
  ]));
  set("objects", ([
    __DIR__ "npc/puren3": 1,
  ]));
  setup();
}
void init() {
  add_action("do_xian", "xian");
  add_action("do_pick", "pick");
}
void reset() {
  ::reset();
  set("get_available", 1);
}
int do_pick(string arg) {
  object me, obj;

  me = this_player();
  if (!arg || arg != "zhenjing2")
    return notify_fail("什麽？\n");
  if (query("get_available")) {
    obj = new(__DIR__ "obj/jiuyin2");
    obj->move(me);
    add("get_available", -1);
    message_vision(YEL "$N从画后面拿出一本书。\n" NOR, me);
  } else
    return notify_fail("什麽？\n");
  return 1;
}
int do_xian(string arg) {
  object me = this_player();
  if (!arg || arg != "hua")
    return notify_fail("你要掀开什么？\n");
  message_vision(HIR "$N刚一把画掀开，后面突然飞出几支" + HIY "金针" + HIR "“飕、飕飕……”尽数打在$N的胸口。\n" NOR, me);
  me->add("qi", -100),
    me->add("eff_qi", -100);
  return 1;
}
