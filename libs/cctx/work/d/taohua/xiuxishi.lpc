inherit ROOM;

void create() {
  set("short", "休息室");
  set("long", @LONG
这是专供桃花岛弟子休息的小屋。屋里放着五六张床，挤挤地占掉了
屋子的一大半地方。屋角很散乱地放了一些日常生活用具。中央放着
一张桌子，上面摆一茶壶和几个杯子。
LONG);
  set("exits", ([
    "east": __DIR__ "xiaoyuan",
  ]));
  set("sleep_room", 1);
  set("no_fight", 1);
  setup();
  replace_program(ROOM);
}
