#include <room.h>
inherit ROOM;

void create()
{
	set("short", "竹楼");
	set("long",@LONG
这里是一个用竹子搭的小楼,东面是桃花山庄的正厅，北面是一条长长的走廊。
东面有一扇竹门，飘出阵阵药味。
LONG);
	set("exits", ([
		"east" : __DIR__"liandan",
		"west" : __DIR__"dating",
		"up" : __DIR__"zhulou2",
		"northeast" : __DIR__"zoulang2",
		"southwest" : __DIR__"houyuan",
]));
        create_door("east", "铁门", "west", DOOR_CLOSED);
    set("objects", ([
                "/kungfu/class/taohua/huang" : 1,
        ]));
	setup();
	replace_program(ROOM);
}
