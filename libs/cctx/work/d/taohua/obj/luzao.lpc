#include <ansi.h>

inherit ITEM;
int serve_cai(object);

void create() {
  set_name("炉灶", ({ "luzao" }));
  set_weight(3000);
  set_max_encumbrance(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一个炉灶，你可以在上面作菜（soup）。\n");
    set("value", 1000);
    set("no_get", 1);
    set("no_drop", 1);
    set("amount", 30);
  }
  setup();
}
int is_container() { return 1; }
int serve_cai(object who) {
  object ob1, ob2, ob3, ob4, ob5;
  object me, ob, obj;
  me = this_player();
  ob = this_object();

  if (!who || environment(who) != environment())
    return 0;

  if (!who->query_temp("marks/ran"))
    return notify_fail("你得先把炉灶点燃(ran)。\n");

  message_vision("$N拿起锅铲按照黄蓉教你的方法作菜。\n", me);
  if (objectp(ob1 = present("niurou", ob))
    && objectp(ob2 = present("zhurou", ob))
    && objectp(ob3 = present("xiaoturou", ob))
    && objectp(ob4 = present("yangrou", ob))
    && objectp(ob5 = present("zhangrou", ob))) {
    message_vision("$N作好了一道菜。\n", me);
    destruct(ob1);
    destruct(ob2);
    destruct(ob3);
    destruct(ob4);
    destruct(ob5);
    me->delete_temp("marks/ran");
    obj = new("/d/taohua/obj/cai");
    obj->move(ob);
    return 1;
  } else
    return notify_fail("可是好象还有些原料还没准备好呀！\n");
}
