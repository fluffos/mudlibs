#include <ansi.h>
inherit ITEM;

void create() {
  set_name(YEL "弹指指法" NOR, ({ "tanzhi zhifa", "tanzhi", "zhifa" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", YEL "这是修习弹指神通的基本指法。\n" NOR);
    set("value", 0);
    set("no_give", "你不能把桃花岛的东西随便给人。\n");
    set("material", "silk");
    set("skill", ([
      "name": "finger",
      "exp_required": 0,
      "jing_cost": 20,
      "difficulty": 20,
      "max_skill": 100
    ]));
  }
}
