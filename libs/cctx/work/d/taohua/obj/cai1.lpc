// /d/taohua/obj/cai.c
// adx 13:05 99-2-17
#include <ansi.h>
inherit ITEM;


void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "玉" + HIG "笛" + HIY "谁" + HIB "家" + HIM "听" + HIC "落" + HIW "梅" NOR, ({ "cai" }));
  set("unit", "道");
  set("long", "这是一道桃花岛的看家菜，色香味具全，引人食欲大增。\n");
  set_weight(1000);
  set("value", 100);
  setup();
}

int do_eat(string arg) {
  if (!id(arg)) return notify_fail("你要吃什么？\n");
  if (arg == "cai") {
    tell_object(this_player(), HIC "你吃下这道名菜，顿觉灵台一片空明。你的潜能提高了。\n" NOR);
    this_player()->add("int", (random(20))) destruct(this_object());
  }
  return 1;
}
