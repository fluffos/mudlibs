// /d/taohua/obj/chahu.c
// adx 2:48 99-2-8

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("茶壶", ({ "chahu", "cha", "hu" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "装茶用的水壶\n");
    set("unit", "个");
    set("value", 0);
    set("max_liquid", 15);
  }
  set("liquid", ([
    "type": "tea",
    "name": "茶水",
    "remaining": 15,
    "drunk_supply": 5,
  ]));
}
