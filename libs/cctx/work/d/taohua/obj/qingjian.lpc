
#include <ansi.h>
inherit ITEM;

void create()
{
	set_name( HIR"请柬"NOR, ({ "qingjian", "qing" }) );
	set_weight(10);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
                set("long", "这是一张到桃花岛的请柬。\n");
		set("value", 0);
		set("material", "iron");
	}
	setup();
}

void init()
{
        call_out("dest", 1800);
}

void dest()
{
	destruct(this_object());
}
