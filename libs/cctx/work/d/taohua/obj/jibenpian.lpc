#include <ansi.h>
inherit ITEM;

void create() {
  set_name(RED "《暗影浮香》基本篇" NOR, ({ "jiben pian", "book", "shu" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", RED "书上记载着学习暗影浮香的基本武功。\n" NOR);
    set("value", 0);
    set("no_give", "你不能把桃花岛的东西随便给人。\n");
    set("material", "silk");
    set("skill", ([
      "name": "dodge",
      "exp_required": 0,
      "jing_cost": 30,
      "difficulty": 20,
      "max_skill": 100
    ]));
  }
}
