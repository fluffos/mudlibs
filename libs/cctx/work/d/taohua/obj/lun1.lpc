#include <ansi.h>
inherit ITEM;

void create()
{
	set_name(WHT"论语"NOR, ({ "lun yu", "book", "shu" }));
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", WHT"这是一本记录孔子言行的书，是儒家的经典著作。\n"NOR);
		set("value", 0);
		set("no_give", "你不能把桃花岛的东西随便给人。\n");
		set("material", "silk");
		set("skill", ([
			"name":	"literate",
			"exp_required":	0,
                        "jing_cost": 0,
			"difficulty":	20,
			"max_skill":	100
		]) );
	}
}
