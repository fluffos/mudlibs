#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIR "「九阴真经」下册" NOR, ({ "jiuyin zhenjing2", "zhenjing2", }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      HIR "这是一本用薄绢写成的书。上书：“九阴真经(下)”。\n"
      "书皮泛黄，看来已经保存很久了。\n" NOR,

    );
    set("value", 0);
    set("material", "silk");
    set("skill", ([
      "name": "jiuyin-baiguzhao",
      "exp_required": 6000,
      "jing_cost": 40,
      "difficulty": 20,
      "max_skill": 100
    ]));
  }
}
