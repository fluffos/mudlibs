#include <ansi.h>
inherit ITEM;

void create()
{
	set_name(CYN"铁八卦"NOR, ({ "tie bagua", "tie", "bagua" }));
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", CYN"这是一个铁制的八卦，背后仿佛刻着一些小字。\n"NOR);
		set("value", 0);
		set("no_give", "你不能把桃花岛的东西随便给人。\n");
		set("material", "silk");
		set("skill", ([
			"name":	"unarmed",
			"exp_required":	0,
                        "jing_cost":    40,
			"difficulty":	20,
			"max_skill":	100
		]) );
	}
}
