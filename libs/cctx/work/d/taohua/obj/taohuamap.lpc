#include <ansi.h>
inherit ITEM;

void create() {
  set_name(BLU "桃花岛地图" NOR, ({ "map", "book", "shu" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", BLU "这是一张桃花岛的地图，上面画着桃花迷阵的奥妙。\n" NOR);
    set("value", 0);
    set("no_give", "你不能把桃花岛的东西随便给人。\n");
    set("material", "silk");
    set("skill", ([
      "name": "qimen-wuxing",
      "exp_required": 0,
      "jing_cost": 20,
      "difficulty": 20,
      "max_skill": 100
    ]));
  }
}
