// /d/taohua/shufang.c
// adx 14:47 99-2-7
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "书房");
  set("long", @LONG
    这是一间干干净净的书房。当中一个大檀木桌，桌上放着不少书籍。
靠墙的地方还有一个书架(shelf)，架上满满的全是各种封装的书。其中不少书看上去
古意盎然，显然年代已久。
LONG
  );
  set("exits", ([
    "east": __DIR__ "hehuachi",
  ]));
  set("item_desc", ([
    "shelf": "书架上有很多的书你可以拿（pick）下来看看。\n",
  ]));

  set("objects", ([
    __DIR__ "npc/yapu": 2,
    __DIR__ "obj/xiang": 1,
  ]));
  setup();
}
void init() {
  add_action("do_pick", "pick");
  add_action("do_push", "push");
}
int do_pick(string arg) {
  object me, obj;

  me = this_player();
  if (!arg || arg != "book")
    return notify_fail(MAG "你要拿什么?\n" NOR);
  if (query("get_available")) {
    obj = new(__DIR__ "obj/lunyu");
    obj->move(me);
    add("get_available", -1);
    message_vision(YEL "$N从书架上拿下一本《论语》。\n" NOR, me);
  } else
    return notify_fail("书架上的书已经不知道被谁拿走了。\n");
  return 1;
}
void check_trigger() {
  object room;

  if ((int)query("endo_trigger") == 3
    && !query("exits/west")) {
    message("vision", HIW "书架发出轧轧的声音，缓缓向左边移动，原来是一扇门。\n" NOR,
      this_object());
    set("exits/west", __DIR__ "midao");
    if (room = find_object(__DIR__ "midao")) {
      room->set("exits/east", __FILE__);
      message("vision", HIW "书架发出轧轧的声音，缓缓向右边移动，原来是一扇门。\n" NOR,
        room);
    }
    delete("endo_trigger");
    call_out("close_passage", 5);
  }
}
void close_passage() {
  object room;

  if (!query("exits/west")) return;
  message("vision", HIB "书架发出轧轧的声音，缓缓合拢，将向内的通道盖住了。\n" NOR,
    this_object());
  if (room = find_object(__DIR__ "mudao")) {
    room->delete("exits/east");
    message("vision", HIB "书架发出轧轧的声音，缓缓合拢，将向外的通道盖住了。\n"
      HIR "你脑海中闪过一个念头：坏了！出不去了！\n" NOR,
      room);
  }
  delete("endo_trigger");
  delete("exits/west");
}
int do_push(string arg) {
  object ob = this_player();
  string dir;

  if (!arg || arg == "") return 0;

  if (arg == "shelf") {
    write(YEL "你试著推动书架，书架似乎往里动了一下…\n" NOR);
    return 1;
  }
  if (sscanf(arg, "shelf %s", dir) == 1) {
    if (dir == "endo") {
      if (ob->query("max_neili") < 500) return notify_fail(CYN "你的内力不够，推不动书架！\n" NOR);
      if (ob->query("age") < 20) return notify_fail(CYN "你的年龄在大些，再来吧！\n" NOR);
      message_vision(WHT "你将书架往内推开了一条小缝。\n" NOR, this_player());
      add("endo_trigger", 1);
      check_trigger();
      return 1;
    } else {
      write(MAG "你要将书架往哪推？\n" NOR);
      return 1;
    }
  }
}
void reset() {
  ::reset();
  delete("endo_trigger");
  set("get_available", 1);
}
