#include <room.h>
inherit ROOM;

void create()
{
    set("short", "荷花池");
	set("long", @LONG
这里有一个荷花池，满池粉红的荷花正在盛开，东边是桃花岛主黄药师的
书房，南边是桃花轩，北边是桃花山庄的后院。
LONG
	);
    set("exits", ([
     "north" :__DIR__"houyuan",
     "south" :__DIR__"taohuaxuan",
     "west" :__DIR__"shufang" ,
]));
	set("outdoors", "taohua");
            set("objects", ([
                __DIR__"npc/puren3" : 1,
        ]));
	setup();
	replace_program(ROOM);
}
