#include <room.h>
inherit ROOM;

void create() {
  set("short", "后院");
  set("long", @LONG
这是山庄的后院。院里种植许多珍奇花卉，西面不时传来打斗的声音，
是一个供桃花岛弟子练功的房间，往南有一个荷花池，东面是思过室。
在这里就可以看到桃花岛的唯一一座山峰：弹指峰。整个桃花山庄倚
山而立，险势天成。
LONG
  );
  set("exits", ([
    "north": __DIR__ "dating",
    "south": __DIR__ "hehuachi",
    "east": __DIR__ "siguoshi",
    "southeast": __DIR__ "xiaowu",
    "northeast": __DIR__ "zhulou",
    "northwest": __DIR__ "zoulang5",
  ]));
  set("objects", ([
    __DIR__ "npc/yapu1": 2,
  ]));
  set("outdoors", "taohua");
  setup();
}
