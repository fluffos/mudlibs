// /d/taohua/mushi.c
// adx 2:21 99-2-6
#include <ansi.h>
inherit ROOM;

void create() {

  set("short", "密室");
  set("long", @LONG
你走进一间不大的房间，四周阵阵寒气冒了过来，似乎是一间冰窖，前面放着
一张石床，床上空无一人。右边有一个架子，架子上摆着几个瓶子（bottle）。
LONG);

  set("item_desc", ([
    "bottle": "有，红瓶子、蓝瓶子、绿瓶子、黄瓶子、紫瓶子、白瓶子、黑瓶子。\n",
  ]));
  set("exits", ([
    "southup": __DIR__ "midao",
  ]));

  setup();

}
void init() {
  add_action("do_pick", "pick");
}
void reset() {
  ::reset();
  set("get_available", 2);
}
int do_pick(string arg) {
  object me, obj;
  me = this_player();

  if (!arg || arg != "紫瓶子") {
    message_vision(HIR "突然飞出几支" + HIY "金针" + HIR "“飕、飕飕……”尽数打在$N的胸口。\n" NOR, me);
    me->add("qi", -100),
      me->add("eff_qi", -100);
    add("get_available", -1);
  } else if (query("get_available") > 1) {
    obj = new(__DIR__ "obj/jhylwan");
    obj->move(me);
    add("get_available", -1);
    message_vision(YEL "$N从瓶子里拿出一个" + HIG "九花玉露丸。\n" NOR, me);
  } else {
    message_vision(HIR "突然飞出几支" + HIY "金针" + HIR "“飕、飕飕……”尽数打在$N的胸口。\n" NOR, me);
    me->add("qi", -100),
      me->add("eff_qi", -100);
    add("get_available", -1);
    return 1;
  }
  return 1;
}
