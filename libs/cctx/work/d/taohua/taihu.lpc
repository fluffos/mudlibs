
#include <ansi.h>
inherit ROOM;
 
void create()
{
        set("short",HIG "太湖"NOR);
        set("long",@LONG
太湖襟带三州，东南之水皆归于此，周行五百里，古称
五湖。你站在湖边，只见长天远波，放眼皆碧，七十二峰苍
翠，挺立于三万六千顷波涛之中。
LONG );
        set("exits", ([
	"north" : "/d/city/yangliudao3",
	"west" : __DIR__"hubinlu",
]));
            set("objects", ([
                __DIR__"npc/shusheng" : 1,
        ]));
        set("outdoors", "taohua");
 
        setup();
}
