#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "乘风居");
	set("long",@LONG
这里是黄药师二弟子陆乘风的房间，里面除了一张竹床和一张竹椅外别无
他物，看来主人已经很久没住在这里了。屋檐下挂着一个铁八卦（tiebagua）。
LONG);
	set("exits", ([
	"south" : __DIR__"zoulang2",
]));

	setup();
}
void init()
{
            add_action("do_pick","pick");
}
void reset()
{
        ::reset();
        set("get_available" , 1);
}

int do_pick(string arg)
{
       object me,obj;

       me = this_player();
       if( !arg || arg!="tiebagua" )
              return notify_fail("你要拿什么?\n");
       if ( query("get_available") )  {
       obj = new (__DIR__"obj/tiebagua");
       obj->move(me);
       add("get_available", -1);
       message_vision(YEL"$N从屋檐下拿下一个铁八卦。\n"NOR,me );
       }
       else
       return notify_fail("你干什么？这个铁八卦怎么能拿！\n");
       return 1;
}
