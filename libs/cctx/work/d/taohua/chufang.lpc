// adx 15:02 99-2-12
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "厨房");
	set("long", @LONG
这是桃花岛的厨房，中央摆着大圆桌，周围则放着几张竹椅。窗口
还摆着几盆水仙花。你吸了一下鼻子，啊．．．好香！也不知到底是花
香还是饭香。平时桃花岛的弟子和仆人都在这里用餐。
LONG
	);
        set("no_fight", 1);
	set("exits",([
	"east" : __DIR__"caifang",
	"southeast" :__DIR__"xiaoyuan",
]));
        set("objects", ([
                __DIR__"obj/luzao" : 1,
                __DIR__"npc/puren2" : 1,
        ]));
	setup();
}
void init()
{
	add_action("do_ran","点燃");
	add_action("do_ran","ran");
	add_action("do_soup","作菜");
	add_action("do_soup","soup");
}
int do_ran(string arg)
{
	object me = this_player();
	if ( !arg || (arg != "luzao") )
		return notify_fail("你要点燃什么？\n");	
	
	if (this_player()->query_temp("marks/ran"))
		return notify_fail("炉灶已经点燃了。\n");	
			
	this_player()->set_temp("marks/ran", 1);
	return notify_fail(HIR"你把一捆干柴塞进炉膛。打着了火摺，引燃炉膛内的干柴。\n"NOR);	
        return 1;
}
int do_soup(string arg)
{
	object me = this_player();
	object luzao = present("luzao", environment(me));
	if( me->query_temp("marks/ran") )
	{
		luzao->serve_cai(me) ;
	}
	else {
		return notify_fail("不把炉灶的火升起来，怎么作菜？\n");
		}
}
int valid_leave(object me, string dir)
{
	if ( dir == "east"||dir == "southeast")
	me->delete_temp("marks/ran");
	return ::valid_leave(me, dir);
}
