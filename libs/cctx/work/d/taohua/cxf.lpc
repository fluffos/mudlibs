// /d/taohua/cxf.c
// adx 2:23 99-2-6
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "玄风居");
	set("long",@LONG
这里是黄药师大弟子陈玄风的房间，里面除了一张竹床和一张竹椅外
还放着一个白森森的骷髅头（tou）上面有五个洞，窗外可以看到满树
的桃花。
LONG);
	set("exits", ([
	"south" : __DIR__"zoulang1",
]));
	set("item_desc", ([
		"tou" :HIY "这是陈玄风用来练九阴白骨爪的，下面好象压着一本书."NOR,
	]) );
	setup();
}
void init()
{
            add_action("do_pick","pick");
}
void reset()
{
        ::reset();
        set("get_available" , 1);
}

int do_pick(string arg)
{
       object me,obj;

       me = this_player();
       if( !arg || arg!="book" )
              return notify_fail("你要拿什么?\n");
       if ( query("get_available") )  {
       obj = new (__DIR__"obj/tanzhi");
       obj->move(me);
       add("get_available", -1);
       message_vision(YEL"$N骷髅头下拿出一本书。\n"NOR,me );
       }
       else
       return notify_fail("下面什么也没有，原来是你看花了眼。\n");
       return 1;
}
