// /d/taohua/tanzhifeng.c
// adx 2:23 99-2-6
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",HIG"大石"NOR);
        set("long",
HIG"你爬上一块大石，往下一看“哇！好高啊！”你不禁打了一个冷战。放眼
四周万顷碧波，真是练功（kung）的好地方。地上好向刻着几个小字（zhi）。\n"NOR
);
        set("item_desc", ([
            "zhi" : YEL "如果不知道怎么下去又不能（quit）哪只能往下跳（jump），你死定了。东邪黄某。\n" NOR ,
        ]));
        set("outdoors", "taohua");
        setup();
}

void init()
{       add_action("do_xia", "xia");
        add_action("do_kung", "kung");
        add_action("do_jump", "jump");
}

int do_kung(string arg)
{
        object me, killer;
        int i, jing_cost, qi_cost;

        me = this_player();
        i = (int)me->query_skill("force", 0) + random(500);
        jing_cost = 2500 / ((int)me->query("int"));
        qi_cost = 3000 / ((int)me->query("int"));

        if((int)me->query_skill("bibo-shengong", 1) < 300)
        {
        message_vision(YEL"$N坐了下来，将碧波神功运行一周天。\n\n"NOR, me);
        if( i < 100 )
                me->unconcious();
        else {
                message_vision(YEL"$N舒了口气站了起来。\n"NOR, me);
                if( i > 200 )
                me->improve_skill("bibo-shengong", (int)me->query_skill("bibo-shengong", 1)/5);
                me->receive_damage("jing", jing_cost );
                me->receive_damage("qi", qi_cost );
             }
        }
        else {
                message_vision(HIR"$N的碧波神功够高的了。\n"NOR, me);
             }  
                i = 0;
        return 1;
}
int do_xia(object me)
{
    me = this_player () ;

    message_vision(HIW "$N你轻手轻脚地下了大石，生怕掉下去。\n"NOR, me );
    me->move("/d/taohua/tanzhi") ;
    return 1 ;
}
int do_jump(object me)
{
        me = this_player () ;
        message_vision(HIR "$N纵身往下一跳。\n"NOR, me );
        me->move("/d/taohua/taohuaxuan") ;
        me->die();
    return 1 ;
}

