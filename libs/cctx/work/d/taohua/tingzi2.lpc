// /d/taohua/road5.c
// adx 2:23 99-2-6
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "试剑亭二楼");
  set("long", @LONG
这里是试剑亭的二楼，从这里可以观察桃花迷阵的状况。
你可以跳入（jump）阵中。
LONG);
  set("exits", ([
    "down": __DIR__ "tingzi",
  ]));
  set("objects", ([
    __DIR__ "npc/puren3": 1,
  ]));
  set("outdoors", "taohua");
  setup();
}
void init() {
  add_action("do_jump", "jump");
}
int do_jump(object me) {
  me = this_player();
  message_vision(HIG "$N纵身往下一跳。\n" + "$N落在桃花迷阵中。\n" NOR, me);
  me->move("/d/taohua/tao0");
  return 1;
}
