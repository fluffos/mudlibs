// /d/taohua/road5.c
// adx 17:50 99-2-6
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "竹楼二楼");
  set("long", @LONG
这里是竹楼的二楼，墙上挂着一把桃木剑（jian）此外别无他物。看来这里是
桃花岛主黄药师练剑的地方。
LONG);
  set("exits", ([
    "down": __DIR__ "zhulou",
  ]));
  set("outdoors", "taohua");
  set("item_desc", ([
    "jian": HIY "这是一把黄药师练剑时用的桃木剑，你可以挥（hui）一下这把剑。" NOR,
  ]));

  set("objects", ([
    __DIR__ "npc/yapu1": 1,
  ]));
  setup();
}

void init() {
  add_action("do_hui", "hui");
}

int do_hui(string arg) {
  object me, killer;
  int i, jing_cost, qi_cost;

  me = this_player();
  i = (int)me->query_skill("sword", 0) + random(500);
  jing_cost = 2500 / ((int)me->query("int") + ((int)me->query("combat_exp") / 150000));
  qi_cost = 3000 / ((int)me->query("int") + ((int)me->query("combat_exp") / 150000));
  if (!arg || (arg != "jian")) {
    return notify_fail("你要拿什么？\n");
  }
  if (!me->query_skill(
    "sword",
    1
  ) || (int)me->query_skill("sword", 1) < 20 || (int)me->query_skill("literate", 1) < 20)
    message_vision(HIM "结果＂啪＂地一声桃木剑砸在你的头上。\n\n" NOR, me);

  else if ((int)me->query_skill("sword", 1) > 150)

    message_vision(HIM "$N拿起桃木剑舞了起来。\n\n" NOR, me);
  else {
    message_vision(HIM "$N耍了个剑花收招立定。\n" NOR, me);
    me->receive_damage("qi", qi_cost);
    me->receive_damage("qi", qi_cost);
    me->improve_skill("sword", 2 * (int)me->query_skill("sword", 1));
  }
  i = 0;
  return 1;
}
