// /d/taohua/zhulou.c
// adx 2:23 99-2-6
#include <ansi.h>
#include <room.h>
inherit ROOM;

int do_pick(string arg) ;
void create()
{
	set("short", "炼丹房");
	set("long",@LONG
你走进一间用石头砌成的房间，这里是黄药师炼丹的地方。中间放着
一个很大的丹炉，旁边放着一个架子（shelf）。周围的光线并不太好。
LONG);
	set("exits", ([
		"west" : __DIR__"zhulou",
]));
        create_door("west", "铁门", "east", DOOR_CLOSED);
	set("item_desc", ([
		"shelf" : "这是放药材的架子，上面放着几个瓶子（bottle）。",
		"bottle" : "瓶子里好象有些东西，你可以拿看看（pick）。",
	]) );
	setup();
}
void init()
{
            add_action("do_pick","pick");
}
void reset()
{
        ::reset();
        set("get_available" , 1);
}

int do_pick(string arg)
{
       object me,obj;

       me = this_player();
       if( !arg || arg!="bottle" )
              return notify_fail("你要拿什么?\n");
       if ( query("get_available") )  {
       obj = new (__DIR__"obj/wucdan");
       obj->move(me);
       add("get_available", -1);
       message_vision(YEL"$N从瓶子里拿出一颗"+HIW"无常丹。\n"NOR,me );
       }
       else
       return notify_fail("你要摇了摇瓶子，瓶子是空的。\n");
       return 1;
}

