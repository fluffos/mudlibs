// /d/taohua/taohuaxuan.c
// adx 2:18 99-2-6
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "桃花轩二楼");
	set("long", @LONG
这里是桃花轩的二楼，四周都是窗户，可以看到南边高高的弹指峰，屋里
摆放着一些竹桌、竹椅。桌上放着一个匣子（xia）。

LONG
	);
	set("exits", ([
		"up" :__DIR__"taohuaxuan3",
		"down" :__DIR__"taohuaxuan",
		"west" :__DIR__"taohuaxuan0",
]));
	set("item_desc",([
		"xia" : "匣子里好象有一卷画，你不妨拿（pick）起来看看。",
	]));
        create_door("west", "竹门", "east", DOOR_CLOSED);
	setup();
}
void init()
{
            add_action("do_pick","pick");
}
void reset()
{
        ::reset();
        set("get_available" , 1);
}

int do_pick(string arg)
{
       object me,obj;

       me = this_player();
       if( !arg || arg!="xia" )
              return notify_fail("你要拿什么?\n");
       if ( query("get_available") )  {
       obj = new (__DIR__"obj/taohuamap");
       obj->move(me);
       add("get_available", -1);
       message_vision(YEL"$N从匣子你拿出一卷桃花岛地图。\n"NOR,me );
       }
       else
       return notify_fail("匣子里什么也没有，不知道被谁拿走了。\n");
       return 1;
}

