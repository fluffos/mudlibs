// /d/taohua/taohuaxuan.c
// adx 2:23 99-2-6
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "桃花轩");
  set("long", @LONG
这里是“桃花轩”，每逢荷花盛开的夏季，桃花岛主黄药师都在这里观赏
荷花池中的荷花，或者下棋纳凉。屋里放着一张竹桌，桌上摆着一付围棋。
桌上好象还放着一本书（book）。
LONG);
  set("exits", ([
    "east": __DIR__ "taohuaxuan2",
  ]));
  create_door("east", "竹门", "west", DOOR_CLOSED);
  setup();
}
void init() {
  add_action("do_pick", "pick");
}
void reset() {
  ::reset();
  set("get_available", 1);
}

int do_pick(string arg) {
  object me, obj;

  me = this_player();
  if (!arg || arg != "book")
    return notify_fail("你要拿什么?\n");
  if (query("get_available")) {
    obj = new(__DIR__ "obj/jibenpian");
    obj->move(me);
    add("get_available", -1);
    message_vision(YEL "$N从桌子上拿起一本《暗影浮香》基本篇。\n" NOR, me);
  } else
    return notify_fail("你摸了摸桌子，原来看花了眼。\n");
  return 1;
}
