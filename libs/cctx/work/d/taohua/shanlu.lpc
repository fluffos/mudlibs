// /d/taohua/shanlu.c
// adx 2:23 99-2-6
inherit ROOM;
string *npcs = ({
  "/d/taohua/npc/yetu",
  "/d/taohua/npc/zhang",
});

void create() {
  set("short", "山路");
  set("long", @LONG
你走在一条狭窄的山路上，两边是一片青草地，往上走是弹指峰，下面就是
桃花山庄，可以看到桃花山庄房间布局错落有致，是按奇门五行建造的。
LONG);
  set("exits", ([
    "northdown": __DIR__ "taohuaxuan",
    "southup": __DIR__ "tanzhi",
  ]));
  set("objects", ([
    npcs[random(sizeof(npcs))]: random(2),
    npcs[random(sizeof(npcs))]: random(2),
  ]));
  setup();
  replace_program(ROOM);
}
