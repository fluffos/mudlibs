inherit ROOM;

void create()
{
	set("short", "小院");
	set("long", @LONG
你一走进来，就感到一阵凉意沁入心脾，精神为之一爽。院中
种植着几株小树，
还有一口水井（jing），桃花岛上的人都是饮用这口井的水。
LONG
	);
	set("resource/water", 1);

	set("exits", ([
		"east" : __DIR__"qianyuan",
		"west" : __DIR__"xiuxishi",
		"northeast" : __DIR__"jcting",
		"northwest" : __DIR__"chufang",
		"southwest" : __DIR__"zoulang6",
	]));

	set("objects", ([
		__DIR__"npc/yapu1" : 1,
        ]));
	setup();
	replace_program(ROOM);
}

