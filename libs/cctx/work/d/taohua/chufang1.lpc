inherit ROOM;

void create() {
  set("short", "厨房");
  set("long", @LONG
这是归云庄的厨房，中央摆着大圆桌，周围则放着几张竹椅。窗口
还摆着几盆水仙花。你吸了一下鼻子，啊．．．好香！也不知到底是花
香还是饭香。平时除了陆庄主其他人都在这里用餐。
LONG
  );
  set("no_fight", 1);
  set("exits", ([
    "west": __DIR__ "houting",
  ]));
  set("objects", ([
    __DIR__ "npc/puren2": 1,
  ]));

  setup();
}
