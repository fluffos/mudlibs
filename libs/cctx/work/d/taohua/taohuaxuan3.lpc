#include <room.h>
inherit ROOM;

void create() {
  set("short", "桃花轩三楼");
  set("long", @LONG
这里是桃花轩的三楼，从这里可以看到整个桃花山庄，南边是桃花岛唯一
一座山峰弹指峰，北边可以俯瞰整个荷花池。你站在这里不觉感到心旷神怡。
LONG
  );
  set("exits", ([
    "down": __DIR__ "taohuaxuan2",
  ]));
  setup();
  replace_program(ROOM);
}
