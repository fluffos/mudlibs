// netkill /98/8/14/

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIW "虎跳石" NOR );
        set("long", @LONG
这是江中的一块大石，四面都是水，石面可以容纳两三人，江水
打在石头上溅起的水花不时打在你身上。
LONG
        );
        set("outdoors", "dali");
            
        setup();

}


void init()
{
	add_action("do_jump", "jump");
}


int do_jump(string arg)

  {
       
        object me, killer;
	int i, idodge, i_qi;

              me=this_player();
              i_qi = 500 / (int)me->query("int");
              idodge = (int)me->query_skill("dodge", 0);
                                               
              if ( !arg || (arg != "north" && arg != "south") )
                     return notify_fail("你要跳河自杀呀！别傻了！\n");
              
              if ( idodge < 30 )  return notify_fail("你的轻功太差了，赶快去练练吧！\n");

              if ( (int)me->query("qi") < i_qi) 
                 
                      {
                message("vinson","你刚想跳过去，结果底气不足，左脚畔在右脚上。\n"+
                                 "摔了个四脚朝天。\n", me);
                  me->unconcious(); }    

                
                       else    {
                        switch (arg){
                           
                           case "north" :   message("vision",
			                    me->name() + "一纵身，向岸上跳了过去。\n",
			                    environment(me), ({me}) ); 
                                            me->move(__DIR__"hutiao9");
                                            message("vision",
			                    "只见人影一闪"+me->name() + "从江中跳了上来。\n",
			                    environment(me), ({me}) );
                                            message("vinson","你纵身一跳，嗖的一声，稳稳的落在了虎跳峡北岸。\n", me);
                                            break;                            
                           case "south" :   message("vision",
			                    me->name() + "一纵身，向岸上跳了过去。\n",
			                    environment(me), ({me}) ); 
                                            me->move(__DIR__"hutiao8");
                                            message("vision",
			                    "只见人影一闪"+me->name() + "从江中跳了上来。\n",
			                    environment(me), ({me}) );
                                            message("vision","你纵身一跳，嗖的一声，稳稳的落在了虎跳峡南岸。\n", me);
                                            break;
                                    }
                                     me->improve_skill("dodge", 2*(int)me->query_skill("dodge", 1));
                                     me->receive_damage("qi", i_qi );
                        
                              }
                
	return 1;
             
  }                   