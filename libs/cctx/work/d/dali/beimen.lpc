#include <room.h>

inherit ROOM;

string look_gaoshi();

void create()
{
	set("short", "大理北门");
	set("long", @LONG
这里是大理北门，往南可以看到一些巍然耸立的建筑，往北可以通到
大理三塔和有名的蝴蝶泉。门侧城墙上贴着一张告示(gaoshi) ，也不知
道写了些什么。
LONG
	);

	set("item_desc", ([
		"gaoshi" : (:look_gaoshi:),
	]));

	set("exits", ([
		"south" : __DIR__"beijie3",
		"north" : __DIR__"nroad1",
	]));
	set("outdoors","dali");
	setup();
}

string look_gaoshi()
{
	return FINGER_D->get_killer() + "\n大理国\n";
}

