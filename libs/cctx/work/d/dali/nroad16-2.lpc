inherit ROOM;

void create()
{
	set("short", "山路");
	set("long", @LONG
这是上云弄峰的山路，抬头是高耸的青山，低头是碧波荡漾的洱海，
路旁绿草从生，有很多鲜花已经开放了。空气中弥漫着潮湿的气息，看
来要起风下雨了。
LONG
	);
	set("exits",([
		"west" : __DIR__"nroad16-3",
		"northeast" : __DIR__"nroad16-1",
	]));
