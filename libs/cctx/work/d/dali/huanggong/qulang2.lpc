inherit ROOM;

void create() {
  set("short", "曲廊");
  set("long", @LONG
这是小河上的一条长长的曲廊，曲廊绕过两边宫殿，走在桥上，
但觉凉风拂面，远处阵阵流水声，随风又送来阵阵花香，深宫庭院，
竟然忽有了山林野处意境。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([
    "west": __DIR__ "qulang1",
    "east": __DIR__ "huayuan",
  ]));
  set("objects", ([
    "/kungfu/class/dali/duanyu": 1,
  ]));

  setup();
}
