// taijian1.c  - 太监

inherit NPC;

void create() {
  set_name("太监", ({ "taijian", "taijian" }));
  set("title", "皇宫");
  set("gender", "无性");
  set("age", random(15) + 10);
  set("str", 20);
  set("dex", 20);
  set("long", "他是一个入宫已久的小太监。\n");
  set("combat_exp", 3000);
  set("SEN", 1);
  set("attitude", "friendly");

  set_skill("unarmed", 80);
  set_skill("force", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);

  set("neili", 300);
  set("max_neili", 300);
  set("jiali", 5);

  setup();
  carry_object(__DIR__ "obj/taijian-cloth")->wear();
}
