// dao.c - 刀白凤

inherit NPC;

int ask_dan(); ;
void create() {
  set_name("刀白凤", ({ "dao baifeng", "dao" }));
  set("title", "大理镇南王妃");
  set("nickname", "玉虚散人");
  set("rank_info/respect", "仙姑");
  set("gender", "女性");
  set("age", 37);
  set("str", 20);
  set("dex", 28);
  set("int", 28);
  set("con", 28);
  set("long", "她是一个美丽端庄的摆夷族女子，因情场失意，来到这座道观出家。\n");
  set("combat_exp", 200000);
  set("inquiry", ([
    "金创药": (: ask_dan :),
  ]));
  set("SEN", 100);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 15);
  set("attitude", "friendly");

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("whip", 150);
  set_skill("force", 100);

  set_skill("tianlong-shengong", 100);
  set_skill("qingdie-shenfa", 100);


  map_skill("dodge", "lingbo-steps");
  map_skill("force", "tiannong-shengong");


  create_family("大理国天龙寺", 13, "弟子");
  setup();
  //         carry_object(__DIR__"obj/fuchen")->wield();
  //         carry_object(__DIR__"obj/greenrobe")->wear();
}
int ask_dan() {
  object me, dao, dan;
  mapping fam;
  dao = this_object();
  me = this_player();
  if (!mapp(fam = me->query("family")) || fam["family_name"] != "大理国天龙寺") {
    command("say 对不起，不可以给你。");
    return 1;
  } else {
    if (dao->query_temp("sign")) {
      command("say 你来晚啦，早被人拿走啦。");
      return 1;
    } else {
      dan = dan = new(__DIR__ "obj/dan");
      dan->move(me);
      dao->set_temp("sign", 1);
      return 1;
    }
  }
}
