#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name(YEL"滚龙黄袍"NOR, ({ "huang pao", "pao", "cloth" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一件绣着两条五爪金龙的金边大黄袍。\n");
		set("unit", "件");
		set("value", 3000);
		set("material", "cloth");
		set("armor_prop/armor", 10);
	}
	setup();
}