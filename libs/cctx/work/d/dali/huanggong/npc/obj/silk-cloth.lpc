// taijian-cloth.c - 婵丝宫衣
//

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("婵丝宫衣", ({ "silk cloth", "cloth" }) );
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		  set("long", "一件薄丝织成的纱衣，是皇宫中的宫女常着的衣衫。\n");
                set("unit", "件");
                set("material", "silk");
                set("value", 400);
                set("armor_prop/armor", 3);
		  set("armor_prop/personality", 2);
		  set("female_only", 1);
        }
        setup();
}
