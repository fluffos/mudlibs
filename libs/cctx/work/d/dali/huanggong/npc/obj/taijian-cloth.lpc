// taijian-cloth.c - 宦官服
//

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("宦官服", ({ "huanguan fu", "fu", "cloth" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("value", 200);
                set("armor_prop/armor", 3);
		  set("armor_prop/courage", -1);
		  set("no_sex_only", 1);
        }
        setup();
}
