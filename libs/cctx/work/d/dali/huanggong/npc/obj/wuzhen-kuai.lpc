// wuzhen-kuai.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("鸳鸯五珍脍", ({ "wuzhen kuai", "kuai" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一份皇宫名菜。\n");
    set("unit", "份");
    set("food_remaining", 3);
    set("food_supply", 40);
  }
}
