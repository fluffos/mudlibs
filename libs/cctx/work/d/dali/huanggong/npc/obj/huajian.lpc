#include <weapon.h>

inherit SWORD;

void create() {
  set_name("花剪", ({ "scissors" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把园丁用来修理花枝用的普通铁剪。\n");
    set("value", 200);
    set("material", "iron");
  }
  init_sword(8);
  setup();
}
