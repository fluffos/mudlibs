// jinyi.c

#include <armor.h>
inherit CLOTH;

void create()
{
        set_name("五彩锦衣", ({ "jinyi", "cloth" }));
        set("long", "这是一件皇宫特有的五彩锦衣，既轻便又有防身的功效。\n");
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("unit", "件");
                set("value", 1000);
                set("armor_prop/armor", 15);
		  set("armor_prop/defense", 5);
        }
        setup();
}
