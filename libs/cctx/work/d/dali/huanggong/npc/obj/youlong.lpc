// youlong.c

#include <weapon.h>

inherit SWORD;

void create()
{
	set_name( "游龙剑", ({ "youlong jian", "jian", "youlong" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把四尺左右的利剑，虽在鞘内，仍是寒气四射。\n");
		set("value", 100000);
		set("material", "crimsonsteel");
		set("wield_msg", "只听「噌」地一声龙吟，$N抽出一把$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插入背後的剑鞘。\n");
	}
	init_sword(60);
	setup();
}