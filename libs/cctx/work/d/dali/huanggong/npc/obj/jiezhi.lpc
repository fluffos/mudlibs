// jiezhi.c

#include <armor.h>

inherit FINGER;

void create() {
  set_name("金戒指", ({ "jiezhi" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long",
      "一只精致的金戒指，看来值不少钱。\n");
    set("value", 10000);

    set("armor_prop/armor", 5);
    set("armor_prop/defense", 5);
    set("armor_prop/personality", 3);
    set("material", "gold");
  }

  setup();
}
