// tiegun.c

#include <weapon.h>
inherit STAFF;

void create()
{
        set_name("铁棍", ({ "tie gun", "gun" }));
        set_weight(7000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "这是一根长长的铁棍，拿在手里沉甸甸的。\n");
                set("value", 1200);
                set("material", "iron");
                set("wield_msg", "$N「唰」的一声抽出一根$n握在手中。\n");
        }
        init_staff(25, TWO_HANDED);
        setup();
}

