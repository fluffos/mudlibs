// tengjia.c 滕甲
//

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("滕甲", ({ "teng jia", "jia" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "wood");
                set("value", 1000);
                set("armor_prop/armor", 15);
        }
        setup();
}

