inherit NPC;

void create()
{
        set_name("高升泰", ({ "gao shengtai", "gao" }));
	 set("title", "大理国善阐侯");
        set("age", 42);
        set("gender", "男性");
        set("long", "他长相平平，带有几分病态，看来并无过人之处。\n");
        set("attitude", "friendly");
        set("str", 25);
        set("dex", 30);
	 set("int", 30);

	 set("max_force", 800);
	 set("force", 800);
	 set("force_factor", 30);
        set("combat_exp", 600000);
        set("SEN", 100);

        set_skill("unarmed", 80);
        set_skill("dodge", 80);
        set_skill("parry", 80);
        set_skill("force", 80);
	 set_skill("yiyang-zhi", 80);
         set_skill("tiannong-shengong", 80);
	 set_skill("lingboweibu", 80);

	 map_skill("dodge", "lingboweibu");
	 map_skill("unarmed", "yiyang-zhi");
	 map_skill("parry", "yiyang-zhi");
         map_skill("force", "tiannong-shengong");

        setup();
        carry_object(__DIR__"obj/baipao")->wear();
}
