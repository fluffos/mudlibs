// taijian2.c  - 小太监

inherit NPC;

void create() {
  set_name("小太监", ({ "xiao taijian", "taijian" }));
  set("title", "皇宫");
  set("gender", "无性");
  set("age", random(10) + 10);
  set("str", 20);
  set("dex", 20);
  set("long", "他是一个入宫不久的小太监，还未通世事。\n");
  set("combat_exp", 300);
  set("SEN", 1);
  set("attitude", "friendly");

  set_skill("unarmed", 40);
  set_skill("force", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);

  set("neili", 50);
  set("max_neili", 50);
  set("jiali", 1);

  setup();
  carry_object(__DIR__ "obj/taijian-cloth")->wear();
}
