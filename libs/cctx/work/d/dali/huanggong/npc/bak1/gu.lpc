inherit NPC;

void create()
{
        set_name("古笃诚", ({ "gu ducheng", "gu" }));
	 set("title", "四大卫护之一");
        set("age", 31);
        set("gender", "男性");
        set("long", "他身穿着一身黄色官服，黄巾褚幞头，武官打扮。\n");
        set("attitude", "friendly");
        set("str", 29);
        set("dex", 20);
	 set("int", 24);

	 set("max_force", 400);
	 set("force", 400);
	 set("force_factor", 5);
        set("combat_exp", 300000);
        set("SEN", 100);

        set_skill("unarmed", 120);
        set_skill("dodge", 60);
        set_skill("parry", 70);
        set_skill("force", 70);
         set_skill("staff", 140);
         set_skill("tiannong-shengong", 70);
	 set_skill("lingboweibu", 70);

	 map_skill("dodge", "lingboweibu");
         map_skill("force", "tiannong-shengong");

        setup();
        carry_object(__DIR__"obj/junfu")->wear();
	 carry_object(__DIR__"obj/tiegun")->wield();
}
