// qingbing.c - 亲兵

inherit NPC;

void create()
{
        set_name("禁军", ({ "qing bing", "bing" }));
        set("gender", "男性");
        set("age", random(20) + 20);
        set("str", 25);
        set("dex", 20);
        set("long", "他是皇宫的一名近卫禁军，腰佩宝剑，八面威风。\n");
        set("combat_exp", 25000);
        set("SEN", 1);
        set("attitude", "friendly");

        set_skill("unarmed", 100);
        set_skill("force", 80);
        set_skill("sword", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);

        set_temp("apply/armor", 20);
        set_temp("apply/damage", 10);

        set("force", 500); 
        set("max_force", 500);
        set("force_factor", 20);

        setup();
        carry_object(__DIR__"obj/gangjian")->wield();
}