inherit NPC;

void create() {
  set_name("花匠", ({ "hua jiang", "jiang" }));
  set("age", 25);
  set("gender", "男性");
  set("long", "他是在大理王宫修剪茶花的花匠。\n");
  set("attitude", "pieceful");

  set("combat_exp", 100);
  set("SEN", 1);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("sword", 60);
  set_skill("parry", 60);

  setup();
  carry_object(__DIR__ "obj/huajian")->wield();
  add_money("coin", 90);
}
