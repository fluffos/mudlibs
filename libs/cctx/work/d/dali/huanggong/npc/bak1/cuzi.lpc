inherit NPC;

void create() {
  set_name("厨子", ({ "cuzi" }));
  set("title", "御厨监");
  set("age", 32);
  set("gender", "男性");
  set("long", "他是个替皇宫里做饭的厨师。\n");
  set("attitude", "friendly");
  set("str", 25);
  set("dex", 20);
  set("combat_exp", 400);
  set("SEN", 1);

  set_skill("unarmed", 60);
  set_skill("dodge", 50);
  set_skill("parry", 50);

  setup();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_serve", "serve");
}

void greeting(object ob) {
  if (!environment() || !ob
    || base_name(environment()) != query("startroom")
    || environment(ob) != environment())
    return;

  if (ob->query("family/family_name") != "大理段氏") {
    command("say 你是什么人？怎么闯进皇宫御厨房来了？快快滚开！");
    tell_object(ob, name() + "一脚把你踢了出来。\n");
    ob->move("/u/moon/huanggong/zoulang3");

    return;
  }
  if (random(2)) return;

  say("厨子笑道：这位" + RANK_D->query_respect(ob) + "请随便看，不要偷吃就是了。\n");
}

int do_serve(string arg) {
  object who = this_player();

  if (!living(this_object()) || !environment()
    || base_name(environment()) != query("startroom"))
    return 0;

  if (who->query("family/family_name") != "大理段氏")
    return notify_fail(name() + "说道：皇宫御膳哪能随便给你吃呢！\n");

  if (present("wuzhen kuai", who) && present("kettle", who))
    return notify_fail(name() + "说道：不要浪费，吃完了再要！\n");

  if (query("food_count") > 20)
    return notify_fail(name() + "说道：真是抱歉，今天的饭菜都吃完了！\n");

  add("food_count", 1);

  message_vision("$N端了一份饭菜递到$n的手里，说道：拿去吧，可别浪费啊！\n",
    this_object(), who);

  if (!present("wuzhen kuai", who))
    new(__DIR__ "obj/wuzhen-kuai")->move(who);
  if (!present("kettle", who))
    new(__DIR__ "obj/kettle")->move(who);

  return 1;
}
