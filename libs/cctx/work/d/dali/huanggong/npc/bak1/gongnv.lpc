// gongnv.c - 宫女

inherit NPC;

void create()
{
        set_name("宫女", ({ "lady" }));
	 set("title", "皇宫");
        set("gender", "女性");
        set("age", 17);
        set("str", 20);
        set("dex", 20);
        set("long", "她是一个入宫不久的小宫女，稚气未脱，容色秀丽。\n");
        set("combat_exp", 1000);
        set("SEN", 1);
        set("attitude", "friendly");

        set_skill("unarmed", 50);
        set_skill("force", 50);
        set_skill("dodge", 60);
        set_skill("parry", 70);

        setup();
        carry_object(__DIR__"obj/silk-cloth")->wear();
}