inherit NPC;

void create()
{
        set_name("镇殿武士", ({ "wushi" }));
	 set("title", "皇宫");
        set("age", 20 + random(10) );
        set("gender", "男性");
        set("long", "这是一个皇宫里的武士，身材魁伟，双臂有力。\n");
	 set("str", 30);
	 set("dex", 25);
        set("attitude", "peaceful");

        set("combat_exp", 6000);
        set("SEN", 10);
	 set("force", 500);
	 set("max_force", 500);
	 set("force_factor", 5);

        set_skill("unarmed", 100);
        set_skill("dodge", 80);
        set_skill("parry", 80);
        set_skill("force", 80);
	 set_skill("sword", 90);

        setup();

	 carry_object(__DIR__"obj/gangjian")->wield();
}