// jinyiwei.c 锦衣卫

inherit NPC;

void create()
{
        set_name("锦衣卫士", ({ "jinyi weishi", "weishi" }));
	 set("title", "皇宫");
        set("gender", "男性");
        set("age", random(20) + 20);
        set("str", 25);
        set("dex", 16);
        set("long", "他一身五彩锦衣，腰佩宝刀，真有说不出的威风。\n");
        set("combat_exp", 50000);
        set("SEN", 10);
        set("attitude", "friendly");

        set_skill("unarmed", 100);
        set_skill("force", 80);
        set_skill("blade", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/armor", 50);
        set_temp("apply/damage", 30);

        set("force", 800); 
        set("max_force", 800);
        set("force_factor", 20);

        setup();
        carry_object(__DIR__"obj/gangdao")->wield();
        carry_object(__DIR__"obj/jinyi")->wear();
}