inherit NPC;

void create() {
  set_name("傅思归", ({ "fu sigui", "fu" }));
  set("title", "四大卫护之一");
  set("age", 37);
  set("gender", "男性");
  set("long", "他身穿着一身黄色官服，黄巾褚幞头，武官打扮。\n");
  set("attitude", "friendly");
  set("str", 30);
  set("dex", 22);
  set("int", 22);

  set("max_force", 500);
  set("force", 500);
  set("force_factor", 10);
  set("combat_exp", 350000);
  set("SEN", 100);

  set_skill("unarmed", 120);
  set_skill("dodge", 60);
  set_skill("parry", 70);
  set_skill("force", 70);
  set_skill("axe", 160);
  set_skill("tiannong-shengong", 70);
  set_skill("lingboweibu", 70);

  map_skill("dodge", "lingboweibu");
  map_skill("force", "tiannong-shengong");

  setup();
  carry_object(__DIR__ "obj/junfu")->wear();
  carry_object(__DIR__ "obj/axe")->wield();
}
