inherit NPC;
inherit F_MASTER;

void create() {
  set_name("段誉", ({ "duan yu", "duan", "yu" }));
  set("title", "镇南王世子");
  set("gender", "男性");
  set("age", 22);
  set("long",
    "他长得眉清目秀，一脸书生气。\n");
  set("attitude", "friendly");

  set("str", 30);
  set("int", 30);
  set("per", 30);
  set("dex", 30);
  set("cor", 20);
  set("spi", 30);

  set("force", 5000);
  set("max_force", 4500);
  set("force_factor", 130);

  set("combat_exp", 1000000);
  set("score", 1000000);
  set("SEN", 1000);

  set("inquiry", ([
    "叛师": (: ask_about_betray :),
  ]));
  set_skill("force", 150);
  set_skill("unarmed", 100);
  set_skill("dodge", 150);
  set_skill("parry", 120);
  set_skill("sword", 100);
  set_skill("literate", 200);

  set_skill("tiannong-shengong", 200);
  set_skill("liumai-shenjian", 200);
  set_skill("lingboweibu", 200);

  map_skill("force", "tiannong-shengong");
  map_skill("unarmed", "liumai-shenjian");
  map_skill("dodge", "lingboweibu");
  map_skill("parry", "liumai-shenjian");
  map_skill("sword", "liumai-shenjian");

  set_temp("apply/defense", 100);
  set_temp("apply/armor", 40);

  create_family("大理国天龙寺", 13, "弟子");

  setup();

  carry_object("/obj/cloth/cyn_cloth")->wear();
}

int accept_fight(object ob) {
  command("say 让我跟你比武？我一来不会，二来怕输，三来怕痛，四来怕死，因此是不比的。");
  return 0;
}

void attempt_apprentice(object ob) {
  if (ob->query("family/family_name") != "大理国天龙寺") {
    command("say 我只会易经，可不会武功，你不是想跟我学周易吧？");
    return;
  }
  if (ob->query_skill("liumai-shenjian", 1) < 80) {
    command("say 你的六脉神剑还不到家，跟着我也学不到什么东西。");
    return;
  }
  command("say 好吧，你不怕吃苦的话就跟着我吧。");
  command("recruit " + ob->query("id"));
}
