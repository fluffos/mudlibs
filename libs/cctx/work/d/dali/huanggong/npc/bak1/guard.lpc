inherit NPC;

void create() {
  set_name("侍卫头", ({ "guard leader", "leader" }));
  set("age", 32);
  set("gender", "男性");
  set("long", "他是个皇宫里的侍卫头目。\n");
  set("attitude", "friendly");
  set("str", 25);
  set("dex", 25);
  set("combat_exp", 40000);
  set("SEN", 1);

  set_skill("unarmed", 80);
  set_skill("dodge", 70);
  set_skill("parry", 70);
  set_skill("blade", 80);
  set_skill("force", 70);

  setup();
  carry_object(__DIR__ "obj/gangdao")->wield();
  carry_object(__DIR__ "obj/tengjia")->wear();
}

int accept_fight(object me) {
  command("say 你吃了豹子胆了啊？敢在皇宫里打架。\n");
  return 0;
}
