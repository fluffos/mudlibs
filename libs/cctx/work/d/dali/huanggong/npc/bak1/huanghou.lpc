// huanghou.c - 皇后

inherit NPC;

void create() {
  set_name("皇后", ({ "huang hou", "hou" }));
  set("title", "大理国母");
  set("gender", "女性");
  set("age", 37);
  set("str", 20);
  set("dex", 20);
  set("long", "她就是大理的皇后，仪态端庄，清丽绝俗。\n");
  set("combat_exp", 3000);
  set("SEN", 10);
  set("attitude", "friendly");

  set_skill("unarmed", 70);
  set_skill("force", 70);
  set_skill("dodge", 70);
  set_skill("parry", 70);
  set_skill("sword", 70);

  setup();
  {
    object carried_ob = carry_object(__DIR__ "obj/jincai");
    if (carried_ob) carried_ob->wield();
  }
  {
    object carried_ob = carry_object(__DIR__ "obj/silk-cloth");
    if (carried_ob) carried_ob->wear();
  }
  {
    object carried_ob = carry_object(__DIR__ "obj/shouzhuo");
    if (carried_ob) carried_ob->wear();
  }
  {
    object carried_ob = carry_object(__DIR__ "obj/necklace");
    if (carried_ob) carried_ob->wear();
  }
  {
    object carried_ob = carry_object(__DIR__ "obj/jiezhi");
    if (carried_ob) carried_ob->wear();
  }
}
