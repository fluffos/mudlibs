// huanghou.c - 皇后

inherit NPC;

void create() {
  set_name("皇后", ({ "huang hou", "hou" }));
  set("title", "大理国母");
  set("gender", "女性");
  set("age", 37);
  set("str", 20);
  set("dex", 20);
  set("long", "她就是大理的皇后，仪态端庄，清丽绝俗。\n");
  set("combat_exp", 3000);
  set("SEN", 10);
  set("attitude", "friendly");

  set_skill("unarmed", 70);
  set_skill("force", 70);
  set_skill("dodge", 70);
  set_skill("parry", 70);
  set_skill("sword", 70);

  setup();
  carry_object(__DIR__ "obj/jincai")->wield();
  carry_object(__DIR__ "obj/silk-cloth")->wear();
  carry_object(__DIR__ "obj/shouzhuo")->wear();
  carry_object(__DIR__ "obj/necklace")->wear();
  carry_object(__DIR__ "obj/jiezhi")->wear();
}
