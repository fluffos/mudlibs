// taijian.c  - 太监总管

inherit NPC;

void create()
{
        set_name("太监总管", ({ "taijian zhongguan", "taijian", "zhongguan" }));
	 set("title", "皇宫");
        set("gender", "无性");
        set("age", 45);
        set("str", 27);
        set("dex", 27);
        set("long", "他是一个入宫多年的太监，现在总管宫中的大小太监。\n");
        set("combat_exp", 300000);
        set("SEN", 10);
        set("attitude", "friendly");

        set_skill("unarmed", 200);
        set_skill("force", 120);
        set_skill("dodge", 120);
        set_skill("parry", 120);

        set("neili", 1000); 
        set("max_neili", 1000);
        set("jiali", 25);

        setup();
        carry_object(__DIR__"obj/taijian-cloth")->wear();
	 add_money("gold", 2);
	 add_money("silver", 5);
}