inherit NPC;
inherit F_MASTER;

void create() {
  set_name("段正明", ({ "duan zhenming", "duan", "zhenming" }));
  set("title", "大理国保定帝");
  set("gender", "男性");
  set("age", 45);
  set("long",
    "他就是大理国王，他手里拿着一卷书，看起来一脸仁慈，没有半点皇帝的架子。\n");
  set("attitude", "friendly");

  set("str", 30);
  set("int", 30);
  set("per", 24);
  set("dex", 30);
  set("cor", 25);
  set("spi", 30);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 70);

  set("combat_exp", 1500000);
  set("score", 500000);

  set_skill("force", 140);
  set_skill("unarmed", 140);
  set_skill("dodge", 140);
  set_skill("parry", 140);
  set_skill("sword", 140);
  set_skill("literate", 100);

  set_skill("tianlong-shengong", 140);
  set_skill("yiyang-zhi", 140);
  set_skill("qingdie-shenfa", 140);

  map_skill("force", "tianlong-shengong");
  map_skill("unarmed", "yiyang-zhi");
  map_skill("dodge", "lingboweibu");
  map_skill("parry", "yiyang-zhi");
  map_skill("sword", "shaozhe-jian");

  create_family("大理段氏", 3, "弟子");

  setup();
  carry_object(__DIR__ "obj/youlong")->wear();
  carry_object(__DIR__ "obj/huangpao")->wield();
}

void attempt_apprentice(object ob) {
  say(name() + "微笑道：这位" + RANK_D->query_respect(ob) + "，" +
    RANK_D->query_self(this_object()) + "可没有功夫来教你武功啊。\n");

  return 0;
}
