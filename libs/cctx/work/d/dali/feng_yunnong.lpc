inherit ROOM;

void create()
{
	set("short",  "云弄峰" );
	set("long", @LONG
这里是大理苍山十九峰最北的云弄峰山顶，南边有一条小溪喧闹着
向山下流去，正是苍山十八溪之一的霞移溪。东边山下一片翠绿，隐约
可以看到大理有名的蝴蝶泉，不少人进进出出的，似乎都有些收获。
LONG
);
	set("outdoors", "dali");

	set("exits", ([
		"southdown" : __DIR__"xi_xiayi",
		"northdown" : __DIR__"nroad16-3",
	]));
	setup();
	replace_program(ROOM);
}