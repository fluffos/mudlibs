inherit ROOM;

void create() {
  set("short", "沧浪峰");
  set("long", @LONG
这里是大理苍山十九峰沧浪峰的山顶，南北两边各有一条小溪喧闹
着向山下流去，正是苍山十八溪之一的万花溪和霞移溪。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southdown": __DIR__ "xi_wanhua",
    "northdown": __DIR__ "xi_xiayi",
  ]));
  setup();
  replace_program(ROOM);
}
