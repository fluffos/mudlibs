#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "峭壁");
	set("long", @LONG
这段路是在峭壁上凿了出来的，虽然可以走人，但是依然很危险，
旁边是怪石林立的峭壁，如果一不小心跌了下去，就必死无疑了，所以
从这里走路的话，轻身功夫可得过硬哟。
LONG
);
	set("outdoors","dali");
	set("exits",([
		"westdown" : __DIR__"xroad6",
		"southup" : __DIR__"xroad4",
	]));
	setup();
}

int valid_leave(object me,string dir)
{
	int i;
	i=me->query_skill("dodge",1)*10;
	if(i<10)
		i=50;
	i=random(i);
	if((i!=0&&i<7)||me->query("test_player")==1)
	{
		message_vision("$N脚下一不小心，踩了个空，身子一歪就从峭壁上跌了下去。\n",me);
		me->set_temp("diemsg","不小心从峭壁跌了下去，摔死了");
		me->die();
		return 0;
	}
	return ::valid_leave(me,dir);
}

