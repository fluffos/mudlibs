inherit ROOM;

void create()
{
	set("short", "小路");
	set("long", @LONG
这是一条顺着洱海延伸的小路，南边就是大理最有名的大理蝴蝶泉
的入口了。路旁已经不时可以看到几只蝴蝶了。向南远远地看去，可以
隐约看到大理城的影子。北边是一片茫茫的山区。
LONG
	);
	set("exits",([
		"south" : __DIR__"nroad13",
		"northup" : __DIR__"nroad15",
	]));
	set("no_clean_up",0);
	set("objects",([
		__DIR__"npc/hudie":2,
	]));
	set("outdoors","dali");
	setup();
	replace_program(ROOM);
}
