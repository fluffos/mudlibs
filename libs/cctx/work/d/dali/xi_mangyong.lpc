inherit ROOM;

void create() {
  set("short", "芒涌溪");
  set("long", @LONG
这里是大理苍山十八溪的芒涌溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的白云峰，北边则是莲花峰。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southup": __DIR__ "feng_baiyun",
    "northup": __DIR__ "feng_lianhua",
  ]));
  setup();
}
