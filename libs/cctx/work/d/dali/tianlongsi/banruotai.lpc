inherit ROOM;

void create() {
  set("short", "般若台");
  set("long", @LONG
这是个普通的石台，相传当年佛祖曾降临此台传法。再往南去就是
本寺重地——牟尼堂。江湖中传言天龙寺的镇寺之宝——六脉神剑谱就
藏于此中，但你千万不要打什么主意。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "south": __DIR__ "munitang",
    "north": __DIR__ "doushuai",
  ]));
  setup();
  replace_program(ROOM);
}
