inherit ITEM;

void create()
{
	set_name( "六脉神剑谱", ({ "pu", "jian pu" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是用来学习六脉神剑的图谱。应该好好地研究一下(yanjiu)。\n");
		set("value", 1000);
	}
}

void init()
{
	add_action("do_study","yanjiu");
}

int do_study(string arg)
{
	object me;
	string str;
	int i,cost;
	me=this_player(1);
	str="\n";
	if(!arg||arg=="")
		return notify_fail("你要读什么？\n");
	if(!id(arg))
		return notify_fail("你要读什么？\n");
	if( me->query("combat_exp")<100000)
		return notify_fail("你的战斗经验不够，没法学习书中的精傲之处。\n");
	if( me->is_fighting() )
		return notify_fail("你无法在战斗中专心下来研读新知！\n");
	if( !me->query_skill("literate", 1) )
		return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
	if(me->query_skill("liumai-shenjian",1)<1)
	{
		if(me->query_skill("lm-shaoshang",1)<50)
			str="你的少商剑火候还没到!\n";
		if(me->query_skill("lm-shangyang",1)<50)
			str+="你的商阳剑火候还没到!\n";
		if(me->query_skill("lm-shaoze",1)<50)
			str+="你的少泽剑火候还没到!\n";
		if(me->query_skill("lm-guanchong",1)<50)
			str+="你的关冲剑火候还没到!\n";
		if(me->query_skill("lm-shaochong",1)<50)
			str+="你的少冲剑火候还没到!\n";
		if(me->query_skill("lm-zhongchong",1)<50)
			str+="你的中冲剑火候还没到!\n";
		if(str!="\n")
		{
			write(str);
			write("你强行学习六脉神剑，顿时内息紊乱，一口气转不过来，只觉得天旋地转。\n");
			me->set("max_neili",me->query("max_neili")<20?0:me->query("max_neili")-20);
			me->set("neili",0);
			me->unconcious();
			return 1;
		}
		write("你翻开剑谱看了看，顿时感到受益不潜！终于了解如何才能六剑合使了！\n");
		i=me->query_skill("lm-shaoze",1)/10;
		i+=me->query_skill("lm-shangyang",1)/10;
		i+=me->query_skill("lm-shaoshang",1)/10;
		i+=me->query_skill("lm-shaochong",1)/10;
		i+=me->query_skill("lm-guanchong",1)/10;
		i+=me->query_skill("lm-zhongchong",1)/10;
		me->delete_skill("lm-shaoze");
		me->delete_skill("lm-shangyang");
		me->delete_skill("lm-shaoshang");
		me->delete_skill("lm-shaochong");
		me->delete_skill("lm-guanchong");
		me->delete_skill("lm-zhongchong");
		me->set_skill("liumai-shenjian",i);
		return 1;
	}
	if( me->query_skill("liumai-shenjian",1)>50)
		return notify_fail("你已经无法再从这本书里学到任何东西了，只"+
			"有靠自己练习或者同别人学了。\n");
	//if( !SKILL_D("liumai-shenjian")->valid_learn(me) ) return 0;
	cost = 10+random(me->query("max_jing")/10);
	if(me->query("jing")>cost)
	{
		me->improve_skill("liumai-shenjian", 
			random((int)me->query_skill("literate", 1)/2)+1);
		write("你研读有关六脉神剑的技巧，似乎有点心得。\n");
	}
	else
	{
		cost = me->query("jing");
		write("你现在过于疲倦，无法专心下来研读新知。\n");
	}
	me->receive_damage("jing", cost );
	return 1;
}


