inherit ROOM;

void create() {
  set("short", "舍利塔");
  set("long", @LONG
这是天龙三塔之一，建于唐初，年代久远。传说月圆之夜，在此塔
之下默许心愿，塔顶会出现圣光指点迷津，助你达成心愿。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "west": __DIR__ "talin",
    "east": __DIR__ "lianwuchang1",
  ]));
  set("objects", ([
    "/d/wudang/npc/guest": 2,
    __DIR__ "npc/saodiseng": 2,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "east" && objectp(present("saodi seng", this_object()))
    && me->query("family/family_name") != "大理段氏")
    return notify_fail("正在扫地的僧人突然跑过来挡住你：你想偷学武功么？\n");
  return ::valid_leave(me, dir);
}
