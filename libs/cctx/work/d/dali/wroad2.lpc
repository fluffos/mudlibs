inherit ROOM;

void create() {
  set("short", "青石路");
  set("long", @LONG
一条青石铺成的路，从洱海流出的西洱河在路旁缓缓向西流去，南
边是一座雄伟的无量山。东去，可以到达大理。西北山脚下似乎有几户
人家，半山腰上隐约可以看到感通寺的影子。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "westup": __DIR__ "wroad3",
    "east": __DIR__ "wroad1",
  ]));
  setup();
}
