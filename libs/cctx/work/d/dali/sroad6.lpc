// By JackyBoy 98/12/2

inherit ROOM;

void create() {
  set("short", "悬崖");
  set("long", @LONG
走到这里似乎已经没什么路了，只有一条野藤悬挂在悬崖边上，藤
蔓被磨得光滑可能有很多人抓(zhua)着它到悬崖底呢。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "northeast": __DIR__ "sroad5",
  ]));
  setup();
}

void init() {
  add_action("do_zhua", "zhua");
}

int do_zhua(string arg) {
  if (arg != "teng" && arg != "藤")
    return notify_fail("你想抓什么东西啊？\n");
  message_vision("$N一把抓住野藤，嗖的一声滑下悬崖了。\n", this_player());
  this_player()->move(__DIR__ "sroad7");
  return 1;
}
