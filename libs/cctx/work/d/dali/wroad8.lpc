inherit ROOM;

void create()
{
	set("short",  "峡谷东口" );
	set("long", @LONG
这是一条特别狭窄的峡谷，两边分别是无量山和大理苍山。不时还
可以听到两边的悬崖峭壁上传来不知是什么鸟的叫声。来到这里总感觉
有点阴森森的感觉，如果哪里有些土匪拦路抢劫就糟糕了。
LONG
);
	set("outdoors", "dali");
	set("exits", ([
		"east" : __DIR__"wroad7",
		"southwest" :__DIR__"wroad9",
	]));
	setup();
	replace_program(ROOM);
