void create() {
  set("short", "莲花峰");
  set("long", @LONG
这里是大理苍山十九峰莲花峰的山顶，南北两边各有一条小溪喧闹
着向山下流去，正是苍山十八溪之一的芒涌溪和阳溪。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southdown": __DIR__ "xi_mangyong",
    "northdown": __DIR__ "xi_yang",
  ]));
  setup();
