// Room: /d/dali/yubi1.c
// By JackyBoy 98/12/3
#include <ansi.h>
inherit ROOM;
string look_yubi();
int change;
void create() {
  set("short", "石台");
  set("long", (: look_yubi :));
  set("exits", ([
    "east": __DIR__ "xroad7",
  ]));
  change = 0;
  setup();
}

string look_yubi() {
  if (NATURE_D->night() == 0) {
    //白天的long描述！
    change = 0;  //不可缺少!
    return "这个石台显得很窄，人多的话恐怕会有人被挤下悬崖的。一旁有几块石头\n" +
      "被磨得有些光滑了，也许是经常有行人来坐的关系。\n";
  }
  if (change == 0)
    return "现在天是黑的，不过有月亮照着，你还是可以看得比较清楚的。\n" +
      "石台显得很窄，人多的话恐怕会有人被挤下悬崖的。一旁有几块石头\n" +
      "被磨得有些光滑了，也许是经常有行人来坐的关系。\n";
  return "石台被月光蒙上了一层轻纱，旁边的景物都有些朦胧的感觉。\n" +
    "放眼望去，群山都是一片白色，又别有一番景象。仔细一看对面的石壁上似乎\n" +
    "人影在晃来晃去的。难道这里就是无量剑派争夺了多年的无量玉壁？\n";
}

void init() {
  object me;
  me = this_player();
  if (change == 1) {
    add_action("do_jump", "jump");
    return;
  }
  if (NATURE_D->night() == 1)  //如果是黑夜...
  {
    if (random(9) == 1 || me->query("test_player") == 1) {
      change = 1;
      add_action("do_jump", "jump");
      return;
    }
  }
  change = 0;  //这也是不可少的，因为如果在夜里change变为1，当天亮后有人进来时
  //如果不清除change为0，就会出现白天也有月亮的情形。
  return;
}

int do_jump(string arg) {
  object me;
  int i;
  me = this_player();
  if (!arg || arg != "down")
    return notify_fail("你要往哪里跳啊？\n");
  message_vision("$N突然纵身一跃，跳下悬崖了。\n", me);
  i = random(me->query_skill("dodge", 1) / 10);
  if (i < 10)
    i = 10;
  me->move(__DIR__ "yubi2");
  message_vision("$N突然从悬崖上跳了下来。\n", me);
  if (random(i) < 3)
    me->unconcious();
  return 1;
}
