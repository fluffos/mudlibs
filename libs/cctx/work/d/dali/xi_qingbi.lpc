// /d/dali/xi_qingbi.c 清碧溪
// jackyboy /98/11/9

inherit ROOM;

void create() {
  set("short", "清碧溪");
  set("long", @LONG
这里是大理苍山十八溪的清碧溪，比起其他几条小溪却要秀美得多，
溪水清澈透底，正哗哗地流向山下注入洱海，南边抬头就是十九峰之一
的圣应峰，北边则是马龙峰，东边可以看到一个水潭。
LONG
  );
  set("outdoors", "dali");

  set("resource/water", 1);
  set("exits", ([
    "southup": __DIR__ "feng_shengying",
    "northup": __DIR__ "feng_malong",
    "eastdown": __DIR__ "shangtan",  //清碧三潭
  ]));
  setup();
}
