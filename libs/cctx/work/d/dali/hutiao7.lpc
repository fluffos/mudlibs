{
        set("short", HIR "虎跳峡" NOR );
        set("long", @LONG
你走在一个巨大的峡谷之中，两面都是抬头不见顶的高
山，一条大河翻滚着从你身边流过。这里就是天下第一大峡
谷：虎跳峡。
LONG
        );
        set("outdoors", "dali");

        set("exits", ([
               "down" :__DIR__"hutiao8",
               "east"     :__DIR__"hutiao6",
                      ]));

             
        setup();
        replace_program(ROOM);
}
