inherit ROOM;

void create() {
  set("short", "清溪中潭");
  set("long", @LONG
这里是清碧溪三潭之一，溪水清澈透底，一条白色的瀑布从上潭飞
泻而下，在潭中激起一朵朵水花，空气也飘满了水珠，感觉特别清
鲜，溪水在潭中打了个转，向南流去。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "westup": __DIR__ "shangtan",
    "southeast": __DIR__ "wanghaishi",
  ]));
  setup();
  replace_program(ROOM);
}
