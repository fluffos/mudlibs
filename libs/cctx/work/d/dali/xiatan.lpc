// /d/dali/tan1.c 清碧溪清碧三潭之三

// jackyboy /98/11/11

inherit ROOM;
int count;
void create()
{
	set("short",  "清溪下潭" );
	set("long", @LONG
这里是清碧溪三潭中最美的一潭，溪水清澈透底，一条白色的瀑布
从上潭飞泻而下，在潭中激起一朵朵水花，空气也飘满了水珠，感觉特
别清鲜。那又高又滑的悬崖，也不知道你能不能爬上去。
溪水那么干净清爽，连底下的五颜六色的小石子都看得见，真让人想喝
一口。
LONG
);
	count=3;
	set("outdoors", "dali");
	set("valid_startroom",1);
	setup();
}

void init()
{
	add_action("do_drink","drink");
	add_action("do_drink","he");
	add_action("do_drink","喝");
	add_action("do_pa","pa");
	add_action("do_pa","爬");
	UPDATE_D->check_user(this_player());
}

int do_drink(string arg)
{
	object ob,me;
	me=this_player();
	if(!arg||(arg!="水"&&arg!="shui"&&arg!="water"))
		return notify_fail("你要喝什么？\n");
	if(me->query("water")>me->max_water_capacity()-5)
	{
		me->set("water",me->query("water")-1);
		return notify_fail("你又不渴，喝什么嘛，瞎搅和！\n");
	}
	message_vision("$N在潭边爬了下去，把头埋进水里猛喝了几口水。\n",me);
	me->set("water",me->max_water_capacity());
	if(random(15)<7)
	{
		if(count!=0)
		{
		message_vision("$N突然发现水中有一快黑黑的小石头，于是伸出手捞了起来。\n",me);
		new("/d/item/obj/heizhenshi")->move(me);
		count--;
		}
		else
			tell_object(me,"水里的石头似乎被谁翻弄过，可能谁从那里取走了什么东西。\n");
	}
	return 1;
}

int do_pa(string arg)
{
	object me;
	me=this_player();
	if(!arg||(arg!="悬崖"&&arg!="xuanya"))
		return notify_fail("你要爬什么？\n");
	message_vision("\n$N在悬崖上使劲往上爬，石头被溪水泡过"+
		"后滑得很，一不小心就会跌下来的。\n$N可真让人担心啊!\n",me);

	if(random(10)>3)
	{

		tell_object(me,"你只觉得身边的云雾呼呼地直往上刮，衣服紧紧地贴在身上！\n");
		me->move(__DIR__"wanghaishi");
		message_vision("$N从悬崖下爬了上来。\n",me);
		tell_room(__DIR__"xiatan",me->name()+"运气真好，居然成功爬上悬崖了。\n");
	}
	else
	{
		message_vision("突然啪的一声，$N跌进冰冷的水里了，看样子受了很重的伤了。\n",me);
		me->unconcious();
	}
	return 1;
}