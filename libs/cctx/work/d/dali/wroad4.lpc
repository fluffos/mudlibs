inherit ROOM;

void create()
{
	set("short",  "青石路" );
	set("long", @LONG
一条青石铺成的路，从洱海流出的西洱河在路旁缓缓向西流去，南
边是一座雄伟的无量山，北边是点苍山的斜阳峰，有一条小路弯弯曲曲
地通向山顶。东去，是一个小山包。
LONG
);
	set("outdoors", "dali");

	set("exits", ([
		"west" : __DIR__"wroad5",
		"eastup" :__DIR__"wroad3",
		"northup" : __DIR__"csroad1", //上点苍山!    
	]));
	setup();
	replace_program(ROOM);
}
