inherit ROOM;

void create() {
  set("short", "白石溪");
  set("long", @LONG
这里是大理苍山十八溪的白石溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的兰峰，北边则是三阳峰。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southup": __DIR__ "feng_lan",
    "northup": __DIR__ "feng_sanyang",
  ]));
  setup();
  replace_program(ROOM);
}
