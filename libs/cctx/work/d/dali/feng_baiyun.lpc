inherit ROOM;

void create() {
  set("short", "白云峰");
  set("long", @LONG
这里是大理苍山十九峰白云峰的山顶，南北两边各有一条小溪喧闹
着向山下流去，正是苍山十八溪之一的芒涌溪和锦溪。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southdown": __DIR__ "xi_jin",
    "northdown": __DIR__ "xi_mangyong",
  ]));
  setup();
  replace_program(ROOM);
}
