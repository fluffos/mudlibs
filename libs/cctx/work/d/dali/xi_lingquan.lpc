inherit ROOM;

void create() {
  set("short", "灵泉溪");
  set("long", @LONG
这里是大理苍山十八溪的灵泉溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的三阳峰，北边则是鹤云峰。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southup": __DIR__ "feng_sanyang",
    "northup": __DIR__ "feng_heyun",
  ]));
  setup();
  replace_program(ROOM);
}
