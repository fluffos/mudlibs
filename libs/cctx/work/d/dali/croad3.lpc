#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIG "山路" NOR );
        set("long", @LONG
一条山路，坎坷不平，杂草丛生，看起来人迹罕至，连鸟兽都很少。
LONG
        );
        set("outdoors", "dali");

        set("exits", ([
               "northdown"  :__DIR__"croad4",
		   "southwest" :__DIR__"croad2",
                      ]));

             
        setup();
       replace_program(ROOM);
}

