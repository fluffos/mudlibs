inherit ROOM;

string get_food();

void create() {
  set("short", "武馆休息室");
  set("long", @LONG
这是武馆里的休息室，横七竖八地摆满了桌椅，正中是一张八仙
桌(zhuo)，上面摆满了东西。
LONG
  );
  set("no_clean_up", 0);
  set("sleep_room", 1);
  set("exits", ([
    "west": __DIR__ "wuguan2",
  ]));
  setup();
}

void init() {
  if (random(11) > 8)
    this_object()->add("food", 1);
  add_action("do_look", "look");
  add_action("do_look", "l");
}

int do_look(string arg) {
  if (arg != "zhuo")
    return 0;
  tell_object(this_player(), get_food());
  return 1;
}

string get_food() {
  if (this_object()->query("food") > 0 && random(11) > 6) {
    this_object()->add("food", -1);
    new("/clone/food/jitui")->move(environment(this_player()));
    //new("/clone/food/jiudai")->move(environment(this_player()));	
    return "你看到桌上摆满了鸡腿和酒袋，口水都流了出来。\n" +
      "一不小心却把一根鸡腿弄到地上了。\n";
  } else
    return "你看到桌上摆满了鸡腿和酒袋，口水都流了出来。\n" +
      "可惜那些东西不是为你准备的！\n";
}
