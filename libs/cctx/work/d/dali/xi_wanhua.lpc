inherit ROOM;

void create()
{
	set("short",  "万花溪" );
	set("long", @LONG
这里是大理苍山十八溪的万花溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的五台峰，北边则是沧浪峰。
LONG
);
	set("outdoors", "dali");

	set("exits", ([
		"southup" : __DIR__"feng_wutai",
		"northup" : __DIR__"feng_canglang",
	]));
	setup();
	replace_program(ROOM);
}
