// Room: /d/dali/sroad8.c
// By JackyBoy 98/12/2

inherit ROOM;

void create() {
  set("short", "小路");
  set("long", @LONG
这是引着悬崖底延伸的一条小路，大雾弥漫，什么都看不清楚。往
西的路继续往山上走，悬崖从你的头上向东北方向突了出去。靠着石壁
的一面杂草丛生，真担心扒开后又冒几个什么怪物出来。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "northeast": __DIR__ "sroad8",
    "westup": __DIR__ "sroad10",
  ]));
  setup();
}

void init() {
  object me;
  me = this_player();
  add_action("do_pa", "pa");
  if (me->query_temp("move_dir") == "out")  //未实现该部分的功能！
  {
    message_vision("$N从石洞里爬了出来。\n", me);
    //me->delete_temp("move_dir");
  }
}

int do_pa(string arg) {
  if (arg != "草" && arg != "cao")
    return notify_fail("你要把什么东西扒开？\n");
  message_vision("$N小心翼翼地扒开乱草，露了一个洞(dong)出来。\n" +
    "$N往里面看了看，黑漆漆的，也不知道里面有什么东西。\n", this_player());
  set("long", @LONG
这是引着悬崖底延伸的一条小路，大雾弥漫，什么都看不清楚。往
西的路继续往山上走，悬崖从你的头上向东北方向突了出去。靠着石壁
的杂草已经被扒开了，露了个黑漆漆的洞(dong)出来。
LONG
  );
  set("item_desc", ([
    "dong": "这个洞黑漆漆的，也不知道里面有什么东西。\n",
  ]));
  set("exits", ([
    "northeast": __DIR__ "sroad8",
    "westup": __DIR__ "sroad10",
    "enter": __DIR__ "sdong1",
  ]));
  return 1;
}

int valid_leave(object me, string dir) {
  if (dir == "enter") {
    message_vision("$N弯下腰，钻进洞去了。跟着把洞又遮了起来。\n", me);
    delete("item_desc");
    set("long", @LONG
这是引着悬崖底延伸的一条小路，大雾弥漫，什么都看不清楚。往
西的路继续往山上走，悬崖从你的头上向东北方向突了出去。靠着石壁
的一面杂草丛生，真担心扒开后又冒几个什么怪物出来。
LONG
    );
    set("exits", ([
      "northeast": __DIR__ "sroad8",
      "westup": __DIR__ "sroad10",
    ]));
    return 1;
  }
  return ::valid_leave(me, dir);
}
