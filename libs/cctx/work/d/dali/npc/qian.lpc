inherit F_BANKER;
//write by jackyboy @cctx 98/12/29

void create() {
  set_name("钱大嫂", ({ "qian dasao", "qian", "dasao" }));
  set("title", "钱庄老板娘");
  set("nickname", "欢迎存钱");
  set("gender", "女性");
  set("age", 34);

  set("str", 22);
  set("int", 24);
  set("dex", 18);
  set("con", 18);

  set("qi", 2000);
  set("max_qi", 2000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("shen", 0);
  set_skill("dodge", 80);
  set_skill("parry", 90);
  set_skill("sword", 89);
  set("combat_exp", 500000);
  set("shen_type", 1);
  set("attitude", "friendly");
  set("env/wimpy", 50);
  set("chat_chance", 2);
  set("chat_msg", ({
    "钱大嫂骄傲的说道：本银号已经有上百年的历史，在云南可以说是第一家。\n",
    "钱大嫂笑着说道：在本店存钱无利息，取钱收十分之二的手续费，客官您看着办吧。\n"
    "钱大嫂微微一笑，说道：本店还办理不同面额货币的兑换业务，但每次要收十分之一的手续费。\n"
  }));

  set_skill("unarmed", 150);
  set_skill("dodge", 90);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 40);

  setup();
  add_money("gold", 20);
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
