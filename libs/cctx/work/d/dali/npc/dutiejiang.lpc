// dutiejiang.c
#include <ansi.h>

inherit F_DEALER;
string ask_me(int);
string replace_color(string, int);
void create() {
  set_name("杜铁匠", ({ "du tiejiang", "du", "tiejiang" }));
  set("title", "铁匠铺老板");
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 33);
  set("long", "杜铁匠正把铁水到进铸具里，一件兵器就要做完了。\n");

  set("combat_exp", 1400);
  set("attitude", "friendly");
  set("dodge", 30);
  set("parry", 50);
  set("unarmed", 60);
  set("force", 40);
  set("sword", 70);
  set("vendor_goods", ({
    "/d/city/obj/changjian",
    "/d/city/obj/hammer",
    "/d/city2/obj/tudao",
    "/d/xingsu/obj/tiegun",
    "/d/city/obj/dagger",
    "/d/city/obj/gangdao",
  }));
  set("inquiry", ([
    "自制兵器": ask_me(1),
    "自造兵器": ask_me(1),
    "兵器": ask_me(2),
    "铸字": ask_me(2),
  ]));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_pay", "pay");
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}


string ask_me(int type) {
  switch (type) {
    case 1:
      return "听说江湖里也有莫邪和干将在炼制兵器，小的这点水平让您见笑了！\n" +
        "不过普通的兵器铸字小的也可以承接下来的。\n";
    case 2:
      return "客官想给你的兵器铸字么？先把兵器给俺看看，再酌情给(pay)俺些小钱吧。\n";
  }
}

int accept_object(object who, object ob) {
  if (objectp(who->query_temp("accept_weapon"))) {
    message_vision("杜铁匠一脸歉意对$N说：小的还没把你的上一把兵器做好呢！\n", who);
    return 0;
  }
  if (ob->query("weapon_prop")) {
    who->set_temp("accept_weapon", ob);
    message_vision("客官你先付(pay)些钱给我就可以开始铸字了。\n", who);
    return 1;
  }
  message_vision("杜铁匠两眼一横：这东西拿来给我干什么？\n", who);
  return 0;
}

int do_pay() {
  object me, ob;
  me = this_player();

  if (!objectp(ob = me->query_temp("accept_weapon")))
    return notify_fail("杜铁匠一愣，说：你得先把兵器给我呀！不然我怎么估价？\n");
  if (me->query_temp("pay_zhuzi"))
    return notify_fail("客官别着急，先把上一把兵器铸好字再说。\n");
  switch (MONEY_D->player_pay(me,
    ob->query("value") * 15 / 100))  //收15%的加工费
  {
    case 0:
      ob->move(me);
      me->delete_temp("accept_weapon");
      return notify_fail("杜铁匠看到你没钱，脸色顿时变了，把兵器甩还你了。\n");
    case 2:
      ob->move(me);
      me->delete_temp("accept_weapon");
      return notify_fail("杜铁匠一脸苦相：您的零钱不够了，银票又没人找得开。这叫" +
        "小的咋办呢？\n");
    default:
  }
  message_vision("杜铁匠向$N哈了哈腰，说：客官想铸(zhu)什么字上去？\n", me);
  me->set_temp("pay_zhuzi", 1);
  add_action("do_zhu", "zhu");
  return 1;
}

int do_zhu(string arg) {
  object me, ob;
  string str;
  if (!arg || arg == "")
    return notify_fail("杜铁匠问道：客官到底要铸(zhu)什么字呀？\n");
  me = this_player(1);
  if (!objectp(ob = me->query_temp("accept_weapon")))
    return notify_fail("杜铁匠奇怪地挠了挠后脑勺，说：你真的让我铸过字？\n" +
      "可是小的这里没有你的兵器呀？难道被偷了？\n");
  str = ob->query_temp("zhuzi") ? ob->query("old_long") : ob->query("long");
  ob->set("old_long", str);  //允许重新铸字！
  str += "只见上面刻着几个小字：\n";
  str += replace_color(arg, 1) + "\n";
  me->set_temp("zhu_modify", 1);
  tell_object(me, "杜铁匠笑眯眯地对你说：客官你的兵器将铸成这样。说罢把样品摆" +
    "给你看了看：\n" + str + "\n如果你认为可以就结束(finish)铸字吧？\n");
  me->set_temp("new_weapon_long", str);
  add_action("do_finish", "finish");
  return 1;
}

int do_finish() {
  object me, ob;
  me = this_player(1);
  if (me->query_temp("zhu_modify") != 1 || strlen(me->query_temp("new_weapon_long")) == 0)
    return notify_fail("杜铁匠感到莫名其妙：客官你还没说要铸什么字呢！难道不想铸了？\n");
  if (!objectp(ob = me->query_temp("accept_weapon")))
    return notify_fail("杜铁匠脸色大变：小的有罪，不知道把您的兵器弄哪去了，" +
      "请您饶了我吧?\n");
  ob->set("long", me->query_temp("new_weapon_long"));
  ob->move(me);
  ob->set_temp("zhuzi", 1);
  me->delete_temp("new_weapon_long");
  me->delete_temp("pay_zhuzi");
  me->delete_temp("accept_weapon");
  message_vision("杜铁匠双手举着一" + ob->query("unit") + ob->query("name") + "递给了$N，然后" +
    "说道：欢迎下次光临鄙店！\n", me);
  return 1;
}
string replace_color(string arg, int flag) {
  arg = replace_string(arg, "$BLK$", flag ? BLK : "");
  arg = replace_string(arg, "$RED$", flag ? RED : "");
  arg = replace_string(arg, "$GRN$", flag ? GRN : "");
  arg = replace_string(arg, "$YEL$", flag ? YEL : "");
  arg = replace_string(arg, "$BLU$", flag ? BLU : "");
  arg = replace_string(arg, "$MAG$", flag ? MAG : "");
  arg = replace_string(arg, "$CYN$", flag ? CYN : "");
  arg = replace_string(arg, "$WHT$", flag ? WHT : "");
  arg = replace_string(arg, "$HIR$", flag ? HIR : "");
  arg = replace_string(arg, "$HIG$", flag ? HIG : "");
  arg = replace_string(arg, "$HIY$", flag ? HIY : "");
  arg = replace_string(arg, "$HIB$", flag ? HIB : "");
  arg = replace_string(arg, "$HIM$", flag ? HIM : "");
  arg = replace_string(arg, "$HIC$", flag ? HIC : "");
  arg = replace_string(arg, "$HIW$", flag ? HIW : "");
  arg = replace_string(arg, "$NOR$", flag ? NOR : "");
  arg = replace_string(arg, "$BLINK$", flag ? BLINK : "");
  if (flag) arg += NOR;
  return arg;
}
