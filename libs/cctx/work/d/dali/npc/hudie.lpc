//hudie.c

inherit NPC;

void create()
{
	set_name("蝴蝶", ({"hu die","die","hudie"}) );
	set("race", "野兽");
	set("age", 8);
	set("long", "这是一只蝴蝶，忽上忽下地飞来飞去。\n");
	
	set("str", 40);
	set("dex", 50);

	set("limbs", ({ "头部", "身体", "翅膀", "尾巴" }) );
	set("verbs", ({ "bite", "poke" }) );

	set_temp("apply/attack", 33);
	set_temp("apply/armor", 20);
	
	set("chat_chance", 1);
	set("chat_msg", ({
		(: this_object(), "random_move" :),
		"蝴蝶轻轻地飞过来，在你头上转了一圈，又飞走了。\n",
		"蝴蝶轻轻地落在你的发梢上。\n",
		"蝴蝶象一片落叶似的，轻盈地在空中飞来飞去。\n",
		"蝴蝶落在树叶上面，微风轻轻地吹摇了树枝，蝴蝶随风飞走了。\n",
		"一只小蝴蝶飞了过来，想歇在你的肩上，可是你一动，它又飞走了。\n",
	 }) );

	setup();
}

