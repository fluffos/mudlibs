// /d/dali/npc/bai.c
// modify by jackyboy 98/11/29


inherit F_DEALER;
string ask_me(int i);

void create() {
  set_name("白福", ({ "bai fu", "bai", "fu" }));
  set("title", "绸缎铺老板");
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 45);
  set("long",
    "白老板据说是从扬州来的，从各地倒些布料来卖。\n");
  set("max_qi", 300);
  set("qi", 300);
  set("str", 40);
  set_skill("unarmed", 90);
  set_skill("dodge", 90);
  set_skill("parry", 85);
  set_temp("apply/damage", 15);
  set("inquiry", ([
    "蚕": (: ask_me(1) :),
    "蚕丝": (: ask_me(2) :),
    "加工": (: ask_me(3) :),
    "定做": (: ask_me(4) :),
    "衣服": (: ask_me(5) :),
  ]));
  set("combat_exp", 40000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    "/d/dali/obj/jinduan",
    "/clone/misc/cloth",
  }));

  setup();
  carry_object("/d/dali/obj/jinduan")->wear();
}
string ask_me(int i) {
  object me;
  me = this_player();
  switch (i) {
    case 1:
      return "大理城内有家蚕丝铺，听说每年都要养很多蚕，到我这里来的很多顾客都\n" +
        "是从它那里买的蚕茧来加工的。这位" + RANK_D->query_respect(me) + "不妨去" +
        "那里看看。\n";
    case 2:
      return "用蚕丝做出的布料又牢靠又报暖，不过加工费也不扉哟！\n";
    case 3:
      return "这位" + RANK_D->query_respect(me) + "想加工些什么？想加工蚕茧还是要定" +
        "做衣服?\n";
    case 4:
    case 5:
      return "要定做衣服么？得把丝料给我呀！\n";
  }
  return "不知道！\n";
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
  add_action("do_pay", "pay");
}

int accept_object(object who, object ob) {
  if ((string)ob->query("name") == "蚕"
    || (string)ob->query("name") == "天蚕") {
    message_vision("白福两眼一瞪：你这是干什么？我不会帮你养蚕的，你" +
      "另寻门路吧。\n说罢把蚕还给你了。\n", who);
    return 0;
  } else if (ob->query("name") == "蚕茧"
    || ob->query("name") == "天蚕茧") {
    if (objectp(who->query_temp("accept_obj"))) {
      message_vision("白福脸上露出一丝愧色，说道：客官你别着急，马上就好，" +
        "不过你得先给(pay)俺钱！\n", who);
      return 0;
    }
    message_vision("白福点了点头：好的小的这就给你加工，不过你得给俺些钱(pay)" +
      "，\n俺还得养家敷口呢！\n", who);
    who->set_temp("accept_obj", ob);
    return 1;
  }
  return 0;
}

int do_pay() {
  object me, ob;
  me = this_player();
  if (!objectp(ob = me->query_temp("accept_obj")))
    return notify_fail("白福一愣，说：你得先把原料给我呀！不然我怎么估价？\n");
  switch (MONEY_D->player_pay(me,
    ob->query("value") * 15 / 100))  //收15%的加工费
  {
    case 0:
      ob->move(me);
      me->delete_temp("accept_obj");
      return notify_fail("白福看到你没钱，脸色顿时变了：穷光蛋，一边呆着去！哼...\n" +
        "然后把蚕茧甩还你。\n");
    case 2:
      ob->move(me);
      me->delete_temp("accept_obj");
      return notify_fail("白福一脸苦相：您的零钱不够了，银票又没人找得开。这叫" +
        "小的咋办呢？\n");
    default:
  }
  switch (ob->query("name")) {
    case "蚕茧":
      ob->change();
      if (ob->query("name") != "天蚕茧") {
        message_vision("白福把一件衣服交了给你，然后笑着说：客官，欢迎下次光临!\n",
          me);
        new("/d/dali/obj/si_cloth")->move(me);
        destruct(ob);
      }
      return 1;
    case "天蚕茧":
      message_vision("白福两眼笑得眯成了一条缝，这位" + RANK_D->query_respect(me) +
        "运气好得很啊！\n连那么难得的天蚕茧都找得到！丝料给你加工好了，不过我劝" +
        "你还是留着吧，\n也许别的地方可以更好地利用它，小的这儿没能力把它做成" +
        "衣服。\n", me);
      new("/d/item/obj/tiancansi")->move(me);
      me->delete_temp("accept_obj");
      destruct(ob);
  }
  return 1;
}
