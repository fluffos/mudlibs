// chaboshi.c

inherit F_DEALER;

void create() {
  set_name("茶博士", ({ "cha boshi", "boshi", "waiter", "xiaoer" }));
  set("title", "茶铺伙计");
  set("shen_type", 1);

  set("str", 30);
  set("gender", "男性");
  set("age", 25);
  set("long",
    "茶博士长的憨厚老实，见人就笑，大家看他为人可以，都愿意来这里喝茶。\n");
  set("combat_exp", 500);
  set("attitude", "friendly");
  set("inquiry", ([
    "喝茶": "哦，这个喝茶可有学问了，要不，您先尝尝我这龙井。\n",
  ]));

  set("vendor_goods", ({
    "/d/dali/obj/longjing",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_list", "list");
  add_action("do_buy", "buy");

}

void greeting(object ob) {
  if (!ob || environment(ob) != environment())
    return;
  switch (random(2)) {
    case 0:
      say("茶博士笑着说道：这位" + RANK_D->query_respect(ob) +
        "，快请进来听段评书，可好听哪。\n");
      break;
    case 1:
      say("茶博士说道：这位" + RANK_D->query_respect(ob) +
        "您喝点什么？要不，来壶龙井？。\n");
      break;
  }
}
