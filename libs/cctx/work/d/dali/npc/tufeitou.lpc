// /d/dali/npc/tufeitou.c 土匪头

inherit NPC;

void create() {
  set_name("女土匪头", ({ "tu fei tou", "tou", "tu fei", "fei" }));
  set("gender", "女性");
  set("age", 25);
  set("long", "这是一个女土匪，看样子是这群土匪的头目。\n");

  set("combat_exp", 17000);
  set("shen_type", -1);
  set("attitude", "aggressive");

  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);

  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("gold", 1);
}
