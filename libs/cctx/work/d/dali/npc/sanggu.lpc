inherit NPC;
string ask_me(int i);
void create() {
  set_name("桑姑", ({ "sang gu", "gu" }));
  set("gender", "女性");
  set("age", 21);
  set("shen_type", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("qi", 1500);
  set("max_qi", 1500);
  set("jing", 1100);
  set("max_jing", 1100);
  set("neili", 1100);
  set("max_neili", 1100);
  set("jiali", 10);
  set("combat_exp", 18000);
  set("score", 11000);
  set_skill("force", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set("inquiry", ([
    "蚕架": (: ask_me(1) :),
    "养蚕": (: ask_me(2) :),
    "蚕": (: ask_me(3) :),
    "天蚕": (: ask_me(4) :),
  ]));
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}
int accept_object(object who, object ob) {
  if (ob->query("name") == "蚕"
    || ob->query("name") == "天蚕")
    message_vision("桑姑很不高兴地把嘴嘟了起来，对$N" +
      "说：“难道还要我来帮你养？”\n", who);
  else
    message_vision("桑姑把" + ob->query("name") + "接过去看了一下，" +
      "说：这些东西我拿来有什么用呢？有把它还给$N了。\n", who);
  return 0;
}
string ask_me(int i) {
  object me, ob;
  me = this_player();
  me->set_temp("ask_flag", 0);
  switch (i) {
    case 1:
      if (!objectp(ob = present("can", me)))
        return "这几个破蚕架现在能对你有什么用呢？说完摇了摇头。\n";
      me->set_temp("ask_flag", 1);
      return "这几个破蚕架虽然有点烂，不过还是可以将就着用的。\n" +
        "然后点了点头说：你要养就养吧！\n";
    case 2:
      if (!objectp(ob = present("can", me)))
        return "你都没有蚕还想养？然后白了一眼。\n";
      me->set_temp("ask_flag", 1);
      return "好啊！反正都是空着的，你自己去养吧。\n";
    case 3:
      return "我家养蚕在大理是很出名的哟！很多人都跟我们买蚕\n茧去织布做衣呢。\n";
    case 4:
      return "天蚕？我也没见过，不过听说它初看上去同普通蚕没什\n么两样的，除非你" +
        "仔细瞧瞧，才能分辨得出。不过听说大理境内的\n确有人发现过天蚕哟！\n";
  }
  return "我不知道!\n";
}
