// /d/dali/npc/louluo.c 喽罗

inherit NPC;

void create() {
  set_name("喽罗", ({ "lou luo", "louluo" }));
  set("gender", "男性");
  set("age", 19);
  set("long", "这是一个小喽罗。\n");

  set("combat_exp", 1000);
  set("shen_type", -1);

  set("attitude", "peaceful");

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);

  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 2);
}
