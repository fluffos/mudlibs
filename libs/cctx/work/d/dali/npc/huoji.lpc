// huoji. 药铺伙计


inherit F_DEALER;

void create() {
  set_name("药铺伙计", ({ "yaopu huoji", "huoji" }));
  set("str", 20);
  set("gender", "男性");
  set("age", 18);
  set("long", "他是宝芝林药铺从乡下招来帮忙的。\n");
  set("combat_exp", 250);
  set("attitude", "friendly");
  set("vendor_goods", ({
    "/d/city/obj/jinchuang",
    "/d/city/obj/yangjing",
    "/d/dali/obj/baiyao"
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
