inherit NPC;
string ask_me(int i);
void create() {
  set_name("小工", ({ "xiao gong", "gong", "worker" }));
  set("gender", "男性");
  set("age", 21);
  set("shen_type", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("qi", 1500);
  set("max_qi", 1500);
  set("jing", 1100);
  set("max_jing", 1100);
  set("neili", 1100);
  set("max_neili", 1100);
  set("jiali", 10);
  set("combat_exp", 18000);
  set("score", 11000);
  set_skill("force", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_pay", "pay");
}

int do_pay() {
  object me = this_player();
  if (this_object()->query_temp("busy") == 1)
    return notify_fail("你请等一下，这还有个客人没下去呢。\n");
  if (me->query_temp("pay_flag") == 1)
    return notify_fail("怎么可以让你多次破费呢，你快到藤篮里吧，小的帮你过这" +
      "个悬崖。\n");
  switch (MONEY_D->player_pay(me, 1000)) {
    case 0:
      return notify_fail("没钱还想从这里走？\n");
    case 2:
      return notify_fail("小工一脸苦相：您的零钱不够了，银票又没人找得开。这叫" +
        "小的咋办呢？\n");
  }
  me->set_temp("pay_flag", 1);
  this_object()->set_temp("busy", 1);
  message_vision("小工接过钱，说：好的，我马上就把藤篮摇来。\n" +
    "说着便摇着一边的轱辘，把藤篮摇过来了。\n", me);
  tell_object(me, "请你走进去(enter)吧!\n");
  call_out("check_delay", 10, me, this_object());
  add_action("do_enter", "enter");
  return 1;
}

int do_enter() {
  object me = this_player();
  if (me->query_temp("pay_flag") != 1)
    return notify_fail("小工哼了一声，说：你刚才又不走，怎么现在又想走啦？！\n" +
      "然后把手一伸：除非你再给点钱！\n");
  this_object()->set_temp("busy", 0);
  me->set_temp("pay_flag", 0);
  message_vision("$N把脚抬起，跨进藤篮里，坐稳了。\n", me);
  me->move(__DIR__ "tenglan");
  call_out("make_go", 8, me, this_object(), environment(this_object())->query("go_room"));
  //根据所在房间的go_room属性决定去哪个房间
  message_vision("$N费劲地摇着轱辘，轱辘吱呀吱呀地响着，真担心它散了架。\n", this_object());
  return 1;
}

void make_go(object me, object ob, string room) {
  tell_object(me, "冷风一个劲地往你身上吹，藤篮也摇来晃去的，真让人担心它出问题。\n");
  if (random(15) <= 1)
    call_out("make_go1", 4, me, ob);
  else
    call_out("make_go2", 4, me, room);
}

void make_go1(object me, object ob) {
  tell_object(me, "没想到担心什么就发生什么，只见藤篮一摇，翻了个底朝天，你直往下落" +
    "...\n眼角恍惚中看到小工得意地笑着...你好象什么都明白了...\n");
  message_vision("突然传来一声惨叫，$N脸上露了一丝不易察觉的笑意，然后又不动声色地底" +
    "\n下头去继续做自己的事。\n", ob);
  me->move("/d/dali/xroad10");
  message_vision("$N从藤篮上跌了下来。\n", me);
  me->set_temp("diemsg", "从断崖上跌了下来，摔死了");
  me->die();
}

void make_go2(object me, string room) {
  tell_object(me, "还好，终于平安到达了。\n");
  me->move(room);
  message_vision("$N从藤篮上跨了出来，脸色似乎很惨白！象是受了惊吓。\n", me);
}
void check_delay(object me, object ob) {
  if (me->query_temp("pay_flag") == 1) {
    me->set_temp("pay_flag", 0);
    ob->set_temp("busy", 0);
    message_vision("小工对着$N说：这么久还不进藤篮，那么这些钱我就白收啦！\n", me);
  }
  return;
}
