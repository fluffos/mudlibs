// 蟒蛇 /d/dali/npc/mangshe.c

inherit NPC;

void create() {
  set_name("蟒蛇", ({ "mang she", "mang", "she" }));
  set("race", "野兽");
  set("age", 1);
  set("long", "这条蟒蛇全身花纹，身体有水桶那么粗，让人不寒而栗。\n");
  set("attitude", "aggressive");

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("combat_exp", 8000);

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 20);
  set_temp("apply/damage", 15);
  set_temp("apply/armor", 10);

  setup();
}

void die() {
  object ob;
  message_vision("$N蠕动了两下，死了。\n\n", this_object());
  ob = new("/d/dali/obj/sherou");
  ob = new("/d/dali/obj/shepi");
  ob->move(environment(this_object()));
  destruct(this_object());
}
