// /d/dali/npc/tufei.c 土匪

inherit NPC;

void create() {
  set_name("土匪", ({ "tu fei", "fei" }));
  set("gender", "男性");
  set("age", 19);
  set("long", "这是一个瞎了只眼睛的独眼土匪，唯一的一只眼睛不停地在你身上打转，\n" +
    "想琢磨出你的money放在哪里了。\n");

  set("combat_exp", 11000);
  set("shen_type", -1);
  set("attitude", "aggressive");

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);

  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 50);
}
