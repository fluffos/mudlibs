// waiter.c 酒楼招待

inherit F_DEALER;

void create()
{
	set_name("招待小姐", ({ "xiao jie", "waiter" }) );
	set("gender", "女性" );
	set("age", 16);
	set("long",
		"这位年方二八的小姐正忙著呢，不时用雪白的胳臂擦擦粉脸。\n");
	set("combat_exp", 100);
	set("attitude", "friendly");
	set("vendor_goods", ({
		"/d/dali/obj/jitui",
		"/d/dali/obj/jiudai",
		"/d/dali/obj/baozi",
		"/d/dali/obj/rushan",
		"/d/dali/obj/wineskin",
	}));
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{	
	object ob; 
	mapping myfam; 

	ob = this_player();

	::init();
	if( interactive(ob) && !is_fighting() ) {
		if ( (myfam = ob->query("family")) 
		&& myfam["family_name"] == "丐帮" 
		&& ob->query_skill("begging",1) > 10 )
		{
			remove_call_out("saying");
			call_out("saying", 0, ob);
		}
		else
		{ 
			remove_call_out("greeting");
			call_out("greeting", 1, ob);
		}
	}

	add_action("do_buy", "buy");
	add_action("do_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(2) ) {
		case 0:
			say( "招待小姐笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，进来喝杯茶，歇歇腿吧。\n");
			break;
		case 1:
			say( "招待小姐匆匆跑到门口，说道：这位" + RANK_D->query_respect(ob)
				+ "，请进请进。\n");
			break;
	}
}

void saying(object ob)
{
        if (!ob || environment(ob) != environment()) return;

	say("\n招待小姐两手一叉，大喝一声：你这臭要饭的进来干什麽？ 给我滚出去！\n\n");
	remove_call_out("kicking");
	call_out("kicking", 1, ob);
	
}

void kicking(object ob)
{
        if (!ob || environment(ob) != environment()) return;

	ob->move("/d/dali/xijie");
	message("vision","只听“乒”地一声，" +  ob->query("name") +
		"被人从香格里拉酒楼里一脚踢了出来，狼狈万状的逃开了。\n", environment(ob), ob);
}
