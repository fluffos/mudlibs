// /d/dali/shanlu1
// netkill /98/8/14/

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIR "悬崖底" NOR);
  set("long", @LONG
一坐峭壁拦住了去路，他头看去，峭壁上有几个乌鸦窝，几
只乌鸦盘旋在空中。峭壁的左边大石(shi)凸了出来，似乎可以攀
爬上去。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southdown": __DIR__ "shanlu",
  ]));

  set("item_desc", ([
    "shi": "悬崖上突出来一些大石头，你不由想抓住这些大石爬上崖顶。\n\n"
  ]));
  setup();

}
void init() {
  add_action("do_enter", "pa");
  UPDATE_D->check_user(this_player());
}


int do_enter(string arg) {
  object me;
  me = this_player();

  if (!arg || arg == "") return 0;

  if (arg == "shi") {
    message("vinson", HIY "你一咬牙，抓住石头，爬了上去。\n\n" NOR,
      this_player());

    me->move(__DIR__ "xuanya");

    return 1;
  }
}
