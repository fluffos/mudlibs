inherit ROOM;

void create() {
  set("short", "玉局峰");
  set("long", @LONG
这里是大理苍山十九峰玉局峰的山顶，南北两边各有一条小溪喧闹
着向山下流去，正是苍山十八溪之一的龙溪和经玉溪。峰巅上不离不散
地飘着些白色云团，那就是民间传说的“望夫云”，也叫“无渡云”，
看来洱海的渔民今天又不能出海捕鱼了。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southdown": __DIR__ "xi_long",
    "northdown": __DIR__ "xi_jingyu",
  ]));
  setup();
  replace_program(ROOM);
}
