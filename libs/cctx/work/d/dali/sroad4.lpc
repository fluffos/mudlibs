// Room: /d/dali/sroad4.c
// By JackyBoy 98.10.28

inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
路越走越陡，由于走的人比较少，两旁的杂草都快把崎岖的小路给
遮挡完了，但是却有着一种让人心旷神怡的大自然的气息。
    草从里突然响了一下，几棵草晃动起来，你不禁想扒开(pa)看一
下是怎么回事。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "northeast": __DIR__ "sroad3",
    "westup": __DIR__ "sroad5",
  ]));
  set("count", 10);
  setup();
}

void init() {
  add_action("do_pa", "pa");
}

int do_pa(string arg) {
  object me;
  me = this_player();
  if (!arg || arg == "" || (arg != "草" && arg != "cao"))
    return notify_fail("你要扒什么呀？\n");
  if (query("count") > 0 && random(5) > 2) {
    message_vision("\n突然从草丛中爬出来几条蛇，如过没有雄黄还是快走的好！\n", me);
    new(__DIR__ "npc/dushe")->move(this_object());
    new(__DIR__ "npc/dushe")->move(this_object());
    if (random(20) > 9) {
      message_vision("\n哇噻！其中居然还有一条大蟒蛇呢！还不快跑！\n", me);
      new(__DIR__ "npc/mangshe")->move(this_object());
    }
    set("count", query("count") - 1);
    return 1;
  }
  message_vision("$N扒了扒草，什么都没发现。\n", me);
  return 1;
}
