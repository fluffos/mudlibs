// /d/dali/wanghaishi.c 清碧溪清碧三潭之望海石（虚拟）

// jackyboy /98/11/10

inherit ROOM;

void create()
{
	set("short",  "清溪望海石" );
	set("long", @LONG
这里是介于清碧溪三潭的中潭和下潭的望海石，溪水从旁边缓缓而
过，又从东边的大理石悬崖上跌落下去，形成了一条壮丽的瀑布。悬崖
边上山风呼呼地刮过，下面就是三潭中最美的下潭了，但是似乎没有路
可以下去。想跳下去又不知道云雾下面有些什么，可能很危险哟！远远
地可以看到洱海上的波光粼粼。
LONG
);
	set("outdoors", "dali");

	set("exits", ([
		"northwest" : __DIR__"zhongtan",
		//"eastdown" : __DIR__"xiatan",
	]));
	setup();
	//replace_program(ROOM);
}
void init()
{
	add_action("do_enter", "jump");
	UPDATE_D->check_user(this_player());
}


int do_enter(string arg)
{
	object me;
	me = this_player();

	if( !arg || (arg!="down" && arg!="xia")) 
		return notify_fail("你要往哪个方向跳？\n");

	message_vision("$N纵身跳下了悬崖，看来是死定了。\n可惜!武林又少了个高手。\n",me);
	tell_object(me,"你只觉得身边的云雾呼呼地直往上刮，衣服紧紧地贴在身上！\n");
	me->move(__DIR__"xiatan");
	me->unconcious();
	message_vision("突然啪的一声，$N从悬崖跌进冰冷的水里了，看样子受了很重的伤了。\n",me);
	return 1;
}	


