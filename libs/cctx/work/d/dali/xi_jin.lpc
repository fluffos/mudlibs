inherit ROOM;

void create()
{
	set("short",  "锦溪" );
	set("long", @LONG
这里是大理苍山十八溪的锦溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的鹤云峰，北边则是白云峰。
LONG
);
	set("outdoors", "dali");

	set("exits", ([
		"southup" : __DIR__"feng_heyun",
		"northup" : __DIR__"feng_baiyun",
	]));
