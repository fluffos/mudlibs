inherit ROOM;

void create()
{
	set("short", "山路");
	set("long", @LONG
你身处在无量山中，周围都是密密麻麻的思茅松，遮得天空都几乎
看不见了，不时刮过来一阵阵山风，松林中也响起浑厚的松涛声，
往北是下山的路。山路往西南方延伸，通向密林深处......
LONG
);
	set("outdoors","dali");
	set("exits",([
		"northdown" : __DIR__"sroad2",
		"southwest" : __DIR__"sroad4",
	]));
	set("no_clean_up",0);

	setup();
	replace_program(ROOM);
