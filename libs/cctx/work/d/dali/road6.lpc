// modify by jackyboy 98/11/26

#define File "/d/dali/road6.lpc"

inherit ROOM;
int count, count1;
void create() {
  set("short", "崎岖山路");
  set("long", @LONG
一条崎岖的小路，时不时有一两个樵夫和菜药人从你身边经过。路
旁有一棵桑树(tree)，也不知道桑葚被别人摇(yao)光了没有。
LONG
  );
  set("outdoors", "dali");
  set("item_desc", ([
    "tree": "这是一棵小桑树，上面似乎还挂着些黑黑的桑葚。\n" +
    "只是它的叶子好象被什么虫子吃过似的。\n",
  ]));
  set("exits", ([
    "eastup": __DIR__ "road5",
    "southwest": __DIR__ "erhai1",
  ]));
  count = 1;
  count1 = 0;
  setup();
}

void init() {
  add_action("do_yao", "yao");
}

int do_yao(string arg) {
  object me, obj, *inv;
  int i, j;
  string err;
  if (!arg || arg == "" || arg != "tree")
    return notify_fail("你要摇什么东西？\n");
  me = this_player();
  message_vision("$N使劲摇了摇桑树，叶子落了满地。\n", me);
  j = random(4);
  for (i = 0; i <= j; i++) {
    obj = new(__DIR__ "obj/sangye");
    obj->move(this_object());
  }
  if (++count1 > 5) {
    message_vision("突然一阵山风吹来，把满地的树叶和垃圾吹了个干净。\n", me);
    //把这个房间里的树叶清除！
    obj = find_object(File);
    inv = all_inventory(obj);
    i = sizeof(inv);
    while (i--)
      if (!living(inv[i]) && inv[i]->query_weight() < 20)
        destruct(inv[i]);
    count1 = 0;
    return 1;
  }
  if (random(5) > 3) {
    message_vision("$N蹲了下去翻了翻，居然翻了一串桑葚出来。\n", me);
    new(__DIR__ "obj/sangshen")->move(me);
  } else if (random(5) > 3) {
    if (me->query("gender") == "女性")
      message_vision("$N蹲下去翻了翻，突然一声尖叫，跳了起来。\n" +
        "原来地上爬着几条蚕呢。\n", me);
    else
      message_vision("$N蹲下去翻了翻，连有几条小虫爬上你的手臂都不知道。\n" +
        "不过你站起来一抖，又都掉下去了。\n", me);
    if (random(10) < 1) {
      if (count > 0) {
        obj = new(__DIR__ "npc/can2");
        count--;
      }
    } else
      obj = new(__DIR__ "npc/can1");
    obj->move(this_object());
  } else
    tell_object(me, "你什么也没摇下来！\n");
  return 1;
}
