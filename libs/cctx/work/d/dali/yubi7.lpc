// Room: /d/dali/yubi7.c
// By JackyBoy 98/12/5
#include <ansi.h>
inherit ROOM;
string *dir1 = ({ "north", "n", "south", "s", "east", "e", "west", "w", "southwest", "sw",
  "southeast", "se", "northeast", "ne", "northwest", "nw" });
string *dir2 = ({ "up", "u", "northup", "nu", "southup", "su", "eastup", "eu", "westup", "wu" });
string *dir3 = ({ "down", "d", "northdown", "nd", "southdown", "sd",
  "eastdown", "ed", "westdown", "wd" });
int count;
string look_here();
int go_up();
int go_self();
int go_down();

void create() {
  set("short", "湖底");
  set("long", (: look_here :));
  set("in_water", 1);
  count = 1;
  setup();
}

string look_here() {
  if (random(12) <= 1 && count > 0) {
    count--;
    new("/d/item/obj/gongdanmu")->move(this_object());
    message_vision("突然起了一股涌流，把水底的泥沙都抛了起来，眼前变了一片\n" +
      "黑暗，但是依稀看得到有一件说黄不黄，说白不白，略带光华\n" +
      "的东西也被激流冲了起来。\n", this_player());
    return "水里全是暗流激起来的泥沙，什么都看不清楚。\n";
  }
  switch (random(4)) {
    case 1:
      return "你现在正潜在水里，气已经憋了一会了。在水里你显得自由多了，
想去什么方向都可以。只是光线太暗了，什么都看不清楚。不时有什么
东西在你身边游了过去，也许是一条鱼吧，眼前仿佛有些亮亮的东西，
伸手去抓却又抓了个空。\n";
    case 2:
      return "你潜在水里，憋着气仔细寻找着，突然有一样东西从眼前滑过，你
伸手去抓，却什么也没抓到。\n";
    case 3:
      return "你憋着气在水里寻找着，不时有一条条小鱼从身边掠过，擦着你的
皮肤，痒痒的，你差点就憋不住了。\n";
    default:
      return "你正潜在水里，黑漆漆的，让人不禁打了个冷颤。\n";
  }

}

void init() {
  add_action("do_qian", "qian");
}

int do_qian(string dir) {
  if (!dir || dir == "")
    return notify_fail("你要往哪里潜？\n");
  if (member_array(dir, dir1) != -1)
    return go_self();
  if (member_array(dir, dir2) != -1)
    return go_up();
  if (member_array(dir, dir3) != -1)
    return go_down();
  if (dir == "shui" || dir == "water" || dir == "水")
    return notify_fail("你已经在水里了，要往什么方向潜？\n");
}

int go_up() {
  object me = this_player();
  message_vision("$N双手一划，直往水面游去。\n", me);
  me->move(__DIR__ "yubi6");
  message_vision("$N从下面游了上来，不知道下面有些什么东西。\n", me);
  return 1;
}
int go_self() {
  object me = this_player();
  message_vision("$N双手一划，游了开去。\n", me);
  me->move(__DIR__ "yubi7");
  message_vision("$N游了过来。\n", me);
  return 1;
}

int go_down() {
  object me = this_player();
  /*
	essage_vision("$N双手一划，往水更深处游去。\n",me);
	me->move(__DIR__"yubi7");
	message_vision("$N从上面潜了下来。\n",me);
*/
  tell_object(me, "你已经来到湖底了，难道不死心，想钻到泥巴里去找？\n");
  return 1;
}
