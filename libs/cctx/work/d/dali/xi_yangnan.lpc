inherit ROOM;

void create()
{
	set("short",  "阳南溪" );
	set("long", @LONG
这里是大理苍山十八溪的阳南溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰最南的斜阳峰，北边则是马耳峰。
LONG
);
	set("outdoors", "dali");

	set("exits", ([
		"southup" : __DIR__"froad1",
		"northup" : __DIR__"froad2",
	]));
	setup();
	replace_program(ROOM);
}
