#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIW "雪山" NOR );
        set("long", @LONG
你走走在茫茫的雪山群里，四面白雪皑皑，不见一草一木，寒风肆掠
飞雪扑面，十分寒冷，此地不是久留之地，应该速速离开才是，寒风吹来
你觉得又冷又饿。
LONG
        );
        set("outdoors", "dali");

        set("exits", ([
               "southdown" :__DIR__"hutiao10",
               "north"     :__DIR__"xueshan2",
                      ]));

             
        setup();
       //replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
	if ( (int)me->query("food") <= 0 && dir )
	{ me->set("food",0);
	  return notify_fail("你又冷又饿，实在是走不动了\n");
	}
	me->add("food",-10);
       return ::valid_leave(me, dir);
}