inherit ROOM;

void create() {
  set("short", "经玉溪");
  set("long", @LONG
这里是大理苍山十八溪的经玉溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的玉局峰，北边则是龙泉峰。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southup": __DIR__ "feng_yuju",
    "northup": __DIR__ "feng_longquan",
  ]));
  setup();
  replace_program(ROOM);
}
