#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "江边");
  set("long", @LONG
江水冲击岸边岩石的拍打声震耳欲聋，溅起的水花有时达几尺高。
小路又湿又滑，得小心点走，不要一不小心滑江里就完蛋了。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "south": __DIR__ "xroad14",
    "northwest": __DIR__ "xroad16",
  ]));
  setup();
  replace_program(ROOM);
}
