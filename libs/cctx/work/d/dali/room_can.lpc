inherit ROOM;

void create()
{
	set("short", "蚕丝铺");
	set("long", @LONG
这是大理远近闻名的生产蚕丝的店铺，据说是一个昆明的名门贵族
来开的。透过后面的木栅窗，可以看到很多蚕架摆在后院里。房间的角
落里稀疏地摆着几个破蚕架。
LONG
);
	set("exits",([
		"west" : __DIR__"nanjie3",
	]));
	set("objects",([
		__DIR__"npc/sanggu":1,
		__DIR__"obj/canjia":1,
	]));
	set("item_desc",([
		"can jia":"这几个蚕架虽然破点，但是一丝灰尘都没有，看来还可以养蚕呢！\n"+
			"只是这里的主人会允许吗？\n",
	]));
	setup();
}

