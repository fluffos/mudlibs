// Room: /d/dali/xroad24.c
// By JackyBoy 98/12/8
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "渡口");
  set("long", @LONG
这是一个渡口，有一只筏子停靠在岸边。船家却不见踪影，也许吆
喝(yell)一下他才会来。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "south": __DIR__ "xroad23",
  ]));
  setup();
}

void init() {
  add_action("do_yell", "yell");
}

int do_yell() {
  object me = this_player();
  message_vision("$N双手合在嘴边，大声吆喝到：船家！\n" +
    "只见一个船家匆匆忙忙地跑了过来，说：不好意思，让你久等了。\n" +
    "然后$N起脚踏上筏子。船家拿起竹竿，撑着筏子向对岸划去。\n", me);
  me->move(__DIR__ "fazi");
  call_out("go", 6, me);
}

void go(object me) {
  me->move(__DIR__ "xroad25");
  message_vision("$N坐着筏子靠岸了，浑身湿湿的，很是狼狈。\n", me);
}
