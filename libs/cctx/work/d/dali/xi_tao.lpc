inherit ROOM;

void create() {
  set("short", "桃溪");
  set("long", @LONG
这里是大理苍山十八溪的桃溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的中和峰，北边则是观音峰。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southup": __DIR__ "feng_zhonghe",
    "northup": __DIR__ "feng_guanyin",
  ]));
  setup();
  replace_program(ROOM);
}
