// /d/dali/datiepu.c
// jackyboy 98/11/11

inherit ROOM;
void create() {
  set("short", "打铁铺");
  set("long", @LONG
这是大理西街上的一家小打铁铺，铁匠杜普州露出浑身肌肉在火炉
旁使劲敲打着粗坯，马上就要做成一件武器了。江湖人士常常到他这里
买一些已经打造好了的兵器使用。也有的来这里给自己的兵器铸字。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "north": __DIR__ "xijie1",
  ]));
  set("objects", ([
    __DIR__ "npc/dutiejiang": 1
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  object ob;
  if (objectp(ob = me->query_temp("accept_weapon"))) {
    if (present("du tiejiang", environment(me))) {
      message_vision("杜铁匠一看$N要走，急忙叫道：这位" + RANK_D->query_respect(me)
        + "慢走！你的兵器，说罢把" + ob->query("name") + "交给了$N。\n", me);
      ob->move(me);
      me->delete_temp("accept_weapon");
    }
    /*如果du tiejiang不存在了，那么accept_weapon也变为0了，所以这段程序多余
		else
		{
			message_vision("$N皱了皱眉：这杜铁匠哪去了？反正给了他的兵器也不值多少钱，"+
				"走了算了。\n",me);
			me->delete_temp("accept_weapon");
			destruct(ob);
		}
*/

  }
  if (me->query_temp("pay_zhuzi") == 1) {
    message_vision("$N叹了一声，那点小钱，就当施舍了算了。\n" +
      "其实心里却是心疼得很。\n", me);
    me->delete_temp("pay_zhuzi");
  }
  me->delete_temp("zhu_modify");
  return 1;
}
