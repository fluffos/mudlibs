// Room: /d/dali/sroad7.c
// By JackyBoy 98/12/2

inherit ROOM;

void create() {
  set("short", "悬崖底");
  set("long", @LONG
到了悬崖底了，只有一条野藤悬挂在悬崖上，藤蔓被磨得光滑可能
有很多人抓(zhua)着它爬上悬崖呢。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "south": __DIR__ "sroad8",
  ]));
  setup();
}

void init() {
  add_action("do_zhua", "zhua");
}

int do_zhua(string arg) {
  if (arg != "teng" && arg != "藤")
    return notify_fail("你想抓什么东西啊？\n");
  message_vision("$N一把抓住野藤，一口气爬上悬崖了。\n", this_player());
  this_player()->move(__DIR__ "sroad6");
  return 1;
}
