#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIY "天下第一湾" NOR );
        set("long", @LONG
你来到了天下第一湾，奔腾的江水由北往南而流下来，到此
却来了一个一百八十度的大转弯，由南向北流去，水流冲击之下
形成了一个巨大的沙湾，故有天下第一湾之美誉。
LONG
        );
        set("outdoors", "dali");

        set("exits", ([
               "northwest" :__DIR__"hutiao6",
               "north"     :__DIR__"hutiao4",
                      ]));

             
        setup();
        replace_program(ROOM);
}
