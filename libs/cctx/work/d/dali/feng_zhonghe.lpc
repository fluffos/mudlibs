inherit ROOM;

void create() {
  set("short", "中和峰");
  set("long", @LONG
这里是大理苍山十九峰中和峰的山顶，南北两边各有一条小溪喧闹
着向山下流去，正是苍山十八溪之一的中溪和桃溪。往东透过缠绕在山
腰的一条条乳白色的玉带云，可以看到山脚的大理城以及宽阔的洱海。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southdown": __DIR__ "xi_zhong",
    "northdown": __DIR__ "xi_tao",
  ]));
  setup();
}
