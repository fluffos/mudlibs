// Room: /d/dali/yubi3.c
// By JackyBoy 98/12/3
#include <ansi.h>
inherit ROOM;
int count;
void create() {
  set("short", "无名湖边");
  set("long", @LONG
这是一潭湖水，由于没有风，显得风平浪静的，只是不适会有树叶
轻轻地飘到湖面上，荡起一丝波纹。两旁的峭壁上长满了各种树木，其
中有一种灌木(tree)上结满了无数红黑色的浆果。湖水那么干净，也许
喝上它一口大概不妨。
LONG
  );
  set("outdoors", "dali");
  set("resource/water", 1);
  set("item_desc", ([
    "tree": "这种浆果看起来很象云南特产的“救军粮果(guo)”，也许可以摘" +
    "(zhai)下来吃。\n",
  ]));
  count = 5;
  set("exits", ([
    "south": __DIR__ "yubi2",
  ]));
  setup();
}

void init() {
  count++;
  if (count > (random(5) + 5))
    count = 0;
  add_action("do_zhai", "zhai");
  add_action("do_drink", "he");
  if (this_player()->query_temp("from_water") == 1)
    add_action("do_jump", "jump");
}

int valid_leave(object me, object dir) {
  me->delete_temp("from_water");
  return ::valid_leave(me, dir);
}

int do_drink(string arg) {
  object me;
  me = this_player();
  if (!arg || (arg != "water" && arg != "shui" && arg != "水"))
    return notify_fail("你要喝什么东西？\n");
  me->add("water", 100);
  if (me->query("water") > me->max_water_capacity())
    me->set("water", me->max_water_capacity() + 20);
  message_vision("$N爬到湖边，咕噜咕噜地喝了几大口水。\n", me);
  if (random(3) >= 2) {
    tell_object(me, "你看到湖水里似乎有什么东西亮亮的，飘忽不定...真想" +
      "跳(jump)进去看看。\n"
      +RED "糟糕，湖水好象有些异常地甜。看来是中毒了。\n" NOR);
    me->unconcious();
    add_action("do_jump", "jump");
  }
  return 1;
}

int do_jump(string arg) {
  object me = this_player();
  if (!arg || (arg != "shui" && arg != "水" && arg != "water"))
    return notify_fail("你要往什么里面跳？\n");
  message_vision("$N扑通一声跳进水里了。看样子是发了疯了！\n", me);
  me->move(__DIR__ "yubi4");
  message_vision("$N跳了进来，平静的水面上溅起一圈圈波纹，慢慢地扩散开去...\n", me);
  return 1;
}

int do_zhai(string arg) {
  if (!arg || (arg != "guo" && arg != "jiangguo"))
    return notify_fail("你要摘什么？\n");
  if (count <= 0)
    return notify_fail("都已经被摘完了，你还想连叶子都摘去？\n");
  count--;
  message_vision("$N从树上摘了一些浆果下来。\n", this_player());
  new(__DIR__ "obj/jiangguo")->move(this_player());
  return 1;
}
