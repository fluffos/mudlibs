inherit ROOM;

void create() {
  set("short", "葶溟溪");
  set("long", @LONG
这里是大理苍山十八溪的葶溟溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的马耳峰，北边则是佛顶峰。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southup": __DIR__ "feng_maer",
    "northup": __DIR__ "feng_foding",
  ]));
  setup();
  replace_program(ROOM);
}
