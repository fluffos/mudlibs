// /d/dali/obj/sangshen.c 桑葚
inherit F_FOOD;
inherit ITEM;
void create() {
  set_name("桑葚", ({ "sangshen", "sang", "shen" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "黑黝黝的桑葚，看来是熟透了，让人看得直流口水。\n");
    set("unit", "串");
    set("value", 10);
    set("food_remaining", 4);
    set("food_supply", 20);
    set("material", "unknow");
  }
  setup();
}
