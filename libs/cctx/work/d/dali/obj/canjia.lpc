// /d/dali/obj/canjia.c 蚕架

#include <ansi.h>

inherit ITEM;

int using;//不能两人同时养！
object me;
int is_container()
{
	return 0;
}

void create()
{
	set_name("蚕架", ({ "can jia", "jia" }) );
	set_weight(30000);
	set_max_encumbrance(0);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		//long描述要改为函数！
		set("long", "这是一个常见的蚕架，虽然有些破烂，但看起来还是可以"+
			"用来养蚕(yang)的。\n");
		set("value", 1000);
		set("material", "wood");
		set("no_get",1);
		set("no_drop",1);
		set("amount",30);
	}
	using=0;
	setup();
}

void init()
{
	object me = this_player();
	add_action("do_yang", "yang");
	//看来要加个put来屏蔽系统的put命令！
}

int do_yang(string arg)
{
	object ob;
	string str;
	int i=0;
	me=this_player();
	if(arg==""||!arg)
		return notify_fail("你要养什么？\n");
	if(me->query_temp("ask_flag")!=1)
		return notify_fail("人家准你养了么？也不问问主人就这样子，真没礼貌！\n");
	if(!objectp(present(arg,me)))
		return notify_fail("你又没有蚕！？\n");
		//notify_fail("你要养什么？这里只能养蚕的哟。\n");
	if (using==1)
		return notify_fail("前一批蚕还没养好哟，别着急，稍等一会吧！\n");
	using=1;
	while (objectp(ob=present(arg,me)))
	{
		if(ob->query("name")=="蚕")
		{
			if(base_name(ob)=="/d/dali/npc/can2")
				str="\\d\\dali\\obj\\canjian1";
			else
				str="\\d\\dali\\obj\\canjian2";//普通蚕茧
		}
		else
		{
			str="\\d\\dali\\obj\\canjian1";
			//天蚕茧，并暴露其是特殊蚕茧！还没实现！
		}
		set("can/canjian"+i,str);
		i++;
		destruct(ob);
		//可以不要room_can1,而改为使用一个mapping来记录。
	}
	remove_call_out("step1");
	call_out("step1",4,this_object());
	message_vision("$N小心翼翼地把蚕放到蚕架上。\n",me);
	me->delete_temp("ask_flag");
	return 1;
}

void step1(object ob)
{
	message_vision("\n只见蚕架上的蚕摇了摇头，慢慢地爬到隐蔽的地方去了。\n",ob);
	remove_call_out("step2");
	call_out("step2",4,ob);
}
void step2(object ob)
{
	message_vision("\n再仔细一看，蚕架上似乎有些白亮的丝线，原来蚕已经开始吐丝做茧了。\n",ob);
	remove_call_out("step3");
	call_out("step3",4,ob);
}
void step3(object ob)
{
	object obj;
	int i;
	string str,*terms;
	mapping inv;
	using=0;
	i=0;
	str="";
	if(!objectp(obj=present("sang gu",environment(ob))))
	{
		message_vision("\n蚕已经做好蚕茧了，可是太难拿了，又没有桑姑帮忙，"+
			"看来是白养了。\n",me);
		inv=ob->query("can");
		terms=keys(inv);
		for(i=0;i<sizeof(terms);i++)
		{
			str=replace_string(ob->query("can/"+terms[i]),"\\","/");
			message_vision(terms[i]+"->"+str+"\n",me);
			ob->delete("can/"+terms[i]);
		}
		return;
	}
	if(environment(me)!=environment(obj))
		message_vision("\n蚕已经做好蚕茧了，可是蚕茧的主人不在了，$N把它收了起来。\n",obj);
	message_vision("\n蚕已经做好蚕茧了，桑姑灵巧地帮$N把蚕茧取了出来。\n",me);
	inv=ob->query("can");
	terms=keys(inv);
	for(i=0;i<sizeof(terms);i++)
	{
		str=replace_string(ob->query("can/"+terms[i]),"\\","/");
		obj=new(str);
		obj->move(me);
		ob->delete("can/"+terms[i]);
	}
	return;
}
