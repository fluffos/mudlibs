// jiangguo.c 救军粮果

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("救军粮果", ({"jiang guo","guo"}));
	set_weight(20);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是无量山上盛产的浆果。\n");
		set("unit", "些");
		set("value", 50);
		set("food_remaining", 3);
		set("food_supply", 30);
	}
}
