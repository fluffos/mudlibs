// /d/dali/obj/sangye.c 桑叶
inherit ITEM;
void create()
{
	set_name("桑叶", ({ "sangye", "yezi" , "ye"}) );
	set_weight(5);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "被蚕吃出了好多洞的桑叶，差不多只剩叶脉了。\n");
		set("unit", "片");
		set("value", 1);
		set("material", "wood");
	}
	setup();
}
