// /d/dali/obj/canjian1.c

inherit ITEM;

string look_canjian();
int change_flag;
void create() {
  set_name("蚕茧", ({ "can jian", "canjian", "jian" }));
  set("long", (: look_canjian :));
  set("value", 100000);
  set("unit", "个");
  change_flag = 0;
  setup();
}

void change() {
  change_flag = 1;
  set_temp("tiancan", 1);
  set_name("天蚕茧", ({ "tiancan jian", "jian", "canjian" }));
}

string look_canjian() {
  if (random(10) > 8 || change_flag == 1) {
    change();
    return "这只蚕茧有些透明，又带点绿色，很是古怪！正是传说中的天蚕茧。\n";
  }
  return "这是一只蚕茧，可以拿去加工后做成蚕丝，用来做衣服的哟。\n";
}
