#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("丝绸衣服", ({ "si cloth", "cloth" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这件丝绸衣服看上去特别华丽耀眼，看来只有有钱人才穿得起哟。\n");
		set("unit", "件");
		set("value", 2000);
		set("material", "丝");
		set("armor_prop/armor", 1);
		set("armor_prop/personality", 3);
	}
	setup();
}

