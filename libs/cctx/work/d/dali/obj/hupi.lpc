// goupi.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("虎皮", ({ "hu pi", "pi" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("material", "fur");
		set("value", 20000);
                set("armor_prop/armor", 1);
        }
        setup();
}

