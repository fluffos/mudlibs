// sherou.c 蛇肉

inherit F_FOOD;
inherit ITEM;

void create()
{
	set_name("蛇肉", ({ "she rou", "rou" }) );
        set_weight(350);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "一块血淋淋的蛇肉，吃了对身体可能大有好处哟。\n");
		set("unit", "块");
		set("value", 50);
		set("food_remaining", 3);
		set("food_supply", 20);
        }
    setup();
}

