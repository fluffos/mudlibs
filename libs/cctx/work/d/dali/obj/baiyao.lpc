// /d/dali/obj/baiyao.c 云南白药
// JackyBoy @ cctx 98/11/10
inherit ITEM;
inherit F_PILL;
string desc();
void setup() {}
void create() {
  set_name("云南白药", ({ "bai yao", "yao", "baiyao", "bai" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("long", (: desc() :));
    set("value", 30000);
  }
  setup();
}

void init() {
  add_action("do_use", "use");
  add_action("do_use", "yong");
  add_action("do_chi", "chi");
  add_action("do_chi", "eat");
}

string desc() {
  return "这是一包在云南普遍流传的神药，可外敷(use/yong)，也可内服(chi/eat)。
外敷可以恢复你的气到有效值，内服可以恢复你的有效值到最大！";
}

int do_chi(string arg) {
  if (!arg)
    return 0;
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");
  if ((int)this_player()->query("eff_qi") ==
    (int)this_player()->query("max_qi"))
    return notify_fail("你现在不需要吃白药。\n");
  else {
    //this_player()->receive_curing("qi", 50);
    this_player()->set("eff_qi", this_player()->query("max_qi"));
    message_vision("$N吃下一包白药，气色看起来好多了。\n", this_player());
    destruct(this_object());
    return 1;
  }
}

int do_use(string arg) {
  if (!id(arg))
    return notify_fail("你要敷什么药？\n");
  if ((int)this_player()->query("qi") ==
    (int)this_player()->query("eff_qi"))
    return notify_fail("你现在不需要用白药。\n");
  else {
    this_player()->set("qi", this_player()->query("eff_qi"));
    message_vision("$N敷上一包白药，伤口很快就愈合了。\n", this_player());
    destruct(this_object());
    return 1;
  }
}
