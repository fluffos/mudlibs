// rushang.c 

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("乳扇", ({"rushang", "rushang"}));
	set_weight(40);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一块香喷喷的乳扇，你不禁流了一滩口水。\n");
		set("unit", "块");
		set("value", 40);
		set("food_remaining", 1);
		set("food_supply", 50);
	}
}
