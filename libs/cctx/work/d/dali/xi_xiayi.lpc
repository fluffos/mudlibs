inherit ROOM;

void create()
{
	set("short",  "霞移溪" );
	set("long", @LONG
这里是大理苍山十八溪最北的霞移溪，溪水清澈透底，正哗哗地流
向山下注入洱海，南边抬头就是十九峰之一的沧浪峰，北边是云弄峰。
LONG
);
	set("outdoors", "dali");

	set("exits", ([
		"southup" : __DIR__"feng_canglang",
		"northup" : __DIR__"feng_yunnong",
	]));
	setup();
	replace_program(ROOM);
}
