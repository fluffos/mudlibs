#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", HIG "书院" NOR );
	set("long", @LONG
这是一间小书院，屋子中间整整齐齐的摆了几张课桌，椅子，一位书
生正在解答疑问，墙上挂了写字画，写的大概意思就是勉励大家努力学习
学而为用。门边有一块木牌(paizi)，写着几行小字。
LONG
	);
	set("exits", ([
		"south" :__DIR__"xijie",
	]));
	set("objects",([
		"/kungfu/class/dali/zhu":1,
	]));
	set("item_desc",([
		"paizi" : WHT"教天下人识天下字"NOR+
			"\n欲读书识字者请交黄金二百两,一次付清！\n",
	]));
	setup();
	replace_program(ROOM);
}

