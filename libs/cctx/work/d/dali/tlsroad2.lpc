{
	set("short", "崇圣寺门前小院");
	set("long", @LONG
这是一条铺着大理石的小院，几棵古树(tree)下还放了几个石凳，
北边就是崇圣寺的大门。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
		"south" : __DIR__"tianlongsi/damen",
		"eastdown" : __DIR__"tlsroad1",
	]));
