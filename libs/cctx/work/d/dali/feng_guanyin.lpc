inherit ROOM;

void create() {
  set("short", "观音峰");
  set("long", @LONG
这里是大理苍山十九峰观音峰的山顶，南北两边各有一条小溪喧闹
着向山下流去，正是苍山十八溪之一的梅溪和桃溪。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southdown": __DIR__ "xi_tao",
    "northdown": __DIR__ "xi_mei",
  ]));
  setup();
  replace_program(ROOM);
}
