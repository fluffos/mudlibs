// /d/dali/board/baodian_b.c

inherit BULLETIN_BOARD;

void create() {
  set_name("天龙寺留言板", ({ "board" }));
  set("location", "/d/dali/tianlongsi/baodian");
  set("board_id", "tianlongsi_board");
  set("long",
    "请别灌水。\n");
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
