// Room: /d/dali/yubi2.c
// By JackyBoy 98/12/3
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "悬崖底");
	set("long", @LONG
这里是无量玉壁的悬崖底，无论外面是什么季节，这里总是一样的
寒冷。一天可能也就几个小时可以见到太阳，大部分时间还是靠石壁的
反射把这个深谷照亮的。顺着谷底往北走可以听到水声，去看看吧！
LONG
);
	set("outdoors","dali");
	set("exits",([
		"north" : __DIR__"yubi3",
	]));
	setup();
}

void init()
{
	add_action("do_pa","pa");
}

int do_pa(string arg)
{
	if(!arg||arg!="悬崖")
		return notify_fail("你要爬什么呀？\n");
	if(random(11>4))
	{
		message_vision("$N裹了一下手袖，抬腿想爬上悬崖，没想到上面的青苔太多了，\n"+
			"一下子跌了个狗吃食。\n",this_player());
		return notify_fail("你爬起来拍了拍泥土，好象没受什么伤。\n");
	}
	message_vision("$N手脚麻利地往悬崖顶爬去。\n",this_player());
	this_player()->move(__DIR__"yubi1");
	message_vision("$N终于从悬崖底爬了上来，长长的舒了一口气。\n",this_player());
	return 1;
}
