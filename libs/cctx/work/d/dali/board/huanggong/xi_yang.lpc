inherit ROOM;

void create() {
  set("short", "阳溪");
  set("long", @LONG
这里是大理苍山十八溪的阳溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的莲花峰，北边则是五台峰。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "southup": __DIR__ "feng_lianhua",
    "northup": __DIR__ "feng_wutai",
  ]));
  setup();
  replace_program(ROOM);
}
