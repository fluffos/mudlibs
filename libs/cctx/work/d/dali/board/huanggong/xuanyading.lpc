// /d/dali/xuanyading
// netkill /98/8/14/

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIR "悬崖顶" NOR);
  set("long", @LONG
这里是悬崖顶，向下看去，深不见底，鸟儿从你的脚下飞过，
左边有几条粗大的蔓藤(teng),耳听得远出山猿啸声，你真想变
做只猴子爬下去。
LONG
  );
  set("outdoors", "dali");

  set("exits", ([
    "west": __DIR__ "shanmai1",
  ]));
  set("item_desc", ([
    "teng": HIY " 一条大树藤，一直通到底。\n\n" NOR,
  ]));

  setup();

}
void init() {
  add_action("do_enter", "zhua");
  UPDATE_D->check_user(this_player());
}


int do_enter(string arg) {
  object me;
  me = this_player();

  if (!arg || arg == "") return 0;

  if (arg == "teng") {
    message("vinson", HIY "你眼睛一闭，抓住树藤，滑了下去。\n\n" NOR, this_player());

    me->move(__DIR__ "xuanya1");

    return 1;
  }
}
