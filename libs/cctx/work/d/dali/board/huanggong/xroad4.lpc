#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "峭壁");
  set("long", @LONG
小路到了这里特别窄，旁边是怪石林立的峭壁，如果一不小心跌了
下去，就die hard了，所以请你小心点啊。
LONG
  );
  set("outdoors", "dali");
  set("exits", ([
    "northdown": __DIR__ "xroad5",
    "eastup": __DIR__ "xroad3",
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  int i;
  i = me->query_skill("dodge", 1) * 10;
  if (i < 10)
    i = 50;
  i = random(i);
  if ((i != 0 && i < 7) || me->query("test_player") == 1) {
    message_vision("$N脚下一不小心，踩了个空，身子一歪就从峭壁上跌了下去。\n", me);
    me->set_temp("diemsg", "不小心从峭壁跌了下去，摔死了");
    me->die();
    return 0;
  }
  return ::valid_leave(me, dir);
}
