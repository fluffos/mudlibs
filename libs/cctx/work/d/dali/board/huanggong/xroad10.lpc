#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "断崖底");
	set("long", @LONG
爬上这个断崖后，小路直通无量山的最高峰——猫头山。旁边是行
人借助其来上下的藤篮，平常你只要付给一旁的小工一些钱，他就会帮
你上下了。
LONG
);
	set("outdoors","dali");
	set("exits",([
		"northwest" : __DIR__"xroad11",
	]));
	set("objects",([
		__DIR__"npc/xiaogong":1,
	]));
	set("go_room",__DIR__"xroad9");
	//决定藤篮送player到的房间
	setup();
}

int valid_leave(object who,string dir)
{
	if(who->query("pay_flag")==1
		&&objectp(present("xiao gong",this_object())) )
		message_vision("小工对着$N奇怪地说：怎么给了钱又不走了？真是瓜娃子！\n",who);
	who->delete_temp("pay_flag");
	return ::valid_leave(who,dir);
}

