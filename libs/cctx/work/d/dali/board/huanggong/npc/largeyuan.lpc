inherit ROOM;

void create()
{
        set("short", "大花园");
        set("long", @LONG
这是一个很幽静的花园，走进来眼前突然一亮，园中有一个池塘(water),
池塘中间有一座假山，假山上有一首提诗，写着刘禹锡的”杨柳青青江水平，
闻郎江上唱歌声。东边日出西边雨，道是无情还有情。”池塘里开满了睡莲，
一群群的鱼儿游来游去，园中四周种满了斑竹，偶尔一阵微风吹来，竹子随
风摇曳，发出沙沙的声音。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "west" : __DIR__"keting.lpc",
  "north" : __DIR__"shufang",
  "east" : __DIR__"woshi.lpc",
  "south" : __DIR__"kefang",
]));
        set("no_clean_up", 0);
        set("flower_count", 3);
        set("item_desc", ([ /* sizeof() == 1 */
  "water" : "满塘荷花随风摇曳,不知可否摘(zai)一朵!
",
]));

        setup();
}
void init()
{
        add_action("do_zai", "zai");
}
int do_zai(string arg)
{
        object me = this_player();
        if(query("flower_count") < 1)     return notify_fail("睡莲已经被人采光了。\n");
        if(present("flower", me) )
                return notify_fail("你这个人怎么这么贪心的？都已经有了还想再要？\n");
        if(random(5) || random(me->query_dex()) < 10) {
         message_vision("$N急不可待的纵身一跃，突然伸手朝荷花抓去，\n"
         "小花被风一吹,躲开了$N的手。\n"
             "$N一个不稳,差点跌倒在池塘里。\n", me);
                return 1;
        }
        add("flower_count", -1);
        message_vision("$N用尽平生一力,猛的向上一窜，\n"
       "终于摘到一朵淡紫色的荷花！\n",me);
        new("/open/playhouse/flower")->move(me);
        return 1;
}
