inherit ROOM;

void create()
{
        set("short", "走廊");
        set("long", @LONG
这里是正德殿与东内宫之间的一条走廊，两旁玉柱雕栏衬得这条
白石铺成得小廊格外清净，雅致。长廊外是一个小池，池里游鱼晶莹
剔透，池中央一座假山上一条涓涓细流注入池中，好一幅山水田园图。
LONG
        );
        set("no_clean_up", 0);
       set("exits", ([
 "east" : __DIR__"guangchang",
 "south" : __DIR__"zoulang4",
 "west" : __DIR__"zhengde", 
     ]));
        setup();
}
