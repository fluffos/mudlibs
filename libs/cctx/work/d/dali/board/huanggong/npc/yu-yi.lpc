inherit NPC;
inherit F_MASTER;

string ask_me();

void create() {
  set_name("御医", ({ "yu yi", "yi" }));
  set("title", "大理医仙");
  set("gender", "男性");
  set("age", 90);
  set("long",
    "这是一个医术高明老者，看上去一副世外仙人气派。\n");

  set("attitude", "peaceful");
  set("combat_exp", 1000000);
  set("score", 200000);

  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("cps", 30);
  set("con", 30);

  set("max_qi", 4000);
  set("max_jing", 2000);
  set("neili", 4000);
  set("max_neili", 2000);
  set("jiali", 100);

  create_family("大理皇宫", 35, "弟子");
  assign_apprentice("弟子", 0);

  set_skill("force", 250);
  set_skill("whip", 250);
  set_skill("parry", 250);
  set_skill("dodge", 250);
  set_skill("sword", 250);
  set_skill("unarmed", 250);

  set_skill("hunyuan-yiqi", 250);
  set_skill("riyue-bian", 250);
  set_skill("shaolin-shenfa", 250);

  map_skill("force", "hunyuan-yiqi");
  map_skill("whip", "riyue-bian");
  map_skill("parry", "riyue-bian");
  map_skill("dodge", "shaolin-shenfa");

  set("inquiry", ([
    "还魂丹": (: ask_me :),
  ]));

  set("count", random(10) - 8);

  setup();

  carry_object("/d/shaolin/obj/changbian")->wield();
}

void init() {
  object me, ob;
  mapping fam;

  me = this_player();
  ob = this_object();

  ::init();
  if (interactive(me) && base_name(environment()) == query("startroom")) {
    if (mapp(fam = me->query("family")) && fam["family_name"] == "大理皇宫"
      && fam["generation"] == 36) return;

    if (mapp(fam = me->query("family")) && fam["family_name"] == "大理皇宫"
      && fam["generation"] > 36
      && me->query("kee") < 50) {
      me->move("/d/dali/huanggong/gongmen");
      me->unconcious();
      return;
    }

    COMBAT_D->do_attack(ob, me, query_temp("weapon"));

    me->set_temp("fighter", 1);

    ob->fight_ob(me);
    me->fight_ob(ob);

    call_out("halt", 10);

    return;
  }

  return;
}

void halt() {
  command("halt");
}

string ask_me() {
  mapping fam;
  object ob;

  if (base_name(environment()) != query("startroom"))
    return 0;

  if (!this_player()->query_temp("fighter")
    || this_player()->query("family/family_name") != "大理皇宫"
    || this_player()->query("combat_exp") < 5000) {
    command("say 大胆鼠辈，乳臭未干，竟敢偷入皇宫御药房！");
    this_object()->kill_ob(this_player());
    this_player()->kill_ob(this_object());
  }

  if (present("dan", this_player()))
    return RANK_D->query_respect(this_player()) + "还魂丹只有一颗，而且就在你身上，真是贪得无餍！";

  if (present("dan", environment()))
    return RANK_D->query_respect(this_player()) + "还魂丹只有一颗，而且就在这里任你取走，真是贪得无餍！";

  if (query("count") < 1)
    return "还魂丹乃天地之灵物，采集艰难无比，我这里现在可没有。";

  ob = new(__DIR__ "obj/dan");
  ob->move(this_player());

  add("count", -1);

  message_vision("\n御医惨然一笑，接着长叹一声，从墙洞里取出个白玉磁瓶，倒出还魂丹递给$N。\n\n", this_player());

  return "我等昔年于佛祖座前发下宏愿，每十年遍访名山大川，历尽艰险，\n" +
    "方采得数颗还魂丹，君乃有缘人，能得此造化奇物，望好自为之！";
}
