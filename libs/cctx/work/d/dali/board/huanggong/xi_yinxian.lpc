inherit ROOM;

void create()
{
	set("short",  "隐仙溪" );
	set("long", @LONG
这里是大理苍山十八溪的隐仙溪，溪水清澈透底，正哗哗地流向山
下注入洱海，南边抬头就是十九峰之一的应乐峰，北边则是雪人峰。
LONG
);
	set("outdoors", "dali");

	set("exits", ([
		"southup" : __DIR__"feng_yingle",
		"northup" : __DIR__"feng_xueren",
	]));
	setup();
	replace_program(ROOM);
}

