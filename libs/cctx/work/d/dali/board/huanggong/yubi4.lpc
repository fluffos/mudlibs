// Room: /d/dali/yubi4.c
// By JackyBoy 98/12/4
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "无名湖湖面");
  set("long", @LONG
这里是无名湖湖面，你不停地踩着水，一边仔细观察水中的那些亮
闪亮闪的东西是什么。不过你一点都看不清楚，不如捞(lao)起来看看。
最好别在这里呆久了，差不多了还是爬(pa)上岸呆着好点，不然迟早要
累坏溺死了的。
LONG
  );
  set("outdoors", "dali");
  setup();
}

void init() {
  this_player()->set_temp("from_water", 1);
  add_action("do_lao", "lao");
  add_action("do_pa", "pa");
  add_action("do_qian", "qian");
  add_action("do_qian", "潜");
}

int do_qian(string arg) {
  object me = this_player();
  if (!arg || (arg != "shui" && arg != "水" && arg != "water" && arg != "down"))
    return notify_fail("你要潜到哪里去？\n");
  message_vision("$N腰一弯，一个猛子就扎到水里去了。\n", me);
  me->move(__DIR__ "yubi5");
  message_vision("$N从水面扎猛子进来了。\n", me);
  call_out("check_player0", 10, me);
  return 1;
}

void check_player0(object me) {
  if (environment(me)->query("in_water") != 1)
    return;
  tell_object(me, "你已经在水里呆了" + BLINK HIY "10" NOR +
    "多秒了，不要呆久了，担心被溺死了的！\n");
  call_out("check_player1", 10, me);
}

void check_player1(object me) {
  if (environment(me)->query("in_water") != 1)
    return;
  tell_object(me, "你已经在水里呆了" + BLINK HIY "20" NOR +
    "多秒了，不要呆久了，担心被溺死了的！\n");
  call_out("check_player2", 10, me);
}

void check_player2(object me) {
  if (environment(me)->query("in_water") != 1)
    return;
  tell_object(me, "你已经在水里呆了" + BLINK HIY "半分钟" NOR +
    "了，已经够久了，不要被溺死了！\n");
  call_out("check_player3", 10, me);
}

void check_player3(object me) {
  if (environment(me)->query("in_water") != 1)
    return;
  tell_object(me, "你已经在水里呆了" + BLINK HIY "40" NOR + "多秒了，" +
    HIG "已经快到人的极限了！\n" NOR);
  call_out("check_player4", 10, me);
}

void check_player4(object me) {
  if (environment(me)->query("in_water") != 1)
    return;
  tell_object(me, "你突然觉得再也憋不住了，嘴巴一张，顿时湖水灌了进来！\n" +
    "你挣扎着沉向水的深处，恍惚中，驰骋江湖的一幕幕又再现眼前...\n" +
    "然后越来越模糊了...\n");
  me->set_temp("diemsg", "被湖水呛死了");
  me->die();
}

int do_pa() {
  object me = this_player();
  message_vision("$N划了几下水，往岸边游去...\n", me);
  me->move(__DIR__ "yubi3");
  message_vision("$N水淋淋地爬上岸了。\n", me);
  return 1;
}

int do_lao() {
  object me = this_player();
  tell_object(me, NOR "你把手伸进水里捞了捞，可是什么都捞不起来，那些亮闪闪的东西\n" +
    "依然在水里飘来飘去。水底黑黑的，那些亮亮的东西直往下沉，不\n" +
    "知道" + HIY "潜" NOR + "到水里能不能捞到。\n");
  return 1;
}
