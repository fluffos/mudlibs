inherit ROOM;

void create()
{
	set("short", "宝芝林药铺");
	set("long", @LONG
这是一家广东佛山黄飞鸿开的分店，一股浓浓的药味让你几欲窒息，
那是从药柜上的几百个小抽屉里散发出来的。老板坐在茶几旁，独自喝
着茶，看也不看你一眼。一名小伙计站在柜台后招呼着顾客。柜台上贴
着一张发黄的广告(guanggao)。
LONG
	);
	set("item_desc", ([
		"guanggao" : "本店出售以下药品：
金创药：\t五十两白银
养精丹：\t二十两白银
白药：  \t六十两白银
其他神药与老板面议。\n",
	]));
	set("objects", ([
		__DIR__"npc/huoji" : 1,
	]));

	set("exits", ([
		"west" : __DIR__"nanjie2",
	]));

	setup();
	replace_program(ROOM);
}

