inherit ROOM;

void create() {
  set("short", "大钟寺");
  set("long", @LONG
这是一座古老的庙宇。有一个诺大的庭院，院子里是棵百年
参天大榕树，庭院中央是一个大香鼎，终年香火缭绕，四季不断
，往里是间佛堂，门上书几个朱红大字："大钟寺"。东边通往西
北大街。
LONG
  );


  set("exits", ([
    "east": __DIR__ "xbstreet3",
    "enter": __DIR__ "fotang",
    "south": __DIR__ "xidajie",
  ]));
  set("objects", ([
    __DIR__ "npc/youke": 1,
    __DIR__ "npc/youke2": 1,

  ]));
  setup();
  replace_program(ROOM);
}
