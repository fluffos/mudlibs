  set("short", "南门大街");
  set("long", @LONG
这里是北京城的南门大街，比较繁华，地上铺着光洁的青
石板，街道的两旁是成荫的杨柳树。北面是御林军的军营，南
面是一个牲口屠宰场。东面就是繁华的南广场。
LONG

  );
  set("outdoors", "city2");


  set("exits", ([
    "east": __DIR__ "nmguangchang",
    "west": __DIR__ "nmdajie1",
    "north": __DIR__ "bingyin",
    "south": __DIR__ "tuzai",
  ]));
  setup();
