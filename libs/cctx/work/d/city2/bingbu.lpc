inherit ROOM;

void create() {
  set("short", "兵部大门");
  set("long", @LONG
这里是兵部的大门，门口站着几个持枪佩刀的衙役，看起
来威风凛凛，没事最好别在这里吓闯。
LONG

  );

  set("exits", ([

    "north": __DIR__ "nmdajie1",
    "south": __DIR__ "bingbu1",

  ]));
  set("objects", ([
    "/d/city/npc/yayi": 4,
  ]));
  setup();

}

int valid_leave(object me, string dir) {
  if (objectp(present("ya yi", environment(me))) && dir == "south")
    return notify_fail("衙役喝道：“威……武……。”\n");
  return ::valid_leave(me, dir);
}
