inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIW "神武门" NOR);
  set("long", @LONG
这里是神武门，由于是皇帝和官员门的专用大道，一般百
姓不敢在这里随便乱闯，所以显得十分冷清。南面可以看到故
宫的大门，北面是总府路。
LONG

  );
  set("outdoors", "city2");

  set("exits", ([
    "east": __DIR__ "yuanmen",
    //	"west" : __DIR__"xiguangchang",
    "north": __DIR__ "zongfu",
    "south": __DIR__ "gugong",
  ]));
  setup();
  replace_program(ROOM);
}
