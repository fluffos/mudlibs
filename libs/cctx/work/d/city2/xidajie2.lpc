inherit ROOM;

void create() {
  set("short", "西大街");
  set("long", @LONG
这里是北京城的西大街，比较清静，外地来的客商，进京
赶考的秀才多喜爱在这段路来住店饮食。街道的两旁是成荫的
杨柳树。西面是传来叮叮当当的打铁声，东面是明胜“玉渊潭”。
LONG

  );
  set("outdoors", "city2");


  set("exits", ([
    "east": __DIR__ "yuyuantan",
    "west": __DIR__ "datiepu",
    "north": __DIR__ "xidajie",
    "south": __DIR__ "jxdajie1",
  ]));
  setup();
}
