inherit ROOM;

void create() {
  set("short", "卢沟桥");
  set("long", @LONG
你走在一座古老的石桥上。四周人来人往。挑担子的、行商
的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热闹。
不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两
旁是整整齐齐的杨树林。东面就是北京城的西城门了。
LONG
  );

  set("exits", ([
    "west": __DIR__ "wroad2",
    "east": __DIR__ "ximen",
  ]));

  set("outdoors", "city2");
  setup();
  replace_program(ROOM);
}
