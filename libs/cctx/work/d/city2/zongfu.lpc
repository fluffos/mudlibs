inherit ROOM;

void create() {
  set("short", "总府路");
  set("long", @LONG
这里是总府路，宽旷的大道两旁是成荫的杨柳林，不过由
于这里是皇帝和官员门的专用大道，一般百姓不敢在这里随便
乱闯，所以显得十分冷清。北面是喧嚣的城北广场，南面可以
看到神武门。
LONG

  );
  set("outdoors", "city2");

  set("exits", ([
    //	"east" : __DIR__"eguangchang",
    //	"west" : __DIR__"xiguangchang",
    "north": __DIR__ "beigc",
    "south": __DIR__ "shenwu",
  ]));
  setup();
}
