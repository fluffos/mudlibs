inherit ROOM;

void create() {
  set("short", "大道");
  set("long", @LONG
你走在一条宽广的大道上。四周人来人往。挑担子的、行商
的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热闹。
不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两旁
是整整齐齐的杨树林。北面是一片茂密的苹果林。
LONG
  );

  set("exits", ([
    "west": __DIR__ "wroad4",
    "east": __DIR__ "wroad2",
    "northup": __DIR__ "guoyuan",
  ]));

  set("outdoors", "city2");
  setup();
  replace_program(ROOM);
}
