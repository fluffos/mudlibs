inherit ROOM;

void create() {
  set("short", "石景山");
  set("long", @LONG
你走在一座小山的山脚下。四周人来人往。挑担子的、行商
的、赶着大车的马夫、上京赶考的书生，熙熙攘攘，非常热闹。
不时还有两三骑快马从身边飞驰而过，扬起一路尘埃。道路两
旁是整整齐齐的杨树林。
LONG
  );

  set("exits", ([
    "west": __DIR__ "wroad3",
    "east": __DIR__ "wroad1",
  ]));

  set("outdoors", "city2");
  setup();
  replace_program(ROOM);
}
