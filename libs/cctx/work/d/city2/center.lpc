inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIW "京城广场中心" NOR);
  set("long", @LONG
这里是北京城的中心，四处人声鼎沸，十分闹热，不愧是 
京都的中心，宽大的广场中央立着两根又高又大的汉白玉金銮 
雕龙大柱，为整个广场平添了几分雄伟之色，有些官兵在这里 
走来走去，还有些太监在四处走动。 
LONG

  );
  set("outdoors", "city2");

  set("exits", ([
    "east": __DIR__ "eguangchang",
    "west": __DIR__ "xiguangchang",
    "north": __DIR__ "beiguangchang",
    "south": __DIR__ "nmguangchang",
  ]));
  setup();

}
