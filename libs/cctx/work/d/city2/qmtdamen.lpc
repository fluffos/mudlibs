inherit ROOM;

void create() {
  set("short", "青木堂大门");
  set("long", @LONG
这里是北京城的西大街，比较清静，外地来的客商，进京
赶考的秀才多喜爱在这段路来住店饮食。街道的两旁是成荫的
杨柳树。西面是高升客店，东面就是天地会的青木堂。
LONG

  );


  set("exits", ([
    "east": __DIR__ "huichunt",
    "west": __DIR__ "xidajie",
    "north": __DIR__ "dating",

  ]));
  setup();
  replace_program(ROOM);
}
