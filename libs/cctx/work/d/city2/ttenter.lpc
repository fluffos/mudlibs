//room: /d/city2/ttenter.c

inherit ROOM;

void create() {
  set("short", "天坛入口");
  set("long", @LONG
这里是天坛入口，再进去就是天坛了。望西就可以看到壮观的天坛。
LONG
  );
  set("outdoors", "city2");
  set("exits", ([

    "west": __DIR__ "tiantan",
    "east": __DIR__ "dongdajie1",
  ]));
  set("objects", ([
    __DIR__ "npc/shiwei": 2,
  ]));
  setup();

}
int valid_leave(object me, string dir) {
  if (objectp(present("shi wei", environment(me))) && dir == "west")
    return notify_fail("侍卫拦住你骂道：“闯什么闯？里面没什么好看的！”\n");

  return ::valid_leave(me, dir);
}
