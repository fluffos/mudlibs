#include <ansi.h>

inherit ROOM;

void create()
{
	set("name", "西城大酒楼");
	set("short", "西城大酒楼");
	set("long", @LONG
这里是雅座，文人学士经常在这里吟诗作画，富商土豪也在
这里边吃喝边作交易。这里也是城里举办喜宴的最佳场所。墙上
挂着价格牌子(paizi)。你站在楼上眺望京城，只觉得心旷神怡。
LONG
	);
	set("no_fight", 1);
	set("no_sleeproom", 1);
	set("item_desc", ([
		"paizi" : "本店出售烤鸭及上等花雕酒。\n",
	]));

	set("exits", ([
		"down" : __DIR__"xcjiulou1",
	]));

	set("objects", ([
		"/d/city2/npc/wan":1,
	]));
	setup();
}
int valid_leave(object me, string dir)
{
	if (me->query_temp("marks/坐")&&dir == "down")
		return notify_fail("你上一个动作还没完成，不能移动。\n");
	return ::valid_leave(me, dir);
}