inherit ROOM;
#include <ansi.h>
void create() {
  set("short", YEL "北广场" NOR);
  set("long", @LONG
这里是北京城的中心的北广场，往南可以看到京都广场的  
中心，南边传来阵阵喧哗声，似乎很闹热。西面可以看到翰林
院的大门，再往北便是午门。
LONG

  );
  set("outdoors", "city2");

  set("exits", ([
    "west": __DIR__ "hanlin",
    "north": __DIR__ "wumen",
    "south": __DIR__ "center",
  ]));
  setup();
  replace_program(ROOM);
}
