//room: /d/city2/jinyiwei.c

inherit ROOM;

void create() {
  set("short", "锦衣卫大门");
  set("long", @LONG
这里就是锦衣卫衙门，两扇木大门紧紧关闭着。放两头
石狮子的旁边。几名卫士在门前巡逻。
LONG
  );

  set("exits", ([

    "east": __DIR__ "dongdajie2",
    "west": __DIR__ "jinyiwei2",
  ]));
  set("objects", ([
    __DIR__ "npc/shiwei": 2,
    __DIR__ "npc/shiwei2": 1,
  ]));
  setup();

}
int valid_leave(object me, string dir) {
  if (objectp(present("shi wei", environment(me))) && dir == "west")
    return notify_fail("侍卫拦住你骂道：“速速离去，此地非闲逛之所！”\n" + RANK_D->query_rude(me) + "快给我滚远点儿，不然别怪我不客气！”\n");

  return ::valid_leave(me, dir);
}
