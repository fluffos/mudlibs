inherit ROOM;
#include <ansi.h>
void create() {
  set("short", YEL "西广场" NOR);
  set("long", @LONG
这里是北京城的中心的西广场，往东可以看到京都广场的 
中心，东边传来阵阵喧哗声，似乎很闹热。西面是京西大街，
往北可以看到翰林院的大门。 
LONG

  );
  set("outdoors", "city2");

  set("exits", ([
    "east": __DIR__ "center",
    "west": __DIR__ "jxdajie3",
    "north": __DIR__ "hanlin",
    //		"south" : __DIR__"ludingfu",
  ]));
  set("objects", ([
    "/d/npc/kuangfeng": 1,
  ]));
  setup();
  replace_program(ROOM);
}
