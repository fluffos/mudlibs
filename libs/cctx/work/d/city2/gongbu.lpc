inherit ROOM;

void create() {
  set("short", "工部府衙");
  set("long", @LONG
这里是工部的大门，门口站着几个持枪佩刀的衙役，看起
来威风凛凛，没事最好别在这里吓闯。
LONG

  );


  set("exits", ([
    "north": __DIR__ "gongbu1",
    "south": __DIR__ "jxdajie3",
  ]));
  set("objects", ([
    "/d/city/npc/yayi": 4,
  ]));
  setup();

}

int valid_leave(object me, string dir) {
  if (objectp(present("ya yi", environment(me))) && dir == "north")
    return notify_fail("衙役喝道：“威……武……。”\n");
  return ::valid_leave(me, dir);
}
