
inherit ROOM;

void create()
{
	set("short", "西城大酒楼");
	set("long", @LONG
方圆数百里内提起西城大酒楼可以说是无人不知，无人
不晓。楼下布置简易，顾客多是匆匆的行人，买点包子、鸡
腿、米酒就赶路去了。楼上是雅座。
LONG
	);
	set("no_fight", 1);
	set("no_sleeproom", 1);
	set("exits", ([
