// xiongzhang.c 熊掌

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("冰火熊掌", ({ "xiongzhang", "zhang" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘色香味俱全的冰火熊掌。\n");
    set("unit", "个");
    set("value", 50);
    set("food_remaining", 3);
    set("food_supply", 20);
    set("no_get", "你在赴宴，还是文明点吧。\n");
  }
}
