// hdjiudai.c  花雕酒袋
#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name(YEL "陈年花雕酒坛" NOR, ({ "jiuguan", "crock", "guan" }));
  set_weight(2100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个用来装高级陈年花雕酒的大酒坛。\n");
    set("unit", "个");
    set("value", 10000);
    set("max_liquid", 80);
  }

  set("liquid", ([
    "type": "alcohol",
    "name": "陈年花雕酒",
    "remaining": 80,
    "drunk_apply": 10,
  ]));
}
