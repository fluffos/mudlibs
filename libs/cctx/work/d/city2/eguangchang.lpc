inherit ROOM;
#include <ansi.h>
void create()
{
	set("short", YEL"东广场"NOR);
	set("long", @LONG
这里是北京城的中心的东广场，往西可以看到京都广场的  
中心，西边传来阵阵喧哗声，似乎很闹热。南北是校场，再往
东是京东大街。
LONG

	);
        set("outdoors", "city2");
	set("exits", ([
		"east" : __DIR__"jingdongjie3",
		"west" : __DIR__"center",
		"north" : __DIR__"beijc",
		"south" : __DIR__"nanjc",
	]));
	setup();
	replace_program(ROOM);
}


