inherit ROOM;

void create() {
  set("short", "南门大街");
  set("long", @LONG
这里是北京城的南门大街，比较繁华，地上铺着光洁的青
石板，街道的两旁是成荫的杨柳树。北面是户部大堂南面就是
韦爵爷当年创建的驰名京都的通吃赌房。东面传过一条大街就
是繁华的南广场。
LONG

  );
  set("outdoors", "city2");
  set("exits", ([
    "east": __DIR__ "nmdajie2",
    "west": __DIR__ "xidajie3",
    "north": __DIR__ "hubu",
    "south": __DIR__ "bingbu",
  ]));
  setup();
  replace_program(ROOM);
}
