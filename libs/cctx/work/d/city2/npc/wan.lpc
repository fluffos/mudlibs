// wan.c 万老板


inherit F_DEALER;

string ask_me1();


void create()
{
	set_name("万老板", ({ "wan laoban", "wan","boss","laoban" }));
	set("title", "西城酒楼老板");
	set("shen_type", 1);

	set("str", 20);
	set("gender", "男性");
	set("age", 50);
	set("long", "万老板是京城数一数二的富豪。\n");

	set("combat_exp", 50000);

	set("qi", 300);
	set("max_qi", 300);
	set("attitude", "friendly");

	set_skill("unarmed", 60);
	set_skill("dodge", 60);
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);



	set("inquiry", ([
		"定酒席" : (: ask_me1 :),
		
	]) );

	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{	object ob; 
	mapping myfam; 

	ob = this_player();

	::init();
	if( interactive(ob) && !is_fighting() ) {
			remove_call_out("greeting");
			call_out("greeting", 1, ob);
	}
	add_action("do_answer", "answer");

}

string ask_me1()
{
	if (this_player()->query_temp("marks/主人1"))
	{
		return("你无聊不无聊呀？还问我，莫不是你耳朵有问题？\n");
         }
		if (this_player()->query_temp("marks/主人2"))
	{
		return("你已经付过定金了，再交100两黄金就可以上酒席了。\n");
         }
		if (this_player()->query_temp("marks/主人3"))
	{
		return("你已经付足100两黄金了，如果人都邀请完了就回答(answer)我吧。\n");
         }
	else {
		this_player()->set_temp("marks/主人1",1);
		return("我这里定酒席100两黄金一桌，定金黄金1两，多少人赴宴不限。\n");
	}

}
int accept_object(object who, object ob)
{
   

    if ((ob->query("money_id")) && (ob->value() == 10000)
	 && (who->query_temp("marks/主人1")))
	{
	command("say 这位客官您请稍候，我这就叫店小二准备去。");
	command("say 您现在可以邀请(invite)你所要请的客人。");
	command("say 邀请完后再付100两黄金就可以叫厨师开始准备酒席了。");
        who->set_temp("marks/主人2",1);
	who->delete_temp("marks/主人1");
        return 1;
    }    
	else if ((ob->query("money_id")) && (ob->value() >= 1000000)
	 && (who->query_temp("marks/主人2")))
	{
	command("say 如果你还有什么人没请到的就快点请。");
	command("say 邀请完后你可以告诉(answer)我。");
	who->delete_temp("marks/主人2");
        who->set_temp("marks/主人3",1);
        return 1;
    }
       return 0;
}
int do_answer(string arg)
{     	object me,item;
	me = this_player();
        if( !arg || arg=="") return 0;
	if(arg=="wan"&&me->query_temp("marks/主人3")&&me->query_temp("marks/邀")){
	command("say 好吧，现在开席，祝大家吃个饱吃个好，一醉方休才得归！");
	command("haha ");
	command("down ");
	command("say 小二，上菜！");
	command("up ");
	message_vision("店小二不一会儿就端着热气腾腾的山珍海味上到了诺大的圆桌(table)上。\n",me);
	me->delete_temp("marks/主人1");
	me->delete_temp("marks/主人2");
	me->delete_temp("marks/主人3");
	me->delete_temp("marks/邀");
	item = new("/d/city2/npc/obj/table");
        item->move(environment(me));
	return 1;}
	else return 0;

}	
 void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(2) ) {
		case 0:
			say( "万老板笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，你是要定酒席吧？\n");
			break;
		case 1:
			say( "万老板笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，请坐请坐。\n");
			break;
	}
}  
