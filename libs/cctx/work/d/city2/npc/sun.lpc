

inherit F_DEALER;


void create()
{
	set_name("孙胜", ({ "sun laoban", "sun","boss","laoban" }));
	set("title", "古玩店老板");
	set("shen_type", 1);

	set("str", 20);
	set("gender", "男性");
	set("age", 40);
	set("long", "孙老板本经营的古意斋已有多年。\n");

	set("combat_exp", 50000);

	set("qi", 300);
	set("max_qi", 300);
	set("attitude", "friendly");

	set_skill("unarmed", 60);
	set_skill("dodge", 60);
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);
	set("vendor_goods", ({
		"/d/city2/obj/yupei",
		"/d/city2/obj/tang",
		"/d/city2/obj/shouzhuo",
	}));
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{
	add_action("do_list", "list");
	add_action("do_buy", "buy");
}

