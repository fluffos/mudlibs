// mei.c 梅老板

inherit F_DEALER;

string ask_me1();
string ask_me2();

void create()
{
	set_name("梅老板", ({ "mei laoban", "mei","boos","laoban" }));
	set("title", "包子铺老板");
	set("shen_type", 1);

	set("str", 20);
	set("gender", "男性");
	set("age", 65);
	set("long", "程老板经营祖传下来的梅当劳包子铺已有多年。\n");

	set("combat_exp", 50000);

	set("qi", 300);
	set("max_qi", 300);
	set("attitude", "friendly");

	set_skill("unarmed", 60);
	set_skill("dodge", 60);
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);

	set("vendor_goods", ({
		"/d/city/obj/hdjiudai",
		__DIR__"obj/baozi",
	}));


	setup();
	add_money("gold", 1);
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{	object ob; 
	mapping myfam; 

	ob = this_player();

	::init();
	if( interactive(ob) && !is_fighting() ) {
			remove_call_out("greeting");
			call_out("greeting", 1, ob);
	}
	add_action("do_list", "list");
	add_action("do_buy", "buy");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(2) ) {
		case 0:
			say( "梅老板笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，进来尝尝我们这里的包子吧。\n");
			break;
		case 1:
			say( "梅老板笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，请进请进。\n");
			break;
	}
}