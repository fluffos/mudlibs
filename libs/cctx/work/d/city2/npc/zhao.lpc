// wan.c 万老板

inherit F_DEALER;


void create()
{
	set_name("赵得开", ({ "zhao laoban", "zhao","boss","laoban" }));
	set("title", "裁缝铺老板");
	set("shen_type", 1);

	set("str", 20);
	set("gender", "男性");
	set("age", 50);
	set("long", "赵老板本经营的裁缝铺已有多年，什么大小生意都做，也叫找得开。\n");

	set("combat_exp", 50000);

	set("qi", 300);
	set("max_qi", 300);
	set("attitude", "friendly");

	set_skill("unarmed", 60);
	set_skill("dodge", 60);
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);
	set("vendor_goods", ({
		"/d/city2/obj/crystal",
		"/d/city2/obj/diaopi",
		"/d/city2/obj/yaodai",
	}));
	setup();
	carry_object("/clone/misc/cloth")->wear();
}

void init()
{	object ob; 
	mapping myfam; 

	ob = this_player();

	::init();
	if( interactive(ob) && !is_fighting() ) {
			remove_call_out("greeting");
			call_out("greeting", 1, ob);
	}
	add_action("do_list", "list");
	add_action("do_buy", "buy");
}

 void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(2) ) {
		case 0:
			say( "赵老板笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，进来买点什么东西吧。\n");
			break;
		case 1:
			say( "赵老板笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，里面请，里面请。\n");
			break;
	}
}  