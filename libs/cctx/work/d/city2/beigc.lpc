inherit ROOM;
#include <ansi.h>
void create()
{
	set("short", YEL"城北广场"NOR);
	set("long", @LONG
这里是北京的北广场，由于西面是京城集贸中心，所以这
里也显得很繁华。北面是北城大道，往东是东北大街。
LONG
	);
        set("outdoors", "city2");


	set("exits", ([
		"east" : __DIR__"enroad1",
		"west" : __DIR__"xbstreet1",
		"north" : __DIR__"beiroad2",
		"south" : __DIR__"zongfu",
	]));

	setup();
	replace_program(ROOM);
}


