// Room: /d/shaolin/shanya.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "峻极峰");
  set("long", @LONG
太室山滂礴如卧，“峻极于天”，有卧龙之称，峻极峰是太室
山的主峰，高耸入云，两面悬崖，怪石(stone)嶙峋。之间隔着一山
谷(valley)。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "talin1",

  ]));

  setup();

}
void init() {
  add_action("do_push", "push");
  add_action("do_jump", "yue");
}
void close_passage() {
  object room;

  if (!query("exits/down")) return;
  message("vision", HIB "石塔忽然发出轧轧的声音，缓缓地移回原处。\n" NOR, this_object());
  if (room = find_object(__DIR__ "shanya")) {
    room->delete("exits/up");
    message("vision", HIB "墙上的石块又缓缓地收了回去，阶梯消失了。\n" NOR, room);
  }
  delete("exits/down");
}


int do_push(string arg) {
  object ob;
  ob = this_player();

  if (!arg || arg == "") return 0;

  if ((arg != "stone") || (this_player()->query("family/generation") != 3)) {
    message_vision("$N要推什么？\n", this_player());
    return 1;
  }

  else {
    message("vision", HIB "石塔忽然发出轧轧的声音，向一侧缓缓移开，"
      "向下露出一个黑洞洞的入口。\n", this_player());
    set("exits/down", __DIR__ "midao1");
    remove_call_out("close_passage");
    call_out("close_passage", 1);
  }
  return 1;
}
int do_jump(string arg) {
  int n, m;
  m = this_player()->query_skill("shaolin-shenfa", 1);
  n = this_player()->query_skill("dodge", 1);
  if (!arg || arg != "valley") {
    write("你在干什么，往下跳可不好!\n");
    return 1;
  }

  if (n < 180) {
    message_vision(
      HIR "$N想跃过去？这不是自寻死路吗？\n" NOR, this_player());
    return 1;
  }
  if (m < 200) {
    message_vision(
      HIR "$N想跃过去？这不是自寻死路吗？\n" NOR, this_player());
    return 1;
  }

  else {
    message_vision(
      HIY "只见$N纵身长啸，使出少林身法的绝技,身形化做一只大鹏鸟向对崖飞去......\n" NOR, this_player());
    this_player()->move("/d/shaolin/qingshiya");
  }
  return 1;
}
