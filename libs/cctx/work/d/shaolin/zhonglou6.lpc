// Room: /d/shaolin/zhonglou1.c
#include <ansi.h>

inherit ROOM;



string look_floor();
int do_sao(string arg);


void create() {
  set("short", "钟楼六层");
  set("long", @LONG
沿窗洞吹进一阵阵凌厉的山风，寒意浸人。北望可见松林的
尽头，少室山的顶峰处，有一片小小的平地，正中植着三棵巨松；
又似乎有什么东西正闪闪发光。头顶上的楼板开了个大洞，挂下
一口大钟。从这里只能看到巨钟的下边缘，内里黑洞洞的，什么
也看不见。
LONG
  );

  set("exits", ([
    "up": __DIR__ "zhonglou7",
    "down": __DIR__ "zhonglou5",
  ]));

  set("item_desc", ([
    "floor": (: look_floor :),
  ]));


  setup();
}


void init() {
  add_action("do_sao", "sao");
}

int do_sao(string arg) {
  object room, me;
  me = this_player();


  if (!arg && arg != "di" && arg != "floor")
    return notify_fail("你要扫什么？\n");

  if (!present("broom", me))
    return notify_fail("没扫地的家伙怎么行？\n");

  if (query("clean"))

    return notify_fail("地下已经够干净不用扫了！\n" + HIW + "你的潜能和经验已经增涨了。\n" NOR);
  me->add("combat_exp", 3 + (random(8)));
  me->add("potential", 1 + (random(3)));

  if ((int)me->query("jing") < 20)
    return notify_fail(RED "你已经太累了，还是歇歇吧！\n" NOR);
  message_vision(CYN "$N挥舞着大扫帚扫起地来。\n" NOR, me);
  write(CYN "眼前灰尘弥漫，你什么也看不见了。\n" NOR);
  message_vision(CYN "$N抹了一把汗，看了看自己干的结果，得意的笑了。\n" NOR, me);
  me->receive_damage("jing", 20 + (random(15)));
  me->add_temp("clean_floor", 1);

  if ((int)me->query_temp("clean_floor") > 13) {
    me->delete_temp("clean_floor");
  }
  set("clean", 1);
  return 1;

}



string look_floor() {
  return "这是木制的地板，地下很脏，看来今天没人打扫。\n";
}
