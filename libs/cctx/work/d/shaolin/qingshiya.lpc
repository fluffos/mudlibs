#include <room.h>
#include <ansi.h>

inherit ROOM;
int do_jump(string arg);

void create()
{
    set("short", "青石崖");
    set("long", @LONG
再往前已无路了，从崖上远眺，只见云海苍茫处，险绝万峦生。
嵩山景色近在眼底，真是一派大好河山。对崖相距五丈，之间隔着
一山谷(valley)，似乎对面崖上隐约有人居住，可是想从这边跃过
去，简直不可能。
LONG
    );

    set("exits", ([
        "down" : __DIR__"shijie15",
    ]));

    set("item_desc", ([
         "valley" : "这是深不见底的山谷，瞧一瞧也让你心惊胆战,想跃(yue)过去更加不可能。\n",
    ]) );
    setup();
}

void init()
{
    object book, me;
    me = this_player();
    add_action("do_jump", "yue");
}



int do_jump(string arg)
{
    int n,m;
    m = this_player()->query_skill("shaolin-shenfa",1); 
    n = this_player()->query_skill("dodge",1);
    if( !arg || arg!="valley" ) {
        write("你在干什么，往下跳可不好!\n");
        return 1;
    }
         
    if (n<180) {
        message_vision(
       HIR"$N想跃过去？这不是自寻死路吗？\n"NOR, this_player());
        return 1;
    }
    if (m<200) {
        message_vision(
       HIR"$N想跃过去？这不是自寻死路吗？\n"NOR, this_player());
        return 1;
    }

        else {
        message_vision(
        HIY"只见$N纵身长啸，使出少林身法的绝技,身形化做一只大鹏鸟向对崖飞去......\n"NOR, this_player());
      this_player()->move("/d/shaolin/shanya");
     }
    return 1;
}

