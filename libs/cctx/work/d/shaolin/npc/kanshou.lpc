#include <ansi.h>
inherit NPC;

void create() {
  set_name("牢房看守", ({ "kan shou", "shou", "kan" }));
  set("long",
    "这是一个看守，看来武功很高！\n");
  set("attitude", "aggressive");
  set("chat_msg", ({
    (: random_move :),
  }));
  set("age", 64);
  set("max_jing", 1000);
  set("jing", 1000);
  set("max_jing", 1000);
  set("kee", 1000);
  set("max_neili", 5000);
  set("neili", 10000);
  set("jiali", 200);
  set("combat_exp", 800000);

  set("cps", 60);
  set("spi", 60);
  set("int", 60);
  set("cor", 60);
  set("per", 60);
  set("kar", 60);
  set("str", 60);
  set("con", 60);

  set_skill("dodge", 150);
  set_skill("force", 150);
  set_skill("parry", 150);
  set_skill("unarmed", 150);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object("/d/shaolin/obj/key")->wield();
}
