// guest.c 游客

inherit NPC;

void create()
{
	set_name("游客", ({ "youke" }));
	set("gender", "男性");
	set("age", 20 + random(30));

	set_skill("unarmed", 20);
	set_skill("dodge", 20);
	set("apply/attack", 15);
	set("apply/defense", 15);
	set("apply/damage", 5);
	set("combat_exp", 750);
	set("shen_type", 1);

	set("chat_chance",2);
        set("chat_msg", ({
                "游客满心欢喜的说：嵩山也可以算是一个游山玩水的好地方了。\n",
                "游客叹了口气说：如果能进少林寺去看看就更好了。\n",
                (: random_move :)
        }) );

	setup();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver", 5);
}
	
