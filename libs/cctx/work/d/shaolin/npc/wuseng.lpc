inherit NPC;
#include <ansi.h>

void create() {
  set_name("少林武僧", ({ "wu seng", "seng" }));
  set("gender", "男性");
  set("class", "bonze");
  set("age", 30);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("qi", 600);
  set("max_qi", 600);
  set("jing", 300);
  set("max_jing", 300);
  set("neili", 1300);
  set("max_neili", 1300);
  set("jiali", 20);
  set("combat_exp", 80000);
  set("score", 10000);

  set_skill("force", 60);
  set_skill("hunyuan-yiqi", 60);
  set_skill("dodge", 60);
  set_skill("shaolin-shenfa", 60);
  set_skill("parry", 60);
  set_skill("cuff", 60);
  set_skill("jingang-quan", 60);
  set_skill("buddhism", 60);
  set_skill("literate", 60);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "jingang-quan");
  map_skill("cuff", "jingang-quan");
  prepare_skill("cuff", "jingang-quan");
  set("chat_chance", 2);
  set("chat_msg", ({
    CYN "武僧纵身跳上梅花桩，在上面走动犹如平地。\n" NOR,
    CYN "一不小心，一个武僧差点从梅花桩上掉下来！\n" NOR,
    CYN "武僧站在梅花桩上，打出了一套少林金刚拳，博得阵阵喝彩！\n" NOR,
  }));




  setup();
  carry_object("/d/shaolin/obj/sl-cloth")->wear();
}
