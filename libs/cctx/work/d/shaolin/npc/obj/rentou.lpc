inherit ITEM;
void create()
{
        set_name( "[31m玄风的人头[0m", ({ "xf poll"}));
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long","这是一颗的人头。\n");
                set("value", 0); 
                set("material", "meat"); 
              }
}

