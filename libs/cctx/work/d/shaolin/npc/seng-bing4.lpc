// seng-bing4.c 
#include <ansi.h>
inherit NPC;

void create() {
  set_name("少林棍僧", ({ "gun seng", "seng" }));
  set("long",
    "他是一位身材高大的青年僧人，两臂粗壮，膀阔腰圆。他手持齐\n"
    "眉棍，身穿一袭白布镶边袈裟，似乎有一身武艺。\n");
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 40);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 1500);
  set("max_jing", 600);
  set("neili", 5000);
  set("max_neili", 1500);
  set("jiali", 20);
  set("combat_exp", 1500000);
  set("score", 1);

  set_skill("force", 100);
  set_skill("hunyuan-yiqi", 100);
  set_skill("dodge", 100);
  set_skill("shaolin-shenfa", 100);
  set_skill("cuff", 100);
  set_skill("parry", 100);
  set_skill("club", 120);
  set_skill("zui-gun", 100);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "zui-gun");
  map_skill("club", "zui-gun");

  create_family("少林派", 36, "弟子");

  setup();
  carry_object("/d/shaolin/obj/qimeigun")->wield();
  carry_object("/d/shaolin/obj/sl-cloth")->wear();
}

void init() {
  object ob;
  mapping myfam;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    myfam = (mapping)ob->query("family");
    if ((!myfam || myfam["family_name"] != "少林派")) {
      remove_call_out("do_killing");
      call_out("do_killing", 4, ob);
    }
  }
}

void do_killing(object ob) {
  if (!ob || environment(ob) != environment())
    return;
  command(HIR "say 大胆狂徒，竟敢擅闯少林，众僧给我拿下！" NOR);
  this_object()->kill_ob(ob);
}
