// wushi.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("武师", ({ "wu shi" }) );
	set("gender", "男性");
	set("age", 43);
	set("long",
		"一位四十多岁的江湖武师，两边太阳穴微微隆起，看来身手一定不凡。\n");
	set("combat_exp", 80000);
        set("shen_type", -1);
	set("attitude", "heroism");

	set_skill("unarmed", 70);
	set_skill("parry", 70);
	set_skill("dodge", 70);
        set_skill("strike", 70);

	set("chat_chance", 2);
        set("chat_msg", ({
                "武师禁不住得意地说：我从十岁开始习武，苦练三十多年，现在就来把少林给挑了，好扬威江湖。\n",
                "武师「哈哈哈」大笑几声。\n",
        }) );
 
	setup();

        carry_object("/clone/misc/cloth")->wear();

	add_money("silver", 10);
}

