#include <ansi.h>


 inherit NPC;


void create()

{

	        set_name(RED"铜人"NOR, ({ "tongren" }) );
        	set("gender", "男性" );
  
	        set("age", 22);
                set("str",80);
       
	set("int", 30);                set("max_neili",1000);
                set("neili",4000);
                set("jiali",100);                


	        set("long","少林寺铜人\n");

	        set("attitude", "peaceful");

            	set_skill("unarmed", 150+random(70));

	        set_skill("force", 80);
                set_skill("yizhi-chan",150+random(80));
                set_skill("finger",150+random(80));

                map_skill("finger","yizhi-chan");
               prepare_skill("finger","yizhi-chan");
  

           	set("combat_exp", 2000000+random(1000000));

	        setup();

                
}
