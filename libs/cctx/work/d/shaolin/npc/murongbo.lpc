//npc /d/nshaolin/murongbo.c

inherit NPC;
#include <ansi.h>
void getting();

void create()
{
        set_name("慕容博", ({ "murong bo", "murong","bo"}) );
        set("gender", "男性" );
        set("age", 44);
	set("per", 35);
        set("int",30);
	set("attitude","friendly");
        set("max_neili", 5500);
        set("neili", 11000);
        set("long",
"
\n"
	);
        set("combat_exp", 1500000);
        set_skill("dodge", 100);
        set_skill("force", 100);
        set_skill("literate", 100);
	set_skill("finger",100);
	set_skill("shaolin-shenfa",100);
	set_skill("yizhi-chan",100);
	set_skill("buddhism",100);
	set_skill("hunyuan-yiqi",100);
	set_skill("parry",100);
	
	map_skill("finger","yizhi-chan");
	map_skill("parry","yizhi-chan");
        map_skill("dodge", "shaolin-shenfa");
	map_skill("force", "hunyuan-yiqi");
	
    set("chat_chance", 20);
    set("chat_msg", ({
		CYN"蒙面人环顾四周．..发现没人就开始翻翻箱倒柜好象在找什么东西！\n"NOR,
		CYN"蒙面人用手翻了翻经书．．.\n"NOR,
            (: getting :)

    }) );
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
            (: getting :)

        }) );
        setup();
        carry_object("/d/shaolin/obj/mengmian")->wear();

}
void hide()
{
	object *inv;
	int i;
        if( !environment() ) return;
	inv = all_inventory(environment());
	for(i=0;i<sizeof(inv);i++)
	
		message_vision(HIB"$N哈哈笑道：终被我找着了，然后跳出窗口不见了．．．\n"NOR,this_object());
        call_out("disappear", 1);
}
void disappear()
{
        destruct(this_object());
}
void getting()
{
command("get slyjj");
call_out("hide",10+random(20));
}
void die()
{               
	object mengmian;
	message_vision(HIR"\n慕容博，大叫一声：“天亡我大燕也”。\n"NOR, this_object());
	mengmian = new("/d/shaolin/obj/sl-cloth");
	mengmian->move(this_object());
        
::die();
}
