// XieXun.c


#include <ansi.h>
inherit NPC;

void create() {
  set_name("谢逊", ({ "xie xun", "xie", "xun", }));
  set("long",
    "他是一位身材魁伟异常的的老者，身穿一件白布长袍。\n"
    "他满头黄发，威风凛凛，真如天神一般，只是两只眼睛并不睁开。\n"
  );

  set("title", HIG "明教" HIY "金毛狮王" NOR);
  set("gender", "男性");
  set("attitude", "peaceful");

  set("age", 63);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 3500);
  set("max_jing", 1500);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 80);

  set("combat_exp", 200000);
  set("score", 15000);

  set_skill("force", 150);
  set_skill("dodge", 140);
  set_skill("parry", 150);
  set_skill("cuff", 150);
  set_skill("jiuyang-shengong", 150);
  set_skill("jingang-quan", 150);
  set_skill("literate", 100);

  map_skill("force", "jiuyang-shengong");
  map_skill("cuff", "jingang-quan");
  map_skill("parry", "jingang-quan");

  prepare_skill("cuff", "jingang-quan");

  set("chat_chance_combat", 200);
  set("chat_msg_combat", ({
    (: command("perform hunpofeiyang") :),
  }));
  set("chat_chance", 15);
  set("chat_msg", ({
    CYN "谢逊恨很的言到：“成昆这老贼杀我全家，此仇不共戴天焉能不抱。”\n" NOR,
    CYN "谢逊言到：“我钻研15年也无法解透屠龙刀的秘密，咳......”\n" NOR,
  }));
  set("inquiry", ([
    "成昆": "成昆这老贼，听说现在隐藏在少林，化名玄真有机会我一定要找他报仇。\n",
    "屠龙刀": "屠龙刀就在我这儿，我是不会轻易给的，你打听这个干什么?\n",

  ]));

  create_family("明教", 2, "弟子");

  setup();
  carry_object("/d/city/obj/cloth")->wear();
}
int accept_object(object who, object ob) {
  who = this_player();
  if (ob->query("used")) {
    command("say 这不是从我身上取去的吗，哼！还想来骗我，可恶！！！\n");
    destruct(ob);
    return 1;
  }

  if ((int)who->query("qu_dao") == 1) {
    command("say 你不是取过刀了吗，还来干什么！\n");
    return 1;
  }
  if ((string)ob->query("id") == "ck poll") {
    message_vision(HIB "谢逊大喜道：“成昆你这个老贼也有今天，哈哈！贼老天开眼了。\n" NOR, ob);
    ob = new("/d/shaolin/obj/tulong-dao");
    ob->move(this_player());
    who->set("qu_dao", 1);
    ob->set("used", 1);
    message_vision(
      HIB "\n谢逊对你点点头，道：“多谢你替我报了大仇，现在开始" + HIW + "屠龙刀" + NOR + HIB "就是你的了。\n" "说完从身后拿出一把" + HIW + "屠龙刀" + NOR + HIB "交给了你\n\n" NOR,
      this_player()
    );
    return 1;
  }

}
