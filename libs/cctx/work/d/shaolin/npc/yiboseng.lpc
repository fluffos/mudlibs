// Npc: /d/nshaolin/yiboseng 衣钵僧.c


inherit NPC;

string ask_me_1(string name);

void create() {
  set_name("衣钵僧", ({ "yibo seng", "seng" }));
  set("long",
    "他是少林寺分发衣物的僧人。\n");

  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 40);
  set("shen_type", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("max_qi", 400);
  set("max_jing", 300);
  set("neili", 450);
  set("max_neili", 450);
  set("jiali", 40);
  set("combat_exp", 10000);
  set("score", 100);

  set_skill("force", 50);
  set_skill("hunyuan-yiqi", 50);
  set_skill("dodge", 50);
  set_skill("shaolin-shenfa", 50);
  set_skill("strike", 50);
  set_skill("banruo-zhang", 50);
  set_skill("parry", 50);
  set_skill("sword", 50);
  set_skill("damo-jian", 50);
  set_skill("buddhism", 50);
  set_skill("literate", 50);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("strike", "banruo-zhang");
  map_skill("sword", "damo-jian");
  map_skill("parry", "damo-jian");

  prepare_skill("strike", "banruo-zhang");

  create_family("少林派", 41, "弟子");

  set("inquiry", ([
    "僧衣": (: ask_me_1, "sl-cloth" :),

  ]));


  setup();

  carry_object("/d/shaolin/obj/changjian")->wield();
  carry_object("/d/shaolin/obj/sl-cloth")->wear();
}

string ask_me_1(string name) {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "少林派")
    return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";

  if (present(name, this_player()))
    return RANK_D->query_respect(this_player()) + "你现在身上不是有了吗？怎麽又来要了？ 真是贪得无餍！";


  ob = new("/d/shaolin/obj/sl-cloth");
  ob->move(this_player());

  message_vision("衣钵僧给$N一件灰布僧衣。\n", this_player());
  return "记住在寺内一定要穿僧衣，不然会送进戒律院的。";
}
