// NPC: /d/nshaolin/huta-seng

inherit NPC;
#include <ansi.h>
void close_door(object room);
void create() {
  set_name("护塔僧", ({ "hu seng", "seng" }));
  set("gender", "男性");
  set("class", "bonze");
  set("age", 30);
  set("shen_type", 1);
  set("str", 300);
  set("int", 30);
  set("con", 30);
  set("dex", 300);

  set("qi", 600);
  set("max_qi", 600);
  set("jing", 300);
  set("max_jing", 300);
  set("neili", 1300);
  set("max_neili", 1300);
  set("jiali", 20);
  set("combat_exp", 80000);
  set("score", 10000);

  set_skill("force", 100);
  set_skill("hunyuan-yiqi", 100);
  set_skill("dodge", 60);
  set_skill("shaolin-shenfa", 100);
  set_skill("parry", 100);
  set_skill("cuff", 100);
  set_skill("jingang-quan", 100);
  set_skill("buddhism", 100);
  set_skill("literate", 60);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "jingang-quan");
  map_skill("cuff", "jingang-quan");
  prepare_skill("cuff", "jingang-quan");
  set("chat_chance", 2);
  set("chat_msg", ({
    CYN "护塔僧言道：“我最喜欢山林中的奇异果子。”\n" NOR,
    CYN "护塔僧言道：“上次吃了一个，哇！简直太棒了......”\n" NOR,
  }));
  set("inquiry", ([
    "上塔": "上面乃少林圣地，不是轻易能进去的。\n",
    "果子": "听说这种果子少林寺外就有。\n",
  ]));
  setup();
  carry_object("/d/shaolin/obj/sl-cloth")->wear();
}

int accept_object(object who, object ob) {
  object room;

  if (ob->query("id") == ("ye songguo") && who->query("family/family_name") == "少林派") {
    tell_object(who, "护胡塔僧笑道：嘻嘻！这么宝贵的东西给我！好吧我也行个方便。\n\n");
    message_vision("护塔僧替$N打开一道小门。\n", who);

    if (!(room = find_object("/d/shaolin/putiyuan")))
      room = load_object("/d/shaolin/putiyuan");

    room->set("exits/enter", "/d/shaolin/putiyuan1");

    remove_call_out("close_door");
    call_out("close_door", 5, room);

    return 1;
  }

  return 0;
}

void close_door(object room) {
  message("vision", "护塔僧又把小门关了起来。\n", room);
  room->delete("exits/enter");
}
