//NPC: /d/nshaolin/npc/xuan-ci.c
#include <ansi.h>
inherit NPC;
void create() {
  set_name("玄慈大师", ({
    "xuanci dashi",
    "xuanci",
    "dashi",
  }));
  set("long",
    "他是一位白须白眉的老僧，身穿一袭金丝绣红袈裟。\n"
    "他身材略显佝偻，但却满面红光，目蕴慈笑，显得神完气足。\n"
  );

  set("title", HIR "少林寺方丈" NOR);
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 70);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 3500);
  set("max_jing", 1500);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 150);
  set("combat_exp", 1000000);
  set("score", 800000);


  set_skill("force", 230);
  set_skill("hunyuan-yiqi", 230);
  set_skill("dodge", 190);
  set_skill("shaolin-shenfa", 160);
  set_skill("finger", 230);
  set_skill("strike", 230);
  set_skill("hand", 160);
  set_skill("claw", 160);
  set_skill("parry", 160);
  set_skill("nianhua-zhi", 230);
  set_skill("sanhua-zhang", 230);
  set_skill("fengyun-shou", 160);
  set_skill("longzhua-gong", 160);
  set_skill("buddhism", 250);
  set_skill("literate", 160);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("finger", "nianhua-zhi");
  map_skill("strike", "sanhua-zhang");
  map_skill("hand", "fengyun-shou");
  map_skill("claw", "longzhua-gong");
  map_skill("parry", "nianhua-zhi");

  prepare_skill("finger", "nianhua-zhi");
  prepare_skill("strike", "sanhua-zhang");

  create_family("少林派", 36, "弟子");

  setup();

  carry_object("/d/shaolin/obj/jiasha")->wear();
}
void init() {
  object ob = this_player();
  object me = this_object();
  ::init();
  if (((string)ob->query("title") == "普通百姓") &&
    ((string)environment(me)->query("short") == "塔林")) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;

  switch (random(1)) {
    case 0:
      command("chat* 只听玄慈大师说道：" + ob->query("name") + "，现已闯过少林木人巷！下山自谋生路去了\n");
      command("say 请把令牌交换于我。");
      break;
  }
}
int accept_object(object who, object ob) {
  object room;
  if (this_player()->query("win_muren") == 1) {
    tell_object(who, "玄慈大师对你点了一点头，道：你这就去吧。\n\n");
    return ("你走吧!");
  }
  if (ob->query("id") == ("fangzhang lingpai")) {
    tell_object(who, "玄慈大师对你点了一点头，道：你这就去吧!\n\n");
    this_player()->add("combat_exp", 15000);
    this_player()->set("win_muren", 1);
    return 1;

  }


}
