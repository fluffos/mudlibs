// xuanfeng
// by godzilla 99.03.06
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("玄风", ( {"xuanfeng dashi","xuanfeng","dashi"} ) );
        set("long",
"他是一位白须白眉的老僧，身穿一袭银丝棕黄袈裟。他身材极瘦，\n"
"脸上满布皱纹，手臂处青筋绽露，似乎久经风霜。\n" );
        create_family("少林派", 36, "弟子");
        set("attitude", "peaceful");
        set("age", 70);
        set("gender", "男性");
        set("shen_type", 1);
	set("no_drop",1);

        set("con", 30);
        set("dex", 30);
        set("int", 30);
        set("str", 30);
	set("per", 28);
	set("ker", 30);
        set("max_qi", 3500);
	set("max_jing", 1000);
	set("neili", 3000);
	set("max_neili", 3000);
        set("neili",3000);
        set("qi",3500);
        set("jiali", 60);
        set("combat_exp", 1100000);

        set_skill("dodge", 150);
        set_skill("force", 180);
        set_skill("literate",180);
        set_skill("parry", 200);
        set_skill("sword", 160);
        set_skill("finger", 180);
        set_skill("damo-jian", 140);
        set_skill("hunyuan-yiqi", 160);
        set_skill("yizhi-chan",150);
        set_skill("shaolin-shenfa", 150);

	map_skill("force", "hunyuan-yiqi");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("parry", "yizhi-chan");
	map_skill("sword", "damo-jian");
	map_skill("finger", "yizhi-chan");
                 
        prepare_skill("finger", "yizhi-chan");	                        set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "sword.sanjue" :),
		(: exert_function, "recover" :),
	}) );

        setup();
        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
        carry_object("/d/shaolin/obj/changjian")->wield(); 
}
void attempt_apprentice(object ob)
{       mapping fam;
 
       if ( mapp(fam=ob->query("family")) && (string)fam["family_name"] == "少林派" )
        {
                command("say 收你为徒？玄风看了看你，又摇了摇说到：“还是走吧”！");
                return;
        }
} 
void die()
{
	object cloth;
	message_vision(HIR"\n$N大叫一声:“吾命休已！”然后口吐鲜血栽倒在地。\n"NOR, this_object());
	cloth = new(__DIR__"obj/rentou");
	cloth->move(this_object());
::die();
}

