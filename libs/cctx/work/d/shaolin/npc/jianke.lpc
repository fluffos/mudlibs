// jian-ke.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("剑客", ({ "jian ke","ke" }) );
	set("gender", "男性");
	set("age", 35);
	set("long",
		"这是位中年武人，肩背长剑，长长的剑穗随风飘扬，看来似乎身怀绝艺。\n");
	set("combat_exp", 40000);
        set("shen_type", -1);
	set("attitude", "heroism");

	set("apply/attack",  30);
	set("apply/defense", 30);

	set_skill("sword", 60);
	set_skill("unarmed", 50);
	set_skill("parry", 50);
	set_skill("dodge", 50);
        
	set("chat_chance",2);
        set("chat_msg", ({
                "剑客着急地说：听说有人上少林寺挑战，我得快点赶去，看能不能趁火打劫一下。\n",
                "剑客「嘿嘿嘿」地奸笑了几声。\n",
        }) );

	setup();

        carry_object("/d/city/obj/changjian")->wield();
        carry_object("/clone/misc/cloth")->wear();
	add_money("silver", 20);
}

