// NPC sengren.c

#include <ansi.h>

inherit NPC;
string ask_me();

void create() {
  int value;
  value = random(2);

  set_name("虚静", ({ "xu jing", "xu", "jing" }));
  set("long", @LONG
他是少林专职送饭的僧人，身穿少林僧衣，好象不会什么武功。
LONG
  );
  set("class", "bonze");
  set("gender", "男性");
  set("age", 20);
  set("shen_type", -1);
  set("attitude", "friendly");
  set("age", 20);
  set("shen_type", 1);
  set("str", 27);
  set("int", 23);
  set("con", 24);
  set("dex", 20);

  set("max_qi", 300);
  set("qi", 300);
  set("jing", 200);
  set("max_jing", 200);
  set("neili", 800);
  set("max_neili", 800);
  set("jiali", 0);

  set("combat_exp", 10000);
  set_skill("force", 30);
  set_skill("hunyuan-yiqi", 30);
  set_skill("dodge", 30);
  set_skill("shaolin-shenfa", 30);
  set_skill("strike", 30);
  set_skill("banruo-zhang", 30);
  set_skill("parry", 30);
  set_skill("sword", 30);
  set_skill("damo-jian", 30);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("strike", "banruo-zhang");
  map_skill("parry", "damo-jian");
  map_skill("sword", "damo-jian");

  prepare_skill("strike", "banruo-zhang");

  create_family("少林派", 41, "弟子");


  set("inquiry", ([
    "送饭": (: ask_me :),
  ]));
  set("chat_chance", 2);
  set("chat_msg", ({
    "虚静喃喃道：咳，每天都要来送饭！什么时候我才能结束啊！\n",
  }));
  set("fan_count", 1 + value);
  setup();
  carry_object("/d/shaolin/obj/changjian")->wield();
  carry_object("/d/shaolin/obj/sl-cloth")->wear();
}

string ask_me() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "少林派")
    return RANK_D->query_respect(this_player()) + "你又不是少林派的怎敢劳驾你呢？";
  if (query("fan_count") < 2)
    return "嘻嘻今天怎么了，这么多人抢着送饭，\n" "不好意思，已经有人捷足先登了，你下次再来吧。\n";
  add("fan_count", -1);
  ob = new("/d/shaolin/obj/basket");
  ob->move(this_player());
  return YEL "有劳施主了，饭篮拿去吧。" NOR;
}
