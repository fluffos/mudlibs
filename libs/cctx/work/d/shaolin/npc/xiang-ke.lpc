// xiang-ke.c 进香客

inherit NPC;

void create()
{
	int value;

	value = random(10);

	set_name("进香客", ({ "jingxiang ke", "ke", "guest" }));
	set("gender", "男性");
	set("age", 14 + value * 3 );
         set("chat_chance", 20);
         set("chat_msg", ({
                "少林寺是佛门正中，我常来上香\n",
                (: random_move :),
        }) );


	set("combat_exp", 500 + 5 * value);
	set("shen_type", 0);
	setup();
	add_money("silver", 1 + value);
        
        carry_object("/d/city/obj/cloth")->wear(); 
}
