// Room: /d/nshaolin/xiuyechang.c

inherit ROOM;

void create() {
  set("short", "修业场");
  set("long", @LONG
这是少林弟子的修业场，实际上是练武场，地上是结实的硬土
，本该平坦，现在却凹凸不平。这里挂满了沙袋（shadai),这是少
林弟子练拳的地方。
LONG);

  set("item_desc", ([
    "shadai": "几个沉重的沙袋，可以试着打打(da)看。\n",
  ]));

  set("exits", ([
    "north": __DIR__ "murenchang",
    "west": __DIR__ "luohan5",
    "east": __DIR__ "xiuyechang1",
    "south": __DIR__ "xiuxifang",

  ]));


  setup();
}

void init() {
  add_action("do_da", "da");
}

int do_da(string arg) {
  object me = this_player();
  int cuffskll = (int)(me->query_skill("cuff", 1) / 2);
  int maxlevel, exp = (int)me->query("combat_exp");

  if (!arg || !((arg == "shadai") || (arg == "沙袋")))
    return notify_fail("你要打什么？\n");
  if (me->query("qi") < (int)(me->query("max_qi") / 5))
    return notify_fail("再打下去你会累死的！\n");
  if (me->query_temp("weapon"))
    return notify_fail("你看过有拿兵器打沙袋的吗？\n");
  if (!((string)me->query("family/family_name") == "少林派")) {
    message_vision("$N一拳向沙袋打去，可是沙袋一动不动。\n", me);
  } else {
    message_vision("$N用尽力气向沙袋打去，打得沙袋直晃。\n", me);
    if (exp * 10 <= (cuffskll * cuffskll * cuffskll)) {
      me->receive_damage("qi", (int)me->query("max_qi") / 10);
      return notify_fail("你的实际经练太少，不能从打沙袋中学到什么。\n");
    }
    if (cuffskll < ((int)me->query("con") + (int)me->query("str")) * 2) {
      me->improve_skill("cuff", random((int)(me->query("con") + me->query("str")) / 2));
      tell_object(me, "你领悟出一些基本拳脚方面的窍门。\n");
    } else {
      tell_object(me, "你在沙袋上费了半天劲，可是什么也没有学到。\n");
    }
  }
  me->receive_damage("qi", (int)me->query("max_qi") / 20);
  return 1;
}
