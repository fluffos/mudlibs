inherit ROOM;




void create() {
  set("short", "山道");
  set("long", @LONG
转过山坳，一条广阔的山道直通少室山，道上的行人渐渐多了起来，
有游山玩水的、也有诚心到少林礼佛的，还有不少是一心想到少林拜师学
艺的，偶尔有些的江湖人士在你身边一擦而过，向着少林方向匆匆而去。
LONG
  );

  set("exits", ([
    "west": __DIR__ "road9",
    "northeast": __DIR__ "shijie1",
  ]));

  set("objects", ([
    __DIR__ "npc/youke": 3,
    __DIR__ "npc/jianke": 1,
  ]));

  set("outdoors", "shaolin");
  setup();
}
