void create() {
  set("short", "碎石路");
  set("long", @LONG
你走在一条碎石路上，这里已经是河南省了，周围一马平川。不时有
骑着快马的江湖豪客飞驰而过。远远的就可以看到东北方有一座大山，就
是五岳之中的嵩山了，武林的泰山北斗少林寺就是在那里。
LONG
  );

  set("exits", ([
    "southwest": __DIR__ "road5",
    "northeast": __DIR__ "road7",
  ]));

  set("objects", ([
    __DIR__ "npc/jianke": 2,
  ]));

  set("outdoors", "shaolin");
  setup();
