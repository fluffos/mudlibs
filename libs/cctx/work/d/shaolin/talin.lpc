// Room: /d/shaolin/talin.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "少林塔林");
  set("long", @LONG
周围是一片有石头砌成的塔林，四四方方大小一样，使你无法
辨认方向。在这正中间有块石塔(stone)似乎可以移动。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "westdown": __DIR__ "zhulin1",
    "west": __DIR__ "talin1",
  ]));

  setup();

}
void init() {
  add_action("do_push", "push");
}
void close_passage() {
  object room;

  if (!query("exits/down")) return;
  message("vision", HIB "石塔忽然发出轧轧的声音，缓缓地移回原处。\n" NOR, this_object());
  if (room = find_object(__DIR__ "qfdian")) {
    room->delete("exits/up");
    message("vision", HIB "墙上的石块又缓缓地收了回去，阶梯消失了。\n" NOR, room);
  }
  delete("exits/down");
}


int do_push(string arg) {
  object ob;
  ob = this_player();

  if (!arg || arg == "") return 0;

  if ((arg != "stone") || (this_player()->query("family/generation") != 3)) {
    message_vision("$N要推什么？\n", this_player());
    return 1;
  }

  else {
    message("vision", HIB "石塔忽然发出轧轧的声音，向一侧缓缓移开，"
      "向下露出一个黑洞洞的入口。\n", this_player());
    set("exits/down", __DIR__ "midao1");
    remove_call_out("close_passage");
    call_out("close_passage", 1);
  }
  return 1;
}
