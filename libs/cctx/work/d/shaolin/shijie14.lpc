inherit ROOM;




void create() {
  set("short", "小铁梁峡");
  set("long", @LONG
由此而上山道越来越险要。靠左侧是万仞深谷，渺不见底，
每当的有大石堕下，初时轰然如雷，其后又声响极小，慢慢的
消失得无声无息。 
LONG
  );

  set("exits", ([
    "westdown": __DIR__ "gsfeng",
    "westup": __DIR__ "shijie15",
  ]));

  set("outdoors", "shaolin");
  setup();
}
