#include <room.h>
inherit ROOM;




void create() {
  set("short", "院子");
  set("long", @LONG
这是一个大院子，打扫得一尘不染。四周装点着青青翠竹，错落
有致。前面有座草屋，里面坐着一为老僧。
LONG
  );

  set("exits", ([
    "east": __DIR__ "talin1",
    "enter": __DIR__ "caowu",
    "north": __DIR__ "talin7",
  ]));

  set("outdoors", "shaolin");
  create_door("enter", "木门", "out", DOOR_CLOSED);
  setup();
  replace_program(ROOM);
}
