// Room /d/nshaolin/putiyuan.c
#include <room.h>
inherit ROOM;
void create()

{
  set("short", "菩提塔");
  set("long", @LONG
这里是少林菩提塔，虽然塔身已经石迹斑驳，但是仍然耸立挺拔
。塔顶供奉着菩提子，乃少林圣物。塔前有来往僧兵守护着。
LONG);

  set("exits", ([
    "up": __DIR__ "putiyuan2",
  ]));
  setup();
}
void init() {
  add_action("do_knock", "knock");
}
int do_knock(string arg) {
  object me;
  me = this_player();

  if (!arg || (arg != "men" && arg != "door"))
    return notify_fail("你要敲什么？\n");
  call_out("open_door", 1);
  return 1;
}
void open_door() {
  object room;
  if (!(room = find_object(__DIR__ "putiyuan")))
    room = load_object(__DIR__ "putiyuan");
  if (room = find_object(__DIR__ "putiyuan")) {
    set("exits/out", __DIR__ "putiyuan");
    room->set("exits/enter", __FILE__);
    message("vision", "小门被护塔僧打开了。\n", room);
    message("vision", "小门被护塔僧打开了。\n", this_object());
  }

  call_out("close_door", 10);
}

void close_door() {
  object room;

  if (!query("exits/out")) return;
  message("vision", "护塔僧又把小门关上了。\n", this_object());


  if (room = find_object(__DIR__ "putiyuan")) {
    message("vision", "护塔僧又把小门关上了。\n", room);
    room->delete("exits/enter");
  }

  delete("exits/out");
}
