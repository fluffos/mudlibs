inherit ROOM;




void create() {
  set("short", "松树林");
  set("long", @LONG
这是一片松树林。在你四周都长满了高大的松树和跟人差不多高的草丛，
在这里散发着一股清新的气息，偶尔从远方传来一阵木鱼声和念经声，跟鸟鸣
声混杂在一起，另人觉得在这里可以远离江湖上的一切仇杀和纷争。
LONG
  );

  set("exits", ([
    "south": __DIR__ "sslin3",
    "north": __DIR__ "sslin1",
  ]));

  set("outdoors", "shaolin");
  setup();
  replace_program(ROOM);
}
