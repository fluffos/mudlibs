inherit ROOM;




void create() {
  set("short", "官渡战场");
  set("long", @LONG
你走进了战场里面，在旁边的草丛里不时会发现一些生锈的兵器
和散乱的骨骸，看着眼前的一切，仿佛置身于当年的官渡大战当中，
令你不禁想起了一首名诗“滚滚长江东逝水，浪花淘尽英雄。是非成
败转头空，青山依旧在，几度夕阳红。白发渔礁江渚上，惯看秋月春
风，一壶浊酒喜相逢，古今多少事，都付笑谈中。”
LONG
  );

  set("exits", ([
    "southwest": __DIR__ "htlu",
    "north": __DIR__ "gdzc1",
  ]));
  set("objects", ([
    __DIR__ "npc/youke": 2,
    __DIR__ "npc/xiao-hai": 4,
  ]));

  set("outdoors", "shaolin");
  setup();
}
