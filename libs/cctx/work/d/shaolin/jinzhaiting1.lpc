// ROOM :/d/shaolin/jinzhaiting.c


inherit ROOM;

void create() {
  set("short", "进斋厅");
  set("long", @LONG
这里是罗汉堂里的进斋厅，里面的橱柜上摆满了斋饭，以供练武
的罗汉僧人充饥，桌子上的馒头水碗自己拿(na)。
LONG
  );
  set("exits", ([
    "south": __DIR__ "xiuyechang3",
  ]));
  set("no_clean_up", 0);
  setup();
}
void init() {
  add_action("do_order", "na");
}

int do_order(string arg) {
  object me;
  object food;
  object water;
  me = this_player();
  if (arg) return notify_fail("你拿什么?\n");
  message_vision("你从桌上拿起了一个馒头和一个水碗。\n", me);
  food = new(__DIR__ "obj/mantou");
  water = new(__DIR__ "obj/bowl");
  food->move(me); water->move(me);
  return 1;
}
int valid_leave(object me, string dir) {
  me = this_player();
  if (dir == "south" && (present("bowl", this_player()) || present("mantou", this_player())))
    return notify_fail("请在斋厅里进用，不要把食物带走。\n");
  return ::valid_leave(me, dir);
}
