// Room: /d/nshaolin/houdianmen.c

#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "后殿门");
	set("long", @LONG
这里已经属于少林的后山，门前有细刻石狮一对，蹲在高大的须
弥雕花座上。石狮左右原来插有高大的旗杆，经历了千年风雨，如今
只剩下旗杆座内的夹杆石了。
LONG
	);

	set("exits", ([
                "east" : __DIR__"murenxiang",
                "west" : __DIR__"shibalu3", 
			]));

	set("objects",([
		__DIR__"npc/seng-bing3" : 3,
		
	]));
        	setup();
}


int valid_leave(object me, string dir)
{

        if( !present("fangzhang lingpai", this_player()))
	
	{
		if (dir == "east" )
		{
			return notify_fail(YEL"僧兵说道: 你未经方丈许可，不能进入木人巷。\n"NOR);
		}
	}
	return ::valid_leave(me, dir);
}

