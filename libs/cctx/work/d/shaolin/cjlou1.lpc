// Room: /d/shaolin/cjlou1.c

inherit ROOM;
#include <room.h>



void create()
{
	set("short", "藏经阁一楼");
	set("long", @LONG
不愧为中原佛法的总源，少林寺此处藏经之富，天下罕有其
匹。这里都是密密麻麻，高及顶棚的书架，书架间仅有容身一人
通行的空隙。几排大书架中间，间隔地放着数丈长的书桌。目光
及处，你看到桌上放了几本佛经。
LONG
	);

	set("exits", ([
		"down" : __DIR__"fatang",
		"up" : __DIR__"cjlou2",
	]));

	set("objects",([
		__DIR__"obj/fojing1" : 1,
		__DIR__"obj/fojing2" : 1,
	]));
        create_door("down","木门","up",DOOR_CLOSED);
	setup();
}




