// Room: /d/shaolin/xcping.c
#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "心禅平");
	set("long", @LONG
这是戒律院前的心禅平，只见一队队僧人来来去去，身着各种服
色，有的携带刀，枪，棍，杖等兵器，个个身姿矫健，神态庄重。
东面的大殿就是戒律院，四位僧兵持刀守在两侧。
LONG
	);

	set("exits", ([
		"west" : __DIR__"kuishu1",
		"eastup" : __DIR__"jlyuan",
	]));
        set("objects",([
		__DIR__"npc/seng-bing3" : 2,
		__DIR__"npc/seng-bing4" : 2,
	]));

	set("outdoors", "shaolin");
	setup();
}


int valid_leave(object me, string dir)
{
	mapping fam;

	if (dir == "eastup")
	{
		if( mapp(fam = me->query("family")) 
		&&  fam["family_name"] == "少林派" 
		&&  fam["generation"] == 37  ) 
			return ::valid_leave(me, dir);
		
		if( me->query("guilty") == 0 
		&&  me->query("id") != "seng bing" )
		{
			return notify_fail(YEL"僧兵挡住说道：你未经许可，不能进入戒律院。\n"NOR);
		}
	}

	return ::valid_leave(me, dir);
}
