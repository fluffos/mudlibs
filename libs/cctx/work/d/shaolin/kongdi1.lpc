inherit ROOM;




void create() {
  set("short", "空地");
  set("long", @LONG
渐渐地你走出了松树林，出现在眼前的是一座雄伟壮观的大寺院，原来竟
然到了当今武林的泰山北斗少林寺的后门，门口和松树林之间有一片空地，在
这片空地上，井井有条的间开一条条菜地，种满了绿油油蔬菜，咚咚的流水声
不断传来，原来在不远处有一条清澈见底的小溪（xiaoxi），几个小和尚正在
挑水绕菜。
LONG
  );

  set("exits", ([
    "south": __DIR__ "kongdi2",
    "northeast": __DIR__ "sslin5",
  ]));

  set("outdoors", "shaolin");
  setup();
}
