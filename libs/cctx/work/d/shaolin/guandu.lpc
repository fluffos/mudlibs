inherit ROOM;




void create()
{
	set("short", "官渡");
	set("long", @LONG
你渐渐地远离了黄河岸边，四周出现了一些小山坡，再前面却是一大
片空地，离你不远的地方有一座破旧不堪的坟墓，墓前竖立着一块石碑，
碑上的字还清晰可见，题着“忠烈沮君之墓”，原来是当年曹操在此大败
袁绍，袁之谋臣沮涭为曹军所获，操虽厚待之，涭宁死不降，死于操手，
操念其忠烈，特立此碑以敬之。
LONG
	);

	set("exits", ([
		"south" : __DIR__"gdzc1",
		"northeast" : __DIR__"hhna",
	]));

        set("objects",([
                __DIR__"npc/youke" : 3,
        ]));
	
        set("outdoors", "shaolin");
	setup();
        replace_program(ROOM);
}


