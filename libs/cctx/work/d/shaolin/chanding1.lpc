
inherit ROOM;
void create()
{
        set("short", "禅房");
        set("long", @LONG
这与修业场截然不同，无一丝声音，几个僧人在盘膝修行，佛
家修为讲的是清静无为，武学一道殊途同归，少林内功本就是由佛
法而来，所以禅定后而修行内功，可以事半功倍。
LONG
        );
        set("exits", ([ 
         "south" : __DIR__"chanding",
]));
        set("no_fight", 1);
        setup();
}
void init()
{
        add_action("do_dazuo", "zuochan");

}

int do_dazuo()
{
        object me;
        int wait;
        me = this_player();
        wait = random( 50 - (int)(me->query("con"))) * 2;
        if ( wait <= 20) wait = 23;
        message_vision("$N静下心来开始坐禅\n",me);
        tell_object(me,".....\n");
        remove_call_out("addforce");
        call_out("addforce", wait, me);
        
return 1;
}
void addforce(object me)
{
        int neili;
        neili=(int)me->query("max_neili");
if( me && environment(me) == this_object())
        {
        
        me->set("neili", neili);
                }
return;
}

