// Room: /d/shaolin/anshi.c

#include <ansi.h>
string look_floor();
inherit ROOM;




void create()
{         object ob1,ob2,ob3,con;
	set("short", "暗室");
	set("long", @LONG
这里是一间暗室，正中央坐着一具尸骨，看上去象是已经坐化很
多年了，从身上衣着来看可能是少林前辈高僧。四周已无出路，细心
聆听好象有哗哗的流水声。地板(floor)乃木制,上面布满了灰尘。
LONG
	);
              set("item_desc",([
		"floor"		:	(: look_floor :),
	]));

	
		setup();
        con = new(__DIR__"obj/shigu");
        ob1 = new(__DIR__"obj/jingang-zhao");
	ob2 = new(__DIR__"obj/dahuan-dan");
        ob3 = new(__DIR__"obj/fumojian"); 
	if(con && ob1 && ob2)
	{
	ob1->move(con); ob2->move(con);ob3->move(con); con->move(this_object());
	}
}
void init()
{       
        add_action("do_open","qiao");        
        add_action("do_dive","dive");
}

int do_dive()
{
        object me;
        object room;
        me = this_player();
        if (me->query_temp("qiao_floor")){
        message_vision(HIY"$N深吸一口气，然后一个猛子扎了下去．．．\n"NOR,me);
        room = load_object(__DIR__"river");
        me->move(room);
        return 1;}       
}
int do_open(string arg)
{	
         if( !arg || arg=="" ) {
       message_vision("你想锹什么？\n", this_player());         
return 1;
}
        if( arg=="floor"||arg=="地板" ) {
		message_vision(
"$N锹开一块木板，露出了下面的暗河,看来出路只有这一条了。\n"
                , this_player());
		      
	        this_player()->set_temp("qiao_floor",1);
 
		return 1;
		}

	return 0;
}
string look_floor()
{
	return
	"有几块木板由于年岁已久已经松动了。\n";
}
