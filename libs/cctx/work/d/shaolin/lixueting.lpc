//ROOM: /d/shaolin/lixueting.c
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short",WHT"立雪亭"NOR);
        set("long", @LONG
又称达摩亭，是当年二祖神光为求佛法，恭候达摩，雪没双膝
的地方，现在建了这座小小亭子，不必再受雪没双膝之苦。内有佛
龛(fokan)，有乾隆御题“雪印明珠”，下有碑文记述二祖立雪断臂
的故事。
LONG
        );
        set("exits", ([ 
    "northdown" : __DIR__"shibalu2",
    "southdown" : __DIR__"shibalu1",
    "westup" :__DIR__"dmyuan", 
   
]));
       
        set("outdoors", "shaolin");
      
        setup();
}
int valid_leave(object me, string dir)
{
        mapping fam;

        if (dir == "westup")
        {
                if( mapp(fam = me->query("family")) 
                &&  fam["family_name"] == "少林派" 
                && fam["generation"] > 37 )
                {
                        return notify_fail("你级别不够，不能进入达摩院。\n");
                }
        }

        return ::valid_leave(me, dir);
}

