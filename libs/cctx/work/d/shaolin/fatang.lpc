// Room: /d/shaolin/fatang.c

inherit ROOM;
#include <room.h>



void create() {
  set("short", "法堂");
  set("long", @LONG
法堂也称讲堂，乃演说佛法集会之地，寺中主持每年的正月都会
在此讲经说法，普渡众生。众少林弟子也可由此入藏经阁研读佛学。

LONG
  );

  set("exits", ([
    "west": __DIR__ "shuichi",
    "up": __DIR__ "cjlou1",
  ]));

  set("objects", ([
    CLASS_D("shaolin") + "/dao-yi": 1,

  ]));
  create_door("up", "木门", "down", DOOR_CLOSED);
  setup();
}


int valid_leave(object me, string dir) {

  if (!present("shou yu", this_player())
    && (objectp(present("daoyi chanshi", environment(me))))) {
    if (dir == "up") {
      return notify_fail("道一说道: 你未经许可，不能进藏经阁。\n");
    }
  }
  return ::valid_leave(me, dir);
}
