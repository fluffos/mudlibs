// Room: /d/shaolin/xiuyechang.c

inherit ROOM;

void create ()
{
  set ("short", "修业场");
  set ("long", @LONG
这是少林弟子的修业场，实际上是练武场，地上是结实的硬土
，本该平坦，现在却凹凸不平。这里满地都是砖块(zhuankuai),是
少林弟子练指法的地方。
LONG);

  set("item_desc", ([ 
    "zhuankuai" : "几块厚砖快，可以试着点点(dian)看。\n",
]));
  
  set("exits", ([ 
      "north": __DIR__"murenchang2",  
      "east" : __DIR__"banruo5",
      "west" : __DIR__"xiuyechang3",
      "south" : __DIR__"xiuxifang1",  
     
]));

  
  setup();
}

void init()
{
   add_action("do_dian", "dian");
}

int do_dian(string arg)
{
  object me=this_player();
  int fingerskll=(int)(me->query_skill("finger", 1)/2);
  int maxlevel, exp=(int)me->query("combat_exp");
 
  if( !arg || !((arg == "zhuankuai") || (arg == "砖块")))
    return notify_fail("你要点什么？\n");
  if( me->query("qi") < (int)(me->query("max_qi")/5))
    return notify_fail("再练下去你会累死的！\n");
  if( me->query_temp("weapon") )
    return notify_fail("你看过有拿兵器练指法的吗？\n");
  if (!((string)me->query("family/family_name")=="少林派"))
    {
      message_vision("$N运气于指上，向砖块点去，可是一点用处也没有。\n", me);
    }
  else
    {
      message_vision("$N运气于指上，向砖块点去，砖块上留下了一指洞。\n", me);
      if (exp*10 <= (fingerskll*fingerskll*fingerskll))
        {
          me->receive_damage("qi", (int)me->query("max_qi")/10);
          return notify_fail("你的实际经练太少，不能练到什么。\n");
        }
      if(fingerskll<((int)me->query("con")+(int)me->query("str"))*2)
 {
          me->improve_skill("finger", random((int)(me->query("con")+me->query("str"))/2));
          tell_object(me, "你领悟出一些基本指法方面的窍门。\n");
        }
      else
        {
          tell_object(me, "你在砖块上费了半天劲，可是什么也没有学到。\n");
        }
    }
  me->receive_damage("qi", (int)me->query("max_qi")/20);
  return 1;
}

