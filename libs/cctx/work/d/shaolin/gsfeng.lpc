// Room: /d/nshaolin/sgfeng.c


inherit ROOM;
#include <ansi.h>

string look_shaolin();


void create()
{
	set("short", HIW"胜观峰"NOR);
	set("long", @LONG
这里就是嵩山的胜观峰，这里水声如雷，峭壁上两条玉龙直
挂下来，双瀑并泻，屈曲回旋，飞跃奔逸。好不壮观！向下遥望
（shaolin)，少林全景尽在眼底。
LONG	);

	set("exits", ([
                "eastup":__DIR__"shijie14",
		"down" : __DIR__"shijie13",
			]));

	set("item_desc",([
		"shaolin"		:	(: look_shaolin :),
	]));
	setup();
}


