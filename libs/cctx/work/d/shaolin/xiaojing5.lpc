inherit ROOM;

#include <ansi.h>
void create() {
  set("short", HIG "林间小道" NOR);
  set("long", @LONG
这是一条卵石铺成的小道，曲曲折折地通向前方。两边是密
密的竹林。这里人迹罕至，惟闻足底叩击路面，有僧敲木鱼声微
风吹拂竹叶，又如簌簌禅唱。令人尘心为之一涤。
LONG
  );

  set("exits", ([
    "west": __DIR__ "xiaojing4",
  ]));

  set("outdoors", "shaolin");

  setup();
}

void init() {
  add_action("do_search", "search");
  add_action("do_follow", "follow");
  call_out("stealing", 0, this_player());
}

int do_follow(string arg) {
  object me, room;
  me = this_player();

  if (me->query_temp("marks/search")) {
    tell_object(me, YEL "你沿着依稀的足迹，向深处走去。\n\n" NOR);
    room = find_object(__DIR__ "hcjlou");
    if (!objectp(room)) room = load_object(__DIR__ "hcjlou");
    me->move(room);
    return 1;
  }
  return 0;
}

int do_search(string arg) {
  object me, room;
  me = this_player();

  tell_object(me, YEL "蒙面人在这里消失了踪迹，你蹲下身查看泥土好象正北方的泥土有动过的痕迹。\n" NOR);
  message("vision", me->name(me) + "停下来，仔细搜索。/n", environment(me), me);
  tell_object(me, YEL "\n你再仔细看了看那个方向，隐约有些脚印,你决定跟(follow)着它走。\n" NOR, me);
  me->set_temp("marks/search", 1);

  return 1;
}
int stealing(object me) {
  message_vision(HIB "蒙面人消失在竹林中。" NOR, me);
  return 1;
}
