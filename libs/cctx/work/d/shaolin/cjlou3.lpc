// Room: /d/shaolin/cjlou3.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "藏经阁三楼");
  set("long", @LONG
不愧为中原佛法的总源，少林寺此处藏经之富，天下罕有其
匹。这里都是密密麻麻，高及顶棚的书架，书架间仅有容身一人
通行的空隙。几排大书架中间，间隔地放着数丈长的书桌。目光
及处，你看到桌上放了几本佛经。
LONG
  );

  set("exits", ([
    "down": __DIR__ "cjlou2",
    "up": __DIR__ "cjlou4",
  ]));

  set("objects", ([
    __DIR__ "npc/seng-bing3": 2,
    __DIR__ "npc/sengbing": 1,

  ]));
  setup();
}


int valid_leave(object me, string dir) {


  if (dir == "up") {
    return notify_fail(YEL "僧兵说道: 楼上乃少林重地，只有每届方丈才能上去。\n" NOR);

  }

  return ::valid_leave(me, dir);
}
