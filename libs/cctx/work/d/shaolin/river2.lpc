//  /d/nshaolin/river2.c
inherit ROOM;
void create() {
  set("short", "暗流");
  set("long", @LONG
这里是暗室下面的暗流，四周漆黑，水流湍急。只有顺着水慢慢
往下游。
LONG
  );

  set("outdoors", "nshaolin");
  set("objects", ([
    "/d/shaolin/npc/fish": 2,
  ]));

  setup();
}
void init() {
  if (interactive(this_player()))
    call_out("do_swim", 8, this_player());

}

void do_swim(object me) {
  object room;

  if (!me || environment(me) != this_object())
    return;
  tell_object(me, "一阵暗流涌来，你被冲了下去.....\n");
  room = load_object(__DIR__ "river3");
  me->move(room);

}
