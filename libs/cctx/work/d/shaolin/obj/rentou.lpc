#include <ansi.h>
inherit ITEM;
void create()
{
        set_name( HIR"成昆的人头"NOR, ({ "ck poll"}));
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long","这是一颗[0;5;31m[5m[5m[5m[5m[5m[0m的人头。\n");
                set("value", 0); 
                set("material", "meat"); 
              }
}

