// /d/nshaolin/obj/yijinjing.c

#include <ansi.h>
inherit ITEM;

void init();
void tear();

void create() {
  set_name(YEL "〖易筋经〗" NOR, ({ "yijinjing", "slyjj" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", YEL
      "这就是江湖上人人都想得到的易筋经\n" NOR);
    set("material", "paper");
    set("no_drop", "这么宝贵的经书也要丢掉吗？");
    set("value", 500);
    set("skill", ([
      "name": "force",
      "exp_required": 500000,
      "jing_cost": 10 + random(30),
      "difficulty": 45,
      "max_skill": 250,
    ]));
  }
  setup();
}

void init() {
  add_action("do_tear", "tear");
}

int do_tear(string arg) {
  object ob, me;
  me = this_player();
  if (!this_object()->id(arg)) return 0;
  ob = new("/d/shaolin/obj/yangpishu");
  ob->move(me);
  message_vision("$N撕开〖易筋经〗的夹层，一张羊皮书飘了出来.....\n", me);
  destruct(this_object());
  return 1;
}
