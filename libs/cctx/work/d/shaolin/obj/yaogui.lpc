
#include <ansi.h>
inherit ITEM;
void init()
{
         add_action("do_open","ge");
}
void create()
{
        set_name(RED"药柜"NOR, ({ "yaogui" }) );
        set_weight(5000000);
        set_max_encumbrance(40000);
        if( clonep() ) {
                object a,b,c;
                  seteuid(getuid());
                if(a=new("/d/shaolin/obj/huitiansan"))
                  a->move(this_object());
                  seteuid(getuid());
                if(c=new("/d/shaolin/obj/huitiansan"))
                  c->move(this_object());
                 seteuid(getuid());
                if(b=new("/d/shaolin/obj/huitiansan"))
                  b->move(this_object());
                  set_default_object(__FILE__);
        } 
           else {
                set("unit", "个");
                set("long", YEL"这是一个摆放药品的柜子，两扇门之间蒙着一层牛皮纸。\n"NOR);
                set("value", 0);
        }
}

int do_open(string arg)
{ 
            object me=this_player();
             object ob; 
             if( (!arg) || !((arg == "niupizhi") ))
                return notify_fail("你要割什么？\n");
        if( !(ob = me->query_temp("weapon")) || (                (string)ob->query("skill_type")!="sword" ))  
                return notify_fail("没有工具怎么干活？\n");
       if ((int)me->query_temp("marks/quyao") )  {
           message("vission", RED "你发现牛皮纸已经被人划破了。\n"NOR, me);
       set("long", BLU"这是一个摆放药品的柜子，两扇门之间蒙着一层牛皮纸。现在却被人划破了。\n"NOR);
 
                 return 1;
           }
             ob=new("/d/shaolin/obj/dabuwan.lpc");
             ob->move(environment(me));
             message("vission", RED"你“刺啦”一声，将牛皮纸从中间划开．．．只见一个东西掉了下来。\n"NOR, me);
              me->set_temp("marks/quyao",1);
        return 1;

             
}

