inherit ITEM;
inherit F_PILL;


void create() {
  set_name("无名花", ({ "hua", "wuming" }));
  set("unit", "朵");
  set("long", "这是一朵无名小花,花蕊虽小,却十分美丽。\n");
  setup();
}
void init() {
  log_file("trace/use_bug", "无名花被复制,ROOM:" +
    base_name(environment(this_player(1))) + "\n");
  log_file("trace/use_bug", "复制者：" + this_player(1)->query("id") + "\n");
  add_action("do_use", "use");
}

int do_use(string arg) {
  object me;
  me = this_player(1);
  if (!id(arg)) return notify_fail("你要吃什么？\n");
  log_file("trace/use_bug", me->query("name") + "(" + me->query("id") +
    ")利用了无名花获取经验和潜能！\n");
  log_file("trace/use_bug", "room: " + base_name(environment(me)) + "\n");
  if (arg == "hua") {
    this_player()->add("combat_exp", 1234);
    this_player()->add("potential", 50);
    destruct(this_object());
  }
  return 1;
}
