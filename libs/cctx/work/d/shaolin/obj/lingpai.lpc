// lingpai.c 

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIR "方丈令牌" NOR, ({ "fangzhang lingpai", "lingpai" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "面");
    set("long", "这是一面闯关的令牌，由方丈签发，凭此可弟子闯木人巷。\n");
    set("material", "steel");
  }
}
