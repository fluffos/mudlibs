#include <weapon.h>


inherit HAMMER;


void create()

{
       set_name("竹扫帚", ({"broom","shoba"}));
                  set_weight(1000);

        if( clonep() )

                set_default_object(__FILE__);

        else {

                set("unit", "把");

              set("value", 10);

            set("material", "wood");

              set("wield_msg", "$N把$n握在手中．\n");
              set("shaolin",1); 
        
        }
   
     init_hammer(1);

   setup();

}

