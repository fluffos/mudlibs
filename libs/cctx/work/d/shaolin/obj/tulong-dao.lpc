// /d/shaolin/obj/tulong-dao.c

#include <ansi.h>
#include <weapon.h>
inherit BLADE;

void init();
void where();
int do_where(string arg);
void create() {
  set_name(HIW "屠龙刀" NOR, ({ "tulong dao", "dao", "tulong" }));
  set("no_give", 1);
  set("no_pawn", 1);
  set("no_get", 1);
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set(
      "long",
      "这就是无数武林豪杰梦寐以求的屠龙刀其刀刃间隐隐有血光流动，锋利无匹，\n" + RED "“武林至尊、宝刀屠龙、号令天下、莫敢不从！”" + NOR "这正是它的写照。\n"
    );
    set("material", "iron");
    set("wield_msg", HIY "$N抽出一把明晃晃的" + HIW "$n" + HIY "握在手中。\n" NOR);
    set("unequip_msg", HIY "$N将手中的" + HIY "$n插入腰间的刀鞘。\n" NOR);
    set("no_drop", HIW "屠龙刀" + RED "乃武林至宝不能随意丢弃。\n" NOR);
    set("value", 50000);

  }
  init_blade(1500);
  setup();
}

void init() {
  add_action("do_where", "where");
}

int do_where(string arg) {
  int m;
  object ob, me, where;
  if (!arg || arg == "") {
    message_vision(HIR "“武林至尊、宝刀屠龙、号令天下、莫敢不从！”" + HIY "你想感应谁？\n" NOR, this_player());
    return 1;

  }
  me = this_player();
  ob = find_player(arg);
  if (!ob) ob = find_living(arg);
  if (!ob) {
    message_vision(HIY "你无法感应这个人？\n" NOR, this_player());
    return 1;

  }
  m = (int)me->query("con");
  if (random(200) > m) {
    message_vision(HIY "一股灵力从屠龙刀传来，你似乎感应到了什么。\n" NOR, me);

    return 1;
  }

  where = environment(ob);
  if (!where) {
    message_vision(HIY "你无法感应这个人？\n" NOR, this_player());
    return 1;

  }
  printf(HIY "你双手举刀，一股灵力从屠龙刀传来，你感应到%s(%s)现在在%s.\n" NOR,
    (string)ob->name(),
    (string)ob->query("id"),
    (string)where->query("short"));
  me->add("jing", -80 + random(30));
  return 1;
}
