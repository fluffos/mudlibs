// /d/nshaolin/obj/yangpishu.c


inherit ITEM;

void init();
void tear();

void create() {
  set_name("羊皮书", ({ "yangpi shu", "shu", "book" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long",
      "这是一张刻着文字的羊皮书\n");
    set("material", "paper");
    set("value", 0);
    set("skill", ([
      "name": "jiuyang-shengong",
      "exp_required": 500000,
      "jing_cost": 10 + random(30),
      "difficulty": 50,
      "max_skill": 250,
    ]));
  }
  setup();
}
