// basket-ball.c 饭篮 
inherit ITEM;

void create()
{
	set_name("饭篮", ({ "basket", "fan lan", "lan" }));
	set_weight(500);
	set_max_encumbrance(10000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "这是一个盛饭的篮子\n");
		set("value", 100);
	}
}

int is_container() { return 1; }
