inherit ITEM;
#include <ansi.h>

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "回天散" NOR, ({ "san", "huitian" }));
  set("unit", "个");
  set("long", "有起死回生之效的回天散。\n");
  setup();
}

int do_eat(string arg) {
  if (!id(arg)) return notify_fail("你要吃什么？\n");
  if (arg == "san") {
    this_player()->set_temp("nopoison", 1);
    this_player()->set("eff_jing", this_player()->query("max_jing"));
    this_player()->set("jing", this_player()->query("max_jing"));
    this_player()->set("eff_qi", this_player()->query("max_qi"));
    this_player()->set("qi", this_player()->query("max_qi"));
    this_player()->set("neili", this_player()->query("max_neili"));
    tell_object(this_player(), HIR "你全身真气流畅，精神焕发，犹如再生一般！\n" NOR);
    destruct(this_object());
  }
  return 1;
}
