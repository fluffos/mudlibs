#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIG "伏魔剑" NOR, ({ "fumo jian", "jian" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一把难得的好剑，周身隐隐透着绿光。是少林斩妖除魔的利剑\n");
    set("value", 10000);
    set("no_drop", "这样东西不能离开你。\n");
    set("material", "steel");
    set("wield_msg", "只见$N右手一抖，一把寒光四射的$n已经握在手中了。\n" NOR);
    set("unwield_msg", "$N将手中的轻轻一抖$n插回剑鞘。\n");
  }
  init_sword(150);
  setup();
}
