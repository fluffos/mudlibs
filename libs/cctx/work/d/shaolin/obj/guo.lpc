// yeguo.c
#include <ansi.h>

inherit ITEM;



void init()
{
        add_action("do_eat", "eat");
}



void create()

{
  
        set_name(RED"野松果"NOR, ({"ye songguo","songguo","guo"}));

        set_weight(80);

        set("long", RED"一个褐色的野松果．\n"NOR);

        set("unit", "个");
}        
int do_eat(string arg)
{
    if (!id(arg))
    return notify_fail("你要吃什么？\n");
    if(arg=="guo") 
{tell_object(this_player(), RED "你吃下一个果子，直觉得甘甜美味，十分爽口！\n" NOR );
this_player()->add("max_jingli",1);
this_player()->add("jingli",1);
destruct(this_object());
}
return 1;
}

   
