// /d/nshaolin/obj/damo-xiang
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIW "达摩石像" NOR, ({ "damo shixiang", "xiang" }));
  set_weight(600000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "尊");
    set("long",
      "一尊达摩石像\n");
    set("value", 70);
    set("material", "stone");
    set("no_shown", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("skill", ([
      "name": "buddhism",
      "exp_required": 10000,
      "sen_cost": random(50),
      "difficulty": 40,
      "max_skill": 200
    ]));
  }
}
