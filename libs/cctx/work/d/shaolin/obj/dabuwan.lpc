
#include <ansi.h>

inherit ITEM;


void init()
{
	add_action("do_eat", "eat");
	}

void create()
{
	set_name(HIW"少林大补丸"NOR, ({"dabuwan","wan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "武林难得一见的少林珍品。\n");
		set("value", 20000);
	}
	setup();
}

int do_eat(string arg)
{
	int force_limit, neili_limit ;
           
	object me = this_player();

	force_limit = me->query_skill("force")*10;
	neili_limit = me->query("max_neili");
	
	if (!id(arg)||(arg!="wan"&&arg!="dabuwan"))
	return notify_fail("你要吃什么？\n");

        if ( neili_limit / 2 <= force_limit  )
	{
                me->add("max_neili",1+random(5));
                me->add("neili",1+random(5)); 

		message_vision(HIR "$N吃下一个大补丸，只觉全身气血翻腾，无数真气顺流丹田...\n" NOR, this_player());
	}
	else
		message_vision(HIR "$N吃下一个大补丸，但是好象没什么用.\n" NOR, this_player());

	destruct(this_object());
	return 1;
}

