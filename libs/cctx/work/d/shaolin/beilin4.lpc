// Room: /d/shaolin/beilin4.c
inherit ROOM;
void create()
{
        set("short", "西碑林");
        set("long", @LONG
这碑林最西，最为出名的当属“天龙赐碑”碑身四龙盘顶，造
型别致，碑文正书，笔力遒劲，古来文武相通，到此的武学名家亦
尝赞不绝口。历代少林和尚大都要来此朝拜，摸(mo)石碑以赐佛身
。
LONG
        );
        set("exits", ([ 
          "east" : __DIR__"beilin2",
]));
	
	setup();
}

void init()
{
   add_action("do_search", "mo");
   add_action("do_push", "push");
}


int do_push(string arg)
{
    object me;
    int n;
    me = this_player();

    n = (int)me->query("jiali");
    if (!arg || (arg != "bei" ))
     return 0;
   if (me->query_temp("marks/mobei")) {
      if(n >50+random(100)) {
         tell_object(me, "你双臂运力，使出浑身的力气推石碑！\n");
         message_vision("随着“轰隆隆”声，石碑慢慢的移开露出了一个洞口！ \n",me);
         set("exits/enter", __DIR__"anshi");
         call_out("close_hole", 1);
         return 1;
      } 
      else {
         tell_object(me, "你双臂运力，使出吃奶的力气向石碑推去，可是石碑纹丝不动。\n");
         me->add("qi",-80);
         return 1;
      }
   }
   return 0;
}

void close_hole()
{
   if(!query("exits/enter") ) return;
   message("vision", "只听“咯吱吱”几声，石碑滑回来又挡上了洞口。\n", this_object() );
   delete("exits/enter");

}

int do_search(string arg)
{
   object me, obj;
   int m;

   me = this_player();
   m = (int)me->query("kar");
     if (!arg || (arg != "bei" ))
     return 0;
    if(m>10+random(100)) {
      message_vision("$N虔诚的单手放在石碑上，心中默默念经。\n", me);
      tell_object(me, "你不小心摸到了一个机关，石碑摇了摇似乎动了一下,\n""看来石碑年岁已久，机关已经废弃,只有自己推(push)石碑了。\n");
      me->set_temp("marks/mobei", 1);
      return 1;
   }
   message_vision("$N虔诚的单手放在石碑上，心中默默念经。\n", me);
   me->add("jing",-8);   
   return 1;
}


