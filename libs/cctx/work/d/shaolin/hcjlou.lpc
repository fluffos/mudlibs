#include <room.h>
#include <ansi.h>

inherit ROOM;
int do_jump(string arg);

void create() {
  set("short", "藏经阁后");
  set("long", @LONG
不知不觉的你追到了藏经阁后面，你举目上望发现藏经阁四楼的
窗户(window)是开着的。四周空无一人，蒙面人也不知去向。这里地
势偏僻少林僧兵一般不会巡逻到这儿。
LONG
  );

  set("exits", ([
    "around": __DIR__ "fatang",
  ]));

  set("item_desc", ([
    "window": "一扇开着的窗户。\n",
  ]));
  setup();
}

void init() {
  object book, me;
  me = this_player();
  add_action("do_jump", "jump");
}



int do_jump(string arg) {
  int n;

  n = this_player()->query_skill("dodge", 1);
  if (!arg || arg != "window") {
    write(CYN "你跳了起来。\n" NOR);
    return 1;
  }

  if (n < 120) {
    message_vision(
      HIR "$N的功夫还不够，跳不上去的!\n" NOR, this_player());
    return 1;
  }

  else {
    message_vision(
      HIY "只见$N身如飞燕，轻轻松松的飞了上去.....\n" NOR, this_player());
    this_player()->move("/d/shaolin/cjlou4");
  }
  return 1;
}
