#include <room.h>

inherit ROOM;

void create() {
  set("short", "金刚殿");
  set("long", @LONG
两尊力士执金刚杵分立左右。都是面貌雄伟，作忿怒相，头戴宝
冠，上半身赤裸，两脚张开，呈紧张状，左像怒颜张口，以杵作打物
之势，右像忿颜闭口，平托金刚杵，怒目睁视。
LONG
  );
  set("exits", ([
    "west": __DIR__ "celang"
  ]));

  setup();
  create_door("west", "木门", "east", DOOR_CLOSED);
}
