// Room: /d/nshaolin/shidao1.c

inherit ROOM;
void create()
{
        set("short", "石阶");
        set("long", @LONG
随着青石阶缓缓而上，抬头上望，可看见前面的般若堂。
LONG
        );
        set("exits", ([ 
  "eastdown" : __DIR__"wuchang1",
  "westup" : __DIR__"banruo",
]));
        set("objects", ([
                __DIR__"npc/seng-bing3" : 2,
       ]) );
        set("outdoors", "shaolin");
	
	setup();
        
}
int valid_leave(object me, string dir)
{
	int skill;

	skill = me->query_skill("buddhism", 1);
	if (!wizardp(me) && skill < 70)
	{
		if (dir == "westup")
		{
			return notify_fail("你级别不够，不能进入。\n");
		}
	}
	return ::valid_leave(me, dir);
}


