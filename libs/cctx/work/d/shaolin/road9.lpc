inherit ROOM;




void create() {
  set("short", "山道");
  set("long", @LONG
折而向南，过了一岭，只见古柏三百余株，皆挺直端秀，凌霄托根树旁，
作花柏顶，灿若云荼，柏上百鸟争鸣，好一处世外桃源般地方，听着流水淙
淙，令人心旷神怡。
LONG
  );

  set("exits", ([
    "east": __DIR__ "road10",
    "northwest": __DIR__ "road8",
  ]));

  set("outdoors", "shaolin");
  setup();
  replace_program(ROOM);
}
