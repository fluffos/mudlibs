
inherit ROOM;


void create()
{
        set("short", "大松树顶");
        set("long", @LONG
站在大松树的顶端，山风阵阵，空气清新．向周围望去，隐约看到一
片房屋在一股淡淡的紫气笼罩之下。
LONG
        );
        set("objects", ([
            
		__DIR__"obj/guo": 1])); 
        set("no_clean_up", 0);
       set("outdoors","shaolin");        
        setup();
}
void init()
{
        add_action("do_jump","jump");
}

int do_jump(string arg)
{
        object ob;
        ob = this_player();
        if( !arg || arg=="" ) return 0;
        if( arg != "down" )
                
        message("vision", "只见" + ob->query("name") + "你跳下来。\n", environment(ob), ob);

        
        ob->move("/d/shaolin/uptree");
        return 1;
}

