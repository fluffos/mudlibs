// room: /d/nshaolin/cjlou4

#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "藏经阁");
  set("long", @LONG
藏经楼顶，这里的每件物品都是稀世之宝千余年来少林寺执中原
武林之牛耳，自达摩老祖以下，历代人材辈出。其中有不少高僧遗著
留存，汇集至今，终成名震天下的少林七十二绝艺。少林精华，尽集
于此。顶楼四面开窗，确保通风。中间排列着五排大书架。四周则陈
列矮几，以供阅读。几位老僧手执经卷，正在闭目凝思。
LONG
  );
  set("exits", ([
    "down": __DIR__ "cjlou3",
  ]));
  set("objects", ([
    __DIR__ "obj/yijinjing": 1,
  ]));
  setup();

}

void init() {
  add_action("do_get", "get");
  if (userp(this_player())) call_out("stealing", 20 + random(20), this_player());
}
int do_get(string arg) {
  string what;
  object ob, me;
  me = this_player();
  if (!userp(me)) return 0;
  if (!arg) return 0;
  if (sscanf(arg, "%s", what) != 1) return 0;
  if (what == "all" || what == "yijinjing") {
    message_vision("一不小心触动了机关，四周铃声大起\n", me);
    ob = new(__DIR__ "npc/seng-bing3");
    if (ob) ob->move(this_object());
    message_vision("$N冲了进来喝道“大胆强盗竟敢闯进少林偷东西．．．\n", ob);
    ob->kill_ob(this_player());
    return 1;
  }
}

int stealing(object me) {
  object ob;
  if (environment(me) == this_object()) {
    ob = new(__DIR__ "npc/murongbo");
    message_vision(HIB "一阵清风刮过，一个蒙面人从窗外跳了进来\n" NOR "你为了看个究竟，赶快转身躲进了柜子后", me);
    if (ob) ob->move(this_object());
  }
  return 1;
}
