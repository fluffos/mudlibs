// /d/shaolin/river3
inherit ROOM;
void create()
{
        set("short", "暗流");
        set("long", @LONG
......水流越来越急，几乎已经快支持不住足了......
LONG
        );
        
	set("outdoors","shaolin");
        
        
	setup();
}
void init()
{
	call_out("do_swim",6,this_player());
}

void do_swim(object me)
{
        tell_object(me,"一阵暗流涌来，你被冲了下去 ．．\n");
	me->move("/d/shaolin/shuitand");
}	
