	// Room: /d/nshaolin/xiuyechang.c

inherit ROOM;

void create ()
{
  set ("short", "修业场");
  set ("long", @LONG
这是少林弟子的修业场，实际上是练武场，地上是结实的硬土，
本该平坦，现在却凹凸不平。场中央放着几根梅桩(meizhuang)几个
武僧正踩在上面练功夫。
LONG);

  set("item_desc", ([ 
    "meizhuang" : "这就是少林千百年来留传下来的练功方法你也可以跳跳（tiao)看。\n",
]));
  
  set("exits", ([ 
          "north" :__DIR__"jinzhaiting", 
          "west" : __DIR__"xiuyechang",
          "south" : __DIR__"murenchang1",
      
]));
   set("objects",([
		__DIR__"npc/wuseng" : 2,
	]));

  
  setup();
}

void init()
{
   add_action("do_tiao", "tiao");
}

int do_tiao(string arg)
{
  object me=this_player();
  int dodgeskll=(int)me->query_skill("dodge", 1)/2;
  int exp=(int)me->query("combat_exp");
 
  if( (!arg) || !((arg == "meizhuang") || (arg == "梅桩")))
    return notify_fail("你要往哪里跳？\n");
  if( me->query("qi") < (int)(me->query("max_qi")/8))
    return notify_fail("别再跳了，功夫也别急在这一时，你先歇歇！\n");
  if (!((string)me->query("family/family_name")=="少林派"))
    {
      message_vision("$N纵身飞上梅桩，结果摔了下来，看来还找到练功窍门。\n", me);
    }
  else
    {
      message_vision("$N纵身飞上梅桩，小心翼翼的在梅桩上游走。\n", me);
      if (exp*10 <= (dodgeskll*dodgeskll*dodgeskll))
        {
          me->receive_damage("qi", (int)me->query("max_qi")/10);
          return notify_fail("你的经练不够高，不法从梅桩坑中领悟到什么。\n");
        }
      if (dodgeskll<((int)me->query("con")+(int)me->query("str")))
        {
          me->improve_skill("dodge", random(60-(int)(me->query("str")+me->query("con"))/4));
          tell_object(me, "你领悟出一些基本轻功方面的窍门。\n");
        }
      else
        {
          tell_object(me, "你跳上梅桩练功，可是什么也没有学到。\n");
        }
    }
  me->receive_damage("qi", (int)me->query("max_qi")/20);
  return 1;
}
