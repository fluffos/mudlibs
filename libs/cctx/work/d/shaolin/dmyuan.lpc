//Room: dmyuan.c 达摩院
//Date: 99.4.14
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "达摩院" NOR);
  set("long", @LONG
这是一座古朴的殿堂。西首的墙上挂满了各类武功图谱，不
少白须白眉的老僧们正端坐在图谱画轴之前，似乎在苦苦思索。
南北山墙是高及屋顶的大书架，走近细看，它们是各门各派的武
功秘笈，屋正中摆着几张矮几诃和几个团，几位老僧正在入定中。
西首有个楼梯上楼。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "eastdown": __DIR__ "lixueting",
    "up": __DIR__ "dmyuan2",
  ]));
  setup();
}

void init() {
  add_action("do_learn", "lingwu");
}


int do_learn(string arg) {
  object ob;

  ob = this_player();
  if (!arg) {
    message_vision(YEL "你要领悟什么。\n" NOR, ob);
    return 1;
  }
  if ((int)ob->query_skill("buddhism", 1) < 150) {
    message_vision(YEL "$N禅宗心法不够，对着满是梵文的石画，无法领悟。\n" NOR, ob);
    return 1;
  }
  if ((int)ob->query_skill("literate", 1) < 200) {
    message_vision(YEL "$N悟性不够，不能领悟高深武功。\n" NOR, ob);
    return 1;
  }

  if (
    arg == "sword" ||
    arg == "finger" ||
    arg == "cuff" ||
    arg == "strike" ||
    arg == "club" ||
    arg == "staff" ||
    arg == "club" ||
    arg == "unarmed" ||
    arg == "blade" ||
    arg == "claw" ||
    arg == "hand" ||
    arg == "parry" ||
    arg == "whip" ||
    arg == "stick" ||
    arg == "throwing"
  ) {
    if ((int)ob->query_skill(arg, 1) < 200) {
      message_vision(WHT "$N的" + HIR + to_chinese(arg) + WHT + "显然太低，无法领悟更高的武功。\n" NOR, ob);
      return 1;
    }
    if (((ob->query_skill(arg, 1)
      * ob->query_skill(arg, 1)
      * ob->query_skill(arg, 1) / 10) > (int)ob->query("combat_exp"))
      && arg != "literate") {
      message_vision(YEL "$N的实战经验不足，无法领悟墙上图案。\n" NOR, ob);
      return 1;
    }
    if (ob->query("jing") < 20) {
      message_vision(YEL "$N太累了，该休息休息了。\n" NOR, ob);
      return 1;
    }
    message_vision(WHT "$N盘坐静思，良久，对" + HIR + to_chinese(arg) + WHT + "似有所悟。\n" NOR, ob);
    ob->improve_skill(arg, random(10 * ob->query("int")));
    ob->add("jing", -25 + random(10));
    return 1;
  }
  message_vision(WHT "$N盘坐静思，良久，似有所悟。\n" NOR, ob);
  ob->add("jing", -25 + random(10));
  return 1;
}
int valid_leave(object me, string dir) {
  int skill;

  skill = me->query_skill("hunyuan-yiqi", 1);
  if (!wizardp(me) && skill < 100) {
    if (dir == "up") {
      return notify_fail("你功夫不够，不能进入达摩院。\n");
    }
  }
  return ::valid_leave(me, dir);
}
