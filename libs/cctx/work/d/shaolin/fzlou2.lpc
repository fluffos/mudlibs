#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "方丈室");
  set("long",
    "方丈室陈设简洁，正中一几，一蒲团，一矮床。北面墙上写\n"
    "着大大的一个" + HIY "『禅』" + NOR "字。一位慈眉善目的灰衣老僧正端坐于蒲团\n"
    "上打坐。\n"

  );

  set("exits", ([
    "south": __DIR__ "fzlou1",
  ]));

  set("objects", ([
    CLASS_D("shaolin") + "/xuan-ci": 1,
    __DIR__ "npc/xiao-ci": 1,
  ]));
  setup();
}
