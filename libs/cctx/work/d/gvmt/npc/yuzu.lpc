// Freeze(Rtm) 
// 狱卒 

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("狱卒", ({ "yu zu","yu","zu" }) );
	set("long",
		"狱卒眼神里带着股杀气。\n");
	set("attitude", "peaceful");
	
	setup();
}

void init()
{
	object me, ob;

	me = this_object();
	ob = this_player();

	
	message_vision(HIR"$N朝"+(string)ob->query("name")+"狠狠地踢了一脚，留下一个清晰的鞋印，转身锁上牢门离开。\n"NOR,);
//			
//        ::init();

	if( !ob->is_character() )
	{ 
		tell_object(ob,HIR "狱卒说到：醒啦！你给我挪个地方吧...滚！\n" NOR);
		
		ob->move("/wizhome/rtmhome/gvmt/jianyu_do");
		message_vision(HIC"$N啐了口唾沫，朝"+(string)ob->query("name")+"狠狠地踢了一脚，留下一个清晰的鞋印，转身锁上牢门离开。\n"NOR,
				environment(ob), ob);
	}
        return init();	
}