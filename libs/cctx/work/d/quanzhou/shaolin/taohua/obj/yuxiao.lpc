// /d/taohua/obj/yuxiao.c
// adx 3:56 99-2-6
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(HIC "玉萧" NOR, ({ "yuxiao" }));
  set_weight(500);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", HIC "一支白玉做成的长萧，看上去晶莹温润。武林中人经常以萧代剑。\n" NOR);
    set("value", 10000);
    set("material", "bamboo");
    set("wield_msg", HIC "$N大袖一挥，手中已多了一支晶莹温润的玉萧。\n" NOR);
    set("unwield_msg", HIC "$N手中玉萧一转，眨眼间玉萧已然不见影踪。\n" NOR);
  }
  init_sword(200);
  setup();
}
