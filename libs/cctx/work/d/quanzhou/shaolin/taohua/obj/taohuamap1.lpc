#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIC "『桃花岛地图』" NOR, ({ "di tu", "tu", "map" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long",
      "\n                 『桃花岛地图』\n\n"
      "                    海滩                                                 \n"
      "                     |                                                   \n"
      "                  桃花迷阵                                               \n"
      "                     |                                                   \n"
      "                  桃花迷阵      墓地                                     \n"
      "                     |           |                                       \n"
      "                   试剑亭       小路—小路—小路—山洞                   \n"
      "                     |           |                                       \n"
      "                    大门—小路—小路                                     \n"
      "                     |                                                   \n"
      "         厨房      积翠亭 玄风居 乘风居 灵风居 默风居                    \n"
      "             \    /  |   \  |      |      |      |                       \n"
      "      休息室—小院—前院— 走廊— 走廊— 走廊— 走廊—练功房             \n"
      "               |     |      |                    |                       \n"
      "黄容居—走廊—走廊—正厅— 竹楼—炼丹房        兵器室                    \n"
      "         |           |                                                   \n"
      "     超风居 练功房—后院—思过室                                         \n"
      "                     |                                                   \n"
      "             书房—荷花池                                                \n"
      "                     |                                                   \n"
      "           练功房—桃花轩                                                \n"
      "                     |                                                   \n"
      "                   弹指峰                                             \n");
    set("value", 0);
    set("no_give", "你不能把桃花岛的东西随便给人。\n");
    set("material", "silk");
    set("skill", ([
      "name": "qimen_wuxing",
      "exp_required": 0,
      "jing_cost": 20,
      "difficulty": 20,
      "max_skill": 100
    ]));
  }
  setup();
}
