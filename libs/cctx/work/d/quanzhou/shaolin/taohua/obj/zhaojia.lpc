#include <ansi.h>
inherit ITEM;

void create() {
  set_name(MAG "《催心掌》招架篇" NOR, ({ "cuixin zhaojia", "shu", "book" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", MAG "这是修习催心掌的基本招架。\n" NOR);
    set("value", 0);
    set("no_give", "你不能把桃花岛的东西随便给人。\n");
    set("material", "silk");
    set("skill", ([
      "name": "parry",
      "exp_required": 0,
      "jing_cost": 40,
      "difficulty": 20,
      "max_skill": 100
    ]));
  }
}
