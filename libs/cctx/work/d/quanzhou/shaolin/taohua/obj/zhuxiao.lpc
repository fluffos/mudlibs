// adx 3:55 99-2-6
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
    set_name("竹萧", ({"zhu xiao", "xiao"}));
    set_weight(500);

	if (clonep())
		set_default_object(__FILE__);
	else {
        set("unit", "支");
        set("long", "一支绿竹做成的长萧，武林中人经常以萧代剑。\n");
	set("value", 15);
	set("material", "bamboo");
	set("wield_msg", "$N拿出一把$n，握在手中。\n");
	set("unequip_msg", "$N放下手中的$n。\n");
	}
    init_sword(15);
	setup();
}	
