inherit ROOM;




void create() {
  set("short", "崎岖山路");
  set("long", @LONG
你不停的走着，面前依然是一条崎岖狭隘的山路上，两边都是悬崖
绝壁，高高的耸山笼罩在云雾中，隐约可见。一阵阵的山风猛吹过来，
不时夹带着一些恐怖的动物叫声，你心想还是快点走吧，不然再被那些
可怕的野兽发觉了就不太妙了。
LONG
  );

  set("exits", ([
    "eastdown": __DIR__ "qqsl2",
    "up": __DIR__ "xiaolu2",
  ]));

  set("outdoors", "shaolin");
  setup();
}
