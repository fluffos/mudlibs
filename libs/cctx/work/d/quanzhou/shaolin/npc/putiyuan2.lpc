// Room: /d/nshaolin/putiyuan2.c
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "菩提塔");
  set ("long", @LONG
这里是菩提塔顶楼。在正北的塔壁上有个锦盒，锦盒深入石壁很
难拿出来,看来只有锹出来才行。
LONG
);
     set("exits", ([
                "down" : __DIR__"putiyuan1",
        ]));
         setup();
}

void init()
{
        add_action("do_qiao", "qiao");
}

int do_qiao(string arg)
{
        object me=this_player();
        object ob; 
        if( (!arg) || !((arg == "he") ))
                return notify_fail("你要锹什么？\n");
        if( !(ob = me->query_temp("weapon")) || (                (string)ob->query("skill_type")!="blade" &&                           (string)ob->query("skill_type")!="sword" ) ) 
                return notify_fail("没有工具怎么干活？\n");

        if( me->query_kar() < 10+random(400))
                return notify_fail(RED"缘分由天定！\n"NOR);
            
         
          if ((int)me->query_temp("marks/jinhe") )  {
           message("vission", RED "你看见锦盒中空空如也。\n"NOR, me);
           return 1;
    }
        ob=new("/d/shaolin/obj/puti-zi.lpc");
        ob->move(environment(me));
        message("vission", RED"你从锦盒中锹出了一个菩提子。\n"NOR, me);
         me->set_temp("marks/jinhe",1);
        return 1;
}

