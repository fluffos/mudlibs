inherit ROOM;
void create() {
  set("short", "木人巷");
  set("long", @LONG
这里仅有一条窄窄的过道两侧全是铜人由机关控制，每个铜人手
握禅杖，虽然是死物，但当时装置之人却是心思机灵之极的大匠，若非
本人身具少林绝艺，便是有少林高僧在旁指点，是以铜人每一杖击出，
尽属妙招，要想闯过困难重重。
LONG
  );
  set("exits", ([
    "west": __DIR__ "houdianmen",
    "east": __DIR__ "murenxiang1",
  ]));

  setup();
}
void init() {
  delete("exits");
  if (userp(this_player())) {
    remove_call_out("attack");
    call_out("attack", 1 + random(2), this_player());
  }
}
int attack(object me) {
  object tongren;
  tongren = new("/d/shaolin/npc/tongren");
  tongren->move(this_object());
  COMBAT_D->do_attack(tongren, me);
  if (present(me, this_object()) && random(10)) {
    destruct(tongren);
    call_out("attack", 1 + random(2), me);
  } else {
    destruct(tongren);
    set("exits/east", __DIR__ "murenxiang1");
  }
}
