
#include <room.h>

inherit ROOM;

void create()
{
  set("short","前殿");
  set("long",@LONG
青石铺的地面有两个大铜香炉。炉中盛满了香灰，正面是天王
殿，西边金刚殿，向东望见少室山笔直陡峭的山岩，峭壁上也凿满
了佛像，巍为壮观，令人叹为观止。
LONG
  );
      set("exits",([
