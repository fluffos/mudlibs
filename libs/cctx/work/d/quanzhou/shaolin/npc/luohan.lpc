//NPC: /d/shaolin/luohan.c
#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", HIY"罗汉大堂"NOR);
        set("long", @LONG
这就是名扬天下的少林罗汉堂，堂中十八罗汉身姿各异，合而
为罗汉十八手。少林罗汉大阵更是名动江湖，凡是能进得了罗汉堂
的少林弟子，武功都为一时之选。
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"luohan5",
  "westdown" : __DIR__"shidao",
  ]));
        set("objects", ([
                CLASS_D("shaolin") + "/xuan-ku" : 1,
                __DIR__"npc/xiao-ku" : 1,
       ]) );
	
	setup();
        replace_program(ROOM);
}
int valid_leave(object me, string dir)
{
        int skill;

        skill = me->query_skill("buddhism", 1);
        if (! skill < 60)
        {
                if (dir == "east")
                {
                        return notify_fail("你级别不够，不能进入。\n");
                }
        }
        return ::valid_leave(me, dir);
}
