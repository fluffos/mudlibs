// Room: /d/shaolin/shibanlu.c

inherit ROOM;
void create() {
  set("short", "石板路");
  set("long", @LONG
你走在石板路上。整个大道由大块的青石铺成，极为平坦。但因
年代久远，都有些破损。四周人来人往。烧香拜佛的进香客，参观的
游客，熙熙攘攘，非常热闹。再往前走就是少林天王殿了。
LONG
  );

  set("exits", ([
    "southeast": __DIR__ "changlang4",
    "southwest": __DIR__ "changlang1",
    "south": __DIR__ "qiandian",
    "north": __DIR__ "twdian",
  ]));

  set("outdoors", "shaolin");
  setup();
}
