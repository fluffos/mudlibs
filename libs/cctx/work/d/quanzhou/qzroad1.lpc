#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", GRN "柳荫路" NOR);
	set("long", @LONG
你走在一条柳荫路路上。时值春日，路旁的山坡上开满了金黄
色的油菜花。
LONG
	);

	set("exits", ([
		"northwest" : "/d/hangzhou/nliudao",
                "south" : __DIR__"qzroad2",
	]));

	set("outdoors", "quanzhou");
	setup();
	replace_program(ROOM);
}

