#include <ansi.h>
inherit NPC;
inherit F_SAVE;

int time_period(int timep, object me);

void create()
{
	set_name("土地", ({ "tu di","tudi" }) );
	set("title", "土地公公");
	set("gender", "男性" );
	set("age", 2800);
	setup();
}

void init()
{
	add_action("give_quest", "getquest");
}

int give_quest()
{
	mapping quest ;
	object me,qlist;
	int j, i, combatexp, timep, factor, num;
	mapping notes;
	string *levels,gender;
	string tag = "1000000";


	me = this_player();
	combatexp = (int)(me->query("combat_exp"));
	levels=explode(read_file(EXPLIST),"\n");
	if(sizeof(levels)>0)
	{
		for(i=0;i<sizeof(levels)-1;i++)
		{
			if((i!=(sizeof(levels)-1))
				&&combatexp>atoi(levels[i])
				&&combatexp<atoi(levels[i+1]))
			{
				combatexp=atoi(levels[i]);
			}
			else
				if((i==(sizeof(levels)-1))&&combatexp>=atoi(levels[i]))
				{
					combatexp=atoi(levels[i]);
				}
		}
	}

// Let's see if this player still carries an un-expired task
	if((quest =  me->query("quest")))
	{
		if( ((int)me->query("task_time")) >  time() )
			return notify_fail("你还得过一会才能领取任务。\n");
		else
		{
			message_vision(
				this_object()->query("name")+
					"对$N哼了一声道: 真给我丢脸, 就再给你一次机会试试。\n", me);
			me->set("qi", (int)(me->query("qi")/2+10));
		}
	}

	for(j = sizeof(levels) - 1 ; j >= 0; j--)
	{
		if( atoi(levels[j])  <= combatexp )
		{
			num = j;
			factor = 5;
			break;
		}
	}
	if(num > 0)
	{
		if (random(50) > 45)
		{
			num = num - 1;
		}
	}
	else
	{
		if ((num < sizeof(levels) - 1) && (random(100) > 95))
		{
			num = num + 1;
			factor = 10;
		}
	}

	qlist=new(QUEST_OB);

	j=1;

	while(num>=0&&j==1)
	{
		qlist->set("questlist_id","qlist"+levels[num]);//levels[num]
		qlist->restore();
		notes=qlist->query_all_quest();
		//j为0标志在num这一级别的任务中分配失败(只尝试一次分配，不成功就放弃)
		if(sizeof(notes)<1)
			j=0;
		if(random(sizeof(notes))<10&&num!=0)//以一定几率直接跳过当前级别的任务
			continue;
		quest = qlist->query_quest();
		gender=me->query("gender");
		if(j!=0)
			switch(quest["sex"])
			{
			case "1":
				if(gender=="女性")
					j=0;
				break;
			case "2":
				if(gender=="男性")
					j=0;
				break;
			case "3":
				if(gender=="中性"||gender=="无性")
					j=0;
				break;
			case "4":
				if(gender!="男性")
					j=0;
				break;
			case "5":
				if(gender!="女性")
					j=0;
				break;
			case "6":
				if(gender!="中性"&&gender!="无性")
					j=0;
				break;
			default:
				break;
			}
		if(j==0&&num>=0)//说明此次分配任务失败，尝试num-1后分配
		{
			j=1;
			num--;
		}
		else//分配成功，应该跳出循环
			j=2;//设置此标志跳出循环，并当做后面判断的依据
	}
	if(j!=2)//如果不为2，说明未找到可分配的任务！
		return 
		notify_fail(this_object()->query("name")+
"打开手中的本子看了看，然后摇了摇头：“没有合适你的任务啊！”\n");

	timep = quest["quest_time"];
	time_period(timep, me);
	if(quest["quest_type"]=="杀")
		tell_object(me, "杀了『" + quest["quest_npc_name"]+
			"("+quest["quest_npc_id"]+")』为我立功。\n" NOR);
	else
	if(quest["quest_type"]=="送")
		tell_object(me,"把"+quest["quest_obj_name"]+"("+quest["quest_obj_id"]+
			")送到"+quest["quest_npc_name"]+"("+quest["quest_npc_id"]+")那里去。\n"NOR);
	else
	if(quest["quest_type"]=="寻")
	{

		tell_object(me,"把"+quest["quest_obj_name"]+"("+quest["quest_obj_id"]+
			")找回来。\n"NOR);
		quest["quest_npc_name"]=query("name");
		quest["quest_npc_id"]=query("id");
	}
		
	me->set("quest", quest);
	me->set("task_time", (int)time() + (int)quest["quest_time"]);
	me->set("quest_factor", factor);
	return 1;
}

int time_period(int timep, object me)
{
	int t, d, h, m, s;
	string time;
	t = timep;
	s = t % 60;             t /= 60;
	m = t % 60;             t /= 60;
	h = t % 24;             t /= 24;
	d = t;

	if(d)
		time = chinese_number(d) + "天";
	else
		time = "";

	if(h)
		time += chinese_number(h) + "小时";
	if(m)
		time += chinese_number(m) + "分";
	time += chinese_number(s) + "秒";

	tell_object(me, HIW ""+this_object()->query("name")+"说道：\n在" + time + "内");
		return 1;
}

