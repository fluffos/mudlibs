dbase (["name":"未央生的信箱","owner_id":"dragon","id":"mailbox","unit":"个","no_insert":1,"no_get":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。discard <信件编号>        丢弃一封信件。","no_drop":1,])
