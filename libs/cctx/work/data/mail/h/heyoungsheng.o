#/clone/misc/mailbox.c
dbase (["no_drop":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。discard <信件编号>        丢弃一封信件。","id":"mailbox","name":"小宝的信箱","owner_id":"heyoungsheng","no_insert":1,"unit":"个","no_get":1,])
mails ({(["time":938576933,"text":"pattern中输入 ^ ??水：(%s)(%d)/(%s)(%d)(%s)经验：(%s)(%x)\"command中输入 \"water=%2;exp=%7;#if (@water<280) {drink cha}\"当水少小于280,就喝水pattern中输 \"^?食??：(%s)(%d)/(%s)(%d)(%s)潜能：(%s)(%d)\" command中输 \"food=%2;#math inc_qn %7-@qn;qn=%7;#if (@food<280) {eat gao}\" pattern中输 \"^ ??水：(%s)(%d)/(%s)(%d)(%s)经验：(%s)(%x)\" command中输 \"water=%2;#math inc_exp %7-@exp;exp=%7;#if (@water<280) {drink cha}\"pattern中输入 \"精??：(%s)(%d)/(%s)(%d)(%*)精力：(%*)/(%s)(%d)\"command中输入 \"js1=%2;js2=%4;jl1=%6;jl2=%8;#if (@js1<60) {#2 yun regenerate}\"当精小于60,就补精pattern中输入 \"气??：(%s)(%d)/(%s)(%d)(%*)内力：(%*)/(%s)(%d)\"command中输入 \"qx1=%2;qx2=%4;nl1=%6;nl2=%8;#if (@qx1<60) {yun recover}\"当气小于60,就补气","to":"heyoungsheng","from":"空龙(saolin)/转寄自空龙","title":"机器人1",]),})
