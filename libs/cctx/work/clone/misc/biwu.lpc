//  比武厅
// by netkill@cctx

#include <ansi.h>
inherit ROOM;
string look_bei();

void create() {
  set("short", HIW "华山绝顶" NOR);
  set("long", HIW @LONG
这里是华山的绝顶，山高不可测，四面云海茫茫，一边是陡峭的悬崖，一边
是险峻的山路，唯有此处有一约两三丈宽的平地，多少年来，数不清的英雄豪杰
在此殊死相博，为求天下第一的称号。西面立的有一块碑(bei),东边有一小凉亭，
供人休息之用。
LONG NOR
  );
  set("exits", ([
    "down": "/d/huashan/bshanlu",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "huashan");
  set("item_desc", ([
    "bei": (: look_bei :),
  ]));


  setup();
}

int init() {
  object me = this_player();
  if (!me->query_temp("biwu"))
    me->set_temp("biwu", 1);

}

int valid_leave(object me, string dir) {
  if (dir == "down") me->delete_temp("biwu");
  return ::valid_leave(me, dir);

}



string look_bei() {
  string use, str;
  int i, j;
  use = HIW "★★★" NOR + HIC "天下英雄谱" + HIW "★★★\n\n" NOR;
  for (i = 2; i <= 20; i = i + 2) {
    j = i - 1;

    str = read_file("/adm/daemons/ladder", i, 1);
    if (str && !(str == "*end*")) {
      use += sprintf("第%s名\n", chinese_number(i / 2));
      use += str;
    }
    str = read_file("/adm/daemons/ladder", j, 1);
    if (str && !(str == "*end*")) {
      use += str; use += "\n";
    }
  }

  return use;
}
