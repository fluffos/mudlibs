// liumai.c 六脉神剑 之 六脉合一
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
        string msg, string1;
        int count;
 
        if( !me->is_fighting() )
                return notify_fail("「六脉合一」只能在战斗中使用。\n");
 

        if( (int)me->query("neili") < 200 )
                return notify_fail("你的真气不够！\n");

        if( (int)me->query_skill("finger") < 150 ||
            me->query_skill_mapped("finger") != "liumai-shenjian")
                return notify_fail("你的六脉神剑还不够纯熟，不能使用六脉合一！\n");

        msg = HIY "$N"HIC"气沉丹田，内力游走使出"HIG"「六脉合一」"HIC"，六脉神剑的威力发挥的淋漓尽致！\n" NOR;
        message_vision(msg, me);

        
        me->clean_up_enemy();
        ob = me->select_opponent();
        msg= HIR"少商剑\n"NOR;
        message_vision(msg, me);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg= HIC"关冲剑\n"NOR;
        message_vision(msg, me);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg= HIY"少阳剑\n"NOR;
        message_vision(msg, me);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg= HIM"少冲剑\n"NOR;
        message_vision(msg, me);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg= HIG"少泽剑\n"NOR;
        message_vision(msg, me);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        msg= HIB"中冲剑\n"NOR;
        message_vision(msg, me);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);


        me->add("neili", -200);
        me->start_busy(random(4));

        return 1;
}

