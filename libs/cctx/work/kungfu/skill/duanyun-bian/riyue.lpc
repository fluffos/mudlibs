// riyue.c 断云鞭法[日月无光]

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("牵制攻击只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("duanyun-bian", 1) < 135)
    return notify_fail("你的「断云鞭法」还没学到家，用不了「日月无光」。\n");

  if ((int)me->query_skill("xiantian-gong", 1) < 140)
    return notify_fail("你的「先天神功」不够纯熟，用不了「日月无光」。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

  msg = HIC "$N" HIC "使出断云鞭法的绝招" HIM "「日月无光」" HIC "连挥数鞭企图把$n" HIC "的全身缠绕起来。\n";

  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {
    msg += "结果$p被$P攻了个措手不及。\n" NOR;
    target->start_busy((int)me->query_skill("duanyun-bian") / 30 + 3);
    me->start_busy(random(2));
    me->add("neili", -200);
  } else {
    msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
    me->start_busy(4);
  }
  message_vision(msg, me, target);

  return 1;
}
