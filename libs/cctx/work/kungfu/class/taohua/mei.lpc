// /kungfu/class/mcf
// adx 4:16 99-2-12

#include <ansi.h>

inherit NPC;

int do_look(string var);
int ask_me();

void consider();

void create() {
  set_name("梅超风", ({ "mei chaofeng", "mei", "chaofeng" }));
  set("long", "她是一个盲了双眼的中年妇人，面目狰狞，好似有什么\n" +
    "深仇大恨。\n");
  set("nickname", HIW "黑风双煞" + HIB "铁尸" NOR);
  set("gender", "女性");
  set("age", 37);
  set("attitude", "peaceful");
  set("str", 30);
  set("dex", 32);
  set("con", 17);
  set("int", 25);
  set("shen_type", -1);

  create_family("桃花岛", 2, "弟子");

  set_skill("force", 180);
  set_skill("bibo-shengong", 180);
  set_skill("dodge", 250);
  set_skill("anying-fuxiang", 250);
  set_skill("parry", 230);
  set_skill("sword", 160);
  set_skill("luoying-shenjian", 160);
  set_skill("luoying-zhang", 160);
  set_skill("unarmed", 170);
  set_skill("jiuyin-baiguzhao", 200);
  set_skill("finger", 150);
  set_skill("tanzhi-shentong", 150);
  set_skill("qimen-wuxing", 200);
  set_skill("literate", 200);

  map_skill("force", "bibo-shengong");
  map_skill("unarmed", "jiuyin-baiguzhao");
  map_skill("dodge", "anying-fuxiang");
  map_skill("parry", "jiuyin-baiguzhao");
  map_skill("finger", "tanzhi-shentong");

  set("jiali", 150);

  set("combat_exp", 2200000);

  set("max_qi", 4000);
  set("max_jing", 1000);
  set("neili", 8000);
  set("max_neili", 8000);

  set("inquiry", ([
    "name": "站远点！",
    "陈玄风": "你问我的贼汉子做什么？",
    "九阴真经": (: ask_me :),
    "黑风双煞": "那是我和我的贼汉子的名号，你也听说过？",
  ]));

  set("chat_chance", 10);
  set("chat_msg", ({
    "梅超风幽幽地叹了一口气：「不知道江湖上的人是否还记得我们夫妻？」\n",
    "梅超风说道：「当年我和我的贼汉子是何等的威风！」\n",
  }));

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "force.powerup" :),
    (: perform_action, "unarmed.du" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/d/taohua/obj/cloth")->wear();

}


int ask_me() {
  object me;

  me = this_player();
  message("vision",
    HIY "梅超风冷笑一声：『我这就带你去找。』\n"
    "梅超风决心杀死" + me->name() + "\n"
    NOR, environment(), this_object());
  kill_ob(this_player());
  return 1;
}
void init() {
  object me, ob;
  mapping fam;

  ::init();

  ob = this_player();
  me = this_object();

  if (interactive(ob)
    && !environment(ob)->query("no_fight")
    && !present("qingjian", ob)
    && ((fam = ob->query("family")) && fam["family_name"] != "桃花岛")) {
    if (!ob->query_temp("warned")) {
      command("say 你是谁？  怎么闯到桃花岛里来了？速速离开！");
      command("say 师父有令：外人不得擅自上岛！");
      ob->set_temp("warned", 1);
    } else if (ob->query_temp("stay") < 3) ob->add_temp("stay", 1);
    else {
      command("say 大胆狂徒，竟敢擅闯桃花岛！！！\n");
      me->set_leader(ob);
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, ob);
    }
  }
}
void attempt_apprentice(object ob) {
  if (ob->query_int() < 30) {
    command("say 我不收资质差的弟子，您请回吧！");
    return;
  }
  if ((int)ob->query_skill("bibo-shengong", 1) < 100) {
    command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
    return;
  }
  if ((int)ob->query("shen") > -10000) {
    command("say 你办事不够狠毒果断，你还是到江湖上多历练吧！");
    return;
  }
  command("say 好吧，今后你要群奋练功，光大本门。");
  command("recruit " + ob->query("id"));
}
