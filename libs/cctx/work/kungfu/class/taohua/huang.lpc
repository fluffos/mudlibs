#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("黄药师", ({"huang yaoshi", "huang", "yaoshi"}));
	set("nickname", HIY "东邪" NOR );
	set("gender", "男性");
	set("age", 42);
	set("long", 
        "他就是桃花岛主。行事好恶全由己心，因此被人称作「东邪」。\n");
	set("attitude", "peaceful");
	
	set("str", 21);
	set("int", 30);
	set("con", 26);
	set("dex", 30);

	set("chat_chance", 1);
	set("chat_msg", ({
        "黄药师叹了口气道：“唉 …… 蓉儿这苦命的孩子，从小就没了娘 ……”\n",
        "黄药师低头沉思，悠然不语。\n",
}));
	set("inquiry", ([
        "黄蓉"     : "蓉儿可会作菜了，最拿手的就是“玉笛谁家听落梅”。 \n",
        "九阴真经" : "我把九阴真经藏在一个极秘密的地方。\n",
]));

	set("qi", 8000);
	set("max_qi", 8000);
	set("jing", 4000);
	set("max_jing", 4000);
	set("neili", 7000);
	set("max_neili", 7000);
	set("jiali", 200);
	
	set("combat_exp", 5000000);
	set("score", 100);
	 
	set_skill("force", 300);
	set_skill("bibo-shengong", 400);
	set_skill("finger", 340);
	set_skill("tanzhi-shentong", 340);
	set_skill("unarmed", 250);
	set_skill("luoying-zhang", 250);
	set_skill("dodge", 300);
	set_skill("anying-fuxiang", 250);
	set_skill("parry", 300);
	set_skill("sword", 400);
	set_skill("luoying-shenjian", 400);
	set_skill("yuxiao-jianfa", 350);
	set_skill("cuixin-zhang", 300);
	set_skill("qimen-wuxing",300);
	set_skill("literate",300);
	
	map_skill("force"  , "bibo-shengong");
	map_skill("finger" , "tanzhi-shentong");
	map_skill("unarmed", "cuixin-zhang");
	map_skill("dodge"  , "anying-fuxiang");
	map_skill("parry"  , "yuxiao-jianfa");
	map_skill("sword"  , "yuxiao-jianfa");
	
	create_family("桃花岛", 1, "岛主");
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: perform_action, "force.powerup" :),
		(: perform_action, "unarmed.gu" :),
		(: perform_action, "sword.hua" :),
		(: exert_function, "recover" :),
	}) );
	setup();
	
	carry_object("/d/taohua/obj/yuxiao")->wield();
	carry_object("/d/taohua/obj/bupao")->wear();
    
}
void attempt_apprentice(object ob)
{
    if (ob->query_int() < 30) {
        command("say 我不收资质差的弟子，您请回吧！");
		return;
    }
    if ((int)ob->query_skill("bibo-shengong",1) < 200 ) {
        command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
		return;
    }
    if ((int)ob->query("shen") >100000 || (int)ob->query ("shen") < -100000 ) {
        command("say 我桃花岛与世隔绝，你在江湖上已经成名，何必留在桃花岛！");
		return;
	}
    command("say 很好，很好。");
    command("recruit " + ob->query("id"));
}