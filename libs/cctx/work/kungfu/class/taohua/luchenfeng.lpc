// /kungfu/class/luchenfeng
// adx 4:16 99-2-12
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_me(string name);

void create() {
  set_name("陆乘风", ({ "lu chengfeng", "lu", "chengfeng" }));
  set("long", "他是黄药师的弟子，双腿齐膝而断，面目慈善，象是一位员外。\n");
  set("title", WHT "归云庄庄主" NOR);
  set("gender", "男性");
  set("age", 37);
  set("attitude", "peaceful");
  set("str", 30);
  set("dex", 32);
  set("con", 17);
  set("int", 25);
  set("shen_type", 1);

  create_family("桃花岛", 2, "弟子");

  set_skill("force", 220);
  set_skill("bibo-shengong", 220);
  set_skill("dodge", 160);
  set_skill("anying-fuxiang", 160);
  set_skill("parry", 220);
  set_skill("sword", 220);
  set_skill("luoying-shenjian", 230);
  set_skill("unarmed", 230);
  set_skill("luoying-zhang", 230);
  set_skill("finger", 180);
  set_skill("tanzhi-shentong", 180);
  set_skill("qimen-wuxing", 250);
  set_skill("literate", 250);

  map_skill("force", "bibo-shengong");
  map_skill("unarmed", "luoying-zhang");
  map_skill("dodge", "anying-fuxiang");
  map_skill("parry", "luoying-shenjian");
  map_skill("sword", "luoying-shenjian");
  map_skill("finger", "tanzhi-shentong");

  set("jiali", 150);

  set("combat_exp", 2200000);

  set("max_qi", 4000);
  set("max_jing", 1000);
  set("neili", 8000);
  set("max_neili", 8000);

  set("inquiry", ([
    "黄药师": "大胆，你敢直呼我师父的名谓",
    "桃花岛": "哪是我师父的驻地，远在海外",
    "黄岛主": (: ask_me, "qingjian" :),
    "请柬": (: ask_me, "qingjian" :),
    "归云庄": "这是桃花岛弟子在中原的落脚点。",
  ]));

  set("foor_count", 2);

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "force.powerup" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/d/taohua/obj/cloth")->wear();
  carry_object("/d/taohua/obj/changjian")->wield();
}
void attempt_apprentice(object ob) {
  if (ob->query_int() < 25) {
    command("say 我不收资质差的弟子，您请回吧！");
    return;
  }
  if ((int)ob->query_skill("bibo-shengong", 1) < 100) {
    command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
    return;
  }
  if ((int)ob->query("shen") < 10000) {
    command("say 你多行不义，还是多多行侠仗义，日后在来吧！");
    return;
  }
  command("say 好吧，今后你要群奋练功，光大本门。");
  command("recruit " + ob->query("id"));
}
string ask_me(string name) {
  mapping fam;
  object ob;

  if (present(name, this_player()))
    return RANK_D->query_respect(this_player()) + "你现在身上不是有吗，凭" + HIR "请柬" NOR + "可以自由出入桃花岛！";

  if (query("foor_count") < 1)
    return "抱歉，你来得不是时候，我师父现在不会客。";

  ob = new("/d/taohua/obj/" + name);
  ob->move(this_player());

  add("foor_count", -1);

  message_vision(YEL "陆乘风给$N一个" + ob->query("name") + "。\n" NOR, this_player());

  return "给，凭此" + HIR "请柬" NOR + "你可以去拜会我师父，有效期一日，期满请速速离开。";
}
