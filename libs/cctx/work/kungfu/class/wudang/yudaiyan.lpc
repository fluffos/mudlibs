// yudaiyan.c 俞岱岩 

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("俞岱岩", ({ "yu daiyan", "yu" }));
  set("nickname", "武当三侠");
  set("long",
    "他就是张三丰的三弟子俞岱岩。\n"
    "身穿一件干干净净的灰色道袍。\n"
    "他已年过四十，身材瘦长。恬淡冲和，沉默寡言。\n");
  set("gender", "男性");
  set("age", 43);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 25);
  set("con", 30);
  set("dex", 25);

  set("max_qi", 3000);
  set("max_jing", 3000);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 120);
  set("combat_exp", 1500000);
  set("score", 600000);

  set_skill("force", 200);
  set_skill("taiji-shengong", 200);
  set_skill("dodge", 150);
  set_skill("tiyunzong", 150);
  set_skill("unarmed", 180);
  set_skill("taiji-quan", 180);
  set_skill("parry", 180);
  set_skill("sword", 180);
  set_skill("taiji-jian", 180);
  set_skill("taoism", 150);
  set_skill("literate", 140);

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-quan");
  map_skill("sword", "taiji-jian");

  create_family("武当派", 2, "弟子");
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/wudang/obj/greyrobe")->wear();

}
void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 10000) {
    command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((int)ob->query_skill("taiji-shengong", 1) < 70 ||
    (int)ob->query_skill("force", 1) < 70) {
    command("say 我武当派最注重内功心法" + RANK_D->query_respect(ob) +
      "是否应该在内功上多下点功夫啊?");
    return;
  }
  if ((int)ob->query_skill("unarmed", 1) < 60)

  {
    command("say 我武当的太极拳博大精深,我看你在拳脚方面做的还不够,要加油啊!");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("say 希望你能好好用功,发扬我武当精神!");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
}
