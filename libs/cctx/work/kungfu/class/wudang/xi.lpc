// xi.c 张松溪

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("张松溪", ({ "zhang songxi", "zhang" }));
  set("nickname", "武当四侠");
  set("long",
    "他就是张三丰的四弟子张松溪。\n"
    "他今年四十岁，精明能干，以足智多谋著称。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 26);
  set("int", 30);
  set("con", 26);
  set("dex", 28);

  set("max_qi", 3500);
  set("max_jing", 1800);
  set("neili", 4700);
  set("max_neili", 4700);
  set("jiali", 120);
  set("combat_exp", 1500000);
  set("score", 500000);

  set_skill("force", 180);
  set_skill("taiji-shengong", 180);
  set_skill("dodge", 150);
  set_skill("tiyunzong", 150);
  set_skill("unarmed", 170);
  set_skill("taiji-quan", 170);
  set_skill("parry", 180);
  set_skill("sword", 160);
  set_skill("taiji-jian", 160);
  set_skill("taoism", 120);
  set_skill("literate", 100);

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");

  create_family("武当派", 2, "弟子");

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.lian" :),
    (: perform_action, "sword.sui" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/wudang/obj/whiterobe")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 10000) {
    command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((int)ob->query_skill("taiji-shengong", 1) < 60 ||
    (int)ob->query_skill("force", 1) < 60) {
    command("say 我武当派最注重内功心法" + RANK_D->query_respect(ob) +
      "是否应该在内功上多下点功夫啊?");
    return;
  }

  command("say 好吧，我就收下你了。");
  command("say 希望你能好好用功,发扬我武当精神!");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
}
