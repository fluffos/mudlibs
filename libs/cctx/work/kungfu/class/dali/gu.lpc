inherit NPC;

void create() {
  set_name("古笃诚", ({ "gu ducheng", "gu" }));
  set("title", "四大卫护之一");
  set("age", 31);
  set("gender", "男性");
  set("long", "他虽然身为武官，但是却衣着朴素，不仔细看还以为他是一个农民呢。\n");
  set("attitude", "friendly");
  set("str", 29);
  set("dex", 20);
  set("int", 24);
  set("max_force", 400);
  set("force", 400);
  set("force_factor", 5);
  set("combat_exp", 600000);
  set("shen", 1000);
  set_skill("unarmed", 190);
  set_skill("dodge", 160);
  set_skill("parry", 170);
  set_skill("force", 170);
  set_skill("staff", 190);
  set_skill("tianlong-shengong", 170);
  set_skill("qingdie-shenfa", 170);
  set_skill("sword", 133);
  set_skill("finger", 149);
  set_skill("literate", 110);
  set_skill("yiyang-zhi", 147);
  map_skill("finger", "yiyang-zhi");
  map_skill("dodge", "qingdie-shenfa");
  map_skill("force", "tianlong-shengong");
  prepare_skill("finger", "yiyang-zhi");
  create_family("大理段氏", 6, "弟子");
  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/dali/huanggong/npc/obj/tiegun")->wield();
}

void attempt_apprentice(object ob) {
  int phlye, nf;
  mapping family = ob->query("family");
  phlye = (int)ob->query("phlye");
  if (!pointerp(family))
    nf = 1;
  else
    nf = 0;
  if (phlye != 5) {
    command("say " + RANK_D->query_respect(ob) +
      "的根骨到是不错哟，我也想收你为徒，可是...\n" +
      "目前大理段氏只传武功给云南人，你还是等下辈子吧！");
    return;
  }
  if (!nf && (int)ob->query("betrayer") > 1 && family["family_name"] != "大理段氏") {
    command("say 你这个逆贼，岂能入我门下，我今天就先杀了你以示后人！");
    kill_ob(ob);
    return;
  }
  if (!nf && family["generation"] >= this_object()->query("family/generation")
    && family["family_name"] == "大理段氏") {
    command("say 你的辈分不比我低了，我怎么能收你为徒呢？");
    return;
  }
  if ((int)ob->query("shen") < 0) {
    command("say 我大理段氏乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
}
