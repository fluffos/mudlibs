//zhangwuji.c

#include <ansi.h>

inherit F_MASTER;
inherit F_UNIQUE;
inherit NPC;


void create() {
  seteuid(getuid());
  set_name("黛丽丝", ({ "dai lisi", "dai", "lisi" }));
  set("long", "明教四大法王之一，据说年轻的时侯相当漂亮。\n一手夺命金花更是旷古绝今。\n");
  set("title", HIM "紫衫龙王" NOR);
  set("gender", "女性");
  set("age", 45);
  set("shen_type", 1);
  set("attitude", "friendly");

  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("qi", 3050);
  set("max_qi", 3050);
  set("jing", 3050);
  set("max_jing", 3050);
  set("neili", 5000);
  set("max_neili", 5000);
  set("jiali", 120);

  set("combat_exp", 1500000);
  set("score", 55000);

  set_skill("force", 250);
  set_skill("dodge", 250);
  set_skill("parry", 250);
  set_skill("shenghuo-shengong", 250);
  set_skill("throwing", 250);
  set_skill("duoming-jinhua", 250);
  set_skill("xiaoyao-bu", 250);
  map_skill("parry", "duoming-jinhua");
  map_skill("force", "shenghuo-shengong");
  map_skill("dodge", "xiaoyao-bu");
  map_skill("throwing", "duoming-jinhua");

  create_family("明教", 35, "法王");
  set("chat_chance", 500);
  set("chat_msg", ({
    (: exert_function, "recover" :),
    (: exert_function, "heal" :),
  }));

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: perform_action, "throwing.lianhuan" :),
  }));


  setup();
  carry_object("/d/mj/obj/jinhua")->wield();
  carry_object("/d/mj/obj/baipao")->wear();

}





void attempt_apprentice(object ob) {

  if ((int)ob->query_skill("force") < 50) {
    command("say 你的基本内功太低了，学习我的功夫会伤及自身。");
    return 0;
  }


  ob->set("title", "明教紫衫龙王座下弟子");
  command("recruit " + ob->query("id"));
  command("say 好，我就收下你这位好兄弟");
  command("say 再接再砺！");
  return;
}
