// cat.c

#include "/doc/help.h"

inherit F_CLEAN_UP;
int help(object me);

int main(object me, string arg)
{
	string file;

	seteuid(geteuid(me));
    if (!arg) return notify_fail("你想要显示那个档案?\n");
	file = resolve_path(me->query("cwd"), arg);

	//记录查看的文件/log/cmds/cat   山猫(adx)
	log_file("cmds/cat",
	sprintf("%s(%s) cat %s on %s\n",
	me->name(1), //记录使用命令的人名
	geteuid(me), //记录使用命令的ID
	file,        //记录读取文件的路径
	ctime(time()) ) ); //记录使用命令的时间

	if( file_size(file)<0 ) return notify_fail("没有这个档案。\n");
	cat(file);
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : cat <档案>

此指令可让你(你)直接读取某档案之程式。
HELP
    );
    return 1;
}
