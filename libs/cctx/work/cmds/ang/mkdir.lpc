// mkdir.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string dir;

	if(!arg) return help(me);

	dir = resolve_path(me->query("cwd"), arg);

	seteuid(geteuid(me));

	//记录建立子目录的文件/log/cmds/mkdir   山猫(adx)
	log_file("cmds/mkdir",
	sprintf("%s(%s) 建立子目录 %s \n         on %s\n",
	me->name(1), //记录使用命令的人名
	geteuid(me), //记录使用命令的ID
	dir,         //记录复制物品的路径
	ctime(time()) ) ); //记录使用命令的时间

	if( mkdir(dir) )
		write("Ok.\n");
	else
		write("你没有在这里建子目录的权利。\n");
	return 1;	
}

int help(object me)
{
	write(@HELP
指令格式 : mkdir <子目录名>

建立一个子目录。
HELP
	);
	return 1;
}
