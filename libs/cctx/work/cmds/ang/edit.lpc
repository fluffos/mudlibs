// edit.c

#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string file)
{
	string ufile;

	if( !file ) return notify_fail("指令格式：edit <档名>\n");

	if( in_edit(me) ) return notify_fail("你已经在使用编辑器了。\n");

	seteuid(geteuid(me));
	ed(resolve_path(me->query("cwd"), file));

	//记录在线编辑的文件路径/log/cmds/edit   山猫(adx)
	//但是如果使用物件编辑器或房间编辑器呢？
	ufile = resolve_path(me->query("cwd"), file);
	log_file("cmds/edit",
	sprintf("%s(%s) edit %s on %s\n",
	me->name(1), //记录使用命令的人名
	geteuid(me), //记录使用命令的ID
	ufile,        //记录在线编辑的文件路径
	ctime(time()) ) ); //记录使用命令的时间

	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : edit <档名>, edit here

利用此一指令可直接在线上编辑档案。
HELP
    );
    return 1;
}
