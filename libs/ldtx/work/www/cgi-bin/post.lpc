inherit F_CLEAN_UP;

string gateway(string arg) {
	string str;
str = sprintf(
"<html>"
"<head>"
"<meta http-equiv='Content-Type' content='text/html; charset=gb2312'>"
"<title>"+MUD_NAME+"留言板</title>"
"<base target='main'></head>"
"<body background=/images/body_bg.jpg>"
"<h3 align='center'><font face='幼圆'><font color='#FF0000'>"+MUD_NAME+"</font> "
"留言板</font></h3>"
"<hr>"
"<form method='POST' action='/cgi-bin/board_post?board=%s'>"
"<div align='center'><center><table border='1' width='280'>"
"<tr><td width='340'><font face='幼圆' size='3'>代号(ID)</font></td>"
"<td width='302'><font face='幼圆' size='3'><input type='text' name='id' size='8'"
"maxlength='8'></font></td></tr>"
"<tr>"
	"<td width='340'><font face='幼圆' size='3'>密码(Password)</font></td>"
	"<td width='302'><font face='幼圆' size='3'><input type='password' name='pass' size='24'"
	" maxlength='24'></font></td>"
"</tr>"
"<tr>"
	"<td width='340'><font face='幼圆' size='3'>文章标题</font></td>"
	"<td width='302'><font face='幼圆' size='3'><input type='text' name='title' size='24'"
	"maxlength='48'></font></td>"
	"</tr>"
"</table>"
"</center></div><p><br></p><hr>"
	"<div align='center'><center><h3><font face='幼圆'>内容</font></h3>"
	"</center></div><div align='center'><center><p><!--webbot bot='Validation' startspan"
	"  I-Maximum-Length='240' --><!--webbot bot='Validation' endspan --><textarea cols='60'"
	"name='text' rows='20'></textarea></p>"
	"</center></div><div align='center'><center><p><input type='submit' value='发表'> "
	"&nbsp;&nbsp;&nbsp; <input type='reset' value='重写'></p>"
	"</center></div>"
	"</form>"
"</body></html>",
arg
);
	return str;
}