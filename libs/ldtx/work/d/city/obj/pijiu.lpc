// wineskin.c  酒袋

inherit ITEM;
inherit F_LIQUID;

void create()
{
       set_name("啤酒", ({"pi jiu", "pi", "jiu"}));
	set_weight(700);
	if (clonep())
		set_default_object(__FILE__);
	else {
    set("long", 
        "一听蓝带啤酒。\n");
              set("unit", "听");
		set("value", 100);
		set("max_liquid", 15);
	}

	// because a container can contain different liquid
	// we set it to contain wine at the beginning
	set("liquid", ([
		"type": "alcohol",
               "name": "啤酒",
		"remaining": 15,
		"drunk_apply": 3,
	]));
}
