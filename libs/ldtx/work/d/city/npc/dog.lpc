#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIW "小白狗" NOR, ({ "white dog", "dog" }));
  set("title", "雄霸天下的小可爱");
  set("race", "野兽");
  set("age", 10);
  set("long", "一只雪白毛绒绒的小白狗。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 2000);
  set("max_neili", 2000);
  set("jiali", 100);
  set("env/wimpy", 80);

  set("combat_exp", 2000000);

  set_skill("force", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  set_skill("parry", 100);

  set("limbs", ({ "头部", "狗身", "前爪", "后腿", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set_temp("apply/attack", 100);
  set_temp("apply/armor", 100);

  set("chat_chance", 3);
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();

}


void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

}
void greeting(object who, object ob) {
  if ((string)who->query("gender") == "女性") {

    if (ob->query("per") > 25) {
      call_out("destroy", 1, ob);
      set_leader(who);
      message_vision(WHT "小白狗亲热地用鼻子挠$N" + WHT "的痒痒，$N乐得呵呵直笑。\n" NOR, who);
      return;
    }
  } else
    message_vision(WHT "小白狗用鼻子闻了闻$N" + WHT "，打了个喷嚏，摇着尾巴跑开了,看来它对$N不感冒。\n" NOR, who);
  return;
}

void destroy(object ob) {
  destruct(ob);
  return;
}
