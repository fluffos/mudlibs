// 处理意见反馈室
//by csy

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "处理意见反馈室");
  set("long",
    "这儿是处理意见反馈室，主要是反馈些对玩家申告的处理意见。\n"
    "请有关朋友定期看看，欢迎对游戏的巫师及玩家提出有合理理由的申\n"
    "告。\n"
  );
  set("no_fight", 1);
  set("no_yun", "1");
  set("no_sleep_room", 1);
  set("no_study", 1);
  set("exits", ([
    "west": __DIR__ "guest_room",
  ]));

  setup();

  call_other("/d/wizard/toplayer_b", "???");
}
