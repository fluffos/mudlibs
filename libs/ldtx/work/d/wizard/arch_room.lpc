// arch_room.c 大巫师会议室
// writed by shadow

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "大巫师会议室" NOR);
  set("long",
    "这里是大巫师们开重要会议的地方，中间是一张圆桌，桌边摆满了椅\n"
    "子，墙上挂着会议记录及工作安排。\n");
  set("no_fight", "1");
  set("no_clean_up", 0);

  set("exits", ([
    "down": __DIR__ "wizard_room",
  ]));

  setup();
  call_other("/u/jiudai/arch_b", "???");
}

void init() {
  object ob = this_player();
  if (!wizardp(ob) || wiz_level(ob) < wiz_level("(arch)")) {
    ob->move(__DIR__ "wizard_room");
    return;
  }
}
