      switch (ob->query("class")) {
        case "bonze":
          if (age < 50) return "贫尼";
          else return "老尼";
          break;
        default:
          if (age < 30) return "小女子";
          else return "妾身";
          break;
      }
    case "男性":
    default:
      switch (ob->query("class")) {
        case "bonze":
          if (age < 50) return "贫僧";
          else return "老纳";
          break;
        case "taoist":
          return "贫道";
          break;
        default:
          if (age < 50) return "在下";
          else return "老头子";
          break;
      }
  }
}

string query_self_rude(object ob) {
