// rankd.c
// 1999 dts ranking related to "exp"
#include <ansi.h>

string query_rank(object ob) {
  string bangname, bangrank, tmpstr;
  string setname, menpai;
  int exp, shen;
  int budd, lbg;
  mapping fam;
  int age;
  exp = (int)ob->query("combat_exp");
  shen = (int)ob->query("score");
  menpai = ob->query("family/family_name");
  //        if(ob->query("id")=="mouse")  return HIC"【 巫师学徒 】" NOR;
  if (ob->is_ghost()) return HIB "【  鬼  魂  】" NOR;
  if ((int)ob->query("title_race") == -1) {
    if (strlen((string)ob->query("env/title_race")) == 2) {
      setname = ob->query("env/title_race");
      return HIR "【 江湖第一" + setname + " 】" NOR;
    } else return HIR "【 江湖第一 】" NOR;
  }
  if ((int)ob->query("title_race") == -2) {
    if (strlen((string)ob->query("env/title_race")) == 2) {
      setname = ob->query("env/title_race");
      return HIR "【 江湖第二" + setname + " 】" NOR;
    } else return HIR "【 江湖第二 】" NOR;
  }
  if ((int)ob->query("title_race") == -3) {
    if (strlen((string)ob->query("env/title_race")) == 2) {
      setname = ob->query("env/title_race");
      return HIR "【 江湖第三" + setname + " 】" NOR;
    } else return HIR "【 江湖第三 】" NOR;
  }
  if ((fam = ob->query("family")) && (fam["family_name"] == "凌波宫"))
    lbg = ob->query_skill("lingbo-shengong", 1);
  bangname = ob->query("family/family_name");
  switch (ob->query("gender")) {
    case "女性":
      switch (wizhood(ob)) {
        case "(admin)":
          return HIW "【  天  后  】" NOR;
        case "(sage)":
          return HIR "【 九天玄女 】" NOR;
        case "(arch)":
          return HIM "【  神  女  】" NOR;
        case "(angel)":
          return HIY "【  仙  妃  】" NOR;
        case "(wizard)":
          return HIG "【 女 天 官 】" NOR;
        case "(apprentice)":
          return HIR "【 小 仙 女 】" NOR;
        case "(genie)":
          return HIB "【 小 精 灵 】" NOR;
        case "(immortal)":
          return HIC "【  仙  子  】" NOR;
        default:
          if (((int)ob->query("PKS") > 100) &&
            ((int)ob->query("PKS") > (int)ob->query("MKS")))
            return HIW "【女杀人狂魔】" NOR;
          if ((int)ob->query("thief") > 10)
            return HIW "【 女 惯 窃 】" NOR;
          switch (ob->query("class")) {
            case "bandit":
              return HIB "【 女 飞 贼 】" NOR;
            case "bangzhong":
              if (exp >= 10000000)
                return HIY "【凌波宫副主】" NOR;
              else if (exp > 3000000)
                return HIR "【凌波宫执法】" NOR;
              else if (exp > 1000000)
                return HIB "【凌波宫护法】" NOR;
              else if (exp > 550000)
                return HIC "【凌波宫使者】" NOR;
              else if (exp > 150000)
                return HIW "【凌波宫将军】" NOR;
              else
                return HIB "【" + bangname + "帮众】" NOR;
            case "bonze":
              return YEL "【 出家尼姑 】" NOR;
            case "yishi":
              return HIY "【 女 义 士 】" NOR;
            case "taoist":
              return HIC "【  女  冠  】" NOR;
            case "bandit":
              return HIB "【 女 飞 贼 】" NOR;
            case "scholar":
              return HIG "【 遥遥佳人 】" NOR;
            case "shiny":
              return HIY "【 光明女使 】" NOR;
            case "dancer":
              return HIR "【  舞  妓  】" NOR;
            case "officer":
              return HIM "【  女  官  】" NOR;
            case "fighter":
              return HIW "【 女 武 者 】" NOR;
            case "swordsman":
              return HIC "【 女 剑 士 】" NOR;
            case "alchemist":
              return HIB "【 女 方 士 】" NOR;
            case "shaman":
              return HIG "【 女 巫 医 】" NOR;
            case "beggar":
              return HIB "【 女 叫 化 】" NOR;
            case "sharenfan":
              return HIW "【 通 缉 犯 】" NOR;
            case "prostitute":
              return HIY "【  妓  女  】" NOR;
            default:
              switch (menpai) {
                case "武当派":
                  if (exp > 1000000) {
                    if (shen >= 0)
                      return HIR "【 女 天 师 】" NOR;
                    else
                      return HIR "【 女魔天师 】" NOR;
                  }
                  if (exp > 800000)
                    return HIM "【 女 国 师 】" NOR;
                  if (exp > 600000)
                    return HIG "【 女 真 人 】" NOR;
                  if (exp > 400000)
                    return HIY "【 女大法师 】" NOR;
                  if (exp > 100000)
                    return HIY "【 女 法 师 】" NOR;
                  if (exp > 50000)
                    return HIC "【 女 道 长 】" NOR;
                  if (exp > 25000)
                    return HIC "【 女 道 姑 】" NOR;
                  if (exp > 10000)
                    return HIW "【 女 道 姑 】" NOR;
                  if (exp > 5000)
                    return HIW "【  女  冠  】" NOR;
                  return HIB "【 女 少 冠 】" NOR;
                case "华山派":
                  if (exp > 1000000) {
                    if (shen >= 0)
                      return HIR "【 惊天一剑 】" NOR;
                    else
                      return HIR "【 惊魔一剑 】" NOR;
                  }
                  if (exp > 800000) {
                    if (shen >= 0)
                      return HIM "【  剑  圣  】" NOR;
                    else
                      return HIM "【  剑  魔  】" NOR;
                  }
                  if (exp > 600000) {
                    if (shen >= 0)
                      return HIG "【  剑  仙  】" NOR;
                    else
                      return HIG "【  邪  剑  】" NOR;
                  }
                  if (exp > 400000)
                    return HIY "【  剑  痴  】" NOR;
                  if (exp > 100000)
                    return HIY "【  剑  侠  】" NOR;
                  if (exp > 50000)
                    return HIC "【 大 剑 客 】" NOR;
                  if (exp > 25000)
                    return HIC "【  剑  客  】" NOR;
                  if (exp > 10000)
                    return HIW "【 大 剑 士 】" NOR;
                  if (exp > 5000)
                    return HIW "【  剑  士  】" NOR;
                  return HIG "【  剑  童  】" NOR;

                case "丐帮":
                  if (exp > 1000000)
                    return HIR "【 副 帮 主 】" NOR;
                  if (exp > 800000)
                    return HIM "【 大 长 老 】" NOR;
                  if (exp > 600000)
                    return HIG "【  长  老  】" NOR;
                  if (exp > 400000)
                    return HIY "【 传 功 使 】" NOR;
                  if (exp > 100000)
                    return HIY "【 执 法 使 】" NOR;
                  if (exp > 50000)
                    return HIC "【  神  丐  】" NOR;
                  if (exp > 25000)
                    return HIC "【 小 神 丐 】" NOR;
                  if (exp > 10000)
                    return HIW "【  乞  丐  】" NOR;
                  if (exp > 5000)
                    return HIW "【 小 乞 丐 】" NOR;
                  return HIG "【 叫 化 子 】" NOR;

                case "星宿派":
                case "桃花岛":
                  if (exp > 1000000) {
                    if (shen >= 0)
                      return HIR "【 魔 见 愁 】" NOR;
                    else
                      return HIR "【  狂  魔  】" NOR;
                  }
                  if (exp > 800000)
                    return HIM "【 世外高人 】" NOR;
                  if (exp > 600000)
                    return HIG "【 旷世女侠 】" NOR;
                  if (exp > 400000)
                    return HIY "【 大 侠 女 】" NOR;
                  if (exp > 100000)
                    return HIY "【 女 侠 客 】" NOR;
                  if (exp > 50000)
                    return HIC "【 女 游 侠 】" NOR;
                  if (exp > 25000)
                    return HIC "【  女  侠  】" NOR;
                  if (exp > 10000)
                    return HIW "【  女  侠  】" NOR;
                  if (exp > 5000)
                    return HIW "【 小 女 侠 】" NOR;
                  return HIG "【  平  民  】" NOR;

                case "明教":
                  if (exp > 1000000)
                    return HIR "【 副 教 主 】" NOR;
                  if (exp > 800000)
                    return HIM "【  法  王  】" NOR;
                  if (exp > 600000)
                    return HIG "【 总 护 法 】" NOR;
                  if (exp > 400000)
                    return HIY "【  护  法  】" NOR;
                  if (exp > 100000)
                    return HIY "【 总 堂 主 】" NOR;
                  if (exp > 50000)
                    return HIC "【 副 堂 主 】" NOR;
                  if (exp > 25000)
                    return HIC "【  旗  王  】" NOR;
                  if (exp > 10000)
                    return HIW "【 副 旗 王 】" NOR;
                  if (exp > 5000)
                    return HIW "【  教  众  】" NOR;
                  return HIB "【  教  众  】" NOR;
                default:
                  if (exp > 10000000) {
                    if (shen >= 50000)
                      return HIY "【 旷世女侠 】" NOR;
                    if (shen <= -50000)
                      return HIY "【 惊世女魔 】" NOR;
                    else
                      return HIR "【 天之骄女 】" NOR;
                  }
                  if (exp >= 8000000) {
                    if (shen >= 50000)
                      return HIY "【 巾帼英雄 】" NOR;
                    if (shen <= -50000)
                      return HIY "【 女 罗 刹 】" NOR;
                    else
                      return HIR "【 泰山之绣 】" NOR;
                  }
                  if (exp >= 6000000)
                    return HIC "【 一代宗师 】" NOR;
                  if (exp >= 4000000)
                    return HIM "【 武林绣女 】" NOR;
                  if (exp >= 1000000)
                    return HIM "【 武林新秀 】" NOR;
                  if (exp >= 50000)
                    return HIB "【 稍有名气 】" NOR;
                  if (exp >= 25000)
                    return HIG "【  高  手  】" NOR;
                  if (exp >= 5000)
                    return HIG "【  新  秀  】" NOR;
                  return HIM "【 芊芊民女 】" NOR;
              }
          }
      }
    default:
      switch (wizhood(ob)) {

        case "(admin)":
          return HIW "【  天  帝  】" NOR;
        case "(sage)":
          return HIR "【  大  神  】" NOR;
        case "(arch)":
          return HIM "【  神  仙  】" NOR;
        case "(angel)":
          return HIY "【  散  仙  】" NOR;
        case "(wizard)":
          return HIG "【  天  官  】" NOR;
        case "(apprentice)":
          return HIR "【  仙  人  】" NOR;
        case "(genie)":
          return HIB "【  精  灵  】" NOR;
        case "(immortal)":
          return HIC "【  仙  子  】" NOR;
        default:
          if (((int)ob->query("PKS") > 100) &&
            ((int)ob->query("PKS") > (int)ob->query("MKS")))
            return HIG "【 杀人狂魔 】" NOR;
          if ((int)ob->query("thief") > 10)
            return HIW "【 无赖惯窃 】" NOR;
          switch (menpai) {
            case "武当派":
              if (exp > 1000000) {
                if (shen >= 0)
                  return HIR "【  天  师  】" NOR;
                else
                  return HIR "【 畸 天 师 】" NOR;
              }
              if (exp > 800000)
                return HIM "【  国  师  】" NOR;
              if (exp > 600000)
                return HIG "【  真  人  】" NOR;
              if (exp > 400000)
                return HIY "【 大 法 师 】" NOR;
              if (exp > 100000)
                return HIY "【  法  师  】" NOR;
              if (exp > 50000)
                return HIC "【  道  长  】" NOR;
              if (exp > 25000)
                return HIC "【  道  士  】" NOR;
              if (exp > 10000)
                return HIW "【  道  士  】" NOR;
              if (exp > 5000)
                return HIW "【 大 道 童 】" NOR;
              return HIC "【  道  童  】" NOR;

            case "华山派":
              if (exp > 1000000) {
                if (shen >= 0)
                  return HIR "【 惊天一剑 】" NOR;
                else
                  return HIR "【 惊魔一剑 】" NOR;
              }
              if (exp > 800000) {
                if (shen >= 0)
                  return HIM "【  剑  圣  】" NOR;
                else
                  return HIM "【  剑  魔  】" NOR;
              }
              if (exp > 600000) {
                if (shen >= 0)
                  return HIG "【  剑  仙  】" NOR;
                else
                  return HIG "【  邪  剑  】" NOR;
              }
              if (exp > 400000)
                return HIY "【  剑  豪  】" NOR;
              if (exp > 100000)
                return HIY "【  剑  侠  】" NOR;
              if (exp > 50000)
                return HIC "【 大 剑 客 】" NOR;
              if (exp > 25000)
                return HIC "【  剑  客  】" NOR;
              if (exp > 10000)
                return HIW "【 大 剑 士 】" NOR;
              if (exp > 5000)
                return HIW "【  剑  士  】" NOR;
              return HIG "【  剑  童  】" NOR;

            case "丐帮":
              if (exp > 1000000)
                return HIR "【 副 帮 主 】" NOR;
              if (exp > 800000)
                return HIM "【 大 长 老 】" NOR;
              if (exp > 600000)
                return HIG "【  长  老  】" NOR;
              if (exp > 400000)
                return HIY "【 传 功 使 】" NOR;
              if (exp > 100000)
                return HIY "【 执 法 使 】" NOR;
              if (exp > 50000)
                return HIC "【  神  丐  】" NOR;
              if (exp > 25000)
                return HIC "【 小 神 丐 】" NOR;
              if (exp > 10000)
                return HIW "【  乞  丐  】" NOR;
              if (exp > 5000)
                return HIW "【 小 乞 丐 】" NOR;
              return HIB "【 叫 化 子 】" NOR;

            case "星宿派":
            case "桃花岛":
              if (exp > 1000000) {
                if (shen >= 0)
                  return HIR "【 魔 见 愁 】" NOR;
                else
                  return HIR "【  狂  魔  】" NOR;
              }
              if (exp > 800000)
                return HIM "【 世外高人 】" NOR;
              if (exp > 600000)
                return HIG "【 旷世奇侠 】" NOR;
              if (exp > 400000)
                return HIY "【 大 豪 侠 】" NOR;
              if (exp > 100000)
                return HIY "【  豪  侠  】" NOR;
              if (exp > 50000)
                return HIC "【  大  侠  】" NOR;
              if (exp > 25000)
                return HIC "【  侠  士  】" NOR;
              if (exp > 10000)
                return HIW "【  游  侠  】" NOR;
              if (exp > 5000)
                return HIW "【  少  侠  】" NOR;
              return HIG "【  平  民  】" NOR;

            case "明教":
              if (exp > 1000000)
                return HIR "【 副 教 主 】" NOR;
              if (exp > 800000)
                return HIM "【  法  王  】" NOR;
              if (exp > 600000)
                return HIG "【 总 护 法 】" NOR;
              if (exp > 400000)
                return HIY "【  护  法  】" NOR;
              if (exp > 100000)
                return HIY "【 总 堂 主 】" NOR;
              if (exp > 50000)
                return HIC "【 副 堂 主 】" NOR;
              if (exp > 25000)
                return HIC "【  旗  王  】" NOR;
              if (exp > 10000)
                return HIW "【 副 旗 王 】" NOR;
              if (exp > 5000)
                return HIW "【  教  众  】" NOR;
              return HIB "【  教  友  】" NOR;

            case "少林派":
              if (exp > 1000000)
                return HIR "【  长  老  】" NOR;
              if (exp > 800000)
                return HIM "【  圣  僧  】" NOR;
              if (exp > 600000)
                return HIG "【  罗  汉  】" NOR;
              if (exp > 400000)
                return HIY "【  禅  师  】" NOR;
              if (exp > 100000)
                return HIY "【  尊  者  】" NOR;
              if (exp > 50000)
                return HIC "【  比  丘  】" NOR;
              if (exp > 25000)
                return HIC "【 护 寺 僧 】" NOR;
              if (exp > 10000)
                return HIW "【  武  僧  】" NOR;
              if (exp > 5000)
                return HIW "【 大 僧 人 】" NOR;
              return HIG "【  僧  人  】" NOR;
            default:
              switch (ob->query("class")) {
                case "bandit":
                  return HIR "【  盗  贼  】" NOR;
                case "bangzhong":
                  if (exp >= 5000000)
                    return HIY "【凌波宫宫主】" NOR;
                  else if (exp >= 2500000)
                    return HIR "【凌波宫执法】" NOR;
                  else if (exp >= 1000000)
                    return HIB "【凌波宫护法】" NOR;
                  else if (exp >= 500000)
                    return HIC "【凌波宫使者】" NOR;
                  else if (exp >= 100000)
                    return HIW "【凌波宫将军】" NOR;
                  else
                    return HIG "【" + bangname + "帮众】" NOR;

                case "scholar":
                  return HIG "【 翩翩才子 】" NOR;
                case "bandit":
                  return HIB "【 梁上君子 】" NOR;
                case "yishi":
                  return HIB "【 江湖义士 】" NOR;
                case "taoist":
                  return HIY "【 云游道士 】" NOR;
                case "bonze":
                  if (budd >= 150)
                    return HIY "【  长  老  】" NOR;
                  else if (budd >= 120)
                    return HIY "【  圣  僧  】" NOR;
                  else if (budd >= 90)
                    return HIY "【  罗  汉  】" NOR;
                case "officer":
                  return HIG "【  官  差  】" NOR;
                case "fighter":
                  return HIG "【  武  者  】" NOR;
                case "swordsman":
                  return HIG "【  剑  士  】" NOR;
                case "alchemist":
                  return HIG "【  方  士  】" NOR;
                case "shaman":
                  return HIG "【  巫  医  】" NOR;
                case "beggar":
                  if (age <= 16)
                    return HIG "【 小 叫 化 】" NOR;
                  else
                    return HIG "【 叫 化 子 】" NOR;
                case "eunach":
                  budd = ob->query_skill("pixie-jian", 1);
                  if (budd >= 110)
                    return HIY "【 大内高手 】" NOR;
                  else if (budd >= 100)
                    return HIY "【 东厂万户 】" NOR;
                  else if (budd >= 90)
                    return HIY "【 东厂千户 】" NOR;
                  else if (budd >= 80)
                    return HIY "【 东厂百户 】" NOR;
                  else if (budd >= 70)
                    return HIY "【 东厂十户 】" NOR;
                  else if (budd >= 60)
                    return HIY "【 东厂公公 】" NOR;
                  else return NOR HIC "【  内  侍  】" NOR;
                case "sharenfan":
                  return HIW "【 通 缉 犯 】" NOR;
                case "prostitute":
                  return HIY "【  龟  公  】" NOR;
                default:
                  if (exp >= 10000000)
                    return HIW "【 天之骄子 】" NOR;
                  if (exp >= 8000000)
                    return HIC "【 泰山之斗 】" NOR;
                  if (exp >= 6000000)
                    return HIC "【 一代宗师 】" NOR;
                  if (exp >= 4000000)
                    return HIM "【 武林刹帝 】" NOR;
                  if (exp >= 1000000)
                    return HIM "【 名扬天下 】" NOR;
                  if (exp >= 50000)
                    return HIB "【 武林新秀 】" NOR;
                  if (exp >= 25000)
                    return HIB "【 小有名气 】" NOR;
                  if (exp >= 5000)
                    return HIG "【  新  秀  】" NOR;
                  return HIG "【  平  民  】" NOR;
              }
          }
      }
  }
}
string query_respect(object ob) {
  int age;
  string str;

  if (stringp(str = ob->query("rank_info/respect")))
    return str;

  age = ob->query("age");
  switch (ob->query("gender")) {
    case "女性":
      switch (ob->query("class")) {
        case "bonze":
          if (age < 18) return "小师太";
          else return "师太";
          break;
        case "taoist":
          if (age < 18) return "小仙姑";
          else return "仙姑";
          break;
        default:
          if (age < 18) return "小姑娘";
          else if (age < 50) return "姑娘";
          else return "婆婆";
          break;
      }
    case "男性":
    default:
      switch (ob->query("class")) {
        case "bonze":
          if (age < 18) return "小师父";
          else return "大师";
          break;
        case "taoist":
          if (age < 18) return "道兄";
          else return "道长";
          break;
        case "fighter":
        case "swordsman":
          if (age < 18) return "小老弟";
          else if (age < 50) return "壮士";
          else return "老前辈";
          break;
        default:
          if (age < 20) return "小兄弟";
          else if (age < 50) return "壮士";
          else return "老爷子";
          break;
      }
  }
}

string query_rude(object ob) {
  int age;
  string str;

  if (stringp(str = ob->query("rank_info/rude")))
    return str;

  age = ob->query("age");
  switch (ob->query("gender")) {
    case "女性":
      switch (ob->query("class")) {
        case "bonze":
          return "贼尼";
          break;
        case "taoist":
          return "妖女";
          break;
        default:
          if (age < 30) return "小贱人";
          else return "死老太婆";
          break;
      }
    case "男性":
    default:
      switch (ob->query("class")) {
        case "bonze":
          if (age < 50) return "死秃驴";
          else return "老秃驴";
          break;
        case "taoist":
          return "死牛鼻子";
          break;
        default:
          if (age < 20) return "小王八蛋";
          if (age < 50) return "臭贼";
          else return "老匹夫";
          break;
      }
  }
}

string query_self(object ob) {
  int age;
