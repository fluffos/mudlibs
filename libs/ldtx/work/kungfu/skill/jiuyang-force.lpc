\par string query_skill_name(int level)
\par \{
\par         int i;
\par         for(i = sizeof(action)-1; i >= 0; i--)
\par                 if(level >= action[i]["lvl"])
\par                         return action[i]["skill_name"];
\par \}
\par 
\par mapping query_action(object me, object weapon)
\par \{
\par         int i, level;
\par         level   = (int) me->query_skill("jiuyang-force",1);
\par         for(i = sizeof(action); i > 0; i--)
\par                 if(level > action[i-1]["lvl"])
\par                         return action[NewRandom(i, 20, level/5)];
\par \}
\par mixed hit_ob(object me, object victim, int damage_bonus, int factor)
\par \{
\par         mixed foo;
\par         int force;
\par 
\par         foo = ::hit_ob(me, victim, damage_bonus, factor);
\par         if( intp(foo) && (damage_bonus + foo > 0) ) \{
\par               if( (random(2*(me->query_skill("jiuyang-force"))) > (damage_bonus + foo))&&(me->query("max_neili")>2000)&&(me->query_skill("jiuyang-force")>120) )
\par                  \{                        
\par                         force = me->query_skill("force");
\par                         victim->receive_wound("qi", (damage_bonus + foo));
\par                         victim->receive_wound("jing", random(force/2));
\par                         victim->set("neili", 0);
\par                         return
\par HIR"$N\'b5\'c4\'be\'c5\'d1\'f4\'d5\'e6\'c6\'f8\'b4\'dd\'bb\'d9\'c1\'cb$n\'b5\'c4\'d5\'e6\'d4\'aa\'a3\'a1\'a3\'a1\'a3\'a1\'a3\'a1\\n"NOR;
\par                 \}
\par         \}
\par         return foo;
\par \}
\par 
\par int valid_enable(string usage) 
\par \{ 
\par return  usage=="iron-cloth" ||
\par         usage=="unarmed" ||
\par         usage=="parry"||
\par         usage=="force";
\par \}
\par 
\par int valid_learn(object me,mapping fam)
\par \{
\par         if (!(fam = this_player()->query("family")) || fam["family_name"] != "\'c3\'f7\'bd\'cc")
\par                 return notify_fail("\'c4\'e3\'b2\'bb\'ca\'c7\'c3\'f7\'bd\'cc\'b5\'dc\'d7\'d3\'d3\'d6\'d4\'f5\'c3\'b4\'c4\'dc\'d1\'a7\'b8\'fc\'b8\'df\'c9\'ee\'b5\'c4\'be\'c5\'d1\'f4\'d5\'e6\'c6\'f8\'c4\'d8?\\n");
\par         if ((int)me->query("max_neili") < 1500)
\par                 return notify_fail("\'c4\'e3\'b5\'c4\'c4\'da\'c1\'a6\'b2\'bb\'b9\'bb\'a1\'a3\\n");
\par         if ((int)me->query("combat_exp") < 1000000)
\par                 return notify_fail("\'c4\'e3\'b5\'c4\'c4\'dc\'c1\'a6\'bb\'b9\'c3\'bb\'b4\'ef\'b5\'bd\'d1\'a7\'b8\'fc\'b8\'df\'c9\'ee\'b5\'c4\'be\'c5\'d1\'f4\'d5\'e6\'c6\'f8\'b5\'c4\'b5\'d8\'b2\'bd\'a1\'a3 \\n");
\par         if ( me->query_skill("bibo-shengong",1)
\par         || me->query_skill("beiming-shengong",1)
\par         || me->query_skill("bahuang-gong",1)
\par         || me->query_skill("hamagong",1)
\par         || me->query_skill("huagong-dafa",1)
\par         || me->query_skill("huntian-qigong",1)
\par         || me->query_skill("hunyuan-yiqi",1)
\par         || me->query_skill("longxiang",1)
\par         || me->query_skill("jiuyang-shengong",1)
\par         || me->query_skill("shenyuan-gong",1)
\par         || me->query_skill("taiji-shengong",1)
\par         || me->query_skill("xiaowuxiang",1)
\par         || me->query_skill("zixia-shengong",1) 
\par         || me->query_skill("kurong-changong",1)
\par         || me->query_skill("wuji-shengong",1)
\par         || me->query_skill("guiyuan-dafa",1)
\par         || me->query_skill("xiantian-wuji",1)
\par         || me->query_skill("xixing-dafa",1)
\par \pard\plain\f3\fs18         \plain\f5\fs18 || me->query_skill("xixing-dafa",1)
\par \pard\plain\f3\fs18         || me->query_skill("xixing-dafa",1)
\par         || me->query_skill("tiangang-zhengqi",1))
\par                 return notify_fail("\'c4\'e3\'b2\'bb\'cf\'c8\'c9\'a2\'c1\'cb\'b1\'f0\'c5\'c9\'c4\'da\'b9\'a6\'a3\'ac\'d4\'f5\'c4\'dc\'d1\'a7\'be\'c5\'d1\'f4\'d5\'e6\'c6\'f8\'a3\'bf\'a3\'a1\\n");
\par                 
\par         return 1;
\par \}
\par 
\par int practice_skill(object me)
\par \{
\par         return 
\par notify_fail("\'be\'c5\'d1\'f4\'d5\'e6\'c6\'f8\'d6\'bb\'c4\'dc\'d3\'c3\'d1\'a7\'b5\'c4\'a3\'ac\'bb\'f2\'ca\'c7\'b4\'d3\'d4\'cb\'d3\'c3(exert)\'d6\'d0\'d4\'f6\'bc\'d3\'ca\'ec\'c1\'b7\'b6\'c8\'a1\'a3\\\\n");
\par \}
\par 
\par int effective_level() \{ return 21; \}
\par string *absorb_msg = (\{
\par        GRN "$n\'c9\'ed\'cc\'e5\'d0\'e9\'d7\'aa\'a3\'ac\'cb\'ab\'ca\'d6\'ce\'a2\'bb\'ae\'a3\'ac\'ce\'de\'bc\'e1\'b2\'bb\'b4\'dd\'b5\'c4\'be\'c5\'d1\'f4\'d5\'e6\'c6\'f8\'c5\'ec\'c5\'c8\'b6\'f8\'b3\'f6\'a1\'a3\\n",
\par        GRN"$n\'ca\'a9\'d5\'b9\'b3\'f6\'be\'c5\'d1\'f4\'d5\'e6\'c6\'f8\'a3\'ac\'bb\'eb\'c9\'ed\'bc\'a1\'b7\'f4\'bc\'e1\'c8\'e7\'ba\'ae\'cc\'fa\'a1\'a3\\n",
\par        GRN "$n\'c9\'ed\'d0\'cd\'ce\'a2\'d5\'b9\'a3\'ac\'be\'c5\'d1\'f4\'d5\'e6\'c6\'f8\'b3\'e4\'b3\'e2\'c1\'cb\'d5\'c9\'d0\'ed\'bf\'d5\'bc\'e4\'a1\'a3\\n",
\par \});
\par 
\par string query_absorb_msg()
\par \{
\par         return absorb_msg[random(sizeof(absorb_msg))];
\par \}
\par string *unarmed_parry_msg = (\{
\par         GRN"$n\'d2\'c2\'c9\'c0\'c5\'ec\'c5\'c8\'a3\'ac\'c4\'da\'c1\'a6\'e3\'e9\'e3\'e9\'a3\'ac$N\'b8\'f9\'b1\'be\'b2\'bb\'bf\'c9\'bd\'fc\'c9\'ed\'a1\'a3\\n",
\par         GRN"$n\'b3\'a4\'d0\'e4\'d2\'bb\'cb\'a6\'a3\'ac\'d2\'bb\'b9\'c9\'b4\'f3\'c1\'a6\'bd\'ab$N\'cb\'cd\'b3\'f6\'d5\'c9\'cd\'e2\'a1\'a3\\n",
\par         GRN"$n\'ca\'a9\'d5\'b9\'b3\'f6\'a1\'b8\'bb\'ec\'d4\'aa\'ce\'de\'ce\'d2\'a1\'b9\'a3\'ac\'c7\'e1\'c3\'e8\'b5\'ad\'d0\'b4\'b5\'c4\'bb\'af\'bd\'e2\'c1\'cb$N\'b5\'c4\'b9\'a5\'ca\'c6\'a1\'a3\\n",
\par \});
\par string *parry_msg = (\{
\par         GRN"$n\'d2\'c2\'c9\'c0\'c5\'ec\'c5\'c8\'a3\'ac\'c4\'da\'c1\'a6\'e3\'e9\'e3\'e9\'a3\'ac$N\'b8\'f9\'b1\'be\'b2\'bb\'bf\'c9\'bd\'fc\'c9\'ed\'a1\'a3\\n",
\par         GRN"$n\'b3\'a4\'d0\'e4\'d2\'bb\'cb\'a6\'a3\'ac\'d2\'bb\'b9\'c9\'b4\'f3\'c1\'a6\'bd\'ab$N\'cb\'cd\'b3\'f6\'d5\'c9\'cd\'e2\'a1\'a3\\n",
\par         GRN"$n\'ca\'a9\'d5\'b9\'b3\'f6\'a1\'b8\'be\'c5\'d1\'f4\'ce\'de\'ce\'d2\'a1\'b9\'a3\'ac\'c7\'e1\'c3\'e8\'b5\'ad\'d0\'b4\'b5\'c4\'bb\'af\'bd\'e2\'c1\'cb$N\'b5\'c4\'b9\'a5\'ca\'c6\'a1\'a3\\n",
\par \});
\par string query_parry_msg(object weapon)
\par \{
\par         if( weapon )
\par                 return parry_msg[random(sizeof(parry_msg))];
\par         else
\par                 return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
\par \}
\par string exert_function_file(string func)
\par \{
\par        return __DIR__"jiuyang-force/" + func;
\par \}
\par int bounce_ratio()
\par \{
\par         return 40;
\par \}
\par 
\par int learn_bonus()
\par \{
\par         return -100;
\par \}
\par int practice_bonus()
\par \{
\par         return -500;
\par \}
