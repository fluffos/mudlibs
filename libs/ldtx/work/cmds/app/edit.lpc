// edit.c
// Modified by mouse
inherit F_CLEAN_UP;
int help(object me);
#include "ansi.h"
inherit F_DBASE;
void create() {
  seteuid(getuid());
  set("name", "编辑指令");
  set("id", "edit");
  set("channel_id", "写作精灵");
}

int main(object me, string file) {
  string files, file1, file2;
  if (!file) return notify_fail("指令格式：edit <档名>\n");

  if (in_edit(me)) return notify_fail("你已经在使用编辑器了。\n");

  seteuid(geteuid(me));
  files = file + ".o";
  ed(resolve_path(me->query("cwd"), file));
  file1 = resolve_path(me->query("cwd"), file);
  file2 = resolve_path(me->query("cwd"), files);
  cp(file1, file2);
  log_file("nosave/editfile", sprintf("%s%s edit %s (%s)\n", me->query("name"),
    "(" + me->query("id") + ")", resolve_path(me->query("cwd"), file), ctime(time())));
  CHANNEL_D->do_channel(this_object(), "sys", me->query("name") + "(" + me->query("id") + ")" + "编写了" +
    resolve_path(me->query("cwd"), file) + "。\n" NOR);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : edit <档名>, edit here

利用此一指令可直接在线上编辑档案。
HELP
  );
  return 1;
}
