#include <ansi.h>
#include <net/daemons.h>

inherit F_CLEAN_UP;

nosave int delay=0;

int main(object me, string arg)
{
        if( me != this_player(1) ) return 0;
        
        if( wiz_level(me) < wiz_level("(arch)") )
                return notify_fail("只有 (arch) 以上的巫师才能重新启动" + MUD_NAME + "\n");
        write("发出 Reboot 信息。\n");
	log_file("nosave/reboot", sprintf("%s%s reboot system at (%s)\n",
					  me->query("name"),
                			  "(" + me->query("id") + ")" ,
                			  ctime(time())    
					   ) );                			      
        call_out("reboot", 1 );
        return 1;
}

int reboot()
{
        if( delay > 3 ) {
                message( "system", HIR "\n\n\n游戏重新启动，请稍候一分钟再 login 。\n\n\n" NOR, users() );
                if( find_object(DNS_MASTER) ) DNS_MASTER->send_shutdown();
                shutdown(0);
        }
        else {
                delay ++;
                message( "system", 
                        sprintf( BOLD "\n%s告诉你：系统将在 %d 秒后重新启动，请 save 和 quit 。\n\n" NOR,
                                MUD_NAME,
                                (5-delay)*60), 
                        users()
                );
                call_out("reboot",60);
        }
        return 1;
}

int help (object me)
{
        write(@HELP
指令格式: shutdown
 
重新启动游戏。
 
HELP
);
        return 1;
}

