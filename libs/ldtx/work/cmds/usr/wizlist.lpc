// wizlist.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *list;

  write("【" HIW + MUD_NAME + NOR "】" + "目前的巫师有：\n");
  write("────────────────────────────\n");
  list = sort_array(SECURITY_D->query_wizlist(), 1);
  write(HIW "【 天  神 】：" NOR);
  for (int i = 0; i < sizeof(list); i++)
    printf("%s", (wiz_level(list[i]) == 8) ? "(" HIW + list[i] + NOR ") " : "");
  write("\n" HIM "【天界长老】：" NOR);
  for (int i = 0; i < sizeof(list); i++)
    printf("%s", (wiz_level(list[i]) == 7) ? "(" HIR + list[i] + NOR ") " : "");
  write("\n" HIY "【 大  神 】：" NOR);
  for (int j = 0; j < sizeof(list); j++)
    printf("%s", (wiz_level(list[j]) == 6) ? "(" HIM + list[j] + NOR ") " : "");
  write("\n" HIG "【 神  仙 】：" NOR);
  for (int i = 0; i < sizeof(list); i++)
    printf("%s", (wiz_level(list[i]) == 5) ? "(" HIY + list[i] + NOR ") " : "");
  write("\n" HIC "【 散  仙 】：" NOR);
  for (int k = 0; k < sizeof(list); k++)
    printf("%s", (wiz_level(list[k]) == 4) ? "(" HIG + list[k] + NOR ") " : "");
  write("\n" HIR "【 天  官 】：" NOR);
  for (int l = 0; l < sizeof(list); l++)
    printf("%s", (wiz_level(list[l]) == 3) ? "(" HIC + list[l] + NOR ") " : "");
  write("\n" HIB "【 仙  人 】：" NOR);
  for (int i = 0; i < sizeof(list); i++)
    printf("%s", (wiz_level(list[i]) == 2) ? "(" HIB + list[i] + NOR ") " : "");
  write("\n" MAG "【 仙  童 】：" NOR);
  for (int m = 0; m < sizeof(list); m++)
    printf("%s", (wiz_level(list[m]) == 1) ? "(" MAG + list[m] + NOR ") " : "");
  write("\n────────────────────────────\n");
  write("合共有： " HIR + sizeof(list) + NOR " 位。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : wizlist

用途 : 列出目前所有的巫师名单。
HELP
  );
  return 1;
}
