#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIR "玩家巫师交流意见专用板" NOR, ({ "wizboard" }));
  set("location", "/d/city/wumiao");
  set("board_id", "mousekd_b");
  set("long", "这里是巫师与玩家用的交流版，其他的留言一概杀无赦。\n");
  setup();
  set("capacity", 1000);
  replace_program(BULLETIN_BOARD);
}
