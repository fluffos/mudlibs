/*
 * Glass of elvish white wine — Chez Brigan (Silvere).
 *
 * Strategy A FluffOS object. Original inherit /std/drink
 * is wineglass_ldmud.lpc. Archive Set_Vessel_Value(2);
 * QueryShort is "a glass filled with elvish white wine".
 */

string *ids;

void create() {
  seteuid(getuid());
  ids = ({
    "wine", "white wine", "elvish white wine", "elvish wine",
    "glass", "wine glass", "glass of wine",
    "glass of elvish white wine",
  });
}

string short() { return "a glass filled with elvish white wine"; }
string query_short() { return short(); }
string query_name() { return short(); }
string query_long() {
  return "A wine glass from the wine shop in Silvere.\n";
}
int query_value() { return 2; }

int id(string str) {
  if (!str || !ids)
    return 0;
  return member_array(str, ids) != -1;
}

void move(mixed dest) {
  if (objectp(dest))
    efun::move_object(dest);
}
