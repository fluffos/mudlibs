/*
 * Bottle of elvish white wine — Chez Brigan (Silvere).
 *
 * Strategy A FluffOS object. Original inherit std/drink
 * is elfwine_ldmud.lpc. Archive SetValue(400).
 */

string *ids;

void create() {
  seteuid(getuid());
  ids = ({
    "wine", "white wine", "elvish white wine", "elfwine",
    "bottle", "wine bottle", "bottle of wine",
    "bottle of elvish white wine",
  });
}

string short() { return "a bottle filled with elvish white wine"; }
string query_short() { return short(); }
string query_name() { return short(); }
string query_long() {
  return "A fine glass bottle from the wine shop in Silvere.\n";
}
int query_value() { return 400; }

int id(string str) {
  if (!str || !ids)
    return 0;
  return member_array(str, ids) != -1;
}

void move(mixed dest) {
  if (objectp(dest))
    efun::move_object(dest);
}
