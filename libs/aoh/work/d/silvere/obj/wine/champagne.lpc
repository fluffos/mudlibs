/*
 * Bottle of champagne — Chez Brigan (Silvere).
 *
 * Strategy A FluffOS object. Original inherit std/drink
 * is champagne_ldmud.lpc. Archive SetValue(500).
 */

string *ids;

void create() {
  seteuid(getuid());
  ids = ({
    "champagne", "bottle", "champagne bottle",
    "bottle of champagne",
  });
}

string short() { return "a bottle filled with champagne"; }
string query_short() { return short(); }
string query_name() { return short(); }
string query_long() {
  return "A fine glass bottle from the wine shop in Silvere.\n";
}
int query_value() { return 500; }

int id(string str) {
  if (!str || !ids)
    return 0;
  return member_array(str, ids) != -1;
}

void move(mixed dest) {
  if (objectp(dest))
    efun::move_object(dest);
}
