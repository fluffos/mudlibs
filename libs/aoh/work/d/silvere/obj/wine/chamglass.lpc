/*
 * Glass of champagne — Chez Brigan (Silvere).
 *
 * Strategy A FluffOS object. Original inherit std/drink
 * is chamglass_ldmud.lpc. Archive SetValue(50).
 */

string *ids;

void create() {
  seteuid(getuid());
  ids = ({
    "champagne", "glass", "champagne glass",
    "glass of champagne", "chamglass",
  });
}

string short() { return "a glass filled with champagne"; }
string query_short() { return short(); }
string query_name() { return short(); }
string query_long() {
  return "A champagne glass from the wine shop in Silvere.\n";
}
int query_value() { return 50; }

int id(string str) {
  if (!str || !ids)
    return 0;
  return member_array(str, ids) != -1;
}

void move(mixed dest) {
  if (objectp(dest))
    efun::move_object(dest);
}
