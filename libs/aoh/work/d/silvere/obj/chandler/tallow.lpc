/*
 * Cheap tallow candle — Molly's Chandler (Silvere).
 *
 * Strategy A FluffOS object. Original inherit /obj/candle
 * (LDMud /std/lamp) is tallow_ldmud.lpc. Archive SetValues(10, 0)
 * is 10 copper.
 */

string *ids;

void create() {
  seteuid(getuid());
  ids = ({
    "candle", "light", "tallow", "taper",
    "tallow candle", "cheap tallow candle", "cheap candle",
  });
}

string short() { return "a cheap tallow candle"; }
string query_short() { return short(); }
string query_name() { return short(); }
string query_long() { return "A tallow candle.\n"; }
int query_value() { return 10; }

int id(string str) {
  if (!str || !ids)
    return 0;
  return member_array(str, ids) != -1;
}

void move(mixed dest) {
  if (objectp(dest))
    efun::move_object(dest);
}
