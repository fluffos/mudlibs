/*
 * Beeswax candle — Molly's Chandler (Silvere).
 *
 * Strategy A FluffOS object. Original inherit /obj/candle
 * (LDMud /std/lamp) is wax_ldmud.lpc. Archive SetValues(18, 0)
 * is 18 copper.
 */

string *ids;

void create() {
  seteuid(getuid());
  ids = ({
    "candle", "light", "wax", "beeswax",
    "beeswax candle", "wax candle", "white candle",
  });
}

string short() { return "a beeswax candle"; }
string query_short() { return short(); }
string query_name() { return short(); }
string query_long() {
  return "A smooth, white candle of pure beeswax.\n";
}
int query_value() { return 18; }

int id(string str) {
  if (!str || !ids)
    return 0;
  return member_array(str, ids) != -1;
}

void move(mixed dest) {
  if (objectp(dest))
    efun::move_object(dest);
}
