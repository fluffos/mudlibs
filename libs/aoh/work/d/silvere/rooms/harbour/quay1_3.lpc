/*
 * The quay at Silvere — west of STARTROOM quay1_2.
 *
 * Strategy A FluffOS room. Original LDMud file (hooks, TimeMsg,
 * west to ntower_enter) is saved as quay1_3_ldmud.lpc. The northern
 * defense tower is not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/quay1_2",
    "e": "/d/silvere/rooms/harbour/quay1_2",
  ]);
  extras = ([
    "sails":
      "Torn and thrown away remains of sails. Nobody cares for all that "
      "rubbish here.\n",
    "sail":
      "Torn and thrown away remains of sails. Nobody cares for all that "
      "rubbish here.\n",
    "oars":
      "Hmm... these oars are nothing more than firewood now.\n",
    "oar":
      "Hmm... these oars are nothing more than firewood now.\n",
    "towers":
      "The towers can be found at the end of each quay. They are high "
      "and it seems that they watch over the harbour of Silvere. They "
      "look quite interesting though.\n",
    "tower":
      "The towers can be found at the end of each quay. They are high "
      "and it seems that they watch over the harbour of Silvere. They "
      "look quite interesting though.\n",
    "hooks":
      "They look really nasty. Take care you don't get caught on one "
      "of them.\n",
    "line":
      "Useless fishing lines are littered everywhere. Take care you "
      "don't get caught on one of the nasty hooks.\n",
    "lines":
      "Useless fishing lines are littered everywhere. Take care you "
      "don't get caught on one of the nasty hooks.\n",
  ]);
}

string query_short() { return "The quay at Silvere"; }

string query_long() {
  return
    "The quay runs along the murky water out to one of the towers "
    "guarding the entrance to the bay. Torn sails, fishing line and "
    "discarded oars litter the sides of the quay. The sunlight plays "
    "off the water, casting strange shadows on the tower walls.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "quay" || str == "docks" || str == "here"; }
