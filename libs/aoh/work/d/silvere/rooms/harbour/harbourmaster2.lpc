/*
 * Upstairs in the Harbourmaster's Office — up from
 * the already-live office.
 *
 * Strategy A FluffOS room. Original (through-telescope
 * live query) is harbourmaster2_ldmud.lpc. Look-ats
 * only; look through the telescope is not wired this
 * slice. Static brass-tube description is the archive
 * default (not the through-prep branch).
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "down": "/d/silvere/rooms/harbour/harbourmaster",
    "d": "/d/silvere/rooms/harbour/harbourmaster",
  ]);
  extras = ([
    "telescope":
      "A long, polished tube of brass, with glass fitted into both "
      "ends. The contraption is set up on a stand fixed to the floor "
      "before the window. It points out to the harbour and the open "
      "sea beyond the towers.\n",
    "spy glass":
      "A long, polished tube of brass, with glass fitted into both "
      "ends. The contraption is set up on a stand fixed to the floor "
      "before the window. It points out to the harbour and the open "
      "sea beyond the towers.\n",
    "tube":
      "A long, polished tube of brass, with glass fitted into both "
      "ends. The contraption is set up on a stand fixed to the floor "
      "before the window. It points out to the harbour and the open "
      "sea beyond the towers.\n",
    "brass telescope":
      "A long, polished tube of brass, with glass fitted into both "
      "ends. The contraption is set up on a stand fixed to the floor "
      "before the window. It points out to the harbour and the open "
      "sea beyond the towers.\n",
    "brass tube":
      "A long, polished tube of brass, with glass fitted into both "
      "ends. The contraption is set up on a stand fixed to the floor "
      "before the window. It points out to the harbour and the open "
      "sea beyond the towers.\n",
    "brass spy glass":
      "A long, polished tube of brass, with glass fitted into both "
      "ends. The contraption is set up on a stand fixed to the floor "
      "before the window. It points out to the harbour and the open "
      "sea beyond the towers.\n",
  ]);
}

string query_short() { return "Upstairs in the Harbourmaster's Office"; }

string query_long() {
  return
    "A tiny room above the office. Big window looking out on "
    "the harbour. A telescope is set up, pointing out towards "
    "the harbour.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is down.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "office" || str == "room" || str == "here";
}
