/*
 * Southern defense tower rooftop
 * catapult — south of stower9.
 *
 * Strategy A FluffOS room. Original
 * (no AddDetail, north stower9, east
 * stower11) is stower10_ldmud.lpc.
 * Look-ats only: catapult load/aim/
 * fire are not loaded. Archive keeps
 * “pointing on the open sea” and
 * “watching out of the sea”. North
 * stower9 and east stower11 are
 * loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/harbour/stower9",
    "n": "/d/silvere/rooms/harbour/stower9",
    "east": "/d/silvere/rooms/harbour/stower11",
    "e": "/d/silvere/rooms/harbour/stower11",
  ]);
  extras = ([ ]);
}

string query_short() { return "On the tower"; }

string query_long() {
  return
    "A catapult stands here, pointing on the open sea. Two men are "
    "standing here, watching out of the sea. To the east is a small "
    "shelter from the sun.\n"
    "East:  To a shelter\n"
    "North: To the platform and the stairs";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
