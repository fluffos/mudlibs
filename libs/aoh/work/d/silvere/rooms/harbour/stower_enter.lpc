/*
 * Before the southern defense tower — west of quay2_3.
 *
 * Strategy A FluffOS room. Original (chain machinery, guards,
 * west into the tower) is stower_enter_ldmud.lpc. The tower
 * interior is not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/quay2_3",
    "e": "/d/silvere/rooms/harbour/quay2_3",
  ]);
  extras = ([
    "tower":
      "The square stone tower is crowned with battlements high above. "
      "A gloomy entrance is set into the thick eastern wall.\n",
    "towers":
      "Which tower do you mean? Directly before you stands the "
      "southern tower. The northern tower stands on the far end of "
      "the northern quay.\n",
    "chain":
      "A large and heavy chain hangs down from the tower here "
      "and vanishes into the water nearly at the wall of that "
      "building. The other end hangs from the northern tower.\n",
    "wall":
      "The wall of the tower rises high into the sky before your "
      "eyes. On top of it you can faintly make out battlements.\n",
    "entrance":
      "A dark doorway leads into the tower. The guards would not "
      "welcome casual visitors.\n",
    "battlements":
      "Stone battlements crown the tower high above the quay.\n",
  ]);
}

string query_short() { return "Before a high tower"; }

string query_long() {
  return
    "The westerly side of the quay ends abruptly before a square, "
    "stone tower, crowned with battlements high above. Set into the "
    "thick eastern wall of the tower is an entrance leading into a "
    "gloomy interior. A second tower on the northern quay mirrors "
    "this one.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "tower" || str == "quay" || str == "here"; }
