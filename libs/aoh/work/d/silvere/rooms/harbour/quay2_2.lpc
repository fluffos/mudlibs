/*
 * Southern landing — west of quay2_1.
 *
 * Strategy A FluffOS room. Original (ferry port, nightday) is
 * quay2_2_ldmud.lpc. West continues to quay2_3 and the
 * southern tower exterior.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/quay2_1",
    "e": "/d/silvere/rooms/harbour/quay2_1",
    "west": "/d/silvere/rooms/harbour/quay2_3",
    "w": "/d/silvere/rooms/harbour/quay2_3",
  ]);
  extras = ([
    "people":
      "Those people are a mixture of adventurers, warriors, "
      "scientists who want to explore unknown territories, merchants, "
      "and some even look like pirates or other scum. Some are of races "
      "you only heard of in bards tales.\n",
    "bagage":
      "Bags, backpacks, wooden boxes, suit cases... guarded suspiciously "
      "by their owners.\n",
    "goods":
      "Bags, backpacks, wooden boxes, suit cases... guarded suspiciously "
      "by their owners.\n",
    "timetable":
      "A wooden timetable stands by the landing. The ferry is not calling "
      "today.\n",
    "table":
      "A wooden timetable stands by the landing. The ferry is not calling "
      "today.\n",
    "beacons":
      "The beacons are only lit at night.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return
    "This is just a common landing place for all sorts of ships. But "
    "somehow it is a very special place though. From here, many brave "
    "adventurers started their travel into unknown countries - some "
    "came back as heroes, but others never returned. There are many "
    "people around here, some are members of races you never saw before. "
    "Waiting for their embarkment, they are all suspiciously guarding "
    "their bagage and goods, glancing around attentively. A timetable "
    "stands here.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "landing" || str == "quay" || str == "here"; }
