/*
 * City Gate — harbour side. Inn south, harbourmaster north.
 *
 * Strategy A FluffOS room. Original (season ivy, day-gated office,
 * east into the city) is entrance_ldmud.lpc. East walks to the
 * city-side harbour gate; westroad1 is not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/harbour/street1",
    "w": "/d/silvere/rooms/harbour/street1",
    "south": "/d/silvere/rooms/harbour/harbour_inn",
    "s": "/d/silvere/rooms/harbour/harbour_inn",
    "north": "/d/silvere/rooms/harbour/harbourmaster",
    "n": "/d/silvere/rooms/harbour/harbourmaster",
    "east": "/d/silvere/rooms/west/harbourgate",
    "e": "/d/silvere/rooms/west/harbourgate",
  ]);
  extras = ([
    "ivy":
      "The ivy is hanging down from the citywall. It is full "
      "of red leaves and looks pretty interesting.\n",
    "walls":
      "The walls of Silvere are full of ivy, which grows down from the top.\n",
    "office":
      "The building to the north is the office of the harbourmaster.\n",
    "inn":
      "To the south is the Seaman's Rest.\n",
    "gates":
      "The gates of the city are opened wide.\n",
    "gate":
      "The gates of the city are opened wide.\n",
  ]);
}

string query_short() { return "City Gate"; }

string query_long() {
  return
    "It's summer at the moment and the walls of Silvere "
    "are full of ivy, which grows down from the top. It "
    "looks pretty nice. The road leads from the harbour into the city of "
    "Silvere. At the walls of the city are two buildings. The building to "
    "the north is the office of the harbourmaster and to the south is "
    "the Seaman's Rest. The gates of the city are opened wide.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north, south, west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "gate" || str == "gates" || str == "here"; }
