string query_short() { return "On the tower"; }

string query_long() {
  return
    "This is the top of the tower. You have a great view over the "
    "sea. A large catapult is standing here aiming toward the sea. "
    "South of you is an opening in the ground, where you can reach "
    "the lower levels of the tower. A small tent can be found to the "
    "east.";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
