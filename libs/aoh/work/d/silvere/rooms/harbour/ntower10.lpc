/*
 * Northern defense tower catapult rooftop —
 * north of ntower9.
 *
 * Strategy A FluffOS room. Original
 * (LoadCatapult / AimCatapult / PullHandle /
 * JumpDown / ShoveDown, south ntower9, east
 * ntower11) is ntower10_ldmud.lpc.
 * Look-ats only: catapult load/aim/fire,
 * pull handle, jump/shove are not loaded.
 * Frozen: available_stones=10,
 * catapult_loaded=0, catapult_aim=0 (points
 * toward the open sea; empty; a few stones
 * making a sizeable heap). Archive keeps
 * “leadto”, “A small wooden frame is build
 * on top”, “That's the place, you are
 * standing”, and the missing-braces
 * AddDetail fortress/beach/tree treated as
 * both keys. Later AddDetail("coast")
 * overwrites the earlier coast id; “coast
 * of silvere” keeps the first text. South
 * ntower9 is loaded; east ntower11 is not.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/harbour/ntower9",
    "s": "/d/silvere/rooms/harbour/ntower9",
