/*
 * Southern defense tower second-floor
 * waiting room — north of stower5.
 *
 * Strategy A FluffOS room. Original
 * (no AddDetail, south stower5, west
 * stower7) is stower6_ldmud.lpc.
 * Look-ats only: climb / leave are
 * not loaded. Archive keeps “Maybe
 * do a card game”. South stower5 and
 * west stower7 are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/harbour/stower5",
    "s": "/d/silvere/rooms/harbour/stower5",
    "west": "/d/silvere/rooms/harbour/stower7",
    "w": "/d/silvere/rooms/harbour/stower7",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the tower"; }

string query_long() {
  return
    "This is the waiting room for the crew of the tower. Maybe do a "
    "card game or something else... To the south are the stairs down "
    "and to the west is the platform and the stairs up.\n"
    "West:  To the stairs up and the platform\n"
    "South: To the stairs downwards";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
