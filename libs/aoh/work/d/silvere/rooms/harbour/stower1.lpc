string query_short() { return "in the tower"; }

string query_long() {
  return
    "This is a large room at the basement of the tower. At the moment "
    "you are standing at it's northeastern edge. A large machine is "
    "standing to the east and a stairway leads up to the south. An "
    "exit leads out of the tower to the east.";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
