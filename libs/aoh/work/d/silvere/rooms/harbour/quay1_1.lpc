/*
 * A street — east of STARTROOM /d/silvere/rooms/harbour/quay1_2.
 *
 * Strategy A FluffOS room. Original LDMud file (fisher NPC, nightday)
 * is saved as quay1_1_ldmud.lpc. North walks to the shipyard;
 * southeast walks to street3.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/harbour/quay1_2",
    "w": "/d/silvere/rooms/harbour/quay1_2",
    "southeast": "/d/silvere/rooms/harbour/street3",
    "se": "/d/silvere/rooms/harbour/street3",
    "north": "/d/silvere/rooms/harbour/shipyard",
    "n": "/d/silvere/rooms/harbour/shipyard",
  ]);
  extras = ([
    "traps":
      "Open-sided wooden frames, covered in a rope net. One end is open, "
      "large enough for the poor unsuspecting lobsters to crawl in, but "
      "not large enough for them to get back out.\n",
    "lobster traps":
      "Open-sided wooden frames, covered in a rope net. One end is open, "
      "large enough for the poor unsuspecting lobsters to crawl in, but "
      "not large enough for them to get back out.\n",
    "boats":
      "Colorful painted fisherboats of all kinds and sizes bob up and down "
      "in their moorings.\n",
    "boat":
      "Colorful painted fisherboats of all kinds and sizes bob up and down "
      "in their moorings.\n",
    "ramps":
      "Newly built ships may be moved from the shipyard into the sea by "
      "these ramps.\n",
    "shipyard":
      "The royal shipyard lies to the north.\n",
    "yard":
      "The royal shipyard lies to the north.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return
    "Piled lobster traps lie in heaps along the quay. The smell of "
    "fish and salt hangs heavy in the air. Murky waves splash "
    "lightly against the docks, and the boats creak at their moorings. "
    "Silvere's shipyard lies to the north, boat ramps are leading out of "
    "it and dip gently down into the water.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west, southeast and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "street" || str == "quay" || str == "here"; }
