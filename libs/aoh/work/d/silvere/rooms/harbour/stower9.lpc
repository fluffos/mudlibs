/*
 * Southern defense tower rooftop
 * stairs — up from stower7.
 *
 * Strategy A FluffOS room. Original
 * (no AddDetail, down stower7, south
 * stower10, east stower12) is
 * stower9_ldmud.lpc. Look-ats only:
 * climb / catapult / leave are not
 * loaded. Down stower7, south
 * stower10, and east stower12 are
 * loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "down": "/d/silvere/rooms/harbour/stower7",
    "south": "/d/silvere/rooms/harbour/stower10",
    "s": "/d/silvere/rooms/harbour/stower10",
    "east": "/d/silvere/rooms/harbour/stower12",
    "e": "/d/silvere/rooms/harbour/stower12",
  ]);
  extras = ([ ]);
}

string query_short() { return "On the tower"; }

string query_long() {
  return
    "Stairs are leading down here. A platform is here, where stones are "
    "moved from below to load the catapults. To the east is a large "
    "mirror, to the south is the catapult.\n"
    "Down:  To the second level of the tower.\n"
    "East:  To a mirror...\n"
    "South: To the catapult";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are down, south and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
