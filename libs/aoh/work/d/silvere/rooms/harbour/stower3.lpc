string query_short() { return "Tower basement, southern corner"; }

string query_long() {
  return
    "You are standing at the southern end of the room. A big "
    "stairway leads up to the higher levels of the tower. Next "
    "to it is a small, glowing globe. At the wall to the west "
    "is a huge, wooden wheel with a machine north of it. Directly "
    "to the north is an exit leading out on the harbour.";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
