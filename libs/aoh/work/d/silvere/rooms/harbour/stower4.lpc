string query_short() { return "Tower basement, western corner"; }

string query_long() {
  return
    "A large wooden wheel dominates the corner of the room. A long "
    "chain runs down from it into a machine to the north. To the east "
    "is a stairway leading up to the upper levels of the tower.";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
