/*
 * Street at the sun clock, just west of the city gate.
 *
 * Strategy A FluffOS room. Original (sunclock item, SeasonMsg) is
 * street1_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/harbour/street2",
    "w": "/d/silvere/rooms/harbour/street2",
    "east": "/d/silvere/rooms/harbour/entrance",
    "e": "/d/silvere/rooms/harbour/entrance",
  ]);
  extras = ([
    "clock":
      "A large stone sun clock sits upon a pedestal in the middle of "
      "the road.\n",
    "sun clock":
      "A large stone sun clock sits upon a pedestal in the middle of "
      "the road.\n",
    "pedestal":
      "The sun clock rests on a weathered stone pedestal.\n",
    "window":
      "This is a large window in the house of the harbourmaster. "
      "It has a wooden frame and high glass panels.\n",
    "gates":
      "Directly to the east are the city gates of Silvere.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return
    "The road parts here around a large stone sun clock set upon "
    "a pedestal. The stifling heat of summer is quite bearable here above "
    "the harbour, since a light breeze blows up from the basin. Directly "
    "to the east are the city gates of Silvere. To the northeast is the "
    "house of the harbourmaster, where you can see a window.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "street" || str == "road" || str == "here"; }
