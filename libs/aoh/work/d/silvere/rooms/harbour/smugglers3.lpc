/*
 * Smugglers den stub — down from smugglers2.
 *
 * Strategy A FluffOS room. Original (leave_cave,
 * QueryIsOpen) is smugglers3_ldmud.lpc. Archive
 * stub: no AddDetail. leave / pull / enter are
 * not loaded. Out / up return to smugglers2.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "out": "/d/silvere/rooms/harbour/smugglers2",
    "up": "/d/silvere/rooms/harbour/smugglers2",
    "u": "/d/silvere/rooms/harbour/smugglers2",
  ]);
  extras = ([ ]);
}

string query_short() { return "The smugglers den"; }

string query_long() {
  return
    "This is the inside of the dune, the smugglers hideout.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are out and up.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "den" || str == "hideout" || str == "here";
}
