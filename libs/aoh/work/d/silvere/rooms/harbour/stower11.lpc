/*
 * Southern defense tower rooftop
 * shelter — east of stower10.
 *
 * Strategy A FluffOS room. Original
 * (no AddDetail, north stower12, west
 * stower10) is stower11_ldmud.lpc.
 * Look-ats only: sit / leave are not
 * loaded. Archive keeps “staying here,
 * exchanging each other”. North
 * stower12 and west stower10 are
 * loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/harbour/stower12",
    "n": "/d/silvere/rooms/harbour/stower12",
    "west": "/d/silvere/rooms/harbour/stower10",
    "w": "/d/silvere/rooms/harbour/stower10",
  ]);
  extras = ([ ]);
}

string query_short() { return "On the tower"; }

string query_long() {
  return
    "This is a shelter on top of the tower. It is used by the watch "
    "crew. Two men are standing guard, two men are staying here, exchanging "
    "each other from time to time. To the north is a mirror, to the west "
    "is the catapult.\n"
    "West:  To the catapult\n"
    "North: To a mirror.";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
