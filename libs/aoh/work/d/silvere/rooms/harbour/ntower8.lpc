    "western wall":
      "The western wall is absolutely bare from anything except the "
      "stones, it is made from.\n",
  ]);
}

string query_short() { return "A storeroom"; }

string query_long() {
  return
    "This is a large storeroom. Boulders are piled in this room on "
    "the floor. A glowing globe hangs at the southern wall next to "
    "the exit.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The only obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
