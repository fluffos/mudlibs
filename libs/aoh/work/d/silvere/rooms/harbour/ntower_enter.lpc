/*
 * Before the northern defense tower — west of quay1_3.
 *
 * Strategy A FluffOS room. Original (chain machinery, guards,
 * west into the tower) is ntower_enter_ldmud.lpc. The tower
 * interior is not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/quay1_3",
    "e": "/d/silvere/rooms/harbour/quay1_3",
  ]);
  extras = ([
    "tower":
      "The tower walls rise, sleek and stony, straight into the sky. "
      "On the southern wall is an opening in the tower wall, "
      "framed in timber, through which the harbour chain can be reeled "
      "in for protection or dropped to let ships pass into the bay. "
      "High above are the battlements, where a fine white banner "
      "flutters in the sea breeze, proudly displaying the sigil of "
      "the Royal House of Silvere.\n",
    "towers":
      "Which tower do you mean? Directly before you stands the "
      "northern tower. The southern tower stands on the far end of "
      "the southern quay.\n",
    "chain":
      "A large and heavy chain hangs down from the northern "
      "tower and vanishes into the water nearly at the wall of "
      "that building. The other end hangs from the southern tower.\n",
    "wall":
      "The wall of the tower rises high into the sky before your "
      "eyes. On top of it you can faintly make out battlements.\n",
    "entrance":
      "A dark doorway leads into the tower. The guards would not "
      "welcome casual visitors.\n",
    "opening":
      "A square opening in the southern side of the guard tower is "
      "just visible from the quay. A heavy chain passes through the "
      "opening and disappears beneath the surface of the water.\n",
    "battlements":
      "Stone battlements crown the tower high above the quay.\n",
  ]);
}

string query_short() { return "Before a high tower"; }

string query_long() {
  return
    "The easterly side of the quay ends abruptly before a square, stone "
    "tower, crowned with battlements high above. Set into the thick "
    "eastern wall of the tower is an entrance leading into a gloomy "
    "interior. A second tower on the southern quay mirrors this one.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "tower" || str == "quay" || str == "here"; }
