/*
 * Southern defense tower second-floor
 * platform — west of stower6 / north
 * of stower8.
 *
 * Strategy A FluffOS room. Original
 * (no AddDetail, up stower9, south
 * stower8, east stower6) is
 * stower7_ldmud.lpc. Look-ats only:
 * climb / raise/lower platform are
 * not loaded. East stower6 and south
 * stower8 are loaded; up stower9 is
 * not.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/stower6",
    "e": "/d/silvere/rooms/harbour/stower6",
    "south": "/d/silvere/rooms/harbour/stower8",
    "s": "/d/silvere/rooms/harbour/stower8",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the tower"; }

string query_long() {
  return
    "Stairs are leading up to the top of the tower. A platform is here, which "
    "is used to transport the boulders up to the catapults. To the south is "
    "the storeroom, to the east is a waiting room.\n"
    "Up:    To the top of the tower\n"
    "East:  To the crew waiting room\n"
    "South: To the storeroom";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
