/*
 * Southern quay street — southwest of street3.
 *
 * Strategy A FluffOS room. Original (night sailor NPC, knock barrel)
 * is quay2_1_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "northeast": "/d/silvere/rooms/harbour/street3",
    "ne": "/d/silvere/rooms/harbour/street3",
    "west": "/d/silvere/rooms/harbour/quay2_2",
    "w": "/d/silvere/rooms/harbour/quay2_2",
  ]);
  extras = ([
    "barrels":
      "You don't know what they contain... wine? beer? or just "
      "nothing? They sound empty if you knock.\n",
    "barrel":
      "You don't know what they contain... wine? beer? or just "
      "nothing? They sound empty if you knock.\n",
    "boxes":
      "Whatever is in there, it is packed for a long voyage.\n",
    "crates":
      "Barrels, boxes, all kinds of containers are "
      "waiting for their journeys all over the world.\n",
    "bottles":
      "Smashed bottles on the ground make walking without boots "
      "really unpleasant.\n",
    "longshoremen":
      "The longshoremen help to load and unload cargo of the ships here. "
      "Their skin is bronzened from the work in the sunshine, and they are "
      "all heavily built and packed with muscles.\n",
    "cargo":
      "All kinds of goods are to be seen... boxes full with "
      "foreign herbs, spice, strange fruits you've never seen before "
      "and there are even heavy boxes full of gold bars - but of "
      "course, those are guarded by well-armed cityguards.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return
    "Loads of barrels, boxes and other crates are stored up here along "
    "the quay. Smashed bottles on the ground make walking without boots "
    "really unpleasant. You guess that this is the favourite hang-out "
    "place for drunken sailors at night. Longshoremen and fishermen are "
    "occupied with their daily jobs, ships are being loaded and unloaded "
    "with cargo. Happy whistling and singing is everywhere, the people "
    "seem to enjoy their work.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are northeast and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "street" || str == "quay" || str == "here"; }
