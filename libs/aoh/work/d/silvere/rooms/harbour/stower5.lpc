/*
 * Southern defense tower second-floor
 * landing — up from stower3.
 *
 * Strategy A FluffOS room. Original
 * (no AddDetail, west stower8, north
 * stower6, down stower3) is
 * stower5_ldmud.lpc. Look-ats only:
 * climb / leave and upper-floor rooms
 * are not loaded. Archive P_INT_LONG
 * keeps the wiz-exit lines in the
 * room text. Down stower3 is loaded;
 * west stower8 and north stower6 are
 * not.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "down": "/d/silvere/rooms/harbour/stower3",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the tower"; }

string query_long() {
  return
    "This is a room in the tower, where a stair leads down to the basement. "
    "To the west is a storeroom with stones for the catapults. To the north "
    "is a waiting room for the crew.\n"
    "Down:  Stairs to the basement.\n"
    "West:  To the storeroom with ammo for the catapults\n"
    "North: To a waiting room for the crew.";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are down.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
