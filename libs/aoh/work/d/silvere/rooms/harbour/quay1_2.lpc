/*
 * The docks — default login (sys/stdrooms.h STARTROOM).
 *
 * Strategy A FluffOS room. Original LDMud harbour room (inherit
 * HARBOUR_BASEROOM + /obj/lib/port, nightday TimeMsg, ferry) is
 * saved as quay1_2_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/harbour/quay1_3",
    "w": "/d/silvere/rooms/harbour/quay1_3",
    "east": "/d/silvere/rooms/harbour/quay1_1",
    "e": "/d/silvere/rooms/harbour/quay1_1",
  ]);
  extras = ([
    "nets":
      "Tattered and torn, it is evident that these nets have been discarded.\n",
    "fish nets":
      "Tattered and torn, it is evident that these nets have been discarded.\n",
    "gulls":
      "These scavenging white birds can be seen all around the harbour during the day.\n",
    "seagulls":
      "These scavenging white birds can be seen all around the harbour during the day.\n",
    "pails":
      "Rusty tin pails line the land side of the quay.\n",
    "timetable":
      "A wooden timetable stands by the dock. The ferry is not calling "
      "today.\n",
    "table":
      "A wooden timetable stands by the dock. The ferry is not calling "
      "today.\n",
    "docks":
      "This is the northern docking area of Silvere's harbour.\n",
    "water":
      "The water near the docks appears slightly greyish-green.\n",
  ]);
}

string query_short() { return "The docks"; }

string query_long() {
  return
    "Fish nets are piled up alongside pails of old fish. Gulls caw and "
    "call to each other as they wheel through the sky, looking for "
    "handouts or easy prey. This is the northern docking area of the "
    "harbour. A timetable stands here.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "docks" || str == "quay" || str == "here"; }
