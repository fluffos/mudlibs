string query_short() { return "Tower basement, northern corner"; }

string query_long() {
  return
    "This is the western end of the room. Right at the wall to the "
    "west is a large machine, which is connected with a large, iron "
    "chain to a huge, wooden wheel to the south. The iron chain runs "
    "through the machine into a small opening in the northern wall, "
    "where it vanishes. To the east is the exit from the tower and "
    "southeast is a large stairway leading up.";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
