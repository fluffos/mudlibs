/*
 * Path toward the southern defense tower — west of quay2_2.
 *
 * Strategy A FluffOS room. Original (squeeze-through dunes) is
 * quay2_3_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/quay2_2",
    "e": "/d/silvere/rooms/harbour/quay2_2",
    "west": "/d/silvere/rooms/harbour/stower_enter",
    "w": "/d/silvere/rooms/harbour/stower_enter",
  ]);
  extras = ([
    "bushes":
      "Evergreen, thick-leaved thorny bushes, standing so close together "
      "that no one can pass them. Or perhaps... oh, your eyes - sharp like "
      "a knife - detect a small gap in the hedge.\n",
    "gap":
      "Footprints force their way though the gap in the bush-row. Might "
      "there be a pirates treasure hidden somewhere in the dunes?\n",
    "trees":
      "Yes! You are sure this must be the mysterious froja trees. It is said "
      "they have fruits of great healing power, but these fruits only grow "
      "during full-moon nights. Strange indeed.\n",
    "froja":
      "Yes! You are sure this must be the mysterious froja trees. It is said "
      "they have fruits of great healing power, but these fruits only grow "
      "during full-moon nights. Strange indeed.\n",
    "path":
      "It's a small path. Here and there, some old cobblestones can be "
      "seen beneath a cover of sand.\n",
    "dunes":
      "Just behind the bushes, beige sand dunes start waving smoothly up "
      "and down, joining the foothills someway to the southeast.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return
    "The road leading in from the east is turning to a smaller path here. "
    "It meanders westwards along the quay towards the southern defense "
    "tower. Rows of bushes and small froja trees line the southern border "
    "of the path. Just behind the bushes, beige sand dunes start waving "
    "smoothly up and down, joining the foothills someway to the southeast. "
    "The protection of the bay already lessens here a bit, a strong "
    "breeze blows directly into your face.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "path" || str == "street" || str == "here"; }
