/*
 * Northern defense tower basement, northwest —
 * north of ntower2 / west of ntower3.
 *
 * Strategy A FluffOS room. Original (CheckWheelDesc
 * QueryChain on SIL_NORTH_MACHINEROOM, CheckOpening
 * nightday) is ntower4_ldmud.lpc. Archive keeps
 * “Thereis” and the same short as ntower3. Look-ats
 * only: handle / chain verbs / upper levels are
 * not loaded. Wheel frozen empty (chain lowered).
 * East ntower3 and south ntower2 are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/ntower3",
    "e": "/d/silvere/rooms/harbour/ntower3",
    "south": "/d/silvere/rooms/harbour/ntower2",
    "s": "/d/silvere/rooms/harbour/ntower2",
  ]);
  extras = ([
    "box":
      "The box is directly connected to the globe. A small "
