/*
 * Dune hollow — south of quay2_3 through the hedge gap.
 *
 * Strategy A FluffOS room. Original (squeeze through
 * bushes, follow footprints) is smugglers1_ldmud.lpc.
 * Look at dunes / bushes / gap / footprints is flavour.
 * squeeze / follow are not loaded. Southeast
 * smugglers2 look-ats are loaded this slice. North
 * back to quay2_3 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/harbour/quay2_3",
    "n": "/d/silvere/rooms/harbour/quay2_3",
    "southeast": "/d/silvere/rooms/harbour/smugglers2",
    "se": "/d/silvere/rooms/harbour/smugglers2",
  ]);
  extras = ([
    "dunes":
      "Large sandhills with steep walls, making your horizon very "
      "limited. The only possibility to get out of the hollow here "
      "is to follow the way the footprints lead.\n",
    "sandhills":
      "Large sandhills with steep walls, making your horizon very "
      "limited. The only possibility to get out of the hollow here "
      "is to follow the way the footprints lead.\n",
    "hills":
      "Large sandhills with steep walls, making your horizon very "
      "limited. The only possibility to get out of the hollow here "
      "is to follow the way the footprints lead.\n",
    "dune":
      "Large sandhills with steep walls, making your horizon very "
      "limited. The only possibility to get out of the hollow here "
      "is to follow the way the footprints lead.\n",
    "hill":
      "Large sandhills with steep walls, making your horizon very "
      "limited. The only possibility to get out of the hollow here "
      "is to follow the way the footprints lead.\n",
    "sandhill":
      "Large sandhills with steep walls, making your horizon very "
      "limited. The only possibility to get out of the hollow here "
      "is to follow the way the footprints lead.\n",
    "bush":
      "Evergreen, thick-leaved thorny bushes, standing so close together "
      "that no one can pass them. But you wonder why the chain of "
      "footprints runs directly into the hedge though... is there a gap "
      "in the bushes perhaps?\n",
    "bushes":
      "Evergreen, thick-leaved thorny bushes, standing so close together "
      "that no one can pass them. But you wonder why the chain of "
      "footprints runs directly into the hedge though... is there a gap "
      "in the bushes perhaps?\n",
    "row":
      "Evergreen, thick-leaved thorny bushes, standing so close together "
      "that no one can pass them. But you wonder why the chain of "
      "footprints runs directly into the hedge though... is there a gap "
      "in the bushes perhaps?\n",
    "rows":
      "Evergreen, thick-leaved thorny bushes, standing so close together "
      "that no one can pass them. But you wonder why the chain of "
      "footprints runs directly into the hedge though... is there a gap "
      "in the bushes perhaps?\n",
    "hedge":
      "Evergreen, thick-leaved thorny bushes, standing so close together "
      "that no one can pass them. But you wonder why the chain of "
      "footprints runs directly into the hedge though... is there a gap "
      "in the bushes perhaps?\n",
    "gap":
      "You guess that this gap is a \"backdoor\"to the harbour of Silvere. "
      "Sqeezing yourself through it will surely be no pleasure.\n",
    "footprints":
      "Those footprints that lead in from the southeast head directly "
      "towards the row of bushes to the north. You could follow them "
      "into the dunes if you are not afraid to get lost there...\n",
    "prints":
      "Those footprints that lead in from the southeast head directly "
      "towards the row of bushes to the north. You could follow them "
      "into the dunes if you are not afraid to get lost there...\n",
    "print":
      "Those footprints that lead in from the southeast head directly "
      "towards the row of bushes to the north. You could follow them "
      "into the dunes if you are not afraid to get lost there...\n",
    "footprint":
      "Those footprints that lead in from the southeast head directly "
      "towards the row of bushes to the north. You could follow them "
      "into the dunes if you are not afraid to get lost there...\n",
  ]);
}

string query_short() { return "In the dunes"; }

string query_long() {
  return
    "You are in a little hollow between large sandhills. Without the "
    "hedge to your north and the roar of the surf to the west as "
    "means of orientation, you'd surely get lost. Every hill just "
    "looks very alike. On a second glance, you notice that nature is "
    "not untouched here - several fresh footprints meander like a "
    "chain of pearls through the sand.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and southeast.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hollow" || str == "dunes" || str == "here";
}
