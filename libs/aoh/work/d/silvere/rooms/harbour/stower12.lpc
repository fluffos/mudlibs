/*
 * Southern defense tower rooftop
 * mirror — east of stower9.
 *
 * Strategy A FluffOS room. Original
 * (no AddDetail, south stower11, west
 * stower9) is stower12_ldmud.lpc.
 * Look-ats only: move mirror / fire
 * are not loaded. Archive keeps
 * “between the tower” and “moved to
 * the east and north”. South stower11
 * and west stower9 are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/harbour/stower11",
    "s": "/d/silvere/rooms/harbour/stower11",
    "west": "/d/silvere/rooms/harbour/stower9",
    "w": "/d/silvere/rooms/harbour/stower9",
  ]);
  extras = ([ ]);
}

string query_short() { return "On the tower"; }

string query_long() {
  return
    "Before a mirror. The mirror is used to exchange messages between the "
    "tower by light signals. It can be moved to the east and north. Before "
    "the mirror is also a place for a big fire, when the sun is not shining. "
    "To the south is the shelter, to the west is the platform and the stairs.\n"
    "West:  To the platform and the stairs down\n"
    "South: To the shelter.";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
