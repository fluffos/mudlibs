/*
 * Harbour crossing — southeast of quay1_1.
 *
 * Strategy A FluffOS room. Original LDMud file (nightday TimeMsg,
 * xalstatue) is saved as street3_ldmud.lpc. Southwest walks to
 * quay #2.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "northwest": "/d/silvere/rooms/harbour/quay1_1",
    "nw": "/d/silvere/rooms/harbour/quay1_1",
    "east": "/d/silvere/rooms/harbour/street2",
    "e": "/d/silvere/rooms/harbour/street2",
    "southwest": "/d/silvere/rooms/harbour/quay2_1",
    "sw": "/d/silvere/rooms/harbour/quay2_1",
  ]);
  extras = ([
    "road":
      "A small paved street, covered with sand from the surrounding dunes.\n",
    "street":
      "A small paved street, covered with sand from the surrounding dunes.\n",
    "spots":
      "These little white spots are the sails of ships out there in "
      "the ocean.\n",
    "sails":
      "These little white spots are the sails of ships out there in "
      "the ocean.\n",
    "towers":
      "Two strong towers guard the entrance to the harbour.\n",
    "bay":
      "The small bay west of Silvere protects the city's harbour from "
      "storm and rough tides.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return
    "You are at the shore of a small bay west of Silvere. It protects "
    "the city's harbour from storm and rough tides. The small sandy road that "
    "meanders down from the city splits here. The view over the bay is "
    "fantastic. Ships come and go, entering the harbour or sailing away "
    "into the blue infinity of the ocean. You catch your breath at the "
    "sight of their white sails slowly dwindling away until they are "
    "nothing more than small spots on the horizon. Two strong towers "
    "guard the entrance to the harbour.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are northwest, east and southwest.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "street" || str == "crossing" || str == "here"; }
