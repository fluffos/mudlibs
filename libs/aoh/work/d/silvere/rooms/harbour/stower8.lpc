/*
 * Southern defense tower second-floor
 * ammo store — west of stower5.
 *
 * Strategy A FluffOS room. Original
 * (no AddDetail, north stower7, east
 * stower5) is stower8_ldmud.lpc.
 * Look-ats only: climb / take stones
 * are not loaded. Archive keeps “way
 * to heavy to taken”, “toward a
 * platform”, “To the stair, which
 * are leading”. East stower5 and
 * north stower7 are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/harbour/stower5",
    "e": "/d/silvere/rooms/harbour/stower5",
    "north": "/d/silvere/rooms/harbour/stower7",
    "n": "/d/silvere/rooms/harbour/stower7",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the tower"; }

string query_long() {
  return
    "This is a storeroom. Large piles of boulders can be found here. (Of course "
    "they are way to heavy to taken by a single person). An exit leads north "
    "toward a platform, where the stones are moved upwards to be loaded into "
    "the catapults.\n"
    "East:  To the stair, which are leading down.\n"
    "North: To a platform, leading up";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "tower" || str == "here";
}
