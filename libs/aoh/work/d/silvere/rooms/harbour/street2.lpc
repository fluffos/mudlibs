/*
 * Paved road from the harbour crossing toward the city gates.
 *
 * Strategy A FluffOS room. Original is street2_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/harbour/street3",
    "w": "/d/silvere/rooms/harbour/street3",
    "east": "/d/silvere/rooms/harbour/street1",
    "e": "/d/silvere/rooms/harbour/street1",
  ]);
  extras = ([
    "road":
      "A small paved street, covered with sand from the surrounding "
      "dunes.\n",
    "street":
      "A small paved street, covered with sand from the surrounding "
      "dunes.\n",
    "gates":
      "Up the hill to the east are the city gates.\n",
    "harbour":
      "The ocean of Shamyra opens to the west. Busy shipping is going "
      "on all over the harbour basin.\n",
  ]);
}

string query_short() { return "A street"; }

string query_long() {
  return
    "This is a small paved road that meanders gently down to the "
    "harbour of Silvere. Up the hill to the east are the city gates, the "
    "shining armour of the patrolling guards up there glitters brightly. "
    "The ocean of Shamyra opens to the west and you've got a great view "
    "upon the little bay down there. Busy shipping is going on all over "
    "the harbour basin.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "street" || str == "road" || str == "here"; }
