/*
 * Citypark entrance — south of already-live cityenter.
 *
 * Strategy A FluffOS room. Original (leave park / enter
 * city / search ground, east forest_enter) is
 * parkenter_ldmud.lpc. Look-ats only; leave / enter /
 * search are not wired this slice. No read command —
 * the sign inscription is exposed as a look-at.
 * Archive keeps “it's wooden surface”. East
 * forest_enter is loaded; snake pit is not.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/cityenter",
    "n": "/d/silvere/rooms/west/cityenter",
    "east": "/d/silvere/rooms/newbiepark/forest_enter",
    "e": "/d/silvere/rooms/newbiepark/forest_enter",
  ]);
  extras = ([
    "sign":
      "This sign looks important. There are lots of words written "
      "on it's wooden surface.\n"
      "This area is the citypark of the town of Silvere. If you "
      "walk further to the east you will find some creatures, "
      "that shouldn't be too dangerous for a low level player. "
      "That is if you set your wimpy mode to a somewhat decent "
      "level (for example wimpy 20).\nIf you encounter a creature "
      "inside that area it is always good to have a look at it. "
      "Then, if you still think that you are strong enough to attack "
      "it, try to kill it (e.g. kill rabbit).\nIf you lack of killing "
      "equipment, search the ground here and you may find something "
      "more or less useful (if you are still a new player here).\n",
    "important sign":
      "This sign looks important. There are lots of words written "
      "on it's wooden surface.\n"
      "This area is the citypark of the town of Silvere. If you "
      "walk further to the east you will find some creatures, "
      "that shouldn't be too dangerous for a low level player. "
      "That is if you set your wimpy mode to a somewhat decent "
      "level (for example wimpy 20).\nIf you encounter a creature "
      "inside that area it is always good to have a look at it. "
      "Then, if you still think that you are strong enough to attack "
      "it, try to kill it (e.g. kill rabbit).\nIf you lack of killing "
      "equipment, search the ground here and you may find something "
      "more or less useful (if you are still a new player here).\n",
    "words":
      "The text, which is written on the sign seems to be important. "
      "Maybe you should read it?\n"
      "This area is the citypark of the town of Silvere. If you "
      "walk further to the east you will find some creatures, "
      "that shouldn't be too dangerous for a low level player. "
      "That is if you set your wimpy mode to a somewhat decent "
      "level (for example wimpy 20).\nIf you encounter a creature "
      "inside that area it is always good to have a look at it. "
      "Then, if you still think that you are strong enough to attack "
      "it, try to kill it (e.g. kill rabbit).\nIf you lack of killing "
      "equipment, search the ground here and you may find something "
      "more or less useful (if you are still a new player here).\n",
    "word":
      "The text, which is written on the sign seems to be important. "
      "Maybe you should read it?\n"
      "This area is the citypark of the town of Silvere. If you "
      "walk further to the east you will find some creatures, "
      "that shouldn't be too dangerous for a low level player. "
      "That is if you set your wimpy mode to a somewhat decent "
      "level (for example wimpy 20).\nIf you encounter a creature "
      "inside that area it is always good to have a look at it. "
      "Then, if you still think that you are strong enough to attack "
      "it, try to kill it (e.g. kill rabbit).\nIf you lack of killing "
      "equipment, search the ground here and you may find something "
      "more or less useful (if you are still a new player here).\n",
    "text":
      "The text, which is written on the sign seems to be important. "
      "Maybe you should read it?\n"
      "This area is the citypark of the town of Silvere. If you "
      "walk further to the east you will find some creatures, "
      "that shouldn't be too dangerous for a low level player. "
      "That is if you set your wimpy mode to a somewhat decent "
      "level (for example wimpy 20).\nIf you encounter a creature "
      "inside that area it is always good to have a look at it. "
      "Then, if you still think that you are strong enough to attack "
      "it, try to kill it (e.g. kill rabbit).\nIf you lack of killing "
      "equipment, search the ground here and you may find something "
      "more or less useful (if you are still a new player here).\n",
  ]);
}

string query_short() { return "Citypark entrance"; }

string query_long() {
  return
    "You are standing at the border of a nice little forestal area "
    "inside the city wall. Some harmless animals are supposed to "
    "run around here for recreational purposes and nice roads can "
    "be found between the trees. There is also an important looking "
    "sign here.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "park" || str == "entrance" || str == "here";
}
