/*
 * Before a small forest — east of SIL_PARK parkenter.
 *
 * Strategy A FluffOS room. Original (enter forest/park
 * → forest_room1) is forest_enter_ldmud.lpc. Archive
 * stub: no AddDetail. enter forest / east forest_room1
 * and snake pit are not wired this slice. West
 * parkenter is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/newbiepark/parkenter",
    "w": "/d/silvere/rooms/newbiepark/parkenter",
  ]);
  extras = ([ ]);
}

string query_short() { return "Before a small forest"; }

string query_long() {
  return
    "This is the border of a small forest. A path leads here "
    "from the east and west along a small wall. The path vanishes "
    "between the trees to the east.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "forest" || str == "path" || str == "here";
}
