/*
 * Border of the forest — west of SIL_PARK southentrance.
 *
 * Strategy A FluffOS room. Original (north forest_south9,
 * west snake_pit1) is forest_south10_ldmud.lpc. Archive
 * stub: no AddDetail. North encounters and the snake
 * pit are not wired this slice. East southentrance is
 * loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/newbiepark/southentrance",
    "e": "/d/silvere/rooms/newbiepark/southentrance",
  ]);
  extras = ([ ]);
}

string query_short() { return "Border of the forest"; }

string query_long() {
  return
    "The path leads in from the gates to the east deeper into the "
    "forest to the north. To the west are some bushes with a hole, "
    "where you could fit through.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "path" || str == "forest" || str == "here";
}
