/*
 * On a road at Silvere — east of eastroad2.
 *
 * Strategy A FluffOS room. Original (south
 * mistralhouse/garden1; unfinished east gate) is
 * mainroad1_ldmud.lpc. Archive stub: no AddDetail.
 * South Joan and Mistral's house is not loaded
 * this slice. Archive keeps “seems to be”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/center/eastroad2",
    "w": "/d/silvere/rooms/center/eastroad2",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a broad road, leading from the palace to the west toward the "
    "gates of the city to the east. The buildings to the left and right "
    "seems to be somewhat foggy, as if they are not really here. "
    "To the south is the house of Joan and Mistral.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
