/*
 * Joan and Mistral's west garden — south of garden2.
 *
 * Strategy A FluffOS room. Original (meadow inherit,
 * south garden4) is garden3_ldmud.lpc. Search herbs /
 * garden4 / house interiors are not loaded. North
 * garden2 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/east/mistralhouse/garden2",
    "n": "/d/silvere/rooms/east/mistralhouse/garden2",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the garden of Joan and Mistral"; }

string query_long() {
  return
    "You are standing in the garden of Joan and Mistral. "
    "To the east Joan and Mistral are building a house. "
    "To the south and north you can go deeper into the garden. "
    "But maybe you can search for herbs in this garden?\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
