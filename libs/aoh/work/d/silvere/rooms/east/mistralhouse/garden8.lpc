/*
 * Joan and Mistral's east garden — east of garden1.
 *
 * Strategy A FluffOS room. Original (meadow inherit,
 * south garden7) is garden8_ldmud.lpc. Search herbs /
 * garden6 / house interiors are not loaded. West
 * garden1 and south garden7 are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/east/mistralhouse/garden1",
    "w": "/d/silvere/rooms/east/mistralhouse/garden1",
    "south": "/d/silvere/rooms/east/mistralhouse/garden7",
    "s": "/d/silvere/rooms/east/mistralhouse/garden7",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the garden of Joan and Mistral"; }

string query_long() {
  return
    "You are standing in the garden of Joan and Mistral. "
    "To the south and west you can go deeper into the garden. "
    "But maybe you can search for herbs in this garden?\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
