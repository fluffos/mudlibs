/*
 * Joan and Mistral's west garden — west of garden1.
 *
 * Strategy A FluffOS room. Original (meadow inherit,
 * AddItem tree, south garden3) is garden2_ldmud.lpc.
 * Archive keeps “though the trees” and the short
 * trailing period. Tree clone / search herbs /
 * garden3 are not loaded. East garden1 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/east/mistralhouse/garden1",
    "e": "/d/silvere/rooms/east/mistralhouse/garden1",
  ]);
  extras = ([
    "wind":
      "You hear the wind whistling softly though the trees.\n",
    "whistling":
      "You hear the wind whistling softly though the trees.\n",
    "trees":
      "You hear the wind whistling softly though the trees.\n",
    "tree":
      "You hear the wind whistling softly though the trees.\n",
    "flowers":
      "The garden smells fresh with flowers!\n",
  ]);
}

string query_short() { return "in Joan and Mistral's garden."; }

string query_long() {
  return
    "You are in Joan and Mistral's garden. "
    "To the south and east you can go deeper into the garden. "
    "The wind whispers softly. The smell of fresh flowers drifts around you.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
