/*
 * Joan and Mistral's garden — south of east/mainroad1.
 *
 * Strategy A FluffOS room. Original (meadow inherit,
 * search herbs, south house 011, call_other 001) is
 * garden1_ldmud.lpc. Look-ats only: search / house
 * interiors are not loaded. West garden2 and east
 * garden8 stubs are loaded this slice. North
 * mainroad1 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/east/mainroad1",
    "n": "/d/silvere/rooms/east/mainroad1",
    "west": "/d/silvere/rooms/east/mistralhouse/garden2",
    "w": "/d/silvere/rooms/east/mistralhouse/garden2",
    "east": "/d/silvere/rooms/east/mistralhouse/garden8",
    "e": "/d/silvere/rooms/east/mistralhouse/garden8",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the garden of Joan and Mistral"; }

string query_long() {
  return
    "You are standing in the garden of Joan and Mistral.\n"
    "You can leave it to the north.\n"
    "To the south Joan and Mistral are building a house.\n"
    "To the west and east you can go deeper into the garden.\n"
    "But maybe you can search for herbs in this garden?\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north, west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
