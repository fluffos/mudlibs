/*
 * Joan and Mistral's east garden — south of garden8.
 *
 * Strategy A FluffOS room. Original (meadow inherit,
 * south garden6) is garden7_ldmud.lpc. Search herbs /
 * house interiors are not loaded. North garden8 and
 * south garden6 are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/east/mistralhouse/garden8",
    "n": "/d/silvere/rooms/east/mistralhouse/garden8",
    "south": "/d/silvere/rooms/east/mistralhouse/garden6",
    "s": "/d/silvere/rooms/east/mistralhouse/garden6",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the garden of Joan and Mistral"; }

string query_long() {
  return
    "You are standing in the garden of Joan and Mistral. "
    "To the west Joan and Mistral are building a house. "
    "To the south and north you can go deeper into the garden. "
    "But maybe you can search for herbs in this garden?\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
