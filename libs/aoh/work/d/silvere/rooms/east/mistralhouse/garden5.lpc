/*
 * Joan and Mistral's south garden — between garden4
 * and garden6.
 *
 * Strategy A FluffOS room. Original (meadow inherit,
 * rootcellar to /players/joan/xfiles) is
 * garden5_ldmud.lpc. Search herbs / house interiors /
 * rootcellar / rcellar are not loaded. West garden4
 * and east garden6 are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/east/mistralhouse/garden4",
    "w": "/d/silvere/rooms/east/mistralhouse/garden4",
    "east": "/d/silvere/rooms/east/mistralhouse/garden6",
    "e": "/d/silvere/rooms/east/mistralhouse/garden6",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the garden of Joan and Mistral"; }

string query_long() {
  return
    "You are standing in the garden of Joan and Mistral. "
    "To the north Joan and Mistral are building a house. "
    "To the east and west you can go deeper into the garden. "
    "But maybe you can search for herbs in this garden?\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
