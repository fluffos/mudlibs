/*
 * Joan and Mistral's southwest garden — south of
 * garden3.
 *
 * Strategy A FluffOS room. Original (meadow inherit,
 * east garden5) is garden4_ldmud.lpc. Search herbs /
 * house interiors are not loaded. North garden3 and
 * east garden5 are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/east/mistralhouse/garden3",
    "n": "/d/silvere/rooms/east/mistralhouse/garden3",
    "east": "/d/silvere/rooms/east/mistralhouse/garden5",
    "e": "/d/silvere/rooms/east/mistralhouse/garden5",
  ]);
  extras = ([ ]);
}

string query_short() { return "in the garden of Joan and Mistral"; }

string query_long() {
  return
    "You are standing in the garden of Joan and Mistral. "
    "To the east and north you can go deeper into the garden. "
    "But maybe you can search for herbs in this garden?\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
