/*
 * On a road at Silvere — south of mainroad8.
 *
 * Strategy A FluffOS room. Original (south mainroad10) is
 * mainroad9_ldmud.lpc. Archive stub: no AddDetail. South
 * mainroad10 is loaded this slice (west parkroad1 and
 * southgate not loaded).
 * Archive keeps “seems to be”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/south/mainroad8",
    "n": "/d/silvere/rooms/south/mainroad8",
    "south": "/d/silvere/rooms/south/mainroad10",
    "s": "/d/silvere/rooms/south/mainroad10",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a broad road, leading from north to south. To the south is "
    "the citygate, to the north is the palace of the king. The buildings "
    "to the left and right seems to be somewhat foggy, as if they are not "
    "really here.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
