/*
 * On a road at Silvere — west of parkroad3.
 *
 * Strategy A FluffOS room. Original (west parkroad5) is
 * parkroad4_ldmud.lpc. Archive stub: no AddDetail. West
 * parkroad5 is loaded this slice.
 * Archive keeps “didn't decide yet” and trailing space.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/south/parkroad3",
    "e": "/d/silvere/rooms/south/parkroad3",
    "west": "/d/silvere/rooms/south/parkroad5",
    "w": "/d/silvere/rooms/south/parkroad5",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a small road from a crossing to the east toward the citypark. "
    "The buildings to the north and south are somewhat foggy, as if someone "
    "didn't decide yet, how they should look like or what to be found there. \n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
