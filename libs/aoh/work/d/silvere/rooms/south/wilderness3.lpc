/*
 * Road south of wilderness2, before the river.
 *
 * Strategy A FluffOS room. Original (west unfinished
 * fields, south rivershore1) is wilderness3_ldmud.lpc.
 * Archive stub: no AddDetail. West fields / windmill
 * are not wired this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/south/wilderness2",
    "n": "/d/silvere/rooms/south/wilderness2",
    "south": "/d/silvere/rooms/south/rivershore1",
    "s": "/d/silvere/rooms/south/rivershore1",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a road leading north to south. To the north is the city "
    "of Silvere. To the south is a bridge leading over the river. A "
    "small path leads to the west through the fields. In the distance "
    "you can see a windmill.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "here"; }
