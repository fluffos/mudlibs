/*
 * Road south of the southern gates.
 *
 * Strategy A FluffOS room. Original (south self-loop) is
 * wilderness1_ldmud.lpc. Archive stub: no AddDetail.
 * South is wired to wilderness2 (the next layout room;
 * the original south exit pointed at this file).
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/south/southgate",
    "n": "/d/silvere/rooms/south/southgate",
    "south": "/d/silvere/rooms/south/wilderness2",
    "s": "/d/silvere/rooms/south/wilderness2",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "To the north are the gates of Silvere. A broad road "
    "leads there to the south toward a bridge over the river. "
    "To the south is also a small crossing, where a path leads "
    "to the west through some fields.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "here"; }
