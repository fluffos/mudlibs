/*
 * On a road at Silvere — south of mainroad9.
 *
 * Strategy A FluffOS room. Original (south mainroad11 /
 * west parkroad1) is mainroad10_ldmud.lpc. Archive stub:
 * no AddDetail. South mainroad11 is loaded. West
 * parkroad1 is loaded this slice (parkroad4 / parkenter
 * not loaded).
 * Archive keeps “seems to be”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/south/mainroad9",
    "n": "/d/silvere/rooms/south/mainroad9",
    "south": "/d/silvere/rooms/south/mainroad11",
    "s": "/d/silvere/rooms/south/mainroad11",
    "west": "/d/silvere/rooms/south/parkroad1",
    "w": "/d/silvere/rooms/south/parkroad1",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a broad road, leading from north to south. To the south is "
    "the citygate, to the north is the palace of the king. The buildings "
    "to the left and right seems to be somewhat foggy, as if they are not "
    "really here. A small road leads to the west, toward the citypark.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north, south and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
