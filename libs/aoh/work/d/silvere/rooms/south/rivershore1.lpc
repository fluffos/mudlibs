/*
 * Layout stub at the unfinished river bridge.
 *
 * Strategy A FluffOS room. Original (south prevent
 * forest/lighthouse) is rivershore1_ldmud.lpc. Archive
 * stub: no AddDetail. Archive keeps “*No details yet,
 * room only layouted.” South forest / bridge are not
 * wired this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/south/wilderness3",
    "n": "/d/silvere/rooms/south/wilderness3",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road south"; }

string query_long() {
  return
    "This is a road leading to the south. To the north is the city "
    "of Silvere. You see also a small crossing to the north, where a "
    "small path leads to the west through some fields. To the south "
    "is a bridge leading over the river. *No details yet, room only "
    "layouted.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "here"; }
