/*
 * Road south of wilderness1.
 *
 * Strategy A FluffOS room. Original (south self-loop) is
 * wilderness2_ldmud.lpc. Archive stub: no AddDetail.
 * South is wired to wilderness3 (the next layout room;
 * the original south exit pointed at this file).
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/south/wilderness1",
    "n": "/d/silvere/rooms/south/wilderness1",
    "south": "/d/silvere/rooms/south/wilderness3",
    "s": "/d/silvere/rooms/south/wilderness3",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a road leading north to south. To the north is the city "
    "of Silvere. To the south is a bridge leading over the river. A "
    "small path leads there before the bridge to the west through the "
    "fields.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "here"; }
