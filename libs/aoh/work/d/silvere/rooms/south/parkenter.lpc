/*
 * On a road at Silvere — west of parkroad6.
 *
 * Strategy A FluffOS room. Original (west SIL_PARK
 * southentrance) is parkenter_ldmud.lpc. Archive stub:
 * no AddDetail. West park interiors are not loaded
 * this slice.
 * Archive keeps “hasn't decided yet”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/south/parkroad6",
    "e": "/d/silvere/rooms/south/parkroad6",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a small road, leading from the citypark to the west into "
    "the city of Silvere. The buildings to the north and south are somewhat "
    "foggy, as if someone hasn't decided yet, how they should look like or "
    "what can be found there.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
