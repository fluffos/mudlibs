/*
 * Southern gates of Silvere — south of mainroad11.
 *
 * Strategy A FluffOS room. Original (climb ivy / weapons
 * drop) is southgate_ldmud.lpc. Look-ats only; climb is
 * not wired this slice. Archive keeps “This are”.
 * South wilderness1 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/south/mainroad11",
    "n": "/d/silvere/rooms/south/mainroad11",
    "south": "/d/silvere/rooms/south/wilderness1",
    "s": "/d/silvere/rooms/south/wilderness1",
  ]);
  extras = ([
    "ivy":
      "The ivy is hanging down from the battlements of the wall. There are "
      "shiny, three-parted leaves there. The ivy looks quite climbable.\n",
    "wall":
      "The wall surrounds the city of Silvere. From the battlements you see "
      "lots of ivy growing down. The ivy looks strong and it shouldn't be "
      "much of a problem to climb up there.\n",
    "city wall":
      "The wall surrounds the city of Silvere. From the battlements you see "
      "lots of ivy growing down. The ivy looks strong and it shouldn't be "
      "much of a problem to climb up there.\n",
    "wall of silvere":
      "The wall surrounds the city of Silvere. From the battlements you see "
      "lots of ivy growing down. The ivy looks strong and it shouldn't be "
      "much of a problem to climb up there.\n",
    "citywall":
      "The wall surrounds the city of Silvere. From the battlements you see "
      "lots of ivy growing down. The ivy looks strong and it shouldn't be "
      "much of a problem to climb up there.\n",
  ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This are the southern gates of Silvere. During daytime, the gates are "
    "opened, but guarded. At night, they are closed and a player has to find "
    "other places to leave the city. All over the wall is growing ivy, hanging "
    "down from the battlements.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "gate" || str == "gates" || str == "here";
}
