/*
 * On a road at Silvere — south of mainroad10.
 *
 * Strategy A FluffOS room. Original (south southgate) is
 * mainroad11_ldmud.lpc. Archive stub: no AddDetail. South
 * opens the southern-gates look-ats. climb ivy is not
 * wired.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/south/mainroad10",
    "n": "/d/silvere/rooms/south/mainroad10",
    "south": "/d/silvere/rooms/south/southgate",
    "s": "/d/silvere/rooms/south/southgate",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "The citygates of Silvere are right to the south. To the north you can "
    "go to the palace and there is also a crossing, where you can reach the "
    "citypark.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
