/*
 * On a road at Silvere — south of mainsouth1.
 *
 * Strategy A FluffOS room. Original (south mainroad2) is
 * mainroad1_ldmud.lpc. Archive stub: no AddDetail. South
 * mainroad2 is not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/center/mainsouth1",
    "n": "/d/silvere/rooms/center/mainsouth1",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a broad road, leading from the palace to the north toward the "
    "gates of the city to the south. The buildings to the left and right "
    "seems to be somewhat foggy, as if they are not really here.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
