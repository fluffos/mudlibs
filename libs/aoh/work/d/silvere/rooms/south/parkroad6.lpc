/*
 * On a road at Silvere — west of parkroad5.
 *
 * Strategy A FluffOS room. Original (west parkenter) is
 * parkroad6_ldmud.lpc. Archive stub: no AddDetail. West
 * parkenter is loaded this slice (SIL_PARK interiors
 * not loaded).
 * Archive keeps “looks somewhat”, “as someone didn't
 * decide yet”, and trailing space.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/south/parkroad5",
    "e": "/d/silvere/rooms/south/parkroad5",
    "west": "/d/silvere/rooms/south/parkenter",
    "w": "/d/silvere/rooms/south/parkenter",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a small road coming in from the east toward a small wall with "
    "lots of trees behind. The buildings to the north and south looks somewhat "
    "foggy, as someone didn't decide yet, how they should look like or what "
    "to be found there. \n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
