/*
 * Mainroad leading east — east of Tali / outside17.
 *
 * Strategy A FluffOS room. Original (east eastroad2)
 * is eastroad1_ldmud.lpc. Archive stub: no AddDetail.
 * East eastroad2 is loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/center/outside17",
    "w": "/d/silvere/rooms/center/outside17",
    "east": "/d/silvere/rooms/center/eastroad2",
    "e": "/d/silvere/rooms/center/eastroad2",
  ]);
  extras = ([ ]);
}

string query_short() { return "Mainroad leading east"; }

string query_long() {
  return
    "This is a broad road, that leads from east to west. To the west is "
    "the palace of Silvere, where you can see a road leading from north "
    "to south. To the east you can reach the buildings of the eastern "
    "district of Silvere.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
