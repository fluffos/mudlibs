/*
 * Avenue of the Palace — Kyrie statue, west of outside24.
 *
 * Strategy A FluffOS room. Original (TimeMsg, touch
 * statue → kyrei sword, north northroad, west
 * outside26) is outside25_ldmud.lpc. Look at statue /
 * inscription is flavour; touch/sword and north
 * northroad are not loaded this slice. Archive keeps
 * “gaurds” and “Gaurdian”.
 */

mapping exits;
mapping extras;

