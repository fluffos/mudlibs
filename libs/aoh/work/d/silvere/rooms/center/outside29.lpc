/*
 * Avenue at the palace — west of outside28.
 *
 * Strategy A FluffOS room. Original (TimeMsg, west
 * outside30, south garden1) is outside29_ldmud.lpc.
 * Look at fig grove / hedge is flavour. South
 * garden1 is not loaded this slice. Archive keeps
 * “perferred”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/center/outside28",
    "e": "/d/silvere/rooms/center/outside28",
    "west": "/d/silvere/rooms/center/outside30",
    "w": "/d/silvere/rooms/center/outside30",
  ]);
  extras = ([
    "road":
      "Elegant lime trees border the smooth brownstone avenue continues to "
      "the east and west.\n",
    "avenue":
      "Elegant lime trees border the smooth brownstone avenue continues to "
      "the east and west.\n",
    "path":
      "Elegant lime trees border the smooth brownstone avenue continues to "
      "the east and west.\n",
    "stone":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "stones":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "brownstones":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "brownstone":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "lime trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "lime tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "grove":
      "Just to your south is a small grove of big leaved fig trees.\n",
    "fig tree":
      "Just to your south is a small grove of big leaved fig trees.\n",
    "fig trees":
      "Just to your south is a small grove of big leaved fig trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "fig":
      "You can't see them from here.\n",
    "figs":
      "You can't see them from here.\n",
    "palace":
      "The rear palace wall stretches into the distance. The palace is "
      "constructed of the same brown stone that paves the elegant avenue.\n",
    "palace wall":
      "The rear palace wall stretches into the distance. The palace is "
      "constructed of the same brown stone that paves the elegant avenue.\n",
    "rear palace wall":
      "The rear palace wall stretches into the distance. The palace is "
      "constructed of the same brown stone that paves the elegant avenue.\n",
    "hedge":
      "These are elven leaf hedges. They are meticulously coiffed. It is "
      "rumored, elven leaf hedges are the perferred homes of hedgehogs.\n",
    "tiny hedge":
      "These are elven leaf hedges. They are meticulously coiffed. It is "
      "rumored, elven leaf hedges are the perferred homes of hedgehogs.\n",
    "gull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
  ]);
}

string query_short() { return "Avenue at the palace"; }

string query_long() {
  return
      "The wide tree lined avenue gracefully continues to the east and to "
      "the west. From here you see the brownstones of the rear palace "
      "wall. To the south a small neat grove of fig trees grows, bordered "
      "by a tiny hedge, between the main building and the west wing.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
