/*
 * The palace avenue — south of outside30.
 *
 * Strategy A FluffOS room. Original (TimeMsg, south
 * outside32, east garden1) is outside31_ldmud.lpc.
 * Look at fig grove / hedge is flavour. East garden1
 * is not loaded this slice. South outside32 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/center/outside30",
    "n": "/d/silvere/rooms/center/outside30",
    "south": "/d/silvere/rooms/center/outside32",
    "s": "/d/silvere/rooms/center/outside32",
  ]);
  extras = ([
    "road":
      "Elegant lime trees border the smooth brownstone avenue gently "
      "continues north and south.\n",
    "avenue":
      "Elegant lime trees border the smooth brownstone avenue gently "
      "continues north and south.\n",
    "path":
      "Elegant lime trees border the smooth brownstone avenue gently "
      "continues north and south.\n",
    "stone":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "stones":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "brownstones":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "brownstone":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "lime trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "lime tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "grove":
      "Just to your southeast is a small grove of big leaved fig trees.\n",
    "fig tree":
      "Just to your southeast is a small grove of big leaved fig trees.\n",
    "fig trees":
      "Just to your southeast is a small grove of big leaved fig trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "hedge":
      "These are elven leaf hedges. They are meticulously coiffed. It is "
      "rumored, elven leaf hedges are the perferred homes of hedgehogs.\n",
    "tiny hedge":
      "These are elven leaf hedges. They are meticulously coiffed. It is "
      "rumored, elven leaf hedges are the perferred homes of hedgehogs.\n",
    "fig":
      "You can't see them from here.\n",
    "figs":
      "You can't see them from here.\n",
    "gull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "jays":
      "Noisy jays and mocking birds chase each other through the trees.\n",
    "mocking birds":
      "Noisy jays and mocking birds chase each other through the trees.\n",
    "jay":
      "Noisy jays and mocking birds chase each other through the trees.\n",
    "mocking bird":
      "Noisy jays and mocking birds chase each other through the trees.\n",
  ]);
}

string query_short() { return "The palace avenue"; }

string query_long() {
  return
      "Lime trees border the wide palace avenue as it gracefully continues "
      "to the north and south. To the east a small grove of fig trees, "
      "bordered by a tiny hedge, grows between the main building and the "
      "west wing of the palace.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
