/*
 * The place before the palace — north of palplace3 /
 * east of palplace5.
 *
 * Strategy A FluffOS room. Original (TimeMsg, lantern VItem)
 * is palplace6_ldmud.lpc. Look at bench / lanterns / roses
 * is flavour. Archive long keeps Sonic/Joan typo “enrance”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/center/palplace3",
    "s": "/d/silvere/rooms/center/palplace3",
    "west": "/d/silvere/rooms/center/palplace5",
    "w": "/d/silvere/rooms/center/palplace5",
  ]);
  extras = ([
    "lantern":
      "Cast iron frames hold thin, rectangular sheets of alabaster "
      "as side panels, which glow with a soft white light when the "
      "lanterns are lit.\n",
    "lanterns":
      "Cast iron frames hold thin, rectangular sheets of alabaster "
      "as side panels, which glow with a soft white light when the "
      "lanterns are lit.\n",
    "light":
      "Cast iron frames hold thin, rectangular sheets of alabaster "
      "as side panels, which glow with a soft white light when the "
      "lanterns are lit.\n",
    "lights":
      "Cast iron frames hold thin, rectangular sheets of alabaster "
      "as side panels, which glow with a soft white light when the "
      "lanterns are lit.\n",
    "palace":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "palace wall":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "front palace wall":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "bench":
      "A wide low beautifully crafted white marble bench sits among the "
      "dazzling displays of flowers.\n",
    "marble bench":
      "A wide low beautifully crafted white marble bench sits among the "
      "dazzling displays of flowers.\n",
    "white":
      "A wide low beautifully crafted white marble bench sits among the "
      "dazzling displays of flowers.\n",
    "white marble bench":
      "A wide low beautifully crafted white marble bench sits among the "
      "dazzling displays of flowers.\n",
    "gull":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "seagull":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "seagulls":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "gulls":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "dove":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "mourning dove":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "mourning doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "rose":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "roses":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "shrubs":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "flower":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
    "flowers":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
    "saliums":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
    "salium":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
  ]);
}

string query_short() { return "The place before the palace"; }

string query_long() {
  return
    "The walls of the main building are right before you. Latticed windows "
    "can be seen all over the basement of the building. To the west is the "
    "enrance of the palace. The mainroad to the south starts there also. "
    "All over the place are beds with artfully arranged flowers and beautiful cascades of roses.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "place" || str == "palace" || str == "here";
}
