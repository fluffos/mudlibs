/*
 * At the entrance into the palace — east of palplace4.
 *
 * Strategy A FluffOS room. Original (TimeMsg, enter_palace
 * → palenter, south palplace2, east palplace6) is
 * palplace5_ldmud.lpc. Look at hieroglyphics / palace /
 * roses is flavour; palace interiors and the other square
 * exits are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/center/palplace4",
    "w": "/d/silvere/rooms/center/palplace4",
  ]);
  extras = ([
    "hieroglyphics":
      "The intricate carvings tell the story of the founding of "
      "Silvere. \n",
    "hieroglyphic":
      "The intricate carvings tell the story of the founding of "
      "Silvere. \n",
    "palace":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "palace wall":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "front palace wall":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "gull":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "seagull":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "seagulls":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "gulls":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "dove":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "mourning dove":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "mourning doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "rose":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "roses":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "shrubs":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "flower":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
    "flowers":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
    "saliums":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
    "salium":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
  ]);
}

string query_short() { return "At the entrance into the palace"; }

string query_long() {
  return
    "To the north the elegant entrance to the palace opens up before you. "
    "The brownstones of the deep entry way are covered with hieroglyphics. "
    "A broad road leads from here "
    "between the flowerbeds and roses to the south toward the citygates "
    "of Silvere.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "entrance" || str == "palace" || str == "here";
}
