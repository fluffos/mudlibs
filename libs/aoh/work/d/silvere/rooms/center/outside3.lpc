/*
 * The palace avenue — south of outside2.
 *
 * Strategy A FluffOS room. Original (TimeMsg, south outside4)
 * is outside3_ldmud.lpc. Look at cinnamon/flowers/trees is
 * flavour; further palace avenue (outside4) is not loaded
 * this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/center/outside2",
    "n": "/d/silvere/rooms/center/outside2",
  ]);
  extras = ([
    "cinnamon":
      "Beautiful tiny cinnamons line the base of the "
      "the brownstone palace wall. Their heady scent makes you "
      "think of home, your mother and cinnamon bread.\n",
    "cassia":
      "Beautiful tiny cinnamons line the base of the "
      "the brownstone palace wall. Their heady scent makes you "
      "think of home, your mother and cinnamon bread.\n",
    "flowers":
      "Piles of gorgeous blue gentleman's "
      "buttons line the base of the brownstone palace wall.\n",
    "buttons":
      "Piles of gorgeous blue gentleman's "
      "buttons line the base of the brownstone palace wall.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters "
      "of ripening limes crowd the branches of the mature trees.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters "
      "of ripening limes crowd the branches of the mature trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "avenue":
      "Elegant lime trees border "
      "the smooth brownstone avenue gently continues north and "
      "south.\n",
    "road":
      "Elegant lime trees border "
      "the smooth brownstone avenue gently continues north and "
      "south.\n",
    "stone":
      "The smooth brownstones are carefully cut and laid with "
      "almost seamless precision.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "jays":
      "Noisy jays and mocking birds chase each other through "
      "the trees.\n",
  ]);
}

string query_short() { return "The palace avenue"; }

string query_long() {
  return
    "Lime trees border west side of the wide palace avenue as "
    "it gracefully continues to the north and south. To the north "
    "the avenue elegantly intersects a road to the west. Delicate "
    "tiny cassia cinnamon trees and blue gentleman's buttons border "
    "the base of the west palace wing. Seagulls glide silently high "
    "over head. Mourning doves coo as they forage though the soft "
    "grass under the trees and through the flower beds.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "avenue" || str == "palace" || str == "here";
}
