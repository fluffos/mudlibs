/*
 * Avenue of the Palace — east of outside1.
 *
 * Strategy A FluffOS room. Original (statue VItem, touch
 * helmet, north outside32, south outside3) is
 * outside2_ldmud.lpc. Look at statue/roses/inscription
 * is flavour; touch/helmet and further plaza exits are
 * not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/center/outside1",
    "w": "/d/silvere/rooms/center/outside1",
  ]);
  extras = ([
    "statue":
      "Delicately sculpted in fine white marble is a "
      "beautiful winged female human. She wears an intricately "
      "carved marble helmet upon her head. Her feet rest upon "
      "cold marble mountains. White marble wood nymphs dance "
      "upon her shoulders. You see dirty finger prints on the "
      "statue. There is something carved into the base of the "
      "beautiful white marble. Perhaps you should read it.\n",
    "inscription":
      "The Gaurdian Rilana. She is the guardian of the "
      "element known as earth.\n",
    "base":
      "The base of the statue was hewn from the same fine "
      "white marble as the statue itself. There is an "
      "inscription engraved on the base.\n",
    "roses":
      "Thick shrub roses line the base of the palace wall. Myrads "
      "of blooms fall from mid wall to the emerald grass "
      "forming a fragrant yellow blanket of perfect yellow roses.\n",
    "rose":
      "Thick shrub roses line the base of the palace wall. Myrads "
      "of blooms fall from mid wall to the emerald grass "
      "forming a fragrant yellow blanket of perfect yellow roses.\n",
    "palace":
      "The west palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "wall":
      "The west palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "avenue":
      "The graceful avenue intersects to the western approach "
      "to the palace. A huge white marble statue quietly gaurds "
      "the west wall of the palace. The avenue stretches elegantly "
      "to north and south.\n",
    "road":
      "The graceful avenue intersects to the western approach "
      "to the palace. A huge white marble statue quietly gaurds "
      "the west wall of the palace. The avenue stretches elegantly "
      "to north and south.\n",
    "stone":
      "The stones brownstones are carefully cut and laid with "
      "almost seamless precision. The avenue is paved with the "
      "same brownstones used to construct the magnificent "
      "palace.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
  ]);
}

string query_short() { return "Avenue of the Palace"; }

string query_long() {
  return
    "The tree lined palace avenue stretches from north to south. "
    "A broad road leads west into the city. A huge white marble statue "
    "guards the west palace wall. Yellow shrub roses line the base "
    "of the wall. You glimpse the hustle and bustle of the city "
    "through the western city gates. Seagulls glide high "
    "overhead and mourning doves coo as they "
    "forage for food beneath the shrubs and around "
    "the base the of the beautiful statue.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "avenue" || str == "palace" || str == "here";
}
