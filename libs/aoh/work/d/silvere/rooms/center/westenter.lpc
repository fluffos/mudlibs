/*
 * Central place, west end — east of westroad11.
 *
 * Strategy A FluffOS room. Original (TimeMsg, east outside1)
 * is westenter_ldmud.lpc. East palace avenue (outside1)
 * is not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westroad11",
    "w": "/d/silvere/rooms/west/westroad11",
  ]);
  extras = ([
    "palace":
      "You can see the west palace wall in the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "wall":
      "You can see the west palace wall in the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "statue":
      "You gaze east towards the statue "
      "but you can't get a good look at it from here.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters "
      "of ripening limes crowd the branches of the mature trees.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters "
      "of ripening limes crowd the branches of the mature trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "road":
      "The western approach intersects to graceful north and south "
      "avenue of the palace. A huge white marble statue quietly gaurds "
      "the west wall of the palace. The avenue stretches east toward "
      "the palace and west into the city.\n",
    "avenue":
      "The western approach intersects to graceful north and south "
      "avenue of the palace. A huge white marble statue quietly gaurds "
      "the west wall of the palace. The avenue stretches east toward "
      "the palace and west into the city.\n",
    "stone":
      "The stones brownstones are carefully cut and laid with "
      "almost seamless precision. The avenue is paved with the "
      "same brownstones used to construct the magnificent "
      "palace.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
  ]);
}

string query_short() { return "Central place, west end"; }

string query_long() {
  return
    "To the east palace plaza opens before you. The brownstone palace walls "
    "begin to rise in the distance. To the west the avenue stretches into "
    "Silvere and the harbour areas of Silvere. Lime trees stand sentry to "
    "the north and south sides of the avenue. Seagulls glide high overhead "
    "and mourning doves coo as they forage for food beneath the lime trees.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "place" || str == "square" || str == "here";
}
