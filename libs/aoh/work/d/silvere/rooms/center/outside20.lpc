/*
 * The palace avenue — north of outside19, turns west.
 *
 * Strategy A FluffOS room. Original (TimeMsg, west
 * outside21, southwest garden4) is outside20_ldmud.lpc.
 * Look at grove is flavour. Southwest garden4 opens
 * the pomegranate garden (look only). Archive keeps
 * “grove os sweet”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/center/outside19",
    "s": "/d/silvere/rooms/center/outside19",
    "west": "/d/silvere/rooms/center/outside21",
    "w": "/d/silvere/rooms/center/outside21",
    "southwest": "/d/silvere/rooms/center/garden4",
    "sw": "/d/silvere/rooms/center/garden4",
  ]);
  extras = ([
    "road":
      "Elegant lime trees border the smooth brownstone avenue gently "
      "curving to the west and south.\n",
    "avenue":
      "Elegant lime trees border the smooth brownstone avenue gently "
      "curving to the west and south.\n",
    "path":
      "Elegant lime trees border the smooth brownstone avenue gently "
      "curving to the west and south.\n",
    "stone":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "stones":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "brownstones":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "brownstone":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "lime tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "lime trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "grove":
      "Just to your southeast is a small grove os sweet pomegranate trees.\n",
    "pomegranate tree":
      "Just to your southeast is a small grove os sweet pomegranate trees.\n",
    "pomegranate trees":
      "Just to your southeast is a small grove os sweet pomegranate trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "pomegranates":
      "You can't see them from here.\n",
    "pomegranate":
      "You can't see them from here.\n",
    "gull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "jays":
      "Noisy jays and mocking birds chase each other through the trees.\n",
    "mocking birds":
      "Noisy jays and mocking birds chase each other through the trees.\n",
    "jay":
      "Noisy jays and mocking birds chase each other through the trees.\n",
    "mocking bird":
      "Noisy jays and mocking birds chase each other through the trees.\n",
  ]);
}

string query_short() { return "The palace avenue"; }

string query_long() {
  return
      "Lime trees border the wide palace avenue as it gently turns to the "
      "west and to the south. To the southwest a small grove of sweet "
      "pomegranates grows between the main building and the west wing of "
      "the palace.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south, west and southwest.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
