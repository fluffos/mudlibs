/*
 * Avenue of the Palace — west of outside23.
 *
 * Strategy A FluffOS room. Original (TimeMsg, west
 * outside25) is outside24_ldmud.lpc. Look at sage /
 * mint / star liliums is flavour. Archive keeps
 * “The stones brownstones”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/center/outside23",
    "e": "/d/silvere/rooms/center/outside23",
    "west": "/d/silvere/rooms/center/outside25",
    "w": "/d/silvere/rooms/center/outside25",
  ]);
  extras = ([
    "road":
      "Elegant lime trees border the smooth brownstone avenue continues to "
      "the east and west.\n",
    "avenue":
      "Elegant lime trees border the smooth brownstone avenue continues to "
      "the east and west.\n",
    "path":
      "Elegant lime trees border the smooth brownstone avenue continues to "
      "the east and west.\n",
    "stone":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "stones":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "brownstones":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "brownstone":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "lime trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "lime tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "palace":
      "The rear palace wall stretches into the distance. The palace is "
      "constructed of the same brown stone that paves the elegant avenue.\n",
    "palace wall":
      "The rear palace wall stretches into the distance. The palace is "
      "constructed of the same brown stone that paves the elegant avenue.\n",
    "rear palace wall":
      "The rear palace wall stretches into the distance. The palace is "
      "constructed of the same brown stone that paves the elegant avenue.\n",
    "gull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "dove":
      "Small dappled grey doves forage for food through the soft grass "
      "beneath lime trees.\n",
    "mourning dove":
      "Small dappled grey doves forage for food through the soft grass "
      "beneath lime trees.\n",
    "mourning doves":
      "Small dappled grey doves forage for food through the soft grass "
      "beneath lime trees.\n",
    "doves":
      "Small dappled grey doves forage for food through the soft grass "
      "beneath lime trees.\n",
    "sage":
      "The grey-green leaves and small purple flowers of the sage, softly "
      "compliment the bright star liliums and dark green mint.\n",
    "mint":
      "Tall deep green mint plants line the base of the rear palace wall. "
      "They frame the wall for the showy orange star liliums and small "
      "lovely shrubs of sage.\n",
    "star liliums":
      "Large bright orange star liliums sit in neat rows against the green "
      "backdrop of the taller mint. The gay orange flowers softly "
      "compliment the grey-green of the sage, deep green mint and the "
      "brown hues of the stone palace walls.\n",
  ]);
}

string query_short() { return "Avenue of the Palace"; }

string query_long() {
  return
      "To the east the avenue becomes broader where it crosses a wide road "
      "heading north. Sage and mint beds along with orange star liliums "
      "line the base of the palace wall, while graceful lime trees border "
      "the opposite side of the avenue.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
