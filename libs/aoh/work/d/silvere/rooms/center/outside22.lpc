/*
 * Avenue at the palace — west of outside21.
 *
 * Strategy A FluffOS room. Original (TimeMsg, west
 * outside23, south garden3) is outside22_ldmud.lpc.
 * Look at grove / doves is flavour. South garden3
 * is not loaded this slice. Archive keeps “trees..”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/center/outside21",
    "e": "/d/silvere/rooms/center/outside21",
    "west": "/d/silvere/rooms/center/outside23",
    "w": "/d/silvere/rooms/center/outside23",
  ]);
  extras = ([
    "road":
      "Elegant lime trees border the smooth brownstone avenue continues to "
      "the east and west.\n",
    "avenue":
      "Elegant lime trees border the smooth brownstone avenue continues to "
      "the east and west.\n",
    "path":
      "Elegant lime trees border the smooth brownstone avenue continues to "
      "the east and west.\n",
    "stone":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "stones":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "brownstones":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "brownstone":
      "The stones brownstones are carefully cut and laid with almost "
      "seamless precision. The avenue is paved with the same brownstones "
      "used to construct the magnificent palace.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "lime trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "lime tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the trees.\n",
    "grove":
      "Just to your south is a small grove of sweet pomegranate trees.\n",
    "pomegranate tree":
      "Just to your south is a small grove of sweet pomegranate trees.\n",
    "pomegranate trees":
      "Just to your south is a small grove of sweet pomegranate trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "pomegranate":
      "You can't see them from here.\n",
    "pomegranates":
      "You can't see them from here.\n",
    "palace":
      "The rear palace wall stretches into the distance. The palace is "
      "constructed of the same brown stone that paves the elegant avenue.\n",
    "palace wall":
      "The rear palace wall stretches into the distance. The palace is "
      "constructed of the same brown stone that paves the elegant avenue.\n",
    "rear palace wall":
      "The rear palace wall stretches into the distance. The palace is "
      "constructed of the same brown stone that paves the elegant avenue.\n",
    "gull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "dove":
      "Small dappled grey doves forage for food through the soft grass "
      "beneath lime trees..\n",
    "mourning dove":
      "Small dappled grey doves forage for food through the soft grass "
      "beneath lime trees..\n",
    "mourning doves":
      "Small dappled grey doves forage for food through the soft grass "
      "beneath lime trees..\n",
    "doves":
      "Small dappled grey doves forage for food through the soft grass "
      "beneath lime trees..\n",
  ]);
}

string query_short() { return "Avenue at the palace"; }

string query_long() {
  return
      "The wide tree lined avenue gracefully continues to the east and to "
      "the west. From here you see the brownstones of the rear palace "
      "wall. To the south a small neat grove of pomegranate trees grows "
      "between the main building and the west wing.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
