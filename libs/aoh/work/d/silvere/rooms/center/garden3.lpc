string query_short() { return "Palace pomegranate Garden"; }

string query_long() {
  return
      "Small clusters of sweet pomegranate trees are scattered across neatly trimmed "
      "lawn. A lovely tiny lily pond lies nestled withing the quiet little grove. "
      "Tiny well coiffed hedges border the north exits of the tiny garden. The "
      "pretty little garden continues to the east.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
