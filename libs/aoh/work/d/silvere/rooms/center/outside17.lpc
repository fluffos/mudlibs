string query_short() { return "Avenue of the Palace"; }

string query_long() {
  return
      "Here the graceful palace avenue meets a broad avenue wandering into "
      "eastern Silvere. Lime trees line the avenue to the north and south "
      "while an elegant marble statue guards the east side of the palace. "
      "Red shrub roses border the brown stone palace wall and statue "
      "base.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
