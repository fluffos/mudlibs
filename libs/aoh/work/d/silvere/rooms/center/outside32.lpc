string query_short() { return "palace avenue"; }

string query_long() {
  return
      "Elegant lime trees border the west side of the north to south "
      "length of avenue while the brownstones of the west wing palace wall "
      "border the east side. To the south the avenue gracefully intersects "
      "with a crossing to the west. To the east delicate cinnamon trees "
      "and exotic jasmine border the west palace wall.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
