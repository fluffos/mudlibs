/*
 * palace avenue — south of outside31, north of outside2.
 *
 * Strategy A FluffOS room. Original (TimeMsg, south
 * outside2) is outside32_ldmud.lpc. Look at jasmine /
 * cinnamon is flavour. Archive short omits “The”.
 * South closes the palace loop onto outside2.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/center/outside31",
    "n": "/d/silvere/rooms/center/outside31",
    "south": "/d/silvere/rooms/center/outside2",
    "s": "/d/silvere/rooms/center/outside2",
  ]);
  extras = ([
    "road":
      "Elegant lime trees border the smooth brownstone avenue gently "
      "continues north and south.\n",
    "avenue":
      "Elegant lime trees border the smooth brownstone avenue gently "
