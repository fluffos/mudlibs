/*
 * Avenue of the Palace — south of palplace2.
 *
 * Strategy A FluffOS room. Original (TimeMsg, touch statue
 * → sarykan boots, south mainroad1, east outside10, west
 * outside9) is mainsouth1_ldmud.lpc. Look at statue /
 * inscription is flavour; touch/helmet and further south
 * or east are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/center/palplace2",
    "n": "/d/silvere/rooms/center/palplace2",
  ]);
  extras = ([
    "road":
      "The graceful avenue "
