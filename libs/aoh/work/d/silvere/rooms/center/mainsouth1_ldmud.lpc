string query_short() { return "Avenue of the Palace"; }

string query_long() {
  return
    "The tree lined palace avenue stretches from east to west and to the north and south. The "
    "stones of the front of the palace can be seen from here. A broad "
    "road leads north to palace entrance and south to the harbour. A huge white marble statue "
    "guards the northern approach to the palace. Pink and white shrub roses "
    "line the base of the statue.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "avenue" || str == "palace" || str == "here";
}
