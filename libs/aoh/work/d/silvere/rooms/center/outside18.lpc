/*
 * The palace avenue — north of outside17.
 *
 * Strategy A FluffOS room. Original (TimeMsg, north
 * outside19) is outside18_ldmud.lpc. Look at Morning
 * Stars / cinnamon / lime trees is flavour.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/center/outside17",
    "s": "/d/silvere/rooms/center/outside17",
    "north": "/d/silvere/rooms/center/outside19",
    "n": "/d/silvere/rooms/center/outside19",
  ]);
  extras = ([
    "road":
      "Elegant lime trees border the smooth brownstone avenue gently "
      "continues north and south.\n",
