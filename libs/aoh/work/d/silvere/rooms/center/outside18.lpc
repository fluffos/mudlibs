    "flower":
      "Mounds of gay yellow Morning Stars line the base of the brownstone "
      "wall.\n",
    "flowers":
      "Mounds of gay yellow Morning Stars line the base of the brownstone "
      "wall.\n",
    "morning stars":
      "Mounds of gay yellow Morning Stars line the base of the brownstone "
      "wall.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
