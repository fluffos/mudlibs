string query_short() { return "The palace avenue"; }

string query_long() {
  return
      "Lime trees border east side of the wide palace avenue as it "
      "gracefully continues to the north and south. To the south the "
      "avenue elegantly intersects a road to the east. Delicate tiny "
      "cassia cinnamon trees and mounds of precious Morning Stars border "
      "the base of the east palace wing.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
