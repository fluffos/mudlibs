/*
 * The palace avenue — north of outside18.
 *
 * Strategy A FluffOS room. Original (TimeMsg, north
 * outside20, west garden4) is outside19_ldmud.lpc.
 * Look at grove / limes is flavour. North outside20
 * and west garden4 are not loaded this slice.
 * Archive concatenates “pomegranatetrees”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/center/outside18",
    "s": "/d/silvere/rooms/center/outside18",
  ]);
  extras = ([
    "road":
      "Elegant lime trees border the smooth brownstone avenue as it gently "
      "continues north and south.\n",
    "avenue":
      "Elegant lime trees border the smooth brownstone avenue as it gently "
      "continues north and south.\n",
    "path":
      "Elegant lime trees border the smooth brownstone avenue as it gently "
      "continues north and south.\n",
    "stone":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "stones":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "brownstones":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "brownstone":
      "The smooth brownstones are carefully cut and laid with almost "
      "seamless precision.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "lime trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "lime tree":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters of "
      "ripening limes crowd the branches of the mature trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "grove":
      "Just to your southwest is a small grove of sweet pomegranatetrees.\n",
    "pomegranate tree":
      "Just to your southwest is a small grove of sweet pomegranatetrees.\n",
    "pomegranate trees":
      "Just to your southwest is a small grove of sweet pomegranatetrees.\n",
    "pomegranates":
      "You can't see them from here.\n",
    "pomegranate":
      "You can't see them from here.\n",
    "gull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagull":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "seagulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for an easy "
      "meal.\n",
    "jays":
      "Noisy jays and mocking birds chase each other through the trees.\n",
    "mocking birds":
      "Noisy jays and mocking birds chase each other through the trees.\n",
    "jay":
      "Noisy jays and mocking birds chase each other through the trees.\n",
    "mocking bird":
      "Noisy jays and mocking birds chase each other through the trees.\n",
  ]);
}

string query_short() { return "The palace avenue"; }

string query_long() {
  return
      "Lime trees border the wide palace avenue as it gracefully continues "
      "to the north and south. To the west a small grove of sweet "
      "pomegranates grows between the main building and the west wing of "
      "the palace.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
