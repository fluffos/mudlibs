/*
 * The place before the palace — east of palplace2.
 *
 * Strategy A FluffOS room. Original (TimeMsg, lantern VItem,
 * north palplace6, south outside10) is palplace3_ldmud.lpc.
 * Look at lanterns / roses / saliums is flavour. North
 * palplace6 and south outside10 are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/center/palplace2",
    "w": "/d/silvere/rooms/center/palplace2",
  ]);
  extras = ([
    "lantern":
      "Cast iron frames hold thin, rectangular sheets of alabaster "
      "as side panels, which glow with a soft white light when the "
      "lanterns are lit.\n",
    "lanterns":
      "Cast iron frames hold thin, rectangular sheets of alabaster "
      "as side panels, which glow with a soft white light when the "
      "lanterns are lit.\n",
    "light":
      "Cast iron frames hold thin, rectangular sheets of alabaster "
      "as side panels, which glow with a soft white light when the "
      "lanterns are lit.\n",
    "lights":
      "Cast iron frames hold thin, rectangular sheets of alabaster "
      "as side panels, which glow with a soft white light when the "
      "lanterns are lit.\n",
    "palace":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "palace wall":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "front palace wall":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "gull":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "seagull":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "seagulls":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "gulls":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "dove":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "mourning dove":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "mourning doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "rose":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "roses":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "shrubs":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "flower":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
    "flowers":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
    "saliums":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
    "salium":
      "A myriad of soft pink saliums border the "
      "shrub rose and palace wall.\n",
  ]);
}

string query_short() { return "The place before the palace"; }

string query_long() {
  return
    "This is the eastern side of a small square which rests between the "
    "wings of the royal palace. Beds of exotic flowers curve around "
    "paths of gravel and crushed seashells below the windows of the "
    "palace.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "place" || str == "palace" || str == "here";
}
