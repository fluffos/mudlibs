string query_short() { return "The palace avenue"; }

string query_long() {
  return
      "The palace avenue gracefully turns west and north here. Cinnamon "
      "trees to the west and lime trees to the east guard the beautiful "
      "Lady flowers in thier soft grass beds by the east palace wall.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
