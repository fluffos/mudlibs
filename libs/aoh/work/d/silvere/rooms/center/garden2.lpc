string query_short() { return "Palace Fig Garden"; }

string query_long() {
  return
      "Small clusters of big leave fig trees are scattered across neatly trimmed "
      "lawn. Tiny well coiffed hedges border the north exits of the tiny garden. "
      "The pretty little garden continues to the west.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
