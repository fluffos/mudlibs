string query_short() { return "Palace pomegranate Garden"; }

string query_long() {
  return
      "Small clusters of sweet pomegranate trees are scattered across the "
      "neatly trimmed lawn. Tiny well coiffed hedges border the west "
      "and northern exits of the tiny garden. The pretty little garden "
      "continues to the west.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west, northeast, east and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "garden" || str == "here";
}
