/*
 * The palace avenue — south of outside4, turns east.
 *
 * Strategy A FluffOS room. Original (TimeMsg, east outside6)
 * is outside5_ldmud.lpc. Look at flowers/cinnamon/avenue is
 * flavour; east opens Road at the palace (look only).
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/center/outside4",
    "n": "/d/silvere/rooms/center/outside4",
    "east": "/d/silvere/rooms/center/outside6",
    "e": "/d/silvere/rooms/center/outside6",
  ]);
  extras = ([
    "flowers":
      "Neat beds of bright purple bonnie bells make a blushing "
      "border for the tiny trees and palace wall. They smell "
      "wonderful!\n",
    "bonnies":
      "Neat beds of bright purple bonnie bells make a blushing "
      "border for the tiny trees and palace wall. They smell "
      "wonderful!\n",
    "cinnamon":
      "Beautiful tiny cinnamons line the base of the "
      "the brownstone palace wall. Their heady scent makes you "
      "think of home, your mother and cinnamon bread.\n",
    "cassia":
      "Beautiful tiny cinnamons line the base of the "
      "the brownstone palace wall. Their heady scent makes you "
      "think of home, your mother and cinnamon bread.\n",
    "avenue":
      "Elegant lime trees border "
      "the smooth brownstone avenue gently curves north and "
      "east.\n",
    "road":
      "Elegant lime trees border "
      "the smooth brownstone avenue gently curves north and "
      "east.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters "
      "of ripening limes crowd the branches of the mature trees.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters "
      "of ripening limes crowd the branches of the mature trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "stone":
      "The smooth brownstones are carefully cut and laid with "
      "almost seamless precision.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "jays":
      "Noisy jays and mocking birds chase each other through "
      "the trees.\n",
  ]);
}

string query_short() { return "The palace avenue"; }

string query_long() {
  return
    "The palace avenue gracefully turns east and north here. "
    "Cinnamon trees to the east and lime trees to the west "
    "guard the beautiful bonnie bells in thier soft grass "
    "beds by the west palace wall. Jays and mocking birds chase "
    "each other through the trees as seagulls float lazily high "
    "overhead.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "avenue" || str == "palace" || str == "here";
}
