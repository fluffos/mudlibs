/*
 * The palace avenue — south of outside3.
 *
 * Strategy A FluffOS room. Original (TimeMsg, south outside5)
 * is outside4_ldmud.lpc. Look at saliums/cinnamon/stone is
 * flavour; further palace avenue (outside5) is not loaded
 * this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/center/outside3",
    "n": "/d/silvere/rooms/center/outside3",
  ]);
  extras = ([
    "saliums":
      "A myriad of soft pink saliums hug the base of the "
      "tiny trees and palace wall.\n",
    "salium":
      "A myriad of soft pink saliums hug the base of the "
      "tiny trees and palace wall.\n",
    "flowers":
      "A myriad of soft pink saliums hug the base of the "
      "tiny trees and palace wall.\n",
    "cinnamon":
      "Beautiful tiny cinnamons line the base of the "
      "the brownstone palace wall. Their heady scent makes you "
      "think of home, your mother and cinnamon bread.\n",
    "cassia":
      "Beautiful tiny cinnamons line the base of the "
      "the brownstone palace wall. Their heady scent makes you "
      "think of home, your mother and cinnamon bread.\n",
    "trees":
      "A row of well tended lime trees border the avenue. Clusters "
      "of ripening limes crowd the branches of the mature trees.\n",
    "tree":
      "A row of well tended lime trees border the avenue. Clusters "
      "of ripening limes crowd the branches of the mature trees.\n",
    "limes":
      "The limes are not ripe yet.\n",
    "lime":
      "The limes are not ripe yet.\n",
    "avenue":
      "Elegant lime trees border "
      "the smooth brownstone avenue gently continues north and "
      "south.\n",
    "road":
      "Elegant lime trees border "
      "the smooth brownstone avenue gently continues north and "
      "south.\n",
    "stone":
      "The smooth brownstones are carefully cut and laid with "
      "almost seamless precision.\n",
    "gulls":
      "Big grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "jays":
      "Noisy jays and mocking birds chase each other through "
      "the trees.\n",
  ]);
}

string query_short() { return "The palace avenue"; }

string query_long() {
  return
    "The west side of the wide palace avenue boasts graceful "
    "lime trees as it continues gentley to the north and south. "
    "The east side of the avenue boasts a myriad of soft "
    "pink saliums and a neat row of delicate tiny cassia cinnamon "
    "trees hugging the west palace wall. Seagulls glide silently high "
    "over head. Mourning doves coo as they forage though the soft grass "
    "under the trees.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "avenue" || str == "palace" || str == "here";
}
