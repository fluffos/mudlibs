string query_short() { return "The palace avenue"; }

string query_long() {
  return
      "The east side of the wide palace avenue boasts graceful lime trees "
      "as it continues gentley to the north and south. The west side of "
      "the avenue boasts a myriad of soft blue Arabellas and a neat row of "
      "delicate tiny cassia cinnamon trees hugging the east palace wall.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "palace" || str == "here";
}
