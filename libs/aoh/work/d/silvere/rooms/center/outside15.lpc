/*
 * The palace avenue — north of outside14.
 *
 * Strategy A FluffOS room. Original (TimeMsg, north
 * outside16) is outside15_ldmud.lpc. Look at Arabellas
 * / cinnamon / lime trees is flavour. Archive keeps
 * “gentley”.
 */

mapping exits;
mapping extras;

