/*
 * Avenue the palace — east of outside10.
 *
 * Strategy A FluffOS room. Original (TimeMsg, east
 * outside12) is outside11_ldmud.lpc. Look at avenue /
 * brownstones / roses is flavour. East outside12 is
 * not loaded this slice. Archive keeps short typo
 * “Avenue the palace” and “The stones brownstones”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/center/outside10",
    "w": "/d/silvere/rooms/center/outside10",
  ]);
  extras = ([
    "road":
      "To the west the graceful avenue "
      "intersects to the northern approach to the palace. "
      "The avenue stretches elegantly to east and "
      " west.\n",
    "avenue":
      "To the west the graceful avenue "
      "intersects to the northern approach to the palace. "
      "The avenue stretches elegantly to east and "
      " west.\n",
    "path":
      "To the west the graceful avenue "
      "intersects to the northern approach to the palace. "
      "The avenue stretches elegantly to east and "
      " west.\n",
    "stone":
      "The stones brownstones are carefully cut and laid with "
      "almost seamless precision. The avenue is paved with the "
      "same brownstones used to construct the magnificent "
      "palace.\n",
    "stones":
      "The stones brownstones are carefully cut and laid with "
      "almost seamless precision. The avenue is paved with the "
      "same brownstones used to construct the magnificent "
      "palace.\n",
    "brownstones":
      "The stones brownstones are carefully cut and laid with "
      "almost seamless precision. The avenue is paved with the "
      "same brownstones used to construct the magnificent "
      "palace.\n",
    "brownstone":
      "The stones brownstones are carefully cut and laid with "
      "almost seamless precision. The avenue is paved with the "
      "same brownstones used to construct the magnificent "
      "palace.\n",
    "palace":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "palace wall":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "front palace wall":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "wall":
      "The front palace wall stretches into the distance. The "
      "palace is constructed of the same brown stone that paves "
      "the elegant avenue.\n",
    "gull":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "seagull":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "seagulls":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "gulls":
      "Big "
      "grey and white gulls glide lazily along searching for "
      "an easy meal.\n",
    "dove":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "mourning dove":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "mourning doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "doves":
      "Small dappled grey doves forage for food beneath the shrubs.\n",
    "rose":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "roses":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
    "shrubs":
      "Thick shrub "
      "roses line the base of the palace wall. Their profuse "
      "blooms of soft pink and creamy white roses tumble from "
      "mid wall to the emerald grass below in a breathtaking "
      "display of natural beauty.\n",
  ]);
}

string query_short() { return "Avenue the palace"; }

string query_long() {
  return
    "The tree lined palace avenue stretches from east to west and to the north. The "
    "stones of the front of the palace can be seen from here.  Pink and white shrub roses "
    "line the base of the wall.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "avenue" || str == "palace" || str == "here";
}
