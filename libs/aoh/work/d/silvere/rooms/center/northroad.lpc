/*
 * On a road at Silvere — north of outside25 (Kyrie).
 *
 * Strategy A FluffOS room. Original (north #'prevent_void
 * closure) is northroad_ldmud.lpc. Archive stub: no
 * AddDetail. North is not loaded this slice (do not
 * implement the LDMud prevent_void message).
 * Archive keeps “seems to be”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/center/outside25",
    "s": "/d/silvere/rooms/center/outside25",
  ]);
  extras = ([ ]);
}

string query_short() { return "On a road at Silvere"; }

string query_long() {
  return
    "This is a broad road, leading from the backside of the palace to the "
    "south toward the gates of the city to the north. The buildings to "
    "the left and right seems to be somewhat foggy, as if they are not "
    "really here.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
