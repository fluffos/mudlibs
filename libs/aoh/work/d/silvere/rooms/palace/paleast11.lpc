/*
 * East-wing undecided stub — north of paleast10.
 *
 * Strategy A FluffOS room. Original is
 * paleast11_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “This room is undecided” / “stairway
 * up to a tower”. South paleast10 is loaded. No
 * tower / palwest11 armoury this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/palace/paleast10",
    "s": "/d/silvere/rooms/palace/paleast10",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "This room is undecided. Here could be a stairway up to a tower or some "
    "other rooms, if that becomes necessary.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "room" || str == "here";
}
