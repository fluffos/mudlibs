/*
 * West-wing south-turn — west of palwest4.
 *
 * Strategy A FluffOS room. Original (south palwest7)
 * is palwest6_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “from south to east” / “entrance
 * leading to the south” / “glance at you. The
 * walls” / “podestal”. South palwest7 is not
 * loaded this slice. East palwest4 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/palace/palwest4",
    "e": "/d/silvere/rooms/palace/palwest4",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads from south to east. To the east is also an "
    "entrance leading to the south. Ceremonial guards are standing at "
    "the walls and seems to glance at you. The walls are full with "
    "tapestries and such stuff and every now and then there is a "
    "decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
