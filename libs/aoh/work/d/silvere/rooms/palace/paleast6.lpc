/*
 * East-wing south-turn — east of paleast4.
 *
 * Strategy A FluffOS room. Original (south paleast7)
 * is paleast6_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “from south to west” / “entrance
 * leading to the south” / “glance at you. The
 * walls” / “podestal”. South paleast7 look-ats are
 * loaded this slice (paleast8 not wired). West
 * paleast4 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/palace/paleast4",
    "w": "/d/silvere/rooms/palace/paleast4",
    "south": "/d/silvere/rooms/palace/paleast7",
    "s": "/d/silvere/rooms/palace/paleast7",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads from south to west. To the west is also an "
    "entrance leading to the south. Ceremonial guards are standing at "
    "the walls and seems to glance at you. The walls are full with "
    "tapestries and such stuff and every now and then there is a "
    "decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
