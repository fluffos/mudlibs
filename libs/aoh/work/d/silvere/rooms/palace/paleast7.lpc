/*
 * East-wing north-south hall — south of paleast6.
 *
 * Strategy A FluffOS room. Original (south paleast8)
 * is paleast7_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “from north to south through this
 * part of the palace” / “glance at you. The walls”
 * / “podestal”. South paleast8 is not loaded this
 * slice. North paleast6 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/palace/paleast6",
    "n": "/d/silvere/rooms/palace/paleast6",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads from north to south through this part of the "
    "palace. Ceremonial guards are standing at the walls and seems to "
    "glance at you. The walls are full with tapestries and such stuff "
    "and every now and then there is a decorative item placed on a small "
    "podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
