/*
 * West-wing fork — north of palwest2.
 *
 * Strategy A FluffOS room. Original (west palwest4,
 * north palnorth5) is palwest3_ldmud.lpc. Archive
 * stub: no AddDetail. Archive keeps “glare at you”
 * and “pedestal”. West palwest4 and north palnorth5
 * are not loaded this slice. South palwest2 is
 * loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/palace/palwest2",
    "s": "/d/silvere/rooms/palace/palwest2",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads here from north to south. There is also another "
    "way to the west. Ceremonial guards are standing at the wall and seems "
    "to glare at you. The walls are full with tapestries and such stuff "
    "and every now and then there is a decorative item, placed on a small "
    "pedestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
