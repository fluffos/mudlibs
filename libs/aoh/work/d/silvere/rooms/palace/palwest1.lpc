/*
 * West-wing hall — west of palenter.
 *
 * Strategy A FluffOS room. Original (west palwest2) is
 * palwest1_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “seems to glance” and “podestal”.
 * West palwest2 look-ats are loaded this slice
 * (pal*3+ not wired). East palenter is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/palace/palenter",
    "e": "/d/silvere/rooms/palace/palenter",
    "west": "/d/silvere/rooms/palace/palwest2",
    "w": "/d/silvere/rooms/palace/palwest2",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "This is a high passage in the palace leading from east to west. "
    "Ceremonial guards are standing at the walls and seems to glance at "
    "you. The walls are full with tapestries and such stuff and every "
    "now and then there is a decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
