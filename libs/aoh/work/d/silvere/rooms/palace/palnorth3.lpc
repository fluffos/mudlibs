/*
 * North-palace hall — west of palnorth2.
 *
 * Strategy A FluffOS room. Original (west palnorth4)
 * is palnorth3_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “valuable to them”. West palnorth4
 * is not loaded this slice. East palnorth2 is
 * loaded. Private rooms / throneroom not wired.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/palace/palnorth2",
    "e": "/d/silvere/rooms/palace/palnorth2",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage continues from east to west. Two guards are standing "
    "to the left and right of it, protecting the room against unwanted "
    "guests. Ceremonial guards are standing here at the wall and look in "
    "full attention at you, just as they have to protect something very "
    "valuable to them.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
