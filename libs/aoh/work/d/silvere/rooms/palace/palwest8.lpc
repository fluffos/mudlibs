/*
 * West-wing north-south hall — south of palwest7,
 * north of palwest9. Closes the west-wing loop.
 *
 * Strategy A FluffOS room. Original is
 * palwest8_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “from north to south through this
 * part of the palace” / “glance at you. The walls”
 * / “podestal”. North palwest7 and south palwest9
 * are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/palace/palwest7",
    "n": "/d/silvere/rooms/palace/palwest7",
    "south": "/d/silvere/rooms/palace/palwest9",
    "s": "/d/silvere/rooms/palace/palwest9",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads from north to south through this part of the "
    "palace. Ceremonial guards are standing at the walls and seems to "
    "glance at you. The walls are full with tapestries and such stuff "
    "and every now and then there is a decorative item placed on a small "
    "podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
