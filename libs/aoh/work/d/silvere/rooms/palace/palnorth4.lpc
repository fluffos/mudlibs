/*
 * North-palace hall — west of palnorth3.
 *
 * Strategy A FluffOS room. Original (west palnorth5,
 * south private2 door) is palnorth4_ldmud.lpc.
 * Archive keeps “private rooms of the Lu'meyn” /
 * “valuable to them”. Door look-ats only — south
 * private2 is not loaded. West palnorth5 look-ats
 * are loaded this slice. East palnorth3 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/palace/palnorth3",
    "e": "/d/silvere/rooms/palace/palnorth3",
    "west": "/d/silvere/rooms/palace/palnorth5",
    "w": "/d/silvere/rooms/palace/palnorth5",
  ]);
  extras = ([
    "door":
      "This is a wooden door, that leads to the south. "
      "On the door are some intricate carvings, laid in "
      "with gold and silver. Guards are standing to the "
      "left and right of it, their spears readied. They "
      "are watching you closely.\n",
    "wooden door":
      "This is a wooden door, that leads to the south. "
      "On the door are some intricate carvings, laid in "
      "with gold and silver. Guards are standing to the "
      "left and right of it, their spears readied. They "
      "are watching you closely.\n",
    "carving":
      "The carvings can be found on the door. They are just "
      "some patterns in the door, that are laid in with gold "
      "and silver. It looks very nice.\n",
    "carvings":
      "The carvings can be found on the door. They are just "
      "some patterns in the door, that are laid in with gold "
      "and silver. It looks very nice.\n",
    "intricate carvings":
      "The carvings can be found on the door. They are just "
      "some patterns in the door, that are laid in with gold "
      "and silver. It looks very nice.\n",
    "gold":
      "No, you can't take that.\n",
    "silver":
      "No, you can't take that.\n",
    "pattern":
      "The pattern is carved into the door. The carvings "
      "was then filled again with some gold and silver.\n",
    "patterns":
      "The pattern is carved into the door. The carvings "
      "was then filled again with some gold and silver.\n",
  ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage continues from east to west. A door leads here to the "
    "south into the private rooms of the Lu'meyn. Two guards are standing "
    "to the left and right of it, protecting the room against unwanted "
    "guests. Ceremonial guards are standing here at the wall and look in "
    "full attention at you, just as they have to protect something very "
    "valuable to them.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
