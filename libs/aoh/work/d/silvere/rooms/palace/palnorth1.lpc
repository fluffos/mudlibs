/*
 * North-palace hall — north of paleast3.
 *
 * Strategy A FluffOS room. Original (west palnorth2)
 * is palnorth1_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “two doors, leading there” / “The
 * guards clothes” / “full attention”. West palnorth2
 * look-ats are loaded this slice. South paleast3 is
 * loaded. Private rooms / throneroom not wired.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/palace/paleast3",
    "s": "/d/silvere/rooms/palace/paleast3",
    "west": "/d/silvere/rooms/palace/palnorth2",
    "w": "/d/silvere/rooms/palace/palnorth2",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads in from the south and continues to the west. There "
    "you see two doors, leading there through the southern wall. Ceremonial "
    "guards are standing here at the wall and look in full attention at you, "
    "just as they have to protect something very valuable. The guards clothes "
    "is also slightly changed from the guards to the south. To the south is "
    "a small crossing, where another passage leads in from the east.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
