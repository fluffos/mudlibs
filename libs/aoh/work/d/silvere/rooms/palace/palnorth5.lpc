/*
 * North-palace west corner — west of palnorth4.
 * Closes the north hall onto palwest3.
 *
 * Strategy A FluffOS room. Original is
 * palnorth5_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “from east to south” / “valuable
 * to them”. East palnorth4 and south palwest3
 * are loaded. Private rooms / throneroom not
 * wired.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/palace/palnorth4",
    "e": "/d/silvere/rooms/palace/palnorth4",
    "south": "/d/silvere/rooms/palace/palwest3",
    "s": "/d/silvere/rooms/palace/palwest3",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage continues from east to south. Two guards are standing "
    "to the left and right of it, protecting the room against unwanted "
    "guests. Ceremonial guards are standing here at the wall and look in "
    "full attention at you, just as they have to protect something very "
    "valuable to them.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
