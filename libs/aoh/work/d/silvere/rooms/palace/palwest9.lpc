/*
 * West-wing southwest corner — west of palwest10.
 *
 * Strategy A FluffOS room. Original (north palwest8)
 * is palwest9_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “continues to the east” / “Some
 * ceremonial guards” / “podestal”. North palwest8
 * is not loaded this slice. East palwest10 is
 * loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/palace/palwest10",
    "e": "/d/silvere/rooms/palace/palwest10",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads in from north and continues to the east. Some "
    "ceremonial guards are standing at the walls and seems to glance at "
    "you. The walls are full with tapestries and such stuff and every now "
    "and then there is a decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
