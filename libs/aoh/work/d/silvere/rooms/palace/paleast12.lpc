/*
 * East-wing south corner — south of paleast13.
 *
 * Strategy A FluffOS room. Original (east paleast10)
 * is paleast12_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “continues east” / “glance at you.
 * The walls” / “podestal”. East paleast10 look-ats
 * are loaded this slice (paleast9 / paleast11 not
 * wired). North paleast13 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/palace/paleast13",
    "n": "/d/silvere/rooms/palace/paleast13",
    "east": "/d/silvere/rooms/palace/paleast10",
    "e": "/d/silvere/rooms/palace/paleast10",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads in from north and continues east. Ceremonial "
    "guards are standing at the walls and seems to glance at you. The "
    "walls are full with tapestries and such stuff and every now and "
    "then there is a decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
