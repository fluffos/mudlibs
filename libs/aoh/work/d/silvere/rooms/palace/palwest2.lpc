/*
 * West-wing crossing — west of palwest1.
 *
 * Strategy A FluffOS room. Original (north palwest3,
 * south palwest13) is palwest2_ldmud.lpc. Archive
 * stub: no AddDetail. Archive keeps “seems to glance
 * at you.The walls” and “podestal”. North palwest3
 * and south palwest13 look-ats are loaded this
 * slice (palnorth / palwest4 / palwest12 not wired).
 * East palwest1 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/palace/palwest1",
    "e": "/d/silvere/rooms/palace/palwest1",
    "north": "/d/silvere/rooms/palace/palwest3",
    "n": "/d/silvere/rooms/palace/palwest3",
    "south": "/d/silvere/rooms/palace/palwest13",
    "s": "/d/silvere/rooms/palace/palwest13",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads in from the east and continues to the north and "
    "south. Ceremonial guards are standing at the walls and seems to glance "
    "at you.The walls are full with tapestries and such stuff and every now "
    "and then there is a decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east, north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
