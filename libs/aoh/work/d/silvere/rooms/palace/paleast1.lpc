/*
 * East-wing hall — east of palenter.
 *
 * Strategy A FluffOS room. Original (east paleast2) is
 * paleast1_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “seems to glance”, “you.The walls”,
 * and “podestal”. East paleast2 look-ats are loaded
 * this slice (pal*3+ not wired). West palenter is
 * loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/palace/palenter",
    "w": "/d/silvere/rooms/palace/palenter",
    "east": "/d/silvere/rooms/palace/paleast2",
    "e": "/d/silvere/rooms/palace/paleast2",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "This is a high passage in the palace leading from east to west. "
    "Ceremonial guards are standing at the walls and seems to glance at "
    "you.The walls are full with tapestries and such stuff and every now "
    "and then there is a decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
