/*
 * A hall in the palace — north of palplace5.
 *
 * Strategy A FluffOS room. Original (enter throneroom /
 * leave palace, north throneroom, east paleast1, west
 * palwest1) is palenter_ldmud.lpc. Archive stub: no
 * AddDetail. enter / leave and throneroom / pal*2+
 * are not wired this slice. South palplace5 and
 * east/west paleast1 / palwest1 hall stubs are loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/center/palplace5",
    "s": "/d/silvere/rooms/center/palplace5",
    "east": "/d/silvere/rooms/palace/paleast1",
    "e": "/d/silvere/rooms/palace/paleast1",
    "west": "/d/silvere/rooms/palace/palwest1",
    "w": "/d/silvere/rooms/palace/palwest1",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "This is a large hall in the palace. To the north are doors, leading "
    "into the throneroom. To the east and west are archways leading to the "
    "east and west wing of the building. To the south is the exit, where "
    "the palace can be left.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south, east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "palace" || str == "here";
}
