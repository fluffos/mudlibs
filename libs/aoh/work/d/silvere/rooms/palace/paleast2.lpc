/*
 * East-wing crossing — east of paleast1.
 *
 * Strategy A FluffOS room. Original (north paleast3,
 * south paleast13) is paleast2_ldmud.lpc. Archive
 * stub: no AddDetail. Archive keeps “seems to glance
 *  at you.The walls” and “podestal”. North/south
 * pal*3+ are not loaded this slice. West paleast1
 * is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/palace/paleast1",
    "w": "/d/silvere/rooms/palace/paleast1",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads in from the west and continues to the north and "
    "south. Ceremonial guards are standing at the walls and seems to glance "
    " at you.The walls are full with tapestries and such stuff and every now "
    "and then there is a decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
