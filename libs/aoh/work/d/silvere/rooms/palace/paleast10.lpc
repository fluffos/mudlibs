/*
 * East-wing mid-south hall — east of paleast12.
 *
 * Strategy A FluffOS room. Original (north paleast11,
 * east paleast9) is paleast10_ldmud.lpc. Archive
 * stub: no AddDetail. Archive keeps “leads here
 * from east to west” / “glance at you. The walls”
 * / “podestal”. East paleast9 and north paleast11
 * look-ats are loaded this slice. West paleast12
 * is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/palace/paleast12",
    "w": "/d/silvere/rooms/palace/paleast12",
    "east": "/d/silvere/rooms/palace/paleast9",
    "e": "/d/silvere/rooms/palace/paleast9",
    "north": "/d/silvere/rooms/palace/paleast11",
    "n": "/d/silvere/rooms/palace/paleast11",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads here from east to west. Ceremonial guards are "
    "standing at the walls and seems to glance at you. The walls are full "
    "with tapestries and such stuff and every now and then there is a "
    "decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west, east and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
