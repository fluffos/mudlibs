/*
 * West-wing south corner — south of palwest13.
 *
 * Strategy A FluffOS room. Original (west palwest10)
 * is palwest12_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “continues west” / “glance at you.
 * The walls” / “podestal”. West palwest10 is not
 * loaded this slice. North palwest13 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/palace/palwest13",
    "n": "/d/silvere/rooms/palace/palwest13",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads in from north and continues west. Ceremonial "
    "guards are standing at the walls and seems to glance at you. The "
    "walls are full with tapestries and such stuff and every now and "
    "then there is a decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
