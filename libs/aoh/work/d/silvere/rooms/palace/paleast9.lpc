/*
 * East-wing southeast corner — east of paleast10.
 *
 * Strategy A FluffOS room. Original (north paleast8)
 * is paleast9_ldmud.lpc. Archive stub: no AddDetail.
 * Archive keeps “continues to the west” / “Some
 * ceremonial guards” / “podestal”. North paleast8
 * is not loaded this slice. West paleast10 is
 * loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/palace/paleast10",
    "w": "/d/silvere/rooms/palace/paleast10",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads in from north and continues to the west. Some "
    "ceremonial guards are standing at the walls and seems to glance at "
    "you. The walls are full with tapestries and such stuff and every now "
    "and then there is a decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
