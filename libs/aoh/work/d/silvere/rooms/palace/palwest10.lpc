/*
 * West-wing mid-south hall — west of palwest12.
 *
 * Strategy A FluffOS room. Original (north palwest11,
 * west palwest9) is palwest10_ldmud.lpc. Archive
 * stub: no AddDetail. Archive keeps “leads here
 * from east to west” / “glance at you. The walls”
 * / “podestal”. North palwest11 and west palwest9
 * are not loaded this slice. East palwest12 is
 * loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/palace/palwest12",
    "e": "/d/silvere/rooms/palace/palwest12",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads here from east to west. Ceremonial guards are "
    "standing at the walls and seems to glance at you. The walls are full "
    "with tapestries and such stuff and every now and then there is a "
    "decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
