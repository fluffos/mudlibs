/*
 * West-wing south-door hall — west of palwest3.
 *
 * Strategy A FluffOS room. Original (west palwest6,
 * south palwest5) is palwest4_ldmud.lpc. Archive
 * stub: no AddDetail. Archive keeps “southern wall”
 * / “glance at you.The walls” / “podestal”. West
 * palwest6 and south palwest5 are not loaded this
 * slice. East palwest3 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/palace/palwest3",
    "e": "/d/silvere/rooms/palace/palwest3",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads from east to west. In the southern wall is the "
    "entrance to a large room. Ceremonial guards are standing at the walls "
    "and seems to glance at you.The walls are full with tapestries and such "
    "stuff and every now and then there is a decorative item placed on a "
    "small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
