/*
 * East-wing fork — north of paleast2.
 *
 * Strategy A FluffOS room. Original (east paleast4,
 * north palnorth1) is paleast3_ldmud.lpc. Archive
 * stub: no AddDetail. Archive keeps “glance  at
 * you.The walls” and “podestal”. East paleast4
 * look-ats are loaded this slice (palnorth /
 * paleast5 / paleast6 not wired). South paleast2
 * is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/palace/paleast2",
    "s": "/d/silvere/rooms/palace/paleast2",
    "east": "/d/silvere/rooms/palace/paleast4",
    "e": "/d/silvere/rooms/palace/paleast4",
  ]);
  extras = ([ ]);
}

string query_short() { return "A hall in the palace"; }

string query_long() {
  return
    "A high passage leads from north to south. There is also another way to "
    "the east. Ceremonial guards are standing at the walls and seems to glance "
    " at you.The walls are full with tapestries and such stuff and every now "
    "and then there is a decorative item placed on a small podestal.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "passage" || str == "here";
}
