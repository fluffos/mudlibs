/*
 * Templeroad — north of templeroad1.
 *
 * Strategy A FluffOS room. Original (east templeroad3)
 * is templeroad2_ldmud.lpc. Archive stub: no AddDetail.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/templeroad1",
    "s": "/d/silvere/rooms/west/templeroad1",
    "east": "/d/silvere/rooms/west/templeroad3",
    "e": "/d/silvere/rooms/west/templeroad3",
  ]);
  extras = ([ ]);
}

string query_short() { return "Templeroad"; }

string query_long() {
  return
    "This is a small road, that leads in from the south and continues "
    "east toward the temple of Xalandre.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
