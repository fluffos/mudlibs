/*
 * Templeroad — north of westroad2.
 *
 * Strategy A FluffOS room. Original (north templeroad2)
 * is templeroad1_ldmud.lpc. Look at path/road is flavour.
 * Further temple interiors are not loaded from here.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/westroad2",
    "s": "/d/silvere/rooms/west/westroad2",
    "north": "/d/silvere/rooms/west/templeroad2",
    "n": "/d/silvere/rooms/west/templeroad2",
  ]);
  extras = ([
    "road":
      "The dirt path winds charmingly to the north.  Although it is not "
      "very large, it seems to have been worn smooth by the passage of "
      "many feet.\n",
    "path":
      "The dirt path winds charmingly to the north.  Although it is not "
      "very large, it seems to have been worn smooth by the passage of "
      "many feet.\n",
  ]);
}

string query_short() { return "Templeroad"; }

string query_long() {
  return
    "A small but well-worn path leads north towards the Temple of Xalandre. "
    "Xalandre is the goddess of the sea, and the patron goddess of "
    "Silvere.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "path" || str == "here";
}
