/*
 * Molly's Chandler — north of westroad3.
 *
 * Strategy A FluffOS room. Original /std/shop (candles, trade)
 * is chandler_ldmud.lpc. Look at candles/sign is flavour;
 * buy is not implemented this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/westroad3",
    "s": "/d/silvere/rooms/west/westroad3",
    "out": "/d/silvere/rooms/west/westroad3",
  ]);
  extras = ([
    "candles":
      "Freshly dipped candles are everywhere.\n",
    "tapers":
      "Freshly dipped candles are everywhere.\n",
    "candle":
      "Freshly dipped candles are everywhere.\n",
    "sign":
      "A rough signboard reads: \n"
      " ~ Molly's Chandler ~ \n"
      "Original hand-dipped candles for all prices and tastes.\n",
    "shelves":
      "Stacks of candles crowd every shelf.\n",
    "wax":
      "Fragrant fresh wax and other scents.\n",
  ]);
}

string query_short() { return "Molly's Chandler"; }

string query_long() {
  return
    "The interior of this small shop is quite cramped, as stacks "
    "and stacks of candles are piled up in heaps, in corners, on "
    "shelves, hanging from rafters, and every imaginable space. The "
    "shop smells sweetly of fresh wax and other fragrant scents.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "shop" || str == "chandler" || str == "here"; }
