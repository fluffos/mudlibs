/*
 * Westway council/tailor intersection — east of westroad6.
 *
 * Strategy A FluffOS room. Original (TimeMsg, north council,
 * south tailor, east westroad8) is westroad7_ldmud.lpc.
 * Council hall, tailor interior, and westroad8 are not
 * loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westroad6",
    "w": "/d/silvere/rooms/west/westroad6",
  ]);
  extras = ([
    "sign":
      "The sign shows a picture of a needle and thread. "
      "Something is written beneath it: Couture Celimarith.\n",
    "flagstones":
      "The streets here in the centre of the city are paved "
      "with large flagstones, which are swept every day by city "
      "workers.\n",
    "flagstone":
      "The streets here in the centre of the city are paved "
      "with large flagstones, which are swept every day by city "
      "workers.\n",
    "shop":
      "This small house is painted in a light, pastel orange "
      "hue. The door is bright red, with a sign above it.\n",
    "door":
      "The door to the tailor's shop has been painted bright red. "
      "A sign is hanging above it.\n",
    "entrance":
      "The door to the tailor's shop has been painted bright red. "
      "A sign is hanging above it.\n",
    "road":
      "Elrimand Road starts north of you and leads to the council hall. "
      "Like Westway, it is paved with large flagstones.\n",
    "hall":
      "You can't see it from here.\n",
  ]);
}

string query_short() { return "Westway. A street leads north to the council hall"; }

string query_long() {
  return
    "You have reached another intersection. To the north starts Elrimand Road. "
    "Elrimand was the founder and first Lu'meyn of Silvere. The street that bears "
    "his name runs to the council hall. South of you is the entrance to a small "
    "tailor's shop. The streets are quite crowded with people going about their "
    "daily business. The shops are open, and the city is brimming with life.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "westway" || str == "road" || str == "here"; }
