/*
 * Counting House of Aberfynne — east of wpostroad2.
 *
 * Strategy A FluffOS room. Original (teller, leave bank)
 * is wbank_ldmud.lpc. Look at sign/panelling is flavour;
 * deposit/withdraw are not implemented this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/wpostroad2",
    "w": "/d/silvere/rooms/west/wpostroad2",
    "out": "/d/silvere/rooms/west/wpostroad2",
  ]);
  extras = ([
    "sign":
      "A small but discreet sign directs potential clients to the "
      "New Accounts window, located in the ante-room to the east.\n",
    "panelling":
      "The fine decor and polished wooden panelling definitely exudes "
      "a sense of wealth and refined taste.\n",
    "paneling":
      "The fine decor and polished wooden panelling definitely exudes "
      "a sense of wealth and refined taste.\n",
    "decor":
      "The fine decor and polished wooden panelling definitely exudes "
      "a sense of wealth and refined taste.\n",
    "window":
      "Existing customers should proceed directly to the transactions "
      "window. New accounts are handled in the ante-room to the east.\n",
    "guard":
      "A not so small and far less discreet guard directs potential "
      "troublemakers and the more unsavory breeds to the nearest exit.\n",
  ]);
}

string query_short() { return "The bank of Silvere"; }

string query_long() {
  return
    "The fine decor and polished wooden panelling definitely exudes "
    "a sense of wealth and refined taste. The merchants "
    "and wealthy born of Silvere have entrusted their funds to the "
    "Counting House of Aberfynne for centuries, having the utmost "
    "faith in their financial abilities. "
    "A small but discreet sign directs potential clients to the "
    "New Accounts window, located in the ante-room to the east. "
    "Existing customers should proceed directly to "
    "the transactions window.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "bank" || str == "house" || str == "here"; }
