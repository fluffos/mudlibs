/*
 * Xalandre wedding-chapel stub — north of xal_temple.
 *
 * Strategy A FluffOS room. Original (south xal_temple)
 * is xal_chapel_ldmud.lpc. Archive stub: no AddDetail.
 * pray / leave temple are not loaded. South
 * xal_temple look-ats are loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/xal_temple",
    "s": "/d/silvere/rooms/west/xal_temple",
  ]);
  extras = ([ ]);
}

string query_short() { return "Xalandre's Chapel"; }

string query_long() {
  return
    "The temple of Xalandre, northern part. Weddings take place "
    "here.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "chapel" || str == "temple" || str == "here";
}
