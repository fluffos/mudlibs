/*
 * Elrimand Road — north of councilroad1.
 *
 * Strategy A FluffOS room. Original (TimeMsg, east
 * councilroad3) is councilroad2_ldmud.lpc. Look at
 * houses / flagstones / coat of arms is flavour.
 * Day TimeMsg is inlined; night/sunrise variants
 * are not loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/councilroad1",
    "s": "/d/silvere/rooms/west/councilroad1",
    "east": "/d/silvere/rooms/west/councilroad3",
    "e": "/d/silvere/rooms/west/councilroad3",
  ]);
  extras = ([
    "street":
      "Elrimand Road is a broad street paved with flagstones. "
      "To live here, you'd have to have lots of money or influence, "
      "presumably both. Everything looks neat and clean, and guards "
      "are frequently patrolling the street to prevent any trouble.\n",
    "road":
      "Elrimand Road is a broad street paved with flagstones. "
      "To live here, you'd have to have lots of money or influence, "
      "presumably both. Everything looks neat and clean, and guards "
      "are frequently patrolling the street to prevent any trouble.\n",
    "elrimand road":
      "Elrimand Road is a broad street paved with flagstones. "
      "To live here, you'd have to have lots of money or influence, "
      "presumably both. Everything looks neat and clean, and guards "
      "are frequently patrolling the street to prevent any trouble.\n",
    "stones":
      "They are quite smooth and very clean. City workers sweep "
      "them every day.\n",
    "flagstones":
      "They are quite smooth and very clean. City workers sweep "
      "them every day.\n",
    "westway":
      "Follow Elrimand Road south and you'll get there.\n",
    "hall":
      "You're still too far away to see anything.\n",
    "council hall":
      "You're still too far away to see anything.\n",
    "guards":
      "They are patrolling the street. Better don't make any "
      "trouble, they really look tough.\n",
    "houses":
      "The houses along Elrimand Road obviously belong to the upper "
      "crust of Silvere. They are painted in lively colours and "
      "decorated fancifully, although with a tad more elegance than "
      "the ones along Westway. Some of them even have a coat of arms "
      "above the entrance, indicating that someone really important "
      "lives here.\n",
    "residences":
      "The houses along Elrimand Road obviously belong to the upper "
      "crust of Silvere. They are painted in lively colours and "
      "decorated fancifully, although with a tad more elegance than "
      "the ones along Westway. Some of them even have a coat of arms "
      "above the entrance, indicating that someone really important "
      "lives here.\n",
    "colours":
      "The houses are painted brightly, but somewhat less garishly "
      "than some of those along Westway.\n",
    "lively colours":
      "The houses are painted brightly, but somewhat less garishly "
      "than some of those along Westway.\n",
    "arms":
      "Shields bearing house emblems have been fixed above the "
      "entrance of some houses.\n",
    "coat of arms":
      "Shields bearing house emblems have been fixed above the "
      "entrance of some houses.\n",
    "shields":
      "Shields bearing house emblems have been fixed above the "
      "entrance of some houses.\n",
    "emblems":
      "Shields bearing house emblems have been fixed above the "
      "entrance of some houses.\n",
    "entrance":
      "The entrances leading into the houses look sturdy and well "
      "protected. Some of them are decorated with emblems of noble "
      "houses of Silvere.\n",
    "entrances":
      "The entrances leading into the houses look sturdy and well "
      "protected. Some of them are decorated with emblems of noble "
      "houses of Silvere.\n",
  ]);
}

string query_short() { return "Elrimand Road"; }

string query_long() {
  return
    "The street bends here, leading south towards Westway and east to the "
    "council hall. The houses left and right of you seem to be the residences "
    "of wealthy citizens. Although it is day, this part of the street is "
    "rather quiet, compared to the bustle of activity further south.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "elrimand" || str == "here";
}
