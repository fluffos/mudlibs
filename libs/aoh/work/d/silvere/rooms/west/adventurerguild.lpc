/*
 * Adventurers Guild entrance — east of libraryroad1.
 *
 * Strategy A FluffOS room. Original (leave guild
 * command) is adventurerguild_ldmud.lpc. Archive stub:
 * no AddDetail. leave guild is not wired this
 * slice. Archive keeps the short “The Adventurers
 * Guild” and the unfinished-guild long.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/libraryroad1",
    "w": "/d/silvere/rooms/west/libraryroad1",
  ]);
  extras = ([ ]);
}

string query_short() { return "The Adventurers Guild"; }

string query_long() {
  return
    "This is the entrance to the adventurers guild. To the west you can "
    "leave the building to the library road.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "guild" || str == "entrance" || str == "here";
}
