/*
 * Guild Street / library road — south of westroad9.
 *
 * Strategy A FluffOS room. Original (enter guild) is
 * libraryroad1_ldmud.lpc. East opens the adventurers
 * guild entrance stub. enter guild is not wired.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/westroad9",
    "n": "/d/silvere/rooms/west/westroad9",
    "west": "/d/silvere/rooms/west/libraryroad2",
    "w": "/d/silvere/rooms/west/libraryroad2",
    "east": "/d/silvere/rooms/west/adventurerguild",
    "e": "/d/silvere/rooms/west/adventurerguild",
  ]);
  extras = ([
    "guild":
      "You can enter the adventurers guild to the east, as soon "
      "as it is finished.\n",
    "library":
      "This road leads from the mainroad at the north to the library at "
      "the west.\n",
    "road":
      "This road leads from the mainroad at the north to the library at "
      "the west. You can enter the adventurers guild to the east, as soon "
      "as it is finished.\n",
  ]);
}

string query_short() { return "Library road"; }

string query_long() {
  return
    "This road leads from the mainroad at the north to the library at "
    "the west. You can enter the adventurers guild to the east, as soon "
    "as it is finished.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north, west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "street" || str == "here"; }
