/*
 * Alley south of Westway flowerbed.
 *
 * Strategy A FluffOS room. Original (pigeons, TimeMsg) is
 * westshop1_ldmud.lpc. South continues to westshop2 and
 * the sell-only shop. The smith is not loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/westroad4",
    "n": "/d/silvere/rooms/west/westroad4",
    "out": "/d/silvere/rooms/west/westroad4",
    "south": "/d/silvere/rooms/west/westshop2",
    "s": "/d/silvere/rooms/west/westshop2",
  ]);
  extras = ([
    "sign":
      "The grey board, warped and weathered, "
      "was evidently hung up at some time now long "
      "past. Green, crooked letters, painstakingly "
      "hand-painted, spell out: \n\n"
      "                   SHOPPE THATT WAY -> \n",
    "pigeons":
      "They bob and peck at one another incessantly.\n",
    "pigeon":
      "They bob and peck at one another incessantly.\n",
    "houses":
      "The faded fascades, constructed of wood and plaster, "
      "wattle and daub, have without a doubt seen better days.\n",
    "buildings":
      "The faded fascades, constructed of wood and plaster, "
      "wattle and daub, have without a doubt seen better days.\n",
  ]);
}

string query_short() { return "small road"; }

string query_long() {
  return
    "The storefront fascades along this lane seem to be not "
    "so well cared for as the more imposing buildings up in "
    "the main street. "
    "Pigeons roost among the exposed beams of the houses, "
    "cooing and dropping their distinctive greeting cards "
    "along the walls. A smaller lane disappers "
    "eastwards into a mass of crooked old cottages. A badly "
    "painted sign hangs lopsidedly on the side of one of the "
    "nearby buildings.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "alley" || str == "lane" || str == "here"; }
