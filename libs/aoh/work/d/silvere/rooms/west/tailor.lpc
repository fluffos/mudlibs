/*
 * Couture Celimarith — south of westroad7.
 *
 * Strategy A FluffOS room. Original /std/shop (custom clothes)
 * is tailor_ldmud.lpc. Look at cloth/dummy/sign is flavour;
 * buy is not implemented this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/westroad7",
    "n": "/d/silvere/rooms/west/westroad7",
    "out": "/d/silvere/rooms/west/westroad7",
  ]);
  extras = ([
    "cloth":
      "Fine silks, damask, linens, and heavy brocades "
      "dazzle the eyes and challenge the pocketbook.\n",
    "dummy":
      "A dressmaker's dummy stands in one corner.\n",
    "sign":
      "A painted signboard reads: \n"
      "   Tailor       \n"
      "All manner of clothes finished to your specification.\n",
    "shelves":
      "Bolts of fine cloth lay stacked upon painted shelves.\n",
    "bolts":
      "Bolts of fine cloth lay stacked upon painted shelves.\n",
  ]);
}

string query_short() { return "a tailor shop"; }

string query_long() {
  return
    "A tailor. She creates fine clothes, tailored to your "
    "specifications. Bolts of fine cloth lay stacked upon painted "
    "shelves. A dressmaker's dummy stands in one corner.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "shop" || str == "tailor" || str == "here"; }
