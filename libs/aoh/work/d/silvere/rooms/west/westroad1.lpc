/*
 * The Westway — east of the city-side harbour gate.
 *
 * Strategy A FluffOS room. Original (lift flagstone, platinum)
 * is westroad1_ldmud.lpc. westroad3 / healer interior / elder
 * office are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/harbourgate",
    "w": "/d/silvere/rooms/west/harbourgate",
    "east": "/d/silvere/rooms/west/westroad2",
    "e": "/d/silvere/rooms/west/westroad2",
    "north": "/d/silvere/rooms/west/whealer1",
    "n": "/d/silvere/rooms/west/whealer1",
    "south": "/d/silvere/rooms/west/cityinfo1",
    "s": "/d/silvere/rooms/west/cityinfo1",
  ]);
  extras = ([
    "flagstones":
      "Grey, smooth rectangular paving stones cover the Westway, "
      "protecting feet and cart wheels from thick mud during the "
      "rainy season. One of the stones near your feet is cracked "
      "and seems to be a bit loose.\n",
    "stone":
      "One of the flagstones is loose, and with a bit of effort, "
      "it might be possible to lift it up.\n",
    "shops":
      "Some of the finest and most expensive shops in the realm can be "
      "found along the Westway.\n",
    "houses":
      "Well-kept houses of rich merchants line the road.\n",
    "gates":
      "Directly to the west are the imposing great gates of the city.\n",
  ]);
}

string query_short() { return "The Westway"; }

string query_long() {
  return
    "This is the regal Westway of Silvere, paved with great grey "
    "flagstones, lit at night, and lined with shops and the "
    "well-kept houses of rich merchants. "
    "The road is kept clean and in good repair, for it is the main "
    "causeway into the city, wending its way eastward to the very "
    "steps of the palace. "
    "Directly to the west are the imposing great gates of the city. "
    "A small alley opens to the north, and a larger road leads off "
    "to the south.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west, east, north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "westway" || str == "road" || str == "here"; }
