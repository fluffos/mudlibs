/*
 * Library entrance — west of libraryroad2.
 *
 * Strategy A FluffOS room. Original (leave library
 * command) is libraryenter_ldmud.lpc. Archive stub:
 * no AddDetail. leave library is not wired this
 * slice. Archive keeps the short “The Adventurers
 * Guild” on a library-entrance long.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/west/libraryroad2",
    "e": "/d/silvere/rooms/west/libraryroad2",
  ]);
  extras = ([ ]);
}

string query_short() { return "The Adventurers Guild"; }

string query_long() {
  return
    "This is the entrance to the library. To the east you can leave the "
    "building to the library road.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "library" || str == "entrance" || str == "here";
}
