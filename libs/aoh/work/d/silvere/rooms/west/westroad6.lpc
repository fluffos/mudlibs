/*
 * Westway fishmonger front — east of westroad5.
 *
 * Strategy A FluffOS room. Original (TimeMsg, north fishmonger)
 * is westroad6_ldmud.lpc. The fishmonger interior and westroad7
 * are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westroad5",
    "w": "/d/silvere/rooms/west/westroad5",
  ]);
  extras = ([
    "shop":
      "The shop north of you has been decorated with nets, fishing rods and "
      "other fisherman's tools of trade. A distinct smell of fish emanates "
      "from there. A sign hangs above the door.\n",
    "sign":
      "Above the door, you see s square wooden sign which has been painted "
      "with the picture of a salmon.\n",
    "nets":
      "The nets contain some dried starfish, which "
      "seem to be real ones, as well as carved wooden fishes which have been "
      " painted in lifelike colours.\n",
    "net":
      "The nets contain some dried starfish, which "
      "seem to be real ones, as well as carved wooden fishes which have been "
      " painted in lifelike colours.\n",
    "starfish":
      "Some dried starfish have been tied to the nets for decorations.\n",
    "salmon":
      "A picture of a salmon has been painted on the sign.\n",
  ]);
}

string query_short() { return "Westway. A fishmonger's shop is to the north"; }

string query_long() {
  return
    "A faint but distinctive smell wafts out of the house north of you. You are "
    "standing outside a fishmonger's shop. "
    "All around you, people are going about their "
    "business. Westway is the heart of Silvere, and during daytime the "
    "boulevard is pulsing with life. You can follow Westway "
    "west towards the harbour, or east to the palace.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "westway" || str == "road" || str == "here"; }
