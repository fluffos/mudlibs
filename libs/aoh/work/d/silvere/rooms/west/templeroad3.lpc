/*
 * Templeroad — east of templeroad2, outside the temple.
 *
 * Strategy A FluffOS room. Original (enter temple /
 * east xal_temple) is templeroad3_ldmud.lpc. Look at
 * temple / grass / palms is flavour. East opens
 * xal_temple look-ats this slice. pray / leave
 * temple are not loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/templeroad2",
    "w": "/d/silvere/rooms/west/templeroad2",
    "east": "/d/silvere/rooms/west/xal_temple",
    "e": "/d/silvere/rooms/west/xal_temple",
  ]);
  extras = ([
    "temple":
      "The temple of Xalandre is white and sparkling, and you feel refreshed "
      "just looking at it.\n",
    "grass":
      "The grass is green and lush, and looks delightful to walk on.\n",
    "palm":
      "The palm trees sway gently in the breeze.\n",
    "palms":
      "The palm trees sway gently in the breeze.\n",
    "tree":
      "The palm trees sway gently in the breeze.\n",
    "trees":
      "The palm trees sway gently in the breeze.\n",
    "palm trees":
      "The palm trees sway gently in the breeze.\n",
    "sea":
      "You cannot see the ocean from here, but from its sound and smell, "
      "you know it must be close.\n",
    "ocean":
      "You cannot see the ocean from here, but from its sound and smell, "
      "you know it must be close.\n",
    "road":
      "The dirt path is almost at its end here.\n",
    "path":
      "The dirt path is almost at its end here.\n",
    "wall":
      "The defensive wall is the only thing between the temple and the "
      "beach.\n",
    "city wall":
      "The defensive wall is the only thing between the temple and the "
      "beach.\n",
  ]);
}

string query_short() { return "Templeroad"; }

string query_long() {
  return
    "The small road ends here at the temple of Xalandre. The temple exudes a "
    "feeling of peace and serenity. Its sparkling white walls make a nice "
    "contrast with the vivid green grass that grows around it and the palm "
    "trees that cast a cooling shade on its walls. The entrance to the temple "
    "is to the east.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "temple" || str == "here";
}
