/*
 * Small road before the weaponsmith — east of wsmithroad1.
 *
 * Strategy A FluffOS room. Original (enter shop /
 * south weaponsmith) is wsmithroad2_ldmud.lpc.
 * Archive stub: no AddDetail. enter shop and the
 * weaponsmith are not loaded this slice.
 * Archive keeps “Then entrance”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/wsmithroad1",
    "w": "/d/silvere/rooms/west/wsmithroad1",
  ]);
  extras = ([ ]);
}

string query_short() { return "small road"; }

string query_long() {
  return
    "This is a small road, that ends here before a shop. Then entrance is to "
    "the south. The road leads back to the west.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "shop" || str == "here";
}
