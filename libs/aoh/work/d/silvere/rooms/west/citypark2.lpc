/*
 * Park Lane — south of citypark1.
 *
 * Strategy A FluffOS room. Original (TimeMsg, south
 * cityenter) is citypark2_ldmud.lpc. Day-default
 * TimeMsg is inlined. Archive keeps “thebare”.
 * cityenter / SIL_PARK are not wired this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/citypark1",
    "n": "/d/silvere/rooms/west/citypark1",
  ]);
  extras = ([
    "street":
      "The street is paved with dirty cobblestones, and the houses "
      "around you have seen better days, too.\n",
    "lane":
      "The street is paved with dirty cobblestones, and the houses "
      "around you have seen better days, too.\n",
    "park lane":
      "The street is paved with dirty cobblestones, and the houses "
      "around you have seen better days, too.\n",
    "wall":
      "The city's defensive wall rises to the west of you.\n",
    "city wall":
      "The city's defensive wall rises to the west of you.\n",
    "stones":
      "The stones are cracked and caked with dirt.\n",
    "cobblestones":
      "The stones are cracked and caked with dirt.\n",
    "dirt":
      "Nobody seems to sweep the street here.\n",
    "paint":
      "The paint that used to adorn the houses' fronts has faded "
      "with time. It is peeling off in many places, revealing the"
      "bare bricks beneath.\n",
    "brick":
      "The houses are built from bricks which are visible in places "
      "beneath the peeling paint.\n",
    "bricks":
      "The houses are built from bricks which are visible in places "
      "beneath the peeling paint.\n",
    "houses":
      "While the houses along this street don't look exactly "
      "run-down, they have definitely seen better days. The paint "
      "is peeling off in many places, and dirt accumulates in "
      "almost every corner.\n",
    "house":
      "While the houses along this street don't look exactly "
      "run-down, they have definitely seen better days. The paint "
      "is peeling off in many places, and dirt accumulates in "
      "almost every corner.\n",
    "fronts":
      "While the houses along this street don't look exactly "
      "run-down, they have definitely seen better days. The paint "
      "is peeling off in many places, and dirt accumulates in "
      "almost every corner.\n",
    "westway":
      "You can't see it from here. It's far off to "
      "the north.\n",
    "park":
      "You can see the entrance to the park south of you.\n",
    "city park":
      "You can see the entrance to the park south of you.\n",
    "children":
      "You see some children playing on the street.\n",
    "women":
      "Some women are standing in one of the doors, having "
      "a chat.\n",
  ]);
}

string query_short() { return "Park Lane"; }

string query_long() {
  return
    "You are still strolling along Park Lane, which runs parallel "
    "to the city wall. The chipped cobblestones under your feet and the "
    "peeling paint on the houses' fronts are obvious signs of the lacking "
    "wealth of the local residents. Around you, people are going after their "
    "daily business. Children are playing, and some women are standing "
    "together in one of the doors, chatting. You can follow the street "
    "north towards Westway, or go south to the city park.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "lane" || str == "street" || str == "here"; }
