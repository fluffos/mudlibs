/*
 * Park Lane — south of cityinfo1.
 *
 * Strategy A FluffOS room. Original (TimeMsg) is
 * citypark1_ldmud.lpc. Day-default TimeMsg is inlined.
 * Archive keeps “uneaven”. South citypark2 is loaded.
 * cityenter / SIL_PARK are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/cityinfo1",
    "n": "/d/silvere/rooms/west/cityinfo1",
    "south": "/d/silvere/rooms/west/citypark2",
    "s": "/d/silvere/rooms/west/citypark2",
  ]);
  extras = ([
    "street":
      "Park Lane is a rather narrow street paved with cobblestones. "
      "In this part, it isn't kept as neat and clean as farther north. "
      "Refuse is piling in some of the corners, more or less out of "
      "sight but still noticeable.\n",
    "lane":
      "Park Lane is a rather narrow street paved with cobblestones. "
      "In this part, it isn't kept as neat and clean as farther north. "
      "Refuse is piling in some of the corners, more or less out of "
      "sight but still noticeable.\n",
    "stones":
      "The lane is paved with "
      "cobblestones. They are none too clean and rather uneaven. Weeds are "
      "growing between them.\n",
    "cobblestones":
      "The lane is paved with "
      "cobblestones. They are none too clean and rather uneaven. Weeds are "
      "growing between them.\n",
    "pavement":
      "The lane is paved with "
      "cobblestones. They are none too clean and rather uneaven. Weeds are "
      "growing between them.\n",
    "weeds":
      "Weeds are growing in the fissures in the pavement.\n",
    "fissures":
      "The fissures between the cobblestones "
      "are filled with dirt. Weeds are growing there.\n",
    "spaces":
      "The fissures between the cobblestones "
      "are filled with dirt. Weeds are growing there.\n",
    "dirt":
      "Dirt is filling the spaces between the cobblestones, "
      "providing ample nourishment for the weeds growing there.\n",
    "refuse":
      "Some of the houses' inhabitants just "
      "dumped their refuse in some corners.\n",
    "corners":
      "Some of the houses' inhabitants just "
      "dumped their refuse in some corners.\n",
    "wall":
      "The high wall surrounding the city runs parallel to the street.\n",
    "city wall":
      "The high wall surrounding the city runs parallel to the street.\n",
    "children":
      "You see some children playing on the street.\n",
    "women":
      "Some women are standing in one of the doors, having "
      "a chat.\n",
    "westway":
      "Westway is the main road running through Silvere. It offers a "
      "wide variety of shops and other ways to spend your hard-earned "
      "coins.\n",
    "road":
      "Westway is the main road running through Silvere. It offers a "
      "wide variety of shops and other ways to spend your hard-earned "
      "coins.\n",
    "bushes":
      "You can just make out some trees and "
      "bushes forming the entrance of the city's low level adventurers' park.\n",
    "trees":
      "You can just make out some trees and "
      "bushes forming the entrance of the city's low level adventurers' park.\n",
    "park":
      "Just follow this street south and you'll find it.\n",
    "city park":
      "Just follow this street south and you'll find it.\n",
    "adventurers' park":
      "Just follow this street south and you'll find it.\n",
    "houses":
      "While the houses around you cannot really be called shabby, "
      "most of them could definitely do with some fresh paint and a "
      "thorough cleaning.\n",
    "buildings":
      "While the houses around you cannot really be called shabby, "
      "most of them could definitely do with some fresh paint and a "
      "thorough cleaning.\n",
  ]);
}

string query_short() { return "Park Lane"; }

string query_long() {
  return
    "You are walking along Park Lane which runs parallel to the city wall. "
    "Far off to the north, you can see Westway, the city's main road. South, "
    "you glimpse trees and bushes and the entrance to the city park. The "
    "houses here are small and rather plain. Around you, people are going "
    "after their daily business. Children are playing, and some women are "
    "standing together in one of the doors, chatting.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "lane" || str == "street" || str == "here"; }
