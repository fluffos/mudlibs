/*
 * Westway toward the post office — east of westroad4.
 *
 * Strategy A FluffOS room. Original (TimeMsg, north post)
 * is westroad5_ldmud.lpc. East continues to westroad6;
 * north opens the post-office lane.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westroad4",
    "w": "/d/silvere/rooms/west/westroad4",
    "east": "/d/silvere/rooms/west/westroad6",
    "e": "/d/silvere/rooms/west/westroad6",
    "north": "/d/silvere/rooms/west/wpostroad1",
    "n": "/d/silvere/rooms/west/wpostroad1",
  ]);
  extras = ([
    "houses":
      "Most of the houses along Westway are owned by rich "
      "merchants, and have shops on the ground floor. They are all "
      "painted in bright colours, with many decorations to show that "
      "their owners are well off.\n",
    "decorations":
      "Intricate ornaments adorn many of the houses. Most of them show "
      "maritime scenes.\n",
    "ornaments":
      "Intricate ornaments adorn many of the houses. Most of them show "
      "maritime scenes.\n",
    "scenes":
      "Since Silvere is a harbour city, "
      "most of the houses' decorations show maritime scenes.\n",
    "shops":
      "Many shops can be found along Westway, offering just "
      "about everything you can imagine (and possibly even a few things "
      "you can't.)\n",
    "street":
      "A narrow street branches off Westway, leading north.\n",
    "flagstones":
      "The pavement is swept daily by city workers. As long as you "
      "stay on the main street, your feet won't get dirty, except during"
      "really foul weather.\n",
  ]);
}

string query_short() { return "Westway. A street leads north to the post office."; }

string query_long() {
  return
    "You are still strolling along Westway, a wide, paved boulevard leading "
    "through the heart of Silvere. A narrow street branches off to the north. "
    "The houses lining the street are painted in vivid, friendly colours, "
    "with intricate decorations displaying the wealth of their owners. "
    "The many shops along the boulevard are open. All "
    "around you, people are going after their business, "
    "filling the streets with life.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west, east and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "westway" || str == "road" || str == "here"; }
