/*
 * Westway palace-square approach — east of westroad10.
 *
 * Strategy A FluffOS room. Original (TimeMsg, east palace)
 * is westroad11_ldmud.lpc. The palace square (westenter)
 * is not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westroad10",
    "w": "/d/silvere/rooms/west/westroad10",
  ]);
  extras = ([
    "palace":
      "The palace is an impressive structure built entirely from "
      "snow white marble. When the sun is shining, it gleams so brightly "
      "it is hard to look at its walls, and at night it seems to glow "
      "softly in the moonlight. The palace is one of the most beautiful "
      "buildings in Silvere. Also, the gardens surrounding it are famous "
      "throughout the land.\n",
    "square":
      "The square east of you is the centre of Silvere. "
      "The palace of the Lu'meyn is there, as well as the famous gardens.\n",
    "murals":
      "The houses are painted with colourful pictures, showing "
      "creatures of the ocean and scenes from old stories and legends.\n",
    "elrimand":
      "Elrimand was the founder and first ruler of Silvere. "
      "The street leading from Westway to the council hall was named in his "
      "honour.\n",
    "flagstones":
      "Westway is paved with large, smooth flagstones, which "
      "are carefully swept every day.\n",
    "houses":
      "The houses along Westway clearly belong to the well-to-do. "
      "Only wealthy citizens can afford to live along Silvere's finest "
      "boulevard. The houses' fronts are painted in every colour "
      "imaginable, and most of them are decorated with intricate "
      "ornaments.\n",
    "marble":
      "The palace is built from fine white marble.\n",
  ]);
}

string query_short() { return "Westway"; }

string query_long() {
  return
    "Westway widens here and opens into a large square to the east. There you "
    "see a large marble building: the palace of the Lu'meyn, which lies at the "
    "center of the city. To the west, the street runs towards the harbour, "
    "passing some of Silvere's finest shops on the way. It is day, and lots of "
    "people are bustling around everywhere. This close to the palace, there "
    "are more guards than elsewhere along the street.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "westway" || str == "road" || str == "here"; }
