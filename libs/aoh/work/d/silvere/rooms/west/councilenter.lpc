/*
 * Council Hall Entrance — east of councilroad4.
 *
 * Strategy A FluffOS room. Original (leave hall
 * command) is councilenter_ldmud.lpc. Archive stub:
 * no AddDetail. leave hall is not wired this slice.
 * Archive keeps “nothing here nothing can be seen”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/councilroad4",
    "w": "/d/silvere/rooms/west/councilroad4",
  ]);
  extras = ([ ]);
}

string query_short() { return "Council Hall Entrance"; }

string query_long() {
  return
    "This is the entrance to the council hall. As there is nothing here "
    "nothing can be seen. The clocktower is supposed to be here and maybe "
    "some people of the city council or whatever.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "hall" || str == "entrance" || str == "here";
}
