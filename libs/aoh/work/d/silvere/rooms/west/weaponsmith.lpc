/*
 * Weaponsmith shop stub — south of wsmithroad2.
 *
 * Strategy A FluffOS room. Original (leave shop/smith,
 * inherit /room/smithy) is weaponsmith_ldmud.lpc.
 * Archive stub: no AddDetail. Archive keeps
 * “doesn't buy anything” / missing period after
 * north. leave / buy are not loaded. North
 * wsmithroad2 is loaded.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/wsmithroad2",
    "n": "/d/silvere/rooms/west/wsmithroad2",
  ]);
  extras = ([ ]);
}

string query_short() { return "weaponsmith"; }

string query_long() {
  return
    "This is the shop of the weaponsmith. He creates and repairs weapons "
    "but doesn't buy anything. The exit is to the north\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "shop" || str == "smith" || str == "here";
}
