/*
 * Lane to the sell-only shop — south of westshop1.
 *
 * Strategy A FluffOS room. Original is westshop2_ldmud.lpc.
 * West opens the Caves of Parch entrance stub.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/westshop1",
    "n": "/d/silvere/rooms/west/westshop1",
    "south": "/d/silvere/rooms/west/westshop",
    "s": "/d/silvere/rooms/west/westshop",
    "west": "/d/silvere/rooms/west/cparch",
    "w": "/d/silvere/rooms/west/cparch",
  ]);
  extras = ([
    "shop":
      "To the south is a small shop, that only sells items.\n",
    "caves":
      "The mysterious Caves of Parch are located to the west.\n",
    "road":
      "This is a small road, that leads from the mainroad to the south.\n",
  ]);
}

string query_short() { return "Westroad"; }

string query_long() {
  return
    "This is a small road, that leads from the mainroad to the south. "
    "The mysterious Caves of Parch are located to the west. "
    "To the south is a small shop, that only sells item.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are north, south and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "lane" || str == "here"; }
