/*
 * Sell-only shop — south of westshop2.
 *
 * Strategy A FluffOS room. Original /std/shop (sell-only)
 * is westshop_ldmud.lpc. Look at the keeper/trashcan is
 * flavour; buy is not implemented this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/westshop2",
    "n": "/d/silvere/rooms/west/westshop2",
    "out": "/d/silvere/rooms/west/westshop2",
  ]);
  extras = ([
    "shopkeeper":
      "The shopkeeper may know some things "
      "about the city (or about quests, whatever). He sells only some "
      "things and doesn't buy anything.\n",
    "keeper":
      "The shopkeeper may know some things "
      "about the city (or about quests, whatever). He sells only some "
      "things and doesn't buy anything.\n",
    "trashcan":
      "A nice little trashcan.\n",
    "trash":
      "A nice little trashcan.\n",
    "dustbin":
      "A nice little trashcan.\n",
  ]);
}

string query_short() { return "A little shop"; }

string query_long() {
  return
    "This is a little shop. The shopkeeper may know some things "
    "about the city (or about quests, whatever). He sells only some "
    "things and doesn't buy anything.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "shop" || str == "here"; }
