/*
 * City Elder office — east of Park Lane (cityinfo1).
 *
 * Strategy A FluffOS room. Original (elder NPC, leave
 * office, sit) is cityinfo_ldmud.lpc. Look-ats only;
 * leave office / sit / elder greet are not wired this
 * slice. Archive keeps “Ciraran” in the long.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/cityinfo1",
    "w": "/d/silvere/rooms/west/cityinfo1",
  ]);
  extras = ([
    "desk":
      "A large desk is standing next to the window. It is made of "
      "polished oak wood and looks quite old. Its surface is covered "
      "with piles of paper and writing implements, all neatly arranged "
      "and ordered.\n",
    "wood":
      "The desk is a rather massive looking piece of furniture. "
      "The wood has darkened with age and is polished to a silken "
      "sheen.\n",
    "oak":
      "The desk is a rather massive looking piece of furniture. "
      "The wood has darkened with age and is polished to a silken "
      "sheen.\n",
    "piles":
      "Neatly stacked papers cover "
      "most of the desk's surface. It seems that the City Elder is a "
      "rather busy man - and also a very tidy one.\n",
    "paper":
      "Neatly stacked papers cover "
      "most of the desk's surface. It seems that the City Elder is a "
      "rather busy man - and also a very tidy one.\n",
    "papers":
      "Neatly stacked papers cover "
      "most of the desk's surface. It seems that the City Elder is a "
      "rather busy man - and also a very tidy one.\n",
    "implements":
      "Some quills and a bottle of ink are placed on the desk.\n",
    "writing implements":
      "Some quills and a bottle of ink are placed on the desk.\n",
    "quills":
      "Some quills and a bottle of ink are placed on the desk.\n",
    "bottle":
      "Some quills and a bottle of ink are placed on the desk.\n",
    "ink":
      "Some quills and a bottle of ink are placed on the desk.\n",
    "window":
      "The window looks out onto Park Lane. It is hung with "
      "pretty curtains. A flower pot is standing on the window sill.\n",
    "lane":
      "Through the window, you can "
      "see the street that brought you here.\n",
    "park lane":
      "Through the window, you can "
      "see the street that brought you here.\n",
    "street":
      "Through the window, you can "
      "see the street that brought you here.\n",
    "curtain":
      "The curtains are bright yellow and decorated with a floral "
      "design in blue.\n",
    "curtains":
      "The curtains are bright yellow and decorated with a floral "
      "design in blue.\n",
    "design":
      "Blue blossoms have been embroidered on the curtains. They "
      "look very pretty.\n",
    "blossoms":
      "Blue blossoms have been embroidered on the curtains. They "
      "look very pretty.\n",
    "floral design":
      "Blue blossoms have been embroidered on the curtains. They "
      "look very pretty.\n",
    "sill":
      "A potted flower is standing on the "
      "window sill.\n",
    "window sill":
      "A potted flower is standing on the "
      "window sill.\n",
    "pot":
      "A simple earthenware flowerpot "
      "holding a miniature rosebush.\n",
    "flower pot":
      "A simple earthenware flowerpot "
      "holding a miniature rosebush.\n",
    "rose":
      "The little bush is in full bloom. Tiny white roses blossom "
      "between dark green leaves, filling the air with a very faint "
      "fragrance.\n",
    "flower":
      "The little bush is in full bloom. Tiny white roses blossom "
      "between dark green leaves, filling the air with a very faint "
      "fragrance.\n",
    "plant":
      "The little bush is in full bloom. Tiny white roses blossom "
      "between dark green leaves, filling the air with a very faint "
      "fragrance.\n",
    "bush":
      "The little bush is in full bloom. Tiny white roses blossom "
      "between dark green leaves, filling the air with a very faint "
      "fragrance.\n",
    "rosebush":
      "The little bush is in full bloom. Tiny white roses blossom "
      "between dark green leaves, filling the air with a very faint "
      "fragrance.\n",
    "roses":
      "The little bush is in full bloom. Tiny white roses blossom "
      "between dark green leaves, filling the air with a very faint "
      "fragrance.\n",
    "leaves":
      "The rosebush has dark green leaves.\n",
    "chair":
      "A wooden chair is standing behind "
      "the desk. Two more are placed in front of it. Feel free to "
      "sit down if there is still an empty one.\n",
    "chairs":
      "A wooden chair is standing behind "
      "the desk. Two more are placed in front of it. Feel free to "
      "sit down if there is still an empty one.\n",
    "rug":
      "A bright blue carpet woven from wool covers most "
      "of the floor.\n",
    "carpet":
      "A bright blue carpet woven from wool covers most "
      "of the floor.\n",
    "painting":
      "The painting shows a view over the "
      "harbour of Silvere as seen from the harbour tower.\n",
    "picture":
      "The painting shows a view over the "
      "harbour of Silvere as seen from the harbour tower.\n",
    "harbour":
      "You can't see the harbour from here, it's only a "
      "picture!\n",
    "door":
      "The door is painted blue and leads back outside.\n",
