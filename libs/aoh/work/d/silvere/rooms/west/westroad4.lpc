/*
 * Westway flowerbed — east of westroad3.
 *
 * Strategy A FluffOS room. Original (seasonal flowerbed) is
 * westroad4_ldmud.lpc. East continues to westroad5.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westroad3",
    "w": "/d/silvere/rooms/west/westroad3",
    "east": "/d/silvere/rooms/west/westroad5",
    "e": "/d/silvere/rooms/west/westroad5",
    "south": "/d/silvere/rooms/west/westshop1",
    "s": "/d/silvere/rooms/west/westshop1",
  ]);
  extras = ([
    "flowerbed":
      "The flowers are in full bloom, displaying a myriad of colours "
      "and filling the air with a sweet fragrance.\n",
    "flowers":
      "The flowers are blooming in every colour imaginable. "
      "Their sweet fragrance fills the air, overlaying even "
      "the odour wafting over from the poorer quarters of the "
      "city.\n",
    "fence":
      "The fence is only about knee high (for a human, that is.) "
      "It is painted white and ensures that no careless passers-by trample "
      "the flowers.\n",
    "alley":
      "The alley winds its way south between the houses.\n",
    "shops":
      "Westway is the main business street of Silvere. Provided "
      "you have the money, you will probably find whatever you are looking for in "
      "one of the many shops.\n",
    "houses":
      "The houses are painted in bright, friendly colours. "
      "Most of them contain a shop on the ground floor.\n",
  ]);
}

string query_short() { return "Westway. An alley leads south to a shop."; }

string query_long() {
  return
    "A narrow alley branches off Westway here and leads south to a small shop. "
    "A flowerbed has been planted in the middle of the boulevard, protected "
    "from careless feet by a low wrought-iron fence. "
    "The many shops along the boulevard are open. All "
    "around you, people are going after their business, "
    "filling the streets with life.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west, east and south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "westway" || str == "road" || str == "here"; }
