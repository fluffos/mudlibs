/*
 * Post office and Counting House street — north of wpostroad1.
 *
 * Strategy A FluffOS room. Original (enter bank) is
 * wpostroad2_ldmud.lpc. The bank interior is not loaded
 * this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/wpostroad1",
    "s": "/d/silvere/rooms/west/wpostroad1",
    "west": "/d/silvere/rooms/west/wpostoffice",
    "w": "/d/silvere/rooms/west/wpostoffice",
  ]);
  extras = ([
    "arch":
      "Fine etching and carving embellish the grand entrace to the "
      "Counting House of Aberfynne. A carved griffon sits, leering, "
      "at the base of each side of the archway, their blank stone eyes "
      "examining each potential client. To one side of the archway  is "
      "affixed a shining brass plaque.\n",
    "archway":
      "Fine etching and carving embellish the grand entrace to the "
      "Counting House of Aberfynne. A carved griffon sits, leering, "
      "at the base of each side of the archway, their blank stone eyes "
      "examining each potential client. To one side of the archway  is "
      "affixed a shining brass plaque.\n",
    "plaque":
      "The plaque reads: 'The Counting House of Aberfynne, "
      "purveyors of exclusive financial services. Est. in the "
      "10th year of the reign of Finnae, Lu'meyna of Silvere.' "
      "Tiny letters under that read: 'No peddlers or Campbells'.\n",
    "offices":
      "Across the way are the much humbler offices of the Silverean Letter and Parcel "
      "Service.\n",
  ]);
}

string query_short() { return "Westroad"; }

string query_long() {
  return
    "The imposing establishment on the east side of the road, built almost completely "
    "of stone, easily upstages every other drab building along this lane. A "
    "grand archway invites you into the foyer of the Counting House of Aberfynne, "
    "the premier banking institution of Silvere for the last several hundred years. "
    "Across the way are the much humbler offices of the Silverean Letter and Parcel "
    "Service.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "lane" || str == "here"; }
