/*
 * Feridwyn's Seafood — north of westroad6.
 *
 * Strategy A FluffOS room. Original /std/shop (fish, Feridwyn)
 * is fishmonger_ldmud.lpc. Look at tiles/vats/sign is flavour;
 * buy is not implemented this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/westroad6",
    "s": "/d/silvere/rooms/west/westroad6",
    "out": "/d/silvere/rooms/west/westroad6",
  ]);
  extras = ([
    "tiles":
      "The large tiles have been painted in bright colours. They show "
      "different kinds of fish as well as other inhabitants of the sea, like "
      "mermaids. Not two of them seem to display the same picture.\n",
    "vats":
      "Large vats full of ice hold the fresh fish displayed in the counter.\n",
    "vat":
      "Large vats full of ice hold the fresh fish displayed in the counter.\n",
    "fish":
      "Dried and salted fish are hanging behind the counter, while "
      "fresh ones are stored in ice.\n",
    "counter":
      "The counter is quite large and occupied by several large, ice-filled "
      "vats.\n",
    "sign":
      "A rough signboard reads: \n"
      "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
      "            FERIDWYN'S SEAFOOD              \n"
      " Offers you a fine selection of fish and    \n"
      "  other delicacies - caught fresh daily!    \n"
      "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n",
    "barrels":
      "You see two big wooden barrels standing behind the counter. One of "
      "them holds some smoked and salted herrings, which are often bought by "
      "adventurers for travelling rations. The other one is filled with salt.\n",
    "ice":
      "The ice in the vats keeps the fish fresh. You have no idea "
      "how Feridwyn keeps it from melting away during summer.\n",
  ]);
}

string query_short() { return "a fishmonger's"; }

string query_long() {
  return
    "The walls and floor of this little shop are covered with brightly painted "
    "glazed tiles. A counter runs along one of the walls, filled with large "
    "vats full of ice. In them, several varieties of fresh fish are displayed. "
    "Behind the counter, dried and smoked fish are hanging on strings from the "
    "ceiling. A large barrel holds kippers, smoked and salted herrings, while "
    "another one is filled with salt.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "shop" || str == "fishmonger" || str == "here"; }
