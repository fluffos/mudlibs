/*
 * Chez Brigan — north of westroad8.
 *
 * Strategy A FluffOS room. Original /std/shop (wine, Brigan)
 * is wineshop_ldmud.lpc. Archive AddArticle stock:
 *   chamglass  REFRESH_RESET 5  (SetValue 50)
 *   champagne  REFRESH_RESET 3  (SetValue 500)
 *   wineglass  REFRESH_RESET 5  (vessel 2)
 *   elfwine    REFRESH_RESET 5  (SetValue 400)
 * Drink/sip is not wired this slice.
 */

mapping exits;
mapping extras;
mixed *stock;

void restock();
string strip_buy(string str);
int stock_left(int i);
void stock_take(int i);

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/westroad8",
    "s": "/d/silvere/rooms/west/westroad8",
    "out": "/d/silvere/rooms/west/westroad8",
  ]);
  extras = ([
    "racks":
      "Wooden racks line the walls, filled with lots of bottles.\n",
    "bottles":
      "The bottles are carefully labelled. Some of them look "
      "quite dusty.\n",
    "barrels":
      "You see several large wooden barrels behind the counter. They are "
      "not labelled, yet Brigan probably knows what is inside each of them.\n",
    "sign":
      "A polished signboard reads: \n"
      "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
      "                CHEZ BRIGAN                 \n"
      "         SUPPLIER OF EXCELLENT WINES        \n"
      "       Rare Vintages - Export & Import      \n"
      "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n",
    "tables":
      "Three round tables have been placed near the counter. There "
      "are no chairs, but the tables are high enough that an average human can "
      "comfortably stand at them and have a drink.\n",
    "counter":
      "The counter was built from large barrels which have been cut in half and "
      "topped with smooth, polished boards.\n",
    "wood":
      "Some dark wood has been used for the furniture and panelling. It has "
      "been carefully polished.\n",
    "list":
      "Brigan keeps a list of what is for sale. Type 'list'.\n",
    "wares":
      "Brigan keeps a list of what is for sale. Type 'list'.\n",
  ]);
  restock();
}

void restock() {
  /* ({ ids, path, brief, price, left }) */
  stock = ({
    ({
      ({ "wine", "white wine", "elvish white wine", "elvish wine",
         "wine glass", "glass of wine", "glass of elvish white wine" }),
      "/d/silvere/obj/wine/wineglass",
      "a glass filled with elvish white wine",
      2, 5
    }),
    ({
      ({ "champagne glass", "glass of champagne", "chamglass" }),
      "/d/silvere/obj/wine/chamglass",
      "a glass filled with champagne",
      50, 5
    }),
    ({
      ({ "elfwine", "bottle of wine", "wine bottle",
         "bottle of elvish white wine" }),
      "/d/silvere/obj/wine/elfwine",
      "a bottle filled with elvish white wine",
      400, 5
    }),
    ({
      ({ "champagne bottle", "bottle of champagne" }),
      "/d/silvere/obj/wine/champagne",
      "a bottle filled with champagne",
      500, 3
    }),
  });
}

void reset() {
  restock();
}

string query_short() { return "a wine merchant's shop"; }

string query_long() {
  return
    "The interior of this shop is furnished entirely with wood. A slightly "
    "musty smell hangs in the air. Racks filled with dozens of bottles line the "
    "walls. Behind the counter, you notice several large barrels. Three small "
    "round tables are standing next to the counter, for those customers who "
    "want to sample the wares before buying larger quantities.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "shop" || str == "wineshop" || str == "here"; }

int is_shop() { return 1; }

int stock_left(int i) {
  return stock[i][4];
}

void stock_take(int i) {
  stock[i][4] = stock[i][4] - 1;
}

int shop_list(string arg) {
  int i, n, any;

  write("Brigan shows a list to you.\n");
  n = sizeof(stock);
  any = 0;
  for (i = 0; i < n; i++) {
    if (stock_left(i) < 1)
      continue;
    write(sprintf("  %-40s %4d copper\n", stock[i][2], stock[i][3]));
    any = 1;
  }
  if (!any)
    write("Sorry, I have no item in the store.\n");
  return 1;
}

string strip_buy(string str) {
  if (!str)
    return "";
  str = lower_case(str);
  while (strlen(str) && (str[0] == ' ' || str[<1] == ' ')) {
    if (str[0] == ' ')
      str = str[1..];
    else
      str = str[0..<2];
  }
  if (strlen(str) > 2 && str[0..1] == "a ")
    str = str[2..];
  else if (strlen(str) > 3 && str[0..2] == "an ")
    str = str[3..];
  else if (strlen(str) > 4 && str[0..3] == "the ")
    str = str[4..];
  return str;
}

int shop_buy(object who, string str) {
  int i, n, pick;
  string *ids;
  object ob;

  if (!who)
    return 1;
  str = strip_buy(str);
  if (str == "") {
    write("Buy what?\n");
    return 1;
  }
  n = sizeof(stock);
  pick = -1;
  for (i = 0; i < n; i++) {
    ids = stock[i][0];
    if (member_array(str, ids) != -1 && stock_left(i) > 0) {
      pick = i;
      break;
    }
  }
  if (pick < 0) {
    if (str == "glass") {
      if (stock_left(0) > 0)
        pick = 0;
      else if (stock_left(1) > 0)
        pick = 1;
    } else if (str == "champagne") {
      if (stock_left(1) > 0)
        pick = 1;
      else if (stock_left(3) > 0)
        pick = 3;
    } else if (str == "bottle") {
      if (stock_left(2) > 0)
        pick = 2;
      else if (stock_left(3) > 0)
        pick = 3;
    }
  }
  if (pick < 0) {
    write("Brigan says: I have no item called '" + str + "'.\n");
    return 1;
  }
  if (who->query_money() < stock[pick][3]) {
    write("Brigan says: Sorry " +
      capitalize(who->query_name() || "someone") +
      ", but you don't have enough money!\n");
    return 1;
  }
  who->add_money(-stock[pick][3]);
  stock_take(pick);
  if (function_exists("receive_shop_item", who))
    who->receive_shop_item(stock[pick][1]);
  else {
    ob = 0;
    catch(ob = clone_object(stock[pick][1]));
    if (ob)
      ob->move(who);
  }
  write("You pay " + stock[pick][3] + " copper coins.\n");
  write("Brigan gives you " + stock[pick][2] + ".\n");
  return 1;
}
