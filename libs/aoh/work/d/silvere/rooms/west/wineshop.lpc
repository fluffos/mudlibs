/*
 * Chez Brigan — north of westroad8.
 *
 * Strategy A FluffOS room. Original /std/shop (wine, Brigan)
 * is wineshop_ldmud.lpc. Look at racks/sign is flavour;
 * buy is not implemented this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/westroad8",
    "s": "/d/silvere/rooms/west/westroad8",
    "out": "/d/silvere/rooms/west/westroad8",
  ]);
  extras = ([
    "racks":
      "Wooden racks line the walls, filled with lots of bottles.\n",
    "bottles":
      "The bottles are carefully labelled. Some of them look "
      "quite dusty.\n",
    "barrels":
      "You see several large wooden barrels behind the counter. They are "
      "not labelled, yet Brigan probably knows what is inside each of them.\n",
    "sign":
      "A polished signboard reads: \n"
      "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
      "                CHEZ BRIGAN                 \n"
      "         SUPPLIER OF EXCELLENT WINES        \n"
      "       Rare Vintages - Export & Import      \n"
      "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n",
    "tables":
      "Three round tables have been placed near the counter. There "
      "are no chairs, but the tables are high enough that an average human can "
      "comfortably stand at them and have a drink.\n",
    "counter":
      "The counter was built from large barrels which have been cut in half and "
      "topped with smooth, polished boards.\n",
    "wood":
      "Some dark wood has been used for the furniture and panelling. It has "
      "been carefully polished.\n",
  ]);
}

string query_short() { return "a wine merchant's shop"; }

string query_long() {
  return
    "The interior of this shop is furnished entirely with wood. A slightly "
    "musty smell hangs in the air. Racks filled with dozens of bottles line the "
    "walls. Behind the counter, you notice several large barrels. Three small "
    "round tables are standing next to the counter, for those customers who "
    "want to sample the wares before buying larger quantities.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is south.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "shop" || str == "wineshop" || str == "here"; }
