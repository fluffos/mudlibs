/*
 * Before the healer — north of The Westway.
 *
 * Strategy A FluffOS room. Original (enter healer) is
 * whealer1_ldmud.lpc. North whealer (healer house
 * look-ats) is loaded this slice; drink / leave
 * healer / treat are not wired.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/westroad1",
    "s": "/d/silvere/rooms/west/westroad1",
    "north": "/d/silvere/rooms/west/whealer",
    "n": "/d/silvere/rooms/west/whealer",
  ]);
  extras = ([
    "house":
      "North of you is a small house. Behind the windows, you can "
      "see bunches of dried herbs. A faint, sweetly smell emanates "
      "from the house, noticeable even from this distance.\n",
    "herbs":
      "Bundled herbs can be seen hanging behind the windows.\n",
    "windows":
      "Behind the windows of the house you glimpse bundles of herbs "
      "which have been hung there to dry.\n",
    "wall":
      "The city's wall has been built from huge blocks of grey "
      "stone. It looks very solid, and by no means easily breachable.\n",
    "street":
      "You are on a small street branching north off Westway. The "
      "street is paved with cobblestones.\n",
  ]);
}

string query_short() { return "Before the house of the healer"; }

string query_long() {
  return
    "The great city wall runs parallel to the west side of this street. "
    "To the north is a small house. Bunches of dried herbs are hanging "
    "in the windows.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "street" || str == "healer" || str == "here"; }
