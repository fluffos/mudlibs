/*
 * Eldranna's Bake Shoppe — west of councilroad1.
 *
 * Strategy A FluffOS room. Original /std/shop (daily special)
 * is bakery_ldmud.lpc. Look at shelves/chalkboard is flavour;
 * buy is not implemented this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/west/councilroad1",
    "e": "/d/silvere/rooms/west/councilroad1",
    "out": "/d/silvere/rooms/west/councilroad1",
  ]);
  extras = ([
    "shelves":
      "Several pine shelves are fixed to the back wall of the small bake shop. "
      "Breads and pastries are arranged in neat rows across the shelves.\n",
    "shelf":
      "Several pine shelves are fixed to the back wall of the small bake shop. "
      "Breads and pastries are arranged in neat rows across the shelves.\n",
    "chalkboard":
      " +--------------------------------------------------+ \n"
      " |              Eldranna's Bake Shoppe              | \n"
      " |                    ~ ~ ~ ~ ~                     | \n"
      " |                Our daily special                 | \n"
      " |                                                  | \n"
      " |           Fresh breads and pastries              | \n"
      " |           (30% off the normal price!)            | \n"
      " +--------------------------------------------------+ \n",
    "board":
      " +--------------------------------------------------+ \n"
      " |              Eldranna's Bake Shoppe              | \n"
      " |                    ~ ~ ~ ~ ~                     | \n"
      " |                Our daily special                 | \n"
      " |                                                  | \n"
      " |           Fresh breads and pastries              | \n"
      " |           (30% off the normal price!)            | \n"
      " +--------------------------------------------------+ \n",
    "bread":
      "Look at the chalkboard to see what Eldranna has baked today.\n",
    "pastries":
      "Look at the chalkboard to see what Eldranna has baked today.\n",
    "counter":
      "Pine shelves filled with breads and pastries tantalize you from behind "
      "the counter.\n",
  ]);
}

string query_short() { return "Eldranna's Bake Shoppe"; }

string query_long() {
  return
    "The pleasant aroma of freshly baked bread and wood smoke mingle, "
    "assaulting your sense of hunger as you step into the bake shoppe. "
    "Pine shelves filled with breads and pastries tantalize you from behind "
    "the counter. A chalkboard hangs on one wall.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "shop" || str == "bakery" || str == "here"; }
