/*
 * Silvere post office — west of wpostroad2.
 *
 * Strategy A FluffOS room. Original (mail dpost) is
 * wpostoffice_ldmud.lpc. Mail is not implemented this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/west/wpostroad2",
    "e": "/d/silvere/rooms/west/wpostroad2",
    "out": "/d/silvere/rooms/west/wpostroad2",
    "west": "/d/silvere/rooms/west/wpostroad1",
    "w": "/d/silvere/rooms/west/wpostroad1",
  ]);
  extras = ([
    "cabins":
      "Some private cabins, where you can read your mail.\n",
    "cabin":
      "Some private cabins, where you can read your mail.\n",
    "mail":
      "This is where citizens of Silvere come to read their mail.\n",
    "room":
      "A rather small room with some private cabins.\n",
  ]);
}

string query_short() { return "post office"; }

string query_long() {
  return
    "This is a rather small room with some private cabins, where you can "
    "read your mail. You can leave the office to the east.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "office" || str == "post" || str == "here"; }
