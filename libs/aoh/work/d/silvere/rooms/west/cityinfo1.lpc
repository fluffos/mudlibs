/*
 * Park Lane — south of The Westway.
 *
 * Strategy A FluffOS room. Original (day-gated City Elder office)
 * is cityinfo1_ldmud.lpc. The office interior and city park are
 * not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "north": "/d/silvere/rooms/west/westroad1",
    "n": "/d/silvere/rooms/west/westroad1",
  ]);
  extras = ([
    "lane":
      "Park Lane is narrower than Westway, but every bit as neat and "
      "clean.\n",
    "office":
      "The house containing the City Elder's office is slightly "
      "larger than the others. A sign next to the door names the elder.\n",
    "sign":
      "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
      "                    CITY OF SILVERE                       \n"
      "                   Information Office                     \n"
      "                Ciaran Hargall, City Elder                \n"
      "                                                          \n"
      "            Business Hours: Sunrise to Sunset             \n"
      "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n",
    "door":
      "The wooden door leading into the office has been painted "
      "bright blue. A polished brass sign is mounted next to it.\n",
    "houses":
      "Half-timbered houses line the street. They are "
      "less colourfully decorated than those along Westway, but "
      "kept clean and in good repair.\n",
    "wall":
      "The city wall rises to the west of you. It was built from huge "
      "blocks of grey stone and looks very massive.\n",
  ]);
}

string query_short() { return "A street leading south off Westway"; }

string query_long() {
  return
    "You are walking down Park Lane, a small street leading from Westway north "
    "of you to the city park to the south. The high wall surrounding the city "
    "runs parallel to the street. The houses here don't look as luxurious as "
    "the ones along Westway, and the street is paved with cobblestones instead "
    "of flagstones. Still, everything looks neat, clean and inviting. The "
    "house east of you is somewhat larger than the others. A sign next to the "
    "door proclaims it the City Elder's office.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "lane" || str == "street" || str == "here"; }
