/*
 * Westway Guild Street fork — east of westroad8.
 *
 * Strategy A FluffOS room. Original (TimeMsg, south library,
 * east westroad10) is westroad9_ldmud.lpc. Guild Street,
 * the library, and westroad10 are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westroad8",
    "w": "/d/silvere/rooms/west/westroad8",
  ]);
  extras = ([
    "street":
      "South of you starts Guild Street. As its name implies, it "
      "leads to the Adventurers' Guild. The library of Silvere can also "
      "be found somewhere along it.\n",
    "palace":
      "From here, you cannot make out more than the silhouette "
      "of the palace. Go east if you want a closer look.\n",
    "silhouette":
      "The silhouette of the palace can be seen to the east. "
      "However, you are still too far off to make out any details.\n",
    "houses":
      "Painted in every colour imaginable, the houses along "
      "Westway are a splendid sight. Their owners must be quite wealthy to be able "
      "to afford them.\n",
    "flagstones":
      "Westway has been paved with large, smooth flagstones. They "
      "are swept every day.\n",
    "library":
      "You remember someone telling you the library was "
      "somewhere along Guild Street, but you can't see it from here.\n",
  ]);
}

string query_short() { return "Westway. A street leads south"; }

string query_long() {
  return
    "A street branches off Westway here, leading south. East of you, you can "
    "see the palace in the distance. Brightly painted houses line Westway, "
    "indicating that this is one of the better quarters of the city. "
    "The shops on their ground floors are open. "
    "Business seems to be good today, judging from the many people who "
    "are milling about everywhere, creating an infernal noise.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "westway" || str == "road" || str == "here"; }
