/*
 * Elrimand Road toward the council hall — north of westroad7.
 *
 * Strategy A FluffOS room. Original (TimeMsg, west bakery,
 * north councilroad2) is councilroad1_ldmud.lpc. West opens
 * Eldranna's Bake Shoppe (look only). Further council road
 * and the hall stub are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/westroad7",
    "s": "/d/silvere/rooms/west/westroad7",
    "west": "/d/silvere/rooms/west/bakery",
    "w": "/d/silvere/rooms/west/bakery",
  ]);
  extras = ([
    "sign":
      "The wooden sign above the door is formed like a large "
      "pretzel. Something is written on it in neat letters: "
      "'Eldranna's Bake Shoppe'.\n",
    "pretzel":
      "The wooden sign above the door is formed like a large "
      "pretzel. Something is written on it in neat letters: "
      "'Eldranna's Bake Shoppe'.\n",
    "bakery":
      "The bakery's front is painted bright yellow, with a snow white "
      "door. A sign formed like a pretzel hangs above the entrance.\n",
    "house":
      "The bakery's front is painted bright yellow, with a snow white "
      "door. A sign formed like a pretzel hangs above the entrance.\n",
    "door":
      "The bakery's white door is spotless. A sign is hanging "
      "above it.\n",
    "road":
      "A broad street leading north. It was named after the founder of "
      "Silvere.\n",
  ]);
}

string query_short() { return "Elrimand Road, leading to the council hall"; }

string query_long() {
  return
    "A warm scent of freshly baked bread wafts from the house west of you. "
    "A sign above the door proclaims it a bakery. Elrimand Road leads north "
    "towards the council hall. South of you is the main street of this part of "
    "Silvere, Westway, which seems to be throbbing with life as lots "
    "of people bustle to and fro on their various errands.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "elrimand" || str == "here"; }
