/*
 * Guild Street west toward the library — west of libraryroad1.
 *
 * Strategy A FluffOS room. Original (enter library) is
 * libraryroad2_ldmud.lpc. West opens the library
 * entrance stub. enter library is not wired.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/west/libraryroad1",
    "e": "/d/silvere/rooms/west/libraryroad1",
    "west": "/d/silvere/rooms/west/libraryenter",
    "w": "/d/silvere/rooms/west/libraryenter",
  ]);
  extras = ([
    "library":
      "You can enter the library of the city to the west.\n",
    "guild":
      "When you walk east, you can find the entrance to the "
      "adventurer guild.\n",
    "road":
      "This road comes in from the east. You can enter the library of the city "
      "to the west. When you walk east, you can find the entrance to the "
      "adventurer guild.\n",
  ]);
}

string query_short() { return "Library road"; }

string query_long() {
  return
    "This road comes in from the east. You can enter the library of the city "
    "to the west. When you walk east, you can find the entrance to the "
    "adventurer guild.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are east and west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "street" || str == "here"; }
