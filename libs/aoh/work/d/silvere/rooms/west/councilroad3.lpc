/*
 * Elrimand Road — statue, east of councilroad2.
 *
 * Strategy A FluffOS room. Original (read sign) is
 * councilroad3_ldmud.lpc. Look at statue / sign /
 * inscription is flavour; read is not wired.
 * Archive keeps “semingly” and “statue4s”.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/councilroad2",
    "w": "/d/silvere/rooms/west/councilroad2",
    "east": "/d/silvere/rooms/west/councilroad4",
    "e": "/d/silvere/rooms/west/councilroad4",
  ]);
  extras = ([
    "street":
      "You are on Elrimand Road, leading from Westway to the "
      "council hall.\n",
    "road":
      "You are on Elrimand Road, leading from Westway to the "
      "council hall.\n",
    "elrimand road":
      "You are on Elrimand Road, leading from Westway to the "
      "council hall.\n",
    "statue":
      "The marble statue shows a middle-aged man in chainmail. "
      "He is wielding a broadsword and wearing a crown. A cloak flows "
      "down from his shoulders, semingly moved by a strong breeze. At "
      "the base of the statue, you notice a small sign.\n",
    "large statue":
      "The marble statue shows a middle-aged man in chainmail. "
      "He is wielding a broadsword and wearing a crown. A cloak flows "
      "down from his shoulders, semingly moved by a strong breeze. At "
      "the base of the statue, you notice a small sign.\n",
    "marble statue":
      "The marble statue shows a middle-aged man in chainmail. "
      "He is wielding a broadsword and wearing a crown. A cloak flows "
      "down from his shoulders, semingly moved by a strong breeze. At "
      "the base of the statue, you notice a small sign.\n",
    "large marble statue":
      "The marble statue shows a middle-aged man in chainmail. "
      "He is wielding a broadsword and wearing a crown. A cloak flows "
      "down from his shoulders, semingly moved by a strong breeze. At "
      "the base of the statue, you notice a small sign.\n",
    "base":
      "There is a sign at the base of the statue.\n",
    "man":
      "The statue shows a regal looking man wearing a crown.\n",
    "chainmail":
      "The chainmail has been sculpted so precisely you can "
      "make out every single link.\n",
    "link":
      "Every link of the chainmail has been precisely sculpted.\n",
    "links":
      "Every link of the chainmail has been precisely sculpted.\n",
    "sword":
      "The statue is wielding a heavy broadsword.\n",
    "broadsword":
      "The statue is wielding a heavy broadsword.\n",
    "crown":
      "The crown of Silvere, still worn by the city's ruler today.\n",
    "cloak":
      "The statue4s cloak seems to be moved by the wind.\n",
    "sign":
      "A small, polished brass sign is mounted at the base of "
      "the statue. You may read it.\n",
    "small sign":
      "A small, polished brass sign is mounted at the base of "
      "the statue. You may read it.\n",
    "polished sign":
      "A small, polished brass sign is mounted at the base of "
      "the statue. You may read it.\n",
    "brass sign":
      "A small, polished brass sign is mounted at the base of "
      "the statue. You may read it.\n",
    "small polished brass sign":
      "A small, polished brass sign is mounted at the base of "
      "the statue. You may read it.\n",
    "inscription":
      "'Elrimand, founder of Silvere.'\n",
    "writing":
      "'Elrimand, founder of Silvere.'\n",
    "words":
      "'Elrimand, founder of Silvere.'\n",
    "letters":
      "'Elrimand, founder of Silvere.'\n",
    "hedge":
      "A low hedge of evergreen bushes has been planted around the "
      "statue.\n",
    "low hedge":
      "A low hedge of evergreen bushes has been planted around the "
      "statue.\n",
    "bushes":
      "The bushes have small round leaves which are green even during "
      "winter. They are perfectly trimmed and look quite healthy.\n",
    "evergreen bushes":
      "The bushes have small round leaves which are green even during "
      "winter. They are perfectly trimmed and look quite healthy.\n",
    "leaves":
      "The leaves of the evergreen bushes are rather small, "
      "round and quite hard. As the plant's name suggests, they are "
      "always green.\n",
  ]);
}

string query_short() { return "Elrimand Road. A statue is standing here"; }

string query_long() {
  return
    "The street splits here to lead around a large statue. A low hedge has "
    "been planted around the statue, preventing anyone from approaching closely.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "statue" || str == "here";
}
