/*
 * Elrimand Road — outside the council hall, east of
 * councilroad3.
 *
 * Strategy A FluffOS room. Original (seasonal tree
 * Check* closures, enter hall → councilenter) is
 * councilroad4_ldmud.lpc. Look at tree / doors /
 * marble is flavour. Seasonal checks are frozen as
 * the harbour rooms’ summer text. enter hall is not
 * wired; east opens the archive entrance stub.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/councilroad3",
    "w": "/d/silvere/rooms/west/councilroad3",
    "east": "/d/silvere/rooms/west/councilenter",
    "e": "/d/silvere/rooms/west/councilenter",
  ]);
  extras = ([
    "tree":
      "The tree is really large. It is said that it has been "
      "planted by Elrimand himself centuries ago, and looking at the massive "
      "trunk you are inclined to believe it. Legend has it that as long as "
      "the tree is healthy, Silvere too will flourish. Looking at the branches "
      "swaying gently in the wind you assume that everything must indeed be "
      "fine in the city.\n",
    "branches":
      "Large, dark green leaves grow on the branches, rustling gently in "
      "the light breeze.\n",
    "leaves":
      "The leaves are dark green and heart-shaped.\n",
    "buds":
      "There are no buds, just leaves.\n",
    "blossoms":
      "There are no blossoms here at this time of the year.\n",
    "tiny blossoms":
      "There are no blossoms here at this time of the year.\n",
    "pink blossoms":
      "There are no blossoms here at this time of the year.\n",
    "tiny pink blossoms":
      "There are no blossoms here at this time of the year.\n",
    "snow":
      "There is no snow here.\n",
    "trunk":
      "The tree's trunk is so thick it probably takes several "
      "men to span it. This tree has clearly been here for centuries, and looking "
      "as healthy as it does, probably will still be here centuries from now.\n",
    "square":
      "The street widens here to form a small square in front "
      "of the council hall. In the centre of the square a large tree is growing.\n",
    "street":
      "Elrimand Road ends here in front of the council hall.\n",
    "road":
      "Elrimand Road ends here in front of the council hall.\n",
    "elrimand road":
      "Elrimand Road ends here in front of the council hall.\n",
    "building":
      "A large white marble building houses the hall of the city "
      "council. It was built by Elrimand, the founder of Silvere, but "
      "doesn't look like it's centuries old. Though plain and unadorned, "
      "the building looks very elegant, the fine white marble used for "
      "building it being all the decoration it needs.\n",
    "hall":
      "A large white marble building houses the hall of the city "
      "council. It was built by Elrimand, the founder of Silvere, but "
      "doesn't look like it's centuries old. Though plain and unadorned, "
      "the building looks very elegant, the fine white marble used for "
      "building it being all the decoration it needs.\n",
    "council hall":
      "A large white marble building houses the hall of the city "
      "council. It was built by Elrimand, the founder of Silvere, but "
      "doesn't look like it's centuries old. Though plain and unadorned, "
      "the building looks very elegant, the fine white marble used for "
      "building it being all the decoration it needs.\n",
    "large building":
      "A large white marble building houses the hall of the city "
      "council. It was built by Elrimand, the founder of Silvere, but "
      "doesn't look like it's centuries old. Though plain and unadorned, "
      "the building looks very elegant, the fine white marble used for "
      "building it being all the decoration it needs.\n",
    "white marble building":
      "A large white marble building houses the hall of the city "
      "council. It was built by Elrimand, the founder of Silvere, but "
      "doesn't look like it's centuries old. Though plain and unadorned, "
      "the building looks very elegant, the fine white marble used for "
      "building it being all the decoration it needs.\n",
    "doors":
      "The large wooden doors of the council hall usually stand wide open, inviting "
      "the citizens to enter.\n",
    "double doors":
      "The large wooden doors of the council hall usually stand wide open, inviting "
      "the citizens to enter.\n",
    "marble":
      "Only the finest white marble has been used for the "
      "building. It gleams like snow in the light of the sun and moon.\n",
  ]);
}

string query_short() { return "Elrimand Road, just outside the council hall"; }

string query_long() {
  return
    "The street ends here in front of the large building housing the council "
    "hall. Right in the centre of the small square in front of the entrance is "
    "an enormous tree. Its branches extend like a roof almost over the entire "
    "square. Behind the thick trunk, you can make out the large double doors "
    "leading into the hall.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "tree" || str == "here";
}
