/*
 * Westway flower-shop front — east of westroad9.
 *
 * Strategy A FluffOS room. Original (TimeMsg, south flowershop,
 * east westroad11) is westroad10_ldmud.lpc. The flower shop
 * interior and westroad11 are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westroad9",
    "w": "/d/silvere/rooms/west/westroad9",
  ]);
  extras = ([
    "sign":
      "An iron rose hangs above the shop door, its petals "
      "just opening. The sign is a very fine piece of work, looking "
      "like a real rose in every detail. There is nothing written on it.\n",
    "rose":
      "An iron rose hangs above the shop door, its petals "
      "just opening. The sign is a very fine piece of work, looking "
      "like a real rose in every detail. There is nothing written on it.\n",
    "roses":
      "The roses adorning the shop front look almost real.\n",
    "flowers":
      "The roses adorning the shop front look almost real.\n",
    "shop":
      "The shop's front is painted snow white and decorated with "
      "hundreds of red and pink roses. The flowers have obviously been "
      "painted by a talented artist, for they look stunningly real. The door "
      "is painted pink, too. A sign is fixed above it.\n",
    "door":
      "The shop's door is painted bright pink. A sign hangs "
      "above it.\n",
    "palace":
      "The palace of the Lu'meyn rises east of you. It is built "
      "from snow white marble and really large. From where you are "
      "standing, you cannot make out any further details.\n",
    "marble":
      "Only the finest white marble was used to build the palace.\n",
  ]);
}

string query_short() { return "Westway"; }

string query_long() {
  return
    "The house south of you looks remarkable, standing out even among the "
    "colourfully painted buildings of Westway. A wrought-iron sign is hanging "
    "above the door. Brightly dressed people bustle around everywhere, "
    "going about their daily business. They create an infernal noise, "
    "making you wonder how anyone could actually live here. East, you see "
    "the palace, an impressive white marble building. Far off to the west "
    "lies the harbour of Silvere.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is west.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "westway" || str == "road" || str == "here"; }
