/*
 * Small road toward the weaponsmith — east of westshop1.
 *
 * Strategy A FluffOS room. Original is
 * wsmithroad1_ldmud.lpc. Archive stub: no AddDetail.
 * East continues to wsmithroad2; the shop is not
 * loaded from here.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westshop1",
    "w": "/d/silvere/rooms/west/westshop1",
    "east": "/d/silvere/rooms/west/wsmithroad2",
    "e": "/d/silvere/rooms/west/wsmithroad2",
  ]);
  extras = ([ ]);
}

string query_short() { return "small road"; }

string query_long() {
  return
    "This is a small road, that leads from east to west. To the east "
    "the road leads into a shop. To the west is a crossing, where the "
    "road leads from north to south.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "road" || str == "here";
}
