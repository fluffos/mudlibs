/*
 * Lane north of westroad5 toward the post office.
 *
 * Strategy A FluffOS room. Original is wpostroad1_ldmud.lpc.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "south": "/d/silvere/rooms/west/westroad5",
    "s": "/d/silvere/rooms/west/westroad5",
    "north": "/d/silvere/rooms/west/wpostroad2",
    "n": "/d/silvere/rooms/west/wpostroad2",
    "east": "/d/silvere/rooms/west/wpostoffice",
    "e": "/d/silvere/rooms/west/wpostoffice",
  ]);
  extras = ([
    "office":
      "The post office is to the north and east of here.\n",
    "postoffice":
      "The post office is to the north and east of here.\n",
    "building":
      "The post office is to the north and east of here.\n",
  ]);
}

string query_short() { return "Westroad"; }

string query_long() {
  return
    "This is a road, that leads from north to south. The postoffice "
    "is now located to the NORTH of here.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are south, north and east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "road" || str == "lane" || str == "here"; }
