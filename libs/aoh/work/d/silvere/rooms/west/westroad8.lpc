/*
 * Westway wine-shop front — east of westroad7.
 *
 * Strategy A FluffOS room. Original (TimeMsg, north wineshop,
 * east westroad9) is westroad8_ldmud.lpc. North opens Chez
 * Brigan (look only); east continues to westroad9.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "west": "/d/silvere/rooms/west/westroad7",
    "w": "/d/silvere/rooms/west/westroad7",
    "east": "/d/silvere/rooms/west/westroad9",
    "e": "/d/silvere/rooms/west/westroad9",
    "north": "/d/silvere/rooms/west/wineshop",
    "n": "/d/silvere/rooms/west/wineshop",
  ]);
  extras = ([
    "sign":
      "The sign shows a picture of a wine glass filled with "
      "some red liquor. There is nothing written on it, just the "
      "picture.\n",
    "vines":
      "Dark green leaves cover the vines.\n",
    "vine":
      "Dark green leaves cover the vines.\n",
    "door":
      "The door of the wine shop is painted dark green. A sign "
      "hangs above it.\n",
    "shop":
      "The house north of you is painted rusty brown. Vines "
      "grow beside the door, and a sign is fixed above it.\n",
    "house":
      "The house north of you is painted rusty brown. Vines "
      "grow beside the door, and a sign is fixed above it.\n",
    "houses":
      "The houses are brightly coloured and obviously belong "
      "to rather wealthy people. Most of them have shops on the ground "
      "floor.\n",
    "glass":
      "The picture looks quite realistic.\n",
  ]);
}

string query_short() { return "Westway. North is a wine merchant's shop"; }

string query_long() {
  return
    "The houses lining the street are painted in bright colours, competing in "
    "splendour with the attire of their owners who are milling around busily "
    "during daytime. Everybody who is of any importance among Silvere's "
    "merchants owns a shop somewhere along Westway. This close to the palace, "
    "the shops are getting even more fancy (and more expensive, of course). "
    "North of you is the entrance to a small, but very exclusive wine shop. "
    "The street is throbbing with life. All around you, people are buying, "
    "selling and hurrying around.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exits are west, east and north.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) { return str == "westway" || str == "road" || str == "here"; }
