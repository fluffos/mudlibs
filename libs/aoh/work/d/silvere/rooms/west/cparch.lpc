/*
 * Caves of Parch — west of westshop2.
 *
 * Strategy A FluffOS room. Original is cparch_ldmud.lpc.
 * Archive stub: no AddDetail. Cave interiors are blocked
 * in the archive and are not loaded this slice.
 */

mapping exits;
mapping extras;

void create() {
  exits = ([
    "east": "/d/silvere/rooms/west/westshop2",
    "e": "/d/silvere/rooms/west/westshop2",
  ]);
  extras = ([ ]);
}

string query_short() { return "Caves of Parch"; }

string query_long() {
  return
    "This is the entrance to the Caves of Parch.  Long ago, according "
    "to legend, an ancient magical creature named Parch dwelt in "
    "these caves, guarding incomprehensible riches of mythical "
    "proportions.  Currently, the cave entrance is blocked.\n";
}

string long() { return query_long(); }

string query_exit(string dir) {
  if (!exits || !dir)
    return 0;
  return exits[dir];
}

string query_exit_string() {
  return "The obvious exit is east.\n";
}

string query_item(string s) {
  if (!extras || !s)
    return 0;
  return extras[s];
}

int id(string str) {
  return str == "caves" || str == "entrance" || str == "here";
}
