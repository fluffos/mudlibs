//tulong.c

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create() {
  set_name(GRN "血刃", ({ "xue ren", "xue", "ren", "dao" }));
  set_weight(25000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("weapon_prop/strength", 400);
    set("weapon_prop/karma", 50);
    set("weapon_prop/dodge", 100);
    set("weapon_prop/blade", 100);
    set("weapon_prop/constitution", 600);
    set("value", 5000000);
    set("material", "iron");
    set("long", "传说中的邪刀.刀的身体通红.从刀身上上隐隐约约散发出一阵阵重重的杀气....\n");
    set("wield_msg", HIR "$N想起自己已故的亲人.低声的说道:“血债血偿”.从背后抽出一把血色长刀....！
" NOR + "\n" NOR);
    set("unwield_msg", HIM "$N将$n" + HIY "回归鞘内，轻叹:非我族者，其心必异！。" NOR + "\n" NOR);
  }
  init_blade(1500, 4);
  setup();
}
int hit_ob(object me, object victim, int damage_bonus) {
  victim->apply_condition("xuecan_poison", 200);
  victim->start_busy(1);
  return damage_bonus;
}
void init() {
  if (this_player() != environment())
    add_action("do_get", "get");
}
int query_autoload() { return 1; }
