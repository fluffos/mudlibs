// by tiantian(www.wangcf.com) 2001.4
// 设定房间的描述

#include <ansi.h>
#include <group.h>

int main(object me, string arg) {
  string action, desc, line, *desc1;
  mapping desc_all;
  object env;
  env = environment(me);

  if (!env)
    return 0;

  if (!me->query("group"))
    return notify_fail("你并没有加入任何帮派。\n");

  if (me->query("group/level") < GROUP_VICE_MASTER)
    return notify_fail("只有副帮主才能修改房间名称。\n");

  if (env->query("group") != me->query("group/group"))
    return notify_fail("这里不是我派的领地。\n");

  if (env->query("no_change"))
    return notify_fail("这里不能修改。\n");

  if (!arg) {
    if (env->query("item_desc")) {
      desc_all = env->query("item_desc");
      desc1 = keys(desc_all);

      if (!sizeof(desc1))
        return notify_fail("这里没有设描述。\n");

      line = "这里的描述有\n\n";

      for (int i = 0; i < sizeof(desc1); i++) {
        line += sprintf(
          HIR " 描述名" NOR " %-20s   " HIG " 描述内容" NOR " %s \n" NOR,
          desc1[i], env->query("item_desc/" + desc1[i]));
      }
      write(line + "\n");
      return 1;
    }
    write("这里没有设描述。\n");
    return 1;
  }

  if (sscanf(arg, "%s %s %s", action, desc, line) == 3) {
    if (action == "-a") {
      if (strlen(desc) > 20)
        return notify_fail("描述名太长了，想个短点的名字吧。\n");
      env->set("item_desc/" + desc, line);
      GROUP_D->save_room(me, file_name(env) + ".lpc");
      write("设定描述完成。\n");
      return 1;
    }
  }

  if (sscanf(arg, "%s %s", action, desc) == 2) {
    if (action == "-d") {
      if (!env->query("item_desc/" + desc))
        return notify_fail("这里没有这个描述。\n");

      env->delete("item_desc/" + desc);
      GROUP_D->save_room(me, file_name(env) + ".lpc");
      write("取消描述设定完成。\n");
      return 1;
    }
  }

  return notify_fail("语法错误，请用help gsetdesc查看帮助。\n");
}

int help(object me) {
  write(@HELP
----------------------------------------
指令格式 : gsetdesc -a <描述名> <描述>  : 增加一个描述
           gsetdesc -d <描述名>         : 去除一个描述
           gsetdesc                     : 查看房间的描述

相关指令：gsetshort gsetlong

----------------------------------------
HELP
  );
  return 1;
}
