// by tiantian(www.wangcf.com) 2001.4
// 设置帮派留言板

#include <ansi.h>
#include <group.h>
int save_board(object me, string boardfile, int flag);

int main(object me, string arg) {
  object env, board;
  string *line;
  int i, j;
  string boardfile, str;

  if (!me->query("group"))
    return notify_fail("你并没有加入任何帮派。\n");

  if (me->query("group/level") < GROUP_MASTER)
    return notify_fail("只有帮主才能设置留言板。\n");

  if (!arg)
    return notify_fail("指令格式：gsetboard [here|cancel|name]。\n");

  env = environment(me);
  if (!env)
    return 0;
  if (env->query("group") != me->query("group/group"))
    return notify_fail("这里不是我派的领地。\n");
  if (file_name(env) + ".lpc" != GROUP_D->query_home(me))
    return notify_fail("请去帮派总坛设定留言板。\n");

  boardfile = GROUP_D->query_cwd(me) + "board.lpc";

  if (arg == "here") {
    if (env->query("board"))
      return notify_fail("贵帮派已有留言板了。\n");
    if (env->query("gold") < 1000)
      return notify_fail("贵帮没有足够的资金建造留言板。\n");
    save_board(me, boardfile, 1);
    message_vision("$N叫了几个帮众在这个地方建立了一个留言版。\n", me);
    env->set("board", boardfile);
    env->add("gold", -1000);
    GROUP_D->save_group(me);
    load_object(boardfile)->move(env);
  } else if (arg == "cancel") {
    if (!env->query("board"))
      return notify_fail("贵帮派并没有设立留言板。\n");
    if (!(board = present("board", env)))
      return notify_fail("这里没有留言板。\n");
    env->delete("board");

    line = explode(read_file(GROUP_D->query_home(me)), "\n");
    for (i = 0; i < sizeof(line); i++) {
      if (line[i] == "\"" + boardfile + "\"->foo();")
        line[i] = "";
    }

    write_file(GROUP_D->query_home(me), implode(line, "\n"));
    destruct(present("board", env));
    GROUP_D->save_group(me);
    rm(boardfile);
    message_vision("$N叫了几个帮众拆掉了这里的留言版。\n", me);
  } else if (sscanf(arg, "name %s", str) == 1) {
    if (!env->query("board"))
      return notify_fail("贵帮派并没有设置留言板。\n");
    if (!(board = present("board", env)))
      return notify_fail("这里没有留言板。\n");
    if (strlen(str) > 20)
      return notify_fail("留名版的名字太长了。\n");
    str = GROUP_D->replace_color(str);
    board->set("name", str + NOR);
    save_board(me, boardfile, 0);
    write("留言版属性修改成功。\n");
  } else
    return notify_fail("指令格式：gsetboard [here|cancel|name]。\n");

  return 1;
}

int save_board(object me, string boardfile, int flag) {
  string str;
  object board;

  if (!flag)
    board = present("board", environment(me));
  str = "#include <ansi.h>\ninherit BULLETIN_BOARD;\n\nvoid create()\n{\n";
  str += sprintf("\tset(\"location\", \"%s\");\n", file_name(environment(me)));
  str += sprintf("\tset(\"board_id\", \"%s\");\n", me->query("group/group"));
  if (flag) {
    str += sprintf("\tset_name(\"%s\", ({\"board\"}));\n ", "留言版");
  } else {
    str += sprintf("\tset_name(\"%s\", ({\"board\"}));\n ", board->query("name"));
  }
  str += sprintf("\tset(\"long\", \"这是一个帮派留言版。\\n\");\n");
  str += sprintf("\tsetup();\n");
  str += sprintf("\tset(\"capacity\", 60);\n");
  str += sprintf("\treplace_program(BULLETIN_BOARD);\n}");
  if (!flag)
    rm(boardfile);
  write_file(boardfile, str);
  return 1;
}

int help(object me) {
  write(@HELP
----------------------------------------
指令格式：gsetboard [here|cancel|name]

说明：
gsetboard
here        ：设置board
cancel      ：取消board
name <名称> ：设定board名称

帮派建造留言板，需耗费一千两黄金。

----------------------------------------
HELP
  );
  return 1;
}
