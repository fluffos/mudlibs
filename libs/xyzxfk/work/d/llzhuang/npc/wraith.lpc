// wraith.c

inherit NPC;

int is_ghost() { return 1; }

void create() {
  set_name("翁四", ({ "wengsi" }));
  set("long",
    "一个披头散发，浑身是血的厉鬼，正在这里飘来飘去。\n");
  set("max_jing", 112000);
  set("max_qi", 114000);
  set("max_sen", 112000);
  set("max_neili", 111111);
  set("neili", 18000);
  set("jiali", 250);
  set("bellicosity", 520000);
  set("cor", 30);
  set("combat_exp", 211000000 + random(211000000));

  set_skill("pixie-jian", 520);
  set_skill("dodge", 2200);
  set_skill("parry", 2200);
  set_skill("sword", 2220);
  set_skill("force", 2800);  //防止别人来弹指
  set_skill("hamagong", 2200);
  set_skill("tiyunzong", 2200);
  map_skill("sword", "pixie-jian");
  map_skill("parry", "pixie-jian");
  map_skill("dodge", "tiyunzong");
  map_skill("force", "hamagong");
  set_temp("apply/attack", 50);

  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    "还..我..命..来...\n",
  }));

  set("shen_type", -1);
  setup();
  carry_object("/clone/weapon/changjian")->wield();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player())) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }
}
