// /NPC songjian.c
#include <ansi.h>
inherit NPC;
void create() {
  set_name("松剑", ({ "song jian", "song" }));
  set("long",
    "站在你面前的是个30来岁的怨妇, 瓜子脸蛋,\n" +
    "眼如点漆, 清秀绝俗,可总有一股淡淡的忧伤.\n" +
    "你总觉得在哪见过她.\n");
  set("gender", "女性");
  set("age", 38);
  set("attitude", "peaceful");
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("per", 23);
  set("dex", 25);
  set("per", 28);
  set("qi", 80000);
  set("max_qi", 80000);
  set("jing", 50000);
  set("max_jing", 50000);
  set("neili", 500000);
  set("max_neili", 500000);
  set("jiali", 20);
  set("combat_exp", 50000000);

  set_skill("force", 700);
  set_skill("unarmed", 700);
  set_skill("dodge", 800);
  set_skill("parry", 700);
  set_skill("sword", 800);
  set_skill("zhemei-shou", 800);
  set_skill("liuyang-zhang", 800);
  set_skill("xunfu-jianfa", 800);
  set_skill("yueying-wubu", 800);
  set_skill("bahuang-gong", 700);
  map_skill("force", "bahuang-gong");
  map_skill("dodge", "yueying-wubu");
  map_skill("unarmed", "liuyang-zhang");
  map_skill("parry", "liuyang-zhang");
  map_skill("sword", "xunfu-jianfa");

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: command("enable unarmed zhemei-shou") :),
    (: command("enable unarmed liuyang-zhang") :),
  }));
  prepare_skill("sword", "xunfu-jianfa");
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "sword.xunfu" :),
  }));
  create_family("灵鹫宫", 3, "弟子");
  setup();
  carry_object("/d/lingjiu/obj/qingyi")->wear();
  carry_object("/d/lingjiu/obj/doupeng")->wear();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/lingjiu/obj/key");
  add_money("silver", 15);
}
