// daofengling.c 刀锋凌
inherit NPC;
void create() {
  set_name(HIG "刀锋凌" NOR, ({ "dao fengling", "dao", "fengling" }));
  set("title", HIY "守身独净" NOR);
  set("nickname", HIB "独善其身" NOR);
  set("gender", "男性");
  set("age", 44);
  set("long", "他据说是杀手楼主刀锋冷的弟弟,因为厌恶杀戮而避居于世。\n");

  set("no_get", 1);
  set("no_give", 1);
  set("combat_exp", 200000000);
  set("shen_type", 0);
  set("attitude", "peaceful");

  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  setup();
  carry_object("/clone/cloth/zixuan")->wear();
  add_money("silver", 2);
}
