// xiaochunshui.c 萧春水
inherit NPC;
void create() {
  set_name(HIR "萧春水" NOR, ({ "xiao chunshui", "xiao", "chunshui" }));
  set("title", HIC "侠之大者" NOR);
  set("nickname", HIM "舍心为国" NOR);
  set("gender", "男性");
  set("age", 26);
  set("long", "大侠萧秋水的弟弟,江湖阅历比他老哥少不了多少。\n");

  set("max_qi", 750000);
  set("max_neili", 3000000);
  set("neili", 3000000);
  set("combat_exp", 500000000);
  set("shen_type", 0);
  set("attitude", "peaceful");

  set_skill("unarmed", 1500);
  set_skill("dodge", 1500);
  set_skill("force", 1500);
  set_skill("parry", 1500);
  set_skill("qishang-quan", 1500);
  map_skill("unarmed", "qishang-quan");
  set_temp("apply/attack", 500);
  set_temp("apply/defense", 500);
  setup();
  carry_object("/clone/cloth/zixuan")->wear();
  add_money("gold", 200);
}
