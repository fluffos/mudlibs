// jinjunshiwei.c 禁军侍卫
inherit NPC;
void create() {
  set_name(HIR "禁军侍卫" NOR, ({ "jinjun shiwei", "jinju", "shiwei" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "一位威风凌凌的禁军侍卫,他看起来似乎身手不凡。\n");

  set("combat_exp", 300000000);
  set("shen_type", 0);
  set("attitude", "peaceful");

  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  set_skill("dodge", 3000);
  set_skill("qishang-quan", 3000);
  map_skill("unarmed", "qishang-quan");
  set_skill("parry", 3000);
  map_skill("parry", "qishang-quan");
  setup();
  carry_object("/clone/misc/shiweifu")->wear();
  add_money("silver", 2);
}
