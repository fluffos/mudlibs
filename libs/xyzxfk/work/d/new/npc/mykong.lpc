// moyankong.c 莫言空
inherit NPC;
void create() {
  set_name(HIM "莫" HIR "言" HIY "空", ({ "moyan kong", "moyan", "kong" }));
  set("gender", "男性");
  set("age", 45);
  set("long", "一个神秘身份的过客,说不清楚他到底是干什么的。\n");

  set("combat_exp", 1000000000);
  set("shen_type", -1);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 100000);
  set("max_jing", 60000);
  set("neili", 500000);
  set("max_neili", 300000);
  set("jingli", 1000000);
  set("max_jingli", 1000000);
  set("jiali", 5000);

  set_skill("unarmed", 1500);
  set_skill("dodge", 1500);
  set_skill("sword", 1500);
  set_skill("parry", 1500);
  set_skill("force", 1500);
  set_skill("pixie-jian", 520);
  set_skill("huoyan-dao", 1500);
  set_skill("taixuan-gong", 1500);
  map_skill("unarmed", "huoyan-dao");
  map_skill("sword", "pixie-jian");
  map_skill("dodge", "pixie-jian");
  map_skill("parry", "huoyan-dao");
  map_skill("force", "taixuan-gong");
  set("chat_chance", 6);
  set("chat_msg", ({
    (: command("'") :),
    (: command("unwield jian") :),
    (: command("wield jian") :),
  }));
  prepare_skill("unarmed", "huoyan-dao");
  prepare_skill("sword", "pixie-jian");
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "sword.cimu" :),
    (: perform_action, "sword.sanlianci" :),
    (: perform_action, "unarmed.honglian" :),
    (: exert_function, "force.roar" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/clone/cloth/qsx")->wear();
  carry_object("/clone/cloth/ctguan")->wear();
  carry_object("/clone/cloth/bylv")->wear();
  carry_object("/clone/weapon/huolin")->wield();
  add_money("gold", 200);
}
