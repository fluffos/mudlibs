// xiongbatian.c

inherit NPC;
inherit F_DEALER;
//    inherit F_BANKER;       	
void create() {
  set_name(HIR "雄霸天" NOR, ({ "xiongba tian", "xiongba" }));
  set("title", HIM "武林神话" NOR);
  set("nickname", HIC "胸怀天下" NOR);
  set("gender", "男性");
  set("age", 150);
  set("long",
    CYN "雄霸天,武林神话的化身,是正义与邪恶的评裁者,据说其功夫已达到天人合一的地步！\n");
  create_family("雄霸天下", 3, "帮主");
  set("max_qi", 3000000);
  set("max_jing", 3000000);
  set("neili", 3000000);
  set("max_jingli", 50000);
  set("max_neili", 50000);
  set("jingli", 3000000);
  set("combat_exp", 1800000000);
  //        set("shen", 0);
  set("str", 3000);
  set("dex", 3000);
  set("con", 3000);
  set("per", 3000);
  set("int", 3000);
  set("inquiry", ([
    "name": "我就是雄霸天。",
    "雄霸天下": "是我们的地盘,我就是那里的老大啊。",
    "大少": "一个江湖后辈,不过功夫还可以吧.",
    "阿飞": "听说工夫还可以吧,据说他是天神的使者,不知道是不是真的.",
    "侠义": "大丈夫在世,舍侠义何为?!",
    "葡萄": "不世出的江湖奇杰,谈笑风云,不错不错.",
    "天下争霸": "就凭你也想争霸天下?回家抱孩子吧,哈哈哈哈。",
  ]));
  set("attitude", "friendly");
  set_skill("parry", 5000);
  set_skill("sword", 5000);
  set_skill("unarmed", 5000);
  set_skill("force", 5000);
  set_skill("dodge", 5000);
  set_skill("riyue-bian", 5000);
  set_skill("whip", 5000);
  set_skill("qufeng", 2500);
  set_skill("literate", 5000);
  set_skill("qiankundanuoyi", 5000);
  set_skill("xuantie-jianfa", 5000);
  set_skill("liumai-shenjian", 5000);
  set_skill("taixuan-gong", 5000);
  set_skill("yan-shuangfei", 50000);
  map_skill("force", "taixuan-gong");
  map_skill("sword", "xuantie-jianfa");
  map_skill("parry", "xuantie-jianfa");
  map_skill("dodge", "yan-shuangfei");
  map_skill("unarmed", "liumai-shenjian");
  prepare_skill("sword", "xuantie-jianfa");
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "sword.haichao" :),
  }));
  set("jiali", 2625);
  set("vendor_goods", ({
    "clone/cloth/hjszjia",
  }));
  setup();
  carry_object("clone/cloth/zixuan")->wear();
  carry_object("clone/cloth/lingyun")->wear();
  carry_object("clone/cloth/fengting")->wear();
  carry_object("kungfu/class/taohua/obj/ruanwei")->wear();
  carry_object("clone/drug/yydan");
  //           carry_object("clone/drug/huanyang");	
  carry_object("d/gumu/obj/xuantiejian")->wield();
  carry_object("clone/weapon/longyin")->wield();

  add_money("thousand-gold", 5);
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
  /*
if (base_name(environment())!=this_object()->query("startroom")) return;	
add_action("do_check", "check");	
add_action("do_check", "cha");	
add_action("do_convert", "convert");	
