// fengming.c  凤鸣青宵
// by star
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object ob, weapon, myweapon;
  string msg, string1;
  int skill, myskill;
  if (!target) target = offensive_target(me);

  if (!me->is_fighting())
    return notify_fail("「凤鸣青宵」只能在战斗中使用。\n");

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「凤鸣青宵」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("「凤鸣青宵」开始时必须拿着一把剑！\n");

  if ((int)me->query("neili") < 10000)
    return notify_fail("你的真气不够！\n");

  if ((int)me->query_skill("sword", 1) < 250 ||
    me->query_skill_mapped("sword") != "lonely-sword")
    return notify_fail("你的独孤十八剑还不到家，无法使用凤鸣青宵！\n");

  if ((int)me->query_skill("lonely-sword", 1) < 300)
    return notify_fail("你的独孤十八剑还不到家，无法使用凤鸣青宵！\n");

  if (!objectp(weapon = target->query_temp("weapon")))
    return notify_fail("对方手中并没有兵器！\n");

  weapon = target->query_temp("weapon");
  myweapon = me->query_temp("weapon");
  message_vision(
    HIR "\n$N口中念念有词，手中" + myweapon->query("name") + "竟然渐渐发出一股无与伦比的王者之气！\n" NOR,
    me,
    target
  );
  skill = target->query_skill("parry", 1);             // 32
  myskill = me->query_skill("lonely-sword", 1);
  if (random(myskill) < random(skill / 2) || me->query("max_neili") < random(target->query("max_neili"))) {
    msg = HIY "$n微微一笑,竟似不为所动！\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(3);
    me->add("neili", -100);
    return 1;
  }

  msg = HIR "只听九天之上传来一阵凤鸣,$n只觉得心中惶恐不已，\n手中" + weapon->query("name") + HIR "竟然把握不住,掉在地上！\n" NOR;
  message_vision(msg, me, target);
  msg = "$N狂笑一声,飞身扑去！\n" NOR;
  message_vision(msg, me, ob);
  me->clean_up_enemy();
  ob = me->select_opponent();
  weapon->move(environment(me));

  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
  ob->start_busy(1);
  me->add("neili", -1500);
  me->start_busy(1);
  return 1;
}
