inherit ITEM
;
void init(){       add_action("do_gift","gift")
;
}
void create(){        set_name( HIR"天下无雪的口袋", ({ "falling" }) )
;
set_weight(1000)
;
set("unit", "个")
;
setup()
;
}
int do_gift(string arg){    int count
;
object me,ob
;
string target,gift_file
;
if(!arg)  return notify_fail("gift 派礼物给在线玩家，命令格式： gift </路径/../目标文件名> <数量>\n\n")
;
if (sscanf(arg, "%s %d", target, count) != 2 ) target = arg
;
