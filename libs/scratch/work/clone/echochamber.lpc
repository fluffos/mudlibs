/*
 * Scratch echo chamber. Original process_input only dumped %O.
 * look/score/quit added so the catalog bar works; unknown input
 * still echoes as %O (that is the lib).
 */

string name;

void write_prompt();
mixed process_input(string input);

void create() {
  name = "guest";
}

void logon() {
  write("\nScratch mudlib — echo chamber.\n");
  write("If you consider Lil to have too much, start from Scratch.\n");
  write("Commands: look, score, quit. Anything else is echoed.\n\n");
  write_prompt();
}

void write_prompt() {
  write("> ");
}

string query_name() { return name; }

int cmd_look(string arg) {
  write("The echo chamber\n");
  write("An empty FluffOS starter by rmanis (the Lil author).\n");
  write("There are no rooms, accounts, or exits. Your words come back as %O.\n");
  return 1;
}

int cmd_score(string arg) {
  write(capitalize(name) + " (Scratch guest)\n");
  write("This is a bootstrapping mudlib, not a game. No stats.\n");
  return 1;
}

int cmd_quit(string arg) {
  write("Goodbye.\n");
  destruct(this_object());
  return 1;
}

mixed process_input(string input) {
  string verb, rest;

  if (!input)
    input = "";
  input = replace_string(input, "\r", "");
  if (input == "") {
    write_prompt();
    return 1;
  }
  if (sscanf(input, "%s %s", verb, rest) != 2) {
    verb = input;
    rest = 0;
  }
  switch (verb) {
    case "look":
    case "l":
      cmd_look(rest);
      write_prompt();
      return 1;
    case "score":
    case "sc":
      cmd_score(rest);
      write_prompt();
      return 1;
    case "quit":
      cmd_quit(rest);
      return 1;
  }
  /* original behavior */
  printf("%O\n", input);
  write_prompt();
  return 1;
}
