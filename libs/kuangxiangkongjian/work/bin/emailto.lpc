#include <stdio.h>

main (int argc, char *argv[])
{
  char fn[81];

  if (argc != 2) {
    fprintf (stderr, "Usage: %s 要搬的档案.\n");
    return (1);
  }

  while (1) {
    sprintf (fn, "cp %s /home/ice/u01/grad81/jjchen/test", argv[1]);
    system (fn);
    sprintf (fn, "rm %s", argv[1]);
    system (fn);
    sleep (218);
  }
}
