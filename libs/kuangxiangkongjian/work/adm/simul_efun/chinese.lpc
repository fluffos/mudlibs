
string chinese_number(int i)
{
	return CHINESE_D->chinese_number(i);
}

string to_chinese(string str)
{
	return CHINESE_D->chinese(str);
}

int is_chinese(string str)
{
	// AGENTS.md §15h: this driver's str[i] is a Unicode codepoint, not a
	// raw GBK byte -- the old lead-byte range check (str[0]>160&&<255)
	// is now always false for real Chinese text. Check the CJK Unified
	// Ideographs codepoint range instead.
	if( strlen(str)>=1 && str[0]>=0x4e00 && str[0]<=0x9fff ) return 1;
	return 0;
}
