// 用来清查机器人的程式
// 只用简单的加法算术让玩家回答
// made by Konn 1996.9.4
//
void find_robot()
{
        object *user;
        int i, a, b, ans;

        user = users();
        for(i=0; i<sizeof(user); i++) {
            if( wizardp(user[i])               ||  // 巫师不需要查
                user[i]->is_fighting()         ||  // 战斗就让他打
                user[i]->query_temp("netdead") ||  // 断线的也不用找
                in_edit(user[i])               ||  // 在编辑东西也不必
                in_input(user[i])              ||  // 读文章就让他专心读
                (query_idle(user[i])/60) >= 2  ||  // 发呆中的就放他一马吧
                !user[i]->query("id")            ) // 尚在login 中的没必要查
                continue;

            a = random(100) + 1;
            b = random(100) + 1;
            tell_object(user[i],
                 HIW+"\n系统要清查机器人, 请回答下面问题: \n\n");

            switch( random(8) ) {
                case 0:
                    tell_object(user[i],
                         sprintf("\t%d 乘以 %d 的个位数等于多少?\n\n", a, b)
                    );
                    ans = (a * b) % 10;
                    break;
                case 1:
                    tell_object(user[i],
                         sprintf("\t%d 乘以 %d 共有几位数?\n\n", a, b)
                    );
                    a *= b;
                    ans = 0;
                    while( a ) {
                        a /= 10;
                        ans++;
                    }
                    break;
                case 2:
                    tell_object(user[i],
                         sprintf("\t%d 除以 %d 的商数等于多少?\n\n", a, b)
                    );
                    ans = a / b;
                    break;
                case 3:
                    tell_object(user[i],
                         sprintf("\t%d 除以 %d 的余数等于多少?\n\n", a, b)
                    );
                    ans = a % b;
                    break;
                case 4:
                    tell_object(user[i],
                         sprintf("\t%d 除以 %d 的商数的个位数等于多少?\n\n", a, b)
                    );
                    ans = a / b;
                    ans %= 10;
                    break;
                case 5:
                    tell_object(user[i],
                         sprintf("\t%d 除以 %d 的商数的十位数等于多少?\n\n", a, b)
                    );
                    ans = a / b;
                    ans /= 10;
                    if( ans >= 10 ) ans %= 10;
                    break;
                case 6:
                    tell_object(user[i],
                         sprintf("\t%d 除以 %d 的余数的个位数等于多少?\n\n", a, b)
                    );
                    ans = a % b;
                    ans %= 10;
                    break;
                case 7:
                    tell_object(user[i],
                         sprintf("\t%d 除以 %d 的余数的十位数等于多少?\n\n", a, b)
                    );
                    ans = a % b;
                    ans /= 10;
                    if( ans >= 10 ) ans %= 10;
                    break;
            }

            tell_object(user[i], "请用ans 作答.\n\n"+NOR);
            user[i]->set_temp("robot/must_ans", 1);
            user[i]->set_temp("robot/ans", ans);
        }
        call_out("robot_ans", 50);
        call_out("find_robot", 1000);
}

void robot_ans()
{
        object *user;
        int i;

        user = users();
        for(i=0; i<sizeof(user); i++) {
            if( !user[i]->query_temp("robot/must_ans") ||
                !user[i]->query("id")                    )
                continue;

            tell_object(user[i], "你已经没机会了。\n");
            user[i]->delete_temp("robot");
            user[i]->save();
            user[i]->do_command("quit");
        }
}

void auto_reboot()
{
        object npc;

	if( uptime() > 72000 ) {
            npc = new(NPC_DEMOGORGON);
            npc->move("/u/k/konn/workroom");
            npc->start_shutdown(5);
        }
        else call_out("auto_reboot", 30);
}

