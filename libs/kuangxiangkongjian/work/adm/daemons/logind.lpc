void create() {
  seteuid(getuid());
  set_temp("channel_id", "连线精灵");
}

// logon --> logonn
void logon(object ob) {
  object *usr;
  int i, wiz_cnt, ppl_cnt, login_cnt;
  cat(WELCOME, 1);
  UPTIME_CMD->main();

  usr = users();
  wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (!environment(usr[i])) login_cnt++;
    else if (wizardp(usr[i])) wiz_cnt++;
    else ppl_cnt++;
  }
  printf("目前共有 %d 位玩家在线上，以及 %d 位使用者尝试连线中。\n\n",
    ppl_cnt, login_cnt);

  write("您的英文名字：");
  input_to((: get_id :), ob, 1);
}

// 为了要输入太多次之后能够断线, 增加了一个参数 times
// void get_id(string arg, object ob)
// 其他地方的参数修改不予以一一列出
// fixed by wade Thu Sep 28 1995
void get_id(string arg, object ob, int times) {
  int all_players = 0, all_wizs = 0, i;
  object *all_user;
  object ppl, user;
  string my_ip, ip1, ip2, ip3, ip4, ipp1, ipp2, ipp3, ipp4;


  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    // 底下这个 if 是为了要输入太多次之后能够断线
    // fixed by wade Thu Sep 28 1995
    if (times >= 3) {
      write("对不起, 您输入太多次了。\n");
      destruct(ob);
      return;
    }
    write("您的英文名字：");
    input_to("get_id", ob, times + 1);
    return;
  }

  /*
//
//
//
  if( SECURITY_D->get_status(arg) == "(player)" ) {
      destruct(ob);
      return;
  }
*/

#ifdef MAX_USERS
  for (all_user = users(), i = 0; i < sizeof(all_user); i++)
    if (!wizardp(all_user[i]) && all_user[i]->query("id"))
      all_players++;
    else if (wizardp(all_user[i]) && all_user[i]->query("id"))
      all_wizs++;
  if (all_players >= MAX_USERS - 10) {
    if ("" + SECURITY_D->get_status(arg) == "(player)" || arg == "guest") {
      write("对不起，" + MUD_NAME + "的玩家已经太多了，请待会再来。\n");
      destruct(ob);
      return;
    }
    if (all_wizs >= 7 &&
      "" + SECURITY_D->get_status(arg) != "(admin)" &&
      "" + SECURITY_D->get_status(arg) != "(manager)" &&
      "" + SECURITY_D->get_status(arg) != "(guest)" &&
      "" + SECURITY_D->get_status(arg) != "(arch)") {
      write("对不起，" + MUD_NAME + "的玩家已经太多了，请待会再来。\n");
      destruct(ob);
      return;
    }
  }
#endif
  if ((string)ob->set("id", arg) != arg) {
    write("Failed setting user name.\n");
    destruct(ob);
    return;
  }

  if (arg == "guest") {
    if (user = find_player("guest"))
      if (interactive(user)) {
        write("对不起, 已经有一只 guest 在里面混了。\n");
        destruct(ob);
        return;
      } else destruct(user);
    // If guest, let them create the character.
    ob->set("name", "神秘过路客");
    ob->set("password", crypt("guest", 0));
    ob->set("body", USER_OB);
    user = make_body(ob);
    user->set("gender", "男性");
    write("\n欢迎参观狂想空间。\n");
    enter_world(ob, user);
    return;
  } else if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    for (i = 0; i < sizeof(banned_ip); i++) {
      if (strsrch(query_ip_number(ob), banned_ip[i]) == 0) {
        write("对不起，这种位址目前被停用。\n");
        destruct(ob);
        return;
      }
    }

    /*
// 这部份是用来防止multilogin, 虽然效果不会很好, 但会慢慢的改正!
//
//			made by Konn
//
    my_ip = query_ip_number(ob);
    sscanf(my_ip, "%s.%s.%s.%s", ip1, ip2, ip3, ip4);
    for(i=0; i<sizeof(all_user); i++) {
      sscanf(query_ip_number(all_user[i]), 
	     "%s.%s.%s.%s", ipp1, ipp2, ipp3, ipp4);
      if( all_user[i]->query("id")  
      &&  all_user[i]->query("id") != ob->query("id") 
      &&  ip1 == ipp1 && ip2 == ipp2 ) {
	if( ip3 == ipp3 ) {
	  if( ip4 == ipp4 ) {
	    write("很抱歉, 你的这个IP已经有人先使用了, 请换一台电脑用吧.\n");
	    destruct(ob);
	    return ;
          }
//
          else if( query_idle(all_user[i]) > 10 	
	       &&  query_idle(all_user[i]) < 60 ) {
	    write("很抱歉, 你的IP有多重login 的嫌疑, 系统不允许\进入.\n");
            destruct(ob);
            return ;
          }
//
	}
//
	else if( query_idle(all_user[i]) > 10 
	     &&  query_idle(all_user[i]) < 60 ) {
	    write("很抱歉, 你的IP有多重login 的嫌疑, 系统不允许\进入.\n");
            destruct(ob);
            return ;
	}
//
      }
    }
*/

    if (ob->restore()) {
      write(arg + " 已经注册过了, 请输入密码：");
      input_to("get_passwd", 1, ob);
      return;
    } else {
      write("您的人物档案出了一些问题，请利用 guest 进入通知巫师处理。\n");
      destruct(ob);
      return;
    }
  } else {
    for (i = 0; i < sizeof(banned_id); i++) {
      if (strsrch(arg, banned_id[i]) == 0) {
        write("对不起，名字不能由 " + banned_id[i] + " 当开头。\n");
        destruct(ob);
