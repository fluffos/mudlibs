// recover.c

int exert(object me, object target)
{
	int force,max_force;
	if( target != me ) 
	return notify_fail("你只能用内功\调匀自己的气息。\n");	
        if( (int)me->query("force") < 20)
	return notify_fail("你的内力不够。\n");
        me->receive_heal("kee", 10+ (int)me->query_skill("force")/3);
	me->add("force", -20);
 
	message_vision("[36m$N深深吸了几口气，脸色看起来好多了。[0m\n", me);

// 因为 recover 和 exercise 可以互换
// 当 force level 大于一定值,recover 合 exercise 互换会kee,force 皆越换越多
// 故以上限简查来中止互换练功

	force = me->query("force");
	max_force = me->query("max_force");
	if( force > max_force )
	    me->set("force",max_force);   
	 
	if( me->is_fighting() ) me->start_busy(1);

	return 1;
}
