// burn.c
#include <combat.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {

  if (!living(me)) {
    message("vision", me->name() + "身上的灼伤尚未痊愈, 但是觉得似乎油尽灯枯\了!!\n",
      environment(me), me);
  } else if (duration > 13) {
    tell_object(me, "你的灼伤似乎很严重, 伤口焦黑.\n");
    message("vision", me->name() + "身上发热巨痛, 并有严重脱水的现象. \n",
      environment(me), me);
    me->receive_wound("kee", 10);
    // modify by oda
    // me->receive_damage("water",50);
    if ((int)me->query("water") >= 50)
      me->add("water", -50);
    else
      me->set("water", 0);
  } else if (duration > 5) {
    tell_object(me, "你觉得身上的灼伤开始褪皮了, 伤口红肿疼痛. \n");
    message("vision", me->name() + "伤口仍发热肿痛, 但脱水症状有所减轻\n",
      environment(me), me);
    me->receive_wound("kee", 5);
    // modify by oda
    // me->receive_damage("water",30);
    if ((int)me->query("water") >= 30)
      me->add("water", -30);
    else
      me->set("water", 0);
  } else {
    tell_object(me, "你身上的灼伤开始结疤了, 也感觉不到痛苦了. \n");
    message("vision", me->name() + "的身上有一道新疤, 好像受到不轻的伤害. \n",
      environment(me), me);
    me->receive_damage("kee", 2);
    // modify by oda
    // me->receive_damage("water",10);
    if ((int)me->query("water") >= 10)
      me->add("water", -10);
    else
      me->set("water", 0);
  }
  me->apply_condition("burn", duration - 1);
  COMBAT_D->report_status(me, 1);
  if (duration < 1)
    return 0;
  return 1;
}
