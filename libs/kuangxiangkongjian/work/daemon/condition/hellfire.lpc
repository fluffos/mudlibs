//hellfire by funkcat
// bleeding.c
#include <combat.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (!living(me)) {
    message("vision", me->name() + "被地狱之业火活活烧死了!!\n",
      environment(me), me);

  } else if (duration > 6) {
    message("vision", me->name() + HIR "身上燃烧着诡异的黑火。\n" NOR,
      environment(me), me);
    me->receive_wound("kee", 60);
    me->receive_damage("sen", 20);
    me->receive_damage("gin", 30);

  } else if (duration > 2) {
    message("vision", me->name() + "身上不断冒出黑烟还有肌肉燃烧的臭味。\n",
      environment(me), me);
    me->receive_damage("kee", 50);
    me->receive_damage("sen", 10);
    me->receive_damage("gin", 20);

  } else {
    tell_object(me, HIR "黑火渐渐熄灭。\n" NOR);
    message("vision", me->name() + "身上的黑色火焰渐渐熄灭。\n",
      environment(me), me);
    me->receive_damage("kee", 30);
    me->receive_damage("sen", 3);
    me->receive_damage("gin", 5);
  }
  me->apply_condition("hellfire", duration - 1);
  COMBAT_D->report_status(me, 1);
  if (duration < 1)
    return 0;
  return 1;
}
