// rose_poison.c

#include <ansi.h>

int update_condition(object me, int duration)
{
     if(duration==0) return 0;
	me->receive_wound("gin",20-me->query_skill("force",1)/20);
	me->receive_wound("kee",50-me->query_skill("force",1)/20);
	me->receive_wound("sen",20-me->query_skill("forcr",1)/20);
        me->start_busy(2);
     me->apply_condition("five_poison",duration-1);
        message_vision(
   HIY "$N中了五毒神掌，毒性开始发作！\n" NOR,me);
	if( duration < 1 ) return 0;
	return 1;
}
