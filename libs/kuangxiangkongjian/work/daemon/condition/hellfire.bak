//hellfire by funkcat
// bleeding.c
#include <combat.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{											
	if( !living(me) ) {
		message("vision", me->name() + "罪孽太重，被地狱之业火燃烧殆尽!!\n",
			environment(me), me);

	} else if( (duration > 30) && (me->query("bellicosity")>(2*(duration-30)))) {
		tell_object(me,HIR"熊熊的黑色火焰正燃烧着你，为你洗清一切罪孽。\n"NOR);
		message("vision", me->name() + HIR"身上燃烧着诡异的黑火。\n"NOR,
			environment(me), me);
		me->receive_damage("kee", 20);
		me->receive_damage("sen",30);
		me->receive_damage("gin",30);
		me->add("bellicosity",-2);				

	} else if( duration > 10 ) {
		tell_object(me, HIR"随着地狱业火的燃烧，你的罪孽渐渐随着浓烟烟消云散。\n"NOR);
		message("vision", me->name() + "身上不断冒出黑烟还有肌肉燃烧的臭味。\n",
			environment(me), me);
		me->receive_damage("sen",15);
		me->receive_damage("kee",10);
		me->receive_damage("gin",15);

	} else if( duration > 5 ) {
                tell_object(me, HIR"黑火渐渐熄灭。\n"NOR);
                message("vision", me->name() + "身上的黑色火焰渐渐熄灭。\n",
                        environment(me), me);
                me->receive_damage("kee", 7);
                me->receive_damage("gin",3);
		me->receive_damage("sen",3);
	}    

	me->apply_condition("hellfire", duration - 1);
	COMBAT_D->report_status(me, 1);
	if( !duration )
	 	return 0;
	return 1;
}
