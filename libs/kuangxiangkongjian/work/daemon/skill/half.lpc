//分身术(write bye cyw)
#include <ansi.h>
int cast(object me, object target) {
  object halfman;


  if (!me->is_fighting())
    return notify_fail("你想起师父的告戒非到危险关头不可使用分身术！\n");

  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < 60)
    return notify_fail("你的精神无法集中！\n");

  message_vision("$N口里念着咒语‘卡~煞~哇~理~~~~分’。\n", me);

  me->add("mana", -100);
  me->receive_damage("sen", 60);
  me->start_busy(2);
  if (random(me->query("max_mana")) < 200) {
    message("vision", "但是什么也没有发生。\n", environment(me));
    return 1;
  }

  seteuid(getuid());
  halfman = new("/open/japan/npc/halfman.lpc");
  message_vision(
    HIW "$N的身影渐渐分离一化为二，变出了$N的分身。\n" NOR, me);
  halfman->set_name(me->name(), ({ me->query("id") }));
  halfman->move(environment(me));
  halfman->invocation(me);
  halfman->set_temp("id", me->query("id"));
  halfman->set("force", me->query("force") / 2);
  halfman->set("max_force", me->query("max_force") / 2);
  halfman->set("kee", me->query("kee") / 2);
  halfman->set("max_kee", me->query("max_kee") / 2);
  halfman->set("eff_kee", me->query("eff_kee") / 2);
  halfman->set("combat_exp", me->query("combat_exp") / 2);
  halfman->set("gender", me->query("gender"));
  halfman->set("age", me->query("age"));
  return 1;
}
