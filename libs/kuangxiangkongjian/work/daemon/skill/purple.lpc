inherit SKILL;
string *dodge_msg =
({
  "$n展开‘紫府迷踪步’中的‘迷途知返’，蹑空踏虚般翻越至$N的身后，闪开暴雨般的
   攻势。\n",

  "$n使出‘紫府迷踪步’中的‘迷离忽况’，脚下步法一盘一旋，不退反进，倏然往右侧
   迈进三步，即已斜闪过天罗般的招式。\n",
  "$n使出‘紫府迷踪步’中的‘迷踪幻影’，步法连踏，忽幻化成七具幻影，轻轻松松
   地避开$N的招式。\n",
  "$n展开‘紫府迷踪步’中的‘迷妄移霏’，忽左忽右，身形有如一片枯叶，轻轻飘开了
  三尺。\n",
  "$n使出‘紫府迷踪步’中最深奥的‘迷天萤回’，身形有如电闪云飘，捷同鬼魅般
  的从$N旁闪身而过。\n",
});
 int valid_enable(string usage)
{
 return (usage=="dodge")||(usage=="move");
}
 int valid_learn(object me)
 {
   if(me->query_skill("literate")*2 <= me->query_skill("purple-steps",1))
   return notify_fail("你的知识不足，无法了解紫府迷踪步中九宫八卦的精要变化。\n");
   return 1;
 }
 string query_dodge_msg(string limb)
 {
   return dodge_msg[random(sizeof(dodge_msg))];
 }
 int practice_skill(object me)
 {
   if((int)me->query("kee")<25)
       return notify_fail("你的气不够，不能练紫府迷踪步。\n");
   me->receive_wound("kee",25);
       return 1;
 }
