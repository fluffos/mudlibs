#include <ansi.h>

inherit SKILL;


int valid_learn(object me) {
  int up_exp, skill_exp, skill_level;
  object ob;

  skill_exp = me->query("skill_exp");
  skill_level = me->query_skill("fencing");
  up_exp = call_other(SKILL, "skill_level_up", 1, skill_level);  //有三种升级难度
  //1普通,2中等,3最难---------------------->^^^
  if (skill_level >= (me->query("level") + 10))
    return notify_fail("你等级太低，无法学习这么高等级的技能。\n");
  if (skill_exp < up_exp)
    return notify_fail("你的技能经验值不够。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你没有剑要我怎么教呢？\n");

  return 1;
}

//这里是这个skill的skill_points
int query_skill_points() { return 2; }
