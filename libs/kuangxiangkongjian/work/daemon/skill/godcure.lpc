// godcure.c
#include <ansi.h>
inherit SKILL;

mapping make = ([
  "force-medicine": ([
    1: "gold stone",
    2: "flower iron",
    3: "green stone",
  ]),
  "health-medicine": ([]),
  "outhealth-medicine": ([]),
  "rose-medicine": ([]),
  "snake-medicine": ([]),
  "flower-medicine": ([]),
]);
mapping make_name = ([
  "force-medicine": "调气丹",
  "health-medicine": "内伤药",
  "outhealth-medicine": "外伤药",
  "rose-medicine": "火玫瑰毒的解药",
  "snake-medicine": "蛇毒的解药",
  "flower-medicine": "去春丸",
]);
mapping make_need_lv = ([
  "force-medicine": 10,
  "health-medicine": 0,
  "outhealth-medicine": 40,
  "rose-medicine": 30,
  "snake-medicine": 20,
  "flower-medicine": 10,
]);
int valid_enable(string usage) {
  return (usage == "cure") || (usage == "force");
}

int valid_learn(object me) { return 1; }

int practice_skill(object me) {
  return notify_fail("华陀医术只能用学的。\n");
}

int make(object me, string name) {
  object medicine;
  int i;
  mapping dict;
  string pstr = "";
  if (!make[name])
    return notify_fail("华陀医术中没有这种药。\n");
  if (me->query_skill("godcure", 1) < make_need_lv[name])
    return notify_fail("你的医术修为不够，无法配制这种药。\n");
  dict = make[name];
  for (i = 1; i <= sizeof(dict); i++) {
    if (!present(dict[i], me))
      return notify_fail("你的药材不够，没办法配这种药。\n");
    medicine = present(dict[i], me);
    pstr += "(" + medicine->name() + ")";
  }
  message_vision(
    "$N用" + pstr + "来做" + make_name[name] + "。\n", me);
  for (i = 1; i <= sizeof(dict); i++)
    destruct(present(dict[i], me));
  medicine = new("obj/medicine/" + name);
  medicine->set("medicine_power", me->query_skill("cure"));
  medicine->move(me);
  return 1;
}
