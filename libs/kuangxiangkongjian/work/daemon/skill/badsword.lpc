// badsword.c by oda 
// npc 专用, 不开放玩家学

inherit SKILL;

mapping *action = ({
  ([
    "action": "$N面带微笑，使出哈哈儿的‘笑里藏刀’，背地里暗运内劲，忽地攻向$n下盘",
    "dodge": -20,
    "parry": -20,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N抽身一跃，满天剑影砍向$n，迷惑敌人耳目，正是一招萧咪咪的‘恶女迷魂’",
    "dodge": -30,
    "parry": 25,
    "damage": 40,
    "damage_type": "割伤"
  ]),
  ([
    "action": "$N不顾自己面门大开，一招‘损人害己’气运剑尖，扑身狂进，攻向$n周身大穴，正是白开心的绝招",
    "dodge": -35,
    "parry": 15,
    "damage": 65,
    "damage_type": "刺伤"
  ]),
  ([
    "action": "$N手腕一转，使出李大嘴的‘蚀骨蚀肉’，凌厉剑网直向$n全身削去",
    "dodge": -20,
    "parry": 25,
    "damage": 90,
    "damage_type": "割伤"
  ]),
  ([
    "action": "$N气运丹田，力贯剑峰，重心一沈朝$n当头砍下，正是轩辕三光的‘恶人挡路’，霸气十足",
    "dodge": 30,
    "parry": -30,
    "damage": 160,
    "force": 160,
    "damage_type": "割伤"
  ]),
  ([
    "action": "$N身形一转使出阴老九的‘恶鬼招魂’，霎时风声鹤唳，手中的$w从不可思议的方位窜出，直取$n首级",
    "dodge": -50,
    "parry": 15,
    "damage": 130,
    "force": 60,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N狂啸一声，手中$w有如疯狂般向$n狂砍而去，不留一线生机，正是铁战的‘狂狮怒吼’",
    "dodge": -35,
    "parry": -35,
    "damage": 230,
    "force": 200,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N脸色一沈，将全身杀气贯注于$w之上，使出杜杀绝学‘血手无情’",
    "dodge": 40,
    "parry": -50,
    "damage": 200,
    "force": 180,
    "damage_type": "割伤",
  ]),
});

int valid_enable(string usage) {
  return (usage == "sword" || usage == "parry");
}

mapping query_action(object me, object weapon) {
  int level, limit;
  level = (int)(me->query_skill("badsword", 1));
  limit = (int)(level / 10);
  if (limit < 2)
    return action[random(2)];
  if (limit < 4)
    return action[random(4)];
  if (limit < 5)
    return action[random(5)];
  if (limit < 6)
    return action[random(6)];
  if (limit < 7)
    return action[random(6) + 1];
  if (limit < 8)
    return action[random(6) + 2];
  if (limit < 9)
    return action[random(5) + 3];
  if (limit < 10)
    return action[random(4) + 4];
  else
    return action[random(4) + 4];
}
